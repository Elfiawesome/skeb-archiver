imgix.net/a9a13908/uploads/origins/fcb8002d-25f8-48f5-b620-dc1c2d10f1b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d53c0728de5cefc4ddebe8d88a6922f, https://si.imgix.net/a9a13908/uploads/origins/fcb8002d-25f8-48f5-b620-dc1c2d10f1b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fcb0a5a50ef5740e9c3be64d8b6496e1 2x, https://si.imgix.net/a9a13908/uploads/origins/fcb8002d-25f8-48f5-b620-dc1c2d10f1b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24e0bb482603622cb0ef2372a6e2ba87 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9a13908/uploads/origins/fcb8002d-25f8-48f5-b620-dc1c2d10f1b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5e9e8bed9f4ec1266521c06822f8ee5", "srcset": "https://si.imgix.net/a9a13908/uploads/origins/fcb8002d-25f8-48f5-b620-dc1c2d10f1b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5e9e8bed9f4ec1266521c06822f8ee5, https://si.imgix.net/a9a13908/uploads/origins/fcb8002d-25f8-48f5-b620-dc1c2d10f1b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=16e9ce6e7f98392bde1fd74dd28d6d07 2x, https://si.imgix.net/a9a13908/uploads/origins/fcb8002d-25f8-48f5-b620-dc1c2d10f1b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=da23cb9d12fcc781a3d216325944aae5 3x"}, "body": "めぇと言う名前の私のキャラ（うちの子）で何か描いて下さい\n羊・月・サキュバス等の要素が含まれます\n身長:118cm　外見年齢:10歳程度\n若干イカ腹っぽく、髪の毛量が多めです\n\nTwitterからトリッカルの可愛い絵をお見掛けして\nSkebを募集されているので依頼したく思いました\nもしよければよろしければお願いします\nお受けいただく場合は露出の多いキャラであることにご注意願います\n\n\nキャラの性格等\n口数少なく穏やか、やや幼い性格でややアンニュイ・ダウナー、常に少し眠そうで\n振る舞いはおとなしく、人懐こいです\nミルク、ナッツ、チョコ等を好み、小食です\n行動に害意はなく、敵意を嫌います\n\n構図やシチュエーションなどはお任せします\n資料は以下のURL、Skebの過去の納品を参考にお願いします\nhttps://www.pixiv.net/artworks/99333545\n\n\nアイデアが必要な場合は以下の文章をご参考ください\n\n・牧草や布団椅子の上で丸まって寝ている\n・高所（煙突など）から遠くを見ている\n・何かに撫でられて微笑む\n・気持ちよさそうに空を飛ぶ\n・水浴びをする\n・指先からミルクを垂らして瓶に入れる\n・動物にくっついてうとうとしている\n・寝ている相手に抱き着いてエネルギーを緩やかに奪う（発光）\n・三日月に腰掛けあるいは抱き着くなど月を絡める\n・伸びた毛を第三者に毛刈りされるのを気持ちよさそうにする\n・角が折れた（痛くはない）\n・小さい物をしゃがみ込んでのぞき込む\n・誰かと手をつないで夜を散歩している\n・ひつじのぬいぐるみに腰かけて空を見ている\n\n\n\n設定　能力\nめぇは人々の記憶に住み着く妖精や悪魔のようなもので\n体の縁が淡く発光しており、普段は浮遊しています\n桃、アルコール、ミルク、干した布団　等に近しい\n相手の警戒を解くような薄甘い香りを纏ってます\n\n抱き着いたりして肌に触れ続けた相手に眠気を植えつけて夢を見せ\n夢に干渉して自分の情報を滑り込ませることで存在を保ちます\n分泌される体液や血液は練乳やミルクのようで、\n飲ませた相手を強壮し、軽い依存性をもちます\n\nhttps://www.pixiv.net/artworks/70796264", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0402maguro/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3735521, "client_id": 731954, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17087559/uploads/origins/12fbed3c-5ebc-43e2-9b9c-dd5379d0f865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=351a59213f65975564e20a92c366fda7", "srcset": "https://si.imgix.net/17087559/uploads/origins/12fbed3c-5ebc-43e2-9b9c-dd5379d0f865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=351a59213f65975564e20a92c366fda7, https://si.imgix.net/17087559/uploads/origins/12fbed3c-5ebc-43e2-9b9c-dd5379d0f865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c02d23693fd892d75dc59e3afc0a138 2x, https://si.imgix.net/17087559/uploads/origins/12fbed3c-5ebc-43e2-9b9c-dd5379d0f865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d199090768c05a2b04cdca2b75c03171 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17087559/uploads/origins/12fbed3c-5ebc-43e2-9b9c-dd5379d0f865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=517456460bf6de6e74fccc07a578b067", "srcset": "https://si.imgix.net/17087559/uploads/origins/12fbed3c-5ebc-43e2-9b9c-dd5379d0f865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=517456460bf6de6e74fccc07a578b067, https://si.imgix.net/17087559/uploads/origins/12fbed3c-5ebc-43e2-9b9c-dd5379d0f865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1ea3c4dce064ef0b4d23c06af3c68b44 2x, https://si.imgix.net/17087559/uploads/origins/12fbed3c-5ebc-43e2-9b9c-dd5379d0f865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=65bd22264ddb7ba1465e379e8614606d 3x"}, "body": "アピールありがとうございます、極寒着膨れについて興味を持って下さったとのことで大変嬉しく思っています！\n素敵な絵柄も相まって、是非とも極寒着膨れのイラストをお願いしたいと思います！以下、依頼文になります\n\nアズールレーンの加賀が、物凄く寒い場所で、全身を防寒着でモッフモフに着膨れながら凍って行くイラストをお願いします。\n例えば今から想像もつかない極寒の地に放り出されると言われ、凍えないように暖かそうな防寒着をひたすら重ねて着込んだような、モフモフの着膨れ姿の凍結をお願いします。\n\nGoogleドライブに資料を纏めています\nそちらの資料を参考に、雪国のような分厚く耐寒性の高い、ふわふわな防寒着と言うイメージで着込ませて欲しいです。資料には様々な種類がごちゃ混ぜになっていますが、全体的なデザインはお任せします。\n着込ませ過ぎだと思うその8割増しくらいのモフモフ着膨れ加減でお願いしたいです。凄く寒い所で、モフモフした防寒着を大量に着込む女の子が大好きなので……\n\nまた、描写が可能であれば場所は凄く寒そうな場所、雪や氷に覆われた世界観でお願いします、寒さの表現として防寒着にはつららや霜、体に雪等を積もらせて頂ければ嬉しいです\n可能な限りの防寒着を着込んでもなお凍りつくような寒さ、そんなイメージが大好きなので……\n吐息が凍りつく程の寒さで、口や目から唾液や涙のつらら等の描写も入れて下さると嬉しいです\n\n加賀に生えた狐の耳と尻尾についてですが、耳は防寒着を邪魔しない程度に描写をお願いします。\n九本の尻尾は可能であればかなり大きく描いて頂けるととても喜びます。モフモフ尻尾が大好きなので……\n\nまた、可能であれば、凍えきって身体を包む雪と氷が増え、全身がつららと氷に包まれ、樹氷のように青白く全身が凍りついてしまった様子までお願いしたいです。\n\n長々と描いてしまい申し訳ないです、とにかく徹底した防寒着の盛りと全身モフモフの着膨れ、しかし、それでもガチガチに凍りついた加賀さんの姿を見たいです。どうか宜しくお願いします。\n\nhttps://drive.google.com/drive/folders/1vTkYM1PpXEa8XHPTXIs4rT4CAYyMToXN\n\nhttps://drive.google.com/drive/folders/1vTkYM1PpXEa8XHPTXIs4rT4CAYyMToXN", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0402maguro/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3bf65f08/uploads/origins/1dcf8749-6362-4d78-a300-9e88f1eb11db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4da3bc2cb53c7d5c