&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e88835225c7840d1f01967e14c5c942a 2x, https://si.imgix.net/7f5b7610/uploads/origins/5c105d42-3886-4d6e-b173-050af73fac4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=70bc62282c54850771e8778cee3f55b1 3x"}, "body": "いつもお世話になっております！\n早速ですがイラストリクエスト失礼いたします。\n\n企画魔女恋でご一緒した、七瀬さん宅アルマさんと拙宅ノーチェが別れる前の、ほのぼのとしているイラストをお願いしたいです！\nいつも描いてもらってばかりですみません…細かいところはお任せいたします。よろしくお願いいたします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@fooko1204/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2324354, "client_id": 1362906, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3b6a110/uploads/origins/593494e7-403e-4e24-a929-a0bacb213aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f00f663bc975d83493e78ff754fa4de", "srcset": "https://si.imgix.net/e3b6a110/uploads/origins/593494e7-403e-4e24-a929-a0bacb213aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f00f663bc975d83493e78ff754fa4de, https://si.imgix.net/e3b6a110/uploads/origins/593494e7-403e-4e24-a929-a0bacb213aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4616140dd8c30d1df679739a3828c787 2x, https://si.imgix.net/e3b6a110/uploads/origins/593494e7-403e-4e24-a929-a0bacb213aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75603f1771079523bb2f35c9470678d5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3b6a110/uploads/origins/593494e7-403e-4e24-a929-a0bacb213aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27077d6fba4796c3462cde3cb7ad98d4", "srcset": "https://si.imgix.net/e3b6a110/uploads/origins/593494e7-403e-4e24-a929-a0bacb213aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27077d6fba4796c3462cde3cb7ad98d4, https://si.imgix.net/e3b6a110/uploads/origins/593494e7-403e-4e24-a929-a0bacb213aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e8139c492c530f7fd4600eb9b75834b 2x, https://si.imgix.net/e3b6a110/uploads/origins/593494e7-403e-4e24-a929-a0bacb213aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3fd54c37b64cbc026ee6a463f6146014 3x"}, "body": "お疲れ様です、いつもふーこさんが描かれる女の子を柔らかくて可愛らしいなとこっそり拝見させていただいております。\n\nふーこさんの描かれる柔らかい雰囲気を纏いつつ、仄暗い設定がある絶妙なバランスが素敵な少女が特に好きで、そんな絵柄で是非見てみたいと思う創作うちよその双子姉妹をご依頼させていただきました。\nうちよそお相手の親御さんには許可をいただいており、デザインや設定については添付の資料にまとめさせていただいております。\n使用目的は完全個人での鑑賞目的になり、完成されましたら親御さんにデータを共有致します。\n\n構図や制服指定(夏・冬)に細かい希望はありませんが、双子は互いに唯一無二の重い感情を抱いており\n姉の夏帆から深雪さんに対しては「妹に恋慕を抱き、この気持ちを悟られないように仲良し姉妹として接している」である一方\n妹の深雪さんから夏帆に対しては「姉に恋慕に近い独占と執着心を抱いている」となり、互いに向けあう感情の形が違っています。\nそうした背景から妹が姉へ執着し、束縛しているような仄暗い雰囲気が出ていると幸いです。\n\n【参考資料URL】\nhttps://drive.google.com/drive/folders/1JPu9W62zJMRJKnePprnPPL7IXyNk80Pg\n\n◆参考までの関係性など\n・スキンシップ多め、距離感が近い\n・他生物に例えると姉が蝶で妹が蜘蛛、蜘蛛の巣で捉えて捕食する者と被捕食者のような関係\n・常に一緒に行動する仲良し双子だが、姉はいつまでも一緒の双子というわけにはいかないと妹の為を思い自立して生きる方が良いと思っており、内心妹への恋慕を諦めようとしている\n・一方で妹は姉の事を捉えて離さず、生涯一緒に生きるものだと疑わず執着心を抱いている\n・将来的に姉は妹の執着に捉われ、秘めていた想いも告げ共依存の関係に\n\nご多忙の中恐縮ですが、ご検討のほどよろしくお願い致します。\nお忙しかったり、描きたい方向性にそぐわなければキャンセルしていただいて問題ございません。\n\nhttps://drive.google.com/drive/folders/1JPu9W62zJMRJKnePprnPPL7IXyNk80Pg", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1993, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "にいな涼☕️🍰🍮✨", "screen_name": "ninaryo", "avatar_url": "https://pbs.twimg.com/profile_images/1341249183064342529/dTLqtXhE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/767276378/1683084154/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "de