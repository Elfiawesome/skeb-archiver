rop=top&w=200&h=200&s=3b8374acc78660dc641afe58adf76d85 2x, https://si.imgix.net/7b3423d1/uploads/origins/553cf0ff-86b8-4458-bee0-6d2447eb611c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25c0d5b486c3ccb64bdfa69663ed37d8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b3423d1/uploads/origins/553cf0ff-86b8-4458-bee0-6d2447eb611c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6854dadec86ac6b34fd18d9367350279", "srcset": "https://si.imgix.net/7b3423d1/uploads/origins/553cf0ff-86b8-4458-bee0-6d2447eb611c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6854dadec86ac6b34fd18d9367350279, https://si.imgix.net/7b3423d1/uploads/origins/553cf0ff-86b8-4458-bee0-6d2447eb611c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=467885a786250983b772ce75203b6aca 2x, https://si.imgix.net/7b3423d1/uploads/origins/553cf0ff-86b8-4458-bee0-6d2447eb611c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=79bac98cf40f352c94fcd85730116662 3x"}, "body": "初めまして\nノリッチョ！skeb始めました🧎様の絵をお見かけし\nもし受けて頂ければと思いリクエストさせて頂きました。\n\n描いて頂きたいキャラは、\n配信者である「星宮」様（@HM__zZoo）のファンアートになります。\n彼女はV-tuberではありませんが、配信活動者です。\nskebリクすることは本人の了解を得ております。\n\n参考資料（星宮様のTwitterから）\nhttps://twitter.com/HM__zZoo\nhttps://twitter.com/HM__zZoo/status/1695666316475302104\nhttps://twitter.com/HM__zZoo/status/1701572163185389684\n\n※ただの１リスナーであるため提供できる資料が少ないです\n　また全身の設定絵等はありません\n\n要望\n・星宮様の髪は左が黒、右がピンクとなっており、黒髪の側にリボンがついています。\n・描いて頂きたい衣装としては、ショートパンツにパーカーのような部屋着の格好でベッド/ソファーあたりでゲームをしているような姿をお願いできればと思っています。\n・髪は長めにしてもらって座ってるものに広がってる等なってると嬉しいです。（部屋着なので髪のリボンはヘアピン、または、後ろで束ねてポニーテール状に変更が可能であればお願いします。）\n・配信のサムネで使えるよう横長でお願いできればと思います。\n・キャラと背景と別体でデータを頂ければ幸いです\n・その他の点につきましては申し訳ありませんが資料未提供の部分が多いため、お任せで描いて頂ければと思っています。\n\n使用目的\n作成いただいたイラストは「星宮」様の配信活動、SNS活動、限定特典等に使わせて頂ければと考えております。\n\n以上の内容でリクエストをお受け頂くことは可能でしょうか。\nご検討いただけますと幸いです。\nよろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@qq9q34r9/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3261ede1/uploads/origins/28a969b2-4fb9-4891-882c-86d91aeab6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0755c89de6b6de69a8e09f1b5852e9af", "srcset": "https://si.imgix.net/3261ede1/uploads/origins/28a969b2-4fb9-4891-882c-86d91aeab6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0755c89de6b6de69a8e09f1b5852e9af, https://si.imgix.net/3261ede1/uploads/origins/28a969b2-4fb9-4891-882c-86d91aeab6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fbb480753b1f43bed40221835f666d01 2x, https://si.imgix.net/3261ede1/uploads/origins/28a969b2-4fb9-4891-882c-86d91aeab6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2af60853358c077445fc8b92d7efec41 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2841668, "nc": 145}, {"path": "/@qq9q34r9/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2841668, "client_id": 2887262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b17c1132/uploads/origins/d66e7e3e-8f0d-4413-b02a-e09e2de4c446?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b5a8425279a931af65c4b071c78acd4", "srcset": "https://si.imgix.net/b17c1132/uploads/origins/d66e7e3e-8f0d-4413-b02a-e09e2de4c446?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=t