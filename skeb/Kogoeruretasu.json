AIN \"または \"LEVEL DOWN \"と表示されたり、胸が大きくなるにつれてBBの上に \"LEVEL UP \"と表示されるような追加エフェクトがあるとありがたい。\n\nこれは提案ポーズである。https://skeb.jp/@Kogoeruretasu/works/2\n\nお望みであれば、別のポーズに変えていただいても結構です。おっぱいの代わりにオーラルセックスも可能です。ポーズやシナリオの自由は認めます。BBの乳首は露出でお願いします。BBの髪の赤いリボンもお願いします。\n\nBB: https://drive.google.com/drive/folders/1aR58ZeAauL_t4W4Vq_FZBagucD8tW0dN\n\nありがとうございました！", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kogoeruretasu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1219926, "client_id": 1473091, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f2ef7b6/uploads/origins/90425273-b4f8-4ddf-a2e7-40c03f20c6d4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=5cc25a1a8364f6a5deb640258ac7c262", "srcset": "https://si.imgix.net/0f2ef7b6/uploads/origins/90425273-b4f8-4ddf-a2e7-40c03f20c6d4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=5cc25a1a8364f6a5deb640258ac7c262, https://si.imgix.net/0f2ef7b6/uploads/origins/90425273-b4f8-4ddf-a2e7-40c03f20c6d4?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ae489e80f95166a12c4497129fff0c1 2x, https://si.imgix.net/0f2ef7b6/uploads/origins/90425273-b4f8-4ddf-a2e7-40c03f20c6d4?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e3328cfad397a550a4aff6184768c57 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f2ef7b6/uploads/origins/90425273-b4f8-4ddf-a2e7-40c03f20c6d4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=6b9a3579563fab3c61d95d3d95699124", "srcset": "https://si.imgix.net/0f2ef7b6/uploads/origins/90425273-b4f8-4ddf-a2e7-40c03f20c6d4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=6b9a3579563fab3c61d95d3d95699124, https://si.imgix.net/0f2ef7b6/uploads/origins/90425273-b4f8-4ddf-a2e7-40c03f20c6d4?bg=%23fff&fm=webp&a