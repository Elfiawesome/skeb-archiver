re": "voice", "default_amount": 5000}, {"genre": "novel", "default_amount": 5000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@kaineneko/works/69", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 477205, "client_id": 1261008, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8092bdcf/uploads/origins/a1fde582-8f2e-4ca3-8707-934b29bb8ea4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2375e5a776920bff712f835304b966c9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8092bdcf/uploads/origins/a1fde582-8f2e-4ca3-8707-934b29bb8ea4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=820e93e939f3eb4c069e0a5d6187ae11", "src_set": ""}, "body": "椎名かいね 様\n\nこんにちは。丸ぼーずです。\n\nこれまで「ベランダから星空を眺める女の子」「夏の夜または夕暮れに、ベランダでくつろぐ女の子と猫」と\n冬と夏のパソコン用の壁紙イラストを描いていただきました。今度は秋のバージョンをお願いします。\n\n・サイズ：16×9\n・テーマ：「秋夜の十五夜の月と少しミステリアスな雰囲気の女の子」\n・イメージ：\n　冬や夏のシーンとはまた別の、少しミステリアスな雰囲気を感じる女の子のイラストでお願いします（先日のUCFESのステージの雰囲気がとても良かったので）。\n　今回はベランダのシーンでなくても構わないですし、猫ちゃんは雰囲気に合えばお願いします。\n\n以上です。よろしくお願いいたします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaineneko/works/68", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 477205, "client_id": 641136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879496809254686720%2F6HAD05tP.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8145ebc982fdc274537011f0573f5570", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1879496809254686720%2F6HAD05tP.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=136feba57aee53ec3f4606198920d3e9", "src_set": ""}, "body": "こんにちは\nいつも素敵な作品を楽しませていただいております。折角なのでこの機会に、物語も依頼したいと思いリクエストさせていただきました。\n持ち主とはぐれた「ぬいぐるみ」の物語をお願いします。彼は音楽と仲間を愛する陽気な好青年です。自分がかわいい存在であることは知っているので、身の程知らずの無鉄砲ではありませんが困難な道を切り拓くためには果敢に挑んでいくタフさを持っています。彼の見た目やバックボーンはお任せします\n\n旅先ではぐれたというシチュエーションが良いです。彼のために素敵な名前と物語を貰えたら嬉しいです", "nc": 145, "word_count": 4202, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@kaineneko/works/67", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 477205, "client_id": 641136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1df8025b/uploads/origins/b40e6069-b851-464e-9434-bb3043501b4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f19827c8bdab4c6c92e77fb0bff7cf5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1df8025b/uploads/origins/b40e6069-b851-464e-9434-bb3043501b4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fce5c4b23db67b6a095c392579aab49", "src_set": ""}, "body": "こんばんは\n椎名かいねさん（@kaineneko）の大阪でのライブを思い出させてくれるイラストを依頼させてください。UMA Chaos Fes vol.2のChillステージのライブとても良かったです！以前依頼したイラストも会場の雰囲気が伝わってきて、素敵なイラストでした！構図や描き方はお任せしますが、Ｘのヘッダー画像として使わせていただきたいのでアスペクト比3:1の大きさでお願いします（Ｘのヘッダーのサイズが1500×500）", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaineneko/works/66", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 477205, "client_id": 641136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ae4946b/uploads/origins/502d52ba-46b6-4d6e-825c-31c4581e1056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baff9d1e421cb1db03463a24e92db158", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ae4946b/uploads/origins/502d52ba-46b6-4d6e-825c-31c4581e1056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08208d1117e36b537d7194ca5ec0fafb", "src_set": ""}, "body": "こんばんは！鼓拍（cohaku_v）さんのイラストをリクエストさせてください。ライブステージで静寂を打ち破り歌い出すイメージでお願いします。表情がよく見えて、配信のギフトでお馴染みのミラーボールが入っていると嬉しいです\n前回描いていただいた熱気が伝わってくるイラストは今でもお気に入りです！今回も何卒よろしくお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaineneko/works/65", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 477205, "client_id": 641136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7260d8e1/uploads/origins/7e17f774-3632-4eee-aaa3-cd246cae802c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eac499fe5f90eb2089bd445eee0ed472", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7260d8e1/uploads/origins/7e17f774-3632-4eee-aaa3-cd246cae802c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2285ae01d0c5c87874a81b60ab3ba170", "src_set": ""}, "body": "こんばんは\n先日の椎名かいねさん（@kaineneko）の下北沢でのライブを思い出させてくれるイラストを依頼させてください。ひとつなぐものらの曲も新曲もとても良かったです！曲に合わせて体を動かしながら、ゆっくりお酒を飲みながら…みんながそれぞれに楽しんでいる景色を見ながら、胸がいっぱいになりました。かいねさんが大きく映っていると嬉しいです、スマホのホーム画面に設定して日々の励みにしたいと思います\n新しいキービジュアルのイラストも雰囲気がとても好きです！何卒よろしくお願いいたします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaineneko/works/64", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 477205, "client_id": 3476975, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/597785e2/uploads/origins/c7b4622a-6091-4fe3-ad20-6159a1d989b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa20937d9694c7bb8bc650ac3f893555", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/597785e2/uploads/origins/c7b4622a-6091-4fe3-ad20-6159a1d989b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d96df607c4d6f53ca5689b57a26f12c2", "src_set": ""}, "body": "いつもお世話になっております。\n三度の飯より酒が好きです。\nSNSのヘッダー兼アイコン用のイラストを依頼します。\n急ぎではないので、お手すきの時に描いていただければ幸いです。\n\nイラストの要望は以下の二点です。\n1.以下の人物が居酒屋のカウンターで寝こけているイラストをお願いいたします（ヘッダー）\n　・成人男性　\n　・超短髪のソフトモヒカン\n　・黒髪\n2.近くにとっくりがあり、銀フレームの眼鏡が寄りかかっているイラスト付きでお願いいたします（アイコン）\nつたない説明で申し訳ございません。\nよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaineneko/works/63", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 477205, "client_id": 555991, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4202a3e7/uploads/origins/d4270359-4f94-4e69-acbb-1dc93c2bf4b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c17c30d1352ea5eb1aa352e0311504e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4202a3e7/uploads/origins/d4270359-4f94-4e69-acbb-1dc93c2bf4b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8036c265a2d7d78b41b1e280e840cddc", "src_set": ""}, "body": "いつもお世話になっています！れいだーん改です\nSNSのアイコン用のアバターイラストをお願いしたいです。\n\n・成人男性　\n・短髪\n・ふちが太めの黒縁メガネ\n・眉は太目で角形\n・顔は直線顔\n・服装は紺や黒、ないし白など単色　\n　がははと大きく笑うことが多い気がするので陽気な表情。\nよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_