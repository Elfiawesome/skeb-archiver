なり、手足と胴体、首が伸び長身となるが元のスレンダーさはそのままでとても細身の体型。但し胸だけは急激に成長し、上官であるハリベルをも上回るサイズで、乳首も肥大化し長乳首に。ただこれだけ肥大化しても垂れることは無く上向きのロケット形おっぱいで乳首もビクンっと勃起している。顔も目鼻立ちが高くなり、唇も厚く妖艶な美女になる。また急激なパワーアップで全身に汗をかいている。\n\n構図についてはお任せ致します。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@IamyourKumasan/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2662671, "client_id": 431003, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/058da4a8/uploads/origins/8f019e72-bd44-4824-9c46-2a28deb950c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90829cfe11b81891f3f17a75c02b42f1", "srcset": "https://si.imgix.net/058da4a8/uploads/origins/8f019e72-bd44-4824-9c46-2a28deb950c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90829cfe11b81891f3f17a75c02b42f1, https://si.imgix.net/058da4a8/uploads/origins/8f019e72-bd44-4824-9c46-2a28deb950c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ae80a61e261a805bc37cde29e6ede16 2x, https://si.imgix.net/058da4a8/uploads/origins/8f019e72-bd44-4824-9c46-2a28deb950c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ca347dd7d25c907cdb7cc119583c444 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/058da4a8/uploads/origins/8f019e72-bd44-4824-9c46-2a28deb950c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c5461dbced9967f72b841c046146d6c", "srcset": "https://si.imgix.net/058da4a8/uploads/origins/8f019e72-bd44-4824-9c46-2a28deb950c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c5461dbced9967f72b841c046146d6c, https://si.imgix.net/058da4a8/uploads/origins/8f019e72-bd44-4824-9c46-2a28deb950c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a0dd831ea981f66f9f