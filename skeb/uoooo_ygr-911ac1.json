et/656c3f04/uploads/origins/40935007-200e-42f3-8d14-d6fbf155e8c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95b94a629c07396b3bc550c9ac7897a3", "srcset": "https://si.imgix.net/656c3f04/uploads/origins/40935007-200e-42f3-8d14-d6fbf155e8c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95b94a629c07396b3bc550c9ac7897a3, https://si.imgix.net/656c3f04/uploads/origins/40935007-200e-42f3-8d14-d6fbf155e8c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=365438a1d9e1c1760d1e30733562dc0a 2x, https://si.imgix.net/656c3f04/uploads/origins/40935007-200e-42f3-8d14-d6fbf155e8c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa56ac4acda4518c8efe9842a74081d4 3x"}, "body": "こんにちは。あなたの作品、とても気に入っています。本当に美しいですね。特に不気味な雰囲気が大好きです。完璧に合っています！\n私のキャラクター「アイシー」を描いていただけませんか？彼女は支配的で高慢なところがあるのですが、可愛くておっちょこちょいな一面もあります。 怒り出すと、少し「狂気じみた」印象を与えることもあります。しかし、全体的には派手な性格で、*ヒメデレ*と*ヤンデレ*が混ざったようなキャラクターです。\n\nこのイラストは、SNSやVTuber活動、Patreonのコンテンツ、そして将来的には商用利用（現時点では予定していませんが、念のため）に使いたいと思っています。- VTuber名：IcyHime\nリクエストをお引き受けいただき、本当にありがとうございます！\n\n参考リンク：https://drive.google.com/drive/folders/1V2UWEeNG8gxLjIBotnoINQ0DOd6QDHF0?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uoooo_ygr/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3973369, "client_id": 2915957, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5fd67123/uploads/origins/ccfd6ef1-8b4f-4426-8419-2ef757b9a5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5aa466b62d018a3a550eb9e3cff0cba4", "srcset": "https://si.imgix.net/5fd67123/uploads/origins/ccfd6ef1-8b4f-4426-8419-2ef757b9a5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5aa466b62d018a3a550eb9e3cff0cba4, https://si.imgix.net/5fd67123/uploads/origins/ccfd6ef1-8b4f-4426-8419-2ef757b9a5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=459a04471cdb425fd8185f705518f0d8 2x, https://si.imgix.net/5fd67123/uploads/origins/ccfd6ef1-8b4f-4426-8419-2ef757b9a5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=572064956ef743b693f8d9c9f9889faf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5fd67123/uploads/origins/ccfd6ef1-8b4f-4426-8419-2ef757b9a5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c2ce08837e4c602c653acec0ad73866", "srcset": "https://si.imgix.net/5fd67123/uploads/origins/ccfd6ef1-8b4f-4426-8419-2ef757b9a5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c2ce08837e4c602c653acec0ad73866, https://si.imgix.net/5fd67123/uploads/origins/ccfd6ef1-8b4f-4426-8419-2ef757b9a5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b881014e1dda69cc030ebacae090189e 2x, https://si.imgix.net/5fd67123/uploads/origins/ccfd6ef1-8b4f-4426-8419-2ef757b9a5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e84e2c457516c68be1816ccd1950934 3x"}, "body": "やぐるさん、こんにちは！個人的な使用のみでOCイラストをお願いしたいです。\n\nシモミヤは名家の後継者で、兄と父が数年違いで「不幸な」死を遂げた後、一族の当主となりました。繊細で物静かな性格をしており、感情を隠すのがあまり得意ではありません。周囲からは礼儀正しく、誠実で努力家な人物として知られており、常に場の平和を保とうとしています。\n\nしかし、内面には狡猾で人を操るような一面が潜んでいます。無害そうな印象で相手を油断させる、「羊の皮を被った狼」です。悪魔的な魅力を持つロマンティックな主人公タイプような存在であり、その利己的な面も、憂いを帯びた一途さも、どちらも本質です。物語は昭和時代の上流階級を舞台にした、孤立した山奥の館で起こる殺人ミステリーです。\n\n髪はきちんと分けて整えているつもりですが、前髪が目にかかり、耳にかけてもすぐに落ちてきてしまいます。また、腕時計と結婚指輪は常に身につけており、頻繁にそれらに触れたり、位置を直したりする癖があります。これらは彼にとって重要な品です。年齢は25歳、身長は175cmです。\n\nお好きなように描いてください。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1-cwNCTnPpSe_FP2xPLkgMmjIZIDmbCDE?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": []}, "price_history": {"art": [{"amount": 1000, "recorded_at": 1778113863.372649}], "correction": [{"amount": 500, "recorded_at": 1778113863.372649}]}, "custom": {}}