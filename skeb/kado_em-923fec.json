e21dfc/uploads/origins/5472ebf1-c4a8-4397-bb04-8f037bfd0914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6488b93b3c96895a1aee0e734d9e009", "srcset": "https://si.imgix.net/4ee21dfc/uploads/origins/5472ebf1-c4a8-4397-bb04-8f037bfd0914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6488b93b3c96895a1aee0e734d9e009, https://si.imgix.net/4ee21dfc/uploads/origins/5472ebf1-c4a8-4397-bb04-8f037bfd0914?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=80c4d61209e9d3082b222698599caf1a 2x, https://si.imgix.net/4ee21dfc/uploads/origins/5472ebf1-c4a8-4397-bb04-8f037bfd0914?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=49c6627b91e5bc80fa156c11c5f9e429 3x"}, "body": "はじめまして、門田めいあと申します。\n46様のシンプルでお洒落なイラストが大好きでいつも新作イラストの投稿を楽しみにしております。\n\nもしよろしければ、拙作のゲーム『雨夜行』に登場する「坂斉薫」を描いていただけますでしょうか。\n----------------------\n【キャラ設定・資料】\nhttps://drive.google.com/drive/folders/1WoU4bFnYQrkaC5ied6fwgFoetyU0kGPx?usp=sharing\n特に配色の点でキャラデザインにブレがありますが「歩行グラフィック.png」が最新です。「歩行グラフィック.png」をもとにしつつ、他画像でデザインを補っていただければと思います。\n\n【キャラ設定の補足】\n・中性的な雰囲気の白髪、長髪の男性。\n・雨、山間部の寂れた寺社が似合うような感じです。\n・柔和な性格で、漢籍や仏典、歴史を好むような人物です。\n\n▼ゲームのHPはこちらです。世界観把握等にご活用ください。\nhttps://nororal.com/amayakou/\n\n【イラストの使用用途】\n・当方が運営するサイト・SNS・Discordへのアップロード（いずれも無料閲覧可）\n・その他、私的鑑賞など個人的なもの。\n※SNSに掲載する際、私のほうでウォーターマークを追加させていただく場合がございます。\n\n【描いてほしい内容について】\n46様にご一任できればと存じます。\nなお、キャラデザインについては適宜アレンジいただいて構いません。\n----------------------\nお忙しいところ恐れ入りますが、ご検討のほどよろしくお願いいたします……！\n\nhttps://drive.google.com/drive/folders/1WoU4bFnYQrkaC5ied6fwgFoetyU0kGPx?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0000tea0000/works/66", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3121712, "client_id": 22720, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a42f1b75/uploads/origins/65f1c3e8-e96a-4fd3-968d-ee510a8bb72e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ecf5cb373eefc810958d752a98364ee", "srcset": "https://si.imgix.net/a42f1b75/uploads/origins/65f1c3e8-e96a-4fd3-968d-ee510a8bb72e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ecf5cb373eefc810958d752a98364ee, https://si.imgix.net/a42f1b75/uploads/origins/65f1c3e8-e96a-4fd3-968d-ee510a8bb72e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f729da24c13488298ddd54c4ad2ad0d 2x, https://si.imgix.net/a42f1b75/uploads/origins/65f1c3e8-e96a-4fd3-968d-ee510a8bb72e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f14d1e1235e82038affef75d3a466406 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a42f1b75/uploads/origins/65f1c3e8-e96a-4fd3-968d-ee510a8bb72e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11afcfc0e03b021398311b14579d1f9f", "srcset": "https://si.imgix.net/a42f1b75/uploads/origins/65f1c3e8-e96a-4fd3-968d-ee510a8bb72e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11afcfc0e03b021398311b14579d1f9f, https://si.imgix.net/a42f1b75/uploads/origins/65f1c3e8-e96a-4fd3-968d-ee510a8bb72e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0edd0bc7329bd9bc8265a3635baa1a12 2x, https://si.imgix.net/a42f1b75/uploads/origins/65f1c3e8-e96a-4fd3-968d-ee510a8bb72e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=76f185eaf558c85bfff158b00390a0e4 3x"}, "body": "はじめまして、門田めいあと申します。\nお茶様の可愛らしくもどことなくアンニュイな雰囲気の絵柄に惹かれ、イラストリクエストを送らせていただきました。\n------------------------\n■依頼概要\n当方のオリジナルキャラクター「闇音」を描いていただけますでしょうか。\n\n■キャラのモチーフ\nゴシック、死、骸骨、毒（ヘドロ、ガス、毒薬など毒全般）、鏡、黒曜石など。\nゴシックな可愛さ、毒々しい可愛さなイメージです。\n\n■用途\n鑑賞用、個人利用範囲でのグッズ作成（第三者への配布無し）\n当方のサイト・SNS、当方が運営しているDiscordサーバーでイラストをアップさせていただくことがございます。また、その際に私のほうでウォーターマークを付ける場合がございます。\n\n■イラストへの要望\n特にございませんのでお茶様にお任せいたします。\n------------------------\n以上、もしよろしければお引き受けのほうご検討いただけますと幸いです……！\nまた何か不備などございましたら恐れ入りますが差し戻しのほうお願いいたします。\n\nhttps://drive.google.com/drive/folders/16DIiN5rU-ZK2Gg5IocNQCNgNvZ3f5UI2?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HaroS/works/61", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3486713, "client_id": 22720, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4171f210/uploads/origins/c97e5a96-798c-4601-ba7b-6c61895a754e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=a89aaf8257786f959ab6feea1c71fcff", "srcset": "https://si.imgix.net/4171f210/uploads/origins/c97e5a96-798c-4601-ba7b-6c61895a754e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=a89aaf8257786f959ab6feea1c71fcff, https://si.imgix.net/4171f210/uploads/origins/c97e5a96-798c-4601-ba7b-6c61895a754e?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=5dee6e5c363a74163761e1f3833c254c 2x, https://si.imgix.net/4171f210/uploads/origins/c97e5a96-798c-4601-ba7b-6c61895a754e?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=45c6191422f5bc0d954289ca5e2a68c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4171f210/uploads/origins/c97e5a96-798c-4601-ba7b-6c61895a754e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=17011d5ee8f8a8e6d73188d28781c6d9", "srcset": "https://si.imgix.net/4171f210/uploads/origins/c97e5a96-798c-4601-ba7b-6c61895a754e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=17011d5ee8f8a8e6d73188d28781c6d9, https://si.imgix.net/4171f210/uploads/origins/c97e5a96-798c-4601-ba7b-6c61895a754e?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=91ed793e4c3961fc9e0cc18f6190bdd1 2x, htt