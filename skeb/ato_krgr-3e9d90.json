://si.imgix.net/f0d0c0b0/uploads/origins/db0f92dd-c566-4f6e-854a-e1f9b7c283c1?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=10a52aff34682341987d23f8269067e9", "srcset": "https://si.imgix.net/f0d0c0b0/uploads/origins/db0f92dd-c566-4f6e-854a-e1f9b7c283c1?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=10a52aff34682341987d23f8269067e9, https://si.imgix.net/f0d0c0b0/uploads/origins/db0f92dd-c566-4f6e-854a-e1f9b7c283c1?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb30e460f0e54b35464b13a7d4a27519 2x, https://si.imgix.net/f0d0c0b0/uploads/origins/db0f92dd-c566-4f6e-854a-e1f9b7c283c1?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=f177e8bb33495283e46d867cce199273 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0d0c0b0/uploads/origins/db0f92dd-c566-4f6e-854a-e1f9b7c283c1?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=04b55aae47a31d361701ce60d6ee6432", "srcset": "https://si.imgix.net/f0d0c0b0/uploads/origins/db0f92dd-c566-4f6e-854a-e1f9b7c283c1?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=04b55aae47a31d361701ce60d6ee6432, https://si.imgix.net/f0d0c0b0/uploads/origins/db0f92dd-c566-4f6e-854a-e1f9b7c283c1?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a3dca11fe37271a82d64b04d055fc330 2x, https://si.imgix.net/f0d0c0b0/uploads/origins/db0f92dd-c566-4f6e-854a-e1f9b7c283c1?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b5e931603d3aa888e7ee7245ab1e2fae 3x"}, "body": "お世話になっております！\n以前ﾅｷﾞﾁｬﾝ風に自分のアバターを描いていただいた者です。\nhttps://skeb.jp/@ato_krgr/works/5\n\nあまりに使い勝手がよいもので様々な形で使用させていただいております、前回は本当にありがとうございました。\nもしよろしければ追加で同じ子を描いていただきたく思い、再び依頼をさせていただいた次第です。\n\n■キャラクター\nお願いしたいキャラクターは前回と髪型や衣装を含めて全く同じ子になります。\n\n以下は前回の依頼文写しです\n凪+エクリシェ（一部ネクタリア）を組み合わせたわたしのアバターです。\n球体関節・四つ腕お人形の女の子になります。おやすみワンピースという衣装を着せています。\n\nアバター・衣装の二次創作については可能であることを確認しております。\n必要であればご確認ください。\n凪-Nagi-\nhttps://booth.pm/ja/items/5345398\nエクリシェ\nhttps://booth.pm/ja/items/4689299\nネクタリア\nhttps://booth.pm/ja/items/4218255\nおやすみワンピース\nhttps://booth.pm/ja/items/3934905\n\n■要望\nどれもﾅｷﾞﾁｬﾝ風で前回の作品と画風を揃えていただければ嬉しいです。\n①Skeb資料（資料URL）フォルダ内「裏面依頼.png」(前回作成いただいたもの)の後ろの視点で描いた背面像を作って欲しいです。\n※可能なら前回のものと輪郭を揃えていただければ助かります。\n\n②アバターの元になっている「ネクタリア」という子の装備品である回転ノコギリをコミカルに描いてほしいです。\n資料内にも参考画像を用意してあります。\n\n③上記の回転ノコギリをキャラクターに持たせてあげてください。\n部分的な差分で結構ですので交互に表示すれば振っている様に見えるようにおねがいします。\n\n④提示した料金で余裕があれば、お任せでAFKや何らかの用途でつかえそうなものを何点か描いていただければ嬉しいです。\n\n複数の依頼をまとめるような形でお願いして申し訳ありません。\n急ぎませんので、受けていただけるのであれば楽しみに待たせていただきます。\n\n■使用用途\nSNS等での個人利用の範囲内で利用します。\nVRChatのアバターやワールドに仕込む可能性はありますが、Publicとして誰にでも使用できるようにはいたしません。\n商用利用は一切予定しておりません。\n\nPNGファイル、可能ならばPSDかClipファイルで納品ください。\n注文が多くて申し訳ありません。\nご多忙の中恐縮ですが、ご検討何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1_NAr0exsaPszgdaWno4UPRwseRf0Jn_Y?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ato_krgr/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1614469, "client_id": 3542225, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea571453/uploads/origins/408ed6cd-8f05-4cc6-aa76-e8acba9b2414?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=ba77a4bea0e4811c1246d2ec9e2a1862", "srcset": "https://si.imgix.net/ea571453/uploads/origins/408ed6cd-8f05-4cc6-aa76-e8acba9b2414?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=ba77a4bea0e4811c1246d2ec9e2a1862, https://si.imgix.net/ea571453/uploads/origins/408ed6cd-8f05-4cc6-aa76-e8acba9b2414?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ee0cf98b38f26edd48c253e154146e6 2x, https://si.imgix.net/ea571453/uploads/origins/408ed6cd-8f05-4cc6-aa76-e8acba9b2414?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=f80c871de3dbeeebdc5974cd2d0c37a7 3x"}, "duration": null, "