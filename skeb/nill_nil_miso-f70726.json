ティーンエイジャーで、どこか独裁者めいた雰囲気があります。独特のセンスと、印象に残る瞳の魅力を引き出していただけると嬉しいです。グロテスクな要素を少し加えていただいても構いませんし、なくても問題ございません。\n\n衣装について\n参考画像をいくつかお送りしますが、先生のセンスにお任せして自由にアレンジしていただいて大丈夫です。\n\n演出について\n先生の優しい色使いが大好きなので、ぜひその魅力を活かしていただきたいです。可愛らしい仕草や、女の子らしい動きのある構図にしていただけると嬉しく思います。\n\n細部は全て先生にお任せいたします。もし規定の金額でご予算が足りないようでしたら、再送りいただいても構いません。何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1n4oVXENb2LQDtNp83yUpWsxYkWNbJift", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nill_nil_miso/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3960056, "client_id": 3996992, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef5b2595/uploads/origins/7edfd0f2-285e-48fa-83e3-09c48d3fd794?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1834544017bb4dda8ec8119be5ab0745", "srcset": "https://si.imgix.net/ef5b2595/uploads/origins/7edfd0f2-285e-48fa-83e3-09c48d3fd794?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1834544017bb4dda8ec8119be5ab0745, https://si.imgix.net/ef5b2595/uploads/origins/7edfd0f2-285e-48fa-83e3-09c48d3fd794?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ba4a83dd2e93d4a3c3e3c3c0fdfe5bc 2x, https://si.imgix.net/ef5b2595/uploads/origins/7edfd0f2-285e-48fa-83e3-09c48d3fd794?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e58d84ed360a0f88a40009e81b9522c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef5b2595/uploads/origins/7edfd0f2-285e-48fa-83e3-09c48d3fd794?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e57959fd4e42423b35ab1b55b6ae5a63", "srcset": "https://si.imgix.net/ef5b2595/uploads/origins/7edfd0f2-285e-48fa-83e3-09c48d3fd794?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e57959fd4e42423b35ab1b