55-0854-4bfd-b78c-588efd6a3c17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=182ce70651a2f039275cbdc32c30554a", "src_set": ""}, "body": "こんにちは！またあなたの美しいアートをリクエストしに来ました。\n\n今回は私のもう一人のキャラクター、アリエッタを描いてほしい。この女の子は人形なので、人形のような関節を意識して描いてほしい。完璧である必要はありませんが、どうか忘れないでください。\n\n見逃しやすいディテールは、彼女の大きな眉です。\n\n性格はストイック。感情をうまく表現するのが苦手だが、だからといって思いやりと愛情を忘れない。友人といるときは、参考資料のように穏やかな目つきで微笑むことが多い。\n\nさらに、彼女の肩に乗っているカンタービレとカバレッタというミニチュアの人形も描いていただけるとうれしいです。彼らは生きていて、自由に動くことができます。\n\nカンタービレは大胆で外向的。\n\nカバレッタは控えめで内気。\n\nカンタービレとカバレッタには、まるで芝居の役者のように、小さな舞台の上にいてもらいたい。アリエッタは観客として、彼らのショーを楽しむ。\n\nhttps://drive.google.com/drive/folders/1ZSSoo4s4sNvnSQXTNWp5JYGl5NEDGiBj?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hanareyakuroha/works/20", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/22491c50/uploads/origins/16c8d09e-88bb-4ec5-954d-79bd0cbb43a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85fda1d95a037291644ae5914ccd1ca6", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3285232, "client_id": 514079, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hanareyakuroha/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3285232, "client_id": 3372773, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/185d02c2/uploads/origins/b86430a3-8d60-4436-98d1-800ab54df887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7b6e64d5a597cb56d93463847274183", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/185d02c2/uploads/origins/b86430a3-8d60-4436-98d1-800ab54df887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9061ac0165eb6c9c6b98cab2aa79368b", "src_set": ""}, "body": "おはようございます！以前、私の友人に描いてくれた作品のことをずっと考えています！あなたの画風はとてもバブリーでキュートです！\n\n私のキャラのジェミは、とってもフリフリで派手な魔法少女風の服を着てほしいです！あと、元気で活発なポーズをとってほしいです！犬のようなペタペタした耳と、キツネのような大きくてフワフワした尻尾！\n\nというのも、ジェミはすでにとても気立てがよく、愛情深く、ハートや愛を大切に考え、いつも笑顔でいる人だからです！彼はいつも周りの人たちを笑顔にするためにベストを尽くしている！前にも言ったように、彼はとても気立てのいい性格をしている。\n\n翻訳がどの程度になるかわかりませんが、ご検討のほどよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1DK56UglJX5nbz4Oy2dWZQyiDZLQvqQiu", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hanareyakuroha/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3285232, "client_id": 3220732, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0fe0c90/uploads/origins/ee67a74f-9313-4a0e-9ed3-14c5f8562b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11e0a20ab1737a324c16d56257795205", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0fe0c90/uploads/origins/ee67a74f-9313-4a0e-9ed3-14c5f8562b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=937dd32be8eb92926f00f0451b142137", "src_set": ""}, "body": "はじめまして！最近、偶然あなたのページを見つけ、あなたのアートに魅了されました！あなたの作品に隠されたユニークなスタイルが大好きで、友人にあなたを薦めたほどです！私たちは二人で、二人のキャラクターの絵をあなたに依頼することにしました！\n\nキャラクター1）はアリア。陽気で大胆な魔法少女で、マナを調整するラテックスのボディスーツを着ていて、その上にゆったりとした服を着ています。\nグウィンという名前の彼女の仲間もいます。ロボットのペンギンだ。\n\nキャラクター2）はジェミ。ペラペラの耳とふさふさの尻尾が特徴で、肌触りの良い服を着ている運び屋だ。とても陽気な性格で、いつも笑顔で人を気遣っている。ある意味、2人の性格はとても似ている！\n\nこの絵のアイデアは、二人が服を交換するというものだ。アリアがジェミの服を着たり、その逆もある。二人が面白がってやったかわいい行為だ！もし望むなら、コンパニオンのグウィンをどこかに追加して、誰が誰だかわからなくするのもいい！\n\nhttps://drive.google.com/drive/folders/1xWtrrmz8bZDiMk16djIZNz1XPVkpU478?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hanareyakuroha/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/999aa789/uploads/origins/c04d3bcd-f0a1-4575-adfa-c5d4d8438270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34e56e5b503333b96e2742176cc1996c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3285232, "client_id": 514079, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hanareyakuroha/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3285232, "client_id": 558031, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11a14695/uploads/origins/d4a83041-ddc7-4d84-bc70-a025d91b1eb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb0ef4b0ca0f751875f732fd5181203e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11a14695/uploads/origins/d4a83041-ddc7-4d84-bc70-a025d91b1eb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ed11757597da8c88b78310d4578c756", "src_set": ""}, "body": "こんにちは、黒羽さん。私の人魚の魔女のキャラクター、アイラは魔法を使おうとしているのですが、失敗してしまいます。彼女はあまり賢い子供ではありませんが、一生懸命頑張っています。\n\nhttps://drive.google.com/drive/folders/1chBt4VIt9tCuBYPZRW1w8vpv0vN7tqW3", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hanareyakuroha/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5f1137e6/uploads/origins/4b2a18d8-995f-4ee8-8c35-8110b0d88d2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit