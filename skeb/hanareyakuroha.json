re": "correction", "default_amount": 3000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@hanareyakuroha/works/30", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3285232, "client_id": 1246184, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/56c10701/uploads/origins/59afe7c3-e09e-4297-8a6a-f9ac2d6e590c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f044f3849c36bdc99f9549626ba030b2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56c10701/uploads/origins/59afe7c3-e09e-4297-8a6a-f9ac2d6e590c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=236ba0c74572f8fae6729dc3aa98e897", "src_set": ""}, "body": "前回は古い作品に関わらず受けて頂き、最高の作品をありがとうございます。\n同作品で続けてのお願いとなり申し訳ございません。\n少し無茶なお願いであることは認識しておりますので、対応が難しければ断って頂いて構いません。\n\n以下をお願いさせて頂くことは可能でしょうか？\nキャラクター：マリ と ユキ（氷河戦士ガイスラッガー）\n服装：2人とも戦闘服とヘルメット装着姿で、ポーズはお任せさせて頂きたいです\n\nユキについては特殊なため、少し説明させてください。\n劇中ではガイスラッガーとなるために改造手術を受けたものの、手術に失敗して散ってしまった少女です。\n手術に成功してガイスラッガーになれていたらという仮定の絵を描いて頂きたいですが、1話のみのゲストキャラの上に、前述の事情のため登場シーンも限られ、資料になりそうなものもこの2カットくらいです。\nhttps://pbs.twimg.com/media/GartycpacAAdCzB?format=jpg&name=large\nhttps://pbs.twimg.com/media/Gart1FSaAAMTJtD?format=jpg&name=large\nさらに戦闘に投入されるまでに至らなかったため、戦闘服とヘルメット姿の公式設定がありません。\nそのため、以下の形でお願いさせて頂けないでしょうか。\n\nユキの戦闘服とヘルメットについて\n公式設定がないためマリと同仕様にして頂き、個人カラー（マリは黄緑色）の部分をユキのカラーである桃色にしてください。\nガイスラッガーのヘルメットは、ヘルメットから生える角（？）の形を1人ずつ個別に変えているため、マリのヘルメットをベースに角の形を少し変えて頂けると幸いです。\n\nアニメ本編では実現しなかった、2人一緒に戦う姿を描いて頂けると幸いです。\nよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hanareyakuroha/works/29", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/959de641/uploads/origins/7906c909-cc3a-451d-ae76-6b06a862884c?bg=%23fff&