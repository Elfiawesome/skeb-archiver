、Vhelのアートをお願いしたいです。  彼女は物静かで真面目な性格ですが、見た目とは裏腹に邪悪な面も持っています。\n彼女に似合うテーマはゴシックでダークなものですが、自由に創造してください。\n彼女の主な特徴は、赤い肌、金の目、4本の角、鱗、とがった尻尾です。\n角、尻尾、鱗の色は黒にしてください（参考画像では紫色になっています。すみません！)\n\n服装は変えてもいいし、参考URLのものを使ってもいいし、おまかせします。\n自由な発想で、あなたのスタイルで描いてください。\n\nご配慮いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1HI5wVSBVwNBhJprK9iJnY3MPCSeewe5m?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@phxj18iy4nkxgnu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1709757, "client_id": 1413332, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a87b5322/uploads/origins/4cb16896-fad4-4481-80bb-ce933673ae81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d474ac7b41eb657d2f8749b85bf943b", "srcset": "https://si.imgix.net/a87b5322/uploads/origins/4cb16896-fad4-4481-80bb-ce933673ae81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d474ac7b41eb657d2f8749b85bf943b, https://si.imgix.net/a87b5322/uploads/origins/4cb16896-fad4-4481-80bb-ce933673ae81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=feb0956b64aea497759ed6329f43a46d 2x, https://si.imgix.net/a87b5322/uploads/origins/4cb16896-fad4-4481-80bb-ce933673ae81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d9d5134af4292ac59bd20dc485374be 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a87b5322/uploads/origins/4cb16896-fad4-4481-80bb-ce933673ae81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09b9eb2596ac5dc244f07c31acece4ca", "srcset": "https://si.imgix.net/a87b5322/uploads/origins/4cb16896-fad4-4481-80bb-ce933673ae81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09b9eb2596ac5dc244f07c31acece4ca, https://si.imgix.net/a87b5322/uploads/