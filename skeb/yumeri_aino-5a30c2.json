eドライブにて共有させて頂きます。\nお忙しい中恐縮ではございますが、どうぞご検討のほどよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1QEDf666pXmAUTZ9W4LQmnvlQnIOtzWZ6", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumeri_aino/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 498414, "client_id": 2129520, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bad48c70/uploads/origins/8fa8998e-0a51-486d-aae0-c6f44f828c12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b46627b3b60650c61b1a049d7756c6a6", "srcset": "https://si.imgix.net/bad48c70/uploads/origins/8fa8998e-0a51-486d-aae0-c6f44f828c12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b46627b3b60650c61b1a049d7756c6a6, https://si.imgix.net/bad48c70/uploads/origins/8fa8998e-0a51-486d-aae0-c6f44f828c12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c09b272ba9e096e0d44038c5323db6a 2x, https://si.imgix.net/bad48c70/uploads/origins/8fa8998e-0a51-486d-aae0-c6f44f828c12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18fbde5f2fc16ae75f853bbb3621eb0b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bad48c70/uploads/origins/8fa8998e-0a51-486d-aae0-c6f44f828c12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48eb5e304cac327f903b57a32775832f", "srcset": "https://si.imgix.net/bad48c70/uploads/origins/8fa8998e-0a51-486d-aae0-c6f44f828c12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48eb5e304cac327f903b57a32775832f, https://si.imgix.net/bad48c70/uploads/origins/8fa8998e-0a51-486d-aae0-c6f44f828c12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d8adeada9a1a6c63b75afa927a67c3cf 2x, https://si.imgix.net/bad48c70/uploads/origins/8fa899