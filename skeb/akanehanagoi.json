": null, "private": false, "genre": "art", "tipped": false, "creator_id": 418, "client_id": 544433, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a032030/uploads/origins/2c7cb078-07f4-4342-b4f9-3815607ddf2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79a80fa7f6f2761a8060a9ad833c3868", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a032030/uploads/origins/2c7cb078-07f4-4342-b4f9-3815607ddf2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f8b41594595d2b6e78c1c06d7ba8f06", "src_set": ""}, "body": "こんばんは！この度うちの子のハナちゃんを依頼したいです。\n\n依頼内容はうちの子がちょっとだらしない感じで、Tシャツ一枚着たままに乳輪と乳首がスケスケで見える感じを表現させてもらいたいです。前髪は縛り上げた感じです。まるでシャワー浴びた直後とか、休日の家で宅配を受けるときの無防備な状態的な…そういうことです。\n\nhttps://imgur.com/oauEAgn　こちれがうちの子で\n\nhttps://imgur.com/5coel0s　こちらは参考資料になります。\n\n尻尾はツートンカラーですので宜しくお願い致します。\n\n背景や服装の詳細はお任せします。改めて、宜しくお願い致します。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@akanehanagoi/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 418, "client_id": 139397, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92352426/uploads/origins/4412d3e9-6c5d-429c-8bd1-dffe68fd0d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cf0aecffafa473d7abf1c15d66df18f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92352426/uploads/origins/4412d3e9-6c5d-429c-8bd1-dffe68fd0d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e69561585cb64e63efc2a8cdb8fe2a9", "src_set": ""}, "body": "初めまして、berhubeと言います!\n\n今回に依頼したいことは\n\n僕のキャラのヒナと、友達のキャラのカエンがカフェのテラスで楽しく話す姿をお願いします!\n\n\n念のため、構図の参考用の絵を添付したりしましたが、自由に描いていただきたいです!\n\nこの依頼で絵を描きながら、 楽しんでくれたら嬉しいです。\n\nよろしくお願いします!\n\nhttps://drive.google.com/folderview?id=1g_JHL4EqPPPXq_CZhMDfGj7jU6SjkOUH", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@akanehanagoi/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 418, "client_id": 33105, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8f180ec/uploads/origins/3604af26-3d9a-470c-a856-d0103ca4cbab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec326bc80dfe78c8ef62d6d1dd5ac0d1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8f180ec/uploads/origins/3604af26-3d9a-470c-a856-d0103ca4cbab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=700f4b6cad779225cb522c410b9fe1c3", "src_set": ""}, "body": "服をゆるく着て、酔ってはしゃいでいる状態を描いてほしいですね。\n\nhttps://cdn.discordapp.com/attachments/676596741260181535/875010305137209415/Hofh0Zy.png", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 8589, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "AO FUJIMORI", "screen_name": "AoFujimori", "avatar_url": "https://pbs.twimg.com/profile_images/950251090859016192/DQeczLw8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/88944548/1406191174/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "nc": 177}, {"id": 295562, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ざくろ@ｺﾐﾃｨｱＣ48a➡けもケA24", "screen_name": "zakro_zkzk25", "avatar_url": "https://pbs.twimg.com/profile_images/1952180059281969152/-Esun72c.jpg", "header_url": "https://pbs.twimg.com/profile_banners/17