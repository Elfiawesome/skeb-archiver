ps://si.imgix.net/db1f62f1/uploads/origins/411f0667-19f1-487e-9d2f-c8c21076dd74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91eb4b5a01900ad7371c57bb1a621b69", "srcset": "https://si.imgix.net/db1f62f1/uploads/origins/411f0667-19f1-487e-9d2f-c8c21076dd74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91eb4b5a01900ad7371c57bb1a621b69, https://si.imgix.net/db1f62f1/uploads/origins/411f0667-19f1-487e-9d2f-c8c21076dd74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d816b96d826b3d202393218c52e54c82 2x, https://si.imgix.net/db1f62f1/uploads/origins/411f0667-19f1-487e-9d2f-c8c21076dd74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f8f519ba4bace30649d4f5eea30418a0 3x"}, "body": "こんにちは。私のイメージに基づいて、手塚作品のキャラクターを描いていただけませんか？ここではタカシとアミは夫婦ですので、とても仲睦まじい様子で描いてください。私は、あなたの「ユニコ」のイラストのような、フラットでシンプル、パステル調の画風が好きなので、その雰囲気で描いていただけると嬉しいです。タカシにはストライプのシャツを着せていただけると嬉しいです。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1jOwo8wxbPSMATcJn7YjbmVBrJe_jflRS?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ddzoko__/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4066887, "client_id": 3572105, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f1890cc/uploads/origins/2d98f7a5-48a7-4bc9-8888-c1fb9c7972cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fddb6b75ac8ff40b7d02552ff674d680", "srcset": "https://si.imgix.net/2f1890cc/uploads/origins/2d98f7a5-48a7-4bc9-8888-c1fb9c7972cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fddb6b75ac8ff40b7d02552ff674d680, https://si.imgix.net/2f1890cc/uploads/origins/2d98f7a5-48a7-4bc9-8888-c1fb9c7972cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26e115ff6ce4e02ce116c22ec6dc1c21 2x, https://si.imgix.net/2f1890cc/uploads/origins/2d98f7a5-48a7-4bc9-8888-c1fb9c7972cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9683817b4b4f124f581725608f5959d1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f1890cc/uploads/origins/2d98f7a5-48a7-4bc9-8888-c1fb9c7972cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc078e0ebbe52f922df6cb25bf522be3", "srcset": "https://si.imgix.net/2f1890cc/uploads/origins/2d98f7a5-48a7-4bc9-8888-c1fb9c7972cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc078e0ebbe52f922df6cb25bf522be3, https://si.imgix.net/2f1890cc/uploads/origins/2d98f7a5-48a7-4bc9-8888-c1fb9c7972cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=04bae048c21da64a1f693c904fe25bf9 2x, https://si.imgix.net/2f1890cc/uploads/origins/2d98f7a5-48a7-4bc9-8888-c1fb9c7972cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4399f58e777c4f9c00662aed27fa4acd 3x"}, "body": "This is a romantic artwork between two characters. I'd like to describe the tone or atmosphere of this artwork as sweet and embracing in a way.\nThe characters are from the game called \"Limbus Company.\"\nThe first character, Yi Sang, is a male.\nThe second character, Ishmael, is a female.\n\nThe two are in their Liu Association IDs and attire, but are in bed doing the reference as posted.\nIt's night time, although a light source should still be around to show off their poses in a good enough brightness.\n\nI will leave it up to you on how covered or uncovered their clothes are, but make it notable that it's the Liu Association attire. Either that or implying they were in their Liu association attire by having the clothing hanged somewhere or dropped somewhere whether on or out of the bed. If you want to be extra, do the same thing with Yi Sang's sword and saingeom (his dagger). The same with Ishmael's gloves.\n\nThat is all, thank you, have fun and take your time.\n\nhttps://drive.google.com/file/d/11VT8bhsJ6TU8D7gfMpIEvipPn9Zvc7Ly/view?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 889924, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "犬束モト", "screen_name": "1wan1_", "avatar_url": "https://pbs.twimg.com/profile_images/2087174825194520576/jSS0kuYV.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1148800976612024320/1786494109/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 1342871, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あおい🍓skeb募集中", "screen_name": "0ud0ntabetabe", "avatar_url": "https://pbs.twimg.com/profile_images/1433473451776352267/elcS7vXN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1376932988450000896/1634212044/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 2310236, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ちろしろん@イラスト描いてます。", "screen_name": "sironn16", "avatar_url": "https://pbs.twimg.com/profile_images/1565554047305715712/BGT8z0tT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/613286384/1658825252/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "a