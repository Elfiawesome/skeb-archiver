uto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2aa4caddc2236fc21a0c4f94e56dbf7, https://si.imgix.net/0ea052f7/uploads/origins/9091ee01-9d89-4c60-b2bb-92464c433da5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6872336c5d96e0136970ba08648fcfec 2x, https://si.imgix.net/0ea052f7/uploads/origins/9091ee01-9d89-4c60-b2bb-92464c433da5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a35287e31df08f64338931f3a1f58c64 3x"}, "body": "ももせ氏様、初めまして。\nももせ氏様のイラスト絵柄がとても好みであったため依頼させていただきました。\n\n今回は私、Vtuberの【琥寅がりゅる】を描いていただきたいです。\n\n・構図\n表情→無邪気な笑顔\nポーズ→両手で軽くスカートを持ち上げている\n細かい構図や背景等はお任せ致します。\n\n・使用用途\nSNSのツイート（Vtuberフォロー祭りのハッシュタグツイートなど）とYouTubeのサムネイルに使用する予定です。\n（人物のみの背景透過差分をいただけるととてもありがたいです）\n\n・サイズ\n8:9の縦長でお願い致します。\n\nもし太ももが映るイラストを描く場合、右太ももにほくろがあるので描くときに気をつけていただけると嬉しいです…！\n\nskebでのイラストの依頼が初めてですのでわかりにくかったらすみません…🙇‍♀️\nよろしくお願い致します！！\n\nhttps://x.com/kotora_garyuru/status/2016800396233363836?s=46", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@momolatten/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3791148, "client_id": 3267780, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3f6ae3c/uploads/origins/eac32049-72d3-4e5e-bbf1-a7613caa1d02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58f7242dd5711749f0439aec25aba181", "srcset": "https://si.imgix.net/b3f6ae3c/uploads/origins/eac32049-72d3-4e5e-bbf1-a7613caa1d02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58f7242dd5711749f0439aec25aba181, https://si.imgix.net/b3f6ae3c/uploads/origins/eac32049-72d3-4e5e-bbf1-a7613caa1d02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4f41ca6b5316eaf55f84b4b94644a7c 2x, https://si.imgix.net/b3f6ae3c/uploads/origins/eac32049-72d3-4e5e-bbf1-a7613caa1d02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89f4f0e562f1159600e4b9adc446246e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3f6ae3c/uploads/origins/eac32049-72d3-4e5e-bbf1-a7613caa1d02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16d2530d1395970cb669b35c78bd8233", "srcset": "https://si.imgix.net/b3f6ae3c/uploads/origins/eac32049-72d3-4e5e-bbf1-a7613caa1d02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16d2530d1395970cb669b35c78bd8233, https://si.imgix.net/b3f6ae3c/uploads/origins/eac32049-72d3-4e5e-bbf1-a7613caa1d02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8197382565ff0abc43a7659c694443ab 2x, https://si.imgix.net/b3f6ae3c/uploads/origins/eac32049-72d3-4e5e-bbf1-a7613caa1d02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fb50d08bac1a73dc7c6f762bd3465714 3x"}, "body": "初めまして。\nVtuber活動をしているMaster雨音と申します。\n\nTwitterで素敵なイラストを拝見し、\nぜひ私の姿を描いていただきたく依頼致しました。\n\n■用途\n主に活動で使用します。\nサムネ、SNSやグッズ等の利用を想定しています。\n\n■キャラクター\n変身により、4つ(SD含め6つ)の形態になれるのですが、\n姿は添付資料からももせ氏様のお好みでお選びいただけたらと思います。\n\n■服装・ポーズ\nももせ氏様の癖を存分に表現いただける衣装（正装以外でもよいです）、ポーズをお任せ致します。\n\nお受けていただけるのであれば、ぜひ宜しくお願い致します。\n\nhttps://drive.google.com/file/d/11u_dfmChwxYG0t-xGDYfs4AH6oqy7DZh/view?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@momolatten/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3791148, "client_id": 3804217, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8ea4226/uploads/origins/9ec08fc2-ef1f-4eaa-9c94-688b44c6769f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53290c0bfc2b0a5f6717f15a9d65ce62", "srcset": "https://si.imgix.net/e8ea4226/uploads/origins/9ec08fc2-ef1f-4eaa-9c94-688b44c6769f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53290c0bfc2b0a5f6717f15a9d65ce62, https://si.imgix.net/e8ea4226/uploads/origins/9ec08fc2-ef1f-4eaa-9c94-688b44c6769f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bba7f379a8d071d2a8f7642ddc09b80 2x, https://si.imgix.net/e8ea4226/uploads/origins/9ec08fc2-ef1f-4eaa-9c94-688b44c6769f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21f010d9b609bf9026c0bdb1bba32a4f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8ea4226/uploads/origins/9ec08fc2-ef1f-4eaa-9c94-688b44c6769f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b3eb1104889de35267db791a3780e24", "srcset": "https://si.imgix.net/e8ea4226/uploads/origins/9ec08fc2-ef1f-4eaa-9c94-688b44c6769f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b3eb1104889de35267db791a3780e24, https://si.imgix.net/e8ea4226/uploads/origins/9ec08fc2-ef1f-4eaa-9c94-688b44c6769f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=804cd66d4312c4a58a62dc76dbb06490 2x, https://si.imgix.net/e8ea4226/uploads/origins/9ec08fc2-ef1f-4eaa-9c94-688b44c6769f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a226eda2c12ae3354bfd455dc6ff5d99 3x"}, "body": "はじめまして\n\n現在Vtuber準備中の水葉ミルアと申します\nXでももせ氏様の作品を拝見し、ぜひ描いていただきたいと思い依頼しました\n\n------------------------------------------------------\n【キャラクターについて】\n・歌や音楽が好きなのんびりしてる系中性的な男の子Vtuber\n・配色はうすめの緑や水色\n・アクセサリーは首元のヘッドホンがメインであとはおまかせします\n・もし可能であればで構いませんので、表情差分などいただけると嬉しいです（必須ではありません）\n\n【シチュエーション・構図】 \nライブステージで、アップテンポな曲をとにかく楽しそうに熱唱している姿をお願いします\n    表情: 満面の笑みで、口を大きく開けて歌っている（ウインクしていてもOKです！）\nポーズ: 片手でハンドマイクを持っていて、もう片方の手は楽しさを表現するような動きがあればそれを描いていただければ助かります\n                \n\n【使用用途】\n・X、YouTube等各種SNSでの宣材写真としての使用\n・Youtubeコンテンツのサムネやヘッダーへの使用\n・その他活動全般へ使用\n\n【納品形式】\n・人物と背景がレイヤー分け