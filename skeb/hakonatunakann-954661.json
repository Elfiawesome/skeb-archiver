fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83cf94b72ba06cb4d9a63d0c2654dd21, https://si.imgix.net/a08434a4/uploads/origins/5ae6ce9a-4663-4c02-8684-f1cfbcf0e354?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d27836bfde5da1d79dd500798169c5f3 2x, https://si.imgix.net/a08434a4/uploads/origins/5ae6ce9a-4663-4c02-8684-f1cfbcf0e354?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1e0fd9f33fee65422cf471992ae3eb6e 3x"}, "body": "こんにちは。私のキャラクターが写真のように座ってスマホをいじっている絵をお願いしたいのですが、ウインクはなしで、足や靴（または両方）を入れていただけますか？彼女は靴下を履かないので、机の上に靴下を置く必要はありません。\nhttps://pbs.twimg.com/media/E1TXt-1XIAESraJ?format=jpg&name=medium\nできれば、右下の足の向きを変えてください（靴を履いていてもいなくても）。\n靴を描く場合は、以下を参考にしてください。\nhttps://mobile.twitter.com/HDPS64/status/1378021576688480259\n\nhttps://twitter.com/HDPS64/status/1395713789492875265?s=19", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hakonatunakann/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/92d3310d/uploads/origins/d9e499da-6911-47f2-981b-406cb8c13c27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5dc873fbfec1db8824579bdeb60e956", "srcset": "https://si.imgix.net/92d3310d/uploads/origins/d9e499da-6911-47f2-981b-406cb8c13c27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5dc873fbfec1db8824579bdeb60e956, https://si.imgix.net/92d3310d/uploads/origins/d9e499da-6911-47f2-981b-406cb8c13c27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8d60b237814e20946456b097bbb4d98d 2x, https://si.imgix.net/92d3310d/uploads/origins/d9e499da-691