して動けなくなっためぐみんが、バンザイみたいに両手を頭上に投げ出して脱力しながら仰向けに倒れている格好のところに足元から大量の触手が現れてめぐみんに襲いかかっている構図でお願いします。\n\n触手は舌のような扁平状の形でぬるぬるとしていてめぐみんの全身に絡みついており、各腕、頭、胴体、各足など満遍なく巻き付いたり素肌を撫でるように這い回ったりしている。\nできれば触手の内の一本だけ、先端がおへそに入り舐め回しているようにすると嬉しいです。\n\nめぐみんは(うわぁ…)となるような嫌悪感のある感じで焦っているも、全身を這い回るぬるぬるとした刺激に身体中ピクピクっと反応させて、感じてしまっているのを声を殺して我慢している様子。\n\n可能でしたら、差分として触手に全身絡みつかれる直前の状態(膝下あたりまでに触手が纏わりついていてこれから這い上がってきそうなあたり)もお願いします。\n\nマニアックなシチュですが、よろしくお願いします。(一応NSFW設定にはしておきます)", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ttsuki0/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1082412, "client_id": 3063412, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ab47a9c/uploads/origins/9ccb8fb6-7ad4-442f-b63d-08249a59ee40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=396942e226175b95203916f5403baced", "srcset": "https://si.imgix.net/3ab47a9c/uploads/origins/9ccb8fb6-7ad4-442f-b63d-08249a59ee40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=396942e226175b95203916f5403baced, https://si.imgix.net/3ab47a9c/uploads/origins/9ccb8fb6-7ad4-442f-b63d-08249a59ee40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6223bd7014550d4c70ee505cae7939ee 2x, https://si.imgix.net/3ab47a9c/uploads/origins/9ccb8fb6-7ad4-442f-b63d-08249a59ee40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fa000a868c8a6b25cb658d9b1262ae7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ab47a9c/uploads/origins/9ccb8fb6-7ad4-442f-b63d-08249a59ee40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd7c34432a17bc1e511dfec460e582c5", "srcset": "https://si.imgix.net/3ab47a9c/uploads/origins/9ccb8fb6-7ad4-442f-b63d-08249a59ee40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur