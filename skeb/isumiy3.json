fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06140d95f6e52d998f4117adb1d1e039", "src_set": ""}, "body": "イスミさん、前回のイラストありがとうございました。今回も全身泉鏡花ちゃん×マリアンちゃんのキスシーンをお願いします。マリアンが教室に座っていて、鏡花が後ろからマリアンに抱きついてキスをする。できればマリアンの表情を複数描いてください。\n\nよろしくお願いします。\n\nhttps://imgur.com/a/K8P77iV", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@isumiy3/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2551809, "client_id": 926144, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03c002d8/uploads/origins/90bbfcbf-ea0f-45b4-911e-e6f895456246?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeed6bbac26852f8d0c4c1a37faf83bb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03c002d8/uploads/origins/90bbfcbf-ea0f-45b4-911e-e6f895456246?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=875639e612cafd1d13c7d80c5ff954b0", "src_set": ""}, "body": "泉鏡花ちゃんがマリアンちゃんに不意打ちのキスをしている全身イラストを描いてください。鏡花ちゃんがマリアンちゃんの両手首を壁に固定している。マリアンちゃんは鏡花ちゃんより背が高い。背景はカフェ。ありがとうございます。\n\nhttps://imgur.com/a/3BFFQaQ", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@isumiy3/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2551809, "client_id": 2829683, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19eec000/uploads/origins/71fe0e1b-639f-4968-adda-998c8bf58c3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4424b6fcc4ddafa5ca2ddd4821803816", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19eec000/uploads/origins/71fe0e1b-639f-4968-adda-998c8bf58c3d?bg=%23fff&auto=format%2Ccompress&fm=webp