=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=aa7377b828d26ad309b7205eb7f4c8d1", "src_set": ""}, "body": "またまたこんにちは！最近、私のVTuber（ルイーズ）を更新したので、彼女を主人公にしたくすぐりアニメをまたリクエストしたいです！ https://drive.google.com/file/d/1Xx81zAl6PITU9Srqraho_ATbsKDrLQE3/view?usp=sharing\n\nニート、ひきこもり。外でも裸足でいるのが大好き。\n\nアイデアや詳細はお任せしますが、足をくすぐられたいです～ 最初は笑いをこらえているのですが、くすぐりが長く続くとだんだん笑い出してしまいます！\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/file/d/1Xx81zAl6PITU9Srqraho_ATbsKDrLQE3/view?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SOULCHAN/works/137", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/57c9de22/uploads/origins/06893ae6-3362-459c-8b10-56f0fd7ec856?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09cafb4861a0db0a84a9bfff830dc093", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1530335, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@SOULCHAN/works/136", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1530335, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9e20e9a/uploads/origins/bed007a4-6f5c-4dac-9dd5-700034523ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1274e5e5908f19c8426a3a43ed8b00c5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9e20e9a/uploads/origins/bed007a4-6f5c-4dac-9dd5-700034523ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe04c4f5443c350f2e9e3b12b526086c", "src_set": ""}, "body": "お世話になります。\nよろしければ、以下のイラストと差分のご依頼をお引き受けして下さると嬉しいです。\n\n・巨根巨玉ふたなりのソウルさんと魔女王さんがガニ股脇見せフレームバインダー拘束の状態で、先端が筆のマジックハンドに全身と敏感な股間をくすぐられる前・くすぐられて悶絶しているイラスト\n\n概要:\n・無機質な壁の施設に、むちむちプロポーション(skeb103 教師ふたなりソウルくすぐり漫画のようなグラマーなプロポーション)のソウルさんと魔女王さん(できれば魔女王さんの方がソウルさんより全体的にボリューム増、巨根、乳輪大きめ)が全裸でフレームバインダー拘束でガチガチに拘束されている。\n\n・フレームバインダーは脇見せガニ股(脇見せはバンザイか、両手を後頭部に置いたようなポーズのどちらか)の状態で拘束され、四肢はもちろん、腰や首すらもがっちり固定され、微塵も動けない状態。\n\n・個人的な設定としては、二人はアマエルさんかフェアリーの策略で、ふたなり寸止めくすぐり拷問をされている感じで、魔法または薬による影響と、何日も射精出来ていない状態であるため、おち◯ちんは長く太くビキビキといきり立ち、巨玉は水風船のように膨らみ破裂寸前を表すかのように少々脈が走っている。\n\n・そんな状態の二人に、様々な角度から二人を責め立てんと迫る無数のメカメカしい触手たち。\n先っぽには手ではなく、柔らかそうな筆のような穂先が生えている。\n二人はそれを、射精できなくて悶々とした感情と、今日こそは射精出来るのではという期待が混じった複雑な笑顔で触手達が自分に触れるのを待っている→基本イラスト\n\n・閉じれない脇、脇腹、グミのように勃起した乳首、太もも、鼠径部、足裏、そしてバキバキに勃起したちん◯、巨玉と、全身余すことなく這い寄って無防備な二人を優しくくすぐる触手達。\n二人はそのくすぐったく、淡く甘美な快感にただただ酔いしれながら甘い切ない喘ぎ声を喚くしか出来ないでいた→差分1\n\n以上のような、基本イラストと差分を合わせたものをご依頼したいです。\n2人のセリフは特に考えていなく、イラストであるためSOULCHAN様の考えで入れても入れなくても問題ないのですが、できれば「こちょ♡」という擬音を全体的に入れて下さると嬉しいです。\n\nもし料金的に差分厳しいようでしたら、差分を基本イラストにしていただければと思います。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SOULCHAN/works/135", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9869e7fc/uploads/origins/b7c2c6d9-78d7-4e6c-ade5-bccfd3e565d3?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f06273948dc6950969c65b2d6ae62794", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1530335, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@SOULCHAN/works/134", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1db27e8b/uploads/origins/05ee3e32-bcd8-4071-afed-6b1e69e1e2c6?bg=%23fff&auto=format%2Ccompr