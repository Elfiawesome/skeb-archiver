置はA4横サイズの下半分あたり\n・文字の装飾(縁取りや図形等で目立たせる等)はおまかせします。\n・文字はウインディちゃんができるだけ隠れないよう、かつ目立つを両立できるのが好ましいです。離席中なのが分からないと離席札の意味がないので……\n・「離席中なのだ！」の文字以外は無くて良いです。\n・ウインディちゃんのポーズはおまかせでお願いします。そのとき描きたい気分で描いちゃってください！！！！！\n\nhttps://images.app.goo.gl/ayX2uHq7oYqV2X6x9", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gyukaku_dondon/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3032787, "client_id": 2488239, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb2c7328/uploads/origins/bebbfd6f-f47b-4715-ad30-6f460034f7aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c8ece8ee15f6734a1dbc2560de04aeb", "srcset": "https://si.imgix.net/fb2c7328/uploads/origins/bebbfd6f-f47b-4715-ad30-6f460034f7aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c8ece8ee15f6734a1dbc2560de04aeb, https://si.imgix.net/fb2c7328/uploads/origins/bebbfd6f-f47b-4715-ad30-6f460034f7aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97ce8f0372d37f4507aad5563c2f76e1 2x, https://si.imgix.net/fb2c7328/uploads/origins/bebbfd6f-f47b-4715-ad30-6f460034f7aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fde9e6821b8e20a651f48170808c077 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb2c7328/uploads/origins/bebbfd6f-f47b-4715-ad30-6f460034f7aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70b1e499b1d116354793400307fad46f", "srcset": "https://si.imgix.net/fb2c7328/uploads/origins/bebbfd6f-f47b-4715-ad30-6f460034f7aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70b1e499b1d116354793400307fad46f, https://si.imgix.net/fb2c7328/uploads/origins/bebbfd6f-f47b-4715-ad30-6f460034f7aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop