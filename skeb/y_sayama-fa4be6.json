.shopserve.jp/ukiuki.jp/pic-labo/llimg/1210133_page1_17.jpg?t=20231218102526\n\n・露出度を抑えめ(布面積多め)にして欲しいですがふとももは必ず露出させて欲しいです。リンク先のニーソックスの画像くらい露出させて欲しいです\nhttps://item-shopping.c.yimg.jp/i/n/suteteko_im014_1\n\n・可能であればレオタードの上から服を羽織っているようなデザインでなくレオタードをベースにして服のパーツや装飾を追加していくようなデザインにして欲しいです\n\n・使用用途ですが他の人に依頼する際の服装の参考画像して使用したいです\n\n以上です", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@y_sayama/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2181917, "client_id": 90411, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78b0d7f8/uploads/origins/275e9203-298f-43d0-b8d2-7980017a3332?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fc1bb2d2c58bd7e176384bfec0bc239", "srcset": "https://si.imgix.net/78b0d7f8/uploads/origins/275e9203-298f-43d0-b8d2-7980017a3332?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fc1bb2d2c58bd7e176384bfec0bc239, https://si.imgix.net/78b0d7f8/uploads/origins/275e9203-298f-43d0-b8d2-7980017a3332?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3290349128962e2406e6d8bbf91e02aa 2x, https://si.imgix.net/78b0d7f8/uploads/origins/275e9203-298f-43d0-b8d2-7980017a3332?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df2d0ff1559d7b99da4c09cc2bd90d9e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78b0d7f8/uploads/origins/275e9203-298f-43d0-b8d2-7980017a3332?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91379ce15944d5d97b1d130c8d2f8695", "srcset": "https://si.imgix.net/78b0d7f8/uploads/origins/275e9203-298f-43d0-b8d2-7980017a3332?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91379ce15944d5d97b1d130c8d2f8695, https://si.imgix.net/78b0d7f8/uploads/origins/275e9203-298f-43d0-b8d2-