00&h=200&blur=200&s=058d068bd0aa02aca5a40df3357f373e, https://si.imgix.net/e59a8559/uploads/origins/9df5ba96-3ff6-4857-9754-ccfbb1a1ec52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=89ad8b8182e4db96542c21ad898c442c 2x, https://si.imgix.net/e59a8559/uploads/origins/9df5ba96-3ff6-4857-9754-ccfbb1a1ec52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b69695870e56ae60877d3b917ee71394 3x"}, "body": "こんにちは、こちらこそよろしくお願いします！アピールありがとうございます！私のOCをぜひ描かせてください。\n\nメリは妖怪狼の女の子で、常に拳と足を鍛えている、とても気取った子です。\n肉を食べるのが大好きで、そのため、トレーニングをしているにもかかわらず、お腹は少しふっくらとしている。\n寒さに強く、雪が大好き。\n満月の夜には目が光る。\n\n大きな胸と広いヒップを持ち、身長は170センチ以上。\nプロポーション：https://imgur.com/a/meris-full-body-oOcdpmk\nモデルシートと詳細：https://imgur.com/a/PnearIZ\n\nバナーやサムネイル、ライブ配信で使用するため、側面や上部をカットしないでいただけるとありがたいです。\n\nよろしくお願いいたします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekocatchatPura/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3080388, "client_id": 1825989, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/687e3547/uploads/origins/d979e756-1244-457e-9b5a-4615bc0b18d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4549a91faae88eceaf5e476ae8b6cc7f", "srcset": "https://si.imgix.net/687e3547/uploads/origins/d979e756-1244-457e-9b5a-4615bc0b18d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4549a91faae88eceaf5e476ae8b6cc7f, https://si.imgix.net/687e3547/uploads/origins/d979e756-1244-457e-9b5a-4615bc0b18d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46651a7d346a9ea3713a93025a803d02 2x, https://si.imgix.net/687e3547/uploads/origins/d979e756-1244-457e-9b5a-4615bc0b18d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11b0305fd803112a6e047f01fdd4f237 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/687e3547/uploads/origins/d979e756-1244-457e-9b5a-4615bc0b18d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a81608ce3b30f480da755e9a6bc4517c", "srcset": "https://si.imgix.net/687e3547/uploads/origins/d979e756-1244-457e-9b5a-4615bc0b18d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a81608ce3b30f480da755e9a6bc4517c, https://si.imgix.net/687e3547/uploads/origins/d979e756-1244-457e-9b5a-4615bc0b18d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3fcff1667f8cf91697759a8329dbad04 2x, https://si.imgix.net/687e3547/uploads/origins/d979e756-1244-457e-9b5a-4615bc0b18d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bfd5a379476886efc2f60a1abc9a712f 3x"}, "body": "こんにちは、はじめまして！\nアピールありがとうございます！\nスカーレットローズを気に入っていただけて嬉しいです！\nぜひぜひ描いていただきたいです\n\n緋璃さんの絵はとてもかわいいのですが、以前描かれたアクションシーン系のかっこいいイラストもとても好きで、こちらの配信https://skeb.jp/@nekocatchatPura/works/6や、Twitter/\"X \"にも投稿されている作品があります。\nもしよろしければ、同じような「かっこいい」雰囲気のスカーレットのシーンをお願いしたいです！\nスカーレットの特殊能力 \"ソーン \"のシーンでお願いします！\n\"ソーン \"は、スカーレットの体に触れているところなら、一定の範囲内であればどこにでも黒い金属片を作り出し、成長させることができます！\nこの金属片は成長し、一緒になって様々な構造物を作ったり、何かを囲む層を形成することができる。\nソーン \"が作り出す金属は非常に軽く、強く、鋭い！\n\"ソーン \"で作られた金属はダメージを受けても曲がらず、その代わりに強くぶつかると欠けたり砕けたりする。\nスカーレットは \"ソーン \"を次のようなさまざまな方法で使う：\n-さまざまな武器の構造体を作る\n-自分の能力で武器をコーティングし、改造する。\n-自分の周りにボディアーマーを作る\n-身体を武器化する（爪、ガントレットブレード、スパイクナックル、アームシールド、ソードアーム、ブーツスパイクなど）。\n-地面からスパイクを生み出し、敵を攻撃する。\n-バリア／トゲトゲの壁を作り、攻撃をブロックする。\n-他にもいろいろある！\n\"Thorn \"コンストラクトは、地面のスパイク攻撃のように、急いで無思慮に作れば作るほど、よりトゲトゲしたギザギザした外見になることが多い。\n武器や鎧のような構築物はより注意深く作られ、より明確で滑らかな、しかしまだトゲのあるデザインと外観を持つ。\n\nスカーレットが \"ソーン \"の能力を使って片手に鉤爪のガントレットを作り、それを見せるようなポーズをとっているシーンが欲しい！\n鉤爪のガントレットは、この画像 https://imgur.com/a/EoZsNfx のような感じにしてほしいです。\n残りのシーンはあなた次第です！\nシーンの雰囲気、強さ、状況、文脈は、あなたが描きたいものであれば何でも構いません！\n強烈で威圧的で脅威的なシーンにすることもできるし、もっとかわいくてリラックスしたシーンにすることもできる。\n何でも決めてください！\nどんなシチュエーションであれ、どんな状況であれ、スカーレットに \"ソーン \"の能力を発揮してほしいんだ。\nまだ説明し始めたばかりだし、リクエストにも取り上げてもらったばかりだから。\n\nスカーレットのデザインの主な衣装と最も正確な描写は、このリンクの中にあります： https://imgur.com/a/KkIqRcR\nこのリンクとその他の参考資料／正確な納品物は、同梱のGoogle Driveにもあります。\n\nテキストが足りなくなってきたので、スカーレットに関する追加情報は、私のSkebアカウントの他の配信でも見つけることができます。\n例えば、https://skeb.jp/@arimamiyao/works/11。\n\nお読みいただきありがとうございました。\n文章が多くて申し訳ありません！\n私のリクエストに魅力を感じていただけたら幸いです。\nよろしくお願いします。\nOC: https://drive.google.com/drive/folders/1ZRAGZ7uXbBuWuF0pTLaC8CcC5li9iX0B?usp=sharing\n\nhttps://drive.google.com/drive/folders/1ZRAGZ7uXbBuWuF0pTLaC8CcC5li9iX0B?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekocatchatPura/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3080388, "client_id": 2835866, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90594b6b/uploads/origins/5d86512a-534e-470f-b869-261ce32d413e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3aaf46efb47f3a50564c34259125853", "srcset": "https://si.imgix.net/90594b6b/uploads/origins/5d86512a-534e-470f-b869-261ce32d413e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3aaf46efb47f3a50564c34259125853, https://si.imgix.net/90594b6b/uploads/origins/5d86512a-534e-470f-b869-261ce32d413e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adc920cd8f4e634d747ab75e71bc5141 2x, https://si.imgix.net/90594b6b/uploads/origins/5d86512a-534e-470f-b869-261ce32d413e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a7a409d7384b71d5a103ee905781c82 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90594b6b/uploads/origins/5d86512a-534e-470f-b869-261ce32d413e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb952d621db2f168d0a5ca06381ed113", "srcset": "https://si.imgix.net