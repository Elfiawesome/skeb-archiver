ぐしている。\n3年間レースで走り続けた後に引退、キャラ①と共にある日を境に暮らし始めた。\n引退後もなお、憧れの父に追いつくという夢を叶えるために新たな舞台でも毎日ひたむきに努力している。\n\n✤キャラ② 髪の毛について\n頭頂部のボリュームがある所の内側部分のみ毛が白いです。 \n\n✤キャラ② 耳飾りについて \n立ち絵では右についていますが、衣装三面図の通り全ての衣装で『耳飾りは左』でイラスト制作をお願い致します。 \n\n\n〖2人の衣装について〗\n2種類ありますのでお好みなものをお選びいただけますと幸いです。\n『デザイン画』と記載のものを選ばれる場合は、ラフなイラストになっているので不明な点はご自由に補完ください。\n\n\n〖耳・尻尾について〗\n耳は馬耳のみで、人耳はありません⚠️\n服に隠れていますが髪色と同じ、馬のしっぽが生えています。\n\nキャラクターシートもドライブに同梱しておりますので、こちらもご参考下さい。\n\n\n構図や雰囲気はお任せ致します。\n\nよろしくお願い致します💫\n\nhttps://drive.google.com/drive/mobile/folders/102eUHjQl_w9j_S3yteK9FptjS4TBYsp3", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jisa_5min/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/60edb56d/uploads/origins/c0192b7d-522a-476b-8d3e-bfda433236ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98b18712f4792efd18528aaa5595403c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3615830, "client_id": 3059612, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@jisa_5min/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/83d0dde8/uploads/origins/a48372fa-b985-4806-b41b-b85be4157c04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e64cd0215fd2eca3eca65cdbef823086", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3615830, "client_id": 2825442, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder