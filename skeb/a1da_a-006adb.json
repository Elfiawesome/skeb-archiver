78-4c13-99ac-0a2d43fec928?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20bcc8f41241e29c9828814245272e0e", "srcset": "https://si.imgix.net/c2999403/uploads/origins/b9f8371f-1878-4c13-99ac-0a2d43fec928?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20bcc8f41241e29c9828814245272e0e, https://si.imgix.net/c2999403/uploads/origins/b9f8371f-1878-4c13-99ac-0a2d43fec928?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=556a6254dbf7084e3f5047a3e4018cb0 2x, https://si.imgix.net/c2999403/uploads/origins/b9f8371f-1878-4c13-99ac-0a2d43fec928?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c1949d06b98671c1db324e6ec6c1bb3f 3x"}, "body": "間さん　お世話になっております！\n今回は新たに別のコンビ(友人とのＯＣ)をお願いしたいです...！\n\nよろしければ1~2件目のリクエストのような詰め込み風(衣装や内容おまかせ/２人＋文鳥がいると嬉しいです)\n一部のイラストに絆創膏/ガーゼ/包帯要素、風邪や熱or状態異常など、間さんがたまに描かれるデバフのかかった表情が見てみたいです><\n\n公安×刑事バディ　シナリオ内で様々な事件を解決する\n\n緑髪：179cm 29歳 　\n緑髪に茶色の目　向かって右側の目に一束髪の毛が垂れています。\n人懐こいようにみえてあまり人間に興味関心なし。仕事人間。人間関係の構築のために明るく振舞う。\n公安・外事課所属なので海外や国内で捜査・情報収集、諜報活動をしている。\n唯一の趣味:ドライブ/激辛料理が好き。時間がないのを理由に自分のことに対して雑な面がある。\n髪を切りにいく時間もない。無頓着故に、自分の好きな物などをよくわかっていない。\n\nベージュ髪：168cm 26歳　ベージュ髪に少し紫～青みがかった瞳　\n不愛想で真面目。目つきが悪くあまり表情の変化がない。聞き逃しのないようこまめにメモを取る。\n鰐梨のことは頼りがいがあり、仕事のしやすい相手だと思っている。\n先輩にも物怖じしないが、故に関係性構築に難ありで、物申す時は特に冷たく、キツく聞こえてしまう部分がある。\n「ねろちゅん」という白文鳥を飼っている。激甘、溺愛。\n\n\nご縁がありましたらよろしくお願いいたします！\n\nhttps://husky-crown-68c.notion.site/305cc4018b5580df8878e995ddf480d4", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@a1da_a/works/66", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2469073, "client_id": 2929739, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8f2d696/uploads/origins/1fa39580-b3db-4477-8d6e-1162cc387c08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bce1adad3a48fb4787b22e23c559da