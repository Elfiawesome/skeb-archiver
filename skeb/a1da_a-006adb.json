い雰囲気と色彩が本当に好きです…！♡♡♡\n\nよろしければ、うちの子のイラストをお願いしたいのです\n衣装は自由にアレンジしていただいて構いません　すべてお任せいたします╰(*´︶`*)╯\t\n\ntt（てんてん、てぃてぃ）\n・身長165cm\n・14さい\n・中性的な男の子です \n\nSNS等のアイコンやヘッダーに個人的な使用のみ\n\n金額が足りない場合は、リクエストを再送信していただければ幸いです\n\nよろしくお願いします\nキク\n\nhttps://drive.google.com/drive/folders/10wU5Hey9s-4W4BYGb9XKn3CL2x_rw3ih?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@a1da_a/works/72", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2469073, "client_id": 1509404, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9ced8a1/uploads/origins/7b1402e8-0081-4c4a-82c9-528e8c6d5c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25d10b6d44857c6d72f2702d75b80fa8", "srcset": "https://si.imgix.net/b9ced8a1/uploads/origins/7b1402e8-0081-4c4a-82c9-528e8c6d5c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25d10b6d44857c6d72f2702d75b80fa8, https://si.imgix.net/b9ced8a1/uploads/origins/7b1402e8-0081-4c4a-82c9-528e8c6d5c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a97c78c6b7a74c8e739ef2e100052c8 2x, https://si.imgix.net/b9ced8a1/uploads/origins/7b1402e8-0081-4c4a-82c9-528e8c6d5c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c28c3e166a13dc911a9e9354c1ebded 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9ced8a1/uploads/origins/7b1402e8-0081-4c4a-82c9-528e8c6d5c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a06ec42ba7579158a413b4a23bc8494", "srcset": "https://si.imgix.net/b9ced8a1/uploads/origins/7b1402e8-0081-4c4a-82c9-528e8c6d5c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a06ec42ba7579158a413b4a23bc8494, https://si.imgix.net/b9ced8a1/uploads/origins/7b1402e8-0081-4c4a-82c9-528e8c6d5c7b?