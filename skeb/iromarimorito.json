きな耳と尾を持っています。額には緑色のリボンがあり、これが非常に重要です。  \n性格：静かで、小さな子供のように好奇心旺盛。  \n彼女は神の血統を持っていると疑われています。\n\n服装は自由に選んでいただいても調整していただいても構いません。\n\n▼ 使用用途：個人使用範囲  \n▼ 参考資料はすべてURLにあります。雰囲気や構図等はお任せいたします！\n\n金額不足の場合は再送要請も構いません。  \n本当にありがとうございます！どうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1MvPCFR5fXx38Aunj34VGPOSd4heytWFF?usp=sharing", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 43292, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "上中さとる｜KAMINAKA Satoru", "screen_name": "midorinomomo88", "avatar_url": "https://pbs.twimg.com/profile_images/1487685378891198467/6fEqx727.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1723010720/1665716847/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 128}, {"id": 492924, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "エイゴニ", "screen_name": "eisuri", "avatar_url": "https://pbs.twimg.com/profile_images/1262578213672202246/VMjpGqpK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/801718896881324032/1591199555/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 176}, {"id": 2841563, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "檜宮しょう2", "screen_name": "Hinomiya_sousak", "avatar_url": "https://pbs.twimg.com/profile_images/1971708769181880321/TdGHxsdZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1665528722940919809/1725963074/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": n