-a60c-650b27a196a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85f1c78ca55925b757a4dfac988f158e", "srcset": "https://si.imgix.net/4ccd83ad/uploads/origins/44db15a7-6157-48be-a60c-650b27a196a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85f1c78ca55925b757a4dfac988f158e, https://si.imgix.net/4ccd83ad/uploads/origins/44db15a7-6157-48be-a60c-650b27a196a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f4ff9405491776541ec40117613a8bf9 2x, https://si.imgix.net/4ccd83ad/uploads/origins/44db15a7-6157-48be-a60c-650b27a196a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=990167950715e8002f4599f7287b6bf7 3x"}, "body": "もし良かったら下記をお願いします。\n\n■キャラ\nユフィール(メギド72)\n・胸も尻もどでかくて、乳輪も相応に大きい。\n・陰毛描かれる場合は髪と同じ金色で自然に生えた感じ。または無毛。\n・服は通常衣装を着崩して露出が良いですが、作画コスト高そうなので帽子のみで全裸でも可です。\n\n■内容\n過去の医者駆け出しのころのユフィールのイメージ。\nユフィールと中年ヴィータ1人(帽子被って目元見えない髭とか小太り商人とか)との絡み。\n男が無知なユフィールを何かしの理由で言い包めて、憧れの先生の体を貪るような内容。\n経緯とか会話はおまかせですが、希望の要素は下記で可能な範囲で含めて貰えると嬉しいです。\n(ただ結構適当なのでガッツリ調整いただいて全然大丈夫です)\n\n・以前書かれていたシャックスとマルファスのイラストのような形式が好きなので、\n　会話ありのカラー絵で中出し事後までの流れをお願いします。\n　大きい絵の1シーンでも、小さい絵の数シーンでもおまかせします。\n・ユフィールの顔や胸や局部が見える体位での挿入絵は含めていただきたいです。\n・もし断面図表現を描かれる場合は体には重ねずに背景部に描く形。(無しでも可)\n・もしフェラを描かれる場合はイラマチオ気味で美人な顔つきが崩れない程度に、\n　頬を窄めるような形だと嬉しいです。\n・理由付けのための設定の一例。\n　　・恋愛や性に疎く未経験。医療のため学ばなきゃとは思っている。\n　　・治療に使う薬品代のやりくりに苦労している。\n・中年ヴィータは下心あるスケベ親父。憧れの美人先生を抱こうとあの手この手で頑張る。\n　処女と知って興奮するとか、中出ししたがるとかスケベっぷり出て欲しいです。\n　体型も小太りで陰毛とか中年オヤジ感ある見た目。\n・経緯は恋愛以外の理由で、いずれもユフィールは納得の上なので無理やりではない形。\n　後になって思い返したら男にいいように言われて体を貪られただけなので、\n　私の初体験はとても人には話せませんね・・(苦笑)とか言いそうな内容でお願いします！\n・ハード寄りのプレイでも問題ないです。\n\nその他、色々自由におまかせします。\n以上、よろしくお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@monomaeru/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 144726, "client_id": 1612861, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81ce58fa/uploads/origins/a3ac040a-87fc-42f7-99ac-ddff91ae7b5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45990a33d836b7d090039112a232051d", "srcset": "https://si.imgix.net/81ce58fa/uploads/origins/a3ac040a-87fc-42f7-99ac-ddff91ae7b5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45990a33d836b7d090039112a232051d, https://si.imgix.net/81ce58fa/uploads/origins/a3ac040a-87fc-42f7-99ac-ddff91ae7b5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ec445510434ebee5778db82dab42a61 2x, https://si.imgix.net/81ce58fa/uploads/origins/a3ac040a-87fc-42f7-99ac-ddff91ae7b5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=183797618f0ff753c6f221588d79c9ef 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81ce58fa/uploads/origins/a3ac040a-87fc-42f7-99ac-ddff91ae7b5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ffeedb63aa4a16f89393061f7d12542", "srcset": "https://si.imgix.net/81ce58fa/uploads/origins/a3ac040a-87fc-42f7-99ac-ddff91ae7b5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ffeedb63aa4a16f89393061f7d12542, https://si.imgix.net/81ce58fa/uploads/origins/a3ac040a-87fc-42f7-99ac-ddff91ae7b5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b579f2af2928ea76164a2e0c99f3aa5d 2x, https://si.imgix.net/81ce58fa/uploads/origins/a3ac040a-87fc-42f7-99ac-ddff91ae7b5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4d46862012f8a9d271957c9ac342faac 3x"}, "body": "お久しぶりです。昨年はえふにぃさんの水中に横たわりびしょ濡れとなった姿をお見せ頂き誠に有り難うございました。\n現在でも変わる事無く濡れた描写の素晴らしい作品を手掛けられているのを拝見し、また新たに作品をお願いしたいと思いこうして依頼させて頂きました。\n今回は、前回お願いしたえふにぃさんと加えて同じく虹裏メイドのげきついされたことがないさんの二人が突然の豪雨に見舞われ、びしょ濡れとなったお互いの姿に思わず興奮してしまい人目に付かない場所で雨に打たれながらも抱き合って口付けを交わし始める、といった内容をお願いしたいと思います。\n降りしきる雨の中、両者共ずぶ濡れになっているのも気に留めない様子でお互いの股間に太股を押し当てる様な格好で身体を密着させ、お互いを求めるかの様に腕を背後に回しまさぐり合いながら激しく口付けを交わしており、えふにぃさんに至っては口内を責められる快楽のあまり甘イキに達してしまっている、といったイメージを頂ければと思います。\n構図等はお任せしたいと考えておりますが、両者共に足元までしっかり見せて頂けると非常に嬉しいので、見切れる部分の無いよう描画頂ければ大変有り難いです。\n尚、両者共に衣服は身に着けたままでお願いしたいですが、構図によって胸元を描画頂く際は興奮の為勃起した乳首が衣服越しにうっすらと浮いてしまっている描写を頂ければ有り難いです。又、メカパーツ（バックパックと太腿部分の翼）に関しましては除外した状態でお願いします。\n参考にいくつか画像を用意していますので以下のリンクをご確認ください。\nhttps://x.com/wasokenki/status/1462807566946222085\nhttps://x.com/wasokenki/status/1592285385983684609\nhttps://x.com/wasokenki/status/1646170058027147267\n厳密に守って頂きたいという訳ではありませんが身長差についても一応参考までに目を通して頂くと有難いです。\nhttps://x.com/wasokenki/status/1715923006122500478\n久方ぶりながら細々とした内容をお送りしてしまい大変恐縮ではありますが差し支えなければご検討頂けますと幸いです。\n宜しくお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@monomaeru/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 144726, "client_id": 1612861, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/353c2ff3/uploads/origins/f3c70d65-3842-4d3e-a4ba-fabf1be096a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4318b55f32f56032fd3ee8871c237366", "srcset": "https://si.imgix.net/353c2ff3/uploads/origins/f3c70d65-3842-4d3e-a4ba-fabf1be096a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4318b55f32f56032fd3ee8871c237366, https://si.imgix.net/353c2ff3/uploads/origins/f3c70d65-3842-4d3e-a4ba-fabf1be096a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1c1891a493cd4980715003403c978ec 2x, https://si.imgix.net/353c2ff3/uploads/origins/f3c70d65-3842-4d3e-a4ba-fabf1be096a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56ac55a6961438043d904942353f9ab4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/353c2ff3/uploads/origins/f3c70d65-3842-4d3e-a4ba-fabf1be096a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0ce6498d1488e490d8f17e44bcf53f3", "srcset": "https://si.imgix.net/353c2ff3/uploads/origins/f3c70d65-3842-4d3e-a4ba-fabf1be096a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0ce6498d1488e490d8f17e44bcf53f3, https://si.imgix.net/353c2ff3/uploads/origins/f3c70d65-3842-4d3e-a4ba-fabf1be096a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ba14acd207c3c112cca5539819c25c0 2x, https://si.imgix.net/353c2ff3/uploads/origins/f3c70d65-3842-4d3e-a4ba-fabf1be096a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e792f660129002e71d8204c3bcac01e7 3x"}, "body": "失礼します、昨年は有難うございました。以前より手掛けられている作品を拝見させて頂いておりますが、度々描かれるびしょ濡れの姿がとても良く前回に引き続き虹裏メイドのえふにぃさんでこういった描写をお願い出来ればと思いこうして依頼させて頂きます。\nhttps://x.com/monomaeru/status/1804531652175315359\nお願いしたい内容についてですが、こちらのリンクにて拝見しました作品の水に浸かっている描写が大変良かったです。\n今回、えふにぃさんを上記の作品と基本的に同様のシチュエーションでお願いさせて頂いても宜しいでしょうか。\n今回用意させて頂いている下記資料の衣装は身に着けたままの状態で、転んで水中にひっくり返ってしまったのか全身ずぶ濡れで水の中に座り込み「何見てんのさ～…」とでも言いたげな不満そうな表情をこちらに向けている、といったイメージを頂ければと思います。\n又、可能であれば全身を見切れる部分の無いよう描画頂ければ大変有り難く思います。メカパーツ（バックパックと太腿部分の翼）に関しましてはもしお手数でしたら除外して頂いても結構です。\n以下のリンクに参考の画像を何枚か用意しておりますのでこちらをご確認願います。\nhttps://x.com/wasokenki/status/1462807566946222085\nhttps://x.com/wasokenki/status/1592285385983684609\n差し支えなければご検討頂けますと幸いです。\n宜しくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@monomaeru/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 144726, "client_id": 471969, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67e4eefa/uploads/origins/57beadd2-f684-4428-9862-68f68554f855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d10e7740050cb0e4071eab9c38417ae7", "srcset": "https://si.imgix.net/67e4eefa/uploads