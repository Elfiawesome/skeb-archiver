◇女性・26歳・165cm\nモチーフ：氷・雪・冬　イメージカラー：勿忘草\n冷静で物静か、冬を思わせる女性。\n淡々としているように見えて彼の前では感情を表に出すことが多いです。\nしっかりしている反面、ときおり無垢な少女のような表情をしています。\n\n◆用途　※私ともう一人の方に限ります\n・SNS（X）での紹介\n・TRPGセッションの際、駒として配置\n・イラスト依頼時の参考資料\n・個人で楽しむ用のグッズ作成\n・SNSでのアイコン／ヘッダー使用\n\n◆希望形式\n背景がある場合は、背景有／無（透過）で分けていただけると大変ありがたいです。\n\n◆参考資料\n・資料URLをご確認お願いいたします。\n\n金額が合わなければ再送依頼いただければと思います。\nご確認いただきますよう、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1TozeeqPsQ6PmW89IrTaKJ_uUmYgfTp96", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nery_zzz/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3637138, "client_id": 3487840, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dda3380f/uploads/origins/0836a674-7b55-4345-b5b2-5a0ca7a6750d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfcec6d065826c7d4212abb81fc2ff66", "srcset": "https://si.imgix.net/dda3380f/uploads/origins/0836a674-7b55-4345-b5b2-5a0ca7a6750d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfcec6d065826c7d4212abb81fc2ff66, https://si.imgix.net/dda3380f/uploads/origins/0836a674-7b55-4345-b5b2-5a0ca7a6750d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=432c043d75477597558f6f8b73e328a5 2x, https://si.imgix.net/dda3380f/uploads/origins/0836a674-7b55-4345-b5b2-5a0ca7a6750d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5d9cee23ed0dd27055c5736a4d4a023 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dda3380f/uploads/origins/0836a674-7b55-4345-b5b2-5a0ca7a6750d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d2504d056e48544a37082af52219125", "srcset": "https://si.imgix.net/dda3380f/uploads/origins/0836a674-7b55-4345-b5b2-5a0ca7a6750d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=