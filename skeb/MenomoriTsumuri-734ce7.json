5cmです。彼は終末後の世界で旅をする医師、あるいは医療従事者です。自由に戦えるよう、タクティカルウェアを着用しています。（『アーケナイツ』のエンフィールドを参考にしていただけると嬉しいです。）\n\nこのキャラクターはとても神経質な性格で、いつも怯えた表情をしています。武器としてメスを使います。\n\n服装のテーマカラーは白、黒、水色です。白をメインカラーにしてください！\n\nそれ以外は、デザインに関して自由に創作してください。\n\nリクエストを受け入れていただけると嬉しいです。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1dP5Wkf9C0R6Js5DM1HG54TJelSeottv8", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MenomoriTsumuri/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cdcb3b99/uploads/origins/e2f1ff09-4223-4d26-8bbb-75d028c37e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2a898b6f0ef3e8308b636d428e0e3b5", "srcset": "https://si.imgix.net/cdcb3b99/uploads/origins/e2f1ff09-4223-4d26-8bbb-75d028c37e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2a898b6f0ef3e8308b636d428e0e3b5, https://si.imgix.net/cdcb3b99/uploads/origins/e2f1ff09-4223-4d26-8bbb-75d028c37e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e2ad6381c3c6e5cc401e0eec7531afc 2x, https://si.imgix.net/cdcb3b99/uploads/origins/e2f1ff09-4223-4d26-8bbb-75d028c37e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5fedf8b034bcfe20406922c343401e9 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3937537, "client_id": 2089302, "nc": 128}, {"path": "/@MenomoriTsumuri/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3937537, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/472