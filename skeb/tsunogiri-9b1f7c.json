e_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2700015, "client_id": 62506, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29d0c6d9/uploads/origins/84ba0850-dd44-4f0d-9545-e2988652a5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25a37c60508172a0de3d585f70569a9e", "srcset": "https://si.imgix.net/29d0c6d9/uploads/origins/84ba0850-dd44-4f0d-9545-e2988652a5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25a37c60508172a0de3d585f70569a9e, https://si.imgix.net/29d0c6d9/uploads/origins/84ba0850-dd44-4f0d-9545-e2988652a5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad5bdf486714d492e2c20fb4373936f2 2x, https://si.imgix.net/29d0c6d9/uploads/origins/84ba0850-dd44-4f0d-9545-e2988652a5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=841e3887d282eb78803641ba875f3c9b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29d0c6d9/uploads/origins/84ba0850-dd44-4f0d-9545-e2988652a5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73c43a6f5755bc0c3bc0a60891bb2eb9", "srcset": "https://si.imgix.net/29d0c6d9/uploads/origins/84ba0850-dd44-4f0d-9545-e2988652a5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73c43a6f5755bc0c3bc0a60891bb2eb9, https://si.imgix.net/29d0c6d9/uploads/origins/84ba0850-dd44-4f0d-9545-e2988652a5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=189a506bca50093260bbe4a7553c32de 2x, https://si.imgix.net/29d0c6d9/uploads/origins/84ba0850-dd44-4f0d-9545-e2988652a5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4448efbbdbdc2072a3e77298f11c4e6d 3x"}, "body": "こんにちわ！\n内容を変えて改めて依頼させていただきます。\n\nコラボイベントへの期待をこめて、私の好きな\n・閃乱カグラの「四季」\n・アズールレーンの「マーブルヘッド」\nの二人を描いていただきたいと思います。\n\n・コラボネタということで衣装交換を是非挑戦してみていただきたく願います。\n・四季にマーブルヘッドの通常衣装を、マーブルヘッドに四季の忍転身装束を。\n・髪型、ヘアアクセサリー類は本人のままで。\n・マーブルヘッドの艤装、四季の大鎌など武器装備類は不要です。\n・帽子の有無もお任せします。無い方が釣りあい取れるでしょうか？\n・マーブルヘッド服の身分証やジャケット、四季忍転身服のネックレスやマントもまた適宜省略してください。お任せします。\n☆両者とも同レベルの爆乳でお願いします。\n\n・構図としましては胸から上くらいの図、二人並んでる姿になるでしょうか。\n・胸を寄せあってピース！みたいなイメージです\n・ギャルキャラらしい快活な笑顔でお願いします。\n・セリフなどは不要です。ハートマークなどのエフェクトはあればいいかもしれません。\n・特別な背景は不要です。もし何か描かれる場合は「青空」「砂浜」「海」などか、あるいはそれらをイメージさせる色を置くなどを提案します。\n\n・好きなキャラが可愛く並ぶ姿が見たいというのが最もで、それ以外は万事良きよう、描きやすいようにしてください。\n\n以上となります。少しボリュームがある内容かもしれませんが、やってみようと思っていただけたら幸いです。\nもしよければご一考ください。よろしくお願いします。\n\nhttps://azurlane.wikiru.jp/index.php?%E3%83%9E%E3%83%BC%E3%83%96%E3%83%AB%E3%83%98%E3%83%83%E3%83%89", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 15424, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ひめぎよ", "screen_name": "hime_gyo", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fmisskey%2Fe2c99249-bdc1-49a3-bfb6-8adf992b4709.png&avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 205193, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あまね/7月～お仕事募集中", "screen_name": "amane0sleep", "avatar_url": "https://pbs.twimg.com/profile_images/2064346893225013248/GWRrMj8V.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1193527436878573570/1781015187/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "bann