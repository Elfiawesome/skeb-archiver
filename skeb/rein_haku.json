f1f7b4da03ff4b72daf9", "srcset": "https://si.imgix.net/21cf49fe/uploads/origins/6cc4ecfd-e59e-4ec1-91fb-ac5b52d2f5c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b49fa2c2158ef1f7b4da03ff4b72daf9, https://si.imgix.net/21cf49fe/uploads/origins/6cc4ecfd-e59e-4ec1-91fb-ac5b52d2f5c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ae2ed5e332330691c689eae8b28d385e 2x, https://si.imgix.net/21cf49fe/uploads/origins/6cc4ecfd-e59e-4ec1-91fb-ac5b52d2f5c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=36e5c2adf8ce74008528e4f13e4e0ecd 3x"}, "body": "hakuさん、はじめまして昨です。\nTwitterを見てダークな雰囲気のイラストが素敵だと思いリクエストを送りました。\n使用用途は、個人使用でパソコンの背景、部屋に飾る等します。\nイラストの希望は表情が笑っているのがいいです。\n構図やポーズはお任せしたいです。hakuさんが描きたいと思えるような姿で描いていただきたいです。\n以下に資料のURLを貼っています。\nご確認よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1A6tLBP9a-MjedGP1RPaIBfUTG9d3QDrN", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rein_haku/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1368788, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/725a7c0f/uploads/origins/3496bfac-3383-412b-9014-261350169f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc2ee14afd65d419698d3e2f57daf1d0", "srcset": "https://si.imgix.net/725a7c0f/uploads/origins/3496bfac-3383-412b-9014-261350169f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc2ee14afd65d419698d3e2f57daf1d0, https://si.imgix.net/725a7c0f/uploads/origins/3496bfac-3383-412b-9014-261350169f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a108709019bbc8fd9bab4dd79914b47 2x, https://si.imgix.net/725a7c0f/uploads/origins/3496bfac-3383-412b-9014-261350169f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2ac4a499ae164e7b3c2cafe8d9735ce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/725a7c0f/uploads/origins/3496bfac-3383-412b-9014-261350169f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b0ec9cbcc14df69cc810dd6fe7ba389", "srcset": "https://si.imgix.net/725a7c0f/uploads/origins/3496bfac-3383-412b-9014-261350169f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b0ec9cbcc14df69cc810dd6fe7ba389, https://si.imgix.net/725a7c0f/uploads/origins/3496bfac-3383-412b-9014-261350169f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32c8259653302c45662b8e0fd9f44b5b 2x, https://si.imgix.net/725a7c0f/uploads/origins/3496bfac-3383-412b-9014-261350169f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd65295e7000eca7f6d679ac4b842487 3x"}, "body": "初めまして！不気味でかっこいい雰囲気なイラストがとても魅力的で惹かれ、依頼させていただきたいと思いました。\n縹樹さんという方のレインというキャラクターを描いていただきたいです。縹樹さんご本人から許可はいただいております。(URL先の説明文に許可を出しているという記載あり)\n資料や性格などは下記のURLを参考にしていただきたいです。\n表情は悪い顔・何かを企む顔など何か闇を感じるような表情にしてくださると幸いです！その他の構成は全てお任せしたいです。\n\n背景と人物のレイヤー分けしたデータをいただきたいです。\nご多忙または依頼内容や依頼内容が自身の方針に合わないなど何か問題があればお手数ですがキャンセルをお願いします。\n\nXfolio:https://xfolio.jp/portfolio/hanadagi_noru/works/4418058?search_words=%22縹樹乃ル%22\n\npixiv:https://www.pixiv.net/artworks/132378629\n\n上記二つは同じ資料です。お好きなプラットフォームから閲覧してください", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rein_haku/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1368788, "client_id": 3051377, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26c0d1dd/uploads/origins/20398ca1-33cc-4ec0-b3be-38dbdec90522?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92e6998479b7ba026a2b3dc752070255", "srcset": "https://si.imgix.net/26c0d1dd/uploads/origins/20398ca1-33cc-4ec0-b3be-38dbdec90522?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92e6998479b7ba026a2b3dc752070255, https://si.imgix.net/26c0d1dd/uploads/origins/20398ca1-33cc-4ec0-b3be-38dbdec90522?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3fe1c4da16febbfed169fb96ab9aa7b 2x, https://si.imgix.net/26c0d1dd/uploads/origins/20398ca1-33cc-4ec0-b3be-38dbdec90522?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da9c784acc89001ef4ce68872a4efcc8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26c0d1dd/uploads/origins/20398ca1-33cc-4ec0-b3be-38dbdec90522?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5737763939f3a708520922eb8dfda1a", "srcset": "https://si.imgix.net/26c0d1dd/uploads/origins/20398ca1-33cc-4ec0-b3be-38dbdec90522?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5737763939f3a708520922eb8dfda1a, https://si.imgix.net/26c0d1dd/uploads/origins/20398ca1-33cc-4ec0-b3be-38dbdec90522?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7c23e27b4511732246088122c081cbef 2x, https://si.imgix.net/26c0d1dd/uploads/origins/20398ca1-33cc-4ec0-b3be-38dbdec90522?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6bf7ce4139b554f4108d39e585c3f00 3x"}, "body": "haku様\n\nはじめまして。\nYouTubeで配信活動をしている【にどめ】と申します。\n\nskebでお見掛けし、ぜひ私のオリキャラをhaku様の絵柄で描いていただきたいと思いリクエストさせていただきました！\n\n以下リクエスト内容です↓\n\n①用途\nYouTubeでのサムネやSNSでの投稿、メンバーシップ加入者への配布など\n\n②イラストの希望\n基本的にはおまかせで、haku様が描きたいと思えるような姿で描いて頂きたいです。\nキャラクター造形としましては、黒髪ベースに水色のインナーカラーとメッシュ、中性的でありつつあくまで男性、タバコやピアスで少し治安が悪い雰囲気、メガネ着用、といった感じです。\n参考までに現在の姿と、以前描いて頂いたイラストを資料として添付いたします。\n\n\n以上です。\nご縁がありましたらぜひよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/a0o3htu36dzxje7azc2i8/ANTpurvSOaQplO5ZIiDiqds?rlkey=a6vhvl76jyeratcv2zoq4e33t&st=om8rqvb5&dl=0", "nc