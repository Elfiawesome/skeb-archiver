ございません。\n　　・背景透過版、サインオン/オフ版をPSDデータでいただけますと嬉しいです。\n　　・幅3840px × 高さ2160px 相当の大きさに拡大して使用する可能性があります。\n　　・サムネイルや動画で使用するにあたり、頭頂部や体の左右が見切れていないと助かります。\n　　　また、若干の色調調整についてご了承いただけますと幸いです。\n　　・表情差分があると嬉しいです。追加でお支払いも可能です。なくても問題ございません。\n\nお忙しいところ恐れ入りますがよろしくお願いいたします。\n\nhttps://x.com/A0B0SH1/status/1743437226057646191?s=20", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rein_haku/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1368788, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/36fc64d4/uploads/origins/363275cb-c626-4897-b8ea-c09d532953f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94dd67dcb0223b5f6f39ebe1cbd345e3", "srcset": "https://si.imgix.net/36fc64d4/uploads/origins/363275cb-c626-4897-b8ea-c09d532953f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94dd67dcb0223b5f6f39ebe1cbd345e3, https://si.imgix.net/36fc64d4/uploads/origins/363275cb-c626-4897-b8ea-c09d532953f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e13353be3e927600dabe7a5bff6cdd68 2x, https://si.imgix.net/36fc64d4/uploads/origins/363275cb-c626-4897-b8ea-c09d532953f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26068e62933aafcdc43884209dacd1cd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36fc64d4/uploads/origins/363275cb-c626-4897-b8ea-c09d532953f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0be2dc302cd138cd01de4eabf8d85dc", "srcset": "https://si.imgix.net/36fc64d4/uploads/origins/363275cb-c626-4897-b8ea-c09d532953f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0be2dc302cd138cd01de4eabf8d85dc, https://si.imgix.net/36fc64d4/uploads/origins/363275cb-c626-4897-b8ea-c09d532953f1?bg=%23fff&auto=format%2Ccom