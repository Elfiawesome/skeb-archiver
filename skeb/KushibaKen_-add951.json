ea\u30af\u30a8\u30b9\u30c8\u5931\u793c\u3044\u305f\u3057\u307e\u3059\uff01\n\n\u3010\u4f7f\u7528\u7528\u9014\u3011\n\u30fb\u53ce\u76ca\u5316\u6e08\u307fYoutube/\u30b5\u30d6\u30c1\u30e3\u30f3\u30cd\u30eb\u3067\u306e\u4f7f\u7528\n\u30fb\u5404\u7a2eSNS\u3067\u306e\u4f7f\u7528\n\u30fb\u30d5\u30a1\u30f3\u30af\u30e9\u30d6\u306e\u8fd4\u793c\u54c1\uff08\u9650\u5b9a\u30b3\u30f3\u30c6\u30f3\u30c4\uff09\u3067\u306e\u4f7f\u7528\n\u30fb\u30b0\u30c3\u30ba\u8ca9\u58f2(\u5546\u7528\u5229\u7528)\n\u4e0a\u8a18\u306e\u7528\u9014\u3067\u4e0d\u53ef\u306e\u3082\u306e\u304c\u3042\u308c\u3070\u304a\u65ad\u308a\u3044\u305f\u3060\u3044\u3066\u3082\u554f\u984c\u3042\u308a\u307e\u305b\u3093\u3002\n\n\u3010\u30a4\u30e9\u30b9\u30c8\u306e\u8a73\u7d30\u3011\n\u4eca\u56de\u306f\u3010\u9b54\u6cd5\u5c11\u5973\u8863\u88c5\u3011\u306e\u3046\u3061\u306e\u5b50\u3092\u63cf\u3044\u3066\u9802\u304d\u305f\u3044\u3067\u3059\uff01\n\u59b9\u3061\u3083\u3093\u305f\u3061\u306b\u3064\u3044\u3066\u306f\u8272\u5473\u306a\u3069\u59b9\u3061\u3083\u30931\u30682\u53c2\u7167\u304f\u3060\u3055\u3044(\u88c5\u98fe\u306a\u3069\u306f\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u5909\u66f4\u3057\u3066\u3044\u305f\u3060\u3051\u308c\u3070\u3068\u601d\u3044\u307e\u3059)\n\n\u57fa\u672c\u7684\u306b\u306f\u30b7\u30e7\u30fc\u30c8\u52d5\u753b\u3067\u4f7f\u3046\u3053\u3068\u3092\u60f3\u5b9a\u3057\u3066\u3044\u307e\u3059\u3002\n\u305d\u306e\u305f\u3081\u3067\u304d\u308b\u9650\u308a\u3044\u308d\u3093\u306a\u8868\u60c5\u3084\u30dd\u30fc\u30ba\u306a\u3069\n\u72d7\u67f4\u69d8\u3082\u3001\u79c1\u304c\u61a7\u308c\u3066\u3044\u308bCC\u3055\u304f\u3089\u304a\u597d\u304d\u3068\u306e\u3053\u3068\u3067\n\u305c\u3072\u4eca\u56de\u306f\u72d7\u67f4\u69d8\u306b\u304a\u307e\u304b\u305b\u3067\u301012\u500b\u3011\u63cf\u3044\u3066\u9802\u304d\u305f\u304f\u601d\u3044\u307e\u3059\uff01\n\u203b\u59b9\u3061\u3083\u3093\u305f\u3061\u304c\u3044\u308b\u3082\u306e/\u5c0f\u7269(\u30b9\u30c6\u30c3\u30ad\u3084\u30a2\u30a4\u30b9)\u3092\u6301\u3063\u3066\u308b\u3082\u306e\u304c\u3042\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\uff01\n\n\u30fb\u30b5\u30e0\u30cd\u30a4\u30eb\u3084\u304a\u306fV\u7b49\u3067\u4f7f\u7528\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308b\u305f\u3081\u3001\u72ac\u8033\u3084\u982d\u3001\u9854\u5468\u308a\u304c\u898b\u5207\u308c\u306a\u3044\u3088\u3046\u306b\u3057\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\n\u30fb1920\u00d71080\u306e\u30ad\u30e3\u30f3\u30d0\u30b9\u3067\u8868\u793a\u3057\u3066\u3082\u8352\u304f\u306a\u3044\u30b5\u30a4\u30ba\u3067\u4f5c\u6210\u3057\u3066\u9802\u3051\u308b\u3068\u5e78\u3044\u3067\u3059\u3002\n\u30fb\u30b9\u30c6\u30c3\u30ad\u3092\u6301\u3063\u3066\u3044\u308b\u3068\u304d\u306f\u9996\u5143\u306e\u30cd\u30c3\u30af\u30ec\u30b9\u306e\u9375\u306f\u306a\u3057\u306b\u3057\u3066\u3044\u305f\u3060\u304d\u307e\u3059\u3088\u3046\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002\n\u30fb\u72d7\u67f4\u69d8\u306e\u63cf\u304b\u308c\u308b\u59b9\u3061\u3083\u3093\u305f\u3061\u304c\u3068\u3066\u3082\u597d\u304d\u306a\u306e\u3067\u3001\u4e88\u7b97\u306e\u7bc4\u56f2\u5185\u3067\u53ef\u80fd\u3067\u3082\u3057\u3082\u3042\u308c\u3070\u59b9\u3061\u3083\u3093\u305f\u3061\u3060\u3051\u306e\u30a4\u30e9\u30b9\u30c8\u3082\u4f55\u70b9\u304b\u304a\u307e\u3051\u3068\u3057\u3066\u3044\u305f\u3060\u3051\u305f\u3089\u5e78\u3044\u3067\u3059\u3002\n\n\u3010\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u8a73\u7d30\u3011\n\u9b54\u6cd5\u5c11\u5973(CC\u3055\u304f\u3089)\u306b\u61a7\u308c\u308b\u95c7\u7167\u3089\u3059\u7652\u3084\u3057\u7cfb\u72c2\u72acVTuber\n\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e0\u3068\u53cc\u5b50\u306e\u59b9\u3061\u3083\u3093(\u30df\u30cb\u30c1\u30e5\u30a2\u30c0\u30c3\u30af\u30b9)\u304c\u5927\u597d\u304d\u306a20\u4ee3\u5973\u6027\n\u8cc7\u6599URL\u306b\u3066\u4e09\u9762\u56f3\u3092\u6dfb\u4ed8\u3055\u305b\u3066\u9802\u3044\u3066\u304a\u308a\u307e\u3059\u3002\n\u5916\u3055\u306a\u3044\u3067\u3044\u305f\u3060\u304d\u305f\u3044\u8981\u7d20\u3068\u3057\u3066\n\u72ac\u8033\u3001\u9aea\u306e\u30b0\u