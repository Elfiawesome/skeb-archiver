分として絶頂・絶頂後のシーンもお願いします。\n絵柄はなるべく公式に寄せてください。\n資料はURLをご参照ください。\nよろしくお願いします。\n\nhttps://t.co/4QcfIihAZD", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Hitonitati1/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 493211, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f43ec9a/uploads/origins/e716bf37-726d-454d-ac84-e988aa4a1cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49b58b50e197d21d413223cba54081d5", "srcset": "https://si.imgix.net/4f43ec9a/uploads/origins/e716bf37-726d-454d-ac84-e988aa4a1cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49b58b50e197d21d413223cba54081d5, https://si.imgix.net/4f43ec9a/uploads/origins/e716bf37-726d-454d-ac84-e988aa4a1cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=158d94f6824d13792aaee7d02be04e43 2x, https://si.imgix.net/4f43ec9a/uploads/origins/e716bf37-726d-454d-ac84-e988aa4a1cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e537834d5a46d138d1fea50e625518ec 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f43ec9a/uploads/origins/e716bf37-726d-454d-ac84-e988aa4a1cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=746b644f8529afd32b9624b7c6917657", "srcset": "https://si.imgix.net/4f43ec9a/uploads/origins/e716bf37-726d-454d-ac84-e988aa4a1cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=746b644f8529afd32b9624b7c6917657, https://si.imgix.net/4f43ec9a/uploads/origins/e716bf37-726d-454d-ac84-e988aa4a1cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f2d03aac1fcd6b7daae659107c5f905a 2x, https://si.imgix.net/4f43ec9a/uploads/origins/e716bf37-726d-454d-ac84-e988aa4a1cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3f0920015f675e929ff5f4cd1e8a140f 3x"}, "body": "初めまして、作品が気に入りました。\n良ければリクエストしたいです。\nもし可能であれば、「ドールズフロントライン」のM200をお願いしたいです。\n参考 : https://wikiwiki.jp/dolls-fl/M200\nスカートのみで他全裸でお願いします。\n簡単な喘ぎと擬音の有り・無しをお願いします。\n\n1~2Pで中出しで完結するモノクロ漫画をお願いしたいです。\nとても発汗して涙や唾液を沢山流す、終始大量で粘度が高い愛液が溢れたりねちゃねちゃ糸引いたりといった要素が欲しいです。\n一部、腹部に直接描く断面図がほしく、ぞりゅぞりゅ・ぬるっぬるっといった擬音があると良いです。\nどれかの体位でスカートで結合部がぎりぎり隠れるような描写が出来れば欲しいです。\nお好きな体位で構いませんが、まんぐり・対面座位など含むと嬉しいです。\n\n良ければご検討下さい。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Hitonitati1/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 493211, "client_id": 903, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee74137e/uploads/origins/a02a3b4d-720d-4f6b-a406-a1279bf38497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b6b8241b01d3e83b6e964c71fc4aa9e", "srcset": "https://si.imgix.net/ee74137e/uploads/origins/a02a3b4d-720d-4f6b-a406-a1279bf38497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b6b8241b01d3e83b6e964c71fc4aa9e, https://si.imgix.net/ee74137e/uploads/origins/a02a3b4d-720d-4f6b-a406-a1279bf38497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=396ef076bde081f3533ecfd7177b796e 2x, https://si.imgix.net/ee74137e/uploads/origins/a02a3b4d-720d-4f6b-a406-a1279bf38497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a582d9a0e4c085207ad77069c0befbf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee74137e/uploads/origins/a02a3b4d-720d-4f6b-a406-a1279bf38497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dac7b43469047b8745bb4566cbf57e36", "srcset": "https://si.imgix.net/ee74137e/uploads/origins/a02a3b4d-720d-4f6b-a406-a1279bf38497?bg=%23fff&auto