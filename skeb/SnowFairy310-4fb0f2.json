ナー）にからかわれるオネショタ的描写を少しだけ入れていただけると助かります。\n参考になるかは不明ですが、お題に関連する百科記事のURLを貼ります。\n\nhttps://dic.pixiv.net/a/%E3%82%AD%E3%83%A3%E3%83%B3%E3%83%97%E3%83%9C%E3%83%BC%E3%82%A4\n\nhttps://dic.pixiv.net/a/%E3%82%A2%E3%83%B3%E3%82%BA%28%E3%83%88%E3%83%AC%E3%83%BC%E3%83%8A%E3%83%BC%29\n\n以上となります。\nもしお気に召しましたら受けていただければ幸いです。\nよろしくお願いいたします。", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SnowFairy310/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3970997, "client_id": 2053984, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b9e3fbc/uploads/origins/024b28dc-283a-4969-be8d-37fd22bc98f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74aaa6b88799f64dab136c767943f88f", "srcset": "https://si.imgix.net/6b9e3fbc/uploads/origins/024b28dc-283a-4969-be8d-37fd22bc98f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74aaa6b88799f64dab136c767943f88f, https://si.imgix.net/6b9e3fbc/uploads/origins/024b28dc-283a-4969-be8d-37fd22bc98f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b02144659bd788927b1f832a0501ed3 2x, https://si.imgix.net/6b9e3fbc/uploads/origins/024b28dc-283a-4969-be8d-37fd22bc98f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=142d1eb402dc365951d3da3fbcdb47ad 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b9e3fbc/uploads/origins/024b28dc-283a-4969-be8d-37fd22bc98f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df04a9b94d80c03aaf06ce271fdd209a", "srcset": "https://si.imgix.net/6b9e3fbc/uploads/origins/024b28dc-283a-4969-be8d-37fd22bc98f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df04a9b94d80c03aaf06ce271fdd209a, https://si.imgix.net/6b9e3fbc/uploads/origins/024b28dc-283a-4969-be8d