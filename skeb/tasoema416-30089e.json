うさん、こんにちは。\n前回のイラスト、ありがとうございました！ナズーリンはもちろん、ペンギンたちもとても素敵でした。\n次のお願いは、もう一度ナズーリンを好きなように描いていただけますか？", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tasoema416/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 305594, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c812a3f6/uploads/origins/ac26cc58-37e8-4701-95d8-126236764be7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee84fc506e5647e06cfa5951107c81ff", "srcset": "https://si.imgix.net/c812a3f6/uploads/origins/ac26cc58-37e8-4701-95d8-126236764be7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee84fc506e5647e06cfa5951107c81ff, https://si.imgix.net/c812a3f6/uploads/origins/ac26cc58-37e8-4701-95d8-126236764be7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d6300bfea6eac9376b79659527b79af 2x, https://si.imgix.net/c812a3f6/uploads/origins/ac26cc58-37e8-4701-95d8-126236764be7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4eb0dddf2bb87ea00b1ca6e16b2f06c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c812a3f6/uploads/origins/ac26cc58-37e8-4701-95d8-126236764be7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f5c34d5b81a1fc6da9c39199f150a75", "srcset": "https://si.imgix.net/c812a3f6/uploads/origins/ac26cc58-37e8-4701-95d8-126236764be7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f5c34d5b81a1fc6da9c39199f150a75, https://si.imgix.net/c812a3f6/uploads/origins/ac26cc58-37e8-4701-95d8-126236764be7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=562a59c9ccd31851a0dc5749290d57a6 2x, https://si.imgix.net/c812a3f6/uploads/origins/ac26cc58-37e8-4701-95d8-126236764be7?bg=%23fff&