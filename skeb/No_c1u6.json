Example: https://x.com/No_C1u6/status/1956169645561393652/photo/1\n\nRequesting clothes:\nBlack latex hero suit.\nWhite gloves (same as your drawing)\nWhite boots (if applicable)\nIn the chest of the suit, place the logo in a small size (See reference URL).\n\nhttps://drive.google.com/drive/folders/13vbAuKRbnVn7tkxM4m6_FzP8Ng-oR6fn?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@No_c1u6/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3677189, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d530a3c/uploads/origins/ef39e4c6-909b-4d50-ae45-d551637f39f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fee8295dba12735f2a9c8ae92c7e9b8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d530a3c/uploads/origins/ef39e4c6-909b-4d50-ae45-d551637f39f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e15d51e894fc9099b9172d0fe32ef39", "src_set": ""}, "body": "初めまして。床ドンと拘束される天馬くんが可愛すぎて\nうちの子のイラストも依頼させていただきたいと思います！\n\n構図などはお任せします、猫耳つきフードを被って、可愛く描いていただけたら嬉しいです！\n（よければちょっと受けっぽい・いじめられ感じでお願いします...）\n\nhttps://drive.google.com/drive/folders/1WMiXYzVixGeFfI53mI5jQgJL_r0qrLNj?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@No_c1u6/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3677189, "client_id": 248850, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da8a98d1/uploads/origins/c19781fe-014b-44c6-a429-e18089f94c68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=817a6cd11f98dfb71c629bd47444786f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src":