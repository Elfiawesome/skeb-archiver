{"screen_name": "hibariya440", "first_seen": 1758342231.307084, "last_updated": 1783854993.617657, "profile": {"id": 2772608, "acceptable": true, "creator": true, "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F202c6c52-c804-46e1-8c29-5df2266fbc59.png%3Fsensitive%3Dtrue?avatar=1", "name": "雲雀屋", "nsfw_acceptable": false, "screen_name": "hibariya440", "language": "ja", "header_url": null, "body_size": 2000, "received_works_count": 5, "received_nsfw_works_count": 0, "sent_requests_average_cancel_time": null, "appeal_receivable": true, "request_master_rank": null, "first_requester_rank": null, "sent_first_works_count": 0, "sent_public_works_count": 4, "popular_creator_rank": null, "instruction": "unspecified", "asct": null, "description": "**⚠イラスト、文章問わず以下の行為を禁じます⚠\n・雲雀屋の制作物を無断転載、無断使用すること。\n・制作物の複製、第三者への転売。\n・AI学習、生成AIの使用。\n・Xへの投稿。**\n\n人間も人外も異形も愛する一次創作者\n冬とアネモネ、赤と青が好き\n本拠地@hibariya@misskey.design ", "nijie_id": null, "dlsite_id": null, "fanza_id": null, "pixiv_id": 69660109, "booth_id": null, "fantia_id": null, "fanbox_id": null, "skima_id": null, "coconala_id": null, "patreon_id": null, "busy": false, "url": null, "wishlist_id": null, "youtube_id": null, "show_social_profile": true, "accept_expiration_days": 15, "complete_expiration_days": 120, "received_requests_average_response_time": 77608, "completing_average_time": 992756, "nc": 128, "twitter_uid": null, "user_service_links": [{"provider": "misskey_io", "screen_name": "hibariya", "url": "https://misskey.io/@hibariya"}, {"provider": "bluesky", "screen_name": "hibariya440.bsky.social", "url": "https://bsky.app/profile/hibariya440.bsky.social"}], "banned": false, "banned_by": "", "complete_rate": 1.0, "og_image_url": "https://skeb-avatar.imgix.net/https%3A%2F%2Fskeb.jp%2Fapi%2Fusers%2Fhibariya440%2Fbackground%3Fd%3D11d43f?blend64=aHR0cHM6Ly9hc3NldHMuaW1naXgubmV0L350ZXh0P3R4dDY0PVVrVkRUMDFOUlU1RVJVUWdVRkpKUTBVJnR4dGNscj1mZmYmdHh0Zm9udDY0PVFYWmxibWx5TFUxbFpHbDFiUSZ0eHRhbGln