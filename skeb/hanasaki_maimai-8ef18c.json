6448155caf303ed49c41764e 2x, https://si.imgix.net/9b07b7c1/uploads/origins/873dbbcd-2bdc-4537-ba8b-d6d7bb86fed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b28673a6d8b4f15abf713729abd0915 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b07b7c1/uploads/origins/873dbbcd-2bdc-4537-ba8b-d6d7bb86fed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba1fec98d4a8e80294459971110f042d", "srcset": "https://si.imgix.net/9b07b7c1/uploads/origins/873dbbcd-2bdc-4537-ba8b-d6d7bb86fed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba1fec98d4a8e80294459971110f042d, https://si.imgix.net/9b07b7c1/uploads/origins/873dbbcd-2bdc-4537-ba8b-d6d7bb86fed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07cc1800efae7ed76ac76125368f05b7 2x, https://si.imgix.net/9b07b7c1/uploads/origins/873dbbcd-2bdc-4537-ba8b-d6d7bb86fed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=074a6564c61a3aac7ffcb258b12b4374 3x"}, "body": "こんにちは！良い一日をお過ごしですか？\n\n羽沢つぐみ（バンドリ）です。\nリスの耳としっぽがあります。\n全裸。しっぽで胸を隠そうとしている。片方の胸は見える。\n彼女は非常に恥ずかしがっている。彼女はひどく顔を赤らめ、片方の目尻に涙を浮かべる。\n\n不快に思われるようでしたら、このリクエストはお断りしてください！\n\nありがとうございました", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hanasaki_maimai/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3185339, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9571fb5a/uploads/origins/7a7654eb-9c22-4465-9799-30aa01c965cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df119fc61b2c471eaf35cc8250eb26f2", "srcset": "https://si.imgix.net/9571fb5a/uploads/origins/7a7654eb-9c22-4465-9799-30aa01c965cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df119fc61b2