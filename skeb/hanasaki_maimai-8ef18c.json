fw": true}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@hanasaki_maimai/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3185339, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa363330/uploads/origins/2caccb60-fc6a-40d6-905a-09e44ae43eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b63d29d5cb5e72692e41f07bf7c095b", "srcset": "https://si.imgix.net/aa363330/uploads/origins/2caccb60-fc6a-40d6-905a-09e44ae43eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b63d29d5cb5e72692e41f07bf7c095b, https://si.imgix.net/aa363330/uploads/origins/2caccb60-fc6a-40d6-905a-09e44ae43eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3dd171ce85ae52fdad43b693d6386fa6 2x, https://si.imgix.net/aa363330/uploads/origins/2caccb60-fc6a-40d6-905a-09e44ae43eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7966cb44170decdd9cdcb04cccee1ad9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa363330/uploads/origins/2caccb60-fc6a-40d6-905a-09e44ae43eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43b8ce763ead42a0c822fc3d3182bada", "srcset": "https://si.imgix.net/aa363330/uploads/origins/2caccb60-fc6a-40d6-905a-09e44ae43eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43b8ce763ead42a0c822fc3d3182bada, https://si.imgix.net/aa363330/uploads/origins/2caccb60-fc6a-40d6-905a-09e44ae43eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e8cd872618fa338f34953f295fc4fad 2x, https://si.imgix.net/aa363330/uploads/origins/2caccb60-fc6a-40d6-905a-09e44ae43eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c950218e22f822e82ab5472533bf326e 3x"}, "body": "こんにちは！\n夏なので、夏にちなんだものをリクエストしようと思います。\n前提：とうこ（桐ヶ谷透子）がSNSに投稿した、ましろ（倉田ましろ）との淫らな自撮り写真。\nトウコとマシロは水着姿で仲良く並んでいる。\n桐ヶ谷透子は自信に満ち溢れた表情をしている。親指と人差し指で \"O \"の形を作り、そこからもう一本の指を出し入れしている。\nましろは恥ずかしそうにしながらも、人差し指と中指を下向きの「V」字型にしっかりとビキニボトムに押し当て、布地越しに大陰唇を目に見える形で分けるような体勢をとっている。そのはずだ：\n指の間が肌に食い込むように、ビキニの生地を谷間にぴんと張る。\n明確な圧力（指が肉／布地をへこませる）を示す。\n東子がSNSの投稿と一緒に投稿したキャプション／メッセージは、「明日、ビーチやナイトプールで、たくさんのイケメンにナンパされますように」というような内容にする。細かいことはお任せします。\nできれば細かいところでは、ビキニの下の乳首が硬くなっているところや、パンティから少し毛が出ているところを描いてほしい。\nコンドームにはモルフォニカのブランド（キャラクターカラー、白い蝶）が入っています。\n\n\nその方がうまくいくと思うなら、自由に変更してください。\nよろしくお願いします。\nもしバリエーションが可能なら、ヌードもお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hanasaki_maimai/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3185339, "client_id": 365407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a4a46db/uploads/origins/3db26ab5-d8e3-451a-82b8-386248eed25a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=943cd339d0834b9fff7b5433778aec75", "srcset": "https://si.imgix.net/0a4a46db/uploads/origins/3db26ab5-d8e3-451a-82b8-386248eed25a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=943cd339d0834b9fff7b5433778aec75, https://si.imgix.net/0a4a46db/uploads/origins/3db26ab5-d8e3-451a-82b8-386248eed25a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=884ad73dd73133f72fa250e176f98312 2x, https://si.imgix.net/0a4a46db/uploads/origins/3db26ab5-d8e3-451a-82b8-386248eed25a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75de937d56b4929715ab737638fdb94d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.