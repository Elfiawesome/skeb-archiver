format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15917dda3a7725353d28c3c335797fe6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6060818/uploads/origins/2582c2a8-322b-493e-af91-364e200cf7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36f1bcbd9e853818a7defd4898c5b51e", "src_set": ""}, "body": "こんにちは、2人のキャラクターの写真をお願いしたいのですが。\n\n名前はアスターとエクレールです。\n\nエクレールはアスターに恋をしていますが、アスターはエクレールの気持ちに気づかないので、いつもエクレールを怒らせてしまいます。\n\n状況はこうだ：\nアスターは、もしエクレールがまた自分に負けたら、彼女を怖がらせるためにセックスを要求すると冗談を言うが、驚いたことにエクレールはそれを受け入れ、二人は本当にセックスしてしまう。\n\n服装、ポーズ、表情は自由に選んでください。\n\n価格変更も歓迎。\n\nご検討よろしくお願いいたします。\n\n私のキャラクターデザイン\n\nhttps://drive.google.com/drive/folders/1Qx4Un-TF-lWscH-DxOzPBO8d6aTP_JlY?usp=sharing", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ihsuzanuh/works/218", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 662043, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68fcb945/uploads/origins/6fc32bed-2f3a-4b72-aef9-8d179b122dba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4eff9c3374d94cbec21ce50000651e48", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68fcb945/uploads/origins/6fc32bed-2f3a-4b72-aef9-8d179b122dba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56b7114b9a61dc1aca933458e86d2686", "src_set": ""}, "body": "SZNH先生の最近のK子ママの絵は最高です。夏が近づいてきましたので、桜庭七海 と虹野景子がビーチでくつろいでいるところを描いてください。\n\n七海 の水着：https://www.ryuyu.net/c/category/swimwear/kyabaswimwear/508865\n（パター​​ンは描かなくても大丈夫です）\n景子の水着：https://www.ryuyu.net/c/category/swimwear/kyabaswimwear/505001\n\n二人がビーチチェアに横になっていると、若い男性たちが（描かなくても構いません）近づいてきました。ママたちは、娘ではなく自分たちに興味を持っていることをからかっています。\n\nプライベートビーチにいるかのように、水着を着ていない差分を描いてください。二人とも、セクシーなママボディ型に合うように陰毛を整えています。この差分で、ちんちん目隠しの差分も描いてください。\n\nポーズやその他の詳細はおまかせとなります。\nよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ihsuzanuh/works/217", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/af2ee9fa/uploads/origins/c2dcad36-536a-4a69-ab3f-d91e91d63986?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd4af24ab95aa89de038468252571f5f", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 662043, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ihsuzanuh/works/216", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/eb96083b/uploads/origins/a2f0a54b-9e3f-485c-bd89-6f0092d2a550?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7dfa8606cfbab23f62bfd11752a15ae9", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 662043, "client_id": 63144, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ihsuzanuh/works/215", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ecf5feaf/uploads/origins/12ba1ea1-b47e-4103-8cea-96682782412b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6502a5d4718ce6af40f929530e03e28", "src_set": ""}, "private": true, "genre": "art", "tipped": 