a45623/uploads/origins/24b98768-0a79-453e-9fad-63993ad28416?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b2d75b2f41a4042d8b8c276f3d0d1a5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2da45623/uploads/origins/24b98768-0a79-453e-9fad-63993ad28416?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5810db59f50ba1b8889a3066eeefd780", "srcset": "https://si.imgix.net/2da45623/uploads/origins/24b98768-0a79-453e-9fad-63993ad28416?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5810db59f50ba1b8889a3066eeefd780, https://si.imgix.net/2da45623/uploads/origins/24b98768-0a79-453e-9fad-63993ad28416?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=98054f34c6215ef41a6e9d9821511ff2 2x, https://si.imgix.net/2da45623/uploads/origins/24b98768-0a79-453e-9fad-63993ad28416?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=74720eeeeea40179680aedb60e86074d 3x"}, "body": "ぬ〜どるさま\n\nこの度は私のocを描いて頂きたくリクエストを送らせていただきました。  \n\n✦世界観抜粋 不思議の国(不思議の国のアリスより) 1000年前に作られたこの狂った国には、「死」という概念が存在しない。どれほど無惨に殺されようと、傷はたちまち塞がり、殺されたものは何事もなかったかのように目を覚ます。そのため、この国の住人たちにとって殺戮は娯楽となっている。  \n\n✦キャラクター詳細抜粋 \n✧ロザリオ \n自信過刺なトランプ兵。プライドが高く傲慢、かつ飽き性な性格。主であり、国の長でもあるハートの女王とハートの王以外は、誰に対しても分け隔てなく見下した態度を取り、ぞんざいに扱う。何があっても彼らに負けることや危害を加えられることを許さない。  \n\n✦使用用途\n・個人鑑賞\n・SNSへの投稿・アイコン利用（クレジットを付けます）\n・個人鑑賞用グッズの作成\n・資料としての利用\n\n資料リンクをお付けいたしますため、ぬ〜どるさまのお好きなように描いていただければと思います。 金額、資料等不足がございましたら再送して頂ければと思います。 ご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/13SOIRNdsySu4-HVNCY499_sFYnT30_Ek", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@poipoiseimen/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3782344, "client_id": 4071011, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12400558/uploads/origins/9138c9f6-9fcc-427c-b597-1ad9a619361c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3a0b85118e085baf8aac4d56d8db4df", "srcset": "https://si.imgix.net/12400558/uploads/origins/9138c9f6-9fcc-427c-b597-1ad9a619361c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3a0b85118e085baf8aac4d56d8db4df, https://si.imgix.net/12400558/uploads/origins/9138c9f6-9fcc-427c-b597-1ad9a619361c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c71ae8ba6ed7936ca020106f7668d9a 2x, https://si.imgix.net/12400558/uploads/origins/9138c9f6-9fcc-427c-b597-1ad9a619361c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=acedbb37d1a5d9e6080e3a9dadc961cb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12400558/uploads/origins/9138c9f6-9fcc-427c-b597-1ad9a619361c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52f5ebd4f2696ab3a5d6aa3274d83cf1", "srcset": "https://si.imgix.net/12400558/uploads/origins/9138c9f6-9fcc-427c-b597-1ad9a619361c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52f5ebd4f2696ab3a5d6aa3274d83cf1, https://si.imgix.net/12400558/uploads/origins/9138c9f6-9fcc-427c-b597-1ad9a619361c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e4074613ae0184908992e5318052e43a 2x, https://si.imgix.net/12400558/uploads/origins/9138c9f6-9fcc-427c-b597-1ad9a619361c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe3ddb51bf46581c27aa23e8c43c2091 3x"}, "body": "ぬ〜どる様、お世話になっております。前回ご依頼させて頂いた一次創作oc男２人組を再度ご依頼させて頂ければと思いskebを送らせて頂きます。\n\n今回はカラー全身、２人の絡み絵であれば他はお任せでお願いします。また、バカのギャルギャルしい雰囲気だとなお嬉しいです。衣装も２人らしいものをお任せさせて頂ければ幸いです。\n\n<1人目>\n・26歳\n・黒×金（毛先）のアンブレラカラー伸びっぱなしウルフ（外ハネなし、毛量多めでどちらかというとバンドマンタイプの髪型）\n・全てのパーツが大きく垂れ目の外斜視気味で、全体的に彫りが深く、二重、目と眉の間に距離があるタイプのタレ眉気味\n・ダウナーな表情でふてぶてしくはあるもののアヒル口で口角だけが上がっている\n・服にこだわりがあり、ギャルソンなどの高価な白シャツをＴシャツの上から羽織っており、指輪やネックレスなどのシルバーアクセサリーが多め\n・全体的にワンサイズ上の服を好み、下半身はダルめで足首がかくれるタイプのスラックスパンツに素足サンダル\n・顎を上げて人を見るタイプの顔\n\n<2人目>\n・２１歳\n・セルフブリーチのような抜きっぱなし金髪短髪（根元がプリンなのでかきあげた部分も黒いです）\n・額が完全に見える状態の長さを更に少し後ろにかきあげており、セットで細かく毛束を固めたようなヤンキー風の髪型\n・瞼が重いタイプの一重でつり目、童顔、つり眉気味で眉太め\n・笑っても泣いても顔がくしゃっとなる、元気\n・表情は豊かで生粋の弟気質、派手なアロハシャツのＴシャツを着用（1人目の服をよくお下がりで着ているため、安物ではないが安く見える）\n・シルバーネックレス、正面から顔を見た時右側の耳にだけよくある小さくて平たいフープピアス\n・下は膝下までの黒ハーフパンツに黒スニーカー\n・全体的に田舎の中坊感\n\n以上です、よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@poipoiseimen/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3782344, "client_id": 2552009, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c45cf88c/uploads/origins/0c882706-3009-4151-af1a-c4db38a05b31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af5260be9b1ae9a0b3f474033f66e926", "srcset": "https://si.imgix.net/c45cf88c/uploads/origins/0c882706-3009-4151-af1a-c4db38a05b31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af5260be9b1ae9a0b3f474033f66e926, https://si.imgix.net/c45cf88c/uploads/origins/0c882706-3009-4151-af1a-c4db38a05b31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a829a1a087945ed015867ae67578406e 2x, https://si.imgix.net/c45cf88c/uploads/origins/0c882706-3009-4151-af1a-c4db38a05b31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ab6c834fa3cf0962dfd57504c50cc5b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c45cf88c/uploads/origins/0c882706-3009-4151-af1a-c4db38a05b31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86a3cb8f7af0371ab0788b4559c7e593", "srcset": "https://si.imgix.net/c45cf88c/uploads/origins/0c8827