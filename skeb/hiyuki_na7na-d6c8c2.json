のガードが甘いので、他の男などに奪われないか心配している。\nただそんなところも可愛いと思っている。\n\n取り繕ったり隠したりと周囲にしている事も、彼女の前ではほぼ機能しない。ただ自分の言動の周りくどさに彼女が気づいてくれず玉に瑕だが、基本的に信頼しているので、その真意を聞かれれば素直に答える。\n\nそう察しの通り、とんでもなくデレデレ。\n大切にしたいので欲深い行動を謹んでいたのだが、最近色々あり、素直に求める事も辞さなくなった。\n\nお互いを大事に想い合っている２人です\n構図はお任せします…！\nひゆきさんのSD絵柄で拝見したく思い依頼させていただきました、お忙しいなか恐縮ですがどうぞよろしくお願いいたします！！\n\nhttps://one-img.com/L4r1eQhOv609GLQ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hiyuki_na7na/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1935862, "client_id": 2221566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4aefed3b/uploads/origins/93f50965-5f29-4cb1-b8e1-131dafbe55ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73c4dfd7071431898992eaa9e0266faa", "srcset": "https://si.imgix.net/4aefed3b/uploads/origins/93f50965-5f29-4cb1-b8e1-131dafbe55ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73c4dfd7071431898992eaa9e0266faa, https://si.imgix.net/4aefed3b/uploads/origins/93f50965-5f29-4cb1-b8e1-131dafbe55ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8abb4317019285d8b534ccf03e33ec5b 2x, https://si.imgix.net/4aefed3b/uploads/origins/93f50965-5f29-4cb1-b8e1-131dafbe55ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2a19c4545435b964ec280bd2ee819d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4aefed3b/uploads/origins/93f50965-5f29-4cb1-b8e1-131dafbe55ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f74c10e24ac76354c53646c50c5e4561", "srcset": "https://si.imgix.net/4aefed3b/uploads/origins/93f50965-5f29-4cb1-b8e1-131dafbe55ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f74c10e24ac76354c53646c50c5e4561, https://si.imgix.net/4aefed3b/upload