f&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75513307e62deeec2bdd1faf2326e2d2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b63d3c4/uploads/origins/6ecbdd37-f919-4b07-9784-62bfc4dc0789?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb1f6367fed97930b711b0983b58a74c", "srcset": "https://si.imgix.net/3b63d3c4/uploads/origins/6ecbdd37-f919-4b07-9784-62bfc4dc0789?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb1f6367fed97930b711b0983b58a74c, https://si.imgix.net/3b63d3c4/uploads/origins/6ecbdd37-f919-4b07-9784-62bfc4dc0789?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c7ee2e99fbe3cffa19728b08280bd333 2x, https://si.imgix.net/3b63d3c4/uploads/origins/6ecbdd37-f919-4b07-9784-62bfc4dc0789?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a932d499b6540760d18cbc1da0d14d99 3x"}, "body": "カラン先生、はじめまして！作風に一目惚れしてリクエストしました。\n\n〈キャラクター〉\nこちらのVTuberキャラのイラストをお願いしたいです。狐耳と機械の尻尾を持つサイボーグ女の子で、少しやんちゃでからかい好き、憎めない感じの子です。\n\n〈表現〉\nエロかわいい、メスガキっぽい雰囲気で描いていただけると嬉しいです。構図や表情はすべておまかせします。\n\n〈デザインのポイント〉\n・狐耳と尻尾のコアを覆うゼリー状の素材\n・左目のHUDゴーグル\n・爪モチーフと狐尻尾の小物がついたブーツ\n・金属製のリストバンドと首輪\n・興奮しているときは目がオレンジ色になります\n・バックパックはなくても大丈夫です\n資料に詳細を添付しておりますので、見落としがないようご確認いただけると幸いです。\n\n〈使用用途〉\nSNS投稿、配信サムネイル、スケジュール画像など\n\n〈データ〉\n可能であれば、背景なしの透過データも別でいただけると嬉しいです。ファイル形式はPSDとPNG両方でいただけると幸いです。\n\nhttps://drive.proton.me/urls/2D5SFMCG30#xMd3vFY8fVdX", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karan_koron100/works/464", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2800930, "client_id": 3995814, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7081cd1/uploads/origins/00e52f99-0b3d-4393-8f0e-e7e76ee6fe7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit