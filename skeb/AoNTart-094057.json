ラ | ブッチの女性 | 188cm\n自信過剰で、女殺し、スポーツマン。学校のラグビー部のキャプテンとして絶大な人気を誇り、イタリアのマフィアの財産を相続する裕福な令嬢でもあります。筋肉質である点にご注意ください。\n\n📖 フェリシティ・マグダレン | ブッチの女性 | 152cm\n傲慢で、知性的、オタク。学生アーキビストであり、超自然的な図書館を経営する家庭に育った、学年のトップ学生です。\n\n二人は学業上のライバルですが、後に恋人同士になります。成績や人気を巡って頻繁に争います。互いに挑み合うことを楽しみ、それぞれの強みを尊重し合うことを学んでいきます。 \n\n二人のライバル関係を際立たせるような、ワクワクするようなイラストを描いていただけると嬉しいです。どうもありがとうございます！ https://drive.google.com/drive/folders/1Y6RGL9eMKVexCZpLJjibXUbURdzJDHqa?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@AoNTart/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4116956, "client_id": 431857, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9374ab8/uploads/origins/3ce691cc-281d-445a-80da-2e830fe2f1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63f60a80923a909430637e5886bff00b", "srcset": "https://si.imgix.net/e9374ab8/uploads/origins/3ce691cc-281d-445a-80da-2e830fe2f1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63f60a80923a909430637e5886bff00b, https://si.imgix.net/e9374ab8/uploads/origins/3ce691cc-281d-445a-80da-2e830fe2f1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13c2c3879a608ed04f4cc9ecaed42b73 2x, https://si.imgix.net/e9374ab8/uploads/origins/3ce691cc-281d-445a-80da-2e830fe2f1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd53d855b1a870bdd2495c6bc17e751b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9374ab8/uploads/origins/3ce691cc-281d-445a-80da-2e830fe2f1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f44c5295a641f4e44778d510b525c81e", "srcset": "https://si.imgix.net/e9374ab8/uploads/origins/3ce691cc-281d-445a-80da-2e830fe2f1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blu