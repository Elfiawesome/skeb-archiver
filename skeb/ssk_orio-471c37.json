table_same_genre": false}, {"path": "/@ssk_orio/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1463758, "client_id": 2577424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e539b1a/uploads/origins/2e186004-211a-4166-8d7f-be7b68b4425d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4a05bdb7518fe4e1bc7cfd48c85238d", "srcset": "https://si.imgix.net/0e539b1a/uploads/origins/2e186004-211a-4166-8d7f-be7b68b4425d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4a05bdb7518fe4e1bc7cfd48c85238d, https://si.imgix.net/0e539b1a/uploads/origins/2e186004-211a-4166-8d7f-be7b68b4425d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3524945d79814c25d201e095c867927 2x, https://si.imgix.net/0e539b1a/uploads/origins/2e186004-211a-4166-8d7f-be7b68b4425d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f59f184fce637184b87994733769355 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e539b1a/uploads/origins/2e186004-211a-4166-8d7f-be7b68b4425d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21a27d7d4900e6a61fa5c526e28dd896", "srcset": "https://si.imgix.net/0e539b1a/uploads/origins/2e186004-211a-4166-8d7f-be7b68b4425d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21a27d7d4900e6a61fa5c526e28dd896, https://si.imgix.net/0e539b1a/uploads/origins/2e186004-211a-4166-8d7f-be7b68b4425d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4654bc8cb3c63a7b0434f067d97373ab 2x, https://si.imgix.net/0e539b1a/uploads/origins/2e186004-211a-4166-8d7f-be7b68b4425d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=220e41e50712e8b20f10ef01789a94a7 3x"}, "body": "初めまして！創作折尾様の描かれる作品はとても生き生きとしていてとっても魅力的ですね！是非私のオリジナルキャラクターの男性カップルを描いていただけないかと思いリクエストさせていただきました。LOVE要素はあってもなくても大丈夫です！\n\n\n世界観　中世ヨーロッパ風ファンタジー\n\nキャラクター\n・名前　リカルド（攻）\n・32歳くらい\n・男\n・茶髪・くせ毛・少し褐色の肌、緑の眼・隻眼\n・189Cmくらいで筋肉質\n・某国の将軍。貴族父と奴隷の母の間に生まれる。体格を生かした格闘や剣術が得意。性格は誰にでも優しくおおらかで天然人たらし、恋愛事にはちょっと鈍い。お酒好き\n\n・名前　ノクス（受）\n・32歳くらい\n・男・金髪・碧眼・切れ長の目\n・178ｃｍくらい\n・あまり筋肉はない\n・某国の軍師。貴族の次男。頭が切れ、士官学校を首席で卒業。性格は計算高く野心家で口も悪い。プライドが高く素直になれないツンデレ。リカルドに対して激重感情を持っている。お酒には弱く酔うと素直になる。\n\n\n二人は士官学校からの同級生でライバルであり、親友であり、恋人同士という関係です。\n基本的にはノクス(受）の方が激重感情を持っていて、プライドの高さからなかなか素直になれなくて冷たくあたってしまいますが、そんなところもリカルド(攻）は可愛いなと思っていて、二人は付き合って10年くらいの熟年カップルのようです。\n\nポーズやシチュエーションですが、創作折尾様がこの二人から思いつくイメージで自由に描いてくださって構いません。(現代風にアレンジしていただいてもOKです）\n\n下記にキャラクターのメモと参考画像をＵPしておりますが、創作折尾様のほうで衣装や髪形など自由にアレンジしていただいて大丈夫です！\n\n好みに合わなかったり、料金に見合わない場合はキャンセルしていただいて大丈夫です。\n\n是非創作折尾様に私うちの子を描いていただけるととっても嬉しいので、ご検討のほど、何卒宜しくお願い致します。\n\nhttps://www.dropbox.com/sh/uv9wnsidzr6twz0/AAA5vC37fdrbz0gN8fwBXv1oa?dl=0", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ssk_orio/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1463758, "client_id": 217851, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8ce5faa/uploads/origins/14e233bd-4285-45de-8c9b-adb0d33f8495?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=323d29d9a41b5319dc7918f5b2b8d5ef", "srcset": "https://si.imgix.net/a8ce5faa/uploads/origins/14e233bd-4285-45de-8c9b-adb0d33f8495?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=323d29d9a41b5319dc7918f5b2b8d5ef, https://si.imgix.net/a8ce5faa/uploads/origins/14e233bd-4285-45de-8c9b-adb0d33f8495?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1086517cdbc36736a72e336d07bc9f22 2x, https://si.imgix.net/a8ce5faa/uploads/origins/14e233bd-4285-45de-8c9b-adb0d33f8495?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a94c868f07fcb1d019bc1b8e1fb18e9b