はURLにあります。\n10代前半　明るく活発な女の子のイメージです。\n衣装アレンジなど大歓迎です。未勇さんが描きやすいようにしてくださって構いませんが、顔の模様と額のアイマスクは外さないでいただけると嬉しいです。\n\n引き受けていただけると嬉しいです！\nよろしくお願いします！\n\nhttps://x.com/shioshio_enbun/status/1758284906688610619?s=46&t=6ODnJ4RLcOtJqLBoHKkCJA", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miki_or_yurai/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 205817, "client_id": 2107590, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/02350a41/uploads/origins/0687c2a9-c3c0-461a-8d91-a9df2292ca61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7608fc1d12b07a853d4de96b13192141", "srcset": "https://si.imgix.net/02350a41/uploads/origins/0687c2a9-c3c0-461a-8d91-a9df2292ca61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7608fc1d12b07a853d4de96b13192141, https://si.imgix.net/02350a41/uploads/origins/0687c2a9-c3c0-461a-8d91-a9df2292ca61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82b84d075b7adad2d90eb510a9bff317 2x, https://si.imgix.net/02350a41/uploads/origins/0687c2a9-c3c0-461a-8d91-a9df2292ca61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab19b1648f0cb94a715e2a867c6c49b5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/02350a41/uploads/origins/0687c2a9-c3c0-461a-8d91-a9df2292ca61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33369d6f4b1ec1c12c81569730f5280a", "srcset": "https://si.imgix.net/02350a41/uploads/origins/0687c2a9-c3c0-461a-8d91-a9df2292ca61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33369d6f4b1ec1c12c81569730f5280a, https://si.imgix.net/02350a41/uploads/origins/0687c2a9-c3c0-461a-8d91-a9df2292ca61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200