ナイツの作品を拝見し、とても可愛い画風だと思いました！いずれリクエストを送ろうと思っていたのですが、最近の投稿を見て今送ることにしました！お役に立てれば幸いです！🙏\n\n私のOC、ビビアン・ベックス(ビビアン・ベックス)を描いてほしいです。\n彼女はおてんば魔道士で、本に描いた絵を使って呪文を唱えるヒーラーです。彼女は引退した冒険家で、世界中を旅してアートを集め、それを他の人々と分かち合っている。\n構図など細かいことは全てお任せします 🙇‍♂️\n\n彼女についての詳細やアート（ギャラリー）は、こちらのサイトで見ることができる：\nビビアン https://argentumgaleria.carrd.co/#vivian-vex\n\nリクエストに応えてくれてありがとう💗。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HaL_HaL_2049/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2687180, "client_id": 103872, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b61eaf40/uploads/origins/a79e528e-bd28-459f-8c4c-e96c6c328f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83d9eef53599794a9995b5587b40b83c", "srcset": "https://si.imgix.net/b61eaf40/uploads/origins/a79e528e-bd28-459f-8c4c-e96c6c328f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83d9eef53599794a9995b5587b40b83c, https://si.imgix.net/b61eaf40/uploads/origins/a79e528e-bd28-459f-8c4c-e96c6c328f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5873065a391f726ea1201a1ef703a117 2x, https://si.imgix.net/b61eaf40/uploads/origins/a79e528e-bd28-459f-8c4c-e96c6c328f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c09e4ef46c2c757f9dcc46cedafff78 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b61eaf40/uploads/origins/a79e528e-bd28-459f-8c4c-e96c6c328f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3aa4da919b7fb407922b2ac2f0a92317", "srcset": "https://si.imgix.net/b61eaf40/uploads/origins/a79e528e-bd28-459f-8c4c-e96c6c328f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3aa4da919b7fb407922b2ac2f0a92317, https://si.imgix.net/b61eaf40/uploads/origins/a79e