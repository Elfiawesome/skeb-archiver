きたいキャラクター\n\n猫宮こころ\n13さいのメイドさんに憧れてるろりっ娘猫又\n\nhttps://photos.app.goo.gl/hi1g4buevJXA3Tnf9\n\n\nよろしくお願いいたします。\n\nhttps://photos.app.goo.gl/hi1g4buevJXA3Tnf", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SetozakiTen2/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4107504, "client_id": 3834277, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6495b219/uploads/origins/35e0f9d7-9456-4eb2-a1b0-4c21beb3035f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b4bc7051d9420c67f4a500457dd8e9f", "srcset": "https://si.imgix.net/6495b219/uploads/origins/35e0f9d7-9456-4eb2-a1b0-4c21beb3035f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b4bc7051d9420c67f4a500457dd8e9f, https://si.imgix.net/6495b219/uploads/origins/35e0f9d7-9456-4eb2-a1b0-4c21beb3035f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58eb3021c2c52d19239d5f8f4a01a7c8 2x, https://si.imgix.net/6495b219/uploads/origins/35e0f9d7-9456-4eb2-a1b0-4c21beb3035f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f860ff7cd86a4f944fd79769ec07ea2f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6495b219/uploads/origins/35e0f9d7-9456-4eb2-a1b0-4c21beb3035f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31493db5b20c005b4c07be779137bd71", "srcset": "https://si.imgix.net/6495b219/uploads/origins/35e0f9d7-9456-4eb2-a1b0-4c21beb3035f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31493db5b20c005b4c07be779137bd71, https://si.imgix.net/6495b219/uploads/origins/35e0f9d7-9456-4eb2-a1b0-4c21beb3035f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5b317aa3a36671736b3025a383cff8ac 2x, https://si.imgix.net/6495b219/