-4867-8d28-b452debfc7b8?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=af040f3671eb72f8b24f75be52e2ec4a, https://si.imgix.net/76144782/uploads/outputs/4e9bc5c9-26a0-4867-8d28-b452debfc7b8?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8d09aea3b6803cdad262afb56a018a42 2x, https://si.imgix.net/76144782/uploads/outputs/4e9bc5c9-26a0-4867-8d28-b452debfc7b8?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d4fdd2c4a10a9f9d368c420cfb20fed5 3x"}, "body": "ロミ助さん、お久しぶりです！ \n前回は自分の思い描いていた光景をバッチリ描いていただき本当にありがとうございました！！✨️\nうちのPS5の壁紙にさせていただきました(*´艸`)\n\n 今回なのですが、初めてムービープランで依頼を出してみようかなと思いまして、前回描いていただいたウォークマン(WM-R55)にスポットを当てたムービーをお願いいたします！\n\n以下が詳細になります↓   \n\n・PCの動く壁紙にしたいので、サイズは16:9でお願いいたします！\n\n・場所は前回と同じくカフェの店内で、一応時間帯は夜。\n\n・カウンターテーブルの右端(画面上の場所で言うと少し右下あたり)にWM-R55(前回と同じモデル、色)が置かれていて、再生ボタンが押し込まれており、ハブ駆動軸(カセットテープを回す二本の軸)がそれぞれ反時計回りにゆーっくり回っていて、本体右上にあるREC/BATTランプが赤く点灯している。\n\n ・カウンターの上、というか奥側にはコーヒーミルやサイフォンなどの器具が置かれているだろうと自分の中で想像していますが、背景としてぼかしていただいて大丈夫です。\n\n・わりとWM-R55に近めのカメラアングルだと嬉しいです✨️\n\nこんな感じです！\nまた写真の資料としてgoogleドライブのリンクを添付いたしますので、ご活用いただけると幸いですm(_ _)m\n\n また長文になってしまい申し訳ございません💦 どうか今回もよろしくお願いいたします！！\n\nhttps://drive.google.com/drive/folders/1UN_e-LTZHyjIvK6EHYffCtsJXZ3f3NZl", "nc": 16, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@_romisuke_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1240719, "client_id": 1595002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6fa6cb7/uploads/origins/637678e7-c432-4624-b2ab-2dc74fd13e65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=912683b4fbd5565eabd9567bb7cdaffd", "srcset": "https://si.imgix.net/f6fa6cb7/uploads/origins/637678e7-c432-4624-b2ab-2dc74fd13e65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=912683b4fbd5565eabd9567bb7cdaffd, https://si.imgix.net/f6fa6cb7/uploads/origins/637678e7-c432-4624-b2ab-2dc74fd13e65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8386db01fee72d70b0a57793a773cac1 2x, https://si.imgix.net/f6fa6cb7/uploads/origins/637678e7-c432-4624-b2ab-2dc74fd13e65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8114a228a25d79d67d731cbb6b513d2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f6fa6cb7/uploads/origins/637678e7-c432-4624-b2ab-2dc74fd13e65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f2432d34d79ca990c3b01ef9c11755a", "srcset": "https://si.imgix.net/f6fa6cb7/uploads/origins/637678e7-c432-4624-b2ab-2dc74fd13e65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f2432d34d79ca990c3b01ef9c11755a, https://si.imgix.net/f6fa6cb7/uploads/origins/637678e7-c432-4624-b2ab-2dc74fd13e65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=245f42a1d73259089dd9730860f50d88 2x, https://si.imgix.net/f6fa6cb7/uploads/origins/637678e7-c432-4624-b2ab-2dc74fd13e65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=104628099ab696b783185d45866e61c6 3x"}, "body": "ロミ助さん、お久しぶりです！\n 前回送ろうとしたリクエストの件ではご迷惑をおかけしてしまって申し訳ございませんでした💦 \n\n 今回は二次創作ではなく、自分の思いつきから「女の子とウォークマン(ステレオカセットレコーダー)」を題材にしたイラストをぜひお願いいたします！ \n\n 以下がその内容(構想？)になります↓ \n\n ・場所は、街の片隅の小さな隠れ家的なお店の中で、室内は白熱電球の明かりに照らされている。\n(店内はあくまでも背景としてめちゃくちゃぼかして描いていただいても全然大丈夫です！)  \n\n・トレンチコートを着た黒髪のボーイッシュな女の子が、机かもしくはバーカウンターに非常にリラックスした様子で頬杖をつき、机の上に置かれているウォークマンを優しく見下ろしながら耳を傾けている。\n(視点は机を挟んで女の子を正面から見る感じがいいかと考えています。ちょうど向かいに座っているような視点なので、机の下は見えない感じですね。)  \n\n・机に置かれているウォークマンは、SONYが1985年に製造したWM-R55というモデルで、色はブラック。 \n再生ボタン(正面から見て右から二番目のボタン)が押し込まれており、イヤホンは差さっておらず、搭載してあるスピーカーから音楽か何かのカセットを再生中。\n (無骨なデザインがかっこいいので、正面がこちらにも見えるように描いていただけると嬉しいです✨️)  \n\nWM-R55の作画資料にできるかもしれない画像をGoogleドライブに4枚置いてありますので、よろしければ参考にしていただければと思います💦  \n\n長文になってしまい申し訳ございません💦 柔らかい光に照らされた女の子とウォークマンの姿は、ロミ助さんの画風とおそらくマッチする気がしますので、どうかよろしくお願いいたします！！🙏\n\nhttps://drive.google.com/drive/folders/1UN_e-LTZHyjIvK6EHYffCtsJXZ3f3NZl", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_romisuke_/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/118ceef6/uploads/origins/2bc7cc1d-e80d-4185-b528-58116c763dd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8bacfdf7fd137fbf131a0cb112df5462", "srcset": "https://si.imgix.net/118ceef6/uploads/origins/2bc7cc1d-e80d-4185-b528-58116c763dd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8bacfdf7fd137fbf131a0cb112df5462, https://si.imgix.net/118ceef6/uploads/origins/2bc7cc1d-e80d-4185-b528-58116c763dd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac61674e4e37912af7a8465b4e3ac13b 2x, https://si.imgix.net/118ceef6/uploads/origins/2bc7cc1d-e80d-4185-b528-58116c763dd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=15b0a5d00c851bce92782ec0f5ceccb7 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1240719, "client_id": 1692246, "nc": 49}, {"path": "/@_romisuke_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1240719, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e6a47fc2/uploads/origins/96d2c468-635c-4f82-bceb-80bc3be7524b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f60d85b511306df91c6f5ab1aa4e00b", "srcset": "https://si.im