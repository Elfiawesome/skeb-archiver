していただいて問題ございません。\n\n他は服装などもイラストの雰囲気に合うようにお好きに描いていただければ幸いです。\n\nご検討のほどよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kougouseitanosi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 864196, "client_id": 104882, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/85a29d79/uploads/origins/622fe53a-dcac-465c-94b9-d49355fd734e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4296c380f12b0f55e66eed4afbdbf63", "srcset": "https://si.imgix.net/85a29d79/uploads/origins/622fe53a-dcac-465c-94b9-d49355fd734e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4296c380f12b0f55e66eed4afbdbf63, https://si.imgix.net/85a29d79/uploads/origins/622fe53a-dcac-465c-94b9-d49355fd734e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6bb79270cd065d67cb71b8a12920dd5 2x, https://si.imgix.net/85a29d79/uploads/origins/622fe53a-dcac-465c-94b9-d49355fd734e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2583a56fa38e221c30ad5bdfb846fed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/85a29d79/uploads/origins/622fe53a-dcac-465c-94b9-d49355fd734e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=178d4072a5634245efaedbbe36750f88", "srcset": "https://si.imgix.net/85a29d79/uploads/origins/622fe53a-dcac-465c-94b9-d49355fd734e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=178d4072a5634245efaedbbe36750f88, https://si.imgix.net/85a29d79/uploads/origins/622fe53a-dcac-465c-94b9-d49355fd734e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c1fce0813712bb724fdb54072a70902b 2x, https://si.imgix.net/85a29d79/uploads/origins/622fe53a-dcac-465c-94b9-d49355fd734e?bg=%23fff&auto=form