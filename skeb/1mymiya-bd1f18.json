9/uploads/origins/93556b8e-198c-4d06-bb31-265a2e106e07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5570fd78d3045ed37366c723ec10a579 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5212dad9/uploads/origins/93556b8e-198c-4d06-bb31-265a2e106e07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3940383eded7fea6f5cc3a72db26cc5a", "srcset": "https://si.imgix.net/5212dad9/uploads/origins/93556b8e-198c-4d06-bb31-265a2e106e07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3940383eded7fea6f5cc3a72db26cc5a, https://si.imgix.net/5212dad9/uploads/origins/93556b8e-198c-4d06-bb31-265a2e106e07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c1749cdb6836022584c10145ef3ec6e 2x, https://si.imgix.net/5212dad9/uploads/origins/93556b8e-198c-4d06-bb31-265a2e106e07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7dea4c8dc3c7f6d8c38bb1cc1631177e 3x"}, "body": "はじめまして。\nskebを見ていた時に目に留まり、とても心惹かれたのでリクエストを送らせて頂きました。\n\n・参考資料のオリジナルキャラを自由に描いて頂きたいです\n・赤髪、赤い瞳、前髪ぱっつん、ハーフツイン（黒いリボンで結んでいる）、後ろ髪は腰まで伸びているロング\n・服装は参考資料の軍服、黒のニーハイを履かせて欲しいです。他に書きやすい服装があればそちらで構いません。\n・参考資料の軍服を書く場合、付いている勲章等のアクセサリは描きやすいように変更したり簡略化していただいても構いません。\n・その他ポーズなど指定していない部分も全てお任せ致します。\n\n・上記の絵とは別に可能であれば、xで投稿されていた（https://x.com/1mymiya/status/1950390894102008070）こちらのスタイルでもオリキャラを書いていただけると嬉しいです。\n\n以上になります。\nお手数おかけしますが、検討いただけますと幸いです。\n\nオリキャラの参考資料・イメージ\nhttps://drive.google.com/drive/folders/1KYS1zB-cjpueepWbCJ_U-MoSYgviMKGu?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1mymiya/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3508886, "client_id": 3697293, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4dfc6761/uploads/origins/0baddc5f-5cee-4fbf-bf67-64b69076f526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b808934e446ab915451ac84c13d57b9", "srcset": "https://si.imgix.net/4dfc6761/uploads/origins/0baddc5f-5cee-4fbf-bf67-64b69076f526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b808934e446ab915451ac84c13d57b9, https://si.imgix.net/4dfc6761/uploads/origins/0baddc5f-5cee-4fbf-bf67-64b69076f526?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1c6805e1237fafe2026c40630f04126 2x, https://si.imgix.net/4dfc6761/uploads/origins/0baddc5f-5cee-4fbf-bf67-64b69076f526?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aaf20354520797577559d361eea85304 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4dfc6761/uploads/origins/0baddc5f-5cee-4fbf-bf67-64b69076f526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5f4497aed90e402478a2672ee225dcb", "srcset": "https://si.imgix.net/4dfc6761/uploads/origins/0baddc5f-5cee-4fbf-bf67-64b69076f526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5f4497aed90e402478a2672ee225dcb, https://si.imgix.net/4dfc6761/uploads/origins/0baddc5f-5cee-4fbf-bf67-64b69076f526?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d0e60796e820100f995a0df4ffe28826 2x, https://si.imgix.net/4dfc6761/uploads/origins/0baddc5f-5cee-4fbf-bf67-64b69076f526?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c07befbf30cf2233ecf12d6955ee4fe1 3x"}, "body": "いつも可愛いイラスト拝見させてもらっています。\n特にぺた系のイラストが好きで依頼させて頂きたいです。\n描いていただきたいイラストは2枚で、まどかマギカのアルティメットまどかで、ガラスにくっついている、ぺたアルティメットまどかで、正面からと、後ろからのイラストをお願いしたいです。\nオタ活用の名刺で縦に使用したいので、正面からのイラストに\n【Ｘ：ゆうたん@kanameyutan】\nを左上辺りにガラスに描いてある感じに入れていただきたいです。\n字体はお任せで、色はピンクでお願いします。\nその下にまどかがぺたっとくる感じで！\n両面印刷で使う予定です。\n出来れば文字無しの差分も欲しいので、計3枚納品していただきたいです。\n可能であれば依頼を受け