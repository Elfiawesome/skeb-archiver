fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7398b1c2ee9a4e535fea64809bbaacb7 3x"}, "body": "こんにちは！はじめまして。私はあなたの画風が大好きで、あなたのイラストは楽しくて魅力的だと思います！私のオリジナルキャラクターを描いていただけたら嬉しいです。\n\n名前はクライヴとエド。クライブはエドを困らせるのが趣味の悪役。エドは心優しく誠実な性格で、クライブに悪役をやめてほしいと思っています！クライブはエドのかわいさと誠実さをおもしろがっている。\n\nそんな2人のじゃれあいや愛情を描いていただけたら嬉しいです。お好きなように描いてください！よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1v95d3MqG9Bw4DwZoYd-obfwb8Jd8neKW?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uir_dr/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/223c6861/uploads/origins/7e9513aa-d6f2-447e-a427-3c8132bdd5c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ffefe8ee6d5733aedcb4109206a3e3dc", "srcset": "https://si.imgix.net/223c6861/uploads/origins/7e9513aa-d6f2-447e-a427-3c8132bdd5c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ffefe8ee6d5733aedcb4109206a3e3dc, https://si.imgix.net/223c6861/uploads/origins/7e9513aa-d6f2-447e-a427-3c8132bdd5c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d626b576d3a3f5c35bf67847b6006be 2x, https://si.imgix.net/223c6861/uploads/origins/7e9513aa-d6f2-447e-a427-3c8132bdd5c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c146df7a85742f61ef983d4fbb1fe8b 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2483091, "client_id": 1389648, "nc": 1}, {"path": "/@uir_dr/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped":