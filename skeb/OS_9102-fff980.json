compress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd13ac633dc0a32e6785efdae894e5d2 2x, https://si.imgix.net/94374480/uploads/origins/56d29908-472e-4f6f-9a5e-46c4b68f5c99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45f3d87f66380f033b4d2459983ff24f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94374480/uploads/origins/56d29908-472e-4f6f-9a5e-46c4b68f5c99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eed74afd5e1c8f4141966607129e8678", "srcset": "https://si.imgix.net/94374480/uploads/origins/56d29908-472e-4f6f-9a5e-46c4b68f5c99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eed74afd5e1c8f4141966607129e8678, https://si.imgix.net/94374480/uploads/origins/56d29908-472e-4f6f-9a5e-46c4b68f5c99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bea0099f2a5dec7d3a8907bf918daa91 2x, https://si.imgix.net/94374480/uploads/origins/56d29908-472e-4f6f-9a5e-46c4b68f5c99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a35384a84dde071842133b92e8db8564 3x"}, "body": "お世話になっております。\n自探索者と自陣の他探索者のイラストを是非おそやまさんの絵柄で描いていただきたく、リクエストいたします。「リコレクションレコード」自陣となります。※自陣の創作・依頼許可済み\n\n使用用途：自陣への共有。可能でしたらアクリル系グッズの個人的な製作。\n\n資料に立ち絵を添付いたします。どちらもＢＯＯＴＨ販売の立ち絵をお借りしており、作者様方に創作・依頼の許可をいただいております。\n\nＨＯ１（水色の髪の方）\n・178cm\n・跳ねた水色の髪。サングラスを頭にかけてます。ひょろっとした体型です。\n・元気が良くて自信満々に笑う、おしゃべりな男です。\n\nＨＯ２（白い髪の方）\n・190cm\n・右目が隠れた白髪。筋肉質でガタイがいいです。\n・寡黙で包容力があり、優しげに微笑む純粋な男です。\n\nhttps://drive.google.com/drive/folders/1lEgz-ixYlRpo0jLWG7WXJtzTPLQYKTgI?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OS_9102/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3939981, "client_id": 3748452, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8cd02aec/uploads/origins/18d98127-4df1-4ee9-b8ee-a59c16cfe03f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa32e9d40ba0b63a01ed08ba93c1621f", "srcset": "https://si.imgix.net/8cd02aec/uploads/origins/18d98127-4df1-4ee9-b8ee-a59c16cfe03f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa32e9d40ba0b63a01ed08ba93c1621f, https://si.imgix.net/8cd02aec/uploads/origins/18d98127-4df1-4ee9-b8ee-a59c16cfe03f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9bd5cf72dd19349c53177e764ef70d48 2x, https://si.imgix.net/8cd02aec/uploads/origins/18d98127-4df1-4ee9-b8ee-a59c16cfe03f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72ed4b069f2cc292fd596d3ed0db7041 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8cd02aec/uploads/origins/18d98127-4df1-4ee9-b8ee-a59c16cfe03f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06f5b11dfa51fabc82ab5ce562514203", "srcset": "https://si.imgix.net/8cd02aec/uploads/origins/18d98127-4df1-4ee9-b8ee-a59c16cfe03f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06f5b11dfa51fabc82ab5ce562514203, https://si.imgix.net/8cd02aec/uploads/origins/18d98127-4df1-4ee9-b8ee-a59c16cfe03f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3938b654b17d50f182db56bd0c5ccd5e 2x, https://si.imgix.net/8cd02aec/uploads/origins/18d98127-4df1-4ee9-b8ee-a59c16cfe03f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d1b37bab9e3c2331b72d5deb000f8d48 3x"}, "body": "祖山様\n初めまして、あずみと申します。\nskeb開設ありがとうございます。\n祖山様の美麗なイラストを以前よりXにて拝見しており、この機会にリクエストさせて頂きます！\n\n描いていただきたいのはクトゥルフ神話TRPG「四季送り」の探索者とNPCのイラストです。\n詳細は下記に記載/ドライブにて資料を添付いたします。\n\n千秋心：男性/26歳/183cm/甘味処の従業員として働きつつ裏社会で殺し屋として働いています。\n筋肉があるが細身で少し気弱な性格。\n表情筋が固いが感情が冷や汗や赤面など態度には出やすい。\n平行眉なため困り顔に見られやすい。\n対人関係が苦手ですが化野祝には大分気を許しており穏やかな表情を見せます。\n    特徴\n髪：焦げ茶/左耳上を下にかけてあみこみ（赤色メッシュみつあみ）/髪をお団子にまとめています。/前髪は長めで目に少しかかっています。/左に分け目があり左右に流れています。\n瞳：赤〜橙色/つり目/平行眉/左目下に泣きぼくろがあります。\nアクセサリ：右耳に化野祝と同じ銀色のイヤーカフをつけています\n服装：シャツに着物、えんじ色の制服、羽織を着用しております。たすき掛けの紐はみつあみで出来ています。\n\n化野祝：男性/29歳/175cm/甘味処のキッチンとして働きつつ、殺人等はしませんが裏の仕事にも加担しています。\n朗らかで自由な性格をしています。所謂陽キャで誰にでも優しく接しています。\n千秋心に対しては可愛がっており頭を撫でたり甘やかすような仕草をよくしています。\n髪：黄土色のような髪色/ふわふわの髪質でひとつにくくっています/前髪は千秋心よりも長く左に流れています。アホ毛もあります\n瞳：黄緑、黄色〜黄土色/若干つり目/タレ眉\nアクセサリ：右耳に銀色のイヤーカフ\n服装：シャツ、着物、制服を着用しています。袖はたすきがけしています。胸元に緩くリボン結びあり。\n\n関係性\n同居している仲で無自覚な共依存的関係で互いが大切な存在です。\n千秋心の人生において化野祝の存在は大きいです。\nそんなことを化野祝は受け入れ幸せに過ごしています。\n\nイラストのシチュエーションや構図はお任せ致します。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1_XNJcqJ_ax22dwy_G8xQos3H4Fnc4SEZ", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OS_9102/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3939981, "client_id": 3707116, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8ef79bf/uploads/origins/ed87ebc5-f888-403e-9ab3-e5f28b063951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a669aafcb39c0b780d6478ed10ec7d63", "srcset": "https://si.imgix.net/d8ef79bf/uploads/origins/ed87ebc5-f888-403e-9ab3-e5f28b063951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a669aafcb39c0b780d6478ed10ec7d63, https://si.imgix.net/d8ef79bf/uploads/origins/ed87ebc5-f888-403e-9ab3-e5f28b063951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b7439786aa543bd7cbdf919d688e1ae 2x, https://si.imgix.net/d8ef79bf/uploads/origins/ed87ebc5-f888-403e-9ab3-e5f28b063951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c9a92a10947f00358a977a5829070ab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d8ef79bf/uploads/origins/ed87ebc5-f888-403e-9ab3-e5f28b063951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82e5d60a36dc250b27a09601eaa2f790", "srcset": "https://si.imgix.net/d8ef79bf/uploads/origins/ed87ebc5-f888-403e-9ab3-e5f28b063951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82e5d60a36dc250b27a09601eaa2f790, https://si.imgix.net/d8ef79bf/uploads/origins/ed87ebc5-f888-403e-9ab3-e5f28b063951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=61453ea451e06a249d406077f25a4abb 2x, https://si.imgix.net/d8ef79bf/uploads/origins/ed87ebc5-f888-403e-9ab3-e5f28b063951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f286c57f9ff7a8d9388a4674ea2b822 3x"}, "body": "はじめまして。いつも祖山さんのイラストを見ている者です。今回自秋と化野のイラストを貴方の絵柄で見たく依頼しました。\n版権キャラがNGでしたら蹴っていただいてかまいません。\n\n特徴\n・髪型はロングヘアの三つ編みハーフアップ\n・黒羽織\n・ぬいぐるみはなくても良い。またぬいぐるみのアレンジもOK\n・身長150cm\n・赤ちゃんをしてるので全体的に幼い（台詞が全部平仮名、抱っこやハグを求めるなど）\n・小物（装飾品）はぬいぐるみ以外はない\n\n服装は資料のものでも描きやすい服装でも大丈夫です！\n化野関係性としましては結婚しましたので、お互い恋愛感情があり、シナリオ後はお互い穏やかにあびで働いています。\n\n　その他構図なども描きやすいものや描きたいものでお願いします。色々細かく頼んでしまい申し訳ありません！ですが、一番は祖山さんが楽しく描きやすい、描きたいものでお願いします！よろしくお願いします！\n　また化野と恋愛関係がありますのでそういうのは嫌だな、値段に問題がある、資料が足りないなどあれば再送をお願いします…！\n\nhttps://drive.google.com/drive/folders/1dlgppCV3mNXvkqHLs9gv627DxUt4fSF9", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OS_9102/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3939981, "client_id": 374035, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/955a6f26/uploads/origins/0e746fb4-cb23-4701-8460-d06481e21ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08f4d196cfc0bedbd0199a3dd81efe2e", "srcset": "https://si.imgix.net/955a6f26/uploads/origins/0e746fb4-cb23-4701-8460-d06481e21ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08f4d196cfc0bedbd019