s://www.youtube.com/watch?v=ocbZ3S-AIMU\n00:22:50 ～ 00:52:37 が新衣装の紹介になります。\n（コメントにタイムスタンプがあります）\n\n【使用目的】\n私個人のXやYouTubeなどのSNSでの利用、壁紙などでの鑑賞目的での個人利用になります。\nまたFAになりますので、ご本人様のVTuber活動（X、YouTubeなどのSNS上）で使用される可能性がございます。\n配信のサムネイルやその他SNSでの使用許可をいただきたいです。\n\n【構図・ポージング】\n構図・ポージングについてはお任せいたします。\n春向けのプレゼントにしたいので春をテーマにお願いします。\nご本人様のVTuber活動で使用される事を考慮し、頭や左右の切れが無いようお願いいたします。\n\n【納品】\n納品については特に希望はございませんが、背景と人物を分けていただけるとありがたいです。\n\n【注意事項】\nXの\"AIモデル学習利用\"の明文化により学習に利用される等の話題がありますが、依頼するFAもXなどのSNSでVTuber様の活動に利用させていただきます。\nそのため、AIモデル学習利用についてご懸念があるようであれば、依頼をキャンセルをしていただいて問題ありません。\n\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1uUER9y7MMGey8X9-K7rYwFw80OlEIZ7b?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@123haruno_oto/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3287021, "client_id": 1158300, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d43116f/uploads/origins/c0171ce1-c334-4ae5-8827-cf4379139ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17beb744ddc068189bdd3f330e24ba39", "srcset": "https://si.imgix.net/8d43116f/uploads/origins/c0171ce1-c334-4ae5-8827-cf4379139ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17beb744ddc068189bdd3f330e24ba39, https://si.imgix.net/8d43116f/uploads/origins/c0171ce1-c334-4ae5-8827-cf4379139ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edd1e28c3155a76c5ab893810664d41d 2x, https://si.imgix.net/8d43116f/uploads/origins/c0171ce1-c334-4ae5-8827-cf4379139ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8db4df148591a41f7ca483778f73aecc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d43116f/uploads/origins/c0171ce1-c334-4ae5-8827-cf4379139ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&