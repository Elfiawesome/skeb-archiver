vDtoh1D9ecHPbUXOQaPrDp1yErDjV49?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@123haruno_oto/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3287021, "client_id": 35720, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0e1405d/uploads/origins/7a2c4144-0362-4337-b31b-1af5e9f05212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=543eaafa5bb3b6cbb383ed0dadb53b4b", "srcset": "https://si.imgix.net/d0e1405d/uploads/origins/7a2c4144-0362-4337-b31b-1af5e9f05212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=543eaafa5bb3b6cbb383ed0dadb53b4b, https://si.imgix.net/d0e1405d/uploads/origins/7a2c4144-0362-4337-b31b-1af5e9f05212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b54927853947152e3aba10dd9390be3 2x, https://si.imgix.net/d0e1405d/uploads/origins/7a2c4144-0362-4337-b31b-1af5e9f05212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a509d510aa067c8ab76c06d6a4f9f452 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0e1405d/uploads/origins/7a2c4144-0362-4337-b31b-1af5e9f05212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2840521a22b0989164e5a54f180273e", "srcset": "https://si.imgix.net/d0e1405d/uploads/origins/7a2c4144-0362-4337-b31b-1af5e9f05212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2840521a22b0989164e5a54f180273e, https://si.imgix.net/d0e1405d/uploads/origins/7a2c4144-0362-4337-b31b-1af5e9f05212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=acc28bbd93387f063c16170cdedb93e3 2x, https://si.imgix.net/d0e1405d/uploads/origins/7a2c4144-0362-4337-b31b-1af5e9f05212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=10bc5e65cc92692f95455fc4ad5e3f0f 3x"}, "body": "はるぅ 様\nはじめまして。\nイラストをXで拝見し、プロフアイコンのかなたんの可愛さに惹かれました！\nぜひ推しVのファンアートをお願いいたします。\n\n【依頼内容】\n・モデル 個人VTuber \"天乃まの\" さん\n\nhttps://x.com/Aman0_man0\n→ご本人のXアカウントです。\n\n・参考資料 https://lit.link/amanomano\n→ご本人のlit.linkになります。\nこちらに三面図が３種類ございますが、「3周年記念衣装」でお願いいたします。\nまた、こちらの\"二次創作について\"にてファンアートについての記載があり、Skebの依頼については問題は無い認識です。\n\n資料URLに三面図とバストアップの画像をご用意いたしました。\n3周年記念配信でも確認できますので、細部はそちらを見ていただければと思います。\nhttps://www.youtube.com/watch?v=ocbZ3S-AIMU\n00:22:50 ～ 00:52:37 が新衣装の紹介になります。\n（コメントにタイムスタンプがあります）\n\n【使用目的】\n私個人のXやYouTubeなどのSNSでの利用、壁紙などでの鑑賞目的での個人利用になります。\nまたFAになりますので、ご本人様のVTuber活動（X、YouTubeなどのSNS上）で使用される可能性がございます。\n配信のサムネイルやその他SNSでの使用許可をいただきたいです。\n\n【構図・ポージング】\n構図・ポージングについてはお任せいたします。\n春向けのプレゼントにしたいので春をテーマにお願いします。\nご本人様のVTuber活動で使用される事を考慮し、頭や左右の切れが無いようお願いいたします。\n\n【納品】\n納品については特に希望はございませんが、背景と人物を分けていただけるとありがたいです。\n\n【注意事項】\nXの\"AIモデル学習利用\"の明文化により学習に利用される等の話題がありますが、依頼するFAもXなどのSNSでVTuber様の活動に利用させていただきます。\nそのため、AIモデル学習利用についてご懸念があるようであれば、依頼をキャンセルをしていただいて問題ありません。\n\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1uUER9y7MMGey8X9-K7rYwFw80OlEIZ7b?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@123haruno_oto/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3287021, "client_id": 1158300, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d43116f/uploads/origins/c0171ce1-c334-4ae5-8827-cf4379139ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17beb744ddc068189bdd3f330e24ba39", "srcset": "https://si.imgix.net/8d43116f/uploads/origins/c0171ce1-c334-4ae5-8827-cf4379139ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17beb744ddc068189bdd3f330e24ba39, https://si.imgix.net/8d43116f/uploads/origins/c0171ce1-c334-4ae5-8827-cf4379139ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edd1e28c3155a76c5ab893810664d41d 2x, https://si.imgix.net/8d43116f/uploads/origins/c0171ce1-c334-4ae5-8827-cf4379139ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8db4df148591a41f7ca483778f73aecc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d43116f/uploads/origins/c0171ce1-c334-4ae5-8827-cf4379139ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77d891fa8412821e9403be02613fa74b", "srcset": "https://si.imgix.net/8d43116f/uploads/origins/c0171ce1-c334-4ae5-8827-cf4379139ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77d891fa8412821e9403be02613fa74b, https://si.imgix.net/8d43116f/uploads/origins/c0171ce1-c334-4ae5-8827-cf4379139ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=86522561c41de13e8e8cb4df675571b6 2x, https://si.imgix.net/8d43116f/uploads/origins/c0171ce1-c334-4ae5-8827-cf4379139ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b0c053dfb5308dd9fb932abd57120e66 3x"}, "body": "こんにちは。新しくSkebを始めている方を拝見していたところ\nとても素敵なイラストが目に留まり依頼させて頂きました！\n依頼したいのはVsingerのイラストです。\n\n＜依頼内容＞\n依頼するイラストはVsingerである凪乃ましろさんの2周年イラストです。\n\n<使用用途>\nVsingerとしての活動で動画やサムネイル、X等で使用される可能性があります。\n個人的にPC壁紙や個人鑑賞グッツの作成として使用する場合もあります。\n\n＜構図＞\n・凪乃ましろさんの2周年イラスト\n・構図はお任せ致します(あえていうならおめでたい、お祝いされている感じ)\n・補足しますと食べることと歌うことが好きで、品はありつつ表情豊かな性格で海辺の町に住んでいる方です。\n\n＜こうしてほしい点・お願い＞\n・左目下の泣きほくろ\n・髪色のハイライトをオーロラ色に\n・キャラクターのみの透過データ、PSDをいただけますと幸いです。\n・お手数だと思うのでこちらは可能であればお願いしたいのですが、ましろさんには通常の白髪青目Verと、黒髪赤目Verがあります。今回通常の白髪青目Verを依頼させて頂くのですが、可能であればで大丈夫なので黒髪赤目Verの差分もいただけると大変嬉しいです。\n\n＜その他＞\nhttps://lit.link/naginomashiro\nガイドラインにてファンによるskebへの依頼が許可されています。\n\n\nお忙しいと思いますが、何卒よろしくお願い致します。\n\n＜資料＞\n通常衣装三面図、資料\nhttps://twitter.com/naginomashiro/status/1637021974051553280\n\n新衣装三面図\nhttps://twitter.com/Nagino_Mashiro/status/1705845708610499031\n\n表情資料\