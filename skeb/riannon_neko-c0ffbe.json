lur=200&s=652a8a919563c13b40671ab689f6cb7b, https://si.imgix.net/0be79a03/uploads/origins/227ad9e1-3c06-4bcc-a7e7-07a60634333b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a2b8f4b0ff2f9d138cf281071e661ca3 2x, https://si.imgix.net/0be79a03/uploads/origins/227ad9e1-3c06-4bcc-a7e7-07a60634333b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=de0323178001ef9e8a4361d14a6a03fd 3x"}, "body": "初めましてVTuber準備中の那来萌と申します。\n\nリアノン様のイラストを拝見しすごく素敵だなと思い是非私のイラストを書いて頂きたくリクエストしました。\n\n・内容\n構図は顔アップで少し照れた表情で服装、背景等は全てお任せ致します。（頭部などが見切れない形だと助かります）\n\n\n・使用用途\nVTuber活動に伴うSNSでの使用、サムネイル等\n\n・キャラクター\n資料URLに立ち絵、3面図がありますので参考にしてください。\n\n・納品形式\n人物、背景、宛名等がレイヤー分けされたPSDデータ、もしくはPNGだととても助かります。\n\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1-0Lh2PrMpsR9Vb7WZ-KvesAxJr3jJKMl", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riannon_neko/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2525748, "client_id": 1564065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e4a6670/uploads/origins/10a698ed-0f19-4783-b5f0-3744d1649cd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b56a8e0f57e2de00a5afc189d6d995f", "srcset": "https://si.imgix.net/8e4a6670/uploads/origins/10a698ed-0f19-4783-b5f0-3744d1649cd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b56a8e0f57e2de00a5afc189d6d995f, https://si.imgix.net/8e4a6670/uploads/origins/10a698ed-0f19-4783-b5f0-3744d1649cd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3a6ef78a42237adbb4053d412a0cf92 2x, https://si.imgix.net/8e4a6670/uploads/origins/10a698ed-0f19-4783-b5f0-3744d1649cd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=624716b074c4e3cc2134c4daa08bb2b7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e4a6670/uploads/origins/10a698ed-0f19-4783-b5f0-3744d1649cd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8da192d63ed7896a053372b8f153c769", "srcset": "https://si.imgix.net/8e4a6670/uploads/origins/10a698ed-0f19-4783-b5f0-3744d1649cd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8da192d63ed7896a053372b8f153c769, https://si.imgix.net/8e4a6670/uploads/origins/10a698ed-0f19-4783-b5f0-3744d1649cd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac275b8df96093e34febc0cb1c616cac 2x, https://si.imgix.net/8e4a6670/uploads/origins/10a698ed-0f19-4783-b5f0-3744d1649cd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ca0376b3883f9809438ae02d36e93356 3x"}, "body": "リアノン先生はじめまして。\nこの度は、Xにてイラストを拝見し、その絵柄に惹かれ、是非リアノン先生に描いて頂きたいと思い、\nリクエストさせて頂きました。\n\nこの度描いて頂きたいのは、私の推しVtuber「七熊燐」(@nakumarin)さんです。\n元気な見た目17歳くらいの女の子で、\nモチーフはくま(テディベアは白熊)です。\n\n明るく元気でノリが良く、笑顔が素敵な女の子なので、もし良ければ\n①ギャルピース(手の内側をこちら側に向けるピース)\n②やや下から見上げている\n③おへそが見えている\n④ウインク\n⑤笑顔\n⑥野外\n以上の要素を対面から見ている構図だと嬉しいです。\nその他は、リアノン先生がかわいいと思うように自由に描いて頂けますと幸いです。\n\n下記ご参考までにお願いします。\n\n■参考資料\nhttps://onl.sc/dYtYhWU\nhttps://lit.link/RinRincha\n(参考資料の掲載、本人許可済み)\n\n■使用用途\n・Xでのポスト\n・配信サムネイル　等の活動\n\n■イラストについて\n・可能であれば表情差分も付けて頂きたいです。(ウインクの有無等)\n・頭や髪がなるべく切れない構図ですと有難いです。\n・背景透過されたキャラクターのみのイラストも頂きたいので、レイヤー分けされているpsdファイルだと大変嬉しいです。\n\nご検討の程よろしくお願い致します。\n\n先日、イラストを拝見したばかりですが、先生の絵柄に強く惹かれました。\n陰ながら応援し、今後の活動を楽しみにさせて頂きます。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riannon_neko/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2525748, "client_id": 1160087, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ffbbfda/uploads/origins/8e4723d6-e30b-41dc-9c3a-4ee4df817985?bg=%23fff&auto=format%2Ccompress&fm=webp&f