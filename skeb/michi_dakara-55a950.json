36/status/1579172841949646848\nhttps://skeb.jp/@leftpory5n/works/139\nシチュエーション\nhttps://skeb.jp/@michi_dakara/works/1\nコチラの作品の様に開脚して下着をコチラに見せているシチュエーション(上は着衣有りでお願いします)\n個人的な趣味なのですが、靴を脱ぎソックスの足裏が見える感じで、表情はジト目でコチラを呆れた様な感じに見つめる感じでお願いします\n私(竿役)が頼み込んで仕方なく見せている様な感じの状況\n以上になります\nご検討お願いします", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@michi_dakara/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1131853, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c7c3c00/uploads/origins/a5949fcb-ea7a-415f-83c2-b83ec5e249e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07d246a3efdbe6ffc6a424984682d898", "srcset": "https://si.imgix.net/3c7c3c00/uploads/origins/a5949fcb-ea7a-415f-83c2-b83ec5e249e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07d246a3efdbe6ffc6a424984682d898, https://si.imgix.net/3c7c3c00/uploads/origins/a5949fcb-ea7a-415f-83c2-b83ec5e249e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40bcf0c2479902d079818447af36f557 2x, https://si.imgix.net/3c7c3c00/uploads/origins/a5949fcb-ea7a-415f-83c2-b83ec5e249e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af11c76e523071bb275ddf6d2a855b18 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c7c3c00/uploads/origins/a5949fcb-ea7a-415f-83c2-b83ec5e249e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dab5b2cce6ef87b9a26084df3322151e", "srcset": "https://si.imgix.net/3c7c3c00/uploads/origins/a5949fcb-ea7a-415f-83c2-b83ec5e249e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dab5b2cce6ef87b9a26084df3322151e, https://si.imgix.net/3c7c3c00/uploads/origins/a5949fcb-ea7a-415f-83c2-b83ec5e249e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fi