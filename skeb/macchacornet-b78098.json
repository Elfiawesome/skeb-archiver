tml\n※ 上記水着を着せていただける場合、お色はお任せでお願いします！\n\n◆ 構図\n特にこれといった指定は無いのですが、立っているところよりは\n座っている or 寝転んでいる ところの描写だとありがたいです。\n\n◆ その他お願い\nもし可能でしたら鑑賞時に宛名や町屋さまのサインが ON / OFF できるように、\n文字類を別レイヤーでいただけるとありがたいです。\n\n以上、お手すきの際にご確認いただければ幸いです！\n\nNepuX", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 896074, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "かつてサナみだったもの", "screen_name": "sanami_t_38", "avatar_url": "https://pbs.twimg.com/profile_images/1787474711850729472/Gh63Ux_b.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1577250926/1715002167/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1216281, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "津七なと", "screen_name": "natou3wari", "avatar_url": "https://pbs.twimg.com/profile_images/1951909037190295553/pTosmT-I.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1379793312492621836/1713542243/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 1472058, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🍣あっくんず🍣", "screen_name": "akkunz829", "avatar_url": "https://pbs.twimg.com/profile_images/1871023152538742784/JTm4op9J.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3236020302/1745680573/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "al