ormat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff90089a6acc87bddbb4ab91a95a168e, https://si.imgix.net/ba08e280/uploads/origins/a774de27-058e-4a47-90a6-89b76edb59d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1732ec50da8b953d7fda4a5f4495de3 2x, https://si.imgix.net/ba08e280/uploads/origins/a774de27-058e-4a47-90a6-89b76edb59d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d8ed56a9b71ea6d63174de2f15d0618 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba08e280/uploads/origins/a774de27-058e-4a47-90a6-89b76edb59d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b357c1921d91e40a800eb024f85b0d9a", "srcset": "https://si.imgix.net/ba08e280/uploads/origins/a774de27-058e-4a47-90a6-89b76edb59d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b357c1921d91e40a800eb024f85b0d9a, https://si.imgix.net/ba08e280/uploads/origins/a774de27-058e-4a47-90a6-89b76edb59d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd8f4984f114c2e28480f82591d04805 2x, https://si.imgix.net/ba08e280/uploads/origins/a774de27-058e-4a47-90a6-89b76edb59d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b858f14bae7319c1a764a404b00bdfbc 3x"}, "body": "やまのま先生こんにちは、Tinaと申します。 やまのま先生の描いた物語感溢れるイラストが大好きで、ツイッターの作品も楽しく拝見しています。\nこの度、ぜひ二人のオリジナルキャラクターの絵を描いて頂きたいと思って、 個人観賞用としてリクエストさせて頂きます。\n\n【キャラクター設定】\nキャラ１:　ロゼ\n/髪：焦げ茶色/目:茶色\n若い吟遊詩人、いろんな所を旅してバラッドを集める。愛用する楽器はリュート。\n人の世話を焼くのが好きな明るい青年。右顔にはバラの入れ墨がある\n\nキャラ２:　アデリス\n/髪:黒/目:青色　\nエルフ。 滅びた故郷を離れ、ローゼと共に旅をしている。 \n吟遊詩人としてまだ修行中、使用する楽器はリラ\n少しシャイで、落ち着いた性格。\n\nキャラクターのビジュアルはリンク内ファイルをご参考ください。\n\n【希望するシーンのイメージ】\n中世冒険風の酒場で演奏するふたり、アデリスはちょっと不慣れな感じで少し緊張気味、ロゼは楽しく演奏しながら彼に気を配っている。\nそして、夜の演奏が終わって宿屋で簡単な食事をしったり、部屋で休むふたり、ロゼは緊張したアデリスの肩をマッサージするなど\nあくまでも参考ですので、二人に合ったものを自由に描いてください。\nやまのま先生の物語を感じるような表現がとても好きで、二人の演奏風景や演奏の間の休憩時間を覗くようなシーンにしていただけたら大変嬉しいです。\n\n金額が足りない場合は、適切な金額をご提案ください。難しい場合はキャンセルしていただいても構いません。それ以外の場合は、ご検討よろしくお願いします\n\nhttps://drive.google.com/drive/folders/1Eqf1kt1RKJo8X6i-WXRa2w_8oMnn2ADi?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_sokonashi/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/de10d2db/uploads/origins/a75bdc2d-34ce-40c4-840c-d02d8d286022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27522433bc399dd3ee84ea8c6619a013", "srcset": "https://si.imgix.net/de10d2db/uploads/origins/a75bdc2d-34ce-40c4-840c-d02d8d286022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27522433bc399dd3ee84ea8c6619a013, https://si.imgix.net/de10d2db/uploads/origins/a75bdc2d-34ce-40c4-840c-d02d8d286022?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dbea58b310737b43c3f562783b5c7692 2x, https://si.imgix.net/de10d2db/uploads/origins/a75bdc2d-34ce-40c4-840c-d02d8d286022?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=865f08149ffe94c7fc21fbb4ca41a44f 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1674728, "client_id": 1227592, "nc": 16}, {"path": "/@_sokonashi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1674728, "client_id": 1641782, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/681acfb4/uploads/origins/a8dce2eb-f2ff-4627-ad92-10ea625e65a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=