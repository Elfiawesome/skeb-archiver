f27-4feb60cca384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd115d072633f27529c37f235d86b522, https://si.imgix.net/b2846c70/uploads/origins/028a856d-5d1a-4df8-bf27-4feb60cca384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3a1263f2388d9a05bd1afe00c9bd42c9 2x, https://si.imgix.net/b2846c70/uploads/origins/028a856d-5d1a-4df8-bf27-4feb60cca384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d49a74ea21a41b4c58ee72f669098673 3x"}, "body": "やまのま様、はじめまして！\nやまのま様のかわいいくてストーリーのある絵が大好きで、リクエスト募集の連絡を知り、\nよければ資料にあるうちの子たちを描いていただきたくリクエストさせていただきました！\n\n港町(スペインイタリアあたりイメージ)在住の仲良しコンビです。\n男：30歳。灯台守。マイペースだが他人に構うのが大好き。職務中も暇があれば同僚が職権乱用でよく連れてくる孫娘(少女)をよく構い、休日も同僚から要請があれば二つ返事でシッターを引き受けている。\n少女：6歳。好奇心旺盛で人見知りしない性格。両親がほぼ家にいないため、よく構ってくれる男に対し父のように懐いている。\n\nカフェで一緒にランチを食べているところ、もしくは楽しそうに散歩中のイラストだと嬉しいですが、描きたいように描いていただければ幸いです！\n髪型、服装等は描きやすいように変更してください。\n\n内容不備、お忙しい等ありましたらお気軽にキャンセルください。ご検討よろしくお願いします。\n\nhttps://drive.google.com/file/d/1em1lOZwm-pX8jratCHDFpeQiTBUOar6b/view?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_sokonashi/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1674728, "client_id": 1100793, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40087469/uploads/origins/5ebf9f69-1394-4f8a-a3ad-fd6b39d6a373?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e2876bf5e441be675f7ac2b8494e227", "srcset": "https://si.imgix.net/40087469/uploads/origins/5ebf9f69-1394-4f8a-a3ad-fd6b39d6a373?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e2876bf5e441be675f7ac2b8494e227, https://si.imgix.net/40087469/uploads/origins/5ebf9f69-1394-4f8a-a3ad-fd6b39d6a373?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edd6da56d03c9c33c407618434d4a137 2x, https://si.