お忙しい中恐縮ですが、どうかご検討頂ければ幸いです。酷暑でもありますので、どうかお体に気をつけてお過ごし下さい。金星人様のこれからの益々のご活躍を祈っております。\n\nhttps://drive.google.com/drive/folders/1QIv6q4gP2Sng_hbzA9RGywUAKyvq9LHE", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@137Q36/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/186d3d42/uploads/origins/38110fb2-e5f6-498f-8faf-c63f7af0d979?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb4bc44780ced4db8f50c9b08ab4bcf3", "srcset": "https://si.imgix.net/186d3d42/uploads/origins/38110fb2-e5f6-498f-8faf-c63f7af0d979?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb4bc44780ced4db8f50c9b08ab4bcf3, https://si.imgix.net/186d3d42/uploads/origins/38110fb2-e5f6-498f-8faf-c63f7af0d979?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2447db751d6e9ccb85b64293dbe2f13d 2x, https://si.imgix.net/186d3d42/uploads/origins/38110fb2-e5f6-498f-8faf-c63f7af0d979?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b8c752281fa05068d8e824d55363742e 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2453506, "nc": 160}, {"path": "/@137Q36/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c649b1e1/uploads/origins/696dde6b-2bbb-468f-a387-fdd542378bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb3268ca08ab449a93d95ecd4cd5a9a1", "srcset": "https://si.imgix.net/c649b1e1/uploads/origins/696dde6b-2bbb-468f-