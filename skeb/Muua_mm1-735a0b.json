容】\n・アピールでいただいた、お衣装に少しメイド感を加えた小悪魔メイドのようなお姿。\n・ポーズや構図はお任せいたします。\n※髪型の変更、角の有/無、巻きスカートの有/無についても自由に変更いただいて問題ございません！\n・表情について、お任せで2種類の表情を描いていただけると嬉しいです！\n\n【用途】\n・収益化済みyoutubeチャンネルでの使用（サムネ、配信内、動画内など）\n・ SNSでの利用 \n・ネットプリント、メンバーシップ特典（壁紙等）として利用\n※使用時は上に文字などを乗せる可能性がございます。\n※頭や体が切れるのは避けていただけますと幸いです。\n\n【納品形式】  \n・キャラと背景を分けたPSDファイルや透過PNGファイルでの納品を希望します。\n\nhttps://drive.google.com/drive/folders/1dds2gG-qFCvHZYAmpdAtYgL8UkDh4W_k?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Muua_mm1/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3530625, "client_id": 1342089, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c920da3/uploads/origins/5222ebad-8fae-4ba9-be67-26d0870758ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4f7b320dc21d96e9f93c50f541dbfd2", "srcset": "https://si.imgix.net/3c920da3/uploads/origins/5222ebad-8fae-4ba9-be67-26d0870758ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4f7b320dc21d96e9f93c50f541dbfd2, https://si.imgix.net/3c920da3/uploads/origins/5222ebad-8fae-4ba9-be67-26d0870758ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7792602c36cc3333138eeddbe464060 2x, https://si.imgix.net/3c920da3/uploads/origins/5222ebad-8fae-4ba9-be67-26d0870758ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8beb8dba2a14c2febad69a60d6972c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c920da3/uploads/origins/5222ebad-8fae-4ba9-be67-26d0870758ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66740ff4ee794e5dd833af60a120460b", "srcset": "https://si.imgix.net/3c920da3/uploads/origins/5222ebad-8fae-4ba9-be67-26d0870758ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=20