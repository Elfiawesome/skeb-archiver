7ca5b5b", "srcset": "https://si.imgix.net/3e657646/uploads/origins/73f25745-ef19-4bc6-92bd-b9b6cf315523?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95f47970f7faa0f22e0a0bc127ca5b5b, https://si.imgix.net/3e657646/uploads/origins/73f25745-ef19-4bc6-92bd-b9b6cf315523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bd6b9a6c1c4b5f1f78d6ca04bcf44cd 2x, https://si.imgix.net/3e657646/uploads/origins/73f25745-ef19-4bc6-92bd-b9b6cf315523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d118b5cec00f50f0b7a6c16d01f078e0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e657646/uploads/origins/73f25745-ef19-4bc6-92bd-b9b6cf315523?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ddc35acb2dd3ddd27c5dcecaf7f0cd67", "srcset": "https://si.imgix.net/3e657646/uploads/origins/73f25745-ef19-4bc6-92bd-b9b6cf315523?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ddc35acb2dd3ddd27c5dcecaf7f0cd67, https://si.imgix.net/3e657646/uploads/origins/73f25745-ef19-4bc6-92bd-b9b6cf315523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=31f3a8ada4d24649a461e8270aa7fcf6 2x, https://si.imgix.net/3e657646/uploads/origins/73f25745-ef19-4bc6-92bd-b9b6cf315523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b63d25c62bf8423bd69d78679ea3fdb 3x"}, "body": "初めまして。\n氷の魔女VTuberの熨斗目メナ(のしめめな)と申します。\n✤様のイラストの絵柄が好みでしたので描いて頂きたく今回リクエストの方させて頂きました。\n\n▼イラストについて\n熨斗目メナのイラストをお願いします。\n構図や衣装なども自由に書いていただけたらなと。\nサムネに使うので使いやすい構図ですと助かります！\n頭や髪の毛、手などが切れないように描いていただけると嬉しいです。\n\n▼参考資料\n立ち絵資料と、Twitter、YouTubeのリンクを添付させていただきます。\n\n・資料\nhttps://drive.google.com/drive/folders/17960Snvo57OjSAy_booEcuTde2TmMuAJ?usp=sharing\n\n・Twitter\nhttps://twitter.com/noshime_mena \n\n・YouTube\nhttps://www.youtube.com/@noshime_mena\n\n▼納品方法\n納品の際ですが可能であれば、背景、人物、サインで分けていただきたいのと透過したものもいただけますとありがたいです。\nもし可能であればPSDデータを頂けると幸いです。\n\n▼使用用途\nTwitterなどのSNSのアイコンやヘッダー\nFANBOX。\nYouTubeのサムネやED、また最近ポスター掲載や雑誌掲載などが多くなっているのでそういった配信活動にも可能であれば使用したいと思っております。\n\n使用範囲の有無を、教えて頂けると幸いです。\n\nお忙しい中だと思いますがどうぞよろしくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KOUSO_cM/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2737ae84/uploads/origins/0c7d5199-1109-49e1-8dba-4f3253f2ec38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e84a0eec9090e31c5731aa75db48549", "srcset": "https://si.imgix.net/2737ae84/uploads/origins/0c7d5199-1109-49e1-8dba-4f3253f2ec38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e84a0eec9090e31c5731aa75db48549, https://si.imgix.net/2737ae84/uploads/origins/0c7d5199-1109-49e1-8dba-4f3253f2ec38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68106f30d073853f6acd057098860b2e 2x, https://si.imgix.net/2737ae84/uploads/origins/0c7d5199-1109-49e1-8dba-4f3253f2ec38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=341dc14b17893d5991ace6918245e327 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3236270, "client_id": 3097042, "nc": 1}], "sent_works": [], "similar_creators": [{"id": 574999, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "イマ茸🍄めづお", "screen_name": "Im0_kinoko", "avatar_url": "https://pbs.twimg.com/profile_images/1743510442872651776/I_WMfyTA.png", "header_url": "https://pbs.twimg.com/profile_banners/98321404