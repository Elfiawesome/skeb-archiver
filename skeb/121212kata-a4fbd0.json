t%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dce8465b302b3d72029df62f904659bb 3x"}, "body": "ふにカタさん\nお久しぶりです、またリクエストをよろしくお願いします。\n\nキャラ:スズラン(アークナイツ)\n調べていただければ服装色々あるのでお好きなものをお選びください、タイツ等ある場合はずり下げていただくor無しにしてパンツが見える形でお願いします。\nパンツは白貴重の柄付きお子様パンツをいただければ幸いです。\n\nシチュ:いつものふにふにと絶頂おもらしをお願いします。　表情は恥ずかしそうな感じで、細かい構図はお任せします。\n可能であれば以前描かれていたエリーゼちゃんのようなパンツをめくる差分も同じします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@121212kata/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2545940, "client_id": 2050303, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dbfdc1fa/uploads/origins/ccbdc069-5190-412e-937c-8e1e942059a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a9f5471c2f0dedbe875a6658377a934", "srcset": "https://si.imgix.net/dbfdc1fa/uploads/origins/ccbdc069-5190-412e-937c-8e1e942059a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a9f5471c2f0dedbe875a6658377a934, https://si.imgix.net/dbfdc1fa/uploads/origins/ccbdc069-5190-412e-937c-8e1e942059a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4137cf19c4b8082fa539a8f22bc8f98 2x, https://si.imgix.net/dbfdc1fa/uploads/origins/ccbdc069-5190-412e-937c-8e1e942059a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6385460f96ab69bea077a29bdbbfd41f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dbfdc1fa/uploads/origins/ccbdc069-5190-412e-937c-8e1e942059a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=edb727371b7c3d66c60d540b6c1cfde7", "srcset": "https://si.imgix.net/dbfdc1fa/uploads/origins/ccbdc069-5190-412e-937c-8e1e942059a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=edb727371b7c3d66c60d540b6c1cfde7, https://si.imgix.net/dbfdc1fa/uploads/origins/ccbdc069-5190-412e-937c-8e1e942059a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ed9c0c81566cd1b6eccbb57c80729d8 2x, https://si.imgix.net/dbfdc1fa/uploads/origins/ccbdc069-5190-412e-937c-8e1e942059a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c085a5372e487233e7be16f4877e9b97 3x"}, "body": "ふにカタ様\n\nはじめまして。\n外道いろは（そとみちいろは）と申します。\n\nいつもふにカタ様のあまあまな百合を楽しみにしている者です。\n今回自分の中で我慢ができなくなってきたのでふにカタ様に私自身である外道いろはとずっと一緒にいるのが当たり前なぐらい仲良しの柚月ここあちゃんを是非描いてもらいたいと思い、リクエストさせていただきます。\n\nえっちな要素がない部分のみで配信、動画サムネイル・SNS上のPR活動等で使う可能性があるのでそれでも良ければ検討していただきたいです。\n\n構図\nパジャマ姿の二人が寝る前にあまあまな感じでじゃれている様子が見たいです。\n具体的なポーズ等は指定しません。\nふにカタ様が描きたいものを自由に描いていただければと思います。\n\n距離感近い二人の甘い空間見れるだけで満足です。\nもし、やりたい、やっていただけるというなら「どこまでやってもらっても構いません」\n差分いただけるのなら大変うれしく思います。\n\nご縁があれば幸いです。よろしくお願いします。\n納品PSD形式であれば嬉しいです。\n\n参考リンク\n外道いろは\nhttps://x.com/Sotomiti_Iroha\n柚月ここあ\nhttps://x.com/yuzuki_kokoa", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@121212kata/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2545940, "client_id": 2119944, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f7325af8/uploads/origins/4c20f406-14ab-4c3b-b280-06fccc512eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fc3c49517421cff2e651f974080fa7b", "srcset": "https://si.imgix.net/f7325af8/uploads/origins/4c20f406-14ab-4c3b-b280-06fccc512eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fc3c49517421cff2e651f974080fa7b, https://si.imgix.net/f7325af8/uploads/origins/4c20f406-14ab-4c3b-b280-06fccc512eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16d72d522f61610eca844afabce46fdb 2x, https://si.imgix.net/f7325af8/uploads/origins/4c20f406-14ab-4c3b-b280-06fccc512eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8488f37e4b080ff75e78d15fb316a4c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f7325af8/uploads/origins/4c20f406-14ab-4c3b-b280-06fccc512eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ee7138f95b2c811499a056ed652366c", "srcset": "https://si.imgix.net/f7325af8/uploads/origins/4c20f406-14ab-4c3b-b280-06fccc512eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ee7138f95b2c811499a056ed652366c, https://si.imgix.net/f7325af8/uploads/origins/4c20f406-14ab-4c3b-b280-06fccc512eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49a78a6e783879c7800cbe8a1c859298 2x, https://si.imgix.net/f7325af8/uploads/origins/4c20f406-14ab-4c3b-b280-06fccc512eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6224b5db55c43dd775884b4bfed25940 3x"}, "body": "はじめまして。\nイラストサイトを拝見し、可愛らしい絵柄に惹かれましたので依頼をさせて戴きます。\n\nキャラクター\n・黒髪おかっぱの女の子\n・服装は白の長袖ブラウスに赤の吊りスカート\n・下着は白の子供ぱんつ\n※参考画像\nhttps://skeb.jp/@yamatoooooo/works/219\n\nシチュエーション\n女の子はベッドで仰向けに寝ており、\n（https://www.pixiv.net/artworks/116410391 のユアちゃんのような感じ）\n布越しにじっくりと撫でられたりふにふにされて、履いたまま絶頂してしまう姿をお願い致します。\n描写に関してはおもらしを伴わない通常の絶頂を入れて頂き、触っている手は同年代か少し年上位の女の子でイメージして頂けると幸いです。\n\nご検討を宜しくお願い致します。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@121212kata/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2545940, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bfb649dc/uploads/origins/71ec8a5b-7c98-4440-a0d7-0b42ac7a7aa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47acae29745fcef4c594e46a8044c5a8", "srcset": "https://si.imgix.net/bfb649dc/uploads/origins/71ec8a5b-7c98-4440-a0d7-0b42ac7a7aa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop