aaaooooo000/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2147938, "client_id": 1359572, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c96e5f08/uploads/origins/f09cc12b-0ef0-4393-bbf3-02db23a6f56c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51727b1f7139cc8fc54d717ea564a584", "srcset": "https://si.imgix.net/c96e5f08/uploads/origins/f09cc12b-0ef0-4393-bbf3-02db23a6f56c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51727b1f7139cc8fc54d717ea564a584, https://si.imgix.net/c96e5f08/uploads/origins/f09cc12b-0ef0-4393-bbf3-02db23a6f56c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9809d4d0df6e6cc15e13b8dbb605cc99 2x, https://si.imgix.net/c96e5f08/uploads/origins/f09cc12b-0ef0-4393-bbf3-02db23a6f56c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ffd708e5765242afe6dda1999760326 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c96e5f08/uploads/origins/f09cc12b-0ef0-4393-bbf3-02db23a6f56c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14f2128e46ce3ababa39d7f76f4ff5a1", "srcset": "https://si.imgix.net/c96e5f08/uploads/origins/f09cc12b-0ef0-4393-bbf3-02db23a6f56c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14f2128e46ce3ababa39d7f76f4ff5a1, https://si.imgix.net/c96e5f08/uploads/origins/f09cc12b-0ef0-4393-bbf3-02db23a6f56c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6937bb9a76232ee95d2b759df60a2180 2x, https://si.imgix.net/c96e5f08/uploads/origins/f09cc12b-0ef0-4393-bbf3-02db23a6f56c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=27f19af784bd2bd3abe0f0cd40ca1921 3x"}, "body": "またまたこんにちは!前作は本当にありがとうございました！！本当に大好きです今回も修羅のアートワークをお願いしたいです！今回は風の姿です。今回もTwitterで個人的に使用させていただきます。\n\n今回は、よりアクション性の高いものを希望します。弓を引き、今にも射ようとする姿（狙いは横にしてください）で、周りに風のエフェクトをたくさんかけてください。彼の表情は落ち着いていて、集中していることが望まれます。彼は、リファレンスシートの写真にあるコンポジットボウを使用しているはずです。弓は黒で、ライトグリーン（彼のベースの髪の色と同じ）のハイライトが必要です。\n\nhttps://drive.google.com/file/d/1zG2EqhgM7Ps0SFVWfSRbHVFoYw0wxjMZ/view?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aaaaaaaooooo000/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2147938, "client_id": 1040600, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/019dcd18/uploads/origins/e543c3fb-3e79-424a-965f-d9a44498ba4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5800c0bed7a3b34b84f7a590280b3ad0", "srcset": "https://si.imgix.net/019dcd18/uploads/origins/e543c3fb-3e79-424a-965f-d9a44498ba4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5800c0bed7a3b34b84f7a590280b3ad0, https://si.imgix.net/019dcd18/uploads/origins/e543c3fb-3e79-424a-965f-d9a44498ba4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e223ea4f027472c4d1998d67f1729d6 2x, https://si.imgix.net/019dcd18/uploads/origins/e543c3fb-3e79-424a-965f-d9a44498ba4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10bc0e2cd764893054b9f4cf91acdc20 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/019dcd18/uploads/origins/e543c3fb-3e79-424a-965f-d9a44498ba4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=244a188944d843ed23b37eb326b02057", "srcset": "https://si.imgix.net/019dcd18/uploads/origins/e543c3fb-3e79-424a-965f-d9a44498ba4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=244a188944d843ed23b37eb326b02057, https://si.imgix.net/019dcd18/uploads/origins/e543c3fb-3e79-424a-965f-d9a44498ba4a?bg=%23fff&