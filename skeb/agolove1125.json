4f9c-97d0-70a4b83e9651?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69204bbd97013d2875a18a8731951fdc", "src_set": ""}, "body": "またまたこんにちは！今回で2回目のリクエストなんですが、以前あなたがしてくれたことが本当に大好きなんです！\n\n今回は、壊れた廃墟の上に立ち、邪悪な笑みを浮かべている彼の写真です！その際、彼の長い体の大部分を写して、その大きさと恐ろしさを表現してもらえるとありがたい！このアイデアに合いそうな雰囲気作りを楽しんでください、ありがとうございました！\n\n参考：https://drive.google.com/drive/folders/1s-FG7GBZ6E8S_wOts2gzIw3jJ203SM19?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@agolove1125/works/64", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 645675, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e152174c/uploads/origins/a02282a7-bdf4-4525-839d-7eb11c4396c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4c9f249bc4c97f01bb0df61496060e0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e152174c/uploads/origins/a02282a7-bdf4-4525-839d-7eb11c4396c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=456709256be171d45cb83633222afb28", "src_set": ""}, "body": "こんにちは、ドラゴンの姿でメイド服を着ている私のドラゴンの女性を描いていただけませんか？\n\nモップを持ち、後ろ足で立っている龍の姿です。表情はなく、ただ獣のような頭をしています。目には苛立ちや怒りの表情を浮かべている。無表情とはいえ、歯を見せて威嚇することもある。\n\n後ろ足で立ち、モップを使って直立を保っているはずだ。彼女は小型のドラゴンで、人間よりそれほど大きくない。メイド服には羽を通す穴が必要で、彼女に合うように改造されている。\n\n彼女の鱗は濃い赤色で幾重にも重なっており、頭頂部を覆う黒い鱗もある。\n\n他のポーズも含めて、やりたいことは何でもできます。ありがとう！\n\n主な参考資料\nhttps://skeb.jp/@t_o_illustVS/works/33\n\nhttps://imgur.com/a/7qAFtIa", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@agolove1125/works/63", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 645675, "client_id": 584710, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e0bfb83/uploads/origins/9636e18d-