l, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yumo_xx/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ceeddab7/uploads/origins/542153fe-4c36-4916-86a4-f61cb6463c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2dfa7eafe3636ad6ac80109ca590b0ed", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3273747, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yumo_xx/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6e7353a3/uploads/origins/d8bec9d1-c0b8-40a7-9f97-2f1ae95b006c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7da5ea9cd031f9cdb59a744552b415b2", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3273747, "client_id": 3638461, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yumo_xx/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3273747, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a402b42/uploads/origins/14752f76-7e2e-4b46-aacc-742a89b312f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a447bb2a0b4a39d58b9c968a1c2b18bc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a402b42/uploads/origins/14752f76-7e2e-4b46-aacc-742a89b312f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fc5edc04ca12cc4f45e77b9547bd754", "src_set": ""}, "body": "ゆも❕様\n\n初めまして、新人vtuber の迷狗ろんと申します。\nskebの作品がとても可愛くて素敵だったのでぜひゆも様にイラストを描いていただきたくリクエストさせていただきます…！\n\n◆使用用途\n•収益済みのYouTube配信\n•SNSへの投稿　　などです。\n不可な用途がありましたらリクエストのキャンセルか、別レイヤーで記載いただけますと幸いです。\nまた、Xでの投稿は不可など気をつけるべき点がございましたらそちらもご教示いただけますと幸いです。\n\n◆リクエスト内容\nお任せさせてください！\n\n可能でしたら背景レイヤーとキャラクターレイヤーを分けて頂けますと幸いです。\n配信サムネイルに使用させていただくため、\n可能であれば頭や髪の毛が切れないようしていただき、人物のみの透過画像もいただけますと幸いです。\n\n◆キャラクター\n参考資料よりご確認いただけますと幸いです。\n折れた耳の狼の女の子で、髪は紫から白のグラデーションになっております。\n描きづらい部分ありましたら、アレンジいただいて問題ございません。\n\n長文となってしまい恐縮ですが、ご検討いただけますと幸いです。\n(金額不足などありましたら再送依頼やキャンセルをしていただけますと幸いです。)\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1--lX7EjEosvE06t869r9dXKqUWsC_v4L\n\nhttps://drive.google.com/drive/folders/1--lX7EjEosvE06t869r9dXKqUWsC_v4L", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumo_xx/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d4548b88/uploads/origins/60528746-9e64-46ce-9669-2936dcd59226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36dde5c78fe34258b2c25c32c115879b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3273747, "client_id": 2788442, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yumo_xx/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3273747, "client_id": 3077197, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/028ec54f/uploads/origins/12034927-9f85-4181-b2da-1c776c1ec86e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a3262b1887c96b6822a7a0e8a76e5f2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/028ec54f/uploads/origins/12034927-9f85-4181-b2da-1c776c1ec86e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3af950a8dfb29769804e81894a5a69f", "src_set": ""}, "body": "はじめまして、yumo_xxさん。船長のイラストがとても気に入ったので、リクエストさせていただくことにしました。\n\nリクエストのガイドラインがよく分からなかったので、シンプルにお願いすることにしました。\n\n水着衣装の船長のイラストをお願いしたいです。\n\n細かい指定は、顔の上でメガネを調整したり触ったりしているところだけです\n\nyumo_xxさんの芸術的なセンスを完全に信頼しています\n\nありがとうございます🙏 \n\n Nice to meet you yumo_xx, I really liked your illustrations of Senchou and decided to request one.  \n\nI’m not really sure what your guidelines are for a request so I decided to keep it simple. \n\nI would like to request an illustration of Senchou in her summer costume\n\nThe only detail I’d like included is her adjusting or touching her glasses\n\nI fully trust your artistic judgment  \n\nThank you 🙏", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1732700, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "甘茶", "screen_name": "mattya0495", "avatar_url": "https://pbs.twimg.com/profile_images/1591957351908655104/yJ9vy0tK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1371083190660567046/1653404733/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "skills": [{"genre": "art"}], "nc": 144}, {"id": 2096207, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "moduku", "screen_name": "m_oduku", "avatar_url": "htt