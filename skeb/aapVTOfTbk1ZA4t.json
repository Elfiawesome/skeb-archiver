t/e49d7a76/uploads/origins/f5ebaa98-616e-4c15-b486-98df870ad760?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a4ed2cac70ff0d31789687b266fe56a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e49d7a76/uploads/origins/f5ebaa98-616e-4c15-b486-98df870ad760?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3285e93ae673dacde0f440011193093b", "src_set": ""}, "body": "ゲゲゲの謎\n時貞×沙代\n線画\n1ページ漫画風\n\nhttps://www.kitaro-tanjo.com/\n\n右側沙代立絵(爆乳)\n「御爺様。今宵も沙代の肉壺便器、御存分にお遊び召されませ。」\n\n左側\n髪を手綱のように引っ張られながらお馬さん交尾。\n母乳イキ小便噴射\n手形歯型だらけ\n「哭け啼けｯ！また産ませたるからのォ！イケやｯ沙代ｯｯ！！」\n「ぷぎぃぃぃ💢おっぎょォぉ゙ォ゙ｯ！？💢イギますｯ💢孫便器イギますｩｩｯ💢💢💢」\n\n左下側\n沙代顔面アップ\n目ガン開き\n顔に大便のりながら舌突き上げて荒い呼吸\n小便かけられてる\n「御不浄ありがとうございます…くっさ……本日も美味しゅうございます…」", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aapVTOfTbk1ZA4t/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 113268, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f7cf347/uploads/origins/8028514c-1797-4845-91aa-598b593d397a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f2dc99684cb485b99d17cb81b1a5ef3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f7cf347/uploads/origins/8028514c-1797-4845-91aa-598b593d397a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3906cfa4111e1b19a1d2eb50d75b9eef", "src_set": ""}, "body": "放課後ていぼう日誌\n大野先輩\n線画\n\nキャライメージ\nメガネの人・エプロン抜き、制服でお願いします。\nhttps://x.com/teibo_bu/status/1335524023099265026?t=fzqUhm53VBvEfNzwH_VKtQ&s=19\n\n体型イメージ\nhttps://x.com/aapVTOfTbk1ZA4t/status/1907399237035593935?t=R86LtaESGu2qj5tygwXf-A&s=19　\n\n全身立絵\n股下に糞が溜まったバケツ(盥でも可)があり、長糞を垂れている。\n足元にバケツ(盥)が他に２つあり、同じく糞盛り\n母乳小便噴射。\n「撒き餌の準備できました」\n\n差分\n胸元に糞載せ\n口を大きく開け舌伸ばし、口内に糞がチラ見え\n頬にバーコード\n頬に張り手型\n「餌の補充ありがとうございます。本日も漁協便器のご利用ありがとうございます。またいつでもウンコ吸わせて頂きます。」", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aapVTOfTbk1ZA4t/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/29d747ce/uploads/origins/0fa115a0-7cc3-4e29-8d60-5593c4d53ff2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d8f515d170d83dffdc95d2bf3899dd9", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 113268, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@aapVTOfTbk1ZA4t/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1ffa0fae/uploads/origins/3f109053-38c3-43cf-84ca-84ad5651cda5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c69a9e98ad76b605ca9e10ccd6bf84b2", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 113268, "client_id": 2975538, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 35, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@aapVTOfTbk1ZA4t/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 113268, "client_id": 43940, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/285408ef/uploads/origins/6f3b411b-67fd-4b10-a942-b8748dd8bd7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9368755866a34164294138452ed1b