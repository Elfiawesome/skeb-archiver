age", "creator_acceptable_same_genre": true}, {"path": "/@Joey/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 775901, "client_id": 1613995, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4c76250/uploads/origins/0d81f161-ac9b-4877-9018-8ddda00eb413?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd831212d9f1ebba8f20cc844b629634", "srcset": "https://si.imgix.net/e4c76250/uploads/origins/0d81f161-ac9b-4877-9018-8ddda00eb413?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd831212d9f1ebba8f20cc844b629634, https://si.imgix.net/e4c76250/uploads/origins/0d81f161-ac9b-4877-9018-8ddda00eb413?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d34be5649a534dd40ef657331fad846 2x, https://si.imgix.net/e4c76250/uploads/origins/0d81f161-ac9b-4877-9018-8ddda00eb413?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7d08e07d458891b35825ae8fc50158b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4c76250/uploads/origins/0d81f161-ac9b-4877-9018-8ddda00eb413?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6288c42d3ba1902238c011b7ff8df8bc", "srcset": "https://si.imgix.net/e4c76250/uploads/origins/0d81f161-ac9b-4877-9018-8ddda00eb413?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6288c42d3ba1902238c011b7ff8df8bc, https://si.imgix.net/e4c76250/uploads/origins/0d81f161-ac9b-4877-9018-8ddda00eb413?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fc911e7c50429a42a6eae7109ec7ff87 2x, https://si.imgix.net/e4c76250/uploads/origins/0d81f161-ac9b-4877-9018-8ddda00eb413?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=383425f95149cecfe1059a4655b02527 3x"}, "body": "こんにちは！あなたの流れるようにエレガントなイラストが大好きです！(特に脚の描き方に憧れているので、全身が描ける作品だと嬉しいです！)\n\n元モデルで、現在はファッション業界で働くキャリアウーマン。あまり深刻に考えすぎず、気楽でおバカな性格だが、欲しいものやそれを手に入れる方法はストレート。テーマは夏と太陽。\n\nフェイク雑誌の表紙などでも面白そうですが、量に合わせて自由に描いてください！もしこの依頼に問題があれば、遠慮なくキャンセルしてください。ご検討よろしくお願いします\n\nhttps://drive.google.com/drive/folders/1V-4iloIPsaoZYwB4xRUdFCHRGKt_mQSa?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Joey/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 775901, "client_id": 2384758, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e92fc79/uploads/origins/3f1f5201-1452-49b6-b656-55e3753fafbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f179b475b4b6f28e6e8511e8b7969cf", "srcset": "https://si.imgix.net/9e92fc79/uploads/origins/3f1f5201-1452-49b6-b656-55e3753fafbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f179b475b4b6f28e6e8511e8b7969cf, https://si.imgix.net/9e92fc79/uploads/origins/3f1f5201-1452-49b6-b656-55e3753fafbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25c41d18ac7b8ffbc219749198a05430 2x, https://si.imgix.net/9e92fc79/uploads/origins/3f1f5201-1452-49b6-b656-55e3753fafbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02e1221934463bc1c6df010838acaac0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e92fc79/uploads/origins/3f1f5201-1452-49b6-b656-55e3753fafbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c9c41198c8ff5368b5d425996ea2330", "srcset": "https://si.imgix.net/9e92fc79/uploads/origins/3f1f5201-1452-49b6-b656-55e3753fafbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c9c41198c8ff5368b5d425996ea2330, https://si.imgix.net/9e92fc79/uploads/origins/3f1f5201-1452-49b6-b656-55e3753fafbb?bg=%23fff&au