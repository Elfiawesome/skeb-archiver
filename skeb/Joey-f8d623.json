45479b297659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47df33f495718e10a42ec025cd6ed264 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b6a720c/uploads/origins/70129f84-73fb-46f3-b28c-45479b297659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c8700ca815b1ace0996578b179b7fef", "srcset": "https://si.imgix.net/0b6a720c/uploads/origins/70129f84-73fb-46f3-b28c-45479b297659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c8700ca815b1ace0996578b179b7fef, https://si.imgix.net/0b6a720c/uploads/origins/70129f84-73fb-46f3-b28c-45479b297659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e286b712e8582d8178ce78d1c06fe811 2x, https://si.imgix.net/0b6a720c/uploads/origins/70129f84-73fb-46f3-b28c-45479b297659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6dcf128fa3754a976cc020b0318481f 3x"}, "body": "ジョーイさん、こんにちは！あなたの作品がとても好きです！\n私の2人のOCの全身イラストをお願いしたいです。もしキャラクターのコスチュームが見にくかったり、描きにくかったりする場合は、簡略化してもいいですし、自由に変えてもらってもかまいません。\nhttps://imgur.com/a/oElnu3l\nhttps://imgur.com/a/wDKcd3b\n\n白髪：一番上（黒目、180cm）。クールでやや寂しがり屋、自由を愛する。高い戦闘能力を持つ武道家。双剣を武器とし、戦いを楽しむ。\n青髪：下（ライトグレーの瞳、179cm）。温厚で上品な性格。理想主義者。高い戦術能力を持つ軍事顧問。\n\n二人の馴れ初め\n1.1.互いをよく理解し、尊敬の念を抱いているが、もっと親しくなりたいと思っている。\n2.無意識のうちにお互いを身近に感じ、同じ目標に向かって努力する姿を見るのが好きだ。\n\nできれば二人が肩を並べて戦う姿を見てみたい。描きにくいところがあれば、どんなアクションでも構いません。\nありがとうございました！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Joey/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 775901, "client_id": 1079314, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d3b5a8c/uploads/origins/288f9f4e-c670-4c04-96ac-964dab1bea07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b6fdabd8bad