8bbe-2c2f31a251df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c63f22154580e11cdee287055f3fda5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6636b79/uploads/origins/d59ce9bf-d4de-4099-8bbe-2c2f31a251df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a86ec56dd10bb88e69db13241f376bae", "src_set": ""}, "body": "こんにちは！初めてこのサイトを使うので、うまく訳せているといいのですが。\n\n私はあなたに作品をお願いしたいと思っています！私のOCの名前はCynderで、魔人です！彼女は粘り強くて、自信に満ち、決意の固い戦士で、身体を操る能力を武器や防御の構築物、風景を忍び寄らせる道具として活用する。特にブレードアームと有機物を丸ごとコピーする能力が特徴的だ。高いセックスアピールを持つが、社会的活動よりも仕事に関心がある。\n\nポージングは問題ないだろう。描く衣装はレオタードに黒いスカート＋レギンス＋ブーツ。ブレードアームがあり、魔人の牙が見えれば、絵の自由と完成度はお任せします。ありがとうございました！:D <333\n\nhttps://drive.google.com/drive/folders/16klHu-kCMb4VbsGNOjamoLX-qHoqk-x0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@d_norainu_b/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2731743, "client_id": 3326287, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65972565/uploads/origins/323e70dc-c44d-4bef-821a-e92352579b52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0005aee807a048df8ca8bb9ca2329da8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65972565/uploads/origins/323e70dc-c44d-4bef-821a-e92352579b52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=106804cb5efeed250d31cd9a190a540b", "src_set": ""}, "body": "こんにちは！あなたのアートワークはとても素晴らしい！私のキャラクターを描いてもらえませんか？彼女の名前はズル！彼女は魔人ブウにとても似ているけど、彼とは関係ない。\n\nおバカで、元気で、かわいくて、ちょっと魅惑的。好きなようにポーズをとっていいよ！サメのような鋭い歯を見せて微笑んでほしい。\n\nありがとうございました！🙇‍♀️\n\nhttps://drive.google.com/drive/folders/1e-9y8Uz3WxWazSq5zPDUkgBJAx0djR17", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_s