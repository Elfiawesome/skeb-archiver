。\nその他のポーズや細かい構図、背景などはお任せさせていただきます。\n\n・百合イラストなので全体的に百合な雰囲気が出ていると嬉しいです！（抽象的な指示ですみません）\n・キャラクターの容姿は公式サイトにありますので、ご参考ください。\nhttps://virgin-road.com/chara/\n※今回依頼するイラストは多くの方に見ていただきたいので、TwitterやPixivなどでSAMPLE表記無しで全体イラストを公開していただけると嬉しいです。\nよろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ryo_tsuzura/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1810590, "client_id": 59890, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbb36a63/uploads/origins/2082cce6-4df1-4938-9d52-921d4e67cecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeaa36eef591924d236cf6fdde9c459f", "srcset": "https://si.imgix.net/cbb36a63/uploads/origins/2082cce6-4df1-4938-9d52-921d4e67cecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeaa36eef591924d236cf6fdde9c459f, https://si.imgix.net/cbb36a63/uploads/origins/2082cce6-4df1-4938-9d52-921d4e67cecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48c879a1df4c43dc2ae71e8644b5f696 2x, https://si.imgix.net/cbb36a63/uploads/origins/2082cce6-4df1-4938-9d52-921d4e67cecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5177bd6b5d73eeea75108762a5931c4e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbb36a63/uploads/origins/2082cce6-4df1-4938-9d52-921d4e67cecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45aa6c9f45ecea30ac2253589e587832", "srcset": "https://si.imgix.net/cbb36a63/uploads/origins/2082cce6-4df1-4938-9d52-921d4e67cecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45aa6c9f45ecea30ac2253589e587832, https://si.imgix.net/cbb36a63/uploads/origins/2082cce6-4df1-4938-9d52-921d4e67cecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&