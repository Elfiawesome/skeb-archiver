t=crop&crop=top&w=200&h=200&s=76d3009d22689e14a30aa8e16c422213 2x, https://si.imgix.net/8bbdb7e5/uploads/origins/5c94e54b-056a-4595-8dfb-e9b5ae83ae51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55cd61eba4440a7fb9c15069aaa476ec 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8bbdb7e5/uploads/origins/5c94e54b-056a-4595-8dfb-e9b5ae83ae51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29f2835fd3d5f13c1fb160d32059320c", "srcset": "https://si.imgix.net/8bbdb7e5/uploads/origins/5c94e54b-056a-4595-8dfb-e9b5ae83ae51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29f2835fd3d5f13c1fb160d32059320c, https://si.imgix.net/8bbdb7e5/uploads/origins/5c94e54b-056a-4595-8dfb-e9b5ae83ae51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6cbff065dde7aee30883c3a1c10561a2 2x, https://si.imgix.net/8bbdb7e5/uploads/origins/5c94e54b-056a-4595-8dfb-e9b5ae83ae51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f26aca2fc254728edfda82e74fb7c34 3x"}, "body": "小渕先生、はじめまして！\n色使いと絵柄の世界観が美しく、ぜひTRPGで使用したキャラクターの一枚絵を描いていただきたくてご連絡させていただきました。\n詳細を以下にまとめます。\nお手数をおかけしますが、ご一読いただければ嬉しいです。\n\n\n■キャラクターふたり（二人とも15歳です）\n□ノウゼン\nスミレノの方くらいまでの身長。ちっちゃいです。\nオレンジ色のクルクルの髪の毛、そばかす塗れの顔。赤面症。\nスミレノをきれいだと思って、自分の顔はあまり見せたくないため布で顔半分をほとんどいつも覆っています。すぐお顔が赤くなる、恥ずかしがり屋の男の子です。ギザ歯。\n黒い腹掛、黒股引、腰のところに袖を通さない着物をまとめています。\nスミレノによくお花をもっていっています。\n\n□スミレノ\n蝶よ花よと育てられ、美しい見目をしている。\n毛先にかけてのウェーブがつよい、藍色みが強い髪型の男の子です。\n背が高く、表情はどことなく陶器の人形のような趣があります。\n基本的に表情を動かすことはないのですが、やわらかに目元で笑ってくれる子です。\n\n襟と帯のみ黄色をつかった藍色の着物を着用しています。\n（※今回資料内にあるレースは不要です。。。！）\n\n【備考】\nスミレノは別の方が作成したキャラクターですが、依頼にあたり使用許可をいただいております。\n\n\n\n■補足\n・設定を網羅されずとも問題は全くありません、\n　スミレノくんを美しく描いていただければ嬉しいです…！\n\n■使用用途\n・個人観賞用（同じTRPGを遊んでくださった方と鑑賞させていただきたいです\n・可能であれば、個人用のグッズ使用も許可をいただけるとうれしいです。。\n\n長くなってしまい恐縮ですが、何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1FoTpD8pluy0G6pGd51B3vl4OJNYX37y4?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pyouko_Tobuchiy/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2449685, "client_id": 3872124, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f47efb19/uploads/origins/fb65e353-1a6d-4c54-932a-d4f340ab0427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f9fe1ec0e5df03412b83a9a5fc0e9b3", "srcset": "https://si.imgix.net/f47efb19/uploads/origins/fb65e353-1a6d-4c54-932a-d4f340ab0427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f9fe1ec0e5df03412b83a9a5fc0e9b3, https://si.imgix.net/f47efb19/uploads/origins/fb65e353-1a6d-4c54-932a-d4f340ab0427?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=176f600f3a8e3ffe02c1cebc754b8e2b 2x, https://si.imgix.net/f47efb19/uploads/origins/fb65e353-1a6d-4c54-932a-d4f340ab0427?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df65779ca35daa1ebab939bb41e593b1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f47efb19/uploads/origins/fb65e353-1a6d-4c54-932a-d4f340ab0427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=daace51b330a954e7febaf664dc01389", "srcset": "https://si.imgix.net/f47efb19/uploads/origins/fb65e353-1a6d-4c54-932a-d4f340ab0427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=daace51b330a954e7febaf664dc01389, https://si.imgix.net/f47efb19/uploads/origins/fb65e353-1a6d-4c54-932a-d4f340ab0427?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f79e9285207ad90b823f6714bd1a80e7 2x, https://si.imgix.net/f47efb19/uploads/origins/fb65e353-1a6d-4c54-932a-d4f340ab0427?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=efdffcb200734308961218b0028d3885 3x"}, "body": "ちょぶさんこんにちは。\nBlueskyで育児について話しているアカウントのアイコンに使うイラストを描いて頂きたいです。\n\n以下詳細となります。\n\n▼描いてほしいもの\n3歳くらいの子どもor子どもを見ている母親\n子どもや母親の姿は想像で構いません。子どもの性別も問いません。\n背景を描いていただけるのであれば公園や室内など、日常の延長線上にある場所だと嬉しいです。\nおもちゃ・お花・後ろ姿など、構図やモチーフはお任せします。\n\n▼使用用途\n個人のBlueskyアカウントのアイコン\n\n▼イラストに求めるタッチ等\n白黒や切ない情景以外でしたら、描きやすい雰囲気でご自由になさってください。ちょぶさんの絵柄であればなんでも大好きです！\n\n以上、よろしくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pyouko_Tobuchiy/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2449685, "client_id": 3563907, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92a03513/uploads/origins/933e8628-9c43-4beb-bbde-f403ed7dcd93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e23d70a07d86a950dd1f6b16de0b8e9b", "srcset": "https://si.imgix.net/92a03513/uploads/origins/933e8628-9c43-4beb-bbde-f403ed7dcd93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e23d70a07d86a950dd1f6b16de0b8e9b, https://si.imgix.net/92a03513/uploads/origins/933e8628-9c43-4beb-bbde-f403ed7dcd93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f31d2e554d2c5228064caa7666b97bb 2x, https://si.imgix.net/92a03513/uploads/origins/933e8628-9c43-4beb-bbde-f403ed7dcd93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b07b5a9c5efd51e2ab2483d984f2f46c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92a03513/uploads/origins/933e8628-9c43-4beb-bbde-f403ed7dcd93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b0642f36944fff8e9c1caa424098d35", "srcset": "https://si.imgix.net/92a03513/uploads/origins/933e8628-9c43-4beb-bbde-f403ed7dcd93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b0642f36944fff8e9c1caa424098d35, https://si.imgix.net/92a03513/uploads/origins/933e8628-9c43-4beb-bbde-f403ed7dcd93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=33586396fe7616c88897902ad017a0ca 2x, https://si.imgix.net/92a03513/uploads/origins/933e8628-9c43-4beb-bbde-f403ed7dcd93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=54bd7163827309e93f178586a68f9e7a 3x"}, "body": "ちょぶさん、こんにちは。\n当方のオリジナルキャラクターのイラストを描いていただきたく、ご連絡いたしました。\n以下にキャラクターの紹介と、互いへの印象をまとめておりますので、参考程度にご覧いただければ幸いです。\n\n▼キャラクター紹介\n●エイナル\n資料：https://x.com/miizu_mii/status/1953954376260657171?s=20\n\n■人物像  \n・真面目だが、その分融通が利きにくいタイプ。\n・自身の不幸体質については「生きる力が不幸に勝っていれば問題ない」とあまり気にしていない。\n・愛情深く嫉妬深い。物より人に依存する傾向があり、「誰かに必要とされること」が生きがい。\n\n■エイナルから見た二コレッタ  \n・実力も幸運も備えているのに、変なところで真面目で小心者なのが勿体ないと思っている（もっと堂々としていれば良いのに、という気持ち）。\n・人を信用しすぎて騙されやすいところが心配。\n・「俺が守ってやらなきゃ（呆れ）」と思うときと、「命に代えても守らなきゃ（真剣）」と思うときがある。\n・もし彼女の腕の中で死ぬようなことがあれば、最期の言葉は「泣くな！笑って生きろ！」が良い。\n\n\n●二コレッタ\n資料：https://x.com/gy0za/status/1953580662432141395?s=20\n\n■人物像  \n・超豪運の持ち主だが、寂しがりで少し怯えがちな子。\n・幼い頃から幸運に恵まれ、努力以上の結果が出てしまうことで周囲から疎まれた経験があり、そこから少し怯えがちになった。\n・愛情深いが、一つに執着しすぎないタイプ。\n・「選択肢がある限り楽しみたい」「死ぬほど向いていないことをやり続けたい」という価値観を持つ。\n\n■二コレッタから見たエイナル  \n・ニコのボディーガード的存在。\n・超不運ゆえに、時々とんでもなく卑屈になる（よく頭にシクシク😢シクラメンが咲いているように見える）。\n・お兄ちゃんのような人で、過保護すぎるほど気にかけてくれる。たまにうざい。\n・現在は学校などの送り迎えもついてきてくれており、道中で学校の話をする。\n・気になっている人の相談をしたところ、「俺より強い人じゃないとだめ」と言われ、ドン引きした。 \n・もし彼の腕の中で死ぬようなことがあれば、最期の言葉は「あたしの人生に謝らないで！全部楽しかった！エイナル大好きよ！」が良いです。\n\n▼衣装について\n・設定に忠実である必要はありません。アレンジ、完全オリジナル衣装など、自由に描いていただいて構いません。\n\n▼補足\n・当方の創作設定をすべて網羅していただく必要はありません。\n　ちょぶさんのご存じの範囲で、気楽に描いていただければ嬉しいです。\n\n▼使用用途\n・個人観賞用\n\n▼タッチについて\n・特に指定はありません。\n　ちょぶさんの絵が大好きなので、心のままに自由に描いていただければ幸いです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pyouko_Tobuchiy/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2449685, "client_id":