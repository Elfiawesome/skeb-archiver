fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=245938724c495f761fe9568e0c91676b 3x"}, "body": "こんにちは、\n\nチャンネルのプロフィール写真用のキャラクターイラストの概念を共有します。\n\n性別：男性\n髪色：白\n目の色：紫\nキャラクターは現在のスタイルからの進化を希望しており、特に「幸せで明るい」表情が望まれます。具体的な変更はアーティストの解釈に委ねます。\n\n性格：楽観的で明るい\n背景：異世界転生、宇宙探検、カワイイものへの愛着\nキャラクターの主なミッションは、新しい世界を探索し、その発見をフォロワーと共有することです。その過程で、常に幸せで明るい姿を示してください。\n\nどうぞよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fi/sozmoo159asrk7ocxyv6b/seijin_moodboard.png?rlkey=42jel3rx9wf4uhjgg13x9cs44&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pokauno/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2923062, "client_id": 3159365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ac1ad38/uploads/origins/1c2418bf-5c8d-472b-8cf5-240aa7437521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e05d85a07709b5ae4ae0ce1e882cc9d8", "srcset": "https://si.imgix.net/2ac1ad38/uploads/origins/1c2418bf-5c8d-472b-8cf5-240aa7437521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e05d85a07709b5ae4ae0ce1e882cc9d8, https://si.imgix.net/2ac1ad38/uploads/origins/1c2418bf-5c8d-472b-8cf5-240aa7437521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68531ddda0b69021cfeb4e411b396ea8 2x, https://si.imgix.net/2ac1ad38/uploads/origins/1c2418bf-5c8d-472b-8cf5-240aa7437521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d1e63fb31f22346762f68d195d06aa0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ac1ad38/uploads/origins/1c2418bf-5c8d-472b-8cf5-240aa7437521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f4fa738f764176d662d61743b29fae0", "srcset": "https://si.imgix.net/2ac1ad38/uploads/origins/1c2418bf-5c8d-472b-8cf5-240aa7437521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f4fa738f764176d662d61743b29fae0, https://si.imgix.net/2ac1ad38/uploads/origins/1c2418bf-5c8d-472b-8cf5-240aa7437521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=efcfeb17141a930cda63910637b221a7 2x, https://si.imgix.net/2ac1ad38/uploads/origins/1c2418bf-5c8d-472b-8cf5-240aa7437521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd8b605a2fe5a1c557a3d25b58e9701a 3x"}, "body": "こんにちは！\n\nチャンネルのプロフィール画像を更新したい\n\n現在使用しているプロフィール画像のURLをお知らせします。\n私はあなたにいくつかの一般的な情報を提供し、多分あなたはいくつかのアイデアを得るためにそれを使用することができます。\n\n私のチャンネルのコンテンツはエンターテイメントです。ストーリーテリング、テクノロジー、楽しい事実、そして多分ニュース。\n\n可能であれば、プロフィール写真は \"面白い \"ものにしたいです。\n\nこのメッセージの書き方が悪かったらごめんなさい。\nありがとう。\n\nhttps://www.dropbox.com/scl/fi/jnxv195rrumb7cf6iek89/profile_picture.jpg?rlkey=glon49j51ssxz7qzedwj7vezm&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pokauno/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2923062, "client_id": 3034907, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b40cbfa/uploads/origins/e177c78d-2bca-429c-84d5-7bb309f2f8f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b08cab6356c23066b7196f89d4423a2", "srcset": "https://si.imgix.net/2b40cbfa/uploads/origins/e177c78d-2bca-429c-84d5-7bb309f2f8f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b08cab6356c23066b7196f89d4423a2, https://si.imgix.net/2b40cbfa/uploads/origins/e177c78d-2bca-429c-84d5-7bb309f2f8f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b11389f308ab9fff760ac759c080cd48 2x, https://si.imgix.net/2b40cbfa/uploads/origins/e177c78d-2bca-429c-84d5-7bb309f2f8f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64cc098b25b900a5d815c49478be318f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b40cbfa/uploads/origins/e177c78d-2bca-429c-84d5-7bb309f2f8f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89ab2bf72e97d3dae7f3e5377e3a4ea1", "srcset": "https://si.imgix.net/2b40cbfa/uploads/origins/e177c78d-2bca-429c-84d5-7bb309f2f8f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89ab2bf72e97d3dae7f3e5377e3a4ea1, https://si.imgix.net/2b40cbfa/uploads/origins/e177c78d-2bca-429c-84d5-7bb309f2f8f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=109838ccf77c1a8aeb8be7920d68e926 2x, https://si.imgix.net/2b40cbfa/uploads/origins/e177c78d-2bca-429c-84d5-7bb309f2f8f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=337e92aaa70fbe7f6c5b3881431ee8d3 3x"}, "body": "はなまるぽちこ 様\n\n初めまして、燐寸棒マッチと申します。\nskebをさまよっておりましたらぽちこさんのフォームを見つけ、反射的にリクエスト送信しております。\nいつもぽちこさんの発色はしっかりしているのにふわりとした絵柄に癒されております\n\n本題なのですが、私の擬人化イラストをぽちこさんのイラストで描いていただきたく\nリクエストお送りいたします。\n当方、Youtubeなどの配信媒体で\n「マッチ棒系Vtuber」としてマッチ棒の体で配信をしております。\n（詳しくは添付URLの資料動画などをご確認ください）\n\nその中で、「マッチの人間形態は見ている人それぞれの心の中に」という考えがありまして\nよろしければ\n・参考資料のマッチの声や動き\n・マッチ棒というモチーフ\nというテーマのもと、もちもち様の思う燐寸棒マッチ擬人化イラストを描いていただけないでしょうか？\n\nまた、描いていただいたイラストをぽちこさんのTwitterID（@pokauno）と併せて\nTwitterへ投稿したいのですが、よろしいでしょうか？\n\n情報が薄く、面倒な依頼となり恐縮ですが\n願わくばご一考いただけますと幸いです。\n\n\n最近イラストレーターさんをお金で殴るとイラストを描いてもらえると知ってしまったマッチ棒より\n\nhttps://youtube.com/live/YM20M4xtHPg?feature=share", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 638090, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "とんとろ(Tontoro)", "screen_name": "tntr_art", "avatar_url": "https://pbs.twimg.com/profile_images/1742086914457661441/iKlmG8jG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1136089143010680832/1706703972/1500x500", "appeal_