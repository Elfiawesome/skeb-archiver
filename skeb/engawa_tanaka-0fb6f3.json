ます。\nルビーは優しい微笑みを浮かべ、まぶたを少し柔らかくして、とても満足そうな表情をします。\nジャクリーンは口を開けて微笑み、少し牙を見せている。\n\n衣装について：\n細かいことですが、お揃いのネックレスが見えるようにしたいです。\nジャクリーヌは全身が写っている衣装を着ていて、上着はゆったりしている。\nルビーには真紅のレースがあしらわれた絹のような黒のナイトガウンを着てほしい。できれば花柄があれば完璧だ！\nルビーも耳に鈴をつける。\nどちらも裸足で。\n\nできれば、キャラクターと背景を別々のレイヤーにしてもらってもいいですか？\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1-Xd7bQykWX3pV4UVD2LSScy_YDiNEWn9?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@engawa_tanaka/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1130823, "client_id": 2801467, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0142567/uploads/origins/c4e32103-aec2-4f88-9672-bd003b4fbda3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=227a12f69587ae22ae714f92a45abd16", "srcset": "https://si.imgix.net/e0142567/uploads/origins/c4e32103-aec2-4f88-9672-bd003b4fbda3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=227a12f69587ae22ae714f92a45abd16, https://si.imgix.net/e0142567/uploads/origins/c4e32103-aec2-4f88-9672-bd003b4fbda3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=158edf301866c2a21b28eba19a926a69 2x, https://si.imgix.net/e0142567/uploads/origins/c4e32103-aec2-4f88-9672-bd003b4fbda3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1118c4c730451872067a9972342a7948 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0142567/uploads/origins/c4e32103-aec2-4f88-9672-bd003b4fbda3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62f6d7bbf4a6e04b732b5b37136ebfe2", "srcset": "https://si.imgix.net/e0142567/uploads/origins/c4e32103-aec2-4f88-9672-bd003b4fbda3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62f6d7bbf4a6e04b732b5b37136ebfe2, https://si