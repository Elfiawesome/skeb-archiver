ター】\n優しくて強い九尾の狐のお姉さん。30歳くらい。脳内はドスケベだが、困ってる人に手をさしのべるみんなのヒーロー。\n\n【シチュエーション】\n梅千代さんとおなじような、夏の海で和風ビキニを着ている。迷子の子供であるこちらに向かって、笑顔で手をさしのべるイラスト。\n少しかがんで（腰やへその表現もすごく良かったので、胸で隠れないくらいでお願いしたいです。）固定ポストのニュイさんのような少し細めた目付きでやさしくにっこりと微笑みながらこちらを見つめ、「もう泣かなくてよいぞ…どうしたのじゃ…？」といったようなことをやさしく語りかけてくるような感じでお願いしたいです。\nすごくすごく可愛いケモノさんを描いてらしたので、自分のこも描いてほしいと思いました。もし受けていただけたらとってもすごく嬉しいです。\n\nhttps://drive.google.com/drive/folders/1-ChIwKYzsW44l5h7mx61Kok-CAlrHeOb", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@engawa_tanaka/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1130823, "client_id": 3395209, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad03b49c/uploads/origins/cf36dd56-2e3e-41b0-a7b2-9e8d22a81eec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e79ae0197ba8d07f4fb8771d6112d41d", "srcset": "https://si.imgix.net/ad03b49c/uploads/origins/cf36dd56-2e3e-41b0-a7b2-9e8d22a81eec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e79ae0197ba8d07f4fb8771d6112d41d, https://si.imgix.net/ad03b49c/uploads/origins/cf36dd56-2e3e-41b0-a7b2-9e8d22a81eec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f0f3444f0c464ac4561cd33d28088ec 2x, https://si.imgix.net/ad03b49c/uploads/origins/cf36dd56-2e3e-41b0-a7b2-9e8d22a81eec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88118494484c0c13761f2b4b65e0fb9e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad03b49c/uploads/origins/cf36dd56-2e3e-41b0-a7b2-9e8d22a81eec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71ee124ef1e00bcc18a59eda4147e560", "srcset": "https://si.imgix.net/ad03b49c/uploads/origins/cf36dd56-2e3e-41b0-a7b2-9e8d22a81eec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blu