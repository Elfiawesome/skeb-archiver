物理的・精神的両方）を排除する。\nリラの脳内に直接語りかけ指示や助言を送ることができる。\n「もし自分が壊れたら種族が絶滅する」という極限の使命感を抱えているため異常なまでに過保護。\n\n構図や表情など指定ない為、先生の好きなように描いて頂けましたら幸いです！\n\nご縁がありましたらよろしくお願い致します！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nns_irh2/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3320030, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/04f5246d/uploads/origins/226265e5-36c9-4eca-b1a5-c412a259eaa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7ecdd190d0cb2aff5ae557131edfecb", "srcset": "https://si.imgix.net/04f5246d/uploads/origins/226265e5-36c9-4eca-b1a5-c412a259eaa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7ecdd190d0cb2aff5ae557131edfecb, https://si.imgix.net/04f5246d/uploads/origins/226265e5-36c9-4eca-b1a5-c412a259eaa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40587bb7c6cb714b64f80ee420655161 2x, https://si.imgix.net/04f5246d/uploads/origins/226265e5-36c9-4eca-b1a5-c412a259eaa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd819e93596447a10d720f0df49f2978 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04f5246d/uploads/origins/226265e5-36c9-4eca-b1a5-c412a259eaa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a27b905103ebfda0a95f1fe7afeaeb03", "srcset": "https://si.imgix.net/04f5246d/uploads/origins/226265e5-36c9-4eca-b1a5-c412a259eaa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a27b905103ebfda0a95f1fe7afeaeb03, https://si.imgix.net/04f5246d/uploads/origins/226265e5-36c9-4eca-b1a5-c412a259eaa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7f1dfe6eff2ab9d55b2b68039f24d4d0 2x, https://si.imgix.net/04f5246d/uploads/origins/226265e5