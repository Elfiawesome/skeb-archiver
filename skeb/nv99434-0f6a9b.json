うにしてたら案外なんでも大丈夫です！距離感近めだったら嬉しいです。\n\n┈┈┈┈┈┈┈┈┈┈\nドライブ資料について\n文字になりますが関係や性格好きなものなどを綴ったメモがあります。\n任意ですが困ったら参照ください！\n┈┈┈┈┈┈┈┈┈┈\nその他\nできればパーツごとにイラストを分けて透過分も納品いただけたら助かります！！\n┈┈┈┈┈┈┈┈┈┈\n金額不足しておりましたら再リクいただけると助かります😭\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/14ELRQuiy572mJRmmvqSY71_m319L95bP", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1318946, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "妙子", "screen_name": "t_a_eko", "avatar_url": "https://pbs.twimg.com/profile_images/2082393593072025600/hHoiS_jU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1073976157001867264/1659299780/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 2902611, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "いかわさ🦑", "screen_name": "Midori_soumenn", "avatar_url": "https://pbs.twimg.com/profile_images/1698908446492590080/BUqIxfaD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1057999758789230592/1585705928/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 3082474, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "鶏肉(子)", "screen_name": "niku_cm", "avatar_url": "https://pbs.twimg.com/profile_images/1398914276316745729/0OpBv2gc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1361662142693269508/1751445363/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "fir