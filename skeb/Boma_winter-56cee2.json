▼\n難しくなければPSDでお願い致します。\n背景や人物、サインはレイヤー分けしてもらえると助かります。\n\n\n最後に、\n色々ご指定させていただきましたが、榎本様が楽しく描いていただければこちらとしても嬉しいので全てに従う必要はありません。\n資料の件ご迷惑をおかけして大変申し訳ございませんでした。再送失礼しました。\nよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@saku_nosuke/works/186", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 669169, "client_id": 2671542, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87fc74e3/uploads/origins/805009d1-8550-4bdc-848f-0df4e960df6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2087dc0e97fb8b0708cef0f8c331059f", "srcset": "https://si.imgix.net/87fc74e3/uploads/origins/805009d1-8550-4bdc-848f-0df4e960df6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2087dc0e97fb8b0708cef0f8c331059f, https://si.imgix.net/87fc74e3/uploads/origins/805009d1-8550-4bdc-848f-0df4e960df6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35b400b1b37f7e79da8c6c7ab3052a86 2x, https://si.imgix.net/87fc74e3/uploads/origins/805009d1-8550-4bdc-848f-0df4e960df6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36f986fba21fafd45edbec512e067b45 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87fc74e3/uploads/origins/805009d1-8550-4bdc-848f-0df4e960df6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e779fc2177d30374270de4abfa505f9", "srcset": "https://si.imgix.net/87fc74e3/uploads/origins/805009d1-8550-4bdc-848f-0df4e960df6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e779fc2177d30374270de4abfa505f9, https://si.imgix.net/87fc74e3/uploads/origins/805009d1-8550-4bdc-848f-0df4e960df6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=785c25ab6468b954b5e0f7cd17048e80 2x, https: