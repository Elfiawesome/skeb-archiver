で、南国の青空の下、真夏の海辺で水着で水と楽しく戯れている華さんをお願いします。水着が水にぬれて肌が少し透け気味で（局部透けは不要でｗ）お願いします。それと水着ですが公式で使われていた下記リンクのものが良いです。(色は変更可です）\n（公式がなかったのであみあみのグッズ販売ページに飛びます）よろしくお願いします。\nhttps://www.amiami.jp/top/detail/detail?gcode=GOODS-00197908-R&page=top%2Fsearch%2Flist%3Fs_originaltitle_id%3D20791%24pagemax%3D40%24getcnt%3D0%24pagecnt%3D22", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fu_yuno2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 426139, "client_id": 403733, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03094f45/requests/86452_3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae6c36b180f0de47dcad5bc0680f0302", "srcset": "https://si.imgix.net/03094f45/requests/86452_3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae6c36b180f0de47dcad5bc0680f0302, https://si.imgix.net/03094f45/requests/86452_3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8fd324146eb4dc78a6c38f9457d3ed81 2x, https://si.imgix.net/03094f45/requests/86452_3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcfc0dce50655dfd1f04c509afaebae1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03094f45/requests/86452_3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f43fc0192554c63501c780bc7c72421", "srcset": "https://si.imgix.net/03094f45/requests/86452_3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f43fc0192554c63501c780bc7c72421, https://si.imgix.net/03094f45/requests/86452_3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e10f24d1f28162c3a9a6c5688134f331 2x, https://si.imgix.net/03094f45/requests/86452_3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b969183328bf8e53bc0cda56732854fb 3x"}, "body": "初めまして。島田千代をリクエストします。\n色気があって美しく、少し気品があって、かなりお高くとまっている彼女の魅力が伝わるイラストをお願いします。\n\n衣装は参考画像のような「裸エプロン」をお願いします。\n\n＜参考画像２ページ目３ページ目４ページ目＞\nhttps://www.pixiv.net/artworks/63141645\n\n但し、参考画像のようにノリノリではなく、不承不承という感じでお願いします。\n表情は、恥ずかしさと悔しさをプライドの高さで隠そうとするが隠しきれない、そんな表情がいいです。\n相手を恨めし気に睨むような眼でお願いします。\n\nそれからセリフや文字入れの差分をお願いします。\n\n＜セリフ＞\n「悪趣味！サイテー・・・。」\n「あまりジロジロ見ないで下さるかしら」\n\n＜エプロンに文字入れ＞\n\n『風雅様専用オナホセフレ\n　島田流戦車道家元　島田千代』\n\n差分依頼は以上となります。\n\n垢ぬけていて大人の魅力に溢れる島田千代を是非お願いします。\n\nリクエスト内容が依頼料オーバーであればキャンセルでお願いします。\n御忙しいところ、恐縮ですが、何卒ご検討ください。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fu_yuno2/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d38fbf0e/requests/79733_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6759e3d95b1ce0c1db73080caecda4f2", "srcset": "https://si.imgix.net/d38fbf0e/requests/79733_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6759e3d95b1ce0c1db73080caecda4f2, https://si.imgix.net/d38fbf0e/requests/79733_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc46821e95d116db3a9648a29b77d9c4 2x, https://si.imgix.net/d38fbf0e/requests/79733_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed5c66642aa5a880522c0a13afa7ac6c 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 426139, "client_id": 130591, "nc": 48}, {"path": "/@fu_yuno2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4