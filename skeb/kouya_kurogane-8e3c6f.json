774764\n胸元は上イラストのように襟元は開かず、襟より下のボタンひとつめのところから開いておっぱい露出\nナース帽あり\nブラなし、生足（構図に入るなら靴はあり）\n\n可能であれば、\n男の頭を上げて未ディープキス状態か、\n男をレイヤー有無でも切り替えできると嬉しいです\n\n■形式\n作業で使われていれば、\npsd、clipなどのレイヤー管理ファイルがあると有り難いです。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kouya_kurogane/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3261000, "client_id": 135767, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38cb4fac/uploads/origins/fac99c6e-f579-4a23-8615-67c6b2f4a51f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fc02f7a6a9f3a49882676d261835d99", "srcset": "https://si.imgix.net/38cb4fac/uploads/origins/fac99c6e-f579-4a23-8615-67c6b2f4a51f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fc02f7a6a9f3a49882676d261835d99, https://si.imgix.net/38cb4fac/uploads/origins/fac99c6e-f579-4a23-8615-67c6b2f4a51f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a190b29c9f7da580cfc1944841bd9062 2x, https://si.imgix.net/38cb4fac/uploads/origins/fac99c6e-f579-4a23-8615-67c6b2f4a51f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f6b25df4b98faf0dba35206d239611e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38cb4fac/uploads/origins/fac99c6e-f579-4a23-8615-67c6b2f4a51f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4f34dc9d3c02daed88d78110b926088", "srcset": "https://si.imgix.net/38cb4fac/uploads/origins/fac99c6e-f579-4a23-8615-67c6b2f4a51f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4f34dc9d3c02daed88d78110b926088, https://si.imgix.net/38cb4fac/uploads/origins/fac99c6e-f579-4a23-8615-67c6b2f4a51f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=30f4cbb01b905f95fbd82e2e8d