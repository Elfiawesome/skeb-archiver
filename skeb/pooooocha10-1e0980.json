サインを作っている\n参考となるキャラクターはこちら buddyfight.fandom.com/wiki/Ageha_Gokuraku", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pooooocha10/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8a74836e/uploads/origins/4401d7af-91c9-4188-81ff-7413afb814f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e28aff909750614bd3ac26b8adb174f", "srcset": "https://si.imgix.net/8a74836e/uploads/origins/4401d7af-91c9-4188-81ff-7413afb814f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e28aff909750614bd3ac26b8adb174f, https://si.imgix.net/8a74836e/uploads/origins/4401d7af-91c9-4188-81ff-7413afb814f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0c0417d5b6a84c8681a9ddc8561d367 2x, https://si.imgix.net/8a74836e/uploads/origins/4401d7af-91c9-4188-81ff-7413afb814f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31b05b51a11a2aa920d3ba6ea5725cb0 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 4006031, "client_id": 2079305, "nc": 128}, {"path": "/@pooooocha10/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4006031, "client_id": 361716, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a0a4b62/uploads/origins/4c40b51a-071e-4153-b37e-a0cfd92761f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f59638a786ed2b5eff971db348f51fbe", "srcset": "https://si.imgix.net/3a0a4b62/uploads/origins/4c40b51a-071e-4153-b37e-a0cfd