si.imgix.net/19bba62b/uploads/origins/c7e47b55-3738-42d6-9d81-299cde6546d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=30766240379f24da3f6fb7f9fc52c7c0 2x, https://si.imgix.net/19bba62b/uploads/origins/c7e47b55-3738-42d6-9d81-299cde6546d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6b375aab9d9b0486b2fe1d49aaf396de 3x"}, "body": "キャラクター\nリジー： https://imgur.com/a/1pscWPk\nチー： https://i.imgur.com/cpyVKY2.jpeg\n\nリジーの方がチンより身長も体格も大きい。このサイズ差に近いもの： https://i.imgur.com/ZoKlY8N.jpeg\n\n服装です。\nこの服を着ているLizzieが好きです： https://i.imgur.com/y1ZPJpl.jpeg\n\nチーにはこんな服を着てほしい： https://i.imgur.com/3OgUP89.jpeg\n\n写真\nリジーは立っていて、とても大きな丸いお腹をしています。胃の中にたくさんの女性がいるイメージで、こんな感じです： https://i.imgur.com/rl3s2Vg.png\n可能であれば、胃の中に女性の輪郭を描いていただければ最高ですが、もし描きたくなければ、ただ単にとても大きな丸い胃であってもかまいません。\n\nそして、手と膝をついて口にさるぐつわをはめたチーがいいと思います。リジーはチーの首につながった鎖を持っています。\n\nリジーには邪悪な笑みを浮かべてもらいたい。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bubububu_bbb/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 143612, "client_id": 70470, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21e6a19c/uploads/origins/9ae4655e-5346-4e70-808c-713f350c2b57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a114d6c163811d912bcdf96c5cb436b4", "srcset": "https://si.imgix.net/21e6a19c/uploads/origins/9ae4655e-5346-4e70-808c-713f350c2b57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a114d6c163811d912bcdf96c5cb436b4, https://si.imgix.net/21e6a19c/uploads/origins/9ae4655e-5346-4e70-808c-713f350c2b57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3c0f69a7a06c488ae871eff12b75db3 2x, https://si.imgix.net/21e6a19c/uploads/origins/9ae4655e-5346-4e70-808c-713f350c2b57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae452581dac4dcb92e261426162cd43f 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21e6a19c/uploads/origins/9ae4655e-5346-4e70-808c-713f350c2b57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=534d2c01d417f2a39c370c4e212b975c", "srcset": "https://si.imgix.net/21e6a19c/uploads/origins/9ae4655e-5346-4e70-808c-713f350c2b57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=534d2c01d417f2a39c370c4e212b975c, https://si.imgix.net/21e6a19c/uploads/origins/9ae4655e-5346-4e70-808c-713f350c2b57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=90486d5bdd290eb057ff19953e40a23c 2x, https://si.imgix.net/21e6a19c/uploads/origins/9ae4655e-5346-4e70-808c-713f350c2b57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b2e6a364aa45528c1bbdad2fa3e5b99c 3x"}, "body": "はじめまして！こちらのイラスト( https://www.pixiv.net/artworks/98403258)が性癖に刺さりました！良ければ下記の内容で依頼させてください\n〇内容:「130日後、おっぱいはPカップ以上ある超乳サイズに膨らみ続け、おしりもスカートから丸出しになるくらい特盛に膨らみ、ムチムチボディになっちゃったヤンキー」でお願いします\n〇構図やポーズなど:必死に手で胸を隠そうとしているも、乳首まで手が届かず抱えつつ、おしりは全く隠せてない様な感じでお願いします\n\n検討の程よろしくお願いします。", "nc": 179, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bubububu_bbb/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 143612, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17e5a6ba/uploads/origins/1847ea98-2ce8-4903-a5e7-ce8378309c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fccf204da2fe39e929c27174eb55eb43", "srcset": "https://si.imgix.net/17e5a6ba/uploads/origins/1847ea98-2ce8-4903-a5e7-ce8378309c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fccf204da2fe39e929c27174eb55eb43, https://si.imgix.net/17e5a6ba/uploads/origins/1847ea98-2ce8-4903-a5e7-ce8378309c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ff5324994cc65ed70838d373c2c4616 2x, https://si.imgix.net/17e5a6ba/uploads/origins/1847ea98-2ce8-4903-a5e7-ce8378309c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f2eb9417a9aa05e8acf48b49413c52a 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17e5a6ba/uploads/origins/1847ea98-2ce8-4903-a5e7-ce8378309c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d425b3a7237b67c26c3855de346b7bf", "srcset": "https://si.imgix.net/17e5a6ba/uploads/origins/1847ea98-2ce8-4903-a5e7-ce8378309c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d425b3a7237b67c26c3855de346b7bf, https://si.imgix.net/17e5a6ba/uploads/origins/1847ea98-2ce8-4903-a5e7-ce8378309c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ebc75f71f5aa2fb8f9cb2ef706256c1b 2x, https://si.imgix.net/17e5a6ba/uploads/origins/1847ea98-2ce8-4903-a5e7-ce8378309c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=61384802e79387b18793fcfdfe51e04d 3x"}, "body": "織部真冬（おりべまふゆ）と山辺智（やまのべとも）は、シリーズ終了後も成長を続けており、制服に収まりきらない状態です。制服のボタンを留めるのに苦労している二人。ブラジャーから胸がはみ出しています。二人は自分の成長した胸をとても誇りに思っていて、どちらがより制服を脱いだかを比較しています。乳首は勃起し、ブラジャーを突き破っています。二人とも、どちらがより成長して相手の女の子に勝てるかを競っています。\n\n後ろでサーシャが憤慨している。\n\n登場人物の画像： https://imgur.com/a/cMl3sQu\n(真冬の胸はシリーズを通して大きく成長しました)\n\nビフォーアフターをぜひお願いします。終盤のおっぱいの大きさからスタートして、大きくなっていく様子を見たいですね。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bubububu_bbb/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9df7a316/uploads/origins/635f32e8-bd90-4292-a2db-79f300887a89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc