6c069ab40e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4e76fe9a44c0b82e7f8a88c4f0d10557 2x, https://si.imgix.net/828da92a/uploads/origins/fcb4918e-7c4b-4979-889f-86c069ab40e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a67878f1ea09ca895c843d78931d557c 3x"}, "body": "水咲七碧様\nお世話になっております！\nVtuberとして活動をしている百野モノです！\n\nこの度は水咲七碧様にぜひまた素敵なイラストを描いていただきたくリクエストをお送りいたしました！\n\n私の個人的な希望になってしまうのですが、今回は水咲七碧様に百野モノのSDキャラをぜひ描いていただけると非常に嬉しいです！\nポージング等に関しまして特段希望はございませんので、ぜひ七碧様の思い描く百野モノのイラストを制作していただければ嬉しいです！\n※またぜひ配信サムネイル等でも使用したいため人物だけの透過と分けていただけると非常に助かります！\n\n制作していただいたイラストの使用用途は\n・活動で使用しているSNS(X,BlueSky)での投稿\n・アイコンやヘッダー等での使用\n・Youtube等の配信でのサムネイルでの使用\n・グッズ制作\nなどといった主に百野モノの活動内での使用を考えております！\n\n是非ともご検討していただけると幸いです。\nよろしくお願いいたします。\n\n【参考】\nhttps://drive.google.com/drive/folders/1vcKOIpaJBjqyuZAqKIA09VQJ-P6-EIw3?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Nanami_yuurei0/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2079280, "client_id": 1257060, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0f12a1c/uploads/origins/001b5db6-4b36-4556-b58f-3f501201beff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=467c0d5cb8d7ab6678541114137cda17", "srcset": "https://si.imgix.net/f0f12a1c/uploads/origins/001b5db6-4b36-4556-b58f-3f501201beff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=467c0d5cb8d7ab6678541114137cda17, https://si.imgix.net/f0f12a1c/uploads/origins/001b5db6-4b36-4556-b58f-3f501201beff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2fed5c77fa68a4608b78259652b9621f 2x, https://si.imgix.net/f0f12a1c/uploads/origins/001b5db6-4b36-4556-b58f-3f501201beff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d06d17386e287709a9d3a81b8149b5d4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0f12a1c/uploads/origins/001b5db6-4b36-4556-b58f-3f501201beff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d005138763ea599a381df15a99edfc3", "srcset": "https://si.imgix.net/f0f12a1c/uploads/origins/001b5db6-4b36-4556-b58f-3f501201beff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d005138763ea599a381df15a99edfc3, https://si.imgix.net/f0f12a1c/uploads/origins/001b5db6-4b36-4556-b58f-3f501201beff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0d44e0c9c0046b0cc6aeae4a97738bbf 2x, https://si.imgix.net/f0f12a1c/uploads/origins/001b5db6-4b36-4556-b58f-3f501201beff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=677fba2dc902d90388ad941e1c50afdb 3x"}, "body": "水咲七碧さん、こんにちは。\n前回に引き続き、今回もVOICEROID衣装の琴葉茜のイラストをリクエストしたいと思います。\n\n前回同様おっとりした雰囲気で、以前描いていただいた私のTwitterアイコンのような、唇に人差し指を当て、口を閉じてウィンクしているところをお願いします。視点は真正面でなくて構いません。\n恥じらいの有無や、指を当てていない方の手の位置はお任せします。\nまた、衣装全体が写るよう、膝から上が収まる構図で描いていただければと思います。\n\n以上の内容でよろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Nanami_yuurei0/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2079280, "client_id": 2510659, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c3c296b/uploads/origins/7b046f89-5f32-4c04-953b-3c53ef654baa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e1179280a7064942c3034b63110d8cc", "srcset": "https://si.imgix.net/2c3c296b/uploads/origins/7b046f89-5f32-4c04-953b-3c53ef654baa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e1179280a7064942c3034b63110d8cc, https://si.imgix.net/2c3c296b/uploads/origins/7b046f89-5f32-4c04-953b-3c53ef654baa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65fddc7dc4f45597c6453ee892c43980 2x, https://si.imgix.net/2c3c296b/uploads/origins/7b046f89-5f32-4c04-953b-3c53ef654baa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fbb05542e758cf6e33797285cebb9a5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c3c296b/uploads/origins/7b046f89-5f32-4c04-953b-3c53ef654baa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10aeabbf6b464005923468fb3d78cbaf", "srcset": "https://si.imgix.net/2c3c296b/uploads/origins/7b046f89-5f32-4c04-953b-3c53ef654baa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10aeabbf6b464005923468fb3d78cbaf, https://si.imgix.net/2c3c296b/uploads/origins/7b046f89-5f32-4c04-953b-3c53ef654baa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eaf819d5b27a38c5384ca45eb6414f4d 2x, https://si.imgix.net/2c3c296b/uploads/origins/7b046f89-5f32-4c04-953b-3c53ef654baa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=de50d604966bbb9f2810d7548514fcbb 3x"}, "body": "こんにちは！　ひつじをかぶったNAGOと申します。\n前回依頼させていただいたイラストが　ほんとうに　ほんとうに\nとても良すぎて\n今回　デフォルメのイラストも依頼させていただけないでしょうか！？\n\n構図・ポーズともに　お任せいたしますが\n　SDイラストを　希望とさせていただきます。\n\nどうぞよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Nanami_yuurei0/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2079280, "client_id": 1360269, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97bc9bd8/uploads/origins/050911b5-2194-46f0-98aa-865cbf5a393f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=337b80ec461c0e95117041e9eb6d7124", "srcset": "https://si.imgix.net/97bc9bd8/uploads/origins/050911b5-2194-46f0-98aa-865cbf5a393f?bg=%23fff&