な視点（迫力のある感じでお願いします）\n\n●補足事項\n・配置が逆の方が描きやすい等の理由がありましたら左右逆でも問題ありません\n・双方似たような体格ですが、そのまま描くとわずかに違って綺麗に揃わないと思うので、イソギク側の体格に合わせて作画してください\n・双方の衣装指定については、ちょっと服装が似てて映えるのではと思っての選出なので、他に描きたい服装がある場合はそちらを優先していただいて構いません\n\n以上です\nご検討いただけると幸いです", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Nanami_yuurei0/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2079280, "client_id": 1485382, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa1b20a2/uploads/origins/ee95f18c-8e25-4c31-a67e-9c8f34f577ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fde4a748f9545f22ebbeaad1280ad27b", "srcset": "https://si.imgix.net/aa1b20a2/uploads/origins/ee95f18c-8e25-4c31-a67e-9c8f34f577ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fde4a748f9545f22ebbeaad1280ad27b, https://si.imgix.net/aa1b20a2/uploads/origins/ee95f18c-8e25-4c31-a67e-9c8f34f577ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9766f80bfa549a8fe02a0105d97874ef 2x, https://si.imgix.net/aa1b20a2/uploads/origins/ee95f18c-8e25-4c31-a67e-9c8f34f577ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc37225dda5688998807a9cda7ea5a49 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa1b20a2/uploads/origins/ee95f18c-8e25-4c31-a67e-9c8f34f577ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69fa5d9d481c44474e382ff1e2c75003", "srcset": "https://si.imgix.net/aa1b20a2/uploads/origins/ee95f18c-8e25-4c31-a67e-9c8f34f577ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69fa5d9d481c44474e382ff1e2c75003, https://si.imgix.net/aa1b20a2/uploads/origins/ee95f18c-8e25-4c31-a67e-9c8f34f577ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&