ので、生傷が絶えないが怪我を治されるのを「気味が悪い」って拒否るのですが、有限性を薄すら察しててワザと拒否っています…。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tetopp/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/46382d56/uploads/origins/8ea01e82-8dc0-4793-8234-da5de1b470a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36b08fa8b4884294cf004d71b2be4e41", "srcset": "https://si.imgix.net/46382d56/uploads/origins/8ea01e82-8dc0-4793-8234-da5de1b470a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36b08fa8b4884294cf004d71b2be4e41, https://si.imgix.net/46382d56/uploads/origins/8ea01e82-8dc0-4793-8234-da5de1b470a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4e2af91b481e1a7f5edcdd29bf556a3 2x, https://si.imgix.net/46382d56/uploads/origins/8ea01e82-8dc0-4793-8234-da5de1b470a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=884de57c5257bff649c342139f706c53 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1645688, "nc": 129}], "sent_works": [], "similar_creators": [{"id": 23789, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "SIRA＠艦これ、メカ少女描いてる", "screen_name": "SIRA_ILLUST", "avatar_url": "https://pbs.twimg.com/profile_images/2051139916470644736/QvM7Xt0V.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1183399962/1719693985/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expirati