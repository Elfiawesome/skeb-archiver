c33f3/uploads/origins/404d006a-6f93-4904-bf11-9e89bd4160b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b3fd289564af0d89855313673fa32dc", "srcset": "https://si.imgix.net/a3ac33f3/uploads/origins/404d006a-6f93-4904-bf11-9e89bd4160b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b3fd289564af0d89855313673fa32dc, https://si.imgix.net/a3ac33f3/uploads/origins/404d006a-6f93-4904-bf11-9e89bd4160b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23d0d04e224ed7e91f697e03b7fc8c3e 2x, https://si.imgix.net/a3ac33f3/uploads/origins/404d006a-6f93-4904-bf11-9e89bd4160b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b578e5054dd45d647d8fb2f2ee955b96 3x"}, "body": "野神すゞ様\nはじめまして\n\n私がゲームで使用しているアバターをモチーフにしたエンブレムを描いて頂きたくリクエストさせていただきました。\n資料URL内のパッツンロングの巫女服を着た狐娘の子をモチーフに、和な雰囲気でお願いいたします。\n狐耳、尻尾、頭の長いリボン等ごちゃごちゃしない程度に出来るだけ特徴がわかるものを入れていただけると嬉しいです。(刀や銃も持っていますがそちらはお任せします)\n\n使用用途ですが、ゲーム内のワールド(自分の部屋の様なものです)に飾らせて頂いたり、個人使用のグッズ化に使わせて頂きたいと思っています。\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1KQ3qi2RR1HcppUxn9YAtYPHm46DGySWj?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kijyou_no_9ran/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2009031, "client_id": 2369388, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bad7828/uploads/origins/fa1f26b9-7f17-4d97-ace1-6ac77edc96d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=123c005ca0034605d4d95ba2b90d680f", "srcset": "https://si.imgix.net/3bad7828/uploads/origins/fa1f26b9-7f17-4d97-ace1-6ac77edc96d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=123c005ca0034605d4d95ba2b90d680f, https://si.imgix.net/3bad7828/uploads/origins/fa1f26b9-7f17-4d97-ace1-6ac77edc96d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aaf0ee7f7345913ddb37cc62f8a1dc11 2x, https://si.imgix.net/3bad7828/uploads/origins/fa1f26b9-7f17-4d97-ace1-6ac77edc96d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fb6cb9401e6da39056dc410005ab1cc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bad7828/uploads/origins/fa1f26b9-7f17-4d97-ace1-6ac77edc96d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e38aafb0ac15938f58eda6b5d0b06d21", "srcset": "https://si.imgix.net/3bad7828/uploads/origins/fa1f26b9-7f17-4d97-ace1-6ac77edc96d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e38aafb0ac15938f58eda6b5d0b06d21, https://si.imgix.net/3bad7828/uploads/origins/fa1f26b9-7f17-4d97-ace1-6ac77edc96d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2e873c50d00e566e3acca38dafbe1707 2x, https://si.imgix.net/3bad7828/uploads/origins/fa1f26b9-7f17-4d97-ace1-6ac77edc96d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4865fee4fd4364e5dac00732d9a7445d 3x"}, "body": "お久しぶりです。先日は元気で可愛らしい猫のエンブレムを作成いただきありがとうございました！\n今回は、家紋のようなイメージのものを作っていただきたく再度リクエストさせていただきます。\n\n【いれていただきたいメインモチーフ】\n紫陽花・猫\n※猫は尻尾が2本の猫又で作成していただけると嬉しいです\n\n【モチーフ】\n要素を求めすぎてしまうと、『家紋』としてはごちゃごちゃとしてしまうのでは？と思っているのですが…\n自分の配信内容が『ゲーム実況』『お絵描き雑談』になるため、ゲームコントローラーや画材（ペンなど）を可能でしたら入れていただけると嬉しいです！\n（難しそうでしたら上記メインモチーフのみで構成いただいて問題ありません！）\n\n【色 ・イメージ】\n『家紋風のもの』をイメージしているので黒（モノクロ）で作成いただけると嬉しいです\n\n【用途】\nyoutubeにて配信を行っているため、配信画面右下にでてくるチャンネル登録用のロゴや、ヘッダー画像、自分自身のアバターが着用している衣装のワンポイントなどに使わせていただきたいと考えております。\nもし可能でしたら透過済PNGデータでもいただけると嬉しいです。\n\nお忙しいとは思いますが、ご検討よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kijyou_no_9ran/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2009031, "client_id": 689999, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/56942d12/uploads/origins/1d8f80a4-b2c7-4887-a249-6b7e6b47dd8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab90eb425a2b4ec8684dc3cf13cc7070", "srcset": "https://si.imgix.net/56942d12/uploads/origins/1d8f80a4-b2c7-4887-a249-6b7e6b47dd8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab90eb425a2b4ec8684dc3cf13cc7070, https://si.imgix.net/56942d12/uploads/origins/1d8f80a4-b2c7-4887-a249-6b7e6b47dd8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bac219e9848b5b5993e3a19a1d786a3 2x, https://si.imgix.net/56942d12/uploads/origins/1d8f80a4-b2c7-4887-a249-6b7e6b47dd8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41cb7783a020eb92c7afe648afe34020 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56942d12/uploads/origins/1d8f80a4-b2c7-4887-a249-6b7e6b47dd8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cee04cb206893d0b3205a1657d6de063", "srcset": "https://si.imgix.net/56942d12/uploads/origins/1d8f80a4-b2c7-4887-a249-6b7e6b47dd8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cee04cb206893d0b3205a1657d6de063, https://si.imgix.net/56942d12/uploads/origins/1d8f80a4-b2c7-4887-a249-6b7e6b47dd8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=38ab3972059b9e16827e09623cd532f4 2x, https://si.imgix.net/56942d12/uploads/origins/1d8f80a4-b2c7-4887-a249-6b7e6b47dd8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bdec452d4fd975895664f149571b7400 3x"}, "body": "初めまして。\n\nエンブレムのデザインを手掛けておられる方を探していたところ御作を発見し、可愛らしい猫の作品や洋の東西を問わない多彩な内容に惹かれこの度リクエストさせて頂きました。\n\n・リクエスト内容\n　エンブレムのデザイン\n\n・世界観と用途\n　「機動戦士ガンダム」や「エースコンバット」、「アーマードコア」の各シリーズなど、リアルロボット/ミリタリー系世界観のメカでパイロットが機体に描き込むエンブレム（ノーズアート）のイメージ\n　個人的に鑑賞するほか、上記世界観などで創作・イラスト依頼する際に描写の中に入れる、作画資料としてクリエイターさんに提示させて頂く、などを用途として考えております。\n　そのため羊皮紙風の下地の他、背景透過のデータとしても頂戴できますと幸いです。\n\n・デザイン頂く際に取り入れて頂きたいキーワード\n　青と白、星、海、ハムスター、黄色の差し色\n　ほか「使用者」となるキャラクターについて、ファイナルファンタジー14（以下FF14）で作成した容姿を資料に入れております。\n　側頭部の角や尻尾などに竜のような特徴を持つ亜人系のキャラクターですが、「竜」要素は入れないでいただくようお願い致します。\n\nリクエスト内容は以上となります。ご多忙のところ恐縮ですが、予算面での再送含めご検討のほどよろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1-o1-BAs2jgZgMiZnITkz7ilpHEW23sxh", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kijyou_no_9ran/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2009031, "client_id": 2369388, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e194575/uploads/origins/7c05f91b-91c5-4028-bbb5-692c27e0d43d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3027760f9ffa8db93f603064e9df6e0", "srcset": "https://si.imgix.net/1e194575/uploads/origins/7c05f91b-91c5-4028-bbb5-692c27e0d43d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3027760f9ffa8db93f603064e9df6e0, https://si.imgix.net/1e194575/uploads/origins/7c05f91b-91c5-4028-bbb5-692c27e0d43d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca6383107420133f38c824888e7d55c2 2x, https://si.imgix.net/1e194575/uploads/origins/7c05f91b-91c5-4028-bbb5-692c27e0d43d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dce386f004087aa60348682c12779727 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e194575/uploads/origins/7c05f91b-91c5-4028-bbb5-692c27e0d43d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45563517ebd9132e13bb42cb4dd3ebce", "srcset": "https://si.imgix.net/1e194575/uploads/origins/7c05f91b-91c5-4028-bbb5-692c27e0d43d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45563517ebd9132e13bb42cb4dd3ebce, https://si.imgix.net/1e194575/uploads/origins/7c05f91b-91c5-4028-bbb5-692c27e0d43d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=71136f979decd059da21aff8da03291c 2x, https://si.imgix.net/1e194575/uploads/origins/7c05f91b-91c5-4028-bbb5-692c27e0d43d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=388a2e9cdb4ab0936268a10a0c924c8d 3x"}, "body": "はじめまして。この度エンブレムのデザインをお願いしたくリクエストさせていただきました。\n\nリンク先資料のキャラクターをイメージしたもの、かつ可能でしたら以下のモチーフ・色を反映していただけると嬉しいです。\n\n【イメージしていただきたいキャラクター】\n・イメージキャラクター資料\nhttps://x.com/hami_pic/status/1818902768729649353\n【モチーフ】\n・猫（外見要素です）\n　猫耳が含まれる場合は右耳が破れている、尻尾が含まれる場合は2本、だと嬉しいです。\n・活動内容要素\n　お絵描き・ゲーム実況をメインに行っているため「絵を描く」モチーフがあると嬉しいです。\n　またどの配信内容でも喋り続けていることが多いので「おしゃべり」「にぎやか」なイメージがあると嬉しいです。\n【色 】\n青～紫\n\nyoutubeにて配信を行っているため、配信画面右下にでてくるチャンネル登録用のロゴや、ヘッダー画像などに使わせていただきたいと考えております。\nもし可能でしたら透過済PNGデータでもいただけると嬉しいです。\n\nお忙しいとは思いますが、ご検討よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kijyou_no_9ran/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2009031, "client_id": 897326, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c412ceea/uploads/origins/b9905f13-15f1-4123-9ad9-d5335668c653?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ae5a45bc8f30f0608e48f6bcda61ece", "srcset": "https://si.imgix.net/c412ceea/uploads/origins/b9905f13-15f1-4123-9ad9-d5335668c653?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ae5a45bc8f30f0608e48f6bcda61ece, https://si.imgix.net/c412ceea/uploads/origins/b9905f13-15f1-4123-9ad9-d5335668c653?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd1f1ebbbba4fed2d9e8580409ad73ee 2x, https://si.imgix.net/c412ceea/uploads/origins/b9905f13-15f1-4123-9ad