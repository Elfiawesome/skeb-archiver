\n\nもし可能ならばデータはpsdで、背景とのレイヤーを分けていただけますと使用しやすく大変助かります。\n\nイラストはSNSでの投稿や配信、ネットプリントなどに使用させていただけたらと思っております。\n\nご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1T9xZiKIF-czxHeI9sRSEDXUWVsvqGiE7", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mmchchR/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3169291, "client_id": 585550, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0612f4d/uploads/origins/b8157f19-2f13-4fde-a3bd-9379e5ec2e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11963450b39a678ec89097bfa636b1af", "srcset": "https://si.imgix.net/b0612f4d/uploads/origins/b8157f19-2f13-4fde-a3bd-9379e5ec2e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11963450b39a678ec89097bfa636b1af, https://si.imgix.net/b0612f4d/uploads/origins/b8157f19-2f13-4fde-a3bd-9379e5ec2e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ada69dda3caa196290c409e56960bbd1 2x, https://si.imgix.net/b0612f4d/uploads/origins/b8157f19-2f13-4fde-a3bd-9379e5ec2e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77a3fb1ca999c72fdb0e5c29d8d29a67 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0612f4d/uploads/origins/b8157f19-2f13-4fde-a3bd-9379e5ec2e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e82c441fd26169cf7ba2ad21a6b609b6", "srcset": "https://si.imgix.net/b0612f4d/uploads/origins/b8157f19-2f13-4fde-a3bd-9379e5ec2e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e82c441fd26169cf7ba2ad21a6b609b6, https://si.imgix.net/b0612f4d/uploads/origins/b8157f19-2f13-4fde-a3bd-9379e5ec2e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=752d06aacd33a628b76ce81e48de