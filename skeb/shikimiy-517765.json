お任せしますので、お値段の範囲内で仕上げて頂ければと思います。ご検討の程、宜しくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 852565, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぐじゃ太🍼", "screen_name": "NrU6c", "avatar_url": "https://pbs.twimg.com/profile_images/1611751118153093120/vq6gsoGB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/775633948697202688/1680187723/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "nc": 49}, {"id": 2021706, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "叶望かなと", "screen_name": "kanato_345", "avatar_url": "https://pbs.twimg.com/profile_images/2009575495764262912/CdbPEEYC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1325033498143412225/1705137423/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "video"}], "nc": 128}, {"id": 2684157, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Rimu@依頼受付中", "screen_name": "rimu_aqua", "avatar_url": "https://pbs.twimg.com/profile_images/2025131338664427520/pnTma0JE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1553778033131081731/1685694062/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "nc": 176}, {"id": 3163949, "creator": tru