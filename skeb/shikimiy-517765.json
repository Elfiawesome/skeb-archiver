f23-f166-4656-91ed-89172982d762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5feb87657d392c8cbb447e441ecb15c5, https://si.imgix.net/d4a933e1/uploads/origins/47300f23-f166-4656-91ed-89172982d762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d34fa7f358fbc1416a29a9cca6f396b8 2x, https://si.imgix.net/d4a933e1/uploads/origins/47300f23-f166-4656-91ed-89172982d762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=19ce67ffe9ca45485ea45b72b148f8f6 3x"}, "body": "こんにちは。樒やさか様にイラストを描いていただきたく、リクエストをいたしました。\n添付しました資料にある自作キャラをメカアレンジをしていただきたいです。\n構図等は全体的に疾走感がある感じでお願いします。\nシチュエーション等、その他の部分はお任せいたします。\n制作いただいたイラストはツイッターのヘッダーで使用させていただきたいです。\n\n参考ファイル：https://drive.google.com/file/d/11ZEnFdeXWn7SFN5OyQ3KAnK_bUWmwSz5/view\nhttps://drive.google.com/file/d/11KYzbYmEiKKsPl8H4nTP0pZEidyqytFm/view?\nhttps://drive.google.com/file/d/1WDcMUETNU6k_svzAcFWMGlQt2CC8t8CK/view\nhttps://drive.google.com/file/d/1X5AENUjcOEltmwaNmNA_L5gFnYTRdeR7/view\nhttps://drive.google.com/file/d/1bXrYzHLWNb72c3U8wXisVzwkRXK6pXI7/view\nhttps://drive.google.com/file/d/1leNggxExGHTtJ5c3II2ORdZcXoTq_qjh/view\nhttps://drive.google.com/file/d/1neii7uuJjQwL28sGIux7OgMUNvJkDuki/view", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shikimiy/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1869513, "client_id": 1285861, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07ba9e3d/uploads/origins/c99fd8ac-f3e5-48c4-b541-a32a6ec862f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7a42dddcce995d1f08925624695e327", "srcset": "https://si.imgix.net/07ba9e3d/uploads/origins/c99fd8ac-f3e5-48c4-b541-a32a6ec862f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7a42dddcce995d1f08925624695e327, https://si.imgix.net/07ba9e3d/uploads/ori