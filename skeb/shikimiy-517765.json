3-f166-4656-91ed-89172982d762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5feb87657d392c8cbb447e441ecb15c5, https://si.imgix.net/d4a933e1/uploads/origins/47300f23-f166-4656-91ed-89172982d762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d34fa7f358fbc1416a29a9cca6f396b8 2x, https://si.imgix.net/d4a933e1/uploads/origins/47300f23-f166-4656-91ed-89172982d762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=19ce67ffe9ca45485ea45b72b148f8f6 3x"}, "body": "こんにちは。樒やさか様にイラストを描いていただきたく、リクエストをいたしました。\n添付しました資料にある自作キャラをメカアレンジをしていただきたいです。\n構図等は全体的に疾走感がある感じでお願いします。\nシチュエーション等、その他の部分はお任せいたします。\n制作いただいたイラストはツイッターのヘッダーで使用させていただきたいです。\n\n参考ファイル：https://drive.google.com/file/d/11ZEnFdeXWn7SFN5OyQ3KAnK_bUWmwSz5/view\nhttps://drive.google.com/file/d/11KYzbYmEiKKsPl8H4nTP0pZEidyqytFm/view?\nhttps://drive.google.com/file/d/1WDcMUETNU6k_svzAcFWMGlQt2CC8t8CK/view\nhttps://drive.google.com/file/d/1X5AENUjcOEltmwaNmNA_L5gFnYTRdeR7/view\nhttps://drive.google.com/file/d/1bXrYzHLWNb72c3U8wXisVzwkRXK6pXI7/view\nhttps://drive.google.com/file/d/1leNggxExGHTtJ5c3II2ORdZcXoTq_qjh/view\nhttps://drive.google.com/file/d/1neii7uuJjQwL28sGIux7OgMUNvJkDuki/view", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shikimiy/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1869513, "client_id": 1285861, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07ba9e3d/uploads/origins/c99fd8ac-f3e5-48c4-b541-a32a6ec862f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7a42dddcce995d1f08925624695e327", "srcset": "https://si.imgix.net/07ba9e3d/uploads/origins/c99fd8ac-f3e5-48c4-b541-a32a6ec862f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7a42dddcce995d1f08925624695e327, https://si.imgix.net/07ba9e3d/uploads/origins/c99fd8ac-f3e5-48c4-b541-a32a6ec862f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a7ec0e85193dd4561cc2c85aec7c334 2x, https://si.imgix.net/07ba9e3d/uploads/origins/c99fd8ac-f3e5-48c4-b541-a32a6ec862f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6853dc04dcb189154fec39fc1797601 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/07ba9e3d/uploads/origins/c99fd8ac-f3e5-48c4-b541-a32a6ec862f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a17f07f49765da863023a50738af437e", "srcset": "https://si.imgix.net/07ba9e3d/uploads/origins/c99fd8ac-f3e5-48c4-b541-a32a6ec862f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a17f07f49765da863023a50738af437e, https://si.imgix.net/07ba9e3d/uploads/origins/c99fd8ac-f3e5-48c4-b541-a32a6ec862f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4858bb43e20933ab1c52ca5b3dcf61e7 2x, https://si.imgix.net/07ba9e3d/uploads/origins/c99fd8ac-f3e5-48c4-b541-a32a6ec862f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd78ecf2bf9807eaa8f674f69f4da827 3x"}, "body": "初めまして。Twitterの検索で偶然あなたのイラストを拝見し\nとても柔和で綺麗な雰囲気が気になりまして…リクエストをさせて頂きたく思いました。\n私のOCであるハーフエルフの「エステル」を描いて頂けないでしょうか。\n参考URLです。https://drive.google.com/drive/folders/1p3UR3YiL5c9nTXWTeMbnXpgywSA3f5Lp?usp=sharing\n\n大雑把なデザインですので、ファンタジー系の衣装でしたらこの通りでなくともアレンジしても、またご自由に服装を考えて着せて頂いても問題ありません。\nまた、杖みたいなものはあっても無くても良いですし、参考URLにあるものとは別の新しい杖のようなものを自由にデザインして持たせてあげても良いです。\nただ、左側に付けている髪留めは外さないようにお願いします。（但し、髪留めの下に垂らしている装飾布についてはアレンジ可（例えば布ではなくビーズを垂らしたり、レースに変えてみたり等）・もしくは布が邪魔でしたら取っ払っても大丈夫です。）\n\n彼女について\n基本的には物静かで常にクールです。ハーフエルフなので、見た目以上に年齢は重ねているので多少の事では動じません。感情は控えめな感じで表に出します。\n魔術と薬学の技術を持ち、自分で薬を作ったりもします。（調合して売ったりもする）\n多少は体術の心得もあります。（護身術程度）\n趣味は読書で、物語を読んだりする事もありますが、魔術や薬学等の様々な学術書を読み日々研鑽を積んでいます。※これらの情報が表現の一助になれば幸いです。\n\nどのようにお描きになるかはお任せしますので、お値段の範囲内で仕上げて頂ければと思います。ご検討の程、宜しくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2846473, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Thomas", "screen_name": "Thomas44229762", "avatar_url": "https://pbs.twimg.com/profile_images/2025554676062830592/k49dMjA5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1429268313591324673/1731512053/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 3158309, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "85🍙", "screen_name": "D4ll_II", "avatar_url": "https://pbs.twimg.com/profile_images/2006356553230958592/hF4A7Hw_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1848534491629031426/1767190540/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 3188220, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "へへ", "screen_name": "hehe_713", "avatar_url": "https://pbs.twimg.com/profile_images/1827709946739478528/L6Ot3dA3.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 129}, {"id": 3605847, "creator": true, "nsfw_acceptable": fa