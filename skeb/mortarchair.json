ix.net/9ecac0c8/uploads/origins/24d5cdbc-d5f2-4652-a1b3-a56144a8d5b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=982ef04f0cf9aa74068392bf44ccff8f, https://si.imgix.net/9ecac0c8/uploads/origins/24d5cdbc-d5f2-4652-a1b3-a56144a8d5b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=19078f49a9df674a8cade6f1efbe150b 2x, https://si.imgix.net/9ecac0c8/uploads/origins/24d5cdbc-d5f2-4652-a1b3-a56144a8d5b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=338025ac9f5b392b3be1274abca5c28c 3x"}, "body": "こんにちは。以前描いていただいたように、私のキャラクター「ディンゴ」のレーシングスーツ姿のイラストをもう一枚お願いしたいです。https://drive.google.com/file/d/1ZrMtXa2ofENhwL_OaPEYqhEzKlnPqH-m/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1yGBXuv4yxKvIXhb70Fcmb3NFhOXcBl98/view?usp=drivesdk前回のイラスト（参考URLに添付したもの）で背景に描かれたピットクルーの表現がとても気に入っています。ガレージで彼らとやり取りする様子を描いていただけると嬉しいです。 中央にディンゴを配置し、左側にピットクルーの一人が紙片を見せながら今後のレース戦略について議論している様子を描いてください。ディンゴは右手で左拳を叩き、強気な姿勢で次のレース制覇に向け気合を入れ、戦略を信頼している様子を表現してください。ディンゴの右側には別のピットクルーがいて、彼の肩を軽く叩きながら幸運を祈っている構図です。\n\nhttps://drive.google.com/file/d/114xsJroRrAkc6AcNksTo5J27L4xe-sBk/view?usp=drivesdk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mortarchair/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3369190, "client_id": 3431859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7177458/uploads/origins/4000bc17-ed3f-42a1-8082-9d7c02d2918b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63e050fc836b4064aecc76ed2e04ce4f", "srcset": "https://si.imgix.net/c7177458/uploads/origins/4000bc17-ed3f-42a1-8082-9d7c02d2918b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63e050fc836b4064aecc76ed2e04ce4f, https://si.imgix.net/c7177458/uploads/origins/4000bc17-ed3f-42a1-8082-9d7c02d2918b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b62b82fde958a9aa125b043e747ef92 2x, https://si.imgix.net/c7177458/uploads/origins/4000bc17-ed3f-42a1-8082-9d7c02d2918b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e79403b704843950649a4e465ac84f4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c7177458/uploads/origins/4000bc17-ed3f-42a1-8082-9d7c02d2918b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1876afab96292e8cca4266ae182e2e10", "srcset": "https://si.imgix.net/c7177458/uploads/origins/4000bc17-ed3f-42a1-8082-9d7c02d2918b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1876afab96292e8cca4266ae182e2e10, https://si.imgix.net/c7177458/uploads/origins/4000bc17-ed3f-42a1-8082-9d7c02d2918b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cd68e81a1b0fd477ef3bff79d60503a6 2x, https://si.imgix.net/c7177458/uploads/origins/4000bc17-ed3f-42a1-8082-9d7c02d2918b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=00596e7010681ce55634dc3dac8909e4 3x"}, "body": "ヘイ、僕の邪悪な虎のキャラクターのアートをまたお願いしたいよ。\n\n街の路地裏で戦いを支配しているところを見たいんだ。虎は右膝をついてしゃがみこみ、右手で誰かの顔をコンクリートの床に押し付けている。虎は不吉な表情を浮かべ、満足そうに息をして煙を出している。背景には、タイガーに止めるよう懇願しながらそれを見ている他の人物がいる。\n\nタイガーのショーツはいつものようにボクシング・ショーツ・スタイルだ。\n\nタイガーがメインなので、他のキャラクターのデザインはお任せする。\n\nhttps://drive.google.com/file/d/1dEDuDrooQ85u9J6_-pb02T26OHu4uK_B/view?usp=drivesdk", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mortarchair/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3369190, "client_id": 3431859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d61e76ad/uploads/origins/7046b140-9716-48d9-a38d-fc175747a9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3e46c36b9c66f2fcb07f66fcc90bd91", "srcset": "https://si.imgix.net/d61e76ad/uploads/origins/7046b140-9716-48d9-a38d-fc175747a9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3e46c36b9c66f2fcb07f66fcc90bd91, https://si.imgix.net/d61e76ad/uploads/origins/7046b140-9716-48d9-a38d-fc175747a9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39725a1f2e0ea5a5d1e245d58ff69a20 2x, https://si.imgix.net/d61e76ad/uploads/origins/7046b140-9716-48d9-a38d-fc175747a9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf8eadaca3b8642046e51b4eafb80b57 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d61e76ad/uploads/origins/7046b140-9716-48d9-a38d-fc175747a9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48e1d62a5ff61c8d10c69aa743ae368b", "srcset": "https://si.imgix.net/d61e76ad/uploads/origins/7046b140-9716-48d9-a38d-fc175747a9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48e1d62a5ff61c8d10c69aa743ae368b, https://si.imgix.net/d61e76ad/uploads/origins/7046b140-9716-48d9-a38d-fc175747a9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=450d0be44c8783998823edaa2137f464 2x, https://si.imgix.net/d61e76ad/uploads/origins/7046b140-9716-48d9-a38d-fc175747a9b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=010e4bee600021ad7ee81e0009b70b78 3x"}, "body": "やあ、また僕だよ。また僕のために絵を描いてくれて構わないかな？\n\n以前描いてくれたレーシングスーツを着た大きなディンゴのキャラクター（前回は間違ったURLを送ってしまった。参考URLは彼の毛皮の色です）、そしてレーシングスーツを着た僕のキツネのキャラクターです（https://drive.google.com/file/d/1_EN71NViMYQ5UHIOdkuo4hQZBpNTQE0v/view?usp=drivesdk ）。\n\nレースが終わり、疲れ果てた2人がレース場からガレージへと歩いていくところ。ディンゴは右腕をフォックスの肩にかけ、左手に金のトロフィーを持ち、フォックスに勝ったことを誇示している。キツネはおどけたような表情を浮かべながら、あと一歩のところだったことを知り、次こそはディンゴに勝つと自信満々に笑っている。フォックスは右手に銀のトロフィーを持っている。\n\nトロフィーのデザインはお任せします。\n\n(ディンゴのレーシングスーツ） https://drive.google.com/file/d/1yGBXuv4yxKvIXhb70Fcmb3NFhOXcBl98/view?usp=drivesdk\n\n（フォックスのレーシングスーツ）\nhttps://drive.google.com/file/d/12iAYUhAmpxS9SlQcPsUMRha9cQTu7_4v/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1ZrMtXa2ofENhwL_OaPEYqhEzKlnPqH-m/view?usp=drivesdk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mortarchair/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3369190, "client_id": 3764763, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59252eeb/uploads/origins/84ca8e30-ac6c-4465-b2b1-47e1fdfcab06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51d5436789d3ee1ed0e2e335522d6d9d", "srcset": "https://si.imgix.net/59252eeb/uploads/origins/84ca8e30-ac6c-4465-b2b1-47e1fdfcab06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51d5436789d3ee1ed0e2e335522d6d9d, https://si.imgix.net/59252eeb/uploads/origins/84ca8e30-ac6c-4465-b2b1-47e1fdfcab06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95df5508ab3a1cbd5cb142292addae80 2x, https://si.imgix.net/59252eeb/uploads/origins/84ca8e30-ac6c-4465-b2b1-47e1fdfcab06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4c9738f667d5093a7e4f27c1a1d4587 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59252eeb/uploads/origins/84ca8e30-ac6c-4465-b2b1-47e1fdfcab06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=038cf92401acded2b681107703b5a5ac", "srcset": "https://si.imgix.net/59252eeb/uploads/origins/84ca8e30-ac6c-4465-b2b1-47e1fdfcab06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=038cf92401acded2b681107703b5a5ac, https://si.imgix.net/59252eeb/uploads/origins/84ca8e30-ac6c-4465-b2b1-47e1fdfcab06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c60727fbe0ee4700002d846270d0e9d3 2x, https://si.imgix.net/59252eeb/uploads/origins/84ca8e30-ac6c-4465-b2b1-47e1fdfcab06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6240c25c0c92862731e97123dd0364e8 3x"}, "body": "どうも、コムです。Foxです。あなたのアートスタイルで私の本のキャラクターを見たいので、私の本のアカウントからメッセージを送っています。\n\n洞窟の中でのんびりと眠っている彼らの鳥瞰図が欲しいです。ハンモックの両端を石筍に結びつけて、ハンモックの上に寝そべっている。ハンモックはタイガーがかろうじて入る大きさだ。毛布も枕もない。\n\nハイエナはサングラスをかけたまま寝ており、サングラスが今にも落ちそうな横向きで寝ている。\n\nイグアナはハンモックの上で丸くなって左側を向いて寝ている。\n\nタイガーはハンモックの中で仰向けになり、手足をハンモックの外に垂らしている。口を大きく開けていびきをかいている。\n\nhttps://drive.google.com/file/d/1tNOstFvhCemfD3cQJxqU9_ZsHUGKyFTF/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1tNOstFvhCemfD3cQJxqU9_ZsHUGKyFTF/view?usp=drivesdk", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mortarchair/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3369190, "client_id": 3431859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/caf39f7a/uploads/origins/ae59d6df-59ce-4b92-8713-ba225ba307b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27d6f2a73138025eba2fb88beb099100", "srcset": "https://si.imgix.net/caf39f7a/uploads/origins/ae59d6df-59ce-4b92-8713-ba225ba307b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27d6f2a73138025eba2fb88beb099100, https://si.imgix.net/caf39f7a/uploads/origins/ae59d6df-59ce-4b92-8713-ba225ba307b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=358960fca27dd46c1673002da1e9af94 2x, https://si.imgix.net/caf39f7a/uploads/origins/ae59d6df-59ce-4b92-8713-ba225ba307b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70885fb46bf0904d5ee14cab1e0c32b1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "http