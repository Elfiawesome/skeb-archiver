5b3-2022557e3a33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b75d89c313c7e16c46a726997cd97ac 2x, https://si.imgix.net/6bc0a837/uploads/origins/c1db2170-62fa-470c-95b3-2022557e3a33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d0229752f9fdca9f0cdf8503d1f1cf6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6bc0a837/uploads/origins/c1db2170-62fa-470c-95b3-2022557e3a33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17d3b7def8f72f2a2cac84dbbf837cdf", "srcset": "https://si.imgix.net/6bc0a837/uploads/origins/c1db2170-62fa-470c-95b3-2022557e3a33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17d3b7def8f72f2a2cac84dbbf837cdf, https://si.imgix.net/6bc0a837/uploads/origins/c1db2170-62fa-470c-95b3-2022557e3a33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b28575ba1bca33ed0ced27205b12e0a 2x, https://si.imgix.net/6bc0a837/uploads/origins/c1db2170-62fa-470c-95b3-2022557e3a33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb22149975d37be7838f8fcf41ee03b3 3x"}, "body": "いわゆるJK化のイラストを依頼します。\n\n身長…149cm\n髪…オレンジでさらさら\n目…ピンクで涼しげ\n得意科目…美術\nバスト…D\n特徴…すごい早寝\n性格…なまけもの。おせっかいな子とは相性よし\n\n・衣装はオープンバストのボンデージで、胸を露出させている。タイツやその他装飾品の有無はおまかせ。\n・既に前戯をしており、身体や衣装に精液がかかっています。\n・普段は大人しい子ですが、彼氏君をこの衣装で責めているうちに興奮し、Sっ気に目覚め始めてゾクゾクしているような表情をしています。\n・竿役の描写の有無はどちらでも構いませんが、描かれる場合は顔は写らないようにと、ムダ毛等の汚くなる描写がないようにお願いします。\n・女の子の台詞、その他擬音の有無もどちらでも構いません。竿役の台詞は無し。\n\n・胸やふとももはお好みで盛っていただいて構いません。\n\n参考資料\nhttps://twitter.com/moapxp/status/1488432029276721152", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@manjudou38/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1749256, "client_id": 1351280, "vtt_url": null, "thumbnai