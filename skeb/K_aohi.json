願いさせて頂きたいです。\n・キャラクターのみを素材として使用することもあるので、キャラクターと背景をレイヤー分けしていただけると嬉しいです。\n・アスペクト比はお任せいたします。\n\n＊使用用途について\n配信サムネイルやSNS上の宣伝などに使用したいと思っております。\n\nまた、大変恐縮なのですが、Twitter投稿の際には、「#描くたー部」「#優音」をつけて頂けますと嬉しいです。\n\nご検討いただけますと幸いです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/181YkuV0LdXfzXpLsyvcwOtxrveNXbLFJ?usp=sharing\n\nhttps://drive.google.com/drive/folders/181YkuV0LdXfzXpLsyvcwOtxrveNXbLFJ?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@K_aohi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 401070, "client_id": 669786, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0de3b0f/requests/128912_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=645802182fe3e5be4132d094efc0968d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0de3b0f/requests/128912_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d128c2f6bf9e5fea00a50487ce7d535a", "src_set": ""}, "body": "アークナイツのグラウコスを描いてほしいのですが可能でしょうか？\nアイコンに使用したいです。よろしくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 462551, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あまがさなだめ", "screen_name": "amagasa_nadame", "avatar_url": "https://pbs.twimg.com/profile_images/1585253581661540354/SDzp6znH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1178739606822408193/1667481969/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "skills": [{"genre": "art"}], "nc": 160}, {"id": 1619848, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "hotate/お仕事募集中", "screen_na