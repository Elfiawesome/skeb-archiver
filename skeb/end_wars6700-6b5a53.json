0ef0d38/uploads/origins/51f590ae-3341-4554-abf1-5abfe0dabbff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44ef86da50f6d2c1d820bc39d31d2ddc", "srcset": "https://si.imgix.net/20ef0d38/uploads/origins/51f590ae-3341-4554-abf1-5abfe0dabbff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44ef86da50f6d2c1d820bc39d31d2ddc, https://si.imgix.net/20ef0d38/uploads/origins/51f590ae-3341-4554-abf1-5abfe0dabbff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b987acdcc2b11826fcaed7b0c525b685 2x, https://si.imgix.net/20ef0d38/uploads/origins/51f590ae-3341-4554-abf1-5abfe0dabbff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c68f332d01bb701972898e6dc888f804 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20ef0d38/uploads/origins/51f590ae-3341-4554-abf1-5abfe0dabbff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc842fcae04e6aaaf7594246e291a2a0", "srcset": "https://si.imgix.net/20ef0d38/uploads/origins/51f590ae-3341-4554-abf1-5abfe0dabbff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc842fcae04e6aaaf7594246e291a2a0, https://si.imgix.net/20ef0d38/uploads/origins/51f590ae-3341-4554-abf1-5abfe0dabbff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa3f76560bdfbfc6ddceb2370830c1ef 2x, https://si.imgix.net/20ef0d38/uploads/origins/51f590ae-3341-4554-abf1-5abfe0dabbff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8b88d1a319508630167ea4e947011cd9 3x"}, "body": "お久しぶりです、今回は同人ゲーム【モンスター娘に滅ぼされた村3】に登場するモモ(ふたなりガキュバス)が\n主人公のユーリを犯すイラストをお願いします\n※作者様にSkeb依頼OKの確認済みです\n\nモモの立ち絵はこちらで→https://ci-en.dlsite.com/creator/16492/article/1065638\n身長125cm\n3サイズ101-44-62\nペニス39cmのイメージとの事です\n\n\n主人公のユーリは左上の金髪の少年→https://ci-en.dlsite.com/creator/16492/article/836061\n身長150cm\nペニス12cmのイメージです\n\n\n構図は過去に描かれたこちらの1枚目の様に→https://www.pixiv.net/artworks/113592962\nパイズリ逆アナルでずぷぅう♥っと挿入\n↓\nゆっくりとピストン\n↓\n激し目のピストン＆ノーハンドパイズリで胸を揺さぶりペニスも攻める\n↓\nアナルに中出し+メスイキ射精でお願いします\n\n\nモモは服は着ていますが、おっぱいは露出で乳首は見えている感じで\nユーリは構図の様に主観視点で、台詞は無く喘ぎ声のみで\n挿入された時はお゛っ♥とオホ声で、中出し時はメス喘ぎをお願いします\nモモは「...女の子みたいに喘いでるユーリ、とっても可愛いよ♥」\nとユーリをメス扱い＆パイズリでも気持ちよくして搾り取る感じで\nダウナーな娘なので台詞は「...」と3点リーダー多めで\n逆レ気味ですが、甘やかしながらメスイキに導く感じでお願いします", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@end_wars6700/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2050, "client_id": 246273, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b1e28ef0/uploads/origins/af090ed2-588b-4263-8908-dd869ba5bc43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85e17051842964051a4f207631c75ad0", "srcset": "https://si.imgix.net/b1e28ef0/uploads/origins/af090ed2-588b-4263-8908-dd869ba5bc43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85e17051842964051a4f207631c75ad0, https://si.imgix.net/b1e28ef0/uploads/origins/af090ed2-588b-4263-8908-dd869ba5bc43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ccb2f4147253f54dbf3a1b644d172b03 2x, https://si.imgix.net/b1e28ef0/uploads/origins/af090ed2-588b-4263-8908-dd869ba5bc43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcca0257833ef56e5b06b7cda7642110 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1e28ef0/uploads/origins/af090ed2-588b-4263-8908-dd869ba5bc43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92b5f0fc27413359eca2a5980aa1b54b", "srcset": "https://si.imgix.net/b1e28ef0/uploads/origins/af090ed2-588b-4263-8908-dd869ba5bc43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92b5f0fc27413359eca2a5980aa1b54b, https://si.imgix.net/b1e28ef0/uploads/origins/af090ed2-588b-4263-8908-dd869ba5bc43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=624e9ecb310022b102345222cf4f9dd4 2x, https://si.imgix.net/b1e28ef0/uploads/origins/af090ed2-588b-4263-8908-dd869ba5bc43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d0dea311ffdd282b0916a07bc5ff3fa 3x"}, "body": "今回もふたなりのアルス・アルマルに犯されるモブ盗賊のシチュをカラー漫画形式でお願いします\n\nシチュ\n捕えている盗賊に新魔法の分身で犯す事を宣言する\n↓\n分身に成功し、男にふたなりペニスを見せつける(本人と同じく通常衣装で、フード無しが分身です)\n分身「うわｗコイツのちんこちっさいなぁｗ女のボクに大きさで負けるなんて、恥ずかしくないの？ｗ」\nと分身は初見のリアクションをする感じです\nこちらの構図で二人のアルスの顔は写ってない感じで(着衣巨乳おっぱいまで写る感じです)→https://www.pixiv.net/artworks/108289453\n↓\n分身にアナル舐めパイズリされながら、本物に逆フェラで犯される\n(構図→https://www.pixiv.net/artworks/107467156)\n↓\n分身に逆アナルで犯されながら、本物にパイズリ＆逆フェラで犯される\n(構図が無かったのでイメージなのですが、正常位で分身に犯されながら男にのしかかった本人が男のペニスをパイズリしながら\n逆フェラさせる感じです)\n※こちらの構図が厳しい場合は、別の構図に変えていただいても大丈夫です。\n↓\n二人のアルスに射精され、男が情けなくメスイキする\n↓\n本物「手コキされながら分身に犯されるの気持ちいいだろ～♥」\n分身「ボクが消えるまで犯し続けてやるからな♥」と\n本物におっぱいを押し付けられながら手コキ＆分身が消えるまで逆アナルで犯される\n(こちらの構図に分身の逆アナルが追加されたような感じです→https://www.pixiv.net/artworks/111008903)\n\n\nアルスは前回と同じくロリ爆乳、ふたなりペニスは玉あり巨根で\n最初からふたなり状態でお願いします\n男は裸で台詞は喘ぎ声のみです\n擬音多めで前立腺と断面図描写をお願いします\n分身と本人の台詞は二人とも男を罵倒したりペニスサイズ差を馬鹿にする感じで\nアルスの巨乳を強調する描写が多いと嬉しいです", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@end_wars6700/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2050, "client_id": 246273, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4501b3d6/uploads/origins/1daaef5f-fc4f-48b5-8856-76bab64af06d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88ef3e0e6a3807ccd5729d66992ec2fa", "srcset": "https://si.imgix.net/4501b3d6/uploads/origins/1daaef5f-fc4f-48b5-8856-76bab64af06d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88ef3e0e6a3807ccd5729d66992ec2fa, https://si.imgix.net/4501b3d6/uploads/origins/1daaef5f-fc4f-48b5-8856-76bab64af06d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3357aaf33455b3d46f0fe28ddb85c5a0 2x, https://si.imgix.net/4501b3d6/uploads/origins/1daaef5f-fc4f-48b5-8856-76bab64af06d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=679519a2be1f715546f4c7d11d2d8e4d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4501b3d6/uploads/origins/1daaef5f-fc4f-48b5-8856-76bab64af06d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0c1f6e32a6638eec5a2e8d9668a04d4", "srcset": "https://si.imgix.net/4501b3d6/uploads/origins/1daaef5f-fc4f-48b5-8856-76bab64af06d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0c1f6e32a6638eec5a2e8d9668a04d4, https://si.imgix.net/4501b3d6/uploads/origins/1daaef5f-fc4f-48b5-8856-76bab64af06d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=be4cf5fd9d333d948bbbbd200cc3e5a2 2x, https://si.imgix.net/4501b3d6/uploads/origins/1daaef5f-fc4f-48b5-8856-76bab64af06d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a1089971d79e2f9053633876690d84a 3x"}, "body": "今回はふたなりのアルス・アルマルに犯されるモブ盗賊のシチュを\nカラー漫画形式でお願いします\n\nシチュ内容\n洞窟で盗賊に襲われるもアルスが魔法で返り討ちにしながら\n「女一人だからってボクに勝てると思ってたの？ｗ」と煽る\n↓\n「新しい魔法の実験台にしてやるよｗ」といいふたなり化の魔法を\n使用し、巨根玉ありペニスを生やす(ボロン♥という擬音付き)\n↓\n盗賊のペニスを露出させて、兜合わせ\n「体はボクより大きいのにチンポはくそ雑魚じゃんｗ」と馬鹿にしながら\n擦り、射精させる\n↓\n盗賊の足を抱えながら爆乳パイズリ+逆アナルで攻める\n(構図→https://www.pixiv.net/artworks/100461798)\n↓\n男が先にパイズリの快楽で射精してしまうと\n「ボクより先に出しやがって!!」とキレながら\n男の手を掴みパイズリ逆アナル再開\n(こちらの構図に→https://www.pixiv.net/artworks/105287609\nふたなりペニスが前立腺を突いている表示をお願いします)\n↓\n男にふたなりザーメン中出し+男が再びメスイキ射精する\n↓\n「次はどんな魔法つかおっかなぁ～♥」と考えながら\nパイズリ逆アナルで満足するまで男を犯す\n\nアルスは通常衣装でおっぱいは前回の鈴原と同じくらいのロリ爆乳で\n男の背丈は170cmほどで、アルスは140cmほどのロリ体系で\nペニスサイズはアルスが20cm以上の玉ありで、男は短小でお願いします\n擬音多めで前立腺と断面図描写をお願いします\n逆アナルのシーンは全てパイズリ+逆アナルで\n色々な角度でアルスのロリ爆乳を描いて欲しいです\n台詞は上記のような感じで体格で優っている男に対して\nふたなりペニスでマウントを取り、劣等感を感じさせるような\nM向けの台詞でお願いします", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@end_wars6700/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2050, "client_id": 246273, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4894e4a5/uploads/origins/02dbd032-ccab-4cde-93f6-d5e1e455ba5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1638701632653779a4a13ec35c0eb05b", "srcset": "https://si.imgix.net/4894e4a5/uploads/origins/02dbd032-ccab-4cde-93f6-d5e1e455ba5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1638701632653779a4a13ec35c0eb05b, https://si.imgix.net/4894e4a5/uploads/origins/02dbd032-ccab-4cde-93f6-d5e1e455ba5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ae5579c85c3e9bf6bebd47b0edf4e1c 2x, https://si.imgix.net/4894e4a5/uploads/origins/02dbd032-ccab-4cde-93f6-d5e1e455ba5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1b9021b3b5c57db316abd908ad5f199 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4894e4a5/uploads/origins/02dbd032-ccab-4cde-93f6-d5e1e455ba5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbbc2475eed0b0e993259ebbf5ed589e", "srcset": "https://si.imgix.net/4894e4a5/uploads/origins/02dbd032-ccab-4cde-93f6-d5e1e455ba5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbbc2475eed0b0e993259ebbf5ed589e, https://si.imgix.net/4894e4a5/uploads/origins/02dbd032-ccab-4cde-93f6-d5e1e455ba5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ace4a9a845d0d5f6bb6b7f99597cb7f 2x, https://si.imgix.net/4894e4a5/uploads/origins/02dbd032-ccab-4cde-93f6-d5e1e455ba5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4bf37b81578c59604affaaa9e88bf0b6 3x"}, "body": "早速ですが前回の続きで\nふたなりのリゼ様がふたなりの鈴原るると一緒に男を犯すシチュを\nカラー漫画形式でお願いします\n(構図が難しい場合はプレイ内容を変更していただいて大丈夫です)\n\n\nシチュ内容\nリゼ様がバックから逆アナルでマゾ男を犯している時に、鈴原が現れる\n↓\nふたなりであることを明かし、二人で見せ槍(座っている男にペニスで両目を隠す感じで)\n↓\nＷ逆フェラで男の喉奥を犯し、大量射精する\n↓\n鈴原の爆乳でパイズリされながら正常位逆アナル+リゼ様に逆フェラで犯される\n(イメージはこちらに逆フェラが加わった感じです→https://www.pixiv.net/artworks/102947614)\n↓\n鈴原に簡単に持ち上げられ背面逆駅弁でケツマンコを犯される\n+リゼ様の巨根と兜合わせ\n(この状態で更に兜合わせされる感じです→https://www.pixiv.net/artworks/72460236)\n↓\n鈴原に中出しされる＆リゼ様にふたなりザーメンをぶっかけられてしまいメスイキ\n\n\nリゼ様は前回と同じ衣装で\n鈴原は通常衣装で\nふたなりペニスはリゼ様と同じサイズで玉あり、おっぱいはリゼ様より大きめの爆乳で\nパイズリの時はおっぱいを露出で\n擬音多めで前立腺と断面図描写をお願いします\nリゼ様の台詞は前回同様マゾ心をくすぐる感じで\n鈴原は表情は笑顔多めで、リゼ様と仲良しですが\n男に対しては台詞はドSで\n「本気で犯すから、壊れないでね♥」っと\n男をめちゃくちゃに犯す感じで\n最終的に男は二人の共用オナホになってしまう\n展開でお願いします", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@end_wars6700/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2050, "client_id": 246273, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/10a97fb0/uploads/origins/5808fe8a-ff29-4925-8db3-ae4e10b73c93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8df16a1313216c787a8c87734a6b96c7", "srcset": "https://si.imgix.net/10a97fb0/uploads/origins/5808fe8a-ff29-4925-8db3-ae4e10b73c93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8df16a1313216c787a8c87734a6b96c7, https://si.imgix.net/10a97fb0/uploads/origins/5808fe8a-ff29-4925-8db3-ae4e10b73c93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c92f43344c31910bfaf92eda58b22b5 2x, https://si.imgix.net/10a97fb0/uploads/origins/5808fe8a-ff29-4925-8db3-ae4e10b73c93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6361432ffeddc4a473b2f353c4aa21a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10a97fb0/uploads/origins/5808fe8a-ff29-4925-8db3-ae4e10b73c93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb0385b7e141997d0a7f8232787bec96", "srcset": "https://si.imgix.net/10a97fb0/uploads/origins/5808fe8a-ff29-4925-8db3-ae4e10b73c93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb0385b7e141997d0a7f8232787bec96, https://si.imgix.net/10a97fb0/uploads/origins/5808fe8a-ff29-4925-8db3-ae4e10b73c93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63c365c873da8a7e9a7ee737eaf538d1 2x, https://si.imgix.net/10a97fb0/uploads/origins/5808fe8a-ff29-4925-8db3-ae4e10b73c93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=11e8c76ef47484b03dd18e5fe1f6041d 3x"}, "body": "ウオーズさんの同人誌のような\nふたなり逆アナルシチュが好きなのでよろしければお願いします\nふたなりのリゼ・ヘルエスタがモブ男を犯すシチュをお願いします\n\n可能でしたらカラー漫画形式でお願いします\n(内容多い場合はモノクロに変更や、シチュの短縮をしていただいて大丈夫です)\n\n\nシチュ内容\nマゾ男がふたなりペニスで犯して欲しいとリゼに頼む\n↓\n最初は困惑するが、男がふたなり好きなマゾであることが分かると、ふたなりペニスをたくし上げて見せつける\n↓\n兜合わせ手コキで男を射精させる\n↓\n正常位逆アナル+手コキで男が射精し、リゼも男に中出し\n↓\n逆アナル騎乗位になり男にヘコ♥ヘコ♥と腰を降らせる\n↓\n男が勝手にところてん射精すると、オシオキとして逆アナル騎乗位ピストンでガチハメして\nメスイキさせる\n\n\n二人の背丈は同じくらいで(150cm程で)\nリゼは通常衣装で、プレイ中は常に着衣でペニスのみ露出で\nリゼのペニスは20cm程の玉ありでおっぱいはこのくらいの巨乳で→https://www.pixiv.net/artworks/99407785\n男は13cm程で(サイズ差1.5倍程で)\n擬音多めで逆アナル中に断面図の表示をお願いします(男に直接で、前立腺がキュン♥っとする描写が欲しいです)\n男は台詞無しで\nリゼの台詞は丁寧な口調ながらも\n男のマゾ心をくすぐりながら\nメスイキに導くような感じでお願いします", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 226425, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "しば🔞", "screen_name": "seavalog", "avatar_url": "https://pbs.twimg.com/profile_images/2037902584649027584/4_jDMZJk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/977488736/1774325852/1500x500", "appeal_receivable": false, "popular_creat