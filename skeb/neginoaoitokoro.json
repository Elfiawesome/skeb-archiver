xtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c25ceaa45a54ec0fcc948ab0820ffae4", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 1906333, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@neginoaoitokoro/works/151", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1906333, "client_id": 1160534, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3679f3fa/uploads/origins/ce0d7906-526d-4d1d-9519-80b6fb80edda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d71432c987deeebe7630635dd9efd10", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3679f3fa/uploads/origins/ce0d7906-526d-4d1d-9519-80b6fb80edda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75706deee81b0a99e85bb912dafe713f", "src_set": ""}, "body": "ほしねぎさん、はじめまして！！リクエスト受付再開嬉しいです！！\n是非コミックをお願いしたいと思い、この度リクエストに参りました。\nよろしければ私とフォロワーさんのTRPGのキャラクターで描いていただきたくリクエストに参りました。（フォロワーさんに許可は頂き済みです）\n\n使用用途は個人鑑賞、X（旧Twitter）で【ほしねぎさんに描いていただきました】と明記の上使用、自分用に印刷を考えています。\n何か不都合等ありましたら再送信やキャンセル等して頂ければと思います。\n\n【描いて頂きたいキャラクター】\n◆キャラクター\n名前：ヘリオス・ローリエ\n男、18歳、178センチ、後述のリーズニィよりしなやかでそこそこ筋肉がついている\n・緩やかなウェーブのプラチナブロンド。\n・腰下まである髪をローポニーテールで結んでいる。\n・下まつ毛のあるスカイブルーのタレ目（ハイライトなしで瞳孔が白い丸）、釣り眉、目元に\"泣きぼくろ\"がある。\n・感情と表情は豊かだが、表現は上品。\n・整った顔立ちで、見た目はスタンダードな王子様みたいなイメージ。\n・口を開くと八重歯が目立つのを気にしている。\n・イングランド・サマセットのパブリックスクール第五寮の寮長。\n・穏やかで自罰的。献身的、他人本位で自分をおろそかにしがち。\n・努力家で秀才タイプ。\n・恥ずかしいとおもっているが、妖精や童話が好き。\n・モチーフはうさぎ、紅茶、月桂樹の葉っぱ、明けない夜か朝焼け。\n・不特定多数の前ではきりっとしているが、プライベートではふわふわしている。\n・リズくんに対して、心配をかけてすまないなとおもっている。\n・リズくんのことは「リズ」と呼ぶ。\n\n名前：リーズニィ・メルヴィル\n男、17歳、165センチ、細身。\n・癖っ毛で銀髪。\n・腰まである髪を後ろでゆるく結んでいる。\n・青いジトツリ目。ハイライトなし。\n・表情は仏頂面で固めだが、喜怒哀楽はある。\n・外見は平均よりやや良い顔立ち。\n・イングランド・サマセットのパブリックスクール第五寮の寮生。\n・黒いガウンを羽織っている。\n・頭の回転が早い。\n・社会常識は弁えているが、自分の中にある物差しを優先する。図太い変人タイプでマイペース。\n・クールと言うか、ふてぶてしい。雑で遠慮がない。\n・植物が好き。\n・モチーフは本、植物、フクロウ。\n・無茶しがちなヘリオスに対して、心配したりうっすらイラッとしている。\n・ヘリオスのことは「ヘリオス」と呼ぶ。\n\n関係性は【なんだかんだ互いを心配したり気にしている】感じです。精神的な力関係はリズくん＞ヘリオスなイメージです。十中八九リズくんにヘリオスが言い負かされています）\n\nシチュエーションとしては、あまり自分を顧みないヘリオスが怪我をしたり、無理をして、それに無表情ながら少し眉根をよせてイラッとしているリズくんが、ヘリオスに冷静に言葉でつめより、ヘリオスがあうあうしている感じだと嬉しいです。\nヘリオスも心配をかけて申し訳ないな…と思っているのと元々の性格上たじたじしています。\nリズくんは植物が好きなので、自前で用意したポプリとか植物の本をそっと差し出して、機嫌をとろうとしますが、あえなく失敗して静かに叱られているようなイメージです。（ただしポプリや本はリズくんが受け取ってくれます）\n\n参考用の画像は下記の資料URLに添付しておりますので、ご確認ください。服装は、どれで描いていただいても大丈夫です。わからない部分は想像で描いていただければと思います。\n他、自由に描いていただければ幸いです。\n\nご都合等よろしければ何卒よろしくお願い申し上げます！\n\nhttps://www.dropbox.com/scl/fo/dvcezo2p3izij9fl6mhbr/AD3OMrpTZdRkaBj2ZnKqR5c?rlkey=622pdyiuxtuwtv2jwdfdvu28p&dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@neginoaoitokoro/works/150", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1472fe2f/uploads/origins/187f3e4f-c6a4-4e16-867b-17faaa71beb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76847e0cf9d07de60fd672ce44c650ed", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1906333, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@neginoaoitokoro/works/149", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1906333, "client_id": 1638628, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19338697/uploads/origins/2a6ee6df-8f52-43bc-bdd3-dcdc3cc89fd4?bg=%23fff&auto=f