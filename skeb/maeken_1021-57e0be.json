出来る限り別レイヤーで）\n\n\n■利用目的\n「甘園房」シリーズの宣伝等を目的として、当方のSNS等に投稿させて頂きたいです。\n\n＊＊＊＊＊\n\n以上、ご検討のほどよろしくお願いいたします。\n\nhttps://www.dlsite.com/maniax/work/=/product_id/RJ389425.html", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maeken_1021/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1641926, "client_id": 504468, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6f980df/uploads/origins/b0e6a834-3b9c-4157-8294-a471b5b12430?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0db60ce9fa86f7d2e2bcd01ade458541", "srcset": "https://si.imgix.net/b6f980df/uploads/origins/b0e6a834-3b9c-4157-8294-a471b5b12430?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0db60ce9fa86f7d2e2bcd01ade458541, https://si.imgix.net/b6f980df/uploads/origins/b0e6a834-3b9c-4157-8294-a471b5b12430?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c3322767f96c31c88940fc6c0ad369b 2x, https://si.imgix.net/b6f980df/uploads/origins/b0e6a834-3b9c-4157-8294-a471b5b12430?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4022f6c2c9c92f7f4749f029a7c77787 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6f980df/uploads/origins/b0e6a834-3b9c-4157-8294-a471b5b12430?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce47f76d010f96371d325a9bb18bf994", "srcset": "https://si.imgix.net/b6f980df/uploads/origins/b0e6a834-3b9c-4157-8294-a471b5b12430?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce47f76d010f96371d325a9bb18bf994, https://si.imgix.net/b6f980df/uploads/origins/b0e6a834-3b9c-4157-8294-a471b5b12430?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2961f9f67bbaf7af645b5a6bbd6dba89 2x, https://si.imgix.net/b6