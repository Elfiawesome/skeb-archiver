80-71c6478cef47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6360ec35de840994f1a39dbee604e406", "srcset": "https://si.imgix.net/021b9af7/uploads/origins/d4f3bfd0-23e8-4543-8d80-71c6478cef47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6360ec35de840994f1a39dbee604e406, https://si.imgix.net/021b9af7/uploads/origins/d4f3bfd0-23e8-4543-8d80-71c6478cef47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f43f3fe981b69e5af9a432c059a59513 2x, https://si.imgix.net/021b9af7/uploads/origins/d4f3bfd0-23e8-4543-8d80-71c6478cef47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c8e93bea1d854de14f7e3c1daad16368 3x"}, "body": "Hello.\nWould you like drawing my 2 OCs Kiara (pink hair) and Ilyana (blue hair)?\nA half body pic.\nThe girls are very cute yet so different in terms of personality.\nKiara is over enthusiastic, naive and lively.\nIlyana is shy, insecure, introverted.\nThey are good friends so they are standing next to each other very closely.\nKiara's arm is around Ilyana's neck.\nThe other arm is raised upright.\nShe looks like she wants to jump or cheer.\nShe looks very happy with the mouth wide open.\nOne eye is closed.\n\nIlyana meanwhile has her arm around Kiara's hip.\nShe squints at Kiara with an insecure, shy expression.\nIlyana also has mole in her face.\n\nTheir height is the same.\nTheir breast size is different.\nKiara's breasts are smaller (K-Cup) than Ilyana's (M-Cup).\n\nKiara wears this outfit: https://www.deviantart.com/stash/02bbeaoqo9zk\nIlyana wears the purple outfit that covers her breasts. See references 1, 5, 7.\n\nThank you!\n\n\nこんにちは。\n私の2人のOCであるキアラ(ピンクの髪)とイリヤナ(青い髪)を描いてみませんか?\n半身の写真です。\n女の子たちはとてもかわいいですが、性格の面では大きく異なります。\nキアラは非常に熱心で、素朴で、活発です。\nイリヤナは内気で、自信がなく、内向的です。\n彼らは仲が良いので、とても近くに並んでいます。\nキアラの腕がイリヤナの首に回ります。\nもう一方の腕はまっすぐに上げられます。\nジャンプしたり応援したりしたいようです。\nキアラは口を大きく開けてとても幸せそうです。\n片目は閉じています。\n\n一方、イリヤナはキアラの腰に腕を回しています。\n彼女は不安で内気な表情でキアラを見つめます。\nイリヤナの顔にもほくろがあります。\n\n彼らの身長は同じです。\n彼らの胸の大きさは異なります。\nキアラの胸はイリヤナの胸 (M カップ) よりも小さい (K カップ)。\n\nキアラはこの衣装を着ています: https://www.deviantart.com/stash/02bbeaoqo9zk\nイリヤナは胸を覆う紫色の衣装を着ています。 参考文献 1、5、7 を参照してください。\n\nありがとう！\n\nhttps://drive.google.com/drive/folders/1berykvdd4OGXrRRE0kKOFr-cl-b3b-zw", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maeken_1021/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1641926, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1d70e69/uploads/origins/a10725cf-29b9-4e5e-a4b7-0a035cfda5f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52ff08d1a58b3005767f3e79a3f45545", "srcset": "https://si.imgix.net/c1d70e69/uploads/origins/a10725cf-29b9-4e5e-a4b7-0a035cfda5f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52ff08d1a58b3005767f3e79a3f45545, https://si.imgix.net/c1d70e69/uploads/origins/a10725cf-29b9-4e5e-a4b7-0a035cfda5f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05c616c21c2a6b293fdc2479894fb3a8 2x, https://si.imgix.net/c1d70e69/uploads/origins/a10725cf-29b9-4e5e-a4b7-0a035cfda5f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe540b159cea76e0eb6d21be675acb9b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1d70e69/uploads/origins/a10725cf-29b9-4e5e-a4b7-0a035cfda5f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6c882e7bbed946ab9800697385268b9", "srcset": "https://si.imgix.net/c1d70e69/uploads/origins/a10725cf-29b9-4e5e-a4b7-0a035cfda5f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6c882e7bbed946ab9800697385268b9, https://si.imgix.net/c1d70e69/uploads/origins/a10725cf-29b9-4e5e-a4b7-0a035cfda5f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=808bdb91c0b722cd18660deb78e0ca29 2x, https://si.imgix.net/c1d70e69/uploads/origins/a10725cf-29b9-4e5e-a4b7-0a035cfda5f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c51fece6240adf82603db9000a641b08 3x"}, "body": "あんてぃー様\n\nお世話になります。\n以前、あんてぃー様が描いたライザが可愛くてドストライクだったので、リクエストさせていただきます。\n\n《キャラクター》\nライザリン・シュタウト (ライザのアトリエ3) →参考URL①,  ②\nムチムチで太ももは太くお願いします。\n\n《構図・ポーズ等》\n以前描いている構図で申し訳ございませんが、参考URL③(エウルア)の構図とポーズでお願いします。\n但し、下記の3点を加味してください。\n・ホットパンツの食い込みは参考URL③と同じくらい\n・尻に視線を下げている\n・食い込みに違和感を感じている表情\n\n可能であれば、無地の黒のサイハイソックス(テカテカしていない)を履いた差分を希望しますが、金額に見合わなければ無視してください。\n\n細かく要望を書きましたが、描きづらかったり分かりにくい箇所があれば、あんてぃー様が自由に変更・省略していただいて大丈夫です。\n\n以上、ご検討のほど宜しくお願いいたします。\n\n参考URL①→ https://www.pixiv.net/artworks/109676426\n\n参考URL②→ https://misskey.io/notes/9pdr8tkhq2tb012e\n\n参考URL③→ https://pbs.twimg.com/media/F_Ln5KKaoAAGlXo?format=jpg&name=large", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maeken_1021/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1641926, "client_id": 414017, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/04cd92ea/uploads/origins/666ead96-83ff-442c-ad94-ba24dca3d7e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e218436e7f7bfdc760c32245bd9a43d", "srcset": "https://si.imgix.net/04cd92ea/uploads/origins/666ead96-83ff-442c-ad94-ba24dca3d7e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e218436e7f7bfdc760c32245bd9a43d, https://si.imgix.net/04cd92ea/uploads/origins/666ead96-83ff-442c-ad94-ba24dca3d7e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21c5a5b2519cccf00c6bf86d86214f9a 2x, https://si.imgix.net/04cd92ea/uploads/origins/666ead96-83ff-442c-ad94-ba24dca3d7e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&