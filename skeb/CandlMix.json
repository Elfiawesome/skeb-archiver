c/uploads/origins/6e633d8b-1836-4172-a350-980d3a56d658?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4534858371fcfe39d59d16c1fa03b643", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c5a483c/uploads/origins/6e633d8b-1836-4172-a350-980d3a56d658?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82995a3f015c1189ed2b4251e498b4c1", "src_set": ""}, "body": "私のオリジナルキャラクターのアートワークを依頼したいです。キャラクターのデザインは参考URLに添付しています。玉座に座っている姿を希望しています。玉座は足があるのではなく、床の一部で、石でできています。左手は椅子の肘に置いているが、右手は上に向けていて、その周りに魔法の炎が燃えている。部屋は火に包まれ、小さな燃えかすが宙に浮いている。\n\nキャラクターの姿勢とパースはこんな感じにしてほしいです：\nhttps://heathkliff.tumblr.com/image/188906618414\n\nこのような玉座が欲しいのですが、椅子の背もたれが短いので、https://www.pinterest.com/pin/639863059578401669/。\n\n本当にありがとうございました！\n\nhttps://twitter.com/RuinTheArmor/status/1460607025797206020", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@CandlMix/works/33", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 276261, "client_id": 102956, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e8c1f88/uploads/origins/8f50d025-358e-4d8f-9014-937e2d458a58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e0239513f399d818f4fdf09a23b682b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e8c1f88/uploads/origins/8f50d025-358e-4d8f-9014-937e2d458a58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b16721f9d859400c117995256ffd6b3", "src_set": ""}, "body": "mixさんこんにちは。\n今回は私がVRCしているアバターの一つをリクエストします。\n多眼で宝石の角を持つアバターで鎧みたいなものを着ている状態のものをお願いします。\n出来れば棒立ちではなくキメポーズや躍動感のある一場面のようなイラストをお願いします。\nPCの壁紙としての使用を想定しています。\n資料はURLのツイートとそのリプにある動画、及びVroid Hubを参照してください。\n\nhttps://twitter.com/snowy_frappe/status/1608164787720196097?s=20&t=ZV-voF3SsxBK8FplgUp-Gw", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@CandlMix/works/32", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 276261, "client_id": 1090171, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d656ee48/uploads/origins/58d2217c-e67f-41b2-b10c-e91cc640be0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c0a19081a4a2f8795ad5dd79fe02e16", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d656ee48/uploads/origins/58d2217c-e67f-41b2-b10c-e91cc640be0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dfa458973e4b2df7f9d5d283de3e4d3", "src_set": ""}, "body": "以前作っていただいたゲートガードラムの手数料です。\n\n羊、ヤギ、鹿、ヘラジカ、ヘラジカの骨格を集めて、神様の骨格を作る。\n\n日本のガシャドクロのテーマを保ちつつ、ヨーロッパの王様の鎧と中国の鎧を融合させたような、王様のような鎧にしてください。\n\nhttps://twitter.com/Netanel_BH/status/1602561915108134913?t=oBDGnQDxSO_kZPpaebd9Ig&s=19", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@CandlMix/works/31", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 276261, "client_id": 2500300, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9704a800/uploads/origins/54aa56ff-40d5-4758-b469-911ef5bc9e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5611529dfbaa931ad0cd7363490c57b4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9704a800/uploads/origins/54aa56ff-40d5-4758-b469-911ef5bc9e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=471a40ba9789c4164ec57137e9cd4eb1", "src_set": ""}, "body": "このキャラの絵をお願いしたいです。\n衣装は通常の色ではなく、赤と黒で、剣とスカートが赤いものだと嬉しいです。\nご検討のほど、よろしくお願いします\n\nhttps://imgur.com/gLHTifv", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@CandlMix/works/30", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 276261, "client_id": 1173948, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07aa2575/uploads/origins/7dd63ff7-243e-48a1-83f2-ba027cb0daab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c4a2370374527bede8e219d6f8035f9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/07aa2575/uploads/origins/7dd63ff7-243e-48a1-83f2-ba027cb0daab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5483d5687cec7fb56fa19822c933e17", "src_set": ""}, "body": "右手がレイピアに変形し、次の暗殺のために姿を変える暗殺者ロボット。左手は武器の手入れをする。スーツからマントまでフォレストグリーンで統一され、白いボタンアップシャツを着ている。周囲には紫がかったピンクのダガーが3～4本浮かんでいる。ユーティリティ・ベルトには2～3本の毒薬のボトル。そして、上のバルコニーから次のターゲットを見下ろしています。遠近法のショットは、ロボットを見上げていることになります。\n\nhttps://twitter.com/Sleighzal/status/1566924364481691649?s=20&t=cY3n1C1OeeS38BUTQZjipQ", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@CandlMix/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 276261, "client_id": 1090171, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/adeec2ee/uploads/origins/d8fe83e3-b5d7-4867-b4fe-6b80e9daf114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84c22aea5e83d88c0b58073856cec40e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/adeec2ee/uploads/origins/d8fe83e3-b5d7-4867-b4fe-6b80e9daf114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=962475b4b20a1edfa7063dfd98214ac5", "src_set": ""}, "body": "アインズ・オウル・ゴンズ・羊のデジモンをお願いしたいです。アインズのアートと、鎧のようなアートを送りますが、主に骨格が太いので、強い体が必要です。\n\nhttps://twitter.com/Netanel_BH/status/1552594136548708354?s=20&t=0ilAYQYNeGxpxa83Oj0I_w", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@CandlMix/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 276261, "client_id": 1337188, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4128bd0/uploads/origins/d4471079-8529-414c-8dd8-8523419ea27b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a416e7fc98fe9802c8c15aaab890f125", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4128bd0/uploads/origins/d4471079-8529-414c-8dd8-8523419ea27b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb3052a126c15512e193bee77ae4f315", "src_set": ""}, "body": "Was wanting a skeb of my own centipede character in a design more like the 花嫁ムカデ piece you recently did.  \nI'd like her in a side pose with a more oni form with four arms that are insect like with bluish flames resting in two of their hands while they look down at the flames with the light reflecting on their gold-colored eyes.\nI'd also like the mandibles to be longer along her jaw and her antenna to be reaching farther back behind her head. \nYou can have artistic freedom with her outfit if you want to put her in something to stand out more if not. The black one in most pieces is fine.\nI'd also like a background if within reason to be at night with a moon lighting up her body and the ruins of a burned building.\nHere's art references as well. \nhttps://drive.google.com/drive/folders/1iGLp5Z_PmXpPNi4893kUhLIc1bTfiYYi?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@CandlMix/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 276261, "client_id": 209283, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c8e8ef5/uploads/origins/a6902d71-ee9b-41fe-8588-79984107a7a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1885c62f31791c3ca0b38877732fac29", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c8e8ef5/uploads/origins/a6902d71-ee9b-41fe-8588-79984107a7a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a5121df9d683c2e4de5421d7c87d2c3", "src_set": ""}, "body": "こんにちは、友人のために応募させていただいてもよろしいでしょうか？\n夜空の要素を取り入れたランス（槍）のデザインをお願いしたいとのことです\nポーズの形はお任せします。(耳と尻尾の色合わせもお願いします。）\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/15CGwNyEYMe4j8-imSiu-bk5qzo5SGYfr", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@CandlMix/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 276261, "client_id": 938510, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be821c98/uploads/origins/aa6f2637-eb8e-4cad-ac4d-28499407cdd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99a9adfc0df84e54b77eba9cdc1cc0b5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be821c98/uploads/origins/aa6f2637-eb8e-4cad-ac4d-28499407cdd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10edc669d23e567b097285ed38aeaa80", "src_set": ""}, "body": "こんにちは！ぜひキャラクターデザインを依頼したいです。\n\nアルテミスは邪悪な虎の女神です。彼女は私のキャラクターであるデヴァニと同じ虎の一族の一員でした。アルテミスはデヴァニと人間やドラゴンをどう思うかで意見が合わなかった。アルテミスは自然を守るために人間とドラゴンを滅ぼしたいと思っています。\n\nアルテミスはデヴァニと同じ角と光輪を持つ二足歩行の虎です。デヴァーニの柔らかで優しい外見とは対照的に、威嚇するような悪役のような存在にしたいですね。アルテミスは、オパールセントや玉虫色の強力な魔力源（プリズム魔力）に取り憑いています。\n\nこんなアイデアもありました。\n\n- 縞模様の代わりに水晶の岩の螺旋に囲まれたオパール色の霊体\n- 長いねじれた角\n- ひび割れや出血した後光\n- 天空のローブ（服がある場合）\n\nただし、デザインは自由に考えてください。虹色であること、角があること、水晶の縞模様があること、デヴァニと同じ虎であること、そして悪役っぽいことが必須要素です。\n\nhttps://drive.google.com/drive/folders/1HpoVta-r77xI3ubvgBCk5YQpPq4zpiRE?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@CandlMix/works/25", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a3fef083/uploads/origins/5faf24d0-68c9-4c89-b82a-2f8013c1fe0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d25d2372653ebfc8bea1b14ab3946d43", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 276261, "client_id": 1173948, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@CandlMix/works/24", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1e6984e0/uploads/origins/e8d033bd-faca-48f6-95fc-8c7536776e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9ff34c39ad8fc2440fa415d9995a07b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 276261, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@CandlMix/works/23", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b106fece/uploads/origins/96d4e040-fa26-4715-ae6e-5a55b8e635a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2