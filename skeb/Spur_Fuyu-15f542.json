mgix.net/04abb84b/uploads/origins/6355a0fd-e2dc-477d-adf0-f7822c6203c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fdf12afe203da113c4a909f1bbd458c7 3x"}, "body": "この間はご依頼に応じていただきありがとうございました！今度はskebでよろしくお願いいたします。\n\n内容ですが、可能であれば\n『色の無い白鳥と踊る』の矢藤昴さんのイラストが見てみたいです。\n構図など指定はありません！お任せします！\n\nみはるさんのイラスト、文体が大好きです。\n特にこの小説には心打たれて、今でも何度も読み返しています。\n昴さんのことが大好きです！また見てみたいなという一心でお願いしました。\n依頼に引き続きですが、もし良ければよろしくお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Spur_Fuyu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 4042, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ebb6963a/uploads/origins/ce5d91ce-d401-48a5-b660-26b1901cb893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb93a64e1a9f6493bdaaaabdfe22fa21", "srcset": "https://si.imgix.net/ebb6963a/uploads/origins/ce5d91ce-d401-48a5-b660-26b1901cb893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb93a64e1a9f6493bdaaaabdfe22fa21, https://si.imgix.net/ebb6963a/uploads/origins/ce5d91ce-d401-48a5-b660-26b1901cb893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23d6fe61d936f84f3d416abfbc2bf33d 2x, https://si.imgix.net/ebb6963a/uploads/origins/ce5d91ce-d401-48a5-b660-26b1901cb893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b9b23c48c22c8605f501f8aee523f27 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ebb6963a/uploads/origins/ce5d91ce-d401-48a5-b660-26b1901cb893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=909938434a6f10d16c17b0e6d9b57435", "srcset": "https://si.imgix.net/ebb6963a/uploads/origins/ce5d91ce-d401-48a5-b660-26b1901cb893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=909938434a6f10d16c17b0e6d9b57435, https://si.imgix.net/ebb6963a/uploads/origins/ce5d91ce-d401-48a5-b660-26b1901cb893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4cf48c172becf24deef0da2ba17b1ef1 2x, https://si.imgix.net/ebb6963a/uploads/origins/ce5d91ce-d401-48a5-b660-26b1901cb893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6e812ad78dcdb6e1aa6005374bf4fe9 3x"}, "body": "冬野みはる❄️様お世話になっております。\n\n以前リクエストさせていただいた作品ですが、いくつか内容に指示を入れていたため今回は冬野みはる❄️様が自由に書かれたお話を拝見したくリクエストを送らせていただきました。\n\n\nリクエストの内容としましては身内で遊んでいる世界観共有型一次創作の自陣営のお話を書いていただきたいです。\n\n【内容】\n①資料内のどのキャラを選んでいただいても構いません。(全員を書く必要はありません)\n彼らが仕事をしている姿や会話など、日常を垣間見ることができるようなお話をお願いします。(ほのぼのでもシリアスでも何でも好きです！)\n②前回同様ティーリオとエフティーのBL(BLでなくても可)\n\nどちらか書きやすい方をお選びください。\nまた、不明な点がございましたらご自由に解釈していただけると幸いです。\n\n\n【使用用途】\n・個人鑑賞\n・1部シーンをイラストに描き起こし、イラストをSNSに上げる場合があります。\n・作品の内容を設定に組み込む可能性があります。\n\n【その他】\n・その他形式に指定はありません。\n・創作初心者のため、設定に矛盾や誤りがあるかもしれません。その場合は作品内でご自由に変更していただいて構いません。\n\n最後までお読みいただきありがとうございました。金額や内容に問題がありましたら再送要請をお願い致します。\nお手数おかけしますが、ご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1V9-BcDEtIkrWl5TYJzkmVWPAys0nAdad", "nc": 137, "word_count": 5977, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@Spur_Fuyu/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/07a416f8/uploads/origins/b4e3b1d9-387e-4afc-93a3-47be7584a479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09547c99748fc5559bc38efa28aec719", "srcset": "https://si.imgix.net/07a416f8/uploads/origins/b4e3b1d9-387e-4afc-93a3-47be7584a479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09547c99748fc5559bc38efa28aec719, https://si.imgix.net/07a416f8/uploads/origins/b4e3b1d9-387e-4afc-93a3-47be7584a479?bg=%23