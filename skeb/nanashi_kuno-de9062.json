, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0bbd2b99/uploads/origins/e99e998d-b4c5-4918-9a75-e5dde32c31e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cceaebf90dc99ad403255a3ed935da7", "srcset": "https://si.imgix.net/0bbd2b99/uploads/origins/e99e998d-b4c5-4918-9a75-e5dde32c31e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cceaebf90dc99ad403255a3ed935da7, https://si.imgix.net/0bbd2b99/uploads/origins/e99e998d-b4c5-4918-9a75-e5dde32c31e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d0ece8b07f1ce63b979a7ff4e15da7c0 2x, https://si.imgix.net/0bbd2b99/uploads/origins/e99e998d-b4c5-4918-9a75-e5dde32c31e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=97a55b3b0872be7ee9b986a9c4ab4994 3x"}, "body": "こんにちは。あなたの作品を見てとても気に入りました。私のオリジナルキャラクター、レベッカ・ワイルダーを描いていただけないでしょうか。\n彼女は身長200cmを超える背が高く力強い女性で、狩りのスリルに生きている人物です。緑色の瞳を持ち、頭頂部にはジャッカルの耳があり、髪はダークブラウンですが、根元は赤みがかっています。 顔、肩、腕、腰には左右対称の部族のタトゥーがあり、さらに狩りで負った傷跡が全身に刻まれています。\nNSFWでもSFWでもどちらでも構いません。SFWにする場合は、水着姿で描いていただけると嬉しいです。それ以外は、芸術的な表現は完全に自由にお任せします。\n\nhttps://drive.google.com/drive/folders/1LfpIzU3KlYZJvbB2otOUXBqMmrTtOIZP?usp=drive_link", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nanashi_kuno/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1145499, "client_id": 1018243, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/244cb3f2/uploads/origins/848642d9-73bb-4ee9-aad5-0b6c3b2e1bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46f5150bcf9e8464adcf96a3d9ecb0c5", "srcset": "https://si.imgix.net/244cb3f2/uploads/origins/848642d9-73bb-4ee9-aad5-0b6c3b2e1bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46f5150bcf9e8464adcf96a3d9ecb0c5, htt