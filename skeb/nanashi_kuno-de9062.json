nd she frowns a lot. When she has her long bangs and pigtails hair, she is always smiling.\n\nI'm glad I found your account! I would like to use this for SNS and YouTube. Thank you!!\n\nhttps://drive.google.com/drive/folders/1TbgCZHIr5ifrBfe1CmOUbT9eekOWht-6?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nanashi_kuno/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1145499, "client_id": 1958957, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c046cab7/uploads/origins/416e4d41-fc5c-4544-b9fd-e4b6e2b4f9cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1672edfca1a4157cc409f128434940b7", "srcset": "https://si.imgix.net/c046cab7/uploads/origins/416e4d41-fc5c-4544-b9fd-e4b6e2b4f9cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1672edfca1a4157cc409f128434940b7, https://si.imgix.net/c046cab7/uploads/origins/416e4d41-fc5c-4544-b9fd-e4b6e2b4f9cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3fc0d9695acbc71efa2c7a6b089066d8 2x, https://si.imgix.net/c046cab7/uploads/origins/416e4d41-fc5c-4544-b9fd-e4b6e2b4f9cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b16155e4d3651df08d8d81920d3e839 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c046cab7/uploads/origins/416e4d41-fc5c-4544-b9fd-e4b6e2b4f9cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e432744eabfe52e35d57e0bc9dfd5d40", "srcset": "https://si.imgix.net/c046cab7/uploads/origins/416e4d41-fc5c-4544-b9fd-e4b6e2b4f9cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e432744eabfe52e35d57e0bc9dfd5d40, https://si.imgix.net/c046cab7/uploads/origins/416e4d41-fc5c-4544-b9fd-e4b6e2b4f9cb?bg=%23fff&auto=format%2Ccompress&fm=