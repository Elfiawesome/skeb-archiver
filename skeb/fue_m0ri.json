a-9098-e2c21253d7af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4d9ea5b06dee3a0319878c8ec2e77bf, https://si.imgix.net/00c05a84/uploads/origins/93dcb583-3071-4eea-9098-e2c21253d7af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5de1acdbf8160c2f3b65dfcb78c45c3f 2x, https://si.imgix.net/00c05a84/uploads/origins/93dcb583-3071-4eea-9098-e2c21253d7af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0e95bf5b40fc8e38fa3f379f5a742846 3x"}, "body": "始めましてkoiyumeと申します\n\nふえるこうもり様のイラストがとても可愛らしかったので、描いて頂きたくリクエストを送らせて頂きました\n\n今回描いて頂きたいのは個人勢Vtuberの神城くれあ様です\n\n白銀の髪と金の目で口を開けると牙が見え\n髪にひと房メッシュが入っています。猫耳尻尾あり\n\n参考画像\nhttps://x.com/kamishiro_kurea/status/1636699157024088064\nhttps://x.com/kamishiro_kurea/status/1996561932158202282\n参考動画をこちら\nhttps://youtu.be/kaAR2620Cdo\n\n今回新しく復刻実装された中華服のおさげでお願いします\nイラストの構図、髪色、ポーズはお任せいたします\n\nツインテ差分もお願い出来たら土下座で喜びます\n（可能でしたらで大丈夫です）\n\n神城くれあ様のTwitterやYoutubeのサムネイルやヘッダー、グッズ等に使用させて頂く場合がございますのでご了承をお願いします\n\nまた可能でしたら、人物だけのものとそれ以外のものを\nPSDファイルまたはPNGファイルなどで頂けると有難いです\n頂いたイラストはくれあ様にプレゼントいたします\n\nYouTube　https://www.youtube.com/@KamishiroKurea\nX　https://x.com/kamishiro_kurea\n\nご検討宜しくお願い致します\n\n私のTwitterのアイコンなどへ使用させて頂くかもしれません。こちらもご了承をお願いします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fue_m0ri/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3332019, "client_id": 2587112, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6766d413/uploads/origins/db969aca-06cb-4253-89a9-e528aa7b52d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=310089f77aa3ac264409f01e04f75602", "srcset": "https://si.imgix.net/6766d413/uploads/origins/db969aca-06cb-4253-89a9-e528aa7b52d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=310089f77aa3ac264409f01e04f75602, https://si.imgix.ne