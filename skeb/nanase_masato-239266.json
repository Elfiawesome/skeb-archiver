しない桐生の秘所にバイブを突っ込んで反則負け\n\n\n⋯という流れです。\nこの試合通して村木は桐生の腰を集中して痛めつけており、繰り返し何度も逆エビをかけているという設定です。\nまたステキな実況や台詞などあると嬉しいです。臨場感が違いますので。\n簡易資料のリプ欄に貼ってる流れをお願いしたいのですが、絡み絵なので作画カロリーが非常に高いと思われますので、先生が省くところは省いてください。最後のバイブとかもなくても構いません。\n\nまた金額が足りないなら再送してください。\n毎回の事ですが、普段描かれないジャンルをお願いしてるので条件的に合わなければキャンセルしてください。\nでは良かったら受けていただけると嬉しいですm(_ _)m", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nanase_masato/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0f2d9615/uploads/origins/cd5ee0bc-a243-402a-9dab-6359930f65de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=217a1e40fb9de46f93ea7d6db4436648", "srcset": "https://si.imgix.net/0f2d9615/uploads/origins/cd5ee0bc-a243-402a-9dab-6359930f65de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=217a1e40fb9de46f93ea7d6db4436648, https://si.imgix.net/0f2d9615/uploads/origins/cd5ee0bc-a243-402a-9dab-6359930f65de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=04cdae847170ab1fb798830de21cc6e1 2x, https://si.imgix.net/0f2d9615/uploads/origins/cd5ee0bc-a243-402a-9dab-6359930f65de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dfe0833e67de6cf435f83861dfdda63f 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3657456, "client_id": 2178716, "nc": 49}, {"path": "/@nanase_masato/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3657456, "client_id": 2178716, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ecfa06a/uploads/origins/c2474219-f2d0-44d7-b7c0-26084f7e00bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dfb620a11110980e970e11890f57e32", "srcset": "https://si.imgix.net/4ecfa06a/uploads/origins/c2474219-f2d0-44d7-b7c0-26084f7e00bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dfb620a11110980e970e11890f57e32, https://si.imgix.net/4ecfa06a/uploads/origins/c2474219-f2d0-44d7-b7c0-26084f7e00bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6112ea9accff9aeb90d19ed29e6c1369 2x, https://si.imgix.net/4ecfa06a/uploads/origins/c2474219-f2d0-44d7-b7c0-26084f7e00bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a06bdd3ee49d72517167d851c13074bf 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ecfa06a/uploads/origins/c2474219-f2d0-44d7-b7c0-26084f7e00bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a01c8f0e692db52ab2af8a954d7a1565", "srcset": "https://si.imgix.net/4ecfa06a/uploads/origins/c2474219-f2d0-44d7-b7c0-26084f7e00bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a01c8f0e692db52ab2af8a954d7a1565, https://si.imgix.net/4ecfa06a/uploads/origins/c2474219-f2d0-44d7-b7c0-26084f7e00bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa5817ddeeb678aa063b01a40fb5526b 2x, https://si.imgix.net/4ecfa06a/uploads/origins/c2474219-f2d0-44d7-b7c0-26084f7e00bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5defb7382632e18017078c925d8caddb 3x"}, "body": "七瀬先生こんばんはm(_ _)m\nまた御依頼したくやってまいりました。\n今回はまた当方のOCでプロレス技を描いていただけたらと思ってます。\n\nhttps://x.com/i/status/2017997426444157408\n\n↑簡易資料です。\n赤い水着が桐生。\n濃紺水着が村木です。\n\n相手を逆さまに吊るして胴腰を絞め上げる「リバースベアハッグ」という技をお願いしたいです。\n桐生が受けで、村木が攻め役です。\n画像1枚目のような構図、形が理想ですが先生の描きやすいように描いてください。\nただ、桐生の両足が垂れてブーツの靴紐が見える形が嬉しいです。前回描いていただいた桐生のブーツがとても良かったので（編み上げブーツフェチです）\n\n村木は思いっきり揺さぶりながら絞め上げる様子で。桐生の軽さを煽る罵倒などあれば…。\n桐生は角度的に村木の股間あたり埋まって顔が隠れるのですが、可能ならカットシーンのように表情がわかると嬉しいです。\n\n\n今までのリクエストでも丁寧に私の要望を叶えてくださって感謝しております。\nただ、七瀬先生が普段描かれないジャンルですので無理はなさらなくて大丈夫です。難しいなら断ってください。\n\nそうは言っても受けていただけると喜びます(^_^;)\nご検討お願い致しますm(_ _)m", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nanase_masato/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a0aa296c/uploads/origins/a3b8c4e4-de2a-443f-9398-293bb713e598?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47f1a19f68ee2695f94804e94b2d0b17", "srcset": "https://si.imgix.net/a0aa296c/uploads/origins/a3b8c4e4-de2a-443f-9398-293bb713e598?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47f1a19f68ee2695f94804e94b2d0b17, https://si.imgix.net/a0aa296c/uploads/origins/a3b8c4e4-de2a-443f-9398-293bb713e598?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64e32909d6deb3b58a2be602d606a7b2 2x, https://si.imgix.net/a0aa296c/uploads/origins/a3b8c4e4-de2a-443f-9398-293bb713e598?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a50b41bc803864adb061c31b36f984c 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3657456, "nc": 34}, {"path": "/@nanase_masato/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3657456, "client_id": 2178716, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4cb040c2/uploads/origins/444cf6ac-db1e-4c02-8264-9b220a023f