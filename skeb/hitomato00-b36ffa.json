てエリートたちからは見下されていました。\n・同じくマスターに無茶ぶりをされて前線に立たされて落ちこぼれとして扱われていた支援機の女性型兵器『偽葬』と出会います。\n・『偽葬』がエヴァンに恋するようになり、狂った『偽葬』はエヴァンの片目を抉って、傷を永遠のものとします。\n・傷を抱えてエヴァンは戦線から退き、終戦まで穏やかに暮らしていましたが、『聖葬』と出会い……。\n\n◎モチーフ\n聖葬:機械仕掛けの救世主・ハッピーエンドの犠牲・祈られるための者\nエヴァン:墓標の星・何にも染まらない黒・神に祈れない者\n\n◎要望\n荒野を旅しているときのワンシーン、みたいな雰囲気のある一枚絵が欲しいです。\n構図などはお任せします。\n\n◎使用用途\nSNSでのヘッダーやアイコンへの使用。\n個人利用の範囲でグッズ作成に使用する可能性があります。\n\n何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-bFcduEnYJAIdLs5K9KxywDi7p_Db9x3?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hitomato00/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1715597, "client_id": 1222060, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2d1ce3f/uploads/origins/14272afd-e7c6-4bcb-bcc0-6677ab005cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bce5f5ea70655d0e33cdc918969f46a", "srcset": "https://si.imgix.net/c2d1ce3f/uploads/origins/14272afd-e7c6-4bcb-bcc0-6677ab005cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bce5f5ea70655d0e33cdc918969f46a, https://si.imgix.net/c2d1ce3f/uploads/origins/14272afd-e7c6-4bcb-bcc0-6677ab005cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27a371887a344c9ab9df51779027f6de 2x, https://si.imgix.net/c2d1ce3f/uploads/origins/14272afd-e7c6-4bcb-bcc0-6677ab005cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88d1246288d6d16ce5713445ce7e1941 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c2d1ce3f/uploads/origins/14272afd-e7c6-4bcb-bcc0-6677ab005cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c16307f08a9e69275f889ebcc20d14a4", "srcset": "https://si.imgix.net/c2d1ce3f/uploads/origins/14272afd-e7c6-4bcb-bcc0-6677ab005cbd?bg=%23fff&auto=format%2Ccom