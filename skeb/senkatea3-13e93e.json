思うものを自由にやってください。\nhttps://skeb.jp/@senkatea3/works/1\n\nもしよろしければ、カーバンクルを描いていただけないでしょうか。栴香さんがすでにたくさんカーバンクルを描かれているので、無理なお願いですみません。また、本を入れるかどうかはあなた次第です。\n\nもし金額が合わなければ、検討のため再送してください。内容が合わない場合は、遠慮なくキャンセルしてください。ご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1z0gPvd8CcyGnM6fX3VQ10B47QqJpKP-i?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@senkatea3/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 959556, "client_id": 2602671, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22e98119/uploads/origins/4c0ecc37-acca-4618-bb88-9a6acd05a297?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7f84a957698d3de6ca34208476bdb80", "srcset": "https://si.imgix.net/22e98119/uploads/origins/4c0ecc37-acca-4618-bb88-9a6acd05a297?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7f84a957698d3de6ca34208476bdb80, https://si.imgix.net/22e98119/uploads/origins/4c0ecc37-acca-4618-bb88-9a6acd05a297?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab1f9229cdd3d7260eaeeb6fdfd84f44 2x, https://si.imgix.net/22e98119/uploads/origins/4c0ecc37-acca-4618-bb88-9a6acd05a297?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57484c081fdd0c28670461416c03a109 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22e98119/uploads/origins/4c0ecc37-acca-4618-bb88-9a6acd05a297?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b78796d63bc1d1252f268db0e76637cb", "srcset": "https://si.imgix.net/22e98119/uploads/origins/4c0ecc37-acca-4618-bb88-9a6acd05a297?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b78796d63bc1d1252f268db0e76637cb, https://si.imgix.net/22e98119/uploads/origins/4c0ecc37-acca-4618-bb88-9a6acd05a297