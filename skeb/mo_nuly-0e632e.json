ress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a001f5aa2ed64d628c50914d0cf7776b", "srcset": "https://si.imgix.net/e0bdbccb/uploads/origins/b1b24493-2255-4285-8f4a-69ed36958eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a001f5aa2ed64d628c50914d0cf7776b, https://si.imgix.net/e0bdbccb/uploads/origins/b1b24493-2255-4285-8f4a-69ed36958eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b8dcc3693aa073dd724a919a74347e1 2x, https://si.imgix.net/e0bdbccb/uploads/origins/b1b24493-2255-4285-8f4a-69ed36958eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc01af4bf637f901b871216d05b9918a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0bdbccb/uploads/origins/b1b24493-2255-4285-8f4a-69ed36958eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=433f3fff6cf55de92a3e7f2b434bd5e6", "srcset": "https://si.imgix.net/e0bdbccb/uploads/origins/b1b24493-2255-4285-8f4a-69ed36958eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=433f3fff6cf55de92a3e7f2b434bd5e6, https://si.imgix.net/e0bdbccb/uploads/origins/b1b24493-2255-4285-8f4a-69ed36958eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=33f893548c0267b19e4a0961f039003f 2x, https://si.imgix.net/e0bdbccb/uploads/origins/b1b24493-2255-4285-8f4a-69ed36958eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5c229aea05938383836947410ef143e0 3x"}, "body": "こんにちは！私の名前はゼフィーです。まだ駆け出しの小さなVTuberです。あなたの作風が大好きで、私のキャラクターのイラストをお願いしたいです！以下がイラストのイメージです。\n\n舞台は雪の降る村です。時間帯は夕方です。キャラクターは男性です。彼は壁に背を向けています。 気取らないポーズをとっています。左手はコートのポケットに突っ込んでいます。右手は少し外側に伸ばしています。 右手のひらは上を向いています。手のひらの上には雪の結晶が浮かんでいます。雪の結晶は日差しの中でキラキラと輝いています。彼は、ほのかな誇りと思索を込めてその雪の結晶を見つめています。そよ風が彼の髪とマフラーをなでています。\n\n服装や色については、参考リンクにすべて記載されています。服装は参考画像と同じか、それに近いものにしていただきたいのですが、ご自身の画風に合わせるために細部を変更していただいても構いません。 特に重視してほしいのは、目、髪、そしてマフラーです。\n\n本当にありがとうございます！大変感謝しています。\n\n（英語しか話せないので、申し訳ありません）\n\nhttps://imgur.com/a/zephie-illustration-references-1-0-l4dTdjX", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mo_nuly/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3686434, "client_id": 300145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa11a099/uploads/origins/83bf1f6a-9bd5-4141-a5bb-ca5a32714640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88e729e598fb8eed0f8230c90b904dcd", "srcset": "https://si.imgix.net/aa11a099/uploads/origins/83bf1f6a-9bd5-4141-a5bb-ca5a32714640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88e729e598fb8eed0f8230c90b904dcd, https://si.imgix.net/aa11a099/uploads/origins/83bf1f6a-9bd5-4141-a5bb-ca5a32714640?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3008a1b4228ba9c969a36319f1da0896 2x, https://si.imgix.net/aa11a099/uploads/origins/83bf1f6a-9bd5-4141-a5bb-ca5a32714640?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5eeebaba52636d37e05e6e41173f2f8b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa11a099/uploads/origins/83bf1f6a-9bd5-4141-a5bb-ca5a32714640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15578d8244b43ac9d552e8beb3e8b264", "srcset": "https://si.imgix.net/aa11a099/uploads/origins/83bf1f6a-9bd5-4141-a5bb-ca5a32714640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15578d8244b43ac9d552e8beb3e8b264, https://si.imgix.net/aa11a099/uploads/origins/83bf1f6a-9bd5-4141-a5bb-ca5a32714640?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9fd8a24437b7ec20737a317dc268d3ff 2x, https://si.imgix.net/aa11a099/upl