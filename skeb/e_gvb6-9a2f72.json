9c16d63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa0936f5b546291d305226636f2565dd, https://si.imgix.net/88050869/uploads/origins/aedcd66d-fc5e-4c5d-9323-dae879c16d63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=383d81c6af08614091dca9d0942f6f42 2x, https://si.imgix.net/88050869/uploads/origins/aedcd66d-fc5e-4c5d-9323-dae879c16d63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0001516ef31e04f30917e734249a9ffd 3x"}, "body": "こんにちは！\n\nNanaさんに私のモンスターハンター二次創作キャラクター｢竜仮面のルーク｣を描いてもらいたく依頼させていただきました\n\nNanaがキャラクターを描く際に使われる形式(以下URL)で描いてほしいです\nポーズや構図などはそちらにおまかせします\n\nもし厳しい場合はキャンセルして貰っても大丈夫です\n\nよろしくお願いします\n\nhttps://x.com/e_gvb6/status/1976947191651745847?s=46&t=qc4iqsuqdmDbKJKshs1uJA", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@e_gvb6/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2586596, "client_id": 1066697, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d366a177/uploads/origins/23d7c3dc-6d5a-4fcd-a517-a170f98c0660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2f5cec50980d4846e99b2e704b02958", "srcset": "https://si.imgix.net/d366a177/uploads/origins/23d7c3dc-6d5a-4fcd-a517-a170f98c0660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2f5cec50980d4846e99b2e704b02958, https://si.imgix.net/d366a177/uploads/origins/23d7c3dc-6d5a-4fcd-a517-a170f98c0660?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2c7dada466d92810c56723504662848 2x, https://si.imgix.net/d366a177/uploads/origins/23d7c3dc-6d5a-4fcd-a517-a170f98c0660?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33486f52acfbb6aa37f5e6fbbba600cc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d366a177/uploads/origins/23d7c3dc-6d5a-4fcd-a517-a170f98c0660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91673f5f2f5f8f7bc58f7d92284ede87", "srcset": "https://si.imgix.net/d366a177/uploads/origins/23d7c3dc-6d5a-4fcd-a517-a170f98c0660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91673f5f2f5f8f7bc58f7d92284ede87, https://si.imgix.net/d366a177/uploads/origins/23d7c3dc-6d5a-4fcd-a517-a170f98c0660?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a09eb4f1af92e9568b3f8dd1a1ec3505 2x, https://si.imgix.net/d366a177/uploads/origins/23d7c3dc-6d5a-4fcd-a517-a170f98c0660?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=441d71b5195f681ad5d7f544fdcf4a7f 3x"}, "body": "歪んだむと申します。\n納品されていたイラストがとても素敵でリクを送りました。\n\nうちの子の角狼「フォルン」をリクエストします。\nキャラデザは参考資料の通りです。\n資料で分かりにくい点、不明な点などは描きやすいように調整・アレンジしていただいて大丈夫です。\n\n●リクエスト内容\nhttps://skeb.jp/@e_gvb6/works/1\nhttps://x.com/e_gvb6/status/2006327991098585227?s=20\n上記の納品されていた作品やSNS上にて投稿されていたイラストのような絵柄で、モンスターとしての姿のフォルンのイラストをお願いします。\n\n・キャラ資料や設定など\nフォルン（トゥルーフォルム-アーマード）\nhttps://x.com/gn0083/status/2014279660113371367?s=20\n一時的に本来の姿を取り戻したが消耗が激しいため、拘束具と力の制御も兼ねた魔力と冷気の鎧であえて外装を施した状態。\n体毛の一部に紋様のような黒いメッシュが入る。\n大きな2本の角があるが、左側が欠損しているので氷の角を作ってバランスを取っている。\n背中に浮遊している翼のようなパーツは魔力と冷気を制御/放出するもので、噴射してブースターとして加速や制動、ブレードを形成して切り裂く、収束して砲撃を放つなどが可能。\n\n・構図イメージなど\n吼えている様子や戦っている様子、本気モードへの形態移行の様子…など、もろもろお任せします。\n鎖はうねるか曲がるなどして可能な範囲でイラスト内に収まっている状態でお願いします。\n\n・属性のイメージ\n雪や冷気、氷属性などの白や青系統\n魔力の黒\n\n文字や背景、宛名・サインにつきましてはpsdレイヤーで別々にon/offできるようお願いいたします（投稿時はサインonで投稿）\n\n\nご検討よろしくお願いします。 \n\n\n●その他の姿など、補足資料\nhttps://x.com/i/status/1977337608620658814\n\n・シールフォルム\n普段の姿。\n見た目相応の力。\n\n・トゥルーフォルム-リミテッド\n鎧を纏う前の本来の姿。\n消耗が激しい。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@e_gvb6/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": fal