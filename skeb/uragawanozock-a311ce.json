=200&h=200&blur=200&s=70e223d5a0df11e9d9dbfa483b290390 2x, https://si.imgix.net/81f3622b/uploads/origins/12e09a12-ea2d-4b9e-ad47-e7a0a219e5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9ac871f1d0d487750dac57f7dd4db3a2 3x"}, "body": "うちの子のヘリスのイラストをお願いしたいです。\nヘリスに顔面騎乗されている淫魔（という設定）の視点で、ヘリスが汗だくになりながらエロ蹲踞のポーズで自分の腋のニオイを嗅ぎながら、ふたなりペニスを扱いて淫魔化するシチュをお願いします。\n最初は抵抗の表情をしているものの腋のニオイを嗅いでトリップし絶頂。\n淫魔化後は粘膜の色が紫になり、蠱惑的な表情でこちらを誘ってるシチュでお願いします。\nタトゥーなどは参考画像通りでなくて結構です。\n\nhttps://twitter.com/Akunosu_Shochou/status/1716727582027292962", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uragawanozock/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 61966, "client_id": 182552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc6fe160/uploads/origins/55d2335b-83be-4bcd-8db3-346e16904b68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=484f8d775807bfd758ab21a37be1e64c", "srcset": "https://si.imgix.net/bc6fe160/uploads/origins/55d2335b-83be-4bcd-8db3-346e16904b68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=484f8d775807bfd758ab21a37be1e64c, https://si.imgix.net/bc6fe160/uploads/origins/55d2335b-83be-4bcd-8db3-346e16904b68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5657a20d3dff6958182e67a3102340ae 2x, https://si.imgix.net/bc6fe160/uploads/origins/55d2335b-83be-4bcd-8db3-346e16904b68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2237f41787dfebb9894e11fa7a71b612 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc6fe160/uploads/origins/55d2335b-83be-4bcd-8db3-346e16904b68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd3f8e0865ff3359aff9b55c464dc9fb", "srcset": "https://si.imgix.net/bc6fe160/uploads/origins/55d2335b-83be-4bcd-8db3-346e16904b68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd3f8e0865ff3359aff9b55c464dc9fb, https://si.imgix.net/bc6fe160/uploads/origins/55d2335b-83be-4bcd-8db3-346e16904b68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4e20c5d1cb1ed2cfa4adc69ed316c929 2x, https://si.imgix.net/bc6fe160/uploads/origins/55d2335b-83be-4bcd-8db3-346e16904b68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=41ac5a17975083f0225df12ccc7d3281 3x"}, "body": "初めまして。\n下記の通り依頼させて頂きます。\n\nマシュとぐだ子がホムンクルス系の雑魚敵と一体化し、こちらと対峙しているイラストをお願いします。\nこの一体化の様子は異なっており、マシュの方はホムンクルスと完全に融合して女型のホムンクルスになったような感じでお願いします。\n一方ぐだ子の方は融合というより取り込まれた様な感じで、ホムンクルスの頭がなくなった代わりに、\nそこから裸で巨乳になったぐだ子の上半身が生体ユニットの様に出ています。\n(正確には胸より下が取り込まれ、腕も肘辺りより先から取り込まれている感じ。)\nそして彼女らは早く相手を犯したいといわんばかりに発情した様子で、股間(ぐだ子はホムンクルスの方)に生えた大きなチンポ(玉あり)から我慢汁を垂らしています。\n\n以上、ご検討頂けると幸いです。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uragawanozock/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 61966, "client_id": 456958, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de29f16c/uploads/origins/847740ea-b447-40dc-a31b-b17f507c7603?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75530c2b0194dec3b10a264ed1f0ebb4", "srcset": "https://si.imgix.net/de29f16c/uploads/origins/847740ea-b447-40dc-a31b-b17f507c7603?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75530c2b0194dec3b10a264ed1f0ebb4, https://si.imgix.net/de29f16c/uploads/origins/847740ea-b447-40dc-a31b-b17f507c7603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=252e0284b89206c8539bd6809e1f8e60 2x, https://si.imgix.net/de29f16c/uploads/origins/847740ea-b447-40dc-a31b-b17f507c7603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ede563e70aaf3043bfc63a564fccb0e5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de29f16c/uploads/origins/847740ea-b447-40dc-a31b-b17f507c7603?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5217456f1239932c9b45580cbae73141", "srcset": "https://si.imgix.net/de29f16c/uploads/origins/847740ea-b447-40dc-a31b-b17f507c7603?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5217456f1239932c9b45580cbae73141, https://si.imgix.net/de29f16c/uploads/origins/847740ea-b447-40dc-a31b-b17f507c7603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=192a89725727fe0c0d5c69a280686a6c 2x, https://si.imgix.net/de29f16c/uploads/origins/847740ea-b447-40dc-a31b-b17f507c7603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95b799d6bba6728e0a27263b521fd79f 3x"}, "body": "ゾックさんこんにちは！\n私のオリキャラ「イド」を描いてませんか？\nカジノにルーレットホイールをプレイして、彼女は自分のテレキネシス能力を使って、不正行為でどんどん勝って。欲望に墜ちた時、スタッフが彼女にちょっとぶつけて、と彼女はルーレットホイールの上に落ちてしまう、吸い込まれたとルーレットホイールに融合した。\n最後には、彼女がルーレットホイールのセンターピースになりました。黄金のタコみたいに、墜ちた彼女はルーレットホイールのマスターで、カジノにゲス笑いで働く。\nイドの参考はこちら: https://www.pixiv.net/artworks/105012868\nよろしくお願いします！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uragawanozock/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 61966, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d2ae4dd7/uploads/origins/d5f69bcf-3a43-48a3-9f48-a111fbe5e463?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9939977d278d3cdbc147e0411d7f4ae", "srcset": "https://si.imgix.net/d2ae4dd7/uploads/origins/d5f69bcf-3a43-48a3-9f48-a111fbe5e463?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9939977d278d3cdbc147e0411d7f4ae, https://si.imgix.net/d2ae4dd7/uploads/origins/d5f69bcf-3a43-48a3-9f48-a111fbe5e463?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30ef3c9ca06a8a2a168f671b04053adb 2x, https://si.imgix.net/d2ae4dd7/uploads/origins/d5f69bcf-3a43-48a3-9f48-a111fbe5e463?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=467dc7226dadaf7dea6b63ce0a3a7533 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2ae4dd7/uploads/origins/d5f69bcf-3a43-48a3-9f48-a111fbe5e463?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e87501d12b8028555e714b2ffa141387", "srcset": "https://si.imgix.net/d2ae4dd7/uploads/origins/d5f69bcf-3a43-48a3-9f48-a111fbe5e463?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e87501d12b8028555e714b2ffa141387, https://si.imgix.net/d2ae4dd7/uploads/origins/d5f69bcf-3a43-48a3-9f48-a111fbe5e463?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1d4b0910d7f693b07cd4ddcccbbcf5c9 2x, https://si.imgix.net/d2ae4dd7/uploads/origins/d5f69bcf-3a43-48a3-9f48-a111fbe5e463?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=58fd93700e58870b5221b168dfd9c185 3x"}, "body": "はじめまして！\n『寄生生物の母体化』が素晴らしかったので依頼させていただきました\n内容は少年ヒーローがオタマジャクシ型の寄生生物に寄生侵食されてカエル怪人へと生まれ変わるイラストを漫画形式またはシークエンス形式でお願いしたいです\n流れとしては『寄生生物の母体化』のように調子に乗っている少年の体に寄生生物が入り込んでいき変化が始まる\n↓\n手足がカエルのものと同じになり武器が持てなくなって困惑する\n↓\n舌と尻尾が勢いよく飛び出る\n↓\n片目が横長の瞳孔になり喉袋が膨らむ\n↓\n完全に生まれ変わって助けに来た元仲間を同族化しようとする\n形だと嬉しいです\n内容や設定、構図形式などはゾック・オルタさんの描きやすいように変更していただいて構いません\n何卒よろしくお願いします", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uragawanozock/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 61966, "client_id": 160268, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e0a1a46/uploads/origins/49327f3d-de85-4f50-b26b-7894414d8549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4410799161bbc674fb3eb765889a8879", "srcset": "https://si.imgix.net/3e0a1a46/uploads/origins/49327f3d-de85-4f50-b26b-7894414d8549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4410799161bbc674fb3eb765889a8879, https://si.imgix.net/3e0a1a46/uploads/origins/49327f3d-de85-4f50-b26b-7894414d8549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e90fb7db26fa7d9eac98bde1d643407 2x, https://si.imgix.net/3e0a1a46/uploads/origins/49327f3d-de85-4f50-b26b-7894414d8549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=556bc37fc9d1501d31fb9e8a43b7ee28 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e0a1a46/uploads/origins/49327f3d-de85-4f50-b26b-7894414d8549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ad78b8bd8029db087081641271af38c", "srcset": "https://si.imgix.net/3e0a1a46/uploads/origins/49327f3d-de85-4f50-b26b-7894414d8549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ad78b8bd8029db087081641271af38c, https://si.imgix.net/3e0a1a46/uploads/origins/49327f3d-de85-4f50-b26b-7894414d8549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=15c66fba718d38cfe64f2567b9be29cd 2x, https://si.imgix.net/3e0a1a46/uploads/origins/49327f3d-de85-4f50-b26b-7894414d8549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=177680b64d57e0350c74a2be2c51d04f 3x"}, "body": "ゾック・オルタさんこんにちは、いつも作品の方楽しませて頂いております。\n今回のリクエストは5,6ページくらいの漫画形式を希望します、お忙しい中で申し訳ございませんが引き受けて下されば幸いです。\nリクエスト内容ですが、スライムクイーンに敗北して同化吸収された男勇者が、彼女の眷属であるスライム娘に変えられてしまうシチュをお願いします。\n以下シチュ詳細です。\n旅の勇者はダンジョンボスであるスライムクイーン(高貴な雰囲気を纏う巨乳スライム娘。何か飾りの様なものが付いていると良いかもしれません)に挑むが、彼女の体内に取り込まれてしまう。必死でもがくものの、そのまま同化吸収され彼女の身体の一部となった勇者は、丸い大きなスライム塊として体内から吐き出される。ただプルプル震えることしか出来ない粘液と化した勇者を嘲ると、クイーンはそれに魔力を注ぎ込む。すると勇者だったスライム塊は歪な人型をとったかと思うと、勇者の面影を残した少女の姿へと変わる。朧げな意識の中で戸惑いの表情を見せる勇者に悪戯な笑みを浮かべたクイーンが更に魔力を注ぐと、勇者の胸が大きく膨らみクイーンを上回る巨乳になる。その快楽で意識を取り戻した勇者だったが、同化吸収されスライム娘に作り変えられた影響で記憶も名前も思い出せず、クイーンに言われるがまま彼女の眷属となってしまう。そんな勇者を「ご褒美」として背後から抱きしめ胸と股間を優しく愛撫するクイーン。勇者は変わり果てた身体で感じる未知の快楽に全身をプルプルと震わせ、クイーンに改めて忠誠を誓うのであった‥\n予算に合わない様であれば一部カットや、ゾックさんの判断で改変して頂いても大丈夫です。\nよろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uragawanozock/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 61966, "client_id": 564815, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b97939a6/uploads/origins/477d271a-1717-4035-a36e-591b1e4b80a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f475b26a069e38f713b026797a2846af", "srcset": "https://si.imgix.net/b97939a6/uploads/origins/477d271a-1717-4035-a36e-591b1e4b80a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f475b26a069e38f713b026797a2846af, https://si.imgix.net/b97939a6/uploads/origins/477d271a-1717-4035-a36e-591b1e4b80a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23705d13eeed7de7fef1331038abead1 2x, https://si.imgix.net/b97939a6/uploads/origins/477d271a-1717-4035-a36e-591b1e4b80a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c52210e2f45dfc01895c29aec4b6e5ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b97939a6/uploads/origins/477d271a-1717-4035-a36e-591b1e4b80a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7621279cc2e84740ce868018e8e8829", "srcset": "https://si.imgix.net/b97939a6/uploads/origins/477d271a-1717-4035-a36e-591b1e4b80a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7621279cc2e84740ce868018e8e8829, https://si.imgix.net/b97939a6/uploads/origins/477d271a-1717-4035-a36e-591b1e4b80a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2768c1f96d547767f924a82e25e9f721 2x, https://si.imgix.net/b97939a6/uploads/origins/477d271a-1717-4035-a36e-591b1e4b80a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=585935c56c7e65ca55bad9ec667c1f7f 3x"}, "body": "初めまして、以前描かれていたtransfurイラストが素敵だったので依頼させていただきます。\n壱与(Fate/Grand Order)の半獣人化をお願い致します。シチュエーションは獣人化し始めたぐらいのタイミングで変化した自分の手を見て恐怖している感じで、なるべく全身が見えるようにお願いします。\n両手は大まかな形はそのままに毛皮に覆われ指が長く伸びて爪が鋭く伸びてる感じで、両足はサンダルが脱げて裸足になった状態で狼の後ろ足に変化(人間型の足ではなく狼の後ろ足と完全に同じ構造の足でお願いします)させて、頭部においては側頭部の人間の耳を消して代わりに頭頂部から狼の耳を一対生やし、口内の犬歯が伸びて牙になってるようにお願いします(それ以外の変化は無しでお願いします)。\n尻尾は服の構造上スカートの中に隠れると思うので、先端が足の間からチラッと見えるぐらいか難しければいっそ見えないものとして省いてしまっても大丈夫です。表情は自分が人間でなくなる事に怯えてる様な感じで、開いた口の中に尖った牙が見えてるようにお願いします。\n毛皮の色は髪と同じ黒で、衣服はこちらの画像(https://www.dropbox.com/s/ojus50yvpi9qe1z/11ADC39F-AEDA-4848-B4E5-AFD1A4410F93.jpeg?dl=0)のものでお願いします。注文が多くて申し訳ありませんが何卒よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uragawanozock/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 61966, "client_id": 335424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df6a0340/uploads/origins/65736e49-5b63-47ba-b36f-ac15084e28d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00c8e92aa2d11dc0802d14612eee7d74", "srcset": "https://si.imgix.net/df6a0340/uploads/origins/65736e49-5b63-47ba-b36f-ac15084e28d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00c8e92aa2d11dc0802d14612eee7d74, https://si.imgix.net/df6a0340/uploads/origins/65736e49-5b63-47ba-b36f-ac15084e28d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f382311cb8bda26e56780bf287966c32 2x, https://si.imgix.net/df6a0340/uploads/origins/65736e49-5b63-47ba-b36f-ac15084e28d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=652ad53bfb916c62869b31a21de75148 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df6a0340/uploads/origins/65736e49-5b63-47ba-b36f-ac15084e28d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=211ffa32762ddebf8c1b603a3d5a68cc", "srcset": "https://si.imgix.net/df6a0340/uploads/origins/65736e49-5b63-47ba-b36f-ac15084e28d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=211ffa32762ddebf8c1b603a3d5a68cc, https://si.imgix.net/df6a0340/uploads/origins/65736e49-5b63-47ba-b36f-ac15084e28d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2469b55b74f2d73217241e5bf4b419e1 2x, https://si.imgix.net/df6a0340/uploads/origins/65736e49-5b63-47ba-b36f-ac15084e28d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ad9bc28f3a621803be2f915894c2895a 3x"}, "body": "お世話になります\nゾック様の異形イラストの大ファンです！\n特にCG集のゼロワンさんが大好きで、\n作中の擬似ボテ腹セックスからの擬似出産シーンには大変興奮させて頂きました！\n\n今回リクエストしたいのはFGOマシュの「大奥女中化」です\n\nhttps://twitter.com/uragawanozock/status/1195673789813510145?s=46&t=9h6yyfyxfg4tYJdWJlbsyQ\n\nこの女中化マシュと藤丸君のボテ腹セックスをお願いします！！\n(藤丸君はシルエットや透明人間でも構いません)\n\n●シチュ\n当該ツイートのリプライにあった\n「なんとなく戸惑っているように見えてまだ心は変わって無さそう」\n「体が自分の意思に従わないといいですなぁ」\nこちらのツリーに大変興奮いたしましたので、これを元にした妄想シチュになります\n\n体位は騎乗位で、大量に精液を搾っている\n無表情で動きはカクカクと人形の様にぎこちなく、淡々と腰振り\n\n「センパイ…ニゲテ…」\n「アカチャン…イッパイウミタイ…」\nなど、マシュの意識はあるが体は従わず、しかも段々と正気を失いつつあり、完全な女中化まで一歩手前の様なイメージです\n\nマシュは参照イラストの様に着物姿で\n(ボテ腹と干渉する場合は全裸でも構いません)\n出来ればボテ腹部分はこちらのイラストの様にクリアパーツ化、中の胎児と注がれる精液が見える様にお願いします\n\nhttps://twitter.com/uragawanozock/status/1145661133677715459?s=46&t=9h6yyfyxfg4tYJdWJlbsyQ", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uragawanozock/works/6", "private_thumbnail_image_urls": null, "private": fal