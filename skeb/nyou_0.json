count": 0, "received_works": [{"path": "/@nyou_0/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2106374, "client_id": 2965347, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9e18525/uploads/origins/1d5e1d37-74e7-48c6-9d0b-01621bcb46a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31af45274bf28ffd4bef177b6a0633b0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9e18525/uploads/origins/1d5e1d37-74e7-48c6-9d0b-01621bcb46a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c95a9b67b9da5aabf6e7542e3ee908a", "src_set": ""}, "body": "初めまして。\n素敵なイラストを拝見しましたので、私もリクエストをお願いしたいと思いました。\n\n私のオリジナルキャラのカナリアを描いて頂きたいです。\n構図や表情等はお任せします。優しく穏やかな性格のキャラクターです。\n\nご検討のほどよろしくお願い致します。\n\nhttps://x.com/StellaXXX0/status/1827997517684126039", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nyou_0/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2106374, "client_id": 2489823, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf004dfc/uploads/origins/9f4bb29c-6461-4297-91d3-5d4b477664ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d00a39c40e269f701b487818b671d69", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf004dfc/uploads/origins/9f4bb29c-6461-4297-91d3-5d4b477664ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7af615f35acd53fba0fb242ada72cd1", "src_set": ""}, "body": "こんにちは、またお会いできて嬉しいです～！今回は次女（ゲーム「ブルーアーカイブス」をモチーフにしたデザイン）のocキャライラストを応募させていただきます。\noocキャラの名前は「【泡色愛】（泡のような、虹のような愛の意）」、グエミナ学園に通う美術作家の生徒で、この生徒は真実を信じる女の子で、口は固いが心は柔らかく、とてもハンサム、髪型はサイドポニーテール、服の色はどのバージョンを参考にしていただいても結構です！ハンサムな一面を見せたいので、構図は完全にお任せします！\nお待たせしました～！\n\nhttps://drive.google.com/drive/folders/1d46bdXsAitVgot-UtrENrOYvjZTbXL_R?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nyou_0/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2106374, "client_id": 2489823, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f7ce5569/uploads/origins/e60410a4-df79-4b59-9fa6-99c51a9184ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=347cb65806e4e5d5fce985ed71f01686", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f7ce5569/uploads/origins/e60410a4-df79-4b59-9fa6-99c51a9184ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c49cd10721bd9e3f7d2574c253c14184", "src_set": ""}, "body": "こんにちは、はじめまして！\nイラストの作風がとても好きなので、オリジナルキャラクターイラストをお願いしたいです！（キャラクターデザインはbuleアーカイブを参考にしています）リンク先の画像をご確認ください！\n\n陰気でどこか気弱な子供（空閑 ウイに少し似ている！）です。他の作品のように、構図はすべてお任せで描いてほしいです！\n\nSkedを使うのは初めてなので、何か間違いがあってもご理解いただけると幸いです！\n\nhttps://drive.google.com/file/d/1qkm2yknJPKyEUpIzYJSHje80NkHEygzM/view?usp=drive_link\nhttps://drive.google.com/file/d/1ipCd6hiiXrmE-rji0-R2BkySBD6RwUUN/view", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nyou_0/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2106374, "client_id": 2528989, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eaf15a3b/uploads/origins/e7b7b0ac-5c6a-4d83-83b1-e6ec31614e2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e63642906d37e814aa80779524bc547", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eaf15a3b/uploads/origins/e7b7b0ac-5c6a-4d83-83b1-e6ec31614e2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5a6e0216fbc77e88b20368e4a5badd4", "src_set": ""}, "body": "こんばんは、初めまして。\nXで素敵なイラストをお見かけ致しましたので\n是非リクエストしたいと思いました。\n\nリクエスト内容としましては、自分のオリジナルキャラの朱鷺桜優理ちゃんをお願いしたいと思います。 \n\n髪：赤髪の長髪で髪の先端は白でアホ毛が1本あります。（左上にリボンが付いています。） \n胸：Cくらいです。 \n年齢は18歳くらいの女の子です。 \n\n資料URLに参考画像あります。 \n\nhttps://x.com/yurizeek/status/1756657500349423625?s=46&t=_F4ISJfclIbBX6hXop3gnQ \n\nhttps://x.com/yurizeek/status/1788206492824531388?s=46&t=_F4ISJfclIbBX6hXop3gnQ\n\nシチュエーション等はお任せ致します。\n(一緒にSDイラストもあると嬉しいです)\n\n使用用途と致しましては、SNSのアイコン等に使わせていただきたいと思っております。\n\nご検討よろしくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nyou_0/works/20", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/700bbfe0/uploads/origins/bbc8ed05-2ab9-4ad0-81f0-f76b2c5406cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da7d842cc079743822293e31bc498a6d", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2106374, "client_id": 2061528, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nyou_0/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2106374, "client_id": 54368, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46a60b18/uploads/origins/12e78cbb-0a9c-4e50-8f5a-0f87b78ba55b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76cce79434a1d0e8bd5220f47eec1e4e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46a60b18/uploads/origins/12e78cbb