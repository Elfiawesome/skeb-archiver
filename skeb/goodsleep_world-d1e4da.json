ぐらいあるぞ！！\nマイペースで急に道端にハンモックを作って寝る。HO1のことが大好きで「ゆきさん♡」と呼んでいる。後輩だがゆきさん絶対守るマン。感情はデカい。\n\nジェノさんの絵柄が大好きです！！よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1dpP5D49KCwodFazx3P8pu6kZQoP2ImE7", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@number_TRPG/works/140", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1158780, "client_id": 3314192, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f7d2804/uploads/origins/f7912b23-8507-48a7-96bf-82b68fc702f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8eefa82cae6448fa72838e9507b108df", "srcset": "https://si.imgix.net/1f7d2804/uploads/origins/f7912b23-8507-48a7-96bf-82b68fc702f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8eefa82cae6448fa72838e9507b108df, https://si.imgix.net/1f7d2804/uploads/origins/f7912b23-8507-48a7-96bf-82b68fc702f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=569bf61fb6694a8b50fdd7746338f15b 2x, https://si.imgix.net/1f7d2804/uploads/origins/f7912b23-8507-48a7-96bf-82b68fc702f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfd44f8e067320cadc4916cbde56571f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f7d2804/uploads/origins/f7912b23-8507-48a7-96bf-82b68fc702f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=436ab9f08f742c8cb207dfd2ccf6828b", "srcset": "https://si.imgix.net/1f7d2804/uploads/origins/f7912b23-8507-48a7-96bf-82b68fc702f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=436ab9f08f742c8cb207dfd2ccf6828b, https://si.imgix.net/1f7d2804/uploads/origins/f7912b23-8507-48a7-96bf-82b68fc702f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b0e1d450cccbb955b556ee66c6b8aeb6 2x, https://si.imgix.net/1f7d2804/uploads/origins/f7912b23-8507-48a7-96bf-82b68fc702f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8e9da7283099ba20d7bf32326dbcb0bf 3x"}, "body": "えのまる様、初めまして。安眠と申します。先日てんもくをHO4で通過させていただき、あまりにも好きすぎて衝撃を受けました。素敵なシナリオをありがとうございます。NPCの中ではルシファーさんが好きです！！ただならぬショタ、最高〜〜！！\n\nリクエストは、サマエルにウザ絡みするてんもくHO4のツーショットです。陽キャのノリで隙あらば絡みまくり怯えられました。おもしろかったです！！以下キャラシです。\n\n\n\nボク〜だわ　女\n\n変な人。両手、頭、翼を使って逆立ちする五点倒立が趣味。こうすれば頭に血が上ってアイデアが生まれやすくなるらしい。(諸説あり)そもそも天使に血が流れているのかわからないが、現世では三点倒立までしかできなかったため非常に楽しんでやっている。\n己の芸術に対して高いプライドを持つ。自分にも厳しく、納得のいく作品が描けないと「こんなの芸術じゃないわーーー！！！」と叫びながらちゃぶ台返しならぬキャンバス返しをしている。\n\n\nサマエルさんの焦り顔が大好きです。よろしくお願いいたします！\n\nhttps://drive.google.com/file/d/1UIJvq2NnF8_cS2EYQRy5oI_bfto9lVAm/view?usp=drivesdk", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chloe_ethyl/works/38", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 23873, "client_id": 3314192, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd11d3a7/uploads/origins/c65bf00d-b468-4f41-95e3-28108d8520bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6a58308927ef2f87e6edafb4fe4a96b", "srcset": "https://si.imgix.net/fd11d3a7/uploads/origins/c65bf00d-b468-4f41-95e3-28108d8520bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6a58308927ef2f87e6edafb4fe4a96b, https://si.imgix.net/fd11d3a7/uploads/origins/c65bf00d-b468-4f41-95e3-28108d8520bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f85a4ab4920e73c668cbf89eab55e708 2x, https://si.imgix.net/fd11d3a7/uploads/origins/c65bf00d-b468-4f41-95e3-28108d8520bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7159e1e73e138be0391991c4ee8bbfb1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd11d3a7/uploads/origins/c65bf00d-b468-4f41-95e3-28108d8520bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0586f2ef642e532ce401432fb3600f21", "srcset": "https://si.imgix.net/fd11d3a7/uploads/origins/c65bf00d-b468-4f41-95e3-28108d8520bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0586f2ef642e532ce401432fb3600f21, https://si.imgix.net/fd11d3a7/uploads/origins/c65bf00d-b468-4f41-95e3-28108d8520bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6dce540325e398cf0d5effb9a3efc65c 2x, https://si.imgix.net/fd11d3a7/uploads/origins/c65bf00d-b468-4f41-95e3-28108d8520bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e26e52ff3eadd62a70d34bcd18b3ca2f 3x"}, "body": "エチルさん、いつもお世話になっております。安眠と申します。\n\n私はエチルさんのシナリオが大好きで、中でもだから嫌いなあんたでいてくれよ。は15陣ほどハンドスピナーさせていただいております。\n\n特にNPC落水小夜が大好きです！！15回ペラペラペラペラRPさせていただいてます。RPがとても楽しい！！！立ち絵が追加されたとき、今まで私が使用していたピクルーのイメージ画像にとても似ていて驚きました。やっぱりあいつ、タレ眉ツリ目青髪薄笑いですよね…………解釈一致すぎました……\n\nというわけで、だきあいの回想2番目の火の呪文を詠唱する落水と、悔しそうに見つめる火原のイラストが見たいです！！よろしくお願いします！！！\n\n文字数が余ったので、だきあいの好きポイントを語らせていただきます。火原の呪文は失敗しましたが、落水が最悪の死に方をするという願いは叶っているので、結果的に秀才の努力は報われているところです。本当に大好きです。\n\nこんなリクエストができるのも、NPC立ち絵を追加してくださったおかげです！！！！！！本当に本当にありがとうございました！！！！！！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@genousa/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3506693, "client_id": 3314192, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4db726ce/uploads/origins/a9692d75-5a53-4f9c-804f-a7411c932a0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e8d0bbce8f455750966e0b0ef267a79", "srcset": "https://si.imgix.net/4db726ce/uploads/origins/a9692d75-5a53-4f9c-804f-a7411c932a0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e8d0bbce8f455750966e0b0ef267a79, https://si.i