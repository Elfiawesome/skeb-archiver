。\nデザイン的に分かりづらい・描きづらいと感じる箇所もあるかもしれませんので、格好に関しては必要に応じて好き勝手アレンジしたりはしょったりしても構いません。\n（特に王冠の上に浮かんでいる飾りは任意で出し入れ可能という設定で、実際に描かなくても大丈夫です）\n\n以上で宜しければご検討お願いします！\n\nhttps://drive.google.com/file/d/1bNrhW34abz7UO_MXr-90M7uDtuTjTSo4/view?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@AtoZ76786729/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1560841, "client_id": 38601, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d816214/uploads/origins/c9842239-19a7-4362-88f4-509d24b065ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1111340715bd07449c3bc2c8d032799d", "srcset": "https://si.imgix.net/3d816214/uploads/origins/c9842239-19a7-4362-88f4-509d24b065ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1111340715bd07449c3bc2c8d032799d, https://si.imgix.net/3d816214/uploads/origins/c9842239-19a7-4362-88f4-509d24b065ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bf2397f63ee8b49460a8b5940ef2c75 2x, https://si.imgix.net/3d816214/uploads/origins/c9842239-19a7-4362-88f4-509d24b065ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02108f0356fdcc3cc7d0a09d211aa360 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d816214/uploads/origins/c9842239-19a7-4362-88f4-509d24b065ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8054f31f35e4a0f242e70e81f496e925", "srcset": "https://si.imgix.net/3d816214/uploads/origins/c9842239-19a7-4362-88f4-509d24b065ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8054f31f35e4a0f242e70e81f496e925, https://si.imgix.net/3d816214/uploads/origins/c9842239-19a7-4362-88f4-509d24b065ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cr