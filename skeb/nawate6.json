いを見れるような構図でお願いします。\nそのほか、背景有無やインナー無し、着衣差分などはお任せします。\n\nその他\nPSD受領可です。\n\nお構いなければ、よろしくお願い致します。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 122754, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ɢʀᴀᴍ☔️", "screen_name": "gram_quartz", "avatar_url": "https://pbs.twimg.com/profile_images/1744271951349383168/vDle68L_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/782433730619060224/1752900766/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 161}, {"id": 159970, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "芝猫はんぐりー!", "screen_name": "sibanekohg", "avatar_url": "https://pbs.twimg.com/profile_images/1183326459647029250/K8zLgaee.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1183314239571628033/1583061898/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "skills": [{"genre": "art"}], "nc": 49}, {"id": 330893, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "にこぱん゜ 🍞", "screen_name": "nicopancake", "avatar_url": "https://pbs.twimg.com/profile_images/1957027838584127488/2ZoQ5R9T.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2433444620/1743920591/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "skills": [{"genre": "art"}], "nc": 177}, {"id": 350126, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "rumachi(るまち)＠1日目_南s41b", "screen_name": "rumachi_tw", "avatar_url": "https://pbs.twi