rive.google.com/drive/folders/13ahBwV_hYKOOfvkJ7y2yvXL3u18KB0ML", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 444660, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "兎鷺ぬい🎀ご依頼受付中", "screen_name": "u3g1n", "avatar_url": "https://pbs.twimg.com/profile_images/2084237088954974208/ws3WIYbw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1218847864282963968/1785756021/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 579095, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "副島あすか", "screen_name": "tat_asb_", "avatar_url": "https://pbs.twimg.com/profile_images/1957291770657812480/9tHGz2tQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1105826918878728192/1755491344/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 129}, {"id": 2632629, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "nezychan", "screen_name": "nezychan_", "avatar_url": "https://pbs.twimg.com/profile_images/1630206028003573761/dPx017Fw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1618385632296042498/1696784644/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"