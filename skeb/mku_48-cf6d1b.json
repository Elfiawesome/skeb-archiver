a1ba72fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aaaada10469ebbac3353c70757352201 2x, https://si.imgix.net/03dd9f64/uploads/origins/e5872c21-fa0b-49ef-b0c6-bef7a1ba72fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8418f5694d9f4e4ae38aca8307701c7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03dd9f64/uploads/origins/e5872c21-fa0b-49ef-b0c6-bef7a1ba72fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5df0ba11f5d06900f4b0c36129a82e1", "srcset": "https://si.imgix.net/03dd9f64/uploads/origins/e5872c21-fa0b-49ef-b0c6-bef7a1ba72fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5df0ba11f5d06900f4b0c36129a82e1, https://si.imgix.net/03dd9f64/uploads/origins/e5872c21-fa0b-49ef-b0c6-bef7a1ba72fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=caeae4431db4b94fc3e7d7e9e988c3e7 2x, https://si.imgix.net/03dd9f64/uploads/origins/e5872c21-fa0b-49ef-b0c6-bef7a1ba72fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=427330dbb54b9e8dd0ce1fea4d07c26a 3x"}, "body": "FGOからアン・ボニーのイラストをお願いします。\nシチュですが、敵の謎デバフを受けて服が着られなく(脱げた？)なったというところを。ただし、靴だけはそのままでお願いします(もし全身を描いて頂けるのならば)。一応、アンの衣装はアーチャークラス時の霊基再臨第一段階(黒ビキニとホットパンツ)でお願いします。\nそれと表情ですが、恥ずかしくてやや赤面しているものの、見ている相手がマスターなので満更でもなさそうな感じ(少し嬉しそう？)でお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mku_48/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 104075, "client_id": 304504, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc9e034c/uploads/origins/ed76eed3-c6fe-4177-89c6-fc032ea85814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87ac2dc6718be22245a4ebe5889c5b6b", "srcset": "https://si.imgix.net/cc9e034c/uploads/origins/ed76eed3-c6fe-4177-89c6-fc032ea85814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87ac2dc6718be22245a4ebe5889c5b6b, https://si.imgix.net/cc9e034c/uploads/origins/ed76eed3-c6fe-4177-89c6-fc032ea85814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91aac16f8f084e5e34d40fa519699477 2x, https://si.imgix.net/cc9e034c/uploads/origins/ed76eed3-c6fe-4177-89c6-fc032ea85814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65a15f9d26fcfcbfdf0e747876b340f2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc9e034c/uploads/origins/ed76eed3-c6fe-4177-89c6-fc032ea85814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d58f4059d106175eb16770e33df044f2", "srcset": "https://si.imgix.net/cc9e034c/uploads/origins/ed76eed3-c6fe-4177-89c6-fc032ea85814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d58f4059d106175eb16770e33df044f2, https://si.imgix.net/cc9e034c/uploads/origins/ed76eed3-c6fe-4177-89c6-fc032ea85814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=942d382bcd4ca7fed34fb8659ba0d5ff 2x, https://si.imgix.net/cc9e034c/uploads/origins/ed76eed3-c6fe-4177-89c6-fc032ea85814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5558ac3ac86f4db369021b963d64f13f 3x"}, "body": "こんにちは。リクエストを修正しました！またご検討ください。\n\nこんにちは。あなたの作品が好きです。SKEBリクエストを提出したいと思います。ご検討よろしくお願いします。\n\nグレイ(ロード・エルメロイⅡ世の事件簿)\n顔のない男性/顔のないモブキャラ \n\n2コマ漫画。\n顔のない男が催眠術を使う \n\nシナリオ: \n\n今回のリクエストでは、グレイにはSAKIYAMAMAデザインの水着を着てもらいたいです。以下のリンク先は依頼された衣装です。アルバム内の衣装の参考をもっと添付しておきますね。\nhttps://www.pixiv.net/en/artworks/76309306\n\nこの依頼の男性は顔のないモブキャラです。男性は筋肉質でペニスが大きいものをお願いします。\n\n今回のシナリオでは、グレイちゃんは王道のビキニを着ています。顔のないモブキャラが催眠術の振り子を使ってグレイちゃんをマインドコントロールする。 顔のないモブキャラがグレちゃんを跪かせてペニスを咥えさせる。女は顔のないモブキャラの奴隷になってしまった。\n\n参考画像を添付しました。ご検