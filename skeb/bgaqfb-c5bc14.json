絶され、一人になるかもしれないと怯えてしまっています。\n女の子は男の子に対して「信頼出来る護衛」と思っています。\n\n⋆┈┈┈┈┈⋆\n恋愛系でなければ基本的な地雷は特にございません！こまちさんのお好きなように解釈していただき、描きやすいように描いていただけますと幸いです。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 944225, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ふじか", "screen_name": "fujijika", "avatar_url": "https://pbs.twimg.com/profile_images/1391726816117727233/EJOTIpKI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/994417616021172224/1592136585/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 1518970, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "くじらざと", "screen_name": "whale_zato", "avatar_url": "https://pbs.twimg.com/profile_images/1474809659546824704/aTCpd6_g.png", "header_url": "https://pbs.twimg.com/profile_banners/993460553648488448/1720309300/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "comic"}, {"genre": "art"}], "banned": false, "nc": 1}, {"id": 2004261, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "散", "screen_name": "san_till_", "avatar_url": "https://pbs.twimg.com/profile_images/1667518677108027392/s6vE5ZvM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1488530399135420425/1643728478/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "s