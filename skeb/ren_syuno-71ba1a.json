e55-74bf-4c2b-9da3-2b4004add842?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e121a88f450ce80b8445893c8e7a18c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5f1060a7/uploads/origins/75f10e55-74bf-4c2b-9da3-2b4004add842?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f98a5e0e8239b59e113699f1beac33f4", "srcset": "https://si.imgix.net/5f1060a7/uploads/origins/75f10e55-74bf-4c2b-9da3-2b4004add842?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f98a5e0e8239b59e113699f1beac33f4, https://si.imgix.net/5f1060a7/uploads/origins/75f10e55-74bf-4c2b-9da3-2b4004add842?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b61dacec5de69673b887996d3d550327 2x, https://si.imgix.net/5f1060a7/uploads/origins/75f10e55-74bf-4c2b-9da3-2b4004add842?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7b627d67b53e14561ccbe6879e86ee73 3x"}, "body": "初めまして、るげつぺぽと申します。\nツイッターでお見かけした放浪者の絵がとても素敵で、skebを拝見したところ描かれているサンダルフォンの絵もこれまたクールで、是非私が趣味の配信で使用しているキャラクターをお願いしたいと思いました。\nご検討のほどよろしくお願いいたします。\n\n15歳の男の子、身長155～160、顔は若干中性よりです。\n髪の毛は白と青色のツートンで、普段から眠そうにしてます。\n地頭はいいけどたまにうっかりしているところがあります。\n全体図参考\nhttps://twitter.com/rugetsupepo/status/1690939483074826240\n表情変化分参考\nhttps://twitter.com/rugetsupepo/status/1664293689412435968\n\nクールな表情を浮かべつつ、少年の幼さを少し残して描いていただけると嬉しいです。\n太極図のアクセサリは必ず入れて欲しいです。\nその他細かい構図、服装などはおまかせします。\nアイコンや、ヘッダ、YouTubeなどで使用する可能性があります。\nお手数おかけしますがキャラのみ透過差分も欲しいです。\n形式はpngまたはpsdでお願いします。\n\n以上の内容でお受けできそうであれば、お願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ren_syuno/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2989011, "client_id": 2203147, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3471ea44/uploads/orig