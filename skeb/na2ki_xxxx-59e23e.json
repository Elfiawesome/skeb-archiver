er)にてイラストを拝見し、是非依頼したいなと思いリクエストさせていただきました。\n\n【リクエスト内容】\n・資料URLに貼ったオリジナルキャラクターを構図や衣装はなつき様のおまかせでお願いしたいです。\n\n【使用用途】\n・X(旧Twitter)、discordでのアイコン使用\n\n是非ご検討の程よろしくお願いします。\n\nhttps://drive.google.com/file/d/11pCs3l-eLQk49hVuubKON8dbdaTmtwDm/view?usp=drivesdk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@na2ki_xxxx/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3796608, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cad31511/uploads/origins/99770c5d-d09f-411f-8240-9490b8de900e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75087de7790e6d17f92d948fa28f07f5", "srcset": "https://si.imgix.net/cad31511/uploads/origins/99770c5d-d09f-411f-8240-9490b8de900e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75087de7790e6d17f92d948fa28f07f5, https://si.imgix.net/cad31511/uploads/origins/99770c5d-d09f-411f-8240-9490b8de900e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=135a1f8c12ac134283f3bdca5c272da1 2x, https://si.imgix.net/cad31511/uploads/origins/99770c5d-d09f-411f-8240-9490b8de900e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=928f25d93dd7aa2fd35f9e37f19b00e1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cad31511/uploads/origins/99770c5d-d09f-411f-8240-9490b8de900e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91e1e5ac3236227b231cd924823d3ad9", "srcset": "https://si.imgix.net/cad31511/uploads/origins/99770c5d-d09f-411f-8240-9490b8de900e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91e1e5ac3236227b231cd924823d3ad9, https://si.imgix.net/cad31511/uploads/origins/99770c5d-d09f-411f-8240-9490b8de900e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&b