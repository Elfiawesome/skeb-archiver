んどくせえ」。\n不信に思ったりすると、肩眉が上がって眉間に皺を寄せることが多いです。\n私生活はだらしなく、掃除などサボりがち。\n低血圧。\n\n\n＜背の大きい方＞\n\n年齢：29歳\n身長：188cm\n髪色：深緑\n瞳　：黒\n肌　：イエベ\n動物に例えるなら：ワニ\nオプション：首と左手に傷あり、喫煙者（ブラックストーン）、キャップ\n\n性格：\n見た目はいかついが上品な立ち振る舞いと、話し方も紳士的。\nメガネの方には敬語で話す。多趣味。\n結構周囲に気を使いがち。\n\nhttps://drive.google.com/drive/folders/1tgtE49mVo0ICZCpAGq0Y4Tfd4_OHTpzn?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@0v0_mu/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1840874, "client_id": 1932467, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d08fb9e/uploads/origins/48c32099-e77e-4901-bd70-d7b2fefe22ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a0a9cea7b727c047571fcdd2cc4043b", "srcset": "https://si.imgix.net/8d08fb9e/uploads/origins/48c32099-e77e-4901-bd70-d7b2fefe22ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a0a9cea7b727c047571fcdd2cc4043b, https://si.imgix.net/8d08fb9e/uploads/origins/48c32099-e77e-4901-bd70-d7b2fefe22ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ca3e757a4116e6f3e30eabdd22810ae 2x, https://si.imgix.net/8d08fb9e/uploads/origins/48c32099-e77e-4901-bd70-d7b2fefe22ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b9a48621b2d337070f22156989e23f4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d08fb9e/uploads/origins/48c32099-e77e-4901-bd70-d7b2fefe22ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e71a32c7d78b2347e5ad6448ce19a15", "srcset": "https://si.imgix.net/8d08fb9e/uploads/origins/48c32099-e77e-4901-bd70-d7b2fefe22ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e71a32c7d78b2347e5ad6448ce19a15, https://si.imgix.net/8d08fb9e/uploads/origins/48c32099-e77e-4901-