\nもう　手を離すから　ひとりで行っていいんだよ\n今まで　怖かったね　お疲れ様　……　またどこかで。\nもう二度と会うことはないんだろうけど。", "nc": 144, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@woool1029/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 136140, "client_id": 53178, "vtt_url": "https://fcdn.skeb.jp/uploads/23562/0/vtt/0.vtt?response-content-disposition=inline&Expires=1780460808&Signature=WuYfxE7uXdAzPgl8CTYC8XIyuV3qcJfCh1XYzhsi27ChxH-4wZ~6-214-CxVjZA7Q2d5LZSjD2ogvQ0ewddtw35kNeluplE5R5WIg-BpNa0yLEsmhYbw1~mtPKuDdf5v-rKVUCteL5-y~EVOegMjfulPGFlLKnJ2palhMWNxkAXWG9uFHhSwq9~HIbQ2tEJxxJZf46tL0fxqF511d4ZIPB1FbnimyOiHGJ0a0vyY0zWtg-8iuQO1CMntTTDlJUtLpOUrUhkyyQ4ahmx8dkrEzYR0DeaVwBgc9QdKhIGoAhJZ3zC4W5dtadGzDRc3JH1bcAdqbGixiAeteJ-wKFGMsQ__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496aa1eafd2672ec9cf9225f13a2f027", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496aa1eafd2672ec9cf9225f13a2f027, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d081bd0b41a2d8c1513f7d350f82192 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e420d040323801b1e0e94cbba5f9e33 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/23562/0/mp3_128k/0?response-content-disposition=inline&Expires=1780460808&Signature=ppJ9OXDk~uN6pqZzWF3M4nEYJqhXdlAgUc4eyBlTF601m8v4NZdaHM~JRV1AuvOnyeONrVW1w119qfHTnStJpxGUcazmD-h~tGgPS