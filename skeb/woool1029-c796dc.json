\nもう　手を離すから　ひとりで行っていいんだよ\n今まで　怖かったね　お疲れ様　……　またどこかで。\nもう二度と会うことはないんだろうけど。", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@woool1029/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 136140, "client_id": 53178, "vtt_url": "https://fcdn.skeb.jp/uploads/23562/0/vtt/0.vtt?response-content-disposition=inline&Expires=1784372417&Signature=NyYd-hKpFVAcAlX7qjYwFdkwD~TuAfemlNMR5xVfmgJXlGKrwLvg6YV4IdshD8ku4TcoJRBCX95VKtM6sBmvh4kDM9KlwaLk9ETBkU07M9MUjfTj2Y~dylyk3pTerQELsoTgRxw3P19RIouuUadjZrJn3~VyDW1CzIUojcGumDBbk5~28deI4B1wwnnRMm2xlItzNZrcwA4PrvZ43Za84tkexyCKmutlULhrABKjg1NlIECtYTBFJx8zAnxaQsrAtHRMUnD0KY-kq1tjYLFt1hK6BnKUDTm9tyvWnWf9ciMTOln4snViPOtRazxAPM8LFwZPnXTRTNg3ljKYBHuV~Q__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496aa1eafd2672ec9cf9225f13a2f027", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496aa1eafd2672ec9cf9225f13a2f027, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d081bd0b41a2d8c1513f7d350f82192 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e420d040323801b1e0e94cbba5f9e33 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/23562/0/mp3_128k/0?response-content-disposition=inline&Expires=1784372417&Signature=RHPWMvckFtrJ5aMsQGY048Nc-mQF6wEPjoDD~-5pDdZUukCoa4AYhYPzB-uUMo6FH7bZ1pj-f7j0qmYb9b06FSolctAxRJQh~Q6QAiW