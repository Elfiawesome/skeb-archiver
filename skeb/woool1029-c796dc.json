み　これで　おわり……。\nここを通れば　ぜんぶをおわりにできる\nもう　手を離すから　ひとりで行っていいんだよ\n今まで　怖かったね　お疲れ様　……　またどこかで。\nもう二度と会うことはないんだろうけど。", "nc": 16, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@woool1029/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 136140, "client_id": 53178, "vtt_url": "https://fcdn.skeb.jp/uploads/23562/0/vtt/0.vtt?response-content-disposition=inline&Expires=1774635779&Signature=ijnCMcvK2dz87fBSxUBUspkIrgJ3pP0R4LLc3mzaD0oMW6iRQiZhA8~IJUjBijtOMNS0FM4oTuRNuvHmsDP3LdFN8gJPKCZBUokR6W9wawOy8VbXtFPL3OJAjS5qWTVC-hjg280YOpzJM9X8cvkKYxf5ekgv7g4cDdt1863J3W3aSm3i9xTnePy1eztSniUBcIDP3JZsDHEfOGCHEHNIEaCOX2EQgk9JRV7Nga7JyfRNe5i0yGwerPU1duOpo~K-AdCWD4xbLSBOeFQCQqokjkEvYasEYaXqk7z1NqDbUu0UXuCaLg7bXktB5bDPqjI4-66aUPMFBxjKpbmi4J2giw__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496aa1eafd2672ec9cf9225f13a2f027", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496aa1eafd2672ec9cf9225f13a2f027, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d081bd0b41a2d8c1513f7d350f82192 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e420d040323801b1e0e94cbba5f9e33 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/23562/0/mp3_128k/0?response-content-disposition=inline&Expires=1774635779&Signature=VOF8eCVCaa7-O4KT2gw~PbWhBYIhZ5qHG9X~WwOJOdB1wY0FkASp~HuUvQ2TlyHABugNw2