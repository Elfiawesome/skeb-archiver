る\nもう　手を離すから　ひとりで行っていいんだよ\n今まで　怖かったね　お疲れ様　……　またどこかで。\nもう二度と会うことはないんだろうけど。", "nc": 144, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@woool1029/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 136140, "client_id": 53178, "vtt_url": "https://fcdn.skeb.jp/uploads/23562/0/vtt/0.vtt?response-content-disposition=inline&Expires=1781940336&Signature=SEWGZ1nZ9PmqioG7ZFBn0nFAQ27QUZlITJ2neQS59vMmf3D8-nHiBLmwZD22fPMXMcGZPHET6ECk9JLWOYDzi0MgmzmLM8w0J9iUxZ~9d9yzGp7XY1uvWLqV47j5jZEpXZ3~ezR-XnUfxLkrHL0GvoPQWytdVOd03sdPUf6SvKChAjwX-NuvYa1Q2XcPB~XhrtzuIXyTBQnGF0EI9RE-JTCgYUFatwQ9LrTqoviZfB7C~omyQckmsuw91WIRuZ2RofeSMFcxlWrOny997c1KuhWZh5t1K0qmoXKzycwaOWVyCZ2XAlC9LD~BSYJV-zYOtMUls1k6gAC8Wb8jUHtKIA__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496aa1eafd2672ec9cf9225f13a2f027", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496aa1eafd2672ec9cf9225f13a2f027, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d081bd0b41a2d8c1513f7d350f82192 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e420d040323801b1e0e94cbba5f9e33 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/23562/0/mp3_128k/0?response-content-disposition=inline&Expires=1781940336&Signature=m~kBI8nLdJYmgT7tyyR1AxRs5GydmD4995Z30IiN6daTgqxOHzvvTWHW-VAgnRX-57PP0~d7gTnZu8n7YbYH0h5BeZp40BPzMSLE