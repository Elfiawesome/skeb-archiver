きる\nもう　手を離すから　ひとりで行っていいんだよ\n今まで　怖かったね　お疲れ様　……　またどこかで。\nもう二度と会うことはないんだろうけど。", "nc": 129, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@woool1029/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 136140, "client_id": 53178, "vtt_url": "https://fcdn.skeb.jp/uploads/23562/0/vtt/0.vtt?response-content-disposition=inline&Expires=1783056470&Signature=T34wA6ZZ9VQ9kRafaDUTFMbgdFpzIx9h412sYl9EWrvv2VhI9wZjWPb4ZCwYI2dMOnt3~j43VJX-AvYU3HiZ~~HeZSF5AnkTKIr1LI1BkXXYX2U7tYRETSXhfQ0Ke1V~ZbY2SgE6lXX8qlYsCVyhGfNC7Ub9KDJ-hBzRrMFVFh1Oo1Wi3m1VHjSlMB6P3lKHTB4AvAJCN~A50t68dCTSbGXL-dweVeUb06SqehwUIy5W1o2QH9UhbKc0zmSRsh1VI63S87zBX~J3FeutccRg7txpQwRwqsEUzWYrlLdjG4M9rYdk1pC9IIQvs3Zf0cjusrGwIBKKfQoldpJR56Z0xQ__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496aa1eafd2672ec9cf9225f13a2f027", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496aa1eafd2672ec9cf9225f13a2f027, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d081bd0b41a2d8c1513f7d350f82192 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e420d040323801b1e0e94cbba5f9e33 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/23562/0/mp3_128k/0?response-content-disposition=inline&Expires=1783056470&Signature=DRS71~hsVQYzhxSwSnsdDdRtx4A1igscSUcL7c4tDkF1zDlzpLgloRcIcvnCvtc4P2yA5EmAwZ0SL9-q6S~T9rEi-8MiRqcOlnd