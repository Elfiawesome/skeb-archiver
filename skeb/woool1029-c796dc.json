　手を離すから　ひとりで行っていいんだよ\n今まで　怖かったね　お疲れ様　……　またどこかで。\nもう二度と会うことはないんだろうけど。", "nc": 1, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@woool1029/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 136140, "client_id": 53178, "vtt_url": "https://fcdn.skeb.jp/uploads/23562/0/vtt/0.vtt?response-content-disposition=inline&Expires=1783515629&Signature=BPMeAJe~fSouspkeQTYo4dJ-s6wZ1wrSy3b3myCCB9O2wNC1vDA55wq4I2wZiuy7jaxmFzKGGgGZrq2yTdvkwoyFx-1mCHCtepIo5gwuyZaEFR8PUEKP59EYLhQJxoVNQiRKr4FjuPgUO5qxwOqlrxBUV2eEpzzhoABarVGs8lwPCnpIExC-MVWhohpJ5TWIqkpRWyt7cWLR01t4JXvlN-4I1opXHu8Y2-2i6xgAn-0ZM07LW5pZumi8Yz25aKRm4Zr0Mn5dsq4Q6HkGnZWocBUHv-ISxXPvNIfJPGjom-aEgM15k018EcOgL56vtDkBFFP-0Pb2CClIDXdf3tcQpw__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496aa1eafd2672ec9cf9225f13a2f027", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496aa1eafd2672ec9cf9225f13a2f027, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d081bd0b41a2d8c1513f7d350f82192 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e420d040323801b1e0e94cbba5f9e33 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/23562/0/mp3_128k/0?response-content-disposition=inline&Expires=1783515629&Signature=MlT12aRAr2j9rPd1VaTyG8l1lJHM5YujqTuFUwrbYd5FkxI86vUhxb275RrWOmmGy~~rjucdfC-Dx8VEmdIvDVWr-TlR1vcs9vn1bGIf71J