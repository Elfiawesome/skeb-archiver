う　手を離すから　ひとりで行っていいんだよ\n今まで　怖かったね　お疲れ様　……　またどこかで。\nもう二度と会うことはないんだろうけど。", "nc": 129, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@woool1029/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 136140, "client_id": 53178, "vtt_url": "https://fcdn.skeb.jp/uploads/23562/0/vtt/0.vtt?response-content-disposition=inline&Expires=1782482782&Signature=EXyJmToJTGFDT0jrRNFuHyVQGohcFTdfbmb-4Mj98VL8GWYDFHwDl4Oow8c~6FHpOwTOgxNH0galVBit1ydspAW1UCXaivssHMTH10EXp4XIMlUJWjW2YVlOa5vHPikfSKPshq1~ApLLMkekfCEZNKbnbvUI2A8nlU8zlmvNpERrQkC7fyQeaM-mXk~l8b79EWQtJey3A1UX5l9acD7a7Bsn88Rohzw5X0Qy3zDj1Pc3UAdSnQjMdXuK2loOWgXCYVR6Tl~99-jKxuEWIibNmhaxuDFCgdm6zIdlFi~-KN71srzwLg3CBOtqRrLRjpc9AM1jhpwHxgKp8k8v1ynoKQ__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496aa1eafd2672ec9cf9225f13a2f027", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496aa1eafd2672ec9cf9225f13a2f027, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d081bd0b41a2d8c1513f7d350f82192 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377653244290236434%2FOvj42I2a.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e420d040323801b1e0e94cbba5f9e33 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/23562/0/mp3_128k/0?response-content-disposition=inline&Expires=1782482782&Signature=NNGV11UGKjwQ8rc3LmQWwl~73IJIpuMrwW~7ntT5EpCP82vkLZb~rdgbVb8WHy9nmqWJBjDKeHkcRbLy6gySHPxCBl9b7DFoJF6RwY98