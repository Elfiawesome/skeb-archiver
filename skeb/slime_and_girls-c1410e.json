slime_and_girls/status/1456823955826700290\n\n（資料2）\n下記URLのP15とP14\nhttps://www.pixiv.net/artworks/92134464", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cursscurss/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 321876, "client_id": 513233, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb4b1c90/uploads/origins/3281b20a-cc18-4996-9f7b-3b3c80134adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c012c093bfa3b3bf4f14a07976ed3ab7", "srcset": "https://si.imgix.net/cb4b1c90/uploads/origins/3281b20a-cc18-4996-9f7b-3b3c80134adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c012c093bfa3b3bf4f14a07976ed3ab7, https://si.imgix.net/cb4b1c90/uploads/origins/3281b20a-cc18-4996-9f7b-3b3c80134adf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=607a0934be564f9bed5566be98f6e2d3 2x, https://si.imgix.net/cb4b1c90/uploads/origins/3281b20a-cc18-4996-9f7b-3b3c80134adf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76fcaae13b08790adc805dae2bd22f25 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb4b1c90/uploads/origins/3281b20a-cc18-4996-9f7b-3b3c80134adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d42205fe37f307941b07768f0c2d2e6e", "srcset": "https://si.imgix.net/cb4b1c90/uploads/origins/3281b20a-cc18-4996-9f7b-3b3c80134adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d42205fe37f307941b07768f0c2d2e6e, https://si.imgix.net/cb4b1c90/uploads/origins/3281b20a-cc18-4996-9f7b-3b3c80134adf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=67c980d09e7da1c92492c5b5f1c39bc5 2x, https://si.imgix.net/cb4b1c90/uploads/origins/3281b20a-cc18-4996-9f7b-3b3c80134