op&crop=top&w=200&h=200&s=a304a5e579a83a85c8374487e5c70ac6 2x, https://si.imgix.net/c08d7665/uploads/origins/d3b2c1e7-d398-4629-845a-59ab400eaa24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ae89c9748d87c3dc270da4ebb7b2c9b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c08d7665/uploads/origins/d3b2c1e7-d398-4629-845a-59ab400eaa24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d91d4cb490d1b7831ec79d3f3a52ceaa", "srcset": "https://si.imgix.net/c08d7665/uploads/origins/d3b2c1e7-d398-4629-845a-59ab400eaa24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d91d4cb490d1b7831ec79d3f3a52ceaa, https://si.imgix.net/c08d7665/uploads/origins/d3b2c1e7-d398-4629-845a-59ab400eaa24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9de2f01336567e275ea608d50748752e 2x, https://si.imgix.net/c08d7665/uploads/origins/d3b2c1e7-d398-4629-845a-59ab400eaa24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c95ae78f40474baecdbbf72354117812 3x"}, "body": "しおから様\n先日は自探索者の素敵なイラストを本当にありがとうございました！\n綺麗可愛いで目の保養すぎてずっとニコニコ見ています……！\n\nしおから様の描くうちの女の子たちを沢山見たい……！となってしまったので、またリクエストしに来てしまいました！\n\n■描いていただきたいキャラクター\n珠之井ゆらちゃん\n桃桃（たおたお）ちゃん\n※別々に描いてもらえたら嬉しいです！\n\n■珠之井ゆら　詳細\n25歳　161センチ（+ヒール6センチ）\nモチーフ:鈴蘭、鈴\nイメージ:穏やか\n警察として働いている女の子。\n人を癒すのが得意で、彼女が歌うとみんな心が安らいだりします。\n歌を歌うと睡蓮の花が咲いて視覚的にも綺麗になります。\n花など植物が大好きです。\n髪につけている鈴は実際にチリンチリン鳴るので、癒し効果間違いなしです。\n\n◯その他\nお洋服、髪型の改変　大丈夫です！\n刀はお仕事で使っているだけなので持たせなくて大丈夫です！\n\n■桃桃　詳細\n19歳　153センチ\nモチーフ:桃の花、桃\nイメージ:幼い\nとあるところで何でも屋さんとして働いている女の子。\n家族が大好きで、家族の前ではあどけない笑顔でいつも笑っています。\n愛くるしい見た目をしていますが、ものすごく美人さんで、家族以外の前では表情がストンと落ちるので、美人すぎて怖いという現象が発生します。\n\n◯その他\n右（←）目元に泣きぼくろがあります\n髪型、改変大丈夫です！\nお洋服は中華ロリィタであれば何でも大丈夫です！\n胸はなるべくぺったんこでお願いします！\n\n■使用用途\nSNSに掲載したり鑑賞したりします！\n\n■その他\nどちらも構図などはおまかせします！\n\nしおから様の描く女の子、可愛すぎます！\nご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1zrzdC6I7mUEFJepPtTXyd87Q3YUo5_NS", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@K_shiokara/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2401246, "client_id": 3476669, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7f51016/uploads/origins/c005e22c-38d0-4d78-a02c-3544a8109fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1242ac73711abc7d6ba280341934ad49", "srcset": "https://si.imgix.net/d7f51016/uploads/origins/c005e22c-38d0-4d78-a02c-3544a8109fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1242ac73711abc7d6ba280341934ad49, https://si.imgix.net/d7f51016/uploads/origins/c005e22c-38d0-4d78-a02c-3544a8109fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f7ced2052213104c096de6d0e43da0d 2x, https://si.imgix.net/d7f51016/uploads/origins/c005e22c-38d0-4d78-a02c-3544a8109fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c41ecce5b9a9e968caff613e7769b437 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7f51016/uploads/origins/c005e22c-38d0-4d78-a02c-3544a8109fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25e8c6c70c0fbec4e72b4965d9f2f61e", "srcset": "https://si.imgix.net/d7f51016/uploads/origins/c005e22c-38d0-4d78-a02c-3544a8109fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25e8c6c70c0fbec4e72b4965d9f2f61e, https://si.imgix.net/d7f51016/uploads/origins/c005e22c-38d0-4d78-a02c-3544a8109fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9d7c8e1ab7a381d2c54595ae80e52d4 2x, https://si.imgix.net/d7f51016/uploads/origins/c005e22c-38d0-4d78-a02c-3544a8109fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&f