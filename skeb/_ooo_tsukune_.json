サー」は非人道的な方法を用いて亡くなった「莉夜」の魂を人形に呼び戻しますが、「莉夜」は生前とは打って変わって、主人の命令に忠実な人形となってしまいました。それでも「莉夜」とまた会えたことに「アーサー」は喜びを感じ、「莉夜」を愛し続けます。\n\nシチュエーション・構図などはおまかせしますが、今回はこの二人が一緒にいるところを描いていただきたいです。ラブラブ、ほんわか、ダーク、なんでも構いません。\nひとつだけお願いしたいのは、もし「莉夜」を笑わせる場合はぎこちない感じだと嬉しいです。\n\nお忙しいところ恐縮ですが、よろしくお願いします。\n\nhttps://x.com/BNZKSUB/status/1911039680843489463", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_ooo_tsukune_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3393567, "client_id": 3480895, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/561c1560/uploads/origins/bb02421e-4296-4cf1-978c-23bd86a9fa7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09f47a24c26f64267bf95f54ba905b90", "srcset": "https://si.imgix.net/561c1560/uploads/origins/bb02421e-4296-4cf1-978c-23bd86a9fa7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09f47a24c26f64267bf95f54ba905b90, https://si.imgix.net/561c1560/uploads/origins/bb02421e-4296-4cf1-978c-23bd86a9fa7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c793f22444b015a9501d70ddf35f9e6a 2x, https://si.imgix.net/561c1560/uploads/origins/bb02421e-4296-4cf1-978c-23bd86a9fa7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be91e22106c43495a3ce04ecaf6daaca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/561c1560/uploads/origins/bb02421e-4296-4cf1-978c-23bd86a9fa7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=646e999f2f12190ab9d598610f3ec4c4", "srcset": "https://si.imgix.net/561c1560/uploads/origins/bb02421e-4296-4cf1-978c-23bd86a9fa7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=646e999f2f12190ab9d598610f3ec4c4, https://si.imgix.net/561c1560/uploads/origins/bb02421e-4296-4cf1-978