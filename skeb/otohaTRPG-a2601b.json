fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8347e05102218b145da38bac1cfdf4d, https://si.imgix.net/f181efbd/uploads/origins/8aa06aa8-c577-473f-b66d-b9460f0e1afc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bdba334d810e41d8d72d29f9b0d49670 2x, https://si.imgix.net/f181efbd/uploads/origins/8aa06aa8-c577-473f-b66d-b9460f0e1afc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1eefe9fe951c6916fd32fae44036a9d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f181efbd/uploads/origins/8aa06aa8-c577-473f-b66d-b9460f0e1afc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70fe6716b57654ef460539a29ba8f85a", "srcset": "https://si.imgix.net/f181efbd/uploads/origins/8aa06aa8-c577-473f-b66d-b9460f0e1afc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70fe6716b57654ef460539a29ba8f85a, https://si.imgix.net/f181efbd/uploads/origins/8aa06aa8-c577-473f-b66d-b9460f0e1afc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0542e8a0df189a558fad7dcc6d8820ea 2x, https://si.imgix.net/f181efbd/uploads/origins/8aa06aa8-c577-473f-b66d-b9460f0e1afc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a213b81bac3fe3febe6872a77b2fe9a 3x"}, "body": "おとは様、はじめまして！\nおとは様がSkebを募集しているのをお見かけして、とても素敵な絵柄でぜひリクエストさせて頂きたいと思いご連絡致しました…！\n\n描いていただきたい探索者が三人おり、二人はとあるシナリオの自陣でセットで描いて頂きたいと思っております…！もう一人は刑事の探索者になります。\n資料の方をまとめさせていただきましたので、お手数をお掛け致しますがご確認お願いいたします🙇🏻‍♂️\n\n┈┈┈┈┈┈┈┈┈┈\n\n❏ セットで描いて頂きたい二人についてです。\nようこそ！迷冥市役所都市伝説課へ！の自陣を描いて頂きたいと思っております。\n仲良しな雰囲気の一枚絵だと嬉しいです。\nHO1は天然でドジっ子なお兄さん、HO2はそんなHO1を心配しつつも大切に思っている女の子です。\nお互いがお互いを大切に思っているような関係性になります。\n\n❏ 刑事探索者についてです。\n庭師は何を口遊む HO2になります。\n茶髪でマフラーを腕に巻いている男性になります。\n真面目なのですが優しい性格の持ち主です。そんな探索者のデスクワークをしている一枚絵を描いていただきたいと思っております。デスクワーク時は眼鏡をしているのですが、こちらは伊達眼鏡です。おとは様が描きやすければ眼鏡無しでも大丈夫です。\n\n┈┈┈┈┈┈┈┈┈┈\n\nお忙しいところ申し訳ございません、もしよろしければご検討頂けますと幸いです…！\n金額が足りない場合や何か不都合がありましたらキャンセルして頂いて構いません。ご縁がありましたら嬉しいです、よろしくお願いいたします🙇🏻‍♂️✨\n\n✧ 資料URL ✧\n\nhttps://www.dropbox.com/scl/fo/eiox4kms8n83shllpnbcl/ABCgo5IslgMxuPh00MXpfR8?rlkey=rw5n3dcfouprpalzxm5fxq4z3&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@otohaTRPG/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3299826, "client_id": 152691, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61dcc46b/uploads/origins/e16a9422-533f-4c95-8f48-22683c6a642d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51b81221142c05de0888d2fb1abae5ba", "srcset": "https://si.imgix.net/61dcc46b/uploads/origins/e16a9422-533f-4c95-8f48-22683c6a642d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51b81221142c05de0888d2fb1abae5ba, https://si.imgix.net/61dcc46b/uploads/origins/e16a9422-533f-4c95-8f48-22683c6a642d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a64b7c34b961ed1f4052381dc4c8c7f 2x, https://si.imgix.net/61dcc46b/uploads/origins/e16a9422-533f-4c95-8f48-22683c6a642d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2aa5abcccb340c4d4f460827837705e0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61dcc46b/uploads/origins/e16a9422-533f-4c95-8f48-22683c6a642d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c81f0825308702536a32bc171838ecd", "srcset": "https://si.imgix.net/61dcc46b/uploads/origins/e16a9422-533f-4c95-8f48-22683c6a642d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c81f0825308702536a32bc171838ecd, https://si.imgix.net/61dcc46b/uploads/origins/e16a9422-533f-4c95-8f48-22683c6a642d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=c