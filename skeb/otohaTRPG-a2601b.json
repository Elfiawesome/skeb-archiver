です。\nお互いがお互いを大切に思っているような関係性になります。\n\n❏ 刑事探索者についてです。\n庭師は何を口遊む HO2になります。\n茶髪でマフラーを腕に巻いている男性になります。\n真面目なのですが優しい性格の持ち主です。そんな探索者のデスクワークをしている一枚絵を描いていただきたいと思っております。デスクワーク時は眼鏡をしているのですが、こちらは伊達眼鏡です。おとは様が描きやすければ眼鏡無しでも大丈夫です。\n\n┈┈┈┈┈┈┈┈┈┈\n\nお忙しいところ申し訳ございません、もしよろしければご検討頂けますと幸いです…！\n金額が足りない場合や何か不都合がありましたらキャンセルして頂いて構いません。ご縁がありましたら嬉しいです、よろしくお願いいたします🙇🏻‍♂️✨\n\n✧ 資料URL ✧\n\nhttps://www.dropbox.com/scl/fo/eiox4kms8n83shllpnbcl/ABCgo5IslgMxuPh00MXpfR8?rlkey=rw5n3dcfouprpalzxm5fxq4z3&dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@otohaTRPG/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3299826, "client_id": 152691, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61dcc46b/uploads/origins/e16a9422-533f-4c95-8f48-22683c6a642d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51b81221142c05de0888d2fb1abae5ba", "srcset": "https://si.imgix.net/61dcc46b/uploads/origins/e16a9422-533f-4c95-8f48-22683c6a642d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51b81221142c05de0888d2fb1abae5ba, https://si.imgix.net/61dcc46b/uploads/origins/e16a9422-533f-4c95-8f48-22683c6a642d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a64b7c34b961ed1f4052381dc4c8c7f 2x, https://si.imgix.net/61dcc46b/uploads/origins/e16a9422-533f-4c95-8f48-22683c6a642d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2aa5abcccb340c4d4f460827837705e0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61dcc46b/uploads/origins/e16a9422-533f-4c95-8f48-22683c6a642d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c81f0825308702536a32bc171838ecd", "srcset": "https://si.imgix.net/61dcc46b/uploads/origins/e16a9422-533f-4c95-8f48-22683c6a642d?bg=%23fff&auto=format%2Ccompress&fm=webp