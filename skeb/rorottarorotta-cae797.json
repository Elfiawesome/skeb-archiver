top&w=200&h=200&blur=200&s=3e6c866bf14bebf6d207e93946620f73", "srcset": "https://si.imgix.net/d16bae3b/uploads/origins/c47eadc2-708c-4c8b-8953-fe045eb828a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e6c866bf14bebf6d207e93946620f73, https://si.imgix.net/d16bae3b/uploads/origins/c47eadc2-708c-4c8b-8953-fe045eb828a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d4d3a7ff30449cf659c741bb9b17f622 2x, https://si.imgix.net/d16bae3b/uploads/origins/c47eadc2-708c-4c8b-8953-fe045eb828a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=13e24b51594748d626f7146dbfa85772 3x"}, "body": "ろろった先生、こんいちは！\nはじめまして、玖魔雪と申します。\n先生の描いた男の子が可愛くて、リクエストしたくなりました。\n自分のOCはケモではないが、とびっきりエッチなやつをお願いしたいです！\n基本的にすべてお任せいたします。\nできれば軍手とゴーグルを残したいですが、邪魔だったらなしでも結構です。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1F8bfP3-58KhENJI84-JerSj4TP5FrYFK?usp=sharing", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rorottarorotta/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 50742, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/82438557/uploads/origins/d1282cf2-4c52-42d3-93b0-8477ca4dcfc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d65ce7ee7f9d99e5ac016553bcc39eb", "srcset": "https://si.imgix.net/82438557/uploads/origins/d1282cf2-4c52-42d3-93b0-8477ca4dcfc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d65ce7ee7f9d99e5ac016553bcc39eb, https://si.imgix.net/82438557/uploads/origins/d1282cf2-4c52-42d3-93b0-8477ca4dcfc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fffa534802cf9c8b928c5304aaa0f856 2x, https://si.imgix.net/82438557/uploads/origins/d1282cf2-4c52-42d3-93b0-8477ca4dcfc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6796217647ac797bd97fcb987eb4f18 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82438557/uploads/origins/d1282cf2-4c52-42d3-93b0-8477ca4dcfc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32b9b98f4d159ebf1337f6a6242fca2f", "srcset": "https://si.imgix.net/82438557/uploads/origins/d1282cf2-4c52-42d3-93b0-8477ca4dcfc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32b9b98f4d159ebf1337f6a6242fca2f, https://si.imgix.net/82438557/uploads/origins/d1282cf2-4c52-42d3-93b0-8477ca4dcfc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=020b1ef2c7d139777eabcb252b016f9e 2x, https://si.imgix.net/82438557/uploads/origins/d1282cf2-4c52-42d3-93b0-8477ca4dcfc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=084b070203a6f06a0fd82953dab8b4e6 3x"}, "body": "ろろったさん、こんにちは。\nろろったさんの「石化とか拘束系用アカ」に惹かれてきたのですが。\n青銅化（ブロンズ）されてしまうケモショタヒーローをお願いできないでしょうか。\n\nユキトくんのようなうさみみ少年ヒーローが、\n首筋を毒牙でガブリとやられて、青銅化の石化毒を流し込まれてしまう、みたいなイメージで、\nだんだんと弱ってブロンズ像と化していく様子を差分でお願いしたいです。\n\nケモショタヒーローは、ユキトくんのような元気なうさみみっ子。\nシングレットを、お腹が見える上下セパレートにした、胸に丸いカラータイマーが輝くヒーロースーツにしてほしいです。\n\n敵は牙や爪に石化毒をもった、感情を読み取りにくい不気味な怪物、といった感じでしょうか。\n\n敵に背後から抱き着かれ、首筋に噛みつかれてしまったヒーロー。\nたっぷりと毒を流し込まれてしまった後で、深々とした噛み傷がくっきりとついている。\n敵は、片腕をヒーローの胴に回し、もう片方の手で頭を支えるように頬を撫でているけれど。\nヒーローは敵を振り解くどころか、動く力もなくなっていて。\nぐったりと体を預けてしまい、敵に支えられて立っているような有様。\n\n石化毒で弱っていくにつれ、青銅化が全身に拡がっていく様子をいくらか差分でいただけると嬉しいです。\n・噛みつかれた直後、毒でぐったりしているけれど、\n　まだ本来の健康的な肌色で、カラータイマーも明るく輝いている。\n・毒が回り始めた箇所から体が青銅化していき、\n　まだらではあるけれど全身の過半にせまるくらい（お顔は片頬）が固まってしまっている。\n　まだ青銅化していない肌も血色が悪く蒼白で、カラータイマーが弱々しく明滅している。\n・とうとう毒が体中に回って全身が固まり、完全にブロンズ像と化してしまう。\n　朦朧としたまま意識が遠のいていったような力ない表情で、カラータイマーも光が消えてしまっている。\n\n噛みつかれた時点で敗北必至、抵抗もできずにされるがまま、みたいな致命的な感じで、\n敗北感や無力感の漂う雰囲気にしていただけると嬉しいです。\n\nわがままの多い大ボリュームな内容になってしまい、すみません。\nお引受けいただける場合は、あくまでイメージということで。\n可能な範囲で、ろろったさんのやりやすいようにしていただいて問題ないので。\nよかったら、よろしくお願いします。\n\nhttps://x.com/rorororororotta/status/2013624649616101407", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rorottarorotta/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 50742, "client_id": 3721575, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/50954cd5/uploads/origins/3cbc28de-3f8f-41c5-809e-a941fa260a09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c167bd35bfa6c86f0d4a71fa5413d726", "srcset": "https://si.imgix.net/50954cd5/uploads/origins/3cbc28de-3f8f-41c5-809e-a941fa260a09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c167bd35bfa6c86f0d4a71fa5413d726, https://si.imgix.net/50954cd5/uploads/origins/3cbc28de-3f8f-41c5-809e-a941fa260a09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cd099f213251cb7f23eac32685b0a23 2x, https://si.imgix.net/50954cd5/uploads/origins/3cbc28de-3f8f-41c5-809e-a941fa260a09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8253aaa1e502efd7b6a10925fd160fb7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/50954cd5/uploads/origins/3cbc28de-3f8f-41c5-809e-a941fa260a09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26fa9e295255c7db5ea701949dcf228b", "srcset": "https://si.imgix.net/50954cd5/uploads/origins/3cbc28de-3f8f-41c5-809e-a941fa260a09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26fa9e295255c7db5ea701949dcf228b, https://si.imgix.net/50954cd5/uploads/origins/3cbc28de-3f8f-41c5-809e-a941fa260a09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=af82f99cd1ed09dc51a80db8046b442f 2x, https://si.imgix.net/50954cd5/uploads/origins/3cbc28de-3f8f-41c5-809e-a941fa260a09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed258c84cbf60a87b3c361b0641211e5 3x"}, "body": "こんにちは！私のオリジナルキャラクター（OC）兼VTuberのクリスを、猫耳のケモノミミ姿で描いていただけないでしょうか？もし可能であれば、彼が猫耳で遊んでいるところを目撃して、驚いた顔で赤面している様子を描いていただけると嬉しいです！\n\nhttps://vsona.co/kris-11/summertime/gallery/summertime/c2968c87-b740-4d5f-9392-88cb57de8cb9", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rorottarorotta/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 50742, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9613b0c5/uploads/origins/3dc5447e-74af-4689-a6ea-7d5253b9a136?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97efb530741d9762cbd77484b22ede53", "srcset": "https://si.imgix.net/9613b0c5/uploads/origins/3dc5447e-74af-4689-a6ea-7d5253b9a136?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97efb530741d9762cbd77484b22ede53, https://si.imgix.net/9613b0c5/uploads/origins/3dc5447e-74af-4689-a6ea-7d5253b9a136?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9cf98a5c5791c0fe9780338a709e68ad 2x, https://si.imgix.net/9613b0c5/uploads/origins/3dc5447e-74af-4689-a6ea-7d5253b9a136?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3533fcc9d8c6932f4e202ef4fb8d4269 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9613b0c5/uploads/origins/3dc5447e-74af-4689-a6ea-7d5253b9a136?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ba6f2610691c2e7a1ef5efef9f0d9c7", "srcset": "https://si.imgix.net/9613b0c5/uploads/origins/3dc5447e-74af-4689-a6ea-7d5253b9a136?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ba6f2610691c2e7a1ef5efef9f0d9c7, https://si.imgix.net/9613b0c5/uploads/origins/3dc5447e-74af-4689-a6ea-7d5253b9a136?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fb0a8b6a10fdedf2cd2a5a2315f6b312 2x, https://si.imgix.net/9613b0c5/uploads/origins/3dc5447e-74af-4689-a6ea-7d5253b9a136?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9312e643a4e03989c1d3abd47d08864e 3x"}, "body": "ろろったさん、こんにちは。\n\nろろったさんちのかわいいセイマくんの氷漬けなイラストをお願いできないでしょうか。\n\n氷漬けは、全身をごつごつとした氷に覆われるとか、氷の塊に閉じ込められるといった形ではなく。\n体そのものが凍り付いてしまう、体の形そのままに表層を氷でコーティングされる、みたいな固め方にしてほしいです。\n\n・（セイマくんを凍らせてしまう）相手に両頬を優しく手で挟まれているセイマくん\n・不安を押し隠したような表情で相手を睨むセイマくんだけれど\n・早くも体が末端から体が凍り始めていて、抵抗できずにいる様子\n・じわじわと全身に拡がる氷に体の大部分を覆われてしまう頃には、寒さで朦朧としてしまっていて\n・まだ凍っていないところも、すっかり凍えて肌の血色が悪くなってしまっている\n・とうとう全身が凍りついてしまったセイマくん\n・体の自由と一緒に力や意識まで奪われていったかのような弱弱しい表情で、固められてしまう\n・セイマくんを氷漬けにした相手が、愛し気にセイマくんの胸に頬を寄せている\n\nこのようなイメージで、\nセイマくんがだんだんと氷ついていってしまう様子をいくらかいただけると嬉しいです。\nろろったさんのお好きなように、エッチだったり、色気のある雰囲気や要素を足していただけると、\nこれまた嬉しいです。\n\nどのような方法でセイマくんが氷漬けにされてしまったかは、お任せとさせていただければと思います。\n（例えば、相手の魔法だったり。冷凍庫や吹雪の中のような環境だったり）\n\nろろったさんの大切なお子さんに、大ボリュームで勝手ばかりなお願いをすみません。\nこのような内容がお嫌いだったり、ご不快に思われたら重ねてすみません。\nお手数はおかけしてしまいますが、ご遠慮なくキャンセルいただいて構いません。\n\nもしよかったら、よろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rorottarorotta/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/40a7dcb7/uploads/origins/28b59e80-f174-4717-ae24-82702e5aa969?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0676cf31cc2b5d6b4f1b60c3739fd5d", "srcset": "https://si.imgix.net/40a7dcb7/uploads/origins/28b59e80-f174-4717-ae24-82702e5aa969?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0676cf31cc2b5d6b4f1b60c3739fd5d, https://si.imgix.net/40a7dcb7/uploads/origins/28b59e80-f174-4717-ae24-82702e5aa969?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&c