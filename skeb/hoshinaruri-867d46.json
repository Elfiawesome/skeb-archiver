rop&crop=top&w=200&h=200&s=4e3c8438196f81bfc2a6d5be15a268f2", "srcset": "https://si.imgix.net/f79715d5/uploads/origins/c89474f9-9682-4410-9a1b-e3f25cb6c548?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e3c8438196f81bfc2a6d5be15a268f2, https://si.imgix.net/f79715d5/uploads/origins/c89474f9-9682-4410-9a1b-e3f25cb6c548?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b20a26996ee153be34e4513ff1d74779 2x, https://si.imgix.net/f79715d5/uploads/origins/c89474f9-9682-4410-9a1b-e3f25cb6c548?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31574d2d5c67750650ce5c9d84056e61 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f79715d5/uploads/origins/c89474f9-9682-4410-9a1b-e3f25cb6c548?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4418d670a4a8ded027a4921d2f507417", "srcset": "https://si.imgix.net/f79715d5/uploads/origins/c89474f9-9682-4410-9a1b-e3f25cb6c548?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4418d670a4a8ded027a4921d2f507417, https://si.imgix.net/f79715d5/uploads/origins/c89474f9-9682-4410-9a1b-e3f25cb6c548?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d365417f0c65d0bf636aa4a757a6b8e5 2x, https://si.imgix.net/f79715d5/uploads/origins/c89474f9-9682-4410-9a1b-e3f25cb6c548?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1dc3c1bacc4d3b63112f8c4a6f18bbd1 3x"}, "body": "初めまして！\n私ムーと申します\nほしな月莉さんのイラストを拝見し、その可愛らしい絵柄と素敵なタッチに一目惚れいたしまして今回リクエストを送らせていただきます。\n\nリクエストしたい内容と致しましては、\n当方のオリジナルキャラクターがシャボン玉に閉じ込められている\nというものになります。\n\n私のオリジナルキャラクターに関しては私のTwitterアカウントのホームの固定ツイートにてキャラクターデザインを掲載しておりますのでその中からほしな月莉さんの気に入ったキャラクターで描いていただきたいです。\nまた、衣装に関しても元々のキャラクターデザインにこだわらずにほしな月莉さんの好きな衣装にしていただきたいです。\nシャボン玉に関しては、資料URLにて参考イラストを掲載したツイートのURLを貼らせていただきますのでそちらをご参考にして下さい。\n\nキャラクターや衣装に関してはほしな月莉さんにお任せすることになりますが、2点だけ希望がございます。\n\n·シャボン玉は「むにむに」や「ぷにぷに」、「ぷにゅんぷにゅん」、「ぽよんぽよん」といった弾力のある割れないシャボン玉にしていただきたいです。\n\n·キャラクターの表情に関しては具体的にこうして欲しいという希望はありませんが、イラストのシチュエーションとしましては、\n\n『なんで割れないし出られないのよ!?』\n\nという類いのものを希望したいので、それに準じた本人の意思で望んでシャボン玉に入ったのではなく何者かの手によってシャボン玉の中に閉じ込められて脱出不可能になったという展開の表情にしていただきたいです。\n\n\n以上がリクエスト内容の全容になります。\n少々特殊な内容なため可能でしたら今回のリクエストよろしくお願いいたします。\n\nhttps://twitter.com/syabon09/status/1381176108838580228?s=19", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hoshinaruri/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 782200, "client_id": 544647, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd3bc5b0/requests/279083_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29c0442a34629965aa308481a23365bb", "srcset": "https://si.imgix.net/bd3bc5b0/requests/279083_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29c0442a34629965aa308481a23365bb, https://si.imgix.net/bd3bc5b0/requests/279083_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f63d688b2f71dc422df5848a2abffbed 2x, https://si.imgix.net/bd3bc5b0/requests/279083_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54665370ebf8fdc1e590f825c4dac274 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd3bc5b0/requests/279083_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63a1126302b9dc6d37828ce408d61e30", "srcset": "https://si.imgix.net/bd3bc5b0/requests/279083_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63a1126302b9dc6d37828ce408d61e30, https://si.imgix.net/bd3bc5b0/requests/279083_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a99a9a1fcb908687e649bc7cbd6c7efb 2x, https://si.imgix.