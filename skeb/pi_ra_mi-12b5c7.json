4a2aba6c28c6", "srcset": "https://si.imgix.net/b2785001/uploads/origins/2e92810a-e801-45a9-8652-8f8d061241d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1feef5026269c70a325c4a2aba6c28c6, https://si.imgix.net/b2785001/uploads/origins/2e92810a-e801-45a9-8652-8f8d061241d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8117b87fc3ad16ba9718caa4e173691c 2x, https://si.imgix.net/b2785001/uploads/origins/2e92810a-e801-45a9-8652-8f8d061241d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2ef97bd4c7585e5649ed776301744c0 3x"}, "body": "初めまして、描かれていた水槽を眺めるイラストに惹かれました。もしよければ私の自創作百合をお願いしたいです。\n大学1年生(交際3年目)時点のイラストで、もし可能であれば水槽のイラストに似た雰囲気だと嬉しいです。服装や髪型、構図やキャラクターの目線の向き、生き物などお任せします。\n基本情報として、青髪は地毛が赤紫のため色で描く場合、今も睫毛のみ赤紫です。芯があり健康的で可愛いイメージです。\n銀髪は少しぼーっとしたオン眉細身色白の子です。髪が短めで背は高いですが普通に女の子として描いていただけたらと思います。\n資料がゴチャついており申し訳ありません、顔立ち(5)と体型(6)の資料中心に見てもらえればと思います。資料の後半数字の振られていないものは普段の雰囲気の参考イラストです。\nご縁があれば嬉しいです。\n\nhttps://drive.google.com/drive/folders/1cNG9ZOQUH1_gaN8A3V5xCBfAGRzN7UuO", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pi_ra_mi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3633663, "client_id": 4031758, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/232ed0db/uploads/origins/6d0cbbc1-701f-4417-a8f9-18afbfdcc21c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63ce447347dd9eb3c5e15fac2ece058e", "srcset": "https://si.imgix.net/232ed0db/uploads/origins/6d0cbbc1-701f-4417-a8f9-18afbfdcc21c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63ce447347dd9eb3c5e15fac2ece058e, https://si.imgix.net/232ed0db/uploads/origins/6d0cbbc1-701f-4417-a8f9-18afbfdcc21c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9af2d23ada22eac8e70736f4a74e74d 2x, https://si.imgix.net/232ed0db/uploads/origins/6d0cbbc1-701f-4417-a8f9-18afbfdcc21c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48de0d6ab87eb831d3b1ac68de7a0d53 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/232ed0db/uploads/origins/6d0cbbc1-701f-4417-a8f9-18afbfdcc21c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3019dd2cb23ac67ff48dc7450b868b6", "srcset": "https://si.imgix.net/232ed0db/uploads/origins/6d0cbbc1-701f-4417-a8f9-18afbfdcc21c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3019dd2cb23ac67ff48dc7450b868b6, https://si.imgix.net/232ed0db/uploads/origins/6d0cbbc1-701f-4417-a8f9-18afbfdcc21c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4e5897fcfb59f4eba86f429b163df894 2x, https://si.imgix.net/232ed0db/uploads/origins/6d0cbbc1-701f-4417-a8f9-18afbfdcc21c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a5cf2f6c93cf8b5d609c5703721c61c8 3x"}, "body": "はじめまして、Vtuber準備中の夜田ルゼと申します。\n\nぴらみ様のOC・ノアさんのイラストをSNSで拝見して以来、一目惚れしてしまい、リクエストを送らせていただきました。\n\n特に、ノアさんが葉っぱの下にいたり、おさかなを眺めていたりする「終末期地球観測記」シリーズがとても大好きです。\n\n何気ない日常を切り取ったような世界観や、優しく穏やかな空気感に惹かれ、ぜひお願いしたいと思いリクエストを送らせていただきます…！\n\nもし創作キャラクターのみお受けされている場合は、私の認識不足でしたら申し訳ございません。\n\n■依頼内容\nVtuber「夜田ルゼ」のイラスト制作をお願いいたします。\n\n■イラストのイメージ\n『夜田ルゼの観測ログ』というテーマでお願いしたいです。\n\n「終末期地球観測記」シリーズで感じたような、何気ない日常を優しく切り取る空気感の中で、配信では見ることのできない「夜田ルゼの日常のひとコマ」を描いていただけましたら嬉しいです。\n\n宇宙放送局で過ごす日常や、のんびりゲームをしたり、本を読んだり、ぼーっとしていたり、地球で初めて何かに触れていたり……。\n\nそんな何気ない一瞬を、ぴらみ様らしい優しく温かな雰囲気で表現していただけましたら幸いです。\n\n可能でしたら、肩に乗っているマスコットも一緒に描いていただけますと嬉しいです。（サイズはお任せいたします。）\n\n衣装は参考資料のものをベースに、上着あり・なしどちらでも大丈夫です。\n\nサイズや表情・ポーズにつきましては、ぴらみ様にお任せいたします。\n\nまた、特徴的なデザインでもある\n\n・ほくろ\n・クローバーを十字にしたような瞳孔\n・インテーク\n・頭の輪っか\n\nが分かるように描いていただけますと嬉しいです。\n\nまた、\n\n・八重歯は、お口が開いている表情でしたら描いていただけますと嬉しいです。\n・ねこちゃんのピンどめは、オフモードの雰囲気でしたらなくても大丈夫です。\n・ヘッドフォンは外していただいても問題ございませんが、その場合はコードも併せて外していただけますと幸いです。\n\nそのほかのデザインや表現につきましては、ぴらみ様にお任せいたします。\n\n全体の宇宙モチーフのカラーリングにつきましては、宇宙らしい雰囲気が感じられれば十分ですので、色味や表現はぴらみ様にお任せいたします。\n\n■希望納品形式\n可能でしたらPSDデータでご納品いただけますと幸いです。\n\nまた、動画やサムネイルなどで使用しやすいよう、可能でしたら以下のように分けてご納品いただけますと大変嬉しいです。\n\n・完成イラスト（キャラクター＋背景）\n・キャラクターのみ（背景透過）\n・マスコットのみ（背景透過）\n・背景のみ(ある場合)\n\n■使用用途\n・YouTubeのサムネイル\n・YouTube動画\n・Xでの活動・告知\n・個人的なネットプリントやステッカーなどのグッズ\n\nに使用させていただく予定です。\n※現在チャンネルは収益化しておりませんが、今後収益化を目指しております。\n\n使用の際は、ぴらみ様のお名前・XアカウントをYouTube概要欄またはXの投稿文へクレジット表記させていただきます。\n\n■構図\nYouTubeサムネイルで使用予定のため、お顔が見えやすい構図ですと嬉しいです。\n\nまた、頭頂部や髪の毛の先端、左右が見切れないよう、少し余白を持たせて描いていただけますと大変助かります。\n\n■参考資料\nキャラクター資料や設定資料をGoogle Driveにまとめておりますので、ご参考いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/10zRQ4BeAvj54xFiUoIsGSDTM6EiLqezF?usp=sharing\n\nお忙しいところ恐れ入りますが、ご検討いただけますと幸いです。\n\n何卒よろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/10zRQ4BeAvj54xFiUoIsGSDTM6EiLqezF?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2654211, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "im（いむ）🍠🐧", "screen_name": "im_imopen", "avatar_url": "https://pbs.twimg.com/profile_images/1858682900713271300/r10jST9f.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1858431089431416832/1731984725/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 40, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 3263354, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ユ３", "screen_name": "shiromachi94", "avatar_url": "https://pbs.twimg.com/profile_images/1774259530576363520/2ZVoCjBG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1774031676492177408/1711851433/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_mas