で、その他構図などは描きたいものでお任せします\n\n・案1\n犬になりきりながら気持ちよくなっているイメージ\n\n・案2\nアナルセックスで、おしりでとても気持ちよくなっているイメージ\n\n上記のような内容で喘ぎ声、セリフがあると嬉しいです\n可能であれば、絶頂・事後などの差分があると嬉しいです\n\nご検討をお願いします\n\nhttps://drive.google.com/drive/folders/1gXZVDfcsl66QZ8VxPLKFXERqQXKioNsJ", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 4347, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ダブツイ🔞", "screen_name": "amWT2nd", "avatar_url": "https://pbs.twimg.com/profile_images/1611149115223863296/PbfhIgUF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/894397291481636864/1771469697/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 48}, {"id": 6872, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ミヤスリサ❄️", "screen_name": "Risaly_", "avatar_url": "https://pbs.twimg.com/profile_images/1817512578664583169/LQwQEKHY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/113008360/1704185592/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 234281, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "人間クズ", "screen_name": "ningenkuzunokai", "avatar_url": "https://pbs.twimg.com/profile_images/1206566457112317952/gR5EB9h8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1206389050124333061/1576506571/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": 