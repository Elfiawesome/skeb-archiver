に台詞もイラストの上に書いて頂けるなら「あー」\n\n・起きたばかりの猫のような、気怠そうな表情「昨日暴れすぎちゃったかな、身体イテー」とでも思っている感じ。\n行ったこととは犯罪行為でありそれをやらかしておきながら文句を言っているような図々しさ、ふてぶてしさを表現してほしい。\n\n※前回と同じように台詞もイラストの上に書いて頂けるなら「イテー」\n\nよろしくお願いします。\n\nhttps://www.pixiv.net/novel/show.php?id=24169732#1", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@heikyoukei/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3486874, "client_id": 490225, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8eeefad5/uploads/origins/87127a6b-5931-4e29-b39c-6a955493665f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6c8e06ef95b7e65234efa6892cd5607", "srcset": "https://si.imgix.net/8eeefad5/uploads/origins/87127a6b-5931-4e29-b39c-6a955493665f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6c8e06ef95b7e65234efa6892cd5607, https://si.imgix.net/8eeefad5/uploads/origins/87127a6b-5931-4e29-b39c-6a955493665f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff154d03cafacc01e8ab3dc06e25e8da 2x, https://si.imgix.net/8eeefad5/uploads/origins/87127a6b-5931-4e29-b39c-6a955493665f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f109d118f7d54b8226eba0ca0e46d22 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8eeefad5/uploads/origins/87127a6b-5931-4e29-b39c-6a955493665f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a88fdf082d2adb1b2acba31b22d4dcca", "srcset": "https://si.imgix.net/8eeefad5/uploads/origins/87127a6b-5931-4e29-b39c-6a955493665f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a88fdf082d2adb1b2acba31b22d4dcca, https://si.imgix.net/8eeefad5/uploads/origins/87127a6b-5931-4e29-b39c-6a955493665f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=2