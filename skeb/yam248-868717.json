-4d01-af9f-c611eef49b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcaeea81f24b3a1cec0c5603c0e62c73", "srcset": "https://si.imgix.net/8bc72e3d/uploads/origins/69db56b2-d720-4d01-af9f-c611eef49b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcaeea81f24b3a1cec0c5603c0e62c73, https://si.imgix.net/8bc72e3d/uploads/origins/69db56b2-d720-4d01-af9f-c611eef49b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a13ad040ac0ca70de45c57ac5028e571 2x, https://si.imgix.net/8bc72e3d/uploads/origins/69db56b2-d720-4d01-af9f-c611eef49b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c7e34c57939d4ec6e21570e02290cde 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8bc72e3d/uploads/origins/69db56b2-d720-4d01-af9f-c611eef49b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f87e62901d38533f17a0a9526df53e0a", "srcset": "https://si.imgix.net/8bc72e3d/uploads/origins/69db56b2-d720-4d01-af9f-c611eef49b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f87e62901d38533f17a0a9526df53e0a, https://si.imgix.net/8bc72e3d/uploads/origins/69db56b2-d720-4d01-af9f-c611eef49b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8299220624344e04a57788b4c66311f9 2x, https://si.imgix.net/8bc72e3d/uploads/origins/69db56b2-d720-4d01-af9f-c611eef49b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8b3a776ce65085408df54d797ee7c7cd 3x"}, "body": "はじめまして。\nこの度私の相方に向けた魅力的なイラストを書いて頂きたくリクエストを送らせて頂きました。\n\n私と相方はjubeatという音楽ゲームで仲良くなりました。\n相方は山本章史様がイラストを手掛けているEverybody’s Richという楽曲がとても大好きでその楽曲を極め、周りからも独特な譜面から形成された独特な押し方により色んな方に見てもらうきっかけとなっていました。\n印象に残る楽曲に、とても相性が良く魅力的なマンホール男のイラストが素晴らしく、依頼を送らせていただこうというきっかけになりました。\n\n今回描いていただきたいのは私の相方です。\n名前　もい(M.O.Y)\n特徴、萌え袖、メガネ、焦げ茶髪、音楽ゲーム(jubeat)が上手\n複数のイラストなどの資料等を添付させていただいたのでよろしければご確認お願いします。\nシチュエーション等設定なのですが、もしよろしければEverybody’s Richを多少オマージュした作品だと嬉しいなと感じます(本当はマンホールを頭に被せたかったりはするのですが、権利上難しそうであれば都市感や雨、マンホールのある道路など大まかな間接的表現だけでもあるととても嬉しく感じます)\n\n私はまだまだリッチことEverybody’s Richは全然上手に出来ないのですが素敵な楽曲なのでこれからも相方と一緒にたくさん遊ばせていただけたらと思っています。\nこれからも山本様の活動を応援しています。\n\nhttps://ci-en.net/creator/23700/article/1666075", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yam248/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 373158, "client_id": 832836, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70cb43cc/uploads/origins/20a96272-399d-41bd-819e-e42a7a140917?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27092177f9134a4d9eb5ad481bd203ae", "srcset": "https://si.imgix.net/70cb43cc/uploads/origins/20a96272-399d-41bd-819e-e42a7a140917?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27092177f9134a4d9eb5ad481bd203ae, https://si.imgix.net/70cb43cc/uploads/origins/20a96272-399d-41bd-819e-e42a7a140917?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10b26fa9b1b0b5e30614ef2694faa557 2x, https://si.imgix.net/70cb43cc/uploads/origins/20a96272-399d-41bd-819e-e42a7a140917?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74ea913be99cc9c939c4ba48c227e32b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70cb43cc/uploads/origins/20a96272-399d-41bd-819e-e42a7a140917?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3e2f7c49e91dffff5cb81c3e0473a50", "srcset": "https://si.imgix.net/70cb43cc/uploads/origins/20a96272-399d-41bd-819e-e42a7a140917?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3e2f7c49e91dffff5cb81c3e0473a50, https://si.imgix.net/70cb43cc/uploads/origins/20a96272-399d-41bd-819e-e42a7a140917?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9fc227f38f643deef696af576484aa6b 2x, https://si.imgix.net/70cb43cc/uploads/origins/20a96272-399d-41bd-819e-e42a7a140917?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0982a4e31600fe8c28b20eef6bfe9108 3x"}, "body": "初めまして、さわらと申します。小学生の頃にデュエルマスターズで拝見して以来、ずっとファンです。\n先生のイラストはどれも好きです。特に『エレメンタル・トラップ』『サイバー・ブレイン』『コッコ・ルピア』のような格好いい世界観が好きです。『翔天鎧冑ビトッチ』や『ストマック・ガーデン』で捕食されているクリーチャーのような、表情豊かなキャラクターも大好きです。\n\n山本先生がSkebで募集をされていたことを知り、とても嬉しいです！\nよろしければ、オリジナルキャラクター、「さわら犬」のイラストを描いていただけないでしょうか？\n\nさわら犬の服装について、いつも青シャツ短パンなのですが今回はそれは脱いで、火文明のようなかっこいい感じにしていただけると嬉しいです。また、表情豊かに大きなアクションをしているところが見たいです。\n\n長文を読んでくださり、ありがとうございました。\nご検討、どうぞよろしくお願いいたします。\n\nhttps://hiroga.notion.site/Sawaraken-1a90e91ac29780149fbffdf048bbf8b2", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yam248/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 373158, "client_id": 335029, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de8e8fea/uploads/origins/70f3c80e-72da-4525-8885-832f64eb729c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=174e28170115c5bc788bcaeaef0d3968", "srcset": "https://si.imgix.net/de8e8fea/uploads/origins/70f3c80e-72da-4525-8885-832f64eb729c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=174e28170115c5bc788bcaeaef0d3968, https://si.imgix.net/de8e8fea/uploads/origins/70f3c80e-72da-4525-8885-832f64eb729c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c460a52d2cc53d2a1b8246c0af0ee0d 2x, https://si.imgix.net/de8e8fea/uploads/origins/70f3c80e-72da-4525-8885-832f64eb729c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa87001f3551f4b6e400ccd866442495 3x"}, "duration": null, "nsfw": false, "hardcore": 