f-47f5-b25b-ce1c7b44da19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=993467fc6cfb56bb2172ee4f00124ff0, https://si.imgix.net/ae36dc24/uploads/origins/e2c53d79-c65f-47f5-b25b-ce1c7b44da19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad2994dcf3f6085ff1eeda679d39a5b6 2x, https://si.imgix.net/ae36dc24/uploads/origins/e2c53d79-c65f-47f5-b25b-ce1c7b44da19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c30d68e6a1733c88bd8cfaaf5dc6918b 3x"}, "body": "初めまして、花騎士垢の方でいつもイラスト鑑賞させて貰ってます。\nもしよろしければ以下ご検討ください。\n\n【作品】\nフラワーナイトガール\n【キャラクター】\nリンゴ\n【区分】\n全年齢\n【衣装】\n通常ver進化\n【シチュエーション】\n構図に指定はありません。お任せします。\n笑顔と、可能ならば照れ赤面顔を差分でお願いします。\n\n【その他】\n宛名部分表示非表示にできるようにお願いします。psd納品の場合はレイヤー分けでも問題ありません。\n上記指定している部分以外についてはお任せします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hatimitu_jonny/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2812564, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/252eb325/uploads/origins/34c48ea6-ed5b-4ea2-8ed7-2ae5f0f59dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13b2af4feb9229d43acef0a903ded452", "srcset": "https://si.imgix.net/252eb325/uploads/origins/34c48ea6-ed5b-4ea2-8ed7-2ae5f0f59dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13b2af4feb9229d43acef0a903ded452, https://si.imgix.net/252eb325/uploads/origins/34c48ea6-ed5b-4ea2-8ed7-2ae5f0f59dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ba439a6ddff5cc25839e3fb18b9b0b0 2x, https://si.imgix.net/252eb325/uploads/origins/34c48ea6-ed5b-4ea2-8ed7-2ae5f0f59dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c1e004c3a029fbc084ddf7718375a3b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/252eb325/uploads/origins/34c48ea6-ed5b-4ea2-8ed7-2ae5f0f59dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8356f8ab029c7f1819de85aba926c30", "srcset": "https://si.imgix.net/252eb325/uploads/origins/34c48ea6-ed5b-4ea2-8ed7-2ae5f0f59dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8356f8ab029c7f1819de85aba926c30, https://si.imgix.net/252eb325/uploads/origins/34c48ea6-ed5b-4ea2-8ed7-2ae5f0f59dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1be16321535dd4717dfde117cd03fbdc 2x, https://si.imgix.net/252eb325/uploads/origins/34c48ea6-ed5b-4ea2-8ed7-2ae5f0f59dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6c5da13765e479425a50ec48289732d2 3x"}, "body": "初めまして。\n\nオリジナルキャラで、昔の農家の18歳前後、\n黒髪女性の緊縛イラストをリクエストしたいです。\n髪型、顔だちはお任せします。\n\n恰好\n野良着、もんぺ、足袋履きで、\n胸をだしてM字開脚縛りされています。\n表情は縛られて、泣いている感じにしてほしいです。\n頭から爪先まで全身を描いてほしいです。\n\n服装\nもんぺはへその下辺りで紐を結ぶ袴式で長さはくるぶしまでで、色、模様は濃い紫系の縞、\n足袋はくるぶしの上までの長さ、色は赤、足袋底は白にしてほしいです。\nできれば、もんぺと足袋の間から足の地肌が少し見えるようにしてほしいです。\nもんぺイメージ\nhttps://www.dropbox.com/s/27dregu6fv4xgh3/ms.jpg?dl=0\n\n差分で、\n股間部分を破られ、陰部に極太ディルドが挿入され\n表情も苦しそうに涙を流して絶叫している状態もお願いします。\n\nつたない説明で恐縮ですが、説明不足な点、ポーズ、構図など\nアレンジしていただいて構いませんが、\n必ず、もんぺが破れていない状態と、破れた状態の2種を描いていただきたいです。\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/s/5fqcitlkuag4liu/smm.png?dl=0", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@hatuka_sab/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3149874, "client_id": 2812564, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd54d310/uploads/origins/e82b365a-5678-4472-8424-fce2ab5d411a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09167e3eb9aa945f5283b17938f7918b", "srcset": "https://si.imgix.net/cd54d310/uploads/origins/e8