fit=crop&crop=top&w=200&h=200&blur=200&s=4101b8dcb8c46d79080d368a95ab3c95", "src_set": ""}, "body": "こんにちは、ご連絡ありがとうございます！アヌーラはとてもいじわるで、他人を慌てさせるのが大好きなんだ！\n\nhttps://drive.google.com/file/d/1QW8xWuHCBM6SmIfrjK7mzzjw-dcNg9y3/view?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yellowtail/works/416", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1022090, "client_id": 3651744, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d875f33/uploads/origins/1ec01860-f8a7-4f58-b4bf-ea9df8fff53c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65e2ef28524597b9503f8ef0de4d56bf", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d875f33/uploads/origins/1ec01860-f8a7-4f58-b4bf-ea9df8fff53c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46d12b39aa46bb80d0c9d2116c434d13", "src_set": ""}, "body": "こんにちは、あなたの絵のメカアーマースタイルが好きです。ジーン・\"ジェット\"・フェイマスと彼女のメカのポーズを、『エンドレスワルツ』のウイングガンダムのスタイルで、翼も含めて描いてくれないかな。メカの上に彼女の顔だけ透けていても構いません。ありがとうございました。\n\nジャン・\"ジェッツ\"・フェイマス：https://x.com/jeanfaymas/status/1804751760592110038\n\nウイングガンダムEW：https://docs.google.com/drawings/d/16_-YQ3XyK8HSAAGrSyxIZ_Rfmxc1627IvjnIGmgT3Ac/edit?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yellowtail/works/415", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/86d776f5/uploads/origins/794a9015-3d07-43e7-8e65-6cd126ef7628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32526bc8db3a4cc717b807e52629e4d0", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1022090, "client_id": 348710, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yellowtail/works/414", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1022090, "client_id": 3127584, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe2121a1/uploads/origins/3b6abcd6-ceef-4034-a8ec-bbca9c0410fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d2d9df10e368f23ac237518ba6340c6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe2121a1/uploads/origins/3b6abcd6-ceef-4034-a8ec-bbca9c0410fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9182522787bfe1487c6f7bd53215ff3", "src_set": ""}, "body": "あなたのリクエストを受け入れます。私のOCをあなたのスタイルで描いてください。彼女は私立探偵です。アンドロイドのような外見で（たまに男に間違われる）、物腰が柔らかく引っ込み思案。趣味は本、パスタ、サッポロビール、銃器収集。(リボルバーがお気に入り）\n\n好きなように彼女を描いてください！この作品は私のBlueskyのページに掲載したいのですが、作者であるあなたのクレジットを適切に表示します。\n\n彼女のバラ色メガネとオーバーコートのペンローズトライアングルはどちらもアクセサリーなので、お望みであれば、どちらか、あるいは両方を取り去ってもかまいません！\n\nhttps://drive.google.com/drive/folders/1-8cqYzK4lvSPSz8015UYWI6bkYmO0t0T?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yellowtail/works/413", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1022090, "client_id": 3690639, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7de4576/uploads/origins/f13351fd-1fe6-46dc-a675-99f3aa432aad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b4b5e7de00c37ac5d0176fae3201ff5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7de4576/uploads/origins/f13351fd-1fe6-46dc-a675-99f3aa432aad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84ebecc88a74f50e336477f9acd04868", "src_set": ""}, "body": "こんにちは！アピールをありがとうございます！気に入っていただけて嬉しいです^_^ 私のキャラクター「夜」のイラストを依頼したいと思います。長文になるかもしれませんが、よろしくお願いします。\n\n夜」は夢と悪夢を食べる妖怪「獏」です。人間社会から遠く離れて暮らしていて、夢や悪夢を食べるためだけに近づいてくる。あまり笑わない。\n\nデザインの詳細\n1.彼には筋肉がある！そのディテールを覚えておいてください。彼はカタナも振り回していますが、描く必要はありません。\n2.彼はハイネックのノースリーブのシャツを着ている。彼の着物は夜空のようで、右袖は袴のズボンの後ろにたくし込まれている。着物の色は紫から紺に変わり、星のような白い輝きがある。また、白い靴下に下駄を履いている。\n3.ピアス、額の星、アイメイク、星形の瞳孔、タトゥーなど、細かいディテールがたくさんある。彼のタトゥーはとても複雑だが、桜をあしらった龍を期待しているだけなので、極端に細かいことを気にする必要はない。\n4.4.Toyhou.seのリンクに彼のアートをまとめたものを掲載した。\n\n構図の詳細：\nhttps://drive.google.com/drive/folders/17vlY9LSuD5rWGVJB6N0ogdZ-gqG5T7c0?usp=drive_link\nこのシーンと構図で彼を描いていただければと思いますが、角度は約30度傾けてください！また、環境は暖かく日差しの強いものにしてください。彼の左腕は宙に浮いていて、彼の目からの太陽光線を手で遮っているはずです。彼のような男性に似合うと思う植物や花を描いてください。\n\n長くなって申し訳ありません！できるだけ詳しくお伝えしたかったのです。クライアントとして検討していただき、ありがとうございました！\n\nhttps://toyhou.se/20333417.yoru", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yellowtail/works/412", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1022090, "client_id": 3371469, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c9612f0/uploads/origins/0b84f946-771c-4f57-bd21-08145d6fbdf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e243cc84f1defd97c341a59beeca1314", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c9612f0/uploads/origins/0b84f946-771c-4f57-bd21-08145d6fbdf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e646332571cf0d63d6583401518e2bd", "src_set": ""}, "body": "アピールありがとうございます。\nオリジナルキャラクターに関して描いていただけるということでリクエストを送らせていただきました。\nアピールにて巫女服を描いていただけるということで描いていただけますでしょうか。\nまた、SNSや配信で使用する可能性があります。\nよろしくお願いします。\n\nhttps://x.com/nariware/status/1791733770951045557", "nc": 1