質である必要はありません）。\n\n\n話の筋が通らないところがあれば、自由にイメージや自分の考えで埋めていけばいいのです。\nもし人物の服装の造形などについて不確かなところがありましたら、自由に書き直して創作してください。\n\n可能でしたら宛名とサイン、漫画のセリフなど文章の部分はpsdレイヤーでon/offできると嬉しいです。\n日本人ではないので、失礼なことを言ったら申し訳ありません。\nもし、お気に召さない場合は、キャンセルしても構いませんです。\n\nhttps://drive.google.com/drive/folders/1QM9IT0815RRHRYoul3i3XAnW0NKrh7BU?usp=sharing", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_i9ra/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dd9fe846/uploads/origins/5cc37c2b-d881-4855-a22e-a0e24a1633e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41ec16e442ae6a723e45e92176f17d52", "srcset": "https://si.imgix.net/dd9fe846/uploads/origins/5cc37c2b-d881-4855-a22e-a0e24a1633e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41ec16e442ae6a723e45e92176f17d52, https://si.imgix.net/dd9fe846/uploads/origins/5cc37c2b-d881-4855-a22e-a0e24a1633e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8edc969d3ab224a51db74a13705b2115 2x, https://si.imgix.net/dd9fe846/uploads/origins/5cc37c2b-d881-4855-a22e-a0e24a1633e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=608e0a1c0faf461958bda01ccb67b101 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1799750, "client_id": 873586, "nc": 145}, {"path": "/@k_i9ra/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1799750, "client_id": 1500785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce13c0bf/upl