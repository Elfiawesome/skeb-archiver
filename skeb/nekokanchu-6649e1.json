23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22d6ed2c738f500f7b40875931e1765f, https://si.imgix.net/6f37ddd9/uploads/origins/aee9171e-23d2-47b5-a36f-0173fb4a8c16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7e0b977774ea49097beac53ce19b4fb5 2x, https://si.imgix.net/6f37ddd9/uploads/origins/aee9171e-23d2-47b5-a36f-0173fb4a8c16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=17807d03fc5e73132d14cb1d7d4b84e3 3x"}, "body": "先生、初めまして！\n先生の作品が大好きなので、ぜひイラストを描いていただきたいです。\n\n設定はコウモリウサギ🐰\n性格はドジでキュート\n犬歯は片方だけ\n左右の耳にピアス\n眉ピアスあり\nベルトは浮いているウサギ\n参考画像は少し上を向いたアングルなので生え際が高く見えますが、実際にはそこまで高く描かなくても大丈夫です\n\n可能であれば、構図やポーズは先生にお任せしたいです！\n\n個人コレクション用です\n\n「To阿紫」と書くのが難しい場合は、「To奈拉」または「Nyar」に変更してください\n\nhttps://drive.google.com/drive/folders/1y2FwhdIA9OBGu5im-_kk2gLs9FQsiaY-", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekokanchu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3957185, "client_id": 2188555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b904364/uploads/origins/0da15aab-e98a-4193-bc92-25da3e3070b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e44023f591d833490b52c29f460c3e1", "srcset": "https://si.imgix.net/8b904364/uploads/origins/0da15aab-e98a-4193-bc92-25da3e3070b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e44023f591d833490b52c29f460c3e1, https://si.imgix.net/8b904364/uploads/origins/0da15aab-e98a-4193-bc92-25da3e3070b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b03cc0434cbf9c7cf91f03efe2c73de 2x, https://si.imgix.net/8b904364/uploads/origins/0da15aab-e98a-4193-bc92-25da3e3070b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10043ec5f0da3a3f41966a569cdcb4bd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b904364/uploads/origins/0da15aab-e98a-4193-bc92-25da3e3070b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04c479fc6e5305ca748d78fb18628c7e", "srcset": "https://si.imgix.net/8b904364/uploads/origins/0da15aab-e98a-4193-bc92-25da3e3070b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04c479fc6e5305ca748d78fb18628c7e, https://si.imgix.net/8b904364/uploads/origins/0da15aab-e98a-4193-bc92-25da3e3070b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b1a858b6dbca2b669cf57a38d3392caa 2x, https://si.imgix.net/8b904364/uploads/origins/0da15aab-e98a-4193-bc92-25da3e3070b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e121aeb1f46275aff1b9461c3e0909eb 3x"}, "body": "はじめまして\n個人Vtuberの花依なごみと申します\n\n新着より拝見したイラストがとても可愛らしくて素敵でした！\nぜひ当方も描いていただきたくリクエストお送りいたします\n\n■使用用途\n・収益化済みチャンネルのサムネイル\n・各種SNS(プロモーション)\n・ネットプリント、サンクスカード\n\n使用する可能性があるものを全て記載しております\nもし使用不可のものがございましたら、ご再送いただけますと幸いです\n\n■イラストの内容\n衣装、髪型、構図すべてお任せでお願い出来たらと思っております\n(資料にある既存の衣装や髪型以外でも問題ございません)\n\n主に配信時のサムネイルで使用したいと考えているため、\n頭の先や髪の毛の横が切れないように描いていただけると嬉しいです\n\n■納品(ファイル形式)\n人物だけでも使用できるようにレイヤー分けされたPSDデータ、\nまたは人物のみの透過データを一緒に納品していただけますと幸いです\n\n■資料\nhttps://x.com/nago38nayori/status/1850162722933227554\n(当方ツイッターの固定に飛びます)\n\n内容や金額等ご対応が難しい場合は、\nキャンセルまたはご再送いただけますと幸いです！\n\n\nご検討の程よろしくお願いいたします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekokanchu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3957185, "client_id": 1541021, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fadc5a4b/uploads/origins/d7b19c49-e1c7-44f7-baa9-cd699d04a2b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41ffd38010aa2ebe2a31a473953a9f96", "srcset": "http