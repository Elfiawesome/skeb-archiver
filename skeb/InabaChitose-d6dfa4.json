f-4332-8102-240d40fd1365?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c221a2431691ed76865e108ee9c3df0, https://si.imgix.net/c47dac29/uploads/origins/11d24332-56af-4332-8102-240d40fd1365?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2b503e382a5ce3a1e2fba1ac3452a31 2x, https://si.imgix.net/c47dac29/uploads/origins/11d24332-56af-4332-8102-240d40fd1365?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d1f9bb98cb6c791320d6aa9572b82ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c47dac29/uploads/origins/11d24332-56af-4332-8102-240d40fd1365?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5bb5ef06e6a9bd2f392ad3b8408452c", "srcset": "https://si.imgix.net/c47dac29/uploads/origins/11d24332-56af-4332-8102-240d40fd1365?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5bb5ef06e6a9bd2f392ad3b8408452c, https://si.imgix.net/c47dac29/uploads/origins/11d24332-56af-4332-8102-240d40fd1365?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e8890d8f8a338de3a2c4f6de91ec06d5 2x, https://si.imgix.net/c47dac29/uploads/origins/11d24332-56af-4332-8102-240d40fd1365?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=68dc8c09ae44f68b2d30bb23ab8d2f36 3x"}, "body": "はじめまして、新着クリエイター欄から失礼します。\n\n1064様が描かれるかわいい女の子や、優しく鮮やかな色彩の絵を拝見し、もしご縁がありましたら私のオリジナルキャラクターを描いていただきたく思い、この度リクエストを送らせていただきました。\n\n\n【依頼内容】\nオリジナル(一次創作)キャラクターのイラストをお願いしたいです。\n\n・キャラクターについて\n預言者(女の子)\n星空を映したような髪を持つ、不思議な雰囲気を持つ少女……に擬態している不老不死の女性。\n非常に大人しい性格をしている。引っ込み思案と言うべきか自分の思いを上手く伝える事ができず、積極性には欠ける。\n占星術のような魔法を用いて運命を占えることからか預言者と名乗り、とある男性の前に現れたが問題に直接関与するのはタブーなのか、宙に浮きながら彼の動向を見守りつつ助言を与え最低限の力を貸す。場合によっては男性に守られることもある。\n儚くもどこかに威厳を隠しもつ少女。\n\nシン(男性)\n前述した預言者に導かれ時に預言者を守る、黒髪赤目の男性。\n預言者に一目惚れしており、以降適度な距離は保ちつつ、積極的かつ紳士的にアタックを続けている。\n\n男性の設定も書いてはおりますが、金額に見合わない場合女の子のみ描いていただけたらと思います。\n装飾等は省略、改変してもらって構いません。 (詳しい資料はドライブ内にあります。参考程度に書いたものなので、全てを反映させる必要はありません。)\nイラストを描く際の一助となれば幸いです。\n\n【構図】\n1064様が描きたい、描きやすい構図で描いていただけたら、と思います。 (もし背景などがある構図の場合は月、星、星空が映っていると嬉しいですが、なくても結構です🙇)\n\n【使用用途】\nSNSアイコン、ヘッダーへの使用、個人での鑑賞を想定しております。\n※SNSに載せる場合、1064様のお名前は明記致します。\n\n\nこちらの依頼内容に問題が無ければ、1064様のスケジュールなどにご負担のない範囲でご検討いただけますと幸いです。\n(依頼に問題点などがある場合、依頼内容を見て描くのが難しいと判断された場合はキャンセルして頂けると嬉しいです。)\n\n\n何卒、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1msd9heeD6L3flGxQOcnJ8RNurmoEhVJy", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zumizu1254/works/77", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1854683, "client_id": 1466519, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/82c6e32a/uploads/origins/ddd321cc-1896-4cce-9d1f-e5153e473e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=960756759da18b32140841aa363d9bb4", "srcset": "https://si.imgix.net/82c6e32a/uploads/origins/ddd321cc-1896-4cce-9d1f-e5153e473e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=960756759da18b32140841aa363d9bb4, https://si.imgix.net/82c6e32a/uploads/origins/ddd321cc-1896-4cce-9d1f-e5153e473e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d600a24c36eeb245abd054f894bd88c6 2x, https://si.imgix.net/82c6e32a/uploads/origins/ddd321cc-1896-4cce-9d1f-e5153e473e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5698f00196e84023338c34d4d458baff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82c6e32a/uploads/origins/ddd321cc-1896-4cce-9d1f-e5153e473e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=921d0aee211888018308c8573d8c8119", "srcset": "https://si.imgix.net/82c6e32a/uploads/origins/ddd321cc-1896-4cce-9d1f-e5153e473e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=921d0aee211888018308c8573d8c8119, https://si.imgix.net/82c6e32a/uploads/origins/ddd321cc-1896-4cce-9d1f-e5153e473e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=45325b3ddb20c12a2f9823da2aac5823 2x, https://si.imgix.net/82c6e32a/uploads/origins/ddd321cc-1896-4cce-9d1f-e5153e473e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b76ca5e76d3bd630c36e53f383098d3d 3x"}, "body": "はじめまして。\n\nみずさんが描かれる透明感のある綺麗なイラスト、長い髪の魅力的なキャラクターたちが大好きで、みずさんの描く私のオリジナルキャラクターを見てみたい！と強く思い、この度リクエストを送らせていただきました。\n\n\n【依頼内容】\nオリジナル(一次創作)キャラクターのイラストをお願いしたいです。\n\n黒色で長い髪の男性。\n腕の立つ魔導学者だが、過去の不幸が原因で極端に自分に自信を持てておらず、自らを嘲るような言動、思考回路に至ることが多い。\nその卑屈っぽい一面を除けば、良識的でとても優秀な人物。\n\nGoogleドライブ内に細かいキャラクター設定、資料をまとめております。\n装飾等は省略、改変してもらっても構いません。(設定も参考程度に書いたものなので、全てを反映させる必要はありません。)\nイラストを描く際の助けになれば幸いです。\n\n\n【構図】\nみずさんが描きたい、描きやすい構図で描いていただけたら、と思います。\n(もし背景などがある構図の場合は星、星空が映っていると嬉しいですが、なくても結構です🙇)\n\n\n【使用用途】\nSNSアイコン、ヘッダーへの使用、個人での鑑賞を想定しております。\n問題等ありましたら別レイヤーにその旨を記載して頂けると嬉しいです。\n※SNSに載せる場合、みずさんのお名前は明記致します。\n\n\n\nskebの依頼が初めての為、読みにくい箇所や不備等ありましたら申し訳ありません。\nこちらの依頼内容に問題が無ければ、みずさんのスケジュールなどにご負担のない範囲でご検討いただけますと幸いです。\n(諦めきれず、何度も同じリクエストを送信してしまっており大変申し訳ございません。もしも依頼に問題点などがある場合、そもそも依頼内容を見て描くのが難しいと判断された場合はキャンセルして頂けると嬉しいです。)\n\n\n何卒、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1YGj0pFnWFLMb8qDZJhXmQ1WwIt2N7Gft?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1411946, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぐゐ.", "screen_name": "guiv_v", "avatar_url": "https://pbs.twimg.com/profile_images/1879290140696416256/KfstPLb4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1439829412422119424/1745347765/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "delete