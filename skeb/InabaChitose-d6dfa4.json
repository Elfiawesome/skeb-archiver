dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08a72b35b9c8f41e175afd59248a5f37 3x"}, "body": "ファンタジー系の創作や絵をよく描いている印象のあるあなたが描く日常系のキャラを見てみたいと思い、個人の観賞用にとリクエストさせていただきました！\n資料はこちらです↓\nhttps://drive.google.com/drive/folders/1gyhTLzBTEYeSIOdqqji4EqqVsYy8M8dC\n\n容姿については大まかな特徴(眼鏡や髪色、身長差等)を捉えてもらえば大丈夫です！\n構図や画像サイズ等は全て自由にしてもらって構いません！\n\n〈2人の関係性について〉\n互いにイタズラっぽい事をする仲でありながら、友情が深く距離感の近い男子高校生2人組です。俗にいうブロマンスという関係にあります。\n陽翔はいつも笑顔で明るい性格で友達も多く周りから好かれていますが、料理が下手だったり成績はあまり良くない一面もあります。玲司は少し表情が硬く暗い性格で1人でいることが多いですが、冗談をついたり悪ノリしたりする一面もあります。\n\n近頃気温差や気圧がえげつない落差ですが気をつけながら頑張ってください！応援してます！", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@InabaChitose/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 1466519, "client_id": 2717557, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/50422034/uploads/outputs/83a923ed-faef-437f-b759-63bd1285d8d4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=27329899e184d22c9fbe64010b86b482", "srcset": "https://si.imgix.net/50422034/uploads/outputs/83a923ed-faef-437f-b759-63bd1285d8d4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=27329899e184d22c9fbe64010b86b482, https://si.imgix.net/50422034/uploads/outputs/83a923ed-faef-437f-b759-63bd1285d8d4?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=30eb5fe2d5884ad74536ca0562ff9335 2x, https://si.imgix.net/50422034/uploads/outputs/83a923ed-faef-437f-b759-63bd1285d8d4?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=64b262ab38ebfe49294917ef65647c24 3x"}, "duration": 33, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/50422034/uploads/outputs/83a923ed-faef-437f-b759-63bd1285d8d4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=1c11fa29345b72670559a39b470da06c", "srcset": "https://si.imgix.net/50422034/uploads/outputs/83a923ed-faef-437f-b759-63bd1285d8d4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=1c11fa29345b72670559a39b470da06c, https://si.imgix.net/50422034/uploads/outputs/83a923ed-faef-437f-b759-63bd1285d8d4?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=15194b6f653182251468e140c35294cf 2x, https://si.imgix.net/50422034/uploads/outputs/83a923ed-faef-437f-b759-63bd1285d8d4?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e690fcc68f49cdac45de24845a07c5a 3x"}, "body": "お世話になってます、やぐるです！\n影と光を巧みに使いカッコよさと綺麗さを引き立たせる演出力と技術力に長けている稲葉さんに是非とも自キャラを描いていただきたいと思い、個人の観賞用にとリクエストさせていただきました！\n\n資料はこちらです↓\nhttps://drive.google.com/drive/folders/1-TGA0gQ4BPBZGZ8DcYIIToYpmXm-eSyw\n\n構図や雰囲気等は全てお任せします！\n\n〈キャラの詳細〉\nクールで自分の感情をあまり表に見せようとせず仲間も作らない主義な性格ですが人に対する優しさや想いは人一倍厚く、心の中で誰よりも喜び誰よりも悲しむことができる優しい人です。\n\n昔は小規模な村に住んでおり、貧乏ながらも懸命に育ててくれた両親と村の皆に恩返しをするために村を守る槍師になりましたが、よそからやってきた1人の人物に村を一晩のうちに焼かれてしまい村にいた雪花以外の人間は息絶えてしまいました。その犯人に復讐をするため今は様々な地域を歩いています。\n\n頭部の花の髪飾りは妹の遺品です。\n頭部や左腕に付着している黒い物は生まれつきあるものではなく、雪花の復讐心と妹からの犯人に対する強い苦しさや憎悪から生まれた物です。これは復讐を果たした時、又は雪花が永続的に行動不可になった際に砕け散ります。\n\n\n年度初めは何かと忙しい時期で色々苦労もあるとは思いますが、健康祈願のためにここで謎解きを添えておきます\n創作者とかけまして郵便物と解きます\nその心は、どちらも発想(発送)が大事でしょう", "nc": 0, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@InabaChitose/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1466519, "client_id": 1022702, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e341161/uploads/origins/ee3920d1-812f-4c4d-a202-d1b103ba2212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=506efa6c05fa35de35572bc31ec91293", "srcset": "https://si.imgix.net/9e341161/uploads/origins/ee3920d1-812f-4c4d-a202-d1b103ba2212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=506efa6c05fa35de35572bc31ec91293, https://si.imgix.net/9e341161/uploads/orig