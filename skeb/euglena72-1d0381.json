4551?s=20)\n\n先生が描かれたその画像のように、カルカノが裸の状態で膝をつき、フェラチオを始める直前の雰囲気で描いていただけますか？\n舌を出した状態で、両手を合わせて手のひらを上に向け、口元を支えているような感じでお願いします！さらに、左手の薬指に誓いの指輪を描いていただけると幸いです！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@euglena72/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2cb9aaad/uploads/origins/ed7ca1d3-05d4-4f43-97a9-dc2a3a965511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1859747b12d5fd7fa308d15647d691ea", "srcset": "https://si.imgix.net/2cb9aaad/uploads/origins/ed7ca1d3-05d4-4f43-97a9-dc2a3a965511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1859747b12d5fd7fa308d15647d691ea, https://si.imgix.net/2cb9aaad/uploads/origins/ed7ca1d3-05d4-4f43-97a9-dc2a3a965511?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ec6525502587bd99f95ff19466e0266 2x, https://si.imgix.net/2cb9aaad/uploads/origins/ed7ca1d3-05d4-4f43-97a9-dc2a3a965511?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4efdce424e2efc0d6845333223b907d0 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 456085, "client_id": 3539653, "nc": 49}, {"path": "/@euglena72/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 456085, "client_id": 3539653, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15bbb4d6/uploads/origins/00218e32-57af-428f-abf1-137376502597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee34eb1b470602ccea4197c4dab86f8d", "srcset