08666f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=112a330750910d209f7e38294d4ce92c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/18dcf14c/uploads/origins/e0ce228d-1c8b-4a25-b876-b8ea9e08666f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cad0dcdaa3d7f2c411c01c97ed5d56b0", "srcset": "https://si.imgix.net/18dcf14c/uploads/origins/e0ce228d-1c8b-4a25-b876-b8ea9e08666f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cad0dcdaa3d7f2c411c01c97ed5d56b0, https://si.imgix.net/18dcf14c/uploads/origins/e0ce228d-1c8b-4a25-b876-b8ea9e08666f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aee5c6e8835d7534ddba874c7f2f95a0 2x, https://si.imgix.net/18dcf14c/uploads/origins/e0ce228d-1c8b-4a25-b876-b8ea9e08666f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bd259f65012345d2d78efd1a286e99d4 3x"}, "body": "初めまして、香港の個人Vtuberをしています。\n如月兎苺と申します。\n\nそのた様の作品を拝見し、是非イラストをご依頼したいと思い、ご連絡させて頂きました。\n\n——————\n【依頼内容】\n私のキャラクターを描いていただけませんか？ デビュー4周年をお祝いするイラストをお願いしたいのです。\n\nできれば、白いドレスを着て（キャラが着そうな夏っぽい服をデザインして頂ければ幸いです）、ひまわりを片手に微笑む、夏いっぱいの私を描いてください！\n\nもちろん、背景はビーチでも、ひまわり畑でも、その他の適当な背景でも構わない！\nポーズ、表情などお好きなようにお任せします。可能であれば、表情差分があると嬉しいです！\n\n【キャラクター】\nhttps://drive.google.com/drive/folders/170Zw0m1E3OrSAUIHcxr0WnJ6HNTttCCY?usp=sharing\n\n身長は165cmで、10cmのうさ耳を含んでいます。彼女は笑顔で元気で明るい女の子で、バニーアストロノートです。宇宙、ひまわりと食べること、ゲームが大好きです。年齢は18歳。右側に鋭い牙、目の下にほくろがあり、小さなうさぎの歯がある。\n\n※服は自由です。自由に描いてください。髪型変えても大丈夫です。\n\n【使用目的】\n・Twitter(X)等のSNSへの掲載、YouTube等のサムネイルへの利用\n・個人用な印刷などの使用\n（ポストカードや壁紙など無料で配るグッズ化にも使用させていただきたいです！もちろんポストカードの上には先生のお名前も記載致します！）\n\n※グッズ化などの商用利用\n（商用利用が不可、条件がある場合は、別レイヤーにて表記をお願いします！値段調整も全然大丈夫です！）\n\n【納品形式】\nもし可能でしたら、納品の際に背景、人物、文字などのレイヤー分けをしたPSDファイルで納品して頂けると嬉しいです。希望解像度：300~ dpi でお願いします。\n\n※尚、納品は4/30、もし事前で完成しても、或いはそれに近い日にちで納品してくれれば幸いです。\n——————\n\n以上です。\n金額が足りないなどの不備がありましたら、気兼ねなくキャンセルや再送要請などして頂ければ幸いです。\n\nお忙しい中大変恐縮ですが、ご検討ほどよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/170Zw0m1E3OrSAUIHcxr0WnJ6HNTttCCY?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sonota1616/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2697610, "client_id": 2627317, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c577e9f7/uploads/origins/9136093e-ecaf-4f21-bb8c-9ee48bc915fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bb5e9d7a11ffd0dc9b3d9e7cad3185d", "srcset": "https://si.imgix.net/c577e9f7/uploads/origins/9136093e-ecaf-4f21-bb8c-9ee48bc915fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bb5e9d7a11ffd0dc9b3d9e7cad3185d, https://si.imgix.net/c577e9f7/uploads/origins/9136093e-ecaf-4f21-bb8c-9ee48bc915fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e22d8a33937aa64efe242e28e88fc8f 2x, https://si.imgix.net/c577e9f7/uploads/origins/9136093e-ecaf-4f21-bb8c-9ee48bc915fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=290f05b44677a736f25864125f3be5a6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c577e9f7/uploads/origins/9136093e-ecaf-4f21-bb8c-9ee48bc915fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fca1e2bdf55d2e551ea1542067970512", "srcset": "https://si.imgix.net/c577e9f7/uploads/origins/9136093e-ecaf-4f21-bb8c-9ee48bc915fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fca1e2bdf55d2e551ea1542067970512, https://si.imgix.net/c577e9f7/uploads/origins/9136093e-ecaf-4f21-bb8c-9ee48bc915fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b2d53918c76a6d1f7fd5a43d37afca8f 2x, https://si.imgix.net/c577e9f7/uploads/origins/9136093e-ecaf-4f21-bb8c-9ee48bc915fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d7ce5fd7cc0c578ea7fbaa576ce27b10 3x"}, "body": "こんにちは、あなたの絵が大好きです！私のVtuberに、複数の猫と一緒に寝そべったポーズをさせたいと思っています。猫たちの毛色は好きな色にしてください。また、パジャマ姿も希望しています！\nモデルのリファレンスはこちら： (https://drive.google.com/file/d/1gry4hMSncYaLVQAHeZtt_tFOTMSq7qTk/view?usp=sharing)\nポーズの参考はこちら: (https://drive.google.com/file/d/1HNZKoBAauWMIYYRG7vvdHYP9FZN9CQzj/view?usp=sharing)\nありがとうございました！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sonota1616/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2697610, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/817fd479/uploads/origins/3fa3df10-9a12-4bce-a172-13e6bdb46f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b840983eb46d980c27348bcb7eeb12a", "srcset": "https://si.imgix.net/817fd479/uploads/origins/3fa3df10-9a12-4bce-a172-13e6bdb46f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b840983eb46d980c27348bcb7eeb12a, https://si.imgix.net/817fd479/uploads/origins/3fa3df10-9a12-4bce-a172-13e6bdb46f20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad58e63d73ba4a7b90f765788b5cfde4 2x, https://si.imgix.net/817fd479/uploads/origins/3fa3df10-9a12-4bce-a172-13e6bdb46f20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7febf9be7d99058a87d187c279f30261 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/817fd479/uploads/origins/3fa3df10-9a12-4bce-a172-13e6bdb46f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80b94aea4f885e5efac5eb0f7644aaa5", "srcset": "https://si.imgix.net/817fd479/uploads/origins/3fa3df10-9a12-4bce-a172-13e6bdb46f20?bg=%23fff&auto=format%2Ccompress&fm=