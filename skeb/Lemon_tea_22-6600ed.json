です\n・可能であればぜひ背景も描いていただけるとありがたいです。その場合、16:9横長で描いていただけると使用の際の幅が広がり嬉しいです。背景のみを配信背景として使用する場合も想定いただけると助かります。\n・もし余裕があれば、表情差分を描いていただけるとありがたいです。\n\n長文読んでくださりありがとうございます！どうぞよろしくお願いいたします。\n\nhttps://twitter.com/amahoshi_misora/status/1689214948700999683", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Lemon_tea_22/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2632517, "client_id": 1363821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3f124b1/uploads/origins/f49ae6e6-0089-4bb9-91ac-0b5e97f83bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=592b0ff3d0b4fad32d153fb871a43cd2", "srcset": "https://si.imgix.net/e3f124b1/uploads/origins/f49ae6e6-0089-4bb9-91ac-0b5e97f83bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=592b0ff3d0b4fad32d153fb871a43cd2, https://si.imgix.net/e3f124b1/uploads/origins/f49ae6e6-0089-4bb9-91ac-0b5e97f83bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b42d0be47690ee483ac8df4f9cb4a9bf 2x, https://si.imgix.net/e3f124b1/uploads/origins/f49ae6e6-0089-4bb9-91ac-0b5e97f83bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97573f4d32f5a5cd9392aab0a6417314 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3f124b1/uploads/origins/f49ae6e6-0089-4bb9-91ac-0b5e97f83bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=caa99a21679976a60b0de8a06a1be86f", "srcset": "https://si.imgix.net/e3f124b1/uploads/origins/f49ae6e6-0089-4bb9-91ac-0b5e97f83bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=caa99a21679976a60b0de8a06a1be86f, https://si.imgix.net/e3f124b1/uploads/origins/f49ae6e6-0089-4bb9-91ac-0b5e97f83bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=