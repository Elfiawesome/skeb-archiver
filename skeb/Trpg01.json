mbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 20116, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/04bcab0b/uploads/origins/5685128a-875d-4c0f-b362-cae5271f2c75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28f61aa537bfd4f73458c233eb4708ca", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04bcab0b/uploads/origins/5685128a-875d-4c0f-b362-cae5271f2c75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecf3f7157f374a7f7ad7d5d8a51a1386", "src_set": ""}, "body": "じぇろいちジョーさんの紲星あかりちゃんが好きです。\n\n以前に描かれていたタカハシとの関係も好きなので、タカハシとの危険日中出しセックスを描いてほしいです。\n\nシチュエーションとしてはタカハシが作ったご飯を食べた後にえっちな気分になってそのまま家でセックス。\nあかりちゃんは今日会ったらシちゃうかもと最初から思っていて、かわいくて少しえっちな下着を着ている。\n危険日で中出しされたらデキちゃうかもしれないけど、我慢できず自分から気持ちいいところに当てて途中で抜くなんて考えられない感じ。\n\nあかりちゃんの雰囲気は「きずなあかりのたちえ」の様なふわふわした感じも入れていただけると嬉しいです。\nふわふわした雰囲気で一見そういうこととは無縁そうなのに、好きな人の前でスイッチが入ったらあられもない姿で高ぶって、イッてあえいだり、エッチな言葉をたくさん叫んだりする感じでお願いします。\n\nカットインでもいいので中出しの子宮と膣内の断面図を入れてほしいです。\n\nこの様な雰囲気で形式は描きやすい形で描いていただければ大丈夫です！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 145685, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "はいてくりん", "screen_name": "haitekurin", "avatar_url": "https://pbs.twimg.com/profile_images/1491982109480988673/V8uZoo3Q.jpg", "header_url": "https://pbs.twimg.com/profile_banners/233320893/1758270329/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 161}, {"id": 334410, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "れふぃん", "screen_name": "Refia_25", "avatar_url": "https://pbs.twimg.com/profile_images/1967402950474809