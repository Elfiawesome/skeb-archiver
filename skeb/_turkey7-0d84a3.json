ploads/origins/c9656ec4-79fc-4a70-aa7d-7bfa4751b5ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e6caf228035b3b66b7741f8eef3a568 2x, https://si.imgix.net/b83752af/uploads/origins/c9656ec4-79fc-4a70-aa7d-7bfa4751b5ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1c37f908007123523ea226ccca6cef2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b83752af/uploads/origins/c9656ec4-79fc-4a70-aa7d-7bfa4751b5ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03f432295c1f091f9f454199b3563db7", "srcset": "https://si.imgix.net/b83752af/uploads/origins/c9656ec4-79fc-4a70-aa7d-7bfa4751b5ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03f432295c1f091f9f454199b3563db7, https://si.imgix.net/b83752af/uploads/origins/c9656ec4-79fc-4a70-aa7d-7bfa4751b5ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7dea9a7523b66227409dda60e04e0780 2x, https://si.imgix.net/b83752af/uploads/origins/c9656ec4-79fc-4a70-aa7d-7bfa4751b5ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b50c040ebdcb9892c983e7587753ee65 3x"}, "body": "初めまして。野良猫と申します。\n\n以前skebでおくら様が描かれたタロットカード風のイラスト（https://skeb.jp/@_turkey7/works/6）がとても素敵で私の応援しているVtuverの方で同じようなイラストを描いて頂きたいと思いリクエスト送ります。\n\n依頼背景：私の応援しているVtuverの鼓草ルチル様が誕生日を迎えるので、そのお祝いに何か贈り物をしたいと思いおくら様に依頼させて頂きます。\n\n詳細な内容\n登場人物：バーチャルYouTuberの鼓草ルチル様\n小さな村の錬金術師として活動されています。性格は優して明るく穏やかな方です。腰のポーチの試験管で戦ったり治療したりします。\n鼓草ルチル様立ち絵→https://twitter.com/rutile_tsuzumi/status/1438073583436058624\n\nテーマ：お祝い事なので明るく柔らかく穏やかな雰囲気のイラストをお願いします。\n上記のURLのおくら様のイラストがとても理想的です。\n\n表情：やわらかい笑顔、or微笑んでいる。\n\n服装：上記URL鼓草ルチル様の立ち絵の服装でお願いいたします。\n\nポーズ・背景・構図：お任せでお願い致します。可能であれば全身入ったイラストが理想的です。\n\n使用用途：主にお誕生日のお祝いのの鑑賞用です。鼓草ルチル様の配信活動（YouTube、Twitterに投稿する配信のサムネ等）での使用を許可して頂けるのなら背景、キャラクター、メッセージが分かれているPSDで納品して頂ければと思います。\n\nお願い：私に対するメッセージではなく一言鼓草ルチル様にお祝いの言葉を書いて頂ければと思っています。一人でも多くの方にお祝いしてもらった方が喜ばれると思うのでお願い致します。\n加えてもう一点お願いがあります。イラストをコミュニティ内で共有するのはお誕生日の日から後にさせてもらえたらと考えています。\n\n我儘なお願いばかりして大変申し訳ございません。ご一考頂ければ幸いでございます。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_turkey7/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8ee1e768/uploads/origins/f504ecf7-c530-4e51-81a9-50feec1fb8a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0877173b55bd0b6c094a57232942d4a5", "srcset": "https://si.imgix.net/8ee1e768/uploads/origins/f504ecf7-c530-4e51-81a9-50feec1fb8a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0877173b55bd0b6c094a57232942d4a5, https://si.imgix.net/8ee1e768/uploads/origins/f504ecf7-c530-4e51-81a9-50feec1fb8a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=776ac1e71903ef6182334268b6057aa7 2x, https://si.imgix.net/8ee1e768/uploads/origins/f504ecf7-c530-4e51-81a9-50feec1fb8a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2abb3c0a23df1cae4cad676cc4413052 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2269, "nc": 0}, {"path": "/@_turkey7/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2269, "client_id": 81523, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce180dbc/uploads/origins/24848b7c-3260-48fa-be92-4619a1157491?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8235ad100e69015f192731e2a7cfc3b8", "srcset": "ht