ble_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@7538sub/works/143", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1021509, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e77b75f/uploads/origins/bbaffc9e-462d-487f-8a7d-394c72d861ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b3da475f737257bf70230e3d712c4cb", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e77b75f/uploads/origins/bbaffc9e-462d-487f-8a7d-394c72d861ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38425d6113ce8018ffb977fbe44edaa7", "src_set": ""}, "body": "こんにちは、東方等のふたなり受けのイラストを依頼をしている者です。\n前回は素敵なゆかマキをありがとうございました！\n今回も前回の続き物でない、ふたなり受けのイラストになります。\n宜しければ、またゆっくりで構いませんので何卒御一考願います。\n\n依頼内容\n・キャラ\n遊戯王OCGより\n①ブラック・マジシャン・ガール(ふたなり)\n※以降表記BMG\n②地霊媒師アウス（非ふたなり）\n\n・イラスト概要\nふたなりっ娘が大好きなアウスのマスター(※立ち絵なしですが非ふたなりの♀の設定)に目を付けられたBMGが魔法カード「幻惑の巻物」で属性を闇→地に書き換えられ、アウスのパイズリ搾精でコントロール奪取されて奪われる様子のNTRビデオレター風r18イラスト。\n※BMGのマスターも立ち絵無しですが、こちらも♀(ふたなり)を想定。\n\n・基本構図\n画面右\nBMG(アウス視点)\n→アウスの胸を掴んで自ら腰を打ち付けているBMGの様子\n\nBMGの片手に幻惑の巻物が巻き付いてる\n※難しい場合は無しでも大丈夫です。\n\n画面左\nアウス(BMG視点)\n→BMGのふたなりチンポをパイズリで搾精しているアウスの様子\n\n上記の様子を第三者視点で横から見た構図でお願いします。\n\n表情等の差分を以下の様にお願いします\n\n①前\nBMG\n→上記の状態で自ら腰を打ち付け、搾精されている。\n目にハートを浮かべて正気を失ってる様子。\n胸から先がはみ出す程完全に勃起したふたなりチンポは、我慢汁が沢山出てもう射精しそうになってる。\n\nアウス\n→上記の状態。\n「ごめんなさいね〜貴女に恨みは無いけれど、私のマスターがどうしてもこの娘が欲しいって言うから、魅了して奪っちゃいました♡」とカメラ目線でニンマリと笑顔でパイズリを続けている。\n\n②後\nBMG\n→搾精された後で、目にハートを浮かべ、舌を出したトロ顔で「ましゅたーいっぱい出したよ？♡…ごほうびください♡」と完全に堕ちている様子。\n\nアウス\n→「はい、種馬魔導士の完成♡こうなったらもう戻らないね♡、この後は私のマスターとお楽しみかな？」\n「あぁそうだ、この娘はたぶんもう返してあげれないけど、貴女もふたなりだそうですから、私でよければ\"相手\"してあげますよ♡」\nとカメラ目線で指で輪っかを作り、舌を出して舐める素振り(エアフェラ)をして誘惑している。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7538sub/works/142", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9deeadc7/uploads/origins/459529bf-a1dc-4b00-8040-727b227a31fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f727c633f9405ff8a15e199a6250d78", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1021509, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@7538sub/works/141", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2ef901e9/uploads/origins/26326adf-0e9f-4dd9-b8e9-4fd198d9e3a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=efea39eea215ae8476b702d517b7b483", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1021509, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@7538sub/works/140", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1021509, "client_id": 1366155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7847c758/uploads/origins/a4438c6c-bcd2-45f9-9aba-9bdd7927666f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a55658a3eb7af671d6092f76338e1e4", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7847c758/uploads/origins/a4438c6c-bcd2-45f9-9aba-9bdd7927666f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e8d4fa09c28a73037875ad3a81820fe", "src_set": ""}, "body": "遊戯王からEMユニとコンのふたなり巨大馬チ○ポを手コキし、ぶっかけられてアへ顔を晒すRAI-MEIをお願いします。\n\n構図は中央にRAI-MEIのバストアップ(頭から股間まで)、その左右にEMユニとコンの腰から太もも辺りのアップで、RAI-MEIの顔の横に左右から馬チ○ポが突き出されており、それをRAI-MEIが両手で握っている状態。また、ユニとコンそれぞれのバストアップを画面の上の方に別枠で描いて下さい。\n\nキャラは全員上半身一杯に覆うくらいの超乳で元々の衣装を完全着衣、馬チ○ポは股間に穴が空いていてそこから出ているものとします。性格や口調はそれぞれお好きなイメージで作っていただいて構いません。\n\nストーリーの流れは\n①3人がこれから行うプレイをマスターに向けて説明し、マスターにもそれを見ながらオナニーすることを促す。\n②手コキ開始。同時にRAI-MEIがユニコンマスターの3人に向けて卑猥な言葉を羅列し、射精を促す。ユニコンは快感に身悶えている。\n③手コキが激しくなり、RAI-MEIのオナサポもヒートアップ。彼女自身も興奮から絶頂しそうであり、ユニコンと3人でフィニッシュに向けてアへ顔で淫語を叫び出す。\n④射精&絶頂。大量の精液を放出するユニコンとそれを胸や頭に浴びるRAI-MEI。3人は白目を剥き理性の消し飛んだアホ面のようなアへ顔で、人の出す声とは思えない濁った雄叫びを上げながら絶頂を迎える。\n⑤射精後。ユニコンは白目のまま放心状態で虚ろな声を上げ、一仕事終えた馬チ○ポもだらしなく垂れ下がっている。そんな中RAI-MEIはアへ顔こそ直っていないものの、可愛らしくダブルピースをしながらマスターも気持ち良くオナニー出来たか聞いてくるのだった。\n\n…といった感じです。\nとにかく全編通してアへ顔と淫語と濁音混じりの喘ぎで埋め尽くしてください。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1OrmF-Yvki6G5dNhXF00bsfUEGbfqYxX_", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7538sub/works/139", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c671e716/uploads/origins/fe58c3ad-3996-4cc0-89b1-16051d18d5d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27f576ab855c836a091b07750b620267", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1021509, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@7538sub/works/138", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/07fff1e3/uploads/origins/8aaa97e1-93b6-4b1d-9202-ecc782a3436d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50554ce8a14a1e22703f439e75e8f4bf", "src_set": ""}, "private": true, "genre": "comic", "tipped": true, "creator_id": 1021509, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@7538sub/works/137", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1021509, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/561797fe/uploads/origins/5a31ec29-dd1b-4e66-8033-2c1865a0cdfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e664dbe44f39561a8663046b682d3d2a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/561797fe/uploads/origins/5a31ec29-dd1b-4e66-8033-2c1865a0cdfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a48346b51f4badb01cef6f8ea7f2055", "src_set": ""}, "body": "ナゴさま\nツクヨミちゃんから連続の美プラリクエストで申し訳ありませんが、よろしければお願いします\n\n以前ご依頼で描いていただいたルミティア、エレーナと同じアルカナディアシリーズのエルメダさんのえっちなイラストをお願いしたいです\n\n⚪︎キャラクター\nエルメダ\n(https://arcanadea-official.com/character/ermeda/)\nお手数をお掛けしますが、上記URLや参考資料にて確認をお願いします\n\nルミティアと同じ天使のお姉さん\n巨乳でむちむちな感じに描いていただきたいです\nノーマルモードの着衣姿(参考資料の写真のように腰の大きなスカートは省略して欲しいです)と耳と背中の羽以外を脱いだ状態での裸姿と描いていただきたいです\n可能であれば、肌差分を青肌でお願いしたいです\n\n⚪︎シュチュエーション\nエルメダお姉さんとミルク出しあいっこの騎乗位搾精セックス\nマスター(竿役)のおち⚪︎ぽミルクが欲しくてたまらない発情エルメダさんが、絞りとるように自分でおっぱいを揉みながら騎乗位責めしている状態\n\n主観の構図で過去にご依頼したこちらのルミティアの作品の1、2枚目ようなポーズでお願いしたいです\n(https://www.pixiv.net/artworks/111624925)\n\n①②にて着衣姿と裸姿を描いていただき、③は裸姿のみの5種の構成でお願いしたいです\nセリフや効果音などその他をお任せでお願いします\n\n①騎乗位責め\nマスターさんのおち⚪︎ぽミルクをおねだりしながら騎乗位責め\n\n②絶頂•噴乳\n中出しされて、アヘ顔になりながら絶頂\n母乳も激しく吹き出している(着衣姿でも服の上から)状態\n\n③その後\nこちらは裸姿のみで、全身精液や母乳まみれになっていて、マスターのおち⚪︎ぽミルクを大量射精されお腹が膨らんでいる状態\nまた、受精描写をお願いしたいです\n母乳を垂らしながらママになる喜びに感じていて嬉しそうな表情\n\nお忙しい中、連続して申し訳ありませんが\nどうかご検討をよろしくお願いします\n\nhttps://drive.google.com/drive/folders/1l-Q7wfopzQ56kEhhp246Slu56oB8n7Lz", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7538sub/works/136", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1021509, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5785324/uploads/origins/28537452-8c5b-480a-a165-a074d414381a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10510817d38658ef13b7856762e1bf57", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5785324/uploads/origins/28537452-8c5b-480a-a165-a074d414381a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=136d29afe5ecfe9cd0eec01ae1b33cd0", "src_set": ""}, "body": "蜂怪人のシチュエーションがとてもよかったのでリクエスト失礼いたします。\n\n\n☆キャラクター\nヴィジランテ-僕のヒーローアカデミアILLEGALS-から塚内真\n\n\n☆シチュエーション\nヴィランに個性変化の新薬を投与され、元の個性を消されて強姦される。\n薬の副作用で悪魔化が進行し、個性変化中に男のチンポをマンコに咥えていたのでサキュバス化する。\n最終的にサキュバス化して個性はエナジードレインに書き換えられる。\n身体は常時発情していて悪魔化の体質変化により精液と愛液でしか栄養を得られなくなる。\n\n\n☆描いていただきたい流れ\n1.薬を入れられ後の状態、子宮に淫紋が刻印されており、表情は威嚇しているが身体は強制的に発情している\n\n2.チンポを入れられ淫紋が輝き、身体の変化が起きる。綺麗だったおっぱいと乳首が大きくなる。\n\n3.中出しされながら徐々に変化、片目の色が変わり舌の色が変化する。\n\n4.肌の色が部分的に変化しつつ角と翼が少しづつ出てくる、快楽に溺れて考えがまとまらなくなり喘ぎながら自分の目的がなんなのか分からなくなる。\n\n5.肌の色が変わり、角と翼が全て生えて完全にサキュバス化、言動も変わる。変化はしているが原型がほのかにわかる感じにしていただきたいです。例えばアクセサリーが着いたままや、ほくろが残ったままなど\n\n6.中出しされながらおまんこをぐちゃぐちゃに犯され潮吹きと乳首から母乳噴射、もとより興味のあったヒーロー達の記憶が存在していて、目的がヒーローの精液をエナジードレインして最高な相性の相手を眷属として迎え受精することになる。\n\nご検討のほどよろしくお願いいたします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7538sub/works/135", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/75b264a4/uploads/origins/32db8123-bb8a-4ed5-a010-631122864721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e08013b518c6096e70f2afd2ee57108", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1021509, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@7538sub/works/134", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1021509, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b44e3ba/uploads/origins/63024f12-2e1d-46e2-a540-6f459e46c852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a1d000334d32edd4a4d444796267ed9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b44e3ba/uploads/origins/63024f12-2e1d-46e2-a540-6f459e46c852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83787a104d5007bbcdaa45f9112b83ec", "src_set": ""}, "body": "よろしければ\nリクエストをお願いします\n\n⚪︎キャラクター\nコトブキヤ『メガミデバイス』シリーズより\n\n•皇巫(オウブ)ツクヨミ\n(https://www.kotobukiya.co.jp/product/detail/p4934054049301/)\nお手数をお掛けしますが、上記URLや参考資料にて確認をお願いします\n\nネクロマンサーの色白片目カクレ爆乳垂乳陰キャお姉さんで、ポケモンXYのオカルトマニアさんみたいな感じに描いていただきたいです\n設定では全高14cmですが、人間と同じサイズで参考資料のような武装がついてない素体状態と全裸姿を描いていただきたいです\nまた、全裸姿は巨乳輪で陰毛が生えているだらしない感じにしていただきたいです\n\n⚪︎シュチュエーションと詳細\n発情して人間サイズになったツクヨミがマスター(持ち主)さんを押し倒して騎乗位セックスしているシュチュエーション\nナゴさまのこちらの作品のように主観の構図でツクヨミは正面向きのエロ蹲踞のポーズ\n(https://skeb.jp/@7538sub/works/100)\nマスターは竿と手のみの描写で、可能でしたらオンオフできるようにしていただきたいです\n\n下記のような、①②を素体姿と全裸姿、③は全裸姿のみの5種の構成でお願いしたいです\nその他、セリフや効果音をお任せでお願いします\n\n①挿入、ピストン\nニチャっとした不敵な笑みでマスターと騎乗位セックス\n\n②中出し絶頂\n片胸を揉まれながら中出しされて絶頂\nアヘ顔で母乳噴射\n\n③その後、ボテ腹でちん媚び\nこちらは全裸のみで、手や挿入もなし\nボテ腹妊婦になった身体を見せつけるようにちん媚びしている様子\n\n毎度指示がおおくなって申し訳ありませんがどうかよろしくお願い致します\n\nその他参考URL\n(https://www.kotobukiya.co.jp/blog2/megami/article/detail/275/)\n\nhttps://drive.google.com/drive/folders/1pPW-S2Nf0qXjYyd2nNBUeBbnI2kV8QtX", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7538sub/works/133", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1021509, "client_id": 1315148, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5aeafaf2/uploads/origins/bcc453ad-26a3-40c3-985a-75e370bd6d37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=974b2079513a43831e6032a963525981", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5aeafaf2/uploads/origins/bcc453ad-26a3-40c3-985a-75e370bd6d37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01baf7e334c0e04605a5a3fb1b90c766", "src_set": ""}, "body": "以前あなたがお描きになったポケモンxy版の元カラテおうだったムチムチ巨乳ニューハーフのおとなのおねえさんの全裸立ちション絵をまたお願いします。おちんちんと金玉の色は黒では無くて肌と同じ色で。脚の先まで映るように描いてください。ニッコリ笑顔で。向きは前回と同じで。\n1p:ガニ股で大きなおちんちんを構えてパオ〜ンおちんちんパオ〜ンとぞうさん踊りしながら下品におしっこ。\n2p:バキバキに勃起し、大量におしっこ。\n(ナイスバディなビキニのおねえさんを想像したのか)\n3p:センズリこいて射精。巨大な精子たち。\n4p:真後ろ向いてお尻アップ。(ニューハーフという設定なのでおまんこは当然無しで)\n最後:最後っ屁。\n各ページセリフはお好みで。\nまたよろしくお願いします。\n(実はバトルシャトーの元カラテおうだけては無く、ミアレシティの路地裏に勝利後にきんのたまをくれるおとなのおねえさんがいたのを思い出しました。)", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7538sub/works/132", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1021509, "client_id": 2488239, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/463a0515/uploads/origins/af1efc21-1d78-46b4-b04b-10315f5e2bc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82a7511465385f13055f343e1724e1db", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/463a0515/uploads/origins/af1efc21-1d78-46b4-b04b-10315f5e2bc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b29797c721a003bbcc28c015a750539", "src_set": ""}, "body": "いつもイラスト拝見しています。\n以前は素晴らしいイラストをありがとうございます。\n続けてのリクエスト失礼します。\n以前のイラストの続きといった感じで遊戯王のクイーンマドルチェ·ティアラミスとティーチャーマドルチェ・グラスフレの騎乗位搾精交尾のイラストをお願いしたいです。\n差分としては\n1.挿入開始\n2.腰振り開始\n3.ラストスパート\n4.射精、仰け反り絶頂(舌が出ていると良いです)\n5.アヘ顔を見せながら余韻に浸る\nといった感じでお願いします\n台詞回しも以前のような、マドルチェに絡めた下品な台詞があればと思います\n値段については前回の金額を参考にしていますが、認識の相違があれば値段の変更をお願い致します。\n続けてリクエストで恐縮ですが、ぜひお願いいたします", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7538sub/works/131", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7b811fd3/uploads/origins/d1016c79-c7dd-4b8c-8175-f04b2c18bee4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6726fd2a1cdbca782a0b7443ddb4a9ab", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1021509, "client_id": 3667553, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@7538sub/works/130", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/96d8b495/uploads/origins/7908bc6b-35a3-4f68-a3fc-c9f004257c34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad6b4263f5a3d47499e671795f6f6698", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1021509, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@7538sub/works/129", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8a343b8f/uploads/origins/9a8eabf2-8c6c-41e0-a5ff-ff42cc704da9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e94d41051a457468162c4b67c8282033", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1021509, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@7538sub/works/128", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1021509, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/640ae60b/uploads/origins/90ad7ac6-e0f0-41b5-ac30-08cb4f2603cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdc1eb49cd0225971486fd406a0cb52c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/640ae60b/uploads/origins/90ad7ac6-e0f0-41b5-ac30-08cb4f2603cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8344d37ddda8c7075cafe452023dae9", "src_set": ""}, "body": "ひょっとこ顔とセリフの下品さが大好物だったのでリクエストします\nクレしんの桜田もえ子で背面駅弁でのセックスとパイズリひょっとこフェラをお願いします\n背面駅弁では巨根に挿入され、鼻息を荒げながら「イグゥぅ、マンコぶっ壊れる、チンポ最高」などの下品なセリフ\n中だしされ、アヘ顔と母乳を噴射しながら「中だし気持ち良すぎ、ザー汁で満たされる、赤ちゃんできちゃう」などのセリフ\n\nパイズリひょっとこフェラではしゃぶりながら「くっさいチンポ美味すぎ、早く精子飲ませろ」\n口内射精され、アヘ顔で鼻と口から精子を漏らしながら「うっめぇぇ、このチンポ大好き」\n\n以上になります。\nど変態な感じで描いてもらえると最高です", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7538sub/works/127", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/09fee9da/uploads/origins/967b201c-bb9a-4773-a03e-16b5beb1c341?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b872f5830c611c4ca285f9b4881d4fb2", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1021509, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@7538sub/works/126", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1021509, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f99c082b/uploads/origins/588bb33f-bc97-48c7-9e22-f8b85d3cffbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3641921e06d957929772e2f80ceb888e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f99c082b/uploads/origins/588bb33f-bc97-48c7-9e22-f8b85d3cffbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be864271abb5ce33efef4815527f94e9", "src_set": ""}, "body": "こんにちは!!イラストのリクエストをさせていただきます!!依頼の内容は以下の通りです。\n[キャラクター]\nけものフレンズ\nマサイキリン\n[https://seesaawiki.jp/kemono_friends3_5ch/d/%A5%DE%A5%B5%A5%A4%A5%AD%A5%EA%A5%F3]\nインドサイ\n[https://seesaawiki.jp/kemono_friends3_5ch/d/%A5%A4%A5%F3%A5%C9%A5%B5%A5%A4]\n[シチュエーション]\nそれぞれ、ラテックスボールに入ってゴロゴロ転がって、散歩している様子をお願いします。\n[ラテックスボール]\n・ボールの大きさ\n中に入るキャラに対して、超巨大なボールサイズ\n・ボールの柄\nマサイキリンちゃんとインドサイちゃんが着ている首の部分のマフラーなどを含めた服や鎧の柄\n(ただし、スカートの線、腕や手の部分は除くとします。)\n[その他]\n・ラテックスボール特有の光沢感も付けてください。\n・ラテックスボールはパンパンに丸く膨らんでいて、首はボールの中に埋まり、周りにしわが出ている状態で描いて下さい。\n・1枚の絵に2人が丁度入るくらいでお願いいたします。\n内容は以上です。それでは、よろしくお願いします!!", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7538sub/works/125", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/95e1b18e/uploads/origins/bae339fd-b4ed-4427-bfab-9ee6bda47895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e6ed1a859d1f51f6788154a35124eedf", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1021509, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@7538sub/works/124", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1021509, "client_id": 2488239, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87965467/uploads/origins/fe937e23-8db7-4ded-ad0f-e9c017918af9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a74bee14706c3f9d95a5cfe16fc4575", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87965467/uploads/origins/fe937e23-8db7-4ded-ad0f-e9c017918af9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0208d2cd01196fc93ffc47b762f4a2a", "src_set": ""}, "body": "はじめまして、いつもイラスト拝見しています。\nリクエスト失礼します\n私の推しでもある遊戯王のクイーンマドルチェ·ティアラミスとティーチャーマドルチェ・グラスフレのダブルパイズリとひょっとこ吸い付きのイラストをお願いしたいです。\n差分としては\n1.パイズリ開始\n2.吸い付き開始\n3.射精\n4.ティアラミス口内見せつけ、グラスフレしたなめずり\nといった感じでお願いします\nセリフなど細かい部分はおまかせしますが「精液は私たちの世界では最高の美食」のような、マドルチェに絡めた下品な台詞があればと思います\n値段については一旦おまかせの金額にしていますが、認識の相違があれば値段の変更をお願い致します。\n初めてのリクエストで恐縮ですが、ぜひお願いいたします", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7538sub/works/123", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4e1a0df0/uploads/origins/2db5edd7-a1cd-49b8-a79d-a430adda5cc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=12ecf80aad46fa8393fa6a7671e4d522", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1021509, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@7538sub/works/122", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/701d32fa/uploads/origins/0d38f026-3ea1-412a-b6f9-b5f4c2d42415?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ad8cb8048ebb7841bf359ce90b47979", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1021509, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@7538sub/works/121", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1021509, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8b82027/uploads/origins/59ce57b9-f16c-48e4-93b7-a0091777a9d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c5b903270a2116d5578ec802b6af02f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8b82027/uploads/origins/59ce57b9-f16c-48e4-93b7-a0091777a9d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0f72e694be149b9c6f5ef64cb38734c", "src_set": ""}, "body": "ニッチなリクエストになりますがよろしくお願い致します。\n\n【キャラ】\n初音ミク\n\n【シチュエーション】\n・初音ミクが頭だけ出ている状態でラテックスボール拘束されている。(何もできずに無様に拘束されてる感じ)\n\n・拘束されているラテックスボールは膨体みたいなイメージの「初音ミク最初期衣装(ネクタイのヤツ)」デザインをそのまま膨らませたような柄が印刷されている。(初音ミク専用拘束具みたいな感じ)\n\n・「なにこれぇ…」みたいな困惑した表情。\n(表情差分など余裕あれば作成頂けると幸いです)\n\n構図:真正面(正面立ち絵みたいな感じでお願いします)", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7538sub/works/120", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1021509, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/27c1c7f4/uploads/origins/8b88d897-9fd5-443a-a544-f8c8e832854c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a26806d92ff9f53d36f1e8db12b0121", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27c1c7f4/uploads/origins/8b88d897-9fd5-443a-a544-f8c8e832854c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fe179a149df10701e0ffbb37a930a38", "src_set": ""}, "body": "ナゴさまのこちら(https://skeb.jp/@7538sub/works/106)のブチュキスが好きで、ブルアカのハスミ(https://bluearchive.wikiru.jp/?%E3%83%8F%E3%82%B9%E3%83%9F)とミネ(https://bluearchive.wikiru.jp/?%E3%83%9F%E3%83%8D)で同じような抱き枕イラストをお願いします。\n\n「ハスミとミネにイタズラが出来る！」という、縦長のボックス内に詰まって身動きが取れない顔を隠している“そっくりさん”を相手に、パイズリ、キスが出来るという企画です。\nがしかし、実は本人で、バレる前にさっさと満足して帰ってもらおうと、必死に射精に誘導しています。\n企画として汚すのと本番NGなので、キス役はマスク、パイズリ役は使用済みコンドーム、二人ともマンコに自身の顔写真を前貼りとして貼っているでお願いします。\n\nパイズリ役は制服と顔まで覆う全身ストッキングでマングリ返しをして下に配置、キス役は制服と首まで覆う全身ストッキングとマスクで腋を見せつつマスク越しにブチュキスです。\n表情は、ミネは眉間に皺を寄せて怒っている、ハスミは困り眉でドン引き顔でお願いします。\n\n縦長のボックスは掃除ロッカーみたいなイメージで、ハスミとミネは胸や尻を押しつぶしながら詰まっています。\nキス役の腋見せは、腕を耳に付けるように大きく挙げて手を背中に回すような感じで、腕が垂直に近くなっています。\nパイズリ役のマングリ返しは、描写の都合でエロ蹲踞でもOKです。\n二人ともロングスカートなので、描写上不都合であればミニスカート化やスカートを脱がせてください。\n\n差分として、\nハスミとミネの配置が入れ替わったイラスト、\n鼻フックかテープで豚鼻にされてマスクの上からでも鼻穴が見えるイラスト\nをお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7538sub/works/119", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1021509, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a203eb4/uploads/origins/31e1fa84-0b7b-43ea-9613-9c3f4d7cc6af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac4de4a73e1ed952430e8362f52c7e35", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a203eb4/uploads/origins/31e1fa84-0b7b-43ea-9613-9c3f4d7cc6af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2d770d5d865d442879a8d6ecd0134f4", "src_set": ""}, "body": "キャラ　二子玉舞（アリス・ギア・アイギス）\n内容　以前描かれていたこちら（https://skeb.jp/@7538sub/works/49\n）のように爆根の隊長さん（竿役）に見せ槍され挿入おねだり後、ボテ腹になるまで大量射精されて複数受精粉乳アクメしているのをお願いします", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7538sub/works/118", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1021509, "client_id": 1315148, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f9533fe/uploads/origins/cb58ed0f-9810-4bb4-b7de-570f9664c31b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3ea592f51ea860ff115515ca3aaefe6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f9533fe/uploads/origins/cb58ed0f-9810-4bb4-b7de-570f9664c31b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f16b41db7dad184c0dcfb894d8ac2240", "src_set": ""}, "body": "お忙しい中恐縮なのですが、またリクエストをお願いいたします。前回お描きになったムチムチ巨乳&巨尻のシーメール(ニューハーフ)化させたブラジリアンミクの全裸立ちション及び背後の絵のアレンジと一部修正をお願いします。もちろん玉ありで真正面を向いて裸でガニ股でおしっこ。脚の先まで映るように描いてください。ペニスと金玉袋の色は肌と同じく褐色。\nシチュ\n1p:非勃起&放尿。もっと下品にぞうさん踊りしながら笑顔で楽しそうにガニ股でおしっこ。今度は床をおしっこのプールに。相変わらずチンコという下品な言い方。あと亀頭にチンカスたっぷり。\n2p:勃起&噴水のように放尿。加えて美味しそうにセルフ飲尿。ボッキチンコをセリフに。\n3p:セルフパイズリ&射精。母乳も噴出。\n4p:真後ろ向いて大量脱糞。モザイク無しで\n。極太。\n最後:こっちを少し振り向いて巨大なお尻シェイク&最後っ屁。\nあとあくまでニューハーフという設定なので背後絵のマンコの部分はオミット。(可能なら前回描いた彼女のマンコをオミットしてもらえませんでしょうか？)\n前回同様、各ページの台詞はお好みで付けてください。\n\nシーメールミク気に入りました。よろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7538sub/works/117", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ea27457d/uploads/origins/499fa8fe-7761-4a91-a5fc-3eda32bea71b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4f32cce55e1f46e0ee747be941dfdd1", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1021509, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@7538sub/works/116", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1021509, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a29bd53e/uploads/origins/621c80a6-624c-474b-b85f-f51c3f85abf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da672d2c3d82c8400cfd1cc615373218", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a29bd53e/uploads/origins/621c80a6-624c-474b-b85f-f51c3f85abf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10e950736aaa4193e9658cd0d16af52e", "src_set": ""}, "body": "最近流行り始めたブラジリアンミクのムチムチ巨乳&巨尻のシーメール(ニューハーフ)化&全裸立ちション絵をお願いします。玉ありで真正面を向いて裸でガニ股でおしっこ。脚の先まで映るように描いてください。ペニスと金玉袋の色は肌と同じく褐色。\nシチュ\n1p:非勃起&放尿。ぞうさん踊りしながら笑顔で楽しそうにおしっこ。尚、彼女はチンコという派。\n2p:勃起&噴水のように放尿。\n3p:射精。大きな精子たち。\n4p:真後ろ向いて巨大な尻を振る。アナルは開けずに閉じたまま。\n最後:ものすごい勢いでオナラ。アナル開口。\n各ページの台詞はお好みで付けてください。\n\n本場ブラジルに女性と見間違うほどナイスバディなニューハーフが多いので、こうゆう発想が想い浮かびました。\nよろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7538sub/works/115", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1021509, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef9fce4f/uploads/origins/55170fc2-1605-4cf2-8591-4dcfd5a49575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8002711a17297e0f235641d56b57ed0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef9fce4f/uploads/origins/55170fc2-1605-4cf2-8591-4dcfd5a49575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4c93a09c6634825040a1c1ca8fa7dd6", "src_set": ""}, "body": "リクエストをよろしければお願いします\n\n以下のポケモンキャラの2人がロケット団員堕ちするイラストをお願いしたいです！\n\n⚪︎キャラ\n•モミ\n(ダイヤモンド•パールなどより)\n母性的なむっちりで巨乳な体型で描いて欲しいです\n\n•ガラル地方のポケモンセンターのお姉さん\n(ソード•シールドより)\n参考資料のようなガラル地方のポケモンセンターのお姉さんでお願いしたいです\nモミさんに比べて、細身で美乳なおっぱいの体型で描いて欲しいです\n\n⚪︎詳細\nロケット団に捕まり、洗脳処置を施されてロケット団員にされてしまうようなシュチュエーション\n2人とも全裸姿の正面向きで、ガニ股でオマンコを広げながら腰を前に突き出しているポーズ\n\n①裸で拘束\n裸でガニ股のポーズで助けを求めている様子\n\n②洗脳処置\n電気責めされながら洗脳処置\n快感でアヘ顔になりながら失禁してしまっている\n\n③団員堕ち\n洗脳処置が完了してロケット団員化、黒いぴっちりスーツ姿に\n(団員達の肉便器要員になるよう洗脳されたため、ふたなりは生えてない状態)\n\n④団員堕ちその2\n団員達の子供を孕っていてボテ腹で母乳を噴射しながらちん媚びしている\n参考資料のような、口のみ露出した全頭マスクを被っている状態\n\nセリフなどはお任せでお願いしたいです\nどうかよろしくお願いします\n\nhttps://drive.google.com/file/d/15kraNKaRZlsKWQITDtRfFWAfeCNXSQG5", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7538sub/works/114", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8e67cfbd/uploads/origins/df895d73-d3b5-4112-9636-d4fc08db2c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b2d74094840115411da096f198c724c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1021509, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 34928, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "さふぃ@C105二日目東レ-08a", "screen_name": "nagi_u", "avatar_url": "https://pbs.twimg.com/profile_images/1502231863213301760/D66N5CMD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/72580163/1475036960/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 176}, {"id": 44648, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "棚から猫餅🔞", "screen_name": "mabo_guppue", "avatar_url": "https://pbs.twimg.com/profile_images/1759725671641935872/BNKPRIHk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/988848202467037184/1731572750/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 176}, {"id": 92208, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ヒトツメア＠skeb募集中", "screen_name": "hitotsumea", "avatar_url": "https://pbs.twimg.com/profile_images/1153240169929043968/_GyjTql5.png", "header_url": "https://pbs.twimg.com/profile_banners/789701796201586688/1563716753/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_ra