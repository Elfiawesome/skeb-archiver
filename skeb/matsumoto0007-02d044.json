_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 86163, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e79a0d8/uploads/origins/213624be-7f45-41c6-8c0e-4eeb1faa178d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2adce8700419d9d37e28b15772c8d40", "srcset": "https://si.imgix.net/9e79a0d8/uploads/origins/213624be-7f45-41c6-8c0e-4eeb1faa178d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2adce8700419d9d37e28b15772c8d40, https://si.imgix.net/9e79a0d8/uploads/origins/213624be-7f45-41c6-8c0e-4eeb1faa178d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2cf109c42a60e64dd12d7d6ab6cf4b9a 2x, https://si.imgix.net/9e79a0d8/uploads/origins/213624be-7f45-41c6-8c0e-4eeb1faa178d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ebe2b3d60ba7e5577043afcfe6d0d09 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e79a0d8/uploads/origins/213624be-7f45-41c6-8c0e-4eeb1faa178d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab5edd5085840b50e125e8a405e328cb", "srcset": "https://si.imgix.net/9e79a0d8/uploads/origins/213624be-7f45-41c6-8c0e-4eeb1faa178d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab5edd5085840b50e125e8a405e328cb, https://si.imgix.net/9e79a0d8/uploads/origins/213624be-7f45-41c6-8c0e-4eeb1faa178d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ba56aba790cd11f4a99dc2a7249c101 2x, https://si.imgix.net/9e79a0d8/uploads/origins/213624be-7f45-41c6-8c0e-4eeb1faa178d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1455a7805e9418f295848414d4d5463f 3x"}, "body": "はじめまして。\n松本先生の素敵なイラストの一枚一枚に惹かれて、先生がskebを開設されていらっしゃったのを拝見したので是非リクエストさせていただければと思い送らせていただきます。\nご検討いただけましたら幸甚です。\n宜しくお願い致します…！\nご依頼したい内容は以下の通りです。\n\n「乙女ゲー世界はモブに厳しい世界です」のアンジェリカ・ラファ・レッドグレイブ（以下アンジェと称する）の領地温泉宣伝ポスター風（足湯）イラスト。\n私が読んだモブせか二次創作小説の面白い感じの「まさか領主の正妻自身が広告塔になるとは思わなかったが」のシーン、小説は下記URLにあります。\nhttps://syosetu.org/novel/312750/8.html\n\nキャラデザイン\n基本的には漫畫版を参考にしてください、下記URLの参考画像のような感じ。\n参考：http://tiny.cc/6ut5vz\nアンジェは吊り目、金髮、赤い瞳、細身で背が高い（身長170cmくらい）、足が長い、細身で着衣巨乳と抜群スタイルを強調。\n衣装は温泉旅館の浴衣、メインカラーにワインレッド、サブカラーに黒と金、デザインお任せします。\n\nシチュエーション\n「アンジェと温泉で足湯」のように浴衣の裾を少々ずらして押さえつつ、足湯に入っている。\n\n楽しそうな表情でお願いします、構図やポーズ等の詳細についても先生の描きやすいようにお任せいたします。\nご自由に描いてください。先生にとってかっこいいシーンであればうれしいです。\n\n金額が足りないならば再要請してください。\n好みに合わなかったり、料金に見合わない場合はキャンセルしていただいて大丈夫です。\n長文失礼致しました。初めての依頼にも関わらず、要望が多く申し訳ございません。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matsumoto0007/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 86163, "client_id": 706365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff6e2264/uploads/origins/af6bb4d9-4419-4364-a88a-3703d50b061d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6eff2dbbf45c20f7f898e3da1903b0be", "srcset": "https://si.imgix.net/ff6e2264/uploads/origins/af6bb4d9-4419-4364-a88a-3703d50b061d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6eff2dbbf45c20f7f898e3da1903b0be, https://si.imgix.net/ff6e2264/uploads/origins/af6bb4d9-4419-4364-a88a-3703d50b061d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fee88e9f50a68d0ca26d7fb3a9b37308 2x, https://si.imgix.net/ff6e2264/uploads/origins/af6bb4d9-4419-4364-a88a-3703d50b061d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44faa58162708c86d42be23a8a4501b8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff6e2264/uploads/origins/af6bb4d9-4419-4364-a88a-3703d50b061d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&