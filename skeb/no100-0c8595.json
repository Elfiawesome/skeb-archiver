、あまり上手ではありません。\n\nーーーーーー\n\n使用用途は 個人鑑賞用です。 \n\nぜひお好きなように描いていただけたら嬉しいです。\nお忙しい時や難しい場合は流してくださって構いません。\nよろしくお願い申し上げます。\n\nhttps://www.dropbox.com/sh/kx8nxxa9ukgfr07/AAAIjEjHUhR8KReK-1yJnCSya?dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Full_burrrrrrst/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 25494, "client_id": 100, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb2ff4cc/uploads/origins/e428d527-da2b-4d9a-9835-e306943e3699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19c33c1f6c4faf44bd3919bb275a8a7c", "srcset": "https://si.imgix.net/bb2ff4cc/uploads/origins/e428d527-da2b-4d9a-9835-e306943e3699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19c33c1f6c4faf44bd3919bb275a8a7c, https://si.imgix.net/bb2ff4cc/uploads/origins/e428d527-da2b-4d9a-9835-e306943e3699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a2592b211a611598aae4f6aa67f931b 2x, https://si.imgix.net/bb2ff4cc/uploads/origins/e428d527-da2b-4d9a-9835-e306943e3699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73eadc3a4a25c355a3553842b80c458f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb2ff4cc/uploads/origins/e428d527-da2b-4d9a-9835-e306943e3699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=422f0c217295d88a14985fd67da2a0e6", "srcset": "https://si.imgix.net/bb2ff4cc/uploads/origins/e428d527-da2b-4d9a-9835-e306943e3699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=422f0c217295d88a14985fd67da2a0e6, https://si.imgix.net/bb2ff4cc/uploads/origins/e428d527-da2b-4d9a-9835-e306943e3699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d569bf8768cc5712e401e5dd073a6cf