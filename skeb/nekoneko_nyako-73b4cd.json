blur=200&s=53ce488de0045f26843b2efd222290c3 3x"}, "body": "こんにちは。以前お願いしたシャボン玉可可ちゃんの絵がとても可愛く素晴らしいものでしたのでリピートさせていただきました。\n今回は渡辺曜ちゃんが大きな割れないシャボン玉の中に入ってふわふわ空を飛んでいるイラストをお願い致します。 \n衣装は制服希望です。\nシャボン玉の中でストローをくわえてシャボン玉を吹かせてください。 構図等はお任せ致します。よろしくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekoneko_nyako/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1479396, "client_id": 1684441, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/82d2f8fd/uploads/origins/c14d090c-74ee-4d8d-99c5-628483e30dee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a3f821e76720062e9dfa38a5fd3332b", "srcset": "https://si.imgix.net/82d2f8fd/uploads/origins/c14d090c-74ee-4d8d-99c5-628483e30dee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a3f821e76720062e9dfa38a5fd3332b, https://si.imgix.net/82d2f8fd/uploads/origins/c14d090c-74ee-4d8d-99c5-628483e30dee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99ea82619476379d6fbc7cbde1e86c2d 2x, https://si.imgix.net/82d2f8fd/uploads/origins/c14d090c-74ee-4d8d-99c5-628483e30dee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b00d8b97d39b7af95c53ae2a1ee16edf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82d2f8fd/uploads/origins/c14d090c-74ee-4d8d-99c5-628483e30dee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cc2288ec476552ba947d700122f464e", "srcset": "https://si.imgix.net/82d2f8fd/uploads/origins/c14d090c-74ee-4d8d-99c5-628483e30dee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cc2288ec476552ba947d700122f464e, https://si.imgix.net/82d2f8fd/uploads/origins/c14d090c-74ee-4d8d-99c5-628483e30dee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=t