d_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamonika_monika/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2878872, "client_id": 2754218, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/77e207df/uploads/origins/1bb831a3-2326-49c4-9e82-d3f06471643e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f552fe15bb09b8e840e5d1a990866c62", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/77e207df/uploads/origins/1bb831a3-2326-49c4-9e82-d3f06471643e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cfd34ad93082f5777783d1564331feb", "src_set": ""}, "body": "羽亜もにか様こんにちは。\n配信活動をしている風矢と申します。\n羽亜もにか様のイラストを先程見かけ、そちらが大変好みのイラストだったため私も描いていただけたらなと思いリクエストを飛ばさせていただきました。\n\n【依頼内容】\n配信に使用するサムネイルイラストをお願いしたいです。\nSNSでの投稿(イラスト使用したサムネイル投稿や紹介)、動画や配信内で使用したいと思っております。\n\n【参考】\n固定ツイートに三面図等ございます。\nhttps://twitter.com/fuytowa7993\n\n【要望】\n衣装2種類ありますがどちらの衣装でも問題ないです。\n背景透過のものも納品頂けるととても助かります。\n\n\nご検討宜しくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamonika_monika/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2878872, "client_id": 464757, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a334d2e8/uploads/origins/84225053-de27-4575-b3da-4b44195ce534?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8922e262cdd8e27c34b38a02630b994", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a334d2e8/uploads/origins/84225053-de27-4575-b3da-4b44195ce534?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fdb69646995d70e294734cb76095426e", "src_set": ""}, "body": "以前からイラストを拝見していました。東方のイラストに一目惚れし、リクエストしたいです。\n内容は霍青娥のイラストで、背景は水色や青系でお願いします。使用用途は観賞用です。\n画像サイズや構図はお任せします。\nよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamonika_monika/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2878872, "client_id": 3241676, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5f9e703/uploads/origins/c492c5d9-779e-4da2-9ce4-e723816326e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f85dfe466f954a6f102b529412311fbe", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5f9e703/uploads/origins/c492c5d9-779e-4da2-9ce4-e723816326e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=847d479fa56fddd3beaaa0d3f3526777", "src_set": ""}, "body": "羽亜もにか先生、こんにちは。\n先生の作品を拝見しましたが、とても素晴らしいと思いました。\nもしよろしければ一つリクエストがあるのですが、東方Projectの東風谷早苗を描いていただけませんか。\n構図とポーズは先生に任せると思います。でも良かったら、早苗の可愛さとかっこよさが絵の中で表現したいです。\nもしリクエストを受けたら、先生の作品を期待しています！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamonika_monika/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2878872, "client_id": 3326956, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07ca8202/uploads/origins/027325e5-8d00-4078-9fe0-00952ed781b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae1b195604443a02720759b764312e29", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/07ca8202/uploads/origins/027325e5-8d00-4078-9fe0-00952ed781b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7adf43e5390f36558fcd8a417e228c80", "src_set": ""}, "body": "はじめまして！\nVTuber準備中の夏凪ナツカと申します。\n\nもにか様の柔らかくて、可愛いイラストが好きです！\n今回、立ち絵を公開したため、リクエストを送らせていただきます。\n\nskeb初心者のため、不躾なことがあれば申し訳ございません。\n以下、詳細となります。ご検討いただけますと幸いでございます。\n\n◇依頼内容\n私のイラストを描いていただきたいです。\n立ち絵や顔アップの資料などは、リットリンクにあります。\n衣装は水着(水着のデザインなどはお任せします)をお願いしたいです。\n構図は、砂浜で水鉄砲で遊んでる感じでお願いしたいです。\n背景を描いていただける場合は、背景と人物が別々のファイルで納品していただけますでしょうか。(PNGファイルでいただきたいです。)\n\n◇使用用途\n・SNSの投稿(Xなど)\n・YouTubeのサムネイルやヘッダーなど\n▶︎SNSや配信、今後の活動で使用させていただきたいです。\n\n以上となります。\nご検討いただけますと幸いです！よろしくお願いいたします。\n\nhttps://lit.link/natsunaginatsuka", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamonika_monika/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7f6bf3b1/uploads/origins/14d1eb46-60aa-4a39-a046-2f6a91ca2426?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14ec583ad5c376737b5da61462bc8b0d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2878872, "client_id": 3312371, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hamonika_monika/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2878872, "client_id": 2845229, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4cce9e06/uploads/origins/f5667eeb-d700-43c5-99ca-8e6a81c8e8b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=beac2b0d279e97dbace2624629ae7887", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4cce9e06/uploads/origins/f5667eeb-d700-43c5-99ca-8e6a81c8e8b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d505ac775c025629648aad4df9216217", "src_set": ""}, "body": "羽亜もにか様\n\n初めまして、Vtuber準備中のシャルエと申します。\n羽亜もにか様の素敵なイラストを拝見し、リクエストを送信させていただきました。\n東方のイラストに一目惚れいたしました...！お顔が最高に可愛くて大好きです...！\nもしご縁をいただけましたら、私シャルエのイラストをお願いいたします。\n\n【リクエスト内容】\n羽亜もにか様の絵柄で内容はお任せでお願いいたします。\nサムネイルなどに使用させていただきたいため、可能であれば魔法帽の左右どちらかのツバが見切れない構図、もしくは猫耳全体が入った構図を希望です。\n\n【使用用途】\nYoutube、SNS、FANBOX、ネットプリント配布\n難しい内容がございましたら、別のレイヤーでお教えいただけますと大変ありがたく存じます。\n\n【納品形式】\n人物、背景、宛名等がレイヤー分けされたPSDもしくは背景透過のPNGを希望です\n\n【キャラクターについて】\n・魔法図書館で使い魔猫に囲まれて暮らす白猫\n・身長150センチ（耳を含まない）\n・猫耳としっぽがあり、人間の耳がありません\n\n【参考資料】\nhttps://drive.google.com/drive/folders/12YJ1-uparnq_s7hCfYaCiP4sSk9bZMpW?usp=sharing\n\nご検討いただけますと幸いでございます。\nどうぞよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 971233, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "千葉めぐむ", "screen_name": "chiba_megumu", "avatar_url": "https://pbs.twimg.com/profile_images/1830439145258319873/fR18hOWj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1237441009526530048/1725245676/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 0}, {"id": 1374461, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "もへみんちょ", "screen_name": "mohemohemincho", "avatar_url": "https://pbs.twimg.com/profile_images/1485975028542107649/bR_QFLVB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1415106148596817921/1660711992/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "skills": [{"genre": "art"}], "nc": 160}, {"id": 3112092, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "古ノ枝しき", "screen_name": "konoe_