していただけますと幸いです。\n\n■ 内容\n人物2人の1枚絵を希望いたします。\n\n資料（Googleドライブ）をご確認頂き、背景や構図等は、筆の乗りやすい様に\n服装なども自由に描いて頂けますととても嬉しいです。\n\n■ 使用用途\n・Youtube等で使用するサムネイルや動画内での使用\n・SNSでの投稿・利用\n\n■ 希望納品形式\n・可能な範囲で【頭部・髪の毛・手・小物などが切れていない状態】でお願いしたいです。\n\n・人物、背景、宛名等がレイヤー分けされたPNGもしくはPSDファイルを希望いたします。\n────────────\n\nhttps://drive.google.com/drive/folders/1hZlvxXjRUIHsDRR2BfKOZzOnp4M0aXOh\n\nご縁がありましたら何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1hZlvxXjRUIHsDRR2BfKOZzOnp4M0aXOh", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@porupopi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3841396, "client_id": 3350554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31f0d496/uploads/origins/c9405abe-224b-44c1-ac1a-e455865f2bee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6289902f944f6f5462488d4049054f8", "srcset": "https://si.imgix.net/31f0d496/uploads/origins/c9405abe-224b-44c1-ac1a-e455865f2bee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6289902f944f6f5462488d4049054f8, https://si.imgix.net/31f0d496/uploads/origins/c9405abe-224b-44c1-ac1a-e455865f2bee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04db8ed79be81d211d1179d97976bfc4 2x, https://si.imgix.net/31f0d496/uploads/origins/c9405abe-224b-44c1-ac1a-e455865f2bee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59862f3654e7aef6a95fe0bba24a9570 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31f0d496/uploads/origins/c9405abe-224b-44c1-ac1a-e455865f2bee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32c20e07760e744e5cd37b61890eb46f", "srcset": "https://si.imgix.net/31f0d496/uploads/origins/c9405abe-224b-44c1-ac1a-e455865f2bee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=