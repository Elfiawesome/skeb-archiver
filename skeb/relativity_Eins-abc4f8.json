んさん\nこんにちは いつも素敵なイラスト\n拝見させて頂いております。\n初めてskebを利用致します。\n至らぬ点がありましたら\n申し訳ございません。\nこの度イラストをご依頼させて頂きたく\nお声掛けさせて頂きました。\n\n詳細\n\n使用内容￤主にXのアイコン、\ndiscordのアイコンに使用させて頂きたいです\n代理詳細￤資料URL、特徴をご参照下さい\n特徴￤猫耳帽子、水色とピンクの\nオッドアイ、ピンクの目にはバツ印\n右目の下にはホクロ\n耳元にはピアス\n足元までのスーパーロング\n左手にはピンクのコルセットピアス\n右足には水色のコルセットピアス\n左足は透明で中には水、生き物達\n構図￤デフォルメ  構図参考画像参照\n背景多めよりかはキャラクター\nメインだと嬉しいです。\n\n至らぬ点がありましたら\n申し訳ございません。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1AI5Xs1C46wLZZrQNs42w6j9g5yQ48pSD", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@relativity_Eins/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 814655, "client_id": 2685266, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67c7c8d7/uploads/origins/90ce1a0b-38e4-49b0-9736-10a4455a2e49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0316cfb0235b596ec93a586ac5d8f1ab", "srcset": "https://si.imgix.net/67c7c8d7/uploads/origins/90ce1a0b-38e4-49b0-9736-10a4455a2e49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0316cfb0235b596ec93a586ac5d8f1ab, https://si.imgix.net/67c7c8d7/uploads/origins/90ce1a0b-38e4-49b0-9736-10a4455a2e49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41222a51d8181cf7f93b8fc6ba561ee2 2x, https://si.imgix.net/67c7c8d7/uploads/origins/90ce1a0b-38e4-49b0-9736-10a4455a2e49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de9a1c5c16eebfcb3203390fc5adbcd1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67c7c8d7/uploads/origins/90ce1a0b-38e4-49b0-9736-10a4455a2e49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc0eaae0fab7cc046dc1cd0010ec5638", "srcset": "https://si.imgix.net/67c7c8d7/uploads/origins/90ce1a0b-38e4-49b0-9736-10a4455a2e49?bg=%23fff&auto=format%2Ccompress&