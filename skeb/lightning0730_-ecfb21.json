てください。結婚指輪をしている彼女たちを描いてください！\n尻尾も忘れずに！蜜蝋はヤギの尻尾。カーディガンは犬のしっぽ！\n\nhttps://drive.google.com/drive/folders/1UIICDE4UxnDNLNbC-pBSLvb-fWsVOT18?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lightning0730_/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3207638, "client_id": 3331648, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e889467/uploads/origins/af6f8d3b-be87-4586-8e12-54e631c05e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=491a3ff6bcf48aab5affac5f25a6af67", "srcset": "https://si.imgix.net/4e889467/uploads/origins/af6f8d3b-be87-4586-8e12-54e631c05e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=491a3ff6bcf48aab5affac5f25a6af67, https://si.imgix.net/4e889467/uploads/origins/af6f8d3b-be87-4586-8e12-54e631c05e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fbb711029e7c03ab44f1944b28d87098 2x, https://si.imgix.net/4e889467/uploads/origins/af6f8d3b-be87-4586-8e12-54e631c05e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0d198fa0d7b84c4537cea8e7af1006b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e889467/uploads/origins/af6f8d3b-be87-4586-8e12-54e631c05e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11f205489044d560d89230199ca3c876", "srcset": "https://si.imgix.net/4e889467/uploads/origins/af6f8d3b-be87-4586-8e12-54e631c05e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11f205489044d560d89230199ca3c876, https://si.imgix.net/4e889467/uploads/origins/af6f8d3b-be87-4586-8e12-54e631c05e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=27aff3e08fe2b9a5efe81a01534ad361 2x, https://si.imgix.net/4e889467/uploa