%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=495b1c1b71581aecf28acb63d9b897c0, https://si.imgix.net/9a6c79db/uploads/origins/854819f4-0b31-4ea6-a88c-e3e63e4ae6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aaf6ebec2022963c9f0bc114d041273b 2x, https://si.imgix.net/9a6c79db/uploads/origins/854819f4-0b31-4ea6-a88c-e3e63e4ae6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44df302e7fb6227135307f8c83c225a1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a6c79db/uploads/origins/854819f4-0b31-4ea6-a88c-e3e63e4ae6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65a79bca87c60d951b06c3b26c244904", "srcset": "https://si.imgix.net/9a6c79db/uploads/origins/854819f4-0b31-4ea6-a88c-e3e63e4ae6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65a79bca87c60d951b06c3b26c244904, https://si.imgix.net/9a6c79db/uploads/origins/854819f4-0b31-4ea6-a88c-e3e63e4ae6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b52ae3b2b535a97982f91b2641cb1254 2x, https://si.imgix.net/9a6c79db/uploads/origins/854819f4-0b31-4ea6-a88c-e3e63e4ae6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ccbd3b32c57063926a2711969602e21f 3x"}, "body": "✨🦪✨様、初めまして\n\nhttps://skeb.jp/@shigehara_jet/works/5\nXでこちらのイラストを拝見し、とっても可愛らしくて惹かれたためうちの子達も描いていただきたくリクエストを送らせていただきます。\n\n描いていただきたいのは、以下のリンクの私の自創作キャラクター達です。 \n\nhttps://drive.google.com/drive/folders/1hITshv1Q-xUslHqSk_PDINp51F5O1Osd\n\nAとBは一緒に旅をしており、Cとは旅の途中で偶然知り合いました。Cは獣人の子と出会ったことがなく憧れがあったので目を輝かせています。\nAとCはこの時は気の合う女性と出会ったと思っていますが、昔知り合っていたことをこの後思い出します。(どちらにせよ好印象)\n\nA：人間の女性(20〜22)身長156cm\nB：うさぎ獣人？の男の子(7.8) 耳を含めて身長110cm\nC：人間の女性(18〜20)身長177cm＋ハイヒール\n\n使用用途は個人鑑賞のみです。\n何か不備がありましたら、お手数お掛けしますが再送お願いします。宜しくお願いします。\n\nhttps://drive.google.com/drive/folders/1hITshv1Q-xUslHqSk_PDINp51F5O