親しくなります。 \n怪しく見えるのもよろしければ。\n頼み事をよく断れない性格です。\n\n衣装はイメージを参考にして好きなように作業してください。\n(目が見える方もいいです)\n\n\nそして宛名が別のレイヤーにご記載いただけると幸いです！\n海外からリクエストを送るので下手なことがあったらすみません。\n\nhttps://drive.google.com/drive/folders/1J-0SbNJYMkQz_jGTMEEKc9jCVBbwLRId?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rewsamo/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3087996, "client_id": 2968683, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97606f18/uploads/origins/6c64d515-7cc4-49d6-9344-09407faaa71a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d35b0b4c3ea1461da8ef748fd5ff2ee8", "srcset": "https://si.imgix.net/97606f18/uploads/origins/6c64d515-7cc4-49d6-9344-09407faaa71a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d35b0b4c3ea1461da8ef748fd5ff2ee8, https://si.imgix.net/97606f18/uploads/origins/6c64d515-7cc4-49d6-9344-09407faaa71a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=179b889169298ea15e010e7e6bce41ef 2x, https://si.imgix.net/97606f18/uploads/origins/6c64d515-7cc4-49d6-9344-09407faaa71a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8007a8df988f084d961c743d8b53a95e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97606f18/uploads/origins/6c64d515-7cc4-49d6-9344-09407faaa71a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4ffbc241df8efae3f8c06f4d5ecd880", "srcset": "https://si.imgix.net/97606f18/uploads/origins/6c64d515-7cc4-49d6-9344-09407faaa71a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4ffbc241df8efae3f8c06f4d5ecd880, https://si.imgix.net/97606f18/uploads/origins/6c64d515-7cc4-49d6-9344-09407faaa71a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=20