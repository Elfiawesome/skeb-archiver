e7-6ab9-493b-a5e1-84f98a09fcf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88bffab54e4dc3dbdbc8740dbddad943, https://si.imgix.net/6bf29f07/uploads/origins/454712e7-6ab9-493b-a5e1-84f98a09fcf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97147c2aa482dc3ce972b5c296a7a1ca 2x, https://si.imgix.net/6bf29f07/uploads/origins/454712e7-6ab9-493b-a5e1-84f98a09fcf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a3ed2d5bf165c8c2435161a1cf235e17 3x"}, "body": "枝囿地獄様。こんにちは！よろしければ、私の創作カプを描いてください。\n\nhttps://drive.google.com/drive/folders/1jb6fz60Aoeu8sQUT_dA8RtOllmFs6XWI\n\n服装は軍服×ロリータなどが嬉しいですが、それじゃなくとも立ち絵以外のものにしていただければ幸いです。\nそれ以外はなんでも大丈夫です。よろしくお願いいたします。", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@edazonojigoku/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3880626, "client_id": 1116701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bde3e6c5/uploads/origins/13eb1b8b-710d-4fde-a410-ea313c70ce30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f304804551dd1a0c6b473b06c60c027", "srcset": "https://si.imgix.net/bde3e6c5/uploads/origins/13eb1b8b-710d-4fde-a410-ea313c70ce30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f304804551dd1a0c6b473b06c60c027, https://si.imgix.net/bde3e6c5/uploads/origins/13eb1b8b-710d-4fde-a410-ea313c70ce30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fd4208bba90a986f45557700f571d57 2x, https://si.imgix.net/bde3e6c5/uploads/origins/13eb1b8b-710d-4fde-a410-ea313c70ce30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00720a6058ce0d8bd8909e1e3dd9cc54 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bde3e6c5/uploads/origins/13eb1b8b-710d-4fde-a410-ea313c70ce30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea65850b13a701426652c65ed9f8d51c", "srcset": "https://si.imgix.net/bde3e6c5/uploads/origins/13eb1b8b-710d-4fde-a410-ea313c70ce30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea65850b13a701426652c65ed9f8d51c, https://si.imgix.net/bde3e6c5/uploads/origins/13eb1b8b-710d-4fde-a410-ea313c70ce30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5a1d2917fdf54d37fe1c6e73ae3e3a1 2x, https://si.imgix.net/bde3e6c5/uploads/origins/13eb1b8b-710d-4fde-a410-ea313c70ce30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4ab614c1fc26042132b3a8d2e7da71e4 3x"}, "body": "こんにちは、枝囿地獄さん！アナログ作品と雰囲気、本当に素敵です。私のオリジナルキャラクターを描いていただけませんか？可能であれば、若い頃と年老いた姿が一緒に描かれたものを見たいです。リン。身長180cm。リンは幼い頃から熱心な読書家だった。大学では医学部生だったが、途中で神学部に転部した。 卒業後、彼は跡形もなく行方不明になった。その間、シベリアの森を旅し、村々を巡りながら司祭兼田舎医として活動していた。二十年後、彼は突然かつて住んでいた街に戻ってきた。大学の親友が彼を見つけたが、彼がPTSDと戦争の鮮明な幻覚に苦しんでいることに気づいた。リクエストを読んでいただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/13A1kdvZiTk6n3wDMT-8RWGHiId_jxtry?usp=sharing", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@edazonojigoku/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3880626, "client_id": 2378340, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e541bca/uploads/origins/a6c5e6c6-5441-4310-b6ee-b0fe79786d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0c767da19d1bbd8a786a7c5afb53a00", "srcset": "https://si.imgix.net/1e541bca/uploads/origins/a6c5e6c6-5441-4310-b6ee-b0fe79786d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0c767da19d1bbd8a786a7c5afb53a00, https://si.imgix.net/1e541bca/uploads/origins/a6c5e6c6-5441-4310-b6ee-b0fe79786d38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3951c732e81bcc89a7847f11aaf8f13a 2x, https://si.imgix.net/1e541bca/uploads/origins/a6c5e6c6-5441-4310-b6ee-b0fe79786d38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3d13eeb95530e2cddc2947abc599b78 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e541bca/uploads/origins/a6c5e6c6-5441-4310-b6ee-b0fe79786d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=281e4805f4b2dbe5851b62aaca0de159", "srcset": "https://si.imgix.net/1e541bca/uploads/origins/a6c5e6c6-5441-4310-b6ee-b0fe79786d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=281e4805f4b2dbe5851b62aaca0de159, https://si.imgix.net/1e541bca/uploads/origins/a6c5e6c6-5441-4310-b6ee-b0fe79786d38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=74cb93688717ad7f6064ed7d77b3dc6c 2x, https://si.imgix.net/1e541bca/uploads/origins/a6c5e6c6-5441-4310-b6ee-b0fe79786d38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6b4daf57d2d0e91372bbb2269add4f45 3x"}, "body": "はじめまして。\n作品の雰囲気と色使いがとても好きで、ぜひ描いていただきたく依頼いたしました。\n\n■ Aki（アキ）\n霧の町に転入してきた謎めいた少年。古典文学とロックが好き。耳と唇に複数ピアス。時々、小さな傷あとが現れる不思議な体質。\n\n■ Rika（リカ）\n町の旧家の娘で、穏やかで優しいがどこか掴めない少女。保健室を手伝い、標本作りと神秘学が好き。《黒薔薇日記》という夢の記録帳を持つ。\n\n■ 世界観\n一年中、霧に包まれた小さな閉ざされた町。町外れには昭和末期の施設跡が残り、不思議な噂がある場所です。\n\nどうぞよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/ro6jz4rzm3y1pzflz7r1k/APxGHKwy42TOi1gVUhP3Rl8?rlkey=jt5c9anrp5cxgwlejq5v70gdr&st=ikvxbxqw&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 49987, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ひろにー", "screen_name": "hironi3", "avatar_url": "https://pbs.twimg.com/profile_images/1224114081772163072/wJaWHfYy.jpg", "header_url": "https:/