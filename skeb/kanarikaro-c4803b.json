.google.com/file/d/1Voy8pHd1p7j4DohQIVMWa2MHj6VNhT-j/view?usp=sharing\nこれらに似せなくても大丈夫です、今回は1からのデザインですので！\nかわいいキャラクターをおねがいします。\n\n余談にはなりますがPBWのILさんだったんですね、リーゼントたぬきは見覚えがあります。\nいずれご縁がありましたらPBWのうちの子もご依頼できたらと思います。\nでは今回は以上になります、よろしくおねがいします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 73515, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ぷも🐧", "screen_name": "pumony", "avatar_url": "https://pbs.twimg.com/profile_images/2003661287008657408/WoAgMF5w.jpg", "header_url": "https://pbs.twimg.com/profile_banners/285059334/1722075063/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1201054, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぽとわり", "screen_name": "popotowari", "avatar_url": "https://pbs.twimg.com/profile_images/1498235865298259970/cbbi8CTc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1392141413047930880/1640850409/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 45, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 2609512, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "はいにゃ＠skeb募集中", "screen_name": "hainya222", "avatar_url": "https://pbs.twimg.com/profile_images/1968209747846586368/wqnqPHOY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/910161371278352384/1701236194/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by