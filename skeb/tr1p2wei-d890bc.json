とチューブを描いて頂き、チューブの先を2人のアナルに入れてもらいたいです。\n身体の空いている部分には2人で書いたという設定の身体に落書きもお願いします。\n2人の表情ですが、衣装が髪を隠すマスクなので身バレの心配はないと吹き込まれたことにより\n吹っ切れており、2人ともガチレズセックスを楽しんでいるような感じでお願いします。\n\n以上となります。\n今回も色々と注文が多いですが、ご検討のほどよろしくお願いします。\n\nhttps://www.dropbox.com/scl/fo/ndqgmqvqan57lf0vxt9bm/ABhu_HQ_umOeWFcO5ykZLP8?rlkey=79sqx52r6tu1914kni1n6b59h&st=d2uev3fh&dl=0", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tr1p2wei/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 550057, "client_id": 94443, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e5418bc6/uploads/origins/44b2f856-389c-4d65-b973-df9f26ecdd84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3836435ae36e56a2f669f39507d8ce99", "srcset": "https://si.imgix.net/e5418bc6/uploads/origins/44b2f856-389c-4d65-b973-df9f26ecdd84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3836435ae36e56a2f669f39507d8ce99, https://si.imgix.net/e5418bc6/uploads/origins/44b2f856-389c-4d65-b973-df9f26ecdd84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d9d52c04b9f069f68c04cae6a765f0b 2x, https://si.imgix.net/e5418bc6/uploads/origins/44b2f856-389c-4d65-b973-df9f26ecdd84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6b6f9cc5ee0147b686b253b67179fce 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e5418bc6/uploads/origins/44b2f856-389c-4d65-b973-df9f26ecdd84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1efbe66dbf6db544635a6340dc490c29", "srcset": "https://si.imgix.net/e5418bc6/uploads/origins/44b2f856-389c-4d65-b973-df9f26ecdd84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1efbe66dbf6db544635a6340dc490c29, https://si.imgix.net/e5418bc6/uploads/origins/44b2f856-389c-4d