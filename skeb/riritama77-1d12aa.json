ヴィーラ=リッタ・ネル=スクリプト\n身長　180㎝\n体重　76㎏+翼の重量\n趣味　コーヒー(淹れる、飲む、豆選び等々全般)、歌\n魔法名　シプレステレイア\nサイプレス(花言葉は正義の人、不死、再生。そして死、哀悼、絶望、永遠の悲しみ)+トリテレイア(別名ブローディア。花言葉は守護)\n\n銀髪碧眼の騎士。紳士的な人物で、誰に対しても礼儀正しく上品に接する。義理堅くまじめだが、まじめすぎて振り回されたり、不器用だったりするところもある。優しく穏やかな、けれど常にどこか遠くを見ているような目をしている。\n一人称は「私」。二人称は「あなた」、三人称は「～卿」「レディ」「ミスター」。\n\n構図などはお値段の範囲でお任せとさせてください。\nもしよろしければ、お願いいたします！\n\nhttps://twitter.com/MinatoSeiryuu9/status/1683029544356446208?s=20", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riritama77/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 11431, "client_id": 347208, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/36a9e689/uploads/origins/5d265e34-6683-40b5-91cb-3de26fafa7c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cd55c33461891357e64d3d90b5bc649", "srcset": "https://si.imgix.net/36a9e689/uploads/origins/5d265e34-6683-40b5-91cb-3de26fafa7c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cd55c33461891357e64d3d90b5bc649, https://si.imgix.net/36a9e689/uploads/origins/5d265e34-6683-40b5-91cb-3de26fafa7c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe23db6fb53d774b177934a35f5eaaf1 2x, https://si.imgix.net/36a9e689/uploads/origins/5d265e34-6683-40b5-91cb-3de26fafa7c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9e0d2f6e8c74945554361934b363821 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36a9e689/uploads/origins/5d265e34-6683-40b5-91cb-3de26fafa7c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e7e1a63849bf73f86ee28ac595d773f", "srcset": "https://si.imgix.net/36a9e689/uploads/origins/5d265e34-6683-40b5-91cb-3de26fafa7c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e7e1a63849bf73f86e