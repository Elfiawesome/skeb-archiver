ix.net/866629b5/uploads/origins/f4e8e447-8321-4ffa-b4fd-dacae38f9d83?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=09e1aeca954a27b06d0765b91bc25cb9", "srcset": "https://si.imgix.net/866629b5/uploads/origins/f4e8e447-8321-4ffa-b4fd-dacae38f9d83?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=09e1aeca954a27b06d0765b91bc25cb9, https://si.imgix.net/866629b5/uploads/origins/f4e8e447-8321-4ffa-b4fd-dacae38f9d83?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=52e1f89c2f53d8cc34e438015677ed02 2x, https://si.imgix.net/866629b5/uploads/origins/f4e8e447-8321-4ffa-b4fd-dacae38f9d83?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=daad5c3deab0e02531cf6eb1da8e0276 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/866629b5/uploads/origins/f4e8e447-8321-4ffa-b4fd-dacae38f9d83?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=1ce0c87aa4520405421538ceffb09ec1", "srcset": "https://si.imgix.net/866629b5/uploads/origins/f4e8e447-8321-4ffa-b4fd-dacae38f9d83?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=1ce0c87aa4520405421538ceffb09ec1, https://si.imgix.net/866629b5/uploads/origins/f4e8e447-8321-4ffa-b4fd-dacae38f9d83?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6f5a7fe3c36921a2420a9a4899c7fc0d 2x, https://si.imgix.net/866629b5/uploads/origins/f4e8e447-8321-4ffa-b4fd-dacae38f9d83?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=20f9a6e5a0156d2df0d2f5cb2e75e5ca 3x"}, "body": "morePUT様\n初めまして、Rairi（らいり）と申します。\nよければ私の代理キャラを用いて簡易サイン+SDイラスト+簡易素材の制作をリクエストしてみたいです。\nもし名前や職業を入れる場合は以下のようにしていただければ……！\n\n名前：Rairi\n職業：Illustrator , Designer  , TRPG scenario writer\n（これらを全て一度に記すのがアレであれば、それぞれ記載した3パターンみたいな形で記載しても大丈夫です🙏）\n\n【資料内訳】\nrairi1.png：元のキャラデザです\nrairi2.png：rairi1を元に清書したもの+普段作者が書いているサインです。rairi1と異なり髪の毛のピンクリボンを忘れているため、こちらにrairi1にあった髪の毛のピンクリボンを加えたものでイメージいただければ幸いです。\nrairi3.png：下半身のイメージです（goghというアプリで作成したものです）。下半身のイラストがなかったためこちら参考にいただければ幸いです。\n\nもし値段やその他理由で無理そうであれば再送依頼いただければ幸いです、よろしくお願いいたします……！\n\nhttps://drive.google.com/drive/folders/1n1CaDsFhPi79cLJkb3LiD2AqajbLikxC?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kyarako_0220/works/316", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3487333, "client_id": 11431, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/654fb9d9/uploads/origins/b0835e9a-8bdd-4678-8d23-3acb85605824?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=8d9222242459e94d435924b2342f5464", "srcset": "https://si.imgix.net/654fb9d9/uploads/origins/b0835e9a-8bdd-4678-8d23-3acb85605824?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=8d9222242459e94d435924b2342f5464, https://si.imgix.net/654fb9d9/uploads/origins/b0835e9a-8bdd-4678-8d23-3acb85605824?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9b4fe8df4672ada89d38e1c39999e55 2x, https://si.imgix.net/654fb9d9/uploads/origins/b0835e9a-8bdd-4678-8d23-3acb85605824?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0d5ac1f3542db8760708436e4ec843d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/654fb9d9/uploads/origins/b0835e9a-8bdd-4678-8d23-3acb85605824?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=56fab98d8b9eb712ce03710838d098ee", "srcset": "https://si.imgix.net/654fb9d9/uploads/origins/b0835e9a-8bdd-4678-8d23-3acb85605824?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=56fab98d8b9eb712ce03710838d098ee, https://si.imgix.net/654fb9d9/uploads/origins/b0835e9a-8bdd-4678-8d23-3acb85605824?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f8f5083c18535f6aaced0ae8c0f2ed76 2x, https://si.imgix.net/654fb9d9/uploads/origins/b0835e9a-8bdd-4678-8d23-3acb85605824?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eb0db7ba72b81b6576b671276fe96fa6 3x"}, "body": "キャラコ様初めまして、らいりと申します。\nよければわたしとフォロワーさんのOCのエモートをお願いしたいです。\n水族館のスタッフさんです。\n（以下番号はポートフォリオ参考に記載してます）\n\n青～黒のグラデーション髪の男性：013、015（どちらもマッシュヘアでお願いします）\n紫の髪の男性：015\n\n無理のない範囲でご検討と、もし金額が不足しているようであれば再送要請いただけたら幸いです、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1rfYnExUsPQ9nYmFXDcBuhqxbiUfU8aE3?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sh1nohara/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 347208, "client_id": 11431, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e711b9e/uploads/origins/5adec0c3-7b62-4a35-8165-33baf7a2db4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f6b9e4da7a5f45f26c6237aa27af7d2", "srcset": "https://si.imgix.net/8e711b9e/uploads/origins/5adec0c3-7b62-4a35-8165-33baf7a2db4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f6b9e4da7a5f45f26c6237aa27af7d2, https://si.imgix.net/8e711b9e/uploads/origins/5adec0c3-7b62-4a35-8165-33baf7a2db4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7c807a513da2845d24469d88f49ec8f 2x, https://si.imgix.net/8e711b9e/uploads/origins/5adec0c3-7b62-4a35-8165-33baf7a2db4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6b8fdce66c71246ab241b593e529329 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e711b9e/uploads/origins/5adec0c3-7b62-4a35-8165-33baf7a2db4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cc3a2c81a0810a00e98f11fa400cd55", "srcset": "https://si.imgix.net/8e711b9e/uploads/origins/5adec0c3-7b62-4a35-8165-33baf7a2db4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cc3a2c81a0810a00e98f11fa400cd55, https://si.imgix.net/8e711b9e/uploads/origins/5adec0c3-7b62-4a35-8165-33baf7a2db4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=928c0356f4ef6fe866058f8591fea334 2x, https://si.imgix.net/8e711b9e/uploads/origins/5adec0c3-7b62-4a35-8165-33baf7a2db4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3a1ed08a0305f3e44a04d411fa1745af 3x"}, "body": "いつもお世話になっております。らいりです。\nよければ私とフォロワーさんのTRPGのPC2人組のイラストをリクエストしてみたいです。\n主線なしのほんわかした感じだと嬉しいです。デフォルメか頭身絵かはおまかせします！\n（ちなみにAGIAのHO1-FとHO2-Aの組み合わせです）\n\n以下細かく書いていますが、イメージを浮かべたり描く際の参考になれば良い気持ちで書いているため、必要な部分だけお読みいただければ……！\n\n\n【人物情報】\n\n◆氏江 澄晴\n・身長：175cm\n・瞳の色：青眼\n（iidxの「青の洞窟」のBGAに出てくる水槽のような雰囲気で、ピンク系の色が差し色で入ります）\n・髪色：青みがかった黒\n・年齢：見た目は20代半ば、中身は2歳\n・身体特徴：肌は色白め、体格は多少ちゃんとしてる程度\n　左目の目元あたり、口の右下あたりに2つずつ並んだほくろがあります\n\n普段は淡々とした、表情の動きが小さい男性です。\n表向きは水族館の副館長の仕事をしながら、UGNの支部長としても働いています。\n人外で実年齢が3歳なので、少し世間知らずな部分があり、正体を知っている近しい人と一緒の時だと少しあどけない。\n\n\n◆五百井 灯火\n・身長：180cm\n・瞳の色：茶色系\n・髪色：紫\n・年齢：26歳\n・身体特徴：肌は健康的、体格は成人男性相応にしっかりしています\n\n普段は気さくで温厚な、笑顔の時が多い男性です。\n表向きは澄晴と同じ水族館で働き、UGNのエージェントとしても働いています。\nお人好し・世話好きで、よく誰かに手を差し伸べて助けてくれる人です。\n\n\n\n【2人の関係】\n\n上司/部下という関係だったり、戦いを共にする相棒のような側面もありますが、特に家族のような関係です。\n一緒にいると落ち着くし、今は一緒にいたい、失いたくないと思っています。\n\n年齢の関係で、年の離れた兄弟のような関係でした。\n仕事中は一応上司/部下としてビジネス的に接していますが、プラベートだと家族のような距離感で、お互い、相手に（物理的にも精神的にも）踏み込まれたくない領域があまりないです。お泊りしたり、料理を共有すること、添い寝することに互いに抵抗がないです。\n\n仕事でもプライベートでも、江ノ島にいることが多く、2人で一緒にバイクや車に乗って江ノ島近郊を走ることが多いです。\n\nhttps://drive.google.com/drive/folders/1rfYnExUsPQ9nYmFXDcBuhqxbiUfU8aE3?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NrU6c/works/669", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 852565, "client_id": 11431, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80ba2d8a/uploads/origins/a7113366-51ef-4ca1-ad56-aeb847460e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f88d33a43b373080154ece99a1ac7507", "srcset": "https://si.imgix.net/80ba2d8a/uploads/origins/a7113366-51ef-4ca1-ad56-aeb847460e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f88d33a43b373080154ece99a1ac7507, https://si.imgix.net/80ba2d8a/uploads/origins/a7113366-51ef-4ca1-ad56-aeb847460e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff8eee48338d91877538be26ab03c031 2x, https://si.imgix.net/80ba2d8a/uploads/origins/a7113366-51ef-4ca1-ad56-aeb847460e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75236bf5e279144bd3b4d68aa7c40f2b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80ba2d8a/uploads/origins/a7113366-51ef-4ca1-ad56-aeb847460e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=135dd6e5b55e08abbc1ecd2eb00998d7", "srcset": "https://si.imgix.net/80ba2d8a/uploads/origins/a7113366-51ef-4ca1-ad56-aeb847460e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=135dd6e5b55e08abbc1ecd2eb00998d7, https://si.imgix.net/80ba2d8a/uploads/origins/a7113366-51ef-4ca1-ad56-aeb847460e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fce6b107b8fd8017132665e31fe42f66 2x, https://si.imgix.net/80ba2d8a/uploads/origins/a7113366-51ef-4ca1-ad56-aeb847460e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9745392882c17dec70f69dbf8d48f70b 3x"}, "body": "初めまして、らいりです。\nよろしければ私とフォロワーさんのTRPGのキャラクター2人を描いていただきたいです。\n（遊んでいるTRPGのシステムはダブルクロスという現代異能モノのTRPGで、CoCではないので、なるべく専門用語で書く部分はふわ～っと書いていますが、分かりづらかったらすみません！）\n\nぐじゃ太さんのゆるくかわいいイラストが好きなので、柔らかい雰囲気で一緒にいる感じの絵であれば頭身（デフォルメにするかどうか）も含め自由に描いて頂いて問題ないです！\n\n以下はすごく細かく書いていますが、イメージを浮かべたり描く際の参考になれば良い気持ちで書いているため、必要な部分だけお読みいただければ……！\n\n\n【人物情報】\n\n◆氏江 澄晴\n・身長：175cm\n・瞳の色：青眼（ほんのりとピンク系の色が差し色で入ります）\n・髪色：少し青みがかった黒　\n・年齢：見た目は20代半ば（表向きの年齢は25歳）、中身は3歳\n・身体特徴：肌は色白め、体格は多少ちゃんとしてる程度\n　左目の目元あたり、口の右下あたりに2つずつ並んだほくろがあります\n\n普段は淡々とした、表情の動きが小さい男性です。\n表向きは水族館の副館長の仕事をしながら、世界の平和を守るための支部長としても働いています。\n人外で実年齢が3歳なので、少し世間知らずな部分があり、正体を知っている近しい人と一緒の時だと少しあどけない。\n\n\n◆五百井 灯火\n・身長：180cm\n・瞳の色：茶色系\n・髪色：紫\n・年齢：26歳\n・身体特徴：肌は健康的、体格は成人男性相応にしっかりしています\n\n普段は気さくで温厚な、笑顔の時が多い男性です。\n表向きは澄晴と同じ水族館で働き、UGNのエージェントとしても働いています。\nお人好し・世話好きで、よく誰かに手を差し伸べて助けてくれる人です。\n\n\n\n【2人の関係】\n上司/部下という関係だったり、戦いを共にする相棒のような側面もありますが、特に家族のような関係です。お互い成人男性だけど、接し方は少しおにショタみたいな感じがあります。\n一緒にいると落ち着くし、今は一緒にいたい、失いたくないと思っています。\n\n年齢の関係で、年の離れた兄弟のような関係でした。\n仕事中は一応上司/部下としてビジネス的に接していますが、プラベートだと家族のような距離感で、お互い、相手に（物理的にも精神的にも）踏み込まれたくない領域があまりないです。お泊りしたり、料理を共有すること、添い寝することに互いに抵抗がないです。\n\n仕事でもプライベートでも、江ノ島にいることが多く、2人で一緒にバイクや車に乗って江ノ島近郊を走ることが多いです。\n\nhttps://drive.google.com/drive/folders/1rfYnExUsPQ9nYmFXDcBuhqxbiUfU8aE3?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nu_taku_/works/44", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1692463, "client_id": 11431, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f301df7/uploads/origins/97af3b2f-f809-4612-beab-479349e1ce81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16dda46b69f5ceab44d1dd3ae0d82da0", "srcset": "https://si.imgix.net/2f301df7/uploads/origins/97af3b2f-f809-4612-beab-479349e1ce81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16dda46b69f5ceab44d1dd3ae0d82da0, https://si.imgix.net/2f301df7/uploads/origins/97af3b2f-f809-4612-beab-479349e1ce81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0ec8bab67f3fbc5c9ce751e4d835d74 2x, https://si.imgix.net/2f301df7/uploads/origins/97af3b2f-f809-4612-beab-479349e1ce81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff3a0d0dbf0fab0b467bf494f415baba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f301df7/uploads/origins/97af3b2f-f809-4612-beab-479349e1ce81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68993f6333241257d46612a36b7e70dd", "srcset": "https://si.imgix.net/2f301df7/uploads/origins/97af3b2f-f809-4612-beab-479349e1ce81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68993f6333241257d46612a36b7e70dd, https://si.imgix.net/2f301df7/uploads/origins/97af3b2f-f809-4612-beab-479349e1ce81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=64f7a9b9bdc91bf3453e832a752ef189 2x, https://si.imgix.net/2f301df7/uploads/origins/97af3b2f-f809-4612-beab-479349e1ce81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=da658a203735499fc2a988e79491227e 3x"}, "body": "いつもお世話になっております、らいりです。\nよろしければ私のTRPGのキャラクター……をショタ（年齢的には4〜7歳あたりのイメージ）のすがたで描いていただきたいです。\n（この関係上資料URL先の資料は成人男性の時の姿になっております、画像資料のキャラがそのままショタにした感じの認識で大丈夫です）\n\n表情がどことなくあたたかそうな雰囲気がある感じだと嬉しいな〜って気持ちがありますが、浮かんだ構図等を優先して好きに描いていただいて大丈夫です！\n（こちらの方で浮かんだ構図の例としては「成人男性の手か指を握っていて、誰かと一緒にいる」か「クラゲかイルカのぬいぐるみ（身長に対してやや大きめ）を抱えている」あたりです。もし特に浮かばなかった場合はこのあたりのシチュエーションからお願いしたいです）\n\nきゃなさんさんの描くぽやぽやロリショタが好きなのでメッチャぽやぽやに描いていただいて構いません。\n\n以下はすごく細かく書いていますが、イメージを浮かべたり描く際の参考になれば良い気持ちで書いているため、必要な部分だけお読みいただければ……！\n\n\n【人物情報】\n◆氏江 澄晴\n・瞳の色：青眼（ほんのりとピンク系の色が差し色で入ります）\n・髪色：少し青みがかった黒\n・身体特徴：肌は色白め\n　左目の目元あたり、口の右下あたりに2つずつ並んだほくろがあります\n\n【性格とか表情のイメージ】\n表情の動きが小さめで大人しい　見た目よりも知識は知ってるけど、人と触れ合ったり経験して分かるようなものはまだまだよくわからなくて、ぽやぽやとしている\n夜の水族館で保護された（見た目は人間とほとんど変わらない）人外の男の子\n目の雰囲気が神秘的で、眼差しとかに浮世離れした（人外の片鱗が見えるような）部分がある\n少し大食らい\n\nhttps://drive.google.com/drive/folders/1TuKVKtFFRxLiSGDbMQYf22BwmgQdzy37", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gskzn/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 377921, "client_id": 11431, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b9b5d18/uploads/origins/fab38467-a065-4452-addc-a57b65c583e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddf3ef3e85b367ca8f7234b43782b6dc", "srcset": "https://si.imgix.net/2b9b5d18/uploads/origins/fab38467-a065-4452-addc-a57b65c583e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddf3ef3e85b367ca8f7234b43782b6dc, https://si.imgix.net/2b9b5d18/uploads/origins/fab38467-a065-4452-addc-a57b65c583e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6dc15efd04e0e46fbf8cb4b033c6a66 2x, https://si.imgix.net/2b9b5d18/uploads/origins/fab38467-a065-4452-addc-a57b65c583e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aba6dd3f992227d8e9bef287e619e1e0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b9b5d18/uploads/origins/fab38467-a065-4452-addc-a57b65c583e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=483bdb0cdeabf0363b92fd87636a46d3", "srcset": "https://si.imgix.net/2b9b5d18/uploads/origins/fab38467-a065-4452-addc-a57b65c583e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=483bdb0cdeabf0363b92fd87636a46d3, https://si.imgix.net/2b9b5d18/uploads/origins/fab38467-a065-4452-addc-a57b65c583e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c0671dd074884d10527ce36468a4f23 2x, https://si.imgix.net/2b9b5d18/uploads/origins/fab38467-a065-4452-addc-a57b65c583e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d79230e248547586b48e9cecd6d2b155 3x"}, "body": "いつもお世話になっております。らいりです。\nかぜのさんの描く2人組の温度感がすごく好きなので、私とフォロワーさんのTRPGのPC2人組のイラストをリクエストしてみたいです。\n二人が触れ合っているような、近しい距離の絵だと嬉しいな～と思いますが、他に思い浮かんだイメージがあったら違う感じにしてもらっても大丈夫です！！\n\n以下細かく書いていますが、イメージを浮かべたり描く際の参考になれば良い気持ちで書いているため、必要な部分だけお読みいただければ……！\n\n\n【人物情報】\n\n◆氏江 澄晴\n・身長：175cm\n・瞳の色：青眼\n（iidxの「青の洞窟」のBGAに出てくる水槽のような雰囲気で、ピンク系の色が差し色で入ります）\n・髪色：青みがかった黒\n・年齢：見た目は20代半ば、中身は2歳\n・身体特徴：肌は色白め、体格は多少ちゃんとしてる程度\n　左目の目元あたり、口の右下あたりに2つずつ並んだほくろがあります\n\n普段は淡々とした、表情の動きが小さい男性です。\n表向きは水族館の副館長の仕事をしながら、UGNの支部長としても働いています。\n人外で実年齢が2歳なので、少し世間知らずな部分があり、正体を知っている近しい人と一緒の時だと少しあどけない。\n\n\n◆五百井 灯火\n・身長：180cm\n・瞳の色：茶色系\n・髪色：紫\n・年齢：26歳\n・身体特徴：肌は健康的、体格は成人男性相応にしっかりしています\n\n普段は気さくで温厚な、笑顔の時が多い男性です。\n表向きは澄晴と同じ水族館で働き、UGNのエージェントとしても働いています。\nお人好し・世話好きで、よく誰かに手を差し伸べて助けてくれる人です。\n\n\n\n【2人の関係】\n\n上司/部下という関係だったり、戦いを共にする相棒のような側面もありますが、特に家族のような関係です。\n一緒にいると落ち着くし、今は一緒にいたい、失いたくないと思っています。\n\n年齢の関係で、年の離れた兄弟のような関係でした。\n仕事中は一応上司/部下としてビジネス的に接していますが、プラベートだと家族のような距離感で、お互い、相手に（物理的にも精神的にも）踏み込まれたくない領域があまりないです。お泊りしたり、料理を共有すること、添い寝することに互いに抵抗がないです。\n\n仕事でもプライベートでも、江ノ島にいることが多く、2人で一緒にバイクや車に乗って江ノ島近郊を走ることが多いです。\n\nhttps://drive.google.com/drive/folders/1rfYnExUsPQ9nYmFXDcBuhqxbiUfU8aE3?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 5491, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "⭐️のびのびえいかさん🌙", "screen_name": "akermaker86", "avatar_url": "https://pbs.twimg.com/profile_images/1510606452544573448/DjvK2N9I.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3166117897/1650342226/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id": 7088, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "HSNG", "screen_name": "hsng", "avatar_url": "https://pbs.twimg.com/profile_images/1490496894983757826/0lKcOz9z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/761461162382798848/1604937870/1500x500", "app