4380e0fb965ef9be4d408988, https://si.imgix.net/8db5833c/uploads/origins/15ba4a11-bc93-4f83-8397-4c7a32c84989?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d82031ba0836203b6509f1eff375123 2x, https://si.imgix.net/8db5833c/uploads/origins/15ba4a11-bc93-4f83-8397-4c7a32c84989?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=189c2a53783b3af15280067dadefac56 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8db5833c/uploads/origins/15ba4a11-bc93-4f83-8397-4c7a32c84989?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3499b86399c07537ea2446698370f02c", "srcset": "https://si.imgix.net/8db5833c/uploads/origins/15ba4a11-bc93-4f83-8397-4c7a32c84989?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3499b86399c07537ea2446698370f02c, https://si.imgix.net/8db5833c/uploads/origins/15ba4a11-bc93-4f83-8397-4c7a32c84989?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c72c61609edcd47cabf102c1c845e96d 2x, https://si.imgix.net/8db5833c/uploads/origins/15ba4a11-bc93-4f83-8397-4c7a32c84989?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a417fd6180a20842ab1e1c18274af505 3x"}, "body": "らいりさんこんにちは。\nリクエストできると思うと誰にしようかと悩みましたが、やはり決めきれず3人お願いしたいと思います。\n全員自分のCoC探索者です。\n\n①コードネーム「魔女」本名景由瑞 ※かげゆ みず(29歳)\nものすごい甘党でペットボトルのミルクティーが仕事のパートナーです。\nオシャレマッシュで177cm/58kgの細身。服装も気を使います。神経質で割とすぐキレます。\n\n②コードネーム「King」本名ジュリアン(28歳)\nものすごい大食で195cm/105kgのマッチョです。甘いものもしょっぱいものも食べます。\n髪色が緑で後ろがボーダー刈り上げのハーフアップです。大らかでデリカシーを糧に筋肉を育てました。\n\n③榎木まはる(20歳)\nものすごい弱運の一般人です。148cm/40kgの小柄な女の子。ややオーバーサイズの古着やプチプラ服を着ますがそこそこにおしゃれ。\n貧乏が長かったので工夫して料理を作るのが得意です。苦労性ですがその分人を取りなすのが得意です。\n\nこの3人で、上から順に大きなフルーツパフェ、骨つきチキンレッグ、四角いグラタン皿いっぱいのラザニアを持たせて並べてもらえないでしょうか？\n①②③と並べて、でかくて笑顔の②ジュリアンを①景由がやや嫌がっているような顔だと嬉しいです！小さい③まはるは「ラザニア一緒に食べよ！」と笑って2人を見上げるような位置でお願いします。\n\nたくさんお願いをしてしまったので、難しかったらキャンセルして下さいませ。\n急ぎませんので、らいりさんの絵で気に入ってよく動かす3人を見せてもらえたら幸いです。\n\n3人の詳しい資料はこちら。\nhttps://drive.google.com/drive/folders/1-2fl1L_vOLmhk3o3NLlfnq5-35Nci1jy\n\nよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riritama77/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9ff0790c/uploads/origins/bbc504e1-d641-43ed-be8d-b224e16b7168?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2db08232a69e93eeedc8baf3ab2cb2fc", "srcset": "https://si.imgix.net/9ff0790c/uploads/origins/bbc504e1-d641-43ed-be8d-b224e16b7168?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2db08232a69e93eeedc8baf3ab2cb2fc, https://si.imgix.net/9ff0790c/uploads/origins/bbc504e1-d641-43ed-be8d-b224e16b7168?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c40a23c8345e66b100fe14afd25236c 2x, https://si.imgix.net/9ff0790c/uploads/origins/bbc504e1-d641-43ed-be8d-b224e16b7168?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=898a7676336a291a96dd32015ff39ca6 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 11431, "client_id": 928539, "nc": 1}, {"path": "/@riritama77/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 11431, "client_id": 7263, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/963ecde1/requests/237977_3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=891d13f2b4aea0a48bf233434649e1e8", "srcset": "https://si.imgix.net/963ecde1