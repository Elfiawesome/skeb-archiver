re": false}, {"path": "/@harumiyaaa/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1155031, "client_id": 1561782, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ef8af2a/uploads/origins/168ec84c-120b-4439-a618-7a9e320cef06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca879fc4a41282575d9df02b8a23c771", "srcset": "https://si.imgix.net/7ef8af2a/uploads/origins/168ec84c-120b-4439-a618-7a9e320cef06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca879fc4a41282575d9df02b8a23c771, https://si.imgix.net/7ef8af2a/uploads/origins/168ec84c-120b-4439-a618-7a9e320cef06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b28b71e75aefdb66b6f1a80241803ca9 2x, https://si.imgix.net/7ef8af2a/uploads/origins/168ec84c-120b-4439-a618-7a9e320cef06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bebf3e04257a1d1be1d567c433de33b5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ef8af2a/uploads/origins/168ec84c-120b-4439-a618-7a9e320cef06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8db6dda5b5cc429aaa22274659a66fea", "srcset": "https://si.imgix.net/7ef8af2a/uploads/origins/168ec84c-120b-4439-a618-7a9e320cef06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8db6dda5b5cc429aaa22274659a66fea, https://si.imgix.net/7ef8af2a/uploads/origins/168ec84c-120b-4439-a618-7a9e320cef06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0b04e112b2d4e6371e103454d6d6048f 2x, https://si.imgix.net/7ef8af2a/uploads/origins/168ec84c-120b-4439-a618-7a9e320cef06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=003b82abae8e2caaa2f974ef3627665a 3x"}, "body": "いつも素敵なイラストを拝見しています。凛々しく華がある絵柄がとても好きです。\nご都合が合いましたら、下記のリクエストでご検討お願いします。\n\n■サファイアをモチーフにした剣を構える王子\n\n私は誕生石がサファイアなのですが、アクセサリーで気に入るものが見つからず…。それならばと、代わりに誕生石イメージの絵が見たいと思い、リクエストです。\n\n【おおまかなイメージ】\n・ファンタジー世界風\n・剣を手にした凛々しく爽やかな王子\n（擬人化ではなく、人間の青年。年齢は18〜20歳くらい）\n・剣を構えている、または剣を振るっている構図など（微笑を浮かべた表情だと更に好み）\n・服装や剣、または周囲などがサファイアをモチーフした蒼色イメージ\n\n厳密に上記の希望に沿わなくても大丈夫です。基本的にはお任せで。\n楽しんで描いてもらえたら嬉しいです。\n\n【使用目的】\n個人での観賞用。\n\n以上です。\nよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@harumiyaaa/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3d17ced1/uploads/origins/e4cd4ab4-08a7-4632-88b7-74e4b4150cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13890f847e98ead360076b94bb4428f9", "srcset": "https://si.imgix.net/3d17ced1/uploads/origins/e4cd4ab4-08a7-4632-88b7-74e4b4150cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13890f847e98ead360076b94bb4428f9, https://si.imgix.net/3d17ced1/uploads/origins/e4cd4ab4-08a7-4632-88b7-74e4b4150cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f0b973396cf601ce04d9a0d47fc97abf 2x, https://si.imgix.net/3d17ced1/uploads/origins/e4cd4ab4-08a7-4632-88b7-74e4b4150cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2511c7e5b2de3d714b75455dea8c32b7 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1155031, "client_id": 603778, "nc": 144}, {"path": "/@harumiyaaa/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1155031, "client_id": 680955, "vtt_url": null, "thumbn