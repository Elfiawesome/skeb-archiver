f35e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d817bfe888ef44298a21f6ad8a867333", "srcset": "https://si.imgix.net/5174ab55/uploads/origins/c558cbed-e631-432b-b61c-2eb17f3f35e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d817bfe888ef44298a21f6ad8a867333, https://si.imgix.net/5174ab55/uploads/origins/c558cbed-e631-432b-b61c-2eb17f3f35e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4479d5e9a99dd0cecc4442c0bcf72e65 2x, https://si.imgix.net/5174ab55/uploads/origins/c558cbed-e631-432b-b61c-2eb17f3f35e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4ee9abcd35a2863f4c528c1021f6392 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5174ab55/uploads/origins/c558cbed-e631-432b-b61c-2eb17f3f35e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf14dae31eb4d09acec33f145b9e93b0", "srcset": "https://si.imgix.net/5174ab55/uploads/origins/c558cbed-e631-432b-b61c-2eb17f3f35e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf14dae31eb4d09acec33f145b9e93b0, https://si.imgix.net/5174ab55/uploads/origins/c558cbed-e631-432b-b61c-2eb17f3f35e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=34ace931be62dc66cb176a0fef7efebe 2x, https://si.imgix.net/5174ab55/uploads/origins/c558cbed-e631-432b-b61c-2eb17f3f35e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1bfbcc592cd730c99f92a0b9cec82dcf 3x"}, "body": "はじめまして、先生の作品は超素晴らしいです！\n\nもしよろしければ、私のTRPGキャラクターたちを描いていただけないでしょうか？\nフォルダ内にある S（ソレル／茶色の髪のキャラクター） を中心に描いていただけたら嬉しいです。\n\n描くキャラの組み合わせやパロ設定は先生のお好きなように選んでいただいて構いません。私は雑食なので（……）、キャラ同士の関係性が少しでも感じられれば嬉しいです！\n\nこのような作品のように、組み合わせページとして描いていただけたら、とても嬉しいです！\nhttps://skeb.jp/@noge__/works/3\n\n可能であれば、別レイヤーにサインを入れたpsdファイルをご提供ください。また、先生が下書きや未使用のrkgkなどを作品に残しておいてくださると、アイデアの変遷を見ることができるのでありがたいです！\n\nご依頼をお読みいただき、ご検討くださり誠にありがとうございます！お気に召さない場合は、遠慮なく直接キャンセルしてください。\nhttps://drive.google.com/drive/folders/1yymMirao05l_Iv5bRaRre1dSiOHkyFTU?usp=sharing\n\nhttps://drive.google.com/drive/folders/1G2yldDUusWRmjXtyBZvMCJr11FJAh5xc?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@noge__/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2747083, "client_id": 3561068, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1722b0ee/uploads/origins/59c85697-a00e-430a-8c0d-48ebe10d6316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2928ccccc435a9cfde1fb4c2c8ca62ae", "srcset": "https://si.imgix.net/1722b0ee/uploads/origins/59c85697-a00e-430a-8c0d-48ebe10d6316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2928ccccc435a9cfde1fb4c2c8ca62ae, https://si.imgix.net/1722b0ee/uploads/origins/59c85697-a00e-430a-8c0d-48ebe10d6316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f799c1ab3b73a0d385b865c374c5ff1 2x, https://si.imgix.net/1722b0ee/uploads/origins/59c85697-a00e-430a-8c0d-48ebe10d6316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=745f6a3df994f9615f92f3fbc4325f20 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1722b0ee/uploads/origins/59c85697-a00e-430a-8c0d-48ebe10d6316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=166b0e38e24a027c879829870796fc8d", "srcset": "https://si.imgix.net/1722b0ee/uploads/origins/59c85697-a00e-430a-8c0d-48ebe10d6316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=166b0e38e24a027c879829870796fc8d, https://si.imgix.net/1722b0ee/uploads/origins/59c85697-a00e-430a-8c0d-48ebe10d6316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c1915e3113639996e28c36055c3e9165 2x, https://si.imgix.net/1722b0ee/uploads/origins/59c85697-a00e-430a-8c0d-48ebe10d6316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=766913bdda81f3cc6cf08c8ffe13814f 3x"}, "body": "はじめまして！\n「オタクが好きなギャル♂」がリメイク前から大好きで、あの作品に出会って以来 pixivでもTwitterでも先生を追わせていただいております。これからの作品も楽しみにしています！\n\n\nリクエスト内容としては、私と友人のOCを描いていただきたいです。\n\n明綴 (めいと)\n20代後半、194cm\nタレ目ツリ眉、ハーフアップ\n右耳のみにピアスを開けています。\n愛想は悪い方ですが、雪兎の前ではよく笑います。\n\n雪兎 (ゆきと)\n20代後半(明綴と同い年)、184cm\nツリ目下げ眉、ポニーテール\n青い目に一点だけ赤が混じっている、特徴的な目をしています。落ち着きのある穏やかな性格ですが、明綴と一緒だと子供のようにふざけて遊びます。\n\n二人は幼馴染で、親友で、終焉世界を旅しています。互いが誰よりも大切で、終わった世界でも前を向いて歩いています。絵に関しての指定は特にありません、任せる形になってしまって申し訳ありませんが、先生の描きやすいように描いてもらえると嬉しいです！\n\nもしご縁があれば！よろしくお願いします。\n\nhttps://drive.google.com/file/d/1lJFZogLJJHwxkI4UunuW4dTHsdsSa4vN/view?usp=drivesdk", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@noge__/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2747083, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ae8d020/uploads/origins/23950fe1-50a1-4f50-9c18-d3fa1fa84813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01e8e73a7c0ea6faacc3772f7790b5c3", "srcset": "https://si.imgix.net/0ae8d020/uploads/origins/23950fe1-50a1-4f50-9c18-d3fa1fa84813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01e8e73a7c0ea6faacc3772f7790b5c3, https://si.imgix.net/0ae8d020/uploads/origins/23950fe1-50a1-4f50-9c18-d3fa1fa84813?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb0a68889de5aa636a86404ff0164c7f 2x, https://si.imgix.net/0ae8d020/uploads/origins/23950fe1-50a1-4f50-9c18-d3fa1fa84813?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ebe3b1dd6a9757cd3c364d4252376ef 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ae8d020/uploads/origins/23950fe1-50a1-4f50-9c18-d3fa1fa84813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=185727bae84a91635efbd961ad9c8875", "srcset": "https://si.imgix.net/0ae8d020/uploads/origins/23950fe1-50a1-4f50-9c18-d3fa1fa84813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=185727bae84a91635efbd961ad9c8875, https://si.imgix.net/0ae8d020/uploads/origins/23950fe1-50a1-4f50-9c18-d3fa1fa84813?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b771636a6e10d72f6f0147c6aef57d11 2x, https://si.imgix.net/0ae8d020/uploads/origins/23950fe1-50a1-4f50-9c18-d3fa1fa84813?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=96d2e7ea65bdcf05fe8fe682ba61f09e 3x"}, "body": "こんにちは！以前からあなたの素晴らしいイラストを拝見しており、大変感銘を受けていました。今回、私が創作したオリジナルキャラクター2名のイラストをお願いしたく、ご連絡いたしました。\n\n茶髪のキャラクター（メンター）\n• 性格：行動派で社交的な男性。洗練されたユーモアのセンスを持ち、普段は気取らない、さりげない笑顔を浮かべていることが多い。本心を隠すために、冗談や軽口を交えるのが癖だ。\n• 経歴：元は辺境の傭兵だったが、後に帝国の特殊作戦部隊にスカウトされ、メンターとして活動している。\n• 立場（守護者）：既存の体制を守る者。現状には欠点があるものの、急進的な改革は事態を悪化させ、完全な混沌を招くだけだと信じている。\n金髪のキャラクター（見習い）\n• 性格：冷静沈着で、「クールな外見、温かい内面」（クールデレ）な性質を持つ。本当に信頼できる相手にのみ、優しい一面を見せる。\n• 経歴：最優秀の成績で特殊作戦部隊に入隊した若き貴族であり、茶髪の指導者の弟子となった。\n• 立場（改革派）：改革派の一員。帝国は根底から腐敗しており、旧体制を完全に一掃してこそ新時代が到来すると信じている。\n関係性の展開\n初期段階：師弟関係＆戦友\n• 関係性：互いの生存を頼りにし合う戦友同士。\n• 交流：師匠は弟子をからかったり冗談を言ったりするのが好きだが、戦場では密かに彼を守っている。弟子は従順に見えるが、密かに師匠の戦闘技術を観察し、学んでいる。二人は一言も交わさずに、戦場において完璧な連携を見せる。\n• 日常の一コマ：キャンプファイヤーのそばで休んでいる時、師匠は武器を磨きながら辺境の物語を語る。弟子は黙っているが、集中して耳を傾けている。\n後期：対立する陣営と元盟友\n• 関係性：やがて思想の相違から離反し、宿敵となる。\n• 交流：出会うたびに冷笑と鋭い対立が交錯する。立場は正反対だが、師弟だった頃の記憶は消せない。生死を分ける瞬間、彼らの無意識は依然として同期し、互いの背中をカバーし合う。\n• 戦闘の詳細：戦場で対峙すると、両者の刃は互いの急所を正確に狙いながら止まる。そして、想像しうる限り最も冷酷な口調で、互いの理想を嘲り合う。\n核心的な絆\n互いの戦闘スタイルを深く理解しているため、本人以上に相手の次の動きを予測できてしまうことさえある。\n\n描く上でインスピレーションが湧く時代や雰囲気をお選びください。\nご検討いただき、誠にありがとうございます。\n\nhttps://drive.google.com/drive/folders/14WhHziZo_vrdtRp7YzDubyO0EhRJT