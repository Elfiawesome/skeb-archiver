b/uploads/origins/63a6b86f-a1d6-4dbd-b466-7cdaa8e78854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fb042941efed8864d7632e39afcc2f5", "srcset": "https://si.imgix.net/d1577feb/uploads/origins/63a6b86f-a1d6-4dbd-b466-7cdaa8e78854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fb042941efed8864d7632e39afcc2f5, https://si.imgix.net/d1577feb/uploads/origins/63a6b86f-a1d6-4dbd-b466-7cdaa8e78854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7fb67c4abdb7a3d3348ac374a2c5773 2x, https://si.imgix.net/d1577feb/uploads/origins/63a6b86f-a1d6-4dbd-b466-7cdaa8e78854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a4a561fa4f3c23667640d30ba580195 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1577feb/uploads/origins/63a6b86f-a1d6-4dbd-b466-7cdaa8e78854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=027756d2080c510e805a07177008f488", "srcset": "https://si.imgix.net/d1577feb/uploads/origins/63a6b86f-a1d6-4dbd-b466-7cdaa8e78854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=027756d2080c510e805a07177008f488, https://si.imgix.net/d1577feb/uploads/origins/63a6b86f-a1d6-4dbd-b466-7cdaa8e78854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d91af8053346fa2a271cf4764d6d3a78 2x, https://si.imgix.net/d1577feb/uploads/origins/63a6b86f-a1d6-4dbd-b466-7cdaa8e78854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=943afb6f0466cef8ca3ee3ad5fb0b851 3x"}, "body": "化月のここさん　こんばんは！\nいつもお世話になっております。\nこの度はアピールに嬉しいお言葉ありがとうございました…！\n\n化月さんに描いていただきたいものいっぱいある～～～！！と思いつつ、この度は是非是非自創作キャラクターのリゼットとエクルを描いていただけないでしょうか？\n\n【リゼット】\n24歳。だいたい160~165cmくらい。緑髪/金眼　軍人\nエクルのことをとても大切にしています。\n睫毛ばしばしのキャラクターなので、設定画よりも強調していただいても大丈夫です！\n（化月さんの描かれる睫毛長い美人さんが好きなので…）\n\n【エクル】\n11歳。だいたい147~150cmくらい。\n金髪/青目\n自分を助けてくれたリゼットのことがとっても大好きです。\n今と変わらず甘いものが好き。\n\n【2人の距離感】\nエクルがリゼットの服の裾を掴んでいることもあれば、リゼットがエクルを膝の上に乗せることもある……ので距離近くても、ほどほどでも大丈夫です！\n\nもしよろしければなのですが、この2人に【軍服風の衣装（ゴシック・ロリータ路線）】または【パーティドレス・ワンピース(黒/白)】を着せていただけないでしょうか…！\n構図やポーズなどはお任せいたします。\n\n衣装はこんな感じの雰囲気がいいな～というラフを用意したので、そちらを元にしていただいても構いませんし、化月さんに一から自由にデザインしていただけてもとっても嬉しいです！\nあくまでシルエットや色合いのイメージや案を示したものなので、装飾やアレンジなどいっぱい加えていただけたらありがたいです…！\n\n上記の指定が難しい場合は通常衣装で描いていただけますと幸いです…！！\n\nとっても長くなってしまいましたが、化月さんの作風やイラストが大好きなので、お好きなように描いていただけたら、いちばん嬉しいです！\n\n資料は以下のURLにまとめてあります。\nhttps://drive.google.com/drive/folders/1o7V-kSjG0WpAS4xfvjAtEJaL3aXmB-B2?usp=drive_link\n\nどうぞよろしくお願いいたします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bakeduki_nokoko/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2564921, "client_id": 796769, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92382e1a/uploads/origins/51c4e7fe-1d9e-43be-8205-a8594b84d29b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=137a8cd74c3f0516b4b1c9817ca1bd5b", "srcset": "https://si.imgix.net/92382e1a/uploads/origins/51c4e7fe-1d9e-43be-8205-a8594b84d29b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=137a8cd74c3f0516b4b1c9817ca1bd5b, https://si.imgix.net/92382e1a/uploads/origins/51c4e7fe-1d9e-43be-8205-a8594b84d29b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c891ad6bd4bf50e1c02a27b9f7d32844 2x, https://si.imgix.net/92382e1a/uploads/origins/51c4e7fe-1d9e-43be-8205-a8594b84d29b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=496bde97ddae9c25283146cc43426c90 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92382e1a/uploads/origins/51c4e7fe-1d9e-43be-8205-a8594b84d29b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dff33fd53135386beb9c5494e8b834f0", "srcset": "https://si.imgix.net/92382e1a/uploads/origins/51c4e7fe-1d9e-43be-8205-a8594b84d29b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dff33fd53135386beb9c5494e8b834f0, https://si.imgix.net/92382e1a/uploads/origins/51c4e7fe-1d9e-43be-8205-a8594b84d29b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f5709d90bfb61bec046ee6632631fbf1 2x, https://si.imgix.net/92382e1a/uploads/origins/51c4e7fe-1d9e-43be-8205-a8594b84d29b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7930213ba524594a4e7033c480a9dd24 3x"}, "body": "こんにちは！\n化月のここさんの美麗なCPイラストや可愛いミニキャラ絵をいつも拝見し憧れておりました！\nもし良ければ創作キャラを描いて頂きたくリクエスト失礼致します。\n\n★キャラクター\n可能でしたら、CPでお願いしたいです。\n①金髪緑目、長髪をポニーテールにしたジト目の男、少し大人びた顔でクールだが皮肉屋な性格\nキャラシ↓\nhttps://twitter.com/amaichocososaku/status/1621142915950198786?s=46&t=XUt3-Xu1EBqeXCnbOSCDSg\n\n②明るいブラウンのロングヘア、茶色眼のツンデレ少女\nキャラシ↓\nhttps://twitter.com/amaichocososaku/status/1612124358235009027?s=46&t=XUt3-Xu1EBqeXCnbOSCDSg\n\n★リクエスト内容\nジューンブライドのイラストをお願いしたいです。\n喧嘩が多く、大人びた雰囲気の2人です。\n背景はおまかせ致します。\n髪型は必要に応じてアレンジ頂いて大丈夫です。\n衣装も自分でデザインしたものが無いため、お手数ですがおまかせでお願い出来たら嬉しいです。簡単なデザインでも問題ございません。\n\n★使用用途\n個人的な観賞用ですが、A5以下の本(頒布無しの自分用です)に収録させて頂く可能性があります。\nもし問題があればリクエストキャンセルして頂いても大丈夫です。\nご検討頂ければ幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bakeduki_nokoko/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2564921, "client_id": 705208, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73d27c91/uploads/origins/e646116b-8751-4252-b2e1-f6558439a8a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc2e866030cae064caa8a329ac79fb8b", "srcset": "https://si.imgix.net/73d27c91/uploads/origins/e646116b-8751-4252-b2e1-f6558439a8a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc2e866030cae064caa8a329ac79fb8b, https://si.imgix.net/73d27c91/uploads/origins/e646116b-8751-4252-b2e1-f6558439a8a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf191af313a5031f14746189b0d51869 2x, https://si.imgix.net/73d27c91/uploads/origins/e646116b-8751-4252-b2e1-f6558439a8a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64f877c01957976b20bb6dddee0f8a1b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73d27c91/uploads/origins/e646116b-8751-4252-b2e1-f6558439a8a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79a04e9b5400e783c9f1df1a7efa99d8", "srcset": "https://si.imgix.net/73d27c91/uploads/origins/e646116b-8751-4252-b2e1-f6558439a8a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79a04e9b5400e783c9f1df1a7efa99d8, https://si.imgix.net/73d27c91/uploads/origins/e646116b-8751-4252-b2e1-f6558439a8a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9c18d5940df59fac36959e6b9e9643b 2x, https://si.imgix.net/73d27c91/uploads/origins/e646116b-8751-4252-b2e1-f6558439a8a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=855a9fcc846679ef0481d476746023f7 3x"}, "body": "こんにちは！  私はあなたの絵の色に興味を持ったので、私のキャラクターであるミルリーフ(milreaf)とカツヒロを描いてもらえたら嬉しいです！\n\nhttps://toyhou.se/117016.milreaf-nakamura/gallery\nhttps://toyhou.se/117872.katsuhiro-hisakawa/gallery\n\nストライプのドレス姿も、ホストガール姿も、自由に描いてください。しかし、縞模様のドレスの衣装では、彼女は科学者であることをより意識しています。彼女は、恋に落ちるための薬を作るために薬草学を研究しています。男の子は、彼女の実験台で、（やや）不本意ながら彼女の薬をすべて試してみるのです。ポーションを作っているところ、試しているところなど、自由に描いてください。\n\nホストガール姿で描くくらいなら、胸は上半身からこぼれるくらいに大きく膨らませてください。彼女は仕事中も容赦なくいじめるのが好きなんです。\n\nそれらのシナリオがうまくいかない場合は、彼らは氷の魔女と火病患者なので、氷/火の魔法を扱うことも選択肢の一つです。\n\nご検討のほど、よろしくお願いいたします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bakeduki_nokoko/works/