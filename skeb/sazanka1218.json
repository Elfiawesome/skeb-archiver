et/f90e4eaa/uploads/origins/c3e5d95d-7474-43b6-a3b4-f164110d8b18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df273faa87054f48d869da96d2289ab8", "srcset": "https://si.imgix.net/f90e4eaa/uploads/origins/c3e5d95d-7474-43b6-a3b4-f164110d8b18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df273faa87054f48d869da96d2289ab8, https://si.imgix.net/f90e4eaa/uploads/origins/c3e5d95d-7474-43b6-a3b4-f164110d8b18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a85a523636fa2239b555041706c35660 2x, https://si.imgix.net/f90e4eaa/uploads/origins/c3e5d95d-7474-43b6-a3b4-f164110d8b18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1a6527669c5b94f4beb918da062efcca 3x"}, "body": "こんにちは！お会いできて嬉しいです！あなたの百合アート、本当に素敵です！私と友達のオリジナルキャラをカップルとして描いていただけませんか？（恋愛関係で）\n「キョミ」-- https://www.deviantart.com/stash/2zvvwuqg95l 狐の化身であり、服飾デザイナーです。「メリー」-- https://www.deviantart.com/stash/2191oazkrh8m 悪魔キャラクターです。 \nこのシチュエーションでは、メリーが主導する感じでお願いします（でも、もしやりたくないなら、二人は入れ替え可能なので、ご自身の解釈で描いてください）。曖昧な説明でごめんなさい。二人の服装は何でも大丈夫です！二人用に何か考えていただけたら嬉しいです。ご検討ありがとうございます！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sazanka1218/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2243875, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8deab594/uploads/origins/2a932da2-4959-40b1-bd6f-23fcb36595d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e811468a9e37a3afb877a1a1dcd5093f", "srcset": "https://si.imgix.net/8deab594/uploads/origins/2a932da2-4959-40b1-bd6f-23fcb36595d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e811468a9e37a3afb877a1a1dcd5093f, https://si.imgix.net/8deab594/uploads/origins/2a932da2-4959-40b1-bd6f-23fcb36595d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b62ca2eda8b6efa758dfc243c2d7d33e 2x, https://si.imgix.net/8deab594/uploads/origins/2a932da2-4959-40b1-bd6f-23fcb36595d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7dc8769d9f417515125494f98956be51 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8deab594/uploads/origins/2a932da2-4959-40b1-bd6f-23fcb36595d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94826c6502383ff7aed7efed11b98e3e", "srcset": "https://si.imgix.net/8deab594/uploads/origins/2a932da2-4959-40b1-bd6f-23fcb36595d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94826c6502383ff7aed7efed11b98e3e, https://si.imgix.net/8deab594/uploads/origins/2a932da2-4959-40b1-bd6f-23fcb36595d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=58b6bd8007b19f53b807de0efa550187 2x, https://si.imgix.net/8deab594/uploads/origins/2a932da2-4959-40b1-bd6f-23fcb36595d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bc5ca0406e4dd6a5d80ecbbc05c8ba29 3x"}, "body": "こんにちは、前回のもとても気に入りました。すぐにまたお願いして迷惑をかけていないといいのですが。ホロライブのロボ子さん（Roboco-san）と水宮枢（Mizumiya Su）の、愛情あふれるSFWな百合シーンをもう1つ描いてください。今回は構図を変えて、枢がロボコさんの大きな胸や他の部分を愛撫しているシーンをお願いします。\n両者とも目を開けている状態でお願いします。構図上可能であれば、サイズ差（枢が小さい）がわかるように描けますか？ 全体の雰囲気やスタイルは、こちら（https://www.pixiv.net/en/artworks/140051297）と似た感じが良いのですが、キャラクターサイズなどが異なるため、最適な角度や方向をお選びください。よろしくお願いします！", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sazanka1218/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2243875, "client_id": 2698776, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a6537ee8/uploads/origins/5c9c4a86-facb-4a6f-830f-55c188e7fde7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce9fdf4e