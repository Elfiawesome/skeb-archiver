大丈夫でしたら以下の通り（無理なようでしたら①と④を優先でお願いします）又、できればどの表情もアーボックは通常色と色違いをお願いします。\n①締め付けられて涙目で苦しんでいる（目は閉じています）\n②苦しんでいるけど若干感じていて赤面になっている（目は閉じています）\n③苦しいけど若干気持ちよくて恥ずかしがっている（目は開けています）\n④嬉しくて締め付けられているのに笑っている（目は開けています）", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@satotuki_tiyo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 455139, "client_id": 573461, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cdac6ebb/uploads/origins/e66ea842-68eb-4580-979b-1c67113e0a66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9c7df3ef0115a92d164c9165fb2cc98", "srcset": "https://si.imgix.net/cdac6ebb/uploads/origins/e66ea842-68eb-4580-979b-1c67113e0a66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9c7df3ef0115a92d164c9165fb2cc98, https://si.imgix.net/cdac6ebb/uploads/origins/e66ea842-68eb-4580-979b-1c67113e0a66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c851d68a3719d82f4f2dd165fe5956b1 2x, https://si.imgix.net/cdac6ebb/uploads/origins/e66ea842-68eb-4580-979b-1c67113e0a66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a685b16235622c025ec4c0bee86ea72 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cdac6ebb/uploads/origins/e66ea842-68eb-4580-979b-1c67113e0a66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc4d05fb92271ea22b2c1a674ce07c89", "srcset": "https://si.imgix.net/cdac6ebb/uploads/origins/e66ea842-68eb-4580-979b-1c67113e0a66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc4d05fb92271ea22b2c1a674ce07c89, https://si.imgix.net/cdac6ebb/uploads/origins/e66ea842-68eb-4580-979b-1c67113e0a66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32e952a57fec1af78588