て僕のも舐めてとアソコをフェラさせて草タイプ特有の青臭く苦い精液をエモンガに飲ませたのちに挿入して孕め！エモンガお姉ちゃん僕の精液で妊娠しちゃえ！と中に出されるエモンガ。\nチラーミィと行為を終えたあとの設定でズルックの特訓をまかされてズルックと二人きりでなんであたしがとめんどさがってまあこいつは強くないしとっと終わらせようと思っていたら電気がでなくてあれ？と思ったらチラーミィにアンコールかけられたんだった！と思い出してうそ！？まだこうか続いてたの！？と驚くエモンガ、そしてとりあえずメロメロを打とうとしたがなんとズルックもチラーミィ同様メンタルハーブを持っていてメロメロが通用せず姉さんメロメロ対策はバッチですよとズルックに言われて攻撃手段の内容でどうしたんすか姉さん？とズルックに聞かれてえーっととあせあせエモンガに強烈なづつきを繰り出すエモンガ、うそこの子もこんなにつよくなってるの！？とふらふらになり頭を押さえながらたたおれこむエモンガそして幼いながらに大きなアソコをぽろんと垂れ流しびっくりし、犯されるエモンガ。", "nc": 40, "word_count": 5295, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@bokuranoarisu19/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 962335, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee3747eb/uploads/origins/65218616-eb00-4de3-9c90-8162136d31e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71df7f88bf52ac78e4f9aee816429617", "srcset": "https://si.imgix.net/ee3747eb/uploads/origins/65218616-eb00-4de3-9c90-8162136d31e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71df7f88bf52ac78e4f9aee816429617, https://si.imgix.net/ee3747eb/uploads/origins/65218616-eb00-4de3-9c90-8162136d31e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=540241ad271644f95bc6b2fd704d77b4 2x, https://si.imgix.net/ee3747eb/uploads/origins/65218616-eb00-4de3-9c90-8162136d31e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5abd7f81ce295a28d15b6b0c06399b5c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee3747eb/uploads/origins/65218616-eb00-4de3-9c90-8162136d31e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54b2edddad4bdbe5c38b93647e6a6f73", "srcset": "https://si.imgix.net/ee3747eb/uploads/origins/65218616-eb00-4de3-9c90-8162136d31e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=2