シスターの19pのようなまたがり騎乗位。乳を接合部を見せつける。シチュの内容も本につながる前日譚のような感じで。乳揺らし差分もできれば欲しいです。\n真実（トゥルース）を知るためまずは自身の本能に従いましょう！と行為。本能のまま知らなかった感覚に身をゆだね自身の二枚貝を硬く閉じ絞り、中出し。\nそうやって男を搾り取り「理解」したニナちゃんが「救済」に目覚めて終わり。\n\nよろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gotakichi/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 780938, "client_id": 316802, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bdbdd5f9/uploads/origins/9f3f90e9-18ae-40fe-8d33-7ecfc2c359cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22a0e96ce5373848eedca82bd5029c9c", "srcset": "https://si.imgix.net/bdbdd5f9/uploads/origins/9f3f90e9-18ae-40fe-8d33-7ecfc2c359cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22a0e96ce5373848eedca82bd5029c9c, https://si.imgix.net/bdbdd5f9/uploads/origins/9f3f90e9-18ae-40fe-8d33-7ecfc2c359cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=678e7c204d068e887570c2c135235825 2x, https://si.imgix.net/bdbdd5f9/uploads/origins/9f3f90e9-18ae-40fe-8d33-7ecfc2c359cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3df3639b87eda4febb65b754a3856f16 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bdbdd5f9/uploads/origins/9f3f90e9-18ae-40fe-8d33-7ecfc2c359cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb5bf140d2515f4119c4350677f6f1ed", "srcset": "https://si.imgix.net/bdbdd5f9/uploads/origins/9f3f90e9-18ae-40fe-8d33-7ecfc2c359cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb5bf140d2515f4119c4350677f6f1ed, https://si.imgix.net/bdbdd5f9/uploads/origins/9f3f90e9-18ae-40fe-8d33-7ecfc2c359cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f15abdd0b1f0c8f652a7a1da0ba86805 2x, https://si.imgix.net/bdbdd5f9/uploads/origins/9f3f90e9-18ae-40fe-8d33-7ecfc2c359cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dba6392a1b16dc9124e1a8ce40929ef5 3x"}, "body": "爆乳マエリベリー・ハーンとフタナリ宇佐美蓮子をお願いします。\n\nhttps://www.pixiv.net/artworks/140937534の続きを描いてほしかったので。\n胸出し、ズラシ挿入。\n\nご飯代を浮かせようとキノコを持ち帰り調理しふるまった蓮子。\n結果メリーのただでさえ大きな胸が服に収まらないほど大きくなり、蓮子には立派なキノコが生えた。\n都合のいいことに収まりがつかないほどムラムラしてメリーが大きな胸を見せつけるように揺らし騎乗位。\n\n特に変化があった部位がもどかしくて仕方ないと、重点的にメリーは胸を揉むように、気持ちよいけど重さで疲れてきた蓮子に支えてないと暴れて痛いしもどかしいのよ、責任とって揉みなさい、な感じ。蓮子も常にキノコを刺激していないと発狂しそうとメリーに止まらないでと懇願し胸を揉む。\n射精しても気持ちが収まり気配はなく、症状が収まるまで丸一日ずっとまぐわった。で終わり。\n\n手に収まらないほど大きな胸をぎゅっと揉みしだく。\n差分として騎乗位するメリーの縦横無尽に荒ぶる胸を揉んだり寄せるように揉んだりと、揉みしだかれる様が３，４つほしいです。難しいようでしたら寄せた胸を下から支えるように持たせ、指が沈み込んだ状態で大丈夫です。\n\n\nよろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gotakichi/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 780938, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef2384c6/uploads/origins/105e4803-e27f-41ff-8851-175db0f1e03d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e460cec6facd0398e49aba66c39c536a", "srcset": "https://si.imgix.net/ef2384c6/uploads/origins/105e4803-e27f-41ff-8851-175db0f1e03d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e460cec6facd0398e49aba66c39c536a, https://si.imgix.net/ef2384c6/uploads/origins/105e4803-e27f-41ff-8851-175db0f1e03d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee2a288d1ec7ebe7e6e66ab242d2a3ea 2x, https://si.imgix.net/ef2384c6/uploads/origins/105e4803-e27f-41ff-8851-175db0f1e03d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2212bc2c14ea5ac0660de5425d94a43 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef2384c6/uplo