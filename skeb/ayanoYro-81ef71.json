bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc7eb76a8e7f6afb67e36f94e8134e55, https://si.imgix.net/950f00c7/uploads/origins/a0aeb5f2-2211-469d-9033-714fefd16241?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ef20c386f00d4dcc7de044b248ba96e 2x, https://si.imgix.net/950f00c7/uploads/origins/a0aeb5f2-2211-469d-9033-714fefd16241?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f129bc31552d565d4a9f7a80547708ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/950f00c7/uploads/origins/a0aeb5f2-2211-469d-9033-714fefd16241?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0f67bb7d1b8fdb665e5477c921f7a73", "srcset": "https://si.imgix.net/950f00c7/uploads/origins/a0aeb5f2-2211-469d-9033-714fefd16241?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0f67bb7d1b8fdb665e5477c921f7a73, https://si.imgix.net/950f00c7/uploads/origins/a0aeb5f2-2211-469d-9033-714fefd16241?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4b48c947f710ec658b2cb39bf88d4be0 2x, https://si.imgix.net/950f00c7/uploads/origins/a0aeb5f2-2211-469d-9033-714fefd16241?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8295a099548707caefe463773a15fdfb 3x"}, "body": "Yro 様\nはじめまして。\n数々のVTuber様の素敵なイラストをXで拝見し、ぜひ推しのFAをお願いしたいと思いました。\n依頼を受けていただけると幸いです。\n\n【依頼内容】\n・モデル 個人VTuber\"天乃まの\" さん\n\nhttps://x.com/Aman0_man0\n→ご本人のXアカウントです。\n\n・参考資料 https://lit.link/amanomano\n→ご本人のlit.linkになります。\nこちらに三面図が３種類ございますが、「3周年記念衣装」でお願いいたします。\nまた、こちらの\"二次創作について\"にてファンアートについての記載があり、Skebの依頼については問題は無い認識です。\n\n資料URLに三面図とバストアップの画像をご用意いたしました。\n3周年記念配信でも確認できますので、細部はそちらを見ていただければと思います。\nhttps://www.youtube.com/watch?v=ocbZ3S-AIMU\n00:22:50 ～ 00:52:37 が新衣装の紹介になります。\n（コメントにタイムスタンプがあります）\n\n【使用目的】\n私個人のXやYouTubeなどのSNSでの利用、壁紙などでの鑑賞目的での個人利用になります。\nまたFAになりますので、ご本人様のVTuber活動（X、YouTubeなどのSNS上）で使用される可能性がございます。\n配信のサムネイルやその他SNSでの使用許可をいただきたいです。\n\n【構図・ポージング】\n構図・ポージングについてはすべてお任せいたします。\nご本人様のVTuber活動で使用される事を考慮し、頭や左右の切れが無いようお願いいたします。\n\n【納品】\n納品については特に希望はございませんが、背景と人物を分けていただけるとありがたいです。\n\n【注意事項】\nXの\"AIモデル学習利用\"の明文化により学習に利用される等の話題がありますが、依頼するFAもXなどのSNSでVTuber様の活動に利用させていただきます。\nそのため、AIモデル学習利用についてご懸念があるようであれば、依頼をキャンセルをしていただいて問題ありません。\n\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1_dRFoiqruwhnbw8va2vAOwSrSgI8hOtE?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ayanoYro/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3600951, "client_id": 2418409, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/761abe04/uploads/origins/21ba05a5-eb9a-4de0-b628-4c5d404d4f91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdc875c3c2cfadc2717c0e52ff057c13", "srcset": "https://si.imgix.net/761abe04/uploads/origins/21ba05a5-eb9a-4de0-b628-4c5d404d4f91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdc875c3c2cfadc2717c0e52ff057c13, https://si.imgix.net/761abe04/uploads/origins/21ba05a5-eb9a-4de0-b628-4c5d404d4f91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=353c043fd48afce6a8ea42277ac4cfbb 2x, https://si.imgix.net/761abe04/uploads/origins/21ba05a5-eb9a-4de0-b628-4c5d404d4f91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81bc2146eb061a2c5093ba1f809e0e40 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/761abe04/uploads/origins/21ba05a5-eb9a-4de0-b628-4c5d404d4f91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e70af2efb762affca0c6007ebbb9954", "srcset": "https://si.imgix.net/761abe04/uploads/origins/21ba05a5-eb9a-4de0-b628-4c5d404d4f91?bg=%23fff&auto=format%2