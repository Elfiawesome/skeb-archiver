e-bc01-931ab6a9dc15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de57a3412ae72aa078e2e2837562cd0b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92c113a8/uploads/origins/261c1f40-472d-452e-bc01-931ab6a9dc15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5361c015f9afafcf26aaf532bba2f817", "srcset": "https://si.imgix.net/92c113a8/uploads/origins/261c1f40-472d-452e-bc01-931ab6a9dc15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5361c015f9afafcf26aaf532bba2f817, https://si.imgix.net/92c113a8/uploads/origins/261c1f40-472d-452e-bc01-931ab6a9dc15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=127247a6ef375bc555a80e37a4ae6d63 2x, https://si.imgix.net/92c113a8/uploads/origins/261c1f40-472d-452e-bc01-931ab6a9dc15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=569a57eea7e23042b5e5754753b325a6 3x"}, "body": "お久しぶりです。早速リクエストさせていただきます。\nキャラはまけラビの猫又椿先生。\nシチュエーションは泥酔した猫又先生をベッドまで連れて行ったらそのまま引きずり込まれて抜け出せずに一緒に寝ちゃうシチュをお願いします。念のためNSFW入れておきます。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuyatorinabe/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3467718, "client_id": 3306146, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8db399ef/uploads/origins/bfcd61a6-c4ac-45b8-838b-f0f30f0d2504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=042b6bd8986c612ecd6e0dfad15fcadd", "srcset": "https://si.imgix.net/8db399ef/uploads/origins/bfcd61a6-c4ac-45b8-838b-f0f30f0d2504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=042b6bd8986c612ecd6e0dfad15fcadd, https://si.imgix.net/8db399ef/uploads/origins/bfcd61a6-c4ac-45b8-838b-f0f30f0d2504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb64dcbe045658e95430b2f1bc8c4ab8 2x, https://si.imgix.net/8db399ef/uploads/origins/bfcd61a6-c4ac-45b8-838b-f0f30f0d2504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d973069dd9bc4ec01afa0225c46d32a5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8db399ef/uploads/origins/bfcd61a6-c4ac-45b8-838b-f0f30f0d2504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7fdd8aff8aabe2ffdc414272e1cdf7b", "srcset": "https://si.imgix.net/8db399ef/uploads/origins/bfcd61a6-c4ac-45b8-838b-f0f30f0d2504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7fdd8aff8aabe2ffdc414272e1cdf7b, https://si.imgix.net/8db399ef/uploads/origins/bfcd61a6-c4ac-45b8-838b-f0f30f0d2504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f69442c81ff793a161a88e66768f2eb1 2x, https://si.imgix.net/8db399ef/uploads/origins/bfcd61a6-c4ac-45b8-838b-f0f30f0d2504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dfc5e76b2601c938514a38969563114e 3x"}, "body": "先日はありがとうございました。また依頼させていただきます。\nキャラは依神紫苑。前回依頼の後日談的なイメージです。\nたっぷりすけべ後のピロートークしている感じでお願いします。\n格好は原作のパーカー+ミニスカート。自分から着崩そうとはしていませんが、貧乏神故お金がなく、その影響でパーカーは胸以外オーバーサイズな感じです。また、竿役を誘うためか普段のものに加え「卵子差押可」などと書かれた手書きの請求書を雑に付けています。\n　あの女苑の姉らしく胸は大きめ。\n女苑と二人暮らしだったところ、前回依頼の竿役を女苑がよく連れ込むようになった\n→興味が湧いて、女苑が連れ込んだ後他の男に貢がせに行き、竿役一人しかいない時に手を出した\n→姉妹ということもあってか女苑同様相性が良く、えっちしまくっちゃった……といった感じです。\n基本ゴムありでしかしなかったらしく辺りには使用済みゴムが散乱しています。竿役の精力・竿のサイズが前回依頼から今回以来までの間に行われた度重なる女苑とのえっちによりかなり成長したらしく、ゴム一個一個のサイズと液体の量が前回依頼の数倍になっています。\nまた、できればちょっとした台詞あり差分、ミニスカートは原作同様半透明、股の部分にはどろっとした液体が透けて見えている感じなどお願いしたいです。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuyatorinabe/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3467718, "client_id": 3306146, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d622893e/uploads/origins/d6d042b3-80df-4fb0-a24f-e46d0c50d386?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75ea25dbeef7b1c6b2841c5e5b3dd107", "srcset": "https://si.imgix.net/d622893e/uploads/origins/d6d042b3-80df-4fb0-a24f-e46d0c50d386?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75ea25dbeef7b1c6b2841c5e5b3dd107, https://si.imgix.net/d622893e/uploads/origins/d6d042b3-80df-4fb0-a24f-e46d0c50d386?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eeb8125f3851ac95175340350e2e648e 2x, https://si.imgix.net/d622893e/uploads/origins/d6d042b3-80df-4fb0-a24f-e46d0c50d386?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e24d9c4ca960f066b9f9edf8d8ba958 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d622893e/uploads/origins/d6d042b3-80df-4fb0-a24f-e46d0c50d386?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3d50c05dd14e216acd0d3d30c5b4599", "srcset": "https://si.imgix.net/d622893e/uploads/origins/d6d042b3-80df-4fb0-a24f-e46d0c50d386?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3d50c05dd14e216acd0d3d30c5b4599, https://si.imgix.net/d622893e/uploads/origins/d6d042b3-80df-4fb0-a24f-e46d0c50d386?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d51adcab992cd3e14cb8e759faf01848 2x, https://si.imgix.net/d622893e/uploads/origins/d6d042b3-80df-4fb0-a24f-e46d0c50d386?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aea0591fd9325a7301ee3563f1de1538 3x"}, "body": "昨晩いっぱいすけべした後なんだろうなって一目でわかる依神女苑をお願いしたいです。\n格好は原作での石油王みたいな格好の方ですが、服の宝飾品が色とりどりの使用済みのゴム（大きめ）になっています。着崩したりはしておらず、散々えっちを行い服を着直した後、といった感じです。\n胸はかなり大きめ、表情はhttps://www.pixiv.net/artworks/132006372のようにちょっと煽ってきている感じです。\n\nこの状態に至るまでの流れとしては、\nいっぱい貢がせて上機嫌になっていたところで男に遭遇\n→その場のノリで「勝った方が相手に言うことを一つ聞かせていい」賭けをしたところ女苑が大負けし一回だけゴムありえっちをすることに\n→身体の相性が良すぎたために、女苑側から誘って一晩中えっちして今に至る、といった感じです。\n　可能であれば近くに使用済みゴム（大きめ）でいっぱいになっているゴミ箱を置いて、どれだけ激しいことが行われたのかわかるようにしてほしいです。また、同じく可能であればちょっとした台詞付き差分などお願いしたいです。よろしくお願いします", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuyatorinabe/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3467718, "client_id": 1388897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28d1347d/uploads/origins/7f84786a-f249-47fb-a474-f1d56882a294?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6151f3c138df6dd3293741eda8d4a5f3", "srcset": "https://si.imgix.net/28d1347d/uploads/origins/7f84786a-f249-47fb-a474-f1d56882a294?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6151f3c138df6dd3293741eda8d4a5f3, https://si.imgix.net/28d1347d/uploads/origins/7f84786a-f249-47fb-a474-f1d56882a294?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfedf65d765d54a03d37bb1e855ce71a 2x, https://si.imgix.net/28d1347d/uploads/origins/7f84786a-f249-47fb-a474-f1d56882a294?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfb4bcefa526f4e90abdc5ff988162ed 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28d1347d/uploads/origins/7f84786a-f249-47fb-a474-f1d56882a294?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ac9e3afb71e4f80674a6ce133417371", "srcset": "https://si.imgix.net/28d1347d/uploads/origins/7f84786a-f249-47fb-a474-f1d56882a294?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ac9e3afb71e4f80674a6ce133417371, https://si.imgix.net/28d1347d/uploads/origins/7f84786a-f249-47fb-a474-f1d56882a294?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=82f66fab01f045a02041d3532fdeaf70 2x, https://si.imgix.net/28d1347d/uploads/origins/7f84786a-f249-47fb-a474-f1d56882a294?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7ae31117cdeb8eca231c80648ba830a4 3x"}, "body": "初めて送りたいと思います。\nキャラ：東風谷早苗\n内容\n夏祭り会場で浴衣が脱がされて裸を晒されるハプニングに見舞われる早苗をお願いします。\n構図としては早苗の後ろか前に転んだ男の子がいて、その男の子が早苗の着てる浴衣の帯と浴衣生地を掴んでいて脱がしてしまったような図でお願いします。\nイメージとしては「一緒に来ていた年下の男の子が早苗に駆け寄った際に躓き、早苗の浴衣や帯を掴んでしまったまま転倒してしまって浴衣を脱がされてしまった」な感じです。\n早苗の様子は驚き恥ずかしがっているか、まだ現状を把握できないでいるかお任せします。\n早苗の体型はパイパンであれば胸はこれまで描かれた事があるサイズでお願いします。\n\nこれで宜しければお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuyatorinabe/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3467718, "client_id": 446356, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c36d5056/uploads/origins/aeb56e8a-5b53-454f-8b31-5dc5406ba3b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63665242920a8ce088bc1eac8b220c04", "srcset": "https://si.imgix.net/c36d5056/uploads/origins/aeb56e8a-5b53-454f-8b31-5dc5406ba3b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63665242920a8ce088bc1eac8b220c04, https://si.imgix.net/c36d5056/uploads/origins/aeb56e8a-5b53-454f-8b31-5dc5406ba3b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff6b8823b9bd423ee608a852faf86b4d 2x, https://si.imgix.net/c36d5056/uploads/origins/aeb56e8a-5b53-454f-8b31-5dc5406ba3b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=891e87097bc20afe97d17556d9648d84 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c36d5056/uploads/origins/aeb56e8a-5b53-454f-8b31-5dc5406ba3b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop