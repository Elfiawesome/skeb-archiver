穏やかで、ほとんどよそよそしいほどです。\n身体的には非常に弱っていますが、鞘に収めた剣を杖代わりにして、それを隠しています。\n戦闘能力は非常に高いが、持久力は平均以下だ。\n\nポーズや構図は自由に選んでください。\n\n翻訳がうまくいくことを願っています！\n\nありがとう、頑張ってください！\n\nhttps://photos.app.goo.gl/yXQtguj46sj4Seyi8", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1day1week/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3993585, "client_id": 3893401, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ba2784b/uploads/origins/3a33d17a-411a-4455-9010-dafeed468d85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e580597d10bf52d745f564b875fe756", "srcset": "https://si.imgix.net/2ba2784b/uploads/origins/3a33d17a-411a-4455-9010-dafeed468d85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e580597d10bf52d745f564b875fe756, https://si.imgix.net/2ba2784b/uploads/origins/3a33d17a-411a-4455-9010-dafeed468d85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8399e0bbfa583e5fbc16efbb684d23c1 2x, https://si.imgix.net/2ba2784b/uploads/origins/3a33d17a-411a-4455-9010-dafeed468d85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93430bd42bb069e241a591c224f9b5d4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ba2784b/uploads/origins/3a33d17a-411a-4455-9010-dafeed468d85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8b93539d5a2a4d88c5492f7bb9bcc1e", "srcset": "https://si.imgix.net/2ba2784b/uploads/origins/3a33d17a-411a-4455-9010-dafeed468d85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8b93539d5a2a4d88c5492f7bb9bcc1e, https://si.imgix.net/2ba2784b/uploads/origins/3a33d17a-411a-4455-9010-dafeed468d85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=156aac9a78041849363516bf2f