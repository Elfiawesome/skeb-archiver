=200&h=200&s=8a694db495d2812bfa06e1d497a89c32, https://si.imgix.net/e8b3c860/uploads/origins/bca1c09e-5325-4e2b-9b23-cbfb3f721b3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4c43e554ef760347ae43d1fd1df375a 2x, https://si.imgix.net/e8b3c860/uploads/origins/bca1c09e-5325-4e2b-9b23-cbfb3f721b3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23fd55be55d968a298bd2ca0bf6ee581 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8b3c860/uploads/origins/bca1c09e-5325-4e2b-9b23-cbfb3f721b3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d21f45bbf52c8bf7add6276bcfbdfcad", "srcset": "https://si.imgix.net/e8b3c860/uploads/origins/bca1c09e-5325-4e2b-9b23-cbfb3f721b3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d21f45bbf52c8bf7add6276bcfbdfcad, https://si.imgix.net/e8b3c860/uploads/origins/bca1c09e-5325-4e2b-9b23-cbfb3f721b3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2984c742c8e4ce8b220a31273f5c43c8 2x, https://si.imgix.net/e8b3c860/uploads/origins/bca1c09e-5325-4e2b-9b23-cbfb3f721b3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ba726edbf930f85d19aca18a9514b72 3x"}, "body": "はじめまして、以前からずっと桐彦様のイラストが大好きで、今回ご依頼をさせていただけることをとても嬉しく思います！\n\n▼キャラクター詳細🪻\n\n職業：怪盗  \n年齢／性別：見た目は約20歳だが、実際の年齢は不明／性別不明  \n外見の特徴：いつも杖代わりに使える傘を持っている  \n性格：外見は冷静だが内面は熱く、頑固で負けず嫌い。見下されるのを嫌い、話し方や所作は常に優雅。いつもマント付きのトレンチコートを着て、仕込み杖にもなる傘を携えている。\n\n可能であればPSDファイル形式でお願いします！\n用途：SNSのプロフィール画像使用、個人用途での印刷・コレクション用。商用利用は行いません。\n\n価格が低すぎたり、懸念がある場合は、再送を依頼していただけると幸いです。\nリクエストを読んでいただき、そして検討いただき本当にありがとうございます。\nこのリクエストが不適切でしたら、どうぞお気軽にキャンセルしてください。\n\nhttps://drive.google.com/drive/folders/11LmLRQmhLN-3TMAj7gsYuaYsXxRbErB0?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kirihi_ko/w