。\n\n性格は明るく、不器用でかわいい。お菓子やデザートが大好き。彼女はファンをとても愛しています。イラストはSNS投稿や動画のサムネイルに使用します。可能であれば、背景とキャラクターを分離したPSDデータでの納品をお願いします。\n\nhttps://drive.google.com/drive/folders/1xOmK6blRaZUcMv69p6VWfNUc9Qe68YX8?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naname580/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3312197, "client_id": 1433185, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a66e8065/uploads/origins/fe8acf99-b047-47d4-b26d-ec19b01271c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61a2d50933781e95ef103e3c0e4aceef", "srcset": "https://si.imgix.net/a66e8065/uploads/origins/fe8acf99-b047-47d4-b26d-ec19b01271c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61a2d50933781e95ef103e3c0e4aceef, https://si.imgix.net/a66e8065/uploads/origins/fe8acf99-b047-47d4-b26d-ec19b01271c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6231480e2c65f64d0636ad497810329 2x, https://si.imgix.net/a66e8065/uploads/origins/fe8acf99-b047-47d4-b26d-ec19b01271c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=589d31c2e9c7df27ec212b54c1318e67 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a66e8065/uploads/origins/fe8acf99-b047-47d4-b26d-ec19b01271c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3710a403a77e50d2db984e4384a0112", "srcset": "https://si.imgix.net/a66e8065/uploads/origins/fe8acf99-b047-47d4-b26d-ec19b01271c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3710a403a77e50d2db984e4384a0112, https://si.imgix.net/a66e8065/uploads/origins/fe8acf99-b047-47d4-b26d-ec19b01271c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2af026881f35476d93