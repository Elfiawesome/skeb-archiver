427e2/uploads/origins/93b1d66f-6a4a-44cc-a0fe-faa3aaa6b970?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cb5fc544ef14318840f34390324d53f", "srcset": "https://si.imgix.net/2d6427e2/uploads/origins/93b1d66f-6a4a-44cc-a0fe-faa3aaa6b970?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cb5fc544ef14318840f34390324d53f, https://si.imgix.net/2d6427e2/uploads/origins/93b1d66f-6a4a-44cc-a0fe-faa3aaa6b970?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=21fcb473686381278ca15252f2b4e0b0 2x, https://si.imgix.net/2d6427e2/uploads/origins/93b1d66f-6a4a-44cc-a0fe-faa3aaa6b970?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=22cdfc59a54b16cc14d0825461896324 3x"}, "body": "コモ先生、こんにちは！前回は素敵なイラストありがとうございました。また私のOCを描いていただけないでしょうか…！\n\n【お願いしたい内容】\n・ファイル内の女の子をお願いします。(できれば暗めの雰囲気だと嬉しいです)\n・決まった服装はありませんので、ドクロマークや骨、✖️、ひまわりのいずれかをモチーフに入れていただいてご自由に描いていただければと思います。\n・髪の毛は薄い金髪にピンクのインナーカラーが入っていますが、ピンク髪の位置やバランスなどはご自由に変更してくださって大丈夫です。髪型はツーサイドアップですが、三つ編みを入れてもらったり、長さを変えたりなどのアレンジ可能です。前髪も自由に変えて大丈夫です。\n\n全体的に自由に描いていただいて大丈夫な子なので、コモ先生のお好きなように描いていただけると嬉しいです！\n使用用途としては、服装に変更がある場合は描いていただいた絵を参考に自分でも描いて楽しみたいと思います！難しい場合はキャンセルしてください。\n\n内容や金額に不備がある場合は再送またはキャンセルにしてくださって大丈夫です。\nお忙しい中最後まで読んでくださりありがとうございました。\nご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1wc-khGM4p1nRTCBIHLZjZNKYL-YkYnMh", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Nemmmkomo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2637583, "client_id": 2248464, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f8d7e0e/uploads/origins/5cb23ecc-492f-4d28-8b6a-8d59e4c8e4c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=710e7fde15cb4214ebe33fa6069f4a8f", "srcset": "https://si.imgix.net/3f8d7e0e/uploads/origins/5cb23ecc-492f-4d28-8b6a-8d59e4c8e4c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=710e7fde15cb4214ebe33fa6069f4a8f, https://si.imgix.net/3f8d7e0e/uploads/origins/5cb23ecc-492f-4d28-8b6a-8d59e4c8e4c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a53ad65e066190434e07ee929d61a9d 2x, https://si.imgix.net/3f8d7e0e/uploads/origins/5cb23ecc-492f-4d28-8b6a-8d59e4c8e4c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9ccffe5b147051344c035e2e89f340e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f8d7e0e/uploads/origins/5cb23ecc-492f-4d28-8b6a-8d59e4c8e4c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80e2b94f4221c6798e287f7dcb428c5a", "srcset": "https://si.imgix.net/3f8d7e0e/uploads/origins/5cb23ecc-492f-4d28-8b6a-8d59e4c8e4c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80e2b94f4221c6798e287f7dcb428c5a, https://si.imgix.net/3f8d7e0e/uploads/origins/5cb23ecc-492f-4d28-8b6a-8d59e4c8e4c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7bf6b7b3f5c1a1594f8e0c27f23f76d3 2x, https://si.imgix.net/3f8d7e0e/uploads/origins/5cb23ecc-492f-4d28-8b6a-8d59e4c8e4c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ca2afe88153944e89d95b80a60f16cd1 3x"}, "body": "コモ先生、こんにちは。いつも素敵なイラスト拝見させていただいております…！今回コモ先生がskebを開設されたとのことであまりの嬉しさに飛び跳ねそうです！ぜひ私のOCを描いていただけないでしょうか？\n\n【依頼内容】\n・フォルダ内の二人をお願いしたいです。\n・シチュエーションや構図など、コモ先生に自由に描いていただきたいです。\n\n簡単なキャラ説明です。\n二人の関係性は恋人のため、距離が近いです。\nOC① 黒髪　黒目or赤目、目の中はぐるぐるしており基本的にハイライトはありません。\n・OC②以外には攻撃的で、倫理観はありません。よく頭か肩に黒いウサギみたいなのがいます。OC②が近くにいると自分の膝の上に乗せたり、抱っこしたりと離そうとしません。\n・髪型は片方だけ結ぶか、完全に下ろしているかの2パターンになりますが、どちらでもいいです。\n・耳に♢♦︎型のピアスをしています。\n・服装も自由に変えていただいて構いません。基本的には柄シャツや、カジュアルな服装を好みます。\n\nOC② 茶髪　青目　身長大凡130〜135cm\n・泣き虫、気弱な男の子です。瞳孔が大きく、少しだけ上まつ毛があります。\n・OC①の趣味でうさぎのフードがついている服や、動物、ジャージをモチーフにした上着と短パン姿が多いです。\n・OC①の作る料理が好きで、食いしん坊です。好物は唐揚げ、クレープ、プリン。\n\n参考資料があまりなく、どちらもわかりにくい部分が多いため服装や髪型など自由に変更を加えていただいて大丈夫です。\n金額が足りない、内容に難がある場合は再送またはキャンセルにしていただいて構いません。\n長々とした文章になってしまって申し訳ありませんが、ご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-S7ZpKTcO99b_9nYEtEk4G4yu-PhdSgS", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Nemmmkomo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2637583, "client_id": 2168110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c73fc339/uploads/origins/e4386b66-abb1-4e67-833b-9297c722c55a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc004cdd6de7009f341ab6b7a3d8bc95", "srcset": "https://si.imgix.net/c73fc339/uploads/origins/e4386b66-abb1-4e67-833b-9297c722c55a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc004cdd6de7009f341ab6b7a3d8bc95, https://si.imgix.net/c73fc339/uploads/origins/e4386b66-abb1-4e67-833b-9297c722c55a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20ca3d2a4a3fd7b608f4681ccf6f90dc 2x, https://si.imgix.net/c73fc339/uploads/origins/e4386b66-abb1-4e67-833b-9297c722c55a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a727718069cd5ebaedd77815a82083b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c73fc339/uploads/origins/e4386b66-abb1-4e67-833b-9297c722c55a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51299e1fc31d4fdc3514a695da600f71", "srcset": "https://si.imgix.net/c73fc339/uploads/origins/e4386b66-abb1-4e67-833b-9297c722c55a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51299e1fc31d4fdc3514a695da600f71, https://si.imgix.net/c73fc339/uploads/origins/e4386b66-abb1-4e67-833b-9297c722c55a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ae2071a3424e0eb893ec44e2381144d 2x, https://si.imgix.net/c73fc339/uploads/origins/e4386b66-abb1-4e67-833b-9297c722c55a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2419ae720a7aa1d345c6558cef9ed626 3x"}, "body": "絵柄が好きだったのでご依頼しました。\nうちのOCをお願いすることは可能でしょうか？ \n参考までに設定は以下のとおりですが、自由に描いていただいて構いません。\n███\n●マダマテ\n　皇すららのペットの子犬。十年前に皇すららに拾われ、以降はずっと家族同然に暮らしている。\n　皇すららは子犬と思い込んでいるが、垂れ耳の兎にも見えなくもない。\n　名前の由来は「待て」が覚えられないことから。\n　周囲の生命体を素材に皇すららのクローンを生み出し続ける元凶。\n　オリジナルが仲良くしていた者にしか懐かず、その者だけはクローンの素材（アメーバ体）にされない。\n\n●皇すらら（すめらぎ すらら）\n＜オリジナル＞\n　人間の少女。記憶力は良い方。\n　数年前に事故死している。\n\n＜クローン体＞\n　事故死した皇すららを蘇らせるために、マダマテが作り出した【皇すらら】の完全な複製。\n　無茶なクローニングによる影響で深く眠り込むと突然死することも度々あるが、その度に前の個体の記憶と姿を転写された代わりのクローン体が作り出されている。\n　皇すららとしての自己の連続性に疑問を抱かせないために、マダマテによって記憶を調整されている。\n\n＜アメーバ体＞\n　有機生命体がマダマテの放つ胞子＜皇すららの因子＞の影響を受けて変貌した状態。\n　皇すららと同一の遺伝子を持ちながらも、完全な複製であるクローン体とは異なり、アメーバのような不完全で異形な姿をした粗悪コピー。\n　アメーバ体は走性に従って一定規模の集団を形成すると融合（集合）して子実体を形成する。\n\n＜子実体＞\n　アメーバ体の集団が融合（集合）して一つになった状態。\n　子実体頂部内の細胞が分裂を繰り返してクローン体と成る。クローン体を排出すると子実体は枯れて溶けて消える。\n　クローン体はマダマテによって記憶を調整されているが、アメーバ体や子実体の時に見たり聞いた事を悪夢として体験する事が度々ある。\n███\n宛名・背景はpsdでon/offできると幸いです。\n使用用途は個人活動全般（動画配信の待機画面等、個人サイトやSNSでの小説の挿絵、キャラ紹介、個人活動の告知、トリミング加工を伴うアイコン・ヘッダー・バナーとしての使用等、コミッションサイトでのイラスト等依頼時に参考資料等）を考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-DC54qVFtGUFP-9T0gu-zLkbOKQFZ6TK", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1225113, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "nightingale_shi", "screen_name": "nightingale_shi", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fwebpublic-4ba95557-42e1-45f4-b69f-52b35f8ed831.webp?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/webpublic-5b8077ed-232c-45cf-899b-6869216e7204.png", "appeal_receivable": false, "popular_creator_rank": null, "reques