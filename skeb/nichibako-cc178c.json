\nhttps://www.pixiv.net/artworks/112451588\n\n構図としては、ワルダモンのように竿役（ショタ）の顔が見えない騎乗位逆レイプをお願いしたいです。\nhttps://www.pixiv.net/artworks/99079021\n\nシチュエーションとしては、何の罪もない一般ショタが怪人に逆レイプされて、死ぬまで精液を搾り尽くされるような流れでお願いします。\n豹変した際の罵倒や侮蔑混じりの淫語がとても大好きだったので、セリフもマシマシにしていただけたら嬉しいです……！\n\n予算の許す範囲でご検討いただけますと幸いです、何卒よろしくお願いいたします！", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nichibako/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3290275, "client_id": 134363, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c949b004/uploads/origins/9a5f0c23-e1e7-45e6-8f38-f57a88e9baa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b56992855110211821436b23c9d1ffa", "srcset": "https://si.imgix.net/c949b004/uploads/origins/9a5f0c23-e1e7-45e6-8f38-f57a88e9baa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b56992855110211821436b23c9d1ffa, https://si.imgix.net/c949b004/uploads/origins/9a5f0c23-e1e7-45e6-8f38-f57a88e9baa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c933614cdeb2732ab564b3f869eaf345 2x, https://si.imgix.net/c949b004/uploads/origins/9a5f0c23-e1e7-45e6-8f38-f57a88e9baa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5609d8bf60323413c5b1e6d37d568eb5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c949b004/uploads/origins/9a5f0c23-e1e7-45e6-8f38-f57a88e9baa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f932385d18f5f1f142fbfd57b14902c", "srcset": "https://si.imgix.net/c949b004/uploads/origins/9a5f0c23-e1e7-45e6-8f38-f57a88e9baa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f932385d18f5f1f142fbfd57b14902c, https://si.imgix.net/c949b004/uploads/origins/9a5f0c23-e1e7-45e6-8f38-f57a88e9baa5?bg=%23fff&aut