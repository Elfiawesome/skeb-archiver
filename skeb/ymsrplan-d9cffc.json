ins/33cc5b4f-07f2-4316-92af-86a6c2a65cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=795042f02e1085f6b4d3c4e616d36f94, https://si.imgix.net/82aa81d1/uploads/origins/33cc5b4f-07f2-4316-92af-86a6c2a65cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=658b071951da30dc8876e8e47271e543 2x, https://si.imgix.net/82aa81d1/uploads/origins/33cc5b4f-07f2-4316-92af-86a6c2a65cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ee52ececfc542d51c49b3158cef5eac 3x"}, "body": "お世話になっております。本当にイラストのタッチ、雰囲気、構図が好きです……！\nもし宜しければホーネットの擬獣化をお願いしたく……リクエストを送らせていただきました。\n構図などは自由に描き易いように描いて頂ければ幸いです。指定がある方がいい場合には祈るように穏やかに佇む彼女を描いてくださればと思います。無理のない範囲内で宜しくお願いします。\n\nhttps://drive.google.com/drive/folders/10oouxN2PE6HV1Qts0yWIAdheqBCPdKV-", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ymsrplan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1850657, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a8e18f4/uploads/origins/2cff7bb2-86b1-4b8f-822c-603a228e34d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=986061bba4c6cd247cc92a5d47ef520c", "srcset": "https://si.imgix.net/5a8e18f4/uploads/origins/2cff7bb2-86b1-4b8f-822c-603a228e34d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=986061bba4c6cd247cc92a5d47ef520c, https://si.imgix.net/5a8e18f4/uploads/origins/2cff7bb2-86b1-4b8f-822c-603a228e34d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a544c42ec1234f632d26f459ded919e5 2x, https://si.imgix.net/5a8e18f4/uploads/origins/2cff7bb2-86b1-4b8f-822c-603a228e34d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2629337a79af044ebe13414064977992 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src