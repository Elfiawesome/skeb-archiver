！\n・KP用なので、ダイスやルルブを持っているという設定も取り入れられそうならお願いいたします。\n・同じデザインで、アイコン用の2頭身程のミニキャラも欲しいです！\n┈┈┈┈┈┈┈┈┈┈\n基本的にデザインはお任せしたいと思っております！\n「クトゥルフ神話生物」などで検索していただければ出ると思います…🙇‍♀️\n\nお忙しいところ恐れ入りますが御検討いただければ幸いです！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@retsujouP/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 597443, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df2adb14/uploads/origins/3edb6b4c-279b-4754-999b-cb21d7c5938a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7abd65406dcb524b00261505a5dea584", "srcset": "https://si.imgix.net/df2adb14/uploads/origins/3edb6b4c-279b-4754-999b-cb21d7c5938a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7abd65406dcb524b00261505a5dea584, https://si.imgix.net/df2adb14/uploads/origins/3edb6b4c-279b-4754-999b-cb21d7c5938a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c8f5418e358c13e8b2f51f7f25704bc 2x, https://si.imgix.net/df2adb14/uploads/origins/3edb6b4c-279b-4754-999b-cb21d7c5938a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0227d9118e7ee88671f4d8fc82aa3eb0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df2adb14/uploads/origins/3edb6b4c-279b-4754-999b-cb21d7c5938a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=206ba56b6c1ddc8c2770529a24fb747a", "srcset": "https://si.imgix.net/df2adb14/uploads/origins/3edb6b4c-279b-4754-999b-cb21d7c5938a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=206ba56b6c1ddc8c2770529a24fb747a, https://si.imgix.net/df2adb14/uploads/origins/3edb6b4c-279b-4754-999b-cb21d7c5938a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab80c762b2ea106caf5de11a83d7da24 2x, https://si.imgix.