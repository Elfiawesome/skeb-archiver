2b52-c98c-4f27-867d-a30235c81910?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4987298472fc412ab098640e3a5eef4a 2x, https://si.imgix.net/897f6d5f/uploads/origins/c36c2b52-c98c-4f27-867d-a30235c81910?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d456950373598dcf62f87621fe1755e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/897f6d5f/uploads/origins/c36c2b52-c98c-4f27-867d-a30235c81910?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73ee75cee8c73b0d2ce6066e3e9cf7c0", "srcset": "https://si.imgix.net/897f6d5f/uploads/origins/c36c2b52-c98c-4f27-867d-a30235c81910?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73ee75cee8c73b0d2ce6066e3e9cf7c0, https://si.imgix.net/897f6d5f/uploads/origins/c36c2b52-c98c-4f27-867d-a30235c81910?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=96bf24452a149c3c59e4a38ed51ae107 2x, https://si.imgix.net/897f6d5f/uploads/origins/c36c2b52-c98c-4f27-867d-a30235c81910?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=412a9aab6435fc135b7acb4ed4265bfc 3x"}, "body": "おまぐ様 \n\nお世話になっております。skebを開設されていたので是非、とリクエストをさせて頂きたく思いました。日頃クリエイター様にお伝えしている文章とは多少異なるのですが、幾つか同様に明記致します。\n\nリクエストしたい内容と致しましては『天ほろ＋子』になります。\n先ず資料につきましては一応添付させて頂くか悩んだのですが、最早不要かなと感じています。しかしながら子供の方は不明瞭が大きいと思うので、出ている資料ページなどをご参照頂ければと思います。\n\n・天とほろくんの姿、年齢は一緒になった後の夫婦のふたりでも、\n   企画、cs同様でも何でも嬉しいです。子供も誰でも構いません、どちら画の娘息子でも！尚服装などもアレンジ、省略して頂いて問題ありません。\n・シチュエーション等お好きに描いて頂けましたら幸いです。\n・好きにと言っても漠然としすぎているので例としまして、\n     両親に褒められている翔くんや露、\n     揺ちゃんが天に可愛がられてやきもち妬いているほろくん、\n     父に叱られてる又は叱られた後…の潮と宥めてるほろくん、\n     泡の舞台を観に来ている両親…など。勿論上のお姉ちゃんたちでも。\n・描写範囲もお任せしたく、またデフォルメ表現など含む場合でもとても嬉しいです！\n・用途：個人観賞用\n\n公開リクエストと言う点も含め推し自慢をしたい、また圧倒的に自分絵より本家の嫁が見たい気しかない私利私欲な内容になりますが…！お願いしたいとなれば数ある中でもやっぱりここかなと思いました。\n大変ご多忙の折かと存じますがもしもよろしければ、ご検討頂けますと幸いです。 よろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@omg3939/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2175416, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef7ed28e/uploads/origins/5d592527-7045-4804-9aba-67c1a0819c2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d61cd841982e5b9f82a29fdea07030b", "srcset": "https://si.imgix.net/ef7ed28e/uploads/origins/5d592527-7045-4804-9aba-67c1a0819c2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d61cd841982e5b9f82a29fdea07030b, https://si.imgix.net/ef7ed28e/uploads/origins/5d592527-7045-4804-9aba-67c1a0819c2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7416f997ffbc4689ac5b8afb83c00fef 2x, https://si.imgix.net/ef7ed28e/uploads/origins/5d592527-7045-4804-9aba-67c1a0819c2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab3a9c6dd68fb79e53423f5b403c82c0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef7ed28e/uploads/origins/5d592527-7045-4804-9aba-67c1a0819c2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7569425a91170b0990375f67fa045adc", "srcset": "https://si.imgix.net/ef7ed28e/uploads/origins/5d592527-7045-4804-9aba-67c1a0819c2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7569425a91170b0990375f67fa045adc, https://si.imgix.net/ef7ed28e/uploads/origins/5d592527-7045-4804-9aba-67c1a0819c2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a455e0b55fcf422f264df713b347588 2x, https://si.imgix.net/ef7ed28e/uploads/origins/5d592527-7045-4804-9aba-67c1a0819c2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a59f915e758fabe3897c0ece60a49df9 3x"}, "body": "初めまして。\nモン娘になりますがよろしいでしょうか。\n\nホイップクリームでできたスライム娘ちゃんを\nリクエストさせていただきます。\n容姿はツインテールの先端はクリームを放出する先端口で、\n首元などに赤い装飾品、頭にリボンとイチゴを乗せた姿です。\nそして濃厚なクリームを蓄えた超爆乳を持った、\nむっちり体型のスライム娘です。\n\nよろしければPSDで着衣なしのおっぱい差分を\n入れていただけると嬉しいです。\nこちらに資料をいくつか載せておきますので\nご検討のうえよろしくお願いします。\n\n資料その1\nhttps://skeb.jp/@k1llyutaka/works/1\n\n資料その2\nhttps://skeb.jp/@umebonsaikirei/works/1", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@omg3939/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/98d3994c/uploads/origins/d3694e6d-ee7a-46e2-8b53-053e22134d57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=611539a25a4e553f3fa9742f8d3a9976", "srcset": "https://si.imgix.net/98d3994c/uploads/origins/d3694e6d-ee7a-46e2-8b53-053e22134d57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=611539a25a4e553f3fa9742f8d3a9976, https://si.imgix.net/98d3994c/uploads/origins/d3694e6d-ee7a-46e2-8b53-053e22134d57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ed7106e67807275344fedbd30cc3916 2x, https://si.imgix.net/98d3994c/uploads/origins/d3694e6d-ee7a-46e2-8b53-053e22134d57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=329e3b34ad78b1f8b857d3b6685f05c9 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2175416, "nc": 177}, {"path": "/@omg3939/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9214798b/uploads/origins/17e89159-9301-472b-8f6f-3a32187b4950?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cro