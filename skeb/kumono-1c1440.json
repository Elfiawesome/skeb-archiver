uy5LmL5Yqp&txtclr=fff&txtfont64=QXZlbmlyLUJsYWNr&txtfit=max&txtalign=middle%2Ccenter&txtsize=60&txtshad=10&auto=format%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=8849de976f54bf22b7c0327c7f550b6d", "skills": [{"genre": "art", "default_amount": 10000}], "payment_methods": {"credit_cards": {"jcb": {"nsfw": true}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@kumono/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3123173, "client_id": 1472119, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9fb545c/uploads/origins/9e02aca8-a56d-4987-9207-37a2aff0dd51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94be39ccbe652e907af2783cc0f4a682", "srcset": "https://si.imgix.net/d9fb545c/uploads/origins/9e02aca8-a56d-4987-9207-37a2aff0dd51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94be39ccbe652e907af2783cc0f4a682, https://si.imgix.net/d9fb545c/uploads/origins/9e02aca8-a56d-4987-9207-37a2aff0dd51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28eaebb11054ce8b0ca036b5bf5f799e 2x, https://si.imgix.net/d9fb545c/uploads/origins/9e02aca8-a56d-4987-9207-37a2aff0dd51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9ab9cbc9766b8d01136e6e3d776a046 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9fb545c/uploads/origins/9e02aca8-a56d-4987-9207-37a2aff0dd51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4be14dd098cd223a546177eae20b6373", "srcset": "https://si.imgix.net/d9fb545c/uploads/origins/9e02aca8-a56d-4987-9207-37a2aff0dd51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4be14dd098cd223a546177eae20b6373, https://si.imgix.net/d9fb545c/uploads/origins/9e02aca8-a56d-4987-9207-37a2aff0dd51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3bbd2f07bce639771fb3c2324b9745c0 2x, https://si.imgix.net/d9fb545c/uploads/origins/9e02aca8-a56d-4987-9207-37a2aff0dd51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=baa04a17773307a5796f3adf621c0b6c 3x"}, "body": "こんにちは！以前、雲之助先生が描いてくれたリクエストが大好きです。 いつも見ていると嬉しくに泣いていますよ😭！！\n\nまたこの二人のオリジナルキャラを描いてくれませんか？もしご迷惑なら、遠慮なく断ってください🙇‍♀️！\n\n========================\n猫田譲 “ねこた ゆずる”\n26歳（黒髪）\n181cm / 68kg\n生年月日: 1973年 12月 12日\n\n親切で、真面目な人。優しく、正しく、責任感がある。12匹の猫を飼っている。いつも冬剞のことを気にかけている。3人の妹の面倒をみて守っているが、自分のことは何も残さない。子供の頃には純粋だった。でも、東京での会社員生活から戻った、空虚で疲れ切っているように見える。背が高く、色白で、イケてる。ちょっとだけの可愛い恥ずかしがり屋さんです。冬剞よりも背が高く、筋肉質だ。(被害者)\n--------------------\n淡宮冬剞 “あわみや ふゆき”\n25歳（紫髪）\n176cm / 57kg\n生年月日: 1974年 02月 09日\n\n高校生のとき、彼の \"大事なゆず \"に恋をした。家業は古い葬儀会館です。譲が教えてくれた温かさに報いるためなら、何でもする。譲によく甘やかされて、猫っぽい人。彼の秘密は幽霊が見えることです。譲を困らせることができる唯一の人物。綺麗で、怪しげで、イヤリングをしている。(アタック)\n--------------------\n同じ田舎町で育った幼なじみだ。卒業後、疎遠になった二人の親友。互いを深く思い合っているけど、いつも相手に負担や迷惑をかけることを恐れているのだ。\n\n幾つの困難を乗り越え、10年ぶりに再会した二人は付き合ってを始める。設定は1999年。\n==========================\n二人とも一緒に田舎で住んでいます。森が広く、古い家が多い。季節の移り変わりは彼らにとって特別なもので、特に冬や春に。二人の関係をやさしく描いていただけたら嬉しいです。\n\n冬剞が譲の顔や髪にそっと触れているところを描いていただけませんか？譲は時々冬剞のイヤリングや三つ編みを触るのが好きです。シーンは冬か秋ならいいと思います。\n\nこのリクエストを考慮していただき、ありがとうございます！先生のイラストはとても美しいです😭！\n\nhttps://drive.google.com/drive/folders/1ZRcXrFUCQtNY30f8HYxokTM4oLUkzwOE", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumono/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3123173, "client_id": 3223152, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2e85d010/uploads/origins/cfa5f2f1-1685-463b-8011-e708e6fa25e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ccb1338bd3a73fba577a78be53ea11d", "srcset": "https://si.imgix.net/2e85d010/uploads/origins/cfa5f2f1-1685-463b-8011-e708e6fa25e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ccb1338bd3a73fba577a78be53ea11d, https://si.imgix.net/2e85d010/uploads/origins/cfa5f2f1-1685-463b-8011-e708e6fa25e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe9b2bdb6afdd203a67149f8140f2c07 2x, https://si.imgix.net/2e85d010/uploads/origins/cfa5f2f1-1685-463b-8011-e708e6fa25e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93d730d38006dad55a8ac4648b710218 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e85d010/uploads/origins/cfa5f2f1-1685-463b-8011-e708e6fa25e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=292626c1b7c98de5c74b383bf21c11eb", "srcset": "https://si.imgix.net/2e85d010/uploads/origins/cfa5f2f1-1685-463b-8011-e708e6fa25e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=292626c1b7c98de5c74b383bf21c11eb, https://si.imgix.net/2e85d010/uploads/origins/cfa5f2f1-1685-463b-8011-e708e6fa25e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd32058eae816c1f5cf9f456d6942caf 2x, https://si.imgix.net/2e85d010/uploads/origins/cfa5f2f1-1685-463b-8011-e708e6fa25e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1f56e21dbd8865ebbc41f56b5eebbaf0 3x"}, "body": "こんにちは！\nskeb開設ありがとうございます。\n\n「きみに注ぐ」の安藤くんと大島くんをお願いできますと幸いです！\n\n「きみに注ぐ」が本当に大好きで、今でもいちばん好きなBLまんがです。\n当時「きみに注ぐ」を本屋さんでジャケ買いしまして、あまりの真っ直ぐさとド好みの顔だった安藤くんにドドドドハマりしました。\n(真由ちゃんも大好きです🥺)\nそんな安藤くんをお任せできるのはやっぱり大島くんだけだと思いますので、何卒よろしくお願いいたします。人生謳歌したいです！\n\n「幸せになるのさ！」「男の子と恋」とあわせたあのシリーズがずっとずっと大好きなので、願わくばまた彼らに会えたらいいなぁと思っています。\n\n雲之助先生のコミックス、「〜お料理男子」まで全て揃えてまして、今でも読み返しています。最近イラストたくさん見れて嬉しいです！\n\nskebなのに重ためのお気持ちメッセージをお送りし申し訳ございません…！🙇‍♀️\n\n今後とも陰ながら応援しております！\n\n(「恋人アソート」の時の渋谷のサイン会にもお邪魔いたしました！あの時いただいたサイン本と小冊子とお土産、宝物です！！)\n\n===\n※一度エラーが出てしまいリクエストし直しております。\nもし二重にリクエストしていた場合は片方を破棄いただければ幸いです。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumono/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3123173, "client_id": 326249, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e06b8ce/uploads/origins/1d00a651-eee5-4195-925f-dd00a5b537a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8ff74a2fcd8dcfc16188eb9a0e774d3", "srcset": "https://si.imgix.net/0e06b8ce/uploads/origins/1d00a651-eee5-4195-925f-dd00a5b537a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8ff74a2fcd8dcfc16188eb9a0e774d3, https://si.imgix.net/0e06b8ce/uploads/origins/1d00a651-eee5-4195-925f-dd00a5b537a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1c72119dc231eae2724509104516943 2x, https://si.imgix.net/0e06b8ce/uploads/origins/1d00a651-eee5-4195-925f-dd00a5b537a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0210fd25698cba9b61aa95904cfabf62 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e06b8ce/uploads/origins/1d00a651-eee5-4195-925f-dd00a5b537a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=acb31afdbbe6cca6abe1ce25a9535e30", "srcset": "https://si.imgix.net/0e06b8ce/uploads/origins/1d00a651-eee5-4195-925f-dd00a5b537a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=acb31afdbbe6cca6abe1ce25a9535e30, https://si.imgix.net/0e06b8ce/uploads/origins/1d00a651-eee5-4195-925f-dd00a5b537a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a21c0d237b31ec73b1856588fc3c4b6d 2x, https://si.imgix.net/0e06b8ce/uploads/origins/1d00a651-eee5-4195-925f-dd00a5b537a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2a4afe7e7516c5590c3bace469dd6f96 3x"}, "body": "先生、はじめまして！先生の描くキャラクターの表情はとても生き生きとしていて温かみがありますね❤️（アイドリッシュセブンの絵も素晴らしいです！）。\n私のOCの絵をお願いすることは可能でしょうか？\n\n\nノーマッド：18歳の男の子。身長179cm。太い眉毛と子犬のような素直な目が特徴。自分に厳しく厳しいが、友人（特にアルタラ）には温かく優しい。アルタラとは幼なじみ。ノーマッドはアルタラへの想いが家族以上のものであることを知っている。アルタラがより大きな運命に執着していることを知っているため、ノーマッドは自分の気持ちをアルタラに告げず、アルタラのそばにいてアルタラのために身を捧げることに喜びを感じている。ノーマッドは過剰なまでの自己犠牲の美徳を持ち、強い道徳的良心も持っているが、アルタラが必要なときに他人の命を奪うことができないと知ったとき、この2つの特徴が最悪の結果を形成する。だからノーマッドが彼のために殺人を行う。このことが彼の内面を徐々に破壊していく。  \nノーマッドの最大の願いは、アルタラが幸せになるのを見ることだ。アルタラの笑顔を見るのが大好きなのだ。  \n\nアルタラ：16歳の少年で、銀色の髪、銀色のまつげ、紫色の瞳をしている。アルタラの目は柔らかい形をしている（目の形は棗巳波に似ている）。共感力があり、好奇心旺盛。身長は171cm。神話に登場する紫の瞳の魔道士だが、その力をコントロールするのが難しい。現在はエレメンタル・マジックの正しい使い方を学ぶ旅に出ている。数年前、両親とはぐれたアルタラをノーマッドの家族が引き取った。幼いころはノーマッドに頼りきりだったが、次第に自立するようになった。\nすみれ色の瞳の魔道士は常に極端な感情に突き動かされるが、アルタラも例外ではない。ノーマッドの存在は彼に多くの情緒的安定を与え、彼はノーマッドを家族、親友、家族、そしてその存在が呼吸をするように自然な人と見ている。  しかし、ノーマッドの自己破壊願望を見抜くことはできなかった（おそらくこのように見るのは不本意だったのだろう）。  \n*ノーマッドとアルタラの衣装と画像はURLにあります。アルタラの衣装は2種類！先生は好きな方を選んで描いてください。  \n\n\n私の依頼：\n可能であれば、ノーマッドがアルタラの額にキスしているところが見たいです。とても穏やかで自然な仕草で、兄と弟の純粋な家族愛を表現しているような。二人とも微笑んでいる。\n\n\n 自由に描いてください！ご検討ありがとうございました＞❤️\n\nhttps://drive.google.com/drive/folders/1-_qZdBiVePV8nzgM3PQsl8YW2mZ7xrCF", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumono/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3123173, "client_id": 1472119, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73a5cd1b/uploads/origins/f457a35d-2a2b-4f66-b1d9-08666c4ce1a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acd887e9ca6a0001f15c1a66b1a06462", "srcset": "https://si.imgix.net/73a5cd1b/uploads/origins/f457a35d-2a2b-4f66-b1d9-08666c4ce1a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acd887e9ca6a0001f15c1a66b1a06462, https://si.imgix.net/73a5cd1b/uploads/origins/f457a35d-2a2b-4f66-b1d9-08666c4ce1a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cc4ed354e49e923f211eac560797715 2x, https://si.imgix.net/73a5cd1b/uploads/origins/f457a35d-2a2b-4f66-b1d9-08666c4ce1a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69b10ee5aeb7894a2a6d9ef4f9766cdc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73a5cd1b/uploads/origins/f457a35d-2a2b-4f66-b1d9-08666c4ce1a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a5e9bc6de66b4db9a87cf0feb87958a", "srcset": "https://si.imgix.net/73a5cd1b/uploads/origins/f457a35d-2a2b-4f66-b1d9-08666c4ce1a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a5e9bc6de66b4db9a87cf0feb87958a, https://si.imgix.net/73a5cd1b/uploads/origins/f457a35d-2a2b-4f66-b1d9-08666c4ce1a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bf4bb391896763b057388aec644ac66b 2x, https://si.imgix.net/73a5cd1b/uploads/origins/f457a35d-2a2b-4f66-b1d9-08666c4ce1a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=78ec8e8e06664a6b07e58a00416855c4 3x"}, "body": "初めまして！雲之助先生の作品がとても好きなので、二人のオリジナルキャラを頼みたいです。\n\n特にこの優しい絵がすごく大好きです。\nhttps://skeb.jp/@kumono/works/2\nhttps://skeb.jp/@kumono/works/1\n========================\n猫田譲 “ねこた ゆずる”\n26歳（黒髪）\n181cm / 68kg\n生年月日: 1973年 12月 12日\n\n親切で、真面目な人。優しく、正しく、責任感がある。12匹の猫を飼っている。いつも冬剞のことを気にかけている。3人の妹の面倒をみて守っているが、自分のことは何も残さない。子供の頃には純粋だった。でも、東京での会社員生活から戻った、空虚で疲れ切っているように見える。背が高く、色白で、イケてる。ちょっとだけの可愛い恥ずかしがり屋さんです。冬剞よりも背が高く、筋肉質だ。(被害者)\n--------------------\n淡宮冬剞 “あわみや ふゆき”\n25歳（紫髪）\n176cm / 57kg\n生年月日: 1974年 02月 09日\n\n高校生のとき、彼の \"大事なゆず \"に恋をした。家業は古い葬儀会館です。譲が教えてくれた温かさに報いるためなら、何でもする。譲によく甘やかされて、猫っぽい人。彼の秘密は幽霊が見えることです。譲を困らせることができる唯一の人物。綺麗で、怪しげで、イヤリングをしている。(アタック)\n--------------------\n同じ田舎町で育った幼なじみだ。卒業後、疎遠になった二人の親友。互いを深く思い合っているけど、いつも相手に負担や迷惑をかけることを恐れているのだ。\n\n幾つの困難を乗り越え、10年ぶりに再会した二人は付き合ってを始める。設定は1999年。\n==========================\n二人とも一緒に田舎で住んでいます。森が広く、古い家が多い。季節の移り変わりは彼らにとって特別なもので、特に冬や春に。二人の関係をやさしく描いていただけたら嬉しいです。\n\nよろしければ、二人の甘美な交流を描いていただけませんか？\n\nよろしくお願いします...!!\n\nhttps://drive.google.com/drive/folders/1ZRcXrFUCQtNY30f8HYxokTM4oLUkzwOE?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumono/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3123173, "client_id": 66701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a4cc9ed/uploads/origins/9768ca59-74b6-4639-8033-a7f6ef60835b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c5c611cd327f9351422ca90d9d66dc4", "srcset": "https://si.imgix.net/6a4cc9ed/uploads/origins/9768ca59-74b6-4639-8033-a7f6ef60835b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c5c611cd327f9351422ca90d9d66dc4, https://si.imgix.net/6a4cc9ed/uploads/origins/9768ca59-74b6-4639-8033-a7f6ef60835b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d41357089d7b0bf3259c62c5180a7261 2x, https://si.imgix.net/6a4cc9ed/uploads/origins/9768ca59-74b6-4639-8033-a7f6ef60835b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d576d0279c5574da26237e325026616c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a4cc9ed/uploads/origins/9768ca59-74b6-4639-8033-a7f6ef60835b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e414e1845da44c915496a2725ca95660", "srcset": "https://si.imgix.net/6a4cc9ed/uploads/origins/9768ca59-74b6-4639-8033-a7f6ef60835b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e414e1845da44c915496a2725ca95660, https://si.imgix.net/6a4cc9ed/uploads/origins/9768ca59-74b6-4639-8033-a7f6ef60835b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5cf8d6b3048d25b21907e2a5f44c763f 2x, https://si.imgix.net/6a4cc9ed/uploads/origins/9768ca59-74b6-4639-8033-a7f6ef60835b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=276a562a10b9782bfd9f2a2de7530c94 3x"}, "body": "雲之助さんこんにちは！Skeb開設ありがとうございます！\n雲之助さんのかわいらしいタッチと、柔らかな表情、あたたかな雰囲気が大好きです。\n是非友人とのキャラクターをかいていただきたく、リクエストさせていただきます。\n\n白髪…ユウシュウ\n一人称：俺。声が大きくハキハキとして明るく論理的な話し方\nキャラクター：\n身長182㎝。体重74キロ。鍛えている体つき。宇宙飛行士を目指している、文武両道で明るく素直、人なつこく真面目な性格。\n世話をされることも好きだが、実は世話をするのも好き。犬っぽい。\n赤髪のことを「ナルネ」と呼ぶ。\n\n赤髪…ナルネ\n一人称：私（気が弛んだ時は僕）。柔らかい声質で基本敬語（気が弛むとちょっと生意気な口調）\nキャラクター：\n赤髪…身長166㎝。体重50キロ。華奢な体つき。人のプロデュースや世話をするのが好き。基本笑顔を絶やさず飄々とした性格。\n世話をすることは大好きだが、されるのは苦手。猫っぽい。\n白髪のことを「ユウシュウさん」と呼ぶ。\n\n最近二人は気持ちが通じあい、両思いになりました。\n基本赤髪は白髪に従います。\nでも白髪をからかうのも大好きで、たまに悪戯をします。\n白髪はとても素直に好意を伝えますが、赤髪はあまり素直じゃありません。\nそれでも相手に幸せになってもらいたいと思っており、二人きりの時はたまに甘えます。\n\n関係性の例としては、\n\n・赤髪は都合が悪くなると「いい天気ですね」「洗濯物は乾いたでしょうか」とかすごく雑に話を逸らそうとし、白髪が「わかりやすく話を逸らすな！」とつっこむ。\n・赤髪が白髪をおんぶしたり、頭を撫でたりしていると白髪が眠くなる。\n・赤髪の少し割り切りすぎな言動に白髪がむ、となる。\n・白髪の無邪気で素直な様子に赤髪が眩しそうにしている。\n・なんでもニコニコ沢山食べる白髪と、手早く少量で食事を済ませる赤髪\n・赤髪が悩んでいたり具合が悪そうだと本人以上に心配する白髪\n・すごく優しく笑って好意を告げてくれる白髪と、そうされると黙ってしまう赤髪。\n・一緒に寝る\n\n雲之助さんのかかれる料理が大好きなため、料理をする・食事を食べる、など料理にかかわるシーンをかいていただけるととても嬉しいです！服装などはご自由にしてください。\n描いて頂いたものは個人で楽しむ範囲で印刷などさせていただければなと思っています。\n\nご検討のほど何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1EOgSKqm3sc9357NoTnMx_d1U8mrLijXh?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumono/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3123173, "client_id": 3123604, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76fb64d0/uploads/origins/521ffedf-f147-4cd3-b6dd-53576c56243a?bg=%23fff&auto=fo