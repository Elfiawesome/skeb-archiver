://www.deviantart.com/claparo-sans/art/Creation-851046935\n\nしかし、彼女の具体的な内容はお任せします。簡単なポーズで良いので、彼女のデザインをアピールしてください。\n\nよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yahm_ai/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1147, "client_id": 206892, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c51d3106/uploads/origins/47dd4d36-001e-4a65-9761-9389bae27291?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=287942a9153afe227fed19e2980b0312", "srcset": "https://si.imgix.net/c51d3106/uploads/origins/47dd4d36-001e-4a65-9761-9389bae27291?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=287942a9153afe227fed19e2980b0312, https://si.imgix.net/c51d3106/uploads/origins/47dd4d36-001e-4a65-9761-9389bae27291?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a057fa038ff1a8ec4408a0046f34ff2 2x, https://si.imgix.net/c51d3106/uploads/origins/47dd4d36-001e-4a65-9761-9389bae27291?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68ae71ed5163189dda3b420df8471b36 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c51d3106/uploads/origins/47dd4d36-001e-4a65-9761-9389bae27291?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a229240bf360b83cf3863b586938e349", "srcset": "https://si.imgix.net/c51d3106/uploads/origins/47dd4d36-001e-4a65-9761-9389bae27291?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a229240bf360b83cf3863b586938e349, https://si.imgix.net/c51d3106/uploads/origins/47dd4d36-001e-4a65-9761-9389bae27291?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d0cd6522ab6309ba102ae28fd614ba26 2x, https://si.imgix.net/c51d3106/uploads/origins/47dd4d36-001e-4a65