c8-69b0-4b83-8bc5-3924ad1aef31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3ba04c9e0eb4b3a303ea3908d5013df, https://si.imgix.net/366a13cd/uploads/origins/88eeaac8-69b0-4b83-8bc5-3924ad1aef31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d7cc9160f630e2a34d0b1618a46cc035 2x, https://si.imgix.net/366a13cd/uploads/origins/88eeaac8-69b0-4b83-8bc5-3924ad1aef31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eb6e28ae4e8ece7cccaac8afae80b5b3 3x"}, "body": "前回は金剛さんのイラストありがとうございました！\nとても美しい作品で個人的にも満足していますし、\n色んなフレンドからも凄い！と大変評判良かったです！\n\nそこで今回は同じヒノシズム所属のりゅーがちゃんの大人バージョンを描いて頂きたいです。\n”雷閃の銀孤”の通り名がありますので、雷を纏って敵に突っ込もうとしようとしている姿を描いて頂きたいです。\n\nよろしければお願いいたします。\n\n大人りゅーがちゃん資料\nhttps://twitter.com/3pond_rond/status/1500325306413895687\nスクショ\nhttps://twitter.com/Whimsical_blue0/status/1499912371455737856\nhttps://twitter.com/Whimsical_blue0/status/1499911006356578307\nhttps://twitter.com/Whimsical_blue0/status/1499908102576951303\nヒノシズム設定資料集\nhttps://booth.pm/ja/items/2827004", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yahm_ai/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1147, "client_id": 206892, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0b050e8/uploads/origins/671622d5-41e0-4df4-848c-dbd86ff5d38d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c475db2b433db5c027e63682c7c58ab", "srcset": "https://si.imgix.net/b0b050e8/uploads/origins/671622d5-41e0-4df4-848c-dbd86ff5d38d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c475db2b433db5c027e63682c7c58ab, https://si.imgix.net/b0b050e8/uploads/origins/671622d5-41e0-4df4-848c-dbd86ff5d38d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb764799f963f0bdf7d27de47abb14d9 2x, https://si.imgix.ne