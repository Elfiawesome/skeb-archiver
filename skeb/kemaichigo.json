itter：https://twitter.com/sacura0\n※参考Youtubeチャンネル：https://www.youtube.com/c/sacura0610\n\n不明瞭でしたらすみません。\n可能でしたら、どうぞよろしくお願いいたします…！\n\n白河ノさくら🌸\n\nhttps://drive.google.com/drive/u/2/folders/15PD00ThrE4qlBywngk7HW7og8Je7LSgM", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kemaichigo/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3099462, "client_id": 3620563, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea40619e/uploads/origins/c4f548d4-4896-4617-9298-ec2b1a978955?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a27d422d6f91c58ff64e921ec5ca180e", "srcset": "https://si.imgix.net/ea40619e/uploads/origins/c4f548d4-4896-4617-9298-ec2b1a978955?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a27d422d6f91c58ff64e921ec5ca180e, https://si.imgix.net/ea40619e/uploads/origins/c4f548d4-4896-4617-9298-ec2b1a978955?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c81917c1130df95f3ef9bfa5d0037e0a 2x, https://si.imgix.net/ea40619e/uploads/origins/c4f548d4-4896-4617-9298-ec2b1a978955?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c446d4bf3db6d3ba55b5bb2ad4820e6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea40619e/uploads/origins/c4f548d4-4896-4617-9298-ec2b1a978955?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c48de3f5e1f412d228fe504a3a41327", "srcset": "https://si.imgix.net/ea40619e/uploads/origins/c4f548d4-4896-4617-9298-ec2b1a978955?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c48de3f5e1f412d228fe504a3a41327, https://si.imgix.net/ea40619e/uploads/origins/c4f548d4-4896-4617-9298-ec2b1a978955?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1