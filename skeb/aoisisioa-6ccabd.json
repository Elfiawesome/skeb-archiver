in the dialogue.\nI will leave the composition and situation to you.\nThank you in advance.", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aoisisioa/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9f476927/uploads/origins/63468e09-1038-4e49-894c-e8aa76a33c06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab6fc099903a165f3113459207273bef", "srcset": "https://si.imgix.net/9f476927/uploads/origins/63468e09-1038-4e49-894c-e8aa76a33c06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab6fc099903a165f3113459207273bef, https://si.imgix.net/9f476927/uploads/origins/63468e09-1038-4e49-894c-e8aa76a33c06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9ff0de2ded35462392233ab1be6be61 2x, https://si.imgix.net/9f476927/uploads/origins/63468e09-1038-4e49-894c-e8aa76a33c06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9edaffb0fb816b890960e5ecd4af18ae 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2608663, "client_id": 611399, "nc": 176}, {"path": "/@aoisisioa/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2608663, "client_id": 2854328, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f5358db7/uploads/origins/c5866652-73fa-4446-b89b-d111bee5e9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=425ad8fae47f3946228f0764276da6d8", "srcset": "https://si.imgix.net/f5358db7/uploads/origins/c586665