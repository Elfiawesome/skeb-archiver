t": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aoisisioa/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2608663, "client_id": 2010193, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b2b8855/uploads/origins/da4c4689-ed41-4174-a13c-85b503903786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8c49543763e0a7b0e026126e0dc5dbb", "srcset": "https://si.imgix.net/4b2b8855/uploads/origins/da4c4689-ed41-4174-a13c-85b503903786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8c49543763e0a7b0e026126e0dc5dbb, https://si.imgix.net/4b2b8855/uploads/origins/da4c4689-ed41-4174-a13c-85b503903786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9cf56f1094d3532fa1f17326f24572c4 2x, https://si.imgix.net/4b2b8855/uploads/origins/da4c4689-ed41-4174-a13c-85b503903786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d14b27f1fc5cdbbeafd16b87285db071 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b2b8855/uploads/origins/da4c4689-ed41-4174-a13c-85b503903786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9d1faf044bbd8c0922964545780f22d", "srcset": "https://si.imgix.net/4b2b8855/uploads/origins/da4c4689-ed41-4174-a13c-85b503903786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9d1faf044bbd8c0922964545780f22d, https://si.imgix.net/4b2b8855/uploads/origins/da4c4689-ed41-4174-a13c-85b503903786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc2d1a318bb2b152d492efabd8853dbd 2x, https://si.imgix.net/4b2b8855/uploads/origins/da4c4689-ed41-4174-a13c-85b503903786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=44ef8a5248b86edb000e844dfb55dab0 3x"}, "body": "Dear Souku Ryu Kaya, My name is Unikross and I would like to thank you for your help.\nThank you very much for your wonderful illustrations in the past!\nI was very, very happy to have it as a standby for all of us to enjoy.\nI would like to ask you to draw another OC with my friend.\nIf there are any problems with both the price and the request, please cancel or resend.\n\nThe request is for two people who are in a peaceful everyday life together.\nWe would like to have an illustration of two people in their daily lives, spending time together peacefully, or engaging in loverly activities.\nI will leave NSFW enabled, so I would appreciate it if you could draw it as you like.\nThese two are OC created in a TRPG.\nYou are free to do whatever you like in terms of composition and clothing.\nThe relationship between them is A and B.\nI will be very happy if A has a dominant and sadistic expression on her face!\nWe are lovers in a master-slave relationship, so we would be happy if we can see that kind of atmosphere.\n\nI would be very happy if you could see the dominant and sadistic expression on A's face.\nI would like to use it as wallpaper or icon for my and my partner's SNS or discord.\nWhen you draw a picture, you can post it on SNS with the URL when you report the drawing.\nFor personal viewing and non-commercial merchandising for you and your partner.\nAny of the above that are not for personal use.\n\nThey are very precious to us, and we would be very grateful if we could have a chance to work with them.\n\nhttps://drive.google.com/drive/folders/1W4DG8De4dI444dxEwx_SKiUKluhuMTvv?hl=ja", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aoisisioa/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2608663, "client_id": 1620481, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41d75bbf/uploads/origins/b2b5bd98-3414-4564-a1