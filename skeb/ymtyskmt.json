webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5381a954310b8eb591e440d9e5b8fa5", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2605555, "client_id": 343924, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ymtyskmt/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2605555, "client_id": 946151, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e28b05a/uploads/origins/700f2e5e-db47-4f8d-9004-67c23bb47bc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfbbce80dc90e3367b1e3fda0f4e2a62", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e28b05a/uploads/origins/700f2e5e-db47-4f8d-9004-67c23bb47bc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38a247c8f641be205742b552937c31e3", "src_set": ""}, "body": "私の要望を考慮していただき、ありがとうございました！\n\nTRPGをtwitchで配信しているのですが、自分のキャラクターだけでなく、友人のキャラクターのアートも頂きたいです！ライブの時や休憩時間に、クレジットを入れて作品を見せたいと思います！\n\n友人のキャラクターはArg0sという名前ですhttps://imgur.com/a/WKZ3Tmk。\nSF的な未来設定から来たかっこいいストリーマーです！クールでカリスマ的な存在です。小さなアンテナを持っています！エスパーなんです！\n\n私のキャラクターの名前はミックです。https://imgur.com/a/1iNr4eX\n彼女はとてもシャイなAIで、彼のチャットのモデレーターを務めています。爪や尻尾など、ドラゴンの特徴を持っています！\n\n2人が楽しく遊んでいるところ、ゲームをしているところ、ストリーミングをしているところ、散歩をしているところなど、2人の姿を描いていただけたら最高です！二人はお互いをとても大切に思っている、パートナーです！\n\n本当にありがとうございました！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ymtyskmt/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2605555, "client_id": 2004074, "vtt_url": null,