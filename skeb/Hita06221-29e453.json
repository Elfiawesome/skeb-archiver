bnail_image_urls": {"src": "https://si.imgix.net/3996f4e6/uploads/origins/cb21d18f-5f33-422d-b1d6-9f7e664cd6bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=329b35bc99ab66af33fb3d1dc1b987a0", "srcset": "https://si.imgix.net/3996f4e6/uploads/origins/cb21d18f-5f33-422d-b1d6-9f7e664cd6bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=329b35bc99ab66af33fb3d1dc1b987a0, https://si.imgix.net/3996f4e6/uploads/origins/cb21d18f-5f33-422d-b1d6-9f7e664cd6bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=adf50bba07118e592cf2a038baa04aa1 2x, https://si.imgix.net/3996f4e6/uploads/origins/cb21d18f-5f33-422d-b1d6-9f7e664cd6bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=141acb5720accdd4bf5a979db930035a 3x"}, "body": "初めまして、ざだるおん様\n\n童貞と申します。\n\nXやblueskyで投稿されていました、デジモンのイラストを拝見してリクエストしたいと思い、この場を借りてメッセージを送りました。\n\nリクエストするのは、ねこに転生したおじさんとデジモンを合わせてパロディ化したイラストです。\nざだるおん様のアイコンのもちもちふわふわしたピコデビモンをねこに転生したおじさんの主人公のプンちゃんのようにゴロゴロしている感じのイラストをお願いします。\n\nfps的な飼い主視点でピコデビモンに手を差し出していて、ピコデビモンは腹を見せつけて自分がかわいいということを自覚している風に振る舞っている感じで。\n\nパロディ元のねこに転生したおじさん要素でピコデビモンはアポカリモンが退化した、という設定でお願いします。\nピコデビモンの背後に幽霊のように半透明のアポカリモンの姿がありピコデビモンが可愛い家猫のようにゴロゴロと腹を見せて媚びるポーズをすると背後のアポカリモンも媚びるポーズをする、という感じでお願いします。\n\n元ネタのねこに転生したおじさんが面白い作品なので猫たちの部分をデジモンで見たいという欲望からきたリクエストです。\n\n背景や構図に指定はありません。\nゴロゴロしたポーズや媚びたポーズと要望を入れましたがざだるおん様が可愛い！と思うピコデビモンのポーズであればそちらでも問題ありません。ピコデビモンの背後に浮かぶデジモンは別のデジモンでも大丈夫です。\n\nお引き受けいただければ幸いです。\n難しいようでしたらお断りしていただいて構いません。\n\nよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 953583, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "PODO珀镀", "screen_name": "PDOzip", "avatar_url": "https://pbs.twimg.com/profile_images/1676296120593690624/FcmJDTb8.png", "header_url": "https://pbs.twimg.com/profile_banners/1325971071766441984/1688266593/1500x500"