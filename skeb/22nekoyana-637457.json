ekoyana/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 896782, "client_id": 880066, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc67eb4d/uploads/origins/377b209c-662e-4145-8848-59e086fa56bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9aca5e3e322ec0ac1a57cf8f6b529d6d", "srcset": "https://si.imgix.net/bc67eb4d/uploads/origins/377b209c-662e-4145-8848-59e086fa56bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9aca5e3e322ec0ac1a57cf8f6b529d6d, https://si.imgix.net/bc67eb4d/uploads/origins/377b209c-662e-4145-8848-59e086fa56bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=decd961a1f436ecaac0edb99c71e184a 2x, https://si.imgix.net/bc67eb4d/uploads/origins/377b209c-662e-4145-8848-59e086fa56bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fca94cabd7fb25a7f31b2e8d84727c46 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc67eb4d/uploads/origins/377b209c-662e-4145-8848-59e086fa56bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=281c7ff56e8d241d75d36740e1eac6b5", "srcset": "https://si.imgix.net/bc67eb4d/uploads/origins/377b209c-662e-4145-8848-59e086fa56bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=281c7ff56e8d241d75d36740e1eac6b5, https://si.imgix.net/bc67eb4d/uploads/origins/377b209c-662e-4145-8848-59e086fa56bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a5a671d952e0a173d66b94ff24cdaee0 2x, https://si.imgix.net/bc67eb4d/uploads/origins/377b209c-662e-4145-8848-59e086fa56bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=af07e28ebb91ee231fe8d37737179a8d 3x"}, "body": "はじめまして、こんにちは。\n前々から見てみたいイラストがあったのでこちらで投げさせていただきました。\nよければ猫柳さんの青肌ちゃんのえっちなイラストをお願