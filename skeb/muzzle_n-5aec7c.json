reator_id": 23779, "client_id": 443427, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc9b2799/requests/109828_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f0482b8c345714c4758a92df59261d3", "srcset": "https://si.imgix.net/cc9b2799/requests/109828_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f0482b8c345714c4758a92df59261d3, https://si.imgix.net/cc9b2799/requests/109828_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db62c8182b4550eed8ad3a9335f29e18 2x, https://si.imgix.net/cc9b2799/requests/109828_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66601d4e79e986727f04ff85aa3b8ce1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc9b2799/requests/109828_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa97d8850985c83c580624c19a905d9a", "srcset": "https://si.imgix.net/cc9b2799/requests/109828_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa97d8850985c83c580624c19a905d9a, https://si.imgix.net/cc9b2799/requests/109828_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cec75d585ad65b0f811e9cbe6128143a 2x, https://si.imgix.net/cc9b2799/requests/109828_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=21ea4c57c779b658401147cd11235401 3x"}, "body": "はじめましてです。よろしければお願いします。\nデスクトップアーミー\n人の消えた世界で、自然と同化しつつある都市内をメガサイズ(身長145cm人間容姿)の某学校制服を着たシルフィーがDTAサイズのシルフィーⅡモードＢと一緒に探索しているシチュでお願いします。\n\n以下文字数埋め設定\nピプロロ♪\n間抜けな音と共に起動シーケンスを開始する。\n長期間起動していないので各部診断モード開始...\n長期間？日付を見ると約７年ぶりの起動であることが判る。\nどういうことだろう？私はメガサイズ(人間サイズ)として開発されていた試作モデルだったはずなのに...計画中に研究所が傾いて頓挫したパターンですか？\nピロン～♪ \n診断終了とりあえず問題なしにゃー\nアバウトな診断結果を言われて視覚情報が解放される\n眼を覚ますと室内が真っ暗だった。別に夜とかいうわけでなく非常灯だけついているみたいな？そしていつもと違うのは、毎回起動を見守るように見ていた博士や研究所の人達がいなかった\nピロリン♪\n１通のシステムメールが届く\nえっと何々？\n要約すると研究所の電源設備がトラブルったのでこのままここで寝てるとバッテリーが切れて飢え死にするから最寄りの研究所へ移動してねとのことだった\nあぁそれで起こされたのね私\nクレイドルから起き上がりさっそく移動する為の準備を開始する\nいつもなら起動後に今週のお奨めラインナップ服が多数用意されていて女性研究所職員の手により着せ替え人形フィーバーという時間が始まるのだが、今日は誰もいないし服を着るのもめんどくさいし生まれた姿のままで行くことにした\n私は部屋の出口へ向かいドアに手をかけようとしたところ\n「待てやこの馬鹿猫がー！」\nという声と共に左頬へ蹴りを食らいグヘーと言いながら私は床へ転がった\n「真っ裸で外出しようとか何考えてますか」\n目の前に身長８cm程度のＤＴＡシルフィーⅡモードＢが降り立った\n私のナビゲート兼子守り役の２Ｂさんである\n「いや、人の気配もないし服も見当たらないし裸でもいいかなーって」(ﾃﾍ\nはーっとひとつため息をついた２Ｂさんは、あなたは人の姿を精密に模倣してるのだから少しは女性の常識をですね...説教が始まり、小一時間グヘーした\nその後、人が居ない世界になってるとか、職員さんのロッカーから学生服等を発見したりと旅の準備を整えた私達は終わらない旅へ出発した。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@muzzle_n/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 23779, "client_id": 120709, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea0f266c/requests/97323_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc56c67f38b93ecc77c5da3a6b6af5d4", "srcset": "https://si.imgix.net/ea0f266c/requests/97323_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc56c67f38b93ecc77c5da3a6b6af5d4, https://si.imgix.net/ea0f266c/requests/97323_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d9a9368027fa65a913fedb176a49a3e 2x, https://si.imgix.net/ea0f266c/requests/97323_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ecebd3deda479b71664b65ad9c8343a7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea0f266c/requests/97323_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbcbb1dcda2504c85a3cc03123499713", "srcset": "https://si.imgix.net/ea0f266c/requests/97323_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbcbb1dcda2504c85a3cc03123499713, https://si.imgix.net/ea0f266c/requests/97323_0?bg=%2