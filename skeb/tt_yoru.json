63d7b-b0cb-490d-831a-68ab3167e845?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b631f049ce5ace51a85724b1ec17c2d0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/282d9b73/uploads/origins/15e63d7b-b0cb-490d-831a-68ab3167e845?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b72a24ad7482cbe7110cde59465873fa", "src_set": ""}, "body": "初めまして！＋さんの色使いがとても素敵だなと思いましたのでご依頼させて頂きます。\n以下のキャラクターを描いて頂けましたら幸いです。\n\n◼︎キャラクター\n【1人目】\n・イチョウを擬人化したキャラクター\n・落ち着いた性格の青年。楓が幼い頃から面倒を見ている\n・楓のことが恋愛的に好きだが表には出さない\n★頭の横に緑の葉が生えています。\n★頭のてっぺんにもツノや耳にも見える葉が生えています\n・狩衣をモチーフとした衣装です\n・青年時代は金髪、若い頃は緑髪\n\n【2人目】\n・楓を擬人化したキャラクター\n・謙虚で落ち着いた性格の少女\n・幼い頃から面倒を見てくれたイチョウのことを慕っている\n・イチョウのことが好き\n★前髪には黄色と緑のメッシュが入っています。\n★後髪には黄色のメッシュが入っています。\n・袂が楓の葉のようになった袴を着ています\n・年頃になったら朱色の髪、若い頃は緑髪\n\nキャラクターデザインの詳細はURLをご参照ください。\n\n◼︎シチュエーション\n・お互いに信頼しあっているような、穏やかな2人の姿を描いて頂きたいです\n\n◼︎使用用途\n・各種SNSへの投稿、ヘッダー画像・アイコンとして使用\n\nhttps://drive.google.com/drive/folders/1-PIE_DUuaioOw0sLCn3fjo7F0WPnACa4\n\nhttps://drive.google.com/drive/folders/1-PIE_DUuaioOw0sLCn3fjo7F0WPnACa4", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/34", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1413513, "client_id": 1034084, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8859332/uploads/origins/41413409-6fd2-4320-b0bd-d9476338ea0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=deea3b3b0331b1364cbc9e71ce8d9aeb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8859332/uploads/origins/41413409-6fd2-4320-b0bd-d9476338ea0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1012850c59be21c9a0454cfe64534ce5", "src_set": ""}, "body": "こんにちは！あなたの作品はとても魅力的ですね！\n私の2人のオリジナルキャラクターについてお願いがあります。\nカミーロ（金髪）：パトロン。親しみやすく、いつもニコニコしている。しかし、愛というものを知らず、普通の人間のふりをしている。\nサエ（黒髪）：アーティスト。ひねくれた性格で、いつも不快な笑みを浮かべている。芸術家としての狂気と情熱を持っている。\n考えられる要素画廊、額縁、または白いハトがいるヨーロッパ（イタリア）風の街並み\n\nお読みいただきありがとうございます。構図や要素は自由に決めてください！\n\nhttps://drive.google.com/drive/folders/1wiXuEUaLpKskEJahZepd7jUp36FP9XkX?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/33", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cc47fdac/uploads/origins/4aa46e03-fa2e-42d5-a3af-23bd7ecd151a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23f608692aeaf50180a4959c9f6ddd63", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1413513, "client_id": 1223350, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/32", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1413513, "client_id": 2423739, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d78ca4c7/uploads/origins/362f00f5-1462-4e86-bd05-12537e6036a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8943bfab6923a4e1bbc76f098e258194", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d78ca4c7/uploads/origins/362f00f5-1462-4e86-bd05-12537e6036a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=432617d1dd1a24cf3ccf5350cc815b24", "src_set": ""}, "body": "こんばんは、初めまして。\n\n＋様の透き通るように繊細でロマンティックな作品に惹かれ、依頼できる日を心待ちにしておりました。ぜひ私のOCを描いて頂けないでしょうか？\n\n【設定】\n魔法使いの男の子。17歳。170cm。穏やか。\n\n気の向くまま旅している。\n海の中など水の中にいることが好き。\n魔法使いなので水中でも息ができる。\n\n【特徴】\n右目の下に黒子１つ\n両耳にピアス各１\n\n【キャラモチーフ】\nアメシスト(宝石)\n\n【希望】\n水中\n\n【雰囲気】\nロマンティック\n\n【衣装】\n2種のうちどちらでも\n柄は全て省略・単色に変更などアレンジOKです。描きやすいよう全て自由にシンプルにできます。\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1DvVWifhWqN1XncApwkQSprrm8kI-EjZV?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/31", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/36ec474c/uploads/origins/190b94a8-994c-4359-962a-97ed654babc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5f99700646eee5e5a75d47d77012ea8", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1413513, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/30", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1413513, "client_id": 2004361, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32225a2a/uploads/origins/80d3e5ef-5ddd-42ef-a1ce-b710e0814ab5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e03e98d44fcc3d2aed6b8a9a89e725ef", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32225a2a/uploads/origins/80d3e5ef-5ddd-42ef-a1ce-b710e0814ab5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce6ed2f592f8173e2ec677b333e6a8ce", "src_set": ""}, "body": "はじめまして、いつも素敵な作品を拝見しております。＋様のやさしい影と弾ける星のような繊細な世界観が大好きです。\nぜひoc描いていただきたく、リクエストを送信させて頂きました。\n\n描いていただきたいのは、いつもにこやかで少女にも大人にも見える不思議な女性です。\n花、蜘蛛の巣に引っかかった蝶、葬儀屋がモチーフに入っています。\n\n眼帯を付けていれば服装や髪型などは、お好きなようにアレンジして描いていただいて構いません。\n\nご縁がありましたら、どうぞよろしくお願いいたします。\n\nhttps://twitter.com/v4_nae/status/1710999472107630967?s=46&t=XtX102VIxX0Mrw_TZzt6Qg", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/29", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f7bf9009/uploads/origins/c72f5b94-a4ef-4382-911d-59a7276caec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=592c52d244b4eac89d9500856f328062", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1413513, "client_id": 849490, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1413513, "client_id": 1433185, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/58ff22e1/uploads/origins/4f928cad-1816-4a83-86df-d9336fb3d7fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f32aa4d5274480438a91139e5cc2fcd2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/58ff22e1/uploads/origins/4f928cad-1816-4a83-86df-d9336fb3d7fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3eb0f70604c9319f7ce0781e2a2dea38", "src_set": ""}, "body": "こんにちは、先生！\n\n先生の絵はとても美しいですね！水彩画の達人である先生の描く世界が大好きです。私のVTuberのキャラクターが、日本のサイバーパンクの街にいる絵をお願いできないでしょうか？彼女がその中を歩き回っていても、遠くから眺めていても、美的に美しいと思うものなら何でも構いません！\n\nこれが私のキャラクター。首の後ろから出ている長いアンテナは平らではなく、ワイヤーのようになっています。\nhttps://drive.google.com/file/d/1fUBklh5LeHdKr8fTRh77NGbTzgf1X7H4/view?usp=sharing\n\nこの衣装を使ってください：\nhttps://drive.google.com/file/d/18ohoyuv05tngWsS9bMeGqiyp7Tra4rvp/view?usp=drive_link\n\n人を幸せにするために悪いことをするサイバーパンクな犯罪者です。\nもしよろしければ、今後このアートをVTuberのスケジュールやYouTubeのサムネイルの装飾に使わせていただくかもしれません！\n\nよろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1413513, "client_id": 192290, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/220c5c4e/uploads/origins/9c2a819b-703e-4d6f-95ba-87dfae01d751?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15c8ca6dbf7afe67536861d510618abf", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/220c5c4e/uploads/origins/9c2a819b-703e-4d6f-95ba-87dfae01d751?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff820d8341e8c7d953d6456b49c22958", "src_set": ""}, "body": "こんにちは、＋様の画風がとても好きです！私のオリジナルキャラクター2体のイラストをお願いしたいです。\n\n身長181cm、立ち姿。前髪は短く、後ろで腰まであるポニーテール。右目は紫、左目は虹色の青。蛇のように切れ長の瞳孔と鋭い犬歯が特徴。陽気で愛想がいい。植物の研究者。下半身は蛇。\n\n右耳の白い羽のピアスにもご注目。\n\n身長186cm。白いロングヘア。炎色の瞳。物静かだが激情家。美人でハンサム。京劇役者。筋肉質。秘書鳥のような翼を持つ。\n\n赤いアイメイクとリップメイク、左耳の黒いタッセルピアスにご注目。\n\nAとBは幼なじみで、古代中国のファンタジーの世界で恋人同士。できれば、花畑とか、花や自然がたくさんあるところで二人を見てみたい。\n\nよろしくお願いします！リクエストにそぐわない場合は遠慮なくリジェクトしてください。\n\nhttps://drive.google.com/drive/folders/13oER8K621h27id0z6EH24UJLttvkPe4w", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1413513, "client_id": 1224608, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b12c77d/uploads/origins/e3f377dc-f7a7-409b-ac21-6b414e9330d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fbba0f3a085621de98f3cda7a042f1a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b12c77d/uploads/origins/e3f377dc-f7a7-409b-ac21-6b414e9330d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37060764534136ea5dde2def8b380cdd", "src_set": ""}, "body": "＋様、お久しぶりです。\n\n是非とも＋様に描いていただきたいのは前回までと同様、私の創作キャラクターになります。\n今回は下記URLの画像欄におります、“メイド”資料(資料4.8も宜しければご参考にしてください)の女の子を描いていただきたいです。\n以下、細かな要望になります。\n\n・ベースは前回まで描いていただいる“ノーマル”資料の子と同じですので、宜しければそちらもご参考にしてください。\n・もしもデザインで分からない部分等ございましたら、想像で補完していただいて大丈夫です。レース等の細かい部分は省略して描いていただいて問題ございません。\n・服装、髪型ピアス等は資料のままでお願いいたします。\n・表情は満面の笑顔か、きょとんとした感じの表情のどちらかで是非ともお願いいたします。(資料1〜8を見ていただけましたら大体なんとなくお分かりになるかと思います)\n・これはもし可能だったらで構わないのですが、＋様の許容範囲内で血表現をお願いしたいです。(程度はお任せいたします、ガッツリでもゆるやかでも)\n・作品全体のイメージとしましては、今回も＋様なりの“不穏な可愛らしさ”というイメージで描いていただけましたら幸いです。\n\n細かな要望は以上になります。\n\n数度目の依頼で大変恐縮です、ご迷惑でしたらお気軽に拒否して下さいませ。\n是非ともご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1nEvDJSFoimCmiZdq2wEe80t0j2BKoCBB", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/25", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ef898011/uploads/origins/db71a2dc-c659-4315-b4ea-f27b5f4821a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b06912a24fc82c8bbd1927f2f309aeb7", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1413513, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1413513, "client_id": 2467988, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9c8fdf8/uploads/origins/51eee697-24e0-42ad-8144-ee3b11050fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b76d19a655ba9c6f8ab8866f8c448b02", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9c8fdf8/uploads/origins/51eee697-24e0-42ad-8144-ee3b11050fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc637976e8f838f1a0826126136b9c63", "src_set": ""}, "body": "はじめまして。\nskeb再開を楽しみにお待ちしておりました！\n＋様のイラストの繊細さ、水彩画のような色使いとキャラクターの表情が大好きです。\nよろしければ、＋様の描く自創作キャラクターが見てみたいです…！\n\n資料URLにも添付させていただいたのですが、１２歳の男の子コンビになります。\nショタなのであまり男の子らしすぎず、普段の絵柄でかわいく描いて頂きたいです。\n構図や服装などはお任せしますが、このままでも大丈夫です。また、星か夏のモチーフが入っていれば嬉しいです。ぜひよろしくお願いします…！\n\nhttps://twitter.com/ro_6_9/status/1642588865709117441?s=46&t=gKWHr-IoAZ3tKltusbFk0A", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/23", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a87cfc83/uploads/origins/497b18c8-de76-45d0-aa8f-65dc25203217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e147547ba418089ced014c08e5b70e26", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1413513, "client_id": 2625740, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/22", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f1ebd34d/uploads/origins/f25e54e9-3d96-46c7-93fc-8679ae282780?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec2799b282fc4a60eafe1ddd9b493e6d", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1413513, "client_id": 849490, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1413513, "client_id": 619606, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/562efb31/uploads/origins/d03be718-e45b-4ba6-9f20-dae10e2c60ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2357378c09eeb4f306cb52aa03562cc0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/562efb31/uploads/origins/d03be718-e45b-4ba6-9f20-dae10e2c60ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74b97232372f7118fc3fd5e53939723c", "src_set": ""}, "body": "＋様、はじめまして\n素敵なイラストを沢山拝見させております。\n＋様のすてきな色使いと絵柄にひかれ、この度リクエストを送らせていただきました！\n\n私の創作キャラ二人をお願いしたいです\n髪色は水色＋ピンクの子はクラゲをイメージしたキャラで（海世くらりん）、目の色はゴールドとなります。\n天真爛漫で陽気な子で、水族館巡りが趣味です。海にあるものがすきで、塩辛ものが嫌いです。\n\nもう一人は宝石の魔女（ロード・ナイト）で、右目は常に閉じた状態ですが、開けたピンク色の涙が出てきます。\n彼女は賢くてクールな子で、よくくらりんの世話をしてます。イチゴとラズベリーが大好物です。お茶会をするのがとてもすきで、ローズのハーブティをよく飲んでいます。\n\n二人のお茶会をしている姿をお願いしたいと思います。\nフォルダーに現存する服装でも構いませんし、新しいデザインも大歓迎です。\n構図やポージングはすべて＋様にお任せいたします。\n\n使用用途は個人観賞、SNSアイコンなどとなります。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Rmb2IEByEUkbshZKhAkl8efNSt622oEc?usp=sharing\n↑資料はこちらになります。\nありがとうございます！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/20", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b6cd4f4f/uploads/origins/d09ccd4a-0e44-4596-87cc-ff579a273852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05c74db18732f182b3af168b35194819", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1413513, "client_id": 2008914, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/19", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/71b8c626/uploads/origins/6272c73a-bce8-454a-b86d-6658e9918a70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=24c50dd6fe3a5352825e6ea17d9f5e62", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1413513, "client_id": 2579598, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/18", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b7c68c97/uploads/origins/4293911b-021f-4687-992d-37fef3e03c94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d64f89bca00b4c72273fb35a04b12108", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1413513, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1413513, "client_id": 1224608, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33501758/uploads/origins/9533dd4c-92b1-4852-bd50-c5d3b31e0ebe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a2e1d53bd6272717cbd5ed13420dfa8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33501758/uploads/origins/9533dd4c-92b1-4852-bd50-c5d3b31e0ebe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d57f173582f73d5c935282744841aafe", "src_set": ""}, "body": "＋様こんばんは。\n再度リクエスト失礼致します。\n先ほど描いていただきました子がとてもとても可愛らしくいたく感動し、居ても立っても居られず再度リクエストをお送りした\n次第でございます。ご迷惑でしたら申し訳ございません。\n\n今回も描いていただきたいのは同じく添付資料にいる外ハネピンクの女の子になります。\n資料内7、8枚目にいるウルフカットの子が仰向けになっているところに、この外ハネの子に馬乗りになって包丁を振りかざしている様子を描いていただきたいです。\nウルフカットの方が無邪気な感じの笑顔、外ハネの子はきょとんとしたような顔でお願いしたいです。もし構図の問題で厳しければ顔が見えるのはウルフカットの子の方だけで問題ございません。\nよろしければ、前回と同じく作品全体の雰囲気は「不穏な可愛らしさ」でお願いさせていただきたいです。背景等お任せいたします。\n髪型、服装等は資料のままでお願いいたします。わからないところございましたら、想像で補完していただいてまったく問題ございません。\n\n続けての依頼で申し訳ございません。ご不快でしたり、何か問題・迷惑等ありましたらお気軽に拒否してくださいませ。\nお忙しい中恐縮ですが、何卒ご検討いただきますと幸いです。\n\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/mobile/folders/1cGYJURkafqJSFEy7aQxuYAfP4wVeMyD3", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1413513, "client_id": 193145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2dee3f76/uploads/origins/ebe7ef53-93bc-40ee-afb1-1894ccb302e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ddb8c5a1d3d6be9594d4d98d93b7af0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2dee3f76/uploads/origins/ebe7ef53-93bc-40ee-afb1-1894ccb302e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e951099c18bda4617bead15f4f96bc9", "src_set": ""}, "body": "あなたのイラストは美しいです私のリクエストを受け入れて頂ければ幸いです。下記リンクよりご確認ください。\n\nキャラクターA 170cm。14歳。猟師。弓矢が得意。眉毛が太い。肌の色に注意してください。帽子は描かなくていい。真面目な大人になったが、若い頃は生意気で自信家。\n\nキャラクターB 170cm猫耳の人。尻尾はない。優しい人。笑顔が好き。画像B04のワンピースを着用。髪の毛は肩の高さになるようにお願いします。\n\nキャラAとキャラBはお互いを家族のように思っている。\n\nキャラAとキャラBが手をつないでいるシナリオが欲しいです。森の中です。おとぎ話に出てくるようなシーンにしたいです。キャラAは地図を持っています。キャラBは花かごを持っています。\n\nその他、細かい部分はお任せします。もし、依頼内容に問題があれば、遠慮なくお断りください。ありがとうございました。\n\nhttps://www.dropbox.com/scl/fo/9t294xdhyilipp7pumb0d/h?dl=0&rlkey=12no4tohd07mhcatci6pks9x7", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/62c41b1b/uploads/origins/e93f4b77-b1c8-49b6-a939-1dd9cc841e32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5bc5489ab30985fa00a72edec5390f25", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1413513, "client_id": 849490, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1413513, "client_id": 1224608, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c329864/uploads/origins/e286a186-8660-4248-ae83-3a0acad15630?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8682bf8bbacad424e624de48c7574a8b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c329864/uploads/origins/e286a186-8660-4248-ae83-3a0acad15630?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6187761e3c935c98695481d946df1a4", "src_set": ""}, "body": "＋様はじめまして。\nTwitterでたまたまお見かけした＋様の描かれるイラストの爽やかで淡い色彩に一瞬で魅了され、衝動でリクエストを送らせていただきました。\n\n今回、是非とも＋様に描いていただきたいのは私の創作キャラクターです。下記URLの画像欄におりますピンク色で外ハネででピアスでセーラー服の女の子になります。\n［https://drive.google.com/drive/mobile/folders/1cGYJURkafqJSFEy7aQxuYAfP4wVeMyD3]\n\n細かな設定画等無く大変申し訳ございません。もしもデザインで分からない部分等ございましたら、想像で描いていただいて全く問題ございません。\n服装、髪型ピアス等資料のまま描いていただいて大丈夫です。他に特段細かいお願い等はございませんが、可能でしたら＋様なりの“可愛らしい不穏”というイメージで描いていただけましたら幸いです。\n\n当方skebでのリクエストは初めてですので、何か不手際ありましたら申し訳ございません。迷惑な依頼でしたらお気軽に拒否してください。お忙しい中恐縮ですが、ご検討いただけますと幸いです。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/mobile/folders/1cGYJURkafqJSFEy7aQxuYAfP4wVeMyD3", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1413513, "client_id": 429772, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67e63fae/uploads/origins/4738454e-8f69-4282-97e1-33a413e9d5a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69231ddd8e6775bd011e31e17a728294", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67e63fae/uploads/origins/4738454e-8f69-4282-97e1-33a413e9d5a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59fb75e1fd6e1d899afe8fe984a16bb0", "src_set": ""}, "body": "こんにちは。あなたの素敵な絵がとても好きなので、私のオリジナルキャラクターを描いていただけたらとても嬉しいです。\n黒髪は18歳のエクソシストです。彼は真面目なタイプで、あまり笑わない（武器を抜く必要がない）。\n白髪はいつも彼に付きまとい、任務の手助けをしてくれるゴースト。人懐っこく見えるが、実はミステリアスな存在（普通の人に見えるので、透明は不要）。白髪は黒髪をからかうのが好きで、いつも些細なことで喧嘩をしているが、実は黒髪は面倒見が良く、いつも白髪の面倒を見ている。\n\n七夕の木と一緒に描いていただけると嬉しいです。幸せな雰囲気だけど、どこか寂しさが残る、こんな感じでしょうか。\nhttps://twitter.com/tt_yoru/status/1521786318493130752\nhttps://twitter.com/tt_yoru/status/1542814892968726528\n\nあとは、あなた次第です。必要であれば、服装の変更・修正も可能です。\n\n本当にありがとうございました。\n\nhttps://drive.google.com/drive/folders/1-QVHkf6w0yeNFEev-OY6QUbbyHnPLaCV?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4e92468b/uploads/origins/b6bfb0b4-24fd-4e63-be7e-791883fc98d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52694fe9f918f7aa52dce2bcd3db010a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1413513, "client_id": 1595841, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tt_yoru/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7c02ef0f/uploads/origins/ecee5afb-20ef-4d34-96be-4feefefb6b00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6d3391282823119cd0c0ece8007390a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1413513, "client_id": 2174696, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 676549, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Mariko", "screen_name": "mariko_889", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F90e362df-4bf9-4099-a395-0031c33c409e.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fe3074fc-1201-4ab3-9ac8-9a9d