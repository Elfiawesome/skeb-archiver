f2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=659d5811bbada41fbb0e6f2d91ea1c92 2x, https://si.imgix.net/d661a124/uploads/origins/08bbca02-2142-4f0e-ae72-48f5328bf2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59cb5bd2452fe141a8e47a206a046875 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d661a124/uploads/origins/08bbca02-2142-4f0e-ae72-48f5328bf2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ceaafd776df928e616d735f8ca73dff1", "srcset": "https://si.imgix.net/d661a124/uploads/origins/08bbca02-2142-4f0e-ae72-48f5328bf2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ceaafd776df928e616d735f8ca73dff1, https://si.imgix.net/d661a124/uploads/origins/08bbca02-2142-4f0e-ae72-48f5328bf2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=45a7c7139682a0a4ae29e49462abeac5 2x, https://si.imgix.net/d661a124/uploads/origins/08bbca02-2142-4f0e-ae72-48f5328bf2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d9814cbf956c19b39b5ffffec5805356 3x"}, "body": "https://skeb.jp/requests/2748122の清楚なお姉さんの排便をrequestした者です。素晴らしいイラストをありがとうございました。同様の構成で別キャラの排便シーンをお願いします。\n今回はクール系のお姉さんで脱糞シーンをお願いします。\n見た目的にはパンツルックの黒のスーツ。OLの先輩みたいなイメージです。\nシチュエーションは、外回り中に公園の公衆トイレで排便するという内容、音消しせず排便し、後輩に放尿、放屁、排便の音や息む声が同行する後輩社員に丸聞こえとなってしまうというシチュです。\n\n①右枠に「すまない、お手洗いに行ってくる」と平然とした表情で後輩に用足しを告げる　\n　左枠はパンツ、下着を下ろし、おしっこが出始める「ふぅ…」という声と「ちょろっ」とおしっこが出始める音\n\n②ここから左枠のみ\n　「じょっ、じょぼぼぼぼぼぼぼぼぼっ」と勢いよくおしっこが出始める音と、短く「ブッ！」という放屁音\n　合わせて後輩のモノローグ「先輩…トイレの時、音消さないんだな…」\n\n③「―――ッ、ゥン…コ出、そうだ…」若干顔をしかめて息む表情。うんちがメリ…と顔を出す。便器内の水はおしっこで若干黄色く。ここから脚をがばっと開く。白の下着のクロッチ部には濃いめの尿シミと縮れた陰毛が1本。\n④鼻の穴を広げ、顔を真っ赤にした超絶ブス顔でガチガチの便秘ウンチを出す。\n　「ふん゛ッ、ぅ゛ん゛ンンンンッ、ふん゛んん゛んんッ！！」\n　後輩のモノローグ「普段クールな先輩があんな声出しながらウンチするなんて…」\n\n⑤目をつむった切なげな綺麗な表情で日々の少し入った健康的な一本糞を出す。\n　ブッブリブリブリッブリュッという汚い音　「ウン、コ…まだ、出る…」\n　\n⑥左枠\n肛門を拭き終えて「ふぅ…」と息をつく様子。「ぷッす～～～～ッ」と長い音の放屁\n便器の中にはガチガチの黒いゴーヤウンチ、２本目の健康的な一本糞、拭いた痕の付いたペーパー。\n右枠\nさっきまで脱糞してたとは思えないような様子で「すまない、待たせたな」と平然とした表情でトイレから出てくる。\n以上の様子を描いていただけると幸いです。クール系の顔のいいお姉さんがえっぐいブス顔を披露するところが見られるとすごくはかどります。\n\nhttps://sites.google.com/d/1GxAwZwDnMQlV75BwxrNztVUBsvxSokyj/p/1JtmaRv6Dtn61eWSl56UrGchtfxdk2uS8/edit", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eggkk/works/21", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bbdcb75d/uploads/origins/5861a369-3b87-4178-a522-ab702833aa1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9952b15b082a094250617cd298d28f44", "srcset": "https://si.imgix.net/bbdcb75d/uploads/origins/5861a369-3b87-4178-a522-ab702833aa1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9952b15b082a094250617cd298d28f44, https://si.imgix.net/bbdcb75d/uploads/origins/5861a369-3b87-4178-a522-ab702833aa1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b11acf8dd49879994107129c69e0f43a 2x, https://si.imgix.net/bbdcb75d/uploads/origins/5861a369-3b87-4178-a522-ab702833aa1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4fb1e2737c8628d1959b43ec4e976d1 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 509359, "client_id": 150662, "nc": 51}, {"path": "/@eggkk/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 509359, "client_id": 3014814, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dac24b73/uploads/origins/833d572f-5790-4808-abda-5e5b4318a795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ac84c8e43f80a1a298eeee612d9c95f", "srcset": "https://si.imgix.net/dac24b73/uploads/origins/833d572f-5790-4808-abda-5e5b4318a795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ac84c8e43f80a1a298eeee612d9c95f, https://si.imgix.net/dac24b73/uploads/origins/833d572f-5790-4808-abda-5e5b4318a795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a52b49d9625d871b4efba8411101f413 2x, https://si.imgix.net/dac24b73/uploads/origins/833d572f-5790-4808-abda-5e5b4318a795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9293641700970e6c28068472fecf3d1a 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dac24b73/uploads/origins/833d572f-5790-4808-abda-5e5b4318a795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5ee447803d61f4613b29e4f9ad85fe7", "srcset": "https://si.imgix.net/dac24b73/uploads/origins/833d572f-5790-4808-abda-5e5b4318a795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5ee447803d61f4613b29e4f9ad85fe7, https://si.imgix.net/dac24b73/uploads/origins/833d572f-5790-4808-abda-5e5b4318a795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e49f1bdea7c688f279cd4e24d732a840 2x, https://si.imgix.net/dac24b73/uploads/origins/833d572f-5790-4808-abda-5e5b4318a795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c69d4b7df0b7e6c301063f70be404c37 3x"}, "body": "よろしければ私のオリジナルキャラ（カップル）のスカトロプレイ姿を描いていただけると嬉しいです。\n\n女の子参考画像→ https://imgur.com/a/bkKZb8C\n・名前は「秋山令」\n・柔和な顔つき（やや垂れ目）、巨乳（B90くらい？）低身長\n\n彼氏参考画像→ https://imgur.com/a/FN4IutY\n・名前は「荒田一美」\n・彼女よりちょっと大きいくらいの小柄な女顔男子 ・小柄だけどちんちん大きい（補足情報）\n\nイメージとしては、彼氏に頼まれて彼女が部屋の中で脱糞する、というもので、流れは\n①女の子がお尻の下にペットシーツを敷いていわゆるうんこ座りしながら、「ねー、そんなに見たいものなの？うんちしてるとこって…いや、何度かエッチしてる時に見せてるけどさ」と呆れたように言っている。\n彼氏は「見たい見たい。今日はじっくりしてるところ見たくてさ」と笑っている\n②彼女が踏ん張っている「ん…ちょっとお腹張ってるから…時間かかるかもっ…」と言っている。\n彼氏が「オッケーオッケー、そういう表情も見たかったからさー」と笑顔になる\n③音を立てて太い大便が出ている。彼女が「んっ…はあぁ…うんち…出て…るぅっ…」と、口の端からよだれをたらしつつ気持ちよさそうな表情を浮かべている。\n彼氏は「すご…量もにおいも最高…」と嬉しそうな表情を浮かべている。つづけて「ところでさ…」と彼氏が言う。\n④ペットシーツの上に糞が積もっており、お尻からはまだ糞が繋がっている。\n彼氏が「今まで浣腸してうんちさせてたことはあったけど…自分でしてもらったのって初めてだって知ってた？」と言いつつ意地悪な表情を浮かべている。\n彼女は「ふえっ！？」と声を上げ、赤面して急に恥ずかしそうな表情をする。\n⑤放屁音と共に糞がお尻から離れて床に落ちる。\n彼女が「もー…急に変なこと言わないでよ…」と呆れたような表情をしている。\n彼氏が「あはは、ごめんごめん…で、お尻でしていい？」と笑いつつ言っている。\n彼女も「いいけどさ…」と答えている。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@eggkk/works/19", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/69b3c887/uploads/origins/fce0a11d-22d3-4c94-8ffa-36e66cfd17e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fef31cb0d6df6106de3314ac8837956c", "srcset": "https://si.imgix.net/69b3c887/uploads/origins/fce0a11d-22d3-4c94-8ffa-36e66cfd17e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fef31cb0d6df6106de3314ac8837956c, https://si.imgix.net/69b3c887/uploads/origins/fce0a11d-22d3-4c94-8ffa-36e66cfd17e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7813a78bc8f5e22ef26c38e5eefc5f02 2x, https://si.imgix.net/69b3c887/uploads/origins/fce0a11d-22d3-4c94-8ffa-36e66cfd17e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2fc2b8c2dc3b0c3f5ef1555a87f58f7d 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 509359, "nc": 177}, {"path": 