4d1e371fc469?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99e99da78880574eff23e0232ae3f8d2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54877d57/uploads/origins/43ba708a-22f1-46c2-93ce-4d1e371fc469?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cdf2b936afb138ea204220ba07e00085", "src_set": ""}, "body": "あなたの絵は心にしみるほど美しい！\n私のバーチャルストリーマーのクレアを描いてください！https://drive.google.com/drive/folders/1ukkOFeWXqkGI1OkRwTywNovgAglacwpe?usp=sharing。クレアはお天気の魔女（雲、雨、雷、雪などを操る）で、髪は雲でできている。普段は優しくて自信に満ち溢れているけれど、必要な時には暗くて嵐のようになることもある。あなたの絵は素晴らしいし、とても違った視点になると思うので、私のキャラクターをあなたが描くのを見てみたいです。必要に応じて、自由に変更や修正を加えてください。ポーズや背景はあなた次第です。\nあなたのアートを私のストリーミング・ソーシャルメディア（Twitch、Twitter、Patreonなど）に使用したいです。このアート作品の商用権をお願いしたいです。ありがとうございました。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miaou_chat_noir/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2096250, "client_id": 3674849, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e20b2357/uploads/origins/38c6c2d8-40fe-42a5-baea-8a3885711d57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d8a88fc8d4662d361bc8dcfef913bc1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e20b2357/uploads/origins/38c6c2d8-40fe-42a5-baea-8a3885711d57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a66eebfd1f499e4ab715aaa7f2ab975a", "src_set": ""}, "body": "はじめまして。\nVARiSE所属のVtuber、天羽ミカドと申します。\n 新着イラストでお見かけし、私の大好きなダークファンタジーのような世界観に一目惚れいたしました。そんなよこしまねこ様に私自身を描いていただけたら幸せだなと思いご連絡させていただきました。ご依頼の詳細を下記に記載させていただきます。\n条件等難しい場合ははキャンセルしていただいて大丈夫です。\n何卒ご検討の程よろしくお願い致します。\n\n 【構図やイメージ】  \n私自身(天羽ミカド)の1枚イラストをお願いいたします。\n先生の描いている雰囲気が好きなので参考資料に私の姿が載っているのでそれを元に衣装等含め、おまかせで描いていただけたらとても嬉しいです。 \nミカドは天界から片羽が壊れ地上に落ちてしまい、左の羽が義翼になっております。\n ご依頼させて頂いたものはSNSやサムネイル等で使用したいため、頭や肩が切れていないと有難いですが、そこも先生の可能な範囲(好みの)でお願いできたらと思います。\n\n 【使用用途】 \n・YouTubeのサムネイルや動画内での使用\n・Xやファンクラブ等SNS活動全般への使用 ・グッズ等の商用利用\n\n【その他要望】 \n・可能であればPSDかPNGでのデータ納品希望です。\n・人物と背景のレイヤーを分けていただけるととても有難いです\n※どちらも可能であればで大丈夫です。\n\n【参考資料】\nhttps://x.com/amahanemikado/status/1939872524181049755?s=46&t=gY_0V155m6wDXGXQRK7wKQ\n\nぜひご検討いただけると幸いです。\nご縁がありましたら、よろしくお願いいたしますm(_ _)m\n\nhttps://x.com/amahanemikado/status/1939872524181049755?s=46&t=gY_0V155m6wDXGXQRK7wKQ", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miaou_chat_noir/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2096250, "client_id": 3107586, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9a0a905/uploads/origins/bbc862d6-5c11-4020-8cd0-d67c3a59a5a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=555e0020d20725b35737da8b8e037c24", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9a0a905/uploads/origins/bbc862d6-5c11-4020-8cd0-d67c3a59a5a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bae85aec7a5b6f4d43dfd7dcec1fe6e0", "src_set": ""}, "body": "再びこんにちは！前回の作品がとても気に入りました！とても心に残る美しさだったので、またあなたに描いてもらいたいんです！また僕のVtuberを描いてくれると嬉しいんだけど、彼のデザインと『エルデン・リング・ナイトレイン』のナイトロード、ヘオルスターを混ぜてね。ポーズや表情、両方のデザインの組み合わせはお任せします。全体的に悲哀を感じさせる、心に染みるような美しい作品にしたいと思います。お忙しい中、本当にありがとうございました。\n\nVtuber参考：https://drive.google.com/drive/folders/17xJxXeR7nN5F4-FTpI5-eg1LsmSrBDQX?usp=sharing\n\nナイトロードHeolstor: https://imgur.com/a/bmEISeC\nHeolstor 3dモデルルック：https://www.youtube.com/watch?v=Hj1nLOIqN0o&t=153s", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miaou_chat_noir/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c