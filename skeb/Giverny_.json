いますが、休日はスイーツ探索などに向かう仲です。\n\n参考画像は演奏会衣装となっていますが、ウミ様のレトロ調の黒ワンピが大好きなのでそれらでも構いません！\nウミ様の可愛らしく、それでいてカルチャーを感じられる作風が好きなため好きに描いていただけると嬉しいです。\nもし参考がある方が描きやすいん場合、星にまつわるモチーフがあると嬉しいです。（参考画像右の女の子が星座が好きなため）\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1r0p0kl4RDXYLILHDNsAnzxDSNXXT6ymR", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Giverny_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1076099, "client_id": 1467026, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bbf77636/uploads/origins/58154c2d-d233-4604-b1d2-672a4ce0b274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65582d46d12114d8859c0360127ae6f0", "srcset": "https://si.imgix.net/bbf77636/uploads/origins/58154c2d-d233-4604-b1d2-672a4ce0b274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65582d46d12114d8859c0360127ae6f0, https://si.imgix.net/bbf77636/uploads/origins/58154c2d-d233-4604-b1d2-672a4ce0b274?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e946ab33ea5d716cba189cd412c9b7b4 2x, https://si.imgix.net/bbf77636/uploads/origins/58154c2d-d233-4604-b1d2-672a4ce0b274?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7031d42b4fb7adaaba68c70ce53f6792 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bbf77636/uploads/origins/58154c2d-d233-4604-b1d2-672a4ce0b274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f427b154172530757840785575999d4d", "srcset": "https://si.imgix.net/bbf77636/uploads/origins/58154c2d-d233-4604-b1d2-672a4ce0b274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f427b154172530757840785575999d4d, https://si.imgix.net/bbf77636/uploads/origins/58154c2d-d233-4604-b1d2-672a4ce0b274?bg=%23fff&auto=format%2Ccompress