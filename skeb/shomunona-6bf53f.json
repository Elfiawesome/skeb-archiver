6dd3/uploads/origins/ddff1a53-71c6-4d10-99bc-83c61ddb0f82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6bb5776da470cc045b7b3134a1f01c5d 3x"}, "body": "テール・コンチェルトの登場人物たち。4匹とも人間のペニスで全裸に。WaffleがPantaとファックしている間、CyanはTail concertoの子猫の一匹とファックしている。WaffleとCyanはWaffleのベッドに座っていて、彼らがファックしている男の子を膝の上に乗せている。   WaffleとCyanはPantaと子猫の中でイク。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shomunona/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 78656, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17ae4b5c/uploads/origins/8616f89f-fcdf-4734-ac28-9ee9ee558bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bcf98c510c2ae47c57ab289d301f25d", "srcset": "https://si.imgix.net/17ae4b5c/uploads/origins/8616f89f-fcdf-4734-ac28-9ee9ee558bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bcf98c510c2ae47c57ab289d301f25d, https://si.imgix.net/17ae4b5c/uploads/origins/8616f89f-fcdf-4734-ac28-9ee9ee558bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0ae1a7c5d12bf85dbe1ea87856170cf 2x, https://si.imgix.net/17ae4b5c/uploads/origins/8616f89f-fcdf-4734-ac28-9ee9ee558bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46be98a72c4a8a7d3284d2f856a7d467 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17ae4b5c/uploads/origins/8616f89f-fcdf-4734-ac28-9ee9ee558bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09d377946cc0a5ad3a22c2a349091120", "srcset": "https://si.imgix.net/17ae4b5c/uploads/origins/8616f89f-fcdf-4734-ac28-9ee9ee558bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09d377946cc0a5ad3a22c2a349091120, https://si.imgix.net/17ae4b5c/uploads/origins/8616f89f-fcdf-4734-ac28-9ee9ee558bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d7993a447962eebaebaae1b2c824bda6 2x, https://si.imgix.net/17ae4b5c/uploads/origins/8616f89f-fcdf-4734-ac28-9ee9ee558bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ffcfa7d43441453cada75cbf81cf3fd6 3x"}, "body": "林間学校の夜、ネズミ獣人の子がみんなで寝ている中で隣で寝ているキリン獣人の子を扱いて射精させてしまう漫画をお願いします。\nページ数多めで場面をじっくり描く感じで。\n中学２年生くらいの年齢。\n\nキリン獣人は背が高く首が長すぎない優しそうな感じで。巨根で絶倫の設定。普段は優しいがネズミをぐちゃぐちゃに犯して泣かせたいサド願望持ち。舌が長くて太く、キスとアナル舐めのテクがエグい。\nネズミは小心者だが性欲が強い。背は低いがちんちんは大きめ。キリンにぐちゃぐちゃに犯されて泣かされたいマゾ願望持ち。アナル開発をしていてアナルが敏感。全身敏感な隠れ淫乱。\n２人は両片思い。\n\n・林間学校でクラスのみんな(の中の１０人くらい)と布団をピッタリ並べて寝ている。端っこで寝ているネズミはみんなにバレないように寝たフリをしながら隣で寝ているキリンの方を向き、布団に手を潜り込ませる。こんなことダメだと葛藤しながらも欲望に勝てない。ネズミの方に向かって横向きで寝ているキリンのズボンの上からキリンの巨根に恐る恐る触れる。想像以上の大きさにドキドキする。\n\n・禁断の行為にドキドキしながら寝たふりをしてズボンの上からこっそり撫でる。巨根が徐々に勃起する。ネズミは欲望に勝てず巨根をズボンの上からいやらしく揉み、さする。キリンが顔を赤くして感じる。そしてズボンの中で射精してしまう。林間学校３日目でオナニーできず溜まりに溜まった精液を勢いよく出す。\n\n・ズボンの上からドクドクとした激しい射精を感じ、我慢が限界になったネズミが寝たふりをしながらズボンの中に手を入れ、巨根に直接触れる。ネズミが最大限にドキドキする。巨根の熱さと硬さにうっとりとしてしまう。キリンは射精直後の敏感な巨根を撫でられ汗だくで顔を真っ赤にしてハアハアと気持ちよさそうかつうなされるように苦しそうにする。\n\n・巨根を直接しごき亀頭をグリグリと撫で、再度ズボンの中で射精させる。キリンは助けを求めて叫ぶように口を開け、拷問のような快感で全身をビクビクさせる。ネズミがドキドキしながら手を引っ込め眠たふりをする。その瞬間、キリンが連続射精の強すぎる快感と精液の感覚に慌ててガバっと起きる。夢精したと勘違いしてみんなが起きる前に慌ててパンツを洗う。ネズミは寝ながらゴメンと謝る。\n\nキリンは嫌がるネズミに無理やり自分の巨根をディープフェラさせてネズミに精液を飲ませる夢を見た裏設定。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shomunona/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 78656, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf904a20/uploads/origins/e98ec9c1-8475-4a25-867b-43a2b77c722d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a37fc75dc96f580a7f66ec53eb9554e", "srcset": "https://si.imgix.net/bf904a20/uploads/origins/e98ec9c1-8475-4a25-867b-43a2b77c722d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a37fc75dc96f580a7f66ec53eb9554e, https://si.imgix.net/bf904a20/uploads/origins/e98ec9c1-8475-4a25-867b-43a2b77c722d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bc50c3e88d8928157c0ae6de41f8580 2x, https://si.imgix.net/bf904a20/uploads/origins/e98ec9c1-8475-4a25-867b-43a2b77c722d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0931855af3c2a2cdf390e4e8fd5895eb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf904a20/uploads/origins/e98ec9c1-8475-4a25-867b-43a2b77c722d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6769e47384c2bcd0bbb14a67cdcb8da3", "srcset": "https://si.imgix.net/bf904a20/uploads/origins/e98ec9c1-8475-4a25-867b-43a2b77c722d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6769e47384c2bcd0bbb14a67cdcb8da3, https://si.imgix.net/bf904a20/uploads/origins/e98ec9c1-8475-4a25-867b-43a2b77c722d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=898763b0c2902b268fef855c510358d3 2x, https://si.imgix.net/bf904a20/uploads/origins/e98ec9c1-8475-4a25-867b-43a2b77c722d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93bceab6b64433e28a4c0bd21bc5ce09 3x"}, "body": "ガキ大将の兎獣人の子が馬獣人の子に睡眠姦されて精通してしまう絵を３枚（差分２枚）お願いします。\n２人とも小学校低学年くらい。\n足りなければ値上げしてください。\n兎は小柄で未精通。鼻の近くに絆創膏を貼ってやんちゃな感じにしてください。えっちなことは何も知らない。\n馬は背が高く年不相応の巨根で。兎に惚れているので横暴に耐えていたが限界が来た設定。早熟でえっちを知っている。\n馬が夜な夜な兎のアナルをほぐし、開発してきた設定。\n馬に強力な睡眠薬を盛られて眠る兎。一貫して起きない。\n\n１．馬が兎を激しく犯しながら兎のちんちんをしごく。兎は精通前なので空イキを繰り返す。これを何時間も続けた設定。拷問のような快感に兎は汗だくで犯され空イキが止まらず何時間もイキっぱなしで限界を遥かに超えた状態。助けを求めるような泣きそうな顔だが快感で顔を真っ赤にした淫乱な顔。馬は真っ赤な顔で鬼畜に犯しお仕置きし続ける。\n\n２．馬がちんちんを根本まで全部入れ、腰をピッタリとくっつけて大量中出しする。結腸まで犯され強すぎる快感で兎が無理やり精通させられる。兎は娼婦のような淫乱な顔で泣き叫ぶような顔で精通する。\n\n３．事後。兎がちんちんを萎えさせ快感で惨めに体を震わせ、アナルから中出しされた精液を大量に出し、淫らに眠り続ける。馬はちんちんを中から抜き、してやったりという顔。馬はちんちんをギンギンに勃たせたまま。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shomunona/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 78656, "client_id": 132159, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ea2a3af/uploads/origins/b487d1fd-f943-4c82-9e7f-ea8982b47327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb8fc7ae81de6f1a92178d4ae88e38d4", "srcset": "https://si.imgix.net/3ea2a3af/uploads/origins/b487d1fd-f943-4c82-9e7f-ea8982b47327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb8fc7ae81de6f1a92178d4ae88e38d4, https://si.imgix.net/3ea2a3af/uploads/origins/b487d1fd-f943-4c82-9e7f-ea8982b47327?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ebc5a75f2cd4ae76ac60493dded415a 2x, https://si.imgix.net/3ea2a3af/uploads/origins/b487d1fd-f943-4c82-9e7f-ea8982b47327?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12dfd5b81d448ce2ee9c392b35077672 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ea2a3af/uploads/origins/b487d1fd-f943-4c82-9e7f-ea8982b47327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b86d812d135ff077d22db68f09da0df", "srcset": "https://si.imgix.net/3ea2a3af/uploads/origins/b487d1fd-f943-4c82-9e7f-ea8982b47327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b86d812d135ff077d22db68f09da0df, https://si.imgix.net/3ea2a3af/uploads/origins/b487d1fd-f943-4c82-9e7f-ea8982b47327?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ca0abcabc9ace9c6a9950d7dde989cde 2x, https://si.imgix.net/3ea2a3af/uploads/origins/b487d1fd-f943-4c82-9e7f-ea8982b47327?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=2