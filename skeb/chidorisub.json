ただいた作品を含めておりますが、タレ目気味、ということ以外細かな部分は決めていないので、ご想像のまま自由に描いていただけたらと思います。\n\n服装やポーズに関しましても、お任せいたします。これまでに仕立てていただいたお洋服の中から選んでいただくのも、今回の雰囲気に合わせて描いていただけるのも、どちらも嬉しいです。\n\n宛名は不要にしてありますが、サインやIDなどは作品のどこかに入れていただきたいです。\n\nお忙しいとは思いますが、ご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1VjwMcnle2hpwfKXYX0ol9Ur3DT8wTsLL", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chidorisub/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3770253, "client_id": 702918, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24065c6c/uploads/origins/f9b54c83-71ce-4653-a47d-d361d578f44f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b01391a46eda2e7398870418ced3867c", "srcset": "https://si.imgix.net/24065c6c/uploads/origins/f9b54c83-71ce-4653-a47d-d361d578f44f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b01391a46eda2e7398870418ced3867c, https://si.imgix.net/24065c6c/uploads/origins/f9b54c83-71ce-4653-a47d-d361d578f44f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae4aefcf74536e5af80bb57beaac11a6 2x, https://si.imgix.net/24065c6c/uploads/origins/f9b54c83-71ce-4653-a47d-d361d578f44f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=541c9fc2bca2426d484e53e41688c012 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24065c6c/uploads/origins/f9b54c83-71ce-4653-a47d-d361d578f44f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=692587957143e1e6cafba620878d7634", "srcset": "https://si.imgix.net/24065c6c/uploads/origins/f9b54c83-71ce-4653-a47d-d361d578f44f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=692587957143e1e6cafba620878d7634, https://si.imgix.net/24065c6c/uploads/origins/f9b54c83-71ce-4653-a47d-d361d578f44f?bg