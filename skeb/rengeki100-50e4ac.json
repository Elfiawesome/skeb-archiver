t/09d542ca/uploads/origins/e6e43402-a24c-4427-aec3-db799504b4cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=104c07973f97ccc3d6a461da8c13752c 3x"}, "body": "レンゲキさん、こんにちは♪\nこのたびはステキなメイド服のイラストをありがとうございました🌸\n以前からおねがいしたかったのですが、イラストのイメージがまとまらずに今回、私の和服でのイラストをおねがいさせていただきたく、リクエストいたしました。\n\n【用途】\nSNSでの掲載/アイコン・ヘッダー/配信・動画/サムネイル画像となります。\n\nポーズや表情などはおまかせします。ぜひ、盛り盛りしてください！！\nイラストには麻雀牌（できれば6ソー）やリーチ棒を手に持つか、\n手から放っているようなものにしていただきたいです。\n\n作品は人物や背景・小物などをレイヤーで分けたPSDファイルでいただけるとたすかります。\n\nお時間ありましたら、ぜひよろしくおねがいいたします。\n\n添付資料（固定ツイートとツリー）\nhttps://twitter.com/Asahi_7_Hinata/status/1703379603589599508\nhttps://twitter.com/Asahi_7_Hinata/status/1703379606328512624\nhttps://twitter.com/Asahi_7_Hinata/status/1703379608975155468\n\nhttps://twitter.com/Asahi_7_Hinata/status/1703379603589599508", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rengeki100/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2759858, "client_id": 2902367, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2e36e8a6/uploads/origins/224c462c-a5f9-4a8e-9418-dc17f205a076?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a539ab58260801039223485858ab10dd", "srcset": "https://si.imgix.net/2e36e8a6/uploads/origins/224c462c-a5f9-4a8e-9418-dc17f205a076?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a539ab58260801039223485858ab10dd, https://si.imgix.net/2e36e8a6/uploads/origins/224c462c-a5f9-4a8e-9418-dc17f205a076?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=437d40c8951de5734c4fc56da390f976 2x, https://si.imgix.net/2e36e8a6/uploads/origins/224c462c-a5f9-4a8e-9418-dc17f205a076?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6cfa8150fb4680c198077fa1de522e5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls"