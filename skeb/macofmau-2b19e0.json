し改善された予定のデザインで描いて頂けたらと思っております。\n\n配信のサムネなどとかにも使えたらとも思っておりますので、できれば背景透過版も差分かPSDで頂けたら幸いです。\nどうぞよろしくお願いします。\n\n普段の参考\nhttps://drive.google.com/drive/folders/1qFwn6K41xCVr_zG2BCW66NQ2FYNPor7K?usp=sharing\n\n新衣装の参考\nhttps://drive.google.com/drive/folders/1sQNXxuaKbXRLJyHcXxFhX3NF2HqUVkKK?usp=sharing\n\nhttps://drive.google.com/drive/folders/1qFwn6K41xCVr_zG2BCW66NQ2FYNPor7K?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@macofmau/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1955686, "client_id": 1227326, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d86123f1/uploads/origins/400774ff-4608-48d7-a184-c4012853c4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f6ef71934dc0e353223ae39fd070fdc", "srcset": "https://si.imgix.net/d86123f1/uploads/origins/400774ff-4608-48d7-a184-c4012853c4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f6ef71934dc0e353223ae39fd070fdc, https://si.imgix.net/d86123f1/uploads/origins/400774ff-4608-48d7-a184-c4012853c4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dec54fbdc0559802562140184814e756 2x, https://si.imgix.net/d86123f1/uploads/origins/400774ff-4608-48d7-a184-c4012853c4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40c0b58d55039169011317dd270fa494 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d86123f1/uploads/origins/400774ff-4608-48d7-a184-c4012853c4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=117a33001d80add164dd0a3cae03d9bc", "srcset": "https://si.imgix.net/d86123f1/uploads/origins/400774ff-4608-48d7-a184-c4012853c4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=117a33001d80add164dd0a3cae03d9bc, https://si.i