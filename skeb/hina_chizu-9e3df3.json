37-acc0-4983-ab2f-a20d1e24d0cb?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=f5f993e7903bcfd76cf0e4c90dc5e22b", "srcset": "https://si.imgix.net/de14f775/uploads/origins/f5e88b37-acc0-4983-ab2f-a20d1e24d0cb?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=f5f993e7903bcfd76cf0e4c90dc5e22b, https://si.imgix.net/de14f775/uploads/origins/f5e88b37-acc0-4983-ab2f-a20d1e24d0cb?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=e21200623dae4ae9b3e4a2879653af74 2x, https://si.imgix.net/de14f775/uploads/origins/f5e88b37-acc0-4983-ab2f-a20d1e24d0cb?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5c2cb76c282ff972ccbc03559ca5ff7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de14f775/uploads/origins/f5e88b37-acc0-4983-ab2f-a20d1e24d0cb?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=beec167c586b8c56139a28ac00131d85", "srcset": "https://si.imgix.net/de14f775/uploads/origins/f5e88b37-acc0-4983-ab2f-a20d1e24d0cb?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=beec167c586b8c56139a28ac00131d85, https://si.imgix.net/de14f775/uploads/origins/f5e88b37-acc0-4983-ab2f-a20d1e24d0cb?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0fb471ad678a5e3238ae32b1eaa8fff4 2x, https://si.imgix.net/de14f775/uploads/origins/f5e88b37-acc0-4983-ab2f-a20d1e24d0cb?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d31fc8eb5741a3256dd6040e8f6688fe 3x"}, "body": "日向彩ちづる🌻🐣様こんばんは！みゅーと申します。\nYouTubeでVTuberとして活動しております。\n\nかわいらしいイラストを拝見させていただき、絵柄がとっても好みだったので\nもし良ければ描いていただければと思い連絡させて頂きました。\n\n\n当方、みゅー・あうろーらのイラストを依頼させていただければと思います。\n\n\n衣装や構図、ポーズに関してはお任せします。当方の衣装でもよいですし何かしらのコスプレでも構いません。座っていても寝ていてもどのような角度でもかまいません。ゲームのキャラ風でも何かのボカロ曲モチーフでもOKです。セクシーなものでも問題ありません！\n日向彩ちづる🌻🐣様の趣味やフェチ、性癖などを全開で盛り込んでいただければと思います。\n（前髪は片目隠れでお願いします。表情豊かだとうれしいです。）\n\n\n\n人物の透過PNGかPSDを合わせて頂ければ嬉しいです。\n\n\n用途はXでの投稿や収益化したライブ配信や動画、アイコンやヘッダー使用、ネットプリント、グッズ、ファンボックスなどのVTuberとしての活動で使用させていただければと思っております。\n\n立ち絵などの資料は下記URLから確認していただければと思います。\n\n\n\nスケブでの依頼は慣れていないので至らない点があると思いますが、よろしくお願いします。\n\n\nhttps://lit.link/mewaurora\n\nhttps://lit.link/mewaurora", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hina_chizu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1651818, "client_id": 2223302, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b63ec585/uploads/origins/385e0f4f-2d9a-4bbc-8211-d47b65611cb6?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=9a3653f09ad6a7194a37745318c4b496", "srcset": "https://si.imgix.net/b63ec585/uploads/origins/385e0f4f-2d9a-4bbc-8211-d47b65611cb6?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=9a3653f09ad6a7194a37745318c4b496, https://si.imgix.net/b63ec585/uploads/origins/385e0f4f-2d9a-4bbc-8211-d47b65611cb6?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=575594ab33f7a9e38b26f12a08f4e6dd 2x, https://si.imgix.net/b63ec585/uploads/origins/385e0f4f-2d9a-4bbc-8211-d47b65611cb6?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=015a3a363b43adb2112a880438c358b3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b63ec585/uploads/origins/385e0f4f-2d9a-4bbc-8211-d47b65611cb6?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=9faf3c6646e05770a24999d5e5c952c5", "srcset": "https://si.imgix.net/b63ec585/uploads/origins/385e0f4f-2d9a-4bbc-8211-d47b65611cb6?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=9faf3c6646e05770a24999d5e5c952c5, https://si.imgix.net/b63ec585/uploads/origins/385e0f4f-2d9a-4bbc-8211-d47b65611cb6?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d833896220574241908834ba570c52e6 2x, htt