f&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a931974394f7f26124876c0488e31ad 3x"}, "body": "はじめまして、\nいつも(X)で先生の素敵なデザイラストを見ていました、\nskebでの依頼が再開しましたとお聞きして、この機会ぜひ依頼をできれば幸いです。\n\n【キャラクター】(空來Akira)\n身長186cm、やや褐色肌、引き締まっている筋肉質タイプ、\n人間と狼両方の耳を持っている、右の狼耳が欠けており。\n紺色髪、ギザ歯、右目は赤色、左目は灰色で、左眉から目を貫いた傷があり。\n直情径行で、少々荒っぽく、喧嘩っ早い。\n悪人ツラけど弱き者いじめをすることは嫌い。\n昂ぶり状態になると、左胸に狼のタトゥーが浮かび上がる。\n彼は絶滅したと思われていた妖狼一族の生き残り、影から影狼を呼び出す異能がある。\nくわしいのキャラ参照は下記のURLをご覧ください。\n\n【構図、ポーズ】\n刀剣乱舞の真剣必殺のようなかっこいい構えが欲しい。\nポーズは全てお任せいたします、ぜひイメージ通りに描いてください！\nその他は何でも構いませんので、ご自由に描いて～\nできれば影狼を描いてほしいが、複雑すぎる場合は省略してもOK。\n\nここまでお読み、私のリクエストを考慮していただければ幸いです、\n本当にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1aTlM9czMf51pyxVk5fAEV5V-BJp_gMH3", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reisei_zero/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2704296, "client_id": 2060511, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5ede105/uploads/origins/066fd687-1def-488e-8eab-7cfef203761a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0837190a1a069061e067f1dcb9567f14", "srcset": "https://si.imgix.net/d5ede105/uploads/origins/066fd687-1def-488e-8eab-7cfef203761a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0837190a1a069061e067f1dcb9567f14, https://si.imgix.net/d5ede105/uploads/origins/066fd687-1def-488e-8eab-7cfef203761a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b1b3561d86d77e7b37f1fc166c714e7 2x, https://si.imgix.net/d5ede105/uploads/origins/066fd687-1def-488e-8eab-7cfef203761a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc8ad40f1e881a7b08ee1954224ab6dd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5ede105/uploads/origins/066fd687-1def-488e-8eab-7cfef203761a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36bf1c5c6c9955f7f5289a0b629cdcce", "srcset": "https://si.imgix.net/d5ede105/uploads/origins/066fd687-1def-488e-8eab-7cfef203761a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36bf1c5c6c9955f7f5289a0b629cdcce, https://si.imgix.net/d5ede105/uploads/origins/066fd687-1def-488e-8eab-7cfef203761a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e252fa5fede8037f020824a56c052614 2x, https://si.imgix.net/d5ede105/uploads/origins/066fd687-1def-488e-8eab-7cfef203761a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9b1632bdbd9839a746996e16540d8475 3x"}, "body": "あなたの作品が大好きです。イラストがとても美しいです。私のNLオリジナルキャラクターのイラストを描いていただけませんか？お引き受けいただければ大変光栄です。参考資料は全て下記リンクにまとめてあります。どうぞご自身のスタイルで自由に描いてください。服装も好きなものを描いていただいて結構です。もしよろしければ、新しい衣装をデザインしても構いません。ハーマンの顔の傷は簡略化しないでください。 戦術装備を描く場合：ヘルメットは暗視ゴーグルの有無は任意です。防弾チョッキの空いた部分は弾倉（マグ）で埋めてください。「Herman-other」の絵画を参考に描いてください。タトゥーは簡略化しても構いません。アナは小柄で細身、肌は明るいブロンズ色です。 衣装は「Ana-衣装」を参照してください。依頼内容に不適切な点があれば、遠慮なく再送してください。私のオリジナルキャラクターに興味がない場合は、直接キャンセルしていただいて構いません。よろしくお願いします。https://drive.google.com/drive/folders/1_c0G4xFNtPc6gm9No0VX3fdnOqUOnxY2", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reisei_zero/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2704296, "client_id": 1426064, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a5de0f6/uploads/origins/36e87f5b-b7ac-4706-b6ee-5d5cb190dc22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0acf6693e67d75f9de1c438025b16d3", "srcset": "https://si.imgix.net/3a5de0f6/uploads/origins/36e87f5b-b7ac-4706-b6ee-5d5cb190dc22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0acf6693e67d75f9de1c438025b16d3, https://si.imgix.net/3a5de0f6/uploads/or