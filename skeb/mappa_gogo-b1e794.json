貧弱寄り\n・相手が初恋の人\n\n【関係性】\n仕事絡みで揉め敵対関係からスタート。茶髪男が勝利し、強さは認めた為に自分のチームへ引き入れた。いつも喧嘩ばかりしているが内心お互いを大切に思っている。\n本編ではまだ付き合っていませんが、このイラストでの距離感はくっついたあとでも険悪でもなんでも大丈夫です。\n\nhttps://drive.google.com/file/d/16nSfgPunLMiAl6ei4x10g34Zf_mnmx2l/view?usp=drivesdk\n\nhttps://skeb.jp/@kinenbicyan/works/54", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mappa_gogo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2536508, "client_id": 11245, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7337bfa2/uploads/origins/234e1307-eafb-47e4-bed8-f6f3a86b56cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81abeb54056bf1027c78f9904ace75fc", "srcset": "https://si.imgix.net/7337bfa2/uploads/origins/234e1307-eafb-47e4-bed8-f6f3a86b56cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81abeb54056bf1027c78f9904ace75fc, https://si.imgix.net/7337bfa2/uploads/origins/234e1307-eafb-47e4-bed8-f6f3a86b56cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=259a865eec4a4e2f4717113fd08b8280 2x, https://si.imgix.net/7337bfa2/uploads/origins/234e1307-eafb-47e4-bed8-f6f3a86b56cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dcc5f21e30df8ed9935cc14031cb2923 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7337bfa2/uploads/origins/234e1307-eafb-47e4-bed8-f6f3a86b56cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee5dea2c16c31e11988e848a336ea981", "srcset": "https://si.imgix.net/7337bfa2/uploads/origins/234e1307-eafb-47e4-bed8-f6f3a86b56cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee5dea2c16c31e11988e848a336ea981, https://si.imgix.net/7337bfa2/uploads/origins/234e1307-eafb-47e4-bed8-f6f3a86b56cd?bg=%23fff&auto=format%2Ccompres