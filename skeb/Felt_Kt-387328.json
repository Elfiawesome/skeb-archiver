ら落ちてきた、引きこもりの英雄様。若干厨二病。\n・数々の物語で読んだ伝説の英雄たちに憧れている。\n・魔導書があれば魔法が使える。\n・召喚した魔法生物『とんとん』によく過ごし、お世話されている。\n・好きなものは夜明けの空、本、おいしいごはん。\n・頭に浮いてる金平糖は魔力の結晶なので、食べて魔力補給することが出来ます。\n【使用用途】\n①YouTubeのメンバーシップ用壁紙の配布\n②動画のサムネイルなどに使用", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takotakohonpo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1988059, "client_id": 3425525, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5060afd3/uploads/origins/47f42b4a-e593-427a-88cb-c4f4fe983094?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5951cb0384822212be2a509ecda7620f", "srcset": "https://si.imgix.net/5060afd3/uploads/origins/47f42b4a-e593-427a-88cb-c4f4fe983094?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5951cb0384822212be2a509ecda7620f, https://si.imgix.net/5060afd3/uploads/origins/47f42b4a-e593-427a-88cb-c4f4fe983094?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=892075b7a31058f93548ccd417054e91 2x, https://si.imgix.net/5060afd3/uploads/origins/47f42b4a-e593-427a-88cb-c4f4fe983094?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e79cb82ffc13b787e01e0ba1b387561b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5060afd3/uploads/origins/47f42b4a-e593-427a-88cb-c4f4fe983094?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f07863da272c053d3403c8c5f185b23", "srcset": "https://si.imgix.net/5060afd3/uploads/origins/47f42b4a-e593-427a-88cb-c4f4fe983094?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f07863da272c053d3403c8c5f185b23, https://si.imgix.net/5060afd3/uploads/origins/47f42b4a-e593-427a-88cb-c4f4fe983094?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=64afcb5f1