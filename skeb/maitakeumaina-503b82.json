-8f00-9d175287b0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c59146f8964e2446373addea7d1a105, https://si.imgix.net/96b3cd2a/uploads/origins/bbe876b4-35a3-4758-8f00-9d175287b0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09e91d338b7a98a3dcf57e79312ea3ca 2x, https://si.imgix.net/96b3cd2a/uploads/origins/bbe876b4-35a3-4758-8f00-9d175287b0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6cc359497ec3a1f850367163d438e6e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96b3cd2a/uploads/origins/bbe876b4-35a3-4758-8f00-9d175287b0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6114c361ff48815f2d5950c0958efbac", "srcset": "https://si.imgix.net/96b3cd2a/uploads/origins/bbe876b4-35a3-4758-8f00-9d175287b0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6114c361ff48815f2d5950c0958efbac, https://si.imgix.net/96b3cd2a/uploads/origins/bbe876b4-35a3-4758-8f00-9d175287b0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7d24b38f79b09697753113d2d898217b 2x, https://si.imgix.net/96b3cd2a/uploads/origins/bbe876b4-35a3-4758-8f00-9d175287b0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=99b6079b8c0ed91d1b2440ff24613423 3x"}, "body": "舞たけペンギン先生、こんにちは！\n先生のイラスト、特にシゲウィネ、クリー、ナヒダのイラストが本当に大好きです！\nもし私のオリジナルキャラクター「メテガコ・スター」を描いていただけたら、とても嬉しいです。\nメテガコは『ディスガイア』シリーズのスターメイジで、特に初代作品の旧デザインを着用しています。\n参考資料には日本語版と英語版があります。\n 参考資料にはまだ角度やポーズが十分ではないのですが、現在作成中のため、ご了承ください。\nもしオリジナルの『ディスガイア』の魔女のデザインをご存じない場合は、「Disgaea Witch」フォルダに参考画像をいくつか用意しました。\nご依頼をご検討いただき、誠にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1n0KaAq3bi0PrY3MAJLYJi7TVxmkGdb08?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maitakeumaina/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2855151, "client_id": 515379, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/04b2673e/uploads/origins/29ba4632-daf9-4fec-a8b5-8b6d4a96a102?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b49e3cc0362adb4b1ee3205f927f186c", "srcset": "https://si.imgix.net/04b2673e/uploads/origins/29ba4632-daf9-4fec-a8b5-8b6d4a96a102?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b49e3cc0362adb4b1ee3205f927f186c, https://si.imgix.net/04b2673e/uploads/origins/29ba4632-daf9-4fec-a8b5-8b6d4a96a102?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d7766849876e46a3ec9bf854736e3a4 2x, https://si.imgix.net/04b2673e/uploads/origins/29ba4632-daf9-4fec-a8b5-8b6d4a96a102?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef4a09de2b749466b7761517c69ab71d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04b2673e/uploads/origins/29ba4632-daf9-4fec-a8b5-8b6d4a96a102?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e975de10e0ebb05a1b89420eb1313f8a", "srcset": "https://si.imgix.net/04b2673e/uploads/origins/29ba4632-daf9-4fec-a8b5-8b6d4a96a102?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e975de10e0ebb05a1b89420eb1313f8a, https://si.imgix.net/04b2673e/uploads/origins/29ba4632-daf9-4fec-a8b5-8b6d4a96a102?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e3dd8ef099fa77468c09f9c7854283e0 2x, https://si.imgix.net/04b2673e/uploads/origins/29ba4632-daf9-4fec-a8b5-8b6d4a96a102?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5cc20f6f84dd715f8fe96623eb12f6b1 3x"}, "body": "舞たけぺんぎんさん初めまして！すなじろと申します。\nTwitterにて舞たけぺんぎんさんの描かれている原神キャラ、特にロリっこたちのイラストがとても可愛く好みで楽しみに拝見しております！\nもちもち可愛いお顔やビビッドでキラキラな瞳に色彩がすごく好きです……！\nうちの子であるノラちゃんも、ぜひ舞たけぺんぎんさんの絵柄で描いていただきたいです！\n資料が過去のSkebリクエストのみとなることをご容赦ください。\n\nノラちゃんは、狐をモチーフとしたけもみみの女の子です。\n年齢は10代半ばくらいでやや小柄、大きなしっぽと八重歯がチャームポイントです。\nいつも眠そうで少しじっとりとした青い目と、ふさふさなボブくらいの髪の毛が特徴で、トレードマークの青い眼鏡をおでこにひっかけています。\nゆとりのある服装が好きで、普段は青いパーカーに黒いハーフパンツを着用しています。\n性格はおっとりとしていてだらけることが好きな子ですが、ノリは良くお茶目なポーズをよくする子です。\n\n今回よろしければ、普段描かれているクレーちゃんくらいの等身で描いていただけないでしょうか？\n年齢は前述のとおりですが、無視してもう少し幼いものと思っていただいても結構です。\n併せて服装を自由にアレンジ・変更していただけると嬉しいですが、水着等の露出の多いもの（肩出しやおなかのチラ見えぐらいであれば大丈夫です）や園児服・学生服は避けていただきたいです。\n（悩むようであれば、パーカー+ショートパンツのデフォルト服装でも構いません！）\nポーズ・構図はひざの映る構図のものだと嬉しいです（座りポーズ、立ちポーズ等問いません。衣装変更の結果衣服に隠れていても大丈夫です）。\n納品形式は可能ならPSDで、ラフや没案などありましたら納品物内に含めていただけるととても嬉しいです！\nそのほかの事項についてはお任せします。\n可愛く・楽しく描いてくだされば何よりです！\n\nリクエストは以上となります。要望が多くてすみません！\n頂いたイラストは自身の保有するSNS等のアカウントで、アイコン・ヘッダーとして使用することがあります。 よろしくお願いします！\n\nhttps://skeb.jp/@sunajiro8", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maitakeumaina/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1b5f1e12/uploads/origins/c281be86-e6b6-414a-a7e7-acb8e1c155e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78f393d06da8d0fa0a5a83754f6fb43e", "srcset": "https://si.imgix.net/1b5f1e12/uploads/origins/c281be86-e6b6-414a-a7e7-acb8e1c155e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78f393d06da8d0fa0a5a83754f6fb43e, https://si.imgix.net/1b5f1e12/uploads/origins/c281be86-e6b6-414a-a7e7-acb8e1c155e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7893c46bbbbe2f5716a243da486c55e 2x, https://si.imgix.net/1b5f1e12/uploads/origins/c281be86-e6b6-414a-a7e7-acb8e1c155e6?bg=%23fff&auto=format%2Cc