utube.com/@あまねてん\n\n\nお任せの部分が多く恐縮ですが、舞たけぺんぎんさんらしい可愛さで自由に描いていただけたらとても嬉しいです！\n\nどうぞよろしくお願いいたします！\n\n＿＿＿＿＿＿＿＿＿＿＿＿  \n\nSkebの利用にはまだ不慣れな部分もあり、不手際がありましたら申し訳ございません。 お忙しいところ恐縮ですが、ご検討いただけますと嬉しいです。 \n＿＿＿＿＿＿＿＿＿＿＿＿＿\n\nhttps://drive.google.com/drive/folders/1ZH3nKp8svAhdPYmOWhK7SqjosR3MgEDs?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maitakeumaina/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2855151, "client_id": 2024019, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5008f43/uploads/origins/16ec6aa9-e352-4dbc-8213-153ab89b6bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7c0e32ac7dde6b59e4648de195ab99d", "srcset": "https://si.imgix.net/b5008f43/uploads/origins/16ec6aa9-e352-4dbc-8213-153ab89b6bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7c0e32ac7dde6b59e4648de195ab99d, https://si.imgix.net/b5008f43/uploads/origins/16ec6aa9-e352-4dbc-8213-153ab89b6bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b590781ab509c17b9fba2d2100fb041 2x, https://si.imgix.net/b5008f43/uploads/origins/16ec6aa9-e352-4dbc-8213-153ab89b6bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2664208bb206a35b078c85b9d20a864b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5008f43/uploads/origins/16ec6aa9-e352-4dbc-8213-153ab89b6bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b95ede7ab2ea629600295bcbd4f24ca", "srcset": "https://si.imgix.net/b5008f43/uploads/origins/16ec6aa9-e352-4dbc-8213-153ab89b6bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b95ede7ab2ea629600295bcbd4f24ca, https://si.imgix.net/b5008f43/uploads/origins/16ec6aa9-e352-4dbc-8213-153ab89b6bb5?bg=%23fff&au