op=top&w=200&h=200&blur=200&s=5eab63ca7dd5ccd645f93359b4bc52f4, https://si.imgix.net/7b34bcbd/uploads/origins/eafde069-7f84-42fb-a9b5-1e29abd5c651?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62200e9d51597ee2f97c8172bf9d31af 2x, https://si.imgix.net/7b34bcbd/uploads/origins/eafde069-7f84-42fb-a9b5-1e29abd5c651?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=91e0733aef26fbd9376b02a7e06e5ca3 3x"}, "body": "こんにちは！はじめまして！\nあなたの作品が大好きで、ぜひイラストを依頼したいと思っています。\n\n私のオリジナルキャラクター／VTuberの「フィムシュ」を描いていただけませんか？\n彼女は生意気で気取ったゾンビの医者です。\nアンテナと尻尾はウミヘビから、腰の周りの余分な手足はエビからインスピレーションを得ています。\nジャケットを着た姿でも、脱いだ姿でも、お好きな方で描いてください！\n\nポーズや表情は自由にお任せします！彼女の生意気なところをしっかり表現してください。\n\n参考画像はこちらです：\nhttps://drive.google.com/drive/folders/1xWkK2dXXVa5_EIGZ8HHMM9SL_tiAsFTf?usp=sharing\n\n本当にありがとうございます！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@niconicoskb/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4013951, "client_id": 2408964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a35a152/uploads/origins/9b898389-5dbe-44e3-a01c-faa6c88cda0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43207bcac6b82bfdc672bc8fd11c3d68", "srcset": "https://si.imgix.net/1a35a152/uploads/origins/9b898389-5dbe-44e3-a01c-faa6c88cda0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43207bcac6b82bfdc672bc8fd11c3d68, https://si.imgix.net/1a35a152/uploads/origins/9b898389-5dbe-44e3-a01c-faa6c88cda0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db426fe4d69a334fac508efdb3ceb6a5 2x, https://si.imgix.net/1a35a152/uploads/origins/9b898389-5dbe-44e3-a01c-faa6c88cda0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84f7288eb854c4f2e1936d104b4ab660 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a35a152/uploads/origins/9b898389-5dbe-44e3-a01c-faa6c88cda0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9717ee0cd5edee4563e25db28abb914a", "srcset": "https://si.imgix.net/1a35a152/uploads/origins/9b898389-5dbe-44e3-a01c-faa6c88cda0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9717ee0cd5edee4563e25db28abb914a, https://si.imgix.net/1a35a152/uploads/origins/9b898389-5dbe-44e3-a01c-faa6c88cda0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=848f9b0cf18bb58c87b6121c0dc559c4 2x, https://si.imgix.net/1a35a152/uploads/origins/9b898389-5dbe-44e3-a01c-faa6c88cda0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2ccc3b5184ead5f399e342b6665109a 3x"}, "body": "こんにちは！いつも素敵な作品をありがとうございます！貴方様の描く、ニコイチの距離感や可愛らしい絵柄、生き生きとした動きのキャラたちが大好きです！\n\n今回はもしよければ貴方様の絵柄で私のOC二人を描いて欲しいと思いリクエストさせていただきました！\n\n・キキ\n金髪にウルフカット/瞳はグレー〜紫で猫目/両耳に流星のピアス\n\n幼馴染で親友のライカと共に一緒に月の裏側で会う約束をしていたが、ライカが失踪してしまい寂しさを抱えながら彼女を探すために宇宙へ旅をしに行く決意をする高校生。柴犬のイオくんを飼っている。\n -モチーフ：流星/地図/ヘッドフォン/向日葵\n\n・ライカ\n水色のパッツンで前下がりのボブ/瞳は黄色寄りのオレンジでつり目\n\nキキの幼馴染で親友。天才的な頭脳の持ち主で、天文学者を目指している高校生。\nキキと共に誕生日を迎えたら月の裏側で待ち合わせるはずだったが、直前で「地球は赤かった！」という書き置きを残して失踪してしまった。\n -モチーフ：月食/天球儀/カメラ/ハルジオン\n\n【世界観】\nアポロ11号が月面着陸に成功してから60余年。宇宙開発技術が飛躍的に進歩した現代では、国際宇宙法に基づき特別な訓練や資格を有さずとも16歳を迎えれば誰でも簡単に月へ行くことが出来るようになった。今や日本でも、南極に行くよりは簡単なくらいには月面旅行が浸透しつつある。\n\n・イメージソング：アイラ/ストラトステラ/Sci-Fi ROMANCE TLAVELER/熱異常/DiSTANCE/秘密(はるまきごはん)/ハネムーン(LOLUET)\n\n・作品全体のキーワード：宇宙/ロケット/手紙/月/流星/祈り/待ちぼうけ/孤独/共鳴/天球儀/憧れ/希望/自然/天体観測/\n\n\n上記を基にしていただければ、キャラはどちらか片方でも構いません！服装なども好きに変えていただいて大丈夫です！描きやすいように描いていただけたら嬉しいです！\n\n\nあらすじなどの文章\nhttps://privatter.me/page/6828a8b68f1e5\n\n画像などは資料urlに添付しております！\n\nhttps://drive.google.com/drive/folders/1StcIUcp747KVpt0OZSEMVMnoeO5Wjwa_", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@niconicoskb/work