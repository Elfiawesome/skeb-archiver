90\n\nhttps://xfolio.jp/portfolio/d0kuhaku/works/3808428\n\nhttps://xfolio.jp/portfolio/d0kuhaku/works/4860129\n\nhttps://xfolio.jp/portfolio/d0kuhaku/works/1258712\n\n\nシチュエーション、構図等はお任せしますが、ふたりの距離が近めだと嬉しいです。\n\n描いていただいたイラストは、観賞用として大切に目の保養にさせていただきます。また、よろしければBlueskyで紹介させてください。 値段が合わなければキャンセルしていただいてかまいません。\n 以上、ご検討のほどよろしくお願いいたします。\n\n(リクエストのふたりはまだ出会っていませんが、キャラクターの雰囲気がわかる本編漫画を添付致します。参考になれば幸いです。)\n\nhttps://xfolio.jp/portfolio/d0kuhaku/series/227556\n\nhttps://bsky.app/profile/aruiha4ru.bsky.social/post/3luwzq4edok24", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karin_reiro00/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2196373, "client_id": 8171, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62a87ab8/uploads/origins/1172de03-3386-41a5-9ec0-342fc7ef457a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a59ba70e8ca945eac09e8cbe994d30a1", "srcset": "https://si.imgix.net/62a87ab8/uploads/origins/1172de03-3386-41a5-9ec0-342fc7ef457a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a59ba70e8ca945eac09e8cbe994d30a1, https://si.imgix.net/62a87ab8/uploads/origins/1172de03-3386-41a5-9ec0-342fc7ef457a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58669ab1a3380c19e0aa16742f012cec 2x, https://si.imgix.net/62a87ab8/uploads/origins/1172de03-3386-41a5-9ec0-342fc7ef457a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d38c0a0f85922922d216e90046d1ace3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62a87ab8/uploads/origins/1172de03-3386-41a5-9ec0-342fc7ef457a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=756ab3acf51e00c52898eeddcd0d3ca8", "srcset": "https://si.imgix.net/62a87ab8/uploads/origins/1172de03-3386-41a5-9ec0-342