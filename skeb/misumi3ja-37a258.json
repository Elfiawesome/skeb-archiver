pr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b7d0982f835e12973ae73e9939d9501e 3x"}, "body": "三角様初めまして、八咫乃白夜という個人VTuberです。\n\n目玉様と俺/ｼｬﾙﾙを愛でる会会長様の依頼した絵がとても好きでしたので、是非依頼いただいです。\n\n設定は北極圏の雪森に長年住んでいる白い八咫烏です。見た目は少し冷たいや無表情な顔ですが、実は眠いだけです。それから、とってもからかいが好きです。\n\n構図やポーズはお任せします。\n\n※イラストはTwitterでアップロードし, YouTube, Twitch配信サムネイルでの利用を考えていますので、できれば、バックグラウンドを別のレイヤーにして頂きたいです。\n\nhttps://drive.google.com/drive/folders/1h9c7U1HwdBdmYd4vcJoWguLk_u15icuV?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@misumi3ja/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4973afa9/uploads/origins/943e64cb-2bd8-4fa0-9f90-40726e270d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=090411b12433d14be0ea8465eb0f66ff", "srcset": "https://si.imgix.net/4973afa9/uploads/origins/943e64cb-2bd8-4fa0-9f90-40726e270d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=090411b12433d14be0ea8465eb0f66ff, https://si.imgix.net/4973afa9/uploads/origins/943e64cb-2bd8-4fa0-9f90-40726e270d84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9630b7dac3b4bd35cc2cee3446fcff46 2x, https://si.imgix.net/4973afa9/uploads/origins/943e64cb-2bd8-4fa0-9f90-40726e270d84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19c80c203afc6804a70b46a1c85dc913 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2228601, "client_id": 1751175, "nc": 1}, {"path": "/@misumi3ja/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2228601, "client_id": 2228733, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/237ad175/uploads/origins/77db4a54-f260-4d76-83d1-578af52fa0e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60ee6c230d1188726a70b7d21656d618", "srcset": "https://si.imgix.net/237ad175/uploads/origins/77db4a54-f260-4d76-83d1-578af52fa0e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60ee6c230d1188726a70b7d21656d618, https://si.imgix.net/237ad175/uploads/origins/77db4a54-f260-4d76-83d1-578af52fa0e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=865e7c63f8544afffc90e29a2ac6f628 2x, https://si.imgix.net/237ad175/uploads/origins/77db4a54-f260-4d76-83d1-578af52fa0e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10ead4f3e2f70969d8610947995d591f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/237ad175/uploads/origins/77db4a54-f260-4d76-83d1-578af52fa0e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c67a96ab6a1f0979ea547d8be884512", "srcset": "https://si.imgix.net/237ad175/uploads/origins/77db4a54-f260-4d76-83d1-578af52fa0e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c67a96ab6a1f0979ea547d8be884512, https://si.imgix.net/237ad175/uploads/origins/77db4a54-f260-4d76-83d1-578af52fa0e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e7b40a4acd55b904ff56b916292800f5 2x, https://si.imgix.net/237ad175/uploads/origins/77db4a54-f260-4d76-83d1-578af52fa0e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2301e920b0858a2a2ca89862eb0d024 3x"}, "body": "炎暑の候、三角様におかれましては日々ご清祥のこととお慶び申し上げます。\nわたくし、梅林ヒュウガと申します。どうぞ宜しくお願い致します。\n\nこの度初めてSkebなるものに応募させていただきます。\nまた、依頼に際して失礼等ございましたら申し訳ございません。\n\nポケモンのイラストをきっかけに三角様のことを知って以来、鍵アカウントからのフォローではございますが、日頃素敵な作品の数々を拝見しております。\n画面の向こうに生きる被写体の日常を切り取ったような、自然で生き生きとした表情や動作、仕草の描写に、わたくし自身生きる活力をいただいております。\n三角様の描かれるデルウハ殿が大変魅力的なので、近日Thisコミュニケーションも履修しようと考えております。\n\nさて、三角様がSkebを開設された日から絶対に依頼したいと考えており、募集締め切りの影に怯えながら依頼文をしたためておりました。\n依頼内容についての「可能な限り詳細に指示を」という文言を大いに履き違えている可能性を承知の上で、依頼内容をお伝え致します。\n\n\nこの度三角様にお願いしたいのは、わたくしのオリジナルキャラクターです。\n彼の名前はシャルルと言い、16歳の少年です。\n身長は160～165cmほどで、同年代の中ではやや控えめな方です。\n一人称は僕で、基本誰に対しても敬語で喋ります。\n面倒見が良くしっかり者です。年上の相手にも物怖じしません。\n職業は魔道士で、仲間の支援・補助・回復が得意です。\n\n彼の容姿は、恐縮ながら資料URLの欄に画像URLを添付致します。\nお手数に次ぐお手数となり、誠に申し訳ございません。\n※画像内におきまして、生意気にも色の見本を添付しておりますが、暗にカラーでの作品を強要している訳ではございません。ご了承の程宜しくお願い申し上げます。\n\n\nわたくしが個人的に思う三角様の作品の魅力の一つである「自然体」の部分を享受するにはどうしたら良いかと考えまして、ソファでうたた寝(昼寝)をするシャルルを、是非とも三角様の絵で見てみたいという結論に至りました。\n華奢で小柄な少年が大きなものに埋もれたりしている姿に、大変にBIGなLOVEを感じる性分でありまして、大きめのクッションにもたれつつ、膝(腹)の上にも大きめのクッションを抱えているシチュエーションでお願いしたく存じます。\nぎゅっと抱き抱えると言うより、クッションが落ちない程度に手を添えているようなイメージです。脱力感を感じられますと嬉しいです。\nダブルソファの左右どちらかの端に寄って座っている体でお願い致します。無論ソファ全体を入れていただく必要はございません。\n画像では、容姿についての補足説明にて「つり気味(略)の眉」としておりますが、寝ているときや寝起きは流石に緩むのではないかと思っております。妄想です。\n部屋の内装まで指定したりお考えいただくのは流石に過剰要求と存じますので、何となく「明るいところ(窓辺など)にいるんだなぁ」という雰囲気がありますとなお嬉しいです。\nおよそこんな日差しの厳しい時期にお願いする内容ではないのですが、無理を承知でお願い申し上げます。\n\n\n下手の横好きながら、絵を描く労力につきましては重々承知しているつもりでございます。\n三角様の体調やお時間とご相談いただいた上で、承認されるか否かを判断していただければ幸いに存じます。\n\n最後までお読みいただきありがとうございます。\n長文失礼致しました。\n梅林ヒュウガ\n\nhttps://uploda1.ysklog.net/uploda/b0c5ba6c2e.png", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@misumi3ja/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0e43b597/uploads/origins/47bde97d-94de-4ae3-9e5e-c446689a69b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45c1158a2d2d9519dd71f3590433586d", "srcset": "https://si.imgix.net/0e43b597/uploads/origins/47bde97d-94de-4ae3-9e5e-c446689a69b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtsha