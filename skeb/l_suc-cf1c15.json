ジしても構いません。\n報酬が割に合わないと思いましたら再送を御願い致します。\n不都合があれば完全キャンセルして構いません。\n注文が細かく申し訳無いですが、どうぞ御検討宜しく御願い致します。\n\n資料\nガルーダ\nhttps://dragalialost.wiki/w/Garuda\nルーエン\nhttps://dragalialost.wiki/w/Lowen\nhttps://dragalialost.wiki/w/Halloween_Lowen\n登場イベント　天つ風に願いを\nhttps://youtu.be/qbb--kAy-hQ?si=E908UFmVol5B4i5h", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@l_suc/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4013449, "client_id": 97802, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b663dc5/uploads/origins/9fb2f000-510e-4fc2-aba9-8c2ce85ee852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98db2c989928edbe4a72082698295cb6", "srcset": "https://si.imgix.net/5b663dc5/uploads/origins/9fb2f000-510e-4fc2-aba9-8c2ce85ee852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98db2c989928edbe4a72082698295cb6, https://si.imgix.net/5b663dc5/uploads/origins/9fb2f000-510e-4fc2-aba9-8c2ce85ee852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c24bd91e4242d04dbf5e75a43500f9d4 2x, https://si.imgix.net/5b663dc5/uploads/origins/9fb2f000-510e-4fc2-aba9-8c2ce85ee852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9ad813bbb8f5aa482241aef3ac9a6ad 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b663dc5/uploads/origins/9fb2f000-510e-4fc2-aba9-8c2ce85ee852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2eff64bc9dfeb3a37c51b9eda5787d83", "srcset": "https://si.imgix.net/5b663dc5/uploads/origins/9fb2f000-510e-4fc2-aba9-8c2ce85ee852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2eff64bc9dfeb3a37c51b9eda5787d83, https://si.imgix.net/5b663dc5/uploads/origins/9fb2f000-510e-4fc2-aba9-8c2ce85ee852?bg=%23fff&auto=format