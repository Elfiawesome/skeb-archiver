.com/a/qjMjvOa\nhttps://imgur.com/a/meBPl5b\nhttps://imgur.com/a/mlFQZtI\nhttps://imgur.com/a/jwB4w4s\nhttps://imgur.com/a/MbB9R5e\nhttps://imgur.com/a/AQj43bV\n支配に抗い切る時\nhttps://imgur.com/a/bRkYvz1\nhttps://imgur.com/a/zAyMwH6", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 81643, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "きのこダケ", "screen_name": "kinokodake365", "avatar_url": "https://pbs.twimg.com/profile_images/2085411425665843200/iFR1Vc9H.jpg", "header_url": "https://pbs.twimg.com/profile_banners/112232939/1643824019/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 191653, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "おいまんじ", "screen_name": "oimanji", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Feb3d5ade-cb81-486e-a7c0-ee056047db21.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/e8470dd3-1823-4864-b041-2e1f665d72b3.png", "appeal_receivable": true, "popular_creator_rank": 30, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 307566, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "鳴滝", "screen_name": "nrtk_2", "avatar_url": "https://pbs.twimg.com/profile_images/852283777975844864/CGvYjb8x.jpg", "header_url": "https://pbs.twimg.com/profile_banners/727794707225399296/1505529831/1500x500", "appeal_receivable": false, "popular_creator_rank":