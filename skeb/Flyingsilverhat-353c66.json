91-be89-d3d2a56711a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0884b3b17833798cfd6c46e2b323cc27", "srcset": "https://si.imgix.net/a45d9b21/uploads/origins/13034899-0565-4491-be89-d3d2a56711a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0884b3b17833798cfd6c46e2b323cc27, https://si.imgix.net/a45d9b21/uploads/origins/13034899-0565-4491-be89-d3d2a56711a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f3c4a427109f1e089a96e3e86f74e31b 2x, https://si.imgix.net/a45d9b21/uploads/origins/13034899-0565-4491-be89-d3d2a56711a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e4ff09ae1b56d8aef359ffe353184f25 3x"}, "body": "Ｚガンダム公式外伝ＡＯＺリブートのキャラ「アリシア・ザビ」を是非とも\n\n●●１：外見\n下記のＵＲＬのキャラです\nhttps://i.imgur.com/Pm3c6BO.jpg\nhttps://i.imgur.com/B9d2l57.jpg\nhttps://i.imgur.com/UDGp3eG.jpg\n下記の真ん中のキャラです\nhttps://i.imgur.com/kdeheNO.jpg\n\n名前：アリシア・アズ・ザビ\n性別：女\n年齢：１４歳\n身長：１５０ｃｍ\n体系：巨乳グラマー（太腿・１本がウエストと同じ～やや太い程）\n髪型：巫女結いのロング\n瞳の色：薄紫\n\nアニメ・機動戦士ガンダムＺＺのエルピー・プルをご存知でしょうか？\nアリシアは、「ギレン・ザビの子とＮＴの女性との人工受精児（ｏｒギレンの体細胞クローン）」であるプルの妹の一人です\n\n火星を支配するジオン組織・レジオンの総帥です。\nティターンズのガンダムである「ＲＸ－１２４ガンダムＴＲ－６ハイゼンスレイⅡ」をレジオン仕様に改造した「ＡＲＺ－１２５リハイゼ」のパイロットです\n\n言動を観るに、父であるギレンの思想を受け継いでる様です\n\n\n色の参考（下の左の２人。右の大きな１人）\n※アリシア達もプルツーも受精卵クローン＝人工的な双子なので、実は全員オリジナルです\n　双子、三つ子、四つ子…に対して、長子をオリジナルと言わない様に\nhttps://i.imgur.com/oksX6DW.png\n\n●●２：情況\nリクエストする自分の代理＝アリシアの、東京移住記念イラストです\n\n何度も○○○人には部屋は貸せない…で門前払い\n２０２２年以降、自由と民主主義は死んだ\nいや、最初から欧米日本の自由と民主主義は死んでいた\n\n…と絶望でしたが、捨てる神あれば拾う神あり！\n決まりました\nバンダイ本社の近く。通勤時にも前を通ります\n\n\n国会図書館、上野駅の博物館、御徒町駅のアメ横、秋葉原、浅草の墨田川、スカイツリーを、観て周って東京を満喫しているアリシアです\n・上記６地域をコマ割りやごちゃ混ぜの描写\n・どれか一つか二つの地域に絞って描写\nどちらのイラストでも構いません\n\n●●３：服\n資料ＵＲＬの画像の生足ミニスカ軍服は…\n流石に観光する服ではないので…\n\n首に細いベルト式チョーカー\nミニスカ\n生足\n\n…なら、他は、詳細一任します\n\n●●４：ポーズ\n一任します\n\n●●５：表情\n笑顔です。詳細一任します。\n\n\n細かいことも書いてますが、基本は一任します\n\nそれではよろしくお願いします\n\nhttps://i.imgur.com/ddz73Ns.png", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 41775, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "月見うどんこ", "screen_name": "tukidemotituki", "avatar_url": "https://pbs.twimg.com/profile_images/1648220037784952833/qwSBgRmk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/180002662/1745255594/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 1766031, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "一宮 幽✦連載中", "screen_name": "ichimiyayu", "avatar_url": "https://pbs.twimg.com/profile_images/2004022575790542849/FYQOAkvr.jpg", "header_url": "https://pbs.twimg.com/profile_banners/918361356897624064/1743068892/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 90, "skills": [{"genre": "comic"}, {"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 161}, {"id": 2161689, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "新田真子", "screen_name": "shindamane", "avatar_url": "https://pbs.twimg.com/profile_images/1852208388597596160/cPdOIryg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2898532344/1730435868/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 2793215, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "めりのうる", "screen_name":