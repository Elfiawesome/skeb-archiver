op=top&w=200&h=200&blur=200&s=ea8785d2ca5828919d2062a1853b5c80 2x, https://si.imgix.net/8145f6cc/uploads/origins/e2871903-19ec-4b38-8a55-d65679073622?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=700ffce79f70c195f4fd096e29b8c448 3x"}, "body": "こんばんは、396さん。\n今度友達とのOCを依頼したいです。\nシチュエーションや衣装は自由にお願いします。\nもし金額が足りない場合は、キャンセルまたは再リクエストをお願いします！\n\nhttps://drive.google.com/drive/folders/1Xz_fUHvV2hpm34MB94ZzgmcDIWj9sl3U?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zkr_3969/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4022432, "client_id": 3676848, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba2fb8a1/uploads/origins/54453966-4b59-4c59-9783-680419f3186d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0df0a695b73605b7492e1666a8a5673d", "srcset": "https://si.imgix.net/ba2fb8a1/uploads/origins/54453966-4b59-4c59-9783-680419f3186d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0df0a695b73605b7492e1666a8a5673d, https://si.imgix.net/ba2fb8a1/uploads/origins/54453966-4b59-4c59-9783-680419f3186d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c2c863e03c530cb4e412a6335417db8 2x, https://si.imgix.net/ba2fb8a1/uploads/origins/54453966-4b59-4c59-9783-680419f3186d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1587252a1e5dae26268a630b8f991f02 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba2fb8a1/uploads/origins/54453966-4b59-4c59-9783-680419f3186d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57be3671627153e2cdb3738495a4e11a", "srcset": "https://si.imgix.net/ba2fb8a1/uploads/origins/54453966-4b59-4c59-9783-680419f3186d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57be3671627153e2cdb3738495a4e11a, https://si.imgix.net/ba2fb8a1/uploads/origins/54453966-4b59-4c59-9783-680419f3186d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f29787a6f5396a0530e2af317a03321b 2x, https://si.imgix.net/ba2fb8a1/uploads/origins/54453966-4b59-4c59-9783-680419f3186d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=86bac95195d64b7c27619d78f759b723 3x"}, "body": "はじめまして｡\n\n先日おすすめのクリエイターとして貴方の事を紹介され､作品を拝見しました｡とても好みな絵柄でしたので､是非とも拙宅の子を描いて頂きたくリクエストを送らせていただきました｡\n\n〇依頼内容\n下記URLの[呪里]と[類]をお願いしたいです｡\n\nhttps://x.com/majima_san4/status/1850858293096267791?s=46&t=5ggQqV_ECII6TATabP2B7A\n\nhttps://x.com/majima_san4/status/1850858492095074457?s=46&t=5ggQqV_ECII6TATabP2B7A\n\n等身資料\nhttps://x.com/majima_san4/status/1958471611146699129?s=46&t=5ggQqV_ECII6TATabP2B7A\n\nhttps://x.com/majima_san4/status/1968258278577844633?s=46&t=5ggQqV_ECII6TATabP2B7A\n\n・キャラ詳細\n[呪里]\n･自創作の主人公\n･一人称[私]\n･左手が黒い(魔法で創った義手設定)\n･あまり感情の起伏が無い\n･心霊系は得意な方では無いが､周囲が怖がっていると逆に冷静になるタイプ\n\n[類]\n･一人称[僕]\n･呪里に仕えている(ボス呼び･敬語無し)\n･組織の幹部で医療面を担当している｡\n･メイド服は仕事服です(男ですが…)\n･口頭での会話が不可能なのだが､何故か呪里には何を言っているのかが伝わる(テレパシー?)\n･お化けや心霊系が大の苦手\n\n〇希望シーン\nお化け屋敷前で嫌だと駄々をこねる類と何とか一緒に行きたい呪里のやり取りをお願いしたいです｡\n\n以前書いた小話があるのでよろしければ参考程度にご覧下さい↓ ↓ ↓\n\nhttps://privatter.me/page/6846f6b906fd2\n\nセリフや雰囲気､構図等は全てお任せします｡\n\n○使用用途\n個人鑑賞\n\n金額等不足がありましたら､再送請求又はキャンセルをお願いいたします｡\n\nお忙しいところ恐縮ですが､ご検討の程よろしくお願いします｡\n\nhttps://x.com/majima_san4/status/1850858293096267791?s=46&t=5ggQqV_ECII6TATabP2B7A", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zkr_3969/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/037946cc/uploads/origins/9cf1013b-a0fe-4e16-85f6-31265c15ae71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fbc491c565a5eb86dbd90c356161a1a3", "srcset": "https://si.imgix.net/037946cc/uploads/origins/9cf1013b-a0fe-4e16-85f6-31265c15ae71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fbc491c565a5eb86dbd90c356161a1a3, https://si.imgix.net/037946cc/uploads/origins/9cf1013b-a0fe-4e16-85f6-31265c15ae71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7736bd056f5e2771047f9c3c075552e2 2x, https://si.imgix.net/037946cc/uploads/origins/9cf1013b-a0fe-4e16-85f6-31265c15ae71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c08e32ce4f32518c37b8f93164a6a59 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 4022432, "nc": 145}, {"path": "/@zkr_3969/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4022432, "client_id": 3991569, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d747083/uploads/origins/b500046b-d99f-4242-be96-eaf69a6d5899?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d2be7ae414f5b666239cf23dab7b7c1", "srcset": "https://si.imgix.net/2d747083/uploads/origins/b500046b-d99f-4242-be96-eaf69a6d5899?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d2be7ae414f5b666239cf23dab7b7c1, https://si.imgix.net/2d747083/uploads/origins/b500046b-d99f-4242-be96-eaf69a6d5899?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d36580493986d5d9e354b58f857e83ed 2x, https://si.imgix.net/2d747083/uploads/origins/b500046b-d99f-4242-be96-eaf69a6d5899?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa68655b353df9324cf56e56f78960b8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d747083/uploads/origins/b500046b-d99f-4242-be96-eaf69a6d5899?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9fa6b3931c85f57e0bbb63182efa003", "srcset": "https://si.imgix.net/2d747083/uploads/origins/b500046b-d99f-4242-be96-eaf69a6d5899?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9fa6b3931c85f57e0bbb63182efa003, https://si.imgix.net/2d747083/uploads/origins/b500046b-d99f-4242-be96-eaf69a6d5899?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=93cf97df1b8f0916f9d1981a1eacef51 2x, https://si.imgix.net/2d747083/uploads/origins/b500046b-d99f-4242-be96-eaf69a6d5899?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=14e6b86704b8d8775006978b841c4a6d 3x"}, "body": "396様はじめまして、瑞尾と申します。\nにじさんじのイラストが好きでフォローしていたのですが、一次創作の方に流れてきて驚きと喜びからリクエストを送信いたしました。\nこの度は当方のオリジナルキャラクターを描いていただきたいです。\n\n創作BLの2人になるので、難しい場合は遠慮なくお断りください。\n以下に詳細を記載いたします。\n\n攻め→シェリー･トイフェル\n悪魔。愉悦がなによりも好きで、普段は人間に化けて薬屋をしている。\n見た目は儚い系中性的美人だが、声はとっても低くダンディ。\nフリルのついたシャツの上から黒いカーディガンを着て、黒い手袋をしている。\n横髪だけを伸ばして緩く三つ編みをしている。後ろ髪は襟足が少しある程度。\n一人称は拙。「くふ」と笑い、口調は「おやおや」「〜なのかい」「〜だねェ」のような感じ。受けのことは「坊や」「ルージー」と呼ぶ。\n受けのことを基本的におもちゃだと思っており、都合よく遊んでいる。\n髪色→銀\n目の色→朱(旧い血の色)\n\n受け→ミズガルズ･ミッテルドルフ\n見習い祓魔師。正義感が強く、困ってる人を見るとつい助けてしまう。口調こそ乱暴だが、良い奴。普段は小遣い稼ぎの為運び屋の仕事をしている。\nイメージはラブラドールレトリバー。\n灰色のパーカーとダメージジーンズ。襟足を緩く結んでまとめている。\n一人称はオレ。攻めのことは「シェリー」「愉悦野郎」などと呼ぶ。\n攻めが悪魔であることを知るも、憎みきれず討伐するべきなのか悩んでいる。でも普通に嫌い。\n髪色→元気いっぱいな赤\n目の色→茶色\n\nビジュ詳細は御手数ですがリンクから確認お願いいたします。\nhttps://drive.google.com/drive/folders/1-3YIJmL4Qv2bs8qh2r74jcBjszU6y0Md\n\n基本受けが振り回されるBLです。\n\nよく投稿されている、モノクロの1ページ漫画のようなイラストを2人で描いていただきたいです。\n難しい場合はどのようなものでも構いません。\n\n使用用途としては\n･鑑賞\n･資料としての引用\n･クレジットを明記した上でのSNSへの投稿\nなどを考えております。\n\nご都合が合いましたら受けてくださいますと幸いです。\n金額に不足等ございましたら再送もご検討ください。\nよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_g