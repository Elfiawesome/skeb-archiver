gix.net/2d747083/uploads/origins/b500046b-d99f-4242-be96-eaf69a6d5899?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa68655b353df9324cf56e56f78960b8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d747083/uploads/origins/b500046b-d99f-4242-be96-eaf69a6d5899?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9fa6b3931c85f57e0bbb63182efa003", "srcset": "https://si.imgix.net/2d747083/uploads/origins/b500046b-d99f-4242-be96-eaf69a6d5899?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9fa6b3931c85f57e0bbb63182efa003, https://si.imgix.net/2d747083/uploads/origins/b500046b-d99f-4242-be96-eaf69a6d5899?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=93cf97df1b8f0916f9d1981a1eacef51 2x, https://si.imgix.net/2d747083/uploads/origins/b500046b-d99f-4242-be96-eaf69a6d5899?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=14e6b86704b8d8775006978b841c4a6d 3x"}, "body": "396様はじめまして、瑞尾と申します。\nにじさんじのイラストが好きでフォローしていたのですが、一次創作の方に流れてきて驚きと喜びからリクエストを送信いたしました。\nこの度は当方のオリジナルキャラクターを描いていただきたいです。\n\n創作BLの2人になるので、難しい場合は遠慮なくお断りください。\n以下に詳細を記載いたします。\n\n攻め→シェリー･トイフェル\n悪魔。愉悦がなによりも好きで、普段は人間に化けて薬屋をしている。\n見た目は儚い系中性的美人だが、声はとっても低くダンディ。\nフリルのついたシャツの上から黒いカーディガンを着て、黒い手袋をしている。\n横髪だけを伸ばして緩く三つ編みをしている。後ろ髪は襟足が少しある程度。\n一人称は拙。「くふ」と笑い、口調は「おやおや」「〜なのかい」「〜だねェ」のような感じ。受けのことは「坊や」「ルージー」と呼ぶ。\n受けのことを基本的におもちゃだと思っており、都合よく遊んでいる。\n髪色→銀\n目の色→朱(旧い血の色)\n\n受け→ミズガルズ･ミッテルドルフ\n見習い祓魔師。正義感が強く、困ってる人を見るとつい助けてしまう。口調こそ乱暴だが、良い奴。普段は小遣い稼ぎの為運び屋の仕事をしている。\nイメージはラブラドールレトリバー。\n灰色のパーカーとダメージジーンズ。襟足を緩く結んでまとめている。\n一人称はオレ。攻めのことは「シェリー」「愉悦野郎」などと呼ぶ。\n攻めが悪魔であることを知るも、憎みきれず討伐するべきなのか悩んでいる。でも普通に嫌い。\n髪色→元気いっぱいな赤\n目の色→茶色\n\nビジュ詳細は御手数ですがリンクから確認お願いいたします。\nhttps://drive.google.com/drive/folders/1-3YIJmL4Qv2bs8qh2r74jcBjszU6y0Md\n\n基本受けが振り回されるBLです。\n\nよく投稿されている、モノクロの1ページ漫画のようなイラストを2人で描いていただきたいです。\n難しい場合はどのようなものでも構いません。\n\n使用用途としては\n･鑑賞\n･資料としての引用\n･クレジットを明記した上でのSNSへの投稿\nなどを考えております。\n\nご都合が合いましたら受けてくださいますと幸いです。\n金額に不足等ございましたら再送もご検討ください。\nよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 245197, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "鳩森さとこ", "screen_name": "hatosanmorisan", "avatar_url": "https://pbs.twimg.com/profile_images/1236207289595379712/_nu7yWc5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1200274986591649792/1588517370/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 788000, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "雀蜂@TRPG", "screen_name": "hornet1225_coc", "avatar_url": "https://pbs.twimg.com/profile_images/1724970232815759360/0iRqiCDN.png", "header_url": "https://pbs.twimg.com/profile_banners/1219150027710316544/1781011889/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 1533568, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "よしいづ", "screen_name": "44is3po", "avatar_url": "https://pbs.twimg.com/profile_images/1615388117514735616/5D3PGgKX.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1565584795576389632/1681920636/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": 