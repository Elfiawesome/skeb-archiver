\n･AbyssのNo.2　ゼロの右腕\n･ゼロをボス呼び  敬語有りかつ基本低姿勢\n･恋愛感情あり(初恋本命〇貞)\n･常に冷静だが､心の中では感情を爆発させるタイプ(今日も可愛い･素敵･好き等)\n･ボスから触れられたりすると顔を真っ赤にする\n\n〇希望シーン\nゼロに褒められるor頼りにされる等の事をされて内心＼( ///^^///)／ウオオオオオアアアーーーッ///！ってお祭り騒ぎ状態になっている朧のやり取りをお願いしたいです｡\n\nセリフや雰囲気､構図等は全てお任せします｡\n\n〇使用用途\n個人鑑賞\n\n金額等不足がありましたら､再送請求又はキャンセルをお願いいたします｡\n\nお忙しいところ恐縮ですが､ご検討の程よろしくお願いします｡\n\nhttps://x.com/majima_san4/status/1959202094050873694?s=46&t=5ggQqV_ECII6TATabP2B7A", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zkr_3969/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4022432, "client_id": 3514629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/416fcf4f/uploads/origins/fe679aa1-d991-4fc1-a63f-a2289e465dc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6058683878b088d4b3d49d78ef2d44ea", "srcset": "https://si.imgix.net/416fcf4f/uploads/origins/fe679aa1-d991-4fc1-a63f-a2289e465dc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6058683878b088d4b3d49d78ef2d44ea, https://si.imgix.net/416fcf4f/uploads/origins/fe679aa1-d991-4fc1-a63f-a2289e465dc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35a3a2bf2ef6fcc5559f3357603665c9 2x, https://si.imgix.net/416fcf4f/uploads/origins/fe679aa1-d991-4fc1-a63f-a2289e465dc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bc5af3d6b24a206a3894c8ae0765c4e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/416fcf4f/uploads/origins/fe679aa1-d991-4fc1-a63f-a2289e465dc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=844d821c8a8e511bd7b24defc52b8c2b", "srcset": "https://si.imgix.net/416fcf4f/uploads/origins/fe679aa1-d991-4fc1-a63f-a2289e465dc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=844d821c8a8