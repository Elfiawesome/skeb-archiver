索。另一方面，年轻人对女孩关怀备至。\n\n如果很难同时画出他们两个，我们希望您能画出其中一个，或者老师最喜欢的孩子！\n如果您能按照自己的意愿画出服装、构图、姿势等，我们将非常高兴！\n\n如果您能考虑我们的建议，我们将不胜感激。\n我们期待与您合作！\n\nhttps://drive.google.com/drive/folders/15v2WQuUH4JC4fzpCHowgxPuR2JZY4zK4?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@monogusatar/works/276", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1502952, "client_id": 2787295, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff0a5150/uploads/origins/5c7dcfc4-6b70-4901-9fa7-4b66d63c9a79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=379edcc73ad85f583f97553c52b5d255", "srcset": "https://si.imgix.net/ff0a5150/uploads/origins/5c7dcfc4-6b70-4901-9fa7-4b66d63c9a79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=379edcc73ad85f583f97553c52b5d255, https://si.imgix.net/ff0a5150/uploads/origins/5c7dcfc4-6b70-4901-9fa7-4b66d63c9a79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=421ad0ed21849ea1a5d493c11501172b 2x, https://si.imgix.net/ff0a5150/uploads/origins/5c7dcfc4-6b70-4901-9fa7-4b66d63c9a79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2f4b402921230ded43a7042f049ac46 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff0a5150/uploads/origins/5c7dcfc4-6b70-4901-9fa7-4b66d63c9a79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4ae0b11a867b2fed0b3f9d901e718b2", "srcset": "https://si.imgix.net/ff0a5150/uploads/origins/5c7dcfc4-6b70-4901-9fa7-4b66d63c9a79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4ae0b11a867b2fed0b3f9d901e718b2, https://si.imgix.net/ff0a5150/uploads/origins/5c7dcfc4-6b70-4901-9fa7-4b66d63c9a79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&