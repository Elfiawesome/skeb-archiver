下記の2シーンを描いていただきたいです。\n\n・深く腰を落としたガニ股になって尻を突き出し、両手で尻肉を広げ、肛門とマン汁の垂れた性器を見せつけているシーン。グロリアは見返りでこちら(画面側)を見つめて不敵に微笑んでいる。お尻、肛門が大きく映る構図でお願いします。\n\n・汗だく腋見せガニ股ポーズで、ヌルヌルの汗で糸を引いた腋を見せつけているシーン。\n自身の腋を舐めるように舌を出し、挑発的な表情をこちらに向けているようにお願いします。\n\n以上、よろしくお願い致します。\n\nhttps://drive.google.com/file/d/1x5ckpPsyxJw9VI7Uqyh1chVrY-CDotMU/view?usp=sharing", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 35372, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "和口", "screen_name": "wagucheen", "avatar_url": "https://pbs.twimg.com/profile_images/2296234456/83bgla7b54g9lb61grw0.jpeg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 160}, {"id": 574604, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ればすと2ndGen🔞＠サブ垢", "screen_name": "rebasuto102702", "avatar_url": "https://pbs.twimg.com/profile_images/1792546161016143872/8xcGDu6g.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1116577413163438081/1608736233/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 732178, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ぽこにゃん", "screen_name": "nekonyanng", "avatar_url": "https://pbs.twimg.com/profile_images/1256060814672322560/F8d9jiAz.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "a