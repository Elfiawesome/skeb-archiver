.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2031376672981921793%2FFvOhTP8k.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=813329e4b22c42acb078d7955e9c22d2 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2031376672981921793%2FFvOhTP8k.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f23fee2c86dc52a24d95a8c08d17fba 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/0b05c2f0-2156-4652-93da-aa505de3c1b0?response-content-disposition=inline&Expires=1784801136&Signature=WLoKbXcRpVafauobQ-VITPaLpJ2613c~fSCmHvOamDTZgY9yxHsj734rnWirkIBx5FZxEn0m~3I1mRTg0cX57S9MMo8ks8Zc8c8j7Gi57WWkIT8FmISzGk8Ywtv~21mQNVXydpB7GBc5Hb0fdsqdIxzs~ngyqQgzAQFh56AifSTuENdpaWgPXOTs9OivuT1Wdokhug-uh2mPHY3iCfFwqFfpPWomrt61eyFXdlUawIQpXbjzB0MvcjeDrjE~qepEj0RdwEwnNvdmveeQW9NycjW0Bli0jKWuXuKwmlICX81IYR8tMSxcY22ow1Nl0JVq7xUeqF2vnsMkqYw7aMoHUQ__&Key-Pair-Id=K1GS3H53SEO647", "duration": 1094, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2031376672981921793%2FFvOhTP8k.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=353971ec8330ba3250345f770c0717bc", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2031376672981921793%2FFvOhTP8k.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=353971ec8330ba3250345f770c0717bc, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2031376672981921793%2FFvOhTP8k.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6481792f7e3e19f6f0f174f0fe127958 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2031376672981921793%2FFvOhTP8k.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=be9dd79572596496be51103a8aa99fe2 3x"}, "body": "再送失礼します。\n前回、変身ヒロインのシチュボ依頼を受けてくださりありがとうございました。今回もよろしければお願いしたいと思いリクエストさせていただきました。\n\n今回も落ち込んでいる人(前回までと同一人物)を元気付け甘やかす感じでお願いします。\n\n戦闘終了後からスタート。ヒロインはその日、連戦に次ぐ連戦で長時間変身し続けていてかなりエネルギーを消耗している状態。そろそろコアも赤色に変わって点滅し始めるかもしれない程に自身のエネルギー残量が少なくなっていることに苦しみと危機感を覚えている。\n\n変身を解除する為移動中、落ち込んでいる人を発見。その人はまたしてもとても苦しそうにしていた。ヒロインはその人を助けたいと思う。しかしエネルギー残量が不安でその人を助けられるかを不安に思うが少しでも助けになればと決意。エネルギーの減少により苦しみを感じているがその人に心配をかけないようにするために隠すことにする。そのままその人の側まで行き声をかける。\n\n気丈に振る舞うがその人に疲れていそうに見えることを指摘される。ヒロインは先程まで戦闘をしていて長時間変身し続けていた為にもうエネルギーを消耗していて少ない状態であることを教える。宝石の色もいつ赤色に変わって点滅し始めるてもおかしくないことを教える。\n\nそれでもその人を助けたいことを告げ甘やかし始める。強く抱きしめる。恥ずかしなりながらも精一杯強く抱きしめながら撫でたり体をさすり続ける。時折言葉も投げかける。落ち込んでいる人の心と体を温める。甘やかす。\n\nしばらく甘やかし続けた後、ヒロインの胸元にある宝石が青から赤色に変わり点滅を始めタイムリミットが近いことを知らせる。落ち込んでいる人が宝石に触らせてほしいとお願いする。宝石やブローチは最大の弱点なので1度は断るが落ち込んでいる人のことを思い、戸惑いながらも少しだけならと許可を出す。\n\n触れられた瞬間、ヒロインに激痛がはしる。しかし苦しみを悟ら必死に我慢して宝石を触らせながら甘やかし続ける。\n\nしばらく時間が経過後、宝石を触られていることによりエネルギーの消耗が激しくなり点滅が普段より速いタイミングで加速し始め触らせるのを止めるようお願いする。実はとても苦しかったことと、もしもこのまま触られていたらエネルギーが凄い勢いで消耗してしまう為、変身が解けてしまっていたを告げ謝る。\n\nそのかわり、宝石の点滅が最高速度に速くなる、エネルギーが無くなる寸前までいっぱい抱きしめて甘やかしてあげるとヒロインが提案する。力一杯抱きしめ甘やかしながら癒す。\n\n点滅が[ピピピピピ！]と最高速度まで速まってからしばらく時間が経過したタイミングでヒロインが抱きしめるのを止める。最高速度で宝石の点滅しているところをよく見せながらこれ以上はもう本当に限界でエネルギーは0に近くいつ変身が解けてもおかしくない状況であると言うことを伝える。また癒して甘やかしてあげると約束をした上でその場を離れる。\n\n落ち込んでいる人から離れて人気(ひとけ)のない場所を探し移動を始める。しかし中々良い場所が見つからず迫るタイムリミットに焦るヒロイン。激しく点滅する宝石の点滅が更にピンチ感を強調する。いつ変身が解けてもおかしくない限界な状況の中、しばらく場所を探しようやく人目のつかなさそうな場所を発見する。そこまで移動したところで宝石から光が消えて変身が解除されてしまう。凄まじい疲労感に襲われながらも誰にも見られていないか心配し辺りを見まわし誰もいないことを知り安堵。その人の力になれたかなと思いつつ宝石を触られたことも思い出し危なかったと振り返る。\n\nというイメージです。\n\nヒロインの変身中、エネルギーの消耗が進むにつれて感じる苦しみも大きくなる。落ち込んでいる人に心配をかけない為、できる限り我慢するように努める。\n苦しみの表現が難しかったりイメージが湧かない場合は設定を変更していただいても構いません。\n\nヒロインは終始優しく落ち込んでいる人に接し癒し、励まし甘やかす。 \n\n宝石の点滅に関してはそれなりに言及してほしいです(点滅が速くなったタイミング等)  沢山癒し励まし甘やかしていただきたいです。また、ヒロインは宝石が点滅する程、ピンチになることは殆ど無く慣れていません。\n\n不都合な点やよくわからない点がある場合、内容は多少変更していただいても構いません。(例:宝石を触らせてあげるくだり。無くす場合はひたすらタイムリミットのギリギリまで癒し続けるように変更等々)\n\nよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "audio", "cr