ります\n\n依頼内容\nオールマインドが、AC4faのメルツェルが主人公たちに言った台詞\n「ORCA旅団メルツェルだ、ビックボックスへようこそ」\n「歓迎しよう、盛大にな！」をオールマインド風にアレンジ\n→\n「オールマインドは、全ての傭兵のためにあります」\n「歓迎しましょう、盛大にね！」とお祝いするイラスト\n（6月にバースデー絵として使用予定ですが、完成したイラストを先に公開しても問題ないです）\n\n詳細\nセンターでオールマインドがポーズ\n※イメージとしては、ガイナ立ち＋アルカイックスマイル（資料URLにPixiv百科事典の資料）\nですが、特に指定はなく何でもいいです\n\n台詞部分は後ろの背景に書き起こしてください\n（上下左右どこでもok）\n\nそれ以外に関しては、先生の自由にしてください\n\nhttps://dic.pixiv.net/a/%E3%82%A2%E3%83%AB%E3%82%AB%E3%82%A4%E3%83%83%E3%82%AF%E3%82%B9%E3%83%9E%E3%82%A4%E3%83%AB", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@worship_shiro/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3213412, "client_id": 1413138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d923189d/uploads/origins/5ac9dfc8-dac7-4778-a169-f63ff7e9cbe5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=902c63292f3949ba4582d44234d3e495", "srcset": "https://si.imgix.net/d923189d/uploads/origins/5ac9dfc8-dac7-4778-a169-f63ff7e9cbe5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=902c63292f3949ba4582d44234d3e495, https://si.imgix.net/d923189d/uploads/origins/5ac9dfc8-dac7-4778-a169-f63ff7e9cbe5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97c91b04a6f8c55795e1722088234289 2x, https://si.imgix.net/d923189d/uploads/origins/5ac9dfc8-dac7-4778-a169-f63ff7e9cbe5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da31f24e56e26f2d2bcb48db07659b44 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d923189d/uploads/origins/5ac9dfc8-dac7-4778-a169-f63ff7e9cbe5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=980be9d964048f021688676e65c0364c", "srcset": "https://si.imgix.net/d923189d/uploads/origins/5ac9dfc8-dac7-4778-a169-f63ff7e9cbe5?bg=%23fff&auto=format%2Ccomp