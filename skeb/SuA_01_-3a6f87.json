ideo", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1314046, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゆれ", "screen_name": "mr_ayarabbit", "avatar_url": "https://pbs.twimg.com/profile_images/1663553167748104194/ibT862Ug.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 35, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1417201, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "宮下の抜け殻", "screen_name": "s90jiIQO2xf0Fk5", "avatar_url": "https://pbs.twimg.com/profile_images/1381581757531611139/Vpv3b-En.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1381581287601831944/1700755478/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 2194438, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "🧠ﾔﾏﾔ🧠", "screen_name": "FALSOU0811", "avatar_url": "https://pbs.twimg.com/profile_images/1500461677053022208/ogBnJQu6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2545951453/1646058386/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 136}, {"id": 2419513, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "追川", "screen_name": "111333336", "avatar_url": "https://pbs.twimg.com/profile_images/1624683331970547713/Og23-Psy.jpg", "head