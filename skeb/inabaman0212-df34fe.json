とにして…一線を越えて繋がってしまう\n「ずっと私だけを見ていてくれる？」と訊ねる瑞鶴。それに応えるよう情熱的に瑞鶴を抱く男性。\n旅行が終わるも瑞鶴の心は晴れていた\n\n\n大黒湯コラボの浴衣をイメージの参考にどうぞ\nhttps://drive.google.com/file/d/19GC5Vh-FwEiTYXdLS1YjcYN3BlSTzwE4/view?usp=sharing", "nc": 48, "word_count": 10776, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@inabaman0212/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3fd0288c/uploads/origins/5d3c9d80-fd4c-407e-b3ca-8fd4c4a1f4a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d86d269c213c40c61412e5a125f830e0", "srcset": "https://si.imgix.net/3fd0288c/uploads/origins/5d3c9d80-fd4c-407e-b3ca-8fd4c4a1f4a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d86d269c213c40c61412e5a125f830e0, https://si.imgix.net/3fd0288c/uploads/origins/5d3c9d80-fd4c-407e-b3ca-8fd4c4a1f4a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e34b56c4408193a4b149f31fbf61122 2x, https://si.imgix.net/3fd0288c/uploads/origins/5d3c9d80-fd4c-407e-b3ca-8fd4c4a1f4a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bdec3b34c4f5fcdeb5c68c14552c66e3 3x"}, "private": true, "genre": "novel", "tipped": false, "creator_id": 2016067, "nc": 161}, {"path": "/@inabaman0212/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 2016067, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/882da85f/uploads/origins/4936fb67-1386-40bc-b5e0-dde304d8a7c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb6a3ec02990ccc2acbe75e5c1a6c349", "srcset": "https://si.imgix.net/882da85f/uploads/origins/4936fb67-1386-40bc-b5e0-dde304d8a7c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb6a3ec02990ccc2acbe75e5c1a6c349, https://si.imgix.net/882da85f/uploads/origins/4936fb67-1386-40bc-b5e0-dde304d8a7c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f437750b656842f00ba608e467cc6e3 2x, https://si.imgix.net/882da85f/uploads/origins/4936fb67-1386-40bc-b5e0-dde304d8a7c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a0f456384b6a3a7f3577b2c765a1bfd 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/882da85f/uploads/origins/4936fb67-1386-40bc-b5e0-dde304d8a7c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09f6502642ebf70d5932216ad544857a", "srcset": "https://si.imgix.net/882da85f/uploads/origins/4936fb67-1386-40bc-b5e0-dde304d8a7c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09f6502642ebf70d5932216ad544857a, https://si.imgix.net/882da85f/uploads/origins/4936fb67-1386-40bc-b5e0-dde304d8a7c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=921ac10a99aaaa43fa9f69201768dec2 2x, https://si.imgix.net/882da85f/uploads/origins/4936fb67-1386-40bc-b5e0-dde304d8a7c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=588554a9d1ee9b7e34635ac81f0b1809 3x"}, "body": "アズールレーンのNTRものをお願いします\n\n【キャラ】\nロイヤルメイドの誰か（ベルファスト、カリブディス、グロスター、シラ、ダイドー、シリアス辺りが好みです）で指揮官とケッコンしている\n\n民間人の男…作戦に巻き込まれて大怪我を負う。両手が骨折して使えない感じで。アズールレーン及びKANSENにはあまりいいイメージを持っていない為、少し冷たい態度。\n\n【シチュエーション】\n指揮官立案の作戦は大きな成果をもたらした影で民間人の犠牲者が居た。\n民間人の男は大怪我を負い、退院した後も日常生活が困難な状況。\n夫の責任は妻が背負うと意気込んで男の介抱をするロイヤルメイド。\n身の回りの世話は当然、性処理も嫌々することになる。\nそんな生活もしばらくすると男に情を持つようになるロイヤルメイド。男も次第に態度が柔らかくなる。\n次第にロイヤルメイドは指揮官よりも民間人の男のことばかり思うようになる。\n嫌々していた性処理もいつしか男を喜ばせるためのものに変化していた。\nそして男の怪我が完治する。ロイヤルメイドの介抱は必要ないのだが二人は離れようとしない。\n腕が自由になった男はロイヤルメイドを愛しく抱きしめながら激しく交わる。\n真のご主人様を見つけたロイヤルメイドは男と永遠の愛の契りを結ぶ。", "nc": 170, "word_count": 17397, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@inabaman0212/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 2016067, "client_id": 2158112, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f26be8a/uploads/origins/cd30c9b3-e85a-4083-b8f1-a032eaf7d520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de7aa5406cf7a549effaf97840a336c2", "srcset": "https://si.imgix.net/0f26be8a/uploads/origins/cd30c9b3-e85a-4083-b8f1-a032eaf7d520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de7aa5406cf7a549effaf97840a336c2, https://si.imgix.net/0f26be8a/uploads/origins/cd30c9b3-e85a-4083-b8f1-a032eaf7d520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b922b183fa2ad341dd7d0e1a83e52ecf 2x, https://si.imgix.net/0f26be8a/uploads/origins/cd30c9b3-e85a-4083-b8f1-a032eaf7d520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51ce5c5cf890616b6365858e09c36f00 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f26be8a/uploads/origins/cd30c9b3-e85a-4083-b8f1-a032eaf7d520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3e576dcc1999a81f4251be227a94c54", "srcset": "https://si.imgix.net/0f26be8a/uploads/origins/cd30c9b3-e85a-4083-b8f1-a032eaf7d520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3e576dcc1999a81f4251be227a94c54, https://si.imgix.net/0f26be8a/uploads/origins/cd30c9b3-e85a-4083-b8f1-a032eaf7d520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dce6a382a2e6f03644fae92fa4450082 2x, https://si.imgix.net/0f26be8a/uploads/origins/cd30c9b3-e85a-4083-b8f1-a032eaf7d520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8c92cf12f725d6292b35058d95657008 3x"}, "body": "いつもinaba先生の素敵な作品、拝見しております。\nこの度は是非書いて頂きたいシチュエーションを思いつき、\nR-18小説のご執筆をお願いしたく、リクエストさせていただきます。\n細かい所で指示の多い面倒なリクエストではありますが、\nご検討のほどよろしくお願い致します。\n\n【希望するテーマ･キャラクター】\n・『ドルフィンウェーブ』より「シュネー・ヴァイスベルグ」「永雪 氷織」\n・3Pもしくはどちらか片方で、\n　催眠によって強制的に好意を植え付けられた事で\n　竿役好みにされていく催眠モノの話をお願いしたく存じます。\n\n【概要】\n・基本的にはinaba先生にお任せします。\n　必要であれば【書いてほしいシチュエーション】の\n　順番や展開をお好きに改変･構成･カットをして頂いて構いません。\n・竿役のタイプ(特徴無し、チャラ男、おじさん等)はお任せしますが、\n　調教が終わってもマワさない方向でお願いします。\n・【書いてほしいシチュエーション】は3Pを採用された場合としています。\n　片方のみを採用される場合、内容を押さえて頂ければ\n　入れ替えたり混ぜたりして大丈夫です。\n・必要であればエレンや颯を始めとした他のキャラクターを出しても大丈夫です。\n\n【書いてほしいシチュエーション】\n・竿役の欲望を満たすために代わりに催眠の使い方を考えてくれるシュネーと\n　その実験として屈服と服従を誓う言葉を言わされたり、濃厚ベロチューをやらされる氷織\n・調教の果てに尻を撫でられただけで股を濡らすようになったシュネーと、\n　好きなように胸を揉まれるのが当たり前になった氷織\n・コスプレエッチをする事になった結果、\n　体のラインがくっきり出るような生地の薄いフレンチメイド服と\n　エロ下着を着用させられるシュネーと氷織", "nc": 169, "word_count": 23561, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@inabaman0212/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 2016067, "client_id": 971152, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/240a8100/uploads/origins/9b9fb5b3-7db1-4c03-b9d4-6a2fe1976adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ab2148b7801bd18d3ab5a7314dc8e57", "srcset": "https://si.imgix.net/240a8100/uploads/origins/9b9fb5b3-7db1-4c03-b9d4-6a2fe1976adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ab2148b7801bd18d3ab5a7314dc8e57, https://si.imgix.net/240a8100/uploads/origins/9b9fb5b3-7db1-4c03-b9d4-6a2fe1976adf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d6c4d495f2156d40e79a2530b07f750 2x, https://si.imgix.net/240a8100/uploads/origins/9b9fb5b3-7db1-4c03-b9d4-6a2fe1976adf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcff9e03392d00f4ff5560334073802c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/240a8100/uploads/origins/9b9fb5b3-7db1-4c03-b9d4-6a2fe1976adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57baa2b7dc6ee67e1513ffa1a59505b2", "srcset": "https://si.imgix.net/240a8100/uploads/origins/9b9fb5b3-7db1-4c03-b9d4-6a2fe1976adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57baa2b7dc6ee67e1513ffa1a59505b2, https://si.imgix.net/240a8100/uploads/origins/9b9fb5b3-7db1-4c03-b9d4-6a2fe1976adf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d604306e42ba630a1b3d2eaaf80ae9a 2x, https://si.imgix.net/240a8100/uploads/origins/9b9fb5b3-7db1-4c03-b9d4-6a2fe1976adf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=75e7c0e2c105dd7ba37ec2e7d0e7dfdd 3x"}, "body": "初めてのskeb依頼をさせていただきます。ル・テメレールとルピニャートとのイチャラブ3Pソーププレイをお願いします。\n\nシチュエーションとしては、ケッコンしたル・テメレールとルピニャートが出張で疲れた指揮官に出張中にこっそり練習したソーププレイで癒してあげる、という感じでお願いします。\n\n指揮官の性格は、Hの時でも相手を気遣ったり、「好きだよ」「愛してる」と囁いてあげる優しい性格で、彼女たちもそんな指揮官が好きで、一生懸命に指揮官を求めて愛し合いたい、という関係です。また、濁点喘ぎや下品な擬音は控えめでお願いします。\n\nプレイ内容で特に書いてほしいのはル・テメレールとルピニャートのダブルパイズリ、ル・テメレールの胸を揉みしだきながらの正常位、ルピニャートとの密着キスしながらの対面座位を書いてほしいです。\n\n初めて依頼文を書くので至らない部分もあるかと思いますがどうぞよろしくお願いします。", "nc": 176, "word_count": 23111, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@inabaman0212/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 2016067, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/780753a4/uploads/origins/84f639b7-559e-4aea-8bee-2a244eaf8850?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=486df4409bb235e93535f917d46459cd", "srcset": "https://si.imgix.net/780753a4/uploads/origins/84f639b7-559e-4aea-8bee-2a244eaf8850?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top