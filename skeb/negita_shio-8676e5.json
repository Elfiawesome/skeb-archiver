/www.sanrio.co.jp/characters/pompompurin/\n\n【差分】\n●①≪妖艶な微笑みを浮かべて舌ペロしている表情≫差分をお願いします。\n●②≪小悪魔な笑みを浮かべて舌ベロしている挑発的な表情≫差分をお願いします。\n●③ビキニの柄差分で≪星条旗ビキニ≫をお願いします。\n●④肌の色差分で≪こんがり黒く日焼けした肌≫をお願いいたします。\n\n♦ウマ娘は≪尻尾≫があって人耳がないことを留意して頂けたら幸いです。\n\n♦原寸大PSDデータと原寸大宛名入りpngファイル、原寸大宛名無しpngファイルで納品していただけると幸いです\n\n★♦PSDはレイヤー統合前でファイル内で差分・宛名が個別に切り替えられる形式でお願いいたします。\n\nご検討の程何卒宜しくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 11583, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "sue", "screen_name": "i_s_u_e", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fmisskey%2F7e90e86b-7b6f-48b9-9614-5d4057bbf93c.png&avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 75, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 1108536, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "なず", "screen_name": "Dz_lovew01", "avatar_url": "https://pbs.twimg.com/profile_images/1192566965233057792/2HrJOAUS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1007935325941858304/1572982512/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 1959911, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "絶望の会社辞めたいbot", "screen_name": "Patek_007", "avatar_url": "https://pbs.twimg.com/profile_images/1674590716780220416/TrCabsiC.png", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, 