 "はじめまして。\nろくろさんの描かれる、細部まで美麗でキャラの存在感のある色彩にて是非描いてほしいリクエストがあるのでお送りします！\n\n\n\n【リクエストキャラ】\n\n・バーバラ（作品名『原神』）\n\n\n\n【リクエスト詳細】\n\n・カメラ目線で上目遣い\n・デートしているシチュエーション\n・添付資料の衣装を着せて頂けたら嬉しいです。\n\n\n一人称視点の相手とデートしている設定で、詳細は全ておまかせします。\nイメージ資料を参考にして頂ければ幸いです。\n\n\n予算に合わせる形で、上記と別の内容になっても全く構いません。\n何卒よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1fztGcX4uhKJBnATEkWoldn5jKsGss6Op?usp=sharing\n\nhttps://drive.google.com/drive/folders/1fztGcX4uhKJBnATEkWoldn5jKsGss6Op?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Fluffy__Coffin/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 866046, "client_id": 1217300, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61296667/uploads/origins/736cf7eb-5b59-4b3c-afd3-d805c9fcdc00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce2309173032039fa2717d0be02475e8", "srcset": "https://si.imgix.net/61296667/uploads/origins/736cf7eb-5b59-4b3c-afd3-d805c9fcdc00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce2309173032039fa2717d0be02475e8, https://si.imgix.net/61296667/uploads/origins/736cf7eb-5b59-4b3c-afd3-d805c9fcdc00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64868a82b265c2c04d2050dca451bc7c 2x, https://si.imgix.net/61296667/uploads/origins/736cf7eb-5b59-4b3c-afd3-d805c9fcdc00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f09b4d3f871b120706c2614ab03856d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61296667/uploads/origins/736cf7eb-5b59-4b3c-afd3-d805c9fcdc00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6d8b5533ecceeeb5d3b0c90aa35134d", "srcset": "https://si.imgix.net/61296667/uploads/origins/736cf7eb-5b59-4b3c-afd3-d805c9fcdc00?bg=%23fff&auto=format%2Ccompress&fm=w