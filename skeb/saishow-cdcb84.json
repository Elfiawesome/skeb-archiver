でお見掛けし、そのまま作風に見惚れてしまいました。\n初リクエスト失礼いたします。\n\n●キャラ\n「織田信奈の野望」\n①前田犬千代　②竹中半兵衛\n\n●シチュエーション\n・布団に寝転んだ竿役（肥満&巨根）の両乳首を\n　2人が左右から舌先で舐めながらダブル手コキ（射精前）。\n・2人は嫌々奉仕している。\n　①竿役を悔しそうににらみつけながら奉仕。\n　②竿役を怯えた涙目で見ながら奉仕。\n\n●その他\n・竿役視点。\n・2人とも全裸。胸（膨らみかけ）が見える。\n　局部は見えなくてOK。見える場合は無毛。\n・擬音やセリフは不要。\n・カラーだとありがたいです。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@saishow/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1426637, "client_id": 59978, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a779c12/uploads/origins/f82a6b63-cd0e-4557-bf0f-d1078aeb5841?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e299c868cd72a0b65cdcdde52df33f5", "srcset": "https://si.imgix.net/2a779c12/uploads/origins/f82a6b63-cd0e-4557-bf0f-d1078aeb5841?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e299c868cd72a0b65cdcdde52df33f5, https://si.imgix.net/2a779c12/uploads/origins/f82a6b63-cd0e-4557-bf0f-d1078aeb5841?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=140a72f3e4bddc3c5545f2df1868e61f 2x, https://si.imgix.net/2a779c12/uploads/origins/f82a6b63-cd0e-4557-bf0f-d1078aeb5841?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b160c31bfc5c96886fb85bd764a4a2e0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a779c12/uploads/origins/f82a6b63-cd0e-4557-bf0f-d1078aeb5841?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97f43c0c76d07182a1fdf7189b5f3d0b", "srcset": "https://si.imgix.net/2a779c12/uploads/origins/f82a6b63-cd0e-4557-bf0f-d1078aeb5841?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97f43c0c76d07182a1fdf7189b5f3d0b, https://si.imgix.net/2a779c12/uploads/origins/f82a6b63-cd0e-4557-bf0f-d1078aeb5841?bg=%23fff&auto=format%2Cco