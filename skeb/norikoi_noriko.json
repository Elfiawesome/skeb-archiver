at%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80c0101bfad1f826aa30b77db586c97b", "src_set": ""}, "body": "のり恋さん、はじめまして！\nVTuberの弥勒と申します。\nのり恋さんのイラストを拝見致しまして、是非とも描いて頂きたいと思い、リクエストをさせて頂きました。\n\n【要望】\n弥勒の後ろ姿+背景を描いて頂きたいです。\n\n【使用用途】\nVTuber活動のため\n・Twitter、YouTubeのヘッダーに使用\n・配信や動画のサムネイル\n(配信は収益をオンにさせて頂きますが、数円単位の微々たる額のため商用外とみなして頂けたら幸いです)\n\n【使用用途外(やらないこと)】\n・グッズなどの商品化をはじめ、配信外でイラストを利用して収益を上げること。\n\n【イラストのイメージ】\n後ろ姿で、夜の遊園地のパレードを指揮している、みたいなイメージでお願いしたいです！\n服装は自由に変更して頂いても大丈夫です。\nその他ポーズや構図、背景の有無などはお任せしたいと思っております。\n\n【その他】\n可能であれば、キャラクターと背景を分けたPSDデータで頂けたら嬉しいです！\n\n以上になります。\nお手隙の際にご確認頂ければ幸いです。\nどうぞよろしくお願い致します！\n\n弥勒\n\nhttps://miroku-cloth.carrd.co/", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@norikoi_noriko/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 179707, "client_id": 127734, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/185796c0/uploads/origins/2c753c95-692b-4f3e-a40b-7dc412bf1eec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e8645a89e452a140e87713f4a33843a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/185796c0/uploads/origins/2c753c95-692b-4f3e-a40b-7dc412bf1eec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06b13e9c2a705955cb9b7518acdb1327", "src_set": ""}, "body": "はじめまして、のり恋さん。もしよろしければ、私のオリジナルのキャラ - 泡瀬にこを描いて頂きたいです。\n\nキャラクター資料：https://drive.google.com/drive/folders/1rae3Pc5tJkluwYq0acaQuDS1GO71AZ5F?usp=sharing\n\n======info======\nこの子にこちゃんの“普通の人間”の状態の髪はミントグリーン色です。でも、本来の「通常の姿」になると、髪は\"ボトルミク\"の水髪のような泡の髪です、ヘアテールは小さな泡を作ります。ふくらはぎ付近までの髪の長さ。髪の毛の反射は、泡のような虹色の光になります。\n\n猫耳や尻尾は、ただシャボン玉で作ったアクセサリーです。普段は猫耳も尻尾もないんです。お好みで、他の泡アクセサリーに変えたり、外したりすることができます。\n\n性格:\n内向的で優しく、物静かな性格。読書とシャボン玉と一緒にどこでも旅が好き。彼女は想像力が豊かで、読んだものにすぐ影響を受けてしまう。本の中に出てくるキャラのような自分をイメージすると、そのキャラに関連した泡のアクセサリーが体に現れる。(例: 泡の猫耳、尻尾、泡の光輪、翼、etc)\n===============\nリクエスト内容についてですが、にこちゃんや 幻想的なシャボン玉の風景を描いてください。\n\n構図やポーズ等に指定はないので、ご自由に描いください～\n服装、髪形、シャボン玉アクセサリーなどは自由に変えて大丈夫です。先生の好きなように最高に可愛く描いてい欲しいです。\n\nよろしくお願いします~", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@norikoi_noriko/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/54883668/uploads/origins/74df9128-cd45-404d-89ee-f69bce310e95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=566dd5396162b253fe773ea588f1867a", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 179707, "client_id": 987392, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@norikoi_noriko/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 179707, "client_id": 1606076, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/64910852/uploads/origins/ffcaf7af-eab8-4a75-a49c-28b335723210?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c88421dcd1abfe8fcb6fa2729a7bc99", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/64910852/uploads/origins/ffcaf7af-eab8-4a75-a49c-28b335723210?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea309f7b8b68664644ab8d730cbbac9c", "src_set": ""}, "body": "こんにちは、Vtuberのフワと申します。\nのり恋先生の絵柄めちゃめちゃユニックで、ずっと前からリクエストしたいと思っていました。\nもしよろしければ、私のキャラクターを描いていただけますでしょうか。お願いします🥺\n\nキャラクター資料：https://drive.google.com/drive/folders/1Z6j1aaygiOHJLZpekY7MPU1QOfZrbQML\n\nアヒルが卵の時に神様から天使のDNAをもらい、孵化したら半天使になった女の子です。\n今は魔法使いの仕事をやっています。周りにある小さなアヒルたちは使い魔のようなものです。\n頭上の白い絨毛は魔法の羽です。絨毛と想像力を合わせて、いろんなものが創れます。\n\n構図やポーズなどは先生にお任せします。\n元気なクリエイターさんの感覚があれば嬉しいです。\n服装、髪形などは自由に変えて大丈夫です。先生の好きなように最高に可愛く描いてい欲しいです。。\n\n動画制作、配信など、チャンネルに使えるように許可をいただけたら幸いです。\n使用される場合、Youtube概要欄、Twitterのリプ欄に著作者名などを明記します。\nアニメーションをつけ動画に作る予定があり、キャラと背景などを分けたPSDファイルの納品をただければ大変助かります。\n\nご検討のほど、よろしくお願いいたします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@norikoi_noriko/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 179707, "client_id": 2263027, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a597ca3c/uploads/origins/ed323ef0-794c-463a-90e4-0c12d2c4da55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=459034b3fd8432144003c749d033df3d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a597ca3c/uploads/origins/ed323ef0-794c-463a-90e4-0c12d2c4da55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c00641d9e0f5cef6bb10d3ab5b525f8e", "src_set": ""}, "body": "こんにちは、私の戦士の背中の絵を描いてほしいのです。彼女の写真はこちらです。https://portal.forgottenrunes.com/api/warriors/img/2782。\n\n彼女は盾を持ち、白/灰色の髪と角があり、筋肉質で健康的です。彼女は赤い戦闘用ビキニを着ていますが、もしあなたが彼女の服をストリートウェア（赤いスポーツブラとバギージーンズ）にモダンにしたいのであれば、それも良いでしょう。  あなたのTwitterアカウントでピン留めされている画像がとても好きなので、同じようなスタイルのものが欲しいです。ありがとうございました。\n\nhttps://portal.forgottenrunes.com/api/warriors/img/2782", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@norikoi_noriko/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 179707, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a3a6339/requests/231457_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c81060ad9b2997d23278560a264a8391", "src_set": ""}, "duration": null, "ns