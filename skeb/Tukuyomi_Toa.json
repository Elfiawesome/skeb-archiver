lse, "creator_id": 1902143, "client_id": 2595921, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/109a7eda/uploads/origins/b8810204-17a3-4880-aec6-31b484295439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6284ecb398c44eaca2c8c53a1c488069", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/109a7eda/uploads/origins/b8810204-17a3-4880-aec6-31b484295439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3b13e22d9b1f34bc30dcec978094bc1", "src_set": ""}, "body": "こんにちは！あなたのアートはとってもキュート！\n\nもし空きがあれば、パジャマ姿のリヴァイアサンocを描いていただけませんか？\n\n彼女は鋭い歯、青い舌、蜘蛛の巣のような手、曲線的な体型で、髪の毛は生物発光で光ります。かわいいものが大好きだけど、奇妙なもの、不気味なもの、ホラー関連のものも大好き。\n\nできれば、このポーズと同じように、鎌の上で眠っているようなポーズを描いていただけませんか？[https://www.redbubble.com/i/postcard/Sleeping-Witch-Girl-by-TorchAndBrush/17918562.V7PMD]\n\nまた、私のデザインを簡略化する必要がある場合も理解できます！\n\nSNSに掲載させていただきます。\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1fgcv7k3C2HVrLo4bvGpFq7BzYKyHby32", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tukuyomi_Toa/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1902143, "client_id": 3131300, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf923754/uploads/origins/d139888b-b16b-4dee-bc09-06f17664413a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b07b23f03a800799252dfa80895b6d99", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf923754/uploads/origins/d139888b-b16b-4dee-bc09-06f17664413a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8867804bb963dc1fd17a8c8e9c69e781", "src_set": ""}, "body": "Xに三面図ありますよ", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}