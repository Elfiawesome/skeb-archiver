8c11bca5d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=f5b07aee421b51cdd7a773307bb19636, https://si.imgix.net/bf645492/uploads/outputs/adcf6495-5681-482f-8496-2568c11bca5d?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=cdba372d05e537ec1fa78e11e5766106 2x, https://si.imgix.net/bf645492/uploads/outputs/adcf6495-5681-482f-8496-2568c11bca5d?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=63f6ded0f3ae742d0d0164e0e1846d48 3x"}, "duration": 8, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf645492/uploads/outputs/adcf6495-5681-482f-8496-2568c11bca5d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=d8382f21dce1ccff0d9e2b3dabb14185", "srcset": "https://si.imgix.net/bf645492/uploads/outputs/adcf6495-5681-482f-8496-2568c11bca5d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=d8382f21dce1ccff0d9e2b3dabb14185, https://si.imgix.net/bf645492/uploads/outputs/adcf6495-5681-482f-8496-2568c11bca5d?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d0aa1c71739686a8ec6541c2416244ce 2x, https://si.imgix.net/bf645492/uploads/outputs/adcf6495-5681-482f-8496-2568c11bca5d?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=147c604c30c6e8c77cb13258f3c2a521 3x"}, "body": "Hebonn様初めまして。XのおすすめにてHebonn様の作品を拝見し、skebを受け付けてらっしゃるのを見て依頼させていただきたく参りました。\n\n【依頼内容】\n自作のフリーゲーム『メルクリウスの種』のメインキャラ（オリジナルです）『ヴァリス』のアニメムービー\nHebonn様はカービィなどのディフォルメキャラを中心に描かれていますので、ヴァリスもミニキャラにデフォルメしてしまって大丈夫です（例えばパワプロのキャラくらいに簡略化可）。\nヴァリスは千年以上生きている、見ため少年のドラゴンの錬金術師です。\nゲームではプレイヤーを保護し、師匠として見守り導く役割になります。\nhttps://drive.google.com/drive/folders/1z0zmTki8i2izKlJLVUC-c6Qq5fSD5aJR?usp=sharing\nキャラの立ち絵のまとめをこちらからDL可能です。\n資料URLは自サイトの該当ゲームのページです。（ゲームのPVや詳細、プレイリンクなど）\n\nHebonn様の作品の中では、特に植物とキャラを一緒に書かれたもの、魔法使いの様な衣装で描かれたもの、ランタンの光で読書、花かごの中でお昼寝をしている絵などがとても可愛く、依頼を決めました。\nこういった柔らかなテイストでムービー製作は難しいかもしれませんが、出来たらこうした雰囲気だと嬉しいです。\n構図のイメージとしてはヴァリ