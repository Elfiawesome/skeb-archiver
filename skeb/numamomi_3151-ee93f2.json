dac-d573-4de6-9b49-9dba752769a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bee201b20c02fd5234c7cb4df05c9be, https://si.imgix.net/5b17ead8/uploads/origins/1d646dac-d573-4de6-9b49-9dba752769a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2646639ffc9d0bbd6c70237392caec1a 2x, https://si.imgix.net/5b17ead8/uploads/origins/1d646dac-d573-4de6-9b49-9dba752769a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d4b3522c7e1717db923069ce56e70ca 3x"}, "body": "【キャラクター】\n『めだかボックス』安心院なじみ\n\n【服装】\nクラシカルなメイド服、スカートの丈は長くコスプレみたいな感じではない本職のメイド服っぽいデザイン。\nカチューシャも付けて欲しい。\n螺旋は不要。\n\n【シチュエーション】\n普通の住宅街にて塀の壁に直立している絵。\n塀の上に立つのではなく壁面に立っている。\n重量が壁に向かっているのでスカートが真下に靡くようになっておらず\n普通にただ立っている感じ。\nなんか町並み歩いていたら出会った、という感じ。\n\n【ポーズ】\n特に指定は無いが直立してただ立っている感が欲しい。\n絵として真正面向いてて欲しい。\n\n【カメラワーク】\n住宅街歩いてたらなんか壁に立っている安心院さんがいたみたいな絵であってほしい。\n\n【背景】\n住宅街っぽければなんでもいい。\n但し他の人、車等は無し。\n電柱など住宅街にありそうなモノはあっても良い。\nゴミ捨て場は描かないでください。\n\n【イラスト使用目的】\n今描いている小説の挿し絵みたいな感じで活用したいと考えています。\n作品は資料URL参照。\n\nhttps://kakuyomu.jp/shared_drafts/GSCYImZMrJXLvgOPao0BhyYxUpn8hKUG", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@numamomi_3151/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2896170, "client_id": 456509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6965412/uploads/origins/d9fd2cb1-17aa-4be6-ad6a-4c35af7a4679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e682e1c2b4d8d0410dde330c1d68cc1", "srcset": "https://si.imgix.net/b6965412/uploads/origins/d9fd2cb1-17aa-4be6-ad6a-4c35af7a4679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e682e1c2b4d8d0410dde330c1d68cc1, https://si.imgix.net/b6965412/uploads/origins/d9fd2cb1-17aa-4be6-ad6a-4c35af7a4679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s