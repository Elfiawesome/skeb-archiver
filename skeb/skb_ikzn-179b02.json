段を選ばない一面もあります。\n父親や父に似た男性という存在、概念に執着するファザコンです。\nヤンデレというよりメンヘラです。\n\n【モチーフやイメージ、アイテムなど】\nお金、雑居ビル、都会、電灯、蛾、スミレ、薬など\n\nポーズ等はおまかせ致します。\n何か不備があればキャンセルや再送要請などお願い致します。🙇‍♂️\nもし良ければよろしくお願い致します！\n\nhttps://drive.google.com/file/d/1u10DsptpDiMrhYj7HeL8-6Gdaeuz-TlE/view?usp=drivesdk", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@skb_ikzn/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1869962, "client_id": 2770501, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ba58276/uploads/origins/89ccfcf1-81f0-47ec-9b76-86fb6b18e667?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15750807d04508735b7dca56caafa514", "srcset": "https://si.imgix.net/7ba58276/uploads/origins/89ccfcf1-81f0-47ec-9b76-86fb6b18e667?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15750807d04508735b7dca56caafa514, https://si.imgix.net/7ba58276/uploads/origins/89ccfcf1-81f0-47ec-9b76-86fb6b18e667?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f699f319123d13a4af95f2b38344123a 2x, https://si.imgix.net/7ba58276/uploads/origins/89ccfcf1-81f0-47ec-9b76-86fb6b18e667?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca0bf7b8d14c19d9a6fa3b583d591a01 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ba58276/uploads/origins/89ccfcf1-81f0-47ec-9b76-86fb6b18e667?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f988c82726845f51fe8d7879b50d0a81", "srcset": "https://si.imgix.net/7ba58276/uploads/origins/89ccfcf1-81f0-47ec-9b76-86fb6b18e667?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f988c82726845f51fe8d7879b50d0a81, https://si.imgix.net/7ba58276/uploads/origins/89ccfcf1-81f0-47ec-9b76-86fb6b18e667?bg=%23fff&auto=format%2Ccompress&fm=webp&dp