4bd133/uploads/outputs/21f03e80-c285-4070-8d96-c737c596dadc?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6840e5d70b29553eb9ce6ee795d4a84 2x, https://si.imgix.net/ef4bd133/uploads/outputs/21f03e80-c285-4070-8d96-c737c596dadc?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=5516b540dcb88a42a03065a18bcb466f 3x"}, "duration": 2, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef4bd133/uploads/outputs/21f03e80-c285-4070-8d96-c737c596dadc?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=3d55371d0d165cd523af523f60279ed8", "srcset": "https://si.imgix.net/ef4bd133/uploads/outputs/21f03e80-c285-4070-8d96-c737c596dadc?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=3d55371d0d165cd523af523f60279ed8, https://si.imgix.net/ef4bd133/uploads/outputs/21f03e80-c285-4070-8d96-c737c596dadc?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a06a897e38dfaca27c33983c48cdb4eb 2x, https://si.imgix.net/ef4bd133/uploads/outputs/21f03e80-c285-4070-8d96-c737c596dadc?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=437fa38d8edff360b6a239890a5dd7fb 3x"}, "body": "こんにちは、また時間停止ビデオをお願いします。彼は毛深く、ミディアムレングスの白髪で、濃い無精ひげを生やし、金色の目をしている。\n彼は混雑した地下鉄の車内で、筋肉質で毛深い熟年男性を見かける。そのオヤジは生姜色の短髪、緑色の目、濃い髭と口髭を蓄えている。立ったままハンドルを握り、真剣な表情で携帯電話で話している。ビジネススーツを着ていて、結婚指輪もしている。\nタイム・ストッパーは時間を止め、シャツのボタンを外し、ズボンのチャックを開け、毛深い胸筋と大きなペニスを撫でながらキスをする。彼は男を仰向けに寝かせ、両脚を広げて毛深い尻を犯し、その中に大量にクンニして、隙間なく垂れ流しにする。最後に、彼は男の顔の上で自慰し、彼の開いた口、髪、ひげを精液で覆い尽くす。", "nc": 168, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@mshk_s/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2807761, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5a319fa/uploads/origins/52a04a10-1a28-4273-918d-8a501bf95c8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cro