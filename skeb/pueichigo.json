age_urls": {"src": "https://si.imgix.net/6d152dd2/uploads/origins/dbe8d04a-880f-4a72-8d90-bb32d3463601?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63d006d6073e7279bef472012fe11c6b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d152dd2/uploads/origins/dbe8d04a-880f-4a72-8d90-bb32d3463601?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c64a6aa5d455e9d23460c3700cb2dfa5", "src_set": ""}, "body": "スタレのトリビーのエロ絵をお願いします。\n\nジャンル　純愛、穹君と一日中セックスし続けてイカされ続け気絶しても精液まみれで膣内から溢れるまで犯され続けてる\n\n男性描写については穹君と書きましたが、誰か分かるような描き方をするかはお任せします。\n\n服装は裸、体位は正常位か、表情が映る角度の寝バック、お好きな方でお任せします\n\nイラスト差分　挿入前、行為中、中出し1回目、行為中、中出し2回目、事後　希望でお願いします。\n中出し後2回目後に断面図で膣内に精液がパンパンに詰められてる表現を添えて頂けると喜びます。\n\n以上になります、全体的にふわふわしてますが、時間と気力に余裕がありそうだったらよろしくお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pueichigo/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f6485eb1/uploads/origins/8e6ea6eb-7c3f-49d3-8bc3-87fcb6e2bc90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b1235521308e7805af8ccd1454321368", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3368362, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@pueichigo/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/81429cc2/uploads/origins/0bcc7a6f-c779-42f9-ba44-5454ab7a495b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9159b65d2ee36aa3da7cdbe