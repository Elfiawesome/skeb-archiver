count": 0, "received_works": [{"path": "/@pueichigo/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3368362, "client_id": 135898, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59a2f228/uploads/origins/e9d76be6-efcd-4a6d-b5f0-4697ca1c02dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd33fa6ceda6e07e61eb6780b426b3fa", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59a2f228/uploads/origins/e9d76be6-efcd-4a6d-b5f0-4697ca1c02dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e66c36141e48b9eeadbccda1ee7d71f9", "src_set": ""}, "body": "初めまして。\n先生の絵柄が刺さりましてぜひうちの子を描いていただきたく思い、リクエストさせていただきます。\n\n■キャラクター\nオリキャラの「花村美月」\n外見・服装・ちょっとした設定は資料URL内の「オリキャラ三面図」「花村美月設定」を参照ください\n\n■シチュエーション・構図\nご主人様の私室にあるソファーでそこに腰かけている彼の膝に向かい合って座る形でディープキスをしているシチュで、その様子を三人称視点で真横から見ているような形\nご主人様のビジュアルは中肉中背の青年といった感じでお願いします\nご主人様には背中に手を回されてぎゅっと抱き寄せられており、うちの子はご主人様の首に腕を回しているキスをしている感じ\nうちの子の首輪にはリードが付けられており、ぐいっと首を引っ張れるくらいの長さまで短く巻かれたうえでご主人様がリードを握っている\n身長差の目安は資料URL内「身長差参照」のイメージで、膝に座った状態でもご主人様よりうちの子の頭の位置が低い状態でお願いしたいです（うちの子が若干上を向きながらキスをしている感じ）\n\n下記のパターンで差分を頂きたいです。\n・キスの直前のような感じで恥ずかしそうにご主人様の顔を見つめている\n・くちゅくちゅと舌を絡め合わせるようなキス\n・口同士をぴったりと重ね合わせる深いキス\n・長いキスが終わり、口を放して唾液のブリッジができている\n\n金額足りなければ再送依頼いただければと思います。\n\n是非ご検討いただけると幸いです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1MpbuQ4TLY1hENjbbqShBHkOus1duhFxN?usp=sharing", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pueichigo/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3368362, "client_id": 40712, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/816609a6/uploads/origins/37f2e76c-f7f5-478d-a8ef-2fff43bdeec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5f563d5b7da