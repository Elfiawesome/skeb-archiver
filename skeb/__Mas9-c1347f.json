、画風がとても大好きで、良ければCoCで使用しているキャラクターのイラストを描いていただきたいと思いリクエストいたしました。\n\n下記のドロップボックスに今まで使用した立ち絵の一部をまとめております。参考にしていただけると幸いです。\n（こちらは納品いただいた後閉じさせていただきます…ご了承ください）\n\n彼は黄衣の王を信仰する宗教団体の生まれで、その依代として育てられた過去があります。\nこちらは創作の設定でシナリオのネタバレ等ではない為、もし良ければイラストに反映していただけると大変嬉しいです…！\n\n依頼文章の作成が不慣れな為、不躾・不愉快な内容を送っていましたら大変申し訳ございません。もし内容が合わなければ遠慮なくキャンセルしてください！\nご検討いただけると幸いです。よろしくお願い致します！\n\nhttps://www.dropbox.com/sh/ozn4hg2lipr3txy/AAAFjcCX_jR4rRP5MJnbbNAca?dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__Mas9/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 103723, "client_id": 1477456, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9fe4a3a0/uploads/origins/073f0a55-7c9c-41dc-acb8-8ca26a2755ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9ba980d67b47de334d8eb38b629663c", "srcset": "https://si.imgix.net/9fe4a3a0/uploads/origins/073f0a55-7c9c-41dc-acb8-8ca26a2755ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9ba980d67b47de334d8eb38b629663c, https://si.imgix.net/9fe4a3a0/uploads/origins/073f0a55-7c9c-41dc-acb8-8ca26a2755ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9c3cd48fe9281855fa9e58f79ae11d5 2x, https://si.imgix.net/9fe4a3a0/uploads/origins/073f0a55-7c9c-41dc-acb8-8ca26a2755ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f6dd5e596b338c62f65b4fc87752409 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9fe4a3a0/uploads/origins/073f0a55-7c9c-41dc-acb8-8ca26a2755ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4ba372c1d3c6375c5110bae956ad34d", "srcset": "https://si.imgix.net/9fe4a3a0/uploads/origins/073f0a55-7c9c-41dc-acb8-8ca26a2755ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s