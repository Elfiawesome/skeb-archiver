23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17f899fbd15584ce2d60ec11034259cc", "srcset": "https://si.imgix.net/74fa1653/uploads/origins/9516c6f0-5752-4e5a-a0d9-b5d68193db72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17f899fbd15584ce2d60ec11034259cc, https://si.imgix.net/74fa1653/uploads/origins/9516c6f0-5752-4e5a-a0d9-b5d68193db72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0619d67dfe689be1ea46549294cc03fa 2x, https://si.imgix.net/74fa1653/uploads/origins/9516c6f0-5752-4e5a-a0d9-b5d68193db72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b587c97ad001f93720f95b065982f5c3 3x"}, "body": "けのもの様へ\n\n先日はアルフ・ライラ・ワ・ライラは語らないを回していただきありがとうございました！\n依頼を募集しているということで、HO3の自PCを単品で描いていただきたく依頼申し上げます。\nシチュエーションは特に問いませんが、目元に紅を入れてる絵などを見てみたいなと個人的に思っています。\nけのものさんの描かれる絵の表情とかかなり好きなので、顔のアップ絵とかが見れると嬉しいです。\n\n資料はURL先をご覧ください。\nよろしければお願いいたします。\n\nhttps://drive.google.com/drive/folders/1tUapW0KhLkwYCePb2NPxu1cehcjDnGJi?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__Mas9/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 103723, "client_id": 3360179, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8851ea05/uploads/origins/7ea215ba-ef57-4b52-bc34-d4ee24393659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5149f74856183208d35ed759880a8b61", "srcset": "https://si.imgix.net/8851ea05/uploads/origins/7ea215ba-ef57-4b52-bc34-d4ee24393659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5149f74856183208d35ed759880a8b61, https://si.imgix.net/8851ea05/uploads/origins/7ea215ba-ef57-4b52-bc34-d4ee24393659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66d331d0bc4af8eb9dbd6449b1b5dc17 2x, https://si.imgix.net/8851ea05/uploads/origins/7ea215ba-ef57-4b52-bc34-d4ee24393659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4579d547198c562aabed7003adf30dc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8851ea05/uploads/origins/7ea215ba-ef57-4b52-bc34-d4ee24393659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdd4b643bba08c1a07d0746b7fd7598d", "srcset": "https://si.imgix.net/8851ea05/uploads/origins/7ea215ba-ef57-4b52-bc34-d4ee24393659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdd4b643bba08c1a07d0746b7fd7598d, https://si.imgix.net/8851ea05/uploads/origins/7ea215ba-ef57-4b52-bc34-d4ee24393659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=778356d5171e04c425f034215caea582 2x, https://si.imgix.net/8851ea05/uploads/origins/7ea215ba-ef57-4b52-bc34-d4ee24393659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6412397680ee63c3223bd40c3bfd6d8 3x"}, "body": "いつも京さんの素敵なイラスト拝見しています！\n京さんのイラストのあたたかく優しい空気感や表情と、うちよそイラストの相手を想っている事が伝わる視線や触れる手のやわらかさが大好きです。\n京さんの絵柄でTRPGで使用しているPC2名のイラストが見たく、リクエスト致しました(所謂うちよそで、相手に許可は得ています)。\n『墓穴に納まる』のPCたちですが、資料にネタバレは含まれません。\n結婚しているBLCPです。\n\n▮資料\nhttps://drive.google.com/drive/folders/17jGgst4nI1lyE22sN1rdt8J8mNbSy3jX?usp=sharing\n\n▮簡単なプロフィール\nhttps://fusetter.com/tw/BmJ3hXxm\n\n▮リクエスト\nお祭りや花火大会などのイメージで浴衣の二人をお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__Mas9/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 103723, "client_id": 3342742, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/efcf5f98/uploads/origins/74067049-e852-4851-9f02-8d91a32a91d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31a825e711a4fa3e4b3ba2b85cd6e86b", "srcset": "https://si.imgix.net/efcf5f98/uploads/origins/74067049-e852-4851-9f02-8d91a32a91d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31a825e711a4fa3e4b3ba2b85cd6e86b, https://si.imgix.net/efcf5f98/uploads/origins/74067049-e852-4851-9f02-8d91a32a91d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=996736b55e9fcb7134524b2cde6a716b 2x, https://si.imgix.net/efcf5f98/uploads/origins/74067049-e852-4851-9f02-8d91a32a91d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5946298778c5a61a2e0c9100a26e2bdc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/efcf5f98/uploads/origins/74067049-e852-4851-9f02-8d91a32a91d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc4c881fe97fa15695e51b8868e6338f", "srcset": "https://si.imgix.net/efcf5f98/uploads/origins/74067049-e852-4851-9f02-8d91a32a91d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc4c881fe97fa15695e51b8868e6338f, https://si.imgix.net/efcf5f98/uploads/origins/74067049-e852-4851-9f02-8d91a32a91d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9eed6017d28a34cd62be2ab960d1e0fe 2x, https://si.imgix.net/efcf5f98/uploads/origins/74067049-e852-4851-9f02-8d91a32a91d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f2a15c1a7efb8417f16c97adc198802b 3x"}, "body": "いつもお世話になっております！\nけのものさんの画風と質感が大好きなのでご依頼できないかと機会をうかがっておりました。\nもしよければTRPGのPCをデフォルメキャラクターで描いていただけないでしょうか？\n\n資料は以下のURLになります。細部のデザインや不明な部分は省略、アレンジしていただいて問題ありません。\n構図やポージング、等身などはすべてお任せしたいと思っております。\n\n使用用途としては鑑賞目的になりますが、もし問題なければSNSのアイコンとして利用させていただきたいなと考えております。その際はプロフィール欄にけのものさんのアカウントIDなど明記いたしますが、問題がありましたらご放念ください。\nご検討よろしくおねがいします。\n\nhttps://drive.google.com/file/d/1YC_M_EhfKOO_rLxvXWmTnu9nFutbsr-d/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_sa