nail_image_urls": {"src": "https://si.imgix.net/05c39357/uploads/origins/21d1d8fe-b62d-4a2e-9c4b-1d1961c0ab8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd1ef30d803fb6b1213bb176d773a364", "srcset": "https://si.imgix.net/05c39357/uploads/origins/21d1d8fe-b62d-4a2e-9c4b-1d1961c0ab8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd1ef30d803fb6b1213bb176d773a364, https://si.imgix.net/05c39357/uploads/origins/21d1d8fe-b62d-4a2e-9c4b-1d1961c0ab8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7946b7e1f9bf1eec2037fafde78cbd9c 2x, https://si.imgix.net/05c39357/uploads/origins/21d1d8fe-b62d-4a2e-9c4b-1d1961c0ab8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b1316409ed55a51998cc60eed824d40e 3x"}, "body": "遊戯王の白銀の城のラビュリンスのダッチワイフ化をお願いします。\nイラストは変化前と変化後の2枚で、\n変化前のイラストはカードのイラストと同じポーズで「この私が統べる白銀城へようこそいらっしゃいましたわ！貴方には今から私の手掛けた罠の数々と踊って頂きますわ！！｣とドヤ顔高笑いをしているコマと、\n罠カード【状態変化 : ダッチワイフ化】を発動されるコマ（カードのデザインはお任せします）、\nラビュリンスが「ほぇ？」っという間抜けなセリフとポカンとした表情のままカードが放つ光に飲み込まれるコマ\n以上の3コマほどでお願いします。\n\n変化後イラストはこちらの作品【https://www.pixiv.net/artworks/116007970】\nのような口を開いた笑顔でバンザイする間抜けなポーズで風船のオモチャになった武器のハルバードと一緒に床に仰向けに転がっている感じでお願いします。\n\nダッチワイフのデザインは\n資料の作品のように大きめのおっぱい\n衣装はダッチワイフの表面に簡略化してプリント（おっぱいだけ丸出し）\n下のオナホ部分はペラペラのビニールになったスカートで隠す（スカートはモザイク対策なので、可能であれば下にオナホがあるように見える表現でお願いします）\nよろしくお願いします。\n\nhttps://www.pixiv.net/artworks/116007970", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aopen0414/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/788f0858/uploads/origins/8979f0b2-19c2-4614-8d84-a8e274584acb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0860ca132bfb89aabf5f450bd9a2d703", "srcset": "https://si.imgix.net/788f0858/uploads/origins/8979f0b2-19c2-4614-8d84-a8e274584acb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0860ca132bfb89aabf5f450bd9a2d703, https://si.imgix.net/788f0858/uploads/origins/8979f0b2-19c2-4614-8d84-a8e274584acb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32d3995df01c9b300fbc77b915890bca 2x, https://si.imgix.net/788f0858/uploads/origins/8979f0b2-19c2-4614-8d84-a8e274584acb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03e2441d88fce2a60f2f168bc0cd14f9 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3004966, "client_id": 1667125, "nc": 162}, {"path": "/@aopen0414/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3004966, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/85625063/uploads/origins/cb37d561-2cf7-4a60-adb3-792fcbf4979f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40c419d9bb256b22800c93d668f577e0", "srcset": "https://si.imgix.net/85625063/uploads/origins/cb37d561-2cf7-4a60-adb3-792fcbf4979f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40c419d9bb256b22800c93d668f577e0, https://si.imgix.net/85625063/uploads/origins/cb37d561-2cf7-4a60-adb3-792fcbf4979f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0fb31468549420c3c4353ee1d534936 2x, https://si.imgix.net/85625063/uploads/origins/cb37d561-2cf7-4a60-adb3-792fcbf4979f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2340b1afc1eaf5b9aed2ab2b1fb2698a 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/85625063/uploads/origins/cb37d561-2cf7-4a60-adb3-792fcbf4979f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86af66491bc41fac4b980ce690113ff5", "srcset": "https://si.imgix.net/85625063/uploads/origins/cb37d561-2cf7-4a60-adb3-792fcbf4979f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86af66491bc41fac4b980ce690113ff5, https://si.imgix.net/85625063/uploads/origins/cb37d561-2cf7-4a60-adb3-792fcbf4979f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7862b43d445f409547bfd054934ddd9e 2x, https://si.imgix.net/85625063/uploads/origins/cb37d561-2cf7-4a60-adb3-792fcbf4979f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8da006d345c1e5280324ca9c9e47bd8c 3x"}, "body": "前回のタイマニンムラサキちゃんのダッチワイフ化イラストがとても良かったので、今回はウチの子の女騎士スティレットのダッチワイフ化即落ち二コマイラストをお願いします！\n参考資料【https://twitter.com/draw_swindler/status/1697432691006910685?t=Wk1CYYUwUMkj7Dqr4EzIFg&s=19】\n1枚目のシチュエーションは気がついたら固ロシアムへと迷い込んでいたスティレットだが、\n「ここがどこかはわかりませんが、闘技場のようですし私が勝ち続ければいずれ外へと出れるはずですわ！」\nと自信満々なドヤ顔で剣と盾を構えるポーズをとった後になるべくカッコ良く相手に攻撃を仕掛ける（即落ち二コマの無様さを存分に発揮するため）\n\nしかし2枚目で前回の依頼のタイマニンムラサキと同じデフォルメ顔のダッチワイフにされて呆気なく敗北する感じでお願いします（また、ダッチワイフのオナホ部分に変化前のスティレットの胸から上がプリントされたブロマイドを置いてモザイクをかけなくても大丈夫な様にして欲しいです）\n─ダッチワイフのデザイン─\n・顔は口をポカンと開いていて、頬には薄いピンク色の楕円形で頬を染めているような表現をした少しアホの子っぽい感じの笑顔がプリントされている\n・ダッチワイフの体の表面には簡略化されたスティレットの衣装がプリントされたシンプルな形状の安物ダッチワイフで、おっぱいとオナホまんこの部分だけ衣装柄プリントではなく丸出しになってる感じのとても恥ずかしいデザイン\n（スカートや腰周りの鎧等はペラペラのビニールになってる感じに）\n・本人が使っている剣と盾は風船のオモチャに変えられてダッチワイフになったスティレットの周りに散らばっている\n・おっぱいはビーチボールのようにまんまるで大きめに\n\nこんな感じでお願いします。\n\nhttps://twitter.com/draw_swindler/status/1697432691006910685?t=Wk1CYYUwUMkj7Dqr4EzIFg&s=19", "nc": 163, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 67014, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "成歩堂空壱🔞", "screen_name": "skymidaisuki", "avatar_url": "https://