-4bd6-8a1d-900fc434b18b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7c139bb32cdc06cd04cf3ccea39afbd", "srcset": "https://si.imgix.net/59220eb2/uploads/origins/3563f4aa-b216-4bd6-8a1d-900fc434b18b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7c139bb32cdc06cd04cf3ccea39afbd, https://si.imgix.net/59220eb2/uploads/origins/3563f4aa-b216-4bd6-8a1d-900fc434b18b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00e42fc187422b0f98637516957110e0 2x, https://si.imgix.net/59220eb2/uploads/origins/3563f4aa-b216-4bd6-8a1d-900fc434b18b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3924f516319310ed922f1bc574c77b8 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59220eb2/uploads/origins/3563f4aa-b216-4bd6-8a1d-900fc434b18b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d159e8668023b1a0961c15fd0cf4956", "srcset": "https://si.imgix.net/59220eb2/uploads/origins/3563f4aa-b216-4bd6-8a1d-900fc434b18b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d159e8668023b1a0961c15fd0cf4956, https://si.imgix.net/59220eb2/uploads/origins/3563f4aa-b216-4bd6-8a1d-900fc434b18b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b2c09e9ba776ddfe804751649c3903a7 2x, https://si.imgix.net/59220eb2/uploads/origins/3563f4aa-b216-4bd6-8a1d-900fc434b18b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f542b09b6c8dbc4ac3217c1cd09e2b8f 3x"}, "body": "初めまして。\nいつもお世話になっております。\nこの度、リクエストをお送り致します。\n\nキャラクターはトパーズ高校ペト部の阿奈谷いちずと覇畿央まといと壱富士にたか\n\nシチュエーションは上半身だけが埴輪化(意識があって視えている状態)されるというものです。\n\n状況はトパーズ高校の運動会の競争で司会者が3人を突然呼んで全裸にし、いちずとまといを突然、上半身だけ埴輪化され、戸惑い、焦ります。それに対してにたかが怒り開眼しながら、「こんな事をしてただで済むと思ってー」と言っている間に上半身だけ埴輪化されます。ルールはその状態で制限時間内に校舎を一周したら、解除できるが、3人とも一周できず、しばらくの間、全裸で上半身だけが埴輪の状態でひとりが世話をしたり、学校でその姿で過ごすというシチュエーションでお願い致します。\n\nできればでありますが、セリフがありますと幸いです。\n\n特殊な内容ですが、よろしくお願い致します。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aopen0414/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3004966, "client_id": 79896, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b694dd23/uploads/origins/c85ca28f-6068-47bc-8aea-71fec4ae38da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78ea6a7e1cecf6b79d25d1d619d11a91", "srcset": "https://si.imgix.net/b694dd23/uploads/origins/c85ca28f-6068-47bc-8aea-71fec4ae38da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78ea6a7e1cecf6b79d25d1d619d11a91, https://si.imgix.net/b694dd23/uploads/origins/c85ca28f-6068-47bc-8aea-71fec4ae38da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5ec9d9853e8298e5e2e5706e94dcac9 2x, https://si.imgix.net/b694dd23/uploads/origins/c85ca28f-6068-47bc-8aea-71fec4ae38da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91a5e690885c013d0fe6cb722106e6c3 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b694dd23/uploads/origins/c85ca28f-6068-47bc-8aea-71fec4ae38da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64be21fd850f92ab9b4bdf1b692c82d2", "srcset": "https://si.imgix.net/b694dd23/uploads/origins/c85ca28f-6068-47bc-8aea-71fec4ae38da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64be21fd850f92ab9b4bdf1b692c82d2, https://si.imgix.net/b694dd23/uploads/origins/c85ca28f-6068-47bc-8aea-71fec4ae38da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c87d8bfddc983404735c754d5480fabe 2x, https://si.imgix.net/b694dd23/uploads/origins/c85ca28f-6068-47bc-8aea-71fec4ae38da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=07660807ed377866ad61709bd8e67b74 3x"}, "body": "ユニコーンオーバーロードに登場する\n「ミリアム」と「キトラ」での石化絵を２枚依頼します\n\n①石化したキトラに水をかけて綺麗にするミリアム\n\n②石化したミリアムを磨いて泡まみれにするキトラ\n\nたぶんゲームの時代的にシャワーや\nスポンジはないと思われるので、\n桶とタオルとかになると思います\n洗っている場所はどちらも風呂場で、\n石化側、洗う側は両者全裸\n\nどちらも、洗う側は一生懸命ながら\n相手の裸に少なからずドキドキしてる様子\n石化側は驚いて口を開けた様子\n\n乳は、ミリアムは盛って巨乳に\nキトラは見たままくらいでお願いします！\n\nhttps://twitter.com/Hizanoura219/status/1776242870917423553", "nc": 178, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aopen0414/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3004966, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0bb0093/uploads/origins/bbda6c6d-1f29-45fd-ab1d-305c269aa8ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c01c1cf8dc00f2aeb338a0c29704ccfc", "srcset": "https://si.imgix.net/c0bb0093/uploads/origins/bbda6c6d-1f29-45fd-ab1d-305c269aa8ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c01c1cf8dc00f2aeb338a0c29704ccfc, https://si.imgix.net/c0bb0093/uploads/origins/bbda6c6d-1f29-45fd-ab1d-305c269aa8ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fadaedcc1cdc9c825c0d32c19d263bdf 2x, https://si.imgix.net/c0bb0093/uploads/origins/bbda6c6d-1f29-45fd-ab1d-305c269aa8ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=809471a4cfb247f6054862929921880c 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c0bb0093/uploads/origins/bbda6c6d-1f29-45fd-ab1d-305c269aa8ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba1819910827388f2d7367d8d2984713", "srcset": "https://si.imgix.net/c0bb0093/uploads/origins/bbda6c6d-1f29-45fd-ab1d-305c269aa8ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&