s so that we can see their ears and hair.\n\nThank you in advance for your consideration.\n\nhttps://lit.link/tokunei_m\n\nhttps://lit.link/tokunei_m", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1335654, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "じゃこ", "screen_name": "jk_d_s_", "avatar_url": "https://pbs.twimg.com/profile_images/1800908869146939392/uevhpN9z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1368279039354437634/1718176471/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 0}, {"id": 2338699, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "774@原稿", "screen_name": "__nanashixxx", "avatar_url": "https://pbs.twimg.com/profile_images/1695360833088548864/ESG5DdUu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1466327936974598144/1685368794/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2491948, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "如月唯一", "screen_name": "SHINJAOJAO", "avatar_url": "https://pbs.twimg.com/profile_images/1914268715807657984/DbGxVAiX.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1551488744909570048/1720229364/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 0}, {"id": 3128982, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "po", "screen_name": "__