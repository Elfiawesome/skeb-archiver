て寄りかかってるような感じ、膝抱えて体育座りみたいな感じら辺とかが薫っぽいかな？と勝手に想像してます\n\n背景もお願いして大丈夫なら明かりをちょっと感じるような窓際にいるような感じが良いなって思います\n\n人生初skebなのでどこまで指示をして大丈夫なのかよくわかってなく思いついた事を全部言ってみたので細かく聞かずに自由にして頂いて大丈夫です\n忙しいなかお願いしてしまいますがご都合よろしければぜひよろしくお願いします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@j_tsu3ki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3018253, "client_id": 2119288, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5b21b17/uploads/origins/b5ccf49c-8c4e-40f3-bd0d-9e830bab5d7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ebefd1d9177f800a0d25b2bd5e66b7b", "srcset": "https://si.imgix.net/b5b21b17/uploads/origins/b5ccf49c-8c4e-40f3-bd0d-9e830bab5d7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ebefd1d9177f800a0d25b2bd5e66b7b, https://si.imgix.net/b5b21b17/uploads/origins/b5ccf49c-8c4e-40f3-bd0d-9e830bab5d7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2129f3c5f4af4448a7729ce66545768e 2x, https://si.imgix.net/b5b21b17/uploads/origins/b5ccf49c-8c4e-40f3-bd0d-9e830bab5d7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45dd49d3a7f17f0e8010b0a579178dd1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5b21b17/uploads/origins/b5ccf49c-8c4e-40f3-bd0d-9e830bab5d7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da580949b3386b0198556a939873eb6c", "srcset": "https://si.imgix.net/b5b21b17/uploads/origins/b5ccf49c-8c4e-40f3-bd0d-9e830bab5d7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da580949b3386b0198556a939873eb6c, https://si.imgix.net/b5b21b17/uploads/origins/b5ccf49c-8c4e-40f3-bd0d-9e830bab5d7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2557a8ae1a52cb