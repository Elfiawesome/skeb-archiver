クシズ・オフェルド\nまっすぐで温厚な性格。穏やかに笑っていることが多い。人や風景など様々なものを美しいと感じる感性を持つが、その対象に自分自身が含まれることは無い。\n色の目立つ瞳をしているが、それをコンプレックスに感じており、伏せがちな目元が特徴。\n💚のことが好きで、綺麗だと思っている。そのため💚が美しいと呼ぶものなら、自分の瞳も好きになれる日が来るかもしれないと感じている。動物に例えるとうさぎ。\n\n 〈キャラクター詳細〉\n・お互いにお互いの目の色のピアスを付けています！\n・割と距離感バグを起こしています。\n\n金額など不足ありましたら再送いただけますと幸いです。\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1fUK9RmmVLXpQTwkWcjl3xt4vXkdNfkIq/view?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hitonatsu_172/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3884722, "client_id": 3879149, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96b7e465/uploads/origins/48d541f7-b575-4934-8d3b-db528f49f013?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b721bf9dda67952f87db4787c55bfe81", "srcset": "https://si.imgix.net/96b7e465/uploads/origins/48d541f7-b575-4934-8d3b-db528f49f013?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b721bf9dda67952f87db4787c55bfe81, https://si.imgix.net/96b7e465/uploads/origins/48d541f7-b575-4934-8d3b-db528f49f013?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8722f9285de407645c8b396f9222fc17 2x, https://si.imgix.net/96b7e465/uploads/origins/48d541f7-b575-4934-8d3b-db528f49f013?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a77682b9471db5c647d6446794e28b66 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96b7e465/uploads/origins/48d541f7-b575-4934-8d3b-db528f49f013?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0123739e9ed3dd8cebc6a3b6e63ca4f", "srcset": "https://si.imgix.net/96b7e465/uploads/origins/48d541f7-b575-4934-8d3b-db528f49f013?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0123739e9ed3dd8cebc6a