=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dbae8d0edc0dccc34584cea6b605ad4f 2x, https://si.imgix.net/393c3150/uploads/origins/06deaa72-d70b-4cd7-9f20-d1c21924392f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99a9ed2e9982155790568d503a2091e8 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1947077, "client_id": 2574338, "nc": 32}, {"path": "/@hamachi_sukebe/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1947077, "client_id": 2727316, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91c9da3a/uploads/origins/b527546c-5114-47d6-8d77-6357288fe55d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f7a607c95f8de46699dc4d63770504c", "srcset": "https://si.imgix.net/91c9da3a/uploads/origins/b527546c-5114-47d6-8d77-6357288fe55d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f7a607c95f8de46699dc4d63770504c, https://si.imgix.net/91c9da3a/uploads/origins/b527546c-5114-47d6-8d77-6357288fe55d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07b98bc83cb081db4be465ea9ca2f7c6 2x, https://si.imgix.net/91c9da3a/uploads/origins/b527546c-5114-47d6-8d77-6357288fe55d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a79b1f21d548f991dd777284bf1d9b99 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91c9da3a/uploads/origins/b527546c-5114-47d6-8d77-6357288fe55d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ad48c984c1b225601262628debb752d", "srcset": "https://si.imgix.net/91c9da3a/uploads/origins/b527546c-5114-47d6-8d77-6357288fe55d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ad48c984c1b225601262628debb752d, https://si.imgix.net/91c9da3a/uploads/origins/b527546c-5114-47d6-8d77-6357288fe55d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5ce5390431ed685581f526dcbe8fa8bd 2x, https://si.imgix.net/91c9da3a/uploads/origins/b527546c-5114-47d6-8d77-6357288fe55d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=32ba34a94167c7f0db2097c8d63ea0d3 3x"}, "body": "こんにちは！MaGyと申します。\n作品を拝見して、先生の作風に惚れてしまいました…！自分では描けないような鬼畜極まる強制絶頂モノが、ぜひうちの子でも見てみたくなってしまいまして…！というわけで今回は、うちの子のリクエストをお願いしたいです！\n\n【キャラクター】\n　ルビちゃん（設定画を添付します。）\n\n【キャラクターの特徴】\n・ですます口調で話す子です。\n\n・マイペースでちょっぴりダウナー、健気で可愛らしい、普段はそんな子です。\n\n・でも実は結構なムッツリです、えっちになると相手を煽ってはその様子をニヤニヤと眺めるドSっ子になります。根っからエロを楽しむような、かなり魔性の女。\n\n・ですが今回は、そんな彼女に超苛烈な責めをして、その余裕を無くしていただきたいのです…！\n\n【シチュエーション・構図】\n・拘束され、長時間の寸止めや焦らしを繰り返してから、強烈な連続強制絶頂…という流れが見たいです！\n\n・焦らし方も責め方も先生にお任せします！思いつく限り、何をしちゃっても大丈夫です...！個人的にはグロテスクな形のディルドやら触手やらをねじ込むみたいなのが見てみたいかもです…もちろんそれ以外も併用していただいて結構です！\n\n・余裕綽々に「物好きですね…♡」なんて煽るような様子が、たーーっぷり焦らされて辛抱できなくなって叫び始めて、そして連続絶頂が始まったら、突き刺すような快楽によがり歪み狂い、大きく何度も絶頂して、終わらない快感の恐怖に襲われながらも、下品に喘ぎ散らかして、激しく潮吹きを繰り返して…\n\n・そして、ここが特に見たいのですが…放心した体が勝手に放尿失禁してしまうのを、薄れゆく意識で「み…ないで……くださいぃ…」と、恥ずかしがりながらも懇願する姿を見たいです...！彼女は実は恥ずかしがり屋なところがあるので…！\n\n・とにかく鬼畜に、徹底的にわからせてあげてください♡\n\n【その他】\n・責め立てる側の男モブのセリフはナシでお願いします、描く範囲も手や指先程度に収めてほしいです。\n\n・資料をGoogle Driveに入れておきます！\n\n・描いていただけたらとても嬉しいです…！\n\nhttps://drive.google.com/drive/folders/1vcan38n5uio_SCXWXXzhkqiN-jF0QpwR", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamachi_sukebe/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1947077, "client_id": 1296690, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f68adb89/uploads/origins/b55f44f3-a35a-47ca-8289-08dae587e075?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7735078e64296ee52171a58