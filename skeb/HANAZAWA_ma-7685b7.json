して梵天を持っている構図でお願い致します。\nポーズ等は、はなざわ様にお任せしたいです。\n\nキャラクターデザインの三面図については、Twitterに常に固定ツイートにしているためご覧頂けますと幸いです。\n\n▽今の固定ツイート\nhttps://twitter.com/naco_mochizuki/status/1559007944238239744?s=21&t=NEeHvnNqdWkMPPe-FagWrA\n\nお忙しいところ大変恐縮ですがご検討頂けますと幸いです。よろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@HANAZAWA_ma/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1164130, "client_id": 1694020, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb315a84/uploads/origins/f38c54aa-a106-4df7-b057-0bbeb4fd8813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67143f1f23a14145a94cd1b109244207", "srcset": "https://si.imgix.net/bb315a84/uploads/origins/f38c54aa-a106-4df7-b057-0bbeb4fd8813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67143f1f23a14145a94cd1b109244207, https://si.imgix.net/bb315a84/uploads/origins/f38c54aa-a106-4df7-b057-0bbeb4fd8813?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=901f1dbea0e6cd2d1c404f6ca5e49e0b 2x, https://si.imgix.net/bb315a84/uploads/origins/f38c54aa-a106-4df7-b057-0bbeb4fd8813?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=446696ff1c8306c6ec089a783df5c1c1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb315a84/uploads/origins/f38c54aa-a106-4df7-b057-0bbeb4fd8813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b96a79c6a18f9303b177fd1bd91baaa1", "srcset": "https://si.imgix.net/bb315a84/uploads/origins/f38c54aa-a106-4df7-b057-0bbeb4fd8813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b96a79c6a18f9303b177fd1bd91baaa1, https://si.imgix.net/bb315a84/uploads/origins/f38c54aa-a106-4df7-b057-0bbeb4fd8813?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&c