ress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22a3ba94c6683ca6f7801fd778b4521c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a0adac4/uploads/origins/d9066bd0-339a-41cb-95b2-472fb46a1b23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f301aea7b3aecdc6fa45f95b4bbb2ebd", "srcset": "https://si.imgix.net/5a0adac4/uploads/origins/d9066bd0-339a-41cb-95b2-472fb46a1b23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f301aea7b3aecdc6fa45f95b4bbb2ebd, https://si.imgix.net/5a0adac4/uploads/origins/d9066bd0-339a-41cb-95b2-472fb46a1b23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a9ad8deb943b99a2deb1eeb639f3e942 2x, https://si.imgix.net/5a0adac4/uploads/origins/d9066bd0-339a-41cb-95b2-472fb46a1b23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=acb94c3a54a6b72799994d22897b0065 3x"}, "body": "あけみ様、はじめまして。\nリクエストなのですがデルタルーンに登場するノエルと\nうちのTSふたなり狐娘のエッチなイラストをお願いしたいです。\nシチュエーションはあけみ様におまかせしますので\n可能でしたら台詞も入れてもらえると幸いです。\nキャラクターの雰囲気は資料のほうからご確認をよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1MI6f2UdpjJG3qUvu-D81jld7w3Ky4RIK?usp=sharing", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mikeshaashaa/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3693151, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c707daa/uploads/origins/d1f6d96b-4fb9-4ede-a95f-1c40c69b91d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97b74939aaa91623ec3a03989eac5c09", "srcset": "https://si.imgix.net/1c707daa/uploads/origins/d1f6d96b-4fb9-4ede-a95f-1c40c69b91d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97b74939aaa91623ec3a03989eac5c09, https://si.imgix.net/1c707daa/uploads/origins/d1f6d96b-4fb9-4ede-a95f-1c40c69b91d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00ab932c2b184b260d846967f608bcd2 2x, https://si.imgix.net/1c707daa/uploads/origins/d1f6d96b-4fb9-4ede-a95f-1c40c69b91d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=396551ed2cb516bd1cd393735ffcacb3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c707daa/uploads/origins/d1f6d96b-4fb9-4ede-a95f-1c40c69b91d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9263a8999b6ed1e609d004e30a19d02a", "srcset": "https://si.imgix.net/1c707daa/uploads/origins/d1f6d96b-4fb9-4ede-a95f-1c40c69b91d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9263a8999b6ed1e609d004e30a19d02a, https://si.imgix.net/1c707daa/uploads/origins/d1f6d96b-4fb9-4ede-a95f-1c40c69b91d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e230b273968f7d69cd1ef0ef759622ec 2x, https://si.imgix.net/1c707daa/uploads/origins/d1f6d96b-4fb9-4ede-a95f-1c40c69b91d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d2f365937e0c4e2eeda73fe91a22e03 3x"}, "body": "先生、こんにちは\n\n私のキツネ娘2人による、エロティックなレズビアンバトル／キャットファイトのアートを依頼したいです。\n\n「ハナ」＆「ツキ」：https://catbox.moe/c/p4u8ae\n\n「ハナ」（ピンクのキツネ）：彼女は色っぽく、ライバルをからかうのが好きですが、逆にからかわれると攻撃的になります。 彼女は非常にプライドが高く、負けるのが大嫌いです。\n\n「ツキ」（青い狐）：相手をからかったり侮辱したりするのが好きですが、逆に侮辱されると動揺してしまいます。彼女は傲慢で、負けるのが大嫌いです。\n\n二人はライバル関係にある神社の巫女で、相手が反撃できなくなるまで無理やり絶頂に追い込むことを主眼とした対立関係にあります。\n\nバトルはできるだけエロティックに描いてください。女の子たちを辱めたり、ポーズやアクションを荒々しくしても構いません！お尻への攻撃がお好きのようですね、ぜひそこに焦点を当ててください！\n\n衣装の組み合わせ（セクシーなランジェリー、コスプレ、あるいは全裸でもOK）、構図、そして勝者については、あなたの裁量にお任せします！ダブルKOや互角の引き分けもOKです！", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mikeshaashaa/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/825eb3fc/uploads/origi