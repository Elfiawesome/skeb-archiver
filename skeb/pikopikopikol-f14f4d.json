量のグッズ、ネットプリント等に使用させていただく可能性があります。\n\nご検討いただけましたら幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10GzEeaOdgjLiu61uT0nkhH76aNCl6M7r", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pikopikopikol/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 741119, "client_id": 2102744, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4e25d52/uploads/origins/71fb5c0f-13bd-474e-b238-2adeaf99f80c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4faf7ea30a674e71886db323846e99e", "srcset": "https://si.imgix.net/a4e25d52/uploads/origins/71fb5c0f-13bd-474e-b238-2adeaf99f80c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4faf7ea30a674e71886db323846e99e, https://si.imgix.net/a4e25d52/uploads/origins/71fb5c0f-13bd-474e-b238-2adeaf99f80c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=380feddc1f294c48f8c09f9ebdf6dfe9 2x, https://si.imgix.net/a4e25d52/uploads/origins/71fb5c0f-13bd-474e-b238-2adeaf99f80c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33420264435d577b035e68cc1447e0ac 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4e25d52/uploads/origins/71fb5c0f-13bd-474e-b238-2adeaf99f80c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd2ab6c62a2661e431a48f98e5a64cd2", "srcset": "https://si.imgix.net/a4e25d52/uploads/origins/71fb5c0f-13bd-474e-b238-2adeaf99f80c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd2ab6c62a2661e431a48f98e5a64cd2, https://si.imgix.net/a4e25d52/uploads/origins/71fb5c0f-13bd-474e-b238-2adeaf99f80c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d2419de083dc35abfd3358c1d22c4dc4 2x, https://si.imgix.net/a4e25d52/uploads