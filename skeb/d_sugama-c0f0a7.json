ame_genre": false}, {"path": "/@d_sugama/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1466566, "client_id": 141536, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c30f3e9/uploads/origins/db574439-43a4-4209-bab8-04d8769c02e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f667593844d90ea7188e9f3def5e772", "srcset": "https://si.imgix.net/3c30f3e9/uploads/origins/db574439-43a4-4209-bab8-04d8769c02e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f667593844d90ea7188e9f3def5e772, https://si.imgix.net/3c30f3e9/uploads/origins/db574439-43a4-4209-bab8-04d8769c02e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40dbcb40b256fb51c01ebccf74486915 2x, https://si.imgix.net/3c30f3e9/uploads/origins/db574439-43a4-4209-bab8-04d8769c02e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90a626e7132efaab5006347fb04b04ae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c30f3e9/uploads/origins/db574439-43a4-4209-bab8-04d8769c02e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=401d8980eee2342e35aff6d6701e781f", "srcset": "https://si.imgix.net/3c30f3e9/uploads/origins/db574439-43a4-4209-bab8-04d8769c02e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=401d8980eee2342e35aff6d6701e781f, https://si.imgix.net/3c30f3e9/uploads/origins/db574439-43a4-4209-bab8-04d8769c02e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=507f368b29858d5bd10df35f66a5cdf0 2x, https://si.imgix.net/3c30f3e9/uploads/origins/db574439-43a4-4209-bab8-04d8769c02e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ecea52ac40b78bae42690459660f1642 3x"}, "body": "お世話になっております。\n今回もスガマ様にイラストの依頼をさせていただきます！\n\n【書いて欲しいイラスト】\n筐体の周りにいる格ゲーキャラ達\n\n【イラストのイメージ】\n筐体に座っているアンヘル(KOF15)とジュリ(スト5)。\nアンヘル側が勝ち、マリーローズ(DOA6)とストライカー(DNF Duel)の3人で喜んでいる。\nジュリ側は負けで、ジュリがアンヘルに文句を言っていて、\n後ろでリリ(鉄拳7)と梅喧(GGST)が呆れてるという感じ。\nイメージとしては上記となります！\n※アンヘルとジュリがメインですので、あとはスガマ氏の好みにお任せいたします！\n\n【使用用途】\n配信終了時に表示するサムネイルに使うので、\nイラストのどこかに”ご視聴ありがとうございました～”の\n表記が欲しいです！\n※ごしあり！など表記はスガマ様にお任せいたします。\n・1920×1080サイズ\n・GIF、JPG、PNGファイルのいずれかを希望です。\n\n【描いて欲しいキャラ】\n・ストリートファイター5\n→ジュリ\n・KOF15\n→アンヘル\n・GGST\n→梅喧\n・DOA6\n→マリーローズ\n・鉄拳7\n→リリ\n・DNF Duel\n→ストライカー\n\n【参考資料】\n・https://pbs.twimg.com/media/FGhKCAKUUAE80B0?format=jpg&name=4096x4096\n・https://pbs.twimg.com/media/FGhLFgQVUAAQvxx?format=jpg&name=900x900\n・https://pbs.twimg.com/media/FGhK3PJVEAAM7st?format=jpg&name=900x900\n・https://pbs.twimg.com/media/FGhKwR9VcAEnjJs?format=jpg&name=900x900\n\n以上です！\nキャラが多く大変かと存じますが、ご検討のほどよろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@d_sugama/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1466566, "client_id": 613044, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d43ac231/uploads/origins/2ba461d6-1e54-430c-b986-53e4bc681521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68a3c3be56be2d1e59e902a2eae976f6", "srcset": "https://si.imgix.net/d43ac231/uploads/origins/2ba461d6-1e54-430c-b986-53e4bc681521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68a3c3be56be2d1e59e902a2eae976f6, https://si.imgix.net/d43ac231/uploads/origins/2ba461d6-1e54-430c-b986-53e4bc681521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7e1a090211f5995a2e1af68ea3684fe 2x, https://si.imgix.net/d43ac231/uploads/origins/2ba461d6-1e54-430c-b986-53e4bc681521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c0a52180e77ec420b6a6c1c42676ae9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumb