nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@HamuNo/works/34", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 172488, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac7ec357/uploads/origins/8b4011ad-ee27-494c-8eb8-e91f43546367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2852aa39d5d2e8ce97bc48ea8d3e637a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac7ec357/uploads/origins/8b4011ad-ee27-494c-8eb8-e91f43546367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf5939622426c437de571bb1f4912cff", "src_set": ""}, "body": "ラブライブの西木野真姫をリクエスト致します\n\n場所はこちらのような雪原地帯の氷をくり抜いて作ったプール\n↓\nhttps://imgur.com/a/UxoufRq\n\nそこに全身浸かり、激痛が走るような冷たさに目のハイライトが消えながら氷水から上がっているというシチュでお願いします\n参考イメージ\n↓\nhttps://imgur.com/a/QClvYgP\n\n水着はこちらと同じもので\n↓\nhttps://skeb.jp/@HamuNo/works/32\n\n構図は足首あたりまで氷水に使った状態で、体の所々に雪を纏わりつかせて下さい", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HamuNo/works/33", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/705d6b29/uploads/origins/500d6632-f01f-46c8-940c-56e32d905f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b06153b28a7626e86958b57544953ba", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 172488, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@HamuNo/works/32", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 172488, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1d26de6/uploads/origins/7129df9d-d8dd-440f-9c03-6be8b4081b3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f887ea380d95a06b9096ce9403df4741", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1d26de6/uploads/origins/7129df9d-d8dd-440f-9c03-6be8b4081b3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a87658c8dbb22c4fee84a5af7ca7bdb", "src_set": ""}, "body": "ラブライブの西木野真姫と矢澤にこをリクエスト致します。\n\nシチュはクジで引いた服で雪の降る極寒の地で耐寒するという流れで、にこは運良く厚着できたものの真姫はビキニを引いてしまったという展開で\n\n構図はこのような形で雪の積もったベンチに座っている所で、にこは余裕そうでも真姫は寒さに加えおしりから太ももに直接雪の冷たさが伝わり悶えながら必死で耐えてるという感じで\n↓\nhttps://imgur.com/a/doix8uK\n\n添付画像では接触してますがそういった構図にはしなくて良いです。\n\n前置きを書きましたがイラストはベンチで座ってる２人のみで大丈夫です。\n\n真姫はこちらの水着で\n↓\nhttps://imgur.com/a/wFYvArz\n\nにこはダウンジャケット、マフラー手袋ニット帽と万全の防寒着でデザインは問いません。\n\n右斜め上から見た視点で２人ともすねのあたりまで見える構図で体の所々に雪を纏わりつかせて下さい。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HamuNo/works/31", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e3b0681d/uploads/origins/96060801-ae80-4312-80dc-793a35dc19bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c80175794b4aa684ffba3f68ad9018a3", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 172488, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@HamuNo/works/30", "private_thumbnail_image_urls": null, "private": 