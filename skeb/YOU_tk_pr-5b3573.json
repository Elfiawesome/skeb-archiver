す！\n\nhttps://drive.google.com/drive/folders/19XJ9RRJE7bupA9N6JBoYJ_wezmvWFeU9?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 12, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "おぷーナ", "screen_name": "op_na_ura", "avatar_url": "https://pbs.twimg.com/profile_images/2022337732757037056/5ZzamyG2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2350122362/1753346915/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1937758, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "くもゆき", "screen_name": "roindayo", "avatar_url": "https://pbs.twimg.com/profile_images/1939454062262374400/qTWPnttt.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1228627409064185856/1751052190/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 3129902, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "河地りん | Kawachi Rin", "screen_name": "gingatrain814", "avatar_url": "https://pbs.twimg.com/profile_images/2014400051007684610/R3uAxgLX.jpg", "header_url": "https://pbs.twimg.com/profile_banners/929559463/1767271805/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": fa