": false}, {"path": "/@oto_hisakabe/works/506", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e1f25410/uploads/origins/53b1ca6e-27b7-4a33-aea2-39ed4611398a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4cc321a8c813ee9bca53ca1fe67b5092", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 186238, "client_id": 580392, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@oto_hisakabe/works/505", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/55b16f6d/uploads/origins/a0cc9832-33b2-44c6-a94d-45ca37dd622c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dca499800118a0fc6e0704f498c8109e", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 186238, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@oto_hisakabe/works/504", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 186238, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a9c25d9/uploads/origins/263507db-21b4-4ebb-b3e1-ded4e6b8db45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7219a879c5dc1394abd7b3e38608dbc3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a9c25d9/uploads/origins/263507db-21b4-4ebb-b3e1-ded4e6b8db45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=064fcfed2226611c4d5cf581a1d0ab64", "src_set": ""}, "body": "初めまして、アイドルマスターシャイニーカラーズの黛冬優子と愛依弟のイチャラブイラストをお願いします。\n（参考 : https://twitter.com/imassc_official/status/1613007802611519489）\n格好は全裸で構図や台詞などは描きやすいかたちでお任せします。\n差分を可能であれば受精差分とボテ腹差分をお願い致します。\nよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oto_hisakabe/works/503", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/513a44f2/uploads/origins/9d6ff001-c36f-4c2d-9afa-b7a532195ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4bcb89a09046a41aae574f57a8517be", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 186238, "client_id": 467047, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@oto_hisakabe/works/502", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 186238, "client_id": 111579, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2a07177/uploads/origins/ea0a7144-63c5-4818-92cf-cdaf09ffde27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87a1444eedbb40c5f31c5e11d8a55fdc", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c2a07177/uploads/origins/ea0a7144-63c5-4818-92cf-cdaf09ffde27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4866234cf63b7896f19e9d803dbb57c5", "src_set": ""}, "body": "前略\n\n今回もリクエストさていただくのは勿論、ドリームクラブより紗羅です。\n\nテーマは「水族館デート」です。\n\n以下の要素を含めてください。\n\n・服装:私服(公式私服でない、詳細はお任せ)\n・場所:鴨川シーワールドのオーシャンスタジアム\n・シチュエーション: シャチのパフォーマンスショーを一緒に観覧\n・備考:左手薬指に結婚指輪\n\nその他詳細はお任せいたします。表情差分等も加えていただけると嬉しいです。\n\n紗羅との水族館デートをどうぞよろしくお願いいたします。\n\n草々", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oto_hisakabe/works/501", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 186238, "client_id": 163084, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20afdf7d/uploads/origins/ad9c90ad-a94c-4cf9-9e59-970d816b63e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b48f8acd8d382768eef651ca54b75c54", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20afdf7d/uploads/origins/ad9c90ad-a94c-4cf9-9e59-970d816b63e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cea9baf873940f94793c12351a6bf2fc", "src_set": ""}, "body": "こんにちは。今回も久壁さんにお願いしたく依頼させて頂きます。\n個人Vの「月待にゃも」さん（https://x.com/TukimachiNyamo/media）の本番行為をお願いしたいです。\n\n衣装はこちらでお願いします。衣装は着衣か半脱ぎで、上着の有無はお任せします。\nhttps://youtu.be/Nte4jNqUFnY?t=2379\n当該配信で髪型は色々ありますが、URL先のロングヘアーでお願いします。\nまた本人曰く「胸のサイズは可変式」だそうですので、描きやすいサイズに盛って頂いても一向に構いません。\n\n構図や体位はお任せします。\n金額の範囲で行為、絶頂、余韻の差分をお願いいたします。\n\n以上となります。宜しければご検討宜しくお願い申し上げます。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oto_hisakabe/works/500", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 186238, "client_id": 100402, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbb7e406/uploads/origins/26f59ff6-2215-4688-bd8f-674ee26a6f24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab5fad147f42cbdeb4340f7a12524189", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbb7e406/uploads/origins/26f59ff6-2215-4688-bd8f-674ee26a6f24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b4c62be7ef79e2b6ec601bba66db6e7", "src_set": ""}, "body": "先日の依頼を再送させて頂きます。\n改めてご検討頂けますと幸いです。\n\n再びですが、ピロートークシチュの作品をお願いします。\n\n今回は僕のヒーローアカデミアより、麗日お茶子×緑谷出久で事後・ピロートークシチュの作品をお願いします。\n二人とも全裸でベッドの上にて寝そべっており、向き合ってるかお茶子がデクに寄り添っているような体勢で。\nお茶子の胸は他の方が依頼されている作品のような麗らかな美乳で、大好きな彼と結ばれて幸せそうな表情でお願いします。\n男性側のデクについては描写の度合いはお任せしますが、少なくとも彼である事が分かるよう描写をお願いします。\n2人共どちらかというと恋愛面に関しては奥手な感じなので、初々しさの残る表情や雰囲気で描いて頂ければと思います。\nまた、前回と同様に愛液の描写等もお願いします。\n\n注文が多くて恐縮ですが、よろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oto_hisakabe/works/499", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2222c1d3/uploads/origins/bce7da2f-9115-4750-9fb6-5a74d2d200ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a50bab6059f730549cb482707973b56d", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 186238, "client_id": 3477698, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@oto_hisakabe/works/498", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 186238, "client_id": 111579, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9bb7c49/uploads/origins/64d782ea-1679-455e-b86d-b23d4604816e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ab9783ef9f957885526cb71f4d615eb", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9bb7c49/uploads/origins/64d782ea-1679-455e-b86d-b23d4604816e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d02796937a5aa419133942e4f5153d80", "src_set": ""}, "body": "前略\n\n今回もリクエストさていただくのは勿論、ドリームクラブより紗羅です。\n\nテーマは「水着デート2025」です。\n\n以下の要素を含めてください。\n\n・服装:水着(フリルセパレートのキャミソールトップとフリルスカート)\n・備考:左手薬指に結婚指輪\n\nその他詳細はお任せいたします。ポロリ差分、表情差分等も加えていただけると嬉しいです。\n\n紗羅との水着デートをどうぞよろしくお願いいたします。\n\n草々", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oto_hisakabe/works/497", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 186238, "client_id": 39231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48678e59/uploads/origins/478bd882-adbf-4cf3-a71e-85fb86ae6180?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3132a5a9ab4ab5bd705042d35ca9907b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48678e59/uploads/origins/478bd882-adbf-4cf3-a71e-85fb86ae6180?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2504b6406890f7178af0b2f55f053c7e", "src_set": ""}, "body": "はじめまして\n資料のような感じで、ベッドに仰向けになって恥ずかしげもなく股を見せつけているシチュエーションのイラストをテイルズオブデスティニー2のリアラでお願いします。\n構図に関してあまり真上からの見下ろしにならないように、資料程度には足元からのあおり構図にしてください。\n格好は全裸に髪の装飾品のみ。可能であれば首のチョーカーとレンズ（銀色の丸いやつ）もあってほしいですが画角的に難しいならなくてもいいです。\nおっぱいは資料くらいに貧乳の部類だけど膨らみはちゃんとある程度のものに。\nまた、以下のような差分をおねがいします。\n①困り眉の微笑み。「…きて❤」というセリフ\n②心地よい満足そうな顔。開いたまんこと漏れ精液。股間付近のシーツ濡れ描写。（全部中に出されちゃった…❤）（しあわせ…❤）という心の声のセリフ\n③散々イキ散らかした後の疲労困憊の表情。こちら以外に視線を向けている。開いたまんこと②の数倍広がっている漏れ精液。腹・胸・顔・髪にも精液をかけられている。股間付近のシーツ濡れ描写もさらに広がっている。（まだ朝になってないのにこんなに…❤）（すごいにおい❤）（すきな人とのセックスすごい❤）（まだシたいのかな…？）（これ以上イかされたら…❤）という心の声のセリフ\n④表情を微笑みにして視線をこちらに、それ以外はセリフ以外③と同じに。「…まだ、する？」「…いいよ❤」というセリフ。\n③の心の声はたくさん吹き出しがあった方が気持ちよくさせられすぎて意識が散漫になっている雰囲気が出ているように思うので、可能であれば上記以外にもいくつか増やしていただきたいです。\n以上です、ご都合よろしければお願いします。\n\nhttps://www.pixiv.net/artworks/117911346", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, 