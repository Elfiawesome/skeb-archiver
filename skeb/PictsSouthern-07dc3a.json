m=webp&fit=crop&crop=top&w=200&h=200&s=71c5a67a1179d2b3b37d550b66c30f79, https://si.imgix.net/fa94c912/uploads/origins/c8204405-aa33-40a6-8127-d38537d1b3d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=671ac404ec8c40d9a92825a8e1981e20 2x, https://si.imgix.net/fa94c912/uploads/origins/c8204405-aa33-40a6-8127-d38537d1b3d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b652caa64f4f194c7de78f5127a7b2fb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa94c912/uploads/origins/c8204405-aa33-40a6-8127-d38537d1b3d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a95a687fa88e490e016e073875cae942", "srcset": "https://si.imgix.net/fa94c912/uploads/origins/c8204405-aa33-40a6-8127-d38537d1b3d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a95a687fa88e490e016e073875cae942, https://si.imgix.net/fa94c912/uploads/origins/c8204405-aa33-40a6-8127-d38537d1b3d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a1c5e4ec870357f7c6d4cb913190c090 2x, https://si.imgix.net/fa94c912/uploads/origins/c8204405-aa33-40a6-8127-d38537d1b3d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e41bfe4700891162ec3902ae4d8223a6 3x"}, "body": "トウコちゃんのおもらしのイラストをお願いします。\n観覧車が途中なんらかのトラブルで停止し、そのまま中に閉じ込められた状況で我慢できず…という感じで。尿量は多めにしてください。\n一緒に乗ってる相手はトウヤで「えっ!?えっ…ちょトウコ…?」的な困惑する感じにしていただきたいです。\n\nトウコちゃんは涙目になりながらみないでってお願いするような感じにして頂きたいです。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PictsSouthern/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 992763, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/abc562e3/uploads/origins/9423e245-9739-49f1-9246-ece58a89ca2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=807fa40af95eeebd86ebff416909b1fc", "srcset": "https://si.imgix.net/abc562e3/uploads/origins/9423e245-9739-49f1-9246-ece58a89ca2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=807fa40af95eeebd86ebff416909b1fc, https://si.imgix.net/abc562e3/uploads/origins/9423e245-9739-49f1-9246-ece58a89ca2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a23c12226982c029865551afb46673d 2x, https://si.imgix.net/abc562e3/uploads/origins/9423e245-9739-49f1-9246-ece58a89ca2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f50819c6fbf1b2a57f29d18441af4eb2 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/abc562e3/uploads/origins/9423e245-9739-49f1-9246-ece58a89ca2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f86d49a0469b65e44e1d4a4a9ec9a1d6", "srcset": "https://si.imgix.net/abc562e3/uploads/origins/9423e245-9739-49f1-9246-ece58a89ca2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f86d49a0469b65e44e1d4a4a9ec9a1d6, https://si.imgix.net/abc562e3/uploads/origins/9423e245-9739-49f1-9246-ece58a89ca2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=44ca4cd4ce35eb06383c569a1b669ecf 2x, https://si.imgix.net/abc562e3/uploads/origins/9423e245-9739-49f1-9246-ece58a89ca2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=99fd491be8d80ece0c376eb62a424665 3x"}, "body": "いつもSNSで素晴らしいおもらし絵を拝見させていただいております。\n依頼内容が細かくて申し訳ありませんがよろしければ承認お願いいたします。\n厳しいようであればモノクロ絵でも大丈夫です。\n【シチュ】\n「アイドルマスターシンデレラガールズ」のお嬢様JS、櫻井桃華ちゃんのうんちおもらしをお願いします。\nシチュとしてましては学校でうんちするのが恥ずかしくて家まで我慢しようとしたが、自分の予想以上に便意が激しくて通学路で限界を迎えて決壊、パンツをモコモコとうんちで盛り上げてしまい、おもらしパンツでスカートが汚れないようにお尻の部分を捲り上げてる感じでお願いします。(イメージとしてはこんなポーズ(https://imgur.com/a/Av98qO5)でお願いします。\n\n【表情】\nみなみず様のこちらの作品(https://www.pixiv.net/artworks/88073266)のような感じでお願いします。\n\n【服装】\n↓のもので、帽子とランドセルも着用状態でお願いします。下着は白色でお願いします。\n服装資料1：https://www.pmoa.co.jp/product/157.html\n服装資料2：https://imas.gamedbs.jp/cg/idol/detail/15?h=imcgss-c461", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PictsSouthern/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 992763, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7be99b7f/requests/247395_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63b6bda14259fb9951a485a8408a9d3f", "srcset": "https://si.imgix.net/7be99b7f/requests/247395_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63b6bda14259fb9951a485a8408a9d3f, https://si.imgix.net/7be99b7f/requests/247395_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ecdc1f1778c79f54c674652dd477f081 2x, https://si.imgix.net/7be99b7f/requests/247395_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b86bdfe4458b68ff2012e520e6f2695 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7be99b7f/requests/247395_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aaa0d5dbd15363f6ec96576171758792", "srcset": "https://si.imgix.net/7be99b7f/requests/247395_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aaa0d5dbd15363f6ec96576171758792, https://si.imgix.net/7be99b7f/requests/247395_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=72b4539dcea43f3eb4c3fe4e2e762d4e 2x, https://si.imgix.net/7be99b7f/requests/247395_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=36babadc831ab5ead354761fcb8d7183 3x"}, "body": "JCがベッドでおねしょしたイラストをお願いします。\n目覚めた直後の布団から出た状態で背中まで濡れている感じを表現していただけると嬉しいです。\nパジャマは薄いピンク色\nパンツは水色で脱いでいる途中の状態で雫が滴っている状態でお願いします。\n\n背景は簡素で構いません。\n\nよろしければ受けていただくと嬉しいです。\nよろしくお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PictsSouthern/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 992763, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/855fe501/requests/256302_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=021f3da503841a148fa32cb70c199260", "srcset": "https://si.imgix.net/855fe501/requests/256302_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=021f3da503841a148fa32cb70c199260, https://si.imgix.net/855fe501/requests/256302_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb49e5262bda76628f687e1b3f1b54b4 2x, https://si.imgix.net/855fe501/requests/256302_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=857c7fa665d96f30eeb3b233d8bcaa7a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/855fe501/requests/256302_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e69ed6a6a4328515daa9d6989ce2eb82", "srcset": "https://si.imgix.net/855fe501/requests/256302_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e69ed6a6a4328515daa9d6989ce2eb82, https://si.imgix.net/855fe501/requests/256302_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=749a947447a2810fff20e5c7b404f987 2x, https://si.imgix.net/855fe501/requests/256302_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=af40ed44ae6e24ac0c150daffcc89ed9 3x"}, "body": "先日は素晴らしいイラストをありがとうございました。是非この続きが見てみたいと思いまして、https://skeb.jp/@PictsSouthern/works/1こちらの女の子が駅のトイレの個室の中でおもらしの後始末をしているイラストをお願いします。先日同様のリクエストを送らせていただきましたが、細かい指定が多かったので簡略化してみました。\n\n＜シチュエーション＞\n恥ずかしさから途中の駅で電車から降りて駅の小汚い和式トイレの個室で後始末をしている\n\n＜構図＞\n女の子がおしっこまみれになったパンツを泣きながらしながら脱いでいる様子\n女の子は足先まで全身が描かれている構図でお願いします。\n\nもしよろしければご検討をお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PictsSouthern/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 992763, "client_id": 784488, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec4a8e66/requests/236935_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75fb372efd859b0255cd48731af77206", "srcset": "https://si.imgix.net/ec4a8e66/requests/236935_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75fb372efd859b0255cd48731af77206, https://si.imgix.net/ec4a8e66/requests/236935_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86e0fa3ef072f80207073e220a236fff 2x, https://si.imgix.net/ec4a8e66/requests/236935_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7d475d437eabc905b80ec2408d02a3d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec4a8e66/requests/236935_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=812844c6cc829377157772e0211b888b", "srcset": "https://si.imgix.net/ec4a8e66/requests/236935_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=812844c6cc829377157772e0211b888b, https://si.imgix.net/ec4a8e66/requests/236935_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d4e1646bced1ee73d01963ee2954c108 2x, https://si.imgix.net/ec4a8e66/requests/236935_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6a6a5fcb42edb802e165cd77df561e46 3x"}, "body": "いつもイラスト拝見しております。\n\n初代ポケモン、ジムリーダーのナツメのおねしょイラストをお願いします。\n\nベッドから降り、そのかたわらでぐっしょり濡れたパジャマの下を半分脱いでいる時に誰かが入ってきて「入るなって言ったでしょ！」と顔を真っ赤にしながら涙目で怒っている様子。\nパンツやパジャマから垂れたおしっこの跡が床にポツポツと垂れていて、ナツメの股や足もおしっこの導線が伝っており、かなり派手にやってしまった感じで、上のパジャマも結構濡れてしまっていてほしいです。ベッドの布団のシミは丸見えで、かなり大きめのシミだと嬉しいです。\n\nその他の細部に関しましては、みなみず様の裁量にお任せいたします。細かい指定でお手数おかけいたしますが、なにとぞよろしくお願い申し上げます。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PictsSouthern/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 992763, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df94df37/requests/242954_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=921b8c46f7714c62e9bc4e3200b3b525", "srcset": "https://si.imgix.net/df94df37/requests/242954_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=921b8c46f7714c62e9bc4e3200b3b525, https://si.imgix.net/df94df37/requests/242954_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc66f45df39eb1b31ad84a1d5722afb2 2x, https://si.imgix.net/df94df37/requests/242954_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77d6b5d724a96f2354c69b19c9c8d07b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df94df37/requests/242954_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e34485bffadcd577c8d3acf818788b2", "srcset": "https://si.imgix.net/df94df37/requests/242954_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e34485bffadcd577c8d3acf818788b2, https://si.imgix.net/df94df37/requests/242954_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0d49a9e965df3d253875d00f729d27ec 2x, https://si.imgix.net/df94df37/requests/242954_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=226e4473522b10744a667d8dc68acf3c 3x"}, "body": "まんがタイムきらら系列の作品「まちカドまぞく」の\"吉田優子（シャミ子）\"がパンツに大きい方をもらしてしまっているイラストをお願いします。魔法少女の千代田桃の家で、トイレは桃が使用中でドアを叩きながら我慢の限界でもらしてしまい、パンツをもりもり膨らませています。\n　服装は資料URLのキャラ欄の制服で、パンツの膨らみがわかりやすいと好みです。スカートやタイツ邪魔でしたら、まくりあげていたり先に下ろしてる感じでも大丈夫です。\n場所は洋風のお家の、トイレのドアの前（具体的には千代田桃の家）をイメージしてもらえるとわかりやすいです。\n　視点やアングルは顔とパンツが見えればお任せします。（別コマで顔だけを映してもOKです）\n\n　もしリクエストがOKであれば小説の挿絵として使わせてください。その際は掲載前にご報告します。挿絵なのでグレースケールでも構いません。A5～A4サイズだと嬉しいです。\n\nhttps://www.tbs.co.jp/anime/machikado/character/index.html", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PictsSouthern/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 992763, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89eee915/requests/236395_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e373cf9e982808b3fb3893b84dd004f", "srcset": "https://si.imgix.net/89eee915/requests/236395_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e373cf9e982808b3fb3893b84dd004f, https://si.imgix.net/89eee915/requests/236395_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d7d77499db8d09a91eafb4c9c12a0df 2x, https://si.imgix.net/89eee915/requests/236395_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d352ab2ef5ef8e2d4d4d61136ab48099 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89eee915/requests/236395_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1664c76c9d3403bb29e4f9f5a4fcdcf6", "srcset": "https://si.imgix.net/89eee915/requests/236395_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1664c76c9d3403bb29e4f9f5a4fcdcf6, https://si.imgix.net/89eee915/requests/236395_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cf9f8315898edfbb191c80a85206f948 2x, https://si.imgix.ne