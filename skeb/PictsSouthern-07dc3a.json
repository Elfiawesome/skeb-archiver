している。3、4回ほどの脱糞を経た事で、お尻の辺りはウンチが溜まっているのがわかるほど膨らんでおり、茶色のシミも滲み出ている。\n表情はウンチの暖かさに心地良さを感じて、笑顔で眠っている様子。\n\n可能であれば、以下の形式で差分のイラストをお願いします。\n\n・構図、姿勢、表情は同じ。\n・服は紙オムツ1枚のみ。固形のウンチがギャザーから漏れ出ている状態。\n\n以上となります。よろしくお願いします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PictsSouthern/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 992763, "client_id": 784488, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/788a2327/uploads/origins/19ace627-64d2-4cf2-b752-5ddca118eed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69baee8c6a89fb8ffbd8fe37a780f24d", "srcset": "https://si.imgix.net/788a2327/uploads/origins/19ace627-64d2-4cf2-b752-5ddca118eed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69baee8c6a89fb8ffbd8fe37a780f24d, https://si.imgix.net/788a2327/uploads/origins/19ace627-64d2-4cf2-b752-5ddca118eed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24f932ca2fde87c38adf0e8d5ee20eb7 2x, https://si.imgix.net/788a2327/uploads/origins/19ace627-64d2-4cf2-b752-5ddca118eed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=959c0c536e8493fb716e8a6d60262273 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/788a2327/uploads/origins/19ace627-64d2-4cf2-b752-5ddca118eed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f5627dbf4164d164567709196f942a9", "srcset": "https://si.imgix.net/788a2327/uploads/origins/19ace627-64d2-4cf2-b752-5ddca118eed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f5627dbf4164d164567709196f942a9, https://si.imgix.net/788a2327/uploads/origins/19ace627-64d2-4cf2-b752-5ddca118eed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a2a46a4cf9a48d661