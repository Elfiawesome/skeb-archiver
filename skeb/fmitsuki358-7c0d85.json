%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f4528248d0b08385219e5dd0833caa97 2x, https://si.imgix.net/f61a5ab0/uploads/origins/3130b95e-9f4f-475c-a82a-c0a8e074cce3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=30b99c04834ce7649463f60f13fb9281 3x"}, "body": "こんにちは！(☆´∀｀)ノ\nあなたのアートワークはとてもゴージャスで、ぜひ私のVtuberの絵を依頼したいです！ケルピーは人魚をテーマにしたラウンジシンガーで、キュートでまろやかな性格です。服装はスカートや袖に動きのある全身ポーズがいいです！モチーフは人魚、音楽、リボン、水、真珠、泡、貝殻、キラキラ。この作品を収益化するつもりはなく、ライブ配信やソーシャルメディアへの投稿に使用したいだけです。この度は本当にありがとうございました！♡\n\nhttps://drive.google.com/drive/folders/1bwB_0nYv_LzuvYrr-c1uA8d5w7C0D1ml?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fmitsuki358/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1450743, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1250c403/uploads/origins/d425b269-990a-4883-a948-d5b6fbe25ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24eab226f0bc3fd06f9e97bd0e2ed150", "srcset": "https://si.imgix.net/1250c403/uploads/origins/d425b269-990a-4883-a948-d5b6fbe25ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24eab226f0bc3fd06f9e97bd0e2ed150, https://si.imgix.net/1250c403/uploads/origins/d425b269-990a-4883-a948-d5b6fbe25ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=210b9a768068d7dd9990c29ff287a88e 2x, https://si.imgix.net/1250c403/uploads/origins/d425b269-990a-4883-a948-d5b6fbe25ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df75f5edd55776991e728bf1066f89f6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1250c403/uploads/origins/d425b269-990a-4883-a948-d5b6fbe25ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=532c66bb1e6d47eb540e254a6d66e539", "srcset": "https://si.imgix.net/1250c403/uploads/origins/d425b269-990a-4883-a948-d5b6fbe25ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=532c66bb1e6d47eb540e254a6d66e539, https://si.imgix.net/1250c403/uploads/origins/d425b269-990a-4883-a948-d5b6fbe25ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=760d723ebc26fe114951e3cfe758d1c7 2x, https://si.imgix.net/1250c403/uploads/origins/d425b269-990a-4883-a948-d5b6fbe25ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed14f7175592e67507391105e0f69d05 3x"}, "body": "はじめまして、以前から作品をチラ見しふんわりフリル、リボンやドレス可愛いなと思い、いちごジャムうさぎのイラストがいいなと思ったのでリクエストさせて頂きます！\n\n個人Vtuberの「雛乃あき」さんへのプレゼントとしてイラストをお願いしたいです\n・使用用途-プレゼント（収益化済youtubeチャンネルのサムネイル、SNSの仕様を想定しております）\n\n・構図は全身や膝上くらいを目安だとありがたいです\n・ポーズ、髪型などもお任せします！\n\n・配信サムネへの利用等も考え 耳や尻尾が枠内に入ってるとありがたいです\n・psd形式で背景とキャラ絵は別にできるようだとありがたいです　(背景透過？)\n・背景は、うす紫ベースやカラーおまかせ希望です、コーヒー、ティーグッズ、お菓子、藤やお花、など数点あればと思います、全部入れなくても大丈夫です!\n\n・服装は、農婦やお出かけフリルな雰囲気がでれば幸いと思ってますー\nこんな衣装着せてみたい等ありましたら、それでも全然いいです　見てみたいです！\n・表情もおまかせしますー 　\n\n以下　Vtuberさんのイメージと参考資料です\n\ntwitterの設定図アドレス　リンク先の詳細外部プロフにガイドラインみたいのがありますー (衣装変更OK等)\nhttps://twitter.com/hinano_vt/status/1526462810074791936?s=20\n\n一応必要であればイメージ用に最近の三周年記念配信など貼っておきます\nhttps://www.youtube.com/live/peG0V5WHwLQ?feature=share&t=265\n\nふんわりまったり系　毛量の多いネコのソマリブルーをモチーフにしてるそうです\n紅茶やコーヒーも好きそうで、割と抜けたところがあり、方向音痴の迷い猫です。\n配信は、ゲーム(APEXなど)、雑談、お絵描き、などが多いです\n\n以前から頼んでみたいなと思いつつ年の瀬のリクになってしまいましたが\nご検討の程 よろしくお願いします～　 m(_ _ )m", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fmitsuki358/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1450743, "client_id": 1231610, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/671c4c8b/uploads/origins/1226deff-4463-4e3f-ac48-4c6b8a898d3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=2