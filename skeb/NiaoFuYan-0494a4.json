/origins/aebfeab1-976c-4c5d-9293-b08b9e0419fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a799fb51e05e9fa294ab8b6d8626330 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a7d017b/uploads/origins/aebfeab1-976c-4c5d-9293-b08b9e0419fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4cb823671e9973159df3931178b77bd", "srcset": "https://si.imgix.net/4a7d017b/uploads/origins/aebfeab1-976c-4c5d-9293-b08b9e0419fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4cb823671e9973159df3931178b77bd, https://si.imgix.net/4a7d017b/uploads/origins/aebfeab1-976c-4c5d-9293-b08b9e0419fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e5e4b1c7d83ed158651f31577ac1742 2x, https://si.imgix.net/4a7d017b/uploads/origins/aebfeab1-976c-4c5d-9293-b08b9e0419fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ef27547a26d032720bd6c3248bf0dd0d 3x"}, "body": "你好！好久不见，虽然之前那幅作品至今仍是我的最爱之一。我想问问你能不能再画一画我的另一个角色。\n\n他是个调皮捣蛋的人，大部分时间都在烦他的保镖。他打扮得像个女人，但其实是个男人。 他的头发和眼睛都是浅粉色的，个子比较矮。\n\n目前我只想多看些他穿新衣服的样子（就是链接里第二张那套）。另一张参考图是让你知道该怎么画他的头发。\n\n请随心所欲地画他。\n\n非常感谢。\n\nhttps://imgchest.com/p/n87wbxgab7x", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NiaoFuYan/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3081698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de6400e1/uploads/origins/495dd7d0-2611-4fb7-84aa-0b962f6c21c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e92ef1fdae339397758e754b2f25c468", "srcset": "https://si.imgix.net/de6400e1/uploads/origins/495dd7d0-2611-4fb7-84aa-0b962f6c21c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e92ef1fdae339397758e754b2f25c468, h