_same_genre": false}, {"path": "/@oishi___na/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3391036, "client_id": 2690856, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de45b529/uploads/origins/8cbcedb2-5ffd-4d6f-926f-f006e2315f96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61dcd33f609e78e1500c1d73aa8fbaf5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de45b529/uploads/origins/8cbcedb2-5ffd-4d6f-926f-f006e2315f96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=573e54956972a17a3cfdc23ac4c7fcbd", "src_set": ""}, "body": "Hello！ I have liked your artwork so much. I'd like you to draw my OC. She is a girl who has grey hair and pink eyes. The cloth in the reference that you can freely choose. Composition and posture that you can draw freely too! I will be very happy if I have the opportunity to cooperate! https://drive.google.com/drive/folders/1AIRfVkicJokybmEfIRwf_JV_REY1FroW", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oishi___na/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a02b9b19/uploads/origins/06aba21d-3252-4fed-b1ed-224a8505a3b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c39bbbc7728785ecad81c8bd04a49ead", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3391036, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@oishi___na/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3391036, "client_id": 2963861, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/920ed7c7/uploads/origins/2f35f114-9e4f-4f82-b63c-6cb55e0bc21b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45e51997b50913c5ce1b747846295418", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/920ed7c7/uploads/origins/2f35f114-9e4f-4f82-b63c-6cb55e0bc21b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59cc3b9e0456307da2712e051b05d5f2", "src_set": ""}, "body": "はじめまして、先生の絵に一目惚れしましたリクエスト失礼致します(；＿；)\n\n●資料\nhttps://drive.google.com/drive/folders/11tNPW2FtHJdsQOsl3vTuyY4PZuQTxjle\n(可能でしたらうさぬいもどこかに入れてくださると嬉しいです)\n\n●表情   泣き顔または赤面\n\n●先生オリジナルの可愛らしいお洋服を着せていただきたいです♪♪\n・紫 ／灰色／白／ピンク\n・兎 ／リボン ／ロリポップ\n・露出◎\n\n●NG等ありませんので先生お好みの女の子にしてください‎〜⊃  ̫  ; \n\n宛名・透過と分けていただきたいです ！\n何卒よろしくお願い致します\n\nhttps://drive.google.com/drive/folders/11tNPW2FtHJdsQOsl3vTuyY4PZuQTxjle", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oishi___na/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3391036, "client_id": 3100976, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6571aea/uploads/origins/eeef1fe9-ecf2-4e29-9602-9916fd65819b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f74f41d1abdef863f46f2f59d972b641", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f6571aea/uploads/origins/eeef1fe9-ecf2-4e29-9602-9916fd65819b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ba17168d4c38d0b6d62be9b377169b2", "src_set": ""}, "body": "レバ刺し太郎先生初めまして❕krk（くるく）と申します。以前からレバ刺し太郎先生のことが本当に大好きで、ずっとずっと拝見しておりましたTTまたお会いできて本当に嬉しいです❕❕可能であれば先生にうちの子を描いていただきたく、リクエスト失礼します。\n\n  【キャラクター詳細】 \n10代半ばの女の子\n 身長▷160〜165cm \n外見▷淡い銀髪、碧眼、毛先を緩く巻いたロング、左右に耳付近まで三つ編み \nMBTI▷ISFJ  \n花と本が好きな本の虫で、どこか神秘的な印象がある女の子です❕\n  蝶、リボン、ネモフィラ、カスミソウ、雪の結晶　coquette coreやbull coreが似合います❕(無視していただいて大丈夫です)  \nイメージソングをまとめたプレイリストを添付させていたきます。よろしければご活用ください。\nhttps://youtube.com/playlist?list=PLSVCShTbzebvbo5o49G71DLrjqHIl60yO&si=SUGOHNuUFeYRAwUc\n\n 【リクエスト内容】 \n構図、表情、衣装など全ておまかせいたします❕\nレバ刺し太郎先生の好きなように描いていただけたら嬉しいです❕ \n衣装はフォルダ内からお好きなものを選んでいただいても、好きな服を着せていただいても大丈夫です。  \nヘアアレンジ、衣装のデザイン変更、衣装の簡略化も大丈夫ですが、両横に耳まである三つ編みとその下の髪飾りは崩さないでいただけるとありがたいです。(髪飾りのデザイン変更も大丈夫ですが、何か飾りをつけてください)  \nNG▷血、ショートヘア\n\n【ファイル形式】 \nPSDまたはPNGデータでサインや人物、背景などを分けたものをいただきたいです。 \n\n 【使用用途】 \n・アイコン、ヘッダー等SNSでの利用 \n・グッズ化(商用利用、譲渡等一切無しの個人鑑賞用) 不可の場合はお手数ですが別レイヤーに記載していただけますと幸いです。  \n\nどうぞよろしくお願いします❕\n\nhttps://drive.google.com/drive/folders/14dFECpAvR_lYA3ZdDzbDvJplLTbZ1Ic4", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oishi___na/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8567dbb8/uploads/origins/3f746bcf-ac3a-4c90-af58-98bb24742bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f31c00224bfada0b24e7dd60616f8e49", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3391036, "client_id": 2682937, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@oishi___na/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3391036, "client_id": 2449089, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8791ee74/uploads/origins/c152216f-e91d-47e4-baa7-dc9aac265d16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h