ix.net/7a30161c/uploads/origins/fbc337c7-063d-44e7-9946-7dd1521a6275?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2d08074da849071efda4c25c96bd139 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a30161c/uploads/origins/fbc337c7-063d-44e7-9946-7dd1521a6275?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c150567089fc3ae2129f184625efb316", "srcset": "https://si.imgix.net/7a30161c/uploads/origins/fbc337c7-063d-44e7-9946-7dd1521a6275?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c150567089fc3ae2129f184625efb316, https://si.imgix.net/7a30161c/uploads/origins/fbc337c7-063d-44e7-9946-7dd1521a6275?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aed632246c6a35f71c5cc6cb9dc45fbc 2x, https://si.imgix.net/7a30161c/uploads/origins/fbc337c7-063d-44e7-9946-7dd1521a6275?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d7ec0c1f422a81b0fc15ff1796eedf83 3x"}, "body": "はじめまして、アピールありがとうございました。\n\n羽衣ねねみと申します。\n個人で活動しているVtuberのオリジナルキャラクターのイラスト制作をお願いしたく、リクエストさせていただきました。\n\n構図・表情・雰囲気等、すべてお任せいたします。\n先生の作風や得意な表現を活かして、自由に描いていただけたら嬉しいです。\n\n完成したイラストは、\n・SNSへの掲載\n・配信や動画のサムネイル等\nの活動用途で使用させていただく可能性があります。\n\n背景ありのイラストをご制作いただく場合、\nあわせて人物のみの背景透過（PNG）データも納品いただく存じます。\n\n問題等ございましたら、Skebの仕様に従いご判断いただければと思います。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1X4Q0aZRkCKwGcM4PY1MooN_72dD8TiX_", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@natsuki_iroha/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1186899, "client_id": 1568097, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/241b6aae/uploads/origins/bab3c591-efaa-485c-a800-388efd3ce1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=912610e77019e54965ec43f98be90958", "srcset": "https://si.imgix.net/241b6aae/uploads/origins/bab3c591-efaa-485c-a800-388efd3ce1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=912610e77019e54965ec43f98be90958, https://si.imgix.net/241b6aae/uploads/origins/bab3c591-efaa-485c-a800-388efd3ce1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a7d2067f42ac28bade6869796d822cb 2x, https://si.imgix.net/241b6aae/uploads/origins/bab3c591-efaa-485c-a800-388efd3ce1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=942bc2100828d3114deb27e7c0cfa2ae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/241b6aae/uploads/origins/bab3c591-efaa-485c-a800-388efd3ce1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8cdbba0161f45dded6c84da3bcd1b01d", "srcset": "https://si.imgix.net/241b6aae/uploads/origins/bab3c591-efaa-485c-a800-388efd3ce1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8cdbba0161f45dded6c84da3bcd1b01d, https://si.imgix.net/241b6aae/uploads/origins/bab3c591-efaa-485c-a800-388efd3ce1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d8abd3550167af88a075d6a436283632 2x, https://si.imgix.net/241b6aae/uploads/origins/bab3c591-efaa-485c-a800-388efd3ce1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=76cbc1638eb638696b04247ea658c557 3x"}, "body": "はじめまして、VTuberの海颯(かいは)と申します。\n\n新着作品から菜月いろは様の作品を拝見し、とても魅力を感じ素敵だった為リクエストを送らせていただきました。\n\n利用用途\n・収益化チャンネルでのサムネイル利用、動画内で使用\n・SNSでのアイコン表示やPR投稿等\n・FANBOX、メンバーシップの特典利用\n※トリミング、文字入れを行い、ヘッダーや壁紙の作成、配布を行う可能性があります。\n\nキャラクター詳細\n・性別　男性\n・星座(いるか座)モチーフ\n・魔法系の騎士\n・イメージカラー　青紫\n・身長は170cm程度\n・向かって顔の左側に涙ぼくろ、右くびにいるか座のタトゥー\n・無邪気でお調子者\n・自由人\n\n三面図を添付いたします\nhttps://drive.google.com/drive/folders/10uCRbGoaO9pJdEpzap8lJCNefXXTIe1z?usp=drive_linkg