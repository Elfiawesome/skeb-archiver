下のものを別レイヤーにして頂き、PSDファイルの納品をお願い致します。\n　・人物　・宝石　・目　・冠　　・角　・頭飾りのエメラルド\n\nhttps://drive.google.com/drive/folders/1YSOU1CEpNm-Mj36f1XxAEDjhzgaAl9kX?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2yu93salt/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1153209, "client_id": 2593764, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51bcce80/uploads/origins/a3b595e7-0e3c-475c-97fe-70e5c51a5e6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51ec7c6bd8dfaa05779fbeaff427370a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51bcce80/uploads/origins/a3b595e7-0e3c-475c-97fe-70e5c51a5e6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=112e028a01f3e6ba187635cdf3c0af4f", "src_set": ""}, "body": "あなたのスタイルはとても可愛いわ！ぜひあなたに依頼したいわ！\n\n私のOCであるミーティカがギャラクシーパワーを使っている全身イラストを描いていただけませんか？あなたのスキルなら完璧にそのシーンを描けると思います。最初の服装で、真剣な表情をお願いできますか？\n\nお願いを聞いてくださりありがとうございました！\n\nドライブ：https://drive.google.com/drive/folders/1JGM9kUW3LBGlm_beipl_l9W3BpuK7dY_?usp=sharing\n\nhttps://drive.google.com/drive/folders/1JGM9kUW3LBGlm_beipl_l9W3BpuK7dY_?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2yu93salt/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1153209, "client_id": 2078451, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d447fa2e/uploads/origins/70ad558a-63c1-4bd8-8e51-15530e617489?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b68f7651485d21933bc74f04deae967b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d447fa2e/uploads/origins/70ad558a-63c1