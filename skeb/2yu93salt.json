=200&h=200&s=6b9638497b843fe7113f54df06d84ca3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8a1e50e/uploads/origins/c2507b07-33c5-4804-8bc1-a9189cf4c769?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2fbccce163926a5c47b4d6569d494bd", "src_set": ""}, "body": "こんにちは！あなたのアートスタイルはとても美しいです！私のOC、アイレナをリクエストしてもいいですか？仕事として星のデータを集めるためにいろいろな場所を旅しているのんきな女の子です。\n\nこのイラストの描き方がとても好きです！https://skeb.jp/@2yu93salt/works/3\n\n私のキャラクターも同じように幽玄で美しい設定で描いてください。全身を描くことが望ましいですが、必須ではありません。服装はオリジナルのものでも、新しくデザインしても構いません。それ以外はお任せします！\n\n作品はSNSのアイコンやヘッダー、投稿にクレジット表記して使わせていただくことがあります。キャラクター、背景、サインは別レイヤーで分けていただけると嬉しいです。\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1xXPBIoxvIYZ7B_E5GyOkXWZ58_f1pw2x", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2yu93salt/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1153209, "client_id": 3236640, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12631146/uploads/origins/e6ddfbc8-c90b-4fb0-b0a0-fe32a599e1ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49c6e12925dbde35bfcf7b4c9db3ab7f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12631146/uploads/origins/e6ddfbc8-c90b-4fb0-b0a0-fe32a599e1ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0de1c264edc9a5bc89dc81cbdef6bb48", "src_set": ""}, "body": "初めまして、こんにちは、葉と申します。私は先生の作品が大好きですので、この度失礼ながらお願いさせていただきます。私のOC「フィロソフィア」を描いていただきたく存じます。彼女は笑うことが好きで。\n\nすべてお任せします。\n\nご依頼をお引き受けいただけましたら、非常に嬉しく存じます!\nhttps://drive.google.com/drive/folders/1cDpAGRWgC3DnMZYVSUmO5DQ7kPcad-kX", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2yu93salt/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1153209, "client_id": 2207365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d1f6b2d/uploads/origins/9987d68b-27a0-4350-b44c-ba43c080e9d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b2d82dcb6d156f6fd8a0255dc657f80", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d1f6b2d/uploads/origins/9987d68b-27a0-4350-b44c-ba43c080e9d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a01db7c172eb64a2d9f97e92e3e13a8c", "src_set": ""}, "body": "露草様\n\n初めまして！\n個人Vtuberとして活動している、ねこたぬきと申します。\nぜひ私ねこたぬきを描いていただきたくリクエストを送らせていただきました！\n\n■内容\n\n七夕をイメージした、織姫様なねこたぬきを描いていただきたいです！\n\n表情や構図などはおまかせいたします！\n露草様の描く作品はどれもお召し物もとっても素敵なので、\nできれば衣装も織姫様のようなものを着せて頂けるととっても嬉しいです！\n頭部が見切れないよう描いて頂きたいです！\n\n▲現在ねこたぬきは髪型が２種類あり、\n今回露草様に描いていただきたいのは「ショートヘア」の方になります！\n\n【使用用途】\n・サムネイルや動画内、SNS、アイコン、バナーなどでの利用\n・メッセージ等を入れてネットプリントでの期間限定の配布(メンバーシップ加入者様限定にする場合もあり)\n・メンバーシップ加入者様向けに配布する壁紙\n作品のイメージを損なわない程度の軽微な加工(例；色調補正やトリミングなど)をご許可頂きたいです！\n\n上記使用用途が難しい場合、大変お手数ですがキャンセルしていただけますと幸いです。\n\n背景や前景を描いて頂ける場合は、人物を分けてPSDデータにて納品して頂けると嬉しいです！\n\nご検討よろしくお願い致します！\n\nお誕生日、おめでとうございます！！\n露草様にとって素敵な一年になりますように🌠\n\n■ねこたぬきについて\nhttps://lit.link/nekotanuki\n■新髪型(ショートヘア)お披露目時の配信アーカイブ\nhttps://www.youtube.com/live/Je-UPgNmOwU?si=G_UF9e0HuEXuqu8W\n■資料\nhttps://x.com/nekotanuki6/status/1739375158715179098?s=20", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2yu93salt/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1153209, "client_id": 3182651, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf3a4343/uploads/origins/e370bbe4-39f6-4d47-8259-1e77455ed57a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6053103c09ce467b317a60fdd6d1dca", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf3a4343/uploads/origins/e370bbe4-39f6-4d47-8259-1e77455ed57a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42f6c17c98f1833c1c41dc5b36245051", "src_set": ""}, "body": "お誕生日おめでとうございます！\n是非リクエストさせて下さい！\n\n紅眼で銀髪サラサラストレートロングな美青年を描いて頂きたいです。\n衣装は和風でも洋風でも何でも構いません。\n耳に何か装飾品があると嬉しいです。\nイメージカラーは紅・白・黒・金・銀。(参考程度で。他の色でもOK)\nNGは眼鏡。\n他は全てお任せします。\nお好きなように描いて頂けたらと思います。\n\n露草さんの長髪美青年が大好きなんです…！\nご都合あいましたら宜しくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2yu93salt/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1153209, "client_id": 299971, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/99b9d467/uploads/origins/de325ba2-4a3e-48c1-9847-4d2784696ba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d088a80190e406a79af03294da1854f1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99b9d467/uploads/origins/de325ba2-4a3e-48c1-9847-4d2784696ba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f97fe392fae9f5f3becd6b3880706ac", "src_set": ""}, "body": "初めまして、こんにちは！\nもしよろしければ私のオリジナルキャラクター Yutaくんを描いていただけますか？\n可愛い見た目をしていますが、ヴィジュアル系バンドマンの男性キャラクターです。\nhttps://toyhou.se/17623732.yuta\n\n喜怒哀楽の表情が豊かなキャラクターで、個人的にも色々な表情の彼を見たいと思いますので、どのような表情でも大丈夫です！\n\n納品については、可能な限り宛名/背景/キャラクターなどが全て分けられたpsdファイルがあると嬉しいです。\n\n構図やテーマなどは全ておまかせしますので、お好きなように描いてください。\nもし可能でしたら全身見切れないように描いていただきたいのですが、こちらは可能な限りで大丈夫です。\n必要に応じて、Yutaのバンドメンバーで高校の後輩であるボーカリストDelyを一緒に描いても良いですよ。\nhttps://toyhou.se/10748217.dely\n\nよろしくお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2yu93salt/works/1", "private_thumbnail_image_ur