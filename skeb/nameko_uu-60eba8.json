&blur=200&s=32505e93f0b10b11d9d318db8357a4c1, https://si.imgix.net/f0d4c827/uploads/origins/409780aa-f671-4626-b37b-7f4bbd2cfab5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b2ada5d0ea4e755eb0c8ad51b9ff0dd5 2x, https://si.imgix.net/f0d4c827/uploads/origins/409780aa-f671-4626-b37b-7f4bbd2cfab5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=85a2dbb2216ee2b8474bcaca0ff11379 3x"}, "body": "ナメコさん、こんにちは！(˶˃ ᵕ ˂˶) .ᐟ.ᐟ\n\n私のオリジナルキャラクター（OC）であるクリスと、友人のOCであるトムチッチくんを一緒に描いたイラストを作成していただけないでしょうか？クリスの参考画像は、添付のURLにあります。 私が思い描いているのは、クリスとトムチッチくんが隣り合って浮かんでいる姿です。トムチッチくんは太陽をイメージした服を着ていて、クリスは月をイメージしたゆったりとした服とショートパンツを着ているイメージです。クリスには、トムチッチくんの目を見つめながら、恥ずかしそうな表情をしてほしいです。 トムチクくんについては、クリスを抱きしめるように両手を広げながら、嬉しそうな表情をしてくれると嬉しいです。\n\nこちらがトムチクくんの参考画像です！ https://x.com/Object_TOFU/status/1939491440624894053/photo/1\n\n衣装やポーズの参考としてこの画像も活用していただけると嬉しいです。ただし、全体の構図についてはお任せします！\nhttps://dthezntil550i.cloudfront.net/2v/latest/2v1905141038443350002470424/c5ea3837-2d30-4dd2-b62c-27d9ee0e8b93.png\n\nhttps://vsona.vgen.co/kris-11/beachwear/gallery/coastal-happiness/c2968c87-b740-4d5f-9392-88cb57de8cb9", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nameko_uu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2238717, "client_id": 2786464, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce64614c/uploads/origins/36db04d8-7481-4f3b-93fe-3b8dfde93de6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=890e1d3665e89d12269b103702da2696", "srcset": "https://si.imgix.net/ce64614c/uploads/origins/36db04d8-7481-4f3b-93fe-3b8dfde93de6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=890e1d3665e89d12269b103702da2696, https://si.imgix.net/ce64614c/uploads/origins/36db04d8-7481-4f3b-93fe-3b8dfde93de6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop