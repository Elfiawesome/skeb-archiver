画像\nhttps://drive.google.com/drive/folders/1OuxkGjJKarcQ5C9RSwP3NGdfksMRfhNy?usp=drive_link\n※ユダピィの顔は魂（実写）も参考にしてもらえると嬉しいです。（イメージ画像内にあります）\n※参考までに弟のユダは姉に甘えまくる性格で、姉のマアカも弟を可愛がっています。\n※二人とも街に来た初日にテキーラを飲んだり、お酒を飲みながら働きたいと言うなどお酒好きです。\n\n◆納品形式\nPSD形式で、人物とその他のレイヤーを分けていただけますと幸いです。\n可能でしたら、キャラクターだけの背景透過データ（png)も頂けるとありがたいです。\n\n是非、検討していただければ幸いです。\nよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miromaru_neko/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2314643, "client_id": 2487209, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/830abebf/uploads/origins/1b739b35-8df2-451c-9bcb-06cc102f4eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05351cc7a8f6d52d778f72dcc877b43c", "srcset": "https://si.imgix.net/830abebf/uploads/origins/1b739b35-8df2-451c-9bcb-06cc102f4eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05351cc7a8f6d52d778f72dcc877b43c, https://si.imgix.net/830abebf/uploads/origins/1b739b35-8df2-451c-9bcb-06cc102f4eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24643c83620907bdca827a7724cd4421 2x, https://si.imgix.net/830abebf/uploads/origins/1b739b35-8df2-451c-9bcb-06cc102f4eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=741c288a4fc57bd7a91fa66a5652bfdf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/830abebf/uploads/origins/1b739b35-8df2-451c-9bcb-06cc102f4eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e338b0be61416df36f0633c7d89ede6", "srcset": "https://si.imgix.net/830abebf/uploads/origins/1b739b35-8df2-451c-9bcb-06cc102f4eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e338b0be61416df36f0633c7d89ede6, https://si.imgix.net/830abebf/uploads/ori