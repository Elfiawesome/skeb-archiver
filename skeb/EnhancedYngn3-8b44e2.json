imgix.net/2ae25f3b/uploads/origins/74b40487-8f97-429f-88d7-b8bca00489a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4037d093dd9289b4201f0d4633a2d74 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ae25f3b/uploads/origins/74b40487-8f97-429f-88d7-b8bca00489a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb2022d37a5b1a57654fadcaac05dfa8", "srcset": "https://si.imgix.net/2ae25f3b/uploads/origins/74b40487-8f97-429f-88d7-b8bca00489a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb2022d37a5b1a57654fadcaac05dfa8, https://si.imgix.net/2ae25f3b/uploads/origins/74b40487-8f97-429f-88d7-b8bca00489a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=deaf5ba183461cef969236d4205b06d6 2x, https://si.imgix.net/2ae25f3b/uploads/origins/74b40487-8f97-429f-88d7-b8bca00489a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=82bd2fcfd5cf3fb48816a901818ada66 3x"}, "body": "しゅま子の首姦をリクエストした者ですが、\nskebにてまたリクエストさせていただきます。\n\nお題\n「ゲスト出演のデュラハンお嬢様に自分の体を首姦用オナホとしてコキ捨ててもらう」\n\nキャラクター\n・ふたなりしゅま子\nhttps://www.pixiv.net/artworks/108495523#manga\n・ふたなりデュラハンお嬢様\nhttps://www.pixiv.net/artworks/90442350\n\n衣装\n手袋フェチのため今回も白手袋ニーソのおそろでお願いします\nhttps://www.pixiv.net/artworks/108495523#manga\n\nイラスト構成(カラー1枚)\n・机の上で仰向けに寝ているしゅま子の喉にデュラハンさんが極太チンポを挿入して射精\n・しゅま子の体は手足をバタつかせて痙攣して、お漏らししている\n・デュラハンお嬢様の体はしゅま子の体に覆い被さって、両手でしゅま子のチンポをしごきながらカリ部分まで自分の食道に挿入し首姦している(69の首姦ver.的な感じ)\n首姦参考https://www.dropbox.com/sh/o5pu5t017c234kk/AAABOQrq3tpdsOAIzn4mKBvia?dl=0\n・しゅま子も射精して、デュラハンさんの断面から精液が漏れ出ている(興奮のせいか、断面から出血もしている)\n・体同士が首姦している傍らでしゅま子の頭が恍惚の表情になっている(意識あり)\n・全体アングルはデュラハンさん側の断面(しゅま子のチンポを首姦する様子)が見えるアングルでお願いします(斜め45°くらい)\nアングル参考 https://www.pixiv.net/artworks/107181917\n・余力があれば、別の小さいコマでしゅま子側の断面描写(デュラハンさんのチンポを首姦する様子)もあると嬉しいです\n\n背景\nしゅま子は前回のセルフ首姦に成功してまもなく、頭だけでなく体側の首姦願望も目覚めてしまう。\n→薬をもらっていたデュラハンさんに配信動画のゲストとして自分の体を首姦してくれないかを依頼。\n→デュラハンさんは困惑するものの、顔出し無し(体のみ)の出演なら大丈夫と渋々承諾。\n→デュラハンさんも本番では乗り気になり、しゅま子のチンポを首姦してあげる「首姦69プレイ」をサービス。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@EnhancedYngn3/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3a3bedf7/uploads/origins/f0286cb8-3810-4b29-8892-3ed3a9086cea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fdf704dc46291ab87e845e254e0cf6ce", "srcset": "https://si.imgix.net/3a3bedf7/uploads/origins/f0286cb8-3810-4b29-8892-3ed3a9086cea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fdf704dc46291ab87e845e254e0cf6ce, https://si.imgix.net/3a3bedf7/uploads/origins/f0286cb8-3810-4b29-8892-3ed3a9086cea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e50d4afe063f06ec19b68b94dabf6b45 2x, https://si.imgix.net/3a3bedf7/uploads/origins/f0286cb8-3810-4b29-8892-3ed3a9086cea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=628dc632e66d7338782c64aecbe199d0 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 797756, "client_id": 1405352, "nc": 34}, {"path": "/@EnhancedYngn3/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 797756, "client_id": 339826, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d139816/uploads/origins/246700ae-59c8-4fea-8f79-8fef618b8a30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fa0cd86df603a040b21d7508e33f835", "srcset": "https://si.imgix.net/3d139816/uploads/origins/246700ae-59c8-4fea-8f79-8fef618b8a30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fa0cd86df603a040b21d7508e33f835, https://si.imgix.net/3d139816/uploads/origins/246700ae-59c8-4fea-8f79-8fef618b8a30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b69604bf2c90c3e471d7a52211b884c3 2x, https://si.imgix.net/3d139816/uploads/origins/246700ae-59c8-4fea-8f79-8fef618b8a30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56b80a3562acf64f399b1c30e677d960 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d139816/uploads/origins/246700ae-59c8-4fea-8f79-8fef618b8a30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4308dc11d9fa8936193385d72eca00c8", "srcset": "https://si.imgix.net/3d139816/uploads/origins/246700ae-59c8-4fea-8f79-8fef618b8a30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4308dc11d9fa8936193385d72eca00c8, https://si.imgix.net/3d139816/uploads/origins/246700ae-59c8-4fea-8f79-8fef618b8a30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ea48b1b3bbc9b7b97f735dc38951273 2x, https://si.imgix.net/3d139816/uploads/origins/246700ae-59c8-4fea-8f79-8fef618b8a30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=be076e642a77d83a7a950d692925af1e 3x"}, "body": "「妊娠している双子のロリビッチがパルヴァライザー（https://www.pixiv.net/artworks/90922039）的なすり潰しプレイをして、ぐちゃぐちゃになったものをお互いにぶっかけあって、全身血と精子と肉片ドロドロで抱き合いながらカメラ目線で記念撮影する」\nというシナリオをお題として、この中のお好きなシーンを描いてください。\n\n希望条件\n・ペドではなく、胸が少し膨らんでいるくらいの少女な感じでお願いします。\n・男優役はふたなり少女かふたなりお姉さんでお願いします。ただし、そのことが描写されている必要はありません（要は、男性だとかかれなければ OK）。\n・女の子はプレイのヤバさを理解しているものとし、一方もしくは両方がいたずらっぽく男優役を誘いながら行為に及んでいる、という想定でお願いします。\n・ちんちん  1 本をふたりで使い回すか、2 本でそれぞれプレイするのかは問いません。お好みで設定いただけたらと思います。\n・体位・構図、その他の状況の詳細等はお任せいたします。", "nc": 186, "word_count": 0, "