&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c4211bb35eb5775a0ffde8a6d29426c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 797756, "nc": 178}, {"path": "/@EnhancedYngn3/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 797756, "client_id": 302960, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5010268/requests/200642_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b60491f6b35ffec2588896a44989071", "srcset": "https://si.imgix.net/c5010268/requests/200642_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b60491f6b35ffec2588896a44989071, https://si.imgix.net/c5010268/requests/200642_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=477cd9c8e8c1c95cee73ea311b79c85a 2x, https://si.imgix.net/c5010268/requests/200642_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=949feaf9db3d572243a2c9c1a4e0f48c 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5010268/requests/200642_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c6d820418fab1a5dc4d2328a968f22a", "srcset": "https://si.imgix.net/c5010268/requests/200642_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c6d820418fab1a5dc4d2328a968f22a, https://si.imgix.net/c5010268/requests/200642_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e565d84d6ef676d01d966272e888dba5 2x, https://si.imgix.net/c5010268/requests/200642_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=23f623b9066771d93c17d94b63941969 3x"}, "body": "今回はキャンペーンということでSkebからお願いします。\nよな様の絵柄で自分のフェチポイント抑えた\nエログロを見たいと思いリクエストします。\n\n＜キャラクタ＞\n後述のシチュエーションと自分が分かる作品、\nよな様がカバーされている作品から似合うキャラとして\n「氏家むつみ（デレステ）」をお願いします。\nむずしそうであれば内容に似合いそうな\n同じような雰囲気年格好のオリキャラで大丈夫です。\n\n＜リクエスト概要＞\nまずお願いしたいと思っているフェチポイントは\n「尻背中フェチ・下顎残し頭部破壊・快楽探求エログロ」です。\nプレイ内容の参考例として他の方にお頼みしたSkebで\nhttps://skeb.jp/@zenokaiza/works/8\nこのように触手に貫かれ下顎残しで頭部破壊されるエログロを。\nこの展開をhttps://twitter.com/momotaaai/status/1309163162944626691\nこのような背中お尻重視の構図でお願いします。\n（基本的にこの構図での差分展開で）\n「快楽探求エログロ」の部分として\n冒険好きのむつみちゃんが探求心の赴くまま触手プレイに臨み\n最高の快楽を探求、絶頂のなか頭部破壊される展開になります。\n香帆子ちゃん脳姦のようにふきだしセリフでお願いします。\n\n＜展開の詳細＞\n構図例のポーズで触手に挿入される直前。\n触手の拘束感は無くむつみが求めている感じ。\nむつみは期待感に目を輝かせ催促して尻を摺り付け、\n「触手さんお願いします」と。\n次にプレイ最中、最高の笑顔で楽しみながら\n「これはまさに未知の快楽です」と実況交じりによがり声をあげる。\nそして大量射精されてイクイク連呼。\n胴体は不自然に膨らみ口から逆流もしているが快楽しか感じていない。\n触手はむつみに「これ以上は多分身体が持たない」と伝えるが、\nむつみは「あと少しで最高の快楽を発見できそう、冒険続行です！」と。\nそして最高の絶頂感と全能感にキラキラとした表情で\nイクイクと絶頂を実況しているが、唐突に声が途切れ\n触手が貫通し下顎残しで頭部（顔面）破壊される。\n（後頭部は破壊が少なく三つ編みは無事）\n腹も破裂し内臓はぶちまけられている。\n最期まで快感しか感じずに逝った感じで、触手側は「忠告したのに」という感じ。\n\n細部の調整はお任せします。よろしくお願いします！", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 19555, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "是乃＠例大祭A06ab", "screen_name": "zenokaiza", "avatar_url": "https://pbs.twimg.com/profile_images/1183001995994513409/B02EYJpb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/33904919/1575835099/1500x500", "appeal_receivable": false, "popular_creator_rank": 90, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 33}, {"id": 43688, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "cocco", "screen_name": "cocco1192", "avatar_url": "https://pbs.twimg.com/profile_images/2041775696880791556/rwV_jx5p.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1465841705912274945/16550