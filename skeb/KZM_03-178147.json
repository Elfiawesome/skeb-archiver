m=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62af5486395905b7d59241c7952b58e2 2x, https://si.imgix.net/013a5512/uploads/origins/c5655ecb-2898-4f26-ad38-fe5a697c1487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abcdab2a60ba5e36c6d97e8255b5716d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/013a5512/uploads/origins/c5655ecb-2898-4f26-ad38-fe5a697c1487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a15b245fd88bb58bed1905c1698da8f2", "srcset": "https://si.imgix.net/013a5512/uploads/origins/c5655ecb-2898-4f26-ad38-fe5a697c1487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a15b245fd88bb58bed1905c1698da8f2, https://si.imgix.net/013a5512/uploads/origins/c5655ecb-2898-4f26-ad38-fe5a697c1487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0b4d735bbfe894d8de60c45105aa1ab1 2x, https://si.imgix.net/013a5512/uploads/origins/c5655ecb-2898-4f26-ad38-fe5a697c1487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a7dc2ea0e2850bf8695155cce41ebe97 3x"}, "body": "こんにちは、私のOCである「Roze」を描いて頂きたく思います。特に決まったポーズはなく、笑っていて足が見えているような感じです。ソファに寝そべっているような感じです。爪が見えている場合はピンクに塗ってください。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1_fEEIudCHcg0jc9Qc-ihGEz0q2zEeur3?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KZM_03/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 371877, "client_id": 506279, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c60722c/uploads/origins/46992443-3cf9-4f37-baf4-68e40f2a78f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8c667567186455cfa26f024be6c021c", "srcset": "https://si.imgix.net/8c60722c/uploads/origins/46992443-3cf9-4f37-baf4-68e40f2a78f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8c667567186455cfa26f024be6c021c, https://si.imgix.net/8c60722c/uploads/origins/46992443-3cf9-4f37-baf4-68e40f2a78f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9faf72fc5324dbc164750286e9123bd4 2x, https://si.imgix.net/8c60722c/uploads/origins/46992443-3cf9-4f37-baf4-68e40f2a78f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6820179f16e58d2359e171ec76fbcd9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c60722c/uploads/origins/46992443-3cf9-4f37-baf4-68e40f2a78f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eba5235a57df086d142b5a16e4c28cf2", "srcset": "https://si.imgix.net/8c60722c/uploads/origins/46992443-3cf9-4f37-baf4-68e40f2a78f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eba5235a57df086d142b5a16e4c28cf2, https://si.imgix.net/8c60722c/uploads/origins/46992443-3cf9-4f37-baf4-68e40f2a78f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d0f6393b1a5a46765f59f2b84744a4ac 2x, https://si.imgix.net/8c60722c/uploads/origins/46992443-3cf9-4f37-baf4-68e40f2a78f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=44b9f2aa1b15b5f088c056f985c0421a 3x"}, "body": "KZM先生こんにちは。巨大な女の子の絵をお願いしたいです。変だと思われたらご遠慮なくボツにしてください。\n\n視点（主な参照）：\n全体的に、先生のこのすごい絵を描いてくれたのと本当に似ています：\ni.imgur.com/g5x5Bvz.png\n遠近感が強くなるように、足と小人の近く（遠近感が強い）にあります。足の細部や微妙な動きもはっきりと見えている。\ni.imgur.com/yyFlRdw.png\n\nキャラ（素足、できるだけロリっぽい感じがいいです）：\n\n巨大娘：\n服はすごく薄くて軽いです。上品でありながら子供っぽいです。カジュアルでリラックスした感じ。袖にエビのようなマスコットがついています。\n参照：imgur.com/a/M0DHyIu\n\n小人x2（蟻サイズ）：\n白．赤髪の子\n髪（浮いています）や服を自由に操ることができる（服はちょっと液体と菌みたい）髪にある黒い線はドレスの目玉付近の線と同じようなひび割れです。服の目玉が本当に丸いんです。ひび割はまるでポータルのように深く見える。\n参照：\nimgur.com/a/rOp72Kb\n\nシナリオ：\n巨大娘は机や水槽の縁に足をかけて休んでいる。小さな子が2人、足の裏に登っています。一人は足指の腹の上にいます。もう一人はつま先の隙間に到達しようとしている。\n\n巨大娘は無邪気で優しい笑顔をしています。足の指をくねらせて、小さな子たちが登りにくくなるようにしているのだ。同時に、足の指を広げて、小さな女の子がつま先の隙間に到達したら、彼女達を掴もうと準備しているのです。\n\n差分：\n2バージョン欲しいです。一つは小さな子達がまだ登っていて、巨大娘がつま先をくねらせながら微笑んでいるものです。\nもう一つ：足の指がすでに小さな子達を掴んでいる。小さな子達は足の指の間でもめている。\n巨大娘が口を開けて、たぶん片目を閉じて笑んでいるものです。\n\n細部：\n足裏には数学の数式が書いてあるかもしれません。\n\n数学：\nimgur.com/a/hZOejOT\n\n足、遠近感（必ずしも有用ではない）：\nimgur.com/a/WlZjTWm\n\n\nもし受け入れればサインと宛名入りがどうしても欲しいです、可能であればレイヤー結合しないpsdとラフもお願いできますか？\nどうもありがとうございます！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 212024, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "あみみ", "screen_name": "mdenamimi", "avatar_url": "https://pbs.twimg.com/profile_images/1279985272050999296/65P2IJhY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/17152334/1660439111/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 1585374, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "乱翠", "screen_name": "ransui_s", "avatar_url": "https://pbs.twimg.com/profile_images/1935493327870189568/TBp64RQR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1444286844091265026/1745807842/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 1755942, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "白あみ", "screen_name": "armies_soul", "avatar_url": "https://pbs.twimg.com/profile_images/1467731521767280641/7n4b9tC-.jpg", "header_url": "https://pbs.twimg.