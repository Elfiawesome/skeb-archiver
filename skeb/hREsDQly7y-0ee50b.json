25ff0/uploads/origins/81c2fce2-1448-4d8b-9575-8e9efad6b8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=608e0378acaa007b108934f2da2be38a", "srcset": "https://si.imgix.net/88025ff0/uploads/origins/81c2fce2-1448-4d8b-9575-8e9efad6b8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=608e0378acaa007b108934f2da2be38a, https://si.imgix.net/88025ff0/uploads/origins/81c2fce2-1448-4d8b-9575-8e9efad6b8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec656962e52c5e57570a7fdc713f4480 2x, https://si.imgix.net/88025ff0/uploads/origins/81c2fce2-1448-4d8b-9575-8e9efad6b8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=de9b436177bf33c48460281149ff71d0 3x"}, "body": "マイ・バレンタインがバイザー・デスとバイザー・ショックに捕まっている3ページの漫画が欲しいです。バトルシティ編で着ていた衣装でお願いします。胸が大きくて、谷間があるのがいいです。漫画では、彼女がモンスターに捕まっているコマが多いのですが、捕まってはいません。\nこれは最近依頼した作品で、私のファンです。あなたの素晴らしいアートスタイルも欲しいわ。\n\nhttps://skeb.jp/@mpon_/works/42\n\n最初のコマは、モンスターが彼女に突進してくるところと、罠がどのように彼女を捕らえるかを詳しく示すページにしてほしい。手錠が彼女の手首と足首を掴み、やがて真ん中の部分が彼女の腰を掴み、彼女の豊かな胸が見える。次のページでは、彼女がショックを受け、そしてなすすべもなく捕らえられる様子を見せることができる。値段の範囲内なら、後ろからのアングル。そしてショックの余波の全身ショット。原作漫画のそれが本当に好きだった。\n\nマンガコミッション参照：\n https://skeb.jp/@mpon_/works/42\n\nマイ・リファレンス\nhttps://skeb.jp/@yagamiTSR/works/\nhttps://skeb.jp/@APRiCOT_m3/works/35\nhttps://skeb.jp/@warukuriboo/works/32\n\n似ている追加コンテンツ：\nhttps://www.pixiv.net/en/artworks/112521985", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hREsDQly7y/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2137967, "client_id": 1777748, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b14026d/uploads/origins/3dfd150b-e93d-4f87-bbd2-c77ecdb33675?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f83b75e7e1f7cbed63e3cbde8f8765fc", "srcset": "https://si.imgix.ne