eb18b5bcbd5637dd9503618 2x, https://si.imgix.net/40748d15/uploads/origins/3b19479c-5c94-4284-81bc-08014789a2f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08549b6095846f200f76d20b60c3a6f0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40748d15/uploads/origins/3b19479c-5c94-4284-81bc-08014789a2f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7a14adade25466ff9640dbab2537295", "srcset": "https://si.imgix.net/40748d15/uploads/origins/3b19479c-5c94-4284-81bc-08014789a2f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7a14adade25466ff9640dbab2537295, https://si.imgix.net/40748d15/uploads/origins/3b19479c-5c94-4284-81bc-08014789a2f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0aa740c695726f07626a9790b8f484b5 2x, https://si.imgix.net/40748d15/uploads/origins/3b19479c-5c94-4284-81bc-08014789a2f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed16ee5a99b66cd4dee606f899f0b51c 3x"}, "body": "がぶりえる様こんにちは。今回のリクエストですが、もうすぐムサシセレナの誕生から1年ということで初期のストーリーで描かれていなかった部分をお願いしたいです！\n\n具体的には\n①悪の世界でしか生きられないと洗脳されたセレナが、ここからさらにロケット団としてふさわしい姿にならなければならないと暗示をかけられる（＝新たなムサシとして覚醒しなければならない）\n②ロケット団女下っ端からロングブーツにグローブ、Rマークの服を受け取り着替える。そしてあの特徴的な髪型になりムサシセレナが完成。下っ端から「美しいお姿ですわムサシ様」と言われ、セレナは満足げに高笑いをする...\n\n今回はエロよりも悪堕ち的な変化を重視って感じですかね。\n時系列が前後しますが、よろしくお願いします！", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hREsDQly7y/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2137967, "client_id": 1166106, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae877910/uploads/origins/51b0e388-f1ca-49b6-a48f-27c1cef869e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b50d80fc4b16eaa15b12686347390d2a", "srcset": "https://si.imgix.net/ae877910/uploads/origins/51b0e388-f1ca-49b6-a48f-27c1cef869e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b50d80fc4b16eaa15b12686347390d2a, https://si.imgix.net/ae877910/uploads/origins/51b0e388-f1ca-49b6-a48f-27c1cef869e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9b436f507cb3b4dcb84cf97505f7d93 2x, https://si.imgix.net/ae877910/uploads/origins/51b0e388-f1ca-49b6-a48f-27c1cef869e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08fb8a5c006964978d7486c874a3b520 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae877910/uploads/origins/51b0e388-f1ca-49b6-a48f-27c1cef869e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0114b5bef0ecc6f7bd93acaa676255d2", "srcset": "https://si.imgix.net/ae877910/uploads/origins/51b0e388-f1ca-49b6-a48f-27c1cef869e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0114b5bef0ecc6f7bd93acaa676255d2, https://si.imgix.net/ae877910/uploads/origins/51b0e388-f1ca-49b6-a48f-27c1cef869e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=17449e9e575aa436e92a513930025c1f 2x, https://si.imgix.net/ae877910/uploads/origins/51b0e388-f1ca-49b6-a48f-27c1cef869e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d05b94216c1d67458b85c31ae2a8f41 3x"}, "body": "以下内容でよろしければ、\nお受け頂ければと思います。\n\n\n【キャラクター】\n・ポケットモンスター\nシロナ\n\n【シチュエーション】\n・シロナが犯されているシーンを特別配信。他作品と同じくセリフ付き(構図はお任せだが胸が隠れない感じで)\n　・配信者はロケット団。配信先は幼い子どもトレーナーたち。〇〇歳以下の子どものスマホロトムに強制配信しているイメージ。\n　　・人員不足/資金不足なロケット団は、子どもにまで目を付ける。\n　・セリフのメインは配信の解説者。シロナは画面先の子どもを誘惑しているような感じ。\n　　・解説者は他作品のセレナでも他でも可。\n　・チャンピオンかつ憧れのトレーナーであるシロナの裸/タプタプ揺れるオッパイ/あられもない姿を見て興奮してるでしょうと煽る。\n　・ロケット団に入ればヤレる。入らなくてもお金を払えば画像/動画を配信するという宣伝\n　　・シロナ以外の女性チャンピオン/四天王/ジムリーダーの裸、エッチな姿を見放題のような。\n　　・子ども向けなので直接的なセリフ表現。バイネームのキャラ名を適当に。\n　・最後は連絡先を示し締め。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hREsDQly7y/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2137967, "client_id": 1777748, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/688473f6/uploads/origins/9388eac0-3d3c-4805-95b1-67baf30925bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3510501694908725a35803a701f4c552", "srcset": "https://si.imgix.net/688473f6/uploads/origins/9388eac0-3d3c-4805-95b1-67baf30925bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3510501694908725a35803a701f4c552, https://si.imgix.net/688473f6/uploads/origins/9388eac0-3d3c-4805-95b1-67baf30925bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2bebf791f042ff58e500b680d3560ce7 2x, https://si.imgix.net/688473f6/uploads/origins/9388eac0-3d3c-4805-95b1-67baf30925bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3079f5fb639cdc4b9f7a11005165ca7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/688473f6/uploads/origins/9388eac0-3d3c-4805-95b1-67baf30925bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab42d9a9f9013a86238582675c33efb9", "srcset": "https://si.imgix.net/688473f6/uploads/origins/9388eac0-3d3c-4805-95b1-67baf30925bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab42d9a9f9013a86238582675c33efb9, https://si.imgix.net/688473f6/uploads/origins/9388eac0-3d3c-4805-95b1-67baf30925bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c1473404ca2371b513a03f6696099a9 2x, https://si.imgix.net/688473f6/uploads/origins/9388eac0-3d3c-4805-95b1-67baf30925bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5dbba31a2cc42d340667dfd1c33ac503 3x"}, "body": "がぶりえる様こんにちは。\n今回のリクエストはポケモンのナツメをお願いします。\nナツメのデザインですが、メディアによって色々違うので今回はポケモンマスターズでのデザインをお願いします。\n\n内容は下記の通りです。\n\n①既に催眠にかかり、セックスをしているナツメ。エスパージムリーダーとはいえ催眠にかかってしまえばこんなものか。男が余裕の射精をしてフィニッシュ。と思われたが...？\n②果ててヘロヘロの男に対し、まだまだ物足りないナツメ。なんと、もっとエロくなるために自分自身に催眠をかけて淫乱に変化する！ナツメは自らの力でより激しく男を求め、セックスをしていくのだった。\n\nという、内容をお願いします。\n変化後のナツメですが、以前投稿されていたミモザのアフターが素晴らしかったので、あんな感じに表情が変化してアイシャドーや口紅など化粧が濃くなっていると嬉しいです。\nまた、以前のタケシ→クレオパトラ、カスミ→セイレーンのように変化後に新しい名前を付けられる描写もほしいです。(黒幕っぽい第三者が登場してナツメに命名するのが流れとしては自然ですかね...？)\nなお、①では正常位、②では騎乗位を希望です。\n\nよろしくお願いします！！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hREsDQly7y/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2137967, "client_id": 1777748, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2111cb55/uploads/origins/59996034-05ce-44bd-9429-4d7d73b61d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3bfa12162278c4543da3decb5eaaf30", "srcset": "https://si.imgix.net/2111cb55/uploads/origins/59996034-05ce-44bd-9429-4d7d73b61d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3bfa12162278c4543da3decb5eaaf30, https://si.imgix.net/2111cb55/uploads/origins/59996034-05ce-44bd-9429-4d7d73b61d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44a790974df09cdc9afa943e014b12fe 2x, https://si.imgix.net/2111cb55/uploads/origins/59996034-05ce-44bd-9429-4d7d73b61d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8da084e7d1b32a9dc40db7d3af0bd327 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2111cb55/uploads/origins/59996034-05ce-44bd-9429-4d7d73b61d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c05cad8ff0fdb156f5dd299e632012e", "srcset": "https://si.imgix.net/2111cb55/uploads/origins/59996034-05ce-44bd-9429-4d7d73b61d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c05cad8ff0fdb156f5dd299e632012e, https://si.imgix.net/2111cb55/uploads/origins/59996034-05ce-44bd-9429-4d7d73b61d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c574cd6c4650450e1e2b81eb6fe9da9a 2x, https://si.imgix.net/2111cb55/uploads/origins/59996034-05ce-44bd-9429-4d7d73b61d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ef56d2485f3c9eec261ae8898bb13b24 3x"}, "body": "がぶりえる様こんにちは。いつもお世話になります。\nムサシセレナのストーリーも段々話が大きくなっているようで、リクエストにも気合が入ります（笑）\n\n今回のリクエストでは、一時的に元に戻ったセレナをお願いしたいです。\n\n①ロケット団アジトにて目を覚ますセレナ。副官であるリーリエがやってくるが、セレナは最初に拉致されて以降の記憶がなくなっており、自分が大人の体になっていることやムサシと呼ばれる事に戸惑い、怯えます。\n\n②逃げ出すセレナだが、あえなく一般団員に捕まり、レイプされてしまう。そこで脳裏にムサシセレナの人格が話しかけてきます。\n実は記憶がなくなったというのは嘘で、かつてのセレナのファンだった団員の望みを叶えるために一時的に記憶を封印していただけということが明らかになる。絶望するセレナだが 、セレナは既に身も心もロケット団員である――\n\nといった、内容をお願いします！", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hREsDQly7y/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2137967, "client_id": 1777748, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef935fe7/uploads/origins/71f6241e-7dbd-443a-8ccf-74905172d176?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fab3ffd6cd7dbde460e29f47d74ca1d", "srcset": "https://si.imgix.net/ef935fe7/uploads/origins/71f6241e-7dbd-443a-8ccf-74905172d176?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fab3ffd6cd7dbde460e29f47d74ca1d, https://si.imgix.net/ef935fe7/uploads/origins/71f6241e-7dbd-443a-8ccf-74905172d176?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79203e2c7ac9e83f092a4dbd131ef5c9 2x, https://si.imgix.net/ef935fe7/uploads/origins/71f6241e-7dbd-443a-8ccf-74905172d176?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9cfcfbe653691ce0f1e3c481c5a8467 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef935fe7/uploads/origins/71f6241e-7dbd-443a-8ccf-74905172d176?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ff7cff33034253b707c0e4cd87c9e02", "srcset": "https://si.imgix.net/ef935fe7/uploads/origins/71f6241e-7dbd-443a-8ccf-74905172d176?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ff7cff33034253b707c0e4cd87c9e02, https://si.imgix.net/ef935fe7/uploads/origins/71f6241e-7dbd-443a-8ccf-74905172d176?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1bc9a18e28cf6de1309679b91704f5f1 2x, https://si.imgix.net/ef935fe7/uploads/origins/71f6241e-7dbd-443a-8ccf-74905172d176?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c86ad6ca1b0e5783fe6d353515de4afc 3x"}, "body": "いつもありがとうございます。\n今回はサンムーンからリーリエの洗脳をお願いしたいです！\n\nストーリーですが、\n①捕らわれたリーリエ。以前のセレナのように身体を強制的に成長させられ、脳内にもうひとりの自分の声が響き、心が悪に染まっていく。\n②ルザミーネそっくりに成長したリーリエが、ムサシセレナに忠誠を誓う。\n\n...といった内容をお願いしたいです！\nちなみに堕ちた後のリーリエですが、いつものように快楽堕ちした雌奴隷というより、優秀な副官的なイメージでお願いしたいです。（一緒に作戦立案する対等な立場といいますか、分かりにくくてすみません！）\nどうぞよろしくお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hREsDQly7y/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2137967, "client_id": 1777748, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51069ad1/uploads/origins/3b2a4238-599a-4983-aa03-7893821e41e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32b6834078d9026eca1fb9d108eea206", "srcset": "https://si.imgix.net/51069ad1/uploads/origins/3b2a4238-599a-4983-aa03-7893821e41e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=2