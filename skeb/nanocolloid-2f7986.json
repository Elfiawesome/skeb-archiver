ン\n・左目紅桜色、右目青紫色\n・身長153cm位\n・おめめパッチリかわいい系\n・声は高め、歌うことが好き\n・花とリボンが好き\n\n髪型服装構図全て自由で\nnain様の好きに描いて頂きたいです！\n\n【使用用途】\n・各種SNSへの投稿\n・配信アプリIRIAMでの利用\n・返礼品、グッズ等での使用\n\n\n【その他】\n ・可能であれば背景透過差分を頂きたいです。\n ・頭部、尻尾、羽等が見切れていないと有難いです。  \n\nお値段変更や内容など厳しい部分ありましたらキャンセルや再送要請して下さいませ...！ お忙しいとは思いますが、ご検討の程よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nanocolloid/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2649062, "client_id": 3419898, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c9df7b84/uploads/origins/1de503f9-8d55-4ffe-8d98-df92b5987932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=903463d98f552585efada1f8c8a0f50d", "srcset": "https://si.imgix.net/c9df7b84/uploads/origins/1de503f9-8d55-4ffe-8d98-df92b5987932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=903463d98f552585efada1f8c8a0f50d, https://si.imgix.net/c9df7b84/uploads/origins/1de503f9-8d55-4ffe-8d98-df92b5987932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=963c38744b405479597b80544e4064d4 2x, https://si.imgix.net/c9df7b84/uploads/origins/1de503f9-8d55-4ffe-8d98-df92b5987932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=536e176472fdad8b1d987886617ff50e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c9df7b84/uploads/origins/1de503f9-8d55-4ffe-8d98-df92b5987932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d01e957423c0ffdf114dfb04d80ff51", "srcset": "https://si.imgix.net/c9df7b84/uploads/origins/1de503f9-8d55-4ffe-8d98-df92b5987932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d01e957423c0ffdf114dfb04d80ff51, https://si.imgix.net/c9df7b84/uploads/origins/1de503f9-8d55-4ffe-8d98-df92b5987932?bg=%23fff&au