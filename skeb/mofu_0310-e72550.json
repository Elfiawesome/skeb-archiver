othsby] / 「モスビー」という名前で、いつもいたずら好きな妖精の使い魔です\n\n自由に描いてください。スタイルや構図はあなたにお任せします！胸元に焦点を当てた、キュートだけどセクシーなポーズで描いていただけると嬉しいです。服は着たまま！胸の谷間もOKです 👍\n\n注：参考シートに、私のキャラクターの「アホ毛」が2本追加されています！これと、先のとがったヘアインレット、編み込みのヘッドバンドも描いていただけると嬉しいです。よろしくお願いします！！\n\n別の表情・トグル・PSD・透明ファイル＝OKです。\n可能であれば、キャラクターのイラストと背景を別々のレイヤーに分けていただけると助かります。\n\n依頼の機会をいただき、ありがとうございます！\n\nhttps://drive.google.com/drive/u/4/folders/1qbVei8Fw7fkW4R5HHbs00iEsc39eUXIg", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mofu_0310/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3735183, "client_id": 2854555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa43e11d/uploads/origins/f491802d-f911-4584-9c37-a69ac3663f75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f36a00f1a41220624305870937d785f", "srcset": "https://si.imgix.net/fa43e11d/uploads/origins/f491802d-f911-4584-9c37-a69ac3663f75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f36a00f1a41220624305870937d785f, https://si.imgix.net/fa43e11d/uploads/origins/f491802d-f911-4584-9c37-a69ac3663f75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=beb0950a91ef67c6d29675df5aa27e83 2x, https://si.imgix.net/fa43e11d/uploads/origins/f491802d-f911-4584-9c37-a69ac3663f75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e19c3b94ce6c135c7d4ca7e57533a93 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa43e11d/uploads/origins/f491802d-f911-4584-9c37-a69ac3663f75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3171dda67f6910d8c8079dca79e689bc", "srcset": "https://si.imgix.net/fa43e11d/uploads/origins/f491802d-f911-4584-9c37-a69ac3663f75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3171dda67f6910d8