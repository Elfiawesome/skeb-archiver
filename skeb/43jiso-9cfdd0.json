rop=top&w=200&h=200&s=56865aa4585da2e1d8637b502aa85b75, https://si.imgix.net/a1494fa2/uploads/origins/1f56ed9f-481f-4602-baf1-758b56eeaecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=140ff35d2c2ce31c586bbd88ebb856c9 2x, https://si.imgix.net/a1494fa2/uploads/origins/1f56ed9f-481f-4602-baf1-758b56eeaecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46cbb5f0ea81122bd607285a0e31aac0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1494fa2/uploads/origins/1f56ed9f-481f-4602-baf1-758b56eeaecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc0cf7be8cab4a02eb4b78534771e3b8", "srcset": "https://si.imgix.net/a1494fa2/uploads/origins/1f56ed9f-481f-4602-baf1-758b56eeaecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc0cf7be8cab4a02eb4b78534771e3b8, https://si.imgix.net/a1494fa2/uploads/origins/1f56ed9f-481f-4602-baf1-758b56eeaecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=78897da675b5a371b9a75bdcd65c9f0d 2x, https://si.imgix.net/a1494fa2/uploads/origins/1f56ed9f-481f-4602-baf1-758b56eeaecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=75e7cbb10cd37aa148c47a58d5afb403 3x"}, "body": "しみじそさん、はじめまして。  \nしみじそさんの素敵なイラストをいつも楽しみに拝見しており、色彩やキャラクターの表情がとても可愛くて、いつも楽しませていただいています。  \nぜひ私の二人のオリジナルキャラクターの新しい衣装デザインを描いていただけないでしょうか？ \n\n【衣装要求】\n髪型は、一部の特徴（ショートヘア、お団子ヘア、エアインテーク）を残しつつ、自由にアレンジしていただいて構いません！衣装を自由にデザインしてください。 \n\n以下は世界観とキャラクター紹介です。\n\n 【世界観】 \n> 1990年代香港ノスタルジア × 裏世界怪談譚  \n> 近未来的な都会が混ざった世界\n\n 【キャラクター設定】 \n◆OC A: 三伏 \n13歳／145cm／金髪(ツインテールのお団子ヘア)／女性 \n瞳色：青い \n・外向的で活発な女の子。明るい\n・他人の気持ちや関係を簡単に感じ取れる\n・普段はストレートだが、好きな人にはツンデレで悪戯で気持ちを表現 \n・機械工学に興味あり  \n\n◆OC B: 代 \n14歳／152cm／緑髪／女性 \n瞳色：黄色\n・内向的で慎重な性格 \n・好きな人やことには強い決意と執着を見せる \n・幼少期に助けられた経験と実家が病院のため、他人を助けたい思いが強いです\n・医学を勉強中、本を読むことと天文学が好きです。\n\n  【関係性】 \n金髪と緑髪は幼馴染です。 \nとても小さい頃、金髪が入院した際に病院の院長の娘である緑髪と出会いました。その後、同じ小学校と中学校に通いました。 \n金髪は冒険好きで、外に出るのがあまり好きではない緑髪をよく連れ回していました。\nその過程で、二人の関係は友情からお互いの片思いへと発展しました。\n\n【使用用途】 \n個人鑑賞、snsでアイコン、ヘッダーに使用  \n※友人間での少量のグッズ交換（商用・営利目的なし）も可能性としてあります。\n\n【キャラクター参考資料】 \nhttps://drive.google.com/drive/folders/113tYHhL3QIYD_koYA0ocJrLr6bQtJhTO\n\n金額が足りない場合、再送してお願いいたします！ \nご検討のほど、どうぞよろしくお願いします！🙏", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 2094177, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "mimio_tachibana", "screen_name": "mimio_tachibana", "avatar_url": "https://pbs.twimg.com/profile_images/1898009828204912640/sF-oR8-8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1404809611690000390/1723199546/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 2771226, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "シュークリームどうぶつえん", "screen_name": "369_EW", "avatar_url": "https://pbs.twimg.com/profile_images/2039339698435588096/h98iZrrq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1494535717602557953/1763816243/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 2775016, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "おいしいあおの", "screen_name": "aonocow", "avatar_url": "https://pbs.twimg.com/profile_images/1614155977955184640/2cTGEhRP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1049935442009714688/1679194736/150