送依頼いただけますと幸いです！\nよろしくおねがいします！！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inudazo0725/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d025f144/uploads/origins/df88839f-bfc1-4ecc-a02c-a17892c1fa9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47f3c37d4e5bdb8b6de5df62cb812229", "src_set": ""}, "private": true, "genre": "comic", "tipped": true, "creator_id": 1935334, "client_id": 3376018, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@inudazo0725/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0f368e88/uploads/origins/b770998b-2181-4c45-8da6-39969394c274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0649ce2b9cd508285fb9b3fd73121f46", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1935334, "client_id": 289687, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@inudazo0725/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/83c3bfb4/uploads/origins/15f8db25-e319-4b32-9256-be1bb29e643f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6adf590de83a0edffe77d273f8167614", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 1935334, "client_id": 0,