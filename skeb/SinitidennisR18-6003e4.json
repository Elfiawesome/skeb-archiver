ュエーション\n彼のソックス足裏を見せて貰いながら見抜きしているシチュ\n下は下着のみで足裏と股間にフォーカスを当てたアングルでお願いします\n表情はドン引きした感じ、冷めた感じ、赤面した感じ等シチュエーションに合う表情をお願いします\nまた、チ○チンですが勃起して下着を突き上げている感じ(彼のキャラ的にこのシチュで勃起はしないな、という場合はチン○ンの膨らみが分かる位でお願いします)\n以上の内容になります\nご検討お願いします", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SinitidennisR18/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2372547, "client_id": 1529218, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f49b871a/uploads/origins/641578aa-7ac6-4d32-baba-6dbfd598429f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b058e80105179be1fcd8a74380148d55", "srcset": "https://si.imgix.net/f49b871a/uploads/origins/641578aa-7ac6-4d32-baba-6dbfd598429f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b058e80105179be1fcd8a74380148d55, https://si.imgix.net/f49b871a/uploads/origins/641578aa-7ac6-4d32-baba-6dbfd598429f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8547fb66f6418e6a12d02fd3e7df27f 2x, https://si.imgix.net/f49b871a/uploads/origins/641578aa-7ac6-4d32-baba-6dbfd598429f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed3389a9629aefcaf712c1d8894c73fe 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f49b871a/uploads/origins/641578aa-7ac6-4d32-baba-6dbfd598429f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99f76d6fa80f114549d80f3d02439e5f", "srcset": "https://si.imgix.net/f49b871a/uploads/origins/641578aa-7ac6-4d32-baba-6dbfd598429f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99f76d6fa80f114549d80f3d02439e5f, https://si.imgix.net/f49b871a/uploads/origins/641578aa-7ac6-4d32-baba-6dbfd598429f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7