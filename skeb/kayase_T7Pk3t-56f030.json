ルティークジラ\n- 白いそばかす、胸と顔に涙形の模様\n- 腕にパズルのピース、指にはタトゥー風の指輪がいくつか\n- チョーカーには満月が一つ、両脇に三日月が一つずつ\n- バブルティーとタピオカボールのヘアピン\n- 右腕に移植された赤ちゃんサメの標本\n- バブルティーで満たされた、つややかなクジラの尾\n\n性格：甘えん坊で陽気、少しシャイ。動物、珍しいもの、そして海が大好き。化石を探したり、バブルティーで満たされたプールでくつろいだり、ビデオゲームをして遊んでいる姿がよく見られます。\n\n【活用例】\n収益化コンテンツ（YouTubeやTwitch）、およびソーシャルメディアプラットフォーム。\n\nご検討いただき、誠にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1Lk9SVJXtMf_FPE0KT_96cMQJcwoqWd0F?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kayase_T7Pk3t/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3497237, "client_id": 3416451, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34e49406/uploads/origins/f3cde87d-1c9a-48e1-87aa-8c3636defc4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8e5a89f77889d1ec6ff065fe76bcea4", "srcset": "https://si.imgix.net/34e49406/uploads/origins/f3cde87d-1c9a-48e1-87aa-8c3636defc4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8e5a89f77889d1ec6ff065fe76bcea4, https://si.imgix.net/34e49406/uploads/origins/f3cde87d-1c9a-48e1-87aa-8c3636defc4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a304f66d630fa8f10044523834e74a4f 2x, https://si.imgix.net/34e49406/uploads/origins/f3cde87d-1c9a-48e1-87aa-8c3636defc4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7265875e31ffc9bdce3ad602a7a44823 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34e49406/uploads/origins/f3cde87d-1c9a-48e1-87aa-8c3636defc4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a37e1d58777b611c054a8a7281ccf38", "srcset": "https://si.imgix.net/34e49406/uploads/origins/f3cde87d-1c9a-48e1-87aa-8c3636defc4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a37e1