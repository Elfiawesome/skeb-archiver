re": "art", "tipped": true, "creator_id": 1540743, "client_id": 1887991, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3fa4c06c/uploads/origins/bfbb2797-dfd2-45e4-b596-2124df34a286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76e8aae622a41dbadbea8c336fd4b59c", "srcset": "https://si.imgix.net/3fa4c06c/uploads/origins/bfbb2797-dfd2-45e4-b596-2124df34a286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76e8aae622a41dbadbea8c336fd4b59c, https://si.imgix.net/3fa4c06c/uploads/origins/bfbb2797-dfd2-45e4-b596-2124df34a286?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13d56d39db46738077bb921998c37e63 2x, https://si.imgix.net/3fa4c06c/uploads/origins/bfbb2797-dfd2-45e4-b596-2124df34a286?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc648588b38a6083e41d27dace4f2d9c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3fa4c06c/uploads/origins/bfbb2797-dfd2-45e4-b596-2124df34a286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91900b19dc9a8ad8681698750efe0879", "srcset": "https://si.imgix.net/3fa4c06c/uploads/origins/bfbb2797-dfd2-45e4-b596-2124df34a286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91900b19dc9a8ad8681698750efe0879, https://si.imgix.net/3fa4c06c/uploads/origins/bfbb2797-dfd2-45e4-b596-2124df34a286?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a4664f83147dce93b89d2372c5f55c1 2x, https://si.imgix.net/3fa4c06c/uploads/origins/bfbb2797-dfd2-45e4-b596-2124df34a286?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b69083e0cb989a8a6743d8308001f2d0 3x"}, "body": "こんにちは、昨日はご丁寧にマシュマロの返信ありがとうございました！\n\n松井先生の立香ちゃんのイラストを初めて見た時から淡い色のタッチと心が暖かくなるような素敵な笑顔のイラストが大好きで依頼させて頂きました。\n\nリクエスト内容としましては、概念礼装\"春風遊歩道\"のような袴を着たFGOの藤丸立香(ぐだ子)を描いて頂きたいです。その他ポーズ等は全てお任せ致します。\n\n使用用途と致しましてはTwitterのアイコン(誰かの誹謗中傷や不適切な発言は断じて致しません)、パソコンの壁紙とスマホの壁紙に使用したいと考えております。\n\nご検討お願い致します！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haruhide_tt/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1540743, "client_id": 1446099, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/389c495f/uploads/origins/9473e203-7487-495f-a5ad-17637c5a3b07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8467d4a10ac3ab101d95cc96eeb474e9", "srcset": "https://si.imgix.net/389c495f/uploads/origins/9473e203-7487-495f-a5ad-17637c5a3b07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8467d4a10ac3ab101d95cc96eeb474e9, https://si.imgix.net/389c495f/uploads/origins/9473e203-7487-495f-a5ad-17637c5a3b07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c97024262c037dde3849ed62e907c18 2x, https://si.imgix.net/389c495f/uploads/origins/9473e203-7487-495f-a5ad-17637c5a3b07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf688adfdf4445e550c8e33ce961922d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/389c495f/uploads/origins/9473e203-7487-495f-a5ad-17637c5a3b07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=307bf4e192faa92f9c76872406362385", "srcset": "https://si.imgix.net/389c495f/uploads/origins/9473e203-7487-495f-a5ad-17637c5a3b07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=307bf4e192faa92f9c76872406362385, https://si.imgix.net/389c495f/uploads/origins/9473e203-7487-495f-a5ad-17637c5a3b07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8db8f60bb90fbc8ef331f7bf200e64c7 2x, https://si.imgix.net/389c495f/uploads/origins/9473e203-7487-495f-a5ad-17637c5a3b07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b784517364c6352d5949e03924d96706 3x"}, "body": "Hello!\n\nI would like to request BB and Hakuno (Female) on a cute date together! I would like the two girls to be wearing casual clothing and cute outfits for a date together like regular lovers. Please include BB's cute red ribbon despite her change in clothes!\n\nI'll allow you freedom for all the details of the composition, from clothing to setting. Some ideas can be BB feeding Hakuno a dessert, sitting together in a park, or walking together with their hands full of shopping bags. I am happy with any date setting, so please go with what you would enjoy drawing the most!\n\nBB References: https://imgur.com/a/mKi41VV\nHakuno References: https://imgur.com/a/yb3qrBB\n\nThank you so much for your consideration!", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haruhide_tt/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1540743, "client_id": 62494, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6394a16f/uploads/origins/ad9ae86a-e0c6-4a5a-8595-b6ec18fba816?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ef92eba0925a21ab4a336e838bd57a2", "srcset": "https://si.imgix.net/6394a16f/uploads/origins/ad9ae86a-e0c6-4a5a-8595-b6ec18fba816?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ef92eba0925a21ab4a336e838bd57a2, https://si.imgix.net/6394a16f/uploads/origins/ad9ae86a-e0c6-4a5a-8595-b6ec18fba816?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba1dd7fafa393e7f678ff9c234ad0c92 2x, https://si.imgix.net/6394a16f/uploads/origins/ad9ae86a-e0c6-4a5a-8595-b6ec18fba816?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=899c257c60c31b149731224014164f5a 3x"}, "duration": null,