どはお任せします。\n服装は添付の画像をご覧ください。黒髪の方が浴衣、白金髪の方がセーラー服ですが、二人とも体格に差はありません。\n\n■使用用途\n個人観賞です。\n探索者を知っているフォロワーに自慢もします。\n\n■サイズ\nおまかせします。\n何分イラストのリクエストが初めてですので相場を知らないです。\n\n■その他\n黒髪黒目浴衣の方です。浴衣の色は濃紺です。\nhttps://image.iaproject.app/3148063.png\n白金髪白金目セーラーの方です。\nhttps://image.iaproject.app/b6a69e43-4338-4740-9f8c-78d936f26b39\nセーラーの方のピクルーさんです。\nhttps://picrew.me/ja/image_maker/1637251\n\n資料URLに複数が載せられないので、こちらにて失礼致します。\nまた、複数キャラクターでの受付をしていない場合は、黒髪の方単体のイラストをリクエストしたいです。\nもし不足などあれば申し訳ありません。\nご検討のほどよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@isacoQ/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2404, "client_id": 57223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7723db5c/uploads/origins/bd0b7958-cedc-4819-a430-b83c7f847137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d627ee1e6cffcd537b689e43f3588231", "srcset": "https://si.imgix.net/7723db5c/uploads/origins/bd0b7958-cedc-4819-a430-b83c7f847137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d627ee1e6cffcd537b689e43f3588231, https://si.imgix.net/7723db5c/uploads/origins/bd0b7958-cedc-4819-a430-b83c7f847137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c8507824408c6a2f8f82c4ff906e99a 2x, https://si.imgix.net/7723db5c/uploads/origins/bd0b7958-cedc-4819-a430-b83c7f847137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89d270022b56de39e550e86983100b31 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7723db5c/uploads/origins/bd0b7958-cedc-4819-a430-b83c7f847137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6abc433c863d555af1080c0cc5a262c7", "srcset": "https://si.imgix.net/7723db5c/uploads/origins/bd0b7958-cedc-4819-a430-b83c7f847137?bg=%23fff&auto=format%2C