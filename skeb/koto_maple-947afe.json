緑色の短髪をした爽やかなキャラクターです(本来は芦毛、やや灰色の馬です)。血統には恵まれず周囲からの期待も高くなかったのですが、痛快な「逃げ」(最初から最後まで先頭を駆け抜けるスタイル)をもってして観衆にどよめきを与え重賞を勝ち取った馬になります。\n・外観は中学生相当、菊の髪飾りをつけ、笑顔の似合うウマ娘です。腹黒、というほどではありませんが、血統やずば抜けた身体能力に恵まれなかった代わりにあらゆる知略を張り巡らすことで、相手の得意分野を封殺し自分に有利な展開を生み出していきます(禁じ手を使うわけではなく、相手のスタミナのペース配分や得意スタイルをかき乱す、という感じです)。\n・つかみどころのない性格をしており、飄々としていて何を考えているのか、どこまで考えているのか分かりづらいキャラです。基本的にはまったりとするのが好きで日向ぼっこやお昼寝、ネコと戯れることが多く、学業や練習をサボる様子がしばしばみられます。しかし周囲にワザとそうみせている一面もあり、根っこは誰よりも負けず嫌いです。他者との交友関係は良好ですが、深いところは知られないようそれとなく距離を置くこともあります。\n・紹介が長くなってしまいましたが、上記のような魅力あふれるセイウンスカイについて、みっち様のやさしくふんわりとした絵柄で素敵な一枚を、ぜひともお願いします。\n\nhttps://umamusume.jp/sp/character/detail/?name=seiunsky", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@koto_maple/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 689450, "client_id": 1004079, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1e8b4c9/uploads/origins/a4cb63f3-9888-42ea-b948-0e162233d782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=756bf1b6413d086b224307e58d169166", "srcset": "https://si.imgix.net/c1e8b4c9/uploads/origins/a4cb63f3-9888-42ea-b948-0e162233d782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=756bf1b6413d086b224307e58d169166, https://si.imgix.net/c1e8b4c9/uploads/origins/a4cb63f3-9888-42ea-b948-0e162233d782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a60ec59b3841c43439dc29487ac303f1 2x, https://si.imgix.net/c1e8b4c9/uploads/origins/a4cb63f3-9888-42ea-b948-0e162233d782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=966807552af7895c0eef4b8ef1e50c4c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1e8b4c9/uploads/origins/a4cb63f3-9888-42ea-b948-0e162233d782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d80