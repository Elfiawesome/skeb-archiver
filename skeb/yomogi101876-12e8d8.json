d8-45b0e3770071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3916da2f62015fbfd82d8cd6a0aa3a1d", "srcset": "https://si.imgix.net/426fab18/uploads/origins/7f12496e-373a-4f7c-bfd8-45b0e3770071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3916da2f62015fbfd82d8cd6a0aa3a1d, https://si.imgix.net/426fab18/uploads/origins/7f12496e-373a-4f7c-bfd8-45b0e3770071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=070800cf6e5ca161e530f8d30371769c 2x, https://si.imgix.net/426fab18/uploads/origins/7f12496e-373a-4f7c-bfd8-45b0e3770071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c6256169996ca58e4cfcefc9d9b01a3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/426fab18/uploads/origins/7f12496e-373a-4f7c-bfd8-45b0e3770071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=892e4c94b053c1f7f9e77a0f7fd7eab9", "srcset": "https://si.imgix.net/426fab18/uploads/origins/7f12496e-373a-4f7c-bfd8-45b0e3770071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=892e4c94b053c1f7f9e77a0f7fd7eab9, https://si.imgix.net/426fab18/uploads/origins/7f12496e-373a-4f7c-bfd8-45b0e3770071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a18079aa3d7715f7425681bb47752f50 2x, https://si.imgix.net/426fab18/uploads/origins/7f12496e-373a-4f7c-bfd8-45b0e3770071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=88565b531712587a477b03fe924db62d 3x"}, "body": "よもぎ様\n\nvtuber準備中の牛使メイと申します。\nXでskeb募集中のポストを見かけ、詰め込みイラストがとても可愛らしく、活動で使用させていただきたいと思ったので、リクエストを送らせていただきました。\n\n【キャラクター】\n牛使メイ(ushitsukamei)\nモチーフ：牛、メイド\n色：緑、白、黒\n\n【キャラクター資料】\nhttps://x.com/ushitsukamei/status/2022596997958733989\n\n【内容】\n・ポーズ、構図、表情、服装、髪型等全てお任せ致します。\n服装と髪型は、資料通りでも本人と分かる範囲でご自由にアレンジしていただいても問題ございません。\n描きやすいようにしていただければ幸いです。\n\n【使用用途】\n・収益化YouTubeチャンネルでの使用（配信内、動画内、サムネイル等）\n・ネットプリント\n・商用グッズ\n・SNS利用\nなどvtuber活動全般で使用させていただきたいです。\n\n【希望納品形式】\n可能であればPSD、\nまたは背景やキャラクター等を別々にしたPNGファイルで頂きたいです。\n\nこちらの条件で問題ない場合は、お受けいただけたら嬉しいです。\nご検討、どうぞよろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomogi101876/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3846960, "client_id": 2774997, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7130062/uploads/origins/9628c2a4-be05-4ece-9785-25be35584e53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fb751dedb9cf1ab0b1146b28e8e696d", "srcset": "https://si.imgix.net/b7130062/uploads/origins/9628c2a4-be05-4ece-9785-25be35584e53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fb751dedb9cf1ab0b1146b28e8e696d, https://si.imgix.net/b7130062/uploads/origins/9628c2a4-be05-4ece-9785-25be35584e53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=076e4fad32c672ba73363c3e24086756 2x, https://si.imgix.net/b7130062/uploads/origins/9628c2a4-be05-4ece-9785-25be35584e53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8292f170d6971e059438ecf3582c3559 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7130062/uploads/origins/9628c2a4-be05-4ece-9785-25be35584e53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b82e337f6f27baf8878a375e46aa0173", "srcset": "https://si.imgix.net/b7130062/uploads/origins/9628c2a4-be05-4ece-9785-25be35584e53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b82e337f6f27baf8878a375e46aa0173, https://si.imgix.net/b7130062/uploads/origins/9628c2a4-be05-4ece-9785-25be35584e53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2fb57e7ca5d1