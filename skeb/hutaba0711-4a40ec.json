としての使用、およびVTuberの収益化されたTwitch配信画面、サムネイル、おはようV、おやすみV、スケジュール、OP・ED制作などの二次利用が可能で、上記のような配信活動に使用できると大変嬉しいです。 \nまた、実際の抱き枕の個人所有用制作、および個人VTuberであるため、ファンのための少量制作や少量の販売にも利用できるよう許可していただければ幸いです。\nもし不可能な場合は、販売条件なしで再送していただければ幸いです。\n\n使用可能な場合、縦長のアスペクト比16:5で、可能であれば300dpi（18900x5906px）、150dpi（9450x2953px）、100dpi（6300x1969px）に近いイラストに加え、背景が透明で人物のみが写っているPNGもいただけると大変嬉しいです！\n\nもし金額が不足している場合は、お気軽に再送をお願いできれば幸いです。\nどうか美しいイラストを拝見できますように。よろしくお願いいたします。\n\n\nhttps://imgur.com/a/KRieQjK\n\nhttps://imgur.com/a/KRieQjK", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hutaba0711/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 537384, "client_id": 2812787, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e26d4ec2/uploads/origins/a5c806b6-8522-4ee0-955d-e6d0c72b75db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23c5672983b42998030cf48e668f301e", "srcset": "https://si.imgix.net/e26d4ec2/uploads/origins/a5c806b6-8522-4ee0-955d-e6d0c72b75db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23c5672983b42998030cf48e668f301e, https://si.imgix.net/e26d4ec2/uploads/origins/a5c806b6-8522-4ee0-955d-e6d0c72b75db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5eba894f1a13eabb534b6a6cbe58aa89 2x, https://si.imgix.net/e26d4ec2/uploads/origins/a5c806b6-8522-4ee0-955d-e6d0c72b75db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9dc2d346fc5d5b4e3ec4b07828b2bd1c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e26d4ec2/uploads/origins/a5c806b6-8522-4ee0-955d-e6d0c72b75db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14a295a2ffceebc8cde6b7dedf9e2dc9", "srcset": "https://si.imgix.net/e26d4ec2/uploads/origins/a5c806b6-8522-4ee0-955d-e6d0c72b75db?bg=%23fff&auto=format%