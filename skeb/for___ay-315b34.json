3fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a3f3cc0170d1ebfb2f4eb2470cbffdb 3x"}, "body": "アイドルマスターシンデレラガールズの千川ちひろさんのオムツ拘束衣絵をお願いします。\n\n添付資料のように天井から下げられたバウンサーが股下を通されて吊り下げられ、足が閉じられないほどにモコモコの黄緑色のオムツでお尻を膨らませてください。また、オムツには『反省中』と書いてるください。顔には鼻フックとボールギャグを付けてほしいです。表情は恥ずかしがった苦笑いでお願いします。\n\nhttps://www.pixiv.net/artworks/85365280", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@for___ay/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2505045, "client_id": 1449517, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee8ef26b/uploads/origins/e113ce51-2a7f-4a05-98bf-a6852619fb36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfca4cb3cd0265b6e97147f1bc5ba447", "srcset": "https://si.imgix.net/ee8ef26b/uploads/origins/e113ce51-2a7f-4a05-98bf-a6852619fb36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfca4cb3cd0265b6e97147f1bc5ba447, https://si.imgix.net/ee8ef26b/uploads/origins/e113ce51-2a7f-4a05-98bf-a6852619fb36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afd9febe34d45dea7568f7ff38563845 2x, https://si.imgix.net/ee8ef26b/uploads/origins/e113ce51-2a7f-4a05-98bf-a6852619fb36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=051d7df77e7fae34a632138712ee7df1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee8ef26b/uploads/origins/e113ce51-2a7f-4a05-98bf-a6852619fb36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=320ce23937d9c95d378bcb2d41018212", "srcset": "https://si.imgix.net/ee8ef26b/uploads/origins/e113ce51-2a7f-4a05-98bf-a6852619fb36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=320ce23937d9c95d378bcb2d41018212, https://si.imgix.net/ee8ef26b/uploads/origins/e113ce51-2a7f-4a05-98bf-a6852619fb36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=096555e2e98df76d95286ab44aeadc3b 2x, https://si.imgix.net/ee8ef26b/uploads/origins/e113ce51-2a7f-4a05-98bf-a6852619fb36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=00ae6ef7c991ee1f67859bd77b17a366 3x"}, "body": "こんにちは。\n2021年の8月にpixivに投稿されていた「ファンアート」のイラストをとても気に入っていて、同じような拘束を受けている津島善子（ラブライブ！シリーズ）ちゃんのイラストをリクエストしたいです。\n\n大まかな構図は「元イラスト」と同じですが、資料の「首輪」と「足の拘束具」を追加で装着して、おむつを「おむつ」のようにもこもこの布おむつに変えてもらいたいです。\nまた、顔にイヤーマフを装着してください。\nおむつがもこもこすぎて、足を閉じれずに情けなく開いて膝立ちしている状態になります。\n\n善子の髪型はお団子だけなくして、下ろしたままにしてください。\n鼻フック付ハーネスボールギャグ・イヤーマフ・首輪・足枷の色を黒色にしてください。\n残りの拘束具は元のイラストと同じ白色にしてください。\n\n差分は、元イラストと同じ2枚を書いていただきたいです。\nセリフは元イラストから変更して（鼻水もよだれも止まらなくて恥ずかしい……。鼻大きくなっちゃう……）と（くるしっ……。何もできないっ……）です。\nその2枚に、黒色の目隠しを着けられている差分も書いていただきたいです。\n\nhttps://drive.google.com/drive/folders/15K3WD_g_GSdSEw3urTcoUlF-fSx6iCSv", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@for___ay/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/22d17b61/uploads/origins/2abb73d0-b10c-47fe-9397-14c91f3f7036?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=762536280132bb480de5a4356a30bba1", "srcset": "https://si.imgix.net/22d17b61/uploads/origins/2abb73d0-b10c-47fe-9397-14c91f3f7036?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=762536280132bb480de5a4356a30bba1, https://si.imgix.net/22d17b61/uploads/origins/2abb73d0-b10c-47fe-9397-14c91f3f7036?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19c60acba2c7d9af8e0f66697283ba1b 2x,