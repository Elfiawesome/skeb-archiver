マスク着脱、ルークと瑠璃の口元差分があると嬉しいです\n\n先生の描く二人が見られたら心から幸せです！\n初めてのご依頼になるため、どの位を設定すれば分かりませんでしたので、不足しているなど変更等があれば遠慮なく再送をお願いいたします！\n\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1qnIEfgRDrw0fMayaMO6HLeuHnsL-HL8j", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1154158, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゆのり(むしむし)", "screen_name": "Mo_518_mO", "avatar_url": "https://pbs.twimg.com/profile_images/1994165821476896768/li1ulPsb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/898426277446549505/1765828903/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 25, "skills": [{"genre": "art"}, {"genre": "video"}], "nc": 161}, {"id": 1311057, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "dama", "screen_name": "damahysk", "avatar_url": "https://pbs.twimg.com/profile_images/1609970513002266624/2XL8fQl4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/163436604/1695498091/1500x500", "appeal_receivable": false, "popular_creator_rank": 24, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 20, "skills": [{"genre": "music"}, {"genre": "correction"}], "nc": 16}, {"id": 1357483, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "teknizer🍰☕️🍩🍡", "screen_name": "tekk_a", "avatar_url": "https://pbs.twimg.com/profile_images/1236440794703089664/VK6VklqT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/927065224019976193/1618070400/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expira