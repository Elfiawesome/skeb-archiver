せん。来栖さんの好きな形でお願いします。\nキャラクターの容姿（服の装飾）についてなのですが、柄やワッペン、リボン、ベルト等好きなようにアレンジしていただけるととても嬉しいです。\n私は、来栖さんのように装飾をかっこよく配置したり、色を複数組み合わせるセンスを持ち合わせていないので、足していただけると飛んで喜びます。\nもちろんそのまま描いていただいても十分嬉しいです。\n\n資料URLはデザイン資料（ポイピクのリンクがあるツイート）です。ネタバレ等はありません。\n\nhttps://twitter.com/tkg_str9/status/1624342607857078272?s=46&t=bSzx_lLV_MnrwxW98eO0Rw", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kurusu_Kouho/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1150805, "client_id": 293094, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c6ccca8/uploads/origins/fdb672af-78c9-4650-95a8-5d7d81a4ad93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d36fd1c2af9ac442e13d5944805fec19", "srcset": "https://si.imgix.net/7c6ccca8/uploads/origins/fdb672af-78c9-4650-95a8-5d7d81a4ad93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d36fd1c2af9ac442e13d5944805fec19, https://si.imgix.net/7c6ccca8/uploads/origins/fdb672af-78c9-4650-95a8-5d7d81a4ad93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8fe5db39e294f2517d63dbe3fb72a7f 2x, https://si.imgix.net/7c6ccca8/uploads/origins/fdb672af-78c9-4650-95a8-5d7d81a4ad93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=334a006ee6ef5871c90e0656f34927b3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c6ccca8/uploads/origins/fdb672af-78c9-4650-95a8-5d7d81a4ad93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c88dd682bf0374341ba9ae916f2e3380", "srcset": "https://si.imgix.net/7c6ccca8/uploads/origins/fdb672af-78c9-4650-95a8-5d7d81a4ad93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c88dd682bf0374341ba9ae916f2e3380, https://si.imgix.net/7c6ccca8/uploads/origins/fdb672af-78c9-4650-95a8-5