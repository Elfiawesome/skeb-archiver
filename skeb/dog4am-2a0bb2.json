f09f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e6045306591f5dbaee5a2c584850201 2x, https://si.imgix.net/f704d400/uploads/origins/c86fdd3d-24ea-40fa-8354-8f078f23f09f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e846bf4532a180ddb7e06678009824b0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f704d400/uploads/origins/c86fdd3d-24ea-40fa-8354-8f078f23f09f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17df770d37552158e78b71548cdde524", "srcset": "https://si.imgix.net/f704d400/uploads/origins/c86fdd3d-24ea-40fa-8354-8f078f23f09f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17df770d37552158e78b71548cdde524, https://si.imgix.net/f704d400/uploads/origins/c86fdd3d-24ea-40fa-8354-8f078f23f09f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1145422e3b92d22c95630a79e81e1d3d 2x, https://si.imgix.net/f704d400/uploads/origins/c86fdd3d-24ea-40fa-8354-8f078f23f09f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4971a7d2bbb1fa58ce811043c4721e96 3x"}, "body": "いぬうえ先生、\n\n前回のイラスト、ありがとうございました！本当に素晴らしくて、振り返るたびに感動しています。今回はまた別のOC CPをお願いしたいです。\n\n【舞台】\n魔女狩りの時代\n\n【🧊】\n前任者で(母親)が不可解な失踪を遂げた後、町の市長職を引き継いだ若い女性。優しい微笑みを湛え、町民失踪事件の真相解明に尽力する姿勢で尊敬を集めている。\nその微笑みの裏には、彼女は町民が消えた理由の一つである、自邸の秘密の部屋で凍結状態に置くという趣味が隠されている。犠牲者を解凍する際、混乱状態を利用した再配線を行う。これにより新たな人格と願望を植え付け、その瞬間の彼女の欲望に適合した人物へと変貌させる。この過程は犠牲者の脳に危険を伴うため、一人につき一度しか再配線を実施できていない。\n\n【👓】\n市長の忠実な助手。その忠誠心の理由は不明である。この科学者風のタイプは普段はのんびりした様子だが、気分の変動や感情の突然の爆発を起こしやすい。ほぼ毎日、性格が劇的に変化しているように見える。実際には、記憶の大部分が毎日リセットされており、ノートを参照して記憶を回復している。 彼らには知らされていないが、その手帳は実は🧊によって書かれ選ばれたものであり、そもそも彼らの記憶喪失の原因も🧊である。彼らには専用の「部屋」があるにもかかわらず、毎日目を覚ますのは市長の秘密の庭だ、そこにはガラスの棺が置かれている。👓は他人を愛称で呼び、市長を「チャンセラー」と呼ぶ。\n\n市長は忠実な助手を道具のように扱い、人形のように弄びながらも、👓がも目を覚ますまで常にその傍らに寄り添い、二人だけの空間（ガラスの棺の部屋）で優しく世話を焼く。もしも最愛の👓に危害が及んだなら、翌日までにその原因を確実に始末するだろう。\n\n\n【リクエスト】\n可能であればシナリオとイラストの構成についてはお任せしたいと思います。没ラフや下描きなどがあればPSDに残したままにしていただけると嬉しいです。\n\n依頼金額が不足している場合は再送してください。\n\nご検討いただきありがとうございます。\n\nhttps://drive.google.com/drive/folders/1Vz9VJgbr_KRfxzL-UUaPkFHFz-kA_p9j?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@dog4am/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bf3597c0/uploads/origins/43a32430-bad7-49bd-af4c-15f30d86aadd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=835b12e7f62fdeb296d8904dc80f6b01", "srcset": "https://si.imgix.net/bf3597c0/uploads/origins/43a32430-bad7-49bd-af4c-15f30d86aadd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=835b12e7f62fdeb296d8904dc80f6b01, https://si.imgix.net/bf3597c0/uploads/origins/43a32430-bad7-49bd-af4c-15f30d86aadd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32453161972e76547859af4a1f0368de 2x, https://si.imgix.net/bf3597c0/uploads/origins/43a32430-bad7-49bd-af4c-15f30d86aadd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=caeb15a27012900157344bc514a441ee 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3521218, "client_id": 3433329, "nc": 145}, {"path": "/@dog4am/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3521218, "client_id": 3273138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/56b86b48/uploads/origins/0acddccb-9fe1-427a-bfba-0adc6093c630?bg=%23fff&auto=format%2Ccompress