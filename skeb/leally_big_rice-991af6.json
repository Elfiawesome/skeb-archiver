cc666/uploads/origins/c2ef6d75-7eb4-4315-aec5-d57eac56440c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7105a53bf377b82b3c5badb78ec3b79", "srcset": "https://si.imgix.net/4f9cc666/uploads/origins/c2ef6d75-7eb4-4315-aec5-d57eac56440c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7105a53bf377b82b3c5badb78ec3b79, https://si.imgix.net/4f9cc666/uploads/origins/c2ef6d75-7eb4-4315-aec5-d57eac56440c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e233ec7ab5956e04f736c6338252f23 2x, https://si.imgix.net/4f9cc666/uploads/origins/c2ef6d75-7eb4-4315-aec5-d57eac56440c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc46906379ec1a6b7fac2d04c8595c1a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f9cc666/uploads/origins/c2ef6d75-7eb4-4315-aec5-d57eac56440c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eaaa38b0af0b1961620ee03a5658fe61", "srcset": "https://si.imgix.net/4f9cc666/uploads/origins/c2ef6d75-7eb4-4315-aec5-d57eac56440c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eaaa38b0af0b1961620ee03a5658fe61, https://si.imgix.net/4f9cc666/uploads/origins/c2ef6d75-7eb4-4315-aec5-d57eac56440c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=091cce9da724e29a56ee0a2ebeb57114 2x, https://si.imgix.net/4f9cc666/uploads/origins/c2ef6d75-7eb4-4315-aec5-d57eac56440c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2ab52a040772401098f6bdc73c1f747a 3x"}, "body": "お世話になっております、歪んだむと申します。\n前回はありがとうございました。\n\n今回はうちの子の「フォルン（デュレイルフォルム/大人姿）」をリクエストします。\n資料で分かりにくい点、不明な点などは描きやすいように調整・アレンジしていただいて大丈夫です。\n\n●リクエスト内容\n魔法込みの格闘戦をする大人フォルンのイラスト。\n長い足を使った蹴り＋纏った氷爪による引っ掻くような多重の斬撃のようなイメージ。\n今回も、動きや躍動感を感じるアクロバティックなポージングで描いていただければと思います。\n\n表情はクールで無慈悲な氷の女王様的な感じの冷たく高圧的なものか、\n本来の姿が狼型モンスターなので歯を見せるような獰猛そうな笑み（犬歯は尖っています）\nまた、紅美鈴のイラストのような薄っすらメイク感のある大人っぽい感じだと嬉しいです。\n\n\n●戦闘スタイルのイメージ。\n氷＋闇の双属性。\nそのまま放つ遠距離攻撃よりも、俊敏に動き回りつつ付与で強化した長い手足を用いた格闘寄りで、速い＆重いイメージ。射撃や砲撃系の魔法が使えないわけではないが、消耗が激しいので殴る蹴る、鉄球や鎖を用いた純物理が多め。\n腕や脚に氷を纏わせ巨大な獣爪型の籠手/ブーツのようにしたりする。纏わせた状態で腕を振るったり、回し蹴りを放つ要領で、直接引き裂くような近接攻撃や飛ぶ斬撃での近～中距離を好む ※参考としてはテイルズシリーズのベルベットの左腕的なものを、氷と黒い紋様状に纏わりつく魔力で作るイメージ\n\n●衣装\n下記のどちらかでお願いします。\n・デフォルト衣装（キャラデザも含みます）　https://x.com/i/status/2053106690007187580?s=20\n・和柄ボトムス衣装　https://x.com/i/status/2082117050789695992?s=20 ※羽織の有無はお任せ。デフォルト衣装のように鎖と鉄球を元に戻して挟撃するなども可能\n\n可能であれば両方の角や狼耳が見切れない範囲でお願いします。\n\n\n文字や背景、宛名・サインにつきましてはpsdレイヤーで別々にon/offできるようお願いいたします（投稿時はサインon）\n\nご検討よろしくお願いします。\n\n\n●簡易な設定など\nデュレイルフォルム\n角込み（靴無し）で192.3cm。妙齢の狼獣人女性のような姿。\n魔法戦士的な中～近距離での戦闘を想定した長身＋長い手足＋筋肉質ではない、出るところは出つつ引き締まったスタイル。胸は顔よりデカい。\n黙っているとクール系女王様っぽいが、中身は他の姿と変わらない。人としての一般常識に疎い少女と、野生動物みたいな本能で動く…を良くも悪くも両立している。\n髪は腰くらいまで長く、尻尾もモフモフかつ長い。少女姿と同じく前髪の一部、体毛や尻尾に紋様のような黒いメッシュがある。\n人の耳はなくケモミミのみ。ケモミミの中の毛は黒系。\n●その他\n首輪や鎖＆鉄球、左額の氷角は据え置き\n※和柄ボトムス衣装の場合は、首輪・鎖・鉄球を小さくアレンジしアクセサリー風にしている状態（https://x.com/i/status/2082117911272149145?s=20）\n肘～手首、膝下～足首は腕カバーやブーツでなく実際に体毛が生えている\n\n・補足資料(その他の姿など）\n【封印の要となっている首輪や鎖は外れない　※すべての姿で共通】\nhttps://x.com/i/status/1977337608620658814", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@leally_big_rice/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3838505, "client_id": 766715, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e2261df/uploads/origins/b3fa0b21-3b33-4d7c-8210-7dbf38c8b483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cde47c7fc2fd78150824542ccc9283db", "srcset": "https://si.imgix.net/4e2261df/uploads/origins/b3fa0b21-3b33-4d7c-8210-7dbf38c8b483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cde47c7fc2fd78150824542ccc9283db, https://si.imgix.net/4e2261df/uploads/origins/b3fa0b21-3b33-4d7c-8210-7dbf38c8b483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0dbd305b6db3e9cab831e49d4d5e2209 2x, https://si.imgix.net/4e2261df/uploads/origins/b3fa0b21-3b33-4d7c-8210-7dbf38c8b483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=035a47eaa936b4cbd0b2e2038f99e9c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e2261df/uploads/origins/b3fa0b21-3b33-4d7c-8210-7dbf38c8b483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffeca52a83aa7d2ca936b3895f825793", "srcset": "https://si.imgix.net/4e2261df/uploads/origins/b3fa0b21-3b33-4d7c-8210-7dbf38c8b483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffeca52a83aa7d2ca936b3895f825793, https://si.imgix.net/4e2261df/uploads/origins/b3fa0b21-3b33-4d7c-8210-7dbf38c8b483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a519fb2d875eedf1a72522d495ff4a54 2x, https://si.imgix.net/4e2261df/uploads/origins/b3fa0b21-3b33-4d7c-8210-7dbf38c8b483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b83bf36f27521fdb73c96f0169555747 3x"}, "body": "はじめまして、SNSで見かけた東方キャラクターのイラストの線の力強さに惹かれてリクエストを送らせていただきます。\n良ければ当方のTRPGキャラクターを描いていただきたく思います。\n\n黒葛スヰ（つづらすい）という女子高生です。\n表情は平坦であり、淡々としていますが無口でもなくえぐい甘党。\n自身の血液で強化した髪を刃のように振り回して戦う白兵戦を得意とします。\n可能であれば、躍動感や動きを感じる構図で描いていただきたいです。\nhttps://x.com/kthgphm/status/2074081563927859695\n\nご検討いただけますと幸いです。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@leally_big_rice/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3838505, "client_id": 1066697, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/00cc2907/uploads/origins/43ce44fa-6f3b-477e-a077-8eb39574d6b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=443cfd12f69608c4087fa154d0395c71", "srcset": "https://si.imgix.net/00cc2907/uploads/origins/43ce44fa-6f3b-477e-a077-8eb39574d6b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=443cfd12f69608c4087fa154d0395c71, https://si.imgix.net/00cc2907/uploads/origins/43ce44fa-6f3b-477e-a077-8eb39574d6b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39609fe1191d8bebd6b6ad4c6ae8d687 2x, https://si.imgix.net/00cc2907/uploads/origins/43ce44fa-6f3b-477e-a077-8eb39574d6b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f456e03aa328dcef15529e32f9f969d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00cc2907/uploads/origins/43ce44fa-6f3b-477e-a077-8eb39574d6b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c58da77814f526b5e576e2c2e742b6b9", "srcset": "https://si.imgix.net/00cc2907/uploads/origins/43ce44fa-6f3b-477e-a077-8eb39574d6b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c58da77814f526b5e576e2c2e742b6b9, https://si.imgix.net/00cc2907/uploads/origins/43ce44fa-6f3b-477e-a077-8eb39574d6b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c7b348fb77164895f98198b2759a23e9 2x, https://si.imgix.net/00cc2907/uploads/origins/43ce44fa-6f3b-477e-a077-8eb39574d6b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dfcdae4cb8d5cefb9cc3f78971c1918d 3x"}, "body": "はじめまして、歪んだむと申します。\nSNSで投稿されていた東方キャラのイラストが表情豊かで、躍動感のある様子が素敵でリクを送りました。\n\nうちの子の探索者「シア」をリクエストします。\n資料で分かりにくい点、不明な点などは描きやすいように調整・アレンジしていただいて大丈夫です。\n\n●リクエスト内容\n銃を構えたシアのイラスト。\n狙いをつけている瞬間や、弾丸を発射した瞬間など、場面はお任せします。\n動きや躍動感を感じるアクロバティックなポージングで描いていただければと思います。\n\n表情は直近で投稿されていた紅美鈴のような余裕があり勝気な様子、状況を楽しんで歯を見せる獰猛そうな笑みなどでお願いします。\n\n\n●戦闘スタイルのイメージ\nシアは一撃の威力よりも手数重視。身軽であり、地形や壁などを使ってアクロバティックに動き回りながら詰めていくタイプ。\n\n●装備類\n衣装：基本衣装の黒ジャケットあり（設定のURLにあるキャラデザを参照）\n先生の思う東方風なアレンジを入れるなどもOKです（もちろんそのままでも大丈夫です）\n\n武装：［アンチマテリアル・エクステリア］ブレードリボルバー　https://x.com/i/status/2082851778127880625?s=20\nレールと追加加速装置の瞬時加速による高初速と、弾丸のコーティングと仮想質量の付与で威力を引き上げる強化外装。銃本体には触れず浮遊しており追従、取り回しの感覚や連射性能などをほぼそのままに「弾丸」を強化＆多様化して放つことができる。\n2枚目の右側中央の「高出力＆連射重視モード」\n弾種は3枚目のシンプル型\n※銃本体（ブレードリボルバー）とホルスター参考　https://x.com/i/status/2002336964998304061?s=20 （3、４枚目）\n緊急時の近接対応用ブレードが付属している、様々な弾種や無茶な運用にも耐えれるほど構造的に頑丈なこと以外は普通の火薬式リボルバー。\n\n\n宛名やサイン、背景などにつきましてはpsdレイヤーで別々にon/offできるようお願いいたします（投稿時はサインon）\n\nご検討よろしくお願いします。 \n\n●簡易な設定など\n黒髪＋先端近くほど濃い山吹色のグラデーションインナーカラー。\n顔はいいが基本的にぶっきらぼうで、口調は乱暴。目付きも鋭い。平時はダウナー気味だが、興味があれば笑顔で首を突っ込む。\n悪人ではないが第一印象で勘違いされやすい＆黙っていれば美人と言われるタイプ。\nスタイルは引き締まっているが、お尻はデカい。\nhttps://x.com/i/status/2002336949198336009", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@leally_big_rice/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3838505, "client_id": 3131898, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b37d84ae/uploads/origins/c5a42898-c1c1-48be-97b2-1328ba9d8f58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e067d853ad7597072900036ce84f9e5c", "srcset": "https://si.imgix.net/b37d84ae/uploads/origins/c5a42898-c1c1-48be-97b2-1328ba9d8f58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e067d853ad7597072900036ce84f9e5c, https://si.imgix.net/b37d84ae/uploads/origins/c5a42898-c1c1-48be-97b2-1328ba9d8f58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ed604ea11b870e1a10108a04b6988c0 2x, https://si.imgix.net/b37d84ae/uploads/origins/c5a42898-c1c1-48be-97b2-1328ba9d8f58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75e2bc251f2f5e9b2683f12a3b48b476 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b37d84ae/uploads/origins/c5a42898-c1c1-48be-97b2-1328ba9d8f58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c018895f67d5bda1164b8ad180dae571", "srcset": "https://si.imgix.net/b37d84ae/uploads/origins/c5a42898-c1c1-48be-97b2-1328ba9d8f58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c018895f67d5bda1164b8ad180dae571, https://si.imgix.net/b37d84ae/uploads/origins/c5a42898-c1c1-48be-97b2-1328ba9d8f58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49b715519f41b5c9074bf7e5162e6e27 2x, https://si.imgix.net/b37d84ae/uploads/origins/c5a42898-c1c1-48be-97b2-1328ba9d8f58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=14541ceac91b95ed84bfe157c70ea248 3x"}, "body": "「Really Big Rice」先生へ\nこんにちは。あなたの東方プロジェクトのイラストを心から尊敬しており、長年のファンです。私のオリジナルキャラクター「小石 米二」の全身立ちイラストと、表情バリエーションのセットを制作していただけないでしょうか？これらは個人的なコレクションや動画制作に使用したいと考えています。\n\n参考画像を用意しましたが、その前にいくつかお伝えしておきたい点があります。\n\n・最初の参考画像に描かれているロリータ風のボンネットは、小石米二によりふさわしい別の帽子に変更していただいても構いません。ご自由にアレンジしてください。\n\n・基本ポーズは浮遊状態を想定していますが、実際の動作については、キャラクター設定に沿ったものにするか、あるいは完全にあなたの創造的な解釈に委ねても構いません。\n\n・表情のバリエーションについては、以下の8つを想定しています：口を閉じた笑顔；\n口を開けた笑顔（話しているような）；\n目を閉じて口を開けた笑顔；\n真剣／怒った顔；\n驚いた顔；\n怖がっている／怯えた顔；\n泣いている顔；\nそして、顔を赤らめた恥ずかしそうな顔。\nこのセットにさらに表情を加えることでより良くなるとお考えの場合は、ご自身の判断で自由に追加してください。\n\n・参考画像は全部で3枚あります。 1枚目はメインの参考画像で、他の2枚は補助的なガイドとなります。これらの画像を基に制作していただいても構いませんし、ご自身のアイデアに合わせて自由にアレンジしていただいても結構です。\n\n（私の個人的な設定を簡単にまとめると、内面の葛藤を乗り越え、より成熟して明るい「小石」を想定しています。）\n\n提示された予算が不十分だったり、要件が不明確な点があれば、遠慮なく内容を調整した上で依頼を再送してください。\n\nまた、可能であれば、完成した立ち絵を公開させていただきたいです（主に動画制作での使用を許可するためです）。\n\nお時間を割いてご検討いただき、誠にありがとうございます。ご返信を心よりお待ちしております。\n\n参考画像はこちらです：\nhttps://drive.google.com/file/d/1kKBsZUMuHu7P21XVwic5bN7CbhBqguLD/view?usp=drive_link\nhttps://drive.google.com/file/d/1ZFXiJ_gB7g2Zq-Cg9zbaQPkTvXnp6ngp/view?usp=drive_link\nhttps://drive.google.com/file/d/1e1Y_xk4E83FtWKC9k_lFVQicEGvrYTV1/view?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_ge