頃、ゴミ捨て場に捨てられていたところを拾われた。\n拾ってくれた義母のことは大好きだったが、末期がんで亡くなった。マザコンです。\n真相は不明だが、その容姿から海外の血が入ってると推測される。\n\n容姿の詳細については、URL先を参照ください。\nあまり笑わないので、無表情でお願いします。\nおっぱい大きいので、それだけは忠実に描いていただきたいです。\n髪を描くのが大変かもしれません。頑張ってください。\n\n\n\nご検討、よろしくお願いします。\n\nhttps://twitter.com/445_clarico/status/1468570438016315398?s=20", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@planet_0704/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 176562, "client_id": 1219333, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76c8e701/uploads/origins/8a609d24-b87c-476b-93ba-7aec23999022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0328b43a500c2fc2c7957dede0bd3eff", "srcset": "https://si.imgix.net/76c8e701/uploads/origins/8a609d24-b87c-476b-93ba-7aec23999022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0328b43a500c2fc2c7957dede0bd3eff, https://si.imgix.net/76c8e701/uploads/origins/8a609d24-b87c-476b-93ba-7aec23999022?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dbf3ec95bbf84218e05b25a9f35df673 2x, https://si.imgix.net/76c8e701/uploads/origins/8a609d24-b87c-476b-93ba-7aec23999022?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13c97505ab2f7f57ba78137ee741f809 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76c8e701/uploads/origins/8a609d24-b87c-476b-93ba-7aec23999022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4e79df670bdb7f380ec3fbca0077ba0", "srcset": "https://si.imgix.net/76c8e701/uploads/origins/8a609d24-b87c-476b-93ba-7aec23999022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4e79df670bdb7f380ec3fbca0077ba0, https://si.imgix.net/76c8e701/uploads/origins/8a609d24-b87c-476b-93ba-7aec23999022?bg=%23fff&auto