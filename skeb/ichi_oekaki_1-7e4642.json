s/702c799a-948a-4d2e-9ac5-6f382c2bb83e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2abbbcd80c6a17fb6f7152a1728e8a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7841337b/uploads/origins/702c799a-948a-4d2e-9ac5-6f382c2bb83e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3af1f92a85eba80bd87d44295e3d3213", "srcset": "https://si.imgix.net/7841337b/uploads/origins/702c799a-948a-4d2e-9ac5-6f382c2bb83e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3af1f92a85eba80bd87d44295e3d3213, https://si.imgix.net/7841337b/uploads/origins/702c799a-948a-4d2e-9ac5-6f382c2bb83e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d22516597b4eae582e99f0191c9e1a95 2x, https://si.imgix.net/7841337b/uploads/origins/702c799a-948a-4d2e-9ac5-6f382c2bb83e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e36fb7e1914743cda0906caf780ff628 3x"}, "body": "お久し振りです。この間はありふれた職業で世界最強のシア・ハウリアを描いて頂き、どうもありがとうございました。今度は、薬屋のひとりごとの現パロでお願いします。薬屋のひとりごとの猫猫が現代の日本でプロボクサーとなった後、数々の試合で勝ち負けを繰り返し、紆余曲折の末、プロボクシングの日本女子ミニマム級王者となり、記念のポートレートを撮影しているところを見てみたいです。服装は、女子プロボクサー風のもので、右肩か左肩へチャンピオンベルトを掛け、両拳へボクシンググローブをはめている格好でお願いします。胸も幾らかはあると嬉しいです。描くのが難しいようでしたら、キャンセルして頂いても大丈夫です。どうか宜しくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ichi_oekaki_1/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1719744, "client_id": 3478528, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c69b3bd/uploads/origins/c80e3b13-b94b-4119-b790-e6b8e9433a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc0cd84084f60522274fd727ae8ba8e9", "srcset": "https://si.imgix.net/2c69b3bd/uploads/origins/c80e3b13-b94b-4119-b790-e6b8e9433a1d?bg=%2