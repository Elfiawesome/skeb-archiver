uto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e51404cf011fbd33998485750aa8ec6a", "srcset": "https://si.imgix.net/c018fdf7/uploads/origins/fab03b8a-1502-4bab-886b-b78fdb83a20f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e51404cf011fbd33998485750aa8ec6a, https://si.imgix.net/c018fdf7/uploads/origins/fab03b8a-1502-4bab-886b-b78fdb83a20f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49d7dbe097cac727ead538a2485960b9 2x, https://si.imgix.net/c018fdf7/uploads/origins/fab03b8a-1502-4bab-886b-b78fdb83a20f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9891acb35b3ac229a71f6577d418e41a 3x"}, "body": "しずくちゃんが少年役を演じることになり、髪をバッサリ切ろうと果林ちゃんにヘアメイクさんへの相談をしてもらい後日果林ちゃんに付き添ってもらいつつ、坊主に近いベリーショートになって果林ちゃんに感謝するしずくちゃんと似合ってる事で撫でる果林ちゃんをお願いします。\nしずくちゃんが鏡から見てる正面と撫でられてる時は後ろ姿の2パターンをお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ichi_oekaki_1/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1719744, "client_id": 28629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/440444de/uploads/origins/e7a7b858-7555-4605-ab48-f82b0364322f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6457b2a6bfe97569c401c4013124e008", "srcset": "https://si.imgix.net/440444de/uploads/origins/e7a7b858-7555-4605-ab48-f82b0364322f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6457b2a6bfe97569c401c4013124e008, https://si.imgix.net/440444de/uploads/origins/e7a7b858-7555-4605-ab48-f82b0364322f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd34da68b9adae10ebd41dacba585d38 2x, https://si.imgix.net/440444de/uploads/origins/e7a7b858-7555-4605-ab48-f82b0364322f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c37dd366abe1fa0beb4e67