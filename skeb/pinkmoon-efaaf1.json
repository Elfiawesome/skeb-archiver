1295, https://si.imgix.net/cabfc142/uploads/origins/99e5f991-d5ad-4fd6-8439-450f5cc4eb62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d6813d3b94882846bf68d064a8dd416 2x, https://si.imgix.net/cabfc142/uploads/origins/99e5f991-d5ad-4fd6-8439-450f5cc4eb62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1dd914d970f21cda7509c839032b44c0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cabfc142/uploads/origins/99e5f991-d5ad-4fd6-8439-450f5cc4eb62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5338faa496958a31d8e4455198b52a74", "srcset": "https://si.imgix.net/cabfc142/uploads/origins/99e5f991-d5ad-4fd6-8439-450f5cc4eb62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5338faa496958a31d8e4455198b52a74, https://si.imgix.net/cabfc142/uploads/origins/99e5f991-d5ad-4fd6-8439-450f5cc4eb62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ceb3ea792fe70dd00b4f3a78cf594d6 2x, https://si.imgix.net/cabfc142/uploads/origins/99e5f991-d5ad-4fd6-8439-450f5cc4eb62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=04fbaff2d43b53ec97c5099b9abb7025 3x"}, "body": "FF14のマイキャラをリクエストさせて頂きます。\n\n衣装やシチュエーションはお任せです。\n精液や粘液等の汁要素がある場合は褐色肌が栄えるように多めにお願いします。\n\n以下、マイキャラ設定になります。\n==================\n容姿  ：下記Google Drive参照\n髪型  ：マーセナリー(face_3,4)で少し傷んだ金髪\n体格  ：アウラの中では全体的に大きめで腹筋はうっすら割れてる\n性格  ：カラッとした性格でノリが軽い。\n備考1：アンダーヘア有無はお任せ。有の場合は金色\n備考2：乳首や乳輪は普通サイズで色は肌より濃いブラウン色\n==================\n\n※修正が必要な場合は性器レイヤーのみ刻み海苔修正をお願いします\n\nhttps://drive.google.com/drive/folders/1jXGU2DChNTNxsaBxXIjePWvIXXNqLf4C?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pinkmoon/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 185419, "client_id": 171700, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3872650a/uploads/origins/3da58475-3254-447e-88aa-89427b24bd43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe0b16d2175aecd3fc7ecf7b0147203a", "srcset": "https://si.imgix.net/3872650a/uploads/origins/3da58475-3254-447e-88aa-89427b24bd43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe0b16d2175aecd3fc7ecf7b0147203a, https://si.imgix.net/3872650a/uploads/origins/3da58475-3254-447e-88aa-89427b24bd43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ca5c660c2c66ebb270b8d7cf1a6d265 2x, https://si.imgix.net/3872650a/uploads/origins/3da58475-3254-447e-88aa-89427b24bd43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89c54182f029108519cce32b520d1ebb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3872650a/uploads/origins/3da58475-3254-447e-88aa-89427b24bd43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f367a303b70eccbee8be67a9ef5f14b", "srcset": "https://si.imgix.net/3872650a/uploads/origins/3da58475-3254-447e-88aa-89427b24bd43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f367a303b70eccbee8be67a9ef5f14b, https://si.imgix.net/3872650a/uploads/origins/3da58475-3254-447e-88aa-89427b24bd43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e2ecda74f97a7f93526888355eb6f6c 2x, https://si.imgix.net/3872650a/uploads/origins/3da58475-3254-447e-88aa-89427b24bd43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=666a5b8761cb2a41a58d8a4646a5f302 3x"}, "body": "はじめまして\nうちの子のお着替えイラストを描いてください。\n\n以下内容\n・服装は白いスケスケのセパレートスクール水着(上下が分かれている水着です)\n・プールの前に睡眠姦されておりそれに気づかずプールの授業が終わったという設定で、上はおっぱい丸出しになるまでスク水を半脱ぎ、下は既に脱いだ状態でお願いします。\n・ポージングは水着を脱いでる途中。足は少し開いて、あそこから睡眠姦時に挿入されたタンポンの紐が垂れており、精液も太もも伝って漏れ出している(でも気づいていない)\n・髪型はおまかせ。でもプール上がりなので濡れさせてください\n・背景は更衣室\n・アングルはやや斜め下からのアングルでお願いします。\n\n以下詳細\n①プール授業前に睡眠姦で犯されたうちの子はプールの授業を終えて着替えている。(ここで受精描写お願いします)(タンポンと太ももを伝ってあそこから落ちる溢れ精液をお願いします)\n②それから少し時が経って再び更衣室。少しお腹が膨らんでるうちの子は相変わらず着替えている(ここでお腹の中に妊娠15週ぐらいの胎児の描写を描いてください)\n③②から時が経ち、おっぱいも大きくなって母乳も出始めたうちの子はそれでも気づかず着替えている(ここでお腹の中に妊娠25週ぐらいの胎児の描写を描いてください)\n④臨月。同じくおっぱいも大きくなって母乳が滴り落ちるうちの子は気にせず着替えている(ここでお腹の中に妊娠40週ぐらいの女の子の赤ちゃんの描写を描いてください)\n\n\nその他\n・①〜④にそれぞれ適当なセリフを挿入してください(できればゲスセリフでお願いします)\n・うちの子は催眠でお腹が大きくなっていることには気づいている(太った？程度)けど、妊娠はしていないという認識阻害されているようにしてください\n・パイパンできめ細かい純白の肌。 おっぱいは魅惑の谷間が特徴的なハリがあって形のいい美巨乳。ウエストは引き締まっていて、前からでも見えちゃう尻神様のような安産型のお尻に艶っぽい鼠蹊部と健康的な太ももをお願いします。\n・差分や受精・子宮内描写などはPSDで切り替え可能にしてください\n\n差し支えなければよろしくお願いします\n\nhttps://drive.google.com/drive/folders/1-aU6Jy4i_0sVRLLUTig1DU3yvjRUiS1K", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 659694, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "名一", "screen_name": "71naichi71", "avatar_url": "https://pbs.twimg.com/profile_images/1795036670175363072/bGMzzaPW.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 783062, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ユウサギ", "screen_name": "yuu_sagi", "avatar_url": "https://pbs.twimg.com/profile_images/2053410643295010816/6HxCyYxZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/177010109/1777566580/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}],