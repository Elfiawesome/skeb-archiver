=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d6656f3ab520e9ab2d15080c0e04e78 3x"}, "body": "鬼滅の刃のオリキャラを描いて頂きたいです。\n描いて欲しいのは戦闘シーンで、オリキャラが鬼に向かって日輪刀で技を繰り出す(または斬撃)シーンをお願い致します！\n傷等あっても大丈夫です。\n画像なんですけどできれば縦長で迫力のある感じでお願いします！\n\n私もよく描き忘れてしまうのですが、額の傷と頬の痣は必ず描いてください！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@E01XlFm5PpnwpZ7/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1489475, "client_id": 880376, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f8a7225/uploads/origins/eb0fe7e1-8d93-4784-a3d6-55f5b5ea4272?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81543457dcc774191a14a22bc3997061", "srcset": "https://si.imgix.net/6f8a7225/uploads/origins/eb0fe7e1-8d93-4784-a3d6-55f5b5ea4272?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81543457dcc774191a14a22bc3997061, https://si.imgix.net/6f8a7225/uploads/origins/eb0fe7e1-8d93-4784-a3d6-55f5b5ea4272?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=535bdfc4effebc70afa102a4fb7390b0 2x, https://si.imgix.net/6f8a7225/uploads/origins/eb0fe7e1-8d93-4784-a3d6-55f5b5ea4272?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c2c97305afc05d1204105b4f468a733 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f8a7225/uploads/origins/eb0fe7e1-8d93-4784-a3d6-55f5b5ea4272?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e8f8e7e53ff23ba3887a4fea72d9747", "srcset": "https://si.imgix.net/6f8a7225/uploads/origins/eb0fe7e1-8d93-4784-a3d6-55f5b5ea4272?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e8f8e7e53ff23ba3887a4fea72d9747, https://si.imgix.net/6f8a7225/uploads/origins/eb0fe7e1-8d93-4784-a3d6-55f5b5ea4272?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f5398136109c3389bc0a446c793f6eb8 2x, https://si.imgix.net/6f8a7225/uploads/origins/eb0fe7e1-8d93-4784-a3d6-55f5b5ea4272?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a0efe242bb7980be08c5a99b5f2ef345 3x"}, "body": "ヤクルトン様\n\nマジシャンです\n前回は素敵なイラストありがとうございます\nそれで良ければまたイラストをお願いしたいのですが\n今度のキャラクターは映画「神龍の伝説」に出てるグルメスの部下の一人パスタで\nシュチエーションは牧場で働かされているで\nhttps://imgur.com/a/fr1sdAO\n（↑トホホといった表情や吹き出しなどもこちらを参考にしてほしいです）\n\n\n映画の最後で平和になったグルメス王国ですが\nパスタはグルメス王国の田畑を破壊して\n村人たちを苦しめた元凶の一部ですから\n罰で牧場で働かされている\n\nただ服装は囚人服じゃなくグルメス王国の軍服で（https://imgur.com/a/Nl6Biw5）\nそれと作中で最後に消えてしまった\n彼女が固執していたリッチストン（https://imgur.com/a/UAXbPGx）を\n思い出し（ふき出しの中にリッチストンがあるように）\nまた牧場で働かされている現状もありトホホといった表情でお願いしたいのですが\n\n\nまとめさせて頂くと\nキャラクターはパスタ\nシュチエーションは牧場で働いているで\n服装はグルメス王国の軍服\n吹き出しの中にリッチストン（リッチストンを思い出したような感じで）\n表情はトホホで\n後は任せます\nこちらでお願いしたいのですが", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@E01XlFm5PpnwpZ7/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1489475, "client_id": 1493556, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4131dcd/uploads/origins/4b60dccd-0d3e-40d0-b3c7-629088b9c594?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ebb5cbebd4515f223defbbbffd085a2", "srcset": "https://si.imgix.net/c4131dcd/uploads/origins/4b60dccd-0d3e-40d0-b3c7-629088b9c594?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ebb5cbebd4515f223defbbbffd085a2, https://si.imgix.net/c4131dcd/uploads/origins/4b60dccd-0d3e-40d0-b3c7-629088b9c594?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aee9a312e2ee22fad43693b947a949f7 2x, https://si.imgix.net/c4131dcd/uploads/origins/4b60dccd-0d3e-40d0-b3c7-629088b9c594?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9f976ce6b3d40ca1efd9e6fba816978 3x"}, "dura