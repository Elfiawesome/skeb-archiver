れのペア同士でイラストを用意していただけると幸いです。(アイラスとアンダーデッドテイカーの相方が別の為）\n\n資料の不備や金額不足などありましたら対応しますので、ご検討いただけますと幸いです。 お忙しいところ大変恐縮ですが、何卒よろしくお願いします…！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@VkUC4ZKTKc/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3927604, "client_id": 2755830, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e3ef3bb/uploads/origins/aee849db-029c-4e7e-bc62-f71dbf3609e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43b4f93d40b7d4bc8e121e4bd999a56d", "srcset": "https://si.imgix.net/6e3ef3bb/uploads/origins/aee849db-029c-4e7e-bc62-f71dbf3609e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43b4f93d40b7d4bc8e121e4bd999a56d, https://si.imgix.net/6e3ef3bb/uploads/origins/aee849db-029c-4e7e-bc62-f71dbf3609e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edd8734a2ea9afe28cabe538ab036df3 2x, https://si.imgix.net/6e3ef3bb/uploads/origins/aee849db-029c-4e7e-bc62-f71dbf3609e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21e5e37e487b68a52586f2454516953a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e3ef3bb/uploads/origins/aee849db-029c-4e7e-bc62-f71dbf3609e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=272abcc96d3122c1e7d4f38e0ec7f152", "srcset": "https://si.imgix.net/6e3ef3bb/uploads/origins/aee849db-029c-4e7e-bc62-f71dbf3609e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=272abcc96d3122c1e7d4f38e0ec7f152, https://si.imgix.net/6e3ef3bb/uploads/origins/aee849db-029c-4e7e-bc62-f71dbf3609e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=56133a4a455b4616d53b6b3400581b01 2x, https://si.imgix.net/6e3ef3bb/uploads/origins/aee849db-029c-