cc-3b9ff4acc49b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e373379f62d9d9c970cbdeed1662389", "src_set": ""}, "body": "こんにちは！\n\n月姫のコハクを描いてくれませんか？  後ろから見た「裸エプロン」姿を見てみたいです。  全裸でエプロンだけ着て、後ろを向いているところが見たいです。  できれば、横乳と勃起した乳首が見たい。\n\nあと、2つのバージョンが欲しい。普通のバージョンと、お尻に精液がついていて背中と体が汗まみれになっているバージョン。\n\n詳細と範囲はあなた次第。  お尻と背中、太ももを中心にしたものが見やすければ何でもいいです。  参考文献は素晴らしいお手本なので、参考にしながら好きなように描いてください\n\n参考文献\nhttps://ibb.co/VcGmbKRQ\nhttps://ibb.co/rKwhPqPG\nhttps://ibb.co/pvnSWQxv\nhttps://ibb.co/RTjPw1wV\nhttps://ibb.co/Xk2r5fg4\n\nリクエストをお読みいただきありがとうございました。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@weilaizuigao703/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/46784597/uploads/origins/c67e3782-d64f-4698-af63-b82ec6f4dbb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aca78f6d75e7fbda8c6fac31e90e29b0", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3232544, "client_id": 2925977, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@weilaizuigao703/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3232544, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/304f47da/uploads/origins/7b2092fe-fb06-411e-8242-a1542c311a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77e550be39b4068b15e60c2a55687210", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/304f47da/uploads/origins/7b2092fe-fb06-411e-8242-a1542c311a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70a46d89d47d660dc6e011a4dbc4c1d0", "src_set": ""}, "body": "初めまして。\nメルティブラッドよりシオン・エルトナム・アトラシアの敗北事後絵をリクエストさせて頂きたいです。\n\n路地裏か公衆トイレの個室で両手を拘束されて複数人に犯されたというシチュエーションで、着衣のままで胸元が破かれて胸が露出、下着はずらすか破られるかで両穴からは何度も中出しされた精液が溢れ\n、放心状態で開きっぱなしの口からも精液が垂れ、靴は片方が脱げて転がっているという内容でお願いします。\n\nキャラ資料\nhttps://x.com/iraishiryou/status/1364231468940103688?t=ebb64KbW_6SE6Jntf0_4Jw&s=19", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@weilaizuigao703/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3232544, "client_id": 3218834, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5844dca/uploads/origins/a70d7b62-7331-4ead-883b-5e33f2bfa2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76126e9468cc07e3f51443a9a33d514c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5844dca/uploads/origins/a70d7b62-7331-4ead-883b-5e33f2bfa2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72562a00e591e6b4252c6b5f16f8bde9", "src_set": ""}, "body": "こんにちは！リクエストお願いしても大丈夫ですか？\n　\n描いて欲しいキャラ：空の境界より　黒桐鮮花、浅上藤乃、瀬尾静音\n　\nシチュ：\n・3人揃って一緒に学園の？大きなお風呂に入ってきゃっきゃうふふと会話してるイメージ。\n・タオルとかは身体に巻いてない(鮮花は頭にタオル巻いてて、ふじのんは視力の関係で髪縛ってるだけな感じ)ので、3人とも全部見えちゃってる。\n・鮮花ちゃんが幹也と式について相談してる感じのイメージ。不機嫌そうにぶつぶつ言ってる鮮花に「あはは…」と瀬尾ちゃん、「あらあら…」と余裕そうに微笑むふじのん\n\n差分：\n・大事なところとか隠してる湯気ありと、全部がっつり見えちゃってる湯気なし\n・もし出来たら、セリフレイヤーなど\n　\n以上お願いします…！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@weilaizuigao703/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3232544, "client_id": 396932, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af398298/uploads/origins/3edb2e80-54fa-48d5-9beb-6b0339fc7ce5?bg=%23