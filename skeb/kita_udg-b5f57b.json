、言動\n気のいいおじさんといった感じ\n裏腹に\n剣を振るう際は集中力も相まって人の好さが影をひそめる\n強さ、勝利への執念は息子の比ではない\n\nアレイの父親、元冒険者\n結婚を機に一線を退いて地元で剣術道場を開く\n現役時の異名は『銀狼』\n得物は息子と同じく長剣一本\n最前線からは離れたものの鍛錬を怠らず周囲の魔物討伐などは定期的に行っている実力者", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kita_udg/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 34058, "client_id": 83992, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f23be5d6/uploads/origins/af8734b3-9d62-40d6-afe4-59f64aa8b0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37e3c0091b6547bbd5a14946a0a7b762", "srcset": "https://si.imgix.net/f23be5d6/uploads/origins/af8734b3-9d62-40d6-afe4-59f64aa8b0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37e3c0091b6547bbd5a14946a0a7b762, https://si.imgix.net/f23be5d6/uploads/origins/af8734b3-9d62-40d6-afe4-59f64aa8b0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=083a8fa5ab062233b3ddb497c72d65ac 2x, https://si.imgix.net/f23be5d6/uploads/origins/af8734b3-9d62-40d6-afe4-59f64aa8b0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b188d054e0d79afbd31c8ebf113485c4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f23be5d6/uploads/origins/af8734b3-9d62-40d6-afe4-59f64aa8b0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=987cdec66fab6c296eef1d670e4c905d", "srcset": "https://si.imgix.net/f23be5d6/uploads/origins/af8734b3-9d62-40d6-afe4-59f64aa8b0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=987cdec66fab6c296eef1d670e4c905d, https://si.imgix.net/f23be5d6/uploads/origins/af8734b3-9d62-40d6-afe4-59f64aa8b0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=21c917fd7db537aeebfd698c653e7084 2x, https://si.i