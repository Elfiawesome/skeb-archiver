い性格です。お好きなように描いてください（人間姿と犬の姿があります）\n\nhttps://drive.google.com/drive/folders/1ozKkbrR9FF7_aUXG482YMdx4Yjq6Aq9O?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@EbiMaYo595/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4085267, "client_id": 3647873, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4afa74ea/uploads/origins/26fd4f75-c7aa-4d00-9be1-9ea6cbb553e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=856522601d975210c2b73f09f7344598", "srcset": "https://si.imgix.net/4afa74ea/uploads/origins/26fd4f75-c7aa-4d00-9be1-9ea6cbb553e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=856522601d975210c2b73f09f7344598, https://si.imgix.net/4afa74ea/uploads/origins/26fd4f75-c7aa-4d00-9be1-9ea6cbb553e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2c5e549f8c47cf2769a3c00b4fe4475 2x, https://si.imgix.net/4afa74ea/uploads/origins/26fd4f75-c7aa-4d00-9be1-9ea6cbb553e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26e5395fc28b3c7c43f95f9b364072e8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4afa74ea/uploads/origins/26fd4f75-c7aa-4d00-9be1-9ea6cbb553e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d672d9d7a2ac02d83c8ee29364a57069", "srcset": "https://si.imgix.net/4afa74ea/uploads/origins/26fd4f75-c7aa-4d00-9be1-9ea6cbb553e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d672d9d7a2ac02d83c8ee29364a57069, https://si.imgix.net/4afa74ea/uploads/origins/26fd4f75-c7aa-4d00-9be1-9ea6cbb553e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=407397f952a529b9587afc04d87b600f 2x, https://si.imgix.net/4afa74ea/uploads/origins/26fd4f75-c7aa-