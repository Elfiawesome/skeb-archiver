ins/b9d08443-6504-4c3e-9713-03afdde0a328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98ca621a44eb8713732b2c65ae1ecb49, https://si.imgix.net/ea1e8a3e/uploads/origins/b9d08443-6504-4c3e-9713-03afdde0a328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e78e0008952b91ae794079c35652b6a3 2x, https://si.imgix.net/ea1e8a3e/uploads/origins/b9d08443-6504-4c3e-9713-03afdde0a328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6218ccef974df12351d85d9fb99ead18 3x"}, "body": "【描いてほしいキャラクター】\n『ありえんガール』のツム子ちゃん\n\n【イラストのイメージ】\nありえんガールの4コマ漫画のNo6、\nバレンタイン4コマの続きになるイメージで、ミモちゃんが後ろ手に隠し持っていたチョコを手渡された瞬間のツム子ちゃんを描いていただきたいです！\n\n【構図などの指定】\n構図はできればバストアップで、ツム子ちゃんの表情がよく分かる正面〜少し斜め前からの視点でお願いします！\n加えて、ミモちゃんの手やチョコが映り込んでいて「あぁ、これはミモちゃんからチョコを手渡された瞬間なんだな」と実感できると私がハッピーになります！\n※ ただし、「こっちの方がよりツム子ちゃんの可愛さや二人の関係性を演出できる」という構図やアイデアがあればそちらを優先して下さって問題ございません！\n\nまた、表情に指定はありません！\nツネモクさんの思う、ミモちゃんからチョコを手渡された瞬間のツム子ちゃんはこんな顔をしただろう、というツム子ちゃんの表情を描いてくださいませ！！\n\n\n以上、ご査収のほどよろしくお願いいたします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsunemoku/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1687766, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5bfde70/uploads/origins/bbfbd192-3a59-44ef-825f-94fd643a0e83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7471ef5ca6ea38ea280cd2bc6de98c4", "srcset": "https://si.imgix.net/c5bfde70/uploads/origins/bbfbd192-3a59-44ef-825f-94fd643a0e83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7471ef5ca6ea38ea280cd2bc6de98c4, https://si.imgix.net/c5bfde70/uploads/origins/bbfbd192-3a59-44ef-825f-94fd643a0e83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa7c31f6c72b3d882a436aadc492a8ff 2x, https://si.imgix.net/c5bfde70/uploads/origins/bbfbd192-3a59-44ef-825f-94fd643a0e83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=182fff8df539d96a5689d0449f1ce4bc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5bfde70/uploads/origins/bbfbd192-3a59-44ef-825f-94fd643a0e83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69e0b77359e1fbf6f18ee92c50dfbc8d", "srcset": "https://si.imgix.net/c5bfde70/uploads/origins/bbfbd192-3a59-44ef-825f-94fd643a0e83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69e0b77359e1fbf6f18ee92c50dfbc8d, https://si.imgix.net/c5bfde70/uploads/origins/bbfbd192-3a59-44ef-825f-94fd643a0e83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b308b3f6f895f3f491b91526774aeecd 2x, https://si.imgix.net/c5bfde70/uploads/origins/bbfbd192-3a59-44ef-825f-94fd643a0e83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b4845b94128064a23287f06dcd333cab 3x"}, "body": "はじめてのskebで、何か間違っていたらすみません。\nいつもあなたのイラストを拝見して癒されていて、意を決して依頼をしてみました。\n\n神撃のバハムート及びシャドウバースシリーズの「フェザーフォルク・リノ」ちゃんと「ウォーターフェアリー」ちゃんを描いていただきたいです。\n※シャドウバースシリーズに「リノ」というキャラは複数いますが、鳥の羽が生えた銀髪のヘソだしルックの女の子が「フェザーフォルク・リノ」ちゃんです。\nまた、ウォーターフェアリーちゃんはシャドウバースでいう進化後の衣装であると好ましいです。分からなければこの限りではありません。\n\n二人が一緒にジャンプしているようなポーズで、リノちゃんは両手を上げて元気いっぱいな感じでお願いします。表情は口元はにっこりと、目は瞑っていない笑顔を見せていると最高です。\nウォーターフェアリーちゃんはややはにかみながらこちらに目線を向けていますます。ポーズに指定はないですがスカートがめくれないかどこか気にしているような印象をそこはかとなく感じるような感じだと嬉しいです。(少し内股気味だったり、片手をそれとなくいつでもスカートを抑えられそうな位置にポジショニングしているなど)\n\nまたウォーターフェアリーちゃんは水辺に住んでいるので衣服、特に下半身にかけての部分はやや濡れてわずかに透けていると最高です。\n\nご検討お願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsunemoku/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1687766, "client_id": 274503, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/