"こんにちは！\n\nhttps://twitter.com/tsunemoku/status/1680382276679639040、写真を1枚追加でお願いしたいのですが。\n\nキャラクターはエヴァンゲリオンの霧島マナです。コンテクストは、彼女が他の女の子から離れて海で泳いでいるというものです。楽しそうに泳いでいる霧島を下から見ている。顔が丸見えである。\n\nビキニのデザインも含めて、あとはあなたのクリエイティブな判断にお任せします。霧島が水面近くにいるが、まだ水中数メートルであることを示す光のフィルターがあってもよい。\n\nhttps://i.pinimg.com/550x/6a/d0/24/6ad02495b5b0e44dcd83e7d65ae1433f.jpg", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsunemoku/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1687766, "client_id": 1379093, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72246963/uploads/origins/3a73d72b-7159-4229-bd00-ab3a77517e71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=910b5f3887bd5e93e1e6375ddc750090", "srcset": "https://si.imgix.net/72246963/uploads/origins/3a73d72b-7159-4229-bd00-ab3a77517e71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=910b5f3887bd5e93e1e6375ddc750090, https://si.imgix.net/72246963/uploads/origins/3a73d72b-7159-4229-bd00-ab3a77517e71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5541817e62f97530ab11d83f38324f07 2x, https://si.imgix.net/72246963/uploads/origins/3a73d72b-7159-4229-bd00-ab3a77517e71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=300400108c1a9b52b294a006a410bdf5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72246963/uploads/origins/3a73d72b-7159-4229-bd00-ab3a77517e71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=adef89f04902bb8fb1cdfeedb75b0a76", "srcset": "https://si.imgix.net/72246963/uploads/origins/3a73d72b-7159-4229-bd00-ab3a77517e71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=adef89f04902bb8fb1cdfeedb75b0a76, https://si.imgix.net/72246963/uploads/origins/3a73d72