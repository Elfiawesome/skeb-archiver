5f8-a28d-416e-a485-0193ebdcbfa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11f85c3f260a8fe34e3345969b8f830b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b51d8783/uploads/origins/481395f8-a28d-416e-a485-0193ebdcbfa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7d44dcf7cef37b57bd227a307214f0c", "srcset": "https://si.imgix.net/b51d8783/uploads/origins/481395f8-a28d-416e-a485-0193ebdcbfa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7d44dcf7cef37b57bd227a307214f0c, https://si.imgix.net/b51d8783/uploads/origins/481395f8-a28d-416e-a485-0193ebdcbfa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1694f9b70f8729d7cff8e7207809d344 2x, https://si.imgix.net/b51d8783/uploads/origins/481395f8-a28d-416e-a485-0193ebdcbfa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=99252c9294c0b6c8b6b83c7950086e5e 3x"}, "body": "こんばんは。日頃より可愛らしい、エモいシチュエーションな画の数々、心より癒されております。\n特に他の方の依頼したアズレンの娘達の画がとても素晴らしく、以前より依頼したく思っていました。\nと言う訳で同作よりネプチューンとチェシャーを描いて欲しいです。\n季節柄（12～2月）に因んだシチュエーションや衣装だと嬉しいですが、難しい様であればデフォルトの、他に着せたい衣装等あればそれでも構いません。極論ではありますが、2人が仲良くしてるのが分かる様な画であればシチュエーションやポーズ、背景等諸々もお任せします。\n漠然とした依頼ではありますが、どうぞよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FD_jin00/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 501405, "client_id": 113383, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9cbb7403/uploads/origins/3c00e289-7caf-4d95-b821-9b6e328f5573?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25208c24c0523a13a9f6e4a7eea41395", "srcset": "https://si.imgix.net/9cbb7403/uploads/origins/3c00e289-7caf-4d95-b821-9b6e328f5573?bg=%23fff&auto=format%2Ccompress&fm=webp&f