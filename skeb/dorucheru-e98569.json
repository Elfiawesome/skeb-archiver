！\n分かりにくい箇所などは描きやすいようにアレンジして頂いて構いません！\n\nイラストの構図や雰囲気はちゃんさんのご自由に描いていただいて構いません！\nちゃんさんの思う解釈で描いて頂けましたら幸いです🙇🏻‍♂️  \n\nお忙しい中かとは思われますが、何卒よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1aU4YSbRjv5nwtRcNRc6zVuGZ95uB_S2Q", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dorucheru/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1ed09cab/uploads/origins/aec42cb2-c094-4028-be8f-d3976b588303?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0020a0031ac63383cb01d4bde23c466", "srcset": "https://si.imgix.net/1ed09cab/uploads/origins/aec42cb2-c094-4028-be8f-d3976b588303?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0020a0031ac63383cb01d4bde23c466, https://si.imgix.net/1ed09cab/uploads/origins/aec42cb2-c094-4028-be8f-d3976b588303?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4e1f70dd38fb5f959e25b0eb38c4b9e 2x, https://si.imgix.net/1ed09cab/uploads/origins/aec42cb2-c094-4028-be8f-d3976b588303?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7d30e348d2bef92dabf8ab12767dd7e 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1934671, "nc": 16}, {"path": "/@dorucheru/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a5edb8fe/uploads/origins/8348a667-1330-48a3-8aa2-ea6cf6aa5fb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=728b9fa377301d1825553ee113f4aee9", "srcset":