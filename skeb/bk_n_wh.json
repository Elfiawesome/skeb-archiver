youtube.com/shorts/Rt4HlzKEGZo?si=1a49_qAoqmy41QXB\nを参考に描いて頂けたらと思います。\n\n天使と悪魔の資料としましては、\n七海くんに対して天使と悪魔が囁いており\n①天使に囁かれて少しデレている（ツンデレのような）状態であたふたしている様な表情\n②悪魔に囁かれて悪い顔をしてニヤッと笑っている様な描写を描いていただけたらと思います…\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT6S145hxbFWZUY0NzXZi9uS_w8u7T__YabUw&usqp=CAU\n\nまた、今回は天使と悪魔をちびキャラで描いて頂きたいと思っております。\nイメージとしてはこの様な感じです。\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQS01lXuMLc5sq0u7i3Zff7wdpBRQTmmsfLLg&usqp=CAU\n\n長々となってしまい申し訳ございません。\nお忙しいと思いますが、可能であれば宜しくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bk_n_wh/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1905259, "client_id": 83672, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66c8b2dd/uploads/origins/fca146a6-2959-4c84-98f0-70c70bcaccd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77d15f497773748ee8867b64ee519f0b", "srcset": "https://si.imgix.net/66c8b2dd/uploads/origins/fca146a6-2959-4c84-98f0-70c70bcaccd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77d15f497773748ee8867b64ee519f0b, https://si.imgix.net/66c8b2dd/uploads/origins/fca146a6-2959-4c84-98f0-70c70bcaccd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d8b5cfafaa6dfb66f8c45e22c2adbc1 2x, https://si.imgix.net/66c8b2dd/uploads/origins/fca146a6-2959-4c84-98f0-70c70bcaccd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99703fad6459befa7059938d83b7d92d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66c8b2dd/uploads/origins/fca146a6-2959-4c84-98f0-70c70bcaccd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a062eced000ef8f185752efa8dbae52", "srcset": "https://si.imgix.net/66c8b2dd/uploads/origins/fca146a6-2959-4c84-98f0-70c70bcaccd7?bg=%23ff