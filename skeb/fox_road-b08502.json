://si.imgix.net/ac296141/uploads/origins/84802779-e70a-4a53-af0a-1d95accc6ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=979fda4e92aa3a35446314ab235e4bf2", "srcset": "https://si.imgix.net/ac296141/uploads/origins/84802779-e70a-4a53-af0a-1d95accc6ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=979fda4e92aa3a35446314ab235e4bf2, https://si.imgix.net/ac296141/uploads/origins/84802779-e70a-4a53-af0a-1d95accc6ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8662be7cb70dee785889d5d3501d17c7 2x, https://si.imgix.net/ac296141/uploads/origins/84802779-e70a-4a53-af0a-1d95accc6ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=43d306d690da8fa94e5998f4b2708653 3x"}, "body": "はじめまして！お会いできて光栄です。あなたの美しい画風に大変感銘を受けました。特に犬たちの描写には驚かされました、本当にクールです！可愛い女の子のイラストもお描きいただけるなら、ぜひご依頼させていただきたいです。\n\n犬耳VTuberが『もののけ姫』のようにオーストラリアン・シェパードを嬉々として乗っているイラストをご依頼したいです。ポーズやデザイン、オーストラリアン・シェパードのサイズ変更など、ご自由にアレンジください。予算が許せば、小さなポメラニアンが一緒に座っている様子も追加していただけると嬉しいです（任意です）。\n\n完成品は壁に飾るため、A3サイズでの制作をお願いできれば幸いです（こちらも任意です）。お読みいただきありがとうございます。🙏 https://drive.proton.me/urls/5VWXV75Y60#uOpbzdjUdbWC", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fox_road/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 827123, "client_id": 1571002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65ad434c/uploads/origins/c212dd93-db96-4b4e-9cf3-27f6b58ed0cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bed0f3dc1c38679747f19971cacd5dfd", "srcset": "https://si.imgix.net/65ad434c/uploads/origins/c212dd93-db96-4b4e-9cf3-27f6b58ed0cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bed0f3dc1c38679747f19971cacd5dfd, https://si.imgix.net/65ad434c/uploads/origins/c212dd93-db96-4b4e-9cf3-27f6b58ed0cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0805cd2c59384b63054dce719faadd0f 2x, https://si.imgix.net/65ad434c/uploads/origins/c212dd93-db96-4b4e-9cf3-27f6b58ed0cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ccef6ab491fe4211e9ae897b21ce540f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65ad434c/uploads/origins/c212dd93-db96-4b4e-9cf3-27f6b58ed0cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03671308afd10fc8acaa5f7c1f92d5b8", "srcset": "https://si.imgix.net/65ad434c/uploads/origins/c212dd93-db96-4b4e-9cf3-27f6b58ed0cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03671308afd10fc8acaa5f7c1f92d5b8, https://si.imgix.net/65ad434c/uploads/origins/c212dd93-db96-4b4e-9cf3-27f6b58ed0cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b2005a5340be222e7a4bb2bbaa88d0d 2x, https://si.imgix.net/65ad434c/uploads/origins/c212dd93-db96-4b4e-9cf3-27f6b58ed0cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb823b2acf1399b4e5eeaf570e4df38a 3x"}, "body": "こんばんは、初めまして。\n白躯不在と申します。\n以前から箱舟さんの描かれる動物や創作生き物が好きで、作品を拝見させていただいてました。\nこの度のキャンペーンでskebを開かれたのを知り、この機に是非にうちの子を描いていただきたく、リクエストを送らせていただきました。\n\nフォロワーからイメージを貰って作った子です。\nはつかねずみに炎を纏わせた火鼠です。\n首回り、手足首、尻尾の先に炎を灯っています。\nはつかねずみを素体にしているので、手のひらサイズをイメージしてます。\nおめめは黄(金)色です。\n画像資料はグーグルドライブにて提出致します。\nこちらの子を、是非箱舟さんの絵柄で見たいと思います！\n\n一枚絵も魅力的ですが、TRPGというゲームのGMコマとして使っている(資料1.2)ので、個人観賞以外に、コマとして使用できるよう、拝啓透過で描いていただけたら嬉しいです。\nポーズなどはお任せ致します。\n\n以上が依頼内容となります。\n金額が不十分だったり、依頼内容的に難しい、などありましたら断っていただいて構いません。\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1zNK_nA5kLNmd3RJ8v-swN2fBnQJ7KlN9?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fox_road/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 827123, "client_id": 71536, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8e946bb/uploads/origins/809f31ec-8d0c-4b5f-923d-63c869d45758?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fc3790f1ec4a4c0a606ed43672c001f", "srcset": "https://si.imgix.net/b8e946bb/uploads/origins/809f31ec-8d0c-4b5f-923d-63c869d45758?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fc3790f1ec4a4c0a606ed43672c001f, https://si.imgix.net/b8e946bb/uploads/origins/809f31ec-8d0c-4b5f-923d-63c869d45758?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1862cade47691d530395235770b8631e 2x, https://si.imgix.net/b8e946bb/uploads/origins/809f31ec-8d0c-4b5f-923d-63c869d45758?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=464878d07d4c5689cc037c8d6d1745c7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8e946bb/uploads/origins/809f31ec-8d0c-4b5f-923d-63c869d45758?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f39146ab1d8ef4f160cd3ba453f812f", "srcset": "https://si.imgix.net/b8e946bb/uploads/origins/809f31ec-8d0c-4b5f-923d-63c869d45758?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f39146ab1d8ef4f160cd3ba453f812f, https://si.imgix.net/b8e946bb/uploads/origins/809f31ec-8d0c-4b5f-923d-63c869d45758?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d8855b4c27471744b978a2e6daf1e10a 2x, https://si.imgix.net/b8e946bb/uploads/origins/809f31ec-8d0c-4b5f-923d-63c869d45758?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=acceca6efa8c5cdb7aedb7e17071c37c 3x"}, "body": "こんにちは、箱舟さん、\n\nお元気ですか？もしよろしければ、私の妖狐をもう一度描いていただけませんか？\n\nアンソロの姿のまま、妖気を抑えるためのペンダントを外してほしい。彼はエレガントさを失い、攻撃的になって戦いに臨むだろう。もしかしたら、\"狐火 \"で敵を焼くかもしれないし、刀を抜いて攻撃するかもしれない。その表情やポーズが、この瞬間、彼が理性的でないことを物語り、妖怪の恐ろしさを見せてくれるだろう。\n\n参考\nhttps://drive.google.com/file/d/1Fq8JMwQG0xeEXoO-Gvy4OlUTIuaGLS-J/view?usp=sharing\n\n彼の正確な服装を決めるのも、適当に変更するのも自由です。また、妖怪であることが伝わるのであれば、他のシーンやポーズも自由に描いてください！\n\nありがとうございました！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fox_road/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 827123, "client_id": 3376823, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ed7bbb9/uploads/origins/6d6c9c98-ce47-4650-9703-f0cb23bb7e47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59d63c6134886546ee1735b84cb416d4", "srcset": "https://si.imgix.net/0ed7bbb9/uploads/origins/6d6c9c98-ce47-4650-9703-f0cb23bb7e47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59d63c6134886546ee1735b84cb416d4, https://si.imgix.net/0ed7bbb9/uploads/origins/6d6c9c98-ce47-4650-9703-f0cb23bb7e47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6513cdbadb0b443aa1bcdf15f7d4b7d 2x, https://si.imgix.net/0ed7bbb9/uploads/origins/6d6c9c98-ce47-4650-9703-f0cb23bb7e47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6480db0fb2980f6966251226fb7738b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ed7bbb9/uploads/origins/6d6c9c98-ce47-4650-9703-f0cb23bb7e47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1066044b20c01f9131f2dd1447f38130", "srcset": "https://si.imgix.net/0ed7bbb9/uploads/origins/6d6c9c98-ce47-4650-9703-f0cb23bb7e47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1066044b20c01f9131f2dd1447f38130, https://si.imgix.net/0ed7bbb9/uploads/origins/6d6c9c98-ce47-4650-9703-f0cb23bb7e47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3ee55bcccf029c1a34202a5c6733bf36 2x, https://si.imgix.net/0ed7bbb9/uploads/origins/6d6c9c98-ce47-4650-9703-f0cb23bb7e47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6a1f93d1a15338908a5c0d230aa3ab2a 3x"}, "body": "こんにちは、ハコブネさん。あなたの絵を見て、ドラゴンの描き方がとてもかっこよくて感動しました！私の龍を描いていただけませんか？\n\n私のドラゴンの全身シーンの絵が欲しいのです。彼は純粋な憎しみと復讐心に満ちた戦士で、数え切れないほどの戦争を戦い、勝利した復讐に燃える暴君です。私の物語では悪い悪者です！地獄の業火を武器とし、恐怖を表現するドラゴン。\n\nこのアート(https://x.com/u_shi_art/status/1944864751210713429)にあるような剣や武器を入れてもらえると嬉しいです！\n\nポーズとしては、恐ろしげなもの、力強いもの、できれば全身にしてください。\n\n背景はこのようなもの（https://x.com/u_shi_art/status/1943578830352060492/photo/1）がいいと思います。名前はわかりませんが、このアートをアイデアとして使ってください！\n\n彼の翼は固い形をしていないので、好きなように変えることができます！\n\nありがとうございました！\n\n私のドラゴン: https://drive.google.com/drive/folders/1s-FG7GBZ6E8S_wOts2gzIw3jJ203SM19", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fox_road/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 827123, "client_id": 71536, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb940561/uploads/origins/b5fe2cfa-1da7-4429-befd-ad959a7e1980?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01009441b3bb11813140387a56fee6b6", "srcset": "https://si.imgix.net/fb940561/uploads/origins/b5fe2cfa-1da7-4429-befd-ad959a7e1980?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01009441b3bb11813140387a56fee6b6, https://si.imgix.net/fb940561/uploads/origins/b5fe2cfa-1da7-4429-befd-ad959a7e1980?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=614ea201d4fa5fe6167255c100bab75d 2x, https://si.imgix.net/fb940561/uploads/origins/b5fe2cfa-1da7-4429-befd-ad959a7e1980?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=986a4ddf9822df552533047983ab31a6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_u