: กลางวัน ซันไชน์ สดใส \nสีหน้า: หน้ายิ้มแย้ม \n\nPropsที่สามารถวาดใส่ในภาพได้ (หากต้องการวาด แต่จะวาดมือเปล่าก็ได้ค่ะ):\nธนูญี่ปุ่น, หน้ากากจิ้งจอก, ดอกไม้อะไรก็ได้, ขนมญี่ปุ่น เช่นดังโงะ\n\nภาพคาร์ทั้ง 2 Option อยู่ใน Reference URL ค่ะ\n\nhttps://imgur.com/Dgx5NjA", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 2407130, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ﾓﾛﾍｲﾔ", "screen_name": "tznb_last", "avatar_url": "https://pbs.twimg.com/profile_images/1816302030409125888/AAc6mudW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/940552320495976448/1634559181/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 3148399, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ﾌﾟﾛﾍﾟﾗ", "screen_name": "000_puropera", "avatar_url": "https://pbs.twimg.com/profile_images/1854556066207727616/6EcaUWM7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1479858499958210567/1753163060/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 128}, {"id": 3175745, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ᴏᴘᴏᴘᴏᴘᴏɴ", "screen_name": "opopopon171498", "avatar_url": "https://pbs.twimg.com/profile_images/1772218462611615744/E0IsHQ5_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1772171409416216576/1747835228/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_mas