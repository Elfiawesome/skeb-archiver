&s=1f7dbf8d680727b7ead0e8fab37b3ef6 2x, https://si.imgix.net/893fc911/uploads/origins/f24c579a-107d-48fd-b52a-8877d666cb2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=012cca65f13c1a2792e9c89727dab55e 3x"}, "body": "สวัสดีค่ะคุณ 睡・Sui 🙏\n\nอยากจะมารีเควสต์งานอาร์ต OC ของเราเองเป็น personal use ในหัวข้อ \" น้องยูบิงานเทศกาลหน้าร้อนกับของกินสุดอร่อย! \" ค่ะ\n\nน้องยูบิ แต่งตัวแต่งหน้าสวย ลุคสาวน้อยน่ารัก ร่าเริง ดูจากภายนอกแล้วอายุประมาณ 19 - 20 สวมชุดยูกาตะสีสว่าง แต่งตัวทำผมทรงสวยได้มาเที่ยวที่งานเทศกาลหน้าร้อนตอนกลางคืน และได้ทานไก่คาราอาเกะทอดสดใหม่ที่มาในถาดเรือนัวร์ ๆ แซ่บ ๆ ที่อร่อยที่สุดในชีวิตจิ้มเข้าปากไป แสดงสีหน้าอร่อยและมีความสุขด้วยรอยยิ้มทั่วทั้งใบหน้า\n\nตัวน้องยูบิ สามารถออกแบบทรงผม แต่งหน้า แต่งตัว เลือกกระเป๋าถือ เลือกยูกาตะให้ได้เต็มที่เลยนะคะ\n\nอาจมีฉากหลังง่าย ๆ ด้วยได้ แต่ไม่ต้องละเอียดมากก็ได้ค่ะ\n\nสัดส่วนรูปที่อยากได้เป็น 16:9 (แนวนอน) ค่ะ หรือแบบอื่นได้ตามความเหมาะสมได้เลยค่ะ\n\nคอมโพสของรูป อยากได้รูปที่มีความเอียงนิดหน่อยถึงปานกลาง และเน้นตัวเอกเป็นหลักค่ะ\n\nไฟล์รูป (ถ้าเป็นไปได้) อยากจะขอไฟล์แบบแยกเลเยอร์ (.psd / .clip) หรือแบบแยกตัวละครกับเอฟเฟคกับฉากหลังเฉย ๆ แนบมาด้วยค่ะ 🙏\n\nอาจจะมีการไฟล์นำมาดัดแปลงต่อเพื่อการศึกษาเท่านั้นนะคะ\n\nฝากเนื้อฝากตัวด้วยนะคะ ขอบคุณล่วงหน้าค่ะ~\n\nhttps://drive.google.com/drive/folders/1flp8AY0sliV-pc_1RsT5-CvL65PzDtMq?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@89sui_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3250885, "client_id": 3257873, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fcfe7246/uploads/origins/bf45215f-06e6-47af-994f-ef0a3e3deed6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08393bcfa8e33f9673a6bb14ae7e464c", "srcset": "https://si.imgix.net/fcfe7246/uploads/origins/bf45215f-06e6-47af-994f-ef0a3e3deed6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cr