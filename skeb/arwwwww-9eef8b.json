式】\n人物(背景透過)と背景(もしあれば)サインをそれぞれレイヤーをわけてPNG・PSD納品していただけると大変有難いです。\n\n長くなりましたが、ご検討の程よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1b7VCRGIR8g6k0hCwdHubCxaPZzoxGHGR", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arwwwww/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3065010, "client_id": 2905886, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b6f0abb/uploads/origins/3032b372-d79f-4a02-906a-5fd5f8e8e9d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9086c103112a0175220e7dbe7ef77851", "srcset": "https://si.imgix.net/6b6f0abb/uploads/origins/3032b372-d79f-4a02-906a-5fd5f8e8e9d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9086c103112a0175220e7dbe7ef77851, https://si.imgix.net/6b6f0abb/uploads/origins/3032b372-d79f-4a02-906a-5fd5f8e8e9d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fe20e2f0dd9b2283b548b7d69e65605 2x, https://si.imgix.net/6b6f0abb/uploads/origins/3032b372-d79f-4a02-906a-5fd5f8e8e9d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2442ae03184ad9b32a9db55c46da8fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b6f0abb/uploads/origins/3032b372-d79f-4a02-906a-5fd5f8e8e9d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03cf8a3ddeff9bebae2c1ed654f91933", "srcset": "https://si.imgix.net/6b6f0abb/uploads/origins/3032b372-d79f-4a02-906a-5fd5f8e8e9d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03cf8a3ddeff9bebae2c1ed654f91933, https://si.imgix.net/6b6f0abb/uploads/origins/3032b372-d79f-4a02-906a-5fd5f8e8e9d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0beb89c62a73605577c836e34d06efbf 2x, https://si.imgix.net