ault_amount": 10000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@hataranightstar/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 568073, "client_id": 87042, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5fed5b5f/uploads/origins/c81cdba6-3b0f-46f0-abca-a187fb045b39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cc68161dacd047b2454cba74f5e61be", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5fed5b5f/uploads/origins/c81cdba6-3b0f-46f0-abca-a187fb045b39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a96a51625b082ac214a6f82f196fd0d", "src_set": ""}, "body": "以前描いて頂いたような培養ポッドに入れられているイラスト希望です。\n\nキャラクタ\n　デモンベイン\n　アルアジフ、エセルドレーダ、アナザーブラッド\n\nシチュエーション\n　一人ずつ培養ポッドに入れられている状態（前回みたいにマスクなし状態）\n（PC壁紙のようなワイドの絵を希望）\n\n捕まり苛烈な調教を受け悪堕ち\n　手足の拘束と鎖は魔法的な物ではなく、金属でお願いします。\n　衣装は通常版と、胸やアソコが見えてる状態、裸の３パターン希望\n　最初３人とも調教には屈しないといった表情\n\n\n調教内容\n　乳首やクリに薬を注射やピアスを付けられ引っ張り状態\n　クパベルトでアソコを強制開帳\n　先端がドリル型のケーブルを膣に挿入（入れる直前のイラストも出来たらお願いします）\n　膣や尿道に入れられたケーブルから魔力吸収\n\n表情差分\n　余裕の笑み、怒り顔、泣き顔、睨み、放心状態\n　　アルアジフは感情的に\n　　エセルドレーダは理性的に\n　　アナザーブラッドは挑発気味に\n\n予算の範囲で構いませんが、可能でしたら下記を希望します。\n　・各パーツのレイヤ分け\n　・悪堕ち状態\n　　　通常衣装をベースに胸のアソコが露出した状態で微笑を浮かべている感じ\n　　（クリや乳首に妖しく光る宝石のついたピアスを装着希望）\n\nキャラクターの衣装等はURLを参照願います。\n\n検討よろしくお願いします。\n\nhttps://www.dropbox.com/scl/fo/bsgafktoj4yocl6b2h2ud/APOg-YNnoSovw1dNz6uN1Q4?rlkey=6haujkz7ylgrvd6vyaig08mkt&dl=0", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hataranightstar/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 568073, "client_id": 87042, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08be3e3a/uploads/origins/af8b1c56-b70c-4899-a276-d7968503776e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf702420c333db21309d88d666e43f5e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08be3e3a/uploads/origins/af8b1c56-b70c-4899-a276-d7968503776e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0435241c99f42db3b8d47d502c05885", "src_set": ""}, "body": "キャラクター　コードギアスのアーニャ\n\n基本構図\n　胸やアソコが見えているウエディングドレス\n　局部は宝石で隠しているのを希望\n　ドレスのオプションとして中指を通すようなアームカバー\n　アソコの宝石は4隅をベルトのような物で固定\n\n差分\n　宝石の着脱希望\n　　無しの時下はベルトでくぱぁ状態\n　　両胸はピアスとチェーンで連結（首とも繋がっているのを希望）\n　　クリにもピアスとチェーン\n　ドレスは破られお腹が見えてしまうバージョン\n　　お腹に淫紋\n　パイロットスーツ(布が少ない程嬉しいです）\n　表情は無表情をベースに喜怒哀楽などの変更可能なパターン希望\n\n差分は金額の範囲で構いませんがご検討願います。\n\nhttps://t.co/SCS7n4PtWM", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hataranightstar/works/23", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4838d498/uploads/origins/04b8ec4d-ceb7-4597-819a-132684381c61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4edd0b385e6e020eed6e403bccc2268", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 568073, "client_id": 2829683, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hataranightstar/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 568073, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c690c6cd/uploads/origins/f92ad11b-cf13-4682-be36-f7338de5c0f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fe9d655d30ce2d65d4e33e81102ec94", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c690c6cd/uploads/origins/f92ad11b-cf13-4682-be36-f7338de5c0f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da6be993c3f8dae0d59b5fd64e6bd2db", "src_set": ""}, "body": "いつもを作品を楽しく拝見させていただいています。\n宝珠の透け表現がとても気に入っています。\n早速リクエストを送らせていただきます。\nリリカルなのはよりシュテルの劇場版装備の逆バニー風衣装を希望します。\n以前描かれていた逆バニーキャロやコロナのような全身画のイメージでお願いしたいです。\n表情はお任せします。\nもし可能であれば服の着せ替えが出来ると嬉しいです。\nご検討頂ければ幸いです。\nよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hataranightstar/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 568073, "client_id": 2599757, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4dbc58b/uploads/origins/090fa323-62f3-4a89-bacc-3fea890ef8f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6aaf9b88b8608f0f51908fc3fb8bf3bc", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4dbc58b/uploads/origins/090fa323-62f3-4a89-bacc-3fea890ef8f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc1378425788de25049d1c05cd50c36a", "src_set": ""}, "body": "何度もお世話になりありがとうございますHATARA先生、ヴィータちゃんのNTRコミックを描いて頂きたく依頼したくリクエストしました。\n\n■キャラは魔法少女リリカルなのはStrikerSからヴィータちゃんを\n\n■衣装は騎士服でお願いします(帽子のみでも構いません)\n\n□シュチエーションは時空管理局の上役にそそのかされてはやてちゃんを守るための愛人契約を取り付けられて定期的に呼び出されて抱かれる、反抗的な態度を竿役に楽しまれている感じで反抗的な感じで嫌々抱かれている。\n既に軽く調教済みで初めてではなく竿役との身体の相性は抜群のシチュエーションでお願いします\n\n〇ヴィータちゃんがゴム装着おちんちんで下着の上からの素股をされ嫌がりながらも股間を濡らしコイツが欲しいんだろ的な感じで笑われてしまう２ページのコミックを希望します　\n\n☆身体は負けていても精神的には落ちていなうものを希望しますチン媚び描写等はNGで\n☆プレイはゴム有で行いたいのゴム描写をお願いします\n☆もし内容が問題なく受けて頂けるなら依頼等がこみあってないタイミング等お気軽に再送して頂けると幸いです\n\n多数の指定がありご迷惑かもしれませんがもし良ければ検討していただけると嬉しいです、よろしくお願いいたします。", "nc": 40, "word_coun