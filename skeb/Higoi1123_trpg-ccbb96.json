いでくださいよ…」\n「俺はこの職に誇りを持ってます。」\n\nとなっております  ご都合などもあり、難しいようでしたら断っていただいて構いません。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1WcLLIkiDkFGAJqZyywNKNdN6FwHpwcvs", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@teiri_55/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3711410, "client_id": 3824462, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1803f415/uploads/origins/6f24be5d-32e7-49eb-9994-187f52f5ebbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa74b572762cea42cb232249a668b284", "srcset": "https://si.imgix.net/1803f415/uploads/origins/6f24be5d-32e7-49eb-9994-187f52f5ebbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa74b572762cea42cb232249a668b284, https://si.imgix.net/1803f415/uploads/origins/6f24be5d-32e7-49eb-9994-187f52f5ebbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57ca278998fc9cfab251352e38967445 2x, https://si.imgix.net/1803f415/uploads/origins/6f24be5d-32e7-49eb-9994-187f52f5ebbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b73c1cdfe453826732e28b5574702210 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1803f415/uploads/origins/6f24be5d-32e7-49eb-9994-187f52f5ebbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0bfdb195cd2384150754c5f3c7bd63b3", "srcset": "https://si.imgix.net/1803f415/uploads/origins/6f24be5d-32e7-49eb-9994-187f52f5ebbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0bfdb195cd2384150754c5f3c7bd63b3, https://si.imgix.net/1803f415/uploads/origins/6f24be5d-32e7-49eb-9994-187f52f5ebbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e4417f2e704ce3aa631375ef12f9ed69 2x, https://si.imgix.net