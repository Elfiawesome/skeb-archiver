sion/VqIcis1nFI.png\n\n\n・シチュエーション\nハロウィンをテーマにしたイラストで、服装はパンプキン魔女なイメージ。\nデザインはハロウィンのイメージカラーを使用したへそ出しルックでやや露出高めの魔女姿で細かなデザインはお任せします。\n大きなお化け南瓜の上に腰掛けて優しい笑みを浮かべている。\nその他細かな構図等は描きやすい形でお任せします。\n\n・その他\n不明点、不自然な点は自由にアレンジして頂いて構いません。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 391216, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "れこ/Re:co（旧名Re:）", "screen_name": "Redd__009", "avatar_url": "https://pbs.twimg.com/profile_images/1886435015069949952/xBG0Cp1l.jpg", "header_url": "https://pbs.twimg.com/profile_banners/864346067650830338/1738597435/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 475389, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "キバやえば🦷", "screen_name": "kiba_yaeba", "avatar_url": "https://pbs.twimg.com/profile_images/1190427681927696384/crztNpBe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2294431974/1642224783/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 849711, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "gumiravi", "screen_name": "gumi0gumi", "avatar_url": "https://pbs.twimg.com/profile_images/1764241029950246912/8m8xdF1u.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1277040021636124673/1703005312/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable