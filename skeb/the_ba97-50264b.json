送らせていただきます。\n\n絵の内容といたしましてはタトゥーで依頼した際に描いていただいた男の子を描いていただきたく\nお客さんとして来ていて、シーシャを吸ってくつろいでいる姿を希望します。寝転んでいてもいいですし、ポーズはお任せします。できたら全身が嬉しいです。\n\n全体的な色味としては寒色系(青・緑)がいいです。\n\n服装、構図、その他はお任せいたします。\n\nイメージがしやすいようお店のURLを添付します。\n\nhttps://www.instagram.com/shishaspot_hotbox?igsh=MzRlODBiNWFlZA==\n\n参考になりましたら幸いです。\n\nいつも我儘を申し訳ございません。\nお忙しいところ恐れ入りますがご検討の程、よろしくお願いいたします。\n\nhttps://www.instagram.com/shishaspot_hotbox?igsh=MzRlODBiNWFlZA==", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@the_ba97/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 693565, "client_id": 1847164, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc5c4323/uploads/origins/707554d3-8046-4e1a-9b7d-a125077f4066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7376d1c7ed268332a8287a595b2dce52", "srcset": "https://si.imgix.net/dc5c4323/uploads/origins/707554d3-8046-4e1a-9b7d-a125077f4066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7376d1c7ed268332a8287a595b2dce52, https://si.imgix.net/dc5c4323/uploads/origins/707554d3-8046-4e1a-9b7d-a125077f4066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca7bebb1dcc0c41472e72cff7b8e5627 2x, https://si.imgix.net/dc5c4323/uploads/origins/707554d3-8046-4e1a-9b7d-a125077f4066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46f11896f62cabee4bcc19dcf9c149d1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc5c4323/uploads/origins/707554d3-8046-4e1a-9b7d-a125077f4066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec22e0a14d1e23fd04fc8d40eda55589", "srcset": "https://si.imgix.net/dc5c4323/uploads/origins/707554d3-8046-4e1a-9b7d-a125077f4066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec22e0a