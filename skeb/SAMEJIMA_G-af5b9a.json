mat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b6703bf22f38717d7a8f8fc712684d5, https://si.imgix.net/0d661f18/uploads/origins/4e61a85e-7ce3-43ac-b6df-29cfe893b2aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2b2d146873b92b9d395f1afa11096db 2x, https://si.imgix.net/0d661f18/uploads/origins/4e61a85e-7ce3-43ac-b6df-29cfe893b2aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec667abe8bee919ddb8c8afd333341c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d661f18/uploads/origins/4e61a85e-7ce3-43ac-b6df-29cfe893b2aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a2a0e6b7a59005b44dcd590961496d3", "srcset": "https://si.imgix.net/0d661f18/uploads/origins/4e61a85e-7ce3-43ac-b6df-29cfe893b2aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a2a0e6b7a59005b44dcd590961496d3, https://si.imgix.net/0d661f18/uploads/origins/4e61a85e-7ce3-43ac-b6df-29cfe893b2aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b28e9c2d9eb9489a6600b72432ca5f1 2x, https://si.imgix.net/0d661f18/uploads/origins/4e61a85e-7ce3-43ac-b6df-29cfe893b2aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=585bfb0f544a050b1a0aba023485bd9b 3x"}, "body": "こんにちは、客臘センセイの描くイラストがほんっっっまに推し絵師と名乗る位大好きで、1度しっかりお金を払って自創作のキャラを描いて欲しいと思ったのでこの度スケブをリクエストさせて頂きました。\n\n本題に移らせていただきます。\n今回描いていただきたいのは人間と人型人外(悪魔)の2人です。\n🔮ブラッドリー ラッセル(見た目年齢25〜35、身長185cm)\nイメージカラーは暗い赤\n相棒の悪魔である、ロディと契約してしまい国の禁忌とされる黒魔術師(ダークプリキュアみたいなもの)となった不老不死の人間、何をやるにも気だるげで何を提案しても嫌と拒否してきそうなダウナー系の男で、食事と喫煙が好きでお酒が大の苦手。\n相棒のロディに対しては何考えてるか分からないしいつもニコニコしている怖い悪魔という認識がある\n\n😈ロデリック ハスラー(見た目年齢20〜25、身長174cm)\nイメージカラーはくすんだ青緑\n愛称はロディ。基本返事や対応など諸々が軽く現代で言う陽キャのような雰囲気が漂っている\"大食漢の悪魔\"、柔らかく言うなら近所の優しいお兄ちゃん。\n食事とブラッドリーが大好きでブラッドリーに対してはなんでもしてあげたい、全てを教えてあげたいという欲がある\n\n詳しいデザインは以下のGoogleドライブをご参照下さい。\nhttps://drive.google.com/drive/folders/1-FZfZ1cdh-3PPSoVVoRoDmQVMw10L5tI\n\n基本自由に描いて頂きたいのですが、暖色系のイラストだと大興奮してしまうので、もし良ければ暖色系だと嬉しいです…。\nあと、使用用途としては個人観賞用と、スマホの待ち受けとして使用したく思っておりますので、もし宜しければキャンバスサイズは縦向きか、或いは正方形だと跳ねて喜んじゃいます。(特に正方形は大好きなキャンパスサイズなので、気が向いてアイデアが浮かべば是非…) \n\n金額不足の場合は再送要請していただいて構いません！何卒、よろしくお願いいたします…。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pom_art_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2312414, "client_id": 240830, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91aa2238/uploads/origins/f53d6d21-e2da-41f4-8afd-d6c1b75a7b34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0795c581fe3cca33642b2676f27af178", "srcset": "https://si.imgix.net/91aa2238/uploads/origins/f53d6d21-e2da-41f4-8afd-d6c1b75a7b34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0795c581fe3cca33642b2676f27af178, https://si.imgix.net/91aa2238/uploads/origins/f53d6d21-e2da-41f4-8afd-d6c1b75a7b34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a5d93cd06eb974559ed8e875f2d3b85 2x, https://si.imgix.net/91aa2238/uploads/origins/f53d6d21-e2da-41f4-8afd-d6c1b75a7b34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4901c90b6acb938a41ee4f5f6cdffc0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91aa2238/uploads/origins/f53d6d21-e2da-41f4-8afd-d6c1b75a7b34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=abdf4cf7ca870c00b13cd4dea942b8ec", "srcset": "https://si.imgix.net/91aa2238/uploads/origins/f53d6d21-e2da-41f4-8afd-d6c1b75a7b34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=abdf4cf7ca870c00b13cd4dea942b8ec, https://si.imgix.net/91aa2238/uploads/origins/f53d6d21-e2da-41f4-8afd-d6c1b75a7b34?bg=%23fff&auto=