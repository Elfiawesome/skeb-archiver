%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b076ad2518dd34c00d85a89e12ece8a7, https://si.imgix.net/71f90122/uploads/origins/5ec40cc2-924c-4762-8108-333aca857f07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dba37e80d0ffa3f86cd2ae15f727cb7c 2x, https://si.imgix.net/71f90122/uploads/origins/5ec40cc2-924c-4762-8108-333aca857f07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0407d3c53a3d8547d3fc86982f960d48 3x"}, "body": "こんにちは。以前TRPGで使用するうちの子の全身立ち絵を描いてもらったものです。その節はありがとうございました！今回は前回描いてもらった子の差分がほしいと思いリクエストしました。\n\n特徴\n・身長179 cm\n・ピアスが開いていない\n・服はイラストのようなものにタイツ、スニーカー\n・小物は眼鏡のみ\n・いつもニコニコしている\n・いくつかの表情差分がほしい（泣いてるものと照れてるものを追加）\n・ほどほどの胸（Dカップくらい）\n・前回の表情にメガネありの差分\n・服装やポーズは前回と同じもの\n\nまた透過したものも欲しいです。\nリクエストが多くて申し訳ありません。値段とリクエストが見合ってないと思えばお手間ですが再送のほどお願いします。\n前向きに検討していだけると幸いです\n\nhttps://drive.google.com/drive/folders/1SU6_YJ2zWzmVGZ4Gx55EroDoVjzSLNnY", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tu_lip5/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3708018, "client_id": 3707116, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbd48042/uploads/origins/811f6f46-68bf-4b45-b9a9-c560464c4199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d5131b3fb6d24f4120835522d25e5f9", "srcset": "https://si.imgix.net/cbd48042/uploads/origins/811f6f46-68bf-4b45-b9a9-c560464c4199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d5131b3fb6d24f4120835522d25e5f9, https://si.imgix.net/cbd48042/uploads/origins/811f6f46-68bf-4b45-b9a9-c560464c4199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7724e55704897754e777238f5a199d8 2x, https://si.imgix.net/cbd48042/uploads/origins/811f6f46-68bf-4b45-b9a9-c560464c4199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31c55e6a98be5006059fd00d777a8b37 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbd48042/uploads/origins/811f6f46-68bf-4b45-b9a9-c560464c4199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=158837679b0d9ddd6fffe0466efafb7e", "srcset": "https://si.imgix.net/cbd48042/uploads/origins/811f6f46-68bf-4b45-b9a9-c560464c4199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=158837679b0d9ddd6fffe0466efafb7e, https://si.imgix.net/cbd48042/uploads/origins/811f6f46-68bf-4b45-b9a9-c560464c4199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60124e035fb736ec6f81663a5b96018d 2x, https://si.imgix.net/cbd48042/uploads/origins/811f6f46-68bf-4b45-b9a9-c560464c4199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb3b6d72cbe466504a710a9af66ac33c 3x"}, "body": "はじめまして。今回貴方の絵柄でTRPGで使用するうちの子の全身立ち絵を描いてほしいと思いリクエストしました。\n\n特徴\n・身長179 cm\n・ピアスが開いていない\n・服はイラストのようなものにタイツ、スニーカー\n・小物は眼鏡のみ\n・いつもニコニコしている\n・いくつかの表情差分がほしい（喜怒哀楽）\n・ほどほどの胸（Dカップくらい）\n\nまた透過したものも欲しいです。\nリクエストが多くて申し訳ありません。値段とリクエストが見合ってないと思えばお手間ですが再送のほどお願いします。\n前向きに検討していだけると幸いです\n\nhttps://drive.google.com/drive/folders/1SU6_YJ2zWzmVGZ4Gx55EroDoVjzSLNnY", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tu_lip5/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3708018, "client_id": 3273138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5222d62a/uploads/origins/15e5544b-7da0-4889-aea3-667dd4109e78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e85e9eebfc830563908e414c0a8d8fef", "srcset": "https://si.imgix.net/5222d62a/uploads/origins/15e5544b-7da0-4889-aea3-667dd4109e78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e85e9eebfc830563908e414c0a8d8fef, https://si.imgix.net/5222d62a/uploads/origins/15e5544b-7da0-4889-aea3-667dd4109e78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5078895a8b57b12cc54195860202ce8b 2x, https://si.imgix.net/5222d62a/uploads/origins/15e5544b-7da0-4889-aea3-667dd4109e78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e255208c76b3e1d00a018a8b4780ebb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5222d62a/uploads/origins/15e5544b-7da0-4889-aea3-667dd4109e78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a7f407b96434eb723bf9ed00dee0a92", "srcset": "https://si.imgix.net/5222d62a/uploads/origins/15e5544b-7da0-4889-aea3-667dd4109e78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a7f407b96434eb723bf9ed00dee0a92, https://si.imgix.net/5222d62a/uploads/origins/15e5544b-7da0-4889-aea3-667dd4109e78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e10772e95a66c771e52c5904ae2d15e8 2x, https://si.imgix.net/5222d62a/uploads/origins/15e5544b-7da0-4889-aea3-667dd4109e78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=245750387097fb4c0d6774a021324e63 3x"}, "body": "チユ先生、こんにちは！よければ私のOC2人分の衣装デザインをセットでお願いしたいです。\n\n二人ともエンタメ業界に所属しており、モデルデュオとしてよく一緒に活動しています。\n\n💛🤍\n・中性的\n・かわいい妹やクールな兄さんやエレガントな姉など、何でも役柄を演じられできる\n・ヘアエクステがOKですのでお好みのスタイルにアレンジしてください。ロング、ツインテール、何でもOKです！\n・少なくとも髪の1つのヘアループを残してください（🤍は指で巻きながら遊ぶのが好きです\n・イメージは大理石の彫像（特に勝利の女神ニケ）のようなので、衣装はすべて🤍白🤍にしてください。アクセサリーは色付きでも構いません。\n\n💙🖤\n・裕福な令嬢で、ある日男装をしていたところを男性モデルとしてスカウトされました。自信をつけるために男性モデルとしての仕事を始めました。\n・そのため、🖤を「美しい顔立ちとスリムな体型の美少年モデル」として扱ってください\n・🤍と合わせるため、服装は全て🖤黒🖤にしてください。アクセサリーは色付きでも構いません。\n\n🤍(25)は🖤(18)より年上なので、裏では姉妹のような関係性がありますがカメラの前では、彼らは親密で力強いカップルとして描かれることがよくあります。方向性は自由です。\n\n必要はありませんが、ご参考までに：ペアテーマは「🤍空/🖤海」。個別に、🤍はイチョウの葉と翼を、🖤はクラゲをモチーフにしています。花のモチーフはレモンの花と忘れな草です。\n\n衣装の「目的」が「写真撮影」であるため、ファッションのジャンル、時代、モチーフ、テーマは自由です！良かったら、ゴシックな雰囲気の衣装を見たいです！先生の世界観の中で、うちの子供を表現していただけると嬉しいです。先生のお気に入りのスタイルや好みに合わせて、自由にコーディネートしてください！ドライブ内に参考資料はありますが、それらに限定される必要はありません。\n\n金額が不足している場合は、アピールをお送りください。デザインメモ、没ラフや下描きなどがあればPSDに残したままにしていただけると嬉しいです。長いお願いをお読みいただき、またご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1dkNj8ziFOCcwGwYaX7pJ6AKElGcF_NRP?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tu_lip5/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3708018, "client_id": 3306424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/005aef2a/uploads/origins/0669f240-9f66-4cc5-81e2-6c2739995a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=022a8123bfe7c30501e5bf1ab572f051", "srcset": "https://si.imgix.net/005aef2a/uploads/origins/0669f240-9f66-4cc5-81e2-6c2739995a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=022a8123bfe7c30501e5bf1ab572f051, https://si.imgix.net/005aef2a/uploads/origins/0669f240-9f66-4cc5-81e2-6c2739995a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5370790583e30ab60cc887dfa918848a 2x, https://si.imgix.net/005aef2a/uploads/origins/0669f240-9f66-4cc5-81e2-6c2739995a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20d17f966af936cbbf4fe756f2624df3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/005aef2a/uploads/origins/0669f240-9f66-4cc5-81e2-6c2739995a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4afa78872c785f1a2e903f93ecc6062", "srcset": "https://si.imgix.net/005aef2a/uploads/origins/0669f240-9f66-4cc5-81e2-6c2739995a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4afa78872c785f1a2e903f93ecc6062, https://si.imgix.net/