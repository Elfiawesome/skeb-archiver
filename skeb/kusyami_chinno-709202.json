上衣の丈短め)のため、肌着として薄手でピッタリとした形の黒いノースリーブハイネックシャツを着用させていただけると助かります(具体的な長さはお任せ)\nまた、制服資料にもある手袋は手首までの長さで、手首のあたりに中指の先にあるのと同じ金のラインと手首横らへんに桜結びの紐っぽい飾りがついているものをイメージしております。\n\n\n以上、どの程度反映させるかはお任せしますがどうぞよろしくお願いします。制服等のデザインは資料リンク先にございますので、ご確認ください。\n\nhttps://iachara.com/view/12938177", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kusyami_chinno/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3485708, "client_id": 2841872, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a18edcd1/uploads/origins/3eb593ad-f497-45b9-9757-b3232f51a3fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd5b8fa8c1fa76f7e1a14c7500d34388", "srcset": "https://si.imgix.net/a18edcd1/uploads/origins/3eb593ad-f497-45b9-9757-b3232f51a3fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd5b8fa8c1fa76f7e1a14c7500d34388, https://si.imgix.net/a18edcd1/uploads/origins/3eb593ad-f497-45b9-9757-b3232f51a3fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2cb1b31af9e54f351157767c72a3289c 2x, https://si.imgix.net/a18edcd1/uploads/origins/3eb593ad-f497-45b9-9757-b3232f51a3fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b6998e6a4f95cd8045a8446ec1bbf4b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a18edcd1/uploads/origins/3eb593ad-f497-45b9-9757-b3232f51a3fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f3e5aa32e620884ff1df417c7b9df73", "srcset": "https://si.imgix.net/a18edcd1/uploads/origins/3eb593ad-f497-45b9-9757-b3232f51a3fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f3e5aa32e620884ff1df417c7b9df73, https://si.imgix.net/a18edcd1/uploads/origins/3eb593ad-f497-45b9-9757-b3232f51a3fb?bg=%23fff&auto=format%2Ccompress&fm=web