2cf1d7/uploads/origins/a3687d35-76e8-4b71-8b46-c2cb539639b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2309c8fb91f02a18b82f68545e6bda28", "srcset": "https://si.imgix.net/c02cf1d7/uploads/origins/a3687d35-76e8-4b71-8b46-c2cb539639b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2309c8fb91f02a18b82f68545e6bda28, https://si.imgix.net/c02cf1d7/uploads/origins/a3687d35-76e8-4b71-8b46-c2cb539639b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63f0df969733477caa9099c026291b97 2x, https://si.imgix.net/c02cf1d7/uploads/origins/a3687d35-76e8-4b71-8b46-c2cb539639b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9bcbd035678c0536a8f214702215882 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c02cf1d7/uploads/origins/a3687d35-76e8-4b71-8b46-c2cb539639b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1217249987bd32923735aab5fcdfe44", "srcset": "https://si.imgix.net/c02cf1d7/uploads/origins/a3687d35-76e8-4b71-8b46-c2cb539639b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1217249987bd32923735aab5fcdfe44, https://si.imgix.net/c02cf1d7/uploads/origins/a3687d35-76e8-4b71-8b46-c2cb539639b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f7304019e67dc6c89bae91e4fa870503 2x, https://si.imgix.net/c02cf1d7/uploads/origins/a3687d35-76e8-4b71-8b46-c2cb539639b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b584f0634a34c3373a3b4069c36e74c6 3x"}, "body": "マッキーさん、　またコミッション機会を与えてくださり、ありがとうございます。依頼内容は以下の通りです。\n\n癒し系な冬の場面。内容は二人の友達、高速道路旁に雪像を二つ作ってるライチュウと巨大なロップモン。\nライチュウは小さなロップモンの雪像を作り、ロップモンは巨大なライチュウの雪像を作っている。\nロップモンは巨大 (身長10メートルぐらい)。その大きさのゆえ、ロップモンは道路に立ちふさがり、通行の妨げになり、うっかり車を踏みつぶしてしまう。\n雪像を作ることに気を取られているロップモンは、引き起こしている被害にはまったく注意を払っていない。\nライチュウはかなり小さく、ロップモンの足首までしか届かない。\nライチュウとロップモンの表情は、どちらも機嫌が良さそう。ライチュウは明るく幸せそうで、ロップモンは疲れているがリラックスしている。\n帽子の他に、ライチュウはかわいいマフラーも着ている。\n\n(ライチュウもロップモンもオリキャラで、添付した参考画像にあるような異色の詳細がある。)\n\nhttps://imgur.com/a/nTj2AyJ", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pokeshima/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 342655, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d93df3e0/uploads/origins/a59f184c-0d0b-41c8-8c22-3e3dab5b974e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a49a94722c2920b893c53089084d225a", "srcset": "https://si.imgix.net/d93df3e0/uploads/origins/a59f184c-0d0b-41c8-8c22-3e3dab5b974e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a49a94722c2920b893c53089084d225a, https://si.imgix.net/d93df3e0/uploads/origins/a59f184c-0d0b-41c8-8c22-3e3dab5b974e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49c5d7808b72d59ef958d8f178e80dde 2x, https://si.imgix.net/d93df3e0/uploads/origins/a59f184c-0d0b-41c8-8c22-3e3dab5b974e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9452272839a160e20bf845b00d655e6a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d93df3e0/uploads/origins/a59f184c-0d0b-41c8-8c22-3e3dab5b974e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb44cdcc7ddaa156dc9287ac80da091d", "srcset": "https://si.imgix.net/d93df3e0/uploads/origins/a59f184c-0d0b-41c8-8c22-3e3dab5b974e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb44cdcc7ddaa156dc9287ac80da091d, https://si.imgix.net/d93df3e0/uploads/origins/a59f184c-0d0b-41c8-8c22-3e3dab5b974e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eeca9179ff4bbdc40bbcd693af9d99ff 2x, https://si.imgix.net/d93df3e0/uploads/origins/a59f184c-0d0b-41c8-8c22-3e3dab5b974e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=68e7bcd9725cd39a1b14968f82057f3c 3x"}, "body": "こんにちは、\n仰向けで寝てるジュンちゃんの複乳のついたお腹がみたいです。\n\n・４対８つの乳があり、下が一番膨らんでて上に行くにつれて小さくなり一番上は小さい乳首しか無い\n・一番上の乳首は胸と腹の間より少し上、下は女性器の少し上\n・並びは一直線ではなく、（）←こんなふうに湾曲してる\n・乳は全体的に同じ明るいピンク色（乳輪も同じ色）、乳の色とジュンちゃんのお腹の色の堺はグラデーション（毛が少しだけ剥げてる）\n・乳房は膨らんでるとかろうじて認識できる程度に膨らんでる。乳輪も少し膨らませてほしい\n・乳房は柔らかく見せたいので重力に引っ張られたような形に\n・まとめ：可愛く、柔らかく、美味しそうにお願いします。\n\n女性器の有無はお任せします\n\nポーズは、あまり人間ぽさを感じさせない（関節が曲がらないはずの角度で曲げないなど）ような感じで（体格、骨格はいつものジュンちゃんのままでで）\n\n可能であれば乳首を舐めれた後のよだれがついた差分も描いていただきたいです。（本当は吸われ中のもほしいですが）そちらはくすぐったさに耐えた後の脱力したような表情でお願いします。\n\n今までに内容なリクだと思いますが、もずはヨツケモ絵師であるマッキーさんが描く複乳を見たいので（とか言って色々指示してますが）、マッキーさんらしい描き方でお願いします。\n\nよろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pokeshima/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 342655, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/855bbe5b/uploads/origins/6bd00e61-d9e3-40be-b2d2-af2e574f2b74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c2bef9dc02219051c4c3014a5d69487", "srcset": "https://si.imgix.net/855bbe5b/uploads/origins/6bd00e61-d9e3-40be-b2d2-af2e574f2b74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c2bef9dc02219051c4c3014a5d69487, https://si.imgix.net/855bbe5b/uploads/origins/6bd00e61-d9e3-40be-b2d2-af2e574f2b74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=424f20bed82f3a3e8dac06ba0b893741 2x, https://si.imgix.net/855bbe5b/uploads/origins/6bd00e61-d9e3-40be-b2d2-af2e574f2b74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fb8286e663593af56eda15b1ee53d10 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/855bbe5b/uploads/origins/6bd00e61-d9e3-40be-b2d2-af2e574f2b74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb23d555fd2c77441b0c91c6e70689e6", "srcset": "https://si.imgix.net/855bbe5b/uploads/origins/6bd00e61-d9e3-40be-b2d2-af2e574f2b74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb23d555fd2c77441b0c91c6e70689e6, https://si.imgix.net/855bbe5b/uploads/origins/6bd00e61-d9e3-40be-b2d2-af2e574f2b74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a2df568d62d1b2710a6b97ffcaaf509b 2x, https://si.imgix.net/855bbe5b/uploads/origins/6bd00e61-d9e3-40be-b2d2-af2e574f2b74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3e54509a9905a87f042aad3a84db3dfa 3x"}, "body": "こんにちは^^ あなたに依頼したいです^^。\n\n私のアイデアは、巨大なトゥルイエモンが地面に座っていて、片足が伸びていて、足が視界の近くにあることです。\nもう片方の足は車の上に乗っていて、トゥルエモンが足の裏で車を軽く押してつぶします。\nトゥルイエモンの足の上でくつろぐ小さなテリアモン、テリアモンは友人の足の上にいることを楽しんでいるようです。\nトゥルエモンが楽しそうにテリアモンを見て、親指を立ててウインクしている（二人とも仲良しです）\nトゥルイエモンが建物の裏側で、両者とも楽しそうにしている。\n(トゥルレイエモンは靴を履いていない。）\n\n背景は自由にイメージして描いてください^^。\n\n参考文献はこちら ^^: https://imgur.com/a/rSFStgy\n読んでくれてありがとうございます^^。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pokeshima/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 342655, "client_id": 800239, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc74e2e4/uploads/origins/333e6348-73b8-4424-aa73-4329e9c84f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fef728c6cb974344d98e25db1db5219", "srcset": "https://si.imgix.net/fc74e2e4/uploads/origins/333e6348-73b8-4424-aa73-4329e9c84f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fef728c6cb974344d98e25db1db5219, https://si.imgix.net/fc74e2e4/uploads/origins/333e6348-73b8-4424-aa73-4329e9c84f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fi