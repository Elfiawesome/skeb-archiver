core": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54dde2f8/uploads/origins/dc24c228-f77f-413b-860d-9da7b317334f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ecf92ceda5bffd8f6ce2e45cf8c8711", "srcset": "https://si.imgix.net/54dde2f8/uploads/origins/dc24c228-f77f-413b-860d-9da7b317334f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ecf92ceda5bffd8f6ce2e45cf8c8711, https://si.imgix.net/54dde2f8/uploads/origins/dc24c228-f77f-413b-860d-9da7b317334f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7d0f7fc4e44e11ac5e71458d7f99ea9a 2x, https://si.imgix.net/54dde2f8/uploads/origins/dc24c228-f77f-413b-860d-9da7b317334f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56e814513ac450447bd6f61ee71abdfc 3x"}, "body": "はじめまして、いつもTwitterで素敵なイラストを拝ませて頂いています。\nかわいいお顔に少し陰が入っていて惹き込まれる絵柄、コントラストの効いた印象的な色遣いに惹かれています。\n私にもぜひ一枚お願いしたいと思い依頼させていただきます。\n\nリクエストですが、薄暗い病室のベッドでケイエスミラクルをアストンマーチャンが押し倒しているイラストをお願いします。可能であれば勝負服を着せて下さい。\n\n二人ともモデル馬が非業の死を遂げたスプリンターです。\nウマ娘でのミラクルは全力を尽くして散れたら本望…というような性格ですが\nマーチャンの方は自身の記憶が消えてしまうことを極度に恐れています。\n因子継承して自分を語り継いでくれる存在を生み出さなければと焦っている中、\n病院で邂逅したミラクルに、きっとあなたも同じ気持ちですよね？\nと半分無理やり因子継承を持ちかける…という妄想のもとこのお題にしました。\n\nリクエスト疲れのところ完全捏造突拍子もないリクエストですみません。\n堕落さんのミラクルでインスピレーションが湧いてきたので、ダメ元で依頼することにしました。\n合わなければ依頼キャンセルでもリムブロでも甘んじて受けるつもりです。\nぜひご検討のほどよろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tprsk_00/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3316003, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bbb954c0/uploads/origins/77c1dd92-e4d8-4405-ae29-3d984bdf9936?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e29d75be9626ecc6efb0e157e3db2b4", "srcset": "https://si.imgix.net/bbb954c0/uploads/origins/77c1dd92-e4d8-4405-ae29-3