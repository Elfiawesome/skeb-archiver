gix.net/ac64242b/uploads/origins/e3c65561-cb41-4941-8239-8c8fdbab42d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5dd1724db66249d6a8b7b54bab890996 2x, https://si.imgix.net/ac64242b/uploads/origins/e3c65561-cb41-4941-8239-8c8fdbab42d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=890a259a8843f17bf60713f9db5e803c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac64242b/uploads/origins/e3c65561-cb41-4941-8239-8c8fdbab42d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e3f89de9b37310bd27691c917bd05f3", "srcset": "https://si.imgix.net/ac64242b/uploads/origins/e3c65561-cb41-4941-8239-8c8fdbab42d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e3f89de9b37310bd27691c917bd05f3, https://si.imgix.net/ac64242b/uploads/origins/e3c65561-cb41-4941-8239-8c8fdbab42d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e7df198755cc127855807e83a3691d30 2x, https://si.imgix.net/ac64242b/uploads/origins/e3c65561-cb41-4941-8239-8c8fdbab42d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8d087b9ced2aef5e1575b324c05b20b4 3x"}, "body": "昆布だし先生、先日はパッドお漏らしありがとうございました！似たようなシチュになってしまいますがぜひお願いいたします。\n\nおねしょも増えてきた太眉くん。洗濯もいい加減手間すぎるので親からおむつで寝るのを勧められるもやっぱりそれだけは断固拒否。例によってパッドつけて寝るということで妥協案。\nある朝、爆発的な尿意で目覚め。パッドも寝ている間に少し濡らしていて、急いでちびりながらもトイレに向かうも、トイレ手前でちびりが止まらない→完全決壊を迎えてしまう。量が量なのでパッドでは当然吸いきれず、パンツもパジャマもぐっしょりシミを作ってとぼとぼトイレに入り、朝一の特濃おしっこでまっきっきになってしまったパッドの後始末をする……\n\n上記のようなシチュで、できる範囲で描写入れてくれるとありがたいです！\n最低限「朝しっこパッド始末」が見れれば十分です！よろしくお願いします。\n\n是非サンブレイクの足しにしてください！！", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@eedashiyan/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1253723, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/780db822/uploads/origins/b2c31c67-16f5-4776-89f3-2d4a38cc48ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6a162584b6568ee29e0ebc3b08a1265", "srcset": "https://si.imgix.net/780db822/uploads/origins/b2c31c67-16f5-4776-89f3-2d4a38cc48ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6a162584b6568ee29e0ebc3b08a1265, https://si.imgix.net/780db822/uploads/origins/b2c31c67-16f5-4776-89f3-2d4a38cc48ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5fc8247776c61f40029181d7cbb9d7f 2x, https://si.imgix.net/780db822/uploads/origins/b2c31c67-16f5-4776-89f3-2d4a38cc48ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5e04815e660d684b9fb99b692744ef3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/780db822/uploads/origins/b2c31c67-16f5-4776-89f3-2d4a38cc48ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a2a2e3374b897a5b7342b73be25856b", "srcset": "https://si.imgix.net/780db822/uploads/origins/b2c31c67-16f5-4776-89f3-2d4a38cc48ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a2a2e3374b897a5b7342b73be25856b, https://si.imgix.net/780db822/uploads/origins/b2c31c67-16f5-4776-89f3-2d4a38cc48ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60e55939bf7d1fd043f31246d0afdaf0 2x, https://si.imgix.net/780db822/uploads/origins/b2c31c67-16f5-4776-89f3-2d4a38cc48ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe1542e26f46147f2f982b0fb2f40995 3x"}, "body": "最近あまりにもお漏らしが増えすぎた太眉くん。\nおもらし対策としておむつを親から提案され、さすがに嫌で激しく抗議した挙句、妥協案として尿パッドを着ける事となる。\nそんなある日の学校で、いつもの如く授業中に催し、パッドにちびりながらどうにか耐えてトイレにダッシュ。どうにか立ち便器に間に合ったものの、パッドはひたひたでおパンツにもちょっと溢れてしまっていた……みたいな感じでお願いします！\n\nパンツの中のまっきっきパッドが良く見える構図だと嬉しいです！\n周りが「あの子なんか着けてない？」みたいなひそひそ声があると