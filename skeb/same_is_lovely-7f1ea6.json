, "tipped": false, "creator_id": 71793, "client_id": 274418, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc47053a/uploads/origins/caf77d67-8274-4fbd-8630-c6267a885ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93b737105485ae07a01784c6c5343062", "srcset": "https://si.imgix.net/fc47053a/uploads/origins/caf77d67-8274-4fbd-8630-c6267a885ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93b737105485ae07a01784c6c5343062, https://si.imgix.net/fc47053a/uploads/origins/caf77d67-8274-4fbd-8630-c6267a885ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=152bda9d670cf5f4cd93745c4cc8314a 2x, https://si.imgix.net/fc47053a/uploads/origins/caf77d67-8274-4fbd-8630-c6267a885ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67b5b2fa23d3fbdc22c08ec5ac723c97 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc47053a/uploads/origins/caf77d67-8274-4fbd-8630-c6267a885ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93d2557cb95631b824c5d2bdf49c61ff", "srcset": "https://si.imgix.net/fc47053a/uploads/origins/caf77d67-8274-4fbd-8630-c6267a885ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93d2557cb95631b824c5d2bdf49c61ff, https://si.imgix.net/fc47053a/uploads/origins/caf77d67-8274-4fbd-8630-c6267a885ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d7029ff06193dcdfb492b10bd38050af 2x, https://si.imgix.net/fc47053a/uploads/origins/caf77d67-8274-4fbd-8630-c6267a885ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c7e7a963b95b35475d46ab949d2d0dfc 3x"}, "body": "さめさん、Xにて拝見しました、ヒナ寝取らせ絵が素晴らしかったので、以下の内容でリクエストさせて頂きます。\n\n【テーマ】\nカイザーPMC理事に寝取られるホシノとヒナ\n\n【シチュエーション】\n・カイザーPMC理事の両側に侍らされてるホシノとヒナ\n・理事は2人に馴れ馴れしく、2人も理事に対して嫌悪感はなく、むしろ…な感じの距離感\n※体勢とか絡み具合はお任せします。立っててもいいです。\n・ヤる前/後の写真撮影というシチュなのでカメラ目線\n\n【差分】\n《服装》\nホシノとヒナ:全裸・黒ランジェリー(ヒナ寝取らせ絵のような、扇情的なデザイン)・黒マイクロビキニ・金マイクロビキニ・スク水・黒ドレス・カイザー兵士を彷彿とさせるデザインorカラーリングの軍服\nPMC理事:いつものスーツ・全裸(原作と異なり、顔から下は人間と同じ。肥満体型かつ勃起状態の巨根)\n\n《ホシノとヒナの表情》\n・まだ堕ちてないけど早くヤりたくてうずうずしてるような感じ\n・PMC理事との関係を楽しんでる感じ\n・事後の蕩けた感じ\n・カイザー堕ち後、先生を冷たく見下ろすような感じ\n※2人の髪型はお任せします\n\n《その他》\n・カイザーグループのタトゥー(顔を除く場所。色んな箇所に付け替えて楽しめるよう、複数お願いします)\n・汗\n・キスマーク(ホシノとヒナだけでなく、PMC理事にもお願いします。勃起ペニスには必ずお願いします。)\n・頬の紅潮\n・熱気\n・ラブホ背景\n・執務室+夜景の背景\n・カメラ枠\n\n※差分をこちらで組み替えて楽しみたいので、PSD形式でお願い致します。\n細かくて申し訳ありませんが、何卒宜しくお願い致します。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@same_is_lovely/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/226307f7/uploads/origins/83e26173-969d-4753-bb9b-f99581bbc2e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6407f308960d153b55e6450818d024b3", "srcset": "https://si.imgix.net/226307f7/uploads/origins/83e26173-969d-4753-bb9b-f99581bbc2e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6407f308960d153b55e6450818d024b3, https://si.imgix.net/226307f7/uploads/origins/83e26173-969d-4753-bb9b-f99581bbc2e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a8ea3cb21e77156e557e8608a6b1b08 2x, https://si.imgix.net/226307f7/uploads/origins/83e26173-969d-4753-bb9b-f99581bbc2e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e8a37359bf75922370531b383f1c579 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 71793, "nc": 32}, {"path": "/@same_is_lovely/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 71793, "client_id": 874495, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/243d83ae/uploads/origins/9b714033-78f1-443c-b404-c950adaf0565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=745a874f30ace7fe650748b5fbac3911", "srcset": "https://si.imgix.net/243d83ae/uploads/origins/9b714033-78f1-443c-b404-c950adaf0565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=745a874f30ace7fe650748b5fbac3911, https://si.imgix.net/243d83ae/uploads/origins/9b714033-78f1-443c-b404-c950adaf0565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0656009f98d1c5cb98ac6a157429708b 2x, https://si.imgix.net/243d83ae/uploads/origins/9b714033-78f1-443c-b404-c950adaf0565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b11641c813c282bb8865ddc38f1f5528 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/243d83ae/uploads/origins/9b714033-78f1-443c-b404-c950adaf0565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ed9d737fe866e8d04a8685bb3f25ddc", "srcset": "https://si.imgix.net/243d83ae/uploads/origins/9b714033-78f1-443c-b404-c950adaf0565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ed9d737fe866e8d04a8685bb3f25ddc, https://si.imgix.net/243d83ae/uploads/origins/9b714033-78f1-443c-b404-c950adaf0565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8d4a5139eb94365eda3f239936afd25a 2x, https://si.imgix.net/243d83ae/uploads/origins/9b714033-78f1-443c-b404-c950adaf0565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5fb09f5f8883ae80a78a3c6b5d875419 3x"}, "body": "はじめまして！\n\n千年戦争アイギスに登場するエフネがなっがい竿で犯されている姿をお願いいたします。\n\nいくつか差分を頂きたいのですが、\n1.挿入前、お腹の上に竿を置いて犯す宣言\n2.挿入、お腹がボコっとなっていると嬉しい\n3.ピストン\n4.エフネ絶頂、ピストン止めず\n5.射精直前、さらに激しくなる\n6.射精\n7.勢いよく竿を引き抜く、エフネ潮ふいて絶頂\n\n構図はお任せいたしますが、表情が見えるものがいいです。\nまた、お任せでセリフもお願いいたします。\nエフネは敬語口調のメスガキ、竿役は乱暴な口調です。\n1の時、エフネは表面上は余裕そうにしていますが、竿の大きさにビビっている感じです。\n\n差分が多くなってしまうので、金額不足の場合は再送お願いいたします。\n\nよろしくお願いいたします。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@same_is_lovely/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 71793, "client_id": 166065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/382e7967/uploads/origins/7a771203-1a15-4dbb-98cd-2b7b8d389809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bcccf377f45b5df2987e9bef0341481", "srcset": "https://si.imgix.net/382e7967/uploads/origins/7a771203-1a15-4dbb-98cd-2b7b8d389809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bcccf377f45b5df2987e9bef0341481, https://si.imgix.net/382e7967/uploads/origins/7a771203-1a15-4dbb-98cd-2b7b8d389809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0dc446b0de8691c02f128f44f8ac619 2x, https://si.imgix.net/382e7967/uploads/origins/7a771203-1a15-4dbb-98cd-2b7b8d389809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8456068fb696fca6e170611a90c5da2a 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/382e7967/uploads/origins/7a771203-1a15-4dbb-98cd-2b7b8d389809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5071c9b489c212e8769f890cb8ebd2df", "srcset": "https://si.imgix.net/382e7967/uploads/origins/7a771203-1a15-4dbb-98cd-2b7b8d389809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5071c9b489c212e8769f890cb8ebd2df, https://si.imgix.net/382e7967/uploads/origins/7a771203-1a15-4dbb-98cd-2b7b8d389809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63253e82f2a48991214e632bc94499c9 2x, https://si.imgix.net/382e7967/uploads/origins/7a771203-1a15-4dbb-98cd-2b7b8d389809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4847119b9984fcd3a290298cc2957e8b 3x"}, "body": "はじめまして、リクエストお願いします\n\nキャラクター\n栗村アイリ(バンド)\n\nディルドオナニーを筆頭に自身で開発しまくって、肥大化しまくった乳首やヘソ、おまんこに自分でピアスまで開けちゃったドスケベオナ狂いJKになっちゃったアイリが、とうとう男を、本物のオチンポ様を知る為にパパ活に手を出してしまった。\n\nといった導入から始まるシチュのパパ活ハメ撮り録ベスト集的イラストを、エロ自撮り風落書きと「マゾオス先生とのアイリ直々のドスケベ解説付き同時視聴シチュ」のセリフ付きでお願いします。\n\n竿役は先生以外でお願いします。\n太ったデカチン種付けおじさま系だと尚良いです。\n\nアイリの体型\n・オナ狂いで使い込まれた後の変形が目立つ、垂れ気味普通サイズおっぱい。\n・乳首、乳輪は過酷なオナニーで肥大化\n・肋の浮いたドスケベなスレンダーボディ\n・陰毛は有り。さめさんがアイリに抱くイメージにあった濃さと整え具合で。\n\n以下、全てが難しい場合、チンポにキタ内容を抜粋してお願いします。\n⑦は必ず採用して欲しいです\n\n欲しい内容\n各シーンの時系列はバラバラで、連続したプレイではない物をランダムに視聴している設定でお願いします。\n\n①処女喪失前(膜は無いけど)のパパ活お誘い様の自撮り写真\n卑猥なパパ活お誘い落書きデコ付き\nこれが先生に見つかった所から開始\n\n②今から生ハメSEXしまーす♡な感じのおじさまとの2ショット\n立ち絵でおじさまに密着して、カウパードバドバな勃起チンポをフェザータッチ手コキしながら、自身はおじさまに尻を掴まれマンホジされている。\n\n③仁王立ちしたおじさまのチンポに媚びるような亀頭キスからのねっとりとしたフェラチオ\n射精後のザーメンブリッジが出来ている様子でもOK\n\n④全身大人のオモチャフル装備寸止め稼働中のアクメ我慢→フルパワー稼働からのヘイロー半壊連続デスアクメ\n\n⑤構図お任せの生本番SEX\n開発、調教やガチ種付けの男性優位でも、アイリがチンポを貪る形のビッチ全開女性上位でもOK\n\n⑥ベッドに仰向けで打ち捨てられた精液塗れのアイリが、アヘ顔かいやらしい笑みでマンコからザーメン噴水しながらオホ声で余韻アクメ決めている様子\n\n⑦父親のわからない子を孕んだ母乳たっぷりデカ黒乳首ボテ腹妊婦アイリが全裸でAVデビューしている様子(出来れば局部ピアスマシマシ)\nこちらはAVパッケージ風立ち絵か、全裸で後ろから愛撫されながらインタビューを受けている様な感じで。\n\n上記内容で何卒よろしくお願いします。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@same_is_lovely/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 71793, "client_id": 1047, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef2264a7/uploads/origins/4ec2b897-2eef-4f3c-a2a1-b3de49ee70eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a83d9a6550c7636755d8b022dd0743c0", "srcset": "https://si.imgix.net/ef2264a7/uploads/origins/4ec2b897-2eef-4f3c-a2a1-b