//si.imgix.net/ef8f5943/uploads/origins/2ad27f24-418f-47d4-a83e-086e575a1b13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d81580bb77d221770abe4abd750157c 2x, https://si.imgix.net/ef8f5943/uploads/origins/2ad27f24-418f-47d4-a83e-086e575a1b13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab8514f85bd5c1d7f84e7fab4187aa38 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef8f5943/uploads/origins/2ad27f24-418f-47d4-a83e-086e575a1b13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a3f4f1ce89812e3025aea412376a959", "srcset": "https://si.imgix.net/ef8f5943/uploads/origins/2ad27f24-418f-47d4-a83e-086e575a1b13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a3f4f1ce89812e3025aea412376a959, https://si.imgix.net/ef8f5943/uploads/origins/2ad27f24-418f-47d4-a83e-086e575a1b13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4185e437d5b576db5f40cf580b0458a1 2x, https://si.imgix.net/ef8f5943/uploads/origins/2ad27f24-418f-47d4-a83e-086e575a1b13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=74d8fc8b65053e09bf4174860605401a 3x"}, "body": "さめさん\n前回は『カイザーPMC理事に寝取られたホシノとヒナ』のリクエスト絵を素晴らしいクオリティに仕上げて頂き、ありがとうございます。\n今回は以下の内容でリクエストさせて頂きます。\n\n【テーマ】\nカイザーPMC理事に寝取られたキサキ\n\n【シチュエーション】\n・カイザーPMC理事の横に侍らされてるキサキ\n・理事はキサキに馴れ馴れしく、キサキも理事に対して嫌悪感はない感じの距離感\n・体勢や絡み具合は今回もお任せします。キサキの両乳首が見えてると嬉しいです\n\n【差分】\n《服装》\n・いつものチーパオ\n・黒マイクロビキニ\n・バニー服\n・黒の高級ランジェリー\n・スク水\n・バスローブ\n・ホットパンツ+星条旗ビキニ\n・山海経の校章のネックストラップ(ノノミみたいな感じ。)\n・校章を塗りつぶすようなバツ印\n・カイザーマークのネックストラップ\n・全裸\n\n《表情》\n・いつもの澄まし顔\n・事後の蕩けた表情\n・快楽堕ちし、色気を感じる妖しい表情\n・カイザー堕ちし、こちらを見下すような冷めた表情\n\n《髪型》\n・いつものお団子\n・髪下ろし\n・事後で乱れた髪\n\n《カイザーPMC理事》\n・いつものスーツ姿\n・全裸(肥満体型+巨根絶倫)\n・バスローブ\n\n《その他》\n・カイザーグループのタトゥー(顔を除いた色んな場所に付け替えて楽しめるよう、複数お願いします。また、サイズは前回より少し大きめでお願いします。)\n・汗だく\n・キスマーク(タトゥーと同じように複数箇所にお願いします。また、PMC理事の体と勃起ペニスにもお願いします)\n・頬の紅潮\n・熱気\n・股から溢れてる大量の精液\n・執務室+夜の背景\n\n※差分を組み替えて楽しみたいので、今回もPSD形式でお願い致します\n\n細かくなり申し訳ありませんが、何卒宜しくお願い致します", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@same_is_lovely/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/075461fa/uploads/origins/f7748bad-b9a2-4b7c-ac7b-04fa3bc7605c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b800c0cd3d4194bc252245b9e7a1a6e4", "srcset": "https://si.imgix.net/075461fa/uploads/origins/f7748bad-b9a2-4b7c-ac7b-04fa3bc7605c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b800c0cd3d4194bc252245b9e7a1a6e4, https://si.imgix.net/075461fa/uploads/origins/f7748bad-b9a2-4b7c-ac7b-04fa3bc7605c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c827b3fbe4f0bfc3c96ddb995a0315f 2x, https://si.imgix.net/075461fa/uploads/origins/f7748bad-b9a2-4b7c-ac7b-04fa3bc7605c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e25f7e9156bf8f859353122c39f9c37f 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 71793, "client_id": 109036, "nc": 161}, {"path": "/@same_is_lovely/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/70e6dbc6/uploads/origins/db4c3f89-3d23-4754-9f8b-dce226ea24da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee1147c70de1cab57462a416aa077c1e", "srcset": "https://si.imgix.net/70e6dbc6/uploads/origins/db4c3f89-