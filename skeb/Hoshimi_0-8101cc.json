a90-9b4e-34b18cd282b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a086b46a999600ce5128eef557f966a9 2x, https://si.imgix.net/a9bde97f/uploads/origins/c41ca0a8-7c6d-4a90-9b4e-34b18cd282b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6fc4e214bb225f0924bcedfbcea0b1a5 3x"}, "body": "初めまして、ホシミさん。いつもイラスト拝見させていただいております。\nリクエストを提出させていただきます。\n\n内容としましては、ブルアカのアイリとカズサのイラストを描いていただきたく思います。\nシチュエーション:アイリに頼まれたカズサがアイリにピアスを開けようとしている場面。\n・同じソファに座りながらカズサがアイリの左耳にピアッサーで穴を開けようとしている\n・アイリの方は緊張で目を閉じていてキス待ち顔のようになっている\n・カズサの方はアイリの顔が至近距離にあるのもあってかなり赤面している\n・可能でしたらカズサのモノローグとして「まつげ長…」というセリフがあると嬉しいです\n\nその他の詳細な部分に関してはお任せします！\nご検討をお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hoshimi_0/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3151352, "client_id": 458855, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a6df1162/uploads/origins/1f7c67a8-ba64-435d-ab29-2738d48fa2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5aa272b8f95de8f2117571604654256", "srcset": "https://si.imgix.net/a6df1162/uploads/origins/1f7c67a8-ba64-435d-ab29-2738d48fa2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5aa272b8f95de8f2117571604654256, https://si.imgix.net/a6df1162/uploads/origins/1f7c67a8-ba64-435d-ab29-2738d48fa2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4921bbd96bd613f1033b7df48d78d9dc 2x, https://si.imgix.net/a6df1162/uploads/origins/1f7c67a8-ba64-435d-ab29-2738d48fa2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bc9bf6ab0845ae4c63b48eb1fea3675 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6df1162/uploads/origins/1f7c67a8-ba64-435d-ab29-2738d48fa2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecc9efe09f269d07dabcd87942b54227", "srcset": "https://si.imgix.net/a6df1162/uploads/origins/1f7c67a8-ba64-435d-ab29-2738d48fa2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecc9efe09f269d07dabcd87942b54227, https://si.imgix.net/a6df1162/uploads/origins/1f7c67a8-ba64-435d-ab29-2738d48fa2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b4816775a084446e03f840c6d85386b9 2x, https://si.imgix.net/a6df1162/uploads/origins/1f7c67a8-ba64-435d-ab29-2738d48fa2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4257d1354f540f63d44df8597e8fb67b 3x"}, "body": "ヨツバイーターという概念を生徒化させた\nコユキに狂ったキャラクターを作成していただけると幸いです。\n\n名前\n四葉イト\n(四葉＋bite(噛む)の組み合わせ)\n(四葉＋eat(食べる)の組み合わせ)\n\n設定\nコユキに付きまとう先輩\n(ミレニアムサイエンススクール2年)\n\n身長178cm\nウエスト細め\n胸とお尻はそこそこの大きさ\n\n髪型\n腰まで届くロングヘアとサイドテール\n前髪に小さめのヘアインテーク有り\n\n髪色\n緑(四葉モチーフ)\n\nアクセサリー\n四葉をイメージした色濃いめのクリスタルの髪留めでサイドテールを結ぶ\n\n目\n目つきは少し鋭めでコユキのように目に星が入っている\n(コユキよりも鋭利な星)\n\n服装\nコユキと似たカラーリングの制服\n(制服の形状はノアと似ている) \nコユキと似た上着を羽織っている\n制服と上着は、ミレニアムっぽく青のカラーリングが入っている\nコユキと違い制服はしっかり着ている\n\nヘイロー\n食い荒らされたように一部が欠けた四葉型\n\n使用武器は「ヨツバイーター」\n大口径リボルバー\n\n普段は善良な生徒だが、コユキの事になると様子がおかしくなる\n\n黒崎コユキが大好き\n暇があればコユキに付きまとう\n気付いたら反省部屋にも潜り込んでいる\nセキュリティは反応せず、気付いたらそこに居る\n\nお菓子やゲームをプレゼントしたりとコユキを甘やかしまくっている\n\nコユキが見つけた四葉に目がなく\n奪い取り喰らい尽くす\nコユキが怒って突っかかって来るのがたまらなく好きで、恍惚の表情を浮かべる変態\n\nコユキの運がツイてないのは間違いなくコイツのせい\n四葉イトはコユキから運を奪い取っているため幸運値が高い\n適当に撃っても当たるレベルの為、装弾数の少ないリボルバーでも問題ない\n\nコユキは彼女の事を付き纏ってくるし、四葉を毎回取られるので鬱陶しいと思いつつも、とても可愛がって甘やかしてくれるので良い先輩だなとも思う複雑な感情を抱いている\n\nコユキが何処にいてもすぐに見つけることができるので、脱走したコユキを見つける時、ユウカとノアに頼りにされている\n\nもし金額に不足がありましたら\n再送申請をお送りいただけると幸いです\n\nよろしくお願い致します", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hoshimi_0/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3151352, "client_id": 458855, "vtt_url": null, 