/si.imgix.net/68d4bf64/uploads/origins/4370eb6c-44ce-425e-b378-52162c6a01ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=250fdd9a19c87b65469fc24b170fe660 3x"}, "body": "很高兴见到你！\n我对 YuuTacC 所绘插图的美丽和可爱色彩一见钟情。\n我想提出一个请求，希望你能表现出我深爱的女孩。\n\n这个角色是日本游戏《花骑士少女》中的史黛拉。\n她以星星（stella）和星星花（sutera）为主题，通过随意操纵光线与敌人战斗。\n您能说明她使用特殊招式的场景吗？......\n\n要求\n她在敌人出现时惊慌失措地释放特殊技的场景。\n动画中她正在冥想，但如果她能睁开眼睛就更好了。\n服装由您决定。基本服装是 \"https://pastelcrayon.net/flora/0459b.png\"。\n灯光应该是夜间的，这样光线会更突出。其他背景元素由我们决定。\n无需描述敌人。\n\n角色参考\nhttps://pastelcrayon.net/data/1049.html\nhttps://pastelcrayon.net/data/0607.html\nhttps://pastelcrayon.net/data/0459.html\n\n使用特殊动作的场景\nhttps://gyazo.com/bc480ce9bd49cb9b1f9c1c9c004d1434\n\n就这些了。\n如果您方便的话，请通过 ...... 与我们联系！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yottacc/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a6ab46a6/uploads/origins/1a319642-ee36-42df-a025-a5054d5fd090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=618dc396824fbcdbe453f663e49bfec6", "srcset": "https://si.imgix.net/a6ab46a6/uploads/origins/1a319642-ee36-42df-a025-a5054d5fd090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=618dc396824fbcdbe453f663e49bfec6, https://si.imgix.net/a6ab46a6/uploads/origins/1a319642-ee36-42df-a025-a5054d5fd090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef9ec09de02e1849d0888c3fa43031fc 2x, https://si.imgix.net/a6ab46a6/uploads/origins/1a319642-ee36-42df-a025-a5054d5fd090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25ae7d403d6b478f45b1aee87c50c83c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 420372, "client_id": 3427931, "nc": 129}, {"path": "/@yottacc/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 420372, "client_id": 3235528, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/025a0781/uploads/origins/70b25df2-e339-4dd5-af64-c9add7204773?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21db354e911a434fcea7e4e23797f430", "srcset": "https://si.imgix.net/025a0781/uploads/origins/70b25df2-e339-4dd5-af64-c9add7204773?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21db354e911a434fcea7e4e23797f430, https://si.imgix.net/025a0781/uploads/origins/70b25df2-e339-4dd5-af64-c9add7204773?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f8384a96242c035b51754e8e75a0262 2x, https://si.imgix.net/025a0781/uploads/origins/70b25df2-e339-4dd5-af64-c9add7204773?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c50efb84c8c9554951d66f7a506b6dd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/025a0781/uploads/origins/70b25df2-e339-4dd5-af64-c9add7204773?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e891034b73a9f6556e6d7259b4a8ed91", "srcset": "https://si.imgix.net/025a0781/uploads/origins/70b25df2-e339-4dd5-af64-c9add7204773?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e891034b73a9f6556e6d7259b4a8ed91, https://si.imgix.net/025a0781/uploads/origins/70b25df2-e339-4dd5-af64-c9add7204773?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7122f3199a226f5cbc5301fcfd9f4f1e 2x, https://si.imgix.net/025a0781/uploads/origins/70b25df2-e339-4dd5-af64-c9add7204773?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2bb6ad41b54813a0456c4cf39bb85854 3x"}, "body": "你好，Yuu tacC，很高兴见到你！\n我在 X 上看到了你的插图，觉得风格很对我的胃口，所以想向你提个请求。\n我想请你画动画片《天国的方法》中的 Noel-chan。\n我不知道你是否知道这部作品或这个人物，所以我将给你一个关于 Noel-chan 的简单人物介绍。我想介绍一下 Noel-chan。她是一个非常有活力、天真无邪的女孩，虽然没有透露她的年龄，但她孩子般的外表和行为也很可爱。\n诺埃尔的照片请见 URL，以供参考。\n如图所示，她穿着平常的衣服，笑起来很开心，也很兴奋。YuuTacC 画出的微笑表情非常好看，所以我很希望能看到诺埃尔笑起来很好看的插图。\n其他具体细节，比如构图，就由我来决定吧。\n非常感谢。\n\nhttps://drive.google.com/drive/folders/1L_hb3fBgNPSRQJ7uekVEsRiGNcq_ok1_?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yottacc/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 420372, "client_id": 877019, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de05b845/uploads/origins/c8c36f17-a1ff-4fb0-b041-480b2997f2a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1409dc478f3727ab036a58601ae8793a", "srcset": "https://si.imgix.net/de05b845/uploads/origins/c8c36f17-a1ff-4fb0-b041-480b2997f2a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1409dc478f3727ab036a58601ae8793a, https://si.imgix.net/de05b845/uploads/origins/c8c36f17-a1ff-4fb0-b041-480b2997f2a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f995f856b1e59b3e02520d37bc90c162 2x, https://si.imgix.net/de05b845/uploads/origins/c8c36f17-a1ff-4fb0-b041-480b2997f2a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=026a97dd85fbe4807f953e9fd1c7fc19 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de05b845/uploads/origins/c8c36f17-a1ff-4fb0-b041-480b2997f2a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78988811c9c2899faded2ca6cfbf0c94", "srcset": "https://si.imgix.net/de05b845/uploads/origins/c8c36f17-a1ff-4fb0-b04