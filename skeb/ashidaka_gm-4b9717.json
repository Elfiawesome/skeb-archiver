.cc/posts/9000360\nこちらのシチュエーションが大変素晴らしかったので、同じ構図でお願い致します\n流れ：突然現れた竿役（小太りな中年の男性、男性器は大き目）に突然襲われ、トイレに連れ込まれ凌〇される\n\n構図はお任せ致しますが、\n①「000芦鷹雲参考イラスト①」のような\nパーカーの前面に手を掛け、無理やり胸を露出する描写\n②「000芦鷹雲参考イラスト②」のような\n表情が見えず、後背位で突きながら胸を揉む描写\n以上２点があれば嬉しく思います\n\n【NG描写】\n・排尿などのスカ描写、ア〇ルプレイ\n・母乳\n・陰毛\n※可能であれば、モザイクではなく黒線修正でお願い致します\n\n少しでも応援になればとリクエスト送らせて頂きました\nお受け頂けますとありがたく思います\n\nhttps://drive.google.com/drive/folders/1MAHCE5bOnfCffBfvHz30LjgJu3qldBpE", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ashidaka_gm/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1140237, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91c772a0/uploads/origins/95783ffc-1c81-49d7-a619-a8594b21c339?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46c5515978988690b91fc70606215755", "srcset": "https://si.imgix.net/91c772a0/uploads/origins/95783ffc-1c81-49d7-a619-a8594b21c339?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46c5515978988690b91fc70606215755, https://si.imgix.net/91c772a0/uploads/origins/95783ffc-1c81-49d7-a619-a8594b21c339?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f228ddd1ce918b4d5faa0cd185e597e 2x, https://si.imgix.net/91c772a0/uploads/origins/95783ffc-1c81-49d7-a619-a8594b21c339?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63c750a59a415f47856d2c1e78082309 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91c772a0/uploads/origins/95783ffc-1c81-49d7-a619-a8594b21c339?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0421927eceba56512c31b91951358edf", "srcset": "https://si.imgix.net/91c772a0/uploads/origins/95783ffc-1c81-49d7-a619-a8594b21c339?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0421927eceba56512c31b