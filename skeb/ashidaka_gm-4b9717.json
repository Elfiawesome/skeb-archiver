6e9dd39c/uploads/origins/c18dba3b-42fc-4a89-b1e7-06d0b399b86d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3eabf455c73a90ba3d4ed141fb031625", "srcset": "https://si.imgix.net/6e9dd39c/uploads/origins/c18dba3b-42fc-4a89-b1e7-06d0b399b86d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3eabf455c73a90ba3d4ed141fb031625, https://si.imgix.net/6e9dd39c/uploads/origins/c18dba3b-42fc-4a89-b1e7-06d0b399b86d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=384f662685104d6b0fcef55255bec1b9 2x, https://si.imgix.net/6e9dd39c/uploads/origins/c18dba3b-42fc-4a89-b1e7-06d0b399b86d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be9282bad302ad092d7f7c0c569114ec 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e9dd39c/uploads/origins/c18dba3b-42fc-4a89-b1e7-06d0b399b86d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c340e31563ffc076faf3e122e52c4a32", "srcset": "https://si.imgix.net/6e9dd39c/uploads/origins/c18dba3b-42fc-4a89-b1e7-06d0b399b86d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c340e31563ffc076faf3e122e52c4a32, https://si.imgix.net/6e9dd39c/uploads/origins/c18dba3b-42fc-4a89-b1e7-06d0b399b86d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a458cda05f8b9fadf260d6e2fef38d2d 2x, https://si.imgix.net/6e9dd39c/uploads/origins/c18dba3b-42fc-4a89-b1e7-06d0b399b86d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a6e1dff2fbdefe5d3dd3313db8142dbe 3x"}, "body": "はじめまして、いつも可愛いイラストや漫画を拝見させて頂いております。\nよろしければリクエストをお願い致します。\n\n冷泉麻子さんの睡眠姦をお願い致します。\n自宅で寝ているところを、侵入してきた男に襲われているイメージです。\n\n体位は正常位で、男の主観視点でお願いします。\nノンナさん本の台詞回しがとても良かったので、麻子さんを生オナホ扱いしているような竿役の台詞をお願いします。\n\n麻子さんの服装は制服なり、パジャマなり、下着のみなり、描きやすいものでお任せ致します。\nはだけられるか捲くり上げられるかで胸を露出させられ、足を大きく開かされて挿入されている状態。\n反応は少し顔を赤らめて吐息を漏らす程度で、最後まで目覚めない流れでお願いします。\n良ければ行為中と膣内射精中（出来れば断面図カットイン付き）の差分で作成して頂けると嬉しいです。\n\n注文が多くて恐縮ですが、何卒ご検討をお願い致します。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ashidaka_gm/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1140237, "client_id": 223256, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/806dc516/uploads/origins/eb49b7d9-2bd7-45e6-b42a-08ee5d222ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0db477d87be4804040e46c4a0f6bc687", "srcset": "https://si.imgix.net/806dc516/uploads/origins/eb49b7d9-2bd7-45e6-b42a-08ee5d222ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0db477d87be4804040e46c4a0f6bc687, https://si.imgix.net/806dc516/uploads/origins/eb49b7d9-2bd7-45e6-b42a-08ee5d222ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=793f7167f75833ea1bf30ef36356c506 2x, https://si.imgix.net/806dc516/uploads/origins/eb49b7d9-2bd7-45e6-b42a-08ee5d222ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=044da54cb3858bf3f2404437f0758ebd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/806dc516/uploads/origins/eb49b7d9-2bd7-45e6-b42a-08ee5d222ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b9806a446b213cbc2e6f05e5835f5c9", "srcset": "https://si.imgix.net/806dc516/uploads/origins/eb49b7d9-2bd7-45e6-b42a-08ee5d222ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b9806a446b213cbc2e6f05e5835f5c9, https://si.imgix.net/806dc516/uploads/origins/eb49b7d9-2bd7-45e6-b42a-08ee5d222ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f33b26443d6ebdfcd159386b95db68ac 2x, https://si.imgix.net/806dc516/uploads/origins/eb49b7d9-2bd7-45e6-b42a-08ee5d222ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f25b19602902b0e5e60853cb8270ba76 3x"}, "body": "こんにちは。ツイッターのイラストを見て是非リクエストさせて頂きたいと思いました。\nよろしくお願いします。\nキャラ　ガルパンの西住みほちゃんにて\nシチュ　みほちゃんが学校の教師にセクハラされているようなイメージで\n　　　　発育の良いおっぱい、お尻、ふとももを触りまくって欲しいです\n　　　　その際教師からの言葉攻め\n　　　　例「みほちゃんたまんない体してるねぇ・・・」\n　　　　といった感じの言葉攻めの吹き出しを複数いれて\n　　　　みほちゃんも体を弄られて\n　　　　感じてしまっているようなシチュでお願いしたいです\n　　　　構図、背景、服装などはすべておまかせします\n　　　　受けて頂けると大変嬉しいです。よろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ashidaka_gm/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1140237, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a471e00c/uploads/origins/4610e40d-12d7-44be-bdbb-bfc18e0a749b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8806f0cff3daedaf46ad4ee5195284d8", "srcset": "https://si.imgix.net/a471e00c/uploads/origins/4610e40d-12d7-44be-bdbb-bfc18e0a749b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8806f0cff3daedaf46ad4ee5195284d8, https://si.imgix.net/a471e00c/uploads/origins/4610e40d-12d7-44be-bdbb-bfc18e0a749b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b8928b9e0ebb504cfc541ebe73728e7 2x, https://si.imgix.net/a471e00c/uploads/origins/4610e40d-12d7-44be-bdbb-bfc18e0a749b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b1a8ddf4e8d30df6efb8ace37104369 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a471e00c/uploads/origins/4610e40d-12d7-44be-bdbb-bfc18e0a749b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fd093841dc0e71559d36ec2e61bd037", "srcset": "https://si.imgix.net/a471e00c/uploads/origins/4610e40d-12d7-44be-bdbb-bfc18e0a749b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fd093841dc0e71559d36ec2e61bd037, https://si.imgix.net/a471e00c/uploads/origins/4610e40d-12d7-44be-bdbb-bfc18e0a749b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c40bf82ca450f08f6475d0dbbd6edec 2x, https://si.imgix.net/a471e00c/uploads/origins/4610e40d-12d7-44be-bdbb-bfc18e0a749b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=88ac3cdc5bb9142da49af2e5627121a8 3x"}, "body": "はじめまして\npixivのガルパン漫画で先生を知り、ネタの豊富さとフェチズムにとても楽しませていただきました\nまた段々と成人向け漫画にも手を出されていて、その中のみぽりんこと西住みほがとても性的で素晴らしかったです\nその西住みほで是非ともお願いしたいネタがあります\n\n\n\n◎キャラ\n戦車道課の西住さん(ヘアピン付けてください）\nhttps://www.pixiv.net/artworks/81180140\n\n◎シチュエーション\n「お願いします！おっぱいを揉ませて下さい！」と後輩男子社員に土下座で頼み込まれて押し切られた結果おっぱいを揉ませてあげる\n\n◎服装\nトップレス（下はスカート含め全部着ているが、上は制服がシワにならないように全て脱いでいる）の西住さん生乳を揉んでください\n\n◎構図\n背後からの乳揉みでお願いします\n男は顔は見切れて描きこまず、はぁはぁと興奮して息を荒げさせてください\n\n◎みほの反応\n全てお任せします\n\n\n\n\nお手数かけて申し訳ありませんが商業誌及び商業アニメの「土下座で頼んでみた」で検索していただければ大体の雰囲気は伝わると思います\n商業作品のため直接参考資料として画像を張り付けることが出来ないのでご容赦ください\n流れを全部描くとカット数が多くなってしまうので、「土下座で頼み込まれた結果～」のナレーションと共におっぱいを揉まれるみほの一枚絵で大丈夫です\n\n先生の描くみぽりんの押しに弱そうというか、土下座で頼み込めば少し位ならえっちなお願いも聞いてくれそうなところが凄く股間にきました\nまたこちらの画像の巨乳なみぽりんのおっぱいがとても柔らかそうで本当に性的です\nhttps://twitter.com/ashidaka_gm/status/1385531791314886666\n\n仕事が上手くいかず職場で浮いている新入社員君にも声をかけてくれる憧れの西住先輩\n深夜職場で二人きりになった時に男としてのプライドを全部捨てて、\n「辛いです仕事辞めたいですきついです癒しが欲しいですおっぱいを揉ませてください」と土下座で頼み込み、\nその結果優しい西住先輩は押し切られおっぱいを揉ませてくれる様子をお願いします\n（新入社員君も変にヘタレなので本当におっぱいだけ揉んで帰ってそれをおかずにオナろうと思っていて、\nこんな機会二度とないと感触を脳に刻み込むため執拗に揉む）", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ashidaka_gm/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1140237, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4087061/uploads/origins/8375249b-ba87-4378-acca-216ddab757ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fce51d507281f4e8a668144206bc5657", "srcset": "https://si.imgix.net/b4087061/uploads/origins/8375249b-ba87-4378-acca-216ddab757ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fce51d507281f4e8a668144206bc5657, https://si.imgix.net/b4087061/uploads/origins/8375249b-ba87-4378-acca-216ddab757ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f44ebf5ed66ad93206834b4b5f77f3b9 2x, https://si.imgix.net/b4087061/uploads/origins/8375249b-ba87-4378-acca-216ddab757ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39a562ae2b00d91fa793e5bafd41c048 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4087061/uploads/origins/8375249b-ba87-4378-acca-216ddab757ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3017e5eda3008ba070110fff6fea7d38", "srcset": "https://si.imgix.net/b4087061/uploads/origins/8375249b-ba87-4378-acca-216ddab757ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3017e5eda3008ba070110fff6fea7d38, https://si.imgix.net/b4087061/uploads/origins/8375249b-ba87-4378-acca-216ddab757ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f127dab20146e9aa8675a9997020cc5e 2x, https://si.imgix.net/b4087061/uploads/origins/8375249b-ba87-4378-acca-216ddab757ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed5c2e4af9ca502ad5ca393c13344fed 3x"}, "body": "ガルパンのアンチョビ姉さんが無理やりエッチされている所(でも今はもう自分からしている)をお願いします。\n「無理やりチンコを入れられているドゥーチェ(絶望して虚ろ目)」と、\n表情差分で「今まで味わったことのない極上の快感を味わっている、セックスの事しか頭に無くなっている淫乱モードのドゥーチェ(上気して頬は赤く目がハート)」をお願いします!\n・服装:制服、(URL の86622873_p5.pngな感じ)、マント無し。\n上着ははだけて胸は丸見え、パンツも脱がされて、野郎に〇されている感じでお願いします。\n長いシチュ(妄想)は、参考程度で↓\n◇無理やり連れ込まれた部屋で無理やりエッチな事をされてしまうドゥーチェ!悪い男は逆らえない様に両手を縛ってベッドに寝かせて強引に!　しかも裏ルートで仕入れた「女の子が言いなりになってしまうクスリ」をドゥーチェに使ってしまう…これは強力な媚薬の一種で、チ〇コに塗り付けて女の子とエッチをすると、その子がものすごくエッチな気持ちになった上に感度が上がりまくって、暫くの間気持ち良すぎるセックスが強制的に味わえてしまう危ない依存性のあるオクスリ!\nなので一度このクスリをつかってエッチを体験してしまうとその人とのセックスの事が一生忘れられなくなるし、お薬を使うたびにどんどんエッチが大好きな子になって目覚めていくので、最後はご褒美エッチしてもらうためなら何でもお願いを聞いてしまう悪い子になってしまうのだ!\n(最初のどちぅーちぇ)「や、やめろぉ!!こんな事してただじゃすまないからな!!ま、まだはじめてなんだ…そんな…そんなこと…うわぁぁ!!ヒィッ!!入って来たぁ･･酷い‥酷い‥」\n(堕ちた後のドゥーチェ)「こんな気持ちのイイ事知らなかった…ヒィッ!!オマンコイイよぉ‥もっと…もっとセックス…してぇ…乱暴に強くされるのがいいの…腰を激しく、そう…それぇ!!凄いよぉ…こんなのもう、止められないよぉ…!!またイクゥ‥!!…もっとしたいよぉ‥もっとイカせてぇ!!」\n----\nもし宜しければ、お願いいたします。\n\nhttps://www.pixiv.net/artworks/86622873", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 8307, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ヤマグチ", "screen_name": "half_eye_", "avatar_url": "https://pbs.twimg.com/profile_images/1265061748828078080/4EiZIhBq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3179601163/1542325183/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 46646, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "熊猫", "screen_name": "kumaneko1138", "avatar_url": "https://pbs.twimg.com/profile_images/1496427144633008130/3ITUXL_9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1059891414/1645605497/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 186238, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "久壁おと🍥Skeb受付中", "screen_name": "oto_hisakabe", "avatar_url": "https://pbs.twimg.com/profile_images/441512302945107968/ZnxjdCP8.