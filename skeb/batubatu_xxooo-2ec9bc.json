106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=619221c9473e57511450ecb059935bfd 3x"}, "body": "初めまして。イラストを拝見し、ぜひご依頼させていただきたく、リクエストをお送りいたしました。\n\n【使用用途】  \nアイコン、SNSへの掲載および宣伝画像等に使用させていただく予定です。  \n可能でしたら、人物のみの画像も併せてご制作いただけますと幸いです。\n\n【キャラクター】  \n左側に八重歯があり、元気でやんちゃ、少し賑やかな印象のキャラクターです。  \n虎がとても好きで、虎をモチーフにした衣装を身にまとっています。\n\n【構図】  \n可能でしたら、髪や身体が切れていない構図でご制作いただけますと嬉しいです。\nもちろん、難しい場合はご無理のない範囲で大丈夫です。\n\n資料URLを添付いたしますので、ご参考にしていただけましたら幸いです。  \nお手数をおかけいたしますが、何卒よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1YVIturqimDRzuc0plztYELanuZHn-dLP/view?usp=drivesd", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@batubatu_xxooo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2573334, "client_id": 3872017, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d004c57e/uploads/origins/25e7dfd1-ea85-47aa-a5f8-144af9ce3ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4bdee3c4b2393c3ebc5e7ca401bfc54", "srcset": "https://si.imgix.net/d004c57e/uploads/origins/25e7dfd1-ea85-47aa-a5f8-144af9ce3ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4bdee3c4b2393c3ebc5e7ca401bfc54, https://si.imgix.net/d004c57e/uploads/origins/25e7dfd1-ea85-47aa-a5f8-144af9ce3ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7e37be9148ea8f5755205ab5b95d193 2x, https://si.imgix.net/d004c57e/uploads/origins/25e7dfd1-ea85-47aa-a5f8-144af9ce3ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b075753cca39ea6f7a2e4f51f950f8d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d004c57e/uploads/origins/25e7dfd1-ea85-47aa-a5f8-144af9ce3ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06c9401a77ae748080698444de61d7b1", "srcse