思考は脳筋寄り\n✅モチーフ\n・猫/ハート/リボン\n✅活動内容\n・アニメの同時視聴\n・ゲーム\n・雑談/歌\n\n\n【使用用途】\n✅動画配信サイト（収益化済み）でのサムネイル/配信/動画内での使用\n✅アイコンやプロフィール等への使用、ＳＮＳへの掲載\n✅限定コンテンツ内で「個人での観賞目的のみで保存が可能」とし掲載\n✅他素材と合わせての使用や加工など（縦横比の変更や大幅な印象を変えるようなことはいたしません！）\n\n\n【その他】\n✅可能であれば頭頂部など見切れていないと嬉しいですが難しい場合大丈夫です！\n✅透過データがあると嬉しいです！\n\n\n上記問題なければリクエストを受けていただけたら幸いです！\nまた金額や内容が不足等している場合はお手数ですが再送要請をお願いいただければと思います。\nお忙しい中恐れ入りますがご検討の程よろしくお願いいたします！\n\nhttps://drive.google.com/file/d/1B0nBeGcnck4yZg7GnfkBNxM7_J9dTCYF/view?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@batubatu_xxooo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2573334, "client_id": 3606322, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8d5f811/uploads/origins/d3ac6c81-eecf-4d07-93a0-e77e3cb2dfad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=207ae998623da3bfa5f2784e5e163615", "srcset": "https://si.imgix.net/a8d5f811/uploads/origins/d3ac6c81-eecf-4d07-93a0-e77e3cb2dfad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=207ae998623da3bfa5f2784e5e163615, https://si.imgix.net/a8d5f811/uploads/origins/d3ac6c81-eecf-4d07-93a0-e77e3cb2dfad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68790534ca55c6afdc8d0c0ad10c67c4 2x, https://si.imgix.net/a8d5f811/uploads/origins/d3ac6c81-eecf-4d07-93a0-e77e3cb2dfad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=848dae4f647e7f37acb2ed7d87aaa2a1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8d5f811/uploads/origins/d3ac6c81-eecf-4d07-93a0-e77e3cb2dfad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a67bc72b3efcc778ad52a4d70be690ef", "srcset": "https://si.imgix.net/a8d5f811/uploads/origins/d3ac6c81-eecf-4d07-93a0-e77e3cb2dfad?bg=%23fff&auto=format%2