84e/uploads/origins/86f7e6b1-91aa-4727-9a99-321f757e6272?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1280c6d70d38fe6462a8dd42eee87468 2x, https://si.imgix.net/4146b84e/uploads/origins/86f7e6b1-91aa-4727-9a99-321f757e6272?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=732b1d1dc6e2d7edfb3d6fde5bcf4012 3x"}, "body": "初めまして。\nアピールを頂き、とても魅力的な作品が多く、自分のオリジナルキャラクターを描いて頂きたくお願いしたいと思います。\n\nhttps://x.com/autumn_prismfox/status/1632734487485333506?s=20\nこんな感じの子です。\n（ボディスーツに上着を羽織っているという格好になります）\nポーズや表情等はお任せ致します。\n\nよろしくおねがいします。\n\nhttps://x.com/autumn_prismfox/status/1632734487485333506?s=20", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kabao_gs/works/113", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 929278, "client_id": 133554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12f0ba3c/uploads/origins/a6333a1d-d1d2-4ac1-9b6e-2e034447ef76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b263fa9b9c66794bbb69deed17da573", "srcset": "https://si.imgix.net/12f0ba3c/uploads/origins/a6333a1d-d1d2-4ac1-9b6e-2e034447ef76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b263fa9b9c66794bbb69deed17da573, https://si.imgix.net/12f0ba3c/uploads/origins/a6333a1d-d1d2-4ac1-9b6e-2e034447ef76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65e7557af04846ad695527c50cb883a8 2x, https://si.imgix.net/12f0ba3c/uploads/origins/a6333a1d-d1d2-4ac1-9b6e-2e034447ef76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1533b716ff094e6e8272c78e45eaa2d 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12f0ba3c/uploads/origins/a6333a1d-d1d2-4ac1-9b6e-2e034447ef76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d5766faf80e9434145297695ed6dade", "srcset": "https://si.imgix.net/12f0ba3c/uploads/origins/a6333a1d-d1d2-4ac1-9b6e-2e034447ef76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d5766faf80e9434145297695ed6dade, https://si.imgix.net/12f0ba3c/uploads/origins/a6333a1d-d1d2-4ac1-9b6e-2e034447ef76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d8bc556617285421399c3b3a91519ef9 2x, https://si.imgix.net/12f0ba3c/uploads/origins/a6333a1d-d1d2-4ac1-9b6e-2e034447ef76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3077f7b939b912f000ab8e1d34ad31e2 3x"}, "body": "初めまして。\n半年ほどSkebを確認していなかったので、アピールをいただいたのに気づいておらずにおりましたこと、誠に申し訳ありません。\n以前よりPixivではお見かけしていて、ステキな作品が多いのは存じ上げておりましたので、非礼を承知で、自分のオリジナルキャラクターで作品をお願いしたいと思った次第です。\n\nhttps://www.pixiv.net/artworks/99541630\nお願いしたいのはこちらの子になります。\n基本的に常にお腹を下しているような子なので、公園のトイレの裏手に隠れるようにしてしゃがんで、下痢便をぶちまけている様子の作品をお願い致します。\n（トイレで用を足そうとしたけど、中が汚かったとかでやむなく外で…というイメージです）\n\n服装なのですが、こちら（https://www.pixiv.net/artworks/109137637）で描いているジャージ姿でお願いできればと思います。\nアングルや描写など、細かい点についてはお任せ致します。\nよろしくおねがいします。\n\n※自分はツイッターでの活動を止めております（依頼を出した時はskebのログイン設定を変更するため一時的に復帰させただけなので、近日中にツイッターアカウントを再び削除していると思います）ので、万が一Xで紹介と言うことになったら、自分のアカウントは存在していないはずなので、勝手ながらその事だけご了承頂きたいと思います。\n\nhttps://www.pixiv.net/artworks/109137637", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@GreenBullt7/works/146", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 84450, "client_id": 133554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dcb8a054/uploads/origins/8bacf662-8d1e-4420-acff-f869eef85e96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1702491a706697fb0c21d8627fde08e7", "srcset": "https://si.imgix.net/dcb8a054/uploads/origins/8bacf662-8d1e-4420-acff-f869eef85e96?bg=%23fff&auto=format%2Ccompress&fm=webp&f