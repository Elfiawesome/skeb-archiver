\n 　体調が悪い時まで気を遣わなくていいんだよ。 \n　それよりももっと、自分のことを大事にしようぜ。\n 　二人で一緒に、お前のことをいっぱい甘えさせてあげようよ。\n 　ん？　座りたい？　分かった。 　じゃあ、おいで。俺に寄りかかっていいよ。 　ほら、ぎゅーってしてあげる。\n 　ぎゅー……\n 　少しは落ち着いてきた？ 　それならよかった。 \n　でも、今日はもう無理するなよ？\n 　元気になったら、またいっぱいお話ししような。｣", "nc": 17, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 70892, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ひおり🩵ゲムマ日曜-と09", "screen_name": "Ri_L_D", "avatar_url": "https://pbs.twimg.com/profile_images/1968876205886894080/02J2lxGT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1160610954956042240/1758251291/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "voice"}, {"genre": "novel"}], "nc": 17}, {"id": 2419335, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "兎沙(一次創作)", "screen_name": "usanoichiji", "avatar_url": "https://pbs.twimg.com/profile_images/2012082877853470720/n-2eWYoo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1967232284035321856/1776840403/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "novel"}], "nc": 144}, {"id": 2769420, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "アッシュ・ノーウェア🐺🔴Vtuber", "screen_name": "Ash_Nowhere", "avatar_url": "https://pbs.twimg.com/profile_images/2029618387790483458/pWjZA5Z8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1599066487112990720/1759495045/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": 