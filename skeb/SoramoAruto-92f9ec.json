　体調が悪い時まで気を遣わなくていいんだよ。 \n　それよりももっと、自分のことを大事にしようぜ。\n 　二人で一緒に、お前のことをいっぱい甘えさせてあげようよ。\n 　ん？　座りたい？　分かった。 　じゃあ、おいで。俺に寄りかかっていいよ。 　ほら、ぎゅーってしてあげる。\n 　ぎゅー……\n 　少しは落ち着いてきた？ 　それならよかった。 \n　でも、今日はもう無理するなよ？\n 　元気になったら、またいっぱいお話ししような。｣", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1588430, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "けあみす", "screen_name": "4naba_morotomo", "avatar_url": "https://pbs.twimg.com/profile_images/1260591488045445120/yFGFLnel.png", "header_url": "https://pbs.twimg.com/profile_banners/1260586960827158528/1751509355/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 20, "skills": [{"genre": "art"}], "nc": 129}, {"id": 2606266, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "きく乃", "screen_name": "chymum0", "avatar_url": "https://pbs.twimg.com/profile_images/1591957577570652162/2cxLGS1s.jpg", "header_url": "https://pbs.twimg.com/profile_banners/883088371265884161/1601909930/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 145}, {"id": 2769420, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "アッシュ・ノーウェア🐺🔴Vtuber", "screen_name": "Ash_Nowhere", "avatar_url": "https://pbs.twimg.com/profile_images/2029618387790483458/pWjZA5Z8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1599066487112990720/1759495045/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration