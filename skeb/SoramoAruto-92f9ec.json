んだよ。\n 　体調が悪い時まで気を遣わなくていいんだよ。 \n　それよりももっと、自分のことを大事にしようぜ。\n 　二人で一緒に、お前のことをいっぱい甘えさせてあげようよ。\n 　ん？　座りたい？　分かった。 　じゃあ、おいで。俺に寄りかかっていいよ。 　ほら、ぎゅーってしてあげる。\n 　ぎゅー……\n 　少しは落ち着いてきた？ 　それならよかった。 \n　でも、今日はもう無理するなよ？\n 　元気になったら、またいっぱいお話ししような。｣", "nc": 1, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2769420, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "アッシュ・ノーウェア🐺🔴Vtuber", "screen_name": "Ash_Nowhere", "avatar_url": "https://pbs.twimg.com/profile_images/2029618387790483458/pWjZA5Z8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1599066487112990720/1759495045/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "voice"}, {"genre": "novel"}], "banned": false, "nc": 145}, {"id": 3219754, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "柚乃あず", "screen_name": "ynaz000", "avatar_url": "https://pbs.twimg.com/profile_images/1990435671119716352/f4WeRPJK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1424436704291655681/1769865812/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 40, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 3543180, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "こもる", "screen_name": "Nigera_0309", "avatar_url": "https://pbs.twimg.com/profile_images/1875798755154513920/GyLa2Xwq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1875174344919539712/1739888519/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "dele