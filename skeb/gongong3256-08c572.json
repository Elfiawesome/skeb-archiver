で恐縮なのですけど、女の子と男の子の、双子のペア画を要望したいのですが、如何でしょうか？\n先生の作品を拝見したとき、初見から直感のように、先生の手になるその絵を所望したくてたまらなくなり…\n\n師走のお忙しいさなか、手数料キャンペーン終了間際の駆け込みで申し訳ないですけど、ご検討いただけましたら幸いです", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gongong3256/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2490191, "client_id": 15107, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c753cf8/uploads/origins/1e02acb5-fcf1-4baf-b294-91cbaab89de4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ade3e3ea037e8390b576a5bec22e9e62", "srcset": "https://si.imgix.net/4c753cf8/uploads/origins/1e02acb5-fcf1-4baf-b294-91cbaab89de4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ade3e3ea037e8390b576a5bec22e9e62, https://si.imgix.net/4c753cf8/uploads/origins/1e02acb5-fcf1-4baf-b294-91cbaab89de4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=835bf1f92049535138bc507776b547b6 2x, https://si.imgix.net/4c753cf8/uploads/origins/1e02acb5-fcf1-4baf-b294-91cbaab89de4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b85c4f59cf1e5163fbf0e10e2edc7d8b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c753cf8/uploads/origins/1e02acb5-fcf1-4baf-b294-91cbaab89de4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c9220e03da6b44dc6adf005b6dd5b81", "srcset": "https://si.imgix.net/4c753cf8/uploads/origins/1e02acb5-fcf1-4baf-b294-91cbaab89de4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c9220e03da6b44dc6adf005b6dd5b81, https://si.imgix.net/4c753cf8/uploads/origins/1e02acb5-fcf1-4baf-b294-91cbaab89de4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b2f1f098b9c603b62c5231670424fa7 2x, https://si.imgix.net/4c753cf8/uplo