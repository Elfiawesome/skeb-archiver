eator_id": 3992851, "client_id": 227300, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f057721/uploads/origins/408a2059-852b-43ae-880e-27830bf2c98a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95672aba4ae2ca8d26a8a03ba7455160", "srcset": "https://si.imgix.net/9f057721/uploads/origins/408a2059-852b-43ae-880e-27830bf2c98a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95672aba4ae2ca8d26a8a03ba7455160, https://si.imgix.net/9f057721/uploads/origins/408a2059-852b-43ae-880e-27830bf2c98a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff3971cac5aafdb66e1636042bf274ca 2x, https://si.imgix.net/9f057721/uploads/origins/408a2059-852b-43ae-880e-27830bf2c98a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb45fae8b3c7cc756c8bf65b87f24d2b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f057721/uploads/origins/408a2059-852b-43ae-880e-27830bf2c98a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01f812c0caa5bef32d1e9e415ccd318b", "srcset": "https://si.imgix.net/9f057721/uploads/origins/408a2059-852b-43ae-880e-27830bf2c98a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01f812c0caa5bef32d1e9e415ccd318b, https://si.imgix.net/9f057721/uploads/origins/408a2059-852b-43ae-880e-27830bf2c98a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa599b8da90979bb78f9343a52260f34 2x, https://si.imgix.net/9f057721/uploads/origins/408a2059-852b-43ae-880e-27830bf2c98a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7bfa8b1de836f13d1b3177785889fd1e 3x"}, "body": "Tamさんはじめまして。るげつぺぽと申します。\n原神の男の子のかわいいイラストをXにて拝見し、今回お願いしたいと思いました。\nかわいさとかっこよさが合わさったようなイラストがとても好きなので、そのように描いていただけるととっても嬉しいです。\n\n趣味の配信で使用している代理キャラクター(顔色ちゃん)をお願いしたいです。\n15歳の男の子、身長155～160、顔は若干中性よりです。\n髪の毛は白と青色のツートンで、普段は眠そうにしてて抜けてますが、やるときはやる子です。\n全体図参考\nhttps://twitter.com/rugetsupepo/status/1690939483074826240\n表情変化分参考\nhttps://twitter.com/rugetsupepo/status/1664293689412435968\n新衣装\nhttps://x.com/rugetsupepo/status/1906691283889901583\n\nほっぺたや顔の輪郭に柔らかさがあると嬉しいです。\nこれは出来ればのお願いなのですが、顎を90度以上の鈍角で描いて欲しいです。柔らかさを感じられて好きなので…難しそうだったり、描きたい方向と違えばそうじゃなくても大丈夫です。\n服装や構図、シチュエーションなどはおまかせします。キャラクターの衣装を乗せておりますが、見えない部分の補完などは好きにしてくださっても大丈夫ですし、全く違う衣装を着せていただいても大丈夫です。\n\n太極図のアクセサリはキャラクターのモチーフでもあるので、必ず入れて欲しいです。\nSNSのアイコンやヘッダ、またはYouTubeなどで使用する可能性があります。(収益用途では使いません)\n下部以外のキャラクターや衣装に見切れがないようにしてほしいです。\nお手数おかけしますが背景や文字などある場合はキャラ単体のものもほしいです。\n形式はpsdまたはpngでお願いします。\n\nお値段や条件が合わない、描きづらいなどあればキャンセルしていただけると幸いです。\n以上の内容でお受けできそうであれば、是非お願いしたいです！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1221736, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あうぇいぶ@依頼募集中", "screen_name": "_cmhp", "avatar_url": "https://pbs.twimg.com/profile_images/2076975735718420480/1FNZUrMi.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3239669742/1761183952/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 2497833, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ナナ@skeb募集中", "screen_name": "nana_oji37", "avatar_url": "https://pbs.twimg.com/profile_images/1538537424216678400/-_k9X1y1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1537168766772994048/1657184687/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"g