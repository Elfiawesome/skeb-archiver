いてください。\n\n迷之电波：\nhttps://drive.google.com/file/d/1pVxMssNeg5btZ4YX03sHA_2VBK3ld50G/view\n\n細かい部分はアレンジして頂いて構いません。構図、背景等はおまかせします。\n\nまた可能でしたらデータはpsdで、キャラと背景のレイヤーを分けて頂けますと幸いです。\nよろしくお願いいたします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@libre1907/works/216", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1795872, "client_id": 3540855, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b99efcdf/uploads/origins/35034531-798a-4dbb-be5c-d75b5cfbc519?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f336d7fa983640a08b0243e6052ab321", "srcset": "https://si.imgix.net/b99efcdf/uploads/origins/35034531-798a-4dbb-be5c-d75b5cfbc519?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f336d7fa983640a08b0243e6052ab321, https://si.imgix.net/b99efcdf/uploads/origins/35034531-798a-4dbb-be5c-d75b5cfbc519?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21d50c0648984992490c5cc1993e84dc 2x, https://si.imgix.net/b99efcdf/uploads/origins/35034531-798a-4dbb-be5c-d75b5cfbc519?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4a641f5b9eca6fa9d7a455ccb94a0db 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b99efcdf/uploads/origins/35034531-798a-4dbb-be5c-d75b5cfbc519?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aac29df506198c3db389a9912e18603c", "srcset": "https://si.imgix.net/b99efcdf/uploads/origins/35034531-798a-4dbb-be5c-d75b5cfbc519?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aac29df506198c3db389a9912e18603c, https://si.imgix.net/b99efcdf/uploads/origins/35034531-798a-4dbb-be5c-d75b5cfbc519?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1fd657f40996af4333b980c9afa231f5 2x, https://si.imgix.net/b99efcdf/uploads/origins/35034531-798a-4dbb-be5c-d75b5cfbc519?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3dfca6fd7d1247b3549358605b7d745d 3x"}, "body": "はじめまして。私を描いていただけませんか？\n\n私は猫の修道女です。最初の参考画像を使って、マントとベールをつけた私を描いていただけませんか？二枚目の参考画像は私が下に着ている服です。\n\n私の武器も描いてほしいです。とても大まかな参考画像なので、細部の追加や変更はご自由にどうぞ。私の全身と同じくらいの大きさの、柄の長い大きな鈴です。ホウキくらいの長さ。\n武器の参考：https://drive.google.com/file/d/1-2ClTpzd1Eqx5XHWIKT77LNGvTy2ABeg/view?usp=drivesdk\n\nよく見ると、僕の目のハイライトは猫の形をしている。\n背景やポーズは何でもOK。あとはお任せします。\n\n作品はsnsやサムネイルに使いたいと思います。ステッカーや缶バッジなどのグッズ制作にも使用させていただくかもしれません。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1gLQ74Aeyo9M1oBTdR_1-aK34j9ChHSQX?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@libre1907/works/215", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1795872, "client_id": 3173854, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/82ec40a0/uploads/origins/141077bf-bfeb-4398-8d9c-b45f9af371f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd1527b00728ab1c105c3c3e15c8c982", "srcset": "https://si.imgix.net/82ec40a0/uploads/origins/141077bf-bfeb-4398-8d9c-b45f9af371f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd1527b00728ab1c105c3c3e15c8c982, https://si.imgix.net/82ec40a0/uploads/origins/141077bf-bfeb-4398-8d9c-b45f9af371f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a834707df9f8db4a3b43183236ae1c4 2x, https://si.imgix.net/82ec40a0/uploads/origins/141077bf-bfeb-4398-8d9c-b45f9af371f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77250c484036f28b579fa30fb10ffb14 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82ec40a0/uploads/origins/141077bf-bfeb-4398-8d9c-b45f9af371f2?bg=%