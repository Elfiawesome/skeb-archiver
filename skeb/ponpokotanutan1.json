humbnail_image_urls": {"src": "https://si.imgix.net/a830712e/uploads/origins/1397fbe9-4c17-47f0-998c-b23416d48af3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53f386bb88814ee9b576b99357a67fc4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a830712e/uploads/origins/1397fbe9-4c17-47f0-998c-b23416d48af3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4b84a5e93863febc2ea8bc18bc44e2f", "src_set": ""}, "body": "はじめまして、傘さしたぬきさん。個人Vtuberの猫花と申します。\nイラストを拝見させて頂き、気に入ったので、是非私のイラストを描いてほしい。\n\n挑発的な笑顔の前かがみポーズで描いてくれますか、詳しいところはたぬきさんにお任せします。\n三面図の設定は資料URLで参考してください。\n＊注意点：人耳はありません。\n\n使用用途は配信サムネ、SNSでのポストです。\n良ければ透過Verがありましたら助かります。\n\nご検討いただければ幸いです、よろしくお願いします。\n\nhttps://imgur.com/a/MOFGmxZ", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ponpokotanutan1/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7913bb09/uploads/origins/08e30aad-98aa-44bc-a4ee-614223bc5ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=550fecc9aaa1dbdf5d4bbf7715dfd868", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3463033, "client_id": 3487328, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ponpokotanutan1/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3463033, "client_id": 772651, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d45af79/uploads/origins/8f355a51-2194-4809-855e-57ab5e71c30a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h