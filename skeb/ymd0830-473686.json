07-b9c6-bfbf94005e44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70d84845a446ca63c6f59c1e6eb79952 2x, https://si.imgix.net/e9bc1e89/uploads/origins/259bbd44-2089-4407-b9c6-bfbf94005e44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9ab7b1918cb20e464adf033e7ed8c5f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9bc1e89/uploads/origins/259bbd44-2089-4407-b9c6-bfbf94005e44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a2347167571f41b0e136d3649b0f837", "srcset": "https://si.imgix.net/e9bc1e89/uploads/origins/259bbd44-2089-4407-b9c6-bfbf94005e44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a2347167571f41b0e136d3649b0f837, https://si.imgix.net/e9bc1e89/uploads/origins/259bbd44-2089-4407-b9c6-bfbf94005e44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=beb16a96e28b076b76cafc3974255b09 2x, https://si.imgix.net/e9bc1e89/uploads/origins/259bbd44-2089-4407-b9c6-bfbf94005e44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0540da3d55936b35d2cb732aa06486cf 3x"}, "body": "はじめまして！17LIVEで活動している犬飼ゆらと申します。山田佐藤様のイラストがXで流れてきて一目惚れしてぜひ描いて頂きたいと思いご連絡致しました。\n\n《依頼内容》\n犬飼ゆらのイラスト\n\n《キャラ特徴》\n魔界出身の小悪魔、髪型はロングウルフ、八重歯あり、目の色は水色。\n性格は声がでかい、口が悪い、ゲラ、情に厚いです。\n\n《使用用途》\n17LIVE(配信内やサムネ)での使用(収益化あり)\nSNSの告知やアイコン\nグッズ化(販売はいたしません。)\n第三者へのOC資料\n個人鑑賞\n\n\n《希望》\n構図や表情は特に指定はございません。髪型、服装のみ指定ありです。\n細かい部分は簡略化して頂いて構いません。羽根はありでもなしでもどちらでも大丈夫ですが、角はマストでお願いします！\n参考資料に服単体と衣装単体のものを入れておりますのでそちら参考にして頂ければと思います。髪色は元の立ち絵のカラーでお願いします。\n\n《納品》\nPSD(人物、背景、文字などレイヤー分け)で頂けたら幸いです。\n\n\n不備や料金の不足等ありましたら御手数ですが差し戻して頂けると幸いです。\nお忙しいとは思いますがご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1a9_04x0tnu8xgyl-Ap_ONZhHb7LITXqT", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ymd0830/works/13", 