G\n\n・女性器の形状はそれぞれ違うものに。\n\n以上になります。\nよろしくお願いいたします。\n\n資料①\nhttps://imas.gamedbs.jp/cgss/chara/detail/233\n※表情6\n\n資料②\nhttps://imas.gamedbs.jp/cgss/chara/detail/165\n※表情デフォルト\n\n資料③\nhttps://imas.gamedbs.jp/cgss/chara/detail/247\n※表情デフォルト\n\n資料④\nhttps://drive.google.com/file/d/1hlUB0AFwiCHq5SiM3gSg1-7cwGb7eYoL/view?usp=drivesdk", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@futagahirakanai/works/366", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1882835, "client_id": 148762, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/79f44270/uploads/origins/0aaa595b-bd99-4f36-aaaa-ebd1de0084f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89475db73b91f5165de705e327f61eca", "srcset": "https://si.imgix.net/79f44270/uploads/origins/0aaa595b-bd99-4f36-aaaa-ebd1de0084f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89475db73b91f5165de705e327f61eca, https://si.imgix.net/79f44270/uploads/origins/0aaa595b-bd99-4f36-aaaa-ebd1de0084f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4328ec386585cb440381fb8a4c56287f 2x, https://si.imgix.net/79f44270/uploads/origins/0aaa595b-bd99-4f36-aaaa-ebd1de0084f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd388888d16cdf5445876079fb26c63c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/79f44270/uploads/origins/0aaa595b-bd99-4f36-aaaa-ebd1de0084f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41f6bb222fd1c264ab1e6c577dcf67ab", "srcset": "https://si.imgix.net/79f44270/uploads/origins/0aaa595b-bd99-4f36-aaaa-ebd1de0084f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41f6bb222fd1c264ab1e6c577dcf67ab, https://si.imgix.net/79f44270/uploads/origins/0aaa595b-bd9