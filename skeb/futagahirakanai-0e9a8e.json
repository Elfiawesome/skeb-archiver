0a13f10860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03fe9ec945f33903cb3505e46b6444a4, https://si.imgix.net/cf7b4fbf/uploads/origins/824c3130-599f-4ffb-b424-840a13f10860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee39c19172ca8c25d67dd00ea87f6520 2x, https://si.imgix.net/cf7b4fbf/uploads/origins/824c3130-599f-4ffb-b424-840a13f10860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14a2c5b9cd06828aad4041e248a97f4a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf7b4fbf/uploads/origins/824c3130-599f-4ffb-b424-840a13f10860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39d01913e3606c4364149aafa4c47aa1", "srcset": "https://si.imgix.net/cf7b4fbf/uploads/origins/824c3130-599f-4ffb-b424-840a13f10860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39d01913e3606c4364149aafa4c47aa1, https://si.imgix.net/cf7b4fbf/uploads/origins/824c3130-599f-4ffb-b424-840a13f10860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a899c58c5366049ee8988ca0f6175069 2x, https://si.imgix.net/cf7b4fbf/uploads/origins/824c3130-599f-4ffb-b424-840a13f10860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df2023460200a2d68182bcdf906a0df6 3x"}, "body": "お世話になっております。\n今回の依頼もぜひよろしくお願いいたします。\n\n【キャラ】 \nデレマス　島村卯月/棟方愛海/クラリス\n\n【構図】 \nこれまでの立ち絵同様でお願いします。\nそれぞれ資料①～③を参照してください。\n\n【ポイント】\n ・タトゥーの位置→全員右\n\n・ネイル・ピアス・陰毛(髪色)・剃り跡→これまで同様\n\n・靴下系→これまで通りの2種類\n \n・下着色→資料④参照\n\n・ピース→卯月と愛海が両手、クラリスが右手\n・中指立て→全員右手\n愛海は左手を下げた差分、クラリスは両手を後ろに回した差分もお願いします。\n\n・身長→卯月159cm、愛海151cm、クラリス166cm\n\n・胸のサイズ→卯月G、クラリスF、愛海DとEの２パターン\n\n・女性器の形状はそれぞれ違うものに。\n\n以上になります。\nよろしくお願いいたします。\n\n資料①https://imas.gamedbs.jp/cgss/chara/detail/101\n※表情デフォルト\n資料②https://imas.gamedbs.jp/cgss/chara/detail/121\n※表情デフォルト\n資料③https://imas.gamedbs.jp/cgss/chara/detail/158\n※表情②\n資料④https://drive.google.com/file/d/1JUxgpgSZqYzpcveP6ccHas4AfvH3pX-f/view?usp=drivesdk", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@futagahirakanai/works/382", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1882835, "client_id": 464201, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2eff32f/uploads/origins/d9b14df2-b37d-4d3a-8a02-5c7fe5ab24a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d92841911ed36065a20c5c8cd6adadb9", "srcset": "https://si.imgix.net/b2eff32f/uploads/origins/d9b14df2-b37d-4d3a-8a02-5c7fe5ab24a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d92841911ed36065a20c5c8cd6adadb9, https://si.imgix.net/b2eff32f/uploads/origins/d9b14df2-b37d-4d3a-8a02-5c7fe5ab24a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8d2579d33a20a1b67a2786d7094d503 2x, https://si.imgix.net/b2eff32f/uploads/origins/d9b14df2-b37d-4d3a-8a02-5c7fe5ab24a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9630fca2106ceb06ba4075bad9cfda7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2eff32f/uploads/origins/d9b14df2-b37d-4d3a-8a02-5c7fe5ab24a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0212745607bee168d02f709faa4ff4e2", "srcset": "https://si.imgix.net/b2eff32f/uploads/origins/d9b14df2-b37d-4d3a-8a02-5c7fe5ab24a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0212745607bee168d02f709faa4ff4e2, https://si.imgix.net/b2eff32f/uploads/origins/d9b14df2-b37d-4d3a-8a02-5c7fe5ab24a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4088d172e99dc260a3488ccd6bc045e1 2x, https://si.imgix.net/b2eff32f/uploads/origins/d9b14df2-b37d-4d3a-8a02-5c7