xiv.net/artworks/149587524\n上のイラストで負けた男が芽流にリベンジするもヒップアタックのみでボコボコにされる→スティンクフェイス(コーナーで座り込んだ男の顔にお尻をねじ込む技)でKOされるイラストをお願いします\n\n芽流の衣装はいつもので、お尻ほぼ丸出しにしてください。出来れば衣装のお尻に挟まってる部分を右にずらして生尻にしてる差分をお願いします。芽流がお尻でリベンジを完封されている相手を煽るセリフもお願いいたします\n男の衣装はボクサーがよく履いてるブカブカの半ズボンでお願いします", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nanakokostay/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4103587, "client_id": 1082723, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd2c356e/uploads/origins/3d7d8772-8eee-475c-ad9e-f2dd03d72d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13916fca251e13b66ea4ea2252eeaf96", "srcset": "https://si.imgix.net/cd2c356e/uploads/origins/3d7d8772-8eee-475c-ad9e-f2dd03d72d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13916fca251e13b66ea4ea2252eeaf96, https://si.imgix.net/cd2c356e/uploads/origins/3d7d8772-8eee-475c-ad9e-f2dd03d72d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c8a6c9809738c4f380d3fe35a5f733b 2x, https://si.imgix.net/cd2c356e/uploads/origins/3d7d8772-8eee-475c-ad9e-f2dd03d72d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8cfba7ef8deb613fb28778a56bb213d1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd2c356e/uploads/origins/3d7d8772-8eee-475c-ad9e-f2dd03d72d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7767e25ad3439c08ff6d55f32a072667", "srcset": "https://si.imgix.net/cd2c356e/uploads/origins/3d7d8772-8eee-475c-ad9e-f2dd03d72d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7767e25ad3439c08ff6d55f32a072667, https://si.imgix.net/cd2c356e/uploads/origins/3d7d8772-8eee-475c-ad9e-f2dd03d72d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c3bb43db9944d10049a70eaef2a4c03d 2x, https://si.imgix.net/cd2c356e/uploads/origins/3d7d8772-8eee-475c-ad9e-f2dd03d72d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a8f4bef39aac8e719db5734159e9c2d 3x"}, "body": "【Ｈ＿ＥＲＯ：ピン】ＫＦ－02A　アルナが良かったのでリクエストさせてください。\n以下の設定のセリフ付イラストをお願い致します。\n\n【Ｈ＿ＥＲＯ：ピン】ＫＦ－02A　アルナと\n【Ｈ＿ＥＲＯ：ピン】KF-R1　コヨリ（メガネ無し）\nが敵に完敗して連れ去られたその後で\n\nＫＦ－02A　アルナとKF-R1　コヨリ（メガネ無し）が変身後のスーツで乳部分が丸出しな感じで\n敵の５人目の子を妊娠してボテ腹になり、黒くなった巨乳輪から母乳を出しながら正面を向いて騎乗位で敵２人に中出しされているイラスト。\n２人は敵の子を妊娠出産しまくっているが、隙を見て脱出することを報告している。\n\nもしできれば差分でアルナとコヨリ（メガネ無し）が、変身前の全裸で敵の１０人目の子を妊娠してボテ腹になり黒くなった巨乳輪から母乳を出しながら正面を向いて騎乗位で敵２人に中出しされているイラスト。\n２人は敵の妻としてラブラブであり、子作りに励んで子は２０人以上作る予定なことを市民や仲間に報告している。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nanakokostay/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4103587, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f111f05a/uploads/origins/8628c1ca-bb3e-4c19-a0f2-a9fa3150dfae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40000256df9d83d4b7af709054ba7ade", "srcset": "https://si.imgix.net/f111f05a/uploads/origins/8628c1ca-bb3e-4c19-a0f2-a9fa3150dfae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40000256df9d83d4b7af709054ba7ade, https://si.imgix.net/f111f05a/uploads/origins/8628c1ca-bb3e-4c19-a0f2-a9fa3150dfae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f569f9c72939d1f999eccd5ced84b01 2x, https://si.imgix.net/f111f05a/uploads/origins/8628c1ca-bb3e-4c19-a0f2-a9fa3150dfae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8b46bdd708cd06df65748cf7b26242f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f111f05a/uploads/origins/8628c1ca-bb3e-4c19-a0f2-a9fa3150dfae