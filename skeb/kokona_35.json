がら2つ返事で了承。\nヘッドの上に座り、「少し頭あげるね」と横になってるご主人の頭を自分の膝に乗せて膝枕する。\nご主人に頭が重くないかと聞かれるが、自分にとってはそれが良いので気にしてないので「重くないから頭預けて良いよ」というとご主人は安心したかのように頭を膝に預けてくれたのを確認して\n「優しくやっていくからね」と耳かきを始めていく。\n「落ち着く？」「大丈夫？」「気持ちいい？」と耳元で小声で囁きながら優しく耳かきしていく。\nご主人の様子を伺いながら耳の中を優しく掻いて行き\n「痒いのここら辺？」「痛くない？」「これくらいで大丈夫？」とご主人の要望に合わせて掻く力加減の強弱を変えていく。\n中を掻いて行きながら途中から「カリカリカリ」「ガリガリガリ」とオノマトペを囁いていく\n耳掃除の手順は耳かき→梵天→綿棒で耳の中をクルクル→耳ふーで片側の耳かきが終わったら反対側の耳掃除もやっていく。\n掃除が終わった後に膝の上でご主人の今にも寝そうな表情を見て「眠いの？」「眠いなら寝ていいよ」と眠りに誘う様に囁く。\n最後に「お休みご主人」と囁くように言う", "nc": 145, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@kokona_35/works/4", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1792517483976634368%2FWBfPQokx.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91b2dbda8f6ec03a424dee55f972b917", "src_set": ""}, "private": true, "genre": "voice", "tipped": false, "creator_id": 2198732, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kokona_35/works/3", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1792517483976634368%2FWBfPQokx.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91b2dbda8f6ec03a424dee55f972b917", "src_set": ""}, "private": true, "genre": "voice", "tipped": true, "creator_id": 2198732, "client_id": 3339164, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "cr