で軽口が多い\n・自分がエリートであることを自覚していて尊大\n・他人に弱みを見せたくない。玉木には猶更\n・幼少期に家族を亡くしており、玉木家にサポートしてもらったため一家に感謝している\n・玉木が恋愛関係を望んでいなさそうであるため、自分が恋情を抱いていることに罪悪感がある\n\n▽その他\n・付き合いが長くお互い無意識的に距離が近い\n\nシチュエーションやファッションは自由にお任せします！\nいただいたコミックは個人利用のほか、友人間でのデータ共有、私的に印刷させていただいたり、\nまた一部をトリミングしてオンラインでTRPGにて遊ぶ際に、お部屋の装飾として利用させていただくことがございます。\n金額に不足がありましたら再送依頼をお送りください。\nご縁がありましたらとても嬉しいです、どうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/16ocENQgs4wNZDnv_FDSWP1yfnR7GJqKs?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@donkondeken/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 112947, "client_id": 2482742, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09813a78/uploads/origins/e685ce28-38c2-4808-acd4-f161f4ae1918?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34ca20043d47adf6da55f3120bbed1e3", "srcset": "https://si.imgix.net/09813a78/uploads/origins/e685ce28-38c2-4808-acd4-f161f4ae1918?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34ca20043d47adf6da55f3120bbed1e3, https://si.imgix.net/09813a78/uploads/origins/e685ce28-38c2-4808-acd4-f161f4ae1918?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b811e4261d298d0983168c646ff6c104 2x, https://si.imgix.net/09813a78/uploads/origins/e685ce28-38c2-4808-acd4-f161f4ae1918?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2920d8c9920e273c033d1dd34c862bdb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09813a78/uploads/origins/e685ce28-38c2-4808-acd4-f161f4ae1918?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d6c8920f5a204f3657684c9dddfd9df", "srcset": "https://si.imgix.net/09813a78/uploads/origins/e685ce28-38c2-4808-acd4-f161f4ae1918?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cro