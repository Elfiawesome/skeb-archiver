f-48bd-b178-3328287ee363?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b1e842f9144e194be8de600d0c75974", "srcset": "https://si.imgix.net/d04ac616/uploads/origins/f1f4554d-800f-48bd-b178-3328287ee363?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b1e842f9144e194be8de600d0c75974, https://si.imgix.net/d04ac616/uploads/origins/f1f4554d-800f-48bd-b178-3328287ee363?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5b98a64306bf69e4de3083cdae08bc8b 2x, https://si.imgix.net/d04ac616/uploads/origins/f1f4554d-800f-48bd-b178-3328287ee363?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=42a8f9e0c618da6c1067b796d87597f4 3x"}, "body": "先生、こんにちは！またお手数をおかけして申し訳ありません。前回の作品、本当に素晴らしかったです。人間関係の描写が実に魅力的で……今回は、私のオリジナルキャラクターのイラストを描いていただけないでしょうか。\nキャラクターは前回の依頼時と同じです。Googleドライブに説明や参考資料を追加しました。\n現代版：https://drive.google.com/drive/folders/1KMEn7QCYBhNu8l6sBjiak2dvI5AMy758?usp=drive_link\n古代ギリシャ版：https://drive.google.com/drive/folders/1lbfSue_8MpnjlxS0AScg3hbSwoR3kh78?usp=drive_link\n雰囲気の参考：ヒトリエ-sleepwalk\n二人の間の微妙な感情がイラストに表れることを願っています！どのような描き方でも、あなたの作品はきっと美しいものになると思います。\n衣装は自由にシンプルにしたりアレンジしたりしてください。ぜひご自身のスタイルを表現してください！\n金額が不足している場合はお知らせください。指示通りにリクエストを再送信します。ありがとうございます！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@donkondeken/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 112947, "client_id": 2403555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/150ff657/uploads/origins/0cbe70a6-2ced-4b0c-bd4b-1b02ed65575b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1ca34e7f214818185ca1b9157d01e64", "srcset": "https://si.imgix.net/150ff657/uploads/origins/0cbe70a6-2ced-4b0c-bd4b-1b02ed65575b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1ca34e7f214818185ca1b9157d01e64, https://si.imgix.net/150ff657/uploads/origins/0cbe70a6-2ced-4b0c-bd4b-1b02ed65575b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd4d4dc0c31e2b4f1d9db14f9d00ed59 2x, https://si.imgix.net/150ff657/uploads/origins/0cbe70a6-2ced-4b0c-bd4b-1b02ed65575b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92d469c466bc60b8bb23740aa262b8a3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/150ff657/uploads/origins/0cbe70a6-2ced-4b0c-bd4b-1b02ed65575b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f13a5f129ef56820193f0d874b911ec", "srcset": "https://si.imgix.net/150ff657/uploads/origins/0cbe70a6-2ced-4b0c-bd4b-1b02ed65575b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f13a5f129ef56820193f0d874b911ec, https://si.imgix.net/150ff657/uploads/origins/0cbe70a6-2ced-4b0c-bd4b-1b02ed65575b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=edfbd98477ead6cde1c733a6a5cc08de 2x, https://si.imgix.net/150ff657/uploads/origins/0cbe70a6-2ced-4b0c-bd4b-1b02ed65575b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=46035b3a2bb9539feec806a1cb026936 3x"}, "body": "こんばんは、先日は素敵なコミックをありがとうございました！\n今回はイラストをお願いしたく、ご確認ご検討お願いします。\n\n■キャラ\n資料の中の①②の2名をお願いします。自作ゲームのキャラクターです。\n他のキャラクターは情報の補完になればと同梱しています。また「会話スクショ」というフォルダの中に、ゲーム内の会話シーンのスクショも色々入れてあります。（このスクショは制作中に撮ったため立ち絵がラフ画になっています）\n\n■内容\n作中で「ファミレスで色々テイクアウトしてベンチで晩酌したことがある」という会話があり（⑦の4枚です）、そのシーンをイメージでお願いしたいです。\nまた、モノクロまたはグレースケールでお願いできればと思っています。\n\n■利用用途\n個人鑑賞です。\n\n以上、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1c6mbBaJVWBmFvEwYVuzg7QYe4Vg5DpS_?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@donkondeken/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 112947, "client_id": 2595508, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ba2f897/uploads/origins/5e8f8bdf-5e97-4ff8-bea7-92f1724857c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8a40d9da0eacfb98e924a4c104cb77a", "srcset": "https://si.imgix.net/0ba2f897/uploads/origins/5e8f8bdf-5e97-4ff8-bea7-92f1724857c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8a40d9da0eacfb98e924a4c104cb77a, https://si.imgix.net/0ba2f897/uploads/origins/5e8f8bdf-5e97-4ff8-bea7-92f1724857c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c12d0c1b9c3e10a77ccd0a2080b5bc2 2x, https://si.imgix.net/0ba2f897/uploads/origins/5e8f8bdf-5e97-4ff8-bea7-92f1724857c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36fc62dc52b3bd39068c029103de9030 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ba2f897/uploads/origins/5e8f8bdf-5e97-4ff8-bea7-92f1724857c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=396669a2fe9450fe370d9d6186f2d6dd", "srcset": "https://si.imgix.net/0ba2f897/uploads/origins/5e8f8bdf-5e97-4ff8-bea7-92f1724857c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=396669a2fe9450fe370d9d6186f2d6dd, https://si.imgix.net/0ba2f897/uploads/origins/5e8f8bdf-5e97-4ff8-bea7-92f1724857c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1d3b393eacc54ebfe22034dcfc611136 2x, https://si.imgix.net/0ba2f897/uploads/origins/5e8f8bdf-5e97-4ff8-bea7-92f1724857c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea03eb2728ead45b99acfb4249e8d5cb 3x"}, "body": "こんにちは。突然のご連絡失礼いたします。ぜひご協力いただければと思っております。\n参考画像も添付しております。彼らのために漫画を描いていただけませんか？\n\n女性は、クールで強気な童顔の女性刑事という設定です。女の子の表情は、たいてい淡々としている\n\nこの男子は、やや偏執的な男子高校生だ\nまた、この関係性では女性のほうが主導権を握っているイメージです。\n\nその男性が女性に助けられた後、家で過ごすほのぼのとした情景を描いていただけませんか？\n\nあるいは、私が提示した概要をもとに、ご自身で自由にアレンジしていただいても構いません\n\n彼らはそれぞれ、家庭内暴力の被害者と担当の警察官である、男性は女性に対して非常に強い愛着と憧れを抱いているが\n\n申し訳ございませんが、現在OCインタラクションに関する原稿は手元にございません。そのため、お役に立てるよう、お二人の簡単なプロフィールをまとめました。それでも制作が難しい場合は、お断りいただいても構いません。\n\n金額を変更することもできます\n\nhttps://drive.google.com/drive/folders/1IMIlL4OdPnNkqdXw81DI7H4Vo4I-f72i", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@donkondeken/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 112947, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/679d4931/uploads/origins/14493c03-dd08-4f44-9fbc-f23d84d0d59e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=336125a6e352468bf747fd426eb7095e", "srcset": "https://si.imgix.net/679d4931/uploads/origins/14493c03-dd08-4f44-9fbc-f23d84d0d59e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=336125a6e352468bf747fd426eb7095e, https://si.imgix.net/679d4931/uploads/origins/14493c03-dd08-4f44-9fbc-f23d84d0d59e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37c74882e9bdad4e27c3339960501a63 2x, https://si.imgix.net/679d4931/uploads/origins/14493c03-dd08-4f44-9fbc-f23d84d0d59e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0914bab3e05404473b42e502387562ab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/679d4931/uploads/origins/14493c03-dd08-4f44-9fbc-f23d84d0d59e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=319523238abee2bf5d02229e9a9c4eb6", "srcset": "https://si.imgix.net/679d4931/uploads/origins/14493c03-dd08-4f44-9fbc-f23d84d0d59e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=319523238abee2bf5d02229e9a9c4eb6, https://si.imgix.net/679d4931/uploads/origins/14493c03-dd08-4f44-9fbc-f23d84d0d59e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa669f1ca149d283e8d57f837a22b716 2x, https://si.imgix.net/679d4931/uploads/origins/14493c03-dd08-4f44-9fbc-f23d84d0d59e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=be196d422e09358643266e175bda8b20 3x"}, "body": "らくた様、こんにちは。\n最近少し落ち着かれた頃かなと思い、改めて漫画のご依頼させていただけませんか…！\n\nもし自由度高めの方が描きやすければ、資料内のテーマからお好きなものを選んでいただいても大丈夫です◎\n\nもちろん、今回も難しそうでしたらお気になさらずです……！🌸\n\n男性：黒髪·茶色の瞳\n ·殺人犯\n・普段は無表情、または少しぼーっとした電波系男子\n・犬系\n・スキンシップが多く、よくキスやハグをする、少し甘えん坊\n・甘噛みする癖がある\n\n女の子：黒髮·青い瞳\n ·殺人犯に監禁されてる\n・無邪気で可愛らしい\n・とても甘えん坊な性格で、照れやすい\n・少しいたずらっ子\n・いつもおしゃべりしてる\n・M気質で、痴女タイプ\n\n【衣装】\n自由にアレンジしていただいて問題ありません。\n\n【雰囲気】\n\n不自然な部分や語法などはご自由に調整していただいて大丈夫です◎\n\n道中、男性が「彼女を監禁してからの出来事」を思い返しているシーン\n\n地下室の壁一面には、彼女が描いた落書きが広がっている\n女の子：見てみて！私って天才じゃない？\n\nさらに、彼が大事にしていたポテトチップスやチョコアイスも全部食べてしまう\n女の子：もし鬼になったら、コンビニに行ってアイス取ってきてあげるね！\n\nいたずらで、彼の顔に猫のヒゲの落書きもしている\n女の子：えへへ…\n\nそして今は、彼に彼女の家からゲーム機やぬいぐるみを持ってこさせている\n彼はSwitchやハムスターのぬいぐるみなどを抱えたまま、地下室の扉を開ける\n\n彼女は彼の帰りに気づくと、とても嬉しそうな表情で迎える。片足には足枷がついている\n女の子：おかえり〜旦那ちゃん~\n\n（冗談っぽく使っている呼び方のイメージです）\n\n全体的には、男性がふと「自分の世界には彼女しかいない」と気づくような感覚。少し呆れつつも、それを受け入れてしまっているような雰囲気を希望したい。\n\nあくまで参考程度ですので、解釈や構図はお任せいたします。\n\n↓資料\nhttps://drive.google.com/drive/folders/1vXzQSL4ZN1Hafpj-4m35tgzNWn6UQW9B?usp=sharing\n\n使用用途は\n・個人鑑賞\n\n金額不足など、不備がありましたら、お手数ですが再送していただけますと幸いです。\nどうぞよろしくお願いいたします。", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@donkondeken/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 112947, "client_id": 2755750, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57f2eaa3/uploads/origins/26c1be5e-a035-426a-9181-b2947dfefad7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5974f1e19a3e7cd998b054d7d9e4d5b1", "srcset": "https://si.imgix.net/57f2eaa3/uploads/origins/26c1be5e-a035-426a