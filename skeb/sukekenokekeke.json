tworks/110539946\n\nファイナルファンタジーVII リメイク\nティファ・ロックハート\n\n敵に捕まって、大勢に長時間にわたって輪姦されちゃう。\n事後で男達は去った後、路上に力なく仰向けで横たわっているか、壁に寄り掛けられている。\nレイプ目、精液まみれ（(口内射精、中出し、ぶっかけあり）。悲惨・無残で再起不能、絶望的な感じ。\n\n引き締まった身体、胸の大きさはリアル目なサイズ。薄めの陰毛。\n裂かれたタイツがところどころ残っているのみで、あとは全裸。\n脱がされた衣服が全部でなくて良いのでその辺に転がされている。\n\n台詞、効果音、擬音等の文字はなくてよいです。\n\n希望は以上になります。\n描きづらい部分、不自然な描写になる部分あれば変えていただいて構いません。\nご検討お願い致します。\n\nhttps://imgur.com/a/UcceMG5", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sukekenokekeke/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7df64e79/uploads/origins/ff81569d-e5a7-4c04-80f7-8bcda635ba86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b80fc83b18c785ce750bb732e746a6aa", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1514355, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sukekenokekeke/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1514355, "client_id": 257349, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da07cb11/uploads/origins/71fc4fad-2415-4540-bfb6-7df6ff2f0608?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=842a5bd8b695f67814ebc953585ad02f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da07cb11/uploads/origins/71fc4fad-2415-4540-bfb6-7df6ff2f0608?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f9c0351c21c466c21c83d1d62ce2dac", "src_set": ""}, "body": "初めまして！ FE聖魔の光石に登場する「ルーテ」というキャラクターのイラストをリクエストさせて頂きます。\nクールな雰囲気をしたマイ