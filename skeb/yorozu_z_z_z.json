gins/9aa4de10-8adb-4979-85c9-98e712158732?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6bc1ce4cc2cbf5344dfa800bb61f8359 3x"}, "body": "まくらうり先生はじめまして！碧梟あきらと申します\n\n先日ツイッターでまくらうり先生のアップルパイちゃんのデザインラフを拝見し、めちゃかわ…となり、是非まくらうり先生に私の配信活動用のアバターを描いていただきたいとリクエストを送らせていただきました！\n\n外見的特徴と致しましては\n・中性的\n・左目下になきぼくろ\n・緑のメッシュ\nになります\n\n描いていただきたいイラストの雰囲気は明るくポジティブなものをお願いしたいです！\nまた、まくらうり先生のデザインとても素敵なので、もしよければ柄シャツのデザインなどしていただければ嬉しいです！\nそのままでも十二分に嬉しいので、お手数にならない範囲でご検討いただけますと幸いです。\n\n【使用用途】\n・YouTubeなど配信サイトでのサムネイル\n・ツイッターでの掲載\n・各ＳＮＳアイコン\n\n【納品について】\nPSD、もしくは人物透過と背景を分けたPNGでお願いいたします\n\n【資料】\nhttps://drive.google.com/drive/folders/1m20TSxdPBCTsUhviacKi1qw_TtpPAccA\n\n長文読んでいただきありがとうございます\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1m20TSxdPBCTsUhviacKi1qw_TtpPAccA", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yorozu_z_z_z/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3178459, "client_id": 2768848, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6116dc29/uploads/origins/111547cc-1224-4e34-9b82-c0477820ae9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6cee0f90a62ff6155d5c82622b12e32", "srcset": "https://si.imgix.net/6116dc29/uploads/origins/111547cc-1224-4e34-9b82-c0477820ae9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6cee0f90a62ff6155d5c82622b12e32, https://si.imgix.net/6116dc29/uploads/origins/111547cc-1224-4e34-9b82-c0477820ae9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=975701b0c992627933c18551920f38bd 2x, https://si.imgix.net/6116dc29/uploads/origins/111547cc-1224-4e34-9b82-c0477820ae9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41275790f4171838f9603285588940ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "http