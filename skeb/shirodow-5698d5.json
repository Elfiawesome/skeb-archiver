子を配り歩いている。糖分は大事なので。\n\n心理学に興味があるためか、他者と仲良くなるのが得意。\n困り事の手伝いを積極的にするのは、他者に入り込む為の戦略なのかもしれない。\n\n外見などは資料URLを参照ください。\n問題があれば再送/キャンセル下さって構いません。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1rRlMoPOhxXCEv7FwIrNwCQSOQX96UdGK", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 57228, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "八多", "screen_name": "hata4564", "avatar_url": "https://pbs.twimg.com/profile_images/1316342640166666240/u7AYw-Ja.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": 46, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 267661, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "東雲海松", "screen_name": "kikaku_sinonome", "avatar_url": "https://pbs.twimg.com/profile_images/1971185658673987584/G4J0ktaI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/771339799433060352/1780983669/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 1758385, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "新保高", "screen_name": "shin_hotaka", "avatar_url": "https://pbs.twimg.com/profile_images/2049512622081585153/IjH0jfc-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1204413080622387205/1643637718/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_e