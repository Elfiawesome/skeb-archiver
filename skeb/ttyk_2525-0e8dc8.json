compress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7400dd68645a91b110b8fcd21e4c3bfd", "srcset": "https://si.imgix.net/b0accd33/uploads/origins/09086ccc-8688-4378-a013-a18d37e79223?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7400dd68645a91b110b8fcd21e4c3bfd, https://si.imgix.net/b0accd33/uploads/origins/09086ccc-8688-4378-a013-a18d37e79223?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1a5230482c33a2cbcc3eeb2854970e3 2x, https://si.imgix.net/b0accd33/uploads/origins/09086ccc-8688-4378-a013-a18d37e79223?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9006f20ec05afe49f007284a0754241 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0accd33/uploads/origins/09086ccc-8688-4378-a013-a18d37e79223?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac46138318dfd0019371d004ef85953c", "srcset": "https://si.imgix.net/b0accd33/uploads/origins/09086ccc-8688-4378-a013-a18d37e79223?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac46138318dfd0019371d004ef85953c, https://si.imgix.net/b0accd33/uploads/origins/09086ccc-8688-4378-a013-a18d37e79223?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1a26209d842f856184792fc8c4ae90be 2x, https://si.imgix.net/b0accd33/uploads/origins/09086ccc-8688-4378-a013-a18d37e79223?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4be8ac417d5fe50f58ec93cb1e8214e0 3x"}, "body": "こんにちは！台湾からの個人勢VTuber、赤魑です。\n\n先生の作品の色調やタッチがとても好きです！\n私のvtuberキャラクターを先生のスタイルで描いていただきたいです。\n\n✦ キャラクター詳細\n\n    性別：中性 / 無性別\n    種族：墮神 (穢神）\n    身高：155 cm\n    髪色：黒→暗い赤\n    瞳色：金色（黒目白）\n      ‼️ 通常は顔と髪の上の目は閉じていますが、感情がはっきりしている時にだけ開けます。\n      ‼️ 身体の目は常に開いており、無意識に動き回っています。\n\n参考画像に描かれていない部分は、先生が自分の想像で補完していただいても構いません！\n\n✦ キャラクター個性\n\n静かな時は大妖怪のような神秘的な雰囲気とオーラを持つが、無口の時に限ります。\n\n人間が好きなので、よく人をからかいます。常に軽薄な態度を取り、真面目ではないような様子で話すことも好みます。\n\nしかし、本当に怒ると恐ろしい。笑顔を浮かべていても、人を震え上がらせるほど怖い。\n\n✦ 畫面呈現\n\n    構図やポーズは特定しないで、雰囲気に重点を置いたイメージですね。\n\n思いっきり描いてください！\n\nキャラクターの特徴のメモ：\n目はキャラクターにとって非常に重要な要素です。私は光を放つ目が好きです！顔の目の周りは自由に処理できます。眼球を開閉したり、形や大きさ、数を変えたり、色や線だけ残したりしても構いません。\n            \n✦ 使用用途 \n\n    OP or ED、SNS社群、ライブ配信プラットフォーム、実体商品の製作が可能です。\n\n✦ 納品希望\n\n    キャラクター部分は独立したレイヤーで描いていただけると嬉しいです。\n\nhttps://drive.google.com/drive/folders/1-MXLvyMwvw9GQ9HO7b_XnAHeXDO-LQvU", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ttyk_2525/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3037390, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f97e67c/uploads/origins/e48909a6-c532-464e-8a0d-f2d776dfe58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3aeb7c6705d4c8fe7689b6de4713172", "srcset": "https://si.imgix.net/7f97e67c/uploads/origins/e48909a6-c532-464e-8a0d-f2d776dfe58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3aeb7c6705d4c8fe7689b6de4713172, https://si.imgix.net/7f97e67c/uploads/origins/e48909a6-c532-464e-8a0d-f2d776dfe58b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c583ba86b65b2111cad486f467a5f2f 2x, https://si.imgix.net/7f97e67c/uploads/origins/e48909a6-c532-464e-8a0d-f2d776dfe58b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e9ec4d1f4a1f02877ef78cb77e6f918 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f97e67c/uploads/origins/e48909a6-c532-464e-8a0d-f2d776dfe58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ac138f3e0c1967eb2fa9d436e4f2142", "srcset": "https://si.imgix.net/7f97e67c/uploads/origins/e48909a6-c532-464e-8a0d-f2d776dfe58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&