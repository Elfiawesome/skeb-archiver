rop=top&w=200&h=200&s=08655538d716374b4ab9dedbddd23825", "srcset": "https://si.imgix.net/f0996a72/uploads/origins/e7f63d4c-26ef-41f7-b48e-ade2c4908dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08655538d716374b4ab9dedbddd23825, https://si.imgix.net/f0996a72/uploads/origins/e7f63d4c-26ef-41f7-b48e-ade2c4908dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25263c355f1e7a6908fec12c56cd270f 2x, https://si.imgix.net/f0996a72/uploads/origins/e7f63d4c-26ef-41f7-b48e-ade2c4908dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19351c86e5b7ee126b2869d9f3a8a89c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0996a72/uploads/origins/e7f63d4c-26ef-41f7-b48e-ade2c4908dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e910ce530af490e7e3a388d77bbac0f4", "srcset": "https://si.imgix.net/f0996a72/uploads/origins/e7f63d4c-26ef-41f7-b48e-ade2c4908dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e910ce530af490e7e3a388d77bbac0f4, https://si.imgix.net/f0996a72/uploads/origins/e7f63d4c-26ef-41f7-b48e-ade2c4908dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b74a1accb0ddd957fabe3dac47faf78 2x, https://si.imgix.net/f0996a72/uploads/origins/e7f63d4c-26ef-41f7-b48e-ade2c4908dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d96c4838d36e3c812d69ef70ab121d1f 3x"}, "body": "はじめまして！\nVstreamerの珠玉と申します。\n\n新着作品にてしえら様のこちら(https://skeb.jp/@4ella_art/works/2)のイラストに一目惚れし、\nきれいなお目目とさらに左上のミニキャラがとてもかわいくぜひ描いていただきたく思いリクエストいたしました！\nお忙しいところ恐れ入りますが、お受けいただければ幸いです。\nご検討よろしくお願い致します。\n\n【構図、ポーズ等】\n通常時・黒髪時、服装、髪型、ポーズの指定等ありませんのでおまかせしたいです\n可能でしたら16:9の比率だととても助かります。\n\n【使用用途】\n・収益化済みの配信、各種snsなど活動全般\n・商用利用(スタンプ、グッズ化等)\n　※不可のものがある場合はお手数おかけしますが、再送かキャンセルをしていただけますと幸いです。\n\n【お願い】\n・頭、髪、腕等イラストの端が切れていない構図\n・可能であればPSDかPNGで、\n　人物、背景、サインを分けていただけると助かります。\n\n【キャラクター詳細】\n・FPSゲームが大好きな化けフェネック\n・すべてのゲームをキーマウでプレイするキーマウプレイヤー\n・ハートのアホ毛と右耳のピアスがチャームポイント\n・イメージカラー：白・青紫\n・目の色：通常時→紫、黒髪時→赤紫\n・髪型：外はねボブ\n・髪色：通常時→白からクリーム色のグラデーション\n　　　　黒髪時→黒から赤紫のグラデーション\n・ネイル：青紫のワンカラー\n・宝物：パールとオパールのネックレス\n・食べること、キラキラしたもの、寝ることが大好き\n\nhttps://drive.google.com/drive/folders/1W4zVyPcE8K6awXGSL7OkAzniW1LetnUH?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@4ella_art/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3265776, "client_id": 3772766, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b245085/uploads/origins/d8da5aba-be3b-4a6c-923d-e9baf13bebed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c10d21c15007c5b89d66f9aed705e74", "srcset": "https://si.imgix.net/5b245085/uploads/origins/d8da5aba-be3b-4a6c-923d-e9baf13bebed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c10d21c15007c5b89d66f9aed705e74, https://si.imgix.net/5b245085/uploads/origins/d8da5aba-be3b-4a6c-923d-e9baf13bebed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=272db690fe4e4e6bb88a2db61edf205a 2x, https://si.imgix.net/5b245085/uploads/origins/d8da5aba-be3b-4a6c-923d-e9baf13bebed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=055347d9e29c86d93f3f8d8a46fd6c8b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b245085/uploads/origins/d8da5aba-be3b-4a6c-923d-e9baf13bebed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4718047ce54799d58151407509953ac", "srcset": "https://si.imgix.net/5b245085/uploads/origins/d8da5aba-be3b-4a6c-923d-e9baf13bebed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4718047ce54799d58151407509953ac, https://si.imgix.ne