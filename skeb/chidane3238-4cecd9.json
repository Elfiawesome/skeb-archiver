c9ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f49d5ae0f7b36cf55c44e8dd9fa3be3", "srcset": "https://si.imgix.net/0bb1081e/uploads/origins/6b5d5679-d9fc-45de-9ea3-4dc5a423c9ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f49d5ae0f7b36cf55c44e8dd9fa3be3, https://si.imgix.net/0bb1081e/uploads/origins/6b5d5679-d9fc-45de-9ea3-4dc5a423c9ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fe1fca058fbeba43b46c1ddbb1fe21d 2x, https://si.imgix.net/0bb1081e/uploads/origins/6b5d5679-d9fc-45de-9ea3-4dc5a423c9ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b095ef5de67bdddd90d493f0896fb4e7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0bb1081e/uploads/origins/6b5d5679-d9fc-45de-9ea3-4dc5a423c9ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fde2b3cd69f43c8293c794826b6c7413", "srcset": "https://si.imgix.net/0bb1081e/uploads/origins/6b5d5679-d9fc-45de-9ea3-4dc5a423c9ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fde2b3cd69f43c8293c794826b6c7413, https://si.imgix.net/0bb1081e/uploads/origins/6b5d5679-d9fc-45de-9ea3-4dc5a423c9ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e30bd4c1b1bc255d9c6d403406c707f 2x, https://si.imgix.net/0bb1081e/uploads/origins/6b5d5679-d9fc-45de-9ea3-4dc5a423c9ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=710f4d277e85e4dc08bfa3392126700f 3x"}, "body": "ちぐさ様\n\nこんにちは、お世話になっております。くらげのさしみと申します。\nこの度はちぐさ様に私のオリジナルキャラクターの立ち絵を描いていただきたく、リクエストを送りました。\n\n描いていただきたいキャラクターは資料の通りです。\n以下はキャラクターの簡単なプロフィールです。\n\n◇プロフィール\nノヴァ・ナスタチウム・ノート\n職業：FBI捜査官\n性別：男性\nAPP/SIZ：16/14\n常にサングラスをかけており、おどおどした態度をした青年。\n心配性だが、基本的にお人好しの善人。\n母は東洋、父はイギリスの人。\n\n時に変な閃き方をする（斜め上からの発想）が、その結論が如何に正しかろうとも余りに思考が飛躍している/過程を一つずつ説明されたとしても理解出来ない程に鋭すぎるため、もともとの陰気な性格も相まって周囲からは敬遠されていた。所謂ぼっち。\n\n「……は、初めまして。今日から此方に配属になりました、ノヴァ・N・ノートと申します。炊事、洗濯、掃除、買い出し、書類仕事…せ、先輩方の命ならなんでもやりますので、よろしくお願いします…」\n\n◇ポーズ、差分等の指定について\n特にポーズについての指定はありません。表情差分についてはちぐさ様が余裕があれば、喜怒哀楽の差分とサングラスを外した差分をいただけると嬉しいです。また、髪型やFBIジャケットの下の服装、小物等についてもちぐさ様の好きにアレンジしていただいて構いません。\n私自身立ち絵のご依頼の相場がわかっていない所があります為、この金額ですと厳しいなどありましたら全て無視していただいて大丈夫です。\n\n使用用途としましては、個人での鑑賞、そのほかTRPGのセッションでの使用を検討しています。そのため透過PNGでいただけますと大変ありがたく存じます。\nパラクラ通過時に描いていただきました絵柄が大変好きで、いつか依頼したいと考えておりました。\n\nご検討いただけますと幸いです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1nT5Su0d9W5Lcqrl2jH5q6hMHDMrz91Xg", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chidane3238/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2584943, "client_id": 3198243, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7fe08b8f/uploads/origins/aa2e0182-d403-4e88-a8a4-f66a9a59c41e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adeda232fd4b0475b1b57c41aa9cecea", "srcset": "https://si.imgix.net/7fe08b8f/uploads/origins/aa2e0182-d403-4e88-a8a4-f66a9a59c41e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adeda232fd4b0475b1b57c41aa9cecea, https://si.imgix.net/7fe08b8f/uploads/origins/aa2e0182-d403-4e88-a8a4-f66a9a59c41e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6dcb03c9305e7dd0e65c7783be73387 2x, https://si.imgix.net/7fe08b8f/uploads/origins/aa2e0182-d403-4e88-a8a4-f66a9a59c41e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6b43e7c2c2f8519a8d3cf93f628a61d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7fe08b8f/uploads/origins/aa2e0182-d403-4e88-a8a4-f66a9a59c41e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab99fbe6f779daa10bafc04c5465650c", "srcset": "https://si.imgix.