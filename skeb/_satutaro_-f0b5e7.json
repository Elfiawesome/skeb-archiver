おります。\n\n【使用用途】\nXでの投稿,アイコン使用,YouTubeでのサムネ等…\n※幅広く使用させていただきたく、背景アリの場合は背景ナシのイラストもいただけますと幸いです！\n\n\n【詳細】\n性別：なし（女性よりの見た目）\n外見：資料添付の通り\n表情・ポーズ・シーン共にお任せしたいです。\nただ、迷ってしまうようであればショッピングか、カフェでまったりなシーンを描いていただけるとありがたいです！\n\n小物類：必要に応じて持たせるなりなんなりしていただいて問題ないです。\n\n通常時の資料フォルダ\nhttps://drive.google.com/drive/folders/15XMZGm-BxzZHZLiq9udhnNyosVH2wx1G?usp=sharing\n\n新衣装ラフ格納フォルダ\nhttps://twitter.com/satutaro_bayasi/status/1619164542206111745?s=46&t=fH_Yhkz1bH9ptHHokV7edw\n\nhttps://drive.google.com/drive/folders/1yd77hAk3D36qUnCegwFnt2xBvSSutpAG?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yutta_5910/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 601194, "client_id": 1572638, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a219144e/uploads/origins/ae14ae00-dc0e-40dd-b105-72392cc9c426?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f0c03fd939d9ce1075b0602c761997c", "srcset": "https://si.imgix.net/a219144e/uploads/origins/ae14ae00-dc0e-40dd-b105-72392cc9c426?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f0c03fd939d9ce1075b0602c761997c, https://si.imgix.net/a219144e/uploads/origins/ae14ae00-dc0e-40dd-b105-72392cc9c426?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a94c8cf244f78e7f6656b457548bb130 2x, https://si.imgix.net/a219144e/uploads/origins/ae14ae00-dc0e-40dd-b105-72392cc9c426?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad0ee4dfb62f111a155f0f3f88ff63a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a219144e/uploads/origins/ae14ae00-dc0e-40dd-b105-72392cc9c426?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd1b022a2e97f5c9318b104ec162f88c", "srcset": "https://si.imgix.net/a219144e/uploads/origins/ae14a