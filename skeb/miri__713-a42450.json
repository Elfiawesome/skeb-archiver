用・非営利目的に限ります。\n掲載の際は必ずクレジット表記を行い、著作権等も尊重いたします。\nまた、可能でしたらPSD形式での納品もご対応いただけますと大変嬉しいですが、\n難しい場合は通常形式でも問題ございません。\n\nhttps://drive.google.com/drive/folders/1dzjDzI8-Xpf0lN-u8g4B5KP4od4DNPaF", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@miri__713/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3925628, "client_id": 3439041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/989a73e7/uploads/origins/0b366b20-073d-42a2-8686-223943433001?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e68124bdf4ea5fdc32fdbb8a054e52f9", "srcset": "https://si.imgix.net/989a73e7/uploads/origins/0b366b20-073d-42a2-8686-223943433001?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e68124bdf4ea5fdc32fdbb8a054e52f9, https://si.imgix.net/989a73e7/uploads/origins/0b366b20-073d-42a2-8686-223943433001?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b7f663e352cceeeca3700c6bf7cbfbb 2x, https://si.imgix.net/989a73e7/uploads/origins/0b366b20-073d-42a2-8686-223943433001?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93464aee402d3db158d772659c40cc3a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/989a73e7/uploads/origins/0b366b20-073d-42a2-8686-223943433001?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6662c7171c94b233bc55709e756f3970", "srcset": "https://si.imgix.net/989a73e7/uploads/origins/0b366b20-073d-42a2-8686-223943433001?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6662c7171c94b233bc55709e756f3970, https://si.imgix.net/989a73e7/uploads/origins/0b366b20-073d-42a2-8686-223943433001?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4fb16716eeb557f4cbd0f6d73f143c0c 2x, h