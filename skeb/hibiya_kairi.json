=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e0856e37ed24773d02f8dd4b344be1b", "src_set": ""}, "private": true, "genre": "voice", "tipped": true, "creator_id": 2907586, "client_id": 2104612, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 163, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hibiya_kairi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 2907586, "client_id": 39899, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/a56aeb74-9e72-4774-87a5-f564c015c77d?response-content-disposition=inline&Expires=1758197567&Signature=ju5UHHBdASLjpSCj7aMcXA9d0fcmiz1y3XZDUBqkqBKlwkd2OAc16VWdutOqGUR3Xm8lzrrqvMslm0SZivsSGZWSpToxqoRKz2D6EuzKl2WPaFxUk8a9B06w-F8oEu~X0YNsgU7p0mskuoetP~gCrcIgsWH6Xe3c0vRDJzTw9aRjcXvErUuOa3w9q5pV3KOLV1sFttUSzZQ~qDIkVdHWEDymo4ajk8AqWIqO2odFP807XdCzYd4VxGDjpZuBjDid69CaqhuWJvIpTVpfkAFY2-S6tzktOTu9flmgxc9B8-bL0By-egVrCvM-H~8D7Ak3-MXygd-dfvvEOKsPjmXPNw__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1960689537493164034%2F9Rw3b4PG.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34e3c08bb310ed8e55105765385cb30b", "src_set": ""}, "duration": 215, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1960689537493164034%2F9Rw3b4PG.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c93c3e96a66b4ad2d60f9acd2f80f29", "src_set": ""}, "body": "三隅　凛と申します。\n自作小説の朗読をリクエストします。\nX（ツイッター）でのリポスト、納品物のURLをツイート等以外では自己鑑賞です。\n※他の方に同内容でリクエストする可能性があります。\n\n一箇所だけ義姉の台詞がありますが、余り声を変えずに読んでいただいて大丈夫です。\n●\n　六歳年上の兄が結婚したのは二年前で、高校生だった僕はその唐突さに驚いた覚えがある。尤も兄は大学進学を機に実家を出たので、察せなかったのも無理からぬことではある。久しぶりに帰ったかと思ったら婚約者連れだった衝撃は、受験生の精神に深い混乱をもたらした。それは勿論、そこそこ仲の良かった兄が恋人を飛ばして美しい婚約者を紹介したからであるし、その美しさがこの世のものから乖離していたからでもある。\n　この世のものではない何かが溶け込んでいるんだろう、と今では思っている。溶け込んではいるけれど、彼女自体はこの世のものではあるのだ。厄介なことに。\n\n　初めての話。\n　義姉との性交を兄に命じられた時、性質の悪い冗談だと思った。少し笑った覚えがある。笑いが抜けないうちに、義姉がのしかかってきた。指が食い込まない力で肩を掴まれ、太腿に脚が触れて、それだけで身体は動かせなくなった。胸元に優しく触れる唇から、何かが吸い取られる錯覚。何とか口を開いて、声を出す。けれどそれが言葉になる前に、口の中に義姉の親指が侵入した。それを堪能しなければならないので、喋ることはもうできない。喋れたとして、何を懇願していたかは自信がないけれど。\n　熱情を装う義姉と穏やかに見守る兄に困惑できたのはごく僅かな時間だけで、身体の単純な快感を速やかに精神も受け容れた。義姉が楽しそうに笑い、すぐに反応する。従順に。膨大な快感とあり得ない興奮の他には、悪戯を教えてくれるように笑う美しいひとだけが認識できた。あとは酷くぼんやりしていた。場所も時間も、兄のことも、自分のことも。\n　早々に達しかけたのを一度巧みに焦らされたが、大して長引くことなく終わった。あっさりと離れていく義姉に脳の何処かが動いた気がしたけれど、まだ身体は動かせなかったし喋れもしなかった。ゆっくりと正常な困惑が戻ってくる。義姉は「若いねぇ」と嘘みたいに俗なことを言って笑った。世間話かテレビでも観ている時の笑い方だった。\n　こうして僕は奇妙な生活の当事者になった。そして、兄が死んでからも抜け出せていない。\n●\n　　ろくさいとしうえのあにがけっこんしたのはにねんまえで、こうこうせいだったぼくはそのとうとつさにおどろいたおぼえがある。もっともあにはだいがくしんがくをきにじっかをでたので、さっせなかったのもむりからぬことではある。ひさしぶりにかえったかとおもったらこんやくしゃづれだったしょうげきは、じゅけんせいのせいしんにふかいこんらんをもたらした。それはもちろん、そこそこなかのよかったあにがこいびとをとばしてうつくしいこんやくしゃをしょうかいしたからであるし、そのうつくしさがこのよのものからかいりしていたからでもある。\n　このよのものではないなにかがとけこんでいるんだろう、といまではおもっている。とけこんではいるけれど、かのじょじたいはこのよのものではあるのだ。やっかいなことに。\n\n　はじめてのはなし。\n　あねとのせいこうをあににめいじられたとき、たちのわるいじょうだんだとおもった。すこしわらったおぼえがある。わらいがぬけないうちに、あねがのいかかってきた。ゆびがくいこまないちからでかたをつかまれ、ふとももにあしがふれて、それだけでからだはうごかせなくなった。むなもとにやさしくふれるくちびるから、なにかがすいとられるさっかく。なんとかくちをひらいて、こえをだす。けれどそれがことばになるまえに、くちのなかにあねのおやゆびがしんにゅうした。それをたんのうしなければならないので、しゃべることはもうできない。しゃべれたとして、なにをこんがんしていたかはじしんがないけれど。\n　ねつじょうをよそおうあねとおだやかにみまもるあににこんわくできたのはごくわずかなじかんだけで、からだのたんじゅんなかいかんをすみやかにせいしんもうけいれた。あねがたのしそうにわらい、すぐはんのうする。じゅんじゅんに。ぼうだいなかいかんとありえないこうふんのほかには、いたずらをおしえてくれるようにわらううつくしいひとだけがにんしきできた。あとはひどくぼんやりしていた。ばしょもじかんも、あにのことも、じぶんのことも。\n　そうそうにたっしかけたのをいちどたくみにじらされたが、たいしてながびくことなくおわった。あっさりとはなれていくあねにのうのどこかがうごいたきがしたけれど、まだからだはうごかせなかったししゃべれもしなかった。ゆっくりとせいじょうなこんわくがもどってくる。あねは「わかいねぇ」とうそみたいにぞくなことをいってわらった。せけんばなしかてれびでもみているときのわらいかただった。\n　こうしてぼくはきみょうなせいかつのとうじしゃになった。そして、あにがしんでからもぬけだせていない。", "nc": 8, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@hibiya_kairi/works/4", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1960689537493164034%2F9Rw3b4PG.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e0856e37ed24773d02f8dd4b344be1b", "src_set": ""}, "private": true, "genre": "voice", "tipped": false, "creator_id": 2907586, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 179, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hibiya_kairi/works/3", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1960689537493164034%2F9Rw3b4PG.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e0856e37ed24773d02f8dd4b344be1b", "src_set": ""}, "private": true, "genre": "voice", "tipped": false, "creator_id": 2907586, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hibiya_kairi/works/2", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1960689537493164034%2F9Rw3b4PG.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e0856e37ed24773d02f8dd4b344be1b", "src_set": ""}, "private": true, "genre": "voice", "tipped": true, "creator_id": 2907586, "client_id": 2104612, "vtt_url": ""