gchest.com/p/9rydrbrza7k\n^ （参考画像をもっと見るには「Load more」をクリックしてください）\n髪の参考画像\nhttps://imgur.com/a/v3c4YH9\n耳の後ろにトゲのある髪があります。\n\n彼女は武術家／暗殺者＋生物兵器です。\n製薬会社に勤めています。\n巨大なモンスターに変身することができます。\nクールだけど危険なキャラクターです。\n非常に冷静で、計画的です。\n重力を操る能力とテレポート能力を持っています。\nコーヒーが大好きです。\n\n瞳の色は茶色\nバストサイズは平均的\n身長は168cm\n\n衣装や構図はお任せします。\n\n\nよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@subbaru875/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3790782, "client_id": 473292, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a8ee717/uploads/origins/8d9dd4ed-66ca-4f89-90ca-263e55840da3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe2e5a70a3b3435cf767249d251d82a3", "srcset": "https://si.imgix.net/7a8ee717/uploads/origins/8d9dd4ed-66ca-4f89-90ca-263e55840da3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe2e5a70a3b3435cf767249d251d82a3, https://si.imgix.net/7a8ee717/uploads/origins/8d9dd4ed-66ca-4f89-90ca-263e55840da3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f31186a3195816481d595e3bb9d8da76 2x, https://si.imgix.net/7a8ee717/uploads/origins/8d9dd4ed-66ca-4f89-90ca-263e55840da3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c4b0a8cd9bbcb17e6b290d140735821 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a8ee717/uploads/origins/8d9dd4ed-66ca-4f89-90ca-263e55840da3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9542b91b56d0cf5a6ebd80be606af59d", "srcset": "https://si.imgix.net/7a8ee717/uploads/origins/8d9dd4ed-66ca-4f89-90ca-263e55840da3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9542b91b56d0cf5a6ebd80be606af59d, https://si.imgix.net/7a8ee717/uploads/origins/8d9dd4ed-66ca-4f89-90ca-263e55