ff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca482dc571db2b1d677307f5317c6049 2x, https://si.imgix.net/79257fcf/uploads/origins/47822f30-58a9-47d1-84c9-fc6305431ba5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f63cfc6ea06945961477b3a4327cdc00 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/79257fcf/uploads/origins/47822f30-58a9-47d1-84c9-fc6305431ba5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=919c5b45bcffea39bc4ac7d883945294", "srcset": "https://si.imgix.net/79257fcf/uploads/origins/47822f30-58a9-47d1-84c9-fc6305431ba5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=919c5b45bcffea39bc4ac7d883945294, https://si.imgix.net/79257fcf/uploads/origins/47822f30-58a9-47d1-84c9-fc6305431ba5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e42f304fa3edd590f10dd7ba91ce3d3c 2x, https://si.imgix.net/79257fcf/uploads/origins/47822f30-58a9-47d1-84c9-fc6305431ba5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=54554bf50343886e77faaa8a411c33f4 3x"}, "body": "こんにちは\n久しぶりです\n他にも描いてほしいキャラクターがあります\n\nhttps://drive.google.com/file/d/18LRsaT3e1P9Bnb1aSfF3E_wZnRJAUS-L/view?usp=sharing\n赤い髪の爆乳貴族騎士乙女オルテ\n彼女にこんな水着を着てほしい：\nhttps://drive.google.com/file/d/1DMWDsyNFT4nmyzDquuSYti6cVEdsLgCV/view?usp=sharing\n鎧は必要ない\n手足には白い長手袋と靴下を着用する\nヘアアクセサリーを白いリボンに変更\n爆乳サイズはこの絵と同じ：\nhttps://drive.google.com/file/d/1KNrKzJRJ6vmTTBLzVgXdepHK-JMo1H5q/view?usp=sharing\n乳首は水着の下でフル勃起しているように見える\n今回も膝上までの縦長画です\nポーズはお任せ\nできれば 乳に精液が大量ぶっかける差分がもらえるとありがたい\nよろしくお願いします\n\nhttps://drive.google.com/file/d/18LRsaT3e1P9Bnb1aSfF3E_wZnRJAUS-L/view?usp=sharing", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekobineko/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 734939, "client_id": 182552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94d033ff/uploads/origins/3bf14333-cdfc-4046-9e2b-9cc749aa439e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04ad48af063eff7c6c14c5c2f1fa05eb", "srcset": "https://si.imgix.net/94d033ff/uploads/origins/3bf14333-cdfc-4046-9e2b-9cc749aa439e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04ad48af063eff7c6c14c5c2f1fa05eb, https://si.imgix.net/94d033ff/uploads/origins/3bf14333-cdfc-4046-9e2b-9cc749aa439e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=348c28e641e58aa03d547b4363dd52d7 2x, https://si.imgix.net/94d033ff/uploads/origins/3bf14333-cdfc-4046-9e2b-9cc749aa439e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a765a6d8276ab07358c847c53802d4ce 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94d033ff/uploads/origins/3bf14333-cdfc-4046-9e2b-9cc749aa439e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b37a275a159fdf75e18bc49ef144d1df", "srcset": "https://si.imgix.net/94d033ff/uploads/origins/3bf14333-cdfc-4046-9e2b-9cc749aa439e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b37a275a159fdf75e18bc49ef144d1df, https://si.imgix.net/94d033ff/uploads/origins/3bf14333-cdfc-4046-9e2b-9cc749aa439e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dc59398dede2d584b3c5c5c666358c60 2x, https://si.imgix.net/94d033ff/uploads/origins/3bf14333-cdfc-4046-9e2b-9cc749aa439e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=af84b532a874861151e5bfa71457876b 3x"}, "body": "送ったリクエストがよその子絡みだったそうなので、以下の設定のキャラで再度検討お願いします。\n\n描いて頂きたいのはスライムの重鎧を装備したスライム使いの女性です。\nこのスライムの重鎧の大きさは2m以上あり、実際には装備ではなく埋め込まれている、あるいは取り込まれているといった方がしっくりくる感じになっています。\nこの重鎧は形状や硬度を変化させる事が出来、戦闘時には両手を剣や銃等の武器に変化させて戦います。\n尚、このスライムの重鎧に色はついてますが透明ですので、中の女性の体がはっきりと見えるようになっています。\n\nスライム使いの女性については裸の格好をしており、胸元には操ってるスライムのコアが埋め込まれています。\nまた、彼女のお腹は妊婦の様に膨らんでおり、その中には他者の体内に入れることで寄生し、彼女の手駒に出来るミルク色のスライムを飼っています。(ボテ腹NGであれば普通のお腹でも構いません。)このスライムを寄生させる際は、重鎧の股間に大きなチンポ(玉有り)が生え、その尿道口から彼女のおマンコまでを繋げる細いトンネルと、その間の睾丸部分に丸い空間を形成します。そして、寄生スライムが彼女のおマンコから産み落とされ、トンネルを通じて一旦睾丸部分の空間に貯蔵された後、寄生対象に向かって重鎧のチンポから射精された精液の様に飛び出していきます。\n尚、先程説明した通り、重鎧スライムは透明である為、上述した寄生スライムが飛び出してくる過程も丸見えになっています。\n\n以上の設定を踏まえて、以下のシチュをお願いしたいです。\n①戦闘時のシーン。スライムの重鎧の片手を大剣に、もう片方をバズーカあるいはガトリングに変化させています。そして女性は「さぁどこからでもかかっていらっしゃい」と言わんばかりの不敵な笑みを浮かべながら、両手の武器を構えずにこちらへゆっくりと真正面から歩み寄ってきます。\n②スライム使いが勝利し、敗者へスライムを寄生させるシーン。上述の説明の通り、重鎧の股間からチンポが生え、ミルク色の寄生スライムをこちらへ発射します。この時のスライム使いの表情は、頬を赤らめ、美味しそうな獲物を見るような目を向けながら舌なめずりをしています。\nまた、重鎧の両手は万が一対象が逃げてもすぐ捕まえられる様、複数本の触手へと変化しています。\n\n尚、作業量的に両方は厳しいという場合は②のみで構いません。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekobineko/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 734939, "client_id": 576298, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f28bf546/uploads/origins/7ef03efa-f0e1-4935-a1d1-5ee9c40d40d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b1f884506b582f4f634dc3f3e190017", "srcset": "https://si.imgix.net/f28bf546/uploads/origins/7ef03efa-f0e1-4935-a1d1-5ee9c40d40d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b1f884506b582f4f634dc3f3e190017, https://si.imgix.net/f28bf546/uploads/origins/7ef03efa-f0e1-4935-a1d1-5ee9c40d40d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92313e008827633258e0c6b33788a017 2x, https://si.imgix.net/f28bf546/uploads/origins/7ef03efa-f0e1-4935-a1d1-5ee9c40d40d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b97173b7472c559f2af3320cf9b25467 3x"}, "duration": null, "nsfw": true, "hardcore": false