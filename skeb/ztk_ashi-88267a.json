ちょっと周りにハネているとよいが髪の毛の書き方に拘りがあれば無視してOK）\n帽子は緑色のハットタイプ。\nレインウエア（アウターは赤色）\nパンツの色はお任せ。\nザックを書き込む余裕があれば赤基調の小屋泊程度サイズでお願いいたします。\n笑顔で登山を楽しんでいるイメージで仕上げをお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ztk_ashi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 870402, "client_id": 12940, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d6d0ba0/uploads/origins/6427d360-56a6-43a0-91e2-c55a2ca60bae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=935bcc873e6de4717c189b092c773432", "srcset": "https://si.imgix.net/4d6d0ba0/uploads/origins/6427d360-56a6-43a0-91e2-c55a2ca60bae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=935bcc873e6de4717c189b092c773432, https://si.imgix.net/4d6d0ba0/uploads/origins/6427d360-56a6-43a0-91e2-c55a2ca60bae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78027f6b167ab6e78b24dbe72fd76e0e 2x, https://si.imgix.net/4d6d0ba0/uploads/origins/6427d360-56a6-43a0-91e2-c55a2ca60bae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f408a88bb5a8ef90444b6dfb270e8b0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d6d0ba0/uploads/origins/6427d360-56a6-43a0-91e2-c55a2ca60bae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4a3e280e4cd3b797e614969e9184f6e", "srcset": "https://si.imgix.net/4d6d0ba0/uploads/origins/6427d360-56a6-43a0-91e2-c55a2ca60bae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4a3e280e4cd3b797e614969e9184f6e, https://si.imgix.net/4d6d0ba0/uploads/origins/6427d360-56a6-43a0-91e2-c55a2ca60bae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5f3373f08f308467e57d7a1f1e25bc65 2x, https://si.imgix.net/4d6d0ba0/uploads/origins/6427d360-56a6-43a0-91e2-c55a2ca60bae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d828b029b7fea2bef088e7a85c706b2 3x"}, "body": "いつも楽しく拝見しています。\n最近は山の擬人化を手掛けてらっしゃるとのことなので、山の擬人化をリクエストです。\nあまり多くの山を登っているわけではありませんが、印象深いのは小学生の頃に行った立山連峰です。トロリーバスや黒部ダムなどもインパクトありましたが、朝にロッジを出発して、その時はいい天気だったのに、瞬く間に霧が濃くなり、視界が失われてしまうということがありました。慌ててロッジに引き返してやり過ごすことで事なきを得ましたが、少し判断を迷ったらどうなっていたか、山の怖さを思い知った記憶です。\n擬人化するのは立山でなくても構いません。以下のようなイメージがあれば嬉しいですが、他にアイデアがあれば自由に描いてくださればと思います。\n\n・夏らしい軽装\n・霧をイメージする衣装、小道具（羽衣のような）\n・美しく優しそうで、一方で暗く険しい気配も漂う（阿修羅のような多面、多腕で正面は優しそうだが背面で冷たい表情、背後に武器を隠し持つ、など）\n\nよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ztk_ashi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 870402, "client_id": 2126846, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e16280e/uploads/origins/f28a68f9-816c-474e-9a02-710dde6c71bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75716b6a439971a00e7a3737268205fe", "srcset": "https://si.imgix.net/5e16280e/uploads/origins/f28a68f9-816c-474e-9a02-710dde6c71bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75716b6a439971a00e7a3737268205fe, https://si.imgix.net/5e16280e/uploads/origins/f28a68f9-816c-474e-9a02-710dde6c71bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa37ac2b8fca2c25a957c737d1469220 2x, https://si.imgix.net/5e16280e/uploads/origins/f28a68f9-816c-474e-9a02-710dde6c71bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3237464fbaf2bb495aab31eef76277a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e16280e/uploads/origins/f28a68f9-816c-474e-9a02-710dde6c71bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01f5836860093540288d9