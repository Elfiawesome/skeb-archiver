21c/uploads/origins/64ec0c8b-0bec-42ff-9a5e-87e326b17fcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12542050c7018a767c26d6cedc810c53 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/244cc21c/uploads/origins/64ec0c8b-0bec-42ff-9a5e-87e326b17fcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=415b4db7c7e6290f7423d09b1f756200", "srcset": "https://si.imgix.net/244cc21c/uploads/origins/64ec0c8b-0bec-42ff-9a5e-87e326b17fcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=415b4db7c7e6290f7423d09b1f756200, https://si.imgix.net/244cc21c/uploads/origins/64ec0c8b-0bec-42ff-9a5e-87e326b17fcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23593c95255a1d0999846deded342421 2x, https://si.imgix.net/244cc21c/uploads/origins/64ec0c8b-0bec-42ff-9a5e-87e326b17fcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=720060f22cd8144e1d780b4a6706f736 3x"}, "body": "オリジナル、いらゆるうちの子をお願いします。\n\n・地下駅の入口（地上口）を背に、登山に向かうような恰好で立っている少女。\n・登山リュックを背負い、両手をショルダーハーネスに添えている。\n・リュックには登山用スコップを水平か斜めにくくりつけている。少し大きめに、正面から見ても身体からはみ出すくらいのサイズで。\n・表情はどこか不機嫌そうな仏頂面。への字口。\n・額にはゴーグル（スモーク入り）。\n・差分として、ゴーグルを装着しているバージョンもお願いします。\n\n資料ＵＲＬに他の方に描いていただいたものがありますが、もともと小説のキャラで特に詳しい外見描写をしていないので、顔も衣装も年齢も合わせる必要はなく、描きやすいように描いていただければと思います。\n実川さんが以前描かれた登山ウェアの不知火がとても素敵だったので、（サバゲ系とも迷いましたが）登山系でお願いすることにしました。\n登山と一口に言ってもトレッキングからクライミング、夏山冬山など幅広いですが、そのあたりはお任せします。\n\ntwitterのプロフィール画像やヘッダに使う場合は若干トリミングさせていただくかもしれません。\nよろしくお願いします！\n\nhttps://skeb.jp/@ele_cat_namy", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ztk_ashi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 870402, "client_id": 954322, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fb40843/reques