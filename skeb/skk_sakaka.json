ズだと嬉しいです。\n・セクシーでえちかわな雰囲気だと嬉しいです。\n・可能でしたら表情差分等がありますと嬉しいです。\n\n【納品データについて】\n・サイズは縦長で、アスペクト比3:4でお願いしたいです。(1500×2000(横×縦)等)\n・PSDデータで背景と人物をレイヤーで分けた形でいただきたいです。\n・サムネ等に使用する可能性がある都合で、人物の頭が見切れない形で描写していただけますと幸いです。\n\n--\n\nリクエスト内容と異なる部分があっても問題ございません。\n坂様の描きやすいように描いていただけると嬉しいです。\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1kQxz0GXt0X-cNU36f4gXXbYehaa7rpjY?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@skk_sakaka/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2665306, "client_id": 136697, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a41b7bc/uploads/origins/b232117a-56d3-43be-bd74-0aebf504ef30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98c899423bf0f84a805d19e8d394f1e1", "srcset": "https://si.imgix.net/7a41b7bc/uploads/origins/b232117a-56d3-43be-bd74-0aebf504ef30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98c899423bf0f84a805d19e8d394f1e1, https://si.imgix.net/7a41b7bc/uploads/origins/b232117a-56d3-43be-bd74-0aebf504ef30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=626d496bd1234b6139a4653f2555d6bb 2x, https://si.imgix.net/7a41b7bc/uploads/origins/b232117a-56d3-43be-bd74-0aebf504ef30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad0e09631e2758b4ec057093e7a17ffa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a41b7bc/uploads/origins/b232117a-56d3-43be-bd74-0aebf504ef30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=923d89397267384745f19659e53d1099", "srcset": "https://si.imgix.net/7a41b7bc/uploads/origins/b232117a-56d3-43be-bd74-0aebf504ef30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=923d89397267384745f19659e53d1099, https://si.im