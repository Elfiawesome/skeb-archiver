の補足ですが、アバターの改変に使用しているすべての素材は、VN3ライセンスにおいて二次創作が許可されているものとなります。\n\nお忙しいところ恐れ入りますが、ご検討のほどよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1ZJGJ2HmtNrO6Nzec0PriekSOreIPgmYn?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 326698, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "yaigi", "screen_name": "_yaigi", "avatar_url": "https://pbs.twimg.com/profile_images/1946180735783612416/oA1GWm-U.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1575700099/1644740427/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "banned": false, "nc": 49}, {"id": 1314046, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゆれ", "screen_name": "mr_ayarabbit", "avatar_url": "https://pbs.twimg.com/profile_images/1663553167748104194/ibT862Ug.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 35, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 2308707, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "さかなお嬢様", "screen_name": "ousakana0325", "avatar_url": "https://pbs.twimg.com/profile_images/2013207616248487936/i_Deax00.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1331204998345068544/1768821046/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 80, "skills":