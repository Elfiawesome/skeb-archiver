P95rv1bSj3f9are3miSkK_TFlaEUaWi?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RazuMiruku/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3785910, "client_id": 3340985, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ce3183a/uploads/origins/a9488d26-9561-44db-ba08-0e7cabd544bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5e7e14569705c1b827fe343fe54c14f", "srcset": "https://si.imgix.net/0ce3183a/uploads/origins/a9488d26-9561-44db-ba08-0e7cabd544bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5e7e14569705c1b827fe343fe54c14f, https://si.imgix.net/0ce3183a/uploads/origins/a9488d26-9561-44db-ba08-0e7cabd544bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7d72177b374b57f14da8066eae59eb2 2x, https://si.imgix.net/0ce3183a/uploads/origins/a9488d26-9561-44db-ba08-0e7cabd544bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1cfd9aa04c751dfb18198b095c814a68 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ce3183a/uploads/origins/a9488d26-9561-44db-ba08-0e7cabd544bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=096fb4f7b7b73c7e07a1bc222b6dac7d", "srcset": "https://si.imgix.net/0ce3183a/uploads/origins/a9488d26-9561-44db-ba08-0e7cabd544bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=096fb4f7b7b73c7e07a1bc222b6dac7d, https://si.imgix.net/0ce3183a/uploads/origins/a9488d26-9561-44db-ba08-0e7cabd544bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d4b1956d52ac2c1508eff0aee0f4e83b 2x, https://si.imgix.net/0ce3183a/uploads/origins/a9488d26-9561-44db-ba08-0e7cabd544bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0483ae82c7e6bb2f907267acc003a307 3x"}, "body": "こにちは！君のイラストのスタイルはとってもとっても可愛いです!!!!!\n特に\nhttps://x.com/RazuMiruku/status/2064282674810978804　と\nhttps://skeb.jp/@RazuMiruku/works/1\nこのVtuber、＠poka_rebornの絵を描いてくれませんか？\nポーズや構図や服もおまかせで、でも彼女のマスコットも一緒に描いてほしいです！\n一つのお願いは彼女をかわいくしてください！！！！ちょっとエロいもいいえです！\n\n彼女のデザインはこちら：\nhttps://imgur.com/a/6Fr3q1V\n\nマスコットのデザインはこちら：\nhttps://imgur.com/a/ewdzkIn\n\n大きくてふわふわの尻尾や、小さな翼を注意してください\nそして、彼女はプチとつるぺったんですから、ボインボインを描かないでください！\n\n可能であれば背景を透過したPNGがあると大変嬉しく存じます\nありがとうございます‼\n\nhttps://imgur.com/a/6Fr3q1V", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RazuMiruku/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3785910, "client_id": 3710761, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e8e2490/uploads/origins/f1b04f69-2478-4273-8b92-a3ca000a21a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46c358523113c693700ae7d5689bc6d1", "srcset": "https://si.imgix.net/4e8e2490/uploads/origins/f1b04f69-2478-4273-8b92-a3ca000a21a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46c358523113c693700ae7d5689bc6d1, https://si.imgix.net/4e8e2490/uploads/origins/f1b04f69-2478-4273-8b92-a3ca000a21a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bde91eb31b3c3e42ac571bb777464e03 2x, https://si.imgix.net/4e8e2490/uploads/origins/f1b04f69-2478-4273-8b92-a3ca000a21a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7fce95acbd0cf59c38f7a2fbd64d4c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e8e2490/uploads/origins/f1b04f69-2478-4273-8b92-a3ca000a21a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c88b84b1a2018885a93fdc66b1b8fbe", "srcset": "https://si.imgix.net/4e8e2490