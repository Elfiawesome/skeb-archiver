うございます！\n\n私のオリジナルキャラクター：\nhttps://drive.google.com/drive/folders/1ZGpZ8Z4qRInGV7YNs7C7rQXaxV1_kTZp?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1ZGpZ8Z4qRInGV7YNs7C7rQXaxV1_kTZp?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gus_uur/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3648174, "client_id": 3962261, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/39b40f98/uploads/origins/56ee5d70-405d-4969-bb08-a51279ece951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c54accf54b5b6141682f9c1a8b52595c", "srcset": "https://si.imgix.net/39b40f98/uploads/origins/56ee5d70-405d-4969-bb08-a51279ece951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c54accf54b5b6141682f9c1a8b52595c, https://si.imgix.net/39b40f98/uploads/origins/56ee5d70-405d-4969-bb08-a51279ece951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16494ca5ea80a38162d00c1f976175a1 2x, https://si.imgix.net/39b40f98/uploads/origins/56ee5d70-405d-4969-bb08-a51279ece951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae59dd51f724820179b1477c60124366 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/39b40f98/uploads/origins/56ee5d70-405d-4969-bb08-a51279ece951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c8526945a581ff2e9bff410c130277b", "srcset": "https://si.imgix.net/39b40f98/uploads/origins/56ee5d70-405d-4969-bb08-a51279ece951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c8526945a581ff2e9bff410c130277b, https://si.imgix.net/39b40f98/uploads/origins/56ee5d70-405d-4969-bb08-a51279ece951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d15adad189114981b27c