uration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c91411a8/uploads/origins/859341e8-3519-418a-b659-0de21c0a60e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3c26757da98785d30db8621fd73a283", "srcset": "https://si.imgix.net/c91411a8/uploads/origins/859341e8-3519-418a-b659-0de21c0a60e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3c26757da98785d30db8621fd73a283, https://si.imgix.net/c91411a8/uploads/origins/859341e8-3519-418a-b659-0de21c0a60e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5b3ace36d76ebc5b3e8c7643ddafe005 2x, https://si.imgix.net/c91411a8/uploads/origins/859341e8-3519-418a-b659-0de21c0a60e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f9e3b5896c89da7f251dc9180efcefff 3x"}, "body": "こんにちは！  あなたの作品が大好きです！  マジョラの仮面のヤングリンクをモチーフに、ホラーをテーマにした依頼をお願いしたいです。  スタルチルドレンの手が地面から上がってきて、ヤングリンクに掴みかかったり、フロアマスターがヤングリンクを掴んで押さえつけたりしてほしいです。  できれば、フロアマスターの一人が彼の首をつかんでいてほしいです。  最後に、リデッドが背中に乗って、ゲーム中のように攻撃してほしい。  ヤングリンクのホラー／ゲームオーバーのシナリオになるようなアイデアなので、その数の多さに圧倒され、もがき、絶望しているような表情にしたい。  また、モンスターとの戦いで少し怪我をしているような表情も希望します。  背景は、このシナリオに一番合うと思われるものであれば何でも構いません。  依頼を検討していただき、本当にありがとうございました！\n\n参考文献\n\nhttps://zelda.fandom.com/wiki/Floormaster\nhttps://zelda.fandom.com/wiki/ReDead\nhttps://zelda.fandom.com/wiki/Stalchild\n\nhttps://zelda.fandom.com/wiki/Young_Link", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 373801, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "郊外", "screen_name": "verdure", "avatar_url": "https://pbs.twimg.com/profile_images/1606995420823322624/uvwoppBA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1045865100895125504/1538191167/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": nul