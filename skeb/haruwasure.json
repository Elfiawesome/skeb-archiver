als_count": 0, "received_works": [{"path": "/@haruwasure/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3407839, "client_id": 3563094, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09dd974b/uploads/origins/6b82065d-84b1-4389-8945-1c1f2f261a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40a264516d5ed8a090bef1aa0ac9cebb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09dd974b/uploads/origins/6b82065d-84b1-4389-8945-1c1f2f261a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=220d11093a43dceb6c0b88f8e48972bf", "src_set": ""}, "body": "はじめまして。 \nYouTubeにて活動しておりますVTuberの六花氷雨と申します。 \n はるわすれ様のイラストを拝見し、是非お願いしたくリクエスト送らせていただきました。\n  skeb依頼がまだ不慣れなため至らない点がありましたら申し訳ありません。\n\nはるわすれ様のしゃぼん玉のイラストの雰囲気が大変好きでして、あのような世界観のイラストを私、六花氷雨にて描いて頂けたらと思っております。\n\nまた可能でしたら背景透過済のものも頂けると幸いです。\n\n◎キャラクター詳細\n性別:女性\n性格:和風大好きな和装ユキヒョウ,楽しむがモットーののんびりまったり屋\n       \n◎使用用途\nXでの広告活動(おはぶいやアイコンヘッダー等)\nYouTube動画でのサムネ\nグッズ化(ネップリやデジタル,リアルグッズ)\n\nXリンク:https://x.com/freezing_rain_?s=21&t=1T5WLV7zrBpA8kmQOjAO9Q\n\nhttps://drive.google.com/drive/folders/1ue2DX30yJsAChbb6BM-bmh27JGwxTH1u", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haruwasure/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3407839, "client_id": 3660940, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03d95c6d/uploads/origins/8166b20a-ac18-47c8-9703-346e98438f88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df64e23c91d53c78e5f6127ab6fdd1a4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03d95c6d/uploads/origins/8166b20a-ac18-47c8-9703-346e98438f88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e778f818e0884899f98b4d40e911f83", "src_set": ""}, "body": "はるわすれ様\n\nはじめまして、個人勢VTuberの春夏秋冬めぐると申します。\nbooth「春を待つ店」大好きです。\nどの背景も世界観がとてもあたたかで、商品出される度に刺さってます。特に縁側の動く配信背景の紫陽花が好きで、雑談配信にて使用しております。素敵なお部屋を販売していただきありがとうございます！\n\n今回skeb募集されてるとのことで、ぜひ私春夏秋冬めぐるも描いていただきたくリクエスト送らせていただきました。\n\n・『春夏秋冬めぐる(春・夏衣装)』を描いていただきたいです。下記にあります資料URLから立ち絵をご確認ください。性格や世界観について記載した物も添付いたしますので参考になりますと幸いです。\n\n・キャンバスサイズや構図、表情はお任せいたします。\n\n・ファイル形式は背景がある場合のみ、人物レイヤーと分けたPSD形式だと大変助かります。\n\n使用用途はXや、YouTube・ツイキャス・IRIAM等の配信サムネイルとして利用したいと考えております。\n金額が見合わない場合お手数ですが再送をしていただけますと幸いです。ご検討の程よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-t2r1Nw6hAsDYQrFdW6spv-wbW66JP5-", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haruwasure/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/afd935f4/uploads/origins/6bffbf49-31c6-4724-847d-b4c6972f2a29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0555329c2880c0164b0d31694b5ffebf", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3407839, "client_id": 2376694, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 1184415, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あざらし太郎", "screen_name": "azatarou_h", "avatar_url": "https://pbs.twimg.com/profile_images/1717793820426039296/g5TWM8Ph.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1278682253166391299/1651937046/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_e