=top&w=200&h=200&blur=200&s=c306a8d7522d587c63d1b6b77c68285d", "srcset": "https://si.imgix.net/89bc0037/uploads/origins/3f0aca4c-b01f-464a-9db6-63fb0d1f07e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c306a8d7522d587c63d1b6b77c68285d, https://si.imgix.net/89bc0037/uploads/origins/3f0aca4c-b01f-464a-9db6-63fb0d1f07e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd17dd91582f6af98e06487dd093f938 2x, https://si.imgix.net/89bc0037/uploads/origins/3f0aca4c-b01f-464a-9db6-63fb0d1f07e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=120f6519c76ced2a38b4d464988d3b81 3x"}, "body": "以前、逮捕された水無月風子のイラストを依頼させていただいた者です。\nそのイラストの続きを描いていただきたくリクエストします。\nシチュエーション：独房のベッド上で起きたらおむつにおねしょしていることに気づいてしまったところ\n服装：裸におむつ一枚（パンツタイプ/柄はお任せします）、腰縄は外されたが手錠はかけられたまま\n仰向けで寝ていて、防犯上の理由で布団は与えられていない\n表情：恥ずかしがっていて泣きそう\nでお願いいたします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikeno_kurume/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1734999, "client_id": 3829923, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5c371ac/uploads/origins/b2dc6b2c-4771-4d8e-84b7-8ece73b98858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=545abb7c9cee4fcd991133e4da4e4090", "srcset": "https://si.imgix.net/d5c371ac/uploads/origins/b2dc6b2c-4771-4d8e-84b7-8ece73b98858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=545abb7c9cee4fcd991133e4da4e4090, https://si.imgix.net/d5c371ac/uploads/origins/b2dc6b2c-4771-4d8e-84b7-8ece73b98858?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3af8e12d5e4e1e895e00fd0c5af80ad 2x, https://si.imgix.net/d5c371ac/uploads/origins/b2dc6b2c-4771-4d8e-84b7-8ece73b98858?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=925324396eb0e0b9f6eb0bf0a58baf64 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5c371ac/uploads/origins/b2dc6b2c-4771-4d8e-84b7-8ece73b98858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c910ac961a1507b65f423f369db33e29", "srcset": "https://si.imgix.net/d5c371ac/uploads/origins/b2dc6b2c-4771-4d8e-84b7-8ece73b98858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c910ac961a1507b65f423f369db33e29, https://si.imgix.net/d5c371ac/uploads/origins/b2dc6b2c-4771-4d8e-84b7-8ece73b98858?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dea567ce1165f56e5b147c7aa63bae05 2x, https://si.imgix.net/d5c371ac/uploads/origins/b2dc6b2c-4771-4d8e-84b7-8ece73b98858?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=79a4708bb5a4bca916eb22cf5629eee0 3x"}, "body": "擬人化されたおむつとおむつに座るという設定はそのままに、視点はほぼそのままです。キャラクターと服装は統一していますが、私が提供した写真にあるおむつの型紙を使用してください。使用者の尿が上から流れ落ち（これは前作の作画段階では描かれていましたが、完成版には反映されていません）、彼女の体と髪を濡らしています。擬人化されたおむつ少女が限界以上の尿を吸収する（彼女自身のおむつからも尿が漏れている）。彼女は使用者と向き合い、絶望の涙を目に浮かべ、頬はわずかに紅潮し、ふっと息を吐く（漏れた後の無力感）。座り姿勢（足の動きも含む）や体の姿勢は、「ねぇ、ワタシもそろそろ出していい…？もう限界なんだけど」の登場人物の姿勢をベースにしています。彼女の足は広げられ、おむつが漏れているのが見えました。手の動きは本作の「おむつおもしに興奮しちゃうお哥さん、よわ～～～～い♡」を参考にしており、おむつの上部を握ったり掴んだり、おしっこを絞り出したりする様子が描かれています。彼女はもう一方の手を股間の前の地面に置き、尿が漏れるのを防ごうとした（しかし明らかに失敗した）。彼女が座っていたおむつは吸収力の限界を超えており、新しい尿は吸収できずおむつを通り抜け、両側から漏れ出ていた。おむつの妖精は、尿で満たされたおむつの中にいて、水に浸かったおむつの芯に少し沈んでいた。前回の続きで、装着者は我慢できなくなり、排尿を始めました。インターフェースと計測設定はそのままで、尿量メーターは徐々に減っていきますが、おむつメーターは完全に溢れて破裂します。キャラクターのセリフは自由に設定できますので、おむつ妖精が、自分の限界を超えても飼い主の尿漏れを必死に止めようとする、哀れな姿を表現してみてください。よろしくお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikeno_kurume/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1734999, "client_id": 3840884, "vtt_url": null, "thumbnail_image_