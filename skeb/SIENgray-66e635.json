nニュアンスや前後を士郎ちゃんらしく変更してもらって大丈夫です。らしさを軸に考えていただければと思います。\n･シチュエーション\n体は正面から向き合っており、片方の手は机に肘をつき頬杖をついた状態のイメージですが、士郎ちゃんのイメージに合わなければ変更してもらって構いません。\n（可能であればもう片方の手は対面している人間の手に対して何かアクションをとっていたら嬉しいです。）\n表情などに関してはおまかせします。\n士郎ちゃんが自分を好いている人間に対してどのような対応をするのか気になります。何卒よろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@2021MiniMini/works/33", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1929504, "client_id": 3388026, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d575760/uploads/origins/76d726b8-98c3-48d0-9123-c10dfca84e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc822d11e584442d01e1b41bece425b7", "srcset": "https://si.imgix.net/3d575760/uploads/origins/76d726b8-98c3-48d0-9123-c10dfca84e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc822d11e584442d01e1b41bece425b7, https://si.imgix.net/3d575760/uploads/origins/76d726b8-98c3-48d0-9123-c10dfca84e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8788e7303565fb0abcde428bb9446ff3 2x, https://si.imgix.net/3d575760/uploads/origins/76d726b8-98c3-48d0-9123-c10dfca84e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f77ba1b4f18d9a52dee62a655350818e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d575760/uploads/origins/76d726b8-98c3-48d0-9123-c10dfca84e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=136d8dd6856a5afb13a701d625aa74db", "srcset": "https://si.imgix.net/3d575760/uploads/origins/76d726b8-98c3-48d0-9123-c10dfca84e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=136d8dd6856a5afb13a701d625aa74db, https://si.imgix.net/3d575760/uploads/origins/76d726b8-98c3-48d0-9123-c10dfca84e5f?bg=%23fff&auto=format%2Ccompres