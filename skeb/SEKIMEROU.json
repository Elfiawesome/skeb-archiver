=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c79723d590455ff459ec2629b6eacea5", "srcset": "https://si.imgix.net/40c2b27c/uploads/origins/66190bf1-bc08-4b7f-b69d-6c25575a7d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c79723d590455ff459ec2629b6eacea5, https://si.imgix.net/40c2b27c/uploads/origins/66190bf1-bc08-4b7f-b69d-6c25575a7d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de98fd0289909d549e4a2291cf9664b7 2x, https://si.imgix.net/40c2b27c/uploads/origins/66190bf1-bc08-4b7f-b69d-6c25575a7d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1ed628ba8705e179fce7755ba17666c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40c2b27c/uploads/origins/66190bf1-bc08-4b7f-b69d-6c25575a7d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a88cd6ef623341fc88dbb4bb9421b4a", "srcset": "https://si.imgix.net/40c2b27c/uploads/origins/66190bf1-bc08-4b7f-b69d-6c25575a7d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a88cd6ef623341fc88dbb4bb9421b4a, https://si.imgix.net/40c2b27c/uploads/origins/66190bf1-bc08-4b7f-b69d-6c25575a7d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=affb2c59a343abadc0ce2b90d3abd37a 2x, https://si.imgix.net/40c2b27c/uploads/origins/66190bf1-bc08-4b7f-b69d-6c25575a7d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f9ee5e1fb4d3742b080a1381caa574d3 3x"}, "body": "こんにちは。\nオリジナルキャラクターの衣装デザインのご依頼をさせていただきたいです。\nキャラクターは大きな尻尾を持つ、四つ耳の狐で、寡黙で少し冷たい性格です。\n\n今回は冒険者風の衣装デザインをお願いしたく、以下の点をご希望としてお伝えいたします：\n\n手袋や靴がある場合は、指先やつま先が少し見えるようなデザインにしていただけると嬉しいです（完全に覆われないように）。\n\nマントはあってもなくても構いません。\n\nズボンがある場合は、ショートパンツのような形でお願いしたいです。\n\n武器は必須ではありませんが、デザインに合うと感じた場合は入れていただいても構いません。\n\n全身タイツやピタッとした服装は避けていただきたいです。\n\n衣装デザインとして、前面と背面の両方のビューをお願いできれば幸いです。\n\nキャラクターの**腕や太ももにある模様（毛の模様）については、衣装で隠れても構いませんが、模様の位置（左右や場所）を正しく反映していただけると助かります。\n\nまた、参考としてお渡しするリンクの衣装をインスピレーションとして使っていただくのは大歓迎ですが、全く同じにはしないでいただけると嬉しいです。\n\n上記以外の部分は、自由にデザインしていただいて大丈夫です。\n\n（可能であれば、衣装デザインとは別にシンプルな全身イラストも描いていただけたら嬉しいですが、任意で構いません。）\n\nhttps://drive.google.com/drive/folders/1gFwUUZro6Unewt9U414hikRVfaHqFLX1?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1067148, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ほがら", "screen_name": "hogara_18", "avatar_url": "https://pbs.twimg.com/profile_images/1186568091590742016/7Pcf8xdI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1186550989291057158/1726721421/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "nc": 33}, {"id": 1198592, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ウロトリ/urotori🪶", "screen_name": "urotori", "avatar_url": "https://pbs.twimg.com/profile_images/2013267331296739328/7mK7WSTE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/115065960/1762261338/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 160}, {"id": 1447248, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Ⴛ̅̀ƒ ̵̲ƕƱﾟ🍩", "screen_name": "cx_oa2", "avatar_url": "https://pbs.twimg.com/profile_images/1897179199104040960/TBvDqM5d.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1313131847644184577/1670759244/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank