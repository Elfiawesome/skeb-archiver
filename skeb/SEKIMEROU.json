lse, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@SEKIMEROU/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3563747, "client_id": 224010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a8a729c/uploads/origins/1b27ad25-f2d6-45f9-bc44-df282712c91c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a0d037dbc6d3d4d019fce657cf09875", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a8a729c/uploads/origins/1b27ad25-f2d6-45f9-bc44-df282712c91c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e718da7a45c6e5c22df811ea8065a9a7", "src_set": ""}, "body": "No topic, please free to draw it.\n\nhttps://drive.google.com/file/d/1UiLPFhP5ek8a1UnPn68FJwN-WOpu_9DM/view?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SEKIMEROU/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3563747, "client_id": 796055, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40c2b27c/uploads/origins/66190bf1-bc08-4b7f-b69d-6c25575a7d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c79723d590455ff459ec2629b6eacea5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40c2b27c/uploads/origins/66190bf1-bc08-4b7f-b69d-6c25575a7d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a88cd6ef623341fc88dbb4bb9421b4a", "src_set": ""}, "body": "こんにちは。\nオリジナルキャラクターの衣装デザインのご依頼をさせていただきたいです。\nキャラクターは大きな尻尾を持つ、四つ耳の狐で、寡黙で少し冷たい性格です。\n\n今回は冒険者風の衣装デザインをお願いしたく、以下の点をご希望としてお伝えいたします：\n\n手袋や靴がある場合は、指先やつま先が少し見えるようなデザインにしていただけると嬉しいです（完全に覆われないように）。\n\nマントはあってもなくても構いません。\n\nズボンがある場合は、ショートパンツのような形でお願いしたいです。\n\n武器は必須ではありませんが、デザインに合うと感じた場合は入れていただいても構いません。\n\n全身タイツやピタッとした服装は避けていただきたいです。\n\n衣装デザインとして、前面と背面の両方のビューをお願いできれば幸いです。\n\nキャラクターの**腕や太ももにある模様（毛の模様）については、衣装で隠れても構いませんが、模様の位置（左右や場所）を正しく反映していただけると助かります。\n\nまた、参考としてお渡しするリンクの衣装をインスピレーションとして使っていただくのは大歓迎ですが、全く同じにはしないでいただけると嬉しいです。\n\n上記以外の部分は、自由にデザインしていただいて大丈夫です。\n\n（可能であれば、衣装デザインとは別にシンプルな全身イラストも描いていただけたら嬉しいですが、任意で構いません。）\n\nhttps://drive.google.com/drive/folders/1gFwUUZro6Unewt9U414hikRVfaHqFLX1?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 1436439, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "橘霞飛", "screen_name": "Kiriko_xx0023", "avatar_url": "https://pbs.twimg.com/profile_images/1864308241846644736/N9o2y3To.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4824792625/1647528213/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "skills": [{"genre": "art"}], "nc": 145}, {"id": 2478852, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "次郎◆K-07", "screen_name": "batten12_ik", "avatar_url": "https://pbs.twimg.com/profile_images/1835372883218223104/PvzCmfrv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/970605890729533440/1752740594/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2634511, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぴ", "screen_name": "pchandayo_", "avatar_url": "https://pbs.twimg.com/profile_images/1734525854007582720/PgjMa983.jpg", "header_url": "https://pbs.twimg.com