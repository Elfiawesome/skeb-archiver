わけではない）タイプの女の子です。アイドル好きのミーハーな雰囲気もあり、いろいろな意味であぶなっかしく、明るく無邪気で元気な女の子です。\n\n◆その他補足\n資料にお洋服画像を入れていますが、あくまで方向性としてこういうニュアンス……という意図ですので、基本的には描きやすい構図などに合わせていただいて問題ありません。\n\n\n◆使用用途\nSNSのアイコン、SNSのヘッダー、個人鑑賞、SNSにてクレジットをつけ描いていただいたことを記載してのツイート\n\nAが当方の創作キャラクター、Bが別の方の創作キャラクターとなります。（許可はいただいています）もし描いていただけましたら、Bの中の方にもお送りさせてもらえたら幸いです。\n\nhttps://dl.easyuploader.cloud/20220104162108_46576d69.png", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wowramen/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1342346, "client_id": 1673652, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16ff3701/uploads/origins/227a95b5-6724-4bc0-b79b-46fe9d04b8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82913b6d12ca1ec97a22903302849e98", "srcset": "https://si.imgix.net/16ff3701/uploads/origins/227a95b5-6724-4bc0-b79b-46fe9d04b8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82913b6d12ca1ec97a22903302849e98, https://si.imgix.net/16ff3701/uploads/origins/227a95b5-6724-4bc0-b79b-46fe9d04b8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac5426ff7436a58354bc65d5cbd07f36 2x, https://si.imgix.net/16ff3701/uploads/origins/227a95b5-6724-4bc0-b79b-46fe9d04b8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=019aa095e8320219275baae4a246a023 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/16ff3701/uploads/origins/227a95b5-6724-4bc0-b79b-46fe9d04b8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35431a2aee50916f42ace86c7b238470", "srcset": "https://si.imgix.net/16ff3701/uploads/origins/227a95b5-6724-4bc0-b79b-46fe9d04b8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35431a2aee50916f42ace86c7b238470, https://si.imgix.