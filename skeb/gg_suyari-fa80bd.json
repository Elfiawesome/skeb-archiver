096e78f283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c6a65ed0225cf8bda42aab991b300e0 2x, https://si.imgix.net/360be057/uploads/origins/f0a5dc55-8cf8-41a7-a13a-96096e78f283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ebcc53b9fc7a88a43be9e409418d0f0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/360be057/uploads/origins/f0a5dc55-8cf8-41a7-a13a-96096e78f283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=724f959e27a5fddb3c8daf56c03b8a71", "srcset": "https://si.imgix.net/360be057/uploads/origins/f0a5dc55-8cf8-41a7-a13a-96096e78f283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=724f959e27a5fddb3c8daf56c03b8a71, https://si.imgix.net/360be057/uploads/origins/f0a5dc55-8cf8-41a7-a13a-96096e78f283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b3058eed3865c0cfe8bd3c2c3b96c259 2x, https://si.imgix.net/360be057/uploads/origins/f0a5dc55-8cf8-41a7-a13a-96096e78f283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b05a24c5eceb946ffbd3fd31b1c8465 3x"}, "body": "はじめまして、昔からチドリさんの描かれるイラストが大好きで、いつか依頼したいと思っておりました…！\nこの度はTRPGで使用した創作キャラクター(うちよそ)を描いて頂きたくご依頼させて頂きました。\n\n以下に概要を記載いたしますので、ご検討頂けますと幸いです。\n\n＿＿＿＿\n\n▼キャラクター資料\n資料の他に、簡単な設定も記載しますので参考にしていただければ幸いです…！\n\n名前：Theo・Armster（テオ・アルムスター）\n俺/エミリアのことは呼び捨て\n仕事に真面目でいつもキリキリしている男。\n神経質というわけではなく、生き急いでいる印象。\n頭脳派ではあるが何事も殴った方が早いと思っているので、面倒になるとその辺の物で殴打しに行く（？）\nエミリアに力で敵わず振り回されがち。\nカラーコード　#007199\n\n名前：Emilia(エミリア)\nあたし/テオのことは「テオくん」呼び\n一見普通の少女だが200年以上生きている吸血鬼。\n長生きしすぎて暇になってしまったため、常に楽しいことを探し求めながら生きている。\n好物のひとつが血であり、ことあるごとにテオ(の血)を狙っている。(襲えなかった時は渋々トマトジュースを飲んでいます)\nカラーコード　#D16797\n\n二人の関係性はカップルではなくバディになります！\n互いに相手を異性として見ている感じでは無く、雑に扱い合うような仲です(?)\n\n\n▼使用用途\n鑑賞用、個人で楽しむ範囲で使用させていただきます。\nスマホのロック画面やPCのデスクトップ背景に使用する可能性が高いため、横長の場合は画面の両端にキャラクターが来るような構図は避けて頂けるとありがたいです…！！\nまたうちよそ相手の方に共有させて頂くつもりでおります…！\n\n▼その他\n構図やシチュエーションの指定はございませんので、自由に描いて頂けたらと思います…！\n衣装が複雑で不明な点等ありましたらチドリさんの解釈で描いていただけますと幸いです！\n\n＿＿＿\n\n以上になります。依頼に不慣れなため、不備がございましたら適宜再送要請して頂けますと幸いです。\nご縁がありましたら何卒よろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1NQNybgRehjatUgN37Hj2-BFrGG0QzDga", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gg_suyari/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2423617, "client_id": 1739623, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/39ed9332/uploads/origins/06e93b79-ebf0-4501-b3fa-606d076203fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d1193bf5678a880e0b0912268e9c60b", "srcset": "https://si.imgix.net/39ed9332/uploads/origins/06e93b79-ebf0-4501-b3fa-606d076203fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d1193bf5678a880e0b0912268e9c60b, https://si.imgix.net/39ed9332/uploads/origins/06e93b79-ebf0-4501-b3fa-606d076203fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65034f90a24c772741cca6eae8ebe3f2 2x, https://si.imgix.net/39ed9332/uploads/origins/06e93b79-ebf0-4501-b3fa-606d076203fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=934d521b5fd42763c0161b091e1ceb01 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/39ed9332/uploads/origins/06e93b79-ebf0-4501-b3fa-606d076203fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa2a08ccd36a513e5e7cc126ace3e879", "srcset": "https://si.imgix.net/39ed9332/uploads/origins/06e93b79-ebf0-4501-b3fa-606d076203fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa2a08ccd36a513e5e7cc126ace3e879, https://si.imgix.net/39ed9332/uploads/origins/06e93b79-ebf0-4501-b3fa-606d076203fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=437a8c073153599cd3fe3c665e92063b 2x, https://si.imgix.net/39ed9332/uploads/origins/06e93b79-ebf0-4501-b3fa-606d076203fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f62e8d6e9274d0555ed54a7a8ef55dde 3x"}, "body": "初めまして、チドリ様の繊細な線や、美しくもはっきりとした色使いが大好きです！私の創作CPのイラストをお願いしてもよろしいでしょうか？\n\n  ■世界観 \n架空の大正時代で、悪魔を祓う祓魔師達の物語。  \n\n① \n名前:九喰迅 \n年齢43歳 \n身長:185cm \n性格:強面で厳格、義理人情に厚い、堅物で真面目だが若干天然、包容力がある落ち着いた大人の男性 \n\n② \n名前:七伏闇吾 \n年齢:27歳 \n身長:173cm \n性格:偏屈な皮肉屋で人嫌い、高圧的でプライドが高く人を見下しがち、理論的で頭脳明晰、自他共に厳しい\n\n■CP設定 \n迅は闇吾の暗殺が横行する殺伐とした家庭環境を心配し、彼が幼い頃から世話を焼いてきた。 部屋に引き篭もりがちな闇吾を迅は外に連れ出して自然の美しさや些細な季節の変化を教えた。\n 闇吾は幼い頃に迅から貰った金平糖、彼から教えてもらった囲碁や将棋、夜に連れ出して見せてくれた星空がお気に入り。\n闇吾は普段は迅に対して素直ではないが、幼い頃に世話を焼いてくれた恩を感じており、一緒にいて唯一安心できる特別な人。互いに想い合っているが、闇吾は情に疎く、迅への気持ちをよく分かっておらず、迅は幼い頃から大切に見守ってきた闇吾への気持ちを認めてはいけないという思いからなかなか恋人関係には発展しない。\n\n闇吾が幼い頃の2人の思い出（頭なでなでや抱っこ、一緒に自然や季節を満喫しているところなど…）か、大人な2人の距離感が近い感じのどちらかを描いて頂けると嬉しいです…！\n服装や構図、描写範囲などは全てお任せ致します。\nご検討の程よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1-2jIZuE3B5awWtKgu7gttngD6GPSTsDk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gg_suyari/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2423617, "client_id": 2444155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a287474/uploads/origins/8dd1ea32-9fe5-4438-9d8d-a6e5f5b131b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9de99d302380185fcfc79045b5668f86", "srcset": "https://si.imgix.net/9a287474/uploads/origins/8dd1ea32-9fe5-4438-9d8d-a6e5f5b131b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9de99d302380185fcfc79045b5668f86, https://si.imgix.net/9a287474/uploads/origins/8dd1ea32-9fe5-4438-9d8d-a6e5f5b131b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c03fc7021077f957bc5ffcf987b1b77d 2