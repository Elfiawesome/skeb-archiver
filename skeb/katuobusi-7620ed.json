ium\n\nまたは参照URLのツリー先など\n\nhttps://twitter.com/kourgun/status/1228972172938375168?s=21", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@katuobusi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3028458, "client_id": 3053829, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b3b91d7/uploads/origins/4b702bdd-1a14-4463-995f-51910609cbc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a3f02fdda5523d6e2e438123ad1fe6a", "srcset": "https://si.imgix.net/9b3b91d7/uploads/origins/4b702bdd-1a14-4463-995f-51910609cbc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a3f02fdda5523d6e2e438123ad1fe6a, https://si.imgix.net/9b3b91d7/uploads/origins/4b702bdd-1a14-4463-995f-51910609cbc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=308c898a94658f583a1598ca55b36d30 2x, https://si.imgix.net/9b3b91d7/uploads/origins/4b702bdd-1a14-4463-995f-51910609cbc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40f1f27dad6646cb50950b110d0f6a58 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b3b91d7/uploads/origins/4b702bdd-1a14-4463-995f-51910609cbc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67b3296921cf21c3e80535ebf942ce54", "srcset": "https://si.imgix.net/9b3b91d7/uploads/origins/4b702bdd-1a14-4463-995f-51910609cbc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67b3296921cf21c3e80535ebf942ce54, https://si.imgix.net/9b3b91d7/uploads/origins/4b702bdd-1a14-4463-995f-51910609cbc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ab0d129711072b45e778e11ee3b50b2 2x, https://si.imgix.net/9b3b91d7/uploads/origins/4b702bdd-1a14-4463-995f-51910609cbc9?bg=%23fff&auto=for