\n\n\n設定　能力\nめぇは人々の記憶に住み着く妖精や悪魔のようなもので\n体の縁が淡く発光しており、普段は浮遊しています\n桃、アルコール、ミルク、干した布団　等に近しい\n相手の警戒を解くような薄甘い香りを纏ってます\n\n抱き着いたりして肌に触れ続けた相手に眠気を植えつけて夢を見せ\n夢に干渉して自分の情報を滑り込ませることで存在を保ちます\n分泌される体液や血液は練乳やミルクのようで、\n飲ませた相手を強壮し、軽い依存性をもちます\n\nhttps://www.pixiv.net/artworks/70796264", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ginjiroXX/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4038525, "client_id": 3163399, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7bb13222/uploads/origins/11244f51-5ca6-4069-8b1d-2edc471ed317?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a10abd5512932a3376c6aff78af55b76", "srcset": "https://si.imgix.net/7bb13222/uploads/origins/11244f51-5ca6-4069-8b1d-2edc471ed317?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a10abd5512932a3376c6aff78af55b76, https://si.imgix.net/7bb13222/uploads/origins/11244f51-5ca6-4069-8b1d-2edc471ed317?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c1149a643fb7cb52924a930294ed813 2x, https://si.imgix.net/7bb13222/uploads/origins/11244f51-5ca6-4069-8b1d-2edc471ed317?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0653c0247939416dfcc19daa18f1626 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7bb13222/uploads/origins/11244f51-5ca6-4069-8b1d-2edc471ed317?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=174aaf2b49c7bb82c3ced2074fd72709", "srcset": "https://si.imgix.net/7bb13222/uploads/origins/11244f51-5ca6-4069-8b1d-2edc471ed317?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=174aaf2b49c7bb82c3ced2074fd72709, https://si.imgix.net/7bb13222/uploads/origins/11244f51-5ca6-4069-8b1d-2edc471ed317?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=