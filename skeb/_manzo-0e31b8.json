ロング丈スカートに黒タイツです。\n二人の関係性は付き合っているのですが、女性の方が押し気味で、男性の方は嬉しいのですが緊張しがちな感じです。\n男性側の女装は趣味でなく任務の関係で普段からしているので女装自体に抵抗や照れはありません。\n長文申し訳ありません。\nぜひ引き受けて頂けましたら大変嬉しく思います。\nどうぞよろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 6872, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ミヤスリサ❄️", "screen_name": "Risaly_", "avatar_url": "https://pbs.twimg.com/profile_images/1817512578664583169/LQwQEKHY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/113008360/1704185592/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 8434, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "お茶(薄め)", "screen_name": "greenvodka02", "avatar_url": "https://pbs.twimg.com/profile_images/1759880162643181568/PLEojLhG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/980088027698511873/1708423103/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 160}, {"id": 309908, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "クスノキ", "screen_name": "kusunotaiboku", "avatar_url": "https://pbs.twimg.com/profile_images/1418818847394652161/gHFf7TGF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2742938677/1627108324/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete