auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21d7cd418f7d2e51638610122075cb47", "srcset": "https://si.imgix.net/b242bc8a/uploads/origins/b2d26cfb-fd02-4f21-8007-1a425d9bb17e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21d7cd418f7d2e51638610122075cb47, https://si.imgix.net/b242bc8a/uploads/origins/b2d26cfb-fd02-4f21-8007-1a425d9bb17e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0265d5a82afff289f18cb189a26ed543 2x, https://si.imgix.net/b242bc8a/uploads/origins/b2d26cfb-fd02-4f21-8007-1a425d9bb17e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b92a2d6cc291ab87511176ed10c951df 3x"}, "body": "茨さんこんにちは。\n6年前、Twitterで『どうかお達者で』を拝見してからというもの、こちらの作品が本当に大好きで、今も毎日のように拝見しています。\n\nそんな茨さんがSkebを開かれたということで、どんな内容でお願いさせていただくか非常に迷ったのですが、今回は自宅キャラクターのイラストをお願いいたしたく思います。\n\n第三の壁を越える、ミステリアスなキャラクターです。アドバイザー、サポーターといった立ち位置をとり、隣人のような存在で、ニヒルな性格をしています。機知に富んで、ユーモラスでもあります。\n茨さんの言葉選びがとても好きなこともあり、もし可能であればなにか一言、テキストを添えていただけるととても嬉しいです。\n\nその他、構図等に指定はございませんので、自由に描いていただけましたら嬉しいです。服装などもお任せいたします。\n\nよろしくお願いいたします！\n\nhttps://www.dropbox.com/scl/fo/45dqjaeovt4qoms438c3n/ADpOsmnT-9zYg2QCBM2iX3o?rlkey=s7k09v98ek7uxommhukwvx8jv&st=bpbbgx23&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ibara_08th/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3777193, "client_id": 3781532, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60407c52/uploads/origins/e4517d94-c798-4059-b296-f05ee857c7f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1100de9c66e188e1fd4fc453e601319", "srcset": "https://si.imgix.net/60407c52/uploads/origins/e4517d94-c798-4059-b296-f05ee857c7f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1100de9c66e188e1fd4fc453e601319, https://si.imgix.net/60407c52/uploads/origins/e4517d94-c798-4059-b296-f05ee857c7f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ace4bbd5f16b561fdf239405846a65b5 2x, https://si.imgix.net/60407c52/uploads/origins/e4517d94-c798-4059-b296-f05ee857c7f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9117edb8f570b04030103e260d8d5a08 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/60407c52/uploads/origins/e4517d94-c798-4059-b296-f05ee857c7f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3e404d6631175c176432df590f76288", "srcset": "https://si.imgix.net/60407c52/uploads/origins/e4517d94-c798-4059-b296-f05ee857c7f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3e404d6631175c176432df590f76288, https://si.imgix.net/60407c52/uploads/origins/e4517d94-c798-4059-b296-f05ee857c7f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa40ee44afd0033b1c0b874e3cbd0a73 2x, https://si.imgix.net/60407c52/uploads/origins/e4517d94-c798-4059-b296-f05ee857c7f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb0d3afd95f6f0196ebd09aa57a0b737 3x"}, "body": "こんにちは。\n前回一度リクエストさせていただいたものです。\nそのとき描いていただいたイラストが本当に素敵で大切にしています。\n今回もぜひお願いしたいと思い、再び依頼させていただきました。\n\n【キャラクター】\n「どうかお達者で」に登場する3人\n\n【構図・背景など】\n3人がこちらを向いて、私の方を覗き込んでいるような構図でお願いいたします。\n兄と妹が少し口論しているような雰囲気があると嬉しいです。\nスマホの壁紙にして毎日眺めたいので、縦長のスマホ壁紙サイズ（比率19.5:9）でお願いいたします。\nキャラクターの服装や表情、色味、ポーズなどは、茨さんの感性で自由に描いていただけたら嬉しいです。\n\n今回も拙いお願いで恐縮ですが、もしお引き受けいただけましたらとても嬉しいです。\nどうぞよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ibara_08th/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3777193, "client_id": 3784208, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a