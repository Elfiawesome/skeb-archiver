igins/c53521bc-78fe-4f36-b388-ebe547885f65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a9b3ab2c0bf02c8909bb4097d99ac4d 2x, https://si.imgix.net/02bb46bb/uploads/origins/c53521bc-78fe-4f36-b388-ebe547885f65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c81003fb68efcf6c9d0891265080de8f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/02bb46bb/uploads/origins/c53521bc-78fe-4f36-b388-ebe547885f65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8b70125bbf767f0203dd45a14182793", "srcset": "https://si.imgix.net/02bb46bb/uploads/origins/c53521bc-78fe-4f36-b388-ebe547885f65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8b70125bbf767f0203dd45a14182793, https://si.imgix.net/02bb46bb/uploads/origins/c53521bc-78fe-4f36-b388-ebe547885f65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aed6f23beeed4ba5d3805330e9a78837 2x, https://si.imgix.net/02bb46bb/uploads/origins/c53521bc-78fe-4f36-b388-ebe547885f65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7b13cbadcd9708a17641aa18bf52c933 3x"}, "body": "DKou先生、こんにちは。はじめまして。先日、先生の『ハスノソラ』のイラストを拝見しました。作品の雰囲気や色合いに深く心を打たれ、出版された同人誌もいくつか購入させていただきました。\n\nそこで、『ハスノソラ』に登場する村崎さやかさんと日下佳穂さんのイラストをお願いしたいのです。お二人の間に漂う独特な雰囲気、特に夜や冬を思わせるクールなトーンが大好きです。\n\n構図全体については、すべて先生にお任せしたいと思います。私はかねてより先生の芸術性を尊敬し、高く評価しており、長年にわたり先生の活動を応援してまいりました。今後も引き続き応援し続けます。\n\nもしご予算のご希望がございましたら、遠慮なくお知らせください。ご検討いただき、誠にありがとうございます！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_dkou/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3037340, "client_id": 1355979, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b11d929a/uploads/origins/d9851139-2062-47a1-85b6-