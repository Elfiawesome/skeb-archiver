report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@131_mmmi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3503022, "client_id": 3066670, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e2e6605/uploads/origins/45b45069-07d0-4f9d-90d7-17272e86775c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7236de371096248421ed033997a370b3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e2e6605/uploads/origins/45b45069-07d0-4f9d-90d7-17272e86775c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b480a92e3609d5d7ad53ca4e526f49a", "src_set": ""}, "body": "し-先生、こんにちは。\n今回はゲーム「魔法少女ノ魔女裁判」の遠野ハンナと橘シェリーのイラストをお願いします。\nハンナちゃんに頭をなでなでされて褒められ、照れちゃってどうしたらいいかわからないシェリーちゃんが見たいです。\nどうぞよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@131_mmmi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3503022, "client_id": 3353737, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7836d46/uploads/origins/8a2f52be-0a08-4ea5-a6c6-cf165f3f44d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37ff0c0d2bf9800b880fa3433fc2e8ed", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7836d46/uploads/origins/8a2f52be-0a08-4ea5-a6c6-cf165f3f44d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b25f184db3cf83f47b7e5f114af723a9", "src_set": ""}, "body": "お疲れ様です。いつも素敵なイラスト拝見させていただいています。\n\n・内容\n以下のURLの参考画像の先生とブルアカのヒナちゃんとネル先輩の３人のイラストを希望したいです\nhttps://drive.google.com/file/d/1T7k7fZj_k5NY2J-h4yV8P97aSmgAOksx/view?usp=drive_link\n 構図などは先生の左右にヒナネルor先生の下にヒナ、隣にネル等を考えています。ただ、こちらはあくまで素人の参考程度でしー先生が可愛いと思う構図でかいていただきたいです。\n\n・使用用途\n　ツイッターやdiscords等のSNSのアイコンやヘッダー、スマホやPCの壁紙を使用用途に考えています。また、自分がイラストを描く際の参考にもさせていただこうと思います。もし上記の内容で使用してほしくないものがあればご連絡いただけると幸いです。サイズに関しましてはご考慮は不要で大丈夫です。\n\n\nいつも素敵なイラスト楽しませていただいています。未熟でわかりにくい文章で、うまくお伝え出来ずに申し訳ありません。先生とヒナ、ネルが映っているイラストが見れれば大満足です。お時間のある際にゆっくりと楽しんで書いていただけると幸いです。よろしくお願いします。\n\nhttps://drive.google.com/file/d/1T7k7fZj_k5NY2J-h4yV8P97aSmgAOksx/view?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@131_mmmi/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cd69ce4d/uploads/origins/723064d0-3936-47fd-9854-d73f910b6a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57fe286fecc900e6fc86034a739f3b71", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3503022, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@131_mmmi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3503022, "client_id": 1948787, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e5bf700/uploads/origins/234ccbf7-abce-4b89-9498-56e88589a115?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=953acd7d3ab0df74b101214cbd0c5eb1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e5bf700/uploads/origins/234ccbf7-abce-4b89-9498-56e88589a115?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3165c55f6c8f508edafd4611e79781e5", "src_set": ""}, "body": "いつもお世話になっております。蘭●と申します。\nし-せんせの絵にはいっつも限界化しながら有難く拝見させて頂いてます。\nし-せんせに自分の好きを詰めた子を描いてもらえたたらうれしいなと思い、依頼させていただきます。\n\n要望\n・構図\nうちの子（女先生に流用も考えている）とヒナちゃんが談笑している感じだと嬉しいです\n\n・うちの子（資料URL先の女の子）（Twitterのアイコンの子です！）の容姿や服装\n髪色：焦げ茶　\n髪型：ロングのストレート　\n目の色：赤\n身長：143㎝くらい\n胸部：平\n\n服装とか装飾品とか\n\n黒パーカー（参考：https://gochiusa-exhibition.com/goods/256/）フードは被らない感じでお願いできればと思います。\n\n金色のふちの丸メガネ\n\n緑色のヘッドフォンを首にかけている（参考：https://www.ark-pc.co.jp/i/50283168/ )\n\nショートパンツ（色や生地等はお任せします）\n\n色見が変わったごちうさのチノちゃんをベースに想像して頂くのが一番近いです。\n\n・使用用途\n頂いたイラストは、許可頂ければSNSのアイコンやホーム・ヘッダー画像、並びにYouTube等の配信プラットフォームやDiscord等の通話ツールのアイコン等に利用したいと思っています。\n\n・その他\n上の参考先を挙げている物は、企業のロゴとか服装のデザインとかについて、商標権著作権とか諸々あると思いますんで、その辺は資料URL先みたいに全く描かずにお願いできたら嬉しいです。\n\n最後に\n　構図とか関係なくヒナちゃんを描いて頂ければもう簡単に涙流して喜ぶので！！！（あわよくばうちの子も描いて欲しいのは本心ですけど！）全く気負わず、好きに描いて頂ければ嬉しいです！！！いつも本当に素敵なイラスト・漫画等ありがとうございます！！！今後ともよろしくお願いできたら嬉しいです！\n\nhttps://skeb.jp/@kiyotan1107/works/14", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 28218, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "しろし", "screen_name": "shirofox", "avatar_url": "https://pbs.twimg.com/profile_images/847823948679004162/ROiPKdsf.jpg", "header_url": "https://pbs.twimg.com/profile_banners/40228805/1735642101/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 177}, {"id": 274225, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "古河おどろ", "screen_name": "RE_yomawari", "avatar_url": "https://pbs.twimg.com/profile_images/1925546316228435973/tmR-hNDu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/370459500/1758207182/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 