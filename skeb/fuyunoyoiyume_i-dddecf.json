439d-88e0-9815ca7ef78a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cba813353c90d65b774ea9e210f2533, https://si.imgix.net/372ee955/uploads/origins/7cdc200b-4357-439d-88e0-9815ca7ef78a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=613fcdc626a982ae9378a7a919b0a145 2x, https://si.imgix.net/372ee955/uploads/origins/7cdc200b-4357-439d-88e0-9815ca7ef78a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9550bd91294af10ce78eb0b1d770914b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/372ee955/uploads/origins/7cdc200b-4357-439d-88e0-9815ca7ef78a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d52d5b5960c7829cc75ed6b15517caef", "srcset": "https://si.imgix.net/372ee955/uploads/origins/7cdc200b-4357-439d-88e0-9815ca7ef78a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d52d5b5960c7829cc75ed6b15517caef, https://si.imgix.net/372ee955/uploads/origins/7cdc200b-4357-439d-88e0-9815ca7ef78a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=775f2e6bd1efb7dc73d6048cf78e604c 2x, https://si.imgix.net/372ee955/uploads/origins/7cdc200b-4357-439d-88e0-9815ca7ef78a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2ee3e6a2810fb419d9de3cd83d8f4a1a 3x"}, "body": "暮六つ刻（睦月）様\nはじめまして。暮六つ刻（睦月）様の絵柄が気に入りましたので、依頼を送らせていただきます。\n犬耳、尻尾の巫女の女の子が種子島(鉄砲)で射撃姿勢を取っている、もしくは射撃している絵を描いていただけないでしょうか。\n\n詳細\n犬種　柴犬、秋田犬、北海道犬、甲斐犬、紀州犬、四国犬の中からお願いします。\n髪、瞳の色　上記で選んだ犬種を基準にお願いします。(髪型と長さは任せます)\n射撃姿勢　立ち射ち、膝射ち、座り射ち、寝射ちの中からお願いします。指を引き金にかけて、今にも射撃をしそうな状況、あるいは射撃している状況をお願いします。\n種子島　一般的な大きさである小筒のほか、大型である中筒、士筒のどれを使っていても構いません。\n巫女装束　巫女装束は丈が短かったり肩に切れ込みがある創作特有のものではなく、正規の物をお願いします。また、損傷していても構いません。\n表情　恐怖で怯えている以外でしたら好きに描写して構いません。(例　落ち着いた感じで淡々としている、不敵な笑みを浮かべている、穏やかに微笑んでいる、戦闘狂染みている、自我を失っている等)\n胸部　貧から爆までの範囲でお任せします。\nその他　早合「http://www.xn--u9j370humdba539qcybpym.jp/part1/archives/35」、「https://www.meihaku.jp/arquebus-basic/matchlock-launchmethod/」を首から下げている。(または袈裟懸けで下げている)\n負傷描写等　一切なくても構いませんし、軽傷または重傷でありながらも堪えている、ないしはものともしないような描写でも構いません。また、土や泥の汚れについても任せます。\n巫女装束が損傷していても構いませんが、下着等が露出することがないようにお願いします。\n場所　委任しますが、宇宙空間等のSF要素を感じさせるものは却下でお願いします。\nセリフ等差分\n内容等に合うものを委任します。\n\n暮六つ刻（睦月）様の発想に頼るところが大きいですが、何卒よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fuyunoyoiyume_i/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3463227, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2e291223/uploads/origins/9593ea3b-0966-46bf-b264-b2d240a0f1c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf4a6a14301f67224787627398f656f3", "srcset": "https://si.imgix.net/2e291223/uploads/origins/9593ea3b-0966-46bf-b264-b2d240a0f1c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf4a6a14301f67224787627398f656f3, https://si.imgix.net/2e291223/uploads/origins/9593ea3b-0966-46bf-b264-b2d240a0f1c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06dc1f75381bdf58484db32dc973ff92 2x, https://si.imgix.net/2e291223/uploads/origins/9593ea3b-0966-46bf-b264-b2d240a0f1c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7970ce0cc4b8e7ab1de760c2eabe087c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e291223/uploads/origins/9593ea3b-0966-46bf-b264-b2d240a0f1c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e7c15431c845ef931170ec788a54598", "srcset": "https://si.imgix.net/2e291223/uploads/origins/9593ea3b-0966-46bf-b264-b2d240a0f1c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e7c15431c845ef931170ec788a54598, https://si.imgix.net/2e291223/uploads/origin