れて本当にありがとう！\n\n今回は、私のキャラクター「いたずら」を描いてくれたら嬉しいです。その名の通り、彼女はとてもいたずら好きで、たとえ他の人を怒らせても、人にちょっかいを出すのが大好き。いつも家の中にいて、よくネットで人を荒らしています。前回同様、ポーズや表情はお任せします。\n\nhttps://f2.toyhou.se/file/f2-toyhou-se/images/75752164_6LhfROlLetJ8Pu6.png\nhttps://f2.toyhou.se/file/f2-toyhou-se/images/91168292_EI1roL3DScVlJ7Z.png", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nibiiroibushi/works/49", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2213434, "client_id": 3207268, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d010126/uploads/origins/b8ecd74d-6e68-40c2-b850-9e58bceb3aac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e57d8fc322e7ce3e41385cd9179ad623", "srcset": "https://si.imgix.net/5d010126/uploads/origins/b8ecd74d-6e68-40c2-b850-9e58bceb3aac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e57d8fc322e7ce3e41385cd9179ad623, https://si.imgix.net/5d010126/uploads/origins/b8ecd74d-6e68-40c2-b850-9e58bceb3aac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed5fd121fd776ce0981b91402eed1c1c 2x, https://si.imgix.net/5d010126/uploads/origins/b8ecd74d-6e68-40c2-b850-9e58bceb3aac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea8ecbb465cb46c225a68f519f891ae7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d010126/uploads/origins/b8ecd74d-6e68-40c2-b850-9e58bceb3aac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cfe81f0f62057c842c16eb20d5f726d3", "srcset": "https://si.imgix.net/5d010126/uploads/origins/b8ecd74d-6e68-40c2-b850-9e58bceb3aac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cfe81f0f62057c842c16eb20d5f726d3, https://si.imgix.net/5d010126/uploads/origins/b8ecd74d-6e68-40c2-b850-9e58bceb3aac?bg=%23fff&