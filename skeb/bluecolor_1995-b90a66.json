29a7514cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2260601efb16a0ded45c3389bd8478f1", "srcset": "https://si.imgix.net/39bfdcff/uploads/origins/92cd31d3-5fbb-4ed7-9b98-b929a7514cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2260601efb16a0ded45c3389bd8478f1, https://si.imgix.net/39bfdcff/uploads/origins/92cd31d3-5fbb-4ed7-9b98-b929a7514cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5043b1a8eb9332d0f33c85004b4b8f58 2x, https://si.imgix.net/39bfdcff/uploads/origins/92cd31d3-5fbb-4ed7-9b98-b929a7514cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2846b578b4844fe77892e33ec34f7ee7 3x"}, "body": "フレッシュプリキュアのオナホ化をお願いします！\n前回、ドキドキプリキュアのオナホをリクエストした物です。\n今回もセリフが多くメビウスに激闘の末、オナホにされる話にして\n色はそれぞれのイメージカラー、\n今回は抜け殻なしでオナホだけでお願いします。\nただ、出力の調整が足りなく\n\nhttps://amzn.asia/d/03Q4R4rb\n\nと言うオナホが売ってるんですがそれみたいにゴムパンツが付いてる感じにしてもらってキュアピーチ以外パンツを剥がして犯して下さい。\nパンツはパインはブラとのショーツ(大人用)\nベリー、パッションはお子様可愛い柄のパンツ小学生が穿きそうな奴 ブラ無し\nそのパンツに対して台詞でイジって恥ずかしめて下さい。\nピーチもお子様パンツでバックプリントなので前はリボンだけでいいです。\nブラとパンツを脱がしたらパインの爆乳陥没乳首をイジって恥ずかしめて４人全員前みたいに犯して下さい。\n犯し終わったら、ピーチ以外3人は台詞だけ\nピーチだけにしてもらいオナホの後ろ側(お尻の方)を描いてもらってからここで、ピーチのパンツを脱がして下さい。\nピーチのパンツはデコレーションが多い、https://images.app.goo.gl/TfvgYezujGA7TTNq6\n可愛い大きい可愛い英字のバックプリントパンツですピーチ「めくらないで」と言わせてめくって下さい。\nオナホにアナル周辺と脱がしたパンツにうんちの印字(オナホ化した時に失禁した設定)\nオナホとゴムパンツにうんちの模様が付いてる感じ。\nその時にピーチをめちゃくちゃ恥ずかしめて、\nピーチに「違うのやめてみんな見ないで！！」みたいな感じでやって下さい。\n\nそして、嫌がるピーチのアナルを犯して下さい。\n\n犯されているピーチの前には四つ這いになってる抜け殻ピーチが知念大輔や町の人たちの前で晒しあげられ\nオナホと抜け殻のアナルの感覚同化されピーチは必死に耐えるが大きいオナラからの大きいうんちの塊を出してしまい絶望する物語を描いてほしいです！\n抜け殻のアングルはお尻とけつ穴が見えるようにお願いします。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bluecolor_1995/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 651396, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/56b5dbc8/uploads/origins/ab6a0aee-8133-47e0-a3de-52bb504f2809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ae23e27ab9f6e0a4c5dc158fc5c205e", "srcset": "https://si.imgix.net/56b5dbc8/uploads/origins/ab6a0aee-8133-47e0-a3de-52bb504f2809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ae23e27ab9f6e0a4c5dc158fc5c205e, https://si.imgix.net/56b5dbc8/uploads/origins/ab6a0aee-8133-47e0-a3de-52bb504f2809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f4f55520a5d624fc688a21584369bb3 2x, https://si.imgix.net/56b5dbc8/uploads/origins/ab6a0aee-8133-47e0-a3de-52bb504f2809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=205456489981ae42780a794bc7c37319 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56b5dbc8/uploads/origins/ab6a0aee-8133-47e0-a3de-52bb504f2809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=344f4f30aa695de70ae75a5f45aa615f", "srcset": "https://si.imgix.net/56b5dbc8/uploads/origins/ab6a0aee-8133-47e0-a3de-52bb504f2809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=344f4f30aa695de70ae75a5f45aa615f, https://si.imgix.net/56b5dbc8/uploads/origins/ab6a0aee-8133-47e0-a3de-52bb504f2809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=596b7bfa7fdbbdccc1c4185157b7a333 2x, https://si.imgix.net/56b5dbc8/uploads/origins/ab6a0aee-8133-47e0-a3de-52bb504f2809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b421823e651fd5587a657c7f7da5f89f 3x"}, "body": "はじめまして!初依頼です!\n\n内容「ちょっといっぱい！」の南部皐月と如月真澄の半生石化お願致します。\n\n真澄本人の依頼で二人で美術館に展示される事を希望\n皐月はこの事何も知りません\n\n1:石化した状態の二人（ポーズお任せ）顔の石化解除され状況を知る\n\nセリフ\n真澄「わぁ石化してる!本当に叶なった‼︎」（喜び）\n「さっちゃん!も一緒だぁ♡」\n\n皐月「ま、真澄っ⁉︎」\n「えっ!なっ⁉︎なんだこれ⁉︎身体が..⁉︎動けな...い！」（驚き）\n\n2 胸や股の石化が解除、淫紋が浮ぶ\n真澄「ほら始まるよ！二人でボテ腹妊婦像になろうね！」\n皐月「真澄！お前何言ってんっ..うぁっ⁉︎体が...熱い」\n\n3 犯される二人\n真澄「あぁっ♡もっとおちんぽください!種付けしてくださいぃ♡」\n真澄「私たちをめちゃくちゃにしてくださいぃ♡」\n皐月「やめっろ゛んんっ♡なんだこれぇくそっ♡なんできもちぃぃ゛ん」\n皐月「や゛めぇ゛　胸もむなぁ゛あ♡中にだすなぁ゛♡」\n\n4 数時間後\n大量出され二人でアヘ顔受精\n抵抗していた皐月も快楽に沈む\n\n真澄「ハァハァ♡たくさん中出しぃ♡ありがとうございますぅ♡お腹たぽたぽであったか〜い♡」\n皐月「むりぃ♡もうきもちいいのいらないのにぃ♡なかだしきもぢぃい」\n「赤ちゃんできちゃぅ゛♡」\nカットインで受精描写\n\n5 淫紋が光りお腹の石化が解除、急激に腹が成長、ボテ腹になり絶頂\n（お腹を見ている所から驚き混ざりのアヘ顔になる差分）\n同時に胸も成長\n真澄「あぁきたぁ♡赤ちゃん大きくなってるぅ♡」\n「おまんこ妊娠きもぢぃぃ゛い」\n皐月「なにこれぇ゛お腹膨らんでくるしぃィイグゥう♡」\n「ぉぉお゛ぉお゛お゛ぉ゛」\n\n6 再び犯され徐々に石化が進む\n真澄「妊娠おまんこきもちいぃ゛♡イグの止まらなくてどんどん石になるぅぅ゛♡」\n「早ぐ赤ちゃんごと卑猥な石像にしでぐださいぃぃ゛」\n皐月「おぉぉ゛ぉ♡いぎぃイグゥうぅ゛おま゛んこぉイグぅ」\n（イキ声沢山\n\n7 胸には手形が残り顔と股間以外は石化\nだらしのないアヘ顔でチンポ引き抜かれ、精液が溢れる\n放心状態\n\n8 再び淫紋が光り、アヘ顔のまま顔も石化、股間残し完成\nこの際、反応があってもいいですが、表情そのまま侵食しても構いません\n\n9 7日後\n卑猥な落書き　二穴はぽっかり空き精液が流れる\n\n以上です。セリフはアレンジあって大丈夫です\n\nhttps://comic-fuz.com/book/9561", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bluecolor_1995/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 651396, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/654ba19b/uploads/origins/2b4d7aa8-b7e1-466b-9614-882067ebdc69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2703b94c2661df310776e8c400bd9413", "srcset": "https://si.imgix.net/654ba19b/uploads/origins/2b4d7aa8-b7e1-466b-9614-882067ebdc69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2703b94c2661df310776e8c400bd9413, https://si.imgix.net/654ba19b/uploads/origins/2b4d7aa8-b7e1-466b-9614-882067ebdc69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b6387e97eafc57196add71335c8458b 2x, https://si.imgix.net/654ba19b/uploads/origins/2b4d7aa8-b7e1-466b-9614-882067ebdc69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da7983ccec7187d95bf48a47550ca95b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/654ba19b/uploads/origins/2b4d7aa8-b7e1-466b-9614-882067ebdc69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24d83786db7e250bf14cca09a4b84f14", "srcset": "https://si.imgix.net/654ba19b/uploads/origins/2b4d7aa8-b7e1-466b-9614-882067ebdc69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24d83786db7e250bf14cca09a4b84f14, https://si.imgix.net/654ba19b/uploads/origins/2b4d7aa8-b7e1-466b-9614-882067ebdc69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=db3c2c05e7ff9520ca2457130557b674 2x, https://si.imgix.net/654ba19b/uploads/origins/2b4d7aa8-b7e1-466b-9614-882067ebdc69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fcaae001625572bbe68279aef3c47258 3x"}, "body": "リクエストお願いします！らき☆すたの泉こなたと柊かがみの石化ものです。\n\nふたりは青色海石化美術館に申し込み、自ら石像として美術品の一部になることに同意してる。\n\nこなたは自分の人生が終わって性処理に使われる道具でしかなくなることに背徳感と期待を明らかにしていて、かがみは状況にだいぶ恥ずかしくなってるが特に嫌がっておらず、淡々と受け入れてる。\n\n二人は裸（かがみはリボン残し）に淫紋を書かれ、上の心境のまま自分たちの状況を説明したりお互いと何気ない会話をしながら、周りの男性にぶっ掛けられたりセックスされたりします。体勢や具体的な性行為やこの時の石化の進み具合などはお任せします。\n\n最後に淫紋が光り、二人は強烈な快楽の中完全に石化する描写もお願いします！ほかの具体的なところやセリフはお任せします！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bluecolor_1995/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 651396, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de5fcc45/uploads/origins/1a1e5693-fe5e-4cbb-8445-5b4565b6ef0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33e6e7f554464e11ac0d786728008bde", "srcset": "https://si.imgix.net/de5fcc45/uploads/origins/1a1e5693-fe5e-4cbb-8445-5b4565b6ef0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33e6e7f554464e11ac0d786728008bde, https://si.imgix.net/de5fcc45/uploads/origins/1a1e5693-fe5e-4cbb-8445-5b4565b6ef0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200