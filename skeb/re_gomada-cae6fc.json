-dbda-480e-ad59-93286d444777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0990e628df571cf7e59148f6853e958f, https://si.imgix.net/9f48a3ff/uploads/origins/a8724698-dbda-480e-ad59-93286d444777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db171d3d281d07bf7f09b6fc9b1b9d6c 2x, https://si.imgix.net/9f48a3ff/uploads/origins/a8724698-dbda-480e-ad59-93286d444777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e38abddddef7e72bb49fef1a7e8f6ae2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f48a3ff/uploads/origins/a8724698-dbda-480e-ad59-93286d444777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b5fb95ec408ee276eb37ef9776db99a", "srcset": "https://si.imgix.net/9f48a3ff/uploads/origins/a8724698-dbda-480e-ad59-93286d444777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b5fb95ec408ee276eb37ef9776db99a, https://si.imgix.net/9f48a3ff/uploads/origins/a8724698-dbda-480e-ad59-93286d444777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a52610e65de29a62a86a65426780478 2x, https://si.imgix.net/9f48a3ff/uploads/origins/a8724698-dbda-480e-ad59-93286d444777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f601af3b9c4a4b0d37046064b73cebac 3x"}, "body": "ごまだれさん こんにちは。\n先日は、とても素敵なイラストをありがとうございました!!\nいただいたロゼットちゃんを何回も見直して、ごまだれさんの描く絵めっちゃ好きだなぁと改めて思いました。\n\n早速のリピートになってしまい申し訳ないのですが、今回もロゼットちゃんを描いていただきたいです。\n\n《描いていただきたいもの》\n先日リクエストさせていただいたロゼットちゃんのイラスト\nhttps://skeb.jp/@re_gomada/works/1 \n\n・前回とは異なる構図で、ごまだれさんの好きなように描いていただきたいです(立っていても座っていても寝ていても、どんな構図でも構いません)。表情などもお任せいたします。\n\n・もし全身を描いていただける場合には、前回同様に頭や足先が途切れずに収まっているとありがたいです。\n\n・人物のみの、背景透過したバージョンもいただけると嬉しいです。\n\n《使用用途など》\nYouTubeでの動画、サムネイル、Twitterでの投稿に使用させていただきたいです。\n\n前回から短いスパンでのリクエストになってしまい申し訳ございません。\n十分にお休みをとられてからリクエストを承認いただければ嬉しいです。\n\nよろしくお願いいたします。\n\nhttps://skeb.jp/@re_gomada/works/1", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@re_gomada/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2674780, "client_id": 2683029, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ee1cc5c/uploads/origins/700ee20a-7d6d-4565-bd8c-1c6ab0fd34f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=541c0383312c872d67c0ea9ae113b067", "srcset": "https://si.imgix.net/2ee1cc5c/uploads/origins/700ee20a-7d6d-4565-bd8c-1c6ab0fd34f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=541c0383312c872d67c0ea9ae113b067, https://si.imgix.net/2ee1cc5c/uploads/origins/700ee20a-7d6d-4565-bd8c-1c6ab0fd34f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b25b7aacf27e6b45601dfa8f85c4eb9 2x, https://si.imgix.net/2ee1cc5c/uploads/origins/700ee20a-7d6d-4565-bd8c-1c6ab0fd34f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f0d5b18d888355c7118c31c5437b66c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ee1cc5c/uploads/origins/700ee20a-7d6d-4565-bd8c-1c6ab0fd34f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d18eb31e00b97416fecb9eaad87d9b3", "srcset": "https://si.imgix.net/2ee1cc5c/uploads/origins/700ee20a-7d6d-4565-bd8c-1c6ab0fd34f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d18eb31e00b97416fecb9eaad87d9b3, https://si.imgix.net/2ee1cc5c/uploads/origins/700ee20a-7d6d-4565-bd8c-1c6ab0fd34f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=de15b78d96226fabcda8ed64327e93b1 2x, https://si.imgix.net/2ee1cc5c/uploads/origins/700ee20a-7d6d-4565-bd8c-1c6ab0fd34f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa2d230d90d176728c66aa572424adc1 3x"}, "body": "ごまだれさん こんばんは。\nコチラの動画【https://youtu.be/ei3KkZKlFC8 】でごまだれさんのイラストに感銘を受け、ぜひリクエストさせていただきたいと思いました。\n\n《描いていただきたいもの》\n「たんぽぽのロゼット」をイメージした、少女が仰向けで寝そべっているイラスト\n\n・主にたんぽぽなどの植物が行う\"ロゼット\"と呼ばれる葉を地面にペタッと広げる行為。一見萎れているようにも見えますが、葉を地面に広げることで風をしのいだり、日光を効率よく浴びられる合理的な行為らしいです。\n\n・少女の髪型や髪の色、服の色は、たんぽぽが連想されるような色合いで、ごまだれさんにお任せいたします。目も開いていても閉じていてもどちらでも。\n\n・構図はロゼットがモチーフなので寝そべらせてほしいです。その際に、両手は上がっていて、服が少しはだけておへそがチラッと見えると嬉しいです。\n\n・背景にたんぽぽの綿毛のような白いものがふわふわしていると一層いいです！\n\n・ご負担でなければ全身をお願いしたいのですが、腰上でも大丈夫です。\n\n・可能であれば人物のみの、背景を透過したバージョンもいただけると嬉しいです。\n\nとても抽象的なイメージしかお伝え出来ず、申し訳ございません。いわゆる「たんぽぽの擬人化」と思っていただいて差し支えありません。\n\n《使用用途など》\n新しくYouTube活動とそれに付随するTwitterを始めたく、その際のアイコンやサムネイルとして使用させていただきたいです。\n\nごまだれさんのまるで絵本から飛び出してきたような絵のタッチや色使いがどストライクなので、ごまだれさんの想像するたんぽぽのような少女が寝そべっているイラストがいただけると幸いです。\n\nお忙しい中、このような概念的な抽象的なお題で申し訳ございません。\nもしよろしければご検討お願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 13987, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ブラニン", "screen_name": "buraninn", "avatar_url": "https://pbs.twimg.com/profile_images/1381521033379733504/EzJcJtjq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/525039013/1732346355/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 227941, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "lil Monster（お仕事募集中）", "screen_name": "zbuta_turatan", "avatar_url": "https://pbs.twimg.com/profile_images/2044652053876854784/i3Tp-pGq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1026060574042480641/1714745881/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "r