い画像をリンクでお送りします(あくまでイメージなので、服装、装飾など細部を改変して頂いて構いません)\n\nhttps://drive.google.com/file/d/1_m6iONbDXiqyl7Prn4-Zl7b1J5YxEgza/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1_SGZ1Z-UfMAThsJ_RRHVm6Y8RaaXzgN8/view?usp=drivesdk\n\nよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsurukame/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 451861, "client_id": 3560308, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3819274e/uploads/origins/969dbda4-ea95-42de-b8bf-e7be9ca90526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39134f2c6e6830d92a4f532f93949f15", "srcset": "https://si.imgix.net/3819274e/uploads/origins/969dbda4-ea95-42de-b8bf-e7be9ca90526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39134f2c6e6830d92a4f532f93949f15, https://si.imgix.net/3819274e/uploads/origins/969dbda4-ea95-42de-b8bf-e7be9ca90526?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=beb352d275a104ac698de662c3c70ea8 2x, https://si.imgix.net/3819274e/uploads/origins/969dbda4-ea95-42de-b8bf-e7be9ca90526?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6269bb5c2d5fa3398c4420170b85f42b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3819274e/uploads/origins/969dbda4-ea95-42de-b8bf-e7be9ca90526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fc742f9acf77f91c792fdeb8ed3feac", "srcset": "https://si.imgix.net/3819274e/uploads/origins/969dbda4-ea95-42de-b8bf-e7be9ca90526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fc742f9acf77f91c792fdeb8ed3feac, https://si.imgix.net/3819274e/uploads/origins/969dbda4-ea95-42de-b8bf-e7be9ca90526?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&