ad-a655-c45c314ecf4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbb06381c75daa9726d16a7a4356e480", "srcset": "https://si.imgix.net/6b8b59b7/uploads/origins/59edcde0-81cb-44ad-a655-c45c314ecf4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbb06381c75daa9726d16a7a4356e480, https://si.imgix.net/6b8b59b7/uploads/origins/59edcde0-81cb-44ad-a655-c45c314ecf4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b7f2458c85b9066a254ed1ae31f701c 2x, https://si.imgix.net/6b8b59b7/uploads/origins/59edcde0-81cb-44ad-a655-c45c314ecf4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3bbf549cebad6cb9d6f02fe78e47843 3x"}, "body": "お世話になっております。\n\n以前に描いて頂いた「サウザンド・アイズ・サクリファイスに吸収・拘束されたブラック・マジシャン・ガール」( https://skeb.jp/@tsurukame/works/5 )がとても良かったので、前回と全く同じテーマでもう1枚描いていただくことは可能でしょうか？\n\n\n【お願い】\n・可能な限りで大きな絵にしてもらえますでしょうか。\n・股間は太ももで隠すなどして、モザイクを使わないようにしていただけますでしょうか。\n・テーマは同じですが、前回と違ったアングル・構図になっても構いません。\n・涙、汗など濡れた表現がとても良かったので、今回も同じようにして欲しいです。\n\n\n【前回の内容を再掲】\n●主題\nサウザンド・アイズ・サクリファイスに吸収・拘束されたブラック・マジシャン・ガール\n\n\n○サウザンド・アイズ・サクリファイスの説明\n・全体像:\nhttps://x.com/crowsbox/status/1814633084912083264\n・敵のモンスターを吸収し、無数の目玉がはえた肩(羽？)の部分に拘束する\n・モンスターが拘束されている様子の参考イラスト:\nhttps://www.pixiv.net/artworks/12900418\n類似のキャラ:\nhttps://x.com/miya_2jisuki/status/1415672199625678848\n\n○ブラック・マジシャン・ガールの服装・ポーズ\n・帽子と首飾りだけを身に着け、あとは全裸\n・手と足が埋め込まれたポーズ:\nhttps://www.pixiv.net/artworks/130287839\nhttps://www.pixiv.net/artworks/124359405\n\n○構図\n・拘束されたブラック・マジシャン・ガールがメイン\n・サウザンド・アイズ・サクリファイスは背景役で、全身が絵に収まる必要はなく、見切れていてよい\n\n\n「美しい女性が醜いモンスターに拘束された嗜虐的な絵」にしていただきたいです。\n\n\nご検討よろしくお願いします。\n\nhttps://skeb.jp/@tsurukame/works/5", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsurukame/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 451861, "client_id": 3560308, "vtt_url": n