 "correction", "default_amount": 500}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 14, "received_works": [{"path": "/@TukurigiN/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3501554, "client_id": 1367873, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d32dd7f1/uploads/origins/4164903f-8173-4d1b-929b-45f19e1c09ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8e08ea9f1da93a14c82642c0783e73b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d32dd7f1/uploads/origins/4164903f-8173-4d1b-929b-45f19e1c09ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78b0048bb770098bb324544e4b15f066", "src_set": ""}, "body": "創木さん、初めまして。Misae Mamiyaと申します。突然失礼します。\nキスミーから参りました。実績の糧になれたら良いなと思い、依頼したく思います。\n\n自宅の悪魔創作より、「マルコシアス」をお願いします。\n\n\n【キャラ特徴】マルコシアス\nソロモン72柱の一人。グリフォンの翼と蛇の尾を生やした狼の姿で現れる。\n自創作設定では、とにかく真面目で敬語どころか尊敬語・謙譲語を使うようなヒト(堕天使)。愛称「マルコ」。\n正直で礼儀正しい性格。嘘つきが大嫌いで、彼に嘘をつくものなら命の保証はない。\n※デザイン案で四つ耳になっています。四つ耳に違和感がありましたら、もみあげを生やしてケモ耳だけ見せても構いません。\n\n【希望構図】\n全体的にお任せしますが、彼の礼儀正しさが表れていたら幸いです(胸に手を当てる、お辞儀をするなど)。\n\n\n以上になります。短文になってしまい申し訳ございません。\nこちらで問題なければ、よろしくお願いいたします。\n\nhttps://x.com/misalis_0121/status/719074324242571264?s=46", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TukurigiN/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f2274f9f/uploads/origins/64aad139-6ee3-4bda-aa2e-145be0ca33ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=341c4ba3c090866c843848490d369538", "src_set": ""}, "private": true, "genre": "novel", "tipped": false, "creator_id": 3501554, "client_id": 0, "vtt_url": "", "thumbn