ount": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fuji_amiha/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2737953, "client_id": 2505868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71a5bf95/uploads/origins/40324a88-51e9-471e-b0d0-bf5e43b5384c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18bba3afe0db5219a50087ddd883384a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71a5bf95/uploads/origins/40324a88-51e9-471e-b0d0-bf5e43b5384c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ea35ed29d9f690a9f8b7aadc08a33b8", "src_set": ""}, "body": "fuji@あみは。様初めまして。 mogu hapiと申します。 Twitterでfuji@あみは。様のイラストを拝見させて頂き、素敵だなと思いましたのでリクエストさせて頂きました。 今回描いて頂きたいのは、私の推しのVTuberである 魔ノ姫こあくさん( https://twitter.com/KoakuManohime ) です。\n\nご要望:\n歌っているシーンを描いていただきたいです\n具体的な衣装、髪型、ポーズ、構図等は先生にお任せさせていただきたいです\n\n納品形式:\nキャラクターのみを素材として使用する可能性もあるので、キャラクターと背景をレイヤー分けしていただけると嬉しいです。\n\n使用用途:\n利用させて頂きたい範囲と致しまして、イラストはFAタグを付けてTwitterに投稿を考えています。ご本人のVTuberさんにTwitterで触れられたり、場合によっては配信のサムネイルや予定表などに使用される可能性もあります。もちろん描いていただいた絵師様のお名前も一緒にツイートしますが、上記を許可していただける方にご依頼したいです。\n\n容姿のモデルは資料ＵＲＬ(キービジュアル)に貼らせていただいておりますので、参考にしていただければと思います･･･！\n\nhttps://twitter.com/KoakuManohime/status/1567498641425973255", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fuji_amiha/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2737953, "client_id": 15107, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3ae2a24/uploads/origins/052c1578-12f8-46d2-8f4a-e2d91310dbcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c56a952b831a72c7fd92f2931b7d700", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_