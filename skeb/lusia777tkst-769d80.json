ございました。\n\nhttps://drive.google.com/drive/folders/1hC1b9QkYTo5PmcWSnF72SeChPdFAr6Pj?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lusia777tkst/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 60831, "client_id": 1475973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/315ec819/uploads/origins/33f8c4df-26f3-4e11-be1f-48008e18eb7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=494949a25e57574de99e8013f8babc2b", "srcset": "https://si.imgix.net/315ec819/uploads/origins/33f8c4df-26f3-4e11-be1f-48008e18eb7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=494949a25e57574de99e8013f8babc2b, https://si.imgix.net/315ec819/uploads/origins/33f8c4df-26f3-4e11-be1f-48008e18eb7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c47853ce7b423de40bb2ddf3dba2a33 2x, https://si.imgix.net/315ec819/uploads/origins/33f8c4df-26f3-4e11-be1f-48008e18eb7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1493cb443cd23102a73f34a9f7f9b9ec 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/315ec819/uploads/origins/33f8c4df-26f3-4e11-be1f-48008e18eb7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a4f10504c523d949077203146f80e73", "srcset": "https://si.imgix.net/315ec819/uploads/origins/33f8c4df-26f3-4e11-be1f-48008e18eb7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a4f10504c523d949077203146f80e73, https://si.imgix.net/315ec819/uploads/origins/33f8c4df-26f3-4e11-be1f-48008e18eb7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5fb48f63df69752b8fdab60b72b46ee0 2x, https://si.imgix.net/315ec819/uploads/origins/33f8c4df-26f3-4e11-be1f-48008e18eb7b?bg=%23ff