top&w=200&h=200&s=609f7d91fcd1c04bdc8511804a7ea5f7", "srcset": "https://si.imgix.net/349c29ef/uploads/origins/6ab16f0c-d277-4a6d-8c67-28a74de7a3be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=609f7d91fcd1c04bdc8511804a7ea5f7, https://si.imgix.net/349c29ef/uploads/origins/6ab16f0c-d277-4a6d-8c67-28a74de7a3be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fe8254ea4dbd4e7920904b41b41d929 2x, https://si.imgix.net/349c29ef/uploads/origins/6ab16f0c-d277-4a6d-8c67-28a74de7a3be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9477515b614805671e89553ae7b0623d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/349c29ef/uploads/origins/6ab16f0c-d277-4a6d-8c67-28a74de7a3be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f299fe7de8ae96f10b84f2cc38734201", "srcset": "https://si.imgix.net/349c29ef/uploads/origins/6ab16f0c-d277-4a6d-8c67-28a74de7a3be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f299fe7de8ae96f10b84f2cc38734201, https://si.imgix.net/349c29ef/uploads/origins/6ab16f0c-d277-4a6d-8c67-28a74de7a3be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b4c299a3f82a3979a54a6d3b186229e4 2x, https://si.imgix.net/349c29ef/uploads/origins/6ab16f0c-d277-4a6d-8c67-28a74de7a3be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a5e0f3cff8c7f8d62882cbb35177e184 3x"}, "body": "こんにちは！\nうなぎさんのSkeb、オリジナルキャラクターのリクエストは可能でしょうか……！\n\n　【名前】アゼリア＝リューゲル\n　【性別】女の子\n　【年齢】15\n　【身長／体重】155㎝／45㎏（という設定はしていますが、細身、胸はそこそこある、くらいの……）\n　【クラス】魔法使い\n　【種族】人間\n　【外見】堂々とした振る舞いをしている少女。\n赤い髪に青緑のリボンを結んでいる。\n※資料URLから色味が変わっていても大丈夫です\n　【服装】アンダーリムの眼鏡、髪のリボン、胸元のペンダント以外は、元画像から変更いただいても、そのままでも大丈夫です。\n【性格など】自信家で負けず嫌い。ウマ娘で言うとキングヘイローみたいな感じ。お姉ちゃんのことが大好き。強くて可愛くて格好良い（でもちょっと脆い）、そんな女の子です。\n\n「いいわ、手伝ってあげる。\n私はアゼリア。魔法の腕は確かよ」\n\nシチュエーション、ポーズ、服装等はお任せいたします。オリジナルキャラクター登録型ゲーム（資料URLみたいなの）や、自分の代理的なシチュエーションで使用させていただきたいです！\nゲーム内で使用する場合には、規定サイズに合わせてのトリミングをさせていただきたいです。\n\nお願いすることが叶いましたら、なにとぞよろしくお願いいたします！\n\n資料URLが見られない場合は以下の画像を参照ください↓\nhttps://game.428.st/uploads/3eb2ebb1-ea05-4157-8d93-894a708e1734.png\n\nhttp://archives.teiki.org/sssloxia/hmtm/0/result09/result/d/804.html", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unagi97/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2939038, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a72fbaec/uploads/origins/ac7b471b-9eb7-4982-bccf-98347ba14a19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64c70eacf7868003d1cc3fa8a3d7b1ed", "srcset": "https://si.imgix.net/a72fbaec/uploads/origins/ac7b471b-9eb7-4982-bccf-98347ba14a19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64c70eacf7868003d1cc3fa8a3d7b1ed, https://si.imgix.net/a72fbaec/uploads/origins/ac7b471b-9eb7-4982-bccf-98347ba14a19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab1dfcfcfd7b551759687ca5ee69fdd1 2x, https://si.imgix.net/a72fbaec/uploads/origins/ac7b471b-9eb7-4982-bccf-98347ba14a19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e312f8d1180480e0279fa1cc5e8061b3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a72fbaec/uploads/origins/ac7b471b-9eb7-4982-bccf-98347ba14a19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f5ad7b72c404fb0e03ee4874028960a", "srcset": "https://si.imgix.net/a72fbaec/uploads/origins/ac7b471b-9eb7-4982-bccf-98347ba14a19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f5ad7b72c404fb0e03ee4874028960a, https://si.imgix.net/a72fbaec/uploads/origins/ac7b471b-9eb7-4982-bccf-98347ba14a19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0be85706af7bf194c164e6e32f0fc2e9 2x, https://si.imgix.net/a72fbaec/uploads/origins/ac7b471b-9eb7-4982-bccf-98347ba14a19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=568303de4a2ae5adb1e442a7d76a3009 3x"}, "body": "うなぎさん初めまして。\nたまたま新着クリエイターで出てきたところをお見かけしまして、凄い可愛らしい絵柄や溢れるリッキーちゃん愛、またポケモンもお好きだとということも述べられており、是非ご依頼をさせて頂ければと思った次第です。\n\nもしよろしければウマ娘の「コパノリッキー」に「トサキントレオタード」をコスプレさせた一枚をお願いできますか。\n（※トサキントレオタード→初代のポケモンアニメ43話「ナッシーぐんだん　だいこうしん！」で、カスミがマジシャンのアシスタントの際に着用していた、トサキントを模した衣装を指してます）\n衣装の造形につきましては資料ページをご参考頂ければ幸いです！\n\n衣装の元ネタは初代アニメの頃の話なので、ポケモン好きでもご存じない可能性も重々承知した上ですが、やはり私自身がこの衣装を好きであること。\nそして、うなぎさんご自身、相当にリッキーちゃんを推していることが伝わりましたため、その愛に寄生する形で、そしてポケモンへの思いも相乗効果を発揮されることを期待し、やや無茶を承知してお願いさせて頂ければと存じます。\n\n表情や構図・ポーズ、あと多少のアレンジなどについては、うなぎさんが良いと思ったまま、うなぎさんのご想像されるリッキーちゃんのリアクションで描いて頂ければOKです。\nウマ娘の規約的にセンシティブ配慮し、ストッキングを履かせる等の微アレンジを加えて頂く等は問題ないです、もちろん原作デザインそのままに素足で描かれてもOKです！\n（だけどロングな手袋は性癖なので、アレンジしても手袋は忘れないで頂ければとてもすごく嬉しいです……！）\nまた、コスプレ（衣装）姿がメインなので、せめて全身絵で衣装姿を堪能させて頂ければ特に嬉しく思います。\n\n願望強めな依頼となりますが、偶然新着で見かけたうなぎさんが、このお題をお願いするのに非常に適したお方なのではと目を掛けさせて頂きましたため、是非ともお願いできれば、本当にありがたく存じます！\n\nhttps://bulbapedia.bulbagarden.net/w/index.php?title=File:Misty_Goldeen_outfit.png", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 936968, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "もち@受かれば夏コミ", "screen_name": "riku_mochiduki", "avatar_url": "https://pbs.twimg.com/profile_images/1932892763437346816/5HKVahjZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1529071433024176133/1760719158/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "