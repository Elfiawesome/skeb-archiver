的动物如果可以有拟动物小涂鸦的话就太好了（？））\n想画清凉的衣服的话我们还有夏装版本：https://drive.google.com/drive/folders/11DzsM-IaHf1FQ_uD56EBc4w0rcmIxxBb?usp=sharing\n\n非常感谢！\n————————\n这是平时用的日语网盘（参考图更多一点）：https://drive.google.com/drive/folders/1Bf64h9wMoueFd43YA-UAL-PjWzrUGVRE?usp=sharing\n下面这个这是米的人设卡总之请看！———\n\nhttps://www.mihuashi.com/character-card-edit/b495db314e881e8f818fedb25e4f2f4b943033c5", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@K_FA_02/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2625985, "client_id": 2459698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/352feb78/uploads/origins/4411521e-de19-4dc0-af91-322200ae2262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25758f247d59e670112f6a7f81d78000", "srcset": "https://si.imgix.net/352feb78/uploads/origins/4411521e-de19-4dc0-af91-322200ae2262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25758f247d59e670112f6a7f81d78000, https://si.imgix.net/352feb78/uploads/origins/4411521e-de19-4dc0-af91-322200ae2262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa89d20a8b8cc206e4fe8c65f0d105a4 2x, https://si.imgix.net/352feb78/uploads/origins/4411521e-de19-4dc0-af91-322200ae2262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b563331ac5faf2126d5ff79046ed1bb1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/352feb78/uploads/origins/4411521e-de19-4dc0-af91-322200ae2262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf39dfd44f565a2b0c1c2f7cbff4ab08", "srcset": "https://si.imgix.net/352feb78/uploads/origins/4411521e-de19-4dc0-af91-322200ae2262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf39dfd44f565a2b0c1c2f7cbff4ab08, https://si.imgix.net/352feb78/uplo