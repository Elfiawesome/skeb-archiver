767aca-c9d5-40c6-8ebd-84e83210f34a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82ba9626ac36aa0c92778da59324b679", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e11220b0/uploads/origins/53767aca-c9d5-40c6-8ebd-84e83210f34a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e978f3411db3ac317c2e5a8013e7cb3b", "src_set": ""}, "body": "お世話になります。\n原神の蛍ちゃんの斬首で処刑シチュエーションを描いて欲しいです。\n\n構図または2シーン構成で\n①緊縛された蛍ちゃんが連行され、目の前の処刑現場におびえている。\n厳しく後ろ手に緊縛し、泣きじゃくりながら必死に無実を訴えて命乞いしつつ。\n連行のために縄を引っ張られるのですが、首輪ではなく普通の縄で首縄を付けられ、それを引っ張られる形でお願いします。\n②緊縛、正座状態で処刑人に首を切られる直前の蛍ちゃん\n構図は全員の少し斜め前から、状態の参考URL\nhttps://skeb.jp/@aocooler/works/672\n\n\n○希望の差分\n1.②の処刑後の差分\n2.布で目隠し\n3.ビットギャグ猿轡\n\n詳細はお任せします、自由に調整してください。\n金額が足りない場合、条件付き再送要請をお送りいただけますと幸いです。\nご検討のほどよろしくお願いします。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uchicoonigiri/works/490", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9441cfc3/uploads/origins/760058d4-3956-42ac-ad6c-3c04b0ec1cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f6324cd677566704e513144f3288fdc8", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1026650, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 162, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@uchicoonigiri/works/489", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6b14b1b9/uploads/origins/aee856b7-3766-40bb-861d-ceec757282f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE