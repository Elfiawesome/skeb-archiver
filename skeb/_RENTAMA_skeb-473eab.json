p&crop=top&w=200&h=200&blur=200&s=8afe341ef654bd7f83ec4aae2b07a4c0 3x"}, "body": "れんたまさん、お疲れ様です。\n「わんだふるぷりきゅあ！」の猫屋敷まゆと猫屋敷ユキ(猫態)のイラストをお願いします。\nタイトルは「2人で過ごすリフレッシュタイム」です！\nシチュエーションとしては、「まゆの部屋で椅子に腰掛けながら、ユキを膝枕して頭を撫でているシーン」です！\nまゆの衣装はいつもの私服(わんだふるぷりきゅあ公式サイトを参照)で、ユキはまゆに撫でられて目を閉じて気持ちよさそうにしていて、まゆはユキの頭を撫でながらにっこりと微笑んでいる感じでお願いします。\n\n猫組の日常のワンシーンをれんたまさんのタッチで描いてみてください！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_RENTAMA_skeb/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1211589, "client_id": 2786538, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/990f7530/uploads/origins/d69e662b-77e0-4f7a-9629-4964c824a38f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aedcd0ba7e20700c1b0a6968c0093118", "srcset": "https://si.imgix.net/990f7530/uploads/origins/d69e662b-77e0-4f7a-9629-4964c824a38f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aedcd0ba7e20700c1b0a6968c0093118, https://si.imgix.net/990f7530/uploads/origins/d69e662b-77e0-4f7a-9629-4964c824a38f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91f6aba12f6c4539bf718ba371946b6c 2x, https://si.imgix.net/990f7530/uploads/origins/d69e662b-77e0-4f7a-9629-4964c824a38f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9bfbf617949e9343ee65e18eab826fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/990f7530/uploads/origins/d69e662b-77e0-4f7a-9629-4964c824a38f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e2f46bbbb5f119de384a2c53d8816b8", "srcset": "https://si.imgix.net/990f7530/uploads/origins/d69e662b-77e0-4f7a-9629-4964c824a38f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e2f46bbbb5f119de384a2c53d8816b8, https://si.imgix.net/990f7530/uploads/origins/d69e662b-77e0-4f7a-9629-4964c824a38f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a6ab281aa2bf1ffab3bbdaafbde7b6a9 2x, https://si.imgix.net/990f7530/uploads/origins/d69e662b-77e0-4f7a-9629-4964c824a38f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b930013df4919db6cbdb990d26bb7648 3x"}, "body": "はじめまして\nとってもかわいくてステキなライブステージイラストを拝見してたどり着きました\n\nファンアートのリクエストになります\n\n描いて欲しい人\n配信者の「めいん」様（https://twitter.com/lssbq）\n\n参考図\nhttps://pbs.twimg.com/media/F_Tp8sNboAAVPW9?format=jpg&name=large\nhttps://pbs.twimg.com/media/F-LDr5ibcAALChm?format=jpg&name=large\n\n要望\n・サブカル系学園祭ライブステージなコンカフェアイドル衣装の姿をお願いします\n・顔はかわいくやさしいアイドルスマイルでおねがいします\n・可能ならウィンクとか手でハート希望ですがお任せします\n・不足、不明な箇所のデザイン含め、ポーズ、構図、背景等全てお任せいたします\n・可能なら「人物だけの背景透過」も頂けると幸いです\n・イラストは彼女のSNS、配信活動、メンバーシップ活動、特典等で使う許可をお願いします\n・依頼者私が個人的用途に使用する許可をお願いします\n\nここまで読んでいただきありがとうございました\nどうぞご検討よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_RENTAMA_skeb/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1211589, "client_id": 2797404, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/10ca2c35/uploads/origins/fd611869-a3a8-4ecd-bba1-f783a89e4878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a0aac56635a6d33f94133712a287730", "srcset": "https://si.imgix.net/10ca2c35/uploads/origins/fd611869-a3a8-4ecd-bba1-f783a89e4878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a0aac56635a6d33f94133712a287730, https://si.imgix.net/10ca2c35/uploads/origins/fd611869-a3a8-4ecd-bba1-f783a89e4878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b52f4ed843f3d5fcb94319944dd3ae9 2x, https://si.imgix.net/10ca2c35/uploads/origins/fd611869-a3a8-4ecd-bba1-f783a89e4878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58cc6e1257b9907875ecf205b51044cb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10ca2c35/uploads/origins/fd611869-a3a8-4ecd-bba1-f783a89e4878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2560db9a7a24f24f30c719648819657", "srcset": "https://si.imgix.net/10ca2c35/uploads/origins/fd611869-a3a8-4ecd-bba1-f783a89e4878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2560db9a7a24f24f30c719648819657, https://si.imgix.net/10ca2c35/uploads/origins/fd611869-a3a8-4ecd-bba1-f783a89e4878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b394cecfacfc7662bc3a2bae65671f4c 2x, https://si.imgix.net/10ca2c35/uploads/origins/fd611869-a3a8-4ecd-bba1-f783a89e4878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3fd536f10ec93af5429eb12a028ea389 3x"}, "body": "Hello, my name is Remi and I'm a vtuber who streams video games! I'm a pink cyberpunk rabbit who is playful and cute and mischievous. \n\nI hope you can draw my character in your art style! I'll leave the outfit, pose, and background up to you.\n\nhttps://remivespertine.carrd.co/", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_RENTAMA_skeb/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1211589, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03d38fe7/uploads/origins/94261dc1-5a62-4cef-8cab-30089aa567c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89bedea82d004b35e5c31a5b93a8a41a", "srcset": "https://si.imgix.net/03d38fe7/uploads/origins/94261dc1-5a62-4cef-8cab-30089aa567c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89bedea82d004b35e5c31a5b93a8a41a, https://si.imgix.net/03d38fe7/uploads/origins/94261dc1-5a62-4ce