507-9430-9adabdd3074f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18fd0f29d0dc3f95c9070b34699fbecd", "srcset": "https://si.imgix.net/2aaa6dae/uploads/origins/9f46421e-5062-4507-9430-9adabdd3074f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18fd0f29d0dc3f95c9070b34699fbecd, https://si.imgix.net/2aaa6dae/uploads/origins/9f46421e-5062-4507-9430-9adabdd3074f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6570b3ef6dc03381b6e183ba727fe002 2x, https://si.imgix.net/2aaa6dae/uploads/origins/9f46421e-5062-4507-9430-9adabdd3074f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2486f3a9e001340dfd514a72ed3e4337 3x"}, "body": "はじめまして\n花屋の息子楽しく読ませていただきました\nよかったらその登場キャラ達で\nへそフェチなのでへそに関連したイラストをリクエストしたいです\n\nキャラ\n菜央人くん\n駿介くん\n\n腰から上描写で顔とへそをなるべく大きく表現してほしいです\n\n主な内容\n授業でへその授業がありお互いのへその形の違いについて話す\nそれぞれのへそ比べや自分のへそについて思っていることを話す\n\nそれぞれのキャラのへそ特徴\n菜央人　女性っぽいきれいなへそ　自分では女性っぽいへそだと思っていない　むしろ縦長なへそオーソドックスで気に入っている\n駿介　　ぷっくり子供でべそ気味　でべそだと思っておりそれが自慢\n豆があって人に面白がって弄られること多い　チャームポイントだと思っている\n\n・自分のへそについて思っていること\n・相手のへそについての印象\n・その他\n\n作者様のキャラなので上記は可能な範囲で入れてもらえれば結構です\n彼らのセリフにへそやでべそ発言多めだとうれしいです\nアドリブ大歓迎です\nよろしくお願いします", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jmaru_torafish/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3421216, "client_id": 1481570, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb183480/uploads/origins/71e04bd8-3beb-4f51-bc7a-cb6d863f475f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f9fb2ae889075140c078a0765b00cc4", "srcset": "https://si.imgix.net/eb183480/uploads/origins/71e04bd8-3beb-4f51-bc7a-cb6d863f475f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f9fb2ae889075140c078a0765b00cc4, https://si.imgix.net/eb183480/uploads/origins/71e04bd8-3beb-4f51-bc7a-cb6d863f475f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74b90542a715be15f793e7e9a7a871b6 2x, https://si.imgix.net/eb183480/uploads/origins/71e04bd8-3beb-4f51-bc7a-cb6d863f475f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=935dbb324f3dd3cb51f60557f2562d29 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb183480/uploads/origins/71e04bd8-3beb-4f51-bc7a-cb6d863f475f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b82f08def3f510f05935e93e8040934", "srcset": "https://si.imgix.net/eb183480/uploads/origins/71e04bd8-3beb-4f51-bc7a-cb6d863f475f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b82f08def3f510f05935e93e8040934, https://si.imgix.net/eb183480/uploads/origins/71e04bd8-3beb-4f51-bc7a-cb6d863f475f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1905de9e19523e642b6fc115a61be05c 2x, https://si.imgix.net/eb183480/uploads/origins/71e04bd8-3beb-4f51-bc7a-cb6d863f475f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=38997eeab3322571f0469f9ad8145d12 3x"}, "body": "ジョゼまるさん\n\nお疲れ様です。彩春と申します。\n私はあなたの絵柄やイラストが本当に好きです。ジョゼまるさんの描かれる表情豊かな少年たちにいつも癒され、元気をもらっています。心から応援しています。\n是非ジョゼまるさんに、私の創作キャラを描いていただきたく、この度リクエストを送らせていただきました。\n\nキャラクターのデザインや詳細は資料URLを参考にしていただけますと幸いです。\n\n【大まかな要素】\n・12歳の少年\n・青い瞳、若干タレ目がち\n・艶のある黒髪、前髪の一部がぱっつん\n\nこのキャラクターをジョゼまるさんの好きなように、自由に描いていただけると嬉しいです。\n※ただ、服装は半袖の方でお願いいたします。\n\nリクエストが受け難い内容でしたら、キャンセルしていただいて構いません。\nまた、ジョゼまるさんのペースでゆっくり描いて頂けますと幸いです。\n\nまだ告知等されていない中、リクエストを送ってしまい申し訳ございません。\n活動を心より応援しております。\nよろしくお願いいたします。\n\n彩春\n\nhttps://drive.google.com/drive/folders/1CoW5RGz_-5uG9Yz1xdkspTkeD2m6xQCz", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 2725, "creator": true, "nsfw_