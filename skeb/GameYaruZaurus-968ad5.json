好きな絵を描いてください。屋台を歩きながらタンフルなどの中華菓子を食べたり、ベランダでランタンを見ていたりするかもしれない。あくまでも提案ですが、自由に描いてください。手と顔の描き分けが好きなので、両方入れてほしいです。\nご検討の程、宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1nDuEn_XZuy4kJ9tAbIopg2c7TveUcI5j?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@GameYaruZaurus/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0be2e0c2/uploads/origins/64824845-7b49-4dc5-9a66-cedaf10ab9b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44bc795da5af93280f767492a9e3aaed", "srcset": "https://si.imgix.net/0be2e0c2/uploads/origins/64824845-7b49-4dc5-9a66-cedaf10ab9b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44bc795da5af93280f767492a9e3aaed, https://si.imgix.net/0be2e0c2/uploads/origins/64824845-7b49-4dc5-9a66-cedaf10ab9b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5103d14dc6252b9e7f80b8247fcb0a4b 2x, https://si.imgix.net/0be2e0c2/uploads/origins/64824845-7b49-4dc5-9a66-cedaf10ab9b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e278801ddb3e9e761b5a42bbcdceb75e 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1281453, "nc": 128}, {"path": "/@GameYaruZaurus/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1281453, "client_id": 1377136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c9c0785/uploads/origins/9142b799-788e-4d2e-ac69-6fe625b467e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=t