FFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=06070978b8510a6a98f17d9a2638df99", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 939346, "client_id": 562518, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shizu_summer/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 939346, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc7406fb/uploads/origins/5693e62f-3854-4f8d-b5c4-4c043d4bbd55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69eacea7d6244945cddeffc255864b04", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc7406fb/uploads/origins/5693e62f-3854-4f8d-b5c4-4c043d4bbd55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7855f34768930ff7a2042a1bdbac628c", "src_set": ""}, "body": "静夏さんの描かれるウルトラ艦娘が素晴らしかったのでリクエストさせてください。\nウルトラ艦娘になった高雄（艦これ）をお願いします。\n\n他のウルトラ艦娘に負けないくらいの爆乳巨乳輪ムチムチボディで、「https://www.pixiv.net/artworks/99301469」の３枚目・４枚目のような全身表示の立ち絵をお願いします。\n\n金額的に可能であれば、「https://shizuka.fanbox.cc/posts/6075041」のような、侵略兵器化した姿もお願いします。\n\n今回の作品については、個人鑑賞以外に他のクリエイター様へのリクエストにも利用させていただく予定です。\n\nご一考をお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shizu_summer/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/78df6d2f/uploads/origins/95ffac65-0cb5-4a89-9ced-e6667bf650bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b460e168f2e52c73c4e30a0536061ab", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 939346, "client_id": 562518, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shizu_summer/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 939346, "client_id": 1366155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cef2d2b4/uploads/origins/ad8de4f8-f287-472d-90f8-a3076b77d3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ce13b7aa62cc6d55f5fdee58113a6bf", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cef2d2b4/uploads/origins/ad8de4f8-f287-472d-90f8-a3076b77d3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1347a21580ef54efebaa73cb6245666e", "src_set": ""}, "body": "魔法カード《洗脳ーブレインコントロール》で変態洗脳され、淫語連発応援付きバイブ咥え込みガニ股腰ヘコデカパイ揺らしで自分の持ち主であるマスター(竿役)のオナサポをしてくれる遊戯王のRAI-MEIをリクエストします。\n\n1枚目：カードを見せられ洗脳されるシーン。ガニ股立ちで手前の方にカードを持つ竿役の手がある。\n\n2枚目：乳揺らし前。バイブが挿入される。少しニヤついた表情でオナニーを促してくる\n\n3枚目：腰を前後を振り乳揺らし中。眼前のチンポに夢中といった様子で一枚目から更に崩れ恍惚とした表情になり、淫語を羅列した応援をしてくる\n\n4枚目：精液を胸にぶっかけられ、その弾みとバイブによる刺激で絶頂する。大きく白目を剥いたキツめのアへ顔で濁点混じりの汚いアへオホ声を絶叫する。\n\n…といった4シーンの差分をお願いします。視点は竿役の一人称視点で正面寄りから見た姿を膝下まで写して欲しいです。竿役と書きましたが一枚目の手以外は男性の体や男性器は写さず、RAI-MEI単体で大丈夫です。\n\n服装はカードのイラストと同じ物をベースに1枚目のみ完全着衣、2枚目以降は股間と胸部先端がハート型に切り取られ、バイブ挿入及びパフィーニップル気味で大きめサイズの乳首と乳輪が完全に露出している状態でお願いします。\n\n乳のサイズは頭より大きく臍の少し上まで届き服のデザインが隠れすぎない位の大きさで、全体のバランスは｢ウルトラの加賀｣位の頭身でお願いします。\n\nまた、それぞれの状況に合わせたRAI-MEIのセリフを付けて下さい。キャラの性格は静夏さんの想像したお好きなイメージで、とにかく下品な内容で画面を埋めて欲しいです。\n\nかなり細かい注文が多くなってしまい申し訳ありませんが何卒よろしくお願い致します。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shizu_summer/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 939346, "client_id": 182552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0c05189/uploads/origins/3d54af13-7a44-4a99-aa09-2d4854a5f83e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a02a7727439e8d0b295b3d2a7db83108", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0c05189/uploads/origins/3d54af13-7a44-4a99-aa09-2d4854a5f83e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0686397c051d2036ce3875f76c3ddb44", "src_set": ""}, "body": "こんにちは。\nリクエスト再送させていただきます。\n\n『Z/X』に登場するリゲルと各務原あづみのハイグレ化をお願いします。\n\n設定としては、科学が発展した青の世界がハイグレ星人より提供された技術で２人をハイグレ化＆洗脳。\nリゲルは巨大ハイグレ人間へ生まれ変わり、あづみは巨乳に改造され、リゲルに首輪として付けられたアヒル型のコックピットに搭乗。コックピット内の円形ステージ上であづみがハイグレのポーズを取り続ける事でリゲルに信号が送られ、操縦出来る様になっている。また、あづみの両胸には搾乳機が付けられ、リゲルの動力源となる母乳を供給している。\nまた、２人共URL先のリゲルのスーツに似た白のハイグレを着ています。\n\n上記を踏まえ、下記のシチュエーションとセリフをお願いします。\n①リゲルとあづみが町中で仲良くハイグレのポーズを取っている。\n　あづみ「リゲル。今日も良いハイグレ日和だね。」\n　リゲル「ええ、そうね。こうしてあづみと心身共にしてハイグレをする今が一番幸せだわ。\n　　　　　青の世界とハイグレ技術を提供してくれたハイグレ星人には感謝しなくちゃね。」\n　あづみ「うん！」\n②２人が敵の軍勢を確認。ハイグレポーズのまま真剣な表情になる。\n　リゲル「っ！？あづみ！敵の軍勢を捉えたわ！」\n　あづみ「他の世界からの侵略！？リゲル！迎撃準備！」\n③リゲルが乳首を勃起させて迎撃の準備をする。\n　リゲル「了解！乳首勃起！あづみ！沢山のハイグレ信号と母乳を私に送って！」\n　あづみ「任せて！」\n④あづみが一生懸命ハイグレの信号を送り、搾乳機から溢れる位母乳を絞られる。\n　そして、リゲルの乳首から母乳が滝の様に噴出し、敵軍を押し流す。\n　あづみ「ハイグレ！ハイグレ！ハイグレ！ハイグレ！」\n　リゲル「エネルギー充填完了！くらいなさい！ハイグレミルクボンバー！」\n⑤敵軍を無事撃破。体が母乳まみれになりながらも喜ぶ２人。\n　リゲル「敵軍撃破確認！大丈夫あづみ！？無茶なハイグレさせちゃったけど……。」\n　あづみ「ううん、何ともないよ！寧ろもっとハイグレしたい！リゲル！また一緒にハイグレしよ！」\n　リゲル「……！えぇ、そうね！」\n　２人「「ハイグレ！ハイグレ！」」\n\n全部が厳しい場合は②と③を統一し、⑤を削除して結構です。\n\n以上、要望がかなり多いですが、検討頂けると幸いです。\n\nhttps://www.zxtcg.com/reunion/char/", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shizu_summer/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dfe769b7/uploads/origins/1ca221a6-9339-437f-af6c-61426a1eadcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=20