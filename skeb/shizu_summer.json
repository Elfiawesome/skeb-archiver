200&s=a3ebdef857e8f7b17e4251f8177cb9e7", "src_set": ""}, "body": "前回のウルトラの港湾棲姫のご依頼を受けてくださりありがとうございます!素晴らしかったので再びリクエストさせてください！\n\nウルトラ艦娘になった港湾水鬼で胸はウルトラの港湾棲姫よりも大きく（太ももは見える範囲）乳輪は港湾棲姫より大きめで乳首は常時勃起していてイメージは加賀の様な乳首から更に大きくなる形で、全身立ち絵でお願いします見た目のイメージはウルトラの港湾棲姫とURLのベリアルアトロシアスを参考にお願いします。\n\n金額的に可能でしたら2枚目はカラータイマーの色が赤色で乳首からエネルギー噴出。\n３枚目は乳首が完全に勃起した様子でカラータイマーの色をピンクにしてください。\nご一考の程お願いします。\n\nhttps://m-78.jp/news/post-4693", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shizu_summer/works/32", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/453f35a1/uploads/origins/8dc3a65b-fff9-4f28-9730-8d1cb5c6ed33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d57519a580b921c673f37de15ab9c973", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 939346, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shizu_summer/works/31", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/23c7e79c/uploads/origins/5fdf08d0-5a44-489b-88f9-10f854e26800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=799e0be2b6e4689336b053b6ef5ee310", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 939346, "client_id": 562518, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shizu_summer/works/30", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 939346, "client_id": 882055, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c59aed57/uploads/origins/3c821d4a-4b85-4395-ab2e-a39a61e00b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d5a33890374b16a6ed507bbbf608f41", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c59aed57/uploads/origins/3c821d4a-4b85-4395-ab2e-a39a61e00b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5bd23eca7b926a961d704be65a165f86", "src_set": ""}, "body": "初めて依頼させていただきます。静夏さんの描かれるウルトラ艦娘が素晴らしかったのでリクエストさせてください。\nウルトラヒロインになった港湾棲姫(艦これ)をお願いします。\n\nウルトラ艦娘に負けないムチムチボディで他のウルトラ艦娘を超える爆乳で乳輪は加賀と同じかそれより少し大きめで乳首は完全に陥没していて全身立ち絵でお願いします見た目のイメージはウルトラマンベリアルを参考にお願いします。\n\n金額的に可能でしたら2枚目は乳首が顔を出しているカラータイマーの色が赤色。\n３枚目は乳首が完全に勃起した様子でカラータイマーの色をピンクにしてください。\n今回の作品については、個人鑑賞以外に他のクリエイター様へのリクエストにも利用させていただく予定です。\nご一考の程お願いします。\n\nhttps://m-78.jp/geed/belial/", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shizu_summer/works/29", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/42fbb67f/uploads/origins/2dcf78d9-8f21-4f61-86bd-c2a4603d6cf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b045bd14b558241eba1de70d2f10e6db", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 939346, "client_id": 406140, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shizu_summer/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 939346, "client_id": 1366155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d8e330e/uploads/origins/99275504-c88b-4aa5-a4ba-b03fff769b8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=995b0dff29b0a5a073833c0c72422ff4", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d8e330e/uploads/origins/99275504-c88b-4aa5-a4ba-b03fff769b8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7378f5d5b79a8c528d1895b5e73b1265", "src_set": ""}, "body": "遊戯王のRAI-MEIとトリックスター・ノーブルエンジェルのフタナリレズセックスをリクエストさせて頂きます\n\n受け:RAI-MEI。生えてない。全身むちむちで乳のサイズは頭より大きく上半身を目一杯覆い、股間がギリギリ見えるくらいの超乳(可能な限り盛って下さい)。ツインテールは腰に届く位の長さ。\n\n竿役:ノーブルエンジェル。RAI-MEIと同様の体型かつ腹ボコ出来そうなサイズの巨根付。\n\n服装は2人とも元のカードのイラストで着ている物で、RAI-MEIは股間が♡型の穴空きで露出勃起した乳首と盛り上がった乳輪が布越しにくっきり浮かび上がっており、ノーブルエンジェルは陰茎がスカートを持ち上げて露出した状態です。体位はRAI-MEIの正面が良く見えるアングルでの正常位で、ノーブルエンジェルの様子はバストアップのワイプをRAI-MEIの横に別枠で写すようお願いします。\n\n挿入前。ノーブルエンジェルが挿入を焦らし、RAI-MEIがそれに対し完全に堕ちきった様子で媚びながら挿入を懇願する。\n↓\n挿入時。ノーブルエンジェルがSッ気のある表情で一気に挿入し、RAI-MEIはその衝撃で間抜けな叫び声を上げ即堕ちアへ顔アクメを晒す。\n↓\n挿入後。激しくピストンしながら二人とも軽めのアへ顔でオホ声混じりの淫語を連発しよがっている。\n↓\n膣内射精&絶頂。二人とも汚い口調で淫語を絶叫しながらイき、白目を剥いたここ一番の変顔に片足突っ込んだアへ顔になる。\n｢トリックスタートークン｣型の精子が卵子に受精するカットインあり。\n\n…という流れで、それぞれに二人のセリフを付けて頂きたいです。キャラの性格や口調はRAI-MEIがくっ殺の似合う隠れマゾなお姉さん系、ノーブルエンジェルはドSでオラつきながらも言葉遣いが上品で、バブみを感じさせるお姉さんといったイメージです。\n\n細かく指定してしまいましたが何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shizu_summer/works/27", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/987ef640/uploads/origins/c3629502-3a60-4c25-9725-d2707adb6d6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f4b71a458fa5fc565f2cbd6519e127b", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 93