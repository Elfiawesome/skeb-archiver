0&h=200&blur=200&s=3b961827f95ff97b83c3cd553d5aa831 3x"}, "body": "はじめまして！\n突然のリクエスト失礼いたします。\n\n実は以前、春瀬めいお様のキャラクターをSKIMAにてご購入させていただいたのですが、現在、アイドルになっていただいています。\n是非、イラストを描いていただければと思いましてご連絡させていただきました。\n\n希望するシチュエーションとしては、アイドル衣装をデザインしていただき、ライブをしている様子か、レッスンに打ち込んでいる様子を描いていただけないでしょうか。\n\n細かい構図等についてはお任せいたします。\n\n資料についてはリンク先をご参照ください。\n全体的に設定が不足しているのは重々承知しており、難しい依頼であるかと思いますが、ぜひご検討の程よろしくお願いいたします。\n\nhttps://www4.hp-ez.com/hp/yuki-orichara/page24", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haruse_meio/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 109477, "client_id": 108254, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc90890a/uploads/origins/21574fff-ef0a-4bb3-b2bc-719ef76c0d47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba9add60c3b10d2e65110fab5143af1c", "srcset": "https://si.imgix.net/dc90890a/uploads/origins/21574fff-ef0a-4bb3-b2bc-719ef76c0d47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba9add60c3b10d2e65110fab5143af1c, https://si.imgix.net/dc90890a/uploads/origins/21574fff-ef0a-4bb3-b2bc-719ef76c0d47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ed6c61bb1bd9b6931c9d862ef4788e9 2x, https://si.imgix.net/dc90890a/uploads/origins/21574fff-ef0a-4bb3-b2bc-719ef76c0d47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3bcc5a00170e19543eec14070b5bd2c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc90890a/uploads/origins/21574fff-ef0a-4bb3-b2bc-719ef76c0d47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7957cead617c41e93821f1590df45df3", "srcset": "https://si.imgix.net/dc90890a/uploads/origins/21574fff-ef0a-4bb3-b2bc-719ef76c0d47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7957cead617c41e93821f1590df45df3, https://si.imgix.net/dc90890a/uploads/origins/21574fff-ef0a-4bb3-b2bc-719ef76c0d47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28adda8f9c765e00d6ff06a025803491 2x, https://si.imgix.net/dc90890a/uploads/origins/21574fff-ef0a-4bb3-b2bc-719ef76c0d47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c688864508e6ec32c2ea47ce6b2235fb 3x"}, "body": "春瀬さん前にお世話になりました！\n小説のネタがやっと浮かんできたのでまたリクエスト致します……\n前にリクエストした\nhttps://skeb.jp/@haruse_meio/works/4\nの続きをまたお願いしたいです！\n\n内容としては\n①⬆のTSした悪堕ち魔法少女っ子、「女の子の気持ちよさを教えてあげる！」と言った形で道端にいる男性(気弱で真面目そうな感じ)に魔法をかける(かけられた男性は胸とおしりが一気に膨らんでいる感じで)\n②魔法をかけられた男性、https://imgur.com/FwpHEsBのような青髪ロングで胸が大きい清楚系美少女にTSさせられる。格好はオタサーの姫が着てそうで胸を強調した服で。ポーズはお任せします。\n③これがメインで、魔法の効果で欲情してしまったTSっ子は、服をはだけて胸を露出させて自分の胸と下腹部を手で弄りながら快感に浸っている…\n\nと言ったような感じでお願いします。\n\n無理でしたら全然理ってしまって大丈夫なので……\n是非宜しくお願い致します！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haruse_meio/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 109477, "client_id": 108254, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d59ae576/requests/169898_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baa01b0465fce4339c7a0c7aedb2dc17", "srcset": "https://si.imgix.net/d59ae576/requests/169898_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baa01b0465fce4339c7a0c7aedb2dc17, https://si.imgix.net/d59ae576/requests/169898_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee07b85a23c97aa8b1ce87dc9bb0819c 2x, https://si.imgix.net/d59ae576/requests/169898_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2924f304cbe98fb6d77d8909673859c1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d59ae576/requests/169898_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=052b80f786076852e340ab25ecae6c2c", "srcset": "https://si.imgix.net/d59ae576/requests/169898_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=052b80f786076852e340ab25ecae6c2c, https://si.imgix.net/d59ae576/requests/169898_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=87228c71e311efea45e79fa95f3bb33f 2x, https://si.imgix.net/d59ae576/requests/169898_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2297304acdad196e87f3943fab0f3997 3x"}, "body": "めいおさんが前に描いてらしたTSイラストがとても素敵だったので御依頼しました！\n\n真面目そうな男子高校生が悪のセクシーな魔法少女になってしまった！？といった形のTSFのイラストをお願いしたいです！！\nこのように3段階に分けてイラスト化とセリフをつけてくだされば幸いです。\n\n【1】\n・容姿は黒髪ショートで黒縁メガネ、目は緑色の真面目系な高校生の男の子\n・下が黒の長ズボンで上がワイシャツ姿、靴はローファー\n・オレンジ色の♦が着いたネックレスを持って｢なんだろう…これ…？｣と呟いている\n【2】\n・ネックレスを首元に着用している\n・胸がかなり大きく膨らみシャツをギューっと押し上げ、お尻も膨らんでズボンを押し上げている\n・髪は黒からオレンジ色に変化している最中で大きく伸びている\n・靴はローファーからハイヒールに変化\n・｢うわっ！！なんだこれ！？だんだん頭の中がなんか気持ちよく…｣と呟いている\n【3】\n・完全にTS完了。目の色はそのままで髪はオレンジ色のウェーブロングヘアに変化。\n・胸は目を見張るほどの爆乳クラスになっており、♦のペンダントを谷間に半分指で押し込んでいる\n・もう片方の手でメガネをつまんで外している\n・口紅をし、恍惚とした表情で妖艶な笑いをしている\n・靴はオレンジのハイヒールで黒の網タイツ(絶対領域)\n・それ以外の衣装とカラーリングはURLの右のイラストを参考にしてください。(左のイラストは私が別件でskebに依頼した正義側のものです。左のイラストに比べエナメル質な感じでよろしくお願いします。頭のリボンはダイヤの飾りに変更、胸元のリボンは不要です。)\n・｢あはっ♡今から”イイ”こと始めちゃおうかなぁ…♡｣と呟いている\n\n長々となってしまいましたが、受けてくだされば幸いです！よろしくお願いいたします！\n\nhttp://imgur.com/gallery/9NSV6dV", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haruse_meio/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 109477, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/757c8506/requests/159251_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3134d105a83bcf315cff19b0f4b03230", "srcset": "https://si.imgix.net/757c8506/requests/159251_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3134d105a83bcf315cff19b0f4b03230, https://si.imgix.net/757c8506/requests/159251_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2dd216c1f951374d790230841e83723 2x, https://si.imgix.net/757c8506/requests/159251_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b816ae1f8fd36385bdb3fee4fd62107 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/757c8506/requests/159251_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62179af6a2ed5a290b04d6a127081012", "srcset": "https://si.imgix.net/757c8506/requests/159251_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62179af6a2ed5a290b04d6a127081012, https://si.imgix.net/757c8506/requests/159251_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=19028c988d7ea638582d0dee2283db83 2x, https://si.imgix.net/757c8506/requests/159251_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b89c6f7492cb756765f92c07cf62f1a5 3x"}, "body": "童話ヘンゼルとグレーテルで、\n13歳のヘンゼルが牢に囚われた後、グレーテルが魔女にメイド(体格に合わせて大きさが変わる魔法のメイド服着用)にされる。\n→魔女に密かに飲まされた薬で7日かけて、グレーテルが9歳の少女から18歳の童顔爆乳な美しい娘に急成長させられる。\n→ヘンゼルの計略で魔女を倒した後、魔女に植え付けられた魔法の知識で善い魔女として自活しながらヘンゼルを養うグレーテル。\n\nこのシチュを基にした以下のイラストをお願いします。\n\n前回の3コマ急成長シーンイラストの構図を基に\n1コマ目：お菓子の家を見つけた時のヘンゼルとグレーテル\n2コマ目：グレーテルの胸が膨らんで急成長している様子＆薬による7日間の急成長が終わって18歳となり、きょとんとしながら大きくなった胸に手をあててるグレーテル\n3コマ目：ヘンゼルの頭に爆乳を乗せて背後から彼を愛おしそうに抱くグレーテル\n\n兄妹共に金髪碧眼、ヘンゼルのデザインはお任せで、\n1コマ目の9歳グレーテルの髪型はふわふわなロングヘア、服装はお任せ\n2コマ目、3コマ目の18歳グレーテルの髪型は1コマ目のロングヘアを\nhttps://www.pixiv.net/artworks/69348432 のように後ろに結って纏めたショートヘア、\n服装は https://www.pixiv.net/artworks/49015886 を基に、緑色の部分を黒色に、\n袖は長袖にしてスカートの丈も少し伸ばしたおっぱい強調スタイルのメイド服でお願いします。\n\n\n初見で不躾ながら濃い内容のリクエストで申し訳ありませんが、\n前回の兄妹のうち妹が急成長して兄より年上になる3コマイラストを拝見させていただき感銘を受けて、今回リクエストさせていただきました。\n