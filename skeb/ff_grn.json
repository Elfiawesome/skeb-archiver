ような一族の顔のマークです。よろしければ、この作品は上半身または半身のどちらかで描くことをお勧めします。私のリクエストを見ていただきありがとうございます。感謝します！\n\nhttps://imgur.com/a/0jwOWHw", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ff_grn/works/82", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/705aa8a4/uploads/origins/733a428a-2a9e-48d7-ae58-9ce59c83724d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0d6e3cf63b53488b190b1ad9a880933", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2694706, "client_id": 3428025, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ff_grn/works/81", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2694706, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f70161ba/uploads/origins/8a47afac-cc12-4e42-896f-88ee11721b52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9355e9c15b5a47c7a1e3d8e31479ce4b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f70161ba/uploads/origins/8a47afac-cc12-4e42-896f-88ee11721b52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d66c62bb05c9a988698f9c3c4ffd2c99", "src_set": ""}, "body": "初めまして！今回、ひじき先生のff14の絵柄で自キャラを書いていただきたくリクエストさせていただきました！\nこうしてイラストを依頼することは初めてのため、至らない点や失礼があった場合は申し訳ないです。\nイラストはポストの一枚目のような雰囲気で書いていただけると嬉しいです！わがままをいってしまうと２枚目の画像よりも柔らかく微笑んでいるような表情にしてもらえると助かります…\n使用用途についてはXやdiscordのアイコンとして使用したいと考えています！\n\nお忙しいなか恐れ入りますが、よろしくお願いいたします!\n\nhttps://x.com/uid_bz/status/1868606926197780530\n\nhttps://x.com/uid_bz/status/1868606926197780