かしらの形で表記します)\n\n┃備考\n資料URLに舞台衣装の立ち絵と私服立ち絵の2種類を添付しておりますが描きやすい方で描いて頂けたらと…！\n\nポーズやシュチュエーション、画像サイズなども全てお任せしますのでむたさんの好きなように描いて頂けたら非常に嬉しく思います(資料で分かりづらい部分などはアレンジ/省略をしていただいて大丈夫です)\n内容が合わない、金額が足りない場合はお手数おかけしますがキャンセルか再申請依頼をお願いします。\nお忙しい中だと思いますが何卒ご検討宜しくお願い致します…！\n\nhttps://www.dropbox.com/scl/fo/qf28uq695qkxu92w558x4/h?rlkey=6ol0vpcb6k2h5e8miq85ro9ba&st=x9o6hovm&dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@muta_2222/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3350934, "client_id": 3322126, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9db4b6a/uploads/origins/a5c32ec6-09c5-4354-a8d3-485c8fdf36e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ace603c503788b77cb38f839c80688f4", "srcset": "https://si.imgix.net/e9db4b6a/uploads/origins/a5c32ec6-09c5-4354-a8d3-485c8fdf36e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ace603c503788b77cb38f839c80688f4, https://si.imgix.net/e9db4b6a/uploads/origins/a5c32ec6-09c5-4354-a8d3-485c8fdf36e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=647d00d0e9aa056287153a3ca0624782 2x, https://si.imgix.net/e9db4b6a/uploads/origins/a5c32ec6-09c5-4354-a8d3-485c8fdf36e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abe44fc8c06ee4400445ea75fc1e2c14 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9db4b6a/uploads/origins/a5c32ec6-09c5-4354-a8d3-485c8fdf36e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=425643a75e882f7f05a50e272051e881", "srcset": "https://si.imgix.net/e9db4b6a/uploads/origins/a5c32ec6-09c5-4354-a8d3-485c8fdf36e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=425643a75e882f7f05a50e272051e881, https://si.imgix.net/e9db4b6a/uplo