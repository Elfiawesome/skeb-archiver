透珀より少し濃いです。ピアスはいくつも着けていますが、右耳に透珀と揃いの黒いピアスをつけており、それだけは贈られた日から変えたことがありません。\n・服装にはこだわりがなく、休日でも無難なロンTにパーカー、スラックスの日が殆どです。\n・その他　外では煙草を吸います。部屋の中では吸いません。\n〇ニールは独占欲が強いので、タキシードで男性らしく身なりを整えた透珀のことも、「自分のもの」とばかりに腰を抱いています。周囲への牽制であり、見せつけです。\n\n何卒、よろしくお願いいたします…！！\n\nhttps://drive.google.com/drive/folders/1U5EKp24agpnNmx5b00FMn8VV9SxeViw0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@momomo__shi348/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2529439, "client_id": 1134507, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d52001ff/uploads/origins/9a6ea3c6-dff0-407e-9dc7-7ba158c31047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d39fb2f639ca8b8fdd57412b24ce501", "srcset": "https://si.imgix.net/d52001ff/uploads/origins/9a6ea3c6-dff0-407e-9dc7-7ba158c31047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d39fb2f639ca8b8fdd57412b24ce501, https://si.imgix.net/d52001ff/uploads/origins/9a6ea3c6-dff0-407e-9dc7-7ba158c31047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=817a0a2d6a321c413c70bb971105cb9b 2x, https://si.imgix.net/d52001ff/uploads/origins/9a6ea3c6-dff0-407e-9dc7-7ba158c31047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0531966833960532ff260a2443398506 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d52001ff/uploads/origins/9a6ea3c6-dff0-407e-9dc7-7ba158c31047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb42fdcc428d062d7be8c1fa473d43c8", "srcset": "https://si.imgix.net/d52001ff/uploads/origins/9a6ea3c6-dff0-407e-9dc7-7ba158c31047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb42fdcc428d062d7be8c1fa473d43c8, https://si.imgix.net/d52001ff/uploads/origins/9a6ea3c6-dff0-407e-9d