f76225ab-e342-4d81-b565-64f318e8f6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd62ae599813355c4876d3be5259b614", "srcset": "https://si.imgix.net/b0fe196d/uploads/origins/f76225ab-e342-4d81-b565-64f318e8f6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd62ae599813355c4876d3be5259b614, https://si.imgix.net/b0fe196d/uploads/origins/f76225ab-e342-4d81-b565-64f318e8f6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=784dee019cd9ec21680de8fb21f5f6dc 2x, https://si.imgix.net/b0fe196d/uploads/origins/f76225ab-e342-4d81-b565-64f318e8f6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b6662273dbaacda00ce619d52726d0d 3x"}, "body": "辻井ハト様\n\nはじめまして。\n綺麗な瞳の素敵なイラストに惹かれ、ぜひお願いしたくリクエストをお送りいたします。\n\n■使用用途\nYouTube（収益化済み）、SNS、FANBOXでの使用を予定しています。\n\n■納品形式\nPNGまたはPSD\n・背景と人物を分けたデータで納品いただけますと嬉しいです。\n\n■資料\n・VTuber「雨神りゅう」をお願いいたします。\n・衣装は3種類ありますので、辻井ハト様の描きやすいものをお選びいただけますと幸いです。\n・表情一覧なども同資料内にございますので、ご確認いただけますと幸いです。\n\n■お願い\n・主にサムネイルでの使用を想定しているため、肩より上が見切れない構図ですと助かります。\n・人耳はありません。\n・髪色は橙（桃）色でお願いいたします。\n\nご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1IkWiJeCVBA2NbYzY43iZTZbLgLqwQZfO?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsujihato99/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4038547, "client_id": 4065718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17722a65/uploads/origins/76c96fa0-55df-4dc1-b24e-834d91486c90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c383ae9aa1436723b723990cfc97ed16", "srcset": "https://si.imgix.net/17722a65/uploads/origins/76c96fa0-55df-4dc1-b24e-834d91486c90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c383ae9aa1436723b723990cfc97ed16, https://si.imgix.net/17722a65/uploads/origins/76c96fa0-55df-4dc1-b24e-834d91486c90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d2b67180a45b44734b6b2a6c1a97708 2x, https://si.imgix.net/17722a65/uploads/origins/76c96fa0-55df-4dc1-b24e-834d91486c90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ec33cec308eaff5c475263d188d9b38 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17722a65/uploads/origins/76c96fa0-55df-4dc1-b24e-834d91486c90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70ace87d82f3b6977ed7902cbaaf6231", "srcset": "https://si.imgix.net/17722a65/uploads/origins/76c96fa0-55df-4dc1-b24e-834d91486c90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70ace87d82f3b6977ed7902cbaaf6231, https://si.imgix.net/17722a65/uploads/origins/76c96fa0-55df-4dc1-b24e-834d91486c90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=98cf015b6074ec221976065bb52cdc9f 2x, https://si.imgix.net/17722a65/uploads/origins/76c96fa0-55df-4dc1-b24e-834d91486c90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3b5e47a8f99a6a5f217094e6696be661 3x"}, "body": "辻井ハト先生、はじめまして！\n私はVTuberを目指している者ですが、先生の素晴らしいイラストを拝見して、ぜひ依頼させていただきたいと思いました！私のキャラクターは「雌トラのレストランの娘」という設定で、以下にその詳細をご紹介します。\n\n[キャラクター設定]\nビジュアル年齢：17～18歳。\n\n性格・表情：ツンデレで、気性が激しく、守りたがる一面があるものの、すぐに動揺してしまうタイプです！伝統的な料理をけなされると過剰に防御的になり、ヒス音を立てますが、とても赤面しやすいです。想定される表情：元気いっぱい、活発、または恥ずかしそうに赤面している様子。  \n\n頭部・髪の詳細：\n・パステル調のミントブルーの長い髪をツインテールにまとめ、ピンクの結び紐とサイドの三つ編みをあしらっています。  \n・ヘアパターン／ハイライト：ダークチャコール／ブラックのアクセントストライプ（トラの縞模様のハイライト） \n・前髪：前髪には、柔らかな雲の形をしたヘアピン／クリップのモチーフが付いています。\n・動物の特徴：頭頂部に、お揃いのミント色のトラの耳。  \n\n顔のディテール：\n・柔らかなピンクがかった紫色の瞳に、ふさふさとした長いまつげ。\n・右目の真下にほくろ。  \n・左の眉毛を貫くシルバーの眉ピアス。 \n\n服装：チャコールグレーのトップスに、白いふわふわのマンダリンカラー（カエルのボタン付き）。肩にはフリルのトリムとピンクのオーバースリーブ。メニューパッドが挟まれた幅広の白いウエストサッシュ。スプーンやフォークのチャームがぶら下がったショートエプロン。 \n\n脚と足：左右非対称の脚——片方の脚にはピンクの太ももまでのソックスを1足履いている。両脚には白いフリルのついたレッグウォーマー。淡いピンクのフラットな布製シューズ。  \n\nしっぽと小道具：ふくらはぎに巻きついた太いトラのしっぽ。 チェーンについた、清潔な白い棘付きのフレイル（メイス）を手に持っています。周囲には中華料理が浮遊しています。  \n\n[依頼詳細]\n構図は16:9の横長キャンバスにしていただくと嬉しいです。表情やポーズは自由にお選びください。 可能であれば、PSD形式での納品を希望しますが、難しい場合は、背景あり・なしの両方のPNGファイルでも構いません。\n\n[使用目的・許諾]\nこのイラストを、今後SNS、サムネイル、壁紙として使用したいと考えています。\nお時間を割いてご検討いただき、誠にありがとうございます！ キャラクターデザインの参考画像を添付いたします。\n\nhttps://drive.google.com/file/d/1v0qk7-UF4S4N5k8roGSrx4cRShlPe7m1/view?usp=drivesdk", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsujihato99/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4038547, "client_id": 2513697, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/273a7e7d/uploads/origins/3d81aac8-9717-41ac-b22b-315427585aa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=032b25cbf5fe27134aa8129aed126ccb", "srcset": "https://si.imgix.net/273a7e7d/uploads/origins/3d81aac8-9717-41ac-b22b-315427585aa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=032b25cbf5fe27134aa8129aed126ccb, https://si.imgix.net/273a7e7d/uploads/origins/3d81aac8-9717-41ac-b22b-315427585aa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b288eb84608c1d40ae62658229cff463 2x, https://si.imgix.net/273a7e7d/uploads/origins/3d81aac8-9717-41ac-b22b-315427585aa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84594b9cd496071decfa146bcf6f203e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/273a7e7d/uploads/origins/3d81aac8-9717-41ac-b22b-315427585aa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9092d6a472c20a350acc36dd8bea3d4a", "srcset": "https://si.imgix.net/273a7e7d/uploads/origins/3d81aac8-9717-41ac-b22b-315427585aa3?bg=%23fff&auto=