制服を元通りに着せてあげるとその場を後にします。\n\n翌日、何があったか覚えておらず何事も無かったように教室で談笑する春菜ちゃん。男子は気絶している春菜ちゃんの写真と本人を見ながら「やっぱり可愛いな」「また楽しませてもらうよ」と呟く、といった内容でお願い致します。\n\nその他の台詞や構図などはお任せ致します。\n\n連続の性癖全開リクエストでお恥ずかしい限りですが、ご検討いただければ幸いです！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HayamaRai/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2982189, "client_id": 1309040, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d55753a/uploads/origins/3655687a-a652-472b-bcbd-b17419707120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7499ccc43597d10c990e5392a4376cb2", "srcset": "https://si.imgix.net/2d55753a/uploads/origins/3655687a-a652-472b-bcbd-b17419707120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7499ccc43597d10c990e5392a4376cb2, https://si.imgix.net/2d55753a/uploads/origins/3655687a-a652-472b-bcbd-b17419707120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47a571b870aa25f3c45c37b1f9924e80 2x, https://si.imgix.net/2d55753a/uploads/origins/3655687a-a652-472b-bcbd-b17419707120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af632aa7875af1808453fb33cc85457d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d55753a/uploads/origins/3655687a-a652-472b-bcbd-b17419707120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71eccf3e747a84f6bb66bcba7f5e8f24", "srcset": "https://si.imgix.net/2d55753a/uploads/origins/3655687a-a652-472b-bcbd-b17419707120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71eccf3e747a84f6bb66bcba7f5e8f24, https://si.imgix.net/2d55753a/uploads/origins/3655687a-a652-472b-bcbd-b17419707120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a1cd0b15fc6963c91811ce3143b5a49b 2x, https://si.imgix.net/2d55753a/uploads/origins/3655687a-a652-472b-bcbd-b17419707120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=76c893dcd7a55caa0e75bf13b1d05a5b 3x"}, "body": "お世話になります、前回の春菜ちゃん漫画めっちゃお気に入りで、隙あらば見てニヤニヤしております😆\n\n連続ですみませんが、続きをお願いできますでしょうか？\n\n気絶していた春菜ちゃんですが「う…う〜ん…ここは…？」と目を覚まします。我に返り「え？何で私こんなとこに…それに何で水着なんて着てるの…？」と慌てる春菜ちゃん。\nそこへモブ男子が「春菜ちゃん、目が覚めた？」と話しかけます。男子は「あなたは…？」と、きょとんとしている春菜ちゃんをもう一度叩き、再び気絶させます。\n\nそして男子は気絶した春菜ちゃんに咥えさせ、「気絶してるのに舌使ってくる…」「気持ちいい…」的な感じで射精する、といった感じでお願い致します。\n\n構図などはお任せ致します。台詞は変えていただいても大丈夫です。\n\n絵柄が好みでついリクエストしてしまいました。是非ご検討お願い致します！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HayamaRai/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2982189, "client_id": 1309040, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/64eb3398/uploads/origins/cddc352c-a2bc-438f-b578-2430cabb09f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a3ff7eb3780eb2a29f3033034e9161", "srcset": "https://si.imgix.net/64eb3398/uploads/origins/cddc352c-a2bc-438f-b578-2430cabb09f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a3ff7eb3780eb2a29f3033034e9161, https://si.imgix.net/64eb3398/uploads/origins/cddc352c-a2bc-438f-b578-2430cabb09f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb519c3852f4af6f8d01b1be352dfcb2 2x, https://si.imgix.net/64eb3398/uploads/origins/cddc352c-a2bc-438f-b578-2430cabb09f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=723b7d5c462b7e2181952cab7eb02b8c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/64eb3398/uploads/origins/cddc352c-a2bc-438f-b578-2430cabb09f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=888725afa786c86f8ed9fe6d668e2f92", "srcset": "https://si.imgix.net/64eb3398/uploads/origins/cddc352c-a2bc-438f-b578-2430cabb09f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=888725afa786c86f8ed9fe6d668e2f92, https://si.imgix.net/64eb3398/uploads/origins/cddc352c-a2bc-438f-b578-2430cabb09f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=845ce8d2f0c8a61a1250ce1ef30ca83b 2x, https://si.imgix.net/64eb3398/uploads/origins/cddc352c-a2bc-438f-b578-2430cabb09f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bab44cea33a0cf05db7aa10cb58efa49 3x"}, "body": "はじめまして！過去作拝見しました！すみませんがリクエストお願いできますでしょうか？\n\nキャラは西連寺春菜ちゃんでお願い致します！\n\n学校で、同級生のモブ男子に後ろから首筋を手刀で叩かれ、「…うぅん…」と気絶させられてしまう春菜ちゃん。男子は春菜ちゃんを空き教室に運ぶとスクール水着に着替えさせて「よく似合ってるよ、春菜ちゃん」「気絶してても可愛いね」と言いながら見抜きする、というシチュエーションを希望します。\n\n気絶している寝顔はギャグ調ではなく目を閉じて、冷や汗や涙は無しで。スクール水着は肩紐が白いタイプでお願い致します。\n\n変なリクエストですみません、難しければキャンセルして下さい。\nご検討いただければ幸いです！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HayamaRai/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/04e17cb4/uploads/origins/90e8e823-43bb-4798-9ffe-78bcc4ac2263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28b79da938dd7185799fe231418569b9", "srcset": "https://si.imgix.net/04e17cb4/uploads/origins/90e8e823-43bb-4798-9ffe-78bcc4ac2263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28b79da938dd7185799fe231418569b9, https://si.imgix.net/04e17cb4/uploads/origins/90e8e823-43bb-4798-9ffe-78bcc4ac2263?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f0cf022409e36d53ff8301d781e5232c 2x,