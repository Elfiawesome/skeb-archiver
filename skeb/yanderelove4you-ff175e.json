op&w=200&h=200&blur=200&s=b6c51b792f9b1b04313464aa5e142c28 2x, https://si.imgix.net/d70789e6/requests/175426_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=293983537f4d9d43daab94f4eb30b8ba 3x"}, "body": "楠栞桜さん(3D衣装)をお願いします\n\n構図や体位\n天井に両手と片足を拘束具で吊るされた体位、過剰で蛇足にならなければ鎖つき首輪もお願いします\nアングルは下からの煽りか、若干煽り気味の正面で（描きやすさとエロさにお任せします）\n\n状態\n胸は大きすぎず控えめ（過去絵ではミモリちゃんぐらいでしょうか）\n絶頂後の状態で白い息が漂う呼吸が荒く、よろしければ擬音表現もお願いします\n表情は嫌悪と羞恥が入り混じった放心状態で、ハイライトの消えた虚ろな目で足元の男達を見つめる様子\n服は胸が開けているのと濡れたパンツがずらされている以外は任意で（スカートが邪魔でしたら破いたり剥いだりして頂いて構いません）\n\n男\n前もしくは横から男が乳首の先を人差し指でつつくように触れ、片手でクリをいじる\n背後の男はもう一方の胸や乳首を弄び、片手は手マンを終えて引き抜き、膣との間で糸を引きながらべっとり粘液がついた手を下で撮影する男たちに見せびらかすような状態\n足元や周囲から痴態を撮影するスマホが多数\n\nその他\n背景は可能でしたら地下牢風、単色の場合はそれに近い暗い背景でお願いします\n\nhttps://drive.google.com/file/d/1bjrtl_E3r2bs_n-cKakAA8ITX_T-ikTn/view?usp=sharing", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yanderelove4you/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 350556, "client_id": 201574, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69d73283/requests/128871_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8abd6d3f339a63eb14f97dc7fcddf8c0", "srcset": "https://si.imgix.net/69d73283/requests/128871_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8abd6d3f339a63eb14f97dc7fcddf8c0, https://si.imgix.net/69d73283/requests/128871_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e24a2de0d9907319cdf89a34ce10481f 2x, https://si.imgix.net/69d73283/requests/128871_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=112b0f745d403972697aa0568de688a5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69d73283/requests/128871_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w