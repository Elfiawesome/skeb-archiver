duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5343e310/uploads/origins/8dd11ae9-85fc-4f1e-9f86-b1ee4704f2d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2179c1a608596c0e19b32644183f6bb", "srcset": "https://si.imgix.net/5343e310/uploads/origins/8dd11ae9-85fc-4f1e-9f86-b1ee4704f2d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2179c1a608596c0e19b32644183f6bb, https://si.imgix.net/5343e310/uploads/origins/8dd11ae9-85fc-4f1e-9f86-b1ee4704f2d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=43d5462d3284396a3ca20ca16ded37a6 2x, https://si.imgix.net/5343e310/uploads/origins/8dd11ae9-85fc-4f1e-9f86-b1ee4704f2d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=27929691eaeba7eeff5b2fc7effe3b69 3x"}, "body": "丘/Okaさんはじめまして。\n以前から丘/Okaさんのイラストを拝見させていただいており、ぜひ依頼させていただきたいと思いリクエストさせてください。\n\nご依頼させていただきたいのは、Vtuberとして動かしたいがために作ったキャラ(自身)を描いていただきたいです！\n衣装などは描きやすいようアレンジいただいて構いません。\n\n\n使用用途は、SNSへの投稿、SNSのアイコンやヘッダー、自身のスマホの壁紙等の使用となります。\nSNSで使用の際はクレジットをつけさせていただきます。\n\nお忙しい中恐縮ですが、ご一考いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/14zXvdrStfBDX3HQv8PzQd6WZex56ZPGW", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NatsunoyoiKUN/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3768045, "client_id": 287872, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75d09102/uploads/origins/407cf803-fff6-4a44-8995-e3846dbdf71e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd46ad4c249af5b867b844ddbe019d66", "srcset": "https://si.imgix.net/75d09102/uploads/origins/407cf803-fff6-4a44-8995-e3846dbdf71e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd46ad4c249af5b867b844ddbe019d66, https://si.imgix.net/75d09102/uploads/origins/407cf803-fff6-4a44-8995-e3846dbdf71e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fffb87244fe8365cb2896eedb0e03256 2x, https://si.imgix.net/75d09102/uploads/origins/407cf803-fff6-4a44-8995-e3846dbdf71e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab327dd4a57eb5ef517bd2f478ef2bb9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75d09102/uploads/origins/407cf803-fff6-4a44-8995-e3846dbdf71e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cce7f3992bbcffa045f8ef9207d58fac", "srcset": "https://si.imgix.net/75d09102/uploads/origins/407cf803-fff6-4a44-8995-e3846dbdf71e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cce7f3992bbcffa045f8ef9207d58fac, https://si.imgix.net/75d09102/uploads/origins/407cf803-fff6-4a44-8995-e3846dbdf71e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8585abc16fafcd2419c956fae2d144c5 2x, https://si.imgix.net/75d09102/uploads/origins/407cf803-fff6-4a44-8995-e3846dbdf71e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=750a07e1565621f99fd22a1195139238 3x"}, "body": "こんにちは、いつも夏ノ宵くんノ素敵なイラストを楽しく拝見させていただいております！\nキラッキラな夏ノ宵くんのイラストがたまらなく大好きで、ぜひ依頼させていただきたいと思い、リクエストさせてください。\n\n以前描かれていた学生服の夏ノ宵くんがとっても素敵で、もしよろしければ自身のVの姿である春燕も、同じ学校の生徒になってみたく、男子高校生イラストを描いて頂けないでしょうか…！\nまた、髪型や服装などはお好きなようにアレンジしていただければと思います。\nもし上記が難しい場合は、通常の春燕の姿のイラストをお願いできればと思っております。（性別は決めていないので、夏ノ宵くんのお好きなように描いていただけたら嬉しいです！）\n\n追加でもし可能でしたら、イラストのラフも拝見できましたら嬉しいです…！（難しい場合は無しで構いません…！）\n\n使用用途はSNSへの投稿、SNSのアイコンやヘッダー、自身のスマホやPC の待ち受けなどになります。\n使用させていただく際にはクレジットを明記させていただきます。\n\n\nお忙しいところお手数ですが、何卒ご検討いただけましたら幸いです。\nまた、引き続き夏ノ宵くんのイラストを楽しみにしております…！！\n\nhttps://drive.google.com/drive/folders/14zXvdrStfBDX3HQv8PzQd6WZex56ZPGW", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_gen