0&h=200&s=0feee4dcc81328b2ed212018f2471525, https://si.imgix.net/71a4a1d9/uploads/origins/40463733-505d-4d15-8cda-94b8d31270f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebfa81ab7c8f096e8eabfb2aea37c6fb 2x, https://si.imgix.net/71a4a1d9/uploads/origins/40463733-505d-4d15-8cda-94b8d31270f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc0462fd0e9782489bf41caf712c222c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71a4a1d9/uploads/origins/40463733-505d-4d15-8cda-94b8d31270f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac3e0f37ffa6f8af8934e775f59e515a", "srcset": "https://si.imgix.net/71a4a1d9/uploads/origins/40463733-505d-4d15-8cda-94b8d31270f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac3e0f37ffa6f8af8934e775f59e515a, https://si.imgix.net/71a4a1d9/uploads/origins/40463733-505d-4d15-8cda-94b8d31270f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9a36ac20497dca090bb2e1806e1ce2c2 2x, https://si.imgix.net/71a4a1d9/uploads/origins/40463733-505d-4d15-8cda-94b8d31270f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=584c65787d6c45471ba546b61584d298 3x"}, "body": "はじめまして、VTuberとして活動しております、天翔(あまかける)ドラコと申します。\n\nTwitter(現:X)にて花譜さんの学生服姿のFAを拝見し、その可愛さに一目惚れしてしまいました。\n他のイラストも全て拝見し、是非たこうさぎ様にイラストをお仕立ていただきたい...！とリクエストを送らせていただきました。\n\n【リクエスト内容】\n配信のサムネイルや、Twitterで使用するイラストをお仕立ていただきたいです。\n※後にLive2Dで動かしたいと考えているため、パーツ分けの際に原画を損なわない程度の描き足し(静止画時には見えなかった部分の描き足し)を行う場合があります。\n\n是非、たこうさぎ様のおまかせで制作頂きたいと考えていますが、指定があった方が描きやすいとの事でしたら「缶チューハイを飲みながらマイクに向かって話す」というシチュエーションでお願いしたいです。\n\n又、先述の通り、後にLive2Dで動かしたいと考えているため、可能であればPSDファイルで頂けますと、とても有難いです。\n※特別に分けて欲しいという訳ではなく、描いたままのPSDファイルで頂けますととても有難いです。\n\n【参考資料】\nhttps://drive.google.com/drive/folders/1-MjcM_8BtJCV-RrnxXW4H01ZxDwW7Dsz \n\n【さいごに】\n要望が多く、ご不便おかけいたします。\nリクエスト内容、金額など検討頂いた上で難しいようでしたら、お気軽に差し戻し下さい。\nどうぞよろしくお願いいたします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takotousagi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2866370, "client_id": 2374088, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8ca8903/uploads/origins/88388bb6-5438-4b5b-9a26-7a0def054106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c0a13bbee4aef820e4510a963527149", "srcset": "https://si.imgix.net/f8ca8903/uploads/origins/88388bb6-5438-4b5b-9a26-7a0def054106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c0a13bbee4aef820e4510a963527149, https://si.imgix.net/f8ca8903/uploads/origins/88388bb6-5438-4b5b-9a26-7a0def054106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=756c1149de718e21b7386cfdb3de8d6a 2x, https://si.imgix.net/f8ca8903/uploads/origins/88388bb6-5438-4b5b-9a26-7a0def054106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41335ce60e9932c42b378a2981f10c64 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8ca8903/uploads/origins/88388bb6-5438-4b5b-9a26-7a0def054106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6e731018f657ae5459cd3f56ec4670f", "srcset": "https://si.imgix.net/f8ca8903/uploads/origins/88388bb6-5438-4b5b-9a26-7a0def054106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6e731018f657ae5459cd3f56ec4670f, https://si.imgix.net/f8ca8903/uploads/origins/88388bb6-5438-4b5b-9a26-7a0def054106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fb7c0ae6b7a3ed90a371931237ae64a4 2x, https://si.imgix.net/f8ca8903/uploads/origins/88388bb6-5438-4b5b-9a26-7a0def054106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f0c92eeab07bc5d2f5ac5d27c0a6f02 3x"}, "body": "はじめまして！Vtuberとして活動しております、リョーノと申します。\n\nたこうさぎ様の描かれた春猿火さんのイラストがTwitter（X）で流れイラストを拝見しまして、どのイラストも表情が素敵でとても好きでしたのでリクエストを送らせていただきました！雪のベンチに座ってこっちを見ている春さんのイラスト、素敵過ぎて恋に落ちるところでした。\n\nリクエストの内容としては、Vtuberの私の姿を新衣装で好きに描いて頂きたいです。\nポーズや表情などもお任せで見てみたいですが、指定があった方が書きやすいようでしたらゲームをやっているところをお願いいたします。\n\nイラストは可能でしたら配信活動（YoutubeサムネやSNSなど）やFANBOX特典として使わせていただけましたら幸いです。\n\n内容や金額で難しい場合はお気軽に差し戻しください。\nご自身の時間とお体を第一に、楽しく好きに描いてもらえたら嬉しいです！\n\nどうぞよろしくお願いいたします！\n\n\n参考資料：https://twitter.com/Ryono_ch/status/1668957460646989824\n新衣装：https://drive.google.com/file/d/1YUEsJ6OBHrxeOuSJwDFiARJ7We3uCY2X/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takotousagi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2866370, "client_id": 1392991, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8803186/uploads/origins/2010c9a9-a13b-493b-aeaf-6ec40023b081?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a71a42b1dcf693335eb764e94fbeef2b", "srcset": "https://si.imgix.net/c8803186/uploads/origins/2010c9a9-a13b-493b-aeaf-6ec40023b081?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a71a42b1dcf693335eb764e94fbeef2b, https://si.imgix.net/c8803186/uploads/origins/2010c9a9-a13b-493b-aeaf-6ec40023b081?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d7d772bf35c45a80770b6c03696bacc 2x, https://si.imgix.net/c8803186/uploads/origins/2010c9a9-a13b-493b-aeaf-6ec40023b081?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2ac34d520dfe75da873fae6fa185ae4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8803186/uploads/origins/2010c9a9-a13b-493b-aeaf-6ec40023b081?bg=%23fff&auto=format%2Ccompress&fm=webp&f