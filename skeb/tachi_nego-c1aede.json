です。\n\n\n差分\n・お尻のイズナが居なくなっている（侵入成功）\n・イズナの耳、ひげ、しっぽがかがりに付いている（憑依した）\n\n\nかがり　※資料が無くてすみません\nhttps://drive.google.com/drive/folders/1IFA-LhdXg_Gjq_Bii2S3czcEB3WP7VKk\n\nイズナ\nhttps://drive.google.com/drive/folders/17ntncEScuNXd0FPsI1tx8JJzxn2iH7Ev", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tachi_nego/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2115709, "client_id": 570593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70c65fc9/uploads/origins/63fb9e5b-9700-4edc-a112-d30f9ee2359d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fc3138ac5707a59987a7b6e17bb10b0", "srcset": "https://si.imgix.net/70c65fc9/uploads/origins/63fb9e5b-9700-4edc-a112-d30f9ee2359d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fc3138ac5707a59987a7b6e17bb10b0, https://si.imgix.net/70c65fc9/uploads/origins/63fb9e5b-9700-4edc-a112-d30f9ee2359d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=881fa61f7890eb947c0542d1a7657e07 2x, https://si.imgix.net/70c65fc9/uploads/origins/63fb9e5b-9700-4edc-a112-d30f9ee2359d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c13c854b79e6445764fc2f2b580a473 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70c65fc9/uploads/origins/63fb9e5b-9700-4edc-a112-d30f9ee2359d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac5368815516b27ad68a68420f0de96e", "srcset": "https://si.imgix.net/70c65fc9/uploads/origins/63fb9e5b-9700-4edc-a112-d30f9ee2359d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac5368815516b27ad68a68420f0de96e, https://si.imgix.net/70c65fc9/uploads/origins/63fb9e5b-9700-4edc-a112-d30f9ee2359d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=88815edf54f2b14fd6238da876bb403c 2x, https://si.imgix.net/70c65fc9/uploads/origins/63fb9e5b-9700-4edc-a112-d30f9ee2359d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2ecf9851f32d5c3f6d6e59f2ed6bbacb 3x"}, "body": "初めまして。\nエッチな作品を見させて頂き依頼しました。\n自キャラの男の娘君♂の作品をお願いします。\nhttps://drive.google.com/drive/folders/1JBJJKbVHdfRKxHjXk1ZsrUeHbg8PCAnf\n♂ですがおっぱい大きいです。\n内容\nhttps://skeb.jp/@tachi_nego/works/6\nコチラの依頼同様、モノクロ漫画風の作品は可能でしょうか？(難しい場合、再送or一枚絵をお願いします。)\n立ちバックで竿役(私)に犯され、トコロテンしてる姿を正面から少し横のアングルでおっぱいとチンチンをプルンプルンさせてる感じでお願いします。\n表情は赤面しながら怒り、我慢している感じ。\n差分等は不要ですが、縦割れアナルを写した描写を別コマで描いて頂ければと思います。\n足フェチなので足まで見える様にして頂ければ幸いです。\n\n以上の内容でご検討お願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tachi_nego/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2115709, "client_id": 165386, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e8d6254/uploads/origins/d84019f4-6ee0-48b1-a9c4-0a191e9c4718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a0dedc597fcbc8378231b11a8e6835c", "srcset": "https://si.imgix.net/7e8d6254/uploads/origins/d84019f4-6ee0-48b1-a9c4-0a191e9c4718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a0dedc597fcbc8378231b11a8e6835c, https://si.imgix.net/7e8d6254/uploads/origins/d84019f4-6ee0-48b1-a9c4-0a191e9c4718?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e727b1a5064c0b4ff38b7cc9d31c33d8 2x, https://si.imgix.net/7e8d6254/uploads/origins/d84019f4-6ee0-48b1-a9c4-0a191e9c4718?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45061fada33dedb1c2417b1715bcb733 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e8d6254/uploads/origins/d84019f4-6ee0-48b1-a9c4-0a191e9c4718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c84d3379dc582c8af41de451b1948ced", "srcset": "https://si.imgix.net/7e8d6254/uploads/origins/d84019f4-6ee0-48b1-a9c4-0a191e9c4718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c84d3379dc582c8af41de451b1948ced, https://si.imgix.net/7e8d6254/uploads/origins/d84019f4-6ee0-48b1-a9c4-0a191e9c4718?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ae47275d354906b41e9ca07a9068b4e 2x, https://si.imgix.net/7e8d6254/uploads/origins/d84019f4-6ee0-48b1-a9c4-0a191e9c4718?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56c1ede942de60d3faaa6409b5ddf6d0 3x"}, "body": "はじめまして。\n以前先生が描かれていた衣笠の同人誌が今でもお気に入りで、今描いて頂けるか分からないのですがこの機会にとリクエストを送らせていただきました。\n\nキャラ：衣笠改二(艦隊これくしょん)\nシチュ：押し倒されてのイチャラブ(提督視点)\n　容姿：基本的には改二のまま、以前描かれていた同人誌並の肉付き\n　体位：掴みシーツでの正常位\n　表情：興奮気味の提督を見つめて期待の眼差し\n\n差分は\n・挿入前後・中出しとそれに合わせた表情\n・たくし上げ程度の半脱ぎ、もしくは全裸\n\n指定以外のセリフ・効果音・背景などは全てお任せ致しますが、オーダーが多いと感じられましたら脱衣差分は省いて頂いても構いません。\n\n納品型式はPSDで、差分は表情・液体・セリフや効果音などを独立したレイヤーにして頂けると幸いです。\nもし内容と金額が見合わないと感じられたらリクエストそのものをキャンセルして戴いても構いません。\n何卒宜しくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tachi_nego/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5183e446/uploads/origins/e20d2b74-b83f-4f82-8e1b-3fa120a525bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98846d8e9c6a12f933fb3f84af9c5431", "srcset": "https://si.imgix.net/5183e446/uploads/origins/e20d2b74-b83f-4f82-8e1b-3fa120a525bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98846d8e9c6a12f933fb3f84af9c5431, https://si.imgix.net/5183e446/uploads/origins/e20d2b74-b83f-4f82-8e1b-3fa120a525bf?bg=%23fff&auto