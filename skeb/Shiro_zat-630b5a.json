}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@Shiro_zat/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1365944, "client_id": 1312229, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af19e643/uploads/origins/d89f7433-fb70-48a1-833b-df7350eb9443?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcb998601a7e69d665f6fdc5fd1ee79e", "srcset": "https://si.imgix.net/af19e643/uploads/origins/d89f7433-fb70-48a1-833b-df7350eb9443?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcb998601a7e69d665f6fdc5fd1ee79e, https://si.imgix.net/af19e643/uploads/origins/d89f7433-fb70-48a1-833b-df7350eb9443?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36b41ec13a7d8d41c1a1ace8779a7c60 2x, https://si.imgix.net/af19e643/uploads/origins/d89f7433-fb70-48a1-833b-df7350eb9443?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fb29e733a2672146c82bd88889f1f95 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af19e643/uploads/origins/d89f7433-fb70-48a1-833b-df7350eb9443?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bfe23b12b37b2ca51c6319982c0a090", "srcset": "https://si.imgix.net/af19e643/uploads/origins/d89f7433-fb70-48a1-833b-df7350eb9443?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bfe23b12b37b2ca51c6319982c0a090, https://si.imgix.net/af19e643/uploads/origins/d89f7433-fb70-48a1-833b-df7350eb9443?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05428319121f3387525cc73fdcf606db 2x, https://si.imgix.net/af19e643/uploads/origins/d89f7433-fb70-48a1-833b-df7350eb9443?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b89991d247e85a5773ee5e31cb066cd7 3x"}, "body": "先生初めまして！先生の作品が大好きです。よろしければオリキャラたちのイラストを頼みたいです。CoC シナリオ『Dropout Despair』のPC2人です、具体的にはURL参照してください。\n\nHo1：狼谷唯流（送信人）\n29歳女性。 紺色の髪、明るい黄色の瞳。日本人、マフィア出身。\n性格は落ち着いていて信頼でき、自信に満ちています。養父に裏切られた彼女が今信じているのは、矢倉だけだ。スーツとベストを着て仕事をしており、近接戦闘能力が高く、短剣の使用が得意です。\n\nHo2：矢倉碧（殺人鬼）\n30歳女性。 黒い瞳孔、毛先が黄色い黒髪。 中国人、殺人鬼の家系。\n子供のような性格で、生き生きとしていてかわいいし、狼谷が大好きです。常にチャイナドレスを着用し、近接戦闘能力が高く、銃の使用が得意です。\n\n二人はとても良い関係にあり、お互いのパートナーです。\n幼くして両親を亡くした狼谷は、両親が残してくれた遺書を頼りに、長い時間を乗り越えてきたため、手紙には深い愛着がある。矢倉は、純粋に直感で狼谷を信じるでしょう。は狼谷に従うだけで、狼谷から多くのことを学び、相手を気にせず自分らしくいられる、二人の関係は気楽でリラックスしたものです。\n彼らの仕事は、暗殺の依頼を受け、殺す前にターゲットの遺書を残し、それを故人が最も愛していた人に届けることです。そのすべてを計画するのが狼谷であり、作戦前に綿密な計画を立て、地図上の暗い路地や警察に見つかりにくいルートをすべて把握し、交渉や車の移動に臨みます。\n2人がターゲットを絞った後、通常矢倉がキルを行うが、仕事中も無関心に笑っていることが多い、非常識な人物のようです。また、彼はしばしば遅いターゲットに焦り、むしろ幼稚である。だから、リズムを決めるのはやはり狼谷なんです。そして、狼谷は飄々としていて、怒るともっと怖い。\n\n構図やポーズなど、自由にアレンジしてください。 私の依頼を読んでいただき、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1_QrJrpXYJyhBPixZg8q4p4xMTbg9-aTz?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Shiro_zat/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1365944, "client_id": 940492, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74125f81/uploads/origins/3af6e4b2-bb44-46fe-8ed3-dc6277c742e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59f1a3fef2d4c4cf81899cc4f2e9be44", "srcset": "https://si.imgix.net/74125f81/uploads/origins/3af6e4b2-bb44-46fe-8ed3-dc6277c742e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59f1a3fef2d4c4cf81899cc4f2e9be44, https://si.imgix.net/74125f81/uploads/origins/3af6e4b2-bb44-46fe-8ed3-dc6277c742e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2665c9410777763c17716706bd565fa3 2x, https://si.imgix.net/74125f81/uploads/origins/3af6e4b2-bb44-46fe-8ed3-dc6277c