NGで頂けますと幸いです。\n\n 【使用範囲】  \n\nTwitter等のSNSでの使用（アイコン・ヘッダー、おはようVtuber画像など）   \n\n収益化を含むYouTubeでのサムネイル、配信内での画面配置   \n\n  【その他】  \n\n個人で依頼する形になりますが、私は所属する団体があり、個人勢Vtuberではありません。\n\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/file/d/1JdGZdbsXWa3YzfzQ2yvHHHKOUOqOh49x/view?usp=drivesdk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@komugikona_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 890, "client_id": 3449084, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0732cc10/uploads/origins/6d5e44d7-511f-464c-8be2-37b501622e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66283130748d65d8b420fb4c80e8534a", "srcset": "https://si.imgix.net/0732cc10/uploads/origins/6d5e44d7-511f-464c-8be2-37b501622e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66283130748d65d8b420fb4c80e8534a, https://si.imgix.net/0732cc10/uploads/origins/6d5e44d7-511f-464c-8be2-37b501622e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3e7c7657d152eb0897216990702108f 2x, https://si.imgix.net/0732cc10/uploads/origins/6d5e44d7-511f-464c-8be2-37b501622e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e12eb3d1b89197600e6df004abaec04 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0732cc10/uploads/origins/6d5e44d7-511f-464c-8be2-37b501622e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa7e02cd4fce2284bb3de4ad75239517", "srcset": "https://si.imgix.net/0732cc10/uploads/origins/6d5e44d7-511f-464c-8be2-37b501622e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa7e02cd4fce2284bb3de4ad75239517, https://si.imgix.net/0732cc10/uploads/origins/6d5e44d7-511f-464c-8be2-37b501622e31?bg=%23fff&auto=format%2Ccompress&