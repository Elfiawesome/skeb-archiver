かせでお願いいたします。\n・サムネイルなどに使用したため、人物と背景をわけたPSDで頂けると喜びます。\n・体型や服装は調整していただいて頂いても構いません。\n\n◎使用用途\n・収益化済みYouTubeチャンネルでの使用\n・SNSでの使用\n・ネットプリント", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@monookimon/works/253", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3436328, "client_id": 1540859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78cc8b55/uploads/origins/97fd83db-4d6e-46f5-862d-3e7a87ddb738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9a7f37e9857275c07f0fd0bf07f79be", "srcset": "https://si.imgix.net/78cc8b55/uploads/origins/97fd83db-4d6e-46f5-862d-3e7a87ddb738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9a7f37e9857275c07f0fd0bf07f79be, https://si.imgix.net/78cc8b55/uploads/origins/97fd83db-4d6e-46f5-862d-3e7a87ddb738?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8afd0acd5bc7b1210212589e8af868b 2x, https://si.imgix.net/78cc8b55/uploads/origins/97fd83db-4d6e-46f5-862d-3e7a87ddb738?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9fbc0b2bfdc6bea86b6ca304dbfed5b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78cc8b55/uploads/origins/97fd83db-4d6e-46f5-862d-3e7a87ddb738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=919e0faa8df2baecb51e0a6b21c7485d", "srcset": "https://si.imgix.net/78cc8b55/uploads/origins/97fd83db-4d6e-46f5-862d-3e7a87ddb738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=919e0faa8df2baecb51e0a6b21c7485d, https://si.imgix.net/78cc8b55/uploads/origins/97fd83db-4d6e-46f5-862d-3e7a87ddb738?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5f6cf396704fe86a10c0659cbab54569 2x, https://si.imgix.net/78cc8b55/uploads/origins/97fd83