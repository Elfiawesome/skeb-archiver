200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31c73d366126763c447df14df421634a", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3121328, "client_id": 2847428, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@f_s_of_f/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3121328, "client_id": 3219643, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5928ed2/uploads/origins/4e435722-78e3-4f7e-bc0c-e8730b5461c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33d5278088387546a17b9e76b1f1fe7d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5928ed2/uploads/origins/4e435722-78e3-4f7e-bc0c-e8730b5461c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff78124bc10a5cf80f332809fe46b9e0", "src_set": ""}, "body": "いつもお世話になっております。haimuです。\nリスフェレ本当にありがとうございました！ずっと噛み締めてるのにずっと味がする　美味い\n\n\n〇依頼内容\nCoC6版「リスト・フェレンツたちの失踪」自陣のイラスト×１\n\n\n〇イラスト指定\n候補が3つありますが、ろじしきさんが描きやすい物を選んで描いていただければ大丈夫です。\n\n・卓中で印象に残ったシーン（ろじしきさんのお好みで問題ありません）\n・並んで演奏する2人\n・オシャレなカフェで食事する2人\n\n\nご検討の程よろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@f_s_of_f/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3121328, "client_id": 934318, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d22cd51/uploads/origins/76c089f9-4fb6-4524-9898-0aacf671b3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cbb801025977c2fadc50a332d3e2d3f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d22cd51/uploads/origins/76c089f9-4fb6-4524-9898-0aacf671b3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20b2c3bfe643a3b9e6e1df5c11ad01c1", "src_set": ""}, "body": "ろじしきさんへ\n先日色紙に描いてもらった子を改めて依頼させてください\nかっこいい感じだと嬉しいです\n\nGODARCA太陽\nレイヴン・デライト・ブラックフェザー\n身長160cm\nモチーフは八咫烏\n背が小さくて雄っぱいがでかい\nつり目の三白眼だがせせら笑う感じの半目なことが多い\nエセ京都弁(訛り)を話す戦闘狂寄り気質の槍/杖使い\n簡単に言うとメスガキ\n切羽詰まったりすると標準語に戻る\n\nキャラシ(GODARCAネタバレ込み)\nhttps://charasheet.vampire-blood.net/5208319\n資料\nhttps://drive.google.com/drive/folders/1PvORkaioaLU_L6HuVtOHoGktNBet2UwF?usp=sharing\n※コンバートのため同一人物として資料URL内にコンバート元の烏羽朱里(ワンディスHO4)の資料もありますが対象はレイヴン(GODARCA太陽)の方です\n\nhttps://drive.google.com/drive/folders/1PvORkaioaLU_L6HuVtOHoGktNBet2UwF?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@f_s_of_f/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3121328, "client_id": 2799089, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b80daad/uploads/origins/d3e7b6e2-9b44-47e9-b3bf-e21ea8e8d6cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d6062eb7b85028fe888bc61b8ffbc90", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b80daad/uploads/origins/d3e7b6e2-9b44-47e9-b3bf-e21ea8e8d6cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8fda8e114aa675c482442cc633648fc", "src_set": ""}, "body": "旧Twitterではいつもお世話になっております、マグロっぴと申します。\nこの度、ろじしき様の描くイラストやキャラクターの雰囲気を見込んで、当方が作成します同人誌の表紙制作をお願いしたく、リクエストを送らせていただきました。\n\n【同人誌内容】東方Project二次創作小説（題名:霖を綴じる）\n\n【著者名】マグロっぴ\n\n【イラストやロゴのイメージ】\n\n表の表紙に当たるイラストは、窓辺に腰掛けて和本を読んでいる、主人公（森近霖之助）を描いていただきたいです。\n窓から見える景色は冬で葉を落とした山林、時間帯は昼で、雪がしんしんと降っているものがいいです。\nタイトル、著者名のロゴフォントは線画細めであまり丸っこくないものを希望します。\n\n裏表紙にあたるイラストは、表紙１と同様の構図、主人公が不在で、窓から見える景色は雪が止んだ冬月夜。主人公が居ない代わりに、窓辺に懐中時計を置いてくださると、より嬉しいです。\n\n参考資料はリンク先のドライブに格納していますので、ご参考になるようであれば、ぜひご確認ください。\n\n\n【補足資料等リンク】\n\n依頼内容関連資料(Googleドライブ)\nhttps://drive.google.com/drive/folders/1dkuFEIh2OIqMSh_4vAY5S7tZMJS8QYDh\n\n主人公（森近霖之助）について\nhttps://dic.pixiv.net/a/%E6%A3%AE%E8%BF%91%E9%9C%96%E4%B9%8B%E5%8A%A9\n\nhttps://danmaku.jp/archive/character/c088/", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@f_s_of_f/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3121328, "client_id": 3219643, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad9ba197/uploads/origins/c86f8d3a-0693-4ae7-a098-e4a37048c5d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf1e1aafd8888ea133bbf400e1ec43ca", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad9ba197/uploads/origins/c86f8d3a-0693-4ae7-a098-e4a37048c5d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ecbfdb4f4c65db6184080e22f64d653", "src_set": ""}, "body": "いつもお世話になっております。haimuと申します。\n以前探索者（CoC6版 VOID HO1）の私服立ち絵および表情差分を描いて頂きたいと思い、依頼させていただきました。\n\n\n〇依頼内容……以前依頼した探索者の私服差分、中学生時代の学生服差分\n⦿私服差分で欲しいもの\n・全身立ち絵 ×1\n・表情差分 ×6\n　└デフォルト、泣き顔、苦笑い、笑顔、真剣な顔、発狂顔\n⦿学生服差分で欲しいもの\n・全身立ち絵 ×1\n・表情差分 ×4\n　└デフォルト、発狂顔、苦笑い、笑顔\n\n\n〇キャラクター設定\n名前：陽向 麗（ひむかい うらら）\n年齢：22（学生服差分では14歳くらい）\n性別：女性\n種族：人間\n職業：刑事\n身長：175\n骨格：ナチュラル\n髪色：明るめのブルーブラック\n髪型：姫ウルフ\n目：ツリ目気味\n目の色：フォグブルー\nその他：女子校の王子様系イケメン女子。STRが13、APP・SIZが共に15なので、ちょっと筋肉がついていたり脚が長かったりしたら嬉しくなります。\n性格：努力の裏付けがある自信家。しばしば生意気な発言もするが自分にストイックかつ真面目で素直なだけであり、本人に悪気は無い。事件捜査には真剣に取り組み、地道に足で調べていくタイプ。“昭和の刑事”というイメージがしっくりくるようなスタイルを取っている。自分の下の名前が嫌い。\nその他：子供舌でコーヒーやゴーヤ、麻婆豆腐など辛苦渋の味が苦手。紅茶もあまり得意では無いのでカフェインをとる時はエナドリを飲んでいる。\n\n〇私服差分での服装……露出度が低い韓国系オフィスカジュアル\n・頭アクセ　なし\n・耳アクセ　なし\n・首アクセ　なし\n・アウター　お任せします。あっても無くても良\n・トップス　落ち着いた