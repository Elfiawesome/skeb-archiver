ormat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e1e1f84ce5a3b292981e29b758a0296", "src_set": ""}, "body": "クロエ(花嫁)の寝室イラストを依頼します。\nステファニー(花嫁)の寝室イラストとてもよかったです。最高でした。\n今回はクロエのイラストをお願いします。\n\n・画面サイズはゲームと同じ横長構図。\n・花嫁衣装の半脱ぎで、おっぱい露出、長靴下とアームカバーは身につけていて欲しいです。\n・母乳溢れるおっぱいを攻めながらの本番中出しエッチです。おっぱいがしっかり見える構図にしてください。\n・朝まで連戦エッチの終盤あたり、何度も中出しされて、母乳や精液でドロドロになったところを描いてください。\n・連戦の終盤ではありますが、絶頂・射精は複数回欲しいです。\n\n以上になります。よろしくお願いいたします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurokawaidumi/works/120", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1739904, "client_id": 348610, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8557bb4/uploads/origins/7fb23e64-5339-415d-8d9b-4fe8937e52a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb2699b178cb107bdd505c74f00dfec4", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8557bb4/uploads/origins/7fb23e64-5339-415d-8d9b-4fe8937e52a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b9eff80a2fe2c8af1548fb344302191", "src_set": ""}, "body": "前回も素晴しいアイビーのイラストをありがとうございました。\n今回もよろしければお受けください。\n【作品名】フラワーナイトガール\n【キャラクター】アイビー\n【衣装】ジューンブライドver開花衣装\n【シチュエーション】\n上記の衣装の胸をさらけ出した状態で、結合部分を見せつけるようにスカートをたくし上げた団長さん視点での騎乗位でお願いいたします。\nまた、おっぱいのサイズは増量してもらえると嬉しいです。\n以上よろしくお願いいたします。\n\nhttps://gyazo.com/5b1c661f5d41deef14255e29930fa7dc", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurokawaidumi/works/119", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1739904, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f52ccc0/uploads/origins/81fc3d15-05d8-4bfc-950f-3b41d47dbe2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2edb62a0b1509f20b54e0980fea92e6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f52ccc0/uploads/origins/81fc3d15-05d8-4bfc-950f-3b41d47dbe2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a758cee56d5e633efa16a8df0aeb3054", "src_set": ""}, "body": "リクエスト失礼いたします！\n\nオンゲキから「柏木咲姫」「井之原小星」のWパイズリのイラストをリクエストいたします。\nhttps://ongeki.sega.jp/character/1100/\nhttps://ongeki.sega.jp/character/1110/\n\n上着は半脱ぎで、シャツのボタンを開けて大きなおっぱいで挟みこんでいる。\n咲姫は慣れた手つきでリードするように、小星はめんどくさそうにしながらも健気にしごいてくれている。\n\n差分等はおまかせいたします。\n\nなにとぞよろしくお願いいたします！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurokawaidumi/works/118", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1739904, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3fec20b/uploads/origins/4ffaca7f-b5bf-4050-9e3c-986e540f4665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ace84cc0f4d6bd771cf61738a7ad9c51", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3fec20b/uploads/origins/4ffaca7f-b5bf-4050-9e3c-986e540f4665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18d081cc62a78c72259c7b79c9313514", "src_set": ""}, "body": "裸Ｙシャツのクロエとかケモ耳生やしたクロエとか色々お世話になっております。\nリクエスト再開との事で早速リクエストです。\n\n〇キャラ\nブレガよりクロエ、ステファニーのフェレール姉妹\n\n〇シチュエーション\n3人でハッスルした翌日の朝チュン\nベッドで干からびてる団長にモーニングコーヒーを差し出す姉妹\nクロエが自分の飲んでいるマグカップを団長に差し出してステファニーが呆れてる感じで\n※マグカップには先日の落書きＳＤキャラが可愛かったので姉妹のＳＤキャラの意匠が施されていると\n　良いなと思います\n\n〇容姿\n☆二人共通\n・裸Ｙシャツのみ\n※無防備なのでＹシャツのボタンは留めておらず丸見え\n・アンダーヘア無し\n\n〇背景\n傭兵団の団長の部屋\n\n〇構図\n構成はお任せします、３人でイチャコラしてる日常を描いて頂ければ\n\n〇出来ればの差分\nエロすでない依頼なのでラッキースケベ程度のおまけがあると嬉しいです\n\nイベント前ですがお手すきでしたらお付き合い下さい。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurokawaidumi/works/117", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1739904, "client_id": 92768, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc1e2212/uploads/origins/6c983a1a-1f2a-49d2-b426-d0472aefb050?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01abd55b6595cbddad64bb9e46b9d18a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc1e2212/uploads/origins/6c983a1a-1f2a-49d2-b426-d0472aefb050?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b32b894b4fb5ac69be611a33b97ddb1", "src_set": ""}, "body": "お世話になっております。\n\n3度目になりますが、またオンラインゲームのマイキャラで、\n今回は母乳描写大盛りの下記のシチュエーションでお願いできますでしょうか。\n（今回も資料内で右腕に着けているグローブは省略し、左腕側と同じデザインでお願いします。）\nhttps://skeb.jp/@kurokawaidumi/works/37\nhttps://skeb.jp/@kurokawaidumi/works/69\n\n母乳が出るのが止まらなくなったウチの子が、\n自分で乳首をイジる or おっぱいを揉んで母乳が止まるまで絞ろうとするものの、\n母乳は止まるどころかどんどんと溢れてきて、快感からエッチな気持ちになってきて…というシチュでお願いします。\nもし、可能であれば、最後は絶頂と同時に母乳を噴水のように派手に噴き上げる描写と、\n事後としておっぱいも顔も母乳まみれの状態でとろんとした表情の描写を浮かべるがありますと大変喜びます。\n\n構図など上記以外の点については、お任せいたします。\n\n以上、希望が多いリクエストで大変恐れ入りますが、\nご検討いただけますと幸いです。\n何とぞよろしくお願いいたします。\n\nhttps://www.dropbox.com/sh/pqylpodxnoa7srp/AAAxGBPgcX43Qsh6zD7CkJ14a?dl=0", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurokawaidumi/works/116", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1739904, "client_id": 600508, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/afd47773/uploads/origins/0f7a5e90-abbf-472a-b642-f435219df586?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8ba8fba97e46c46d47fcebd4970fcd6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/afd47773/uploads/origins/0f7a5e90-abbf-472a-b642-f435219df586?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a837c27284eafec458b2879c608f9f5d", "src_set": ""}, "body": "こんにちは。日頃よりむちまし可愛い娘さんの画の数々に大変お世話になっております。\n依頼ですがアズールレーンより「ネプチューン」さんを描いていただけませんか。\n他の方々の騎乗位画が素晴らしく感じたので（特にサン・ジャシントさんの画）、あんな具合の縦長の画をお願いしたいです。ただ竿役は描かず、事後の様子を描いていただければと思います。\n恥じらいもしくは悪戯っぽい表情で、片手は自分の胸を揉んでいる、もう片手は股間を広げて流れる白濁を見せ付ける、俗に言う くぱぁ なシーンをと思いますが難しければ後者は指を股間に添える程度でも大丈夫です。\n衣装はお任せします、迷ったらデフォルトのもので大丈夫ですが面倒だったらひん剥いてしまっても大いに構いません。最低限髪飾り(砲塔は無くて大丈夫です)とチョーカー、ガーターベルトのみは残してくれるとありがたいです。\n背景は普通の寝床、または白か青っぽい簡素なものでも、表情や汁的な差分等あると捗りますが余裕があればで構いません。\nまた胸部は勿論、足回り等も派手に『盛って』もらえると悦びます。\nご検討の程を宜しくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 17814, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "茶乃十三", "screen_name": "muccnoir", "avatar_url": "https://pbs.twimg.com/profile_images/1038820456877314049/9U-xcRWg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2272400598/1552914031/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 160}, {"id": 19647, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "鈴野のの", "screen_name": "suzuno", "avatar_url": "https://pbs.twimg.com/profile_images/1451508010996494338/kQ1BH53V.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1050279505292537857/1631775968/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 33}, {"id": 166290, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "テレみ✨", "scr