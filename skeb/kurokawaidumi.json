♪♪」な感じで誘惑してきます。もちろん交互に挟みます。\n・パイズリ事前では乳首見えないソフトエッチ。胸元ゆるんで今にもこぼれそう、乳首が見えそうで見えないギリギリ描写にして欲しいです。\n・パイズリ事後では、おっぱい露出して、母乳垂らして、団長の白色ソースをかけてください。\n・もし可能であれば液体の量で複数差分。段階的に増やして何度もご奉仕してる感を出してください。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurokawaidumi/works/124", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ed30ae63/uploads/origins/2bde360b-838b-4f7e-998d-b3aeb195fc67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f6a4ed892e725b9600a34f814f9c994", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1739904, "client_id": 751755, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kurokawaidumi/works/123", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1739904, "client_id": 348610, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a50dd960/uploads/origins/0a3f9cfa-821c-4817-ae55-a17eb84f25b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddb07dae604408a16b9342834393178d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a50dd960/uploads/origins/0a3f9cfa-821c-4817-ae55-a17eb84f25b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6ab51dcaa86e32b2bf1596bb570d51f", "src_set": ""}, "body": "前回も素晴しいアイビーのイラストをありがとうございました。\n今回もよろしければお受けください。\n【作品名】フラワーナイトガール\n【キャラクター】アイビー・オニユリ・アグロステンマ・ネモフィラ・ミズヒナゲシ\n【シチュエーション】今回募集開始が始まったタイミングが丁度フラワーナイトガールの10周年の節目間近というのもありますが先生が担当しているアイビー・オニユリ・アグロステンマ・ネモフィラ・ミズヒナゲシ５名の集合絵が見たいです。この中ではアイビーとオニユリが別衣装持ちですが元のバージョンの衣装でお願い致します。また、構図等全