rmat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c90a37349f9b2c58ae2b3860b8a4e874 2x, https://si.imgix.net/89aade0f/uploads/origins/b2babb41-8f60-4c9e-bede-3d7bf3fb70b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4eb03d30a1ae1ea2a648ae032e45072e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89aade0f/uploads/origins/b2babb41-8f60-4c9e-bede-3d7bf3fb70b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7639cc8c041f2a53bb7837579c6cea15", "srcset": "https://si.imgix.net/89aade0f/uploads/origins/b2babb41-8f60-4c9e-bede-3d7bf3fb70b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7639cc8c041f2a53bb7837579c6cea15, https://si.imgix.net/89aade0f/uploads/origins/b2babb41-8f60-4c9e-bede-3d7bf3fb70b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a964e2c7f0d4416e1eb3430b49fb3511 2x, https://si.imgix.net/89aade0f/uploads/origins/b2babb41-8f60-4c9e-bede-3d7bf3fb70b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=62450cbfeeecbc00d721c03cad8e3ea4 3x"}, "body": "Hello! Your art of original characters with Pokémon is absolutely beautiful, and I was hoping to get some work done from you in the same style!\n\nI would like to request a piece of my VRChat avatar, he's a dog-boy, and his right ear is always bent down and he has a Time Gear on his collar. I would like to see you draw him in his Royal Parade outfit that he wears occasionally. With his hat on only his left ear pokes out as his right ear is too bent to stick through the hat.\n\nI would like to have my avatar commanding a Milotic to preform a Hydro Pump attack. For my avatars pose I'd like his left hand on brim of his hat, his right hand extend pointing forward holding a Premier Ball. His expression would be him yelling giving command to Milotic to attack. For the background could be of Sunset Colosseum from Pokémon Battle Revolution.\n\nLinked bellow is my VRChat avatar's reference and some extra pictures, I appreciate you taking time to read this and hope you have a good day!\n\nLink to reference https://drive.google.com/drive/folders/1ic5VDyHlsCShiAa54ugYO-WDakEbAeOt", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HYPERBEAM_P/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1578794, "client_id": 1363356, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ac8ccce/uploads/origins/56a8d2be-2077-4a37-a34c-a8caff235012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdd8b6c92b5ecb169d5db6636b693f89", "srcset": "https://si.imgix.net/0ac8ccce/uploads/origins/56a8d2be-2077-4a37-a34c-a8caff235012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdd8b6c92b5ecb169d5db6636b693f89, https://si.imgix.net/0ac8ccce/uploads/origins/56a8d2be-2077-4a37-a34c-a8caff235012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9fd7f8ed6df54696a9dbbb340e2055b 2x, https://si.imgix.net/0ac8ccce/uploads/origins/56a8d2be-2077-4a37-a34c-a8caff235012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb6988589df6414a6c433395c26d5853 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ac8ccce/uploads/origins/56a8d2be-2077-4a37-a34c-a8caff235012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c16a288087817fa96e742702d684fc94", "srcset": "https://si.imgix.net/0ac8ccce/uploads/origins/56a8d2be-2077-4a37-a34c-a8caff235012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c16a288087817fa96e742702d684fc94, https://si.imgix.net/0ac8ccce/uploads/origins/56a8d2be-2077-4a37-a34c-a8caff235012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5346f6ef6b5f2a8a9fc70598047b8315 2x, https://si.imgix.net/0ac8ccce/uploads/origins/56a8d2be-2077-4a37-a34c-a8caff235012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6435a0ae51da5edfcad0d13c56aba950 3x"}, "body": "こんばんは、いつもツイートやイラスト拝見させていただいております。\nびーむさんの絵柄、優しくて素朴な雰囲気がとても素敵だと思っています。\nそこで、今回は私が一番好きなプリチャンアイドルであるアンジュさんと、一番好きなポケモンであるライチュウ（原種）を一緒に描いていただきたいと考え、リクエストさせていただきました。\n構図は「犬のようにお腹を丸出しにし、目を閉じてリラックスしているメスのライチュウに、アンジュさんが穏やかな微笑を浮かべながらブラッシングをしてあげている」というものでお願いします。\nアンジュさんの衣装に関しては、これという指定はないものの、できれば私服っぽい感じのものを選んでいただきたいと思っています。\nまた、アニメでいつも纏っているキラキラオーラも描いていただけると嬉しいです。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HYPERBEAM_P/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1578794, "client_id": 2113377, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55d25197/uploads/origins/4e6f556b-fa60-4952-a986-26fcf6df5886?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=279e53b2324e48641820a8da6e014b73", "srcset": "https://si.imgix.net/55d25197/uploads/origins/4e6f556b-fa60-4952-a986-26fcf6df5886?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=279e53b2324e48641820a8da6e014b73, https://si.imgix.net/55d25197/uploads/origins/4e6f556b-fa60-4952-a986-26fcf6df5886?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8fa0f78ff531eb00c864ca13c94a4639 2x, https://si.imgix.net/55d25197/uploads/origins/4e6f556b-fa60-4952-a986-26fcf6df5886?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69b9669293de9ba00bf913b15437b0f7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55d25197/uploads/origins/4e6f556b-fa60-4952-a986-26fcf6df5886?bg=%23fff&auto=fo