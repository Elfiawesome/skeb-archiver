//si.imgix.net/cd0f7cde/uploads/origins/bb07cd9b-8ea6-4e73-b3fc-30c18cef6ced?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65e16d8a33d75928c9f81acceb52e818", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd0f7cde/uploads/origins/bb07cd9b-8ea6-4e73-b3fc-30c18cef6ced?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfbd5284577ed2d4ce1cad678bc7b580", "src_set": ""}, "body": "ガールズ&パンツァーより「島田愛里寿さんの全身イラストです。 セーラー服に白いニーハイブーツを履いた島田愛里寿さんを描いてください。ありがとうございました。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hutaba__miyagi/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 302235, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0856c0d/uploads/origins/044d8aec-ad62-4c99-85e9-a35b36d0daae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52327d153acb1611a996d3a73cf6baf9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0856c0d/uploads/origins/044d8aec-ad62-4c99-85e9-a35b36d0daae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9c54df5cd15068116f2696ff7651b94", "src_set": ""}, "body": "初めまして、先生の絵に一目惚れしお願いにあがりました\n\n今回は私が配信、SNSアイコンで使うイラストをお願い致します\n  描いていただきたいのはふわっとした髪で毛先は軽くクセがある肩より下まで\n\n 服装はコンセプトとして、触れたら割れそうなくらい、大人しそうな外見に反して「この子こんなジャラジャラしかてギャルギャルしい私服なの！？」というくらいなギャップをお願いします\n\n 配信画面の隅にも載せるので、背景透過したものもお願いします\n\n背景はおまかせします\n\nぐだって分かりづらいかもしれませんが\nどうかよろしくお願いしますm(_ _)m", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hutaba__miyagi/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 302235, "client_id": 2178077, "vtt_url": null, "thum