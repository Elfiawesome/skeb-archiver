fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f188c42a1266b1c02886d6eacaaa04ce 2x, https://si.imgix.net/ca8ba0ad/uploads/origins/401c1ad8-682c-403b-8536-ba37b17f1e34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=983b5ee6b4a013aef808016a85f6f267 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca8ba0ad/uploads/origins/401c1ad8-682c-403b-8536-ba37b17f1e34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=246106b8e3326e2df9aecccd746440d2", "srcset": "https://si.imgix.net/ca8ba0ad/uploads/origins/401c1ad8-682c-403b-8536-ba37b17f1e34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=246106b8e3326e2df9aecccd746440d2, https://si.imgix.net/ca8ba0ad/uploads/origins/401c1ad8-682c-403b-8536-ba37b17f1e34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df0722b85b744440bf9070d875a2530f 2x, https://si.imgix.net/ca8ba0ad/uploads/origins/401c1ad8-682c-403b-8536-ba37b17f1e34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8cd47b7ad2fe516e2cb33ad1021be654 3x"}, "body": "こんにちは。\nねこ様のオリジナルキャラクターである奨くん、紀壱くん、汰一くんの3人が新選組のコスプレをしているイラストをリクエストさせてください。\n【衣装】\n・浅葱色のだんだら羽織\n・濃い紺色の和服\n・灰色の袴\n・額に「誠」と描かれた鉢巻き\n・資料：https://www.kondo-sanko.jp/popup/index.php?ID=194889\n\nポーズ、構図等はお任せします。\n可能であれば彼女さん達(リナちゃん、なずなちゃん、沙夜ちゃん)の反応も描いて下さい。\n\nご検討よろしくお願い申し上げます。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oro_neko/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 215110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea69fea4/uploads/origins/bf33f5d3-8925-4e97-a675-75c50d00a7fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c5c67425383029a2a330006e7db9e22", "srcset": "https://si.imgix.net/ea69fea4/uploads/origins/bf33f5d3-8925-4e97-a675-75c50d00a7fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c5c67425383029a2a330006e7db9e22, https://si.imgix.net/ea69fea4/uploads/origins/bf33f5d3-8925-4e97-a675-75c50d00a7fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b9ed8f1c8cf7bdd64765d6617c3da99 2x, https://si.imgix.net/ea69fea4/uploads/origins/bf33f5d3-8925-4e97-a675-75c50d00a7fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f50be2075aef1bfbb4f2b9dce9bf9156 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea69fea4/uploads/origins/bf33f5d3-8925-4e97-a675-75c50d00a7fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aed14bb07d95e2993b4348433b7eecbc", "srcset": "https://si.imgix.net/ea69fea4/uploads/origins/bf33f5d3-8925-4e97-a675-75c50d00a7fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aed14bb07d95e2993b4348433b7eecbc, https://si.imgix.net/ea69fea4/uploads/origins/bf33f5d3-8925-4e97-a675-75c50d00a7fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8455b2cea11343143bd74484a486a9cf 2x, https://si.imgix.net/ea69fea4/uploads/origins/bf33f5d3-8925-4e97-a675-75c50d00a7fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ae365fb458bea724f405d51db125a8ee 3x"}, "body": "こんにちは。\nねこ様のオリジナルキャラクターである耀くんと陽菜ちゃんのCPイラストをリクエストさせてください。\n【コンセプト】\n平安時代の公家と姫君。\n\n【耀くん衣装資料】\nhttps://kyoto-kyuteibunka.or.jp/wp/wp-content/uploads/2021/11/561-1.jpg\n\n【陽菜ちゃん衣装資料】\nhttps://costume.iz2.or.jp/files/posts/21_slide_1.jpg\n\n服装の色合いやディテールは２人のイメージに合うようにアレンジしていただいて構いませんが耀くんに立烏帽子は必ず被せて下さい。\nイラストの構図、シチュエーションはお任せします。\nご検討よろしくお願い申し上げます。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oro_neko/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 215110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/002ed770/uploads/origins/d0ee3ec2-2e08-47f8-a4ad-eff58023e13c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc96c93dfb76cafe660e0c0899826386", "srcset": "https://si.imgix.net/002ed770/uploads/origins/d0ee3ec2-2e08-47f8-a4ad-eff58023e13c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc96c93dfb76cafe660e0c0899826386, https://si.imgix.net/002ed770/uploads/origins/d0ee3ec2-2e08-47f8-a4ad-eff58023e13c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbe08dc94bacbfbbeab6d22939189b08 2x, https://si.imgix.net/002ed770/uploads/origins/d0ee3ec2-2e08-47f8-a4ad-eff58023e13c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52656e2771abb011ac666994ec1d6181 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/002ed770/uploads/origins/d0ee3ec2-2e08-47f8-a4ad-eff58023e13c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eaaf53022f57a086b55f7696d1f2e181", "srcset": "https://si.imgix.net/002ed770/uploads/origins/d0ee3ec2-2e08-47f8-a4ad-eff58023e13c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eaaf53022f57a086b55f7696d1f2e181, https://si.imgix.net/002ed770/uploads/origins/d0ee3ec2-2e08-47f8-a4ad-eff58023e13c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ddbb77a71c74605eceecf1515e78bef0 2x, https://si.imgix.net/002ed770/uploads/origins/d0ee3ec2-2e08-47f8-a4ad-eff58023e13c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64d9a48379cee9bd96da5230fc957575 3x"}, "body": "こんにちは\nいつもリクエストへのお答えと納品ありがとうございます。\n今回も私のオリキャラ６人のイラストをリクエストさせて下さい。\n\n【シチュエーション】\n６人全員の集合写真\n\n【イラストの構図】\n前列３人は椅子に座り、後列３人は直立。\n椅子のデザインはデスクチェア肘掛け付き。\n衣装は前にリクエストした立ち絵と同じ。\n\nキャラのそれぞれの身長は参考までに\nシント→170cm\nジュン→165cm\nハルカ→162cm\nアスナ→160cm\nソウタ→177cm\nナオキ→184cm\n\n【キャラの配置・ポーズ】\nイラスト前列→椅子に座る\nイラスト前列左側→ジュン：背筋を伸ばし、少し両足を開き、肘掛けに肘を掛けている。\nイラスト前列真ん中→ハルカ：両膝を揃え、足は向かって右斜めに流す。右手は右膝の隣に、左側は右膝の上に置く。\nイラスト前列右側→シント：少し前屈みに座り、両足を開き、手の付け根を太股の上に置き、手はダランと下げる。\n\nジュン座り方資料：https://assets.clip-studio.com/ja-jp/detail?id=2021310\nハルカ座り方資料：https://pixta.jp/illustration/113149373\nシント座り方資料：https://assets.clip-studio.com/ja-jp/detail?id=1695692\n\nイラスト後列→直立\nイラスト後列左側→ナオキ：両腕を反対の袖の方に入れて腕組み。\nイラスト後列真ん中→アスナ：ハルカの両肩に手を添えてる。ニカッと歯をみせて笑顔。\nイラスト後列右側→ソウタ：右手で二本指の敬礼ポーズ。左手は腰のあたりに添える。\n\nイラストの背景は空き教室っぽい感じでデザインはお任せします。\n\n金額等不足があればお手数ですが再送願います。\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1O7OQoEcg7YoMcERW_g64Gtm3XT-EWwK9\n\nhttps://drive.google.com/drive/folders/1O7OQoEcg7YoMcERW_g64Gtm3XT-EWwK9", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oro_neko/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8d208b1b/uploads/origins/583bf7e4-e561-44c6-aa8a-7a0f2c9b62ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3fe07704ed0de593ef3281a667c808f4", "srcset": "https://si.imgix.net/8d208b1b/uploads/origins/583bf7e4-e561-44c6-aa8a-7a0f2c9b62ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3fe07704ed0de593ef3281a667c808f4, https://si.imgix.net/8d208b1b/uploads/origins/583bf7e4-e561-44c6-aa8a-7a0f2c9b62ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47c0e9c2cbee3cdbab13729e99b4da92 2x, https://si.imgix.net/8d208b1b/uploads/origins/583bf7e4-e561-44c6-aa8a-7a0f2c9b62ce?bg=%23fff&auto=format%2Ccompress&fm=w