嬉しいです。\n足は素足ではなく、タイツでお願いします(網タイツ等ではなく普通のタイツで、色は茶系か黒めが希望です)。\n\nまたポーズにつきまして\n手と手首のカフスが入るような構図でお願いします。\n両手でも片手でもどちらでも構いません。上記以外に具体的な指定はありませんので、お好きなポーズを描いていただければと思います。\n\nそのほかにつきましてはお任せでお願い致します。\n\nまたもし可能でしたら、デフォルメの私服汰一君も一緒に描いていただきたいです。\n\nよろしくお願い致します。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oro_neko/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 215110, "client_id": 103241, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d2f56bc/requests/36150_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab3faeab600d4ce9b54315fffbd32124", "srcset": "https://si.imgix.net/8d2f56bc/requests/36150_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab3faeab600d4ce9b54315fffbd32124, https://si.imgix.net/8d2f56bc/requests/36150_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a2ce482a4cc895f1c76e9df3cd7ed2e 2x, https://si.imgix.net/8d2f56bc/requests/36150_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f9378c48f44ce88e8ba6120b2488e09 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d2f56bc/requests/36150_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74a4b096a72f3109e4d4bb2456fc18be", "srcset": "https://si.imgix.net/8d2f56bc/requests/36150_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74a4b096a72f3109e4d4bb2456fc18be, https://si.imgix.net/8d2f56bc/requests/36150_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b7fd905d4a6daa9792fbd156a7d34c21 2x, https://si.imgix.net/8d2f56bc/requests/36150_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=52b33d0d69859bf94676d8f3d3362bab 3x"}, "body": "おろねこさん、こん