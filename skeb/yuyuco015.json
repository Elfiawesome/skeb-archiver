rop&crop=top&w=200&h=200&blur=200&s=0283a26339aaeae0b7811d546bff735d", "src_set": ""}, "body": "前回のリクエスト(ゆーねさんのアリスちゃん)はお世話になりました。\n今回は、以前描かれた、ゆゆこさんが描かれた方のアリスちゃんをリクエストします。\n\n●キャラ\n「https://www.pixiv.net/artworks/99895744」のアリスちゃん\n\nポーズなど、その他諸々はお任せします。\nご検討よろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuyuco015/works/38", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 107436, "client_id": 2014026, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6eca0c5/uploads/origins/515d379e-88e6-4381-9321-65ef69fd9a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fb92215952a9eacd5f0cc03ba28e468", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6eca0c5/uploads/origins/515d379e-88e6-4381-9321-65ef69fd9a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=deb32c5d1959c86b0ebe9e1180c375f1", "src_set": ""}, "body": "こんにちは。skeb依頼２回目です。\n以下ベースキャラに似た、オリキャラのイラスト作成を、お願い致します。\n妖精っぽい感じが出ていればOKです。　\n表情、ポーズなどはお任せします。描きにくければ、見た目年齢をベースキャラより上げても構いません。宜しくお願いします。\n\n作品名「リルリルフェアリル～妖精のドア～」　ベースキャラ名「すみれ」\n人間界とは別に、妖精界が存在するという世界観の、サンリオ系作品です。妖精キャラは、ベースが植物になっていて、内容は、妖精たちの日常を描いています。すみれは、とってもマジメな女の子。本を読む事と絵を描く事が大好きで、マジメさゆえか、妖精仲間にも敬語で話します。担当声優さんは、ゲームのガルフレの苗ちゃんも担当した、日高里菜さんです。\n\nhttps://www.tv-tokyo.co.jp/anime/rilurilufairilu/chara/", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuyuco015/works/37", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 107436, "client_id": 2657067, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8bef290a/uploads/origins/eaad9176-58d4-446f-91a9-2981adf71836?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cc3a85c81114c6d1a2b022fac69ed6b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8bef290a/uploads/origins/eaad9176-58d4-446f-91a9-2981adf71836?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a2ba47eb466fcc2ea3b0b6d3107dff8", "src_set": ""}, "body": "猫村ゆゆこ 様\n\n猫村ゆゆこ 様のとても可愛いイラストを\nVtuberさんへFAとしてまた送りたいので\nもし可能でしたら何卒よろしくお願いいたします！\n\n【Vtuberの名前】\n幽々木ゆゆ\nTwitter： https://x.com/yuyugiyuyu\nYoutube：https://www.youtube.com/@YuyugiYuyu\n \n【参考画像】\nhttps://x.com/cawaiiobake/status/1734453953818148938\n\n【構図・イメージ】\n猫村ゆゆこ 様の絵柄で自由に可愛い感じに書いていただければ幸いです。\n\n【使用用途】\nVtuber様本人に限り使用許可を頂きたいです。\n※Twitter、Youtubeサムネイル(収益化済)に使用\n\n【その他】\n人物・背景等が分かれているデータで頂けると有難いです。\n\nFA許可はこちらで確認しております。\nhttps://lit.link/yuyugiyuyu\n\n以上、ご検討よろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuyuco015/works/36", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 107436, "client_id": 977190, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/edbb1463/uploads/origins/4bdd5ad6-fd58-49c4-9684-e46c9f8b12f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=368f0535573d57d332cc27a57e2921a6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/edbb1463/uploads/origins/4bdd5ad6-fd58-49c4-9684-e46c9f8b12f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79e5ff63906ccb16dffae937dce74a97", "src_set": ""}, "body": "猫村ゆゆこ🌸🐰様 初めまして。\nあなたの描くイラストの可愛さに惹かれこの度依頼させていただきました  \n\n描いていただきたいのは、Vtuber活動を行っているぴーこ🐹☁️さんをお願いしたく思います。  \n構図・内容は全てお任せいたします。\nですが表情は通常、笑顔、闇堕ち(ハイライトなし)の3パターンをお願いたいです。\n 髪型は三つ編またはショートのどちらでも構いません。ですが帽子は三つ編みなら有り、ショートなら無しでお願いします。\n\n   ①ぴーこさんの活動で使用する可能性があります （Twitterの投稿やYoutubeのサムネ、その他非営利目的で使用します）\n ②PSD形式で、背景・キャラ・サインの3点を分けていただけると嬉しいです。\n\n【資料】\nhttps://x.com/piko_pinapi/status/1776892908937032026?s=46&t=r0PoIBfSbWrH5qyD9ay_Pg\n\nご検討頂けますと幸いです。よろしくお願いします\n\nhttps://x.com/piko_pinapi/status/1776892908937032026?s=46&t=r0PoIBfSbWrH5qyD9ay_Pg", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuyuco015/works/35", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 107436, "client_id": 2158642, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f019c101/uploads/origins/3368da94-d7dc-467b-92f6-1813b4394ee2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=caceed8241575db951f931d6ba67f88e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f019c101/uploads/origins/3368da94-d7dc-467b-92f6-1813b4394ee2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4435b13c31d7fde04c35cf26cf575cc8", "src_set": ""}, "body": "お世話になっております！\nツインテールのイラストを拝見し、またイラストをお願いさせて頂きたく、ご連絡いたしました。\n\n全ておまかせでリンデン・菜の花さんを描いて頂きたいのですがよろしいでしょうか…⁉️\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://x.com/l_nanoka/status/1824978278589075516?s=46&t=t02wgo-aznMtT-bOS-WNJg", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuyuco015/works/34", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 107436, "client_id": 369177, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8b28fb1/uploads/origins/77dfaf5b-f5f6-4370-98b6-09f91bace846?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=328598c2726dd230d954132744bbff49", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8b28fb1/uploads/origins/77dfaf5b-f5f6-4370-98b6-09f91bace846?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e9beba8054a3ef5d8ebf6670a21a7b7", "src_set": ""}, "body": "こんばんは！\n新着から作品を拝見し、とっても可愛らしい絵柄に惹かれましたので、 ぜひご依頼させていただきたいです。\nよろしければ、下記のファンタジー世界の妖精さんをお願いします。\n自然を抜け出して人間と契約し、街で暮らしている子です。\n\n名前: アウローラ・オーレリウス（Aurora Aurelius）\n種族: シルフィード（混血）\n大きさ: 25cm\n性格: クール、礼儀正しいがトゲがある\n身体的特徴:\n・色白\n・銀髪ロング\n・明るい緑の瞳、少し三白眼気味\n・エルフっぽい尖った耳\n・シンプルで透明な翼（ある程度自由な形に変えられます）\n\n服装:\n風の妖精としては踊り子衣装や下着のような風通しの良いものを着ていますが、人前に出るときは（本人は見られても平気ですが一応のマナーとして）上から人形用の服を着て隠しています。\n上から何か着る場合、シフォンやシルクのような高級感ある素材にこだわっています。\nどちらで描いていただいても大丈夫です！\nなお、翼は身体と接していない・出し入れ自由なため、衣服の形は制約なしと考えていただいてOKです。\n\nその他:\n・イメージカラーは白、緑、青ですが、必ずしもこの通りでなくともかまいません。\n・翼の動きは羽ばたくというより、ふわふわ浮く感じです。\n・基本的にクールでツンツンしており、三白眼気味なこともあって表情が固くなりがちです。\n（作品内では自由に表現していただいてかまいません）\n・空間にポータルを開いて鞄代わりにし、物を出し入れできます。\n　普通の人間が持てる重さの物は魔法で持ち上げることができます。\n・甘い物が好きで、特にケーキが大好物です。\n・契約者に呼ばれていない間は、レストランのウェイトレスとして働いています。\n\nその他、特に記載していない部分はすべておまかせいたします。\n以上です。ご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/17xxBWImpVE2xe_UWLSLtaKeCbUvepT5y", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuyuco015/works/33", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 107436, "client_id": 1605316, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd278f91/uploads/origins/bb79f4be-128a-44bc-8b6e-6abcd269febb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8efdc7cfb0529cae2e1b96da239b7f7e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd278f91/uploads/origins/bb79f4be-128a-44bc-8b6e-6abcd269febb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26a574ad35b0c1602731a8ebd572fad7", "src_set": ""}, "body": "猫村ゆゆこ様\n\nはじめまして、グラルと申します。Xで可愛いイラストを拝見して以前から依頼したいと思っており、この度依頼させていただきました。\n\n早速ですが、SEGAの音楽ゲーム「オンゲキ」の藤沢柚子ちゃんのイラストをお願い致します。\n衣装は資料として添付したようなセーラーワンピースでお願いします！表情や構図はお任せいたします。小学生くらいの見た目で描いていただきたいです。\n\n資料として、公式サイトのキャラクター紹介とwikiのカード一覧と衣装の詳細がわかるのURLを添付いたしました。参考にしていただければ幸いです。\n\n資料\n・公式サイト　キャラクター紹介\n(https://ongeki.sega.jp/character/1020/)\n・カード一覧\n(https://gamerch.com/ongeki/entry/462628)\n・セーラーワンピース　資料\n(https://www.yumekawagirl.com/items/85557219)", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuyuco015/works/32", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 107436, "client_id": 3108690, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2e057f7e/uploads/origins/4540262c-bb3c-4479-b951-af1ca038fdcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56d247d941d8a9e91365430f12fc2443", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e057f7e/uploads/origins/4540262c-bb3c-4479-b951-af1ca038fdcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b88f776da50072fe3007391a9af9addb", "src_set": ""}, "body": "こんにちは！あなたの作品を見て、本当にかわいいと思いました!大好きなvtuberの千秋かつみの絵をお願いしたいと思っていました。彼女はとてもかわいいのですが、時々生意気でやんちゃです。恥ずかしがり屋で、すぐ慌てます。\n\nかわいいハロウィンドレスを着た彼女を描いていただけませんか？デザイン、ポーズ、表情はあなた次第！ハロウィンまでに仕上げていただけると助かります！\n\n千秋の参考\nhttps://twitter.com/ChiakiKatsumi/status/1675748859643850752\n\nありがとうございました！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuyuco015/works/31", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 107436, "client_id": 3220529, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35f0b5a5/uploads/origins/ac83da90-da15-4c11-b580-f160bec664fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=908c51f1b3722f0c19d8bd8bb6712a15", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35f0b5a5/uploads/or