NUSfdZkM-EksQy6NajBT?usp=sharing\n\n■使用目的\nTwitterやYoutube等配信サイトでのサムネイル、ツイート、音楽動画、アイコン等に使用させていただきたく思っておりますので、許可をいただける場合のみリクエスト承認いただければと思います。\n\n■構図やポージング\nキャラに合いそうなものであれば特に指定はございませんので。\nサイズ構図全てお任せ致します。\nお好きなように描いて頂ければと思います。\n\n■その他\n背景については、あれば嬉しいのですが、キャラのみでも構いません。\n活動の際、別途YouTubeのサムネなどの活動目的で使わせて頂きたいとも思っています。\nサムネイルに使用する都合上、キャラクターと背景とサインで分けていただきたいです。\n\nSkeb：公開可\nTwitter、pixiv：公開可\n作品が一覧に表示されません。ただしクリエイターは作品を自由に公開する権利を有しています。\n\n\n要望が多いのは承知していますので、お断りしていただいても結構です。\n条件に問題なければ、何卒よろしくお願いいたします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tawasi_mogumogu/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1931062, "client_id": 899798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f2cf043f/uploads/origins/aaa8f714-c39d-478f-90e1-07840239fc32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16584f931f3bbe4b10eb65252cb484a7", "srcset": "https://si.imgix.net/f2cf043f/uploads/origins/aaa8f714-c39d-478f-90e1-07840239fc32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16584f931f3bbe4b10eb65252cb484a7, https://si.imgix.net/f2cf043f/uploads/origins/aaa8f714-c39d-478f-90e1-07840239fc32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ae5911f6d3438f1308752ff74aa719a 2x, https://si.imgix.net/f2cf043f/uploads/origins/aaa8f714-c39d-478f-90e1-07840239fc32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2abc8a7686424674b3ebca1c68b455f2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2cf043f/uploads/origins/aaa8f714-c39d-478f-90e1-07840239fc32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f63d248edd0d3a26ccd06f86fb23775", "srcset": "https://si.imgix.net/f2cf043f/uploads/origins/aaa8f714-c39d-478f-90e1-07840239fc32?bg=%23fff&a