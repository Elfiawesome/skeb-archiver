63f53a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11aae632b6afeb22fabd4994f2f26b62 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/64d0c357/uploads/origins/4d903a7d-fece-4012-b509-ead66963f53a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee36fbda9dc1cba8c339a122bf06e074", "srcset": "https://si.imgix.net/64d0c357/uploads/origins/4d903a7d-fece-4012-b509-ead66963f53a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee36fbda9dc1cba8c339a122bf06e074, https://si.imgix.net/64d0c357/uploads/origins/4d903a7d-fece-4012-b509-ead66963f53a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=499124ff95db0d3336a8d6d528da9b5a 2x, https://si.imgix.net/64d0c357/uploads/origins/4d903a7d-fece-4012-b509-ead66963f53a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=51624f7556eb64e1ff8008cf4710c925 3x"}, "body": "新品のたわし様\n\n初めまして！\nいつも素敵なイラスト陰ながら拝見させていただいております。\nぜひ、ご依頼をさせていただきたいです！\n\nこのたび、私のオリジナルキャラクターのイラストを依頼したいと思います。\n\nURLファイルでの【衣装設定画】及び【補充資料】をご参考くださいませ。\n（※服飾・髪型は【衣装設定画】のほうでお願い申し上げます。）\n\n▼【キャラクター設定】\n　描写していただきたいキャラクターは、中世の魔法世界での双子姉妹です。\n\n①赤：「紅蓮の魔女」（妹）\n・外見は17歳、ポーカーフェイスな銀髪赤眼の魔女。\n・幼い頃の記憶が封印され、森の中で育ち、生まれつきの強大な魔力で魔物に恐れられ、\n「森の魔女」が残した魔導書で魔法を覚えてきました。\n・元々は天真爛漫な性格で、16歳に森を出たところで信頼していた人に裏切られ、\n魔法が使えることを王国にバレて、王国軍に襲撃されていくうちに、性格が冷たい魔女になってしまいました。\n・火と攻撃型魔法が得意、魔法をかけると炎の蝶が飛び出します。\n・シスコン。\n・幼い頃から離れ離れになった姉との記憶は魔法によって蘇りました。\n\n②紫：「月の聖女」（姉）\n・人々に慕われている【月の神殿】の聖女。\n・肌は非常に白く、珍しいアメジスト色の瞳と長い銀色の髪が特徴です。\n・ちょっと人見知りで、優しく少し天然で和む人です。\n・妹と同じく生まれつきの膨大な魔力を持ち、氷と治癒魔法が得意です。\n・外見は16歳、綺麗な顔立ち、皆に「高嶺の花」と呼ばれています。\n・実はずっと妹を探しており、妹が魔女になっても大切にしていきたいと思っています。\n\n▼【依頼補足】\n・構図はお任せ致します。\n・イラストの縦横、不明点やアレンジ、表情、背景、ポーズなどの解釈もお任せ致します。 　\n・服飾の簡略化・変更も自由です。\n\n\n当方Skebを利用した経験が無く、知識が乏しい上に何か不備等があれば申し訳ありません。\nリクエスト内容に興味がありましたら請けていただけると幸いです。\nご検討のほど宜しくお願いいたします。\n\n▼資料URL\nhttps://drive.google.