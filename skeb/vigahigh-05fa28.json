ったビニールを持っている、日本酒を持っている等）、はねだちゃんの方はお酒を飲みながらも少し困惑してそうな顔をさせてください。\n（構図の関係でどちらがが目を閉じて寝たり笑ったりする感じになったら開眼差分もほしいです。）\n可能でしたら簡易的で良いのでこの2人が居酒屋で飲んでる絵もつけてほしいです。（その際友人ちゃんにはハイボールジョッキを持たせて、九州なまりをさせてほしいです。）\n二人の身長は同じくらいです。服装や髪型容姿等は描きやすいようにしてもらえれば幸いです。\n\nお時間ありましたらよろしくおねがいします。\nhttps://drive.google.com/folderview?id=1sj_p6HsPgiy2kCbbPDrkpvjCyxtg5-LR\n\nhttps://drive.google.com/folderview?id=1sj_p6HsPgiy2kCbbPDrkpvjCyxtg5-LR", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@vigahigh/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/865ac26f/uploads/origins/9837aca5-ac79-46cf-a605-dc791159ab43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=224c95875dff72e37ee236aa17121948", "srcset": "https://si.imgix.net/865ac26f/uploads/origins/9837aca5-ac79-46cf-a605-dc791159ab43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=224c95875dff72e37ee236aa17121948, https://si.imgix.net/865ac26f/uploads/origins/9837aca5-ac79-46cf-a605-dc791159ab43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1827f73f8924e07d859d7338f419a0f0 2x, https://si.imgix.net/865ac26f/uploads/origins/9837aca5-ac79-46cf-a605-dc791159ab43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b814129e6c3bae2e3ddda276a87207ac 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2272164, "nc": 160}, {"path": "/@vigahigh/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2272164, "client_id": 63536, "vtt_url":