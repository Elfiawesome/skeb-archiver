n ・髪の毛で隠れていますが、黒い羽があります \nhttps://drive.google.com/file/d/12U9ud7wZ4Kj9QnyN554k2eM3E3hFzDy2/view?usp=drivesdk\n\n▽その他 ・背景がある場合は人物とレイヤーを分けていただきたいです。\n ・アスペクト比9：16で作成お願いします。（縦イラスト希望）\n ・納品形式はPSDファイルですと有難いです。\n\n  ▽各種リンク \ntwitter：https://twitter.com/Aoi_Tsukishiro \nyoutube：https://www.youtube.com/channel/UCU_xRFdTRIneHBBAgNhSNaw   \n\nどうぞ宜しくお願いします🥰", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@UyuMisia/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1651052, "client_id": 2155538, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c97b748/uploads/origins/e02fdc26-fca1-4e62-9d1f-47dcc5620379?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36401d38db2c5b16c860c08038f1f844", "srcset": "https://si.imgix.net/0c97b748/uploads/origins/e02fdc26-fca1-4e62-9d1f-47dcc5620379?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36401d38db2c5b16c860c08038f1f844, https://si.imgix.net/0c97b748/uploads/origins/e02fdc26-fca1-4e62-9d1f-47dcc5620379?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=281b6935976414ae1488d4485c171a78 2x, https://si.imgix.net/0c97b748/uploads/origins/e02fdc26-fca1-4e62-9d1f-47dcc5620379?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e69963f36cc1bddba9ddfcba11a1caa8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c97b748/uploads/origins/e02fdc26-fca1-4e62-9d1f-47dcc5620379?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cee99b83d53090633316dafb0fbc8a78", "srcset": "https://si.imgix.net/0c97b748/uploads/origins/e02fdc26-fca1-4e62-9d1f-47dcc5620379?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cee99b83d53090633316dafb0fbc8a78, https://si.imgix.net/0c97b748/uploads/origins