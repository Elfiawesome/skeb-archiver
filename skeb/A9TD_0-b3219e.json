p&w=200&h=200&blur=200&s=c48264ea4b43c9aa8c62756e678088ed, https://si.imgix.net/9f1c45b8/uploads/origins/52241844-c5dc-413e-8af2-331680c9fb8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7bde08d0eb76e6789906a4d1e7a0a414 2x, https://si.imgix.net/9f1c45b8/uploads/origins/52241844-c5dc-413e-8af2-331680c9fb8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f96ae9d1897f19874bfaad5a069cc1af 3x"}, "body": "こんにちは、コミッションを受け付けているのを見て嬉しいです！ビーチでライフガードをしているハイエナのイラストを依頼したいです。上半身は裸で、サングラス（額にかけた状態）とショートパンツだけを身につけ、肩にサーフボードを乗せた姿で描いてください。 注意点として、耳は本物のハイエナのようにもっと丸く描いてください。また、普通のスイムショーツ姿のバージョンと、半透明で濡れた白い下着姿のバージョン（ペニスの色が少し透けて見えるもの）も用意していただけると助かります。参考画像の一部がR18なのでNSFW設定を有効にしましたが、黒塗り処理を避けるため、イラスト自体はほのめかす程度にしてほしいです。今回はリンクを確認しました、ありがとうございます！\n\nhttps://drive.google.com/drive/folders/17vZ6eR63ea_mXltelDxXX0oufyYZHwXC", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@A9TD_0/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3732764, "client_id": 1052806, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c38cb7ae/uploads/origins/24e37636-5c12-47e7-b99a-b3dc20e4fbd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41657b37bc1b2429d6091fb33e1c2385", "srcset": "https://si.imgix.net/c38cb7ae/uploads/origins/24e37636-5c12-47e7-b99a-b3dc20e4fbd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41657b37bc1b2429d6091fb33e1c2385, https://si.imgix.net/c38cb7ae/uploads/origins/24e37636-5c12-47e7-b99a-b3dc20e4fbd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee0ffe8b43aaebe316e9d625b6b7e83b 2x, https://si.imgix.net/c38cb7ae/uploads/origins/24e37636-5c12-47e7-b99a-b3dc20e4fbd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4a2b90f3d015eaae56ec008927fdc77 3x"}, "duration": null, "n