e3f01910f060055319542253d8bd75f3, https://si.imgix.net/9f917306/uploads/origins/59fd625f-af9f-4176-81ea-febebaee1f3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4af6e98f94459ff616835232f3ebb22 2x, https://si.imgix.net/9f917306/uploads/origins/59fd625f-af9f-4176-81ea-febebaee1f3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=066faad005820f4e0b7b634935ee336f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f917306/uploads/origins/59fd625f-af9f-4176-81ea-febebaee1f3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b3280f5c91b4c41bcdcfe19f5b453e2", "srcset": "https://si.imgix.net/9f917306/uploads/origins/59fd625f-af9f-4176-81ea-febebaee1f3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b3280f5c91b4c41bcdcfe19f5b453e2, https://si.imgix.net/9f917306/uploads/origins/59fd625f-af9f-4176-81ea-febebaee1f3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5236b6f9501ebdb818090b09173e3c70 2x, https://si.imgix.net/9f917306/uploads/origins/59fd625f-af9f-4176-81ea-febebaee1f3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0dc1e1185b3ae5c8107545329e68f350 3x"}, "body": "こんにちは！最近skebをオープンされたようなので、この機会を待っていました。\n\n私のドラゴンのキャラクターが屈伸しているポーズのアートワークをお願いしたいです。最終的なポーズは、彼の体格を誇示するような、あなたが選んだものでいいです。彼は通常裸ですが、スリットを見せても見せなくても構いません。背景はシンプルな色で構いません。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1r5uG31Gz3ydQw-rIQqAoS_72GQoMMKB7?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@A9TD_0/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3732764, "client_id": 163131, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3fbb4887/uploads/origins/c16d3a11-b640-4a2c-9cf6-5e58ae257cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=821dc20521a8d7491c673aec1317768d", "srcset": "https://si.imgix.net/3fbb4887/uploads/origins/c16d3a11-b640-4a2c-9cf6-5e58ae257cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=821dc20521a8d7491c673aec1317768d, https://si.imgix.net/3fbb4887/uploads/origins/c16d3a11-b640-4a2c-9cf6-5e58ae257cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5934fff9c7d13f3479b621c37dcd4078 2x, https://si.imgix.net/3fbb4887/uploads/origins/c16d3a11-b640-4a2c-9cf6-5e58ae257cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4eee269ea406cea67aa264f137574ffe 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3fbb4887/uploads/origins/c16d3a11-b640-4a2c-9cf6-5e58ae257cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8623b74aec351578345ef64ea4ad9998", "srcset": "https://si.imgix.net/3fbb4887/uploads/origins/c16d3a11-b640-4a2c-9cf6-5e58ae257cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8623b74aec351578345ef64ea4ad9998, https://si.imgix.net/3fbb4887/uploads/origins/c16d3a11-b640-4a2c-9cf6-5e58ae257cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c1968b6c203cdf0702270cd1c881cab1 2x, https://si.imgix.net/3fbb4887/uploads/origins/c16d3a11-b640-4a2c-9cf6-5e58ae257cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ff7ace6bd498f15ef297b1eab96406a4 3x"}, "body": "初めまして、いつも素敵なイラスト拝見しております。skebの募集を始めたと伺って早速送らせていただきました。\n\n私のOCの獣人「あおいいぬ」を描いていただきたく依頼します。\n過去に自分が描いたもの、依頼などで描いていただいたものを資料URLに置いていますのでご参考ください。\n\nシチュエーションについてですが、「ジムの更衣室の鏡の前でポーズをとってる」みたいな様子をお願いしたいです。\n毛皮の色と黄色い目、チャームポイントの赤いバンダナ以外はこだわりがないので、自由に手癖で描いていただければと思います。\nまた、ディティール（服や下着、小道具や模様、アクセサリーなど）も好きなように描いてください！\n\n永久凍土さんの筋肉の描き方とか塗り方がすごく好きなので、もし可能でしたら服のありなしそれぞれの差分をいただけると嬉しいです。\nまた、R18をつけてますが、描写はなくても大丈夫です（もしありならこちらも差分でいただけると嬉しいです）。\n\n筋肉の立体感とか光の塗り感が好きなのでそちらを強調していただけると嬉しいです。\n\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1e2h-CEfApEr6tljlO2VzjaQsRrgC-ZlT?usp=share_link", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 95233, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "人力犬＠jinriki-inu.bsky.social", "screen_name": "jinriki_inu", "avatar_url": "https://pbs.twimg.com/profile_images/985537346325000192/RfAAzP2K.jpg", "header_url": "https://pbs.twimg.com/profile_banners/720953431339323392/1720361815/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 864194, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ドリームメーカー@Skeb募集中", "screen_name": "FurryDolly810", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fcce3acd4-fb32-48ed-aa90-548604384bda.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/d22f7ebf-f5a9-41ec-9a40-b9ac396544b9.png?sensitive=true", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 2417099, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "くじ", "screen_name": "kuji0419", "avatar_url": "https://pbs.twimg.com/profile_images/1548249550057779201/kJRaVkvw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1512279949113434121/1659069314/1500x500", "appeal_receivabl