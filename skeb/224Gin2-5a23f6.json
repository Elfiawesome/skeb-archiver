200&s=4d7ead54825b0f23b3f9b8f08b50caa2, https://si.imgix.net/2f508b9e/uploads/origins/1a5070e1-0b26-4e3d-853c-6516b7620f70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bea0bcad9a9aeb52802422a4e59c91a3 2x, https://si.imgix.net/2f508b9e/uploads/origins/1a5070e1-0b26-4e3d-853c-6516b7620f70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3370ee0da77a735e23e9bf8ac01be73a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f508b9e/uploads/origins/1a5070e1-0b26-4e3d-853c-6516b7620f70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3e4adb1848ac25e284afd019c9407c9", "srcset": "https://si.imgix.net/2f508b9e/uploads/origins/1a5070e1-0b26-4e3d-853c-6516b7620f70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3e4adb1848ac25e284afd019c9407c9, https://si.imgix.net/2f508b9e/uploads/origins/1a5070e1-0b26-4e3d-853c-6516b7620f70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9d0c30d87bef9f41233fab134eb0ecb2 2x, https://si.imgix.net/2f508b9e/uploads/origins/1a5070e1-0b26-4e3d-853c-6516b7620f70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=debb8e09f959e675a10461c07d7a213f 3x"}, "body": "なのはの露出作が素晴らしかったのであのコンセプトでリクエストします\n\nヒロインは同作の「フェイト(大人)」\n\n共通設定\n\n① バリアジャケットの上に羽織る白いマントのみでその中は下着だけの状態\n\n     (露出プレイで定番のコートの下は下着のみのイメージ)\n\n② \n背景はなのはと同様でOK，ただし撮影画面描写(SNSで流出させられる)でお願いします\n\n\nシーン1(堕落前)\n\n① 両手でマントをガバっと開かせ下着姿を晒さす\n\n② 表情はなのはと同じく，口惜しさと恥ずかしさを同居させる\n\n     \n目のハイライトを消したレイプ目状態に，羞恥に負けてカメラからやや顔を反らす(目線はカメラ目線)\n\n③ 下着は白のレースで太ももまである白のストッキング\n\n④ 右のおっぱいに「91cm(H)」\n\n⑤ お腹に「♡調教中♡」\n\n\nシーン2(堕落後)\n\n① 両手でマントをガバっと開かせ下着姿を晒さす\n\n② 瞳に♡を浮かばせる\n\n③ 顔を可愛らしく斜めにかしげて，うっとりとした表情を向けさせる\n\n④ おっぱいをシーン1より一回り大きくし，母乳を垂らさす\n\n⑤ 左の乳首に名札を付ける(乳首に名札のピンをぶっさす)\n\n   \n  名札には「たっくん専用雌牛奴隷」「フェイト・T・ハラオウン」と上下二段に分けて記載\n\n⑥ 下着は黒のオープンブラ(カップの部分が下乳のところだけ)＋ガーター\n\n⑦ 左目の下左目寄りに「●と▼」で男子トイレマーク\n\n⑧ 右のおっぱいに「98cm(J)」左のおっぱいに「極上ミルクサーバー」\n\n⑨ お腹に「♡懐妊済♡」\n\n⑩ おまんこにローター2つ仕込み中，リモコン2つはストッキングに挟む\n\n     ※ ローターが作動しているのがわかるように，身体がビクついている表現", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@224Gin2/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 220750, "client_id": 232138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69b4c347/uploads/origins/32407a6b-983e-460a-abfd-6ac81a7be461?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9235795c22555633dee7d442d668e9bf", "srcset": "https://si.imgix.net/69b4c347/uploads/origins/32407a6b-983e-460a-abfd-6ac81a7be461?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9235795c22555633dee7d442d668e9bf, https://si.imgix.net/69b4c347/uploads/origins/32407a6b-983e-460a-abfd-6ac81a7be461?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a20388ccfb8e2155222b764652770b3b 2x, https://si.imgix.net/69b4c347/uploads/origins/32407a6b-983e-460a-abfd-6ac81a7be461?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2260a5251412ad8d6040939515af2ee0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69b4c347/uploads/origins/32407a6b-983e-460a-abfd-6ac81a7be461?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6af9dadc6851fe474ed0eac64fa73be3", "srcset": "https://si.imgix.net/69b4c347/uploads/origins/32407a6b-983e-460a-abfd-6ac81a7be461?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6af9dadc6851fe474ed0eac64fa73be3, https://si.imgix.net/69b4c347/uploads/origins/32407a6b-983e-460a-abfd-6ac81a7be461?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=46307b139e37b0f5dd54411976755788 2x, https://si.imgix.net/69b4c347/uploads/origins/32407a6b-983e-460a-abfd-6ac81a7be461?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4b5466a25db3c303137b9a533619432c 3x"}, "body": "先日はありがとうございました。\n\n高町なのは(いつの時代かはお任せします)が露出プレイをしているイラストをお願いしたいです。\n\n以下細かい要望です。\n・シチュとしては、野外でこっそり服を半脱ぎしている状態にしてください。\n・催眠をかけられている、あるいは脅迫や権力で逆らえなくて…みたいな感じでお願いします。\n・スーツ姿でおっぱいをボロンと丸出しにして、スカートも捲ってノーパン状態の股間を見せて欲しいです。\n\n以上になります。\nよろしくお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@224Gin2/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fdafe843/uploads/origins/dbb46e84-e47a-4183-8157-c24bb54e5721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4291b4cec462172a1b6f78fc0b8240fb", "srcset": "https://si.imgix.net/fdafe843/uploads/origins/dbb46e84-e47a-4183-8157-c24bb54e5721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4291b4cec462172a1b6f78fc0b8240fb, https://si.imgix.net/fdafe843/uploads/origins/dbb46e84-e47a-4183-8157-c24bb54e5721?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c0a0fa43c7e6fc513ad834b1d8a6fa4 2x, https://si.imgix.net/fdafe843/uploads/origins/dbb46e84-e47a-4183-8157-c24bb54e5721?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e919a4ccdd05103b5814cb3d85b35de3 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 220750, "client_id": 544538, "nc": 160}, {"path": "/@224Gin2/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_i