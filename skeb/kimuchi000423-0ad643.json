 黒 赤と交互に色分けしてネイルをしてます。\n性格はイラストに反映されるかは分かりませんが。来る者拒まず去るもの追わずでセフレを数人作っている男です。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1984956, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ibara.", "screen_name": "ibara_380", "avatar_url": "https://pbs.twimg.com/profile_images/2066735091813171200/ck-mS1Up.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2692035049/1770060695/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 2168481, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "宇宙野ユニコ🦄💫", "screen_name": "SoranoUnico", "avatar_url": "https://pbs.twimg.com/profile_images/1925474891169767428/auAtx0J5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1209776237503111169/1732784734/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 40, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 128}, {"id": 2655485, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "林ちい", "screen_name": "chi_momosui", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:xpddoe5mifuscqcz4o5nkgaz/bafkreibcgmndflfu7vw54i7iv5ntrg7shriiffc4rkkjl4s5dykomrowi4", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 4, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, 