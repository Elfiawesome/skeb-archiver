0f-f237-4c2f-85e6-b7f8994a4fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3cb21a87d17a8265496b48f05c789f0d 2x, https://si.imgix.net/ea3d41a1/uploads/origins/a696350f-f237-4c2f-85e6-b7f8994a4fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca2892cf3954c37e50fcca6f2bc556c7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea3d41a1/uploads/origins/a696350f-f237-4c2f-85e6-b7f8994a4fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95ffdb04a5fd95b7c2f0603e8138a89c", "srcset": "https://si.imgix.net/ea3d41a1/uploads/origins/a696350f-f237-4c2f-85e6-b7f8994a4fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95ffdb04a5fd95b7c2f0603e8138a89c, https://si.imgix.net/ea3d41a1/uploads/origins/a696350f-f237-4c2f-85e6-b7f8994a4fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e0b21a4ec38c4048ed1facc01ce6ffea 2x, https://si.imgix.net/ea3d41a1/uploads/origins/a696350f-f237-4c2f-85e6-b7f8994a4fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3aa2742a292837b0e9759d0be645f0ec 3x"}, "body": "先生、こんにちは。私は以前から、先生が手掛ける美しく魅力的な作品を大変気に入り、注目してきました。先生の描くキャラクター、特にhorrorshift(preboot)!charaとhorrorshift(reboot)!charaのデザインや雰囲気には、いつも強く惹かれています。\n今回お願いしたいのは、この2人のキャラクターを一緒に描いたイラストを1枚描いていただけないかということです。それ以外の部分はすべて先生にお任せしますので、どうぞご自由に創作してください。このイラストは、私用のパソコンやスマホの壁紙、個人的な鑑賞用グッズの制作、およびSNSへの投稿（非営利目的）に使用させていただきたいと考えています。\n先生の画風が本当に大好きですので、ご自身の好みや気分に合わせて、気楽に創作していただければ幸いです。お忙しい中お手数をおかけしますが、ご検討いただければ幸いです。よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SyaKeWo_san/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3009196, "client_id": 3071627, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc90028d/uploads/origins/342565cb-111e-4895-9c83-5f4202765dd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63acbc326b0e8a5cb996258016334027", "srcset": "https://si.imgix.net/fc90028d/uploads/origins/342565cb-111e-4895-9c83-5f4202765dd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63acbc326b0e8a5cb996258016334027, https://si.imgix.net/fc90028d/uploads/origins/342565cb-111e-4895-9c83-5f4202765dd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb49d1f7de730c6cd64375f4e1cca0a1 2x, https://si.imgix.net/fc90028d/uploads/origins/342565cb-111e-4895-9c83-5f4202765dd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef20e72273265fd333ba44b7507b721d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc90028d/uploads/origins/342565cb-111e-4895-9c83-5f4202765dd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b51705d0469b182195673b5088dd81c", "srcset": "https://si.imgix.net/fc90028d/uploads/origins/342565cb-111e-4895-9c83-5f4202765dd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b51705d0469b182195673b5088dd81c, https://si.imgix.net/fc90028d/uploads/origins/342565cb-111e-4895-9c83-5f4202765dd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8136395da77e7d312a9f769c4ef9f241 2x, https://si.imgix.net/fc90028d/uploads/origins/342565cb-111e-4895-9c83-5f4202765dd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=387599a9cec8a748488fade0c9f9c4f7 3x"}, "body": "先生、こんばんは。\nこんな時間に応募してしまい、本当に失礼いたします。\n先生の画風が大好きなので、ぜひ描いていただけたらと思い、挑戦させていただきました！\n \n以下、キャラクター設定とご依頼です。\n \n1人目のキャラクター：\n服装は青色系。\n属性は無表情・引きこもり・精神的な疾患を抱えている設定です。\n性格は内向的で、表面的には何事もないように見せていても、内面では感情が崩壊しやすいタイプです。\n注意点：\nインナーはハイネックのセーター、前髪は長めにお願いいたします。\n \nもう1人はStoryShiftのCharaです！\n設定はご存知だと思いますので、詳しくは書きません。\n先生のご解釈で自由に描いていただければ幸いです。\n \n構図や内容は完全にお任せです。\n他のことは気にせず、先生自身が楽しんで描いてください。\n最後になりますが、どうぞよろしくお願いいたします。\n\n老师你好，这么晚才来投递真是打扰了！十分喜欢你的画风！所以想来尝试委托你来绘制作品！\n以下是设定和要求：\n蓝色衣服的属性是三无/家里蹲/有精神疾病\n性格自闭是容易表面无事但是内心情绪崩溃的那一类\n（要注意！里面是有高领毛衣的并且刘海是偏长的类型！）\n\n另外一位是storyshift的chara！我想您应该是熟悉设定的，所以应该不需要我来写设定了！按照您自己的理解来画就行了\n\n创作内容请随意来，不用担心其他的问题！请自由的创作，让自己开心就好——最后提前辛苦了！\n\nhttps://drive.google.com/drive/folders/1-15gvr40bFFeT_cbsiLuFGIQhZh03owr", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SyaKeWo_san/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3009196, "client_id": 3736194, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98aea4f5/uploads/origins/80af8a60-9476-42cc-b9a2-78984352d071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f87ab95aaea9959d308b04167cc641ac", "srcset": "https://si.imgix.net/98aea4f5/uploads/origins/80af8a60-9476-42cc-b9a2-78984352d071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f87ab95aaea9959d308b04167cc641ac, https://si.imgix.net/98aea4f5/uploads/origins/80af8a60-9476-42cc-b9a2-78984352d071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19f4a7b86b1c78d492d5bd0fa490ba5a 2x, https://si.imgix.net/98aea4f5/uploads/origins/80af8a60-9476-42cc-b9a2-78984352d071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6196e8fbf1a21374248e0ec0d18cb136 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98aea4f5/uploads/origins/80af8a60-9476-42cc-b9a2-78984352d071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37c0ea05ecfdabadfd3ed950ed2080c2", "srcset": "https://si.imgix.net/98aea4f5/uploads/origins/80af8a60-9476-42cc-b9a2-78984352d071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h