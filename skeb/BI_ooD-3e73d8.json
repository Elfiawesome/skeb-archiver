雅で繊細であり、概してダンサーのような自然な落ち着きを漂わせている。 じっと立っている時でさえ、軽やかで優しい印象を与えるべきです。彼の表情は通常、控えめです。下を向いたまつげ、少し開いた唇、ほのかな赤面、あるいはかすかな微笑みといったものが、大げさな反応よりも彼に似合います。\n\n\n彼は本当にとても可愛らしく、幻想的です。彼には夢のような雰囲気があります。彼をご検討いただき、誠にありがとうございます！", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BI_ooD/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4035232, "client_id": 3128405, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/006e0794/uploads/origins/47e072b2-755d-4e58-953f-e825ce1cfb1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14e17969689bc429a2d5d2358555f8d1", "srcset": "https://si.imgix.net/006e0794/uploads/origins/47e072b2-755d-4e58-953f-e825ce1cfb1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14e17969689bc429a2d5d2358555f8d1, https://si.imgix.net/006e0794/uploads/origins/47e072b2-755d-4e58-953f-e825ce1cfb1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=898567e811c07927dfba2933eb49ae26 2x, https://si.imgix.net/006e0794/uploads/origins/47e072b2-755d-4e58-953f-e825ce1cfb1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66efbaed951a21e92fdc6bc242d527d6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/006e0794/uploads/origins/47e072b2-755d-4e58-953f-e825ce1cfb1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d13cc0774de759b6893f738859e1ddb", "srcset": "https://si.imgix.net/006e0794/uploads/origins/47e072b2-755d-4e58-953f-e825ce1cfb1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d13cc0774de759b6893f738859e1ddb, https://si.imgix.net/006e0794/uploads/origins/47e072b2-755d-4e58-953f-e825ce1cfb1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f8dce2be823ac25c79a1e2