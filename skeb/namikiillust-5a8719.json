illust/status/1628739769768480768?t=5p0Jh6zIuL2cTRmxhlunSg&s=19\n\n◆構図・シチュエーション\nシチュエーションは、しゃがんで制服を脱いでいる途中という設定です。\n上半身は上記イラストのようにシャツのリボンをほどき、ボタンをいくつか外してブラが覗いている感じが理想です。\n\n下半身はスカートは脱いでショーツのみです。\n特に足（特に爪）の描写が好きなので、ほぼ全ての足爪が見える姿勢で描いてもらえると嬉しいです。\n\nなるべく全身を画面に大きく収めていただけると嬉しいです。\n\n◆もし可能であれば…\n下着なしのバージョンもいただけると非常に喜びます（一応NSFW設定にしておきます）。\n難しい場合は無視していただいて大丈夫です！\n\n◆納品\nPSDとPNG形式でお願いします。\n\n以上、\n上記はあくまでイメージですので、構図的に難しい場合など、ご自由にアレンジいただいて大丈夫です！\nどうぞよろしくお願いいたします。\n\nhttps://twitter.com/silas_012/status/1624678045637550083?s=20", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@namikiillust/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1605530, "client_id": 1166552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/27e36f67/uploads/origins/4f59379e-90a6-488c-8b86-24ffce7b667b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb903af0c4a251c144c5c2047acb9645", "srcset": "https://si.imgix.net/27e36f67/uploads/origins/4f59379e-90a6-488c-8b86-24ffce7b667b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb903af0c4a251c144c5c2047acb9645, https://si.imgix.net/27e36f67/uploads/origins/4f59379e-90a6-488c-8b86-24ffce7b667b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a25e61767568b0164911a7cc9085bae 2x, https://si.imgix.net/27e36f67/uploads/origins/4f59379e-90a6-488c-8b86-24ffce7b667b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=288645ec67e77f26a3341d8d0643ba3d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27e36f67/uploads/origins/4f59379e-90a6-488c-8b86-24ffce7b667b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15cf7b136cf6857b4720a1e5e612d383", "srcset": "https://si.imgix.net/27e36f67/uploads/origins/4f59379e-90a6-488c-8b86-2