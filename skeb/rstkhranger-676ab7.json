ち（２～４人ほど）が、ゴーマ十五世や十六世のような全身白塗りになり、濃い口紅や濃いアイメイクの顔で、額に第三の目が開き、高位の存在に進化した喜悦に、横並びで高笑いをしている様子」\nというものになります。\n\n私は白塗り化粧が好きで、ゴーマ十五世や十六世に惹かれ、「女性キャラが、ゴーマ皇帝のような全身白塗りの荘厳な姿になったら、どんなに素敵だろう」とずっと夢想していました。\n\n女性キャラたちのデザインや衣装・装飾は雪乃様の感性にお任せ致しますが、全身白塗りの肌が艶々と輝いているテカリの表現を、実線でも効果でも良いので、可能な限り表現して下されば、幸いです。\n\n特殊な内容になりますが、ご検討の程、何卒よろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rstkhranger/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 15118, "client_id": 638155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4176818e/uploads/origins/2fc376fc-27bb-47f6-9afc-e82df206366f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7dc84f59ff29f251c105f462df618be", "srcset": "https://si.imgix.net/4176818e/uploads/origins/2fc376fc-27bb-47f6-9afc-e82df206366f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7dc84f59ff29f251c105f462df618be, https://si.imgix.net/4176818e/uploads/origins/2fc376fc-27bb-47f6-9afc-e82df206366f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e846705274c104772e703bfe2416e28 2x, https://si.imgix.net/4176818e/uploads/origins/2fc376fc-27bb-47f6-9afc-e82df206366f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d460d2bb2de8d1391ff854f7a05ae4c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4176818e/uploads/origins/2fc376fc-27bb-47f6-9afc-e82df206366f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66144fbf3fc7c1bdf7f96cccf9cbcc8b", "srcset": "https://si.imgix.net/4176818e/uploads/origins/2fc376fc-27bb-47f6-9afc-e82df206366f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66144fbf3fc7c1bdf7f96cccf9cbcc8b, https://si.imgix.net/4176818e/uploads/origins/2fc376fc-27bb-47f6-9afc-e82df