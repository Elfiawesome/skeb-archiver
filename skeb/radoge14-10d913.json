rive/folders/1oE-f0NXg0IjlXgmSV1sZFmrj7S0d4JZV", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@radoge14/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3906562, "client_id": 3124329, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80d99d55/uploads/origins/18903c59-1c35-4cda-9ebb-bcd95732272b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bec82a47a3413d6f6e2bbea7d3974f5f", "srcset": "https://si.imgix.net/80d99d55/uploads/origins/18903c59-1c35-4cda-9ebb-bcd95732272b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bec82a47a3413d6f6e2bbea7d3974f5f, https://si.imgix.net/80d99d55/uploads/origins/18903c59-1c35-4cda-9ebb-bcd95732272b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0238dc566632a088655dfb6a31a0be9 2x, https://si.imgix.net/80d99d55/uploads/origins/18903c59-1c35-4cda-9ebb-bcd95732272b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=740571b798d440b497f56e6a4b99c827 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80d99d55/uploads/origins/18903c59-1c35-4cda-9ebb-bcd95732272b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc85b954da6b17ade67f28a590a71a76", "srcset": "https://si.imgix.net/80d99d55/uploads/origins/18903c59-1c35-4cda-9ebb-bcd95732272b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc85b954da6b17ade67f28a590a71a76, https://si.imgix.net/80d99d55/uploads/origins/18903c59-1c35-4cda-9ebb-bcd95732272b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=accb152c49bba07d39df8cb39dfe5b35 2x, https://si.imgix.net/80d99d55/uploads/origins/18903c59-1c35-4cda-9ebb-bcd95732272b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4c577e6eccb29cbdf47fbd2db66cdce 3x"}, "body": "Radoge樣\n\nこんにちは！私はあなたの作品がとても素敵だと思い、ぜひ私のOCを描いていただけないかと思い、依頼を送らせていただきました。\n特にこのような作品好きで、もしできればこの型の絵を頼んで大丈夫ですか？\nhttps://x.com/radoge14/status/2018867273268904297?s=46&t=7l_UTKWOllNMLQZLnJdieQ\n「繭から蝶へ」をテーマにした創作が見たいです。この子の美しさ、脆い、そして強さが表現されていると嬉しいです。雰囲気や構図等はお任せ致します！\n\n【キャラクターの情報】\nhttps://drive.google.com/drive/folders/1Z45ME8H4AHU0D2q4pVzQgh_6zzD_qT2b\n揚羽 明華（男性 20歳）179cm  \n大学生で、サークルの演劇で主役を務めています。背中のマントは大切な演劇用小道具で、普段からよく身につけています。\n\n外見はどちらかというと中性的です。華奢な体格で、体重がとても軽いです。白い長い巻き毛を持っています。通常時の目は白いまつ毛とピンクの瞳ですが、状況によって瞳のピンク色の部分が目全体に広がることもあります。これら2つの状態は、お好きな方を選んで描いていただいて構いません。黒いショートマフラーと黒い手袋を着用し、グレーのコートの上に、黒とピンクの蝶の羽をイメージしたマントを羽織っています。黒いズボンとブーツを履いており、ブーツの裏はピンクです。\n*マントのデザインは、リンク先の1枚目の画像（黒いマントにピンクの斑紋があるもの）を参考にしていただければと思います。\n\n性格はナルシストなところがありますが、その加減をうまく調整できるタイプです。演劇をするときは、存在感と迫力にあふれ、それでいて非常に優雅でもあります。常に余裕を持ち、自信がないことには手を出しません。  \n\nとても寒がりで、甘いものが好きです。季節に関係なく厚着をして、温かい飲み物を飲んでいます。冬は絶対に外に出ないタイプです。いつも笑顔を絶やしません。\n\n宛名psdレイヤーでon/offできるとらしいです。金額不足の場合は再送要請も構いません。ご検討の程よろしくお願いいたします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@radoge14/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/09959f2b/uploads/origins/ffd89964-0ac5-48ad-9f51-94d413d83a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ebff0d6f36b915e1f0b216af6a5b1f06", "srcset": "https://si.imgix.net/09959f2b/uploads/origins/ffd89964-0ac5-48ad-9f51-94d413d83a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ebff0d6f36b915e1f0b216af6a5b1f06, https://si.imgix.net/09959f2b/uploads/origins/ffd89964-0ac5-48ad-9f51-94d413d83a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txt