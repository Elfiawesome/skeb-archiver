&w=200&h=200&blur=200&s=6acb858658eddd9b22af87888907759c", "src_set": ""}, "body": "設定: 日本の村の静かな月夜、屋根の上。忍者が傾斜した瓦屋根の端にしゃがみ、手にはハート型の箱を握っている。\n\n詳細: 村の周囲では敵がパトロールしているが、忍者の静かな潜入には気づいていない。遠くの城では恋人が待っている。（背景には、ぼんやりとかすかなチータの王子のシルエットが見える。）\n\n雰囲気: 静寂な夜の安らぎと禁じられた愛の緊張感が混ざり合い、ロマンチックでありながら緊張感のあるムード。\n\nhttps://drive.google.com/drive/folders/1v5h95-153sK_KJO0fBuMemnnbGlP_398?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/164", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15237, "client_id": 346239, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b492defc/uploads/origins/c7934663-e250-4328-b090-b6746bd9d923?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f36103d87f4713cd4257aeb40486be27", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b492defc/uploads/origins/c7934663-e250-4328-b090-b6746bd9d923?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b9e9e959115e82f1ba9670cfbb79227", "src_set": ""}, "body": "私のキャラクターをあなたのスタイル（例えばこのhttps://x.com/TOOMIRO/status/1860232856901140907）で描いて／デザインし直してもらえないだろうか。特徴2対の翼（上部は爪付き）と2対の腕、大砲（オプション、参考：https://skeb.jp/@tg_marlo/works/87）、あとはあなたの自由です！半竜人形（一対の腕、尻尾、小さな一対の翼）をこのスタイルで描いていただけるとうれしいです。https://x.com/TOOMIRO/status/1872018673487257950\n\nhttps://skeb.jp/@Reysyu02/works/59", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/163", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15237, "client_id": 1121149, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34207fbf/uploads/origins/2f34239d-e715-4bab-806a-40982c4c17d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7264f433ac48035020a801e66c7d4a2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34207fbf/uploads/origins/2f34239d-e715-4bab-806a-40982c4c17d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55333067c682bb78b961909cda8552a8", "src_set": ""}, "body": "こんにちは！私のOCをあなたのスタイルでリデザインしてくれませんか？好きなだけいじって、好きなだけデザインしてください！彼はウサギとカワウソとサメのハイブリッドです！サメのような尖った鼻と、共生スーツを参考にしているようなサメのような尻尾で、もっとサメらしくしてください。彼はバブル、ブレード、スイム、シェルのテーマを持っています。彼の毛皮のパターンとカラーパレットを再設計してください！彼のシェルアーマーを、ニーパッドやエルボーパッドのような、よりスポーツアクセサリーのように見えるようにデザインし直してください。もしあなたが望むなら、彼はヘッドウェアを着用することができます。\n\nhttps://drive.google.com/drive/folders/1DBXR2A6j2EObNI5dItifD5cY8GrYD6L2?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/162", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15237, "client_id": 3464635, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35574a83/uploads/origins/d4a17669-37cf-4a48-be86-ab6bda34a2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81182d808fc3536182e5367e2d001fae", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35574a83/uploads/origins/d4a17669-37cf-4a48-be86-ab6bda34a2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5988fc266b81774657bf830eb33afd3", "src_set": ""}, "body": "こんにちは、先生！あなたが命を吹き込んでくれたセスとカラスキのキャラクターが大好きです。  最近、私の古いオオカミのOCをデザインし直したのですが、彼のデザインにもう少し深みを持たせたいと思っています。  彼は北部の灯台守で、雪と寒さを愛し、性格は温厚で優しい。  https://skeb.jp/@TOOMIRO/works/129私のイメージに近いです。私のリクエストを考慮していただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/11uwzgqM7ovGgaId8W2mpizBn_Utg44gA?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/161", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 15237, "client_id": 2536423, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8c3d015/uploads/origins/bd0daceb-3183-45ab-827c-f0a97092e4b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8f3a74174fda8145fc652eeb4dc996b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8c3d015/uploads/origins/bd0daceb-3183-45ab-827c-f0a97092e4b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9af7aaed0b911ab0978684a6d7d6f3d", "src_set": ""}, "body": "お邪魔します、TOOMIROです！\nTOOMIROさんの画風がとても好きなので...私のOCの全身画を描きたいのです!\n\nTOOMIROさんの絵にはいつも衝撃と驚きを受けるので、自分のOCを先生に依頼してみたいのです!\n\n先生のTwitterのクレイジーな表紙と色使いがとても好きなので、傲慢な魔王様風の絵を依頼できたらいいなと思っています。\n\n私のOCはこちらです。\nhttps://drive.google.com/drive/folders/18H6dFZlxkGyG3I3fMzO5RLay8gWEEGcO?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/160", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/99326037/uploads/origins/2cc878c9-3449-45fb-8d26-f9c33d958aba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c576b5d694d01eafc1828156d79e8f8b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 15237, "client_id": 3166045, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/159", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 15237, "client_id": 3176724, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b1cfd4e/uploads/origins/94bff7d7-71a7-4a74-bed9-c119580efc47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f475b511fa1c553ad1b54939c638d54c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b1cfd4e/uploads/origins/94bff7d7-71a7-4a74-bed9-c119580efc47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60621d71f85aa2b0111c1ce3004c2365", "src_set": ""}, "body": "こんにちは！\n\n私のフォルフ（キツネ・オオカミ）キャラクターのデザインを更新した新しいリファレンスシートの制作を手伝っていただけませんか？彼は75％キツネ、25％オオカミです。彼の今の色とデザインは大好きだけど、体、背中、しっぽにもっと模様があるといいな！\n\nパターンについては、芸術的な自由を与えますが、彼の胸にV字型のパターンを入れるなど、もっとレイヤリングしてください！\n\nhttps://drive.google.com/drive/folders/1Ad_R_37T6XFtw9Qx8a6GxgK-n8WxNzE4", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/158", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15237, "client_id": 17413, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/065e68ca/uploads/origins/e97193a5-3371-4fdc-a6a6-4223090be459?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bee9b7fdf48ace767a79d80a2cb773c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/065e68ca/uploads/origins/e97193a5-3371-4fdc-a6a6-4223090be459?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1fa5f310596f555d9c66c407c795b5d6", "src_set": ""}, "body": "初めまして！\nうちの子 猪騎士ガーバン(資料参考)の甲冑姿を藤三郎様の絵柄とアイデアで描いていただけませんでしょうか？\nテーマは「威風堂々」\n戦士としての揺るぎない自信と風格を彼の表情と立ち姿から感じたいです。\n可能なら兜の有り無しと面頬上げバージョンを作成していただけると嬉しいです。\n(フル装備の格好良さと凛々しい表情を両立させたいので)\nそれではよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1EGL2jkSXxoauBTdWP-cje-7lZcqSOxIz", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/157", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15237, "client_id": 433669, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0cc9484/uploads/origins/f0eb24b9-4328-47d2-a7b4-201a680e3db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ce4cd52075734c56647bf4cfc74fbd4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0cc9484/uploads/origins/f0eb24b9-4328-47d2-a7b4-201a680e3db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dafc5290f8ea3e30a10f7493f550046", "src_set": ""}, "body": "いつも素敵なイラストをありがとうございます。\n\n今回、以前描いていただいたこちらのキャラクター（https://skeb.jp/@TOOMIRO/works/39 ）とその召喚獣たちのイラストをお願いしたくご連絡しました。  \n\n内容としては「前回描いていただいたこちらの召喚獣（https://skeb.jp/@TOOMIRO/works/147）に対して小さい召喚獣たちが先輩として張り切って色々と教えているところ」になります。 \n\nイメージとしては召喚術師の家の中で身の回りの世話などについて教えている形です。\nもし構図的に可能であれば後方で召喚術師キャラが苦笑い、もしくは少しハラハラした様子で見守っている姿を入れていただけると嬉しいです。\nその他詳細については藤三郎様にお任せします。  \n\n以上、ご検討よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/156", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15237, "client_id": 316839, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61dba6aa/uploads/origins/66f9b76f-2094-48c9-93a7-44e3dff05a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b72d5c0018c01bf982e8f52f7d966411", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61dba6aa/uploads/origins/66f9b76f-2094-48c9-93a7-44e3dff05a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2dd87939db4828cf1b86bb19758556a", "src_set": ""}, "body": "こんにちは、昨年はSkebにて素晴らしい絵をいただきありがとうございました！\n今回も可能でしたら私の創作キャラの絵をお願いできますでしょうか？\n\n【キャラ資料】\n黒い鴉の「ドーマ」\n（設定等）\nhttps://wa-ryu.net/wp/char/doma/\n（画像資料）\nhttps://drive.google.com/drive/folders/1-03SDUtUM66n3LLXFx5Ol8T-9S9x2FYX?usp=sharing\n\n【シチュエーション】\n薄暗い場所で、ドーマ（人型でも鳥型でも構いません）が魔法を操っているようなシーンを考えています。\n一案としては妖しく揺らめく青白い焔とか、冥府の悪鬼や竜みたいな怪物を召喚しようとしているとか……ですが、細かい点はお任せできれば幸いです。\n\nご検討のほど、何卒よろしくお願いします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/155", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15237, "client_id": 2293211, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c8bf14b/uploads/origins/69590f23-64c4-4f16-9ee9-1a55aa0a6ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3537c7fb3fd9ab28e16efaf461ea1de6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c8bf14b/uploads/origins/69590f23-64c4-4f16-9ee9-1a55aa0a6ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1fda0ae81f8be4ecbe66de463747deed", "src_set": ""}, "body": "藤三郎さん、こんにちは~\n\n私のキャラクターは悪魔の血統を持つ狼で、深い青色の炎を使って敵を攻撃します。 構図は、その青い炎を使って攻撃する姿勢でお願いします。 衣装は先生にお任せしたいと思います。 よろしくお願いいたします！\n\nhttps://x.com/TOOMIRO/status/1842828320200966185\nhttps://www.dropbox.com/scl/fi/vow68ovpja7gsa3jgzack/kirelons_oc.png?rlkey=jijg3nfux7uzefeqldg4f9ku4&dl=0\nhttps://www.dropbox.com/scl/fi/p2wrr7e9uipq65x36h3wj/1517939-1.output.png?rlkey=c4ekb5v67aztxj7saffo5g5ix&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/154", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15237, "client_id": 1121149, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d40dd811/uploads/origins/57de8a07-2ce0-47d2-a131-98c380a60350?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bf4166b9249e40498bda8ad03539c1c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d40dd811/uploads/origins/57de8a07-2ce0-47d2-a131-98c380a60350?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f84cf80636e5619ed1c9316875618ead", "src_set": ""}, "body": "私のクーガー・ドラゴンキャラクターのヒーロースーツを、リファレンスフォルダにある彼の古いヒーロースーツを組み合わせて、「ヒーローを生きる」ヒーロー風にデザインしてくれませんか？彼のテーマはソフトウェア、サポート、忍者、発明家、共生者です。彼の能力は、電子機器、テレポーテーション、身体強化、テレキネシスをコントロールする共生テンドリルを含む。バイザーと、鉤爪のついたガントレットを持つ怪物のような腕を含む。スーツはクールで、少し不吉で、それでいて未来的な質感を持つヒーロー的なものにすること。クールなポーズで描こう！\n\nhttps://drive.google.com/drive/folders/1P_ynvn7sBx1RAj_BHD0uZ-j2eNmwa-dQ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/153", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15237, "client_id": 18181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f2b8487/uploads/origins/8b55e81b-6bd1-4073-9932-debf7a5297c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d23dbcbc893b51fd19a49106d0eae8a0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5f2b8487/uploads/origins/8b55e81b-6bd1-4073-9932-debf7a5297c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cea651bfc50a2bb10b82d5b1771a2fea", "src_set": ""}, "body": "いつもお世話になっております！\nウチの子「ラティ」の本気モードなドラゴンの姿をデザインして頂きたく、リクエストをお送りします。\n\n資料URLに保存の元絵は、とある飲料を擬竜人化したイメージのキャラクターです。\nワイバーン系、二足歩行系、四つ脚系など、モンスター系ドラゴンの容姿には幾つかタイプがありますが、どんなタイプに決めて頂いても大丈夫です。\n同梱した他ドラゴンの資料に準じてほしい訳でもないので、藤三郎さんの描きたいイメージを自由に込めてください！\n\nどうぞ、よろしくお願いしますっ！\n\nhttps://www.dropbox.com/scl/fo/knwo71x79x468kr5rs1d0/AJlp7RRUWfuAghUnoS4xom0?rlkey=clou8owemvab8738xvgvvsaif&st=topptt6k&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/152", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15237, "client_id": 50448, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46e7d878/uploads/origins/3afdccdc-1f01-4e22-a88f-734232a844f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=401d2707e5b9024fbb4daddc70dfd764", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46e7d878/uploads/origins/3afdccdc-1f01-4e22-a88f-734232a844f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d133c8e7de0bd15a67448e2e623ab07", "src_set": ""}, "body": "こんにちは！\nあと数ヶ月でブラジルの夏がやってきます。\n夏をテーマにした私のキツネザルのキャラクターの絵をお願いします。\n\nシンプルな夏服で少し遊んでいますが、彼の服装を自由に変えてみてください。\n\nhttps://cloud.refsheet.net/images/images/002/070/966/large/GaDXiiLXgAAdu2a.jpeg?1729129089\nhttps://refsheet.net/media/a731103c8ecb15ef\n\nまた、彼はなぜか泳ぎ方を知らないので、水の中に描くと浮き輪に乗っているかもしれません。\n\nhttps://refsheet.net/jwbash/roku", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/151", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 15237, "client_id": 2024, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/206ff4fb/uploads/origins/74ef3479-258d-483a-a3b4-d3a6293460c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3e0c745943fbdc936648f93e14562be", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/206ff4fb/uploads/origins/74ef3479-258d-483a-a3b4-d3a6293460c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbe143c7cac3a805aedc74975016809e", "src_set": ""}, "body": "こんにちは。\n\n来年は巳年なので、クマのお相撲さんが大蛇のお相撲さんとお酒を飲んでて飲み潰れたところをお願いします。\n以前描いてもらった龍のお相撲さんの鏡開きの続きみたいな感じです。\n\n樽のお酒を升で飲んでるのですが、大蛇はうわばみ（大酒飲みの意味です）なので酒を飲み続けていて、クマのお相撲さんは酔ってしまっています。\nお酒の飲み過ぎで暑くなったのか、着ている着物は大きくはだけていて、袴はいつの間にか脱いでいて下半身は褌一丁になってます。\n\nクマのお相撲さんは飲み比べて負けてしまってますが、お酒は十分に強いのでからになった升が傍らにたくさん積み重なってます。\n\nこんな感じのイラストをお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/150", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15237, "client_id": 378828, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f027a38e/uploads/origins/6aaf5477-7de7-49e9-9d38-351e1276b362?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3198d4823ba8c2916d09f47c27dcb5c3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f027a38e/uploads/origins/6aaf5477-7de7-49e9-9d38-351e1276b362?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68763e195bae8721f6b51cb985f4cff4", "src_set": ""}, "body": "こんにちは。\nいつもアートスタイルが大好きで、今回もぜひお願いしたいと思っています。\n\n今回は、僕のキャラクターのリファレンスシートをお願いしたいんです。以前のリファレンスシートは10年以上前に作られたもので、あなたのスタイルで私のキャラクターを自由にアップデートさせてもらいたいと思っています。\n\nメモ： \n1. 私は筋肉を見るのが好きだ。特に胸筋、腹筋、上腕二頭筋。\n2. あなたの最後の絵の私のキャラクターの体型はすでに完璧です。\n\nhttps://drive.google.com/drive/folders/1v5h95-153sK_KJO0fBuMemnnbGlP_398?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/149", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15237, "client_id": 1121149, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a957ba80/uploads/origins/c87bdbe7-5909-42cd-9290-c23d73d79bec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c835dc513ee1da639abbdc172238db3d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a957ba80/uploads/origins/c87bdbe7-5909-42cd-9290-c23d73d79bec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb41d3868834d2b6a45f852d3472835c", "src_set": ""}, "body": "こんにちは！私のクーガー／タイガー／ドラゴンOCの進化した姿をリデザインしてくれませんか？彼は悪魔、三角形、エイリアン、宇宙、骨、金属のテーマを持っています。彼は自然な骨と金属の鎧、3本の尾、強力な角、少なくとも1つの悪魔の目を持っている必要があります。フォートナイト』のケルベロスや『Arena of Valor』のマロクに似ていて、3つの頭、強力な悪魔の翼と体、身長9フィート、筋肉質であること。彼の自然な鎧と筋肉を見せるために、服装は最小限に。ゼロから自由にデザインしてください！\n\nhttps://drive.google.com/open?id=1anH3LrazlCyaP9CMUlkoNFnkY2oMbnyc&usp=drive_fs", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/148", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15237, "client_id": 50448, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f5483a20/uploads/origins/7ca5958f-c931-41e8-afd3-ba0a365accbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e0d972258f261c31daa4237a1312843", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5483a20/uploads/origins/7ca5958f-c931-41e8-afd3-ba0a365accbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb6b403ea547b2f647d0938bcecdac3f", "src_set": ""}, "body": "こんにちは！\n真・女神転生Vの新バージョンがもうすぐ発売されるんだけど、実はキツネザルのデザイン案を思いついたんだ！\n私が最初にデザインしたキツネザルを覚えていますか？\nhttps://imgur.com/AlaYmhN。\n\nそれと最近作った新しいデザインと、ゲームの主人公のデザインを組み合わせて、クールな新しいフォルムを作ってもらえないかな？\nhttps://imgur.com/vPRaUbV\nhttps://imgur.com/5gW84um\n\nhttps://imgur.com/a/toomiro-nahobino-lem-2sEKcfr", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/147", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15237, "client_id": 433669, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2fca620/uploads/origins/4a262be2-0cc6-47ea-aea2-c2c0f2fb8280?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4096e522d8c7acf241c92e4692c2270f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c2fca620/uploads/origins/4a262be2-0cc6-47ea-aea2-c2c0f2fb8280?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c3daa5d6a999fd266897d04c9473be8", "src_set": ""}, "body": "こんにちは。\nいつも素敵なイラストをありがとうございます。\n\n今回、以前デザインして頂いたこちらのキャラクター\nhttps://skeb.jp/@TOOMIRO/works/39\nのイラストをお願いしたくご連絡しました。\n\n内容としては「召喚獣と契約を結んでいるところ」になります。\nイメージとしては危険な密林に赴いて苦労しながらも召喚獣と協力してなんとか奥地に辿り着いた形です。\nその他詳細については藤三郎様にお任せします。\n\n以上、ご検討よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/146", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15237, "client_id": 209283, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a57fd18e/uploads/origins/28e9bf08-295e-40ae-a4a4-47a0def03897?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14f4e34e3a64c62a67c0c3eee74e1963", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a57fd18e/uploads/origins/28e9bf08-295e-40ae-a4a4-47a0def03897?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=734e3f4d6dc2098e4d26d7f218fde2f8", "src_set": ""}, "body": "こんにちは！あなたの絵がとても好きです！\n私のキャラクターを描いていただけませんか？\nオオカミの男の子です。かっこよくてかわいいです！\nポーズや背景はなんでもOKです。\n\nhttps://drive.google.com/drive/folders/1-Gt2OyFVrMhL8N2tkdQePGoYimUFNrzj", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/145", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15237, "client_id": 18181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/25b31651/uploads/origins/de0c3957-618b-4a52-a849-7d0c978c3cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c42ff792ffdde94281665caa21ad8b8e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25b31651/uploads/origins/de0c3957-618b-4a52-a849-7d0c978c3cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b904d531d8bdc5d6f258bb78498ff6d3", "src_set": ""}, "body": "いつもお世話になっております！\nウチの子「浅海 湧治」のユニフォーム姿を描いて頂きたく、リクエストをお送りします。\n（以前は疾走感あふれる姿を描いて頂きありがとうございました！）\n\n放サモのバエル様くんの水着のデザインがとても格好良く、こちらをモチーフにユニフォーム（半そでヘソ出し、尻尾の出るローライズ≒サイクルジャージ）をデザイン頂けると嬉しいです…！\n「思った通り実物はやっぱカッケェ…！✨」って喜んでいる表情や、「似合って当然だよな！」とバエルくんみたいに鼻高に自慢げな表情をしている等、ウチの子が喜んでいる様子を藤三郎さんに描写して頂きたくお願いしますっ。\n\n構図やポーズ、上記以外の要素については特に要望なしです。藤三郎さんのお好みにお任せします！\nまた資料URLに皆様から頂いたイラストを保存しておりますのでご参照下さい。\n\nどうぞ、よろしくお願いしますっ！\n\nhttps://www.dropbox.com/sh/288sol0ycoygqeq/AABRwzIt9vdSNGZHd4-UNBmua?dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/144", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 15237, "client_id": 2024, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/afc517a0/uploads/origins/93d66327-9885-4d4b-908f-14c21356aea6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55f4384dc9a7d8774e24d0a21cfefcd3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/afc517a0/uploads/origins/93d66327-9885-4d4b-908f-14c21356aea6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1204912dad45170a553d8cbe099a754", "src_set": ""}, "body": "こんにちは。\n\n熊のお相撲さんとヒグマのお相撲さんが相撲を取ってるところをお願いします。\nヒグマのお相撲さんは頭の毛だけ赤くて髪みたいに見えてる姿。いかにもな悪役顔という容貌をしてます。\n熊のお相撲さんより大柄な体格です。\n\n熊のお相撲さんがヒグマのお相撲さんに対して、すくい投げをしますが、ヒグマのお相撲さんがそれに抵抗してます。\nしかし、熊のお相撲さんが強引に投げを打ち、ヒグマのお相撲さんの片足が浮いてしまった瞬間を切り取るような構図で描写をお願いします。\n\n熊のお相撲さんは西横綱 熊光。\nヒグマのお相撲さんは西大関 銅甲冑という四股名です。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/143", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/31ad01df/uploads/origins/4940fa17-20e8-441d-abc1-a659d1884292?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db1fa2f567d0dca3672c1a4383fef404", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 15237, "client_id": 178972, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/142", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15237, "client_id": 1045769, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89f0dc05/uploads/origins/f00d1cbc-d45e-4322-8008-47d58fddb1fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc17d81ae55d2f8d1d07c92aff1a468c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89f0dc05/uploads/origins/f00d1cbc-d45e-4322-8008-47d58fddb1fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dac6b188bf1763d19a47a3e20766871", "src_set": ""}, "body": "こんにちは、先生。\nそこで、サーベルタイガーとハイイロオオカミの血を引くオークの魔道士である私のキャラクターを描いていただきたいのです。表情は歯を剥き出しにしながらもストイックで、右手の魔法陣は雷を炸裂させ、敵に襲いかかろうとする。\n設定画像リンク\nhttps://twitter.com/xiaoe14/status/1710635188198293852?t=6cIebco2CY58JGep4C-xIw&s=19", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/141", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 15237, "client_id": 378828, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc09b5d1/uploads/origins/c76f6592-79dd-4fec-9a5c-8d7ae395d8bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4487aff690175ebcfb2ad891d41afcf8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc09b5d1/uploads/origins/c76f6592-79dd-4fec-9a5c-8d7ae395d8bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8749def86621275a300c0d9b540c447e", "src_set": ""}, "body": "こんにちは、また僕です。今回の依頼にワクワクしています。\n\nこの忍者狼は他の人と同じように、休日を楽しむのが大好きなんだ。私はビーチにいる。かっこいい夏服を着て。リラックスして筋肉を少し見せる。\n\nメモ： \n1. 私は筋肉を見るのが好きだ。特に胸筋、腹筋、上腕二頭筋。でも、それを見せるかどうか、最終的にはあなたの自由です。\n2. あなたの最後の絵の私のキャラクターの体型はすでに完璧です。\n\n僕のキャラクターを描いてくれて本当にありがとう。本当にあなたの作品が大好きです。\n\nhttps://drive.google.com/drive/folders/1v5h95-153sK_KJO0fBuMemnnbGlP_398?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TOOMIRO/works/140", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 15237, "client_id": 38427, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/755a6697/uploads/origins/4fcfe937-80d7-4630-ac0f-4edb7da2064f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96c284c89582aa4099ac504151ca27e0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/755a6697/uploads/origins/4fcfe937-80d7-4630-ac0f-4edb7da2064f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91cb0e5b890cbe9400c530ee3a90e5c8", "src_set": ""}, "body": "藤三郎さん、こんにちは。Rossと申します（今は友人のアカウントを使っています）。\n自分の代理キャラの幻想的な設定のイラストを依頼したいと思っています。\n内容は藤三郎さんの自由に描いていただきたいのですが、既存の参考画像と似た構図は避けていただきたいです。\n特定の内容や雰囲気を求めるなら、力強く、