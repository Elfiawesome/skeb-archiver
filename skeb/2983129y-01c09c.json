%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17ef24884006a9f3d2a4733e6b060d3d", "srcset": "https://si.imgix.net/98b99ec0/uploads/origins/b7213c9c-b9bc-4a38-8582-dab2640f6ec0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17ef24884006a9f3d2a4733e6b060d3d, https://si.imgix.net/98b99ec0/uploads/origins/b7213c9c-b9bc-4a38-8582-dab2640f6ec0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=53d7059eb641ecfc96dc1fc6a9fd92fa 2x, https://si.imgix.net/98b99ec0/uploads/origins/b7213c9c-b9bc-4a38-8582-dab2640f6ec0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a865759e6bd870a8cb14b76f1d98231a 3x"}, "body": "こんばんは。\n赤ずきんロリさんの差分パーツをご依頼したくリクエストを送らせて頂きました。\n\n私は立ち絵素材をLive2D化して生配信で使用しているのですが、視聴者さんが来訪した際に画面に向かって手を振るモーションをつけたいと考えております。\nつきましては、私服ver.の右腕のパーツを描いて頂けませんでしょうか。\n\n希望の詳細は下記の通りです。\n・私服ver.のみ\n・右肩の白い袖の部分～指先まで\n・腕は「V」の字に曲げている形\n・手のひらはパーの形\n・手のひらの位置（高さ）の目安は赤ずきんの胸元のリボン～首のモコモコくらい\n※お手振りモーション使用時以外は使用しない（不透明度を０にして見えない状態にする）ため、「どんなポーズでも自然に見える形」等は意識しなくて大丈夫です\n\n下記は料金内で対応可能であればお願いしたい項目です。\n・可能であれば「肩～肘」「肘～袖の先」「手首～指先」の3つのレイヤーに分けてほしい\n・分けて頂ける場合、「肘～袖の先」を最前面にしてほしい\n・もし手首付近のリボンが見える場合は揺らしたいので別レイヤーにしてほしい（見えない場合は不要です）\n※「×」字のリボンには動きをつけない為、服と同じレイヤーで大丈夫です\n\nお題箱の存在も存じてはいるのですが、立ち絵に差分として同梱される可能性を考えたときに「静止画として使用することが難しい…他の利用者さんにとってあまりにも使いづらい差分リクエストなのでは？そして他の方が利用しやすい形に加工するとしても余計な手間をかけさせてしまうのでは？」という懸念があった為こちらからリクエストさせて頂きました。\n\nいつも立ち絵を使わせて頂きありがとうございます。\nこれからも応援しております。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2983129y/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 26158, "client_id": 504731, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fba0f38/uploads/origins/d29f996b-2913-461c-8fad-9a1b833cb0bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02059eb4c79be0ea9cc3dc6dd66e0fe3", "srcset": "https://si.imgix.net/6fba0f38/uploads/origins/d29f996b-2913-461c-8fad-9a1b833cb0bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02059eb4c79be0ea9cc3dc6dd66e0fe3, https://si.imgix.net/6fba0f38/uploads/origins/d29f996b-2913-461c-8fad-9a1b833cb0bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=048bee4d52c9dc02949b778d95eadaaa 2x, https://si.imgix.net/6fba0f38/uploads/origins/d29f996b-2913-461c-8fad-9a1b833cb0bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ed64d82171d3563a385e0843d5bb2ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6fba0f38/uploads/origins/d29f996b-2913-461c-8fad-9a1b833cb0bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fce97f149177492eb19ca877fffde53a", "srcset": "https://si.imgix.net/6fba0f38/uploads/origins/d29f996b-2913-461c-8fad-9a1b833cb0bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fce97f149177492eb19ca877fffde53a, https://si.imgix.net/6fba0f38/uploads/origins/d29f996b-2913-461c-8fad-9a1b833cb0bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8e3db1f004eda2c9620aec58dd80a1c2 2x, https://si.imgix.net/6fba0f38/uploads/origins/d29f996b-2913-461c-8fad-9a1b833cb0bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bef695181e719ed802e086f440a7fc78 3x"}, "body": "はじめまして。\nTRPGで使用する立ち絵をお願いさせていただければと、リクエストを送らせていただきました。\nフリー立ち絵で何回か使っている継続の子なのですが、ぜひジンドウ様のイラストでオリジナルを描いていただけますと幸いです。\n\n用途はTRPG用の立ち絵\n配信や投稿動画などでは使用しません。\n身内で行うTRPGセッションで使用します。\n立ち絵として使用するため、背景は不要です。\n\nキャラクター資料はURLに詳細をまとめておきました。\nどの程度資料があればいいかわからなかったので、細かく指定と資料を入れたのですが、省略や変更、アレンジなど自由にしていただいて大丈夫です。\n差分のリクエストも記載してありますが、作業的に難しければカットしていただいて全然大丈夫ですので、可能な範囲でお願いいたします。\n\n・キャラクター概要\n女子　20歳　顔立ちは幼め\n探偵見習いで、性格も行動もアクティブ。\n物怖じせず知らない人にもどんどんいける。\n\nよろしくお願いいたします。\n\n\nーーーー\n\nここからは依頼と直接関係ないのですが・・・\nジンドウ様の絵が本当に大好きで、立ち絵の新作いつも楽しみにしております。\n（新作バニーの子はどうしても使いたかったので、あの子用にバニーシナリオを回して貰う予定です・・・！）\n女の子は可愛くて、女性はかっこよくて素敵なのですが、イケオジが本当に好みにストライクで・・・\nセンター分けのおじさんやひげのおじさんのちょっと草臥れた感じが本当に最高です！\nいろいろな立ち絵を使用させていただいているのですが、すごく思い入れのあるシナリオに連れて行った子も多く、どの子も大切に使わせていただいています。\nこれからも応援しております！！\n\nhttps://www.dropbox.com/sh/fpxvovqx88qh9q0/AAAcDjbC8hmSfYaw9dMgLVhBa?dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2983129y/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 26158, "client_id": 1058590, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/56341fe6/uploads/origins/7cf70fda-59cf-44c3-b108-1583a1cd8c43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9573727de48fc1a44142630c1c5d7599", "srcset": "https://si.imgix.net/56341fe6/uploads/origins/7cf70fda-59cf-44c3-b108-1583a1cd8c43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9573727de48fc1a44142630c1c5d7599, https://si.imgix.net/56341fe6/uploads/origins/7cf70fda-59cf-44c3-b108-1583a1cd8c43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69e6ba81c2611f7d46887867263e1b2c 2x, https://si.imgix.net/56341fe6/uploads/origins/7cf70fda-59cf-44c3-b108-1583a1cd8c43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc0dbd266469628c6a4b056fedabc982 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56341fe6/uploads/origins/7cf70fda-59cf-44c3-b108-1583a1cd8c43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e52d5ad305bf97ab939dbd8fcbf2b32f", "srcset": "https://si.imgix.net/56341fe6/uploads/origins/7cf70fda-59cf-44c3-b108-1583a1cd8c43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e52d5ad305bf97ab939dbd8fcbf2b32f, https://si.imgix.net/56341fe6/uploads/origins/7cf70fda