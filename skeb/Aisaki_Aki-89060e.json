れるような。それでよければ。その他、武器を持っている姿も、落ち着いていて、でも集中している感じで、カッコいいと思います。どちらでもいいですが、詳細はお任せします。\n\nご検討のほど、よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2598, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "柊みこ/アカ制限中の為臨時アカにいます", "screen_name": "0721Miko", "avatar_url": "https://pbs.twimg.com/profile_images/2007916463383080961/JyBDA0Q_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/315844222/1718357080/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "video"}], "nc": 0}, {"id": 318792, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "江藤｜コミティア156 K08b", "screen_name": "eto_999_", "avatar_url": "https://pbs.twimg.com/profile_images/1890762455070232576/rx5fJtmI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1623569734326272008/1688121105/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "nc": 16}, {"id": 398838, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ヒヨヨ@skeb募集中（特殊な内容もOK！）", "screen_name": "kou_hiyoyo", "avatar_url": "https://pbs.twimg.com/profile_images/1820725109768003584/nFqwhAAN.png", "header_url": "https://pbs.twimg.com/profile_banners/105523086/1725285923/1500x500", "appeal_receivable": false, "popular_creator_rank": 6, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 85, "skills": [{"genre": "art"}, {"genre": "comic"}],