て頂きたいです！\n古都に住む魔法使いで、研究中心の生活をしているので本や古びた魔法道具に囲まれて暮らしています。\n研究中だったり、休憩していたりと、おだやかな日常の一片を切り取ったような雰囲気で描いていただきたいです。\nシーンや構図・背景等はおまかせします。\n\n元々あまり表情の無いキャラクターですが、少年の姿になっているので、幼さの残る可愛らしい表情でお願いしたいです…！\n可能でしたら、資料にあるくまのぬいぐるみも画面内に配置してもらえると嬉しいです；；\n\nもし難しいと感じられましたら気兼ねなくキャンセル頂いて構いません！\nご検討よろしくおねがいします…！\n\nhttps://drive.google.com/drive/folders/1NFvTAkOkjeCKgFKZkWDquZc8O3j3rSq7?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 698880, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "🚀ᵀᴼᵂᴬ🛸", "screen_name": "mmm_pkg1", "avatar_url": "https://pbs.twimg.com/profile_images/1693571627974615040/-_VQIaXL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1235584753031458817/1668522984/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 853932, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "しちがつ", "screen_name": "sitigatu0984", "avatar_url": "https://pbs.twimg.com/profile_images/1482669903630929924/aKquSAzM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/833203785509920768/1490535895/1500x500", "appeal_receivable": false, "popular_creator_rank": 97, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 1744938, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "めめざこ", "screen_name": "xxzaco_box", "avatar_url": "https://pbs.twimg.com/profile_images/1452331371712503808/jFyXu-h2.png", "header_url": "https://pbs.twimg.com/profile_banners/863931132366041092/1644458810/1500x500", "appeal_receiv