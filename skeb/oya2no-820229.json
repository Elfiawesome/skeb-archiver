での使用\n・スマホやPCでのロック画面等の使用\n【納品形式】\n・お手数ですが人物・背景・宛名等がレイヤー分けされたPSDデータで納品していただけますでしょうか？\n\nサムネイルイラストを募集していなければキャンセルしていただいて構いません。\nその際にはまたそれぞれ分けてもう一度リクエストさせていただきます。\nお忙しいところ恐縮ですがご検討よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oya2no/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2993772, "client_id": 2678736, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93480ea8/uploads/origins/c2a752e3-dfb0-4410-babd-024f2132cb4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc6f33b70f39a7bbe5eefea5fbccb59e", "srcset": "https://si.imgix.net/93480ea8/uploads/origins/c2a752e3-dfb0-4410-babd-024f2132cb4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc6f33b70f39a7bbe5eefea5fbccb59e, https://si.imgix.net/93480ea8/uploads/origins/c2a752e3-dfb0-4410-babd-024f2132cb4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36e45e1344b1d245f691fb0094c0fb31 2x, https://si.imgix.net/93480ea8/uploads/origins/c2a752e3-dfb0-4410-babd-024f2132cb4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd66c54f7f8990002b2245e9a039c05f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93480ea8/uploads/origins/c2a752e3-dfb0-4410-babd-024f2132cb4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efbad98026d67c8c9bf9e193f1b95f13", "srcset": "https://si.imgix.net/93480ea8/uploads/origins/c2a752e3-dfb0-4410-babd-024f2132cb4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efbad98026d67c8c9bf9e193f1b95f13, https://si.imgix.net/93480ea8/uploads/origins/c2a752e3-dfb0-4410-babd-024f2132cb4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=76ee32f3a119133b1c210f6b42fa0a08 2x,