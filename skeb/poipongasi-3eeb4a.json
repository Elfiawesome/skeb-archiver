国で確固たる地位を築いている軍人で、一人で戦況を動かせるほどの力をもちます。\n自分の優秀さを信じているゆえに無意識に傲慢。ときに優しくときに高圧的。自分以外を動物か何かだと思っています。\n返り血で真っ赤な様子が似合うキャラクターです。\n\nAはBの強さを好ましく思い甘え執着し、BはAの力を制御するために半ば仕方なく鬱陶しがり、ときにからかい可愛がりながら行動を共にしています。\nモラハラとメンヘラのコンビです。\n\n＜イラスト＞\n構図などお任せ致します…！\n柔らかいものシリアスなもの、なんでもうれしいです。\n服装も立ち絵から選んで頂くか、他のものでも、お任せ致します。\n\n何か問題あれば御手数ですがキャンセル、もしくは再送いただけますと幸いです。\nもしご都合宜しければよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1EswzTIQM8TA7Sr7UadGQ7Qy4NrGvhL3_", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@poipongasi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1518063, "client_id": 944700, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/261f3c14/uploads/origins/c9e86ea7-8468-4ce6-beca-c266f34c5849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b3a861cec12b13ae1731163b157f2a6", "srcset": "https://si.imgix.net/261f3c14/uploads/origins/c9e86ea7-8468-4ce6-beca-c266f34c5849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b3a861cec12b13ae1731163b157f2a6, https://si.imgix.net/261f3c14/uploads/origins/c9e86ea7-8468-4ce6-beca-c266f34c5849?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38c264ae49f89f08dcabea3e39900da1 2x, https://si.imgix.net/261f3c14/uploads/origins/c9e86ea7-8468-4ce6-beca-c266f34c5849?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc84e686d81b5a047414d3320738df32 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/261f3c14/uploads/origins/c9e86ea7-8468-4ce6-beca-c266f34c5849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13cac1e5c711752b44949dfbde4b0ad4", "srcset": "https://si.imgix.net/261f3c14/uploads/origins/c9e86ea7-8468-4ce6-beca-c266f34c5849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13cac1e5c711752b44949dfbde4b0ad4, https://si.imgix.net/261f3c14/uploads/origins/c9e86ea7-8468-4ce6-beca-c266f34c5849?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=281eb85ee384728e2b2acc0fff50c960 2x, https://si.imgix.net/261f3c14/uploads/origins/c9e86ea7-8468-4ce6-beca-c266f34c5849?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=72e791afd9326ffc1f5f52e2783cc45b 3x"}, "body": "いつもお世話になっております♪\n\n女の趣味が合う氷さんに、私の探索者を描いていただきたいです…！！！\nGoogleドライブにいくつか格納しましたので、よければご自由に選んでお好きなように描いていただけますと幸いです🫶\n\n以前Twitterに載せていらしたソープスクールのイラストがカラフルポップな感じでとても素敵だなと思いましたので、生活のワンシーンを切り取ったような写実的なものよりかは、イラストレーションっぽい感じだと嬉しいです(？) うまく伝えられずすみません😢\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1MpTwW-iKtJ2BLoWKoNZr1ibIZBEbAgq3", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@poipongasi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1518063, "client_id": 3813378, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28a1c42f/uploads/origins/44fe1997-cc06-416c-89b9-c229d1501bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df924bb7e7d7e9a4b7e9541c64413833", "srcset": "https://si.imgix.net/28a1c42f/uploads/origins/44fe1997-cc06-416c-89b9-c229d1501bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df924bb7e7d7e9a4b7e9541c64413833, https://si.imgix.net/28a1c42f/uploads/origins/44fe1997-cc06-416c-89b9-c229d1501bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65a182f6df2224d4a0853e2a1cc8debb 2x, https://si.imgix.net/28a1c42f/uploads/origins/44fe1997-cc06-416c-89b9-c229d1501bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3948073dee5561968791b30a902f6f3c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "htt