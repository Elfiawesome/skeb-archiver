だけると幸いです。\n\n【構図】\n構図・衣装ともにおまかせします！\nモチーフに恐竜と犬を混ぜて欲しいです。(リスナーをどら犬と呼称しているので、ぬいぐるみを持たせる、背景に犬モチーフを入れる、髪留めに入れるなどなんでもいいので一部入れていただけると嬉しいです)\n\n\n参考画像はURLにて送ります。\n見た目について:金髪ツインテールで赤目です。髪型にこだわりはないので変更しても大丈夫です！また髪に黒いリボンがついてますがここも恐竜や犬のモチーフに合わせて変更大丈夫です！髪色と目の色、前髪の赤い部分さえ残していただけたら他はこだわりありませんので変更して大丈夫です！\n\n【イメージ】\n元気で明るい、笑顔のイメージが大きいです。いっぱい食べてる可愛い姿、ちょっと悪い顔しながら笑う顔や、全力のアイドル顔もイメージに合うと思います。イメージカラーはオレンジですが、そこまでこだわりはありません！\n\nたくさん記載してしまい申し訳ありません。\nぜひよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/109Q5E906jPRbn1kRp4C3r-MXxwp7VSYw", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true, "scraped_at": "2026-02-14T13:18:32.161722+00:00"}, {"path": "/@ha_nami02/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3505640, "client_id": 3005425, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d6c57a7/uploads/origins/9a364812-cc42-4181-a375-87a5014de45a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b537052614ef13de3e091ec8ed28950", "srcset": "https://si.imgix.net/5d6c57a7/uploads/origins/9a364812-cc42-4181-a375-87a5014de45a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b537052614ef13de3e091ec8ed28950, https://si.imgix.net/5d6c57a7/uploads/origins/9a364812-cc42-4181-a375-87a5014de45a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ed07dffd64bcb58067b99b7c7810835 2x, https://si.imgix.net/5d6c57a7/uploads/origins/9a364812-cc42-4181-a375-87a5014de45a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37bbcd88217c8d5bf578d2d2b8e9459b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d6c57a7/uploads/origins/9a364812-cc42-4181-a375-87a5014de45a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1be055c88be5b6004038083402c14809", "srcset": "https://si.imgix.net/5d6