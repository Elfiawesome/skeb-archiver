f-4944-b1c2-d37933a72160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e0e275bd7aeec1068f95f3d81374499, https://si.imgix.net/cc5e08e2/uploads/origins/6c87fab6-a57f-4944-b1c2-d37933a72160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd80952d7ddf8aa8413c53a9406e43f9 2x, https://si.imgix.net/cc5e08e2/uploads/origins/6c87fab6-a57f-4944-b1c2-d37933a72160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5db1d0f3d6777abd9ea1ad926ad70696 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc5e08e2/uploads/origins/6c87fab6-a57f-4944-b1c2-d37933a72160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a82b7882e80b126b110d8acd89ba289", "srcset": "https://si.imgix.net/cc5e08e2/uploads/origins/6c87fab6-a57f-4944-b1c2-d37933a72160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a82b7882e80b126b110d8acd89ba289, https://si.imgix.net/cc5e08e2/uploads/origins/6c87fab6-a57f-4944-b1c2-d37933a72160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=92a1499d4747ca42e36c75d6bb1975d9 2x, https://si.imgix.net/cc5e08e2/uploads/origins/6c87fab6-a57f-4944-b1c2-d37933a72160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=caab57437d467b78d7e684155824c83b 3x"}, "body": "初めまして、Vtuberの青空あのこと申します。\nXでイラストを拝見し、ぜひ自分もイラストを描いていただきたいと思いリクエストさせていただきます！\n\n■リクエスト内容\n表情もポーズも全てお任せしたいです！\n小森様が描かれる、少しダウナーな雰囲気のある女の子が好きなので\nダウナーめに描いていただけたら嬉しいです！\n依頼のきっかけになった、特に大好きなイラストがこちらです！\nhttps://x.com/karutakomori01/status/2105276362105983431?s=20\nhttps://x.com/karutakomori01/status/2091492167063892313?s=20\n\n衣装については小森様の代理さんが着ているお洋服のデザインがとっても刺さってて\n可能であればお好きに衣装も着せていただけますと嬉しいです！\nhttps://x.com/karutakomori01/status/2042606477706436787?s=20\nストリート系やダークっぽいものも好きで、ダークコケットも着てみたいなと思っており\nお好きな要素がありましたらぜひ自由に描いていただけたら嬉しいです！\n\n■使用用