default_amount": 40000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@batekka/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 64093, "client_id": 3495070, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf4b0f24/uploads/origins/102e12ee-45a6-465d-aefa-c7abffafcba5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47f1d06a37c6c55813ee0b90e95c2aff", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf4b0f24/uploads/origins/102e12ee-45a6-465d-aefa-c7abffafcba5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cd4434022950b150fd6e4be873900f7", "src_set": ""}, "body": "はじめまして、りーたろと申します。\nこの度はお誕生日おめでとうございます！\nMFL様のイラストが大好きで以前から依頼をお願いしたく思っており、またお誕生日ということでご依頼させていただきました。\n\n今回、ご依頼する内容ですが、私の立ち絵のイラストです。\n使用用途としては配信のサムネイルなどを考えております。\n私は将棋配信を行なっているのですが、「なんか将棋やってんな！」って感じのイラストだとすごく嬉しいです。\nまた、MFL様らしいアメコミ風なイラストで描いていただければと思います。\nよろしくお願い致します。\n\nhttps://x.com/tarosabu_sode?s=21&t=5qbVTnuzlFqVORi9iK-ncQ", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@batekka/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 64093, "client_id": 3706780, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e2e00e54/uploads/origins/b509ab3c-247a-440b-96e2-bb97d28ec951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d61621612c348c368c56b8b314f24bca", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2e00e54/uploads/origins/b509ab3c-247a-440b-96e2-bb97d28ec951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfdb686966362450fb12ee7d8163bdde", "src_set": ""}, "body": "Skebを使うのは初めてなので、何か間違っていたら申し訳ありません。値段は適宜調整してください。PeppinoとPizzaheadの作品が大好きです！ペッピーノとピザヘッドの作品が大好きです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@batekka/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 64093, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/174b3f23/uploads/origins/e0e34362-1f9c-47cc-a343-04ce7f91c21a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d57aef32536b9215707a7154f9a942df", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/174b3f23/uploads/origins/e0e34362-1f9c-47cc-a343-04ce7f91c21a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbc5642f26b13c96cd5be1a60da15474", "src_set": ""}, "body": "こんにちは。\nあなたの絵はとても素敵で、西洋のアニメーションを描くのがお好きなようなので、アニメのキャラクターを差し上げたいと思います。\n\n申し訳ないのですが、「フォスターズ・ホーム・フォー・イマジナリーフレンズ」の \"ダッチス \"をお願いできますでしょうか？\n\nダッチェスが高級ショッピングモールで高級なファンシーウェアを買い求め、散財を覚悟で買い物をするシナリオを希望しています。\n\n無理なお願いでなければと思います。ご検討のほど、よろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@batekka/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 64093, "client_id": 2361631, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/490cbd61/uploads/origins/b996a4b2-5100-4514-9e77-cdf978babde8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f92145b5456540324450e20d4d8e6664", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/490cbd61/uploads/origins/b996a4b2-5100-4514-9e77-cdf978babde8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fbd31c894c9ad543e737e1aebc05c79", "src_set": ""}, "body": "こんにちは、TwitterのFancy Fatherです。Ubisoftのレイマンと一緒に、未使用の毛皮のゾンビキャラクターデザインのラビッツと楽しそうに戦う自分の絵やイラストをお願いできますか？また、背景の大きな目とウサギの耳のついたレイマン4の金属製の船がレーザーを発射しているのを追加していただけませんか？提供された参考画像にあるメガネをかけた人間です。また、私が言う未使用のラビッツの資料も提供します、あなたには新しいかもしれませんが、私はとても気に入っています。\n\n参考文献\n\n私自身 参考文献その1\n\nhttps://drive.google.com/file/d/15LTB_2g05tpMN_B1Joa167WJIQesh_-w/view?usp=sharing\n\n自己紹介2:\n\nhttps://drive.google.com/file/d/1h5c_yUs8b1H5eIYwIabELXDjHGPrlaQi/view?usp=sharing\n\nゾンビ・ラビド Ref:\n\nhttps://drive.google.com/file/d/1hS6HgV2ikvjKD-V4JM9-H7d8pN_OHc0v/view?usp=sharing\n\nラビド船 Ref:\n\nhttps://drive.google.com/file/d/1sFgkEck2a1wWuan4aQ-FfDtAbJ8Zdis7/view?usp=sharing\n\nRayman 4 E3 Trailer Footage:\n\nhttps://www.youtube.com/watch?v=snwJsDajvo8\n\nhttps://www.youtube.com/watch?v=snwJsDajvo8", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@batekka/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 64093, "client_id": 1118476, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1e0e11e/uploads/origins/8165a0f6-1cca-490e-80eb-8a8eb4c40f63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e16739ee30be1d95cf81f3809f98f3d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1e0e11e/uploads/origins/8165a0f6-1cca-490e-80eb-8a8eb4c40f63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07dde439762c2f9e1f2f8c3231c3f781", "src_set": ""}, "body": "こんにちは！！。あなたの作品がとても大好きです!私のキャラクター \"Brussel Sprout \"を描いていただけますか？彼はおっちょこちょいな男なんだ。ポーズはあなた次第です、楽しんでください。\n\nhttps://toyhou.se/12339699.brussel-sprout/gallery#38569907", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@batekka/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "