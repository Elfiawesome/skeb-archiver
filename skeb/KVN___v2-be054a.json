等の描写がとても好みだったので……）。\n\n\n【使用用途】\n個人鑑賞用、skeb等のキャラクター資料\n\n\n以上になります。金額不足などありましたら、お手数ですが再送要請をお願い致します。\nそれでは、御縁がありましたらどうぞよろしくお願い致します。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KVN___v2/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a9e862ed/uploads/origins/82130527-e9a3-40b1-9f48-0f247d9cdcf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed3572d307a0e2480253a58f7651f1fa", "srcset": "https://si.imgix.net/a9e862ed/uploads/origins/82130527-e9a3-40b1-9f48-0f247d9cdcf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed3572d307a0e2480253a58f7651f1fa, https://si.imgix.net/a9e862ed/uploads/origins/82130527-e9a3-40b1-9f48-0f247d9cdcf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0729b1c2fe7987dca4faf057acb24b7 2x, https://si.imgix.net/a9e862ed/uploads/origins/82130527-e9a3-40b1-9f48-0f247d9cdcf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=acb7c0f0e71119b884e1b7234e927cec 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3263282, "client_id": 948093, "nc": 33}, {"path": "/@KVN___v2/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4b69603e/uploads/origins/a38e7db0-0de5-4f83-b481-ba64e621dda2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e45aacd609770325d2ecb50b9e86906", "srcset": "https://si.imgix.net/4b69603e/uploads/origins/a38e7db0-0de5-4f83-b48