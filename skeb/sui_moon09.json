lient_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@sui_moon09/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1189312, "client_id": 3041546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42c57007/uploads/origins/0c76700f-a7b2-410f-aaae-f961f04f630a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b91bfed687850adfed307eefd7d20b82", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42c57007/uploads/origins/0c76700f-a7b2-410f-aaae-f961f04f630a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9164393cae91562609c415f9d07dee4", "src_set": ""}, "body": "こんにちは！あなたの作品を拝見しましたが、とても美しい作風ですね！もし興味があれば、私のキャラクターの絵をお願いしたいです！\n\n参考資料の中に、私のキャラクターの目を覆っている蛾がいます。可能であれば、彼女の目を描いて、代わりに蛾を別の場所に描いていただけませんか？あなたの目の描き方が大好きです！あなたの目の描き方が大好きです！どんなディテールやアイデアを加えても構いません。それ以外はすべてお任せします！あと、参考資料が少なくてすみません！\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/13De4BswqpnA04hSwygPZhepsjJyIKWGs?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sui_moon09/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1189312, "client_id": 2191796, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55f6bddf/uploads/origins/640c1c07-6b34-4c97-867f-b7fd079de7b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fde305e6b1d449e86a3885e3972dc04", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55f6bddf/uploads/origins/640c1c07-6b34-4c97-867f-b7fd079de7b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9e7f21d2fe8120c41663faf6d617605", "src_set": ""}, "body": "こんにちは！あなたの絵が大好きです！私の幽霊少女のキャラクターを描いていただけませんか？\n-\n身長180cm、年齢は30歳くらい。\n彼女は空間と時間の魔法の研究者だったが、実験中に命を落とした。ドルイドによってゴーストとして復活したが、記憶は完全に分断されている。現在は図書館で孤独な日々を過ごしている。\n等身大（身長180cm）の磁器のマリオネットを遠隔操作しない限り、彼女は自分が死んだデミ・プレーンから出ることができない。彼女は研究材料を調達するため、あるいは外出する口実のためにそうする。他の世界や時間軸に送ることもできるので、舞台は問わない。\n📖 マリオネットを操るときは魔法が使えないので、短剣を振るう。\n📖 モチーフは本、ドア、鍵、時間の概念（時計仕掛け、砂時計など）。\n\n特に指示がなければ、あなたの好きなように構成してください。衣装は正装かマトリオネットでお願いします。ご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/17xWEFl-w9HKRJF62A4MiA3ICmoefju_g?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sui_moon09/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1189312, "client_id": 3022549, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2e4b6477/uploads/origins/d54d4e32-1efa-48d3-b2cb-8c59d6eaba4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e91d364c2a3cd9450db1e3d626aeb501", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e4b6477/uploads/origins/d54d4e32-1efa-48d3-b2cb-8c59d6eaba4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=638482330984e99cf4b864ce26b9e4a4", "src_set": ""}, "body": "リクエスト依頼失礼いたします。\n璻。様には以前、Twitter(現X)で、挿絵の依頼をさせていただいたことがあり、今回skebをされるということで、リクエストお送りさせていただきました。\n「燕(鳥のツバメ)」でイラストをお願いしたいです。擬人化でも構いませんし、ツバメと人物という構図でも構いません。構図等はおまかせいたしますが、スマートフォン(iPhone 14)の壁紙に使用したいと考えております。\nまた、宛名について「ありなし両方のファイルを希望」を選択しましたが、宛名なしのみでも構いません。\nご検討よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 28951, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Panda アニケット10/4", "screen_name": "Panda23577667", "avatar_url": "https://pbs.twimg.com/profile_images/1874110967245864960/UxPmPKLw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/98757289012712