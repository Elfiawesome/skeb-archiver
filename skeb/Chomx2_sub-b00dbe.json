r=200&s=9d8292fd9d5fe87df249a9a280d174f7, https://si.imgix.net/a7b5ae99/uploads/origins/579cb52d-9109-4299-8b25-a109dfdaad53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=19a0713bfe6a3ce6600bc5b1c7571eb7 2x, https://si.imgix.net/a7b5ae99/uploads/origins/579cb52d-9109-4299-8b25-a109dfdaad53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2ea14e24515541dd1dbec202e0b6a2a3 3x"}, "body": "ﾁｮﾑﾁｮﾑ様\n\nいつもお世話になっております。個人VTuberのさくらぎだよ！と申します。\n\n以前はTwitchスタンプ用イラストを作成いただきありがとうございました。とても気に入っていて、リスナーさんにも好評です。\n\n今回はSDイラストをお願いしたく、リクエストさせていただきました。\nリクエストの内容、使用用途に問題がなければイラストを描いていただけると嬉しいです。\n\n【参考資料】\nXの固定ポストに三面図がございます。お手数ですがそちらを参考にしていただきますようお願いいたします。\n\n【リクエスト内容】\n・構図や表情、ポーズなど全ておまかせいたします。\n・等身はできれば1.5にしていただけますと幸いです。(衣装が複雑なので再現が難しい等ございましたら2.5等身でも大丈夫です。また、適宜省略していただいても大丈夫です。)\n\n【使用用途】\n・収益化しているTwitch、YouTubeチャンネルでの使用\n・SNS利用\n・グッズ制作(アクリルスタンド等を検討中です)\n\n可能であれば人物のみの透過データをいただけると大変ありがたいです。\n\nskebの利用が初めてのため、失礼や不備がありましたら申し訳ございません。\n何卒、ご検討のほどよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Chomx2_sub/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3823056, "client_id": 3895868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2da3c0e/uploads/origins/1576de59-57ac-4bfa-a640-f033349f5beb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4a486c32a8019827bc6b490e23086b8", "srcset": "https://si.imgix.net/c2da3c0e/uploads/origins/1576de59-57ac-4bfa-a640-f033349f5beb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4a486c32a8019827bc6b490e23086b8, https://si.imgix.net/c2da3c0e/uploads/origins/1576de59-57ac-4bfa-a640-f033349f5beb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddf503068721b48c6bdd43c76c98d1f3 2x, https://si.imgix.net/c2da3c0e/uploads/origins/1576de59-57ac-4bfa-a640-f033349f5beb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d6b3485f016bd464717e1e5a4822591 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c2da3c0e/uploads/origins/1576de59-57ac-4bfa-a640-f033349f5beb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f8b2743263b4fbe5d96d07563caa762", "srcset": "https://si.imgix.net/c2da3c0e/uploads/origins/1576de59-57ac-4bfa-a640-f033349f5beb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f8b2743263b4fbe5d96d07563caa762, https://si.imgix.net/c2da3c0e/uploads/origins/1576de59-57ac-4bfa-a640-f033349f5beb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b99f34c1306a40529a89c1477e05fc77 2x, https://si.imgix.net/c2da3c0e/uploads/origins/1576de59-57ac-4bfa-a640-f033349f5beb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f8c23d3e364267c791e18f4fa336f1db 3x"}, "body": "ﾁｮﾑﾁｮﾑ様\n\n初めまして。個人でデザイナー兼配信活動をしているのだめろんと申します。\nいつもチョムチョムさんのSDキャラの可愛さに癒されております…！\nいつかはチョムチョムさんにイラストを描いていただきたい！…と思い、今回リクエストさせていただきました…！\nもしリクエスト内容、使用用途が問題なければ、是非私のイラストを描いていただければなと思っております…！\n\n【参考資料】\nhttps://www.dropbox.com/scl/fo/x2wguxrqjbg0i43hazsd7/AJpGPHqr_LZfUUFx8mbKkCM?rlkey=xqy4ik9v1t4k7kxwd2k4nu3f0&dl=0\n\n・構図や表情、ポーズなどは全てお任せ致します。\n・服装・アクセサリー等はキャラデザのものでなくても構いません。（帽子をトルなど、装飾品を減らしたり、全く別の服装になっても構いません。雰囲気等の希望はキャラシに記載しておりますが…チョムチョムさんのお好きに描いていただければなと思っております…！）\n\n【使用用途】\n・収益化をしているTwitch・Youtubeチャンネル等のサムネイル\n・SNSのアイコン、ヘッダー、投稿等\n・グッズ制作\n\n\n・納品形式は可能であれば人物・背景・小物（←もしあれば）を分けたpsdデータもしくは透過画像での納品だと大変助かります。\n\n何卒、ご検討のほど宜しくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Chomx2_sub/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3823056, "client_id": 3616732, "vtt_url": null, "thumbnail_image_urls": {"src": "h