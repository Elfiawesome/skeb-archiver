ebp&fit=crop&crop=top&w=200&h=200&s=154ce3d231eedcceb4c1a51ed5453096, https://si.imgix.net/f9f6f74f/uploads/origins/fee11461-61e4-475b-8e7d-e0d588010c60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5038bb11b2a9c73d0d64be4827560891 2x, https://si.imgix.net/f9f6f74f/uploads/origins/fee11461-61e4-475b-8e7d-e0d588010c60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8da63d587a457c9cecf0cfe44887e984 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9f6f74f/uploads/origins/fee11461-61e4-475b-8e7d-e0d588010c60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e25d72a03555dda2ed69b2357edf90e", "srcset": "https://si.imgix.net/f9f6f74f/uploads/origins/fee11461-61e4-475b-8e7d-e0d588010c60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e25d72a03555dda2ed69b2357edf90e, https://si.imgix.net/f9f6f74f/uploads/origins/fee11461-61e4-475b-8e7d-e0d588010c60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0017b7911bd12dd6b065d7ab2ca09e34 2x, https://si.imgix.net/f9f6f74f/uploads/origins/fee11461-61e4-475b-8e7d-e0d588010c60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bd5bcc7a680d37cd78470668ead2373f 3x"}, "body": "以前ナンパの日に描いておられましたボーイッシュ少女ちゃんがシチュ含めて非常に好みだったので依頼させていただきたく思います。\n\nシチュとしましては、\nあの後チャラ男の思い付きでボーイッシュ少女を知る人間(かつてナンパを邪魔されたとか個人的な恨みがある)を交えた乱交パーティーが開かれ、以前の件を引き合いに出されながら犯されるボーイッシュ少女。\n\nその様子をチャラ男とその女友達が談笑しながら眺めていて、チャラ男の女友達は別段ボーイッシュ少女の近しい知り合いではないものの、男に媚びず女であることも主張せずいかにも自分たちとは違うと言わんばかりのイメージだった彼女がセフレ以下の扱いで弄ばれている光景に愉快さを感じており、一連の彼女の顛末や現状を揶揄しつつ面白そうという理由で、手伝うから今後もさらに色々と躾け辱めるようチャラ男を煽る。\n\nといった感じでお願いします。\n(大体の部分が合致していれば大丈夫ですので、趣味でない部分は省いていただいたり、逆にお好みの要素を盛り込んでいただくのは大歓迎です。)\n\n服装、構図等はお任せしたく思いますが、堕ち具合はもう強く逆らえない段階ではあるものの自発的に媚びるまではいかないくらいの感じが理想的です。\n\nまた談笑部分はセリフや吹き出し等で伝わればその様子自体は省いていただいても結構ですが、同性からの誹りや責めは好みの要素ですので織り込んでいただけると幸いです。\n\n注文が多く申し訳ありませんが、もし宜しければ御一考ください。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@umeshake_takana/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 99214, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/36ed5d2d/uploads/origins/3a8cfc5d-d687-43b8-a29f-d93bd2de8fac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4e7c58343b9e54adb03c88203a7055b", "srcset": "https://si.imgix.net/36ed5d2d/uploads/origins/3a8cfc5d-d687-43b8-a29f-d93bd2de8fac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4e7c58343b9e54adb03c88203a7055b, https://si.imgix.net/36ed5d2d/uploads/origins/3a8cfc5d-d687-43b8-a29f-d93bd2de8fac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43d661612ae0ff6468fd3bb739bdc005 2x, https://si.imgix.net/36ed5d2d/uploads/origins/3a8cfc5d-d687-43b8-a29f-d93bd2de8fac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb22f7997932bd9e7f1129bbe6b0366b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36ed5d2d/uploads/origins/3a8cfc5d-d687-43b8-a29f-d93bd2de8fac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4111a57e34289b45d386b62449d0c5f", "srcset": "https://si.imgix.net/36ed5d2d/uploads/origins/3a8cfc5d-d687-43b8-a29f-d93bd2de8fac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4111a57e34289b45d386b62449d0c5f, https://si.imgix.net/36ed5d2d/uploads/origins/3a8cfc5d-d687-43b8-a29f-d93bd2de8fac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a109954f5cce6744bc65d3ce27e1fa4d 2x, https://si.imgix.net/36ed5d2d/uploads/origins/3a8cfc5d-d687-43b8-a29f-d93bd2de8fac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eed61aabb2092c8553fafd27d9e20d77 3x"}, "body": "いつも楽しみに拝見させて頂いております。\n\n正義感の強い巨乳ボーイッシュ少女の屈服後といったイメージで、軽薄そうな男たちから馴れ馴れしく身体を触られても以前のような反抗もできずされるがままになっている姿をかつてナンパから庇ったモブ少女に目撃されてしまうみたいな感じのシチュをお願い致します。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@umeshake_takana/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 99214, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fbda71c1/uploads/origins/a0b531cb-7f7d-4979-9dae-76fce17ce64d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4af413f86432ebbd2bdcf1665140b697", "srcset": "https://si.imgix.net/fbda71c1/uploads/origins/a0b531cb-7f7d-4979-9dae-76fce17ce64d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4af413f86432ebbd2bdcf1665140b697, https://si.imgix.net/fbda71c1/uploads/origins/a0b531cb-7f7d-4979-9dae-76fce17ce64d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8f8ad07a7d65e2d48d8db1388748a34 2x, https://si.imgix.net/fbda71c1/uploads/origins/a0b531cb-7f7d-4979-9dae-76fce17ce64d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80e4b0b7d92a67b8a5d4ea357623ffed 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fbda71c1/uploads/origins/a0b531cb-7f7d-4979-9dae-76fce17ce64d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4745cf7ad260904a32f52fb5041317db", "srcset": "https://si.imgix.net/fbda71c1/uploads/origins/a0b531cb-7f7d-4979-9dae-76fce17ce64d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4745cf7ad260904a32f52fb5041317db, https://si.imgix.net/fbda71c1/uploads/origins/a0b531cb-7f7d-4979-9dae-76fce17ce64d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a8f574abf510ea585a0f4936d53a880b 2x, https://si.imgix.net/fbda71c1/uploads/origins/a0b531cb-7f7d-4979-9dae-76fce17ce64d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d819914c9d55f309b2852ed6a61fd0c3 3x"}, "body": "pixivのスパッツの下ドスケベ下着シチュが良かったので似た組み合わせでリクエストさせて頂きます。\nまたシチュについては希望が絞れなかったので、2つのうちからお好みの方を選んでください。\n\n女の子の設定\n巨乳+巨尻の元陸上部で、部活を引退して受験勉強に専念している。\n陸上部時代はショートだったが引退してから伸ばし始めており、運動時はポニテにする。\n1つ年下の幼馴染男子と友達以上恋人未満の付き合い。\n\n\nシチュエーション\n0.出だし\nストレス解消と称して幼馴染男子に付き合ってもらい軽く運動を終えたところ。\n服装は陸上セパレートなのだが乳首やスジが浮いている。また顔は運動以外の理由で紅潮している。\n(オープンブラ&ショーツを付けています))\n\n\n1.純愛？展開\n幼馴染の視線を思い出してオナニーする女の子。\n→何度達しても満足できず幼馴染を呼び出し。陸セパをずらしてエロ下着を見せつけながら告白。\n(可能ならそのまま女の子の方が幼馴染を逆レする展開希望です)\n\n2.NTR展開\n出だしの展開は顧問による調教の一環だった。\nあの状況で手をださない幼馴染をヘタレと馬鹿にする顧問にあいつは優しいのだと反論しながらも快楽に墜ちていく女の子。\n(処女は幼馴染のため守りたいと、アナルを捧げている展開が希望です)\n\nよろしくお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@umeshake_takana/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 99214, "client_id": 435000, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f26be1bf/uploads/origins/9e719d9f-ad5b-4449-aae3-c1bb4bb84fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fc3cda31d3315416a5cfc5c287b7bba", "srcset": "https://si.imgix.net/f26be1bf/uploads/origins/9e719d9f-ad5b-4449-aae3-c1bb4bb84fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fc3cda31d3315416a5cfc5c287b7bba, https://si.imgix.net/f26be1bf/uploads/origins/9e719d9f-ad5b-4449-aae3-c1bb4bb84fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=721390a44308453d4f811e238665079e 2x, https://si.imgix.net/f26be1bf/uploads/origins/9e719d9f-ad5b-4449-aae3-c1bb4bb84fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d93e9378b9d871f2c31eca47f3faaae 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_url