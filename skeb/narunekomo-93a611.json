eaef6bb-69b0-4754-bbd6-5aaba28270e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eb05f388c7635d9d8e88ccf06e38a216 2x, https://si.imgix.net/1069bbed/uploads/origins/0eaef6bb-69b0-4754-bbd6-5aaba28270e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=55d1953afab44aea6bacbc275e2c1128 3x"}, "body": "こんにちは。はじめまして。\n\nhttps://skeb.jp/@narunekomo/works/6 のようなスタイルでキャラクターを描いていただけないでしょうか。\n立ち絵のSDキャラです。\n開いた口＋閉じた口。\n帽子あり＋なし。\n\n私のキャラクターはユキヒョウです。\nソフトで穏やかな性格ですが、時には陽気でエネルギッシュになることもあります。\n\nソーシャルメディアやTwitchで使うかもしれません。\n\n色は自由に調整してください。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/mobile/folders/1-SHc48tTvlqr6_0uBBzQhpYbCrNq-I8C", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@narunekomo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2740075, "client_id": 2265069, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d01aec7d/uploads/origins/fe1b67ac-ee70-4738-8b11-17d9c78bc3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ca635a15e30a423e996bcea4948b382", "srcset": "https://si.imgix.net/d01aec7d/uploads/origins/fe1b67ac-ee70-4738-8b11-17d9c78bc3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ca635a15e30a423e996bcea4948b382, https://si.imgix.net/d01aec7d/uploads/origins/fe1b67ac-ee70-4738-8b11-17d9c78bc3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb5581ca242705f5434586a0ab02e024 2x, https://si.imgix.net/d01aec7d/uploads/origins/fe1b67ac-ee70-4738-8b11-17d9c78bc3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05605079c6b10c7f855f84a1a88c84d1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d01aec7d/uploads/origins/fe1b67ac-ee70-4738-8b11-17d9c78bc3cf?bg=%23fff&au