洋服を勝手に着たりします。\n\n◎イラストについて\n資料のままの服でもいいですし、お揃いで色違いのパジャマをきている様子などもかわいいな…と思います。おまかせいたします。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-iGHFVYqNe9_oQTYK6DaNTXBP4tf04-I\n\nhttps://drive.google.com/drive/folders/1-iGHFVYqNe9_oQTYK6DaNTXBP4tf04-I", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shigu_taku/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2761109, "client_id": 3670054, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08792819/uploads/origins/9989ee19-2655-4c99-9a70-b5c0a463be6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=755cad304ef5308635ce9d81fca74eeb", "srcset": "https://si.imgix.net/08792819/uploads/origins/9989ee19-2655-4c99-9a70-b5c0a463be6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=755cad304ef5308635ce9d81fca74eeb, https://si.imgix.net/08792819/uploads/origins/9989ee19-2655-4c99-9a70-b5c0a463be6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cf58a9825a51c52e033f6cece5588df 2x, https://si.imgix.net/08792819/uploads/origins/9989ee19-2655-4c99-9a70-b5c0a463be6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c4541515baac2c6a7aa9bd3c0d387d9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08792819/uploads/origins/9989ee19-2655-4c99-9a70-b5c0a463be6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e1d391e735a1049f635dbe245ec9c53", "srcset": "https://si.imgix.net/08792819/uploads/origins/9989ee19-2655-4c99-9a70-b5c0a463be6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e1d391e735a1049f635dbe245ec9c53, https://si.imgix.net/08792819/uploads/origins/9989ee19-2655-4c99-9a70-b5c0a463be6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&