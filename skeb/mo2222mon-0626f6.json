d/uploads/origins/a8a69d6b-fd55-46e4-a986-9d90e441736a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90683e91cbf787d990fd7a30392b7f4c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9118932d/uploads/origins/a8a69d6b-fd55-46e4-a986-9d90e441736a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71e129588ce34eb7d311e07b6237842e", "srcset": "https://si.imgix.net/9118932d/uploads/origins/a8a69d6b-fd55-46e4-a986-9d90e441736a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71e129588ce34eb7d311e07b6237842e, https://si.imgix.net/9118932d/uploads/origins/a8a69d6b-fd55-46e4-a986-9d90e441736a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ba8b4c2d1d1df65be6409b2cafb1d125 2x, https://si.imgix.net/9118932d/uploads/origins/a8a69d6b-fd55-46e4-a986-9d90e441736a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=963ea8107d5ed7295e1d760882b904d3 3x"}, "body": "もさん、今回リクエストしたいのは、OCのBLCPです！\n資料は↓をご確認いただけると幸いです。\nhttps://drive.google.com/drive/folders/1Pa71hrUHT8dRwUp4x1t8GgJEk6x7tQhB?usp=drive_link\n世界観　戦後平和時代\n\n・P（攻）\n・紫髪紫眼・三白眼\n・彼は服装にはあまり気を使わないのでネクタイが乱れています\n・イヤリングは羽根素材です\n・183cmくらい\n・ある組織のリーダー、見た目は軽薄で、いつも笑っていますが、恋愛感情が少し幼稚です.\n能力が高い,基本的に欲しいものは何でも手に入るので、自分のことも仕事のことも好き勝手です（でも、下手なわけではありません）、欲しいものが自分のものではないと、気むずかしいで怒りっぽくなりがちです。\n基本的にGの前では90%本物の彼です。\n\n・G（受）\n・赤髪黒目・常に「顔は女のように綺麗」と言われま\n・いつも無表情で無愛想に見える・表情があっても幅が小さいです\n・171ｃｍくらい\n・過去のトラウマが感情的欲求や記憶の一部を失っているため鬱状態になっているのです\n\nキャラクターに合わせて自由に描いていただいて大丈夫です。もし特にアイデアがなければ、例えばこんなシーンも考えています。\n朝、Pが目を覚ますとGはまだ眠っています。PはそんなGの姿を見ながら、子どもの頃に母に連れられて教会で見た聖母像のことを思い出します。そして、こんなにも打ち砕かれているのに、どうして彼はこんなにも清らかに見えるのだろう、と考えます。\nもちろん、もっと軽い雰囲気のストーリーを描いていただいても大丈夫です。\n\nラフ画や下絵があれば、お送りいただけると嬉しいです。\nPSDデータで納品していただけると幸いです。また、背景や宛名がある場合は別レイヤーでお願いできるととても助かります。\n何か不都合があれば、遠慮なくお断りいただいても構いません。お忙しいところ恐れ入りますが、ご検討のほどよろしくお願いいたします。", "nc": 144