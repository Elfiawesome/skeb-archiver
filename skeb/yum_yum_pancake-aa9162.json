9-594db91dead5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b06c793440899b493e45e005f4bee2c", "srcset": "https://si.imgix.net/638ba9b4/uploads/origins/9faa00e9-2749-41dd-bbb9-594db91dead5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b06c793440899b493e45e005f4bee2c, https://si.imgix.net/638ba9b4/uploads/origins/9faa00e9-2749-41dd-bbb9-594db91dead5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=402bcbab37fb5602318a2c5833ebee6e 2x, https://si.imgix.net/638ba9b4/uploads/origins/9faa00e9-2749-41dd-bbb9-594db91dead5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d5bca7a23203c93eb7b14a740b34384a 3x"}, "body": "遊戯王のRAI-MEIとEMユニ・コンのフタナリ3P二穴責めレズセックスをリクエストさせて頂きます\n\n受け:RAI-MEI。生えてない。全身むちむちの頭身高めで乳のサイズは頭より大きく上半身を目一杯覆い、股間がギリギリ見えるくらいの超乳。ツインテールは腰に届く位の長さ。\n\n竿役:EMユニ・コン。RAI-MEIと同様の体型かつ腹ボコ出来そうなサイズの馬チ○ポ付。\n\n服装は3人とも元のカードのイラストで着ている物で、RAI-MEIは股間が♡型の穴空きで露出勃起した乳首と盛り上がった乳輪が布越しにくっきり浮かび上がっており、ユニとコンは陰茎が衣装の股間部の穴空きから露出した状態。\n体位はRAI-MEIがユニの上に跨がりその後ろにコンがいる騎乗位をRAI-MEIの正面が良く見えるアングルで、ユニとコンの様子は顔から胸全体までのワイプを別枠で写すようお願いします。\n\n挿入前。ユニとコンが挿入を焦らし、RAI-MEIがそれに対し完全に堕ちきった様子で媚びながら挿入を懇願する。\n↓\n挿入時。ユニ・コンがSッ気のある表情で両方の穴に同時に挿入し、RAI-MEIはその衝撃で間抜けな叫び声を上げ即堕ちアへ顔アクメを晒す。\n↓\n挿入後。激しくピストンしながら三人とも軽めのアへ顔でオホ声混じりの淫語を連発しよがっている。\n↓\n両穴に大量中出し&絶頂。三人とも汚い口調で淫語を絶叫しながらイき、白目を剥いたここ一番の変顔に片足突っ込んだアへ顔になる。\n\n…という流れで、三人それぞれにセリフを付けて頂きたいです。キャラの性格や口調はRAI-MEIがくっ殺の似合う隠れマゾなお姉さん系、ユニとコンは性欲に振り回されてドSでオラついているイメージです。\n\n細かく指定してしまいましたが何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1OrmF-Yvki6G5dNhXF00bsfUEGbfqYxX_", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yum_yum_pancake/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 326451, "client_id": 187209, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3ed3a18/uploads/origins/9f0dc641-5c8c-4439-9305-534350088fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=076d06cdf89eba1d27822f26b2e8071e", "srcset": "https://si.imgix.net/f3ed3a18/uploads/origins/9f0dc641-5c8c-4439-9305-534350088fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=076d06cdf89eba1d27822f26b2e8071e, https://si.imgix.net/f3ed3a18/uploads/origins/9f0dc641-5c8c-4439-9305-534350088fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d34d0a4a65eadaaff152ca0634ee61a 2x, https://si.imgix.net/f3ed3a18/uploads/origins/9f0dc641-5c8c-4439-9305-534350088fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df6c80cfd163ebc1129903b4ce0a4231 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3ed3a18/uploads/origins/9f0dc641-5c8c-4439-9305-534350088fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=175e94ea8769765e34eff6416dabb4ce", "srcset": "https://si.imgix.net/f3ed3a18/uploads/origins/9f0dc641-5c8c-4439-9305-534350088fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=175e94ea8769765e34eff6416dabb4ce, https://si.imgix.net/f3ed3a18/uploads/origins/9f0dc641-5c8c-4439-9305-534350088fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a9484dcd84d6c3db3cc4820be1b1c7d0 2x, https://si.imgix.net/f3ed3a18/uploads/origins/9f0dc641-5c8c-4439-9305-534350088fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3f79b6c0b4a1bbca078062a3daefb39a 3x"}, "body": "男の娘が自分の超巨大金玉に座りながらこれから挿入する勃起した超根にふたなりを跨らせて見せつける。ふたなりは男の娘のあまりに巨大すぎる超根と超玉に驚いている\n↓\n男の娘が超根を根元まで挿入し、ふたなりの腹が男の娘の超根の形になる（差分１）\n↓\n男の娘の数千リットル以上の超大量射精でふたなりの腹が超巨大な精液ボテ腹になり、逆流した精液が床を埋め尽くす。ふたなりも射精しているが、男の娘の足元にも及ばない量（差分２）\n\n・体位と構図はhttps://twitter.com/ryuk5960/status/1444449339884113921のような感じ\n\n・男の娘の容姿はhttps://skeb.jp/@aXZLLIPh6p/works/19やhttps://skeb.jp/@aXZLLIPh6p/works/26の銀髪ぱっつんロングで身長２３０ｃｍくらい、少し筋肉質で腹筋も割れている男の娘お嬢様\n\n・男の娘の玉の大きさはhttps://twitter.com/ryuk5960/status/1444449339884113921で、竿の大きさはhttps://twitter.com/ryuk5960/status/1444449339884113921の２倍で、竿には野太い血管がいくつも浮き出ている\n\n・男の娘の超玉はhttps://www.pixiv.net/artworks/79886581くらいの皺がある\n\n・ふたなりの容姿はhttps://www.pixiv.net/artworks/44724464から尻尾を無くした感じで身長は１８０ｃｍくらい\n\n・ふたなりの竿と玉の大きさはhttps://www.pixiv.net/artworks/60177857くらいで、普通の人間よりは大きいが男の娘には遠く及ばない大きさ\n\n・男の娘の表情は本気勃起には程遠い為、射精時でも余裕のある笑みを浮かべている\n\n・ふたなりの腹の中を透過して挿入されている男の娘の超根が見えるようにしてください\n\n・ふたなりの表情はイキまくっている感じ\n\n・二人とも全裸\n\n・男の娘の超根と超玉、ふたなりの腹が全て入るように描いてください\n\n・https://skeb.jp/@gausid_y/works/16のように男の娘の頭上に♂マーク、ふたなりの頭上に⚥マーク\n\n・局部は海苔でお願いします", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yum_yum_pancake/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ac434a1b/uploads/origins/9c71b974-ae5f-4509-bd03-03a27ebf6e83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2021a425ad113c8119cfe85b74a01556", "srcset": "https://si.imgix.net/ac434a1b/uploads/origins/9c71b974-ae5f-4509-bd03-03a27ebf6e83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2021a425ad113c8119cfe85b74a01556, https://si.imgix.net/ac434a1b/uploads/origins/9c71b974-ae5f-4509-bd03-03a27ebf6e83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=686124c821d232d1866e17962c57e128 2x, https://si.imgix.net/ac434a1b/uploads/origins/9c71b974-ae5f-4509-bd03-03a27ebf6e83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c5005c082023a772b498c1d2b2