2b7-96ad-ad04f5dfd1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97910c204344d0fd585a60a4bf1338e6 2x, https://si.imgix.net/bb2f20b4/uploads/origins/a702591c-6e8a-42b7-96ad-ad04f5dfd1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1296f0a6e80a5709a4197d0c387d1f0d 3x"}, "body": "年上彼女×年下彼氏カップルのイチャイチャをお願いします。\n\n以下キャラ設定です\n●彼女\n彼氏君より2歳くらい上の元気なお姉さん\n黒髪セミロング（肩くらいまで）\n髪型イメージ https://imgur.com/a/yD5GN98\n身長160センチ台後半でスタイル抜群・才色兼備\n彼氏君を溺愛しておりダダ甘\n本性は彼氏君に押し倒されて激しくされるのが好きな多分マゾ\n普段は優しい彼氏君が自分を押し倒す様に仕向けるのが日課\nでも腕っぷしは彼氏君より強い（当て身投げとか使える）\n自分の呼び方は「わたし」「〇〇お姉さん」・彼氏君の呼び方は「〇〇くん」「君」\n\n●彼氏\n高2～3くらいの目つき鋭い黒髪美男子\n髪型イメージ https://imgur.com/a/Wl9ydXY\n身長170センチ台後半の細マッチョ\n瘦せた狼みたいに冷たい感じだけど彼女には頭が上がらないツンデレ番犬系男子\n完璧超人な彼女のことを敬愛しているが、劣等感も抱いている\n彼女の掌の上で踊らされていることは自覚しているし少し悔しいが、彼女の幸せそうな様子を見ているとまあいいかと思ってしまう\nデレる時はストレートに愛の言葉をぶつけたりするタイプ(ズルい:彼女さん談)\n自分の呼び方は「俺」・彼女の呼び方は「〇〇さん」「あなた」・彼女には敬語\n\n以下は他の方に描いていただいたものですが、\n二人の関係性の参考までにどうぞ\n\nhttps://skeb.jp/@heiantomato/works/12\nhttps://skeb.jp/@heiantomato/works/50\nhttps://skeb.jp/@ororooooooops/works/74\nhttps://skeb.jp/@ororooooooops/works/87\nhttps://skeb.jp/@shiro_amadai95/works/6\nhttps://skeb.jp/@shiro_amadai95/works/10", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@M28513713/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1276062, "client_id": 2409369, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13e61fb6/uploads/origins/74730944-c294-49b1-8878-e00e91f2ea85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=646b755e40452e3a1cb428e09c2d059c", "srcset": "https://si.imgix.net/13e61fb6/uploads/origins/74730944-c294-49b1-8878-e00e91f2ea85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=646b755e40452e3a1cb428e09c2d059c, https://si.imgix.net/13e61fb6/uploads/origins/74730944-c294-49b1-8878-e0