=2&fit=crop&crop=top&w=200&h=200&s=bbcca6e1e7c203548d2d1942b3847732 2x, https://si.imgix.net/132955ed/uploads/origins/382373b0-86a3-4aed-8124-482e25b5871b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=145307e2b12551ae31a797d76fb80ba4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/132955ed/uploads/origins/382373b0-86a3-4aed-8124-482e25b5871b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e9b1938d8500d20411ffe87f81a05e9", "srcset": "https://si.imgix.net/132955ed/uploads/origins/382373b0-86a3-4aed-8124-482e25b5871b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e9b1938d8500d20411ffe87f81a05e9, https://si.imgix.net/132955ed/uploads/origins/382373b0-86a3-4aed-8124-482e25b5871b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=293d3b4bc1b5ab2b61ffde0bbea33cc9 2x, https://si.imgix.net/132955ed/uploads/origins/382373b0-86a3-4aed-8124-482e25b5871b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=387a530f594b4077196729df3c4a0026 3x"}, "body": "Twitchでゲーム配信メインで活動しているV配信者の芥辺あくと申します。\nTomoyuki様のイラストが好きです。髪の塗り方や顔のバランス、服の着せ方がとても好きです。もし良ければ芥辺を描いて頂きたく御依頼させて頂きます。\n顔のほくろと髪のメッシュの色、目の色以外はどうアレンジしていただいて大丈夫です。\n服装やポージングはお任せしたいです。可能であれば足を出した衣装を着せていただければ幸いです。\nもし条件が難しい場合は再送を要請頂ければと思います。お手数おかけして申し訳ありません。\nもしよろしければサムネやSNSでの投稿等で使用させて頂きたいので背景透過データも頂けると嬉しいです。\nよろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pueriko/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1233086, "client_id": 3188326, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/679def4d/uploads/origins/6e94faa0-25e0-415a-9112-8955170e599d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d7e1d805e12a1246ccb0459ad98a0ad", "srcset": "https://si.imgix.net/679def4d/uploads/origins/6e94faa0-25e0-415a-9112-8955170e599d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d7e1d805e12a1246ccb0459ad98a0ad, https://si.imgix.net/679def4d/uploads/origins/6e94faa0-25e0-415a-9112-8955170e599d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c46dd7fd75271e8847c9cc657b8af011 2x, https://si.imgix.net/679def4d/uploads/origins/6e94faa0-25e0-415a-9112-8955170e599d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6e1e3d65178c357fc336db56938ff03 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/679def4d/uploads/origins/6e94faa0-25e0-415a-9112-8955170e599d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=890739c85f58d67988071847d8544dec", "srcset": "https://si.imgix.net/679def4d/uploads/origins/6e94faa0-25e0-415a-9112-8955170e599d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=890739c85f58d67988071847d8544dec, https://si.imgix.net/679def4d/uploads/origins/6e94faa0-25e0-415a-9112-8955170e599d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6cb78595209a47fa33eece34e10db679 2x, https://si.imgix.net/679def4d/uploads/origins/6e94faa0-25e0-415a-9112-8955170e599d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2dbdea0170183767962331689ca3b794 3x"}, "body": "はじめまして。Vtuber準備中の夏空輝(なつぞらひかる)と申します。\nこの度Tomoyuki様の素敵なイラストをskebにて拝見し是非描いていただきたいと思いリクエストさせていただきました。\nできればイラストをひこうかいにして頂きたいです。申し訳ありませんがよろしくお願い致します。\n\nー依頼内容ー\n夏空輝のハロウィンイラスト。衣装につきましては、腹部や胸の露出はないもので、お任せしたいです..!\n 構図などに特に指定はありませんができれば全身、難しければ膝から上。髪や服など見切れる場所がないようにして頂きたいです。\nまた表情差分も頂けると助かります。難しければ大丈夫です。沢山のことをお願いしてしまい申し訳りません。\n\nー参考資料ー\n\nhttps://ibb.co/MkXYgb6\nhttps://ibb.co/4RmJ52Q\nhttps://ibb.co/5Tg74Tv\nhttps://ibb.co/kSJF4Tz\nhttps://ibb.co/8mTqMWR