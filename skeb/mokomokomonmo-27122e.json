7c879c6b549825618c 2x, https://si.imgix.net/03cd9fdb/uploads/origins/c3ca3301-90fc-4a77-bfc1-27d7553854b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ca1b2a4b97b91a6183ba2d0f6c4db69 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03cd9fdb/uploads/origins/c3ca3301-90fc-4a77-bfc1-27d7553854b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9cf0721d8880b55d09dd9be8a6f525c", "srcset": "https://si.imgix.net/03cd9fdb/uploads/origins/c3ca3301-90fc-4a77-bfc1-27d7553854b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9cf0721d8880b55d09dd9be8a6f525c, https://si.imgix.net/03cd9fdb/uploads/origins/c3ca3301-90fc-4a77-bfc1-27d7553854b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9def14629a75c0d809238f2b6a63f6e3 2x, https://si.imgix.net/03cd9fdb/uploads/origins/c3ca3301-90fc-4a77-bfc1-27d7553854b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ae69c3c4039cc3e2dfdf4ca904db5d24 3x"}, "body": "モコ様　お疲れ様です。\n\nTwitchで活動をしているがとーと申します。\nSNSのアイコンや配信のサムネイルに使える新しいイラストが欲しく、ご連絡させていただきました！\n\n以下依頼内容です。\n\n【依頼内容】\n・使用用途　\n配信のサムネなどで使えるイラスト\n\n・キャラクターの見た目(参考画像を4点添付しております)\n性別：男　年齢：20歳くらい\n印象：中性的な顔立ちでよく笑っていそう\n\n～キャラクター像～\nガトーショコラを擬人化したような見た目です！\nゲームが大好きで、本気でやるというよりは楽しんでやることに重きを置いています！！\nよく笑ったり泣いたりと感情豊かな男の子です。\nすこし幼い少年のような性格をしています。\n\n～表情～\n基本的にはモコ様にお任せしたいのですが、もしお困りでしたら\n笑顔でこちらを向いているような表情でお願いします！\n\n～ポーズ～\n表情に沿ったポーズでお願いしたいです！\n漠然としたお願いで申し訳ございません…\n\n～髪～\n色：全体は茶色　毛先だけ白色\n髪質：少しくせっ毛交じり\n髪型：長めのマッシュ\n\n～目～\n色：明るいラズベリー色\n形：すこしたれ目\n\n～服装～\n添付させていただいた全体絵のパジャマ服\n\n～他アイテム～\n・ピアス　目と同色で三角形のものを左にのみ\n・マニキュア　チョコのようなこい茶色\n\nまた、もしよろしければ頭部分が切れていない人物のみの透過イラストもいただけると幸いです！\n難しければ大丈夫です！！\nつたない文章で申し訳ございません。\n以上ご検討のほどよろしくお願いいたします…！！\n\nhttps://drive.google.com/drive/folders/1Yl8m4ZDrap7LLuEShqYvS5Uqk_n_0kBZ?usp=sharing", "nc": 145, "word_count": 0, "transcoder