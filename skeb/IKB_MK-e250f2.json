table_same_genre": true}, {"path": "/@IKB_MK/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3422699, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0251c3dd/uploads/origins/820b3c07-f301-48b5-bff5-70f66ca74f06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae3632ea5ad3eed3b5e4fb74faba80f3", "srcset": "https://si.imgix.net/0251c3dd/uploads/origins/820b3c07-f301-48b5-bff5-70f66ca74f06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae3632ea5ad3eed3b5e4fb74faba80f3, https://si.imgix.net/0251c3dd/uploads/origins/820b3c07-f301-48b5-bff5-70f66ca74f06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f53076d36c941b00380cee236cea73b2 2x, https://si.imgix.net/0251c3dd/uploads/origins/820b3c07-f301-48b5-bff5-70f66ca74f06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3b0ae61f282e26a7d78c0744d571aeb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0251c3dd/uploads/origins/820b3c07-f301-48b5-bff5-70f66ca74f06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e81f4c2c9378e333216bb53c12d0bbd", "srcset": "https://si.imgix.net/0251c3dd/uploads/origins/820b3c07-f301-48b5-bff5-70f66ca74f06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e81f4c2c9378e333216bb53c12d0bbd, https://si.imgix.net/0251c3dd/uploads/origins/820b3c07-f301-48b5-bff5-70f66ca74f06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9342ffae2a31169d277aab918dbb3d9a 2x, https://si.imgix.net/0251c3dd/uploads/origins/820b3c07-f301-48b5-bff5-70f66ca74f06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0d8ffe99dca39213168b823f060264e2 3x"}, "body": "画像資料のオリジナルキャラクター（OC）をリクエストします。\n納品された作品は個人観賞以外に、今後のイラストコミッションにてSkebサンプルと同サイズ（横800ピクセル）に縮小した上で、\n画像資料の様に使わせて頂く場合があります。\nこの内容をご了承いただけない場合はキャンセルでお願いします。\n\n〈作品形式〉\n『モノクロ漫画５P』『線画描きこみ量アップ』\n\n〈登場人物〉\nOCとそのパートナー（夫）。\n\n・OCは資料のニ年程前。当時感情が薄く基本無表情、瞳にハイライト無し（冒頭1～2Pくらいまでは）。\n・実況も心の声も常に丁寧語、ですます口調。\n・下品な単語は使わず（精々『あそこ』『お尻の穴』『おちんちん』くらいまで）可愛らしさ清楚さを残して。\n・下半身の肉付きはムッチリ目で。\n・陰毛有り。秘部の色素沈着強め。肥大した小陰唇。ふっくら隆起した経験豊富な肛門。\n\n・パートナーは中肉中背、締まった筋肉質。二歳年下の優しげな童顔。当時童貞、他お任せ。\n\n〈シチュエーション〉\nパートナーとの初夜の冒頭、挿入直前まで。\n\n・設定上、膣への異物挿入が不可能な為肛門性交になります。そのことは二人とも認識済み。\n\n・二人だけの結婚式を挙げた日の夜、宿の寝室。\n・服を脱ぎ下着だけとなった、ベッドに並び腰掛けている二人からスタート。\n・ガチガチのパートナーに、「緊張、していますか……？」と、リードするつもりで唇を重ねていくOC。\n・経験したことが無い『愛しい』という感情に戸惑うOC。\n・がっつき始めるパートナー。べろちゅーに移行、並行して外性器愛撫も。汁気多めで。\n・情愛と快感で理性が溶けていくOC。受けの姿勢に。\n・OCお尻を上げたうつ伏せに、アニリングスへ。舌を入れられ内壁舐められたり、強く吸引されたり。\n・内心で羞恥が爆発するOC。恥ずかしいダメ、と気持ちいい嬉しいが両立。\n・口を離され唾液腸液でベトベトになりポッカリ開いた肛門。ふすーと空気の抜ける響き。\n・勃起したペニスを当てられ、ドキドキが止まらないOC。\n・了。\n\n・画造りは男性向け作品寄りで、TL作品のように女性側の心の声多めだと嬉しいです。\n・世界観は一応ファンタジーですが、あまり囚われず自由にデザインしてください。\n・「https://www.pixiv.net/artworks/128630318」\n・↑こちらのサンプル最終コマの様なムッチリ感がとてもとても刺さりましたので、肉感を強調して頂けると幸いです。\n\n・肉体経験豊富な娘が、初めての恋でウブ化するのいいよね！と\n・見た目清純ぽい娘が下品な肉体反応するのいいよね！を詰め込んで下さい。\n\n\n\nよりクオリティが上がるアイデアがあれば採用、アレンジしてしてください。\n金額等問題がありましたら条件付きリクエスト再送要請で対応お願いします。\nご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1KEOfTK-eettFsZ2_RAVcq1XeDIuKcjj9", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@IKB_MK/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/de83d10a/uploads/origins/48d7dc7c-16c5-4193-b3ef-c7780182fa71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=345e1d0906634251f7eb6a10d8b836a9", "srcset": "https://si.imgix.net/de83d10a/uploads/origins/48d7dc7c-16c5-4193-b3ef-c7780182fa71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=345e1d0906634251f7eb6a10d8