=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6245c4ba32f7047fad0dc09af50f203a, https://si.imgix.net/48fb4eba/uploads/origins/39e0c0e5-f1cc-4ef8-82a1-56ff74f48631?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85c00224455813d50542bddfed75f3e9 2x, https://si.imgix.net/48fb4eba/uploads/origins/39e0c0e5-f1cc-4ef8-82a1-56ff74f48631?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d683b562c6015ad5687603706b2ea7c4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48fb4eba/uploads/origins/39e0c0e5-f1cc-4ef8-82a1-56ff74f48631?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a34c5906b4dddb40e7a2d362789eb60b", "srcset": "https://si.imgix.net/48fb4eba/uploads/origins/39e0c0e5-f1cc-4ef8-82a1-56ff74f48631?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a34c5906b4dddb40e7a2d362789eb60b, https://si.imgix.net/48fb4eba/uploads/origins/39e0c0e5-f1cc-4ef8-82a1-56ff74f48631?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dd5e2bcbb263a89f11b38ed25c86769a 2x, https://si.imgix.net/48fb4eba/uploads/origins/39e0c0e5-f1cc-4ef8-82a1-56ff74f48631?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5cde8664b50c57ec1f0adbfd56481c47 3x"}, "body": "他の方の依頼を見てどうしても下記のような内容をご依頼したくなりリクエストをさせていただきました\n\n拳法部の5人がウィッチ・ガーデンに到着したが、マキナは不在であった。\n不思議に思う5人の元にメールが届き、今日は病欠のため休業の看板を出しておいてくれとの連絡が来ます。\nそれを見た彼女たちは、普段世話になっている彼女のために自分達で店を開けて、何とかしようとします。\nそんな折にタイミング悪く、酔っぱらったおじさんグループが来店してしまいます。\n休んでいるマキナに迷惑を掛けないために、騒ぎを起こせない5人は強く出れず…\n\n流れを書いてはみましたが、マキナ(にらみを利かせる人)がいない状態でおじさん達が来店し\n色々されてしまうというシチュエーションをお願いしたいため\nそのシチュエーションであれば書きやすいように書いていただければと思います。\n\n難しい内容かとは思いますが、よろしくお願いします。", "nc": 24, "word_count": 11158, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@oumikado/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1222391, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/074d1bf8/uploads/origins/a57a2e85-6bc8-4af9-9a2e-e1378b05cd00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8129ce22f5b01f8bd8985036885bc28", "srcset": "https://si.imgix.net/074d1bf8/uploads/origins/a57a2e85-6bc8-4af9-9a2e-e1378b05cd00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8129ce22f5b01f8bd8985036885bc28, https://si.imgix.net/074d1bf8/uploads/origins/a57a2e85-6bc8-4af9-9a2e-e1378b05cd00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=287b6776a4d8a45c1dce27b37be583f4 2x, https://si.imgix.net/074d1bf8/uploads/origins/a57a2e85-6bc8-4af9-9a2e-e1378b05cd00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16a779bb3c26adaceeffaa2a9a0d94f9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/074d1bf8/uploads/origins/a57a2e85-6bc8-4af9-9a2e-e1378b05cd00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19e1476551e9df7321f7a8254f3df17e", "srcset": "https://si.imgix.net/074d1bf8/uploads/origins/a57a2e85-6bc8-4af9-9a2e-e1378b05cd00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19e1476551e9df7321f7a8254f3df17e, https://si.imgix.net/074d1bf8/uploads/origins/a57a2e85-6bc8-4af9-9a2e-e1378b05cd00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a40f2f2c9fd59dbfe36df928d7112c66 2x, https://si.imgix.net/074d1bf8/uploads/origins/a57a2e85-6bc8-4af9-9a2e-e1378b05cd00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9164136f2ffe912311f4b844212c70a7 3x"}, "body": "変な文章で失礼します。可能でしたら、ファイティング☆ウィッチの八神千夏さんがプールで水着が取れてしまうシーンを書いていただきたいです。水着に細工されたとかで水着コンテストだとかビーチバレーだとか、大勢に見られてる状況でお願いしたいです。水着が取れた事にしばらく気づかないシチュエーシ