bp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23f00d7a41596fc75ec200a4d3f28412 2x, https://si.imgix.net/9b85daaf/uploads/origins/b3c28075-d26a-419c-8c92-7a88fe54c95e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=50d1e306ff540dd598fd4bc2eeaf4a3d 3x"}, "body": "よろしくお願いします！（笑\n\nこの2人のオリジナルキャラクターを描いていただけませんか？ヴィクトリア朝（1890年代）のTRPG「Call of Cthulhu（CoC）」の設定に登場する2人です。彼らは親友で、家がなく、一緒に路上で暮らしています。カルト教団に所属する怖い子たちです。\n\n茶髪の少年シェイは物静かで、普段は中性的な表情か、小さく謎めいた笑みを浮かべている。アロイスのことをとても大切にしている。\n金髪の少年アロイスは、大胆でおしゃべりな性格。表情はいつも満面の笑みだ。\n\n想定されるシーンとしては、以下のようなものがあります（描きたくなければ描く必要はありません）。\n- 安全な場所に隠れて、盗んだ食料を分け合っている平和なシーン。\n- 雨をしのぐために廃墟に身を寄せた。\n- 怖い廃墟を調査する\n- お好きなシーンをお選びください。\n\nいずれにせよ、私のリクエストを読んでいただき、本当にありがとうございました。\n\nhttps://drive.google.com/drive/folders/1uV4UtcsimuwnNtJvnj3WmLZ-heBRzsN9?usp=share_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamasmi/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 526864, "client_id": 27685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a263ea7/uploads/origins/f12b5e14-3c7d-43d0-8fd8-7dffab5290cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5d9f16444aa42e1f149972c7b16b0ba", "srcset": "https://si.imgix.net/8a263ea7/uploads/origins/f12b5e14-3c7d-43d0-8fd8-7dffab5290cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5d9f16444aa42e1f149972c7b16b0ba, https://si.imgix.net/8a263ea7/uploads/origins/f12b5e14-3c7d-43d0-8fd8-7dffab5290cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd735e88b2c878a6d550c94bb4f9e142 2x, https://si.imgix.net/8a263ea7/uploads/origins/f12b5e14-3c7d-43d0-8fd8-7dffab5290cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fbb5328c718782358299d72544da7877 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a263ea7/uploads/origins/f12b5e14-3c7d-43d0-8fd8-7dffab5290cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a5215adb881d03fcc79b742950f8dd2", "srcset": "https://si.imgix.net/8a263ea7/uploads/origins/f12b5e14-3c7d-43d0-8fd8-7dffab5290cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a5215adb881d03fcc79b742950f8dd2, https://si.imgix.net/8a263ea7/uploads/origins/f12b5e14-3c7d-43d0-8fd8-7dffab5290cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d28d571e2f75713a7939c26ced50ba20 2x, https://si.imgix.net/8a263ea7/uploads/origins/f12b5e14-3c7d-43d0-8fd8-7dffab5290cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3bb99d64d0d31d71d3064a24cc92dd3c 3x"}, "body": "hamasmi様\n\nこんばんは、hamasmi様。\nツイッターからイラストを拝見させて頂いてファンになったものです。\n幻想的な世界の表現がすごく好きになりました…！\nそんなhamasmi様がスケブを開いていらっしゃることを知り、もしよろしければこちらのオリキャラのことを依頼したいです。\n\nお願い申し上げたいのはこちらのオリキャラ狐娘の万里香（まりか）という子です。\n狐耳と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の高校生です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。一人の時や知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘でhamasmi様の絵柄でのイラストをどうかお願いしたいです。\n制服姿で、白黒の夢の世界で現実に戻るところのような赤い鳥居を見つけたところがみたいです。彼女も白黒で、リボンだけ赤く見えるのがみたいです。夢の世界の構成はご自由にお願いします。\nご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamasmi/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 526864, "client_id": 1395765, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46b0ff7f/uploads/origins/c0b73660-26a2-4753-86e5-80776cec33d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=