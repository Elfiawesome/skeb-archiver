=crop&crop=top&w=200&h=200&blur=200&s=9872ea9159b03f03f3efbeb500ff694a, https://si.imgix.net/ca9cee5c/uploads/origins/5de148e1-f8a1-4a2f-8bb7-41954c50a14e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8478ed328ce8fe814433cf9872a51228 2x, https://si.imgix.net/ca9cee5c/uploads/origins/5de148e1-f8a1-4a2f-8bb7-41954c50a14e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0149e6faac082bfdd11f579b6b67db32 3x"}, "body": "いつもお世話になっております！\n\n『救いに非ず』自陣の犬塚海里×緑川薫SSをお願いできると嬉しいです。\nひとまずシナリオネタバレなしでご依頼したいですが、内容的に難しければ弾いていただいて構いません。\n\n具体的なシチュエーションなどはお任せいたしますので、過去に書いていただいたSSを膨らませたものでも\n全く別のネタでも、レンヌさんが書きやすい方向で書いていただければ幸いです。\nわがままを言うなら糖度は気持ち高めだと幸せになります。鬱度はお任せします。\n\nお任せばかりで恐縮ですが、ご検討いただければ幸いです！\n季節の変わり目なのでどうぞご自愛くださいませ！", "nc": 129, "word_count": 5761, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@towo105/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1401421, "client_id": 742506, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80f9535f/uploads/origins/351bf0d5-af49-4242-b1e4-4e4a032784b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee728883ca82e80df6a4dcdfa004acf6", "srcset": "https://si.imgix.net/80f9535f/uploads/origins/351bf0d5-af49-4242-b1e4-4e4a032784b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee728883ca82e80df6a4dcdfa004acf6, https://si.imgix.net/80f9535f/uploads/origins/351bf0d5-af49-4242-b1e4-4e4a032784b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f0904f749a019cd594dc29b3f94242d 2x, https://si.imgix.net/80f9535f/uploads/origins/351bf0d5-af49-4242-b1e4-4e4a032784b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0025c039293d6f9f9e137530fdc472ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "h