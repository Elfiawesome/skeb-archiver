ration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47075eb4/uploads/origins/d95082d2-91a5-457b-863a-fad43b1b065a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b01038c11239d09ec5723dc34a7e8387", "srcset": "https://si.imgix.net/47075eb4/uploads/origins/d95082d2-91a5-457b-863a-fad43b1b065a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b01038c11239d09ec5723dc34a7e8387, https://si.imgix.net/47075eb4/uploads/origins/d95082d2-91a5-457b-863a-fad43b1b065a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=092a9ace9cba259506ea19158a31c08e 2x, https://si.imgix.net/47075eb4/uploads/origins/d95082d2-91a5-457b-863a-fad43b1b065a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d2ff6c35c54053fec25fcc5e51d866e8 3x"}, "body": "初めまして。ツイッチで配信しているもぶこと申します。\nmiko様の描くイラストの表情やポーズや線の太さなど、めちゃくちゃ可愛くて好みです😭ぜひ配信、活動用イラストを描いていただきたく思っております。\n\n◆依頼内容◆\n・オリジナルキャラクターのイラスト\n・衣装はお好みで描いてくださるとうれしいです\n・表情やポーズはおまかせでお願いします。\n\n◆使用用途◆\n・X（旧Twitter）などのSNSでの使用\n・配信での使用\n\n◆納品形式◆\nPSD形式で、キャラクター・背景・エフェクトを分けていただけますと嬉しいです。\n\n◆キャラクターのポイント◆\n・うさ耳、尻尾がついています\n・白、水色が基本カラーとなっております\n・前面からの参考画像しかないので見えない部分は雰囲気で描いていただけるとうれしいです\n\n◆参考フォルダ◆\nhttps://drive.google.com/drive/folders/1l4G736PXOY5l7TyET9ENrmTB7eJjMBry?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@deyodeyo866/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3318959, "client_id": 3809766, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15d0c13a/uploads/origins/847585e5-3e11-4066-a438-7f076632e38e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88a03b5cd626bc550c8a1ca968a814e8", "srcset": "https://si.imgix.net/15d0c13a/uploads/origins/847585e5-3e11-4066-a438-7f076632e38e?bg=%23fff&