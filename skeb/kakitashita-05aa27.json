怒りながらも優しい態度で褒めてくれる。\n\n金額が釣り合わないと思われましたらお手数ですが再送依頼を頂ければと思います。\n\nとにかく下品で無様なワードで画面を埋め尽くして欲しいです。よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kakitashita/works/28", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f0c08f46/uploads/origins/7f6ef8a8-24a1-49ff-b4aa-d45b1cff030d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aabfac62b820096c9940ebc8ebae6308", "srcset": "https://si.imgix.net/f0c08f46/uploads/origins/7f6ef8a8-24a1-49ff-b4aa-d45b1cff030d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aabfac62b820096c9940ebc8ebae6308, https://si.imgix.net/f0c08f46/uploads/origins/7f6ef8a8-24a1-49ff-b4aa-d45b1cff030d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f9204a5ad4c43ba7c04822508a0fe09 2x, https://si.imgix.net/f0c08f46/uploads/origins/7f6ef8a8-24a1-49ff-b4aa-d45b1cff030d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=284cc3b39f87e6da67f2a9883df42a28 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 2562478, "client_id": 320541, "nc": 176}], "sent_works": [], "similar_creators": [{"id": 371337, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Aokura", "screen_name": "asclala", "avatar_url": "https://pbs.twimg.com/profile_images/2036731504454410240/X81i6HmK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1076551186377920512/1774429359/1500x500", "appeal_receivable": false, "popul