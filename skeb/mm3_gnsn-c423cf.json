、お茶を飲んだりと静かな環境を好む。\n(上記リンク先にキャラクターと妖怪の姿の両方を添付しています)\n\n背景\n二人とも現代の人間界に住む古代妖怪で、本当の身分を隠しながら、同時に妖怪の組織で仕事をしています。\n茶髪の方は人間社会で雑誌のモデルをしているが、金髪の方は普段は家に引きこもっている。\n\nポーズのデザインは自由です。よろしくお願いします。\n\nhttps://imgur.com/a/OWCYhHg", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mm3_gnsn/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 900067, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8bdbb6b7/uploads/origins/8bde85cc-57e4-4246-9df2-ddb7f15875f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fed00f69e1760139dd91b6981636baa9", "srcset": "https://si.imgix.net/8bdbb6b7/uploads/origins/8bde85cc-57e4-4246-9df2-ddb7f15875f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fed00f69e1760139dd91b6981636baa9, https://si.imgix.net/8bdbb6b7/uploads/origins/8bde85cc-57e4-4246-9df2-ddb7f15875f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=daecc8bde41ba50c54dd6ade2e96f2c5 2x, https://si.imgix.net/8bdbb6b7/uploads/origins/8bde85cc-57e4-4246-9df2-ddb7f15875f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ea5ebe90844ba4fe86fdde50d89410c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8bdbb6b7/uploads/origins/8bde85cc-57e4-4246-9df2-ddb7f15875f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01bbda893a47fafe600530f5ccd2a9d4", "srcset": "https://si.imgix.net/8bdbb6b7/uploads/origins/8bde85cc-57e4-4246-9df2-ddb7f15875f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01bbda893a47fafe600530f5ccd2a9d4, https://si.imgix.net/8bdbb6b7/uploads/origins/8bde85cc-57e4-4246-9df2-ddb7f15875f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5c810a80a1a2047164bcfa619682978c 2x