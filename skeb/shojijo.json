ient_id": 161974, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shojijo/works/116", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/43ada620/uploads/origins/5bc25fb7-9630-46ec-92f6-740d973aca1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8d464726a159697aed9f99b5d09e4d7d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 46631, "client_id": 990181, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shojijo/works/115", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 46631, "client_id": 731765, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6586625e/uploads/origins/5f0b95f3-54a6-4a32-90d0-74b69a73ce30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6affc6373dd1022c16b41a86ba4b7b23", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6586625e/uploads/origins/5f0b95f3-54a6-4a32-90d0-74b69a73ce30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ad2a97bcebbee8e7438cff3ea00d579", "src_set": ""}, "body": "いつもお世話になっております！この間のリクエストがとても素晴らしかったですのでまたリクエストを送らせて頂きます。\n\n今度は、東方の比那名居天子ではどうでしょうか。彼女はわがままで暴れ好きのイメージとても強いんですが、それでもお嬢様なんだから酷い目に逢うシチュがとても好きです。衣装は資料URLのままで良いんですが、ブーツがすごく好きなのでそれでお願いします！\n\nシチュは、森の中歩いたら異変で迷惑をかけた男に襲われて敗れる。復習はそれで完了のはずだが、男が彼女のスカートを引き裂いて彼女を四つん這いのままで後ろから突き始める。そんな屈辱を耐えられない彼女が目の前の床に落ちた緋想の剣へ手を伸ばそうとするが、それを許さないもう一人の男が彼女の手を捕まえてフェラさせる。そして、彼女は睨みながら串刺しのまま屈辱を何度も耐える事しか出来ない。\n\n他の構図はご自由にどうぞ！\n\nご検討を宜しくお願い致します。\n\nhttps://dic.pixiv.net/a/%E6%AF%94%E9%82%A3%E5%90%8D%E5%B1%85%E5%A4%A9%E5%AD%90", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shojijo/works/114", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 46631, "client_id": 901460, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90522137/uploads/origins/11ece9c9-1c95-48b4-a922-02d75321ebf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca45b4c710ff9abd089cb3e7b0fbc557", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90522137/uploads/origins/11ece9c9-1c95-48b4-a922-02d75321ebf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4b15c5c5339db15f46ae6ffed24ba0c", "src_set": ""}, "body": "以前pixivリクエストにてダイの大冒険のレオナを依頼させていただいた者です。\nもしご迷惑でなければ再依頼させていただきたく思います。\nリクエスト内容は概ね同じで、ダイの大冒険のレオナ(デザインは令和アニメ版)で\n内容はバーンパレスでの最終決戦で真・バーンに正常位でヤラレる所を希望です。\nアングルは[小路綾]の投稿のような見下ろし構図で、\nゴメちゃんが握りつぶされた後のif展開で、バーンが完全勝利に浸る為、今度は瞳を人質にレオナに絶対服従を強要させ無理矢理レ〇プするといった物です\n原作と同じく胸の露出(全開でも良)や\n周囲には飛び散ったゴメちゃんの雫や瞳にされた仲間がいくつか転がっており、バーンの片手には握られた瞳\n流れとして、まず瞳の前で開脚クパァを強要（顔を背けながら両手で開く）\nその後槍見せ、挿入、ピストン、中出し、事後\nといった差分を追加でお願いできれば幸いです。ご検討お願いします", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shojijo/works/113", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 46631, "client_id": 162466, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/001c6d0a/uploads/origins/2ff7e5a4-2e78-479e-aa4d-88c688e88c62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cbe6b13ce2c32853cc94701de315e4f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/001c6d0a/uploads/origins/2ff7e5a4-2e78-479e-aa4d-88c688e88c62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=239ddc8f80deceaef91791da59271435", "src_set": ""}, "body": "お世話になっております。以前ダメだったものを一部修正してリクエストさせて頂きます。\n\nキャラ:大図書館の羊飼い「鈴木佳奈」\n資料URL参照\n\n衣装:私服(URL内、衣装02)\n※他の衣装or全裸でもOKです\n\n体位:正常位+腕を別の男に掴まれている\n\n背景:お任せ(暗い雰囲気ならなんでもOKです)\n\n\n詳細\n・胸を露出している(or服を破られている)\n・口に精液がついている状態\n・パンツが片足に引っ掛かっている\n・涙を流している\n・破瓜(可能ならやりすぎってくらいに)\n\n\n希望の流れ\n痛がっている表情→射精されて驚く→射精後に精液が零れる描写→その後も使われて生気を失った表情(ハイライトや頬染めを消す)\nこの流れをお願いしたいです。\n\n\n以上になります。ご検討ください。\n\nhttps://august-soft.com/daito/character04.html", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shojijo/works/112", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 46631, "client_id": 1830878, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bfd63228/uploads/origins/b32e0dc0-86e0-49ad-8db8-212d81f0ff68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e2f7505f25295dd53340f8404a2ab4b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bfd63228/uploads/origins/b32e0dc0-86e0-49ad-8db8-212d81f0ff68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60adf42d025ed6cce8b1a02ff7929853", "src_set": ""}, "body": "作品：fate/grand order\nキャラクター：レディ・アヴァロン\n【衣装】英霊催装：レディ・アヴァロン\n\n【シチュエーション】\nサポートとして向かった先のマスターに令呪を使われた上に\n彼のサーヴァント達からも色々と魔術を掛けられ、\n抵抗できないままSEXされているシチュ。\n【構図】\n寝室のベッドに腰掛けての背面座位。\nほぼ着衣のまま、胸は服をずり下げられて露出し\nパンツをずらす形で挿入されている形。\n\n可能であれば差分をお願いします。\n①挿入前\n・男の一物を見てその大きさに内心焦ってはいるが表面上は余裕ぶって見せている。\n② 挿入\n・パンツをズラして挿入\n・実際に挿入され、その大きさに焦りを見せるも何とか堪えようとする。\n③ 射精\n・中出しされるとその量と勢いにこらえきれず、\nあえなく絶頂してしまう。\n④ 射精後\n・引き抜かれ、股からたっぷりと精液が垂れながら放心している。\n\nhttps://img.gamewith.jp/article_tools/fatego/gacha/craft_essence_1885.jpg", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shojijo/works/111", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 46631, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f58ad73/uploads/origins/14b3e7f3-fd27-4bc2-92d0-0e39ff217020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d0977ef0ced2f66c1f3a0cfed1f0063", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f58ad73/uploads/origins/14b3e7f3-fd27-4bc2-92d0-0e39ff217020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=901b0b088f018e91e9f8aa31fd171edc", "src_set": ""}, "body": "お世話になります\n可能であれば是非リクエストをお願いします\n\n【キャラ】\n英雄伝説 界の軌跡　ナーディア・レイン\n\n【シチュ】\nシーナムの捜索というサブイベントで\n犯罪組織に攫われ奴隷として売り飛ばされそうになっているNPCキャラのシーナムを救出するイベントがあるのですが\nナーディアが戦闘に敗北したというシチュで3穴を乱暴に犯されるイラストをお願いします\n\n【構図】\n過去に描かれている下記に近い様なイメージ＋片方のツインテールを引っ張られている\nhttps://www.pixiv.net/artworks/108091212\n\n【ナーディア】\n衣服が破れ(お任せ)乳房は露出\n片足だけでもある程度は画面内に納まった構図\n可能であれば表情を含めた差分有で\n挿入前の強気な表情→挿入→射精→事後の虚ろな表情＋\n乳首に噛まれた歯形の跡や顔から太腿付近までを乱暴にむしゃぶられたキスマークの痣や傷有\n\nhttps://imepic.jp/20241014/501090", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shojijo/works/110", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 46631, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b176de6/uploads/origins/ac6147e6-1dc9-48b4-a2f2-10891020e83e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12b08a699a1104a39e75f0dcbea46218", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b176de6/uploads/origins/ac6147e6-1dc9-48b4-a2f2-10891020e83e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4cf66f024eaaad1c9e3a922d50a21bc", "src_set": ""}, "body": "初めまして、作品を見て好みだったのでリクエストさせて頂きました。\n描いて頂きたいキャラ\nアイドルマスター:四条貴音\n服装:婦警の制服\n作中で着ていた制服（下記資料）で描いて頂きたいのですが補足で作中よりリアルめで1日署長の襷は無しでお願いします。\n\nシチュエーションはパトロール中に公園で浮浪者のおじさんに襲われ人目に付かないトイレに連れ込まれ襲われる設定でお願いします。\n\n以下詳細ポイント\n制帽は被ったまま、上着とシャツはボタンを外されるか引き千切られて胸が露出\n体位構図はお任せしますが靴（パンプス）履いたままのシチュが好きなので絵に反映して頂きたいです。\n片足の靴は踵が脱げ掛かっている状態\nあと挿入前～挿入～性交～中出し～事後で差分を何枚かお願いしたいのですが可能な範囲でお願いします。\n\nリクエスト内容は以上となります。\n注文多くなりましたが宜しければご検討お願い致します。\n\nhttps://i.pinimg.com/originals/45/fc/c8/45fcc8d3338b00369e01b3cfb2175a55.jpg", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shojijo/works/109", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 46631, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1064cc7a/uploads/origins/7dbafb4c-f689-4730-ad92-b7d3826444ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e915f42ee2d91ad448b97e82e25daf8f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1064cc7a/uploads/origins/7dbafb4c-f689-4730-ad92-b7d3826444ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4504a1b283bef28fdb1ecfd4261c4eac", "src_set": ""}, "body": "はじめまして。マイナーな作品で可能かどうかわかりませんが、リクエストさせて下さい。\n\nキャラは、「りっく☆じあーす」というゲームの久居真津梨です。\n参考\nhttps://rickg.earth/musume/bg20028/\n参考２\nhttps://www.akibasgate.com/recent/12692/2\n\nシチュは、机の上に側位で、片足上げられて手マン(指３本、手のひらがこちら側)されており、(イクことで)上げられていた足が閉じるものの、手を水平にして足の間に入れられて手マンを継続され、更にイカせ続けられる、というものです。\nもし金額的に可能であれば、時間経過後の放心かつ机がびちょびちょになったものをお願いします。\n\n拘束の有り無しや服装についてはお任せしますが、武器や通信機器は無しでお願いします。\n\n検討のほど、よろしくお願いします。\n\nhttps://rickg.earth/musume/bg20028/", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shojijo/works/108", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3fad00e3/uploads/origins/63872574-1ccc-49d1-84ed-473d26146849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca8887648b972ff84394980b81b4e73b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 46631, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shojijo/works/107", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 46631, "client_id": 731765, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/388403fd/uploads/origins/8b8ea8e8-4ec9-4aab-a7ba-630170ce81ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ebec30858bf1ee02aaf32175c83b3d2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/388403fd/uploads/origins/8b8ea8e8-4ec9-4aab-a7ba-630170ce81ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e281a2aa45d40bd9773bc25b9f0f1aff", "src_set": ""}, "body": "初めまして！\n\n米袋大路さんの作品がとても好きですが、東方Projectの絵がないのはとても残念だと思う為リクエストを送らせて頂きます。\n\nキャラクター\n東方Projectの上白沢慧音\n\n衣装\n競泳水着とパーカー。帽子は描かなくて良いです。水着のデザインは追加したリンクの方の絵みたいな感じで良いと思います。\n\n構図\n学校の教師である上白沢慧音は、放課後のプールで水泳部の男子たち（高校生、服は水泳パンツだけ）に囲まれて輪姦されるシチュです。一人の男子に両腕を押さえたままで他の男子に正常位のずらし挿入で突かれます。他の男子は（人数は米袋大路さん次第です）勃起したままで順番を待ってただみてるが、一人や二人が乳を揉むところを描いて頂けたら幸いです。\n\n差分\n挿入の寸前、挿入、射精の寸前、射精と事後の差分が可能なら是非お願いします。\nその流れで、表情が恐怖から苦痛へ、そして中出しを恐れる表情からレイプ目に変わったら良いと思いますが、無理なら平気です！\n\nシチュエーションの説明\n上白沢慧音は憧れの先生でありながら男子たちにエロい目で見られる事もあります。特に水泳部の男子たちは長い間ずっと手に入れられないエロい先生の水着姿を近いところから見て来た為、ある日、我慢が出来なくなってしまい先生を襲う事にします。\n\nそして、ずっと見られてる事も気付かずに生徒たちをただ大事に思った先生は襲われる瞬間ショックを受け、生徒たちを信じようとして頼み込みますが、生徒たちにとっては先生はもうずっと我慢した分の欲求を満たす為のただの牝です。\nという感じです。それを絵で伝えて頂けたら本当に幸いです！\n\n最後に、透けへそと勃起の乳首で水着のぴっちり感を分かる様に描いて頂けたら良いと思います。\n\n金額が足りない場合遠慮なくご要請ください！\n\nご検討をよろしくお願いいたします！\n\nhttps://www.pixiv.net/artworks/91152435", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shojijo/works/106", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c2001aff/uploads/origins/342363e2-34c6-433f-b10a-9c26dc56e793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc5f39c9ca83967db55c9cab1272fc5b", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 46631, "client_id": 161974, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shojijo/works/105", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 46631, "client_id": 374524, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19b5c552/uploads/origins/1da71cf4-cbcb-48a7-8edf-35350336399b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cfb7364d2f3d982d1ec02969d1437f9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19b5c552/uploads/origins/1da71cf4-cbcb-48a7-8edf-35350336399b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a3ff8364d33533b35420bc206aa76ee", "src_set": ""}, "body": "ガールフレンド(仮)の森園芽依が前回の重藤さんの続きの流れで犯される絵を差分ありで願います。\n服装は冬制服黒タイツローファー。下着は資料内の下着着用で。\n基本構図\n添付資料の体勢を参考に教室の鏡の前で机の上に制服着たままで。表情は怯えつつも従姉を守るために身代わりになると覚悟を決めた感じで。タイツに少し失禁と愛液のシミ有り。\n差分①\n男のモノを顔前に突きつけられ恐怖。そして首を掴まれ机の端を利用して頭を下げられ、口と喉が一直線にされて喉が膨れる激しいイラマチオをされる。胸元もリボンはつけたままボタンを外しブラが露わに。苦しさに瞳孔が開き、泣きながら叫び、失禁し体や制服タイツ(特にスカート)を濡らす。\n差分②\n喉奥に出されるが飲みきれず精液を苦しそうにむせてこぼしてしまう。別の男にあそこをなぞられ、タイツ越しに愛液が糸引くくらいあふれてしまう。\n差分③\nタイツを破いてパンツをずらし、尻の穴に重藤さんを犯したおもちゃをお尻に突きつける。それを見て恐怖顔で許しを請う。しかし懇願を無視し乱暴におもちゃをお尻に挿入して出し入れする。\n激痛と羞恥心で泣き叫んでしまうが、あそこからマン汁が吹き出し、再び勢いよく失禁して吹き出し、おしっこが芽衣の体(特に胸元や顔)を濡らす。\n差分④\nお尻の玩具と同じ形で細身のおもちゃを尿道に挿入すると見せつけられ、胸元のブラをめくりあげられ泣きながら許してと懇願。しかし、懇願虚しく尿道にもおもちゃを入れられ、お尻とともに激しく出し入れされる。乳首も別の男がつまみ、容赦なく責められる。激痛に泣き叫ぶが、体は何度も絶頂を迎えてしまい、マン汁は激しく吹き出て芽依ちゃんの体を濡らす。\n差分⑤\nお尻と尿道のおもちゃを勢いよく抜かれて再度失禁し愛液を撒き散らしながら激しくイッてしまう。汗も含めて制服はびしょびしょになってしまう。\n差分⑥\nお尻に男のモノを挿入させられる。尿道にも再びおもちゃを挿入されて出し入れされる。\n完全に恐怖心に支配されなが顔を歪めらも体が感じてしまう現実に混乱している。\n差分⑦\nさらに一人の男に喉を掴まれながら再びイラマチオも同時にされてしまう。\n差分⑧\n中出しされて絶頂。抜かれ、アナルと口から精液が溢れ出て、尿道も抜かれ、再び失禁して体を濡らしていく。\n鏡には重藤さんが前作の犯された服が乱れて汚れてる姿で、犯された芽衣を見て絶句している\n\nhttps://drive.google.com/file/d/1t7GkwDEy2QwMPSxT-3824fObaA9tnx5h/view?usp=drivesdk", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shojijo/works/104", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 46631, "client_id": 1117661, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7fec2506/uploads/origins/b7d64fda-95f9-4041-9a81-3db0a363d82c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e7bcb6b5e41bbdfe90c9235d82fe15a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7fec2506/uploads/origins/b7d64fda-95f9-4041-9a81-3db0a363d82c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8168055ee7a5986de0fc4b8e25da0844", "src_set": ""}, "body": "以前小路綾ちゃんのイラストをお願いした者ですが、続きでもう一枚お願いしたいです。 \n\n 【シチュエーション】 男達に襲われた彼女がトイレの個室に連れ込まれ、再び強姦される。 洋式便器に正面向きで座らされ股を開かさせられて、便器の蓋に背中を押し付けられながら犯されていく。\n\n  【服装設定や描写の仕方】 基本的に前回と同様でお願いします。 構図は正面からのカットが良いです。 恐らく犯している男は綾ちゃんに全面的に被ってしまうと思われますので、被らないように竿や手先だけ描いてください。\n\n  【差分など】 犯される前や行為の最中や射精時の他、中出し事後差分が欲しいです。 犯された後放心状態で股間から精液を垂らしている差分をお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shojijo/works/103", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 46631, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed1b6d99/uploads/origins/237faf56-04f0-40de-a0ad-fa02c959a08d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=013e874494dac3f364b332f261da87f5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed1b6d99/uploads/origins/237faf56-04f0-40de-a0ad-fa02c959a08d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9454965ea8a7c3da8c675d4f2e4adc43", "src_set": ""}, "body": "リクエスト失礼致します。\n白猫プロジェクトのキャラ（エレノア）\nシチュエーション:敵に捕まったアイリスを助けるため、戦ったが敗北。\nすでに、犯されて意識のないアリイスを目の前に絶望しながら、孕まされるまで犯される。\n服装：初期衣装（鎧ヒビ割れ、ボロボロ）\nで、ご検討をお願い致します。\n\nhttps://colopl.co.jp/store/goods/shironekoproject/dakimakura/ciela_eleanor/", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shojijo/works/102", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a70f3203/uploads/origins/7fb97b15-472a-4b4e-9486-954fd94c6cc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62d72880558da9ec99a208125f17ffdc", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 46631, "client_id": 1938036, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shojijo/works/101", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 46631, "client_id": 280844, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2083de21/uploads/origins/c73224ef-cf3b-4215-b48a-e1410a55b09b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd20db70b5fa32b71a3659d19eac313a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2083de21/uploads/origins/c73224ef-cf3b-4215-b48a-e1410a55b09b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ea2b67c2717c985bb154f94a32d107b", "src_set": ""}, "body": "初めまして。\n10年近く前から先生の魅力的なイラストに惹かれていました。\n\nskebを開設されて以来、きっといつか誰かがリクエストしていただけると思い、ずっと待っておりましたが、見立てが甘くついぞ来ない（抱き枕はありましたが）ので、僭越ながら私がリクエストをさせていただきます。\n\nキャラは逮捕しちゃうぞの小早川美幸。\n恐らく先生も思い入れのあるキャラだと思いますが、徹底的に辱めてあげて下さい。（レイプ）\n\n本来は服装とか、表情とか構図とかは、詳細に記載すべきですが、美幸については、先生が一番お詳しいと思いますので、下記お願い（3️⃣を除き、念の為の記載になるかと思います）を除いて全てお任せいたします。先生が考える最高の形で犯してください。\n（過去に先生にご迷惑をおかけした人がいたかと記憶しておりますが、その方みたいに後から◯◯がイメージと違ったなど絶対に言いません。）\n\n⭐️お願い\n1️⃣人間によるセックスであること。（美幸のま◯こに、人間の男性の肉棒が挿入される）\n（先生の考える最高の犯し方が、道具責め等だった場合でも、申し訳ありませんが、こちらでお願いします。）\n2️⃣流血とかキズ、アザなどの性的以外の暴力表現、陰毛はなしでお願いします。レイプとかでよくある性的、辱めと考えられる表現は（頭や腕などを押さえつける、犯されているところを動画や写真に撮られる、輪姦される、複数穴へ挿入されているなど）大丈夫です。\n3️⃣個人的な嗜好として、えっちな汁が多めだと嬉しいです。直接的に言えば、美幸のまん汁がぐっちょり溢れて滴り落ちている感じです。\n\n以上　私の独りよがりだったら、無視してください。可能であれば、受けていただけることを願います。\n\nよろしくお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shojijo/works/100", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 46631, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e29b7f8/uploads/origins/33e25021-676d-4f6a-bce0-0c7c50e9f65e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c632aa3b1686e512a3ee27f0d9d7489", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e29b7f8/uploads/origins/33e25021-676d-4f6a-bce0-0c7c50e9f65e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2d8857ded05d9995ecb21b6cd4310a0", "src_set": ""}, "body": "こんにちは、髪に赤いハイライトを入れた、このすばのダークネスの美しい構図をお願いしたいです。また、冬の森を背景に、騎士のヘルメットをかぶってほしいです。彼女のキャラクターデザインから提供された、参考にしたアイテムや武器をすべて適用することを忘れないでください。可能であれば、ペットの鷹のイラストもお願いします。ポーズは自由です。\n\nこの挑戦的な依頼を引き受けてくれることを願っている。\n\nhttps://drive.google.com/drive/folders/1aBYvtwLsGt469mglpA9q5xDqCYQLDl_R", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shojijo/works/99", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/921acc06/uploads/origins/104d82c0-154d-4bad-aaf8-5e058887a607?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8755425596f8f1f862e51dfd4777869", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 46631, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shojijo/works/98", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 46631, "client_id": 1745105, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ce62463/uploads/origins/3c4c5568-3fd6-4529-bd96-3520ebfcf1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=183f9545f32b67596fffa9d75a067488", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ce62463/uploads/origins/3c4c5568-3fd6-4529-bd96-3520ebfcf1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85f9bb6b65cc86c402585f009d53c9ec", "src_set": ""}, "body": "はじめまして。\n以前依頼しましたが、もっと見たいキャラが出来ましたので、\nキャラを変更してリクエスト失礼いたします。\n\nキャラクター：一之瀬帆波（ようこそ実力至上主義の教室へ）\n原作やアニメなどで若干デザインが異なりますが、アニメデザインを基準にして頂けると幸いです（資料はURLを参照）。\n\n【シチュエーション】\nクラスを救うための交換条件として付き合うことになった南雲（先輩）に命令されて断れずにSEX。\n後背位という体位の都合上、ベッドの上を想定しておりますが、違和感なければどこでも結構です。\n\n【体位（後背位）】\n・四つん這いになった一ノ瀬のお尻か少しお尻より上の腰を掴んでバックで突く\n・突かれている一ノ瀬の表情が見え、後ろの竿役が見えるように斜め前からのアングル\n（https://www.pixiv.net/artworks/101773151）のような\n・竿役は他作品と同様に目線など表情はなくて結構です。\n\n【服装】\n・上下ともに制服\n・上着とシャツははだけてブラが見えている状態\n・スカートは脱がさずに背中側にめくれ上がった状態（パンツ、お尻が見える状態）\n・下着は資料を参照（Tバックではなくお尻全部を包むようなフルバック）\n\n【差分希望】\n可能であれば差分をお願いします。\n① 挿入前（基本）\n・パンツを脱がす前の状態\n・表情は挿入されることへの不安な表情\n② 挿入\n・パンツを少しズラして挿入\n・感じて喘いでるような表情\n③ 射精\n・パンツは（https://www.pixiv.net/artworks/115590401）のように片足に引っかけるまで脱がした状態\n・表情は（https://www.pixiv.net/artworks/97967464）の2枚目のようなに絶頂したような表情\n④ 射精後\n・股から精液が垂れている\n・表情は目が虚ろで少し涙目\n\nhttps://drive.google.com/drive/folders/1s0OLafhO0tdRksBwXkPUfPrgpc8UqbFp?usp=sharing", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shojijo/works/97", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 46631, "client_id": 565938, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95f12673/uploads/origins/e04f5e80-26fe-45f5-85d0-1e3fe47bd88e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1518e5c3410b7ead06a65f247de86223", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95f12673/uploads/origins/e04f5e80-26fe-45f5-85d0-1e3fe47bd88e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b5cf7f5a79b0f71b6da94de2dd5c102", "src_set": ""}, "body": "いつも素晴らしいイラストを楽しませて頂いております。\nどうかよろしくお願いします。\n\n●登場人物\n白猫プロジェクト　アイリス(鎖剣)\n竿役　ゲスい冒険者　1人　\n冒険者の仲間達複数\n\n●体位　\nM字騎乗位（仰け反りNG）　\n\n●場所　\nホテルのベット\n\n●シチュ\nゲスい冒険者達が優しい冒険者のフリをしてアイリスに近づき、強力な洗脳魔法を使いアイリスをホテルに連れ込み中出しSEXする。\n\n●差分\n挿入前、挿入後、ピストン、中出し、射精後などの差分をお願いします。\nアイリスの表情はSEXが楽しく気持ち良く幸せそうな感じで。\n\n●ポイント\n・冒険者（竿役）からの一人称視点\n・アイリスは衣服は着ていて、胸は見えている状態\n・アイリスは洗脳の効果でSEX大好きな状態になり、自分から激しく腰を振っている\n・冒険者の仲間達は後ろ側で自分達の番が来るのを楽しみに待っている\n・冒険者の仲間達の1人は洗脳魔法の力を持つルーン（宝石）を持っている\n\n綺麗なものを汚すような感じで。\nどうかよろしくお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shojijo/works/96", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 46631, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ddf76ec/uploads/origins/a1047fe3-c6df-4441-bf93-7f530697224d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8366f93a31ad669718be5da1b7875885", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ddf76ec/uploads/origins/a1047fe3-c6df-4441-bf93-7f530697224d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8e12a257a2ef76711f0274b51bc03eb", "src_set": ""}, "body": "いつもFanboxで素敵なイラストを楽しく拝見しています。以下のお願いをさせていただきます。お受け頂ければ幸いです。\n\n内容はFanboxでの水無灯里さんの作品と同じようなもので構いません。 \n\nキャラクター: アリサ・ミハイロヴナ・九条\nシリーズ： 時々ボソッとロシア語でデレる隣のアーリャさん\nコスチューム: 参考にしたアイドルの衣装\n\nシチュエーションはFanboxの水無灯里作品と同じだが、次のような違いがある。以前アリサに拒絶された男が、彼女をレイプしようと決意する。アリサはショーツに穴が開いている以外は服を着ており、男はそれを裂き、ショーツからパンツを引き抜こうとする。アリサはパンツが脱がされるのを防ごうとしたが、男たちはなんとかパンツを脱がそうとした。その日は危険な日で、アリサは処女喪失と妊娠を恐れ、泣きながらおしっこをしてショーツを濡らしてしまった。男たちは彼女の処女を奪い、アリサの中に精液を出した。アリサは涙目で、破れたコスチュームと精液で汚れた下着の横に横たわった。先端におしっこが少しついた妊娠検査キットもあり、陽性反応が出た。\n\nもし料金が十分でなかったり、内容が不快であれば、再送をリクエストしてください。ありがとうございました。\n\nhttps://static.wikia.nocookie.net/roshidere/images/4/41/Roshidere_volume_6_cover.jpg/revision/latest?cb=20230223183807", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 147972, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "チサト", "screen_name": "tesimene", "avatar_url": "https://pbs.twimg.com/profile_images/155406291155054