4664907b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1f5cec3cec90b2119d0147d1f3428af", "srcset": "https://si.imgix.net/f6448bc2/uploads/origins/065dcf02-1f19-4303-89af-1fc4664907b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1f5cec3cec90b2119d0147d1f3428af, https://si.imgix.net/f6448bc2/uploads/origins/065dcf02-1f19-4303-89af-1fc4664907b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eb188c80c436fcac892274394de0c998 2x, https://si.imgix.net/f6448bc2/uploads/origins/065dcf02-1f19-4303-89af-1fc4664907b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45e2329d4ca88058e7223a45c7bd767b 3x"}, "body": "こんにちは！むむたさんの暖かくて柔らかいタッチのかわいい絵が大好きなので、\nぜひ貴方様の描く自創作カップルが見たくてこの度リクエストさせていただきました。\n\n【描いてほしいキャラクター】\n後苺（うしろいちご）ちゃん\n・褐色肌ピンクのハーフツインテール髪\n・お嬢様\n・ロリィタ（風）の衣装\n\n千代田しょこら（ちよだしょこら）ちゃん\n・ピンクっぽい白肌チョコ色のロングヘア\n・ボーイッシュ及び王子様ルック\n\n詳細は資料URL（立ち絵）からご確認ください！\n\n【内容】\n衣装や構図はおまかせします。\n2人を1枚に描いても、\n単体で1人ずつ2枚描いてくださってもかまいません。\nわかりにくいところ等お好きなように描きやすいように描いていただけたら嬉しいです。\n\n【使用用途】\n・個人観賞用の印刷（ネットプリント）\n・SNSアイコンに使用\n・個人用のグッズ制作　\n\n【納品方法】\nできたらでいいので、人だけの透過ファイルがほしいです。\n\n【その他】\nskebでリクエストを送信するのは初めてなので不手際があったら本当にすみません。\nお忙しいとは思いますが何卒よろしくおねがいします。\n\nhttps://drive.google.com/drive/folders/16hpaEzGLlpIVSxZf4dBk0ik04wu5izHG?usp=sharing\n\nhttps://x.com/mzwawawao/status/1992562906794459136?s=20\n\nhttps://drive.google.com/drive/mobile/folders/16hpaEzGLlpIVSxZf4dBk0ik04wu5izHG?usp=drive_link", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mumuta1211/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3772576, "client_id": 2755240, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/595d0b29/uploads/origins/3467f3c5-b2fc-4e3a-a368-6ae631889ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14e3c29e