際行動的で好戦的\n\n【納品形式】\n可能でしたら背景やサインを含まない透過png及びPSDデータを\nいただけると嬉しいです。\n(サムネイルなどでも使用予定のため上と左右が見切れない形を希望します。)\n\nお忙しい中大変恐縮ですが、ご検討いただければ幸いです！\n\n【参考資料】\nhttps://drive.google.com/file/d/1RmgUNnLLQxDBMxTNgybkpEGl1Vd-YteF/view?usp=drive_link\n\n憂井\n\nhttps://drive.google.com/file/d/1RmgUNnLLQxDBMxTNgybkpEGl1Vd-YteF/view?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kaie_5214/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3512587, "client_id": 3258692, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e560422e/uploads/origins/a7f93c01-1b05-4cd0-a6c0-75fc96b687c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44a0adf03027ea4580a2874f30e5c1c7", "srcset": "https://si.imgix.net/e560422e/uploads/origins/a7f93c01-1b05-4cd0-a6c0-75fc96b687c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44a0adf03027ea4580a2874f30e5c1c7, https://si.imgix.net/e560422e/uploads/origins/a7f93c01-1b05-4cd0-a6c0-75fc96b687c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=779b351f4958d205090f2827e2d63280 2x, https://si.imgix.net/e560422e/uploads/origins/a7f93c01-1b05-4cd0-a6c0-75fc96b687c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2caa24ae4e4d01f6e628a29086640d3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e560422e/uploads/origins/a7f93c01-1b05-4cd0-a6c0-75fc96b687c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46891cc3e3741e7105d3486906328b70", "srcset": "https://si.imgix.net/e560422e/uploads/origins/a7f93c01-1b05-4cd0-a6c0-75fc96b687c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46891cc3e3741e7105d3486906328b70, https://si.imgix.net/e560422e/uploads/origins/a7f93c01-1b05-4cd0-a6c0