bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a38c123534292ca2df89fadb8162f1b5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04cf054b/uploads/origins/07b96084-165c-4e78-a8bf-588c5da294fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8060f99402aeaa0973382c5ba98ae54d", "srcset": "https://si.imgix.net/04cf054b/uploads/origins/07b96084-165c-4e78-a8bf-588c5da294fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8060f99402aeaa0973382c5ba98ae54d, https://si.imgix.net/04cf054b/uploads/origins/07b96084-165c-4e78-a8bf-588c5da294fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fdea8069c3e847162e9d6e82cc3e5977 2x, https://si.imgix.net/04cf054b/uploads/origins/07b96084-165c-4e78-a8bf-588c5da294fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2c72f1cc6fb03de24b88e0f9c72d927d 3x"}, "body": "依頼お願いします。\nペルソナ5の芳澤かすみの後背位えっちイラストをお願いします。\nかすみは制服（https://game.watch.impress.co.jp/img/gmw/docs/1188/717/html/at_02_o.jpg.html）のスカートとタイツだけを身に着けており髪型は（https://x.com/kurota_0524/status/1227452125338374145/photo/1）で眼鏡を着けている。カップリングは作品主人公とのものでお願いします！\n内容は「それでは先輩、今日はよろしくお願いします！」「相変わらずすごいです先輩の男性器……♡」「お腹まで届きそうです……♡」女の子座りで胸元にある男性器を根本とカリ首を指輪っかで持っている。「すいませんお待たせして……！それでは早速ご奉仕させて頂きますね！」背面座位でお腹がボコっとするくらいの勢いで犯される。男性器が大きすぎてお腹を起点にわずかに腰が浮いている。「赤ちゃんの部屋届いてるっ」「先輩チンコ長すぎっ」「長チン好きっ」オホ声でアヘりながら射精され絶頂する。\nよろしくお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@akui/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3207867, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e7e01ae/uploads/origins/fffbe3fb-8cc0-49f8-ab91-a6c074e34c92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d6a51c4ee55fa025e1745a96203b1bc", "srcset": "https://si.imgix.net/6e7e01ae/uploads/origins/fffbe3fb-8cc0-49f8-ab91-a6c074e34c92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d6a51c4ee55fa025e1745a96203b1bc, https://si.imgix.net/6e7e01ae/uploads/origins/fffbe3fb-8cc0-49f8-ab91-a6c074e34c92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4352283234186c2bc2138b8e3533f2d1 2x, https://si.imgix.net/6e7e01ae/uploads/origins/fffbe3fb-8cc0-49f8-ab91-a6c074e34c92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d094bb3b1983e4138e5c37f4093c6db 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e7e01ae/uploads/origins/fffbe3fb-8cc0-49f8-ab91-a6c074e34c92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d6807516b5dbef0cf53a35b16a55b11", "srcset": "https://si.imgix.net/6e7e01ae/uploads/origins/fffbe3fb-8cc0-49f8-ab91-a6c074e34c92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d6807516b5dbef0cf53a35b16a55b11, https://si.imgix.net/6e7e01ae/uploads/origins/fffbe3fb-8cc0-49f8-ab91-a6c074e34c92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=44c2b68a26f7cb1e2ea809701119a563 2x, https://si.imgix.net/6e7e01ae/uploads/origins/fffbe3fb-8cc0-49f8-ab91-a6c074e34c92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d88e5c793fc5f90ef11cf91d1ae4bf62 3x"}, "body": "リクエストをさせて頂きます。\nプリンセスコネクトRe:Diveのリンド・ヴルムと騎士くんのイチャラブえっちをお願いしたいです。\n\nリンドは普段真面目でお堅いですが、チョロくて最後は何でも許してしまいます。\nヴルムは不真面目で気だるげですが、性行為には積極的で文句を言いつつも奉仕をしてくれます。\n\n描いてほしい流れ\n主であるライラエルの為、騎士くんを手籠めにしようと夕食に媚薬を盛るヴルム。\n夜、媚薬でギンギンになり眠れない騎士くんの元に姉妹２人で夜這い。想像以上の巨根に興奮しつつもW手コキしながら先っぽにキス。その後我慢できなくなって騎士くんに襲われます。\nまずリンドが正常位で犯されます。最初は「れーぷですよっ♥」と止めようとするもヴルムの実況（「騎士さんのバッキバキのデカチンこんなとこまで入っちゃってますよ～♥」のような）を聞き興奮。最後はとろとろになって騎士さんにキスと中出しを要求します。\n次にヴルムは腕引きバックで犯されます。最初は余裕をもって受け入れようとするも「こんなのズルい♥」とだんだん余裕をなくし、オホ声を上げイキます。\nオチはまだまだ収まらない騎士くんに更に犯される様子で。\n\n以上となります、引き受けてくだされば嬉しいです。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@akui/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7803c9e5/uploads/origins/7e7ded6a-1bb5-4b3f-871c-7c112dd35d76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a24defa74b3ab048c31a6495ddcd860", "srcset": "https://si.imgix.net/7803c9e5/uploads/origins/7e7ded6a-1bb5-4b3f-871c-7c112dd35d76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a24defa74b3ab048c31a6495ddcd860, https://si.imgix.net/7803c9e5/uploads/origins/7e7ded6a-1bb5-4b3f-871c-7c112dd35d76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=106819fe70f0ad8e92a45447be8ec87a 2x, https://si.imgix.net/7803c9e5/uploads/origins/7e7ded6a-1bb5-4b3f-871c-7c112dd35d76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac9840391160e500d9ca82699ee1d33a 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3207867, "nc": 32}, {"path": "/@akui/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3207867, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f934d051/uploads/origins/466080b7-bd14-4133-995d-1d6435af4411?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=257ae88181ba26cf06176b6779cd2978", "srcset": "https://si.imgix.net/f934d051/uploads/origins/466080b7-bd14-4133-995d-1d6435af4411?bg=%23fff&auto=format%2Ccompr