.net/3804a9b4/uploads/origins/757f06cf-4716-409e-a893-8240ca71ee8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7c45449c9f329000bce582ba719f21c7 3x"}, "body": "こんにちは。\nアマニータを描いてほしいというオファー、お受けしますよ。プールの中や水中で、でっかいオールフィッシュのぬいぐるみの上で休んでいる彼女を描くのはどうだろう。\n普段の人間の服を着せるか、水着を着せるか、はたまた新しい服を着せるかは自由です。\n今回もありがとうございました。\n\nhttps://drive.google.com/drive/folders/1JjLQtVBsALmzxlAGCMliG-OxGNO_PUhU?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@w11cook/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2852289, "client_id": 1836732, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c12ebbb/uploads/origins/45ebcf78-0bff-461c-8f45-ad6c053c50e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f662ab851f0710ce0b8b2d088e8f57b4", "srcset": "https://si.imgix.net/1c12ebbb/uploads/origins/45ebcf78-0bff-461c-8f45-ad6c053c50e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f662ab851f0710ce0b8b2d088e8f57b4, https://si.imgix.net/1c12ebbb/uploads/origins/45ebcf78-0bff-461c-8f45-ad6c053c50e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba8d0656938dca5ec330500b12a7d786 2x, https://si.imgix.net/1c12ebbb/uploads/origins/45ebcf78-0bff-461c-8f45-ad6c053c50e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6ac3e906b55cc308beb6e68cdb75cdd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c12ebbb/uploads/origins/45ebcf78-0bff-461c-8f45-ad6c053c50e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1023fc6503e62c44d1c66db3e4e4578", "srcset": "https://si.imgix.net/1c12ebbb/uploads/origins/45ebcf78-0bff-461c-8f45-ad6c053c50e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1023fc6503e62c44d1c66db3e4e4578, https://si.imgix.net/1c12ebbb/uploads/origins/45ebcf78-0bff-461c-8f45-ad6c053c50e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=01e97c3204d3451a40f1657ac529618c 2x, https://si.imgix.net/1c12ebbb/uploads/origins/45ebcf78-0bff-461c-8f45-ad6c053c50e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=541d04aa5c60d2ffd2dbf391133d5be8 3x"}, "body": "こんにちは！\n\n私のOC、ライファを描いていただけませんか？彼女は2本の角が生えた宇宙のおバカなエイリアンです。彼女の青い肌に注目してください。\n\n彼女はベルトとポーチのついたジャンプスーツを着ています。ベルトとポーチはオプションです。\n\n顔には月のタトゥーと星のタトゥーがある。\n\n前髪の片側はクリップで留められ、オレンジと黄色のヘアクリップがついている。\n\n彼女はとても小さく（148cm）、胸は小さい（しかし平らではない）。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/172gBmuZsBbpWaOGeDl_SDDyIcNkF3lPE?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@w11cook/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2852289, "client_id": 543344, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e2a0d576/uploads/origins/437fe451-b22a-43cc-9315-2e569f20eb73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dc2e820c00129b903738ccfba9d0edf", "srcset": "https://si.imgix.net/e2a0d576/uploads/origins/437fe451-b22a-43cc-9315-2e569f20eb73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dc2e820c00129b903738ccfba9d0edf, https://si.imgix.net/e2a0d576/uploads/origins/437fe451-b22a-43cc-9315-2e569f20eb73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0f12564919ce973a191728e79c44469 2x, https://si.imgix.net/e2a0d576/uploads/origins/437fe451-b22a-43cc-9315-2e569f20eb73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe158717726734a4b670cc202ea22e88 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgi