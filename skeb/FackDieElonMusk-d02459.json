c/uploads/origins/b7ac35a8-5dbf-49c3-aa52-f77debcd1a58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73b60a2f30a778fc4150f81ced877772 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5f832afc/uploads/origins/b7ac35a8-5dbf-49c3-aa52-f77debcd1a58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1e48af57055d8b35ea9e31d9ee65582", "srcset": "https://si.imgix.net/5f832afc/uploads/origins/b7ac35a8-5dbf-49c3-aa52-f77debcd1a58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1e48af57055d8b35ea9e31d9ee65582, https://si.imgix.net/5f832afc/uploads/origins/b7ac35a8-5dbf-49c3-aa52-f77debcd1a58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=17052cc0156cb914c5c106363b45cd9e 2x, https://si.imgix.net/5f832afc/uploads/origins/b7ac35a8-5dbf-49c3-aa52-f77debcd1a58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1fa181fcea224061019607724ee603fa 3x"}, "body": "アニメ「逮捕しちゃうぞ」の辻本夏実VS小早川美幸のボクシング対決を描いていただけると嬉しいです。\n\n辻本夏美の渾身のアッパーで小早川美幸がKOされる場面で、\n小早川美幸は両腕をだらしなく垂らし、仰け反りながら口からはマウスピースが顔を覗かせ、\n粘り気のある涎が放物線を描き、リングから足が浮くくらいのダメージが理想的です。\n\n衣装について\n【辻本夏美】上がダークオリーブのソリッド クロップトップで下は迷彩柄のカーゴパンツ風。ボクシンググローブとリングシューズは黒。\n【小早川美幸】上が白のスポブラで、下が婦警制服風の紺色のトレーニングショーツに黒タイツ。ボクシンググローブは白リングシューズは黒。\n\nよろしくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FackDieElonMusk/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 52757, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5fcefb04/uploads/origins/e4095588-d60e-4e8d-9fc9-abb71041fbd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b42c9ba3d2ad848f846b322205014bfb", "srcset": "https://si.imgix.net/5fcefb04/uploads/origins/e4095588-d60e-4e8d-9fc9-abb71041fbd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b42c9ba3d2ad848f846b322205014bfb, https://si.imgix.net/5fcefb04/uploads/origins/e4095588-d60e-4e8d-9fc9-abb71041fbd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c2b11d2390ecc1a3a23c698ac94f3e9 2x, https://si.imgix.net/5fcefb04/uploads/origins/e4095588-d60e-4e8d-9fc9-abb71041fbd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e43d50c6157beb1712a092a58b695be0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5fcefb04/uploads/origins/e4095588-d60e-4e8d-9fc9-abb71041fbd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f10b725cec57c36fb3ce09c80a9328d7", "srcset": "https://si.imgix.net/5fcefb04/uploads/origins/e4095588-d60e-4e8d-9fc9-abb71041fbd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f10b725cec57c36fb3ce09c80a9328d7, https://si.imgix.net/5fcefb04/uploads/origins/e4095588-d60e-4e8d-9fc9-abb71041fbd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b737135498ff0ff03807be7864c1460 2x, https://si.imgix.net/5fcefb04/uploads/origins/e4095588-d60e-4e8d-9fc9-abb71041fbd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=97fedb8d2436c33feb0f3f2dbb63af4e 3x"}, "body": "「エヴァンゲリオン」のライバル対決でボクシングをテーマとしたイラスト作成をリクエストさせていただきます。\n可能な範囲で構いませんのでどうぞよろしくお願いいたします。\n詳細は下記のとおりです。\n\n【イラスト詳細】\n\n（１）登場キャラ・衣装\n・アスカ　赤色プラグスーツ風のタートルネックスポブラとスパッツ　赤色のボクシンググローブ\n・レイ　　白色プラグスーツ風のタートルネックスポブラとスパッツ　青色のボクシンググローブ\n\n（２）お願いしたい描写および設定\n・ネルフの施設内のリング上でアスカとレイが対人格闘術の訓練中。\n・余裕の表情で油断しているアスカを着実にダメージを与え、コーナーへと追い詰めるレイのボディーブローが炸裂する場面。\n・コーナーに追い詰められたアスカのお腹にレイのグローブが半分以上めり込んでいる。\n・アスカの表情は意識を飛ばされて朦朧としているイメージで、口から涎を絡ませたマウスピースが零れ落ちそうになっている。\n\n以上になります。\nどうぞよろしくお願いいたします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path"