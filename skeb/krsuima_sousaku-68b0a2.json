でお気に入りなのと、くうすいま先生の青系統の色遣いがとても好きなので、是非ともくうすいま先生のイラストで見られれば嬉しいです。\n\n上記のスキンであることと以外は全てお任せさせて頂ければと思いますが、デザインがとても好きなので全身が見えるようになっていると嬉しいです。\n\n参考資料として、画像とゲーム内での動画を載せているサイトのURLを添付させて頂きます。\n\nhttps://lol-skin.weblog.vc/ja-JP/39/45/\n\n良ければお受け頂けましたら嬉しいです。\nご一考よろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@krsuima_sousaku/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1964095, "client_id": 1816564, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db41bc1a/uploads/origins/24e9949a-b7b4-456d-b24d-08911fe3f329?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf0401b1f2bb1284d74410590c23dc77", "srcset": "https://si.imgix.net/db41bc1a/uploads/origins/24e9949a-b7b4-456d-b24d-08911fe3f329?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf0401b1f2bb1284d74410590c23dc77, https://si.imgix.net/db41bc1a/uploads/origins/24e9949a-b7b4-456d-b24d-08911fe3f329?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9ecb9631fc419baab1686d07083568b 2x, https://si.imgix.net/db41bc1a/uploads/origins/24e9949a-b7b4-456d-b24d-08911fe3f329?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9886cdec20dbc88078dba1c6a141938 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db41bc1a/uploads/origins/24e9949a-b7b4-456d-b24d-08911fe3f329?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5f15b15de4df5765cab9128683f2306", "srcset": "https://si.imgix.net/db41bc1a/uploads/origins/24e9949a-b7b4-456d-b24d-08911fe3f329?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5f15b15de4df5765cab9128683f2306, https://si.imgix.net/db41bc1a/uploads/origins/24e9949a-b7b4-456d-b24d-08911fe3f329?bg=%23fff&auto=format%2Ccompress&fm=webp&dp