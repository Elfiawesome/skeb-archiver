t=crop&crop=top&w=200&h=200&blur=200&s=bc086974f64063870b85c136c8cea698", "src_set": ""}, "body": "初めまして、色気のある大人のお姉さんキャラのイラストが素敵でしたので、リクエストさせていただきます。\n\n・キャラクター\nアシュリー・レヴェック\n\nhttps://seesaawiki.jp/ageha_commission/d/%a5%a2%a5%b7%a5%e5%a5%ea%a1%bc%a1%a6%a5%ec%a5%f4%a5%a7%a5%c3%a5%af\n\nキャライメージは元々は男性であったが宝の呪いによって女性化した海賊団の悪役系女船長。\n露出の多いセクシーな海賊姫の様な装束を身に纏い、精神性は女性と化しているが元男性であった為、男性目線からのこう言う女性の仕草に弱い、と言う仕草を自ら率先して行うあざとさ。\n胸の谷間にホクロがあり、右目下にはカモメのマークのフェイスペイントがあります。\n\n服装は以下のイラストのものでお願いします。\n\nhttps://image02.seesaawiki.jp/a/n/ageha_commission/h9Uohp6z0u.png\n\n・シチュエーション\n自身の右手を胸の上に乗せ、相手の男（悪徳領主）を色気で籠絡しようとしているシチュエーション。\n表情は妖艶な笑みを浮かべて以下のイメージセリフを述べているイメージ。\n「ねえ、領主さま？　私様達を見逃してくだされば良い思い、させてあげられますよ？」\n細かな構図等は描きやすい形でお任せします。\n\n・その他\nその他不明点、不自然な点は自由にアレンジしていただいて構いません。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Tomo_Eokaiteru/works/42", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/938a9c8b/uploads/origins/d2192b86-a7d4-44aa-854a-9c3103915018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9dbf7d9a41392201310874e2cd49956d", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2499846, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Tomo_Eokaiteru/works/41", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2499846, "client_id": 31032, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8170e06/uploads/origins/70add530-dd9d-47f6-b979-9bd49495eb10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8202aad38cfa454f603c83326d3714e", "src_set": ""}, "duration": null, "nsfw"