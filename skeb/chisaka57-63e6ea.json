に変化するつららのような角は、銀の鎖と涙のアメジストでできた霧氷のように生えている。\n-角と同じ細長い黒い尾。\n-身長約170センチ、カーヴィーな体型。\n-大鎌を使う\n-本とロウソクを入れたかばんを持ち歩く。\n-氷、エネルギー操作、占いの呪文を使う。\n-サーミの氷原出身\n-薄紫の蔓で飾られた褐色がかった白の裾の布のドレスの上に、濃い灰色の毛皮のマントを着ている。ドレスの上には胸を支える濃い紫のビスチェ。脚を覆うのは毛皮のマントと同じ毛皮で裏打ちされたグレーのニット製モモハイ。ダークカラーのレザーブーツを膝まで履いている。時折、魔女に似たスタイルのつばの大きな帽子をかぶる。\nポーズや表情は自由\n\nhttps://drive.google.com/drive/u/1/folders/1wEDvMCWFoDj8xPIW8XpYihSuRn51gotX", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@chisaka57/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3556402, "client_id": 1646004, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0df3fdc3/uploads/origins/b9dea2e2-cda5-4798-a220-9ff5f13afe9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d3c6ba59f8b6ee7eee265edcacc931b", "srcset": "https://si.imgix.net/0df3fdc3/uploads/origins/b9dea2e2-cda5-4798-a220-9ff5f13afe9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d3c6ba59f8b6ee7eee265edcacc931b, https://si.imgix.net/0df3fdc3/uploads/origins/b9dea2e2-cda5-4798-a220-9ff5f13afe9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=565e1fa44ccc2821851c582e73b2fb85 2x, https://si.imgix.net/0df3fdc3/uploads/origins/b9dea2e2-cda5-4798-a220-9ff5f13afe9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49ebcee02e1f69cbf821fad1e72b7f03 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0df3fdc3/uploads/origins/b9dea2e2-cda5-4798-a220-9ff5f13afe9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fac04b06e857d845fdab7fbd439de7e", "srcset": "https://si.imgix.net/0df3fdc3/uploads/origins/b9dea2e2-cda5-4798-a220-9ff5f13afe9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fac04b06e857d845fdab7fbd439de7e, https: