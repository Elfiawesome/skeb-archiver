000541a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05f2dcb62278cc07f585334690dabd08", "src_set": ""}, "body": "はじめまして！いつも可愛くエッチなイラストを楽しみにしております！依頼は初になります！\n贅沢な内容ですが可能でしたらお願いします！金額が不十分でしたら再送して頂ければ可能な限りお応え致します！\n\nTVアニメ「日々は過ぎれど飯うまし」より\n食文化研究部の5人(まこ・くれあ・しのん・つつじ・なな)\nの乱交イラストを可能でしたらお願いします\n\nシチュ・部室内、https://www.pixiv.net/artworks/35164230のような並んでの乱交\n可能でしたら5人の胸、結合部、顔が見える構図のエッチで5人共胸を乳首が見えるよう揉みしだかれてる\n細かい部分はお任せ致します。\n\n差分が可能でしたら「射精前・大量中出し・さらに超大量中出し・竿を抜き中出し事後」を可能な範囲でお願い致します\n射精量は多ければ多い程嬉しいです。超大量中出しではやりすぎなくらいでも嬉しいです\n可能でしたら喘ぎ声や擬音もお願いしたいです。\n\nかなり贅沢な内容ですので厳しければ遠慮なくキャンセルして頂いて構いませんので！\nよろしければご検討頂けますと幸いです！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@misomiso_154/works/341", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/99bc64ce/uploads/origins/63edb794-0b61-4c42-b443-5f3055af7959?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e9ecd0118be6ccf0db3c4ea7a1154e1", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 359111, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@misomiso_154/works/340", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/35616ec8/uploads/origins/af188847-1de5-462b-a76c-5d10103e0cfa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5345a597c38362e00cde7f6d51fdc05", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 359111, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@misomiso_154/works/339", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 359111, "client_id": 1247403, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68874765/uploads/origins/fb5718c3-a4aa-405f-89e5-f1e7a1875898?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebf3f266044370e5ab551854e82a4b3c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68874765/uploads/origins/fb5718c3-a4aa-405f-89e5-f1e7a1875898?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f33c2a61a032ca21cc51f4ac32cace7", "src_set": ""}, "body": "先生、はじめまして。\nこのたびご縁があればと思い、ご連絡させていただきました。\n\nメイプルストーリーの自キャラと友人のキャラクターが一緒に登場するイラストのご依頼を希望しております\n内容としましては、\n「ベッドの上で二人が半脱ぎの状態で、性器を擦り合わせている描写」\nをお願いできればと考えております。\n\n以下のリンクには、キャラクターの設定資料を添付しております。\n画像は友人から提供されたもので、使用許可についても事前に絵師様の確認をいただいております。\n\nもしご都合が合いましたら、ぜひご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://photos.app.goo.gl/JqRcirjMjRxq43qeA", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@misomiso_154/works/338", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9d710873/uploads/origins/f447c169-5836-4efc-9039-20a283976d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=84c9209855981ed373610e72ac26af38", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 359111, "client_id": 262092, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@misomiso_154/works/337", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 359111, "client_id": 592149, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b4ef7d6/uploads/origins/859e7bc4-c3b6-431d-97f8-b8e55f218157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1920a882273d0461d316bcf2497053a2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b4ef7d6/uploads/origins/859e7bc4-c3b6-431d-97f8-b8e55f218157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b7c1c7ba8c2c36aaba5c3d11e88f67a", "src_set": ""}, "body": "skebを再度開けたとのことでしたので、依頼させて頂きます。\n\nキャラ：八舞姉妹（デート・ア・ライブ）\n服装：霊装（胸は露出させてください）\n体位：立ちバック\n\n夕弦を立ちバックで、耶倶矢が前から\n挿入前、挿入、挿入動き、中出し、中出し後の差分が欲しいです\n耶倶矢は、夕弦の胸を揉んでいる、夕弦とのキス、キスをしていない通常差分が欲しいです\n金額と見合わない様でしたら、差分を減らしても構いません\nご検討宜しくお願いします。\n\n耶倶矢参考画像URL：https://date-a-live4th-anime.com/character/kaguya.html\n　　　　　　　　　　https://date-a-live5th-anime.com/character/kaguya.html\n夕弦参考画像URL：https://date-a-live4th-anime.com/character/yuduru.html\n　　　　　　　　　https://date-a-live5th-anime.com/character/yuduru.html", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@misomiso_154/works/336", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 359111, "client_id": 305449, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/085d09a5/uploads/origins/e1e966c3-ab1b-4ad2-9687-d2e723302c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c65a819c8b3083b16daf5b9739cbc49e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/085d09a5/uploads/origins/e1e966c3-ab1b-4ad2-9687-d2e723302c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=623abdf5d85b9db4e834bfc2cc6fc311", "src_set": ""}, "body": "みそ先生、描かれている可愛らしい女の子イラストの数々いつも楽しませていただいております。先日Skeb受付再開されたのことで下記内容でリクエストしたく思います。よろしければご検討ください。\n\n・作品及びキャラクター：フラワーナイトガール(ゲーム)より「フォックスフェイス」(ミステリアスで落ち着いた雰囲気ながら優しく情熱的な一面も秘めたお姉さんキャラ)、及び「ソリダスター」(普段おっとりしていますが未知のものに遭遇すると甘い声を出して興奮してしまうようなお姉さんキャラ)\n　参考URL1：https://gyazo.com/33a3418697219d0b1f810be41d62d5fb\n　参考URL2：https://gyazo.com/8c884b7e6e9c19a7f81853ac854be136\n・衣装格好等：資料URLや上記URLの画像を参考にイヤリングや髪飾りを残し、裸リボンの姿をお願いします。リボンのデザインや肌を覆う度合いはお任せしますが、乳首や股間が見えるようにお願いします。\n・構図、シチュエーション等：先生の描く女の子が横たわったイラストがとても好きなので、抱き枕風、もしくは下記URL1のようなイメージで2人並んで寝そべったイラストをお願いしたいです。細かいポーズはお任せしますが、2人とも大きな胸や太ももが魅惑的なキャラですのでそれらが映るように膝から上、可能でしたら全身の描写をお願いします。\n　URL1：https://skeb.jp/@misomiso_154/works/192\n・その他：股間部分には髪色と同じような色で陰毛描写をお願いしたいです。下記URL2の文香ちゃんのような感じでちょっと濃いめに描いていただけると嬉しいです。なおリボンからはみ出すかどうかはお任せします。\n　URL2：https://misomiso154.fanbox.cc/posts/7923235\n加えて可能でしたら差分等で下記の表現をお願いしたいです。金額的に難しい場合はお手数ですが再送ください。\n　①リボンで乳首や股間が隠れている状態の姿\n　②指でリボンをずらすorお股をくぱぁと開いて見せて誘っているような描写\n\nみそ先生の可愛らしい絵柄で推しキャラクターの姿を見られればとても嬉しいです。以上、長文リクエスト失礼しますがご検討の程よろしくお願いいたします。\n\nhttps://flowerknightgirl.game-info.wiki/d/%a5%d5%a5%a9%a5%c3%a5%af%a5%b9%a5%d5%a5%a7%a5%a4%a5%b9#", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@misomiso_154/works/335", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 359111, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/140e1d46/uploads/origins/e894b878-d9f8-4acd-8911-6727cfce3a48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4971d93bd30a9d27c7fabe9cf65ef9e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/140e1d46/uploads/origins/e894b878-d9f8-4acd-8911-6727cfce3a48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8768cc4a84dd9ddf01307ebbb5c5b71", "src_set": ""}, "body": "みそ先生。リクエスト再開楽しみにしていました。\n以前の募集の時、キャンセルとなりましたがもう一度、英傑大戦の五郎八姫でリクエストさせてください\n※内容は変えました\nhttps://imgur.com/a/I2MNVkg\nhttps://www.youtube.com/watch?v=qfcaK4VqKpI\nhttps://yuyu-tei.jp/sell/ei/card/eiketu4.0/10155\n\n田舎の村の秘祭・因習といった感じで男達と代わる代わるセックスさせられるシチュ\n・和室で布団に仰向けに寝転んで、腰持ち上げられての腰高位の体位\n・五郎八姫はつるぺた無毛のお子様体型。全裸状態\n・周りを複数の男達に囲まれており、一人ずつ相手をさせられている\n・順番待ちの男達は行為を眺めながら自慰して準備中\n・男達は面か何かで顔を隠している\n\n事前→事中→事後描写をお願いします。\nまた、以下のようなイメージの表情差分で何人も相手させられているのを表していただけないでしょうか\n・1人目→キョトンとした無知シチュ\n・2人目→モジモジ恥ずかしがりながらも気持ちよさそうな表情\n・3人目→嫌がっているのを無理矢理\n・4人目→諦めのような表情で涙を流している\n\n※備考\n・レイプ目や挿入時の出血描写、腹ボコ描写はNGでお願いします\n\n長文失礼いたしました。ご検討よろしくお願いいたします", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@misomiso_154/works/334", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 359111, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e5edc60/uploads/origins/1cddb9ee-5937-4556-8533-7e7e2b897bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74957fba856c24c3641145a246e0f278", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e5edc60/uploads/origins/1cddb9ee-5937-4556-8533-7e7e2b897bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4be9a142e17c13c48c12272e0e8809b", "src_set": ""}, "body": "募集お待ちしておりました、イラストをリクエストさせていただきます。\n\n●キャラクター\nラブひなの成瀬川なる\n\n●衣装\nバニーガール、ランガード付きの黒タイツと薄手の白い長手袋、ヒールを着用。\n\n●シチュエーション\n男たちから輪姦されている状態。\n・涙目で悔しげな表情を浮かべている。\n・髪コキをされている。\n\nその他、構図等はお任せします。\n検討していただければ幸いです、どうかよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1Fb9ecFu4YH1FITpxRMdtyp2eXL--SGme?usp=drive_link", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@misomiso_154/works/333", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e0dbc3e6/uploads/origins/59b6