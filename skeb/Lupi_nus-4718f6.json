ix.net/747e4ad1/uploads/origins/1df73646-45dc-40d1-bfb3-4a9b84893d2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7f9cb95bc43074d98a95b350eb70d20", "srcset": "https://si.imgix.net/747e4ad1/uploads/origins/1df73646-45dc-40d1-bfb3-4a9b84893d2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7f9cb95bc43074d98a95b350eb70d20, https://si.imgix.net/747e4ad1/uploads/origins/1df73646-45dc-40d1-bfb3-4a9b84893d2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8271bf6e55f66abc76dacf9e4b5b59ca 2x, https://si.imgix.net/747e4ad1/uploads/origins/1df73646-45dc-40d1-bfb3-4a9b84893d2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a1b18edecee7ec95c5956cf9ce93d8d 3x"}, "body": "初めまして。いきなりですが、花騎士のイラストをリクエストしたいと思います。かなり細かく指定してしまいますが、お許しください。\n内容としましては、「カゴに入れられた木の実をネズミやリス達と一緒に食べるクルミ」のイラストをお願いしたいです。庭園Eを参考にしていただけると嬉しいです。カゴの数は2つで片方は少なく、もう片方は山盛りでお願いします。ここからは分かりやすくまとめます。\n\n• 庭園Eを参考にする\n• クルミが座りながら笑顔で木の実を食べている様子を描く。\n• クルミのお供の「リス」、コナラのお供の「ドンさん」、セラスチウムのお供の「チュウさん」、エピデンドラムと一緒にいる「ネズミ」、ホルデュウムと一緒にいる「リス」の計5匹を描いてください。\n• カゴは２つで片方は山盛り、もう片方は少なく描いてください。そして、「少ない方にドンさん」を描いてください。\n• 木の実の種類については、食べられる物であれば大丈夫です。ドングリは…OKです！例を上げるとクルミ、松ぼっくり、クリ、ピーナッツ、ベリー類など。多少ネタに走っても大丈夫です。(ポケモンに登場する「食べられる実」を描く等)\n• 背景は、草原が良いです。\n\nかなり細かい内容になりましたが、受けていただけると嬉しいです。よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Lupi_nus/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 135552, "client_id": 751755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a8a742b/uploads/origins/747a9fb7-6b03-435f-858b-8e107714b893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8167e3e5104df135eb37119b9630f10", "srcset": "https://si.imgix.net/6a8a742b/uploads/origins/747a9fb7-6b03-435f-858b-8e107714b893?bg=%23fff&auto=format%2C