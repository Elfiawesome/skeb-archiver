97-2eaa-4f9c-adea-d76f65d8931d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbd5650a47bc663122e2a459e7fe3436", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8b72e83/uploads/origins/0c54bf97-2eaa-4f9c-adea-d76f65d8931d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19201a22be0dc38b7d4a2ec73416a878", "src_set": ""}, "body": "再送失礼します！\n素敵な絵柄に惹かれてリクエストさせて頂きました！\n可能でしたらリンク先の二人を描いていただきたいです。\nいろんな衣装やパロがあるのですが資料の中からご自由に選んでいただいて構いません。アレンジもご自由です。\n構図などはお任せいたします。\nお手数をおかけしますがご検討のほどよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1ooDPY7PQoH46TiD4slIOuFC_b7DcCKmR?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@osushi_kome/works/71", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1397781, "client_id": 110759, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e010ad73/uploads/origins/db4de469-d5b4-423e-8bab-7d56a6eaf532?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8d819c3301c30eabb2b3a8baab5b6c1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e010ad73/uploads/origins/db4de469-d5b4-423e-8bab-7d56a6eaf532?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92e26f1688cf1feed6986f1ee92c2d12", "src_set": ""}, "body": "はじめまして。\nナガサキ様の絵柄やイラストの雰囲気が大好きで、ぜひお願いしたくリクエストを送らせていただきました。\n\n私と友人のTRPGのOC2人をお願いしたいです。\n\n戦いに身を投じることもある二人ですが、普段はラブラブなので、家でゆっくり過ごしたり、外でデートしたり、日常の一幕を描いていただけたら嬉しいです。\n構図、服装などお任せしますので、ナガサキ様の描きやすい形でお願いできれば幸いです。\n\n詳細な設定は下記のURLをご覧ください。\nhttps://ktn.sakura.ne.jp/izuran/\n\n簡単な設定は以下の内容となります。\n見た目の詳細は、資料URLで共有します。\n\nご検討のほどよろしくお願いいたします。\n\n\n──────\n\n\n舞台は、忍者が裏で暗躍する現代日本。\n\n\n■何（イズレ）\n\n30歳 / 178cm / 男 / すらっとした体型\n\n政府直属の忍者機関に所属する、戦う諜報員。\nエリートで実力者だが変人。\n諜報活動や情報工作が得意で、交渉や根回しなど対人術に長けている。\n尊大で不遜。かなりタフで、大抵の任務は平気でこなす。\n自信家で堂々としており、落ち着きがある。\n\n\n■青嵐\n\n27歳 / 172cm / 女 / 胸や尻が大きくムチムチした体型\n\nフリーランスの傭兵忍者。\n彼女一人で国家転覆さえも危ぶまれる、実力に優れた「傾国の女忍」。\n丁寧な敬語で話す。\n表向きはドライな性格で、大胆不敵。戦闘時は好戦的。\n反面、仕事以外では自分に自信がなく、生来の根暗でネガティブな気質が顔を出す。\n恋人のイズレの前でだけ、しおしおしたり、小さく丸まったりしておどおどと猫背気味になる。\nイズレに対しては甘えん坊。\n\n\n■関係性\n紆余曲折あったが、現在は同棲している恋人同士。\n恥ずかしそうにしたり嬉しそうな青嵐を、イズレが楽しそうにニヤニヤ見ていることが多い。\nイズレは青嵐をからかうのが好きだが、頬杖をついて優しく見つめている時もある。\n手つなぎやハグ、腕を組んだり肩を抱いたりなどのスキンシップは、イズレから行うことが多く、そうされると青嵐は毎回照れる。\n\n\n■服装\n外の場合、デート用の私服（洋服）でお願いしたいです。\n家の場合、パジャマや部屋着でも可能です。\n春・秋・冬（夏以外）の季節感の服装でお任せしたいです。\nペアルックやリンクコーデを喜んでするタイプ。\n\nhttps://drive.google.com/drive/folders/1lbw-ECFhWdlrzYACd6vW4_Okx31RQdHA?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@osushi_kome/works/70", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1397781, "client_id": 2479045, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d7b3aa8/uploads/origins/be010101-81ea-49f9-812b-7ed0ae928e71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=514782ce60e4085f8dfbb15c8583156e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d7b3aa8/uploads/origins/be010101-81ea-49f9-812b-7ed0ae928e71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2668399423dce64c2ff1a9ebae0376b9", "src_set": ""}, "body": "（1-6-6）\nナガサキ様、初めまして！！先生の絵がとても好きです！もしご縁があれば、私のキャラクター二人を描いていただきたいです！\n\n外国人ですから、何かミスなところがあるかもしれません。資料で分からない所があれば好きに解釈していただいて大丈夫です！\n\n 金額が足りなければ、再送させてお願いします！\n\n ■人物情報 \n詳しい人物情報はこちらのリンクにご覧いただければと思います。\n\nhttps://deep-servant-d31.notion.site/192ae72cf0a680f5b876e8210473c94f?pvs=4\n\n参考用の絵などはこちらのリンクにご覧ください。\n\nhttps://drive.google.com/drive/folders/1-x-Zx0TwLl0sUZpnGix0wzHRc8Lm31l_\n\n\n■使用用途 \n◦　SNSなど \n◦　個人的な印刷(自分で鑑賞用)\n\n読んでいただきありがとうございました！何か不都合があ