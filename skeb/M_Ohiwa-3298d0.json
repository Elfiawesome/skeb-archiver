200&s=15bd0249f7736b19d5ce86b77d5a105d", "srcset": "https://si.imgix.net/39427d9b/uploads/origins/837e8a83-5492-4078-83d5-3bd333a7390f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15bd0249f7736b19d5ce86b77d5a105d, https://si.imgix.net/39427d9b/uploads/origins/837e8a83-5492-4078-83d5-3bd333a7390f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=178712a827c443cfa7055ef1f53f3971 2x, https://si.imgix.net/39427d9b/uploads/origins/837e8a83-5492-4078-83d5-3bd333a7390f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e7e87450c7dc4b8d52c79c5f8d3c8c00 3x"}, "body": "『超かぐや姫！』の酒寄彩葉（いろP）を描いてください。\nワールドイズマインのライブシーンで本編ではかぐやがいた、原作PVオマージュの赤黒市松模様に寝そべっているカットをお願いします。\nどの状態・装いの彩葉にするかはお任せしますが、キーボードは持っていて欲しいです。\n\nhttps://www.nicovideo.jp/watch/sm3504435", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@minillkoya/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3873535, "client_id": 3808372, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b48ba73/uploads/origins/2e329bd1-c843-41a2-b964-ffd15278c5d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7aac2181492e767cf7e79edb0dde95d", "srcset": "https://si.imgix.net/1b48ba73/uploads/origins/2e329bd1-c843-41a2-b964-ffd15278c5d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7aac2181492e767cf7e79edb0dde95d, https://si.imgix.net/1b48ba73/uploads/origins/2e329bd1-c843-41a2-b964-ffd15278c5d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7f0f365c002655be2f9cbf104c10119 2x, https://si.imgix.net/1b48ba73/uploads/origins/2e329bd1-c843-41a2-b964-ffd15278c5d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d96632eaf51e1334b54b89a94c30015 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b48ba73/uploads/origins/2e329bd1-c843-41a2-b964-ffd15278c5d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2dd30f3c91e8026a1cb009567c5b4f3a", "srcset": "https://si.imgix.net/1b48ba73/uploads/origins/2e329bd1-c843-41a2-b964-ffd15278c5d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2dd30f3c91e8026a1cb009567c5b4f3a, https://si.imgix.net/1b48ba73/uploads/origins/2e329bd1-c843-41a2-b964-ffd15278c5d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4467a3d584497ce9fa833b51a2978f20 2x, https://si.imgix.net/1b48ba73/uploads/origins/2e329bd1-c843-41a2-b964-ffd15278c5d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=86f7156158c52b6b957512b568bb2b6e 3x"}, "body": "成就しなかった百合のしっとりとした情念っていいですよね。\n\nただ「仲がいい」とか「切ない」とかではなくて、ちゃんと特別な想いがあったはずなのに、それを真っ直ぐぶつけることはできなくて、でも忘れたフリもできずに、静かに、ただ静かに胸の奥へ沈めたまま生きている――あの湿度が良いですよね。\n物語の主人公だったら露骨に取り乱したり激情をぶつけたりして心を揺さぶって、最後はハッピーエンドを掴み取るじゃないですか。でも、そうじゃないんですよね。むしろ穏やかで、慈愛や無償の愛と呼びたくなるくらい優しく見えるほど、その内側にある未練や諦めきれなさが際立つんですよね。もう、お前、何で気付かないんだよ！って胸ぐらを掴みたくなりますよね。\n届かなかった想いが、時間を経てもなお澱のように残り続けている、そんな空気感のある表情や佇まいに僕たちは惹かれるんだと思います。\n\nというわけで、前置きが長くなりましたが『超かぐや姫！』の綾紬芦花を描いてください。よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@illkoya/works/123", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1483, "client_id": 3808372, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ddbb0f0/uploads/origins/b5383daf-e23b-4e8a-b583-234d0da36cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2f59b8b0c133b1c1165d1c8b55bfb34", "srcset": "https://si.imgix.net/4ddbb0f0/uploads/origins/b5383daf-e23b-4e8a-b583-234d0da36cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2f59b8b0