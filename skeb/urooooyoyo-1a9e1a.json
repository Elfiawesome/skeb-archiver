://drive.google.com/file/d/1pctfMYMrfp0GM4EtqexV8UkpjEjyILfC/view?usp=drivesdk\n\n┈┈┈┈┈┈┈┈┈┈\n\nとても肌寒く、体調も崩しやすくなっていますがどうかお身体に気をつけて！\n文章が拙く情報が少なくてすみません。どんなものでもうれしいので、描きやすいようにお願いします。\nこれからもがんばってください！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@urooooyoyo/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3475740, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37654218/uploads/origins/b2603a33-de56-4138-99c2-8f49a03787f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18ad44c4c49d424ad6ce81a63e0f3095", "srcset": "https://si.imgix.net/37654218/uploads/origins/b2603a33-de56-4138-99c2-8f49a03787f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18ad44c4c49d424ad6ce81a63e0f3095, https://si.imgix.net/37654218/uploads/origins/b2603a33-de56-4138-99c2-8f49a03787f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=162aeebbf29c90bd655a5824c34a6753 2x, https://si.imgix.net/37654218/uploads/origins/b2603a33-de56-4138-99c2-8f49a03787f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1b778b32cd2af81e6c8b7e236edf81d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37654218/uploads/origins/b2603a33-de56-4138-99c2-8f49a03787f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c64326ba46be2b09cd2848ed5a3ebd66", "srcset": "https://si.imgix.net/37654218/uploads/origins/b2603a33-de56-4138-99c2-8f49a03787f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c64326ba46be2b09cd2848ed5a3ebd66, https://si.imgix.net/37654218/uploads/origins/b2603a33-de56-4138-99c2-8f49a03787f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=40ae5c7aa0ebd08a2f04391cb02caee2 2x, https://s