の様なオレンジ掛かった金）、頭に真鍮の輪っかがある天使です。\n表情は優しく笑っている・微笑み（口は閉じてても、開いて笑っててもどちらでも大丈夫です）でお願いします。\n\nまた、槇島さんの描かれる細かな装飾やエフェクトが大好きなので、もしよければオリキャラの武器も描いて頂けたらとても嬉しいです…！色は青色でお願いいたします。\n\n星空・宇宙モチーフの子なので全体的にふわふわきらきらとした無重力感がある雰囲気だと嬉しいです！\n\n槇島さんの描かれる絵の世界観がずっと大好きで、いつか絶対お願いしたいと思っていました！\nお時間のある時で構いませんので槇島さんの体調を最優先にどうぞ気軽にゆっくり描いていただければと思います、どうぞよろしくお願いいたします！\n\nhttps://denden-kntn.tumblr.com/post/628780748068077568", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 292710, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "さくたけ🐇", "screen_name": "sksktktk", "avatar_url": "https://pbs.twimg.com/profile_images/2054493157761613824/MsRSMphT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2290711806/1710236001/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "video"}], "banned": false, "nc": 176}, {"id": 424837, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あさぎ重工", "screen_name": "kikaisoukou", "avatar_url": "https://pbs.twimg.com/profile_images/1740335295131004928/W7Czmoij.jpg", "header_url": "https://pbs.twimg.com/profile_banners/447199846/1545390895/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 653860, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "にょきぱう", "screen_name": "583_NYKsn", "avatar_url": "https://pbs.twimg.com/profile_images/2012875474318368768/DPxQh545.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1114935042466148353/1769941385/1500x500", "ap