しさもあるが青年寄り、20代）\n・竜人。西洋ドラゴンの様な黒い翼に前髪の間から湾曲した黒のツノ（ツノのデザインはお任せで）と長いエルフのような耳 \n・銀髪 、髪の長さは短すぎず長すぎない程度で少しくせっ毛\n\n特徴\n・イヤリングをしている \n・顔や身体に民族のよう幾何学模様が浮かび上がる（色はミントブルーとオレンジ） \n・その模様がネオンカラーである（ミントブルーとオレンジの二色） \n・オッドアイ（此方から見て左目がミントブルー、右目がオレンジ）でドラゴンの様な瞳\n・指空きの黒手袋\n・服装はお任せします\n\n描写範囲\n・バストアップ、かっこいい雰囲気でお願いします\n\n以上描ける範囲でご検討して頂ければ幸いです", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@denden_kntn/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7fff1728/requests/125479_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea6558e6e7bd4e8c6d771039fd79fdab", "srcset": "https://si.imgix.net/7fff1728/requests/125479_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea6558e6e7bd4e8c6d771039fd79fdab, https://si.imgix.net/7fff1728/requests/125479_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59ae03546fd15dc123c8b594787c5adb 2x, https://si.imgix.net/7fff1728/requests/125479_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45b9c460a9a55c1a09735df1908ecb63 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 641426, "client_id": 18962, "nc": 16}, {"path": "/@denden_kntn/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 641426, "client_id": 410077, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bec10d1/requests/124469_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f25911800928fe3c4a280a71c61547de", "srcset": "ht