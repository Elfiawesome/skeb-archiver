ompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=da8823a9f19ba80bc13b17ad27b1bd0c 3x"}, "body": "駕屋トシアキ先生\n\n初めまして！\nskebの開設を心待ちにしておりました！\n先生の描くとても雰囲気のあるセクシーなおじさんたちのイラストが大好きです。\n\nリクエスト内容はクトゥルフ神話TRPGで使用しているオリジナルキャラクターたちになります。\n\n\n●キャラクター説明\n浅沼南桐\n・男、52才、185cm\n・ガタイが良く、筋肉もそこそこある。公安警察官だが、潜入のために用心棒をすることもあり、戦闘する機会が多いため全身に傷跡がある。\n・阿倍のことが好きだが、言うつもりはない（勝てない勝負はしないため）。\n\n阿倍陽太郎\n・男、43才、170cm\n・ガタイは普通だが、引き締まった身体をしていて、体力がある。捜査一課の警察官であり、戦闘経験はそう多くないが、以前爆発に巻き込まれて出来た火傷痕が腹にある。\n・表情が薄く、静かで淡々とした言動が多いが、情に熱い男。\n・浅沼のことは特別に思っている自覚はあるが、その好意に甘えて胡坐をかいている。\n\n●リクエスト内容\n浅沼が阿倍のネクタイを直しているイラストが見たいです！\n明らかに距離感が近すぎるけど、二人とも気にしていない感じの表情で、自然と接している感じだと嬉しいです……。\n\n\n●使用用途\n個人観賞用になります（友人含む）\n\n\nご検討いただければ幸いです。\nリクエストをお読み頂き、ありがとうございました。\nお忙しい時期かと思いますので、どうぞご自愛くださいませ！\n\nhttps://drive.google.com/drive/folders/1CuQhKCM3woLX3xxCsKUSnswCVN9GzXTT?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 891299, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "kotomaru", "screen_name": "kotokoto_kottan", "avatar_url": "https://pbs.twimg.com/profile_images/2040036159292837888/y9SrXcQA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/70083571/1738686666/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 145}, {"id": 2021706, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "叶望かなと", "screen_name": "kanato_345", "avatar_url": "https://pbs.twimg.com/profile_images/2009575495764262912/CdbPEEYC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1325033498143412225/1705137423/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_reque