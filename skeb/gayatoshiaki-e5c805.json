mpress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=da8823a9f19ba80bc13b17ad27b1bd0c 3x"}, "body": "駕屋トシアキ先生\n\n初めまして！\nskebの開設を心待ちにしておりました！\n先生の描くとても雰囲気のあるセクシーなおじさんたちのイラストが大好きです。\n\nリクエスト内容はクトゥルフ神話TRPGで使用しているオリジナルキャラクターたちになります。\n\n\n●キャラクター説明\n浅沼南桐\n・男、52才、185cm\n・ガタイが良く、筋肉もそこそこある。公安警察官だが、潜入のために用心棒をすることもあり、戦闘する機会が多いため全身に傷跡がある。\n・阿倍のことが好きだが、言うつもりはない（勝てない勝負はしないため）。\n\n阿倍陽太郎\n・男、43才、170cm\n・ガタイは普通だが、引き締まった身体をしていて、体力がある。捜査一課の警察官であり、戦闘経験はそう多くないが、以前爆発に巻き込まれて出来た火傷痕が腹にある。\n・表情が薄く、静かで淡々とした言動が多いが、情に熱い男。\n・浅沼のことは特別に思っている自覚はあるが、その好意に甘えて胡坐をかいている。\n\n●リクエスト内容\n浅沼が阿倍のネクタイを直しているイラストが見たいです！\n明らかに距離感が近すぎるけど、二人とも気にしていない感じの表情で、自然と接している感じだと嬉しいです……。\n\n\n●使用用途\n個人観賞用になります（友人含む）\n\n\nご検討いただければ幸いです。\nリクエストをお読み頂き、ありがとうございました。\nお忙しい時期かと思いますので、どうぞご自愛くださいませ！\n\nhttps://drive.google.com/drive/folders/1CuQhKCM3woLX3xxCsKUSnswCVN9GzXTT?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1617206, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "栴／skeb受付中", "screen_name": "__s__n__0", "avatar_url": "https://pbs.twimg.com/profile_images/2058908839202975744/zyb21KuB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1364977293878169601/1758117075/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 2639157, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ライム@Skeb始めました", "screen_name": "ranse237", "avatar_url": "https://pbs.twimg.com/profile_images/1655577168708087811/4qA2Bwz4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1442048826550878208/1681311875/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null,