200&blur=200&s=791a57cf4e2c86f8ba7f29a834f9a126", "srcset": "https://si.imgix.net/399f917e/uploads/origins/352ab527-d189-4b1c-8b91-a953dc25feb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=791a57cf4e2c86f8ba7f29a834f9a126, https://si.imgix.net/399f917e/uploads/origins/352ab527-d189-4b1c-8b91-a953dc25feb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=214486ef5827931cc4f300709b8e8eea 2x, https://si.imgix.net/399f917e/uploads/origins/352ab527-d189-4b1c-8b91-a953dc25feb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c20e1d5c509ac61c514f73af4b38b3ee 3x"}, "body": "架失さま\n\n偶然見つけたあなたの作品たちを見てとっても好きになりました！\n\n色使いやレースなどのこだわりが架失さんの世界観をつくっているように感じて、自分のキャラクターを架失さんの絵柄で見てみたいと思いました。\n\n私がTwitchという配信プラットフォームの配信時に使用している立ち絵を描いていただきたい、というのがリクエストです。\n参考↓\nhttps://x.com/moiSatsuma/status/2019024869363716521?s=20\n\n構図やシチュエーションなどその他のことは全て架失さんの好きにしてくださいませ！\nキャラクターの衣装や髪型を固定していないため、架失さんの好きなようにアレンジしてくださって大丈夫です。外見を固定していないというのは、初音ミクの姿が楽曲によって変わるみたいな、最低限の特徴や色味の共通性があるイメージです。\n\nいただいたイラストは、配信画面一部上に掲載して使用したいと思っております。（例えば、マップ隠し、待機画面など）", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 4360, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "パン山おにぎり🍞", "screen_name": "_shake_onigiri", "avatar_url": "https://pbs.twimg.com/profile_images/1319143237236322304/AK3NHiQT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/381578960/1657035401/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 153564, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "まきあ🜏", "screen_name": "makia274", "avatar_url": "https://pbs.twimg.com/pr