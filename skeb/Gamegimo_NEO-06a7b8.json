いします！\n擬人化♀VerのブラックHEYホーは以前描いておられた赤HEYホーみたいな格好かつ巨乳で、下はミニスカ同然の短い丈と黒のガーターベルトになっています。髪は赤HEYホーに比べて白みが増した髪色で毛先がハネてます。\nセリフや性格は原作同様で、モブ相手に挑発して煽っているのですが、次の場面では敗北してわからせレイプされている即落ち2コマのような流れの絵になります。\n敗北感を強めるために仮面はダメージが入ってて欲しいですが、どこまで割るか割らないかについてはそちらの裁量にお任せします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Gamegimo_NEO/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2047406, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4dd3b610/uploads/origins/0e3a2f5d-0e27-4357-b54e-649b192dbe7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d89b3ac0a40793be0460d8bfce7a04b0", "srcset": "https://si.imgix.net/4dd3b610/uploads/origins/0e3a2f5d-0e27-4357-b54e-649b192dbe7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d89b3ac0a40793be0460d8bfce7a04b0, https://si.imgix.net/4dd3b610/uploads/origins/0e3a2f5d-0e27-4357-b54e-649b192dbe7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b4d4890bb8d922a27a2d5f2952077f1 2x, https://si.imgix.net/4dd3b610/uploads/origins/0e3a2f5d-0e27-4357-b54e-649b192dbe7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5696950a619618ad4865a5a49e75f632 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4dd3b610/uploads/origins/0e3a2f5d-0e27-4357-b54e-649b192dbe7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe9808bf78ce2f57d37b1bb33e69acf1", "srcset": "https://si.imgix.net/4dd3b610/uploads/origins/0e3a2f5d-0e27-4357-b54e-649b192dbe7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe9808bf78ce2f57d37b1bb33e69acf1, https://si.imgix.net/4dd3b610/uploads/origins/0e3a2f5d-0e27-4357-b54e-649b192dbe7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd47c49e9f2417e90b990c1e4c45bc10 2x, https://si.imgix.net/4dd3b610/uploads/origins/0e3a2f5d-0e27-4357-b54e-649b192dbe7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=73682215e365febf979e65ca51d8e639 3x"}, "body": "最近のマｒオｗンダーにも登場しているトッｔンで、こちらの指定した要素での擬人化♀でエッチな絵をリクエストしてもよいでしょうか？\nスタイルは原型をピチピチ全身タイツにしたような大人のグラマラスボディで、首から上は原型と同じ形状の覆面になっています。\n覆面の下は紫髪のかわいい女性ですが、基本的に素顔が見えても口までが殆どというイメージです。\n\nで、原作からしてほぼ無敵のイメージが強いことから、\nモブに襲われてエッチなおさわりとかされてるけど「早く終わんないかなー…」ぐらいにしか思ってないマグロ的な反応だけ見せてる構図でお願いします。\nこの時に覆面を少しずり上げられて素顔の口周りが見えてると個人的に嬉しいです。\nちなみに全身タイツとは言いましたが、乳や尻のボディラインが目立つピチピチの格好であれば良いので、作画の都合に合わせてアレンジしても大丈夫です！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Gamegimo_NEO/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2047406, "client_id": 132424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92d97c1e/uploads/origins/99f4d905-7e0c-4960-b721-5949f7f6296f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47587a0312ad9fc33d435a5946411776", "srcset": "https://si.imgix.net/92d97c1e/uploads/origins/99f4d905-7e0c-4960-b721-5949f7f6296f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47587a0312ad9fc33d435a5946411776, https://si.imgix.net/92d97c1e/uploads/origins/99f4d905-7e0c-4960-b721-5949f7f6296f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b34a962745affd7c2e331150090e3ca 2x, https://si.imgix.net/92d97c1e/uploads/origins/99f4d905-7e0c-4960-b721-5949f7f6296f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4e65ce880c57f1da6476680c18131e3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92d97c1e/uploads/origins/99f4d905-7e0c-4960-b721-5949f7f6296f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&b