rks/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2571334, "client_id": 2315860, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1138e578/uploads/origins/a23badc5-da1d-453d-b103-b82ca21d0280?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95358be79c63ecdca64d2c0239f80151", "srcset": "https://si.imgix.net/1138e578/uploads/origins/a23badc5-da1d-453d-b103-b82ca21d0280?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95358be79c63ecdca64d2c0239f80151, https://si.imgix.net/1138e578/uploads/origins/a23badc5-da1d-453d-b103-b82ca21d0280?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fa84d1281e3807fe640b7cef8d663bf 2x, https://si.imgix.net/1138e578/uploads/origins/a23badc5-da1d-453d-b103-b82ca21d0280?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf74486a90bb161be710c21d20cbbcbd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1138e578/uploads/origins/a23badc5-da1d-453d-b103-b82ca21d0280?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cdb196f96d72de2b9bc56c48613cd991", "srcset": "https://si.imgix.net/1138e578/uploads/origins/a23badc5-da1d-453d-b103-b82ca21d0280?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cdb196f96d72de2b9bc56c48613cd991, https://si.imgix.net/1138e578/uploads/origins/a23badc5-da1d-453d-b103-b82ca21d0280?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=54c1053c3d6dcb458c9e3edb5265fbd0 2x, https://si.imgix.net/1138e578/uploads/origins/a23badc5-da1d-453d-b103-b82ca21d0280?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3662d153afa834ce230a25623620c4d 3x"}, "body": "お世話になっています、いつもシダムラサキオオバッタさんの絵を楽しく拝見しています。\nSkebを始めたとのことで、ずっとこの日を待っていました。\n\n依頼ですが、うちの子の一人、「プリンタ」くんというキャラクターを描いていただきたいです。プリンタのような形をした異形頭で、水色の単眼をしてます。\n\nプリンタくんが、スプラトゥーンのスプラシューターのような武器を右手に持ちながら、前に飛ぶようにジャンプしていて、プリンタくんの左斜めの方向から、ジャンプしている様子を見ているような構図をお願いしたいのですが、よくわからないようでしたらシダさんのセンスや描きたい構図にすべてお任せします。\n武器や表情に希望は特にないので、シダさんの描きたい武器などあればそちらもお任せします。\n\nただし、歯は「ニッ」と笑うような感じで、口は開けたりせず、舌の色を歯の隙間から見せたりなどもしないようにして頂けると助かります。\n\n詳しい設定などは下に記載しましたが、あくまで参考用なので、シダさんのお好みで改変や捏造などしていただいて大丈夫です、よろしくお願いします！\n\n\n-----以下詳細な設定と資料（何か参考になれば用）-----\n【資料】\nhttps://drive.google.com/drive/folders/1Tv3oz8uRan6Oy3MD6RtLZXGMKw3Md4aB?usp=sharing\n\n性別：男\n年齢：不明(イメージ的には高校生、16ぐらい)\n身長：175cm\n体重：不明（ちょい痩せ気味）\n一人称：通常は「ボク」、真面目な時は「オレ」\n二人称：年上「○○さん」、年下「きみ、○○くん」、仲間「呼び捨て、お前」\n\n性格・設定：\nノリが良く誰に対しても気兼ねなく接するコミュ力があるが、危機を察知する能力に長けており、自分とは反りが合わなさそうな雰囲気の人物とはあまり絡まないようにしている。\n年上に対しては「○○っすよ」と敬語のようで敬語でない砕けた口調で話し、年下に対しては「○○じゃん！」「やっぱ○○だよなー、わかる～」「よお！今日も○○しようぜ！」のような、自分はお兄ちゃんだからお兄ちゃんらしく！というような意識で発言や行動をすることが多い。\n\n同じ仲間に「コピー」と「シュレッダー」がいる。\n3人で探偵事務所のような、自警団のような活動を勝手にしている。依頼はほぼ来ない。きても人探しや雑用を頼まれるなどなど。\n2人とプリンタは、血縁こそないもののお互いに家族同然のように仲良くしている。実家暮らしのため、自分だけは探偵事務所に寝泊まりせず実家に毎回帰宅している。\n\n実はいたずら好きな一面があり、仲間や味方だと判断した者に対しては仕掛けないが、それ以外の不特定多数には時折仕掛ける場合がある。\n（足をひっかける、びっくり箱で驚かす、コーラをめちゃくちゃ振った状態で渡す、など）\n\n自分が苦手or危険と判断した人物とは極力コミュニケーションを取らないようにしている。\n自分よりも、「コピー」や「シュレッダー」といった、仲間の存在を非常に大切にしており、彼らに危害を加えようとする、もしくは危険が及ぶような状況に陥った時、いたずら好きの一面が凶悪に変化し、相手を死の一歩手前まで追い詰めるといった行動に出る。\nその際に、ひた隠しにしている腹黒い一面が見え隠れするため、言葉遣いに煽りやイキりといった口調が現れる。\n（「ふーん、雑魚のくせに変に頭は冴えるんだ？でも、どうかな、クソガキにしてやられる気持ちは？うん？うーん？」「オレたちに近づくな、いいか？次その面を見せたら、二度とこの地域を歩けないようにしてやるよ、足があるからしぶとく付き纏うんだよな、ってな」のようなイメージ）", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 203710, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "絵露河童", "screen_name": "dasimakitama50", "avatar_url": "https://pbs.twimg.com/profile_images/1569234400629649409/vz7H8y47.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2759043450/1758530772/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_ma