origins/c58db68e-e1a2-4997-98a4-42154eabf832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68d4767242eea1b0233f87b9613d7d1a 2x, https://si.imgix.net/b8c6d8c0/uploads/origins/c58db68e-e1a2-4997-98a4-42154eabf832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e911449d1b118f69fe8aba6792d0ebe9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8c6d8c0/uploads/origins/c58db68e-e1a2-4997-98a4-42154eabf832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a03b32faae17ba2aed468b4387a7f7f", "srcset": "https://si.imgix.net/b8c6d8c0/uploads/origins/c58db68e-e1a2-4997-98a4-42154eabf832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a03b32faae17ba2aed468b4387a7f7f, https://si.imgix.net/b8c6d8c0/uploads/origins/c58db68e-e1a2-4997-98a4-42154eabf832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f3c6d6970f10e47e48bb4afc7f69aab 2x, https://si.imgix.net/b8c6d8c0/uploads/origins/c58db68e-e1a2-4997-98a4-42154eabf832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd09b2314982b35d26ff9e4997b634bf 3x"}, "body": "リクエストさせていただきます。マグナゲートでエモンガ♂がビリジオン♀とノコッチ♂に愛されるエモンガで\n①赤いドレスを着せられてピカチュウ♀に後ろから押さえされてビリジオンに次はこれをきてみてエモンガに青と白いドレスを渡していてこんなの俺には似合わないってと慌てるエモンガと似合ってると顔赤くしながらエモンガをみるミジュマル。\n②そしてノコッチに似合ってると言われてそうか？と赤面する赤いドレスを着てエモンガ\n③ビリジオンにとってもかわいいわと言われてふん、おれはお前にかわいいとか言われても別に嬉しくないからなと青と白いドレスを着てツンデレなエモンガ、\n④ビリジオンに壁際まで追い詰められ壁度されてなにするきだよとあせあせするエモンガ\n⑤ガオーとエモンガが怒ってビリジオンを押し返そうとして、それにビリジオンはあら、と全く動じておらず\n⑥逆にエモンガは壁際に押し返されてビリジオンが耳を甘噛みしようとはーと口を大きく開けていてあせあせしているエモンガ\n⑦そして耳を甘噛みされて口を大きく開けて海老反りになりながらびくっ！となるエモンガ\n⑧ビリジオン♀にペニスバンドで挿入されてせめられ、射精するエモンガ♂\nビリジオンにあら男の子がおもらしなんて恥ずかしいわよと言われてうるせーと赤くなるエモンガ、\n⑨耳もとでふふ、冗談よちょっとからかっただけといわれるエモンガとニコッと笑うビリジオン。(ここは全身の絵ではなくエモンガとビリジオンの顔がアップの感じの絵でお願いします。)\n⑩ノコッチ♂に尻尾でお尻穴を挿入されながらかぶとあわせで擦り付けられてとろとろエモンガ、ノコッチにエモンガのアソコちっちゃいねと言われながら尻尾でお尻の穴をずぽずぽされてとろとろになりながらノコッチのすげえと思うエモンガ(ノコッチのアソコはエモンガのアソコの二倍以上の大きさはある設定で)\n⑪ノコッチにキスされながらアソコをお尻の穴に挿入されるエモンガをお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ggggg_pk/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1458169, "client_id": 78663, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bff92081/uploads/origins/def9ecf5-68e3-4b49-95dd-daa036b4341a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16a4d25c548b8889f7594d9710732bba", "srcset": "https://si.imgix.net/bff92081/uploads/origins/def9ecf5-68e3-4b49-95dd-daa036b4341a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16a4d25c548b8889f7594d9710732bba, https://si.imgix.net/bff92081/uploads/origins/def9ecf5-68e3-4b49-95dd-daa036b4341a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5c7f39191d5e185fe6db3faaf5eafbc 2x, https://si.imgix.net/bff92081/uploads/origins/def9ecf5-68e3-4b49-95dd-daa036b4341a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e55292462d0312500c6d7e3d71106206 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bff92081/uploads/origins/def9ecf5-68e3-4b49-95dd-daa036b4341a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be117c4ef8e7ef11ea2c7fc5b540faa2", "srcset": "https://si.imgix.net/bff92081/uploads/origins/def9ecf5-68e3-4b49-95dd-daa036b4341a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be117c4ef8e7ef11ea2c7fc5b540faa2, https://si.imgix.net/bff92081/uploads/origins/def9ecf5-68e3-4b49-95dd-daa036b4341a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=458ecb3bd3ed3b87e519795226acaeec 2x, https://si.imgix.net/bff92081/uploads/origins/def9ecf5-68e3-4b49-