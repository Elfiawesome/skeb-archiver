le": false, "total_appeals_count": 0, "received_works": [{"path": "/@teganimaasR18/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3448977, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e5dfe183/uploads/origins/f4a6511b-97bf-4c3e-bced-0cb4bdaadba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7cc19f3d02c8345939a3e62e94cbbd4", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e5dfe183/uploads/origins/f4a6511b-97bf-4c3e-bced-0cb4bdaadba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccd2256453bd0b7edc3b6c11be5e3522", "src_set": ""}, "body": "全裸登校のマンガを見ました。素晴らしいシチュエーションと思い、私も「全裸くすぐりの日」というオリジナルの設定のマンガをリクエストします。\n\n•リクエストされていた全裸登校の世界観や登場人物は同じで、今日は女子のみんなが全裸でくすぐられる日であり、「まず藤咲と峯森」というふうに先生から指名が入り、裸でみんなの前で峯森が立ったまま両腕を真横に広げて、藤咲が後ろから両手をワキワキしながら両脇の下に近づく\n•こちょこちょーと言いながら両脇をくすぐり、峯森は爆笑しながらくすぐられる。\n•攻守交代して藤咲が立ったまま両腕を真横に広げ、後ろから両脇にワキワキとしながら近づく\n•こちょこちょーとくすぐり、頑張って耐えながらも活発な感じで爆笑してしまう\n•次に峯森と雨宮...みたいにどんどん続いていく描写があり次々とみんなくすぐられていく、、、\n以上でお願いします。\n\n全裸登校という面白い設定と、別でくすぐりのイラストを描かれていたので、思い切ってリクエストしました。\nくすぐられているシーンが大きめに描かれていると個人的に助かります。\n是非お願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@teganimaasR18/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3448977, "client_id": 230082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1137de2b/uploads/origins/155be9ea-5984-43f3-ae5d-eebea0510d4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afa7ec7b47b577774c6e41c14725e9d6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1137de2b/uploads/origins/155be9ea-5984-43f3-ae5d-eebea0510d4d?bg=%23fff&auto=format%