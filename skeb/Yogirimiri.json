b.jp/@Yogirimiri/works/6\nこちらのようなバストアップくらいで、\nかわいいテイストの作品が希望です。\n\n作品はyoutubeのサムネイルに使用したいので、\n頭が切れないデザイン、汎用的なデザインやポーズですとたくさん活用できるので大変有難いです。\n\n 特徴としまして\n・左腕のブレスレット２本\n・ハートのみつあみ\n・もふもふの尻尾\nがあります。  \n詳細は三面図を参照いただけますと幸いですが、\n細かい部分は省略していただいても問題ございません。\n\n【 書き出し形式 】 \n・youtubeサムネイル用　サイズ　1280×720ピクセル \n・psd形式  \n・可能であれば、レイヤーを人物、背景と分けて納品していただけますと幸いです。\n\n【 使用用途 】収益化済み youtubeサムネイル  \n\n【資料】 \n◆Twitter https://twitter.com/you_rixkaede \n\n ◆Youtube https://www.youtube.com/@yourixkaede \n\n ご検討いただけますと幸いです。 \nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/2/mobile/folders/1tAEzMGje7A_XuPx9iL0K7C2aVFC11hUl?sort=13&direction=a", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yogirimiri/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5d834b32/uploads/origins/83055061-cb02-447a-b20a-bbb696cd4641?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=804cbbeadd91c8539fb37dde04876861", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3545357, "client_id": 3677986, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Yogirimiri/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3545357, "client_id": 1451753, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09d6c653/uploads/origins/38514ca6-0635-46c3-90df-66c9765385a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=515ab8451d193d30980e038e8c80336c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09d6c653/uploads/origins/38514ca6-0