79469568%2FjdaV9LGb.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c81859b6a3624c77983053deb04f3129 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1755600877279469568%2FjdaV9LGb.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66f3250a0b76c5a4a4bd1cf7f59cac55", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1755600877279469568%2FjdaV9LGb.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66f3250a0b76c5a4a4bd1cf7f59cac55, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1755600877279469568%2FjdaV9LGb.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c45260a09e1592792f61c48d3b24ae7 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1755600877279469568%2FjdaV9LGb.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd9e9474f335d4555090d53a7c8922a0 3x"}, "body": "♂友達がフレイちゃん（8歳♀）魔法少女の服をプレゼントするために、メジャーを使ってフィッティング（主におまんこにメジャーをあてがってマン筋ぐりぐり）して魔法少女の服をプレゼント。着てみるとおまんこだけが丸出しで、ムラムラしてきたフレイが♂に跨る。おまんこの匂いを嗅がれたり、くぱあされて膣内に溜まった愛液をとろりと垂らしたり、舐めてもらったり。中までじっくり舐めてもらったらおしっこしたくなって洋式トイレで♂に付き添われながらおしっこして、ウォシュレットでおまんこを洗われる。 その後ベッドルームでフレイちゃんがお尻を突き出すように四つん這いになり、♂がガニ股で皮被りおちんちんを当てがう。おちんちんを挿入してしばらく皮被りのまま抜き差しされる。膣内で皮が剥けると塩の粒が混じったジュクジュクチンカスが膣壁に塗りたくられる。たっぷりぬりたくられておちんちんを引き抜かれてチンカスで汚れてほかほか湯気立つおまんこを観察。 まだおちんちんにはチンカスがある事をフレイに見せびらかして再びおちんちんをおまんこに挿入し、塗りつけながらごしごし抜き差しして奥にしっかりと、子宮外に漏れ出さないようにたっぷり中出し。 おちんちんを筆おろしさせて再びおまんこを観察した後洗面器にがに股でしゃがませておまんこくぱぁして腰をヘコヘコさせてアピールしてからおしっこをする。おしっこにはチンカスと途中から中出しした熱々性液が膣内を伝って刺激しながら洗面器にまるで卵を産み落とすようにどちゃあっと。 今度はフレイが騎乗位でセックスする。自分で抜き差ししたり、♂から優しく突き上げるようにしたりして気持ち良く。そして再度中出しをする。中出し後はおちんちんを引き抜き、おちんちんにおしっこと性液をかけていき、今度は♂もフレイのおまんこにおしっこをかけていき、お互いのおちんちんやおまんこがどろどろになった状態で挿入して中を擦りあっていって、最後にそれらの塊をフレイのおまんこから洗面器に産み落として仕上げに潮吹きをかけてスイーツの完成みたいな感じの小説が見たいです。  フレイの友達の♂の設定ですが、同じベヒモスの男の子で、フレイがバニラの属性と香りなら、相性の良いミルクの属性を持っている設定。  セリフの要望ですが汚喘ぎなしで可愛らしい喘ぎ声にして欲しいです。 ですが行為中の擬音とかはエグめでお願いいたします。", "nc": 42, "word_count": 14446, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@olient_/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ad13f160/uploads/origins/1c9eaffc-d2a0-4f4f-9f1a-870216d009fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21b17a82f9ce6818972328117995edce", "srcset": "https://si.imgix.net/ad13f160/uploads/origins/1c9eaffc-d2a0-4f4f-9f1a-870216d009fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21b17a82f9ce6818972328117995edce, https://si.imgix.net/ad13f160/uploads/origins/1c9eaffc-d2a0-4f4f-9f1a-870216d009fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad99a3da631b31f6774ff093e3418143 2x, https://si.imgix.net/ad13f160/uploads/origins/1c9eaffc-d2a0-4f4f-9f1a-870216d009fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=2