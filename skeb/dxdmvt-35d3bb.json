ー使用\n\n納品の際、透過データも合わせていただけますと助かります🙇🏻՞\n金額や資料に問題がある際は再度要請いただけますと幸いです。ご検討の程よろしくお願いいたします！♡\n\nhttps://drive.google.com/drive/folders/1RYGYIsy38uR9ZtpEHNmnAtimlbY-87cZ", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@dxdmvt/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3989444, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c997f5c5/uploads/origins/f154211f-45c0-4603-b996-3e097bc074f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41a437e006f56c88dc3d925ebd32e90a", "srcset": "https://si.imgix.net/c997f5c5/uploads/origins/f154211f-45c0-4603-b996-3e097bc074f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41a437e006f56c88dc3d925ebd32e90a, https://si.imgix.net/c997f5c5/uploads/origins/f154211f-45c0-4603-b996-3e097bc074f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfac75d1bf5600dc76ed591302ec5294 2x, https://si.imgix.net/c997f5c5/uploads/origins/f154211f-45c0-4603-b996-3e097bc074f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53d17c31057e5fcc22b4e323f3815fd1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c997f5c5/uploads/origins/f154211f-45c0-4603-b996-3e097bc074f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00ecb4e00a0ab9e2b154a7920b637671", "srcset": "https://si.imgix.net/c997f5c5/uploads/origins/f154211f-45c0-4603-b996-3e097bc074f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00ecb4e00a0ab9e2b154a7920b637671, https://si.imgix.net/c997f5c5/uploads/origins/f154211f-45c0-4603-b996-3e097bc074f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9cc75e143666348dbaf68e1691c3a466 2x, https://si.imgix.net/c997f5c5/uploads/origins/f