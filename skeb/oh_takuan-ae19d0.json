.imgix.net/57a0d058/uploads/origins/478edf15-3ab1-40f5-9e5c-c9591c4f0a24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=927c00e3998b7dc2b9ef21c74d0fd5eb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57a0d058/uploads/origins/478edf15-3ab1-40f5-9e5c-c9591c4f0a24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db865fd3e1d2490e2175ead67ef176a8", "srcset": "https://si.imgix.net/57a0d058/uploads/origins/478edf15-3ab1-40f5-9e5c-c9591c4f0a24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db865fd3e1d2490e2175ead67ef176a8, https://si.imgix.net/57a0d058/uploads/origins/478edf15-3ab1-40f5-9e5c-c9591c4f0a24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a6f0e2f5eee5fe251c96871201c7f18 2x, https://si.imgix.net/57a0d058/uploads/origins/478edf15-3ab1-40f5-9e5c-c9591c4f0a24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=da3e68c04f8558e38d5d0dfa96866746 3x"}, "body": "漬物様、はじめまして！\nXにて素敵なイラストを拝見し、リクエストしました。\n\nよろしければ、私と友人のOCを描いていただけないでしょうか。\n\n漬物様のモノクロイラストはとってもあざやかで、カラーに加えてより重厚感があり、物語性もある構図がイラストを動きのあるものに仕上げていてとっても素敵です。ぜひ、一コマ漫画風のモノクロトーンイラストをお願いしたいです。\n\n自宅で一緒にホラー映画を見る、あるいはホラーゲームを一緒にやっているシチュエーションだと嬉しいです。\n私服やパジャマといった服装のアレンジや、構図などその他すべておまかせします！\n\nキャラ同士で重なる部分がある場合、またはアザラシのぬいぐるみなどのアイテムがキャラと重なる場合はpsdにていただけたらと思いますが、同一キャラの線画または塗りなどの部分はレイヤー結合していただいて大丈夫です。\n\n資料について、キャラクターシートはうまく添付できなかったためURLにて失礼します。\n\n新条　勇気(しんじょうゆうき)\nhttps://emoklore.charasheet.jp/view/471109\n\n犀藤 海(さいとうかい)\nhttps://emoklore.charasheet.jp/view/462021\n\nご検討よろしくお願いします🙇\n\nhttps://www.dropbox.com/scl/fo/gv7u7ycscn6wah80o5tio/AMA4aFEv1HPftnmrKOuSZ8I?rlkey=sgkm55e6snphp04btrl5fcu7v&e=1&st=w2w3wu2k&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oh_takuan/works/11", "private_thumbnail_image_urls": {"src": "https:/