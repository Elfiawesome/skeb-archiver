9228e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb500e31a052da9799efbd68719fd7e2, https://si.imgix.net/6a1f3b1b/uploads/origins/221909a5-be75-45bd-b933-7c6c8d79228e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8dcfee190fe207fd307252790557379c 2x, https://si.imgix.net/6a1f3b1b/uploads/origins/221909a5-be75-45bd-b933-7c6c8d79228e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b0fc2453c4171efc850473a0aec7818 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a1f3b1b/uploads/origins/221909a5-be75-45bd-b933-7c6c8d79228e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f548e25403ae09aa9113560adcdfe94", "srcset": "https://si.imgix.net/6a1f3b1b/uploads/origins/221909a5-be75-45bd-b933-7c6c8d79228e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f548e25403ae09aa9113560adcdfe94, https://si.imgix.net/6a1f3b1b/uploads/origins/221909a5-be75-45bd-b933-7c6c8d79228e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a785c507538f1603d4719464476eacc8 2x, https://si.imgix.net/6a1f3b1b/uploads/origins/221909a5-be75-45bd-b933-7c6c8d79228e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=22843d9745c03497a980bf8c271eca57 3x"}, "body": "このたびアピールありがとうございました！\n\nアキラとミナトのことをたくさん見ていただけたのが伝わってきて、とても嬉しかったです。\n2人の関係性についてのお話も印象に残っていて、メッセージを楽しく読ませていただきました。\n\nまた、Twitterの作品も拝見しました。\n絵柄がとても素敵で、ぜひお二人に描いていただきたいと思いました🥺\n\n内容につきましては、基本的に自由に描いていただけたら嬉しいです。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1vY0XEQD3-eE_IzXgGaFDVz39FrsuIWBc", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kbmkx12/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3957070, "client_id": 1179131, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/659cd57f/uploads/origins/7a082bdf-267c-4684-90ba-f1737949a008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd7ef6cfa645ed4b2bc9edb2c318981a", "srcset": "https://si.imgix.net/659cd57f/uploads/origins/7a082bdf-267c-4684-90ba-f1737949a008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd7ef6cfa645ed4b2bc9edb2c318981a, https://si.imgix.net/659cd57f/uploads/origins/7a082bdf-267c-4684-90ba-f1737949a008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=836b291f61f67718116bb9e0af4918d7 2x, https://si.imgix.net/659cd57f/uploads/origins/7a082bdf-267c-4684-90ba-f1737949a008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0fd5ddf142467155255c9f4b11674de4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/659cd57f/uploads/origins/7a082bdf-267c-4684-90ba-f1737949a008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=625df743efab5eea452ab1e12df77385", "srcset": "https://si.imgix.net/659cd57f/uploads/origins/7a082bdf-267c-4684-90ba-f1737949a008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=625df743efab5eea452ab1e12df77385, https://si.imgix.net/659cd57f/uploads/origins/7a082bdf-267c-4684-90ba-f1737949a008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c3fa6b44ec0bb2466cf568ab85ebdb2d 2x, https://si.imgix.net/659cd57f/uploads/origins/7a082bdf-267c-4684-90ba-f1737949a008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6f61a8baa7b2f47965643b378e88ba8c 3x"}, "body": "はじめまして、先生の作品は超素晴らしいです！\n先生の描かれる、キャラクター同士の関わり方やそのやり取りの生き生きとした表現、そして関係性に対する深いご理解がとても素晴らしく、大好きです。  \n\nもし可能であれば、私のTRPGキャラクターたちで短い漫画を描いていただくことはできますでしょうか？フォルダ内にある S（ソレル／茶色の髪のキャラクター） を中心に描いていただけたら嬉しいです。\n描くキャラの組み合わせやパロ/AU設定は先生のお好きなように選んでいただいて構いません。私は雑食なので（……）、キャラ同士の関係性が少しでも感じられれば嬉しいです！\nもし可能でしたら、一対一の関係性だけでなく、二人以上の関係性やグループ内でのやり取りにも焦点を当てていただけると、とても嬉しいです！\nもちろん、難しそうであれば、先生がお好きな組み合わせや描きやすい組み合わせを自由に選んでいただいて大丈夫です！\n\n話の筋が通らないところがあれば、自由にイメージや自分の考えで埋めていけばいいのです。もし人物の服装の造形などについて不確かなところがありましたら、自由に書き直して創作してください。\n\n可能でしたら宛名とサイン、漫画のセリフなど文章の部分はpsdレイヤーでon/offできると嬉しいです。\nまた、先生が下書きや未使用のrkgkなどを作品に残しておいてくださると、アイデアの変遷を見ることができるのでありがたいです！（ただし、これは必須ではありません）\n\nご依頼をお読みいただき、ご検討くださり誠にありがとうございます！\nお気に召さない場合は、遠慮なく直接キャンセルしてください。\n\nhttps://drive.google.com/drive/folders/1G2yldDUusWRmjXtyBZvMCJr11FJAh5xc?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kbmkx12/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3957070, "client_id": 1116701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c66a63a6/uploads/origins/e6d4de84-f569-48f2-a6d5-b8779a213662?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c70b226d1dc39d8ad42b2f415769286", "srcset": "https://si.imgix.net/c66a63a6/uploads/origins/e6d4de84-f569-48f2-a6d5-b8779a213662?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c70b226d1dc39d8ad42b2f415769286, https://si.imgix.net/c66a63a6/uploads/origins/e6d4de84-f569-48f2-a6d5-b8779a213662?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57882bbcdc380eb7bf74a212f6f3f34c 2x, https://si.imgix.net/c66a63a6/uploads/origins/e6d4de84-f569-48f2-a6d5-b8779a213662?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=569a48e857850e92edbe42bcfcd3018c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c66a63a6/uploads/origins/e6d4de84-f569-48f2-a6d5-b8779a213662?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c917b75fd2f3d336ba86a2483a8cd908", "srcset": "https://si.imgix.net/c66a63a6/uploads/origins/e6d4de84-f569-48f2-a6d5-b8779a213662?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c917b75fd2f3d336ba86a2483a8cd908, https://si.imgix.net/c66a63a6/uploads/origins/e6d4de84-f569-48f2-a6d5-b8779a213662?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b80e92053280073052345633a6e8165 2x, https://si.imgix.net/c66a63a6/uploads/origins/e6d4de84-f569-48f2-a6d5-b8779a213662?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0aa1e36c56d3072969f094250f0f2664 3x"}, "body": "こんにちは、マコトさん！あなたの画風がとても気に入りました。私のオリジナルキャラクターを描いていただけませんか？\n\nキャラクターは、人生の異なる段階にある同一人物です。雰囲気は、心理的な独白のような感じです。若い頃の自分が作り出した精神病院の独房の中で、若い頃の自分が年老いた自分を見守っているという設定です。\n\nテーマとしては、自己抑制、予言、『コヘレトの言葉』、舌の切除、知識と行動などがあります。\nリクエストをお読みいただきありがとうございます。良い一日をお過ごしください。\n\nhttps://drive.google.com/drive/folders/1Iky_H9s06zq_xnkjSDfKo-8BYzwGRIQR", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kbmkx12/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3957070, "client_id": 57223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5abd2e60/uploads/origins/d9147276-37cf-48ad-b7b7-803655365203?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d4f93bdac59c2e8f46783fe395c70f8", "srcset": "https://si.imgix.net/5abd2e60/uploads/origins/d9147276-37cf-48ad-b7b7-803655365203?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d4f93bdac59c2e8f46783fe395c70f8, https://si.imgix.net/5abd2e60/uploads/origins/d9147276-37cf-48ad-b7b7-803655365203?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d39f496e6fa650ed6e2dd36353f6237 2x, https://si.imgix.net/5abd2e60/uploads/origins/d9147276-37cf-48ad-b7b7-803655365203?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45cb420a18c6dddeac4