ますが、\nご検討よろしくお願いいたします！！！！！！！！！！！\n\n楽しみにしております！！！！！！！\n\n狛沢三ツ季（ https://twitter.com/kminu_321 ）\n\nhttps://drive.google.com/drive/folders/1rwRzrkKDPqBnGwncWxW7V4o8Z90GN_7u?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1166238, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "瀬戸", "screen_name": "ebi_oishiiii", "avatar_url": "https://pbs.twimg.com/profile_images/1680886966345412608/8RWeXDJG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1382099772966805507/1771244744/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "nc": 129}, {"id": 1837440, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "猫又はぁ🐾❔", "screen_name": "sukiniyondene", "avatar_url": "https://pbs.twimg.com/profile_images/1945469949826207745/KXqiOAnE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1425712469553516547/1764169359/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 1}, {"id": 2849362, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あーちゃん@skeb募集中", "screen_name": "A_chandayodayo", "avatar_url": "https://pbs.twimg.com/profile_images/1518194053988646914/ATC8cjCF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1468955207019397120/1681298268/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expirati