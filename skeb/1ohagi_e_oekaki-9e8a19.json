、コミッションサイトでのイラスト等依頼時に参考資料等）を考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/15QcfblJ6ABjLUrKZ3ijKi-ncxD6c6GKd", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1ohagi_e_oekaki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1190940, "client_id": 2666890, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ae63693/uploads/origins/e7c5eb61-2a42-4be4-8d53-163acf12c655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=989c9e20572f8655b0f86e3b96f46747", "srcset": "https://si.imgix.net/5ae63693/uploads/origins/e7c5eb61-2a42-4be4-8d53-163acf12c655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=989c9e20572f8655b0f86e3b96f46747, https://si.imgix.net/5ae63693/uploads/origins/e7c5eb61-2a42-4be4-8d53-163acf12c655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f67434c2f79c7e8479b938284574822 2x, https://si.imgix.net/5ae63693/uploads/origins/e7c5eb61-2a42-4be4-8d53-163acf12c655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=985fa18bdd0ba4b185c4ccfed94af927 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ae63693/uploads/origins/e7c5eb61-2a42-4be4-8d53-163acf12c655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3136ba6c16f93814d96ed22d6d2f9fb4", "srcset": "https://si.imgix.net/5ae63693/uploads/origins/e7c5eb61-2a42-4be4-8d53-163acf12c655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3136ba6c16f93814d96ed22d6d2f9fb4, https://si.imgix.net/5ae63693/uploads/origins/e7c5eb61-2a42-4be4-8d53-163acf12c655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed251918bec99c35dd3bb6efc653829b 2x, https://si.imgix.net/5ae63693/uploads/origins/e7