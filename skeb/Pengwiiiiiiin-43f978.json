mgur.com/a/If58aXo\n\nベッドに座っている彼女のそばにワインボトルを置いて、少し酔っている様子を表現してほしい。\nパラスは恋に落ちた乙女のようなイラストにしたい。\n背景はあまり複雑でなくていい。\n分かりにくかったら、自由に描いてください。\n\nありがとうございました。\nペンギン先生の素晴らしい絵をこれからも楽しみにしています", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Pengwiiiiiiin/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1499711, "client_id": 1560896, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4922cbe/uploads/origins/bcee8ca2-3c33-41b8-ae3b-83362cadf60c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f0b9becdbe7781d327f4412435ceec9", "srcset": "https://si.imgix.net/e4922cbe/uploads/origins/bcee8ca2-3c33-41b8-ae3b-83362cadf60c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f0b9becdbe7781d327f4412435ceec9, https://si.imgix.net/e4922cbe/uploads/origins/bcee8ca2-3c33-41b8-ae3b-83362cadf60c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e25e43ea732b230d2ea0b2406903fa4c 2x, https://si.imgix.net/e4922cbe/uploads/origins/bcee8ca2-3c33-41b8-ae3b-83362cadf60c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=948f893d817b0a09bd26fa21422bdd22 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4922cbe/uploads/origins/bcee8ca2-3c33-41b8-ae3b-83362cadf60c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7df95220a9fdd65ae386bd28a126c62", "srcset": "https://si.imgix.net/e4922cbe/uploads/origins/bcee8ca2-3c33-41b8-ae3b-83362cadf60c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7df95220a9fdd65ae386bd28a126c62, https://si.imgix.net/e4922cbe/uploads/origins/bcee8ca2-3c33-41b8-ae3b-83362cadf60c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b81c1f1288c18a27e0ca1708b0586822 2x, htt