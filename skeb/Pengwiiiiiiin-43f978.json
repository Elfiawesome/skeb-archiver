2c832a77b61d621bbc7c6d3b1dc14 2x, https://si.imgix.net/ec4d9500/uploads/origins/640434d1-0768-41b6-81b1-7498ccd8839b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0018ae126a5c95079bcdd35cc0965eb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec4d9500/uploads/origins/640434d1-0768-41b6-81b1-7498ccd8839b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=140ea2be1568eb24a49ff5cfb78963d5", "srcset": "https://si.imgix.net/ec4d9500/uploads/origins/640434d1-0768-41b6-81b1-7498ccd8839b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=140ea2be1568eb24a49ff5cfb78963d5, https://si.imgix.net/ec4d9500/uploads/origins/640434d1-0768-41b6-81b1-7498ccd8839b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ff7dcfa4929c7b30ec1821c85d9f9eef 2x, https://si.imgix.net/ec4d9500/uploads/origins/640434d1-0768-41b6-81b1-7498ccd8839b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0ddfb2fbc520c0149935aebc6b10e6fe 3x"}, "body": "とんでもない誤字をやらかしていたので再送させていただきました　申し訳ありません…\n\nはじめまして！絵柄が好みだったのでフォローさせていただいておりました。skebを開設したとのことで依頼させていただきます！よかったらうちの子を描いていただけないでしょうか。\n\n以下のように、ちょっとキザで王子様気質だけど子供っぽい、中性的なキャラクターとなっています。\n原型（https://drive.google.com/file/d/1z6oV8ucqRVMSdS-igKKS_4GErqBvEhEm/view?usp=sharing）\n原型全身（https://drive.google.com/file/d/1vMlwbjCayAwQXj0XK5FTWIe4bBAnnn_g/view?usp=sharing）\nカスキャ版および設定（https://drive.google.com/file/d/1B5QVk3MXaqaWiqE-u1C9jCkoWm3r3U3J/view?usp=sharing）\nユニフォーム版（https://drive.google.com/file/d/1k1xh_-hyPdBm_4C7HqpoKULRhea0pZZD/view?usp=sharing、https://drive.google.com/file/d/1iCZaQtq0xbAZnGImCn81--VUR_jCrSin/view?usp=sharing）\n\n髪型は銀髪、目の色はシルバー、メガネはRay-BanのRX5250のようなものをイメージしていました。\n今回は原型版の衣装をもとに、黒い高そうなスーツに革靴、第一ボタンを外したワイシャツというラフでかっこよく決めたデザインにしていただけたらと思います。ズボンに関してはラフめにジーンズっぽいもので合わせてますが、スーツに合わせても大丈夫です。カーディガンも当時のキャラメイカー上紅白柄になってしまいましたが、もっとかっこよくアレンジしてくださればと思います！ラフでかっこよく王子様っぽく、でもどこか刹那的な雰囲気が出てくれればと思います。\n\nポージングや表情に関してはスーツをなびかせながら……\"王子様\"！って感じのもの（肝心なところがふんわりした表現ですみません）をお願いします。\n納品はpsdで、できれば大きめのサイズでお願いします。性格の表・裏の表情差分あると嬉しいです…！よろしくお願いします！\n\nhttps://drive.google.com/file/d/1k1xh_-hyPdBm_4C7HqpoKULRhea0pZZD/view?usp=sharing", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 5787, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "𝘂𝗻𝗶🐠", "screen_name": "mer_unipi", "avatar_url": "https://pbs.twimg.com/profile_images/2062195401428795392/wtm_aT10.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2467742767/1693839720/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 54918, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "yam", "screen_name": "yamaP_mako", "avatar_url": "https://pbs.twimg.com/profile_images/1844153513003319296/WQIl0DOO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/764698612093681664/1708339406/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 1127135, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "とん とんぶ", "screen_name": "zassyoku_DD", "avatar_url": "https://pbs.twimg.com/profile_images/1870309931116834821/0UUGSxqN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1206187510583316480/1763568263/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_re