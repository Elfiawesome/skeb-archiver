&w=200&h=200&blur=200&s=8724613afa4eba7f1743d0d50164934b 3x"}, "body": "こんにちは！またメソポタミアのデザインをお願いしたいと思います。今回は、どこかつながりのある3人の悪魔のセットです。\n\n一人目はパズズで、とても有名でイメージもはっきりしています。彼は『エクソシスト』で最も有名だが、実際にはアシプがよく召喚していた。\nもう一人はラマストゥで、赤ん坊や妊婦を捕食する悪魔である。彼女はパズズによって撃退される可能性があるため、パズズの像が描かれた多くのお守りが工芸品として存在する。\n最後に、私はクブが欲しい。クブとは、若くして死んだり、生まれる前に死んだりした子供の幽霊のことである。時には生きている人に問題を起こすこともあるが、神格化されることもある。\n参考資料をimgurのリンクに載せておく。https://imgur.com/a/hpcOofu\n\nこの依頼があまり厄介でなければいいのですが。よろしくお願いします！\n\nhttps://imgur.com/a/hpcOofu", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@t2_hatori/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1090963, "client_id": 118255, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/615ee7fb/uploads/origins/ce51514c-c944-4728-be6d-3b4da1f574a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=112176934b55b68e228b91bda0d7e6e1", "srcset": "https://si.imgix.net/615ee7fb/uploads/origins/ce51514c-c944-4728-be6d-3b4da1f574a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=112176934b55b68e228b91bda0d7e6e1, https://si.imgix.net/615ee7fb/uploads/origins/ce51514c-c944-4728-be6d-3b4da1f574a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb4aec06be24f8bb509ea7c40e24ad35 2x, https://si.imgix.net/615ee7fb/uploads/origins/ce51514c-c944-4728-be6d-3b4da1f574a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d47e4c635f324ef41897965e59dbf2d6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/615ee7fb/uploads/origins/ce51514c-c944-4728-be6d-3b4da1f574a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dda49d30cd41749da60ca7059032ca05", "srcset": "https://si.imgix.net/615ee7fb/uploads/origins/ce51514c-c944-4728-be6d-3b4da1f574a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dda49d30cd41749da60ca7059032ca05, https://si.imgix.net/615ee7fb/uploads/origins/ce51514c-c944-4728-be6d-3b4da1f574a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=66c94935006e3f95223d9d069501c0ce 2x, https://si.imgix.net/615ee7fb/uploads/origins/ce51514c-c944-4728-be6d-3b4da1f574a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa53eae276fca8336b1d1191a33239c8 3x"}, "body": "こんにちは！以前デザインしていただいたアシプと味方のキャラクターがとても気に入りました。今回は同じ設定で2人のキャラクターを依頼したいと思います。一人はアシプの「相棒」です。女性の「アス」（医師／医者）です。もう一人は、アシプが祓うもう一人の悪魔「アーダット・リリ」。彼らは愛を知らずに死んだ少女の幽霊である。詳細はいつものようにimgurに記載した。いつも難しい依頼ばかりで申し訳ないのですが、今回は描くデザインが1つ減り、イメージも明確になったので楽になったかと思います。いつものように、あなたの作品を楽しみにしています！\nhttps://imgur.com/a/asu-oc-ueFi30S\n\nhttps://imgur.com/a/asu-oc-ueFi30S", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@t2_hatori/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1090963, "client_id": 118255, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a568d677/uploads/origins/7d1d86a3-6ad1-4373-8d08-87bff64c5dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd1c97623104e5ba65c7c2efa0078692", "srcset": "https://si.imgix.net/a568d677/uploads/origins/7d1d86a3-6ad1-4373-8d08-87bff64c5dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd1c97623104e5ba65c7c2efa0078692, https://si.imgix.net/a568d677/uploads/origins/7d1d86a3-6ad1-4373-8d08-87bff64c5dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db4e198ae75019415d333cd0b460e3bd 2x, https://si.imgix.net/a568d677/uploads/origins/7d1d86a3-6ad1-4373-8d08-87bff64c5dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=500a4ae477070f3fc179311e7b7a7f3b 3x"}, "duration": null, "nsfw": false, "hardcore