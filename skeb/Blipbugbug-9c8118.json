": "image", "creator_acceptable_same_genre": false}, {"path": "/@Blipbugbug/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/edbc674e/uploads/origins/7171cc77-4197-496f-9a9a-596ef46a408e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8b06aa3a3006efc422653324ff4c6dd", "srcset": "https://si.imgix.net/edbc674e/uploads/origins/7171cc77-4197-496f-9a9a-596ef46a408e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8b06aa3a3006efc422653324ff4c6dd, https://si.imgix.net/edbc674e/uploads/origins/7171cc77-4197-496f-9a9a-596ef46a408e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25f82d3171fd99683a2499821843f63b 2x, https://si.imgix.net/edbc674e/uploads/origins/7171cc77-4197-496f-9a9a-596ef46a408e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b407095722e1c7651be476231769d09 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3471404, "client_id": 2902370, "nc": 129}, {"path": "/@Blipbugbug/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3471404, "client_id": 2990401, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ffc7acb5/uploads/origins/4e687149-2c0b-4eee-ab9c-cb3f4fa05945?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56eb4f04b0be188be4a1553c38ce7222", "srcset": "https://si.imgix.net/ffc7acb5/uploads/origins/4e687149-2c0b-4eee-ab9c-cb3f4fa05945?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56eb4f04b0be188be4a1553c38ce7222, https://si.imgix.net/ffc7acb5/uploads/origins/4e687149-2c0b-4eee-ab9c-cb3f4fa05945?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7347b620980a434b26155a5fd410045f 2x, https://si.imgix.net/ffc7acb5/uploads/origins/4e687149-2c0b-4eee-ab9c-cb3f4fa05945?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f57f8350d283dacbd9f7fc5a7034f46c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ffc7acb5/uploads/origins/4e687149-2c0b-4eee-ab9c-cb3f4fa05945?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e863239232207588eafc947237a06274", "srcset": "https://si.imgix.net/ffc7acb5/uploads/origins/4e687149-2c0b-4eee-ab9c-cb3f4fa05945?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e863239232207588eafc947237a06274, https://si.imgix.net/ffc7acb5/uploads/origins/4e687149-2c0b-4eee-ab9c-cb3f4fa05945?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6755cd24fb34bb87f0b0f0f11dc16fba 2x, https://si.imgix.net/ffc7acb5/uploads/origins/4e687149-2c0b-4eee-ab9c-cb3f4fa05945?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d83cb349aa9403b3219885c475f61d61 3x"}, "body": "ぞてぞ様、初めまして！リクエスト失礼いたします。\nぞてぞ様の透きとおるような美しい背景画に惹かれ、この度依頼させていただきました。金額が相応しくない場合はお手数おかけしますが再送依頼をお願いします。難しければキャンセルいただいても構いません。\n\nもしよろしければ創作のキャラクターと彼の秘密の地下室を描いていただけないでしょうか？\n人物を描くのが難しければデフォルメにしたり、テーブルに帽子が置かれているのみでも大丈夫です。\n穏やかで静謐な部屋をメインの構図に据えていただけると嬉しいです。\n資料には人物の他、部屋のインスパイア元を入れていますが、お好きなように描いて頂ければと思います。\n\n▶資料外補足・世界観等\n・19世紀末の架空世界。世界が一度滅びを迎えてなお、神に抗う軍事組織があった。その一部隊隊長を務める男が仲間を弔う為の花をひっそりと栽培、研究するこじんまりとした秘密の地下室。\n・一般的な植物を育てる余裕はない為、魔法で成長の補助、繁殖を行なっている。暗い部屋の中でうっすらと発光しているものもあるかもしれない。リンドウ、カーネーション、キンセンカ、ユリに似た魔法花が育てられている。\n・小さな天窓はあるものの、地下室の為日光は僅かしか入らない。水路が引かれており、部屋には静かに流れる水の音だけが響いている。\n・部屋の中央にはシンプルな木製のテーブルと椅子が置かれている。部屋の主人はここで遺族や助けた人々からの手紙を何度も読み返す。隊員達の遺品も大切に保管されている。\n\n▶軍帽を目深に被った、筋肉質な男性 46歳\nモチーフ：タロット【VIII/正義】\nイメージカラー：濃い赤\n髪色：エボニー/目の色：黄金\n\n・ミステリアスな雰囲気。掴みどころのない性格。\n・穏やかな笑みの裏に抱える葛藤を他者に見せない、信念のある人間。\n・心を許している友人にも、最も信頼している部下にも、この部屋の存在は教えなかった。正しく在る為に名前も私情も捨てた彼が唯一心から安らぎ、己と向き合えた場所だからだ。\n・服装やアクセサリーなどの着脱や省略などアレンジして頂いて構いません。資料では武器を持っていますがこちらも描いていただかなくても大丈夫です。\n\n▶使用用途\n・個人利用(PCやスマホ壁紙、印刷/グッズ化)\n・ごく限られた範囲の身内間での共有・鑑賞\n\nご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/u/1/folders/1Yz3XhggWIG2tO9UJJT_bMZJZpH8WzLRV", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Blipbugbug/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3471404, "client_id": 2403555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f285405d/uploads/origins/4a3e3405-4cd2-4a88-a5b4-f708bc183ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=703e51d31cb6c331e1abb9b49750c2ba", "srcset": "https://si.imgix.net/f285405d/uploads/origins/4a3e3405-4cd2-4a88-a5b4-f708bc183ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=703e51d31cb6c331e1abb9b49750c2ba, https://si.imgix.net/f285405d/uploads/origins/4a3e3405-4cd2-4a88-a5b4-f708bc183ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce80830e6a89094d84c06cecd7e531a8 2x, https://si.imgix.net/f285405d/uploads/origins/4a3e3405-4cd2-4a88-a5b4-f708bc183ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6ba9e74bf81088cf3fa2359e1236127 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f285405d/uploads/origins/4a3e3405-4cd2-4a88-a5b4-f708bc183ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7af80dd34a4dd0829d7ee6e007ce4300", "srcset": "https://si.imgix.net/f285405d/uploads/origins/4a3e3405-4cd2-4a88-a5b4-f708bc183ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=