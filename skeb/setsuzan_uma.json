ort_client_visible": false, "total_appeals_count": 2, "received_works": [{"path": "/@setsuzan_uma/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3210136, "client_id": 147403, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80eedb98/uploads/origins/ebbd61ec-0190-4fc6-940d-c0facad1446f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97a65c9212b89fe50eb0dd41fa4079d2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80eedb98/uploads/origins/ebbd61ec-0190-4fc6-940d-c0facad1446f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=019b937cb4345d8e252aa77dd3247581", "src_set": ""}, "body": "アピール確認出来ました。もし可能でしたらステイゴールドの勝負服を着たアグネスタキオンをお願いしたいです\nイメージとしましてはこういうのが好きなのかい？とステイゴールドに興味が行っているトレーナーに行っている感じですが、胸元がパツパツなためちょっと羞恥もある感じです。バストは特盛でお願いします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@setsuzan_uma/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3210136, "client_id": 2592670, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1207e3ab/uploads/origins/421f4b56-7a1d-4f79-8809-99b6b6a8db37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91c30a69abf1fc70740a098fce49e412", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1207e3ab/uploads/origins/421f4b56-7a1d-4f79-8809-99b6b6a8db37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=932f4287d59bd622a2560aefc86d2905", "src_set": ""}, "body": "もし宜しければ、トレーナーを応援するチアガールなアイネスフウジンちゃんを描いて頂けないでしょうか？\n衣装は通常勝負服で、両手にポンポンを持ってる状態でお願いします\n表情&ポーズは明るく元気いっぱいな感じでお願いします\nまた、一言二言くらいのセリフ差分もお願いしたいです", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@setsuzan_uma/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3210136, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4cf11ae5/uploads/origins/fe92ddb8-422b-4416-8933-a238ce86ffda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=134f45e0e3577d9435dcea04f5c58046", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4cf11ae5/uploads/origins/fe92ddb8-422b-4416-8933-a238ce86ffda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19a32425b693bc064b938c33a8969515", "src_set": ""}, "body": "突然の依頼失礼します。\nセツザン様の絵を拝見し依頼したく思いリクエストを送らせて頂きました。\n確認お願いします。\n\n・キャラクター\nウマ娘登場人物サトノダイヤモンド(勝負服Natural Brilliance)の全身絵。\nバスト大盛りでお願いします。\n\nトレーナー\n男性、詳細に描かなくても大丈夫です。\n身長170超、青年のイメージでお願いします。\n\n\n・シチュエーション\n1、サトノダイヤモンドがトレーナーの体をダイヤの左手側に向けて仰向けで膝枕しているシチュをお願いします。\n膝枕しながら左手でトレーナーのお腹を撫で、右手でラトル(ガラガラ)を鳴らしてあやしている、でちゅね遊びサトノダイヤモンドバージョンという感じでお願いします。\nダイヤは瞳にハートを浮かべて優しげな笑みでトレーナーを見下ろし、トレーナー側はダイヤの母性に溺れて為す術なく甘やかされている状態。\n\n\n以上をお願いします。\nお忙しい中恐れ入りますが検討お願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@setsuzan_uma/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3210136, "client_id": 3020607, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e296488/uploads/origins/8a0aabda-f800-4e46-aab0-8ae0d1197e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b22187f3a9231730f0afefe2ac75d43e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e296488/uploads/origins/8a0aabda-f800-4e46-aab0-8ae0d1197e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6978991e871301c7f1dabb76f08fcb36", "src_set": ""}, "body": "ウマ娘から結婚後のライトハロー新婚YES枕見せシチュ\n寝間着姿（可愛い系なふわふわパジャマでもセクシー系なランジェリーでも何でも、デザインはお任せ）でお腹辺りに「YES」がプリントされた枕を持ち、ちょっと恥じらい顔でこちらに見せてきている\n差分で表情笑顔で枕の裏返しの方を見せてくる、でもYES/NO枕では無くて裏に書かれてる言葉は「OK」\n\nというものをよろしければお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@setsuzan_uma/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3210136, "client_id": 3097670, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ba5655c/uploads/origins/61aa916e-152e-4712-8156-0c698e2d1955?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33997e738e03597d2f96eff817f3b392", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ba5655c/uploads/origins/61aa916e-152e-4712-8156-0c698e2d1955?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d402c1e43ddf823c7846824f9e40f631", "src_set": ""}, "body": "セツザンさんskeb開設おめでとうございます🎉(言うのが遅い！)\nでは、ウマ娘のオルフェーヴルをお願いします\nオルフェはカッコイイイメージが強いので、カッコ良さ全振りでお願いします(可愛いさとかもあるならカッコ良さだけに拘らなくても大丈夫です)\n背景はあった方がいいですけど、顔の角度とかポーズで色々変わってきそうなのでおまかせで。体調が悪くなってしまって無理とかになってしまったら無しでも大丈夫です。\nポーズもお任せします ｷｯﾄｶｯｺｲｲﾎﾟｰｽﾞﾆｼﾃｸﾚﾙﾓﾝﾆ\n\n提示してる額よりちょっと多い…？気にするなッ！\nちょっとばかしのお祝いです", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 56382, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "(公)＠お仕事skeb募集中", "screen_name": "hamu_koutarou", "avatar_url": "https://pbs.twimg.com/profile_images/1440298249546465286/9co6n6UP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2272801422/1623562527/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre":