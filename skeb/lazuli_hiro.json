愛に近く、世話焼きな兄のような行動が出やすい。\nマイナスな感情になると瞳の青が暗くなる。\n𓐄 𓐄 𓐄 𓐄 𓐄 𓐄 𓐄 𓐄 𓐄 𓐄 𓐄 𓐄 𓐄 𓐄 𓐄 𓐄 𓐄 𓐄\n\n構図やポーズ等お任せします❕\n飴ぺしさんの思うままに描いていただけるとうれしいです❕\nご検討よろしくお願いいたします🙇‍♀️\n\nhttps://drive.google.com/drive/folders/1Q9UNfHhZ2rBxZaBPmwWmDA5KxP7yzEo3", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1156322, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ヘルプマン", "screen_name": "helpen_hhh", "avatar_url": "https://pbs.twimg.com/profile_images/1709960853137879040/OnXwAjNe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1328729254209540096/1766444944/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "nc": 161}, {"id": 2991136, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "篠崎もちめ", "screen_name": "sisisi_sio", "avatar_url": "https://pbs.twimg.com/profile_images/1940336648891326464/Ah4EIvWu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1568936754396405760/1751447011/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 7, "skills": [{"genre": "art"}], "nc": 49}, {"id": 3216231, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ふじ/ 新規❌", "screen_name": "trpg_fuzi", "avatar_url": "https://pbs.twimg.com/profile_images/2024625072699559937/9ZeV6uV4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1544064081745055744/1769968009/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "comp