袋大好きなので手袋イラストをお願いします\n\n内容は手袋で男性器を扱いて射精させた後で，\n手袋に付着した精液を見せつける様に精液あやとりしている様子をお願いします\n\nそのほかの細かいところはお任せしたいと思いますが，\n手袋が強調されているというか目立つというか映えるような感じであると嬉しいです\n衣装は脱がさず着衣状態で,手袋はサテン生地のすべすべ感が表れているとありがたいです\nまた，頭上の輪と背後の羽6枚の描写はお願いします\n\nイラストサイズはA版比率の縦画像でお願いできれば幸いです\n\nそれではなにとぞよしなに\n\n資料\n\nhttps://drive.google.com/drive/folders/1RFG5Fct_KWy8nb1aAWM_KwrK4Fqqv6Gd?usp=drive_link", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tegaki_no_ura/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2653155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c82ce002/uploads/origins/8daff4e0-a4bc-491a-b07e-f551b5c1d608?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bec7c4567cfdc54152db0918739ad0b6", "srcset": "https://si.imgix.net/c82ce002/uploads/origins/8daff4e0-a4bc-491a-b07e-f551b5c1d608?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bec7c4567cfdc54152db0918739ad0b6, https://si.imgix.net/c82ce002/uploads/origins/8daff4e0-a4bc-491a-b07e-f551b5c1d608?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea57a5099685ad30f6abe253d23a36d4 2x, https://si.imgix.net/c82ce002/uploads/origins/8daff4e0-a4bc-491a-b07e-f551b5c1d608?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2aff80bf89e56f6eb05bdc6731eccd54 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c82ce002/uploads/origins/8daff4e0-a4bc-491a-b07e-f551b5c1d608?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79872800e6baa7d113dccb30010cede7", "srcset": "https://si.imgix.net/c82ce002/uploads/origins/8daff4e0-a4bc-491a-b07e-f551b5c1d608?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79872800e6baa7d113dccb30010cede7, https://si.imgix.net/c82ce002/uploads/origins/