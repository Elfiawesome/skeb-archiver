-474e-a1fa-25f85861a4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82d0484f16a3070ef54080dfec088d30, https://si.imgix.net/d9cd2662/uploads/origins/0aadf987-1e73-474e-a1fa-25f85861a4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d23fa3aa9115bff094fcc0adebd9548 2x, https://si.imgix.net/d9cd2662/uploads/origins/0aadf987-1e73-474e-a1fa-25f85861a4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc1e2f6a4940f39834d429496d94a401 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9cd2662/uploads/origins/0aadf987-1e73-474e-a1fa-25f85861a4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc0d6d4809c653dbb5783a3c2a155b8d", "srcset": "https://si.imgix.net/d9cd2662/uploads/origins/0aadf987-1e73-474e-a1fa-25f85861a4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc0d6d4809c653dbb5783a3c2a155b8d, https://si.imgix.net/d9cd2662/uploads/origins/0aadf987-1e73-474e-a1fa-25f85861a4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab14be14c0d6b124ef1fe8f69fda4e7b 2x, https://si.imgix.net/d9cd2662/uploads/origins/0aadf987-1e73-474e-a1fa-25f85861a4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=18e6ddfe611844fceaecd1f4e3f4041d 3x"}, "body": "狐の嫁入りイラストをお願いします\n\n表情　結婚式を控え、はにかみつつも嬉しそう、又は幸せそうに微笑んでる\n(上記に限らず優しい感じであれば嬉しいです。自由に描いてください)\n\n特徴　けもみみ(キツネ耳)\n(作者様判断で「けもみみ無し」でも可です。その場合の注意点を一番下に記載)\n（現在の依頼完了分の２割がけもみみ無しです。どちらでも大丈夫です)\n\n髪のスタイル　作者様におまかせします\n髪の色　おまかせします。白狐等も可\n\n服装　白無垢\n服の色は少し黄色味のある白色、又は白　(他色を薄く混ぜ可)\n白無垢のライン色　基本の白無垢はなしですが、流行の赤色、その他色を作者様判断で自由に入れて構いません\n\nできれば使用しないで欲しい物のお願い(小物や装飾品で使用は可)\n綿帽子(頭の被り物)　なし　(ケモミミが隠れるため)\n赤色和傘の所持　なし　(人物よりも目立つため)\n狐のお面の装着　なし　(顔が隠れるため。所持は可)\n\nその他の装飾品や小物等の使用はおまかせします\n\n季節　収穫の秋(イチョウ、モミジ)、又は芽吹きの季節の春(サクラ)\n天候　天気雨(晴れだけど、一部で雨が降っている状態)　又は、雨上がりの晴れ\n（季節と天候は参考情報です。自由に描いてください）\n\n構図、背景、解像度は作者様におまかせします\n宛名等はナシでお願いします\n\n参考資料等ＵＲＬまとめ\nhttps://twitter.com/pinsuke_m/status/1459135013924978694\n\n使用用途\nSkeb規約に準拠、キツネ関連の振興で使用(広報・地域の祭り等、非商用に限る)\n\n山口県の稲穂祭（きつねの嫁入り）を応援しています\n\n楽しみながら描いてくれると嬉しいです。ご検討お願いします\n\n※例外\nけもみみ無しの場合\nキャラクターは通常の人として扱います。狐の嫁入り設定のため、「狐のお面を所持」してください。\n（狐面と猫面は似ているので、ご注意ください）\n頭に被る綿帽子の有り無しはおまかせします。\n\nその他\n四つ耳（けもみみ＋人耳）の場合\n上記通常の人扱いとなりますが、人間にカチューシャ（けもみみ）の設定で大丈夫です", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@souta_16/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1700623, "client_id": 87319, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4716769e/uploads/origins/6ebb3c47-df9e-4e2f-846b-ae464202190e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=865ab246151672457e395530f84c05af", "srcset": "https://si.imgix.net/4716769e/uploads/origins/6ebb3c47-df9e-4e2f-846b-ae464202190e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=865ab246151672457e395530f84c05af, https://si.imgix.net/4716769e/uploads/origins/6ebb3c47-df9e-4e2f-846b-ae464202190e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a60ee9026e92c4047b4141b8f0aa1947 2x, https://si.imgix.net/4716769e/uploads/origins/6ebb3c47-df9e-4e2f-846b-ae464202190e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d05367702e3e9d1ff959fa9c2208d6d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4716769e/uploads/origins/6ebb3c47-df9e-4e2f-846b-ae464202190e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47d1339a2beaa2d0f8db5beffb9d70a0", "srcset": "https://si.imgix.net/4716769e/uploads/origins/6ebb3c47-df9e-4e2f-846b-ae464202190e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47d1339a2bea