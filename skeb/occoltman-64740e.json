equests/248546_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f6a5fa6bcd0516b6ce99fa1565e820f1 2x, https://si.imgix.net/7abd9725/requests/248546_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5006be29d662abac34192cbaa8ac7763 3x"}, "body": "はじめまして\n好みな感じの絵柄でしたので是非リクエストさせてください\n\nキャラ\n以前、Twitterに挙げられた｢O.C.コルトマンちゃん｣\nhttps://twitter.com/occoltman/status/1355118536218210305?s=19\n\n服装\n･元絵と同じ制服+紺色のハイソックス\n･飾りのない純白のフルバックパンツ(クロッチは省略しないようお願いします)\n\n\nシチュエーション他\n立ち絵と背景のパンツとの組み合わせ(いわゆるMtUウィルスと呼ばれるものです)をお願いします\n\n･立ち絵の表情とポーズは元絵と同じもの\n･背景となるパンツのアップはお尻側から見たもの\n･サインを含めた文字や記号は入れないか、差分等にて有無を選択できるようにしてください\n･psd形式での納品を希望します\n\n\n差分\nもし差し支えなければ\n\n･パンツがお尻に食い込んでいるもの\n好きな男の目の前というイメージで\n･着衣脱糞をしてしまい、絶望の表情を浮かべる姿\n･上記の脱糞後、結果的に両想いだとわかったので、安堵の微笑みを浮かべる姿\n\nを作っていただけたら嬉しいです\n\nスカトロ絵を描かれるのでそのシチュを含む依頼をさせていただきましたが、もしも問題があると判断されましたら即キャンセルしていただいて構いませんのでよろしくお願いたします", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 70355, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "♕みなとちゃん♖", "screen_name": "10yuuka06", "avatar_url": "https://pbs.twimg.com/profile_images/2037882628519718912/hiQtHunb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/518654554/1752330178/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 99256, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ぼ〜〜ずねす🔞🔞🔞🔞", "screen_name": "goldsatsumu", "avatar_url": "https://pbs.twimg.com/profile_images/1883132318371688448/yiQKdakC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1496870631170002944/1696390995/1500x500", "appeal_receivable": false, "popular_creator