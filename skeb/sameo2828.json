amount": 5000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@sameo2828/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 36849, "client_id": 2869424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78bcc595/uploads/origins/3efee576-6dcb-434b-8d27-6db3839a65cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97c72df5abf518078ded9c4d295b4f0d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78bcc595/uploads/origins/3efee576-6dcb-434b-8d27-6db3839a65cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4cb5dfbae088c4fe3272980431b781e", "src_set": ""}, "body": "鮫尾鮫王🦈Sameo Sameo様はじめまして！\nTwitchとYouTubeで活動しています。霧生優貴KiryuYuukiといいます。\nキラキラの宝石のようなイラストが素敵で、今回の楽曲で使用したく\nぜひ依頼させていただきたく思います。\n\n■使用楽曲\nギラギラ / Ado\nhttps://youtu.be/sOiMD45QGLs?si=d7bxS-qDn2erZ3VI\n\n■表情差分\n　目閉じ、目開け\n\n■描画範囲\n　腰上（左右上は見切れない形）\n　構図等はおまかせします。原作準拠でなくても大丈夫です。\n\n■背景\n　おまかせします！\n　レイヤーを分けておいていだけますとうれしいです！\n\n■キャラクターカード\nnormal modeの方を参照いただけますと幸いです。\nロングヘアで、衣装はおまかせします！\nヘイロー、うさ耳、翼は描画いただかなくて大丈夫です！\n（見えにくいですが、左目の斜め下にほくろがあります！）\nhttps://drive.google.com/drive/folders/1hBUmUianf9VLykCaXt9DU1p2A48puflj\n\n■参考動画\n以下のようなダークだけど光の差し込みが映えるイメージです。\n【歌ってみた】ギラギラ/星導ショウ\nhttps://youtu.be/PVf04LhqXxM?si=ePRfCJAOtmPAMPEy", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sameo2828/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 36849, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23f72559/uploads/origins/9b8c413d-64a2-4415-aeed-8e239c0a3689?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=430251b1968e6260f425836989bb7dfa", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23f72559/uploads/origins/9b8c413d-64a2-4415-aeed-8e239c0a3689?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10d0aec5f25611cc9f6464092fe7c945", "src_set": ""}, "body": "初めまして、宝石の国を思わせるキラキラとしたお色の使い方がとても好きです…！\n資料先のOCもキラキラに描いていただけたらと思いリクエスト失礼しております。\n\n資料が様々ありますが描きやすいもので描いていただいて構いません。\n細部や不明な箇所などは捏造改変⭕です。\nなお足に関しては描き手の方々のご想像にお任せしております。\n\n可能でしたらA3サイズでいただけると嬉しいです。\n少々特殊なデザインのキャラクターになりますがご縁がありましたらよろしくお願い致します！\n\nhttps://drive.google.com/folderview?id=1P954ioFvfa73QFTOPrlb6U3Nv9N13Bjn", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sameo2828/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 36849, "client_id": 3479799, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd754737/uploads/origins/2c04d343-c997-4061-a8d8-c2583178cb3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d1aafb0a2cdb83d51778988a42fb4c9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd754737/uploads/origins/2c04d343-c997-4061-a8d8-c2583178cb3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eac6a82ad695debc76dbf122c5e0db2e", "src_set": ""}, "body": "初めまして。あなたの宝石の国風のイラストを見てとっても惹かれまして、リクエスト失礼致します。\n\nうちのOCも、キラッキラの宝石にして頂きたく思います…服装等は詳細のままでお願いできると嬉しいです。\n\n\n顔や体にヒビを入れたりして頂けると飛び跳ねて喜びます🫶\n\nもしご縁あればぜひよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-FnTlyVN3LhTex0jXcUDnhUElSBoZw_y", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sameo2828/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 36849, "client_id": 2443795, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/793098dc/uploads/origins/e0cef4f1-e845-49e9-84ff-faae0b70c7b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61bedcaebbea175ff11513eea605ab2c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/793098dc/uploads/origins/e0cef4f1-e845-49e9-84ff-faae0b70c7b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05b65ac591fc217a9f18e150d112210b", "src_set": ""}, "body": "こんばんは、鮫尾鮫王さん、私のリクエストの再提出をお許しください。価格の変更を見て、それを尊重したいと思いました。\nあなたの作品に出会い、宝石のデザインに一目惚れしました。宝石の国のスタイルで、私のVTuberモデルの作品をリクエストしてもよろしいでしょうか？左腕に双子座のシンボル、左太ももに星形のタトゥーが2つ、左手首に黒い紐が結ばれていて、目の瞳孔は白い星です。髪と目は宝石の国風にしてほしいです。できれば、背景は宝石や星が輝く宇宙をテーマにしてほしいのですが、メインの構図は喜んで鮫尾王鮫さんにお任せします！\n\nよろしくお願いします。\n\nhttps://twitter.com/GemiAstrolo/status/1615357119254913024?t=FSuw2XCnNDHX4Dv9B4WIMg&s=19", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sameo2828/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 36849, "client_id": 2078451, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd7ce45f/uploads/origins/4412ce32-f94a-4404-99f6-adeb637a0ff7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebfa4739469dda2aebc7e1b433dba4d6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd7ce45f/uploads/origins/4412ce32-f94a-4404-99f6-adeb637a0ff7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4af0cf60a3a84185ccbc2c64dc3f7f8", "src_set": ""}, "body": "こんにちは、先生！先生のクリスタルスタイルの画風がとても好きです！私の原神OCのユエリンを描いてくれませんか？彼女は冒険家です。彼女は長い間生きてきたので、とても気楽で忍耐強いです。余暇には、座ってお茶を飲んだり、景色を楽しんだりするのが好き。\n\n背景、ポーズ、表情はお任せします。キャラクターと背景は別々のPSDファイルでお願いできますか？\n\nお忙しい中、ありがとうございました！\n\nhttps://imgur.com/a/HMxjaeg", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sameo2828/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 36849, "client_id": 2061683, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b1b78aa8/uploads/origins/10357745-b451-4c25-aa45-7905ff7a57e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4570897ccf0e926a10b84248f0854ba", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1b78aa8/uploads/origins/10357745-b451-4c25-aa45-7905ff7a57e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc3f34e04dce82decab8e42565c2af7c", "src_set": ""}, "body": "こんにちは、あなたのアートはとても魅力的でカラフルで大好きです！クリスタルのスタイルがとてもキラ～キラ～です。\n私のキャラクターのアートをお願いしたいです。\n私のキャラクターと衣装のリファレンスはgoogle driveのURLにあります。\n\n詳しいお願い\n私のキャラクターがフライパンスタイルでカレーを作っていて、コンロの火が大きく明るく燃えているところを描いてほしいです。私のキャラクターにエプロンをつけてください。ポーズは自由に決めていただいて構いません。\n\n絵はストリームサムネイルとして使用し、SNSに投稿します。\n可能であれば、キャラクターを別レイヤーで分けてください。その方が助かります。\n\nリクエストに目を通していただきありがとうございます。  ご連絡お待ちしております！\n\nhttps://drive.google.com/drive/folders/1jrqYUXuhDOx5EmtkZBZc2oYgf2zslcBd?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sameo2828/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 36849, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe70649c/uploads/origins/addf95e2-7f28-4df1-a7d3-b714df3227ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebb6d43ae9c37148d131ebd8f2a61485", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe70649c/uploads/origins/addf95e2-7f28-4df1-a7d3-b714df3227ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6560818a1bda01035a7a8c7e8218e1c1", "src_set": ""}, "body": "サメオ！こんにちは！\n\n私はあなたのアートスタイルがとても好きで、あなたの作品が欲しいです！私のVTuberは情報ブローカーで、ダストフォックスの精霊と一緒に魔法のアーカイブを運営しています！あなたがとても有名なクリスタルスタイルのアートスタイルが欲しいです！また、アートファイルから背景を分離してください！\n\nまた、背景もアートファイルから分離してください！アーカイブの中の庭のある小さなエリアみたいなところで、彼女とキツネたちのダイナミックな作品をお願いしたいです。\n\n赤と白のクリスタルを使ってもいいです。\n\n本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1WpWD4qIRfPqFItrLyxGA2sNOGcnuou03", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sameo2828/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 36849, "client_id": 2146764, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b13882be/uploads/origins/e1cbffac-06b7-415b-a672-ba0bd4cba4a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496585c1fe7ade4ac638501a56ddb624", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b13882be/uploads/origins/e1cbffac-06b7-415b-a672-ba0bd4cba4a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b23a18a0061d4eec782f83a554ba2b0a", "src_set": ""}, "body": "鮫尾鮫王🦈Sameo Sameo様\nお世話になっております、ざらめと申します。\n以前、宝石のようにキラッキラの素晴らしいイラストありがとうございました！\nよろしければ新しい装いになった私のキャラクターをまたギラギラに描いていただけませんでしょか。\n構図や表情などはすべて自由に描いていただけますと幸いです！\n\n▼キャラのポイントです\n飴細工でできているので体は本来透明な設定です。\n透けている部分があります。（3面図に記載しております）\n宝石やガラスのようにキラッキラです！\n\n▼使用用途は\nTwitter・Youtubeでの配信や動画でサムネイルとして使用したいと考えております。\n▼可能であれば①②のご検討いただけますと幸いです。\n①サムネイルで使用したいので画像サイズは（1920x1080px）でお願いいたします。\n②キャラと背景のレイヤー分けをお願いいたします。\n\nキャラの参考画像は資料URLにございます。\nご検討いただけますと幸いです。何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/u/3/folders/17N7oeuCEyRYgJ5rcqhMhtBYRnr2qfK-2", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sameo2828/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 36849, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/592a9d67/uploads/origins/f392e8dc-82cc-4b69-8539-9093548dc6cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=759ff43e2476b4089d0cf9c9ff081a02", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/592a9d67/uploads/origins/f392e8dc-82cc-4b69-8539-9093548dc6cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=760b0b13ede7b0813ec2bb47f6c44ea0", "src_set": ""}, "body": "こんにちは！妖精OCのアートを描くことに興味がありますか？  好きなように描いてください！  ありがとうございます！\n\nhttps://imgur.com/a/cmtVFx6", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sameo2828/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 36849, "client_id": 2177546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4bd6204/uploads/origins/b2db2acf-79a6-4636-8b46-fed9f7e259f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfd7e957291a024285cf8efe28b9c5cf", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4bd6204/uploads/origins/b2db2acf-79a6-4636-8b46-fed9f7e259f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9859504ff459e36c95211951e7abd2e1", "src_set": ""}, "body": "初めまして！\n2022年7月より活動しております、個人Vtuberのレウカ・スピーネルと申します。私は宝石の1種ピンクスピネルと深海をモチーフとした存在なのですがTwitterで#skebタグを検索していましたところ鮫尾鮫王🦈様のイラストを拝見し、その宝石のように輝く美しい絵柄に一目惚れしまして「ぜひ私を描いて欲しい」と思いskebへリクエストを送らせていただきました！\n\nリクエスト内容は私「レウカ・スピーネル」のイラストとなります。参考資料として三面図をGoogleドライブURLで共有いたします。\n構図など全てお任せしますので、鮫尾鮫王🦈様の思うまま自由に私を描いて頂けましたら幸いです！\n\n描いて下さったイラストは以下の用途でご使用させて頂きたいと考えております。\n♦︎SNS用アイコン・ヘッダー\n♦︎Twitterでの宣伝・告知ツイート\n♦︎Youtube・ツイキャスの配信用サムネイル\n♦︎Youtubeでの配信待機画面内へ掲載\nこちらの使用許可もいただけますと幸いです。\n\nご縁がありますように…よろしくお願いいたします！\n\nhttps://drive.google.com/file/d/1TWrY-AGV2Yo6vwN-530imaD8JauukASD/view?usp=drivesdk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sameo2828/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 36849, "client_id": 2146764, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3934a70b/uploads/origins/9cddc751-7632-452c-83a5-8660661f0883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7d5131b0ed7aeb49e132fde67166c54", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3934a70b/uploads/origins/9cddc751-7632-452c-83a5-8660661f0883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=932958e1485e9aaef4255903396b1f21", "src_set": ""}, "body": "初めまして、VTuberのざらめと申します。\n鮫尾鮫王さまのイラストを拝見し素敵があふれており\n是非とも私のイラストを描いていただきたいと思いリクエストいたしました。\nざらめを宝石の国のようなキラッキラな質感で描いていただけないでしょうか...！\n\n・構図はお任せいたします。\n・いただいたイラストを動画サムネイルなどに使用させていただけると幸いです。\n\nご検討いただけますと幸いです、何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/19bd4qYSErQ5YJ1m4-qsxAXIhb2kJSFKC?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 17065, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "チガサキユウ🐕chigasaki yu", "screen_name": "cgsk_3", "avatar_url": "https://pbs.twimg.com/profile_images/1346607634737025024/8g2P6Ibb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4257303194/1575250056/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 48}, {"id": 2603001, "creator": true, "nsfw_acceptable": fals