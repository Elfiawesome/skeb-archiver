ded2e/uploads/origins/986672ae-3c86-4eea-805b-e7e9a6d2e4d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f19ae55bcb154279ef8748b1329a4538 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1192424, "nc": 17}, {"path": "/@roco_9519/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1192424, "client_id": 2575278, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e11958bf/uploads/origins/192bfc04-5580-4894-839c-3b9ae324abbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7e0e91090eff9c02aa661a26809419a", "srcset": "https://si.imgix.net/e11958bf/uploads/origins/192bfc04-5580-4894-839c-3b9ae324abbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7e0e91090eff9c02aa661a26809419a, https://si.imgix.net/e11958bf/uploads/origins/192bfc04-5580-4894-839c-3b9ae324abbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6cdde6f8a98e439d5f06cf068284fb5 2x, https://si.imgix.net/e11958bf/uploads/origins/192bfc04-5580-4894-839c-3b9ae324abbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1082ed573e2812bea190374b84107d3f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e11958bf/uploads/origins/192bfc04-5580-4894-839c-3b9ae324abbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0724d960f6ad9ca3d4a023d858fdfcf7", "srcset": "https://si.imgix.net/e11958bf/uploads/origins/192bfc04-5580-4894-839c-3b9ae324abbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0724d960f6ad9ca3d4a023d858fdfcf7, https://si.imgix.net/e11958bf/uploads/origins/192bfc04-5580-4894-839c-3b9ae324abbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b0ce1d8c12999cb44bdbd103243b6e6b 2x, https://si.imgix.net/e11958bf/uploads/origins/192bfc04-5580-4894-839c-3b9ae324abbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd86490d64b3f184c1b9456471dcdbeb 3x"}, "body": "初めまして。創作BL小説をネット上で書いている蒼月さわと申します。\nとても艶やかな絵柄で素敵ですね。早速で失礼しますが、自作のBL小説に登場するイタリア人男性とドイツ人男性の二名を描いていただけないでしょうか。\n\n・1人目はイタリア人男性（攻）パウロ\nミラノ出身。26歳。職業はゲイポルノ監督兼俳優。容姿は黒みかかった茶色のさらりとした髪、瞳はチョコレート色、ラテン系の甘くて色気のある顔立ち、日に焼けたような肌の色、高くもなければ低くもない背、均整のとれた体つき。以上は小説内からの抜粋です。一言で言えばモデルのような美男子の容貌です。着ている服は白いリネン地の長袖シャツに革製のズボン。この辺はそういう感じっぽさで大丈夫です。性格はミステリアス。掴みどころがないんですがフランツにだけは猛烈に執着します。しかしそれを表には全く見せない男です。甘い言葉を重ねて相手を篭絡させることに長けています。\n\n・2人目はドイツ人男性（受）フランツ\nミュンヘン出身。25歳。ドイツ連邦軍陸軍所属の職業軍人。容姿は大柄でパウロよりも背は高く引き締まった肉体。金髪碧眼。白い肌。髪の長さは軍人らしく短いです。顔立ちは特に美男子ではないのですが、ゲルマン人らしいスマートな感じです。着ている服ですが、できれば軍服でお願いしたいです。そういう感じが出ていれば大丈夫です。性格は真面目で健気。良く言えば朴訥で正直、悪く言えば単細胞。しかし一度思い立ったら梃子でも動かない頑固さがあります。パウロのことは大好きで、自分が守らなくてはと思っていますが、無意識なままに翻弄されます。\n\n二人は幼馴染みで、子供の頃に別れて以来のミラノでの再会から物語が始まります。お互いに、フラ、パウ、と呼び合う仲です。\n二人のポーズや構図背景などは一切問いません。全てお任せします。\n使用目的は、①小説投稿サイトでの表紙絵　②SNS上での小説の宣伝、です。\nできればタイトル名と著者名も入れていただきたいなと思います。\n\nタイトル名「フランツとパウロ」　著者名「蒼月さわ」\n\nご無理な場合はこちらで文字入れをするのでその許可をいただければと思います。\nイラストを描いて下さった場合、小説投稿サイトのあらすじ欄に表紙デザインとしてお名前の「ろこ様」をご記入させていただきます。SNS上の宣伝にもお名前をクレジットいたします。\n長々と色々書いてしまって大変申し訳ありません。\nどうかご検討のほど、よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@roco_9519/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1192424, "client_id": 947839, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83f51210/uploads/origins/061ce017-6dd5-4da8-be3e-9ec5fae24de4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec7a1912bb328f8f5045d7bc63e77e6e", "srcset": "https://si.imgix.net/83f51210/uploads/origins/061ce017-6dd5-4da8-be3e-9ec5fae24de4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&