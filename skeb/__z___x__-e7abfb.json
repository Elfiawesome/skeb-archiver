.google.com/drive/folders/1dSGO3iW3pdE6AKtvAnE67xFJ1mx-hcMu\n\n※万が一リンク切れ等の場合は、お手数おかけしますがXアカウント（@chilta427）の固定ポストをご確認いただけますと幸いです\n\nhttps://drive.google.com/drive/folders/1dSGO3iW3pdE6AKtvAnE67xFJ1mx-hcMu", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__z___x__/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4017265, "client_id": 1042798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5001d209/uploads/origins/daf2cb60-bfc8-4724-84cb-caea4b0f660b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93e5b6873bc7dd4a351f2d7981e4a933", "srcset": "https://si.imgix.net/5001d209/uploads/origins/daf2cb60-bfc8-4724-84cb-caea4b0f660b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93e5b6873bc7dd4a351f2d7981e4a933, https://si.imgix.net/5001d209/uploads/origins/daf2cb60-bfc8-4724-84cb-caea4b0f660b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b547427f626a974fd113be7bc3efe7c9 2x, https://si.imgix.net/5001d209/uploads/origins/daf2cb60-bfc8-4724-84cb-caea4b0f660b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f63977f642c45313cf8c5727cc06cc5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5001d209/uploads/origins/daf2cb60-bfc8-4724-84cb-caea4b0f660b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=337fa3ae5306ad538d9f0143f80d131e", "srcset": "https://si.imgix.net/5001d209/uploads/origins/daf2cb60-bfc8-4724-84cb-caea4b0f660b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=337fa3ae5306ad538d9f0143f80d131e, https://si.imgix.net/5001d209/uploads/origins/daf2cb60-bfc8-4724-84cb-caea4b0f660b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c55f3a1ad24428ab01d