人誌で脳みそ壊れるぐらいの衝撃を受けたことがあります。\nそれで、自分の壊れた脳みそを回復させるために、裸で涙を流して微笑んでるパープルシスターと恋人繋ぎをしてる状態の男視点での対面座位の絵を描いてもらえればと思い依頼させていただきました。\nまた、可能でしたら\n「私、NINJA君のこと誰よりも愛してる」\nという台詞を入れていただけたらなと思います。\nよろしくお願い致します。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 131247, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "がいえん", "screen_name": "jin_morisono", "avatar_url": "https://pbs.twimg.com/profile_images/1699034047299850240/PqMwPw6w.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 6, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 543451, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "kyouこの頃", "screen_name": "kyou19990801", "avatar_url": "https://pbs.twimg.com/profile_images/1350022426877329413/gwKTs_fd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3109939404/1680779089/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 783062, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ユウサギ", "screen_name": "yuu_sagi", "avatar_url": "https://pbs.twimg.com/profile_images/2053410643295010816/6HxCyYxZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/177010109/1777566580/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art