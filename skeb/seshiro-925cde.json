Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=36ac3ca59d6a7b611506d70223d59087 3x"}, "body": "超次元ゲイムネプテューヌよりノワールとベールをリクエストさせてください\n・（https://skeb.jp/@seshiro/works/3）と（https://skeb.jp/@seshiro/works/7）から続くイメージで、マジック・ザ・ハードに女神の力を奪われギョウカイ墓場の奥に連れ去られたノワールとベール\n・並んで横たわる２人にケーブル触手が絡み付き、犯罪神マジェコンヌ復活のための養分として胸と子宮からシェアエナジーを搾り取っていく\n　※触手は（https://www.pixiv.net/artworks/115806366）のようなイメージで、ノワールからは青い光、ベールからは緑の光を吸い出している）\n　※２人の服装は（https://www.pixiv.net/artworks/109755647）から耳尻尾を省いたような感じになっていると嬉しいです\n・吸引快楽の虜になった２人は恍惚とした表情でよがり声を上げている\n　※予算の関係で可能であれば、膣内の様子をカットインするような差分とマジック・ザ・ハードの台詞出演（姿は見えなくても問題ないです）があると嬉しいです\n注文の多いリクエストで恐縮ですが、検討いただけると嬉しいです", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@seshiro/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e0c99ef3/uploads/origins/09a45331-7d9f-431e-9c79-59781fa12d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7a5bf4c91eb2885c25ac82627a9654a", "srcset": "https://si.imgix.net/e0c99ef3/uploads/origins/09a45331-7d9f-431e-9c79-59781fa12d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7a5bf4c91eb2885c25ac82627a9654a, https://si.imgix.net/e0c99ef3/uploads/origins/09a45331-7d9f-431e-9c79-59781fa12d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=012e191351f0fd818cd9b4cb8e3c4deb 2x, https://si.imgix.net/e0c99ef3/uploads/origins/09a45331-7d9f-431e-9c79-59781fa12d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46bbb24876ea068468e663c436d859d8 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3191490, "client_id": 541483, "nc": 57}, {"path": "/@seshiro/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3191490, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed07d18b/uploads/origins/32585e57-0099-4609-94de-8cc93982de4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86b7d106ed66008eca2ff0034f9e7117", "srcset": "https://si.imgix.net/ed07d18b/uploads/origins/32585e57-0099-4609-94de-8cc93982de4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86b7d106ed66008eca2ff0034f9e7117, https://si.imgix.net/ed07d18b/uploads/origins/32585e57-0099-4609-94de-8cc93982de4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e7ee41b1fdd4f6db6fe4b1dd0353b43 2x, https://si.imgix.net/ed07d18b/uploads/origins/32585e57-0099-4609-94de-8cc93982de4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5523759cf0b9ea4528fad9bdd00ba09e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed07d18b/uploads/origins/32585e57-0099-4609-94de-8cc93982de4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74d6a46bf21cf8fd6755e84bbb7a19c1", "srcset": "https://si.imgix.net/ed07d18b/uploads/origins/32585e57-0099-4609-94de-8cc93982de4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74d6a46bf21cf8fd6755e84bbb7a19c1, https://si.imgix.net/ed07d18b/uploads/origins/32585e57-0099-4609-94de-8cc93982de4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ca43d60b75b4ea7754106e8952466121 2x, https://si.imgix.net/ed07d18b/uploads/origins/32585e57-0099-4609-94de-8cc93982de4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=529aaa9c7b325d7c994e2917d97228c8 3x"}, "body": "何時もお疲れ様です\nパープルハートのイラストありがとうございました\nまたお願いいたします\n\nhttps://skeb.jp/requests/205614\nhttps://skeb.jp/requests/1953134\nhttps://skeb.jp/requests/2675271\n\n設定\n前回の後の設定で出産してから気に入った男を呼び出しての孕ませ+触手プレイ\n\n構図\n・竿役と騎乗位をしている状態でパープルハートの身体を触手がも弄っている\n・服装は以前描かれた箱スクパプハがとてもエロかったのでその姿でお願いします\nhttps://www.pixiv.net/artworks/122705240\n・おっぱいの色は最初の時と同じくらい。サイズは箱スクパプハの時と同じかもう少し小さめで\n・竿役視点で竿役の体は可能な限り省略。なるべくパープルハートの身体が見えるように\n・前回の無駄撃ち孕ませ乱交の時に居た当たりの竿役をとても気に入り今度は彼の精子で孕んであげようと個別で呼び出す\n・竿役は幸運に感動すると共に興奮し、しかも何時もと違う衣装のパープルハートにガンギマリになる\n・そのまま騎乗位で挿入。しかしただのイチャラブだと味気が無いので他の竿役の代わりに触手型スライヌを連れてきて一緒に犯させる\n・パープルハートは一度でも抜いたらスライヌに挿入されてスライヌに孕まされちゃうよ？と竿役を煽りながら激しく腰を振り中出しさせる\n・竿役はスライヌに寝取られてたまるか、絶対に自分の精子で孕ませると萎えることなく更に大きく硬くなった肉棒で攻める\n\n以上のような感じでお願いします！", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@seshiro/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3191490, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ba68ca5/uploads/origins/5b12ee3c-3a81-4c68-913c-30555307f6a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2917066895056ebe010dafcfed0a357e", "srcset": "https://si.imgix.net/6ba68ca5/uploads/origins/5b12ee3c-3a81-4c68-913c-30555307f6a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2917066895056ebe010dafcfed0a357e, https://si.imgix.net/6ba68ca5/uploads/origins/5b12ee3c-3a81-4c68-913c-30555307f6a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66fcd1ba187266e013bcaff831bae300 2x, https://si.imgix.net/6ba68ca5/uploads/origins/5b12ee3c-3a81-4c68-913c-30555307f6a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64bfbe6077a90a45e7ffa787653a8f0a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ba68ca5/uploads/origins/5b12ee3c-3a81-4c68-913c-30555307f6a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2242c6a6e0f0d3cd1ce24854d84acdd1", "srcset": "https://si.imgix.net/6ba68ca5/uploads/origins/5b12ee3c-3a81-4c68-913c-30555307f6a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2242c6a6e0f0d3cd1ce24854d84acdd1, https://si.imgix.net/6ba68ca5/uploads/origins/5b12ee3c-3a81-4c68-913c-30555307f6a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1d6c5550eca7133bc25cf9848b6a7bd5 2x, https://si.imgix.net/6ba68ca5/uploads/origins/5b12ee3c-3a81-4c68-913c-30555307f6a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=978d590b7aa3de78c4e09d53dfc14564 3x"}, "body": "超次元ゲイムネプテューヌよりグリーンハートがマジック・ザ・ハードに女神の力を奪われてしまう図をリクエストさせてください\n前回(https://skeb.jp/@seshiro/works/3)と同様のイメージで、マジックは背後からグリーンハートの両胸を揉みしだき、両胸から搾乳するような形で女神の力を吸い出していく（両胸に蛇のような吸引ケーブルが吸い付き、緑色の光を吸い出す）形でお願いします\n　※構図的に可能であれば、秘所にも吸引ケーブルが挿し込まれている形だと嬉しいです\n差分についても前回同様の全２通りになっていると嬉しいです\n似たようなリクエストで恐れ入りますが、検討いただけると嬉しいです", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@seshiro/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3191490, "client_id": 3196328, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2779822f/uploads/origins/397ae7de-9c45-4019-9ec7-f78a28eace6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bef3f000f4eeac15d0f3483373fd01ed", "srcset": "https://si.imgix.net/2779822f/uploads/origins/397ae7de-9c45-4019-9ec7-f78a28eace6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bef3f000f4eeac15d0f3483373fd01ed, https://si.imgix.net/2779822f/uploads/origins/397ae7de-9c45-4019-9ec7-f78a28eace6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afe41a002ec408c92fae82b96c849381 2x, https://si.imgix.net/2779822f/uploads/origins/397ae7de-9c45-4019-9ec7-f78a28eace6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb0a3543143f6758d81133180c1d0bde 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2779822f/uploads/origins/397ae7de-9c45-4019-9ec7-f78a28eace6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1943de4e101dd8cdf2054fa089e275d9", "srcset": "https://si.imgix.net/2779822f/uploads/origins/397ae7de-9c45-4019-9ec7-f78a28eace6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1943de4e101dd8cdf2054fa089e275d9, https://si.imgix.net/2779822f/uploads/origins/397ae7de-9c45-4019-9ec7-f78a28eace6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9097fcde61f9188b6e0312074a43a60 2x, https://si.imgix.net/2779822f/uploads/origins/397ae7de-9c45-4019-9ec7-f78a28eace6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4c03b487e8cffcd4da1c62c766d56950 3x"}, "body": "せしろ先生、skebリクエストを送らせていただきます。\nまず設定なのですが、せしろ先生の同人誌の延長線の話で全ての女神が快楽堕ちして孕みマジェコンヌによって支配された後の世界でNINJAがいーすんの本を破り勇ネプのように過去へといき、せしろ先生の同人誌一冊めで捕らえられてたネプギアを助けてマジェコンヌの野望を阻止し、竿役の男に竿の大きさも男しての度胸や強さも見せつけて完全勝利した後にこれがきっかけでネプギアと交際を始めてなんだかんだみんなに祝福されながら結婚するという設定でお願いします！\n\nそして描いてもらいたい絵の内容ですが、NINJA目線で、結婚式場でこちらに手を差し伸ばしながら微笑んでるウェディングドレス姿のネプギアをお願いします。\nセリフも「NINJA君、私いまとっても幸せだよ。2人で幸せになろうね♡」って台詞を入れてもらいたいです。\nまた、描けれたらでいいのですが、ネプギアの後ろにこちらを見つめているパプハ様などのドレス姿のネプキャラを何人か描いてもらえたら嬉しいです！！\nよろしくお願い致します", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@seshiro/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3191490, "client_id": 1366155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0cea7542/uploads/origins/38cb38a3-11f5-4a2c-9ae5-ed39b1c3f3c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7ed1444174bb79a22bbd6c820d6ba7d", "srcset": "https://si.imgix.net/0cea7542/uploads/origins/38cb38a3-11f5-4a2c-9ae5-ed39b1c3f3c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7ed1444174bb79a22bbd6c820d6ba7d, https://si.imgix.net/0cea7542/uploads/origins/38cb38a3-11f5-4a2c-9ae5-ed39b1c3f3c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b9c89388e48ba3b02998673fbb875bb 2x, https://si.imgix.net/0cea7542/uploads/origins/38cb38a3-11f5-4a2c-9ae5-ed39b1c3f3c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6387f63adfcf6f9b00142a824ab82f32 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0cea7542/uploads/origins/38cb38a3-11f5-4a2c-9ae5-ed39b1c3f3c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d24e0cd78c1f548a4cd7fd1d7be510ac", "srcset": "https://si.imgix.net/0cea7542/uploads/origins/38cb38a3-11f5-4a2c-9ae5-ed39b1c3f3c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d24e0cd78c1f548a4cd7fd1d7be510ac, https://si.imgix.net/0cea7542/uploads/origins/38cb38a3-11f5-4a2c-9ae5-ed39b1c3f3c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=484b03787b5760ca7df0d74309811118 2x, https://si.imgix.net/0cea7542/uploads/origins/38cb38a3-11f5-4a2c-9ae5-ed39b1c3f3c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cd9b90969e2b9cbc58b010340ee834b9 3x"}, "body": "自分の持ち主であるマスターの見抜き用オナペットになっていたら魔法カード｢巨乳化｣と罠カード｢強制絶頂装置｣を使われ、その効果で超乳化アへ顔アクメをキメる遊戯王OCGのRAI-MEI、トリックスター・ノーブルエンジェル、エクソシスター・マルファ、結晶の大賢者サンドリヨンの四人組をリクエストします。\n\nキャラの造形は\n・全員頭身高めのむちむち、もともと巨乳位のサイズはあるが膨乳で更に大きくなる。\n・膨乳後はへそを超え下腹部がギリギリ隠れない程度の超乳寄りまでサイズアップする(大きい分には可能な限り盛って下さい)\n・服装は原作と同じ物で、乳首と乳輪は共に大きめかつ勃起状態&パフィーニップルが衣装越しにくっきり浮き出ている。\n・性格のイメージはそれぞれ\nRAI-MEI：凛としたクーデレ系お姉さん\n\nノーブルエンジェル：バブみ溢れる甘々ママ\n\nマルファ：妖艶で大人な雰囲気のお姉さん\n\nサンドリヨン：一見上品に見えるがメスガキっぽさのある強気なお姉さん\n\nといった感じのイメージでお願いします。\n\n四人の横並びしている姿を頭から股間までのバストアップで、以下のようなシチュエーションで写して欲しいです。\n\n目の前で｢巨乳化｣と｢強制絶頂装置｣を発動され、訳も分からぬまま間抜けな叫び声を上げて絶頂する。快楽に負け更に汚い淫語を満載したアへオホ声で絶叫し、思い切り白目を剥いたアへ顔を晒しながらイキっぱなしになる。\n\nとにかく下品で無様で肉肉しい姿て画面を埋め尽くして欲しいです。\n\nよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@seshiro/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3191490, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9918e795/uploads/origins/172330a4-e25f-4f5f-8339-c46a1162ed8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1f4eaaa150fcd02ede7886896bf2616", "srcset": "https://si.imgix.net/9918e795/uploads/origins/172330a4-e25f-4f5f-8339-c46a1162ed8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1f4eaaa150fcd02ede7886896bf2616, https://si.imgix.net/9918e795/uploads/origins/172330a4-e25f-4f5f-8339-c46a1162ed8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2908a823d7fc0e3c2f97fd1f34f6a22e 2x, https://si.imgix.net/9918e795/uploads/origins/172330a4-e25f-4f5f-8339-c46a1162ed8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34bc5ebc39b90210560141df6ae662af 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9918e795/uploads/origins/172330a4-e25f-4f5f-8339-c46a1162ed8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8499e31d3951b07d6dbaae8f887dc0ee", "srcset": "https://si.imgix.net/9918e795/uploads/origins/172330a4-e25f-4f5f-8339-c46a1162ed8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8499e31d3951b07d6dbaae8f887dc0ee, https://si.imgix.net/9918e795/uploads/origins/172330a4-e25f-4f5f-8339-c46a1162ed8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ab14e13ad23071ed7148ebb93a10740 2x, https://si.imgix.net/9918e795/uploads/origins/172330a4-e25f-4f5f-8339-c46a1162ed8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05b94781e3cdb26e6a50d038354ed0de 3x"}, "body": "何時もお疲れ様です\nパープルハートのイラストありがとうございました\nまたお願いいたします\n\nhttps://skeb.jp/requests/205614\nhttps://skeb.jp/requests/1953134\n\n設定\n前回の孕ませ乱交の続き\n\n構図\n・背面騎乗位で二穴責+W手コキ+パイズリ+フェラの全責\n・服装は前回と同じく極部丸出しのプロセッサユニット\n・おっぱいのサイズと色は最初の時と同じくらい(前回の時よりももうちょっと小さめでお願いします)\n・竿役は可能な限り省略。なるべくパープルハートの身体が見えるように手前の竿役は肉棒だけで\n・すでに何度も中出しされて確実孕んでると分かっている状態で更に激しく快楽を求めているイメージの台詞もお願いします(可能なら台詞の時はフェラの肉棒は無しでお願いします)\n\n以上のような感じでお願いします！", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@seshiro/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3191490, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4dc76190/uploads/origins/afd82b6a-c22b-48e4-92e7-9b73ad4fe085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46f8808a7fcb62b6b22885bc3818baaf", "srcset": "https://si.imgix.net/4dc76190/uploads/origins/afd82b6a-c22b-48e4-92e7-9b73ad4fe085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46f8808a7fcb62b6b22885bc3818baaf, https://si.imgix.net/4dc76190/uploads/origins/afd82b6a-c22b-48e4-92e7-9b73ad4fe085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ebfa965cc2237013f75321f02a4cb6b 2x, https://si.imgix.net/4dc76190/uploads/origins/afd82b6a-c22b-48e4-92e7-9b73ad4fe085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a4ecdf8d0b5e6dcf344e63a26e2b59f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4dc76190/uploads/origins/afd82b6a-c22b-48e4-92e7-9b73ad4fe085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f835542981139971c1d8329a110c7c99", "srcset": "https://si.imgix.net/4dc76190/uploads/origins/afd82b6a-c22b-48e4-92e7-9b73ad4fe085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f835542981139971c1d8329a110c7c99, https://si.imgix.net/4dc76190/uploads/origins/afd82b6a-c22b-48e4-92e7-9b73ad4fe085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a3400e0840b8d944c5c9f35e5b6909ae 2x, https://si.imgix.net/4dc76190/uploads/origins/afd82b6a-c22b-48e4-92e7-9b73ad4fe085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=049a71b242a84c5d08353a46ef688534 3x"}, "body": "超次元ゲイムネプテューヌよりブラックハートがマジック・ザ・ハードに女神の力を奪われてしまう図をお願いします\n・ギョウカイ墓場に囚われてケーブル触手に拘束されたブラックハートの背後にマジック・ザ・ハードが立っている（２人ともボディスーツだけの姿）\n・マジックはブラックハートの片足を抱え上げ、尻尾のように生えた吸引ケーブルでブラックハートから女神のパワーや戦技を吸い出していく（吸引ケーブルは２，３本生えており、１本は子宮に挿し込まれ、残りは胸に吸い付いて青い光を吸い出す）\n・差分として以下のような全２通りになっていると嬉しいです\n　①女神の力を激しく吸い出され、途方もない快楽と脱力感に涙を浮かべながら悲鳴を上げるブラックハート\n　　（ボディスーツはところどころ虫食いのように解除されている）\n　②女神の力を全て奪われ、虚ろな目で蕩けた笑みを浮かべるブラックハート\n　　（ブラックハートは裸になり、マジックの背中にはブラックハートの羽根が出現している。）\n長文リクエストで申し訳ないですが、検討いただけると嬉しいです\n\n〇ブラックハート\nhttps://alter-web.jp/products/91/\n〇マジック・ザ・ハード\nhttps://www.compileheart.com/neptune_mk2/chara/?page=en1", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@seshiro/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3191490, "client_id": 78693, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d958e834/uploads/origins/5685fab0-8fe3-468f-b7d4-500ef22d6bad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=febadaa12dd00e62370cd6cb37ce0487", "srcset": "https://si.imgix.net/d958e834/uploads/origins/5685fab0-8fe3-468f-b7d4-500ef22d6bad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=febadaa12dd00e62370cd6cb37ce0487, https://si.imgix.net/d958e834/uploads/origins/5685fab0-8fe3-468f-b7d4-500ef22d6bad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc035287cc2eacbe98bee3ce78f8c1fe 2x, https://si.imgix.net/d958e834/uploads/origins/5685fab0-8fe3-468f-b7d4-500ef22d6bad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d14b6e8762c66541b5857f23ec684411 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d958e834/uploads/origins/5685fab0-8fe3-468f-b7d4-500ef22d6bad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a87963626f70be6bdcf8b3184d80432", "srcset": "https://si.imgix.net/d958e834/uploads/origins/5685fab0-8fe3-468f-b7d4-500ef22d6bad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a87963626f70be6bdcf8b3184d80432, https://si.imgix.net/d958e834/uploads/origins/5685fab0-8fe3-468f-b7d4-500ef22d6bad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7129b104a1927892032e15de6ab1870f 2x, https://si.imgix.net/d958e834/uploads/origins/5685fab0-8fe3-468f-b7d4-500ef22d6bad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=155b8376af59c6c3568b244e5d223e81 3x"}, "body": "はじめまして。fanboxとpixivリクエストで投稿されていた、パープルハート＆パープルシスターのイラストが素晴らしかったので、似たようなシチュエーションで依頼されていただきます。\n\n▼キャラクター\nパープルハート\nパープルシスター\nケーブル触手\n\n▼シチュエーション\n再びケーブル触手と戦うことになったパープルハート＆パープルシスター。\n必死に戦うも、女神の力を解析して強化されたケーブル触手に遊ばれながら敗北してしまう。\n\n▼構図\n前作と同じ配置でお願いします。\n直立か片足上げ状態で、触手に絡まれながらも抵抗している感じでお願いします。\n胸を狙うケーブル触手を手で掴んだり、胸を手で隠したり…。\n\n▼差分など\n・腕を頭の上や後ろ手に拘束され、ケーブル触手に胸に吸い付かれてしまう。\n・女神の力をバキュームされ、プロセッサーが徐々に失われる。\n・全エネルギーを解放して脱出しようとするが、ケーブル触手にバキュームされてしまう。\n\n差分は可能な範囲でお願いします。\n2人が難しいようでしたら、パープルハート1人でお願いします。\n陰毛は無しでお願いします。\n表情差分（抵抗感強め）や文字無し差分があると助かります。\nよろしくお願いいたします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@seshiro/works/1", "private_t