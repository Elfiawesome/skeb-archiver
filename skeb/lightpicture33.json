f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=173887627715c9abbb99566c13274a0c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fce3759f/uploads/origins/5690fe4f-8136-4ee0-ad31-c6accf86925f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=269c10648231d003fd9e022287af0253", "src_set": ""}, "body": "はじめまして。\nいつも八色イラストやポケモンイラストを楽しみながら拝見しております。\n\n今回是非、ライト様の手で描かれた推しの歌い手兼Vtuberの「むぎさん」とポケモンの「ジラーチ」との共演が見てみたいと思いリクエストさせていただきました。\n\nシチュエーションや構図は全てライト様にお任せしたいです。(何気ない日常生活のワンシーンでも大歓迎です。)\n下記に「むぎさん」の衣装イラストのURLを貼っておりますが、シチュエーションに合わせて変更していただいて結構です。\n\nTwitterにて納品報告される際に「#むぎぱれっと」を付けて下さるとご本人さまも喜ばれるかと思いますので、お手数をおかけしますがよろしくお願い致します。\n\nまた、イラスト使用許可は「むぎさん」もお願いできないでしょうか？YouTubeのサムネやTwitterでの宣伝等に使用してくれたらと思っております。\n\nもし可能でしたらご検討の程よろしくお願い致します。\n\n参考資料\n【むぎさんのTwitter】\nhttps://twitter.com/mugi_chan25\n\n【むぎさんの衣装】\nhttps://twitter.com/mugi_chan25/status/1453417756703870983?s=20&t=Gxe4AhOL5nVXe54OQbhsUw\n\n【ジラーチ】\nhttps://zukan.pokemon.co.jp/detail/385", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lightpicture33/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/63edd773/uploads/origins/62b1d5f4-09d6-4047-b52e-70c1c4569853?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fae00335e750369439e25f3a322b1869", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 774616, "client_id": 1987022, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@lightpicture33/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 774616, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2df0d3ca/uploads/origins/376013d6-ee15-4a34-ae68-2495e428d25d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95332234b2d65703066dc36c86ca09be", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2df0d3ca/uploads/origins/376013d6-ee15-4a34-ae68-2495e428d25d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a89225340f83f92ce2983176510a05d", "src_set": ""}, "body": "はじめて依頼させていただきます。\n\n最近デビューしたバーチャルアイドルユニットSNOSの山吹ぷるあちゃんを描いていただけないでしょうか。\nhttps://twitter.com/snos_purua/status/1513908310654693382\n\n夏用制服のぷるあちゃんを希望します。\n夏用は公開されていないのでライト先生にお任せしたいです。\nシーンやシチュエーションは、何かに照れているぷるあちゃんがいいのですが、詳細はライト先生にお任せしたいです。\n\nTwitterに納品報告の際には、\n#ぷるあーと　をつけてくださるとぷるあちゃんがとっても喜ぶと思います！\nイラスト使用許可はぷるあちゃんもお願いしたいです。YouTubeのサムネに使用してくれたら嬉しいなぁと思いました。\n\nもし可能でしたらご検討の程よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 464908, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ゆずはら（仮）", "screen_name": "pipipimm", "avatar_url": "https://pbs.twimg.com/profile_images/1974603216584368128/uDHivUAM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1808523348072415232/1744419497/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "novel"}], "nc": 169}, {"id": 1555610, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "娜雪々", "screen_name": "M_nayuse", "avatar_url": "https://pbs.twimg.com/profile_images/1782409257696247808/asiVHa0_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1357962416844230657/1713794899/1500x500", "appeal_receiv