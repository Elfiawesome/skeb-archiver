4bb-84a5-8750d3886add?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3de69b6f510d6b7db45f18cbb2158ea9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b52943b5/uploads/origins/d3135e3d-f31e-44bb-84a5-8750d3886add?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b85e0cdc5243279536d8063dac27254f", "src_set": ""}, "body": "チュン吉様、はじめまして。\n自分のTRPGのキャラクターを描いて頂きたく、リクエスト致します。\nご検討頂けますと幸いです。\n\n■構図・ポーズ\nお任せ。\n服装は私服でお願いします。\n過度な露出は×\n首回り、腕まくり等の露出は〇\n※体に傷あり、資料URLにイラストあります\n眼鏡の有無、髪型の変更はお任せします。\n\n■人物\n名前：紺屋・耀司（こんや・ようじ）\n30代半ば、身長は182cm、体型は精悍。肌は色白、色素は薄め。\n性格は温和、年相応の落ち着きがあるが誰にでも優し過ぎており甘やかす傾向がある。\nサブマシンガンの扱いはプロ並み、仕事はテキパキこなす刑事だが私生活はだらだらと過ごすだらしない所がある。\nややくたびれた雰囲気があり、未亡人っぽいような印象のある未婚者。\nゆるキャラのような可愛いものが好き。とても不器用で料理ができず、足も遅い。\n一人称は「僕」二人称は「君」または名前呼び。\n「～だね」と優しめな話し方。\n\n容姿の詳細については資料URLのドロップボックスを参考にしてください。\n\nhttps://www.dropbox.com/sh/kaj4vyfczfj0gsn/AACQSCC1aqaLl6SfbyDwDwsza?dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TK049ccn/works/51", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/207c1357/uploads/origins/0fab9541-af92-4262-87ce-0276fb67fc96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4519bb259d2715aa9e4d7d5df0d88b10", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1569177, "client_id": 1491551, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@TK049ccn/works/50", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/065bdb99/uploads/origins/d266b34a-e977-4191-91b3-93cc7933cd7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3bbd9c96a497c573e9a787b5b03f62a1", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1569177, "client_id": 858859, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@TK049ccn/works/49", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1569177, "client_id": 1161031, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0af8f866/uploads/origins/ed2c71e2-de61-4af0-b033-40a19168d211?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d56aee632ea6f034e5b1913bd8f94dc2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0af8f866/uploads/origins/ed2c71e2-de61-4af0-b033-40a19168d211?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bd5189b335bf7ce123acbdcb46a7de4", "src_set": ""}, "body": "チュン吉さんはじめまして。筋肉が好きです。\n今回は筋肉が欲しいので、私のOCをリクエストさせていただきたいと思います。\n\n▼テオドア\nイギリス人。男性\n185㎝。ガタイがいい。でかい。それでいて顔はかわいい系\n太りやすいのを気にしており、かっこ悪くならないようにと日々こっそりトレーニングしているタイプの、むっちりした触り心地のいい筋肉。見てて安心感がある\n左腕に交通事故で負った大きな古傷があります\n\n優しいが少し気弱。普段から紳士的に振る舞う。でも家では油断気味で朝かなり弱い\n休日ののんびりした朝の着替え風景みたいなのか、トレーニング後に汗を拭ってる姿\n恋人と同居してるのでベッドはでかいです\n\n参照URLの画像はまだ若いですが、ここから10年後くらいのより逞しくなった姿をお願いしたいです。\n\nいろいろ書きましたが貴方の好きな筋肉を描いてください！\n\nhttps://www.dropbox.com/scl/fo/mgeb25jld5qsmm9yaau1e/h?rlkey=1ykewfe6n305xvk6var5sh6a2&st=nbscjm0i&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TK049ccn/works/48", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/906526f8/uploads/origins/39f2fdc1-a90d-4a13-97a3-fe02c20c7e9