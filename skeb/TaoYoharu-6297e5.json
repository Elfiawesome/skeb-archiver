ix.net/bd8a7905/uploads/origins/7919e978-1ed9-422c-9a0e-ed43e6ae6a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bbb32540590e90041b75c2e259078cc1 2x, https://si.imgix.net/bd8a7905/uploads/origins/7919e978-1ed9-422c-9a0e-ed43e6ae6a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=347055fede651164fb79bb49e3421979 3x"}, "body": "あやめちゃんのイラストがどれも大変良かったのでご依頼したいと思いました\n特にこちら(https://www.pixiv.net/artworks/105680601)のイラストが良かったです\n\nこちらのリットリンクの方を描いていただきたいです\nhttps://lit.link/yamisakitoka\nskebへの依頼は許可されています\n\n先生の描かれるあやめちゃんのように、玩具で自慰して気持ちよくなっている彼女を描いていただきたいです\n衣装や玩具の種類、構図などは先生が描きやすいようにお任せいたします\n\n恥じらいや恍惚としてる表情、絶頂して潮をふいている差分などがあると嬉しいです\n\n要望が多くなってしまいましたが、可能な範囲で大丈夫です\nご検討よろしくお願いします", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TaoYoharu/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2644462, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/896ba986/uploads/origins/b969c1de-39fb-46ae-8834-fc5212905516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73db4fc6b89d3afd7252a0f46afd7d97", "srcset": "https://si.imgix.net/896ba986/uploads/origins/b969c1de-39fb-46ae-8834-fc5212905516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73db4fc6b89d3afd7252a0f46afd7d97, https://si.imgix.net/896ba986/uploads/origins/b969c1de-39fb-46ae-8834-fc5212905516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13533431bdf06ed4fe41651921bd1907 2x, https://si.imgix.net/896ba986/uploads/origins/b969c1de-39fb-46ae-8834-fc5212905516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac6dcf07e9b888daa9ad5d60f0a74256 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/896ba986/uploads/origins/b969c1de-39fb-46a