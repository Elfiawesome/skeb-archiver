ールはバラの花びらのような形をしています 🌹\n* 髪は「クラゲ」のようなふっくらとした雰囲気にしてください（むしろタコみたいですが（笑））\n* 眼球の輪郭部分がピンクで、残りが茶色という「世俗的な異色眼」\n* 目にハイライトは入れないでください。虚ろで、暗く、魂のないような目にしてください\n* 胸と太ももがすごく大きい\n* ガーリー系 ꩝ コケット ꩝ 地雷級の服\n\nポーズや表現上の詳細について\n * 作品と一緒に、オリジナルキャラクター（OC）のみの透明レイヤーも用意してほしい\n* ポーズは自由\n* ^ 彼女はかなり自己愛が強く、人を操るのが得意な女性なので、そういう感じのポーズが合う。 スマホやナイフ、犬の首輪を持っているなど、その手の小道具が合います。でも何でも構いません。\n * アーティストの皆さんがやりたいことは、何でも100％OKです。  \n\nありがとうございます！\n\nhttps://postimg.cc/gallery/mHJGtw4", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2116537, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "そうび⚓︎", "screen_name": "soubi_1022", "avatar_url": "https://pbs.twimg.com/profile_images/2082608291436511232/TICfck2g.jpg", "header_url": "https://pbs.twimg.com/profile_banners/539183748/1745194911/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 145}, {"id": 2613805, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "卯月", "screen_name": "umenoki_01", "avatar_url": "https://pbs.twimg.com/profile_images/2066123892507435008/uoUuvWJ_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1246686217766232064/1781437353/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 2677034, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "U4-Yuhshi-", "screen_name": "1102a935U4", "avatar_url": "https://pbs.twimg.com/profile_images/1919172868484841472/M1eX1Jhw.jpg", "header_