し、一目惚れしたためリクエストを送らせていただきました。\n\nこの度はOCの女の子を描いていただきたいです。性格などは資料をご参照いただけますと幸いです。\n\n衣装➡️資料内の｢全身｣もしくは｢全身②｣の中から、制服以外でお好きなものを選んでいただきたいです。資料に含まれていないお洋服でも大丈夫です。\n構図➡️おまかせいたします。\n使用用途➡️SNS掲載含む個人利用になります。今後、他クリエイター様へ依頼する際の参考資料として提示させていただく可能性があります。\nその他➡️背景透過版も可能でしたらいただけると助かります。\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1tUQivMLC7oKvZcYpp5bFfwqs1a2qIw4g\n\nhttps://drive.google.com/drive/folders/1tUQivMLC7oKvZcYpp5bFfwqs1a2qIw4g", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pukya__/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4098078, "client_id": 3232033, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20b92b90/uploads/origins/38ea7b6a-b9c5-493c-8a58-abfe00d8ca24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b4470add89bd4f15dfa0ceac6c92b06", "srcset": "https://si.imgix.net/20b92b90/uploads/origins/38ea7b6a-b9c5-493c-8a58-abfe00d8ca24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b4470add89bd4f15dfa0ceac6c92b06, https://si.imgix.net/20b92b90/uploads/origins/38ea7b6a-b9c5-493c-8a58-abfe00d8ca24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91194234237503f31bcb3f054aa34358 2x, https://si.imgix.net/20b92b90/uploads/origins/38ea7b6a-b9c5-493c-8a58-abfe00d8ca24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b51f4363e3caf00f887290c35a2d446b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20b92b90/uploads/origins/38ea7b6a-b9c5-493c-8a58-abfe00d8ca24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=209ab9f52c8fe515fd43a2c748350087", "srcset": "https://si.imgix.net/20b92b90/uploads/origins/38ea7b6a-b9c5-493c-8a58-abfe00d8ca24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur