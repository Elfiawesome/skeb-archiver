n\n【シチュ】\nhttps://x.com/phatpoprei/status/1843611479117021665/photo/1\n上のような普段＋調教（？）しているようなイラストが好きなので、似たような構図のイラストにして欲しいです。\n調教内容としては、道具を使われて拡張されながら何度も絶頂している感じでお願いします。\n竿役は無し、背景も無しで大丈夫です。\nもしも可能でしたら悟りシリーズにキャラ名と一緒に書いてある調教内容（？）の書き文字などが好きなので、大変でなさそうでしたら一緒に書いて頂きたいです。\n\n他の細かいところはお任せします。\nあいまいなものになってしまったのですが、よろしければお願いします…！（＞人＜；）", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@phatpoprei/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1009011, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d02e394a/uploads/origins/28860f01-00cf-408b-ac3b-b851ec00937a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=929735685371564d2eed2d26d56f8f15", "srcset": "https://si.imgix.net/d02e394a/uploads/origins/28860f01-00cf-408b-ac3b-b851ec00937a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=929735685371564d2eed2d26d56f8f15, https://si.imgix.net/d02e394a/uploads/origins/28860f01-00cf-408b-ac3b-b851ec00937a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=806295b95b54f6665a5809b9febec3f3 2x, https://si.imgix.net/d02e394a/uploads/origins/28860f01-00cf-408b-ac3b-b851ec00937a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ceea7e069e654aaf8223c7d4b9bf3d0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d02e394a/uploads/origins/28860f01-00cf-408b-ac3b-b851ec00937a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73a4918dd15734a7d506ba38e8107f04", "srcset": "https://si.imgix.net/d02e394a/uploads/origins/28860f01-00cf-408b-ac3b-b851ec00937a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73a4918dd15734a7d506ba38e8107f04, https://si.imgix.net/d02e394a/uploads/origins/28860f01-00cf-408b-ac3b-b851ec00937a?bg=%23fff