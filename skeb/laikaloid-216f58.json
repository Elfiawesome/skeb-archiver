i.imgix.net/910d89b3/uploads/origins/046b6f18-27b0-45f0-b56f-334bfd4bd9bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d85f7c2bcfb7d5d785e53d95a4b09dda 3x"}, "body": "『バイト先の地味な巨乳オバサンが意外にエロカワイくて困る』に登場するカフェ店員の白川万里子さんが、喫茶店内で波多野陽平くんの指示に従い、ブラとパンティ（レースの下着）、それにエプロンのみをまとった姿で、椅子かソファに座り、恥じらいの表情を見せつつM字開脚しているのを正面からとらえたシーンをお願いします。\n　またエプロンを着けているポーズに加え、下着姿のみのバージョンと、ブラを外したバージョンもお願いできないでしょうか。\n　あとできれば、背景とキャラは別々のレイヤーにして下さると大変うれしいです。\n　色々注文が多く、大変恐れ入りますが、ご検討くだされば幸いです。よろしくお願い申し上げます。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@laikaloid/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/86c07df0/uploads/origins/52c15512-9b16-445e-8af6-39cbc1a9d612?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=720c6c850d4d7b0cea87bd86eaa5d636", "srcset": "https://si.imgix.net/86c07df0/uploads/origins/52c15512-9b16-445e-8af6-39cbc1a9d612?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=720c6c850d4d7b0cea87bd86eaa5d636, https://si.imgix.net/86c07df0/uploads/origins/52c15512-9b16-445e-8af6-39cbc1a9d612?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f88fcbc896e1145fbd783a760e3a5f0e 2x, https://si.imgix.net/86c07df0/uploads/origins/52c15512-9b16-445e-8af6-39cbc1a9d612?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=557cc545dae73ac8ed351f5498f1420a 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 22638, "nc": 177}, {"path": "/@laikaloid/works/7", "private_thumbnail_image_urls": null, "private