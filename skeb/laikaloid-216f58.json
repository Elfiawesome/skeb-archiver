子さん、佐藤さん、吹田歌穂さん）の、履歴書に貼ってあるような正面顔（無帽で無表情、肩から上の顔写真）です。\n\n髪型や服装はおまかせします。変な依頼ですみませんが、彼女たちの日常を垣間見たく、ご検討のほどよろしくお願い申し上げます。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@laikaloid/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/20da6430/uploads/origins/3983f875-98ad-47a9-94e5-d57e25b8dd9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6efdb793d263ef23e5d3d55adfaf4cc8", "srcset": "https://si.imgix.net/20da6430/uploads/origins/3983f875-98ad-47a9-94e5-d57e25b8dd9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6efdb793d263ef23e5d3d55adfaf4cc8, https://si.imgix.net/20da6430/uploads/origins/3983f875-98ad-47a9-94e5-d57e25b8dd9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a456b7b7560e46f7d69736955b11ed1 2x, https://si.imgix.net/20da6430/uploads/origins/3983f875-98ad-47a9-94e5-d57e25b8dd9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c772470956fcae4d6822267385a49714 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 22638, "nc": 48}, {"path": "/@laikaloid/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 22638, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9bebe427/uploads/origins/f5280851-cabb-42f2-896d-fc884e40c43d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e24b2320e3a22e49049f59995e72e59d", "srcset": "https://si.imgix.net/9bebe427/uploads/origins/f5280851-cabb-42f2-896d-fc884e40c43d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e24b2320e3a22e49049f59995e72e59d, https://si.imgix.net/9bebe427/uploads/origins/f5280851-cabb-42f2-896d-fc884e40c43d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfd2755b870786868e3a1a20eed543b0 2x, https://si.imgix.net/9bebe427/uploads/origins/f5280851-cabb-42f2-896d-fc884e40c43d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b734b9bf549b2592bb28c7a8762fe7a8 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9bebe427/uploads/origins/f5280851-cabb-42f2-896d-fc884e40c43d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a64a9f043c655329c3420223b61ec55", "srcset": "https://si.imgix.net/9bebe427/uploads/origins/f5280851-cabb-42f2-896d-fc884e40c43d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a64a9f043c655329c3420223b61ec55, https://si.imgix.net/9bebe427/uploads/origins/f5280851-cabb-42f2-896d-fc884e40c43d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=96fe1ab6dc9d11432ab0f84bd6d01ff3 2x, https://si.imgix.net/9bebe427/uploads/origins/f5280851-cabb-42f2-896d-fc884e40c43d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ccefc1a111e459273626b442b20a6d0e 3x"}, "body": "https://www.pixiv.net/artworks/78738871\nこちらのリクルートスーツの女の子を、\nhttps://okkisokuho.com/wp-content/picture/2014/141221/c/141221c_as007.jpg\n↑こんな感じの体位、構図で着衣大量中出しセックス。\nスーツのスカート、下着（レース系のやや大人っぽい感じ、参考資料に寄せる）は片足に引っかかっていて、スーツのジャケット＆シャツは着たままはだけ、ブラが上にずらされて両胸露出。カップはC～D（巨乳ではないが、ちゃんとあるくらい。乳首乳輪は小さ目で色は淡いピンク）で、男の手が片乳を乱暴に揉み、男のもう片方の手がスマートフォンを持って自分たちの姿をインカメラでハメ撮り（自撮り）しているような図で（参照絵では女の子がケータイを持っているが変更。女の子の両手は後ろ手に組んでいるような形）。服がはだけた結果、ヘソやお腹周りのエロい曲線はある程度見える感じに。陰毛はやや濃いめhttps://www.pixiv.net/artworks/85521814。傍らに鞄や、挿入前に散々使った大人のおもちゃ（愛液に濡れたディルドやローター）が打ち捨てられている。\n\n表情は参照絵に寄せて、苦しそうなハの字眉で舌を出しながら盛大にイカされている感じ（シチュとしては、就活を始めたばかりの彼女が、就活にことごとく失敗した年上彼氏、でも経験豊富でセックスは上手い、に八つ当たり的に乱暴に攻められる的な。場所は彼氏のワンルームのベッド）。\n\n差分として、\n\n子宮に中出しされた断面図\n彼氏がハメ撮りしているスマートフォンの映像\n\nを、別アングルで描きこんでいただきつつ、\n\n漫画表現（挿入＆中出し、喘ぎ声の擬音やイッたことを示す効果線など）\n表情違い（目の焦点が合っていないhttps://www.pixiv.net/artworks/77203464このくらいのソフトアへ顔）\n\nのバージョンも、アリナシでお願いできないでしょうか。\n注文が細かく、多くて申し訳ありませんが、以前描かれていた絵がとても素敵だったので、なにとぞお願い申し上げます。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@laikaloid/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 22638, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c5d5e20/uploads/origins/1abb43d7-4af7-4d93-8eef-4f4c112cacb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d0e9214556c0d07a1be964a156e6cf7", "srcset": "https://si.imgix.net/7c5d5e20/uploads/origins/1abb43d7-4af7-4d93-8eef-4f4c112cacb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d0e9214556c0d07a1be964a156e6cf7, https://si.imgix.net/7c5d5e20/uploads/origins/1abb43d7-4af7-4d93-8eef-4f4c112cacb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=351c9dc069e783057fac641ed6de5a0c 2x, https://si.imgix.net/7c5d5e20/uploads/origins/1abb43d7-4af7-4d93-8eef-4f4c112cacb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fa11515fbbb1d08f704f69980cf5770 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c5d5e20/uploads/origins/1abb43d7-4af7-4d93-8eef-4f4c112cacb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=619ce3b71ff2a942b222ce5188f56690", "srcset": "https://si.imgix.net/7c5d5e20/uploads/origins/1abb43d7-4af7-4d93-8eef-4f4c112cacb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=619ce3b71ff2a942b222ce5188f56690, https://si.imgix.net/7c5d5e20/uploads/or