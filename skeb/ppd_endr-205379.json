p=top&w=200&h=200&blur=200&s=79a9e383f1e01fff5ee7e98fa825085e 2x, https://si.imgix.net/1b01c954/uploads/origins/d5fb05ec-b9d8-47ba-b39a-b8cd65c55c57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=17d88a63e0239f4f1b9ff7865828837c 3x"}, "body": "おとのさんの描かれるイラストの、きれいな色使いとキャラクターたちの愛らしさが大好きです💖(*´▽｀*)\nSkebの受付をされているとのことで、今回初めてリクエストを送らせていただきました🌷\n\n▼リクエスト内容\nオリジナル作品『Pour vous, Pour over』のキャラクターを描いていただきたいです。\n春のやわらかな陽射しの中、花畑でフェリクスがアルセイドの髪をアレンジしつつ、結んであげているシチュエーションのイラストをお願いしたいです。\n構図・服装・表情などは、すべておまかせいたします。\n\n▼使用用途\n個人的な鑑賞に使用させていただきます。\n\n▼キャラクター参考資料\nhttps://pvpo-maboba.cheap.jp/maboba/skeb_irai/\n\nご検討いただけますと幸いです🌸", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ppd_endr/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2585482, "client_id": 3228362, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59abd56d/uploads/origins/bde8cdd3-13e7-4e49-bba9-f15152583c92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71859e87b30f869d8de950d375aec002", "srcset": "https://si.imgix.net/59abd56d/uploads/origins/bde8cdd3-13e7-4e49-bba9-f15152583c92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71859e87b30f869d8de950d375aec002, https://si.imgix.net/59abd56d/uploads/origins/bde8cdd3-13e7-4e49-bba9-f15152583c92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99e65362d5c46ad13377eb6028239ed4 2x, https://si.imgix.net/59abd56d/uploads/origins/bde8cdd3-13e7-4e49-bba9-f15152583c92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10214c962046cde933b46fefaacd177d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59abd56d/uploads/origins/bde8cdd3-13e7-4e49-bba9-f15152583c92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=281944db4b3cbf1c174d4bc21608b4b7", "srcset": "https://si.imgix.net/59abd56d/uploads/origins/bde8cdd3-13e7-4e49-bba9-f15152583c92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=281944db4b3cbf1c174d4bc21608b4b7, https://si.imgix.net/59abd56d/uploads/origins/bde8cdd3-13e7-4e49-bba9-f15152583c92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4bf67752ed219aced4bca0f65f9cb5c8 2x, https://si.imgix.net/59abd56d/uploads/origins/bde8cdd3-13e7-4e49-bba9-f15152583c92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b96529a4f3120c0308aac7d70c34f9e4 3x"}, "body": "おとの先生、こんにちは。いつも楽しくイラストや漫画拝見しております🍎✨\n\nおとの先生の描くほんわりかわいらしいイラストが大好きなので、ぜひSNSのアイコン用イラストを描いていただけたらと思いリクエストを送らせていただきました。\n\n前髪ありボブヘアで、左目尻にホクロがある女の子を描いていただけないでしょうか。\nその他細かい部分やポーズなどはお任せいたします。\n先生のお好みな雰囲気で仕上げていただければ嬉しいです！\n\nご検討のほど、よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ppd_endr/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2585482, "client_id": 3125309, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b3ac660/uploads/origins/155fc445-c378-44e0-a733-350e53b5bf0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d086ff0218347ed83cadfa7338a76b0", "srcset": "https://si.imgix.net/2b3ac660/uploads/origins/155fc445-c378-44e0-a733-350e53b5bf0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d086ff0218347ed83cadfa7338a76b0, https://si.imgix.net/2b3ac660/uploads/origins/155fc445-c378-44e0-a733-350e53b5bf0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4e40bb7d04af3c1e429e1fbd62f4186 2x, https://si.imgix.net/2b3ac660/uploads/origins/155fc445-c378-44e0-a733-350e53b5bf0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f89f71cec56661a192bde06a83bc6d49 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b3ac660/uploads/origins/155fc445-c378-44e0-a733-350e53b5bf0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=635db8934969a14ef3109b221b0eef8b", "srcset": "https://si.imgix.net/2b3ac660/uploads/origins/155fc445-c378-44e0-a733-350e53b5bf0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=635db8934969a14ef3109b221b0eef8b, https://si.imgix.net/2b3ac660/uploads/origins/155fc445-c378-44e0-a733-350e53b5bf0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6f9c8e1cf52afd814667e34cfc23488b 2x, https://si.imgix.net/2b3ac660/uploads/origins/155fc445-c378-44e0-a733-350e53b5bf0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4b858c15c849256e14e96d5f698fab7 3x"}, "body": "おとの先生。\n初めまして、先日のサイン本企画から先生の作品を拝見しており、2人が可愛くて癒されております。\n差し支えなければ、オリジナルキャラクターの2人を描いていただきたいと思い、ご依頼失礼します。\n\n■キャラクター詳細\n・飛鳥（日向飛鳥）：緑髪。27歳。187cm。医者。サバサバした性格で面倒ごとが嫌い。自分と他人に厳しいが眞尋にはやや甘い。\n\n・眞尋（神崎／日向眞尋）：黒髪。17歳。173cm。高校生。優しくて気弱な性格。日向家に引き取られた当時から優しくしてもらったこともあり飛鳥のことを尊敬している。常に敬語で話す。飛鳥に対して並々ならぬ恋愛感情もある。\n\n可能であれば漫画調のモノクロイラストだと嬉しいです。\nまた、飛鳥が眞尋になにか食べさせているような…若干距離が近めなシチュエーションだと嬉しいです。\n\nポーズや構図、服装などはお任せいたします。\n兄弟（義理）ですが、お互い好き同士(眞尋の方が重め)なのでやや距離が近めです。\n\n描いていただいたイラストは個人的鑑賞、アイコンやヘッダーへ使用させて頂く場合があります。\n\n■資料\nhttps://drive.google.com/drive/folders/1MfY2ia9k65-6RFV3lm58FmQCfCbN4czL?usp=sharing\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1MfY2ia9k65-6RFV3lm58FmQCfCbN4czL?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ppd_endr/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2585482, "client_id": 330221, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de571070/uploads/origins/41bfba33-c8a