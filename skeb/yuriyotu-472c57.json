d05cf5/uploads/origins/a4d33de3-fa4b-4242-be54-d5043db63283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a9ce4cda879587e7f07839538a0bfed, https://si.imgix.net/e5d05cf5/uploads/origins/a4d33de3-fa4b-4242-be54-d5043db63283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fc3765efed8d002df94294c890735452 2x, https://si.imgix.net/e5d05cf5/uploads/origins/a4d33de3-fa4b-4242-be54-d5043db63283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=beaf59d59bcd6962af7787ef63357864 3x"}, "body": "ゆりよつさん、こんにちは。私はあなたの画風が大好きです。私のオリジナルキャラクター、メリーを描いてもらえるとうれしいです。\n\n彼女は魔法と引き換えに声を売った魔女です。女にも男にも変身できます。女の子でお願いします。上品で優しくて、ずる賢い。目はいつも閉じています。髪の長い部分はウサギの耳のようなイメージです。イヤリングは何でもいいです。服装は用意されているものでも、ダークアカデミアのようなものでもOKです。\n\n提灯のモチーフ(https://sta.sh/01auv3ojzaku)も入れていただけると嬉しいですが、なくても大丈夫です。自由に描いてください\n\nhttps://sta.sh/21x8yfa5b17s?edit=1", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yuriyotu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2272044, "client_id": 1338889, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be03e662/uploads/origins/96d5b778-1952-4173-b8fc-00795794a38a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a6e94ad92215104d941bae62642b17d", "srcset": "https://si.imgix.net/be03e662/uploads/origins/96d5b778-1952-4173-b8fc-00795794a38a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a6e94ad92215104d941bae62642b17d, https://si.imgix.net/be03e662/uploads/origins/96d5b778-1952-4173-b8fc-00795794a38a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0cd4f2a5417649a7b1a25876754a0e3a 2x, https://si.imgix.net/be03e662/uploads/origins/96d5b778-1952-4173-b8fc-00795794a38a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75bf613a4f837795cd281717694b53c2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be03e662/uploads/origins/96d5b778-1952-4173-b8fc-00795794a38a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dea2796ca215dd2884902a501ebc9e0", "srcset": "https://si.imgix.net/be03e662/uploads/origins/96d5b778-1952-4173-b8fc-00795794a38a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dea2796ca215dd2884902a501ebc9e0, https://si.imgix.net/be03e662/uploads/origins/96d5b778-1952-4173-b8fc-00795794a38a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=375e8af084642fe8dcc04d5f25e423ec 2x, https://si.imgix.net/be03e662/uploads/origins/96d5b778-1952-4173-b8fc-00795794a38a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f56239660897aecd1aabaf3a373fb945 3x"}, "body": "こんにちは、私はあなたの絵が好きですアークナイツのシュヴァルツとサリアの絵を依頼したいのですが、シュヴァルツはスカイライン・レイシアン・ストライカー、サリアはストロングホールド・ブラッドライン・オブ・コンバットのスキンでお願いします。\nシュヴァルツはスカイライン・レイシアン・ストライカーのスキン、サリアはストロングホールド・ブラッドライン・オブ・コンバットのスキンで、できれば両方ともウエストアップでお願いしたいです。\n\nあとはポーズや表情はお任せしますが、躍動感のあるものを希望します。\n\nこの度はありがとうございました。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yuriyotu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2272044, "client_id": 1614354, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29066ec3/uploads/origins/0fcafba1-145d-434f-a6d6-e2e2ef435f54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79f00dd48f55671f6cf51025c512e68c", "srcset": "https://si.imgix.net/29066ec3/uploads/origins/0fcafba1-145d-434f-a6d6-e2e2ef435f54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79f00dd48f55671f6cf51025c512e68c, https://si.imgix.net/29066ec3/uploads/origins/0fcafba1-145d-434f-a6d6-e2e2