/KanataDomeki/status/1663177171886833665\n\n【イラストサイズ、ファイル形式】\n可能であればPSD形式でいただきたいです。\nキャラクターのみで使用する場合がございますので、背景等と分けていただけると嬉しいです。\n\nご検討よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BANBANJIIIIIII/works/532", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 764052, "client_id": 2410184, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/508fe333/uploads/origins/ce4cf975-5334-4962-bbce-8aac068264ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72a97535aeb1865fb947df569c26e49b", "srcset": "https://si.imgix.net/508fe333/uploads/origins/ce4cf975-5334-4962-bbce-8aac068264ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72a97535aeb1865fb947df569c26e49b, https://si.imgix.net/508fe333/uploads/origins/ce4cf975-5334-4962-bbce-8aac068264ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=755c7727089200403be7d6791190a6ba 2x, https://si.imgix.net/508fe333/uploads/origins/ce4cf975-5334-4962-bbce-8aac068264ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37abdf36999f9dd933999b2f2619a3b5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/508fe333/uploads/origins/ce4cf975-5334-4962-bbce-8aac068264ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ccf398b4f5373c696bbe5bfc1a4e10a", "srcset": "https://si.imgix.net/508fe333/uploads/origins/ce4cf975-5334-4962-bbce-8aac068264ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ccf398b4f5373c696bbe5bfc1a4e10a, https://si.imgix.net/508fe333/uploads/origins/ce4cf975-5334-4962-bbce-8aac068264ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=69b1749de8063cf408c2aa43472716a7 2x, https://si.imgix.net/508fe333/upl