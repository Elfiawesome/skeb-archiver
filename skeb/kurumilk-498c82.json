-4af8-b2fe-7b9e23b72a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70811aabd3cfe259898460d0367f541b 2x, https://si.imgix.net/852d31c4/uploads/origins/e5442294-baf9-4af8-b2fe-7b9e23b72a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89c849dcb99f4cafdcdff986acd15c93 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/852d31c4/uploads/origins/e5442294-baf9-4af8-b2fe-7b9e23b72a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09da34ff24e4a691146a1c53f942cace", "srcset": "https://si.imgix.net/852d31c4/uploads/origins/e5442294-baf9-4af8-b2fe-7b9e23b72a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09da34ff24e4a691146a1c53f942cace, https://si.imgix.net/852d31c4/uploads/origins/e5442294-baf9-4af8-b2fe-7b9e23b72a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b78f581d46534e3506bfd239e6f76956 2x, https://si.imgix.net/852d31c4/uploads/origins/e5442294-baf9-4af8-b2fe-7b9e23b72a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7f2426a0e0c796458fd524c4b934d83a 3x"}, "body": "・キャラクター\n\nチト＆ユーリ（少女終末旅行）＆ティッピー（ご注文はうさぎですか？）\n\n・シチュエーション\n\nチトの頭にティッピーをバランスよく乗せる遊びをしているユーリ\n\n・絵のタッチ\n\n健全絵用のタッチ\n\n・衣装と髪型\n\nチトとユーリはhttps://www.pixiv.net/artworks/80238626 と同じ。ヘルメットは被せないで下さい\nティッピーは資料１：https://gochiusa.com/chara/tippy.html と同じ\n\n・ポーズ、顔向き、視線\n\nチト：前を向いている。顔向きと視線も前に向けている\nティッピー：チトの頭の上に乗っている。顔向きと視線は前に向けている\nユーリ：チトの後ろで、ティッピーの方に顔と視線を向けながら、チトの頭の上にティッピーを乗せた後、ティッピーが落ちないようゆっくりと両手を放しているポーズ\n\n・見え方\n\n１．チトはhttps://x.com/nekokawaii_milk/status/1828432500231938239 のように、真正面向きよりもやや向かって左側を向いている。\n２．ユーリの顔や胴体は、チトの顔の中央よりも向かって右側に見える\n３．ユーリの顔が、チトやティッピーによって隠れない\n４．チトとユーリは、少なくとも胸元から上はキャンバスから見切れずに見える。胸元より下は、見切れてたり途中で消えてたりしても構いません\n５．ティッピーは全身がキャンバスから見切れない\n\n・表情\n\nチト：両目を開け口を閉じたすまし顔\nユーリ：両目と口を開け、チトの頭にティッピーがバランスよく乗って「おお…いい感じ」という感じに嬉しそうにしている顔\nティッピー：資料１と同じ\n\n・セリフ\n\nユーリ：ねぇちーちゃん、「かふぇらてかふぇもかかぷちーの！」って言ってみて？\nチト：　や　だ　\n\nという二人のセリフを、しっぽの付いた吹き出し付きのセリフとして収録して下さい。また、このセリフは表示/非表示が切り替えられるようにして下さい。\n\n・背景\n\n単色以外のものでお任せします。シンプルな模様とかでも構いません\n\n・納品時のデータ形式\n\n短辺2160px以上、長辺3840px以上の、主要なコンポーネントの表示/非表示が切り替えられるPSDファイル\n\n指定が細かい上に数も多くて恐縮ですが、ご検討をお願いします", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurumilk/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3364082, "client_id": 1992605, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2090fe1e/uploads/origins/a07d55e9-5392-4728-bec2-3ec8845bcd1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=135c884ca298ce9c3ff6c7fef1d42142", "srcset": "https://si.imgix.net/2090fe1e/uploads/origins/a07d55e9-5392-4728-bec2-3ec8845bcd1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=135c884ca298ce9c3ff6c7fef1d42142, https://si.imgix.net/2090fe1e/uploads/origins/a07d55e9-5392-4728-bec2-3ec8845bcd1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7234e6d8e62654b3a18101143136c834 2x, https://si.imgix.net/2090fe1e/uploads/origins/a07d55e9-5392-4728-bec2-3ec8845bcd1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33c2830d551fda2d61831e759e1fa647 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2090fe1e/uploads/origins/a07d55e9-5392-4728-bec2-3ec8845bcd1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=166b529c35b310604c6e36da758192f3", "srcset": "https://si.imgix.net/2090fe1e/uploads/origins/a07d55e9-5392-4728-bec2-3ec8845bcd1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=166b529c35b310604c6e36da758192f3, https://si.imgix.net/2090fe1e/uploads/origins/a07d55e9-5392-4728-bec2-3ec8845bcd1c