た幸せそうな感じでお願いします。\n\n要望が多いですが、ご検討宜しくお願い致します。\n\n参考URL\nhttps://www.tbs.co.jp/anime/kanon/04chara/makoto.html\nhttps://www.nicovideo.jp/watch/sm4933116\nhttps://www.nicovideo.jp/watch/sm12330014\n\nドライブ(画像3枚)\n\nhttps://drive.google.com/drive/folders/1ptD8e30Hro59FtuMEnHkzenAkGDU26fq?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hurumero_ha_R/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 350912, "client_id": 536588, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/432bb90b/uploads/origins/d4387809-5a6a-4068-ad0f-4be8bd8300b4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=06d065acbb7997b213757c636e3243fb", "srcset": "https://si.imgix.net/432bb90b/uploads/origins/d4387809-5a6a-4068-ad0f-4be8bd8300b4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=06d065acbb7997b213757c636e3243fb, https://si.imgix.net/432bb90b/uploads/origins/d4387809-5a6a-4068-ad0f-4be8bd8300b4?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=536e869bc6846b97d121f91236753214 2x, https://si.imgix.net/432bb90b/uploads/origins/d4387809-5a6a-4068-ad0f-4be8bd8300b4?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=99702e046e566a54ba4fa3629069d741 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/432bb90b/uploads/origins/d4387809-5a6a-4068-ad0f-4be8bd8300b4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=735cf48c0dcc4bb02c5e86ec1d53f2ff", "srcset": "https://si.imgix.net/432bb90b/uploads/origins/d4387809-5a6a-4068-ad0f-4be8bd8300b4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=735cf48c0dcc4bb02c5e86ec1d53f2ff, https://si.imgix.net/432bb90b/uploads/origins/d4387809-5a6a-4068-ad0f-4be8bd8300b4?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&bl