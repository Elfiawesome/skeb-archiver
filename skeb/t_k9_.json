ス好き設定があるので、オムライスを皿ごと運んでいるような感じが欲しいです\n・頭装備のヴェーがエプロンと相性が悪い場合、レースっぽい黒いシュシュで髪の毛を纏めている感じしていただけると嬉しいです\n・ポージング等に指定はありませんが、猫背のまま浮遊して移動する設定があるため、その状態で可愛い感じにしてもえると嬉しいです。\n\nよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@t_k9_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3106287, "client_id": 381261, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dffafbaf/uploads/origins/2d9360cc-4f8e-41e3-afd8-ff4e84c15c45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d22b08bbf5358f610fc1b67de82e34c", "srcset": "https://si.imgix.net/dffafbaf/uploads/origins/2d9360cc-4f8e-41e3-afd8-ff4e84c15c45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d22b08bbf5358f610fc1b67de82e34c, https://si.imgix.net/dffafbaf/uploads/origins/2d9360cc-4f8e-41e3-afd8-ff4e84c15c45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3217bc166dc71738c765cf0093cae417 2x, https://si.imgix.net/dffafbaf/uploads/origins/2d9360cc-4f8e-41e3-afd8-ff4e84c15c45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=921ee10929db0e187e87e42554f1c4bb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dffafbaf/uploads/origins/2d9360cc-4f8e-41e3-afd8-ff4e84c15c45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0534a0a18aab1dcaccf74dc665d54e55", "srcset": "https://si.imgix.net/dffafbaf/uploads/origins/2d9360cc-4f8e-41e3-afd8-ff4e84c15c45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0534a0a18aab1dcaccf74dc665d54e55, https://si.imgix.net/dffafbaf/uploads/origins/2d9360cc-4f8e-41e3-afd8-ff4e84c15c45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=59585f039d76037fdb1493c32a906d49 2x, https://si.imgix.