ve.google.com/drive/folders/1uLwAmOkatXja0_NX9C-LD6lbK8utptyC\n【参考資料】\nhttps://drive.google.com/drive/folders/1ek6-LU0NEZY8Kj0VOEe_a5Zhu81nOE_X\n\nTikTok https://www.tiktok.com/@vtuber988?_t=ZS-8ww6kqFObod&_r=1\n\n\n【イメージ】\n白リボンとばってん、首と左足のボディステッチがチャームポイントです。\nイメージカラーはメインがボルドーっぽい深い赤色「ac1d38」と、サブカラーが紫っぽい紺色「504d75」です。\n口を開けて笑った時に両八重歯が見えます。\n足の触手は無くしていただきたいです。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1uLwAmOkatXja0_NX9C-LD6lbK8utptyC", "nc": 145, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@kouseki1102/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1241249, "client_id": 3504615, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ddf7a4fd/uploads/origins/64331363-0d42-4fd5-9fcf-eeb1abdaf775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e38294e5e7a5951fe80e9a7206a802c", "srcset": "https://si.imgix.net/ddf7a4fd/uploads/origins/64331363-0d42-4fd5-9fcf-eeb1abdaf775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e38294e5e7a5951fe80e9a7206a802c, https://si.imgix.net/ddf7a4fd/uploads/origins/64331363-0d42-4fd5-9fcf-eeb1abdaf775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67bcdbfe815ace2abb58efaed68a2c0d 2x, https://si.imgix.net/ddf7a4fd/uploads/origins/64331363-0d42-4fd5-9fcf-eeb1abdaf775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af4a286bcb806192d78d04b100d102a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ddf7a4fd/uploads/origins/64331363-0d42-4fd5-9fcf-eeb1abdaf775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e27ad91c440307c1fae8847e59832f0", "srcset": "https://si.imgix.net/ddf7a4fd/uploads/origins/64331363-0d42-4fd5-9fcf-eeb1abdaf775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=to