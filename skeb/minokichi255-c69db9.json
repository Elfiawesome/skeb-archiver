ress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48ffd50242aaa93b819940ef09520be8", "srcset": "https://si.imgix.net/33466906/uploads/origins/3d701cde-f3c2-4904-88d1-41b0f9959296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48ffd50242aaa93b819940ef09520be8, https://si.imgix.net/33466906/uploads/origins/3d701cde-f3c2-4904-88d1-41b0f9959296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e033caa38686aabbceb36e4871e242e 2x, https://si.imgix.net/33466906/uploads/origins/3d701cde-f3c2-4904-88d1-41b0f9959296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45d02618128735a3e5978f49f8fab2a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33466906/uploads/origins/3d701cde-f3c2-4904-88d1-41b0f9959296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38c875f80d3f84a8aa02ba50882355b7", "srcset": "https://si.imgix.net/33466906/uploads/origins/3d701cde-f3c2-4904-88d1-41b0f9959296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38c875f80d3f84a8aa02ba50882355b7, https://si.imgix.net/33466906/uploads/origins/3d701cde-f3c2-4904-88d1-41b0f9959296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8db9e9417e26735e2a6ad6d6d83fbcde 2x, https://si.imgix.net/33466906/uploads/origins/3d701cde-f3c2-4904-88d1-41b0f9959296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=57641924b5b19bcccef20538cfa66d1e 3x"}, "body": "失礼します\nいつもヴァンパイア等のイラスト楽しみにさせていただいております\nこの度イラストを描いていただきたく依頼を送らせていただきます\n\n自作小説に登場するウチの子「チヨ」のイラストを描いていただきたいです\n\n設定等\n狐の擬人化\n・漢字表記は「千代」\n・身長160センチくらい\n・体重50キロちょっと\n・年齢　200歳くらいだと思う（本人曰く黒船を見たような記憶が…）\n（見た目は20代前半ほど）\n・常に微笑\n・頭部にキツネのような耳\n・大きくてモフモフとした狐の尾\n・明るいライムグリーンの瞳　ちょいつり目気味\n・陶器のように白い肌\n・美乳（結構大きい)\n・透けるような銀髪　腰くらいまでの長髪\n・前髪で右目が隠れている\n・後ろ髪は太い三つ編みにして背中側に垂らしている\n・人前に出る時は尻尾と耳を見えなくする事が可能　その場合は黒髪になる\n・足元はレディース用のサンダル\n・白系のブラウス\n・ゆったりとしたリボンパンツ\n・好物は大学イモ　お酒好き\n・職業：神社へ続く階段の傍にある駄菓子屋の経営者（あんまり流行ってない）\n・美人だけどいまいち捉えどころがない　茶目っ気たっぷり\n資料はこちらのURLを参照ください\n（https://i.imgur.com/xzscvII.jpg）\n（https://i.imgur.com/qOmYwZi.jpg)\n（https://i.imgur.com/I2mE2xR.jpg)\n（https://i.imgur.com/FIaEPJd.jpg）\n（https://i.imgur.com/LPO3e19.jpeg)\n（https://i.imgur.com/RQKkCCU.jpeg）\n\nポーズや構図は自由に決めていただいて結構です\nいつもヴァンパイア関連のイラストにあるような怪しげな魅力と美しさを感じられるようなポーズや構図だと嬉しいです\n\n以上となります\n是非ご一考ください", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 101052, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ミツキ", "screen_name": "happy100012", "avatar_url": "https://pbs.twimg.com/profile_images/1871958295537397761/m_qXmrXU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/785440052524441600/1714138483/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 2143723, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "KURO🐾", "screen_name": "KUROSUKEnekocha", "avatar_url": "https://pbs.twimg.com/profile_images/1680819790175150080/BLzP2kR4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1336595164370898944/1674709323/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 2480395, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "まれ", "screen_name": "mare_ma_", "avatar_url": "https://pbs.twimg.com/profile_images/1798382117484953600/Fi0zmVwK.jpg", "header_u