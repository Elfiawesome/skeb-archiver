f29/uploads/origins/7e35eacf-bd67-4cf8-a764-f63b3e4f5565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c74bffa2ff111185cdf600dec4c44d8f 2x, https://si.imgix.net/c7a4cf29/uploads/origins/7e35eacf-bd67-4cf8-a764-f63b3e4f5565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=37ef9ffa040a05159f0d785f7153628d 3x"}, "body": "こんにちは！\n\nアリソンを気に入っていただけて嬉しいです！彼女を自由に描いてください。できれば、これらの絵のようなスタイルで彼女を描いていただけませんか？\n\nhttps://skeb.jp/@stellar_wayss/works/16\nhttps://skeb.jp/@stellar_wayss/works/15\n\n可能であれば、アリソンをこのようなポーズで、心配そうな表情で描いてほしいです。https://imgur.com/a/eqaKH62\n\nありがとうございました！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukihina/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2555277, "client_id": 1825989, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20ef6624/uploads/origins/2788d8bb-7c20-4419-94e6-91e067634c63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5466d5459b7b8e9f1c048c76366c9789", "srcset": "https://si.imgix.net/20ef6624/uploads/origins/2788d8bb-7c20-4419-94e6-91e067634c63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5466d5459b7b8e9f1c048c76366c9789, https://si.imgix.net/20ef6624/uploads/origins/2788d8bb-7c20-4419-94e6-91e067634c63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82cdfedb572cc8c282ffedd90dbe7141 2x, https://si.imgix.net/20ef6624/uploads/origins/2788d8bb-7c20-4419-94e6-91e067634c63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=baa5568c96515195cf0a549fe88694ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20ef6624/uploads/origins/2788d8bb-7c20-4419-94e6-91e067634c63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ddc907e57a6a90850eaeb3141969480", "srcset": "https://si.imgix.net/20ef6624/uploads/origins/2788d8bb-7c20-4419-94e6-91e067634c63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ddc907e57a6a90850eaeb3141969480, https://si.imgix.net/20ef6624/uploads/origins/2788d8bb-7c20-4419-94e6-91e067634c63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a2bb97266a805d60560b294df37f13ad 2x, https://si.imgix.net/20ef6624/uploads/origins/2788d8bb-7c20-4419-94e6-91e067634c63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=29a3b8fced7911e40f88c2c54baa7b22 3x"}, "body": "再びこんにちは！\nまたまたリクエストさせていただきます。\n前回の依頼のブーストメッセージに書いたキャラクターの参考資料が最近完成しました！\nもしご興味があれば、ぜひ最初に描いていただけると嬉しいです。\n\n私のOC \"Goro Blaine \"を描いてください。\n簡単に簡略化した参考資料：https://imgur.com/a/blaine-brief-references-notes-zt0CFXy\nGoogle Driveのフォルダーにもっと多くの参考資料を添付します。\n\n[キャラクター］\n- ブレインとは、私の物語／プロジェクト「リキッドハート」に登場するキャラクターで、現代の犯罪多発都市を舞台に、非人間的なキャラクター／種族が社会の一部として登場します。\n- ブレインには悲劇的な過去があり、父親への復讐の道を歩んでいる。\n- 彼女はこの設定では \"ライカン \"と呼ばれる種族で、オオカミの耳と尻尾の発現を切り替えられるウルフガールである。彼女のライカン種はオオカミとハイエナのミックスである。\n- ブレインはとても乱暴で、トラブルを起こすのが好きで、自分が劣っていると思う相手と喧嘩や口論をするのが好きだ。\n- しばしば鼻につく不良のような態度をとるが、彼女はかなり気楽で単純な人間で、他の何よりも自分が楽しむことを大切にしている。そのため、また彼女自身の自滅的な傾向もあって、金銭面ではかなり軽薄で、もっと面白い経験をするために任務の目的をあきらめることもある。\n- ブレーンは非常に才能のあるドライバーで、彼女のお気に入りの活動のひとつはストリートレースであり、カスタマイズした車に大金を費やすことも多い。\n- 彼女は \"ライカン \"であるため、敏捷性とスピードが非常に高く、体力もある程度向上しているため、近接戦闘や爪で人を引っ掻いて戦うことが多い。\n- 酒を飲むのが好きだが、あまり上手くは飲めない。\n\n外見\n- ターコイズブルーとエメラルドグリーンの髪に、明るいグリーンの瞳。\n- ブレーンの髪の形は、丸いというより角ばったストレート。\n- マスカラをしっかり塗り、まつ毛も濃い。\n- 赤いクロップトップシャツの上に黒いファー付きの白いクロップドコートを着ている。\n- 黒いショートパンツにハイウエストの下着がサイドから上に出ている。\n- 露出度の高い腹部と緑色のタトゥー。\n- 引き締まったお腹。\n- 黒いベルトのチョーカーと2本の太もものストラップ。\n- 黒のレースアップロングブーツ。\n- 指なし手袋と鋭く黒い爪。\n- 鋭く大きな犬歯。\n\n以上がブレインについての簡単な説明だ！\n少しでも理解の助けになれば幸いです。\nブレインの髪型を描くのは難しいかもしれないけど、できることをやってくれればいいよ。\nリクエストを楽しんでもらえると嬉しいです！\nご検討ありがとうございました。\n翻訳が下手で申し訳ありません。ブレインが嫌な人に思われなければいいのですが...。彼女は粗削りですが、良い友人です。\n\nOC: https://drive.google.com/drive/folders/1g2kTv62zFDx_PQXlfmBvnnfdW95hCOYE?usp=sharing\n\nhttps://drive.google.com/drive/folders/1g2kTv62zFDx_PQXlfmBvnnfdW95hCOYE?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukihina/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2555277, "client_id": 1825989, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28f3f503/uploads/origins/e84f58a9-42d9-4a0f-a2bf-0476242698ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=985b0900e28b4fec1b7da75715586a01", "srcset": "https://si.imgix.net/28f3f503/uploads/origins/e84f58a9-42d9-4a0f-a2bf-0476242698ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=985b0900e28b4fec1b7da75715586a01, https://si.imgix.net/28f3f503/uploads/origins/e84f58a9-42d9-4a0f-a2bf-0476242698ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=889f25b824c0be255dc02f15adbee357 2x, https://si.imgix.net/28f3f503/uploads/origins/e84f58a9-42d9-4a0f-a2bf-0476242698ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f48fe60ff3baa5b6b322056a5f7a90bb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28f3f503/uploads/origins/e84f58a9-42d9-4a0f-a2bf-0476242698ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00665e74363b8770c322676fea158954", "srcset": "https://si.imgix.net/28f3f503/uploads/origins/e84f58a9-42d9-4a0f-a2bf-0476242698ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00665e74363b8770c322676fea158954, https://si.imgix.net/28f3f503/uploads/origins/e84f58a9-42d9-4a0f-a2bf-0476242698ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cf667d1e52f61b06c5b81215d5bb5214 2x, https://si.imgix.net/28f3f503/uploads/origins/e84f58a9-42d9-4a0f-a2bf-0476242698ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=604122576d35b5fbebed7db98bb2b2ec 3x"}, "body": "こんにちは！\nまた会えて嬉しいよ！\n前に描いてくれた絵が本当に大好きなんだ！\nまた僕のOCを描いてくれないかな？\n今回は、僕が今まで誰にも描いてもらったことのないOCを描いてもらえたらと思っているんだ。\n普段使っているような、きちんとした詳細な参考資料が入ったgoogleドライブもセットアップしていないんだけど、その分、すべてが正確であることにあまり心配はしていないよ！\n彼女のデザインは比較的シンプルだから、心配しないで！\n\n私のOC \"Rook \"を描いてください。\nhttps://imgur.com/a/f7zdtMb\n\nRookは背が高くて強くてタフな女の子で、爬虫類やドラゴンのような特徴を持っています。\n普段は不機嫌で、色あせたような、威圧的で威嚇的な、あるいはとても軽薄で思いやりのない、まるで不良のように見えることで知られている。\nしかし、その冷たく無愛想な外見の裏には、実は優しい心と困っている人を守りたいという気持ちがある。\n生い立ちから自尊心が非常に低く、他人から孤立していたが、新しい友人のおかげで、もっとオープンになり、人とつながることを許し始めている。\n\nルックの目は琥珀色と黄色で、瞳孔が鋭い。\n左目には大きな傷が2つある。\n爬虫類のような、あるいはドラゴンのような特徴を持っているため、ルックの舌は青く、先が割れてフォーク状になっている。\nルックの黒髪は真ん中あたりで横に張り出し、下で細くなっている。とても重要なことに、彼女は髪の真ん中上部に「髪の取り入れ口」／「髪の通気口」も持っている。\nルックの頭の両側には角があり、それは前方に向けられ、そして少し上に向いている。\n\n彼女の服装は最初の画像に似ているはずだ。\n襟の立った大きな黒いジャケットを羽織り、袖はロールバックして前腕の半分を露出させている。\n手には指なしの手袋をしている。\n黒いジャケットの下には白いシャツを着ており、襟元が開いている。\nルックは白いシャツの襟にドッグタグをつけている。\nボトムスは黒のカーゴショーツ。\n最後に、茶色とベージュの編み上げロングブーツを履いている。\n\n戦うときは武器か腕力を使う。\nルックの武器はメイスと、腕につけている鋭角の重い丸い盾で、メイスを盾に刺し、組み合わせて斧にすることができる。\nメイスを盾に刺し、合体させて斧にすることもできる。\n\nこれがルックの大まかなコンセプトだ！\nもし絵を描くのが苦手だったり、細部を理解するのが苦手だったりしても、あまり気にしないでください！\n私は今、彼女の何かが欲しいだけなのです。\n\n楽しい経験になれば幸いです！\nよろしくお願いします！\n翻訳が下手で申し訳ありません！\n\nhttps://imgur.com/a/f7zdtMb", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukihina/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2555277, "client_id": 3430646, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e112d25/uploads/origins/1c42db37-8c18-4ad0-ba2f-706f9bc8683e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10ad7116e339fdd8e3caffd8fc583d66", "srcset": "https://si.imgix.net/6e112d25/uploads/origins/1c42db37-8c18-4ad0-ba2f-706f9bc8683e?bg=%23fff&a