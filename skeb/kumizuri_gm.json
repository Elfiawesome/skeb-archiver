b20-45d2-9c16-840af289e479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21692bf099b69e69755faad2e790b675, https://si.imgix.net/cc998dd9/uploads/origins/a1bbd273-0b20-45d2-9c16-840af289e479?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=480dabd425d2e75ff385683b9978cf12 2x, https://si.imgix.net/cc998dd9/uploads/origins/a1bbd273-0b20-45d2-9c16-840af289e479?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e890a4e0bae373cefe8bc0c9974863d6 3x"}, "body": "もう一つご依頼失礼します。\n下記資料のような感じの衣装を着た女の子をあなたの絵柄で描いて頂けますか？\n\n指定は衣装の大まかな形状とキャラが女の子であるという部分のみですので、\n中の女の子のデザインはそちらのお好きなように描いて頂く形となります。\n\n衣装につきましてはキャラの手先や足先までが衣装の長い袖や裾に包まれて見えないように描いて頂ければ、色変えや大きくアレンジしたり要素のオミットから付け足しなども何でも歓迎ですのでお好きなようにどうぞ。\n\nまた、手と脚全体を覆い隠すような幽霊っぽさもある衣装ではありますが、ステレオタイプの幽霊のように脚や下半身部分が先細りだったり消えているようには描かずにあくまで床まで引きずるような長い裾で隠れていて足が見えないという感じにお願いしたいです。\n\nそれから、以前送ったご依頼の指定と同文ですが\n絵柄としてはそちらにて描かれていらっしゃった日本一ソフトウェアの少女シリーズ(ホタルロゼハコニワボイテラ、絵本シリーズ、夜廻等)辺りのデフォルメ感で描いて頂きたいです、ただし口は省かないデザインでお願いします。\n\n可能であれば 裾に隠れたままの足の部分まで見えるように全身を描いて頂きたいです。\n\n構図やポーズ等はそちらにお任せします。\n\n参考資料↓\nhttps://imgur.com/a/BoRro2t", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumizuri_gm/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1494964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38fc4ddb/uploads/origins/16d99021-5d26-4f4a-bdcd-0a87adcf3587?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1351b80ce0c371e078242aba28514a8b", "srcset": "https://si.imgix.net/38fc4ddb/uploads/origins/16d99021-5d26-4f4a-bdcd-0a87adcf3587?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1351b80ce0c371e078242aba28514a8b, https://si.imgix.net/38fc4ddb/uploads/origins/16d99021-5d26-4f4a-bdcd-0a87adcf3587?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f73f4af0a18c1e341c0c0af9c5d3562d 2x, https://si.imgix.net/38fc4ddb/uploads/origins/16d99021-5d26-4f4a-bdcd-0a87adcf3587?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=817d55539eba124f03b4629b20acc5e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38fc4ddb/uploads/origins/16d99021-5d26-4f4a-bdcd-0a87adcf3587?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67ff87be20746cfc495f780de88ed69a", "srcset": "https://si.imgix.net/38fc4ddb/uploads/origins/16d99021-5d26-4f4a-bdcd-0a87adcf3587?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67ff87be20746cfc495f780de88ed69a, https://si.imgix.net/38fc4ddb/uploads/origins/16d99021-5d26-4f4a-bdcd-0a87adcf3587?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=67118a716beb79abe658bb61ea55665b 2x, https://si.imgix.net/38fc4ddb/uploads/origins/16d99021-5d26-4f4a-bdcd-0a87adcf3587?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=797430011e0f693bd4aeecca84781be4 3x"}, "body": "ご依頼失礼します。\n再度リクエストをお開き下さりありがとうございます。\n以前送ったものと同様の依頼ですが内容は多少見直してあります。\n\n下記資料のかたつむりな感じの衣装を着た女の子を描いてみて頂けますか？\n指定は着せる衣装のみですので、中の女の子のデザインはそちらにお任せする形となります、\n資料内には衣装だけでなくそれを着たキャラ自体の画像が複数含まれていますがそちらに寄せて描いたりはしなくて良いです。\n殻や触覚部分の色もそちらにお任せしますのでお好きな色でどうぞ。\n\n衣装についてもアレンジや要素の付け足し等も歓迎ですのでお好きなようにやって頂いて構いませんが、\n手は先端まで完全に覆われ、足も長い裾で完全に隠れるローブや着ぐるみっぽい服ですので 手や足先は衣装から露出させないようにお願いします。\n\nそれから、絵柄の幅がお広いようでいらっしゃるのでお伝えしておきたいのですが\nそちらにて描かれていらっしゃった日本一ソフトウェアの少女シリーズ(ホタルロゼハコニワボイテラ、絵本シリーズ、夜廻等)辺りのデフォルメ感で描いて頂きたいです、ただし口は省かないデザインでお願いします。\n\nここからは任意となりますが\n衣装の手先部分のデザインに関しては 先細りの先端が完全に閉じた形状と、ローブのようにたるみのある感じを両立した感じに描いて貰いたいです。\n衣装本体の資料とは別でその下に作例をご用意しましたのでこちらを参考にお使い頂ければ幸いです。\n\n構図やポーズ等はそちらにお任せしますが、裾で隠れたままの足の部分まで見えるように全身を描いて頂きたいです。\n\n参考資料(衣装本体資料)↓\nhttps://imgur.com/a/qmGUT0v\n\n参考資料↓(衣装の手先部分作例資料)\nhttps://imgur.com/a/pgwjiMN", "nc": 144, "word_count": 0, "tr