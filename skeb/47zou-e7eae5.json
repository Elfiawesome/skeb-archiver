le.com/drive/folders/12V-PO93JV_RM9vIyteXgNtFoTj_k4CRb", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@47zou/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e27d0e80/uploads/origins/9c40d7fc-b129-4e9f-bd5b-f3b49c82791c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37bc7a6a4fc28002ac0d17981218c85e", "srcset": "https://si.imgix.net/e27d0e80/uploads/origins/9c40d7fc-b129-4e9f-bd5b-f3b49c82791c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37bc7a6a4fc28002ac0d17981218c85e, https://si.imgix.net/e27d0e80/uploads/origins/9c40d7fc-b129-4e9f-bd5b-f3b49c82791c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1349e1952326b44175733e6b1a548e0 2x, https://si.imgix.net/e27d0e80/uploads/origins/9c40d7fc-b129-4e9f-bd5b-f3b49c82791c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ffe46d2110a794273ab3b80f41e60812 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1267528, "client_id": 1763585, "nc": 48}, {"path": "/@47zou/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1267528, "client_id": 125063, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb85fde0/uploads/origins/86ef28a4-3758-407b-bb4e-8dc3f837e01c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee915a211b2388cc94b1292de2773515", "srcset": "https://si.imgix.net/eb85fde0/uploads/origins/86ef28a4-3758-407b-bb4e-8dc3f837e01c?bg=%23fff&auto=for