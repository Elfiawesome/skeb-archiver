200&h=200&s=96e70182b4818664bff159a97c752e96 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/023d234a/uploads/origins/73272f73-19a6-47cc-a16a-a0f1d4eeff45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7e4cd55ec5a11fa97c00a3180843134", "srcset": "https://si.imgix.net/023d234a/uploads/origins/73272f73-19a6-47cc-a16a-a0f1d4eeff45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7e4cd55ec5a11fa97c00a3180843134, https://si.imgix.net/023d234a/uploads/origins/73272f73-19a6-47cc-a16a-a0f1d4eeff45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3363bb2aa86fbb024e764d6eb53e8da9 2x, https://si.imgix.net/023d234a/uploads/origins/73272f73-19a6-47cc-a16a-a0f1d4eeff45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=76a45489ac1afc86b6041a62db84ecf5 3x"}, "body": "初めまして\n巨大なローパー(https://x.com/mike_illust/status/1650067840605765634)か\nヒトデ型モンスター(https://x.com/mike_illust/status/1617559585820377099)\nに拘束されて乳首や股間を責められるエスデス（アカメが斬る!）のイラストを依頼したいと考えています\n\n表情は↓のジュディスのような感じで、かつボールギャグを付けられている感じで\nhttps://x.com/mike_illust/status/1658490471113703424\n\n大まかな雰囲気や体勢は以前描かれていた↓の作品のような感じで、後ろから拘束されて手足を広げられ、乳首や股間を執拗に責められるような感じ\n※機械や搾乳用チューブ、鎖などを触手に置き換えていただきたいです\nhttps://ci-en.dlsite.com/creator/18027/article/1175255\n\n服装は胸と股間の部分が破られボロボロな状態(度合いはお任せします、帽子は不要です)\n乳首は弄られ過ぎて肥大化しており、全体的にむわっとした雰囲気をお願いしたいです\n\n資料としてエスデス将軍のキャラの説明のURLを添付していますので、受けていただける場合は併せてご覧下さい\n\n長くなって申し訳ございません、どうかご検討ください\n\nhttps://dic.nicovideo.jp/a/%E3%82%A8%E3%82%B9%E3%83%87%E3%82%B9", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mike_illust/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0f321ec4/uploads/origins/84a44689-86c9-493a-85b6-ba512cf1cda8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bol