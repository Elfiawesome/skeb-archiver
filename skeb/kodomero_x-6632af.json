ど色も性格も逆で、反転目のイメージです。ただし戦闘スタイルは基本的にダナスと同じになります。(ご参考までにダナスはおっとりめ事なかれ主義的、反転キャラは神経質めで攻撃的な感じです)\n\n利用目的\n個人的な鑑賞およびSNS(ioの当方アカウント)への掲載\n\n2人分のイラスト依頼になりますので、もし金額が見合わないようでしたら再送依頼いただけると助かります。\nふんわりとした依頼で申し訳ございませんが、ご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://misskey.io/@kyoka_h/pages/1717201985095", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 32380, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "きいち🦥", "screen_name": "miyubi_e", "avatar_url": "https://pbs.twimg.com/profile_images/1642172145815138305/pTeDIOtQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2415715518/1739530115/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 1240369, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "朝原ミナ", "screen_name": "ashr_37", "avatar_url": "https://pbs.twimg.com/profile_images/2034073829082075138/ILoBR9Iv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2034072782041219072/1777620946/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 32}, {"id": 1626474, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "どこかの揚げ物🦀", "screen_name": "DokokanoFry", "avatar_url": "https://pbs.twimg.com/profile_images/2042675927646449664/pg4n_uct.png", "header_url": "https://pbs.twimg.com/profile_banners/1287778343014694914/1736034570/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null,