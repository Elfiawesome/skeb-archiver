4a31-438d-b54e-5e9a53997c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b06fc94234addef8d3d3eb08acacac12, https://si.imgix.net/cc15e2ca/uploads/origins/be35b836-4a31-438d-b54e-5e9a53997c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90e8d12a8129d106b55bb5efe9cc4e68 2x, https://si.imgix.net/cc15e2ca/uploads/origins/be35b836-4a31-438d-b54e-5e9a53997c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3f9a1dade2567cd9e1eda6b051f9318 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc15e2ca/uploads/origins/be35b836-4a31-438d-b54e-5e9a53997c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=acb459ee2a3c669a2fd452bb4ab4a488", "srcset": "https://si.imgix.net/cc15e2ca/uploads/origins/be35b836-4a31-438d-b54e-5e9a53997c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=acb459ee2a3c669a2fd452bb4ab4a488, https://si.imgix.net/cc15e2ca/uploads/origins/be35b836-4a31-438d-b54e-5e9a53997c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=da48f2c503867a30b84f00262c7df414 2x, https://si.imgix.net/cc15e2ca/uploads/origins/be35b836-4a31-438d-b54e-5e9a53997c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d3018745cb1937fb2ab45b53cf45c22 3x"}, "body": "Thank you for your appeal.\nAgain, thank you for your interest in the character (our child).\n\nWe would like to ask you to illustrate a girl similar to the one in the original appeal.\nThis is a reference image, but you are free to design, express, pose, and compose the sailor uniform.\nhttps://drive.google.com/drive/folders/1RIJ2bUUoPHZDhYmSZ5NlFco0yYrqRyDg?usp=sharing\n\nBelow is the content of the request, but since it is a re-post, it is for reference only.\nWe would like to have the \"Valentine's Day-inspired picture\" you suggested.\nSince it is Valentine's Day, we would like to have long-sleeved sailor uniforms.\nOf course, long-sleeved plain clothes are also acceptable.\nAs long as the bandage on the cheek and the cast + triangular bandage on the right arm are maintained, the rest of the picture is free.\n\n■Girls\nShort bob with glossy black hair with bangs, slightly curled inward, side and back hair trimmed at about the mouth line, softly cropped at the collar (may or may not be visible, depending on the composition).\nSailor uniform with short sleeves\nShort-sleeved sailor uniform\nSituation\nThe right arm is in a cast and is hanging from the neck with a triangular bandage.\n　-Please place the knot of the triangular bandage at the neck and elbow in a visible position (please refer to the URL of the document).\n　　(This is a detail... the neck has one knot and two ends of the triangular bandage, while the elbow has one knot and one end of the triangular bandage.)\n　-Please make sure that the right arm is in the frame.\nOne adhesive bandage on the cheek.\n-An expression of embarrassment, not darkened by the injury, as shown below.\n　Wink with one eye, sticking out tongue, so-called \"tehepe-roku\" expression.\n\nMy personal point is to moe for the bandage and still look cute and energetic.\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mashu7272/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2254039, "client_id": 36149, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3ba35eb/uploads/origins/4589c207-8eda-4cc2-8f9f-2371f3d6bd72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=751f03d073f203a110aefa80ae760d36", "srcset": "https://si.imgix.net/a3ba35eb/uploads/origins/4589c207-8eda-4cc2-8f9f-2371f3d6bd72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h