ur=200&s=53d9c7f58a5e30d73b91d62d446416d5 3x"}, "body": "こんにちは！あなたの画風と構図はとても素晴らしいので、私の2人のOCのために絵をリクエストしてもいいでしょうか？\nWAR（金髪）はエイリアンの殺し屋で、ドレイク（茶髪）は人間の研究者（でもWARに感染して触手が生えた）。以前は互いに争っていたが、協力せざるを得なくなった。彼らの関係は敵であり、恋人であり、同時に犯罪のパートナーでもある。すべてはあなたの理解次第だ！リンク先で、彼らの参考画像とストーリーを見ることができる。\n表情やポーズ、やりとりはあなたの判断にお任せします。楽しんでいただければ幸いです！\n\nhttps://drive.google.com/drive/folders/1-9OwJDBpcNzLwcSdXutylvah8GaBIH4T", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@IKAooi1/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2254060, "client_id": 3044987, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5945429b/uploads/origins/d2d2d672-6283-4c21-bfde-c7a77edfc6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fb46ff1c32a2af6c293372a09e2432c", "srcset": "https://si.imgix.net/5945429b/uploads/origins/d2d2d672-6283-4c21-bfde-c7a77edfc6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fb46ff1c32a2af6c293372a09e2432c, https://si.imgix.net/5945429b/uploads/origins/d2d2d672-6283-4c21-bfde-c7a77edfc6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a03532b2456fc67264464c44c67e511 2x, https://si.imgix.net/5945429b/uploads/origins/d2d2d672-6283-4c21-bfde-c7a77edfc6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=724213a0bebc1f3d7272bc0ca06382b5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5945429b/uploads/origins/d2d2d672-6283-4c21-bfde-c7a77edfc6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9065284eac0d24ff10a9d94fc028c76e", "srcset": "https://si.imgix.net/5945429b/uploads/origins/d2d2d672-6283-4c21-bfde-c7a77edfc6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9065284eac0d24ff10a9d94fc028c76e, https: