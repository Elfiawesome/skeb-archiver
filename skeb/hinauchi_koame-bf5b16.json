si.imgix.net/169a7547/uploads/origins/658fda19-d71b-419d-b70c-6e9020cdd083?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4a7b96dbc55f01500841c3014b014fd, https://si.imgix.net/169a7547/uploads/origins/658fda19-d71b-419d-b70c-6e9020cdd083?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bbabbd7b5f3b95c8e3a5e72a4404a40a 2x, https://si.imgix.net/169a7547/uploads/origins/658fda19-d71b-419d-b70c-6e9020cdd083?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5ecd7b0a23e14bb129557ceb1f6544df 3x"}, "body": "ひなうち小飴先生、はじめまして！\nひなうち先生のかわいくて魅力的なイラストが大好きです！\nはじめてリクエストを送らせていただきます。\nこの度、私のオリジナルキャラクターを依頼させていただきたく、ご連絡させていただきました。\n推し活女子のキャラクターなので、ペンライトを持って全力で楽しそうにしている雰囲気のイラストをお願いしたいです。\n\n・資料\nhttps://drive.google.com/file/d/1MnK0JDO3JRCM1rgFjiWJhxd3hKSSajI5/view?usp=drive_link\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1MnK0JDO3JRCM1rgFjiWJhxd3hKSSajI5/view?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hinauchi_koame/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2411833, "client_id": 3308879, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb4fa4eb/uploads/origins/9abfeed3-7bc9-4b0a-8a4b-b953e513edf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb254423d48b1d31ca4ba9c0ad5ba43d", "srcset": "https://si.imgix.net/eb4fa4eb/uploads/origins/9abfeed3-7bc9-4b0a-8a4b-b953e513edf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb254423d48b1d31ca4ba9c0ad5ba43d, https://si.imgix.net/eb4fa4eb/uploads/origins/9abfeed3-7bc9-4b0a-8a4b-b953e513edf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1df1a8eccbd395d2aaf1f101c0e4bab7 2x, https://si.imgix.net/eb4fa4eb/uploads/origins/9abfeed3-7bc9-4b0a-8a4b-b953e513edf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48182f736c1479ca01ace4ac338e0e95 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb4fa4eb/uploads/origins/9abfeed3-7bc9-4b0a-8a4b-b953e513edf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc6c81c090465598b4a483dcb4b83b08", "srcset": "https://si.imgix.net/eb4fa4eb/uploads/origins/9abfeed3-7bc9-4b0a-8a4b-b953e513edf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc6c81c090465598b4a483dcb4b83b08, https://si.imgix.net/eb4fa4eb/uploads/origins/9abfeed3-7bc9-4b0a-8a4b-b953e513edf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4bbad70714e1d3503602ceaf428defca 2x, https://si.imgix.net/eb4fa4eb/uploads/origins/9abfeed3-7bc9-4b0a-8a4b-b953e513edf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56d1ed9a63adfab56905f83c679ca05c 3x"}, "body": "お世話になります。LE-Y/nです。  \n\n以前は素敵なイラストをありがとうございました。依頼時の期待以上のデザインとキャラクター性を持った子を生み出してくださり、常々「うちの子可愛いでしょ」と友人にも自慢しております。\n\n前回いただいたイラストがとても素敵でしたので、今年もまたイラストをいただきたく依頼をお願いしたく思っております。\n\n以下、依頼の内容です。\n\n基本的に「お任せ」でお願いできればと思います。\n\n新しいキャラクターでも、これまで依頼させていただいた中で生まれたキャラクターでも何でも大丈夫です。\n\nただ、ひなうち先生の方でお題があった方が描きやすいようでしたら、また「キョウカちゃんとお友達(名前が無くてお友達になってしまってすみません…)」を描いてもらえたらと思います。\n\nもしそうなった場合は可能なら2人の関係性や仲の良さが分かるシチュエーションだと私が喜びます。(水族館デート…とか…？)(キョウカちゃんメインじゃなくてお友達メインでも)\n\n以上になります。\n\nこれまでとは違った難しさの依頼になってしまっているとは思いますが、お受けいただけますと有り難く存じます。\n\nLE-Y/n", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hinauchi_koame/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2411833, "client_id": 3046939, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/784c7818/uploads/origins/04cfe708-bcf5-43c7-919b-4dd6193070fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cr