です。\nアロマちゃんのキャラデザインやシャボン玉に閉じ込められた女の子の参考イラスト等を載せてあるツイートのURLを貼らせていただきますので、そちらをご参考にして下さい。\nもし、そちらでも足りないようでしたら私の固定ツイートから詳しいアロマちゃんのキャラデザインやメディア欄からシャボン玉閉じ込めイラストなどもございますのでそちらもご参考にして下さい。\n\n以上になります！\n正直シャボン玉閉じ込めイラストって何それ？\nと思っているでしょう。\n少々特殊なリクエスト内容となり、こちらのリクエスト内容を読んでも難しいということもあるかと思われますので可能なようでしたらよろしくお願いいたします。\n\nhttps://twitter.com/syabon09/status/1378520218457108480?s=19", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Torotarou/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 420126, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e73769d/requests/252275_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a139f51fcbf7fc00c2b06b230d2e448", "srcset": "https://si.imgix.net/3e73769d/requests/252275_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a139f51fcbf7fc00c2b06b230d2e448, https://si.imgix.net/3e73769d/requests/252275_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd5c33e584d76f84ca4e96376aca7a21 2x, https://si.imgix.net/3e73769d/requests/252275_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d440584fc28037dd78b9061b038fb74 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e73769d/requests/252275_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=713ef30a94fc25c9abd1a760ba08457e", "srcset": "https://si.imgix.net/3e73769d/requests/252275_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=713ef30a94fc25c9abd1a760ba08457e, https://si.imgix.net/3e73769d/requests/252275_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c9f859a225ab99f5def3c31d9506be06 2x, https://si.imgix.net/3e73769d/requests/252275_0?bg=%23fff&auto=format%2Ccompress&fm=webp&d