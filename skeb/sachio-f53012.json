大きな鏡を設置していたり、自分の顔が良く見えるように特注のゴーグルをつけている。\n▽茶髪のキャラクター\n188cm/30歳\nとある中学校の家庭科の先生。基本的に赤いエプロンをしている。\n大食い。おおらかでマイペースだが、照れ屋なところがある。\n\n▽茶髪のキャラクター×金髪のキャラクターの恋人同士です。\n金髪のキャラ方がファッションなどには凝る方で、コーディネートしてあげていたら可愛いな、と思います！髪型なども自由にアレンジしていただいても構いません！\n\nお忙しいところ恐縮ですがご検討ください。\nまた、料金が不十分等がありましたら再送頂けますと幸いです。\n\nhttps://drive.google.com/drive/folders/1HvcGwZNRYa1uZIkOQPrGXk40CRPA_Mc4?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sachio/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3377856, "client_id": 2661593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3b25bbde/uploads/origins/c5b8a988-c84d-439b-b59d-c6631a987914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f74549b00b1299f8fef87677056b17f3", "srcset": "https://si.imgix.net/3b25bbde/uploads/origins/c5b8a988-c84d-439b-b59d-c6631a987914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f74549b00b1299f8fef87677056b17f3, https://si.imgix.net/3b25bbde/uploads/origins/c5b8a988-c84d-439b-b59d-c6631a987914?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17d61ab908410dc91234a5454ed04244 2x, https://si.imgix.net/3b25bbde/uploads/origins/c5b8a988-c84d-439b-b59d-c6631a987914?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b3a4051f7ff31c319c564e7d5fffe13 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b25bbde/uploads/origins/c5b8a988-c84d-439b-b59d-c6631a987914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41b43e54de0d4a19f4d1ab2cc02be8a8", "srcset": "https://si.imgix.net/3b25bbde/uploads/origins/c5b8a988-c84d-439b-b59d-c6631a987914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41b43e54de0d4a19f4d1ab2cc02be8a8, https://si.imgix.net/