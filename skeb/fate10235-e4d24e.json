ix.net/5c25b3b4/uploads/origins/40892228-c4af-4ed5-86c5-b808a4bae2ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2bb4e111939634a2b4f56c4f8819612, https://si.imgix.net/5c25b3b4/uploads/origins/40892228-c4af-4ed5-86c5-b808a4bae2ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=acb61b30f197b396d8dca1e34d767b02 2x, https://si.imgix.net/5c25b3b4/uploads/origins/40892228-c4af-4ed5-86c5-b808a4bae2ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f7e202dfcff5ecabcf997f591a53ced2 3x"}, "body": "海豚号さん、こんにちは。\n海豚号さんの描く水着イラストが見たくリクエストを送らせていただきました。\n\n私、香倉玲衣の水着イラストをお願いします。\n水着のデザインについてはどのようなものでも大丈夫です。\nご検討よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fate10235/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 703582, "client_id": 783941, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bbebff8/uploads/origins/363dcd13-c412-4a7b-b919-2c2b06364930?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f97517568b7877df97c345dbeb1bf488", "srcset": "https://si.imgix.net/5bbebff8/uploads/origins/363dcd13-c412-4a7b-b919-2c2b06364930?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f97517568b7877df97c345dbeb1bf488, https://si.imgix.net/5bbebff8/uploads/origins/363dcd13-c412-4a7b-b919-2c2b06364930?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1934b7ef2803e0bbb7eed6c91215118 2x, https://si.imgix.net/5bbebff8/uploads/origins/363dcd13-c412-4a7b-b919-2c2b06364930?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc8825046b8ea81136b4b76c5b3b75d8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5bbebff8/uploads/origins/363dcd13-c412-4a7b-b919-2c2b06364930?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b408077886eceec266150138065e863", "srcset": "https://si.imgix.net/5bbebff8/uploads/origins/363dcd13-c412-4a7b-b919-2c2b06364930?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b408077886eceec266150138065e863, https://si.imgix.net/5bbebff8/uploads/origins/363dcd13-c412-4a7b-b919-2c2b06364930?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a11c49e3583caa8ff94a48b216c30bdc 2x, https://si.imgix.net/5bbebff8/uploads/origins/363dcd13-c412-4a7b-b919-2c2b06364930?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0b7f50b747da4f6f74dfb6ef269e6a84 3x"}, "body": "海豚号様、お疲れ様です\n今回は海豚号様に動画内使用する1枚絵（+他場面で切り抜き）で使用するイラストを依頼したくリクエストを送らせていただきます\n\nイラスト依頼内容\n題材：ポケモン\n【片付けのできていない部屋（汚部屋ほどではない）の中、ソファーに足を組んで座るジャージ姿のシロナ（ポケモンDPｔキャラクター）+シロナの脱ぎ散らかした服を片づけるシロナのガブリアス（♀）】\n\n\nキャラ説明\nシロナ：ジャージ姿　ジャージは小豆色や濃い緑色といった学生時代のものを部屋着に転用してそうな芋ジャージ\nガブリアス：メスなので参考画像ガブリアスの背びれの食い込みがない状態\n\n\n使用場面：動画内でとある事情から動画主人公がシロナにビデオ通話をする場面\n\n\n構図：型月ゲーム『Fate』に登場するアーチャー登場シーンのように不敵に笑いながらソファー（Yogiboのような）に腰かけて足を組み、膝の上で手を組んだ尊大な感じ\n見様によっては不敵尊大だが内心はそれなりに目にかけていた知人が自主的に連絡を取ってきたので普通に喜んでいる\n\n※構図的に手間が増えるなら肩肘をついているなど、足を組んで座っているなら他ポーズでも問題ありません\n\nジャージは小豆色や濃めの緑色といった学生時代のものを部屋着に転用してそうな芋ジャージ\n\nシロナの座るソファーの後方、シロナの脱ぎ散らかしたと思われる黒いコート・黒いズボン・ブラ（色などはお任せ）を前腕の爪で器用に集めるガブリアス\n回収した衣類は前腕に掛けるようにしており、ブラは前腕の爪にぶら下がっている\n「その部屋着でビデオ通話に出ることは恥ずかしいことなのよご主人」的な目で見ている\n\n\n\n資料画像\nシロナ：https://www.pokemon.co.jp/ex/sun_moon/character/22.html\n※画像左側\n\nガブリアス：https://www.pokemon.jp/special/forme/zukan03/zukan3-13.html\n※画像右側\n\n\nご検討をお願いいたします\n\nhttps://www.pokemon.co.jp/ex/sun_moon/character/22.html,https://www.pokemon.jp/special/forme/zukan03/zukan3-13.html", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fate10235/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "cre