保存したPSD)のサインなしバージョンもいただけますと、使用する際の自由度が高まりますのでお願いできますと幸いです…！\n\n以下のツイートURLを服装、容姿の参考資料としてお使いいただけますと幸いです。\n\n参考資料1  男の子ver\nhttps://drive.google.com/drive/folders/1TDd_mhBaJD1ZwYrNehES-p6TqS0xPiq4\n参考資料2  男の子ver\nhttps://twitter.com/kaname_karupis/status/1637803599811219458?s=46&t=jcifdrt2qc8KAVdqpqgZGg\n\n女の子ver参考資料\nミディアムぐらいの髪の長さで黄色いインナーが入っている。服はお好みで描いていただいて大丈夫です！\nhttps://drive.google.com/drive/folders/1-1v2cvB17ML2hSO-rZxOzS9ZUkZrrbB9\n\nご検討、よろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@myonmyon0212/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2380074, "client_id": 1502066, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65c262cc/uploads/origins/771f942e-7167-404c-9c01-a7848d9a357e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5a80f04bd8ad9d11a4747abddac2534", "srcset": "https://si.imgix.net/65c262cc/uploads/origins/771f942e-7167-404c-9c01-a7848d9a357e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5a80f04bd8ad9d11a4747abddac2534, https://si.imgix.net/65c262cc/uploads/origins/771f942e-7167-404c-9c01-a7848d9a357e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df477aa179cb743b34b32027be8695f1 2x, https://si.imgix.net/65c262cc/uploads/origins/771f942e-7167-404c-9c01-a7848d9a357e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=338796a91aa91230038b05514a260b6c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65c262cc/uploads/origins/771f942e-7167-404c-9c01-a7848d9a357e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ff1a94045b905fd4ca951fdbce755d5", "srcset": "https://si.imgix.net/65c262cc/uploads/origins/771f942e-7167-404c-9c01-a7848d9a357e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop