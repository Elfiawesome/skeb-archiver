URLご参照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pometohoho46236/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3953374, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9519dd25/uploads/origins/58fba48e-1c67-4c80-8f4e-5e97ca45b2e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=257d9b78039f29c7ea750bf44886c9e4", "srcset": "https://si.imgix.net/9519dd25/uploads/origins/58fba48e-1c67-4c80-8f4e-5e97ca45b2e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=257d9b78039f29c7ea750bf44886c9e4, https://si.imgix.net/9519dd25/uploads/origins/58fba48e-1c67-4c80-8f4e-5e97ca45b2e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9f9c58f511916b13c1eb081b4b70a6c 2x, https://si.imgix.net/9519dd25/uploads/origins/58fba48e-1c67-4c80-8f4e-5e97ca45b2e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=141d4cdca13d83ef8cd36c0ac89694eb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9519dd25/uploads/origins/58fba48e-1c67-4c80-8f4e-5e97ca45b2e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80fecbbad00a3432a6b8dcabbc6e6f8c", "srcset": "https://si.imgix.net/9519dd25/uploads/origins/58fba48e-1c67-4c80-8f4e-5e97ca45b2e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80fecbbad00a3432a6b8dcabbc6e6f8c, https://si.imgix.net/9519dd25/uploads/origins/58fba48e-1c67-4c80-8f4e-5e97ca45b2e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=2