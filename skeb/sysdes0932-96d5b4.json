bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a93e2f9b1e92d7d6b90538865a8e350 3x"}, "body": "以前ばんこく堂さんが描かれた\nhttps://mobile.twitter.com/sysdes0932/status/1366941221696901121\nこちらのイラストの続きをリクエストいたします。\nガールランク300本では目隠し拘束されて愛されていたモモコですが、先程のイラストのモモコに対し鰻やらマムシやらスッポンを摂取して準備万端なご主人が待ち構えていたら……。といったシミュレーションをお願いします。\n騎乗位だと更に嬉しいです。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sysdes0932/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 101287, "client_id": 57900, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f5a5ec20/uploads/origins/c16f55cd-2507-4530-b1a1-e0cac515c96b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=879ccfcb9460f3e2119dda1fd2733724", "srcset": "https://si.imgix.net/f5a5ec20/uploads/origins/c16f55cd-2507-4530-b1a1-e0cac515c96b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=879ccfcb9460f3e2119dda1fd2733724, https://si.imgix.net/f5a5ec20/uploads/origins/c16f55cd-2507-4530-b1a1-e0cac515c96b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49c0638c97668e5f984db3b927466db8 2x, https://si.imgix.net/f5a5ec20/uploads/origins/c16f55cd-2507-4530-b1a1-e0cac515c96b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e49a41b5a61bc8ccbab3ba16726a525 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5a5ec20/uploads/origins/c16f55cd-2507-4530-b1a1-e0cac515c96b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a602dbb84cdd94274c22172bb935ff6", "srcset": "https://si.imgix.net/f5a5ec20/uploads/origins/c16f55cd-2507-4530-b1a1-e0cac515c96b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a602dbb84cdd94274c22172bb935ff6, https://si.imgix.net/f5a5ec20/uploads/origins/c16f55cd-2507-4530-b1a1-e0cac515c96b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f66952e656e78983fd6c8f8b84256aa3 2x, https://si.imgix.net/f5a5ec20/uploads/origins/c16f55cd-2507-4530-b1a1-e0cac515c96b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=53885bdd562050a58b2883041d674300 3x"}, "body": "ばんこく様のスケブ、楽しみにしておりました！\n以下の内容で送らせて頂きます！どうぞよろしくお願いいたします。\n\nキャラ：\n幸手くん、小人さん（https://www.furaffinity.net/view/41381342/　こちらのイラストのような、簡略化した感じの白小人さんでお願いしたいです）\nシチュ：\n食事ごと小人さんを飲み込み、ぽっこりと膨らんだお腹を満足そうに撫でる幸手くん。そのお腹の中、巨大な胃袋の中で、どろどろになったご飯の泥沼に埋もれたミクロサイズの小人さんが、幸手くんの柔らかな胃壁にしがみついて、暖かさと柔らかな感触に身も心も蕩けてしまっている。\n構図：\nイラスト（体内描写と拡大図付き）でお願い出来ればと思います。\nメインイラストでは、幸手くんが満腹になったお腹を擦りながら満足そうに舌なめずりをしている様子を描写して欲しいです。\n体内描写では、幸手くんの大きく膨らんだ胃の中に、どろどろになった食事が溜まっている様子を描写して欲しいです。併せて、その胃袋の片隅に、ゴマ粒ぐらいの小さな点を描いて頂きたいです（胃袋は、噴門が見える構図で大洞窟のように描写して頂けると嬉しいです…！）。\n体内描写の拡大図として、小人さん（ゴマ粒以下の大きさ）が、食塊に肩から下が埋もれ、その圧迫に押し付けられるようにして幸手くんのむちむち胃壁に沈み混んでいる様子も描写して頂けると嬉しいです…！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sysdes0932/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 101287, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5e07aa9/requests/197863_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a467129b48033794467704682745fe1", "srcset": "https://si.imgix.net/a5e07aa9/requests/197863_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a467129b48033794467704682745fe1, https://si.imgix.net/a5e07aa9/requests/197863_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72c9ea9efa5f77a5f9dd79493c1e030d 2x, https://si.imgix.net/a5e07aa9/requests/197863_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7716c13cdbd6332d5e856aadb0db3c46 3x"}, "duration": null, "nsfw": true, "hardcore": false, "co