06d-47c3-bb2d-2eb0ef3dc67a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f8a34d7f06182b7fec9f943c8831910, https://si.imgix.net/b861b548/uploads/origins/c2014062-d06d-47c3-bb2d-2eb0ef3dc67a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3d7d440139d1b903e7a7df6d8c7f8b0f 2x, https://si.imgix.net/b861b548/uploads/origins/c2014062-d06d-47c3-bb2d-2eb0ef3dc67a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a2c399a40a73c6f5a4b1c5a952c1d5a 3x"}, "body": "はじめまして、柴田です！あなたのアートはとてもかわいいです！\n\nこの2人のキャラクターのイラストを描いていただけませんか？\n二人は一緒に魔法学校に通っています。学校は中世のお城のようなスタイルです。\nファンタジーをテーマにしている（しゃべる植物、飛ぶ本、飛ぶほうき、動く絵、空想上の生き物、動く羽ペン、呪文書、ふくろう、猫、コウモリ、かぼちゃなど）。\n\nアロイス金髪の少年。トラブルメーカー、ミスフィットタイプ。いたずら好きで気が強い。趣味：スケッチ、ロックミュージック。\nゲイブ。茶髪。自信家、フレンドリー、アロイスをからかうのが好き。宇宙船と科学が好き。いつか宇宙船を設計したいそうです。\n\n2人の関係は、ゲイブが人気者で、不良のアロイスを驚かせて仲良くなろうとするものです。\n\nポーズの例としては、以下のようなものがあります：\n- ゲイブがアロイスの勉強を手伝っている\n- ゲイブとアロイスが一緒に宇宙船の模型を作っています\n- ゲイブとアロイスが一緒に箒で城の上空を飛ぶ\n- その他、お好きなポーズをお選びください\n\nこの度はこのリクエストをお読みいただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1aijBfN9Jila_sth9TnmhdCSuzLHHwOaj?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nemui_usio/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1924384, "client_id": 22342, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9cd1bf3f/uploads/origins/b5aad2b5-fbc9-47e5-ace8-21185883548f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=841235ff0d9232ab08a946f73e358181", "srcset": "https://si.imgix.net/9cd1bf3f/uploads/origins/b5aad2b5-fbc9-47e5-ace8-21185883548f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=841235ff0d9232ab08a946f73e358181, https://si.imgix.net/9cd1bf3f/uploads/origins/b5aad2b5-fbc9-47e5-ace8-21185883548f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=