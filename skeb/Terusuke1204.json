g=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e78154450affa19cf3cd2d21963fad0c 3x"}, "body": "書くかも程度ですがドM小説の挿絵に使いたいです\nシチュ：\n着衣超魔乳&着衣ボテ腹姿のマリー&ローズにゴミを見るような冷めた目で嫌悪・侮蔑されながら、添い寝されている男が両サイドから二人の触手満載の咥内で乳首を嫐られ、えぐい構造の粘液たっぷりの触手オナホコキで大量搾精させられるMシチュ\n二人ともゴミを見る冷めた目(顔の上部や目元まで影がかかる感じでハイライトなし)で、変態マゾへの嫌悪を一切隠すことない侮蔑の表情を希望します\n\n触手咥内は花のように開くブラシ状触手、吸盤触手に加えて咥内壁や本来の舌自体も粘液まみれの襞や繊毛などが密集した触手地獄で、\n乳首を引っ張ったり吸引したり、乳腺をイジメる構造の触手を希望します\n\n二人とも全身粘度の高い粘液まみれで全身がどろどろ&べとべとで超魔乳やボテ腹に服がべっとりと張り付き、\n片乳だけで両手が簡単に沈む、頭&胴体以上サイズかつ服越しでもピンク色の透け勃起乳首がわかる着衣超魔乳と、\nそれと同サイズでの特大着衣ボテ腹(妊娠淫紋付き)が衣装の中にギチギチに押し込まれ強調され、\n超魔乳やボテ腹内部に孕んだ、粘液まみれの大量の触手が蠢き外から見ても歪に変形している描写希望です\n\nペニスは肉々しいえぐい構造の触手オナホにモザイク不要レベルで完全に呑み込まれており結合部から粘液と共に内部のブラシ触手や精子が溢れている描写をお願いします\nまた可能でしたら背景に同様の構造の粘液まみれの触手オナホが口を開いて中を見せつけている様子もお願いします\n\n触手肉壁やダーク系の背景で、可能でしたらpsd形式で射精差分、粘液まみれの触手が蠢く水音やM男の喘ぎ声等の効果音の有無、二人の上部の影と瞳のハイライトの有無をON/OFF切替表示希望です\n優先度最低で異形の触手に悦んで射精する変態マゾへの罵倒・侮蔑台詞有無(口調お任せ)と\n更に低で、尿道を常時解放して永遠に精液を垂れ流し精巣で触手まで孕むザーメンタンクに改造してあげる、的な台詞の有無希望です\n\n参考：\n\nhttps://drive.google.com/drive/folders/18ci3Q8RzKa_gGZqhrcYiv5hSibDGp4Hw?usp=sharing", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1277140, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ナムザル", "screen_name": "Nam_zaru", "avatar_url": "https://pbs.twimg.com/profile_images/1451580402053779464/cHDUkJrZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/943842389654872064/1535943141/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 49}, {"id": 1586548, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "TSB（体操袋）", "screen_name": "taisowbukurow", "avatar_url": "https://pbs.twimg.com/profile_images/1920096487159263232/oUx_z