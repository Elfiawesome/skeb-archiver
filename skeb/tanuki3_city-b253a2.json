1926619420/photo/2\n\n・シチュエーション\n歌枠をする方なので、発声練習をしているループムービーを作って頂きたいです\n腹式呼吸をする際のように両手をお腹に当てて立っています\nピッと背筋を伸ばし、声を遠くに伸ばすために頭はすこし上を向いています\n口は『アー』と『オー』を繰り返しており、周りには♬や♩などの音符が浮いています\n瞬きをしていると嬉しいですが、難しいなら無くても構いません\n\n・使用用途\n配信活動をしている方ですので、待機画面などに使用する場合があります\n\n御検討頂けると幸いです", "nc": 128, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@tanuki3_city/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2511972, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54321d7a/uploads/origins/946ef5b4-c6d2-473c-ab5f-6398faf1f1cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fed5bd274e42a852ac5aa51320318f39", "srcset": "https://si.imgix.net/54321d7a/uploads/origins/946ef5b4-c6d2-473c-ab5f-6398faf1f1cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fed5bd274e42a852ac5aa51320318f39, https://si.imgix.net/54321d7a/uploads/origins/946ef5b4-c6d2-473c-ab5f-6398faf1f1cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4bb9967ca1ac4f7d3e49ca69e8aa17d 2x, https://si.imgix.net/54321d7a/uploads/origins/946ef5b4-c6d2-473c-ab5f-6398faf1f1cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac94c5196196ee77dcfa637e04e49dc5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54321d7a/uploads/origins/946ef5b4-c6d2-473c-ab5f-6398faf1f1cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa456f8f63140cfd639a5f1e8c0b9b23", "srcset": "https://si.imgix.net/54321d7a/uploads/origins/946ef5b4-c6d2-473c-ab5f-6398faf1f1cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa456f8f63140cfd639a5f1e8c0b9b23, https://si.imgix.net/54321d7a/uploads/origins/946ef5b4-c6d2-473c-ab5f-6398faf1f1cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top