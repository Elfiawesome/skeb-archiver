Mariyohhと申します。めちゃかわいい絵柄を拝見し、ぜひ依頼させていただきました♡\n\nMariyohhのデザインについては資料URLの画像を見ていただければと思います。\n\n構図やポージングについてはお任せしますが、表情はかわいく楽しそうな感じ、服装はキャラデザの通りにお願いします。\n\nYouTubeのサムネやTwitterなどの各種SNSなどに使う予定です。頭の先や横の髪の毛などは、先が切れないように書いて頂けると嬉しいです。お手数ですが、使いやすいように背景と人物の分けた透過データ(PSD)をいただけるとすごく助かります。\n\nどうぞよろしくお願いします(o˘◡˘o)\n\nhttps://drive.google.com/file/d/1cmre1CzRBqkl7k0bO1sAKaGpVMOO8uac/view?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mocodogwan10/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3373040, "client_id": 3143059, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01b0c8b8/uploads/origins/548fd86f-e521-4d23-8d15-a28e3b428eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2274907a324930a38decbbc96850b65", "srcset": "https://si.imgix.net/01b0c8b8/uploads/origins/548fd86f-e521-4d23-8d15-a28e3b428eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2274907a324930a38decbbc96850b65, https://si.imgix.net/01b0c8b8/uploads/origins/548fd86f-e521-4d23-8d15-a28e3b428eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7fe8deb63267a7e1895d4a5954263797 2x, https://si.imgix.net/01b0c8b8/uploads/origins/548fd86f-e521-4d23-8d15-a28e3b428eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d83c8805921e555bd6bdfb21483a1c9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01b0c8b8/uploads/origins/548fd86f-e521-4d23-8d15-a28e3b428eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f148fdc826a7425c506b1eb6382d002f", "srcset": "https://si.imgix.net/01b0c8b8/uploads/origins/548fd86f-e521-4d23-8d15-a28e3b428eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f148fdc826a7425c506b1eb6382d002f, https://