ls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 300478, "client_id": 1665711, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/172e2069/uploads/origins/a04c5f09-9f78-4f1e-a472-c3474df1605e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=034521232f7beccfd00985c4e1760fa4", "srcset": "https://si.imgix.net/172e2069/uploads/origins/a04c5f09-9f78-4f1e-a472-c3474df1605e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=034521232f7beccfd00985c4e1760fa4, https://si.imgix.net/172e2069/uploads/origins/a04c5f09-9f78-4f1e-a472-c3474df1605e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1303be19af9093819aa92fef42239761 2x, https://si.imgix.net/172e2069/uploads/origins/a04c5f09-9f78-4f1e-a472-c3474df1605e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0032020ce81b6e16379e3e812c7de1db 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/172e2069/uploads/origins/a04c5f09-9f78-4f1e-a472-c3474df1605e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=426cdae7554188053ecabb80380753bb", "srcset": "https://si.imgix.net/172e2069/uploads/origins/a04c5f09-9f78-4f1e-a472-c3474df1605e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=426cdae7554188053ecabb80380753bb, https://si.imgix.net/172e2069/uploads/origins/a04c5f09-9f78-4f1e-a472-c3474df1605e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4497a2daef10dce21982d6449dfefe83 2x, https://si.imgix.net/172e2069/uploads/origins/a04c5f09-9f78-4f1e-a472-c3474df1605e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=215b40d29090789690a3165eeb0d89b2 3x"}, "body": "楸様初めまして。個人Vtuberの紫陽花と申します。\n先日ひび割れ素材を利用させていただきました！素敵な素材をありがとうございました！\n利用させていただく際にpixivやTwitter拝見したのですが、どれも可愛らしいイラストで大変心惹かれましたので、是非私自身を描いていただきたく思い、今回リクエストを致しました。\n\n【描いてほしいイラスト】\n私　「雨之庭紫陽花」\nグラデーションのかかった紫髪でゆるい三つ編みをサイドに流しています\n服装は袴姿で上は紫陽花柄の水色の着物で灯籠袴を履いています\n足元は黒色のパンプスです\n\n参考イラスト①:https://twitter.com/hydrangea2015_8/status/1518493077228617729?s=21&t=SQJlCQuTE8Jsa9T6xii31g\n参考イラスト②(リンクの2枚目がメインキービュジュです): https://twitter.com/hydrangea2015_8/status/1605994890533404672?s=46&t=XarozWFLQpOT6cRmIQtU5g\n\n【性格や雰囲気・設定など】\n紫陽花の妖精的な何か\nお年を召した花がいる農園で最期の世話をするバイトをしている\n喜怒哀楽が激しく楽しいことが大好き\n好戦的な部分もあります\n漫画や小説なども好きで結構オタク\n\n【描いてほしいイラストや構図・雰囲気・背景など】\n元気な笑顔を向けているイラストでお願いします\n私のビジュアルなどを見て描きたい構図などがありましたら、そちらを優先してほしいです\n全身や上半身の指定などありませんがサムネなどに利用したいと思っていますので、できるだけ途切れがないイラストでお願いします\n\n【描いて頂いたイラストの活用内容】\nTwitterのアイコンや活動ツイート\nYouTubeのサムネイル等や非収益(ネットプリントなど)各種活動に使用したいと考えております。\nそのため、キャラのみ使用できるよう透過したものやPSDでいただけますと幸いです。\n\n\n\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://mobile.twitter.com/hydrangea2015_8", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kisasage_hisagi/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/af87a6d7/uploads/origins/15fd36b9-b6af-4dae-bdd4-642705ed3b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5707b4d7c8a16bde53398ae5af5f98b9", "srcset": "https://si.imgix.net/af87a6d7/uploads/origins/15fd36b9-b6af-4dae-bdd4-642705ed3b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5707b4d7c8a16bde53398ae5af5f98b9, https://si.imgix.net/af87a6d7/uploads/origins/15fd36b9-b6af-4dae-bdd4-642705ed3b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3228e10d1423c452b81cebec0e239905 2x, https://si.imgix.net/af87a6d7/uploads/origins/15fd36b9-b6af-4dae-bdd4-642705ed3b03?bg=%23fff&auto=format%2