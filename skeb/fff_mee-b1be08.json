le_same_genre": true}, {"path": "/@fff_mee/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 20068, "client_id": 1802912, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a82e9c0/uploads/origins/ecb2f760-88d2-4b5a-b321-18d8eae6e350?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=292afb9bc8a15aa044546d1ab8386023", "srcset": "https://si.imgix.net/6a82e9c0/uploads/origins/ecb2f760-88d2-4b5a-b321-18d8eae6e350?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=292afb9bc8a15aa044546d1ab8386023, https://si.imgix.net/6a82e9c0/uploads/origins/ecb2f760-88d2-4b5a-b321-18d8eae6e350?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46a4ea7744f210dc0fbbcf85dc33ff8b 2x, https://si.imgix.net/6a82e9c0/uploads/origins/ecb2f760-88d2-4b5a-b321-18d8eae6e350?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1d3807d741240fc9422e45fdabb6b22 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a82e9c0/uploads/origins/ecb2f760-88d2-4b5a-b321-18d8eae6e350?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6105b7af37019855ef0f06c8fce5c2c7", "srcset": "https://si.imgix.net/6a82e9c0/uploads/origins/ecb2f760-88d2-4b5a-b321-18d8eae6e350?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6105b7af37019855ef0f06c8fce5c2c7, https://si.imgix.net/6a82e9c0/uploads/origins/ecb2f760-88d2-4b5a-b321-18d8eae6e350?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a9641a36ed45a892285d204bed29a21 2x, https://si.imgix.net/6a82e9c0/uploads/origins/ecb2f760-88d2-4b5a-b321-18d8eae6e350?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e05fd387e54add85c747f2b636796796 3x"}, "body": "こんにちは。あなたの絵が大好きです!私のキャラクター、マークの絵はもらえますか？彼はコンピュータープログラマーで、とても静かであまり話をしません。普段はとてもクールで、控えめな性格です。彼は2進数システムにとても興味があるので、2進数に囲まれた彼とか描いてみてはどうでしょうか。彼は、くすんだ色の多い街のオフィスで仕事をしています。マークはいつも片目をつぶっています。彼のデザインは簡単なので、楽しんで描いてください。シュールでもリアリズムでもいいし、コンピュータの美学みたいなものでいいんです。彼はオフィスの中にいることができます。何も「未来」ではなく、彼は古い技術（古いWindowsコンピュータのような）を持っているでしょう。あなたが好きなものは何でもできます。創造的で、楽しんでください。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1HeM31IMiD-jsDpvtsxfwI4D0PeOzxHVL?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fff_mee/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 20068, "client_id": 227016, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c114973a/uploads/origins/b256a739-4ed5-45fe-8155-d02ebf18b74c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b2edb1b30317261e6834ae3de212af2", "srcset": "https://si.imgix.net/c114973a/uploads/origins/b256a739-4ed5-45fe-8155-d02ebf18b74c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b2edb1b30317261e6834ae3de212af2, https://si.imgix.net/c114973a/uploads/origins/b256a739-4ed5-45fe-8155-d02ebf18b74c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76f56363b537fe5de47bed4e2678f57c 2x, https://si.imgix.net/c114973a/uploads/origins/b256a739-4ed5-45fe-8155-d02ebf18b74c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=698a1822581ad442cb5746fcdccac97c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c114973a/uploads/origins/b256a739-4ed5-45fe-8155-d02ebf18b74c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa160ef8926aff340b6ad69d5268cea8", "srcset": "https://si.imgix.net/c114973a/uploads/origins/b256a739-4ed5-45fe-8155-d02ebf18b74c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa160ef8926aff340b6ad69d5268cea8, https://si.imgix.net/c114973a/uploads/origins/b256a739-4ed5-45fe-8155-d02ebf18b74c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=84feebabdb3ab75587ddf22656947d21 2x, https://si.imgix.net/c114973a/uploads/origins/b256a739-4ed5-45fe-8155-d02ebf18b74c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0c40c86da510f37e28da2d61f1d0086b 3x"}, "body": "Twitterやpixivのイラストを拝見し、素敵な世界観のイラストを描かれる方だなと思いリクエストさせていただきました。\n\n「ロストヘヴン」というフリーゲーム(ジャンルRPG)の、レイジというキャラクターをお願いします。\n彼は獣人で、身長約170～175cm、17歳の男性です。髪の色は黒寄りの濃い紫、目は濃いピンクです(赤っぽくても大丈夫です)。\n\n怪盗パロを描いていただきたいです。\nタキシード仮面やキッドのような、シルクハットにマントといった格好をイメージしています。デザインや装飾は描きたいように描いて下さって構いません。\nレイジは原作では悪役なので、白よりは黒系が似合うと思います。\n獣耳とシルクハットの両立が難しければ、シルクハットは変更して大丈夫です。\n可能であれば仮面を着けて下さい。その場合も、目はちゃんと描写されていてほしいです。\nマントは必ずお願いします。\n蝶ネクタイはあまり好みませんので避けて下さい。\n\n世界観は中世ヨーロッパのような感じ。\n場所は都市の家が連なるところ、または屋根の上(変更可)。\n時間帯は夜のイメージ。\n表情は口を閉じたままニヤリと笑っているといいかもしれません。少しキザな印象を受ける感じです。\n\nご検討よろしくお願いいたします。\n\nhttps://twitter.com/i/events/1503506811403444225?s=21", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fff_mee/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 20068, "client_id": 1373895, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c8969a9/uploads/origins/3892ef6c-25ab-4bd2-8a07-33cf34af1bba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f0c608dc60abdcf44180f9bf95d50e7", "srcset": "https://si.imgix.net/5c8969a9/uploads/origins/3892ef6c-25ab-4bd2-8a07-33cf34af1bba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f0c608dc60abdcf44180f9bf95d50e7, https://si.imgix.net/5c8969a9/uploads/origins/3892ef6c-25ab-4bd2-8a07-33cf34af1bba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a32552404df8a480a71d0f243a3848f3 2x, https://si.imgix.net/5c8969a9/uploads/origins/3892ef6c-25ab