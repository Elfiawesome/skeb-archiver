/NV3QKxLy8KW8OHPU7pZemnqaJAF3\n\n\nご検討をよろしくお願いします。\n\nhttps://x.com/tomoshibiyura/status/1764089903468699847?s=20", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kioku_koshitsu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2595866, "client_id": 3236640, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9752a0c/uploads/origins/d83e947c-75ac-4e07-9bf6-d926dd2cf906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6781f9c5fd1cea041ad5807493a9b43", "srcset": "https://si.imgix.net/e9752a0c/uploads/origins/d83e947c-75ac-4e07-9bf6-d926dd2cf906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6781f9c5fd1cea041ad5807493a9b43, https://si.imgix.net/e9752a0c/uploads/origins/d83e947c-75ac-4e07-9bf6-d926dd2cf906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d7d4ffcab2cb92545913703ed2514ff 2x, https://si.imgix.net/e9752a0c/uploads/origins/d83e947c-75ac-4e07-9bf6-d926dd2cf906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c1468db7cd1d64c2e98b42ca237389f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9752a0c/uploads/origins/d83e947c-75ac-4e07-9bf6-d926dd2cf906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8223b4a8745c2dc7a77cd122377355ff", "srcset": "https://si.imgix.net/e9752a0c/uploads/origins/d83e947c-75ac-4e07-9bf6-d926dd2cf906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8223b4a8745c2dc7a77cd122377355ff, https://si.imgix.net/e9752a0c/uploads/origins/d83e947c-75ac-4e07-9bf6-d926dd2cf906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fae5f779600c887fdcb92d8cb0f7d219 2x, https://si.imgix.net/e9752a0c/uploads/origins/d83e947c-75ac-4e07-9bf