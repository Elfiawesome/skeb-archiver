6d51-9372-406d-b324-7b505a03ccf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1673a353a45001f243506111aafb528c", "srcset": "https://si.imgix.net/55c1f5ce/uploads/origins/3d056d51-9372-406d-b324-7b505a03ccf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1673a353a45001f243506111aafb528c, https://si.imgix.net/55c1f5ce/uploads/origins/3d056d51-9372-406d-b324-7b505a03ccf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed94332282e70e4504543c60eeaf2ed0 2x, https://si.imgix.net/55c1f5ce/uploads/origins/3d056d51-9372-406d-b324-7b505a03ccf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=61d1715a37ddc6ca7f9427f0d44075ac 3x"}, "body": "こんにちは！あなたの画風がとても好きなので、私のOCを描いてほしいです。\n彼の名前はトースト、冷たい白い肌、無口で内向的な気質、そしてスリムな体型。彼はマヌルの獣人であり、公爵の側室には好かれていない小さな領主で、森で遊ぶのが好きだ。蝶が友達であり武器。彼の髪と目はピンク色で、右側に一房余分な髪がある。\nこの絵を見て気に入ったので<https://skeb.jp/@fuwafuan_/works/1>。\nポーズや構図などはお任せします。彼を描きたいなら何を描いても構いません。彼に新しい服を着せてあげられると素敵です。\n\n依頼内容に問題があれば遠慮なくお断りください。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1dyE0AcInEzK-4vKymYBQThj1ngqOwd-c?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fuwafuwafuan_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1473424, "client_id": 1486104, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1eeac79c/uploads/origins/bb140dd0-caa5-4ae5-b8c4-850d56980b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3779aa8cdd4908a8880db298eb21f1f", "srcset": "https://si.imgix.net/1eeac79c/uploads/origins/bb140dd0-caa5-4ae5-b8c4-850d56980b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3779aa8cdd4908a8880db298eb21f1f, https://si.imgix.net/1eeac79c/uploads/origins/bb140dd0-caa5-4ae5-b8c4-850d56980b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78fe202da1bbc85e13d3536146a27768 2x, https://si.imgix.net/1eeac79c/uploads/origins/bb140dd0-caa5-4ae5-b8c4-850d56980b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38d782c42ed1fa201c7e086eda00f11b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1eeac79c/uploads/origins/bb140dd0-caa5-4ae5-b8c4-850d56980b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4c646cd3a9c9f426cfcc91a6f2fc425", "srcset": "https://si.imgix.net/1eeac79c/uploads/origins/bb140dd0-caa5-4ae5-b8c4-850d56980b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4c646cd3a9c9f426cfcc91a6f2fc425, https://si.imgix.net/1eeac79c/uploads/origins/bb140dd0-caa5-4ae5-b8c4-850d56980b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bb4f6ef897cc8168aa19ce1d9809f6b6 2x, https://si.imgix.net/1eeac79c/uploads/origins/bb140dd0-caa5-4ae5-b8c4-850d56980b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a494032ea0440d6ef4c5f0c8ed3955d3 3x"}, "body": "(申し訳ございません、書き損ねがあったため1度キャンセルさせて頂きました。)\n不安さまはじめまして、skebの開設ありがとうございます。不安さまのイラストが大好きで、ぜひ私のOCを描いていただきたいと思いリクエストさせていただきました。\n\n名前 クロエ(ギリシア語で新芽、若草、開花、豊穣の意味を持ち、輝くという言葉が由来）\n20代前半。ピンク色の長髪にグレーの瞳。\n伏せ目がちで上下睫毛の色はピンク、量多め\n身長は182cm〜(が、ヒールで盛っているため実際は175cm程)\nホテルの接待人として働いている。\n耽美で大人しそうな見た目をしているが、それなりの頻度で仕事をサボったり、面倒事を嫌う気ままな性格。\n好きな物｜自由、アフターヌーンティー、旅行、美しいもの\n嫌いなこと｜他人に縛られること\n紅茶・コーヒーを淹れるのがとても得意で料理もそれなりに出来る手先の器用な人間だが、運動は専門外。仕事柄知識はあるもののお酒に弱い。\n普段は無表情で、客の前では営業スマイルである事が多い。(微笑み程度)\n非常に女性にモテており、仕事外やアフターヌーンティー中などに他者に付きまとわれるのを忌避し たまに女装をすることがある。\n(彼は特になにも考えていないが、女装時に仮面を付けるため周りからは高位の貴族だと思われている。何故か正体はバレていない。もし不埒な気持ちで近づく輩がいれば海に沈められる。)\n仕事中は完璧であるにも関わらずオフモードは危機感が無かったり、女装をする理由がおかしかったり、かなり他人と考え方がズレている。\n\n正面から見て右の耳にイヤーカフを付けています。どのようなものでも大丈夫ですが、彼は美しいものが好きなので宝石がついたデザインであると嬉しいです。\nお洋服ですが、まだ詳細なデザインが決まっておらず、不安さまにおまかせしたいと考えています。19世紀後期のイギリスをモチーフとした国に住んでいるので、中世っぽかったり、ファンタジーっぽい服であると有難いです。\n難しければスーツ姿でお願い致します。\nまた、表情や構図もおまかせします。お好きに描いていただけたら嬉しいです。\nご縁がありましたらよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-dSSaZBLKjJxMCX7wkaSkhCM7q_47kRg", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fuwafuwafuan_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1473424, "client_id": 2760195, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61ebe413/uploads/origins/d1d30f9a-7fd3-4d63-a6cd-bfbf70dc1ff8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01c432857d4b658d398edd1f7fe3e5d6", "srcset": "https://si.imgix.net/61ebe413/uploads/origins/d1d30f9a-7fd3-4d63-a6cd-bfbf70dc1ff8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01c432857d4b658d398edd1f7fe3e5d6, https://si.imgix.net/61ebe413/uploads/origins/d1d30f9a-7fd3-4d63-a6cd-bfbf70dc1ff8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db58a3656b2edeb24fcb0c84c0c0d75c 2x, https://si.imgix.net/61ebe413/uploads/origins/d1d30f9a-7fd3-4d63-a6cd-bfbf70dc1ff8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65d7d2716cd358ff2d29e477b8beb6e5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61ebe413/uploads/origins/d1d30f9a-7fd3-4d63-a6cd-bfbf70dc1ff8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6107b9dbd1923467e081f403ac4e101", "srcset": "https://si.imgix.net/61ebe413/uploads/origins/d1d30f9a-7fd3-4d63-a6cd-bfbf70dc1ff8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6107b9dbd1923467e081f403ac4e101, https://si.imgix.net/61ebe413/uploads/origins/d1d30f9a-7fd3-4d63-a6cd-bfbf70dc1ff8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3db757096d685d7184b6f5c06f52953e 2x, https://si.imgix.net/61ebe413/uploads/origins/d1d30f9a-7fd3-4d63-a6cd-bfbf70dc1ff8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a53d4d694b31a109cfa6b37d58faae6 3x"}, "body": "■依頼\n\n私と友人のオリジナルキャラクターのイラスト\n\n■詳細\n\n資料:https://drive.google.com/drive/folders/1PC9AWYCn5jRg4XZrSGeCfYZ_I7BRhbPf\n\n・亜音亜 音亜音(あねあ ねあね) (26) 150cm 女\nファンの「お姉ちゃん」がコンセプトの普通のアイドル。\n快活でしっかり者。公私ともに「お姉ちゃん」であろうとしており、自責思考が強い。\nしかし律との交流を経て他人に寄りかかれるようになった。\n律は音亜音にとって初めてできた信頼できる深い関係の友人であり、年下の可愛い男の子。\n\n・柊木 律(ひいらぎ りつ) (23) 190cm 男\n大人気アイドルユニット「R'」の片割れ。\n活発な性格。歌っている姿はクールなので勘違いされがち。おしゃべりが好きで人懐こい。\nこれと決めたことを曲げられない頑固な一面がある。\n音亜音は律にとって初めてできた信頼できる深い関係の友人であり、年上の頼れる女性。\n\nふたりはアイドル番組での共演で知り合い、様々な交流を経て友人となりました。\n交流の中には非現実的な事件も含まれており、そのような事件に巻き込まれながら、互いの胸の内をさらけ出し、周囲には話さないような秘密を共有しています。\n同業者であり友人であり共犯者でもある、互いに人としてリスペクトしている存在です。\n\n不安様のイラストのシックな色合いを素敵だと思ったので、「亜音亜 音亜音-7」と「柊木 律-7」の衣装で描いて頂きたいです。\n\n■用途\n\n・個人観賞用のグッズの作成\n・不安様の名前を明記したうえでのSNSのアイコンやヘッダーへの使用\n\n金額に不足があれば再送お願い致します。\nご検討の程宜しくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fuwafuwafuan_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1473424, "client_id": 931040, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60b39ec6/uploads/origins/a03b30f6-1efe-407a-a7fd-1b66f8629db5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58806884a033faf076c2fe5137a1dc83", "srcset": "https://si.imgix.net/60b39ec6/uploads/origins/a03b30f6-1efe-407a-a7fd-1b66f8629db5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58806884a033faf076c2fe5137a1dc83, https://si.imgix.net/60b39ec6/uploads/origins/a03b30f6-1efe-407a-a7fd-1b66f8629db5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba866f71cda283fddf668fd5869b46ce 2x, https://si.imgix.net/60b39ec6/uploads/origins/a03b30f6