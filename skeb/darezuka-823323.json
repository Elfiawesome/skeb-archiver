4ebd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=793722e6800cff1979f8292dfc376c0c 3x"}, "body": "私のオリジナルキャラクター、バイオレットを描いてください\n構図などは自由ですので、ご自由に描いてください\n\nありがとうございました！\n\nhttps://twitter.com/ac8231/status/1498290776777756673?s=20&t=K4CFeu43QBVwL8EoEWnvxA", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@darezuka/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 148202, "client_id": 295299, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93e98c29/uploads/origins/975123ab-ae61-4611-9ca8-a443615355ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e39d4614bde35503fb529e4c235b3fc3", "srcset": "https://si.imgix.net/93e98c29/uploads/origins/975123ab-ae61-4611-9ca8-a443615355ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e39d4614bde35503fb529e4c235b3fc3, https://si.imgix.net/93e98c29/uploads/origins/975123ab-ae61-4611-9ca8-a443615355ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ff062930c10b8a5cabaf7b8f9d463f3 2x, https://si.imgix.net/93e98c29/uploads/origins/975123ab-ae61-4611-9ca8-a443615355ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4179e831510df52d6847c7cb07fbfc1a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93e98c29/uploads/origins/975123ab-ae61-4611-9ca8-a443615355ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cd32d1f016f8b471171cf52875ae5cf", "srcset": "https://si.imgix.net/93e98c29/uploads/origins/975123ab-ae61-4611-9ca8-a443615355ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cd32d1f016f8b471171cf52875ae5cf, https://si.imgix.net/93e98c29/uploads/origins/975123ab-ae61-4611-9ca8-a443615355ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ba2a1deba4d84299b99356d21b241f0f 2x, https://si.imgix.net/93e98c29/uploads/origins/975123ab-ae61-4611-9ca8-a443615355ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fc64a0bf54800f553af8c8fe32694ba4 3x"}, "body": "こんにちは。前回は非常にお世話になりました\n再びリクエスト失礼致します\n\n【キャラクター】\nプリンセスコネクト！Re:Diveのヒヨリ\n【シチュエーション】\nモブおじさんとイチャラブベロチューからの手繋ぎ騎乗位セックスをお願いします\n流れとしては、\n1.ヒヨリはおじさんの首に腕を回し、おじさんはヒヨリの尻を揉みしだきながらベロチュー\n2.ヒヨリが勃起したペニスを手で擦りながらベッドに誘う\n3.手繋ぎ騎乗位。力強く腰を振って射精を促す\n4.中出し射精。同時にヒヨリも絶頂\n5.下腹部に手を当てながら絶頂の余韻に浸る。目にハートを浮かべながらもう一回セックスをねだる\nといった感じでお願いしたいです\nおじさんのペニスは太く長く、カリも高い感じの形だと嬉しいです\nまた、ヒヨリの陰毛は濃いめに描写していただけると助かります\n上記以外の細かいところについては、誰塚さんにお任せいたします\n\n前回よりも注文が多いですが、是非ともご検討のほどよろしくお願いします", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@darezuka/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 148202, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/82ed131e/uploads/origins/91cdf80d-17b5-4494-8597-a0ff14e39798?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68ac4957a6823aa714644e2c3bb805a0", "srcset": "https://si.imgix.net/82ed131e/uploads/origins/91cdf80d-17b5-4494-8597-a0ff14e39798?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68ac4957a6823aa714644e2c3bb805a0, https://si.imgix.net/82ed131e/uploads/origins/91cdf80d-17b5-4494-8597-a0ff14e39798?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cb4c5e6db3c989f6491e30c893e4358 2x, https://si.imgix.net/82ed131e/uploads/origins/91cdf80d-17b5-4494-8597-a0ff14e39798?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85edbfcda8536f453227d88d12379f1a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82ed131e/uploads/origins/91cdf80d-17b5-4494-8597-a0ff14e39798?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b39b81c59b536aaad36375bf666d78c", "srcset": "https://si.imgix.net/82ed131e/uploads/origins/91cdf80d-17b5-4494-8597-a0ff14e39798?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b39b81c59b536aaad36375bf666d78c, https://si.imgix.net/82ed131e/uploads/origins/91cdf80d-17b5-4494-8597-a0ff14e39798?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f5376caf515438e5c19251a577c53c9d 2x, https://si.imgix.net/82ed131e/uploads/origins/91cdf80d-17b5-4494-8597-a0ff14e39798?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=742bbda19a5aa037fab4ad2dac53c81d 3x"}, "body": "はじめまして。Twitterで見た男の娘喫茶が素晴らしかったのでぜひリクエストさせてください。\n資料URLの男の娘が、より忙しい時のイラストをお願いします。コックリングゴムが3つ以上に増やされていて振動が止まらない状態です。既に何回かイッているため精液が太ももから垂れており、服はベタベタの状態になっています。それでもなんとかお客様の注文を聞いています。\nミルクティー以外にも練乳パフェやチーズケーキなど連想させる注文を多めに言わせて欲しいです。\nよろしければご一考願います。\n\nhttps://twitter.com/darezuka/status/1591327772521426947?t=CnLMtHdhCB8_q3QvupamqQ&s=19", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@darezuka/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 148202, "client_id": 295299, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84e5a0ef/uploads/origins/4a058eed-e674-4661-9d7d-487433eb2546?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06c60ceddb8a5d6a98b4678f1b848c5e", "srcset": "https://si.imgix.net/84e5a0ef/uploads/origins/4a058eed-e674-4661-9d7d-487433eb2546?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06c60ceddb8a5d6a98b4678f1b848c5e, https://si.imgix.net/84e5a0ef/uploads/origins/4a058eed-e674-4661-9d7d-487433eb2546?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02cc81c12b49eb6ffe94487f5a92e364 2x, https://si.imgix.net/84e5a0ef/uploads/origins/4a058eed-e674-4661-9d7d-487433eb2546?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e11747a31557248a272cc028216f42a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84e5a0ef/uploads/origins/4a058eed-e674-4661-9d7d-487433eb2546?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16a6d91b6433cf399b07e20dc8a192b1", "srcset": "https://si.imgix.net/84e5a0ef/uploads/origins/4a058eed-e674-4661-9d7d-487433eb2546?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16a6d91b6433cf399b07e20dc8a192b1, https://si.imgix.net/84e5a0ef/uploads/origins/4a058eed-e674-4661-9d7d-487433eb2546?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cab8ee37afcb23c123a641b997f24ca3 2x, https://si.imgix.net/84e5a0ef/uploads/origins/4a058eed-e674-4661-9d7d-487433eb2546?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f872364e0d28225e27561465db9a81dd 3x"}, "body": "初めまして。リクエスト失礼致します\n\n【キャラクター】\nプリンセスコネクト！Re:Diveのチエル\n【シチュエーション】\n仮性包茎ペニスをフェラ抜きするイラストをお願いします\n流れとしては、\n1.チン嗅ぎして臭がる\n2.皮フェラでお掃除\n3.ひょっとこフェラで激しくストローク\n4.射精＆ごっくん\nといった感じでお願いしたいです\nチエルの態度は渋々やっているといった感じだと嬉しいです\nその他の要素（構図や服装等）については特に指定はありません。誰塚さんにお任せいたします\n\nお忙しいかと思いますが、是非ともご検討のほどよろしくお願いします", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@darezuka/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 148202, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f09a2b30/uploads/origins/adef66ea-7ec4-41be-8b1c-b879e49848ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20466307cd2ab89a1bb0c71caa11394e", "srcset": "https://si.imgix.net/f09a2b30/uploads/origins/adef66ea-7ec4-41be-8b1c-b879e49848ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20466307cd2ab89a1bb0c71caa11394e, https://si.imgix.net/f09a2b30/uploads/origins/adef66ea-7ec4-41be-8b1c-b879e49848ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edf7d8b763d201a12bcff0b4e2a17ce9 2x, https://si.imgix.net/f09a2b30/uploads/origins/adef66ea-7ec4-41be-8b1c-b879e49848ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2dd330b5941218ae8f8ff57732b110d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f09a2b30/uploads/origins/adef66ea-7ec4-41be-8b1c-b879e49848ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=445e77e281209fbcfa15a4da1c44df88", "srcset": "https://si.imgix.net/f09a2b30/uploads/origins/adef66ea-7ec4-41be-8b1c-b879e49848ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=445e77e281209fbcfa15a4da1c44df88, https://si.imgix.net/f09a2b30/uploads/origins/adef66ea-7ec4-41be-8b1c-b879e49848ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2f8b77992b18d5aeea7f4ae3c1769a70 2x, https://si.imgix.net/f09a2b30/uploads/origins/adef66ea-7ec4-41be-8b1c-b879e49848ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e067447f1098f950292c2368292c7fdd 3x"}, "body": "トイレの地味子さんからファンになりました。ねっとりえっぐいフェラ描写にはお世話になっています。\n　以前描かれたペコリーヌの腰抱きフェラを詳細ありで描いていただきたいです。\nhttps://twitter.com/darezuka/status/1475060192333414401\n①腰に抱き着きながらのフェラで口内射精させ、嫌な顔１つせずに美味しそうにごっくん\n②射精後も口を離さずお掃除フェラを続け、男側が耐えられなくなり腰を引こうとする\n③ペコリーヌが「こ～ら♡らめれふよ♡まだ残ってまふから♡」と奥深くまで咥え込み、更に強く抱き着く\n④「中に残っへるのも吸い出してあげまふね♡」と言い、音を立ててえっっぐいバキュームフェラをして、もう一度口内射精させる\n⑤精液を一滴残らず飲み干してから、ようやく唾液でドロドロになってぐったりしたペニスを離す\n⑥「美味しかったですよ♡また飲ませてくださいね♡」といい亀頭に優しくキス\nという流れでお願いします。\n男側も足をがくつかせたりしている描写があると嬉しいです。注文が多くすみませんが何卒よろしくお願いいたします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@darezuka/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 148202, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83ff8239/uploads/origins/c3b9b373-f4d8-4ef7-83bf-bbf95676ea88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b686827ee111e99907bd84e5d87c8b6", "srcset": "https://si.imgix.net/83ff8239/uploads/origins/c3b9b373-f4d8-4ef7-83bf-bbf95676ea88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b686827ee111e99907bd84e5d87c8b6, https://si.imgix.net/83ff8239/uploads/origins/c3b9b373-f4d8-4ef7-83bf-bbf95676ea88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eedff3ff5c520bf05bd356b7fb3e9959 2x, https://si.imgix.net/83ff8239/uploads/origins/c3b9b373-f4d8-4ef7-83bf-bbf95676ea88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4f6bdf3898887cff4daac950e35414d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83ff8239/uploads/origins/c3b9b373-f4d8-4ef7-83bf-bbf95676ea88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb81da9b6b9b4d376f61d2f3f403f30e", "srcset": "https://si.imgix.net/83ff8239/uploads/origins/c3b9b373-f4d8-4ef7-83bf-bbf95676ea88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb81da9b6b9b4d376f61d2f3f403f30e, https://si.imgix.net/83ff8239/uploads/origins/c3b9b373-f4d8-4ef7-83bf-bbf95676ea88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1cb4024e022b4d8e7aee3b7708a7f6ed 2x, https://si.imgix.net/83ff8239/uploads/origins/c3b9b373-f4d8-4ef7-83bf-bbf95676ea88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=686b639efc6aca44be5d7796cbc378e6 3x"}, "body": "初めまして。匿名にて失礼します。\n\n夏色花梨パイセンのイラストを依頼したいです。(以下参考イメージ)\nhttps://twitter.com/karin_info1/status/1610902961743626240\nhttps://twitter.com/karin_info1/status/1623606754574761984\nhttps://twitter.com/voiceeroid/status/1635681549965475840\n\nシチュは下記一枚目の、目隠しもの当てゲームが好きなので似たようにお願いします。\nhttps://www.pixiv.net/artworks/97659773\n協力者役は、後輩の小春六花の想定ですが、省略しても大丈夫です。\n(おっぱいを見せたりはせず、むしろ動画撮影をするなど、一緒にパイセンを辱めるイメージ)\nhttps://twitter.com/rikka_info/status/1540146397244100608/\n\n竿役は仮性包茎で、チンカスが溜まって匂っている様子。\n(苦手ジャンルでしたら、描写は省略して大丈夫です)\n皮フェラ状態で、匂いを嗅ぎながら、\n(…？すごい匂いだけど…何かしら？チーズ？ 味は好きかも… ちょっとクセになりそう)\nみたいなイメージでお願いします。\n\nよろしければご検討のほど、よろしくお願いいたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@darezuka/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f994ce4c/uploads/origins/dd5a7c31-3c75-4178-9726-fe81aed6d7e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a71c06b303b54afa270cf2f8f97b3b45", "srcset": "https://si.imgix.net/f994ce4c/uploads/origins/dd5a7c31-3c75-4178-9726-fe81aed6d7e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a71c06b303b54afa270cf2f8f97b3b45, https://si.imgix.net/f994ce4c/uploads/origins/dd5a7c31-3c75-4178-9726-fe81aed6d7e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b8db40e019f1d995ac648bd48827a93 2x, https://si.imgix.net/f994ce4c/uploads/origins/dd5a7c31-3c75-4178-9726-fe81aed6d7e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99655b1496d82aa7475914941a3aedcd 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 148202, "client_id": 401919, "nc": 160}, {"path": "/