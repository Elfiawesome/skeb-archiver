p_rv-_93.png?rlkey=tbtcz27qwb1hv8jsynrklaolr&dl=0\n参考：プロフィール\nhttp://www.numbertales-radiann.com/characters/character93.html\n\n＜共通＞\n参考：共通の設定・配色について（Dropbox)\nhttps://www.dropbox.com/scl/fi/56xoz03ixhnnu7zffpqmf/.png?rlkey=nfcl0bgbfuth8p7mn1dnr3xzs&dl=0\n人型と球体型でどちらの姿を描いてくださっても構いません。差し支えなければこれまでご納品いただいたものと同様のイラストをご制作頂けますと幸いです！\n\n【主な用途】\n原則 個人的な閲覧用として使用します。ただし、Misskey内で稼働する「ナンバーテールズ」の公式Botにてプロフィール画像に使用させていただくことがあります。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@minikitty/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2730396, "client_id": 2795473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f3b126e/uploads/origins/30f62526-5f08-4d5c-ad3e-4974ba40dd26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e06188da47824f6b264397aefdf7d94", "srcset": "https://si.imgix.net/0f3b126e/uploads/origins/30f62526-5f08-4d5c-ad3e-4974ba40dd26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e06188da47824f6b264397aefdf7d94, https://si.imgix.net/0f3b126e/uploads/origins/30f62526-5f08-4d5c-ad3e-4974ba40dd26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f0d8a0f0e73ea9cd47fbc49571d866d 2x, https://si.imgix.net/0f3b126e/uploads/origins/30f62526-5f08-4d5c-ad3e-4974ba40dd26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb963356689dc1ad4976b4db15207f09 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f3b126e/uploads/origins/30f62526-5f08-4d5c-ad3e-4974ba40dd26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8eb2e827762d20d2f764dc40d64316c", "srcset": "https://si.imgix.net/0f3b126e/uploads/origins/30f62526-5f08-4d5c-ad3e-4974ba40dd26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8eb2e8277