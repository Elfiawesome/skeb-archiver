9cc6a657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2997db3cfd099f216b5557034aacb232, https://si.imgix.net/b71b2ede/uploads/origins/90bd1be0-b814-4040-96ba-80149cc6a657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fed34b84089ba98666f673a34da68ca5 2x, https://si.imgix.net/b71b2ede/uploads/origins/90bd1be0-b814-4040-96ba-80149cc6a657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f35b425dd4c06cdf527c79bc6b2cbaf4 3x"}, "body": "はじめまして！\nvtuberデビュー準備中の白華くれると申します。\n\nXで七星マナ様の作品を拝見して、カラフルで鮮やかな色使いにとても惹かれ、ぜひ自分のキャラクターを描いていただきたくご依頼いたしました。\n\nキャラクターは「白華くれる」、花をモチーフにした花霊族の女の子です。七星マナ様らしい色使いで表現していただけるとうれしいです。\n\n麻雀配信のサムネイルとして使用したいと考えております。\n構図やポーズはお任せいたしますが、麻雀牌を持った姿を描いていただけるとうれしいです。\n（牌は描きやすいもので良いですが、七星マナ様に描いていただけるのであれば、筒子がかわいいかなと思いました……！）\n\nまた、サムネイルで使用する都合上、可能であれば手や頭が見切れない構図だと大変助かります。（足元は見切れていても問題ございません。）\n\n背景透過版もご対応可能でしたらお願いできますと幸いです。\n\n三面図の準備がなく申し訳ないのですがまだ、\n添付資料に立ち絵がございますので、ご確認いただけますと幸いです。\n\nご縁があるとうれしいです！よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1sfO2eq-baHFWAtK-N86lK1qZFZO5pRdc", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@manya_ravilia/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3920614, "client_id": 3828454, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee3d5871/uploads/origins/7d646adf-6f02-411f-9a52-1c7d05bdbc43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d9f2bec59b6603fe974ced0bce9399d", "srcset": "https://si.imgix.net/ee3d5871/uploads/origins/7d646adf-6f02-411f-9a52-1c7d05bdbc43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d9f2bec59b6603fe974ced0bce9399d, https://si.imgix.net/ee3d5871/uploads/origins/7d646adf-6f02-411f-9a52-1c7d05bdbc43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e15baad520