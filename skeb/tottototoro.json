f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4206c436a263d74b0efbd33330384d6b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 721126, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tottototoro/works/204", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 721126, "client_id": 2556644, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17dd9463/uploads/origins/27d41737-7d3e-41f5-83f1-f998488e3286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77eee6512dc79fc9ef3d32100f0e7501", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17dd9463/uploads/origins/27d41737-7d3e-41f5-83f1-f998488e3286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=084c6f22489bbca74d851d3ec5922fa4", "src_set": ""}, "body": "ゴーダさん、お久しぶりです。\n\n今回は友人のオリジナルキャラクター【梦魇Tsuki】のアートワークを依頼したいのですが、こちらのリンクをご参照ください：\n【drive.google.com/file/d/16-00RZGMM4U413j3OcfeWiA3Oie4lDoq】\n【drive.google.com/file/d/10MDZZolwUDMd106Cn7YQ9c7bNpKQI86b】\n\n今回は、既存の衣装を使用するのではなく、キャラクターの衣装をデザインしていただきたいです。OL风の衣装セット（ジャケットを含む）をデザインしてください。参考には【www.pixiv.net/artworks/104493331】のデザインをご参照ください。複雑にする必要はありませんが、髪の色が異なり、胸のサイズも異なるため、シャツの色を調整するなど、一部の手直しが必要です。\n髪型については、私が髪型を正確に説明するのが難しいため、【drive.google.com/file/d/1jAaKeXd9CtAsSqKMD-VeDSiyASTWcLnQ】にロングヘア向けの髪型を参考に見つけておきました。ご自由に調整してください。ただし、元の月形の髪飾りはそのまま適用してください（キャラクターを区別するため）\n===\nこのキャラクターがオフィスチェアに縛られているシーンを描いてください。基本的には上記の例に類似していますが、縛り方、テープ/ロープの素材など、詳細はご自由に調整してください。\n===\nシーン2では、キャラクターが同じポーズで下着とストッキングのみを着用している状態を描いてください。また、ストッキングの開口部にバイブ