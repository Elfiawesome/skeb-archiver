rop&crop=top&w=200&h=200&s=7ea8a9b5265418ba287cb5c4a1701ceb 2x, https://si.imgix.net/9a2cc3de/uploads/origins/4d89d1f2-36bc-4e16-9e56-606c742e0778?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=5127d56c3c2c69da4732fde731921bbe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a2cc3de/uploads/origins/4d89d1f2-36bc-4e16-9e56-606c742e0778?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=87631bc07dade63ac96fa9f55feac167", "srcset": "https://si.imgix.net/9a2cc3de/uploads/origins/4d89d1f2-36bc-4e16-9e56-606c742e0778?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=87631bc07dade63ac96fa9f55feac167, https://si.imgix.net/9a2cc3de/uploads/origins/4d89d1f2-36bc-4e16-9e56-606c742e0778?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c6a0fd1a77e63c1195d2697f00780f4 2x, https://si.imgix.net/9a2cc3de/uploads/origins/4d89d1f2-36bc-4e16-9e56-606c742e0778?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8afefd9b2e7cd0010533361ee4f2b2fe 3x"}, "body": "私のツイッターアイコン(https://pbs.twimg.com/profile_images/1073575089671593985/QWzE7sh_.jpg)のキャラ、ルークが、一口サイズくらいのサイズ感で、ドラゴンさんかケモノさんに丸呑みにされてしまう作品をお願いします\n丸呑みは、翼を摘まれて持ち上げられて口に運ばれている様子\n口に入れてしまいもぐもぐな様子\n飲み込まれてしまう様子\nお腹に入れられてしまった様子\nを体内の様子を吹き出しで…といった形でお願いしたいと思います\n\nまた、ツイートによる紹介を許可頂きたく思います\nよろしくお願いします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@caloupgaro/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3513398, "client_id": 251120, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d75f26ee/uploads/origins/10132692-d666-45e1-a9f6-e82d9ed6a228?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=70314f0e23137d36b579309098c33876", "srcset": "https://si.imgix.net/d75f26ee/uploads/origins/10132692-d666-4