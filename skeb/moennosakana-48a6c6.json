るようなイメージ\n恥ずかしがりながらもえっちなことを期待しているような表情\nポーズ、服の脱ぎ具合などはお任せします（細かい装飾などは省略･アレンジしていただいて構いません）\n資料（ゲーム内モデル）では胸が大きめですが、Bカップくらいのイメージでお願いします\nベルト部分はデザイン画（元ネタの元ネタ）を参考にスカートと離れすぎない感じで\n別ファイル（基本顔犬耳、尻尾イメージ）の犬耳と尻尾（毛先の黒部分まですべて白で）をつけてあげてください\n尻尾はプラグが付いていてお尻に挿入されているという設定です\n\nご検討をお願いします\n\nhttps://drive.google.com/drive/folders/1uHhgo2uiWAiNE8_YBjz3yRB1eYfVMlt7", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@fJeopSWvJRrpwMF/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2874178, "client_id": 1057783, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/694cd744/uploads/origins/a8897df2-76a1-4fe5-ac0a-be5792af3560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9ee9e75161f3d7eb8c280045908b9f4", "srcset": "https://si.imgix.net/694cd744/uploads/origins/a8897df2-76a1-4fe5-ac0a-be5792af3560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9ee9e75161f3d7eb8c280045908b9f4, https://si.imgix.net/694cd744/uploads/origins/a8897df2-76a1-4fe5-ac0a-be5792af3560?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50216e03995d8c63bb9d0ba3d84ce880 2x, https://si.imgix.net/694cd744/uploads/origins/a8897df2-76a1-4fe5-ac0a-be5792af3560?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9aa1ba540ab021b2241b3ac1c9f44978 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/694cd744/uploads/origins/a8897df2-76a1-4fe5-ac0a-be5792af3560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8eb8c5410d04b23110952e951f61aa1", "srcset": "https://si.imgix.net/694cd744/uploads/origins/a8897df2-76a1-4fe5-ac0a-be5792af3560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8eb8c5410d04b23110952e951f61aa1, https://si.imgix.net/694cd7