op&crop=top&w=200&h=200&blur=200&s=3825b42eaf8f55b25c0e4869c6f5abbb 3x"}, "body": "どうもこんにちは！\nnomayukiさんの色々レトロファイアーエムブレム娘イラストがとても綺麗なので同じようFE娘イラストをお願いします。\n・FE聖魔のミルラ様を希望します。コスはGBAの服みたいとか、サイファーみたいとか、ヒーローズみたいとか、どれでもいいです。\n・シチュエーションはnomayukiさんにお任せします。のんびりか着姿でくつろいでるシーンみたいが良いかもしれません、例えば座りながら見る人に向かっている・散歩しながら・食べながら、飲みながら・肩越しの小さい笑顔ながら・普通の胸に手を重ねながら・などなど。もちろん、nomayukiさんの水着インクリッドかハロワユみたいのかっこかわいいダイナミックポーズも良い。\n・場所と背景、ポーズ、視点、表情、ライティング、構図、詳細などもお任せ。ミルラの温厚けど優しい妹キャラと大人っぽい伝説の竜人様キャラの2つの感じがあるならなんでも良いんです。\n\nほとんどおまかせの依頼本当に申し訳ございません。でもよかったらよろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kamikita246/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 638390, "client_id": 1006655, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f80da279/uploads/origins/15bde3bb-285f-48e5-8009-c47b8b20853e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a474bf15efa3a3d5c5d0460321a4d9fa", "srcset": "https://si.imgix.net/f80da279/uploads/origins/15bde3bb-285f-48e5-8009-c47b8b20853e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a474bf15efa3a3d5c5d0460321a4d9fa, https://si.imgix.net/f80da279/uploads/origins/15bde3bb-285f-48e5-8009-c47b8b20853e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91ca7f1133c3cc6bac6aeab45ad58c97 2x, https://si.imgix.net/f80da279/uploads/origins/15bde3bb-285f-48e5-8009-c47b8b20853e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=347b5c94e1cecd15762a3056eb24cffb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f80da279/uploads/origins/15bde3bb-285f-48e5-8009-c47b8b20853e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d726c4758004b33397e21fc26987c4f3", "srcset": "https://si.imgix.net/f80da279/uploads/origins/15bde3bb-285