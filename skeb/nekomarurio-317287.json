e50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff309768ecf2eb071be8f60bb5fd1f20, https://si.imgix.net/cf722b9f/uploads/origins/3d1a612c-d19a-4a1e-8246-cb8b98b31e50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f68cd4875c76228d8c5bfd8f2c498313 2x, https://si.imgix.net/cf722b9f/uploads/origins/3d1a612c-d19a-4a1e-8246-cb8b98b31e50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8d749bc6de0b3618dc9cb0e4e1e0a7d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf722b9f/uploads/origins/3d1a612c-d19a-4a1e-8246-cb8b98b31e50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6b56cf393de03bae73cef86607d93be", "srcset": "https://si.imgix.net/cf722b9f/uploads/origins/3d1a612c-d19a-4a1e-8246-cb8b98b31e50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6b56cf393de03bae73cef86607d93be, https://si.imgix.net/cf722b9f/uploads/origins/3d1a612c-d19a-4a1e-8246-cb8b98b31e50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=468173a6ec202ea6c2c84576f75eb8ff 2x, https://si.imgix.net/cf722b9f/uploads/origins/3d1a612c-d19a-4a1e-8246-cb8b98b31e50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a75916d7284e06c63d559d28e7e2efc0 3x"}, "body": "こんばんは！\n猫丸りおさんの描かれる感情がこもってるような魅力的な表情や、おめめ(眼差し)が好きなので楽しみに見させて貰ってました…！\n\n今回東方でフランドールのイラストをお願いしたいです。\n\n内容は\n(時期外れで失礼します)\n振袖を着てお正月、初詣な感じで嬉しそうにはしゃいでるフランちゃんをお願いします…！\n\nお顔がみたいのでこちら目線で、\nキャラ(フランちゃん)メインで背景等は簡単で大丈夫です。\n\n(可能であればで構いませんので、表情の差分があると嬉しいのでお願いしたいです)\n\n以上が依頼内容になります。\nお手隙の時等で構いませんので、ご検討よろしくお願いします…！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nekomarurio/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1917743, "client_id": 2168110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce540f6a/uploads/origins/490cfb42-ef86-4499-a263-1b9adfa16b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d731fd28cc2dd82cd1a8053372d89f0", "srcset": "https://si.imgix.net/ce540f6a/uploads/origins/490cfb42-ef86-4499-a263-1b9adfa16b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d731fd28cc2dd82cd1a8053372d89f0, https://si.imgix.net/ce540f6a/uploads/origins/490cfb42-ef86-4499-a263-1b9adfa16b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79120cdeda8a8036f0873b024a71fafc 2x, https://si.imgix.net/ce540f6a/uploads/origins/490cfb42-ef86-4499-a263-1b9adfa16b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f5a61f0e12ba1d36059c00085e73b3d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce540f6a/uploads/origins/490cfb42-ef86-4499-a263-1b9adfa16b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a38eac44cf6e1a608a34265ffbc2824f", "srcset": "https://si.imgix.net/ce540f6a/uploads/origins/490cfb42-ef86-4499-a263-1b9adfa16b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a38eac44cf6e1a608a34265ffbc2824f, https://si.imgix.net/ce540f6a/uploads/origins/490cfb42-ef86-4499-a263-1b9adfa16b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9d5c6063d8053b91cd1084d325aefd38 2x, https://si.imgix.net/ce540f6a/uploads/origins/490cfb42-ef86-4499-a263-1b9adfa16b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8817ea2250c76092b139107cf04dfb1d 3x"}, "body": "アピールすごく嬉しいです...！\nぜひ、うちのOCの「鮫氷しゃち」をお願いしたいです...！\n参考までに設定は以下のとおりですが、テーマや構図等は自由に決めていただいて構いません。\n███\n鮫氷 しゃち（さめすが しゃち）\n細身かつ色白の黒髪ロングストレート。\n白と黒を基調にしたセーラー服にセーラーキャップを着こなす。\nアイドル的な元気さと明るさに加え、清楚で可憐な容姿をしている。 \n好奇心旺盛で趣味はテーマパーク巡りと人間観察。\nかなりの偏食家で、気に入ったものはヘビロテする。その一方で飽きるのも早い。  \n親しい間柄の相手でさえ巧みに感情を操って都合よく利用する。\nその言動はどこか演技的で大げさ。\n先天的に共感性が欠落しており、一見感情のように見えるものは人間観察の結果身に着けたものでしかない。\n███\n宛名・背景はpsdでon/offできると幸いです。\n使用用途は個人活動全般（動画配信の待機画面等、個人サイトやSNSでの小説の挿絵、キャラ紹介、個人活動の告知、トリミング加工を伴うアイコン・ヘッダー・バナーとしての使用等、コミッションサイトでのイラスト等依頼時に参考資料等）を考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/15QcfblJ6ABjLUrKZ3ijKi-ncxD6c6GKd", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 190535, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "みぞれし", "screen_name": "mizoreshi", "avatar_url": "https://pbs.twimg.com/profile_images/1345677174993346561/PgjKjkCz.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 1158490, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あさめし@Skeb募集中", "screen_name": "a0_0san", "avatar_url": "https://pbs.twimg.com/profile_images/1990474692202016768/qBWpxhcs.jpg", "header_url": "https://pbs.twimg.com/profile_banners/362992593/1763401440/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 2839299, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "綿雲なぎさ", "screen_name": "07_nagii", "avatar_url": "https://pbs.twimg.com/profile_images/1753042665774673920/9JhSnxRy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1231419725428617217/1708859570/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "re