at%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c191603c42e8e5286b6585c8237a5a09 2x, https://si.imgix.net/33ec342c/uploads/origins/798ce2ab-050a-4e25-bb04-32710dfb9212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96f6f0b50a2b542c6fde4eb3f1d58d45 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33ec342c/uploads/origins/798ce2ab-050a-4e25-bb04-32710dfb9212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a50002aef2e38cecb1b430118c50548", "srcset": "https://si.imgix.net/33ec342c/uploads/origins/798ce2ab-050a-4e25-bb04-32710dfb9212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a50002aef2e38cecb1b430118c50548, https://si.imgix.net/33ec342c/uploads/origins/798ce2ab-050a-4e25-bb04-32710dfb9212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a5feaca26e413995765012387f3bd23 2x, https://si.imgix.net/33ec342c/uploads/origins/798ce2ab-050a-4e25-bb04-32710dfb9212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0b3e74c53fb11bae50189abf67ab11de 3x"}, "body": "初めまして、いつもイラスト拝見しております。\n私の代理キャラである「藤巻 陽彩(ふじまき ひいろ)」を描いていただけないでしょうか。\n\n・服装\n添付しております資料に記載されておりますシュータードレス、または「ひらり、宵桜」\n\n・構図\nおまかせで大丈夫です。\n\n以上、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1cy4hj4idSH1cqH6MlFZwRzjtRenGf_KY?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ataoka_tya/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2775591, "client_id": 531818, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e42448ca/uploads/origins/ea02791b-ffba-4144-8713-f4e74743cbde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b283baf5772b45bc429c9aaa4da7174b", "srcset": "https://si.imgix.net/e42448ca/uploads/origins/ea02791b-ffba-4144-8713-f4e74743cbde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b283baf5772b45bc429c9aaa4da7174b, https://si.imgix.net/e42448ca/uploads/origins/ea02791b-ffba-4144-8713-f4e74743cbde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f42cbcedf9b522d262265d658e5050a 2x, https://si.imgix.net/e42448ca/uploads/origins/ea02791b-ffba-4144-8713-f4e74743cbde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5805abae4e33f527db95f38f1f45c15b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e42448ca/uploads/origins/ea02791b-ffba-4144-8713-f4e74743cbde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2afd3447e937108a5e80390e12c6b410", "srcset": "https://si.imgix.net/e42448ca/uploads/origins/ea02791b-ffba-4144-8713-f4e74743cbde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2afd3447e937108a5e80390e12c6b410, https://si.imgix.net/e42448ca/uploads/origins/ea02791b-ffba-4144-8713-f4e74743cbde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81436493fcde87832f7e20283b9add7f 2x, https://si.imgix.net/e42448ca/uploads/origins/ea02791b-ffba-4144-8713-f4e74743cbde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f2e00006d4200e7a28726fb8704ffbdb 3x"}, "body": "はじめまして！\nいつも素敵なイラストを拝見しております。今回、阿田岡茶さんに描いていただきたいイラストがあるため依頼を送らせていただきました。\n\n【依頼内容】\n言ノ葉Project 2nd Seasonに登場するエリーというキャラクターを描いていただきたいです。構図の指定などはないので、阿田岡茶さんのお好きなように描いていただければと思います。\n参考資料には公式ホームページのキャラクター説明を添付してありますが、このキャラクターの関連楽曲もいくつかありますので、そちらも参考にしていただければと思います。\nまた、納品形式につきましてはpngかpsdでお願いしたいです。\n\n【使用用途】\nSNS上でアイコンとして使用する予定です。\nまた、カードコネクト（https://p.eagate.573.jp/game/card_connect/1/original/index.html）を用いて、描いていただくイラストを鑑賞目的でプリントさせていただきたいです。\n\n上記の内容で問題がなければぜひお願いしたいです。ご検討の程よろしくお願いします。\n\nhttps:/