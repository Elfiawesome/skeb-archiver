ただけませんか？\nポーズ、スタイル、服装、描き方はあなた次第です。\nすべての情報は参考リンクにありますので、ご覧ください。SNSやYoutubeのサムネイル、商用利用も考えています。よろしくお願いします！\n(キャラクターは二重人格です。）\n幡津りんご(通常時)/***幡津りんご(マスク着用時)\n出身地：地下（スチームパンクシティ）\n種族：地下人\n埴津林檎印象：可愛い、不器用、天然ボケ、賢い、愛に溢れている。\n**霞林檎印象:邪気、ヤンデレ、エレガント、アグレッシブ\nスペシャルポイント右目はダイヤモンド\n仕事：語り部、錬金術師\n趣味：お菓子作り、お花、ハーブ、デザート、紅茶、ハムスター、読書、クリスタルコレクション\n要素：薬、文学、マスク、毒リンゴ（黒と白）\nhttps://drive.google.com/drive/folders/10V7rJ6VI-58Om3yewqQgfWmSQ6ZEjMzg?usp=sharing\n\nhttps://drive.google.com/drive/folders/10V7rJ6VI-58Om3yewqQgfWmSQ6ZEjMzg?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@dimsumcha/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 235392, "client_id": 2814803, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f0dcc97/uploads/origins/4da617fd-5d26-4c48-a3b8-477aa38f784b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9127e3aa71c679c1e200d69796e909b0", "srcset": "https://si.imgix.net/8f0dcc97/uploads/origins/4da617fd-5d26-4c48-a3b8-477aa38f784b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9127e3aa71c679c1e200d69796e909b0, https://si.imgix.net/8f0dcc97/uploads/origins/4da617fd-5d26-4c48-a3b8-477aa38f784b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0274f95b02f28e5b3a6d129e601d1843 2x, https://si.imgix.net/8f0dcc97/uploads/origins/4da617fd-5d26-4c48-a3b8-477aa38f784b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99f8a89d399d58829e6995879a7a3222 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f0dcc97/uploads/origins/4da617fd-5d26-4c48-a3b8-477aa38f784b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d60319fd4807d480338b75b4e443ed31", "srcset": "https://si.imgix.net/8f0dcc97/uploads/origins/4da617fd-5d26-4c48-a3b8-477aa38