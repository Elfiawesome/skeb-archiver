ix.net/b9a5ee7b/uploads/origins/0e7d3e91-5e19-4051-8854-c931e72c1f68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee5a9b585742e8aed06e45dc6d16b8e9 2x, https://si.imgix.net/b9a5ee7b/uploads/origins/0e7d3e91-5e19-4051-8854-c931e72c1f68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=915808953490515c82065030c0a4e9a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9a5ee7b/uploads/origins/0e7d3e91-5e19-4051-8854-c931e72c1f68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=794e26583e2a9c54abb140c31d12c6bd", "srcset": "https://si.imgix.net/b9a5ee7b/uploads/origins/0e7d3e91-5e19-4051-8854-c931e72c1f68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=794e26583e2a9c54abb140c31d12c6bd, https://si.imgix.net/b9a5ee7b/uploads/origins/0e7d3e91-5e19-4051-8854-c931e72c1f68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a5b10630a534ee77b9fc6e0b74220b06 2x, https://si.imgix.net/b9a5ee7b/uploads/origins/0e7d3e91-5e19-4051-8854-c931e72c1f68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4f5b6e32d01d7cd9bfc50dc0c3ad4ea5 3x"}, "body": "初めまして、こんにちは。\nVtuberの虎と狼のハーフ獣人「虎狼ガル」さんのファンアートをどなたかに描いていただきたい……と探していたところ、\nとてもカッコいいケモノのイラストを拝見し、リクエストを送らせていただくことにしました。\n\n依頼したいのは虎狼ガルさんの一枚絵です。\n普段ソニックレーシングなどのゲーム配信でお世話になっているお礼のひとつとさせていただければ、というものです。\n\n納品いただいた際には、虎狼ガルさんのFAタグ#虎狼画　にて、画狂狼人バウワウさんのお名前・アカウント名・依頼の件を明記した上で投稿したく思っております。\n配信サムネイル、他ポストに使用することはございません、その点は本人にも伝えさせていただきます。\n\nセルフ受肉Vtuberということで、現行バージョンの三面図などは無いのですが、普段の配信用立ち絵を元にバウワウさんの絵柄で描いていただけると嬉しいです。\n話し方も言葉遣いもとても穏やかで可愛い系の方なのですが、超〜スタイリッシュにカッコよく描かれた姿も見てみたいというのが本音であったり……\n\nひとつわかりにくい拘りポイントですが、右耳はオオカミの尖り気味のもの・左耳はトラの丸っこいものなんだそうです。\n姿や表情が見られる自己紹介動画URLを添付しますので、必要に応じてご確認いただけると幸いです。\n\nhttps://youtu.be/IcRIdZKCg3I?si=WH6lE8-yxrUcKFCI", "nc": 145, "word_count": 0, "transcoder": "i