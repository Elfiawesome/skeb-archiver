猫ちゃん・沢山食べるのが好き（ハンバーガー・焼肉・甘党、えび料理が好き）・オレンジジュースがだいすき・FPSゲームだいすき（主にvalorant）\n\n●希望納品形式 \nPC壁紙（16:9）サイズ希望です\nキャラクター・宛名等がレイヤー分けされた psdデータ、もしくはpngで人物のみの透過データもいただけますと大変嬉しいです…！\nまた、サムネイル作成に使用したいとも考えてるので、できましたら頭部がきれていない状態だと嬉しいです。\n\n以上です！お忙しいと思いますが、ご検討のほどよろしくお願いいたします！！！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukuti_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2816629, "client_id": 2735288, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0218e70d/uploads/origins/6be9a509-6bbe-4754-bdee-a19e537ec8cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=223ca39e5042dce0f2cf10a90d377fd0", "srcset": "https://si.imgix.net/0218e70d/uploads/origins/6be9a509-6bbe-4754-bdee-a19e537ec8cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=223ca39e5042dce0f2cf10a90d377fd0, https://si.imgix.net/0218e70d/uploads/origins/6be9a509-6bbe-4754-bdee-a19e537ec8cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3b02b4f66cc1e0ff4ba94011f22760a 2x, https://si.imgix.net/0218e70d/uploads/origins/6be9a509-6bbe-4754-bdee-a19e537ec8cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1f5e643a804768b6e80a01515fc8bf4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0218e70d/uploads/origins/6be9a509-6bbe-4754-bdee-a19e537ec8cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de364deaeec0ab9550af59e0e33baa05", "srcset": "https://si.imgix.net/0218e70d/uploads/origins/6be9a509-6bbe-4754-bdee-a19e537ec8cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de364deaeec0ab9550af59e0e33baa05, https://si.imgix.net/0218e70d/uploads/origins/6be9a509-6bbe-4754-bdee-a19e537ec8cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=