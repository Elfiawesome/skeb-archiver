mat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a962ae165f3ae3a06f0586cea21bf374 2x, https://si.imgix.net/a5d99bdf/requests/164631_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8684749626a53d567dc7b12fd94f225d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5d99bdf/requests/164631_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e7b1ee8062ef00e311fabf4ed7122ce", "srcset": "https://si.imgix.net/a5d99bdf/requests/164631_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e7b1ee8062ef00e311fabf4ed7122ce, https://si.imgix.net/a5d99bdf/requests/164631_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=19aa87526e7a4f0c3d37e2f1e934d9ab 2x, https://si.imgix.net/a5d99bdf/requests/164631_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3280feeb87a18eb36ed7cb33c8507667 3x"}, "body": "初めまして！\nskeb開設おめでとうございます！\n初っ端に特殊なシチュエーションになってしまうこと誠に申し訳ございません。\n性的描写はないためNS FWに引っかからないと思いますが、気乗りなされない場合キャンセルしていただいて構いません！\n\nリクエストはロックマンエグゼの桜井メイル(ロールとのクロスフュージョンver)の石化です。\n\n■シチュエーション\nストーンマンとの戦闘に敗北し、撤退と踵を返したメイルは背後から石化攻撃を受けて、足元から徐々に石化し完全石像になるというもの。\n\n■本編\nメイルは駆けているところに足を掴まれているような感覚に陥り転けるように膝をつく。\n自分の身に何が起こっているか分からず、足元を確認すると自分の足が石に包まれていた。\nそこから上へ徐々に石化が進行していく。\n\n助けを求めるように腕を伸ばした姿勢で首下まで石化し「たすけ……！」と叫ぶ間もなく口が石化。そのまま完全な石像と化す。\n石像となったメイルは「熱斗……」と消え入りそうな心の声を漏らし、瞳から涙が滴り落ちると素敵です。\n\n\nhttps://m.youtube.com/watch?index=19&list=PL2WRkC_hhvmnCzTfa5tkvmIprUhvzs6B3&t=0s&v=cnhLyGwsLow\n石化の質感は参考画像上段のものや動画の11:06〜や11:58〜のようなゴツゴツした感じが希望です。\n動画のが元ネタです。\n\n石化攻撃は動画の11:27〜からのもののように地面から這うように対象を捉えて石化させるものが良いです。\n\n是非とも検討のほどよろしくお願いします！\n\n\nhttps://m.youtube.com/watch?v=SLiIriFZk1Y\n\n参考画像(良い石化例もいくつか入れておきます！)\n\nhttps://www.dropbox.com/sh/1x12ze8blzherk4/AADooSTPg7GDNGuVa9vX5wawa?dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_s