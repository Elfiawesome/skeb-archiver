ad621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bcd989a7854080f4eb86211a55bd0cba, https://si.imgix.net/fe6974f1/uploads/origins/5a42bb81-6f81-464a-9e69-6fa94f4ad621?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=454bd8f0c50f1c95e279bc29b1982ecc 2x, https://si.imgix.net/fe6974f1/uploads/origins/5a42bb81-6f81-464a-9e69-6fa94f4ad621?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d01a91c037a62ff72a2d58dd6c062ea 3x"}, "body": "いぬしろさんこんにちは。aと申します。\n前回は素敵なイラストを描いてくださりありがとうございました！\nいぬしろさんの絵柄と作風がとても好きなので、今回もぜひオリジナルキャラクターを描いていただきたいと思い、リクエストを送信させていただきました。\n\n今回描いていただきたいとのは自創作のキャラクター2人になります。（どちらかだけにフォーカスして描いていただいても構いません。）\nキャラクターの見た目、詳細、関係性など以下のGoogleドライブにまとめてありますので、お目通しいただけますと幸いです。\n衣装は描きやすいように変えていただいて構いません。\n\n雰囲気、構図はおまかせします。\nNGはありませんので、資料から感じたまま描いていただければと思います。\n\nhttps://drive.google.com/drive/folders/1EGvbfm5v108GkRC-_4ipb1-hEqpvaMHT\n\n使用目的は個人鑑賞です。SNSでシェアさせていただくかもしれません。\n\nご都合に合いません場合はお気軽に再送、キャンセルしていただいて構いません。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1EGvbfm5v108GkRC-_4ipb1-hEqpvaMHT", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akagi_miee/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3455589, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63b209fc/uploads/origins/da000ebe-c6d5-4a26-81ca-31aa5cb1db34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7af24cbfa4f7176caf2aba818d97bf1a", "srcset": "https://si.imgix.net/63b209fc/uploads/origins/da000ebe-c6d5-4a26-81ca-31aa5cb1db34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7af24cbfa4f7176caf2aba818d97bf1a, https://si.imgix.net/63b209fc/uploads/origins/da000ebe-c6d5-4a26-81ca-31aa5cb1db34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3482e309b602e77e0712b476