透過で使用できるよう、PSDのデータか、透過のPNGファイルをいただけると助かります。\n長くなってしまいましたが、ご検討の上、どうぞよろしくお願いいたします。\n\nhttps://x.com/meihua0707/status/1805946412582179098/photo/1\n\nhttps://x.com/meihua0707/status/1805946412582179098/photo/1", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hotbutter/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fc6f3fa6/uploads/origins/e0bebfca-12ed-445a-b917-60334b7ffebf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bed7ab395dab19afc834731bff67d1b1", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3475248, "client_id": 3466837, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Hotbutter/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3475248, "client_id": 500859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fac22fd2/uploads/origins/312da4a1-d7d2-4312-936f-374f7a57f3cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a1e662b07c93ee74e9c668b8e37bd83", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fac22fd2/uploads/origins/312da4a1-d7d2-4312-936f-374f7a57f3cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79214b8a601ca9d91df21b59c935b055", "src_set": ""}, "body": "ほとばさん、はじめまして。\nアピールありがとうございました。うちのこAyaにご興味を持っていただいて嬉しく思います。\nせっかくのご機会ですので、Ayaのイラストをリクエストいたします。\n\nAyaについて\n・ミコッテ(サンシーカー)です。\n・髪色はほぼ黒に近い紫に赤いメッシュ。\n・尖った形の猫耳。人耳はありません。\n・瞳は右目が黄色、左目が青。猫目のような縦長の瞳孔。\n・薄いアイシャドウとルージュ、頬にライン。\n・尻尾は長めで先端まで太さ・毛色が変わらないタイプ。\n・普段は真面目ですが、根は