a8788/uploads/origins/cc52e794-d9a6-4892-a80c-ee39a9fb158f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58edafa62ecf0230b1e386170020dda4", "srcset": "https://si.imgix.net/41da8788/uploads/origins/cc52e794-d9a6-4892-a80c-ee39a9fb158f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58edafa62ecf0230b1e386170020dda4, https://si.imgix.net/41da8788/uploads/origins/cc52e794-d9a6-4892-a80c-ee39a9fb158f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd023949404964944fdbfe58d10ce1ae 2x, https://si.imgix.net/41da8788/uploads/origins/cc52e794-d9a6-4892-a80c-ee39a9fb158f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d589ce05ccc436e699099a1ddb5cdee0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41da8788/uploads/origins/cc52e794-d9a6-4892-a80c-ee39a9fb158f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f8b528a8b9317c2223c13047656d238", "srcset": "https://si.imgix.net/41da8788/uploads/origins/cc52e794-d9a6-4892-a80c-ee39a9fb158f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f8b528a8b9317c2223c13047656d238, https://si.imgix.net/41da8788/uploads/origins/cc52e794-d9a6-4892-a80c-ee39a9fb158f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05a232843ec9c28ad4b7b6da42dd5902 2x, https://si.imgix.net/41da8788/uploads/origins/cc52e794-d9a6-4892-a80c-ee39a9fb158f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=312baf2dd341f3ad5123d33ecc78b124 3x"}, "body": "初めまして。\n三人称視点で原神のゴローが八重神子に長い舌で犯されるイラストをお願いします。\n\n具体的なシチュエーションとしては\n①一糸まとわぬ姿で両手首を掴まれ、足がギリギリ地に着かない程度まで持ち上げられた状態で八重神子を睨むゴロー。対して八重神子は涼しい表情でそれを見下ろす\n②八重神子がおもむろに唾液をたっぷり纏った長く厚い舌(この時点では自身の胸元に届くくらい)を出し、ゴローはそれを見て驚愕に目を見開く。\n③八重神子のその長い舌がゴローの顔面を舐め上げる。それに反応してゴローの股間の逸物はいきり立ち、同時に先端から少量の透明な露を漏らす。\n④八重神子は一旦舌を仕舞うが、八重神子を見上げるゴローの顔には既に怯えた表情が浮かんでいる。\n⑤ゴローのそんな様子を見て嗜虐心が刺激された八重神子は大きく口を開けて先程以上の長さで舌を伸ばし、ゴローはそれに視線が釘付けとなりつつも目元に涙を浮かべてふるふると首を横に振る。\n⑥周りに唾液が飛び散る程の勢いで八重神子の長舌がゴローの顔面を滅茶苦茶に舐め回す。ゴローの顔は舌で覆われて表情が伺えないが、程なくして逸物から屈服精液を噴き出す。\n⑦再びゴローは八重神子の舌から解放され両手首を掴んで自らを持ち上げていた手も放されるが、最早身体に力が入る様な状態ではなかった為そのまま膝をつき、意識が半ば飛んだ恍惚とした表情で八重神子の舌を見上げる。\n⑧トドメとばかりにゴローの顔面を丸ごと覆う様に唾液塗れのベロ肉が強く押し付けられる。ゴローの身体はびくりと跳ね、尿道に残った精液がとぷとぷと漏れ出る。\n\nといった流れでお願いします。\n\n八重神子の舌のサイズは下記資料URLのリンク先8枚目を参考に最初は雷電将軍と同じ位、再び舌を出す時は胡桃と同じ位のサイズでお願い致します。\nゴローの逸物のサイズはあまり大きすぎたり小さすぎたりしない限り拘りは無い為、maさんの裁量にお任せ致します。\n\n依頼内容は以上になります。\n差し支えなければよろしくお願い致します。\n\nhttps://skeb.jp/@mabugba/works/6", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mabugba/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/36af113b/uploads/origins/e000d183-438a-4fe3-9179-3313e31d57e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64d86427e154b496b0c24c62e6c1269c", "srcset": "https://si.imgix.net/36af113b/uploads/origins/e000d183-438a-4fe3-9179-3313e31d57e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64d86427e154b496b0c24c62e6c1269c, https://si.imgix.net/36af113b/uploads/origins/e000d183-438a-4fe3-9179-3313e31d57e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=241debd3c291e945e4ba8b592277b10c 2x, https://si.imgix.net/36af113b/uploads/origins/e000d183-438a-4fe3-9179-3313e31d57e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1954ef29b050303346f6355bffa01ce9 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 130