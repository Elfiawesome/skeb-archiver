table": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@mabugba/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 130843, "client_id": 1632689, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b821d6e3/uploads/origins/53385eb3-10c2-404e-a4c5-535590d7fb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4810b2f41ca0f54d5627c5729ac11391", "srcset": "https://si.imgix.net/b821d6e3/uploads/origins/53385eb3-10c2-404e-a4c5-535590d7fb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4810b2f41ca0f54d5627c5729ac11391, https://si.imgix.net/b821d6e3/uploads/origins/53385eb3-10c2-404e-a4c5-535590d7fb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc3326e96e9e820a1c552c261c7e72f1 2x, https://si.imgix.net/b821d6e3/uploads/origins/53385eb3-10c2-404e-a4c5-535590d7fb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c622e4df363f5f28304882a00cc3c925 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b821d6e3/uploads/origins/53385eb3-10c2-404e-a4c5-535590d7fb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59650a232dc495b10ec5ac70699f3acd", "srcset": "https://si.imgix.net/b821d6e3/uploads/origins/53385eb3-10c2-404e-a4c5-535590d7fb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59650a232dc495b10ec5ac70699f3acd, https://si.imgix.net/b821d6e3/uploads/origins/53385eb3-10c2-404e-a4c5-535590d7fb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f4f78c821dd0842929eab7fa38244e7 2x, https://si.imgix.net/b821d6e3/uploads/origins/53385eb3-10c2-404e-a4c5-535590d7fb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ecdddc3d810b1b9f68e5f8c555ef8b38 3x"}, "body": "はじめまして。あなたの作品で、舌が非常に長い女の子たちを見て、とても刺激を受けました。そこでお願いがあります。裸の女の子（Aと呼びます）が、舌が非常に長い別の裸の女の子（Bと呼びます）に深く恋をしています。二人の女の子のデザインはあなたに任せますが、胸はあまり大きくしないでください。\n\n少女Aは少女Bに深く深くキスされることを強く望み、それを心待ちにしています。彼女は口と喉を大きく開き、目を閉じています。口蓋垂がはっきりと見えています。少女Bは舌を少女Aの口深くに挿入し、その舌は少女Aの喉へと入っていきます。少女Aは飲み込み、舌は食道へと下っていきます。 両者とも極度の興奮状態で互いを抱擁し、この行為を大いに楽しんでいる。Bの舌がAの喉奥へ侵入する瞬間から、Aの口と喉が透けて見えるように描写してほしい。その際、Aの喉頭蓋と口蓋垂が視認可能であること。ご検討いただき誠にありがとうございます。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mabugba/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 130843, "client_id": 1361958, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0048123d/uploads/origins/53173dcd-b989-4ba1-aa29-641c0331ec62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e876dac6e6d04f6ff2951adf918f410", "srcset": "https://si.imgix.net/0048123d/uploads/origins/53173dcd-b989-4ba1-aa29-641c0331ec62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e876dac6e6d04f6ff2951adf918f410, https://si.imgix.net/0048123d/uploads/origins/53173dcd-b989-4ba1-aa29-641c0331ec62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=460b3846409ca9c3d1381c5d8ac2d4cd 2x, https://si.imgix.net/0048123d/uploads/origins/53173dcd-b989-4ba1-aa29-641c0331ec62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64a2c380c96c7396424f77ae5afe46d3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0048123d/uploads/origins/53173dcd-b989-4ba1-aa29-641c0331ec62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d036f869c0b2d18328f922401a20cc0", "srcset": "https://si.imgix.net/0048123d/uploads/origins/53173dcd-b989-4ba1-aa29-641c0331ec62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d036f869c0b2d18328f922401a20cc0, https://si.imgix.net/0048123d/uploads/origins/53173dcd-b989-4ba1-aa29-641c0331ec62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7646000877b8637b7194338014364ea3 2x, https://si.imgix.net/0048123d/uploads/origins/53173dcd-b989-4ba1-aa29-641c0331ec62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a742e95832ebe7bdf90122359a70d6e0 3x"}, "body": "こんにちは、\nPSO2のキャラクター、Piaをお願いしたいのですが。\n\n以前から足がとても長くて指が長いあなたのキャラクターがとても好きだったので、同じような体型の彼女をリクエストしたいです。https://x.com/mabugba/status/1881680750136971381\n\nPiaは非常に長い脚を持つ、非常に背の高いエイリアンの女の子です。身長は3メートル弱。\n脚だけでも2mくらいあって、普通のドアより背が高いはず。それに比べて彼女の胴体は比較的普通であるべきだ。胸は比較的小さい。腕は太ももに比べてかなり細い。長い指と一緒に、腕も通常より少し長くするといい。\n\n地球人の振る舞いをまだよく知らないが、穏やかで人懐っこい女の子。\n\nポーズは自由だが、できれば背が高いことと、手足や指が長いことを強調したものがいい！\n\n彼女は長い舌も持っているはずなので、できれば舌のあるアルトを作ってください。比較的薄い舌であるべきで、リファレンス・フォルダに例を用意しました。彼女の舌は紫色です。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/19lLLARa8MDyb6p1LeIYGdpp9p5dxOhQO?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mabugba/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/06af6251/uploads/origins/26fc6388-bdad-4d33-8e58-ac053a2f9a27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7552d007beb3a826e8022512c5bba264", "srcset": "https://si.imgix.net/06af6251/uploads/origins/26fc6388-bdad-4d33-8e58-ac053a2f9a27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7552d007beb3a826e8022512c5bba264, https://si.imgix.net/06af6251/uploads/origins/26fc6388-bdad-4d33-8e58-ac053a2f9a27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Cce