。\n前立腺責めはお尻の穴が映らない構図でも大丈夫です。\n前回同様おへそが隠れない構図で描いて頂けると嬉しいです。\n今回描いて頂いたイラストは、他の方にイラストをお願いする際の参考資料としても使用させていただくかもしれません。\n\n前回描いて頂いたイラストがとても好みだったのと、R18も全般OKとあったので描いて頂きたく思い、ショタエロに対応しているかわかりませんでしたが送らせて頂きました。\nもし大丈夫であれば受けて頂けると嬉しいです、よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/129ZJXK-iN0gubEEzpu9Sw0l0sQB-QxPc", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@UGilde/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1351883, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe81cd7e/uploads/origins/3ae5251e-b7be-45d3-89d4-52851ca366c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1469a3d31393e3299ff214cbda7320b5", "srcset": "https://si.imgix.net/fe81cd7e/uploads/origins/3ae5251e-b7be-45d3-89d4-52851ca366c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1469a3d31393e3299ff214cbda7320b5, https://si.imgix.net/fe81cd7e/uploads/origins/3ae5251e-b7be-45d3-89d4-52851ca366c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=059055d7720c1baab4d5a332b6f5ba48 2x, https://si.imgix.net/fe81cd7e/uploads/origins/3ae5251e-b7be-45d3-89d4-52851ca366c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca03da1109856dd0fee13798bed23047 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe81cd7e/uploads/origins/3ae5251e-b7be-45d3-89d4-52851ca366c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=446b359a96041324d3a9dc7f137774fc", "srcset": "https://si.imgix.net/fe81cd7e/uploads/origins/3ae5251e-b7be-45d3-89d4-52851ca366c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=446b359a96041324d3a9dc7f137774fc, https://si.imgix.net/fe81cd7e/uploads/origins/3ae5251e-b7be-45d3-89d4-52851ca366c6?bg=%23fff&auto=format%2Ccom