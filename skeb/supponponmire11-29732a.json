bnail_image_urls": {"src": "https://si.imgix.net/ad5b11d3/uploads/origins/24a3c967-0682-4e32-b502-3259b14c1395?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81357833c857a821e550b8539ef51e8c", "srcset": "https://si.imgix.net/ad5b11d3/uploads/origins/24a3c967-0682-4e32-b502-3259b14c1395?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81357833c857a821e550b8539ef51e8c, https://si.imgix.net/ad5b11d3/uploads/origins/24a3c967-0682-4e32-b502-3259b14c1395?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d05809a895453c479df870497e7fd350 2x, https://si.imgix.net/ad5b11d3/uploads/origins/24a3c967-0682-4e32-b502-3259b14c1395?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64a24f939e494b82e46af99f44992073 3x"}, "body": "こんにちは！あなたの漫画の作風が大好きで、コメディ作品を描いていただけたら嬉しいです（日本語のテキストでもOKです）！私のオリジナルキャラクターであるティアラと、彼女の物語に登場する数体のデジモンが登場するこのシーンを描いていただけたら最高です。シーンの内容は以下の通りです：\n\nガムドラモンが興奮してティアラに駆け寄り、次々と質問を浴びせる様子を描いてください。ティアラは、優しく気遣いながらも、少し手こずっているお姉さんのような感じで質問に答えてください。その後、ガムドラモンがティアラにぎゅっと抱きつくと、それを見たベルゼモンが激怒して、ガムドラモンを引き離そうと突進し、尾を掴んでヘリコプターのようにぐるぐる回します。ティアラはこの光景に言葉を失っている様子にしてください。\n\nベルゼモンはティアラをとても大切に思っており、ガムドラモンを「うざい弟」と見なしています。ガムドラモンはティアラのそばにいられることに大興奮で、ただ純粋に彼女のことをもっと知りたいと思っているだけなのですが、それがベルゼモンの嫉妬を煽ってしまうのです！ティアラはベルゼモンの過保護な態度が気に入らないので、彼をからかうためにそのふりをしています。 ガムドラモンはビールゼモンを「お兄ちゃん」と呼び、ビールゼモンは彼を「ちっぽけなネズミ」と呼んでいる。ガムドラモンとビールゼモンには黒いエプロンを着せてほしい\n\nhttps://drive.google.com/file/d/1-1rPlLfuaw7oDNcwdk4WTg6w83pDfOQ9/view?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@supponponmire11/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2091677, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ffa798f/uploads/origins/67bd01ea-8c9f-40db-9914-34e89f5c9a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200