風亜ゆう様の作品の大ファンです！\n\nVTuberの「クズかわユメ」を描いていただけませんか？\n\nユメは精神科クリニックの患者で、看護師のふりをしています。彼女の空想上の友達「患者」たちは、彼女が作り出した小さな猫やウサギで、彼らと会話したり、いじめたりしています。\n\n彼女は不器用で、おバカな精神疾患を抱えた女の子です。\nもし可能なら、彼女がマスコットたちを実験台にしている様子、例えば血まみれの手術を施したばかりのシーンなどを描いていただけませんか？それなら最高にクールです！\n\nどんな表情やポーズにするかは、風亜ゆう様にお任せします！\nありがとうございます！\n\nhttps://yumeskeb.carrd.co/#fuayu", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@w_a_y030/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 84969, "client_id": 393622, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/386bb779/uploads/origins/06d17887-b56b-4316-96bc-7b0044af5150?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccba681dd5645494507313005f18a9d8", "srcset": "https://si.imgix.net/386bb779/uploads/origins/06d17887-b56b-4316-96bc-7b0044af5150?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccba681dd5645494507313005f18a9d8, https://si.imgix.net/386bb779/uploads/origins/06d17887-b56b-4316-96bc-7b0044af5150?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bcc91c4733e89840df0400ecccbcbd5e 2x, https://si.imgix.net/386bb779/uploads/origins/06d17887-b56b-4316-96bc-7b0044af5150?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f0f0fa6641260255ee90de081451403 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/386bb779/uploads/origins/06d17887-b56b-4316-96bc-7b0044af5150?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48787d9e308e942e2e39c9be2ecff784", "srcset": "https://si.imgix.net/386bb779/uploads/origins/06d17887-b56b-4316-96bc-7b0044af5150?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48787d9e308e942e2e39c9be2ecff784, https://si.imgix.net/386bb779/uploads/origins/06d17887-b56b-4316-96bc-7b