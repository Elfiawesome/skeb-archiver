0f19-40e6-a9a6-55af1fc1ea01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb4d5e43cc503d9abcfddbde76281046", "src_set": ""}, "body": "納品していただいたばかりで恐れ入りますがまたリクエストさせていただけないでしょうか。\n金田さんをメスにしてさらには結婚して母にした相手のふたなりの子をぜひみてみたいと思ったためです。\n\nSkebで描いてくださったイラストの視点を逆にしたイメージ（金田さん視点で巨大なペニスのふたなりの子を見てるような形）で描いて頂けたらと存じます。\n\n相手の子はまるちろ様で具体的にキャラクターが決まっているようでしたらその子を、そうでなければ金田さんとは反対にペニス以外は女の子らしい子がいいかなと思っております。\n\nご検討いただけるとうれしいです。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maruchiro_/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3371617, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b145cadd/uploads/origins/a4cba96d-d1d4-4cbc-a445-c0691de81128?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b39854dd01b758c4629cc31fa2eba798", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b145cadd/uploads/origins/a4cba96d-d1d4-4cbc-a445-c0691de81128?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e93b186ab5c8e75504202df04695e12", "src_set": ""}, "body": "まるちろさん、こんにちは。\n初めて依頼を送らせていただきます。\n\nまるちろさんが個人サイト時代に描かれていたオリキャラの笹山さんが特に好きでした。\nもし可能でしたら、「スカートをたくし上げて巨大な玉とサオを見せる笹山さん」を描いていただけないでしょうか？\n\n笹山さんは「ロングスカートをはくと玉とサオが目立たなくなる」という設定があったはずなので、もしよろしければ、「一見何もなかったところにいきなり巨大な玉とサオが現れて驚いている相手」に対して「…何か変かしら？」と不思議そうな雰囲気の表情をしている、というシチュエーションにしていただけると嬉しいです。（相手自体は省略していただいて大丈夫です）\nその他の細かい部分はまるちろさんのイメージ優先でお任せします。\n\nお忙しいところ恐れ入りますが、ご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maruchiro_/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3371617, "client_id": 187209, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b277e737/uploads/origins/633124bc-43e0-4272-96e9-a15abfbff6b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae9cf81be099e44aba2f878dae804f74", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b277e737/uploads/origins/633124bc-43e0-4272-96e9-a15abfbff6b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=540e1138a8a52e8af774aa57cfb2b9f7", "src_set": ""}, "body": "ふたなり娘が自身の超玉に乗りながら萎えていて亀頭が顔を覗かせた状態の仮性包茎の超根に男を跨らせる\n↓\nふたなり娘が超根を太い血管を浮かび上がらせながら勃起し皮が剝けて大量のチンカスが現れる、玉も音を立てながら精子を生産し始めて巨大化する（差分１）\n↓\nふたなり娘が男の尻に超根を根元まで挿入し、男の腹がふたなり娘の超根の形に膨らむ。男はふたなり娘の足元にも及ばない雀の涙のようなところてん射精をする（差分２）\n↓\nふたなり娘が金玉にも太い血管を浮かばせながら超大量射精し、男の腹が画面の大半を埋め尽くす程大きく膨らむ（差分３）\n↓\nふたなり娘は射精を続け、収まりきらずに逆流した精液で一面海のようになる。ところてん射精した男の精子がふたなり娘の巨大精子にひき潰されるコマ（差分４）\n\n・構図はhttps://x.com/ZozoBernada/status/1750668330971574394のようなイメージで、ふたなり娘の竿と玉が全部入るようにお願いします\n\n・ふたなり娘はまるちろさんの所のhttps://x.com/maruchiro_/status/1862163852118704397の金髪ロングで青いリボンの子\n\n・ふたなり娘の勃起状態の玉の大きさはhttps://x.com/ZozoBernada/status/1750668330971574394の挿入している方のふたなりくらいで、竿の大きさは挿入しているふたなりの３倍くらい\n\n・ふたなり娘が自分と男の竿と玉、射精量、精子の大きさを比べて馬鹿にする台詞と、チンカスを男の中で掃除しようとする台詞、男を気に入り自分専用のオナホにしようとする台詞\n\n・男は身長１７０ｃｍくらいで顔無し粗チンで、ふたなり娘の体をよく見えるようにするために半透明のシルエット\n\n・男の口から精液が逆流するのは無しでお願いします", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maruchiro_/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1783d359/uploads/origins/67379537-179a-447d-a7a6-e37141172f07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a46db2ba1297a39404abe242c8eb98c1", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3371617, "client_id": 96824, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 171, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@maruchiro_/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3371617, "client_id": 946283, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13cb0fed/uploads/origins/deef7a7d-5557-4a51-855f-aac7203990d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9142cc17dec9f2add59902b345fe829f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/13cb0fed/uploads/origins/deef7a7d-5557-4a51-855f-aac7203990d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7be9ed06cdb22b99e1c6a2a83c0ebc38", "src_set": ""}, "body": "Skebされてるとのことなのでぜひお願いしたいと思いましてリクエストお送りさせて頂きました。\n\nhttps://x.com/maruchiro_/status/1862181075667353796?t=s2tOv5gZstiZVEA2NvW-HQ&s=19\nまるちろ様のこのイラストのセルフリメイクをお願いしたいのですがよろしいでしょうか？\n\n普段は男の子に見える女の子がみせる女の子らしい色っぽさと勃起した立派なペニスの組み合わせがとても好きでして、さらに震えていてすごく恥ずかしそうなのに隠そうとしてないところが想像が膨らんでとても好きなので、ぜひまたまるちろ様に描いていただけたらと思ったためです。\n\nご検討いただけたらうれしいです！", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maruchiro_/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3371617, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c21261e0/uploads/origins/23273e89-9683-4547-9383-cc718709468d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c9137515157d6a10bd96e2cc6031fb9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c21261e0/uploads/origins/23273e89-9683-4547-9383-cc718709468d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=274d8a7a37b75348bb0cd09807882460", "src_set": ""}, "body": "年末前のリク送信ということで、ご迷惑でなければよろしくお願いします！\nキャラはTV版ホシノ・ルリで、膨張率のすごいふたなりネタで。（玉の有無はおまかせ）\n\n普通サイズの竿にボテ腹をしており、一見するとただのボテフタですが、\n実は尿道プレイでお腹にテニスボール大のゴムボール（ボールプールなどのアレ）をしまい込み\n落ち着くまで我慢していたというシチュです。\n\n膨張と共に感じ始めて尿道が拡張すると、ボールがボコボコと送り出されて、疑似産卵を楽しみます。\n軽い絶頂を続けてフル勃起超根に達すると、広がりとポンプの如き力で抵抗なく、全弾放出。\nお腹が平らになると同時に、壊れた水栓のような大量射精で全力アクメします。\n\nhttps://dic.pixiv.net/a/%E3%83%9B%E3%82%B7%E3%83%8E%E3%83%BB%E3%83%AB%E3%83%AA", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maruchiro_/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5b8005b6/uploads/origins/a33d9742-e334-42af-b252-a6940d666679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e2cb3233190e5924c8c1ddecd83f46a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3371617, "client_id": 1853984, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 179, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@maruchiro_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3371617, "client_id": 365687, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c214c025/uploads/origins/ac9598d0-face-4cbf-9677-36fb707636ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33e18c8a672804cfe66545b9cbfdd582", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c214c025/uploads/origins/ac9598d0-face-4cbf-9677-36fb707636ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08e489c2406d1afc2a46e9f79cdd7b66", "src_set": ""}, "body": "玉無しふたなりのエルピー・プルが\n玉無しふたなりのプルツーに挿入してガンガン突いてる感じのイラストをお願いします。\nプルは楽しそうな表情でプルツーの片脚を抱えて腰を振ってる感じで、\nプルツーは虚ろな表情で、お腹はぼこってなってるかボテってて、ペニスから押し出される様な射精を繰り返す感じでのイメージでお願い出来ればと思います。\n服装はほぼなしで大丈夫ですがプルの▽型のペンダントは有ると嬉しいです\nプルツーのペニスはレイヤでオンオフ出来るとありがたいです。\n差分が出来るようならレイヤ分け対応のみで大丈夫です。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maruchiro_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3371617, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1264bb8/uploads/origins/43ffe99c-83e4-465f-b8c7-803a251fccbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e1dc05a1fddb49056b04cec350f6933", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1264bb8/uploads/origins/43ffe99c-83e4-465f-b8c7-803a251fccbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c7c3f578673e630108772a87b3dbd86", "src_set": ""}, "body": "こんにちは。\n筋ふたギャルのイラストをリクエストします。以下に詳細を記載いたします。\n\n【人物詳細】\n髪は金色ストレートロング\n褐色肌のギャル\n筋肉もりもりで服がパツパツになっている状態\n爆根サイズでカリに鋭い突起がたくさんついているふたなり\n\n【イラスト構図】\n片腕に巨大なバーベルを持ち、もう片方の手はギャルピース。\n（バーベルの持ち手は握りつぶされている）\nドロドロの超大量射精をしている。\n\n以上でお願いします。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maruchiro_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3371617, "client_id": 949877, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c3e5fecd/uploads/origins/9662509d-25ef-4a87-8e9f-3636727936e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ac30f9b4a14c1b14c825ac7452db41c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c3e5fecd/uploads/origins/9662509d-25ef-4a87-8e9f-3636727936e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2fb2ab11e908d3693127f2194d4b5f7", "src_set": ""}, "body": "まるちろさん、こんにちは\n\n私は十数年来のまるちろさんファンです！\n最近HPが見れなくなって悲しくなりました。\nそこで先生のオリキャラでトップクラスに好きな娘をリクエストします。\n\nhttps://web.archive.org/web/20180630191937/http://maruchiro.h.fc2.com/sns_2.html\n\n■内容\n・この娘の１年後位で更に成長した姿。\n・本体は別に成長してなくていいです。\n・資料と同じように自慢のチンポを見せてくれるシチュエーション。\n・こちらのために、わざわざオナ禁までしてくれており勃起すると、肉が弾け飛びそうな程、ガチガチのミチミチにチンポが張り詰める。\n・オナ禁のため、射精欲は当然あるが、生殖・繁殖本能も滾っている感じ。\n・チンポを自慢しつつ、いやらしい笑みで、「これでも引かないんだ…だったら、もっと凄いの見せてあげようか？」といった感じで誘う。\n・勃起しているチンポがさらに多段勃起する。\n多段勃起は、そのまま単純に一回り大きくなるのではなく\n巨大になりつつも、特に『亀頭辺りの剝けている部分からが更に伸びる』イメージです。竿も亀頭もエグイ形に変形する。\n・嬉しそうに、流石に引いちゃった？と聴いてくる。\n・ついに、参考資料では見れなかった念願の射精を見せてくれる。\n\n\n以上です。\n内容問題なければ、何卒よろしくお願いします。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maruchiro_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3371617, "client_id": 1490349, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a980330/uploads/origins/1d102151-edf0-4ab5-87d9-384f713d8c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c35c17e0a35cfcf6c5c26a9c820f0bf", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a980330/uploads/origins/1d102151-edf0-4ab5-87d9-384f713d8c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95074d6ecdd1b0f361bce49b2c06b921", "src_set": ""}, "body": "フタナリOCのクロエが精液サンプルを採取するために飼育台を使っている。以前はオシッコのサンプルも採取していたが、クロエはトイレが溢れるほどのオシッコをし、爆発までさせる。クロエは繁殖マウントと激しく交尾しながら、すでに固まった先走り精液をロープ状に放出する。そして、濃い黄色の固形精液を大量に射精し、部屋中に充満させ、もしかしたら壁をぶち破るかもしれない。また、彼女の精子とずっと小さな卵細胞との間に、精力測定や精子細胞の大きさの比較を入れることもできる。クロエのペニスは、勃起すると飼育台から突き出るほど大きく、完全に勃起するとその長さを軽く超え、亀頭は飼育台の開口部の直径を超えるかもしれない。彼女のメロン大の睾丸は、射精の際、非常に硬く食いしばるだろう。湯気でよく見えないバージョンもお願いします。\n\nhttps://drive.google.com/file/d/132ey4AW-Z-BWftVQXDA8HpZ5Gkok4ZKz/view?usp=drive_link\n\nhttps://drive.google.com/file/d/132ey4AW-Z-BWftVQXDA8HpZ5Gkok4ZKz/view?usp=drive_link", "nc": 35, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maruchiro_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3371617, "client_id": 365687, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc427e88/uploads/origins/0afc0b72-a45c-4cb0-8308-23932620f98b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4eb3eb7e67a7b1c5c78c33590e9d3dd", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc427e88/uploads/origins/0afc0b72-a45c-4cb0-8308-23932620f98b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=505f6b89c2d0d15fa2d6e6af36c3538f", "src_set": ""}, "body": "スケッチで喚び出した触手で片脚吊り上げY字バランス状態で擬似レイプオナニーしている太ももくらいサイズで玉無しのふたなりリルムをお願いします。\n\n両穴、尿道触手入ってて触手でお腹ボテってて欲しいです。\nふたなり部分は別レイヤで分けられればありがたいですが必須ではないです。\n\n着衣は帽子とブーツとチョーカーと腕輪あたりでお願いします", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maruchiro_/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/98672de8/uploads/origins/ec7bc62f-bb1b-4e61-b839-66dad87252f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1847b24130f45693a4a724c2e4b19741", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3371617, "client_id": 1853984, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 163, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@maruchiro_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id":