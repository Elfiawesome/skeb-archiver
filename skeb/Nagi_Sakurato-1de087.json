ましては資料通りにしていただいても構いませんし、飛鳥馬様の想像される服装にしていただいても構いません。\n二人のワンショットを自由に描いていただきたいと思っております。\nまた、互いの左手の薬指にシルバーの細い指輪を描いていただけますと幸いです。\n\n長くなってしまいましたが最後まで読んでくださりありがとうございました！\n何か不備等ございましたらキャンセルしていただいて大丈夫です。\nご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-BESGX-CPZHTko7eUwaivXre3P9L64VF", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 1500037, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "今日はْ 四月一日", "screen_name": "azm_slq", "avatar_url": "https://pbs.twimg.com/profile_images/1900690480851288064/xM81xLIB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1364857305662062594/1741995032/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 17}, {"id": 2550319, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "花深もゆ", "screen_name": "kafuka_moyu", "avatar_url": "https://pbs.twimg.com/profile_images/1928938214250917888/CyNIaX8q.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1606665634615799808/1748729695/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 3289530, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "うじろやき", "screen_name": "yakiringo_337", "avatar_url": "https://pbs.twimg.com/profile_images/1818681162921054208/eoKa9F2p.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1800427910110883842/1721110885/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank