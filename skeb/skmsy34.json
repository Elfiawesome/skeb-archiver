d4b72ea3c88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b66af2cbc65425f72af17ec736266ef0", "src_set": ""}, "body": "サクマ様\n\nこんばんは、サクマ様。\nこの前描いてくださったイラスト、とてもかわいかったです！\nありがとうございます！！\nそれで、もしよろしければ、前回の続きの姿を是非お願いしたいと思います。\n同じオリキャラの万里香、同じ私服のまま、今回は自分の部屋に戻ってきてその衣装のままにベッドでダラダラと本を読んでるのがみたいです。\n今回はデニムの質感がいきた脚の表現が見たいんですけどどうでしょうか？\nあ、それにもしよろしければモノクロでお願いします！\n設定と設定画は今回も下のURLにまとめております。\nご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\nいつも応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@skmsy34/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2766018, "client_id": 27685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4dc9e311/uploads/origins/13f04d3c-46e9-459e-88bf-e84c6f768a21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01100fef696a6192382075f64f41d1c8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4dc9e311/uploads/origins/13f04d3c-46e9-459e-88bf-e84c6f768a21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=76bd353b028398a920206a614144c690", "src_set": ""}, "body": "サクマ様\n\nこんばんは、サクマ様。\nツイッターのイラスト、拝見させていただきました。女性キャラのいろんな表情とポーズが見えて面白くて可愛かったです。おかげさまで良いものが見れました。\nアピールのことですけど、こちらのオリキャラのデザインと設定のことを褒めてくださり、すごく嬉しいです。ありがとうございます！\nではアピールでおっしゃってくださったように、万里香の私服姿でのワンシーンをどうかお願いしたいと思います。\nデニム、いいですね！色々と考えてくださりありがたい限りです。それなら万里香も普通に着るかな、と思います。\nでは構図は、画面の外側を意識してない、日常のワンシーンって感じがどうですか？\n秋ですし食べ歩きなどが良さそうかな、と思います。\n設定と設定画はもう全部見ましたかと思いますけど念の為リンク先に改めて貼っております。\nご検討くださいませ。\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@skmsy34/works/14", "private_thumbnail_i