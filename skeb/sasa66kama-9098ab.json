transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sasa66kama/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1694474, "client_id": 2009456, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30af3b3e/uploads/origins/f77d749f-5521-4089-a3c2-4bdc404e4593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58b2f7128c0a550c7359aedf48857bd5", "srcset": "https://si.imgix.net/30af3b3e/uploads/origins/f77d749f-5521-4089-a3c2-4bdc404e4593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58b2f7128c0a550c7359aedf48857bd5, https://si.imgix.net/30af3b3e/uploads/origins/f77d749f-5521-4089-a3c2-4bdc404e4593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c08db3dcd6bc11ac9f867874e08dbb9a 2x, https://si.imgix.net/30af3b3e/uploads/origins/f77d749f-5521-4089-a3c2-4bdc404e4593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c40de4fee2604d24220bc9e014b67a3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30af3b3e/uploads/origins/f77d749f-5521-4089-a3c2-4bdc404e4593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4bbeb5425ef3cc103543e74d99b93cc", "srcset": "https://si.imgix.net/30af3b3e/uploads/origins/f77d749f-5521-4089-a3c2-4bdc404e4593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4bbeb5425ef3cc103543e74d99b93cc, https://si.imgix.net/30af3b3e/uploads/origins/f77d749f-5521-4089-a3c2-4bdc404e4593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a1698cf47ce70fe84a8551cca6587e60 2x, https://si.imgix.net/30af3b3e/uploads/origins/f77d749f-5521-4089-a3c2-4bdc404e4593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=71b970ae65a89762f1b84e9d4f621e5f 3x"}, "body": "こんばんは、紫苑です。\n親御様許可の元、色々な方の絵柄で推しの絵を集めて幸せになっている者です。\nキャラクター名は燕昇司昴。よその子ですが、親御様よりリクエスト用の立ち絵とカラーパレットを描いていただいているので、添付します。\n\n是非とも、出来ればアナログの方で、描いていただけるととても喜びます……！\n\n【キャラクターの詳細設定について】\n・イラストで少し見落としやすい特徴は、右目の下の泣きぼくろ(目立たない位置にあります)と、左耳のピアス。髪はふわふわのくせ毛です。\n・身長は179cm、体重は67kg、身長高めの標準体型ですが、露出が少なくかっちりしたタイプの服を好むため、シュッとして見えます。\n・歳は18歳。高校3年生です。高校に通う傍ら、編集者として働いています。\n\n【もっと詳細な性格などの設定】\n・至って真面目、仕事人間、人に頼まれたことを断れない性格。\n・仕事以外では非常に不器用で、他人に対しての言葉選びを悩みに悩んだ結果最悪を引くようなタイプ。\n・表情の変化は決して少なくはありませんが、眉間に皺を寄せるような顔が多く、あまり笑顔は見せません。\n・結果として周りからは、ぶっきらぼう、とっつきにくいという印象を受けがちで、友達は多くありません。さらに、少し踏み込んで来た相手にとっては、大人しくて断らない都合のいい子扱いになることが多いです。やっぱり友達になれません。\n・編集としての腕は非常に高いですが、本人は作家志望でした。目が肥えすぎているため、自分の書くものに将来性を感じられず、諦めきれないけれど書けないジレンマを起こしています。そのため、作家全般に対して崇拝と劣等感を抱いています。\n・担当する作家に深く向き合うため、相手の好みをよく調べ、必要であれば染まります。その日会う作家によって香水を付けたり手土産を持っていったり、いくらか口調が変わるなどすることもあります。\n・諦めが非常に早く、全て自分のせいとして引受がちです。\n・気難しいように見えて、単に人に迷惑をかけたり嫌われるのが非常に怖いだけです。本性は人が大好きな甘えん坊、最早3歳児。けれどそこに気づく人はほぼいません。\n・本とコーヒーと静かな場所が大好きです。\n\n構図の希望は特にありません。お任せします。どんな推しでも私は喜ぶし愛します。\n上記内容で問題なければ、是非御検討お願い致します。\n\nhttps://www.dropbox.com/sh/89mjki17mcaf32p/AABxzB4UkVvyb72w6OPBQFe5a?dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@7_7lliq/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 998175, "client_id": 1694474, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a5e5ea7/uploads/origins/940d96d5-abea-40d3-9619-39417662b5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0227bf68257585469930537fc4b969f1", "srcset": "https://si.imgix.net/2a5e5ea7/uploads/origins/940d96d5-abea-40d3-9619-39417662b5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0227bf68257585469930537fc4b969f1, https://si.imgix.net/2a5e5ea7/uploads/origins/940d96d5-abea-40d3-9619-39417662b5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=587ee7435dbf91f01c8deb6badc