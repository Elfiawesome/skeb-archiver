00&h=200&s=92bd8d0b034aef7c405dfa2b2d9b93f7 2x, https://si.imgix.net/34c0839a/uploads/origins/3075eace-ce28-4b35-851d-21262b06119b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb712297530f248e5f11e70ac5afa372 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34c0839a/uploads/origins/3075eace-ce28-4b35-851d-21262b06119b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e0900300579e77a624621fbbe016876", "srcset": "https://si.imgix.net/34c0839a/uploads/origins/3075eace-ce28-4b35-851d-21262b06119b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e0900300579e77a624621fbbe016876, https://si.imgix.net/34c0839a/uploads/origins/3075eace-ce28-4b35-851d-21262b06119b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d662a70b5576871ad1b15a5cb699a649 2x, https://si.imgix.net/34c0839a/uploads/origins/3075eace-ce28-4b35-851d-21262b06119b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bdd77f18db640a88541dadd39f6aa214 3x"}, "body": "こんにちは！お久しぶりです…！\n吐瀉血さんにTRPGのOCを描いていただきたくリクエストを送らせていただきました🎶\n\n使用用途\n⚪︎個人鑑賞、壁紙/SNS/ココフォリア盤面やヘッダー等での使用。\n\nリクエストについて\n⚪︎笑顔を絶やさない体育教師の男性です。\n⚪︎髪型などは資料をご確認ください。\n ⚪︎服装はおまかせします。\n⚪︎構図なども全てお任せいたします。\n⚪︎イメージカラーは赤と黒です。\n⚪︎童顔で、顔立ちは女の子よりです。目は一重で髪型はM字前髪です。\n⚪︎絵柄やイラストの雰囲気が大好きです！暗めの雰囲気でお願いしたいです。\n\n基本全てお任せしますのでお好きなように描いてもらって大丈夫です。他の依頼イラストや資料はドライブの方に添付してあります、よろしくお願いします。\n \n内容が合わなければキャンセルしていただいて大丈夫です。\nお忙しいなか恐れ入りますが、ご検討よろしくお願いいたします。\n\n資料にはネタバレを一切含んでおりません。\n↓\nhttps://drive.google.com/drive/folders/1-0LDuxeB-TVClrQ8ZKhXF7mAFvh8MKhF", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arcadia_canon/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3574799, "client_id": 4002305, "vtt_url": null, "thumbnail_image_