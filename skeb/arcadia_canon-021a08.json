うな色\n表情￤優しく微笑んでいる感じでお願いします\n服装￤キャミソールワンピースにショートパンツ、上にカーディガン\n構図￤画像の7枚目のようなベッドに横になっている、またサムネで使用するため顔が見えやすいと嬉しいです！\n画像は私がVRCで使っているアバターです\n1.2枚目が顔、3~6枚目が服装、7枚目が構図の参考資料になっています\n\nお手数ですができれば人物・背景等のレイヤーを分けた透過データにて納品して頂けますと嬉しいです\n\nご検討のほどよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1SViqFxFdFXD3-SlRti4ShuWp-_0lxaQ7?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arcadia_canon/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4668a577/uploads/origins/d39acc6f-8bab-4ae9-9832-b5b7cc5d4779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=631b98f2648c57ab296faf9dc718cabc", "srcset": "https://si.imgix.net/4668a577/uploads/origins/d39acc6f-8bab-4ae9-9832-b5b7cc5d4779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=631b98f2648c57ab296faf9dc718cabc, https://si.imgix.net/4668a577/uploads/origins/d39acc6f-8bab-4ae9-9832-b5b7cc5d4779?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1bc8bb5cfdcdd920dff3bd28609c2464 2x, https://si.imgix.net/4668a577/uploads/origins/d39acc6f-8bab-4ae9-9832-b5b7cc5d4779?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ced0abd26840c715429d6d636283c61 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3574799, "client_id": 3102394, "nc": 0}, {"path": "/@arcadia_canon/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3574799, "client_id": 3936141, "vtt_url": null, "thumbnail_image_urls": {"src": "https://