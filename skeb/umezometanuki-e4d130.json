bp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23c89327c367bd5214b13024dcd2f701 2x, https://si.imgix.net/b9904d9f/uploads/origins/ca68d20a-1f32-43d3-a5cc-369c3cc3cc4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28fa71172987a0a2ab609c159ce775c4 3x"}, "body": "※依頼時のキャンセルボタンを戻るだと勘違いしてしまったので再送させて頂きます。\n　二重依頼になってしまっていたら申し訳ございません。\n\nお疲れ様です、言葉枝折（本人）です。\n秋の季節絵を是非描いて頂きたいと思い、今回依頼させて頂きました。\n早速ですが本題に入らせて頂きます。\n\n▼要望\n頭身の低い絵で申し訳ないのですが、\n資料画像のように肩から手首までをシースルーでニットのロングワンピース。スリット部分から白い生地のスカートに黒のブーツ。首元とくびれ付近のベルトは白基調で金のバックル。\n上記の恰好で紙袋に入った焼き芋を抱えている構図でお願いします。\n焼き芋を食べているかどうかはおまかせします。\n\n▼使用用途\n観賞用なのでグッズ展開等はありません。\n\n▼補足\nお絵描き配信で映して頂いても問題ないです。\n\n以上となります。よろしくお願い致します。\n\nhttps://drive.google.com/file/d/1oYmF0hh14HMdHXcbfYolBSa_BfRiS2K0/view?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umezometanuki/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1974038, "client_id": 102549, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae42a98f/uploads/origins/e69725de-362e-4cef-a2e7-28728aa37654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=979d5964181ed0788a50ed1310a62751", "srcset": "https://si.imgix.net/ae42a98f/uploads/origins/e69725de-362e-4cef-a2e7-28728aa37654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=979d5964181ed0788a50ed1310a62751, https://si.imgix.net/ae42a98f/uploads/origins/e69725de-362e-4cef-a2e7-28728aa37654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=766ca3ebf18cd4b8271aed7d5a370578 2x, https://si.imgix.net/ae42a98f/uploads/origins/e69725de-362e-4cef-a2e7-28728aa37654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70024cb982f407e93590b0bd2e9ab34d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.im