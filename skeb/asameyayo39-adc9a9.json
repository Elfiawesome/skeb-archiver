を迎え、迷った魂を導くというものです。この情報が参考になれば幸いです！\n\n【特徴】\n・要素：紅葉、彼岸花、ランプ、幽霊\n・赤い目、瞳孔はカエデの葉\n・左側のサイドの髪が長くなっています\n・両手の爪は黒色\n\n【希望のリクエスト】\n・表情やポーズ・衣装・構図・背景についてはおまかせします。\n・背景がある場合、もしよろしければ、背景と人物を分けて頂けると幸いです。\n\n【用途可能】\n・配信のサムネイル\n・SNS\n・個人観賞用のグッズ作成\n\nご検討のほど、よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1PFyW62gMsePFAYKD8kAcWEBu8SChaQcO?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@asameyayo39/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2765074, "client_id": 3171658, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7881f553/uploads/origins/e719f0ce-4de7-41ea-9bd8-32c7f26337b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2098d4bced1d31893085c2718cf97ad7", "srcset": "https://si.imgix.net/7881f553/uploads/origins/e719f0ce-4de7-41ea-9bd8-32c7f26337b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2098d4bced1d31893085c2718cf97ad7, https://si.imgix.net/7881f553/uploads/origins/e719f0ce-4de7-41ea-9bd8-32c7f26337b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1daa8c59fd6677b8b15b79b7df6788ed 2x, https://si.imgix.net/7881f553/uploads/origins/e719f0ce-4de7-41ea-9bd8-32c7f26337b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6979a892de6c0cd5e59d5fcbfb58de76 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7881f553/uploads/origins/e719f0ce-4de7-41ea-9bd8-32c7f26337b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d552ef6c50fc8aed06c6336e61408794", "srcset": "https://si.imgix.net/7881f553/uploads/origins/e719f0ce-4de7-41ea-9bd8-32c7f26337b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d552ef6c50fc8aed06c6336e61408794, https://si.imgix.net/7881f553/uploads/origins/e7