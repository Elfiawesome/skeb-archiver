rop=top&w=200&h=200&blur=200&s=8c2aef5684accda0185a12f56c16932a 3x"}, "body": "グラムさん、こんにちは！いつもﾂｲｯﾀで楽しくぐらむ家のみんなを見ております。\nグラムさんの絵やデフォルメ加減、色使いなどが大好きです。\nスケブ募集中とのことで、もしよければ拙宅の「ガム」を描いて頂けないでしょうか？\n\n用途は個人観賞用になります。また、下記リンク先に【描いていただいた作品】としてお名前付きで保存したいと考えております。\n\n【キャラクターについて】\n名前：ガム\n男、14歳(中学3年）、157cm、35kg\n緑の瞳、タレ目、白髪、天然パーマで後ろを刈り上げ。\n背はほぼ平均値だが、無自覚の拒食でひどく痩せている。\n\n基本無口。言動がどこかズレていたり、よくぼんやりしている不思議ちゃんタイプ。\n\n友達と一緒だとよく笑う。芯が強くここぞという時には強い表情になる。\nキックアクションが得意。\n\n【世界観】\n現代ファンタジーで、ちょっとした不思議を子供たちが解決する作品のキャライメージです。\n（既存作品で例えると、ペルソナ、電脳コイルに近い。）\n\n【構図など】\nすべてお任せいたします！\n描きにくい子だと思うのですが、グラムさん絵が大好きなのでご自身の絵柄を全開に、自由にお願いしたいです。解釈違いなどもありませんので、楽しく描いていただければ幸いです。\n\n***\nお値段指定・キャンセルはどうぞお気兼ねなく、\nご検討、何卒よろしくお願いいたします。\n\n【資料】\nhttps://drive.google.com/drive/folders/1iuRkqiN_ymFsaa68TwYPm1YcJzwbSY8Z?usp=sharing\n\n【他の方が描いた資料】\nhttps://portfolder.jp/users/kabohell/j9dIiDApIOy1HPJCPXL4/vAw5eawYDiA0KStXH2gV", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@GuraGuramu_493/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2480336, "client_id": 2693386, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7148b846/uploads/origins/7bb85104-0b3e-4fcd-89eb-02f79f5c9058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=189553d8b3fb73d868786c4e7d26c740", "srcset": "https://si.imgix.net/7148b846/uploads/origins/7bb85104-0b3e-4fcd-89eb-02f79f5c9058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=189553d8b3fb73d868786c4e7d26c740, https://si.imgix.net/7148b846/uploads/origins/7bb85104-0b3e-4fcd-89eb-02f79f5c9058?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b9c33d2c1f3f82850c8783b86cdcf87 2x, https://si.imgix.net/7148b846/uploads/origins/7bb85104-0b3e-4fcd-89eb-02f79f5c9058?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a90cbc85e7c0b348e059f8da8144620 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7148b846/uploads/origins/7bb85104-0b3e-4fcd-89eb-02f79f5c9058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0e89d1bc455e10427a78411fd935298", "srcset": "https://si.imgix.net/7148b846/uploads/origins/7bb85104-0b3e-4fcd-89eb-02f79f5c9058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0e89d1bc455e10427a78411fd935298, https://si.imgix.net/7148b846/uploads/origins/7bb85104-0b3e-4fcd-89eb-02f79f5c9058?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3e6455215b6b34293b5a91df7ca2b7eb 2x, https://si.imgix.net/7148b846/uploads/origins/7bb85104-0b3e-4fcd-89eb-02f79f5c9058?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=84a3888e96ab83fb6e4f66c5f54e44b6 3x"}, "body": "グラムさん、お世話になっておりますしらすです！スケブ初めて利用するので不手際ありましたらすみません…\n\nうちの黒川描いていただくことは可能でしょうか…？ゲス顔してたら嬉しいです。あとはポーズもなにも全部お任せで大丈夫です〜！\n利用目的は観賞用になります。\n\n\n参考資料？はこれでいいのでしょうか…\n何かありましたらすみません…🫢よろしくお願いします！\n\nhttps://twitter.com/sira_s03/status/1640307689363320832?s=46&t=Vbj6n_VZzpCJgzDxF12VbA", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@GuraGuramu_493/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2480336, "client_id": 2442213, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2fea06c2/uploads/origins/dbc51ef4-a775-4426-a1fd-e45e7141c95f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c962ea72210a7e05addf1ec76587f700", "srcset": "https://si.imgix.net/2fea06c2/uploads/origins/dbc51ef4-a775-4426-a1fd-e45e7141c95f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c962ea72210a7e05addf1ec76587f700, https://si.imgix.net/2fea06c2/uploads/origins/dbc51ef4-a775-4426-a1fd-e45e7141c95f?bg=%23fff&auto=format%2