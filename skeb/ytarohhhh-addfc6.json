でもしっかり着込んでいてもどちらでも構いません)で、シュウジの方はいつもの白いシャツでも服を脱いでいてもどちらでも大丈夫です。\n何卒よろしくお願い致します。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ytarohhhh/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/29861bdc/uploads/origins/b05c9d79-a34a-4371-9454-7787606b49b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b2c1b1065452c60a9954de0f79f8467", "srcset": "https://si.imgix.net/29861bdc/uploads/origins/b05c9d79-a34a-4371-9454-7787606b49b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b2c1b1065452c60a9954de0f79f8467, https://si.imgix.net/29861bdc/uploads/origins/b05c9d79-a34a-4371-9454-7787606b49b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c56c44da166c3e55bee9ee6b6a4aed20 2x, https://si.imgix.net/29861bdc/uploads/origins/b05c9d79-a34a-4371-9454-7787606b49b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=843094c917e612930195ccb52d193ae4 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3773726, "nc": 144}, {"path": "/@ytarohhhh/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/30e1103c/uploads/origins/e7806c0b-c0fe-4e80-8440-2b84f5531a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f80f03f180d21b21dc9dfb2b4e4d9b3c", "srcset": "https://si.imgix.net/30e1103c/uploads/origins/e7806c0b-c0fe-4e80-8440-2b84f5531a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&c