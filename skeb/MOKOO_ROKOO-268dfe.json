%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5050d80d083b1349238fd9c63b42188, https://si.imgix.net/151d68b5/uploads/origins/94c6921c-cfa1-461d-a4fb-38d22da6e77a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d1301b5ac84ffec861984719b04adb4 2x, https://si.imgix.net/151d68b5/uploads/origins/94c6921c-cfa1-461d-a4fb-38d22da6e77a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4597d013c055161885fbe06e15692b3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/151d68b5/uploads/origins/94c6921c-cfa1-461d-a4fb-38d22da6e77a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da5baede4705a897fe5737029454e83b", "srcset": "https://si.imgix.net/151d68b5/uploads/origins/94c6921c-cfa1-461d-a4fb-38d22da6e77a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da5baede4705a897fe5737029454e83b, https://si.imgix.net/151d68b5/uploads/origins/94c6921c-cfa1-461d-a4fb-38d22da6e77a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=466a7ce7a18994048ce46a9e44f03d36 2x, https://si.imgix.net/151d68b5/uploads/origins/94c6921c-cfa1-461d-a4fb-38d22da6e77a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1619b8cc241ce952b2f2a458c33f246f 3x"}, "body": "もか茶先生、こんにちは！前回お願いしたリクエストの作品は、大変素晴らしく感動いたしました！\n\nいつも通り先生の温かく、もふもふとした作風に魅了されております。もしよろしければ、今回も一枚作品をお描きいただけますと幸いです。\n\n三匹の小さな狐（ススーロ、シャマレ、スズラン）が、頭を重ね合わせて草原で日向ぼっこをしているシーンをお願いできればと存じます。正面からの視点で、三つの頭と彼女たちの尻尾だけが見える構図で、体の部分は先生のご判断で簡略化していただいて構いません。\n\n上から順にススーロ、シャマレ、スズランとなっております。\n\nこのアイデアは、インターネットで見かけた重なり合う小狐たちの可愛らしさからインスピレーションを受けました。ご参考までに添付した画像のようなイメージです。\n\n前回同様、商用利用の予定はございません。友人たちにポストカードとして配る予定でございます。\n\n誠にありがとうございます。何卒よろしくお願い申し上げます。\n\nhttps://weibo.com/2760765997/MkOgQdH9Z", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MOKOO_ROKOO/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2453647, "client_id": 507423, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a4e4851/uploads/origins/67785d4c-f671-4089-981a-6176f8645ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1b7d757a6eb37a8ecd2f96f0adea6de", "srcset": "https://si.imgix.net/0a4e4851/uploads/origins/67785d4c-f671-4089-981a-6176f8645ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1b7d757a6eb37a8ecd2f96f0adea6de, https://si.imgix.net/0a4e4851/uploads/origins/67785d4c-f671-4089-981a-6176f8645ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96ae6f10178db58e742d4eb3e1e141c1 2x, https://si.imgix.net/0a4e4851/uploads/origins/67785d4c-f671-4089-981a-6176f8645ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd0a5d86fd284a650a3d908cfdc2b9f6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a4e4851/uploads/origins/67785d4c-f671-4089-981a-6176f8645ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7d6837aded7a186927446363ff91acd", "srcset": "https://si.imgix.net/0a4e4851/uploads/origins/67785d4c-f671-4089-981a-6176f8645ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7d6837aded7a186927446363ff91acd, https://si.imgix.net/0a4e4851/uploads/origins/67785d4c-f671-4089-981a-6176f8645ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c782ca6e5ebc45e976eef9f9f4a09ab0 2x, https://si.imgix.net/0a4e4851/uploads/origins/67785d4c-f671-4089-981a-6176f8645ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c8a1fab2f6b16244c78abd8b09a63106 3x"}, "body": "もか茶様\nはじめまして。もか茶様の絵柄が気に入りましたので、依頼を送らせていただきます。\n犬耳、尻尾の巫女の女の子が種子島(鉄砲)で射撃姿勢を取っている、もしくは射撃している絵を描いていただけないでしょうか。\n\n詳細\n犬種　柴犬、秋田犬、北海道犬、甲斐犬、紀州犬、四国犬の中からお願いします。\n髪、瞳の色　上記で選んだ犬種を基準にお願いします。(髪型と長さは任せます)\n射撃姿勢　立ち射ち、膝射ち、座り射ち、寝射ちの中からお願いします。指を引き金にかけて、今にも射撃をしそうな状況、あるいは射撃している状況をお願いします。\n種子島　一般的な大きさである小筒のほか、大型である中筒、士筒のどれを使っていても構いません。\n巫女装束　巫女装束は丈が短かったり肩に切れ込みがある創作特有のものではなく、正規の物をお願いします。また、損傷していても構いません。\n表情　恐怖で怯えている以外でしたら好きに描写して構いません。(例　落ち着いた感じで淡々としている、不敵な笑みを浮かべている、穏やかに微笑んでいる、戦闘狂染みている、自我を失っている等)\n胸部　貧から爆までの範囲でお任せします。\nその他　早合「http://www.xn--u9j370humdba539qcybpym.jp/part1/archives/35」、「https://www.meihaku.jp/arquebus-basic/matchlock-launchmethod/」を首から下げている。(または袈裟懸けで下げている)\n負傷描写等　一切なくても構いませんし、軽傷または重傷でありながらも堪えている、ないしはものともしないような描写でも構いません。また、土や泥の汚れについても任せます。\n巫女装束が損傷していても構いませんが、下着等が露出することがないようにお願いします。\n場所　委任しますが、宇宙空間等のSF要素を感じさせるものは却下でお願いします。\nセリフ等差分\n内容等に合うものを委任します。\n\nもか茶様の発想に頼るところが大きいですが、何卒よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MOKOO_ROKOO/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2453647, "client_id": 3253554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/451bc842/uploads/origins/b30531be-cdcf-44ba-aa5a-e6ca952ed75b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c0ed14763acb3afd9dab2fa11f6a185", "srcset": "https://si.imgix.net/451bc842/uploads/origins/b30531be-cdcf-44ba-aa5a-e6ca952ed75b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c0ed14763acb3afd9dab2fa11f6a185, https://si.imgix.net/451bc842/uploads/origins/b30531be-cdcf-44ba-aa5a-e6ca952ed75b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be4f17ce44a610f178decfddb2fcbe01 2x, https://si.imgix.net/451bc842/uploads/origins/b30531be-cdcf-44ba-aa5a-e6ca952ed75b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a94485b54098ae6a3f6f91678477769 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls"