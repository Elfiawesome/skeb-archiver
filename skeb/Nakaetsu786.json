ab-cc36f6c87b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=516dc7ec7f0b45c28aad51bc25f34b5a", "src_set": ""}, "body": "以前、ワンピース＆帽子で赤系統多めの女の子を依頼した者です。前回のイラストが本当に可愛くて、今は作業机の横に飾って毎日元気をもらってます！その節は本当にありがとうございました！\nそこで今回もイラストをお願いしたいと思います。\n涼しそうな格好(夏っぽい格好)をした女の子で髪は背中の真ん中くらいの長さ、細かいところはアキラメラさんにおまかせします(すごく大雑把な注文でごめんなさい💦)。今回もまた赤系統の色を多めにしてもらえたらと思います。\n最近どんどん暑くなってきましたが、アキラメラさんもテグーちゃんも熱中症などにはお気をつけください。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nakaetsu786/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1120623, "client_id": 2003352, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2831b117/uploads/origins/0bb39bdd-871a-4ce2-a981-f1f6f212ed26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b62c10a32fee74f8f36df2ed76192be", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2831b117/uploads/origins/0bb39bdd-871a-4ce2-a981-f1f6f212ed26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1883348fd27c939737357af6f58da079", "src_set": ""}, "body": "この度、依頼の機会を設けていただき、ありがとうございます。\n\n依頼したいのはうちのオリジナルキャラクターです。\n\n\nテンペスタ、嵐の名前を持つイタリア人の女性です。\n医者である同時に暗殺者でもあります。服の中(袖など)から複数のメスを投げるのが特技です。\n見た目は官能的で優雅なお姉さんですが、実はやんちゃな性格で、メガデレのかわいこちゃんです。\nしかし血と傷を見るのが大好きなサディスト、変態的な一面もあります。他人をいじめるのではなく、好きなのはひたすら血のみ。\nマッドドクターですが普通の時は親切でいい人です。\n\n以上、うちのキャラクターの簡略な設定でした。外形の解説とイラストは下のリンクに添付されております。\n\nよろしくお願いいたします！\n\nhttps://www.evernote.com/shard/s433/sh/a789beb4-6aa0-5af5-f360-cc8936e384cc/a477d33b7d5c50c69c1d15fc1ec1f17a", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nakaetsu786/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1120623, "client_id": 751945, "vtt_url": null, "thum