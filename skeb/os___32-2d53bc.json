%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=b097fc6dc04937cf6fd37ef492538872", "skills": [{"genre": "art", "default_amount": 11000}], "payment_methods": {"credit_cards": {"jcb": {"nsfw": true}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@os___32/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3907382, "client_id": 2060511, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bac617db/uploads/origins/bb20892e-fc4a-42bd-9b25-fdc79f788fcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0905f49aebcad0cd9be799930b4b5b1", "srcset": "https://si.imgix.net/bac617db/uploads/origins/bb20892e-fc4a-42bd-9b25-fdc79f788fcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0905f49aebcad0cd9be799930b4b5b1, https://si.imgix.net/bac617db/uploads/origins/bb20892e-fc4a-42bd-9b25-fdc79f788fcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbf96f327809d016e3e55dfa3daeb2d9 2x, https://si.imgix.net/bac617db/uploads/origins/bb20892e-fc4a-42bd-9b25-fdc79f788fcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40b1785ed5f35e05ca86395a4036fd4e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bac617db/uploads/origins/bb20892e-fc4a-42bd-9b25-fdc79f788fcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2153123d07684999cfed6ebe521bdd30", "srcset": "https://si.imgix.net/bac617db/uploads/origins/bb20892e-fc4a-42bd-9b25-fdc79f788fcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2153123d07684999cfed6ebe521bdd30, https://si.imgix.net/bac617db/uploads/origins/bb20892e-fc4a-42bd-9b25-fdc79f788fcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c8252e74139d150d33ad0c333500a090 2x, https://si.imgix.net/bac617db/uploads/origins/bb20892e-fc4a-42bd-9b25-fdc79f788fcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=51851de7085af61d01c1031129dec254 3x"}, "body": "またお手数をおかけして大変申し訳ありませんが、もし可能であれば、もう一度私のオリジナルキャラクターのイラストを描いていただけないでしょうか。あなたの作品が本当に大好きなんです。\n前回同様、参考資料はリンク先からご覧いただけます。もしお引き受けいただけましたら、大変ありがたく存じます。\n\nイラストのテーマについては、以下のいずれかをお選びいただけます：\n- 彼らが一緒に楽しく、喜びに満ちて新年（またはクリスマス）を祝う様子。\n- 彼らが楽しく、充実したハロウィンを過ごす様子。\nもし他にアイデアがあれば、私が提示した選択肢から選ぶのではなく、そのアイデアをイラストに取り入れていただけると嬉しいです。私のオリジナルキャラクターを、ぜひあなたのスタイルで描いてください。\n\n私のオリジナルキャラクターの服装は、お好きなものを描いていただいて構いません。もしよければ、新しい衣装をデザインしていただいても結構です。\nイラストのテーマとして新年（またはクリスマス）を選ばれる場合は、アナの衣装を参考に描いてください。ハロウィンをテーマにされる場合は、私のオリジナルキャラクターたちがハロウィンに仮装した姿を見たいので、彼らに似合うと思うハロウィンコスチュームを着せてください。 キャラクターに似合うと思うハロウィンコスチュームなら、どんなものでも構いません。\n\nキャラクター紹介\nハーマン：身長208cm、薄茶色の髪、赤みがかった茶色の瞳\n大佐で、仕事中毒です。軍内では非常に有力で、数々の勲章を受け、尊敬されています。任務中に負った傷により、顔に傷跡が残っています。 普段は感情をあまり表に出さない真面目な男だ。アナに深く恋しており、彼女の明るく純粋な魂に惹かれている。\nアナ：身長154cm、茶黒混じりの髪、琥珀色の瞳、明るいブロンズ色の肌\n小柄でスレンダーな体つき、甘く優しい性格。 彼女はとても美しく、料理も非常に上手です。かつてマフィアから虐待を受け、人身売買の被害者となっていましたが、ハーマンに救われました。ハーマンの優しい支えのもと、彼女は新しい人生を歩み始めました。彼女はハーマンを深く愛しており、彼の優しさに惹かれています。\n二人は恋人であり、魂の伴侶です。互いに癒し合っています。\n\nハーマンの顔の傷跡を簡略化しないでください。彼の戦術装備を描きたい場合：ヘルメットについては、暗視ゴーグルを描いても描かなくても構いません。ボディアーマーの空いている部分については、弾倉で埋めてください。 描く際は、絵画『Herman-other』を参考にしてください。彼のタトゥーを描きたい場合は、自由に簡略化して構いません。\nアナは小柄でスレンダー、肌色は明るいブロンズ色です。\n私の依頼内容に不適切な点があれば、遠慮なく再送してください。 私のオリジナルキャラクターに興味がない場合は、遠慮なく直接キャンセルしてください。リクエストをお読みいただき、ご検討いただきありがとうございます。\n\nhttps://drive.google.com/drive/folders/1aJgPE6IJC8ZngNkvNAjP8G0UKHKVs0Zx", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@os___32/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3907382, "client_id": 2459677, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/988a7d18/uploads/origins/35021ccb-40c1-40e5-898a-b0522d368959?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5cb55a1f861dc1bff5fee99be52bc1f", "srcset": "https://si.imgix.net/988a7d18/uploads/origins/35021ccb-40c1-40e5-898a-b0522d368959?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5cb55a1f861dc1bff5fee99be52bc1f, https://si.imgix.net/988a7d18/uploads/origins/35021ccb-40c1-40e5-898a-b0522d368959?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84c061da65d325564db6b10a1ec40e6c 2x, https://si.imgix.net/988a7d18/uploads/origins/35021ccb-40c1-40e5-898a-b0522d368959?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04b56b4773ae44ca255cc2c33749851e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/988a7d18/uploads/origins/35021ccb-40c1-40e5-898a-b0522d368959?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad722a44166181ede50eb3e13cab17f1", "srcset": "https://si.imgix.net/988a7d18/uploads/origins/35021ccb-40c1-40e5-898a-b0522d368959?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad722a44166181ede50eb3e13cab17f1, https://si.imgix.net/988a7d18/uploads/origins/35021ccb-40c1-40e5-898a-b0522d368959?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e19bc467708696884e8d792cd5de23e0 2x, https://si.imgix.net/988a7d18/uploads/origins/35021ccb-40c1-40e5-898a-b0522d368959?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed6595ed49730ff0d9445a569a0d909d 3x"}, "body": "I really love your art style! Your drawings have such a fabulous sense of atmosphere and expression, and your colors are lovely. I'm especially fond of your use of textures, and how gorgeously you draw faces. I really love how you drew in https://x.com/os___32/status/2028196836532740428/photo/1 \n\nI would love if you could draw my orichara, Cedric!\n\nCedric [180cm]\nCedric is a young nobleman. He lives in a fantasy world and can use magic. If he was in a shoujo manga, roses and sparkles would follow him loyally in the background, to the point where it'd be a little annoying!\n\nHe's vain, sheltered, a flirt, and sensitive. (Basically, he's really annoying!) But his good points are his passion, his earnestness, his generosity, and how much he cares for people. Sometimes, he acts bold and authoritative--in those moments, you can feel his charm and status.\n\nHe likes to swordfight, dance, read romantic novels, ride horses, and socialize.\n\nPlease draw him with a signet ring on his right index finger! You can dress him in Uniform 1 or 2 from the references, or you can change his outfit! Sometimes he ties his hair with a lavender ribbon.\n\nPossible scenarios are:\n- Surrounded by fireflies in a forest, gently smiling with wonder\n- Grinning happily under an open and starry night sky\n- Holding flowers and smiling at the viewer like a cheesy otome CG!\n\nBut more than anything, I'd really like sensei to draw whatever is most fun for you! You're a genius so anything that comes out of your head will be splendid. So if you have another idea, please draw freely!\n\nMOTIF: flowers, nobility, stars, crown, portrait of himself\n\nThank you so much for your consideration! If anything is lacking, please feel free to resend!\n\n(Also, if there are any discarded sketches, I would love them in the PSD!)\n\nhttps://drive.google.com/drive/folders/1hmhrWwko1Y6LvSRaxUwSA-aT_Q9f0dee?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@os___32/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3907382, "client_id": 3811170, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94f56584/uploads/origins/1d5c7ee7-231a-4f11-bd97-314405f21120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29214c450ba350bae9ecee381be1f6af", "srcset": "https://si.imgix.net/94f56584/uploads/origins/1d5c7ee7-231a-4f11-bd97-314405f21120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29214c450ba350bae9ecee381be1f6af, https://si.imgix.net/94f56584/uploads/origins/1d5c7ee7-231a-4f11-bd97-314405f21120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c01c928c179e805720fb79223daa5491 2x, https://si.imgix.net/94f56584/uploads/origins/1d5c7ee7-231a-4f11-bd97-314405f21120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=148f9fc7d50a6177269480f5f37a88d1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94f56584/uploads/origins/1d5c7ee7-231a-4f11-bd97-314405f21120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c30603f1123c8bc6aaa8407bc58cc89", "srcset": "https://si.imgix.net/94f56584/uploads/origins/1d5c7ee7-231a-4f11-bd97-314405f21120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c30603f1123c8bc6aaa8407bc58cc89, https://si.imgix.net/94f56584/uploads/origins/1d5c7ee7-231a-4f11-bd97-314405f21120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=144eb1cd6967c60f7746f887611aec5b 2x, https://si.imgix.net/94f56584/uploads/origins/1d5c7ee7-231a-4f11-bd97-314405f21120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=81cbee100c658f94160f9cf6d8dfac33 3x"}, "body": "おさみつ様、こんにちは！\n\n前回の完成作品が本当に気に入りましたので、またお願いしたいと思っています！\n\n今回お願いしたいのは、前回ご依頼したオリジナルキャラクターのうち、黒髪のキャラクターと茶髪のキャラクターの2人です。\n依頼内容は、二人が朝起きたばかりの、仲睦まじいひとときといった感じにしたいです。\n\n構図、雰囲気、衣装、すべてお任せします！料金について調整が必要な場合は、ぜひお知らせください。よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1QaT786rghCqTVF1o1UNVTnef8a1AKGC4", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@os___32/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3907382, "client_id": 2060511, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78bfef31/uploads/origins/46ad8794-6e3c-4f28-b3dc-810a26aa3dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f95e67010962d841c557c898e964cd14", "srcset": "https://si.imgix.net/78bfef31/uploads/origins/46ad8794-6e3c-4f28-b3dc-810a26aa3dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f95e67010962d841c557c898e964cd14, https://si.imgix.net/78bfef31/uploads/origins/46ad8794-6e3c-4f28-b3dc-810a26aa3dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8cbcd3369b02d8ab3b38e1d10aeb6f85 2x, https://si.imgix.net/78bfef31/uploads/origins/46ad8794-6e3c-4f28-b3dc-810a26aa3dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3399b4d64978841180ded6e1bf07c4d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78bfef31/uploads/origins/46ad8794-6e3c-4f28-b3dc-810a26aa3dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0197b19d4ee8bad7d480b8e50894c2ff", "srcset": "https://si.imgix.net/78bfef31/uploads/origins/46ad8794-6e3c-4f28-b3dc-810a26aa3dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0197b19d4ee8bad7d480b8e50894c2ff, https://si.imgix.net/78bfef31/uploads/origins/46ad8794-6e3c-4f28-b3dc-810a26aa3dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4858e3c078aedf833cd14f9a6e4da230 2x, https://si.imgix.net/78bfef31/uploads/origins/46ad8794-6e3c-4f28-b3dc-810a26aa3dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7f7581f4fbecbc46c29398779b930993 3x"}, "body": "あなたの作品が大好きです。イラストがとても美しく、心に響きます。私のNLオリジナルキャラクター（OC）のイラストを描いていただけないでしょうか。お引き受けいただければ、この上なく嬉しく思います。\n参考資料はすべて以下のリンクにまとめてあります。どうぞご自身のスタイルで私のOCを描いてください。\n私のオリジナルキャラクターには、お好きな服装を描いていただいて構いません。もしよろしければ、新しい衣装をデザインしていただいても結構です。\n\nキャラクター紹介\nハーマン：身長208cm、薄茶色の髪、赤みがかった茶色の瞳\n大佐で、仕事中毒です。軍内では非常に有力な存在であり、数々の勲章を授与され、尊敬されています。任務中に負った傷により、顔に傷跡が残っています。普段は感情をあまり表に出さない、真面目な人物です。アナに深く恋しており、彼女の明るく純粋な魂に惹かれています。\nアナ：身長154cm、黒みがかった茶色の髪、琥珀色の瞳、淡いブロンズ色の肌\n小柄でほっそりとした体つき、甘く優しい性格。とても美しく、料理も得意だ。かつてマフィアから虐待を受け、人身売買の被害者となっていたが、ハーマンに救われた。ハーマンの優しい支えのもと、新しい人生を歩み始めた。 彼女はハーマンを深く愛しており、彼の優しさに惹かれている。\n二人は恋人であり、魂の伴侶だ。互いに癒し合っている。\n\nハーマンの顔の傷は、簡略化しないでください。戦術装備を描きたい場合：ヘルメットに関しては、暗視ゴーグルを描いても描かなくても構いません。 ボディアーマーの空いている部分については、弾倉で埋めてください。描く際は「Herman-other」のイラストを参考にしてください。彼にはタトゥーがありますが、描く場合は簡略化しても構いません。\nアナは小柄でほっそりとした体型で、肌色は明るいブロンズ色です。衣装を描く際は、「アナ-衣装」を参考にしてください。\n私の依頼内容に不適切な点があれば、遠慮なく再送してください。私のオリジナルキャラクターに興味がない場合は、直接キャンセルしていただいて構いません。私の依頼をお読みいただき、ご検討いただきありがとうございます。\n\nhttps://drive.google.com/drive/folders/1hSUc3lrDv6yatSyhxqc4Al5Ni_NoLdel", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@os___32/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3907382, "client_id": 3875166, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3230db3/uploads/origins/eea46662-f101-43c1-a0ff-01e12121de4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f289a21013574f8baa666006b88a6795", "srcset": "https://si.imgix.net/a3230db3/uploads/origins/eea46662-f101-43c1-a0ff-01e12121de4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f289a21013574f8baa666006b88a6795, https://si.imgix.net/a3230db3/uploads/origins/eea46662-f101-43c1-a0ff-01e12121de4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29a1064bf437464f35c6f297cc5a4340 2x, https://si.imgix.net/a3230db3/uploads/origins/eea46662-f101-43c1-a0ff-01e12121de4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f069657f2207cb205a0c67012d814df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a3230db3/uploads/origins/eea46662-f101-43c1-a0ff-01e12121de4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40e4cfda01f56aab78336a86bd2e5c4f", "srcset": "https://si.imgix.net/a3230db3/uploads/origins/eea46662-f101-43c1-a0ff-01e12121de4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40e4cfda01f56aab78336a86bd2e5c4f, https://si.imgix.net/a3230db3/uploads/origins/eea46662-f101-43c1-a0ff-01e12121de4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=915b4da95cf1a32e43ae6b337f4b29b1 2x, https://si.imgix.net/a3230db3/uploads/origins/eea46662-f101-43c1-a0ff-01e12121de4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=398d011e31126591e27c5d1b4e6efd13 3x"}, "body": "こんにちは！SNSで以前のSkebの作品を拝見したのですが、その構図と表現力に本当に心を打たれました！そこで、もしよろしければ、私のオリジナルキャラクター2人のイラストをお願いしたいのですが……！！\nこの2人はとても仲の良い親友で、お互いを深く思い合っていますが、互いに秘めた想いを抱いています。  \nマスイ（黄色い髪の女の子）はとても元気で社交的で、タコシにも自分のエネルギーに合わせてほしいと願っています。 タコシが抱える個人的な悩みを気にかけているため、よくささやかなプレゼント（小さなブラインドボックスやガチャポンのフィギュア、テーマに沿ったペンや文房具など）や、お菓子や飲み物を渡しています。彼と一緒にゲームセンターやショッピングモールに行くのが好きですが、彼の趣味に一緒に参加することも大いに喜んでいます。\nタコシ（青い髪の少年）はどちらかといえば控えめで静かだが、マスマイの元気さに合わせようと努力している。家庭や人間関係で多くの悩みを抱えているが、その苦悩を誰にも見せないようにしている。 彼はマスマイのことをとても大切に思っており、彼女もまた自分なりの悩みを抱えていることを知っているため、自分のことよりも彼女のことを心配しています。何をしていても、彼女と一緒にいる時が一番幸せです。 科学や神話に関する本を読むのが好きで、星空を眺めるのも大好きです。マスマイが彼の趣味に興味を示してくれると、本当に嬉しくなります。\nお好きなように描いてください！！また、提供された参考画像にある服装のバリエーションを自由に使用したり、お好みで衣装をアレンジしたりしても構いません。 🙂‍↕️ ありがとうございます！！！\n\nhttps://drive.google.com/drive/folders/1EYVBhHIsfbGrKWY_P3pDRCKPh69d8JwX", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@os___32/works/4", "private_thumbnail_