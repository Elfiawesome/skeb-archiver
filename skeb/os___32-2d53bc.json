星空を眺めるのも大好きです。マスマイが彼の趣味に興味を示してくれると、本当に嬉しくなります。\nお好きなように描いてください！！また、提供された参考画像にある服装のバリエーションを自由に使用したり、お好みで衣装をアレンジしたりしても構いません。 🙂‍↕️ ありがとうございます！！！\n\nhttps://drive.google.com/drive/folders/1EYVBhHIsfbGrKWY_P3pDRCKPh69d8JwX", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@os___32/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3907382, "client_id": 3811170, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e5566dc4/uploads/origins/101e845d-b05b-4ab0-9809-7b7766109239?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73b87614ad9f65bcbcfc3174d9313b6d", "srcset": "https://si.imgix.net/e5566dc4/uploads/origins/101e845d-b05b-4ab0-9809-7b7766109239?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73b87614ad9f65bcbcfc3174d9313b6d, https://si.imgix.net/e5566dc4/uploads/origins/101e845d-b05b-4ab0-9809-7b7766109239?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a5f00f149b78396f9bbc6b044c63609 2x, https://si.imgix.net/e5566dc4/uploads/origins/101e845d-b05b-4ab0-9809-7b7766109239?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d74bbb2420f747cae5d3485f3668b1ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e5566dc4/uploads/origins/101e845d-b05b-4ab0-9809-7b7766109239?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f650434a4f0705f1fba4484831d8260", "srcset": "https://si.imgix.net/e5566dc4/uploads/origins/101e845d-b05b-4ab0-9809-7b7766109239?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f650434a4f0705f1fba4484831d8260, https://si.imgix.net/e5566dc4/uploads/origins/101e845d-b05b-4ab0-9809-7b7766109239?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad087595bf