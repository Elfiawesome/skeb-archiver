何卒ご容赦ください……！\nクラウドフォルダ内にキャラクターの紹介資料を添付しております。4人のうち、AとBは同じ事務所に所属しており、CとDもまた同じ事務所に所属していますが、彼らは皆、友人同士です！\n\n4人のプライベートでの親しいやり取りを、お好きなように描いていただけると嬉しいです。衣装、髪型、構図、雰囲気など、すべてご自由にアレンジしてください。\n\n料金について調整が必要な点がございましたら、ぜひお知らせください。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1BS86PJD4ESweqHHwyxV6YNzUGtRUtpFS", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@os___32/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3907382, "client_id": 3060791, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0316482a/uploads/origins/cb209d66-85d6-4298-8bf5-32dbedb3124d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bf766f2c2cfbf59999001a9ed77ca90", "srcset": "https://si.imgix.net/0316482a/uploads/origins/cb209d66-85d6-4298-8bf5-32dbedb3124d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bf766f2c2cfbf59999001a9ed77ca90, https://si.imgix.net/0316482a/uploads/origins/cb209d66-85d6-4298-8bf5-32dbedb3124d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5841765610637669828c2bd71a01695e 2x, https://si.imgix.net/0316482a/uploads/origins/cb209d66-85d6-4298-8bf5-32dbedb3124d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7767b2373b8be3119d14b97f8723b5e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0316482a/uploads/origins/cb209d66-85d6-4298-8bf5-32dbedb3124d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e34e242689ab45b9a69aa24db3285d19", "srcset": "https://si.imgix.net/0316482a/uploads/origins/cb209d66-85d6-4298-8bf5-32dbedb3124d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e34e242689ab45b9a69aa24db3285d19, https://si.imgix.net/0316482a/uploads/origins/cb209d66-85d6-4298-8bf5-32dbedb3124d?bg=%23f