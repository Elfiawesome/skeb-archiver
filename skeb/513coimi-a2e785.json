参考にして頂くか、「こういうのもアリでは…？」と思えばそちらでも構いません。\n\n・可能であれば描いて頂いた際の没ラフや、創作時のコンセプト・こだわりポイント等を書いて頂けると嬉しいです！\n\n・納品はPSD形式でお願いします。\n\n・ご不明点等があった際はお好みで判断して描いて下さい。\n\n長文になりましたが、内容以上になります。\nお忙しい中恐縮ですが、お時間のある時に是非ご検討くださいませ。\n\nhttps://skeb.jp/search?q=%22%E3%83%87%E3%83%A5%E3%83%A9%E3%83%8F%E3%83%B3%22&t=works&menu=1&artwork=1", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@513coimi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2467113, "client_id": 1515375, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b82ed056/uploads/origins/7e769551-d3a1-4e7f-88e6-33f045515b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f38edf04e79bb787c7a99b924b13d27", "srcset": "https://si.imgix.net/b82ed056/uploads/origins/7e769551-d3a1-4e7f-88e6-33f045515b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f38edf04e79bb787c7a99b924b13d27, https://si.imgix.net/b82ed056/uploads/origins/7e769551-d3a1-4e7f-88e6-33f045515b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=510ae48c14771c6e9b62b8a67375a551 2x, https://si.imgix.net/b82ed056/uploads/origins/7e769551-d3a1-4e7f-88e6-33f045515b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bbe1f4255ffd6fe54b612bc9d089375a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b82ed056/uploads/origins/7e769551-d3a1-4e7f-88e6-33f045515b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2da86257983cc6f82212036a741f8df7", "srcset": "https://si.imgix.net/b82ed056/uploads/origins/7e769551-d3a1-4e7f-88e6-33f045515b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2da86257983cc6f82212036a741f8df7, https://si.imgix.net/b82ed056/uploads/origins/7e769551-d3a1-4e7f-88e6-33f045515b7a?bg=