なワンピースを描いても構いません！先生が描いたワンピースはとても可愛いです。\n特にご要望はございません、自由に創作できます。問題がなければ、まつげを白く描いてください。\n\n最終作品はPSDで提出をお願いしたいのですが、下書きとデザインのアイデアを追加できれば嬉しいです！\nなくても大丈夫です。 何か不合理な点があれば、お断りしていただいても結構です。ありがとう。\n\nhttps://drive.google.com/drive/folders/110bNoWsglG4Pu19e1eZCdBtR8spWrZoT", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 39523, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ゆゆず", "screen_name": "yuyuzu11", "avatar_url": "https://pbs.twimg.com/profile_images/1879269464824561664/wDYcJmPu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/943424228711284736/1740224123/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "banned": false, "nc": 129}, {"id": 497613, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "蒼ウサギ♂", "screen_name": "AoUSA0328", "avatar_url": "https://pbs.twimg.com/profile_images/1582803535041015808/NNPFujB-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/752154761407795200/1666204745/1500x500", "appeal_receivable": false, "popular_creator_rank": 13, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 1657231, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "minu∵u", "screen_name": "mi____u_u", "avatar_url": "https://pbs.twimg.com/profile_images/1404800071217160194/4CvKbb-I.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1208828792174600197/1680744044/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null,