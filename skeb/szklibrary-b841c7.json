ds/origins/e71781dd-566d-4703-a2b8-e9552c37ab8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=665d9e4ce224ccae8cb7329e8a76c231 2x, https://si.imgix.net/b9a9ff9a/uploads/origins/e71781dd-566d-4703-a2b8-e9552c37ab8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f55587beeed03505d2c0312a3d804d1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9a9ff9a/uploads/origins/e71781dd-566d-4703-a2b8-e9552c37ab8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=943d6283587c026ffb982dd6e8c25b4a", "srcset": "https://si.imgix.net/b9a9ff9a/uploads/origins/e71781dd-566d-4703-a2b8-e9552c37ab8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=943d6283587c026ffb982dd6e8c25b4a, https://si.imgix.net/b9a9ff9a/uploads/origins/e71781dd-566d-4703-a2b8-e9552c37ab8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f80dfd2818e5aacf6db9f84b1b098d7b 2x, https://si.imgix.net/b9a9ff9a/uploads/origins/e71781dd-566d-4703-a2b8-e9552c37ab8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=52f9b5661dab4164a4227c3209344775 3x"}, "body": "野ざらしさんこんばんは！しずきです！\nこの度CoCTRPG「幽世常世の満天下」のシナリオに使用した、弊探索者を描いてもらいたくリクエストいたします。\nなお、キャラクターの紹介についてネタバレのない範囲で提示しますが、シナリオについて一切の事前情報をみたくない！とのことでしたら、以降は読まずにこのリクエストは却下いただいて構いません。\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n▼シナリオ概要\nhttps://booth.pm/ja/items/3929155\n\n▼シナリオ紹介（ネタバレなし）\nhttps://chochintesso.fanbox.cc/posts/3999698\n\n普段の姿\nhttps://twitter.com/szklibrary/status/1537455816395354112?s=20&t=ieGbe5JGb9SgQA1dU5J57Q\n実際\nhttps://twitter.com/szklibrary/status/1558066131860340741?s=20&t=ieGbe5JGb9SgQA1dU5J57Q\n\n\n頭に入れている刺青は本名の「鞠（マリ）」です。普段は「燕（エン）」を名乗っておりウィッグを被っています。超守銭奴で水道代浮かせるためにスキンヘッドにしてたり子宮（もろもろの雑費が浮く）売ったり、他人の財布漁ったりと目的のためには若干手段を選ばない、倫理観はない方です。が、好き勝手動く仲間たちに振り回される一面もあり、まあ、普通の二十台後半女子みたいな子に落ち着きました。治安悪い無法地帯の地下都市で、武力で生き残る！（女なので腕っ節は強くないし）というよりはこそこそしたり逃げたり、交渉でどうにかしてきた強かな面があるのかなとはお思います。\n\n服装や髪型（ウィッグだし）は自由にアレンジいただけると嬉しいですが、もちろんこのままでも構いません。\n\nシナリオが中華な世界観だし、野ざらしさんのネオンな装飾が映えそう〜〜〜！！野ざらしさんのスタイリッシュな絵で燕が見てェ〜〜〜〜〜〜〜〜！！！！となりリクエストしました！\n\nどうぞよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 786180, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "wawa", "screen_name": "wawatiku", "avatar_url": "https://pbs.twimg.com/profile_images/1930047406810509316/scWjWE-1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1316976623724318720/1729758706/1500x500", "appeal_receivable": false, "popular_creator_rank": 20, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "nc": 49}, {"id": 828572, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ゆち🦄", "screen_name": "OREKASASASUKEDO", "avatar_url": "https://pbs.twimg.com/profile_images/1970904912440721412/Pwvd_ygS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1290454080599490562/1646709861/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 1}, {"id": 1242035, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "餠鳥", "screen_name": "motidori_46", "avatar_url": "https://pbs.twimg.com/profile_images/1457323991421833216/y4m7PipP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/716533064311025664/1706610844/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days