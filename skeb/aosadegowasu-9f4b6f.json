3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75cc8be6826565effb61a8b391836735, https://si.imgix.net/aef66efc/uploads/origins/a300c6c8-f37d-49fb-b1d0-6993e57fc686?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=232af1b08d92c93aa867dad02fb62eb2 2x, https://si.imgix.net/aef66efc/uploads/origins/a300c6c8-f37d-49fb-b1d0-6993e57fc686?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=696ffc53f444028ac796f9cab8a4777b 3x"}, "body": "はじめまして。\n可能でしたら以下内容でリクエストさせていただけないでしょうか。\n各要望事項については、作業しやすいよう変更アレンジ等はいただいて問題ありません。\nご検討のほど、お願いいたします。\n\n-----------------------------------------\n\n作品名：弱キャラ友崎くん\nキャラ名：菊池風香\n\n以前より風香に好意を寄せていた男子生徒から、放課後の人気の無い図書室で鍵を掛けられ犯されてしまうといったシチュエーション。\n服装は夏服、体位は以下画像にあるような内容で本棚に手をつき、大声を出されないよう、口元を手で押さえられて犯される構図を希望。\n\nhttps://imgur.com/a/k7MDmfu\n\nパンツずらし挿入、ブラウスは引きちぎられたうえでブラも外され、控えめな胸が露出している状態。\nまた、以下差分と可能ならセリフも希望します。（セリフは難しいようでしたら、入れていただかなくてもOKです。）\n\n①挿入前\n呻きながら、心の声で「いや、怖い」「助けて、友崎君！」といったセリフ希望。\n②挿入\n破瓜の血あり。大量の涙を流している状態。\n③中出し\n④事後\nレイプ目で放心状態。ペニスが引き抜かれ、破瓜の血と混ざりあった精液が秘部から零れ落ちている状態。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aosadegowasu/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 123545, "client_id": 1073535, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42cd9ac3/uploads/origins/f2f67ac9-f372-484b-a033-bf90dbe733a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7a72a775c495c10129651585d9b77a8", "srcset": "https://si.imgix.net/42cd9ac3/uploads/origins/f2f67ac9-f372-484b-a033-bf90dbe733a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7a72a775c495c10129651585d9b77a8, https://si.imgix.net/42cd9ac3/uploads/origins/f2f67ac9-f372-484b-a033-bf90dbe733a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9dbb03f4fb02bb607d2e13ba