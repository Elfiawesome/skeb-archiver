\nリクエスト内容ですが、\n\nキャラクター\n金髪でツーサイドアップの髪型\n可愛い女の子\n幼い感じのする女の子を希望します。\n\n服装ですが、\nメイドビキニを着せてもらないでしょうか。\nビキニは白色でなるべく布面積が少ないものを希望します。\n他にメイドブリム、ニーソックス（白）、\nけもみみカチューシャを描いていただきたいです。\n他の細かい部分はお任せ致します。\n\n構図はＰＣ壁紙として使用したいので横長の構図で、\n４Ｋ解像度以上を希望します。\n（４Ｋ以上あれば無理にあわせていただかなくて大丈夫です）\nまた、鼠径部が見えているものを希望します。\n\nＮＳＦＷをＯＮにしますので、差分で裸のものを描いていただけないでしょうか。\n（男性要素は無しでお願いします）\n宛名の有り無しをレイヤーで分けていただけないでしょうか。\n\n注文が多く大変だと思いますが、\nリクエスト受けていただけると非常に嬉しいです。\n金額やスケジュール等、ご検討のほどよろしくお願い致します。\n\nhttps://dic.pixiv.net/a/%E3%83%A1%E3%82%A4%E3%83%89%E3%83%93%E3%82%AD%E3%83%8B?utm_source=pixiv&utm_campaign=search_illust&utm_medium=referral", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@primil/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2744657, "client_id": 431362, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8d52e11/uploads/origins/c29c1aa3-ac1b-4bf8-86be-6ae5d6836d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f0378a6cf1959a0a52f4b3d29777600", "srcset": "https://si.imgix.net/f8d52e11/uploads/origins/c29c1aa3-ac1b-4bf8-86be-6ae5d6836d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f0378a6cf1959a0a52f4b3d29777600, https://si.imgix.net/f8d52e11/uploads/origins/c29c1aa3-ac1b-4bf8-86be-6ae5d6836d09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=505dca6734b08cd03b1206f2ec6eb26c 2x, https://si.imgix.net/f8d52e11/uploads/origins/c29c1aa3-ac1b-4bf8-86be-6ae5d6836d09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d153680ec9ae913f27e074b2971a0c96 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8d52e11/uploads/origins/c29c1aa3-ac1b-4bf8-86be-6ae5d6836d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bcf989acd85e263a7a16c6d526f33c5c", "srcset": 