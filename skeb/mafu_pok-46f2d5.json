.imgix.net/2f6d7e33/uploads/origins/9a9672bb-4a35-4f42-8b7f-162d9f296e7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d0377af272e63e85369a8c7cbf5e3da 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f6d7e33/uploads/origins/9a9672bb-4a35-4f42-8b7f-162d9f296e7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53c97a1c0be947a58b6e70d3d2170a94", "srcset": "https://si.imgix.net/2f6d7e33/uploads/origins/9a9672bb-4a35-4f42-8b7f-162d9f296e7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53c97a1c0be947a58b6e70d3d2170a94, https://si.imgix.net/2f6d7e33/uploads/origins/9a9672bb-4a35-4f42-8b7f-162d9f296e7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a0b73f0617a04ba03d8d3346e636f0f6 2x, https://si.imgix.net/2f6d7e33/uploads/origins/9a9672bb-4a35-4f42-8b7f-162d9f296e7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7b907aecdb2ef7eb233870168451bd40 3x"}, "body": "初めまして、冬狼/Anfauglirと申します。\nツイッターで素敵なイラストを拝見しました⋯⋯！\n\n今回依頼していただきたい内容は：\n- うちの仔のイラストを描いていただきたいです。\n彼は吹雪と暴風を自由自在に操れる、\nクリスタルから封じられた思いを読み取れる、そしてそれを味わって、糧にする；\nふだんは地上にクリスタルの群生が生えている雪山の山頂で棲まって、\n一匹狼で探究心が強い、寒い所が大好きなドラゴンです。\n- 内容と構図などはおまかせです。\n- サインがあれば、別レイヤでお願いしたいです。\n\nよろしくおねがいします！\n\nhttps://skeb.jp/@Haku17/works/32", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mafu_pok/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2864717, "client_id": 584710, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7bc39224/uploads/origins/cc5322a7-96d0-48b9-a284-56449a4b9be6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54849fa3cbbdef87dfe62c2ff740dfcc", "srcset": "https://si.imgix.net/7bc39224/uploads/origins/cc5322a7-96d