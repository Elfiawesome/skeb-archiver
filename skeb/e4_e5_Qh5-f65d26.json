e7-8f0f-6dbf2459b4de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01db5d9d55045e7db267471bfc9ee51e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/79e67958/uploads/origins/80382255-c484-41e7-8f0f-6dbf2459b4de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04314c57cc021ee8658b5d9487cb2186", "srcset": "https://si.imgix.net/79e67958/uploads/origins/80382255-c484-41e7-8f0f-6dbf2459b4de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04314c57cc021ee8658b5d9487cb2186, https://si.imgix.net/79e67958/uploads/origins/80382255-c484-41e7-8f0f-6dbf2459b4de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f6795624974fd612058d567e8a2ff323 2x, https://si.imgix.net/79e67958/uploads/origins/80382255-c484-41e7-8f0f-6dbf2459b4de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93262e292610eb56bd6be6f4634786bb 3x"}, "body": "こんにちは、もしあなたが少々のNTRでも構わないのであれば、フタナリ・アマゾンに征服された約1年後の人間の村を舞台に、村人の一人の視点から描いた作品をお願いしたいです。ある日、視聴者がどこかに出かけようとすると、アマゾンが彼を呼び止めます。彼女は金髪の美女をさりげなくオナホールのように使いながら、鑑賞者と話している。\n\n風太：あなたはこの女性の人生のパートナーですよね？\n視聴者：*おとなしく*はい、奥様...\n風太：彼女は最近、私の強大な娘を産んだのですが、その後まであなたの存在に気づかなかったので、証人になるためにあなたを探しませんでした。失礼しました。\n視聴者.....\n風太：次の子の妊娠を目撃してもらうことで、償いたいと思います。\n\nそして、奥さんのお腹を膨らませながら、クンニをする。\n\n妻： *意味不明なうめき声*。\n風太：うーん...今度は必ずあなたを出産に招待するわ。\n視聴者：ありがとうございます：ありがとうございます。奥さん...。\n\n[風太］：身長6～8メートルくらい、日焼けした肌、筋肉質、部族の服を着ている。\n[妻】：］巨乳、ヌード\n\nありがとう。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@e4_e5_Qh5/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1923276, "client_id": 2559010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ef9a558/uploads/origins/b2e55f21-6785-4605-bac0-9710d789b66e?bg=%23fff&auto=format%2Ccompress&