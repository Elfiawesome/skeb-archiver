がほしい。「巨人の店来たら人間の彼氏じゃ満足できなくなるよ」のような気遣いながらからかう感じのセリフを入れてほしい。\n\nご検討いただけると幸いです。\nよろしくお願いいたします！", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@e4_e5_Qh5/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1923276, "client_id": 2559010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f5fb405/uploads/origins/6790fe27-3636-4e27-9a3d-c6b9eddbb4aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=531a22186c1699832a2258ae6eb31d24", "srcset": "https://si.imgix.net/2f5fb405/uploads/origins/6790fe27-3636-4e27-9a3d-c6b9eddbb4aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=531a22186c1699832a2258ae6eb31d24, https://si.imgix.net/2f5fb405/uploads/origins/6790fe27-3636-4e27-9a3d-c6b9eddbb4aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48d97a9c5dafb8077e8c4938f7de288f 2x, https://si.imgix.net/2f5fb405/uploads/origins/6790fe27-3636-4e27-9a3d-c6b9eddbb4aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75e29e090f5d8a748643ebae422c1f25 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f5fb405/uploads/origins/6790fe27-3636-4e27-9a3d-c6b9eddbb4aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45f7ab9339a373c39201be637004ff5e", "srcset": "https://si.imgix.net/2f5fb405/uploads/origins/6790fe27-3636-4e27-9a3d-c6b9eddbb4aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45f7ab9339a373c39201be637004ff5e, https://si.imgix.net/2f5fb405/uploads/origins/6790fe27-3636-4e27-9a3d-c6b9eddbb4aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e1eea0f5c5dc5c85981b93bb29c94840 2x, https://si.imgix.net/2f5fb405/uploads/origins/6790fe27-3636-4e27-9a3d-c6b9eddbb4aa?bg=%23fff&auto=f