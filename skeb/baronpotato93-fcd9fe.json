origins/e0ad0b0c-7382-439c-918a-1aa49b0c73af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d0eb15340acdcc8628ac8d1bb0faa7a 3x"}, "body": "男爵いも先生\n初めまして、ヒムラーのプロファイルイラストをお願いしたいです。\n\nリンクの写真のヒムラーを、「初めての第三帝国」のスタイルにお願いします！背景なし、上半身のみでも大丈夫です。\n\n失礼な表現があるかもしれないため、あらかじめに謝ります。\nどうしても先生のお作品をプロファイル写真にしたいので、何卒よろしくお願いします🙇‍♂️！\n\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSoQtHb3tPmwRqdFoVBrHLNb2JlpQBLCuhn5A&usqp=CAU", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@baronpotato93/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1292203, "client_id": 1530573, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4cfdc982/uploads/origins/62f0f276-9c24-4150-846e-b5f46fdeb483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbf9c7595303ff94ce91ec5196ac4be0", "srcset": "https://si.imgix.net/4cfdc982/uploads/origins/62f0f276-9c24-4150-846e-b5f46fdeb483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbf9c7595303ff94ce91ec5196ac4be0, https://si.imgix.net/4cfdc982/uploads/origins/62f0f276-9c24-4150-846e-b5f46fdeb483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8cd59c89141d0255281bd5a56df8169 2x, https://si.imgix.net/4cfdc982/uploads/origins/62f0f276-9c24-4150-846e-b5f46fdeb483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1be835e4e30efd6fed6163fedef42b85 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4cfdc982/uploads/origins/62f0f276-9c24-4150-846e-b5f46fdeb483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b280138e39b7bcdbb4cd2de2a659a3b2", "srcset": "https://si.imgix.net/4cfdc982/uploads/origins/62f0f276-9c24-4150-846e-b5f46fdeb483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b280138e39b7bcdbb4cd2de2a659a3b2, https://si.imgix.net/4cfdc982/uploads/origins/62f0f276-9c24-4150-846e-b5f46fdeb483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3e9134cfbe8d3fabb5287edb04c1ba1c 2x, https://si.imgix.net/4cfdc982/uploads/origins/62f0f276-9c24-4150-846e-b5f46fdeb483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c7c30c0939c5307e1a3e6bc0ae3931a0 3x"}, "body": "いつも（本当に）お世話になっております。\n大好きないも男さんの絵柄で推しが見たいpart2ということで、今回はナチ党の思想・理論指導者アルフレート・ローゼンベルクをリクエストさせていただきます！（ショタではなく、大人のベルクをお願いします！）\n\n構図はお任せしますが、文官っぽく、本とかペンとか文系っぽいアイテムがあったりすると哲学者・思想家感が出るかもです…！それか演説している風でも、ナチズムを啓蒙しようとしていたベルクちゃんらしいかなと思います！\n参考→https://www.alamy.com/stock-photo-alfred-rosenberg-during-a-speech-at-croessinsee-near-falkenburg-1936-48402594.html?pv=1&stamp=2&imageid=5A241763-2766-47CD-98A5-A5E36441A47D&p=291611&n=0&orientation=0&pn=1&searchtype=0&IsFromSearch=1&srch=foo%3dbar%26st%3d0%26pn%3d1%26ps%3d100%26sortby%3d3%26resultview%3dsortbyRelevant%26npgs%3d0%26qt%3dalfred%2520rosenberg%26qt_raw%3dalfred%2520rosenberg%26lic%3d3%26mr%3d0%26pr%3d0%26ot%3d0%26creative%3d%26ag%3d0%26hc%3d0%26pc%3d%26blackwhite%3d%26cutout%3d%26tbar%3d1%26et%3d0x000000000000000000000%26vp%3d0%26loc%3d0%26imgt%3d0%26dtfr%3d%26dtto%3d%26size%3d0xFF%26archive%3d1%26groupid%3d%26pseudoid%3d%26a%3d%26cdid%3d%26cdsrt%3d%26name%3d%26qn%3d%26apalib%3d%26apalic%3d%26lightbox%3d%26gname%3d%26gtype%3d%26xstx%3d0%26simid%3d%26saveQry%3d%26editorial%3d1%26nu%3d%26t%3d%26edoptin%3d%26customgeoip%3d%26cap%3d1%26cbstore%3d1%26vd%3d0%26lb%3d%26fi%3d2%26edrf%3d0%26ispremium%3d1%26flip%3d0%26pl%3d\n\nあとスーツではなく党の制服（外出用の勤務服）を着ていると嬉しいです…！\n参考→https://ja.wikipedia.org/wiki/%E5%88%B6%E6%9C%8D_(%E3%83%8A%E3%83%81%E5%85%9A)#%E5%8B%A4%E5%8B%99%E6%9C%8D\n\nお忙しいところ恐縮ですが、ぜひともよろしくお願いしますー！\n\nhttps://www.alamy.com/search/imageresults.aspx?imgt=0&qt=alfred+rosenberg", "nc": 128, "word_count": 0, "transcoder": "image", "creator_accep