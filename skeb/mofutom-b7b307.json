auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a5192569017bec7ced65f83a8f00d8f7 3x"}, "body": "こんにちは。\nあなたの作品が大好きです!あなたのヒューマノイドとドラゴンのデザインはどちらも素晴らしいです :)\n私のキャラクターであるSybillineのデザインをお願いしたいと思います。具体的には、彼女はエルフを装ったドラゴネスなので、半人間半ドラゴンのデザインをお願いします。\nhttps://imgur.com/a/clU1fUR こんな感じです。\nほとんどが人間で、手足、角、尻尾は鱗と羽で覆われています。鱗や羽の色は白で、爪は金色にしたいと思います。\n彼女の角と羽は次のようなものです： https://imgur.com/a/PI6RUlT デザインは自由に創造してください。写真はあくまでも参考にしてください。\nキャラクターリファレンス: https://imgur.com/a/aMHHFN6 顔の明るい部分はそのままにしてください。\n\nご検討いただきありがとうございます。:)\n\nhttps://imgur.com/a/aMHHFN6", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mofutom/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 43337, "client_id": 71536, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e45d4637/uploads/origins/c2499a00-f3ea-4972-8d6f-6ab77e422f69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f53b64b1073f2b919475c6c9f1594d1f", "srcset": "https://si.imgix.net/e45d4637/uploads/origins/c2499a00-f3ea-4972-8d6f-6ab77e422f69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f53b64b1073f2b919475c6c9f1594d1f, https://si.imgix.net/e45d4637/uploads/origins/c2499a00-f3ea-4972-8d6f-6ab77e422f69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9798e89cfed25d51a28b9f290415cbf 2x, https://si.imgix.net/e45d4637/uploads/origins/c2499a00-f3ea-4972-8d6f-6ab77e422f69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e41e0582a8013cd985119c7cb1b094b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e45d4637/uploads/origins/c2499a00-f3ea-4972-8d6f-6ab77e422f69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=921b0ff1725b94f3fee201637e25fe05", "srcset": "https://si.imgix.net/e45d4637/uploads/origins/c2499a00-f3ea-4972-8d6f-6ab77e422f69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=921b0ff1725b94f3fee201637e25fe05, https://si.imgix.net/e45d4637/uploads/origins/c2499a00-f3ea-4972-8d6f-6ab77e422f69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=10ab8a73354ec869dd03de274fbf603d 2x, https://si.imgix.net/e45d4637/uploads/origins/c2499a00-f3ea-4972-8d6f-6ab77e422f69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=37666d8daf1c6e24e642be9f6e342f1c 3x"}, "body": "こんにちは、Motom。\n\nお騒がせしました。私の方では、なぜかChromeが意図した通りに動作していません。今年もよろしくお願いします^^。\n\n私のドラゴンが空から飛び降り、カタパルトから発射された巨大な矢を間一髪でかわしている様子を描いていただけますか？ドラゴンはとても怒っていて、敵を焼き尽くすために火を吹こうとしています^^。\n\n私のドラゴンへの参照: https://drive.google.com/file/d/17Kb_UWf7yoxYL1TlhOBie9RDBgYlqxGV/view?usp=sharing\n\n矢とカタパルト このような意味です： http://www.hellenicaworld.com/Greece/ImagesML/war/Catapults-Dateien/image001.jpg", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mofutom/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 43337, "client_id": 33234, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/587604bb/uploads/origins/eaf13105-83c8-45d2-8edd-612237ad1f94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0af1dd3390d89ee88e5e3c25fd9f9cb9", "srcset": "https://si.imgix.net/587604bb/uploads/origins/eaf13105-83c8-45d2-8edd-612237ad1f94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0af1dd3390d89ee88e5e3c25fd9f9cb9, https://si.imgix.net/587604bb/uploads/origins/eaf13105-83c8-45d2-8edd-612237ad1f94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=025846c004fccbfdd2a51aca2bedc1be 2x, https://si.imgix.net/587604bb/uploads/origins/eaf13105-83c8-45d2-8edd-612237ad1f94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c8670a0425995a594627c75ee7d79b6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/587604bb/uploads/origins/eaf13105-83c8-45d2-8edd-612237ad1f94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b3597eaac4928610f72c35608bbc9e9", "srcset": "https://si.imgix.net/587604bb/uploads/origins/eaf13105-83c8-45d2-8edd-612237ad1f94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b3597eaac4928610f72c35608bbc9e9, https://si.imgix.net/587604bb/uploads/origins/eaf13105-83c8-45d2-8edd-612237ad1f94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=afd5abe9d2cd69041678a60ff80e8e37 2x, https://si.imgix.net/587604bb/uploads/origins/eaf13105-83c8-45d2-8edd-612237ad1f94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=58c5e9d343c4a63be06c10378a6349de 3x"}, "body": "こんにちは、私はあなたのイラストが大好きです。私と私の友人のFFXIVのキャラクターをリクエストしたいのですが、よろしいでしょうか？彼らは結婚していて、お互いに尽くしています。リンク先には、彼らの参考資料をすべて掲載しています。\n\nYudricは礼儀正しく、本好きなElfです。礼儀正しく、誰に対しても厳しい態度をとることがありますが、配偶者には優しい優しさを見せます。身長は208cmです。\n\nTimotheos \"Tim\" は、声が大きく、興奮しやすく、外向的な性格です。彼の行動は予測不可能だが、ユードリックはTimの個性を愛すようになった。身長は212cm。\n\n牧場での2人の様子を描いていただければと思います。農作業をしていたり、動物の世話をしていたりします。二人とも楽しそうに笑っています。また、一緒に食事をしている様子を描いてもいいでしょう。明るく楽しい雰囲気です。\n\nご検討いただきありがとうございました。\n\nhttps://drive.google.com/drive/u/0/folders/1vqUcclYyjS24ldsVxeOgpkLE4kcHmEp7", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mofutom/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 43337, "client_id": 1032191, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8aab1570/uploads/origins/e4a022a9-80c6-46b6-b280-a02a63de91b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=621114a237d816c60a788094bac10a78", "srcset": "h