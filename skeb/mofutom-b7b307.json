_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb2b33e0/uploads/origins/3c445c5a-f671-4269-b72f-01e334527549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cce38b5e77f4e15b88538584133cc70", "srcset": "https://si.imgix.net/cb2b33e0/uploads/origins/3c445c5a-f671-4269-b72f-01e334527549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cce38b5e77f4e15b88538584133cc70, https://si.imgix.net/cb2b33e0/uploads/origins/3c445c5a-f671-4269-b72f-01e334527549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b2429e1bf8858d89511195f72b0068c 2x, https://si.imgix.net/cb2b33e0/uploads/origins/3c445c5a-f671-4269-b72f-01e334527549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f13005e20dcc575c6633889a03ccc0e5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb2b33e0/uploads/origins/3c445c5a-f671-4269-b72f-01e334527549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e3b80838096dda31b9cac99957e5854", "srcset": "https://si.imgix.net/cb2b33e0/uploads/origins/3c445c5a-f671-4269-b72f-01e334527549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e3b80838096dda31b9cac99957e5854, https://si.imgix.net/cb2b33e0/uploads/origins/3c445c5a-f671-4269-b72f-01e334527549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b9b8bddb35ebcfed1848c8277f8e2090 2x, https://si.imgix.net/cb2b33e0/uploads/origins/3c445c5a-f671-4269-b72f-01e334527549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a7c50b111654e0e1089157b7e7fab2e7 3x"}, "body": "初めまして！\npixivやTwitterで描かれているキャラクターのデザイン、表情や雰囲気に惹かれました。\n絵のシチュエーションや質感も素敵です。\n今回、自分の趣味な絵を描いていただければと思い依頼致します。\n甲冑を纏った狼獣人の騎士、敵を討ち倒し兜を脱いで一息つき、勝利の実感を噛み締める。\nこのシチュエーションをmotom様の絵柄で描いていただけないでしょうか？\n絵の雰囲気は前に描かれていたforest werewolf、キャラクターの雰囲気、顔立ちは狼騎士に寄せてもらえばと思います。\nhttps://www.pixiv.net/artworks/93561044\nhttps://www.pixiv.net/artworks/71371754\nコスチュームはお任せします、サーコート等で鎧を隠してしまっても結構です。\n構図やポーズはヘタですがイメージを描きましたので参考にしていただけると嬉しいです。\nもし難しかったりより良いイメージを思いついたならそちらを優先して自由に描いてくださって結構です。\n背景もお任せします、無くても構いません。\nもし描いて頂けるなら雰囲気を盛り上げる感じにしていただけると素敵です。\n最後に、もし可能であれば狼騎士の顔をよく見てみたいので鎖帷子頭巾の有無差分をいただけると嬉しいです。\nそれではよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1xCl2UXPZ9KJVU--cZ26opy2O1xkG_Jd2", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 881, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "みるお", "screen_name": "milleoxox", "avatar_url": "https://pbs.twimg.com/profile_images/1225312996622159872/2us1U7__.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2775804750/1607276190/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 17}, {"id": 5500, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "by4co🐾土曜東2ソ07a", "screen_name": "_by4co", "avatar_url": "https://pbs.twimg.com/profile_images/2053857358481362944/dUm5xSXc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1014439178317193216/1772116258/1500x500", "appeal_receivable": false, "popular_creator_rank": 65, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 534452, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ITARU@新刊通販開始しました", "screen_name": "kidomh63", "avatar_url": "https://pbs.twimg.com/profile_images/1917088373124304897/XUltXpeV.jpg", "header_url": "h