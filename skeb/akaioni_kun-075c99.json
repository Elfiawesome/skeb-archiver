e/uploads/origins/97de2b66-14bc-4342-8005-77c06fff5211?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c71ef0c48c7bab49fb76395b4aca40f2 3x"}, "body": "サイバーパンクの武器を持ったクールな座りポーズのキャラクターが欲しい。クールでカジュアルな感じで、カメラ目線で。\n\nそのために、ジャケットを着た私のキャラクターを描いてください！(画像1)\n右胸のポケットには私のマスコットが入っています。参考資料もお送りします。\n\n- https://imgur.com/a/zIgv113", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akaioni_kun/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 594115, "client_id": 1773745, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/988b6f96/uploads/origins/f52efec7-d7b4-48e3-8abd-6d4cf73abc30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ffc577b5923f4703e7ba1850604c9ef", "srcset": "https://si.imgix.net/988b6f96/uploads/origins/f52efec7-d7b4-48e3-8abd-6d4cf73abc30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ffc577b5923f4703e7ba1850604c9ef, https://si.imgix.net/988b6f96/uploads/origins/f52efec7-d7b4-48e3-8abd-6d4cf73abc30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a272ddbbb9a8d417532d862927a7cc5c 2x, https://si.imgix.net/988b6f96/uploads/origins/f52efec7-d7b4-48e3-8abd-6d4cf73abc30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f47223ebe01262c11ec5fe14a91cc22 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/988b6f96/uploads/origins/f52efec7-d7b4-48e3-8abd-6d4cf73abc30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da6f2d32d4b942f84e69e7cbb23f65c9", "srcset": "https://si.imgix.net/988b6f96/uploads/origins/f52efec7-d7b4-48e3-8abd-6d4cf73abc30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da6f2d32d4b942f84e69e7cbb23f65c9, https://si.imgix.net/988b6f96/uploads/origins/f52efec7-d7b4-48e3-8abd-6d4cf73abc30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=77b437426beb33aec2b4dfb9826fcedb 2x, https://si.imgix.net/988b6f96/uploads/origins/f52efec7-d7b4-48e3-8abd-6d4cf73abc30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6b9a5e8d02da15b3cd9ada9eb1e4f8e4 3x"}, "body": "初めまして！新着でお見かけした絵を見て一目惚れしてしまい、\n是非創作キャラを描いていただきたくリクエストを送らせていただきました！\n\n◆キャラ設定\n佐助　185cm　20代　テーマカラー：黒・オレンジ \n殺し屋で力が強く大柄。大型のナイフを使う。 \nいつも機嫌良さそうにしている。ギャンブルが好きで勝率は五分五分。\n\nシチュエーションや構図はお任せします。現代っぽい世界観にいるキャラクターです。\nそしてできればなのですがあかいおにさんの服のセンスが凄く好きなので\n好きに服を着せていただければと思います…！\n\n難しかったり時間がない場合は遠慮なくキャンセルしていただいて大丈夫ですので\n何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1bPovXNV1oGkiV9Kk2a4hdn_GwpSMi0gi?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akaioni_kun/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 594115, "client_id": 29106, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a325d53/uploads/origins/a4c0e879-7bef-40a9-a629-397d125a7942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a32503616fd1ed6713020c13dba501f", "srcset": "https://si.imgix.net/1a325d53/uploads/origins/a4c0e879-7bef-40a9-a629-397d125a7942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a32503616fd1ed6713020c13dba501f, https://si.imgix.net/1a325d53/uploads/origins/a4c0e879-7bef-40a9-a629-397d125a7942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fab04d32fdbe3712d5287dd69a408dab 2x, https://si.imgix.net/1a325d53/uploads/origins/a4c0e879-7bef-40a9-a629-397d125a7942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa86321e396a029d53a4f58852de1ca4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https