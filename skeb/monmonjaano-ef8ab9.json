細が必要な場合は参考URLをご確認ください。ただ、ルリは私が最近作ったオリジナルキャラクターなので、参考シートがないことをあらかじめお詫びしておきます ^-^\"\n\nポーズはお好きなもので構いませんが、ルリがルミに対してより姉妹らしい態度をとっているように描いていただけると嬉しいです！\n\n本当にありがとうございます！！\n\nhttps://drive.google.com/drive/folders/12J0jJ662H_1Zvh9Oakuf2qdca8437LOQ?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@monmonjaano/works/71", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3445335, "client_id": 16265, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/565608e8/uploads/origins/998b5ae1-653b-4089-a6bb-c9d4682e9cf4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=107885b2107ad1cdcdfe226a57ce4bc7", "srcset": "https://si.imgix.net/565608e8/uploads/origins/998b5ae1-653b-4089-a6bb-c9d4682e9cf4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=107885b2107ad1cdcdfe226a57ce4bc7, https://si.imgix.net/565608e8/uploads/origins/998b5ae1-653b-4089-a6bb-c9d4682e9cf4?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=faacf2d23793758500ebef1f92a9fc2d 2x, https://si.imgix.net/565608e8/uploads/origins/998b5ae1-653b-4089-a6bb-c9d4682e9cf4?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7309bad2f207a53afb96378a3895f93 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/565608e8/uploads/origins/998b5ae1-653b-4089-a6bb-c9d4682e9cf4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=b032c170b9da3cb3174b13d45b55b816", "srcset": "https://si.imgix.net/565608e8/uploads/origins/998b5ae1-653b-4089-a6bb-c9d4682e9cf4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=b032c170b9da3cb3174b13d45b55b816, https://si.imgix.net/565608e8/uploads/origins/998b5ae1-653b-4089-a6bb-c9d4682e9cf4?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=36f68b10288f2285e3f1179ade39b245 2