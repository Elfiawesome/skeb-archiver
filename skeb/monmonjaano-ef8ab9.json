にちは！！Twitterであなたの作品を見て、どうしても自分のVTuberをあなたのスタイルで描いてもらいたくなりました！！\n私のVTuberはカワウソのアイドルです！\n\n参考画像にある私の衣装ならどれでも選んで、自由にイラストを描いてください！\n\nキャラクターの特徴：\n水族館に住む、陽気なアイドル。可愛いものが大好きで、愛とポジティブなエネルギーを広めるのが使命です！\n♡ 陽気\n♡ 遊び心があり、誇り高い （時々得意げ）\n♡ 親しみやすい\n\nデザインメモ：\n♡ 長くカールした髪\n♡ 肌の色が薄い部分は「白斑」という症状を表しています\n♡ 頬に2つのそばかす\n♡ 身長：150cm\n♡ ハート型の瞳\n♡ 2本の牙\n\n衣装メモ：\n♡ 袖口にハート柄\n♡ リボンに貝殻\n♡ ピンクグラデーションの青いネイル\nご検討いただきありがとうございます。作品を楽しみにしています！\n\nhttps://drive.google.com/drive/u/0/folders/1T6EeeKZuhv-NHsaPjdIiEx0-YCNdaLs7\nhttps://toyhou.se/31999677.himi-vsona/gallery", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@monmonjaano/works/74", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3445335, "client_id": 3279596, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4737860/uploads/origins/cd762133-8be5-4edf-8362-7c90836b8c02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6fdd4ada0ae57838370ec84de1277a6", "srcset": "https://si.imgix.net/e4737860/uploads/origins/cd762133-8be5-4edf-8362-7c90836b8c02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6fdd4ada0ae57838370ec84de1277a6, https://si.imgix.net/e4737860/uploads/origins/cd762133-8be5-4edf-8362-7c90836b8c02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5cc843650f640b3d8c6914a4529af28b 2x, https://si.imgix.net/e4737860/uploads/origins/cd762133-8be5-4edf-8362-7c90836b8c02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d561b565b1285d6ac48684adffff3116 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4737860/uploads/origins/cd762133-8be5-4edf-8362-7c90836b8c02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95783d78f860c5c6237486cdaf849258", "srcset": "https://si.imgix.net/e4737860/uploads/origins/cd762133