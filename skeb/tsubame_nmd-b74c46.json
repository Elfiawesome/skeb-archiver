トを描いて頂いた甘目もな様から\n①他のイラストレーターさんに依頼しても問題ない。\n②イラストの内容はなんでも問題ない。\n③上半身しかデザインしてないないため参考が全くないので、他のイラストレーターさんにお願いするときは自由にして構わない。\nと確認を済ませております。\n\n\n鈴蘭のキャラクター(身長およそ110～120cm)\nスズランをイメージしたキャラクターで、頭にスズランのツボミのような丸い物がくっついています\n↓\nhttps://twitter.com/amamona_P/status/1365987931110825988", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tsubame_nmd/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 278983, "client_id": 304560, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63516595/uploads/origins/15b1a76d-538f-43e7-b1b2-d98dee42422c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35ce7ff89d79a4e049d7592059625267", "srcset": "https://si.imgix.net/63516595/uploads/origins/15b1a76d-538f-43e7-b1b2-d98dee42422c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35ce7ff89d79a4e049d7592059625267, https://si.imgix.net/63516595/uploads/origins/15b1a76d-538f-43e7-b1b2-d98dee42422c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f306cb159eebc2690f24b9b16034851d 2x, https://si.imgix.net/63516595/uploads/origins/15b1a76d-538f-43e7-b1b2-d98dee42422c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dfc0a8d48f77331e73e9140fa968e541 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63516595/uploads/origins/15b1a76d-538f-43e7-b1b2-d98dee42422c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fea517abad9b62871ea8f23eec530fa", "srcset": "https://si.imgix.net/63516595/uploads/origins/15b1a76d-538f-43e7-b1b2-d98dee42422c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fea517abad9b62871ea8f23eec530fa, https://si.imgix.net/63516595/uploads/origins/15b1a76d-538f-43e7-b1b2-d98dee42422c?bg=%23fff&auto=format%2Ccompress&fm=