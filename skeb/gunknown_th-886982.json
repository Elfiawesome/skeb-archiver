crop=top&w=200&h=200&s=f4413a5e3dd7b84b419c7538f32175c2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d47ee5c/uploads/origins/549a4632-9b9a-49f5-9521-0ddd85657fd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b6a2ce8d117fcb82c6772c3b9377e27", "srcset": "https://si.imgix.net/4d47ee5c/uploads/origins/549a4632-9b9a-49f5-9521-0ddd85657fd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b6a2ce8d117fcb82c6772c3b9377e27, https://si.imgix.net/4d47ee5c/uploads/origins/549a4632-9b9a-49f5-9521-0ddd85657fd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d52baab17ecaaf3f136bc960a59fd25f 2x, https://si.imgix.net/4d47ee5c/uploads/origins/549a4632-9b9a-49f5-9521-0ddd85657fd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64a189ed2ef093c05d4f22a2d0bf8459 3x"}, "body": "いつも助かっています。\n鏡面卿です。\n\n来年3/1に斗和キセキさんが5周年を迎えますので、お祝いイラストをお願いします。\n\nイメージとしては、地球をマイクに見立てて歌うアイドルという感じで。\n衣装はピンクピンクしてる衣装で、胸のあたりにブラックホールのようなマークがデカデカとついてる（土星のような形が理想）可愛さもあり、かっこよさ、宇宙を感じると嬉しいです。\n\n三角ちゃんはバックにいる感じでお願いします。\n\n何卒宜しくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gunknown_th/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 827250, "client_id": 301857, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0aca2f87/uploads/origins/152eccea-192a-4f5a-9ab2-e29f8531a78f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f3c01cfcacd5fc55eb2cbba9917a51b", "srcset": "https://si.imgix.net/0aca2f87/uploads/origins/152eccea-192a-4f5a-9ab2-e29f8531a78f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f3c01cfcacd5fc55eb2cbba9917a51b, https://si.imgix.net/0aca2f87/uploads/origins/152eccea-192a-4f5a-9ab2-e29f8531a78f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=243c11c568a486e65d5c992abe93764f 2x, https://si.imgix.net/0aca2f87/uploads/origins/152eccea-192a-4f5a-9ab2-e29f8531a78f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91fde97a99208542fb80ea562d0c4048 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0aca2f87/uploads/origins/152eccea-192a-4f5a-9ab2-e29f8531a78f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0841ffd5c0975fb4a2584fd12f3a14f4", "srcset": "https://si.imgix.net/0aca2f87/uploads/origins/152eccea-192a-4f5a-9ab2-e29f8531a78f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0841ffd5c0975fb4a2584fd12f3a14f4, https://si.imgix.net/0aca2f87/uploads/origins/152eccea-192a-4f5a-9ab2-e29f8531a78f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=447603f882c82a01157b68c811a5c791 2x, https://si.imgix.net/0aca2f87/uploads/origins/152eccea-192a-4f5a-9ab2-e29f8531a78f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4cc6cf6bf93b403fce2b284098b24dae 3x"}, "body": "私の女体化ビキニを描いて下さい。\nブラック メドゥーサ ワンピース スイムウェアという衣装が好きです。おヘソの下辺りに夢見鳥の装飾があると嬉しいです。\n顔はヘッダーのNちゃんっぽく。髪は短めで、目を閉じた状態です。\n首から下は水中用に換装したという設定で指輪にあるような緩いねじれをつけたボディで。\nまた、胸部の中心に空洞があり、向こうの景色が見える感じでお願いします。\nそして、鏡面の用に日が当たると虹色に反射する感じで所々に金属感を出しで頂けるとありがたいです。\n今回触手君は二対にして、背中と腰の間に装着、先端に六角形の吸盤を付けて下さい。\n頭に帽子を被せ、飾りにブローチと仮面を付けて下さい。\n表情とポーズはお任せします。\nあとは好きに描いて下さい。宜しくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gunknown_th/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 827250, "client_id": 301857, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0db8851/uploads/origins/4d8f90b9-66ec-417a-9473-ddadb93f92f9?bg=%23fff&a