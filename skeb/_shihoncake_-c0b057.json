ったたためシスター衣装を希望しております。　　\n　　　先生の普段書かれている衣装がどれも素敵なので添付資料から想像いただいたデザインですと嬉しいです。\n　　　その他の希望はございませんが描画範囲に入るのであればレオタード分であったり深めにスリッドが入っているようなデザインですと嬉しいです。\n　　　髪型は通常とツインテールどちらをベースにしていただいても構いません。\n　　　服の希望色も特にございません。\n\nその他：サムネイルなどで使用するため、背景がある場合は背景透過のイラストをいただけますと嬉しいです。\n\nご参考にまでにプロフィールもお送りいたします。\n\n▶︎好きなもの　宇宙　海\n\n▶︎イメージカラー　ピンク　金\n\n▶︎その他のイメージ　グラジオラス　ファンタジー×ネットゲームの世界　宇宙　ドジ　エレガント　笑顔　楽しい　仲良し\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-8TWquhWNt_ZIdPy3EZ7Gr5twKQLwWu0?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_shihoncake_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4029915, "client_id": 79155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71d890b7/uploads/origins/298b4b37-4225-41fd-92eb-819335adc119?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97b2ad938a197fa731ef51fd06b46d70", "srcset": "https://si.imgix.net/71d890b7/uploads/origins/298b4b37-4225-41fd-92eb-819335adc119?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97b2ad938a197fa731ef51fd06b46d70, https://si.imgix.net/71d890b7/uploads/origins/298b4b37-4225-41fd-92eb-819335adc119?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d32a14ad6432710fa2f3a1b47fabe181 2x, https://si.imgix.net/71d890b7/uploads/origins/298b4b37-4225-41fd-92eb-819335adc119?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1646d0ac5e9356130a3460a20819590 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71d890b7/uploads/origins/298b4b37-4225-41fd-92eb-819335adc119?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c08c5aa67d6a4a687b748933ba009c4f", "srcset": "https://si.imgix.net/71d890b7/uploads/origins/298b4b37-4225-41fd-92eb-819335adc119?bg=%23fff&auto=forma