to=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3981056aa9e4f5803a96c49922f5f309 3x"}, "body": "禄條ろき先生、初めまして。\n\n桑山千雪のエッチな絵をリクエストしても宜しいでしょうか？\n\n希望する絵は・・・\n\n体の相性が良すぎてお互いセックス中毒になってしまった千雪とPさんが素っ裸でベッドの上、またはソファーの上で汗をかきながら対面座位エッチしちゃう絵です。\n\nPさんは千雪の片方の胸を彼女自身の口元まで手で押し上げ、千雪は自分の胸に唾液を垂らしながら自分で自分の乳首を吸い、千雪のもう片方の胸はPさんが唾液を垂らしながら吸い、Pさんは余った手を千雪の背中に回し、千雪がアソコを濡らしながら二人で激しくエッチしちゃうシチュエーションでお願いします。両者がおっぱいを吸っているとき、千雪の乳輪が見えていると嬉しいです。周りには使用済みのコンドームが散乱している感じだと尚更嬉しいです。擬音に加え、適当な台詞も入れて頂けると有り難いです。\n\n千雪とPさんがイッちゃう差分もあると嬉しいですけど、負担になるようでしたら、無くても結構です。\n\n納品形式はpsdを希望します。宛名や擬音と台詞がレイヤーで分かれているととっても助かります。\n\nご検討のほどよろしくお願い致します。\n\n参考資料:\n\n桑山千雪\nhttps://bit.ly/3dsVqEQ\n\n対面座位＋乳吸い\nhttps://bit.ly/2AmmyXA", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 40721, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "212", "screen_name": "212kisaragi", "avatar_url": "https://pbs.twimg.com/profile_images/1272244626162778112/LOqAUsf4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2398503762/1397116903/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 75, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 47359, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "乳乃森 skeb27日土曜日まで募集中", "screen_name": "Sk9k2YOxmrYrixW", "avatar_url": "https://pbs.twimg.com/profile_images/1862070701316018176/3LvCMDpo.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 69012, "creator": true, "nsfw_acceptable": t