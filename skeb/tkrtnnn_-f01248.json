、月の闇の側面を象徴しています。狼の仮面を頭につけた姿で描いてください。もし可能なら、モンスターのような口をしたバージョンと、普通の口をしたバージョンの両方を描いていただけると嬉しいです！でも、無理なら仕方ありません。 \n\n髪の色は青で、目は黄色く、動物の目のように光を反射します。頭の横にはオオカミの耳があり、細い青い尾があります。（人間の耳は描かないでください）\n\nこのイラストをSNSで使用させていただきたいのですが、その際は必ずあなたへのクレジットを明記します。\n\n本当にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1poyBgOLpvx0qiObW9RD3YzbF0D_vc9bN?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tkrtnnn_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4124013, "client_id": 2900383, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b100134d/uploads/origins/0324bd1f-23ef-4275-acce-f319f19a4644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a16f5613aa1b59c85ff0b46872f25e50", "srcset": "https://si.imgix.net/b100134d/uploads/origins/0324bd1f-23ef-4275-acce-f319f19a4644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a16f5613aa1b59c85ff0b46872f25e50, https://si.imgix.net/b100134d/uploads/origins/0324bd1f-23ef-4275-acce-f319f19a4644?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71a3204c8294109ed541cd4e4d6c57ea 2x, https://si.imgix.net/b100134d/uploads/origins/0324bd1f-23ef-4275-acce-f319f19a4644?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6988086cb0767fdd50178e78f9de1281 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b100134d/uploads/origins/0324bd1f-23ef-4275-acce-f319f19a4644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f7aa7029541489c5d59f8cc4bd52e66", "srcset": "https://si.imgix.net/b100134d/uploads/origins/0324bd1f-23ef-4275-acce-f319f19a4644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f7aa7029541489c5d59f8cc4bd52e66, https://si.imgix.net/b100134d/uploads/origins/0324