図がないため背面部分は補完していただく必要がございます。\n・人間の食べ物やゲームに興味を持ちやってきた人間界勉強中妖狐です。\n・狐耳と人間耳は共存しません。\n・目の下にのみ模様があります\n・ポニーテールの場合見えませんが後ろにリボンがあります。\n・中性的な体つき&見た目をしてますが性別は女性です。\n中性的に描いてくださいますとありがたいです。\n・GoogleDriveの中に一緒に活動しているもう1人の画像も含まれてますが気にしないでいただけますと幸いです。\n\n【納品データ】\nもし可能であれば背景、人物、サインが分かれたpng.またはpsd.データでいただけると嬉しいです。\n\n金額、内容に不備あれば御手数ですが再送して頂けますと幸いです。\nご検討よろしくお願いいたします!!\n\nhttps://drive.google.com/drive/folders/164g_wZLtFrQ6TiFVXIhPGFguc2BUyUUi", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nikoru_3_3/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3774872, "client_id": 1920579, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ebc10202/uploads/origins/4fdef52f-87b9-4521-8bb8-12261755a3c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89bbf7bb4dfe9f21817032319caab907", "srcset": "https://si.imgix.net/ebc10202/uploads/origins/4fdef52f-87b9-4521-8bb8-12261755a3c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89bbf7bb4dfe9f21817032319caab907, https://si.imgix.net/ebc10202/uploads/origins/4fdef52f-87b9-4521-8bb8-12261755a3c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c8916e505e12b6ca83c0dca91a427d8 2x, https://si.imgix.net/ebc10202/uploads/origins/4fdef52f-87b9-4521-8bb8-12261755a3c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=488822253123b1cc7eb270b3c51a714a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ebc10202/uploads/origins/4fdef52f-87b9-4521-8bb8-12261755a3c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84f731ba0e65cdd314d98b508c02127d", "srcset": "https://si.imgix.net/ebc10202/uploads/origins/4fdef52f-87b9-4521-8bb8-12261755a3c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s