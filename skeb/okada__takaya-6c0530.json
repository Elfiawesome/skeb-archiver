bdb8-7fbbf4cc16dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c1ab1f40aeb4878bffc3a0a0953d57a", "srcset": "https://si.imgix.net/22b2f10e/uploads/origins/32143f24-239c-4890-bdb8-7fbbf4cc16dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c1ab1f40aeb4878bffc3a0a0953d57a, https://si.imgix.net/22b2f10e/uploads/origins/32143f24-239c-4890-bdb8-7fbbf4cc16dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cefb07264d052e4c6d5402f8e790342c 2x, https://si.imgix.net/22b2f10e/uploads/origins/32143f24-239c-4890-bdb8-7fbbf4cc16dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=112995ca2e9e08f3540342be049f04fc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22b2f10e/uploads/origins/32143f24-239c-4890-bdb8-7fbbf4cc16dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f5b4e16a3dc718661fcf64cd8a71f42", "srcset": "https://si.imgix.net/22b2f10e/uploads/origins/32143f24-239c-4890-bdb8-7fbbf4cc16dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f5b4e16a3dc718661fcf64cd8a71f42, https://si.imgix.net/22b2f10e/uploads/origins/32143f24-239c-4890-bdb8-7fbbf4cc16dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=331ee846c9b4b3f4d3a5dc7b5d7c6507 2x, https://si.imgix.net/22b2f10e/uploads/origins/32143f24-239c-4890-bdb8-7fbbf4cc16dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=daca195471f2317f82c700d0f601a383 3x"}, "body": "いつもお世話になっております。エトラちゃんは見たのイラストをお願いしてた者です。\n\n今回も同じく【エトラちゃんは見た！】よりヒイラギ（灰紫髪）とカツラ（オレンジ髪）をお願いしたいと思います。\n参考画像\n【ヒイラギ　灰紫色髪】\nhttps://www.pixiv.net/artworks/112144139#manga\n\nhttps://www.pixiv.net/artworks/104014685#big_0\n【カツラ】https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTTjXQPj_fNdZrbOVz3tcWIHTIhM6-5se8rL06E7h_pG6swSucLVoocpiE&s=10\n\nポーズはこちらのURL画像です。閲覧注意\nhttps://pbs.twimg.com/media/GMaFwi3b0AArser?format=jpg&name=large\n体格、筋肉、胸とチンポの大きさはポーズ参照画像と同じくらいで。\nガラス張りのシャワールームの前後で\n\n【前】\nカツラ【高校生設定】がガラスにもたれ掛かり（ガラスは描かなくていいですが参考画像のように手と胸がガラスに当たっているような色分けをお願いしたいです。）\n\n【後】\nヒイラギ【大学生くらい設定】が　参照画像と異なるのは右手でカツラの陰部の付け根（玉袋後ろを掴んで）揉んでいるような感じで。※チンポの竿と玉袋が隠れないように。\n表情は顔が赤らめているがセックス慣れしていて余裕そうな表情。\n\n差分は\n①枚目カツラがヒイラギに少し苛立ちを感じてるような表情\n\n②枚目はポーズ参照の前の人のような感じで射精お願いします。\n\nいつも素敵な作品をありがとうございます。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@okada__takaya/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2973255, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d3fee37/uploads/origins/f4cf2d25-9b00-4c87-8549-510000200533?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e4e11e7a5abe7f20cebbd8f0046c96f", "srcset": "https://si.imgix.net/5d3fee37/uploads/origins/f4cf2d25-9b00-4c87-8549-510000200533?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e4e11e7a5abe7f20cebbd8f0046c96f, https://si.imgix.net/5d3fee37/uploads/origins/f4cf2d25-9b00-4c87-8549-510000200533?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05e061dce8ffccac1cd6f01d25accf2d 2x, https://si.imgix.net/5d3fee37/uploads/origins/f4cf2d25-9b00-4c87-8549-510000200533?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13797f71863a2918922e7832799776db 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d3fee37/uploads/origins/f4cf2d25-9b00-4c87-8549-510000200533?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=993dddf318d10f2e84d7a5fcdf4765bf", "srcset": "https://si.imgix.net/5d3fee37/uploads/origins/f4cf2d25-9b00-4c87-8549-510000200533?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=993dddf318d1