at%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a68bb53963e9381f969ae0b9e9569403", "src_set": ""}, "body": "初めまして、エンジェリックリンクのガープちゃんで千歳坂さんを知ってから度々イラストをみています。\n\n今回SNS上でのアイコンと、イベント用の名刺として使用したいイラストをお願いしたくて依頼をだしました。\n\n要望\n・髪型は三つ編みで眼鏡っ娘のロリキャラ、髪の色はピンク系、目の色は青系でお願いしたいです\n・「まごころ」と焼き印された、食べかけの大きめなどら焼きを持たせて下さい。\n・服装は和風でお願いします。\n・ポーズや背景はお任せしたいです\n\nサイズ\n名刺に使いたいので横長にしてもらえると助かります\n\nhttps://twitter.com/magocoro_DRYK_1/status/1680111118784802816?t=Zko3GCzfP9kCxFhkkku90Q&s=19", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suzu_0131/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5260, "client_id": 970598, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f478aaf/uploads/origins/a423a259-af4e-4e27-bc68-a2080dbbaa6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4859c2f65d3161f565430244aaefcdb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f478aaf/uploads/origins/a423a259-af4e-4e27-bc68-a2080dbbaa6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4522b62d1e75ca28d957ae4e0c8e380e", "src_set": ""}, "body": "版権もののご依頼は問題ないでしょうか？\n大丈夫であれば、「ロウきゅーぶ！」の袴田ひなたちゃんのイラストをお願いしたいです\n\nピンクのランドセルを背負って楽しそうに見せびらかしてる感じでお願いします\n彼女の通う小学校は私立でランドセルがないので、背負わせてあげてほしいです！\n服装などはおまかせします！とにかくかわいく描いちゃってください！\n\nhttp://www.ro-kyu-bu.com/contents/hp0003/index00080000.html", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suzu_0131/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 5260, "client_id": 2609154, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2aa752a3/uploads/origins/9cfd3e1c-211f-4193-845d-be251a9dc766?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=732c896a3e5553c7b10845a8bfccb505", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2aa752a3/uploads/origins/9cfd3e1c-211f-4193-845d-be251a9dc766?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6068a2a3f13d1eb7d5f0467b37bd68a2", "src_set": ""}, "body": "私はあなたのファンです。花开。\nもしよければイラストを描いてください。\n【サイズ】16:9（1920×1080）の絵を作ってほしいです。\n【服装】セパレート型水着\n脚については、白いストッキングと素足を使ってもいいですか？\n【セリフ】（お兄さん、一緒に遊びに来ましょう）\n※宛名はニックネームの「花开」でよろしくお願いいたします（簡体字ですみません）\n※よろしければ、宛名ON/OFFのPSDをいただければ幸いです。\n\nhttps://twitter.com/Kaosu_Nanoda/status/1439164500863639555?t=CKQNjzAdTAjIQZpe06IJ3Q&s=19", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suzu_0131/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5260, "client_id": 2241376, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9f26716/uploads/origins/7d1d688e-b48f-43ad-8bfe-b60cc58dc01b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e397a933ae5a2cf610962f290f4b28cd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9f26716/uploads/origins/7d1d688e-b48f-43ad-8bfe-b60cc58dc01b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3030a49a9c5774534566000b6f037b73", "src_set": ""}, "body": "すず先生初めまして！\n以前よりすず先生のイラストを拝見していました。今回、私の推しのVtuberさんである桃田ももちゃんのイラストを描いていただきたく依頼しました！\n詳細については下記のようになりますので、よろしくお願いいたします。\n\n◎依頼したイラストの使用用途\nFAのほか、ご本人が動画等サムネイル、SNS等活動に使用する可能性があります。問題なければご了承いただきたいと思います。\n\n◎イラストの詳細\n・ポーズ・構図・背景はお任せしたいと思います。\n・お任せする背景ですが可能であれば凝ったものをお願いしたいです！\n・宛名はあるものとないもののイラストで分けていただきますと幸いです。\n・可能であれば人物のみの透過版イラストもいただきたいです。\n・ももちゃんは幼さがある感じを描いて頂ければ嬉しいです！\n\n◎イラストサイズ　\nサイズは16:9横長(1920×1080だとなお嬉しいです)で、体全体が入るイラストを希望いたします。バランス等問題あればそれ以外のショットでも構いません。\n\n◎桃田ももちゃんの主な活動場所・詳細\n・youtubeチャンネル : https://www.youtube.com/channel/UCfe3qT3KxVufJTxT76VSpRg　\n・Twitter : https://twitter.com/Momotamomo_0303\n・主な配信内容 : 雑談、歌枠、ゲーム\n\n◎デザイン参考\n・https://twitter.com/Momotamomo_0303/status/1444927076318908418\n・https://twitter.com/RRa13L/status/1445713854483230726", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suzu_0131/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5260, "client_id": 2371841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/404514ec/uploads/origins/ebbc392e-30bf-4d7d-b856-52aed47c7c61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d53adc518e80d2fca7ddc9516f3b394e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/404514ec/uploads/origins/ebbc392e-30bf-4d7d-b856-52aed47c7c61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a90ebb6b14e677e4560c896e0a035d9", "src_set": ""}, "body": "千歳坂すず先生に描いていただいた星姫村絵がすごく情緒があって、原作のあずまゆき先生からも感謝されていて、何より\n千歳坂すず先生もこの作品が好きみたいで嬉しいです！\n今回は星姫村のさなえ先生の授業シーンを依頼したいと思います。\n優しくて、ふわふわなさなせ先生が無邪気な可愛い子たちとの授業で、なんらかのハプニングがあったり、なかったりとか、そういう楽しい情景が欲しいです。\n授業の内容や、室外室内かは千歳坂すず先生が好きなように描いてもらいたいです。\nどうもありがとうございます！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suzu_0131/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5260, "client_id": 2371841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f641fb7/uploads/origins/566985b0-f357-4f1b-8a05-e65575cd67b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48e8ba6d10d4eca58c3d82b6817996c4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f641fb7/uploads/origins/566985b0-f357-4f1b-8a05-e65575cd67b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48fcb775115f09514290ef775ca7d164", "src_set": ""}, "body": "千歳坂すず先生こんにちは、先生の作風が好きです。\nあずまゆき先生の漫画　星姫村のないしょ話　の世界観が大好きで、中の元気で健気な子供たちが微笑ましいだと思います。\nもし良かったら、千歳坂すず先生に山の川辺で水遊びの星姫村の少女達を描いていただけたいです。\nどうぞよろしくお願いします、ありがとうございます！", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suzu_0131/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5260, "client_id": 1986708, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3770f3c/uploads/origins/a297b7ca-fff7-497a-911a-c5c3d63ab59a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79d98f9ae6a48874a316eb4d490ab6a1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3770f3c/uploads/origins/a297b7ca-fff7-497a-911a-c5c3d63ab59a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ed572da13666e1b117f786655c005a3", "src_set": ""}, "body": "千歳坂すず様、はじめまして。\n素敵なイラストに惹かれ、リクエストを送らせて頂きました。\n\nVTuberの綵てまりさんのファンアートを描いて頂きたいです。\nhttps://twitter.com/temari_ayaginu\n\n\nポーズ、構図、表情などは全ておまかせになってしまいますがよろしくお願いします。\n\n【綵てまりさん参考用画像】\nhttps://pbs.twimg.com/media/E5Zd65_VIAEzN4x?format=jpg&name=medium\n目の中にハートがあります。\n左目の下に泣きボクロがあります。\n\n【使用用途】\n綵てまりさん本人に限り使用許可を頂きたいです。※Twitter、配信サムネイル等に使用\n\n【その他】\n人物・背景等がレイヤー分け出来るPSDデータで頂けると有難いです。\n\n以上、よろしくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 22732, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぺち🌸C106新刊委託中", "screen_name": "peeechika", "avatar_url": "https://pbs.twimg.com/profile_images/1977326626846482432/wkGbHohF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/951298852350451714/1760266394/1500x500", "a