Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c11f914b881f41a0bb9b829eaf33e7d4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd61fc11/uploads/origins/ed41ed79-1fee-4aae-9b3f-8a9e8c0f9658?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65398c1599b0171b1d2749b686630cc7", "srcset": "https://si.imgix.net/dd61fc11/uploads/origins/ed41ed79-1fee-4aae-9b3f-8a9e8c0f9658?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65398c1599b0171b1d2749b686630cc7, https://si.imgix.net/dd61fc11/uploads/origins/ed41ed79-1fee-4aae-9b3f-8a9e8c0f9658?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d625fa9e1ce57fea6ffc0e322021faa 2x, https://si.imgix.net/dd61fc11/uploads/origins/ed41ed79-1fee-4aae-9b3f-8a9e8c0f9658?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9cd15b6ea605b3c0215bdc80bbdda2ed 3x"}, "body": "ハコちゃんこんばんは、\nいつも配信や作品等、楽しませてくれてありがとうございます。\n早速になりますが、リクエスト内容は以下になります。\n\n夏も近づいてきましたので、よろしければ…\n「「「ハコちゃんのエチエチな水着姿」」」\n…が見たいです！\n\nハコちゃん自身がどのような水着が着たいのか知りたいのと、エチエチ全開なハコちゃんを見てみたく、今回この題材にしました。\nNSFWが付いており、エチエチ全開…とも言いましたが、ハコちゃんとお母様(担当イラストレーター様)が許す範囲での表現で構いませんので、その辺りの加減はおまかせします。\n水着はフリル付きのものやビキニ、スク水…等、ハコちゃんが好むもので有れば何でも良いです。\n背景は特に無くても構いませんが、太陽が輝く夏の海以外にも、コウモリらしく昼間に海に行けなくて夜のお屋敷の中というのも良いかもしれないですね。もちろん、この辺りもお任せします。\nそれとコレはかなりご負担になるかと思うので全然やらないで良いのですが、水着でも普段の服でケープを脱いだような差分が有ったらとてもとても助かります。(分かりにくくなってしまいましたが、差分でえちえち度の加減ができる…みたいな意味です。)\n\nリクエスト内容は以上になりますので、ご検討頂けますと幸いです。\n\nまた、自分だけがハコちゃんの素敵なイラストを見れるのような状況はもったいないと感じますので、活動等にご活用いただければ幸いです。\n\n長くなってしまいましたが以上になります。\nご負担にならない範囲で構いませんので、よろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Totomori_Hako/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1134984, "client_id": 1522516, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee277374/uploads/origins/90f79105-c4c9-4d17-a247-5e42aaf441cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd493e566336b44624333946479e1bf8", "srcset": "https://si.imgix.net/ee277374/uploads/origins/90f79105-c4c9-4d17-a247-5e42aaf441cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd493e566336b44624333946479e1bf8, https://si.imgix.net/ee277374/uploads/origins/90f79105-c4c9-4d17-a247-5e42aaf441cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d97f435f6ea9a1a18d302fd3f71a51db 2x, https://si.imgix.net/ee277374/uploads/origins/90f79105-c4c9-4d17-a247-5e42aaf441cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d967e5f5f45b2f8d94b2284cb93ed4d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee277374/uploads/origins/90f79105-c4c9-4d17-a247-5e42aaf441cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ceca4d19c8ae6ac42d4e77b5030ddd73", "srcset": "https://si.imgix.net/ee277374/uploads/origins/90f79105-c4c9-4d17-a247-5e42aaf441cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ceca4d19c8ae6ac42d4e77b5030ddd73, https://si.imgix.net/ee277374/uploads/origins/90f79105-c4c9-4d17-a247-5e42aaf441cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b2d8c2009cec140ebba7ea918ecbc4b3 2x, https://si.imgix.net/ee277374/uploads/origins/90f79105-c4c9-4d17-a247-5e42aaf441cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5dbfbe928e5c156c10f7940edf5e1d41 3x"}, "body": "ハコちゃんに、私の描いたオリジナルキャラの娘を描いてもらいたくてリクエストします。\n服装は、この娘が来ている制服で、ポーズはネコのポーズ(よく見る両手をグーにしてクルッっとしているイメージ)でお顔は正面か斜め45度角で表情は少しニコッとしていて、髪は下から少し風が掛かってフワッとした感じに。\nチョットお尻を突き出している風でスカートの中のパンツが見えそうで見えない位にスカートもなびかせる。\nそんなイメージで描いてもらえると嬉しいです。\nハコちゃん的に少しエチチにアレンジして貰ってもいいです。\n全身でなくてもいいですが、出来れば膝下付近までの立ち絵で。\nもちろん全身でも可能だったらお願いします。\n背景はおまかせしますが、あっても無くてもいいです。\nオリジナルキャラは、私の固定ツイを参照してください。\nこのリクエスト内容でもし宜しければ･･･ご検討お願いします。\n\nhttps://twitter.com/kawa__yasu/status/1529024257979994112", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Totomori_Hako/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1134984, "client_id": 11245, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ead60c3/uploads/origins/30249a29-01b6-4b31-9e6d-f7023e702c62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d300d7b23c9500c4ad9bb764d14a56c8", "srcset": "https://si.imgix.net/1ead60c3/uploads/origins/30249a29-01b6-4b31-9e6d-f7023e702c62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d300d7b23c9500c4ad9bb764d14a56c8, https://si.imgix.net/1ead60c3/uploads/origins/30249a29-01b6-4b31-9e6d-f7023e702c62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=757d5edff0db8024961ff802f10ce6a9 2x, https://si.imgix.net/1ead60c3/uploads/origins/30249a29-01b6-4b31-9e6d-f7023e702c62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af69c360e697da944de79dc228641910 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ead60c3/uploads/origins/30249a29-01b6-4b31-9e6d-f7023e702c62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf420143edffb59d2658d8ba4475f0f5", "srcset": "https://si.imgix.net/1ead60c3/uploads/origins/30249a29-01b6-4b31-9e6d-f7023e702c62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf420143edffb59d2658d8ba4475f0f5, https://si.imgix.net/1ead60c3/uploads/origins/30249a29-01b6-4b31-9e6d-f7023e702c62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5010b0f0d6b845e63ddb2ed389add516 2x, https://si.imgix.net/1ead60c3/uploads/origins/30249a29-01b6-4b31-9e6d-f7023e702c62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64e8cc67703e90a88fe9c1acddbe3604 3x"}, "body": "ゆるーくエルあやを描いて頂きたいですが、兎々森ハコさんの絵柄的にエルガーは描きにくいと思うので、あやめちゃんメインで…（できそうだったら）何かしらエルあやちゃん要素も取り入れつつ！という感じでお願いしたいです\n例えば、エルガーへのプレゼントを買いに行くあやめ（とメイシェン）とか、そういう感じですね。別にこのシチューに限らず好きに描いてもらえれば嬉しいです\nサイズは印刷用解像度（タテヨコ比お任せ）\n使用範囲可能性は、ツイッター他SNS、HP転載、個人誌掲載などです\n\n【あやめ】\nわりと見た目どおりなストイックな大和撫子、天使爛漫、戦う女子。強い。主人公。巨乳。髪型インテーク。髪色は完全な黒ではないです\n好きな男が手を出してくれないのでもどかしく思いつつも奥ゆかしいので攻め攻めにもなれない\n色味が絵によってまばらですが原則はサイトの紹介イラスト準拠でお願いします（表現上の揺れも乙なものです）\n\n補足【あやめとメイシェン】\nあやめはまれに（特に好きな男関連で）ポンコツになりがちな大和撫子、メイシェンは言動は煩悩丸出しの守銭奴だが案外深く物事を考えている…ようで実際子どもメンタル\n二人はとにかくお互いに依存してる\nメイシェンは「あやめに付く悪い虫」としてエルガーに冷たくするときもあるが、実際に何よりも「エルガーを好きなあやめの気持ち」を尊重してるしエルガーのこともちゃんと認めてて二人を祝福してる、典型的な良い友達ポジション\nあやめに対しては（おちょくったりつついたり、年相応の打ち解けた女友達感はあるものの、本質的には）全肯定マシーン\n\nhttp://tocca571.parallel.jp/original/arc/\n\nhttps://twitter.com/paradoxicaltheo/status/1421715295769567233?s=19", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Totomori_Hako/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/afdd4f0b/uploads/origins/88333d54-31b5-45a1-9a69-c66dbd4d2f4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4e772ae8cb21da2fe468e7297fbd628", "srcset": "https://si.imgix.net/afdd4f0b/uploads/origins/88333d54-31b5-45a1-9a69-c66dbd4d2f4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4e772ae8cb21da2fe468e7297fbd628, https://si.imgix.net/afdd4f0b/uploads/origins/88333d54-31b5-45a1-9a69-c66dbd4d2f4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txta