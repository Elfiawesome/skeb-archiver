ーラーではなくスマホを使っています。\n\n描きやすいようキャラデザや構図を変えていただいてかまいません。\n服装もお任せします。\n絵柄については、リアル調よりアニメ調希望です。\nよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toketsurin/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/534cdd04/uploads/origins/b0a4c8c1-afd5-4b70-a561-d31e617ea504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d85be007035c2f0d1fac3a681852a0c6", "srcset": "https://si.imgix.net/534cdd04/uploads/origins/b0a4c8c1-afd5-4b70-a561-d31e617ea504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d85be007035c2f0d1fac3a681852a0c6, https://si.imgix.net/534cdd04/uploads/origins/b0a4c8c1-afd5-4b70-a561-d31e617ea504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd6324f449db3fb530ba02f79f71e6cd 2x, https://si.imgix.net/534cdd04/uploads/origins/b0a4c8c1-afd5-4b70-a561-d31e617ea504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6cb557f8285e482cf7ca62ee02ee012c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3607015, "nc": 33}], "sent_works": [], "similar_creators": []}, "price_history": {"art": [{"amount": 5000, "recorded_at": 1781345602.83418}]}, "custom": {}}