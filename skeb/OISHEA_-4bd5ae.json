の方を優先していただいても構いません！\n\n以下詳細です。\n\n【人物】\nアンデッド初瀬のイラストをお願いしたいです。\n参考画像については資料に入れさせていただきます。\n\n【雰囲気・服装等】\n今回も雰囲気、服装、構図、表情等お任せ致します。\n強いて言えば、タバコを持っていて少し暗めの雰囲気だと嬉しいです！\n\n【使用用途】\nサムネイル、Twitterでのタグ投稿画像、活動で使用させていただきたいと考えております。また、グッズ制作等を行なってもよろしければ行いたいです。難しければ大丈夫なので、レイヤーにその旨記載いただければ幸いです。\n\n【その他】\npsdファイルでいただけると幸いです。\nサムネイル等に使用したいため、髪や服をイラスト内に収めていただけるととても嬉しいです！\n\n以上長くなってしまいましたが何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-0PEjSKIOM99YxaOIx2MUymWYfKpi23G", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@OISHEA_/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2805954, "client_id": 3093136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d83bae85/uploads/origins/27fcbced-1cd9-45b8-9e38-0d7355fd56cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cae0756d7b0c763c2c6beb5ffd2bae18", "srcset": "https://si.imgix.net/d83bae85/uploads/origins/27fcbced-1cd9-45b8-9e38-0d7355fd56cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cae0756d7b0c763c2c6beb5ffd2bae18, https://si.imgix.net/d83bae85/uploads/origins/27fcbced-1cd9-45b8-9e38-0d7355fd56cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9cb0dbeb2ffd9616137f27179142592 2x, https://si.imgix.net/d83bae85/uploads/origins/27fcbced-1cd9-45b8-9e38-0d7355fd56cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30f35e6739f2d706a91da1c129d6effe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d83bae85/uploads/origins/27fcbced-1cd9-45b8-9e38-0d7355fd56cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0575ae63c80643ca6ace4bc2e5164af", "srcset": "https://si.imgix.net/d83bae85/uploads/origins/27fcbced-1cd9-45b8-9e38-0d7355fd56cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cro