053c666455?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6973511d3a275ef23d2d4be5b259fc3", "srcset": "https://si.imgix.net/d022f61b/uploads/origins/d6a58798-baff-4bdd-b3a8-36053c666455?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6973511d3a275ef23d2d4be5b259fc3, https://si.imgix.net/d022f61b/uploads/origins/d6a58798-baff-4bdd-b3a8-36053c666455?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8fb38adcbd44f4ac56b798267a2c5d69 2x, https://si.imgix.net/d022f61b/uploads/origins/d6a58798-baff-4bdd-b3a8-36053c666455?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=89604b146161de38b45fb872b81aabda 3x"}, "body": "こんにちは！あなたの作品はとてもかわいいですね！\n\n秋のイチゴ飴でいっぱいのカボチャの中にいる青い犬のキャラクターを描いてほしいです。リンゴ飴や小さなケーキやお菓子もお願いできますか？犬として、彼女はふわふわの毛を持ち、黒い首輪をしています。彼女はとても陽気ですが、ランダムに昼寝をすることもあります。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1XJj2rsratl5wu_VcM99FXyyqZzdsEjL8?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@GAHAoni/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1858227, "client_id": 1249073, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf969acd/uploads/origins/a3f69c15-3782-4ba0-8f60-d7dbe1c0b668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90fcc2d476fb5f5fecad7b8f958d63ab", "srcset": "https://si.imgix.net/bf969acd/uploads/origins/a3f69c15-3782-4ba0-8f60-d7dbe1c0b668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90fcc2d476fb5f5fecad7b8f958d63ab, https://si.imgix.net/bf969acd/uploads/origins/a3f69c15-3782-4ba0-8f60-d7dbe1c0b668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62255f8fed19b82ea5a99ee81e5a83d3 2x, https://si.imgix.net/bf969acd/uploads/origins/a3f69c15-3782-4ba0-8f60-d7dbe1c0b668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8452c57b552444100ade8ad27fa377e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf969acd/uploads/origins/a3f69c15-3782-4ba0-8f60-d7dbe1c0b668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0da3d4e7776ad60e7ffe5bd8d8f97910", "srcset": "https://si.imgix.net/bf969acd/uploads/origins/a3f69c15-3782-4ba0-8f60-d7dbe1c0b668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0da3d4e7776ad60e7ffe5bd8d8f97910, https://si.imgix.net/bf969acd/uploads/origins/a3f69c15-3782-4ba0-8f60-d7dbe1c0b668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d11de54a37d29241d67bdfc5f2eda090 2x, https://si.imgix.net/bf969acd/uploads/origins/a3f69c15-3782-4ba0-8f60-d7dbe1c0b668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6a765865ae2b8ceb4500941b76e5bb22 3x"}, "body": "いつもとっても可愛いイラストありがとうございます。\n最近白いウサギがマイブームで、ぜひGAHAさんの描かれるウサギを拝見したくてリクエストします。\n\nリクエストしたいのがちょっとややこしいテーマなのですが、次のどちらかをイメージして、白いウサギを描いてほしいです。\nデザインは基本おまかせで、頭・胸・腰のいずれかにおそろいの白いリボンをつけてもらえると嬉しいです。\n・資料フォルダの女の子（MMOのアバターです）が所持しているウサギのぬいぐるみ\n・もしくは、資料フォルダの女の子のウサギver\n\n絵柄は過去作品と同じようなものでお願いします。\nGAHAさんの発想力がとても好きなので、構成などぜひおまかせしたいです。\n（いつもみたいに食べ物とセットでも、無機物と一緒でも、キャラクターのみで背景なしでも何でも構いません。）\n\nテーマが難しいなどあれば遠慮なくキャンセルしてください。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1f1gh_GB5nKgtBR7qcTU1zWfz8J5ulNnj?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@GAHAoni/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/830ad6a3/uploads/origins/277075cc-69ff-40f6-b468-cd76b2eb918c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ae805ec67b563ca6c85b769