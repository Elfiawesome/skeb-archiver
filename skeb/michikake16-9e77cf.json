画などのVtuber活動全般での使用\n・また、待ち受けやネットプリントなどでのリスナーへの無料配布も行えればうれしく思います。\n\n【他】 \n背景と人物を分けてPSDでの納品が好ましいです。\n全身のお写真だと大変嬉しく思いますが、アップでも問題ありません。\n横側の見切れ(髪の毛や手など)がないものだと大変嬉しいです。\n\n以上になります、内容をご確認の上、またご縁がありましたら是非よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@michikake16/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2506043, "client_id": 3543692, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b20902b0/uploads/origins/41944ac0-14e1-4d6b-9f5d-f483594a7f41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebf0149e16c8707ca5a16ffb59f6c3f3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b20902b0/uploads/origins/41944ac0-14e1-4d6b-9f5d-f483594a7f41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d24702004be8a9731d5b34fa9919321", "src_set": ""}, "body": "初めまして、ツイキャスで配信をしているローと申します。\n今回は未知欠様のイラストに惚れてイラストを頼みたいと思いました。\nイラストの内容\n・人間（男）イメージ、にじさんじの不破湊さん\n・髪色はピンク\n・髪型はウルフ\n・左耳にピアス3連\n他の服装とかはお任せします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@michikake16/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2506043, "client_id": 3513069, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2413f4db/uploads/origins/109810bc-e949-4204-9fe2-6ab312ee73ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7d7241c0d0597cd2faf4f9b479cc66c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2413f4db/uploads/origins/109810bc-e949-4204-9fe2-6ab312ee73ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c1738d1806dae28144c6cef6a4e29ff", 