uration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6e14e13/uploads/origins/6a6b63b3-c7e5-4e99-8c6b-b7017ccfbf9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b82822b00cacb7e3b6026c29ba758440", "src_set": ""}, "body": "はじめまして。もしご縁ありましたらご一考いただけると幸いです。\n\n添付資料URLのうちのオリキャラの女の子のイラスト化をお願いしたいです。\n可愛くセクシーな雰囲気の魔法少女。胸もお尻も可能な範囲で大きめ。\nエッチな描写は可能な場合のみで任意。ピンク髪の魔法少女衣装での希望ですが、\n\nポージングは可愛くセクシーなあざとさ全開なポーズのイメージです。\n\nhttps://ibb.co/album/vDGfr8", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@o_r_i_124/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1364941, "client_id": 2969643, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0dfbe9ba/uploads/origins/093db079-3d3e-4386-837f-3cb093fd300f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70c85ecb5711f5eb2654082b8541cf95", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0dfbe9ba/uploads/origins/093db079-3d3e-4386-837f-3cb093fd300f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bf67e580a1d96ca689681ba50d9244d", "src_set": ""}, "body": "こんにちは。はじめまして。\n\n私のOCのルミを資料の4枚目の画像の制服を着て描いていただけませんか？また、ツインテールにリボンをつけて、3枚目のような感じでお願いします。青いフレームのメガネも忘れずにお願いします。\n\nその他、ポージングや構図はお任せします。\n\nよろしくお願いします。\n\nhttps://imgur.com/a/O7TxvIw", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@o_r_i_124/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1364941, "client_id": 2504804, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01187417/uploads/origins/1bd0fad9-2867-4715-a43c-c3bb4d3bc6f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&