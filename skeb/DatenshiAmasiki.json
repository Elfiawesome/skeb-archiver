an/character/character2/kisaki.html\n\n美津子はランガードありのベージュパンストに赤下着\n英理は同じくランガードありの茶パンスト黒下着\n\nシチュエーション\nテレビの催眠番組を見ていた二人は図らずも催眠状態になってしまい、淫乱状態に。\n（目は虚ろではなく、開いたまま光がない感じ）\nお互い「催眠にかかってなどいない」と主張しながらも完全に掛かってしまっており、抑えようとしても既にパンストから愛液がにじみ出ている。\nごまかす様にじゃれ合う（本当に～？）（やめてよ～）等\nしかしお互い発情しているので次第に激しく求めあってしまう。\nディープキスから涎ブリッジ、最後はシックスナインの形でお互い絶頂してしまう。\n\nよろしくお願いいたします。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DatenshiAmasiki/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2c15af0c/uploads/origins/9d291142-28c5-4fb8-84c0-5a96cdd76dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5475dd65397d21f059981ece18a673f9", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 98929, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@DatenshiAmasiki/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 98929, "client_id": 545947, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b5b442b/uploads/origins/a78b923b-2ef1-4777-826f-01aa7d0f9660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0647031e155723f210812515da6f99a6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b5b442b/uploads/origins/a78b923b-2ef1-4777-826f-01aa7d0f9660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=481eb90509aa6d5da5faa68866bc99d7", "src_set": ""}, "body": "はじめまして。\n可愛らしい絵柄と塗り方がとても好みでしたので、リクエストさせて頂きます。\n\n東方Projectの姫海棠はたてちゃん（資料①）が、スカートとパンツだけ穿いていない恰好で、\n靴下は有りで、アナル固め（資料②）という体位でアナルを犯されているイラストをお願いできますでしょうか。\n\n両手は後ろで縛られていて見えない感じでお願いします。\n表情は泣きながら悔しそうに喘いでる感じでお願いします。\n\nアナルから少し下品なブッのような音がありますと幸いです。\n\nマニアック内容で申し訳ありませんが、ご検討のほどよろしくお願い致します。\n\n\n\nご検討のほどよろしくお願い致します。\n\nhttps://drive.google.com/file/d/1lPnYCzvj_-pn10MXDCVwKWrdWWuItLLm/view?usp=sharing", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DatenshiAmasiki/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ceb56ac3/uploads/origins/445353d4-b159-481b-856f-b2b0ae8f47d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b7f13dc2a6f683dd487d089a320acc7", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 98929, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@DatenshiAmasiki/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4eb8a86e/uploads/origins/b03e8dab-b9bf-4d2d-a2e0-66f134be41d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14cf3370a36ca3dfd4020960a881758a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 98929, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 34, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@DatenshiAmasiki/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b7250af3/uploads/origins/58ed0070-bb64-46b9-b13c-441578708838?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200