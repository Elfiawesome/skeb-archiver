89a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0febcbed314fa81ca2c85a9155f820b, https://si.imgix.net/15fb3919/uploads/origins/a49319e6-656a-4bcc-a4d5-fa49b7789a93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbfd7007ce917686dd1d7195f65e4707 2x, https://si.imgix.net/15fb3919/uploads/origins/a49319e6-656a-4bcc-a4d5-fa49b7789a93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63515b00244df65b7498a4cd90490a74 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15fb3919/uploads/origins/a49319e6-656a-4bcc-a4d5-fa49b7789a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ffa578a7d2429618af07698e5c43d44", "srcset": "https://si.imgix.net/15fb3919/uploads/origins/a49319e6-656a-4bcc-a4d5-fa49b7789a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ffa578a7d2429618af07698e5c43d44, https://si.imgix.net/15fb3919/uploads/origins/a49319e6-656a-4bcc-a4d5-fa49b7789a93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=162edc73896ad91f6416cd1a318bdbdc 2x, https://si.imgix.net/15fb3919/uploads/origins/a49319e6-656a-4bcc-a4d5-fa49b7789a93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ee4a9b700f72f12245c21c56c1b3ae17 3x"}, "body": "黒葉だむ様、はじめまして\nあなた様の描かれる女性イラストの表情や肉付きなどとても好みで是非リクエストをお願いしたいと思いお送りさせていただきました。\n\nリクエストですがモノクロ形式でストレスが溜まったボーイッシュOLが催眠療法によって乳首をいじめてほしいという願望が発覚し医者に乳首をいじられ乳首イキする漫画をお願いしたいです！\n\nページ数は金額などから決めていただければ幸いです。\n\nキャラクターは黒葉だむ様のオリジナルキャラクターをお願いできないでしょうか。\n\nデザインの希望としては体型を巨乳でお願いしたいことと服装をOLさんスタイルのオフィススーツ、ワイシャツ、タイトスカート姿をお願いしたいです。\n\nまた医者に関しましては顔なしもしくは体のみの登場といった姿を描いていただきたいです。\n\nその他のデザインなどはお任せで描いていただけないでしょうか。\n\nまた漫画の展開や構図、セリフなどもお手数ではございますが黒葉だむ様にお任せで描いていただくことはできますでしょうか。\n\n一点だけ入れて欲しいシチュエーションやシーンがございましOLが催眠療法を受けとろーんとした催眠状態になるシーンを描いて欲しいです！\n\n催眠については催眠療法でお願いしたいので催眠アプリを使うという内容や描写はなしでお願いしたいです。\n\nOLは催眠療法を受けた際は虚ろな目とぼーっとした表情をお願いします。\n\n乳首責めの時は虚ろ目はそのままで喘ぎ声、オホ声を上げたりなど快楽に溺れている様子を描いて欲しいです。\n\nリクエストの内容が多くお手数をおかけいたしまして申し訳ございません。\n\nご検討をいただけましたらとても嬉しく思います！\nよろしくお願いいたします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuroabam/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/50a812a1/uploads/origins/96d1a501-9517-4d9d-b45e-e55d5a03eeba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea2441d1575cbcdc2b12632b440a621b", "srcset": "https://si.imgix.net/50a812a1/uploads/origins/96d1a501-9517-4d9d-b45e-e55d5a03eeba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea2441d1575cbcdc2b12632b440a621b, https://si.imgix.net/50a812a1/uploads/origins/96d1a501-9517-4d9d-b45e-e55d5a03eeba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e06a11afc5905299c32e77043c7ef4a1 2x, https://si.imgix.net/50a812a1/uploads/origins/96d1a501-9517-4d9d-b45e-e55d5a03eeba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9b9a083b2847291a29a002e140cfb95 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 28, "client_id": 3191644, "nc": 161}, {"path": "/@kuroabam/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0000a4f0/uploads/origins/e9990a66-0451-49d7-8512-4cab30370d4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79d179b07d54a5c7c3594c9821bb43f5", "srcset": "https://