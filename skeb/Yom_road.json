用用途：NSFWに該当する部分は適宜トリミングなどを行ったうえで、Youtube等の配信やそのサムネイルでの使用、ウォーターマークなどの加工をした上でのSNSでの使用などを考えております。そのほか、もし可能であれば個人観賞用に印刷をする許可もいただければ嬉しいです(頒布・販売等は致しません。難しければ結構ですので、psd内などにその旨ご記載いただければ幸いです)。\n\n〇形式など：psd形式でいただけると嬉しいです。キャラクターと、それ以外(背景やサインなど)は可能な範囲で別レイヤーに分けていただけると大変助かります。\n\n〇参考画像： Xアカウントとgoogle driveを記載いたします。\n①https://x.com/RyosukeTsukiyo\n②https://drive.google.com/drive/folders/19_zo9HFwtI_E9Ew6ID3ziu95biPTWZ9d?usp=sharing\n\nぜひご検討いただければ幸いです。よろしくお願いします！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Yom_road/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e0acd33d/uploads/origins/a7bda05e-0e0f-41d7-bfa1-dc4d71c71cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c76676a82e790840613ac3b7e8353392", "srcset": "https://si.imgix.net/e0acd33d/uploads/origins/a7bda05e-0e0f-41d7-bfa1-dc4d71c71cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c76676a82e790840613ac3b7e8353392, https://si.imgix.net/e0acd33d/uploads/origins/a7bda05e-0e0f-41d7-bfa1-dc4d71c71cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=abcee60e99e4e74ff33f3820a783f5b5 2x, https://si.imgix.net/e0acd33d/uploads/origins/a7bda05e-0e0f-41d7-bfa1-dc4d71c71cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae19d2a877eb8786d6ad8906acea6c53 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 3252617, "client_id": 30094, "nc": 32}, {"path": "/@Yom_road/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": 