とても愛している。\n\n\n資料のURLが見にくかったら申し訳ありません。\nどうか、よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/11_3ViWcwUDMnclbOqm5ZS2Ysd1jO7j0O", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@510_gotoudayo/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2513009, "client_id": 2854795, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa60a04d/uploads/origins/4613b016-3384-47d2-9d19-dd5f42c93216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=098dbd647aa413d0aaa4ed2b29ca8dc2", "srcset": "https://si.imgix.net/fa60a04d/uploads/origins/4613b016-3384-47d2-9d19-dd5f42c93216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=098dbd647aa413d0aaa4ed2b29ca8dc2, https://si.imgix.net/fa60a04d/uploads/origins/4613b016-3384-47d2-9d19-dd5f42c93216?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fcc518ac212171b2aeca9444a354aecc 2x, https://si.imgix.net/fa60a04d/uploads/origins/4613b016-3384-47d2-9d19-dd5f42c93216?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b961f62763d363fe378deabb467c3f2c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa60a04d/uploads/origins/4613b016-3384-47d2-9d19-dd5f42c93216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0d107323e862cdeac91fff323735258", "srcset": "https://si.imgix.net/fa60a04d/uploads/origins/4613b016-3384-47d2-9d19-dd5f42c93216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0d107323e862cdeac91fff323735258, https://si.imgix.net/fa60a04d/uploads/origins/4613b016-3384-47d2-9d19-dd5f42c93216?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=79082ca4d84f63123e505789d9e3fbb6 2x, https://si.imgix.net/fa60a04d/uploads/origins/4613b016-3384-47d2-9d19-dd5f42c93216?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=632e85b01e970484c2c8683d727d811b 3x"}, "body": "こんにちは、しまと申します。\n以前依頼させていただいた際は、素敵なイラストを本当にありがとうございました！\n今回もオリジナルキャラクターを描いていただきたく、リクエストを送っております。\n描いていただきたいキャラクターは、URL内の２人のキャラクターです。\n\nキャラクターの設定について\n二人について→同じ顔、対称にあるホクロ、同い年（30歳）、同じ誕生日（4/30）という疑似双子。天才と秀才というコンセプト。刑事。先輩と後輩。\n\n白髪の方→169cm、天才モチーフ。先輩。フィジカル弱めの変人。セルフネグレクト、友達がいない。ミニマリストで床やソファーで寝る。チェスが趣味。食事や睡眠、恋愛に興味が無い。雨の中でも傘を差さずに歩くような人。眼鏡フェチ。\n\n黒髪の方→174cm、秀才モチーフ。後輩。敬語キャラの真面目くん。お人よし。白髪の方のキャラクターに片思いをしているが、その思いを伝えるつもりはない。世話焼きの心配性。\n\n二人の関係性→先輩と新人のバディ。黒髪の片思いに白髪は気づいていない。気の知れた仲と言うよりかは、白髪←←←黒髪くらいの関係性。付き合ってもいないし、その兆しはありません。互いに信頼はしていますが、性格が違うため分かり合えない時もあります。\n\n設定は以上になります。\n1人だけ描いていただける場合は白髪の方のキャラを描いていただきたいです。\nお忙しい中恐縮ですが、ご検討いただけると嬉しく思います。\nよろしくお願いいたします。\n\nしま\n\nhttps://drive.google.com/drive/folders/1t8-KAA-iqTtQYiVo2mJWxPSq45K3j7oL?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@510_gotoudayo/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f040be20/uploads/origins/a02922ea-0fc1-4fea-86f3-8fdac92f3697?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e86d6ee129aafb6ba46007a81ef09299", "srcset": "https://si.imgix.net/f040be20/uploads/origins/a02922ea-0fc1-4fea-86f3-8fdac92f3697?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e86d6ee129aafb6ba46007a81ef09299, https://si.imgix.net/f040be20/uploads/origins/a02922ea-0fc1-4fea-86f3-8fdac92f3697?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02a8f02e2bec9c9495df157b703765b7 2x, https://si.imgix.net/f040be20/uploads/origins/a0292