=200&h=200&blur=200&s=32c84a3d422caa56a79ba5ba45e0a5e6 3x"}, "body": "先生、こんにちは！もしポコのイラストをもう1枚描いていただけたら、本当に嬉しいです。先生の手や顔の描き方が大好きなので、今回は、胸から上が入るようなポートレート風のイラストで、ポコの顔と、目、頬、唇、手などの繊細な部分にしっかり焦点を当てたものをお願いしたいと思っています。手は手袋をつけず、素のまま描いていただけると嬉しいです。\n\nポコは見る人の方をまっすぐ見つめ、両手で頬を支えながら、まるで窓の外を眺めているかのように、夢見心地な表情をしているイメージです。表情や手のポーズの参考として、女の子の画像を添付しました。見る人の方をまっすぐ向いておらず、両手で頬を支えているわけでもないため、完璧な参考画像ではなく申し訳ありませんが、私が思い描いているイメージを少しでもお伝えできれば幸いです。\n\nもしご迷惑でなければ、メガネをかけたバージョンも描いていただけますでしょうか？\n\nお時間をいただき、本当にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1FdgihO2bLkIBi5oPNwSRLuWtrj68hFfC?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oeoji_jp/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3709094, "client_id": 66065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ed9cb34/uploads/origins/1caeab26-c3f6-495b-baba-87bcba12acd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9c8efd5625e1f36638547f89a3f74b0", "srcset": "https://si.imgix.net/7ed9cb34/uploads/origins/1caeab26-c3f6-495b-baba-87bcba12acd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9c8efd5625e1f36638547f89a3f74b0, https://si.imgix.net/7ed9cb34/uploads/origins/1caeab26-c3f6-495b-baba-87bcba12acd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d3cd12bd0cd827eb8bcfb9edf84f8b7 2x, https://si.imgix.net/7ed9cb34/uploads/origins/1caeab26-c3f6-495b-baba-87bcba12acd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ffbaf5fe446c0c1825f3fd0e6733711 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ed9cb34/uploads/origins/1caeab26-c3f6-495b-baba-87bcba12acd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a58e7c9f0115c3a695416c1b349c0b2b", "srcset": "https://si.imgix.n