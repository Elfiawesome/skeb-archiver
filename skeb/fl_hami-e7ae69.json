39781, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7fafa163/uploads/origins/16846d97-d111-4a1d-91ab-7190625aab2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e47b3457b5d861072f3dbc9bedb26f0", "srcset": "https://si.imgix.net/7fafa163/uploads/origins/16846d97-d111-4a1d-91ab-7190625aab2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e47b3457b5d861072f3dbc9bedb26f0, https://si.imgix.net/7fafa163/uploads/origins/16846d97-d111-4a1d-91ab-7190625aab2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=574967b3067f63379fa7281c1674358b 2x, https://si.imgix.net/7fafa163/uploads/origins/16846d97-d111-4a1d-91ab-7190625aab2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7113f78c82db9430352021a80d76dce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7fafa163/uploads/origins/16846d97-d111-4a1d-91ab-7190625aab2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5b7fb825e4bcb3d658c596985bf9418", "srcset": "https://si.imgix.net/7fafa163/uploads/origins/16846d97-d111-4a1d-91ab-7190625aab2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5b7fb825e4bcb3d658c596985bf9418, https://si.imgix.net/7fafa163/uploads/origins/16846d97-d111-4a1d-91ab-7190625aab2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=50ad3f85afc24bd044e4ca705dbf8d82 2x, https://si.imgix.net/7fafa163/uploads/origins/16846d97-d111-4a1d-91ab-7190625aab2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=396e4eaafc65edcf2e616ebe222b1fb9 3x"}, "body": "初めまして！Xの検索から見つけて、ぜひお願いしたいと思いリクエストを送らせていただきました。\n今回お願いしたいのは、ライブ配信をする際に画面上に表示する立ち絵です。\nこれから主にTwitchなどの媒体で作業配信を始めてみようと考えているのですが、配信の際に画面が賑やかになるよう、立ち絵を置こうと思っています。\nこのように利用させていただくことが可能でしたら、ぜひお願いしたいです。\n\nキャラクターについては、SDキャラまたは比較的簡素なタッチで、バストアップの構図でお願いしたいです。\n以下、主な特徴を挙げさせていただきます。\n指定のない部分は基本的にお任せしたいです。\n\n・髪などのイメージカラー→#a2d7dd(この系統の色)\n・髪は一色だけでなくても良いです\n・つり目(瞳の色はおまかせ)\n・まろ眉\n・目尻に赤みチーク\n・八重歯\n・前髪ぱっつん\n・前髪のサイドに姫毛あり\n・ツインテール\n・ジャージ服の上にメイドエプロン(難しければジャージ服のみで)\n・右手に絵を描く用のペンを持っている\n・左手に何か食べ物を持っている\n・黒ネイル\n\n配信画面に表示するという都合で、背景透過がされているデータがあると嬉しいです。\n\n特に自分で作成した資料などがあるわけではないので、文面のみのリクエストですみません。\n内容については、このような感じで伝わりましたでしょうか。\nもし問題がなければ、どうぞよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1122989, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あおひと", "screen_name": "a_o_hi_to", "avatar_url": "https://pbs.twimg.com/profile_images/1835838387208790016/A7Kf4VLt.jpg", "header_url": "https://pbs.twimg.com/profile_banners/879977449798287360/1743255276/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 21, "skills": [{"genre": "art"}, {"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 32}, {"id": 1206862, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "団栗むい@イラスト依頼受付中", "screen_name": "donguri_noki", "avatar_url": "https://pbs.twimg.com/profile_images/2008867955887775746/BAz025Ug.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3186927925/1742203030/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 1937889, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "𓆟V", "screen_name": "Roy_Stringer_", "avatar_url": "https://pbs.twimg.com/profile_images/2053153031160758272/id-Mea5G.jpg", "header_u