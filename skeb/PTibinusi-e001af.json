こにひっかけた青い眼鏡がトレードマークで、服装は青い長袖のパーカーに黒いハーフパンツという格好を好んでいます。\nいつもけだるげにしていますが、ノリの良い性格でよく笑う子です。\n\n衣装のアレンジ・髪型のアレンジ大歓迎です！\n前述の2枚のようなテイストで描いていただければその他の事項はお任せしますが、クレーちゃんのイラストのような幸せたっぷりな笑顔系の表情・ポーズだと嬉しいです。\nアレンジの際、避けていただきたいものは以下のとおりです。\n・学生服等、制服に類するもの\n・ニーソックス\n（いろいろと面倒であれば、元の服装で描いていただければ問題ありません。）\n\n可能であればPSD等での納品とし、差分やラフ・別案がありましたら含めていただけると嬉しいです。\nいただいたイラストはSNS等のアカウントでアイコンやヘッダーとして使用することがあります。\nご検討の程よろしくお願いします！\n\nhttps://skeb.jp/@sunajiro8", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@PTibinusi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4095000, "client_id": 3221499, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12317f5e/uploads/origins/1c299803-57e7-4359-a6b9-4524f81b5e8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f837f8054b5e3727b2737d72ef98767", "srcset": "https://si.imgix.net/12317f5e/uploads/origins/1c299803-57e7-4359-a6b9-4524f81b5e8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f837f8054b5e3727b2737d72ef98767, https://si.imgix.net/12317f5e/uploads/origins/1c299803-57e7-4359-a6b9-4524f81b5e8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3807887d583a577b95044b30887ac5e 2x, https://si.imgix.net/12317f5e/uploads/origins/1c299803-57e7-4359-a6b9-4524f81b5e8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a679d756737338968cf3407b3771926 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12317f5e/uploads/origins/1c299803-57e7-4359-a6b9-4524f81b5e8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c459dcba11a4212ef7e26a2a7fc7a3db", "srcset": "https://si.imgix.net/12317f5e/uploads/origins/1c299803-57e7-4359-a6b9-4524f81b5e8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200