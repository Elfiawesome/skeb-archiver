ましたらぜひよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/19QkKn1xR_29nYlAJ9IfguFP1q4xPwEfV", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@PTibinusi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4095000, "client_id": 4120274, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac19e97c/uploads/origins/ce4894a0-64f4-485a-90a3-ca3590217609?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c4a06cbaee27816d8c6747a08d4e29f", "srcset": "https://si.imgix.net/ac19e97c/uploads/origins/ce4894a0-64f4-485a-90a3-ca3590217609?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c4a06cbaee27816d8c6747a08d4e29f, https://si.imgix.net/ac19e97c/uploads/origins/ce4894a0-64f4-485a-90a3-ca3590217609?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=983bdadca99f093b6576f1aaeacc2690 2x, https://si.imgix.net/ac19e97c/uploads/origins/ce4894a0-64f4-485a-90a3-ca3590217609?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2aa3fe49d4173286a3803b4d5056ef9e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac19e97c/uploads/origins/ce4894a0-64f4-485a-90a3-ca3590217609?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d15d93c6cc00a1d5741d20fc32bbc530", "srcset": "https://si.imgix.net/ac19e97c/uploads/origins/ce4894a0-64f4-485a-90a3-ca3590217609?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d15d93c6cc00a1d5741d20fc32bbc530, https://si.imgix.net/ac19e97c/uploads/origins/ce4894a0-64f4-485a-90a3-ca3590217609?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a3b955e8025aa208d70b1852562a6b55 2x, https://si.imgix.net/ac19e97c/uploads/origins/ce4894a0-64f4-485a-90a3-ca3590217609?bg=%23ff