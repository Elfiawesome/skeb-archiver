73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a30098269969f0b5a4112addb0acaa2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e9db2a6/uploads/origins/c676d9c4-4edc-4cb5-9a08-f3de242f2973?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ceef984d622283645e5f2d0f0cdb231c", "srcset": "https://si.imgix.net/2e9db2a6/uploads/origins/c676d9c4-4edc-4cb5-9a08-f3de242f2973?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ceef984d622283645e5f2d0f0cdb231c, https://si.imgix.net/2e9db2a6/uploads/origins/c676d9c4-4edc-4cb5-9a08-f3de242f2973?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f73fd1b15e19ec8561e642d6195fb26c 2x, https://si.imgix.net/2e9db2a6/uploads/origins/c676d9c4-4edc-4cb5-9a08-f3de242f2973?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2322f823f86b1aaa93ebfc5121360a8a 3x"}, "body": "ボージィ＆マスターの男勝ちのリクをお願い致します。\n\n\n1　ボージィがマスターにもし私が勝ったら二人でどこか出かけましょうとデートのお誘い\n\n2　接戦の末マスターの勝利。ボージィ閉じ目でダウン。目にうっすらと涙をためて\nダーリンのバカと悔しがってる\n\nこんな感じのイラストをお願い致します。\nボージィの目は「バニー女王ボージィが恋に落ちた瞬間」の時のリク絵みたいにややツリ目で宜しくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OOP59625265/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1315214, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5c0d8e4/uploads/origins/a1d244d0-0ed4-48a2-9a38-5c7819d193a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a06f48ce16a458ef7dabb3d33d62c447", "srcset": "https://si.imgix.net/c5c0d8e4/uploads/origins/a1d244d0-0ed4-48a2-9a38-5c7819d193a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a06f48ce16a458ef7dabb3d33d62c447, https://si.imgix.net/c5c0d8e4/uploads/origins/a1d244d0-0ed4-48a2-9a38-5c7819d193a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=676a6090e6796585a9c0503a1efa3f50 2x, https://si.imgix.net/c5c0d8e4/uploads/origins/a1d244d0-0ed4-48a2-9a38-5c7819d193a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=288ac9cebeb950b4f545859fc611674b 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5c0d8e4/uploads/origins/a1d244d0-0ed4-48a2-9a38-5c7819d193a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e4d2ab2671e05ab5525051d309aadb4", "srcset": "https://si.imgix.net/c5c0d8e4/uploads/origins/a1d244d0-0ed4-48a2-9a38-5c7819d193a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e4d2ab2671e05ab5525051d309aadb4, https://si.imgix.net/c5c0d8e4/uploads/origins/a1d244d0-0ed4-48a2-9a38-5c7819d193a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4a6508f94d4566698c1f7d9a4e3d4f16 2x, https://si.imgix.net/c5c0d8e4/uploads/origins/a1d244d0-0ed4-48a2-9a38-5c7819d193a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9fda5a04fb3ff83dfbf579bdc6a50e49 3x"}, "body": "初めまして、場違いさん。\n難しい内容になりますが、以前場違いさんが描いた「ゼルダ姫とお手合わせ」のイラストを元にした「ゼルダ姫とリンクのミックスボクシング」の小説をお願いします。\nストーリーは以下の形になります。\n(解釈違いがあると思いますので、不自然と感じたら改変して下さい)\nストーリー\nある日、ハイラル城の倉庫で見たことのない赤と青のグローブを見つけたゼルダ姫。\n　周りに聞いていくとこれがボクシングという「グローブを嵌めて、拳でお手合わせする」ものと知ったゼルダ姫。\nボクシングに興味を持ったゼルダ姫は、お手合わせ願おうと周りに声をかける。しかし、大変危険なもので恐れ多いと、皆に断られてしまう。リンクも話を聞く中で危険だと感じ、断ろうとするが、周りの懇願とゼルダ姫の強い意志の前に渋々承諾する。\n後日、城の中庭に用意されたリングに上がる二人。ノリノリな様子なゼルダ姫に対し、手加減しようと考えるリンク。\nそんなリンクの考えを見抜いたのか、ゼルダ姫はムスッとした表情になり、「私だってトレーニングしてるんです! 手を抜いたら 許しませんよ!」と全力でくるように宣言する。\n試合中\n　全力で戦うことが姫の望むことであると覚悟したリンクは、開始直後からゼルダ姫に容赦ないパンチを浴びせる。ゼルダ姫は何とか防御・回避するものの、徐々にパンチを浴びてしまう。身体中が痣だらけになり、何度も呻き声をあげ、ダウンを重ねるゼルダ姫。それでも立ち上がり、強がりの言葉を言い、ファイディグポーズをするゼルダ姫。\n殆どの攻撃や仕掛けはリンクに受け流され、一方的にパンチをもらうゼルダ姫だったが、苦し紛れに出したアッパーがリンクを捉える。\n喜びの表情を浮かべるゼルダ姫だったが、直後にボディーブローをもらってしまう。\nゼルダ姫は踏ん張ったものの、最初と変わらない様子のリンクを見て、完全に戦意を失い、降参する。\n試合後\n傷や痣だらけのゼルダ姫を医務室に運ぶリンク。やり過ぎたと考えたリンクだったが、ゼルダ姫はすぐに回復し、自室に招く。\nゼルダ姫は付き合ってくれたことへの感謝とリンクの強さを褒め称える。\n思わず照れるリンクにゼルダ姫はもっとお手合わせして下さいとおねだりする。\nその後、二人の関係にお手合わせが加わり、城の人々は困惑しながらも微笑ましく二人を見守った。\nよろしくお願いします。", "nc": 171, "word_count": 6943, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@OOP59625265/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2babde77/uploads/origins/2df33656-9479-471e-96cf-ea0a9288c750?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c02f5210e6e35ec4548b8d0608af906", "srcset": "https://si.imgix.net/2babde77/uploads/origins/2df33656-9479-471e-96cf-ea0a9288c750?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c02f5210e6e35ec4548b8d0608af906, https://si.imgix.net/2babde77/uploads/origins/2df33656-9479-471e-96cf-ea0a9288c750?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=551ee04560b9fd0e97f497bb66050c02 2x, https://si.imgix.net/2babde77/uploads/origins/2df33656-9479-471e-96cf-ea0a9288c750?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7fa7f48b13c6419ce600d0385dcb6ef4 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1315214, "client_id": 1453177, "nc": 48}, {"path": "/@OOP59625265/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1315214, "client_id": 2209738, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e1fab82/uploads/origins/010d2e96-41e0-4