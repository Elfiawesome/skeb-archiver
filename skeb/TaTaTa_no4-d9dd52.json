://si.imgix.net/40e0029d/uploads/origins/73c58dfa-b649-4919-8186-647f800867f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=326dc8a64a3c264777230d8b10f10d4b, https://si.imgix.net/40e0029d/uploads/origins/73c58dfa-b649-4919-8186-647f800867f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81d1c33484a05e08cc1b2ded294edeaf 2x, https://si.imgix.net/40e0029d/uploads/origins/73c58dfa-b649-4919-8186-647f800867f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b8e2f2137164a0c636b2276a65884663 3x"}, "body": "こんにちは！\nいつも素敵なイラスト拝見させていただいております。\nたのしさんの絵柄で描いていただいた自キャラがみたいな～！と思い依頼させていただきました！\n\n描いていただきたいのは自キャラです。\n資料は下部にGoogleドライブのURLを置いています。\n（足りなければXにSSを上げてるのでそちらもご確認ください…！）\n\n・全身ではなくてバストアップで大丈夫です。\n・前の世界では満点の笑みが似合う子でしたが、こっちではお淑やかさに磨きがかかりました。\n・シチュエーション、アレンジ等お任せいたします。\n（資料のドレスだけ抑えて頂ければ、他はBP時代の髪形とか目とかでも大丈夫です！お好きなイオナをお描きください！）\n・Xのアイコン等に使用したいです。\n\nよろしくおねがいいたします！\n\nhttps://drive.google.com/drive/folders/1VKkyxDMbHSNVLe0K04W9SaYLh7dXkGLS?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TaTaTa_no4/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2617248, "client_id": 2855610, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/02a22291/uploads/origins/c658e199-4852-48e8-9c13-64a2df6193e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6f5a770a56df23f46e0f85daf7b68b9", "srcset": "https://si.imgix.net/02a22291/uploads/origins/c658e199-4852-48e8-9c13-64a2df6193e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6f5a770a56df23f46e0f85daf7b68b9, https://si.imgix.net/02a22291/uploads/origins/c658e199-4852-48e8-9c13-64a2df6193e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed508e388e3e3462373a948dd19e0772 2x, https://si.imgix.net/02a22291/uploads/origins/c658e199-4852-48e8-9c13-64a2df6193e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f087f481a583e224c5572a74e9efe8e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/02a22291/uploads/origins/c658e199-4852-48e8-9c13-64a2df6193e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e77cee9f1de3e2c99a54b78857b02f4", "srcset": "https://si.imgix.net/02a22291/uploads/origins/c658e199-4852-48e8-9c13-64a2df6193e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e77cee9f1de3e2c99a54b78857b02f4, https://si.imgix.net/02a22291/uploads/origins/c658e199-4852-48e8-9c13-64a2df6193e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7e20e064c5553129a4c09884e0aca384 2x, https://si.imgix.net/02a22291/uploads/origins/c658e199-4852-48e8-9c13-64a2df6193e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=263564bb87a5ac55a615318440e8ca57 3x"}, "body": "お世話になっております！\nたのしさんにオリキャラを描いていただきたいです。\n設定画は以下になります。\nhttps://drive.google.com/file/d/1FLXP5cc37kh8YUMhLTvY1wwQgEZeiWJ7/view?usp=drivesdk\nアニメーション用に作ったキャラクターで、ベネチアのような水辺の街に住んでいる設定です。\n女の子は街のパン屋さんの娘で、男の子は街の神様が人に化けた姿です。\n画像には2人載っていますが、どちらか1人だけでも全然大丈夫です！\nシチュエーションなどはお任せしますので、描きやすいようにお願い出来ればと思います。アレンジなども自由にして頂いて問題ございません！\nどうぞよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TaTaTa_no4/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2617248, "client_id": 645067, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e05914fa/uploads/origins/aa78343f-3a13-497d-91ea-6dd1935d182a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c40631b69031f1fe51fdf25fe739ad3d", "srcset": "https://si.imgix.net/e05914fa/uploads/origins/aa78343f-3a13-497d-91ea-6dd1935d182a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c40631b69031f1fe51fdf25fe739ad3d, https://si.imgix.net/e05914fa/uploads/origins/aa78343f-3a13-497d-91ea-6dd1935d182a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71bce67f32b3617da450d48adb614f6d 2x, https://si.imgix.net/e05914fa/uploads/origins/aa78343f-3a13-497d-91ea-6dd1935d182a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a46d040012b78de6c5d221eeb5421a7e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e05914fa/uploads/origins/aa78343f-3a13-497d-91ea-6dd1935d182a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60f0cfd72c7857a786170af8195f0adf", "srcset": "https://si.imgix.net/e05914fa/uploads/origins/aa78343f-3a13-497d-91ea-6dd1935d182a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60f0cfd72c7857a786170af8195f0adf, https://si.imgix.net/e05914fa/uploads/origins/aa78343f-3a13-497d-91ea-6dd1935d182a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cec6ea2ec2c157f696544739e49972de 2x, https://si.imgix.net/e05914fa/uploads/origins/aa78343f-3a13-497d-91ea-6dd1935d182a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=693b3ed61510de0fe3453d73cfc04438 3x"}, "body": "お久しぶりです！また足フェチなイラストを見たくなってご依頼致しました。\n今回は雪崩サツキさんの足フェチなイラストをお願いします。\n\n:構図\n・構図は資料URLの様なポーズでお願いしたいです！\n・お願いしたい事\n○自分が足フェチなので足裏をメインに描いて頂きたいです！\n○夏で暑すぎてたまらず靴を脱いだ感じで、\n生足verとパンストver(ブラウンかベージュ色)をお願いしたいです。\n\n・表情\n　表情はお任せ致します！\n\n・仕様用途\n　部屋に飾るか壁紙に使いたいです。（できれば高めの解像度でお願いします。）\n\n最近暑すぎておかしくなるような気温が続きますが、\n体調に気をつけてこれからも頑張って下さい！応援してます！\n《TN4/たのしさんの足フェチイラストで癒やされ隊》\n\nhttps://smallpdf.com/jp/file#s=b9d10c16-bf92-4463-b7e2-401e4f7db79a", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TaTaTa_