ので、お好きに描いていただけますと幸いです。\n\n▶︎使用用途\n・SNSのアイコンやヘッダー、PC・スマホの壁紙としての個人利用\n・アクリルキーホルダーや本など、個人鑑賞目的でのグッズ作成\n・今後skeb等依頼する際の参考資料としての活用\n\n▶︎その他\nキャラクターと背景等を分けたPSD形式のイラストだと嬉しいです。\nまた、ラフ段階のイラストや没になったもの等がありましたら、残していただけると嬉しいです。\n\nご依頼内容や金銭面で不明点や問題がある場合は、遠慮なく再送・キャンセルしてくださいませ。\nご多忙のところ恐れ入りますが、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1rgYSATJw8mpebrRGlsFzXCUWoEWs_x0a", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 486211, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "メロ無", "screen_name": "meromuri", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F96b35025-5aa1-4eae-8811-4ef81c6e4bd0.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/236eab24-edbe-467f-b382-5b3c52bc1b5b.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id": 2620286, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "いかわさ🦑(チゲ味)", "screen_name": "Midori_annte23", "avatar_url": "https://pbs.twimg.com/profile_images/1772462509385269248/3WO5dS3i.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1288136668696809473/1711452276/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 110, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 3125879, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "submellow", "screen_name": "mellow_chan", "avatar_url": "https://pbs.twimg.com/profile_images/1996939131377930240/8