ドはあまりぴっちりさせないで欲しいです。レオタードのぴっちり度は上記のリンクのスク水くらいにして欲しいです\n\n・可能であれば正面部分はおへそ位の位置まではレオタードが見えるようにして欲しいです。こちらの指定は前部分だけで大丈夫です。例えばスカートやマント等で後ろや横方向から見たらレオタードが見えない、というようなデザインになっても大丈夫です。もちろん全方向でレオタードが見えるようなデザインでもOKです\n\n・使用用途ですが他の人に依頼する際の服装の参考画像として使用したいです\n\n以上です", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kikuzaki_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1330207, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/622e5aee/uploads/origins/e1c22755-b602-4363-be83-05717021aaad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65fc55b5576b31b75d9c8c5ef26d6af1", "srcset": "https://si.imgix.net/622e5aee/uploads/origins/e1c22755-b602-4363-be83-05717021aaad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65fc55b5576b31b75d9c8c5ef26d6af1, https://si.imgix.net/622e5aee/uploads/origins/e1c22755-b602-4363-be83-05717021aaad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3dcd98033da5f7f022d0be6ff95cedf 2x, https://si.imgix.net/622e5aee/uploads/origins/e1c22755-b602-4363-be83-05717021aaad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fd3a85a9fb77ec2d599b3b1c55238dd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/622e5aee/uploads/origins/e1c22755-b602-4363-be83-05717021aaad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29e96bc11775cfd1c1f21dcda87b71f3", "srcset": "https://si.imgix.net/622e5aee/uploads/origins/e1c22755-b602-4363-be83-05717021aaad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29e96bc11775cfd1c1f21dcda87b71f3, https://si.imgix.net/622e5aee/uploads/origins/e1c22755-b602-4363-be83-05717021aaad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=2