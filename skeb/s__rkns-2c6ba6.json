bmlyLUJsYWNr&txtfit=max&txtalign=middle%2Ccenter&txtsize=60&txtshad=10&auto=format%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=274c0be4763e59f2714bfb0d2f83f248", "skills": [{"genre": "art", "default_amount": 10000}, {"genre": "comic", "default_amount": 10000}], "payment_methods": {"credit_cards": {"jcb": {"nsfw": true}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@s__rkns/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 673256, "client_id": 2770414, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ff8a3b1/uploads/origins/f33ba80a-e056-47cb-b611-151d8d397715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61ee76e2536ce02824240bc09fb85796", "srcset": "https://si.imgix.net/4ff8a3b1/uploads/origins/f33ba80a-e056-47cb-b611-151d8d397715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61ee76e2536ce02824240bc09fb85796, https://si.imgix.net/4ff8a3b1/uploads/origins/f33ba80a-e056-47cb-b611-151d8d397715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f587a6f7a10c4e053e8d19cb6b360222 2x, https://si.imgix.net/4ff8a3b1/uploads/origins/f33ba80a-e056-47cb-b611-151d8d397715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=922adbffc2804ce376a5073e4e8dab4c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ff8a3b1/uploads/origins/f33ba80a-e056-47cb-b611-151d8d397715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c90b5e76aa8fb1b2662527ad8e9f03ab", "srcset": "https://si.imgix.net/4ff8a3b1/uploads/origins/f33ba80a-e056-47cb-b611-151d8d397715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c90b5e76aa8fb1b2662527ad8e9f03ab, https://si.imgix.net/4ff8a3b1/uploads/origins/f33ba80a-e056-47cb-b611-151d8d397715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f81beba9d0f254d0238fc1b898fb5b5e 2x, https://si.imgix.net/4ff8a3b1/uploads/origins/f33ba80a-e056-47cb-b611-151d8d397715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a860df729c474a2736c26d7188e358d1 3x"}, "body": "すすけさまこんにちは、ごまあざらしと申します。\n先月“影射”をHO1で通過させて頂き、シナリオの構成とNPCたちの魅力に見事にハマりとても楽しい時間を過ごすことができました。素敵なシナリオを公開してくださってありがとうございます❣️\n今回は、そんな影射HO1とNPCの絡みのあるイラストを依頼したいと思いご連絡させていただいております。\nお忙しいとは思いますが、ご検討いただけますと幸いです！\n\n【依頼内容】\n影射HO1と九子NPCのイラスト。\nどのNPCでも嬉しいのですが、本編中絡みが少なめだったヒキ/チフン辺りだと嬉しいです…！(とはいえ、後の資料を見て他のNPCとの絡みの方が描きやすそうであればそちらでも構いません！◎)\nシチュエーションや構図はお任せいたします。\n※可能であれば、psdデータで納品していただけると嬉しいのですが、難しいようでしたらすすけさまの納品しやすい形式で構いません。\n\n【使用用途】\n・個人鑑賞、自陣への共有\n・IDを記載した上でのSNSへの掲載(ネタバレありの場合はポイピクなどでワンクッション挟みます。)\n・鑑賞目的の印刷、非商用のグッズ作成\n\n【キャラクター詳細】\n◇ 影射HO1\n名前：俊瀚（ジュンハン）\n九子名：狴犴(ヘイカン)\n136歳/130cm/男\n好き：うまいメシ、HO2とHO3とのおしゃべり、自分と仲良くしてくれるやつ\n嫌い：ナメられること、デカい音、匂いの強すぎるもの\n趣味：特にないが、HO2HO3がすくすく成長していくのを見るのは好き。だから趣味は人間の成長観察？\n\n◇NPCへの印象\nヒキ：ばーちゃん\n🐯(PC)おっかないけど強い人だと思っている。ばーちゃんがいたらあと数百年は安泰だな！\n🦭(PL)九子になりたての時は敬意なく“おばちゃん”とか呼んで盛大にゲンコツくらったことがありそう。チビの頃から自分を見てくれているので、母というより本当におばあちゃんみたいな立ち位置。小さい頃からたま〜にお茶とか飲んでたら嬉しい。\n\nチフン：チィ兄\n🐯チィ兄と一緒に天体観測するの好き！という感じで結構懐いている。\n🦭ダイスの結果、弊HO1が九子になったのは13歳の頃らしいので、最初期は身体の大きさとあまりの喋らなさにビビっていそう。チフン側が気を利かせて天体観測とかに誘ってくれてたらじわじわ懐いていく。膝の上とかに乗っけて貰って一緒に星を見たいです(ド願望)\n\nホロウ：ホロウ\n🐯あんま好きじゃない、ナメられているように感じるので。オレの方が強いんだが〜？！\n🦭良きライバル。九子に来た順番的にはヘイカンの方が先輩だけど、お互いがお互いの事を舐めあってよく競っていると思います。本編中でも「どっちが多く狩れるか勝負だ」みたいなRPをしたので…(ヘイカンが勝ちました✊)\n\n狴犴(ヘイカン)：オレ\n→言うことなし\n\nトウテツ：テツ\n🐯うまいメシ連れてってくれるから嫌いじゃない。チィ兄と同じくらいの懐き方。\n🦭本編中基本ずっとメシの話してたな…。\nヘイカン→トウテツの印象は、身体がでっかくて心の広い弟分。なるべく守ってやらなくちゃな、と思ってる。兄貴ヅラしたいだけです。\n\nハカ：ハカ\n🐯ナメられているわけではなく、そういう性分なのは理解しているがどうにもむず痒さがある。嫌いではない。\n🦭本編中のHO1へのRPを見るにかなり気にかけてもらっているようで、黒髪赤目好きのPL、大歓喜＿＿…\nハカに揶揄われたヘイカンが「うるせージジィ！」とキレたのはいいけど、普通に言い負かされてぐぬ…となった   みたいなRPが本編中に発生していたので、なんだかんだ勝てないんだろうな…と思っています。\n\nガイサイ：ガイサイ\n🐯いつも血の匂いを振り撒いているからあまり好きじゃない。というか突っかかってくんな！負けるクセに！！！\n🦭嫌いじゃないけど、自分から積極的に関わりはしない…と思ってたら本編でめちゃくちゃ大変な目に巻き込まれておりてんやわんやで応急処置を施した記憶があります。HO2を勧誘した事実を知ったら全然ヘイカンから喧嘩ふっかけてボコボコにしてると思う。\n\nサンゲイ：サン/サンちゃん\n🐯嫌いではないが、花火だったり煙管の煙の匂いだったりで苦手な部類。自分から絡みにいくことは滅多にない。\n🦭本編でめちゃくちゃいい子だ！というのが分かり、初期印象からちょっと柔らかくなった印象を持っています。とはいえとつぜん花火打ち上げられると普通にビビる。きゅうり見た時の猫みたいな飛び方してそう。\n\nショウズ：おズゥ\n🐯自分が大先輩なわけではないが、一生懸命頑張っているのは把握しているので応援している。困っていそうなら手助けもする。\n🦭ショウズ〜；；助けてあげたかったよ〜〜；；九子所属順的な意味ではもちろん、年齢で見ても自分より後輩だって知っていたのでPLもPCも助けてあげられなかったことを結構悔しく思っています。\n一緒にいた時間の中で本借りたりだとか、知恵を借りたりだとかでよくお話してたらいいな…｡\n\n【立ち絵資料】\n立ち絵の資料(ディスプレイ、透過全身、その他性格面で参考になりそうなHO1の資料(ふせったースクショ)など)を入れております。\n細かい部分は省略・変更していただいて構いません。\n\n・\n\nお任せする点が多く大変申し訳ありません。 資料不足や金額的に難しければキャンセル・もしくは再送していただければと思います。\nお忙しいかとは思いますが、ご検討いただけますと幸いです。  \n\n長々と失礼いたしました。ご縁がありましたら、よろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1alCRtCQT4u3TcBwS41iGwFEkkelBr-R7", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@s__rkns/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 673256, "client_id": 3916340, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28d4fa3e/uploads/origins/219e83ca-ed9e-4cdb-b633-9059dd22d62c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dcf42d6e37c41fdeb94e86cedbd347f", "srcset": "https://si.imgix.net/28d4fa3e/uploads/origins/219e83ca-ed9e-4cdb-b633-9059dd22d62c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dcf42d6e37c41fdeb94e86cedbd347f, https://si.imgix.net/28d4fa3e/uploads/origins/219e83ca-ed9e-4cdb-b633-9059dd22d62c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=785d9a3c4a61198cc08a7d47d15bb290 2x, https://si.imgix.net/28d4fa3e/uploads/origins/219e83ca-ed9e-4cdb-b633-9059dd22d62c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0dc1b98dbb1e4ef311155d6e6fe85b5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28d4fa3e/uploads/origins/219e83ca-ed9e-4cdb-b633-9059dd22d62c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0043b013a64e346ff557852684aa86b", "srcset": "https://si.imgix.net/28d4fa3e/uploads/origins/219e83ca-ed9e-4cdb-b633-9059dd22d62c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0043b013a64e346ff557852684aa86b, https://si.imgix.net/28d4fa3e/uploads/origins/219e83ca-ed9e-4cdb-b633-9059dd22d62c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0d13262d9276b96caaad78f50121429e 2x, https://si.imgix.net/28d4fa3e/uploads/origins/219e83ca-ed9e-4cdb-b633-9059dd22d62c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=01821f0866d7e47195d34abe0e4f83da 3x"}, "body": "こんにちは。みはる、と申します。 セリフミスがあり訂正しました。申し訳ありません。\n\n影射を「刃」として回らせていただきました。アウトロー中華の雰囲気、とても良かったです。NPC達も魅力的でした。刃として、ガイサイがとても大好きで、作者様がコミックをかかれているとの事で頼みたいと思いました。\n\n  以下、書いていただきたい希望です。作者様のやりやすいようにして頂いて構いません。 \n\n 私達の陣ではガイサイが亡くなってしまいました。（エンド1-α） 途中PC達と分断され蛇に連れ去られて、片腕を亡くしたガイサイが共闘してくれるシーン。途中でほいちのところに行ってくださいと言われ「しぬなよ。」と残してほいちの元へ走りました。そこでKPが一方その頃、ということでガイサイが亡くなったシーンをアドリブで入れてくださいました。（PCはその場で知ることはなく、最後の会食時にガイサイがいないのをみて、アイデアに成功しあの時1人にしたからだろうなと言うのを察しました。） \n\n 蛇や構成員と戦ったが、片腕だけでは攻防に耐えきれず、蛇の尾がガイサイを吹き飛ばし壁に押しやられた。  \n\n…すみません。シュエファくん…生きろと言われたのに約束、守れそうにありませんね。\n\nもっと遊びたかったな、\n\n  と言われ、血溜まりの中息を引き取りました。セリフは作者様が思うセリフにして構いません。呼び方は「シェファ（雪樺）くん」でした。  \n\nほんとに一コマ回想いれてくれたら嬉しいなと言うてんで、あげると、最初の会食でガイサイに「それ、ください。」「あなたが食べているものの方が美味しそうだから。」と、話しかけられました。少し考えた後、食べていたものをあげると、「…あまり変わりませんね」と言われ席へ戻っていきました。\n\n  というガイサイが刃に懐いている、気に入っている様子がとても可愛かったので、裁量でいれていただけるととても嬉しいです。  \n\n本当に影射、感動しました。刃として虎、灯どちらも大好きです。素敵なシナリオをありがとうございました。   \n\n▼使用用途 ・個人鑑賞(片方のキャラクターを描いた友人やKPへの共有)  ・個人の範囲内での使用(アイコン使用、グッズ作成等。使用の際はお名前を記載させていただきます)   構成、衣装の簡略等お任せします。ご縁がありましたらよろしくお願いします  \n\n資料URLについて（1.2.3全てあります。出せそうだったらフレーバーとして出してくれると嬉しいですが、メインは刃とガイサイで大丈夫です。雰囲気の認識でお願いします）  \n\nHO刃 シュエファ（白髪の子）  \n・18歳 184cm  無口で口下手である。思春期なので、ほいち、ほさんに対しては少し対応が困っているものの、2人が大好きで2人を守りたいと思っている。捨てられないために。みんなで生きるために。 ガイサイに対しては非常に心を許している。「力こそ自分を信じるもの」である認識であるため、ガイサイのスタンスは信じやすい。血の契りを断っており、遊びは趣味は悪いと思っているが、本能のままに生きる姿を尊敬している。最後は自分があの場に残っていれば、と少し後悔をした。ほいちやほさんと共に後に花を手向けに行こうと言う話をした。非常に無知。無知であり、視力がないことを申し訳ないとも思っているが、気弱な訳ではない。2人の邪魔をするものは薙ぎ払うつもりで生きてきた。意外と情に熱いが思春期なこともありあまり顔に出ない。返事は頷くだけだったりする。喋るのはほいちほさん、ガイサイくらい。\n\n  （フレーバー）\n\n ・HO虎 フウファ（茶髪インナー黄色の子） 猫みたいなひと。顔の表情はあまり変わらないが、耳やしっぽで感情がよく分かる。距離感が近い。よく撫でようとしてくるのでシュエファはなんとも言えない気持ち。絶対に死なせない。とおもっている。  \n\n・HO 灯 ユエファ（ピンク髪の子）23歳 兄貴と呼んでいる。小さいころはにいちゃんと呼んでいたので、呼んでくれないのかとたまにつつかれる。最初に手を伸ばしてくれた恩人。虎のことも大切だが、兄弟のような気持ちなのでやはり1番先に手を伸ばす。よく撫でられたりご飯をもらう。フウファよりは撫でるのを許している（男なこともある。）\n\nhttps://drive.google.com/drive/folders/1qm_zRfXJSX45iP1IM7qsCHfsJoBoATDv", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@s__rkns/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 673256, "client_id": 1533673, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe03507c/uploads/origins/694f2ff0-3790-40a2-9d23-fb0f2d75252b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d57730e046122ee17e54d6febebffed8", "srcset": "https://si.imgix.net/fe03507c/uploads/origins/694f2ff0-3790-40a2-9d23-fb0f2d75252b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d57730e046122ee17e54d6febebffed8, https://si.imgix.net/fe03507c/uploads/origins/694f2ff0-3790-40a2-9d23-fb0f2d75252b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b291528b5f6e378026544520d73c5e1 2x, https://si.imgix.net/fe03507c/uploads/origins/694f2ff0-3790-40a2-9d23-fb0f2d75252b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=232a018089e65121f627c8b61407237f 3x"}