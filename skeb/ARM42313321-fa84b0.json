1-5859d5661796?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=556bd84075e07eb5c0c7aa74c7e977fa 3x"}, "body": "はじめまして。\nこの度はあるまじろ様に私のOCと男性キャラクター(原案：Mikei (Booth https://mikei.booth.pm/ )様)の絵を描いていただきたくリクエストさせていただきました。\n\nテーマは【舞台袖】\n２人の関係性はアイドルとマネージャーです。\nイラスト資料はGoogle driveにてまとめております。\n資料につきまして、アイドルは衣装差分がありますが描かれるイラストの雰囲気に応じていずれかを描いてくださると幸いです。\n\nリクエスト内容が意向にそぐわない場合、気にせずキャンセルくださればと思います。\nよろしくお願いいたします。\n\n▼使用用途\n・個人的に観賞用として楽しむ\n\n▼キャラクター像\nアイドル：普段はおとなしいクールな雰囲気をまとった子。アイドルをしているとき、美味しいご飯を食べたときに表情筋が動きます。\nマネージャー：保護者のような雰囲気をまとった方。マネージャーとしての責任感を持ち、アイドルに対しては優しくいてくれる方です。\n\nhttps://drive.google.com/drive/folders/1JJOlKk_P_8Oq8EK1fBiozOmUgrQ72DiQ?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@tonnkatuman/works/125", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 425079, "client_id": 3691402, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3fa63a12/uploads/origins/57016cf3-2cd1-4c57-b6ce-f06867b6a74b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d600402780550067b0ddd4ede1c6d9ca", "srcset": "https://si.imgix.net/3fa63a12/uploads/origins/57016cf3-2cd1-4c57-b6ce-f06867b6a74b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d600402780550067b0ddd4ede1c6d9ca, https://si.imgix.net/3fa63a12/uploads/origins/57016cf3-2cd1-4c57-b6ce-f06867b6a74b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f670601a02a9f8837eee3f297adcb378 2x, https://si.imgix.net/3fa63a12/uploads/origins/57016cf3-2cd1-4c57-b6ce-f06867b6a74b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8e11ccee8905679bedac8a485178948 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3fa63a12/uploads/origins/57016cf3-2cd1-4c57-b6ce-f06867b6a74b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4bdfaad84a1290761ddcc52fa433dd7", "srcset": "https://si.imgix.net/3fa63a12/uploads/origins/57016cf3-2cd1-4c57-b6ce-f06867b6a74b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4bdfaad84a1290761ddcc52fa433dd7, https://si.imgix.net/3fa63a12/uploads/origins/57016cf3-2cd1-4c57-b6ce-f06867b6a74b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0d13dadbbe27dd872b703fa8b523fad8 2x, https://si.imgix.net/3fa63a12/uploads/origins/57016cf3-2cd1-4c57-b6ce-f06867b6a74b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6e8df8b44c99f9ced3671ff3d742e9e 3x"}, "body": "はじめまして。あるまじろと申します。\n胡桃炸裂症候群を通してチャピヲ様を知り、イラスト等楽しく拝見させて頂いております。\nこの度、7月をもちまして胡桃炸裂症候群を通過して1周年が経ちました。\nですので、チャピヲ様のイラストで自陣PC達の1枚絵を依頼したく存じ上げます。\n初skebの為ご不便な点が多いと思いますが、どうぞよろしくお願いします。\nこのイラストは同卓したPL様とKP様に共有する予定です。\nお忙しい中、恐れ入りますがよろしくお願いいたします。\n\n（構図、シチュエーション）\n構図等細かい部分は全てお任せしたいと思っております。\n服装も情報やイラスト等に載せているのですがチャピヲ様にお任せしたいと思っております。\nコミカルなシチュエーションもかっこいいシチュエーションも出来る自陣なのでチャピヲ様のお好きな通りに自由な解釈で描いていただけると幸いです。\n\n\nキャラの細かい設定、資料等は以下にまとめております。↓\n\n（関係性）\nHO公安がHO刑事に振り回されているが、なんやかんやHO公安は満更でもなさそう。\n様々な経験を経て現在交際中。\nお互い貶しあったりするが、なんやかんや信頼できるパートナーである。\n\n\nHO公安 \n名前:有馬 薫(ありま かおる)\n性別:男\n年齢27歳\n身長:183cm\n髪:緩やかな癖毛 ボブ→ポニーテール(現在)\n目:タレ目気味、瞳孔が白色のひし形\n眉:若干太め\n服:グレーのスーツ、暗めの赤のネクタイ→白シャツにハーネスベルト(現在)\nその他:体格は\nモチーフ:特になし\n\n性格等\n強面で怒っていると勘違いされることもしばしば。\n見た目とは裏腹に仕事熱心で人情に厚いタイプである。\n兄妹が沢山いるので面倒見がとてもよくお節介焼き。料理が得意。\n相方がヘンテコなおにぎりを作るので毎回怒っていたが最近は諦めて呆れている。そのせいで胃が強くなった不憫な男。\n一人称、俺\n\n\n\nHO刑事\n名前:倉実 樂(くらみ らく)\n性別:男\n年齢28歳\n身長:174cm\n髪:→ストレートのポニーテール→ショートボブ(現在)\n目:つり目\n眉:細め\n服:スーツ→グレーのシャツに黒のネクタイと黒のサスペンダー(現在も変わらず)\nモチーフ:くるみ割り人形からフリッツ\n\n性格等\nクソガキ。\nだが、戦闘や危機的状況に陥った時の真剣な表情や行動が普段とのギャップがある男。(HO公安PLの所感)\nしかし、変なおにぎりを手当り次第に作るので周りからは変な目で見られているのには変わりなく、HO公安も変なおにぎりさえ作らなければマシなのになと思っている。\n\n特技 クソデカイ(変な)おにぎりを作ること。(例:ホットケーキミックス入りおにぎり、シャーベットおにぎり、オムライスおにぎりetc.)\n一人称、俺\n\nhttps://drive.google.com/drive/