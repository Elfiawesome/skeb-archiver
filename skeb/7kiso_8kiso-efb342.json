止しようとしている、少しコミカルさのある\n修羅場寄りのシチュエーションを希望します。\n\n服装：\n沖田さん：浅葱の羽織袴\n藤丸くん：メイド服\n\n構図などの細かい部分はお任せいたします。\n\nご検討いただけましたら幸いです。\nよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7kiso_8kiso/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3819223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e9fdda8/uploads/origins/5a0e9f3b-6f71-4069-8e15-b6365a09df06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ee969b6b425c57ee4d9bd903841742b", "srcset": "https://si.imgix.net/4e9fdda8/uploads/origins/5a0e9f3b-6f71-4069-8e15-b6365a09df06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ee969b6b425c57ee4d9bd903841742b, https://si.imgix.net/4e9fdda8/uploads/origins/5a0e9f3b-6f71-4069-8e15-b6365a09df06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=821c1cd109aed7f6cf1c9f5b8b161e05 2x, https://si.imgix.net/4e9fdda8/uploads/origins/5a0e9f3b-6f71-4069-8e15-b6365a09df06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a764737f3a5f56ec18caba58310a524 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e9fdda8/uploads/origins/5a0e9f3b-6f71-4069-8e15-b6365a09df06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e62f89f7203c72c675fe26207ae6497", "srcset": "https://si.imgix.net/4e9fdda8/uploads/origins/5a0e9f3b-6f71-4069-8e15-b6365a09df06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e62f89f7203c72c675fe26207ae6497, https://si.imgix.net/4e9fdda8/uploads/origins/5a0e9f3b-6f71-4069-8e15-b6365a09df06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c8630c6970da7efb35acc5602192b878 2x, https://si.imgix.net/4e9fdda8/uploads/origins/5a0e9f3b-6f71-4069-8e15-b63