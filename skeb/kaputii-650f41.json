n_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@kaputii/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2399, "client_id": 2055516, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf141686/uploads/origins/c18e6722-80ce-4be5-9182-2a39494b4fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff165d167486bca14d602b4ed2bdd9ef", "srcset": "https://si.imgix.net/cf141686/uploads/origins/c18e6722-80ce-4be5-9182-2a39494b4fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff165d167486bca14d602b4ed2bdd9ef, https://si.imgix.net/cf141686/uploads/origins/c18e6722-80ce-4be5-9182-2a39494b4fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=919856058f94d853c168c36f1ac01c92 2x, https://si.imgix.net/cf141686/uploads/origins/c18e6722-80ce-4be5-9182-2a39494b4fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22019e8e4c0ae17fa9fd807ddc630b02 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf141686/uploads/origins/c18e6722-80ce-4be5-9182-2a39494b4fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5da6a81ca34e0a13444b3ab29273ec6b", "srcset": "https://si.imgix.net/cf141686/uploads/origins/c18e6722-80ce-4be5-9182-2a39494b4fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5da6a81ca34e0a13444b3ab29273ec6b, https://si.imgix.net/cf141686/uploads/origins/c18e6722-80ce-4be5-9182-2a39494b4fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=430549afbdf04a2f9b0acdeca00e9348 2x, https://si.imgix.net/cf141686/uploads/origins/c18e6722-80ce-4be5-9182-2a39494b4fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2fea4e7f0052c8e8b4b4e9d471c13a0f 3x"}, "body": "南瓜かぷちー先生　こんにちは\n\n先生の描かれるイラストはどれもとっても可愛くて、日々の癒しとなっています！特に幽々子様と妖夢とのやりとりが大好きで、新作を毎回楽しみにしています！！\n募集開始の通知を見かけて、嬉しくて早速ご依頼を決めました\n\nご依頼したいイラストですが、二次創作となります。個人勢Vtuberのモカ＝ブランシェさんのファンアート(FA)を描いて頂きたいです\n\nガイドラインより、Skeb依頼が可能であることを確認しています\nhttps://mokablanche511.wixsite.com/moka-blanche/%E3%82%AC%E3%82%A4%E3%83%89%E3%83%A9%E3%82%A4%E3%83%B3\n\nイラストの内容ですが\n実際に現役バリスタとして勤務している方で、配信スタイルも挨拶が「いつもの」や「ご来店いただきありがとうございました」などカフェスタイルとなっています\nなので、自身が所有するカフェでバリスタとして働いている感じのイラストを描いていただきたいです\n\n詳細については\n・衣装は本人イラストのもの(資料URLは最下部記載)\n・ポーズや背景その他については、全てお任せいたします\n・サインとコメントがないバージョンの作成又は、レイヤーを分けていただけると幸いです\n・可能でしたら肩にいるハリネズミキャラ(ラテくん)もイラストに取り込んでいただけると嬉しいです\n・PCの壁紙として使用したいので、縦横比16:9で描いていただけると嬉しいですが、先生のイラストの世界観が大好きなので、描きにくいなどありましたら16:9でなくても差し支えありません。先生の世界観を優先なさってください\n\n使用用途はSkeb利用規約にある個人鑑賞用途の他に、FAタグを付けてXに投稿を考えております\n\n※FAは本人(モカ＝ブランシェ)の配信のサムネイル画像などに使用される可能性があります※\n使用可能範囲は配信のサムネイル、SNSのアイコンとしての使用のみに限定し、グッズ化などの商用利用は不可と本人に伝えます\n(過去FAがグッズ化などの商用利用がされたことはありませんが、念の為本人に伝えます)\nまたサムネイルなどに使用した際は、クレジット表記(著作者名,XIDなど)を明記するように伝えます\n\n上記についてご留意いただき、ご判断よろしくお願いします\n\nhttps://drive.google.com/drive/folders/1kxloBVuWAVZSB3pWx6_hODPaeTPChxAu?usp=sharin", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kaputii/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2399, "client_id": 8832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be51f92a/uploads/origins/90f48b36-3321-48e3-806f-3cce56757a89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c6c570a53e5c1518abc39f103006553", "srcset": "https://si.imgix.net/be51f92a/uploads/origins/90f48b36-3321-48e3-806f-3cce56757a89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c6c570a53e5c1518abc39f103006553, https://si.imgix.net/be51f92a/uploads/origins/90f48b36-3321-48e3-806f-3cce56757a89?bg=%23ff