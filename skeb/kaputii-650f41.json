ploads/origins/82d69036-73c7-4f47-bb50-3b16adeea642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebbaf9865adc59e2975908d500cac370 2x, https://si.imgix.net/6a992dc8/uploads/origins/82d69036-73c7-4f47-bb50-3b16adeea642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=698aa86aa47d647a2378d441fe95eba5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a992dc8/uploads/origins/82d69036-73c7-4f47-bb50-3b16adeea642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0013521e2f43814113593d01cbe7602d", "srcset": "https://si.imgix.net/6a992dc8/uploads/origins/82d69036-73c7-4f47-bb50-3b16adeea642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0013521e2f43814113593d01cbe7602d, https://si.imgix.net/6a992dc8/uploads/origins/82d69036-73c7-4f47-bb50-3b16adeea642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3faeeab82916255b88b0d2bdea6b49ef 2x, https://si.imgix.net/6a992dc8/uploads/origins/82d69036-73c7-4f47-bb50-3b16adeea642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=42c5292f487eb9524144094d7bceb66c 3x"}, "body": "南瓜かぷちー様\nはじめまして　アスタリスクと申します。\nいつも素敵なイラストを陰ながら拝見しております。\n今回思い切ってSkebを依頼してみたいと思い、リクエストを送らせていただきました。\n初になりますので拙い文章ですが、ご容赦いただけますと幸いです。\n\nイラストの内容ですが、東方Projectの西行寺幽々子と魂魄妖夢がお茶屋の床几に座ってお団子を食べているイラストをお願いします。\n\n・床几は赤色\n・服装は2人とも原作通りの西行寺幽々子は着物、魂魄妖夢はベストとスカート\n・背景は季節の先取りになってしまいますが、春をイメージした感じ(桜の木など)\n\n表情やポーズなどはお任せいたします。\n使用用途はPCの壁紙として使用します。\n\nご検討のほどよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kaputii/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2399, "client_id": 904824, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7579c73b/uploads/origins/3233e414-59ca-4cb8-9096-44878f4effa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5822555ab56b5904616d92990acac64", "srcset": "https://si.imgix.net/7579c73b/uploads/origins/3233e414-59ca-4cb8-9096-44878f4effa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5822555ab56b5904616d92990acac64, https://si.imgix.net/7579c73b/uploads/origins/3233e414-59ca-4cb8-9096-44878f4effa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07e444fda9fbfa33c9e0ef7ed125c8bc 2x, https://si.imgix.net/7579c73b/uploads/origins/3233e414-59ca-4cb8-9096-44878f4effa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=083dbdb6abbcd536eaf2cdaef9e40522 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7579c73b/uploads/origins/3233e414-59ca-4cb8-9096-44878f4effa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51e6a0a4b5d89ebe796b7a3796424b79", "srcset": "https://si.imgix.net/7579c73b/uploads/origins/3233e414-59ca-4cb8-9096-44878f4effa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51e6a0a4b5d89ebe796b7a3796424b79, https://si.imgix.net/7579c73b/uploads/origins/3233e414-59ca-4cb8-9096-44878f4effa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f087e8335a01bca38b82af762e4d840 2x, https://si.imgix.net/7579c73b/uploads/origins/3233e414-59ca-4cb8-9096-44878f4effa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9b6c2f0ad65b638ce7a365eed0b380fb 3x"}, "body": "かぷちー様\n前回　はアイちゃんたちを描いていただきありがとうございました。\n　　　非常にかわいらしく、そして旅感があるイラストで非常にうれしかったです。\n\n　またもの依頼でで恐縮ですが、再びアイちゃんたちのイラストをお願いしたいです。\nキャラ設定\n「アイ」という金髪・銀髪の２人の魔道人形（アンドロイド系）の女の子を。\n「美しいものを探して旅をしている」という設定の女の子たちです。\n\n希望\n・対象キャラ　金アイ&銀アイ\n・構図や表情はお任せいたします。\n・衣装：お任せします、冬っぽい暖かそうな服装でお願いします。\n　　　　難しいようでしたら添付資料の①をベースの衣装として書いていただけたら嬉しいです。\n・背景：冬の山形の「銀山温泉」のようなイメージ\n　　　　雪が舞っている、大正ロマンを感じる建物が欲しいです。\n・時刻：夜、ガス灯でほんのり明るい\n・使用用途はPCの壁紙に使用したいです。\n\nご検討お願いいたします。\n\nhttps://drive.google.com/drive/folders/13ep-NLU2GyM6PDQW02qTDSEGbQ00h0Ji?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kaputii/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2399, "client_id": 619172, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97c2fc5d/uploads/origins/1b5fe349-78db-45bc-a06c-436d0c4d1935?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bd97ad1224e8f75d918326bbffaa1ee", "srcset": "https://si.imgix.net/97c2fc5d/uploads/origins/1b5fe349-78db-45bc-a06c-436d0c4d1935?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bd97ad1224e8f75d918326bbffaa1ee, https://si.imgix.net/97c2fc5d/uploads/origins/1b5fe349-78db-45bc-a06c-436d0c4d1935?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bcbbfc9591ef169438e89f764ffc3cb7 2x, https://si.imgix.net/97c2fc5d/uploads/origins/1b5fe349-78db-45bc-a06c-436d0c4d1935?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=365e3b9172c2947af53471654286d48c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97c2fc5d/uploads/origins/1b5fe349-78db-45bc-a06c-436d0c4d1935?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52aedbc9474cb428dfb892a4f58be939", "srcset": "https://si.imgix.net/97c2fc5d/uploads/origins/1b5fe349-78db-45bc-a06c-436d0c4d1935?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52aedbc9474cb428dfb892a4f58be939, https://si.imgix.net/97c2fc5d/uploads/origins/1b5fe349-78db-45bc-a06c-436d0c4d1935?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c43a9b287f2bfabca08c360d0713c4b 2x, https://si.imgix.net/97c2fc5d/uploads/origins/1b5fe349-78db-45bc-a06c-436d0c4d1935?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=387fd8a264203862053a840679c17e3d 3x"}, "body": "こんにちは、お久しぶりです、かぷちー先生。\n改めて、前回のskebありがとうございます。\n\n今回依頼するイラストの内容は、東方projectの茨木華扇とそのペットたち(久米、竿打、黄帝、彭祖、務光)の新年イラストをお願いします。\n\n・華扇の服装は、普段の服装に加えて、「東方茨歌仙」第38話の冬服を着用した服装でお願いします。\n\n・構図については、「元旦にまだ誰も訪れていない博麗神社へ、ペットたちを連れて初詣に来た」という構図でお願いします。\n\n博麗神社とその他のイラストの細かな構図は、お任せします。\n\n最後に、注文の多いリクエストして申し訳ございません。\nご検討宜しくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kaputii/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2399, "client_id": 904824, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6306e258/uploads/origins/8f9fce29-ebc4-403c-b16b-47d6f3f00aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=414abd4eec9c8f64f31d65a7a3ac2d68", "srcset": "https://si.imgix.net/6306e258/uploads/origins/8f9fce29-ebc4-403c-b16b-47d6f3f00aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=414abd4eec9c8f64f31d65a7a3ac2d68, https://si.imgix.net/6306e258/uploads/origins/8f9fce29-ebc4-403c-b16b-47d6f3f00aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e517de88884e93a07c757c67232d8e06 2x, https://si.imgix.net/6306e258/uploads/origins/8f9fce29-ebc4-403c-b16b-47d6f3f00aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5218b6c723f880210415f17012ef5795 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6306e258/uploads/origins/8f9fce29-ebc4-403c-b16b-47d6f3f00aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f530034d65930ef70d2514789b67b11f", "srcset": "https://si.imgix.net/6306e258/uploads/origins/8f9fce29-ebc4-403c-b16b-47d6f3f00aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f530034d65930ef70d2514789b67b11f, https://si.imgix.net/6306e258/uploads/origins/8f9fce29-ebc4-403c-b16b-47d6f3f00aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b01ea2bc5a6019ba0a9f93f4af1a7d2 2x, https://si.imgix.net/6306e258/uploads/origins/8f9fce29-ebc4-403c-b16b-47d6f3f00aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a170efc6d1a040be91e1b18b5ca051c3 3x"}, "body": "はじめまして　かぷちー様\n季節感を強く感じさせる素晴らしい東方のイラストを拝見し、依頼させていただきました。\n\nニッチなキャラクターで恐縮ですが、魔法使いと黒猫のウィズというゲームから「アイ」という金髪・銀髪の２人の魔道人形（アンドロイド系）の女の子を描いていただけないでしょうか。\n「美しいものを探して旅をしている」という設定の女の子たちです。\n使用用途はPCの壁紙に使用したいです。\n希望\n・構図や表情はお任せいたします。\n・衣装：添付資料の①をベースの衣装として書いていただけたら嬉しいです。ある程度簡略化していただいて構いません。\n・背景：「紅葉」や「銀杏」等の「秋」を感じさせる背景を描いていただけたら嬉しいです。\n・金額が許すのであれば資料の「ウィズ師匠(黒猫)」をどちらかのアイの腕の中に描いていただけないでしょうか\n\n普段描かれていないキャラですが、ご検討お願いいたします。\n\nhttps://drive.google.com/drive/folders/13ep-NLU2GyM6PDQW02qTDSEGbQ00h0Ji?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kaputii/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2399, "client_id": 1156768, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c36bcd8/uploads/origins/6e901d0c-1e28-45f8-ae7b-678a712fecef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6851f33a84dddead701d895f3d6638c", "srcset": "https://si.imgix.net/7c36bcd8/uploads/origins/6e901d0c-1e28-45f8-ae7b-678a712fecef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6851f33a84dddead701d895f3d6638c, https://si.imgix.net/7c36bcd8/uploads/origins/6e901d0c-1e28-45f8-ae7b-678a712fecef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72976bb8806551a9eadcfbf47ec6f688 2x, https://si.imgix.net/7c36bcd8/uploads/origins/6e901d0c-1e28-45f8-ae7b-678a712fecef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fa272cbc8f2444cb354f6b584ef25fa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c36bcd8/uploads/origins/6e901d0c-1e28-45f8-ae7b-678a712fecef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=780b017348ce9cf3f0adbb2c0a7306fa", "srcset": "https://si.imgix.net/7c36bcd8/uploads/origins/6e901d0c-1e28-45f8-ae7b-678a712fecef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=780b017348ce9cf3f0adbb2c0a7306fa, https://si.imgix.net/7c36bcd8/uploads/origins/6e901d0c-1e28-45f8-ae7b-678a712fecef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1451010c2bb45ab521825bd8ec68c60e 2x, https://si.imgix.net/7c36bcd8/uploads/origins/6e901d0c-1e28-45f8-ae7b-678a712fecef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5fae8a858d354eae9e76215667f6cf37 3x"}, "body": "こんにちは。葉っぱ野郎のEndle(https://imgur.com/a/WD8wrvE)が、絶対的な恋人で可愛いキツネのDianella(https://twitter.com/DianellaVt/status/1431781006198071306/photo/3)をおんぶしているアートが欲しいと思っています。彼らが春や夏の日に楽しんでいるように見えるようにしてください。\nエンドルは燕尾服ではなく、真っ白なドレスシャツを着ているだけでもいいでしょう。また、ゴーグルも外します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kaputii/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2399, "client_id": 626297, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0b57fd7/uploads/origins/25665057-82f7-4681-9044-6c4c4d5c7331?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=901c9878ecf72d25f8352f4f0044e22f", "srcset": "https://si.imgix.net/d0b57fd7/uploads/origins/25665057-82f7-4681-9044-6c4c4d5c7331?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=901c9878ec