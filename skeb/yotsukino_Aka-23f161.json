はっきりとしたビジュアルは資料URLを参照)\n\n明確な指示としましては\n・ハードボイルドな雰囲気\n・武力ではなく知力で戦うキャラなのでそれが分かるような構図やポーズ\n・アクセサリーなどの小物はイラストの全体的なバランスを見て自由に追加してよい\n・背景やエフェクトも同様\nこれら4点です。\n\n長々と書いてしまいましたが、どうかクリエイター様の持ち味を活かして楽しく描いてもらえればと願っております。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-WJPsKlD-M_DNgUawg4yuiYHw0WaiHEs", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yotsukino_Aka/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2100921, "client_id": 2634673, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bede506e/uploads/origins/6453708a-f7d5-4de9-885d-22d9337b452c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=172b272e9a6e4ee1aa76565f56246cc9", "srcset": "https://si.imgix.net/bede506e/uploads/origins/6453708a-f7d5-4de9-885d-22d9337b452c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=172b272e9a6e4ee1aa76565f56246cc9, https://si.imgix.net/bede506e/uploads/origins/6453708a-f7d5-4de9-885d-22d9337b452c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=262abfd22b7314098099ac2aa462e9f4 2x, https://si.imgix.net/bede506e/uploads/origins/6453708a-f7d5-4de9-885d-22d9337b452c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=413fdea0f889c3511f0c8eb13ac977cd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bede506e/uploads/origins/6453708a-f7d5-4de9-885d-22d9337b452c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3261e2d6771dfd8fc1049149fbd50527", "srcset": "https://si.imgix.net/bede506e/uploads/origins/6453708a-f7d5-4de9-885d-22d9337b452c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3261e2d6771dfd8fc1049149fbd50527, https://si.imgix.net/bede506e/uploads/origins/6453708a-f7d5-4de9-885d-22d9337b452c?bg=%23