NBOX上で支援のお礼の壁紙としての配布、\nサムネイル、SNSでのアイコンやヘッダー、ツイートなどvtuber活動で使用させていただければ幸いです。\n利用させていただく際には、@メンションをつけて通知いたします。\n（不要の場合にはお手数おかけしますがPSDファイルにて記載いただければと思います。）\n\n【ファイル形式】\nPSDもしくはPNG\n背景と人物のレイヤー分けをお願いしたいです。\n\n至らない点などございましたら申し訳ございませんが、ご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/folderview?id=1kmarl_vIWUd-6BFhWS_dUEtyVpLGfaiB", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toco_ovo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 713629, "client_id": 607471, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/543628e3/uploads/origins/7e6e5e81-1ea0-4b36-b210-a69fc36d8139?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89d7891e0d5da2a4d02b1e47a520d58d", "srcset": "https://si.imgix.net/543628e3/uploads/origins/7e6e5e81-1ea0-4b36-b210-a69fc36d8139?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89d7891e0d5da2a4d02b1e47a520d58d, https://si.imgix.net/543628e3/uploads/origins/7e6e5e81-1ea0-4b36-b210-a69fc36d8139?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4344b2eac0e29c312912a6d74cfeb590 2x, https://si.imgix.net/543628e3/uploads/origins/7e6e5e81-1ea0-4b36-b210-a69fc36d8139?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6beec7efff40aaab35a23a02b11c4dc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/543628e3/uploads/origins/7e6e5e81-1ea0-4b36-b210-a69fc36d8139?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0a9bb0de666ed391b7ef4f2cf163975", "srcset": "https://si.imgix.net/543628e3/uploads/origins/7e6e5e81-1ea0-4b36-b210-a69fc36d8139?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0a9bb0de666ed391b7ef4f2cf163975, https://si.imgix.net/543628e3/uploads/origins/7e6e5e81-1ea0-4b3