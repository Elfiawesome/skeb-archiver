m(_ _)m   \n\nリクエストの内容ですが、詳細事項よりは、天粕さんが思っていらっしゃる私のイメージをイラストで描いて頂きたいです‼️   \n\n名前や喋り方からのイメージ、あるいはただの想像、どちらでも大丈夫です！ \n 髪型、色、性別、構図、種（人間、動物など）などの全ての項目を、ぜひ天粕さんから決めて頂きたいと思います。   \n\n私から何もご提示しないこと申し訳ないのですが、一人のファンとして、天粕さんのイラストをグッズの感覚で頂きたいと考えておりますので、ぜひ気軽に描いて頂けたら幸いです🥹   \n\nまた、頂いたイラストはSNSへの投稿の予定はございませんが、XやIRIAMのプロフィール写真として使う予定です。   \n\nイラストに天粕さんのサイン？（Amakasutoori）は入れて欲しいです‼️   \n\nいつまで貰いたいという期限は特にございませんので、墓に入るまでは頂けますと幸いですm(_ _)m   \n\n何卒よろしくお願いします🙏  \nこれからの配信も応援しております。   \n\nぬぬ", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2346829, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🍫烏丸こはね🍫シル・ヴ・プレジデント", "screen_name": "kohane_km", "avatar_url": "https://pbs.twimg.com/profile_images/1610825195509665792/CkgOcDfA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1167790291165696001/1767845453/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 3100509, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "音嶋まつり", "screen_name": "otoshimamaturi", "avatar_url": "https://pbs.twimg.com/profile_images/1946549060602613761/br4sbYLY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1738884297736802304/1775230983/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 17}, {"id": 3346910, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "桐宮カズハ", "screen_name": "tokyukazuha", "avatar_url": "https://proxy.misskeyuserco