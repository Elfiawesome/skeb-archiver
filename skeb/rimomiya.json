ins/2d2836ab-1ab8-4fce-b9df-6b397eb6207e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5e8a2a3da018ab60828bd3e06fea144, https://si.imgix.net/6f30c4ca/uploads/origins/2d2836ab-1ab8-4fce-b9df-6b397eb6207e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b78ef0c83764734cfe7428b517f0657a 2x, https://si.imgix.net/6f30c4ca/uploads/origins/2d2836ab-1ab8-4fce-b9df-6b397eb6207e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=00932c41328b9ce4d9eec5a4a3c70373 3x"}, "body": "CeVIOのさとうささらと一対一のボテ腹中出しエッチ\nカラーイラスト\nhttps://www.pixiv.net/artworks/119063916\n\nイメージ\n顔、胸、お腹、結合部が見えるものでおまかせ\nhttps://www.pixiv.net/artworks/129245650\n中出しの瞬間で結合部から精液溢れる、びゅーっ射精\nおしっこお漏らし\nhttps://www.pixiv.net/artworks/130122692\nお腹は大きい、臨月\n妊娠しているので母乳出る\n表情はおまかせしますが目は閉じない、瞳が見えること\n\nセリフもおまかせ\n無しバージョンもあり\n\nラブな感じ\n修正は精液や黒線などモザイク以外\n真っ白だと味けないのでグラデーションや流用など背景\n難しい場合はキャンセル願います", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rimomiya/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 569166, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da917ad9/uploads/origins/961cd389-352a-43a8-906f-dc5b2adbb663?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=937da126b3bd801a51019d4294a8990a", "srcset": "https://si.imgix.net/da917ad9/uploads/origins/961cd389-352a-43a8-906f-dc5b2adbb663?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=937da126b3bd801a51019d4294a8990a, https://si.imgix.net/da917ad9/uploads/origins/961cd389-352a-43a8-906f-dc5b2adbb663?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=645c21fe47402aa18c83a5e5db6288ac 2x, https://si.imgix.net/da917ad9/uploads/origins/961cd389-352a-43a8-906f-dc5b2adbb663?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f59d4bf6282c6124c553b0d4cbd35474 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da917ad9/uploads/origins/961cd389-352a-43a8-906f-dc5b2adbb663?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=850ffb19e6bec68177533669930d2c7f", "srcset": "https://si.imgix.net/da917ad9/uploads/origins/961cd389-352a-43a8-906f-dc5b2adbb663?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=850ffb19e6bec68177533669930d2c7f, https://si.imgix.net/da917ad9/uploads/origins/961cd389-352a-43a8-906f-dc5b2adbb663?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1008bc6cce65d3fdfb2413eddf8eac0e 2x, https://si.imgix.net/da917ad9/uploads/origins/961cd389-352a-43a8-906f-dc5b2adbb663?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=77934a282b6768c150af0efd223ecbfd 3x"}, "body": "以下リクエストになります\n\nキャラ：シルフィ（シルフィエル）\n・リンク先表紙の左側に居る銀髪のダークエルフになります、短いですが試し読みも有ります\n・陰毛は無し\n\n服装：全裸\nシチュ：以前描かれていたこちらhttps://www.pixiv.net/artworks/103466433のセシリィの様な感じで処刑シーンをお願いします\n・エルフを迫害している敵国に捕まり見せしめに処刑される\n・首の鎖は一本で苦しそうにしている\n・体中に鞭で打たれた痕や痣が有る\n・性器に挿入された杭で体を支えられ腹ボコ\n\n・可能で有れば苦し気にしているシルフィのセリフをお願いします\n\nご検討よろしくお願いします。\n\nhttps://www.amazon.co.jp/gp/product/B08HMDMFWQ?notRedirectToSDP=1&ref_=dbs_mng_calw_0&storeType=ebooks", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rimomiya/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 569166, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/709833c8/uploads/origins/9274e964-dc38-49d4-800d-6051bee14c22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0ad0b1e60d8fc5fa12cc6d32a22838f", "srcset": "https://si.imgix.net/709833c8/uploads/origins/9274e964-dc38-49d4-800d-6051bee14c22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=