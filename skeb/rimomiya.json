-bc07-d0f3e112226f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d49bb17395bf0c9b2d997292ae7fcb7", "srcset": "https://si.imgix.net/e6fa0799/uploads/origins/f5e7da5a-1923-480d-bc07-d0f3e112226f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d49bb17395bf0c9b2d997292ae7fcb7, https://si.imgix.net/e6fa0799/uploads/origins/f5e7da5a-1923-480d-bc07-d0f3e112226f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e3f3a334a7d618a2f1793dd03b1a7d9a 2x, https://si.imgix.net/e6fa0799/uploads/origins/f5e7da5a-1923-480d-bc07-d0f3e112226f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7981e848bd5fcfab0c9130ea8caa26e0 3x"}, "body": "まんぐり返しの体勢で拘束され、苦痛の梨でアナルを強制拡張される真壁瑞希をお願いします。小さく閉じたアナルに無理矢理ねじ込み強制的に拡張し、引き抜いた後もアナルが大きく開いたまま閉じなくなってしまい、その後更に大きな苦痛の梨を見せられ怯えてしまう感じでお願いしたいです。目を閉じた表情とあまりの苦痛にお漏らししてしまうところを入れてもらえると嬉しいです。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rimomiya/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 569166, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eaab0ab5/requests/248199_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e3e78805576c38c507ddbaa77d569c0", "srcset": "https://si.imgix.net/eaab0ab5/requests/248199_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e3e78805576c38c507ddbaa77d569c0, https://si.imgix.net/eaab0ab5/requests/248199_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f61e693d93a3c6fe1c91bc2407b9de80 2x, https://si.imgix.net/eaab0ab5/requests/248199_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85d2c3ba764ca5c647e3da30b59675dc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eaab0ab5/requests/248199_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc3ecdc0ae4affaaeeff09d22152ddea", "srcset": "https://si.imgix.net/eaab0ab5/requests/248199_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc3ecdc0ae4affaaeeff09d22152ddea, https://si.imgix.net/eaab0ab5/requests/248199_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=71f901b78c60355cbe43adaeed1bed3a 2x, https://si.imgix.net/eaab0ab5/requests/248199_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=346648e926fcf31ee63f7f229d9aaff3 3x"}, "body": "この度は最高の壁尻マイティセーラーズをどうもありがとうございました。\nあまりに素晴らしい出来でしたので、少し面倒かもですが差分イラストをお願いできないでしょうか。\n\n上半分の前面側なのですが、キャラクターを静香・翼・未来に変えたものを依頼したいです。\n翼が真ん中で、左右に静香と未来を配置していただきたいのです。\nスカーフの色は静香が青、未来が赤でお願いします。\n表情は大体同じ感じで、できたら翼の表情はまた違うのにしていただけると嬉しいです。\n\n次に背面側なのですが、ほんの少しだけキャンバスを下に伸ばしていただいて、以前描かれていた星梨花＆百合子と同じように足首に鎖をつけて地面に固定していただけないでしょうか。\nそれ以外は手を加えずそのままで大丈夫です。\n\n翼をリーダーに据えた新生マイティセーラーズが捕まり、見せしめとして町中で公衆肉便器にされてしまった感じでお願いしたいです。\nお手間かもしれませんが、よろしければお願いいたします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rimomiya/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 569166, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ffc79c8b/requests/230402_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41b9b00ed33ac16a7c0ffb7c8637077d", "srcset": "https://si.imgix.net/ffc79c8b/requests/230402_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41b9b00ed33ac16a7c0ffb7c8637077d, https://si.imgix.net/ffc79c8b/requests/230402_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38d1eb1e38d249445f128ba1d8ae8e2f 2x, https://si.imgix.net/ffc79c8b/requests/230402_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h