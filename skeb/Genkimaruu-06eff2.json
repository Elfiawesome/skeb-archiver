eb依頼致します。\n\n■キャラクター\n褐色ロリちゃん（黒井かれんちゃん）\n\n■シチュエーション\npixivに投稿されていた「褐色ロリ撮影会」の続きを数ページのマンガ形式でお願い致します。\n\n・続きとして読みたいので、イラストのタッチをできるだけ再現してください。\n・内容はお任せしますが、生セックス、ザーメンジョッキを入れてください。\n　最後は、褐色ロリちゃんが股を大きく開いてオマンコからは大量のこってり黄ばみ精液が溢れ、体は汗と体液でべっとり、顔は涙や鼻水でベチョベチョ、ダブルピースした状態で締めてください。\n\n・適当にセリフ付き\n・消しは海苔\n・カラー絵\n\n要望が多くて恐縮ですが、ご検討のほどよろしくお願い致します。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Genkimaruu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 39001, "client_id": 442252, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae803d22/requests/120436_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ddefb5b31a601ba04c773c34bcfe538", "srcset": "https://si.imgix.net/ae803d22/requests/120436_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ddefb5b31a601ba04c773c34bcfe538, https://si.imgix.net/ae803d22/requests/120436_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d29485432baad6d9a85e2027ed3699a0 2x, https://si.imgix.net/ae803d22/requests/120436_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2869d81d2c0933db9bff6425b7c60181 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae803d22/requests/120436_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9e6df58b6a49b0aed8e5d0f6827c8df", "srcset": "https://si.imgix.net/ae803d22/requests/120436_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9e6df58b6a49b0aed8e5d0f6827c8df, https://si.imgix.net/ae803d22/requests/120436_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b12df96931fe43cc49e67ef77d88404c 2x, https://si.imgix.net/ae803d22/requests/120436_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&cr