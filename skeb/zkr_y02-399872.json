format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bc5e9ca43086c62a67d15b4e9f5b7a7, https://si.imgix.net/6586a5d1/uploads/origins/c20f244c-fb4f-4ca5-8c0e-43fe2fc6af46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bbc47255357e17bc678259583d53b1eb 2x, https://si.imgix.net/6586a5d1/uploads/origins/c20f244c-fb4f-4ca5-8c0e-43fe2fc6af46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f8e20c1ea63d87c967883af4cff1579c 3x"}, "body": "初めまして！イラストがとても魅力的で惹かれ、依頼させていただきたいと思いました。\n縹樹さんという方のレインというキャラクターを描いていただきたいです。縹樹さんご本人から許可はいただいております。(URL先の説明文に許可を出しているという記載あり)\n資料や性格などは下記のURLを参考にしていただきたいです。\n表情は目を細めて嘲笑、あるいは大口を開けて片目または両目を大きく見開いているといった悪い顔・何かを企む様子など何か闇や狂気を感じるような表情にしてくださると幸いです！その他の構成は全てお任せしたいです。\nこのキャラクターは男性寄りの見た目ですが、性別はないのでムキムキな筋肉質には描かないようにしていただけると幸いです…！(普通体型〜細マッチョ想定くらいに描いていただけると嬉しいです)\n背中にある管は必須描写ではありませんが、描いていたただける場合、資料の１枚目のような直線ではなく、2枚目にある過去絵資料のようにニョロニョロな曲線に描いていただけると幸いです。\n背景と人物がレイヤー分けされている状態のデータをくださると嬉しいです。\n\nご多忙または依頼内容や依頼内容が自身の方針に合わないなど何か問題があればお手数ですがキャンセルをお願いします。\n\nXfolio:https://xfolio.jp/portfolio/hanadagi_noru/works/4418058?search_words=%22縹樹乃ル%22\n\npixiv:https://www.pixiv.net/artworks/132378629\n\n上記二つは同じ資料です。お好きなプラットフォームから閲覧してください", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zkr_y02/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3759620, "client_id": 3787177, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4cc8d898/uploads/origins/d9d2ec5d-ecb6-4a86-abb8-e55725e855ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c99566f22ef5cab1f2a3e69f842c1c49", "srcset": "https://si.imgix.net/4cc8d898/uploads/origins/d9d2ec5d-ecb6-4a86-abb8-e55725e855ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c99566f22ef5cab1f2a3e69f842c1c49, https://si.imgix.net/4cc8d898/uploads/origins/d9d2ec5d-ecb6-4a86-abb8-e55725e855ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32fca6f56dcb7b072ed88e7ab3af501c 2x, https://si.imgix.net/4cc8d898/uploads/origins/d9d2ec5d-ecb6-4a86-abb8-e55725e855ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8646b494623b10bd3cf6a6dd561d20c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4cc8d898/uploads/origins/d9d2ec5d-ecb6-4a86-abb8-e55725e855ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0955d0d2ec1949e76be390e2bd7013c7", "srcset": "https://si.imgix.net/4cc8d898/uploads/origins/d9d2ec5d-ecb6-4a86-abb8-e55725e855ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0955d0d2ec1949e76be390e2bd7013c7, https://si.imgix.net/4cc8d898/uploads/origins/d9d2ec5d-ecb6-4a86-abb8-e55725e855ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b8913807cf5e607acc56afa0b32ed8cf 2x, https://si.imgix.net/4cc8d898/uploads/origins/d9d2ec5d-ecb6-4a86-abb8-e55725e855ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea7db0b4944a527d40e36507614cbedb 3x"}, "body": "こんにちは！\nはじめまして！\n\n「HempieVT」というVTuberのイラストをお願いしたいです。\n彼女は普段から眠そうで、少しぼんやりとした雰囲気をしており、目の下にクマがあります。\nまた、髪に赤いストライプがあり、瞳の中にはX（エックス）型の模様があります。\n添付の参考画像のどの衣装を使っていただいても大丈夫です。\n\nポーズや構図、雰囲気などはすべておまかせします。\n自由に、あなたの思うままに描いていただけると嬉しいです。\n\nHempieは、上官の命令に逆らったためにチェルノブイリの立入禁止区域に追放されたスリーパーエージェントです。\n放射線の影響で彼女自身も放射性を帯びており、孤独の中で廃墟の建築や放棄された軍用車両、武器（SVD、DP-27など）を研究しながら静かに暮らしています。\nまた、酒に酔うのが好きで、時々飲みすぎてしまうこともありますが、それでも楽しんでおり、よく飲んでは物思いにふけり、時々タバコを吸うこともあります。\n\n彼女のそばには、放射能の影響で変異したマスコットの「Pyp（ピップ）」がいます。\nPypは小さな粘性のある生物で、手足がなく、頭上に光る輪（ハロー）が浮かんでおり、いつもHempieの頭の上や近くにいます。\n\nこのキャラクターは、『serial experiments lain（シリアルエクスペリメンツ・レイン）』や『少女終末旅行』のような作品に影響を受けています。\n静けさ、不安定さ、そして虚無感を感じるトーンで表現していただけると嬉しいです。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1HKpUvqulI6HbCdDdFmdSel-kAK-mqZ6k?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zkr_y02/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3759620, "client_id": 3836196, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb0c13ab/uploads/origins/6fe5e707-a255-4833-a458-27ddfb4ab9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=608e8571cfda40703260023e03598e30", "srcset": "https://si.imgix.net/bb0c13ab/uploads/origins/6fe5e707-a255-4833-a458-27ddfb4ab9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=608e8571cfda40703260023e03598e30, https://si.imgix.net/bb0c13ab/uploads/origins/6fe5e707-a255-4833-a458-27ddfb4ab9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3054ca3870bd94c6d9c2790fcdfc99be 2x, https://si.imgix.net/bb0c13ab/uploads/origins/6fe5e707-a255-4833-a458-27ddfb4ab9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b179950733550d9af4e14f247e5b5225 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb0c13ab/uploads/origins/6fe5e707-a255-4833-a458-27ddfb4ab9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e34d8c4043da83510b6ed02cc65fd5a6", "srcset": "https://si.imgix.net/bb0c13ab/uploads/origins/6fe5e707-a255-4833-a458-27ddfb4ab9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e34d8c4043da83510b6ed02cc65fd5a6, https://si.imgix.net/bb0c13ab/uploads/origins/6fe5e707-a255-4833-a458-27ddfb4ab9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f7ee25236435131ad2436e5f9ea0e2db 2x, https://si.imgix.net/bb0c13ab/uploads/origins/6fe5e707-a255-4833-a458-27ddfb4ab9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=cro