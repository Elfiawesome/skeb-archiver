rop&crop=top&w=200&h=200&s=83ebc1c2cf394eedd1f614e71dda19a7, https://si.imgix.net/7df500d7/uploads/origins/7404473f-d99d-4153-ab71-8e26460a826a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad3288e15d2de580674b10356478bcf3 2x, https://si.imgix.net/7df500d7/uploads/origins/7404473f-d99d-4153-ab71-8e26460a826a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6362a41d24f2775d0c6387eb3e992018 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7df500d7/uploads/origins/7404473f-d99d-4153-ab71-8e26460a826a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee74da01c6b748209e40a02d1a7a3a5b", "srcset": "https://si.imgix.net/7df500d7/uploads/origins/7404473f-d99d-4153-ab71-8e26460a826a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee74da01c6b748209e40a02d1a7a3a5b, https://si.imgix.net/7df500d7/uploads/origins/7404473f-d99d-4153-ab71-8e26460a826a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7d14ca30ac7822b9b1c2428e106b546d 2x, https://si.imgix.net/7df500d7/uploads/origins/7404473f-d99d-4153-ab71-8e26460a826a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=13ecef0b80d43f3d49c10d54e13b551e 3x"}, "body": "先生、こんにちは！！初めてお会いします。翻訳ツールを使ってメッセージを送らせていただきましたので、不自然な点などがあれば本当に申し訳ありません。先生の作品を初めて見た瞬間、その可愛らしく繊細な線画と、キャラクターの描写に深く惹かれました。もしよろしければ、私のオリジナルキャラクター「天使と悪魔」のAU設定の漫画を描いていただけないでしょうか？\n\nhttps://drive.google.com/drive/folders/1ZkxI_QFhcqq8dFNZ2haisBi0-c3mwPn4\n\nぜひ見てみたい内容がありますので、先生に実現していただければ本当にありがたいです。もちろん、難しいと思われる場合は遠慮なくお断りください。その場合は、他の内容を検討し直します。\n\nストーリーは主に邪神と仁に焦点を当てており、愛は単なる思い出の対象として登場します。必要に応じて、彼女の参考画像も添付しました。これは休憩時間に行われる簡単な会話です。\n\n仁：（再会した際、愛に気づいてもらえなかったことに少し落ち込んでおり、邪神にアドバイスを求めようとしている）\n仁：…あの、気になる人と距離を縮めるには、どうすればいいですか？\n邪神：えっ…！？仁が俺に人間関係のアドバイスを求めてくるなんて、めったにないな。まさか、好きな子がいるのか？（冗談交じりに）\n仁：…あ…うん、まあ、そういうことかな（非常に複雑な表情）（仁の性格上、愛に対する感情や、なぜ彼女をそれほど気にかけているのか、自分でもうまく説明できない）\n邪神：え～っ、そうなんですか～（表向き）好きな子のことを考える時の表情って、こういうものだったっけ…？（背後の霊がツッコミ）\n\n以上があらすじです。会話の内容は、お好みに合わせて内容や口調を自由に変更していただいて構いません。本当にありがとうございます！あなたの作品が大好きです！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gn8_bird/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3934600, "client_id": 3874100, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e9581ee/uploads/origins/2ce86ee5-92a2-447c-8003-d3b3e09240ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea3142b1150af0dfc4081d5555efe612", "srcset": "https://si.imgix.net/7e9581ee/uploads/origins/2ce86ee5-92a2-447c-8003-d3b3e09240ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea3142b1150af0dfc4081d5555efe612, https://si.imgix.net/7e9581ee/uploads/origins/2ce86ee5-92a2-447c-8003-d3b3e09240ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5136d26e8e42b8f345f794ed0adb5e41 2x, https://si.imgix.net/7e9581ee/uploads/origins/2ce86ee5-92a2-447c-8003-d3b3e09240ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66c724af8b0f4010f3a9ff2e2a207035 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e9581ee/uploads/origins/2ce86ee5-92a2-447c-8003-d3b3e09240ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18659fdeb391e8d6e80da72afd3ebae3", "srcset": "https://si.imgix.net/7e9581ee/uploads/origins/2ce86ee5-92a2-447c-8003-d3b3e09240ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18659fdeb391e8d6e80da72afd3ebae3, https://si.imgix.net/7e9581ee/uploads/origins/2ce86ee5-92a2-447c-8003-d3b3e09240ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8e4e5708d5445da6fbabb056