び目を見える位置にお願いします(資料URLご参照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@c_eyphka/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3736490, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b865e51/uploads/origins/44174e08-917c-4695-b7f5-b82b202bce83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74bcb15b113624b15bdf91eb82e2ad52", "srcset": "https://si.imgix.net/6b865e51/uploads/origins/44174e08-917c-4695-b7f5-b82b202bce83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74bcb15b113624b15bdf91eb82e2ad52, https://si.imgix.net/6b865e51/uploads/origins/44174e08-917c-4695-b7f5-b82b202bce83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19fcb20f6c7c0bb9dab28c83a618f81d 2x, https://si.imgix.net/6b865e51/uploads/origins/44174e08-917c-4695-b7f5-b82b202bce83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4d8ef6871bc8f83c4826fb7b169135d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b865e51/uploads/origins/44174e08-917c-4695-b7f5-b82b202bce83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8da84b53d1656bb2884a0e19f6e1957", "srcset": "https://si.imgix.net/6b865e51/uploads/origins/44174e08-917c-4695-b7f5-b82b202bce83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8da84b53d1656bb2884a0e19f6e1957, https://si.imgix.net/6b865e51/uploads/origins/44174e08-917c-4695-b7f5-b82b202bce83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&c