けると嬉しいです！\n依頼を読んでいただき、ありがとうございました...！ご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/110DB1ycjfdry2Oj2UqrPPreKFOzU916T?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@necrosis_777/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a4f4cd26/uploads/origins/33c5ba3a-fc73-483b-b317-c983f4c308ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a3cbf3da1b33b60efd1728cdbcfdea4", "srcset": "https://si.imgix.net/a4f4cd26/uploads/origins/33c5ba3a-fc73-483b-b317-c983f4c308ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a3cbf3da1b33b60efd1728cdbcfdea4, https://si.imgix.net/a4f4cd26/uploads/origins/33c5ba3a-fc73-483b-b317-c983f4c308ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c453a30681107b75403776a711aa965 2x, https://si.imgix.net/a4f4cd26/uploads/origins/33c5ba3a-fc73-483b-b317-c983f4c308ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4d2680bf69a44207eaf53c2486f0a74 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3586211, "nc": 144}, {"path": "/@necrosis_777/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d7779d2e/uploads/origins/05f7f14a-d933-484c-879b-9c22e310d28b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cbfaafa44774df4f6fed052caa11f9f8", "srcset": "https://si.imgix.net/d7779d2e/uploads/origins/05f7f14a-d933-484c-87