6-445b-8ccb-f962760587c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f20ed35cfdeb15b5d8340bb78e72298", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2452037c/uploads/origins/8b2f90da-cdb6-445b-8ccb-f962760587c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfedd22e020a869db8880a1a02f0f78f", "src_set": ""}, "body": "巴鳥なこ様、  \n初めまして、ルーナホワイトと申します。 Skebを徘徊していたところきれいな女の子のイラストが目に留まりメッセージさせていただいています。  \n\n【使用用途】\n いつも私の配信を見てくれている方へ、新年のあいさつメッセージ付きカード \n配信のサムネイル \n週ごとのスケジュール画像の挿絵、背景 Youtube、もしくはTwitchのヘッダー、アイコン \n人物のみのデータがもらえる場合、配信時ディスコのオーバーレイ \n今後このイラストがグッズ等商用利用されることはありません。\n\n\n 【構図】\n サイズは1920x1080(フルHD)が理想ですが16：9であればどの解像度でも構いません \n右、もしくは左にメッセージを入れたいのでキャラの顔がどちらかによっていて文字が被らないような構図をお願いしたいです。(参考としてキャラ三面図と同じフォルダに画像を入れておきました。) \n第一目的は新年のお祝い、感謝を伝えるためのイラストですので明るい雰囲気で、詳しいポーズ、背景はお任せいたします。  \n\n【キャラ三面図】 https://drive.google.com/drive/folders/1QSnhsZgc_SM0l0Xn2_3Dag4QxN70BGqH?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mrrr1126/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 16223, "client_id": 234777, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/921b0301/uploads/origins/9e409287-d239-465b-81b1-76f8fedea4b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5222d18a7c2ac4b747147ea91c34e080", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/921b0301/uploads/origins/9e409287-d239-465b-81b1-76f8fedea4b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29a37c0991dc81fe9bc8ff5914b041e6", "src_set": ""}, "body": "お世話になっております、らむしかです。\nいつもなこさんの素敵なイラスト拝見しております！\nなこさんの描かれる凛としてキラキラした女の子が大好きです！\n（以前描いて頂いたらむしかも大人っぽくてとてもお気に入りです…！）\n\n今回、らむしかのV体のイラストをお願いした