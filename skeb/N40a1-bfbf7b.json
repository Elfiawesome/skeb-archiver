28-f2e55d004a60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38924b73008ec9b4909f21875e62dfa5 2x, https://si.imgix.net/d691f32b/uploads/origins/5510c8d1-ef7a-4c5a-b128-f2e55d004a60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5879b48280dfb67399b7babf1b0eae79 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d691f32b/uploads/origins/5510c8d1-ef7a-4c5a-b128-f2e55d004a60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4280c28cbc2047b4485014093859edef", "srcset": "https://si.imgix.net/d691f32b/uploads/origins/5510c8d1-ef7a-4c5a-b128-f2e55d004a60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4280c28cbc2047b4485014093859edef, https://si.imgix.net/d691f32b/uploads/origins/5510c8d1-ef7a-4c5a-b128-f2e55d004a60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1db8a1e03cb0db8df1108e8fd296a0ac 2x, https://si.imgix.net/d691f32b/uploads/origins/5510c8d1-ef7a-4c5a-b128-f2e55d004a60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=210847ac65576d3df167741c9f323409 3x"}, "body": "なお様\n\nこんばんは、なお様。\nツイッターからイラストを拝見させて頂いてファンになったものです。\nぼっちちゃんやいろんなボカロの表情の表現が好きです。女の子が見せるいろんな感情！困ってる感じの表情とか本当最高です！\nそんななお様がスケブを開いてくださることを知り、もしよろしければこちらのオリキャラのことを依頼したいです。\n\nお願い申し上げたいのはこちらのオリキャラ狐娘の万里香（まりか）という子です。\n狐耳と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の高校生です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。一人の時や知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘でなお様の絵柄でのイラストをどうかお願いしたいです。\n衣装は設定画のうちの一つで、他はどうかご自由にお願いします。\nご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_