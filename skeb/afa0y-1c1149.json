っている姿や、さりげない仕草など、静かで品のある雰囲気のあるキャラクターです。\nもし可能でしたら、表情差分なども描いていただけましたら嬉しいです。\n\n個人鑑賞用として大切に楽しませていただきます。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1nFCg-jphnasKpSEJcIF9LcAdM8PoO92o", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@afa0y/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3399757, "client_id": 2313968, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a50d57f/uploads/origins/053ea982-7c0e-44fc-b2be-f58c956228ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=472b88a5c605191f665b121ab4a975c6", "srcset": "https://si.imgix.net/9a50d57f/uploads/origins/053ea982-7c0e-44fc-b2be-f58c956228ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=472b88a5c605191f665b121ab4a975c6, https://si.imgix.net/9a50d57f/uploads/origins/053ea982-7c0e-44fc-b2be-f58c956228ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a27bb35c50b732649dceb062ee7798d9 2x, https://si.imgix.net/9a50d57f/uploads/origins/053ea982-7c0e-44fc-b2be-f58c956228ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b583013ecd1073e88bf28d6199c658a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a50d57f/uploads/origins/053ea982-7c0e-44fc-b2be-f58c956228ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d601378db28be5d181a607b9779a6c3d", "srcset": "https://si.imgix.net/9a50d57f/uploads/origins/053ea982-7c0e-44fc-b2be-f58c956228ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d601378db28be5d181a607b9779a6c3d, https://si.imgix.net/9a50d57f/uploads/origins/053ea982-7c0e-44fc-b2be-f58c956228ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4ba7797e83038041fac876a73bb5f984