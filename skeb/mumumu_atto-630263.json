00&blur=200&s=9905e3893f4ea17268f77b518c15c235 3x"}, "body": "この狐の女の子のキャラクターを描いてください。彼女は怪しげな組織によって実験台にされた九尾の狐の精霊です。組織に虐待されていたため、包帯を巻くなどダークな美的センスで描けます。彼女は逃げ出し、今はバブルタピオカティーを出す陽気なカフェを経営している。好きなように描いてください。\n\nhttps://drive.google.com/drive/folders/1muwrNhirt7Rqdb6rTV-OLXttz7W9Ht94?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mumumu_atto/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2353674, "client_id": 3723733, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc9137d2/uploads/origins/d12dcb3d-8732-432e-9d8b-4f7c541979cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e136b3ab9e5b19d3826260d01bc4c6e", "srcset": "https://si.imgix.net/cc9137d2/uploads/origins/d12dcb3d-8732-432e-9d8b-4f7c541979cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e136b3ab9e5b19d3826260d01bc4c6e, https://si.imgix.net/cc9137d2/uploads/origins/d12dcb3d-8732-432e-9d8b-4f7c541979cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d16cda19699ae97f7cc3ebe63f6e5ab 2x, https://si.imgix.net/cc9137d2/uploads/origins/d12dcb3d-8732-432e-9d8b-4f7c541979cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9cbe64e05b6a5a17c9b2138fe7ab01f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc9137d2/uploads/origins/d12dcb3d-8732-432e-9d8b-4f7c541979cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=873e98303df05a299d83e6c384ece136", "srcset": "https://si.imgix.net/cc9137d2/uploads/origins/d12dcb3d-8732-432e-9d8b-4f7c541979cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=873e98303df05a299d83e6c384ece136, https://si.imgix.net/cc9137d2/uploads/origins/d12dcb3d-8732-432e-9d8b-4f7c541979cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0791c19f1d011c9b72c2ff7a610d572e 2x, https://si.imgix.net/cc9137d2/uploads/origins/d12dcb3d-8732-432e-9d8b-4f7c541979cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=90a93e51785adf71b647251ffad92aec 3x"}, "body": "赤宮むむ様\n\n普段から𝕏にて作品拝見させていただいていて、是非とも依頼したいと思いリクエストさせていただきました。\n\nリクエストしたいのは、個人VTuberの満月まひろさんのイラストです。(三面図が掲載されているlitkinkはこちら→https://lit.link/mitsukimahiro)\n\n満月まひろさんの配信してる様子(主に雑談配信)の日常の様子を描いていただきたいです。構図等は全てお任せします。\n\n使用用途はXで依頼した旨の投稿、個人的な鑑賞、満月まひろさんへのプレゼントを予定しています。(配信のサムネ等の利用の可能性あり。商用利用なし。)\n\nサムネ等に使用される可能性もあわせて、髪の毛は先端が見切れず全体が映るようにして頂きたいです。また、本人のみ(背景透過)と背景ありの2パターンで納品していただきたいです。\n\nファイル形式はPSDもしくはPNGで納品していただきたいです。\n\n料金、また依頼文で不備等ございましたら再依頼で返していただけると嬉しいです。よろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mumumu_atto/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2353674, "client_id": 3742755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d8af8f8/uploads/origins/cd555002-ada8-4fa5-af37-2a99a01fdf03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a890bad73e07cc232460ede1fde08fd3", "srcset": "https://si.imgix.net/3d8af8f8/uploads/origins/cd555002-ada8-4fa5-af37-2a99a01fdf03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a890bad73e07cc232460ede1fde08fd3, https://si.imgix.net/3d8af8f8/uploads/origins/cd555002-ada8-4fa5-af37-2a99a01fdf03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d2ef037f35a546ed6dc88c20c72fd31 2x, https://si.imgix.net/3d8af8f8/uploads/origins/cd555002-ada8-4fa5-af37-2a99a01fdf03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b49ba9ea4feed0f74a27e8709540e35 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d8af8f8/uploads/origins/cd555002-ada8-4fa5-af37-2a99a01fdf03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d86d6f55577d20dc837f88fe572b52c", "srcset": "https://si.imgix.net/3d8af8f8/uploads/origins/cd555002-ada8-4fa5-af37-2a99a01fdf03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d86d6f55577d20dc837f88fe572b52c, https://si.imgix.net/3d8af8f8/uploads/origins/cd555002-ada8-4fa5-af37-2a99a01fdf03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5dd1d124244b6100047550cacc5058f3 2x, https://si.imgix.net/3d8af8f8/uploads/origins/cd555002-ada8-4fa5-af37-2a99a01fdf03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d122d17b9b536a090b6274c5a3bbcc1d 3x"}, "body": "I would like to commission a street-style full-body illustration of Vtuber \"Gurimu Tsukiuta\".\nI can leave the composition to you, except that I would like you to draw Gurimu looking up at me from below.\nIf you are going to draw a cap, please make sure the hair is either straight or tucked back into the cap.", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mumumu_atto/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2353674, "client_id": 471969, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc9e877c/uploads/origins/991f3fae-edb4-4cbc-b4e7-8fcc072e1100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3dd2bb2a6e7751ca028ec3e0c77db97", "srcset": "https://si.imgix.net/fc9e877c/uploads/origins/991f3fae-edb4-4cbc-b4e7-8fcc072e1100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3dd2bb2a6e7751ca028ec3e0c77db97, https://si.imgix.net/fc9e877c/uploads/origins/991f3fae-edb4-4cbc-b4e7-8fcc072e1100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=039a1d2fc909306e7f0c3b6d126366bb 2x, https://si.imgix.net/fc9e877c/uploads/origins/991f3fae-edb4-4cbc-b4e7-8fcc072e1100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cdbfe3ed550ab809cdd38961aa8d6f91 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc9e877c/uploads/origins/991f3fae-edb4-4cbc-b4e7-8fcc072e1100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc51b3f7000c0d5af6f09c75290f5d91", "srcset": "https://si.imgix.net/fc9e877c/uploads/origins/991f3fae-edb4-4cbc-b4e7-8fcc072e1100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc51b3f7000c0d5af6f09c75290f5d91, https://si.imgix.net/fc9e877c/uploads/origins/991f3fae-edb4-4cbc-b4e7-8fcc072e1100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e636982dc989e83735f4b7c450493c0d 2x, https://si.imgix.net/fc9e877c/uploads/origins/991f3fae-edb4-4cbc-b4e7-8fcc072e1100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8164a0cedca710516ae4c919068349cf 3x"}, "body": "Hello. Nice to meet you.\nI love shioraven.\nI purchased a book of mine clothing illustrations from BOOTH, and the cover alone, which is propped up on my bookshelf, is a feast for the eyes. It is wonderful to see it in a large size at hand. The fluffy and cute bibs are adorable too. I am looking forward to winter too.\n\nI will request for our child (OC).\nThere is a simple character sheet (with skin color elements) at the bottom of the document URL.\nWe have also prepared a relatively wholesome material, but it also contains expressions similar to those in Young Magazine.\nShe is a slender, poor-breasted, semi-demonic girl with a cool visual with glazed eyes and flashing eyelashes, and a cute smile on her glossy lips. She is \"slender and has poor tits.\nAs mentioned in the material, her tone of voice is polite, and her job is an adventurer and an anything-you-can-eat shop owner. She has a lot of piercings.\n\n0Situation \"Punkish Private Clothes Uchiko\".\nWe request an OC wearing different clothes from those in the material.\nOther poses, etc. are left up to you; you may dress her as she is dressed in the Advent book.\nIf possible, we would appreciate it if you can see the piercing on the left ear and the tongue piercing.\n\nWe may share your work at OC.\n\n\nThat is all. Thank you for your cooperation!\n\n\nttps://drive.google.com/drive/folders/1acpNnL-ulRduSRjDMmz-Yyzbw6xba5DD?usp=sharing\n↑upRelatively sound material\nttps://drive.google.com/drive/folders/1q8bgUx1sUJm_hQvdLQ7DNy7QYaqQbS_r\n↑upDocuments with everything, including skin color", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mumumu_atto/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2353674, "client_id": 2312136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c01cbf6/uploads/origins/259562ac-21b4-403d-8dfa-2b7238ebbeee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f0a7cc119b92e511535d96a0ebce879", "srcset": "https://si.imgix.net/4c01cbf6/uploads/origins/259562ac-21b4-403d-8dfa-2b7238ebbeee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f0a7cc119b92e511535d96a0ebce879, https://si.imgix.net/4c01cbf6/uploads/origins/259562ac-21b4-403d-8dfa-2b7238ebbeee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14b3ee918a9eda54aaf0ec5d2099af2a 2x, https://si.imgix.net/4c01cbf6/uploads/origins/259562ac-21b4-403d-8dfa-2b7238ebbeee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5aa252678c8f35c5d3e8100a5cae0642 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c01cbf6/uploads/origins/259562ac-21b4-403d-8dfa-2b7238ebbeee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=758f563dfff1f8a11f6614fc3a0cac3c", "srcset": "https://si.imgix.net/4c01cbf6/uploads/origins/259562ac-21b4-403d-8dfa-2b7238ebbeee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=758f563dfff1f8a11f6614fc3a0cac3c, https://si.imgix.net/4c01cbf6/uploads/origins/259562ac-21b4-403d-8dfa-2b7238ebbeee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=14ade1739ca5310ea7ab4be27ed26540 2x, https://si.imgix.net/4c01cbf6/uploads/origins/259562ac-21b4-403d-8dfa-2b7238ebbeee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=34c2b38c89cb88e49b710bbe5bdbc2e5 3x"}, "body": "Mumu Akamiya\n\nNice to meet you.\nMy name is Yuka Kasumi and I am a personal Vtuber.\nI have seen your very nice illustrations on X (formerly Twitter).\nI would like to ask you to draw an illustration for me, so I have sent a request to you.\n\nUsage: Thumbnails on YouTube, post on X (old Twitter)\n\nI would like you to draw me, Yuka Kasumi, as the character.\nPlease refer to the following URL for the character design.\n\nhttps://x.com/yuka_kasumi_vv/status/1956308469746946476?t=h_igLbdc15nS2N00hhSEAA&s=19\n\nI will leave the pose and facial expression up to you, but I would appreciate it if you could make it look a bit girly.\n\nAs I mentioned earlier, we are planning to use it as a thumbnail.\nWe would appreciate it if you could make sure that the hair and other parts of the face are not visible.\n\nIf you can draw the background, we would appreciate it if you could send us a PSD or PNG file with the signature and background layered separately.\nIf you do not have a background, we would prefer a transparent background.\n\nThat is all.\nThank you for reading to the end.\nWe hope you will consider our proposal.\nThank you very much for your consideration.", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mumumu_atto/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2353674, "client_id": 3516080, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8491dc0e/uploads/origins/955689b7-7695-4c14-8f65-724697b58fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f9b6cbd2359168399ac5b00e80be519", "srcset": "https://si.imgix.net/8491dc0e/uploads/origins/955689b7-7695-4c14-8f65-724697b58fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f9b6cbd2359168399ac5b00e80be519, https://si.imgix.net/8491dc0e/uploads/origins/955689b7-7695-4c14-8f65-724697b58fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a2063020dd13ab69b2d85e90d68d6ec 2x, https://si.imgix.net/8491dc0e/uploads/origins/955689b7-7695-4c14-8f65-724697b58fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3fa1d2e6d57338c4434a8cea69cf74d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8491dc0e/uploads/origins/955689b7-7695-4c14-8f65-724697b58fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de4d1b3873f35ed3a43fa216f4b7c262", "srcset": "https://si.imgix.net/8491dc0e/uploads/origins/955689b7-7695-4c14-8f65-724697b58fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de4d1b3873f35ed3a43fa216f4b7c262, https://si.imgix.net/8491dc0e/uploads/origins/955689b7-7695-4c14-8f65-724697b58fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d58fdc0c787bbf3809a7117bea0b46c9 2x, https://si.imgix.net/8491dc0e/uploads/origins/955689b7-7695-4c14-8f65-724697b58fbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5e9efb26421dcd70982f85ddad775aa1 3x"}, "body": "Thank you very much for your kind attention.\nWe are planning to post an advertisement in support of Gawr Gura, a Vtuber talent belonging to Hololive, and are contacting you to request an illustration to be used in the advertisement.\n\nTherefore, we would like to request a single picture of Gawr Gura with a background.\nPlease leave everything to us, including the composition.\nThe paper size of the supporting advertisement will be B0.\nThe company that has requested the advertisement has asked us to submit the data in full size, so if possible, we would appreciate it if you could deliver the data in this size.\nWe will send you the URL of the vendor's data submission as a reference.\n\nhttps://help-cheering-ad.jeki.co.jp/hc/ja/articles/14088169727001\n\nHowever, we will send the illustration to the vendor with the contact information of the organizer and a message to the talent, so please be aware that the size and settings are on a request basis.\nHowever, if the size is too far from B0, there is a possibility of blurring or other problems when we enlarge the size to B0, so we would greatly appreciate it if the size is the original size or close to it.\n\nThank you in advance for your cooperation.", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mumumu_atto/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2353674, "client_id": 1200407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b61461ab/uploads/origins/03dbe80a-4aa7-48a0-9b83-24b2aabe58d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca3f74afddd2cd46ba608bc31b76dc93", "srcset": "https://si.imgix.net/b61461ab/uploads/origins/03dbe80a-4aa7-48a0-9b83-24b2aabe58d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca3f74afddd2cd46ba608bc31b76dc93, https://si.imgix.net/b61461ab/uploads/origins/03dbe80a-4aa7-48a0-9b83-24b2aabe58d3?bg=%23fff&