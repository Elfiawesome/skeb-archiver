tipped": false, "creator_id": 2560319, "client_id": 2845229, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e437c1d1/uploads/origins/9aa74278-dc56-41c4-94d2-133ebc94cdb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15cb8c4c4dc5246cb87c6a422a15c614", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e437c1d1/uploads/origins/9aa74278-dc56-41c4-94d2-133ebc94cdb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e72e307f6bf1e36c81ffa9fecab04162", "src_set": ""}, "body": "北北様\n\n初めまして、Vtuberのシャルエと申します。\n北北様の素敵なイラストを拝見し、リクエストを送信させていただきました。\nもしご縁をいただけましたら、私シャルエのイラストをお願いいたします。\n\n【リクエスト内容】\n北北様の絵柄で、内容はおまかせでお願いできますと幸いです。\n衣装は省略や装飾の少ない衣装に変更など、北北様の描きやすい形でお願いできますと大変ありがたく存じます。\n\nサムネイルなどに使用させていただきたいため、可能であれば帽子の左右どちらかのツバが見切れない構図、もしくは猫耳全体が入った構図を希望です。\n\n【使用用途】\nYoutube、SNS、FANBOX支援者様にネットプリント・壁紙の配布\n\n【納品形式】\n人物、背景、宛名等がレイヤー分けされたPSDもしくは背景透過のPNGを希望です\n\n【キャラクターについて】\n・魔法図書館で使い魔猫に囲まれて暮らす白猫\n・身長150センチ（耳を含まない）\n・猫耳としっぽがあり、人間の耳がありません\n\n【参考資料】\nhttps://drive.google.com/drive/folders/12YJ1-uparnq_s7hCfYaCiP4sSk9bZMpW?usp=sharing\n\nご検討いただけますと幸いでございます。\nどうぞよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ennnmo0/works/233", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4c8cca95/uploads/origins/0406636f-4073-40e5-b3d1-b0092a26ffec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f70637e109b59377b1031a12ab91e58", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2560319, "client_id": 3593757, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable