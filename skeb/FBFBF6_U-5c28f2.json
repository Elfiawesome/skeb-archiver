ive/folders/10W36O2PoSZz5YdKkF7vFTAKH6lDyfkFS?usp=sharing\n\n以上の要素を持った女の子をお願いしたいです。\n\n髪型や衣装、その他細かい点など先生の好きに描いていただきたいです(^^)\n\n使用用途は鑑賞、snsアイコン等を予定しております。\n宛名はon/offできるようにしていただけると幸いです！\n\nご検討のほどよろしくお願いいたしますm(_ _)m\n\nhttps://drive.google.com/drive/folders/10W36O2PoSZz5YdKkF7vFTAKH6lDyfkFS?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@FBFBF6_U/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 804241, "client_id": 870591, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b60822da/uploads/origins/9f1896db-674c-4ea2-b753-5da110eec6c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33858d33ae3f9171e6ccf3d1594095aa", "srcset": "https://si.imgix.net/b60822da/uploads/origins/9f1896db-674c-4ea2-b753-5da110eec6c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33858d33ae3f9171e6ccf3d1594095aa, https://si.imgix.net/b60822da/uploads/origins/9f1896db-674c-4ea2-b753-5da110eec6c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf23c0833dc20cea4443fbaaafb57e51 2x, https://si.imgix.net/b60822da/uploads/origins/9f1896db-674c-4ea2-b753-5da110eec6c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d510eb2dfb036a9c4d48f345190bf8c1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b60822da/uploads/origins/9f1896db-674c-4ea2-b753-5da110eec6c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=716f2140ae0eacb7609197534aec663a", "srcset": "https://si.imgix.net/b60822da/uploads/origins/9f1896db-674c-4ea2-b753-5da110eec6c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=716f2140ae0eacb7609197534aec663a, https://si.imgix.net/b60822da/uploads/origins/9f1896db-674c-4ea2-b753-5da110eec6c0?bg=%23fff&aut