uploads/origins/f13c4541-3516-4f76-b844-acc914461e8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=573b024d299974d07db98195e65ae737 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08d85146/uploads/origins/f13c4541-3516-4f76-b844-acc914461e8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=748ee37efae67cdc1e0dbbafb1ec2b79", "srcset": "https://si.imgix.net/08d85146/uploads/origins/f13c4541-3516-4f76-b844-acc914461e8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=748ee37efae67cdc1e0dbbafb1ec2b79, https://si.imgix.net/08d85146/uploads/origins/f13c4541-3516-4f76-b844-acc914461e8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=91af6bb69b4ba6073dbf476e8a354c6c 2x, https://si.imgix.net/08d85146/uploads/origins/f13c4541-3516-4f76-b844-acc914461e8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1457442f8821fdaa0d14c6166138be66 3x"}, "body": "先生、こんにちは！今回、漫画の執筆依頼をさせていただきたいのですが！\nキャラクター：白面鴞／博士\n内容は2部構成です\n第1部：\n前回、博士にアナルを調教された白面鴞は、次第にアナルオナニーに溺れていく……\n一日中働き疲れた白面梟が寮に戻り、アナルプラグを抜くと、研究室からこっそり持ち帰った媚薬をすべてアナルに流し込み、その後、様々な玩具で自分のアナルを弄びます（アナルビーズ、バイブ、 ディルド…）最後にフィスティングで自慰（自慰中に自分の手が博士ほど大きくないことに気づき、自慰しながら小声で博士の名前を呼ぶ）、絶頂後にベッドに倒れ込むが、通りかかった博士に聞こえてしまう…\n第二部：\n博士がドアをノックし、白面鴞に体調不良ではないかと尋ねる。白面鴞が口を開く間もなく、博士はドアを押し開けて入ってくる。その後、白面鴞はバスタオルを巻いたまま博士と話す\n「白面鴞はこんなことしたくなかったの。全部博士と媚薬のせいよ…」「ごめん…白面鴞」\n「全部博士のせいよ」\n「でも媚薬中毒は治せる。ただ…」\n「？」\n「ただ、その方法は好きな人とセックスすることなんだ」\n白面鸮の顔は真っ赤になり、一言も発さずにゆっくりとバスタオルを脱いだ。「……」\n「白面鸮？」\n白面鸮は全裸で、全身を博士に見せつけた。「博士のことが、すごく好き……」\nその後、白面鸮は博士にフェラチオをし、フェラチオをしている間も博士は白面鸮を弄び続け、 精液はすべて白面鴞の口の中に射精され、白面鴞はマンコを広げて博士に挿入させた。博士に激しく突かれて意識が朦朧とする中、博士は「フィスティングされたいか、白面鴞」と尋ねた。白面鴞は「うんうん」と声を漏らし、同意しているようだった。そして最後には、博士に激しく突かれながらフィスティングもされ、絶頂に達した。しかし白面鴞はまだ満足せず、自らアナルをペニスに押し当て、最後には博士に中をたっぷりと満たされ、お腹まで膨らんでしまった。二人は互いに抱き合った。\n（博士はデフォルトの立ち絵で構いません。手袋やフードを外す必要はありません。）\n白面鴞の肛門が全開になっているシーンをもっと描いてください🙏特に彼女が自慰をしている時です。先生、よろしくお願いします", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ganyokong/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3724027, "client_id": 1231761, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d5cb87a/uploads/origins/c5c2e7be-7693-4088-b6b2-a979c7e524f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=108c87fa84fb14c806616d3c97077858", "srcset": "https://si.imgix.net/3d5cb87a/uploads/origins/c5c2e7be-7693-4088-b6b2-a979c7e524f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=108c87fa84fb14c806616d3c97077858, https://si.imgix.net/3d5cb87a/uploads/origins/c5c2e7be-7693-4088-b6b2-a979c7e524f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=902cc5f99faee73d821c2c4b00cf50c1 2x, https://si.imgix.net/3d5cb87a/uploads/origins/c5c2e7be-7693-4088-b6b2-a979c7e524f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95f6e5510a80e6dbfefd7f28f846c320 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d5cb87a/uploads/origins/c5c2e7be-7693-4088-b6b2-a979c7e524f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08addf781177af0d993d4d2dc586f7ff", "srcset": "https://si.imgix.net/3d5cb87a/uploads/origins/c5c2e7be-7693-4088-b6b2-a979c7e524f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08addf781177af0d993d4d2dc586f7ff, https://si.imgix.net/3d5cb87a/uploads/origins/c5c2e7be-7693-4088-b6b2-a979c7e524f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ffbb9f4a21f11d436607da681c898836 2x, https://si.imgix.net/3d5cb87a/uploads/origins/c5c2e7be-7693-4088-b6b2-a979c7e524f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a4ea231a7d0b74b594007e83ec6234d 3x"}, "body": "はじめまして、よろしくお願いします。あなたの作風がとても気に入っています。私のためにイラストを描いていただけませんか？私のキャラクターの名前は「ケツァル」です。彼女は「サイバーパンク」の世界の住人で、ご存知かもしれませんね？人気ゲーム『サイバーパンク2077』と同じ設定です。ケツァルはラティーナ、つまり南米出身の女性です。 肌は褐色で乳首も茶色です。詳細は下記にリンクする参考画像でご確認ください。また下着は着用していません。ハイキックをしている姿を描いてほしいです。脚を高く上げたため腰布が陰部を覆いきれず、膣がはっきり見える状態です。他の作品で膣部分を表現される手法がとても気に入っています。 可能であれば、決意に満ちた表情のバージョンと、恥ずかしそうな表情のバージョンもお願いします。ケツァルさんの作品例：https://drive.google.com/drive/folders/1W9p93_DvPf7s4zkC4ocNooKX6xKDyPI2?usp=drive_link ご検討いただき誠にありがとうございます！", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ganyokong/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/09635dd9/uploads/origins/bdaeb3d9-e485-4e19-8cc8-4b7c7ab7691b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7981a55522bfa2979083a9a9782fceb7", "srcset": "https://si.imgix.net/09635dd9/uploads/origins/bdaeb3d9-e485-4e19-8cc8-4b7c7ab7691b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7981a55522bfa2979083a9a9782fceb7, https://si.imgix.net/09635dd9/uploads/origins/bdaeb3d9-e485-4e19-8cc8-4b7c7ab7691b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73f9c52c0b5ef4272a4e17516a3ab2dc 2x, https://si.imgix.net/09635dd9/uploads/origins/bdaeb3d9-e485-4e19-8cc8-4b7c7ab7691b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11eb6a743fd16d3b5bdc4231514edc74 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 3724027, "nc": 58}, {"path": "/@Ganyokong/works/6", "priv