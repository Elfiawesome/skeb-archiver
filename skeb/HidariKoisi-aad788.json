r=2&fit=crop&crop=top&w=200&h=200&s=e559b4af045b6ea5b685089ff49f091b 2x, https://si.imgix.net/0f0212ec/uploads/origins/2602b0b9-78fc-4032-acd6-08c6b384694b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=982aca11d533b8051a4bc72f5da7b2a1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f0212ec/uploads/origins/2602b0b9-78fc-4032-acd6-08c6b384694b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45c1fe5238680da0e19c9cdb1e2cc534", "srcset": "https://si.imgix.net/0f0212ec/uploads/origins/2602b0b9-78fc-4032-acd6-08c6b384694b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45c1fe5238680da0e19c9cdb1e2cc534, https://si.imgix.net/0f0212ec/uploads/origins/2602b0b9-78fc-4032-acd6-08c6b384694b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fcaf4087e4f50224522e816ff6a89452 2x, https://si.imgix.net/0f0212ec/uploads/origins/2602b0b9-78fc-4032-acd6-08c6b384694b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ede1559d9f2233107a6ef0b2ab698e98 3x"}, "body": "またまたこんにちは。東方Projectの諏訪子とショタの漫画をお願いしたいです。\n\nシナリオは、諏訪子のパンティでオナニーしているショタを諏訪子が歩いている。\n諏訪子は面白がって、いたずら小僧に舌でお仕置きをすることにします。\n\n諏訪子はその長い舌で少年を弄ぶ。ディープキスをし、チンコをしゃぶり、長い舌でエキゾチックにチンコに絡みつく。\n\n少年は諏訪子のテクニックにとても弱く、何度もイカされる。その可愛い反応に興奮した諏訪子は、少年を蹂躙したくなる。\n\n諏訪子は少年のペニスを弄びながら、長い舌で前立腺を攻める。少年は諏訪子の前になすすべもない。\n\n諏訪子は、少年が精液を放出できなくなるまで何時間も少年を責め続ける。\n諏訪子は嬉しそうに少年に、これから毎晩、もっとお仕置きをするために自分の部屋に来るように命じる。\n\nその他の詳細については、あなたのご判断にお任せします。\nよろしくお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HidariKoisi/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1709400, "client_id": 28187, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f5ddc813/uploads/origins/ea9f996f-749d-4cee-a370-be0dae8f5b28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=761727033d4da160f51751d66e063690", "srcset": "https://si.imgix.net/f5ddc813/uploads/origins/ea9f996f-749d-4cee-a370-be0dae8f5b28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=761727033d4da160f51751d66e063690, https://si.imgix.net/f5ddc813/uploads/origins/ea9f996f-749d-4cee-a370-be0dae8f5b28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d53abc1e52549205d3f9207b71141a3b 2x, https://si.imgix.net/f5ddc813/uploads/origins/ea9f996f-749d-4cee-a370-be0dae8f5b28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d7ed9998578ec7702c764c3c00a5f6b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5ddc813/uploads/origins/ea9f996f-749d-4cee-a370-be0dae8f5b28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e54f277ba59a6f8d1d4069c5849861f9", "srcset": "https://si.imgix.net/f5ddc813/uploads/origins/ea9f996f-749d-4cee-a370-be0dae8f5b28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e54f277ba59a6f8d1d4069c5849861f9, https://si.imgix.net/f5ddc813/uploads/origins/ea9f996f-749d-4cee-a370-be0dae8f5b28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=188a63ff3dc1bc0248e9165410a3336a 2x, https://si.imgix.net/f5ddc813/uploads/origins/ea9f996f-749d-4cee-a370-be0dae8f5b28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6bfcc27635fa855db136fac48f7e00a9 3x"}, "body": "マゾを楽し気に虐める作品に感銘を覚えたので依頼してみたいと思います。\n\n東方のあらあらうふふでむちむち綿月豊姫様がペットのマゾショタ玉兎に顔面騎乗しながら、\nワープホールでちょっと亀頭覗く包茎ショタちんちんを楽しそうに包茎剥き剥き舌入れフェラ\n射精した後は射精直後フェラやローションガーゼで射精直後おちんぽをあらあらうふふと楽し気に責め立てる場面を\nどうかお願いできますでしょうか…！\n\n豊姫様サンプル（これでおっぱい大きめムチムチで、食い込み気味の小さめ白パンツ、クロッチ有り）\nhttps://i.imgur.com/kMLde2B.jpg\n\nペットちゃんサンプル（目隠れムッツリマゾ気味ショタ、格好は全裸でちょっとぽっちゃり、半被りで半分亀頭が覗く包茎ショタチンポ、チンカスは無し）\nhttps://www.pixiv.net/artworks/75226813\n\n状況的にはこの資料URLの16p～18pぐらいの貯めたちんぽを搾ってる場面\nhttps://www.pixiv.net/artworks/72342176\nショタ君が豊姫様のパンツ盗んでオナってたお仕置きで射精管理されて（ここは描写しなくてもいい前提）\n2週間後の穢れが貯まりに貯まったおちんちんを楽しげに搾精される場面を描写していただけたらと思います。\n\n今までのskeb依頼サンプルで言うと、このような感じのが欲しいなって感じです\nhttps://skeb.jp/@satousatotototo/works/5\nhttps://skeb.jp/@siomesi_oisii/works/50\nhttps://skeb.jp/@eclair5000/works/44\nhttps://www.pixiv.net/artworks/96159475\nhttps://www.pixiv.net/artworks/88081136\n\nご検討くださいませ", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HidariKoisi/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1709400, "client_id": 1989569, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/990d259c/uploads/origins/d55eda2a-94e5-40fb-aa87-97275befccd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a82abe6ab654a342c1b7223973605668", "srcset": "https://si.imgix.net/990d259c/uploads/origins/d55eda2a-94e5-40fb-aa87-97275befccd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a82abe6ab654a342c1b7223973605668, https://si.imgix.net/990d259c/uploads/origins/d55eda2a-94e5-40fb-aa87-97275befccd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cad421f8f37ae2e0e35c20b5acf581e2 2x, https://si.imgix.net/990d259c/uploads/origins/d55eda2a-94e5-40fb-aa87-97275befccd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5345a80c26f95d9f3900cf4eb8ebd73 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/990d259c/uploads/origins/d55eda2a-94e5-40fb-aa87-97275befccd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80494c6107f871bc0c5531572f59d413", "srcset": "https://si.imgix.net/990d259c/uploads/origins/d55eda2a-94e5-40fb-aa87-97275befccd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80494c6107f871bc0c5531572f59d413, https://si.imgix.net/990d259c/uploads/origins/d55eda2a-94e5-40fb-aa87-97275befccd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bcc175bdb1ab225efbc5a0d1212278c5 2x, https://si.imgix.net/990d259c/uploads/origins/d55eda2a-94e5-40fb-aa87-97275befccd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=137f5d307a5c28c87735b2e0f54a414f 3x"}, "body": "再びこんにちは。モン娘クエストのタマモ、アリス、ルカの作品をお願いしたいです。\n\nシナリオは、アリスがNTRフェチで、玉藻にルカとのセックスをお願いするものです。玉藻は快諾し、アリスのフェチをからかう。\n\nルカはそのことを知らない。タマモはルカを部屋に招き、誘惑し始める。アリスはこっそりそれを見ている。ルカはタマモの誘惑に弱々しく抵抗するが、タマモが最終的に彼を押し倒し、愛情を込めて犯すのを止められない。アリスは興奮を抑えられず、ルカがタマモに犯されるのを見ながらオナニーを始める。\n\n構成やその他の詳細は、皆様のご判断にお任せいたします。\nご検討のほど、よろしくお願いいたします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HidariKoisi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1709400, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d36f807/uploads/origins/c022b4f3-9818-40df-8bc6-87b6a9409223?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f043e81a17a584b2dbde3b1d73e713e", "srcset": "https://si.imgix.net/5d36f807/uploads/origins/c022b4f3-9818-40df-8bc6-87b6a9409223?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f043e81a17a584b2dbde3b1d73e713e, https://si.imgix.net/5d36f807/uploads/origins/c022b4f3-9818-40df-8bc6-87b6a9409223?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44920652ef867869447cac1ae4d3e143 2x, https://si.imgix.net/5d36f807/uploads/origins/c022b4f3-9818-40df-8bc6-87b6a9409223?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a061c7d00d69c45617241059ee8bda61 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src":