473d-8e3e-1f8fdd51efc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7eb2db42154a406d2d378d0cf64370d", "srcset": "https://si.imgix.net/8e929dd8/uploads/origins/d7857ed6-076b-473d-8e3e-1f8fdd51efc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7eb2db42154a406d2d378d0cf64370d, https://si.imgix.net/8e929dd8/uploads/origins/d7857ed6-076b-473d-8e3e-1f8fdd51efc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b19512dbc9ff1dbbb5c752ed51859b9f 2x, https://si.imgix.net/8e929dd8/uploads/origins/d7857ed6-076b-473d-8e3e-1f8fdd51efc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0f9e36ef752522ac6cf9c544e9306ae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e929dd8/uploads/origins/d7857ed6-076b-473d-8e3e-1f8fdd51efc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12f5757e92febeafe7df318975272444", "srcset": "https://si.imgix.net/8e929dd8/uploads/origins/d7857ed6-076b-473d-8e3e-1f8fdd51efc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12f5757e92febeafe7df318975272444, https://si.imgix.net/8e929dd8/uploads/origins/d7857ed6-076b-473d-8e3e-1f8fdd51efc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=689dd0115d13a557c405ad916dbb22fb 2x, https://si.imgix.net/8e929dd8/uploads/origins/d7857ed6-076b-473d-8e3e-1f8fdd51efc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e1fc5284c4d17cd8bcd8db98ef42b0e5 3x"}, "body": "こんにちは、先生！\n\n先生のアートスタイルが大好きです！今回は私のオリジナルキャラクター2人（ロマンティックな関係）のリクエストをお願いしたいです。彼らは主従関係であり、パートナーであり、恋人同士でもあります。  \n\n  🦋 Chara 1：エイプリル (April)【攻め/184cm/19歳】\n明るく紳士的で、人当たりが良い性格。シルバーの右腕として、家族を脅かす者を排除します。黒髪で左目を覆う髪型、一本だけ白い髪束があります。両目は緑色、頭には黒い蝶の羽が生えています。シルバーに接する際は感情的で敏感な一面も。\n\n🐺Chara 2：シルバー (Silver)【受け/174cm/16歳】\n黒い狼に変身する能力を持つマフィアのボス。幼少期の辛い経験から冷静で抑制的ですが、エイプリルの行動には非常に寛容です。短い黒髪、低彩度の紫瞳、黒い動物の耳と尻尾を持っています。\n\n関係性 \n\nエイプリル（🦋）は、シルバー（🐺）の顧問（コンシリエーレ）兼守護者として、彼を導き世話をしています。エイプリルはシルバーに深い献身を示していますが、その世話には執着や偏愛が含まれています。一方、ボスであるシルバーは冷静な外見を保ちながらも、エイプリルに対しては完全な信頼を寄せ、彼のあらゆる行動を黙認し、甘んじて受け入れています。\n\n服装やデザインは自由に変更していただいて構いません！もし可能であれば、2人の体格差がわかるように描いていただけると嬉しいです（シルバーはエイプリルより半頭分ほど小柄で、若く見える印象でお願いしたいです）。\n\nこのイラストは、個人利用（SNSアイコンや携帯の壁紙）として使用させていただきます。  リクエストを読んでいただき、そして検討いただき本当にありがとうございます。このリクエストが不適切でしたら、どうぞお気軽にキャンセルしてください。\n\n金額が足りない場合、再送お願いいたします…!  よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1ELhgR-asbNtVhyPQFjL1VpA7wg46wTGJ", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@anchovy_soso/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3967159, "client_id": 3779718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4297823c/uploads/origins/f965d41b-47ad-4623-bb20-e001881e6d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8e8f2a8d1ec4563b0edb8b56ea83388", "srcset": "https://si.imgix.net/4297823c/uploads/origins/f965d41b-47ad-4623-bb20-e001881e6d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8e8f2a8d1ec4563b0edb8b56ea83388, https://si.imgix.net/4297823c/uploads/origins/f965d41b-47ad-4623-bb20-e001881e6d45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=005f92e1e1a0a5171ca64affe7ef8b8e 2x, https://si.imgix.net/4297823c/uploads/origins/f965d41b-47ad-4623-bb20-e001881e6d45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e90b30c692127adf45fa5c9bc41596b1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4297823c/uploads/origins/f965d41b-47ad-4623-bb20-e001881e6d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ac0dfb2442dc2bdfab46bff6141b051", "srcset": "https://si.