&fit=crop&crop=top&w=200&h=200&blur=200&s=c71f74bdb2f1e3656759bec9d442b524 3x"}, "body": "初めて依頼させていただきます\n﻿マイナーなキャラでもよろしければお願いします\nキャラは東京レイヴンズの倉橋京子ちゃんでお願いします\nシチュエーションなどは\n・ベッドに横たわっている\n・衣装は上裸で下はTバックのみで秘部からは精液が垂れている\n・アングルは足元の方から斜めに見下ろす感じ\n・目線はこちらに向けている感じ\n・手に妊娠検査薬（陽性）を持ちながらピースしている\n・口元に陰毛が付いている\n・Tバックに使用済みゴムが結ばれている\n・表情は微笑んでいる感じでお願いします\n・これをスマホで撮影されている感じ\n\n以上よろしければお願いします", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KurimanStudio/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/14d73ca3/requests/60417_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f98dca69323027f8faea94f147ab0f37", "srcset": "https://si.imgix.net/14d73ca3/requests/60417_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f98dca69323027f8faea94f147ab0f37, https://si.imgix.net/14d73ca3/requests/60417_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7337fcd396f3964cabc6201ac94ce852 2x, https://si.imgix.net/14d73ca3/requests/60417_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00768d76cf179e945798dbfee7b6a89f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 117655, "client_id": 158142, "nc": 48}, {"path": "/@KurimanStudio/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 117655, "client_id": 23919, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0074f9f6/requests/53187_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4957b1f5674381fae3d0d3926d8a7b72", "srcset": "https://si.imgix.net/0074f9f6/requests/53187_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4957b1f5674381fae3d0d3926d8a7b72, https://si.imgix.net/0074f9f6/requests/53187_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2423366b07378374855afd6d394f6a83 2x, https://si.imgix.net/0074f9f6/requests/53187_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68656e686188bda8d4a93ecd76622c7f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0074f9f6/requests/53187_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c5becf4e796f28a3bd0f21ce3598dac", "srcset": "https://si.imgix.net/0074f9f6/requests/53187_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c5becf4e796f28a3bd0f21ce3598dac, https://si.imgix.net/0074f9f6/requests/53187_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=71e2a92d41546ea1dedd48b5d324d784 2x, https://si.imgix.net/0074f9f6/requests/53187_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3cfd4e7d175560dceac1b0c3f598851e 3x"}, "body": "この前はありがとうございました。\n次は三人の爆乳オリジナルキャラクターの４Ｐハーレム乱交絵をお願いします。\n\n真ん中に旦那さんの巨根に正常位で貫かれている正妻の銀髪ちゃんを配置して、その左右に褐色ちゃんと紐パンちゃんを配してください。正妻以外の二人は旦那さんが連れてきた幼なじみ（セフレ→側室）という接待です。左右のどちらに褐色ちゃんと紐パンちゃんを配置するかはくりまんじゅうさんにお任せします。\n大股開いてアンアンよがっている銀髪ちゃんのおっぱい触らせたりさせてください。あと旦那さんの姿は今回重要じゃ有りませんので見切れて結構ですが、入っているおちんちんは下腹部が盛り上がりボコォ系の影が出来るほどに巨大な物です。\n\n資料：正妻（銀髪ちゃん）想定年齢：２１\nhttps://imgur.com/a/KJtPWSl\n褐色ちゃん　想定年齢：２０\nhttps://imgur.com/a/hrxkoDV\n紐パンちゃん　想定年齢：２０\nhttps://imgur.com/a/7qgWWzn\n旦那さん（竿役の足とか描くための参考資料。今回は見切れで結構です）\nhttps://imgur.com/alCw7Px\n\n三人ともおっぱいは資料絵よりも大きめにしてください。乳首は経産婦設定で銀髪ちゃん以外黒ずませてください。衣装は全裸。（嫉妬しているのは旦那さんを連れ去ったのみならず経産婦なのにそんな乳首黒ずんでないことも理由）\n予算が許したら中出し差分もお願いしたいのですが、なくても結構です。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KurimanStudio/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1f54b013/requests/54099_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e25f87d16ca2e183275190fb32b2c81", "srcset": "https://si.imgix.net/1f54b013/requests/54099_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e25f87d16ca2e183275190fb32b2c81, https://si.imgix.net/1f54b013/requests/54099_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bdba5754014679b7fb1df52aafc32ff1 2x, https://si.imgix.net/1f54b013/requests/54099_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a5bf6e219e1aed3c8c7cc6640089b78 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 117655, "client_id": 23980, "nc": 48}, {"path": "/@KurimanStudio/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 117655, "client_id": 23919, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ecbea78/requests/44065_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3024960d64d0ea7fba5445b89dc98ff4", "srcset": "https://si.imgix.net/4ecbea78/requests/44065_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3024960d64d0ea7fba5445b89dc98ff4, https://si.imgix.net/4ecbea78/requests/44065_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6704441217f6b1cb35f99ed6778bab03 2x, https://si.imgix.net/4ecbe