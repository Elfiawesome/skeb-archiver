5\u308c\u305fGUNDAM:BEAST\u3067\u63cf\u304b\u308c\u305f\u7363\u3092\u30e2\u30c1\u30fc\u30d5\u306b\u3057\u305f\u5909\u5f62\u30e1\u30ab\u306e\u683c\u597d\u826f\u3055\u306b\u60f9\u304b\u308c\u307e\u3057\u305f\n(\u4e00\u62bc\u3057\u306fHUNDRED-ESTRUS\u3068TIGROURS\u3067\u3059\u304c\u7532\u738b\u3084psy\u3001\u4eba\u72fc\u30e2\u30c1\u30fc\u30d5\u306aVOLF\u3082\u5927\u597d\u304d\u3067\u3059)\n\u4eca\u56de\u306f\u81ea\u5206\u306eOC\u3067\u3042\u308b\u9f8d\u4eba\u306e\u9ed2\u9244(\u8cc7\u6599\u53c2\u8003)\u304c\u642d\u4e57\u64cd\u7e26\u3059\u308b\u30ed\u30dc\u3068\u3044\u3046\u8a2d\u5b9a\u3067\u305d\u306e\u8eab\u306b\u4f3c\u305b\u305f\u9f8d\u4eba\u578b\u30ed\u30dc\u3092\u30c7\u30b6\u30a4\u30f3\u3057\u3066\u9802\u3051\u307e\u305b\u3093\u3067\u3057\u3087\u3046\u304b\uff1f\n\n\u4e16\u754c\u80cc\u666f\n\u54fa\u4e73\u985e\u7a2e\u3001\u4e21\u751f\u985e\u7a2e\u3001\u9ce5\u985e\u7a2e\u306a\u3069\u69d8\u3005\u306a\u5916\u898b\u3092\u3057\u305f\u4eba\u985e\u304c\u5b58\u5728\u3059\u308b\u9280\u6cb3\u7cfb\u5b87\u5b99\n\u5168\u9762\u6226\u4e89\u306f\u88ab\u5bb3\u3068\u76f8\u4e92\u78ba\u8a3c\u7834\u58ca\u306e\u30ea\u30b9\u30af\u304c\u6975\u9650\u306b\u9054\u3057\u305f\u70ba\n\u5229\u76ca\u8abf\u6574\u8005(\u30d7\u30ed\u30d5\u30a3\u30c3\u30bf\u30fc)\u3068\u547c\u3070\u308c\u308b\u4ee3\u8868\u3092\u9078\u51fa\u3057\u3001\u6280\u8853\u306e\u7c8b\u3092\u96c6\u3081\u305f\u6b66\u88c5(\u4e3b\u306b\u30ed\u30dc)\u3067\u6226\u308f\u305b\u308b\n\u305d\u306e\u6226\u95d8\u306f\u5168\u5b87\u5b99\u306b\u4e2d\u7d99\u3055\u308c\u7a2e\u65cf\u3092\u8d85\u3048\u3066\u4eba\u3005\u3092\u9b45\u4e86\u3057\u71b1\u72c2\u3055\u305b\u305f\u2026\u305d\u3093\u306a\u4e16\u754c\u3067\u3059\n\n\u6a5f\u4f53\u30b3\u30f3\u30bb\u30d7\u30c8 \nSurvivability(\u751f\u5b58\u6027)\n\u5b87\u5b99\u53ca\u3073\u69d8\u3005\u306a\u6761\u4ef6\u306e\u60d1\u661f\u91cd\u529b\u4e0b\u3067\u306e\u6226\u95d8\u3067\u306e\u512a\u4f4d\u6027\u3092\u78ba\u4fdd\u3059\u308b\u5927\u51fa\u529b\u3068\u63a8\u529b\u6bd4\n\u512a\u308c\u305f\u63a2\u77e5\u80fd\u529b\u306b\u3088\u308b\u5148\u5236\u767a\u898b\u3001\u5148\u5236\u653b\u6483\u3001\u5148\u5236\u6483\u7834\n\u30b9\u30c6\u30eb\u30b9\u6027\u3068\u5bfe\u88ab\u5f3e\u6027\u306b\u512a\u308c\u305f\u88c5\u7532\u306b\u3088\u308b\u7d99\u6226\u80fd\u529b\n\u6226\u95d8\u306f\u706b\u529b\u3068\u5c04\u7a0b\u304c\u9650\u5b9a\u3055\u308c\u305f\u6295\u5c04\u5175\u5668\u3068\u8fd1\u63a5\u6226\u95d8\u7528\u6253\u6483\u6b66\u5668\u3092\u4f7f\u3063\u3066\u884c\u308f\u308c\u3001\u5358\u6a5f\u5bfe\u5358\u6a5f\u304c\u4e3b\u3060\u304c\u6642\u306b\u5358\u6a5f\u5bfe\u8907\u6570\u6a5f\u3084\u30d0\u30c8\u30eb\u30ed\u30a4\u30e4\u30eb\u5f62\u5f0f\u3067\u3082\u884c\u308f\u308c\u308b\u3068\u3044\u3046\u8a2d\u5b9a\n\n\u30d1\u30a4\u30ed\u30c3\u30c8\n\u9f8d\u4eba\u985e\u7a2e\u306e\u9ed2\u9244(\u304f\u308d\u304c\u306d)\n\u7a2e\u65cf\u7684\u9811\u5065\u3055\u3092\u6d3b\u304b\u3057\u305f\u30cf\u30a4\u30de\u30cb\u30e5\u30fc\u30d0\u304b\u3089\u306e\u6fc0\u7a81\u885d\u7a81\u306a\u3069\u77ac\u9593\u301c\u7d99\u7d9a\u7684\u306b\u9ad8G\u304c\u639b\u304b\u308b\u6226\u8853\u3092\u5f97\u610f\u3068\u3059\u308b\n\n\u30c7\u30b6\u30a4\u30f3 \u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\n\u9f8d\u4eba\u306e\u8eab\u4f53\u7684\u7279\u5fb4\u3092\u6a21\u3057\u305f\u5c3b\u5c3e\u306e\u3042\u308b\u4e8c\u8db3\u6b69\u884c\u30ed\u30dc\n\u8272\u306f\u30ad\u30e3\u30e9(\u8cc7\u6599\u53c2\u8003)\u306b\u5408\u308f\u305b\u3066\u9ed2\u3001\u8d64\u3001\u91d1\u3060\u3068\u5b09\u3057\u3044\u3067\u3059\n\u898b\u6804\u3048\u3057\u306a\u304b\u3063\u305f\u308a\u96e3\u3057\u3044\u69d8\u3067\u3057\u305f\u3089\u81ea\u7531\u306b\u914d\u8272\u3092\u304a\u9858\u3044\u3057\u307e\u3059\n\u30c9\u30e9\u30b4\u30f3\u3063\u307d\u3044\u8981\u7d20\u3092\u8a70\u3081\u8fbc\u3093\u305f\u76f8\u624b\u3092\u5a01\u5727\u3059\u308b\u51f6\u60aa\u3055\u3042\u308b\u30ab\u30c3\u30b3\u826f\u3044\u30c7\u30b6\u30a4\u30f3\u306b\u3057\u3066\u304f\u3060\u3055\u308c\u3070\u5b09\u3057\u3044\u3067\u3059\n\n\u6b66\u88c5\n\u5c04\u6483\u6b66\u5668\u3082\u517c\u306d\u305f\u30d3\u30fc