f&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c9316c40d069a31086cbcb0193eac9f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88c90452/uploads/origins/8d7e4a4d-493a-4fa1-a88e-570836fb941b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cac57939d28fef2d8553acb031d62f36", "srcset": "https://si.imgix.net/88c90452/uploads/origins/8d7e4a4d-493a-4fa1-a88e-570836fb941b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cac57939d28fef2d8553acb031d62f36, https://si.imgix.net/88c90452/uploads/origins/8d7e4a4d-493a-4fa1-a88e-570836fb941b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5966174aa4eafafae064c8add45239ac 2x, https://si.imgix.net/88c90452/uploads/origins/8d7e4a4d-493a-4fa1-a88e-570836fb941b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=96483498efb388da68691dad3c82e6bc 3x"}, "body": "山角さん、こんにちは！\n\n以前山角さんに描いていただいたイラストがとても気に入ったので、また別のOCのイラストをお願いしたくなりました！\nこのOCの名前はTàiliàng。神父で、人前では慈愛に満ちているように見えるが、実際はとても厳格で、どこか独裁者のようだ。Tàiliàngは秩序、法律、完璧さ...そういうものに執着している。角と尻尾は紺色の液体（翼の外側の部分と同じ色）を含んだ柔軟なガラスのような素材でできている。普段は笏を持っているが、まだデザインしていない。\n\nポーズも何もかもお任せします！彼の体にある光輪も自由に動かせるよ（大きくしたり小さくしたりも思いのまま）。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1XJO-uF8DfcVUvQHG5x-JbyfwrBzPI27L?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@am2d4x/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3196264, "client_id": 3393331, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed30970b/uploads/origins/302b9d26-c303-448b-8517-b7d309a0208a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d68342e1d19d9e84133f99d935b1926", "srcset": "https://si.imgix.net/ed30970b/uploads/origins/302b