n\nその他、詳細な背景・構図やキャラのポーズは全てお任せします。\n\n構図参考:\nhttps://drive.google.com/file/d/1g6VfUJJEgFVkbGX-qniEVCQ4yv94lVlZ/view?usp=sharing\n\n黒アリスディティール参考:\nhttps://www.pixiv.net/artworks/7913511", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zephid_phantasm/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2733270, "client_id": 1388897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3da4fa17/uploads/origins/e8a2ad39-f801-4bdb-87ba-6db848f9be58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f09408f4c456e057b371481e25d6471b", "srcset": "https://si.imgix.net/3da4fa17/uploads/origins/e8a2ad39-f801-4bdb-87ba-6db848f9be58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f09408f4c456e057b371481e25d6471b, https://si.imgix.net/3da4fa17/uploads/origins/e8a2ad39-f801-4bdb-87ba-6db848f9be58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28f900d9b05a5c37998d87fc78f5cbf9 2x, https://si.imgix.net/3da4fa17/uploads/origins/e8a2ad39-f801-4bdb-87ba-6db848f9be58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9de1d6a0d5697632d8315e28e709e381 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3da4fa17/uploads/origins/e8a2ad39-f801-4bdb-87ba-6db848f9be58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08d06abee44fdc44c065583936709e6e", "srcset": "https://si.imgix.net/3da4fa17/uploads/origins/e8a2ad39-f801-4bdb-87ba-6db848f9be58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08d06abee44fdc44c065583936709e6e, https://si.imgix.net/3da4fa17/uploads/origins/e8a2ad39-f801-4bdb-87ba-6db848f9be58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b86cf9675b147c78fb84babd37c01e95 2x