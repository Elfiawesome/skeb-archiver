みです。\n・竿役は描写不要ですが青年男性(20代)のイメージで\n・セリフ有無はおまかせします（やりやすい方で可）", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zephid_phantasm/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2733270, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b72760c1/uploads/origins/eee194da-f224-450c-8e5b-9b3744d2a24b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e071fec470b4020bef6a265c86ab61f", "srcset": "https://si.imgix.net/b72760c1/uploads/origins/eee194da-f224-450c-8e5b-9b3744d2a24b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e071fec470b4020bef6a265c86ab61f, https://si.imgix.net/b72760c1/uploads/origins/eee194da-f224-450c-8e5b-9b3744d2a24b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87e25213a2f9ca6df35f7b04e97406af 2x, https://si.imgix.net/b72760c1/uploads/origins/eee194da-f224-450c-8e5b-9b3744d2a24b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ad72a79923f9718b0f622258c0272cc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b72760c1/uploads/origins/eee194da-f224-450c-8e5b-9b3744d2a24b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=083e7e6f1e7fb8444fa0bb69b86d47b8", "srcset": "https://si.imgix.net/b72760c1/uploads/origins/eee194da-f224-450c-8e5b-9b3744d2a24b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=083e7e6f1e7fb8444fa0bb69b86d47b8, https://si.imgix.net/b72760c1/uploads/origins/eee194da-f224-450c-8e5b-9b3744d2a24b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5900f417345c57fb09ca4b6c5eb01d31 2x, https://si.imgix.net/b72760c1/uploads/origins/eee194da-f224-450c-8e5b-9b3744d2a24b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=t