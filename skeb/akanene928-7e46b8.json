ンをお任せしたく\nただお願いしたいのは\nキャップを被り\nホットパンツで生脚ではなく黒パンストor黒タイツを着用していて欲しいです！\n\n五鈴ちゃんは英子ちゃん同様のとても元気で明るい子です！\n⚠️注意点があるとしたら五鈴ちゃんの肌の色は英子ちゃんに合わせていただければ幸いです！\n\nhttps://www.dropbox.com/sh/50y72cglpuo7oii/AAAzha4SVPqGJJFsvXAQYE7ma?dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2346083, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "朝路/asajji@イラスト描き", "screen_name": "asa_jji", "avatar_url": "https://pbs.twimg.com/profile_images/1579336557747576834/PaCATh_y.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1564864260601430017/1665378138/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "banned": false, "nc": 0}, {"id": 2372446, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あき田😵‍💫", "screen_name": "akita__ken_", "avatar_url": "https://pbs.twimg.com/profile_images/1983898223027900416/XfakBwp8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1480037414869807107/1761833188/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 1}, {"id": 2562952, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "waishi", "screen_name": "waishinoaka", "avatar_url": "https://pbs.twimg.com/profile_images/2057912702660685825/oW1JYMTQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1611530099496714240/1737120863/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_r