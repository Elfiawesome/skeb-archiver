200&h=200&s=6119f6e6e01b7ab3ddfadc2258fc3356", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/443ece55/uploads/origins/c069d6ff-3dca-40bb-a4f4-548f40bae3b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0505307aee56cfcf52edb1719117e87b", "src_set": ""}, "body": "斗町まと様、こんばんは。\nいつも応援しております。\nまと様のキラキラとした作風に惹かれ、どうか私のオリジナルキャラクターを描いていただきたく、依頼を申し込みさせていただきます。\n\nさて、お願い申し上げたいのは、私の創作キャラクターのルナです。\n\n◯キャラクターの特徴\n身長140cmの、華奢な女の子です。\nモチーフは月、星、心です。\n淡い紫色のボブヘアに、青色の目、大きな耳とふわふわのしっぽが特徴的です。頭上には、半透明のリングを浮かべています。\nどこかミステリアスで、人見知りな性格をしていますが、甘えん坊でお茶目な一面も持っています。また、人の感情を「色」として見ることができる、不思議な魔力を持っています。\n\n◯服飾に関して\nルナに似合う洋服を、自由にデザインしていただけると嬉しいです。ただし、要素として「セーラー服の襟」を描いていただきたいです。髪型は自由にアレンジしていただいて構いません。\n\n◯その他\n可能であれば、ルナの全身を描いていただけると幸いです。\n薄紫、水色を基調にした絵を希望します。\nルナには、カナタというキャラクターのぬいぐるみを持たせてください。カナタはルナの歳の離れた兄で、ルナにとって大切な存在です。\n構図や背景はお任せします。\n\nぜひ、可愛さやポップさ、メルヘンさを詰め込んだ絵を描いていただけると、嬉しいです。\nご検討のほど、よろしくお願い致します。\n\nhttps://drive.google.com/file/d/1LHsc5FfoDKgxdiFyWxznRLbL7h7B4EVy/view?usp=drivesdk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tmtmt_Yz/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3065007, "client_id": 2031755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71cfb7d4/uploads/origins/5fb1dc3d-181d-4d42-ab88-37cf00ad3cae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d6e2aafc0d10090c13cbef02e6613a2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71cfb7d4/uploads/origins/5fb1dc3d-181d-4d42-ab88-37cf00ad3cae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b15d2a5d31a304f7b621922530062d8", "src_set": ""}, "body": "こんにちは！あなたの絵がとても気に入ったので、絵を依頼したいのですが？\n\n黒髪の男性は26歳の刑事。どちらかというと堅苦しく、ユーモアのセンスもない。見た目は平凡だが、頼りになるかもしれない。\n（メガネをかけている）\nhttps://sta.sh/0kd0hm19b9f\n\n頭脳明晰で可愛らしく、性格も明るい完璧な女子高生で、現在は探偵事務所で助手として働いている。その完璧さと順調さゆえに将来への期待を失い、屋上から飛び降りたこともある。\n参考になる要素は、折り鶴、夕暮れ、舞台劇。\nhttps://sta.sh/0kmb6kf799e\n\n二人は仲が良く、女の子は男性をからかうのが好きです！\n私のことを考えてくれて本当にありがとう！本当にありがとうございます!", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 5500, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "by4co", "screen_name": "_by4co", "avatar_url": "https://pbs.twimg.com/profile_images/1972676834170150913/QOwevJNA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1014439178317193216/1758203729/1500x500", "appeal_receivable": false, "popular_creator_rank": 72, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 32}, {"id": 764052, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "バンバンG", "screen_name": "BANBANJIIIIIII", "avatar_url": "https://pbs.twimg.com/profile_images/1901197775016247296/Wg31VTkQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1295225134236631041/1729478621/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "voice"}], "nc": 161}, {"id": 1813966, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ｴﾁﾞ☁️", "screen_name": "eziezi_", "avatar_url": "https://pbs.twimg.com/profile_images/1922264859317551104/Ru3vy7GB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1333290610913021953/1715495282/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre"