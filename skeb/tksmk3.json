rc_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1492969, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tksmk3/works/68", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c7f7f079/uploads/origins/d97983d4-1868-4ba5-8c41-d4719a4eec46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6717790d08683030e165199c6f05bfd5", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1492969, "client_id": 2222189, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tksmk3/works/67", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1492969, "client_id": 2355677, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9cb9b536/uploads/origins/f5d4d8d1-078f-4094-9f1f-249da64719fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b75d924ffb8f4b2317bff1e245c09879", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9cb9b536/uploads/origins/f5d4d8d1-078f-4094-9f1f-249da64719fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce2f13435dd8b5a5a6ab9b0c4e9118cf", "src_set": ""}, "body": "こんにちは、ヤクシャと申します。\n以前よりtksさんのイラストを拝見させていただいており、ずば抜けた画力と美しい色使い、躍動感と迫力のある構図に魅了されて依頼をしたくなり、今回リクエストを送らせて頂いております。\nﾎﾝﾄｶｯｺﾖｸﾃﾀﾞｲｽｷﾃﾞｽ\n\n本題ですが、私の代理キャラクターのイラストを描いていただきたいです。\n資料のキャラクター・武器をもとに、弓を構えたイラストを描いてください！\nキャラデザに関わる部分ですが、頬の模様の形状とツノの形状・ツノの生え方をあやかしランブルのヤクシニに近づけてほしいです。\n腕部分の輪っかは金属製で黄金色です。こちらもヤクシニのそれに近づけてほしいです！\nそれと、糸目キャラという設定がありますが開眼した状態で描いて頂きたいです。氷のように冷たく光る眼をお願いします。\n表情は無表情か殺気立った顔で、顔のバランスは童顔めな感じで…つまり、成人男性っぽくなりすぎないようにお願いします！\nポーズは弓を引き絞った状態でお願いしたいです！\n弓は龍の意匠が残っていれば、矢は矢じりのデザイン以外はアレンジして頂いて大丈夫です。\n背景はできれば暗めがカッコよくていいかな～と思ってますが、お好きなようにお願いします！\n\n用途に関してですが、個人的な観賞用途のほかTwitter・MisskeyをはじめとするSNSの背景・ヘッダー画像などに使わせていただきたいと思います。\n\nリクエストは以上です、指定しなかった部分はtksさんにお任せします！\n結構いろいろと要求してしまいましたが、率直に言えば「代理キャラくんが弓構えててカッコよければすんごいうれしい！」です！\nぶしつけなリクエストで申し訳ありません、ぜひよろしくお願いします！\n\n代理資料と武器：https://twitter.com/Yaksha8942/status/1781706851509506404\nヤクシニちゃん：https://twitter.com/Yaksha8942/status/1776166954593853741", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tksmk3/works/66", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1492969, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7f21cbc/uploads/origins/65f49505-4a32-4f77-b406-90c57921d6de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89b9094d5fc0f369a8a2e95f2c5255ab", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7f21cbc/uploads/origins/65f49505-4a32-4f77-b406-90c57921d6de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e54c76f15a0ec3febcfac8c0308d03af", "src_set": ""}, "body": "tksさんリクエストを送ります。\n描いてほしいのは、アズールレーンのハーマイオニー\n\n地下牢で陵辱されてるハーマイオニーを描いてほしいです。\n彼女はメイド服を着たままの状態\nメイド服の胸元をズラされ乳首は露出し、ハイヒールとソックスは脱がされ\nスカートは太もも付近の位置まで破かれている。\n彼女は天井と鎖でつながっている手錠で両手を拘束されている。このとき両手はまとめて拘束されている。\nさらにハーマイオニーは全身汗をかき、苦悶の表情でレ〇プ目で涙目。\n股を閉じてせめてもの抵抗をしている。\n\n男も力強く描いてほしいです。\n男の特徴の以下に書きます\n筋骨隆々な単発黒髪の青年、メカクレで全身日焼けした色黒\n男は全裸\nハーマイオニーの腰を両手でつかみ\nナマでバックの体制でレ〇プしてチ〇コを挿入している。\n\n背景の牢屋の鉄格子には \"SOLD OUT\"と\n赤マジックペンで殴り書きにかかれた木の板がぶら下げてある。\n\n床には大量の紙幣がつまった段ボール箱があり\n他には使用済みのティッシュや\n10個以上はある様々な色の使用済みのコンドームが落ちている。\nハーマイオニーの履いていた2つのハイヒールに使用済みコンドームがたくさんつまっている。\nハーマイオニーのストッキングの上にも使用済みコンドームが散らばっている。\n\nさらに男の射精後の絵も描いてほしいです。\n男がハーマイオニーの中で射精し\nその出された精液がハーマイオニーの太ももになぞるように垂れている。\n中に出されたハーマイオニーは絶望し大量の涙を流す。\n\n以下細かい要望ですが\nハーマイオニーはおっぱいの大きいキャラクターなので\n乳輪乳首はおっぱいの大きさに見合ったサイズにしてほしいです。\n\nリクエストは以上です。\n\nハーマイオニーキャラ絵\n\nhttps://x.gd/5fOnH", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tksmk3/works/65", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/38e956a4/uploads/origins/ed990759-338c-4a71-98ec-60ca752cce30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5b10ab7522bf19acf6f0fb081580756", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1492969, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tksmk3/works/64", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1492969, "client_id": 1800409, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/703cb31b/uploads/origins/ee29d4cd-f839-491e-a4e0-56121fceb337?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9b4a0dc811d5f31fbf30cc157fcd4e1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/703cb31b/uploads/origins/ee29d4cd-f839-491e-a4e0-56121fceb337?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5c081f7b5c47368e59daf924e037bb2", "src_set": ""}, "body": "こんにちは、あなたの作品はとても魅力的ですね！\n\nタヌキ魔女Vtuberのラキ・カズキさんの淫らな作品をお願いしたいです。真夜中の公園のベンチでオナニーしているラキを描いてください。顔を赤らめて、淫らに喘ぎながらオナニーしています。ドレスと魔女の帽子をかぶったままでお願いします。\n\nよろしくお願いします！\n\nラキの参考文献\nhttps://i.imgur.com/15MmLR2.jpg\nhttps://i.imgur.com/g7ozsPB.jpg\n\nポーズとセッティングの参考文献：\nhttps://img3.gelbooru.com/images/c9/af/c9afea1188dffbdb11abf140ca20b008.png", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tksmk3/works/63", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2eca8ed3/uploads/origins/1c48dda0-7c36-4793-85ba-5bdad57751c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=159e101802105c1978175ae0c803c422", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1492969, "client_id": 2222189, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tksmk3/works/62", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2afe6f9f/uploads/origins/1aee8d25-2726-414d-b653-2323a6d3e618?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=608492702450a730eaaa24cd7a15105c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1492969, "client_id": 440245, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 163, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tksmk3/works/61", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1492969, "client_id": 1054883, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2649da8a/uploads/origins/8d0df924-d112-41a4-824a-d13cbd1ee018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8f6ded9a50dd9c729e11d4885a1e5eb", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2649da8a/uploads/origins/8d0df924-d112-41a4-824a-d13cbd1ee018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50ebaf1ba283d1d120fcba868220f936", "src_set": ""}, "body": "艦これの Warspite の緊縛イラストをリクエストします。\n\n細かい希望は以下に箇条書きします：\n\n- 頭の冠のみ残して他は全裸\n- シビアンに跨って膝立ちの体勢（シビアンとはこれらの作品にあるようなかまぼこ形の装置です：https://skeb.jp/@maru23586736/works/65、https://www.pixiv.net/artworks/90767670）\n- シビアンの座面にはディルドがついていて膣内挿入されている\n- シビアンの高さは膝が床にぎりぎり着く程度（座面から腰をほとんど浮かせられない状態）\n- 足首は自由に動かせないよう床に固定されている\n- 上半身はこの作品（https://skeb.jp/@mumumu_seijin/works/29）と同じように、後ろ手で胸を強調するように縄で縛られている\n- 黒いボールギャグを咥えている\n- 乳首にクリップローター（この作品で使われているような形のもの：https://skeb.jp/@0727aomiyako/works/115）がつけられている\n- 不服そうな表情\n\nご検討いただけますと幸いです。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tksmk3/works/60", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1492969, "client_id": 588398, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35c9e599/uploads/origins/e83aff11-1c57-48dd-8f7b-19c7b01ac13c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21548f0c26f4c747e50088d4cb4b03cf", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35c9e599/uploads/origins/e83aff11-1c57-48dd-8f7b-19c7b01ac13c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f8af58e56952910e8a6ccc07c365b2e", "src_set": ""}, "body": "こんにちは、はじめまして。\nよろしければ、下記のイラストをお願いできないでしょうか。\n\n【キャラ】\n「光翼戦姫エクスティア３」より、エクスティア(葛城真理奈)\n\n【構図】\n①エクスティアが武器を両手持ちで戦闘ポーズを取る立ち絵(なるべく全身)\n②スカートの中のレオタードをローアングル気味のアップ絵\n③胸を覆うレオタードをずり下げられ、ポロリしちゃったおっぱいのアップ絵\n\n上記①～③の３視点を(https://www.pixiv.net/artworks/73573822)のような形で一枚に収まるように。\n背景は「透過」で、①～③はそれぞれ単独でも見られるようにレイヤー分けして頂ければ幸いです。\n\n【表情】\n毅然とした瞳・表情です。（睨むというよりは、凛々しいイメージ。）\nこのシリーズは、くちびるの下側の塗りが魅力なので、その塗りの表現があると嬉しいです。\n\n何卒ご検討下さいますよう、宜しくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1n7LApg1Py3K5UgUvaDNDafVz-gBEvH0-?usp=drive_link", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tksmk3/works/59", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1492969, "client_id": 262797, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c4fd447/uploads/origins/505a61db-2981-40b6-86f1-8a921c7df283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b9d281e424ae549067a0d05c09c2f81", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c4fd447/uploads/origins/505a61db-2981-40b6-86f1-8a921c7df283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81f562787601f6a9dfee2ea2739463f8", "src_set": ""}, "body": "アピールありがとうございます\nリクエストお願いします\nキャラ：マキア、リュイン（UNITIA）\n・触手凌辱\n・「https://www.pixiv.net/artworks/21632695」みたいにモンスターを背に（モンスターは大木から触手が生えた感じで）二人とも触手に腕を背中で拘束され、足を広げられて２穴を激しく犯されている（ポーズなど上記絵と同じような感じで）また二人の両胸はゲッドラさんの左胸みたいなヒトデみたいなものが吸い付いて揉むように吸っている\n・何度も何度も犯された後で全身精液まみれでかなり多めでお願いします\n・擬音（容赦なくかなり激しく犯している）や喘ぎ（嫌がりながらも感じている）をお願いします\nマキア、リュイン\n衣装の資料などは下記参照（資料URLはセリフなど記載）。二人とも胸が露出しマキアはジャケットとネクタイとタイツ（ところどころやぶれている）リュインは胸元が開け、ズボンが脱げて片足にひっかかってる状態。\n以下の差分をお願いします（基本的に２人共通）\n①中だし・ぶっかけされイかされる（目を瞑って叫ぶような感じで）\n② イった後の余韻状態（触手にひたすら精液を注ぎこまれ、疲れた表情で射精を感じて「あ…あ…」となっている（可能であれば断面図で２穴にパンパンに出されてる状態）\n③すぐに陵辱を再開し。イった直後でも構わず犯され思い切り感じてイかされまくる（嫌がってるがより快楽よりに）\n④口も含めた３穴責め。長時間散々犯されて２人はレイプ目放心状態でビクンビクンとされるがままになってる状態だが触手は構わず好き勝手に犯している\n下記差分は可能であれば\n⑤大量排卵状態にされており、触手が２穴に中だし続けてる間、２人はのけ反りしてずっと受精しそのたびに絶頂をしており「やめ！」「いぐぅ！」などビクンビクンと激しくイきつづけて止まらない状態。\n⑥触手が小便を出しぶっかけと２穴に注ぎ込んでいる。２人は目元が隠れて「あ～～あ～～」という感じでビクンビクン\nマキア資料\nhttps://twitter.com/Unitia_Official/status/1236486815776997377\nリュイン資料\nhttps://twitter.com/Unitia_Official/status/1237574128304926722\n以上、よろしくお願いします\n\nhttps://unitia.wikiru.jp/index.php?%A1%FA4%2F%A5%DE%A5%AD%A5%A2", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 127053, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Casapig(カサブタ)", "screen_name": "casapig", "avatar_url": "https://pbs.twimg.com/profile_images/1423336658892517379/DoSnJvNa.jpg", "header_url": "https://pbs.twimg.com/profile_banners/970688267883442177/1631718597/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 48}, {"id": 295163, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ベルム", "screen_name": "alone_belm", "avatar_url": "https://pbs.twimg.com/profile_images/1477958447476125702/lJ94tunl.jpg", "header_url": "https://pbs.twimg.com/profile_banners/792251177870118912/1735657924/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 32}, {"id": 337183, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "りゃくすん", "screen_name": "ryksn1297", "avatar_url": "https://pbs.twimg.com/profile_images/1233405746546524161/FMmD78ua.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1194532928153219072/1739418928/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "skills": [{"genre": "art"}], "nc": 33}, {"id": 1313421, "creator": true, "nsfw_acceptable": true, "acceptable": true, 