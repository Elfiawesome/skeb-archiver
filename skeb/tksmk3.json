ix.net/da6e9c75/uploads/origins/7e464b9d-61d5-415c-8377-94e62eddae20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=128608cc3b8f37b861080aa2b334609b", "src_set": ""}, "body": "前回はお世話になりました。\n先生の作品が「見たい」ので、\nよろしければ、またリクエストお願いできないでしょうか。\n\n【キャラ】\n「光翼戦姫エクスティア３」より、エクスティア(葛城真理奈)\n\n【シチュエーション・構図】\n参考資料のような「拘束具」(首輪から２つの手枷をそれぞれ鎖で繋いだもの)で拘束された状態で\nベッドの上で、正常位で腰をがっちり掴まれながら激しくエッチ･･･というシチュエーションを\n以下の①～⑤の流れでお願いします。\n\n①ベッドの上に転がされたエクスティア、スーツは無傷で脱がされていない状態。\n　口を真一文字に結び、毅然とした瞳・表情をしている。（睨むというよりは、凛々しいイメージ。）\n　このシリーズは、くちびるの下側の塗りが魅力なので、その塗りの表現があると嬉しいです。\n\n②胸と股間部分のレオタードをずらされ、おっぱいと秘所が丸見えの状態にされる。\n\n③正常位で腰をがっちり掴まれて激しくエッチ。\n\n④中出しと同時に絶頂。\n\n⑤事後、一人残されて、ぐったりと快楽の余韻に浸っている表情。\n\n竿役については描かなくても構いませんが、\n描く場合は竿役をON・OFFできるようにお願いします。\n\n何卒ご検討下さいますよう、宜しくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1ZGHELLtfSq2hP92TjYTq0PpIJ_a6xoUS?usp=drive_link", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tksmk3/works/78", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b6eed005/uploads/origins/bdc2661e-f27f-4411-9365-84c82264c85e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8e12ef005e037c3e462627aa5570c05", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1492969, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tksmk3/works/77", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1492969, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea3beb64/uploads/origins/3dbe464a-224c-4583-a0e8-4f808dffb39f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b103f52d8cd391464d8cfb66416d6131", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea3beb64/uploads/origins/3dbe464a-224c-4583-a0e8-4f808dffb39f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23f51fb587dd3b28c4b6d7a147833989", "src_set": ""}, "body": "ご無沙汰しております。今回もNatural2の鳥海 空をリクエストします。\nシチュエーションとしては海の家のバイトの休憩中に物陰でセックスというもので、壁に手を突いた前屈みの姿勢で男に尻を鷲掴みにされながら立ちバックでハメられている状態。\n地面には愛液が垂れ、バイト中ずっと挿入していたという想定で太ももにはピンクローターのリモコンがテープで貼られている。\n衣装はPiaキャロットへようこそ3のトロピカル制服、竿役は海パンに上着を引っ掛けた程度のラフな服装の男性を希望します。\n\n構図参考\nhttps://www.pixiv.net/artworks/29314858", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tksmk3/works/76", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/64c990ae/uploads/origins/7283901e-20e0-4dfb-aad7-c4b9eea16b47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59645c45b0b2b8487c5a1f8f9c09a6df", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1492969, "client_id": 1228106, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tksmk3/works/75", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d08d2a25/uploads/origins/a8a34e1c-9f11-450e-b075-f819cf5eed0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=561b350ed2b06511f0058285653a7e23", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1492969, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": fal