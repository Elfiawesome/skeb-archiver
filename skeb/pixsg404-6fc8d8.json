=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e5e436726e375a1b9988cc0def981a2 3x"}, "body": "すがさん、ユニの漫画を本当に楽しませていただいております。お忙しいところ恐縮ですが、再度お願いがあります。仕事と結婚生活、子育てでいつも忙しいユニですが、ついに大好きなビデオゲームをプレイする時間ができました。もちろん彼女の好物は、暴力的なミリタリーFPSゲームです。以前と変わらぬ美しい姿のまま、ユニは妊娠中の妻として健やかな姿を見せています。 そんな彼女がオンラインゲームに没頭し、キル数を自慢したり、対戦相手や味方を罵倒したりする姿を見てみたいです。娘さんに悪い影響が及ばないことを願うばかりです。ちなみに、もし娘さんの名前が必要なら、ヒバリと名付けることにしました。いつもありがとうございます！", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pixsg404/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/91b8b3d9/uploads/origins/d62172d5-e925-45e9-b3a5-18e8168b16b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9cec3e337f6a55d98fadd0f6407f74f7", "srcset": "https://si.imgix.net/91b8b3d9/uploads/origins/d62172d5-e925-45e9-b3a5-18e8168b16b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9cec3e337f6a55d98fadd0f6407f74f7, https://si.imgix.net/91b8b3d9/uploads/origins/d62172d5-e925-45e9-b3a5-18e8168b16b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8e8be8abd2ae22eb017c7fc7e94ba09 2x, https://si.imgix.net/91b8b3d9/uploads/origins/d62172d5-e925-45e9-b3a5-18e8168b16b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6edd5e12c5a0e3cf0c2e453df32c749f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2720019, "nc": 1}, {"path": "/@pixsg404/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2720019, "client_id": 133586, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37697add/uploads/origins/b7f1b140-b735-42ed-a78d-5aa8437b1ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66a3ca331cd78d493dcbb44241e37d86", "srcset": "https://si.imgix.net/37697add/uploads/origins/b7f1b140-b735-42ed-a78d-5aa8437b1ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66a3ca331cd78d493dcbb44241e37d86, https://si.imgix.net/37697add/uploads/origins/b7f1b140-b735-42ed-a78d-5aa8437b1ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8902dfbd7229ce5fd860d6ac9893846 2x, https://si.imgix.net/37697add/uploads/origins/b7f1b140-b735-42ed-a78d-5aa8437b1ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c32ce96769c0ada27be958689d73b065 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37697add/uploads/origins/b7f1b140-b735-42ed-a78d-5aa8437b1ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aaba9462c20578eca851a406459402b8", "srcset": "https://si.imgix.net/37697add/uploads/origins/b7f1b140-b735-42ed-a78d-5aa8437b1ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aaba9462c20578eca851a406459402b8, https://si.imgix.net/37697add/uploads/origins/b7f1b140-b735-42ed-a78d-5aa8437b1ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=de85de307d74a802b3a810db113c383f 2x, https://si.imgix.net/37697add/uploads/origins/b7f1b140-b735-42ed-a78d-5aa8437b1ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b5ae032208919fba16a1d6f3881a2f1 3x"}, "body": "リクエスト失礼します。\n普段の界隈外の絵になります。ダメだったら容赦なく弾いてください。\nブルーアーカイブの二次創作生徒の4コマをお願いします。\nブルーアーカイブのキャラは基本的に後頭部のヘイローの力により強くなったり銃弾程度じゃ苦ともしない防御力を持ちます。詳しくは調べてみてください。\nんで内容としては3人の創作生徒を描いてください。\nアルカ、サカキ、キサラギです。容姿などは資料に載せておきます。\n\n1コマ目:黒背景に白文字\nプロジェクトX風に\n『ミサイルの対処法は？』\n2コマ目:アルカ「とりあえず隠れますね。」\nヘリからビルの物陰に隠れる感じで\n3コマ目:サカキ「撃ち落とします。」\n銃でミサイルを撃って迎撃してる感じ\nファイルの「ミサイル対処法(サカキ)」を参考にしてもよし適当に構図やるもよし\n4コマ目:キサラギ「...まあ、最悪爆発する前に殴って壊します。」\nファイルの「ミサイル対処法(キサラギ)」風に\n拳でぶん殴ってミサイルを壊してる感じ\n\nという感じです。\n了承していただけるとありがたいです。\n\nhttps://drive.google.com/drive/folders/1fzN18HBs1Qqmyfp0Ukt_IOZ3aeEnaD4g", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pixsg404/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/445d6ea5/uploads/origins/a5bbf327-410a-403a-bbe4-bbfc67ff3dd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=190e54ee2718230243e6fd66f520820b", "srcset": "https://si.imgix.net/445d6ea5/uploads/origins/a5bbf327-410a-403a-bbe4-bbfc67ff3dd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=190e54ee2718230243e6fd66f520820b, https://si.imgix.net/445d6ea5/uploads/origins/a5bbf327-410a-403a-bbe4-bbfc67ff3dd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a50efc3646c240a2099004b0d5e80270 2x, https://si.imgix.net/445d6ea5/uploads/origins/a5bbf327-410a-403a-bbe4-bbfc67ff3dd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f0310854ada521ddf7b77d74584c5c2a 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2720019, "nc": 129}, {"path": "/@pixsg404/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2720019, "client_id": 891338, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/357d30ea/upl