orks": [{"path": "/@pixsg404/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2720019, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72f1f2af/uploads/origins/30f096a5-ad02-45ab-887e-b4ea0c152d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0acc725393f7408934e62d7a31e528c", "srcset": "https://si.imgix.net/72f1f2af/uploads/origins/30f096a5-ad02-45ab-887e-b4ea0c152d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0acc725393f7408934e62d7a31e528c, https://si.imgix.net/72f1f2af/uploads/origins/30f096a5-ad02-45ab-887e-b4ea0c152d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c470e7a7a5c7820858a7a3375fb4f6ec 2x, https://si.imgix.net/72f1f2af/uploads/origins/30f096a5-ad02-45ab-887e-b4ea0c152d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12d959742efee6ad9c47201f0df06599 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72f1f2af/uploads/origins/30f096a5-ad02-45ab-887e-b4ea0c152d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b0fc2f42b2bcff1a350edd989a70601", "srcset": "https://si.imgix.net/72f1f2af/uploads/origins/30f096a5-ad02-45ab-887e-b4ea0c152d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b0fc2f42b2bcff1a350edd989a70601, https://si.imgix.net/72f1f2af/uploads/origins/30f096a5-ad02-45ab-887e-b4ea0c152d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=593310fe25768f1bc8af0fe724a06f14 2x, https://si.imgix.net/72f1f2af/uploads/origins/30f096a5-ad02-45ab-887e-b4ea0c152d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=876f07a1644e75fe7b06353e2f0ffad3 3x"}, "body": "すがさん、お久しぶりです。\n以前ベールが敵キャラに変身するシチュを依頼した者です。今でも読み返したりして楽しんでおります。ありがとうございました！\n今回はその続き(?)を依頼したくお投げしました。\n長文となり申し訳ございませんが、内容に移ります。\n\n【概要】\nベールが大人ボディなブランに変身(コスプレ)する漫画。\nブランとなったベールの姿をメインに沢山見たい。\n\n【登場人物】\n・ベール(無印)\n前回から元の姿に戻り、着せ替えマシンの危険性から管理する事に(本心は独占したいだけ)\n\n・着せ替えマシン\n前回からモンスター変身機能を残しつつ、バグ修正された。\nただし別キャラの衣装を選択すると、ボディスタイルはそのままに変身させるバグがある\n\n・偽ブラン(無印衣装)\nベールが着せ替えマシンで変身した姿。大人の最強ムチムチ巨乳ボディ。\nベールの意識は上書きされ、ブラン本人だと思っている。\n性格や口調はブランだが、念願の大人ボディを入手した影響で巨乳やスタイルを自慢しマウントする癖がある。\n女神化は出来ないが、戦闘能力がバグでカンストしてる\n\n・ブラン(無印)\nベールとシェアエナジー集めの相談をする為にリーンボックスに来た。\n\n【偽ブランの姿】\n・身体やスタイルはベールのまま\n・瞳の色もベールのまま\n\n・髪型や髪色はブランに変化\n・衣装の丈はベールに合わす。ただしパツパツな胸や太ももの食い込み、お尻の主張で色気がすごい\n\n【話の流れ】\n①自室で着せ替えマシンを触るベール、間違えてブラン(無印)の衣装を選択。偽ブランに変身して驚く\n\n②ベールの意識や記憶がブランに書き換えられる。自身がベールである事を忘れ［これならベールにも勝てる］と巨乳を持ち上げたり、揉んだり、胸を強調するポーズを取り調子に乗り出す。\n\n③ブラン本物が到着し、偽ブランに挑む(女神化は無し)\nしかし自信満々な偽ブランに胸を見せ付けられ、胸を押しつけられ、触らせ煽られ巨乳マウントを何度もされてしまい...本物は完全敗北［実は自身が偽物(或いは妹)だったのでは？］と現状逃避。\n\n④ブラン本人としてルウィー守護女神に成り代わった偽ブラン。圧倒的な大人の魅力で大量のシェアエナジーを集める。\n後日ベールは元の姿に戻ったが、シェアエナジーを集めた感謝状が届き困惑したとか。\n\n以上、ご検討頂けると幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pixsg404/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2720019, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24a38c14/uploads/origins/a49e7b2c-3abf-42ff-85a2-cbe4b055e515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b60b5f73a65e2474b516f3a8a7a30c45", "srcset": "https://si.imgix.net/24a38c14/uploads/origins/a49e7b2c-3abf-42ff-85a2-cbe4b055e515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b60b5f73a65e2474b516f3a8a7a30c45, https://si.imgix.net/24a38c14/uploads/origins/a49e7b2c-3abf-42ff-85a2-cbe4b055e515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2b4b23672f4758b0d6e71d35fbfa123 2x, https://si.imgix.net/24a38c14/uploads/origins/a49e7b2c-3abf-42ff-85a2-cbe4b055e515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=800c473bd29c714e337bcc98f9b9d8f9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24a38c14/uploads/origins/a49e7b2c-3abf-42ff-85a2-cbe4b055e515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b044da82cef9ba7c7a24e8b997047f9f", "srcset": "https://si.imgix.net/24a38c14/uploads/origins/a49e7b2c-3abf-42ff-85a2-cbe4b055e515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b044da82cef9ba7c7a24e8b997047f9f, https://si.imgix.net/24a38c14/uploads/origins/a49e7b2c-3abf-42ff-85a2-cbe4b055e515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4bfc7d5b185d38ca4be4f98ad8469af8 2x, https://si.imgix.net/24a38c14/uploads/origins/a49e7b2c-3abf-42ff-85a2-cbe4b055e515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=07cbec65b67af75f299610e75106aeb9 3x"}, "body": "はじめまして\nリクエストをよろしいでしょうか？\n希望キャラはホワハで、以下リンクの衣装を着せてください\n\nhttps://www.compileheart.com/mobile/app/mainichi_compileheart/lineup/img/whiteheart_01_img.jpg\n\n\n「内容」\nひょんなことからホワハが、白手袋をしたままの片方の掌の上に、黄色のドロドロに溶けた小さなスライヌを乗せている\nスライヌは異臭を放っており、ホワハはもう片方の手で鼻をつまみキレながらくさがっている\n\nホワハはバストアップで、手が強調されている構図でお願いします\nセリフや擬音・エフェクトなどもお願いします\n\n以上、差し支えなければよろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pixsg404/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2720019, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a3e8d43/uploads/origins/21423db9-d25d-48b5-8c48-da56d3b5b54a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de9166431124d458621700890e7d0f45", "srcset": "https://si.imgix.net/2a3e8d43/uploads/origins/21423db9-d25d-48b5-8c48-da56d3b5b54a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de9166431124d458621700890e7d0f45, https: