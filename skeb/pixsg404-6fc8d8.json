の夫）を描いてもいい。どんなストーリーにするかは自由です。あなたがかわいいと思うもの、楽しいと思うものを考えてください。\n\nユニの外見は、結婚指輪をしていて、お腹が目立っている感じでお願いします。髪はとても短く、刈り上げています。\n\nリクエストに応えてくれてありがとう。機械翻訳による誤訳があったらごめんなさい。\n\nhttps://neptunia.fandom.com/wiki/Uni/Image_Gallery?file=Uni_Mk2_Art_Book2.png", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pixsg404/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2720019, "client_id": 133586, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dba68816/uploads/origins/26a9a5f0-6a04-46b2-a61c-3b0c35df793c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a783ed68f9ab498c8764607d01e52b4", "srcset": "https://si.imgix.net/dba68816/uploads/origins/26a9a5f0-6a04-46b2-a61c-3b0c35df793c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a783ed68f9ab498c8764607d01e52b4, https://si.imgix.net/dba68816/uploads/origins/26a9a5f0-6a04-46b2-a61c-3b0c35df793c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7cd74d824926c90b0db8b36e2c59b50 2x, https://si.imgix.net/dba68816/uploads/origins/26a9a5f0-6a04-46b2-a61c-3b0c35df793c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1db7568af2476ccbac0a1aee3bdb1e9f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dba68816/uploads/origins/26a9a5f0-6a04-46b2-a61c-3b0c35df793c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2a9f3be78f50355898595c5ad895b87", "srcset": "https://si.imgix.net/dba68816/uploads/origins/26a9a5f0-6a04-46b2-a61c-3b0c35df793c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2a9f3be78f50355898595c5ad895b87, https://si.imgix.net/dba68816/uploads/origins/26a9a5f0-6a04-46b2-a61c-3b0c35df793c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&