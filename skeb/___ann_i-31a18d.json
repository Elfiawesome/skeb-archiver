資料内を参考にannさんのインスピレーションで自由に描いていただきたいです！構図やポーズなども好きに描いていただいて構いません。\n\nhttps://drive.google.com/drive/folders/1dFZi-UxTAlfNcm8iW7uUCDmTCbO3pgDz?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@___ann_i/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3019774, "client_id": 3311944, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c43a0222/uploads/origins/281e2243-b8d4-4d81-9ac1-58a62e22dc24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1a89fd37c636cac132a4ecd47387fba", "srcset": "https://si.imgix.net/c43a0222/uploads/origins/281e2243-b8d4-4d81-9ac1-58a62e22dc24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1a89fd37c636cac132a4ecd47387fba, https://si.imgix.net/c43a0222/uploads/origins/281e2243-b8d4-4d81-9ac1-58a62e22dc24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=779a59d0887c551fbe47f0bf4c93f31e 2x, https://si.imgix.net/c43a0222/uploads/origins/281e2243-b8d4-4d81-9ac1-58a62e22dc24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf8c4205c76314022d6af6e40c6762ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c43a0222/uploads/origins/281e2243-b8d4-4d81-9ac1-58a62e22dc24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69e59d808adbc89050b93a991f2fceb9", "srcset": "https://si.imgix.net/c43a0222/uploads/origins/281e2243-b8d4-4d81-9ac1-58a62e22dc24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69e59d808adbc89050b93a991f2fceb9, https://si.imgix.net/c43a0222/uploads/origins/281e2243-b8d4-4d81-9ac1-58a62e22dc24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0df5aee2d9a3b78d8b1a7db5d948256 2x, https://si.imgix.net/c43a0222/uploads/origins/281e2243-b8d4-4d81-9ac1-58a62e22dc24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cdc90171a2f00fd6fd489cce5612ee15 3x"}, "body": "初めまして！\nいつも陰ながら、素敵なキャラクターデザインに心をときめかせております。\n\nもしよろしければ拙宅のビスポHO3の立ち絵をお願いできないでしょうか。\nann様のデザインセンスに惚れておりますので、服装からお任せできたら嬉しいです。\nこちらはセッションで使用するのではなく、個人鑑賞用にアクリルスタンドを作りたいと思っています。そのため、背景透過のデータも一緒にいただけますと幸いです。\n（あくまで目的が目的ですので、座っていたりなど、ポーズは自由で構いません。全身があるとの意図で『立ち絵』との言葉を使用しています）\n\n………………………………………\n\n【ご依頼内容】\n内容:全身イラスト（服装のデザイン含）\n用途:個人観賞用アクリルスタンド\n納品希望形式:背景透過したPSD／解像度350\n\n………………………………………\n\n【キャラクターの簡易設定】\nアメリカンテーラー。\n超弩級のナルシストで負けず嫌い。\n自由至上主義。己こそが1位。己こそが自由マインド。\n己の容姿／肉体に絶対の自信を持っており、露出の多い格好を好む。\nとにかく派手なことが好き。\nちなみに愛馬がいる。\n\n………………………………………\n\nデザインは自由にしていただいて構いません。\n彼に似合うファッションをさせてください。\nもし服装のデザインからお任せするskebを受け付けていらっしゃらなければキャンセルしていただけますと幸いです。\nご縁がありましたら何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1N7oY-YDnnWZSAo71TNr_2T41QffMldfe?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@___ann_i/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3019774, "client_id": 956230, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f81b1732/uploads/origins/2838f94f-e766-44d0-9273-095c2fc15df0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b095d2e71f6db73e14324e955d1fbfee", "srcset": "https://si.imgix.net/f81b1732/uploads/origins/2838f94f-e766-44d0-9273-095c2fc15df0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b095d2e71f6db73e14324e955d1fbfee, https://si.imgix.net/f81b1732/uploads/origins/2838f94f-e766-44d0-9273-095c2fc15df0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea8297c95a12544ae47e577bcacf02e8 2x, https://si.imgix.net/f81b1732/uploads/origins/2838f94f-e766-44d0-9273-095c2fc15df0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06e615780b50fd238778ff4a7862f3b7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f81b1732/uploads/origins/2838f94f-e766-44d0-9273-095c2fc15df0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad3a4a39e10b6f31d540dff63aeb53d0", "srcset": "https://si.imgix.net/f81b1732/uploads/origins/2838f94f-e766-44d0-9273-095c2fc15df0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad3a4a39e10b6f31d540dff63aeb53d0, https://si.imgix.net/f81b1732/uploads/origins/2838f94f-e766-44d0-9273-095c2fc15df0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=958e2714a35e114e412c76a6b159f37e 2x, https://si.imgix.net/f81b1732/uploads/origins/2838f94f-e766-44d0-9273-095c2fc15df0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a0d9c496a6a1d9f8768e61f1adbc70ef 3x"}, "body": "𝒂𝒏𝒏 ⚁様初めまして！\n年齢性別問わず描ける幅広い絵柄と綺麗な塗りに駆け込ませていただきました！\nocを描いていただきたく失礼します。\n\n【ネタバレ無しストーリー詳細】\n宗教団体で大事にされ神の子と呼ばれていた少女とその子を誘拐した元信者の男の話\n\n【キャラクター】\n①ヘスティア　女 \n10歳 128cm 35kg\n大人びた物言いをする女の子\nツンデレ\n老人みたいな喋り方をする\nアクセサリーとかお出かけとか好き\n\n②アルヴァロ　男　\n30歳 186cm \n無愛想っぽい男\n①を揶揄ったりイジワルしたりする\n\n好き・趣味　釣り、海、①を揶揄うこと\n\nネタバレ無し資料↓\nhttps://photos.app.goo.gl/GWMx2532s7WSmKT46\n\n【関係】\n逃亡生活をしてイタリアを転々としている\n甘えてこない①の行動を察して②はさりげなく欲しいものを買ってあげたりする\nませた物言いをする①を②は茶化してよく喧嘩する(②は揶揄ってるだけ)\n\n【依頼内容】\nどのようなスタイルか分からないので基本お任せ致します！\n縦横サイズ不問です\n\n案として\n海沿い、もしくは水族館など海に関係するところを一緒に歩いている、旅している様子のカラーイラスト\n落書きの詰め合わせなど\n背景無しでも大丈夫です\n服装や時期なども全てお任せします\n\n\n【使用用途】 SNS等のアイコン/ヘッダー、グッズ作成(非商用)、鑑賞 \nocをお借りしている相手の方にも共有させていただきます\npsdデータで宛名など各レイヤー分けしていただけると嬉しいです\n\nご検討よろしくお願い致します！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1531619, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "でいたく", "screen_name": "Dei_Taku", "avatar_url": "https://pbs.twimg.com/pro