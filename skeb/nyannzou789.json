], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 91, "received_works": [{"path": "/@nyannzou789/works/60", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3362461, "client_id": 3037103, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c97f0e12/uploads/origins/61fa6cf4-afa9-4244-bd0d-a546182b86f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ac13d0e77219fab704624dd293f8675", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c97f0e12/uploads/origins/61fa6cf4-afa9-4244-bd0d-a546182b86f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98c7def4a79b0e69d8c7b469b472d5ba", "src_set": ""}, "body": "こんにちは！\n\nあなたの作風が大好きで、私のOCのためのアートワークをお願いしたいのです！\n\n彼女はツンデレなオネエサンで、元気いっぱいだったり、疲れきっていたりします（ピンクの雷の力を持っていて、使いすぎるとオーバーチャージしてしまいます）。\n\nASMRを録音している、3dioマイクの両脇にいる彼女の絵をお願いしたいです。片方はショートヘアで、いじわるそうに耳をなめていて、もう片方はロングヘア（参考までにgoogle driveを参照）で、熱い髪をなびかせながらのんびりと耳をなめています。作品に響くピンクの稲妻の火花を加えていただけると嬉しいです。\n\nアートワークは16:9でショルダーサイズを希望します。\n\nポーズの参考はこちら：https://drive.google.com/file/d/1zXlGcjawTUaRtLRuTBBGclCEBI9fueuz/view?usp=sharing\n\nhttps://drive.google.com/drive/folders/1QPZtfF70Th9A0kfHg4yOXnpahVIA6Vrz?usp=drive_link", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nyannzou789/works/59", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3362461, "client_id": 643056, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e6e5964/uploads/origins/612bd60d-2979-4406-bcc5-23480b04bf59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f1e7345fdc24488f510575640015888", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"sr