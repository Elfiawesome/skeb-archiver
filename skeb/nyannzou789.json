2028-49a4-b512-ebc4bf6f5067?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1185cf47f160b9b083f810297f57cb76", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3362461, "client_id": 3690803, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nyannzou789/works/56", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3362461, "client_id": 1608084, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e24aeb91/uploads/origins/1f68ee0e-5161-4c4a-8c4e-b95638d8a354?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92d3f02d15411b842ac0f583c3553ce1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e24aeb91/uploads/origins/1f68ee0e-5161-4c4a-8c4e-b95638d8a354?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71a809cb1faf38782d9acc467c58e0f4", "src_set": ""}, "body": "お世話になっております！またリクエストさせていただきます！\n\nキャラは前回と同じ子で、腋や胸、可能であれば足が見える構図だと嬉しいです。\n衣装はチーパオで、表情は照れてる様子か恥ずかしくて不機嫌な様子。\n\n他はすべてお任せいたします。\nハルト様が描きたいものがあれば自由に描いていただいて大丈夫です。\n\nお忙しいところ恐縮ですが、ご検討よろしくお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nyannzou789/works/55", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 3362461, "client_id": 1668612, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c59f11e/uploads/outputs/83e52ac0-2021-4887-b02b-dcd093bd6a4e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=b122835a73fc8f28c733ed1d570f9d96", "src_set": ""}, "duration": 3, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c59f11e/uploads/outputs/83e52ac0-2021-4887-b02b-dcd093bd6a4e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=877ccf45b0d6e0df65e7e205e3c70dd0", "src_set": ""}, "body": "ハルト様、初めまして。\n\n今回Skebで上がっていたバニーガールのアニメーションを拝見させていただきまして、ぜひ私のキャラのムービーをとご依頼をさせて頂きました。\n\n以下依頼内容となります。\n\n■キャラ資料\nhttps://drive.google.com/drive/folders/1RTFr9uYGukv5vTEiudiyEfXPnXYuHdy-?usp=drive_link\n\n■使用目的\nSNS及び各配信のトランジションでの使用\n\n■テーマ、構図やポージング\n上記の資料キャラを元に、以下のような銃を撃って最後にアニメーションが切り替わるようなトランジションムービーをお願いしてもいいでしょうか？\nhttps://youtu.be/zXvQ2nicElY?si=dZJk-FQzh18BLFFu&t=53\n\nもちろん上記のまんまではなく、銃の撃ち方などについてはアレンジを加えて頂いて構いません！\nハルト様が作ってみたい・盛り込みたい演出などありましたら、全然入れていただいて構いませんのでご自由に制作頂ければ幸いです。\n\nただ、基本画面切り替えでの演出だけは欲しいため、最後に正面を撃つもしくは爆発してなどの演出で切り替えなどしたいので、そちらだけお願いできればと存じます。\n\n髪型は以下で一応指定させて頂きますが、他の髪型でこれで作りたいと思われたものあればそちらを優先してください。\n\n資料の中に髪方一覧をまとめてますので、お手数ですが確認の上、お選び頂ければと思います！\n\nhttps://drive.google.com/file/d/1le2x1W89e4BYhcbIzAiQdesiMU3Vzhu2/view?usp=sharing\n\n銃については以下のような大口径の銃のようなものを元にキャラに使用頂ければと存じます\nhttps://i.pinimg.com/736x/8a/7e/8a/8a7e8ac4e3cebcbfdc23be0d1ecf71b9.jpg\n\nその際、白い銃について中のパーツの色をを薄紫にしていただければ非常に助かります…！\n\n以下、簡単な設定になります\n・男の娘（基本極貧乳の女の子ベースで大丈夫です）\n・小悪魔系+メスガキ要素\n・外見とは裏腹の艶めかしさ\n\n最後に配信のて、透過をして使いたいので、グリーンバックを適用した別途ファイルもよろしくお願いいたします！\n\n条件に問題なければ、何卒よろしくお願いいたします！", "nc": 144, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@nyannzou789/works/54", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": true, "creator_id": 3362461, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bcb4dc4d/uploads/outputs/21067ab3-926f-4684-82a5-ab0875ff73aa?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=19585a9664aff74bf8375c8c95b5f2db", "src_set": ""}, "duration": 3, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https