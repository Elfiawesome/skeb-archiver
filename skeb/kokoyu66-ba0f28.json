2B4lWSs6D\n\n《使用用途》\n・YouTube、TikTok、X(旧Twitter)、リットリンクなどの活動での使用\n(配信、動画のサムネイル、配信、動画内での使用、ポスト等でご使用させていただきます)\n・グッズ利用(販売する可能性がございます)\n・ネットプリント\n※上記使用用途について使用不可のものがございましたら、別レイヤーに記載していただけますと幸いです。\n\n《その他》\nキャラクターにつきましては、頭や髪の毛、ケモ耳、衣装などが見切れないように描いていただけますと幸いです。\nまた配信活動(サムネイル等)にもご使用させていただきたい為、背景が透過されている人物のみのイラストもいただけますと幸いです。\nファイル形式はpngまたはpsdを希望しております。\n\nご検討いただけますと幸いです。\n何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1mFOX8xmhtOyCC3iOPHa2l8oX7PMNylaO", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kokoyu66/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2891666, "client_id": 3588635, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ebc76a74/uploads/origins/dde995b9-5b51-4416-aadb-5fb1857dfd43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7807be5ab1a27790a39670a1ba56066", "srcset": "https://si.imgix.net/ebc76a74/uploads/origins/dde995b9-5b51-4416-aadb-5fb1857dfd43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7807be5ab1a27790a39670a1ba56066, https://si.imgix.net/ebc76a74/uploads/origins/dde995b9-5b51-4416-aadb-5fb1857dfd43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67076e2869ac4b8f7c9311f0937866fe 2x, https://si.imgix.net/ebc76a74/uploads/origins/dde995b9-5b51-4416-aadb-5fb1857dfd43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2deccc49c4e4f2f33119663e524c04c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ebc76a74/uploads/origins/dde995b9-5b51-4416-aadb-5fb1857dfd43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e34158bce27e81f415a394457a81a559", "srcset": "https://si.imgix.net/ebc76a74/uploads/origins/dde995b9-5b51-4416-aadb-5fb1857dfd43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cr