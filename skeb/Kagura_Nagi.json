・イメージカラー…ピンク、白、水色\n・モチーフ…天使、うさぎ\n・性格…頑張り屋、おっちょこちょい、可愛い\n\n○キャラクターデザイン資料\n資料URLをご覧下さい\n\n以上でございます。 \n上記の内容でのご依頼が難しい場合は、お手数ですがキャンセルいただけますと幸いです。  \n\nご検討、何卒よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1qDxMm8znESdnMCt_5NtaTxPxn3y6po7I/view?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Kagura_Nagi/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2826572, "client_id": 1179858, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aca54950/uploads/origins/a510cd25-6e30-4339-8ee1-797f16686b61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d366d7be65db96996fd57c517d0fe9d4", "srcset": "https://si.imgix.net/aca54950/uploads/origins/a510cd25-6e30-4339-8ee1-797f16686b61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d366d7be65db96996fd57c517d0fe9d4, https://si.imgix.net/aca54950/uploads/origins/a510cd25-6e30-4339-8ee1-797f16686b61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c5f3974bb24102e4171ac457e9e24b1 2x, https://si.imgix.net/aca54950/uploads/origins/a510cd25-6e30-4339-8ee1-797f16686b61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=198518351e0e349533b4e38aa1452418 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aca54950/uploads/origins/a510cd25-6e30-4339-8ee1-797f16686b61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9dc48300c0908b7e29bd1592013dcc6", "srcset": "https://si.imgix.net/aca54950/uploads/origins/a510cd25-6e30-4339-8ee1-797f16686b61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9dc48300c0908b7e29bd1592013dcc6, https://si.imgix.net/aca54950/uploads/origins/a510cd25-6e30-4339-8ee1-797f16686b61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop