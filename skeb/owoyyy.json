s/origins/b4c452e3-3119-462c-964e-6f4e8bbdd5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4210f51df39fde90e6ed9cf5277d162e, https://si.imgix.net/78fe6ed9/uploads/origins/b4c452e3-3119-462c-964e-6f4e8bbdd5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=277cc8c59025a52492b117f7defed918 2x, https://si.imgix.net/78fe6ed9/uploads/origins/b4c452e3-3119-462c-964e-6f4e8bbdd5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57ea2eee931607a0b9ff1a4fe87ac535 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78fe6ed9/uploads/origins/b4c452e3-3119-462c-964e-6f4e8bbdd5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2656592f97fd910833f46a5ffe70996c", "srcset": "https://si.imgix.net/78fe6ed9/uploads/origins/b4c452e3-3119-462c-964e-6f4e8bbdd5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2656592f97fd910833f46a5ffe70996c, https://si.imgix.net/78fe6ed9/uploads/origins/b4c452e3-3119-462c-964e-6f4e8bbdd5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b1eff7abc3f97523aa3da31c565e5f7 2x, https://si.imgix.net/78fe6ed9/uploads/origins/b4c452e3-3119-462c-964e-6f4e8bbdd5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e41f421c91dc372d21a6c72b820a6d3e 3x"}, "body": "こばん様\n\n以前、触手もののイラストをお願いしました。\nとても良いイラストありがとうございました。\n\n新たにリクエストをお願いしたいですが、今回は2次創作ものですので、合わなければキャンセルしていただいても大丈夫です。\n\n内容は\nショタの小さいペニスをフェラして射精させている\n\nキャラは\nアルティナ・オライオン　（軌跡シリーズ）\nhttps://www.falcom.co.jp/hajimari/story/erebonia.html\n\n・ショタは無毛でペニスは包茎\nショタのペニスは前回依頼したイラストがとてもよかったので、同じ感じでお願いします。\n前回と同じURLと文章を張り付けておきます。\nhttps://www.pixiv.net/artworks/129282228\nhttps://www.pixiv.net/artworks/125368056\nhttps://www.pixiv.net/artworks/126445645\n（皮が完全に被っているのが良いです。勃起しても皮を完全に被っている）\n\n　ショタは股間部分アップ、下半身のみでもよいです。描きやすいようにお任せいたします。\n　股間は唾液や精液でぬるぬるにしていただけたらうれしいです。\n\n・アルティナの状態\n　アルティナは全裸で無毛がよいです。（帽子もない方が良いです）\n　顔や口内に精液を出されている。\n　無表情というか恥ずかしそうな感じが良いです。\n　アルティナは上半身の描写でも良いです。お任せいたします。\n　\n・修正は黒線を希望します。\n\n下記はもし可能ならで良いです（無理に描かなくて大丈夫です）\n・アルティナがショタのお尻を撫でている。\n　もしくは、ショタの小さいペニスを指コキしながらのフェラ　どちらかがあったらうれしいです\n・背後から別のショタに胸を揉まれている。\n・もう一本、ショタの小さい包茎ペニスがある。\n　その場合、片方はフェラ、片方は指コキで射精させている。\n\n長々と書かせていただきました。\nご検討のほどよろしくお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@owoyyy/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8b6331c2/uploads/origins/122a01cb-a798-4feb-9069-92ad59269888?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b52c72ed03e3a4c51cc0be1bf220bd6", "srcset": "https://si.imgix.net/8b6331c2/uploads/origins/122a01cb-a798-4feb-9069-92ad59269888?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b52c72ed03e3a4c51cc0be1bf220bd6, https://si.imgix.net/8b6331c2/uploads/origins/122a01cb-a798-4feb-9069-92ad59269888?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11fe41d903e69e7d21dc39abb6ec6544 2x, https://si.imgix.net/8b6331c2/uploads/origins/122a01cb-a798-4feb-9069-92ad59269888?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9e200ee3417d24c91333bf4d82257d9 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3311200, "nc": 161}, {"path": "/@owoyyy/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3311200, "client_id": 856426, "vtt_url": null, "thumbnail_imag