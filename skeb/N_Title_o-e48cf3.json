で楽しむ用です。X(旧ツイッター)などのSNSで\nヘッダーやアイコン等には使用せず、スマホやタブレットの背景として使用させて\nいただく場合がございます。\n\n構図、表情、シチュエーションなどはお任せしますが、\n春も近いので桜の花びらが舞っていたら嬉しいです。\nまた、どこか闇がある雰囲気だとなおうれしいです。\n桜の樹の下に死体がある...みたいな....\n抽象的で申し訳ございませんが、notさんのお好きな感じで楽しく\n描いていただければ幸いです。\nnotさんの絵がとても好きなので、のんびり楽しみにしています。\n\nちなみに探索者の名前は\n早乙女 己乃斗(さおとめ きのと)です。\nどうぞよろしくお願い致します。\n\nhttps://drive.google.com/file/d/197Tper8X7ve4hg8t0THDwd-3JarW1rO2/view?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@N_Title_o/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1518710, "client_id": 1270206, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e5df8a13/uploads/origins/3d9a2eb3-e642-4277-bbf8-f8e3c3cc17c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95e4a9da3d932aa83b240acd723469f9", "srcset": "https://si.imgix.net/e5df8a13/uploads/origins/3d9a2eb3-e642-4277-bbf8-f8e3c3cc17c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95e4a9da3d932aa83b240acd723469f9, https://si.imgix.net/e5df8a13/uploads/origins/3d9a2eb3-e642-4277-bbf8-f8e3c3cc17c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82ddb70222953121488705ec7f994b82 2x, https://si.imgix.net/e5df8a13/uploads/origins/3d9a2eb3-e642-4277-bbf8-f8e3c3cc17c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbfa30a0eb5230ea477d6c1ebf7b6b3e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e5df8a13/uploads/origins/3d9a2eb3-e642-4277-bbf8-f8e3c3cc17c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3035a188c2c9a3082eb069f78bf53d58", "srcset": "https://si.imgix.net/e5df8a13/uploads/origins/3d9a2eb3-e642-4277-bbf8-f8e3c3cc17c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3035a188c2c9a3082eb0