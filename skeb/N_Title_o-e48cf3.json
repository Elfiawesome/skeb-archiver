n・サングラスは基本外さずにお願いします。\nサングラス以外は外していただいて構いません。\n・コルセットの着用、もしくはぴっちりとした体の線がわかりやすい服装。\nオーバーサイズの服装は好みません。\n\n\n【使用用途】\nX（旧Twitter）にてアイコンやヘッダー等に使わせていただく場合があります。\n\n\n【希望】\n依頼内容の通りです。\n納品形式はお任せします。\n\n\nご縁がありましたら何卒よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/125VbJ8hcEidP1YtJnJKxKWuZ6W8ey8EQ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@N_Title_o/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1518710, "client_id": 2062768, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5dae5707/uploads/origins/b6d92caf-4849-4c50-bb5c-9ee1e798be2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bce6d8687c24b840060488ad69ddf5a", "srcset": "https://si.imgix.net/5dae5707/uploads/origins/b6d92caf-4849-4c50-bb5c-9ee1e798be2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bce6d8687c24b840060488ad69ddf5a, https://si.imgix.net/5dae5707/uploads/origins/b6d92caf-4849-4c50-bb5c-9ee1e798be2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a5d23a2eb2c24b7f2c8b970648c41d2 2x, https://si.imgix.net/5dae5707/uploads/origins/b6d92caf-4849-4c50-bb5c-9ee1e798be2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e983693a8b7babe2995af2041b398560 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5dae5707/uploads/origins/b6d92caf-4849-4c50-bb5c-9ee1e798be2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a881f3418b4baeb3721c83b76dda06d4", "srcset": "https://si.imgix.net/5dae5707/uploads/origins/b6d92caf-4849-4c50-bb5c-9ee1e798be2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a881f3418b4baeb3721c83b76dda06d4, https://si.imgix.net/5dae5707/uploads/origins/b6d92caf-4849-4c50-bb5c-9ee1e798be2f?bg=%23fff&auto=f