数ですがどこかのレイヤーに商用利用不可の旨をかいていただきたいです。\n\n金額に不足がありましたら、再送をお願いします。\n何か不都合等があればキャンセルしていただいて結構です。\n以上です。長々とお読みいただきありがとうございました。\nご検討よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@minetoki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 284702, "client_id": 2662050, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e84885a1/uploads/origins/5eec78f3-a75b-45e8-a318-3b633d322615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d231c38aeb7c8e20d38c724edc341921", "srcset": "https://si.imgix.net/e84885a1/uploads/origins/5eec78f3-a75b-45e8-a318-3b633d322615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d231c38aeb7c8e20d38c724edc341921, https://si.imgix.net/e84885a1/uploads/origins/5eec78f3-a75b-45e8-a318-3b633d322615?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a6d59376a3f8d7a48ca09c72f4f1130 2x, https://si.imgix.net/e84885a1/uploads/origins/5eec78f3-a75b-45e8-a318-3b633d322615?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=489b262c5230dafe47b57ef91156b547 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e84885a1/uploads/origins/5eec78f3-a75b-45e8-a318-3b633d322615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2be5eca439664db3cccb7696fbb7a60a", "srcset": "https://si.imgix.net/e84885a1/uploads/origins/5eec78f3-a75b-45e8-a318-3b633d322615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2be5eca439664db3cccb7696fbb7a60a, https://si.imgix.net/e84885a1/uploads/origins/5eec78f3-a75b-45e8-a318-3b633d322615?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=417ccacbfed2116f65a8f5e4955d1733 2x, https://si.imgix.net/e84885a1/uploads/origins/5eec78f