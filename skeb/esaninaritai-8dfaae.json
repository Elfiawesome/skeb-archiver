いです。\n髪型はサイドポニーが固定のヘアスタイルだけど、下ろした髪の長さは中々あるかと思うのでヘアアレンジや小物などなどなこちゃんの好きなようにコーディネートしてあげてください♡\n\n依頼したイラストはSNS掲載やグッズ作成などに使用できたら嬉しいなと考えています。全体的に映る構図にしてもらいたいのと、お手数おかけしますが背景やレイヤーが分かれているものもいただけると嬉しいです。\n\nお忙しいとは思うけどよければ一度ご検討ください！\nまた、暑さが厳しい日々が続いているけれどお身体第一にしてね。あんまり表垢に来れていないけれどわたしはずっとずっとなこちゃんとのご縁を大事にしていきたいと思っています♡今も昔も大好きだよー！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@esaninaritai/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2680210, "client_id": 2067977, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75489c3d/uploads/origins/e754c894-440c-4dc4-ad55-39169b4d34eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50592fcf9d380d08afead2af70690886", "srcset": "https://si.imgix.net/75489c3d/uploads/origins/e754c894-440c-4dc4-ad55-39169b4d34eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50592fcf9d380d08afead2af70690886, https://si.imgix.net/75489c3d/uploads/origins/e754c894-440c-4dc4-ad55-39169b4d34eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c870f4c98f632aaa8d42b2b91b7addd2 2x, https://si.imgix.net/75489c3d/uploads/origins/e754c894-440c-4dc4-ad55-39169b4d34eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b651feae23b45d076dc84462b8ee5e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75489c3d/uploads/origins/e754c894-440c-4dc4-ad55-39169b4d34eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=436aa51daebbf4300a65101dbf5a6f68", "srcset": "https://si.imgix.net/75489c3d/uploads/origins/e754c894-440c-4dc4-ad55-39169b4d34eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=436aa51daebbf4300a65101dbf5a6f68, https://si.imgix.net/75489c3d/uploads/origins/e754c894-440c-4dc4-ad55-39169b