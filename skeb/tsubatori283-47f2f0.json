set": "https://si.imgix.net/cdb8689d/uploads/origins/33588eff-11aa-48ff-8c61-91bc01bbcc69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62d349c9bc91f990ba151e6ae2d0b57b, https://si.imgix.net/cdb8689d/uploads/origins/33588eff-11aa-48ff-8c61-91bc01bbcc69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9b1b7cf502931226129e9df5cc2d7f72 2x, https://si.imgix.net/cdb8689d/uploads/origins/33588eff-11aa-48ff-8c61-91bc01bbcc69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b28d1048e24a5267f3d452987debe951 3x"}, "body": "学校のトイレ個室で、私のオリジナルキャラクターが暴行を受けているイラストをお願いします。\n\nシャツは引き裂かれて胸が露わになり、スカートはお尻までめくれ上がっているか、足首まで下がっている状態にしてください。すでに長時間集団レイプされていたかのように、汗まみれで汚れた様子を表現してください。表情は非常に淫らなものにしてください。\n\nポーズや構図はご自由に描いてください。イメージをより明確に伝えるため、追加の参考画像を数点添付します。\n\nご検討いただきありがとうございます。\n\nhttps://catbox.moe/c/cnbwvo", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsubatori283/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 104669, "client_id": 314920, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ee0b891/uploads/origins/5472f855-e086-4c8f-b64a-56c27effb4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3f807399a6a06d0d040932018b5acf1", "srcset": "https://si.imgix.net/2ee0b891/uploads/origins/5472f855-e086-4c8f-b64a-56c27effb4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3f807399a6a06d0d040932018b5acf1, https://si.imgix.net/2ee0b891/uploads/origins/5472f855-e086-4c8f-b64a-56c27effb4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea289c0638ecfdbf8c14f727df2e887a 2x, https://si.imgix.net/2ee0b891/uploads/origins/5472f855-e086-4c8f-b64a-56c27effb4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=030f189f553c987357a74c1ed3e4dd8b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ee0b891/uploads/origins/5472f855-e086-4c8f-b64a-56c27effb4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d65b954e14d09db7121d0125c5e959a", "srcset": "https://si.imgix.net/2ee0b891/uploads/origins/5472f855-e086-4c8f-b64a-56c27effb4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d65b954e14d09db7121d0125c5e959a, https://si.imgix.net/2ee0b891/uploads/origins/5472f855-e086-4c8f-b64a-56c27effb4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d48f1d55ba25d2c1bf9a6adf83041bcc 2x, https://si.imgix.net/2ee0b891/uploads/origins/5472f855-e086-4c8f-b64a-56c27effb4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=04676c77a050e55d0bad5973b558d3ac 3x"}, "body": "始めまして\nつばトリさんのOC「マナ」ちゃんがとても好きだからうちの子とのイラストを依頼させていただきます\n\nキャラクター\nつばトリさんのOC「マナ」ちゃん\nうちのOC「イロナ」ちゃん\n\n二人が触手に負けて、苗床になるシチュでお願いします\nマナちゃんは服が殆ど破られ、裸シャツの状態\nイロナちゃんはインナーの姿で、胸と秘部のところが破られて両方晒される\n二人ともチョーカーとニーハイは残ってる\nhttps://skeb.jp/@tsubatori283/works/8\n二人とも下腹部にこのような淫紋付けられてる\n\n触手に負けた二人は触手の巣に連れて、拘束されて口とまんこが犯されてる\n二人のちっちゃいおっぱいに触手が絡み、搾ってるように乳首を虐めてる\n最初は嫌がってるが、段々快楽に負けて、最後は快楽堕ちで苗床になる流れでお願いします\n\n差分が大丈夫なら以下の流れでお願いします\n見せ槍＞まんこに挿入してピストン＞口にも挿入して上も下も犯す＞両方に射精＞事後\n堕ちたあと、ボテ腹と母乳溢れた二人はハート目で触手と交わるのを愉しんでる（上の差分のボテ腹、母乳、快楽堕ちハート目差分に）\n\nもし金額が足りないなら再要請をお願いします！\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1VNd3Ybw7VG32Ll0txASh2wEoAoiahrNJ?usp=drive_link", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsubatori283/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 104669, "client_id": 92287, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d908bd77/uploads/origins/f7e113f9-933a-4d44-aa50-ff8aa9469ce0?bg=%23fff&auto=format