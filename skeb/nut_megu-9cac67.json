053c67/uploads/origins/dccb0333-7911-4d51-9f35-af0394a2ea3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d341f3a7965455bc570cbe6200ee2430, https://si.imgix.net/64053c67/uploads/origins/dccb0333-7911-4d51-9f35-af0394a2ea3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bcf46538e06961306eeb8a3477a52874 2x, https://si.imgix.net/64053c67/uploads/origins/dccb0333-7911-4d51-9f35-af0394a2ea3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9fbd32f2c09de0c1fff84613520c2211 3x"}, "body": "夏メグ先生、こんにちは！\n\n夏メグ先生のギャラリーを拝見しました！もしよければ、私のVtuberのキャラクターをお願いしたいです！また、その作品をステッカーにして友達にプレゼントしたいです！(NGな場合は遠慮なくお断りしてください！)\n\n彼女は遊び好きで、よく笑い、きれいな景色を見るために旅行するのが好きです！花柄の袴を着てほしいです！具体的なデザインや柄はお任せしますが、デザインに興味のない方は参考のもので結構です！できれば、タピオカミルクティーのカップを持たせてもいいですか？ポーズやディテールはお任せします！\n\n本当にありがとうございました！よろしくお願いします！\n\nhttps://drive.google.com/drive/u/1/folders/1EhppDOWX40JDKs4Yf9AvQRkD4RMRLNX4", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nut_megu/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2058473, "client_id": 2512792, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a68bdd23/uploads/origins/084cfebd-9628-45d8-b99b-ef6a9e3c8715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33c8ef9787a79ff93fda7389a92a0503", "srcset": "https://si.imgix.net/a68bdd23/uploads/origins/084cfebd-9628-45d8-b99b-ef6a9e3c8715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33c8ef9787a79ff93fda7389a92a0503, https://si.imgix.net/a68bdd23/uploads/origins/084cfebd-9628-45d8-b99b-ef6a9e3c8715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cca05b00b9c60b996d3d9c092041ed7 2x, https://si.imgix.net/a68bdd23/uploads/origins/084cfebd-9628-45d8-b99b-ef6a9e3c8715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca2c98b88b68e3496c535f50fe5b6bf2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a68bdd23/uploads/origins/084cfebd-9628-45d8-b99b-ef6a9e3c8715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=989b9949ad07dcd155d497d39c418854", "srcset": "https://si.imgix.net/a68bdd23/uploads/origins/084cfebd-9628-45d8-b99b-ef6a9e3c8715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=989b9949ad07dcd155d497d39c418854, https://si.imgix.net/a68bdd23/uploads/origins/084cfebd-9628-45d8-b99b-ef6a9e3c8715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6396a13b23cc812333227775d41e0e3c 2x, https://si.imgix.net/a68bdd23/uploads/origins/084cfebd-9628-45d8-b99b-ef6a9e3c8715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1afc50c85090e63446fd02676d8afd15 3x"}, "body": "夏メグ様\n\n初めましててぃんと申します。\nXで先生の可愛らしいSDイラストを拝見し、ご依頼したいと思いこの度リクエストさせていただきました。\n\n【依頼内容】\n個人Vtuberの『夢灯めろう』さんを描いて頂くことは可能でしょうか？\n\n【構図・シチュエーションなど】\n構図としては、とても歌が上手なVtuberさんなので楽しく歌っている感じでお願いしたいと思います。\n背景などは先生にお任せします。\n可能であれば目を開いているのと閉じているので2種類描いていただけるとありがたいです。\n\n【使用用途】\n・ファンアートとして夢灯めろうさんにプレゼントしたいと考えております。\n・夢灯めろうさんご本人の配信活動(YouTube、Twitch（収益化済み）、Twitterなど)での使用を許可していただきたいと思います。\n\n【納品形式】\nまたお手数をお掛けしますが可能であればpsd形式で人物と背景を分けていただけると幸いです。\n\n【参考資料】\n夢灯めろうさんの立ち絵\nhttps://twitter.com/mellow_gamedayo/status/1523242297470906368?s=20&t=ER8u_S4M5uRO8a4lehFVIw\n\n初めてのリクエストですので、至らぬ点がありましたら申し訳ございません。\nご検討よろしくお願いいたします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nut_megu/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2058473, "client_id": 2859252, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a2e2663/uploads/origins/7e9bdd4a-4f0d-4770-805f-d97b73b14f25?