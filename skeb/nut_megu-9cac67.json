頂く可能性もございますので\nそちらの使用許可を頂きたく思います。\n\n上記の可能性がございますので納品の際は、人物と背景をレイヤー分けして頂きPSDファイルにてお願い致します。\nまた納品時に、夏メグ先生に描いて頂いた旨をTwitterで投稿させて頂きたく思いますので、こちらの許可も頂けたらと思います。\n以上、なにか失礼がありましたら大変申し訳ありませんが、ご検討の程よろしくお願い致します。\n\n以下参考資料の立ち絵や3面図になります。\n\nhttps://drive.google.com/drive/folders/1FW8cIpfN3wQbdhEbhq1-7AiQQGmrxtM4?usp=sharing\n\nhttps://lit.link/alululia", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nut_megu/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2058473, "client_id": 255335, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/233aece9/uploads/origins/01a25cde-2384-4b41-9365-ca9077ed2e80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0479d7c48c8f1893a0f1cb15ea3a0f2", "srcset": "https://si.imgix.net/233aece9/uploads/origins/01a25cde-2384-4b41-9365-ca9077ed2e80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0479d7c48c8f1893a0f1cb15ea3a0f2, https://si.imgix.net/233aece9/uploads/origins/01a25cde-2384-4b41-9365-ca9077ed2e80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95c355cccf05ffd759a44c4304364fd1 2x, https://si.imgix.net/233aece9/uploads/origins/01a25cde-2384-4b41-9365-ca9077ed2e80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71a29ea2f40d67ed83230c87430747b7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/233aece9/uploads/origins/01a25cde-2384-4b41-9365-ca9077ed2e80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6914b033ae78e1762e1a5b571925f93a", "srcset": "https://si.imgix.net/233aece9/uploads/origins/01a25cde-2384-4b41-9365-ca9077ed2e80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6914b033ae78e1762e1a5b571925f93a, https://si.imgix.net/233aece9/uploads/origins/01a25cde