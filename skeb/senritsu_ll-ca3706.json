le.com/drive/folders/1HzTEYMYWjkL3xQunO1J4SKtn9vzPkPu8", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 58932, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "𝑯𝑨𝑲 🌗", "screen_name": "J0upiter", "avatar_url": "https://pbs.twimg.com/profile_images/1575067189987930112/sW_EcS-v.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 608138, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Fさん。", "screen_name": "F78654923", "avatar_url": "https://pbs.twimg.com/profile_images/2022303472339894272/3G_YYQj-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1195938799424962560/1759496985/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 17}, {"id": 3488679, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ゆんぞう", "screen_name": "yunzo222", "avatar_url": "https://pbs.twimg.com/profile_images/1887824189857599488/NSTFJIik.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1637103419247984642/1724548902/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 3633882, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ナカタ", "