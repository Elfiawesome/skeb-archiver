at%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c69a05051ba2b260624a18a2b2ca4f10, https://si.imgix.net/484941fc/uploads/origins/ca7cb28f-5b60-4353-85b8-8c916dbe0587?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52b81c3f5f83676a47172fee6f952937 2x, https://si.imgix.net/484941fc/uploads/origins/ca7cb28f-5b60-4353-85b8-8c916dbe0587?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50a16b90d88288408fc7c11d91476172 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/484941fc/uploads/origins/ca7cb28f-5b60-4353-85b8-8c916dbe0587?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d34e63df9f592c531de3da39e6427597", "srcset": "https://si.imgix.net/484941fc/uploads/origins/ca7cb28f-5b60-4353-85b8-8c916dbe0587?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d34e63df9f592c531de3da39e6427597, https://si.imgix.net/484941fc/uploads/origins/ca7cb28f-5b60-4353-85b8-8c916dbe0587?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b75b8794d459964f382b19058549ad62 2x, https://si.imgix.net/484941fc/uploads/origins/ca7cb28f-5b60-4353-85b8-8c916dbe0587?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=197ac18cb909d4b80f65e7983f8876e3 3x"}, "body": "初めまして。この度はオリジナルウマ娘である【トキノカラミティ】のコミックをお願いしたいです。\n世界観はウマ娘こち亀ダービーでお願いします。\n\n■内容\n\n起:深夜にプラモデルを作っている両さんが段々強くなっていく振動から地震と勘違いして派出所の外に飛び出た瞬間、トキノカラミティが目の前を駆け抜けていく。夜間で明かりも少ないのに、時速120kmで駆け抜ける巨体を記憶する両さん。\n\n承:トレセンのジャージを着て走っていたため、ゴルシちゃんらとその巨大なウマ娘を探す。食堂で犬食いで食事をしているトキノカラミティを発見。連行。両さんに食べ方の汚さを説教されるトキノカラミティ。\n\n転:自己紹介後、競走能力を確認するためにトキノカラミティを走らせようとするが嫌がって走らない。押し問答をしていればたづなさんがやってきて、トキノカラミティが「師匠ーー！」と言いながらたづなさんの方に走っていく。両さんとトキノカラミティの言葉を頷きながら聞くたづなさん。\n\n結:たづなさんの命令で1本だけ走ることになったトキノカラミティ。その圧倒的な能力で他のウマ娘を200馬身以上引き離しゴール。あまりの強さに驚愕する両さんとドン引きしながらゴールする面々。両さんはこんなに強いのに、自分の記憶に【トキノカラミティ】という競走馬は存在しないと不審に思った次の瞬間、たづなさんに気絶させられる。\n　翌日にはトキノカラミティに関わったウマ娘含めて、全員前日の記憶が曖昧な状態。たづなさんに聞こうとしても、上手く言いくるめられてしまう。その奥の方ではシルエットのトキノカラミティが走っている。\n\nというコミックをお願いしたいです。\n筋肉や胸の盛り方は描きやすいように行って大丈夫です。\nトキノカラミティの身長は511cmです。\n\n■追加資料\nhttps://www.pixiv.net/novel/series/11208494\n\nhttps://drive.google.com/drive/folders/1HwpQl0WuxKjbovxWcrkL5CblyXwSQp6j?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1615805, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "バロガー@GSF03-7組45", "screen_name": "vabaloro", "avatar_url": "https://pbs.twimg.com/profile_images/1509899115647619072/tlwKv_N7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/211114350/1648822978/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 136}, {"id": 2181120, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "KOPPERION", "screen_name": "kopperion", "avatar_url": "https://pbs.twimg.com/profile_images/1673352724078022659/2x9aXF7-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1064114824970268672/1763388179/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 144}, {"id": 2951609, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "River &Lake", "screen_name": "RiverLake778078", "avatar_url": "https://pbs.twimg.com/profile_images/1871520450276425728/gc_BP0KT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1667710824826408961/1766576396/1