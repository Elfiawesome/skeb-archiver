いましたら別レイヤーにてお知らせいただけますと幸いです\n\n【納品形式】\n人物と背景、サイン等がレイヤー分けされた\nPSDデータでいただけますと幸いです。\n\nもしご縁がございましたら、星羊おメガを先生のステキな絵柄で描いて頂きたいです。\nよろしくお願い致します。\n\nhttps://drive.google.com/file/d/1eCcUMQ7GfxxR5NZmAFzhcyTBlnK45O4l/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ponponponchan01/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2287709, "client_id": 456870, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28c39049/uploads/origins/b4e73f94-728f-429e-8395-45b1d56ab5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ffaba9befc0f8edb1a13a33b9c3a093", "srcset": "https://si.imgix.net/28c39049/uploads/origins/b4e73f94-728f-429e-8395-45b1d56ab5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ffaba9befc0f8edb1a13a33b9c3a093, https://si.imgix.net/28c39049/uploads/origins/b4e73f94-728f-429e-8395-45b1d56ab5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8cabd58bafdfe92d01148c93d904ec5c 2x, https://si.imgix.net/28c39049/uploads/origins/b4e73f94-728f-429e-8395-45b1d56ab5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fda7e02002988183e1cc9816e2a04e58 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28c39049/uploads/origins/b4e73f94-728f-429e-8395-45b1d56ab5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=548cbed5e50c8f837a21b27f0b50501f", "srcset": "https://si.imgix.net/28c39049/uploads/origins/b4e73f94-728f-429e-8395-45b1d56ab5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=548cbed5e50c8f837a21b27f0b50501f, https://si.imgix.net/28c39049/uploads/origins/b4e73f94-728f-429e-8395-45b1d56ab5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200