に個性があると嬉しいです。\nこの曲は、「誰にも見せない夜の顔」のような存在であってほしいと思っています。\n\n以上、ご検討の程何卒よろしくお願い申し上げます。", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@aruna_ryuki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": true, "creator_id": 3795664, "client_id": 1659889, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1ca6fb6b5e4a7c5bcd62e55338f78d", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1ca6fb6b5e4a7c5bcd62e55338f78d, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c108b40f0ff9148f8eacfc8aaf193c31 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=718d43bfc75bb5759bbcb9389302a9d9 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/b88648dc-443b-4b62-ba07-fdc814cf543a?response-content-disposition=inline&Expires=1783792779&Signature=SkGRjc-AFNVyHP6wZnBT2UkpSJ5iicrhtNyeqo-UGDEaZHXwiASnuDp9K2ugGPC52YE6cRiJLb3OqCV6-nuAJl74wOir7Jkoux0XMfpV6rC0X~fmBM9xpERmtNiXmNtDLdEYz8PR7kJ~dxmT-WTlzGxNRl0hwtbpcRT-qHqDPQlINYvtoNDsgBdrWDen0hNDeOCh4KjxGKpKkHt1Z5W3P3aQf-i3Ri4q8NxfGyvg6mY-Z1KlmFbZh9QOl6sWzQ5yeBBnK4NBKg0882YyonwSBcFtTQb~mtI8OfPHf0R93Aj-szSpJ7wlzwoHJzLxOL4MOcEl-sWxMysOJ9zVF~rHBw__&Key-Pair-Id=K1GS3H53SEO647", "duration": 96, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F19