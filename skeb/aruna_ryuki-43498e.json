983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c108b40f0ff9148f8eacfc8aaf193c31 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=718d43bfc75bb5759bbcb9389302a9d9 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/561e3fe2-193e-43af-93ae-39fe329d79a9?response-content-disposition=inline&Expires=1783792779&Signature=QCCzG2ol1xaXJrXpI4S8zkm9LPhWjH-36DyyTXHmjKvwhfjxM6VXbhQCm9eoEu08W6zmicAugda9iNmK3apzKLyCs-IoZtUxwWjVUexx2HybyPLobgyfuXPtgyim6IeUhlWZsOvWG-iBbpUkweabjLplrsbDscO1pTHBVi99qy1TpxOTZrzl919FtDBrAyuxE4kNfjKmuOQAS07hXBmNxgyeBE1u0wg5r5ewX1NAhYor0y2w1d3sek63DIUrOj25p3Rl4mNOu7BTBYPGXyfhAw97NZLQW5QU~5fWt9Yy-RNMGQScybwaqaD4Ow5mRMrAo-X10xkqVUoa8BkKMfgBLA__&Key-Pair-Id=K1GS3H53SEO647", "duration": 100, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9f311dcd45e8d93de9e24f003fac6d7", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9f311dcd45e8d93de9e24f003fac6d7, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7d4870659770a13143ff7e0cd7d38945 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=89cdf54b806f86043bf1bde4263ad3ba 3x"}, "body": "こんにちは。\nALNEARさんに、私のオリジナルゲームのスタート画面用BGMを制作していただきたく、ご連絡いたしました。\n\nゲームジャンル：恋愛向けビジュアルノベル\n世界観：架空ファンタジー\n舞台背景：アラブ・エジプト・オスマンの要素を融合した世界\n\n【BGMについて】\n砂漠の雰囲気を感じさせ、\nゆっくりとしたテンポで激しい部分は不要です。\n神秘的で、どこか孤独な雰囲気を持つ曲にしてください。\n\n【使用用途】\nゲームのスタート画面で再生するBGMです。\n長さ：1分30秒～2分程度で、ループ再生に対応したものをお願いいたします。\n主旋律がはっきり聴こえる曲を希望します。\nフレーズの繰り返しは4回以内に抑えてください。\n\n【その他】\nゲームは個人制作となります。\n公開する際には、作曲者として先生のお名前をクレジットに記載いたします。\n参考用に、男女主人公のイラストを別途送付いたします。\n可能でしたら、MP3とWAVの両フォーマットで納品していただけると大変助かります。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1OsLyxtwJhbjOiddA2GcURyZ8pSpFiPvO", "nc": 145, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@aruna_ryuki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": false, "creator_id": 3795664, "client_id": 3334464, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1ca6fb6b5e4a7c5bcd62e55338f78d", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1ca6fb6b5e4a7c5bcd62e55338f78d, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c108b40f0ff9148f8eacfc8aaf193c31 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=718d43bfc75bb5759bbcb9389302a9d9 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/34769fbf-f8db-4b17-b53c-5f64b11c47c9?response-content-disposition=inline&Expires=1783792779&Signature=kSwR9bdlu1yiOks4HkcPoQDx8-2ofCELimytXvnZmteezXbJ~1zRp06CaiBPxIdje1kJN698t3HO56kikwKvQjvuzGfdU6Ya6n~2iBN9UJKm~lpt