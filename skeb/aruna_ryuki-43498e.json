公のイラストを別途送付いたします。\n可能でしたら、MP3とWAVの両フォーマットで納品していただけると大変助かります。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1OsLyxtwJhbjOiddA2GcURyZ8pSpFiPvO", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@aruna_ryuki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": false, "creator_id": 3795664, "client_id": 3334464, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1ca6fb6b5e4a7c5bcd62e55338f78d", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1ca6fb6b5e4a7c5bcd62e55338f78d, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c108b40f0ff9148f8eacfc8aaf193c31 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=718d43bfc75bb5759bbcb9389302a9d9 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/34769fbf-f8db-4b17-b53c-5f64b11c47c9?response-content-disposition=inline&Expires=1795029574&Signature=C8Q3JYCbx3R7Vuyyr4PmboMxDeSkefQpyR7CJ4YtbXV8ILkfedSGEp3FEl5F8Z5cWzS5~VFuWpr5tujkxEYWP3OXw9tHCcDUXybJol-phFYRVS6PD43WDILMyZUBc9O6vMdIHihARC6V-2Iseyaw~ZUJgm4nUr1cz~e9jfKu9O7fmN6oON7jldVDCKaUgzJsMQmN37GFak5a9PuT8ZndTRjDa9454fIY-Q0S1rH5ZBDXKnG63e7nzUsXWmFfNZXa87j1VTrpXTOe7uGNkCSMYl3HgHACh9fhyepTvCyBZMkV0v5sj3MWKzzUks-fTqSkrIraEE9VuHwz3tWzYisVXA__&Key-Pair-Id=K1GS3H53SEO647", "duration": 192, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "