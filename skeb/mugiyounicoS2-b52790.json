目をしています。髪はオレンジとブラウンのツートンカラーで、ブロンド色の筋が入っています。これも彼女にとって大切なものなので、どうか忘れないでください！\n\nラブライブも描かれているようなので、矢澤にこグッズと一緒に描いていただけないでしょうか！でも、ダメならわかります！<3\n\nどんなポーズでも構いません！この画像はストリーミング活動、youtube、ソーシャルメディアに使用したいと思います！できれば透過バージョンもお願いします。ご検討いただき、本当にありがとうございました！\n\n\nhttps://drive.google.com/drive/folders/1tqpkxFfDYoxcpJtH4iTYJvN3pu32rHi_?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mugiyounicoS2/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3756293, "client_id": 3313133, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1657e55a/uploads/origins/4e7d78c8-fff7-4425-9d12-53a21b87ed61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e64f36621cdbc4fd524009198aaa90d", "srcset": "https://si.imgix.net/1657e55a/uploads/origins/4e7d78c8-fff7-4425-9d12-53a21b87ed61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e64f36621cdbc4fd524009198aaa90d, https://si.imgix.net/1657e55a/uploads/origins/4e7d78c8-fff7-4425-9d12-53a21b87ed61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afb89faa5c334385d81410c1e06c4f43 2x, https://si.imgix.net/1657e55a/uploads/origins/4e7d78c8-fff7-4425-9d12-53a21b87ed61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dee146f6e2c42f8a8d1f284ba170c4dd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1657e55a/uploads/origins/4e7d78c8-fff7-4425-9d12-53a21b87ed61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=923dfd51f908a9cd46cc734d08949cbf", "srcset": "https://si.imgix.net/1657e55a/uploads/origins/4e7d78c8-fff7-4425-9d12-53a21b87ed61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=923dfd51f908a9cd46cc734d08949cbf, https://si.imgix.net/1657e55a/uploads/origins/4e7d78c8-fff7