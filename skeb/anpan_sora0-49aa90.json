e0/uploads/origins/9e50003e-3925-4a34-aca2-3586cb19967f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c7996ce84d113bfb92d400bbdb0f091, https://si.imgix.net/c27792e0/uploads/origins/9e50003e-3925-4a34-aca2-3586cb19967f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa231b866c73f49e5ab12e3a868321cb 2x, https://si.imgix.net/c27792e0/uploads/origins/9e50003e-3925-4a34-aca2-3586cb19967f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e482038debad5a9ed0ee41048f083845 3x"}, "body": "はじめまして。\n東京タワーコラボのスーツ姿の志麻様のイラストがとても素敵で、イラストをお願いできればと思いご連絡させていただきました。\nコラボ時のスーツ志麻様のかっこいいイラストをお願いしてもよろしいでしょうか。\nポージングや表情はすべてお任せいたします。スーツ姿でしたら先生がお好きな作品を元にしたパロディにしていただいても結構です。\nご検討いただけましたら幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@anpan_sora0/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1678959, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d80d40b/uploads/origins/f285b63f-9ef5-46e3-a13a-85a9c60abdd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f9dc7be63e4024e5210b6321383170b", "srcset": "https://si.imgix.net/7d80d40b/uploads/origins/f285b63f-9ef5-46e3-a13a-85a9c60abdd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f9dc7be63e4024e5210b6321383170b, https://si.imgix.net/7d80d40b/uploads/origins/f285b63f-9ef5-46e3-a13a-85a9c60abdd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12e883a279196eea279e563107e8d8a3 2x, https://si.imgix.net/7d80d40b/uploads/origins/f285b63f-9ef5-46e3-a13a-85a9c60abdd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a546c2fca811b2c0c5d696868addc45 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d80d40b/uploads/origins/f285b63f-9ef5-46e3-a13a-85a9c60abdd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cebe125c243cd8738032982f0ed1751f", "srcset": "https://si.imgix.net/7d80d40b/uploads/origins/f285b63f-9ef5-46e3-a13a-85a9c60abdd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cebe125c243cd8738032982f0ed1751f, https://si.imgix.net/7d80d40b/uploads/origins/f285b63f-9ef5-46e3-a13a-85a9c60abdd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d330fa16a1f1791730206e2c598e618b 2x, https://si.imgix.net/7d80d40b/uploads/origins/f285b63f-9ef5-46e3-a13a-85a9c60abdd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f6ee52b4e3865fa01d91e2683a568ae4 3x"}, "body": "リピート依頼になります! \nBNAの影森みちると日渡なずなの二人がダブルパイズリフェラしてくれる絵をお願いします！\n基本絵はダブルパイズリしてる絵に差分形式でお願いします！\nパイズリフェラ参考(https://ibb.co/album/kVsZzF)\n\n1.爆乳を使ったダブルパイズリ。極太ちんぽにキスをいっぱいしてチンポの臭いを堪能しながら早くしゃぶりたがってるセリフ。\n\n2.まずはなずながジュルル♥ジュブブ♥と音を立ててネットリとバキュームフェラ。みちるが我慢できず急かすようなセリフと表情。\n\n3.おあずけされた分ジュポ❤︎ブポッ❤︎ブジュルルル❤︎と下品な音を立ててバキュームフェラをするみちる。なずなはまだ物足りないセリフと表情。\n\n4.盛大に射精されて顔やおっぱいが精液まみれの二人。涙と精液でメイクが崩れ、出された精液を舌に出したアヘ顔でフィニッシュ。どっちが気持ちよかったか聞くセリフとゲップ音。\n\nフェラ顔では唇の上にあるミゾの描写(人中)や目の下の涙袋の描写をお願いします。\n表情&効果音参考(https://ibb.co/album/PcjDsN)\n※唇が好きなのでフェラ描写で唇に修正が掛からないようにお願いします。\n\nセリフ内容はそらさんにお任せでお願いします！\n\n前回の依頼と同じくプルプル肉厚な唇にショッキングピンクのグロスリップと水色のグロスアイシャドウと長いまつ毛のメイク、長い付け爪にマニキュア、鼻や耳にピアスを付けた顔、二人とも爆乳デカ乳輪のbimboボディで勃起した長乳首にピアス有り。\n以前の依頼のようにみちるは頭の上にハート型のサングラスとbimboネックレス有り。なずなはツインテールでお願いします。\n参考(https://ibb.co/album/JRk4BP)\n\n背景は紫系の妖しいネオンカラーで、セリフは別レイヤーで分けてもらえるとありがたいです！\n今回も何卒よろしくお願いいたします！", "nc": 50, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@anpan_sora0/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1678959, "client_id": 35560, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9bab829b/uploads/origins/be101