da6-ac37-4c4e-b09d-fe82f5b061fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=68195c28d3b3f066674451631e247476 2x, https://si.imgix.net/52f7e9ea/uploads/origins/f8eaeda6-ac37-4c4e-b09d-fe82f5b061fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a958625b7c82fe207fca268de0cce9e2 3x"}, "body": "こんにちは。Twitter/Xであなたの作品を見て、私のオリジナルキャラクター（OC）のイラストを依頼したいと思いました。\n\n[詳細]:\nキャラクターには、スピーカーの上に座り、ギターを手に持って（演奏しているようなポーズで）、背後にモニターをいくつか配置してほしいです。表情や背景などは、あなたにお任せします。詳細はファイル内に記載しています。\n\n参考画像通りの再現は求めていませんので、クリエイティブなアレンジを歓迎します。\n\n[使用目的]: \nSNSやサムネイル（TwitterやYouTube）で使用し、その際は貴方のクレジットを明記します。\n\n可能であれば、レイヤー分けされたPSDファイル（背景、人物など）もいただけると幸いです。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/15ghiHk2bB0exSRgCplbamwOd5EPZRL4-", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Hrsm_wop/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3751510, "client_id": 3520844, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3d39d75/uploads/origins/a12b8d2b-47fe-4d0c-b4c1-4802122f0801?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2687f21484bdce4b16838cb3546d098c", "srcset": "https://si.imgix.net/e3d39d75/uploads/origins/a12b8d2b-47fe-4d0c-b4c1-4802122f0801?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2687f21484bdce4b16838cb3546d098c, https://si.imgix.net/e3d39d75/uploads/origins/a12b8d2b-47fe-4d0c-b4c1-4802122f0801?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5306b9c9c6ff5cdd1b1056cba4f3d2ab 2x, https://si.imgix.net/e3d39d75/uploads/origins/a12b8d2b-47fe-4d0c-b4c1-4802122f0801?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1eaf1f102a72fcf4966d40b8c31a82ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3d39d75/uploads/origins/a12b8d2b-47fe-4d0c-b4c1-4802122f0801?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6603cb69cf61b815b037240d527dafd", "srcset": "https://si.imgix.net/e3d39d75/uploads/origins/a12b8d2b-47fe-4d0c-b4c1-4802122f0801?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6603cb69cf61b815b037240d527dafd, https://si.imgix.net/e3d39d75/uploads/origins/a12b8d2b-47fe-4d0c-b4c1-4802122f0801?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=44eede4bc7bc21c3fcd6ca1ba96925a7 2x, https://si.imgix.net/e3d39d75/uploads/origins/a12b8d2b-47fe-4d0c-b4c1-4802122f0801?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=84f6d57e503bc327a136979442093613 3x"}, "body": "お久しぶりです綾ナギです。\n\n前回のイラストは蓮希るいちゃんもとても気に入っていただくことが出来、配信のサムネイルにもなりました。\n\nhttps://www.youtube.com/watch?v=LGK4Rq1zHrs\n\nこちらの配信になります。\n\nこの度は蓮希るいちゃんから直接イラストのお題をいただきましたので私が知る絵師様の中で一番はる様が上手であろう題材を描いていただくこの度リクエストをさせていただきます。\n\n＜内容＞\n個人VTuberの蓮希るいちゃんを描いていただきたいです！\n出来上がったイラストを蓮希るいちゃんへプレゼントさせていただきたいと思います。\n\n＜構図やポーズ＞\n可能であれば16：9のアスペクト比でお願いします。\nポリス服？のような衣装で手じょうを持ちながら逮捕しちゃうぞ？\nみたいな雰囲気のイラストを描いていただきたいです。\n「ポリス服っぽいの憧れるかも　手錠持ってる感じの！　にじさんじの栞葉るりさんみたいな感じのムチムチなスタイルの衣装がかっこよくて好き！」（原文ママ）\nにじさんじを推されているとのことですので衣装の理解度が高いのかなと勝手に思っております。\n間違っていればすみません。\n衣装が版権的に難しそうなのであれば雰囲気を寄せていただいたポリス服でお願いしたいです。\n\n可能であればASMRに使用出来そうなイラストを描いていただければなお助かります。\n蓮希るいちゃんはシベリアンハスキーの仔犬なので「仔犬のお巡りさん」のような雰囲気で若干幼めに描いていただけると助かります。\n\n頭部や左右が切れないようにしていただけると助かります。\n細かいポーズなどはおまかせでお願いします。\n可能でしたら表情差分をお願いします。\n\n＜ご本人様サイトからの注意点やお願い＞\n依頼をする際には、このページへのリンクまたはFANBOXのリンクを共有したのち蓮希るいのTwitterや収益化されたYoutubeチャンネルで使用される可能性があること」を依頼文で必ず伝えてください。\n\n▼skebまたは依頼したイラスト\npsdファイル/背景透過ファイルがあると嬉しいです。\n\nイラストレーター様にご依頼の際は、二次創作プログラム承認済みですので「蓮希るい」の名前を使用して許可済みだということをお伝えください。\n\n長くなってしまいましたがぜひご検討のほどよろしくお願い致します！\n\nhttps://lit.link/Hasukirui", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"pat