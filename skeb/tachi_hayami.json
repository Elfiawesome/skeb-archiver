le": false, "total_appeals_count": 0, "received_works": [{"path": "/@tachi_hayami/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 48742, "client_id": 3358830, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/484ada29/uploads/origins/5ac12071-a2ec-4059-b2af-9b916102ce7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a22dd713d2f97978881f8e6d57c6a7b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/484ada29/uploads/origins/5ac12071-a2ec-4059-b2af-9b916102ce7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b04f43f996d967e2012ca0ed7d596f8e", "src_set": ""}, "body": "はじめまして！\n\nXでタブレットで記録するエモートのイラストを見て\nとてもかわいかったのでリクエスト送らせていただきます。\n\nFF14のマイキャラクターを描いていたただきたいです。\n雰囲気はかわいいよりの中性的な感じだとうれしいです。\n\n衣装は軌跡シリーズのシズナ・レム・ミスルギの衣装でお願い致します。\n構図はタブレットで記録するエモートでお願い致します。\n髪型は https://skeb.jp/@umedashiso/works/7 首後ろで軽く結んで腰くらいまでの長さにアレンジ可能ならお願いします。\n表情はお任せします！\n\n使用用途は自身のディスクトップ背景やSNSのプロフィールアイコン、ヘッダーに使いたいです。\n\n参考資料\n・マイキャラ\nhttps://drive.google.com/drive/folders/1K8bIWIfN-616dbB-E8uVumzsFSCKETGa?usp=drive_link\n\n・シズナ・レム・ミスルギ\nhttps://www.falcom.co.jp/kuro/character/shizuna.html\nhttps://drive.google.com/drive/folders/1B4zzUxm2OoqSXZ3Uybwy-uGQQeBPNIjl?usp=drive_link\n\nご検討のほど、よろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tachi_hayami/works/39", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5ce17983/uploads/origins/9e4bbf3e-5b91-411b-bf0f-e87a4fb94699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=65d0b93546b0a6071288442e92d753dc", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 48742, "client_id": 2325815, "vtt_url": "", "thumbna