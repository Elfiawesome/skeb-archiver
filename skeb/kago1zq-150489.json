ます。見た目は大人っぽいですが、少女だったころのままの自分をずっと抱えていてふとした瞬間目の中が燃えているような感じです。\n\nkagoさまの好きなように描いていただけますと幸いです。ご確認のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1WWFpwzilvPSX8RkW81l9LX-UG09Z4KGJ?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 862697, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "なりなり", "screen_name": "nariko_1024", "avatar_url": "https://pbs.twimg.com/profile_images/2106582186493423616/o7tAxQDb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2714211458/1794659883/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 940866, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "しょしゅん@Skeb募集中", "screen_name": "19_SynC3170", "avatar_url": "https://pbs.twimg.com/profile_images/1800578705070428160/E-CVEsKu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/978272934094553088/1686138913/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 16}, {"id": 2639157, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ライム@Skeb始めました", "screen_name": "ranse237", "avatar_url": "https://pbs.twimg.com/profile_images/1655577168708087811/4qA2Bwz4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1442048826550878208/1681311875/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptab