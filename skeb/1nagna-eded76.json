4c8b-b813-6f4386bca07b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9835221d45c8ba439a768a9bb73fbeab", "srcset": "https://si.imgix.net/f939497b/uploads/origins/2f1b4763-0ef5-4c8b-b813-6f4386bca07b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9835221d45c8ba439a768a9bb73fbeab, https://si.imgix.net/f939497b/uploads/origins/2f1b4763-0ef5-4c8b-b813-6f4386bca07b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=55590be0373cc20aeca6681c4c3f8c66 2x, https://si.imgix.net/f939497b/uploads/origins/2f1b4763-0ef5-4c8b-b813-6f4386bca07b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe1e26c77ffef39496d2ded5fa7c05f7 3x"}, "body": "こんにちは！以前リクエストさせていただいたどこぞの妖精です。\nその節はありがとうございました…！ルンルンで待受に設定しました！\n手数料無料キャンペーンも始まったので、\n予告通り春、夏、秋バージョンのリクエストに参った次第です。\n\nリクエストを受けていただける場合、\nTwitterのプロフィールかURL欄にコウさんのSkebのアドレスを\n載せていただけると手数料無料になるので…！\nその辺りもご確認くださいませ…！\n\n●リクエスト内容\nキャラクター本体と和傘はそのままで、\n背景を春、夏、秋の3種類をお願いしたいです。\n小物類も季節に合わせて、とぼんやり考えていましたが、\n春～秋の和装小物が特に思いつかなかったので\n羽織のあり・なしで良いかと思います。\n\n●背景詳細\nそれぞれのイメージとしては、\n春：桜の木、桜が散る様子\n夏：緑が映える、日差しが強い\n秋：紅葉の木、紅葉や銀杏が散る様子\nといった感じです。\nこのイメージ通りだと、春に桜だった木が\n秋に紅葉になっている現象が起きるかと思いますが（笑）、\nお気になさらず変えてください。\n桜、紅葉・銀杏はキャラにかかる感じで散っていると嬉しいです。\n\n●その他\n個人的に秋が一番好きな季節のため、\n秋をほかよりちょっとだけ力を入れていただけると泣いて喜びます…。\n\n以上、再び長々と失礼いたしました…。\nどうぞ企業さんのお仕事を優先してください。\n余裕がある際で構いませんので、ご検討をよろしくお願いいたします…！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1nagna/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1240926, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d77f13b8/uploads/origins/a52858de-ee53-4a1f-be8c-916d23296bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30ec73bf5343c43aa5b6112f0a107790", "srcset": "https://si.imgix.net/d77f13b8/uploads/origins/a52858de-ee53-4a1f-be8c-916d23296bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30ec73bf5343c43aa5b6112f0a107790, https://si.imgix.net/d77f13b8/uploads/origins/a52858de-ee53-4a1f-be8c-916d23296bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22511be67bb9fb47cd47d3e2b61dff9a 2x, https://si.imgix.net/d77f13b8/uploads/origins/a52858de-ee53-4a1f-be8c-916d23296bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ee96b1461c0efc434a1d7795970f930 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d77f13b8/uploads/origins/a52858de-ee53-4a1f-be8c-916d23296bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=874615950911f4508572e0efcaae58a9", "srcset": "https://si.imgix.net/d77f13b8/uploads/origins/a52858de-ee53-4a1f-be8c-916d23296bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=874615950911f4508572e0efcaae58a9, https://si.imgix.net/d77f13b8/uploads/origins/a52858de-ee53-4a1f-be8c-916d23296bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=27071c337d29ab3e8d8f9d35571a10d5 2x, https://si.imgix.net/d77f13b8/uploads/origins/a52858de-ee53-4a1f-be8c-916d23296bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1456a5ce61ae301cda8a14c6501663da 3x"}, "body": "初めまして、こんにちは！\nコウさんのイラストが好きです…！恐れながらリクエストさせていただきます。\n\nこちらのキャラクターを描いていただけないでしょうか。\n（ピクルーで制作したキャラクター画像です。）\nhttps://www.dropbox.com/s/xjnvuwaqpfsb8su/1018%E3%81%94%E4%BE%9D%E9%A0%BC%E8%B3%87%E6%96%99.jpg?dl=0\n\n●キャラクター詳細\n・黒髪、センター分け、外ハネ気味、長さは普通くらい\n・つり型で短い眉\n・一重、つり目、瞳は黒、三白眼\n・和装\n・性格は真面目で苦労人気質\n・表情は大きくは変わらないタイプ\n・テーマカラーはモスグリーンのような落ち着いた緑\n\n●構図\n少し俯瞰気味のアングルで、和傘を持ち、こちらに向かって振り向いている感じです。\nイメージとしては、雨上がりの空を傘をずらしながら見上げるような格好です。\n（イメージなのでお天気は特に関係ありません。）\n季節は冬のイメージです。\n背景として、枯れ木の枝が画面内に入り込んでいる感じで、\n服装も冬の和装にしていただきたいです。マフラーもあると嬉しいです。\n衣装のメインカラーは落ち着いた緑、\nそのほか和傘、マフラー等小物や細部の色はお任せいたします。\n表情は、歯を見せず微笑んでる感じです。\n\n●その他\niPhoneの待ち受け画面に使用したいと思っています。\n縦型で、アスペクト比が16:9でお願いしたいです。\n時計の表示位置にキャラクターの顔が来ないようにしていただけると嬉しいです。\n待ち受け画面の参考画像をアップしておきます。\nhttps://www.dropbox.com/s/0b9450y9uxrlpyk/iPhoneSE2%E7%94%BB%E9%9D%A2%E8%B3%87%E6%96%99.png?dl=0\n\nまた、今回は冬のイメージでお願いしたいのですが、\n後日春、夏、秋のバージョンもリクエストしたいと考えています。\nその際変更をお願いする箇所は、枯れ木の部分を桜、青葉、紅葉等に、\n服装を季節に合わせた和装に、と思っていますので、\n頭に入れておいていただければと思います。\n\n以上、長々と細かく失礼いたしました…。\nご検討いただけると幸いです…！よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2231, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "松田トキ", "screen_name": "matsuda_Toki", "avatar_url": "https://pbs.twimg.com/profile_images/1122866369970597895/3ze7KiDA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1704400891/1616236049/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 161}, {"id": 131273, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "メリー🎸🎸Skeb･ご依頼受付中", "screen_name": "holysarvel", "avatar_url": "https://pbs.twimg.com/profile_images/1897295088260407296/rO3RXEnE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3174849709/1741185277/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 176}, {"id": 728801, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "もがみさこ", "screen_name": "mogasako0827", "avatar_url": "https://pbs.twimg.com/profile_images/1649112384945164288/ZtIikCZn.jpg", "header_url": null, "appe