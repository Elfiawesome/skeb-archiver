s&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e812ad51b627e3769a4e3953082930c9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45075871/uploads/origins/9e702290-ee8a-4bbf-a05b-49ad8677b7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=485225022bff96372020ce757bb8cc13", "srcset": "https://si.imgix.net/45075871/uploads/origins/9e702290-ee8a-4bbf-a05b-49ad8677b7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=485225022bff96372020ce757bb8cc13, https://si.imgix.net/45075871/uploads/origins/9e702290-ee8a-4bbf-a05b-49ad8677b7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e8a29c5ba6a7e0486dab2f9386908da6 2x, https://si.imgix.net/45075871/uploads/origins/9e702290-ee8a-4bbf-a05b-49ad8677b7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=480ccc934af32cf7376fef77e51a2d6e 3x"}, "body": "こんにちは！\n以前書いていただいた「下着グラビアで同級生にシコられ透」の続きみたいな感じでイラストを描いていただきたいです。\n\nキャラクター\n・浅倉透\n\nシチュエーション\n・着替え覗きシチュ\n\n懲りずに透の下着を盗みに更衣室に侵入する同級生。下着を漁ろうとするが、体育の時間を終えた透たちが更衣室に入って来てしまう。咄嗟にロッカーの中に隠れると、目の前で透たちが体操着から着替え始める。同級生アイドルの生ストリップに大興奮の同級生クンだったが、体育で汗をかいてしまった透は下着も脱ぎ始める。爆乳同級生アイドルの生おっぱいに我慢できなくなった同級生はシコり始め、気持ちよく射精。我慢できず漏れたイキ声に一瞬怪しまれるが、結局気が付かない。みたいな感じです。\n\nセリフ\n前作と同じで、同級生のセリフを多めに入れて欲しいです。前作のセリフより、陰キャっぽい感じというか、情けない感じにして欲しいです。「ついに見れるっ、爆乳同級生アイドルの生おっぱいっ...♡」「透っ♡透のおっぱいでイクっ...♡」みたいな感じで、一方的に思いを寄せていて、興奮していて余裕がなく、もう半分喘ぎ声みたいなイメージです。目の前で着替え出したり、おっぱいがブルンっと露出した時の男のリアクションみたいなセリフも描いていただきたいです。\n\nその他\n・おっぱいは大きめに描いて欲しいです。\n・下着のデザインはお任せします。\n・実際の描写の有無は問わないので、設定として円香も一緒に着替えている設定でお願いします。円香も着替え始めて、「あ...樋口の下着姿っ...ラ、ラッキー♡」みたいな感じで、普段見れない円香の下着姿にちょっと目移りするような、男の約得感を感じられるようなセリフがあると嬉しいです。\n・前作のように男がシコっているカットが小さくあると嬉しいです。(陰茎や手だけで大丈夫です)\n・構図は俯瞰視点というよりは男の視点で感情移入できる感じで、透の下着姿やおっぱいがメインに描かれていると嬉しいです！\n\n細かい点が多くなってしましましたが、よろしくお願いします！", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sa1va10re/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2938450, "client_id": 210528, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96047fdb/uploads/origins/bcee02e3-933a-4cf0-80d0-79823fdf0bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a5070c538d29542fea7fea60a60c371", "srcset": "https://si.imgix.net/96047fdb/uploads/origins/bcee02e3-933a-4cf0-80d0-79823fdf0bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a5070c538d29542fea7fea60a60c371, https://si.imgix.net/96047fdb/uploads/origins/bcee02e3-933a-4cf0-80d0-79823fdf0bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0439196919d58e432b13650bbdee54ff 2x, https://si.imgix.net/96047fdb/uploads/origins/bcee02e3-933a-4cf0-80d0-79823fdf0bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23b2ca8553ac13323d9c61b038cedd58 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96047fdb/uploads/origins/bcee02e3-933a-4cf0-80d0-79823fdf0bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da8da4ea1efbe54df149cf94812bdfed", "srcset": "https://si.imgix.net/96047fdb/uploads/origins/bcee02e3-933a-4cf0-80d0-79823fdf0bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da8da4ea1efbe54df149cf94812bdfed, https://si.imgix.net/96047fdb/uploads/origins/bcee02e3-933a-4cf0-80d0-79823fdf0bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b8f680bac2d50dd365a86da1a9a4771 2x, https://si.imgix.net/96047fdb/uploads/origins/bcee02e3-933a-4cf0-80d0-79823fdf0bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=badd5f623ff4e3b09ff8f8006876f545 3x"}, "body": "初めまして！\n以前描かれていた同級生にシコられる浅倉透(https://www.pixiv.net/artworks/120100902)が好きなので、その続きみたいな感じでイラストをお願いしたいです。\n\nシチュエーション\n同級生が、透の過激なグラビア写真集をオカズに、盗んだ彼女のブラジャー、パンツに精液をぶっかけるシチュエーション。\n\n前作と同じように、同級生の興奮しているようなセリフを多めに入れて頂きたいです。\n「やっぱり浅倉の乳デカすぎだろっ...」\n「はぁっ、はぁっ、浅倉のデカブラっ、浅倉の生乳が、さっきまでここにっ」\n「同級生の爆乳グラビアオカズにするの最高すぎるっ...」\n「イクっ...イクっ...透のデカ乳でイクっ...」\nみたいな感じです。セリフはあくまでこんな感じという例で、描きやすいように変えてもらって大丈夫です。\n\nその他\n・下着のデザインは前作と同じでお願いします。\n・胸の大きさも、前作と同じで大きめにお願いします。\n・同級生の描写は、手や男性器など最低限で十分で、写真集や下着をメインに描いてもらいたいです。\n\nよろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 47359, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "乳乃森　skeb募集中", "screen_name": "Sk9k2YOxmrYrixW", "avatar_url": "https://pbs.twimg.com/profile_images/1862070701316018176/3LvCMDpo.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 401788, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ORI", "screen_name": "hishaku_oreta", "avatar_url": "https://pbs.twimg.com/profile_images/2100920841265651712/U_ogirUq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2100918590505648128/1789733576/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 32}, {"id": 951654, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "くろみつ", "screen_name": "B3_9632", "avatar_url": "https://pbs.twimg.com/profile_images/699703119278551040/KSmcAB8n.jpg", "header_url": "https://pbs.twimg.com/profile_banners/25722240/1401620464/15