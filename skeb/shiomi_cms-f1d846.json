様への返礼品に使用（YouTubeのメンバーシップのようなイメージです）\n・背景付きでいただける場合、イベント入賞時に雑誌や駅のポスターの掲載に使わせていただく可能性あり\n・グッズに使用の可能性あり\n\nなど活動全般に使用予定です。\n別々に背景透過のキャラクターのみのデータもいただきたいので、PSDデータで納品していただけると大変嬉しいです。\n\nサムネなど使用するため顔や耳、上部の髪の毛などが見切れていないとありがたいです..！\n\nもし金額不足の場合は再送依頼をいただけますでしょうか。\nお忙しいところ恐れ入りますが、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1V2vaYunt3gBfgmrte3dyp05Hzck4h7F4", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shiomi_cms/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4078128, "client_id": 3123767, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bceb7d63/uploads/origins/ce686d3e-9ef7-4d90-9b70-4a7adf048a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e97cd6290ee9394e446080761dc4809", "srcset": "https://si.imgix.net/bceb7d63/uploads/origins/ce686d3e-9ef7-4d90-9b70-4a7adf048a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e97cd6290ee9394e446080761dc4809, https://si.imgix.net/bceb7d63/uploads/origins/ce686d3e-9ef7-4d90-9b70-4a7adf048a31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8eceda57e10b018de38138a98fac62a0 2x, https://si.imgix.net/bceb7d63/uploads/origins/ce686d3e-9ef7-4d90-9b70-4a7adf048a31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be86767e8b86fc477fd1031d9e4a0111 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bceb7d63/uploads/origins/ce686d3e-9ef7-4d90-9b70-4a7adf048a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71d19d6a7d3be25e611395ca5b3044dc", "srcset": "https://si.imgix.net/bceb7d63/uploads/origins/ce686d3e-9ef7-4d90-9b70-4a7adf048a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71d19d6a7d3be25e611395ca5b3044dc, https://si.imgix.net/bceb7d63/uploads