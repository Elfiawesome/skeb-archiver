_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/505a14c4/uploads/origins/8a2257d3-bd9d-4850-8896-18abe364bf05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ce0d4fe45312cad60887c22c13dfe98", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/505a14c4/uploads/origins/8a2257d3-bd9d-4850-8896-18abe364bf05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db57e17b57d431e539c047a6f81e7b56", "src_set": ""}, "body": "はじめまして。\nIRIAMという配信アプリの∨ライバー・びびちゃまと申します。\n\nイロミモリ様のイラスト、skebの新着で一目惚れして即フォローしました。\nとってもとっても好きです！！！！\nポーズの感じが特に好きです！表情から色使いから線の感じからとても好きです。\n\n是非、私自身のイラストを描いて頂けないでしょうか。\n色んな角度\n設定や性格など参考資料にございます。\n\n■参考資料\nhttps://drive.google.com/drive/folders/1RVhVkaMEAMv5vKZB4p1XZyKuBaBYuaih?usp=sharing\n\n■希望内容\n・「配信用衣装」でお願いします。\n・全身の場合、「体育座り or ぺたんこ座り」でお願いします。\n小悪魔っぽさ、幼さ、を感じる表情だと嬉しいです！\n\n■使用用途（可能性あるもの）\n収益化済みの配信アプリのサムネ\nX投稿での使用\nネットプリント\nリスナー返礼品グッズ\n\n■データ\nもし可能でしたら、人物のみ透過データもあわせて頂けますでしょうか\nまた、宛名等が分けられたPSDデータもしくはPNGファイルですとありがたいです。\n\nご縁がありましたら幸いです。\nよろしくお願いいたします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_iromimori_/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3618158, "client_id": 3300317, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b950944/uploads/origins/a7f17113-4d04-4ede-b6f8-dcccd7726c96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69948c41d0091e496eecf3e4bf484fc9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b950944/uploads/origins/a7f17113-4d04-4ede-b6f8-dcccd7726c96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1fdceece021ba80a7d136fae86448c5e", "src_set": ""}, "body": "イロミモリ先生こんばんは！\n12月にデ