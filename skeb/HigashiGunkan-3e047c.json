いです\n・可能であればサムネ等に使いたいなとも思っておりますので、背景と人物を分けたPSDで提出していただけると大変嬉しいです\n\nひがし軍艦さんの絵で、自分のシャツ姿を見たいと思いお願いさせていただきました！\nもし良ければご考慮願えれば幸いです。\n\n自分の参考資料。\nhttps://drive.google.com/file/d/1oBMTvDHk-JUV3-WslaXXx0FHXV1Q6T3V/view?usp=sharing\nhttps://drive.google.com/file/d/1GOosiPqa-E5cpDQ7VktdSiK2lxgjxGK-/view?usp=sharing\nhttps://drive.google.com/file/d/1XrWZJSOHHoKfeg1QQdZ9geQ9QY7ajbNy/view?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@HigashiGunkan/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2559006, "client_id": 2289814, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d6ea2a4/uploads/origins/d0d5a153-6c78-4837-bbc1-cc8f4479659a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a5ddb38525d007144a9b2ff6eb97475", "srcset": "https://si.imgix.net/2d6ea2a4/uploads/origins/d0d5a153-6c78-4837-bbc1-cc8f4479659a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a5ddb38525d007144a9b2ff6eb97475, https://si.imgix.net/2d6ea2a4/uploads/origins/d0d5a153-6c78-4837-bbc1-cc8f4479659a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7dfb830ae382001ab529a735b548eaec 2x, https://si.imgix.net/2d6ea2a4/uploads/origins/d0d5a153-6c78-4837-bbc1-cc8f4479659a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a3353575c9f90dac132a97043a08442 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d6ea2a4/uploads/origins/d0d5a153-6c78-4837-bbc1-cc8f4479659a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe63de6d45ce1eba17f6e08fd0b8ec34", "srcset": "https://si.imgix.net/2d6ea2a4/uploads/origins/d0d5a153-6c78-4837-bbc1-cc8f4479659a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe63de6d45ce1eba17f6e08fd0b8ec34, 