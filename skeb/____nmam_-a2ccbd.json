見しているだけのストーカーのような存在です（ホラー案件）この度は匿名でリクエストを送りつけることのできるskebという素晴らしいサイトがあるのをいいことに、お気持ち程度ながらケントさんに課金させていただきたく、そしてあわよくば何らかの供給を頂きたく思っております。もし…諸々差し障りがなくお気が向かれましたら…お願いいたします…！\n\n前置きがだいぶ長くなりましたが以下、イラストに関する要望です\n\nケントさんのオフショットが見たいです！具体的なシチュエーションや構図などはお任せします\n服装については（個人的な欲望およびRooM制服は有償依頼だと権利的によろしくない可能性があるので）私服もしくは部屋着で、こちらも具体的にはお任せします\n\n以上、もしよろしければご検討ください！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@____nmam_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1873405, "client_id": 2360085, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1bfad793/uploads/origins/a14ed4b4-b68d-4173-9a90-34d190d47667?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bf2aff1a8a2df750d79558710d12d8c", "srcset": "https://si.imgix.net/1bfad793/uploads/origins/a14ed4b4-b68d-4173-9a90-34d190d47667?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bf2aff1a8a2df750d79558710d12d8c, https://si.imgix.net/1bfad793/uploads/origins/a14ed4b4-b68d-4173-9a90-34d190d47667?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a340e6737b4847d5f2b76a8f564128aa 2x, https://si.imgix.net/1bfad793/uploads/origins/a14ed4b4-b68d-4173-9a90-34d190d47667?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82b3c82eb86ebe19b3942f3ef2362d56 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1bfad793/uploads/origins/a14ed4b4-b68d-4173-9a90-34d190d47667?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6abf0abd178a7dd290aefe4a027f220", "srcset": "https://si.imgix.net/1bfad793/uploads/origins/a14ed4b4-b68d-4173-9a90-34d190d47667?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6abf0abd178a7dd290aefe4a027f220, https://si.imgix.net/1bfad793/uploads/origins/a14e