o=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=109fc24c8250f77ba6e4cbe722ef16ca 2x, https://si.imgix.net/383aacd8/uploads/origins/0dda9b22-c6f6-4ab1-a5b9-59b098ad067d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=29799f6b5f36d72a92aa26c76976a91c 3x"}, "body": "こちらでは初めまして\n今回はイラストの依頼をしたくリクエストさせていただきました。\n【作品名】フラワーナイトガール\n【キャラクター】オシロイバナ\n【衣装】アレンジバニー※進化後の浴衣をベースにアレンジしていただきたいです。\n【シチュエーション】夜の街に手持ち看板を掲げながら夜風に震える姿でお願いします。\n看板の内容や背景はお任せしますが、無しでも構いません。\n\nそれではよろしくお願いします。\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%82%AA%E3%82%B7%E3%83%AD%E3%82%A4%E3%83%90%E3%83%8A", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@3i_6o_9u/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2025899, "client_id": 751755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8fe3f488/uploads/origins/50b9d44c-1d96-4401-9c6d-ffb871563972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=339095a2d328d8a55426929bec26625b", "srcset": "https://si.imgix.net/8fe3f488/uploads/origins/50b9d44c-1d96-4401-9c6d-ffb871563972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=339095a2d328d8a55426929bec26625b, https://si.imgix.net/8fe3f488/uploads/origins/50b9d44c-1d96-4401-9c6d-ffb871563972?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40c10ac4eaed0caec20ef550093898e2 2x, https://si.imgix.net/8fe3f488/uploads/origins/50b9d44c-1d96-4401-9c6d-ffb871563972?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=409fe5a1240e2774f31882d207e8ccb3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8fe3f488/uploads/origins/50b9d44c-1d96-4401-9c6d-ffb871563972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a9e7c3a91ad94a06e903b2a2c95f072", "srcset": "https://si.imgix.net/8fe3f488/uploads/origins/50b9d44c-1d96-4401-9c6d-ffb871563972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a9e7c3a91ad94a06e903b2a2c95f072, https://si.imgix.net/8fe3f488/uploads/origins/50b9d44c-1d96-4401-9c6d-ffb871563972?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe9e39cbfab0190919e1a659cdd785b7 2x, https://si.imgix.net/8fe3f488/uploads/origins/50b9d44c-1d96-4401-9c6d-ffb871563972?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8c9ee3e1db0810d82f9194febbc434ec 3x"}, "body": "みろく先生前回は素敵なイラストをありがとうございました、牛の王子さまでち＠８６ｋとです。\n今回もリクエストをお受けいただけたら幸いです。\n\n【作品】フラワーナイトガール\n【キャラクター】ハツユキソウ（花騎士）\n【衣装】通常衣装（進化前）\nhttps://i.imgur.com/b2FNAPo.png\n正面首元はこちらになります\nhttps://i.imgur.com/HWi038U.png\n\n※キャラクターの体型、髪型は以下の方がわかりやすいと存じます\nクリスマス衣装進化後\nhttps://i.imgur.com/ketEKFQ.png\n腰まである白髪ストレートロングでやや小ぶりのおっぱいに大きめのお尻の子です\n\n【シチュエーション】\n団長さんに妊娠検査薬を見せに来たハツユキソウを描いてください、お願いいたします。\n\n可能ならば以下の差分をいただけますと大変ありがたいです。\n（可能な限りで結構です）\n・顔を真っ赤にした照れ顔\n・「やりましたよ団長さん！（ふっふーん）」( *¯ ﹀¯*)と言った感じのドヤ顔\n・「どうしましょう！？（花騎士引退ですよね？）」って感じで真っ青な顔になって慌てている表情\n・「実は４月１日のいたずらでしたー！」という感じのいたずら顔\n\n以上が私の要望ですが、わかりにくい点や難しい点等ございましたら先生のやりやすいようにアレンジしていただいて構いません。\nよろしくお願いいたします。\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%8F%E3%83%84%E3%83%A6%E3%82%AD%E3%82%BD%E3%82%A6", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@3i_6o_9u/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2025899, "client_id": 115971, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a77d3bc1/uploads/origins/324c9c2b-331b-46dc-a5e4-6540bc9675c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34e87617117ece66e9430ee4f1e6f62c", "srcset": "https://si.imgix.net/a77d3bc1/uploads/origins