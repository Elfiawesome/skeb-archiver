gins/2c25200a-91ff-4bea-9bc6-c986b6d6f3bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e2d46f0392630f8b96fed34d10825ef 2x, https://si.imgix.net/fae15708/uploads/origins/2c25200a-91ff-4bea-9bc6-c986b6d6f3bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e5e69534764c729306b593d927c5ce8d 3x"}, "body": "こんにちは！\nよかったらグラブルのアルシャさんの下着姿の絵をお願いします！\nメガネと下着以外なんも身に着けてないぐらいでお願いします！\nエルーンだけどブラもあると嬉しいです！\nシチュエーションは野外下着露出で、布面積普通目～広めの地味なやつだと嬉しいです！\n野外露出なので肌や髪や下着がちょっと汚れてるととてもありがたいです\n（背景はなくても大丈夫ですが、あってもなんとなくの簡単なもので大丈夫です）", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@No_1008/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 573625, "client_id": 1989569, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51d6613e/uploads/origins/7e175fc5-4fde-42fa-a949-f5e71aa84ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a378467a716c5179cc49e040ec6c2cb6", "srcset": "https://si.imgix.net/51d6613e/uploads/origins/7e175fc5-4fde-42fa-a949-f5e71aa84ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a378467a716c5179cc49e040ec6c2cb6, https://si.imgix.net/51d6613e/uploads/origins/7e175fc5-4fde-42fa-a949-f5e71aa84ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7adba3f1651d92a7dca37a018bfd1c5d 2x, https://si.imgix.net/51d6613e/uploads/origins/7e175fc5-4fde-42fa-a949-f5e71aa84ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=197671712ebf1bdc113f308194a0bcf0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51d6613e/uploads/origins/7e175fc5-4fde-42fa-a949-f5e71aa84ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0456c6f8d0db910a785fcedecda2f76d", "srcset": "https://si.imgix.net/51d6613e/uploads/origins/7e175fc5-4fde-42fa-a949-f5e71aa84ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0456c6f8d0db910a785fcedecda2f76d, https://si.imgix.net/51d6613e/uploads/origins/7e175fc5-4fde-42fa-a949-f5e71aa84ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2932ba4b90d4cce779deffabf93d3156 2x, https://si.imgix.net/51d6613e/uploads/origins/7e175fc5-4fde-42fa-a949-f5e71aa84ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=431da65a2d812625ab01f0d4ef0cc04e 3x"}, "body": "こんにちは、グランブルーファンタジーのアルルメイヤ、レイ、グランの白黒漫画風ページを数枚お願いしたいです。\n\nシナリオは、グランが自分の部屋を訪ねてきたセクシーな年上のハーヴィン2人に誘惑されるものです。ちょっとしたタイムスリップが起こる。そして、ハーヴィンの二人はグランと淫らな3Pで激しいセックスをする。アルルマーヤはキスとお掃除フェラが好きで、.レイはグランに抱きついたり、からかったりするのが好きだ。\nハーヴィンの二人はグランの性欲について行くのがやっとだ。二人のハーヴィンは、グランが彼の大きなチンコで激しく交尾するのを楽しんでいます。\n\nお腹の膨らみや、アルルマーヤとレイが組んでダブルフェラなどのシーンもお願いします。\n\nその他の細かい部分はお任せします。\nご検討のほど、よろしくお願いいたします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@No_1008/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 573625, "client_id": 525972, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51f81dc9/uploads/origins/5134ece3-5cf8-42fc-9750-8fac5b8e328f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09d3afd8bbf7ad6f134ae64c1a85d1d9", "srcset": "https://si.imgix.net/51f81dc9/uploads/origins/5134ece3-5cf8-42fc-9750-8fac5b8e328f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09d3afd8bbf7ad6f134ae64c1a85d1d9, https://si.imgix.net/51f81dc9/uploads/origins/5134ece3-5cf8-42fc-9750-8fac5b8e328f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edebddc2cb9ec8b224e7b1a8ad0893ea 2x, https://si.imgix.net/51f81dc9/uploads/origins/5134ece3-5cf8-42fc-9750-8fac5b8e328f?bg=%23fff&auto=format%2Ccompress&f