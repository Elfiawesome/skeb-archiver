と先生的言動を受け赤面するカンナをお願いします。\n先生の姿は描かなくても大丈夫です、その他細かい点はお任せいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@No_1008/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 573625, "client_id": 41173, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42c5d82c/uploads/origins/c3ead83b-fc21-4e57-b6b5-0ec0f01398a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dac2c8d9ba1b41fc5149ad5b84bc29d3", "srcset": "https://si.imgix.net/42c5d82c/uploads/origins/c3ead83b-fc21-4e57-b6b5-0ec0f01398a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dac2c8d9ba1b41fc5149ad5b84bc29d3, https://si.imgix.net/42c5d82c/uploads/origins/c3ead83b-fc21-4e57-b6b5-0ec0f01398a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71474c707ae65e95bc056983fb5ea138 2x, https://si.imgix.net/42c5d82c/uploads/origins/c3ead83b-fc21-4e57-b6b5-0ec0f01398a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63b3deb6f62e2e6e5e8923d87a9d2409 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42c5d82c/uploads/origins/c3ead83b-fc21-4e57-b6b5-0ec0f01398a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43acd83ff5a5ac8c0058c8f13cc6cf97", "srcset": "https://si.imgix.net/42c5d82c/uploads/origins/c3ead83b-fc21-4e57-b6b5-0ec0f01398a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43acd83ff5a5ac8c0058c8f13cc6cf97, https://si.imgix.net/42c5d82c/uploads/origins/c3ead83b-fc21-4e57-b6b5-0ec0f01398a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c0e0be5253f150cf9418a844c4b393ba 2x, https://si.imgix.net/42c5d82c/uploads/origins/c3ead83b-fc21-4e57-b6b5-0ec0f01398a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28f47adebf71e308d8491aa8a64efc97 3x"}, "body": "こんばんは！\n\nロベルティナ(私服)のモノクロかグレスケでえっちな漫画をお願いしたいです。\n\n内容:異種族間で妊娠しない事をいい事に団長を煽り生中種付けラブラブエッチでお仕置きされてしまうロベルティナ(結局便利な特異点パワーでお腹がぽっこりするくらい中出しされ孕んでしまう)\n\n事後の受精表現と、団長をお誘いする時にくぱぁしながらだとありがたいです！(無くても大丈夫です！)\n細かい流れや台詞などはおまかせします！\n\nよければ御検討ください！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@No_1008/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 573625, "client_id": 564865, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cdc9b933/uploads/origins/e4a6dbc1-df62-4a30-bcf1-dbdc26d5b338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1093d3819344efaf57d10dd75987f05", "srcset": "https://si.imgix.net/cdc9b933/uploads/origins/e4a6dbc1-df62-4a30-bcf1-dbdc26d5b338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1093d3819344efaf57d10dd75987f05, https://si.imgix.net/cdc9b933/uploads/origins/e4a6dbc1-df62-4a30-bcf1-dbdc26d5b338?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f26d5247c2dc347b1236b51de45ecea 2x, https://si.imgix.net/cdc9b933/uploads/origins/e4a6dbc1-df62-4a30-bcf1-dbdc26d5b338?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c774f73aff69dc1c932e6b000408008b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cdc9b933/uploads/origins/e4a6dbc1-df62-4a30-bcf1-dbdc26d5b338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31447e7031ad65c7d861e3edfdff60db", "srcset": "https://si.imgix.net/cdc9b933/uploads/origins/e4a6dbc1-df62-4a30-bcf1-dbdc26d5b338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31447e7031ad65c7d861e3edfdff60db, https://si.imgix.net/cdc9b933/uploads/origins/e4a6dbc1-df62-4a30-bcf1-dbdc26d5b338?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3901c8f421cf258b46bf1facdb0a6552 2x, https://si.imgix.net/cdc9b933/uploads/origins/e4a6dbc1-df62-4a30-bcf1-dbdc26d5b338?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bfe5b19cc2d39a653c6a2fa603991f7c 3x"}, "body": "リクエスト再開されていたので！\nだいぶ前に依頼させていただいた、こちらのリクエストについて、事後の絵を頂ければと思っております…！\n（出来れば前回のように、ラブラブor無理矢理の両方の解釈ができるような差分を頂けたらと思いますが、筆が乗らないなどあるかと思いますので、千八乃様のお好きなように書いていただいて大丈夫です！）\n\nhttps://skeb.jp/@No_1008/works/1\n\nhttps://skeb.jp/@No_1008/works/1", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@No_1008/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 573625, "client_id": 41173, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ceaac90a/uploads/origins/e867eb89-5393-4436-a7a9-7f43d1de084a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bef35ec99c6f9f9e6c2678ba19e8838e", "srcset": "https://si.imgix.net/ceaac90a/uploads/origins/e867eb89-5393-4436-a7a9-7f43d1de084a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bef35ec99c6f9f9e6c2678ba19e8838e, https://si.imgix.net/ceaac90a/uploads/origins/e867eb89-5393-4436-a7a9-7f43d1de084a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52856b3ff0663a5921059634462eef08 2x, https://si.imgix.net/ceaac90a/uploads/origins/e867eb89-5393-4436-a7a9-7f43d1de084a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5449c6621e1a3edfbdaaa3d754a57c16 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ceaac90a/uploads/origins/e867eb89-5393-4436-a7a9-7f43d1de084a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=943466cdfdb9a567c663d5e7f0423e38", "srcset": "https://si.imgix.net/ceaac90a/uploads/origins/e867eb89-5393-4436-a7a9-7f43d1de084a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=943466cdfdb9a567c663d5e7f0423e38, https://si.imgix.net/ceaac90a/uploads/origins/e867eb89-5393-4436-a7a9-7f43d1de084a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a1edc433e2f189fd53ac7ac06722a101 2x, https://si.imgix.net/ceaac90a/uploads/origins/e867eb89-5393-4436-a7a9-7f43d1de084a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=921d513ab6aa8780a87b674ca2a3c935 3x"}, "body": "毎度お世話になっております。\n\nロベルティナがエッチしてるイラストをお願いしたいです。\n\n差分を複数お願いしたいです(予算が足りなかったらいくつか削って頂いて大丈夫です)\n1.正面からの構図で下着姿のロベルティナ(パンツは脱いでも終始足に引っかけてください)がまんぐり返ししてる状態→パンツを手でずらしてすじ見せ→パンツを脱いで両手の指でくぱぁしている構図(膣内はとろとろで子宮口まで見えてる感じで)\nそのままくぱぁしたまま膣内愛撫→潮吹き\n2.全裸になって挿入から中出し(挿入～中出しまで子宮込みの断面図を別カットで、挿入した竿でお腹がぽっこりしてると嬉しいです)\n3.再度くぱぁで中出しした精液が溢れてくるのを見せながらハート眼になっているロベルティナ+受精表現\n\n内容はおまかせするので軽い台詞などがあると嬉しいです(無くても大丈夫です)\n可能ならでよいので黒線修正でお願いします。(子宮口が見たいので)\n\nよければ御検討ください！", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@No_1008/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e1f43025/uploads/origins/4151a4e8-53e3-477a-b8e1-02b6158df75a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=618442bb0438a25776ebfb6fbd42ac4d", "srcset": "https://si.imgix.net/e1f43025/uploads/origins/4151a4e8-53e3-477a-b8e1-02b6158df75a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=618442bb0438a25776ebfb6fbd42ac4d, https://si.imgix.net/e1f43025/uploads/origins/4151a4e8-53e3-477a-b8e1-02b6158df75a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=m