ur=200&s=07229e3ad0419a917d1d2865210167f7", "srcset": "https://si.imgix.net/e9887c36/uploads/origins/435aa10e-5ae6-4922-a65c-7c365cf5ebb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07229e3ad0419a917d1d2865210167f7, https://si.imgix.net/e9887c36/uploads/origins/435aa10e-5ae6-4922-a65c-7c365cf5ebb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad9d5a34ce7f1b64e6ebf8afd086e8bf 2x, https://si.imgix.net/e9887c36/uploads/origins/435aa10e-5ae6-4922-a65c-7c365cf5ebb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e628f545cc92589974a4a45118938b6 3x"}, "body": "こんにちは。\n\nDIAというOCのアートを頼みたいと思っています。怠け者だけど、いざというときは頼りになるかっこいいお姉さんという雰囲気。彼女は思慮深く、行動を起こす前に綿密な計画を立てることを好む。DIAはハンドガンと、爪や大砲などの武器に変形できる腕を使って戦います。趣味は探偵小説。彼女は甘いペストリーとブラックコーヒーが好きだ。\n\n先生が選んだ衣装を見てみたい。ご自由に描いてください。先生にとってかっこいいシーンであればうれしいです。\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1LUJ26pW96iTvWvY3kWxSPn5rqCq_vNWi", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kisaragiyuu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 7618, "client_id": 3012404, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c95f582/uploads/origins/793c7203-0d86-4b42-be50-6dfc7d907f56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d590457b0e150189be58a4bc4b2838c1", "srcset": "https://si.imgix.net/8c95f582/uploads/origins/793c7203-0d86-4b42-be50-6dfc7d907f56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d590457b0e150189be58a4bc4b2838c1, https://si.imgix.net/8c95f582/uploads/origins/793c7203-0d86-4b42-be50-6dfc7d907f56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=686aa5fca54dfec8949bfee2820df180 2x, https://si.imgix.net/8c95f582/uploads/origins/793c7203-0d86-4b42-be50-6dfc7d907f56?bg=%23fff&auto=for