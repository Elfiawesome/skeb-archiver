い方はデリカシーがなく、小さい方に「太ったか！？」とか平気で言います。小さい方はカーッとなりやすくピリピリとしているのですぐ怒ります。でもなんだかんだで仲がいい、みたいな関係です。\n小さい方は大きい方へ密かに好意を寄せていますが、プライドが阻害しているのと、大きい方がにぶすぎてキレてます\n大きい方もまだ無自覚ですが小さい方が好きな両片思いです\n\nこの設定を踏まえて構図なども全ておまかせさせて頂きたいです。\n何卒ご検討頂けますと幸いです。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jnnKleeche/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2ef527a9/uploads/origins/f6ce31c9-c020-42fe-b889-a419bf4419a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6f43469ab738585990ae22ae4aca00d", "srcset": "https://si.imgix.net/2ef527a9/uploads/origins/f6ce31c9-c020-42fe-b889-a419bf4419a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6f43469ab738585990ae22ae4aca00d, https://si.imgix.net/2ef527a9/uploads/origins/f6ce31c9-c020-42fe-b889-a419bf4419a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=753a45608f18ee0533729cda36b5b4e7 2x, https://si.imgix.net/2ef527a9/uploads/origins/f6ce31c9-c020-42fe-b889-a419bf4419a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f208c14b3ff6a074bd6fa1f7eaf4a6a 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3395782, "client_id": 43394, "nc": 32}, {"path": "/@jnnKleeche/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3395782, "client_id": 3184839, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c1bfd1e/uploads/origins/78fb2977-f110-4213-a22c-af8124098f79?bg=%23fff&auto=format%2Ccompress&fm=webp&f