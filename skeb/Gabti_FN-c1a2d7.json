せん)。\n\nゲームなどでよくあるカットイン演出で使われていそうなイラストがほしいと思っています。サムネイル用途なので背景は不要ですが、描いていただける場合はレイヤーを分けていただけますと幸いです。\nその他については、お任せさせていただければと存じます。\n\nもしよろしければ、描いていただけますととても嬉しいです。\n以上、よろしくお願いいたします。", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Gabti_FN/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2012411, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61c12705/uploads/origins/653a528c-baea-4adf-a4e1-966b0d2eb2ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d8f088c5a5800def746c5995f96c502", "srcset": "https://si.imgix.net/61c12705/uploads/origins/653a528c-baea-4adf-a4e1-966b0d2eb2ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d8f088c5a5800def746c5995f96c502, https://si.imgix.net/61c12705/uploads/origins/653a528c-baea-4adf-a4e1-966b0d2eb2ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4d913cbf362f3202e65b7a2128427ec 2x, https://si.imgix.net/61c12705/uploads/origins/653a528c-baea-4adf-a4e1-966b0d2eb2ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d4b452aa55072a0743a2897d67f367e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61c12705/uploads/origins/653a528c-baea-4adf-a4e1-966b0d2eb2ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d4b094a530407f2714c483fe643cafd", "srcset": "https://si.imgix.net/61c12705/uploads/origins/653a528c-baea-4adf-a4e1-966b0d2eb2ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d4b094a530407f2714c483fe643cafd, https://si.imgix.net/61c12705/uploads/origins/653a528c-baea-4adf-a4e1-966b0d2eb2ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3bb6f6fb6ec1ec49127dc76d33e1adee 2x, https://si.imgix.net/61c12705/up