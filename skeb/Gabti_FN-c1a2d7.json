6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cedb507ef4ec31ebca62d29724a1a50f, https://si.imgix.net/ec772201/uploads/origins/8713aa49-79ec-4863-9e51-70073df78b6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c498633e5dba7633378a2c16bb4e6257 2x, https://si.imgix.net/ec772201/uploads/origins/8713aa49-79ec-4863-9e51-70073df78b6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=23a24d814bf5469317a33bccae136f53 3x"}, "body": "初めまして。\nがぶち先生の描くお嬢が好きで今回初めて依頼を出させていただきました。\n\n【依頼内容】\n◆キャラ\nホロライブより、百鬼あやめ\n衣装は夏らしく水着でデザインや柄はお任せいたします\n\n◆ポーズ、構図\n・スマホなどの壁紙にしたいので構図は縦でお願いします\n・ポーズや表情、背景はすべて先生にお任せします\n\n◆その他\n・金額的に可能であれば差分で違う表情のものをお願いしたいです\n\n\n依頼内容と金額が合わなければお手数おかけしますが金額指定で再送依頼を送っていただけると有難いです。\n拙い文章で申し訳ありませんが何卒ご検討の程よろしくお願いいたします。\n\n暑い日々が続いております。お身体にはくれぐれもお気を付けください。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Gabti_FN/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2012411, "client_id": 2883400, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e78b7af/uploads/origins/7a51c9d7-b456-4477-a35b-6ccd9ed0d2b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cc9a8a03f25252be00051ab716e02a1", "srcset": "https://si.imgix.net/5e78b7af/uploads/origins/7a51c9d7-b456-4477-a35b-6ccd9ed0d2b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cc9a8a03f25252be00051ab716e02a1, https://si.imgix.net/5e78b7af/uploads/origins/7a51c9d7-b456-4477-a35b-6ccd9ed0d2b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72021d6b34bfda116037d7e6dd596cef 2x, https://si.imgix.net/5e78b7af/uploads/origins/7a51c9d7-b456-4477-a35b-6ccd9ed0d2b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae4c4a042ffb1cd79cf4c358977df3f4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e78b7af/uploads/origins/7a51c9d7-b456-4477-a35b-6ccd9ed0d2b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8588df92b6f4da4b8563802fe385926", "srcset": "https://si.imgix.net/5e78b7af/uploads/origins/7a51c9d7-b456-4477-a35b-6ccd9ed0d2b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8588df92b6f4da4b8563802fe385926, https://si.imgix.net/5e78b7af/uploads/origins/7a51c9d7-b456-4477-a35b-6ccd9ed0d2b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c31bb2b65132311c585a08ebad1a465 2x, https://si.imgix.net/5e78b7af/uploads/origins/7a51c9d7-b456-4477-a35b-6ccd9ed0d2b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=80e66f47a9eea3115cf6d132d08e7033 3x"}, "body": "がぶち様\n\n申し訳ありません。不備がありましたので再送させて頂きました。\n初めまして。個人Vtuber兎彷魂あみゅさん(@usatama_amyu)を推しています、さっくんと申します。\n\nXにて素敵なイラストを拝見し、宜しけれれば兎彷魂あみゅさんのイラストを依頼をしたく、ご連絡させていただきました。\n\n【使用用途】\n·兎彷魂あみゅさんに関わるSNSプロモーション周りでの使用\n\n·YouTubeの動画サムネイル等での利用\nその為、兎彷魂あみゅさんにのみ使用許可をお願い致します。\n\n·本人はファンアートをskebで依頼することは許可しておりますのでご確認頂ければ幸いです。\n(https://lit.link/usatamaamyu)\n\n【要望】\n・ジャックオーランタンのバスケットを両手で前に出してお菓子を求めてる感じのイラスト\n・首に付けてるチョーカを鈴付きチョーカに\n・服装：ハロウィンっぽいカワイイ衣装でお願いします。\n・表情はお任せ致します。\n・髪型等∶普段の髪を下ろしているverで資料画像の様な赤目黒髪猫耳で描いて頂きますようお願い致します。\n・背景も描いて頂けると嬉しいです。\n\n・設定資料https://usatama-amyu.fanbox.cc/posts/6177435\n\n・ファイル形式はpsdで可能でしたら背景レイヤーとキャラクターレイヤーを分けて頂けると助かります。\n\n長文となりますが、ご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/188w2I0sZUMY8WJ0LVqqa41qIXQOhrL1F", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Gabti_FN/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2012411, "client_id": 2257375, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f42e475d/uploads/origins/1c01