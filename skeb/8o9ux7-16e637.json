願いいたします。\n・人間の耳はございませんので、お気をつけいただけますと幸いです。\n\n\nお忙しい中ここまでご確認いただきありがとうございます。\n何卒ご検討のほどよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/19XJ9RRJE7bupA9N6JBoYJ_wezmvWFeU9?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 264674, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "よしだ@イノセントレッド1巻8/20発売", "screen_name": "YOSHIDA_HD", "avatar_url": "https://pbs.twimg.com/profile_images/1178761894892470272/p0A9kfBW.png", "header_url": "https://pbs.twimg.com/profile_banners/81331343/1563550770/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 968410, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "くるぶしは小指側が下がっている", "screen_name": "Helvetica_R", "avatar_url": "https://pbs.twimg.com/profile_images/1920625793920647168/FTSe1J9I.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1696687756339281921/1746747848/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 2777004, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "猫餅", "screen_name": "mayomayopotofu", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-28bf201d-54ec-47b2-9632-80a58429a9bb.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/webpublic-42af4bdf-aa83-4ded-b28d-6dec138f2a00.png?sensitive=true", "appeal_receivable": false, "popular_creator_rank