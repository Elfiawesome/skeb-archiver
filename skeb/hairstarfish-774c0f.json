539f\u753b\u3092\u63cf\u3044\u3066\u9802\u3051\u308c\u3070\u3068\u601d\u3063\u3066\u304a\u308a\u307e\u3059\u3002\n- OC A(\u4ee5\u4e0b\"\u30d4\u30f3\u30af\")\u304cOC B(\u4ee5\u4e0b\"\u3046\u3055\u304e\")\u306b\u5bfe\u3059\u308b\u7247\u601d\u3044\u306b\u9665\u3063\u305f\u304d\u3063\u304b\u3051\u3092\u539f\u753b\u98a8\u306b\u76db\u308a\u8fbc\u307f\u305f\u3044\u3067\u3059!\n- \u8a73\u7d30\u306b\u3064\u3044\u3066\u306f\u3001\u8cc7\u6599\u3092\u53c2\u8003\u306b\u3057\u3066\u3044\u305f\u3060\u3051\u308c\u3070\u52a9\u304b\u308a\u307e\u3059\u3002\n\n\u3010\u53c2\u8003\u3011\n\u30d4\u30f3\u30af\u306e\u30ad\u30e3\u30e9\u30fc (\u4ee5\u4e0b \u300c\u30d4\u30f3\u30af\u300d)\n- \u7d14\u7c8b\u3067\u4e16\u9593\u77e5\u3089\u305a\u306e\u304a\u59eb\u69d8\u98a8\u306e\u30a2\u30a4\u30c9\u30eb\n- \u6065\u305a\u304b\u3057\u304c\u308a\u5c4b\u306e\u5929\u7136\u7cfb\u3067\u3059\u304c\u3001\u30a6\u30b5\u30ae\u306e\u9650\u5b9a\u3067\u306f\u611b\u60c5\u30a2\u30d4\u30fc\u30eb\u306b\u3068\u3066\u3082\u7a4d\u6975\u7684\u3067\u3059\u3002\n  \u6065\u305a\u304b\u3057\u3044\u3051\u3069\u3001\u597d\u304d\u597d\u304d\u5927\u597d\u304d\u3067\u3057\u3087\u3046\u304c\u306a\u3044\uff01\u307f\u305f\u3044\u306a\u611f\u3058\u3067\u3059\u3002\n- \u30a6\u30b5\u30ae\u306e\u96a0\u308c\u305f\u5927\u30d5\u30a1\u30f3\u3067\u3001\u30b2\u30fc\u30e0\u306e\u4e2d\u3067\u3082\u3001\u73fe\u5b9f\u306e\u672c\u4eba\u7684\u306b\u3082\u3067\u3082\u30a6\u30b5\u30ae\u3068\u604b\u4eba\u306b\u767a\u5c55\u3057\u305f\u3044\u3068\u3044\u3046\u6c17\u6301\u3061\u3067\u3044\u3063\u3071\u3044\u3067\u3059\u3002 \n\n\u30a6\u30b5\u30ae\u306e\u30ad\u30e3\u30e9\u30fc  (\u4ee5\u4e0b \u300c\u30a6\u30b5\u30ae\u300d)\n- \u300c\u30a6\u30b5\u30ae\u661f\u96f2\u304b\u3089\u964d\u308a\u3066\u304d\u305f\u30a6\u30b5\u30ae\u661f\u4eba\u300d\u3092\u4e3b\u5f35\u3057\u3066\u3044\u308b\u96fb\u6ce2\u7cfb\u8179\u9ed2\u30dd\u30c3\u30d7\u30a2\u30a4\u30c9\u30eb\u3002 \n  \u5b9f\u969b\u306e\u672c\u4eba\u306f\u5168\u304f\u6b63\u53cd\u5bfe\u3067\u3059\u304c\u3001\u30b9\u