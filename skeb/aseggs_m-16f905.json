70/uploads/origins/186bc720-fe0a-4356-a198-4751fa441708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16adb9510115c13886bc006d59fc8f62, https://si.imgix.net/af7bf770/uploads/origins/186bc720-fe0a-4356-a198-4751fa441708?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8febc5fca2aab14c83151606718c402b 2x, https://si.imgix.net/af7bf770/uploads/origins/186bc720-fe0a-4356-a198-4751fa441708?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=72cf85f82defa8747105c9118e9a015e 3x"}, "body": "こんにちは！あなたの作品はとても美しい。\n\n私のキャラクター、ガブリエルをお願いしたいのですが。彼は無口で冷静な殺し屋で、仕事のためだけに生きています。心の奥底はとても空虚で、人生に何があるのか知らないので、仕事以外の話題に関してはかなり無邪気な心の持ち主です！\n\n彼岸花か白百合で描いていただけると嬉しいです！ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1BbOylmjOB7FYPi5yZoUkJlZfKZDz4T4y?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aseggs_m/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2440806, "client_id": 22342, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28410a1b/uploads/origins/6f750a48-4113-421b-90ea-1ab403d9585c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95453ec61c9c73f43a58f2024079056a", "srcset": "https://si.imgix.net/28410a1b/uploads/origins/6f750a48-4113-421b-90ea-1ab403d9585c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95453ec61c9c73f43a58f2024079056a, https://si.imgix.net/28410a1b/uploads/origins/6f750a48-4113-421b-90ea-1ab403d9585c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a4d527de67f0555f1b625c40b9c4999 2x, https://si.imgix.net/28410a1b/uploads/origins/6f750a48-4113-421b-90ea-1ab403d9585c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=082a88c3578a45c79a67f082b914d62e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28410a1b/uploads/origins/6f750a48-4113-421b-90ea-1ab403d9585c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=baa43fc4dd686fe37d7bd6301d292102", "srcset": "https://si.imgix.net/28410a1b/uploads/origins/6f750a48-4113-421b-90ea-1ab403d9585c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=baa43fc4dd686fe37d7bd6301d292102, https://si.imgix.net/28410a1b/uploads/origins/6f750a48-4113-421b-90ea-1ab403d9585c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cbcaabaa8e68503274225ec5858451dc 2x, https://si.imgix.net/28410a1b/uploads/origins/6f750a48-4113-421b-90ea-1ab403d9585c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cb69567e275b8c5e31b437039543f235 3x"}, "body": "こんにちは(^^)vキャラクターの描き方、とても素敵ですね！\n\n私のオクハンのアートが欲しいなと思いました。\nhttps://orig00.deviantart.net/0782/f/2018/242/b/2/010118_l_by_caephuier-dclku1c.png\nhttps://f2.toyhou.se/file/f2-toyhou-se/images/32923432_1W9IdwMNIBei2tZ.png\nhttps://toyhou.se/2419562.han\n\n彼は男の子ですが、可愛い女の子のようなアンドロイドのように見えます！彼はとてもハッピーで遊び好きですが、瞑想や旅行も好きです。ポーズや服装はあなた次第です。唯一具体的なリクエストは、彼がネックレスをつけていることです！あなたの描く花の肖像画が大好きなのですが、紫陽花や忘れな草で彼を描いていただけませんか？\n\nまたよろしくお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aseggs_m/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2440806, "client_id": 1374966, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/742b7eba/uploads/origins/bf56f071-f791-45dd-8535-024e0680b538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e6b06e23a3da909dae9e6584650135b", "srcset": "https://si.imgix.net/742b7eba/uploads/origins/bf56f071-f791-45dd-8535-024e0680b538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e6b06e23a3da909dae9e