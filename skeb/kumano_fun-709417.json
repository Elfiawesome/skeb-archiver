。\n\n　右脚・ふとももの真ん中ぐらい\n　左脚・ほぼ根元から、達磨ちゃんレベル\n　右腕・ほぼ根元から、達磨ちゃんレベル\n　左腕・少しだけ残っている、芋虫ちゃんレベル\n\n　ほぼ達磨ですが、右足だけ長く残ってるのが悪く目立つ感じの身体です。\n\n内容こってりですがご検討していただけると！！！\nお身体ご自愛くださいね。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kumano_fun/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3513431, "client_id": 286742, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d82ae47/uploads/origins/775fb6e3-dd53-401a-aad7-9adaa8d37ca9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3c29e6d5b8b7ca9c72969529111e066", "srcset": "https://si.imgix.net/9d82ae47/uploads/origins/775fb6e3-dd53-401a-aad7-9adaa8d37ca9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3c29e6d5b8b7ca9c72969529111e066, https://si.imgix.net/9d82ae47/uploads/origins/775fb6e3-dd53-401a-aad7-9adaa8d37ca9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a2753ac1dbadd286cb5dccea2784229 2x, https://si.imgix.net/9d82ae47/uploads/origins/775fb6e3-dd53-401a-aad7-9adaa8d37ca9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48833175d0c826cf5c91498b87bd2143 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d82ae47/uploads/origins/775fb6e3-dd53-401a-aad7-9adaa8d37ca9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c48644beefaddf2412791770b7a779b", "srcset": "https://si.imgix.net/9d82ae47/uploads/origins/775fb6e3-dd53-401a-aad7-9adaa8d37ca9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c48644beefaddf2412791770b7a779b, https://si.imgix.net/9d82ae47/uploads/origins/775fb6e3-dd53-401a-aad7-9adaa8d37ca9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bcf72ac9c9e600713a906dd274282379 2x, https://si.imgix.net/9