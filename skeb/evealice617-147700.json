ではなく等身の姿ですと嬉しいです。\n\nお忙しい中大変恐縮ですが、天国地獄大地獄様に描いていただけましたらとても嬉しく思います。\nご検討のほど、何卒よろしくお願いいたします。\n\nhttps://x.com/ichihitokoyoru/status/1883111495292383697", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@evealice617/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 218477, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/047d6bc3/uploads/origins/e64b2844-bbb9-402b-9edd-7d353f0b5c9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d440b6cfd0358f38726f7b19bdf5733", "srcset": "https://si.imgix.net/047d6bc3/uploads/origins/e64b2844-bbb9-402b-9edd-7d353f0b5c9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d440b6cfd0358f38726f7b19bdf5733, https://si.imgix.net/047d6bc3/uploads/origins/e64b2844-bbb9-402b-9edd-7d353f0b5c9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55e5f7ac4d09945256c5eac7fd683325 2x, https://si.imgix.net/047d6bc3/uploads/origins/e64b2844-bbb9-402b-9edd-7d353f0b5c9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0da721b61c0583df5a40a6569d7ad821 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/047d6bc3/uploads/origins/e64b2844-bbb9-402b-9edd-7d353f0b5c9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=070179b0db9f3d45d2b8d16555e10258", "srcset": "https://si.imgix.net/047d6bc3/uploads/origins/e64b2844-bbb9-402b-9edd-7d353f0b5c9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=070179b0db9f3d45d2b8d16555e10258, https://si.imgix.net/047d6bc3/uploads/origins/e64b2844-bbb9-402b-9edd-7d353f0b5c9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3ce8da83de30e87f6de612702133999c 2x, https://si.imgix.net/047d6bc3/uploads/origins/e64b2844-bbb9-4