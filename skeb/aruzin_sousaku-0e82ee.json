ちゃくちゃ気にしいでややネガティブ人間。得意料理肉じゃが、お昼は持参派。\n\nhttps://drive.google.com/drive/folders/100yOMjYv27_0bn9NWxO1KkNTEfaUGDOi?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@szmmmi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2557472, "client_id": 2434143, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b29ac995/uploads/origins/c27daa81-c28d-464f-8059-6427f7631804?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dda51b0fed8d7c176389cef27eaa31f9", "srcset": "https://si.imgix.net/b29ac995/uploads/origins/c27daa81-c28d-464f-8059-6427f7631804?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dda51b0fed8d7c176389cef27eaa31f9, https://si.imgix.net/b29ac995/uploads/origins/c27daa81-c28d-464f-8059-6427f7631804?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=406bd43e90daf15f03698d2a2eead52a 2x, https://si.imgix.net/b29ac995/uploads/origins/c27daa81-c28d-464f-8059-6427f7631804?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fc1a78cac527bceae8ceabf963df6da 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b29ac995/uploads/origins/c27daa81-c28d-464f-8059-6427f7631804?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e6fe5459d257e38d371b404272ea846", "srcset": "https://si.imgix.net/b29ac995/uploads/origins/c27daa81-c28d-464f-8059-6427f7631804?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e6fe5459d257e38d371b404272ea846, https://si.imgix.net/b29ac995/uploads/origins/c27daa81-c28d-464f-8059-6427f7631804?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1d78acf2d0b812e4ac69340ff2704db8 2x, https://si.imgix.net/b29ac995/uploads/origins/c27daa81-c28d-464f-8