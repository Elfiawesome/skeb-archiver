りとは別に人物だけ透過した物や、\nちょっとした表情差分等頂けたらありがたいです！\nもし可能でしたらpsd等で頂けたらとても助かります！\n\n[構図]\n特に指定はありません！\n\n[特徴]\nサキュバスなのに女の子が大好きすぎて、魔界を追放されてしまった悪魔VTuber。\nいつも元気にわいわい騒ぎながらゲーム配信をしたり、\n歌配信でロックやセクシーな歌を歌いこなすギャップがあったり、\n色々なジャンルで配信活動をしております！\n・サキュバス\n・右目下に泣きボクロ\n・八重歯\n・ちょっと幼さがある\n三面図を添付させて頂きます。\n\nーーーーーーーーーーーーーーーーーーーーーーー\n\n是非、ご検討宜しくお願い致します！\n\nhttps://drive.google.com/file/d/1p-FtcMciGbE-6JW8INFdOSIcrBIMb0t-/view?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_cyIlm/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3441674, "client_id": 195625, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7522f0df/uploads/origins/3c4255ff-9341-401d-b196-3fc43e38a7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e1d53db5b0b6c5f7044f979d508b4c9", "srcset": "https://si.imgix.net/7522f0df/uploads/origins/3c4255ff-9341-401d-b196-3fc43e38a7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e1d53db5b0b6c5f7044f979d508b4c9, https://si.imgix.net/7522f0df/uploads/origins/3c4255ff-9341-401d-b196-3fc43e38a7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6404018b7da0e5d6bb3ab3b95c1ee9fd 2x, https://si.imgix.net/7522f0df/uploads/origins/3c4255ff-9341-401d-b196-3fc43e38a7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c25a9c1ff17cdb442be7160b92f72dfc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7522f0df/uploads/origins/3c4255ff-9341-401d-b196-3fc43e38a7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cec1c489b7a163989b0462469a4533d", "srcset": "https://si.imgix.net/7522f0df/uploads/origins/3c4255ff-9341-401d-b196-3fc43e38a7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cec1c489b7a163989b046