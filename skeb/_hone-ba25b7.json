0&h=200&s=1cd74bb3b0566cdfbfcf616d9f9ac9ac", "srcset": "https://si.imgix.net/232fb966/uploads/origins/95d5fc85-ad62-420e-81e7-0b06a49c918b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cd74bb3b0566cdfbfcf616d9f9ac9ac, https://si.imgix.net/232fb966/uploads/origins/95d5fc85-ad62-420e-81e7-0b06a49c918b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76f4a1d3f45fe934539794a667b1e711 2x, https://si.imgix.net/232fb966/uploads/origins/95d5fc85-ad62-420e-81e7-0b06a49c918b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c93f93bedfcf0fe54e3038d185733482 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/232fb966/uploads/origins/95d5fc85-ad62-420e-81e7-0b06a49c918b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=197ea568da5d02b913d6cefe87a815d8", "srcset": "https://si.imgix.net/232fb966/uploads/origins/95d5fc85-ad62-420e-81e7-0b06a49c918b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=197ea568da5d02b913d6cefe87a815d8, https://si.imgix.net/232fb966/uploads/origins/95d5fc85-ad62-420e-81e7-0b06a49c918b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1cf7907052bad0143d804c7c5816bb48 2x, https://si.imgix.net/232fb966/uploads/origins/95d5fc85-ad62-420e-81e7-0b06a49c918b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7ed19ba2d08458238ce5621fc7aa7e4f 3x"}, "body": "前回はとても良い漫画を描いて頂き、誠にありがとうございました。\n是非リピートさせてください。\n\n\nキャラ：アイドルマスターシンデレラガールズの鷺沢文香さん\n衣装：一瞬の誘惑（特訓前）\nシチュ：前回の美優さんと同じ感じで、今度は起きたら文香さんとプロデューサーが入れ替わっている。\n\n詳細\n朝起きたら文香さんと入れ替わっていたプロデューサー。\n驚きつつも、今度は鷺沢さんとか……と言った感じで鏡の前で身体を触ったり胸を触って乳首を弄ったりする。前回より慣れが入っている為、その状況を楽しんでいて美優さんとの体つきや感じ方の違いを堪能していく。（乳首が感じやすかったり、天然パイパンであることに驚いたり）\n前と同じように膣内に指を入れようとするが、丁度良くディルドを発見しそれでオナニーをする。\nこんな大きい物が入るのかとドキドキしながら入れるが、身体の方は慣れているらしく、指とは全く違う奥に当たる感触にドハマりし、仰け反りながら潮を噴いて絶頂する。\n\n自分の身体になった文香から連絡が来るが、プロデューサー自身は泊まりで美優さんと地方ロケに向かっており、直ぐに帰ってくる事が出来ない。美優さんの付き添い程度で良いので文香に自分の仕事を任せ、その時間で更にオナニーをし続けようと決める。\n\n\n前回と同じく、文香さんらしくないニヤニヤした表情で描いて頂けると嬉しいです。\n\nどうぞよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_hone/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/90ac55b4/uploads/origins/67453c55-b235-42a6-8e82-970ca856d5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c071d1ef58dc76f8d1702cf158ee70e4", "srcset": "https://si.imgix.net/90ac55b4/uploads/origins/67453c55-b235-42a6-8e82-970ca856d5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c071d1ef58dc76f8d1702cf158ee70e4, https://si.imgix.net/90ac55b4/uploads/origins/67453c55-b235-42a6-8e82-970ca856d5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6912b9bcc49a43c72a34794b4ec713a1 2x, https://si.imgix.net/90ac55b4/uploads/origins/67453c55-b235-42a6-8e82-970ca856d5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5b2b23397b2f634c0e8771118746a63 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 735262, "client_id": 207086, "nc": 160}, {"path": "/@_hone/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 735262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/778fb281/uploads/origins/3a2b9d51-07f5-448b-98fa-a97738116358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e15f01a8ac6b725a09fac9254e9ae8c", "srcset": "https://si.imgix.net/778fb281/uploads/origins/3a2b9d51-07f5-448b-98fa-a97738116358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e15f01a8ac6b725a09fac9254e9ae8c, https://si.imgix.net/778fb281/uploads/origins/3a2b9d51-07f5-448b-98fa-a97738116358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0fc62577e5396855f28d8e0db6ca9ca 2x, https://si.imgix.net/778fb281/uploads/origins/3a2b9d51-07f5-448b-98fa-a97738116358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9812039aba9ebf4e629cb06eb0a834ab 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/778fb281/uploads/origins/3a2b9d51-07f5-448b-98fa-a97738116358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3012165b0bdd5de6a72fb2f818735441", "srcset": "https://si.imgix.net/778fb281/uploads/origins/3a2b9d51-07f5-448b-98fa-a97738116358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3012165b0bdd5de6a72fb2f818735441, https://si.imgix.net/778fb281/uploads/origins/3a2b9d51-07f5-448b-98fa-a97738116358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=048e72f91426f689ee93c54bbf941e28 2x, https://si.imgix.net/778fb281/uploads/origins/3a2b9d51-07f5-448b-98fa-a97738116358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4ad86b2709c88922546d2a7a5e713a11 3x"}, "body": "ホテルの1室に集められたアイドル達。\nメンバーは三船美優、鷺沢文香、新田美波、結城晴、相葉夕美、中野有香、栗原ネネ、乙倉悠貴。全員全裸で羞恥に顔を染めて立っている。\n\n丁寧な口調の撮影者に促され、1人ずつカメラの前に立たされて自己紹介。ここでは、全身が写るようにお願いします。\n\n全員の自己紹介が終わると、アイドル達が自ら首輪をはめて、「この身体を好きにしてください。あなたの奴隷になります」と涙を流して宣言。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_hone/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 735262, "client_id": 27777,