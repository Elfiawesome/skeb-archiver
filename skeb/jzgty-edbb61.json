関係ですが、\n飛鳥は自分の失くした家族だけを家族としていて、\n仁馬も、衣食住を整える程度。\n家族になったり、特別誕生日を祝う事はしていません。\nあくまで「同居人」として生活を共にしました。\n\nイラストの指定等は特に御座いませんので、お好きに描いて頂けたらと思います！\n\nhttps://drive.google.com/drive/folders/1--n65OgW4b5v9OU2O4bXqre329QZF17K", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jzgty/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2135097, "client_id": 2944648, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55d1d16a/uploads/origins/259069cb-5901-4d45-9bee-8d7267a655d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf4bf0ba7eb49295dad519c04d5e7685", "srcset": "https://si.imgix.net/55d1d16a/uploads/origins/259069cb-5901-4d45-9bee-8d7267a655d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf4bf0ba7eb49295dad519c04d5e7685, https://si.imgix.net/55d1d16a/uploads/origins/259069cb-5901-4d45-9bee-8d7267a655d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=673f884cbc3fa99f1fbadf0de321ca74 2x, https://si.imgix.net/55d1d16a/uploads/origins/259069cb-5901-4d45-9bee-8d7267a655d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=143430c4104d1fd9cb54fcec835ac139 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55d1d16a/uploads/origins/259069cb-5901-4d45-9bee-8d7267a655d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eda463a209f4d25577c324156da0d3e3", "srcset": "https://si.imgix.net/55d1d16a/uploads/origins/259069cb-5901-4d45-9bee-8d7267a655d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eda463a209f4d25577c324156da0d3e3, https://si.imgix.net/55d1d16a/uploads/origins/259069cb-5901-4d45-9bee-8d7267a655d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c6594e2705be8