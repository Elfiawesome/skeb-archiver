描きやすいようにお好きに描いていただければと思います！服装等の選択/省略も含め、全てお任せいたします。\nもし悩まれるようでしたら冬の空気感、お出かけの感じだと嬉しいです！\n\n✧ ︎使用用途\n基本的に鑑賞目的になります。他に\n・作者様を明記した上でのSNSへの投稿/アイコンやヘッダー/別の方に依頼する際の参考資料\n・個人的なグッズ作成（アクリルキーホルダー等）\nに使用する可能性がございます。\n\n​───────​───────\n\nここまでお読みいただきありがとうございました！\n金額が見合わないあるいは文章に不備がある場合は、ご遠慮なくキャンセルや再送のご対応をしていただければと思います。 よろしくお願いいたします！\n\nhttps://drive.google.com/drive/u/0/mobile/folders/1-17SIeDc9AANiU-5YIui1cEWkaFVL4zI", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jzgty/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2135097, "client_id": 1917112, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8684022/uploads/origins/4179274b-d94d-4b73-834c-e3c300f58605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40ad08acdd65033d8a92a7e531520df2", "srcset": "https://si.imgix.net/b8684022/uploads/origins/4179274b-d94d-4b73-834c-e3c300f58605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40ad08acdd65033d8a92a7e531520df2, https://si.imgix.net/b8684022/uploads/origins/4179274b-d94d-4b73-834c-e3c300f58605?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=714ece7c997fdcb6eb05c799ca85d676 2x, https://si.imgix.net/b8684022/uploads/origins/4179274b-d94d-4b73-834c-e3c300f58605?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed7afeea0a1b51b8a69323df18727bd9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8684022/uploads/origins/4179274b-d94d-4b73-834c-e3c300f58605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1143631d0e0d142b9f63dac31b71264", "srcset": "https://si.imgix.net/b8684022/uploads/origins/4179274b-d94d-4b73-834c-e3c300f58605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1143631d0e0d142b9f63dac