T\n\nhttps://drive.google.com/drive/folders/1Mj7bNlpIf4lHMF1EVlnt0VCFstPVD5Qt", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekoteyan2525/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1153993, "client_id": 3133496, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5b7d6ee/uploads/origins/e22f78c9-3343-480c-9313-65b2c60e6f65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=facb100ec6d37b7d50852513d1c3dd03", "srcset": "https://si.imgix.net/b5b7d6ee/uploads/origins/e22f78c9-3343-480c-9313-65b2c60e6f65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=facb100ec6d37b7d50852513d1c3dd03, https://si.imgix.net/b5b7d6ee/uploads/origins/e22f78c9-3343-480c-9313-65b2c60e6f65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad91cfdd0b2691cbdf3e373ce7fe966e 2x, https://si.imgix.net/b5b7d6ee/uploads/origins/e22f78c9-3343-480c-9313-65b2c60e6f65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49d448f6055b024b84e50a4d09683a89 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5b7d6ee/uploads/origins/e22f78c9-3343-480c-9313-65b2c60e6f65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3194435287690b91648fca274647f6e", "srcset": "https://si.imgix.net/b5b7d6ee/uploads/origins/e22f78c9-3343-480c-9313-65b2c60e6f65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3194435287690b91648fca274647f6e, https://si.imgix.net/b5b7d6ee/uploads/origins/e22f78c9-3343-480c-9313-65b2c60e6f65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ea822c2e1bd84deb050f6afefb8a9430 2x, https://si.imgix.net/b5b7d6ee/uploads/origins/e22f78c9-3343-480c-9313-65b2c60e6f65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4e28ebbb9d165ae7e4499d01ad97a321 3x"}, "body": "ねこてやさま 初めまして！\nうーる100％と申します。Twitterのおすすめからとても可愛らしいイラストを拝見して私のTRPGのOCをお願いしたく依頼致しました！\n\n全身絵の1枚絵 \n背景なし透過のpngもあわせていただけると嬉しいです。\nポーズなどは、ねこてやさまのやりやすいようにしてください！\n\n\n✧キャラクター\n水峯 みに(20) 144cm\n「なにそれ知らないー！どうなってるのー？」\n「わぁ！びっくりしたぁ！」\n\n✧性格など\nちょいアホの子。自分が分からないこと、気になることを知ることが楽しいと感じる子。\n形から入る子なので、探偵っぽい洋服や小物を身につけてる。\n\nその中の1つである虫眼鏡持って街中をムムム〜っ！ここに事件の香りがあるのでは〜！？ってしてる。\n\n本人は特に好きなわけじゃないけど、周りの友人達からは名前が似てるのと身長が小さい関係からみにぃちゃんと呼ばれてて何かとミ○ーちゃんグッズを頂きがち。\n本人はド○ルドが好き。\n \n一緒に働いてる探偵さんの事は、なんでも解決してくれてなんでも知ってて尊敬してる(キラキラ)\n\n\n✧使用用途\n･ココフォリアでの駒使用\n･スマホ内での個人鑑賞\n･グッズ化(個人鑑賞用)可能であれば透過verデータも希望\n･他クリエイター様へのご依頼する際の資料\n\n\n以上となります、ご縁がありましたらどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1evlwaRq8LXZthWsGQ109KMmKzUFIghq5", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekoteyan2525/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1153993, "client_id": 3996164, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2a44168/uploads/origins/2b07abb7-def6-4926-bbb6-fb58b102d6e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94e79ff1607e50a3b981476075f0bd3c", "srcset": "https://si.imgix.net/c2a44168/uploads/origins/2b07abb7-def6-4926-bbb6-fb58b102d6e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94e79ff1607e50a3b981476075f0bd3c, https://si.imgix.net/c2a44168/uploads/origins/2b07abb7-def6-4926-bbb6-fb58b102d6e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b43be53791f04df368135840d14b917 2x, https://si.imgix.net/c2a44168/uploads/origins/2b07abb7-def6-4926-bbb6-fb58b102d6e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d1e0f326abcd4564ff5e291d3db11e1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_ur