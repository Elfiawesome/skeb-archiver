your choices so feel free to experiment and do whatever you think would work best with the character. Thank you so much for looking at my request, I look forward to working with you!\n\nhttps://toyhou.se/11863273.zero", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hfdayo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2023098, "client_id": 2340755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb812daf/uploads/origins/615cb823-d5a8-4caa-9e79-8d01218523d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e3cc30fe446dc2117b3d69c678bc053", "srcset": "https://si.imgix.net/eb812daf/uploads/origins/615cb823-d5a8-4caa-9e79-8d01218523d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e3cc30fe446dc2117b3d69c678bc053, https://si.imgix.net/eb812daf/uploads/origins/615cb823-d5a8-4caa-9e79-8d01218523d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4564a805545416ac5eceb58f47fba7b6 2x, https://si.imgix.net/eb812daf/uploads/origins/615cb823-d5a8-4caa-9e79-8d01218523d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33b44327cb6395b07a19d4b56442d73b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb812daf/uploads/origins/615cb823-d5a8-4caa-9e79-8d01218523d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cac06734d84adffa90464364c2f8c78", "srcset": "https://si.imgix.net/eb812daf/uploads/origins/615cb823-d5a8-4caa-9e79-8d01218523d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cac06734d84adffa90464364c2f8c78, https://si.imgix.net/eb812daf/uploads/origins/615cb823-d5a8-4caa-9e79-8d01218523d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b70dfb2