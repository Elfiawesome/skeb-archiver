clr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=538c4f6baff62197aee04976af5aa8c9", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3555397, "client_id": 315035, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Nanahoshi_7ka/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3555397, "client_id": 1094264, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/845dfb5d/uploads/origins/d81d799f-b5e8-4b28-8bbf-e0af4a64ab37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b5e91c3d4159a1489e5b584933ce0f0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/845dfb5d/uploads/origins/d81d799f-b5e8-4b28-8bbf-e0af4a64ab37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd05ee51d1a9e57686ade225f091b1aa", "src_set": ""}, "body": "先日は、素敵なイラストを描いて頂き、ありがとうございました。\n次は、夢見／りあむがスッポンの顔出し着ぐるみを着ているイラストをリクエストします。\nイラストは下記のイメージです。\n\n□着ぐるみイメージ\n・別添URL参考\n・スッポンの首のあたりから顔出し\n・甲羅のお腹部分に穴を設け、タイツ越しに大きな胸が見えるようにする\n・着ぐるみの全身をできるだけ見てみたいです（参考資料と同程度の大きさのイメージ、可能な範囲でOKです）\n\n□シチュ案\n①スッポンの着ぐるみを着せられて、仰向けで寝かされた状態\n②嫌がっている表情、恥ずかしがる表情\n※ポーズは描きやすいものでOKです\n\nもし、よろしければ、ご検討の程お願いします！\n\nhttps://x.com/shokugeki_anime/status/1169911152605712385", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Nanahoshi_7ka/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3555397, "client_id": 608900, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65e77632/uploads/origins/6bf14e0d-5a10-499d-9ac6-f7d869818593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38e6a45fcfc0ae6e2053939bd5a4c0ea", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65e77632/uploads/origins/6bf14e0d-5a10-499d-9ac6-f7d869818593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8efcbdb6de4061e985256e712b75649c", "src_set": ""}, "body": "お世話になります。いつも素晴らしいイラストをありがとうございます。\n今回は貴方のOCちゃんでのリクエストさせていただく次第です。\nお忙しいところ恐縮ですが、ご検討ください。\n\nななかさんのOCちゃん(黒髪の子です)が、下記参考のようなケーキの顔出し着ぐるみを着ているイラストをお願いします。\n着ぐるみ参考：①https://imgur.com/a/kA0h9TT　②https://imgur.com/a/uSYUuuk\n参考①の形状で、カラーを参考②にしていただきたいです。\n\nまた、着ぐるみについて、可能な範囲で下記のようにしていただきたいです。\n・着ぐるみの下は白い全身タイツ着用\n・顔穴とは違う、着ぐるみの側面からツインテールが飛び出している\n・頭頂部のろうそくが主張するように明るく光っている(可能であれば)\n・「本日の主役」と書かれたタスキ(パーティーグッズのやつです)を身に着けている(可能であれば)\n　文字が面倒でしたら簡潔なもので問題ございません。\n\n表情は恥じらいを感じながら笑顔のもので、ポーズを決めているものを希望します。\n詳細は貴方の好きなポーズで問題ございませんが、ピースしているものだと嬉しいです。\nまた、髪無しの差分もいただきたいです。\n可能であれば、ケーキのクリームのように顔を白く塗っているものもいただきたいです。\n(無論ですが、運用方針の通りすべてに応えていただかなくて問題ございません)\n\n希望が多くなってしまい申し訳ございませんが、是非よろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Nanahoshi_7ka/works/25", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cfbf105c/uploads/origins/adf34792-c454-4441-b2a2-24b30aaf4a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c75979e87e1d6bbe5c70b774770748b9", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3555397, "client_id": 848052, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Nanahoshi_7ka/works/24", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d02d215e/uploads/origi