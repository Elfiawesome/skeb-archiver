2dfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e9ce0daeef07801dc44a3feeb2f9912", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/884c1636/uploads/origins/03cd97b7-a612-4e2a-9fd9-e0395b822dfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d6ac7f25425f1c597c605e117b2516d", "src_set": ""}, "body": "以下の内容でリクエストさせてはいただけませんでしょうか？\n\n●キャラ\n〇玉付きのフタナリ熟女\n〇名家の夫と娘がいる人妻経産婦の貴婦人\n〇オールバックにしたショートカットの金髪\n〇目付きの鋭い碧眼\n〇爆乳・長乳\n〇巨乳首・巨乳輪のパフィーニップル\n〇腋毛や陰毛は無い。\n〇資料URLのように白い半袖のポロシャツ、ネイビーのキュロット、黒いブーツを身に着け、ポロシャツの裾をキュロットにたくし込んでいる。\n〇ポロシャツのボタンは全て留めている。\n〇ノーブラであって胸ポチが見えている。\n〇キュロットの上からでもペニスと陰嚢の形はくっきりしている。\n〇結婚指輪をしている。\n〇夫と愛し合っており、娘とも仲が良い。\n〇病気で倒れた夫に代わり、領地を経営していたが、悪徳業者の罠に掛かってしまう。\n〇先祖代々受け継がれてきた領地を守るため、夫と娘には内緒で悪徳業者の愛人になる。\n\n●シチュエーション\n〇悪徳業者がフタナリ熟女のペニスと陰嚢をキュロットの上からこねくり回す。\n〇フタナリ熟女は完全着衣で両手を頭の後ろに回し、がに股になっている。\n〇気の強いフタナリ熟女は気丈に耐えようとするが、羞恥と快楽で顔を火照らせ、荒い息を吐きながら感じている。\n\nご検討いただけましたら幸いに存じます。\n\nhttps://shop.r10s.jp/gold/jobayohin/img/item/d036_kx100_21.jpg", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@leyton_oekaki/works/140", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1c785d84/uploads/origins/7f82d986-5ef2-4d68-b528-3309213847e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c6a3e037c508bacec4749f49e5665a6", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2002193, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@leyton_oekaki/works/139", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false