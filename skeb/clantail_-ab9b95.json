681-4696-9d76-c0df7b119fcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8e4812da52b11334402244473802c846 3x"}, "body": "前回のリクエストでは大変お世話になりました。\n前回と同じ柔道少年のイラストをお願いできないでしょうか……？\n\n前回の続きで、気合を入れて試合に臨んだものの、部活の練習では負けたことのない後輩に寝技に持ち込まれ、抵抗も虚しく絞められて、「ちくしょう、今まで一度も負けたことないのに……!!」と悔しがって涙目になっているような感じ。\n\n絞めている後輩は腕だけ等、身体の一部分だけで問題ありませんので、ご検討くださいましたら幸いです。\nよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@clantail_/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 183480, "client_id": 2249248, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/893d71f4/uploads/origins/53bd657f-c4b4-450f-aacd-2e4dd5d8e86a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6325d1f9c350133a008f867a644eca5c", "srcset": "https://si.imgix.net/893d71f4/uploads/origins/53bd657f-c4b4-450f-aacd-2e4dd5d8e86a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6325d1f9c350133a008f867a644eca5c, https://si.imgix.net/893d71f4/uploads/origins/53bd657f-c4b4-450f-aacd-2e4dd5d8e86a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8dcc85757dd62f7cf203a639b9794335 2x, https://si.imgix.net/893d71f4/uploads/origins/53bd657f-c4b4-450f-aacd-2e4dd5d8e86a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f901e1b8aa4be3931581d455737e9d0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/893d71f4/uploads/origins/53bd657f-c4b4-450f-aacd-2e4dd5d8e86a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8735867822321007ff2be20470a7f8ed", "srcset": "https://si.imgix.net/893d71f4/uploads/origins/53bd657f-c4b4-450f-aacd-2e4dd5d8e86a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8735867822321007ff2be20470a7f8ed, https://si.imgix.net/893d71f4/uploads/origins/53bd657f-c4b4-450f-aacd-2e4dd5d8e86a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9e144bcd82ba2655f9dd2b014969a7f 2x, https://si.imgix.net/893d71f4/uploads/origins/53bd657f-c4b4-450f-aacd-2e4dd5d8e86a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea7924721cb36e7a0b73f268e9074cba 3x"}, "body": "こんにちは。お元気でお過ごしでしょうか!\n今回お願いしたいのは、お兄ちゃん1人と双子2人の3兄弟の絵です。兄は少し背が高く、双子は同じ身長と体格です。3兄弟ともとても引き締まった筋肉質な体型です。  \n兄は白い大きな髪を持っています。熱心で決断力があり、家族や友人を守るために常に動いているので、自信に満ちた表情をしてほしい。双子1は真面目な方で、双子2は元気な方です。兄は緑の水晶、双子1は赤の水晶、双子2は青の水晶と、他の絵と同じようなネックレスを入れてください。\n服装は、運動着でも動きやすいパーカーでも、シャツ一枚で短パンでも、何でもかわいいと思うものをデザインしてください。\nポーズは自由です。\n背景はシンプルなもので構いません。\nありがとうございました！！！！！！！！！！！！！！！！！！！！！！！！！ 受け取ってくれると嬉しいです\n\nhttps://drive.google.com/drive/folders/1-cRs6eQZPSUvjbbU8vdrdQhRacNwvil2", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@clantail_/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 183480, "client_id": 317766, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/863bc9b3/uploads/origins/d811614a-2c1b-4cd0-be92-76359a85544a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56d397c34177388a324b2ece4079ca1c", "srcset": "https://si.imgix.net/863bc9b3/uploads/origins/d811614a-2c1b-4cd0-be92-76359a85544a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56d397c34177388a324b2ece4079ca1c, https://si.imgix.net/863bc9b3/uploads/origins/d811614a-2c1b-4cd0-be92-76359a85544a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=673478a8a1746dc0957eb722277406a6 2x, https://si.imgix.net/863bc9b3/uploads/origins/d811614a-2c1b-4cd0-be92-76359a85544a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36cefed00b1e4da09735895dacbacf77 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/863bc9b3/uploads/origins/d811614a-2c1b-4cd0-be92-76359a85544a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=498e75d98e231234341e63208b0f0daf", "srcset": "https://si.imgix.net/863bc9b3/uploads/origins/d811614a-2c1b-4cd0-be92-76359a85544a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=498e75d98e231234341e63208b0f0daf, https://si.imgix.net/863bc9b3/uploads/origins/d811614a-2c1b-4cd0-be92-76359a85544a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd2ceffb55eb43a19f9c50f16376961b 2x, https://si.imgix.net/863bc9b3/uploads/origins/d811614a-2c1b-4cd0-be92-76359a85544a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9477a04d9e053e7c0aa4e6201a03afb9 3x"}, "body": "くらん様\n\nはじめまして！\n『ｱﾆｿﾝｽｹﾍﾞｼｮﾀおじさんVtuber』というショタの見た目のVtuberとして活動しております、\n有T(あるてぃ)と申します。\n\n以前からくらん様をSkebでお見掛けしておりまして、可愛らしく且つ色っぽい素敵な少年イラストを描く方だなって思っており、\n是非私のVの姿を描いていただきたいと思い、\n自推でリクエストのご連絡をさせて頂きました。\nもし描いていただきましたら、大変光栄にございます。\n\nイラストの使用用途として、可能であれば、\nYoutube配信・動画のサムネに載せるキャラクターイラスト等のビジュアル利用、\nタグ付けツイートといった宣伝用等、\nそういったことに、使用させていただければと思っております。\n\n構図等は完全にお任せしようかと思いますが、\nもし可能であればサムネ等に使いやすいよう背景を透過、もしくは白の単色といった形でもいただけると、\n大変ありがたいです。\n\n至らない点が多々あるかとは存じますが、\n何卒宜しくお願い致します。\n\nTwitter : https://twitter.com/ALTYE3\nYoutube : https://www.youtube.com/channel/UC3DAn3SqfD81mbVZuW9igUA\n\nhttps://drive.google.com/file/d/1g78TxxswJ9UlD-LaOunE5kNGHrl6R6FD/view?usp=sharing", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@clantail_/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 183480, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9dcf17d8/uploads/origins/69c83828-aa8c-483e-95fa-885ebde44cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=t