50c-43d1-8fbd-9f93ed5e6178?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c718420b595e277ff2b83a91eb887fc3", "srcset": "https://si.imgix.net/c7d0c0c6/uploads/origins/2255fc75-750c-43d1-8fbd-9f93ed5e6178?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c718420b595e277ff2b83a91eb887fc3, https://si.imgix.net/c7d0c0c6/uploads/origins/2255fc75-750c-43d1-8fbd-9f93ed5e6178?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b7ad67b2426acd812f99fa4b5422532 2x, https://si.imgix.net/c7d0c0c6/uploads/origins/2255fc75-750c-43d1-8fbd-9f93ed5e6178?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e013d5a9aa19b2e00ba4083a4ff02213 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c7d0c0c6/uploads/origins/2255fc75-750c-43d1-8fbd-9f93ed5e6178?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5404bfd811c9f4b725a3067371aaa40f", "srcset": "https://si.imgix.net/c7d0c0c6/uploads/origins/2255fc75-750c-43d1-8fbd-9f93ed5e6178?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5404bfd811c9f4b725a3067371aaa40f, https://si.imgix.net/c7d0c0c6/uploads/origins/2255fc75-750c-43d1-8fbd-9f93ed5e6178?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f06438c8ae9a6731b7889048bb35f430 2x, https://si.imgix.net/c7d0c0c6/uploads/origins/2255fc75-750c-43d1-8fbd-9f93ed5e6178?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c27287ef68bdef4eb9585cd0806b9556 3x"}, "body": "連投失礼します。\nオリジナルキャラで、昔の農家の30歳代前半の\n黒髪女性の緊縛イラストをリクエストしたいです。\n野良着、もんぺ、地下足袋履きで、\n胸をだしてM字開脚縛りされています。\n表情は縛られて、号泣している感じにしてほしいです。\n野良着の色は紺、模様は適当に、もんぺは資料urlのような絣柄、\n地下足袋は黒にしてほしいです。\n頭から、爪先まで全身を描いてほしいです。\n構図など自由に、変更、アレンジしていただいて構いません。\nまた\nもんぺの股間部分を破られ、陰部に張型が挿入され\n表情も苦しそうに涙を流し絶叫している状態もお願いします。\nご検討よろしくお願い致します。\n\nhttps://www.dropbox.com/scl/fi