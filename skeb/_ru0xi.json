で買ったたこ焼きやお団子、もしくはお面など。お祭りを彷彿とさせるアイテムを持たせていただきたいです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_ru0xi/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/12503448/uploads/origins/ccb26158-9228-44df-b865-2993b14deda5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f250835efcaa4d92a20fa151fc1383d", "srcset": "https://si.imgix.net/12503448/uploads/origins/ccb26158-9228-44df-b865-2993b14deda5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f250835efcaa4d92a20fa151fc1383d, https://si.imgix.net/12503448/uploads/origins/ccb26158-9228-44df-b865-2993b14deda5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6987c06dbeef967261708d44ba395b45 2x, https://si.imgix.net/12503448/uploads/origins/ccb26158-9228-44df-b865-2993b14deda5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ff96017a6f586ce864868d647932126 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2659154, "client_id": 2783486, "nc": 128}, {"path": "/@_ru0xi/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0dde0708/uploads/origins/91bf4d25-8dcd-4d50-b19a-d71bf52e9587?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=08efa80de03bbbeaca50451b3880c5a9", "srcset": "https://si.imgix.net/0dde0708/uploads/origins/91bf4d25-8dcd-4d50-b19a-d71bf52e9587?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=