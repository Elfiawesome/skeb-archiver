e_urls": {"src": "https://si.imgix.net/629bda6f/uploads/origins/1008ec2f-6e02-4200-99e4-4a35faaac9ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67a58493fb10d533e7d21b48eadbaa4c", "src_set": ""}, "body": "はじめまして、IRIAM準備中の雷鳴ネクターと申します\nクッキーランのタグがついてるイラストを見て一目惚れして依頼をさせて頂きます\n\n使用用途\nアイコンやサムネイルとして使用させて頂けたら有難く思います\n基本アイコンやサムネイルとして使用したいのですがお披露目イラストとしてX上でも載せさせて頂きたいです\n商用利用、自作発言などせずお披露目会の際、必ずメンションさせて頂きます\n\nポーズ指定はありませんがイメージはクッキーランのようなイラストの雰囲気が希望です\n\nキャラクターについて\n電気の悪魔\n電源コードとコンセントでできてます\n前髪も隠してるだけで出すことも可能です\n目の中に紫色の⚡マーク有\n腕も二の腕の半分くらいからコードで4本指です 手は大きめ\n髪の毛と同じような設定の尻尾が生えてます\n腕、髪、しっぽは伸び縮みしますが髪の毛はだらーんと伸びてるのがデフォルトです\n髪の毛は結束バンドで止めてあります\n性格はポンコツです\nストリート＆ギャルファッションが好きな人外女の子です\n\n設定が多く申し訳ありません…！\n\nXを見ていましたら目に入ったイラストがとても好みかつ本当に描いていただきたく是非お願いできないかと思っております\nよろしければご検討くださると嬉しいです\n\n一点だけお願いがあり、Xに投稿される場合宛名などつける場合は蕾鳴ネクター(@BIRIctor)宛にお願いしたいです\n何卒よろしくお願いいたします\n\nhttps://www.dropbox.com/scl/fi/56wc6lcrp585wt5plwbrm/1.png?rlkey=b32vzw0m932lou97x62ecdjdr&st=f6dun8cg&dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 643211, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "だーやま🍤Skeb", "screen_name": "okshutoku", "avatar_url": "https://pbs.twimg.com/profile_images/1748795882500407296/mUh7w4E4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1199454326/1708449186/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 153}, {"id": 2584736, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ステキね", "screen_name": "majidesutekine", "avatar_url": "https://pbs.twimg.com/profile_images/1904831662867021824/LcLgSsW7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1534204671602348033/1731395872/1500x500", "appeal_receivable": true, "popular_creator_