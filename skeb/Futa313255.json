&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00fb1e7293972e764473b357d3c4615a", "src_set": ""}, "body": "リクエストお願い致します\n\nキャラクター\nブラン（超次元ゲイムネプテューヌシリーズ）\n衣装は、「激次元タッグ ブラン＋ネプテューヌVSゾンビ軍団」の制服でお願いします。\n\nシチュエーション\n男の先輩たちに放課後に誰も居ない教室に連れ込まれて徹底的にレイプされる。\n最初は泣きながら抵抗しているけど、最終的に快楽落ちしてしまうシチュエーションをお願い致します。\n\n制服は脱がさないでお願い致します。\n\nhttps://www.compileheart.com/blanc/chara/img/blanc.png", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Futa313255/works/82", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 235734, "client_id": 626297, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c2f2cde/uploads/origins/b9b388a3-3c7a-48dd-8e33-d21d5439d4e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d60c0563123eb7520eead7637f577cb2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c2f2cde/uploads/origins/b9b388a3-3c7a-48dd-8e33-d21d5439d4e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ded02ee5bbec01a50a4e5c3ba5fbbd1", "src_set": ""}, "body": "futa様\nはじめまして、ありのみと申します\n先生のチルノさんと大妖精さんの仲良しデート漫画をお願いしてもよろしいでしょうか？\n\n相思相愛の恋人同士という前提で\n仲が良さそうな、楽しそうな２人をお願いしたく存じます\nお出掛けでもお部屋でゆっくりでも、普段の服装でもデート服でも\n先生にお任せいたします\n\nご検討のほど宜しくお願い致します\n\n資料画像を用意していますので、もしよろしければご参照下さい\n　体格に大きな差はなく並んで立って目線が合う感じ\n　お胸には差を設けず、二人とも出来る限り小さめでお願い致します\n　(もしまったく同じでは逆に難しい場合は、チルノさんの方が大きめでお願いします)\n\nhttps://twitter.com/ARINOMI7/status/1549022259926695938", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Futa313255/works/81", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/68946a3c/uploads/origins/16aefb47-d2a1-4390-87bc-9f0580f29a56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa7d5c9a6f2621914ac12a2c1bc689d1", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 235734, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Futa313255/works/80", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 235734, "client_id": 90362, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be06cc50/uploads/origins/a838ecd3-a07b-4731-b9d8-98e31ea536be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccf71a5f73e5ed57d1a533db0183cf5c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be06cc50/uploads/origins/a838ecd3-a07b-4731-b9d8-98e31ea536be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5e74a77c66599a655d89b7e82d0c3f8", "src_set": ""}, "body": "再びのリクエスト失礼します。\n今回は東方projectの博麗霊夢でお願いします。\n\n内容\n舞台は年明けの初日の出の瞬間の博麗神社で三妖精に悪戯されるというもので、三妖精の能力でいきなり服を剥ぎ取られて全裸にされ、さらに逆さまでまんぐり返し（体操の肩倒立のようなアレのイメージ）のポーズにされるという内容をお願いします。神社には日の出を見るために珍しく参拝客が多くおり、転んだ瞬間にちょうど良く日が昇って、霊夢の体が、股間もお尻の穴も含めて全てくっきり照らされて参拝客に丸見えになるという構図でお願いできますか？\n\nややこしい内容になりますが、こちらで可能であればよろしくお願いいたします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Futa313255/works/79", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f653567a/uploads/origins/c030dc7c-018e-4d83-9625-900cb1fea1c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dfe65384468f62ca71533d33e94a2e5f", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 235734, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Futa313255/works/78", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 235734, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fce2ead4/uploads/origins/21b01e65-e99a-4de1-a5e4-b0d19134d261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03013deb84534d4e86eba03943558439", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fce2ead4/uploads/origins/21b01e65-e99a-4de1-a5e4-b0d19134d261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dff3cd3c35499285fad65e6a7d5d6122", "src_set": ""}, "body": "いつも漫画やイラストを拝見させていただいています。\n成人向けになりますが、東方Projectのナズーリンと星について漫画を依頼させてください。\n\n■シチュエーション\nーーーーー\n無縁塚の小屋で2人きりで寝ているナズーリンと星が、寝たまま男たちにえっちなことをされてしまう。\n眠りながらも体は反応してしまう2人は、結局なかだしまでされてしまう。\n朝目が覚めた2人は夜起きた出来事に気づいていなかったが、股には精液が伝っていた。\nーーーーー\nシチュエーション以外の設定など、記載していない部分についてはおまかせいたします。\nよろしくお願いいたします……！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Futa313255/works/77", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 235734, "client_id": 66613, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f71ec643/uploads/origins/8bf71c14-4439-4cad-8ac3-ab312394884d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=658f4789b0b8614689a05d6f9e5c4319", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f71ec643/uploads/origins/8bf71c14-4439-4cad-8ac3-ab312394884d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0efacf6bd6b5ad48cc7e490084c770b", "src_set": ""}, "body": "以前は素敵な本読み妖怪をありがとうございました。\n再びリクエストをお送りさせていただきます。\n\n東方Projectの比那名居天子をお願いします。\nhttps://x.com/Touhou_LW/status/1859894590938943846?t=umYjFxKJe36jQhV9syyTqg&s=19\n上記URLの衣装を着た天子とデートしてる最中、お願いして物陰でこっそりスカートをたくし上げてパンツを見せて貰うというシチュエーションでお願いします。\n少し顔を背けて半ば呆れつつもしっかりと全部見せてくれるといった風でお願いします。\nパンツは少し凝った物でいわゆる勝負パンツ系でお願いします。\n\nhttps://x.com/Touhou_LW/status/1859894590938943846?t=yFeGF7fYpxMrdSQ98AxYVw&s=19", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Futa313255/works/76", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 235734, "client_id": 43835, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4fc4ff31/uploads/origins/af54662b-3a1e-4c94-adf2-eff55a58daea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2943dd5e4b1886ef75383e4592a57ac8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4fc4ff31/uploads/origins/af54662b-3a1e-4c94-adf2-eff55a58daea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d26807c74a46a3f0c171e118d44652ce", "src_set": ""}, "body": "メイド服を着た東方Projectのルーミアとミスティアがご主人様にえっちなご奉仕してるイラストをお願いします！\nみすちーはパイズリをしていてルーミアはフェラをしている感じでお願いします！\n目がハートになりながらご主人様が気持ちよさそうにしているのを見て嬉しそうにしていると良いですね…", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Futa313255/works/75", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 235734, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6ee214e/uploads/origins/53d7f3e2-49f8-4c5f-9de4-ccc8e94ee62a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9d9fa834aa6af4f58ada331dbe9fede", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6ee214e/uploads/origins/53d7f3e2-49f8-4c5f-9de4-ccc8e94ee62a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e093df3bb34c2bfe43e7784bc1f1be1f", "src_set": ""}, "body": "前回、こちら（https://skeb.jp/@Futa313255/works/69）をリクエストさせていただいた者です。その節は本当にありがとうございました。今回、再度のリクエストを失礼いたします。\n\n黒谷ヤマメの蜘蛛の巣に大の字で拘束された八雲紫が、ヤマメにディープキスされながら一方的に攻められる、というシチュエーションのモノクロ漫画をお願いいたします。\n出来る限りキスをメインに、また何度も何度も絶頂させられ、身体中蜘蛛糸まみれの紫が完全に弱り切ってしまう様子を描いていただけると嬉しいです。\n\n詳細な構図などについてはお任せいたします。\n\n以上の内容にて、ご一考いただければ幸いです。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Futa313255/works/74", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 235734, "client_id": 31731, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e257eac7/uploads/origins/0a50b967-964f-4707-92f8-0c8a1cbc8db7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fd61a5c97208ffdcf5dacf518183d86", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e257eac7/uploads/origins/0a50b967-964f-4707-92f8-0c8a1cbc8db7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57056d906be375737a82143785c8b13f", "src_set": ""}, "body": "初めましてリクエスト失礼いたします。\n東方よりスターサファイアちゃんのおしおきシチュのイラストをお願いします。\n無理やりまんぐり返しで股を開かされてパンツごしにちんちんすりすりされてる状況で\n半泣きで自分だけは見逃してほしいと懇願しているシーンでお願いします。\nあとなるべく着衣状態でお願いします。\n以上です。ご検討宜しくお願い致します。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Futa313255/works/73", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 235734, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ddb3799e/uploads/origins/be231e4f-3c13-454a-b4d3-2360a8698a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d57538b1e48db711ed9e75ea4afb19f2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ddb3799e/uploads/origins/be231e4f-3c13-454a-b4d3-2360a8698a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6eccfc35a695c1cf73e9658bf4dc415", "src_set": ""}, "body": "こんにちは、リクエストをさせていただきます。\n蓮子とメリーの緊縛イラストをお願いしたいです。\n2人が立った状態で縛られ、並ぶ姿を正面から見た構図でお願いします。\n2人とも露出はなく服やスカートを身につけている完全着衣の状態。\n縛り方は後ろ手で、胸の上下に縄を通され、身体と腕をまとめて縛られている後手高手小手縛り。そこに胸縄を掛けられているという資料URLの先にある高手小手＋胸縄（Y字）でお願いします。\n縛りプレイの体験している蓮メリの設定です。\n蓮子は初体験で好奇心に満ちた表情。メリーは少し恥ずかしさが出てる表情でお願いします。\n\n以上になりますがご検討頂けますと幸いです。\n\nhttps://downloads.fanbox.cc/images/post/6210415/gG2l9XPDdW7JCrMdKD8gIOan.jpeg", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Futa313255/works/72", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 235734, "client_id": 892189, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34ac63b3/uploads/origins/e261813d-c427-49de-9836-c2abc40aa314?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abeb56634b935c48f1a150be618a41eb", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34ac63b3/uploads/origins/e261813d-c427-49de-9836-c2abc40aa314?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31bb973e78c313e28ed8878e1f4f85ae", "src_set": ""}, "body": "こんにちは。今回、futaさんに茨木華扇と聖白蓮の着衣(水着)と脱衣の差分エロイラストを描いていただきたく依頼致します。内容は以下の通りです。\n基本的な構図\n：両者とも立ったままモブ竿役に背後から乳揉みされつつ、華扇ちゃんがキス、聖さまが股間(クリトリス)をまさぐられているシチュ。\n着衣\n：両者紐ビキニ(色は華扇ちゃんがピンクで紐と縁が金色、聖さまが黒で紐と縁が白)を着用、胸ポチあり。\n脱衣\n：両者全裸となり、可能であれば立ちバックで挿入され中出しされている描写を描いていただけると嬉しいです。\n背景はピーチ、プール等問いません。\n我儘な内容と拙い文章で恐縮ですが、引き受けてくださると幸いです。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_s