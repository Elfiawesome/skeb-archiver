rigins/4117d172-0c93-4f01-a85e-7f4055276c61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=072d55a526bb6611992bdcb3b9ad1323, https://si.imgix.net/9aeb8067/uploads/origins/4117d172-0c93-4f01-a85e-7f4055276c61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f34420d1dc8205c3ebe8af845f7a2d0f 2x, https://si.imgix.net/9aeb8067/uploads/origins/4117d172-0c93-4f01-a85e-7f4055276c61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7419ae4ea741cf67e8bec92d3a9862be 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9aeb8067/uploads/origins/4117d172-0c93-4f01-a85e-7f4055276c61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d37c9f294a11756580ad97d3a93339c", "srcset": "https://si.imgix.net/9aeb8067/uploads/origins/4117d172-0c93-4f01-a85e-7f4055276c61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d37c9f294a11756580ad97d3a93339c, https://si.imgix.net/9aeb8067/uploads/origins/4117d172-0c93-4f01-a85e-7f4055276c61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=87ce870b07ff03a10bf17d2b2fdc58df 2x, https://si.imgix.net/9aeb8067/uploads/origins/4117d172-0c93-4f01-a85e-7f4055276c61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d0e010c2171befe89b2e6be1a6fef40a 3x"}, "body": "書くかも程度ですがドM小説の挿絵に利用したいです\nシチュ：\n触手に寄生された着衣超乳&着衣ボテ腹姿の二人(アーリャ、753)に、M男がマゾ豚と嫌悪され蔑まれるドMホイホイシチュ(M男主観で二人が着衣超乳&着衣ボテ腹姿を見せつける)\n\n二人ともゴミを見る冷めた目(顔の上部や目元まで影がかかりハイライトなし)で、ドM男への嫌悪MAXを一切隠さない強い侮蔑の表情で、全\n身が粘度の高いどろどろの粘液まみれで衣服が超乳やボテ腹にべっとりと張り付き\n片乳だけで両腕でも抱え込めない、頭&胴体以上のサイズ&服越しのピンク色の勃起乳首の着衣超乳とその超乳と同サイズの特大着衣ボテ腹(完全着衣状態/妊娠淫紋付)姿希望\n\n753は肉塊卵満載の触手をパンツ下から溢れさせ、アーリャはふたなり(触手)ペニスの鈴口は全開で\n(触手)尿道口から特濃媚薬精液及び粘液まみれの触手の赤ちゃん(尿道をふさぐほどの太さ)を大量に溢れさせ、\nペニスの尿道を触手が抉じ開け、淫紋付き孕み玉袋の中で触手が蠢いている様子が外からわかる描写(黒ノリ修正希望)希望\nこの際二人ともは一切の苦痛を感じず強烈な快感を感じて身体を震わせたりしていますがアへ顔等はなく、\nM男を蔑んでいる要素(男では快感に耐え切れないと蔑む感じ)を優先で、\n可能なら超乳やボテ腹内部で孕んだ大量の粘液まみれの触手が蠢き外から見ても歪に変形している描写希望\n\n背景は触手肉壁orダーク系、粘液まみれの触手が蠢く水音等の効果音、ON/OFF切替表示可能なpsd形式で+優先度低で、\n753は超乳や子宮、アナル、アーリャはそれに加え(触手)ペニスや玉袋まで触手の苗床に改造される工程及び一切の苦痛のない純粋な快感をM男に説明し、\nその説明に興奮して勃起したM男を嫌悪・侮蔑、先ほど説明した工程で二人と同じ触手苗床への改造宣告台詞をON/OFFできるように希望します\n特に触手が乳腺や尿道、アナルを抉じ開け侵入し内部で蠢いて苗床にされる工程&快感の詳細説明台詞希望です\n\n更にM男の肉体改造後の描写として、二人の立ち絵はそのままで別バージョンの台詞として、ドM男が二人と同じ超乳&ボテ腹&膨玉&尿道責め中ペニスを触手苗床に改造され、\n快感に悶えながらマゾ射精して尿道やアナル、乳腺から触手を溢れさせている様子をゴミを見るような目で蔑みながら心底嫌悪・侮蔑している台詞の有無希望\n\nhttps://drive.google.com/drive/folders/1io_wW7nd0g0NrDkel2Vd8EJWZamjRVb4?usp=sharing", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2977, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "M.ロレンス", "screen_name": "Bod_fosse", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F5518c8b8-3b21-4ef6-ae9a-596fba303caf.png%3Fsensitive%3Dtrue&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/71c1e41a-a7ca-4b4f-8877-4f7141acc2b1.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 32}, {"id": 62937, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "村人豆腐店", "screen_name": "murabitoufu", "avatar_url": "https://pbs.twimg.com/profile_images/1882781091825848320/47wBXJ3Y.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 49}, {"id": 255004, "creator": true, "nsfw_acceptable": true, "acce