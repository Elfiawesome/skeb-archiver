3b3cd365d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb18793e5a73d73936411fabae181228, https://si.imgix.net/41d8a968/uploads/origins/b193d356-efbb-427a-af22-8533b3cd365d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b4cb6972ea467ca5d91b80349113e54 2x, https://si.imgix.net/41d8a968/uploads/origins/b193d356-efbb-427a-af22-8533b3cd365d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fea6183378fdff3e83ee0d771173798 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41d8a968/uploads/origins/b193d356-efbb-427a-af22-8533b3cd365d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81e79cfa445586588376c04baaf8e12c", "srcset": "https://si.imgix.net/41d8a968/uploads/origins/b193d356-efbb-427a-af22-8533b3cd365d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81e79cfa445586588376c04baaf8e12c, https://si.imgix.net/41d8a968/uploads/origins/b193d356-efbb-427a-af22-8533b3cd365d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7fc74a20d3f0a5b97ff4eff9f2f435a5 2x, https://si.imgix.net/41d8a968/uploads/origins/b193d356-efbb-427a-af22-8533b3cd365d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5c431d3da86c88cc3623d957437f3cab 3x"}, "body": "お世話になっております！\nいつも素敵なイラストをありがとうございます🙇‍♀️\n今回は【拝啓、贖イ郵便局の皆様へ】の自陣を描いていただきたくリクエストを送らせて頂きました。\n\n◆ キャラクター詳細\nHO東｜東條 青樹（とうじょう はるき）｜29歳\n俺／お前（自陣は呼び捨て）\n真顔／微笑み\n煙草や体を動かすことが好き。酒に強い。\n性格はヘラヘラ系だが班員が個性豊かなため母親的存在の西に合わせ父親的存在でいる。\n責任感が強く仲間思い。\n「俺は欲張りだから全部欲しい」\n「お前らのこと家族だと思ってる」\n\nHO西｜西牧 的衣（にしまき まとい）｜31歳\nボク／君（東班長or青樹くん、南留夏くん、北千玄くん）\nオドオド／泣き\n自尊心が著しく欠如しヒステリックに喚き泣くことが多々あるが、周りのことをよく見ており人に気が使える。自陣のことを大切に思っており時々菩薩のような笑みをする。\n「そっか、そうだよね、ボクが全部悪いよね、はは、ボクなんかがごめんね……」\n\nHO南｜日南 留夏（ひなみ るか）｜17歳\nオレ／お前（東班長、西的衣さん、北千玄）\n真顔／怒／ドヤ\n戦闘が得意。\n負けず嫌いな性格であり、子供らしく素直。\n好きな物はかっこいいこと、もの。\n北に身長をいじられがちでよく怒っている。\n「オレは子供じゃない。身長はこれから伸びるんだよ」\n\nHO北｜北巡 千玄（きたゆき ちはる）｜25歳\n俺／あんた（東はんちょ、西アッシー先輩、南ひなみん）\n笑顔多\n人生楽しんだもん勝ちがモットー。\n好きな物はゲーム、ガチャガチャ。取ってきた景品を自陣に上げている。\n楽観的に見えて意外と色んなことを考えていたり人思いだったりする。\n東に比較的懐いてる。\n「よォ、元気か？俺とゲームしようぜ」\n\n郵送の仕事でバイクに乗る際は東北、西南で別れて乗ることが多い。運転担当は東と西。\n\n◆　資料\nhttps://drive.google.com/drive/folders/1-Cm9278P8ZCbrbhQY6XD7hrsfnpkAGAu\n\n◆　使用用途\n個人利用の範囲でのスマホ、PCの壁紙利用、SNSアイコンなど。\n\n◆　希望\n今回も希望は特にありませんので🦌さんのお好きなように書いていただけたらと思います。\n金額の不足や内容に不備がありましたら、再送をお願いいたします。 ご検討よろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2banme_me/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3926647, "client_id": 3297554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b06528ca/uploads/origins/19a6e531-efa1-4227-94a9-b67a7336fb05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e18a646612b1f01c3028debcb33c2461", "srcset": "https://si.imgix.net/b06528ca/uploads/origins/19a6e531-efa1-4227-94a9-b67a7336fb05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e18a646612b1f01c3028debcb33c2461, https://si.imgix.net/b06528ca/uploads/origins/19a6e531-efa1-4227-94a9-b67a7336fb05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46b5af108d94a6512da220e115c15303 2x, https://si.imgix.net/b06528ca/uploads/origins/19a6e531-efa1-4227-94a9-b67a7336fb05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f16abcdfac9c1a8b8ef3c494babfec35 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b06528ca/uploads/origins/19a6e531-efa1-4227-94a9-b67a7336fb05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa433a89107911f080ecea9463cd01d7", "srcset": "https://si.imgix.net/b06528ca/uploads/origins/19a6e531-efa1-4227-94a9-b67a7336fb05?bg=%23fff&auto=