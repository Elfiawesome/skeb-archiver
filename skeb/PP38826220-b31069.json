net/e7cb1fb1/uploads/origins/73af5ba3-f5d4-4b2a-b51b-b09dd345883e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c999e15b7a67dbe7e0f702a7cde6e547 3x"}, "body": "こんにちは！こちらのイラスト、とても気に入りました https://www.pixiv.net/artworks/144096265\n\n\nもしよろしければ、ボーカロイドの「秋田ねる」を、この衣装で同じアングルで描いていただけないでしょうか：\nhttps://www.pixiv.net/artworks/144803285\n\n彼女はストーブの前にいて、衣装の後ろ姿はこれ（https://www.pixiv.net/artworks/143049315）に少し似ている感じにしてください。\n\nご検討いただき、本当にありがとうございます！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PP38826220/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3730542, "client_id": 3739910, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b0b8571/uploads/origins/9ace105a-2146-4e04-a759-651ee452814f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fc93bf0a7f957f29e672881ddae2f1f", "srcset": "https://si.imgix.net/4b0b8571/uploads/origins/9ace105a-2146-4e04-a759-651ee452814f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fc93bf0a7f957f29e672881ddae2f1f, https://si.imgix.net/4b0b8571/uploads/origins/9ace105a-2146-4e04-a759-651ee452814f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b7c8298235bc35c28ef89081350a6aa 2x, https://si.imgix.net/4b0b8571/uploads/origins/9ace105a-2146-4e04-a759-651ee452814f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2b25ce669693ff59e0b03ce5bca179d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b0b8571/uploads/origins/9ace105a-2146-4e04-a759-651ee452814f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd26e3a54283141383a0d8081eb4521e", "srcset": "https://si.imgix.net/4b0b8571/uploads/origins/9ace105a-2146-4e04-a759-651ee452814f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd26e3a54283141383a0d8081eb4521e, https://si.imgix.net/4b0b8571/uploads/origins/9ace105a-2146-4e04-a759-651ee452814f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=354067af9d1653199dae52a6ab1b621d 2x, https://si.imgix.net/4b0b8571/uploads/origins/9ace105a-2146-4e04-a759-651ee452814f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4fa7536ab88c3141e806fa522f844986 3x"}, "body": "晚上好PP老师，这是今天还要投递的第二份委托的内容，依然请您过目↓\n\n人物：\n桜羽エマ\n二階堂ヒロ\n\n画面比例：\n16:9\n\n人物画面：\n桜羽エマ与二階堂ヒロ并排坐在监狱外墙附近的草地上，远处有彩虹（游戏里的设定）\n桜羽エマ靠在二階堂ヒロ的头上小憩，二階堂ヒロ转头看向她\n人物占据的画面相比参考草稿请更多一些，我自己容易把人物画小😭\n※如果可以的话，希望在更远处绘制追逐打闹的橘シェリー与遠野ハンナ\n\n差分1:\n天空晴朗明媚，两人就这样享受着闲暇的时光，一切平安无事\n\n差分2:\n彩虹仍然挂在天边，而远处的天际线染上一抹鲜红，大量的血蝴蝶飞舞在两人身边，她们已然魔女化了。二階堂ヒロ永远地闭上了眼睛，桜羽エマ睁开眼睛，用冷酷的轻笑看向画面中心的“你”\n※桜羽エマ的台词差分:“只要大家全都去死不就好了嘛”\n※如果在差分1中绘制了橘シェリー与遠野ハンナ，在她们原本追逐打闹的位置上分别留下两人的“遗物”——橘シェリー的放大镜与遠野ハンナ的羽毛扇子\n\nhttps://drive.google.com/drive/folders/1d686QdztXcVwMKUgFyrFH75yWbhN11wD?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PP38826220/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3730542, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e919a57d/uploads/origins/2f312105-df6b-4dcf-b3b4-a2159ea405ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10362518beb7ffca79008eecca0e3071", "srcset": "https://si.imgix.net/e919a57d/uploads/origins/2f312105-df6b-4dcf-b3b4-a2159ea405ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10362518beb7ffca79008eecca0e3071, https://si.imgix.net/e919a57d/uploads/origins/2f312105-df6b-4dcf-b3b4-a2159ea405ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef2f3415c199984ec5f875472a13cd2b 2x, https://si.imgix.net/e919a57d/uploads/origins/2f312105-df6b-4dcf-b3b4-a2159ea405ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7828f60d2900cbd57f55b1f8796f05e9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e919a57d/uploads/origins/2f312105-df6b-4dcf-b3b4-a2159ea405ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b9ffb2eafe66894cb1b29f78e8a12a2", "srcset": "https://si.imgix.net/e919a57d/uploads/origins/2f312105-df6b-4dcf-b3b4-a2159ea405ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b9ffb2eafe66894cb1b29f78e8a12a2, https://si.imgix.net/e919a57d/uploads/origins/2f312105-df6b-4dcf-b3b4-a2159ea405ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1788eb0377717c9bb9f34c8c51070b5d 2x, https://si.imgix.net/e919a57d/uploads/origins/2f312105-df6b-4dcf-b3b4-a2159ea405ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=260ebb6a009d6553754ea1b6c003fad1 3x"}, "body": "『アズールレーン』の如月がランジェリー姿でセックスしているイラストを依頼したいです。\n\nただし、如月は成人として描いてください。\n成人およびランジェリーの参考画像：https://www.pixiv.net/artworks/138209008\nこれは、中くらいの胸の大きさの成人サイズの如月の参考画像でもあります。\n\nブラジャーとパンティは着けたままで、胸は露出させないでください。\n\n半透明の男性は、https://skeb.jp/@PP38826220/works/9 のものと同じです。\n\n激しいピストン運動を伴う乱暴なセックスで、如月が押さえつけられ、体を弄ばれています。彼女は圧倒的な快感に喘ぎ、気を失いそうになっています。\n\nhttps://www.pixiv.net/artworks/79708866", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PP38826220/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3730542, "client_id": 3739910, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5095168/uploads/origins/2319a4ca-c13f-4a6b-8ff4-641012f28f26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19d5bbaecb5ffd00e41528c75d596944", "srcset": "https://si.imgix.net/c5095168/uploads/origins/2319a4ca-c13f-4a6b-8ff4-641012f28f26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19d5bbaecb5ffd00e41528c75d596944, https://si.imgix.net/c5095168/uploads/origins/2319a4ca-c13f-4a6b-8ff4-641012f28f26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72555ab8bfdbc6fb385b8672640defd8 2x, https://si.imgix.net/c5095168/uploads/origins/2319a4ca-c13f-4a6b-8ff4-641012f28f26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09a79c36228546ae4924e221b22372a9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5095168/uploads/origins/2319a4ca-c13f-4a6b-8ff4-641012f28f26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2c68cb49db21ef736b056f3f7219c02", "srcset": "https://si.imgix.net/c5095168/uploads/origins/2319a4ca-c13f-4a6b-8ff4-641012f28f26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2c68cb49db21ef736b056f3f7219c02, https://si.imgix.net/c5095168/uploads/origins/2319a4ca-c13f-4a6b-8ff4-641012f28f26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=437caf9c8e549102a19fe33f1269f56a 2x, https://si.imgix.net/c5095168/uploads/origins/2319a4ca-c13f-4a6b-8ff4-641012f28f26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=48704ba13fd161cc7e492ab91c6558a8 3x"}, "body": "晚上好PP老师，我看到您开启skeb的消息了，这是我的委托内容，请您过目↓\n\n人物和服装：\n水星纪念——サクランボ・ブイ\n摩尔曼斯克——パゾリと雪景色\n\n画面比例：\n16:9\n\n人物画面：\n※略微的俯视视角，总而言之不要画成参考草稿里的那种正面照了\n※水星纪念和摩尔曼斯克身处“パゾリと雪景色”这件服装的背景中的卧室，需要明确画出来的物件是卧室左侧的大窗户，右侧的镜子，墙上的捕梦网，挂画与窗外的杉木林雪景\n※沙发请画的柔软一些，我自己作画的时候不小心把沙发画成火车硬座的那种感觉了\n※摩尔曼斯克坐在沙发上，为水星纪念提供膝枕服务，摩尔曼斯克眼神温柔地看向水星纪念，她的右手放在水星纪念的头发上轻轻地安抚她，左手被水星纪念的身体挡住\n※水星纪念枕在摩尔曼斯克的大腿上，露出享受的睡颜，头发因重力而垂下来，她的嘴里叼着一丝头发（发量不要太少）两只手放在自己的脑袋下侧，她的头顶还靠着几只枕头以便睡得更舒服\n\n差分1：\n窗外阳光明媚，阳光从窗户外照进来，在北方联合的寒冷气候下窗户上结了一层雾使窗外的杉木林背景变得模糊\n\n差分2（R18）：\n摩尔曼斯克的右手抬起来比出一个噤声的手势，左手拉下自己的睡衣让胸口处布料外翻露出乳房，表情变得略微妩媚，眼中有爱心，窗户上出现爱心划痕\n摩尔曼斯克的台词：\n“水星纪念她已经睡着了哦~”\n“指挥官同志也是，再随意一点也没关系哦~”\n\nhttps://drive.google.com/drive/folders/1BkoObLHgM9WwYCNmch0RHJ1-VV2KmTZN?usp=sharing", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PP38826220/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3730542, "client_id": 3739910, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a69f37ea/uploads/origins/2ad07cdf-b673-4568-b815-da0bfd26c04d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ac0ff275657a51d4d3761123999b6b7", "srcset": "https://si.imgix.net/a69f37ea/uploads/origins/2ad07cdf-b673-4568-b815-da0bfd26c04d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ac0ff275657a51d4d3761123999b6b7, https://si.imgix.net/a69f37ea/uploads/origins/2ad07cdf-b673-4568-b815-da0bfd26c04d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=203c47ce0e110c1da886935fd118de89 2x, https://si.imgix.net/a69f37ea/uploads/origins/2ad07cdf-b673-4568-b815-da0bfd26c04d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a98a8cbd979f3125d8779379e3a9ee5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a69f37ea/uploads/origins/2ad07cdf-b673-4568-b815-da0bfd26c04d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c595c9cd191714e9a943c0dc1c2a4a16", "srcset": "https://si.imgix.net/a69f37ea/uploads/origins/2ad07cdf-b673-4568-b815-da0bfd26c04d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c595c9cd191714e9a943c0dc1c2a4a16, https://si.imgix.net/a69f37ea/uploads/origins/2ad07cdf-b673-4568-b815-da0bfd26c04d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4702e63a62e51521c73348e14203ab54 2x, https://si.imgix.net/a69f37ea/uploads/origins/2ad07cdf-b673-4568-b815-da0bfd26c04d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3540a8232fee53734177b108388bfcdd 3x"}, "body": "晚上好PP老师！一如既往地要向您委托水星纪念哦！\n这次的委托细节上有些复杂，还请您不用着急作画！\n那么，以下是要求说明↓\n\n画面比例：\n16：9\n\n人物和服装：\n水星纪念——初始立绘\n\n人物画面：\n※略微仰视的视角\n※水星纪念穿戴着黑海舰队时期的舰装，身处于伊斯坦布尔海峡的海面上（舰装在游戏立绘中有出现，两门主炮的型号是双联装152mm主炮Model1892）\n※舰装相比参考草稿中的大小画得再大一些。还有一些舰装细节上的注意，水星纪念的身后有一共三座烟囱，她右侧舰装的舰首上刻有双头鹰标志\n※水星纪念面向画面的左前方，左腿前屈，右腿也顺势弯过去，体现出身体前倾的感觉\n※水星纪念的右手向前伸出五指张开，引导她右侧舰炮开火的方向，左手手臂向后，左手背过去引导她左侧舰炮开火的方向\n※画面下方的约1/3——1/4的部分是深蓝的海面，远处是海平面，在海平面上站着几名同为黑海舰队成员的舰船同伴，其余部分用小岛，阳光和天空填充即可\n\n差分1：\n水星纪念神情严肃，身后的舰炮也已对准角度准备发射\n\n差分2：\n水星纪念表情认真，张嘴大喊一声“开火！”身后的舰炮向左右两侧发射炮弹，炮口处有浓烈的硝烟和爆炸效果，爆炸的光亮照在水星纪念脸上使其变得稍微明亮一些，同时也使水星纪念周围的画面稍微变暗\n\n差分3：\n远处海平面上的同伴们消失\n水星纪念的舰炮射出的炮弹变为礼花，几只蛮啾（这些蛮啾的打扮在url链接中的参考草稿中有特别说明）也顺着礼花发射的方向飞出来，蛮啾的翅膀中捧着其他物品\n画面左侧写上“水星纪念号 1902.5.20 下水日纪念”，在水星纪念号的上方写上她的俄文名“Па́мять Мерку́рия”\n水星纪念睁开眼睛，开心地笑起来\n——差分3,表情差分：\n水星纪念闭上眼，她仍在笑，笑的同时眼角有几滴眼泪飘出来\n\n这里是故事背景上的说明，差分1,2是在重现水星纪念1915年的历史，而差分3是完全与前两个差分不同的故事背景。差分3是水星纪念在百年后重回故地摆出同样的姿势的画面，这也是为什么海平面上的同伴们消失了……\n\n每张差分的参考草稿均放在同一文件夹里了，URL链接中每份文件夹的数字序号就是对应的差分序号，同时差分2的文件夹中额外增加了舰炮开火时明亮度变化的参照图供您更好地理解！\n\nto签请在“差分3”中额外地画上！\n\nhttps://drive.google.com/drive/folders/1Nu5Xm8bJt_GdkXL3-xoFpy3Mf3s1SJyJ?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PP38826220/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3730542, "client_id": 1552917, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d80e90d6/uploads/origins/f99dd3ec-5363-4d6e-90a9-114f945719b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=113b6a6c95247caf86f53fc26bf9b2a8", "srcset": "https://si.imgix.net/d80e90d6/uploads/origins/f99dd3ec-5363-4d6e-90a9-114f945719b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=113b6a6c95247caf86f53fc26bf9b2a8, https://si.imgix.n