rive.google.com/drive/folders/1jyrKTJEkVmouvxRkQn3MJISINCx5UjWT?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PP38826220/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3730542, "client_id": 3520844, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6214bd77/uploads/origins/47b3a49c-2c9d-4e19-ae1a-f10fc4dc7b40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57034cc642791e92c8ed92876ffde6e2", "srcset": "https://si.imgix.net/6214bd77/uploads/origins/47b3a49c-2c9d-4e19-ae1a-f10fc4dc7b40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57034cc642791e92c8ed92876ffde6e2, https://si.imgix.net/6214bd77/uploads/origins/47b3a49c-2c9d-4e19-ae1a-f10fc4dc7b40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ef953ad5d074e7c8e08a817a9932056 2x, https://si.imgix.net/6214bd77/uploads/origins/47b3a49c-2c9d-4e19-ae1a-f10fc4dc7b40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66d500140d64d27f0902f5d4b1a207fe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6214bd77/uploads/origins/47b3a49c-2c9d-4e19-ae1a-f10fc4dc7b40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4dde4d7bb3147a3529b53da81214b5f4", "srcset": "https://si.imgix.net/6214bd77/uploads/origins/47b3a49c-2c9d-4e19-ae1a-f10fc4dc7b40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4dde4d7bb3147a3529b53da81214b5f4, https://si.imgix.net/6214bd77/uploads/origins/47b3a49c-2c9d-4e19-ae1a-f10fc4dc7b40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d044a21d108925068811568a165e77c2 2x, https://si.imgix.net/6214bd77/uploads/origins/47b3a49c-2c9d-4e19-ae1a-f10fc4dc7b40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0c22ebfb5e7b34c9a6fcf58056ba81cf 3x"}, "body": "始めまして綾ナギと申します！\nPP様のpixivのイラストを拝見し女の子がとてもかわいく素敵でしたので衝動的ではありますがにPP様にリクエストをさせていただきます！\n\n＜内容＞\n個人VTuberの蓮希るいちゃんを描いていただきたいです！\n出来上がったイラストを蓮希 るいちゃんへプレゼントさせていただきたいと思います。\n\n＜構図やポーズ＞\n可能であれば16：9のアスペクト比でお願いします。\nPP様の作品の中では \nhttps://www.pixiv.net/artworks/131281990\nが好みです。\n今回もそのような画風でお願いします。\n構図としてはパジャマ衣装でベッドで座りながら耳かきor寝転がりながら囁きをしようとしている姿でお願いします。\n耳かき棒はON/OFF可能だと助かります。\nASMR配信をされてる方なのでサムネイルに使用できるようなイラストを描いていただけると助かります。\n髪の毛や左右が見切れないようお願いします。\nかわいいを残したまま色気のある表情をお願いします。\n可能でしたら表情差分をお願いします。\n細かいポーズなどはおまかせでお願いします\n＜ご本人様サイトからの注意点やお願い＞\nそしてリクエストさせて頂いたイラストなのですが以下ご本人様サイトからの文章コピーになります。\n依頼をする際には、このページへのリンクまたはFANBOXのリンクを共有したのち蓮希るいのTwitterや収益化されたYoutubeチャンネルで使用される可能性があること」を依頼文で必ず伝えてください。\n\n▼skebまたは依頼したイラスト\npsdファイル/背景透過ファイルがあると嬉しいです。\nイラストレーター様に依頼していただいたイラストは活動面（サムネイル）で使用できるのでとても嬉しいです！\nサムネイルが作るのが楽しくなります。\n\nイラストレーター様にご依頼の際は、二次創作プログラム承認済みですので「蓮希るい」の名前を使用して許可済みだということをお伝えください。\n\n長くなってしまいましたがぜひご検討のほどよろしくお願い致します！\n\nhttps://lit.link/Hasukirui", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PP38826220/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3730542, "client_id": 3739910, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec6d3ab4/uploads/origins/1951e3ef-efc6-4ca4-b3a8-38b026b3bc53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cf376ab14153aec24a2690b247abea5", "srcset": "https://si.imgix.net/ec6d3ab4/uploads/origins/1951e3ef-efc6-4ca4-b3a8-38b026b3bc53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cf376ab14153aec24a2690b247abea5, https://si.imgix.net/ec6d3ab4/uploads/origins/1951e3ef-efc6-4ca4-b3a8-38b026b3bc53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59f9029edde9875ce7498d673f60d94b 2x, https://si.imgix.net/ec6d3ab4/uploads/origins/1951e3ef-efc6-4ca4-b3a8-38b026b3bc53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21ea122e7288996b82fb264dd2fa2018 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec6d3ab4/uploads/origins/1951e3ef-efc6-4ca4-b3a8-38b026b3bc53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=321278d78bf78a41663440f410e97870", "srcset": "https://si.imgix.net/ec6d3ab4/uploads/origins/1951e3ef-efc6-4ca4-b3a8-38b026b3bc53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=321278d78bf78a41663440f410e97870, https://si.imgix.net/ec6d3ab4/uploads/origins/1951e3ef-efc6-4ca4-b3a8-38b026b3bc53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cd2f88816f72fb1625e5ac08ad2e2f6b 2x, https://si.imgix.net/ec6d3ab4/uploads/origins/1951e3ef-efc6-4ca4-b3a8-38b026b3bc53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=473561c91155004d97da049e4405765b 3x"}, "body": "PPの先生またまた記事をお願いしに来ましたフーチョフです(/≧▽≦)/~❤️\n今回はマーキュリーメモリアルとオレグのデュオフィギュアをお願いします！\nストライキ中のオレグとマーキュリーメモリアルのインタラクティブボイスからインスパイアされました。\"新しくデザインした肩と首のマッサージャーを試してみませんか？\"\nという感じのリクエストでした。\n\nキャラクターとコスチューム\nマーキュリーメモリアル（Mercury Memorial） - リモデリングされたスタンドアップ（Mercury Memorialのリモデリングされたスタンドアップは、サイドのおっぱいが強調され、左胸からぶら下がっている二階級防衛勲章が強調されることを望む\nオレグ（Oleg）-初期立ち絵\n\n\"港の廊下を歩いていたマーキュリーメモリアルは、突然後ろからオレグに呼ばれ、肩と首のマッサージ器をマーキュリーメモリアルの首にすっとかける\"\n\nシーン：\n港湾エリアの廊下（URLのファイル \"6 \"を参照）\n\nキャラクター画面：\n参考稿は上から見下ろした視点だが、少し高い視点（下から上に向かって胸の大きさを強調！）で描いてほしい。また、太ももから頭にかけて体のパーツが見えるように！\n\nマーキュリーメモリアルは写真左手前で、両腕を上げ（上げるスピードがわかるように線を引く）、小腕を体の両脇に組み、手のひらを外側に向け、指をギュッと握っている。\n水星記念の眉は内側に八の字にカーブし、困惑した表情でオレグを見ている。\nマーキュリーメモリアルは、肩と首のマッサージャーを首に巻いている（参考URLの資料「2」参照）。また、参考画像に北部同盟陣営のスタイルの特徴（重工業的なメカニック、装置の鋭いエッジ、氷のエフェクト、北部同盟の陣営章）を追加したい。\n*マーキュリー記念碑の周囲には、混乱を示すクエスチョンマーク（～？\n\nオレグは画面右側奥で、両手をまっすぐ伸ばして落下する姿勢で、マーキュリーメモリアルの首の両側に手を置いている（降下速度を示す線を描いている）。\nオレグはメカニカルなマスクをして、マーキュリー・メモリアルを興奮した面持ちで見つめている（表情はURLのファイル「3」を参照）。\n\nセリフ\nオレグはマーキュリー・メモリアルにこう言う。\"新しく設計した肩と首のマッサージ機を試してみないか？\"\n\n差分：\n*マーキュリー・メモリアルは目を閉じて眉を伸ばし、口を開けてよだれを垂らし、周囲からポジティブな光のエフェクトが発せられるなど、楽しそうな表情を見せる（～✨）。\nオレグの表情がとても楽しそうで誇らしげになる（表情はURLファイル「4」を参照）。\n肩と首のマッサージ器が作動すると、「ブーン、ブーン」と擬音とともに振動する。\nマーキュリーメモリアルは「あ、あ、あ、あ......～」と音がするほど心地よく、オレグはマーキュリーメモリアルを眺めながら「やっぱり、香港地区で一番の部品再利用発明の天才は俺だな。\"\n\nセリフとオノマトペは中国語版、日本語版、言葉なし版があり、ウィキのオレグのキャラクターボイスで確認できる！\nセリフはwikiのオレグのキャラクターボイスで確認できる！\n\n最後に、上記の説明をよりよく理解するために、参考URLのファイル「5」のドラフトを参照してください！\n\nhttps://drive.google.com/drive/folders/1dFLCF0een3-3IW3Cn8xO3exC7sj2xuqE?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 88404, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ほうき", "screen_name": "houki0121", "avatar_url": "https://pbs.twimg.com/profile_images/1919735721902137344/DZe6vPBz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/706336015737184258/1678418110/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 99575, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "永田和希はskebでロゴ受付中", "screen_name": "naga_tatta", "avatar_url": "https://pbs.twimg.com/profile_images/1769009068755300352/0IJ42N6w.jpg", "header_url": "https://pbs.twimg.com/profile_banners/928112112169185281/1773925229/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 281003, "creator": true, "nsfw_acceptable": true, "ac