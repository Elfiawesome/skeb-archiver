していただければ描きやすいもので大丈夫です。運動した後の爽快な表情、上がった体温、汗などを表現していただきたいです。\n　ブーツとソックスも脱ぎ捨てたものを描いていただけると助かりますが、装飾等が多い衣装ですのでお手間でしたら省略してください。\n　背景はおまかせしますが、お手間でしたら白背景で問題ありません。\n\n　以上になります。\n　私自身初のご依頼ということでドキドキしております。どうか無理のない範囲でaoba先生のチヒロちゃんを拝ませていただければ幸いです。それでは何卒よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aoba_0810/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1380232, "client_id": 1368278, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20743624/uploads/origins/68fb2f9f-3b4b-4f7a-8e51-588f84d57ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9e3387ba3defe2f25e6226dbbbdb85d", "srcset": "https://si.imgix.net/20743624/uploads/origins/68fb2f9f-3b4b-4f7a-8e51-588f84d57ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9e3387ba3defe2f25e6226dbbbdb85d, https://si.imgix.net/20743624/uploads/origins/68fb2f9f-3b4b-4f7a-8e51-588f84d57ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc87588542440cdfcc3d0277d75322f8 2x, https://si.imgix.net/20743624/uploads/origins/68fb2f9f-3b4b-4f7a-8e51-588f84d57ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42869a1733c7be2d67dc3aa80c2bf123 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20743624/uploads/origins/68fb2f9f-3b4b-4f7a-8e51-588f84d57ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54fe8409bd8e139ee6741d912a0a5edd", "srcset": "https://si.imgix.net/20743624/uploads/origins/68fb2f9f-3b4b-4f7a-8e51-588f84d57ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54fe8409bd8e139ee6741d912a0a5edd, https://si.imgix.net/20743624/uploads/origins/68fb2f9f-3b4b-4f7a-8e51-588f84d57ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cr