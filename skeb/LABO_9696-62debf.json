どく悩んでいる。\n- 考えすぎる傾向がある。\n\n彼女は現在、殺人ゲームを強いられており、怪我を治すためにグループの頼れるドクターとなっている。生と死のバランスを握っていると信じており、置かれている状況から躁状態になっている。彼女の感情状態は信じられないほど不安定で、自分を見失う瀬戸際に立ちながら、冷静に自分をまとめようとすることを余儀なくされている。\n\nポージングの注意点\n- どんな表情でも大体OKです！彼女は様々な感情を持つことができますが、普段の表情は中立、怒り、怯えのいずれかです。\n- 彼女の手の血」を強調してほしい（赤い手のひらの手袋で比喩的にでも、文字通り血まみれでも）。\n- どんなポーズでも構わないので、自由に創造してください！\n\nhttps://toyhou.se/29159299.claudia-de-la-cruz/gallery", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@LABO_9696/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3372780, "client_id": 3431528, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4653561/uploads/origins/a079e6ea-6b17-4944-a75a-0b403b94dd13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d24bfe6593dbd0451534894e4fce091e", "srcset": "https://si.imgix.net/f4653561/uploads/origins/a079e6ea-6b17-4944-a75a-0b403b94dd13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d24bfe6593dbd0451534894e4fce091e, https://si.imgix.net/f4653561/uploads/origins/a079e6ea-6b17-4944-a75a-0b403b94dd13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=637fdcbb980fbe8542b43b52dd4b1c27 2x, https://si.imgix.net/f4653561/uploads/origins/a079e6ea-6b17-4944-a75a-0b403b94dd13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7824c3c73737e29b44af40fc25b4457c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4653561/uploads/origins/a079e6ea-6b17-4944-a75a-0b403b94dd13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f11dfb41560141960d51b709a0e87228", "srcset": "https://si.imgix.net/f4653561/uploads/origins/a079e6ea-6b17-4944-a75a-0b403b94dd13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f11dfb41560141960d51b709a0e87228, https