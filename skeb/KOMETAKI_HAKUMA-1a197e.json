ormat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d29b9726df717f591d9bd7464493acad", "srcset": "https://si.imgix.net/373ab2df/uploads/origins/16082d2a-238e-4d0c-8944-f187b5932182?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d29b9726df717f591d9bd7464493acad, https://si.imgix.net/373ab2df/uploads/origins/16082d2a-238e-4d0c-8944-f187b5932182?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eab3c2f48215cd32bcb8089c5b714956 2x, https://si.imgix.net/373ab2df/uploads/origins/16082d2a-238e-4d0c-8944-f187b5932182?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=926f65805fa72c0801edfd04d13bafdd 3x"}, "body": "米炊白米様\n\n先生のキュートなイラストをいつも楽しく拝見させていただいております。\n\nもしよろしければ、「夏」をテーマにしたイラストを描いていただきたいです。\nイメージとしては、以前描かれていた資料URLの子や米炊先生のオリジナルキャラ達が海辺でわちゃわちゃしている一幕（自由に描いていただきたいです）で、看板娘のはに〜さんが大好きなので一緒に描いていただきたいです。\n\n特に描いていただきたい子、モチーフとしては、王冠を被っている子、女の子と男の子、スイカを食べている子、人魚の子達、クリームソーダ、カニ、ホタテ（顔あり）です。\n\n【使用用途】 個人的な鑑賞として使用としたいと考えております\n\nご検討のほどよろしくお願いいたします。\n\nhttps://x.com/KOMETAKI_HAKUMA/status/1682682601839136772", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KOMETAKI_HAKUMA/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2495320, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/645be73c/uploads/origins/c7da3536-1eb3-4c58-8c9b-e52f6c6f648a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f18da0a0f80f45849cf3d7e0063d52b1", "srcset": "https://si.imgix.net/645be73c/uploads/origins/c7da3536-1eb3-4c58-8c9b-e52f6c6f648a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f18da0a0f80f45849cf3d7e0063d52b1, https://si.imgix.net/645be73c/uploads/origins/c7da3536-1eb3-4c58-8c9b-e52f6c6f648a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=543c46180ef3344ed6a2788a8916e772 2x, https://si.imgix.net/645be73c/uploads/origins/c7da3536-1eb3-4c58-8c9b-e52f6c6f648a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e84af69379a0096d75ff4401d4c4cb8a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/645be73c/uploads/origins/c7da3536-1eb3-4c58-8c9b-e52f6c6f648a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65d789bce0373ba2713d98f2eecc357e", "srcset": "https://si.imgix.net/645be73c/uploads/origins/c7da3536-1eb3-4c58-8c9b-e52f6c6f648a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65d789bce0373ba2713d98f2eecc357e, https://si.imgix.net/645be73c/uploads/origins/c7da3536-1eb3-4c58-8c9b-e52f6c6f648a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9659bfa12d3b5b3f332c4fcc451a780f 2x, https://si.imgix.net/645be73c/uploads/origins/c7da3536-1eb3-4c58-8c9b-e52f6c6f648a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1adefced86713a441cb8951d27bb3429 3x"}, "body": "米炊 白米様、こんにちは。いつも素敵なイラスト拝見しております。\n今回、私と友人の創作キャラクターのイラストを描いていただきたく思い、依頼いたします。\n\n【内容】\n資料内の二人がなかよくパンケーキを焼いているイラストを描いていただきたいです。\nよろしければ、等身絵+デフォルメ(料理過程の様子や食べている様子)でお願いします。米炊様のゆるくて可愛いデフォルメが大好きです。\n衣装は、資料内の服装+エプロン姿でお願いします。エプロンの柄やカラーはお任せします！\n\n【資料】\nhttps://drive.google.com/drive/folders/1ijm2LS14Jr2o9JBs4_Y-cTHNveasuG9E?usp=sharing\n\n\n【使用用途】\n個人鑑賞が目的です。キャラ製作者の友人とイラストを共有する予定です。\n\n資料が閲覧できない、金額が見合わない等ございましたら、お気軽に再送申請いただければと思います。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ijm2LS14Jr2o9JBs4_Y-cTHNveasuG9E?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KOMETAKI_HAKUMA/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2495320, "client_id": 1748085, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6e5e8df/uploads/origins/eb1258c6-9f88-4cec-b946-61abfbd9f16f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8b92b3cf8974252de366d7cdc37ecb4", "srcset": "https://si.imgix.net/d6e5e8df/uploads/origins/eb1258c6-9f88-4cec-b946-61abfbd9f16f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8b92b3cf8974252de366d7cdc37ecb4, https://si.imgix.net/d6e5e8df/uploads/origins/eb1258c6-9f88-4cec-b946-61abfbd9f16f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd1af1444d1d955785aa080899947a1d 2x, https://si.imgix.net/d6e5e8df/uploads/origins/eb1258c6-9f88-4cec-b946-61abfbd9f16f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a65f336dc4f9a394b1bdc4b9d4138e0f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6e5e8df/uploads/origins/eb1258c6-9f88-4cec-b946-61abfbd9f16f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ff9cd170cead9b076485e44e17f5cb4", "srcset": "https://si.imgix.net/d6e5e8df/uploads/origins/eb1258c6-9f88-4cec-b946-61abfbd9f16f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ff9cd170cead9b076485e44e17f5cb4, https://si.imgix.net/d6e5e8df/uploads/origins/eb1258c6-9f88-4cec-b946-61abfbd9f16f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e85960b27dfe69049bd8582e786fd862 2x, https://si.imgix.net/d6e5e8df/uploads/origins/eb1258c6-9f88-4cec-b946-61abfbd9f16f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9dfb426d49815f1f74fcb720522d6d82 3x"}, "body": "こんにちは！あなたのイラスト、すごく好きです。楽しくてかわいいですね！私のVTuberを描いていただけないでしょうか。私のキャラクターは、牢屋に閉じ込められているゴキブリの女の子です。彼女はオニオンリングが大好きなアーティストで、とてもおバカで粘り強いゴキブリなんです。参考画像に載せたキーブレードを持って描いていただけると嬉しいです。これはゲーム『キングダム ハーツ』からインスピレーションを得たものです。 キーブレードの柄はピンクのハート型の手錠で、刃はグラフィックタブレット用のペンになっています。そこに檻が取り付けられていて、中にはゴキブリが入っています。これは、私がグラフィックタブレットを使って『キングダム ハーツ』をプレイしているシリーズから着想を得たものです。また、私のファンのマスコット（ハートのアンテナがないピンクのゴキブリ）も描いていただけると嬉しいです。彼らは「セルメイト」と呼ばれています。\n\n他にも合うものがあれば、自由に描いてください！ポーズや表情はあなたにお任せします！また、このイラストをSNSや配信で使用させていただく予定です。承諾いただければ、クレジットを記載します。ご検討いただき、本当にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1TOzUdh_HvxXTmd8r3xM_yvl3K3dInAMs?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KOMETAKI_HAKUMA/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2495320, "client_id": 622500, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/986942d2/uploads/origins/5e6a2d48-1cc9-41ec-bea3-3805f7aa22aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ebc3cc2ec04d7c2b3bed92ab8f1b2fd", "srcset": "https://si.imgix.net/986942d2/uploads/origins/5e6a2d48-1cc9-41ec-bea3-3805f7aa22aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ebc3cc2ec04d7c2b3bed92ab8f1b2fd, https://si.imgix.net/986942d2/uploads/origins/5e6a2d48-1cc9-41ec-bea3-3805f7aa22aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc3c8b0d2587985d59e536939c335b17 2x, https://si.imgix.net/986942d2/uploads/origins/5e6a2d48-1cc9-41ec-bea3-3805f7aa22aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94d08cb0e4f7091e4cfaba296d590f9c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/986942d2/uploads/origins/5e6a2d48-1cc9-41ec-bea3-3805f7aa22aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=caa4b6179186c40af84b1f619f27d7c3", "srcset": "https://si.imgix.net/986942d2/uploads/origins/5e6a2d48-1cc9-41ec-bea3-3805f7aa22aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=caa4b6179186c40af84b1f619f27d7c3, https://si.imgix.net/986942d2/uploads/origins/5e6a2d48-1cc9-41ec-bea3-3805f7aa22aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9ea5b85b331879268b89a6a32e09143 2x, https://si.imgix.net/986942d2/uploads/origins/5e6a2d48-1cc9-41ec-bea3-3805f7aa22aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=90e536544a56c0a92e80f845d3954442 3x"}, "body": "はに～さん様\nはじめまして。素敵なイラストを拝見しリクエストさせていただきました。\n\n今回描いていただきたいのは、私のオリジナルキャラ二人です。\n【https://drive.google.com/drive/folders/1gWfpk-gWqUxd4UIKJphfvmNV0DYgZ8rx?usp=drive_link】\n男の家に居候している女の子で、相思相愛で距離は近めなのに付き合ってない関係です。\n\nほのぼので日常っぽいシチュエーションを希望します。\n男が喫茶店を経営しているという設定なので、スイーツや食事の要素を入れていただきたいです。\nまた、女の子のほうが男に甘えたりかまってもらったりするのが大好きなのでそういう関係性をはに～さん様の世界観で表現してくださるととてもうれしいです！\n\n服装や髪型、背景などはおまかせいたします。他のご依頼の作品のように、頭身イラスト＋デフォルメの構図で描いていただけたらと思います。\n\nご検討いただけますと幸いです。よろしくお願いいたします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KOMETAKI_HAKUMA/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2495320, "client_id": 1180906, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d626c9a7/uploads/origins/0f2485d6-d2ec-4597-84ea-a621ed6c9fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2b66c5a93760e1d23aa0bcd01136f53", "srcset": "https://si.imgix.net/d626c9a7/uploads/origins/0f2485d6-d2ec-4597-84ea-a621ed6c9fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2b66c5a93760e1d23aa0bcd01136f53, https://si.imgix.net/d626c9a7/uploads/origins/0f2485d6-d2ec-4597-84ea-a621ed6c9fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46f3704ea25532de23bb7297b5d6a7f4 2x, https://si.imgix.net/d626c9a7/uploads/origins/0f2485d6-d2ec-4597-84ea-a621ed6c9fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=765352efb210ce07fe6369813d293e33 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_th