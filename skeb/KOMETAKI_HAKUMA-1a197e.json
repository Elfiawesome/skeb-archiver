見など資料はGoogle driveをご参照をお願いいたします。\n性格は怠けものでおおざっぱです。髪色がグレーでショートヘアの私(パラレルワールドの私)のほうは、いくらか内気かなと思います。\n\n\n使用用途は個人鑑賞と非公開のTwitterアカウントでの投稿です。\nもしかしたらTwitterのアイコンにも使用させていただくかもしれません。\n\nご縁がありましたら、ぜひよろしくお願いいたします！\nまた金額が見合わない場合、お気軽に再送申請いただけましたら幸いです。\n\nこれからもすてきなイラスト、陰ながら楽しみにしております！\n\nhttps://drive.google.com/drive/folders/1-3fIIdvf7TmzFRqCdZ84WKU43vml7iMq", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KOMETAKI_HAKUMA/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2495320, "client_id": 1371323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe18eed1/uploads/origins/17bd7eb9-f8b5-4a12-96cb-633e638cf112?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbaebb3a65861fce338dd8b62df7f1a9", "srcset": "https://si.imgix.net/fe18eed1/uploads/origins/17bd7eb9-f8b5-4a12-96cb-633e638cf112?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbaebb3a65861fce338dd8b62df7f1a9, https://si.imgix.net/fe18eed1/uploads/origins/17bd7eb9-f8b5-4a12-96cb-633e638cf112?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64ec9888f4814c324b3a24812bd8a04c 2x, https://si.imgix.net/fe18eed1/uploads/origins/17bd7eb9-f8b5-4a12-96cb-633e638cf112?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96e06cb83a4230328d02d4e3476564c9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe18eed1/uploads/origins/17bd7eb9-f8b5-4a12-96cb-633e638cf112?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=331d7194f94d224d25cd257663767011", "srcset": "https://si.imgix.net/fe18eed1/uploads/origins/17bd7eb9-f8b5-4a12-96cb-633e638cf112?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=331d7194f94d224d25cd257663767011, https://si.imgix.net/fe18eed1/uploads/orig