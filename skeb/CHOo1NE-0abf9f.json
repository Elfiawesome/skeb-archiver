b/uploads/origins/fe25f092-bb18-4880-9abc-11b28edcc1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=098dc5dcd6ce06580662f9ab44daa442 2x, https://si.imgix.net/10b4a51b/uploads/origins/fe25f092-bb18-4880-9abc-11b28edcc1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad91e1a5e86b1b33281034c635fbbe8f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10b4a51b/uploads/origins/fe25f092-bb18-4880-9abc-11b28edcc1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd95452be985078a4022ed59c01ef0aa", "srcset": "https://si.imgix.net/10b4a51b/uploads/origins/fe25f092-bb18-4880-9abc-11b28edcc1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd95452be985078a4022ed59c01ef0aa, https://si.imgix.net/10b4a51b/uploads/origins/fe25f092-bb18-4880-9abc-11b28edcc1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dc3698d03d589fc6a8993f29f3b005a6 2x, https://si.imgix.net/10b4a51b/uploads/origins/fe25f092-bb18-4880-9abc-11b28edcc1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0dea29ab5efc7b5d55cbbffb314d7f1f 3x"}, "body": "竹壹様\n\nはじめまして。個人勢Vtuber準備中の沢崎と申します。\n竹壹様のイラストスタイルがとても好きで、今回ぜひご依頼をお願いしたくご連絡いたしました。\n\n▽キャラクター\n性別不明の研究所員。\n仕事に疲れた様子で、やや無口で静かな雰囲気をお持ちです。表情の変化は少なめです。\n\n▽依頼内容\nキャラクターは男性ですが、性徴のないニュートラルな表現でお願いしたいです。もしくは、より女性的なニュートラルな表現で描いていただいても大歓迎です。\n髪型・服装などはすべてお任せいたします。描きやすいように自由にアレンジしていただいて大丈夫です！\n\n▽使用用途\nSNS・サムネイル・配信のほか、グッズ制作・販売を予定しています。\n使用時は必ず竹壹様のクレジットとSNSを明記いたします。\n\n▽納品形式\n横構図で、解像度300–350dpi程度の\n背景透過PNG、またはレイヤー分けPSDでお受け取りできれば幸いです。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-Tsqumg7hAlhBlRGwbBNVMFOBo65dpUH?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@57ame/works/4", "private_thumbnail_image_