g=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89c4060030d741d11292f6687a676343, https://si.imgix.net/391236fb/uploads/origins/07f9142b-5730-459c-b7cd-8460a3c0740c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a233a38abcb57b5437c8ad9bf0426b6e 2x, https://si.imgix.net/391236fb/uploads/origins/07f9142b-5730-459c-b7cd-8460a3c0740c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82329566d6711e8e639cd425c3e3d84e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/391236fb/uploads/origins/07f9142b-5730-459c-b7cd-8460a3c0740c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b505f9f622f2b5670dbe921ef1c6120", "srcset": "https://si.imgix.net/391236fb/uploads/origins/07f9142b-5730-459c-b7cd-8460a3c0740c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b505f9f622f2b5670dbe921ef1c6120, https://si.imgix.net/391236fb/uploads/origins/07f9142b-5730-459c-b7cd-8460a3c0740c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0586dda076a0c4e0a9aa486dfef2b49f 2x, https://si.imgix.net/391236fb/uploads/origins/07f9142b-5730-459c-b7cd-8460a3c0740c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a26e13b2868674181a82e7219e5a035d 3x"}, "body": "茶の離❖様　こんにちは、はじめまして！素敵な原神のイラストいつもお見かけしてお願いしたいと思っており参りました！私の宝石龍に関わる創作世界ストーリーに登場するオリジナルキャラクターをお描きいただけないでしょうか。\n\nキャラクターデザインは添付のキャラクターシートを参考にしてください。\nキャラクター 名前：フロルヴィア 年齢：16、身長160cm細身、女性 髪：膝までの長い髪\n髪色：青みがかったシルバーに、宝石のような緑色と淡紅色をメッシュ\n瞳：青色\nキャラテーマ：神聖、冷たい、他人には心を閉ざした、桜と新緑\n色テーマ：「淡紅色」と「織部色」\nフロルヴィアは普通の人間でしたが、宝石龍の影響が体に出ています。\n他に人間のいない西の果ての根本だけ残った大樹がある丘にある屋敷に、体が樹木で桜色の宝石の鱗を持った龍と生活をともに過ごしている\n\nキャラクター 名前：ネーリャエッタ　年齢：17、身長155cm(馬耳含まず)、女性\nキャラテーマ：亡国の王族に連なる馬獣人族の少女、心優しい、温和な性格、高貴、困難に対峙する気高さ\n色テーマ：紅葉の赤(ルビー)と黄葉の黄色(金色)\n種族：獣人、ウマ耳、ウマの尻尾を持っている。体など普通の人間。人間の耳は無し\n体が樹木化し羽毛が宝石化しているヒポグリフとともに大陸を巡る旅をしている\n\n東から大陸を巡ってきたネーリャエッタが西の果てにいたフロルヴィアと出会い、その社と宝石龍の過去と、大陸の歴史を共に知っていくことになる関係です\n二人とも性格的には他人に警戒しながらも、共に過ごすことで徐々に互いの価値観や過去を知って理解を深めて迫害から逃げてきたただの同居人から友人になっていく関係です。\n\nフロルヴィアとネーリャエッタの住んでいる場所：\n大陸の西、人里離れた森林と草原、東側を塞ぐように遠くに山脈の壁、小高い丘、崩れた鳥居（一部分の破片しか残っていない）、枯れて根元しか残っていない大きな巨木、巨木の傍に鎮座する墓石のような淡紅色の宝石、少女が一人住むには大きい古い屋敷\n\n\n▼希望するイラスト\nフロルヴィアとネーリャエッタの二人の一枚絵イラスト\n\n▼データ：PSDデータ\n▼希望サイズ：解像度350dpi\n\nどうぞよろしくお願いいたし\n\nhttps://www.dropbox.com/scl/fo/zo8o0v7v8wg3a7axvdrju/AGcMOkqsnM7JYWR3sDkuV2w?rlkey=u7nkuo63zvy92qmiedzgrhay5&st=849i5hf5&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 250090, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "しきそ", "screen_name": "sikiso_soso", "avatar_url": "https://pbs.twimg.com/profile_images/1772166711778955264/vB4vdJKI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/133287190/1790843226/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 0}, {"id": 2530447, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "停止", "screen_name": "_Neyrpg", "avatar_url": "https://pbs.twimg.com/profile_images/2109185733680680960/zj3ZUTt3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1488005291157630979/1694169275/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 20, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 2902611, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "いかわさ🦑(skeb垢)", "screen_name": "Midori_soumenn", "avatar