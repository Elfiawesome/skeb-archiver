58\u3081\u307e\u3057\u3066\u3002\n\n\u3053\u306e\u5ea6\u306f\u79c1\u306e\u30aa\u30ea\u30ad\u30e3\u30e9\u306e\"\u30c8\u30ad\u30b3\uff08\u6b62\u578b\uff15\u53f7\uff09\"\u306e\u30a4\u30e9\u30b9\u30c8\u3092\u304a\u9858\u3044\u3067\u304d\u308c\u3070\u3068\u601d\u3044\u30ea\u30af\u30a8\u30b9\u30c8\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002\n\n<\u30c8\u30ad\u30b3\uff08\u6b62\u578b\uff15\u53f7\uff09>\n\u25cf\u30d3\u30b8\u30e5\u30a2\u30eb\u306e\u8a73\u7d30\u306f\u53c2\u8003\u8cc7\u6599\u53c2\u7167\n\u25cf\u5916\u898b\u5e74\u9f62\uff1a\u7d0413\u6b73\u306e\u5c11\u5973\n\u25cf\u5f79\u5272\uff1a\u6642\u7a7a\u72af\u7f6a\u3084\u6b74\u53f2\u6539\u5909\u3092\u9632\u3050\u4f7f\u547d\u3092\u6301\u3064\u751f\u4f53\u5175\u5668\uff08\u30d2\u30c8\u578bMetalien\uff09\n\u25cf\u8eab\u9577\u30fb\u4f53\u578b\uff1a\u8eab\u9577155cm\u30fb\u83ef\u5962\u306a\u4f53\u578b\n\u25cf\u91cd\u3055\u30fb\u6bd4\u91cd\uff1a675kg\u30fb15g/cm3\n\u25cf\u6027\u683c\uff1a\u8efd\u3044\u611f\u3058\u3067\u98c4\u3005\u3068\u3057\u3066\u3044\u308b\n\u25cf\u904b\u52d5\u80fd\u529b\uff1a\u63e1\u529b1t\u3001\u5782\u76f4\u8df31m\u3001\u8d70\u5e45\u8df320m\n\u25cf\u7279\u6b8a\u80fd\u529b: \u6642\u7a7a\u64cd\u4f5c\n\u3000\u4f8b[\"\u51cd\u7d50\"\uff1a\u89e6\u308c\u305f\u7269\u4f53\u306e\u6642\u9593\u306e\u6d41\u308c\u3092\u505c\u6b62\u3067\u304d\u308b\u3002\u6642\u9593\u505c\u6b62\u4e2d\u306e\u7269\u4f53\u306b\u306f\u3001\u971c\u3084\u6c37\u306e\u3088\u3046\u306a\u30a8\u30d5\u30a7\u30af\u30c8\u304c\u73fe\u308c\u308b]\n\u3000\u3000[\"\u71c3\u713c\"\uff1a\u81ea\u5206\u4ee5\u5916\u306e\u3042\u3089\u3086\u308b\u3082\u306e\u6642\u9593\u306e\u6d41\u308c\u3092\u6e1b\u901f\u3067\u304d\u308b\u3002\u6e1b\u901f\u4e2d\u306f\u3001\u708e\u306e\u3088\u3046\u306a\u30a8\u30d5\u30a7\u30af\u30c8\u3092\u5168\u8eab\u306b\u7e8f\u3046]\n\u3000\u3000[\"\u8377\u96fb\"\uff1a\u5de6\u8155\u304b\u3089\u96fb\u6483\u3092\u653e\u3061\u611f\u96fb\u3057\u305f\u5bfe\u8c61\u306e\u6642\u9593\u3092\u52a0\u901f\u3055\u305b\u308b]\n\u3000\u3000[\"\u66b4\u98a8\"\uff1a\u9996\u7b4b\u306b\u85ac\u7269\u3092\u6ce8\u5c04\u3057\u3066\u5909\u8eab\u3059\u308b\u3002\u98a8\u306e\u30a8\u30d5\u30a7\u30af\u30c8\u304c\u767a\u751f\u3057\u3066\u5468\u56f2\u306e\u6642\u9593\u306e\u6d41\u308c\u3092\u3067\u305f\u3089\u3081\u306b\u304b\u304d\u4e71\u3057\u3001\u884c\u52d5\u3068\u7d50\u679c\u306e\u968f\u4f34\u6027\u3084\u56e0\u679c\u95a2\u4fc2\u3092\u3081\u3061\u3083\u304f\u3061\u3083\u306b\u3059\u308b\u3002\u85ac\u7269\u306e\u4f5c\u7528\u3067\u610f\u8b58\u6df7\u6fc1\u3092\u5f15\u304d\u8d77\u3053\u3057\u3066\u3075\u3089\u3075\u3089\u72b6\u614b\u306b\u306a\u308a\u3001\u300c\u3050\u308b\u3050\u308b\u2026\u2026\u300d\u3068\u3057\u304b\u8a00\u8449\u3092\u767a\u305b\u306a\u304f\u306a\u308b]\n\u3000\u3000[\"\u6697\u8ee2\"\uff1a\u89e6\u308c\u305f\u5bfe\u8c61\u306e\u6642\u9593\u306e\u6d41\u308c\u3092\u5dfb\u304d\u623b\u3059\u3002\u5dfb\u304d\u623b\u3057\u3066\u3044\u308b\u9593\u3001\u89e6\u308c\u305f\u90e8\u5206\u304b\u3089\u9ed2\u3044\u6ce2\u7d0b\u304c\u751f\u3058\u3001\u76ee\u304b\u3089\u9ed2\u305a\u3093\u3060\u8840\u306e\u6d99\u304c\u6ea2\u308c\u308b\u3002]\n\n\u69cb\u56f3\u3084\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\u306a\u3069\u306e\u8a73\u7d30\u306b\u3064\u3044\u3066\u306f\u3001\u304a\u4efb\u305b\u3044\u305f\u3057\u307e\u3059\u3002\n\n\u4f7f\u7528\u7528\u9014\uff1a\u500b\u4eba\u6d3b\u52d5\u5168\u822c\n  \u30fb\u52d5\u753b\u914d\u4fe1\uff1a\u5f85\u6a5f\u753b\u9762\u3084\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u753b\u9762\u306a\u3069\u3067\u306e\u4f7f\u7528\u3002\n  \u30fb\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u304a\u3088\u3073SNS\uff1a\u500b\u4eba\u30b5\u30a4\u30c8\u3084SNS\u3067\u306e\u5c0f\u8aac\u306e\u633f\u7d75\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u7d39\u4ecb\u3001\u6d3b\u52d5\u544a\u77e5\u3002\n  \u30fb\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8981\u7d20\uff1a\u30a2\u30a4\u30b3\u30f3\u3001\u30d8\u30c3\u30c0\u30fc\u3001\u30d0\u30ca\u30fc\u3068\u3057\u3066\u306e\u4f7f\u7528\u3002\u30d0\u30ca\u30fc\u4f7f\u7528\u6642\u306b\u306f\u3001\u30b5\u30a4\u30c8\u540d\u3084\u30ad\u30e3\u30f3\u30da\u30fc\u30f3\u540d\u3092\u8ffd\u52a0\u3059\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\uff08\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u30c8\u30ea\u30df\u30f3\u30b0\u52a0\u5de5\u3092\u884c\u3046\u3053\u3068\u3082\u3042\u308a\u307e\u3059\uff09\u3002\n  \u30fb\u53c2\u8003\u8cc7\u6599\uff1a\u4ed6\u306e\u30a4\u30e9\u30b9\u30c8\u30ec\u30fc\u30bf\u30fc\u3078\u306e\u4f9d\u983c\u6642\u306b\u304a\u3051\u308b\u53c2\u8003\u8cc7\u6599\u3068\u3057\u3066\u306e\u63d0\u793a\u3002\n\u3053\u308c\u3089\u306e\u7528\u9014\u306b\u304a\u3044\u3066\u3001\u7121\u65ad\u4f7f\u7528\u9632\u6b62\u306e\u305f\u3081\u306b\u30a6\u30a9\u30fc\u30bf\u30fc\u30de\u30fc\u30af\u3092\u9069\u5b9c\u4ed8\u3051\u3066\u3001\u30a4\u30e9\u30b9\u30c8\u3092\u4f7f\u7528\u3055\u305b\u3066\u3044\u305f\u3060\u304f\u5834\u5408\u304c\u3042\u308b\u306e\u3067\u3001\u30a6\u30a9\u30fc\u30bf\u30fc\u30de\u30fc\u30af\u306b\u3064\u3044\u3066\u3082\u3054\u63d0\u4f9b\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002\n\u306a\u304a\u3001\u5546\u696d\u5229\u7528\u3084\u7b2c\u4e09\u8005\u3078\u306e\u518d\u914d\u5e03\u306f\u884c\u3044\u307e\u305b\u3093\u3002\n\n\u3054\u78ba\u8a8d\u306e\u307b\u3069\u3001\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002\n\u3054\u7e01\u304c\u3042\u308a\u307e\u3057\u305f\u3089\u3001\u3069\u3046\u304b\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002\n\nhttps://drive.google.com/drive/folders/1IhO160JfiDdTf-oK9KyA6J-NDO9u5fWj", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sajimochi_h/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3460217, "client_id": 2403555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c925e96/uploads/origins/15f975a0-214d-440b-b2ca-84cea2ce0d7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&