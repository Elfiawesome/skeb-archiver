赤夜の腋を舐めて始まった。\n・赤夜は予想外の強い快感に襲われて、まったく余裕がなくなった。「蒼輝ぃ♡ こ、これ♡反則♡ 」と蒼輝に言いながら、熱っぽい息を漏らした。 赤夜は両方の快感に敵わない、喘ぎ声を出して、涎も垂らして、勢よく射精する、精液は腹、胸や頬まで散らした。\n・蒼輝は、兄さんが目の前に気持ちよく射精の姿ですごい興奮して、ギンギンになって、先っぽもちょっと濡れた。\n（アへ顔など過激な表現はNGです）\n \n他のセリフ、構図等で指定はとくにありません。\n\nもし承認可能な内容でしたら、どうぞよろしくお願いいたします！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamaaarch/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/feb1899e/uploads/origins/0422c6be-c3f4-4974-880d-eaae19bb7173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f28dbc06a1f0f2236d9bac8605574b0", "srcset": "https://si.imgix.net/feb1899e/uploads/origins/0422c6be-c3f4-4974-880d-eaae19bb7173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f28dbc06a1f0f2236d9bac8605574b0, https://si.imgix.net/feb1899e/uploads/origins/0422c6be-c3f4-4974-880d-eaae19bb7173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e904e60fe2998a7b5f4f376a1976063a 2x, https://si.imgix.net/feb1899e/uploads/origins/0422c6be-c3f4-4974-880d-eaae19bb7173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=467e8e7eaa47eb5988c8236fdce6b593 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 147528, "client_id": 1103855, "nc": 145}, {"path": "/@hamaaarch/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 147528, "client_id": 201020, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b380375c/uploads/origins/f56b4dfa-29a1-4ba5-b641-f862a54e