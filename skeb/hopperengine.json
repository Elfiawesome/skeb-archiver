=crop&crop=top&w=200&h=200&s=86503d10c7c9927dd259264ff1b19d5d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d750f404/uploads/origins/69b5eb99-48e3-4de6-953a-0b108dbb782a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57d102d0e450a9f49cbac0638c93a98c", "src_set": ""}, "body": "初めまして、リクエストをよろしくお願いいたします。\n\nイラストのキャラクターはドルフロのコンテンダーです。\n二枚のイラストを描けでお願いします\n一枚目\n彼女は指揮官の太ももに座って、恥ずかしくて何か期待しているの顔です。\n\n二枚目\n指揮官は彼女の頭をなでなでし、二人も喜んでいます。\n\n以上です。\nご検討宜しくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hopperengine/works/64", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 84737, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09f481b9/uploads/origins/a96b44d3-6908-48bb-8d2a-b885d0a86b05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4263836b6a7f82ae5eb12e72be63b991", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09f481b9/uploads/origins/a96b44d3-6908-48bb-8d2a-b885d0a86b05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bc142062a2344d6ed0fb1346ee90b3f", "src_set": ""}, "body": "リクエスト失礼いたします。\n\n参考資料の子がねっとりとフェラをしているイラストをお願いしたいです。\n\n前回依頼したシチュから時間が経ち、この子がフェラに慣れて攻め側に回ったイメージで。\nねっとりと奥までくわえ込み、責め立てるようなフェラをしているシチュをお願いします。\n\n射精後に、参考資料の子がこちらに対して勝ち誇ったような今までの仕返しが出来て満足げな、ちょっぴり意地悪そうな笑みを浮かべていると嬉しいです。\n\nカメラアングル、台詞と服装は特に指定は無いのでお任せします。\n台詞と服装は案が無ければ無しでも構いません。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1nZtv7Yu9QLKlchFMbuRHlCP4AzIY-aor?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hopperengine/works/63", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "cre