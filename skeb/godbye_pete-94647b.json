はなくても構いません。\n・しかし、ファンタジー系のデザインにするなら殺傷兵器である事がわかりやすい尖ったデザインが望ましいです。\n（個人的には両手で持つほどの長物だと嬉しいです）\n\n『性格』\n・終わってます。\n・平気で魔法少女としての力を市民に向けます。\n・魔法少女にも向けます、むしろそれが存在理由です。\n・彼女は魔法少女を終（おわり）にする魔法少女です。\n\n以上の内容でご依頼させていただきまました。\n可能であれば受諾のほうお願いたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@godbye_pete/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 48320, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94a4f4fe/uploads/origins/844cd5c9-1a4c-45ec-9721-df3c6c260138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f63e112c6ba82cd584b0872fe2c5225f", "srcset": "https://si.imgix.net/94a4f4fe/uploads/origins/844cd5c9-1a4c-45ec-9721-df3c6c260138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f63e112c6ba82cd584b0872fe2c5225f, https://si.imgix.net/94a4f4fe/uploads/origins/844cd5c9-1a4c-45ec-9721-df3c6c260138?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12905840a3a3b9a1f6a7550423154488 2x, https://si.imgix.net/94a4f4fe/uploads/origins/844cd5c9-1a4c-45ec-9721-df3c6c260138?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76b436718732a8455996060c4e9c194d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94a4f4fe/uploads/origins/844cd5c9-1a4c-45ec-9721-df3c6c260138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7eb277e088e5467d3d1da7066afcf37", "srcset": "https://si.imgix.net/94a4f4fe/uploads/origins/844cd5c9-1a4c-45ec-9721-df3c6c260138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7eb277e088e5467d3d1da7066afcf37, https://si.imgix.net/94a4f4fe/uploads/origins/844cd5c9-1a4c-45ec-9721-df3c6c260138?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=74fd4bf927023