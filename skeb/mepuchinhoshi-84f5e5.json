36a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62e69ff0c3f1b232843ecfb844837870 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f7bae74/uploads/origins/1129cc23-d379-46ff-b9e9-8a01eb60236a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e833380700633f4cea63391b3cc1de3", "srcset": "https://si.imgix.net/3f7bae74/uploads/origins/1129cc23-d379-46ff-b9e9-8a01eb60236a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e833380700633f4cea63391b3cc1de3, https://si.imgix.net/3f7bae74/uploads/origins/1129cc23-d379-46ff-b9e9-8a01eb60236a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bb3d49a2e170a3af5993048dd613c06b 2x, https://si.imgix.net/3f7bae74/uploads/origins/1129cc23-d379-46ff-b9e9-8a01eb60236a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c7621482abc4ddf0ff845d0ff9ac15d7 3x"}, "body": "こんにちは！\n\nもしよろしければ、東方Projectの博麗霊夢さんが、お金をくれる人におっぱいをチラつかせる姿を見たいと思い、リクエストさせていただきます。\n\nいつもの衣装で登場するのですが、できれば巨大なおっぱいをお願いします。胸が大きすぎて、シャツが隠せず、下乳が丸出しになる。(似たようなもの：https://www.pixiv.net/en/artworks/99269922#manga）\nおっぱいはできるだけ大きくしてください。\n\nもし差分をお願いできるのであれば、シャツをめくり上げる前と後をお願いできますか？\n\nご配慮ありがとうございました。\n誤訳がありましたら申し訳ありません。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mepuchinhoshi/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2662749, "client_id": 1710302, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62ac8348/uploads/origins/2ec1d34b-f11c-4644-8b58-d450073560a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a0aa3515b30ad76192816b659031127", "srcset": "https://si.imgix.net/62ac8348/uploads/origins/2ec1d34b-f11c-4644-8b58-d450073560a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a0aa3515b30ad76192816b659031127, https://si.imgix.net/62ac8348/uploads/origins/2ec1d34b-f11c-4644-8b58-d450073560a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d04875e8e8b5e38287609a8ab5f7c422 2x, https://si.imgix.net/62ac8348/uploads/origins/2ec1d34b-f11c-4644-8b58-d450073560a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af3982e26fbd853b17250decd4839916 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62ac8348/uploads/origins/2ec1d34b-f11c-4644-8b58-d450073560a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bed45de4ca5ee5385851eb040d4bfc5", "srcset": "https://si.imgix.net/62ac8348/uploads/origins/2ec1d34b-f11c-4644-8b58-d450073560a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bed45de4ca5ee5385851eb040d4bfc5, https://si.imgix.net/62ac8348/uploads/origins/2ec1d34b-f11c-4644-8b58-d450073560a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28718ca58a00eb40b27aca72a17b6474 2x, https://si.imgix.net/62ac8348/uploads/origins/2ec1d34b-f11c-4644-8b58-d450073560a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7602fa26e5172264f81ac515ab05fcbd 3x"}, "body": "書いて欲しいもんむす及び人物\nもんむす・クエスト！ぱらどっくすRPGに登場する\nシスターラミアのソフィアさん\n&\n偽勇者のルカ\n\nシチュエーション\n\nシスターラミアのソフィアさんがルカ(裸)に、 「聖母蛇の抱擁」をしているシーンをリクエストします。 \n\n具体的には、\n ・ソフィアさんの服は着ているが、胸がはだけて、丸見えの状態。 \n・ルカは蛇体にぐるぐる巻きにされて拘束されている(巻き方はおまかせします) \n・ソフィアさんのおっぱいにルカの顔が挟まれて埋もれている状態(ぱふぱふ) \n・ソフィアさんにルカが犯されている状態(ルカのちんちんがソフィアさんのおまんこに挿入している) \n・背景や体勢、セリフ、射精差分等おまかせします。 \n(過去にめぷちん☆さんが描いたラミアさんが、\n優しそうで、柔らかくて大きなおっぱいと気持ち良さげな蛇体を見て、合いそうだと思い依頼します。\nソフィアさんの蛇体による抱擁とおっぱいを堪能しながら昇天したいので、どうかよろしくお願いします。)\n資料\n公式URL\nhttp://mon110.sakura.ne.jp/mong/top_monq.html\nTwitter資料\n\nhttps://twitter.com/daizu1qwerty1/status/1522741560949239808?t=YNOgjtysFq7p6oXP2I3aIw&s=19", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mepuchinhoshi/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2662749, "client_id": 896491, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/886a0060/uploads/origins/61f6f8b3-0590-49f5-8852-3cff4e7b3580?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cde977342b1427c7cc820cd7a4dee1e2", "srcset": "https://si.imgix.net/886a0060/uploads/origins/61f6f8b3-0590-49f5-8852-3cff4e7b3580?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cde977342b1427c7cc820cd7a4dee1e2, https://si.imgix.net/886a0060/uploads/origins/61f6f8b3-0590-49f5-8852-3cff4e7b3580?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=574bc8d62c9ed21bee1fd6e73a90de63 2x, https://si.imgix.net/886a0060/uploads/origins/61f6f8b3-0590-49f5-8852-3cff4e7b3580?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f11c146ed72ec1f4deb3e790fc231c47 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/886a0060/uploads/origins/61f6f8b3-0590-49f5-8852-3cff4e7b3580?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7133a2ebe660b58bcbdef73a5f39af2e", "srcset": "https://si.imgix.net/886a0060/uploads/origins/61f6f8b3-0590-49f5-8852-3cff4e7b3580?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7133a2ebe660b58bcbdef73a5f39af2e, https://si.imgix.net/886a0060/uploads/origins/61f6f8b3-0590-49f5-8852-3cff4e7b3580?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d51cc07ccfc63ed5cf121b951b5aac89 2x, https://si.imgix.net/886a0060/uploads/origins/61f6f8b3-0590-49f5-8852-3cff4e7b3580?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=281de2a157475de8835e4bf03f523f7e 3x"}, "body": "初めまして。\n耳袋さんやもみじちゃん等のかわいくておっぱいが大きい子に癒されている者です。\n早速ですが、めぷちん☆さんの絵柄で見てみたいおっぱいが大きいキャラをリクエストいたします。\n\n【依頼詳細】\n人知れずｺｯｼｮﾘ着物を脱ぎ、セクシーランジェリー(エロ下着)と母乳のしたたるおっぱいを露わにしてムラムラしている東北イタコさん\n【依頼詳細】\n●東北イタコ\n体型：巨乳～爆乳・ぷっくりとした乳首・安産型\n服装：脱いでいる最中の公式の着物＋乳首が丸出しのエロに特化したセクシーランジェリー(※性器がセクシーランジェリーで隠されているか丸出しかはお任せします)\n●場所\n誰もいない野外・自分の部屋など、誰にも見られていない場所、もしくは背景無し\n●他\n・ポーズ・表情などの指定していない項目はお任せいたします。\n・東北イタコは二次創作公認プログラム 登録作品のキャラクターです\n・R-18の検索除けワードは「ｺｯｼｮﾘ」「コッショリ」です。(https://twitter.com/t_zunko/status/1136924737047678976)\n\nよろしくお願いいたします。\n\nhttps://twitter.com/t_zunko/status/1136924737047678976", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mepuchinhoshi/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f006cdba/uploads/origins/f8aca32a-7071-422c-b310-2b290bc85f17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9750724ad8f45377d7a490ec69714764", "srcset": "https://si.imgix.net/f006cdba/uploads/origins/f8aca32a-7071-422c-b310-2b290bc85f17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9750724ad8f45377d7a490ec69714764, https://si.imgix.net/f006cdba/uploads/origins/f8aca32a-7071-422c-b310-2b290bc85f17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63e432c3797ca70042088bf985d08862 2x, https://si.imgix.net/f006cdba/uploads/origins/f8aca32a-7071-422c-b310-2b290bc85f17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb15066c9d6178e36b37957e4d7bde50 3x"}, "private": true, "genre": "art", "tipped": tru