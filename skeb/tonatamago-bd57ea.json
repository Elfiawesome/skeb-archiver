=crop&crop=top&w=200&h=200&blur=200&s=3183b5e440b193eeac43be6e6bcb4128, https://si.imgix.net/be3ce450/uploads/origins/7e4054bf-bc7a-4d36-a9a6-75171937dc0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81a420e91776d1c12b2e6655ad517bad 2x, https://si.imgix.net/be3ce450/uploads/origins/7e4054bf-bc7a-4d36-a9a6-75171937dc0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a853224b22fbae4d667eb5f26044357a 3x"}, "body": "こんにちは！(*´ω｀*)あなたのアートスタイルが大好きです!^^\n\nもしよろしければ、私のキャラクターを描いていただけませんか？\nこれは彼女です。https://imgur.com/a/lBn0P6Q\n\n彼女の名前は「ゆあ」です!愛嬌があって屈託のないキツネ女です。\nかわいいポーズやカッコイイポーズが見たいですね。夜空を眺めたり、火の魔法をかけたり。全てはあなた次第です。:D\n\nどちらの服装で描いてもOK!どちらを選んでもOKです。\n\nご検討のほど、よろしくお願いいたします\n\nhttps://imgur.com/a/lBn0P6Q", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tonatamago/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1224921, "client_id": 302886, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97a402a2/uploads/origins/8700b898-66d7-4ff3-9e33-d2dc60e1f740?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d0fd4f51132f3a9ae0ff783b8460b7e", "srcset": "https://si.imgix.net/97a402a2/uploads/origins/8700b898-66d7-4ff3-9e33-d2dc60e1f740?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d0fd4f51132f3a9ae0ff783b8460b7e, https://si.imgix.net/97a402a2/uploads/origins/8700b898-66d7-4ff3-9e33-d2dc60e1f740?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3938282302829a6e352981d31bd1fd3 2x, https://si.imgix.net/97a402a2/uploads/origins/8700b898-66d7-4ff3-9e33-d2dc60e1f740?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46625ea6e7319cc4b06406c4d60c7a61 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97a402a2/uploads/origins/8700b898-66d7-4ff3-9e33-d2dc60e1f740?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4465601a7b036f2cdd1e5afd8558e30a", "srcset": "https://si.imgix.net/97a402a2/uploads/origins/8700b898-66d7-4ff3-9e33-d2dc60e1f740?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4465601a7b036f2cdd1e5afd8558e30a, https://si.imgix.net/97a402a2/uploads/origins/8700b898-66d7-4ff3-9e33-d2dc60e1f740?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8300f864e688e69b760751cd50a0b936 2x, https://si.imgix.net/97a402a2/uploads/origins/8700b898-66d7-4ff3-9e33-d2dc60e1f740?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c56034c38b38ca2237383afd4331ce44 3x"}, "body": "初めまして。\n納品絵の豊かな表情と「目力」に惹かれてリクエスト致します。\n\n1980年代のマイナーシールで恐縮ですが、\n資料URLの『銀河伝説　バトラーの聖剣』に登場する王妃マイリアを、\ntona様が描かれる「リアル頭身」で生身の姿をデザインして頂けますでしょうか。\n\nシールでは石化されており、生身の姿がありません。\nまたSDキャラですので、リアルな頭身にして頂くにあたり、\nカラーリングや細部のデザインをお任せいたします。\nその際、娘のアイララ姫もご参考頂けますと幸いです。\n私の妄想ですが、アイララ姫が14、5歳くらいに見えるので、\n母親であるマイリア妃は30歳前半くらいの包容力のある聖母的な美女、と考えております。\nなお、サンダル履きとして頂き、足の指が見えるようなデザインだと嬉しいです。\n\n以下、資料になります。\nお手数をおかけいたしますが、ご検討の程よろしくお願いいたします。\n\n・王妃マイリア（裏面）\nhttps://img.mandarake.co.jp/webshopimg/03/00/028/0300590028/03005900283.jpg\n・アイララ姫\nhttps://img.aucfree.com/j586165339.1.jpg\n\nhttps://img.mandarake.co.jp/webshopimg/03/00/028/0300590028/03005900282.jpg", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tonatamago/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1224921, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/823d2324/uploads/origins/a2d3c8a4-731c-4275-9f1d-7eef8ea1c51a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86cb14ab8e9eff49b6e4704effaf8bfa", "srcset": "https://si.imgix.net/823d2324/uploads/origins/a2d3c8a4-731c-4275