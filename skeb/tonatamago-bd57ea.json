h=200&s=d456ce0eefa7c8886d61bb0be96b99be, https://si.imgix.net/92254e7d/uploads/origins/e961ff80-494b-46d4-bd14-7f039035ebd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d74cd50d827dc8a43f9438124f1211c0 2x, https://si.imgix.net/92254e7d/uploads/origins/e961ff80-494b-46d4-bd14-7f039035ebd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8814a8b702bd6e6f9283ebbd7846619 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92254e7d/uploads/origins/e961ff80-494b-46d4-bd14-7f039035ebd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe64459e59652b5bbeaf965714674eee", "srcset": "https://si.imgix.net/92254e7d/uploads/origins/e961ff80-494b-46d4-bd14-7f039035ebd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe64459e59652b5bbeaf965714674eee, https://si.imgix.net/92254e7d/uploads/origins/e961ff80-494b-46d4-bd14-7f039035ebd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ece5d232dff4019d1eeb7748f3a1671 2x, https://si.imgix.net/92254e7d/uploads/origins/e961ff80-494b-46d4-bd14-7f039035ebd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6b3a349887eebb344f3909f9f3556d1c 3x"}, "body": "先日はドット絵しかないにもかかわらず、『ヴァーミリオン』の主人公の母親である王妃をデザインして頂き、誠にありがとうございます。\n凛とした美しさはまさに背景の額節に飾られた絵画のようで、ラスボスも妃にしたいくらいの美貌の持ち主だと思います！\n\n引き続き、リピートさせて頂きます。\n\n1986年のレトロゲームで恐縮ですが、資料URLのFCソフト『スーパーピットフォール』に登場するロンダを、tona様が描かれる「リアル頭身」でデザインして描いて頂けますでしょうか。\n\nロンダは『スーパーピットフォール』の主人公の探検家・ハリーの姪で、ハリーは地底王国の秘宝「ラージ・ダイヤモンド」を探し求めており、その探検に同行していますが、途中で地底人に捕らわれてしまいます。\nhttps://img.atwiki.jp/famicomall/attach/668/3688/superpitfall_r.PNG\nhttps://cdn-ak.f.st-hatena.com/images/fotolife/j/jackallsasaki/20210929/20210929173332.jpg\n\nただ、レトロゲームだけあって容量の都合もあり、パッケージのイラストとドット絵の柄が大幅に異なるのと、ロンダはハリーの姪という設定ですが、マニュアルでは「私の大切なロンダ」と書かれていたり、チラシでは「恋人「ロンダ」を助け出せ！」と書かれたりしていることから、\nhttp://blog-imgs-44.fc2.com/k/u/r/kuroneko64san/20101128104059013.jpg\nhttps://cdn-ak.f.st-hatena.com/images/fotolife/j/jackallsasaki/20210929/20210929173326.jpg\n\nこちらの恋人説を推させて頂き、資料URLの↘左下のイラストを参考に、18、9歳くらいの、縦ロールの金髪、パフスリーブの赤いロングドレスを着た、ハリーの恋人兼助手の知的でどこか艶っぽい美女としてtona様にデザインして頂けますでしょうか。\n地底人が捕らえるくらいの美貌の持ち主、として頂けますと幸いです。\n\n以上となります。\nお手数をお掛け致しますが、ご検討の程よろしくお願い致します。\n\nhttps://img.fril.jp/img/627281095/l/2006171970.jpg?1692623535", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tonatamago/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/06ec7f58/uploads/origins/d7f4c780-885c-4a2f-8d4b-4da2d6a90024?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5f8d636a7186c6faf7817da03f8e2ea", "srcset": "https://si.imgix.net/06ec7f58/uploads/origins/d7f4c780-885c-4a2f-8d4b-4da2d6a90024?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5f8d636a7186c6faf7817da03f8e2ea, https://si.imgix.net/06ec7f58/uploads/origins/d7f4c780-885c-4a2f-8d4b-4da2d6a90024?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7da4135fddf93008efc3b3f2409252ba 2x, https://si.imgix.net/06ec7f58/uploads/origins/d7f4c780-885c-4a2f-8d4b-4da2d6a90024?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fba0220cc6cb1a214f2078e23e4907eb 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1224921, "client_id": 302886, "nc": 128}, {"path": "/@tonatamago/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1224921, "client_id": 302886, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/14d686f1/uploads/origins/76873de5-f74a-4dec-9c1c-62db0de656aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b313c019118efdf6acb0fe84673f0948", "srcset": "https://si.imgix.net/14d686f1/uploads/origins/76873de5-f74a-4dec-9c1c-62db0de656aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b313c019118efdf6acb0fe84673f0948, https://si.imgix.net/14d686f1/uploads/origins/76873de5-f74a-4dec-9c1c-62db0de656aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9db05ebbef2621e3951df96e7edcfab 2x, https://si.imgix.net/14d686f1/uploads/origins/76873de5-f74a-4dec-9c1c-62db0de656aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8990741c7e72eb80e3137e36e7a01ee7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/14d686f1/uploads/origins/76873de5-f74a-4dec-9c1c-62db0de656aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a2f9cba4669cb71d4f837a3a5abf285", "srcset": "https://si.imgix.net/14d686f1/uploads/origins/76873de5-f74a-4dec-9c1c-62db0de656aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a2f9cba4669cb71d4f837a3a5abf285, https://si.imgix.net/14d686f1/uploads/origins/76873de5-f74a-4dec-9c1c-62db0de656aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5aca1b4c61383eb8d8904a70d1058ce8 2x, https://si.imgix.net/14d686f1/uploads/origins/76873de5-f74a-4dec-9c1c-62db0de656aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3f72e31b3a65cba27dc938bcf0e1f59c 3x"}, "body": "先日は『銀河伝説　バトラーの聖剣』に登場する王妃マイリアとアイララ姫の母娘をデザインして頂き、誠にありがとうございます。SDキャラをリアル頭身へデザインして頂くにあたり、tona様のオリジナリティを入れて頂くなど、見えない部分や詳細を補完して頂き、どちらも素晴らしい1枚です！\n\n再開されたようですので引き続きリクエストさせて頂きます。\nただ、お任せの部分が多いリクエストですので、無理そうであれば遠慮なくお断り下さい。\n\nセガが1989年に販売したメガドライブソフト『ヴァーミリオン』に登場する、資料URLの主人公の母親を、tona様にデザインして頂けないでしょうか。\nフョードルという平和な国の王妃でしたが、夫であり、主人公の父でもある国王リラダン五世を殺されて国を滅ぼされ(主人公はこの時、家臣によって城から落ち延びています)、夫を殺し国を滅ぼした相手であるアーネスト国の国王ロルカ三世に再婚させられ、夫の仇を取ろうと数年掛けて企むものの見破られて15年間ずっと石化されていました。\n資料URLは主人公がラスボスであるロルカ三世を倒したことで石化が解け、18年ぶり……といっても主人公は生まれて間もなく家臣によって国から落ち延び、王妃はロルカ三世に攫われて再婚させられた挙句15年間石化されていたので、初対面で再開というシーンですが、34年前のレトロゲーム故、ドット絵だけでイラストや名前すらありませんので、\n\n・年齢は23歳位の誰もが息を呑む程の美女(敵の国王が攫って娶る位ですので。ただ、石化されていたので歳は取っていません)\n・プラチナブロンドのロングウェーブ＆鬢の髪は縦ロール(主人公の髪は父親譲り)\n・赤いドレスを着て、ティアラ(小さめの王冠？)や装飾品を付けている\n・夫を殺し、国を滅ぼした相手に娶られつつも、それを利用して夫の仇を取ろうとする聡明さと意思の強さを持つ\n・主人公と会うのは初めてだが、夫リラダン五世の若い頃に似ており一目で我が子だと分かり、夫の面影を重ねて笑いかけている\n\nドット絵や会話、上記の設定等、読み取れる情報を元に、tona様に好きなように外見や衣装等をデザインして頂けますと幸いです(髪の色などもあくまで視認できるレベルですので、全体の色味を加味して変更して頂いて構いません)。\n\n以上となります。\nお手数をお掛け致しますが、ご検討頂けますと幸いです。\n\nhttps://pbs.twimg.com/media/FUqOJQwaIAASw6y?format=jpg&name=large", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tonatamago/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/30c129f9/uploads/origins/1693db26-af9e-425b-a763-e857f5c0b170?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c608e3e3b3d324a758191519fbbb1d2", "srcset": "https://si.imgix.net/30c129f9/uploads/origins/1693db26-af9e-425b-a763-e857f5c0b170?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c608e3e3b3d324a758191519fbbb1d2, https://si.imgix.net/30c129f9/uploads/origins/1693db26-af9e-425b-a763-e857f5c0b170?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db0b36970cf66a68078bd3ad904ae9a3 2x, https://si.imgix.net/30c129f9/uploads/origins/1693db26-af9e-425b-a76