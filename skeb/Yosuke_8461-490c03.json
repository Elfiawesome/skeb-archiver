かぶっています。可能であれば、彼女の武器をアートワークに入れてください。\n\n表情はあなた次第！背景は白で十分。\n\n営利目的でない趣味での使用をお願いしたいのですが、もしよろしければアーケードスティックに貼ろうと思っています。\n\n必要であれば参考資料です：\nhttps://drive.google.com/drive/folders/1wduxWmfrSZrPzNE4sqcHzHUHrahSL15Z?usp=drive_link\n\nご検討よろしくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yosuke_8461/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1687160, "client_id": 1810528, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52871efa/uploads/origins/13859745-960f-45f7-b35d-f2c0f6666155?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2fded6f08062a2644ca7e6b2964fa1d", "srcset": "https://si.imgix.net/52871efa/uploads/origins/13859745-960f-45f7-b35d-f2c0f6666155?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2fded6f08062a2644ca7e6b2964fa1d, https://si.imgix.net/52871efa/uploads/origins/13859745-960f-45f7-b35d-f2c0f6666155?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a21feda275246e0f2051d829046f045a 2x, https://si.imgix.net/52871efa/uploads/origins/13859745-960f-45f7-b35d-f2c0f6666155?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfefafaf7d497cd47c3f3c9ec28dd216 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52871efa/uploads/origins/13859745-960f-45f7-b35d-f2c0f6666155?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e27df1c8fe539ae1b7705dd5a4f1c49b", "srcset": "https://si.imgix.net/52871efa/uploads/origins/13859745-960f-45f7-b35d-f2c0f6666155?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e27df1c8fe539ae1b7705dd5a4f1c49b, https://si.imgix.net/52871efa/uploads/origins/13859745-960f-45f7-b35d-f2c0f6666155?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&