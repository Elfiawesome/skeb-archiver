l\n\nその他の衣装もご覧になりたい方は、こちらをご覧ください：\nhttps://catbox.moe/c/n24fbr\n\nソーシャルメディアや自分のストリームで使いたい。\n\nよろしくお願いします！\n\nhttps://files.catbox.moe/psgnur.png", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kayaonoe/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2056592, "client_id": 2239465, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d93ceb75/uploads/origins/1d86397e-b910-4de3-b75b-8f39241a6a61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f394ca9bc1d1e9672df052eefbffb127", "srcset": "https://si.imgix.net/d93ceb75/uploads/origins/1d86397e-b910-4de3-b75b-8f39241a6a61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f394ca9bc1d1e9672df052eefbffb127, https://si.imgix.net/d93ceb75/uploads/origins/1d86397e-b910-4de3-b75b-8f39241a6a61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=390e1eb41b02f6b828401e4fb8c0300d 2x, https://si.imgix.net/d93ceb75/uploads/origins/1d86397e-b910-4de3-b75b-8f39241a6a61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d48368c6678d2410453f4c7b7a52bd0f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d93ceb75/uploads/origins/1d86397e-b910-4de3-b75b-8f39241a6a61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e88ca9fde9696d35737cabc93c38f2b", "srcset": "https://si.imgix.net/d93ceb75/uploads/origins/1d86397e-b910-4de3-b75b-8f39241a6a61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e88ca9fde9696d35737cabc93c38f2b, https://si.imgix.net/d93ceb75/uploads/origins/1d86397e-b910-4de3-b75b-8f39241a6a61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dfeef4ad0230195b6a0d43d80e8ca29c 2x, https://si.imgix.net/d93ceb75/uploads/origi