ix.net/903eaa5f/uploads/origins/da3d21db-1fb8-4488-a623-086cfe8e889f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f55e8463822e4db6dc11749acc8cef08 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/903eaa5f/uploads/origins/da3d21db-1fb8-4488-a623-086cfe8e889f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92660271142b6321cb2788c5e3bca72a", "srcset": "https://si.imgix.net/903eaa5f/uploads/origins/da3d21db-1fb8-4488-a623-086cfe8e889f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92660271142b6321cb2788c5e3bca72a, https://si.imgix.net/903eaa5f/uploads/origins/da3d21db-1fb8-4488-a623-086cfe8e889f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=47a9d0b49efc945245d27f51569425e9 2x, https://si.imgix.net/903eaa5f/uploads/origins/da3d21db-1fb8-4488-a623-086cfe8e889f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=004afef1f9aa94425342b7ef01dde91c 3x"}, "body": "めだかＨ2様\n\nお世話になっております、薬袋さいねと申します。\n\n先日は大変素敵な作品を納品していただき、誠にありがとうございました。\nとても可愛らしくて感動いたしました……！大満足でした！\n\nぜひ別衣装のイラストも描いていただきたいと思い、再度リクエストを送らせていただきます。\n不足や失礼な点等ございましたら申し訳ございません。\n\n◇使用用途\nYouTubeのサムネイルに使用(収益化済みチャンネルです)\nXで宣伝に使用(おはVやフォロー祭りタグ等)\nデジタルグッズ、リアルグッズ等に使用(商用利用あり)\n\n◇希望\n資料URLのフォルダに3種類の衣装がありますので、お好きな物を選んで自由に描いていただければと存じます。\n前回のルームウェア衣装以外ですと嬉しく存じます。\n特徴である髪色や瞳の色以外は、衣装の簡略化などしていただいても構いません。\n構図、ポーズ等もお任せいたします。\nサムネイルに使用したいため、上・左右の見切れがないようにしていただきたいです。\n人物とそのほかのレイヤーを分けるかもしくはPSDデータにて納品していただきたいです。\n\nもし金額が足りない場合はお手数ですが差し戻ししていただけますと幸いです。\n\n以上、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Mo48w2svrVWz9o--yuXSwmQg87iZUFJZ?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@killifish_/works/427", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id":