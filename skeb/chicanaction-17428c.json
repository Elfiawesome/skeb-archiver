かコスプレとか）\n私服着るならワンピース服を好んでよく着ます\nピンク、水色が好みです\nコスプレの場合女の子っぽいコスプレを好んで着ます（チアガールやメイド服など）\n\nもし1キャラのみの場合は、最近クッキークリッカーをやっててとめられないのでクッキークリッカーのチョコクッキーを手に持って食べているポーズが見たいです（衣装は冬服制服）\n\n背景と各キャラ、サインを別レイヤーにしてpsdで納品してほしいです\n楽しんで描いていただいていて、こちらも気兼ねなく依頼できるので助かります\nよろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/1yOy40HIONS-A4GRnnaNe8UZ1fkW2T24P?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chicanaction/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3525723, "client_id": 1350135, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d2bf473c/uploads/origins/7deaa14a-9949-44ee-a146-4887846dcc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcbfc79966d07e8e03e4406a258214b1", "srcset": "https://si.imgix.net/d2bf473c/uploads/origins/7deaa14a-9949-44ee-a146-4887846dcc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcbfc79966d07e8e03e4406a258214b1, https://si.imgix.net/d2bf473c/uploads/origins/7deaa14a-9949-44ee-a146-4887846dcc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e15a733b3bd376605997bf13e803eea7 2x, https://si.imgix.net/d2bf473c/uploads/origins/7deaa14a-9949-44ee-a146-4887846dcc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3cf76d98ab02c43a99bf85bd88859c2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2bf473c/uploads/origins/7deaa14a-9949-44ee-a146-4887846dcc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad35652b5517cfc281d6da94329576aa", "srcset": "https://si.imgix.net/d2bf473c/uploads/origins/7deaa14a-9949-44ee-a146-4887846dcc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad35652b5517cfc281d6da94329576aa, https://si.imgix.net/d2bf473c/uploads/origins/