13/uploads/origins/f9d97391-0186-42d6-a36b-4227240e6c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=375998e789afa14d857356c85b460f3e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e122513/uploads/origins/f9d97391-0186-42d6-a36b-4227240e6c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bb3f91f1fcf88aef53dd4bbfc8fafd0", "srcset": "https://si.imgix.net/3e122513/uploads/origins/f9d97391-0186-42d6-a36b-4227240e6c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bb3f91f1fcf88aef53dd4bbfc8fafd0, https://si.imgix.net/3e122513/uploads/origins/f9d97391-0186-42d6-a36b-4227240e6c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6170e8cdd17df33017594abd3192ff8a 2x, https://si.imgix.net/3e122513/uploads/origins/f9d97391-0186-42d6-a36b-4227240e6c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=75d41743c3ce7d484a471909d33ffe39 3x"}, "body": "いつも大変お世話になっております\nもう一件依頼したいです\nチアガール大大大好きなので描いていただきたいです\n\n●【キャラクター】\n夜桜桜花\n髪型はツインテールで\n\n●【シチュエーション】\nチアガール(通常等身)\n・へそ出し衣装\n・乳カーテン←大事\n(https://dic.pixiv.net/a/%E4%B9%B3%E3%82%AB%E3%83%BC%E3%83%86%E3%83%B3）\n\n衣装：水色とピンクを基調とした衣装内に文字の装飾が無いチアガール衣装\n以前描いていただいた参考⇒【https://skeb.jp/@mogitaro25/works/4】\n\nチアガールっぽい元気いっぱいなポーズだと嬉しいです\n胸の大きさがはっきりわかるポーズだととっても嬉しいです\nできるだけ髪が隠れないポーズだと助かります（←かなり難しいとは思うので参考程度にとらえてください）\n\n●【表情】\n性格・シチュエーションに合う明るく元気な表情\nいろんな表情が見てみたいです\n\n背景とキャラ、サインを別レイヤーにしてpsdで納品してほしいです\nよろしくお願いいたします\n楽しみにしてます\n\nhttps://drive.google.com/drive/folders/1yOy40HIONS-A4GRnnaNe8UZ1fkW2T24P?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chicanaction/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3525723, "client_id": 1350135, "vtt_url": null, "thumbnail_im