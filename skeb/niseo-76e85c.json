で、手紙のやりとりをしています。構図や表情はお任せしますので、資料を参考に2人のキャラクターを1枚に収めて頂ければ幸いです。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1S2hYGo_h5wb-YV2I6RTgIiAZLe3zrH30", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@niseo/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bc1b380d/uploads/origins/e1c093a6-6ba5-4a4b-87a7-6f914c833c6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=054271207f013f0d3d86d25611cd9634", "srcset": "https://si.imgix.net/bc1b380d/uploads/origins/e1c093a6-6ba5-4a4b-87a7-6f914c833c6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=054271207f013f0d3d86d25611cd9634, https://si.imgix.net/bc1b380d/uploads/origins/e1c093a6-6ba5-4a4b-87a7-6f914c833c6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b3e76758f527dcf0dcf18d212e1e8fd 2x, https://si.imgix.net/bc1b380d/uploads/origins/e1c093a6-6ba5-4a4b-87a7-6f914c833c6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=51b5911b06570c7945617a0b0ae0f521 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3194, "client_id": 944317, "nc": 128}, {"path": "/@niseo/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3194, "client_id": 77252, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4a2965f/uploads/origins/387ae264-cc80-4e7f-9f24-e86ba67ad419?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d650f9ce3782f9d282265c17d803592", "srcset": "https://si.