設定を添付しております。   \n\n●希望●  \nCocシナリオ『片鱗』イラストを描いて頂きたいです。\nフォルダ内に資料や詳細説明がありますが、極力ネタバレのない範囲で記載しております。\n未通過であったり、不都合がありましたらフォルダ内ネタバレ注意なので見ることなくキャンセルして頂いて大丈夫です。\n\n構図は全てお任せ致します。\nモチーフが｢傘｣｢雨｣｢紫陽花｣となってます。\nぜひとも血液を描いて頂きたいです。\n凛紅が血塗れのナイフを持っていたり、血で汚れた手で三廻部の頬に触れたりなどシリアスめな雰囲気だと嬉しいです。\n三廻部は凛紅相手だと笑うことができます。\n(資料内の立ち絵がラフ状態であるため、細部までではなくニュアンスで緩く何となくで描いて頂けたら大丈夫です)\n凛紅の腰のウォレットチェーンに赤いクマのマスコットもつけて貰えたら嬉しいです。\n\nお忙しいかとは思いますがご検討頂けますと幸いです。  \nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/10f7b1USFFdftDk8vXMax6jqkNqckIo_V", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sheis092/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3368411, "client_id": 3195763, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ebc7f4fb/uploads/origins/312eb260-3b9d-4846-8382-ab15e059ce6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a151a7ea1612f52b8c6cbb17b4e9125a", "srcset": "https://si.imgix.net/ebc7f4fb/uploads/origins/312eb260-3b9d-4846-8382-ab15e059ce6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a151a7ea1612f52b8c6cbb17b4e9125a, https://si.imgix.net/ebc7f4fb/uploads/origins/312eb260-3b9d-4846-8382-ab15e059ce6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f70e45457c9d37204af6edeac3c51636 2x, https://si.imgix.net/ebc7f4fb/uploads/origins/312eb260-3b9d-4846-8382-ab15e059ce6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75580184a2725213aa75168538438ca6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ebc7f4fb/uploads/origins/312eb260-3b9d-4846-8382-ab15e059ce6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2496f88d6a9528edd709859a2c8a8398", "srcset": "https://si.imgix.net/ebc7f4fb/uploads/origins/312eb260-3b9d-4846-8382-ab15e059ce6e?bg