cceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@koori_024/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3496368, "client_id": 3382585, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8d24eff/uploads/origins/6651a0e6-1a63-4e7e-a540-e3ddb97469ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22aa1bf8451b54e8d81c01b430c2f51c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8d24eff/uploads/origins/6651a0e6-1a63-4e7e-a540-e3ddb97469ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef117df0b49a5f1cff67b658de75b0f3", "src_set": ""}, "body": "初めまして！\n個人Vtuberの夢白ねむりと申します。\n\n❄️様の繊細で美しいイラストに惹かれ、リクエストさせていただきました！\n\n【使用用途】\n・活動及び個人でのアイコン、壁紙\n・配信のサムネイル、Xでの投稿\n・FANBOXでの特典（壁紙、ヘッダーなど）\n\n【内容】\n夢白ねむりのイラストをお願いします！\n構図などは全てお任せしますので、お好きなイメージで描いていただければと思います！\n\n【形式】\n人物、背景等がレイヤー分けされたPSDデータでいただけると大変ありがたいです！\n\n【キャラクター詳細】 \nhttps://lit.link/yumeshironemuri\nぬいぐるみ(元の姿)から人の姿に変わった猫の女の子\n寝ることゲームが大好き\nいつも眠そう\n\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1VAsR2euYRjt-r0j-cwdrpJegGJgR5D8I", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koori_024/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3496368, "client_id": 3601683, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fcf1712c/uploads/origins/37db2e60-4e42-4f51-b4a2-92d8222e935f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f4aaee80107b9baf05ec86b1e326e5b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fcf1712c/uploads/origins/37db2e60-4e42-4f51-b4a2-92d8222e935f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0bdfcb881dd2d2d872bec10876ed015e", "src_set": ""}, "body": "やあ、元気だといいね！\n\n僕は君のアートスタイルが大好きで、僕のキャラクターを描いてくれないかなと思っていたんだ！アスペクト比は16x9で、アニメ用に分割できる範囲で描いてもらえると嬉しいです。自分のストリームでPFPやバナー/背景として使いたいです！参考資料を添付しますので、大人っぽさや男らしさがあれば自由に描いてください！ポーズ、表情。あなたの判断を信じます。目の下のビューティーマーク、時計目、ミュージックヘアクリップにご注目ください。\n\n本当にありがとうございました。\n\nhttps://drive.google.com/drive/folders/1SGHWhlNyVWXFMJRMWlDkDNFsp22M774p?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koori_024/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3496368, "client_id": 2089608, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dfe25a2d/uploads/origins/409e130d-be6d-41a3-a65d-4bfceadb90ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d3ce8a5fe9da58648316e31de57336e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dfe25a2d/uploads/origins/409e130d-be6d-41a3-a65d-4bfceadb90ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f46b64079b90f68e333952d87533b74b", "src_set": ""}, "body": "はじめまして、めりぃぱめりぃと申します。\nとても素敵なイラストに惹かれリクエストを送らせていただきました。\n\n【ご依頼内容】\nめりぃぱめりぃのイラストをお願いしたいです。 構図や服装等はおまかせしますが、サムネイルに使用するため髪や頭などが見切れないようにお願いしたいです。 \n先生のアンニュイな雰囲気の男性イラストがとても好きなので、 性別や髪型もすべておまかせいたします！\n\n【使用用途】\n・SNSでの利用\n・サムネイルでの利用\n・配信や動画での利用\n・グッズ化する可能性がございます\n\n【納品形式】\n可能であればPSDでおねがいいたします。\n難しい場合は、 背景透過のものをお願いしたいです。\n\n【資料】\nhttps://lit.link/merrypamerry\n\nこちらのページの下の方に 立ち絵の資料がございます。\n\nよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koori_024/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3496368, "client_id": 3564973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1dd15988/uploads/origins/3eaeef9b-35d5-44c5-aa22-d6b1dc870bd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7c2f6e84f509e969aea2df9e5fdff12", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1dd15988/uploads/origins/3eaeef9b-35d5-44c5-aa22-d6b1dc870bd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c7859d37cc9b0476883fcf47db49842", "src_set": ""}, "body": "はじめまして！\nBraveGroup HareVare所属の風嶺イブキと申します！\n美麗なイラストをお見かけしまして、イラストを描いていただきたくご連絡差し上げました。\n\n構図やポーズはお任せいたします！\nもし可能でしたら表情差分いただけますとたいへん助かります🙇‍♂️\nファイル形式はPNGでいただきたいです。\n\nXのアカウントに立ち絵等イラストがありますので、参考にしていただければと思います。\nよろしくお願いいたします！\n\nhttps://x.com/ibuki_kzmn?s=21&t=4Fxe9iuyg3-zwFXuM-DhrQ", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koori_024/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3496368, "client_id": 3408999, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bdec26bd/uploads/origins/fe87ca59-aca7-41b9-b3b6-996ac657b6b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dc848f05c1e3f72edadf34bed37934e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bdec26bd/uploads/origins/fe87ca59-aca7-41b9-b3b6-996ac657b6b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7434df4130ce0db3316c2165dc44bad6", "src_set": ""}, "body": "❄️様 初めまして。まお。と申します。\nXにて、 ❄️様のイラストを拝見させて頂き、とても素敵なイラストに惹かれました。Skebを開設してるというのを知り、是非自キャラクターを描いて頂きたい…！と思いご依頼させて頂きました。  \n\n鑑賞用、Xのアイコンおよびヘッダーの利用、個人使用の範囲でのみの使用になります。  \n\nキャラクター▽  \n1人目…赤髪のウルフカット、切れ長の黒目に右目下に泣きぼくろがある整った顔立ちのヒーローに憧れる18歳男子高校生です。飄々としていて、誰とでもフレンドリーに話せる陽キャでアクロバティックかつスリリングな事が好きな設定があります。\nhttps://drive.google.com/drive/folders/1-L3hNV9noWK67XIglLoGYLjkSifhcrPM\n\n2人目…金髪に赤目の顔面偏差値が高いイケメンで、左目のハートの泣きぼくろが特徴的な男の子です。女性に対して優しく、紳士的な対応をし、チョコレートの様に甘く相手を虜にしてしまう色男です。ショコラティエという設定があります。\nhttps://drive.google.com/drive/folders/1-sV0iUBlcLm8yq68zQNJGtA10zZqrUmu\n\n構図･雰囲気▽ \n出来れば等身のイラストでお願いしたいです…！\n自キャラなだけで、お互い友人や知り合いという関係ではありません…が、2人の性格上、人付き合いは上手いと思います。\n上記にあれこれと記載していますが構図や雰囲気は全ておまかせ致します！お好きなように描いて頂いて大丈夫です！ \n\n上記内容にて問題や金額が足りない等御座いましたら再送依頼やキャンセルをして頂いて構いません。 \nお忙しいところ申し訳御座いませんが、何卒ご検討の程宜しくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koori_024/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3496368, "client_id": 3116080, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/738b036a/uploads/origins/5631f763-5667-4125-a831-26d409344acb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2fd1ceadb19ee7c8c656b6c81876da5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/738b036a/uploads/origins/5631f763-5667-4125-a831-26d409344acb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be0239503095562163afa09b7f438da2", "src_set": ""}, "body": "はじめまして。ゆあ」と申します。あなたの画風が大好きで、友人のOCキャラのイラストをお願いしたいです。ポーズはお任せします。\n\nhttps://drive.google.com/drive/folders/1lOK0RnUb6Yl2APMxO3iZ0HTQEESbj4sn?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koori_024/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3496368, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d2bba7bb/uploads/origins/7964f930-0e52-4662-95df-989d9955d18d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86b5d0e6e1e243217b37ef0be1f8e646", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2bba7bb/uploads/origins/7964f930-0e52-4662-95df-989d9955d18d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f65c4fc183b0c26976ad9450d8dec261", "src_set": ""}, "body": "Nice to meet you ❄️-san, I like your art so much that I would like to submit a personal request to you for my original character.  \n \nLink: https://sta.sh/212egacz4b2j \n絵【紫苑（36歲）】一人でいいんです。\n36歳の紫苑は長い髪で、もっと落ち着いている。リンクの中に例の画像があります。\nどうぞご自由にお願いします。💗  \n\n没ラフや下描きなどがあれば残したままにしていただけると嬉しいです。 \n私の依頼を考慮していただき、ありがとうございました！ \nHave a nice day!", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koori_024/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3496368, "client_id": 935608, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66cf96ac/uploads/origins/9d81089c-fb04-45fe-b095-e6c04a84b06c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=300fe67e215f4d2d08a0a8f5dd88c4e4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66cf96ac/uploads/origins/9d81089c-fb04-45fe-b095-e6c04a84b06c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24af498a2d8947057aed55887589bad0", "src_set": ""}, "body": "こんにちは！SNSへの投稿はもちろん、グッズ用に私のVtuberのアートを作っていただけませんか？よろしくお願いします！エッチな魔女先輩です。\n\nhttps://drive.google.com/file/d/1ac1pr3uFZpOiTISf13e-3Kx-a4hsDEYS/view?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 2711043, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ゆんこめ", "screen_name": "yunkome_okome", "avatar_url": "https://pbs.twimg.com/profile_images/1567699195896934400/FzmtqtnK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/13