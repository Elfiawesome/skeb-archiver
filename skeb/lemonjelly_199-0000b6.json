ns/c9961d55-5859-4d0a-8fbd-ce036938821f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5e242ba093d677f8fceded20553e4e5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c567648f/uploads/origins/c9961d55-5859-4d0a-8fbd-ce036938821f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cbf4e3c1aca5ce4d16ef651b270dfdc", "srcset": "https://si.imgix.net/c567648f/uploads/origins/c9961d55-5859-4d0a-8fbd-ce036938821f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cbf4e3c1aca5ce4d16ef651b270dfdc, https://si.imgix.net/c567648f/uploads/origins/c9961d55-5859-4d0a-8fbd-ce036938821f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=db1e595d60578ea6a6ae9b48900821d8 2x, https://si.imgix.net/c567648f/uploads/origins/c9961d55-5859-4d0a-8fbd-ce036938821f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a0e656bcbb33f2b9e217c2f254684dd8 3x"}, "body": "こんにちは、レモン先生！\n先生の作品や画風が本当に大好きなので、私のオリジナルキャラクターを描いていただけないかと思い、ご連絡しました！\n最近とてもお忙しく、依頼作品もたくさんお持ちだと存じますので、お邪魔になるのではないかと心配していました。だからこそ、今になってご連絡したのです――お遅くなってしまい、申し訳ありません！\nポーズや表情は自由にお選びいただいて構いませんが、イラストの中で彼女が笑顔になっていれば本当に嬉しいです。\nこのイラストをパソコンとスマホの両方の壁紙として使いたいので、キャンバスサイズを大きめにしていただけると助かります。\nキャラクターデザインに少し変更がありました。 画像の左側にあるヘッドピースは、「黑白头_cb5089524f2f90a595b8e44d0523c8f6」という名前の白黒の参考画像に示されているデザインに合わせて変更されました。 つまり、ヘッドピースを描く際は、その白黒の参考画像を参考にしてください。よろしくお願いします！\n参考画像：\nhttps://drive.google.com/drive/folders/1oRgYjE2ffbKrvmQLFYoAZQUC5q3flPsE?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@Nt1224_skeb/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3273821, "client_id": 3711841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/194f8437/uploads/origi