6ef-022f-404c-bfaa-8ba2a7f2982f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea0ef7d8f5443b13bf580220c048419a, https://si.imgix.net/392c3d2d/uploads/origins/10b4f6ef-022f-404c-bfaa-8ba2a7f2982f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4dc1f2de397ff040609aa2f339b54997 2x, https://si.imgix.net/392c3d2d/uploads/origins/10b4f6ef-022f-404c-bfaa-8ba2a7f2982f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2de84c9675d8a3265de9972d1eff4a0b 3x"}, "body": "ちょす様\n\n以前はリクエストありがとうございました！\nTRPGの自探索者をお願いしたいです。\n構図やポーズ・服装・髪型など、すべてお任せします！好きに描いてもらって構いません。\n\n以下、設定です。\n\n○華園 楠葉\n由緒正しい感じの高校に通うお嬢様。高校2年生。\n両親が貿易を中心に様々な事業を展開しており、家族と団らんすることは稀。\n習い事や趣味に関する援助などを十分に受けて育っており、両親に対して感謝の気持ちを持っている。\n両親からの期待に応えるべく、普段は品行方正・清廉潔白な立ち振る舞いを心掛けているが、実際のところは好奇心が強く気になる事があればなりふり構わず行動に起こしたくなるわんぱくな性格。\n学校では高嶺の花のような存在で周囲の生徒から特別扱いをされることが多いが、楠葉はその扱いに息苦しさを感じている。\n今日会った他愛ない出来事や、遊びの約束をできるような、自分の身分を気にしない「ただの友人」として接してくれる相手が欲しい、という気持ちが強い。\n\n花のシャクナゲがモチーフ。\n\n資料：\nhttps://www.dropbox.com/scl/fo/4d1cdlsv9epb1czwy28cs/APpmSH9KdJPH7rvwkZzUYrM?rlkey=hfk29i41hvlgcqcfql281fl2k&st=uc03d12o&dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tyosu00/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/94142a09/uploads/origins/22f32753-af44-45d8-8d6c-2caa48e928fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67291f99321dfd085338315112b451d3", "srcset": "https://si.imgix.net/94142a09/uploads/origins/22f32753-af44-45d8-8d6c-2caa48e928fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67291f99321dfd085338315112b451d3, https://si.imgix.net/94142a09/uploads/origins/22f32753-af44-45d8-8d6c-2caa48e928fe?bg