。\nふたりはゲームが好きなのでゲーム機を持たせてもらえたらとてもとても嬉しいです…！もちろん他に素敵な構図がありましたらそちらにしていただいても構いません。\n服装はイラストにもある制服 若しくはdrksさん側で素敵なお洋服をデザインしていただいてもとっても嬉しいです！\n使用用途としては鍵垢で載せる、アイコンにする可能性もありますが基本的には個人鑑賞です。\nもしよければ受けていただけると嬉しいです！これからも引き続きdrksさんを応援しています〜！体調などにお気をつけてお過ごしください！\n\nhttps://drive.google.com/drive/folders/1-8AidZbI2u3JSBD3JxkT_8QLhyJ5g7jJ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dreamkasu/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a7c5a437/uploads/origins/661c79ca-2cbd-49dd-be56-5723df513053?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac9a73ddd7564a7e8cc052ee880c66c0", "srcset": "https://si.imgix.net/a7c5a437/uploads/origins/661c79ca-2cbd-49dd-be56-5723df513053?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac9a73ddd7564a7e8cc052ee880c66c0, https://si.imgix.net/a7c5a437/uploads/origins/661c79ca-2cbd-49dd-be56-5723df513053?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=041338307a9b790f9252196c7ba4cbae 2x, https://si.imgix.net/a7c5a437/uploads/origins/661c79ca-2cbd-49dd-be56-5723df513053?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f0053634917711877f49963b0d85a84 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2791370, "client_id": 2519578, "nc": 144}, {"path": "/@dreamkasu/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fc2472a0/uploads/origins/e0a5d862-43cb-42d7-92e5-64a438fecf71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtf