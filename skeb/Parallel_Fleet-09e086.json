4852205539793/photo/1\nエリナが指で牙の鋭さを試しているような、似たような作品が欲しい。\n\n彼女の歯と牙のリファレンスはこちら：\nhttps://i.imgur.com/1IHfJhy.png\nhttps://i.imgur.com/EH3nhSL.png\nhttps://i.imgur.com/mBtWhWl.jpeg\n\nお時間を割いていただき、また私の要望を考慮していただきありがとうございました！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 356526, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ちくでん（）", "screen_name": "chikuden8201039", "avatar_url": "https://pbs.twimg.com/profile_images/1650168950033100800/mmjfYlf5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2265754338/1659493876/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 586928, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ふかひと/Hukahito", "screen_name": "Hukahito", "avatar_url": "https://pbs.twimg.com/profile_images/1821550484140011520/8xMiFasw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/858330574003384321/1667719015/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 699447, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あん", "screen_name": "ann7dornat", "avatar_url": "https://pbs.twimg.com/profile_images/1604843661405347840/84qZ6vCu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/988633273042534400/1732926756/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "