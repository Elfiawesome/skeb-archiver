lient_id": 2549593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b6a2154/uploads/origins/99e0c855-f8b1-4a92-82c1-d9282cc205ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8e6451c952b659a3984e20d80ff737e", "srcset": "https://si.imgix.net/1b6a2154/uploads/origins/99e0c855-f8b1-4a92-82c1-d9282cc205ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8e6451c952b659a3984e20d80ff737e, https://si.imgix.net/1b6a2154/uploads/origins/99e0c855-f8b1-4a92-82c1-d9282cc205ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d047d4de83d0a7c99da61a27b7cecdc6 2x, https://si.imgix.net/1b6a2154/uploads/origins/99e0c855-f8b1-4a92-82c1-d9282cc205ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16091633c3ebdc975d8c89a9d19c58c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b6a2154/uploads/origins/99e0c855-f8b1-4a92-82c1-d9282cc205ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5194e2ab7e20673625f91f76d8cfa842", "srcset": "https://si.imgix.net/1b6a2154/uploads/origins/99e0c855-f8b1-4a92-82c1-d9282cc205ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5194e2ab7e20673625f91f76d8cfa842, https://si.imgix.net/1b6a2154/uploads/origins/99e0c855-f8b1-4a92-82c1-d9282cc205ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=59d0ffcaa0c9f13996640a09be623a19 2x, https://si.imgix.net/1b6a2154/uploads/origins/99e0c855-f8b1-4a92-82c1-d9282cc205ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed617f1cca769ba270b465525f768748 3x"}, "body": "デボンレックさんリクエスト失礼します。\n\nXでデボンレックスさんが描いたパタちさんや翠燐さんのイラストが好みでして今回リクエスト送らせて頂きました。リクエスト内容はVtuberさんへのファンアートリクエストになります。\n\n【人物】\n個人Vtuber\n雨月紫乃さん（@amatsuki_shino ）\n\n規約、三面図こちらに⤵\nhttps://lit.link/amatsukishino\n既にファンアートをスケブでリクエストさせて頂き雨月さんにお渡ししたりしてます。\n\n【希望構図】\n雨月さんがお酒が好きとのことなので\n「お猪口を持って外を眺めてる雨月さん」をお願いしたいです。正面、横顔どちらでも大丈夫なので描きやすいポーズでお願いしたく\nもしくはデボンレックスさんの自由に雨月さんを描いて頂きたいです。\n背景は無しで\n\n雨月さんのYouTuberのサムネイルなどに使用されると思われますので上下、左右見切れてないイラストでリクエストさせて頂きたいです（尻尾は見切れていても大丈夫です）\n\n【使用用途】\nファンアートのリクエストになりますので雨月紫乃さんご本人さまのみイラストの使用許可をお願いしたく、YouTuberのサムネイルやSNSでのVtuber活動の宣伝などでの使用になると思われます。\n\nご検討して頂けましたら幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@onmoraki418/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2496892, "client_id": 2196935, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c9af2aa/uploads/origins/910b8277-e04c-43e0-b6a9-84ab221f96c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d41dd9953aa9e35546cc39c1ee86479", "srcset": "https://si.imgix.net/1c9af2aa/uploads/origins/910b8277-e04c-43e0-b6a9-84ab221f96c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d41dd9953aa9e35546cc39c1ee86479, https://si.imgix.net/1c9af2aa/uploads/origins/910b8277-e04c-43e0-b6a9-84ab221f96c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39f5f667295c0969d24bd85a2f16e43c 2x, https://si.imgix.net/1c9af2aa/uploads/origins/910b8277-e04c-43e0-b6a9-84ab221f96c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0bf044a34769921569884b801d34bc6f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c9af2aa/uploads/origins/910b8277-e04c-43e0-b6a9-84ab221f96c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6108938a5f5b1bc8aee1b5c23a36bf3f", "srcset": "https://si.imgix.net/1c9af2aa/uploads/origins/910b8277-e04c-43e0-b6a9-84ab221f96c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6108938a5f5b1bc8aee1b5c23a36bf3f, https://si.