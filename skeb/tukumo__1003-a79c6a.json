こちらはなくても大丈夫です！\n\nキャラクターのイメージとしてはバンドリの青葉モカちゃんや広町七深ちゃんです。\nおっとりとしていて芯があるイメージです。\n\n時間もかかり、難しい要求かとは思います…\nお断りしていただいても構いません。\nその場合はアイコン制作に変更していただければと思います！\nキャラデザの詳細は上記の通り変わらずで、服装はダボっとしているものでお願いしたいです！\nアイコンメーカーで作ったキャラを添付しておきます。\nこちらは髪の毛が少し長くなっておりますので、ボブにしていただけるとありがたいです。\nどうぞ、よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1lxA62F5IHiEUSbaCb4vXH5Tth2LRnYB7/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 26348, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "𝑹𝒊𝒐𝒔𝒉𝒊𝒎𝒂🦩", "screen_name": "rosm__ayk", "avatar_url": "https://pbs.twimg.com/profile_images/1833727772445065216/sLZsVq7c.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2472749880/1726057847/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 0}, {"id": 2620286, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "いかわさ🦑(チゲ味)", "screen_name": "Midori_annte23", "avatar_url": "https://pbs.twimg.com/profile_images/1772462509385269248/3WO5dS3i.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1288136668696809473/1711452276/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 110, "skills": [{"genre": "art"}], "nc": 177}, {"id": 2652807, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ⁿᵘˡˡ.", "screen_name": "___null_o", "avatar_url": "https://pbs.twimg.com/profile_images/1892030767515004928/bwMgCH5b.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1515972251874902017/1707318902/1500x500", "appeal_receivable": false, "popular_cr