nre": "art", "tipped": false, "creator_id": 16621, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7650a53/uploads/origins/f7c4395a-09fb-4f7f-873a-f9afc2e89666?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d420ee4be1c3fb5ec0a608383cdba575", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7650a53/uploads/origins/f7c4395a-09fb-4f7f-873a-f9afc2e89666?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e61fcc418a8ac70961a5eb04aa0f4353", "src_set": ""}, "body": "あぶり先生初めまして先生の絵柄が好きですので依頼させていただきたいと思います。\nキャラクター：春雨改2（艦隊これくしょん）\n基本的な構図やイラスト全体の流れなどは先生の書きやすい形で大丈夫です。\nただ、二点だけお願いしたいことがあります。\n1点目が可能であれば構図のどこかで先生が依然出されていた同人誌の懲らしめで書かれていたような上を向いたような顔で舌を突き出しながら精液をぶっかけられている構図をお願いしたいです。\n2点目がこちらも可能ならですが手袋と靴下は脱がさない方向でお願いしたいです。（片方が脱げていたり、脱げかけだったりは大丈夫です）\n何卒ご一考ください。\nよろしくお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aburisamon/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1ae12f3e/uploads/origins/466d2d53-2c89-4b80-a785-7f66400f890b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4bc31f71cea2499937a441fe43403b8e", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 16621, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@aburisamon/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 16621, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d992af74/uploads/origins/4d17e29e