んのセンスを信じていますので、よろしくお願いいたします🙇‍♀️\n\n余力があり、書けたらでよいのですが、おまけみたいな感じで、その会話を後ろでフジキセキとそのトレーナー(映画に出てきた老人)がトレセンでもポッケを慕う子ができて良かったって感動している(泣いているかまでは想像できませんでした…)イラストも見てみたいです…👀\n色々要望が多くてすみません🙇‍♀️\n是非よろしくお願いいたします✨️！！！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tera_ushiro/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2506252, "client_id": 236810, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/732a6de3/uploads/origins/7f0c659c-de53-4350-b4d1-288da4d04304?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d14dedb9a7398b994adb52d30420dc71", "srcset": "https://si.imgix.net/732a6de3/uploads/origins/7f0c659c-de53-4350-b4d1-288da4d04304?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d14dedb9a7398b994adb52d30420dc71, https://si.imgix.net/732a6de3/uploads/origins/7f0c659c-de53-4350-b4d1-288da4d04304?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=593ec88ed29322fece803db9eb12be41 2x, https://si.imgix.net/732a6de3/uploads/origins/7f0c659c-de53-4350-b4d1-288da4d04304?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d957e396ca8edc30ce2fde04ee7e4e8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/732a6de3/uploads/origins/7f0c659c-de53-4350-b4d1-288da4d04304?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80ea5342ed00e1f386d6c4ef707310db", "srcset": "https://si.imgix.net/732a6de3/uploads/origins/7f0c659c-de53-4350-b4d1-288da4d04304?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80ea5342ed00e1f386d6c4ef707310db, https://si.imgix.net/732a6de3/uploads/origins/7f0c659c-de53-4350-b4d1-288da4d04304?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a27e0339dc82aac2876e49