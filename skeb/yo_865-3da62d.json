だけると幸いです、使う場合似たような2面図の方でお願いします)\n姫カットは残していただけると嬉しいです\n\n\n使用用途\nSNSのアイコン、ヘッダー、配信のサムネ、商用利用等\n\n納品形式\nPSD、背景透過\n\nhttps://www.dropbox.com/scl/fo/g6iisyjmi6knji4ox1k4e/h?rlkey=eleij03ccvvbhvragfm4zya69&dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 398853, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "あいれす", "screen_name": "airf14_", "avatar_url": "https://pbs.twimg.com/profile_images/2049201748896845824/RoPuDYQu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1151324478741155841/1745235018/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 75, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 473647, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "まかし", "screen_name": "makashi765", "avatar_url": "https://pbs.twimg.com/profile_images/1369572215629344769/RyMKFEG4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/610635121/1591021139/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 1857970, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🐙", "screen_name": "takoyakitakonu", "avatar_url": "https://pbs.twimg.com/profile_images/1469052311204876289/BPsGxoLP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1448541173933432833/1698214595/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days":