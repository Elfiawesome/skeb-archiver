top&w=200&h=200&blur=200&s=59fc5e77c24f40a8cdd8fc682c161c8e, https://si.imgix.net/b877bd9a/uploads/origins/7155f558-f692-4dd3-9cdb-5026986a6bba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d548d2f2c58cc8de86a862cbba617680 2x, https://si.imgix.net/b877bd9a/uploads/origins/7155f558-f692-4dd3-9cdb-5026986a6bba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1a4da0fe7dd49e2a54439349c8419e48 3x"}, "body": "はじめまして、もし可能であればOCの衣装デザインをお願いしたいです。\nこずみ様の自由に描いていただけると嬉しく思います。\n\n金額に不備があればお手数をお掛けしますが再送をお願いいたします。ご検討のほどよろしくお願いします。\n\n【性格など】\n・幼少期に手を差し伸べられた人間一人に強く執着しており、それ以外の物事には全く興味が無い\n・超常現象を解明する組織のトップ\n・天才\n・掴み所がない\n\nhttps://drive.google.com/drive/folders/10D6v3CXPHtew7NTpq5B6-AAlQ9rkV3_w", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cosmicozue/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1036426, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83e5ceeb/uploads/origins/2a30f2cf-24d2-4b3b-b653-f3b20bee286c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1044bf573bf1bc1e1aef61ea9ba96b5", "srcset": "https://si.imgix.net/83e5ceeb/uploads/origins/2a30f2cf-24d2-4b3b-b653-f3b20bee286c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1044bf573bf1bc1e1aef61ea9ba96b5, https://si.imgix.net/83e5ceeb/uploads/origins/2a30f2cf-24d2-4b3b-b653-f3b20bee286c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59e0f302a872f58f3ef28afb0ca29909 2x, https://si.imgix.net/83e5ceeb/uploads/origins/2a30f2cf-24d2-4b3b-b653-f3b20bee286c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d81b1e96a34cfdb6a939bb8666044cfb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83e5ceeb/uploads/origins/2a30f2cf-24d2-4b3b-b653-f3b20bee286c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5ba13b22094a9ac4445ab3e05471cdf", "srcset": "https://si.imgix.net/83e5ceeb/uploads/origins/2a30f2cf-24d2-4b3b-b653-f3b20bee286c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5ba13b22094a9ac4445ab3e05471cdf, https://si.imgix.net/83e5ceeb/uploads/origins/2a30f2cf-24d2-4b3b-b653-f3b20bee286c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a4fc3adb6a929c28b4b722f73aca3b9a 2x, https://si.imgix.net/83e5ceeb/uploads/origins/2a30f2cf-24d2-4b3b-b653-f3b20bee286c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=103ecd89cd77ca96145909369825a681 3x"}, "body": "こんにちは。先生の作品は素晴らしいです!!!私のOCの全身イラストを描いてもらえると嬉しいです。\n\n【OC】\n•年齢と外見の特徴：20歳前後、少女と青年の中間で、少女寄りです。目の形はたるみの幅が小さい垂れた目です。髪はリネンやミルクティーブラウン、毛先はカールしています。\n\n•性格のキーワード：\n-ちょっと天然ボケ/一人が好き/過激な個性とネガティブな感情を隠し\n-人見知りしますが落ち着いたふりをします/冷たく見えるが、人を信じやすい/人と親しくなりたい、自分を守ることを避けている/聞き上手ですが、むしろ語り手になりたい\n\n*趣味：お気に入りのカチューシャを集める、髪飾りや髪型を変える、スイーツを食べる、のんびりする日、新しい場所を発見と探索などする。\nhttps://drive.google.com/drive/folders/1N5Vv6GsK_86upYDqHMHpiXrY45v1YNuh\n\n【内容】\n•衣装：こちらのリンクにあるような衣装デザインをご依頼したいです。(ヘアスタイルを変えてもいいです。基本おまかせで、お洋服を着せていただきたいです…！）\nhttps://x.com/i/status/2080979922978476453\n\n•新しいパロ ：好きなパロを描いていいし、想像して新しいパロを展開してもいいです！ご自由に作成してください。\n\n【その他】\n-可能であれば納品はPSD・宛名(花びら)などは別レイヤーでお願いします。\n-PSDに線画や練習絵、没ラフ等があれば入れてくれると嬉しいです！\n-よろしければご一考お願いいたします！楽しんで頂けたら嬉しいのです、 ありがとうございました！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cosmicozue/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1036426, "client_id": 3802998, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01cfe9e6/uploads/origins/45257e10-4a3b-4cc5-9659-c91d090aa63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72d3bce07ec3617b0fea2782acbcb667", "srcset": "https://si.imgix.net/01cfe9e6/uploads/origins/45257e10-4a3b-4cc5-9659-c91d090aa63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72d3bce07ec3617b0fea2782acbcb667, https://si.imgix.net/01cfe9e6/uploads/origins/45257e10-4a3b-4cc5-9659-c91d090aa63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97957ca65bbe419a9542ef6570dcb252 2x, https://si.imgix.net/01cfe9e6/uploads/origins/45257e10-4a3b-4cc5-9659-c91d090aa63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fead8f2c0ed01be09e90307820383170 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01cfe9e6/uploads/origins/45257e10-4a3b-4cc5-9659-c91d090aa63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8a52b1c77b96a7762c3b9c2b7425069", "srcset": "https://si.imgix.net/01cfe9e6/uploads/origins/45257e10-4a3b-4cc5-9659-c91d090aa63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8a52b1c77b96a7762c3b9c2b7425069, https://si.imgix.net/01cfe9e6/uploads/origins/45257e10-4a3b-4cc5-9659-c91d090aa63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e35400db0034ce36bb5c9e8a48faee0 2x, https://si.imgix.net/01cfe9e6/uploads/origins/45257e10-4a3b-4cc5-9659-c91d090aa63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=32f56fce6de1be7054afbec0fc2bbd09 3x"}, "body": "お世話になっております。\nこずまちさんの描かれる服飾のデザインから感じられる独特な世界観が大好きです。この度は、私の創作キャラクターの服をこずまちさんにデザインしていただきたく、リクエストをお送りいたしました。\nご多忙のところ恐れ入りますが、ご検討いただけましたら幸いです。\n\n【キャラクターについて】\n・名前は「雨飼 譜斿（あめが ふる）」です。22歳の私小説作家です。\n・他人への関心が薄く、非常に無愛想で捻くれた冷笑家です。\n・一人称は「僕」。落ち着いた口調で淡々と話しますが、皮肉や冷笑を交えることが多く、言葉で感情を語ることを嫌います。\n・苛立ちや不安を覚えると首を掻き毟る癖があります。母親に似た自分の顔、とりわけオリオン座のように並んだホクロを強く嫌っています。\n・趣味はジャム作り、ペン習字、折り紙です。骨董品や老舗文具店を好み、手順や手触りのある物を愛用しています。\n・学生時代に出会った「同級生の絵」とその出来事へ執着しており、それを題材に私小説を書き続けています。\n\nご自由に描いていただけましたら幸いです。\n\n暑い日が続きますが、どうぞお身体にお気をつけてお過ごしください。\n\nhttps://drive.google.com/drive/folders/1Jx7iTqXuUoXw0yxFR2DR0JAL0ybpiGbj", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cosmicozue/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1036426, "client_id": 2619143, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be1e9d40/uploads/origins/5c6cedb2-0374-4c83-875f-f8d4e87b26e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d8c887e86b843c23fd70ccb36289d27", "srcset": "https://si.imgix.net/be1e9d40/uploads/origins/5c6cedb2-0374-4c83-875f-f8d4e87b26e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d8c887e86b843c23fd70ccb36289d27, https://si.imgix.net/be1e9d40/uploads/origins/5c6cedb2-0374-4c83-875f-f8d4e87b26e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bed5e08e1711c4f1fb3344f2d42d8cf 2x, https://si.imgix.net/be1e9d40/uploads/origins/5c6cedb2-0374-4c83-875f-f8d4e87b26e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e043f0c13febf744ad202733b6ae6ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be1e9d40/uploads/origins/5c6cedb2-0374-4c83-875f-f8d4e87b26e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00d28df76c5f209e2347a46f129ac9a9", "srcset": "https://si.imgix.net/be1e9d40/uploads/origins/5c6cedb2-0374-4c83-875f-f8d4e87b26e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00d28df76c5f209e2347a46f129ac9a9, https://si.imgix.net/be1e9d40/uploads/origins/5c6cedb2-0374-4c83-875f-f8d4e87b26e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1436c5a52872c609f827fdf74ff886eb 2x, https://si.imgix.net/be1e9d40/uploads/origins/5c6cedb2-