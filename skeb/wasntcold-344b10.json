38792、https://www.pixiv.net/en/artworks/106020444。\n\n番目の参考文献と同様に、アレックスが拘束され、鬼として封印されるのを見たい。アレックスの口を封印紙で塞ぎ、猿ぐつわをしてほしい。また、アレックスを金属製のギベットに閉じ込め、どこかの神社か悪魔の牢獄に吊るしてほしい。\n\nギベットと一緒にどんな緊縛もアーティストの裁量に任せる。アレックスはギベットの下でミイラ化されているかもしれないし、ギベットの上に余分なロープがあるかもしれないし、アレックスはその下でゴム製のミイラに閉じ込められているかもしれないし、他の何かかもしれない。私はあなたの芸術的なビジョンを信頼している。\n\nありがとう！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wasntcold/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2617497, "client_id": 78111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ef5b82f/uploads/origins/8e7bb87d-211e-4a9a-81cf-787e92eb3918?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad10141b6fb61541534017a21e48325f", "srcset": "https://si.imgix.net/9ef5b82f/uploads/origins/8e7bb87d-211e-4a9a-81cf-787e92eb3918?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad10141b6fb61541534017a21e48325f, https://si.imgix.net/9ef5b82f/uploads/origins/8e7bb87d-211e-4a9a-81cf-787e92eb3918?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=745e7aa7b4d4d21ba0e063ce625c5a83 2x, https://si.imgix.net/9ef5b82f/uploads/origins/8e7bb87d-211e-4a9a-81cf-787e92eb3918?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d479b523c842346b064ee1fdeaf0771 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ef5b82f/uploads/origins/8e7bb87d-211e-4a9a-81cf-787e92eb3918?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=768acc2f62754be082f1e545f15583ba", "srcset": "https://si.imgix.net/9ef5b82f/uploads/origins/8e7bb87d-211e-4a9a-81cf-787e92eb3918?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=768acc2f62754be082f1e545f15583ba, https://si.imgix.net/9ef5b82f/uploads/origins/8e7bb87d-211e-4a9a-81cf-78