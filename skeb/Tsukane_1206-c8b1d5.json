をかけています。好きな色は黄色で、好きな花はヒマワリです。\nhttps://x.com/latitudraw/status/1967918279017763088?s=20 であなたの作品を見ましたが、その雰囲気と黄色い照明がとても気に入りました。 可能であれば、同じような雰囲気で、薄暗いジャズクラブやバーを舞台に、彼がマイクスタンドを持って歌っているような作品を依頼したいです。風景画のような構図が理想的です。ポーズや表情はあなたにお任せします！\n用途：個人利用です。FAタグを付けて作品を投稿する際は、あなたのIDを記載します。\n本当にありがとうございます！（価格の調整が必要な場合は、お知らせください！）\n\nhttps://drive.google.com/drive/folders/1m2-w8C5HsKo3Pcn66zwZjiB8WBRA8mAx?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tsukane_1206/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 699343, "client_id": 3751407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a4f2b76/uploads/origins/ec4a7203-367d-421b-bd99-1bbd2dd1395f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f90bbddbd498c607f9dad057390e92ea", "srcset": "https://si.imgix.net/8a4f2b76/uploads/origins/ec4a7203-367d-421b-bd99-1bbd2dd1395f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f90bbddbd498c607f9dad057390e92ea, https://si.imgix.net/8a4f2b76/uploads/origins/ec4a7203-367d-421b-bd99-1bbd2dd1395f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2be77404b5c4d1235cdfc82dcd0e504 2x, https://si.imgix.net/8a4f2b76/uploads/origins/ec4a7203-367d-421b-bd99-1bbd2dd1395f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=933850ca62acd17621ccfdf3b30fe022 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a4f2b76/uploads/origins/ec4a7203-367d-421b-bd99-1bbd2dd1395f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=edcfd5b3af289f55fb22db20138c7338", "srcset": "https://si.imgix.net/8a4f2b76/uploads/origins/ec4a7203-367d-421b-bd99-1bbd2dd1395f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=edcfd5b3af289f55fb22db2013