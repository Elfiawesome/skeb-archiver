LkPDvEJEs8LBdurrQDi", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tsukane_1206/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 699343, "client_id": 3425850, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3744c5b4/uploads/origins/64f3e1c0-3995-457d-96ba-6b6653e05d9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e9200fb1627db1b9d76bb993428f9e0", "srcset": "https://si.imgix.net/3744c5b4/uploads/origins/64f3e1c0-3995-457d-96ba-6b6653e05d9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e9200fb1627db1b9d76bb993428f9e0, https://si.imgix.net/3744c5b4/uploads/origins/64f3e1c0-3995-457d-96ba-6b6653e05d9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9a75bb15114ccc0fc1726343439fd33 2x, https://si.imgix.net/3744c5b4/uploads/origins/64f3e1c0-3995-457d-96ba-6b6653e05d9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee396706972c41af2883d0f7a9ecff7d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3744c5b4/uploads/origins/64f3e1c0-3995-457d-96ba-6b6653e05d9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c049ad54d4cbf87a04cc26c8dbebb68d", "srcset": "https://si.imgix.net/3744c5b4/uploads/origins/64f3e1c0-3995-457d-96ba-6b6653e05d9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c049ad54d4cbf87a04cc26c8dbebb68d, https://si.imgix.net/3744c5b4/uploads/origins/64f3e1c0-3995-457d-96ba-6b6653e05d9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f430d0c083a5f96adbb5116c234ff6d9 2x, https://si.imgix.net/3744c5b4/uploads/origins/64f3e1c0-3995-457d-96ba-6b6653e05d9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64135eca6cd343995669ed884446227e 3x"}, "body": "こんにちは、あなたの絵が大好きで、私のOCのイラストをお願いしたいのです。\n\n外見：ピンクの髪、ヤンデレ、メンヘラ、天使の羽。\nhttps://drive.google.com/drive/folders/1gPCwfqVPnLRCtUt35rFeEj2VufWGH3Ou\n\n\n経歴：限界空間、ホラー。\nこのイラストの雰囲気がとても好きです：\nhttps://x.com/latr06/status/1905185200214298949?s=61&t=kOnMNo8wYZnRzMqX8WfjEQ\nhttps://x.com/latR06/status/1912761678066032750", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tsukane_1206/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 699343, "client_id": 615695, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e712774d/uploads/origins/0aa3e282-da4b-4126-837f-a9431a453f40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f43850caf7197c9b21f04711759451ea", "srcset": "https://si.imgix.net/e712774d/uploads/origins/0aa3e282-da4b-4126-837f-a9431a453f40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f43850caf7197c9b21f04711759451ea, https://si.imgix.net/e712774d/uploads/origins/0aa3e282-da4b-4126-837f-a9431a453f40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a3b7327f068013fb4a10864bde40cab 2x, https://si.imgix.net/e712774d/uploads/origins/0aa3e282-da4b-4126-837f-a9431a453f40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37a9ec826f6a900a9bd480260b83ed99 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e712774d/uploads/origins/0aa3e282-da4b-4126-837f-a9431a453f40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a02270e2227bce124f4145750aa0dc9d", "srcset": "https://si.imgix.net/e712774d/uploads/origins/0aa3e282-da4b-4126-837f-a9431a453f40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a02270e2227bce124f4145750aa0dc9d, https://si.imgix.net/e712774d/uploads/origins/0aa3e282-da4b-4126-837f-a9431a453f40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c92bc81566a1deb74330cf890c96b1b 2x, https://si.imgix.net/e712774d/uploads/origins/0aa3e282-da4b-4126-837f-a9431a453f40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d354e811c23e5f1d5faec9facbdbfb14 3x"}, "body": "こんにちは。あなたの作品はとても素敵ですね。もしご面倒でなければ、絵のリクエストをお送りしたいのですが。\n\nhttps://imgur.com/a/FJ2331k。\n\n(1) エノク https://imgur.com/a/HDJuE4W\n几帳面。真面目そうだが、見かけによらずずる賢い。見かけによらずのんきだが、成功への基準も高い。\n(2) トリス https://imgur.com/a/rA9iTSk\nルーキータイプ。一番になりたがる。友好的だが、内心は意地悪。怒りっぽい。\n\nキャラデザに若干の矛盾がありますので、ご自由にどうぞ。\n\n二人はロックバンドのバンド仲間。エノクがドラムを叩き、トリスが歌いながらギターを弾く。エノクはトリスにギターの弾き方も教えている。二人とも、伝統的なパンクスには見えないが、社会規範を拒否するパンクスである。例えば、トリスは品行方正なカリスマ青年に見え、エノクは金持ちの跡継ぎに見える。トリスはエノクの家に居候する。面白いことに、二人は正反対だが、仲がいい。とても仲の良い相棒なのだ。\n\nもしご迷惑でなければ、構図を決めていただけないでしょうか。バンドのライヴ中とか、一緒に食事しているところとか、散歩しているところとか、ライヴのためにドレスアップしているところとか......。都会でバカ騒ぎする2人の若者の雰囲気が出ている。彼女も家族もいない、見通しもない、ただ好き勝手にやっている。\n\nよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tsukane_1206/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 699343, "client_id": 1213948, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8eca6cc0/uploads/origins/e16b5eab-68d7-452d-af07-60ebad6eba6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2504c39d1df9bb514eeffc5adb9ebd66", "srcset": "https://si.imgix.net/8eca6cc0/uploads/origins/e16b5eab-68d7-452d-af07-60ebad6eba6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2504c39d1df9bb514eeffc5adb9ebd66, https://si.imgix.net/8eca6cc0/uploads/origins/e16b5eab-68d7-452d-af07-60ebad6eba6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59763e3fa2739ad3a168396f7eb38c05 2x, https://si.imgix.net/8eca6cc0/uploads/origins/e16b5eab-68d7-452d-af0