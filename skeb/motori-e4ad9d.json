=200&h=200&s=5e876624b85690ab4a977454e4289c94 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99eee25e/uploads/origins/725a5ab9-7041-470d-a8ea-a4d6edfd6a85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=afc3f9716d2820bfce51ab269102469c", "srcset": "https://si.imgix.net/99eee25e/uploads/origins/725a5ab9-7041-470d-a8ea-a4d6edfd6a85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=afc3f9716d2820bfce51ab269102469c, https://si.imgix.net/99eee25e/uploads/origins/725a5ab9-7041-470d-a8ea-a4d6edfd6a85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3d8765ab531331cedfadc0d8f80551d7 2x, https://si.imgix.net/99eee25e/uploads/origins/725a5ab9-7041-470d-a8ea-a4d6edfd6a85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5ff3ad363e7c60e88d19df039f329964 3x"}, "body": "アイコンのもふもふこおりどらごんの紹介三面図\n足は獣よりだけどどらごんな感じー(今の足に合わせた感じ)\n二足の立ち絵だといいなー\n\n以下説明やイメージ・・・(材料にどうぞ)\nこおりや冷気、吹雪を自在にあやつれるー流氷の海や凍った湖でも平気でおよげるーかなりおおきいけど友好的、普段は冷気を纏っているから冷たくて危ない・・・けど近寄った生き物に気が付くと冷気を放してようすをみてくる。冷気のない状態のもふもふはひんやりしてるけどうもれてるうちにちょっとだけ温かくなる(ふゆばのもうふみたいな)\n冬が来ると北の空から北風とともにやってくるのでフユヨビと呼ばれている。がちゃんとした名前があるっぽいけどこっちも古すぎて分からない・・・\n空を飛ぶと氷が舞ってきらきらしてきれい・・・\nもとりさん世界だと寒いところにのんびり住んでいる魔法も使えるみたい\n使ってる言葉が大昔のなので分かる人がいないらしく大体鳴き声で感情をあらわしてくる\n最近は現代のことばをまねし始めた(あそべ！ふかふか！ふわふわ！など)", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@motori/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1047438, "client_id": 2376529, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2038759f/uploads/origins/c64e22c0-013a-4c5a-a3ec-ce9d300d9c55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f97427e5eca344e636d153a71c5aafb", "srcset": "https://si.imgix.net/2038759f/uploads/origins/c64e22