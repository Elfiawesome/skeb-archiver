er": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@fenomnnnnnnn/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 203921, "client_id": 763899, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc924168/uploads/origins/7e01c9a3-562c-422b-8c2b-9de4e60f05f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ebfbce524968cc1b0e9c62fe9a00cce", "srcset": "https://si.imgix.net/fc924168/uploads/origins/7e01c9a3-562c-422b-8c2b-9de4e60f05f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ebfbce524968cc1b0e9c62fe9a00cce, https://si.imgix.net/fc924168/uploads/origins/7e01c9a3-562c-422b-8c2b-9de4e60f05f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb0696c348de20ebfb3b3015a9b1083d 2x, https://si.imgix.net/fc924168/uploads/origins/7e01c9a3-562c-422b-8c2b-9de4e60f05f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a1aead2db23637944ab49e19207240b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc924168/uploads/origins/7e01c9a3-562c-422b-8c2b-9de4e60f05f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b089fb631b4d636e5b5b9e3c72958f93", "srcset": "https://si.imgix.net/fc924168/uploads/origins/7e01c9a3-562c-422b-8c2b-9de4e60f05f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b089fb631b4d636e5b5b9e3c72958f93, https://si.imgix.net/fc924168/uploads/origins/7e01c9a3-562c-422b-8c2b-9de4e60f05f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=026bac56de52d41a80bd11bc57251c1e 2x, https://si.imgix.net/fc924168/uploads/origins/7e01c9a3-562c-422b-8c2b-9de4e60f05f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3c70a38e374d43f0373951be270e36a 3x"}, "body": "Feさんに描いていただきたく、リクエストをさせていただきました。\n『ソードアート・オンライン（SAO）』のシノンのリビングスタチュー化・メタル化をお願いします。\n正月のお題箱がとても良かったので、その後のIFストーリーという展開で。\nhttps://twitter.com/fenomnnnnnnn/status/1611666452628619266\n\n要望：\n・瞳はあり\n・性器の描写はモザイクや黒塗りが不要なレベル\n・激しくキャラ崩壊しているので記憶・人格などは改造によってリセットされてしまっているという設定で\n\nシチュエーションとセリフ：\n1枚目：\n全裸で虚ろな表情のまま力なく棒立ち待機。\n「ご購入いただきありがとうございます。S-LS（スレイブ・リビングスタチュー）シリーズ識別番号003、素体名シノンです。どうぞ何なりとご命令を、マスター」\n「目を隠して如何なさいましたか、マスター？……”どうして服を着ていないのか”、ですか？申し訳ありません。展示会で装備していたものは店の支給品でしたのでご購入の際に返却致しました。そちらも併せてご購入いたしますか？”一緒に買った服で良いからいらない”…かしこまりました」\n「呼称の変更ですか？それではどのような呼称でお呼びを……”普通に名前で”、ですね。かしこまりました、キリト様。……”キリトで良い”、ですか？」\n\n2枚目：\n元の衣服を着用して披露する。\n「ご命令通り、私と一緒にご購入したこちらの衣服一式を装備してみました。いかがでしょうか？」\n「私の感想ですか？動きを阻害せず、防御面も低くないので総合的な評価は悪くです。……それ以外、ですか？これといって特には。第一に私に装備する意味はあなたへの鑑賞目的以外にはありませんので。」\n「……どうかなさいましたかキリト？なぜ表情を歪めてるのですか？どこか具合が悪いのですか？」\n\n3枚目：このページから以降は瞳（瞳孔）に光が宿る。光は翡翠色で中央が空色\n目が覚めると全裸で添い寝して頬に手を添えてこちらを見ているシノン。\n「お目覚めですか、キリト？おはようございます。申し訳ありません。昨晩は体調が優れなかったようなので、勝手ながら経過を確認させていただきました。体調は…回復しているようでなによりです。それでは起床の準備を……”もう少しだけこのまま”…私も一緒に、ですか？…あなたが、望んでくれるなら」\n「……ありがとうございます」（小声）\n\n4枚目：\n一緒にベッドに腰かけてホログラムモニターで該当商品を表示させてそれを見せてくる。\n服装はアニメ本編のような下着着用。下記参照\nhttps://i.pinimg.com/736x/8d/84/33/8d84337810145aebeedb3fab0492ecd7.jpg\n「キリト、こちらの【メタルコート】も追加発注したいのですがよろしいでしょうか？……ありがとうございます」\n「”どの装備に使うのか”、ですか？こちらは私自身に使おうと考えています。近接格闘、物理防御も向上し、よりあなたへのサポートが可能になります」\n「それに……あなたに…変わった私を……見てほしくて……」（小声）\n\n5枚目：ここから残りのページはメタル化\nコーティングが終わり、全身メタル化した姿をお披露目している。（全裸）\n「コーティング処理、完了しました。いかがでしょうか？……キリト、申し訳ありませんが見ていただかなければ確認ができません」\n「”とても綺麗な姿”…ですか？」\n「…塗り残しがないかの確認で聞いたのですが……」\n「でも……その感想は…良い、です」\n\n6枚目：\n電極パッドのネックレスをシノンに返す。シノンの目元から涙が零れる。\n服装は下着着用。\n・ネックレス↓\nhttps://hivicon.com/wp-content/uploads/2020/08/sao-alicization-anime-200802-43795.jpg\n「これは……本来の私が大切にしていたというのは、分かります。でも…あなたの知っている私ではない私が持っていては……」\n「それでも…私が、持っていても……？」\n「私……どうして…涙が……？嬉しい…から……？」\n「ありがとうございます、キリト……。私が大切にしていた物を…あなたから渡してもらえたことが……なによりも嬉しい、です」\n\n7枚目：\n恍惚さが入った幸せそうな微笑み（目は細めず）で涙と愛液を流し続ける。\n服装は全裸でネックレスのみ装着。\n・ベースポーズ↓\nhttps://booth.pximg.net/a5bc3e23-811f-47e9-8d4c-1975ae232ce5/i/2160822/063c2485-35c9-4201-8204-8e3b56f5ed7e.png\n・手の向き↓\nhttps://genkosha.pictures/wp-content/uploads/2019/02/0119.jpg\n「あなたの力になれて…あなたと一緒にいられて…私……今、幸せです」\n「あなたが【アスナ】という方を取り戻す為にも、どうかこれからも…あなたが望むままに私を使ってください」\n「あなたを想い続けることを……どうか許してください」\n「愛しています……キリト」\n\n備考：\n・1枚目、5枚目、7枚目は頭から足の先までの全身描写で\n\n可能ならやっていただきたい内容：\n・各ページのセリフ無し差分\n・1枚目のメタル化差分\n・1枚目の涙、涎、愛液差分\n・1,2枚目の瞳発光あり差分\n・3枚目のメタル化差分\n・3枚目以降の瞳発光なし差分\n・5枚目の石化差分\n・7枚目の石化差分\n・7枚目の涙、愛液なし差分\n\n要望内容が多く大変申し訳ございません。\nご検討のほどよろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fenomnnnnnnn/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 203921, "client_id": 941736, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1a1fdf4/uploads/origins/28c4a19e-230e-45e8-a567-14c8e11349a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38b441294468441257b131e20fd73a8b", "srcset": "https://si.imgix.net/e1a1fdf4/uploads/origins/28c4a19e-230e-45e8-a567-14c8e11349a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38b441294468441257b131e20fd73a8b, https://si.imgix.net/e1a1fdf4/uploads/origins/28c4a19e-230e-45e8-a567-14c8e11349a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39e1b780c381fb712a5ff29658f8dbf7 2x, https://si.imgix.net/e1a1fdf4/uploads/origins/28c4a19e-230e-45e8-a567-14c8e11349a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0e73e7d32037e032fe85590e752fd04 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1a1fdf4/uploads/origins/28c4a19e-230e-45e8-a567-14c8e11349a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a7b71ef960edbaa0dc5f36c879f19ae