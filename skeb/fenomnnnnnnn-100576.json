d4-47fe-99cb-f75c2b453608?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9dd5c23d39d88f122a65094cf9c8c1a 2x, https://si.imgix.net/546d71bc/uploads/origins/92e626e4-86d4-47fe-99cb-f75c2b453608?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6695c2df91bd054b2380b73eafeaf2a 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/546d71bc/uploads/origins/92e626e4-86d4-47fe-99cb-f75c2b453608?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd3242e91243086884aab6610ce4f067", "srcset": "https://si.imgix.net/546d71bc/uploads/origins/92e626e4-86d4-47fe-99cb-f75c2b453608?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd3242e91243086884aab6610ce4f067, https://si.imgix.net/546d71bc/uploads/origins/92e626e4-86d4-47fe-99cb-f75c2b453608?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bf26bb8213257b0c3a136d1df6a3350c 2x, https://si.imgix.net/546d71bc/uploads/origins/92e626e4-86d4-47fe-99cb-f75c2b453608?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f1e5217b8f2ab11559e30df7122752a6 3x"}, "body": "こちらでは、始めまして！\nFeさんにスケブ依頼を失礼させていただきます\nこちらのSS　\nhttps://skeb.jp/@eromonji/works/17\nのTwitterでの挿絵イラストをお願いしてもよろしいでしょうか？\n2番目の壊滅所のメインストリートでドライアドたちの群れに敗北して\n樹木の一部としてぽっこりお腹で樹木の一部されてしまう姉妹をお願いします。\nイメージは\nhttps://www.dropbox.com/sh/8zjc9t4mhetgyjm/AAD8294_VfKqfOYlz01OPFVva?dl=0\nのFeさんイラストを基に　右側にシエルちゃんを追加する感じでお願いします。\nポーズ等は基本SSとイラストを元イメージ感じでご自由にお願いします。\nまた別資料お送りしたぽっこりまん丸ボテ腹な感じお腹はして貰いたいです。\nさらにお胸の形状がとても素敵でしたのでこのままを希望します。\nその他に　差分として種や樹液を描き足した　\n種が産み落とされている差分シーンがあるのを希望します。\n\nもしも　変化前ページを描いて貰えるなら木に埋め込まれて同化しかけてるコマがあると嬉しいです（料金的に割に合わない場合省いてもらっても構いません）\n\n以上です\nどうかよろしくお願いします_(._.)_\n\nhttps://www.dropbox.com/sh/8zjc9t4mhetgyjm/AAD8294_VfKqfOYlz01OPFVva?dl=0", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fenomnnnnnnn/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 203921, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f07fdec2/uploads/origins/d6eebdde-eff3-4483-9536-5ef563d325c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd0047676febf9993ac1ac82a3ae4320", "srcset": "https://si.imgix.net/f07fdec2/uploads/origins/d6eebdde-eff3-4483-9536-5ef563d325c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd0047676febf9993ac1ac82a3ae4320, https://si.imgix.net/f07fdec2/uploads/origins/d6eebdde-eff3-4483-9536-5ef563d325c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e2335ac4992cbdf265caeb8aecb181a 2x, https://si.imgix.net/f07fdec2/uploads/origins/d6eebdde-eff3-4483-9536-5ef563d325c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fae21ce2453d7eda1841322e4d9de09b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f07fdec2/uploads/origins/d6eebdde-eff3-4483-9536-5ef563d325c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=273beb738d25d38ef900344c1adfa4f0", "srcset": "https://si.imgix.net/f07fdec2/uploads/origins/d6eebdde-eff3-4483-9536-5ef563d325c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=273beb738d25d38ef900344c1adfa4f0, https://si.imgix.net/f07fdec2/uploads/origins/d6eebdde-eff3-4483-9536-5ef563d325c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=25945e1b047db71bf3914364d3669296 2x, https://si.imgix.net/f07fdec2/uploads/origins/d6eebdde-eff3-4483-9536-5ef563d325c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eeb8fa8d82d2bdde5077eecf5e43e879 3x"}, "body": "かぐや様は恋らせたいより藤原千花、四宮かぐや(二人とも水着)の蝋固めをお願い致します\n富豪達が集まるナイトショーにて満杯の蝋で貯まっている釜の上で鎖で吊るされていて何度も蝋で浸されていて蓑虫の様になっていてほぼ固められてしまっているがまだ生きており(んぐ・・・んん・・・)と僅かに軋みながら抵抗して呻いた声しかが出せない千花、表情は怯えている\n\n蝋釜の中には厚塗りされて表情がなんとか分かるレベルの蝋塊と化した(四宮かぐや、表情は怯えており助けを願う表情、両手は鎖で吊るされている)が浸されている状態。フィナーレと共に千花にとどめを刺し、全身を蝋釜に浸す(んぐ・・・んんーっ！！)\n\n二枚目は蝋の塊と化した千花ちゃんをお願い致します\n状態はのっぺらぼうと化しており胸を強調させるカメラワークでお願い致します\n\nhttps://www.dropbox.com/sh/ex0s62xzm6ug7dw/AABaq-kR6ONY3m-V-EFMzoJHa?dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fenomnnnnnnn/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 203921, "client_id": 662639, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4fd54982/uploads/origins/7abcaa12-72a5-429d-a53a-cd61d14eea0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b699a47eb9fc3dd1c903d19c5c982bff", "srcset": "https://si.imgix.net/4fd54982/uploads/origins/7abcaa12-72a5-429d-a53a-cd61d14eea0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b699a47eb9fc3dd1c903d19c5c982bff, https://si.imgix.net/4fd54982/uploads/origins/7abcaa12-72a5-429d-a53a-cd61d14eea0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b44e0c19b9a137fdb8d12d2c24038d94 2x, https://si.imgix.net/4fd54982/uploads/origins/7abcaa12-72a5-429d-a53a-cd61d14eea0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2b31dcf8d32cec456e0d6b69ecbf4ee 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4fd54982/uploads/origins/7abcaa12-72a5-429d-a53a-cd61d14eea0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f5fd2857679f19a12cb7fc254899eb0", "srcset": "https://si.imgix.net/4fd54982/uploads/origins/7abcaa12-72a5-429d-a53a-cd61d14eea0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f5fd2857679f19a12cb7fc254899eb0, https://si.imgix.net/4fd54982/uploads/origins/7abcaa12-72a5-429d-a53a-cd61d14eea0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7931552521814dd4c08a6e9e49181205 2x, https://si.imgix.net/4fd54982/uploads/origins/7abcaa12-72a5-429d-a53a-cd61d14eea0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd3ec622610c9c31473385c865f5f46f 3x"}, "body": "前回ははぐむちゃんの石化破壊のイラストをありがとうございました。その中で時雨ちゃんの名前を呼ぶのがすごく良くて時雨ちゃんの石化破壊も見たくなってしまったのでリクエストをさせてもらいます。\n\n前回のはぐむちゃんと同じような感じで、時雨ちゃんが敵に怯えたような表情で石化させられたあとバキっと破壊されちゃった感じでお願いします。細かい構図等は自由にしてもらって大丈夫です。\n今回も可能だったら破壊される前の状態もあると嬉しいです。\n\nhttps://dengekionline.com/images/YTQI/U7Hw/Q0F6/mRGk/7GvcgwLsLDeqjX7A3Ed4q22DwTYpuXR7hLVqrffVEo8FTAscPhWMLWHCHrp7CmREOukurpLFHcgXnNz4.jpg", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fenomnnnnnnn/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 203921, "client_id": 344588, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83015568/uploads/origins/158ebe95-df8a-4e1d-848a-26128aa27795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65dab1a12bebfcf4773b52f0d85b6743", "srcset": "https://si.imgix.net/83015568/uploads/origins/158ebe95-df8a-4e1d-848a-26128aa27795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65dab1a12bebfcf4773b52f0d85b6743, https://si.imgix.net/83015568/uploads/origins/158ebe95-df8a-4e1d-848a-26128aa27795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f18ffeb596e76d6f2bc330a4b236b0c 2x, https://si.imgix.net/83015568/uploads/origins/158ebe95-df8a-4e1d-848a-26128aa27795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f4854cab36dbbaf74d4d2d0cd6b5aff 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83015568/uploads/origins/158ebe95-df8a-4e1d-848a-26128aa27795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81ec3f1ab8bd8357c4393939976dd4ea", "srcset": "https://si.imgix.net/83015568/uploads/origins/158ebe95-df8a-4e1d-848a-26128aa27795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81ec3f1ab8bd8357c4393939976dd4ea, https://si.imgix.net/83015568/uploads/origins/158ebe95-df8a-4e1d-848a-26128aa27795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f46c6f48ef4e6b00440b2dc6d971f0d 2x, https://si.imgix.net/83015568/uploads/origins/158ebe95-df8a-4e1d-848a-26128aa27795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f3714b49719ac396aaa33e727b958bfa 3x"}, "body": "前回はありがとうございます、今回もよろしくお願いします\nラストピリオドのミルティがこちら（https://twitter.com/fenomnnnnnnn/status/1238747170234183681）のガーゴイルに襲われてエロ無様に石化されるシチュをお願いします\nミルティは腹ボコされながら犯されてアヘ顔を晒しており、衣服は破り捨てられてソックスはボロボロの形で、他の身に着けているもの有無についてはお任せ（それらも含めて衣服など身に着けているもの全て石化）、男性器も勃起したままの形で石化\n変化途中（進行度はお任せ）と完全石化（腹ボコ跡を残す形で）と、可能であれば事後の棄てられた差分もお願いします\n今回も男の娘尚且つガッツリエロ方面になりますが、ご検討のほどよろしくお願いします\n\nhttps://img.altema.jp/lastperiod/chara/top/1744.jpg", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fenomnnnnnnn/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 203921, "client_id": 763899, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5f9ecd4/uploads/origins/ef7cd702-4529-4655-adfd-b82d7feadced?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c851b624900c96e9ce91049f5650355", "srcset": "https://si.imgix.net/a5f9ecd4/uploads/origins/ef7cd702-4529-4655-adfd-b82d7feadced?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c851b624900c96e9ce91049f5650355, https://si.imgix.net/a5f9ecd4/uploads/origins/ef7cd702-4529-4655-adfd-b82d7feadced?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f8fce62b723509231f20c69f6da13e8 2x, https://si.imgix.net/a5f9ecd4/uploads/origins/ef7cd702-4529-4655-adfd-b82d7feadced?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6efda097316f115bdb7fde6887271ff 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5f9ecd4/uploads/origins/ef7cd702-4529-4655-adfd-b82d7feadced?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13409790aca7ea0eeaca829c15426d43", "srcset": "https://si.imgix.net/a5f9ecd4/uploads/origins/ef7cd702-4529-4655-adfd-b82d7feadced?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13409790aca7ea0eeaca829c15426d43, https://si.imgix.net/a5f9ecd4/uploads/origins/ef7cd702-4529-4655-adfd-b82d7feadced?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d4a0cec9a6715b7ee91e851110e746d0 2x, https://si.imgix.net/a5f9ecd4/uploads/origins/ef7cd702-4529-4655-adfd-b82d7feadced?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=66ec32c23aa4446c052027501bdc9e9e 3x"}, "body": "Feさんに描いていただきたく、今回リクエストをさせていただきました。\n『ゼロの使い魔』のアンリエッタの石化（小便少女）・リビングスタチュー化をお願いします。\n\n要望：\n・服装は全裸\n・瞳はあり\n・性器の描写はモザイクや黒塗りが不要なレベル\n・石化の質感は大理石の様なやや白寄りの灰色でツヤを持たせるイメージ\n・ポーズは両手を少し広げて歓迎する感じ。背筋は真っすぐ伸ばして視線は正面を見据える。足を少し開いて\n上半身：https://originalnews.nico/wp-content/uploads/2020/01/15152539/08_7729794i.jpg\n下半身（A）：https://unlimitedream.com/wp-content/uploads/2021/05/3A818314-0151-463E-8F25-3C68E51F73A5.jpeg\n・リビングスタチュー状態は瞳（瞳孔）は明るい青か濃いピンク色\n\n水の張った部屋で上記の姿勢のまま、いたる箇所から徐々に石化していき、プルプル震えながら赤面しつつ快感を必死に耐えている。\n敵になじられながらも気丈さを保ちながら「決してあなたの物にはなりません」と言い放ちながら、才人のことを想う。\nやがて大部分が石化すると、快感で正常な思考ができなくなり喘ぎ声を漏らしながら才人への想いだけを口にし続ける。（台詞の旨は「私は貴方だけの物」、「永遠に愛している」といった内容）\nやがて完全に石化。表情は石化中とは打って変わって目をしっかり開いた朗らかな笑顔になっている。\n精神は周囲や自分の事にも関心が無く、才人への想いだけを心で反芻している。\n時が経って才人に発見される。驚く才人を他所に嬉しさのあまり、涙と涎を流しながら股から噴水し始める。（終始このまま）\nそのままリビングスタチュー化。微かに喘ぎ声を漏らしながら、誓いを立てるように「私の全てを捧げる」、「私は貴方だけの物」、「貴方だけを永遠に愛している」と言った才人への想いをゆっくり口にする。\n最後に喘ぎ声を高くしながら才人を呼び続けて噴水を盛大に噴き出して終了。\n\n可能ならやっていただきたい内容：\n差分でアニメまたは原作で着けてたティアラと、ラバーまたはエナメルのような光沢のあるオーバーニーソックスとロンググローブ（両方とも白色）、レオタード用スカート（丈は極端に短く、生地は水色で透けた物、前と後ろは無しで側面部分のみ。難しかったらこちらは無しでも大丈夫です）を着用。\n\n要望内容が多く大変申し訳ございません。\nご検討のほどよろしくお願いします。\n\n参考画像：\n・https://cdn-eu.anidb.net/images/main/20007.jpg\n・https://cdn-ak.f.st-hatena.com/images/fotolife/p/pema/20120207/20120207034616.jpg\n・https://www.neowing.co.jp/pictures/l/00/20/NEOGDS-1237.jpg\n・https://pbs.twimg.com/media/D-KZ_-tUcAAnwou.jpg\n・https://pbs.twimg.com/media/EtRFyV0U0AEbriw.jpg:small\n・https://pbs.twimg.com/media/Dd421BjVMAAtdhZ.jpg", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fenomnnnnnnn/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 203921, "client_id": 662639, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cebeaf79/uploads/origins/7b64e13a-093a-47a0-8370-0f82f842d6e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d933f193920b635f8766457838f57ca", "srcset": "https://si.imgix.net/cebeaf79/uploads/origins/7b64e13a-093a-47a0-8370-0f82f842d6e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d933f193920b635f8766457838f57ca, https://si.imgix.net/cebeaf79/uploads/origins/7b64e13a-093a-47a0-8370-0f82f842d6e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a765e082d1b8ba7f49b0d5f63a5d3a7c 2x, https://si.imgix.net/cebeaf79/uploads/origins/7b64e13a-093a-47a0-8370-0f82f842d6e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f4ebba0b15ff212c8aa70373672bd1a 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cebeaf79/uploads/origins/7b64e13a-093a-47a0-8370-0f82f842d6e8?bg=%23fff&auto=for