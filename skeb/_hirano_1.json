32-4105-b507-92f459f84471?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c47de65551390e71406b40e971360a3, https://si.imgix.net/e8d8d0d7/uploads/origins/71f55c37-7632-4105-b507-92f459f84471?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=11217d6f0f5368d9c88657678d34b040 2x, https://si.imgix.net/e8d8d0d7/uploads/origins/71f55c37-7632-4105-b507-92f459f84471?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2066dc69cfd604fd8699942170196c74 3x"}, "body": "こんにちは、涼宮ハルヒと朝比奈みくのイラストを依頼したいです。二人が跪いて両手を合わせて舌を出し、精液を受け取るのを待ちわびている様子を描いてください。こちらの作品に似た構図で：https://x.com/_hirano_1/status/2015606664142127574、ただし二人とも両手を合わせています。 バニーガール衣装（パンティストッキング含む）を着用させてください。ハルヒは嬉しそうな興奮した表情、ミクルは少し緊張した表情にしてください。別バージョンとして、顔と口が精液で覆われ、二人ともハートアイズの嬉しそうな表情のイラストもお願いします。ご検討いただきありがとうございます！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_hirano_1/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3057194, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9cb37257/uploads/origins/d08e9dce-c238-462d-aa53-fcef6577e3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0c75eb64fbdacce4d5e9c797970e5b9", "srcset": "https://si.imgix.net/9cb37257/uploads/origins/d08e9dce-c238-462d-aa53-fcef6577e3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0c75eb64fbdacce4d5e9c797970e5b9, https://si.imgix.net/9cb37257/uploads/origins/d08e9dce-c238-462d-aa53-fcef6577e3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a881dc3f1ff0c7ca62a7b6507f132fed 2x, https://si.imgix.net/9cb37257/uploads/origins/d08e9dce-c238-462d-aa53-fcef6577e3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cdcf5f040883694188b474626403cbaf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9cb37257/uploads/origins/d08e9dce-c238-462d-aa53-fcef6577e3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80a39e1fae546a5eab31561c233eb747", "srcset": "https://si.imgix.net/9cb37257/uploads/origins/d08e9dce-c238-462d-aa53-fcef6577e3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80a39e1fae546a5eab31561c233eb747, https://si.imgix.net/9cb37257/uploads/origins/d08e9dce-c238-462d-aa53-fcef6577e3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=681d14b3707f2d7534c412e715c75a68 2x, https://si.imgix.net/9cb37257/uploads/origins/d08e9dce-c238-462d-aa53-fcef6577e3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fb5d8b5ad06b1112e3491f4e5896289c 3x"}, "body": "ひら野さんイラストいつも拝見させて貰っています。\nラミエル獣神化改でリクエストよろしいでしょうか。\n\nベッドでスースー寝ていて起きないのを良い事に\nラミエルの股を広げてエッチする竿役(ストライカー)\n↓\n中だし\n↓\n目が覚めてたラミエルとばっちり目があってしまう\n\n服ははだけていて胸とお腹が見えている\nズボンは脱がされて隣に落ちている\n\nもし可能だったら\n差分でエッチしてる事を理解してしまい\n顔を赤らめて驚いている差分があれば嬉しいです。\n\nご検討よろしくおねがいします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_hirano_1/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3057194, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a161c2b2/uploads/origins/08ed62cd-e7fc-493f-aeec-51aea8b182ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b4b5b307759a11328a7dfca8bfa08b8", "srcset": "https://si.imgix.net/a161c2b2/uploads/origins/08ed62cd-e7fc-493f-aeec-51aea8b182ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b4b5b307759a11328a7dfca8bfa08b8, https://si.imgix.net/a161c2b2/uploads/origins/08ed62cd-e7fc-493f-aeec-51aea8b182ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3bf2a821db1ab6d0e73548c3e4aed1a 2x, https://si.imgix.net/a161c2b2/uploads/origins/08ed62cd-e7fc-493f-aeec-51aea8b182ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81787f7f7911674b5ad805eb8d49fb89 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a161c2b2/uploads/origins/08ed62cd-e7fc-493f-aeec-51aea8b182ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c59a693e08af4bf0f77e773daf11d08", "srcset": "https://si.imgix.net/a161c2b2/uploads/origins/08ed62cd-e7fc-493f-aeec-51aea8b182ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c59a693e08af4bf0f77e773daf11d08, https://si.imgix.net/a161c2b2/uploads/origins/08ed62cd-e7fc-493f-aeec-51aea8b182ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d17a562a7bcb29f995971bf280898950 2x, https://si.imgix.net/a161c2b2/uploads/origins/08ed62cd-e7fc-493f-aeec-51aea8b182ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f69dd1fcff6dd4e5019d036719620dda 3x"}, "body": "リクエスト失礼します。\nモンスト から 獣神化改ダルタニャンを見てみたいです。\n\n敗北したダルタニャンが\nがに股騎乗位セックスを強要されている\n①最初は反抗的な目で一心不乱に恥ずかしそうに腰を降る\n②中出し\n③時間が経過し大勢に使われた想定で身体中に精液まみれ、正の字が太ももに書かれて\n堕ちた表情をしている\n\n◼️服装は改のイラスト基準に縦縞模様の靴下、手袋、王冠、腰のベルト以外の服は無し\n元イラストより胸大きめでむっちりしている感じにお願いします。\n\n◼️その他\n➂はベルトに仕様済みのコンドームを引っかけてぶら下げている\n\n良ければでいいのですが、目を閉じている表情差分があれば嬉しいです。\n\nご検討よろしくお願いします。\n\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQ99UL_5hNU3Lq5aKYbPA1JdiYBLNyY2eZVDwmAl6S6iRnTa46heiFkbUY&s=10\n\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQ99UL_5hNU3Lq5aKYbPA1JdiYBLNyY2eZVDwmAl6S6iRnTa46heiFkbUY&s=10", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_hirano_1/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3057194, "vtt_url": null, "thumbnail_image_urls": {"src"