nYoutubeの配信、動画サムネや各種SNSでの利用を予定しております。\n\n\n何卒、条件が合いましたらご検討の程、よろしくお願いいたします。\n\nhttps://twitter.com/wiztella/status/1680916626382934016", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Lv8_HR/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2695188, "client_id": 1515375, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c82096f/uploads/origins/de0683ee-ab66-4fa1-95a2-b11ca5abd43e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c1b0e1e56cd5eeafd1f2c6d03d464f6", "srcset": "https://si.imgix.net/4c82096f/uploads/origins/de0683ee-ab66-4fa1-95a2-b11ca5abd43e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c1b0e1e56cd5eeafd1f2c6d03d464f6, https://si.imgix.net/4c82096f/uploads/origins/de0683ee-ab66-4fa1-95a2-b11ca5abd43e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b25f0538fa374c4851763a6419a7e8d 2x, https://si.imgix.net/4c82096f/uploads/origins/de0683ee-ab66-4fa1-95a2-b11ca5abd43e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10cfa239d3194f19528c1bab6a9298a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c82096f/uploads/origins/de0683ee-ab66-4fa1-95a2-b11ca5abd43e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53f1a559081b01d06a6b95c689a74b1a", "srcset": "https://si.imgix.net/4c82096f/uploads/origins/de0683ee-ab66-4fa1-95a2-b11ca5abd43e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53f1a559081b01d06a6b95c689a74b1a, https://si.imgix.net/4c82096f/uploads/origins/de0683ee-ab66-4fa1-95a2-b11ca5abd43e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8bfa85fc036153b3881225b2cc3f8f49 2x, https://si.imgix.net/4c82096f/uploads/origins/de0683ee-a