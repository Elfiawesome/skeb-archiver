7-f3b9381da0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a922bc7305fa7ebf0b1c6e87719c170b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96f47539/uploads/origins/5d9b4c1e-3a0d-4502-bf87-f3b9381da0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=880aec5fc15df055d738d7af08800b4f", "srcset": "https://si.imgix.net/96f47539/uploads/origins/5d9b4c1e-3a0d-4502-bf87-f3b9381da0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=880aec5fc15df055d738d7af08800b4f, https://si.imgix.net/96f47539/uploads/origins/5d9b4c1e-3a0d-4502-bf87-f3b9381da0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f1cc7cd20bb0a6c59a781df1bc05705b 2x, https://si.imgix.net/96f47539/uploads/origins/5d9b4c1e-3a0d-4502-bf87-f3b9381da0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f5f5505b153c5f9e577611ebd3bfebf2 3x"}, "body": "こんにちは！あなたの絵のスタイル、素敵ですね！\n\n私のこのキャラクターを描いていただけませんか：[https://imgchest.com/p/qe4g3mrejyj]\n\n彼女は、住んでいる国で鉄道を経営する裕福な家庭に生まれたお嬢様ですが、ただ家の跡を継ぐだけでは退屈な人生になると思い、魔法を学ぶ道を選びました。 それ以来、彼女は魔法を非常に上達させ、その結果、髪が紫色に変わってしまいました。ただ、魔法のせいで時々体調を崩してしまうこともあります。\n\n彼女は物静かな性格で、友達を作ったり人付き合いをしたりするのが苦手ですが、興味のある話題――主に魔法や、実家の会社が所有する蒸気機関車――については延々と語ることができます。一般的に、男の子よりも女の子と仲良くできるタイプです。\n\n既存の衣装を描いても、彼女のために新しい衣装を描いても構いません！ 素敵なドレスが彼女に似合いますし、貴族のパーティー用にフォーマルな衣装を用意してあげてください。\n\nありがとうございます！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Barium_cps/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2037096, "client_id": 2231946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68d62c7e/uploads/origins/c4fcff79-8d18-4ef7-b008-bdbf92fc0c91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6621708d3229b6ada71