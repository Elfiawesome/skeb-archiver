場合は\n却下していただいて大丈夫です。\n\nキャラについてのみまた前回同様記載させていただきますので、\n参考にしていただければ幸いです。\n\nキャラビジュアル＝＝＝\n\n・かっこかわいいをコンセプトに活動するロックシンガーです。\n・資料内【黒衣装】の方のイメージで、衣装などについては\n　改変アレンジ、大歓迎でございます。\n　ぜひ亞門先生のセンスにお任せしたいです。\n　治安の悪いロックな曲が大好きなので、\n　治安の悪い、チャイナっぽい雰囲気や\n　サイバーパンクな雰囲気などが大好きです。\n\n・左目下に涙ボクロ\n・八重歯、犬歯がある\n・しっぽは５本ありますが、省略可\n\n以上、ぜひお引き受けいただけた際はよろしくお願いいたします✿\n\nhttps://drive.google.com/drive/folders/1JnH9FLXz4bZ7WUgyRl0qLYuQHW5BGWQY?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ammon_Mk3/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3540959, "client_id": 1593628, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/438376ee/uploads/origins/3371ec9c-c48a-45ce-8431-d3b3a4218a02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adb7a7dd287157f8f060fd9de2027683", "srcset": "https://si.imgix.net/438376ee/uploads/origins/3371ec9c-c48a-45ce-8431-d3b3a4218a02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adb7a7dd287157f8f060fd9de2027683, https://si.imgix.net/438376ee/uploads/origins/3371ec9c-c48a-45ce-8431-d3b3a4218a02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=563afbfa516feabe46a82641bc5cb9f7 2x, https://si.imgix.net/438376ee/uploads/origins/3371ec9c-c48a-45ce-8431-d3b3a4218a02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5cbdd5b30e6baab23a32a10923a4d02 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/438376ee/uploads/origins/3371ec9c-c48a-45ce-8431-d3b3a4218a02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7790c04846a824fde6a7a6900995dda3", "srcset": "https://si.imgix.net/438376ee/uploads/origins/3371ec9c-c48a-45ce-8431-d3b3a4218a02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7790c04