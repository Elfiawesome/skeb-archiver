{"screen_name": "uisorasakuta", "first_seen": "2025-09-14T03:10:01.323703+00:00", "last_updated": "2025-09-14T03:10:01.323703+00:00", "profile": {"id": 1320695, "acceptable": true, "creator": true, "avatar_url": "https://pbs.twimg.com/profile_images/1809711638259593218/whE1-ky2.jpg", "name": "ういそらさくた", "nsfw_acceptable": true, "screen_name": "uisorasakuta", "language": "ja", "body_size": 1000, "received_works_count": 84, "received_nsfw_works_count": 84, "appeal_receivable": false, "sent_first_works_count": 0, "sent_public_works_count": 0, "instruction": "unspecified", "description": "キュアグレースに心を奪われた者。\n pixiv→http://pixiv.net/users/14216797\nskeb→http://skeb.jp/@uisorasakuta\nBluesky→https://bsky.app/profile/uisorasakuta.bsky.social", "busy": false, "url": "https://bsky.app/profile/uisorasakuta.bsky.social", "show_social_profile": true, "accept_expiration_days": 30, "complete_expiration_days": 60, "received_requests_average_response_time": 25895, "completing_average_time": 2908624, "nc": 161, "twitter_uid": "3016554964", "user_service_link": [], "banned": false, "banned_by": "", "complete_rate": 1, "og_image_url": "https://skeb-avatar.imgix.net/https%3A%2F%2Fskeb.jp%2Fapi%2Fusers%2Fuisorasakuta%2Fbackground%3Fd%3Dd1b463?blend64=aHR0cHM6Ly9hc3NldHMuaW1naXgubmV0L350ZXh0P3R4dDY0PVVrVkRUMDFOUlU1RVJVUWdVRkpKUTBVJnR4dGNscj1mZmYmdHh0Zm9udDY0PVFYWmxibWx5TFUxbFpHbDFiUSZ0eHRhbGlnbj1jZW50ZXImdHh0c2l6ZT00MCZ0eHRzaGFkPTEwJmZtPXBuZyZ3PTEyMDA&bm=normal&by=360&mark64=aHR0cHM6Ly9hc3NldHMuaW1naXgubmV0L350ZXh0P3R4dDY0PU1UVXNNREF3SUVwUVdRJnR4dGNscj1mZmYmdHh0Zm9udDY0PVFYWmxibWx5TFVKc1lXTnImdHh0YWxpZ249Y2VudGVyJnR4dHNpemU9ODAmdHh0c2hhZD0xMCZmbT1wbmcmdz0xMjAw&marky=415&txt64=44GG44GE44Gd44KJ44GV44GP44Gf&txtclr=fff&txtfont64=QXZlbmlyLUJsYWNr&txtfit=max&txtalign=middle%2Ccenter&txtsize=60&txtshad=10&auto=format%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=755efb38db3c03e7f93add0eee95d116", "skills": [{"genre": "art", "default_amount": 15000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@uisorasakuta/works/84", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1320695, "client_id": 119857, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aec7467c/uploads/origins/fd7cc775-3a7d-41c2-9a48-e541828d1ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2716526199b24f13e6b7e13e7ccbf47f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aec7467c/uploads/origins/fd7cc775-3a7d-41c2-9a48-e541828d1ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e174630db09d0ae56cf51c953ae1ed81", "src_set": ""}, "body": "対魔忍より、水城不知火（通常）とラグナロク=シンモラの乳合わせをお願いいたします。\n感度三千倍にされた状態で乳相撲を強いられているようなイメージです。\n\n構図：二人が膝立ちで乳房を押し付け合っているところを真横から。股間が画面に入っていれば、足まで描写いただく必要はありません。\nポーズ：乳房を押し付け合っている感じであれば、ワキ見せなり乳房を抱えているなりお任せします。\n服装：全裸、頭のアクセサリのみ装着\n体型：むちむち爆乳、好きに盛ってしまってください！　腕や脚もぶっといとなおうれしいです。\n不知火はワキも股間も剛毛で、ラグナロクはパイパンでお願いします。\n\n両者に表情と汁差分をお願いいたします。\n勝ったり負けたりしてほしいので、可能であればPSD納品をお願いいたします。\n①余裕の微笑み\n②快感をこらえる\n③絶頂、噴乳、潮吹き\n\nセリフ、擬音、背景はこだわりません（なくても大丈夫です）\n構図上矛盾しているお願いがありましたら、描きやすいように解釈していただいて構いません。\n\n以上、よろしければご検討お願いいたします！！", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uisorasakuta/works/83", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f38cd050/uploads/origins/3c44bdbd-bbb8-4a95-af04-5f0e48def8dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9d6e02c0dc4c2d5304d1f818f3fd312", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1320695, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_ima