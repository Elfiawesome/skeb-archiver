いです。\nただし、いたずらは可愛い程度です）\n呪術を使うキャラクターなので、キャラクターの性格とは別に、周囲に不気味な雰囲気が漂うキャラクターです。\n\nキャラクターの設定以外は特に制限はありませんので、自由に制作してください！\n\n作品により作家さんの個性が出せるのであれば、キャラクターの衣装や性格を少し変えても構いません！\n\n\n前向きに検討よろしくお願いします\n\nhttps://drive.google.com/drive/folders/1uuh8EgoMjaT1RGnJRJbMMg01-8ltePyY?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 25544, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "不二式", "screen_name": "Fujishiki", "avatar_url": "https://pbs.twimg.com/profile_images/1771546874425860096/T4krF893.jpg", "header_url": "https://pbs.twimg.com/profile_banners/68209391/1711204664/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 1688710, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "KiiKo @アニメ原画風skeb", "screen_name": "Kiiko_clip", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fd4b360a8-1c07-44f9-b59a-94c6982e2227.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fb207f67-3c6c-47bb-9795-c6d4b3977f4a.webp", "appeal_receivable": false, "popular_creator_rank": 34, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 8, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 2003450, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ni~ / に〜", "screen_name": "dodo_o_u", "avatar_url": "https://pbs.twimg.com/profile_images/1890243010203684864/G8H-aacL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1437776919890731008/1708597645/1500x500", "appeal_receiv