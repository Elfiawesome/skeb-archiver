core": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/501959bc/uploads/origins/96bfefbd-fedc-4f3b-b6e3-d9e74dc5eb7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce876d0210cb32eea4946e4a6f7f6f7d", "srcset": "https://si.imgix.net/501959bc/uploads/origins/96bfefbd-fedc-4f3b-b6e3-d9e74dc5eb7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce876d0210cb32eea4946e4a6f7f6f7d, https://si.imgix.net/501959bc/uploads/origins/96bfefbd-fedc-4f3b-b6e3-d9e74dc5eb7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=068ad1c4fe0afd6112e4fa38920d301e 2x, https://si.imgix.net/501959bc/uploads/origins/96bfefbd-fedc-4f3b-b6e3-d9e74dc5eb7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2a563b72eea04492b35070edfa261800 3x"}, "body": "⋈*｡ﾟ  \n\nᤊᒐױƕ † さん、こんにちは ⋈*｡ﾟ  \n\nᤊᒐױƕ † さんの甘々な世界感がとてもかわいくていつも拝見しています❕\nみているこちらまでドキドキするような可愛い色使いと甘くて魅力的な表情が大好きです‥♡  \n\nこの度は私のocを描いていただきたくskeb申請させていただきました ᐢᴗ͈ ᴗ͈ᐢ♡⋈*｡ﾟ   \n\nどろどろのロリ聖母キャラクターを描いてほしいです♡  \n\n*⑅୨୧依頼内容 ୨୧⑅ * \n❤︎ 髪：重めのピンクツインテール \n❤︎ 目：むらさき\n❤︎ イメージカラー：ピンク・水色 \n❤︎ 衣装：おまかせ　 \n❤︎ 特徴：インテーク・ハート毛・ながい下まつ毛・ツインテ上のぴょん毛・眼帯の有無おまかせ\n❤︎ 資料：  https://drive.google.com/drive/u/0/mobile/folders/1-cXNrvP5lkz-fYHyx3Z5l1r8BlNeYlp5?sort=13&direction=a  \n\n⑅୨୧ 使用用途 ୨୧⑅ \nSNSのアイコン ／ 個人用にグッズ化  \n\n普段は細身のキャラクターですが ᤊᒐױƕ † さんの描くむちむちな女の子がすごくすごく可愛くて‥♡\n ifでむちむちocの資料と、どちらも資料にさせていただきました(///ω///)🤍🎀  \n\nᤊᒐױƕ † さんの世界観がまるごとかわいくて \nすごくすごく好きです！ \n\n自由に描いてください‥♡🥰  \n\n⋈*｡ﾟ  \n\nもしもご縁がありましたら、どうぞよろしくお願いいたします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@E__PreTTy/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3361260, "client_id": 2497403, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88991509/uploads/origins/ce2c60ab-2d80-4b6e-8a49-b9245fdef5ad?bg=%23fff&auto=forma