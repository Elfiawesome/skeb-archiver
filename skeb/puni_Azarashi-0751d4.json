e%2Ccenter&txtsize=30&txt=PRIVATE&s=3e0578dd2a2231586c0b678741bb3efd 2x, https://si.imgix.net/a045ab26/uploads/origins/110c0e99-497f-4217-ae60-6b28fb0e06c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=95fe1e867faf0d9311795f5ef5a9106b 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2802252, "client_id": 2855173, "nc": 1}, {"path": "/@puni_Azarashi/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2802252, "client_id": 2879455, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e2bb5ebd/uploads/origins/26ef4961-72fa-4228-b8cd-d58b6489b262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c80a10591f94328236a9c3060d1ecd35", "srcset": "https://si.imgix.net/e2bb5ebd/uploads/origins/26ef4961-72fa-4228-b8cd-d58b6489b262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c80a10591f94328236a9c3060d1ecd35, https://si.imgix.net/e2bb5ebd/uploads/origins/26ef4961-72fa-4228-b8cd-d58b6489b262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39fbb2711fe2d133e4277215a1f8f6aa 2x, https://si.imgix.net/e2bb5ebd/uploads/origins/26ef4961-72fa-4228-b8cd-d58b6489b262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2d5e9861a13b7655abe9f8118eb9561 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2bb5ebd/uploads/origins/26ef4961-72fa-4228-b8cd-d58b6489b262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ff1f57e5ec7e31c1bcd515d1933e471", "srcset": "https://si.imgix.net/e2bb5ebd/uploads/origins/26ef4961-72fa-4228-b8cd-d58b6489b262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ff1f57e5ec7e31c1bcd515d1933e471, https://si.imgix.net/e2bb5ebd/uploads/origins/26ef4961-72fa-4228-b8cd-d58b6489b262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5656e897eb2af6bed41e91291fcd17b2 2x, https://si.imgix.net/e2bb5ebd/uploads/origins/26ef4961-72fa-4228-b8cd-d58b6489b262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cec1c9ebebecf559e5b9b6a42ab2818a 3x"}, "body": "hazeさん、初めまして。\n趣味で配信活動をしているちえると申します。\n\n今回は私のアバター、皇帝ちゃんとマフィアくんのイラストを描いていただきたくリクエストさせていただきました。\nhazeさんの描く世界観とっても素敵なので、構図・表情等はすべてお任せさせてください！衣装についてもお任せします。\nいくつか表情差分をつけていただけると助かります。\n画像サイズは配信・動画で使えるように16:9のワイドサイズで描いていただけると嬉しいです。  \n\n▷皇帝\n性別：女\n身長：148cm \n髪型・髪色：黒髪 髪の長さは腰くらい 前髪ぱっつん \n目の色：青\n爪は触ったら傷つきそうなくらい鋭い\n存在している国の中で最も大きな帝国を統べる皇帝で、邪智暴虐。無邪気で傲慢な性格です。\n気まぐれであり飽きっぽいところはあるが考えに一貫性がある有言実行型。\n皇帝の気に食わない奴は片っ端から殺されるため、周囲の人間はとても気を張っている。 \n諸外国には賢皇とみられるような狡猾さも持っています。\n \n▷マフィアくん\n性別：男 \n身長：192cm \n髪型・髪色：灰色～白っぽい感じ\n目の色：赤\n爪は触ったら傷つきそうなくらい鋭い\n中華マフィアのボスで性格としては皇帝と同じような感じだがこっちの方がしっかりしている側面が強く、皇帝には心配性。人当たりがよく、人懐っこい。これは愛想がいいと物事が円滑に進むことを理解しているため。 人に取り入り利用することに長けている。幼い頃スラムで皇帝に拾われた。\n\nふたりの関係性としてはバディのような、悪友のような、姉弟のような感じです。\n\n以下は参考資料です。\n参考資料\n世界観：https://lit.link/GreatChieru\nキャラ資料：https://drive.google.com/drive/folders/1XFhOFWwMdwETA6DuhIsDH3Rj8EhkE5-8?usp=drive_link\n可能な限り背景・個々で人物のレイヤーを分けていただきたく、PSDデータ、難しいようであればPNGデータで差分を分けていただきたいです。\n\n◇主な使用場所\nyoutubeやCAS(動画素材・サムネイルとして)、SNS(X、Instagram)等\n\nまたグッズ制作をさせていただき、身内間とはなりますがネットプリントやbooth等で販売することになるかもしれません。\n商用利用が不可であれば、お手数ですがどこかのレイヤーに商用利用不可の旨をかいていただきたいです。\n\n金額に不足がありましたら、再送をお願いします。\n何か不都合等があればキャンセルしていただいて結構です。\n以上です。長々とお読みいただきありがとうございました。\nご検討よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@puni_Azarashi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2802252, "client_id": 2597812, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d37a6650/uploads/origins/6ee2e3cd-8d42-4a12-a226-c42876