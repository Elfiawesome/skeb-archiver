txtsize=30&txt=PRIVATE&s=ea15897047dd5206b609dee3b001b5da 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 563523, "client_id": 3492967, "nc": 33}, {"path": "/@dyon_McClane/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 563523, "client_id": 123629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/830e87f0/uploads/origins/583fbb68-7cf7-4fca-8123-9915301f2597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03771c6622c2a9c89b7f5b4a007ddc24", "srcset": "https://si.imgix.net/830e87f0/uploads/origins/583fbb68-7cf7-4fca-8123-9915301f2597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03771c6622c2a9c89b7f5b4a007ddc24, https://si.imgix.net/830e87f0/uploads/origins/583fbb68-7cf7-4fca-8123-9915301f2597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ceedb4e7c07f27987b91f33518de21f7 2x, https://si.imgix.net/830e87f0/uploads/origins/583fbb68-7cf7-4fca-8123-9915301f2597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9043baff234fd82cd184b54e84ea45ba 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/830e87f0/uploads/origins/583fbb68-7cf7-4fca-8123-9915301f2597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d566525380d9bb10f98fce53d625c41", "srcset": "https://si.imgix.net/830e87f0/uploads/origins/583fbb68-7cf7-4fca-8123-9915301f2597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d566525380d9bb10f98fce53d625c41, https://si.imgix.net/830e87f0/uploads/origins/583fbb68-7cf7-4fca-8123-9915301f2597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=596ebb8d354f672f983f5a309c71edb8 2x, https://si.imgix.net/830e87f0/uploads/origins/583fbb68-7cf7-4fca-8123-9915301f2597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1181d850437a210d250f75113f7ec19d 3x"}, "body": "こちらも宜しければ描いて貰えると嬉しいです。\n東方の鈴瑚が好意の男とのイチャラブエッチを楽しんでる光景をお願いします。\n\n人物\nhttps://www.pixiv.net/artworks/69917455（キャラデザ,服装）\nキャラデザや服装は資料の容姿で上着や履物,装飾品も有る（片足に履物やパンツが引っ掛け残り）\n・半脱ぎで両胸を露出（胸元がずり上げて露出）\n・挿入部も見えてるアングルで彼女のキャラ全体図が見えて\n・バストは揉めるやや大きめな膨らみサイズ\n\n体位\nhttps://www.pixiv.net/artworks/129944134\n全体的に資料と同じ角度アングルの三人称視点の座ってる彼に乗っかりM字開脚の背面座位で営んでる光景で、身体全体や頭から足先まで見えてる\n好意の彼と良い雰囲気でエッチな事に発展して、ベッドの上でヤリ合ってる様子\n\n鈴瑚\n・彼を背もたれにM字に開いてる背面座位で営み\n・憧れの彼の責め立てを感じたりエッチ過ぎる羞恥心を感じて、資料のような恥じらう様子やお腹や子宮辺りを撫でて彼のアレを感じていたりの様子\n・好意の彼が積極的に求めてヤリ合っており、自分を求めている嬉しさと優しくも激しいエッチを感じてそうな様子\n\n男性\n・髪有りの頭や身体,手足も写ってる男性で\n・彼女の両足支え持ち拡げor片足支え持ちと片胸揉み（乳首見え）で責め立て\n・既に他のエッチな事でも暴発したりで彼女の身体や口元にも精液が付着させたりして\n・彼女と積極的にヤリたそうで、一緒に乱れながら我慢出来ずたくさんヤリまくってる様子\n\n可能でしたら\n・中出しされて喘ぎ乱れてるや挿入のままor引き抜いた竿見せでうっとり事後の表情変化\n・または、清蘭(前回と同じ彼で鈴瑚に交代した事後or偶然二人を見つけて近づいて来て)も写ってニヤケたり面白そうに二人のエッチを眺めたりorエッチな気分になりヤリたそうになってる様子\nなどの光景が見れたら嬉しいです。\n\nそのようなシチュエーションをご検討お願い致します。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dyon_McClane/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 563523, "client_id": 123629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d0af926/uploads/origins/c1a1ecc6-9a1e-4296-81b1-3c84546b3ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f04203538067489f253a7ba92d73486", "srcset": "https://si.imgix.net/8d0af926/uploads/origins/c1a1ecc6-9a1e-4296-81b1-3c84546b3ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f04203538067489f253a7ba92d73486, https://si.imgix.net/8d0af926/uploads/origins/c1a1ecc6-9a1e-4296-81b1-3c84546b3ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fcca399b9acf818f34a893fe02fa2e9b 2x, https://si.imgix.net/8d0af926/uploads/origins/c1a1ecc6-9a1e-4296-81b1-3c84546b3ca8?bg=%23fff&auto=format%2