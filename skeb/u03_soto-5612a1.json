新しい服をデザインしていただけませんか？西洋ファンタジー風の旅に出るときの服で、軽くて便利なもの。\n男の子は「ベンムソン」で、女の子は「シャノール」です。男は普段表情がなく冷静で落ち着いた人ですが、女と一緒にいると笑顔を浮かべます。女は活発で少し悪魔な感じがします。時々男をからかいます。二人は仲が良く、暗黙の了解も持っています。パートナーでもありカップルでもあります。\nもし金額が足りないようでしたら、お手数ですが指定の後再送要請を送っていただけると嬉しいです。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-6OlHUCN_9tit4d7robN8nPL5crLZGDn", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@u03_soto/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2848446, "client_id": 1943973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12f10d47/uploads/origins/d5f86a69-1601-494f-bfff-0a179a32ab41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba42e44767395c0ab46f18b3a30b78c7", "srcset": "https://si.imgix.net/12f10d47/uploads/origins/d5f86a69-1601-494f-bfff-0a179a32ab41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba42e44767395c0ab46f18b3a30b78c7, https://si.imgix.net/12f10d47/uploads/origins/d5f86a69-1601-494f-bfff-0a179a32ab41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4dc7e21b753023fa9a8077b7d7e7596 2x, https://si.imgix.net/12f10d47/uploads/origins/d5f86a69-1601-494f-bfff-0a179a32ab41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23be7eab4f433656f573350594c083f9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12f10d47/uploads/origins/d5f86a69-1601-494f-bfff-0a179a32ab41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4680c45ea6e24de6f3cfe65aece3ba9c", "srcset": "https://si.imgix.net/12f10d47/uploads/origins/d5f86a69-1601-494f-bfff-0a179a32ab41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4680c45ea6e24de6f3cfe65aece3ba9c, https://si.imgix.net/12f10d47/uploads/origins/d5f86a69-1601-494f-bfff-0a