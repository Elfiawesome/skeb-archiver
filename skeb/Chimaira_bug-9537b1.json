h?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Chimaira_bug/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3241949, "client_id": 2253287, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b6a2c4a/uploads/origins/670e11b0-3d10-45fb-8750-f68b8a2b3541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=816326d0cfd40a884692396a32c6f018", "srcset": "https://si.imgix.net/2b6a2c4a/uploads/origins/670e11b0-3d10-45fb-8750-f68b8a2b3541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=816326d0cfd40a884692396a32c6f018, https://si.imgix.net/2b6a2c4a/uploads/origins/670e11b0-3d10-45fb-8750-f68b8a2b3541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24e41ba713a6ef4c2db1e370433a5df3 2x, https://si.imgix.net/2b6a2c4a/uploads/origins/670e11b0-3d10-45fb-8750-f68b8a2b3541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=354403a111fdbc3400ed15da56ec19cb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b6a2c4a/uploads/origins/670e11b0-3d10-45fb-8750-f68b8a2b3541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08a40ab35704a62c918f3ffbae59218f", "srcset": "https://si.imgix.net/2b6a2c4a/uploads/origins/670e11b0-3d10-45fb-8750-f68b8a2b3541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08a40ab35704a62c918f3ffbae59218f, https://si.imgix.net/2b6a2c4a/uploads/origins/670e11b0-3d10-45fb-8750-f68b8a2b3541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9204a42481af1df9974732ffd4ec834e 2x, https://si.imgix.net/2b6a2c4a/uploads/origins/670e11b0-3d10-45fb-8750-f68b8a2b3541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df