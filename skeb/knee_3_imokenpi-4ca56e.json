したくリクエストさせていただきました。\n\n■シチュエーション\n差分形式でニ枚お願いしたく\n\n一枚目:制服で男子トイレの小便器の間に立たされ、両手を手錠で小便器の上のパイプに繋がれ拘束\nモブに囲まれた状態で表情は拘束されることに驚き、恐怖\n\n二枚目:一枚目後、集団レイプされたイメージで事後描写。\nモブ不在で服はズタボロに破られ、身体は精液濡れ、ヴァギナ、アナル(見える構図でしたら)から精液垂れ。\n身体に卑猥な落書きをされて、拘束された状態で悔し泣いている。\n\nというシチュエーションのイラストをお願いしたいです。\n\n原作より凌辱色強めのテイストですので問題があれば、遠慮なくキャンセルしてください。\n何卒よろしくお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@knee_3_imokenpi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 270589, "client_id": 2805640, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c7ced7e/uploads/origins/606e8fbe-6a88-4b74-b0d1-fbcedc65f457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fddcec287f90ed439810a40e86fc9cf", "srcset": "https://si.imgix.net/2c7ced7e/uploads/origins/606e8fbe-6a88-4b74-b0d1-fbcedc65f457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fddcec287f90ed439810a40e86fc9cf, https://si.imgix.net/2c7ced7e/uploads/origins/606e8fbe-6a88-4b74-b0d1-fbcedc65f457?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a0d1d9fa347933ae39d0af40e19cec3 2x, https://si.imgix.net/2c7ced7e/uploads/origins/606e8fbe-6a88-4b74-b0d1-fbcedc65f457?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98b8861987317a76f30a9f64337d1404 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c7ced7e/uploads/origins/606e8fbe-6a88-4b74-b0d1-fbcedc65f457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f5e307f95dc2ccd0fb7e359b90636a6", "srcset": "https://si.imgix.net/2c7ced7e/uploads/origins/606e8fbe-6a88-4b74-b0d1-fbcedc65f457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f5e307f95dc2ccd0fb7e359b90636a6, https://si.imgix.net/2c7ced7e/uploads/origins/606e8fbe-6a88-4b