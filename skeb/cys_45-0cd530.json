ろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1E6zMizn5Ctc0SoHMV3hJd_-UsdZCmo1k?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cys_45/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2495300, "client_id": 1810528, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5189f37d/uploads/origins/554670f1-de12-44a2-9462-5d17b8a065a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8569084eb5e478fedae2dbf082130be", "srcset": "https://si.imgix.net/5189f37d/uploads/origins/554670f1-de12-44a2-9462-5d17b8a065a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8569084eb5e478fedae2dbf082130be, https://si.imgix.net/5189f37d/uploads/origins/554670f1-de12-44a2-9462-5d17b8a065a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81437b99f2e98ba308baf6e945acd8ac 2x, https://si.imgix.net/5189f37d/uploads/origins/554670f1-de12-44a2-9462-5d17b8a065a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=634adc4a9e6605877953d801667e66ec 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5189f37d/uploads/origins/554670f1-de12-44a2-9462-5d17b8a065a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eff1f15fbf84ebdce26e036a17616bd1", "srcset": "https://si.imgix.net/5189f37d/uploads/origins/554670f1-de12-44a2-9462-5d17b8a065a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eff1f15fbf84ebdce26e036a17616bd1, https://si.imgix.net/5189f37d/uploads/origins/554670f1-de12-44a2-9462-5d17b8a065a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1951a77323edec122ecb832bfb12d040 2x, https://si.imgix.net/5189f37d/uploads/origins/554670f1-de12-44a2-9462-5d17b8a065a3?bg=%23fff