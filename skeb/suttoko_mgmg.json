h=200&s=f3a5c75449137a69ab050c0adb9d1f42, https://si.imgix.net/de1e2b3c/uploads/origins/a95a1893-cd68-48cb-8f75-82465d6b2640?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45780aefe01f571f7173df597d491ced 2x, https://si.imgix.net/de1e2b3c/uploads/origins/a95a1893-cd68-48cb-8f75-82465d6b2640?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2093964437dce0c65b39c44be8420c92 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de1e2b3c/uploads/origins/a95a1893-cd68-48cb-8f75-82465d6b2640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4e3680717a56b171269fdebfc35c453", "srcset": "https://si.imgix.net/de1e2b3c/uploads/origins/a95a1893-cd68-48cb-8f75-82465d6b2640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4e3680717a56b171269fdebfc35c453, https://si.imgix.net/de1e2b3c/uploads/origins/a95a1893-cd68-48cb-8f75-82465d6b2640?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab0d23a8aeb1feacb856436643a0789d 2x, https://si.imgix.net/de1e2b3c/uploads/origins/a95a1893-cd68-48cb-8f75-82465d6b2640?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=58def50b5578c080a3eee7000da9719c 3x"}, "body": "初めてリクエストさせて頂きます。\n立ち絵依頼サイトへの登録ご予定ある、とのことでソワソワしていたのですが、skebのツイート見て飛んで来ました。\nこういったもの初依頼なのでお見苦しかったら申し訳ありません。\n\n今回ご依頼させて頂きたいものは、蹂躙するは我が手にてHO1の肖像画になります。\n後世に良く伝える為に描かれたような、本人が見る事があれば「誰ですかこれ」と言ったり鼻で笑ったりするような格好良いものになると嬉しいです！(目をちゃんと見開いてたり、嫌味な笑いではなく微笑だったり)\n\n｜　使用用途\n非商用で、個人(とよろしければ自陣)の中のみでのタペストリーなどのグッズ化が可能かの確認が出来ればと思います。\n\n｜　希望サイズ\n肖像画なので胸から上\n\n｜　キャラクターイメージ\nイド(32) 男\n173cm / 43kg\nイメージカラー　赤、黒、紫\n\n・容姿\n髪\n∟ふんわりさらさらな緑髪\n　後ろでひとつまとめ。筒状の銀の留め具\n目\n∟やや熟れた柘榴のような赤に黒混じり\n　吊り目\n体\n∟貧弱な薄い体(db-1d4)\n　服装はスーツ姿がデフォなのですが、軍人であったと伝える為に軍服姿が描かれている、という事にしたいです(参考画像6枚目の様な厳しい軍服)\n\n・性格\n性格は食えず、人を揶揄うことを人生の喜びとしている面があるため周りの人にも嫌われている。A国の幼いトップを操る傀儡政治、戦場では敵から狙われない位置で狙撃というように、自分が矢面に立たないような計算高い姑息な手段を好む。\n幼い頃人体改造の実験に利用された事から人類を嫌っているものの、大嫌いな人類が、皆からも嫌われるような自分を頼らざるを得ない状況に鼻歌を歌うような人物です。\n\n｜　イメージソング\n・フィクサー　/　ぬゆり\n・セカイ再信仰特区　/　ろくろ\n\n｜　参考画像\nhttps://x.com/inc_ga9/status/1710793035934838894?s=20\n(有効期限あるURLが×の設定上ワンクッション挟んでいます。お手数おかけします)\n\n長くなってしまいましたが以上になります。本当に絵柄や世界観を尊敬していますのでお受け頂けたら幸いですが、何よりもご自愛ください。\nどうぞよろしくお願いします。\n\n(もしご入用な時用のCSです↓)\n\nhttps://iachara.com/char/view/1192075", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suttoko_mgmg/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 966387, "client_id": 2913040, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09dab18c/uploads/origins/77250ab0-9e22-4b0e-92d3-d0b311239f03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad462e1fadeda34bc82b497e143f49bf", "srcset": "https://si.imgix.net/09dab18c/uploads/origins/77250ab0-9e22-4b0e-92d3-d0b311239f03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad462e1fadeda34bc82b497e143f49bf, https://si.imgix.net/09dab18c/uploads/origins/77250ab0-9e22-4b0e-92d3-d0b311239f03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39cb5adb6992e51402076a815b694a1e 2x, https://si.imgix.net/09dab18c/uploads/origins/77250ab0-9e22-4b0e-92d3-d0b311239f03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de4ee27a4cecb3206f77e2af6d32631d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09dab18c/uploads/origins/77250ab0-9e22-4b0e-92d3-d0b311239f03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a86bd756bf1b1899bab3ab3d1dd1262", "srcset": "https://si.imgix.net/09dab18c/uploads/origins/77250ab0-9e22-4b0e-92d3-d0b311239f03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a86bd756bf1b1899bab3ab3d1dd1262, https://si.imgix.net/09dab18c/uploads/origins/77250ab0-9e22-4b0e-92d3-d0b311239f03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=211afe4155b07b1ad170cc31e6194475 2x, https://si.imgix.net/09dab18c/uploads/origins/77250ab0-9e22-4b0e-92d3-d0b311239f03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a2de180a9cf5e8919e5eb3abc67ef05 3x"}, "body": "こんにちは、私はちょうどあなたの最近のアートワークを見て、私は絶対にあなたのアートスタイルが大好きです！下のリンクにある参考画像のように、私のオリジナルキャラクター/vtuberモデルを描いていただけませんか？私のキャラクターは、茶色のショートヘアの男性的な女性で、目は黄色、首にはポリネシアのトライバルタトゥーがあります。また、彼女はエルフメイジの暗殺者なので、顔の特徴はとても冷たく/無情に見えるはずです。下に参考写真と私のキャラクター参考フォルダをリンクしておきます！\n\nキャラクターリファレンス：https://drive.google.com/drive/folders/1W_bcWjQSmPLmf7eB47BHdmMZoGvqGBju?usp=sharing\n\nhttps://i.pinimg.com/564x/37/d4/d6/37d4d69eb183aad3e76e4c52c8176d5c.jpg", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suttoko_mgmg/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 966387, "client_id": 2041962, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/894a0817/uploads/origins/b0f2285b-cdab-4e3c-b701-79ca78eb0596?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4a89be1d59e0c951322a359e765a865", "srcset": "https://si.imgix.net/894a0817/uploads/origins/b0f2285b-cdab-4e3c-b701-79ca78eb0596?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4a89be1d59e0c951322a359e765a865, https://si.imgix.net/894a0817/uploads/origins/b0f2285b-cdab-4e3c-b701-79ca78eb0596?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3d2121082f0668e58fa05f0741f967c 2x, https://si.imgix.net/894a0817/uploads/origins/b0f2285b-cdab-4e3c-b701-79ca78eb0596?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0468960d70022fe28bb24435c1229927 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/894a0817/uploads/origins/b0f2285b-cdab-4e3c-b701-79ca78eb0596?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1985eb6640652e1e11bda142669a3af0", "srcset": "https://si.imgix.net/894a0817/uploads/origins/b0f2285b-cdab-4e3c-b701-79ca78eb0596?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1985eb6640652e1e11bda142669a3af0, https://si.imgix.net/894a0817/uploads/origins/b0f2285b-cdab-4e3c-b701-79ca78eb0596?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=202b363cd5d49ddbd8a708a453992202 2x, https://si.imgix.net/894a0817/uploads/origins/b0f2285b-cdab-4e3c-b701-79ca78eb0596?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16454f48c4a9cdf9ca60168af2d57807 3x"}, "body": "初めまして。\nいつもお世話になっております。\nスケブを開かれているのを目撃し慌ててリクエスト送らせて頂きます。\n\nお願いしたいのはCoC『ジャンヌの猟犬』HO3:司祭の自探索者の一枚絵又はアイコンサイズイラストです。\n食べるのが好きな子なので、妖しくも幸せそうな恍惚とした表情だと私がにっこりしてしまいます。\n\n拝見したところ未通過だと思われますので、秘匿に関わらない範囲でお伝えさせて頂きます。\n\n・基礎情報\n名前:Miel GOURMANXURE\n読み:ミエル・グルマンズュール\nMiel:蜂蜜\nGourmanxure:暴食×色欲(造語)\nCC#725889にせむらさき\n性別:男\n身長:176cm\n体重:58kg\n年齢:26\n出身国:フランス\n職業:司祭\n\n☆外見的特徴\n・顔から首(向かって右側)に火傷痕\n・瞳\n右眼(向かって左):興奮すると赤茶から赤く見える+十字のハイライト(瞳孔)\n左眼(向かって右):疎まれやすい金色\n切れ長+普段包帯を巻いている\n下まつげは美味しい\n・口\n普段閉じるorやや開き\n開けると八重歯が覗く\n・髪の毛\n黒髪・後ろを三つ編みに結っている。\n+紫色のリボンを三つ編みの根元につけている。\n普段長めの前髪を向かって右側に流している\n・司祭服+白手袋\n\n☆内面\n人に御飯を食べてもらうことが好き。シチューやカレーなどを作っては孤児や村人達に振舞っている。\n本人も食を楽しむことが好きで、限りある食材をいかに美味しく調理し食べられるかを考えることも好き。\nしかし、何よりも好む食材は所謂『ゲテモノ』と呼ばれる物で昆虫や獣肉。\nキモイと思うものほど美味しい。\nこの世の全ての物を喰らい味わいたいという欲求を抱えている。\n\n☆イメージソング\nDannie May『暴食』\nhttps://youtu.be/mk9qxTcQ0wM\n\n☆参考画像 \nhttps://twitter.com/YS_takasima/status/1686026061660696576?t=4V0wIdy97e7Qx26ET9kt6w&s=19\n(ポイピクを使用している関係上二度手間になってしまい申し訳ございません。)\n\nお受けして頂けましたらとてもとても光栄です。\n可能でしたら、個人使用目的でのグッズ化(印刷/アクリルパネル)の可否を回答していただけますととても助かります。\n\n何卒よろしくお願い致します。", "nc": 144, "word_count": 0,