971ae-4958-4ae0-b4af-e22ec3186593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9183d25b0085d8a389803cf6ee498ef", "srcset": "https://si.imgix.net/e69b3ccd/uploads/origins/436971ae-4958-4ae0-b4af-e22ec3186593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9183d25b0085d8a389803cf6ee498ef, https://si.imgix.net/e69b3ccd/uploads/origins/436971ae-4958-4ae0-b4af-e22ec3186593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7acda8bb6e7a6d88aa827eea27da13cf 2x, https://si.imgix.net/e69b3ccd/uploads/origins/436971ae-4958-4ae0-b4af-e22ec3186593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=307cbb0c125a4b5dd4d8762aa5cab233 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e69b3ccd/uploads/origins/436971ae-4958-4ae0-b4af-e22ec3186593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1817983afe63a68739d3a05192f41e03", "srcset": "https://si.imgix.net/e69b3ccd/uploads/origins/436971ae-4958-4ae0-b4af-e22ec3186593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1817983afe63a68739d3a05192f41e03, https://si.imgix.net/e69b3ccd/uploads/origins/436971ae-4958-4ae0-b4af-e22ec3186593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c7e650fb8b5463d9b69634bb1eff3cab 2x, https://si.imgix.net/e69b3ccd/uploads/origins/436971ae-4958-4ae0-b4af-e22ec3186593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=018ed525696da4892dd0478f7cc4a217 3x"}, "body": "あくつき様こんにちは\nこーほく(古山)と申します\n\nURLの様なキャラのフィギュアを販売中で、新作モチーフを必要としています\nヘッダーの女の子が可愛かったのでリクエストさせていただきました。\n\n南国の無邪気な薄着少女のキャラを、等身は12歳くらい、裸足の全身画をお願いします\nhttps://drive.google.com/file/d/1nwJ55U55jM8KS5ACtXndjRf7x9bagzGA/view?usp=sharing\n\nキャラデザ的なリクエストなのですが\nもしよろしければご検討下さい。\n\n着衣は下記イラストくらいの、裸に布をまとって結んだくらいのごくシンプルな感じでお願いします\nイメージとしては奴隷服とか原始人服くらいのざっくりしたデザインで。\n完全な水着やズボン形状は避けて下さい\n\nhttps://skeb.jp/@TN_D75/works/11\n\nhttps://skeb.jp/@hommakai910/works/29\n\nhttps://skeb.jp/@tibiMALINO/works/11\n\nhttps://skeb.jp/@173_trpg/works/1\n\nhttps://skeb.jp/@natou3wari/works/2\n\nhttps://skeb.jp/@heibonkaeru/works/5\n\nhttps://skeb.jp/@e_crsm/works/5\n\nhttps://skeb.jp/@miyakon22/works/27\n\nhttps://skeb.jp/@618kazeman/works/7\n\n10cmくらいのフィギュアを予定しており、細かいディテールは再現できないので全体のシルエット重視でお願いただければと思います\n\nシチュやポーズで「はいてない」「腋乳」等フェチポイントを表現してくれるとうれしいです\n\n衣服とフェチポイント以外の、キャラそのものはお任せします。\n迷ったらお好み・お得意なもの・マイキャラ等を当てはめて下さい\n\n背景はありでもなしでもOK\n\n衣装や髪の見えない方向(背中等)からのごく簡単なラフ画もあると嬉しいです\n\n\nもしよろしければご検討お願い致します\n\nhttps://drive.google.com/file/d/1nwJ55U55jM8KS5ACtXndjRf7x9bagzGA/view?usp=sharing", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 138817, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "壽@skeb募集中", "screen_name": "bukitikikaku", "avatar_url": "https://pbs.twimg.com/profile_images/1377123448569307146/iebZ7W4B.jpg", "header_url": "https://pbs.twimg.com/profile_banners/938843350160982016/1677470029/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 25, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 177}, {"id": 1304959, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "roda Skeb", "screen_name": "roda_desu", "avatar_url": "https://pbs.twimg.com/profile_images/1757755077245489152/COo-p7Vc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1411197049396076545/1772037886/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "comple