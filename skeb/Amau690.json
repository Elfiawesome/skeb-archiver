&h=200&blur=200&s=08a6988e5f7d4d1d58587772d0e9ff91", "src_set": ""}, "body": "あまうさん！いつもお世話になっております、金餅糖です！\nskeb開けたのを知ってすぐにこの文章を作成しているので、何か不手際がありましたらすみません！💦\n\n\nよかったら、うちの子の中で気になる子とか好きな子がいたら描いていただけませんでしょうか？\nうちの子誰が好きなのかとかなかなか聞けないので、この機会に聞いてみたいな〜と思ってリクエストしました…！\n\n特にいなかったら、あまうさん宅のヘクテレを描いていただきたいです！新規絵…見たいなあ…とひっそり思っているので………\n\n\nお手隙の時で構いませんので、よろしければリクエスト受けていただけると嬉しいです。\nいつもありがとうございます！健やかに過ごせますよういつもお祈りしてます〜！\n\n\n自創作っ子まとめ\nhttps://drive.google.com/drive/folders/1F7rq3SNDbqU6NaQgogzOawZWSb-81RdI", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Amau690/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/af72b15d/uploads/origins/c590a5a3-6df6-48f0-9194-d35aa20e2ef2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a751497327b3487f5d5731ab9413fe8", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2252949, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Amau690/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2252949, "client_id": 2511140, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0be6bde/uploads/origins/c402f145-0190-42f2-9e77-cf50658381f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb65e936a1c7ee2274eaef35a6ae8088", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0be6bde/uploads/origins/c402f145-0190-42f2-9e77-cf50658381f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8059adf658672a2277df2108fa06d0f", "src_set": ""}, "body": "あまうさんお世話になっております、じゅみです…！\nもしよければうちのロキを描いていただきたくご連絡しました、何度もすみません……🙇‍♂️\n\nもし可能であればなにか簡単なお洋服のデザインをお願いしたいです…！\n(※特に凝ったものをというわけでも立ち絵がいいとかでもなく、なにかお好きなものを着せて自由に描いていただければと思います。)\n\nとくに希望や指定はありませんがイメージカラーの赤(ワインレッド)や黒が入ってるとありがたいです…！\n\n念の為外見の特徴等記載させていただきますが、以前かいていただいているのでなんとなくで大丈夫です…！\n\n▶ロキ(15)160cm/♂\nツリ目ツリ眉で目は大きめの幼い顔で静かに微笑む感じの大人びた表情が多く、まつ毛の描写はほぼなくて目のハイライトもないです。 黒、金のオッドアイでモノクルをしてます。\n\nご迷惑のないよう個人利用の範囲のみで使用させていただきたく思います。\n資料は必要なところだけ見ていただければ大丈夫です。\n\n長くなりましたが、もしよければご検討いただければ嬉しいです、よろしくお願いいたします🙇‍♂️\n\nhttps://x.com/JYUMI_VK/status/1777283992410337477?t=ukn10cqyLdw9tSYdnQuDQg&s=19", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Amau690/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1cb44d33/uploads/origins/82d9ea45-1e49-4001-a542-eed8e0c64963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e14e5184c4d6dc81eaf7828b2c043ce", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2252949, "client_id": 3319377, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Amau690/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2252949, "client_id": 1538947, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b1f7bee3/uploads/origins/10462448-3144-44ef-a2dd-79af74c17106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f09da3d2ac9c936b6ff85c8947e13d36", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1f7bee3/uploads/origins/10462448-3144-44ef-a2dd-79af74c17106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f469e8fc25bcdb50f1aa93e6792279ca", "src_set": ""}, "body": "お世話になっております、金餅糖です！\n\nうちの子のFAをいつもありがとうございます…！毎度素敵な絵ばかりでとても嬉しかったので、skebでもお願いしてみたく今回リクエストいたしました！\n\n\n内容としましては、フィデル×ルークス(アタナシオス)、またはリコリス×ヴェリテのイラストを希望しております。\nどちらかお好きな方をお選びください！\n\n構図や背景等の指定はございませんので、そちらも自由に描いていただけると助かります…！\n\n\n資料についてはこちらです↓↓↓\n\nフィデル×ルークス\n(突貫で作ったので資料ごちゃごちゃしてますすみません🙇‍♂️💦)\nhttps://drive.google.com/drive/folders/1-3AP1NoOd1URNEutugkj20dnHNl7mUZ5\n\nリコリス×ヴェリテ\nhttps://drive.google.com/drive/folders/1-0SZ6eOAelmGDPdgwX7CWdE2KKTm0D2B\n\n\n服装に関してはそれっぽければ改変していただいて大丈夫です🙆‍♀️\n特にフィデルとルークスは服装が定まっていないので、側近っぽい、皇太子っぽい服装だったら良いので資料のものと全く違うものを着せていただいても構いません！\n\n\n本当にいつもFAくださったり、イラストや自創作の語りに反応いただけて大変励みになっております！\nヘクテレの供給もいただけてほくほくしております、ありがとうございます…！！！\n\n\nこのリクエストが不都合だったり、問題があった場合はキャンセルをお願いいたします。\n長くなりましたが、お読みいただきありがとうございました！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Amau690/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2252949, "client_id": 1757244, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8cd9bdc0/uploads/origins/7e037377-ab97-4ec3-9d54-0c27158c8bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ff1912639a97c663596a013b231af5a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8cd9bdc0/uploads/origins/7e037377-ab97-4ec3-9d54-0c27158c8bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70004904fb08334d580bf6304c5905d4", "src_set": ""}, "body": "いつもお世話になっています。\n私の自創作のカプ、あきみかをお願いしたいです。\n仲のいい温度感でそれ以外はご自由にお任せします。\nよろしくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Amau690/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/df03b35b/uploads/origins/c8cee87