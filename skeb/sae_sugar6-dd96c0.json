.net/656daea0/uploads/origins/e308fa74-e0b2-4b64-bad5-d0c1f067c6b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0cdcc6a1c870c88194a6f575493a064c 2x, https://si.imgix.net/656daea0/uploads/origins/e308fa74-e0b2-4b64-bad5-d0c1f067c6b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2187abb4ee24b770abef07867e7b3068 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/656daea0/uploads/origins/e308fa74-e0b2-4b64-bad5-d0c1f067c6b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=192102e464b35f67c31c50ee00ad2b61", "srcset": "https://si.imgix.net/656daea0/uploads/origins/e308fa74-e0b2-4b64-bad5-d0c1f067c6b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=192102e464b35f67c31c50ee00ad2b61, https://si.imgix.net/656daea0/uploads/origins/e308fa74-e0b2-4b64-bad5-d0c1f067c6b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=beceb047c38471d15f5b0dcb2ebe5cd8 2x, https://si.imgix.net/656daea0/uploads/origins/e308fa74-e0b2-4b64-bad5-d0c1f067c6b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b8956befc1b3d7308aa55f2aafecc967 3x"}, "body": "私が幼い頃に見た悪夢をリクエストしたいです。 11歳の時に経験した悪夢です。\n\n1. 私より一つ年下、つまり10歳の男の子にカッターナイフで口の中を切り裂かれる悪夢でした。\n\n2. 男の子はきれいでしたが、男の子に見えて、黒髪に青白い肌、そして黒ゴシックロリータのドレスを着ていました。 男の子なのに女の子の服を着ていました。とても怒った表情でした。\n\n3. 状況は私が男の子をからかって、怒った男の子がカッターナイフを持って私の口の中をナイフで切ることだったと思います。\n\n4. 場所は私の家、つまり平凡な家庭でした。 私が椅子に座っていて、男の子は私の隣に立っていました。 そうするうちに、私が男の子をからかって怒ったあいつがナイフを取り出したのだと覚えています。\n\n読んでからさえさんが思った通りに描いてください！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sae_sugar6/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 729357, "client_id": 2627367, "vtt_url": null, "thumbnail_image_urls": {"src": "https:/