m=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7b5b9604ac1d340d988e7e9a049f2a5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c8076f8/uploads/origins/86a52628-460f-460d-b71f-b210181678bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97f46535b9f2329ea983ff624b04808c", "srcset": "https://si.imgix.net/7c8076f8/uploads/origins/86a52628-460f-460d-b71f-b210181678bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97f46535b9f2329ea983ff624b04808c, https://si.imgix.net/7c8076f8/uploads/origins/86a52628-460f-460d-b71f-b210181678bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=329a5a92dabab5e9f755466d86dc5d38 2x, https://si.imgix.net/7c8076f8/uploads/origins/86a52628-460f-460d-b71f-b210181678bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=028069d5d5088ca0172fba3eb19c04b3 3x"}, "body": "慈乃さん！こちらでは初めまして、いつもお世話になっております。\n慈乃さんの描くかわいいキャラクターたちが大好きで、もしよければとリクエストをしに参りました。\n\nもしよければ、TRPG（クトゥルフ神話TRPG6版）の自キャラクター『阿木 博人』をお願いできますでしょうか？\n・20代前半の大学院生、雪国出身\n・幼年の頃から宇宙飛行士を目指しており、趣味・勉学ともに興味関心を強く持っている\n　地頭がよく、熱心に研究に臨むこともしている\n・おしゃべりが好きで人懐っこく、普段からよく笑顔を浮かべる\n　年齢のわりに子供っぽく、無邪気にはしゃぐこともある\n・同年齢の生徒のみならず年上の先輩や先生とも親しみ深い\n※使用用途としては、ごく個人的な観賞のみになります\n※シチュエーションの厳密な指定はありません、慈乃さんの自由なイメージで描かれているのが見たいので…！\n\n外観の参考資料としてURLを付属させていただきましたが、必ずしも参考資料通りの衣装である必要はありません。\n慈乃さんの方で自由にデザインした衣装を着せて頂くなどしても構いませんので、好きに描いていただけると幸いです。\nご検討よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1H0fMwmMws1kkOxo6olsEGK6GWw6N-b8v?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kenyoutei_hi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1334280, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ae26341/uploads/origins/546890dc-9159-4718-b8fa-94841413afc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b551e80c25d2ff3bca728cb59282bb1", "srcset": "https://si.imgix.net/8ae26341/uploads/origins/546890dc-9159-4718-b8fa-94841413afc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b551e80c25d2ff3bca728cb59282bb1, https://si.imgix.net/8ae26341/uploads/origins/546890dc-9159-4718-b8fa-94841413afc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf6824ff489b91867309cec9e97f3246 2x, https://si.imgix.net/8ae26341/uploads/origins/546890dc-9159-4718-b8fa-94841413afc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bdd0db98b56fe5dda22840e68aad795 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ae26341/uploads/origins/546890dc-9159-4718-b8fa-94841413afc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f8e4c8bc504caf2c266b32d5258ee63", "srcset": "https://si.imgix.net/8ae26341/uploads/origins/546890dc-9159-4718-b8fa-94841413afc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f8e4c8bc504caf2c266b32d5258ee63, https://si.imgix.net/8ae26341/uploads/origins/546890dc-9159-4718-b8fa-94841413afc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=89eb237085571d12c0babb80b136a30e 2x, https://si.imgix.net/8ae26341/uploads/origins/546890dc-9159-4718-b8fa-94841413afc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d49ed49742b7c56a71177f55e1224a3d 3x"}, "body": "先日は代理ちゃんを描いていただきありがとうございました。慈乃様の絵柄が大好きなので、またお願いしたくリクエストをお送りしています。\n今回は前回と服装を変えた①全身絵②デフォルメ絵の二種類をお願いしたいです(金額不足でしたら再送要請をしていただければと思います)。\n\n①全身等身絵\n紫と黄色のオッドアイ、目の下のほくろ、丸眼鏡、前髪ぱっつん、髪色、インナーカラーは前回と同じにしてください(目の色、髪色、インナーカラーはその色と分かれば多少の彩度上げ下げはOKです)。\n胸の大きさは平均的な女性のサイズくらいにしてください。後髪は前回よりも長くして欲しいですが、具体的な長さや髪型アレンジはお任せします。\n服装は中華風で肌の露出少なめ、髪飾りやピアス等のアクセサリーもお好きにじゃらじゃらとつけてください。好きな色であるミントブルー(某すみっコにいるとかげさんのような色)を、アクセサリーや服のどこかに差し色として使ってくれたらうれしいです(バランスを考えて難しければなしで問題ありません)。\n全身が切れることなければ、ポーズはお任せします。\n\n②デフォルメ絵\n①の全身等身絵をデフォルメした絵を描いていただきたいです。こちらも全身が切れなければ、ポーズはお任せします。\n\n①、②共に文字なし、背景透過(人物のみ)のデータもいただきたいです。使用用途としてはミスキー、旧Twitter(現X)、YouTube等のSNSアイコン、代理ちゃんを紹介するときの資料として使う予定です。また個人的に楽しむ用にグッズ作成を依頼する可能性もあります。使用禁止のものがある場合はpsdファイル内に記載していただければ、禁止のものには使用しません。\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1_0tW1w0FMNPwufwxH680jj0F2DR-JPGo/view?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kenyoutei_hi/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1bbe1950/uploads/origins/43a3d0d4-0e8b-43c0-8d8f-4d7a796642e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=acb5291b109c0c6549581fbc1f29d100", "srcset": "https://si.imgix.net/1bbe1950/uploads/origins/43a3d0d4-0e8b-43c0-8d8f-4d7a796642e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=acb5291b109c0c6549581fbc1f29d100, https://si.imgix.net/1bbe1950/uploads/origins/43a3d0d4-0e8b-43c0-8d8f-4d7a796642e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f09c248124803a9483dd7c9542256a5b 2x, https://si.imgix.net/1bbe1950/uploads/origins/43a3d0d4-0e8b-43c0-8d8f-4d7a796642e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a0e266dc773509e600b9eea9341aff48 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1334280, "client_id": 639110, "nc": 129}, {"path": "/@kenyoutei_hi/works/1", "private_thumbnail_image_urls": null, "private": false, "ge