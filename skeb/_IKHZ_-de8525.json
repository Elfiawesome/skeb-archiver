=200&blur=200&s=0c50cc33bf1e0b816cac8987b4ef99b1", "srcset": "https://si.imgix.net/cba1a3b2/uploads/origins/d1ab18da-1716-4b84-a0de-62983dbab905?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c50cc33bf1e0b816cac8987b4ef99b1, https://si.imgix.net/cba1a3b2/uploads/origins/d1ab18da-1716-4b84-a0de-62983dbab905?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b0f4e08dfc522e47ea4169b9750f6813 2x, https://si.imgix.net/cba1a3b2/uploads/origins/d1ab18da-1716-4b84-a0de-62983dbab905?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a18a2624b80ecea4b3e0afb4b915cb8c 3x"}, "body": "こんにちは！\nふと、沈殿物さんの絵柄で好きな属性の男が見たいな…と思ったのでリクエストを送らせて頂きます。\n※特定のキャラクターではなく、リクエスト内容に記載している概念全般が好きなため描きやすいデザインで描いて頂けると幸いです。\n\n【描いて頂きたい男の特徴】\n・黒髪短髪\n・太眉\n・目にハイライトがない\n・筋肉質で身長が高い\n・デカい\n・普段は寡黙で表情が変わらなそう\n\n【構図】\n素手で首を絞められ窒息しかけている\n\n【用途】\n個人観賞のみです、定期的に見て喜びます。\n\n構図が難しい場合、こちらを蔑んでいる表情・構図でも大丈夫です\nよろしくお願いします…！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_IKHZ_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 23225, "client_id": 3101081, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1de4bf7d/uploads/origins/c80d1b1c-01b4-4d5c-81e6-dc260e3814db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2db03588d5de24f4d69e48aad82b5c8d", "srcset": "https://si.imgix.net/1de4bf7d/uploads/origins/c80d1b1c-01b4-4d5c-81e6-dc260e3814db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2db03588d5de24f4d69e48aad82b5c8d, https://si.imgix.net/1de4bf7d/uploads/origins/c80d1b1c-01b4-4d5c-81e6-dc260e3814db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2add1762931f62f9c180876ae793a35e 2x, https://si.imgix.net/1de4bf7d/uploads/origins/c80d1b1c-01b4-4d5c-81e6-dc260e3814db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40a8a9fa684b9dfa1970d9d18af27255 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1de4bf7d/uploads/origins/c80d1b1c-01b4-4d5c-81e6-dc260e3814db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63953a224b070a99e823c9709b94aa0c", "srcset": "https://si.imgix.net/1de4bf7d/uploads/origins/c80d1b1c-01b4-4d5c-81e6-dc260e3814db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63953a224b070a99e823c9709b94aa0c, https://si.imgix.net/1de4bf7d/uploads/origins/c80d1b1c-01b4-4d5c-81e6-dc260e3814db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=095647f1cda8b210cf1b7b100a84c3b4 2x, https://si.imgix.net/1de4bf7d/uploads/origins/c80d1b1c-01b4-4d5c-81e6-dc260e3814db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=55176556c35d1de57a475d7076f6c621 3x"}, "body": "こんにちは。いつもイラストありがたく拝見しています。\nクトゥルフ神話TRPG用のシナリオを作成しようと考えており、そこに登場するキャラクターを描いていただきたくリクエストを送らせていただきました。\n\n【キャラ詳細(資料URL添付あり)】\n・褐色\n・半獣の姿：下半身はヤギのような足で、蹄（ひづめ）がある。\n・体の一部に毛が生えており、特に肩や背中、腕に多く見られる。\n・髪は長く、肩まで伸びている。\n・耳が尖っており、エルフのような形をしている。\n・モチーフ：レンの商人(クトゥルフ神話)\n【構図】\n特に指定はないのでご自由に、描きやすいような形でご対応ください。\n(落ち着いた敬語で喋る想定でいるため、あまり元気な表情にはならないかも。)\n\n用途としては個人観賞のみです。シナリオが一向に最後まで進まないのでモチベーションにさせていただけますと幸いです。\n添付画像について、手癖で細身寄りになっているのですが、全然盛って頂いて大丈夫です。\nまた画像や文中で描写の無い背面をはじめとして分かりにくい箇所や記載のない箇所は自由に想像、改変頂いて大丈夫です。\n御縁がありましたら何卒よろしくお願いします。\n\nhttps://drive.google.com/file/d/15JAYlJPMpB_pPQIBRO3EC3Dv_92LEhNK/view?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_IKHZ_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 23225, "client_id": 947133, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9fac0a59/uploads/origins/53ec9c1e-1884-45ee-a4ea-cda2448f