n\n【依頼内容】\n弊らのエデHO2くんのイラスト\n\n【幣HO2について(ざっくり)】\n愉快で陽気なおじさんです。\nSTRが16あってSIZが18あるでかいいのちです。傷痕のおかげでAPPが4です。\n秘匿に全然関係無いので記します。実年齢：25歳です。\n面白い人間が大好きです。\n好奇心旺盛なイタリア代表のギャルです。\n\n【構図など】\n軽率に指ハートをしたりギャルピースをする表情豊かなギャルなので、そういうキャラ性に沿ったご自由な構図で描いて頂けると嬉しいです！\n私が描くたびに体型の解釈や髪型や服装がころころ変わっていくので\n身体や服装などはご自由に解釈して頂いて簡略化やアレンジなどをしていただいても大丈夫です。\n\n\n気分ではなかったり、問題などがもしありましたら遠慮なく蹴っていただいても全然大丈夫です…！\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/16AkNmuMxdAX9LNr-GhZANmRa9JpJdYJc", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_IKHZ_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 23225, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ca622a0/uploads/origins/aa8b32b5-6aa9-46cf-ba00-41c24c6569f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe2045f3634834602f8b52bef005a967", "srcset": "https://si.imgix.net/1ca622a0/uploads/origins/aa8b32b5-6aa9-46cf-ba00-41c24c6569f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe2045f3634834602f8b52bef005a967, https://si.imgix.net/1ca622a0/uploads/origins/aa8b32b5-6aa9-46cf-ba00-41c24c6569f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af593336f43b7f4fc4406501257b5607 2x, https://si.imgix.net/1ca622a0/uploads/origins/aa8b32b5-6aa9-46cf-ba00-41c24c6569f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5a767f657b3122289bc6ce4b4dd68d2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ca622a0/uploads/origins/aa8b32b5-6aa9-46cf-ba00-41c24c6569f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de99dfe9f59f504977d81342634d5fab", "srcset": "https://si.imgix.net/1ca622a0/uploads/origins/aa8b32b5-6aa9-46cf-ba00-41c24c6569f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=