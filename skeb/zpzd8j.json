つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1559095, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ピピ", "screen_name": "hirunoue", "avatar_url": "https://pbs.twimg.com/profile_images/1924868088262230019/f3nKkqij.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1021411283885625345/1725120765/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 129}, {"id": 1787631, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "GAMI🍵🍊skeb募集中✍✨", "screen_name": "GAMI37260414", "avatar_url": "https://pbs.twimg.com/profile_images/1599365751063707648/l8lY6byd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1221987888633536512/1745145602/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 1}, {"id": 3506408, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "常識人@skeb募集中", "screen_name": "joshikiaru", "avatar_url": "https://pbs.twimg.com/profile_images/1958162230392061952/Tbo47TPq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1603020495217078273/1740231965/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "skills": [{"genre": "art"}, {"genr