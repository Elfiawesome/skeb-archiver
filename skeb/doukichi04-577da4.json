=200&s=2c6360ba96babee37f460592fadfe738 3x"}, "body": "はじめまして\nとても魅力的なスク水や、誰もが憧れるようなシチュエーションに惹かれました\n以下の内容でリクエストさせていただきます\n\n□シチュ\n●プールの授業の為、教室でJC～JKくらいの女子がラップタオルを巻いてスク水にお着替え中のイラスト\n\n・女子は可能であれば何人か描いてもらうと嬉しいです\n・ラップタオルのデザインは、「縦縞の紅白模様」でタオルの丈は短めでサイズはパツパツ気味\n・教室で着替えということで、「早く着替えなきゃ…」という焦りや、恥ずかしがっている表情\n\nその他、自由に表現していただいて構いません\nご多様な中ですが、ご検討よろしくお願いいたします", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@doukichi04/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3475916, "client_id": 2644548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03045bc3/uploads/origins/12621e84-ea99-4ee2-8e9c-e5d1701db651?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37221327465f258adf8ad70630d467fb", "srcset": "https://si.imgix.net/03045bc3/uploads/origins/12621e84-ea99-4ee2-8e9c-e5d1701db651?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37221327465f258adf8ad70630d467fb, https://si.imgix.net/03045bc3/uploads/origins/12621e84-ea99-4ee2-8e9c-e5d1701db651?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c12b0f36d34c3ce24abce579333a8847 2x, https://si.imgix.net/03045bc3/uploads/origins/12621e84-ea99-4ee2-8e9c-e5d1701db651?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73311eadd208950cd89b384994e495be 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03045bc3/uploads/origins/12621e84-ea99-4ee2-8e9c-e5d1701db651?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c44dec0d8bfde3a498f3d374b4a99ba0", "srcset": "https://si.imgix.net/03045bc3/uploads/origins/12621e84-ea99-4ee2-8e9c-e5d1701db651?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c44dec0d8bfde3a498f3d374b4a99ba0, https://si.imgix.net/03045bc3/uploads/origins/12621e84-ea99-4ee2-8e9c-e5d1701db651?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a266c94b34e8c6e8d808291f580f23f6 2x, https://si.imgix.net/03045bc3/uploads/origins/12621e84-ea99-4ee2-8e9c-e5d1701db651?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bd8dcdbb6702ee474a29dc24cf5cbf68 3x"}, "body": "こんにちは。\nスク水少女のイラストを拝見し、大変素晴らしく感じこの度リクエストをさせていただきました。\nもし問題なければ次の内容でリクエストをさせていただきます。\n\n主な内容としては、プール授業中で2～3人程度の少女がプールサイドで横に並んで立っている様子を後ろから見た構図のイラストになります。イメージとしてはプールサイドで休憩している中、ふと前を見上げたら少女たちの魅力的な後ろ姿を見たといった感じです。\n少女たちは小中学生ぐらいをイメージで、太ももから背中辺りが一番魅力的に感じられるような感じでお願いします。\n\nそれ以外の指定の無い部分についてはお任せします。\nよろしくお願いします。", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@doukichi04/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3475916, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a9b05b9/uploads/origins/b8763dff-c372-4863-a400-bc521e5f7b63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=165e42ad3c2a61c85cf2fc14a925cba2", "srcset": "https://si.imgix.net/8a9b05b9/uploads/origins/b8763dff-c372-4863-a400-bc521e5f7b63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=165e42ad3c2a61c85cf2fc14a925cba2, https://si.imgix.net/8a9b05b9/uploads/origins/b8763dff-c372-4863-a400-bc521e5f7b63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b71707831440668a3d158f26c873df21 2x, https://si.imgix.net/8a9b05b9/uploads/origins/b8763dff-c372-4863-a400-bc521e5f7b63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f3c6fd79ee551dfa5c4bcd61582683c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a9b05b9/uploads/origins/b8763dff-c372-4863-a400-bc521e5f7b63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=