://si.imgix.net/2b049cf2/uploads/origins/bfe34fff-1a56-4775-8d26-ee5957eab6db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7363a571ad1662ff5cc15f04fe678003, https://si.imgix.net/2b049cf2/uploads/origins/bfe34fff-1a56-4775-8d26-ee5957eab6db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea19a491c011ef1a7bdee6615a78b0ca 2x, https://si.imgix.net/2b049cf2/uploads/origins/bfe34fff-1a56-4775-8d26-ee5957eab6db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89b59dcd2a6a4b1490b218e081a7bfe8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b049cf2/uploads/origins/bfe34fff-1a56-4775-8d26-ee5957eab6db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a1277713faffc7a0c5726387368e6c5", "srcset": "https://si.imgix.net/2b049cf2/uploads/origins/bfe34fff-1a56-4775-8d26-ee5957eab6db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a1277713faffc7a0c5726387368e6c5, https://si.imgix.net/2b049cf2/uploads/origins/bfe34fff-1a56-4775-8d26-ee5957eab6db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a3b11917572c27438caebf25f3f1afea 2x, https://si.imgix.net/2b049cf2/uploads/origins/bfe34fff-1a56-4775-8d26-ee5957eab6db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa0f60cb4d354ce216119184334c25b8 3x"}, "body": "おはようございます。100の人と申します。いつもなりたみ深いイラストを有り難うございます。\n手数料無料キャンペーンに乗じてリクエストさせてもらいます。\n\nうちよそでちょっと複雑なシチュになるのですが、\n\n⓪不健康さん代理の子と、自分の代理「100の人」(♂・末尾資料参照) が、格安の旅行手段を利用しようとするが\n①それぞれ箱化 (https://skeb.jp/@olz_94/works/3 みたいなタイプ) され\n②さらに (顔が見える方向で) 圧縮されて、四角の厚めの平面・板状になりつつ、人格が染みだしてビンなどに回収される\n③Ⓐ目的地で、取り違えられて箱平面化100の人へ不健康さんの人格が注入されて、そのまま人型に戻る\n③Ⓑ箱平面化不健康さんへ100の人の人格が注入されるが、適合せずに箱平面化状態のまま戻れなくなり、さらに不適合の症状が進んでテカテカ石化な見た目に (石化以外でも良い)\n\nという感じの流れを描いてもらえないでしょうか？\n\n③の入れ替わり後について、目付きなどの外見的特徴は、人格ではなくカラダに依拠する形で、たとえばⒶの100の人 (中身不健康さん) は黒白目、Ⓑの箱平面化不健康さん (中身100の人) は黒白目ではない、という感じでお願いします。\n\nまた、Ⓐの100の人 (中身不健康さん) から吹き出しを出して、吹き出しの中には同じ向きと表情の不健康さんを、\nⒷの箱平面化不健康さん (中身100の人) から吹き出しを出して、吹き出しの中には箱平面化状態の100の人の顔部分を (表情固定のまま) 出して、\n入れ替わっていること、後者は意識があるが表情も動かせないことを表現して欲しいです。\n\n100の人が不健康さんの姿へ変わってしまう要素が含まれていれば、内容をガッツリ変えてもらってもかまいません。\nご検討よろしくお願いします。\n\n\n【100の人についての資料】\n■立ち絵・設定\n↓の右側 (ヒト型)\nhttps://misskey.io/notes/a5eqx6pctrau0089\n■額の宝石やしっぽ部分の3Dモデル\nhttps://virtualcast.jp/items/acacf505a4d84111c58ade19a42772c3851e0083db9e12b3ab79ae6bb019977a\n※しっぽの文字は省略してもらってもかまいません", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@olz_94/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3498001, "client_id": 59943, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23c67892/uploads/origins/b0c5d3e1-7741-4f18-ac63-8d0a71d7e4a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71aa55307502663813ff61629d82cc23", "srcset": "https://si.imgix.net/23c67892/uploads/origins/b0c5d3e1-7741-4f18-ac63-8d0a71d7e4a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71aa55307502663813ff61629d82cc23, https://si.imgix.net/23c67892/uploads/origins/b0c5d3e1-7741-4f18-ac63-8d0a71d7e4a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d6507091ec7767f12f36eb8bd99ad3b 2x, https://si.imgix.net/23c67892/uploads/origins/b0c5d3e1-7741-4f18-ac63-8d0a71d7e4a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d830e37081ebc1fce93240a45e3f832a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23c67892/uploads/origins/b0c5d3e1-7741-4f18-ac63-8d0a71d7e4a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=126a1b0c29bee0a503d8842433666ca3", "srcset": "https://si.imgix.net/23c67892/uploads/origins/b0c5d3e1-