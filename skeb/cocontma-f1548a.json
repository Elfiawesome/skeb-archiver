fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=388e85d83ed3cdea7edfac9c331c6be4, https://si.imgix.net/be979aeb/uploads/origins/a95c3f7d-1a65-4e5f-8347-822cf1b1174c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6934c56b76e724d5c8ed65e9b74e9de9 2x, https://si.imgix.net/be979aeb/uploads/origins/a95c3f7d-1a65-4e5f-8347-822cf1b1174c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d2921f854bc0796dfb816c2e5f3b91dd 3x"}, "body": "こんにちは！あなたの抽象的な背景の作品、本当に大好きです！私のオリジナルキャラクター「Starry Night」を描いていただけないでしょうか？ https://toyhou.se/31117596.starry-night 彼女はフィンセント・ファン・ゴッホの『星月夜』をモチーフにデザインされています！ 宇宙や夜空をイメージした抽象的な背景を添えていただけると嬉しいです。また、もしよろしければ、ご自身の描きやすいスタイルに合わせて、キャラクター自体もより抽象的な表現にしていただいても構いません！♥\n\nご検討いただき、本当にありがとうございます！^^", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cocontma/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1819712, "client_id": 2324077, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7eb19acc/uploads/origins/f027ec25-0a72-41cd-bcd3-ce16c2080505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=125740ed57f7f7f22839f1da3c232cc5", "srcset": "https://si.imgix.net/7eb19acc/uploads/origins/f027ec25-0a72-41cd-bcd3-ce16c2080505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=125740ed57f7f7f22839f1da3c232cc5, https://si.imgix.net/7eb19acc/uploads/origins/f027ec25-0a72-41cd-bcd3-ce16c2080505?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d536c71b99f2727ecb6e268a48a5603 2x, https://si.imgix.net/7eb19acc/uploads/origins/f027ec25-0a72-41cd-bcd3-ce16c2080505?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7428a451ca9facb55bd0db333abd781 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7eb19acc/uploads/origins/f027ec25-0a72-41cd-bcd3-ce16c2080505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=938cf0d417c370935e765dbe4c7bbb6d", "srcset": "https://si.imgix.net/7eb19acc/uploads/origins/f027ec25-0a72-41cd-bcd3-ce16c2080505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=938cf0d417c370935e765dbe4c7bbb6d, https://si.imgix.net/7eb19acc/uploads/origins/f027ec25-0a72-41cd-bcd3-ce16c2080505?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=98802671358f56dc41d80948db34c526 2x, https://si.imgix.net/7eb19acc/uploads/origins/f027ec25-0a72-41cd-bcd3-ce16c2080505?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e73b9ae5bbc32cd8f6a144737cf6195c 3x"}, "body": "こんにちは！あなたの絵、本当に素晴らしいですね！私の双子のキャラクターを描いていただけないでしょうか。二人は対立することもありますが、兄弟としての絆は深いんです。\n\nA（20代、♂、183cm） - 双子の兄。陽気で、頑固、人当たりが良く、エネルギッシュで、優しい。貴族の家の次男。他者を守るために戦う。水を操り、治癒する能力を持つ。彼の魔法は「大洪水」。モチーフ：水、血、ドラゴン、クジラ、ハート、治癒。\n\nB（20代、♀、178cm） - 双子の妹。聡明、頑固、高慢、鋭敏、狡猾。一族の跡取り。虚弱体質で、Aに支えられている。火を操り、幻を解き、真実を見抜く能力を持つが、その魔法は彼女の身体には強すぎて、体を弱らせ、焼いてしまう。彼女の魔法は「炎」。 モチーフ：火、灯台、ドラゴン、煙、ランタン、真実。\n\n傷跡と日焼けした肌にご注意ください。服装や構図はご自由にお決めください。ご検討いただき誠にありがとうございます！もし何か問題があれば、遠慮なくお断りください。\n\nhttps://drive.google.com/drive/folders/1ttVV_-qXlKnArx4re208pPIR9tePW17w", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cocontma/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1819712, "client_id": 2665651, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c3ff990/uploads/origins/7c003dda-f277-4919-bf37-672b40000636?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d212733bb8effc5f7ba393c2e910c7c", "srcset": "https://si.imgix.net/3c3ff990/uploads/origins/7c003dda-f277-4919-bf37-672b40000636?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d212733bb8effc5f7ba393c2e910c7c, https://si.imgix.net/3c3ff990/uploads/origins/7c003dda-f277-4919-bf37-672b40000636?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28bfde65089f84b0690a1445be5083d7 2x, https://si.imgix.net/3c3ff990/uploads/origins/7c003dda-f277-4919-bf37-672b40000636?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b1db2cd8366e6570aad912423bc9ec0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c3ff990/uploads/origins/7c003dda-f277-4919-bf37-672b40000636?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e47531e880e55063a51877d3fe9943d", "srcset": "https://si.imgix.net/3c3ff990/uploads/origins/7c003dda-f277-4919-bf37-672b40000636?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e47531e880e55063a51877d3fe9943d, https://si.imgix.net/3c3ff990/uploads/origins/7c003dda-f277-4919-bf37-672b40000636?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e0b0e0e8f2119da7f7506f7c771bb16b 2x, https://si.imgix.net/3c3ff990/uploads/origins/7c003dda-f277-4919-bf37-672b40000636?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a3e0e55a6cf09b9230a479c38390db5 3x"}, "body": "ここんつま様、はじめまして。白空と申します。\nSilentroom様の楽曲「bornofnolightflicker」のために描いたジャケットを初めて拝見した瞬間からここんつま様をフォローさせて頂いております。作品全体の構図と使用された色彩に、深く感銘を拝受しましたので、今回リクエストを送信させて頂きました。\n\n依頼内容\nもしよければ、私の創作キャラ「無効」を描いて頂くことは可能でしょうか？描いてほしいのは深淵で底知れぬ暗闇に落ちていく場面の無効さんです。\n無効さんは実体です。彼らは自分の好みに応じて外見を変化させ、表現することができる存在である。従って、彼らは性別を持たないため、性別に関する基準を適用することもできません。\n無効さんは無感情の側面（emotional numbness）を表しています。彼らはまったく感情を顔に出さないし、出すことさえできません。心の奥底では、彼らは虚無と絶望の状態を感じています。\n以下が今回希望する外見です。添付リンクをご確認ください。\nhttps://drive.google.com/drive/folders/1JwVQBahutTcAkYXFJa31l2I0uvwCnI1E\n彼らの容姿についてもう少し詳しく書きたいと思います。\n・人間のような外見であってほしい\n・無表情な顔があり\n・身長は180cmに相当\n・前髪があり