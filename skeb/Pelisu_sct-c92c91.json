2c4-498c-8432-71196c15c840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd2b82e377a2da25db87ee6527eb207e", "srcset": "https://si.imgix.net/4a3a9cb4/uploads/origins/697406d9-52c4-498c-8432-71196c15c840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd2b82e377a2da25db87ee6527eb207e, https://si.imgix.net/4a3a9cb4/uploads/origins/697406d9-52c4-498c-8432-71196c15c840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0798fd9ad773330e2815e62aa762038 2x, https://si.imgix.net/4a3a9cb4/uploads/origins/697406d9-52c4-498c-8432-71196c15c840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=96926a532d45e0f80c082eda0cf9c033 3x"}, "body": "アイドルマスターシンデレラガールズの小日向美穂ちゃんが、お腹を壊して公衆和式トイレでビチビチの下痢ウンチとおしっこをしているシーンをカラーのイラスト形式で描いて頂きたいです。\n排泄時の効果音（ブリブリなど……）は必ず描写してほしいです。\n\n・排泄時の構図\n他者様の作品で申し訳ありませんが、排泄シーンはこちらのイラスト構図に似せてください（参考URL→https://www.pixiv.net/artworks/96102727）\n\n・服装\n[アタシポンコツアンドロイド]小日向美穂（特訓前）の制服（参考URL→https://imas.gamedbs.jp/cgss/images/hxGtv2sv9HP_CyXWXFqZ_RZb-Wc9eKOyefIM1dmofHc.jpg）\n太ももをまたぐ下着→シンプルな白のパンツ\n靴下→黒のハイソックス\n靴→こげ茶のローファー\n\n・シチュエーションやセリフ、効果音の例\n下校中にお腹を下してしまった美穂ちゃんが、小さなオナラをプリプリ漏らしながら、通学路途中の公園にある和式トイレへ駆け込む。\n急いでパンツを下ろしてしゃがみ込み、苦しそうな表情で踏ん張りながら下痢ウンチとおしっこをビチビチジョボジョボと排泄。\n\n美穂「んん～～っ！　……はぁぁっ……」（ブピブピブリブリブリリリッ！　ジョボボボ……！）\n\n以上になります。\nもし金額不足している場合は再送させていただきます。\nまた、どうしても厳しい場合はキャンセルしていただいてまったく問題ございません。\n是非、ご検討の程、よろしくお願いいたします。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pelisu_sct/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d87187ef/uploads/origins/ea83a992-feaf-4a5a-90f7-bb8440f20042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a85cf34e91cb3c9cdd6dc6dd45c2afe", "srcset": "https://si.imgix.net/d87187ef/uploads/origins/ea83a992-feaf-4a