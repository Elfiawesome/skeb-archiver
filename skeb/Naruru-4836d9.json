みたのサムネイルを描いて頂けたらと思いリクエスト送らせて頂きました。\nはじめてのスケブ依頼なので不備や不足点ありましたら申し訳ありません。その場合はリクエスト拒否して頂いて問題ありません。\n\n【使用用途】\n・YouTubeでの歌ってみたのサムネイル\n（収益化チャンネルですが歌は収益化しておりません）\n\n\n【希望内容】\n・曲：目指せポケモンマスターに使用させていただきます\n・愛上、ピカチュウがいるのが希望です。\n・16:9の横サイズ\n・可能でしたら人物、ポケモン、背景はレイヤー分けお願い出来たらと思います！\n・服、髪型、構図は先生のお好きなようにお任せでおねがいしてもよろしいでしょうか。\n・参考までに立ち絵リンク添付させていただきます。（最新のお洋服と髪型は線画のものです。目の色が線画の色に変更になっているのでお気を付けください）\nご検討のほどよろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/1GK7jQJPY4TWeTtOIASWP4bVJWWPVWYdo?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Naruru/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3387548, "client_id": 2810562, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/849d2338/uploads/origins/0f68ec37-4570-488a-ba03-5f897217a48e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dae91adf472adf5ee79279dc83c97d38", "srcset": "https://si.imgix.net/849d2338/uploads/origins/0f68ec37-4570-488a-ba03-5f897217a48e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dae91adf472adf5ee79279dc83c97d38, https://si.imgix.net/849d2338/uploads/origins/0f68ec37-4570-488a-ba03-5f897217a48e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0e7ab591994dce6cdc1897b84eba760 2x, https://si.imgix.net/849d2338/uploads/origins/0f68ec37-4570-488a-ba03-5f897217a48e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bba2418a73719db48a1bb0184cc04cd0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/849d2338/uploads/origins/0f68ec37-4570-488a-ba03-5f897217a48e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f53e6cec70931a6d4b29dfb6d8aa9881", "srcset": "https://si.imgix.net/849d2338/uploads/origins/0f68ec37-4570-488a-ba03-5f897217a48e?bg=%23fff&auto=for