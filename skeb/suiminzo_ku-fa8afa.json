5171 ]、ひなはフリルやリボンが着いた少女らしい水色の下着[ https://www.pixiv.net/artworks/64798264 ]を希望\n\n背景は明るくポップな感じの簡易的な模様の背景でお願いします", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suiminzo_ku/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2600555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/628666e3/uploads/origins/978f42d1-985e-4059-978f-fb324c5bcb6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=236b1da81778b09214b0746098fd48b0", "srcset": "https://si.imgix.net/628666e3/uploads/origins/978f42d1-985e-4059-978f-fb324c5bcb6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=236b1da81778b09214b0746098fd48b0, https://si.imgix.net/628666e3/uploads/origins/978f42d1-985e-4059-978f-fb324c5bcb6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7aaf95b5c42a487df13834397ddbf94 2x, https://si.imgix.net/628666e3/uploads/origins/978f42d1-985e-4059-978f-fb324c5bcb6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b433345dddeb24216b63427b66bdb530 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/628666e3/uploads/origins/978f42d1-985e-4059-978f-fb324c5bcb6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5bc956d875ee54520bec0751ce917c3", "srcset": "https://si.imgix.net/628666e3/uploads/origins/978f42d1-985e-4059-978f-fb324c5bcb6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5bc956d875ee54520bec0751ce917c3, https://si.imgix.net/628666e3/uploads/origins/978f42d1-985e-4059-978f-fb324c5bcb6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9dbab895a0df4d6609747ab7f87ccb86 2x, https://si.imgix.net/628666e3/uploads/origins/978f42d1-985e-4059-978f-fb324c5bcb6b?bg=%23fff&auto