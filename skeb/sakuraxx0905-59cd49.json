: "maple様初めまして♡\n初めて依頼を送るものです！\n依頼のやり方が不十分で申し訳ないです…。\n\n依頼内容→アイコンサイズ\n髪の毛→レイヤーボブ(肩までです！)色は黒です\nカチューシャ→首にリボン結びでお花柄模様です！(レースの手編みのカチューシャです！)\n服装→お任せします！\n好きな小物→桜とかいちごとか描いてくださると嬉しいです…！(無理に描かなくても大丈夫です！)", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakuraxx0905/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1701321, "client_id": 3593068, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/efc5d325/uploads/origins/1a5675c5-aa6c-4433-94d1-c7f984c2cea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa251ddc96cad2776256045c6b1d1436", "srcset": "https://si.imgix.net/efc5d325/uploads/origins/1a5675c5-aa6c-4433-94d1-c7f984c2cea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa251ddc96cad2776256045c6b1d1436, https://si.imgix.net/efc5d325/uploads/origins/1a5675c5-aa6c-4433-94d1-c7f984c2cea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7fef96f60a09458631781b8be3c6ab8 2x, https://si.imgix.net/efc5d325/uploads/origins/1a5675c5-aa6c-4433-94d1-c7f984c2cea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6517d8453e539db4bea4da478cd2df40 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/efc5d325/uploads/origins/1a5675c5-aa6c-4433-94d1-c7f984c2cea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81bb497b03baeae6e0b0172c48231924", "srcset": "https://si.imgix.net/efc5d325/uploads/origins/1a5675c5-aa6c-4433-94d1-c7f984c2cea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81bb497b03baeae6e0b0172c48231924, https://si.imgix.net/efc5d325/uploads/origins/1a5675c5-aa6c-4433-94d1-c7f984c2cea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e3a67ceed78f2ead895c8a