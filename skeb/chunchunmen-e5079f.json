&s=eb2e2ec112e1f00e077104449b342e16 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 259674, "client_id": 101704, "nc": 144}, {"path": "/@chunchunmen/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 259674, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3774f55a/uploads/origins/25823725-4e52-4f54-8463-20602d5d43f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9817d9146c7401b65f1a919f5f539c01", "srcset": "https://si.imgix.net/3774f55a/uploads/origins/25823725-4e52-4f54-8463-20602d5d43f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9817d9146c7401b65f1a919f5f539c01, https://si.imgix.net/3774f55a/uploads/origins/25823725-4e52-4f54-8463-20602d5d43f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cda1b53035d9b92ca74527c26f8f20b 2x, https://si.imgix.net/3774f55a/uploads/origins/25823725-4e52-4f54-8463-20602d5d43f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=234acb75487ae7f3eb915393a23d952e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3774f55a/uploads/origins/25823725-4e52-4f54-8463-20602d5d43f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3364099f418daf5ad5e6a38ab7425ae2", "srcset": "https://si.imgix.net/3774f55a/uploads/origins/25823725-4e52-4f54-8463-20602d5d43f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3364099f418daf5ad5e6a38ab7425ae2, https://si.imgix.net/3774f55a/uploads/origins/25823725-4e52-4f54-8463-20602d5d43f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d4ebf898ebebd4c67b662e95043c1a53 2x, https://si.imgix.net/3774f55a/uploads/origins/25823725-4e52-4f54-8463-20602d5d43f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=86822cc0e61242d7169be1c530759121 3x"}, "body": "改めまして､先日はありがとうございました｡\n\n並びに引き続きお願いしようと思い､こちらのちょっとした失敗によりキャンセルした事をお詫び申し上げます🙇\n\nあの中での神高くんと友沢くんのやり取りの続きであるラストについて再び馳せ参じました｡\n\nプールサイドでくつろいてる最中､頭の上のサングラスを取り上げられて少し驚くも､こんな事で奪い返したとでも言うつもりかと言う友沢くんの問いに『返して貰うのは再び真剣勝負で自分が勝った時と決めており､改めて預けておく』と言いながらサングラスを返す神高くん｡\n\nそして『こんな所で油を売ってる暇があるなら…』など『お前こそ腕は落ちてないんだろうな?』などと挑発し合い『パワフェスの大会が終わった時こそ再戦と行こう!』と､神高くんは宣戦布告してくる｡\n\nそれに対して友沢くんは『今は手を組み優勝を目指す仲であり､休息のひと時でもある』と言いながらビーチチェアから立ち上がり…!\n (ヒョイッ!)\n\n｢そんな訳でコイツは頂くぜ!｣\n\n｢あーっ!ぼ､僕のオレンジジュースをーっ!!い､いくらお前でもそれは許さないぞーっ!!｣\n\nサングラスのお返しとして､友沢くんがテーブルに置かれてる神高くんの飲み物を横取りし､それに対して神高くんが怒って奪い合いを始めてしまい､周りから見たら『じゃれ合い』と称される2人のドンデン返しを絵にして頂けたらと思っております｡", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chunchunmen/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 259674, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68e15f03/uploads/origins/566b2e05-d5d3-4b4e-bdcf-503bccee3886?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fca106fd3aa0d27e5300b4071f3ed4eb", "srcset": "https://si.imgix.net/68e15f03/uploads/origins/566b2e05-d5d3-4b4e-bdcf-503bccee3886?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fca106fd3aa0d27e5300b4071f3ed4eb, https://si.imgix.net/68e15f03/uploads/origins/566b2e05-d5d3-4b4e-bdcf-503bccee3886?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77d59d46a38ffffe50216ffe1a640584 2x, https://si.imgix.net/68e15f03/uploads/origins/566b2e05-d5d3-4b4e-bdcf-503bccee3886?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9f3b653556ddfe76b7a1afc2f7dd074 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68e15f03/uploads/origins/566b2e05-d5d3-4b4e-bdcf-503bccee3886?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200