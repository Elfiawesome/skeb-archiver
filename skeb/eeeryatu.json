ull, "private": false, "genre": "art", "tipped": false, "creator_id": 2060618, "client_id": 1185459, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c67bba36/uploads/origins/7936b3bc-63f8-4038-b407-b9ff48e8c317?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb98af6f292e79bb3f55773031e88dd1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c67bba36/uploads/origins/7936b3bc-63f8-4038-b407-b9ff48e8c317?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=140e36316536fdb4c4eb63ccd0bd8f85", "src_set": ""}, "body": "こんにちは！また依頼したいです。ffxivのキャラクターを2人描いてもらいたいです！\n\n二人が裸でセックスさせられているところを描いてほしいです。二人の男が二人を貫いていて、二人は他の男たちに囲まれていて、その男たちもチンコを出している。きれいなバージョンと、ザーメンまみれでクリームパイズリされているバージョンも見てみたい。彼らの顔や大きな胸についたザーメンも見てみたい。\n\nその他はお任せします。受けてくれたらありがとう！\n\nhttps://imgur.com/a/izazanh-denma-yAC9qQv\n\nhttps://imgur.com/a/zana-nhagi-3cVufP5", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eeeryatu/works/71", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b0ff0fbf/uploads/origins/be55b8c9-74f5-4e36-82f6-1c89621e0a3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60ae64fe96141a3844c2cc5e45833215", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2060618, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@eeeryatu/works/70", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2060618, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa967a9f/uploads/origins/72007841-d643-4ccb-88fb-2100f1d631b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4844796a77ca15f3319fcb72d88b55a8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa967a9f/uploads/origins/72007841-d643-4ccb-88fb-2100f1d631b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eaea0e80c1469f6613bebf7b7aa1f762", "src_set": ""}, "body": "お世話になります。\nこちらの内容でイラストを依頼します。\n\n【依頼内容】\n◎キャラクター\n有栖川夏葉（アイドルマスターシャイニーカラーズ）\n\n◎シチュエーション\n悪徳スポンサーに脅されて強要された、不本意な枕営業\n\n◎細かい条件など\n夏葉の格好・髪型はs-SSR【THE IDOL】のパーティードレス姿。\nhttps://x.com/imassc_official/status/1914922184201658480\nhttps://www.pixiv.net/artworks/129466470\n乳を露出（片方か両方かはおまかせ）、ドレスの下はショーツ無し。\n涙目の悔しげな表情。\n\n竿役は中年オヤジ。太った体型で、格好は全裸。\n\nベッドの上で、松葉崩しのセックス。\n↓のような構図（結合部が見えるアングル、シーツを掴んで耐える夏葉）。\nhttps://www.pixiv.net/artworks/105858846\n\n行為中（可能なら数枚）・射精・事後までの一連の流れで、差分の作成をお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eeeryatu/works/69", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/63a3b738/uploads/origins/e699cf7f-f834-4b3e-a96a-0a0e0980aacf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff3e2e272ccaeda29ef6ae638aaaf8dc", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2060618, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@eeeryatu/works/68", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2060618, "client_id": 2990634, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.im