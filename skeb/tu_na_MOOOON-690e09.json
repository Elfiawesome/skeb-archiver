google.com/file/d/1RlL_ybrMdW5dGuahPjgGVy71KSoR8jJn/view?usp=drivesdk\n\n双剣もしくはAR(APEXの301カービンのような:https://w.atwiki.jp/apexmobile/pages/17.html)を構えている内容でお願い出来れば嬉しいです\n\n長文になってしまいましたが、検討いただけたら幸いです。\n宜しくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tu_na_MOOOON/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3140758, "client_id": 3654613, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47e44a88/uploads/origins/69faf54b-4675-4f46-870a-0cc23304200e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c8cab9c0a5731e0859c34ed6d6a3554", "srcset": "https://si.imgix.net/47e44a88/uploads/origins/69faf54b-4675-4f46-870a-0cc23304200e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c8cab9c0a5731e0859c34ed6d6a3554, https://si.imgix.net/47e44a88/uploads/origins/69faf54b-4675-4f46-870a-0cc23304200e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4f45e4a9293520d7b7a5492cdaf0f5c 2x, https://si.imgix.net/47e44a88/uploads/origins/69faf54b-4675-4f46-870a-0cc23304200e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9687acdcd8822585d6c9daa54f8fcfc7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47e44a88/uploads/origins/69faf54b-4675-4f46-870a-0cc23304200e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35acc7dcefc0bfa0dc60c1aa406b26ed", "srcset": "https://si.imgix.net/47e44a88/uploads/origins/69faf54b-4675-4f46-870a-0cc23304200e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35acc7dcefc0bfa0dc60c1aa406b26ed, https://si.imgix.net/47e44a88/uploads/origins/69faf54b-4675-4f46-870a-0cc23304200e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f6bf8c5f968b8