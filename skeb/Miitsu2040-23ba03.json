食べるが、ボディビルダーでもある。\n3ヶ月前に奇妙な肉を食べ、その後、いつもの数倍食べ、奇妙な食べ物、あるいは全く食べ物でないもの（虫、土など）を好んで食べるようになった。\nこのように食事量が増えた結果、定期的に嘔吐するようになり、抑えきれない食欲に劣等感や嫌悪感を抱くようになったのである。\n\n構図やポーズなど、自由にアレンジしてください。 私の依頼を読んでいただき、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1_4B5zHw6Ldb6AA8rgV28niNQjpburyN4?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Miitsu2040/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2120271, "client_id": 1898148, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2840a153/uploads/origins/4a044996-bd5b-4c52-84c4-f52a5f01c779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6f2083a9a70ac8a8e0474e11ede15b8", "srcset": "https://si.imgix.net/2840a153/uploads/origins/4a044996-bd5b-4c52-84c4-f52a5f01c779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6f2083a9a70ac8a8e0474e11ede15b8, https://si.imgix.net/2840a153/uploads/origins/4a044996-bd5b-4c52-84c4-f52a5f01c779?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c34df6b08fc72df7d102b2298c8513b1 2x, https://si.imgix.net/2840a153/uploads/origins/4a044996-bd5b-4c52-84c4-f52a5f01c779?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87a468bee9996ace4f637d3c7a398fae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2840a153/uploads/origins/4a044996-bd5b-4c52-84c4-f52a5f01c779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05b2cab093579c2aabc10601316b7f42", "srcset": "https://si.imgix.net/2840a153/uploads/origins/4a044996-bd5b-4c52-84c4-f52a5f01c779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05b2cab093579c2aabc10601316b7f42, https://si.imgix.net/2840a153/uploads/origins/4a044996-bd5b-4c52-84c4-f52a5f01c779?bg=%23fff&auto=format