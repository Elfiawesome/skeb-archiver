-475d-96cd-176475e30135?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7082dcf97fdb7ff94fc01778c4c13260 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/507c8ca8/uploads/origins/8f3a9cea-7716-475d-96cd-176475e30135?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e16f1e02f287b56beeb095fce543802", "srcset": "https://si.imgix.net/507c8ca8/uploads/origins/8f3a9cea-7716-475d-96cd-176475e30135?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e16f1e02f287b56beeb095fce543802, https://si.imgix.net/507c8ca8/uploads/origins/8f3a9cea-7716-475d-96cd-176475e30135?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c4b79671113018d6e3a8d4288b7b1967 2x, https://si.imgix.net/507c8ca8/uploads/origins/8f3a9cea-7716-475d-96cd-176475e30135?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=763334f0d9dfcd19387c6ac0048ed128 3x"}, "body": "こんにちは。\n私はあなたの画風がとても好きです。\n私のキャラクター「HANABI」を好きなように描いてください。\n彼女はゾンビと人間のハーフで、かわいくて、明るくて、でもクレイジーです。\n右目は人間の目、左目は奇妙なゾンビの目です。歯はとがっている。\nどんな服装やシナリオで描いてもいいですが、角や傷、チャームピアスは残してください（髪の形やゾンビの肌の色は好きなように変えてもいいです）。\nアクセサリーやかわいいヘアピン、人肉が好きな子です。\nありがとうございました。\nこのようなデザインで、このような服が好きです。\nhttps://imgur.com/a/kFODQkV\n\nhttps://imgur.com/a/kFODQkV", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Miitsu2040/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2120271, "client_id": 675772, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b14f4c84/uploads/origins/fe29a5d2-d8a8-4419-a4db-68e3020ee26d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54b81ae251a2b7a504738d64ec4a6a89", "srcset": "https://si.imgix.net/b14f4c84/uploads/origins/fe29a5d2-d8a8-4419-a4db-68e3020ee26d?bg=%2