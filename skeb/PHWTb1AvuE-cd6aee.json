ったシチュエーションで、背景のかわりにこんな事を頼むとは貴方という人は…まあいいですが\n…みたいな満更でもないことを誤魔化す内容の説教文をくどくど並べて頂けると嬉しいです。\n（文章を考えるのが難しいようでしたら無しで構いません）\n下着はピンクの紐パン紐ブラで、前回のミスティアより大人っぽい雰囲気でお願いします。\nその他は全てお任せします。\n\n普段描かれていないキャラクターのリクエストで恐縮ですが、何卒ご一考の程をお願い致します。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@PHWTb1AvuE/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3329464, "client_id": 8832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19deb884/uploads/origins/3ea7f594-3b6b-40f9-9274-2cc170b8fdf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83ba50740ae2dc0028ea803d2351c920", "srcset": "https://si.imgix.net/19deb884/uploads/origins/3ea7f594-3b6b-40f9-9274-2cc170b8fdf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83ba50740ae2dc0028ea803d2351c920, https://si.imgix.net/19deb884/uploads/origins/3ea7f594-3b6b-40f9-9274-2cc170b8fdf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c66a0b2e8a174205479057fec1d3819f 2x, https://si.imgix.net/19deb884/uploads/origins/3ea7f594-3b6b-40f9-9274-2cc170b8fdf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f31d4550b06d6eba1b2a142beb7d96f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19deb884/uploads/origins/3ea7f594-3b6b-40f9-9274-2cc170b8fdf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcf36e51f3802113c967ecbbef1913f6", "srcset": "https://si.imgix.net/19deb884/uploads/origins/3ea7f594-3b6b-40f9-9274-2cc170b8fdf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcf36e51f3802113c967ecbbef1913f6, https://si.imgix.net/19deb884/uploads/origins/3ea7f594-3b6b-40f9-9274-2cc170b8fdf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a1a3