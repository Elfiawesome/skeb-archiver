e2-f60b-4453-91a7-f3a3146059ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=793219a95da45f1f81dea507ade4c42f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1825abf0/uploads/origins/469554e2-f60b-4453-91a7-f3a3146059ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa8f9b88e49976f98a547655da704cb2", "srcset": "https://si.imgix.net/1825abf0/uploads/origins/469554e2-f60b-4453-91a7-f3a3146059ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa8f9b88e49976f98a547655da704cb2, https://si.imgix.net/1825abf0/uploads/origins/469554e2-f60b-4453-91a7-f3a3146059ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dc968dcb3a9fcb69ad6e370b00a2f332 2x, https://si.imgix.net/1825abf0/uploads/origins/469554e2-f60b-4453-91a7-f3a3146059ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=601688994aa39dedaea301f2fc2117b5 3x"}, "body": "初めて依頼させて頂きます。\n磐井・バクシンオーさんは単眼ちゃんといい身体した女の子を描くのがお上手そうなので、依頼するに至りました。(あといつもお世話(意味深)になっておりますから、その感謝ですね)\n\nさて本題に入ります。\n私のオリキャラの単眼ちゃん(ゆあ)と、仲林彩乃\nちゃんを描いて欲しいです。\n状況は\n2人とも下着姿で、恥ずかしがってる絵が欲しいです。\n\nゆあ はああ見えて結構いい身体をしています。バチくそ強いです。スポーツ系のしっかりした下着とスポーツブラをつけてると思います。\n\n彩乃 は女子高生で明朗快活、それでいて頭が良く、綺麗好きなので、真っ白でリボンの着いたパンツと、ヒラヒラで上品なブラジャーだと思います。あとバチくそ強いです。\n\nそれぞれの特徴は資料に張って起きます。\n\nこれからも応援しています。\n\nhttps://twitter.com/Michaelkaiki/status/1599070185977446401?t=uTXcWhcqcbIvjSDlIac0Kg&s=19\n\nhttps://twitter.com/Michaelkaiki/status/1601936492557119490?t=SM0bt_-YDFL6qqYPYYDuhg&s=19", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@iwai_kota/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 13801, "client_id": 356812, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8f3bf58/uploads/origins/1090ee1f