8f6f-0a66ec3be430?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=107b1eec283810c06390a084c57349cd, https://si.imgix.net/40eaceec/uploads/origins/a1b6f16f-1d55-4ec5-8f6f-0a66ec3be430?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=74a3623073dc6494c98595f39f4b2db1 2x, https://si.imgix.net/40eaceec/uploads/origins/a1b6f16f-1d55-4ec5-8f6f-0a66ec3be430?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f130ea0188b3d9ed721aa434fa1ce572 3x"}, "body": "絵柄が綺麗で可愛く惹かれたのでリクエストを送らせていただきました。\nマリオパーティ4のミニゲーム「ぴょんぴょんバルーン」の風船に入ったぶいすぽっ!のライバー達を描いていただきたいです。\n\n参考動画\nhttps://t.co/D3kbZxSvKh\n参考イラスト\nhttps://t.co/OrItwgHwl0\nhttps://t.co/siBPf5WRlm\n\n・PSD形式などレイヤーを分けた状態でお願いします。\n・ひなののイラストがとても良かったので橘ひなの、英リサ、花芽なずな、\t兎咲ミミを描いていただきたく。\nもしよければ他のお好みの女の子でも描いていただけると嬉しいです。\n・本人達がゲームの世界に入って実際にプレイしてるようなシチュエーションのイメージで\n・全員同じサイズでお願いします。\n・ベースとなるのは資料の下のイラストのような上からのアングルで顔はカメラ正面向いたアングルでお願いします。\nhttps://t.co/4yhBA0z4Co\n・正面アングルになるので左右対称ツールなどを使っていただいて問題ありません。\n・顔は基本は正面向きで基本は笑顔に近い通常表情でお願いします。\n デフォルメなどはせずに、眠様の普段通りの絵柄で描いていただきたいです。\n・後ろ髪はバルーンと合わせるときは省略した状態で大丈夫ですが、下記のイラストのような正面顔だけの状態も楽しみたいので後ろ髪も差分で描いていただきたいです。\nhttps://t.co/izENVfLqGL\nまたバルーンに合わせやすいツインテやツインのお団子などの髪型の差分もあると嬉しいです\n・頭のパーツは顔、頭、後ろ髪、髪やその他の部分、アクセサリーといった感じで分けていただきたいです。\n・恥ずかしがったり、困惑した表情の差分などもあると嬉しいです。\n・参考までに大体頭と風船の大きさ比は1:3程度みたいです。\n・風船の柄は原作のような各キャラのイメージカラーのサーカスっぽい模様のものでお願いします。\n・風船は全員同じもので色のみ変えていただければ大丈夫です。\n・色変えなども出来るようにレイヤーはできるだけ分けた状態でいただけると嬉しいです。\n\nよければよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Angel__nano/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3277847, "client_id": 2223302, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8da26af/uploads/origins/a9bd8144-3020-4622-b830-b7476729b657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a91d9d70940ecc