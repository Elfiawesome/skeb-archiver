_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3619117, "client_id": 2743880, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/efe6ee45/uploads/origins/85ce94e7-b519-471d-ad0a-21f76f46570c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c73ba0511f4963983c65250a47bc971", "srcset": "https://si.imgix.net/efe6ee45/uploads/origins/85ce94e7-b519-471d-ad0a-21f76f46570c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c73ba0511f4963983c65250a47bc971, https://si.imgix.net/efe6ee45/uploads/origins/85ce94e7-b519-471d-ad0a-21f76f46570c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a993f59b203c4ba7fdecc74efe8cd61e 2x, https://si.imgix.net/efe6ee45/uploads/origins/85ce94e7-b519-471d-ad0a-21f76f46570c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf6a58e68f12222bf5cda93ae7438fa8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/efe6ee45/uploads/origins/85ce94e7-b519-471d-ad0a-21f76f46570c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d5aaac4b7bfa2fa07c9fa9f990c1b22", "srcset": "https://si.imgix.net/efe6ee45/uploads/origins/85ce94e7-b519-471d-ad0a-21f76f46570c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d5aaac4b7bfa2fa07c9fa9f990c1b22, https://si.imgix.net/efe6ee45/uploads/origins/85ce94e7-b519-471d-ad0a-21f76f46570c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8456ef4702b9842181e83f3ea822730d 2x, https://si.imgix.net/efe6ee45/uploads/origins/85ce94e7-b519-471d-ad0a-21f76f46570c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=be6875479f5e7d9f7310be21364405ab 3x"}, "body": "『さうのあっ！』の清水芹香さんがスーパー銭湯で貰ったサービス券でオイルマッサージを受けている場面のイラスト2枚を描いて頂けたらなとリクエストさせていただきました。\n\n衣装は紐タイプの白ビキニでお願いします。\n眼鏡については、可能でしたら眼鏡あり・なしの2パターンで描いていただけますと幸いです。難しいようでしたら眼鏡なしでお願いいたします。\n\n1枚目は、うつ伏せで横から見た構図で、芹香さんの引き締まってバランスの取れたスタイルの横乳とお尻の美しさが強調されたイラストをお願いいたします。色気やセクシーさはありつつも、あくまで健全な範囲でお願いします。\nビキニのトップスはこの時点でほどいて胸の下に敷いてある状態ですが、乳首は見せないでください（乳輪の一部がそれと確定できない程度、僅かに描写されるのは可とします）。\n画角は真横から、もしくは頭が12時方向足が6時方向にあるとしたらカメラが7～8時くらいにあるような、とにかく横乳やお尻が映える角度で描いていただけますと幸いです。\n\n2枚目は、エロオイルマッサージのシチュエーションの清水芹香さんを自由にお任せで欲望のまま描いていただければと思います。\n最低限、全裸で性的な行為が行われている描写を希望します。\n\nオイルによる肌の光沢感は、ラバースーツレベルのテカテカでなければ自由にしていただいて構いません。\n施術者は女性で、施術台は茶色のタオルで覆われたベッドタイプのものでお願いいたします。\n\n清水芹香さんの参考画像です。\nhttps://x.com/itsumoso/status/1861343215196246449\nhttps://x.com/itsumoso/status/1781820988063424920\nhttps://x.com/itsumoso/status/1662050444838051841\nhttps://x.com/itsumoso/status/1725157645483466905", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Shurenger92/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3619117, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be9817bc/uploads/origins/b85942ac-ff9a-467a-8cd8-7301d5e19689?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c1a70a46c6fdd52f60f5d07eec7654f", "srcset": "https://si.imgix.net/be9817bc/uploads/origins/b85942ac-ff9a-467a-8cd8-7301d5e19689?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c1a70a46c6fdd52f60f5d07eec7654f, https://si.imgix.net/be9817bc/uploads/origins/b85942ac-ff9a-467a-8cd8-7301d5e19689?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1e6677454d339049975791986b2a108 2x, https://si.imgix.net/be9817bc/uploads/origins/b85942ac-ff9a-467a-8cd8-7301d5e19689?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=579133b02a4d995494de90424f767d2c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be9817bc/uploads/origins/b85942ac-ff9a-467a-8cd8-7301d5e19689?bg=%