17772227\n　のノゾミのように胸を張り勃起しているおちんちんを見せつけるようなポーズ\n\n他\n　ゲーム説明では仲間だが、敵に敗北しふたなり改造され自分の性欲に忠実かつ悪辣な敵幹部として再登場するのでそれ以降\n　「これで気持ちよくなりたいじゃろ」とばかりにおちんちんを振っているとなお嬉しいです\n\nよろしくお願いいたします", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 198507, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "へにゃーん", "screen_name": "oreizm", "avatar_url": "https://pbs.twimg.com/profile_images/1802387682926235648/5aerzlJJ.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 857483, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "めがめが。", "screen_name": "megamegaHhHh", "avatar_url": "https://pbs.twimg.com/profile_images/1950495851706814464/UCTTEtE7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1151412731519496194/1685035583/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 33}, {"id": 935400, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Yamadare 🧊🔞skeb受付中", "screen_name": "asdf05131", "avatar_url": "https://pbs.twimg.com/profile_images/1763400812242599936/2E0Y9GeG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1393800675335688194/1710490155/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 75, "sk