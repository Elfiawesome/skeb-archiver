%82%E3%81%96%E3%81%BF\n\n■シチュエーション \nhttps://beppin-girl.com/wp-content/uploads/2020/02/fishnet_stocking-20209-31.jpg\nノーパンノーブラでこちらの画像の様な股間丸出しの網タイツを着た状態で開脚拘束されて、性玩具で快楽拷問されてる。という風なイラストをお願いします。\n拘束は木に荒縄で縛られてる様な和風な感じで具体的な体位はお任せします。\n差分形式で\n・キッ…と睨みつけてる姿\n・快楽拷問を受けて絶頂して潮を噴いたりおしっこを漏らしてる\nみたいな風にお願いしたいです。何卒よろしくお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@HCJKBxSQAc36859/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3930564, "client_id": 2488568, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/398b2b34/uploads/origins/8a49df45-b783-475b-8be3-b7e5bf970302?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4d280fa0ede77ed9191c7c1a7e7b53f", "srcset": "https://si.imgix.net/398b2b34/uploads/origins/8a49df45-b783-475b-8be3-b7e5bf970302?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4d280fa0ede77ed9191c7c1a7e7b53f, https://si.imgix.net/398b2b34/uploads/origins/8a49df45-b783-475b-8be3-b7e5bf970302?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=908597e00818be15b6c68d7725f740c5 2x, https://si.imgix.net/398b2b34/uploads/origins/8a49df45-b783-475b-8be3-b7e5bf970302?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2aaac60f4cf01ed062540ce27dbf7465 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/398b2b34/uploads/origins/8a49df45-b783-475b-8be3-b7e5bf970302?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77781320c12fcae75160ea12a77fbe63", "srcset": "https://si.imgix.net/398b2b34/uploads/origins/8a49df45-b783-475b-8be3-b7e5bf970302?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77781320c12fcae75160ea12a77fbe63, https://si.imgix.net/398b2b34/uploads/origins/8a49df45-b783-475b-8be3-b7e5bf970