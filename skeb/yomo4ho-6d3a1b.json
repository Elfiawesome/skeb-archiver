4/uploads/origins/bd12d3cb-3bd6-42e4-b787-6fd05ef5a805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=069779fb86f344f0c17d6b26481e20fe", "srcset": "https://si.imgix.net/ddef5fe4/uploads/origins/bd12d3cb-3bd6-42e4-b787-6fd05ef5a805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=069779fb86f344f0c17d6b26481e20fe, https://si.imgix.net/ddef5fe4/uploads/origins/bd12d3cb-3bd6-42e4-b787-6fd05ef5a805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc6bce2d1ee4e6af35f73ca648796d24 2x, https://si.imgix.net/ddef5fe4/uploads/origins/bd12d3cb-3bd6-42e4-b787-6fd05ef5a805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ebee5444fc23cbc8141bb4ae1e4646fa 3x"}, "body": "はじめましてpixivで素敵なイラストを見かけてリクエストさせていただきました\n職業体験で女子高の健康診断をすることになった純朴そうなショタがJKのたわわなおっぱいを聴診器でじっくり診察するおねショタシーンをお願いします\n女の子の服装は体操服とブルマで体操服をたくし上げておっぱい丸出しでお願いします\n可能なら他の並んでいる女の子たちもいて「ほらほらー私たちもはやく診察してー♡」とおっぱい見せたりして茶化していると嬉しいです\n女の子はみんな面白がって楽しそうに、ショタはおっぱいにドキドキといった感じにしてください\nよろしくお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomo4ho/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3202640, "client_id": 71755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1bbbdd8d/uploads/origins/8e6dd9ac-f3e9-4b7e-8617-ab0cd97db7f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=235f29d66f3ae698c8aee1ef0148a2a3", "srcset": "https://si.imgix.net/1bbbdd8d/uploads/origins/8e6dd9ac-f3e9-4b7e-8617-ab0cd97db7f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=235f29d66f3ae698c8aee1ef0148a2a3, https://si.imgix.net/1bbbdd8d/uploads/origins/8e6dd9ac-f3e9-4b7e-8617-ab0cd97db7f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9dd8ec1af61670c5b7656cd2683f82d 2x, https://si.imgix.net/1bbbdd8d/uploads/origins/8e6dd9ac-f3e9-4b7e-8617-ab0cd97db7f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c12419d2ccc37e7941415ce69ae1323 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1bbbdd8d/uploads/origins/8e6dd9ac-f3e9-4b7e-8617-ab0cd97db7f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44a7275a318341c78430bd0fd614eb6c", "srcset": "https://si.imgix.net/1bbbdd8d/uploads/origins/8e6dd9ac-f3e9-4b7e-8617-ab0cd97db7f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44a7275a318341c78430bd0fd614eb6c, https://si.imgix.net/1bbbdd8d/uploads/origins/8e6dd9ac-f3e9-4b7e-8617-ab0cd97db7f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=04affbed94cfc61fc291b6a6e6c7aced 2x, https://si.imgix.net/1bbbdd8d/uploads/origins/8e6dd9ac-f3e9-4b7e-8617-ab0cd97db7f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e5c2ac7c3c065f0b9a0e9e0a7bdc4218 3x"}, "body": "前回がとても素晴らしかったのでもしよろしければお願い致します！\n書くかも程度ですがドM小説の挿絵に利用したいです\n\nシチュ：妖精/小人サイズかつ着衣超乳&着衣ボテ腹の女性たちに精巣を苗床にされ、膨玉袋に改造され尿道出産させられるM男というドMホイホイシチュ\n私服ラヴィーネが外からペニスを刺激、尿道を抉じ開けてレイスが這い出しており、精巣の中でラヴィーネママ、シルファ、アンナ、ゼンゼ、レンゲを受胎している様子を希望\n表情は全員顔の上部や目元まで影がかかる瞳のハイライトなしの表情で、ゼンゼとレンゲは無表情寄りの侮蔑、ラヴィママは諦観交じりの軽蔑、それ以外は変態マゾへの嫌悪感を一切隠さない強い侮蔑の表情を希望\n\n女性キャラは全員、全身&衣服が羊水&精液で濡れ、肌に服がべったりと貼りつき服越しの勃起乳首(ピンク色の透け乳首描写希望)+片乳だけでも両腕で抱え込めない、頭&胴体以上のサイズの着衣超乳で\n超乳と同サイズの特大着衣ボテ腹(淫紋付き完全着衣状態希望)と共に服をピチピチに伸ばす大きさ希望\n\n男性器や玉袋はノリ修正希望、M男は何人もの妖精サイズを孕んだ大玉サイズの淫紋付き膨玉袋と中で複数の妖精サイズの女性キャラが蠢いている受胎中断面図&\n太腿より上が特大ペニスから這い出したレイスを尿道出産するシーンをメインに、切替可能なpsd方式で\n断面図なし差分&極太ペニスの尿道部が女体一人通るサイズで大きく膨らみ、大量射精と共に鈴口からレイスの片腕が出る出産途中シーン希望(それぞれ独立差分希望)\n可能ならえぐい肉瘤が山ほどついた尿道責め用極太触手(可能なら肉塊卵満載の産卵機能付き)を尿道に挿入され許可があるまで射精&出産封印中の出産前シーン希望\nM男に一切の損傷や苦痛はなく、純粋な快楽により情けなく喘いでマゾ絶頂する様子希望\n\n背景は触手肉壁かダーク系希望\nレイヤー切替可能設定で各キャラの瞳のハイライト、顔上部の影の有無の切替差分、尿道から女体がずるっと這い出す効果音等差分や粘液まみれの触手が蠢く効果音等や尿道出産の甘い快感に悶える男の台詞と口調等お任せで\n老いも死も赦されず大好きな超乳&ボテ腹美少女ばかりマゾ射精出産するM男の姿を侮蔑する彼女達の台詞として、「最低」「変態」「マゾ」「男の癖にペニスから出産するなんて気持ち悪い」「罰として永遠に尿道出産させるわ」等の台詞有無差分希望(あくまで参考でもう少し長めにして頂ければ幸いです)\n更に優先度最低でM男のペニスを嫐る私服ラヴィーネの様子や蠢く大玉袋が、彼自身の着衣で隠れており、外から何が行われているかわからないが、股間部分の服の下で何かが蠢いている様子がわかる差分希望\n\nhttps://drive.google.com/drive/folders/1AEbaHAfTef7qfIBO5IDMY-M0eC3xD-Fs?usp=sharing", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomo4ho/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3202640, "client_id": 71755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e114c1db/uploads/origins/346ff42d-483d-4f75-8bb3-3521135723b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f42079c4a3ba619b75fedb0b634acb5", "srcset": "https://si.imgix.net/e114c1db/uploads/origins/346ff42d-483d-4f75-8bb3-3521135723b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f42079c4a3ba619b75fedb0b634acb5, https://si.imgix.net/e114c1db/uploads/origins/346ff42d-483d-4f75-8bb3-3521135723b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f870bc32eebffae7942ee62fede3a59 2x, https://si.imgix.net/e114c1db/uploads/origins/346ff42d-483d-4f75-8bb3-3521135723b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cf0a0a0f95a82cd26fcf78578a7bb9d 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e114c1db/uploads/origins/346ff42d-483d-4f75-8bb3-3521135723b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe4749a57124160a97e2377a68836627", "srcset": "https://si.imgix.net/e114c1db/uploads/origins/346ff42d-483d-4f75-8bb3-3521135723b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe4749a57124160a97e2377a68836627, https://si.imgix.net/e114c1db/uploads/origins/346ff42d-483d-4f75-8bb3-3521135723b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2150e1663c0803a1f8c3908f460220f3 2x, https://si.imgix.net/e114c1db/uploads/origins/346ff42d-483d-4f75-8bb3-3521135723b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=40861af4de5d87cf4cbd0f05549fa930 3x"}, "body": "書くかも程度ですがドM小説の挿絵等に利用したいです\n葬送のフリーレン/エーデル&エーレ\nシチュ：\n着衣超乳&着衣ボテ腹姿のエーデル(差分でエーレ)を女性一人が入るほどの超特大ボテ腹M男がアナルから出産しながら前立腺圧迫で絶頂射精するドMホイホイシチュ\n触手肉壁系かダーク系背景で、女性一人が入るほどの超特大ボテ腹M男とエーデルをベースにpsd形式で各キャラがレイヤーで切替可能、スカートや太ももより上が抜け出る出産シーンで、\nM男をゴミを見る冷めた目(顔の上部や目元まで影がかかり、瞳のハイライトなし)で変態への嫌悪感MAXを一切隠さず侮蔑する様子希望\n切替が難しい場合はエーデルとエーレは二人とも着衣超乳&着衣ボテ腹姿でエーデルを出産しながらマゾ絶頂する超特大ボテ腹M男をエーレが嫌悪・侮蔑する内容希望\n\n二人とも身体や衣服が羊水で濡れ、服が超乳やボテ腹にべったり張り付き、着衣超乳は服越し勃起乳首(透け描写が可能であれば乳首はピンク色希望)+片乳だけで両腕でも抱え込めない、頭＆胴体以上のサイズで\nそれらと同サイズの特大着衣ボテ腹(淫紋付き/衣装は調整OKで完全着衣状態希望)と共に服をピチピチに引き伸ばされる描写希望\n\nM男は女体一人入りの特大サイズ&妊娠淫紋付きボテ腹で出産時の一切の苦痛はなく、男のペニスや玉袋など股間を卵の役割を果たす肉塊はモザイク不要レベルで完全に覆って内部でペニスを嫐り、\n出産時の際に前立腺への強烈な刺激で肉塊卵の先端にコンドームのように特大精液水風船ができるほど大量射精しまくり受精させる様子希望\n\npsd形式で切替可能設定で、粘液まみれの蠢く肉壁の水音やずるっと這い出す出産の擬音、射精等の効果音や各キャラの瞳のハイライトと顔上部に掛かる影の有無差分と\n優先度低OKで女性キャラ出産後とは別に出産途中として、M男のアナルからエーデル(エーレ)の片腕だけ這い出す切替可能差分及び射精の有無切替差分希望\n更に口調等お任せで、快楽のために擬態肉塊妖魔を孕み産み落とすだけの苗床として自らアナルを捧げ、男の癖に妊娠した挙句マゾ出産射精し、次の肉塊卵に射精して受精させる設定&内容で、マゾ豚苗床として大好きな超乳&ボテ腹美少女ばかり永遠に孕ませてあげる、と変態マゾ男を嫌悪感MAXで罵倒・侮蔑する台詞有無差分希望\nまた出産した女性キャラはおっぱいが大きくて可愛ければ何でもいいというM男の節操のなさを蔑み、呆れ果てる様子希望です\n\n参考：\n\nhttps://drive.google.com/drive/folders/19im5JtyQFFU054Mxl4mTc-Sa4IJCIloB?usp=sharing", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 17501, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "月代@コミティアあ46a", "screen_name": "bs_sakayaki", "avatar_url": "https://pbs.twimg.com/profile_images/1707682140383834112/OEdR5UCM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/76016362/1764520943/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "r