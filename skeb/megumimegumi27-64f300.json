r.com/67ra1/status/1665337347058315267/photo/1\n資料２\nhttps://twitter.com/hiyayo25/status/1665312061616799744\n資料３\nhttps://twitter.com/_NEREB/status/1665360894413639682\n\nお忙しいところ恐縮ですが、めぐ先生の絵がすごく気に入って依頼しました。\nご都合や金銭的に合わない場合はお断りしても構いません。\nよろしくお願いいたします。\n\nPS.めぐ先生の絵のファンですので、指示以外に追加や変更もご自由にお願いします。\n先生らしいイラストが欲しいです。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@megumimegumi27/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 977540, "client_id": 1411242, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe0f8fec/uploads/origins/3d488d8e-325d-4f00-bc89-8d6bc2f8c450?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d1e965fc583df1a42931fe94575b065", "srcset": "https://si.imgix.net/fe0f8fec/uploads/origins/3d488d8e-325d-4f00-bc89-8d6bc2f8c450?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d1e965fc583df1a42931fe94575b065, https://si.imgix.net/fe0f8fec/uploads/origins/3d488d8e-325d-4f00-bc89-8d6bc2f8c450?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bf05b038ff5654545eeda6e64dd92a0 2x, https://si.imgix.net/fe0f8fec/uploads/origins/3d488d8e-325d-4f00-bc89-8d6bc2f8c450?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e99bce5c163a08a809db8f5d99c14749 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe0f8fec/uploads/origins/3d488d8e-325d-4f00-bc89-8d6bc2f8c450?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=049b8a820fb95906ffaac2ea86442b7b", "srcset": "https://si.imgix.net/fe0f8fec/uploads/origins/3d488d8e-325d-4f00-bc89-8d6bc2f8c450?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=049b8a820fb95906ffaac2ea86442b7b, https://si.imgix.net/fe0f8fec/uploads/origins/3d488d8e-325d-4f00-bc89-8d6bc2f8