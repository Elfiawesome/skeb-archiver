f70e5b29d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc47db65e30a4a54a0c5d097f10512ea", "srcset": "https://si.imgix.net/c16f7e72/uploads/origins/6240e47d-e246-450f-a2db-f7f70e5b29d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc47db65e30a4a54a0c5d097f10512ea, https://si.imgix.net/c16f7e72/uploads/origins/6240e47d-e246-450f-a2db-f7f70e5b29d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=77768cbb1214e790a24c158544ff499b 2x, https://si.imgix.net/c16f7e72/uploads/origins/6240e47d-e246-450f-a2db-f7f70e5b29d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3cc7782a8cb5093e76307867d4e8ca28 3x"}, "body": "ポンざくろ様のイラストを拝見し、とても素敵でしたので依頼させていただきました。\n\n【使用用途】\nSNS周りでの使用\nYouTubeの動画サムネイル等での使用\n\n【キャラクター】\n鬣神おこげ\n私服衣装\n\n【構図】 \n背景無し\nおまかせ\n\n【表情】\nにこにこ顔\n差分が可能でしたら困った顔も作成していただけると嬉しいです\n\n\n【お願いしたい点】\n口はωな形(開いてても閉じててもどちらでも可)\n牙２つ\n耳、髪、頭部、服の一部(袖など)が切れないように納めていただきたいです\n\n透過したキャラクターの納品をお願い致します\n\nどうぞよろしくお願い致します。\n\nhttps://drive.google.com/file/d/1YRa6Wj4TXf0AJJumzwgUR6u2cT1FYlVY/view?usp=drivesdk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ponzakuroooo/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/36cb5cb4/uploads/origins/dd299c82-2af8-4901-b4b4-a012f8c8faa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da4f05b03244ba99c801d7168813d7c1", "srcset": "https://si.imgix.net/36cb5cb4/uploads/origins/dd299c82-2af8-4901-b4b4-a012f8c8faa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da4f05b03244ba99c801d7168813d7c1, https://si.imgix.net/36cb5cb4/uploads/origins/dd299c82-2af8-4901-b4b4-a012f8c8faa0?bg=%23fff&auto=f