rop&crop=top&w=200&h=200&blur=200&s=945c016e69a1d6fbdc106302397f0a1c 3x"}, "body": "こんにちは、ポンざくろ先生！\n聖龍王ヴェリタスと申します。\nいつも凄く可愛いイラストを描かれていたので、依頼をさせて頂きました！\n\n今回は、Vtuberの結城さくなちゃん（@yuki_sakuna)のイラストを描いていただきたいです！\n依頼したい内容は、さくなちゃんのお祝いイラストをお願いしたいです！（ホールケーキやクラッカーなどでリスナーさん達にサプライズパーティを開かれ驚かされつつも感動している感じ）\n\n構図や背景などはお任せします。\nガイドラインは下の方に載せています！\nよろしくお願いします！\n使用用途　PCの壁紙など\n\n結城さくなさんのガイドライン\nhttps://yuuki-sakuna.com/guide/\n\nhttps://x.com/rariemonn765/status/1982782769991434527", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ponzakuroooo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2810592, "client_id": 3355221, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b94d03b/uploads/origins/23fb3b3d-4e95-4a28-ac05-10d24764cb20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b37c6ca7a00c2a531708780088fad631", "srcset": "https://si.imgix.net/1b94d03b/uploads/origins/23fb3b3d-4e95-4a28-ac05-10d24764cb20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b37c6ca7a00c2a531708780088fad631, https://si.imgix.net/1b94d03b/uploads/origins/23fb3b3d-4e95-4a28-ac05-10d24764cb20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=357e969b57fe3969a26a03e6be048655 2x, https://si.imgix.net/1b94d03b/uploads/origins/23fb3b3d-4e95-4a28-ac05-10d24764cb20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a209013d41f1096d91bf5b7b06c5aeab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b94d03b/uploads/origins/23fb3b3d-4e95-4a28-ac05-10d24764cb20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ac993cda060091d177f730e4413ff9a", "srcset": "https://si.imgix.net/1b94d03b/uploads/origins/23fb3b3d-4e95-4a28-ac05-10d24764cb20?bg=%23fff&auto=format%2Ccompress&fm=webp