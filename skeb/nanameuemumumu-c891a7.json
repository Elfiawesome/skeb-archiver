lPTgwJnR4dHNoYWQ9MTAmZm09cG5nJnc9MTIwMA&marky=415&txt64=Q0hJTERSRW4&txtclr=fff&txtfont64=QXZlbmlyLUJsYWNr&txtfit=max&txtalign=middle%2Ccenter&txtsize=60&txtshad=10&auto=format%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=dc40b4970e6d599cb25391f95b16cbb9", "skills": [{"genre": "art", "default_amount": 4000}, {"genre": "voice", "default_amount": 3000}], "payment_methods": {"credit_cards": {"jcb": {"nsfw": true}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@nanameuemumumu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1200139, "client_id": 404193, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ebe89a76/uploads/origins/bf0d4b92-3f13-4c41-af1e-7d125dac57dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33f997106dd0c64ca89ab6697ebc9fd0", "srcset": "https://si.imgix.net/ebe89a76/uploads/origins/bf0d4b92-3f13-4c41-af1e-7d125dac57dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33f997106dd0c64ca89ab6697ebc9fd0, https://si.imgix.net/ebe89a76/uploads/origins/bf0d4b92-3f13-4c41-af1e-7d125dac57dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb7fbc48362516391a6bda05a5023e4f 2x, https://si.imgix.net/ebe89a76/uploads/origins/bf0d4b92-3f13-4c41-af1e-7d125dac57dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=812c6a459c597b7c6ac2776e5af3c110 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ebe89a76/uploads/origins/bf0d4b92-3f13-4c41-af1e-7d125dac57dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f04777b7cc2a55395c1b36f74b0fb52", "srcset": "https://si.imgix.net/ebe89a76/uploads/origins/bf0d4b92-3f13-4c41-af1e-7d125dac57dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f04777b7cc2a55395c1b36f74b0fb52, https://si.imgix.net/ebe89a76/uploads/origins/bf0d4b92-3f13-4c41-af1e-7d125dac57dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3c3d3e34ad479e2d2f79de3b8bd61e11 2x, https://si.imgix.net/ebe89a76/uploads/origins/bf0d4b92-3f13-4c41-af1e-7d125dac57dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7defc225717d9903550d01fb93fc52d7 3x"}, "body": "お世話になっております。\n今回は「テイルズオブヴェスペリア」というゲームに出てくる「リタ・モルディオ」ちゃんのローパー姦イラストをリクエストさせていただく、ご検討よろしくお願いいたします。\n\n▼キャラクター参考資料\nhttps://photos.app.goo.gl/o6mrUEb3LueJu86d6\n今までお願いさせていただいた女の子たちは前衛キャラだったのですが、リタちゃんは研究者かつ天才魔導少女で、術で戦う後衛キャラという設定です。幼少期から両親もおらず周囲からも距離を置かれて生活環境があまり良くなかったので、栄養のあるものが食べられなかったせいか身長や胸のサイズは控えめとなっており、比較的ロリ寄りに描いていただけましたら幸いです。\n\nまた同じシチュで恐縮なのですが、ローパーに敗北して犯されてしまうシチュをお願いいたします。研究で一人で遺跡調査を行っていた、もしくは、危険なダンジョンに潜っていたら、ローパーの集団に襲われてしまいあっという間に袋叩きにされて敗北、好き放題レイプされてしまうといった感じのノリのシチュでお願いいたします。\n\n・今回も表情がよく見える構図が希望です。私は構図被りを全く気にしないタイプですし、同じシチュで繰り返しリクエストさせていただいているのもありますので、以前描いていただいたすずちゃん、プレセアちゃん、ソフィちゃん（＋アーチェちゃん）と構図が被っても全く問題ございません。\n\n・触手によって着衣を破かれているようにお願いしたいです。\nー頭のゴーグルは着用したままで、ひび割れているようにお願いいたします。\nー帯がほどけて上着の前がはだけて両胸が露出しているようにお願いいたします。\nー黒い袖の部分や、両足のソックス、ブーツがボロボロになっていて穴があいて破けているようにお願いいたします。特に足の方はボロボロになっていると嬉しいです。\nー下着の有無はお任せいたします。（資料ＵＲＬの「６．フィギュアの画像」を見る限り、黒いブルマのようなものを着用していると思われます。もし下着も描いていただける場合は、例えば、破いて挿入でも、ずらして挿入でも、脱がされた下着が足に引っかかっている感じでも大丈夫ですし、無しでも大丈夫です。）\nールーペやメモ帳、ペンなどの小物は無しでも大丈夫です。また、それに合わせて、小物を入れていた上着のポケットを省略していただいても大丈夫です。\n\n・着衣や身体が、埃や土汚れなどで汚れているようにお願いします。\n\n・触手に殴られたり、鞭のように振るわれて叩かれたりして、全身ボロボロで痛々しい痕がついているようにお願いします。今回も差し支えない範囲で多めにお願いしたいです。\n\n・麻痺毒が含まれた粘液、あるいは、白濁液によって髪や顔、残った着衣や全身が汚されているようにお願いします。頭のゴーグルも白濁液で汚れていて欲しいです。\n\n・もし可能でしたら表情差分をお願いします。\n（１）体中に刻まれた暴力の痕による激痛、そして、容赦ないレイプで苦しんでおり、涙を流して苦しんでいるような表情\n（２）麻痺毒やエナジードレインで体力も魔力も底を尽きて、こちら（https://www.pixiv.net/artworks/87262764）のアーチェちゃんみたいな感じで半開きの口からよだれを流しながら痙攣している感じの表情\n\n以上です。\n今回も、触手のリョナレイプによってリタちゃんが滅茶苦茶にされて可哀そうなことになっている内容になってさえいれば変更があっても全然大丈夫です。\nご検討よろしくお願いいたします。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nanameuemumumu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1200139, "client_id": 404193, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93164de5/uploads/origins/1759671f-6284-4733-92e3-6426ba6d330e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9cf5ab67c346554fbf642e089454f31", "srcset": "https://si.imgix.net/93164de5/uploads/origins/1759671f-6284-4733-92e3-6426ba6d330e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9cf5ab67c346554fbf642e089454f31, https://si.imgix.net/93164de5/uploads/origins/1759671f-6284-4733-92e3-6426ba6d330e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7c4a9114b7950c2392574d1e55fd65a 2x, https://si.imgix.net/93164de5/uploads/origins/1759671f-6284-4733-92e3-6426ba6d330e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d0b46c9986775d9eeaf1bc5580ef10d 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93164de5/uploads/origins/1759671f-6284-4733-92e3-6426ba6d330e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ad6eaea4cfaaf9f68ecaafda3d399fd", "srcset": "https://si.imgix.net/93164de5/uploads/origins/1759671f-6284-4733-92e3-6426ba6d330e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ad6eaea4cfaaf9f68ecaafda3d399fd, https://si.imgix.net/93164de5/uploads/origins/1759671f-6284-4733-92e3-6426ba6d330e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ea8a6def973b684193a422d31dd14ae1 2x, https://si.imgix.net/93164de5/uploads/origins/1759671f-6284-4733-92e3-6426ba6d330e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b3b6fecb161cc0eb9bcccf4d1e55949e 3x"}, "body": "Ｓｋｅｂでは初めまして。\n以前にＰｉｘｉｖリクエストで、藤林すずちゃんとプレセア・コンバティールちゃんのリクエストをお願いさせていただいたものです。\nその節は誠にありがとうございました。\n\n今回は、「テイルズオブグレイセス」というゲームに出てくる「ソフィ」ちゃんという女の子のエッチなイラストをリクエストさせていただきたく、ご検討よろしくお願いいたします。\n●キャラクター参考資料：https://photos.app.goo.gl/pyNRLqN1yQw8rdkj6\n外見年齢は１３歳程度、感情表現は乏しめですが純真無垢な性格という設定です。あどけなさを残した華奢な少女といった外見ですが、パンチやキック等の格闘でスピードと手数を活かして戦うキャラで回避力が高いうえに、実は普通の人間ではなく戦闘用ヒューマノイドなので防御力や体力も高い前衛キャラでした。\n\nシチュは、前回、前々回と同様に、ローパーに敗北して犯されてしまうシチュでお願いいたします。ダンジョンで触手モンスターの大群に襲われ、仲間を逃がすために一人で戦っていたが、麻痺攻撃を受けてスピードや回避力を封じられてしまい、普通の人間より丈夫なソフィちゃんといえども嬲り者にされ続けて敗北、麻痺と痛みで動けなくなった身体を好き放題に犯されて苗床にされてしまう・・・みたいなノリでお願いします。\n\n・ソフィちゃんの衣装は複数あるのですが、参考資料の衣装でお願いします。スレンダーな感じを出してもらえると嬉しいです。\n\n・表情がよく見える構図が希望です。すずちゃんやプレセアちゃんと同じ構図でも大丈夫です。逃げられないように拘束されている感じが出ていると嬉しいです。\n\n・触手によって着衣を破かれているようにお願いしたいです。\n- 胴体部分は多めに破かれて露出度が高く、ちっぱいが晒されているようにお願いしたいです。できれば、グレーのタイツのような生地と、ピンクのスーツの部分が両方とも少しずつ残っていると嬉しいです。\n- 二の腕の半ばぐらいから先の着衣は残っているようにお願いしたいです。（逆に、肩付近の生地が失われて、肩が露出していると嬉しいです。）\n- 両腕のアームレット（籠手）は装備したままでお願いします。触手の攻撃によってひび割れていたり、汚れていると嬉しいです。特に、手の甲付近の赤い半球状のガラス質のようなパーツは大きくひびが入っていると嬉しいです。\n- 太ももの半ばぐらいから先の着衣は残っているようにお願いしたいです。（逆に足の付け根付近の生地は失われて肌が露出していると嬉しいです。）\n- ガーターベルトとリストレット（白い靴）は残したままでお願いします。乱暴されたせいで、リストレットがずり落ちないように固定しているガーターベルトのリングが片足だけ外れていると嬉しいです。\n- 首元の白いマフラーのような生地は残してもらえると嬉しいです。\n\n・着衣や身体が、埃や土汚れなどで汚れているようにお願いします。\n\n・触手を殴らつけられたり、鞭のように振り回されたりして全身ボロボロで痛々しい痕がついているようにお願いします。（もし差し支えなければですが、前回のプレセアちゃんより多めにしてもらえると嬉しいです。可能な範囲で結構ですので、プレセアちゃんと同じぐらいの激しさでも大丈夫です。）\n\n・麻痺毒が含まれた粘液、あるいは、白濁液によって全身が汚されているようにお願いします。髪や顔、残った着衣やアームレット、リストレットなどが汚れていると嬉しいです。髪は多めに汚されていて、ツインテの部分も髪コキされたかのようにべったり汚れていると嬉しいです。\n\n・挿入されている最中で、大量に注がれた白濁液があふれて逆流しており、局部付近や内股が汚れていると嬉しいです。\n\n・もし可能でしたら表情差分をお願いします。\n（１）苗床にされてまだ日が浅く、涙目でやめてと懇願しているような悲しそうな表情\n（２）麻痺毒やエナジードレインで体力が尽きてぐったりしており、抵抗の意志を喪って目のハイライトが消えて、苗床になることを受け入れて涙が流れている表情\n\n以上です。\nソフィちゃんが触手にリョナレイプで滅茶苦茶にされて可哀そうなことになっている内容になってさえいれば変更があっても全然大丈夫です。\nご検討よろしくお願いいたします。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nanameuemumumu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1200139, "client_id": 1214587, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ddfe6283/uploads/origins/575edd34-5ac6-4aa9-aa19-c16cd36c981f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8253f0280e303b9c4d88a21cdff25be4", "srcset": "https://si.imgix.net/ddfe6283/uploads/origins/575edd34-5ac6-4aa9-aa19-c16cd36c981f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8253f0280e303b9c4d88a21cdff25be4, https://si.imgix.net/ddfe6283/uploads/origins/575edd34-5ac6-4aa9-aa19-c16cd36c981f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c23227d97b43f445145218f5b01e6274 2x, https://si.imgix.net/ddfe6283/uploads/origins/575edd34-5ac6-4aa9-aa19-c16cd36c981f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0bb3901c0ccc44a9c0e4e87379a8dda2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ddfe6283/uploads/origins/575edd34-5ac6-4aa9-aa19-c16cd36c981f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25c4d3732529224cc6a56ca46518e6cb", "srcset": "https://si.imgix.net/ddfe6283/uploads/origins/575edd34-5ac6-4aa9-aa19-c16cd36c981f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25c4d3732529224cc6a56ca46518e6cb, https://si.imgix.net/ddfe6283/uploads/origins/575edd34-5ac6-4aa9-aa19-c16cd36c981f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3f29ee360ff4247d15e3bb5df96076fd 2x, https://si.imgix.net/ddfe6283/uploads/origins/575edd34-5ac6-4aa9-aa19-c16cd36c981f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=09984ef799b07aa50e51a882b77bbca3 3x"}, "body": "こんにちは！お願いしたいのですが。これは私のOCです。彼女は背が高く、体型が強い。 20代前半から半ば。彼女は見づらい場合に備えて銀色の目をしています。冒険家と戦闘機。キャラクター：https：//imgur.com/a/18mBWjqカジュアルな服装でキャラクターを見たいです。彼女は白いTシャツとトラックショーツ（人の太ももまで下がるショーツ）を着ていました。ショーツの色は黒または濃い青のいずれかです。このようなものですが、ロゴとストライプはありません：https：//imgur.com/a/HVCyraqシャツを着たままショーツを脱いでいる途中で彼女を描くことができますか？彼女は彼らを脱いでいる間、視聴者を見ているでしょうが、彼女は無関心に見えます。彼女は下着を着ていてもいなくてもかまいません。どちらのオプションでも構いません。お尻がメインならいいのですが、それでも彼女の体はよく見えます。その他の詳細はお任せします。よろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nanameuemumumu/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/775d1164/uploads/origins/a4796f15-9457-4cfa-ba9f-0569be7b3f05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3423f3cdd1c8d9a9190b719b1b0ac15", "srcset": "https://si.imgix.net/775d1164/uploads/origins/a4796f15-9457-4cfa-ba9f-0569be7b3f05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3423f3cdd1c8d9a9190b719b1b0ac15, https://si.imgix.net/775d1164/uploads/origins/a4796f15-9457-4cfa-ba9f-0569be7b3f05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e2a0151e103b2e21ae7adac8bf838fa 2x, https://si.imgix.net/775d1164/uploads/origins/a4796f15-9457-4cfa-ba9f-0569be7b3f05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2ab9d694c10ea247ac132062c3cf47f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1200139, "nc": 160}], "sent_works": [], "similar_creators": [{"id": 161808, "creator": true, "nsfw_acceptable": true, "acceptable": true, "n