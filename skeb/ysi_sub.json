5c4a0b-2769-4653-bb79-ffbb401be170?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd3cc342b8efbfd9a5c7f2713dab5e92", "srcset": "https://si.imgix.net/adbc1d3e/uploads/origins/085c4a0b-2769-4653-bb79-ffbb401be170?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd3cc342b8efbfd9a5c7f2713dab5e92, https://si.imgix.net/adbc1d3e/uploads/origins/085c4a0b-2769-4653-bb79-ffbb401be170?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ccdb9de3d7a6e1c73c722ed0dba6b909 2x, https://si.imgix.net/adbc1d3e/uploads/origins/085c4a0b-2769-4653-bb79-ffbb401be170?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d20326b681be70f2dedce0e045fd3010 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/adbc1d3e/uploads/origins/085c4a0b-2769-4653-bb79-ffbb401be170?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93d18ff70cf20c5bb2abd24b1bf8c052", "srcset": "https://si.imgix.net/adbc1d3e/uploads/origins/085c4a0b-2769-4653-bb79-ffbb401be170?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93d18ff70cf20c5bb2abd24b1bf8c052, https://si.imgix.net/adbc1d3e/uploads/origins/085c4a0b-2769-4653-bb79-ffbb401be170?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c7e4017a2d22329c6626d6a532245b5 2x, https://si.imgix.net/adbc1d3e/uploads/origins/085c4a0b-2769-4653-bb79-ffbb401be170?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=57d89480de4f84d8e10886aef8abeff4 3x"}, "body": "やさいさまこんにちは、いつもお世話になっております♬︎♡\n今回はやさいさんにVOIDの自陣たち描いて頂きたいと思いリクエスト送信させて頂きました。\n\n【希望イラスト】\n・自探索者(HO1)の周りに自陣(HO2,3,4)のデフォルメ\n・自探索者と相棒(HO2)\n上記のどちらかでお願いしたいです。\n金額的に難しければ自探索者単体でお願いします…！\n\n【HO1(自探索者)】\n七瀬紫乃(ななせしの)。22歳。女の子。\nめんどくさがり屋で気分の上げ下げが激しい。自分が天才であることを自覚しており、それを褒められると調子に乗りすぎてたまにやらかす。人と話すのが大好き。コミュニケーションの一環として人に『あめちゃんどーぞ！』とキャンディを配っている。\n好きな物はキャンディ🍬 \n趣味はカッコイイバイクの運転🏍\n\n【HO2】\n瑞海翠(みずみ すい)。紫乃のパートナー(相棒)である新型アンドロイド。女の子。\n見た目からしてお嬢様っぽい、普段からお嬢様言葉で話すが、アンドロイドなので少しカタコト。口癖で語尾に「ですワ」がよく付く。\n四字熟語で言い表すと、波乱万丈。特に人間とお話しするのが大好きで、どんな話でも興味を持って聞くし、気になった人にズバッと話しかける。超ポジティブ。自分の容姿やいろんなことに自信を持っており、打たれ強いし図太い。\nアンドロイドなので、手先はすごく器用。案外細かい作業は好き。\nいつか\"あふたぬーんてぃー\"とやらをしてみたいと思っている。\n\n【HO3,4】\nドライブ内に資料がありますので必要な場合はそちらから確認お願いします。\n\n【構図/表情】\nやさいさんにおまかせします😚\n\n【使用用途】 \nアイコン、個人鑑賞、自陣PLへのプレゼント、SNS(X/Instagram/TikTok等)への掲載 etc...\n※商用利用をすることはありません\n\n金額が足りない場合や資料に不備等がありましたら再送していただけましたら幸いです、よろしくお願いいたします🎀ིྀ\n\nhttps://drive.google.com/drive/folders/1HrgOGxii9gsO7qluLriTgIYGLYdyDma0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ysi_sub/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3710856, "client_id": 3572136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37240cf1/uploads/origins/7c98275d-11ab-4048-adbd-ad37d421a1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68a568c68838dcb61affbe8192f8cfd1", "srcset": "https://si.imgix.net/37240cf1/uploads/origins/7c98275d-11ab-4048-adbd-ad37d421a1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68a568c68838dcb61affbe8192f8cfd1, https://si.imgix.net/37240cf1/uploads/origins/7c98275d-11ab-4048-adbd-ad37d421a1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a72b74c25b2b43f0633fc6e02222d57a 2x, https://si.imgix.net/37240cf1/uploads/origins/7c98275d-11ab-4048-adbd-ad37d421a1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07f233d216626bdf19f3c2688f7f8dd2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37240cf1/uploads/origins/7c98275d-11ab-4048-adbd-ad37d421a1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7fd6746a07f540c5b3