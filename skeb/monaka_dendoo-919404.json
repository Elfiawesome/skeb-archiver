0&s=4a25909fe70e0cb3aee0756c5701443c, https://si.imgix.net/27a6d437/uploads/origins/168eb353-e3ec-49e6-919d-3558a3897012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=815ba72f3c9966eb1c884b83adc91d95 2x, https://si.imgix.net/27a6d437/uploads/origins/168eb353-e3ec-49e6-919d-3558a3897012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=da25abce791a15f92f8dd58528e84c66 3x"}, "body": "五十嵐シキのハイグレ洗脳✖️黄金化\n漫画作品をお願いしたく\n\nダンジョンの宝部屋の扉に\n『ハイグレ』と言ってはいけない\nと記載されており\n馬鹿にしながら部屋に侵入した瞬間\nビームが照射\nハイグレ洗脳を受ける\n\n最初は洗脳度は低く\n自身の格好への不満など冷静\n\n※可能なら\nハイグレポーズしたモブ女性像が乱雑にいる(床に転がってたり、金貨に頭から埋もれていたりetc…)\n\n頭の中にハイグレが侵食しながらも\n宝の山に近づき宝を取ろうとしゃがもうとすると\n無意識にガニ股の姿勢で取ろうとしており\n\nボソっと\nハイグレと口にしてしまう\nハッと我に帰るも時すでに遅し\n体の一部が黄金化\n自身はハイグレの快楽を知ってしまう\n\n快楽が忘れらずハイグレを始めてしまう(恐る恐る→堂々とシフトしていく)\nハイグレと言うたびに黄金は進行していき\n洗脳度100%で絶頂に至り\n完全な黄金像とかす\n\nここからが地獄の始まり\n像と化しても意識は残っており\n固まったことにより\n完全洗脳状態なのに一切ハイグレできず\nハイグレしたい、助けて、お願い\n悲痛なハイグレを心の中で叫ぶことしかできず永久に…\n\nという流れです\n\nhttps://www.dropbox.com/scl/fo/r6gb1tzw1rf9tgysl7bcl/AHeh5iiEWnVqcqNdWjQX0JA?rlkey=wnabu8dltxqu20tb8glssltq3&st=4lgqeuho&dl=0", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@monaka_dendoo/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3386496, "client_id": 425231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac53cef4/uploads/origins/fc9c6cf7-d6ee-4b07-960b-c46767a331f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15db56af7bb0e1f8bc13ebc6b46b33c3", "srcset": "https://si.imgix.net/ac53cef4/uploads/origins/fc9c6cf7-d6ee-4b07-960b-c46767a331f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15db56af7bb0e1f8bc13ebc6b46b33c3, https://si.imgix.net/ac53cef4/uploads/origins/fc9c6cf7-d6ee-4b07-960b-c46767a331f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c861