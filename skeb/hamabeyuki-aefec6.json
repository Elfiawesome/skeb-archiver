net/efb99d8a/uploads/origins/dcc3b892-3c50-47c3-9d41-4a8482556db0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39b72b31328d16019bf27442c58e83a3", "srcset": "https://si.imgix.net/efb99d8a/uploads/origins/dcc3b892-3c50-47c3-9d41-4a8482556db0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39b72b31328d16019bf27442c58e83a3, https://si.imgix.net/efb99d8a/uploads/origins/dcc3b892-3c50-47c3-9d41-4a8482556db0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5f83dd592e25196bc02fea24ef6cd52a 2x, https://si.imgix.net/efb99d8a/uploads/origins/dcc3b892-3c50-47c3-9d41-4a8482556db0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea122504e33867ef4aa19df8a42c17ac 3x"}, "body": "こんにちは！自分が描いてる漫画のキャラ「ペルケレ」と「イスカ」の２人をお願いします。\nすみませんがシチュエーションをお任せにしたいので、設定だけ書かせていただきます。\n\n・ペルケレ（300歳）\n家賃光熱費を滞納しまくりのクズ引きこもりニート。\nへらへらしていて適当な奴に見えるが、人との付き合い方に対してすごい繊細でしかも下手という性格。\n昔仕事で人を死なせてしまった事件をきっかけにこうなってしまい、もう絶対に就職しないというこだわりがある。\nイスカのことは大切だけど、接し方に悩み中。\n\n・イスカ（24歳）\n北極星出身の会社員。かなりマジメな性格で、ルールに反したことを見つけるとめちゃくちゃ怒る。しかし、ルールに反してさえいなければ何でもやっていいという超傲慢な面もある。\nペルケレと一緒にいると楽しい、嬉しいと感じているが、情緒や知識が４歳児くらいなので、自分で自分の気持ちを整理することはまだできていない。\n\n・世界観\n世界が全部滅びてフィンランドだけ残った感じのファンタジー\n\n設定画\nhttps://tmblr.co/ZH9REjaw0WWw8i00\n漫画\nhttps://mangahack.com/comics/13923", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 2326, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ヒヨ", "screen_name": "Hetahiyo", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fwebpublic-db292787-c38a-4b52-99df-7e1f58fb27af.webp?avatar=1", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skil