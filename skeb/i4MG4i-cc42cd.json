23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2b72988074a2bcda0752653040ddfa5, https://si.imgix.net/61688262/uploads/origins/6a5e8427-3fc8-48ba-94f5-01414af5def9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bdd6354d94f2b9819d89980b739d9a6d 2x, https://si.imgix.net/61688262/uploads/origins/6a5e8427-3fc8-48ba-94f5-01414af5def9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3bbc41354cbf8ad29acbafd97c3a8586 3x"}, "body": "こんにちは！あなたの作品、すごくかっこいいです！ダークな雰囲気、大好きです！\n私のキャラクターを描いていただけませんか？\n\n>  https://drive.google.com/drive/u/4/folders/1-uA5qdMslhFEhy9XS9y6-PCKRA5ZWDLN\nどちらの衣装でも大丈夫です！\n\n私のキャラクターは、架空のサバイバルホラーゲームの主人公である若い女性です！ \nゲームの中では、彼女は斧を手に、海に脅かされながら帰路を探して廃墟となったビーチを探索しています。\nよく登場するモチーフは、海、月、そして死んだ魚です。\n彼女はボーイッシュな性格で、少し気難しい印象を与えることもあります。でも、親しくなれば、笑うのが大好きで、楽しむことも大好きなんです！\n可能であれば、顔についた血も描いていただけると嬉しいです。\n\nシュールで不気味な環境の中に彼女を描いていただけると最高です！自由に試行錯誤してください。どんな作品ができるか、とても楽しみにしています。\n\nこのイラストを配信活動で使用させていただきたいのですが、その際は必ずあなたへのクレジットを明記します。\n\nご検討いただきありがとうございます！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@i4MG4i/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3953506, "client_id": 1749868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/179abbb0/uploads/origins/e5e95863-a1c7-4bb1-9be1-2c499ea1b9df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61f656d5247bf1cf98a3a99ba7c76f84", "srcset": "https://si.imgix.net/179abbb0/uploads/origins/e5e95863-a1c7-4bb1-9be1-2c499ea1b9df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61f656d5247bf1cf98a3a99ba7c76f84, https://si.imgix.net/179abbb0/uploads/origins/e5e95863-a1c7-4bb1-9be1-2c499ea1b9df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6b2cab555e034de589ffd6c51860b3c 2x, https://si.imgix.net/179abbb0/uploads/origins/e5e95863-a1c7-4bb1-9be1-2c499ea1b9df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=499235577d317e0995105126fc52cced 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/179abbb0/uploads/origins/e5e95863-a1c7-4bb1-9be1-2c499ea1b9df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce6816d33b11193e0cb4e08a13d887f7", "srcset": "https://si.imgix.net/179abbb0/uploads/origins/e5e95863-a1c7-4bb1-9be1-2c499ea1b9df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce6816d33b11193e0cb4e08a13d887f7, https://si.imgix.net/179abbb0/uploads/origins/e5e95863-a1c7-4bb1-9be1-2c499ea1b9df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07ff2f4efa32a47cdd1d1b6f2938a741 2x, https://si.imgix.net/179abbb0/uploads/origins/e5e95863-a1c7-4bb1-9be1-2c499ea1b9df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=36e80338e00c6ac60df215543e0a952b 3x"}, "body": "先生、こんにちは！先生の作品が大好きです！私と友人のオリジナルキャラクターを描いていただけたら、本当に嬉しいです ❤️\n\nジャコビ（27歳、175cm）；モチーフ：熊の罠、イチゴ、境界領域、手\n-常に恐怖に怯え、人生に不満を抱き、死への恐怖（タナトフォビア）があり、追われているような感覚に苛まれている\n-不運で皮肉屋。失敗に終わる復讐を企て、自分と同じように誰もが悪意を持っていると思い込んでいる\n\nデイモン（24歳、183cm）；モチーフ：鏡、ドッペルゲンガー、影、肉。\n-カリスマ的で混沌とし、捕食者的なストーカー。鋭い牙を持つ嘘つきで、何も感じないが、感じたいと願っている\n-彼は人食いで、ジャコビに貪欲だ。彼の真の姿は、巨大な牙を持つ巨大な影である\n\n二人は共に超常現象調査会社に勤めている。 デイモンはヤコビに執着するドッペルゲンガーであり、彼を「貪り食う」ことで、ヤコビが感じる感情を自分も味わおうとしている。二人は愛し合っているが、デイモンの本性が邪魔をし、その結果、ヤコビは斧で彼を殺してしまう。二人はしばしば境界領域（オフィス、奥の部屋、トウモロコシ畑、森など）で見られる\n\n皆さんの想像する彼らの姿を見てみたいです！必要に応じて調整や却下をお願いします。ありがとうございます！ 🥰\n\nhttps://drive.google.com/drive/folders/1gJwcnBZN3GiR_nWCv_st9ONX6hZIEx6h", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1964367, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ቺﾘ田", "screen_name": "M_morita5", "avata