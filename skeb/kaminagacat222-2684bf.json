せていだきます。\n\nまた、可能であればサインや人物、背景のみの透過等を分けたデータをいただけますと幸いです。\nお忙しい中難しいリクエストで申し訳ありませんが、何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1WxhTQ6g64Qg2_eHOsPiLW1UE5dNAyVK7", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kaminagacat222/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3832913, "client_id": 336886, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd391bdb/uploads/origins/6d3f102b-138f-4305-9d85-4d8f326580fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1344bc72925d8b3621c09a0ad385a7fe", "srcset": "https://si.imgix.net/cd391bdb/uploads/origins/6d3f102b-138f-4305-9d85-4d8f326580fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1344bc72925d8b3621c09a0ad385a7fe, https://si.imgix.net/cd391bdb/uploads/origins/6d3f102b-138f-4305-9d85-4d8f326580fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0969edf14fee37bc8c1f9a2692f8a62e 2x, https://si.imgix.net/cd391bdb/uploads/origins/6d3f102b-138f-4305-9d85-4d8f326580fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7c2cdb97fc1dc69eec9bdfe4a642d97 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd391bdb/uploads/origins/6d3f102b-138f-4305-9d85-4d8f326580fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d32cdac175ad9a65889984439a3a5d5c", "srcset": "https://si.imgix.net/cd391bdb/uploads/origins/6d3f102b-138f-4305-9d85-4d8f326580fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d32cdac175ad9a65889984439a3a5d5c, https://si.imgix.net/cd391bdb/uploads/origins/6d3f102b-138f-4305-9d85-4d8f326580fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=38f345a96935f2d652c3650007c7722a 2x, https://s