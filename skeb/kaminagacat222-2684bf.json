&s=350beda33a544c481f6a8d6867fc1a4a 2x, https://si.imgix.net/840550c4/uploads/origins/e6c920cc-0624-4141-bcc6-6b91394cdfa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e01ceea2c44d14961575eb656de355b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/840550c4/uploads/origins/e6c920cc-0624-4141-bcc6-6b91394cdfa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a162b590be0706fee03a73f6cf78ad3b", "srcset": "https://si.imgix.net/840550c4/uploads/origins/e6c920cc-0624-4141-bcc6-6b91394cdfa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a162b590be0706fee03a73f6cf78ad3b, https://si.imgix.net/840550c4/uploads/origins/e6c920cc-0624-4141-bcc6-6b91394cdfa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f2e66b807be02a40d465810e24b95572 2x, https://si.imgix.net/840550c4/uploads/origins/e6c920cc-0624-4141-bcc6-6b91394cdfa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cb2680b0c85454ada895bc9e0de6baf2 3x"}, "body": "かみながまことさん、はじめまして。\nかおと申します\n\nPS5での配信のため、今は配信画面に載せられないのですが、ゆくゆくはPC購入し、配信画面に載せられたらと思っています。\n使用目的はX、Twitch、Bluesky、wick、discord等への掲載。アイコン等での使用を予定しております。\nグッズ化は予定しておりません。\n\n衣装やポーズはお任せいたします。\n\nTwitchでの名前はかおちゃん(kao0526)です。\n\nOCのミニキャラ掲載しているlitLinkのURLもはらせていただきます。\nよろしくお願いいたします。\n\nhttps://lit.link/kaonokoto", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kaminagacat222/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3832913, "client_id": 3496746, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc5007ce/uploads/origins/c28292e6-75e3-41d3-b918-cd06398c19f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed81a321c740402160e32758a9cd67ad", "srcset": "https:/