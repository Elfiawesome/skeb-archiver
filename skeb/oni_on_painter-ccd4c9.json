感情が読み取れず、無表情で儚いイメージ\n・無知でピュア、世間知らずでよく喋る幼稚な性格のお嬢様\n・お嬢様なのにメイド服を着ている\n・無数の白いメイド服を所有しており、ファッションを楽しんでいるがメイド服が従者や世話役の制服だとは知らない\n・外見は完全に人間で見分けがつかないが、はるか遠い未来のアンドロイドで人類とお友達になりたい\n※基本設定は無視して自由に創作して頂いても構いません\n\nポーズや構図の希望はありませんが、お悩みの場合は右手を腰に当てて凛と立っている姿をお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oni_on_painter/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2705821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7af604e5/uploads/origins/1eaa69a2-f74a-42ea-b581-6bbc95443ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d77c998dcc7b13bbb22481d8f45fe09", "srcset": "https://si.imgix.net/7af604e5/uploads/origins/1eaa69a2-f74a-42ea-b581-6bbc95443ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d77c998dcc7b13bbb22481d8f45fe09, https://si.imgix.net/7af604e5/uploads/origins/1eaa69a2-f74a-42ea-b581-6bbc95443ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4937228275127cdf3821014b02f76922 2x, https://si.imgix.net/7af604e5/uploads/origins/1eaa69a2-f74a-42ea-b581-6bbc95443ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ce4db0b4f6222f265b78d57997dd807 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7af604e5/uploads/origins/1eaa69a2-f74a-42ea-b581-6bbc95443ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e5f74371b7fe8a954fd868cacfebb6a", "srcset": "https://si.imgix.net/7af604e5/uploads/origins/1eaa69a2-f74a-42ea-b581-6bbc95443ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e5f74371b7fe8a954fd868cacfebb6a, https://si.imgix.net/7af604e5/uploads/origins/1eaa69a2-f74a-42ea-b581-6bbc95443ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blu