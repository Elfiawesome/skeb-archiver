いの少女に見えます。\n性格は静かで、好奇心旺盛です。\n人ごみの中では喪服の帽子をかぶって人間のように装っています。\nひとりになると、本来の神の姿を現します。\n\n彼女のそばには、いつも巨大な怨霊の友達がいます。\n人間には怨霊が見えないため、その友達は自由に大きさや姿を変えることができます。\n（猫、蛇、兎の三つの姿の中から自由にお選びください。）\n\nOCが怨霊の友達と遊ぶ時は、とても元気で、生後4ヶ月の子猫のように無邪気です。\n怨霊の友達は9ヶ月で、彼女よりも多くを知っていて、少し意地悪なお兄さんのような存在です。\n\nOCの特徴：\n黒髪、緑色の目\n前髪は揃っており、おでこには必ず緑色のリボン（蝶結び）をつけています。\n狐のような大きな耳と尻尾があります。\n\n▼使用用途：個人使用範囲\n▼参考資料はすべてURLにあります。雰囲気や構図等はお任せ致します！\n\n金額不足の場合は再送要請も構いません。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1cVCtcRAdppUra5NKaZMcyo0bFToy484F?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@u56164459/works/93", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8e1de054/uploads/origins/3100f072-2dde-4a76-a813-e8e4aa0cc387?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f03ace142ba7c8fb9a777cc1cfdb136", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2941993, "client_id": 2702283, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@u56164459/works/92", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2941993, "client_id": 2714974, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8bba9417/uploads/origins/bf88daab-5b25-4fa5-82f1-ed5b7749d514?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87221d396e75e47ef9f22a1add13b98f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8bba9417/uploads/origins/bf88daab-5b25-4fa5-82f1-ed5b7749d514?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=2