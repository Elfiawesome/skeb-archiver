3f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=000953ffdf5dfe1cd1b2e0fe9207e73e 2x, https://si.imgix.net/bac6256d/uploads/origins/0fa21cb1-cb2b-405f-a45c-094a50d4f3f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc667a7d58eaa19d74c53d74b4bcde18 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bac6256d/uploads/origins/0fa21cb1-cb2b-405f-a45c-094a50d4f3f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c4bcdb6b2d4982e5c0340279ff8abba", "srcset": "https://si.imgix.net/bac6256d/uploads/origins/0fa21cb1-cb2b-405f-a45c-094a50d4f3f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c4bcdb6b2d4982e5c0340279ff8abba, https://si.imgix.net/bac6256d/uploads/origins/0fa21cb1-cb2b-405f-a45c-094a50d4f3f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab3bda380e4754ce7bd7223b9c63a95b 2x, https://si.imgix.net/bac6256d/uploads/origins/0fa21cb1-cb2b-405f-a45c-094a50d4f3f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=98dfecda86be23d3418626ebff140d13 3x"}, "body": "自分のイメージキャラである「神香一后」のエッチなイラストをお願いしたいです！\n\n参考画像：\nhttps://pbs.twimg.com/media/FDk-_q4acAABR9k?format=jpg&name=4096x4096\nhttp://miyabilabo.com/images/sitagi.png\nhttps://pbs.twimg.com/media/FDlZiAwakAU4_ZO?format=jpg&name=4096x4096\nhttps://pbs.twimg.com/media/FDlZkNkacAAKL9T?format=jpg&name=4096x4096\n\n\nシチュエーションは基本的にはみらんこさん得意の睡眠姦で。\n飲み会等で飲み物に薬を混ぜられホテルにお持ち帰りされたというようなイメージで、他の作品のように行為開始～中出しまでの一連の差分をつけて頂ければと思います。\n\nただ、最初は男がこんな事して大丈夫かなみたいな感じでちょっと不安がっているようなセリフで、ゴムも付けている状態。\n\nその最中に一后ちゃんが目を覚まして、\n・薬を混ぜられていた事は気づいていたけど、あえてそのまま飲んだ\n・起きた時にどんな事されちゃってるかドキドキしながら寝た\n・大人数にたくさん中出しされて誰のだか分からない子を孕まされちゃってるかと思った\n・でもあなた一人だけでゴムも付けてるんだね\n的な感じのセリフを言い、\n男もそれならという事でフィニッシュはゴムを外して（近くに外れたゴムが落ちている）、中出しというような流れにして頂きたいです。\n\n体位とかはおまかせしますが、女の子の身体があまり男に隠れないような全身がよく見えるようなものだと嬉しいです！\n一后ちゃんの口調とかも特に決まってないのでおまかせでいいですが、性に奔放という感じだと良い感じです。\n\nよろしくお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@10skyeve/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 491415, "client_id": 270203, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55982099/uploads/origins/82867adb-d63d-4786-a662-be431d28b82f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2919e336baeeccdd8546b9f3e713c432", "srcset": "https://si.imgix.net/55982099/uploads/origins/82867adb-d63d-4786-a662-be431d28b82f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2919e336baeeccdd8546b9f3e713c432, https://si.imgix.net/55982099/uploads/origins/82867adb-d63d-4786-a662-be431d28b82f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae034e193508a23f672c10c82f5e69c0 2x, https://si.imgix.net/55982099/uploads/origins/82867adb-d63d-4786-a662-be431d28b82f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd3ddf6a63de0a75b9d48a838052321c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55982099/uploads/origins/82867adb-d63d-4786-a662-be431d28b82f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31c1bef0f738ee3a7cc607c1c783e28a", "srcset": "https://si.imgix.net/55982099/uploads/origins/82867adb-d63d-4786-a662-be431d28b82f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31c1bef0f738ee3a7cc607c1c783e28a, https://si.imgix.net/55982099/uploads/origins/82867adb-d63d-4786-a662-be431d28b82f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e332ff9e9d68177319dc11bf4049f6e0 2x, https://si.imgix.net/55982099/uploads/origins/82867adb-d63d-4786-a662-be431d28b82f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3988c7b459914062494c17d9144037ab 3x"}, "body": "いつもお世話になっております。\n\n今回はえっちな一后ちゃんをお願いします！\nhttps://pbs.twimg.com/media/EZlWkxCUwAI1KVQ?format=jpg&name=4096x4096\n\n基本は立ちバックのようなポーズを斜め後ろから見ているようなイメージで、\n顔はこちらを向いており、表情・胸・結合部がきちんと見えているような感じでお願いします。\nまた、以下のような差分がほしいです。\n\n◆1枚目　事前\n男無し。\n挑発的な表情。\n挑発的なセリフを言っている。\n\n◆2枚目　挿入\n男に挿入される。\n軽く驚いている表情（嫌そうではなく笑顔より）\nセリフおまかせ。\n\n◆3枚目　挿入中\n男が動いている。\nより挑発的な表情。\n「～～してくれるなら中に出していいよ」みたいなセリフ。\n\n◆4枚目　中出し\n男が中に射精している。\n気持ちよさそうな表情。\nセリフおまかせ。\n\n◆5枚目　溢れ精液\n男無し。\n精液が溢れている。\nセリフおまかせ。\n\nいずれの差分も服、スカート、下着はレイヤーを分けそれぞれオンオフできる状態にしてください。\n男はざっくりとで大丈夫です。\n\n個人鑑賞の他にサークルの活動として使う事もあるかもしれないです。\n\n以上、よろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yurisugar/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": true, "creator_id": 581696, "client_id": 270203, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/57b4b9bf-1b12-4e71-b11e-34a1c0fdb8b7?response-content-disposition=inline&Expires=1785019807&Signature=Rv5LbAigmggTdECe4ICUp8KoK~yVv4pKhQPK87wPy9x2-Gy0N~N2iosv3qxkiRAnbCd-iKVfzsbIN6p9sFixvp-xmF-1PGjy~FGH61gpnQrhmCdKuJ~-iRea5X7ibCy1WDjTuWKHt1Qg5QgbCl3IPva7w3Ald6sSq1uweZvssxasJloUpPXiuoPDO74qmEJKIk~2IW00FSKg4qmU9UO0qjzSY00ifCEPuBj4S91KAfp03pHOYVLoX8hJsG8~jcg-T2H2xnHMFKhvtgVa5sedJ5JYqN8XKW0jjh6gbrRMYehlao2~aATz2838LIhxIkD5l4JFNriG8xDFp3xjNfjD6Q__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1828001509562556416%2FIx272Ap1.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2798637331e29dbdcacfe2769a02be4", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1828001509562556416%2FIx272Ap1.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2798637331e29dbdcacfe2769a02be4, https://skeb-avatar.imgix.net/https%3A%2F%2Fpb