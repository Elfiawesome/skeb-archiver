a0-8ccc-aed6534d27db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9667e82d4dd1a7184152a89ed4faa32", "srcset": "https://si.imgix.net/a409ea1c/uploads/origins/de84b1ac-df59-40a0-8ccc-aed6534d27db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9667e82d4dd1a7184152a89ed4faa32, https://si.imgix.net/a409ea1c/uploads/origins/de84b1ac-df59-40a0-8ccc-aed6534d27db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9bc41210de5e5516d2e2201ee2825d6a 2x, https://si.imgix.net/a409ea1c/uploads/origins/de84b1ac-df59-40a0-8ccc-aed6534d27db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8e23dc3b69bff74e96645811e8817e9d 3x"}, "body": "はじめまして。先生のかっこよくて細かい漫画風の作品が大好きなので、リクエストさせていただきました\n\nオリジナルキャラクター「テリオット・ファテハート」のリクエストをしたいと思います\n\nhttps://imgur.com/a/Ff4rS\n\n強くなるための「希望」を求めて世界中を旅するヒーローです。様々な敵と戦っているので、ダイナミックな動きを描いていただけると嬉しいです。\n\n特技は大きな衝撃波を黒と白で表現することです。\n\nhttps://i.imgur.com/vpAqm8o.png\n\n鋭い牙を見せる獰猛な笑みも入れていただけるとありがたいです。\n\n牙の例。\nhttps://i.imgur.com/PTGYLAH.png\n\nテーマが「黄昏」なので、雪が降っている夜明け・夕暮れ時のイメージでお願いします。キングダムハーツのトワイライトタウンを参考にしています。\n\nリクエストを受けてくださった方、本当にありがとうございました。それでは、今日も素敵な一日をお過ごしください。そして、Happy Holidays!\n\nhttps://imgur.com/a/Ff4rS", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shinawaki/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 659635, "client_id": 159502, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40bd8aa6/uploads/origins/68e4260c-eb5f-4088-a6d0-4d1cce72a714?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a01afed373a72e0cd4f53a82c34a1084", "srcset": "https://si.imgix.net/40bd8aa6/uploads/origins/68e4260c-eb5f-4088-a6d0-4d1cce72a714?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a01afed373a72e0cd4f53a82c34a1084, https://si.imgix.ne