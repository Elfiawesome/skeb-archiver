150b7d9e6e59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa62d6f62d8194a50da30971cbb0b758", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3be928bd/uploads/origins/11a3e017-36e8-42dd-9ab4-150b7d9e6e59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a4a888fb1f9de4a37090c29669491d8", "src_set": ""}, "body": "初めまして！\nガッツリ要望を書いてみましたが好みにアレンジいただいて全然OKです！\nよろしくお願いします！\n\n以下要望です\n外見は可愛らしさがありつつ凛々しいイメージ、暗めの銀髪セミロングヘアーで藍色の瞳、猫耳と尻尾あり、耳と尻尾は銀色。\nスタイルはバスト大きめで腰のくびれがはっきりある綺麗系。\n年齢想定は18ぐらい。\n服装はホワイトブリム装着の黒いクラシカルなロングスカートメイド。\n袖は半袖、指ぬき手袋、手首にカフスあり。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@neco1mi/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3470112, "client_id": 1106955, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d5f5826/uploads/origins/efe0c746-135f-4b60-9d60-e3b273436a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2444e451359d5e45d0c338a64065e794", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d5f5826/uploads/origins/efe0c746-135f-4b60-9d60-e3b273436a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=943d65b9ed27d527a9c9983a26c0a89d", "src_set": ""}, "body": "いつも素敵で可愛らしいイラストを見させて頂いています！\n体の描き方めちゃくちゃ好きです…！！\nもしよければリクエストを送らせてください！\n個人Vtuberの蒼鼠いおるさん(@Aone_Ioru)のファンアートをお願いします。\n\n【構図・衣装など】\n・水着を着た蒼鼠いおるさんをお願いします。蒼鼠いおるさんに合いそうな先生イチオシの水着で！ \n・構図、背景はおまかせします。先生の自由に可愛らしくお願いします！ \n・髪型、アクセサリー等はアレンジしていただいても大丈夫です。\n\n【キャラ詳細】\n・蒼鼠いおるさんはおっとりとしていて可愛らしい女の子です。\n・肩に乗っているハムスターの有無はおまかせします。ハムスターは飛行することができます。\n・お胸はD~Eぐらいの大きさでお願いします。谷間が見えるように描いて頂けると大変嬉しいです。\n\n【参考資料】\n・規約\nhttps://lit.link/Ioruham\n・X\nhttps://x.com/Aone_Ioru\n・新衣装初期衣装まとめ\nhttps://drive.google.com/drive/folders/104gc_M8utijZeZNmW5QmkTZQJ7DvJyaL?usp=sharing\n・新衣装スクショまとめ(髪型アクセなど)\nhttps://drive.google.com/drive/folders/1euIdrf5Zn_NiiaCenfbKI1lyTlXR_ViI?usp=sharing\n\n【その他】\n・納品PSDデータは宛名・人物・背景などのレイヤー分けして頂けると助かります。\n・使用用途は蒼鼠いおるさん本人に限り、イラストの使用許諾（Twitterアイコン、YouTubeサムネ利用等）をいただければ幸いです。\n\n以上となります、どうぞよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@neco1mi/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3470112, "client_id": 465039, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89f9f9c7/uploads/origins/5eb8e4aa-c273-463b-8fad-80da3af380f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf3d48515463f55d082beca397e199c8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89f9f9c7/uploads/origins/5eb8e4aa-c273-463b-8fad-80da3af380f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0e4d109d51f54bd8d59e70c5fa554d9", "src_set": ""}, "body": "こんにちは、\nVTuber \"スクちゃん \"の寝起きを描いていただけませんか？\nポーズと設定例は参考文献にあります。\nパジャマとして着ているTシャツも参考文献にあります。お腹が出ている状態でお願いします。\nできれば隣に寝ている愛犬リンクも描いてください。まだ寝ています。丸めた状態で。\n以下の特徴に注意してください：\n- 顔のマーク\n- 髪の紫の筋\n- ふわふわの尻尾\n- 中くらいの胸\n- 太ももとお尻\n\nhttps://drive.google.com/drive/folders/1Esny1Ikd3Ky21gNA5yko85v2hLTWdRXB?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@neco1mi/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3470112, "client_id": 2938130, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6e659b3/uploads/origins/871b2572-2422-4a80-9bdf-12f902bdf71b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28bebd6fbeaea78ac5acb0d17e6b8d9f", "src_set": ""}, "duration": null, "nsfw": false, "h