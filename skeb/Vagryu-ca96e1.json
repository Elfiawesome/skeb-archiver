g=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=79e1bc39b78bc34a8172b9583e9a82ed 2x, https://si.imgix.net/eb1f0367/uploads/origins/5775db2e-dccb-4735-b3fd-7afcf8bbb9ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=00f4b748a1b0ea73793d53c23e40f40c 3x"}, "body": "こんにちは。この度はご応募ありがとうございました!とても素敵な作品ですね！私のデザインも気に入っていただけてとても嬉しいです！どうぞお好きなように描いてくださいね。またよろしくお願いします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Vagryu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 62432, "client_id": 769953, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0967e766/uploads/origins/f61bf114-16be-424d-b5fa-49a7f142754a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aefec43ba0ce67f64b90591e2ee7b530", "srcset": "https://si.imgix.net/0967e766/uploads/origins/f61bf114-16be-424d-b5fa-49a7f142754a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aefec43ba0ce67f64b90591e2ee7b530, https://si.imgix.net/0967e766/uploads/origins/f61bf114-16be-424d-b5fa-49a7f142754a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4816ea0c758366b2c4996e62c75b8b4 2x, https://si.imgix.net/0967e766/uploads/origins/f61bf114-16be-424d-b5fa-49a7f142754a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c44ad05bf1476f0b06a3d6d6a7faa67 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0967e766/uploads/origins/f61bf114-16be-424d-b5fa-49a7f142754a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ced731529673941c40d310330f0f70c", "srcset": "https://si.imgix.net/0967e766/uploads/origins/f61bf114-16be-424d-b5fa-49a7f142754a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ced731529673941c40d310330f0f70c, https://si.imgix.net/0967e766/uploads/origins/f61bf114-16be-424d-b5fa-49a7f142754a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6afeb161d1ddcb74e4da3307c1100919 2x, https://si.imgix.net/0967e766/uploads/origins/f61bf114-16be-424d-b5fa-49a7f142754a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=42d24453d5a40569a0c4a78ad94c129a 3x"}, "body": "アピールありがとうございます！リクエストを送らせて頂きます！\nもしよろしければ以下の内容をご一読の上でご検討頂き、ご対応頂ければと思います！\n\n【リクエスト内容】\n綺麗なロングへアのデュラハンの女の子（るがさんのイメージされるオリジナルの子でお願いします）\n\nるがさんのpixiv拝見しました…！色々な絵柄で描ける技術力がすごいな…と思いました…！\n僭越ながら絵柄の指定ができるのであれば「かわいい系・綺麗系」の絵柄で描いて頂けると嬉しいです。\n「こっちの絵柄のほうがいいな」という際にはそちらでも全然かまいません。お好みで描いて下さい。\n\n【希望内容】\n●構図はデュラハンなのでびっくりする見た目にはなりますが、頭と体が分離している状態でお願いします。\n　頭の位置の指定は特にありません。例として、片手or両手で持ったり、抱きかかえたり、座った時に太ももの上に乗せたり、机や台の上、クッションや床などに頭を置いたり、など…「こんな感じのイメージがいいな」と思ったお好みのイメージに合わせて描いて頂ければ幸いです。\n\n●首元の表現はマイルドな表現でお願いします。マフラーやチョーカーなどの小物を着飾るか隠す、服装の襟元で隠すか、断面を肌色で覆うなど…になります。逆に首元に炎を灯したり首の断面への猟奇的表現は避けてください。\n\n●ヘアスタイルはシニヨンなどの長さが分かりにくいまとめ髪系でなければ特に希望はありません。可能であればダウンスタイルだと嬉しいですがお好みにお任せします。\n　お好みに合わせて髪色・ヘアスタイルやアレンジ・アクセサリーなどを決めて描いて頂ければ幸いです。\n\n●キャラの見た目・シチュエーション・背景・表情などはお好みで描いて下さい。体型は特にこだわりが無いので健康的な見た目であれば問題ないです。\n\n●服装は鎧などのゴツゴツした衣装以外で、女の子らしい私服や服装をお好みで着せてあげてください\n\n●綺麗な画質で拝見したいので、psd形式での納品をお願いします。\n　可能であれば差分や線画・没ラフ案などもあわせて納品物の中に入れて頂けると大変うれしいです！\n\n●その他、ご不明点に関しては判断を一任させて頂きます。\n\n色々とお任せしている部分が多く、ご負担をおかけする内容となっております。\n内容以上となります。お忙しい中恐縮ですが、よろしくお願いいたします！", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Vagryu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62432, "client_id": 357553, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d019c2c/uploads/origins/cea07bb8-f399-4dba-b267-de57851b693e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2373d32b184fc87a7df0b3f313a43e90", "srcset": "https://si.i