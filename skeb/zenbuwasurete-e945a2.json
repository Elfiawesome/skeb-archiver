PGファンタジー世界のレンジャー（181cm、31歳）。元はマジテック武器商人だったが、武器倉庫の爆発事故で妻（ユア）を亡くしたため、町を出て森で暮らすことにした。妻が死んだのは自分のせいだと自責し、PTSDを患っている。\n\n妻の死の幻覚を避けるため、また不眠症を改善するため、いつも酒を飲んでいる。\n\n銃を使い（イスティンガーに似ている）、機械的な技術を持っている。夢見るような目をしている。  \n\nどんな風に描いても構わないので、銃を持ったカッコイイ彼を見たいし、彼のストーリーに関連した雰囲気が欲しい。\n\n服装は好きなように調整してもらって構いませんが、形や色調は参考のままでお願いします。  \n\nお読みいただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/1mCBo_1BMhvm2oU9RHmbtDke3NSixr0o4", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@zenbuwasurete/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3674723, "client_id": 1371334, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5560d16/uploads/origins/f6fb1726-c3a5-4a82-9c91-121418273883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74b7a01643e586f07f24f5fc0ae1ffc3", "srcset": "https://si.imgix.net/b5560d16/uploads/origins/f6fb1726-c3a5-4a82-9c91-121418273883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74b7a01643e586f07f24f5fc0ae1ffc3, https://si.imgix.net/b5560d16/uploads/origins/f6fb1726-c3a5-4a82-9c91-121418273883?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=087e7de26cac51fe3184a7ca75a246f9 2x, https://si.imgix.net/b5560d16/uploads/origins/f6fb1726-c3a5-4a82-9c91-121418273883?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad2958780bee428d48d44649b1020120 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5560d16/uploads/origins/f6fb1726-c3a5-4a82-9c91-121418273883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0bb9b1785a5cfd1608789edd23d438fa", "srcset": "https://si.imgix.net/b5560d16/uploads/origins/f6fb1726-c3a5-4a82-9c91-121418273883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0bb9b1785a5cfd16