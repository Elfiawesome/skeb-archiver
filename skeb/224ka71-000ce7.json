フランス旅行に行くため、ラフな格好。あまり思いつかないのでお任せ出来ればと思います。フードが好きなので、フードが付いてる服でお願いしたいです。被っているか否かもお任せしたいです。\n\n\nあまり具体的な内容が書けず申し訳ありません。\nご検討頂ければ幸いです。\nどうぞよろしくお願い致します！\n\nなお、内容に不備や不足がございましたら申し訳ございません。\n顔、髪色と長ささえ一致しておりましたら大丈夫ですので、腹筋さんのお好きなように書いて頂ければと思います。\n\nhttps://twitter.com/yakekuso_pc/status/1830948306911916439?s=46&t=wXEYTPZwHyvIfwjDYEvaCQ", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@224ka71/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2706100, "client_id": 1450960, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c9d1a795/uploads/origins/c7027fa8-cc40-4962-a0b4-a1de8921839b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2ea255b393ab64377470d7c60623806", "srcset": "https://si.imgix.net/c9d1a795/uploads/origins/c7027fa8-cc40-4962-a0b4-a1de8921839b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2ea255b393ab64377470d7c60623806, https://si.imgix.net/c9d1a795/uploads/origins/c7027fa8-cc40-4962-a0b4-a1de8921839b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2635331114934004a6a21b4347d14bb 2x, https://si.imgix.net/c9d1a795/uploads/origins/c7027fa8-cc40-4962-a0b4-a1de8921839b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5450af50f73b6855771945df1992b53 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c9d1a795/uploads/origins/c7027fa8-cc40-4962-a0b4-a1de8921839b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8cd2d3a7c2f35ee9c9c20dc5419b838", "srcset": "https://si.imgix.net/c9d1a795/uploads/origins/c7027fa8-cc40-4962-a0b4-a1de8921839b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8cd2d3a7c2f35ee9c9c20dc5419b838, https://si.imgix.net/c9d1a795/uploads/origins/c7027fa8-cc40-4962-a0b4-