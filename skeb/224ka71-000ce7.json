&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=16edff9df8ad4185feda4e7267ca7160, https://si.imgix.net/80deed7b/uploads/origins/5933acd1-afb8-435a-bca8-85bcbe66a558?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1ece5d81989c6918243b46c715fb0de1 2x, https://si.imgix.net/80deed7b/uploads/origins/5933acd1-afb8-435a-bca8-85bcbe66a558?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e38fdbf0270bd36cac7a2b8ab7902717 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2706100, "client_id": 1377136, "nc": 17}, {"path": "/@224ka71/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2706100, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c8617dd/uploads/origins/8dc92475-aa9d-4c56-899b-2368b9be41e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e712e79b0c1f51e618a44891c182682", "srcset": "https://si.imgix.net/2c8617dd/uploads/origins/8dc92475-aa9d-4c56-899b-2368b9be41e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e712e79b0c1f51e618a44891c182682, https://si.imgix.net/2c8617dd/uploads/origins/8dc92475-aa9d-4c56-899b-2368b9be41e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2280d3ea91c7953ae2af8d22ce3b7d82 2x, https://si.imgix.net/2c8617dd/uploads/origins/8dc92475-aa9d-4c56-899b-2368b9be41e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2500dcfdb4d845958c7a2611fb223a36 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c8617dd/uploads/origins/8dc92475-aa9d-4c56-899b-2368b9be41e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e42f2cabb09702556fea1b319f61bade", "srcset": "https://si.imgix.net/2c8617dd/uploads/origins/8dc92475-aa9d-4c56-899b-2368b9be41e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e42f2cabb09702556fea1b319f61bade, https://si.imgix.net/2c8617dd/uploads/origins/8dc92475-aa9d-4c56-899b-2368b9be41e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c17f65b35fdf3da2bd27cbeb6d6cdbf 2x, https://si.imgix.net/2c8617dd/uploads/origins/8dc92475-aa9d-4c56-899b-2368b9be41e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7cb92a8ca6dfed43beb6a802eee6f085 3x"}, "body": "腹筋様、初めまして。\nTwitterにて腹筋様のイラストを拝見し、ぜひ腹筋様に依頼したいと思い、リクエストを送らせていただきます。\nイラストの內容は、「エンジェル・デビル・インプロパー」というTRPGシナリオを通過した際に創作したキャラクターになります。\n\n以下、依頼內容です。\n\n✤內容\n資料URLにあります2名のキャラクターのイラストをお願いします。\n表情や構図の參考までにキャラクター詳細を下記に記載致します。(シナリオやHOのネタバレはございません)\n裝飾につきましては省略頂いても問題ありません。\nまた、人間体と天使悪魔体がありますが人間体をお願いできましたら幸いです。\nなお、悪魔の服裝はSDと立ち絵どちらでも構いません。\n\n✤構図\nお任せにてお願いいたします。\n描画範囲についてもお任せいたします。\n\n✤使用用途\n個人使用(PC壁紙や個人用グッズ、SNSのヘッダーやアイコン等。SNS掲載時にはクレジットいたします)、鑑賞\nまた、相方プレイヤーにも上記範囲內にて共有させて頂けましたら幸いです。\n\nお忙しいとは存じますが、ご検討いただけますと幸いです。\nもしなにか不足がありましたらキャンセルいただければと思います。\n\n何卒よろしくお願いいたします。\n\n✤以下、キャラクター詳細\n①HO天使\n名前：フェリクス＝クラーク\n性別：男\n身長：178cm\n性格：おおらかで楽観的。自己肯定感も他者肯定感も強い。みんな笑顔で楽しく暮らせたらいいのに。お人好し。悪魔がつんつんしているので話しかけるし構いまくる。ご飯も物も買い與える。\n趣味：舞台鑑賞・花鑑賞・宝石集め\n好きなもの：花・宝石・美味しいもの・美しいもの・優雅な休日・幸せそうに笑う顔\n嫌いなもの：ブラック企業・苦いもの・不協和音\nその他：悪魔にフルオーダースーツを買い与えた(SDイラスト参照)\n\n②HO悪魔\n名前：鴉隈 來守(くろすみ らいと)\n性別：男\n身長：174cm\n性格：天使のことが嫌い。自分より優れていて、底抜けに明るくて、苦労知らずに見えるから。でも自分のことはもっと嫌い。誰かを羨むばかりだから。天使を嫌いなのは羨ましい気持ちの裏返しと自覚しつつ、悪態をついて自分を誤魔化している。\n趣味：休みがあるなら寝ている\n好きなもの：美味しいもの、甘いもの(自覚なし)\n嫌いなもの：天使・上司・セロリ\nその他：タダ飯に弱い。\n\nhttps://drive.google.com/drive/folders/1-7MbL2ScPFXDSz4au9OSS2DQ7suGxzZy", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@224ka71/works/3", "private_thumbn