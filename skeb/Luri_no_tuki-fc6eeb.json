60f516fdd94fccf587c9a4de99e 2x, https://si.imgix.net/c82c276a/uploads/origins/10141886-948c-4b02-8548-6becd83504c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93e9f1904268b877345df47bf58aa39c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c82c276a/uploads/origins/10141886-948c-4b02-8548-6becd83504c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98890ac1bb2113ee42f77c605b31fa88", "srcset": "https://si.imgix.net/c82c276a/uploads/origins/10141886-948c-4b02-8548-6becd83504c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98890ac1bb2113ee42f77c605b31fa88, https://si.imgix.net/c82c276a/uploads/origins/10141886-948c-4b02-8548-6becd83504c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d154d747cf44a1cd0a82a620923999d3 2x, https://si.imgix.net/c82c276a/uploads/origins/10141886-948c-4b02-8548-6becd83504c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95877dda9e8298a74dc9b7e45142b22c 3x"}, "body": "瑠璃の坏☾様、はじめまして！\n個人勢としてVtuber活動をしているの御伽の国の住民の粽葉かえりと申します。\n\n瑠璃の坏☾様の作品(おめめのポスト)を拝見し 、もしよろしければ私のイラストを描いていただければと思いリクエストをお送りいたしました！\n\n【​リクエスト内容】\n瑠璃の坏様風に粽葉かえりのおめめを描いていただくことは可能でしょうか。\nイメージは御伽の国です！\nあまりにもおめめのポストが素敵すぎて...！(リンゴやクローバー等)\nおめめだけでも可能とポストを拝見しリクエストさせていただきました。\n\n\n【資料】\nhttps://drive.google.com/drive/folders/1inJjYg1pTz53u8Q08dJWY6mtxGiHlC2O?usp=sharing （三面図）\n\n【使用用途】\n・SNSのヘッダーに使用\n\n【希望内品形式について】\n・pngもしくはpsd\n\n【その他】\nお願いが沢山で大変恐縮ですが、ご都合が合いましたら宜しくお願い致します...！\n\nhttps://drive.google.com/drive/folders/1inJjYg1pTz53u8Q08dJWY6mtxGiHlC2O?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Luri_no_tuki/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2850009, "client_id": 2778631, "vtt_url": null, "th