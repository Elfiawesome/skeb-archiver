bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74fe34ea4914933d50cd911596cb2e35", "srcset": "https://si.imgix.net/670f5902/uploads/origins/f8216b92-933a-46e1-af79-157dc398d3b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74fe34ea4914933d50cd911596cb2e35, https://si.imgix.net/670f5902/uploads/origins/f8216b92-933a-46e1-af79-157dc398d3b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8f6c9de4e82b63412dac304c70953f7 2x, https://si.imgix.net/670f5902/uploads/origins/f8216b92-933a-46e1-af79-157dc398d3b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f02f5a6b008a0be48b00522222cfa957 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/670f5902/uploads/origins/f8216b92-933a-46e1-af79-157dc398d3b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=605e7dfd660ce2ddd5b0176d50fd0fc0", "srcset": "https://si.imgix.net/670f5902/uploads/origins/f8216b92-933a-46e1-af79-157dc398d3b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=605e7dfd660ce2ddd5b0176d50fd0fc0, https://si.imgix.net/670f5902/uploads/origins/f8216b92-933a-46e1-af79-157dc398d3b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aaeefc213f0ca4fd0722956ab9724d6c 2x, https://si.imgix.net/670f5902/uploads/origins/f8216b92-933a-46e1-af79-157dc398d3b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1367c84ede66aa6184f9113daa121a50 3x"}, "body": "こんばんわ。駆け込み気味のご依頼失礼いたします。\n今回は……単純に「放置されたままになってる代理描いてー」ですｗ\n以下、詳細です。\n\n【要望構図】\n●好きなポーズでいいのですが、なるべく全身図でお願いします。\n特徴としては……\n\n・資料上では体色は黄色ですが、オレンジ色で。クォートくん色、といえばわかりやすいかも？\n・角は一本一対、資料通りの特徴的な角。ただし、右角は半ばから折れてる。\n・耳は翼みたいな耳をしている。これもクォートくんと共通。\n・左角には「F」みたいなマークがある。\n・一応の普段着は長袖パーカーに長ズボン。資料にあるパーカーの色違い（おそらくは深緑or灰色？）\n（ただ、あくまで普段着なので好きな衣装を着せて大丈夫です）\n・指は４本。\n・翼に金属のカバーのようなものがある（なくても可）\n・両足と尻尾にバンドのようなものを巻いている。\n・眼鏡をかけている。\n・鼻の下に古傷がある。\n・実は元人間生体兵器設定があるので、任意でそれっぽいパーツをつけてもOK（※つけなくてもOK）\n\n参考資料はあくまで参考程度に。片方は時代が古く（おおよそ20年前）、もう片方はアナログのモノクロなので……。\n\n●念のため、参考資料に普段着の資料として、別キャラの服をつけていますが、それとは違う服を着せてもかまいません。\n\n■使用用途は……鑑賞とか絵の資料、他の方に代理を描いてもらう時の資料、ツイッターなりディスコードなりのアイコンやヘッダーになるかと思います。それ以外はそのつど使っていいかそちらに聞くことになると思います。\n\n難しめのお題でお手数をおかけしますが、よろしくお願いいたします。\n\nふぇるどら\n\nhttps://drive.google.com/file/d/1xY0paD4EgBVx6mrbj2xDifLhVBv5av4b/view?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 100221, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ふうじゅ", "screen_name": "fujyu_koyo", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-e40547fd-2c5c-413d-87bd-50af32c1868b.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fef9568a-23a4-400d-934d-e586869228fc.gif", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 160}, {"id": 402873, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "しま🥦制作中2件/受注停止", "screen_name": "shima46653800", "avatar_url": "https://www.gravatar.com/avatar/?d=identicon", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 161}, {"id": 1243201, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ふぇりおん", "screen_name": "ferrion15", "avatar_url": "https://pbs.twimg.com/profile_images/1917594440501538816/XGFj