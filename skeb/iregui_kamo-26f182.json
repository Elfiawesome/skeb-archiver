ても可愛いので、ぜひお願いしたいです<3 私はアートとパフォーマンスが大好きなサーカスのウサギです。表情やポーズは自由に選んでいただいて構いません！また、アートの.psdファイルは別にいただけますか？アイコンやヘッダーのスケジュール、SNSのサムネイルなどに使用する可能性があります。アートワークを使用した場合はクレジットをお渡しします！ありがとうございました。\nhttps://drive.google.com/drive/folders/1BW6fFlyGTLqMl4keFgDc0zeMtHYAlRb4\n(髪型はポニーテールですが、2つに分けています。）\n\nhttps://drive.google.com/drive/folders/1BW6fFlyGTLqMl4keFgDc0zeMtHYAlRb4", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@iregui_kamo/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2571105, "client_id": 1737429, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ddc9954/uploads/origins/37c65ddd-019b-4352-b4c8-a029bc1320b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c18fbdf9685968983dccfbc53b56ed8b", "srcset": "https://si.imgix.net/8ddc9954/uploads/origins/37c65ddd-019b-4352-b4c8-a029bc1320b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c18fbdf9685968983dccfbc53b56ed8b, https://si.imgix.net/8ddc9954/uploads/origins/37c65ddd-019b-4352-b4c8-a029bc1320b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35c6926c0b19c81f69f2add18cb39bce 2x, https://si.imgix.net/8ddc9954/uploads/origins/37c65ddd-019b-4352-b4c8-a029bc1320b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=120c1c2944b3f402877d755fd5dce2a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ddc9954/uploads/origins/37c65ddd-019b-4352-b4c8-a029bc1320b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a8dbd81ae6c703ad2d1e2f2d911a5b3", "srcset": "https://si.imgix.net/8ddc9954/uploads/origins/37c65ddd-019b-4352-b4c8-a029bc1320b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a8dbd81ae6c703ad2d1e2f2d911a5b3, https://si.imgix.net/8ddc9954/uploads/origins/37c65ddd-019b-4352-b4c8-a029bc1320b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2b83d32d513881a66cdfab876c8d8b1b 2x, https://si.imgix.net/8ddc9954/uploads/origins/37c65ddd-019b-4352-b4c8-a029bc1320b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=55acac4bbba3f503151672bb27353cac 3x"}, "body": "はじめまして、こんにちは。\n\n私と友人のキャラクターをいれぐい様のかっこいいイラストで描いていただきたくリクエスト致します。\n\n使用用途がアイコンなので、二人を別レイヤーに分けて描いていただけると嬉しいです。\nファイル形式はpng希望です。\n\n構図はいれぐい様にお任せいたします。\n\n【キャラクターの詳細】\n白髪の髪が短い方\n･ボーイッシュな女の子、クール、猫耳、鼻が少し黒い、薄い水色の目(瞳は丸)\n\n金髪のポニーテールの方\n･穏やかな女の子、猫耳、鼻は黒くない、緑目(瞳が猫目)\n\nご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1dv01fYBYmPXMgMIbuJCL5J64_zBfktay?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@iregui_kamo/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2571105, "client_id": 2550585, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5edc2560/uploads/origins/ab87aa80-4e82-4ab7-8d0b-9ebfecadd101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da391306865e05e8ff4451e2ec68bb73", "srcset": "https://si.imgix.net/5edc2560/uploads/origins/ab87aa80-4e82-4ab7-8d0b-9ebfecadd101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da391306865e05e8ff4451e2ec68bb73, https://si.imgix.net/5edc2560/uploads/origins/ab87aa80-4e82-4ab7-8d0b-9ebfecadd101?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6b545d49af8b6f93e34d0a1ffdc64f1 2x, https://si.imgix.net/5edc2560/uploads/origins/ab87aa80-4e82-4ab7-8d0b-9ebfecadd101?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=961c9bafcb9ce3fd3117d2c7ed823572 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5edc2560/uploads/origins/ab87aa80-4e82-4ab7-8d0b-9ebfecadd101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a8f52f67559a95946caba7a2c6da4a3", "srcset": "https://si.imgix.net/5edc2560/uploads/origins/ab87aa80-4e82-4ab7-8d0b-9ebfecadd101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a8f52f67559a95946caba7a2c6da4a3, https://si.imgix.net/5edc2560/uploads/origins/ab87aa80-4e82-4ab7-8d0b-9ebfecadd101?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9753e5f7e2031a3e0ce6983ccdfe9306 2x, https://si.imgix.net/5edc2560/uploads/origins/ab87aa80-4e82-4ab7-8d0b-9ebfecadd101?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f19a06a8d4d84d4cf6e8278a204b77b2 3x"}, "body": "いれぐい🐝様\n\nはじめまして、\n個人Vtuberの胡羽ラルアと申します。\n\nいれぐい🐝様の描かれるイラストがとってもお洒落で可愛かったので是非依頼させていただきたいと思い今回リクエストを送らせていただきました！\n\n【書いていただきたいイラストについて】\n・キャラクター：胡羽ラルア(自分)\n　(種族 : 天使と吸血鬼のハーフ)\n・誕生日が近いのでアネモネ(白と紫)の花束を持っているような構図でお願いしたいです。\n・その他背景などの詳細はお任せいたします。\n・データはレイヤーを人物の透過版と背景を分けそれぞれpsdデータでいただけると嬉しいです。\n\n【使用用途】\n・SNSでの宣伝活動や配信での使用\n・サムネイル\n・ネットプリント\n・可能であればグッズ化\n\n【胡羽ラルアについて】\nTwitter : https://twitter.com/KohaneLalua\nYouTube : https://youtube.com/@KohaneLalua\nHP : https://lit.link/KohaneLalua\n\n詳細資料についは資料URLにGoogledriveのURLを添付させていただいております。\n何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-699r5VkpxZaZa8C3TnBWh4kjaqhO2m7\n\nhttps://drive.google.com/drive/folders/1-699r5VkpxZaZa8C3TnBWh4kjaqhO2m7", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@iregui_kamo/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2571105, "client_id": 1502066, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09542bde/uploads/origins/3292d2fd-7e9f-4bba-b9b4-8b7d1f31bbcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bea8c792fd5e91cc0a269e50bc71209", "srcset