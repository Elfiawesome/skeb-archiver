 false, "creator_id": 3874372, "client_id": 2991457, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e24885a/uploads/origins/feb8cc5d-818d-4fb9-9587-fc5a5ac45472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0787d774e26f0f16e5d7edde2e4fcd2", "srcset": "https://si.imgix.net/3e24885a/uploads/origins/feb8cc5d-818d-4fb9-9587-fc5a5ac45472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0787d774e26f0f16e5d7edde2e4fcd2, https://si.imgix.net/3e24885a/uploads/origins/feb8cc5d-818d-4fb9-9587-fc5a5ac45472?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e4accb2c6552399510c5bf67501b4b6 2x, https://si.imgix.net/3e24885a/uploads/origins/feb8cc5d-818d-4fb9-9587-fc5a5ac45472?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ecf4805292c43f3ba9c47dc8b6476e0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e24885a/uploads/origins/feb8cc5d-818d-4fb9-9587-fc5a5ac45472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f9aaa86e84f36054a127f1a0c72747e", "srcset": "https://si.imgix.net/3e24885a/uploads/origins/feb8cc5d-818d-4fb9-9587-fc5a5ac45472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f9aaa86e84f36054a127f1a0c72747e, https://si.imgix.net/3e24885a/uploads/origins/feb8cc5d-818d-4fb9-9587-fc5a5ac45472?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9325dcd9273ace6e1943724575f5c92 2x, https://si.imgix.net/3e24885a/uploads/origins/feb8cc5d-818d-4fb9-9587-fc5a5ac45472?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56839fb8e492ba6ca73ab44017fcc6cc 3x"}, "body": "灯戸さんのかわいい絵で兄妹のOCを描いていただきたくリクエスト送らせていただきます！\n\n妹\n・上半身はフリル付きシャツに黒の細いリボンでショート丈のジャケットを着ている。\n・下半身には黒のタイツで、上着と同じ生地のスカート。普段靴はエナメルの黒いローファーを履いています。\n・黒髪ロング\n・色白の女の子\n・紫に近い灰色の目、黒い瞳孔\n・大きなバスト\n\n兄\n・決まって白いシャツにスーツでベストまで着ているおしゃれさん、靴はレースアップ\n・ちゃっかり妹ちゃんの上着に近い色のネクタイを締めている\n・くっきり黒眉\n・黒髪で撫でつけのオールバック\n・オレンジ色の瞳に黒い瞳孔\n・右目に金縁のアルセーヌルパンのような片眼鏡をかけている\n\nお兄さんのほうが大きいですが、２人とも160cm前後で身長差はあまりないです。\n\n服装などが違いますが、2人の雰囲気が伝われば嬉しいのでイラストを添付します。\n\nお兄さんがクールで妹が元気なイメージで...\nそんな雰囲気が絵から感じられたら嬉しいです、ぜひ灯戸さんの世界に２人を連れて行ってくれると嬉しいです。構図等はお任せします！\n\nデスクトップ背景に設定するなど観賞用、個人利用としてのリクエストです。16:9で頂けるとなおうれしいです！\n\nどうぞご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1ZlX7aIDPzkLPFqcUEJfIJZb9lmoFJTSd?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@touyu_kan/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3874372, "client_id": 3274797, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9bfb4afa/uploads/origins/c989621e-d352-48ab-ab49-3a1c69af5316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6814530b7f5d0d63a66a55641247e484", "srcset": "https://si.imgix.net/9bfb4afa/uploads/origins/c989621e-d352-48ab-ab49-3a1c69af5316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6814530b7f5d0d63a66a55641247e484, https://si.imgix.net/9bfb4afa/uploads/origins/c989621e-d352-48ab-ab49-3a1c69af5316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb98365d9ed5e98d10c6d568e26051b2 2x, https://si.imgix.net/9bfb4afa/uploads/origins/c989621e-d352-48ab-ab49-3a1c69af5316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dda1163cb444501da792bf3c84b89972 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9bfb4afa/uploads/origins/c989621e-d352-48ab-ab49-3a1c69af5316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=471bb22e4b5e2c5481011d44f7fd920e", "srcset": "https://si.imgix.net/9bfb4afa/uploads/origins/c989621e-d352-48ab-ab49-3a1c69af5316?bg=%23fff&auto=f