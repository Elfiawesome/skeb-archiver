m Tarkovというゲームのイメージに沿っているので参考にならないかもしれません、、\nまた、これまでのキャラは髪で目が隠れていますが気にせず目をかいていただいて結構ですし、隠してもらっても構いません。あまりかわいすぎるのは自分に合ってないなーと思って、ちょっと陰キャっぽくしようとしてあのデザインになってました。とにかくキラーっぽい雰囲気のある男の子をお願いします！！\nりらくまさんのイメージでお好きに描いていただけると嬉しいです😊", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rirakuma_360/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 91081, "client_id": 449878, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2759f1ad/uploads/origins/5ff23bc1-78c1-4ec9-bb56-10cd6b94c38c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c887a5f011249ee1a878326db6097c82", "srcset": "https://si.imgix.net/2759f1ad/uploads/origins/5ff23bc1-78c1-4ec9-bb56-10cd6b94c38c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c887a5f011249ee1a878326db6097c82, https://si.imgix.net/2759f1ad/uploads/origins/5ff23bc1-78c1-4ec9-bb56-10cd6b94c38c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9c1bcc68775fcddb0ca7292b159dfc1 2x, https://si.imgix.net/2759f1ad/uploads/origins/5ff23bc1-78c1-4ec9-bb56-10cd6b94c38c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e053f2a61a3cbbf6671ef1ac59e597c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2759f1ad/uploads/origins/5ff23bc1-78c1-4ec9-bb56-10cd6b94c38c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2e9ab25b1d27dcc31499497b7481c50", "srcset": "https://si.imgix.net/2759f1ad/uploads/origins/5ff23bc1-78c1-4ec9-bb56-10cd6b94c38c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2e9ab25b1d27dcc31499497b7481c50, https://si.imgix.net/2759f1ad/uploads/origins/5ff23bc1-78c1-4ec9-bb56-10cd6b94c38c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9894736