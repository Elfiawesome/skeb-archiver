たしません。\n\n設定↓\n名前：リエル\n年齢：本人曰く覚えてない(人間年齢だと18〜20歳ぐらい)\n身長：172cm\n性別：性別無し…というよりも相手に合わせて変えられる\n\n母が天使、父が悪魔のハーフの子。\n性に奔放で相手が男でも女でも夜を共にすることができる。\n\n悪魔っぽい少し目立つ犬歯がある。\n人間が好きなのでたまに人間界に行って学生に紛れて生活したりする。その際に性別はどちらにするとは決めていないので男で生活する時もあれば、女の時もある。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1HS1ScLxHRmrKmj1KY-pTinayCKXU341b", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@U_rei__/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/01e9ef53/uploads/origins/a40ef2dc-81e4-4221-b67a-a07e837f095f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7afa08ec86fe3a4dc12a1eae65636235", "srcset": "https://si.imgix.net/01e9ef53/uploads/origins/a40ef2dc-81e4-4221-b67a-a07e837f095f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7afa08ec86fe3a4dc12a1eae65636235, https://si.imgix.net/01e9ef53/uploads/origins/a40ef2dc-81e4-4221-b67a-a07e837f095f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=700bac419708af0088140c104117628a 2x, https://si.imgix.net/01e9ef53/uploads/origins/a40ef2dc-81e4-4221-b67a-a07e837f095f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e6cdb9b6e19d6004f305bd4607ce295 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3412761, "client_id": 3153095, "nc": 177}, {"path": "/@U_rei__/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3412761, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d722814f/uploads/