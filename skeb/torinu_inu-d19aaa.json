耳。桜色の瞳。桜色の鉄扇で戦う\n\n自称神様！　主人公に信じてもらおうと必死\n「なんと、ボクは神様なのですよー！」\n「本当なのです！　嘘じゃないのですよ！！」\n「黄葉、確かにその願い聞き届けたのです」\n\n\n【参考】\nhttps://x.com/hiragiyuren/status/1715652202604433625?s=20\nhttps://x.com/hiragiyuren/status/1730584319813718354?s=20\nhttps://novelup.plus/story/887579850\n\n\n\n使用用途は、Twitter、ノベルアップ、個人観賞を考えております。\n\n宜しくお願い致します！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@torinu_inu/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2774947, "client_id": 2162536, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a31509cf/uploads/origins/5cdbedca-a236-40fe-b18d-1dd1dfba04f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b610e12779f2cd4580adfc29be1eff1e", "srcset": "https://si.imgix.net/a31509cf/uploads/origins/5cdbedca-a236-40fe-b18d-1dd1dfba04f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b610e12779f2cd4580adfc29be1eff1e, https://si.imgix.net/a31509cf/uploads/origins/5cdbedca-a236-40fe-b18d-1dd1dfba04f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4eea17eec25fb95e557b6b873956482e 2x, https://si.imgix.net/a31509cf/uploads/origins/5cdbedca-a236-40fe-b18d-1dd1dfba04f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d76178ccf304b6a9eb91dcd0cb87d728 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a31509cf/uploads/origins/5cdbedca-a236-40fe-b18d-1dd1dfba04f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fdcee9d3a0a31c5d01a893be99a0a5c6", "srcset": "https://si.imgix.net/a31509cf/uploads/origins/5cdbedca-a236-40fe-b18d-1dd1dfba04f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fdcee9d3a0a31c5d01a893be99a0a5c6, https://si.imgix.net/a31509cf/uploads/origins/5cdbedca-a236-40fe-b