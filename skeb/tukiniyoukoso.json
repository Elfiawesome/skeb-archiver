ります。\nまた、髪色は黒というよりはほんの少し緑より(海苔概念)となっております\n\n【使用用途】\n田中すじゅさん自身のVtuber活動におけるサムネイルやXの投稿に使用させていただけたらと思います\nそのためキャラクターのみなど差分が含まれるpsdファイルをいただけますと幸いです\nまた他の素材と組み合わせたりする可能性もございます(いわゆるおはようvtuberタグへの投稿)\n\nそれでは、ご検討のほどよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukiniyoukoso/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2310754, "client_id": 2780955, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/121da204/uploads/origins/0a7a3fcd-e03b-4a47-9d43-310c8745a5a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a8af1101b4e27a997d1f30da6ee8d6c", "srcset": "https://si.imgix.net/121da204/uploads/origins/0a7a3fcd-e03b-4a47-9d43-310c8745a5a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a8af1101b4e27a997d1f30da6ee8d6c, https://si.imgix.net/121da204/uploads/origins/0a7a3fcd-e03b-4a47-9d43-310c8745a5a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12c5c3d6ab63d64b946923bb07fedf14 2x, https://si.imgix.net/121da204/uploads/origins/0a7a3fcd-e03b-4a47-9d43-310c8745a5a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94d821c11f617507920b483dcf9f948f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/121da204/uploads/origins/0a7a3fcd-e03b-4a47-9d43-310c8745a5a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1fcd5456151039bf8aa60cb99f88a42", "srcset": "https://si.imgix.net/121da204/uploads/origins/0a7a3fcd-e03b-4a47-9d43-310c8745a5a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1fcd5456151039bf8aa60cb99f88a42, https://si.imgix.net/121da204/uploads/origins/0a7a3fcd-e03b-4a47-9d43-310c8745a5a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s