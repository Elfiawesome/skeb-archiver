&s=1a7a0bfdc05afe21ccaabcbcb056f8a6, https://si.imgix.net/55ea1850/uploads/origins/ff6b1144-825e-4a97-a6e7-cc21e1b7a4b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=efeab4b718fe9e632f05d007dc1aa7c6 2x, https://si.imgix.net/55ea1850/uploads/origins/ff6b1144-825e-4a97-a6e7-cc21e1b7a4b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96819e611200d15d86dd625cb151f36c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55ea1850/uploads/origins/ff6b1144-825e-4a97-a6e7-cc21e1b7a4b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63e58e7f0201871cfa7b3737b983d200", "srcset": "https://si.imgix.net/55ea1850/uploads/origins/ff6b1144-825e-4a97-a6e7-cc21e1b7a4b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63e58e7f0201871cfa7b3737b983d200, https://si.imgix.net/55ea1850/uploads/origins/ff6b1144-825e-4a97-a6e7-cc21e1b7a4b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c5ff4efb8c9f54ec45a676b2f317e60f 2x, https://si.imgix.net/55ea1850/uploads/origins/ff6b1144-825e-4a97-a6e7-cc21e1b7a4b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=22a89371fb76a3952588f3ecf9b8940a 3x"}, "body": "金缶さんのイラストがとても好みでぜひ依頼させてください！\n\n私のオリジナルキャラクターのイラストを描いてください！\nテーマは「カンフー」で、全身のイラストでお願いします。\n服装はパンツスタイルのチャイナ服でお願いします。\nらんま1/2のような感じをイメージしていますが、お任せします！\n\n参考画像はURLを参照ください。\n髪型は、犬耳と前髪のアクセントがあれば、\nテーマに合わせて髪型を変えても問題ないです！\n\n背景の有無はお任せします！\nどうぞよろしくお願いいたします。\n\nhttps://lit.link/chnm74", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@o_kinkan_kun/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1015046, "client_id": 2593282, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c05a58ec/uploads/origins/