ので、そちらに関しては金缶様の絵柄に合わせて変えていただいても構いません。胸がないのはデザインした方のこだわりなので、胸は貧しくお願いします。\n\n▼使用用途\n\n個人Vtuber活動での使用\n\nTwitterなどSNSへの掲載（投稿・ヘッダー等)\n\nYoutube配信や動画のサムネイル、ショート動画(歌ってみた)に使用させて頂く予定です。\n\n\n※納品につきましては\n背景と人物が分けられた透過処理データ\npngまたはPSDデータですと大変ありがたいです。\n\nhttps://drive.google.com/drive/folders/1-FgNPwNLqMmAtvW2y61fceePvlK_QmLG", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@o_kinkan_kun/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1015046, "client_id": 977975, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/00c9faa5/uploads/origins/5fb27da1-308c-49d0-a414-b49d53b6629f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92ebf75e30185b997478f5f051e64897", "srcset": "https://si.imgix.net/00c9faa5/uploads/origins/5fb27da1-308c-49d0-a414-b49d53b6629f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92ebf75e30185b997478f5f051e64897, https://si.imgix.net/00c9faa5/uploads/origins/5fb27da1-308c-49d0-a414-b49d53b6629f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=877cb9ef31f3f7ab21162b15ba912479 2x, https://si.imgix.net/00c9faa5/uploads/origins/5fb27da1-308c-49d0-a414-b49d53b6629f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6fe3a892d7be3b5cf382c1f39a011e3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00c9faa5/uploads/origins/5fb27da1-308c-49d0-a414-b49d53b6629f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9236904093f2ec1eb30a5c11e93b6b44", "srcset": "https://si.imgix.net/00c9faa5/uploads/origins/5fb27da1-308c-49d0-a414-b49d53b6629f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9236904093f2ec1eb30a5c11e93b6b44, https://si.imgix.net/00c9faa5/uploads/origins/5fb27da1-308c-49d0-a414-b49d53b6