ジや、わたくしのデザインはGoogleドライブ内の資料を参考にしていただければ幸いです。\n\n描いていただいたものは、わたくしのTwitterで公開、また配信や歌みたのサムネイルに使用させていただきたいです。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10VW0XswN0u4EHK4oo1KL-Vj_CuxCiJZF?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kt2ju0/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1277800, "client_id": 429772, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3291a67e/uploads/origins/88b444b0-a127-4216-91b5-9071f2b4a16f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9f9670f85e0381257ca7e8b84206f39", "srcset": "https://si.imgix.net/3291a67e/uploads/origins/88b444b0-a127-4216-91b5-9071f2b4a16f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9f9670f85e0381257ca7e8b84206f39, https://si.imgix.net/3291a67e/uploads/origins/88b444b0-a127-4216-91b5-9071f2b4a16f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=922d58db8cd823cbad6bfb34a266d221 2x, https://si.imgix.net/3291a67e/uploads/origins/88b444b0-a127-4216-91b5-9071f2b4a16f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d573544cd1df51e8e21b3b68c574f83 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3291a67e/uploads/origins/88b444b0-a127-4216-91b5-9071f2b4a16f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e480a814812c2137237fe77fd29b545", "srcset": "https://si.imgix.net/3291a67e/uploads/origins/88b444b0-a127-4216-91b5-9071f2b4a16f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e480a814812c2137237fe77fd29b545, https://si.imgix.net/3291a67e/uploads/origins/88b444b0-a127-4216-91b5-9071f2b4a16f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0d7e5735a7bcc7a1c518ef28bd598c49 2x, https://si.imgix.net/3291a67e/uploads/origins/88b444b0-a127-4216-91b5-9071f2b4a16f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cdee08c5f0e194afaab2809f72b302b1 3x"}, "body": "こんにちは！私はあなたのアートワークが大好きです。私はあなたの作品がとても好きです。私と友人のオリジナルキャラクターを描いていただけたらとても嬉しいです。\n\n黒髪の人は18歳のエクソシストです。彼は真面目なタイプで、あまり笑わない。白髪は、いつも彼に付き添って任務を手伝ってくれるゴーストです。人懐っこいように見えて、実はミステリアスな存在です。日常生活では喧嘩ばかりしているが、任務中はとても仲が良い。\n\n白樺の森の中を歩いているところを描いてくれると嬉しいですね。迷子や家出をしているように見えるが、急いでいないし、表情も落ち着いている。\n\nご検討いただきありがとうございました。\n\nhttps://drive.google.com/drive/folders/1-QVHkf6w0yeNFEev-OY6QUbbyHnPLaCV?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kt2ju0/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1277800, "client_id": 1235802, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/205d8855/uploads/origins/dda79682-e4b6-4bc8-b35a-221873654509?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78e4698dbdba91e81fc138bb47e9d35f", "srcset": "https://si.imgix.net/205d8855/uploads/origins/dda79682-e4b6-4bc8-b35a-221873654509?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78e4698dbdba91e81fc138bb47e9d35f, https://si.imgix.net/205d8855/uploads/origins/dda79682-e4b6-4bc8-b35a-221873654509?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=922fb9b6f08dd8ac8ed8341fa748a32b 2x, https://si.imgix.net/205d8855/uploads/origins/dda79682-e4b6-4bc8-b35a-221873654509?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2023dc163d8b4c382156de3a191a0f00 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/205d8855/uploads/origins/dda79682-e4b6-4bc8-b35a-221873654509?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4a98bc54da