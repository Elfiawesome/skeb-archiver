うに描いて頂ければと思います。 \n\n 【用途】 \n頂いたイラストは個人での鑑賞、教授様のお名前を記載させて頂いた上で、趣味の範囲でSNSのヘッダーやアイコン、個人利用のグッズに使用する等をさせて頂ければと思います。 \n有償利用や配布、販売、AI学習などは致しません。  \n\n宜しければご検討ください。 \n金額の訂正、依頼の不足がありましたら、キャンセルもしくは再要請をお願いします🙇‍♀️", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@072207honey_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4038855, "client_id": 4002063, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d98ec071/uploads/origins/397dfc7a-fe18-410b-a917-27c1eddb3852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfa247fac7c6c0e3306c44c228f591e0", "srcset": "https://si.imgix.net/d98ec071/uploads/origins/397dfc7a-fe18-410b-a917-27c1eddb3852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfa247fac7c6c0e3306c44c228f591e0, https://si.imgix.net/d98ec071/uploads/origins/397dfc7a-fe18-410b-a917-27c1eddb3852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af1a3c0d67aa8505fa929731acfaca29 2x, https://si.imgix.net/d98ec071/uploads/origins/397dfc7a-fe18-410b-a917-27c1eddb3852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f69dd62c6d3c9d02ad53b5419bac35d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d98ec071/uploads/origins/397dfc7a-fe18-410b-a917-27c1eddb3852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1e4a74b4eb2636466260dafd49efa33", "srcset": "https://si.imgix.net/d98ec071/uploads/origins/397dfc7a-fe18-410b-a917-27c1eddb3852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1e4a74b4eb2636466260dafd49efa33, https://si.imgix.net/d98ec071/uploads/origins/397dfc7a-fe18-410b-a917-27c1eddb3852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=466dcae8692007fb7a32