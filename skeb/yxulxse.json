3f/uploads/origins/7353cd1d-5726-4c0e-9221-24535ced120e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb70a668bdcbf51b4c946b3a6411acd4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3192d23f/uploads/origins/7353cd1d-5726-4c0e-9221-24535ced120e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0280be6ca92d6a8a472b12087ce2b31", "src_set": ""}, "body": "【Vtuber「楪(ゆずりは)」のイラストをお願いいたします。】\n\n初めまして、とても素敵なイラストに惹かれてまいりました。\nこの度はVtuber活動で使用するイラストを依頼させていただきたくリクエストいたしました。‬\nご検討いただけますと幸いです。\n\n＜用途内容＞\nSNSでの掲載、配信や動画のサムネイルやヘッダー等。可能であればグッズ化等。\n※使用の際にトリミング等をする可能性がございます。\n※グッズ等の商用利用不可の場合はお手数ですが別レイヤーに記載いただけますでしょうか。\n\n＜希望内容＞\n・衣装は参考資料URLの三面図にある「白色系ブレザーの冬制服」希望。\n・頭や手などが上や横で切れていないと有難いです。\n・PSDでの納品が可能である場合、前景・背景・人物のレイヤーを別けていただきたいです。\n\n以下内容の中で、描いてみたいと思うものがありましたら、お描きいただければと思います。\n特にないようでしたら、他の内容でも問題ありません。\n\n◆フォークでケーキを食べている\n　※他の食べ物でも問題ありません。\n◆スプーンですくったアイスを相手の口に向かって差し出している\n　※他の食べ物でも問題ありません。\n◆壁ドンをしている風（向かって手前側に腕がある）\n◆片手または両手で囁いている\n\n＜参考資料＞\n三面図など：https://yuzu21g.fanbox.cc/posts/1962300", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yxulxse/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3306219, "client_id": 1043593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b82731d/uploads/origins/691e19b0-0766-48d1-99f5-8e8a062ddf48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eea0759a5dace029f73b579aef563d74", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b82731d/uploads/origins/691e19b0-0766-48d1-99f5-8e8a062ddf48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=927a77969b33749c2bc586be4bcea581", "src_set": ""}, "body": "赦世さん\nお世話になっております。レイ・リークと申します。\n前回のデフォルメアイコンのイラストありがとうございます！\nオリキャラという無理難題なご依頼に答えていただき大変、嬉しく存じます。\n\n要望についてですが、前回のオリキャラが希望に沿った形になったため、今回はそのイラストを元に、全身の立ち絵の作成をお願いいたします。\n使用用途ですがTwichやYoutubeでの配信で使用予定です。\n\n以下に詳細を記載します。\n・高さ6000px以上・350dpiくらいを希望\n　（ガチ恋距離やバストアップ時に映り良くなるくらいが嬉しいです。調べて出て来た数値なので間違えてたらすみません。）\n・ファイル形式ですが【psd】を希望\n・頭から足先までの全身の立ち絵　前姿と後姿の２アングル希望\n・オリキャラの男性キャラクター\n・目のカラーは引き続き金目な感じでお願いします。\n・髪型は前回のイラストと同じでお願いいたします。\n　（イメージは変わらずDDFFのFF5バッツとFF8スコールを足して割った感じを希望）\n・ヘアカラーは前回の髪色で満足してます！メッシュカラーも同じでお願いいたします。\n・キャラクター像は元気系をイメージ\n・今回の全身立ち絵でズボン部分、靴部分もございますが、服装は前回の赦世さんが描いた、服も色も大変満足してますので、延長で書いていただけると非常に助かります。\n・ポージングは全身立ち絵のため指定なし。赦世さんの感覚でお願いいたします。\n・顔の表情だけ立ち絵とは別に、追加で２種描いてほしいです。笑顔Verと顔に影がかかってるVerの２種希望\n影がかかっている物の参考資料を貼ります。あくまで資料としてお願いいたします。\nhttps://x.com/REi_X59/status/1567447895825354752\nhttps://x.com/REi_X59/status/1768086978783019258\n（表情は顔だけの描写で大丈夫です。こちらはあくまで希望のため出来たらでお願いいたします。）\n・今回の立ち絵に、使用したカラーのパレットを置いてほしく、またメガネ有り無しを用意していただけると嬉しいです。\n\n以上になります。\n赦世さんの描く全身の立ち絵をぜひ見たい！、という思いで要望いたしました。\n希望をいくつか書かせていただきましたが、厳しいと判断されましたらこの限りではありません。\n\nつたない文章とまとめで申し訳ございません。\nお忙しいところ恐れ入りますが、上記の内容をどうぞよろしくお願いいたします。\n\nhttps://skeb.jp/@yxulxse/works/1", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yxulxse/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/966bb2aa/uploads/origins/438be7d3-2e3e-4751-a0ec-e12dfda4cabc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27b161584fddf05b5e34c9a0feb860da", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3306219, "client_id": 2458042, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yxulxse/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3306219, "client_id": 1043593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a781967/uploads/origins/ea45b8f1-ccb0-422e-b90f-9179098e2977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1483c598ba476fe6119dde140e34b660", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a781967/uploads/origins/ea45b8f1-ccb0-422e-b90f-9179098e2977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c898a94a7df7f74b7421ccc3ab85cd6", "src_set": ""}, "body": "初めまして。レイ・リークと申します。\nXの投稿やTwichを拝見してご依頼をしてみたいと思いリクエストいたしました。\n\nデザインはオリジナルキャラ希望。\n空想上な情報になりますが以下にまとめます。\n\n・112 x 112ピクセルから4096 x 4096ピクセルの正方形サイズでアイコン希望です。\n　（出来ましたらピクセル数が2400以上希望。）\n・デフォルメキャラ希望\n・男性キャラクター\n　（メガネあり・スクエア型かアンダーリム型希望・グレーかブラウンのカラーグラス希望）\n・髪型はミディアムショート？かウルフカット？で外ハネあり、知識が乏しくてすみません。\n　（イメージとしてはDDFFのFF5バッツとFF8スコールを足して割った感じを希望）\n・ヘアカラーは紺色をメインにメッシュで赤色を少し\n・キャラクター像は元気系をイメージ\n　（FF14のヴィエラ族オスの顔タイプ3風を希望）\n・服はスーツか軍服希望\n　（アイドリッシュセブンに出てくるTRIGGERの軍服アイドル衣装風を希望）\n・ポージングはアイドルみたいに手のひらを広げて差し伸べてる風\n　（こだわりはないのでポーズ変えても大丈夫です）\n\n以上になります。\n風って書いてるところはあくまで脳裏で浮かんでる案です。忠実に再現しなくて大丈夫です。\nデフォルメ希望ですが厳しい場合、等身イラストに変更も大丈夫です。\n\n初の依頼でつたない文章とまとめで申し訳ございません。\nお手が空いてるときにでも差支えが無ければご確認いただけると嬉しいです。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1807724, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "kaco😇skeb募集中", "screen_name": "K_a_c_o_", "avatar_url": "https://pbs.twimg.com/profile_images/1869230119199641600/IUk15m2H.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1002376423070240769/1702825342/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2384807, "creator"