ムネイル等に使用したいため、背景透過版もいただけると助かります。  \n\nお忙しいところ恐縮ですが、ご検討の程どうぞよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1TYevnSW25Lfkvmbj9CHkpQBPFdul0Scz", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@000000yoko/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3884163, "client_id": 3392310, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73f27f19/uploads/origins/698b4d7d-1b34-4569-b815-050b665875a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aefadf4db1c0d38345a30c1e47b097f6", "srcset": "https://si.imgix.net/73f27f19/uploads/origins/698b4d7d-1b34-4569-b815-050b665875a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aefadf4db1c0d38345a30c1e47b097f6, https://si.imgix.net/73f27f19/uploads/origins/698b4d7d-1b34-4569-b815-050b665875a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49cefd36931c53235ae8217e4d8f61e9 2x, https://si.imgix.net/73f27f19/uploads/origins/698b4d7d-1b34-4569-b815-050b665875a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b6408ad352035e798161ee9abc45132 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73f27f19/uploads/origins/698b4d7d-1b34-4569-b815-050b665875a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f37d98b6760cc4e2f1e4248737e277a6", "srcset": "https://si.imgix.net/73f27f19/uploads/origins/698b4d7d-1b34-4569-b815-050b665875a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f37d98b6760cc4e2f1e4248737e277a6, https://si.imgix.net/73f27f19/uploads/origins/698b4d7d-1b34-4569-b815-050b665875a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f345c0d293844bb4d9d8f9d47e462610 2x, https://si.imgix.net/73f27f19/uploads/