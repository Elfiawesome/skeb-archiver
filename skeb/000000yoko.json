net/1bae3d84/uploads/origins/53855687-e278-4bde-8507-2d81ff7a0f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0aec352644bb075faab0c782d93b38e1, https://si.imgix.net/1bae3d84/uploads/origins/53855687-e278-4bde-8507-2d81ff7a0f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3f679e86789a9521ad9aa23de39decfb 2x, https://si.imgix.net/1bae3d84/uploads/origins/53855687-e278-4bde-8507-2d81ff7a0f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=825d87081ee8ec4533731c38cdff2332 3x"}, "body": "yokozawa様、はじめまして！\nデザイン活動をしている「Que」と申します。(X: @9ue0w0)\n\nyokozawa様の絵柄がとても素敵で自身のOCイラストを描いていただきたく今回依頼させて頂きました。\n\n●使用用途\n自身が制作したサムネイルデザインなどのモデル、SNSアイコン\n\n●納品形式\nよろしければPSD形式でお願いいたします\n\n●イラストイメージ\nURLにて共有させていただきます。\nポーズ・構図・表情などはおまかせ致します！\n服装などyokozawa様が描きやすいように変更いただいても構いません。\n\nリクエスト金額で上記の内容が難しいようであれば再送要請をお願いいたします。\nお忙しい中恐縮ですがご検討の程よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1kfMum87xmvUlXBHgi7oC8GVFx2T5Wn0C", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@000000yoko/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3884163, "client_id": 3163043, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c021c54b81d57497736b4c9c2cc01a8d", "srcset": "https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c021c54b81d57497736b4c9c2cc01a8d, https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e146a2d5fff85f8111a14d579db1546 2x, https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb05ad798e4dfe45fa2cc10bdd2858d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c09eb3f6d74e7c5f241ab7017ec674b", "srcset": "https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c09eb3f6d74e7c5f241ab7017ec674b, https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e47209fd5b0e4a223d24e048fb8f4696 2x, https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=39a07aaaf0b3aa04462f68a0182f066d 3x"}, "body": "はじめまして、チャイナ服のocを描いていただきたく思い、リクエスト失礼します。\n\nチャイナ服の全体のイメージは資料の中にあるロングのスリットが入っているもので、胸元、腕周り、色味をもうひとつのチャイナ服のように描いていただきたいです。靴は資料のようなものでお願いいたします。\n\n・全体の色味➡️白\n・胸元➡️谷間が見えるくらいの深さに開いている\n・腕周り➡️シアー素材の布多めのイメージ\n・立ち絵構図➡️特に希望なし\n\n髪型差分で描いていただきたいものも資料に入れていますが、金額不足などありましたら髪型はoc資料のものと同じ、黒髪前髪ぱっつんのストレートロングでお願いしたいです。もし差分で描いていただける際にも、前髪だけはoc資料と同じものでお願いいたします。\n\nまた、資料の中に服装イメージ図を添付しておりますので、そちらを参考にしていただけるとありがたいです。\n\nocの容姿についてなのですが、眉は困り眉(八の字眉でも可)、瞳の色は黒でも明るい紫でもなく、黒に近い暗い紫でお願いいたします。\n\n金額不足や資料不足などありましたら、再送またはキャンセルをしていただけるとありがたいです。ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1wDBgAmedd4-vVhv4YDMeFePpzCzKehEn", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@000000yoko/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a31a6d89/uploads/origins/f3a34606-3f52-453a-9c47-c6f8c5acf95e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfon