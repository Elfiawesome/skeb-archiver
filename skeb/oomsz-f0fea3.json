fe07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4f79e1c02e7d7b080dd7e6d16ff3296", "srcset": "https://si.imgix.net/78d9bfa2/uploads/origins/cc6c8c57-0f0b-4fc8-9eae-56be99dcfe07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4f79e1c02e7d7b080dd7e6d16ff3296, https://si.imgix.net/78d9bfa2/uploads/origins/cc6c8c57-0f0b-4fc8-9eae-56be99dcfe07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ec7c3178141c09e0ecc387da6f3f93a 2x, https://si.imgix.net/78d9bfa2/uploads/origins/cc6c8c57-0f0b-4fc8-9eae-56be99dcfe07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bcd895171d8fd86168f124922b1ab7ef 3x"}, "body": "大箕すず先生、はじめまして。\n\n早速ですが、初音ミクを「ハニーウィップ」のような衣装に描いていただきませんでしょうか。\n衣装の参考資料：https://miku.sega.jp/divastation_archive_image/201211/miku_honey.jpg\nポーズ：よろしければ先生にお任せいたしますが、見本を少し集めました。\n胸や太腿などを少し盛っていただければ嬉しいです。\n\nご検討よろしくお願いいたします！\n\nポーズの見本：\nhttps://x.com/oomsz/status/2034245938739286290\nhttps://x.com/ppp_usagi_/status/1436306853206528004\nhttps://x.com/eno3_3ki8/status/2037326575348416857\n＊こちら以外のポーズでも構いません！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oomsz/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1074703, "client_id": 128118, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee2cc92d/uploads/origins/493ecb6b-10e4-402b-905a-ff39ea00967c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da68f09766be5e0fbfdef783f750bf4f", "srcset": "https://si.imgix.net/ee2cc92d/uploads/origins/493ecb6b-10e4-402b-905a-ff39ea00967c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da68f09766be5e0fbfdef783f750bf4f, https://si.imgix.net/ee2cc92d/uploads/origins/493ecb6b-10e4-402b-905a-ff39ea00967c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5aa0fbc8706aa56afcce8626d9da3f0b 2x, https://si.imgix.net/ee2cc92d/uploads/origins/493ecb6b-10e4-402b-905a-ff39ea00967c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4a54ed0c995c1d760c2eedbc8ec904d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee2cc92d/uploads/origins/493ecb6b-10e4-402b-905a-ff39ea00967c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6544ecdb68c478fb0ff792af7668b63b", "srcset": "https://si.imgix.net/ee2cc92d/uploads/origins/493ecb6b-10e4-402b-905a-ff39ea00967c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6544ecdb68c478fb0ff792af7668b63b, https://si.imgix.net/ee2cc92d/uploads/origins/493ecb6b-10e4-402b-905a-ff39ea00967c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1789419c1c7b3e50b2f6c761b7ef3eff 2x, https://si.imgix.net/ee2cc92d/uploads/origins/493ecb6b-10e4-402b-905a-ff39ea00967c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7114a585a8c85f034c4fed99002e2771 3x"}, "body": "（お仕事でお忙しいタイミングでしたら申し訳ありません）\n\n大箕すず先生、はじめまして。\n\n作品の方、楽しく拝見しております。\n\n『フィルター越しのカノジョ』の三葉さんをはじめ、『おあいこ』の千枝乃さん、『君にくびったけ』の雫さん…等々、先生の描くギャルは大変魅力的で唸らされます…。\n\n人懐こそうな表情、抱きしめたくなる様ないじらしい表情、ぼぅ…と火照って蕩けた表情。\n\n他にも、柔らかさを感じるボディやムニムニした唇、隙のある仕草の描き方にもドキドキします。\n\nそして、上記の色気たっぷりな要素も魅力ですが、作中で彼女らが見せるお陽さまの様な笑顔にはストレートな眩しさが感じられて、そちらの面でもガシッと心を掴まれます。\n\n素敵ですね。\n\n改めまして、以下のリクエストをご検討いただけると幸いです。\n\nお恥ずかしながら、内容は、所謂「オリキャラ」や「うちの子」と呼ばれるものです。\n\nもし気が向いたらで結構ですので、是非、腕を振るって頂けると嬉しいです。\n\nご検討の程、何卒宜しくお願い致します。\n\n\nキャライメージ：陽気なギャルおねーさんの様で、時折大人っぽい顔も覗かせる子。蝙蝠（コウモリ）モチーフの物が好き…なイメージです。\n表情・構図：お任せ致します。\n衣装等：お任せ致します。先生のチョイスで、何かピンときた衣装を着せて頂けると非常に嬉しいです。クール・キュート・セクシー、何れも大歓迎です。\nその他：もしも可能であれば、コウモリ要素（アクセや衣装、小物、その他…どれでも大歓迎です）を、先生のチョイスを邪魔しない範囲で、取り入れて頂けると嬉しいです。\n参考資料：（お目汚し失礼致します）\n（https://twitter.com/pokerface_4715/status/1466395369986658309）\n\n\n※資料内の武器要素は、無視して頂いて問題ありません。\n\n※ある作品の世界観に合わせて考えたキャラ故、便宜上、作中の制服を着せていますが、その他は全てオリジナルです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oomsz/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1074703, "client_id": 965414, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/43b05497/uploads/origins/f96e2432-8ebb-4b87-81c8-89d59fa9817d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79975f13fbc3fc3a4064d8969e9d89c7", "srcset": "https://si.imgix.net/43b05497/uploads/origins/f96e2432-8ebb-4b87-81c8-89d59fa9817d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79975f13fbc3fc3a4064d8969e9d89c7, https://si.imgix.net/43b05497/uploads/origins/f96e2432-8ebb-4b87-81c8-89d59fa9817d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83d33e54a9d0fb373456828243de612a 2x, https://si.imgix.net/43b05497/uploads/origins/f96e2432-8ebb-4b87-81c8-89d59fa9817d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91b616a4bac1c607bd2d2f6f18b9600b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/43b05497/uploads/origins/f96e2432-8ebb-4b87-81c8-89d59fa9817d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1689610d9c1a00dbdb00dd4d25abd47d", "srcset": "https://si.imgix.net/43b05497/uploads/origins/f96e2432-8ebb-4b87-81c8-89d59fa9817d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1689610d9c1a00dbdb00dd4d25abd47d, https://si.imgix.net/43b05497/uploads/origins/f96e2432-8ebb-4b87-81c8-89d59fa9817d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa6ba56c477aa7b22d5626a80e65349d 2x, https://si.imgix.net/43b05497/uploads/origins/f96e2432-8ebb-4b87-81c8-89d59fa9817d?bg=%23fff&auto=format%2Ccompress&fm