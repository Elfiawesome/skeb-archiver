&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60f3d814b9a525bcf3ba87844860cb50", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1564088, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Dz0nNGqnToiUQMh/works/160", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1564088, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e51146ba/uploads/origins/adc12af3-d20d-4ea3-a4a0-9111fc150680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a8f343e0fd84c09349b2eceb3e2d275", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e51146ba/uploads/origins/adc12af3-d20d-4ea3-a4a0-9111fc150680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14e1a03da58e8d60964daaa98cba4a16", "src_set": ""}, "body": "セクシーなフタの狼男が、黒い肌の人間の女戦士を犯して孕ませるところを描けるか？\n\n\n-フタ・オオカミ人間は人間の女性より大きくしてください。\n--人間の女性に小さな膨らみを持たせる。\n-狼男の傷跡を消す。\n-狼男は大きな胸と大きな尻尾を持ち、乳首が見えるようにする。\n\n参考\n狼男：https://freeimage.host/i/dnA9psI\n\nhttps://freeimage.host/i/dnAHH0X\n\nhttps://freeimage.host/i/dnAH9ft\n\nhttps://freeimage.host/i/dnAHJgn", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dz0nNGqnToiUQMh/works/159", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1564088, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a206c07a/uploads/origins/f1262813-b86e-431c-a72c-0207c66ca0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31c1c0b3e90c34739b9c7b68bada6a63", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a206c07a/uploads/origins/f1262813-b86e-431c-a72c-0207c66ca0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cc0a88cfc050808324ab9195b5c705a", "src_set": ""}, "body": "こんにちは！\n\nメトロイドのサムス・アランをHENTAIに描いてくれませんか？\n\nセンターポジションでお願いします。  [視点]\n\n陰毛なし\n\nチンコは人間です。\n\n大きさは子宮に膨らみを残すような巨大なもの。\n\n翻訳がうまくいかなかったときのために、参考文献のリンクを貼っておく。\n\nhttps://drive.google.com/drive/folders/1ney7vP_Ps6sU0ZoCHFD_GrPklK69ZEhB?usp=drive_link\n\n\nまた、サムス・アランはヌードか、タイマニンの衣装の淫らなバージョンを着ることができます。リンク先に彼女のタイマニン衣装バージョン（肌を露出させる場所も）の画像があります。あなたが一番似合うと思うものを選んでください。\n\nこの絵はサムスがアダムと愛し合っているところです（アダムがどう見えるか、肌の色がどう見えるか気になる方は、念のため参考資料にも追加しておきました）。なぜかというと、彼女の中にメトロイドのDNAがあるからで、彼女はそれで発情するんだ。\n\nもしこれを受け入れてくれるなら。今後もこの絵のアルトが増えることを期待しています。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dz0nNGqnToiUQMh/works/158", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c79e258b/uploads/origins/3cee7e3a-7dbf-4268-b564-63d06db2c7e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=150ca17aa423d87c52139f2ab77a63b0", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 1564088, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Dz0nNGqnToiUQMh/works/157", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/623b3de6/uploads/origins/9f90ec52-e559-40cd-aaf0-0e34e5fe01d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=