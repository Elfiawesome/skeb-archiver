": true}, {"path": "/@amairoka/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3739378, "client_id": 2844798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/265fa886/uploads/origins/f3240bcd-ac0d-45e0-8090-07d4ce73f0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=564f74b77de2e5fabbaab3d271657786", "srcset": "https://si.imgix.net/265fa886/uploads/origins/f3240bcd-ac0d-45e0-8090-07d4ce73f0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=564f74b77de2e5fabbaab3d271657786, https://si.imgix.net/265fa886/uploads/origins/f3240bcd-ac0d-45e0-8090-07d4ce73f0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3958360f8376dd013099f4c536dac797 2x, https://si.imgix.net/265fa886/uploads/origins/f3240bcd-ac0d-45e0-8090-07d4ce73f0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5bc52a528d5f56889f5e539ef546374 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/265fa886/uploads/origins/f3240bcd-ac0d-45e0-8090-07d4ce73f0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e82724e2a9c5aeae2290dbf63d0a2c4a", "srcset": "https://si.imgix.net/265fa886/uploads/origins/f3240bcd-ac0d-45e0-8090-07d4ce73f0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e82724e2a9c5aeae2290dbf63d0a2c4a, https://si.imgix.net/265fa886/uploads/origins/f3240bcd-ac0d-45e0-8090-07d4ce73f0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e7acdcb9ee96a0847ba16b1ff9dbefb 2x, https://si.imgix.net/265fa886/uploads/origins/f3240bcd-ac0d-45e0-8090-07d4ce73f0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a610d93c2c2f4bb821a0508fab585b97 3x"}, "body": "初めまして、Vtuberの眠音むにと申します。\n葵澄しき様のふわっと可愛いイラストがとても可愛くてぜひ