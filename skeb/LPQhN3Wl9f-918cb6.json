4321-a80a-4b1e2890fbb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac43ae32981b09c890686a66f9626bf5, https://si.imgix.net/6409ff33/uploads/origins/802db60c-318c-4321-a80a-4b1e2890fbb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=215f01593aa8d851629a3f5245055aef 2x, https://si.imgix.net/6409ff33/uploads/origins/802db60c-318c-4321-a80a-4b1e2890fbb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b37bb425f0eb383bf1f552204eab314b 3x"}, "body": "こんにちは。『プロジェクト・セカイ』の日野森雫（ヒノモリ・シズク）について、お願いがあります！彼女のイラストを2点描いていただきたいのです。\n1枚目は、たくさんご飯を食べ終わった後の彼女です。トレーニングウェア（紫のストラップ付きシャツ、グレーのショートパンツ、黒のレギンス）を着ていて、お腹がパンパンになっています。とても幸せそうな表情で、げっぷをしています。 彼女は、食べ終わった空の丼が置かれたテーブルの横に座っています。\nそして次の絵は、パジャマ姿でベッドにいる雫です。彼女は日野森志歩と一緒にベッドに入っています。二人が眠ろうとしている時、志歩が後ろから彼女を抱きしめています。雫のお腹がゴロゴロと音を立てると、志歩が「お姉ちゃん！」と言います。雫はそれをとても嬉しそうにしています。 視点は上からで、二人のキャラクターが両方見えるようにしてください。また、しずくの大きなお腹も見えるようにしてください。\nもしこのリクエストでよろしければ、大変ありがたいです。本当にありがとうございます！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@LPQhN3Wl9f/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3905856, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb56c9a9/uploads/origins/b5003996-7649-4bbb-8e0b-bc8f11980068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7103601b6038a8608a3019905ac30a76", "srcset": "https://si.imgix.net/eb56c9a9/uploads/origins/b5003996-7649-4bbb-8e0b-bc8f11980068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7103601b6038a8608a3019905ac30a76, https://si.imgix.net/eb56c9a9/uploads/origins/b5003996-7649-4bbb-8e0b-bc8f11980068?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea82970d99b4f0c11f221937a2e213ec 2x, https://si.imgix.net/eb56c9a9/uploads/origins/b5003996-7649-4bbb-8e0b-bc8f11980068?bg=%23fff&auto=for