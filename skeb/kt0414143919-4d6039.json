93c8-473fa8e5ccf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dfa36e011a56e77a3076fdcb3939059f 2x, https://si.imgix.net/775a3768/uploads/origins/901a2eac-cf24-4608-93c8-473fa8e5ccf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4c9e02b49be42868005251c1fd7df32a 3x"}, "body": "ねえ、以前個人アカウントで使ってたTidal Talesだよ。前回すごく素敵な絵を描いてくれたから、今度は私のもっと個人的なキャラを君の画風で描いてほしいんだ。\n\n参考URLにはメインの狐キャラと、こちらのリンクが狼キャラです：https://drive.google.com/file/d/1V3BVDWamUodw4XJLQwmyLaJzjNHe8PwY/view?usp=drivesdk\n\n二人は遠く離れて住む友達なので、それぞれの家でスマホを楽しみながらメッセージをやり取りするスプリットスクリーン構図がすごくクールだと思う。キツネは壁にもたれかかり、オオカミはソファに座っている。キツネは大都市のモダンなアパートに住み、オオカミは水辺の小さな田舎町の木造家屋に住んでいる。二人にとって晴れた明るい日だ。\n\nキツネとオオカミのショートパンツは水泳用ショーツのデザインで、オオカミのジャケットは革製、キツネのシャツのジッパーは胸元までしかありません。https://drive.google.com/file/d/1tNOstFvhCemfD3cQJxqU9_ZsHUGKyFTF/view?usp=drivesdk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kt0414143919/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2745931, "client_id": 3764763, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3fbd1933/uploads/origins/e223d51f-7cc1-479f-8b57-7fe08e5988c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9d98d5aece20c3a14550cc66415216e", "srcset": "https://si.imgix.net/3fbd1933/uploads/origins/e223d51f-7cc1-479f-8b57-7fe08e5988c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9d98d5aece20c3a14550cc66415216e, https://si.imgix.net/3fbd1933/uploads/origins/e223d51f-7cc1-479f-8b57-7fe08e5988c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb66b8b49f06deeecf000ed9c49d3a2e 2x, https://si.imgix.net/3fbd1933/uploads/origins/e223d51f-7cc1-479f-8b57-7fe08e5988c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b7b58d35e78f7d16911543ba50a4195 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3fbd1933/uploads/origins/e223d51f-7cc1-479f-8b57-7fe08e5988c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=934136939b6a1438354e3f1f84a15f2c", "srcset": "https://si.imgix.net/3fbd1933/uploads/origins/e223d51f-7cc1-479f-8b57-7fe08e5988c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=934136939b6a1438354e3f1f84a15f2c, https://si.imgix.net/3fbd1933/uploads/origins/e223d51f-7cc1-479f-8b57-7fe08e5988c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=968b1074003a4f8a17feb3c161b247ec 2x, https://si.imgix.net/3fbd1933/uploads/origins/e223d51f-7cc1-479f-8b57-7fe08e5988c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93de85b77ef144b3444d7355ea954596 3x"}, "body": "やあ、君のアートスタイルを見て気に入ったよ。もしよければ、僕の本のキャラクターを君のアートスタイルで描いてほしいんだ。\n\n彼らは砂漠のオアシスにいて、険しい砂地の下にある。オアシスはヤシの木が生い茂り、水面には草が生い茂っている。真昼間だ。\n\nホワイトタイガーのキャラクターが料理をしているところを描いてほしい。焚き火を焚いて、大きな肉のついた棒を右手で火にかざして調理している。イグアナは焚き火の反対側で彼と向かい合っている。イグアナは恥ずかしがり屋で、不安そうにタイガーに話しかけようとしている。タイガーはイグアナに話しかけるように促すが、短気で怒っているように見える。\n\nハイエナのキャラクターについては、（まだオアシスにいる）遠くのほうに描かせ、火に怯えている様子を隠そうとして、他のキャラクターを見ている。\n\nhttps://drive.google.com/file/d/1tNOstFvhCemfD3cQJxqU9_ZsHUGKyFTF/view?usp=drivesdk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kt0414143919/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2745931, "client_id": 515760, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbc70601/uploads/origins/051d4fd3-1431-48b1-8652-c3b76ef96a09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0928ad5aa175c0902ebac0b42855a41", "srcset": "https://si.imgix.net/cbc70601/uploads/origins/051d4fd3-1431-48b1-8652-c3b76ef96a09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0928ad5aa175c0902ebac0b42855a41, https://si.imgix.net/cbc70601/uploads/origins/051d4fd3-1431-48b1-8652-c3b76ef96a09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b91fa748a9b4e392e7c8575a3a979cc2 2x, https://si.imgix.net/cbc70601/uploads/origins/051d4fd3-1431-48b1-8652-c3b76ef96a09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ac5815155358513db948446b9534084 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbc70601/uploads/origins/051d4fd3-1431-48b1-8652-c3b76ef96a09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=415715984f5d153c1b3683795c764c63", "srcset": "https://si.imgix.net/cbc70601/uploads/origins/051d4fd3-1431-48b1-8652-c3b76ef96a09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=415715984f5d153c1b3683795c764c63, https://si.imgix.net/cbc70601/uploads/origins/051d4fd3-1431-48b1-8652-c3b76ef96a09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ca62d6ad0bfba9de78de4e475780dab 2x, https://si.imgix.net/cbc70601/uploads/origins/051d4fd3-1431-48b1-8652-c3b76ef96a09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea6ed400c3d7fec5c22d354d376b4224 3x"}, "body": "こんにちは、Skebにて初めてイラストのリクエストをさせていただきました。\n\n以前、SNSに投稿されていたベンチに寝転ぶ野球部の虎獣人さんのイラストが格好良くて魅力的でしたので、彼が左打席のバッターボックスに入って、バットを構えた状態で投手からの投球を待ち構えるイラストを描いていただくことはできませんでしょうか。\n\n構図は、A4の縦長サイズで、股下(膝の高さより上の腿) 辺りまでの上半身、表情は、牙が見えていて、比較的真剣な表情の描写を希望しています。\n\n服装について、頭部にヘルメット (これはあくまでアイデアですが、耳の部分のみ、ヘルメット側に穴が空いていて、若干耳が見えている構造だったら面白いかもしれません。) 上着は、紺色で半袖のアンダーシャツ(丸首 フィットタイプ)、下着は、無難な野球の練習着の着用でお願いします。\n彼は分厚い筋肉なので、服がぴっちりしていて、服越しに筋肉のシルエットが分かる力強い肉体のイメージです。\n\nまた、SNSに投稿されていた虎獣人さんのイラストのような、シャツを着脱した状態でのイラスト差分をいただけたら幸いです。\n\nイラストの構図、ポージングは資料URLのリンク先のフリー素材をご参照ください。\n\n納品についてですが、原寸のファイルサイズで受け取りたいため、可能でしたらpsd形式での納品を希望します。\n\nお忙しいところ誠に恐縮ですが、何卒宜しくお願いいたします。\n\nhttps://www.pakutaso.com/20160932257post-9001.html", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kt0414143919/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2745931, "client_id": 1915194, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b16ec993/uploads/origins/118b53a4-ffd4-41fa-bd85-898c790e36d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae384f96fe88846b713a7e358da33493", "srcset": "https://si.imgix.net/b16ec993/uploads/origins/118b53a4-ffd4-41fa-bd85-898c790e36d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae384f96fe88846b713a7e358da33493, https://si.imgix.net/b16ec993/uploads/origins/118b53a4-ffd4-41fa-bd85-898c790e36d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34c73d1b047821a7c6c69c7245a9a3a4 2x, https://si.imgix.net/b16ec993/uploads/origins/118b53a4-ffd4-41fa-bd85-898c790e36d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aaf614111ff8be8cc6d2a3fdff553fea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b16ec993/uploads/origins/118b53a4-ffd4-41fa-bd85-898c790e36d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e81ac1ef24a29bbcab8501bd88a5c33b", "srcset": "https://si.imgix.net/b16ec993/uploads/origins/118b53a4-ffd4-41fa-bd85-898c790e36d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e81ac1ef24a29bbcab8501bd88a5c33b, https://si.imgix.net/b16ec993/uploads/origins/118b53a4-ffd4-41fa-bd85-898c790e36d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d8d3a8e1e35e9f0c1faa794ddafa5328 2x, https://si.imgix.net/b16ec993/uploads/origins/118b53a4-ffd4-41fa-bd85-898c790e36d0?bg=%23fff&auto=format%2