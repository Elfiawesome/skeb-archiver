top&w=200&h=200&s=4905a6ffd96cc9bf8ea2fc36c87f30e6 2x, https://si.imgix.net/4db4b81b/uploads/origins/8460d148-537b-4d0b-bf9e-e2563c32998e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=981129242389b18c2e56144c1ccbb7a0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4db4b81b/uploads/origins/8460d148-537b-4d0b-bf9e-e2563c32998e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce8ee2e5b20203b3de1f228a6105a23d", "srcset": "https://si.imgix.net/4db4b81b/uploads/origins/8460d148-537b-4d0b-bf9e-e2563c32998e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce8ee2e5b20203b3de1f228a6105a23d, https://si.imgix.net/4db4b81b/uploads/origins/8460d148-537b-4d0b-bf9e-e2563c32998e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=920f3169e53e948f7c01caeedf37dde1 2x, https://si.imgix.net/4db4b81b/uploads/origins/8460d148-537b-4d0b-bf9e-e2563c32998e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45d857484afa033f1ba7e9de0f6b068d 3x"}, "body": "はじめまして。ブラック・テラーもブラッディ・シュガーは夜わらうも大好きです。\n私はVライバーをしているのですが、そのV体の一枚絵を描いていただきたいです。\nアイコンは少し目が見えていますが、本当は目は全く見えないように、前髪で隠れています。\nポーズやイラストのサイズはお任せします。背景は、出来れば、夕暮れ時の公園だと嬉しいです。\nよろしくお願いいたします。\n\n以下、資料です。\nhttps://www.foriio.com/sunae\n\nhttps://www.foriio.com/sunae", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mido_mads/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2720616, "client_id": 847445, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18bc7d88/uploads/origins/7ec232ea-5ea7-4eb7-ab44-25bade021fda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5c0981108c9767293af6ad8f705b641", "srcset": "https://si.imgix.net/18bc7d88/uploads/origins/7ec232ea-5ea7-4eb7-ab44-25bade021fda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5c0981108c9767293af6ad8f705b641, https://si.imgix.net/18bc7d88/uploads/origins/7ec232ea-5ea7-4eb7-ab44-25bade021fda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95e4913feb52c8bbe288217eec55402f 2x, https://si.imgix.net/18bc7d88/uploads/origins/7ec232ea-5ea7-4eb7-ab44-25bade021fda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ee28a0dad2242c196f29835151a84bd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/18bc7d88/uploads/origins/7ec232ea-5ea7-4eb7-ab44-25bade021fda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47bf59bf8cea21172ef63aed037d0f74", "srcset": "https://si.imgix.net/18bc7d88/uploads/origins/7ec232ea-5ea7-4eb7-ab44-25bade021fda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47bf59bf8cea21172ef63aed037d0f74, https://si.imgix.net/18bc7d88/uploads/origins/7ec232ea-5ea7-4eb7-ab44-25bade021fda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3cd8e91b16185c142d2d5dc8e9bd774d 2x, https://si.imgix.net/18bc7d88/uploads/origins/7ec232ea-5ea7-4eb7-ab44-25bade021fda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8bc55b79d55732e621268670772e3b7 3x"}, "body": "初めまして。三堂先生の作品のファンです。\nブラッディ・シュガーは夜わらうや、twitterに投稿されているイラストなど拝見させていただいております。\n\n私と友人のオリジナルキャラクター2人をリクエストさせてください。\n以下、設定や希望する場面についてになります。\n三堂先生の作る世界観が本当にとても大好きなので、感じた通りに創作していただけたらとても嬉しいです。\n可能な限りで構いませんのでお願いできないでしょうか。\n\n■キャラクター参考資料\nhttps://drive.google.com/drive/folders/1QGFjd8obuhWLPHa5VGWwHIJIxVCewAUm?usp=share_link\n\n■キャラクター共通の設定\n世界の復興を行う組織である『機関』に所属するバディ。しかし世界の為ではなく、あくまで自身の安全とそれぞれの目的のため。\n現在は潜入調査のために2人でカフェを経営する。\n\n■キャラクター１：ルナール\n名前はフランス語で「狐」の意。\n『機関』に所属する目的はコレクションの安全。\nカフェではバリスタとして働いている。主にカウンター担当。\n\n常に丁寧口調で顔には笑みを浮かべている。\nアンティークの収集が趣味。\n\n■キャラクター２：ブレロー\n名前はフランス語で「狸」の意。\n『機関』に所属する目的は任務をゲームとして楽しむこと。\nカフェでは接客を好まないため、カウンターを担当したいがルナールがカウンターを占領しているのでホールを担当している。\n\n荒い口調で、相手を煽ったり地雷を踏む。\n接客では、気のいいオニイサンを演じる。\nバイクが趣味。\n\n■連想する言葉\n・カフェ\n・コーヒー\n・アンティーク\n・不穏、悪だくみ\n\n■絵柄（可能であれば）\n・黒の鉛筆ぽいタッチの線や塗り\n・少ない色数のベタ塗り\n・添付させていただくイラストのテイストをイメージしております\nhttps://twitter.com/mido_mads/status/1503330020919447552?s=20\nhttps://twitter.com/mido_mads/status/1391002655778951171?s=20\nhttps://twitter.com/mido_mads/status/1505151076760051716?s=20", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mido_mads/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2720616, "client_id": 2738719, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d142b52/uploads/origins/922b5f9c-0a38-4126-8ce2-c23ca7d2f082?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07ba84d58d5539e74d27afb4699a76ea", "srcset": "https://si.imgix.net/6d142b52/uploads/origins/922b5f9c-0a38-4126-8ce2-c23ca7d2f082?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07ba84d58d5539e74d27afb4699a76ea, https://si.imgix.net/6d142b52/uploads/origins/922b5f9c-0a38-4126-8ce2-c23ca7d2f082?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a06198281fe7386dce597d0af86bc933 2x, https://si.imgix.net/6d142b52/uploads/origins/922b5f9c-0a38-4126-8ce2-c23ca7d2f082?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=968133517a9a8148a0e2563feed0afb2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d142b52/uploads/origins/922b5f9c-0a38-4126-8ce2-c23ca7d2f082?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c1e8c30c3e364be88ddd83642e0a34e", "srcset": "https://si.imgix.net/6d142b52/uploads/origins/922b5f9c-0a38-4126-8ce2-c23ca7d2f082?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c1e8c30c3e364be88ddd83642e0a34e, https://si.imgix.net/6d142b52/uploads/origins/922b5f9c-0a38-4126-8ce2-c23ca7d2f082?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a59ba2232af4a687bd3296b7e8dd33b8 2x, https://si.imgix.net/6d142b52/uploads/origins/922b5f9c-0a38-4126-8ce2-c23ca7d2f082?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2c09b1cefe493d0215f3cc189ce1f5a2 3x"}, "body": "三堂マツリ様\n\nこんにちは。\n絵柄と世界観が大好きで、イラストや漫画拝見させていただいております！\n自創作のキャラのリクエストを送らせていただきます。\n\n先生と生徒になります。\n詳しい設定はURL先に載せております。\nhttps://drive.google.com/drive/folders/1MTGs0Hkr9qxrqfkTWt2CFM4RffgBqJtL?usp=sharing\n\n（キャラ参考になりそうな漫画も貼らせていただきます）\nhttps://twitter.com/N0N0_MZ/status/1652687147374362627\n\n構図は、先生がメインで、生徒クンは背景側に配置されているイメージ(小さくても大丈夫です)でお願いしたいです。\n先生は何か絵を描いていると嬉しいです！（画材は鉛筆、水彩絵具 問いません）表情は笑っていてほしいです。\n生徒クンのポーズはお任せいたします。\n\nキャンバスサイズは、縦長の比率ですと嬉しいですが、お任せいたします。\n\nイラストは、Twitterに掲載させていただきたいと考えております。\n読んでいただきありがとうございました。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mido_mads/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2720616, "client_id": 2211, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6351303f/uploads/origins/3126e0d6-2390-4981-9dd0-ea853f6ccce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e379c9b9bf6281521f7c27b2a555b2be", "srcset": "https://si.imgix.net/6351303f/uploads/origins/3126e0d6-2390-4981-9dd0-ea853f6ccce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e379c9b9bf6281521f7c27b2a555b2be, https://si.imgix.net/6351303f/uploads/origins/3126e0d6-2390-4981-9dd0-ea853f6ccce8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dbdffbf7619b585cff875d78696acd49 2x, https://si.imgix.net/6351303f/uploads/origins/3126e0d6-2390-4981-9dd0-ea853f6ccce8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=caadc695994ef0527fd02e4e0045d201 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6351303f/uploads/origins/3126e0d6-2390-4981-9dd0-ea853f6ccce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad0059e2197b0745ff51c5bccaba0f11", "srcset": "https://si.imgix.net/6351303f/uploads/origins/3126e0d6-2390-4981-9dd0-ea853f6ccce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad0059e2197b0745ff51c5bccaba0f11, https://si.imgix.net/6351303f/uploads/origins/3126e0d6-2390-4981-9dd0-ea853f6ccce8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f750b7eb58ff2b5f3c9ee7f35fc71c48 2x, https://si.imgix.net/6351303f/uploads/origins/3126e0d6-2390-4981-9dd0-ea853f6ccce8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=50bbf55521b5383b2aec585577868060 3x"}, "body": "いつも素敵な漫画、イラスト拝見させて頂いております。\n三堂マツリ先生の描く漫画やイラストの世界観や空気感が大好きで、\nぜひご依頼できればと思いご連絡させて頂きました。\n\n今回、私がTRPGで使用しているキャラクターのイラストをご依頼することは可能でしょうか。\n手をサラダトングに改造された、記憶喪失の改造人間の異能力者です。手元のトングを枝葉のように増やしたり伸ばして戦います。\nぼうっとしており世間知らず、外見は大人でも中身は無垢で作られたてのようなイメージです。\n\n個人観賞用のため、ポーズ、構図、表現等全てお任せいたします。\n先生の空気感や色使いがとても好きなので、諸々ご自由に表現いただけると嬉しいです。\n\nキャラクターシート、資料↓ \n\n① https://yutorize.2-d.jp/ytsheet/dx3rd/?id=InDtFl\n② https://twitter.com/saba_tet1126/status/1576924783371251722?s=46&t=WeIIx6Hc76NXOnuXBJ0oYA\n③ https://twitter.com/saba_tet1126/status/1606690774980390912?s=46&t=WeIIx6Hc76NXOnuXBJ0oYA\n\nご多忙かと存じますが、ご縁がありましたら何卒よろしくお願いいたします。\nこれからも応援しております！\n\nhttps://twitter.com/saba_tet1126/status/1576924783371251722?s=46&t=WeIIx6Hc76NXOnuXBJ0oYA", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mido_mads/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "