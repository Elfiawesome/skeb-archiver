口元に黒子があります。身長は約175。\nワンピースの少女：17歳。明るくて単純で、着物の青年に片思い中。身長は約160。\n黒い学生服の青年：大学生（20代前半）。実は半分人間ではないので、真黒の見た目です。身長は約80。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mido_mads/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2720616, "client_id": 2721695, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7abf682/uploads/origins/28a6458a-3691-43a9-b21f-b60e4c390f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25f5d8b81daa91fa35f929e27cf02942", "srcset": "https://si.imgix.net/c7abf682/uploads/origins/28a6458a-3691-43a9-b21f-b60e4c390f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25f5d8b81daa91fa35f929e27cf02942, https://si.imgix.net/c7abf682/uploads/origins/28a6458a-3691-43a9-b21f-b60e4c390f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3467f154cba436f4228774f78a71991d 2x, https://si.imgix.net/c7abf682/uploads/origins/28a6458a-3691-43a9-b21f-b60e4c390f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2067c1052ae642198a851f062a04be85 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c7abf682/uploads/origins/28a6458a-3691-43a9-b21f-b60e4c390f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=134cab02dc4ae1d83535e0ed6c375bdb", "srcset": "https://si.imgix.net/c7abf682/uploads/origins/28a6458a-3691-43a9-b21f-b60e4c390f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=134cab02dc4ae1d83535e0ed6c375bdb, https://si.imgix.net/c7abf682/uploads/origins/28a6458a-3691-43a9-b21f-b60e4c390f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=79e6bf99409382b35817e0042d5881b3 2x, https://si.imgix.net/c7abf682/uploads/origins/28a6458a-3691-43a9-b21f-b60