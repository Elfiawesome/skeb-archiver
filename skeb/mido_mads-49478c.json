見てみたいキャラクターとしてとても悩みましたが、呱待というキャラクターをお願いできたらと思います！\n37歳（童顔ですが）の精神科医で、学力（知識欲）がとても高いのが特徴です。設定は資料URLの通りですが、自分のクローンを使って亡くなった双子の弟を創り出すなど、倫理観に欠けるキャラクターです。その狂気と愛と優しさが三堂先生の世界観に合うのではないかと思いリクエストしました……！\n\nよろしければお願いいたします。\nこれからも三堂先生のご活躍をお祈りするとともに、三堂先生の生み出される作品どれもとても楽しみにしています。\n\nhttps://famidoricenter.tumblr.com/post/667745993439199232", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mido_mads/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2720616, "client_id": 367131, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0aec520f/uploads/origins/b144a5fa-c9f8-4df0-8e59-037fed4f5524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9776c1fcbf37e773f1defe0d6eb32c4", "srcset": "https://si.imgix.net/0aec520f/uploads/origins/b144a5fa-c9f8-4df0-8e59-037fed4f5524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9776c1fcbf37e773f1defe0d6eb32c4, https://si.imgix.net/0aec520f/uploads/origins/b144a5fa-c9f8-4df0-8e59-037fed4f5524?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea7197ab48475deb3a335531a39525cb 2x, https://si.imgix.net/0aec520f/uploads/origins/b144a5fa-c9f8-4df0-8e59-037fed4f5524?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f63760b34c45da9d58562c179a06f030 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0aec520f/uploads/origins/b144a5fa-c9f8-4df0-8e59-037fed4f5524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ddfe5e033a8f2a882231764faf290306", "srcset": "https://si.imgix.net/0aec520f/uploads/origins/b144a5fa-c9f8-4df0-8e59-037fed4f5524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ddfe5e033a8f2a882231764faf290306, https://si.imgix.net/0aec520f/uploads/origins/b144a5fa-c9f8-4df0-8e59-0