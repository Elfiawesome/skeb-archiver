ive.google.com/drive/folders/19_zo9HFwtI_E9Ew6ID3ziu95biPTWZ9d?usp=sharing\n\nもしもご縁がありましたら、どうぞよろしくお願いします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 692229, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "神野える", "screen_name": "kamino_eru", "avatar_url": "https://pbs.twimg.com/profile_images/1939567566252376064/dbctJB5v.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1225695770986156035/1773477272/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 70, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 1047989, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "TRPGﾂｫｰﾂｹ", "screen_name": "trpg_sousuke", "avatar_url": "https://pbs.twimg.com/profile_images/1733045330005147648/uQh5G2NO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1298186370398056448/1763541245/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 2116729, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "塩ながす", "screen_name": "siosionagasu_", "avatar_url": "https://pbs.twimg.com/profile_images/1986471292389015552/eaymibbx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1167735309796118529/1768759769/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "ban