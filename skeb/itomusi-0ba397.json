な、縦21m、横21m、高さ19.5mの展示室です。\nhttps://www.aomori-museum.jp/visit/?target=floor\n\nホールの高さや広さが感じられるとよいです。壁の展示物は不要です。リンク先の画像を参照ください。\n\n女の子は後ろ姿でお願いします。顔は描かないでください。\n女の子の人種、身長、髪型や服装などは自由です、もし必要であれば青いワンピースを着せてください。ご検討ください。\n\nhttps://www.aomori-museum.jp/visit/?target=floor", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@itomusi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2529110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/242a4bb0/uploads/origins/bf24dbf9-922f-40f1-91f8-f847e7d472a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb8c15e37c9a1874a6bd168ed6acd7c7", "srcset": "https://si.imgix.net/242a4bb0/uploads/origins/bf24dbf9-922f-40f1-91f8-f847e7d472a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb8c15e37c9a1874a6bd168ed6acd7c7, https://si.imgix.net/242a4bb0/uploads/origins/bf24dbf9-922f-40f1-91f8-f847e7d472a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0883b05d5da0c4246e4566c9b2012a76 2x, https://si.imgix.net/242a4bb0/uploads/origins/bf24dbf9-922f-40f1-91f8-f847e7d472a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ccad95ce43ad73d56b91f368f872f6b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/242a4bb0/uploads/origins/bf24dbf9-922f-40f1-91f8-f847e7d472a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad468bfbb1dac76e030c03cc8fcc7351", "srcset": "https://si.imgix.net/242a4bb0/uploads/origins/bf24dbf9-922f-40f1-91f8-f847e7d472a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad468bfbb1dac76e030c03cc8fcc7351, https://si.imgix.net/242a4bb0/uploads/origins/bf24dbf9-922f-40f1-91f8-f847e7d472a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200