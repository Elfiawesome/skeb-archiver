1adc75/uploads/origins/f886f90a-0808-4c10-aab4-59015f30ea83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa9477a5878183c9e762eb40d69063e8", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 4750, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@circussion/works/286", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4750, "client_id": 1027591, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c93910d6/uploads/origins/1bdf87ab-0ee9-40b5-91cb-07e163a4a9e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd1a58d8d3f7c6066b4f6c09c0a4536b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c93910d6/uploads/origins/1bdf87ab-0ee9-40b5-91cb-07e163a4a9e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1bcd8fd509e33847efb5b830b8cdf0f8", "src_set": ""}, "body": "いつもお世話になっております\n先日は納品ありがとうございました\n再度依頼させていただきます\n\n\n■キャラ\n前回同様、こちらのキャラ、衣装でお願いします。\nhttps://twitter.com/moryotton/status/1708826184891674656\n\n\n〇参考/過去skebで依頼してきたもの（設定など含む）\nhttps://skeb.jp/@Lunalia1751/works/29\nhttps://skeb.jp/@hdkhkr/works/44\nhttps://skeb.jp/@shinshin_ki/works/87\nhttps://skeb.jp/@oekakiyari/works/37\nhttps://skeb.jp/@oekakiyari/works/42\nhttps://skeb.jp/@nana_kisaragi/works/161\nhttps://skeb.jp/@haranonegaDoor/works/91\nhttps://skeb.jp/@ligmki8/works/51\nhttps://skeb.jp/@yamaP_mako/works/220\nhttps://skeb.jp/@godoh_rx/works/34\n\n\n■シチュ、ポーズなど\n・前傾寄りなスパイダー騎乗位(女性優位シチュな雰囲気)\n\n・着衣状態は以下だとよいです\n胴体部分のみ脱衣、裸状態\nヴェールや装飾、腕／足回りの衣装は着衣状態\n\n・今回も表情差分お願いします（以下）\n①舌なめずり、やや薄目でSな感じの表情\n②ちょっと小馬鹿にしてくる感じの表情\n③（すぐに射精してしまって）「えっ？」と驚き表情\n\nその他記載のない部分はお任せいたします\nどうぞよろしくお願いいたします", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@circussion/works/285", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4750, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b071268/uploads/origins/6e75cbd6-9416-480b-9f0c-ae8b13c3e07f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7523f4fa63d66756da40d2750dbceb1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b071268/uploads/origins/6e75cbd6-9416-480b-9f0c-ae8b13c3e07f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60e4eaad72215216e355ad8c64d7a2cb", "src_set": ""}, "body": "circussionさん、お世話になります。\n\n早速となりますがリクエストさせていただきます。\n\nゲーム「駅メモ」\n(2次創作ガイドラインは\nhttps://ekimemo.com/guideline\nとなっております）\n\nのグラフィリア(下記URLを参照ください)\nhttps://imgur.com/a/9toZrWo\nのskebをリクエストをお願いします。\n\n•シチュエーション\n騎乗位で竿役から搾り取り(逆レイプ)\n可能であれば中出し差分もいただきたいです。\n(射精は断面図での表現希望です)\n\n•服装、装飾など\nコートや上着、スカートなどの大きな布は脱がせてください。\n手袋や、耳飾り、ソックス、アームカバーなどはそのままでお願いします。\n\n•特記事項\ncircussionさんの乳表現が非常に好みなので、現状でも爆乳キャラですが、さらに盛っていただいても構いません。\n可能であれば騎乗位で竿役に乗っかる際、前屈みなど、乳を強調する体勢をしていただけると嬉しいです。\n\n以上、ご検討頂けると幸いです。\nよろしくお願いいたします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@circussion/works/284", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ba819724/uploads/origins/751cab63-e25a-4c8a-aa4d-b969e9cf6dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e7b635d76c63cdb0d4d8e0365791a2ca", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 4750, "client_id": 2768162, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@circussion/works/283", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4750, "client_id": 1027591, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ddc3088/uploads/origins/cd6e7c74-90ae-4485-810d-16fd398c4d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e8ff3c582fa08a36ef4bcdf0f4e4e53", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ddc3088/uploads/origins/cd6e7c74-90ae-4485-810d-16fd398c4d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36186fe0328befe6b9d66d76f4ab733a", "src_set": ""}, "body": "いつもお世話になっております\nまた依頼させていただきありがとうございます\n\n\n■キャラ\n前回納品いただいたキャラ、衣装で別構図でお願いします\nhttps://skeb.jp/@circussion/works/274\n\n\n〇参考/過去skebで依頼してきたもの（設定など含む）\nhttps://skeb.jp/@Lunalia1751/works/29\nhttps://skeb.jp/@hdkhkr/works/44\nhttps://skeb.jp/@shinshin_ki/works/87\nhttps://skeb.jp/@oekakiyari/works/37\nhttps://skeb.jp/@oekakiyari/works/42\nhttps://skeb.jp/@nana_kisaragi/works/161\nhttps://skeb.jp/@haranonegaDoor/works/91\nhttps://skeb.jp/@ligmki8/works/51\nhttps://skeb.jp/@yamaP_mako/works/220\nhttps://skeb.jp/@godoh_rx/works/34\n\n〇参考/セリフイメージ\nhttps://skeb.jp/@nana_kisaragi/works/181\nhttps://skeb.jp/@kujiran/works/136\n\n\n■シチュ、ポーズなど\n・パイズリ(女性優位シチュな雰囲気)\n以下で投稿されていた構図/ポーズのどちらかでお願いします\nhttps://x.com/circussion/status/1939267780366516537\nhttps://x.com/circussion/status/1935283226031046853\n\n・衣服は半着衣くらい、頭のヴェールや装飾などはありでお願いします\n胸回りの衣装はずらして、乳輪や乳首は見える着衣感だと嬉しいです\n\n・以下表情差分お願いします（今回液体差分なしですが、その分表情に寄せてます）\n①嘲笑的な感じの笑顔 (前回のようにちょっと馬鹿にしてくる感じの表情)\n②舌なめずり、やや薄目でSな感じの表情\n③ジト目、「ふーん、もう射精するの？早漏ね・・・」といった感じ\n\n\nその他記載のない部分はお任せいたします\nどうぞよろしくお願いいたします", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@circussion/works/282", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4750, "client_id": 167468, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e74e140/uploads/origins/485a26dd-f48e-47cd-b137-aa7d16a38cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b1a05ff891dbbe240ad15d7a163266e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e74e140/uploads/origins/485a26dd-f48e-47cd-b137-aa7d16a38cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63c3e4f53b8eca35f9da6fec8478cb42", "src_set": ""}, "body": "前回再送リクエストをしていただいたリクエストですが、規約違反でキャンセルされてしまったので、改めてリエクストさせていただきます。以下再送元とほぼ同文です。\n\nはじめまして。いつも作品楽しみにさせていただいています。\n\n今回は、Vtuberのロザリン・ロックと、同じくVtuberの彩湖めとりによるWパイズリをお願いします！\nhttps://x.com/RoosanVega/status/1736683346246381807\nhttps://x.com/metori_vtuber/status/1755476321562759243\n既に上記内容での依頼をする旨をモデル元の方には連絡し、許可をいただいております。\n\nシチュエーションとしては、「ノリノリで、徹底的に搾り取るつもりでWパイズリする」お二人でお願いします。\n細かな指定は以下に\n・ロザリン側はリンク先２枚目の三面図のある衣装から、胸元だけ脱衣で他は着衣\n・めとり側は制服の上着を大きくはだけさせてください（難しければ裸で大丈夫です）\n・二人共すごく楽しそうに。\n・胸は立ち絵準拠で大きめに\n・二人の間から亀頭が見えている（可能なら、もっと胸をギュっと寄せて、全部埋まってる様な差分もお願いします）\n・主観視点\n・これも可能なら射精差分をお願いします。\n\nよろしくおねがいします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@circussion/works/281", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4750, "client_id": 342276, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17bd1328/uploads/origins/0c98cb4c-766a-494e-a197-e7a7a71836a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca2ee4919bcb10d7d2f7113cb9a85c0b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore":