ix.net/0dd71c08/uploads/origins/3636f1fd-c911-4f80-82bd-4a74cd53ab21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec47232cad5de86f303a296fa0eb12d1, https://si.imgix.net/0dd71c08/uploads/origins/3636f1fd-c911-4f80-82bd-4a74cd53ab21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46f6890dcad4f3a1cc7ee91bfd0b7e76 2x, https://si.imgix.net/0dd71c08/uploads/origins/3636f1fd-c911-4f80-82bd-4a74cd53ab21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c19657cddd1b9e247f66e4b45cb4338a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0dd71c08/uploads/origins/3636f1fd-c911-4f80-82bd-4a74cd53ab21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc289942f4ea5eae35da7344c19a9a08", "srcset": "https://si.imgix.net/0dd71c08/uploads/origins/3636f1fd-c911-4f80-82bd-4a74cd53ab21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc289942f4ea5eae35da7344c19a9a08, https://si.imgix.net/0dd71c08/uploads/origins/3636f1fd-c911-4f80-82bd-4a74cd53ab21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=74138a98649bf1cfffdb102934f70c3f 2x, https://si.imgix.net/0dd71c08/uploads/origins/3636f1fd-c911-4f80-82bd-4a74cd53ab21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=608f7d4185b55ef3927b827d30e03656 3x"}, "body": "にふる様\n\n初めまして、ぽむぷりと申します。\nにふる様の絵柄に一目惚れをし、CoCにて単発シナリオ継続で回っている元ヤン幼馴染の二人（バディ）をお願いしたくメッセージをお送りさせていただきました。\n以下が内容になります。\n\n\n▽依頼内容 \nポーズですが、可能であれば夜にビルの上から慌てつつ①が②を抱き締めながら落ちる二人を描いて頂けると嬉しいです。（勿論、厳しい様であればこちらは無視していただき、おまかせでお願いしたく存じます）\n金額が不足してる様であればお手数ですがお伝えいただければと思います。相方からは許可頂いてます。\n\n▽使用用途 \n個人鑑賞・相方への共有 ・（許可して頂ける様であれば）配信無しの個人でのココフォリアのセッションでの使用\n※セッションで使用する場合はココフォリアのテキストにてクレジット記載予定です\n\n▽キャラ設定 \n①橘 龍牙：金髪・黒のツーブロック/吊り目気味。バイクジャケットを着ている。週三で1時間ミッチリと筋トレをしている為、ガッシリとした体型。\n24歳/190cm 元ヤン \n過去に60人程束ねていた暴走族の総長。頭はからっきしだが腕っぷしには覚えあり。カリスマ性があり、チームを引っ張ってきた。\n現在は元ヤン経歴を生かしてバイク便の職業に就いている。烈の事は無条件で信頼してる為よく騙されたりする。甘い物が好き。禁煙したいが烈のせいで禁煙出来ない。\n\n②桜井 烈：赤髪・黒のメッシュ/黄色と赤のオッドアイ/サングラス。左目は小さい頃に飼い猫のケイジに盛大に引っ掛れ大きな傷となっている。髪は一つに束ねている。\n24歳/182cm 元ヤン \n総長である橘 龍牙の幼馴染で、同じチームの副総長。龍牙が力担当、烈が頭担当であり交渉等も行っていた。龍牙の隣に必ず居てチームを支えてきた実質、陰の総長である。 走るのが好きで、休日は一人でドライブに行く事も。ヘビースモーカー。何だかんだ龍牙に甘い。  \n\n▽二人の関係性  生まれた時からの幼馴染。 ずっと一緒に居るのが当たり前の様な感覚で、お互いを大事に思っており、二人とも実家から離れて一人暮らしをしているが家が近い為ちょくちょく遊びに行ってたりする。 暴走族時代でも常に味方で居てくれた為二人とも母親をとても大事にしている。\n\n▽参考資料 https://drive.google.com/drive/folders/1NJOR3Wt1bMho5lLs-v9l_ZdbFTCfhp2T?usp=drive_link \n\n以上になります。\n長々と書きましたが、内容が厳しい様であれば却下して頂いても構いませんので、どうぞよろしくお願いします。長々と失礼しました。\n\nhttps://drive.google.com/drive/folders/1NJOR3Wt1bMho5lLs-v9l_ZdbFTCfhp2T?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amayoniful_cm/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3900091, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2642e31/uploads/origins/61791aa5-553c-4dde-a729-d5d371d0c0a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=705c383bcce2953c48cb786f6422c925", "srcset": "https://si.imgix.net/b2642e31/uploads/origins/61791aa5-553c-4dde-a729-d5d371d0c0a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=705c383bcce2953c48cb786f6422c925, https://si.imgix.net/b2642e31/uploads/origins/61791aa5-553c-4dde-a729-d5d371d0c0a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d37fdc546d110aef557d8a63a2031cb7 2x, https://si.imgix.net/b2642e31/uploads/origins/61791aa5-553c-4dde-a729-d5d371d0c0a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5147ea779790413f3ebc9c46eb7dd8f5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2642e31/uploads/origins/61791aa5-553c-4dde-a729-