貌をしている。 実のところ、彼は読書が好きではない。白い頭巾、首には茶色のフード付きスカーフを巻き、茶色のパイピングが施された白いシャツを着ている。腹部には包帯が巻かれている。茶色のサムライパンツと黒い革靴を履いている。\nポーズ、背景、表情は自由\n参考画像：\nhttps://drive.google.com/drive/folders/1Diqpyd-MqNmRzK0CSU3Qlv6Oq_e0BEpk\n\nhttps://skeb.jp/@Ojjh03964496", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nana85771277/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2544893, "client_id": 2188555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ea410ce/uploads/origins/ffc09291-1a6a-471d-b091-0e31b40e7eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d43a8b0244c51f00501123cf7d949a0", "srcset": "https://si.imgix.net/8ea410ce/uploads/origins/ffc09291-1a6a-471d-b091-0e31b40e7eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d43a8b0244c51f00501123cf7d949a0, https://si.imgix.net/8ea410ce/uploads/origins/ffc09291-1a6a-471d-b091-0e31b40e7eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=808bd44e3101f08110535716b46bcdc5 2x, https://si.imgix.net/8ea410ce/uploads/origins/ffc09291-1a6a-471d-b091-0e31b40e7eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc2551251f8584149075e885f9bfd02f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ea410ce/uploads/origins/ffc09291-1a6a-471d-b091-0e31b40e7eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4193b5d3a31a3d6696bb61c3835ac4f5", "srcset": "https://si.imgix.net/8ea410ce/uploads/origins/ffc09291-1a6a-471d-b091-0e31b40e7eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4193b5d3a31a3d6696bb61c3835ac4f5, https://si.imgix.net/8ea410ce/uploads/origins/ffc09291-1a6a-471d-b091-0e31b40e7eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&