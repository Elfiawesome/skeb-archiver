200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b125661b5c489246bb55ceafb0ffe3f3", "srcset": "https://si.imgix.net/ed6ef13d/uploads/origins/2ecce60d-01e9-41d3-83f9-7517ac76b1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b125661b5c489246bb55ceafb0ffe3f3, https://si.imgix.net/ed6ef13d/uploads/origins/2ecce60d-01e9-41d3-83f9-7517ac76b1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d477a501e4d8a1d6f7cd8ef85ddbeb70 2x, https://si.imgix.net/ed6ef13d/uploads/origins/2ecce60d-01e9-41d3-83f9-7517ac76b1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7abf75754ec364af4179518d264819e8 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3303661, "client_id": 1053651, "nc": 33}, {"path": "/@ankatomoshibi/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3303661, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e57e00d/uploads/origins/04feefff-31b8-4948-9c07-a5f3cc126349?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e9ca41f86d390603c01dcdaa18c033e", "srcset": "https://si.imgix.net/1e57e00d/uploads/origins/04feefff-31b8-4948-9c07-a5f3cc126349?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e9ca41f86d390603c01dcdaa18c033e, https://si.imgix.net/1e57e00d/uploads/origins/04feefff-31b8-4948-9c07-a5f3cc126349?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60b170987a3a4e9e413ff9ce7a6bf4cb 2x, https://si.imgix.net/1e57e00d/uploads/origins/04feefff-31b8-4948-9c07-a5f3cc126349?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=986c2f7b02a75077590e10597bfd35f0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e57e00d/uploads/origins/04feefff-31b8-4948-9c07-a5f3cc126349?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2565d7309f1464279e868ad283f749b", "srcset": "https://si.imgix.net/1e57e00d/uploads/origins/04feefff-31b8-4948-9c07-a5f3cc126349?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2565d7309f1464279e868ad283f749b, https://si.imgix.net/1e57e00d/uploads/origins/04feefff-31b8-4948-9c07-a5f3cc126349?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=db44cf9be382dc8156e453fa4d0b2c66 2x, https://si.imgix.net/1e57e00d/uploads/origins/04feefff-31b8-4948-9c07-a5f3cc126349?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=52bc6984fced49eaa06a47a9df7ec420 3x"}, "body": "こんにちはあんかともしび先生\n\nリクエストを検討してください！\n\n作品：もんはんのえろほん\n\nキャラ：キリンとヒーラーU\n\nシナリオ：キリンとヒーラーは、愛するキリンやヒーラーの装備が着られない新しい狩猟場への引っ越しを嫌がり、ポッケ村に留まっています。村は限界集落と化し、二人とも退屈しきってしまいます。\n\nある日、二人がヒーラーのベッドでだらだらと横たわっていると、ヒーラーが突然キリンにクンニしてもいいかと尋ねます。キリンは驚いて、すぐに「いやいや、ノンケって言ったでしょ」と答えます。そしてヒーラーはキリンを誘惑し、「そう言うけど、前にクンニした時は気持ちそうだったよね」「他にすることないでしょ」「もう何ヶ月も彼氏いないんだから、溜まってない？」「男と女で何が違うの？どっちにしても、口でするのがどれだけ気持ちいいか知ってるでしょ…」などと語ります。キリンは気が進まないようですが、身体は興奮してしまう。\n\nヒーラーはキリンにクンニを強烈に与え、キリンは仰け反り、シーツを掴みながら激しく絶頂に達します。「即落ち」のように即尺のジャンプカットを入れてください。ヒーラーとキリンは熱く汗だくのセックスを続け、キリンは快感に屈し、次第に抵抗がなくなっていきます。以下の体位から好きなものを描いてください。\n・ヒーラーがキリンの顔を掴んでディープキスをし、自分のマン汁を味わわせる\n・ヒーラーがキリンの胸を吸いながらと手マンしながら\n・ヒーラーがキリンの顔の上に乗り、キリンにクンニを強要する\n・ヒーラーが上に乗ってキリンと69をする\n・その他あなたが描きたい体位があれば何でも構いません！\n\n最後の絶頂では、ヒーラーとキリンが同時に貝合わせとディープキスをします。しっかりと抱き合い、クロスキスをし、同時に絶頂を迎える様子を描いてください。\n\n翌朝、キリンは恥ずかしくてヒーラーの目を見ることができません。ヒーラーはキリンに「気持ちよかった？」と尋ね、少し間を置いてからキリンは静かに「はい」と答えます。ヒーラーはキリンに「もう一回したい？」と尋ね、キリンはまたためらいながらも「はい」と答えます。\n\n\nにほんごを使用してください。そして細かい所はお任せしますので先生のお好きなようにしてください。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1DtjH0LFK8H1-ZThkY2BaWDrO_nyicvxu?usp=drive_link", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ankatomoshibi/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c0733626/uploads/origins/6bfd686a-1461-4ffd-8c91-be29c0b9be27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85455cdbf34f4b8f6792ebf12fb12d2b", "srcset": "https://si.imgix.net/c0733626/uploads/origins/6bfd686a-1461-4ffd-8c91-be29c0b9be27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85455cdbf34f4b8f6792ebf12fb12d2b, https://si.imgix.net/c0733626/uploads/origins/6bfd686a-1461-4ffd-8c91-be29c0b9be27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98715fa9c5d41a8995c787cbbd12a389 2x, https://si.imgix.net/c0733626/uploads/origins/6bfd686a-1461-4ffd-8c91-be29c0b9be27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d06e249bc0998ab9a771eb38c7a187b 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3303661, "nc": 161}, {"path": "/@ankatomoshibi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3303661, "client_id": 2018933, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7780b422/uploads/origins/6e65a974-2ff1-418a-89e4-228d0824cfea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32723a24d69e1fdd6db32a09cb861d08", "srcset": "https://si.imgix.net/7780b422/uploads/origins/6e65a974-2ff1-418a-89e4-228d0824cfea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32723a24d69e1fdd6db32a09cb861d08, https://si.imgix.net/7780b422/uploads/origins/6e65a974-2ff1-418a-89e4-228d0824cfea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4ce6b2913f931fb1178bc60c36a3986 2x, https://si.imgix.net/7780b422/uploads/origins/6e65a974-2ff1-418a-89e4-228d0824cfea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b386c1a2eadd64d51b8a9ef1a1f0ae4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7780b422/uploads/origins/6e65a974-2ff1-418a-89e4-228d0824cfea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8afb0eca3d353433d0614a9a77396c7b", "srcset": "https://si.imgix.net/7780b422/uploads/origins/6e65a974-2ff1-418a-89e4-228d0824cfea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8afb0eca3d353433d0614a9a77396c7b, https://si.imgix.net/7780b422/uploads/origins/6e65a974-2ff1-418a-89e4-228d0824cfea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=87a680eba71cb560b688728c832ee766 2x, https://si.imgix.net/7780b422/uploads/origins/6e65a974-2ff1-418a-89e4-228d0824cfea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6fb00b2df304754cb5ebee2ea016e0a6 3x"}, "body": "あんかともしび 様\n\nはじめまして。\nあんかともしび様が描かれた、盗〇される月〇美兎の股を広げた煽情的な姿や、筆おろしオフ会を開くmrn船長のスタイルや表情がとてもそそりました。\n全体的に肉感や女性の興奮している表情や雰囲気がとても上手だと思います。これからも描かれる作品も楽しみにしています。\n\nもしお時間がありましたら、下記のシチュエーションを書いていただけたら嬉しいです。\n\n大枠は資料URLに格納しております。\n\n\n人物：にじさんじ　白雪巴\n服装：マイクロミニセーラー服（資料ＵＲＬ参照）\n　　　バストサイズＨ～Ｊくらい、乳輪大き目。\n　　　ニップレス無し、ローターとアナルバイブ有\n\n\nシチュエーション：資料URLにイメージを入れております。\n\n▼\nガラの悪い男にハメ撮り写真で脅され、コスプレさせられて夜の繁華街を連れまわされてしまった巴。\n\n(イメージ01)\n連れまわされた最後に着いたのはラブホテル。\nホテル街の通行人に、痴女のような恰好を見られ好き勝手噂されながら、\nラブホテルへと入る。\n\n(イメージ02)\n部屋を選ぶパネルの前で乳首弄られイかされる。\n(イメージ03)\n部屋へ向かうためエレベーターに乗るが、\nエレベーター内ではデカチンを押し付けられ\n１０階に着くまで手マンをされてしまう。\n１０階には他のカップル利用客がエレベーターを待っており、\n巴達の乗ったエレベーターがようやく１０階に到着する。\n\n(イメージ04)\nカップル利用客の前でエレベーターの扉が開くと、\n中には無理矢理キスをさせられて、手マンでイっている巴と男の姿が。\n\n(イメージ05)\n巴はなんとか部屋までたどり着くが、\n入った部屋は、通常のベッド以外に、\n天井から吊るされた拘束具、ＳＭ用品が設置されたＳＭルームだった。\n\n呆然としている巴に、男は巴の乳首を擦りながら、\n明日の朝まで犯すことを伝える。\n巴は今から自分はこんな所で犯されるんだということを意識させられ、\n絶望するがここまで暖められた身体は興奮してしまう。\n\n以上となります。\n細かいセリフや描写はおまかせ致します。\n\nご検討をよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1VPfNUVyx4c3wf-mrZNSQHvMaj3ZQiIf8?usp=sharing", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ankatomoshibi/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e89dae41/uploads/origins/96f8ea37-94a3-4187-b1f7-03a00dc542fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4e2107f533e7aa417a52ef6b1bc3864", "srcset": "https://si.imgix.net/e89dae41/uploads/origins/96f8ea37-94a3-4187-b1f7-03a00dc542fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4e2107f533e7aa417a52ef6b1bc3864, https://si.imgix.net/e89dae41/uploads/origins/96f8ea37-94a3-4187-b1f7-03a00dc542fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=457b0dd7a9e6f8fc4dc6f382384886b8 2x, https://si.imgix.net/e89dae41/uploads/origins/96f8ea37-94a3-4187-b1f7-03a00dc542fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c5c1f8b20f411f00bd0838bc6492950 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3303661, "nc": 57}, {"path": "/@ankatomoshibi/works/8", "private_thum