&h=200&s=c926d22a9f9e0ca14e882076519d0b80 2x, https://si.imgix.net/fa64ab89/uploads/origins/109faf91-e947-44c5-a2b0-49eca5c97ee5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bd942ed73140db58753d87cfc76c1c3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa64ab89/uploads/origins/109faf91-e947-44c5-a2b0-49eca5c97ee5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=519f2669987ddfeb0e376f476878b991", "srcset": "https://si.imgix.net/fa64ab89/uploads/origins/109faf91-e947-44c5-a2b0-49eca5c97ee5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=519f2669987ddfeb0e376f476878b991, https://si.imgix.net/fa64ab89/uploads/origins/109faf91-e947-44c5-a2b0-49eca5c97ee5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23059574ccd5aee7159508d023003f22 2x, https://si.imgix.net/fa64ab89/uploads/origins/109faf91-e947-44c5-a2b0-49eca5c97ee5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a857d2a2610e9c5d0353c1505526aed 3x"}, "body": "はじめまして。 Xをみてキャラを描いていただきたく思い依頼させていただきます。\n\n■キャラ 夜見れな \n■シチュエーション がに股でちん媚び\n■詳細\n ○衣装は踊り子衣装 \n○発情して、舌を出しながら媚びている\n ○左手でオナニー、右手でわっかを作ってちんこを欲しがっている \n○パンツやビキニが食い込み、むちむち\n○陰毛あり \n○カラーイラスト\n以上、よろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ankatomoshibi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3303661, "client_id": 3043837, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95421dee/uploads/origins/4035cfde-6ccb-46ae-98d3-30df2b0f32b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4bc0100ba29919c1f431647f7a51f7e", "srcset": "https://si.imgix.net/95421dee/uploads/origins/4035cfde-6ccb-46ae-98d3-30df2b0f32b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4bc0100ba29919c1f431647f7a51f7e, https://si.imgix.net/95421dee/uploads/origins/4035cfde-6ccb-46ae-98d3-30df2b0f32b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e78dcf10a26e9061472cbf2a1a41797 2x, https://si.imgix.net/95421dee/uploads/origins/4035cfde-6ccb-46ae-98d3-30df2b0f32b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3e2b4cfa003e7f5702128d8ab34a9d3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95421dee/uploads/origins/4035cfde-6ccb-46ae-98d3-30df2b0f32b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=faa4fd37ef85d5b7334f230154132db5", "srcset": "https://si.imgix.net/95421dee/uploads/origins/4035cfde-6ccb-46ae-98d3-30df2b0f32b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=faa4fd37ef85d5b7334f230154132db5, https://si.imgix.net/95421dee/uploads/origins/4035cfde-6ccb-46ae-98d3-30df2b0f32b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0dd325321fd7358b7d65bbd2c6f663ad 2x, https://si.imgix.net/95421dee/uploads/origins/4035cfde-6ccb-46ae-98d3-30df2b0f32b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e3c8b3a03c26d353bb93b2d2009dc989 3x"}, "body": "漫画のリクエスト失礼します。\n\n作品　被虐男子藤崎くん（漫画）\n\nキャラ　藤崎林檎\n\n『製薬会社に勤めているJカップ爆乳OLが会社のヤリチン上司に飲みに誘われ、酔わされてホテルへお持ち帰りされるお話』\n\n大まかなシチュ\n日頃会社の男達から狙われ、『会社の女社員でヤりたい女ランキング』で入社してから1位を独占している林檎が、狙っている男の内の1人であるヤリチン先輩『田中』にサシ飲みに誘われる。悪い人ではないと思っているし（取り繕っているだけで実はヤりたいだけの悪い男）あくまで仕事の付き合いだと割り切り仕方なく行く事にした。\n\n酒を飲まされた林檎はすぐに酔い、いつもの性格とは真逆の開放的な痴女に早変わり。暑い暑いと薄着になり自慢の爆乳を強調。\n最近また胸が成長している等の胸の会話をして、彼が彼女の爆乳を見ていると「触りたいんですか？」等と見せつける様にゆさゆさ揺らし、触りたいと言えば下から持たせてくれたり、揉ませてくれた。\n居酒屋なので周りの男達は皆彼女のエロさに釘付け。酒を飲むと積極的になるのは予想外だったがコレはイケると確信した彼はそろそろ時間だと言って林檎をラブホへお持ち帰り。\n夢にまで見た念願の爆乳を好き放題揉み吸いぱふぱふ弄りまくり、自慢のデカチンで激しくイかせまくる田中。林檎は嬉しそうにしながら彼のチンポを受け入れている。2人はめちゃくちゃ激しく生中出しSEXに没頭していた。\n翌朝。林檎は目が覚めて自分が全裸である事、そして寝ながらおっぱいを吸っている田中に困惑。\nやがて昨日の事を思い出し、初めて自分の酒癖の悪さを知って後悔するのだった。\n\n※因みにノリノリでハメ撮りしてしまったので、田中は林檎の秘密を握っている事になる。\n\n以上です。\n漫画の情報だと彼女はJカップで乳輪はBカップくらいデカく乳首は大きめの小石位デカいです。酒飲むと開放的になります。\n\nおっぱい愛撫やSEXシーンを少し多めに、そして子宮をねちっこくグリグリする描写や、射精音や喘ぎ声がめちゃくちゃ激しめだと嬉しいです。竿役の田中のチンポは極太極長でカリ高です。\n\n細かい所はお任せしますので先生のお好きなようにしてください。\n\nよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ankatomoshibi/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/73f326c7/uploads/origins/a7d67f63-430b-4c1e-a415-f9deba618811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a174a8439b3f5e5c9f663764d3038d5", "srcset": "https://si.imgix.net/73f326c7/uploads/origins/a7d67f63-430b-4c1e-a415-f9deba618811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a174a8439b3f5e5c9f663764d3038d5, https://si.imgix.net/73f326c7/uploads/origins/a7d67f63-430b-4c1e-a415-f9deba618811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8178af540602a66b1df0887f37dea9d7 2x, https://si.imgix.net/73f326c7/uploads/origins/a7d67f63-430b-4c1e-a415-f9deba618811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0bb4d30c3869aca6c3f339cf6151242 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3303661, "nc": 33}, {"path": "/@ankatomoshibi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3303661, "client_id": 2724764, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bfa2eb9b/uploads/origins/596fd253-f570-4cbf-8d66-f37df63e68ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d34611489fd18bc6dc8e4a3b23404a5", "srcset": "https://si.imgix.net/bfa2eb9b/uploads/origins/596fd253-f570-4cbf-8d66-f37df63e68ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d34611489fd18bc6dc8e4a3b23404a5, https://si.imgix.net/bfa2eb9b/uploads/origins/596fd253-f570-4cbf-8d66-f37df63e68ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa1cbbce95ab255f526ef7be057de241 2x, https://si.imgix.net/bfa2eb9b/uploads/origins/596fd253-f570-4cbf-8d66-f37df63e68ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a82939263a15ca47f753abc3fb1cc95 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bfa2eb9b/uploads/origins/596fd253-f570-4cbf-8d66-f37df63e68ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa3ca9f3c1fc869ba3f3b1af847919ee", "srcset": "https://si.imgix.net/bfa2eb9b/uploads/origins/596fd253-f570-4cbf-8d66-f37df63e68ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa3ca9f3c1fc869ba3f3b1af847919ee, https://si.imgix.net/bfa2eb9b/uploads/origins/596fd253-f570-4cbf-8d66-f37df63e68ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23feb5aecd42e85a2c4d71467ae20581 2x, https://si.imgix.net/bfa2eb9b/uploads/origins/596fd253-f570-4cbf-8d66-f37df63e68ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=86a000a1ed6eddb5ac04e093b0f12950 3x"}, "body": "■カリ太の長い大きいチンポと（竿役はチンポと舌のみ）交尾する性欲の強い【ホロライブの桐生ココ】\n・卑猥な台詞と擬音\n・服装は布の面積が小さく乳首とクリの形が浮き上がって見える水着と同色の長手袋とニーソックス\n・黒ずんだ乳輪と乳首は大きく母乳が出る\n・デカクリでビラビラが肉厚で黒ずんでいる使い込まれたグロマン\n・マンコが見えるように整えられた髪と同色の陰毛が生えている\n\n■シチュエーション\n・ディープキスで大量の唾液を飲ませながらチンポをしごく\n・水着をずらして乳を見せると乳首が舌でペロペロされてビキビキと勃起する\n・軽く絶頂して噴き出した母乳を飲ませる\n↓\n・マンコを見せつけこっちも舐めろと要求\n・マンコを大きくグパァと広げさせ舌がペロペロ舐めるとデカクリがビキビキと大きく勃起\n・絶頂して噴き出した潮を飲ませながら、しゃぶってやるからとチンポを出すよう要求\n↓\n・亀頭をチロチロ舐める\n・マンコからヨダレを垂らしながらチンポをジュポジュポグポグポと貪るようにしゃぶって大きく勃起させる\n・口を離すと我慢汁が混じった唾液が尿道から舌にかけて糸を引く（背景に勃起したチンポに精子を期待してパクパクする子宮口のアップ）\n↓\n・交尾するぞと亀頭にマンコを押し付けるとマンコがチュパチュパ吸い付く\n・亀頭がズプンッと入りブシュッと潮を吹いて軽く絶頂\n・マンコがミチミチと広がりチンポをゆっくり飲み込んで腹ボコになり熱くトロトロの膣内で脈打つチンポにマン汁をすり込んでマーキングしながらガチハメを要求\n・激しく突き上げられると、乳を揺らしながら喘ぎ、イキそうになる\n・母乳噴射、舌出しンホ顔でブシューッと潮吹き絶頂、大量中出し\n・チンポを強く締め付けながら濃い精子をゴクゴク吸い上げ舌舐めずりをして味わう\n・マンコに強くしゃぶり付かれたチンポがゆっくりと引き抜かれゾクゾクと快楽が込み上げる\n・グポッと無理やり亀頭が引き抜かれるとマンコが大きくポッカリと開き精子がドバッと溢れてまた潮吹き絶頂\n・大きくポッカリと開いたままのマンコからチンポにかけてできた太く濃いザーメンブリッジを眺める\n・まだするぞと片手で中出しされたマンコをいじりながら体力を消耗して弱ったチンポをしゃぶって交尾の続きをしようとする\n\n■※修正はモザイクではなく線でおねがいします", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ankatomoshibi/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1f49fc94/uploads/origins/70f296c9-1f46-4856-949f-cfbe9408feb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05395635365655c57cdb2d75252f6a54", "srcset": "https://si.imgix.net/1f49fc94/uploads/origins/70f296c9-1f46-4856-949f-cfbe9408feb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05395635365655c57cdb2d75252f6a54, https://si.imgix.net/1f49fc94/uploads/origins/70f296c9-1f46-4856-949f-cfbe9408feb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=acfe31c3a7a6d70305459521c641957e 2x, https://si.imgix.net/1f49fc94/uploads/origins/70f296c9-1f46-4856-949f-cfbe9408feb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccent