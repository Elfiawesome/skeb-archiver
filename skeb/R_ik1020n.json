ことが目標\n初めて会った時から\"絶対に捕まえる\"と約束をしている。チェイスの修行をしてもらっていた師弟関係であるが、本当に兄かのように接しており居場所と捉えている \n「玲夢さんへの最大の恩返しは彼を捕まえることだ」 \n「玲夢さんが本当の兄だったら良いのに」\n 「玲夢さんを動かせるのは、変えられるのはきっと僕だ」  \n\n玲夢→百夜\n修行をしていた頃から百夜のことを「愛弟子」と可愛がっていた\n警察の中で唯一\"守りたい存在\"だと認識し、それが故に百夜を撃てないことも \n「モモは”大事”だけどそれ以外の警察を大事だと思ってないからなぁ」 \n「モモが死ぬかもしれないってなったら俺からしたらその組織が邪魔なんだよ」 \n「でも最近思うね、お前に賭けてみようかなとか。託すって意味で」 \n\n▎使用用途 ・Xでの投稿 ・サムネイル使用 ・非公式wikiでの掲載 \n\n▎参考資料\nキャラクター送付資料\n※百夜は前回描いてもらったもの\n※玲夢はゲーム内スクリーンショット  \n\n百夜非公式wiki\nhttps://w.atwiki.jp/stci2/pages/80.html  \n\n▎納品形式 \nキャラクターのみ透過画像希望\nファイル形式はPNGまたはPSD \n\n構図案が不足しておりました、大変申し訳ございません。再度リクエスト送信失礼します。\n\nhttps://drive.google.com/drive/folders/1KXRFjJKTuloUvOP9cZTRo76Ekvg1LDof", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@R_ik1020n/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fce6edad/uploads/origins/9dabf00a-e877-4bb5-a460-91b97aa73f61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5edffa5a5847f5d26f1c7faeac0c8974", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3562082, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@R_ik1020n/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3562082, "client_id": 564277, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/949293c2/uploads/origins/144e948c-2702-4e70-be9e-81e5562e8f4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dfc389f7d1ccb98c3af5486189095d9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.n