ート～ミドルショートくらいの髪に一見するとモデルのような美人な顔立ちな一方で、細身ながらも男性的な骨格に引き締まって筋肉質な体型に、巨乳と凶悪なサイズの陰茎がついているイメージをしています。受け役の少年は、基本的にノーマルな少年ですが、磨けば男の娘になれるような可愛らしさのある感じでお願いします。\n\n当方身長差・体格差フェチでもあるので、シーメールは190cm以上の非常に長身なイメージで、少年との身長差・体格差をできるだけ誇張するように描いていただけると嬉しいです。構図や体位などについてはお任せしますが、シーメールは重度のショタコンで、少年を男の娘にするべく調教しているような雰囲気で描いていただけると理想的です。\n\nご検討いただけると幸いです。よろしくお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@binbinsuke/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 16453, "client_id": 398841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5a08b7c/uploads/origins/1623512f-26e0-4ff7-a824-bf9f536f2f62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bb8f06d08f8fdf54c3459fc9bd5d29b", "srcset": "https://si.imgix.net/b5a08b7c/uploads/origins/1623512f-26e0-4ff7-a824-bf9f536f2f62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bb8f06d08f8fdf54c3459fc9bd5d29b, https://si.imgix.net/b5a08b7c/uploads/origins/1623512f-26e0-4ff7-a824-bf9f536f2f62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adac9d5f09224cfcd2d90a4d05b242c3 2x, https://si.imgix.net/b5a08b7c/uploads/origins/1623512f-26e0-4ff7-a824-bf9f536f2f62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d4b0188e146ff0a9131194adca2cf9a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5a08b7c/uploads/origins/1623512f-26e0-4ff7-a824-bf9f536f2f62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=386b1e1481eacfee8733bfca987136c8", "srcset": "https://si.imgix.net/b5a08b7c/uploads/origins/1623512f-26e0-4ff7-a824-bf9f536f2f62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=386b1e1481eacfee8733bfca987136c8, https://si.imgix.net/b5a08b7c/uploads/origins/1623512f-