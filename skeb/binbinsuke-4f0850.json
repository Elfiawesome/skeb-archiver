: null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/044933f9/requests/81275_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7df69ca2bea183387513bd6fed38c9ae", "srcset": "https://si.imgix.net/044933f9/requests/81275_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7df69ca2bea183387513bd6fed38c9ae, https://si.imgix.net/044933f9/requests/81275_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df04a8af487796a95b20f0d20ec3152c 2x, https://si.imgix.net/044933f9/requests/81275_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd6586b23254f08caa14ee4995dc5d33 3x"}, "body": "Heya! :D\n\nI LOVE you comics so much!\n\nI would like to request a drawing of your cute, chubby femboy from https://www.pixiv.net/en/artworks/81214026\n(I think his name is Ii-tan?)\n\nI'm using Google Translate, so I hope this makes sense:\n\nこれは彼にとってもう一つの未来です。彼の恋人は彼をお金のために男性とセックスさせています！\n\n彼はまだぽっちゃりしているので、小さな胸、大きなお尻、そして彼の胃と太ももにいくつかの重量があります。\n\n彼は裸です。\n彼は化粧をしていて、マニキュアをしています。\n彼は今、乳首ピアスを持っています（彼の通常のピアスと同様）\n彼の陰茎の周りには非常に小さな貞操ケージがあります（ https://imgur.com/a/2j2PXcO ）\n彼の首の周りの革奴隷の首輪。襟には紐が付いています。\n\n彼はベッドの横の床にひざまずいています。\n彼の前の床にはたくさんのお金があります。\n\n背の高い、筋肉質の黒い肌の男性2人が彼の両側に立っています。\n彼らは非常に大きなペニスを持ち、先端にホイップクリームが付いています。\nイイタンは両方の男性のコックを手コキします。\n彼も1つをなめています。彼の口に入るクリーム（とprecum）の一部。\nチンポを舐められている男は、リーシュをイイタンの首輪に少し引き寄せる。\n他の男は彼の電話で彼を撮影しています。\nイイタンは恥ずかしいだけでなく、興奮しています！\n\nI really hope you like the idea! \nI have some sequels planned too :D\n\nThank you!", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@binbinsuke/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 16453, "client_id": 398841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5b7a91c/requests/78427_0?bg=%23fff&auto=format%2Cc