れたつばめが，さくらを襲うという内容でして，それの挿絵に使用したいと考えております．\nこれについては今後，pixivの小説でアップしようと考えております．\n\nまた将来的に，擬人化SSの同人誌を配布しようと考えており，そのときには挿絵として使用したいと考えております．\n\nその他の内容についてはご相談したいと思います。\nよろしくお願いいたします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 8734, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "シロ9じらスケブ募集中", "screen_name": "siro90414", "avatar_url": "https://pbs.twimg.com/profile_images/2038820978776809472/m69teKMt.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1498108778/1607947973/1500x500", "appeal_receivable": false, "popular_creator_rank": 21, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 151054, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "五元市長", "screen_name": "fiftyone_st", "avatar_url": "https://pbs.twimg.com/profile_images/1882365196498591744/3WpAqypH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/189402215/1737625476/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 267108, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "KIMIDORI", "screen_name": "zanclusfish", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fc4395967-1367-47e3-a34b-da06c0067bbb.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/a8af86a2-2b39-422a-b659-8b446226f7ee.png", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "fi