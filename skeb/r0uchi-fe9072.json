 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8697358/uploads/origins/4c3b1e7c-9a84-4c62-90ec-1bc40c2ad0b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8be145ce19666fac74ee3284f57db838", "srcset": "https://si.imgix.net/b8697358/uploads/origins/4c3b1e7c-9a84-4c62-90ec-1bc40c2ad0b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8be145ce19666fac74ee3284f57db838, https://si.imgix.net/b8697358/uploads/origins/4c3b1e7c-9a84-4c62-90ec-1bc40c2ad0b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0eeed991863058a34405c42f83083c49 2x, https://si.imgix.net/b8697358/uploads/origins/4c3b1e7c-9a84-4c62-90ec-1bc40c2ad0b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1d5c185a6029909a0ded260f96bdb21d 3x"}, "body": "あなたの絵が好きです\n\nグラビティラッシュのキャットとレイヴンの百合絵をリクエストしています。\n\nこの二人が親密にイチャイチャして、熱くて汗ばむような絵が欲しいです。\n\n希望する内容は以下の通りです。\n-キャットとレイヴンが楽しそうにイチャイチャしているところ。\n-レイヴンのお尻を後ろから見るような視点で、レイヴンのお尻と背中を中心に。\n-黒いショートパンツを履いているキャット以外、二人とも裸です。\n\nリクエスト読んでくれてありがとうございます。\n\nhttps://imgur.com/a/WsBnTKK", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@r0uchi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 20537, "client_id": 792385, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92e3ae40/uploads/origins/921c7787-5c86-4155-a773-408070e3a969?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5aa45aee1fc60afb2ac78ce16a80428", "srcset": "https://si.imgix.net/92e3ae40/uploads/origins/921c7787-5c86-4155-a773-408070e3a969?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5aa45aee1fc60afb2ac78ce16a80428, https://si.imgix.net/92e3ae40/uploads/origins/921c7787-5c86-4155-a773-408070e3a969?bg=%23fff&auto=for