4697-5ed5-403b-82d8-4f98ca8eca09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b280237bc4eb7896948e787f410093e8", "srcset": "https://si.imgix.net/8b7cd5e8/uploads/origins/a8c84697-5ed5-403b-82d8-4f98ca8eca09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b280237bc4eb7896948e787f410093e8, https://si.imgix.net/8b7cd5e8/uploads/origins/a8c84697-5ed5-403b-82d8-4f98ca8eca09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35b1df5b2949946a93e4a0bef486ee58 2x, https://si.imgix.net/8b7cd5e8/uploads/origins/a8c84697-5ed5-403b-82d8-4f98ca8eca09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f172484640fa9b764c7ccf3aeb4a8e4d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b7cd5e8/uploads/origins/a8c84697-5ed5-403b-82d8-4f98ca8eca09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3165fa179e8388ad22f72e8493a13db8", "srcset": "https://si.imgix.net/8b7cd5e8/uploads/origins/a8c84697-5ed5-403b-82d8-4f98ca8eca09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3165fa179e8388ad22f72e8493a13db8, https://si.imgix.net/8b7cd5e8/uploads/origins/a8c84697-5ed5-403b-82d8-4f98ca8eca09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4be27160fa4c1fe1df4001186ec183a3 2x, https://si.imgix.net/8b7cd5e8/uploads/origins/a8c84697-5ed5-403b-82d8-4f98ca8eca09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a45bd733abd6c6035cc143e5fdb40fcc 3x"}, "body": "こんにちは！89.と申します。\nMeno様のイラストがずっと前から大好きで、陰ながら応援させていただいている者です。いつか依頼させていただきたいなと思っていて、この度自分への誕生日プレゼントも兼ねて、イラストのリクエストを送らせていただきました。\n\n︎✦︎┊リクエスト内容\n紫苑というOCを描いていただきたいです\n\n髪：灰色。癖毛のクラゲヘアに紫のメッシュ。目に若干かかるくらいの長さの前髪。黒いリボンでハーフツインしてます。\n目：やや青みがかった紫。まつ毛は長め。\n肌：血色は控えめで色白。\n特徴：溶けた黒色の天使の輪、14歳~高校生未満くらいの容姿です。少し幼げ。\n服：薄紫の大きめサイズのジャージです。萌え袖になります。袖の上の方に切れ目があります。\n小物：アイス、シャボン玉、風船、大鎌など。\n\nカラーパレットはあくまで目安ですので、近い色であれば大丈夫です。\n\n天使の失敗作で“死神”という設定があります。\n穏やかで大人しい子なので、表情は控えめでお願いしたいです。小物はお任せいたします、無しでも大丈夫です。\n\n︎✦︎┊使用用途\n個人鑑賞･個人利用、SNSのヘッダーやアイコンなどでの使用を想定しています。\n\n︎✦︎┊構図\nMeno様にお任せいたします。お顔がよく見える構図だと嬉しいです。少しミステリアスで惹き込まれる雰囲気で描いていただきたいです。\n\n︎✦︎┊ファイル\nPNGファイルでお願いします。\nまた、もし可能であれば人物と背景を分けたものもいただけると嬉しいです。\n\nお忙しい中恐れ入りますがご検討いただけますと幸いです。よろしくお願いいたします🪽‪⟡.꙳\n\nhttps://drive.google.com/drive/folders/1DiDAU9csqjuTKvFMlICSbYDxRj2sxPvm", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 37298, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "初白まみむ👾ボーマス K30", "screen_name": "ko_cha_22", "avatar_url": "https://pbs.twimg.com/profile_images/2030996667038838786/J7-TyIGT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/828583901392023553/1704788073/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 899508, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "よしお", "screen_name": "scomsio", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F1643ff31-9fe7-49c5-a8d6-74e745d202d0.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/a2332b22-d895-43ee-8c7f-713a5d903a09.png", "appeal_receivable": true, "popular_creator_rank": 77, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 21, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 2843993, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "回（null）", "screen_name": "nullmms", "avatar_url": "h