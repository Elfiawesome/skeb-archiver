-41a5-8846-b0716e239c2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d86bac0b1f60e3cb6dc56d95003d5f2", "srcset": "https://si.imgix.net/500a6c75/uploads/origins/bd0dd63b-e578-41a5-8846-b0716e239c2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d86bac0b1f60e3cb6dc56d95003d5f2, https://si.imgix.net/500a6c75/uploads/origins/bd0dd63b-e578-41a5-8846-b0716e239c2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1bef009b4c7e47a0522824ef93bfef32 2x, https://si.imgix.net/500a6c75/uploads/origins/bd0dd63b-e578-41a5-8846-b0716e239c2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=036bf41009dac6e1afad5168dd7817d6 3x"}, "body": "こんにちは。\n\n今回は自創作内のキャラの立ち絵を描き起こして頂きたいです。\n小説内の登場人物なので、サンプルの絵はありません。\n出来るだけ特徴を挙げますので、よろしくお願いします。\n\n・ネズミの獣人\n・白衣を着ている\n・厚手のメガネをかけている\n・身長は150cm程\n・前髪が長い（メカクレとも言える）\n・猫背\n・巨乳（）\n・髪の色、体色はお任せします（地味っぽい感じがいいかも）\nーーどうでもいいの壁ーー\n・表向きは発明家（工学系）\n・コーヒー大好き\n・変態\n\nよろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@casseroleafy/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 629771, "client_id": 49976, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19044a06/uploads/origins/e64f1861-2445-4884-83dd-69e0c0d8f978?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e64e5211c3e6d9298173402e3d538746", "srcset": "https://si.imgix.net/19044a06/uploads/origins/e64f1861-2445-4884-83dd-69e0c0d8f978?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e64e5211c3e6d9298173402e3d538746, https://si.imgix.net/19044a06/uploads/origins/e64f1861-2445-4884-83dd-69e0c0d8f978?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46b7d39bc5d44d689ca77cc41a58f243 2x, https://si.imgix.net/19044a06/uploads/origins/e64f1861-2445-4884-83dd-69e0c0d8f978?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93aa0833393f0674b8df3a94e7ad1309 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19044a06/uploads/origins/e64f1861-2445-4884-83dd-69e0c0d8f978?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3aeb406bd44554cd889e9ccb949b780a", "srcset": "https://si.imgix.net/19044a06/uploads/origins/e64f1861-2445-4884-83dd-69e0c0d8f978?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3aeb406bd44554cd889e9ccb949b780a, https://si.imgix.net/19044a06/uploads/origins/e64f1861-2445-4884-83dd-69e0c0d8f978?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=10ae81b11844f48469a22965a7f84161 2x, https://si.imgix.net/19044a06/uploads/origins/e64f1861-2445-4884-83dd-69e0c0d8f978?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=25f7ffd34a7e052e8787cc354e2e9d99 3x"}, "body": "[依頼文全てに載せています]\nキャラ骨格などわかりにくい部分などあるかと思いますが、それっぽい感じにしてもらえればと思います。\n例えばケモ足の子でも、クリエイター様の描きやすい、または好みなものがヒトよりであればそれで、もちろんオリジナルに寄せてもらっても構いません。どちらであっても楽しみにしていますので、よろしくお願いします。\n[テンプレここまで]\n\nちゃろとがな心さんの代理ちゃんといちゃらぶえっちしているのがみたいです\n基本おまかせしたいのですが、特に思いつかなければ対面座位かだいしゅきホールドあたりで…\n\n構図にもよりますが、おててを繋いでるかちゅーしているか、バックであればちゃろが、代理ちゃんのお胸をいじるかお腹を撫でるかしているとと嬉しいです\n（また可能なら受精描写、キャラに被る場合はありなしそれぞれあると嬉しいです）\n\nよろしくおねがいします～～～！！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@casseroleafy/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 629771, "client_id": 40458, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eff1dc70/uploads/origins/e4e31396-2dea-4630-9b02-6ca6b5812a57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=342e8c0b293b3c84cd062fa29502d1a0", "srcset": "https://si.imgix.net/eff1dc70/uploads/origins/e4e31396-2dea-4630-9b02-6ca6b5812a57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=342e8c0b293b3c84cd062fa29502d1a0, https://si.imgix.net/eff1dc70/uploads/origins/e4e31396-2dea-4630-9b02-6ca6b5812a57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f1f334845e705b2748e5c34922cd714 2x, https://si.imgix.net/eff1dc70/uploads/origins/e4e31396-2dea-4630-9b02-6ca6b5812a57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d70a5abcef7369ad65aeccabec85106 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eff1dc70/uploads/origins/e4e31396-2dea-4630-9b02-6ca6b5812a57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48d3653ce0f438db582cc163afa44960", "srcset": "https://si.imgix.net/eff1dc70/uploads/origins/e4e31396-2dea-4630-9b02-6ca6b5812a57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48d3653ce0f438db582cc163afa44960, https://si.imgix.net/eff1dc70/uploads/origins/e4e31396-2dea-4630-9b02-6ca6b5812a57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8659a1b7c6a1848e2c611299b6b19bfb 2x, https://si.imgix.net/eff1dc70/uploads/origins/e4e31396-2dea-4630-9b02-6ca6b5812a57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1188b4b91b12d92e7d46bb3e18fa5bd7 3x"}, "body": "すけべ依頼失礼します！\n\nウメザワちゃんが敵に捕まり、強制アクメレーザーでウメザワちゃんが死ぬまでイキ続けるってシチュがほしいです\n\n個人的に入れてほしいポイント：\n・アクメレーザーに当たる前、あたってる途中（イってる）、当たったあと（死）の３枚ができればほしいです\n・腕や足が固定されている\n・マンコと表情が見える\n・アクメレーザーは膣に撃つよりも、ギロチンみたいに上から横向きのビームが脳に到達するイメージ\n・ビームで脳が焼かれて死ぬorイくことによって脳がオーバーロードして死ぬ（デスアクメ）はどちらを選んでもらっても喜びます（\n・セリフや等入れてもらえたら嬉しいです\n・カナモリちゃんが見てて絶望するところを小さくワイプで見せてくれたら嬉しいけど、作業工程が多すぎたり、難しそうでしたら除いてもらっても大丈夫です", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@casseroleafy/works/12",