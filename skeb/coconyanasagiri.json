-cbf2-47fc-9f7a-904384f3c3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddd01eca772d824bedb9ccc461f027e9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75059a68/uploads/origins/37d3f073-cbf2-47fc-9f7a-904384f3c3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc4488c05fc19f826eaf135acd29ece9", "srcset": "https://si.imgix.net/75059a68/uploads/origins/37d3f073-cbf2-47fc-9f7a-904384f3c3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc4488c05fc19f826eaf135acd29ece9, https://si.imgix.net/75059a68/uploads/origins/37d3f073-cbf2-47fc-9f7a-904384f3c3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=51a370c25b3bc990595298f0c313a112 2x, https://si.imgix.net/75059a68/uploads/origins/37d3f073-cbf2-47fc-9f7a-904384f3c3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3e94386357b0738e38db9fbade7b8ad1 3x"}, "body": "こんにちは！\n今回はラブホテルでモンスターストライクの螢光院ヒカリ(神化)がストライカーと正常位する差分7枚をよろしくお願いします。\n\n服装は生身の身体で頭のパーツとニーソ部分(足のダイヤみたいなパーツは取る)以外は裸(裸ニーソ)でおっぱいのサイズはDカップ(推定)\n\nヒカリ(神化)のビジュアル↓\nhttps://sqool.net/monst-hikari-6.html\n\nシチュエーション\n1.ストライカーがヒカリをクンニする(ストライカーの顔は透明で顔が見えない感じ、難しいなら舌だけ書くだけでもOK)\nヒカリ「うぇ？！な、何するの？！ラブホに入っていきなりクンニは恥ずかしいよぉ♡」「やだ♡い、いく♡ひん♡」\n\n2.ヒカリがくぱぁして催促する\nヒカリ「んもぅ♡せっかちなんだから♡私もえっちがしたくなっちゃたじゃない♡」「ほらほら♡早く挿れてよ〜♡」\n\n3.ストライカーがヒカリの腰を掴んで正常位する\nヒカリ「んお\"♡きみのぶっといちんぽが奥までぇ♡ピストンしてるのぉ♡」「きみのこともぉ♡きみのちんぽも大好きぃ♡」\n\n4.そのまま中出ししてヒカリがイく\nヒカリ「射精すの？射精して♡いっしょ♡いっしょにイきたいのぉ♡」「私の膣内をきみのでいっぱいにしてええええぇ♡」\n\n5.ちんちんを抜かれたヒカリが潮を吹くのを我慢する\nヒカリ「んぁ♡ま、まだ抜いたらだめなのに♡」「い、いや♡潮吹いちゃうからぁ♡」\n\n6.我慢の限界を迎えたヒカリが大量に潮を吹きながらイく\nヒカリ「もうむり♡でちゃ・・・出ちゃうよぉ♡見ないでぇ♡」「ひあああああぁ♡」\n\n7.残った潮をじょぼじょぼと吹きながらヒカリが満足な表情をする\nヒカリ「はうぅ♡いっぱい潮吹いちゃったぁ♡気持ちよすぎてもう何も考えられないや♡」\n「もう一回・・・しよ♡」\n以上でよろしくお願いします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@coconyanasagiri/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 602008, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b99627e5/uploads/origins/8de406dd-ff46-48b3-9909-29bcb4754bda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f249d9656bb4057356fcec72417c5a5b", "srcset": "https://si.imgix.net/b99627e5/uploads/origins/8de406dd-ff46-48b3-9909-29bcb4754bda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f249d9656bb4057356fcec72417c5a5b, https://si.imgix.net/b99627e5/uploads/origins/8de406dd-ff46-48b3-9909-29bcb4754bda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d59ec99ee762b86b6e7792dedfd4915 2x, https://si.imgix.net/b99627e5/uploads/origins/8de406dd-ff46-48b3-9909-29bcb4754bda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fbcfe8bf4cfd988411abbb88658e50e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b99627e5/uploads/origins/8de406dd-ff46-48b3-9909-29bcb4754bda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98d2a4eeeb35c2a495ac5241c1fdb7c0", "srcset": "https://si.imgix.net/b99627e5/uploads/origins/8de406dd-ff46-48b3-9909-29bcb4754bda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98d2a4eeeb35c2a495ac5241c1fdb7c0, https://si.imgix.net/b99627e5/uploads/origins/8de406dd-ff46-48b3-9909-29bcb4754bda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=12c9abba9eef33c3cf198f20b4d78c9f 2x, https://si.imgix.net/b99627e5/uploads/origins/8de406dd-ff46-48b3-9909-29bcb4754bda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5273556ce5f1fa6b92716b0cc37fed43 3x"}, "body": "こんにちは！\n今回はラブホテルでモンスターストライクのネオが寝パイズリと屈曲位をする差分をよろしくお願いします。\n\n服装は裸ニーソ(※ネオのビジュアルと同じ片方の靴下は短いデザイン)\n\nネオのビジュアル↓\nhttps://altema.jp/monsuto/hyoka/6030\n\nシチュエーション\n1.ラブホに着いてからすぐにネオに寝パイズリをする\nネオ「ん♡いきなりパイズリを始めるなんてまだ心の準備ができてないよ♡」「ここはラブホテルっていうの？はぁ♡エッチしていい場所では・・・あなたの顔が怖く見えるよ♡」\n\n2.ネオに顔射してネオがやりたそうな顔をする\nネオ「いやぁん♡いっぱいかけられちゃった♡」「あなたのちんちんがまだ大きいね、しちゃう？」\n\n3.マスターがネオに屈曲位をする\nネオ「あん♡このエッチって奥に届きやすいんだね♡屈曲位って言うの？意外と気持ちいいかも♡」「あなたのちんちんがすごく熱くなってきたよぉ♡いいよ、射精して♡」\n\n4.中出ししてネオが潮を吹きながらイく\nネオ「あぅ♡いっぱいでたよぉ♡」「い♡いっちゃううぅ♡」\n\n5.ネオがおしっこをしながら満足したら表情をする\nネオ「ふああぁ♡潮もふいちゃたぁ♡」「ラブホテルのエッチがクセになりそうだよぉ♡」\n\n以上でよろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@coconyanasagiri/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 602008, "client_id": 712926, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1159d910/uploads/origins/d7da2021-bdc5-4276-baba-d9932690b803?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=208fb6eb0e884eed821f9b6e43038cf9", "srcset": "https://si.imgix.net/1159d910/uploads/origins/d7da2021-bdc5-4276-baba-d9932690b803?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=208fb6eb0e884eed821f9b6e43038cf9, https://si.imgix.net/1159d910/uploads/origins/d7da2021-bdc5-4276-baba-d9932690b803?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=252d01f05311b33649ee0477954096a2 2x, https://si.imgix.net/1159d910/uploads/origins/d7da2021-bdc5-4276-baba-d9932690b803?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9caed47a7f449d95af106dbddbd354e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1159d910/uploads/origins/d7da2021-bdc5-4276-baba-d9932690b803?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1fe402f77c3663e29698533c836cc8bd", "srcset": "https://si.imgix.net/1159d910/uploads/origins/d7da2021-bdc5-4276-baba-d9932690b803?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1fe402f77c3663e29698533c836cc8bd, https://si.imgix.net/1159d910/uploads/origins/d7da2021-bdc5-4276-baba-d9932690b803?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=509652bbfb9ac2dab186c006af00095f 2x, https://si.imgix.net/1159d910/uploads/origins/d7da2021-bdc5-4276-baba-d9932690b803?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fead7eff284736d3a021153cf4d6bad9 3x"}, "body": "またリクエスト聞いてください！(笑)\n今月バレンタインなので、浅井三姉妹の彼氏持ち\n初(https://20932.mitemin.net/i713840/)(絶壁設定があるので胸平らにしてください)と\n江代(https://20932.mitemin.net/i704904/とhttps://20932.mitemin.net/i704903/)(こちらは巨乳)が、\nチョコの入ったボールに、初は経血、江代はおしっこをしてもらって、それぞれの彼氏へのバレンタインチョコを作ってるイラストをお願いしたいです！\n因みに二人共愛液を入れる為に胸出しながらオナニーしてます(笑)\n台詞は、\n初「お腹痛いけど、京極先輩の為に頑張るぞ……」\n江代「んっ……これを彼氏が食すと思うと胸が高鳴る……ッ！」\nです！", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@coconyanasagiri/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 602008, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f752154/uploads/origins/42d0bafa-0303-4313-96c3-691febe934e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f34979e94767a6c94f0d97d6f0c0023", "srcset": "https://si.imgix.net/7f752154/uploads/origins/42d0bafa-0303-4313-96c3-691febe934e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f34979e94767a6c94f0d97d6f0c0023, https://si.imgix.net/7f752154/uploads/origins/42d0bafa-0303-4313-96c3-691febe934e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f315a572974ad135691957f8f7948cd1 2x, https://si.imgix.net/7f752154/uploads/origins/42d0bafa-0303-4313-96c3-691febe934e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c1e950352194152c956e674ddfd4a53 3x"}, "duration": null, "nsfw": true, "hardc