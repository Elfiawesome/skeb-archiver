でいますが、私のアートスキルは良くありません。(コーダーの方が得意です）。私の既存のスプライトをもっと「公式」なポケモン風に変換していただけませんか？\n\n以下は、私が持っている、孫悟空スタイルの大きなゴリラのスプライトの例です： https://drive.google.com/drive/u/0/folders/1ZnOqrSrDi7fVQc5bzMLAZQ0CpoLFScLN\n\nこれを参考にする必要はありません。\n\nありがとうございました！\n- オーウェン\n\nhttps://drive.google.com/drive/u/0/folders/1ZnOqrSrDi7fVQc5bzMLAZQ0CpoLFScLN", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@onigin_pixelart/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5e7cadc4/uploads/origins/41773db3-37d2-4533-9fa5-c00a37a7ee5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af008862ba60ffdb65bbf62e377698e1", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 601397, "client_id": 1248163, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@onigin_pixelart/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5e699f81/uploads/origins/a00335a0-a984-4f3f-bbf4-7dfd88b6d5b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ffeb2b82ee3930e38755b5a3b069e31", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 601397, "client_id": 1499320, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@onigin_pixelart/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f6d162d7/uploads/origins/6a2f1e5c-16fe-4a7a-9127-6d4bf7565f03?bg=%23fff&a