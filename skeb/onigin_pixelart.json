8e42-6df5dc68bd73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7888855a90310f3c5f335510840f1bf6", "src_set": ""}, "body": "こんにちは！失礼ですが、ニュージーランドのキウイ鳥をモチーフにしたオリジナルの偽ポケモンをデザインしていただけないでしょうか？友達とTRPGで使いたいです！\n\nポケモンのタイプは自由です。  2段階か3段階の進化系ポケモンをデザインしてもらえると嬉しいです！\n\nお忙しい中、本当にありがとうございました！\n\nhttps://images.app.goo.gl/sxBE1HGtczY4FtH2A", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@onigin_pixelart/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 601397, "client_id": 3456458, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/417851b7/uploads/origins/34156251-b98e-4c92-93d2-119ec83137d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67f0a31f2a2285c29483dba7b5b31837", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/417851b7/uploads/origins/34156251-b98e-4c92-93d2-119ec83137d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b542bdd6e14d06ef860af95b6b7868c", "src_set": ""}, "body": "私のDQX OCのあなたのピクセルアートが欲しいです。\n詳しくは、右手でスカーフを持っている。\n\nhttps://ibb.co/vZF71hs", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@onigin_pixelart/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 601397, "client_id": 1798313, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca9850b6/uploads/origins/60702aeb-95db-4c85-a894-54e139f4c9fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84383e1b651a4070111b54016ea83e10", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca9850b6/uploads/origins/60702aeb-95db-4c85-a894-54e139f4c9fe?bg=%23fff&auto=format