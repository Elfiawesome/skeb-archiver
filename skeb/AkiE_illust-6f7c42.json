//si.imgix.net/0599fc3e/uploads/origins/ae096f6f-0903-4efe-b1ea-bbced5859722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa32ecac66ff38015d29b18d4080e7ab, https://si.imgix.net/0599fc3e/uploads/origins/ae096f6f-0903-4efe-b1ea-bbced5859722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be0cd3d8c6a202838efd05e54eab2eb2 2x, https://si.imgix.net/0599fc3e/uploads/origins/ae096f6f-0903-4efe-b1ea-bbced5859722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=229439db93321693783e892aa258412b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0599fc3e/uploads/origins/ae096f6f-0903-4efe-b1ea-bbced5859722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d86d68e6232bfc338241deee18db856f", "srcset": "https://si.imgix.net/0599fc3e/uploads/origins/ae096f6f-0903-4efe-b1ea-bbced5859722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d86d68e6232bfc338241deee18db856f, https://si.imgix.net/0599fc3e/uploads/origins/ae096f6f-0903-4efe-b1ea-bbced5859722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=51048147e4e3e5df57105af055ea4488 2x, https://si.imgix.net/0599fc3e/uploads/origins/ae096f6f-0903-4efe-b1ea-bbced5859722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eb6db685867ca92ca582ff8b8f28c6e0 3x"}, "body": "こんにちは。あなたの作品を偶然見つけて、とても素晴らしいと思いました。私のオリジナルキャラクターである「ラバレダ」の作品を依頼できないかと思っています。\n\n彼女のヒューマノイドの形はこれです\n\nhttps://files.catbox.moe/i5o8se.png\n\n一方、地獄の獣の姿はこれ。\n\nhttps://files.catbox.moe/uaznnc.png\n\n人間の姿よりも獣の姿で何かを得たいと思っていました。\n\n戦いの直前や最中のような、恐ろしさと美しさを同時に表現したものを希望していました。\n\nご検討のほど、よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@AkiE_illust/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": 