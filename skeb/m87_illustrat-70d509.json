68c6780805a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f54facb817439a97a3a709f392235782 2x, https://si.imgix.net/84f1ae07/uploads/origins/362d033a-54fb-481a-a7e0-68c6780805a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b9c41117b2c6e37c8e0f08e1861ecfe 3x"}, "body": "【幻想生物の観察スケッチ】という感じのテーマで作品を拝見したいです。\nせっかくなので、X（Twitter）で触れられていたスケッチ集みたいな雰囲気のものをお願いします。\n\nメインは妖精さんとかファンタジー動物とかで、できればダークなものよりは夢のある感じのものだと嬉しいです。\nスケッチ内容は、\n・ルーチン行動\n・お食事の仕方とか食べてるものとか\n・寝てる姿とか寝床とか\n・特定の状況（天敵に出会った、とか）での仕草や表情\n……等、思いついた項目を挙げてみましたが、特にどれが必須とか、数はいくつ以上とかはないので、自由に描いてほしいです。\n作品中への文字入れの有無もおまかせします。\n「こんな子がいたんだよ～」ってスケッチを見せてもらうような感じで鑑賞させていただきたいです。\n\nM87さんのファンタジー系のイラストも、素敵で楽しく拝見しています。\n人物画はもちろん、動物のイラストも時々お描きになると思うのですが、そちらもモフモフした子とか可愛いな～と思いながら拝見しているので、人型でも動物でも、筆の乗るテーマでお願いできればと思います。\nご都合つきましたら、よろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@m87_illustrat/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1542313, "client_id": 1902186, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8d39d4e/uploads/origins/b432cd26-93a2-45e4-a8bc-a5894daba6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e367eb7d8d5a267f1541fee2c607f9d", "srcset": "https://si.imgix.net/d8d39d4e/uploads/origins/b432cd26-93a2-45e4-a8bc-a5894daba6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e367eb7d8d5a267f1541fee2c607f9d, https://si.imgix.net/d8d39d4e/uploads/origins/b432cd26-93a2-45e4-a8bc-a5894daba6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2837657e1047a692f0178f7a12922c47 2x, https://si.imgix.net/d8d39d4e/uploads/origins/b432cd26-93a2-45e4-a8bc-a5894daba6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5fc6606c04f02867190442a88c2ecf5 3x"}, "duration": null, "nsfw": false