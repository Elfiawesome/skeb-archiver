compress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baf839819790766dd1d9bb7272edbea6, https://si.imgix.net/037d237b/uploads/origins/abf776b6-c79b-40b9-ac74-f40b00ac90de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d6728d43f75f18e09e02a934e7ff61a 2x, https://si.imgix.net/037d237b/uploads/origins/abf776b6-c79b-40b9-ac74-f40b00ac90de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c24724069029d23cae9e712d0c9fcde8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/037d237b/uploads/origins/abf776b6-c79b-40b9-ac74-f40b00ac90de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d9bb5213b29cf414c4d92672c30e1ee", "srcset": "https://si.imgix.net/037d237b/uploads/origins/abf776b6-c79b-40b9-ac74-f40b00ac90de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d9bb5213b29cf414c4d92672c30e1ee, https://si.imgix.net/037d237b/uploads/origins/abf776b6-c79b-40b9-ac74-f40b00ac90de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=effd3c6c6669971f1fd09200742f2ba0 2x, https://si.imgix.net/037d237b/uploads/origins/abf776b6-c79b-40b9-ac74-f40b00ac90de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd7dc5400be0bd1d9ff1fe5b404789ff 3x"}, "body": "はじめまして。エロ絵の依頼です。\nカゴヤマさんのアカウントにある、カルト信者夫婦の子作りセックスが見たいなと思い、送らせていただきました。\n\nエロいことをしていれば満足なので、シチュエーションの指定は特にありません。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kagoyama_18/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3636996, "client_id": 3569617, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8a3f478/uploads/origins/bb8833a5-2942-4405-b981-378676ab0646?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb17222