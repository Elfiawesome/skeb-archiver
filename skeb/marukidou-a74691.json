303-8dbf45943779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c6957dd0cc3ff055c5470676d61b6bd", "srcset": "https://si.imgix.net/8fb5d962/uploads/origins/25ff16d3-fd13-4db5-b303-8dbf45943779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c6957dd0cc3ff055c5470676d61b6bd, https://si.imgix.net/8fb5d962/uploads/origins/25ff16d3-fd13-4db5-b303-8dbf45943779?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dcd535fab3a5c84339b5ffe122f3ad0f 2x, https://si.imgix.net/8fb5d962/uploads/origins/25ff16d3-fd13-4db5-b303-8dbf45943779?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c4547b9c67d028d439de012b1b71911a 3x"}, "body": "はじめまして、\n先生が2019年に執筆された作品“人妻動画 〜恥辱ナマ配信〜”が大好きです。\nそして、その作品のIFルートのリクエストをさせて下さい。\n\n内容は夫の要求で乳首とクリトリスに特製なリング状ローターを付き、電車で生配信する。\nリングローターの外観が下のURLのイラストを参考させてください。\n服装の要求は下着なしだけで、他のは先生に任せてください。\n\n妻は配信器材を持って自分を撮影して、夫は後ろに姿を隠し、彼女をセクハラし弱い場所を責める。\n妻は必死に我慢し、周りの景色を紹介しますが、最後は盛大な潮吹きして終わります。\n\n以上、ご検討宜しくお願いします\n\nhttps://skeb.jp/@kara_sashi/works/8", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marukidou/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3347062, "client_id": 3014814, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c61ed25a/uploads/origins/a00a560a-58c3-410a-863f-9b6b6d8dd4bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fea8f781274867413743734dcd9aff3", "srcset": "https://si.imgix.net/c61ed25a/uploads/origins/a00a560a-58c3-410a-863f-9b6b6d8dd4bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fea8f781274867413743734dcd9aff3, https://si.imgix.net/c61ed25a/uploads/origins/a00a560a-58c3-410a-863f-9b6b6d8dd4bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37ea50787a1b489c63351088b462961b 2x, https://si.imgix.net/c61ed25a/uploads/origins/a00a560a-58c3-410a-863f-9b6b6d8dd4bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76213ff11cbec6999164b8cec343ed30 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c61ed25a/uploads/origins/a00a560a-58c3-410a-863f-9b6b6d8dd4bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92f1c3f09bc94ddd98fc7dd9f5d1c962", "srcset": "https://si.imgix.net/c61ed25a/uploads/origins/a00a560a-58c3-410a-863f-9b6b6d8dd4bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92f1c3f09bc94ddd98fc7dd9f5d1c962, https://si.imgix.net/c61ed25a/uploads/origins/a00a560a-58c3-410a-863f-9b6b6d8dd4bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=84fb827999f9cf00a0293cfcf711b868 2x, https://si.imgix.net/c61ed25a/uploads/origins/a00a560a-58c3-410a-863f-9b6b6d8dd4bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=68ca9ed6e4ace997c5bd37e4d154b92d 3x"}, "body": "わたしのオリジナルキャラの浣腸、排泄を伴う拘束マゾプレイをお願いいたします。\n\n女の子参考画像→ https://imgur.com/a/bkKZb8C\n・柔和な顔つき（やや垂れ目）、巨乳（B90くらい？）低身長\n彼氏参考画像→ https://imgur.com/a/FN4IutY\n・彼女よりちょっと大きいくらいの小柄な女顔男子 ・小柄だけどちんちん大きい（補足情報）\n\nシチュエーションとして、\n①プレイ前の姿。「今日は…何するの？」みたいなセリフを言いつつ、楽しみと心配が混ざったような表情をしている。\n②プレイ中。拘束具をつけられ、口にはボールが大きめのハーネスボールギャグを付けられてよだれを垂らしており、鏡の前に座らされて自分の姿を見せられている。\n③ 彼氏に浣腸してもらう。\n④我慢している。自分の出している姿が鏡で見えてしまうため、かなり苦しそうに嫌がっている。\n「やぁあ゛ぁ！！おいええうんい゛あえぇ゛ええ！！（やだああ！トイレでうんちさせてぇ！！）みたいな声を出している。\n⑤我慢しきれずに下痢混じりの固形便を大量にひりだしてしまう。雄叫びのような悲鳴をあげている。\n⑥鏡でその姿が見えてしまい、羞恥や気持ちよさなどがごちゃ混ぜになった感情で笑顔を浮かべている\n\nというものをお願いいたします。\n細部に関しては調整等していただいてOKです。よろしくお願いいたします。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marukidou/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3347062, "client_id": 193668