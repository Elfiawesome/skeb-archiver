eaa, https://si.imgix.net/62042d53/uploads/origins/765a7f1f-ed67-45c8-9960-cbe874a9b5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e90720e36e75646d24459dcc86078c71 2x, https://si.imgix.net/62042d53/uploads/origins/765a7f1f-ed67-45c8-9960-cbe874a9b5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf2c85bf990e8330d6cef8be72b84614 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62042d53/uploads/origins/765a7f1f-ed67-45c8-9960-cbe874a9b5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cd767f4b4cf47f7ac3cf777870ab5fc", "srcset": "https://si.imgix.net/62042d53/uploads/origins/765a7f1f-ed67-45c8-9960-cbe874a9b5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cd767f4b4cf47f7ac3cf777870ab5fc, https://si.imgix.net/62042d53/uploads/origins/765a7f1f-ed67-45c8-9960-cbe874a9b5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b1877d1912b7d0a0223d5f3cd68f0b0b 2x, https://si.imgix.net/62042d53/uploads/origins/765a7f1f-ed67-45c8-9960-cbe874a9b5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8a16527f941a25fcd89e17383268fa7e 3x"}, "body": "こんにちは！あなたのイラストは本当に素敵ですね。描かれる女の子たちはいつもとてもかわいいです！私のキャラクター、ニイリンを描いていただけませんか？[https://imgchest.com/p/ej7mwvmkjyd]\n\n彼女は寒冷な北の国出身の貴族の娘で、その奇妙な魔法を恐れる人々から逃れるために家を出ました。今は冒険者となり、魔法を使って魔法のスノードームの中に居心地の良い住まいを作っています！旅の途中や、スノードームの家でくつろいでいる姿、あるいは全く別のシーンなど、お好きなように描いてください！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuuhagi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3919261, "client_id": 543260, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eda33481/uploads/origins/8434a9ef-e370-483d-8fce-db959ed0ba7b?bg=%23fff&auto=forma