ate": false, "genre": "art", "tipped": true, "creator_id": 3919261, "client_id": 1792056, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fea54aa9/uploads/origins/52df26ea-2094-4b6e-b7ef-9679fb0b3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6abfbe5f4cf03dc163a9088d06716a98", "srcset": "https://si.imgix.net/fea54aa9/uploads/origins/52df26ea-2094-4b6e-b7ef-9679fb0b3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6abfbe5f4cf03dc163a9088d06716a98, https://si.imgix.net/fea54aa9/uploads/origins/52df26ea-2094-4b6e-b7ef-9679fb0b3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d7bee025b674a5fd2f59150ac8c22c1 2x, https://si.imgix.net/fea54aa9/uploads/origins/52df26ea-2094-4b6e-b7ef-9679fb0b3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93b2225322c7308d2bf55ea12178ff69 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fea54aa9/uploads/origins/52df26ea-2094-4b6e-b7ef-9679fb0b3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b6582149261bf0fd87c1e7e3c81775", "srcset": "https://si.imgix.net/fea54aa9/uploads/origins/52df26ea-2094-4b6e-b7ef-9679fb0b3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b6582149261bf0fd87c1e7e3c81775, https://si.imgix.net/fea54aa9/uploads/origins/52df26ea-2094-4b6e-b7ef-9679fb0b3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=acc85c6cd0ebcd04afebb282a5a77af6 2x, https://si.imgix.net/fea54aa9/uploads/origins/52df26ea-2094-4b6e-b7ef-9679fb0b3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4a7c1e93862e7c631213bd5a6123ac24 3x"}, "body": "こんにちは、悠萩さん。\n以前からSNSで作品を拝見しているファンです。\n可愛らしくて繊細なキャラクターイラストがとても好きで、この度リクエストさせていただきました。\n\n今回は、キャラクターデザインを含めて、猫耳と猫しっぽのある女の子をお願いしたいです。\n少し臆病だけれど優しい雰囲気の子をイメージしています。\n\n髪は長めのアイボリー系、瞳は淡いミントグリーンで、やさしいグラデーションと明るいハイライトのある感じだと嬉しいです。\n表情については、美しい場所にたどり着いたような、少し前向きで明るさの感じられる雰囲気だと嬉しいです。\n\n衣装は、白に近いごく淡いミント系のシフォンワンピースをイメージしています。\n透け感のあるやわらかなレイヤーが重なった、ふんわりと幻想的な印象だと嬉しいです。\nドレスに蝶結びのリボンを入れていただけたら嬉しいです。大きさや位置は、描きやすいようにご調整いただければと思います。\n\n足元は、メリージェーンシューズと白いフリルソックスでお願いしたいです。\n靴の色合いはお任せします。\n\n髪飾りとして、小さなヘアクリップを付けていただけたら嬉しいです。\n形は、角から見た立方体のように三面が見える、シンプルなキューブ形をイメージしています。\nこちらは参考画像を添付いたします。\nhttps://postimg.cc/bSrCKVmd\n\nシチュエーションは、海辺とオーロラを感じられる、静かで幻想的な雰囲気を希望しています。\n背景、ポーズ、構図などはお任せします。\nその子らしいやわらかさや可愛らしさが感じられる仕上がりだと、とても嬉しいです。\n\n全体として、描きやすい形にアレンジしていただけましたら嬉しいです。\n悠萩さんらしい感性や絵柄を交えて仕上げていただけましたら、とても嬉しいです。\n可能であれば、縦横比は8:5程度ですとありがたいです。\nよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuuhagi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3919261, "client_id": 154569, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ccbb49c2/uploads/origins/54e1ca9f-ed9a-4ea5-8e3f-ecdf868c0057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa75dab5b196e0d9829d57eeb9a56a0a", "srcset": "https://si.imgix.net/ccbb49c2/uploads/origins/54e1ca9f-ed9a-4ea5-8e3f-ecdf868c0057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa75dab5b196e0d9829d57eeb9a56a0a, https://si.imgix.net/ccbb49c2/uploads/origins/54e1ca9f-ed9a-4ea5-8e3f-ecdf868c0057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad8b96bffc32a0be4d576ed1e79dea34 2x, https://si.imgix.net/ccbb49c2/uploads/origins/54e1ca9f-ed9a-4ea5-8e3f-ecdf868c0057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8961058fe4689d382cce192c149b32e7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ccbb49c2/uploads/origins/54e1ca9f-ed9a-4ea5-8e3f-ecdf868c0057?bg=%23fff&auto=format%2Ccompress&