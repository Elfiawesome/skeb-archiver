orks/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4f1701e9/uploads/origins/12930d44-2804-4499-9f64-b5ab23d2d2ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eeac36ba7831a13bb68a4bcc523403b6", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 4475, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@goumonsha/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4475, "client_id": 2090875, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6977ed54/uploads/origins/3cbb1962-f17d-4628-a97f-1bbfec067aca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf4a9b535d478c68e4fb20e328ba3c76", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6977ed54/uploads/origins/3cbb1962-f17d-4628-a97f-1bbfec067aca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2a826704b190fb7dd7391f1b96e70a5", "src_set": ""}, "body": "飛来ボデー様初めてまして。\n今回依頼させていただく内容ですが、結束バンドのジャケ写オマージュをお願いします。\n元となるジャケットはBlack Eyed PeasのMonkey Businessというアルバムになります。\n並び順や表情など全てお任せいたします。\n使用用途としてはPCトップ画やSNSでのアイコンに設定したいと考えております。\n\n以上、ご検討の程よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@goumonsha/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4475, "client_id": 338322, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21c04083/uploads/origins/79fe3a65-6071-434b-b1a9-4d16adbe0ab2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e0ec645748f5c788e9baf5577932f89", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21c04083/uploads/origins/79fe3a65-6071-434b-b1a9-4d16adbe0ab2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf07cbfa4aa1648c485771062fa1527b", "src_set": ""}, "body": "こんにちは！ぼっちをテーマにカスタムキーボードをデザインしたのですが、このキーボードを持っているイラストをお願いしたいです。\n衣装はいつものジャージジャケットと制服でお願いします。\n背景は必要ありません。\nキーボードの写真：https://imgur.com/a/NHxcFuJ\nありがとうございました！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@goumonsha/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4475, "client_id": 3062663, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb0b6563/uploads/origins/f7d085d3-5f64-4f16-95cf-106561031b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3028eef231343b29a95be09182c4c9c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb0b6563/uploads/origins/f7d085d3-5f64-4f16-95cf-106561031b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e89940eea9e37336407389fc7dd9412f", "src_set": ""}, "body": "飛来ボデー先生、初めまして！\n今回、LINEオープンチャット用にイラストを制作していただきたく、リクエストいたしました。\n内容としては、結束バンドメンバー全員が集結している立ち絵です。\n詳細としては、これでもかというほど満面の笑みを浮かべた結束バンドの皆が、仲睦まじく肩を寄せ合っている様子を描いて欲しいです。\nメンバーの並び順は、左から 虹夏→ぼっち→喜多→リョウでお願いしたいです。\n服装に関してですが、メンバー全員(いつも着こなしている)制服でお願いいたします。\nまた背景の有無についてですが、可能であれば四季問わず一年中使用出来るような風景でお願いしたいです。\n何卒、宜しくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@goumonsha/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4475, "client_id": 2852091, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/25742090/uploads/origins/ca991df8-a465-4342-817a-20481ad69849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53071ff7668a6e0cab90b2ac29fe0b4c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25742090/uploads/origins/ca991df8-a465-4342-817a-20481ad69849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4033d1e5c620f6ebcbc79b587188fe65", "src_set": ""}, "body": "依頼したいイラストは廣井きくりさんの立ち絵です。\nプリキュアオマージュの結束バンドに倒されるキャラで、涙の雫をイメージしたピアスを左につけて欲しいです。(変身アイテム)\n武器はベースなので背負うか担いでいて欲しいです。衣装はプリキュアの感じを残しつつ、黒色メインで敵感が欲しいです。\n星歌への恋心を押し殺し、私は強いと傲慢なキャラになるので、表情はいつもの余裕(？)のようなものが欲しいです。\n星歌さんが紫陽花のネックレスをつけるので、ネックレスを匂わせる感じで付けられたらお願いしたいです。\n背景は必要ありません。\n何卒よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@goumonsha/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b98a8846/uploads/origins/7b95fee3-bc04-4c02-abac-e72d0c8fe5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca96ff2131f8ccc9846406f04b19ae34", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 4475, "client_id": 100048, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 61553, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "桜海こも🦅お仕事募集中", "screen_name": "46Rmsk", "avatar_url": "https://pbs.twimg.com/profile_images/1754160872434614272/dloRK3pF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1435596637/1695211399/1500x500", "appeal_receivable": false, "popular_creator_ra