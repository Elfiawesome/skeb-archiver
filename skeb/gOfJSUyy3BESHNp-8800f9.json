の潮吹きさせられるシチュ」\nをお願いします\n・女の子はpixivにあげられているサキュバスさんの様な見た目(普通の人間)\n・主観もしくは男の顔等は描かない感じで構いません(描いていただいても大丈夫です)\n・ケンカップルなイメージ\n・服装はお互い全裸\n・台詞や擬音もお願いします\n・構図は、隣か向かい合って座っているもしくは立っている感じだと嬉しいですが、より良いものがあればそちらで構いません\n・形式(漫画、差分、複数構図等)、とカラーorモノクロはお任せします\n\n描けるものと合わない、コスパが見合わない等あれば、キャンセルしていただければと思います\n長くなり申し訳ないです、もしよろしければご検討お願い致します", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gOfJSUyy3BESHNp/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 616827, "client_id": 393292, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6931fcdd/requests/143726_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be0c171017315649a11d804bdd729727", "srcset": "https://si.imgix.net/6931fcdd/requests/143726_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be0c171017315649a11d804bdd729727, https://si.imgix.net/6931fcdd/requests/143726_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d320467ed425e7964b3b6cb8b429df51 2x, https://si.imgix.net/6931fcdd/requests/143726_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=484c34167913fa2a3218a175a2032de6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6931fcdd/requests/143726_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6485f3bd47960dcedd234cc0ce4a4e46", "srcset": "https://si.imgix.net/6931fcdd/requests/143726_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6485f3bd47960dcedd234cc0ce4a4e46, https://si.imgix.net/6931fcdd/requests/143726_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a5306427ce029807266615a46a419e55 2x, https://si.imgix.net/6931fcdd/requests/143726_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=to