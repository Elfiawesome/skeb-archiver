-47ab-b122-a176214ddb1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c1a30aa498fd3bf4defadaa43f9f8c2", "srcset": "https://si.imgix.net/39dfab78/uploads/origins/11fffb8d-6de8-47ab-b122-a176214ddb1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c1a30aa498fd3bf4defadaa43f9f8c2, https://si.imgix.net/39dfab78/uploads/origins/11fffb8d-6de8-47ab-b122-a176214ddb1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d76094b5a1e9e79f30aa058f841e68ae 2x, https://si.imgix.net/39dfab78/uploads/origins/11fffb8d-6de8-47ab-b122-a176214ddb1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d393a6faaba018816c6761a0f8ad4758 3x"}, "body": "こんにちは、また戻ってきました！あなたの作品が大好きなので、もっと欲しいです！(ᕑᗢूᓫ∗)\n\nまたヘダとリンを描いてほしい。今回は砂山での冒険です。背景のサンプルを用意したので、それを使うか、似たようなものを探してください。参考になる実例が見つからなかったので、ポーズの落書きもしました！私の落書きが意味をなせばいいのですが、笑。\n\nヘダは地図を読んでいて、\"あっちに行こう \"と指差す。\n凛は方位磁石を見ていて、どっちに行けばいいのかわからない。彼女は混乱して頭を掻いている。(すみません、英単語を使わないとSkebでエラーになります！)\n\n参考画像はこちら：\nhttps://drive.google.com/drive/folders/13mw20cTvfJyYAqdQAXEYQnwqlwTGUPi-?usp=sharing\n\n備考\n- ヘダの顔のマーク\n- ヘダの側頭部の羽毛\n\nすべて理解できるといいのだが。私はあなたを信頼しています！あなたは毎回素晴らしい仕事をしてくれます！ありがとう！\n\nご検討ありがとうございました！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirotsumesou_7/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2929339, "client_id": 1622498, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a62a525e/uploads/origins/d9fa6a44-7fc5-4422-9080-5cf86fbe0719?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35e33c2bcc1d734740a7270172355653", "srcset": "https://si.imgix.net/a62a525e/uploads/origins/d9fa6a44-7fc5-4422-9080-5cf86fbe0719?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35e33c2bcc1d734740a7270172355653, https://si.imgix.net/a62a525e/u