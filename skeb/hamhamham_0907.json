0&blur=200&s=a947d8060acf004c8400e41a1880b926", "src_set": ""}, "body": "リクエストお願いします。\n\nキャラ：ネイア・e・ピケ（信奉者正装）\n\nシチュ：\n(https://x.com/hamhamham_0907/status/1960971444722323909)のようにバトルに負けたお仕置きとしてマジックハンド的なものに胸を揉まれたり股を弄られてしまう。\n台詞としてはそろそろ勝つよう小言を言っている感じでお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamhamham_0907/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3295777, "client_id": 1430761, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/195c6425/uploads/origins/2ef48f2b-474a-4535-9fc1-f1a9747d0a94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c34761803d0bfa4a242a02e32f732ebc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/195c6425/uploads/origins/2ef48f2b-474a-4535-9fc1-f1a9747d0a94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21b57550e8ec878bce1d44acd1f2addc", "src_set": ""}, "body": "初めまして、だるませんべいと申します。いつもイラスト拝見させてもらっています。今回イラストのご依頼したくご連絡しました。\n・キャラは私の立ち絵のイラスト\n・衣装は魔法少女服(イメージはアニメ版魔法少女リリカルなのはの高町なのは)\n・可能であれば差分で服がボロボロになっている差分(R-15位でお願いします)\n・構図は特にこだわりありません。杖など可能であれば持たしていただけると嬉しいです\n・サムネ、または配信中に画面に移すことは可能でしょうか？\n・服の装飾が多いため、また差分があるため金額が大きく変わることはありますか？\n\nご忙しいとは思いますが、よろしければ以上の内容でのご依頼、ご検討お願いします。\n\nhttps://share.google/images/5mY4ZnSLZtYx8fA6T", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamhamham_0907/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3295777, "client_id": 931082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/262de5b3/uploads/origins/6cfa5a3c-915d-4746-9a35-204aac7bcecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c099183e5582a6eb21f6998ad85250b8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/262de5b3/uploads/origins/6cfa5a3c-915d-4746-9a35-204aac7bcecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0907f4553087e26250e1447e7866327e", "src_set": ""}, "body": "先日は素敵なイラストをありがとうございました。リクエストから間もなく早い納品をしていただきとても嬉しかったです。そこでこの機会にぜひHAM.さんに描いていただきたいリクエストがあり再び送らせていただきました。遊戯王OCGのマドルチェ・プディンセスとフレッシュマドルチェ・シスタルトのチアガールコス衣装イラストをお願いしたいです。\n\n構図\n・ローアングル一人称視点\n・カメラ目線\n・腕を上げて腋を見せ、フリフリスカートから覗く太ももパンツ等が強調されるようなポーズで可愛く元気に応援しているようなイメージ\n\n服装\n・ミニスカニーハイチアガール衣装\n・シスタルトの頭のシスターベールは残したままでお願いします\n\n表情\n・プディンセス：元気いっぱいの眩しい笑顔\n・シスタルト：少し恥ずかしがりつつも頑張って応援してくれているイメージ\n\n体型\n・身長は二人とも同じくらいの高さ\n・太ももは二人とも極太むっちむち\n・胸はプディンセスは並程度、シスタルトはぷるんぷるんたゆんたゆん揺れて下から下乳が見えるくらいでっかいデカ乳\n\n台詞\n・『がんばれ♡がんばれ♡』『負けるな♡ファイト♡』等の応援台詞イメージ\n\n希望差分\n・プディンセス：ドヤ顔気味のニヤニヤメスガキ風表情差分\n・シスタルト：目を細めながら舌をベーっと出して小馬鹿に挑発するようなメスガキ風表情差分\n・上記の表情に合わせて台詞の言い回し雰囲気もちょっと悪い子っぽくアレンジいただけると嬉しいです。\n\nその他\n・背景は明るくハートがいっぱいの可愛いイメージ\n・擬音の語尾には♡マークがついてると嬉しいです\n\nご多忙の中恐れ入りますが、どうかご検討のほどよろしくお願いいたします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamhamham_0907/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3295777, "client_id": 931082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4168a40/uploads/origins/84d9e178-32df-49ee-806f-c1ec1a951c0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28e3d3c2687c4226634493da81a830fd", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4168a40/uploads/origins/84d9e178-32df-49ee-806f-c1ec1a951c0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45aa111bacfcd8b8ce34ba51c6527139", "src_set": ""}, "body": "初めまして、この度HAM.さんの素敵なイラストをお見かけし、ぜひ描いてもらいたいと思うリクエストがあり送らせていただきました。\n遊戯王OCGの『マドルチェ・エンジェリー』というモンスターカードのイラストをお願いしたいです。\n\n構図\n・ローアングル一人称視点\n・カメラ目線で上から見下ろしている\n・スカートの中でフリルやリボンなどが施されたイメージの女児が履いてるような明るく可愛い柄のパンツをパンチラさせてる\n\n体型\n・元イラストはデフォルメですがHAM.さんの普段描かれてる頭身でお願いしたいです\n・小学生くらいイメージの身長\n・胸は見た目相応の大きさ\n・お腹周りはすっきり\n・極太むっちむちのふともも\n\n表情\n・困り眉でこちらを挑発するような媚び媚びあざといメスガキ顔\n・メスガキの本性を表した目を細めたニヤニヤ笑顔で強気なメスガキ態度でこちらをバカにしてるような表情差分をお願いしたいです。\n\n希望台詞(イメージ)\n・『は〜いエンジェリーちゃんのおパンツですよぉ〜♪こんな幼い女の子が履くようなパンツでもお前みたいなロリコンマゾは大喜びで大興奮しちゃうんですよねぇ〜？ほんっときもすぎですぅ〜w』みたいなこれでもかとあざとい口調でこちらを馬鹿にして見下すようなするようなイメージでお願いしたいです。\n\nその他\n・背景はハートが飛び交い明るく可愛いイメージ\n・台詞無し差分も合わせてお願いしたいです。\n\nご多忙の中恐れ入りますが、どうかご検討のほどよろしくお願いいたします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamhamham_0907/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a885ac89/uploads/origins/df05a199-d29e-4502-a24d-c93857c17355?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=629f43c679cf86b636f54bd99afb6ce3", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3295777, "client_id": 1492316, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 184, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hamhamham_0907/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3295777, "client_id": 93644, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5838b7d8/uploads/origins/7607f40d-d6c3-462d-85bf-886af63e8bde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f181bff08c080781f9d778165eaa04e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5838b7d8/uploads/origins/7607f40d-d6c3-462d-85bf-886af63e8bde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=c