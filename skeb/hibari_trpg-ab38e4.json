&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=18c5e3a32c245322f031ceb2992c68c9 2x, https://si.imgix.net/b923ae90/uploads/origins/4ea439ee-5c97-41d0-a3b6-f77ea0253398?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0fbfadcb081ac8e4b2d054222184c683 3x"}, "body": "おつかれさまです！\n\nいつも遊んでくれてありがとうございます！！\nよろしければまちまいの一枚絵をお願いしたいと思いご依頼させていただきました…！\n\nご検討よろしくお願いいたします…！🙇‍♀️✨", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@Aioi_0606/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3909597, "client_id": 1816549, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/504b9023/uploads/origins/c1c2f597-9aa7-4ba2-9bb4-ed76a8ab5bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99d26394dc02a222cedff99782099026", "srcset": "https://si.imgix.net/504b9023/uploads/origins/c1c2f597-9aa7-4ba2-9bb4-ed76a8ab5bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99d26394dc02a222cedff99782099026, https://si.imgix.net/504b9023/uploads/origins/c1c2f597-9aa7-4ba2-9bb4-ed76a8ab5bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3955ac8a29117d157fbe8de3885826a 2x, https://si.imgix.net/504b9023/uploads/origins/c1c2f597-9aa7-4ba2-9bb4-ed76a8ab5bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d66a5c74ca2bf6b1aa06f94f7e2ca689 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/504b9023/uploads/origins/c1c2f597-9aa7-4ba2-9bb4-ed76a8ab5bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d5e2105d045c6e755b13581b5b8d728", "srcset": "https://si.imgix.net/504b9023/uploads/origins/c1c2f597-9aa7-4ba2-9bb4-ed76a8ab5bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d5e2105d045c6e755b13581b5b8d728, https://si.imgix.net/504b9023/uploads/origins/c1c2f597-9aa7-4ba2-9bb4-ed76a8ab5bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=21b6846369077f269f7ba00bdaac14b1 2x, https://si.imgix.net/504b9023/uploads/origins/c1c2f597-9aa7-4ba2-9bb4-ed76a8ab5bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3997ad1f80c6c96a54a52748f957c1cd 3x"}, "body": "あいおい様\n\nいつもお世話になっております！相生さんの絵柄が大好きで、skebを開けられたとのことで早速ご依頼に参りました...！\nもしよければ、私と相方のTRPGキャラクター2人を一枚絵で描いていただけないでしょうか？\n以下詳しいキャラクター説明となります。(シナリオのネタバレはありません)\n\n―――\n\n✘前提条件\n・「Title Lost」というTRPGシナリオ出身の二人。「ミティカ」というルーマニアモチーフの街で暮らしている。\n・二人は悪魔憑きのエクソシストと天使の加護を持つ殺人鬼で、いわゆる腐れ縁に近い存在。職業は違うものの、利害の一致で仕事を共にすることもある。現時点では、主従と呼んだほうが近い。\n・お互い片方の「眼球」をそれぞれ交換している。\n\n咎 璃弌\n右目：黒色\n左目：水色\n\nエルガー\n右目：水色\n左目：黒色\n\n(リンク先の資料によっては目の色が違う場合がありますが、上記が正しいものになります。ややこしくて申し訳ございません。)\n\n―――\n\n✘白髪・右目の下に泣き黒子\n→咎 璃弌(とが - りひと)\n男性/24歳/164cm/利き手：右/職業：エクソシスト(拳銃使い)\n\n・エクソシストをしている24歳。背が低いことを気にしている。職業に似合わず体が弱い。\n・日本人気質故に性格は真面目。だが、ここぞという時は大胆に飛び込んでいく度胸も持ち合わせている。\n・自由奔放なエルガーに振り回されることが多いが、彼のことを唯一と呼べるほど、この世で最も大切な人だと思っている。\n・気恥ずかしさ故に本人は認めていないが、エルガーに対して過保護気味な部分がある。\n\n―――\n\n✘黒髪・瞳孔がダイヤの形\n→Arger＝Martin(エルガー・マーティン)\n男性/28歳/182cm/利き手：左/職業：殺人鬼(ナイフ使い)\n\n・マイペースで自由奔放な性格。基本的に感情に任せて動いており、後先を考えていない。これにより、よく咎 璃弌のことを振り回している。\n・「クルトシュ」という甘いパンが好き。咎 璃弌の家に押しかけてミティカの街を眺めながら一緒にお茶会のをすることもある。\n・咎 璃弌のことを死なせたくないと考えており、彼と交流する上で邪魔だと感じた者(咎 璃弌と敵対していたり、良くない感情を向けている人)を優先的に始末することが多い。本人曰く不快指数が格段に上がるためとのことだが、璃弌から「無闇矢鱈に殺すな」と言われて渋々刃を収めることもある。\n・咎 璃弌のことを主人のように慕っている。信仰心に近い感情も向けており、咎 璃弌が言ったことは全て正しいと思っている節がある。エルガーにとって、咎 璃弌を何者からも優先し守ることが第一事項である。\n\n―――\n\n✘モチーフやイメージ(必ず取り入れる必要はありません。この二人の雰囲気の参考になれば幸いです。)\n宗教、信仰、神、西洋、黒と白、表裏一体、唯一無二、胃痛枠の飼い主と自由奔放な忠犬\n\n―――\n\n容姿については、添付したリンク先を参照していただければと思います。\n構図や服装などはお任せで構いません。\n描いて頂いたイラストは鑑賞用のほか、相方への共有、イラストサイズによってはPCの壁紙やTwitterのアイコンもしくはヘッダーなどに使用する可能性がございます。\n\n金額等足りなければ遠慮なく再送いただけますと助かります...！\nお忙しい中恐縮ですが、ご検討いただけますと幸いです！\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ND3Ti-SOm7nc1nhintLDOCLOu8gXCdGu", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@llllll6______/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2016812, "client_id": 1816549, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/99f047e2/uploads/origins/c5f45f9e-251b-4f19-8dd0-8ede7f65e8b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf29ec458710be653fbf54b3bfbc72cf", "srcset": "https://si.imgix.net/99f047e2/uploads/origins/c5f45f9e-251b-4f19-8dd0-8ede7f65e8b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf29ec458710be653fbf54b3bfbc72cf, https://si.imgix.net/99f047e2/uploads/origins/c5f45f9e-251b-4f19-8dd0-8ede7f65e8b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ffb77b62e173ad4876832ab1191a4b55 2x, https://si.imgix.net/99f047e2/uploads/origins/c5f45f9e-251b-4f19-8dd0-8ede7f65e8b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4fad247436305d336263a55a6628016 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99f047e2/uploads/origins/c5f45f9e-251b-4f19-8dd0-8ede7f65e8b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67198d9ca3e0f0d3114294652fbc69dd", "srcset": "https://si.imgix.net/99f047e2/uploads/origins/c5f45f9e-251b-4f19-8dd0-8ede7f65e8b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67198d9ca3e0f0d3114294652fbc69dd, https://si.imgix.net/99f047e2/uploads/origins/c5f45f9e-251b-4f19-8dd0-8ede7f65e8b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c40691ba494237dce1f10d0e8c28f50 2x, https://si.imgix.net/99f047e2/uploads/origins/c5f45f9e-251b-4f19-8dd0-8ede7f65e8b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d09d716316a15f9196285880b01df4e 3x"}, "body": "なじ様\n\n初めまして。いつも魅力的な作品の数々を拝見しており、とても楽しく遊ばせて頂いております。この度Skebを開けられたと伺い、ご依頼に参りました。\n今回依頼したいのは、オリジナルキャラクター2人をお願いしたいと思っております。\n\n同じ大学に通う同い年の男の子2人です。肉体関係があるため友人と呼ぶには気軽すぎますが、かと言って恋人と呼ぶにはチープな関係...という、言葉で言い表せない2人です。\nあえて表すならば「共犯者」という言葉が一番似合う2人で、共依存気味です。\n\n以下、詳しいキャラクター説明をさせて頂いておりますが、長ければ読み飛ばして頂いて構いません。\n\n―――\n\n✘深藍の髪、つつじ色の瞳、泣き黒子\n→天宮伊月(あまみや いづき)\n21歳/男 175cm　心理学科社会心理学専攻\n\n・成績優秀、品行方正で大学の高嶺の花的存在です。顔も整っており、男女問わずとても人気があります。\n・どちらかといえば女性的で、ミステリアスな雰囲気があります。\n・誰とでも仲良くしていますが、相手の此くんだけは特別な存在であり、自分から積極的に誘ったり、可愛がるといった感情を積極的に向けています。\n\n―――\n\n✘黒マスク、ヘッドフォン\n→此遊佐(このかわ ゆさ)\n21歳/男 178cm 理工学部機械工学科所属。\n\n・機械オタクな陰キャくんで、口調に「はい乙」や「～してクレメンス」等、ネット用語が出ることが多いです。\n・大学入学時から天宮に片思いをしていましたが、つい最近、天宮の特別枠になりました。\n・普段は奥手で天宮に掌で転がされがちですが、天宮に対する独占欲や嫉妬心が誰よりも強いです。\n\n―――\n\nイラストに関してですが、黒やビビットピンク、赤色等を使って頂けると嬉しいです。また、2人の距離が近い構図をお願いできると嬉しいです。\nその他のポーズや表情等は全てお任せ致します。\nまた、2人の服装は資料と違うものでも構いません。\n\n描いて頂いたイラストは鑑賞用のほか、相方への共有、イラストサイズによってはPCの壁紙やTwitterのアイコンもしくはヘッダーなどに使用する可能性がございます。\n\n初めてのSkeb依頼なため、拙い依頼内容となっておりましたら申し訳ございません。\nもしよろしければ、ご検討頂けますと幸いです。\nどうぞよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1mkA_e4A1_d0GNAnPknB6FjHc-5X-m0MN?usp=share_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kome_trpg/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1251460, "client_id": 1816549, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35e911f1/uploads/origins/c2adebe9-a94f-4614-8161-794318b7414c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ae6fff3efcc5883e340e0b67647486f", "srcset": "https://si.imgix.net/35e911f1/uploads/origins/c2adebe9-a94f-4614-8161-794318b7414c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ae6fff3efcc5883e340e0b67647486f, https://si.imgix.net/35e911f1/uploads/origins/c2adebe9-a94f-4614-8161-794318b7414c?bg=