-0mo5_MD50MQy1cKTSrkB4imE5eMa7l", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kitakawa_19/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3392927, "client_id": 1196664, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/097de146/uploads/origins/7e325101-128b-40b8-8247-c79eddd2ee3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3069273cef51f8748f0f1b0d3735a85", "srcset": "https://si.imgix.net/097de146/uploads/origins/7e325101-128b-40b8-8247-c79eddd2ee3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3069273cef51f8748f0f1b0d3735a85, https://si.imgix.net/097de146/uploads/origins/7e325101-128b-40b8-8247-c79eddd2ee3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=020f21ceb80f4e9b838415f9beea3a28 2x, https://si.imgix.net/097de146/uploads/origins/7e325101-128b-40b8-8247-c79eddd2ee3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d5cfa636b0af78902fcf53228c87b23 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/097de146/uploads/origins/7e325101-128b-40b8-8247-c79eddd2ee3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6ed5fd207d931a7b6bc7c0e2eea91e2", "srcset": "https://si.imgix.net/097de146/uploads/origins/7e325101-128b-40b8-8247-c79eddd2ee3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6ed5fd207d931a7b6bc7c0e2eea91e2, https://si.imgix.net/097de146/uploads/origins/7e325101-128b-40b8-8247-c79eddd2ee3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62e60d76ad6ba32db235f979217360fc 2x, https://si.imgix.net/097de146/uploads/origins/7e325101-128b-40b8-8247-c79eddd2ee3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4f4e26ea82add75a551f4b95292e3685 3x"}, "body": "はじめまして、Vtuberとして活動しております砂星はやと申します。\n北河ゆに様のかわいらしい素敵なイラストを拝見して、ぜひ自分自身のことを描いていただきたいと思いご連絡いたしました！\n\n◆構図\n髪型、構図、ポーズなどお任せ希望です。\n使用用途の関係で頭や体が見切れていないものが嬉しいです。\n可能であれば表情差分を無理のない範囲でお願いしたいです！\n\n◆キャラクター特徴\n砂の国に住む、コノハズクをお供につれた魔女見習い\nミニゴーレムを召喚できる\n(コノハズク/ゴーレムは描かなくても問題ありません)\n・褐色肌\n・瞳は基本赤か紫\n(カラコンで変えたり魔法使うと色が変わったりする)\n・瞳の下に六芒星のハイライトが入っている\n・顔左頬骨(向かって右側)あたりにほくろあり(泣きほくろではないです)\n・猫口\n・向かって右側に八重歯\n・推しマークは砂時計⏳と星🔯\n\n◇詳細資料\nhttps://lit.link/snhs88\nhttps://drive.google.com/drive/folders/1EpVZb56ZGE8hC0PJ_mfE9bUgJ-XagV0P\n3種類衣装があるのですがどれでも構いません。お任せでも大丈夫です！\n\n◆使用用途(可能性があるものを含む、使用の際はクレジット記載します。)\n・PCやスマホなど壁紙での個人利用\n・(収益化済の)YouTubeやTwitchなどの配信サイトやSNSでのサムネイル/配信や動画内/宣伝や告知画像/アイコン/ヘッダーへの使用\n・非営利のネットプリント\n\n◆納品形式\n可能でしたら背景とサインと人物を分けたPSDファイルでいただけると嬉しいです。\n\n以上です。\n金額不足などありましたら再送ください。\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1EpVZb56ZGE8hC0PJ_mfE9bUgJ-XagV0P", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kitakawa_19/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3392927, "client_id": 2589127, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f6d5eff/uploads/origins/5626dcad-cea3-4eed-9b1d-994090748c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab25950f275bedb0d7fd31accfe5c55d", "srcset": "https://si.imgix.net/7f6d5eff/uploads/origins/5626dcad-cea3-4eed-9b1d-994090748c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab25950f275bedb0d7fd31accfe5c55d, https://si.imgix.net/7f6d5eff/uploads/origins/5626dcad-cea3-4eed-9b1d-994090748c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a0b7e6f50705e1c59579a4a9b504307 2x, https://si.imgix.net/7f6d5eff/uploads/origins/5626dcad-cea3-4eed-9b1d-994090748c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2b1805a1b2