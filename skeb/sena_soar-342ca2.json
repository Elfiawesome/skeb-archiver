m=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a504591094b02dcdec3685c1e7817ec8 2x, https://si.imgix.net/9366fe43/uploads/origins/dbca91ed-cd30-4d34-8f74-768a2f8c6937?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a3963146d33d0f348119facc0ec937c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9366fe43/uploads/origins/dbca91ed-cd30-4d34-8f74-768a2f8c6937?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bc6dcd4db380a41aa50dcff8e5c6ecd", "srcset": "https://si.imgix.net/9366fe43/uploads/origins/dbca91ed-cd30-4d34-8f74-768a2f8c6937?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bc6dcd4db380a41aa50dcff8e5c6ecd, https://si.imgix.net/9366fe43/uploads/origins/dbca91ed-cd30-4d34-8f74-768a2f8c6937?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ef2bcc25a09628cecfd7fa1889514acd 2x, https://si.imgix.net/9366fe43/uploads/origins/dbca91ed-cd30-4d34-8f74-768a2f8c6937?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c74d4e63288c5d523f01429b12d87122 3x"}, "body": "初めまして、いつも素敵なイラストを拝見させて頂いております。\n\n依頼の内容と致しましては、774inc.有閑喫茶あにまーれ所属「瀬島るい」様をお願い致します。\n\n【場景・容姿等】\n・容姿はステージ(アイドル)衣装。\n・背景はライブステージのイメージでお願いします。\n・マイクを持たせてください。デザインや種類は問いません。\n・表情は明るいものとしてください。\n\nその他細かい調整、作者様好みの追加要素等、全てお任せ致します。\nまた個人の宛名の記載は必要ありません。作者様名の記載はお任せ致します。\n\nよろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sena_soar/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1239490, "client_id": 1095121, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4c65af4/uploads/origins/167156bf-9c1b-4c99-a1ba-d15957b9b721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8666539833799347c77aab7ed8a42d48", "srcset": "