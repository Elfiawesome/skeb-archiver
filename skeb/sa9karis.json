ウエストショットの構図でポーズや背景はお任せしますが可能でしたら2人のちびキャラも\nぬいぐるみとしてアンジェリナが抱いて一緒に写真に写っているようにして貰えたらと思います\nよろしければご検討の程よろしくお願い致します", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sa9karis/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1449860, "client_id": 129740, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c41ef9db/uploads/origins/61164f0c-4e3c-4ffd-adb2-d48da438e64a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89fc4a51486215092b571f6c7ae243f8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c41ef9db/uploads/origins/61164f0c-4e3c-4ffd-adb2-d48da438e64a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c160fed22a17714cb3ab3efebd31688d", "src_set": ""}, "body": "いつもお世話になっております\n蒴果様が以前描かれていたシェルファニールのイラストが気に入っていましてそこから着想したアイデアを基にリクエスト致します\n\n何かやらかしてしまったランディウスとアンジェリナを正座させ笑顔で怒りマークを浮かべ黒いオーラを醸し出しながらお説教をするシェルファニールのイラストをお願いします\n可能でしたらシェルファニールの威厳(怒気)に尊敬の眼差しのメルパーニと恐れおののいて震えるオリヴァーも追加して貰えたらと思います\nSDキャラを使ってコメディ寄りの描写でお願いしたいと思いますのでご検討の程よろしくお願い致します", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sa9karis/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1449860, "client_id": 175182, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f39d644/uploads/origins/33a16aa5-cb40-432b-ab49-28995e52509e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad8e28e88dbfe8ecf39e7c26e3597bb2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f39d644/uploads/origins/33a16aa5-cb40-432b-ab49-28995e52509e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=494e382ee9a