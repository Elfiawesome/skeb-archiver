af84-2bf7d7c8e857?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e609afa01352ecef8720c7cd922cd5b, https://si.imgix.net/a999b557/uploads/origins/d26e2603-8b6e-45ff-af84-2bf7d7c8e857?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e7284aeb9d7ceb5dd454e0b9b1fbd091 2x, https://si.imgix.net/a999b557/uploads/origins/d26e2603-8b6e-45ff-af84-2bf7d7c8e857?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a3bf5910eb06d7ef6cd87bf0728f0e1f 3x"}, "body": "はじめまして、こんにちは。綺麗で素敵なイラストに一目ぼれして、ずっと依頼したいなぁと思っていました。\nそこで今回思い切ってリクエストさせていただきました。よろしくお願いします！ \n\n\n以下、書いていただきたい子の設定となります。\nポーズや構成などはお任せ致しますので何卒よろしくお願い致します！宇宙みたいな感じたと嬉しいです！\n\n\n▽宇宙花火ちゃん\n・性別：女の子\n・年齢：16歳\n・身長：177センチ\n・好きな物 宇宙、海\n\n・性格:\n自由奔放な性格。常にふわふわしておりお気楽な宇宙大好き電波ガール\n\n・設定: \n苗字や、宇宙からの電波を受信しようとしているからか、周りの人達からは好奇、嫌悪などの目線を向けられている。あだ名は「宇宙人」\n\n授業中や夜の間に家、学校を抜け出して高いところに行ったり、水場でぷかぷか浮かんだりして、なんとか宇宙からの電波を受信しようとしている。\n本人曰く「ピピ……あと少しでなにか聞こえそうなの！だからその時を待ってるの！」と周りの目を気にせずに楽しそう。\n\n\n両親が失踪している孤児のため、両親を求めてこのような行為をしている。\n\n\nふわふわしていてずっと楽しそうだが本当は臆病で怖がりなだけの少女。幸せだった日常が無くなったことから幸せになると不幸が来る。だから幸せが怖いという発想に至りる。\nまた同時に未来が怖かった。ずっと変わらない今が続いて欲しい彼女とは違い幼なじみは少しずつ変わっていった。永遠の停滞を望む花火にとって進化や未来、前に進むことは幸せと同じぐらい怖かった。\n\nでも本音なんてものは言えるわけがなかった。\n言ったら何か変わってしまいそうだから。だから昔と変わらない髪型で、昔と変わらない喋り方で、昔と変わらない呼び方で幼なじみと今も接している。\n \n☑️ハリトレフェスマーシーという深海のくらげをイメージした子。\n☑️怖がりで臆病な内面を絶対に見せない。\n☑️幼なじみと家族以外は興味が無い。\n\n\n・髪色：青色と白のグラデーション\n・目の色：青とちょっと紫\n\n金額が十分であれば等身と、デフォルメをお願いしたく思います。また可能であれば人物の透過バージョンも下さると嬉しいです。\n\nよろしくお願いします！\n\nhttps://drive.google.com/file/d/1w47-uq9kZtk2Jrw0XETu12pMcFSd3a64/view?usp=drivesdk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@room2204/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1030315, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70ac95f5/uploads/origins/3743eb09-eb65-4c6a-afdb-02a12d14155f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0712ea52d4bd31d56002501871e0c0c", "srcset": "https://si.imgix.net/70ac95f5/uploads/origins/3743eb09-eb65-4c6a-afdb-02a12d14155f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0712ea52d4bd31d56002501871e0c0c, https://si.imgix.net/70ac95f5/uploads/origins/3743eb09-eb65-4c6a-afdb-02a12d14155f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bf4b143db64b39c37e3747e0ed7d3a0 2x, https://si.imgix.net/70ac95f5/uploads/origins/3743eb09-eb65-4c6a-afdb-02a12d14155f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da935646a0f7509f0c1c2c8a0b3669e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70ac95f5/uploads/origins/3743eb09-eb65-4c6a-afdb-02a12d14155f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8e97d4e9710505b8bdc0cd39291f7cd", "srcset": "https://si.imgix.net/70ac95f5/uploads/origins/3743eb09-eb65-4c6a-afdb-02a12d14155f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8e97d4e9710505b8bdc0cd39291f7cd, https://si.imgix.net/70ac95f5/uploads/origins/3743eb09-eb65-4c6a-afdb-02a12d14155f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7f1b6cac71b50bc876034f489e7f365e 2x, https://si.imgix.net/70ac95f5/uploads/origins/3743eb09-eb65-4c6a-afdb-02a12d14155f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=55f1b5317d08308d6248b7524d841f49 3x"}, "body": "しう様、はじめまして。絵柄や雰囲気が魅力的で、とても惹かれたのでリクエストさせていただきます。\n宜しければTRPGの探索者をお願い致します。\n\n\n【設定】\nお人形さんみたいにかわいい双子の兄妹。テーマは十二星座の双子座。\n画像の左が妹のジミニージェミニ、右が兄のピノキオ・ジェミニ。\n\nジミニージェミニ\n・明るく猪突猛進ガール。兄や周囲の人間を振り回しがちなトラブルメーカー。\nいい子なので人を傷つけることはしない。むしろ傷つけてしまうのが怖い。お兄ちゃん大好き！\n\nピノキオ・ジェミニ\n・猪突猛進な妹とは正反対で落ち着いている。いつも妹の暴走を止めている。\nが、楽しくなるとじぶんもウキウキになってしまい後から「しまった！」となるタイプ\nまったく…といいながらも妹のわがままを受け止め、それを叶える。シスコン\n\n\n星空イメージの、双子が左右対称になっている全身イラストが見てみたいです…！難しければしう様のお好きなように描いて頂いても大丈夫です。\n\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-1a3a8X8WrU84_Ox8D5z9Ghkv65yf3IC", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@room2204/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1030315, "client_id": 1031168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2311ba7f/uploads/origins/86223525-14bb-4ba5-9e46-32827e100f1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=659dba0f6d9abb0e6c1250270db6511e", "srcset": "https://si.imgix.net/2311ba7f/uploads/origins/86223525-14bb-4ba5-9e46-32827e100f1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=659dba0f6d9abb0e6c1250270db6511e, https://si.imgix.net/2311ba7f/uploads/origins/86223525-14bb-4ba5-9e46-32827e100f1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1ab874400f1ae1cc2fec61e469f9c23 2x, https://si.imgix.net/2311ba7f/uploads/origins/86223525-14bb-4ba5-9e46-32827e100f1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d433ea139f4bb29cde5a6dbe44fd072 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2311ba7f/uploads/origins/86223525-14bb-4ba5-9e46-32827e100f1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5035402c08510a0bafa2d9ac43d71b1", "srcset": "https://si.imgix.net/2311ba7f/uploads/origins/86223525-14bb-4ba5-9e46-32827e100f1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5035402c08510a0bafa2d9ac43d71b1, https://si.imgix.net/2311ba7f/uploads/origins/86223525-14bb-4ba5-9e46-32827e100f1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=29a738604f4027474bf16285b3e178a6 2x, https://si.imgix.n