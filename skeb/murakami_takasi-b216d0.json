8789b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db61ca144a3d61f559a98d32fd542e07", "srcset": "https://si.imgix.net/b8a74660/uploads/origins/bfc620dd-9a31-4ae4-b112-6f8848789b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db61ca144a3d61f559a98d32fd542e07, https://si.imgix.net/b8a74660/uploads/origins/bfc620dd-9a31-4ae4-b112-6f8848789b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b7019b3eba1d939672a86147a161ad8 2x, https://si.imgix.net/b8a74660/uploads/origins/bfc620dd-9a31-4ae4-b112-6f8848789b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c35ed335dc720155f273632645189896 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8a74660/uploads/origins/bfc620dd-9a31-4ae4-b112-6f8848789b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=259cf2d1db5a997aee7c083265d5b6f7", "srcset": "https://si.imgix.net/b8a74660/uploads/origins/bfc620dd-9a31-4ae4-b112-6f8848789b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=259cf2d1db5a997aee7c083265d5b6f7, https://si.imgix.net/b8a74660/uploads/origins/bfc620dd-9a31-4ae4-b112-6f8848789b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=408ebd9e9456ea6e035f5e70ad464be6 2x, https://si.imgix.net/b8a74660/uploads/origins/bfc620dd-9a31-4ae4-b112-6f8848789b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab3c82a148adfaeb19a44f2a92a52aad 3x"}, "body": "村上隆史先生、こんにちは！もうすぐクリスマスや年末年始の季節ということで（？）、可能でしたらまたコミックの作成をご検討頂きたいと思います。\n\nシチュエーションとしましては、奈奈姫様と紗夜ちゃんがドレス姿でお城のパーティを楽しんでいると、泥酔したうに君や配下が暴走してしまい…みたいな展開が希望です。紗夜ちゃんはどちらかというとアナル拡張の方がメインで、どこかのシーンでうに君の挿入した触手で服の上からでも腸の様子が分かるようなボコ腹の描写(触手姫3の12ページ左下のコマのような)を入れて頂けると助かります。そのまま口まで体内貫通して、さらにアナルを超拡張させるような展開にして頂けるととても嬉しいです!\n\n奈奈姫様は前後両穴の拡張がメインで、触手姫3ミノタウロスの逸物レベルの極太で両穴を同時に超拡張するような展開をご検討頂きたいと思います。また、子宮内や卵管までぽっかり見えるような構図も含めて頂けると仕事の励みになります！(なんでしたら3穴超拡張も大歓迎です！)\n\nまた出来ればですが、展開の途中まではある程度ドレス服を残したまま拡張して、必要に応じて途中から服にご退場頂くような流れで描写頂ければ最高です！\n\nこんなご時世ですので、先生の作品でしか味わえない可愛らしいキャラの景気のいい拡張っぷりを堪能したく、何卒ご検討をよろしくお願い申し上げます。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@murakami_takasi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2432014, "client_id": 408354, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2815b353/uploads/origins/e3833ae5-e5e4-4a63-bcff-01f332fb96ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5695e7f3c4e10c04beccd00d908652c5", "srcset": "https://si.imgix.net/2815b353/uploads/origins/e3833ae5-e5e4-4a63-bcff-01f332fb96ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5695e7f3c4e10c04beccd00d908652c5, https://si.imgix.net/2815b353/uploads/origins/e3833ae5-e5e4-4a63-bcff-01f332fb96ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff6ee8542344b04e3117e061a135431e 2x, https://si.imgix.net/2815b353/uploads/origins/e3833ae5-e5e4-4a63-bcff-01f332fb96ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04dc10562ea779cfae2818d5f9a52c0e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2815b353/uploads/origins/e3833ae5-e5e4-4a63-bcff-01f332fb96ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=482a5fbaca9488dac48ddf900e0c0b39", "srcset": "https://si.imgix.net/2815b353/uploads/origins/e3833ae5-e5e4-4a63-bcff-01f332fb96ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=482a5fbaca9488dac48ddf900e0c0b39, https://si.imgix.net/2815b353/uploads/origins/e3833ae5-e5e4-4a63-bcff-01f332fb96ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cf1e93703e171fd7b09eb35a88a2f500 2x, https://si.imgix.net/2815b353/uploads/origins/e3833ae5-e5e4-4a63-bcff-01f332fb96ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=37110e3e9d608294c41b70033a5c8b1f 3x"}, "body": "こんにちは！\n\n異種族レビュアーズからクリムとアロエの登場シーンをリクエストしたい。\n\nクリムは特別に大きなチンコを持ったフタナリ天使です。アロエは小柄で疲れた感じの妖精で、胸が大きい。小さすぎるにもかかわらず、アロエはクリムとのセックスに同意している。\n\nアロエはクリムのチンコの上に座り、不安そうな顔をする。クリムはアロエの脚をつかむと、力任せに彼女を引きずり下ろし、自分のペニスが彼女の中にすっぽり入ってしまう。アロエの腹は卑猥なまでに引き伸ばされる。クリムのペニスはアロエの体全体よりも大きいので、彼女ができるだけ引き伸ばされるようにする。アロエは最初ショックを受けるが、これだけ引き伸ばされているにもかかわらず、実はとても気持ちいいのだ。\n\nクリムは気が狂いそうになり、渾身の力でアロエの中に何度もペニスを叩き込み始める。やがて二人とも激しくイク。クリムはアロエの腹が大きく膨らむほど大量の精液を放出する。アロエは満足げで淫らな表情を浮かべている。二人とも大いに楽しんだようだ。\n\nありがとう！\n\nhttps://www.dropbox.com/sh/pgh2wz4vqvsm4w1/AACvKnGFCfP6YPvi0fCeZfTJa?dl=0", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@murakami_takasi/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2432014, "client_id": 103961, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/521e38e7/uploads/origins/b346f0b6-91b7-47ce-a6cc-a637e69ab14a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45fed50061f4d019b6886f824318ca9c", "srcset": "https://si.imgix.net/521e38e7/uploads/origins/b346f0b6-91b7-47ce-a6cc-a637e69ab14a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45fed50061f4d019b6886f824318ca9c, https://si.imgix.net/521e38e7/uploads/origins/b346f0b6-91b7-47ce-a6cc-a637e69ab14a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bce4314946469119447ec10d19ec6740 2x, https://si.imgix.net/521e38e7/uploads/origins/b346f0b6-91b7-47ce-a6cc-a637e69ab14a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10b506dd600a9cd5378964547a0be7d1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_url