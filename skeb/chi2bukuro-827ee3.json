=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8087ad5dae64f0dc279bc2084f08e066 2x, https://si.imgix.net/7f82f29c/uploads/origins/1f21c63d-03cd-49f9-b64c-f42cf8d82f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c74329d490a18927fb137a7adf19c121 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f82f29c/uploads/origins/1f21c63d-03cd-49f9-b64c-f42cf8d82f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8176eb0d788ad9ddb403bde46c54377d", "srcset": "https://si.imgix.net/7f82f29c/uploads/origins/1f21c63d-03cd-49f9-b64c-f42cf8d82f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8176eb0d788ad9ddb403bde46c54377d, https://si.imgix.net/7f82f29c/uploads/origins/1f21c63d-03cd-49f9-b64c-f42cf8d82f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6197b9329c4b66004621698d69eff5cd 2x, https://si.imgix.net/7f82f29c/uploads/origins/1f21c63d-03cd-49f9-b64c-f42cf8d82f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45dafd7bea7e8bec1bef74eee5d91175 3x"}, "body": "締め切り超過となりましたが、やはり千国さんの作品がぜひぜひ見たいのでので、改めて依頼させていただきます。お仕事やプライベートがご多用でしたら、ご無理なさらずに遠慮なくキャンセルしてください。（以下、同文）\n\nグラブルのジャンヌとグラン君の恋人セックス漫画（カラー、数ページ）が見たいです！\n\n・ジャンヌにはビキニの上下を着せてください。白百合の髪飾りやカチューシャ、ビキニの結び目なども描いてほしいのですが、剣を下げる腰のベルトは不要です。髪は結ばず、ほどかせてください（初めは結んでいて、あとでほどけるのはOK）。ジャンヌの指の爪・足の爪には（下記リンク先のように）紫色（ビキニと同じ色）のマニキュアを付けてください\nhttps://danbooru.donmai.us/posts/3052479?q=jeanne_d%27arc_%28granblue_fantasy%29\nhttps://danbooru.donmai.us/posts/3052480?q=jeanne_d%27arc_%28granblue_fantasy%29\n・ずらし挿入を基本にして、行為の途中でだんだんと脱げていく感じにしてください（ex. ブラジャー→ブラジャーからおっぱいがはみ出る→おっぱい丸出し）。片足パンツのようなシチュでも構いません。\n・グランは全裸で。全体的に筋肉質にしてください。二人の身長差・体格差をなるべく反映させてください。グランの表情も見えるようにしてください\n・場所はひと気のないビーチか、ホテルの一室で\n・互いの呼び方は「ジャンヌ」「グラン」（団長ではなく）に。二人とも初めて同士（童貞・処女）という感じで、初々しさを出してくださるとうれしいです（「団長」呼びの方がジャンヌらしい気もしますので、千国さんにお任せします。はじめは「団長」で、途中から「グラン」呼びになるとか？）\n\nよろしくお願いします！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chi2bukuro/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/01b3d8ba/uploads/origins/18c3dfea-4031-456e-8275-e1af6dd2d564?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c63c36aea526d30e6afab67d1231812", "srcset": "https://si.imgix.net/01b3d8ba/uploads/origins/18c3dfea-4031-456e-8275-e1af6dd2d564?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c63c36aea526d30e6afab67d1231812, https://si.imgix.net/01b3d8ba/uploads/origins/18c3dfea-4031-456e-8275-e1af6dd2d564?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ffe035c05479b719847868aec6992a8f 2x, https://si.imgix.net/01b3d8ba/uploads/origins/18c3dfea-4031-456e-8275-e1af6dd2d564?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53fc1b9cd6b595fb15aa49deda903c6d 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1540490, "nc": 161}, {"path": "/@chi2bukuro/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1540490, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/087d62cb/uploads/origins/47dd506a-7d9a-4e27-98f2-6d6ef028498b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de6763fc90a3d1e53b19633f24526ea0", "srcset": "https://si.imgix.net/087d62cb/uploads/origins/47dd506a-7d9a-4e27-98f2-6d6ef028498b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de6763fc90a3d1e53b19633f24526ea0, https://si.imgix.net/087d62cb/uploads/origins/47dd506a-7d9a-4e27-98f2-6d6ef028498b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ad2cd12211e7d083dc99299ea92b69e 2x, https://si.imgix.net/087d62cb/uploads/origins/47dd506a-7d9a-4e27-98f2-6d6ef028498b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16b47410405502b5cd448eda5f97242d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/087d62cb/uploads/origins/47dd506a-7d9a-4e27-98f2-6d6ef028498b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45ea6e4b2f31c78b18f3d8af3c2f3435", "srcset": "https://si.imgix.net/087d62cb/uploads/origins/47dd506a-7d9a-4e27-98f2-6d6ef028498b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45ea6e4b2f31c78b18f3d8af3c2f3435, https://si.imgix.net/087d62cb/uploads/origins/47dd506a-7d9a-4e27-98f2-6d6ef028498b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e74d698fe79e5fee054001abda2340ac 2x, https://si.imgix.net/087d62cb/uploads/origins/47dd506a-7d9a-4e27-98f2-6d6ef028498b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4336e2c4495258da5e4e256621050f5f 3x"}, "body": "期限切れとなりましたが、入院されていたということであらためてリクエストを送らせて頂きます。\nスケジュールや体調の関係でまだ作業が難しいようであれば遠慮なくキャンセルして下さい。\n\n企画モノのAVのようなシチュエーションで、\n下着姿になって二本の男性器を両手で扱いているグラブルのユイシスをお願いします。\n\n髪型などは風SSR準拠。\n表情は恥ずかしがりつつも微笑んでいるようなイメージです。\nプライバシーに配慮してユイシスの目元は黒線で隠してあげて下さい。\n下着のデザインや背景に関してはお任せで。\n手袋の有無はお好みで構いません。\n男性器は片方はズル剥けで立派なもの、片方は指で摘まれている短小包茎でお願いします。\n\n\n決戦！性の古戦場〜制限時間内に100人射精させたら賞金100万ルピ〜\n\n元ディートリア組構成員Yさん（21）\n\n「組を再興するために資金が必要で…」\n\n残り100人　制限時間01:59:59\n\nといったテロップをお願いします。（制限時間に関しては適当でOKです）\n\n目元の黒線のみ無しの差分、テロップと黒線の両方無しの差分、射精差分をPNGで頂けるとありがたいです。\n\nhttps://kikumarogaming.com/granbluefantasy-wind-ssr-17/", "nc": 176, "word_count": 0, "transco