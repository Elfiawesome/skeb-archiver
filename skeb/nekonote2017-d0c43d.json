=3&fit=crop&crop=top&w=200&h=200&s=f68845b7e423f291447e35f75ed311bf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5e72240/uploads/origins/40cf2a14-21c4-4e59-8711-7353faa38f00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0985a18db95f77d72069d748aba812f8", "srcset": "https://si.imgix.net/d5e72240/uploads/origins/40cf2a14-21c4-4e59-8711-7353faa38f00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0985a18db95f77d72069d748aba812f8, https://si.imgix.net/d5e72240/uploads/origins/40cf2a14-21c4-4e59-8711-7353faa38f00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5e6b5dccb918a2cd7dbfaafca1eed2d 2x, https://si.imgix.net/d5e72240/uploads/origins/40cf2a14-21c4-4e59-8711-7353faa38f00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b47d48372042bf3317f720f85824b9dd 3x"}, "body": "初めまして、リクエスト失礼します。\n先日描かれていた結城友奈は勇者であるの乃木園子がとても可愛かったので自分も園子をリクエストしたいと思います。\n服装はゆゆゆいのブリリアントサマーの水着で、岩陰で隠れて向かい合って、もしくはバックでしているイラストを描いて欲しいです。\n表情はとろけたような表情で、\nhttps://wikiwiki.jp/yusyadearu/ブリリアントサマー%20乃木園子\n水着のトップはずり上げられて胸が露出していると嬉しいです。\n御多用の中申し訳ございませんがご検討の程、よろしくお願い致します。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekonote2017/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 9004, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b7d6345/uploads/origins/6786ef7b-2734-4370-92f3-f273d1ddca59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17604f3a2a1e4503366db42a30981e45", "srcset": "https://si.imgix.net/7b7d6345/uploads/origins/6786ef7b-2734-4370-92f3-f273d1ddca59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17604f3a2a1e4503366db42a30981e45, https://si.imgix.net/7b7d6345/uploads/origins/67