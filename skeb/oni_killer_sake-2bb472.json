で「大人になったら結婚する！」と言い合っているような関係性です。\nさみしさの中に温かさがあるような、画像のような深い青の夜道を手を取り合って歩いているような構図だと嬉しいですが構図などはすべてお任せします！\n\nお忙しいところ恐縮ですが、是非描いて頂けたら嬉しいです。よろしくお願いします！\n\n金額が足りなければ再送おねがいします！\n\nhttps://drive.google.com/drive/folders/1QBg7Hu6wBpBzs49II7Lv4b3gZxYhbJ50?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oni_killer_sake/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1392509, "client_id": 1879638, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3fca5a9b/uploads/origins/fdb30970-0f88-4a10-812a-153097afe3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25a47ab33930a02cbf6d53439028fec2", "srcset": "https://si.imgix.net/3fca5a9b/uploads/origins/fdb30970-0f88-4a10-812a-153097afe3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25a47ab33930a02cbf6d53439028fec2, https://si.imgix.net/3fca5a9b/uploads/origins/fdb30970-0f88-4a10-812a-153097afe3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=016868a4a0a2aa63de86c3260497d597 2x, https://si.imgix.net/3fca5a9b/uploads/origins/fdb30970-0f88-4a10-812a-153097afe3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e99238fb3667e2d79ccddd107f21b258 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3fca5a9b/uploads/origins/fdb30970-0f88-4a10-812a-153097afe3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc64f15c0fa1f9c02d8c3b664c64c1af", "srcset": "https://si.imgix.net/3fca5a9b/uploads/origins/fdb30970-0f88-4a10-812a-153097afe3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc64f15c0fa1f9c02d8c3b664c64c1af, https://si.imgix.net/3fca5a9b/uploads/origins/fdb30970-0f88-4a10-812a-153097afe3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=