Vwt8xK7ZhLAIEeIjU?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@buttertorst/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 335964, "client_id": 3033136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31a47310/uploads/origins/f77d3f4a-e622-4907-9585-8eb29aaf79e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9931b001203faea707548e60145f09a5", "srcset": "https://si.imgix.net/31a47310/uploads/origins/f77d3f4a-e622-4907-9585-8eb29aaf79e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9931b001203faea707548e60145f09a5, https://si.imgix.net/31a47310/uploads/origins/f77d3f4a-e622-4907-9585-8eb29aaf79e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4e7b5b6f65cbe3463be035675495ace 2x, https://si.imgix.net/31a47310/uploads/origins/f77d3f4a-e622-4907-9585-8eb29aaf79e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9cab369d3a823c3f3b95a583cc13d369 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31a47310/uploads/origins/f77d3f4a-e622-4907-9585-8eb29aaf79e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c18bb2af36f824ffbd64987f78fa6bf5", "srcset": "https://si.imgix.net/31a47310/uploads/origins/f77d3f4a-e622-4907-9585-8eb29aaf79e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c18bb2af36f824ffbd64987f78fa6bf5, https://si.imgix.net/31a47310/uploads/origins/f77d3f4a-e622-4907-9585-8eb29aaf79e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dd623260a5cea5fb41e352723da61c48 2x, https://si.imgix.net/31a47310/uploads/origins/f77d3f4a-e622-4907-9585-8eb29aaf79e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=27142d7dfa1941c5935eafd86db97ed3 3x"}, "body": "先生、こんにちは、\n\n先生のイラストが大好きです！私のocを描いていただけたらとても嬉しいです。\n\n私のocは、角と長い巻き毛のある人間ではない女の子です。彼女の存在は人間の痛みに基づいており、「痛み」という概念そのものであるとも言えます。テーマは「血と肉の花」「痛み」「心の虜」。自由に描いてください！また、服装はシンプルな方がいいなら、調整しても構いません。\n\n彼女の詳しい外見は添付のリンクにあります。\n\nこのリクエストを読んでいただき、本当にありがとうございます。\n\nhttps://drive.google.com/drive/folders/1WvCC84lpiVWahpDmlE5elardOUwiE2Zt", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@buttertorst/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 335964, "client_id": 156214, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3d6c55f/uploads/origins/26b0a825-bc23-4ae4-9431-aa7c9e48fa69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d11c3e67f931d58943b567c8902f762c", "srcset": "https://si.imgix.net/f3d6c55f/uploads/origins/26b0a825-bc23-4ae4-9431-aa7c9e48fa69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d11c3e67f931d58943b567c8902f762c, https://si.imgix.net/f3d6c55f/uploads/origins/26b0a825-bc23-4ae4-9431-aa7c9e48fa69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a1861fc14c91865e55f3c75202c7c55 2x, https://si.imgix.net/f3d6c55f/uploads/origins/26b0a825-bc23-4ae4-9431-aa7c9e48fa69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86eb2d2997745ab193f20b2346cae7b9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3d6c55f/uploads/origins/26b0a825-bc23-4ae4-9431-aa7c9e48fa69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06f3618e97afb7ceb297cdfe927e032f", "srcset": "https://si.imgix.net/f3d6c55f/uploads/origins/26b0a825-bc23-4ae4-9431-aa7c9e48fa69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06f3618e97afb7ceb297cdfe927e032f, https://si.imgix.net/f3d6c55f/uploads/origins/26b0a825-bc23-4ae4-9431-aa7c9e48fa69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9169fdbae865b6efda6a141549c43cd3 2x, https://si.imgix.net/f3d6c55f/uploads/origins/26b0a825-bc23-4ae4-9431-aa7c9e48fa69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5e4364ebfd1a03da792509a6b73e80b1 3x"}, "body": "Reiuです…！依頼した曲と合わせて、個人観賞用のMVを作りたくてLard様にうちの子ヴァスカのイラストのリクエストを送らせていただきました。\n\n以前送った依頼文では大分丸投げしていたので、今回はもう少し詳しく指定などをしてみましたが、Lard様のセンスを全面的に信じているので、Lard様なりに解釈して絶対的なものとして扱わなくてもOKです。\n\nMVということなので可能でしたらアス比は16:9でお願いしたいです。曲含め、資料は最後のほうに置いてあります。\n\n今回お願いしたいのはヴァスカの幼年期の姿で、元の黒髪と純白な白髪という二つのバリエーションがあります。設定画や参考画像は最後に置いてある資料URLのほうにありますので、どちらでもLardさまのお好きなほうを1つお選びいただければ幸いです…！\n\n髪色以外にも違う点がいくつかあるので以下に纏めました。\n\n黒髪：人見知り、はにかみ屋、どこかぎこちない作り笑顔\n白髪：歳不相応の冷たい眼差し、無表情、笑わない\n\n白髪のほうは、自らの魔術の研究で体に影響を受けて変化しているという設定です。\nどちらも一見少年というよりは少女に見えるぐらいの中性的で儚げな印象が理想的です。\n\nシリアスな曲調のこの曲は、気弱そうな少年がある日を境に決心をして、策略を巡らせて若くして家督を握るというストーリーのクライマックスを締める1曲で、そういうドラマチックな雰囲気を意識していただけると幸いです。\n\n長い髪は水の流れをイメージしていて、流れるように髪をなびかせていただけると大変嬉しいです。\nポージング・構図は一切お任せいたします。\nただ、水の魔術（忘却の水）を使う子なので水を構図に入れてもらえたら嬉しいです。（必須ではない）\n\n衣装にあるケープは締めていただいても締めなくてもOKです。\nまた、衣装アレンジや簡略化も○\n\n長々と細かく書いてしまい失礼いたしました。ご自由に描いてくだされば嬉しい限りです。\nお手すきの際にどうぞご検討のほどよろしくお願い致します…！\n\nhttps://drive.google.com/drive/folders/1d2j5QupRs9cb--jGp7hkpaT52C1HybRr?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@buttertorst/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/efd76ef1/uploads/origins/afb5c8eb-f85e-4f55-a7a0-f0fa3634632a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3cfb3877b36015370ffac4fa33418d45", "srcset": "https://si.imgix.net/efd76ef1/uploads/origins/afb5c8eb-f85e-4f55-a7a0-f0fa3634632a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200