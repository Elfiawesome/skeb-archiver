a7b3bfc-2b0a-4b94-b60d-1ca22bb8fc2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f9f84110ead17c5ecf852596094747e, https://si.imgix.net/446a67e0/uploads/origins/aa7b3bfc-2b0a-4b94-b60d-1ca22bb8fc2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60caf2aa9920fa4f3b270fb273811090 2x, https://si.imgix.net/446a67e0/uploads/origins/aa7b3bfc-2b0a-4b94-b60d-1ca22bb8fc2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7fed7e1610d19d68ba08eb5274f70d4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/446a67e0/uploads/origins/aa7b3bfc-2b0a-4b94-b60d-1ca22bb8fc2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65511b0ee05bb90f3d64ecf451219043", "srcset": "https://si.imgix.net/446a67e0/uploads/origins/aa7b3bfc-2b0a-4b94-b60d-1ca22bb8fc2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65511b0ee05bb90f3d64ecf451219043, https://si.imgix.net/446a67e0/uploads/origins/aa7b3bfc-2b0a-4b94-b60d-1ca22bb8fc2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bfd78425b5c6582608ab5504baa07a22 2x, https://si.imgix.net/446a67e0/uploads/origins/aa7b3bfc-2b0a-4b94-b60d-1ca22bb8fc2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fdeded36087fbd320a267d731ea80cc0 3x"}, "body": "過融解様初めまして。先日、Xにて過融解様のイラストを見つけて、暗めの雰囲気のイラストがとても素敵だったのでリクエストを送らせていただきました。不備な点などありましたらキャンセルしていただいて大丈夫です！\n\n◼️使用用途◼️\n個人利用（壁紙など）\n\n◼️画像比率◼️\nできれば16:9の横画面の比率にしていただけると嬉しいです。\n\n◼️キャラクター◼️\n添付ファイルには二人のキャラクターが載せてあるのですが、「寄星くん」の方を描いていただきたいです！（赤髪の男の子です。）\n以下に簡単なキャラ紹介を書いておきます。よければ参考にしてください！\n忘れられがちなので伝えておくと、このキャラクターは右目にのみハイライトがあります。\n\n◼️キャラクター詳細◼️\n・16歳\n・元気すぎる天才発明家\n・過去に友達に勝手に発明品を触られて思わず手にかけてしまった過去がある。\n・悲しいや怒りのようなマイナス感情が抜け落ちている\n・そのため、怒りなどを感じる場面では無表情になりがち\n・右目が義眼\n・発明をすること以外何も興味がない\n\n◼️構図など◼️\n背景や構図は基本的にお任せいたします！\nキャラクターはいつもゴー