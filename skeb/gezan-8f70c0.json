ody": "こんにちは。\nシノビガミのセッションで使用する立ち絵をお願いしたいです。\n\n20代前半くらいに見える男性で、黒髪に灰色の目をしています。容姿、髪型は資料1をご参照ください。\nすらりとした長身で細身、両手は資料2のような義手です。\n資料3のようなテイストの中華風の服装に、白衣を肩から落とす感じで羽織っています。\n内面は、性格が悪く狂気的ですが、表情と感情表現が豊かでぱっと見には魅力的な人間に見えます。\n\n表情差分は、無表情、微笑、破顔、怒り、嘘泣き、驚き、照れ、ぐぬぬ……、嘲笑、てへぺろ、といったものを希望します。\n\n記載のない部分についてはおまかせしたいです。\nご検討よろしくお願いいたします。\n\nキャラクターシート（秘匿情報閲覧パスを設定していませんので、ご注意ください）\nhttps://character-sheets.appspot.com/shinobigami/edit.html?key=ahVzfmNoYXJhY3Rlci1zaGVldHMtbXByFwsSDUNoYXJhY3RlckRhdGEY6-yxhwUM\n\nhttps://www.dropbox.com/sh/ngb5rtr9eev93hg/AAB1b9RmkulKT2bWtUNBEOfba?dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@9mork/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 40981, "client_id": 2645591, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/017372ec/uploads/origins/b968d873-0b29-465c-a67f-df58b34b577f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50c971ea5c180ef0e681bb2a279f03dd", "srcset": "https://si.imgix.net/017372ec/uploads/origins/b968d873-0b29-465c-a67f-df58b34b577f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50c971ea5c180ef0e681bb2a279f03dd, https://si.imgix.net/017372ec/uploads/origins/b968d873-0b29-465c-a67f-df58b34b577f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e17a15088bcd6525db84c08a1f0ae0b 2x, https://si.imgix.net/017372ec/uploads/origins/b968d873-0b29-465c-a67f-df58b34b577f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b59eccbe56faa764eb91521ea382160b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/017372ec/uploads/origins/b968d873-0b29-465c-a67f-df58b34b577f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f8f64be324f78fdf7a9ef8254b01dd4", "srcset": "https://si.imgix.