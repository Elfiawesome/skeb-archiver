19ee-4939-bce8-20bdadf2cd7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c074a7b76d47235cbba344bb24108d74 2x, https://si.imgix.net/6bd0562f/uploads/origins/3527cfe2-19ee-4939-bce8-20bdadf2cd7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bda5e92b2e14e1e2b3b48f6d0a19bdc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6bd0562f/uploads/origins/3527cfe2-19ee-4939-bce8-20bdadf2cd7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f3dc212d0e3551959223fd8e22a2e48", "srcset": "https://si.imgix.net/6bd0562f/uploads/origins/3527cfe2-19ee-4939-bce8-20bdadf2cd7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f3dc212d0e3551959223fd8e22a2e48, https://si.imgix.net/6bd0562f/uploads/origins/3527cfe2-19ee-4939-bce8-20bdadf2cd7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c51156e7a0e17c1dcdce036e3a07f63 2x, https://si.imgix.net/6bd0562f/uploads/origins/3527cfe2-19ee-4939-bce8-20bdadf2cd7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=38a0d0c97b3c0042c4201bc54dfdebcb 3x"}, "body": "はじめまして、火鼠ヒノと申します。\nルジエ様のイラストがとてもかわいかったので、\nぜひオリジナルキャラクターの恋火ちゃんを描いていただきたいと思い依頼いたします。\n\n■雰囲気\nゆめかわいい感じでお願いいたします。\nヤンデレっこなので病んでいる（でも笑顔）と嬉しいです。\n構図の指定などはありませんが、お顔がよく見えると嬉しいです。\n\n■服装\n可能であれば、新規にデザインをしていただけないでしょうか。\n赤いお洋服が多いので、赤い色以外がメインのゆめかわいいお洋服だと嬉しいです。\n髪型も自由にアレンジしていただけると嬉しいです。\n\n■小物等\nうさぎ年なのでどこかにうさぎ要素を入れていただけないでしょうか。\n\nスマホの背景に使用させていただければと考えておりますので、縦長画像だと嬉しいです。\n要望が多くなりまして申し訳ございません。\n納品はいつまでも待てますのでゆっくり描いていただいて問題ないです！\nご縁がありましたらよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1pQs-82t8zleqHDioUOPBgCB3fz_HKGf8?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bisvv/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", 