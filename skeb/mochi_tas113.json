/origins/3af9e8c7-f1c8-43aa-ad50-ed2e2da374fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f9837165acf3cf68bdced8b9e297efd", "src_set": ""}, "body": "初めまして、Vtuber・singerの月城アオイと申します。\n\n餡ころ餅様が描かれるイラストの色使いや表情がとっても好みだったので、ぜひ私も描いていただきたいと思い依頼させていただきました。\n\n▽使用用途\n・YouTube、twitter、FANBOXなど各SNS\n・プロモーション活動に使用させていただきたいです\n\n▽イラストについて\n・主に歌枠のサムネで使用予定なので、それに合うものだと嬉しいです(構図などはおまかせします)\n・頭のてっぺんまでキャンバス内に入れていただけると有難いです\n\n▽人物について（人間とヴァンパイアのハーフです）\n・左目の下に涙ぼくろ\n・瞳は赤色\n・左右に牙があります\n・髪は全体白で、右前髪に夜空をイメージしたカラーのメッシュとインナーカラーが入ってます（青グラデに白の点描）\n・髪の毛で隠れていますが、黒い羽があります\nhttps://drive.google.com/file/d/12U9ud7wZ4Kj9QnyN554k2eM3E3hFzDy2/view?usp=drivesdk\n\n▽その他\n・背景がある場合は人物とレイヤーを分けていただきたいです。\n・アスペクト比9：16で作成お願いします。（縦イラスト希望）\n・納品形式はPSDファイルですと有難いです。\n\n▽各種リンク\ntwitter：https://twitter.com/Aoi_Tsukishiro\nyoutube：https://www.youtube.com/channel/UCU_xRFdTRIneHBBAgNhSNaw\n\n\n長々と申し訳ございませんが、ご確認いただけますと幸いです。\nどうぞよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mochi_tas113/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/56b0b1ab/uploads/origins/b3cc4f3c-591d-45e3-8b24-c35e46ff2ac4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17e570830b07498cf1ab647d97e95623", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1516728, "client_id": 1083871, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@mochi_tas113/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1516728, "client_id": 1728414, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec628e51/uploads/origi