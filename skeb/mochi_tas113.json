0505/uploads/origins/9b58ee9d-5dba-42f6-9942-5de2626d43fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=279121660f2916b135681d95e80242b7", "src_set": ""}, "body": "初めまして、餡ころ餅様。\n個人Vtuberをしています天凪シーヴァと言います。\n餡ころ餅様の素敵なイラストを拝見し、是非書いていただきたいと思いリクエストさせてもらいました。\n\nポーズや表情はおまかせでお願いします。\n\n使用用途してはサムネ等に使用する予定です。\nもし可能でしたらPSDファイルで納品していただけると助かります。\nご縁があればよろしくお願いいたします。\n\nイラスト\nhttps://1drv.ms/i/c/3f2ceeba6a0f0f4d/ESPNrBk7gSJMlVobMh4YFUcBF00ez6D_b2C-7k-CbsguuQ?e=fvdTm9", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mochi_tas113/works/41", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2652d5bc/uploads/origins/0a7c6897-cb74-4b13-abcc-bd3d76b26607?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b118f0b8eb5b04f2c69c4bc55dae8c7", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1516728, "client_id": 1967728, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@mochi_tas113/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1516728, "client_id": 107110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/caf9d41a/uploads/origins/adbb6bce-a54d-4bc8-90dc-82e175d81100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07ff18123ad8d53c2bdae084c2f126af", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/caf9d41a/uploads/origins/adbb6bce-a54d-4bc8-90dc-82e175d81100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b850d4c34a02e39d9e4a