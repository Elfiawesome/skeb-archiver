fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c91952d2861028cf2d9a6782988e7234", "src_set": ""}, "body": "Misskey.ioでいつもお世話になっております。\n湯乃ちゃんの絵文字きっかけで知りましたが、かわいくて便利な絵文字なのでよく使わせていただいてます。\n\n依頼の内容ですが、オリジナルキャラクターの椎木しいな（しいのき　しいな）をお願いします。\nジャケットを脱いだ状態でうつぶせになり、マッサージを受けて気持ち良さそうにしているところをお願いします。\n細かい部分はお任せします。\n使用用途は、ホームページで紹介する予定です。\nご検討のほどよろしくお願いします。\n\nhttps://hakomonogatari.pages.dev/characters/ec/", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mndrop/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 563518, "client_id": 1410295, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0bf87ac/uploads/origins/cd1cb3ec-8fe9-483f-9db1-7e9c97ae9661?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb9b29d14c00bbe785223bf96d069f03", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0bf87ac/uploads/origins/cd1cb3ec-8fe9-483f-9db1-7e9c97ae9661?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=910461a4a3bee924ae3b8d45618a59d3", "src_set": ""}, "body": "はじめまして。ゆのくにゆのさんのイラストの表情が可愛くてがとても好みです。\nリクエストをさせていただきます。\n都合や内容が合わなければキャンセルしてください。\n\nリクエストの内容としましては\n・キャラクター:私のオリジナルキャラクターであるうちのこ｢めろんちゃん｣\n・表情、性格:恥ずかしがり屋。照れを前面に出してほしいです。\n参照URL:https://www.pixiv.net/artworks/114213627\n(R18)https://www.pixiv.net/artworks/114374732\n\n・シチュエーション:背面駅弁。プリクラを撮りながらハメ撮りH。もしくは事後の写真風。\n\n・髪型、服装:参照URLを参考にしてほしいです。\n参照URL:https://misskey.io/notes/a5uvjfz2o2ey08bf\n(わからない部分など解釈による変更、アレンジの問題はありません)\n(下着を着せる際、自由にデザインし直してください)", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mndrop/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 563518, "client_id": 347662, "vtt_url": null, "thumbnail_image_urls":