べている。腕は後ろで組んでいる\n\n\n1枚絵ではなく、バストアップなどでも構いません。ここに書かれていないことは全ておまかせします！\nどうしてもキャラデザになってしまうのですが、どうかお気軽に考えていただけると嬉しいです。\n資料もなく、お粗末な依頼書としか言いようがないのですが、ぜひご検討して頂けたらと思います！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__Limi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 686585, "client_id": 1166827, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2217ef8f/uploads/origins/4d34e3c0-805e-44d0-90e7-af0da76890d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf70e64039784f43db7c49d08a228867", "srcset": "https://si.imgix.net/2217ef8f/uploads/origins/4d34e3c0-805e-44d0-90e7-af0da76890d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf70e64039784f43db7c49d08a228867, https://si.imgix.net/2217ef8f/uploads/origins/4d34e3c0-805e-44d0-90e7-af0da76890d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9215ff16475a2c3ec5fb4c2d1d5727ee 2x, https://si.imgix.net/2217ef8f/uploads/origins/4d34e3c0-805e-44d0-90e7-af0da76890d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=387b8743b382f57ea7a33e6e0dbb1d46 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2217ef8f/uploads/origins/4d34e3c0-805e-44d0-90e7-af0da76890d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e6c8af05c57965104fd1d0cb916964c", "srcset": "https://si.imgix.net/2217ef8f/uploads/origins/4d34e3c0-805e-44d0-90e7-af0da76890d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e6c8af05c57965104fd1d0cb916964c, https://si.imgix.net/2217ef8f/uploads/origins/4d34e3c0-805e-44d0-90e7-af0da76890d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=57102ff681efe69603faf2bbfbc1b947 2x, https://si.imgix.net/2217ef8f/