4-cfe3-4bd6-81db-731fd3e8557c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1698b163513fd6de72c6638f0a48c5d2 3x"}, "body": "はじめまして\nTwitterやPixivにアップされている作品を拝見し、描いていただきたくリクエストさせていただきます\n資料URLにあるDQ10のマイキャラのイラストをお願いします。\n（マイキャラは過去に少年ジャンプで連載されていた「キャッツアイ」の瞳のコスプレをDQ10のゲーム内の装備品を組み合わせて再現したものです）\n背景なしで、ポーズはお任せします\nDQ10は未プレイとプロフィールにあったので、やりづらいリクエストかもしれませんがよろしくお願いします\n\nhttps://twitter.com/Olyharcon700/status/1564242629121830913", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amesi_su/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1918099, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca533f54/uploads/origins/881b4668-d3c4-406f-82c5-16fc4af21f7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff8c7fd8ccd4f305c1b27416c4ea1bd0", "srcset": "https://si.imgix.net/ca533f54/uploads/origins/881b4668-d3c4-406f-82c5-16fc4af21f7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff8c7fd8ccd4f305c1b27416c4ea1bd0, https://si.imgix.net/ca533f54/uploads/origins/881b4668-d3c4-406f-82c5-16fc4af21f7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0e14a376ba93b7f131196acacb8cae1 2x, https://si.imgix.net/ca533f54/uploads/origins/881b4668-d3c4-406f-82c5-16fc4af21f7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6307cb7af565829b3f9d404ba8b68898 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca533f54/uploads/origins/881b4668-d3c4-406f-82c5-16fc4af21f7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=616525680ebdb3ee93d875dc3f6ed3c5", "srcset": "https://si.imgix.net/ca533f54/uploads/origins/881b4668-d3c4-406f-82c5-16fc4af21f7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=616525680ebdb3ee93d875dc3f6ed3c5, https://si.imgix.net/ca533f54/uploads/origins/881b4668-d3c4-406f-82c5-16fc4af21f7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=51e1ece14936d8006944f41250767c8c 2x, https://si.imgix.net/ca533f54/uploads/origins/881b4668-d3c4-406f-82c5-16fc4af21f7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d6ebe69e43b041565f33497ae4e3a5b2 3x"}, "body": "リピーターですみません。すしめさんの描くゼシカやバーバラが大好きなので、ぜひクロスオーバーのイラストを描いてほしいです…！\n\n内容は、お泊まり会で、自分の二の腕の贅肉をつまみながら、余計な肉がないバーバラを羨むゼシカと、これまで褒められ慣れていなくて、照れ笑いするしかできないバーバラが見たいです。\n髪色や胸の大きさは似てるけど、体つきは、ゼシカは太め、バーバラは細めみたいな感じで対比させてほしいです。\n服装は、ゼシカの方は胸元がちら見えしそうな緩めのネグリジェで、全体的にだらしない感じの着こなし、バーバラの方は明るい色合いで幼めのタンクトップ姿で、健康的な感じをお願いしたいです。\n\n好きなキャラシチュで、すしめさんの新作絵を見てみたいです、何卒よろしくお願いします…！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amesi_su/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1918099, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7cf824d/uploads/origins/acad1a35-0b5a-49fa-b1ff-d411d08b4747?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78279c4bd1d460261e5d0d73b37085ed", "srcset": "https://si.imgix.net/b7cf824d/uploads/origins/acad1a35-0b5a-49fa-b1ff-d411d08b4747?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78279c4bd1d460261e5d0d73b37085ed, https://si.imgix.net/b7cf824d/uploads/origins/acad1a35-0b5a-49fa-b1ff-d411d08b4747?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=603bfe88d13816c3967e665229139baa 2x, https://si.imgix.net/b7cf824d/uploads/origins/acad1a35-0b5a-49fa-b1ff-d411d08b4747?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07736ec1d6a3abe689ed9107f6943754 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7cf824d/uploads/origins/acad1a35-0b5a-49fa-b1ff-d411d08b4747?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8138974f609774b6a0ecb147f4c7c498", "srcset": "https://si.imgix.net/b7cf824d/uploads/origins/acad1a35-0b5a-49fa-b1ff-d411d08b4747?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8138974f609774b6a0ecb147f4c7c498, https://si.imgix.net/b7cf824d/uploads/origins/acad1a35-0b5a-49fa-b1ff-d411d08b4747?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e19ca8f47565b295aafede325696fcb 2x, https://si.imgix.net/b7cf824d/uploads/origins/acad1a35-0b5a-49fa-b1ff-d411d08b4747?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=872307c72f2dc1e1115c78c6bed12b5b 3x"}, "body": "先日はゼシカのイラストを引き受けてくださりありがとうございました。\nしかも2枚も描いてくださって本当に嬉しかったです。\nやっぱりすしめさんのイラストは最高だと思った2枚でした。\n\n　前回が非常に良かったので、すごく図々しいのですが、最後にもう一回、別のポーズでゼシカをお願いできないでしょうか。\n\n　今回は斜め後ろ〜やや横くらいの角度から見たイラストで、こちらに見返り？振り返っている？感じをリクエストしたいです。\n服装は前回と同じでお願いします。\n肌の質感がとても好きなので、今回もがばっと開いた背中部分や、肉付きの良い腕、脇などをすしめさんらしく描いていただきたいです。\n表情は、前回のが良かったので、前回をベースに少し甘い感じの表情か、すしめさんの好きなように描いていただけたら嬉しいです。\n\n　どうかご検討のほどよろしくお願いします。また、これからも陰ながら応援しています。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amesi_su/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1918099, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b05e1396/uploads/origins/ca3404d5-bb39-4e90-99c5-03e765c219ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e21c5c3eaab9909425077bd01e8211f4", "srcset": "https://si.imgix.net/b05e1396/uploads/origins/ca3404d5-bb39-4e90-99c5-03e765c219ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e21c5c3eaab9909425077bd01e8211f4, https://si.imgix.net/b05e1396/uploads/origins/ca3404d5-bb39-4e90-99c5-03e765c219ac?bg=%23fff&aut