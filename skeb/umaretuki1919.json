eptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": true, "total_appeals_count": 2, "received_works": [{"path": "/@umaretuki1919/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3158644, "client_id": 420912, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c9e5ba6/uploads/origins/34724200-0935-4afb-9c27-ba486ddeff83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7361b6b580b1ab36bce0832b227eb7b1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c9e5ba6/uploads/origins/34724200-0935-4afb-9c27-ba486ddeff83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=860a9f5500a212d72878ce54252aa517", "src_set": ""}, "body": "はじめまして。素敵な丸顔人外キャラを沢山描かれていらっしゃるようで、\n私の代理キャラもぜひ描いてほしいと思いリクエストさせていただきます。\n\n内容としては、キャラが2~3種類ほどポーズ取っているのを1枚絵に収める感じでお願いしたいです。\n(収まりにくかったら個別にして大丈夫です)\nポーズはクリエイター様のお任せでお願いします。動的でも静的でもどちらでも構いません。\n\nhttps://drive.google.com/drive/folders/1XYyuqRz_Sk4nZ9Kdcvtr0y793ZOpje95?usp=sharing\n\nhttps://drive.google.com/drive/folders/1XYyuqRz_Sk4nZ9Kdcvtr0y793ZOpje95?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umaretuki1919/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3158644, "client_id": 2662286, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44b813fe/uploads/origins/acc23988-199f-4428-ab56-fce0fd0a1855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0de257eba86ad7fc0e554ad942afc38", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44b813fe/uploads/origins/acc23988-199f-4428-ab56-fce0fd0a1855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c59ca387f60b179853e26dc233be1f57", "src_set": ""}, "body": "自創作キャラのチョコのイラストをお願いします🙏特にシチュエーションに希望は無いですが、表情など明るい雰囲気であれば嬉しいです。青ハムさんの色使いなどとても好きなので、青ハムさんの絵柄全開でお願い致します！\n\nhttps://drive.google.com/file/d/1_iUyYl4EzpY3qa1j6qRyVbjU1jIttTOA/view?usp=drivesdk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umaretuki1919/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3158644, "client_id": 2574486, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60db21f2/uploads/origins/895b1d48-8c81-4178-8a7b-6a0bf012180e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56c28d7a5533115d7d5adaefef150938", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/60db21f2/uploads/origins/895b1d48-8c81-4178-8a7b-6a0bf012180e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97aabede54e3aeeb46f3240d861c5cac", "src_set": ""}, "body": "初めまして!\nオリキャラの市さんを描いて欲しいです。\n設定は普段着、帽子を脱いで、裸足で、ベッドに仰向けに倒れ込むイラストをお願いします。\n\nhttps://uchinokozukanstg.azurewebsites.net/Uchinoko/Detail?UchinokoId=b7e2065f-e0a6-49fe-05dc-08dc5ec8d586", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umaretuki1919/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3158644, "client_id": 850389, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d1a21dc/uploads/origins/80974a32-a1d3-4fe8-8f23-8c618b134d04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c48a4136cf54a7313048a4ed87985c31", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d1a21dc/uploads/origins/80974a32-a1d3-4fe8-8f23-8c618b134d04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4204cae99da37785ebc720340c4c8c4d", "src_set": ""}, "body": "こちらでは初めまして、夢來 怜と申します。\nアピールありがとうございます。\n描いてほしいうちの子の資料が出来ましたのでリクエストをさせていただきます。\n描いてほしいうちの子は【リヨン】と【ルメリカ】という少女２人です。\n資料はURLにて添付させていただきます。\n2人は友達以上恋人未満の関係です。\n\n使用用途は個人観賞です。\nイラストのサイズ・構図などは青色さんのご自由にしていただいてかまいません。\nお気に入りの２人を、青色さんの可愛い絵柄で見てみたいのです…！\nご検討のほどをよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/13dfDss_4s1VViQGpUgYRyX4FQVkm5Cod?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umaretuki1919/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3158644, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24e71a42/uploads/origins/c5a45178-3c4e-4111-b010-5c93a06d0fd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3bcea25380eb76b6e58ab9bd6ec6a037", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24e71a42/uploads/origins/c5a45178-3c4e-4111-b010-5c93a06d0fd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=abbba9b21e8ff971d9402151280f7e04", "src_set": ""}, "body": "はじめまして、イラストが好みなのでファンアートを描いて欲しいなと思いました\nVtuberの時雨ミトさんです\nhttps://images.app.goo.gl/7J3QDEq1zN3rvoiHA\nhttps://images.app.goo.gl/6kHGHeu3Tq4RRaWR8エルフみたいにしてほしいです\n\n\n宜しければお願い致します\n\nhttps://medium.com/skeb-jp/ugc-program-titles-c3de542def31", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umaretuki1919/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3158644, "client_id": 308562, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/400564c1/uploads/origins/a2a68f9e-5826-4f1a-8576-05320102c56e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=t