はどちらでも大丈夫です！)\n2人が仲良くしているところというよりは、こちら側(画面側)に意識を向けている感じだと嬉しいです…！\n細かい構図や表情はお任せします！！ここまるSICさんのお好きなように描いていただけたら嬉しいです…！\n\n\nご検討いただけましたら幸いです。何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1v05feDiwCrJnAC92R-C4ssy7LOARRYA-", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sic_sic_sic_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3756816, "client_id": 2694563, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1cc8a260/uploads/origins/2165afe6-0e11-45df-92fe-3e849c4fe2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d58ab6c56461ed72b8ad4adaf196a484", "srcset": "https://si.imgix.net/1cc8a260/uploads/origins/2165afe6-0e11-45df-92fe-3e849c4fe2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d58ab6c56461ed72b8ad4adaf196a484, https://si.imgix.net/1cc8a260/uploads/origins/2165afe6-0e11-45df-92fe-3e849c4fe2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a806ebfe4b08304fc40eb44e00f81c6 2x, https://si.imgix.net/1cc8a260/uploads/origins/2165afe6-0e11-45df-92fe-3e849c4fe2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7751099915cd7a9e3b99370adfac27a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1cc8a260/uploads/origins/2165afe6-0e11-45df-92fe-3e849c4fe2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f917eda84f0a0f53a4c31931d3a659b0", "srcset": "https://si.imgix.net/1cc8a260/uploads/origins/2165afe6-0e11-45df-92fe-3e849c4fe2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f917eda84f0a0f53a4c31931d3a659b0, https://si.imgix.net/1cc8a260/uploads/origins/2165afe6-0e11-45df-92fe-3e849c4fe2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blu