ff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=31101dcdf8d2b977577da24f7d32fd52 3x"}, "body": "初めまして！\n\nハルタスク様のイラストを拝見し依頼受付の再開を心待ちにしておりました！！是非よろしくお願いいたします。\n\n●描いて頂きたいのは私のVモデルです。\nhttps://drive.google.com/file/d/1O2PWYYPoyeV2OmqsXPCfS1Ql4KI5vaZ3/view?usp=drivesdk\n\nとろっとした眠そうな目のうさぎの女の子\n髪の毛は薄いサーモンピンク\n陰キャコミュ障\n\n●ポーズ、衣装はお任せいたします！\nナツメ・アリーさんやネクラさんのイラストに一目惚れしたので、似た雰囲気で描いて頂けると嬉しいです。\nモデルの等身はちいさめですが、普通の人と同じ等身希望です。\n\n●使用用途\nサムネイルやsns、配信素材\n\n●背景透過分も頂けるとありがたいです。\n\nつたない文章で大変失礼致しました。どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1v35ogOBdnWZ3YaUPL0LjIfcDeF5aNWpy", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@emo863063/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 110970, "client_id": 2259817, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/77c342d3/uploads/origins/720ca855-2100-47c6-82e3-910b0374758f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=484c438cd8f50a831ced5cc6353ca469", "srcset": "https://si.imgix.net/77c342d3/uploads/origins/720ca855-2100-47c6-82e3-910b0374758f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=484c438cd8f50a831ced5cc6353ca469, https://si.imgix.net/77c342d3/uploads/origins/720ca855-2100-47c6-82e3-910b0374758f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bddcb4d2e9fc7481c48a1af75d699d5 2x, https://si.imgix.net/77c342d3/uploads/origins/720ca855-2100-47c6-82e3-910b0374758f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=acea7c3d1a503b2a59dc84ee92409450 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/77c342d3/uploads/origins/720ca855-2100-47c6-82e3-910b0374758f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8786a1d1a469e6c50a5f0484c032a6f8", "srcset": "https://si.imgix.net/77c342d3/uploads/origins/720ca855-2100-47c6-82e3-910b0374758f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8786a1d1a469e6c50a5f0484c032a6f8, https://si.imgix.net/77c342d3/uploads/origins/720ca855-2100-47c6-82e3-910b0374758f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d37983dc4c8363e3375d1b976697b256 2x, https://si.imgix.net/77c342d3/uploads/origins/720ca855-2100-47c6-82e3-910b0374758f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f190beee5b2d0b19a224cba1a8751382 3x"}, "body": "ハルタスク先生、初めまして。スタークのイラストを見ました。驚きました!!!\n\n私の（VTUBER）オリジナルキャラクターを描いていただきたいです。\n\n「魂に呼びかける共鳴を持つ、るなは『魂の植物学者』です。\n命と死の微妙なバランスを紡ぐ手で、彼女は優しいタッチで魂の最後の瞬間をキュレートし、穏やかな百合を遺してその存在を証明します。彼女の存在は、安らかで謎めいたものであり、冥界と生者の領域を結ぶ存在です。」\n\n\n・異世界（RPG）\n・死の天使\n・昼は植物学者、夜は黒魔術師です。\n・エレメントとして白百合、魔法使い、夜\n・背景の風景とポーズについては、先生の想像にお任せします。\n・「フリーレン」アニメのような感じにしてほしいです！\n・多分→呪文を唱えるかな？\n・ほぼ全身/全身イラストをお願いします!!\n\n*（？）任意→私のマスコット猫（リン）も入れて欲しいです。\n\n個性：優美、優しい、かっこいい、感情がない\nポイント: 猫耳は下向きです。\nほくろが2つあります。\n\n\n参考フォルダ：https://drive.google.com/drive/folders/1ocVWJdfEP2Ribl64VOU_tp8uaJvQdIlY?usp=drive_link\n起源（オリジン）ビデオ:  https://www.youtube.com/watch?v=A_i_fpWUuCc\n⁂PSDとPNGファイルでお願いします。\n\nでは、よろしくお願いいたします！！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@emo863063/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 110970, "client_id": 2175655, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/124986f6/uploads/origins/1fc195ef-d735-439b-bf45-b176182d9b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f36e4eab16a63aa60454bbaa5b2bbf0b", "srcset": "https://si.imgix.net/124986f6/uploads/origins/1fc195ef-d735-439b-bf45-b176182d9b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f36e4eab16a63aa60454bbaa5b2bbf0b, 