0&h=200&blur=200&s=85c7a0274d00d84d44e6c03d5419a671 3x"}, "body": "Magic the Gathering で使用する騎士トークンカードのイラストを作成して欲しい\n納品されたイラストを自分で使う分だけ印刷する予定です\n\n以下お願いしたい項目です\n・カードとして印刷する前提のイラスト\n・カードイラストが「騎士」だとわかるようなイラスト\n　・かわいい女の子であれば大丈夫です\n・イラスト中に「騎士」「2/2」を入れてください\n　・いくつか例示します\n　　・https://val-hobby.online/wp-content/uploads/2020/09/2020-09-28_Gnd%E3%83%88%E3%83%BC%E3%82%AF%E3%83%B3.jpg\n　　・https://www.enndalgames.com/contents/ex/img/items/token/shiroyama/angel.png", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u9ffo/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2162412, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e85fda53/uploads/origins/b0fcc28f-c5ba-4be6-9a96-3cc1f1e22b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efe2481c400ecf384f1dc63bca684996", "srcset": "https://si.imgix.net/e85fda53/uploads/origins/b0fcc28f-c5ba-4be6-9a96-3cc1f1e22b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efe2481c400ecf384f1dc63bca684996, https://si.imgix.net/e85fda53/uploads/origins/b0fcc28f-c5ba-4be6-9a96-3cc1f1e22b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21d9a8aa76a20f0ad4f59f4c4afe6045 2x, https://si.imgix.net/e85fda53/uploads/origins/b0fcc28f-c5ba-4be6-9a96-3cc1f1e22b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66ffc95b742cc8d4c0d52a2ce9ec88c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e85fda53/uploads/origins/b0fcc28f-c5ba-4be6-9a96-3cc1f1e22b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=326c3735e450773f52da30382cbbbce1", "srcset": "https://si.imgix.net/e85fda53/uploads/origins/b0fcc28f-c5ba-4be6-9a96-3cc1f1e22b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=326c3735e450773f52da30382cbbbce1, https://si.imgix.net/e85fda53/uploads/origins/b0fcc28f-c5ba-4be6-9a96-3cc1f1e22b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0d52ed44aa88505fec2ffb78471905e2 2x, https://si.imgix.net/e85fda53/uploads/origins/b0fcc28f-c5ba-4be6-9a96-3cc1f1e22b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=156a3879c8afa3fdbe5b43d08b175738 3x"}, "body": "初めまして、個人Vtuberのラビス・べレイRabis.Valetと申します。\n\n紙ひこーき様のかわいいイラストに惹かれまして、ぜひ活動で使用するイラストを作成していただきたくリクエストしました。\n\n詳細\nASMR作品などに使用できるようなイラストをお願いいたします。\n衣装や髪形などは定まっておりませんので描きやすいように改変していただいて大丈夫です。\nサムネイルなどに使用させていただきたいため両目は閉じず頭部や腕など見切れていない構図ですと嬉しいです。\nもし可能であれば眠そうな差分などがありましたら活動が捗ります・・・！\n\n使用用途\n配信サムネイル・動画サムネイル\n各種SNS宣伝\n商用込み\n\n納品\nレイヤー分けされたPSDもしくは背景透過のPNGでいただければと思います。\n\nラビスについて\n・とある国の元使い魔、ヒト型エゾモモンガ\n・八重歯とふわふわのしっぽがチャームポイントです。\n・リボンやフリル、ゴシックなものを好んでいます\n※性別不詳なので胸は盛らないようにお願いします；；\n\nskebはまだ不慣れなため要望が多くて申し訳ありません。\n条件に合わなければキャンセルしていただければと思います。\nご縁がありましたらよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1En4cRp2ghCnHPdpxRedI5mQhKI75ILVC?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u9ffo/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2162412, "client_id": 3454044, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26986918/uploads/origins/118fda50-e3e2-46a1-97a8-3d5330118612?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8f472c423b4a587bf14bdfb757e89bf", "srcset": "https://si.imgix.net/26986918/uploads/origins/118fda50-e3e2-46a1-97a8-3d5330118612?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8f472c423b4a587bf14bdfb757e89bf, https://si.imgix.net/26986918/uploads/origins/118fda50-e3e2-46a1-97a8-3d5330118612?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64c9c77646cf276ccb8dc43b9336aefc 2