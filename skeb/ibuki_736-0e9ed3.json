いでしょうか？\n\n【使用用途】 \n・他依頼時に資料として提示\n・SNSでのアイコン/ヘッダー\n\n【OC(少女)】\n26歳、146cm、髪色は明るいアッシュグレーで、青のメッシュやインナーが入っている。\n可愛らしい少女の恰好をしているが、異端と呼ばれる人ではない存在。身体の一部が冷たい灰色の炎で構成されている為、見た目をある程変えることができる。人間不信と自己嫌悪が強く、かつ他者に対する劣等感と羨望で不機嫌そうにしていることが多い。生真面目ゆえに我慢しがちな性格かつ口から出る言葉も刺々しいが、心を許した相手にはツンデレみたいになる。自身がかなり面倒な性格をしてる自覚はある。\n\n以上、金額や内容に不明・不足点等ありましたら再送もしくはキャンセルいただけますと幸いです。 \nご検討の程よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1syJ6qbmCol3PbTIs4f8MasAJ06QTlFHx", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ibuki_736/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d29e4863/uploads/origins/7ebe6047-b305-4b54-8ba0-3865882e3325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed2eaedb72839ab04df309914a33c019", "srcset": "https://si.imgix.net/d29e4863/uploads/origins/7ebe6047-b305-4b54-8ba0-3865882e3325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed2eaedb72839ab04df309914a33c019, https://si.imgix.net/d29e4863/uploads/origins/7ebe6047-b305-4b54-8ba0-3865882e3325?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bff000e8f3b35c2cfab45141f266b2f2 2x, https://si.imgix.net/d29e4863/uploads/origins/7ebe6047-b305-4b54-8ba0-3865882e3325?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d73e3dd3fdcf4195807afe9db1b47e77 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3839409, "client_id": 6600, "nc": 144}, {"path": "/@ibuki_736/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, 