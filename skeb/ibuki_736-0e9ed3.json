すので、横長だと大変助かります…！\n\n使用用途については各種SNSのアイコン、デスクトップ壁紙等の個人利用の予定です。\nまた、機会があれば自主製作の際に描いて頂いたイラストを使用したいとも考えておりますので、可能であれば髪や指先等が切れないように、そしてあれば背景と人物のレイヤーを分けて使用出来るようにご制作頂けますと幸いです。\n\n何卒よろしくお願いいたします！\nhttps://drive.google.com/drive/u/1/folders/1YY4_Yphkz7U9TQR_PB28JLAHw6sIEubE", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ibuki_736/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3839409, "client_id": 3877516, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d15beb5/uploads/origins/7116d85a-c3d3-4c46-9e4f-3c69474c29ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c732807ed043f308b1f4d3379208883", "srcset": "https://si.imgix.net/2d15beb5/uploads/origins/7116d85a-c3d3-4c46-9e4f-3c69474c29ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c732807ed043f308b1f4d3379208883, https://si.imgix.net/2d15beb5/uploads/origins/7116d85a-c3d3-4c46-9e4f-3c69474c29ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6168cf9de43c4c356c3296cd929ae7c3 2x, https://si.imgix.net/2d15beb5/uploads/origins/7116d85a-c3d3-4c46-9e4f-3c69474c29ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6141e9f6099fe4cf1ee3301c9f502e33 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d15beb5/uploads/origins/7116d85a-c3d3-4c46-9e4f-3c69474c29ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8646948e0cd8c717442e01c522401793", "srcset": "https://si.imgix.net/2d15beb5/uploads/origins/7116d85a-c3d3-4c46-9e4f-3c69474c29ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8646948e0cd8c717442e01c522401793, https://si.imgix.net/2d15beb5/uploads/origins/7116d85a-c3d3-4c46-9e4f-3c69474c29ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2