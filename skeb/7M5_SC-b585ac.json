女の子らしい口調。\n\n・関係性\n仕事の同僚であり恋人同士。主に栞が自由気ままに動き、吉野がいなしたり叱ったり受け止めたりしている。同棲しており、家でゆったりと一緒に過ごす時間も多い。\n\n【資料】\nhttps://drive.google.com/drive/folders/1Uyq711Rdl0meoBWRqC6__MRB0Gv6vhA6\n\n\nシチュエーション等はお任せいたします。サンプルで上げられていたようなゆるいギャグ調のものや、ラブコメ的な雰囲気のものになると嬉しいです。\n\n長文となり失礼しました。以上となります。内容や金額に不都合がございましたらキャンセルしてください。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Uyq711Rdl0meoBWRqC6__MRB0Gv6vhA6", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7M5_SC/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 4154239, "client_id": 2986492, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fd2d86f/uploads/origins/fa87cd3c-286b-4d3e-8252-d7d61a9b4e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af4fd02e141e016ea6970ab7f6c3a656", "srcset": "https://si.imgix.net/6fd2d86f/uploads/origins/fa87cd3c-286b-4d3e-8252-d7d61a9b4e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af4fd02e141e016ea6970ab7f6c3a656, https://si.imgix.net/6fd2d86f/uploads/origins/fa87cd3c-286b-4d3e-8252-d7d61a9b4e85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=277579f02a9b423f807de886bfd14ae2 2x, https://si.imgix.net/6fd2d86f/uploads/origins/fa87cd3c-286b-4d3e-8252-d7d61a9b4e85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1cfed4abdad03fa1323040ea02b81301 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6fd2d86f/uploads/origins/fa87cd3c-286b-4d3e-8252-d7d61a9b4e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c76b0d524cb328c6082fdbd3be089ca4", "srcset": "https://si.imgix.net/6fd2d86f/uploads/origins/fa87cd3c-286b-4d3e-8252-d7d61a9b4e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c76b0d524cb328c6082fdbd3be089ca4