r=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1659f97567163d103831e50e8dcfc931 3x"}, "body": "こんにちは。あなたのピクセルアートは素晴らしいです。\n\n私のOCを描いていただけませんか？彼女は二つの尾を持つ狐です。私は主な参考文献を添付していますが、彼女のすべての芸術とのリンクもあります。ありがとうございます。\n\nhttps://drive.google.com/drive/folders/166toqRPsd2ID8QsGIGvCvl6xS588FNJc\n\nhttps://imgur.com/a/8HkINLn", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@okura_pixel/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1527938, "client_id": 966001, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a89f4d1/uploads/origins/46de1ed9-b1ac-4268-8cfe-c0bb4a08b4e1?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=53927708869983f9f395f2248f22a93a", "srcset": "https://si.imgix.net/3a89f4d1/uploads/origins/46de1ed9-b1ac-4268-8cfe-c0bb4a08b4e1?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=53927708869983f9f395f2248f22a93a, https://si.imgix.net/3a89f4d1/uploads/origins/46de1ed9-b1ac-4268-8cfe-c0bb4a08b4e1?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=33010f00e5ac44b19720c5c44469e600 2x, https://si.imgix.net/3a89f4d1/uploads/origins/46de1ed9-b1ac-4268-8cfe-c0bb4a08b4e1?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ba0c2b4b1cb91f5ef2a2e2c1191bf72 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a89f4d1/uploads/origins/46de1ed9-b1ac-4268-8cfe-c0bb4a08b4e1?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=b268cb0d113ed291fb473d899a0c3655", "srcset": "https://si.imgix.net/3a89f4d1/uploads/origins/46de1ed9-b1ac-4268-8cfe-c0bb4a08b4e1?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=b268cb0d113ed291fb473d899a0c3655, https://si.imgix.net/3a89f4d1/uploads/origins/46de1ed9-b1ac-4268-8cfe-c0bb4a08b4e1?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4aeb95cbb7a0ae8c2fe63140ae7a0304 2x, https://si.imgix.net/3a89f4d1/uploads/origins/46de1ed9-b1ac-4268-8cfe-c0bb4a08b4e1?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3751536d7e35d9e3bde062034ed85e94 3x"}, "body": "こんにちは、はじめまして。絵がとてもかわいいですね。スターオーシャンアナムネシスのティカ・ブランシェのアニメーションをお願いしたいのですが、いかがでしょうか？\n\n参考までにフォルダを同梱します。\n\nのんびり立っていて、風が吹くようにスカートがめくれ、かわいいパンティが見えるようにしたいです。できればいろんな種類のパンティーを用意してください。柄はお好みで。\n\nまた、ノーパンのバージョンもお願いします。\n\nご検討のほど、よろしくお願いいたします。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/11hBzhL-XqXKWv8afaDGqhHhYfDgtA4SS", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@okura_pixel/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1527938, "client_id": 75748, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/05380d3c/uploads/origins/640c069f-1e4f-4ba6-8787-afb99723d37d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=e046d548cb765c7e8badacc32b484fed", "srcset": "https://si.imgix.net/05380d3c/uploads/origins/640c069f-1e4f-4ba6-8787-afb99723d37d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=e046d548cb765c7e8badacc32b484fed, https://si.imgix.net/05380d3c/uploads/origins/640c069f-1e4f-4ba6-8787-afb99723d37d?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b8d7647b47952289ad4783eafee55a0 2x, https://si.imgix.net/05380d3c/uploads/origins/640c069f-1e4f-4ba6-8787-afb99723d37d?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=066abce6dad9ccdce4fb1edb1f41423d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/05380d3c/uploads/origins/640c069f-1e4f-4ba6-8787-afb99723d37d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=fd599a0f8488a810b776994c3fab680a", "srcset": "https://si.imgix.net/05380d3c/uploads/origins/640c069f-1e4f-4ba6-8787-afb99723d37d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=fd599a0f8488a810b776994c3fab680a, https://si.imgix.net/05380d3c/uploads/origins/640c069f-1e4f-4ba6-8787-afb99723d37d?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d9317c035c5c880e643eaf730ae22f97 2x, https://si.imgix.net/05380d3c/uploads/origins/640c069f-1e4f-4ba6-8787-afb99723d37d?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e073810d4693c3a0b7c3bf3c7f64910 3x"}, "body": "ハイ\n\nあなたのピクセルスタイルが大好きです。\n私たちの毛皮のようなオオカミ、ライに依頼したい。\n元狼のリーダーで、ハンバーガーが大好き。\n雷の魔法と拳を使い、強く、速い。\nあまり喋らないので、クールに見える。\nでも、実は少しシャイで、友達のことをとても大切に思っている。\n\n雷の魔法を爪にかけ、クールで自信に満ち溢れた感じを演出してください。\nポーズや背景はお任せします。\n\nこのアイデアを気に入ってもらえるといいのですが\nありがとうございました。\n\nhttps://imgur.com/a/6B5zwTi", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@okura_pixel/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1527938, "client_id": 1774207, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d6c9272/uploads/origins/ce1fcc3e-f148-4053-bb00-7ead09359e86?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=b3847e4fea698009c9bcfa4b8ee23f06", "srcset": "https://si.imgix.net/8d6c9272/uploads/origins/ce1fcc3e-f148-4053-bb00-7ead09359e86?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=b3847e4fea698009c9bcfa4b8ee23f06, https://si.imgix.net/8d6c9272/uploads/origins/ce1fcc3e-f148-4053-bb00-7ead09359e86?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba260f37dd75bce3dfd2d770e7b70fb1 2x, https://si.imgix.net/8d6c9272/uploads/origins/ce1fcc3e-f148-4053-bb00-7ead09359e86?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=86057c4f25ee9116b8b4bf591c7a95a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix