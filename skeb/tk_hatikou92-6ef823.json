le%2Ccenter&txtsize=30&txt=PRIVATE&s=64a87453d6ccf3f4fc65fbecc665a82e", "srcset": "https://si.imgix.net/a312618f/uploads/origins/75d2612f-a76a-4d28-91e3-855f925d9e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64a87453d6ccf3f4fc65fbecc665a82e, https://si.imgix.net/a312618f/uploads/origins/75d2612f-a76a-4d28-91e3-855f925d9e85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9ae16257264225c0f6c84a0f088e22a 2x, https://si.imgix.net/a312618f/uploads/origins/75d2612f-a76a-4d28-91e3-855f925d9e85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e76157efe7e887c7fb07e3aeda7a238 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 92589, "client_id": 862718, "nc": 145}, {"path": "/@tk_hatikou92/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 92589, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c7bd981/uploads/origins/b2e62af3-bdfd-4d0f-b53e-389dfc524922?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f084a0521a6d3f8c9f86386b54d87fdb", "srcset": "https://si.imgix.net/8c7bd981/uploads/origins/b2e62af3-bdfd-4d0f-b53e-389dfc524922?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f084a0521a6d3f8c9f86386b54d87fdb, https://si.imgix.net/8c7bd981/uploads/origins/b2e62af3-bdfd-4d0f-b53e-389dfc524922?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d6a6959c5293de064336aff89298f0f 2x, https://si.imgix.net/8c7bd981/uploads/origins/b2e62af3-bdfd-4d0f-b53e-389dfc524922?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e47595fd57e5c252c6003aa7571107f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c7bd981/uploads/origins/b2e62af3-bdfd-4d0f-b53e-389dfc524922?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21d9110b4a0295f3a352c3363bf9e9fc", "srcset": "https://si.imgix.net/8c7bd981/uploads/origins/b2e62af3-bdfd-4d0f-b53e-389dfc524922?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21d9110b4a0295f3a352c3363bf9e9fc, https://si.imgix.net/8c7bd981/uploads/origins/b2e62af3-bdfd-4d0f-b53e-389dfc524922?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=98941af669d1cec242bbaaf2c7306ebc 2x, https://si.imgix.net/8c7bd981/uploads/origins/b2e62af3-bdfd-4d0f-b53e-389dfc524922?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fff749bc68c35d23009a1b0e3c03e1c1 3x"}, "body": "配信中の画面に現れた謎の消しゴムにより服がどんどん消されていく巻乃もなかさんをお願いします。\n\n消された部分だけ服がなくなるイメージであり、残された服は消失による影響を受けなくてもよいです。\nたとえば、肩の部分が完全に消失していたとしても袖は落下する必要はありません。\nもちろん、消えかけの服が剥がれ落ちそうになっていても、それはそれで問題ありません。\n消しゴムで消していることが表現からわかるのであれば、消しゴム自体は描写がなくともOKです。\nまた、消しゴムは消すことへのわかりやすい表現手法としてのご提案であり、服が消されつつある事が描写できていれば消しゴムに限りません。\n\n謎の現象により混乱しながら赤面する様子を想定しておりますが、本人が全く気が付いていないというシチュもアリだと思いますので、癖に合わせてお選びください。\n\n服装はデフォルトの服を想定しておりますが、変更していただいても構いません。\nただし、髪型は大きく変更しないようお願いいたします。\n\n服は大幅に消しすぎず、消す面積が布面積の6割を超えない程度を目安として頂けると幸いです。\n演出上の都合でそれ以上になる場合、本人を同定可能な特徴のあるパーツを残すようお願いいたします。\n\n下半身に関しては重要な部分は必ず衣服を残してください。下着だけ残るような形でも大丈夫です。\n可能であれば、そこが消えたらもう見えてしまうのでは…というギリギリで止まっていると癖に刺さります。\nもしくは、そこが消えたとすると捲れたり落ちてしまうのでは…といった場所を消すという方法も癖に刺さります。\n全身が入らない構図の場合、そこが消えていたとしたら見えているのでは…といった位置まで描写するような方法も癖に刺さります。\n\n希望内容は上記となりますが、受けるにあたり譲れない部分があれば変更していただいて構いません。\n同じようなシチュならもっといい手法がある！といった場合は、どんどん変更なさってください。\nただし、人の手によってご本人に触れることはご遠慮願います。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tk_hatikou92/works/3", "private_thumbna