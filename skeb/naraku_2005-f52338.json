明るい色調で統一されていること！\n\n構図のアイデア：https://imgur.com/a/Bnu5Uhz\n\nデコレーションのアイデア: https://imgur.com/a/ce8l06I\n\n楽しんでください！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naraku_2005/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2393177, "client_id": 2879455, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1598651e/uploads/origins/c61163d7-64af-4a18-abd5-bfa57b840a4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efe350252518a98b91b2ebd817cc1131", "srcset": "https://si.imgix.net/1598651e/uploads/origins/c61163d7-64af-4a18-abd5-bfa57b840a4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efe350252518a98b91b2ebd817cc1131, https://si.imgix.net/1598651e/uploads/origins/c61163d7-64af-4a18-abd5-bfa57b840a4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c857488e80512ea58343d0ecf96769b 2x, https://si.imgix.net/1598651e/uploads/origins/c61163d7-64af-4a18-abd5-bfa57b840a4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66cb27d257fbd900ca3a5823e445b99d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1598651e/uploads/origins/c61163d7-64af-4a18-abd5-bfa57b840a4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7265ec4d16b1ff04ebdaa1f28596ba2f", "srcset": "https://si.imgix.net/1598651e/uploads/origins/c61163d7-64af-4a18-abd5-bfa57b840a4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7265ec4d16b1ff04ebdaa1f28596ba2f, https://si.imgix.net/1598651e/uploads/origins/c61163d7-64af-4a18-abd5-bfa57b840a4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f7b7d0285b8f37477ad785ef5a630723 2x, https://si.imgix.net/1598651e/uploads/origins/c61163d7-64af-4a18-abd5-b