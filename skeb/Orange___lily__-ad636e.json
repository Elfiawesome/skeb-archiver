描いて欲しいです。\n晴が死んでしまうくらいならばちいこになってくれればいいのにとフィクサーが一瞬考えてしまい目の前でパッと晴がちいこになってしまって言葉も分からない生き物になってしまって……病気も治り、一生一緒にいられるのにそこにいるのはあの時一緒にいた晴ではない...\nといった内容のお話が見たいです。\nハッピーエンドかバッドエンドかはおおつか先生にお任せします。(原作の方では一応メリーバッドエンドとなっています。)\nちいこの姿は長毛猫だと嬉しいです。\nお忙しい中だと思いますが描いていただければ光栄です。どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1qCcZWs6QBVgiS4C_TWVtQXKc-FauJ5BD", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ozoro_i_tama/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 80638, "client_id": 2907183, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2df16143/uploads/origins/cce98f58-98fe-4a4e-a1e1-91b56c17ecd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3e2f70d978919345e9c6e4823ab87af", "srcset": "https://si.imgix.net/2df16143/uploads/origins/cce98f58-98fe-4a4e-a1e1-91b56c17ecd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3e2f70d978919345e9c6e4823ab87af, https://si.imgix.net/2df16143/uploads/origins/cce98f58-98fe-4a4e-a1e1-91b56c17ecd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fd5ab821c0186c00a1f76b3202bf5d7 2x, https://si.imgix.net/2df16143/uploads/origins/cce98f58-98fe-4a4e-a1e1-91b56c17ecd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79d7f29b20da3b9b2778b809455470ac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2df16143/uploads/origins/cce98f58-98fe-4a4e-a1e1-91b56c17ecd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9d24f1c1833d092e9134899c3d67a3a", "srcset": "https://si.imgix.net/2df16143/uploads/origins/cce98f58-98fe-4a4e-a1e1-91b56c17ecd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9d24f1c1833d092e9134899c3d67a3a, https://si.imgix.net/2df16143/uploads/ori