トを分けていただきたいです。\n何か不備などございましたら差し戻していただけますと幸いです。\nお忙しいところ恐縮ですが、ご検討よろしくお願いいたします。\n\nhttps://docs.google.com/spreadsheets/d/1jjh_UV9Tq7RXanIUqTGzERNX6IdgSV57OZfNS4XDdMg/edit?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@k2pt/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 639935, "client_id": 977824, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c9ffdf1/uploads/origins/b6c68393-d8f6-49f7-8e68-8b4c3230f3cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f0f66a20891c5ece59e246f70de2a04", "srcset": "https://si.imgix.net/6c9ffdf1/uploads/origins/b6c68393-d8f6-49f7-8e68-8b4c3230f3cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f0f66a20891c5ece59e246f70de2a04, https://si.imgix.net/6c9ffdf1/uploads/origins/b6c68393-d8f6-49f7-8e68-8b4c3230f3cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5475e4a5966c06642f4d5e527b3d77d3 2x, https://si.imgix.net/6c9ffdf1/uploads/origins/b6c68393-d8f6-49f7-8e68-8b4c3230f3cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4986c2069b3078a604f16e97c413f20c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c9ffdf1/uploads/origins/b6c68393-d8f6-49f7-8e68-8b4c3230f3cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f84c18cc37600dc7e634078a01ed1b3", "srcset": "https://si.imgix.net/6c9ffdf1/uploads/origins/b6c68393-d8f6-49f7-8e68-8b4c3230f3cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f84c18cc37600dc7e634078a01ed1b3, https://si.imgix.net/6c9ffdf1/uploads/origins/b6c68393-d8f6-49f7-8e68-8b4c3230f3cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d502a2d42cd70c1a7a5ce076dd5792e2 2x, https://si.im