7e50e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=449c009ea5901daf0219a11b4f843a24", "srcset": "https://si.imgix.net/170c3215/uploads/origins/34496775-4131-4f30-8de7-d8ffab7e50e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=449c009ea5901daf0219a11b4f843a24, https://si.imgix.net/170c3215/uploads/origins/34496775-4131-4f30-8de7-d8ffab7e50e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ba8504bfebac9cb073b8008ea14092dc 2x, https://si.imgix.net/170c3215/uploads/origins/34496775-4131-4f30-8de7-d8ffab7e50e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eaeb1799ac2c88e2dbe2f3582d98e5a2 3x"}, "body": "k2pt様\n\n個人Vtuberのハーミア・オデットと申します。前回は本当に素敵なイラストをありがとうございます！\nぜひまた活動で使用するイラストをお願いできないでしょうか。\n\n【キャラ詳細】\n・次期公爵でお嬢様\n・好き：金木犀、リボン、フリル、アンティーク小物、コスプレ\n・好きな食べ物：いちごタルト、チーズケーキ\n・品はありつつ表情豊かな性格\n・明るくて素直だが、好きなものの話になると暴走しがち\n・前髪がハートマークに見えるところと、おでこがチャームポイント\n・好きな色：白\n\n【体型】\n20歳、161㎝、46kg\n薄い色の金髪ふわふわ髪（ハイライトと毛先が少しピンク色のグラデです）\n黄緑色の目\n\n【使用用途】\n収益化の通ったYouTubeへの投稿（サムネイルや配信）、Twitter等のSNSの活動におけるプロモーション、ファンボックスへの投稿等\n\n【希望デザイン】\nお好きなように描いていただけると幸いです！\n\n\n【要望】\nサムネイルに使用したいため、頭部や髪の毛などの左右が見切れていない状態で描いていただきたいです。\nまた、できればPSD(文字・人物・背景)で分けていただけますと幸いです。\n\n【参考資料】\n・添付の資料URLに三面図や表情差分資料などを載せています。\n\n・LitLink\n詳しいキャラ詳細が載っています。少しでも資料の助けになれば幸いです。\nhttps://lit.link/HermiaOdette\n\n\n長くなりましたが、ぜひご検討の程 よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1t0eDJRESSNoqNa6Xo45abKYUOCrv1g11", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@k2pt/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 639935, "client_id": 2611601, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55407b3f/uploads/origins/b1c3fcd3-ce60-4fa7-9791-a2d685723724?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7597a000588dbb3f