f3-47d7-8106-f3d40c81cbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=36e367b4a0a10416d59777e9b1d04b13 2x, https://si.imgix.net/afe6aad0/uploads/origins/52446c4b-62f3-47d7-8106-f3d40c81cbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=11679d3017e14dad7f51b0aeaa01e636 3x"}, "body": "初めまして、夜分遅くにリクエスト失礼致します。\nSNSにてdcstの推しイラストで強く美しい女性３人を拝見させていただきまして、一目惚れしてしまいました。今回は、OCになるのですが女性キャラ絵を一枚お願いできないかと思い申請させていただいております。\n\n■希望のイラスト\n容姿▽\n成人女性／色っぽいお姉さん系／妖艶／胸大きめ(Ｇカップ位)／グラマー体型\n銀髪／ウェーブがかったロングヘア／前髪左目の上あたりに分け目\n目力強め／水色の瞳／二重／唇（赤～ピンク）\n\n服装▽\n踊り子の衣装\n\n※Googleドライブに自分で手描きしたデザインを添付致しましたが、絵が上手ではないので、拙くわかりにくいと思いますのであくまで参考程度に、わい様の方でアレンジしていただいて構いません。イメージとしてフワッと伝われば幸いです。\n\nポーズ▽\n妖艶または挑発的な微笑み\n仕草はお任せいたします\n胸が半分以上（少なくともギリギリ谷間あたりまで）描かれていると嬉しいです\n\nその他、何かあればわい様のおまかせでお願い致します\n\n\n■使用用途\nアイコン・サムネイルとして使用する可能性あり（音声配信サイト(収益化無)・Ｘ等）\nＯＣ大好きなので個人観賞用（ＰＣ・スマホの待ち受け等）\n\n\n■参考資料\n髪型・衣装等のイメージ画像を下記URLに添付させていただきます。\n\n\nお忙しいとは思いますが、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1U8xo0H_KxbxriSqh8A738L0xXXMwsM0c?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wa_wawa_ii/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8d3baca8/uploads/origins/dda5ae37-7d53-4b9b-993b-08fcc4058682?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a12d1b062e8b2fb258966ee54a1e31b", "srcset": "https://si.imgix.net/8d3baca8/uploads/origins/dda5ae37-7d53-4b9b-993b-08fcc4058682?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a12d1b062e8b2fb258966ee54a1e31b, https://si.imgix.net/8d3baca8/uploads/origins/dda5ae37-7d53-4b9b-993b-08fcc4058682?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px