f6-842a-9d039e105faa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9828ae01bd0d7c8b906ba5132a260598, https://si.imgix.net/dd6ab65b/uploads/origins/22d75df4-3f8b-49f6-842a-9d039e105faa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bef95593cb25b7f7bd0a6fe9e84af975 2x, https://si.imgix.net/dd6ab65b/uploads/origins/22d75df4-3f8b-49f6-842a-9d039e105faa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e1820687e4a86504feb64d5b9215dee 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd6ab65b/uploads/origins/22d75df4-3f8b-49f6-842a-9d039e105faa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f233a0d9bfd6808dbd70c0e50790ba2", "srcset": "https://si.imgix.net/dd6ab65b/uploads/origins/22d75df4-3f8b-49f6-842a-9d039e105faa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f233a0d9bfd6808dbd70c0e50790ba2, https://si.imgix.net/dd6ab65b/uploads/origins/22d75df4-3f8b-49f6-842a-9d039e105faa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63b25e745f650deb8aa95ddbe7e1c58e 2x, https://si.imgix.net/dd6ab65b/uploads/origins/22d75df4-3f8b-49f6-842a-9d039e105faa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a4fbd3f800c33649a62ec7cb7e1c26db 3x"}, "body": "イトヲタヤ先生\nVtuber準備中の梯子あいりゃです。\n前回は素晴らしいイラストをありがとうございました！\n塗りや、全体的な世界観、先生の描かれる女の子の表情がとても素晴らしく\nまた私の姿を書いていただけないでしょうか。\n\n※用途が合わない、もしくは\nお忙しい状況であればキャンセルしていただいて問題ございません！\n\nポーズ、構図はお任せ\n「お部屋にいる女の子」\n\n服装−資料があるのは部屋着か制服ですが、それ以外の\n　　　お好きな衣装で書いていただいても大丈夫です！\n髪型−ピンク色、ハーフアップツインテール\n装飾−猫耳、しっぽ、前髪に金色のハートヘアピンが3つ\nモチーフ 　桜、金色の貝殻\n（設定情報　海の戦争で活躍する遺伝子改変兵器という設定で\n綾波レイのようなキャラクターです）\n可能であれば表情差分をいただけないでしょうか\n先生の描く女の子の豊かな表情がとっても可愛くて好きです！\n\nサムネイルにも使用させていただきたいので\n可能な場合は帽子〜猫耳、手などが見切れない構図で頂けないでしょうか。\n\n【納品形式】\n横長 3840×2160を希望\n・できればPSD形式、またはPNG形式、背景と人物を分けたデータを頂きたい