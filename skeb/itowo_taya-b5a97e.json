そうに食べている/ゲームしている/こちらをのぞき込んでいる\n…上記の要素(シチュ)で描きやすいものを描いていただけると嬉しいです。\n\n・髪型は資料の白いメッシュを残していただけたら\n長さを変えたりウェーブ有り無しも変えていただいて大丈夫です。\n\n\nまた、もしも可能でしたら人物のみのデータ(背景透過データ)を頂けると本当に嬉しいです。\nお手数おかけして申し訳ございませんがご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Pcg7Wt3Om9mAiErmCXam06E-66BpRL4-?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@itowo_taya/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3602177, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/545cc0f9/uploads/origins/e98cb3f9-2cac-444a-9c15-e925503e9d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2bfa39b7124166bfd308eedbee171de", "srcset": "https://si.imgix.net/545cc0f9/uploads/origins/e98cb3f9-2cac-444a-9c15-e925503e9d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2bfa39b7124166bfd308eedbee171de, https://si.imgix.net/545cc0f9/uploads/origins/e98cb3f9-2cac-444a-9c15-e925503e9d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84584dfb5fb9b69e329dbc770fb393e2 2x, https://si.imgix.net/545cc0f9/uploads/origins/e98cb3f9-2cac-444a-9c15-e925503e9d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac476f2ddd9429e5d386da65cbaacb52 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/545cc0f9/uploads/origins/e98cb3f9-2cac-444a-9c15-e925503e9d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a73880ecccaf0335d8e6c88da9a90eaa", "srcset": "https://si.imgix.net/545cc0f9/uploads/origins/e98cb3f9-2cac-444a-9c15-e925503e9d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a73880ecccaf0335d8e6c88da9a90eaa, https://si.imgix.net/545cc0f9/uploads/origins/e98cb3f9-2cac-444a-9c15-e925503e9d8d?bg=%23fff&auto=format%2Ccompres