クバレエも長い間やっていた\n\n【参考資料】\n・三面図/立ち絵など\nhttps://drive.google.com/drive/folders/11InLoRbxbLLW9A0-K28FfWQ-tAz1HKoT\n・ご依頼したい衣装\nhttps://drive.google.com/drive/folders/1PVQ8gPy69l7nzLyBD-N_NGeqzPq-1FBs\n・対象の歌ってみた動画\nhttps://youtu.be/JhUR3Xl5_8Q\n・二次創作ガイドライン(公式)\nhttps://www.project-nebula.com/guideline\n・YouTubeチャンネル\nhttps://youtube.com/@rensuzuri", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0wagyuwagyu0/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b6499a2f/uploads/origins/7320cfb2-5ee9-4061-90cb-f58dc23e0bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=011099bf8029f405749f573635b11a0a", "srcset": "https://si.imgix.net/b6499a2f/uploads/origins/7320cfb2-5ee9-4061-90cb-f58dc23e0bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=011099bf8029f405749f573635b11a0a, https://si.imgix.net/b6499a2f/uploads/origins/7320cfb2-5ee9-4061-90cb-f58dc23e0bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9642e923952b4913a442f491698dcde8 2x, https://si.imgix.net/b6499a2f/uploads/origins/7320cfb2-5ee9-4061-90cb-f58dc23e0bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a5b03680340e1ac36f5d800f8af22958 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3884927, "nc": 145}, {"path": "/@0wagyuwagyu0/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3884927, "client_id": 3305428, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/