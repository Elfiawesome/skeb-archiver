f-46f5-b897-0ee57b770d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f542f40a2c8e4b428f3680fcc806c4af, https://si.imgix.net/f5233c5c/uploads/origins/15842b37-659f-46f5-b897-0ee57b770d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dc41ed0d4696e3f8b656952a2e37a018 2x, https://si.imgix.net/f5233c5c/uploads/origins/15842b37-659f-46f5-b897-0ee57b770d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3dad824ef524223d02f4b87150b91fb 3x"}, "body": "新人VTuberの雨喵Yumeowと申します。\n猫耳娘少女の水系魔法使いです\n\nwagyu🐃様のイラストがとても可愛く、一目惚れしてしまい、ぜひご依頼させていただきたくご連絡いたしました。​\n\nポーズはご自由にお任せいたします。\n魔法の杖を持った姿で描いていただけましたら嬉しいです。\nまた、可能でしたら黒色バージョンの鏡像差分もお願いできますでしょうか。\nポーズは同じままで問題ございませんが、表情に少し変化をつけていただけますと大変嬉しいです。\n\nグッズ制作の際に表裏デザインとして使用したいと考えております。\nご無理のない範囲でご検討いただけますと幸いです。\n\n頭や耳が見切れない構図でお願いできましたら幸いです。\n\n【衣装について】\nもし可能でしたら、「アイドル衣装デザイン」という資料フォルダ内の衣装デザインをベースに、\nアイドル感のあるスタイルで描いていただけると嬉しいです。\n魔法や紫陽花（あじさい）などの要素を取り入れていただいても大丈夫です。\nこちらについては、ぜひ自由にご発想・アレンジしていただければと思います。\n\n【納品ファイルについて】\n可能でしたら、背景とキャラクターをレイヤー分けしたPSD形式で納品いただけますと大変嬉しいです。\n\n【用途】\n主に配信のサムネイルとして使用予定です。\nそのほか、SNSでの宣伝、FANBOXの特典、少量のグッズ、ネットプリント等に使用させていただく可能性があります。\n\nご検討いただけましたら幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10GzEeaOdgjLiu61uT0nkhH76aNCl6M7r", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0wagyuwagyu0/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3884927, "client_id": 2506061, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91f2eba8/uploads/origins/a0f14bd7-b4a1-40ef-aa48-2589e8aba84e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b09b8e4fd1c17bb2fdee9516982fa11", "srcset": "https://si.imgix.net/91f2eba8/uploads/origins/a0f14bd7-b4a1-40ef-aa48-2589e8aba84e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b09b8