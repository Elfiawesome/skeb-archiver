webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e00f464dc84b405f41f1285c7957b636", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1913900, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@l0ve_la_bit/works/154", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1913900, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7d74e3a/uploads/origins/c05fe108-f12e-41a8-8dac-4d7e458c40cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec923c163f13e12a98a97520ec2f7149", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7d74e3a/uploads/origins/c05fe108-f12e-41a8-8dac-4d7e458c40cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5240e55a8a4919e86ee9536f79febb1e", "src_set": ""}, "body": "初めまして。\n先日見かけましたあまみゃのイラストがとても可愛らしかったのでリクエスト送らせていただきます。\nぶいすぽっ！の紫宮るなを描いていただきたいです。あまみゃのイラストのように舌を少し出して可愛らしく挑発するようなイメージでお願いしたいです。\n衣装は先日出た添付URLの衣装でお願いしたいです。\n詳細は描きやすいようお任せしたく。\n\nご検討よろしくお願いします。\n\nhttps://x.com/runa_shinomiya/status/1906678906695934019?s=46", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@l0ve_la_bit/works/153", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1913900, "client_id": 293151, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a98a20b7/uploads/origins/d15f8096-1ef0-4998-8485-62e404ebe077?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c9cf21aaf6fd8df196a5546ce8192ff", "