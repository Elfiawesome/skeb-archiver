=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=858a179c046896e3d6e3ae2c54022bfe 2x, https://si.imgix.net/1cdb1e2a/uploads/origins/602e2a4a-b433-4688-82d9-cd912ae23537?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da4f19a49c193e0c26301fb2caa0ff55 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1cdb1e2a/uploads/origins/602e2a4a-b433-4688-82d9-cd912ae23537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=828f7b901b3d4d7596ed45c932b4e66e", "srcset": "https://si.imgix.net/1cdb1e2a/uploads/origins/602e2a4a-b433-4688-82d9-cd912ae23537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=828f7b901b3d4d7596ed45c932b4e66e, https://si.imgix.net/1cdb1e2a/uploads/origins/602e2a4a-b433-4688-82d9-cd912ae23537?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b28874012c984e4f2de9fe1281cc384 2x, https://si.imgix.net/1cdb1e2a/uploads/origins/602e2a4a-b433-4688-82d9-cd912ae23537?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=928bf59c3e81f824a053f8116f5e7dcd 3x"}, "body": "いつもお世話になっております。\nまた、私のオリジナルキャラクターあかなちゃんを描いていただきたいと思います。\n\nソーシャルゲームの立ち絵風なあかなちゃんをお願いします。\n衣装はノースリーブ、生足かタイツ、大きめのブーツがあるとうれしいですが、細かい造形はお任せしたいと思います。全部無視してもかまいません。\nワンピースやボロ布、奴隷風でもOKです。\n小さな身体に不釣り合いのドデカ武器を持っていたりするとうれしいです。ドデカ武器が難しければ短剣やナイフなど小さめ武器をもたせてほしいです。\nドデカ武器の種類は特に指定ありません。\n背景はソシャゲに良くあるようななんか色のついた感じのデーン！といった風でお願いします。\n\nあかなちゃんは、おんまゆぱっつんで少しはねッ毛&アホ毛、赤のメッシュが入ってる頭が奇抜なクソガキ。なぜか緑に輝く王冠を被ってる？\n碧眼。\n骨の成長にまだ肉が追いついておらず、若干骨が浮き出ている。不健康なわけではないため、筋肉は程よくついて脂肪少なめ。しかし、お腹はぷにぷに。腹筋はないが腹が出ているわけではない。\n四肢は細く、骨から成長しているため縦のスタイルはスレンダー細身で良い。胸は全くない。平。\n動き回るのは好きだが、スポーツは苦手。\n厚着は好きではなく、動きやすい、着やすい服が好き。パーカーやワンピースなど1枚で服として着られるものが好き。\n基本生足で、ホットパンツやスカートが多い。厚手のタイツは好き。\n靴下は嫌いで裸足が多い。\nお気に入りの靴はブーツで、裸足でよくはいている。蒸れ蒸れでとても臭い（いい匂い）。\n小さなリボンがついたサンダル\nもかわいいから好き。\nゴスロリやコスプレ衣装は装飾がかわいいから特別なときとかには著たい。でも恥ずかしい。\nといった感じです。\n\n描いて貰ったー！やったー！という風にいろいろなところSNSや動画で紹介したいと考えてます。\nまた、ほかの人のskeb 依頼の時に参考画像としても使用したいと思います。\n\nよろしくお願いします。", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yurisienne/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 138287, "client_id": 744277, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ea6160d/uploads/origins/bb41af94-3333-4f47-9e03-90899e027cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e8c55c4fea29d89ba9c3b358d983d3e", "srcset": "https://si.imgix.net/9ea6160d/uploads/origins/bb41af94-3333-4f47-9e03-90899e027cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e8c55c4fea29d89ba9c3b358d983d3e, https://si.imgix.net/9ea6160d/uploads/origins/bb41af94-3333-4f47-9e03-90899e027cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25687cd0e349b7a4d65ac377b1d6257a 2x, https://si.imgix.net/9ea6160d/uploads/origins/bb41af94-3333-4f47-9e03-90899e027cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d36af1d3ca9648a48f2b6bf619b0088f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ea6160d/uploads/origins/bb41af94-3333-4f47-9e03-90899e027cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7500f50c6068b182c830c217ca8dbd79", "srcset": "https://si.imgix.net/9ea6160d/uploads/origins/bb41af94-3333-4f47-9e03-90899e027cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7500f50c6068b182c830c217ca8dbd79, https://si.imgix.net/9ea6160d/uploads/origins/bb41af94-3333-4f47-9e03-90899e027cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=12d294fb7b1b3eb6fdda13a8f124f2b3 2x, https://si.imgix.net/9ea6160d/uploads/origins/bb41af94-3333-4f47-9e03-90899e027cb7?bg=%23fff&auto