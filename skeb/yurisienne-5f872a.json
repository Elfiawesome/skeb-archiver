s%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1620718587748163585%2F9M2dNB50.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ac22539a5e5da82d8deb448a5f2a3dc7 3x"}, "body": "ノユリさまが人間の血を吸って女の子に変えようとしているシチュエーションです。血を吸われてぐったりしているのでやさしく語りかけるような感じお願いします。言いにくい箇所や表現がありましたらアレンジはおまかせします。\n\n以下本文です。\n----\nかなり血を貰ったから、もう眠くなってきてるはず。\n次に目が覚めたとき。\nキミは女の子になっている。\nキミがそれを望むなら。\n\nもしもそうならなかった時は。\nキミは魂だけになって。\nキミのままではいられなくなってしまう。\n\n……ねえ、まだ聴こえてるかな？\nもしもこの先、キミが魂だけになっても。\nボクはずっとキミの側にいるよ。\nいつもキミを感じている。\n今こうやって話してるみたいに。\nううん、今よりずっと深いところで。\n空を見上げたら月や星が見えるみたいに。\n当たり前にキミの側にいる。\n息をするみたいにキミのことを感じている。\n\nキミの血がボクの中を巡ってやがてボクそのものになる。\nそう考えたら、なにも変わることなんてないのかもしれないね。\n\nだからこの先もずっとキミを感じるよ。\nボクのセカイにキミをいさせる。\nキミはボクの一部でしかないから。\nボクのセカイのどんな場所にもキミがいるから。\nちゃんと魂のキミを見分けるよ。\nだから安心して今は眠りに身を委ねて。\n\n少しだけさよならだね。\nおやすみなさい。\n----", "nc": 16, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 678010, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "よしの🤍", "screen_name": "4shino_ns", "avatar_url": "https://pbs.twimg.com/profile_images/1856840710236057600/ZxK4SbEF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/774647994683498497/1731593997/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 1216281, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "津七なと", "screen_name": "natou3wari", "avatar_url": "https://pbs.twimg.com/profile_images/1951909037190295553/pTosmT-I.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1379793312492621836/1713542243/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all