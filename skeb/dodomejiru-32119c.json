77-81376b65b165?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd10b46f77ac1fd17196f5acd7c8500f, https://si.imgix.net/3236cf00/uploads/origins/4d963ae1-84f4-424d-8777-81376b65b165?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b85faf7965ad34e47920262714d5aa6 2x, https://si.imgix.net/3236cf00/uploads/origins/4d963ae1-84f4-424d-8777-81376b65b165?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b09c845a12f382e233fe45be68bc4e98 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3236cf00/uploads/origins/4d963ae1-84f4-424d-8777-81376b65b165?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79a2e1241c328676777f8d999de21755", "srcset": "https://si.imgix.net/3236cf00/uploads/origins/4d963ae1-84f4-424d-8777-81376b65b165?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79a2e1241c328676777f8d999de21755, https://si.imgix.net/3236cf00/uploads/origins/4d963ae1-84f4-424d-8777-81376b65b165?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=92e28d13767325aa0bf944dc6d712de2 2x, https://si.imgix.net/3236cf00/uploads/origins/4d963ae1-84f4-424d-8777-81376b65b165?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0cb945284c6eefca3927e4f82d297211 3x"}, "body": "ドドメ汁さん、いつもお世話になっております。紗哉です。\nこの度はTRPGのセッションで使用するためのキャラクター立ち絵を描いて頂きたいと思い、依頼しに参りました。\n\n通常立ち絵一種と、ポーズ同じの衣装差分立ち絵を一種、計二種をお願いしたいです。\nこちらからは大まかな要素の指定のみで、後はドドメ汁さんにお任せしてみたい！と思っています。\n\n依頼の詳細は以下の通りになります。\n\n・17歳の男子高校生。\n・髪色は明るめの茶髪で、坊主や刈り上げよりちょっと長めでツンツン系のイメージ。\n・全体的な雰囲気として、青年よりも少年のイメージです。明るく活発な性格を想定しています。\n・顔立ちは平凡だけど人懐こそうな感じ。APPでいうと12〜14ぐらいといった感じです。\n・身長167〜169cmぐらい。体重は未設定ですが、細すぎず太すぎず…が理想です。\n\n・通常立ち絵は神社の神職風の和装。ぺーぺーの若造なので、袴の色は浅葱色でお願いします。\n・衣装差分は、パーカーにチノパン、といった感じのカジュアルな服装で描いて頂けると嬉しいです。あまりファッションに明るくないため、詳細はお任せします。細かく指定できず申し訳ありません。\n\nもし表情差分をお願いできる場合は\n\n・目が開いてる状態で、おくちがニコッとしているもの。おくちは開いていても閉じていても大丈夫です。（これがメインの表情だと嬉しいです）\n・おめめ見開いてびっくりしている表情のもの。\n\nの2種があると嬉しいです。\nもちろん、金額に見合わない場合は衣装差分や表情差分は無しで大丈夫です！\nサイズの指定は特にありませんが、ファイル形式は透過pngだと助かります。\n\n以上の依頼内容で受けて頂けそうでしたら、何卒よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dodomejiru/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 361629, "client_id": 75926, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/999b62a3/uploads/origins/1bba4cfa-14dd-4f70-9ef8-2e62fb47bcf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25959d1733ec9fd88954d6754d94e5bc", "srcset": "https://si.imgix.net/999b62a3/uploads/origins/1bba4cfa-14dd-4f70-9ef8-2e62fb47bcf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25959d1733ec9fd88954d6754d94e5bc, https://si.imgix.net/999b62a3/uploads/origins/1bba4cfa-14dd-4f70-9ef8-2e62fb47bcf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6e66eb68a5ba79c1c9484824ca9158c 2x, https://si.imgix.net/999b62a3/uploads/origins/1bba4cfa-14dd-4f70-9ef8-2e62fb47bcf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33f6e34ceff4daace3c5547e92227722 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/999b62a3/uploads/origins/1bba4cfa-14dd-4f70-9ef8-2e62fb47bcf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c3c555278a0ed199c3b88025d77a7ac", "srcset": "https://si.imgix.net/999b62a3/uploads/origins/1bba4cfa-14dd-4f70-9ef8-2e62fb47bcf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c3c555278a0ed199c3b88025d77a7ac, https://si.imgix.net/999b62a3/uploads/origins/1bba4cfa-14dd-4f70-9ef8-2e62fb47bcf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=09daae