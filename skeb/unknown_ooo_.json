32-cb7836e82afb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9942bef07b363f2f76b6b6108b9be6ff", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00f5f31a/uploads/origins/d52646fd-a8ec-40cf-8532-cb7836e82afb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=748ca880df8d0406cd3bed4bdb559b71", "src_set": ""}, "body": "こんにちは、先生のイラストが好きで依頼させていただきました！\n私のオリキャラの絵を描いてもらえますか？\n\nキャラクター設定：\n- 世界観：近未来 × 徐々に終末へと向かう凍った惑星\n- 灰髪 / オッドアイズ / 植物オタクな若き研究員\n- 社交性が苦手で、他人と一定の距離を保つ傾向があります。しかし、一度植物の話をすると、彼は人々をつかまえて延々と語り続けるのです。\n- 彼はこの惑星の未来を悲観しており、実験室や温室にいる時だけ、その不安を一時的に忘れることができる。\n\n構図等はお任せします、ご自由に描いてください！\n金額不足や難しいなどの場合、お気軽にキャンセルや再送要請をお願い致します。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1y_037gCxVC73iK8HWhHeAlnyFc95gD52?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unknown_ooo_/works/239", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/44884f59/uploads/origins/d41c3e70-cdf9-4f66-ae5b-b43ef541e75c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a80f740f41439802859c4ea47f0f5809", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 878969, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@unknown_ooo_/works/238", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 878969, "client_id": 2635215, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/758fa6db/uploads/origins/01104c1e-998b-4746-b05b-9f59eae72dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57896095f617389b2f638fc24f9ce5f1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/758fa6db/uploads/origins/01104c1e-998b-4746-b05b-9f59eae72dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b42ac71225f194ca6407b18634beacde", "src_set": ""}, "body": "はじめまして！\nいつも素敵なイラストを拝見させていただいております。先生の柔らかなタッチで描かれる美しい風景と、その中で生きる人々の絵が大好きです。\n\nこの度はOCのイラストをご依頼させていただきたく、リクエストを失礼いたします。赤髪の男性と緑/白髪の男性の二人になります。\nよろしければご検討いただければ幸いです。\n\n【人物詳細】\n🍎赤髪碧眼\n外見：身長200cm　シンプルな服装　黒手袋　眼帯　長髪1つ結び\n図体が大きく眼帯をしているため他人に怖がられがちな外見だが、かわいいものやお花や人の面倒を見ることが好き。料理、家庭菜園が趣味。穏やかで争いごとが苦手な気弱で、ロマンチストで愛情深い。ご飯を食べる彼を見るのが好き。\n\n🍏緑/白髪\n外見：身長166cm　暖かそうな服装　オッドアイ　ハーフアップ\nいつも笑顔で陽気な性格。好奇心が旺盛で悪戯したがりで、楽しいこと、美しいもの、心躍るようなものが好きだが、特にご飯を食べることが大好き。人に感化されやすいため泣いて笑ってと動作が大きく、子供のような言動が多い。彼の作るご飯がお気に入り。\n目は点灯する豆電球と切れた豆電球がモチーフ。\n\n【二人の関係性】\n友人以上の特別な何か、名前の無い関係です。お互いが唯一無二であり、北の国で二人で一緒に暮らし、お互いの幸せを願っています。\n兄と弟のような、父と子のような、恋人のような、対等な何かのような。木漏れ日の光のような温度の、あたたかでどこまでも優しい二人です。\n\n【構図等】\nイメージ、テーマ、構図等すべて先生に一任いたします。\nもしよければ日常を切りとったような絵や、植物、食事などの要素・モチーフがありますと嬉しいです。\n\n【キャラクター作成者】\n赤髪の男性が私、緑/白髪の男性がフォロワーさんです。当依頼に使用することの許可はいただいております。\n\n【使用用途】\n個人での鑑賞\nSNS（Twitter、discord）にてアイコン等での使用※可能であれば\nグッズ化（個人観賞用）\n\n【その他指定】\n画像サイズ、画像解像度、すべてお任せいたします。服装も変更大歓迎です。\nグッズ制作用にサインなし差分（もしくはサインレイヤー非表示可なpsdデータ）もいただけるとうれしいです\n\n金額不足等ございましたら送り直させてください…！\n御縁がございましたら、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1DVmibeeQeF9c6Rx5ch25-qYCCPbsOlq6?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unknown_ooo_/works/237", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 878969, "client_id": 1660837, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa3d2398/uploads/origins/df5d764b-d9fc-4d81-be9e-cdd3b14df105?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6cda7454ad75466095d878e96a3485b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa3d2398/uploads/origins/df5d764b-d9fc-4d81-be9e-cdd3b14df105?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=636e180def043461ae1cb6aca7be49f2", "src_set": ""}, "body": "はじめまして。\n\n先生の描かれる雰囲気やキャラクターの表情が本当に大好きで、ぜひお願いしたいと思い、リクエストを送らせていただきました。そしてこの作品で（https://skeb.jp/@unknown_ooo_/works/229）の色使いがとても大好きです。\n\n双子のオリジナルキャラクター2人が春の庭園にいるイラストをお願いしたいです。背景には春らしい花々が咲く穏やかな庭園があり、二人と一緒に、彼らが一緒に暮らしている魔女の飼っている小さな鳥も描いていただけると嬉しいです（魔女本人は絵には登場しません）。\n\n参考\n- 双子：https://1drv.ms/f/c/52dfaa228a55c8ad/Ep4WiaZsHylDiMTfZAiZ8jwBeDTgoCYHPKuL6na3U4ZZDw?e=YWnxUD\n- 魔女の鳥：https://1drv.ms/i/c/52dfaa228a55c8ad/Ea3IVYoiqt8ggFLRNQEAAAABq24usmPSwk7OAiJL6D1dmQ?e=WKJVLQ\n\n【兄】\n紫色のゼラニウムの花の精。身長180cm。穏やかで誠実な性格。読書、執筆、絵を描くことが好きです。眼鏡をかけています。\n\n【弟】\n同じく紫色のゼラニウムの花の精。身長180cm。甘い笑顔が特徴で、軽薄ながらもとても元気でおしゃべりな性格です。\n\nもし提示した金額がご希望に合わない場合は、希望額を教えていただけると幸いです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unknown_ooo_/works/236", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 878969, "client_id": 1963713, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3918c302/uploads/origins/b775fe50-bd37-43d0-9c08-4a8bb2ac792e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f172fd00e6138e9dca9a7d4dc9254d28", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3918c302/uploads/origins/b775fe50-bd37-43d0-9c08-4a8bb2ac792e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44c1b68e5cb29076c72399c2e0932610", "src_set": ""}, "body": "こんにちは、私はあなたの背景やキャラクターの描き方が大好きです！\n\n下の私のVTuberのキャラクターの絵をリクエストしてもいいですか？\nhttps://drive.google.com/drive/folders/1pLIhpb0xndHwZh7DfapN_3xiOhuGr