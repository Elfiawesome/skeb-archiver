はかなり気を使っており、食事制限やジムに通ったりなど、徹底している\n\n🍁秋篠嗾央(あきしの すおう)  19歳\nアイドルグループ｢est▲c!óN｣のリードボーカル。\nモチーフは｢秋｣ 。超気分屋。\nずっとヒーローに憧れている青年。\n口が巧いが嘘は嫌い。\n\n・赤髪。インナーカラーは茶色。\n水色メッシュ4束。根本も茶髪(茶は地毛)\n外ハネヘアで右耳の下で三つ編みにしてる(３つ)\n・黒の三角のピンをつけてる\n・髪の長さはギリギリ肩つくかな？くらい\n・黄色目。二重つり目下まつ毛あり。上まつ毛1。ハイライトは控えめ\n・八重歯\n\n何卒ご検討いただけますと幸いです🙇🏻‍♀️‪‪\n\nhttps://drive.google.com/drive/folders/1UT3rxUM9v8FCbH55RAmfxZLIksREDyms", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 2830357, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ども", "screen_name": "domo_iroiro", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-557c4c44-5542-4cd0-a084-fe6308a5ebf7.png&avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 17}, {"id": 2947405, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "飼育係", "screen_name": "metoo_009", "avatar_url": "https://pbs.twimg.com/profile_images/2055903656269271040/XI1ImHqQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1559114866937409538/1770990448/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 1}, {"id": 3404498, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "はちごり", "screen_name": "3hatiti", "avatar_url": "https://pbs.twimg.com/profile_images/2028538006953771008/hfWfRPBY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2857662289/1759705220/1500x500", "appeal_receivable": false, "popular_creator_rank