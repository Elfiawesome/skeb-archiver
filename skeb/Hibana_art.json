左右が見切れないように描いていただけると大変ありがたいです。\n・背景と人物を分けたPSDデータで頂けたらうれしいです！\n\n是非ご検討の程よろしくお願いします<(_ _)>\n\nhttps://drive.google.com/file/d/1vGgZjTX_R40ph5zRi7PDTbO6X-EBe4WC/view?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hibana_art/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3267014, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/572d8ff3/uploads/origins/8f40636c-3732-4572-9e17-8f4fd4ce347f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fb61cea33d2800d5c8c1a91eded0450", "srcset": "https://si.imgix.net/572d8ff3/uploads/origins/8f40636c-3732-4572-9e17-8f4fd4ce347f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fb61cea33d2800d5c8c1a91eded0450, https://si.imgix.net/572d8ff3/uploads/origins/8f40636c-3732-4572-9e17-8f4fd4ce347f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c7e1f16ce590d027ecb2daaf2b7d04a 2x, https://si.imgix.net/572d8ff3/uploads/origins/8f40636c-3732-4572-9e17-8f4fd4ce347f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=121977e63bd5482a3bff5c90d56726b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/572d8ff3/uploads/origins/8f40636c-3732-4572-9e17-8f4fd4ce347f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ae2da17bf88ea6107f1e876bc73e1ae", "srcset": "https://si.imgix.net/572d8ff3/uploads/origins/8f40636c-3732-4572-9e17-8f4fd4ce347f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ae2da17bf88ea6107f1e876bc73e1ae, https://si.imgix.net/572d8ff3/uploads/origins/8f40636c-3732-4572-9e17-8f4fd4ce347f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=597aa0ce5088406f1968a295f732ac4b 2x, https://si.imgix.net/572d8ff3/upl