て！\n絵柄が素敵だったのでご依頼しました。\nもしよろしければ、うちのOCの「鮫氷しゃち」をお願いすることは可能でしょうか？ \n参考までに設定は以下のとおりですが、自由に描いていただいて構いません。\n███\n鮫氷 しゃち（さめすが しゃち）\n細身かつ色白の黒髪ロングストレート。\n白と黒を基調にしたセーラー服にセーラーキャップを着こなす。\nアイドル的な元気さと明るさに加え、清楚で可憐な容姿をしている。 \n好奇心旺盛で趣味はテーマパーク巡りと人間観察。\nかなりの偏食家で、気に入ったものはヘビロテする。その一方で飽きるのも早い。  \n親しい間柄の相手でさえ巧みに感情を操って都合よく利用する。\nその言動はどこか演技的で大げさ。\n先天的に共感性が欠落しており、一見感情のように見えるものは人間観察の結果身に着けたものでしかない。\n███\n宛名・背景はpsdでon/offできると幸いです。\n使用用途は個人活動全般(小説の挿絵等、SNSや個人サイト等でのキャラクター紹介・個人活動の告知等、コミッションでのリクエストのための参考資料等)を考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-SYOhrcumcIbsEfp2JMqVwCRCTwvWyoS", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oinomori_sora/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 903869, "client_id": 159911, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a450b39/uploads/origins/8bc224d9-0fa3-42b0-ad2c-76d011e94fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=033a10484a6783ef6dfb118e4ac1b812", "srcset": "https://si.imgix.net/1a450b39/uploads/origins/8bc224d9-0fa3-42b0-ad2c-76d011e94fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=033a10484a6783ef6dfb118e4ac1b812, https://si.imgix.net/1a450b39/uploads/origins/8bc224d9-0fa3-42b0-ad2c-76d011e94fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=802f7cd86418c71fd2574f9eeeb44d9f 2x, https://si.imgix.net/1a450b39/uploads/origins/8bc224d9-0fa3-42b0-ad2c-76d011e94fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33164ea01e81e75695e7e9a025fba3d5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a450b39/uploads/origins/8bc224d9-0fa3-42b0-ad2c-76d011e94fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efec8b1ab15e1386c2c39e3832830039", "srcset": "https:/