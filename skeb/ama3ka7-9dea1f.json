_same_genre": true}, {"path": "/@ama3ka7/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "correction", "tipped": false, "creator_id": 3648696, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/829f5eb3/uploads/origins/0b3305a6-df06-4211-80f0-7f4d15fcaa8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=669d435faa9ec76653a2870612ac0be4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/829f5eb3/uploads/origins/0b3305a6-df06-4211-80f0-7f4d15fcaa8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=845643625957210779e556f5754dd46c", "src_set": ""}, "body": "ポンタんぽと申します。\nアドバイスをリクエストします。\n聞きたいことは\n①肌の塗り方。\n②厚塗り、色の重ねです。（聞きたいのは肌と髪が主）\nあまり細かいことを聴いても、消化出来ないと思うのでその2点にしぼりました。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ama3ka7/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3648696, "client_id": 3680764, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1d0ad4e/uploads/origins/16e00c0b-a839-4d80-93f1-80c5a91f1a46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70a0080f51cb3860f3eacfc678c6780e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1d0ad4e/uploads/origins/16e00c0b-a839-4d80-93f1-80c5a91f1a46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d3c61b5c6e58959c578d13e02ab843f", "src_set": ""}, "body": "初音ミクの1枚絵で依頼します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ama3ka7/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3648696, "client_id": 359538, "vtt_url": null, "thumb