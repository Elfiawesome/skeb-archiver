\n今回のイラストは、海賊船の机上で戦っている感じを出したいです。エミリーはルルの後ろに立っていて、とても心配そうにしています。ルルは正面にいて、ナイフを持ちエミリーを守ろうとしています。そして、その他の要素もお任せします。\n\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1NkDYdoM0bBW4qjLKrF_sNjpmAnCa8Zew?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@9tails_japan/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2150903, "client_id": 42860, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5a4de65/uploads/origins/f6465d7b-1ae3-42ec-950d-173ae0b20130?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4584a11208a3ce1a137d71e0fb404ac5", "srcset": "https://si.imgix.net/c5a4de65/uploads/origins/f6465d7b-1ae3-42ec-950d-173ae0b20130?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4584a11208a3ce1a137d71e0fb404ac5, https://si.imgix.net/c5a4de65/uploads/origins/f6465d7b-1ae3-42ec-950d-173ae0b20130?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0c3f18e01fa45833bdc036d1b68d9a0 2x, https://si.imgix.net/c5a4de65/uploads/origins/f6465d7b-1ae3-42ec-950d-173ae0b20130?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=673254648b3696b3e82c3623b7500a1d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5a4de65/uploads/origins/f6465d7b-1ae3-42ec-950d-173ae0b20130?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=daec73bd7a2865f5e40979fd4d4644f5", "srcset": "https://si.imgix.net/c5a4de65/uploads/origins/f6465d7b-1ae3-42ec-950d-173ae0b20130?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=daec73bd7a2865f5e40979fd4d4644f5, https://si.imgix.net/c5a4de65/uploads/origins/f6465d7b-1ae3-42ec-950d-173ae0b20130?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2b8d