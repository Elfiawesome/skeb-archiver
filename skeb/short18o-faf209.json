物怖じのなさ。\nカーティスが15歳の時に出会ってから、ベタベタに甘やかされているためロリコン疑惑がしばらく浮上したが、年齢を重ねても態度が変わらないため病気なんだと思っている。\n\n【使用用途】\n個人観賞/アイコン/キャラクターシート/各種SNSでの(書いていただいたことを記載した上での)公開\n\n資料少なく申し訳ございません。\n内容や金額に問題ありましたら、キャンセルしてください〇\n\n資料：https://photos.app.goo.gl/jiY6gwSbSRLrfBCh6\n\nhttps://photos.app.goo.gl/jiY6gwSbSRLrfBCh6", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@short18o/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8181468a/uploads/origins/4b703587-2995-4090-b9ea-5041a2b6abfc?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa3a7acbd67d08e12de962c1129f31b6", "srcset": "https://si.imgix.net/8181468a/uploads/origins/4b703587-2995-4090-b9ea-5041a2b6abfc?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa3a7acbd67d08e12de962c1129f31b6, https://si.imgix.net/8181468a/uploads/origins/4b703587-2995-4090-b9ea-5041a2b6abfc?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=70796dc8ea780db1deea98d9ce6fe7a6 2x, https://si.imgix.net/8181468a/uploads/origins/4b703587-2995-4090-b9ea-5041a2b6abfc?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8274debd84c5d55c162ca744c8259a7f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3200724, "nc": 145}, {"path": "/@short18o/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3200724, "client_id": 537690, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3cce2bca/uploads/origins/6629c2c9-0e9f-459a-afac-a259713c91e8?bg=%23fff&fm=webp&auto=compress&