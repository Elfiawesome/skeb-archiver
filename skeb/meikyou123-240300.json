\n\n・アル（目付きが悪い、エナジーバーを齧っている）\n　愛想が悪く正論パンチしがち。頭脳明晰。\n\n・ロディ（オレンジの髪、ドーナツを持っている）\n　明るく愛嬌があるムードメーカー。姉が3人いる。\n\n・アマリア（女性、褐色肌）\n　チームの年長者。精神的に安定している。\n\nhttps://drive.google.com/drive/folders/1BCKtAT-2o6YsKBiNqKZIc4DpJS7LcAbD", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@meikyou123/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1307640, "client_id": 3253671, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8cc3467/uploads/origins/3b66adc7-93ae-4202-b6ce-2e9ee4f19a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35fb03615d149ec925e7e5fe6df1e7cf", "srcset": "https://si.imgix.net/a8cc3467/uploads/origins/3b66adc7-93ae-4202-b6ce-2e9ee4f19a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35fb03615d149ec925e7e5fe6df1e7cf, https://si.imgix.net/a8cc3467/uploads/origins/3b66adc7-93ae-4202-b6ce-2e9ee4f19a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67fc66e5c958b64a42fe752839b6f812 2x, https://si.imgix.net/a8cc3467/uploads/origins/3b66adc7-93ae-4202-b6ce-2e9ee4f19a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e27e5ff5af1aea98e722f918e633ef86 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8cc3467/uploads/origins/3b66adc7-93ae-4202-b6ce-2e9ee4f19a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=108931223565b6728290e445fed34582", "srcset": "https://si.imgix.net/a8cc3467/uploads/origins/3b66adc7-93ae-4202-b6ce-2e9ee4f19a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=108931223565b6728290e445fed34582, https://si.imgix.net/a8cc3467/uploads/origins/3b66adc7-93ae-4202-b6ce-2e9ee4f19a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0d6e2d