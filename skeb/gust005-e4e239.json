/uploads/origins/2f3204ad-7129-43f5-a31b-6b44b9d118dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e97c989a46128a2ef78abba2dcb5540a 2x, https://si.imgix.net/204d039a/uploads/origins/2f3204ad-7129-43f5-a31b-6b44b9d118dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a63991322bfd93dd714788ee05681d6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/204d039a/uploads/origins/2f3204ad-7129-43f5-a31b-6b44b9d118dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d00262d40a0510580209dc1f4aea4e5a", "srcset": "https://si.imgix.net/204d039a/uploads/origins/2f3204ad-7129-43f5-a31b-6b44b9d118dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d00262d40a0510580209dc1f4aea4e5a, https://si.imgix.net/204d039a/uploads/origins/2f3204ad-7129-43f5-a31b-6b44b9d118dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8f9c8a29dfb73df56905fdf2dc8b620c 2x, https://si.imgix.net/204d039a/uploads/origins/2f3204ad-7129-43f5-a31b-6b44b9d118dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5aa81ddb461ba4433b8e7c55cbbfa012 3x"}, "body": "アピールありがとうございます、改めてこちらより古明地さとりの等身大パネル用全身イラストをお願いします。\n\n用途につきましては古明地さとり15周年「さとり万博」と称し、各種企画を実施しており、その一つとして「古明地さとり等身大パネル展示」を実施しております。\nその為、多種多様な古明地さとりを一堂に会すべく依頼を行っております。\nパネルサイズは90cm×180cmのパネルを使用するため、72dpiで2500×5000pix程度(高さは身長150cm設定で4200pix程度)を希望しますが仔細はお任せします。\n服装等のアレンジについても指定はありませんのでご自由にお願いします。\nただ、全年齢向けスペースでの公開となりますので１８禁にならない様にお願いします。\n\n使用用途につきましては等身大パネルの作成、イベント限定の頒布グッズ(10周年記念の際は缶バッジガチャの缶バッジ、および当たり用のTシャツ、マグカップ等を作成)、秋季例大祭において提供頂いた等身大パネル用イラストのまとめ本の頒布を予定しております。パネル、まとめ本にはイラスト提供者のお名前のほか、twitterのID等を付けさせていただく予定です。\n\nパネル展示につきましては、第１回目を例大祭の前日に秋葉原で第２回目東方名華祭での名華祭Xスペースでの展示として実施いたしました。\n今後につきましては夏コミ後に秋葉原での個別展示、東方椰麟祭、東方紅楼夢でのフリースタイルスペース、秋季例大祭での持ち込み企画による会場内展示を予定しております。それ以外にも調整がつけば地方での展示も検討いたします。\n\n\n資料URLのリンクは等身大パネル企画の一般向けサイトになります。１回目の展示のビデオ、既にご提供頂いているイラストの公開等を行っておりますのでご参考ください。\n\nhttps://r-nolandia.wixsite.com/satori-expo2023/%E7%AD%89%E8%BA%AB%E5%A4%A7%E3%83%91%E3%83%8D%E3%83%AB%E5%B1%95%E7%A4%BA%E4%BC%9A", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gust005/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/290927aa/uploads/origins/373d96fa-f81f-414e-9ec3-87d8c6459db3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef5d6b8d5f9fb29879836a79a1684665", "srcset": "https://si.imgix.net/290927aa/uploads/origins/373d96fa-f81f-414e-9ec3-87d8c6459db3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef5d6b8d5f9fb29879836a79a1684665, https://si.imgix.net/290927aa/uploads/origins/373d96fa-f81f-414e-9ec3-87d8c6459db3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed720cacfc4076d08e76a1ef58b639a9 2x, https://si.imgix.net/290927aa/uploads/origins/373d96fa-f81f-414e-9ec3-87d8c6459db3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85ae949a80f8ecb1cd374d2b1e3e4072 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 111630, "client_id": 43835, "nc": 177}, {"path": "/@gust005/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 111630, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72d7d917/uploads/origins/5f64f9ff-e9a1-4ddc-a3b6-730b215af58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40de147b708