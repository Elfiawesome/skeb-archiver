るよう指示され従っている\n・麻雀卓に座って牌に触れている格好を机を透かして全身が写る構図\n・おもちゃの快楽で上気してパンツ、椅子を愛液で濡らしてしまっている\n・相手のイカサマの糸口を全く掴めていない上に、乳首と秘所のおもちゃから与えられる快楽と恥ずかしさで麻雀に集中できず弱気になっている様子\n・効果線、セリフなどがあるイラストでお願いします\n\nよろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gust005/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/545455eb/uploads/origins/1235d51a-d429-4db9-b829-e7e77f3ef870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f06fe2208230807de28f3de71a9fa96", "srcset": "https://si.imgix.net/545455eb/uploads/origins/1235d51a-d429-4db9-b829-e7e77f3ef870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f06fe2208230807de28f3de71a9fa96, https://si.imgix.net/545455eb/uploads/origins/1235d51a-d429-4db9-b829-e7e77f3ef870?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=420da7bfd1e98c064f8b4ce83e84a952 2x, https://si.imgix.net/545455eb/uploads/origins/1235d51a-d429-4db9-b829-e7e77f3ef870?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50f7777ec3899af0625beed2cf6759ba 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 111630, "client_id": 300416, "nc": 176}, {"path": "/@gust005/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 111630, "client_id": 9813, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/685e29d4/uploads/origins/ad15653a-f211-44b0-9a79-e467d8ea2062?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=756ab0671889