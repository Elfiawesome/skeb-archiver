8c0-721c-4b28-92a2-c792e411e1ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6d6333b7b404eb41b8a91eecd54ae9a, https://si.imgix.net/759b0d4f/uploads/origins/498488c0-721c-4b28-92a2-c792e411e1ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c90a8e5b02eddebc77ab26a7055da2f9 2x, https://si.imgix.net/759b0d4f/uploads/origins/498488c0-721c-4b28-92a2-c792e411e1ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=918092182f29fa96ceec05d3920723df 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/759b0d4f/uploads/origins/498488c0-721c-4b28-92a2-c792e411e1ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50f215be47e85b72346f1f928482ec4b", "srcset": "https://si.imgix.net/759b0d4f/uploads/origins/498488c0-721c-4b28-92a2-c792e411e1ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50f215be47e85b72346f1f928482ec4b, https://si.imgix.net/759b0d4f/uploads/origins/498488c0-721c-4b28-92a2-c792e411e1ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d421867c553559d4628c5bd7d97968de 2x, https://si.imgix.net/759b0d4f/uploads/origins/498488c0-721c-4b28-92a2-c792e411e1ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e51c7443b04c372c3b37dcbb5df4c5ae 3x"}, "body": "skebを募集中と知ったのでリクエストさせて頂きます。\n\n霧雨魔理沙がスカートをめくっている姿をお願いいたします。\n\n服のデザインは永夜抄のイメージで、帽子を被せてほしいです。\n表情はニコッとしつつも照れている感じ（頬にピンク色）にして頂ければと思います。\n\n足は肩幅くらいまで開き、スカートは両手でめくって白色に赤い小さなリボン付きのパンツが丸見えになっている状態が希望です。\nまた、全身を描く必要はなく、ひざあたりまで描いて頂ければ十分です。\n\n可能であればパンツを太もも辺りまで下げてアソコを見せている差分もあると嬉しいです。\n\n以上の内容でご検討をお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gust005/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 111630