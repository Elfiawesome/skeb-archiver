ge", "creator_acceptable_same_genre": true}, {"path": "/@8OVsUlPdFx36771/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c6489635/uploads/origins/0ae0300c-e533-43de-834f-5adc1be63335?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce74f8c4bf334e227a7f337666c34feb", "srcset": "https://si.imgix.net/c6489635/uploads/origins/0ae0300c-e533-43de-834f-5adc1be63335?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce74f8c4bf334e227a7f337666c34feb, https://si.imgix.net/c6489635/uploads/origins/0ae0300c-e533-43de-834f-5adc1be63335?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13e52c9eca811635482995dbf9b49a4e 2x, https://si.imgix.net/c6489635/uploads/origins/0ae0300c-e533-43de-834f-5adc1be63335?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3fed317cad56f4be22276eec42dafa5 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 3743380, "client_id": 5681, "nc": 33}, {"path": "/@8OVsUlPdFx36771/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/48635aa6/uploads/origins/df81742c-1c75-4e47-adb5-188dc8dea90b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a9739c5eb8c9e3cd80fb94ed26d6523", "srcset": "https://si.imgix.net/48635aa6/uploads/origins/df81742c-1c75-4e47-adb5-188dc8dea90b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a9739c5eb8c9e3cd80fb94ed26d6523, https://si.imgix.net/48635aa6/uploads/origins/df81742c-1c75-4e47-adb5-188dc8dea90b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11331e696d770dc0e29667f45196c31f 2x, https://si.imgix.net/48635aa6/uploads/origins/df81742c-1c75-4e47-adb5-188dc8dea90b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c10cc4ac67233735a2c7d61c676dbf9c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3743380, "client_id": 37710, "nc": 50}, {"path": "/@8OVsUlPdFx36771/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3743380, "client_id": 339181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94cb1986/uploads/origins/6f7c42dc-74e6-4b95-abf5-aa38383b7ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8f90b7dc00fb676df5a6c870cd6d4a7", "srcset": "https://si.imgix.net/94cb1986/uploads/origins/6f7c42dc-74e6-4b95-abf5-aa38383b7ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8f90b7dc00fb676df5a6c870cd6d4a7, https://si.imgix.net/94cb1986/uploads/origins/6f7c42dc-74e6-4b95-abf5-aa38383b7ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eff66f33773f9ab41d8cc79bf86cccd8 2x, https://si.imgix.net/94cb1986/uploads/origins/6f7c42dc-74e6-4b95-abf5-aa38383b7ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a9ad86865aa3e58dbbc6208f949df66 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94cb1986/uploads/origins/6f7c42dc-74e6-4b95-abf5-aa38383b7ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b695856a642b5aa397692579da11d928", "srcset": "https://si.imgix.net/94cb1986/uploads/origins/6f7c42dc-74e6-4b95-abf5-aa38383b7ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b695856a642b5aa397692579da11d928, https://si.imgix.net/94cb1986/uploads/origins/6f7c42dc-74e6-4b95-abf5-aa38383b7ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9a54ab363afa52ca77b945d3fc879bf2 2x, https://si.imgix.net/94cb1986/uploads/origins/6f7c42dc-74e6-4b95-abf5-aa38383b7ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=70968d439cf1884504333fae8776cfdf 3x"}, "body": "リクエストお願いします\n恐らくジャンル外そうで恐縮ですがグラブルのノーマル服ジータちゃんを複数構図で即落モノみたいなものを可能であればこの予算で2枚位描いて頂けるとありがたいです\nシチュですが女の子に悪さをしている質の悪い輩をやっつけにに来たジータちゃん、強さ実力では負ける訳がないものの人質等汚い手段をとられてしまったためしこたまめっためたに犯られてしまう…と言った感じですが特に具体的に描く必要はなくあくまで描きやすくするイメージと思ってもらえればと思います\n・即落モノという事で冒頭可愛くも強そうで少し動きがあるような即落後の無様さが際立つ様素敵な感じのジータちゃんを１カットお願いします\n・竿役はグラブルでよくあるドラフ等ではなくただのちんぽがつよつよなヤリチンチャラ男イメージ\n・冒頭ジータちゃんは舐めてるわけではないが余裕ありげに軽くお灸をすえに来てる感じでその後は無様にあへおほ啼かされ、竿役は普通だと勝てない強いジータちゃんを舐めた口叩かれた分おらおらの暴力的だったり辱める様な卑猥な台詞や言葉責めで肢体を貪り楽しんでいるような描写多めだと捗ります\n・ジータちゃんは強いが所詮は男には勝てないと思わせるような羽交い絞めや抑えつけ、頭や腕や脚をガシッとするような乱暴なプレイや描写　\n・事後あへぴく状態の描写が性癖で特にちんぽ目隠しが好きなので最後にジータちゃんの頭や髪の毛をガシッと掴み少し上を向かせた状態で顔面にちんぽを乗せる感じで目隠しをしてほしいです。出来ればモザ処理ではなく黒海苔でお願いしたいですがセンシティブな事なので本当に可能であればで大丈夫です。モザ処理の場合目隠れ状態になる全頭マスク目隠しや顔面にコンドームで目隠しするなどそういった感じの何かでお願いします\n・しこたまめっためたに犯されたとわかる中出しや縮れ毛、使用済みゴム、ぶっかけ精液痕玩具等々といった描写\n・ちんぽにわからされちん負けするが淫乱化はしてほしくなくボテ腹化もなしの方向で\n・一先ずは犯られ終わったがその後もまだまだ続くような〆\n・強くも可愛いジータちゃんがチャラ男に下品に好き放題犯され無ザマにちん負け\n\nリクエスト文は好き放題書いてますがチェリー肉汁パイ先生のウルキオラちゃんの作品がエロく好きなので描くのに困るようであれば先生の解釈で描いて頂ければ問題ありませんので検討よろしくお願いします", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@8OVsUlPdFx36771/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3743380, "vtt_url": null, "thumbnail_image_urls": {"src": "https://s