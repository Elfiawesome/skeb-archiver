r=200&s=14ac228c340392b7dbb82807d5b81bea, https://si.imgix.net/c250fff1/uploads/origins/45592cd1-445e-410b-80d9-487559befd3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=062d9ce383bd583fc5556b5f912ad3a9 2x, https://si.imgix.net/c250fff1/uploads/origins/45592cd1-445e-410b-80d9-487559befd3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a123684953a278e92b6682f63889d429 3x"}, "body": "こんにちは、Beさん！はじめまして！🙇\n\n私のキャラクター、トラの高校生「RIN」のイラストをお願いしたいです！🐯\n\nもしよろしければ、ポーズや構図、シチュエーション、背景などはすべてお任せしたいです！\nあなたの画風はとてもキュートなので、私のキャラクターがあなたの手で描かれるとどうなるのか、本当に楽しみです！ぽっちゃりしたケモノキャラも、あなたのスタイルならきっと素敵になると思います！😊\n\nhttps://drive.google.com/drive/folders/1rQvgvXqPgJnajcv4BOMGmZ0CpwXIECvQ", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BEEEEkemo/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3854626, "client_id": 1440417, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf229a01/uploads/origins/c511cff4-7b14-4515-bdbd-6e300615b077?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d8ac16b70e70b0a5d3b03d8045be68b", "srcset": "https://si.imgix.net/bf229a01/uploads/origins/c511cff4-7b14-4515-bdbd-6e300615b077?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d8ac16b70e70b0a5d3b03d8045be68b, https://si.imgix.net/bf229a01/uploads/origins/c511cff4-7b14-4515-bdbd-6e300615b077?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ed101761587cea4d75e546ab0e89253 2x, https://si.imgix.net/bf229a01/uploads/origins/c511cff4-7b14-4515-bdbd-6e300615b077?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a81e3ff6a821bb700a7c8e8144301bd9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf229a01/uploads/origins/c511cff4-7b14-4515-bdbd-6e300615b077?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0f3bb8474291c373bc1580ea4a9a27c", "srcset": "https://si.imgix.net/bf229a01/uploads/origins/c511cff4-7b14-4515-bdbd-6e300615b077?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0f3bb8474291c373bc1580ea4a9a27c, https://si.imgix.net/bf229a01/uploads/origins/c511cff4-7b14-4515-bdbd-6e300615b077?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4cfed838847d0055654735980c72c322 2x, https://si.imgix.net/bf229a01/uploads/origins/c511cff4-7b14-4515-bdbd-6e300615b077?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8bc37d18ff4c0881947e2a996b027039 3x"}, "body": "こんにちは、先生のイラストがとても気に入っています。\nもしよろしければ、二人組のイラストをご依頼したいです。\n\nキャラクターは「鍾銘」と「Benben」です。\n鍾銘は黄色のパーカーを着たゴールデンレトリバー、Benbenはオレンジ色のわんちゃんです。\n\nテーマは、二人で仲良くデザート作りをしているシーンです。\nBenbenはお菓子を作る側、鍾銘はこっそり味見をしている助手、というイメージです。\nポーズや表情、構図などは先生の描きやすい形で自由にお任せできれば嬉しいです！\nよろしくお願いいたします。\n\n【キャラクター資料】\n・鍾銘：https://drive.google.com/drive/folders/1a7Cbr7qHf50Ca2sCYj8V-ChQx0oe1o4S?usp=sharing\n・Benben：https://drive.google.com/drive/folders/1n_AF4-TkNxm4FPO4iG_6fI2IGB_Mazl0?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BEEEEkemo/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3854626, "client_id": 235340, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2cf20747/uploads/origins/334a2d1c-cd60-4818-91ac-5a2822a7eb5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e7cae8194f5286a4fec222be447da43", "srcset": "https://si.imgix.net/2cf20747/uploads/origins/334a2d1c-cd60-4818-91ac-5a2822a7eb5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e7cae8194f5286a4fec222be447da43, https://si.imgix.net/2cf20747/uploads/origins/334a2d1c-cd60-4818-91ac-5a2822a7eb5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92328195be3ad76d8441fe92a1687dea 2x, https://si.imgix.net/2cf20747/uploads/origins/334a2d1c-cd60-4818-91ac-5a2822a7eb5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=709323cc5a6bfd37bbf2f474d9f12779 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2cf20747/uploads/origins/334a2d1c-cd60-4818-91ac-5a2822a7eb5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9af926e77cc340e102c8fa2808b2f1f", "srcset": "https://si.imgix.net/2cf20747/uploads/origins/334a2d1c-cd60-4818-91ac-5a2822a7eb5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9af926e77cc340e102c8fa2808b2f1f, https://si.imgix.net/2cf20747/uploads/origins/334a2d1c-cd60-4818-91ac-5a2822a7eb5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97230417d4ac15f82348aea2a0216398 2x, https://si.imgix.net/2cf20747/uploads/origins/334a2d1c-cd60-4818-91ac-5a2822a7eb5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0279ded3970c387e85c5e63d6d1ab09e 3x"}, "body": "先生、こんにちは。先生の絵が大好きです。ぜひ私のキャラクターを描いていただけませんか！\n名前は「竜珀」で、ちょっとぽっちゃりした毛むくじゃらのドラゴンです。少し恥ずかしがり屋で、服を着ずにベッドで寝ている姿にしてください。両手はまるで壁に押し付けられたかのようにベッドに置かれていて、股間にはふわふわした毛が生えている感じにしてほしいです。それ以外は先生にお任せします。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1ibeWTb13NrUVZGdYwz5RIuLIy2ZVwz0a?usp=drive_link", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BEEEEkemo/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3854626, "client_id": 84604, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/236e6c8f/uploads/origins/382c13e8-1262-47bc-bdfe-f46fed4a419c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71ab9377059641479fcb38215b944e01", "srcset": "https://si.imgix.net/236e6c8f/uploads/origins/382c13e8-1262-47bc-bdfe-f46fed4a419c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71ab9377059641479fcb38215b944e01, https://si.imgix.net/236e6c8f/uploads/origins/382c13e8-1262-47bc-bdfe-f46fed4a419c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a30b5f87b7144ad71e10edd06afba703 2x, https://si.imgix.net/236e6c8f/uploads/origins/382c13e8-1262-47bc-bdfe-f46fed4a419c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ce56a6250b215f86df2409e30af09fe 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/236e6c8f/uploads/origins/382c13e8-1262-47bc-bdfe-f46fed4a419c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a800461df3c5c51a60a799af0eccea2f", "srcset": "https://si.imgix.net/236e6c8f/uploads/origins/382c13e8-1262-47bc-bdfe-f46fed4a419c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a800461df3c5c51a60a799af0eccea2f, https://si.imgix.net/236e6c8f/uploads/origins/382c13e8-1262-47bc-bdfe-f46fed4a419c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=19065749e1e46f99e0ac327a04b511f5 2x, https://si.imgix.net/236e6c8f/uploads/origins/382c13e8-1262-47bc-bdfe-f46fed4a419c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=40f4d6a86ccfd49fae9e1b6dca7c4012 3x"}, "body": "◆学ラン褌（団服）姿のレンシアと神様くんのシチュ\n神様くんに人前だとどうしても恥ずかしく緊張してしまうから一人で練習に来ていた事を知られ、人前でも堂々と出来るようになるよと言われ、それを叶えてもらう事に。 \n例の願いを叶えるための交換条件を受け戸惑いながらも神様くんに委ねるレンシア。 レンシアの褌に手を入れて一物（ケモチン）を扱き弄り精を出そうとする神様くん。 レンシアの一物はふんどしの中で形だけ少し分かるまたは見えてしまっているなどはお任せします。\nレンシアは団服姿のままで、二人共表情が見えるような構図希望です。\n\n【レンシア】\n鼻元が毛色境、耳先に垂れ毛、頬毛あり、手足の薄茶体毛は手袋や足袋からはみ出します。\n額に水色ヤジリマークあり\n年齢：12歳設定ですがまだまだケモショタです\n団服衣装：学ラン、赤褌（黒猫か六尺）、肉球マーク入り腕章、手袋、長ハチマキ、タスキ、足袋着用。 学ランは襟に水色のストライプ（左襟に学年章１）が入ります。\n学ランの前ボタンは下側２〜３個は外されて（ホックや上のボタンは留めたまま）お腹などが大きく見えてしまってる感じを希望です。\n\n資料はURL参照願います。\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1zWJeC27_6i-xf5V4ExZgz26QrnRbyw7m?usp=sharing", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BEEEEkemo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3854626, "client_id": 136776, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f197b34/uploads/origins/82894364-486c-44c1-b185-54188df22daa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=206c10ce853fd47e9f58bae56c5762ae", "srcset": "https://si.imgix.net/7f197b34/uploads/origins/82894364-486c-44c1-b185-54188df22daa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=206c10ce853fd47e9f58bae56c5762ae, https://si.imgix.net/7f197b34/uploads/origins/82894364-486c-44c1-b185-54188df22daa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50ea484c78c31b6eee794b69ab7fd15d 2x, https://si.imgix.net/7f197b34/uploads/origins/82894364-486c-44c1-b185-54188df22daa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36365bd3e875c7b842e0718d2b56f6ac 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f197b34/uploads/origins/82894364-486c-44c1-b185-54188df22daa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c32c30c9d037bbd2fd7869c3f034076c", "srcset": "https://si.imgix.net/7f197b34/uploads/origins/82894364-486c-44c1-b185-54188df22daa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c32c30c9d037bbd2fd7869c3f034076c, https://si.imgix.net/7f197b34/uploads/origins/82894364-486c-44c1-b185-54188df22daa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=54899f3c8691bf1a65a831d