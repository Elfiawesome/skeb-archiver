ff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=66dda0557ba3b1ba14edf5a20f948bec 3x"}, "body": "初めましてりょーつ様　うちの娘のリクエストお願いできないでしょうか。\n\n・白髪ロングヘアーのオッドアイの白九尾の狐娘になります。\n・尻尾・耳もかいていただけたらと思います。\n・胸やお尻、フトモモは大きくムッチリかいていただけないでしょうか。\n\n・希望のシチュエーションは和風の花嫁衣装でお願いできないでしょうか（色は白赤ベースでお願いします）\n　うちの子の参考画像は下に置いておきます。①のように胸元が開いている感じでのデザインでお願い\n　でいないでしょうか。装飾品や構図のデザインはお任せします。\n\n・表情は幸せいっぱいの表情でお願いします。\n・可能でしたら、照れた表情もいただけたら幸いです。\n\n・納品形式はPSD、宛名は別レイヤーでお願いします。\nうちの子の参考画像\n①\nhttps://skeb.jp/@naoBinaryDigit/works/7\n②\nhttps://skeb.jp/@Leviathan_005/works/17", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ryotsu410/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2492665, "client_id": 671862, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a6f054c/uploads/origins/ea829b2a-f8ed-4d51-b578-fc70595bb2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20fe384b99866ca52db94b65b73661fc", "srcset": "https://si.imgix.net/8a6f054c/uploads/origins/ea829b2a-f8ed-4d51-b578-fc70595bb2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20fe384b99866ca52db94b65b73661fc, https://si.imgix.net/8a6f054c/uploads/origins/ea829b2a-f8ed-4d51-b578-fc70595bb2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e47a97113a927a2784f829d69fe00f57 2x, https://si.imgix.net/8a6f054c/uploads/origins/ea829b2a-f8ed-4d51-b578-fc70595bb2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a39096d42287b0e6dcb6b0215d585ef4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a6f054c/uploads/origins/ea829b2a-f8ed-4d51-b578-fc70595bb2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86fefb6603e81e6cf38b174d40098c3b", "srcset": "https://si.imgix.net/8a6f054c/uploads/origins/ea829b2a-f8ed-4d51-b578-fc70595bb2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86fefb6603e81e6cf38b174d40098c3b, https://si.imgix.net/8a6f054c/uploads/origins/ea829b2a-f8ed-4d51-b578-fc70595bb2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f31e9f5518232f4e57c70b64e47fb6b8 2x, https://si.imgix.net/8a6f054c/uploads/origins/ea829b2a-f8ed-4d51-b578-fc70595bb2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1751028c4b3f216319266087c6864dfa 3x"}, "body": "【エミリア＆エキドナ アズレン衣装】\n\n初めまして、\n\n先生が描かれたアズレンの武蔵の絵が凄く綺麗で可愛いでえっちで大好きです。\n少し変わった依頼内容になると思いますが、ご検討頂けたら幸いです。\n\n【キャラクター】\nリゼロのエミリアとエキドナです。\n\n【衣装】\nエミリアはアズレンの信濃の衣装で、エキドナはアズレンの武蔵の衣装を来ています。\n狐耳と尻尾はなしでお願いします。\n\n【他】\nエミリアは多少赤面しつつ笑顔、エキドナは自信満々な笑顔が良いのです。\nエキドナは先生の武蔵の絵と同じくらいで、エミリアはそれより一段大きく出来たら幸いです。\n\nご検討の程、宜しくお願い致します～\n\n【参考資料】\nhttp://re-zero-anime.jp/tv/assets/character/c/2.png\nhttps://twitter.com/azurlane_staff/status/1304759109875499010\nhttp://re-zero-anime.jp/tv/assets/character/c/25.png\nhttps://twitter.com/azurlane_staff/status/1568581353628925952\n\nhttp://re-zero-anime.jp/tv/character/", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ryotsu410/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2492665, "client_id": 42234, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/77073f20/uploads/origins/e6d191e4-83ef-453d-9402-42abd2dd2211?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=916960b38aea220698611fbdc8777430", "srcset": "https://si.imgix.net/77073f20/uploads/origins/e6d191e4-83ef-453d-9402-42abd2dd2211?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=916960b38aea220698611fbdc8777430, https://si.imgix.net/77073f20/uploads/origins/e6d191e4-83ef-453d-9402-42abd2dd2211?bg=%23fff&auto=format%2Ccom