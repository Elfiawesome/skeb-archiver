03-d76a-42ee-96d9-4f6510f4e1be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=404951c1f3479552d56d5659d7bfd5fb", "srcset": "https://si.imgix.net/8f794947/uploads/origins/1df04903-d76a-42ee-96d9-4f6510f4e1be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=404951c1f3479552d56d5659d7bfd5fb, https://si.imgix.net/8f794947/uploads/origins/1df04903-d76a-42ee-96d9-4f6510f4e1be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fdcdc6332fcffbf9e3f928eeba6b6501 2x, https://si.imgix.net/8f794947/uploads/origins/1df04903-d76a-42ee-96d9-4f6510f4e1be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d52549e6a9983fc64bd474c1c4d864a3 3x"}, "body": "お久しぶりです！前回は素晴らしいイラストを本当にありがとうございました！\n少し早めのお話なのですが、以前依頼させていただいたレルカルさん（旧通常衣装・https://x.com/StrelkaBelca/status/1421776119640981506）が初夏に活動7周年を迎えるということで、何かしらお祝いのイラストを用意したいなと思っております。\n\n何かめでたい感じにしたいので、本人がよく飲んでいるという味のついていないボトルの炭酸水をシャンパンファイトのようにブシャーと噴きださせて、さわやかな感じに（サイダーの販促ポスターのような）できればなと思っております。\nボトルのデザインにご本人がよく使用しているロゴである『ABYSS FRONTER』を小ネタとして盛り込んでいただけたらと思います。\n\n前回同様、本人にお渡しして動画のサムネなどに使いたいなと思っておりますので画像は横向きでpsdにしていただけたらと思います。可能であれば私のものとは別に、レルカルさん宛てのお祝いメッセージの有無も添えていただけたらと思います！\nよろしくお願いいたします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@N404DNh0wdy/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c39e9dca/uploads/origins/044cbcd5-4d8d-403d-8ff6-ac6938a6f4e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48f8d44f113365cdc4869c150245ba48", "srcset": "https://si.imgix.net/c39e9dca/uploads/origins/044cbcd5-4d8d-403d-8ff6-ac6938a6f4e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48f8d44f1133