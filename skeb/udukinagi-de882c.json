こんにちは！乃々テンシアと申します！\n普段からイラスト拝見させていただいてます！とてもよい表現で描かれる方だと思いご依頼させていただきました！\n\n描いて頂きたいものは私のキャラクターである『乃々』を描いてほしいです！\nR18でなければどのような表現で描いて頂いても結構です！描きやすい構図やポーズでお願いします！\n配信やアイコンなど個人使用の範囲で使用させていただきます！\n\n初めての依頼なので至らぬ点多々あるかとは思いますがご検討くださるとうれしいです！\nよろしくお願いします！\n\n参考画像\nhttps://drive.google.com/drive/folders/1wVqFL6rPWHWIGar7VySoY90dWKhPSpzT?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@igawa20000volt/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 295818, "client_id": 2942432, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d86ea3e6/uploads/origins/9926be71-492b-46fb-969c-012cca151c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bfe2581ea7f9425bfc7614b16c9bc67", "srcset": "https://si.imgix.net/d86ea3e6/uploads/origins/9926be71-492b-46fb-969c-012cca151c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bfe2581ea7f9425bfc7614b16c9bc67, https://si.imgix.net/d86ea3e6/uploads/origins/9926be71-492b-46fb-969c-012cca151c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d9ce5640796d09d7054bafa44d86710 2x, https://si.imgix.net/d86ea3e6/uploads/origins/9926be71-492b-46fb-969c-012cca151c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=575ded81a4a3e9ceb36c00611f6debb1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d86ea3e6/uploads/origins/9926be71-492b-46fb-969c-012cca151c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a54380eb13b774566bd8bb38035f0898", "srcset": "https://si.imgix.net/d86ea3e6/uploads/origins/9926be71-492b-46fb-969c-012cca151c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a54380eb13b774566bd8bb38035f0898, https://si.imgix.net/d86ea3e6/up