vQu3cwKQVmA1uBe7bapGJBav95o/view?usp=sharing\n\n■衣装参考\n衣装はこちらの和服でお願いできますでしょうか。\n多少簡略化していただいてもかまいません。\nhttps://drive.google.com/drive/folders/11eeOfhSax-9ffX5phU4DOiP8vVNY810m?usp=sharing\n\n■わがままなご相談\n猫手毬さんは誕生花にちなんだ作品を多数描かれていらっしゃると記憶しており、\nよければ5月の誕生花でこの子に合う花をアクセントとして入れていただけないでしょうか。\n（手に持たせる、髪飾りなど仕様は問いません）\n\n色々書かせて頂きましたが、基本的には猫手毬さんのフィーリングで描いて頂いて構いません。\nどうぞよろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@temari_str/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 696944, "client_id": 685116, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7857e7e8/requests/225445_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da9974121632d2242b0da5efa746a101", "srcset": "https://si.imgix.net/7857e7e8/requests/225445_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da9974121632d2242b0da5efa746a101, https://si.imgix.net/7857e7e8/requests/225445_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a830ab401fb06b1d6cd6af640f5680d 2x, https://si.imgix.net/7857e7e8/requests/225445_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84373eca93e5f5a14498ecba7975cf1f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7857e7e8/requests/225445_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e811d3652f40bbeca9323acf40d86472", "srcset": "https://si.imgix.net/7857e7e8/requests/225445_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e811d3652f40bbeca9323acf40d86472, https://si.imgix.net/7857e7e8/requests/225445_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7dd50f7f0c67f088d2110380b07038fd 2x, https://si.imgix.net/7857e7e8/requests/225445_0?bg=%23fff&aut