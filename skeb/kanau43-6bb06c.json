せる最も低い少年声でのセリフと叫び声がどうしても聴きたいです。近所迷惑にならない程度に思いっきり演じて頂くと喜びます。どうかこの内容でお引き受けくださいますようよろしくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@kanau43/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 1728553, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/e3ea3f11-86c3-46c9-96a1-08fc40404239?response-content-disposition=inline&Expires=1774674805&Signature=lkNLyTMnbnh64DAZtxuPAX8xOn8wg9gMK~Qpwba9JQ5YDoEyTC2LnU9UBnv8OQoA-ZZOLlEJ~sszu~Wtvj~hFTvafe3F4CC0bDxCYWnY5I8ZeCGVfyLCB6gSwSm0MooFsvOTtnHKGDr1cCY2EZlP~lunCMPEVK4vpumwcw1T3F3QSfsebikov-m4Kf0Ji21UfYX4O2pllj~nFla5~iOvdVlDTA7vIVORv-oPNWUQfr4GObziglp3g7QiKwQIcDwb308O8b~8U3iZ-NoUwvyE2U~m4BH~quD13U29zBr7glwOZKirRd61MSUi-qInLSGAIQACu2rR7PLaG2lhvOYuOg__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1953583084752056322%2FmjIE4UYR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d7d2786e8613bbd4e648ccb2f95d935", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1953583084752056322%2FmjIE4UYR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d7d2786e8613bbd4e648ccb2f95d935, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1953583084752056322%2FmjIE4UYR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea53edaee82a26ea712481b7a6fd1b8c 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1953583084752056322%2FmjIE4UYR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=577ad6c21c46cd84fed26f6de5278e1c 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/3e090638-29ba-46b2-9ef6-598c4a85b374?response-content-disposition=inline&Expires=1774674805&Signature=N~ZFqjuFplJ7FAQAUwwcb94uKSv7K4v5Y2PAK-dPpIIlyKf5