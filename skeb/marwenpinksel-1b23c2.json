200&h=200&s=2dad6c94eaf0b52288fc37613021bac6 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25f886ce/uploads/origins/05578b07-4798-4e30-8a38-9cc0b11c4171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88515bd08a0769aaf042aa4f5a4e7c20", "srcset": "https://si.imgix.net/25f886ce/uploads/origins/05578b07-4798-4e30-8a38-9cc0b11c4171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88515bd08a0769aaf042aa4f5a4e7c20, https://si.imgix.net/25f886ce/uploads/origins/05578b07-4798-4e30-8a38-9cc0b11c4171?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df6f3dcb9f9684c0746e2c1eaa7834e0 2x, https://si.imgix.net/25f886ce/uploads/origins/05578b07-4798-4e30-8a38-9cc0b11c4171?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d1ccfd6722c68b9a9850477b945d8f77 3x"}, "body": "はじめまして、pixivでお見かけして触手の描き方が\n大変好みでしたので依頼させていただきました。\nうちの子、陽菜のイラストをリクエストさせてください。\n\n異世界に飛ばされた先で触手に襲われてしまい\nなす術もなく犯されてしまう様子を描いて頂きたいです。\n服装に関しては参考資料の中から使いやすい服を使用してください。\n\n手足を触手に巻き付かれて拘束、服は溶かされたり破れたりで半裸状態\n①男性器に似た形状の触手を挿入され激しく動かされる\n同時に乳首とクリ責めをされ、快楽を感じ声も漏れているが怯えて泣きじゃくる\n②中出しされて強制的に絶頂させられる\n\nという2パターンの差分構成にしていただきたいです。\n要望が多くなりましたが何卒よろしくお願いします。\n\n・参考資料\nhttps://www.pixiv.net/artworks/92383424\nhttps://www.pixiv.net/artworks/93108996", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@marwenpinksel/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1262875, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b36d5660/uploads/origins/9664cb54-5687-452a-9cc1-782137239832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7dfdd1bd80412d47fbf510c09febfee", "srcset": "https://si.imgix.net/b36d5660/uploads/origins/9664cb54-5687-452a-9cc1-782137239832?bg=%23fff&au