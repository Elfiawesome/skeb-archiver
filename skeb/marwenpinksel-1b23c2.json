p&crop=top&w=200&h=200&s=1745e3a289bc7267640188a3fdb5abbd, https://si.imgix.net/6f1f8d8c/uploads/origins/eb3119b7-e5bd-472b-8515-9f48ab0201ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a53828a861616481a8bb4bfd0069fd30 2x, https://si.imgix.net/6f1f8d8c/uploads/origins/eb3119b7-e5bd-472b-8515-9f48ab0201ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=410cac93cf3e7bbd23de61c5a69710bc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f1f8d8c/uploads/origins/eb3119b7-e5bd-472b-8515-9f48ab0201ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85e94b39fba9be51ca47e7068312fa01", "srcset": "https://si.imgix.net/6f1f8d8c/uploads/origins/eb3119b7-e5bd-472b-8515-9f48ab0201ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85e94b39fba9be51ca47e7068312fa01, https://si.imgix.net/6f1f8d8c/uploads/origins/eb3119b7-e5bd-472b-8515-9f48ab0201ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc6c551e6027ed65c151785f45a89903 2x, https://si.imgix.net/6f1f8d8c/uploads/origins/eb3119b7-e5bd-472b-8515-9f48ab0201ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f0c9751f3d3540707eaef3276d63d167 3x"}, "body": "いつもイラスト楽しみに見ております！\n僭越ながらリクエストを送らせていただきます。\n少々ニッチな内容ではありますが、お引き受けいただけますと幸いです。\n\n形式：１ページの２コマ漫画（カラー）\n概要：メスガキがお兄ちゃんのコレクションの女児ぱんつを燃やしてるビデオレターを送り付け、メスガキが分からせられる話。\n\n■１コマ目\nメスガキ（以下、メ。）「いえーい！お兄ちゃん見てる～？？」\nメ「今からお兄ちゃんの大事にコレクションしてるぱんつを燃やしちゃいまーす！」\nメ「こんな子供おぱんつで興奮しちゃう変態ロリコンお兄さんは、粛清！粛清！！」\n\nビデオカメラを前にしたメスガキは、クリップ付ハンガーに引っかけた女児ぱんつ（女児向けアニメ風キャラクターのフロントプリント）を片手で持ち、\nもう片方の手に火のついたチャッカマンを持ち、クロッチ部分に火を当てている。\n女児ぱんつのクロッチより下側が黒く焦げ、オレンジ色の炎を小さく上げながらパチパチと音を立てながら徐々に燃え広がっていく。\n\nメスガキはお兄ちゃんをあざ笑うかのような腹黒い笑みを浮かべる。\n\n■２コマ目\nシーンが変わり、コンクリート貼りの倉庫にメスガキが連れ去られる。\nメスガキは衣類を剥かれショーツ１枚にされ、足首を縄で縛られ、口にはギャグボールが装着されている。\n身に着けていた服とキャミソールは無残に破かれ、床に散乱。\n唯一１枚残ったショーツも、下半分を無理やり引きちぎられ、太いバイブが挿入されている。\n\nお兄ちゃんがメスガキの部屋のタンスから盗んだ女児ショーツ数枚を床に表向きに配置。\nマッチでそれらのショーツに着火し、女児のお気に入りだったショーツを灰にする。\n\n女児ショーツの参考資料です。https://auctions.afimg.jp/w74567637/ya/image/w74567637.2.jpg\n\nメスガキは、こちらの作品の表紙の子（https://www.dlsite.com/maniax/work/=/product_id/RJ01265699.html）をイメージして描いていただけると嬉しいです。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@marwenpinksel/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ef5a556a/uploads/origins/9d62c015-3ee3-4e86-917b-c775d2702607?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db0407d2dd7fcdd00c313e006c7e8467", "srcset": "https://si.imgix.net/ef5a556a/uploads/origins/9d62c015-3ee3-4e86-917b-c775d2702607?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db0407d2dd7fcdd00c313e006c7e8467, https://si.imgix.net/ef5a556a/uploads/origins/9d62c015-3ee3-4e86-917b-c775d2702607?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=999744218f80d9b3533bb11bbe382d57 2x, https://si.imgix.net/ef5a556a/uploads/origins/9d62c015-3ee3-4e86-917b-c775d2702607?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8477779005bf29b366b2362c8334464b 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1262875, "nc": 160}, {"path": "/@marwenpinksel/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1262875, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a30dd2a/uploads/origins/ccf625ba-4b36-42ea-a3