け引きをしている\n普段は落語家が話しかけることの方が多いが\n極道者の機嫌が悪ければ襟を掴んだり、良ければタメ口になったり距離を狭くしたりよく笑ったりする\n\nご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/mobile/folders/1P74R9OEDKz69n_xzqGYLmNcWEOn3fjX7?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 591, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "天気予報🧷", "screen_name": "prgm0011", "avatar_url": "https://pbs.twimg.com/profile_images/1392360451413975043/1Pa6NeYh.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4261374013/1621004570/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "novel"}], "banned": false, "nc": 17}, {"id": 900020, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ねるねるらんど", "screen_name": "nerunru_", "avatar_url": "https://pbs.twimg.com/profile_images/1693271247562657792/ccG6JQaT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/830284185839341568/1665785122/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 1650340, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ヨジマエ", "screen_name": "0359_am", "avatar_url": "https://pbs.twimg.com/profile_images/1403141495528431616/iUxJ_AD6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1403131816530178050/1652538601/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", 