3fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b70b61f31354f4579db29a6000926736 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87fcc993/uploads/origins/0c3be33d-45ab-4e41-93c9-88ad9e52fb09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=810b86ee964cf4a7550ef662dfa961fc", "srcset": "https://si.imgix.net/87fcc993/uploads/origins/0c3be33d-45ab-4e41-93c9-88ad9e52fb09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=810b86ee964cf4a7550ef662dfa961fc, https://si.imgix.net/87fcc993/uploads/origins/0c3be33d-45ab-4e41-93c9-88ad9e52fb09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f1e8e8e930b2c2d996cbcef6f9117eef 2x, https://si.imgix.net/87fcc993/uploads/origins/0c3be33d-45ab-4e41-93c9-88ad9e52fb09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a7fe9190550b6daf51367d6c78d81436 3x"}, "body": "こんにちは！\nSkebの依頼は初めてなので、間違いがあったらごめんなさい。\nオリジナルキャラクターのイラストをお願いしたいです。\n\nシュウセイ【愁醒\n188cm\n冷めた性格で、一人でいることを好むタイプ。頑固で無神経なところがある。ポジティブな感情を表に出すのが苦手で、笑顔を見せることは少ない！怒ると非常に理不尽で攻撃的になる。\n生前に犯した悪行のせいで、あの世に行くことができない。生前に悪いことをすればするほど、彼の魂は怪物のように見えるようになり、そのため彼は部分的に骸骨のように見える。死後の世界に入りたければ、悪行を償わなければならないので、死神になることを余儀なくされた。\n\nお好きなように描いてください！\n使用目的\n> 個人利用\n> SNSへの投稿（きちんと帰属を明記します）\n金額が足りない場合はご申告ください。ありがとうございました。(˶◜ᵕ◝˶)\n\nhttps://drive.google.com/drive/folders/13pwtpCBC572ptFlISUW2xvRjs2_M1iZX?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aynahTRPG/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1014384, "client_id": 1994025, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d60d0b0f/uploads/origins/69ede780-7e2d-4584-a9b9-c748183bc675?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=685586cd9c71007f67fe02f88e14f236", "srcset": "https://si.imgix.net/d60d0b0f/uploads/origins/69ede780-7e2d-4584-a9b9-c748183bc675?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=685586cd9c71007f67fe02f88e14f236, https://si.imgix.net/d60d0b0f/uploads/origins/69ede780-7e2d-4584-a9b9-c748183bc675?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38986ad89289d2ebbcb187eacd04a43a 2x, https://si.imgix.net/d60d0b0f/uploads/origins/69ede780-7e2d-4584-a9b9-c748183bc675?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=047cdc9ce636e4e88ee918eee6373ec7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d60d0b0f/uploads/origins/69ede780-7e2d-4584-a9b9-c748183bc675?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7308fb3a6f10e756a369aab070d07b6", "srcset": "https://si.imgix.net/d60d0b0f/uploads/origins/69ede780-7e2d-4584-a9b9-c748183bc675?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7308fb3a6f10e756a369aab070d07b6, https://si.imgix.net/d60d0b0f/uploads/origins/69ede780-7e2d-4584-a9b9-c748183bc675?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3536640ffc073e200ed8482164dd9fc3 2x, https://si.imgix.net/d60d0b0f/uploads/origins/69ede780-7e2d-4584-a9b9-c748183bc675?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0abaa843a142f6b002eff22d99bc470c 3x"}, "body": "初めまして！\n検索よりお見掛けし、梓真様の絵柄に惹かれてご依頼させていただく、リクエストさせていただきました。\n\nお願いしたいのはTRPGで使用している自分とフォロワーさんのキャラクターになります（許可済み）。\n使用用途は個人鑑賞、SNS内のヘッダーや壁紙などの使用です。また、キャラクターを作成したフォロワーさんにも共有させていただければ幸いです。\n\n＜設定＞\nシナリオ「ゾディアックスクール」に使用したPCで、中華圏の出身と治安の悪さで「中華組」で一括りされている三人組。\n\n①【HO辰】\n男、169cm、18歳\n肩書き：超高校級の雀士\n日本と香港のハーフで、3年生。\nたまに開眼するタイプの糸目。\n保護者面をして、お兄さんを自称している。\n大人しい振る舞いで基本は落ち着いているが、楽しさを優先する愉快犯でもある。\n賭け麻雀が大好きでたまに自陣をカモる。\nよく【HO巳】の財布から勝手にお金を抜く。\n\n②【HO巳】\n男、159cm、17歳\n肩書き：超高校級の投資家\n2年生でツッコミ担当兼胃痛枠。\n似非中国語風訛りで喋る日本人。\n中華街付近出身。壺とか買わそうとする。\n陽の者のテンションをあえて作ろうとするが、本来はド陰キャでネチっこい守銭奴。\n自陣の家計を管理している。\n\n③【HO亥】\n女、151cm、17歳\n肩書き：超高校級の賭博師\n台湾出身の2年生。末っ子ポジ。\n明るくてとにかく元気。声がでかい。\n”遊び”が大好きで、賭けるとゲームが盛り上がるので、賭博をしているが、お金自体には頓着がない。よく自陣からお菓子を強奪する。\n傍若無人で我が儘な山賊。\n\nもし金額が見合わない場合、お気軽にキャンセルまたは再送依頼を送っていただければと思います。\nご検討いただけたら幸いです。どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1qcS3VOAc2Ew1j_do2BlD3BOWJScKUnyw?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@ISUI_130/works/66", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2742776, "client_id": 1014384, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ba65c5f/uploads/origins/675ce0f5-9ccd-4c52-bb3f-f53881a45e1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0eb19c57dccb41bc276be7da9753c2fe", "srcset": "https://si.imgix.net/1ba65c5f/uploads/origins/675ce0f5-9ccd-4c52-bb3f-f53881a45e1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0eb19c57dccb41bc276be7da9753c2fe, https://si.imgix.net/1ba65c5f/uploads/origins/675ce0f5-9ccd-4c52-bb3f-f53881a45e1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c866905d558656fa56e71275fe749411 2x, https://si.imgix.net/1ba65c5f/uploads/origins/675ce0f5-9ccd-4c52-bb3f-f53881a45e1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=583434851130d2f7ac4fbf818a7d0c43 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ba65c5f/uploads/origins/675ce0f5-9ccd-4c52-bb3f-f53881a45e1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=587afc5c914840eb1a22557ec29ecb38", "srcset": "https://si.imgix.net/1ba65c5f/uploads/origins/675ce0f5-9ccd-4c52-bb3f-f53881a45e1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=587afc5c914840eb1a22557ec29ecb38, https://si.imgix.net/1ba65c5f/uploads/origins/675ce0f5-9ccd-4c52-bb3f-f53881a45e1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=034a6634820b4e8c865e138624cef7b6 2x, https://si.imgix.net/1ba65c5f/uploads/origins/675ce0f5-9ccd-4c52-bb3f-f53881a45e1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1baeedb19df9a017d8305689187efadd 3x"}, "body": "椅子井さん初めまして！SNSでお見かけしたイラストがとても素敵だったのでリクエストさせていただきます。\n今回ご依頼したいのは私と友人の双子オリジナルキャラクターです。スケブご依頼の許可は頂き済です。\n\n下記設定となります。構図やシチュエーションはお任せさせてください。\nご検討いただければ幸いです。何卒よろしくお願いいたします！\n\n---\n双子兄(白髪)：\n男/23歳/170cm強\n刑事(捜査一課)らしからず飄々としており、少々不真面目で捻くれ気味。オンオフははっきりしているのでやる時はやる。\n双子の弟に執着し愛している。\n\n双子弟(黒髪)：\n男/23歳/170cm強\nメイクアップアーティスト。身だしなみに気を遣っており友人も多い社交的なタイプ。\n綺麗なものが好きで兄が1番大好き。近親性愛者。\n\n関係性：\n血の繋がった双子の兄弟、2人で一緒に暮らしており互いに依存している。軽口を叩いたり、スキンシップ、じゃれあったりと仲がとても良い。カップリングはリバ。\n\nhttps://drive.google.com/drive/folders/1uWPlD3cptHqqZd6yDBpkIRlfG_jcZq_V", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tmt_tkmk/works/74", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2353436, "client_id": 1014384, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5dc2f6d5/uploads/origins/f99e6e03-891d-4991-8af7-423279624549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b86c2b7cc22be5eb71d7b071161c92ba", "srcset": "https://si.imgix.net/5dc2f6d5/uploads/origins/f99e6e03-891d-4991-8af7-423279624549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b86c2b7cc22be5eb71d7b071161c92ba, https://si.imgix.net/5dc2f6d5/uploads/origins/f99e6e03-891d-4991-8af7-423279624549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93544912f368fdf181eb7c51b5f20cb8 2x, https://si.imgix.net/5dc2f6d5/uploads/origins/f99e6e03-891d-4991-8af7-423279624549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ac334684c6e3091ed1756c38dce2637 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5dc2f6d5/uploads/origins/f99e6e03-891d-4991-8af7-423279624549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e043e9b2e6a1553e084ff1d3ea299a9", "srcset": "https://si.imgix.net/5dc2f6d5/uploads/origins/f99e6e03-891d-4991-8af7-423279624549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e043e9b2e6a1553e084ff1d3ea299a9, https://si.imgix.net/5dc2f6d5/uploads/origins/f99e6e03-891d-4991-8af7-423279624549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=08f279838f35f9a3721ebaa22772f48f 2x, https://si.imgix.net/5dc2f6d5/uploads/origins/f99e6e03-891d-4991-8af7-423279624549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8890b5fafe6d927facfb0ab6801a852 3x"}, "body": "たも田さん初めまして！素敵な色合いと絵柄に惹かれ是非イラストが見てみたく、リクエストさせていただきます。\nお願いしたいのはTRPGで作成した私と友人のオリジナルキャラクターになります。ご依頼にあたり許可はいただいております。イラスト資料はURL先のGoogle driveをご確認いただけますでしょうか。\nイラストの詳細なシチュエーションはお任せさせていただきたいのですが、可能であれば背景ありの花札のような和風の雰囲気、または学校の中ですと嬉しいです。\n少々人数が多めで恐れ入りますが、ご検討いただけますと幸いです。\n\n---\n\n▩男の子A（黒髪）\n高校2年生16歳 / 178cm / 名探偵部部長\nイメージカラー#E86B79\nモチーフ：花札 梅に鶯\n明るく人当りがいい。面白そうな事と謎解きが好きで、名探偵部を立ち上げた。\n少々気分屋で2人を振り回すことも。サングラス以外にもアイマスクやおもちゃのキセル、沢山のお守りなど持ち物が多い。\n神主の家系なのでオカルトにも詳しい。神楽繫がりで剣道も嗜んでいる。\n\n▩女の子\n高校2年生17歳 / 148cm / 名探偵部所属\nイメージカラー：#585880\nモチーフ：花札 藤に不如帰\n気が弱い・ビビリ・対人恐怖症と人付き合いが苦手。\n2人以外と話すのも得意ではなかったが、何人かの怖がらずに接することができる人も増えた。いろいろあって最近は一人暮らしをしている。\nひとりでいるのが怖いため「トリさん」という小鳥を飼っている。不如帰ではない。\nオカルト、ホラーは大の苦手。\n\n▩男の子B（緑髪）\n高校2年生17歳 / 177cm / 名探偵部所属\nイメージカラー：#2E4F39\nモチーフ：菖蒲に八橋\n2人には心を許している。固すぎない敬語口調で掴みどころのない少年。\n自他共に認めるイケメンで人当たりもいい。だが実際は頭が悪く、アクティブで少々脳筋思考。さほど度の入っていない眼鏡の場所をよく忘れる。\n困った言動で2人以外にも周りを振り回すこともしばしば。\nオカルト、ホラーはあまり強くない。\n\n---\n\n3人は付き合いが長く同じ部活動に所属する仲のいい友達です。\n