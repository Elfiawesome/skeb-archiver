r=200&s=3f95ccf82c196e7878132e66b6385a29 2x, https://si.imgix.net/1044c551/uploads/origins/f894913a-a7ba-4420-983d-75cf44bba679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4469c01686d57124f5ca4d90ebc6c461 3x"}, "body": "お疲れ様です。\n以前はSkebイラストを描いていただき、ありがとうございました。\n今回またリクエストをさせていただきたいのですが、緒方てい様が描かれた水泳部のコーチさんの旧スク姿をお願いできますでしょうか？\n\n色々な意味で流石に無理があるのでは……と思いつつもしっかり着用して水泳し、濡れた自分の姿に恥じらう彼女を、構図等の指定はありませんのでもし可能でしたらどうか宜しくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ogatatei/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 230185, "client_id": 626297, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3aa44427/uploads/origins/cf1b6f39-ac06-4fa9-afe0-0d848cbede3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47be4d241e0af0284782c7d30c89314d", "srcset": "https://si.imgix.net/3aa44427/uploads/origins/cf1b6f39-ac06-4fa9-afe0-0d848cbede3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47be4d241e0af0284782c7d30c89314d, https://si.imgix.net/3aa44427/uploads/origins/cf1b6f39-ac06-4fa9-afe0-0d848cbede3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4773276e705dd98fbea059435d58d6d9 2x, https://si.imgix.net/3aa44427/uploads/origins/cf1b6f39-ac06-4fa9-afe0-0d848cbede3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aba5811894f36cc7ac04a9830708a114 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3aa44427/uploads/origins/cf1b6f39-ac06-4fa9-afe0-0d848cbede3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d85929766384041329dd9f2df7da3c0e", "srcset": "https://si.imgix.net/3aa44427/uploads/origins/cf1b6f39-ac06-4fa9-afe0-0d848cbede3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop