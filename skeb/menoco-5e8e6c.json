知りで、毎日の記念日とか英単語や漢字、熟語などの意味を教えてくれます。メモ帳を持ち歩いており、勉強家です。白くて大きな尻尾は大切にしており毛繕いは丁寧にします。尻尾は本人の気持ち以上に感情が素直です。よくそんな尻尾の扱いに手を焼くことも。\n他人と関わるときの性格設定が苦手なので固まっていませんが、基本は優等生で控えめですがたまに感情が高ぶった時に尻尾の感情表現が先行してしまいます\n\n描かれていたフォウくんのふわふわの見事な白い尻尾を見て、せみさんの描かれるうちの水無くんの姿が見たくなりました。水無くんの「らしさ」がでていると嬉しいです。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@8nabisi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2928303, "client_id": 582, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0ebcd1e/uploads/origins/968f235e-f5e9-4f1d-b11f-c78d13eceaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=803b996ff015799464dec0ad3480a7b7", "srcset": "https://si.imgix.net/f0ebcd1e/uploads/origins/968f235e-f5e9-4f1d-b11f-c78d13eceaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=803b996ff015799464dec0ad3480a7b7, https://si.imgix.net/f0ebcd1e/uploads/origins/968f235e-f5e9-4f1d-b11f-c78d13eceaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13db87f78130db56682b899c8718fff3 2x, https://si.imgix.net/f0ebcd1e/uploads/origins/968f235e-f5e9-4f1d-b11f-c78d13eceaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a21319d544c61fce42bd91c9e7728086 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0ebcd1e/uploads/origins/968f235e-f5e9-4f1d-b11f-c78d13eceaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b157ef194cf0e0b6acf15641031f3a1", "srcset": "https://si.imgix.net/f0ebcd1e/uploads/origins/968f235e-f5e9-4f1d-b11f-c78d13eceaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b157ef194cf0e0b6acf15641031f3a1, https://si.imgix.net/f0ebcd1e/uploads/origins/968f235e-f5e9-4f1d-b11f-c78d13eceaa1?bg=%23fff&auto=format%2Ccompre