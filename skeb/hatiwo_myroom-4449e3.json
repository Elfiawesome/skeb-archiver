コいい衣装も似合う髪型の千城かや」を描いて頂きたいです！\nヘアスタイル・衣装について、はち夫先生のおまかせでお願いしたいです。\n髪全体の色味がいつもの色であれば、\nインナーカラー/メッシュ/毛先カラー等入れて頂いても構いません。\n\nまた、今回描いて頂きたいイラストですが、\n今後の活動で新しい髪型にする際に参考にさせて頂きたいと思っております。\nその為、可能であれば後ろから見た際の髪型も分かるようなイラストだと大変嬉しいです…！\n\nカッコいい女性も可愛い女の子も両方とも大変素晴らしく描いていて\n髪型・お姿・洋服のセンスも良いはち夫先生にお願いさせて下さい…！\n\n\nだらだら妹系バーチャルYouTuber\n千城かや\n\n\n参考資料:\nhttps://drive.google.com/file/d/1SrrU23zzaAMrxtFCWdFu9xNOKWqvjAUO/view\nhttps://drive.google.com/file/d/1hjRoswrOL5XrW515Vk5AimL0xPewQMAY/view", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hatiwo_myroom/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 23206, "client_id": 1841531, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/498fb0ea/uploads/origins/dcba795c-8b56-4774-bf62-b715a0acde27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6e1926206f27690d771bc0c3bad72b7", "srcset": "https://si.imgix.net/498fb0ea/uploads/origins/dcba795c-8b56-4774-bf62-b715a0acde27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6e1926206f27690d771bc0c3bad72b7, https://si.imgix.net/498fb0ea/uploads/origins/dcba795c-8b56-4774-bf62-b715a0acde27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef49c40b90ff3a906f76ab52b38d56cb 2x, https://si.imgix.net/498fb0ea/uploads/origins/dcba795c-8b56-4774-bf62-b715a0acde27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c5fd14a105201add8e41a9373855339 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/498fb0ea/uploads/origins/dcba795c-8b56-4774-bf62-b715a0acde27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c902191481373c23b78236464550a7a1", "srcset": "https://si.imgix.net/498fb0ea/uploads/origins/dcba795c-8b56-4774-bf62-b715a0acde27?bg=%23fff&auto=format%2Ccompres