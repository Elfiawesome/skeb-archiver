出しがち。\n対岸に怪しい人影がいたら川に飛び込むとか。\n証拠が揃っていないのに犯人を尾行するとか。\n\n＊蒼月（そうげつ）\n職業：刑事\n年齢/性別：外見20代前半/男性型\n身長/体重：175cm/85kg\n\n落ち着いていて穏やか、誰にでも丁寧な態度で接する新型アンドロイド。\n人とほとんど変わらない見た目で、飲食や呼吸などを擬似的に行う事も出来る。\n\n周囲が引くほどのチョコミント好きで、\nその狂信具合は共に行動しているバディに限らず、\n先輩や先輩アンドロイドすらも恐怖させた。\n\n外見などは資料URLを参照ください。\n問題があれば再送/キャンセル下さって構いません。\nよろしくお願い致します。\n\n＊構図資料用\n動画：https://youtu.be/irRp2R55HGo?si=V5DNy3mBMNot1kfw\n\nhttps://drive.google.com/drive/folders/1oT0yhmP1GJtzOHxkbMjPqNjx3EVc-Cua?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kikaku_sinonome/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 267661, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/14a7be84/uploads/origins/f5aeba44-e41c-498d-a1fe-3b059f17e8fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1148a3d6b1b0cd970419bd6b77173a05", "srcset": "https://si.imgix.net/14a7be84/uploads/origins/f5aeba44-e41c-498d-a1fe-3b059f17e8fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1148a3d6b1b0cd970419bd6b77173a05, https://si.imgix.net/14a7be84/uploads/origins/f5aeba44-e41c-498d-a1fe-3b059f17e8fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=166ef9f60e669faebb900e5150f01894 2x, https://si.imgix.net/14a7be84/uploads/origins/f5aeba44-e41c-498d-a1fe-3b059f17e8fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b3678ee174bbf4ac46d5250b2dc7d6d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/14a7be84/uploads/origins/f5aeba44-e41c-498d-a1fe-3b059f17e8fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ae5c3e6ec3cdc31c3edab4af7e7d4f7", "srcset": "https://si.imgix.net/14a7be84/uploads/origins/f5aeba44-e41c-498d-a1fe-3b059f17e8fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&