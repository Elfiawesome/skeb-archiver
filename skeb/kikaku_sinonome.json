=a24842def5d41ac4e8b4d6e05ad7573e, https://si.imgix.net/7f816bfe/uploads/origins/80410e60-b4df-4d12-ad86-1dc5ec0301d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7269e022d10ca49b5a1f12cfba6aaa40 2x, https://si.imgix.net/7f816bfe/uploads/origins/80410e60-b4df-4d12-ad86-1dc5ec0301d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c86cb9e0017d8a66248c9acf3b3ccc6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f816bfe/uploads/origins/80410e60-b4df-4d12-ad86-1dc5ec0301d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1304a56cc1c751440613e6e1d6c9a17", "srcset": "https://si.imgix.net/7f816bfe/uploads/origins/80410e60-b4df-4d12-ad86-1dc5ec0301d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1304a56cc1c751440613e6e1d6c9a17, https://si.imgix.net/7f816bfe/uploads/origins/80410e60-b4df-4d12-ad86-1dc5ec0301d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0818fbca58e64b8dac553b15343fa260 2x, https://si.imgix.net/7f816bfe/uploads/origins/80410e60-b4df-4d12-ad86-1dc5ec0301d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e068f41d31369e4137719a823bcb2947 3x"}, "body": "はじめまして、いつも作品を拝見しています。優しく、すこし生暖かい空気の絵柄が大好きです。\n\n白髪の男性と、桃髪の男性の二人が室内でくつろいでいる様子のイラストを依頼したいです。服装や室内の構造、ポーズなどはおまかせします。\n鑑賞や壁紙など個人的な範囲で使用したいと考えています。何卒ご検討よろしくお願い致します。\n（CoCTRPGのキャラクターのため、ネタバレのあるフォルダがあります。必要でなければ、ネタバレなしの資料を参考にしてください）\n\nこれからも応援しています！\n\nhttps://drive.google.com/drive/folders/1lzEBx0qLmVAugSMe5cpJaFOfHzxanTa9?usp=share_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 2339922, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "めろぽに🫧ご依頼受付停止中", "screen_name": "meroponi_neon", "avatar_url": "https://pbs.twimg.com/profile_ima