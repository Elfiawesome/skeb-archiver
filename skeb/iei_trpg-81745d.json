るところをお願いしたいです！できれば、会津は緑、セロシアは赤を基調とした衣装でお願いします。\n\n参考URLには、VTuberモデルの画像と、ポーズや衣装のアイデアとして使えそうな画像をフォルダ分けしてあります！\n\nどんなものが出来上がるか楽しみです！\n\nお忙しい中、ありがとうございました\n\nhttps://drive.google.com/drive/folders/116adjUMWLQWZAnfFgbVar9G7bYuI4Mss?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@iei_trpg/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5c641fad/uploads/origins/982dc447-ac99-47e1-a597-2cb61cc3cacd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fecce253d4eee59a916433f732f435d5", "srcset": "https://si.imgix.net/5c641fad/uploads/origins/982dc447-ac99-47e1-a597-2cb61cc3cacd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fecce253d4eee59a916433f732f435d5, https://si.imgix.net/5c641fad/uploads/origins/982dc447-ac99-47e1-a597-2cb61cc3cacd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=70c08d672014a0bfb63fa4d1d19c63b1 2x, https://si.imgix.net/5c641fad/uploads/origins/982dc447-ac99-47e1-a597-2cb61cc3cacd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a6f7b8c3c2d9153130534bb7a54a4b7 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1011647, "client_id": 1515415, "nc": 145}, {"path": "/@iei_trpg/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1011647, "client_id": 2358769, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/537a82e2/uploads/origins/38a29f4a-5b76-47f8-8f30-7564251de10f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6915ce4263af0b99ea34ef255cca2f18", "srcset": "https://si.imgix.net/537a82e2/uploads/origins/38a29f4a-5b76-47f8-8f30-7564251de10f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6915ce4263af0b99ea34ef255cca2f18, https://si.imgix.net/537a82e2/uploads/origins/38a29f4a-5b76-47f8-8f30-7564251de10f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81798bd854c4ff94948feac1f588783d 2x, https://si.imgix.net/537a82e2/uploads/origins/38a29f4a-5b76-47f8-8f30-7564251de10f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88cf2161fd493fe6a520e9866a61ec66 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/537a82e2/uploads/origins/38a29f4a-5b76-47f8-8f30-7564251de10f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6df3a55e9bb89c17f0cf0ba19c4f7977", "srcset": "https://si.imgix.net/537a82e2/uploads/origins/38a29f4a-5b76-47f8-8f30-7564251de10f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6df3a55e9bb89c17f0cf0ba19c4f7977, https://si.imgix.net/537a82e2/uploads/origins/38a29f4a-5b76-47f8-8f30-7564251de10f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a6d379d111c5271d6c37aa73effdc510 2x, https://si.imgix.net/537a82e2/uploads/origins/38a29f4a-5b76-47f8-8f30-7564251de10f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c1cc491f85064efdb9bab5309c7287c3 3x"}, "body": "初めまして。\n遺影様のskebのイラストを見て一目惚れし、私と友人のTRPGのキャラクターを描いていただきたいと思い依頼いたしました。(許可はとっております)\n\n以下の2人の私服デート姿を描いていただけないでしょうか？遺影様の色使いやデザインが好きなので、服装や髪型のデザイン・アレンジをして頂けると嬉しいです。\n\n◾︎使用用途\n・鑑賞\n・友人とのイラスト共有\n・個人的な壁紙利用\n・ファイルサイズや構図によっては名前やIDを記載した上でTwitterのアイコンやヘッダーに使用する可能性がございます\n・アクスタ等個人的なグッズ制作(利益の発生しないもの)\n・他の方へ依頼する際の参考資料\n\n\n◾︎簡単なキャラ設定\nふたりで女装百合地下アイドルユニット「Forabyss」を組んでいる。同棲中のカップル\n\n・りおん(友人のキャラクター)\n21歳男。芸名は「りおな」。\n普段から女装男子。自分の顔が可愛いことを自覚していて、わがままな性格。\n最初はあすかのことが気に入らなかったが、今ではあすかに甘えたり甘やかしたりしている。\n趣味はショッピングとSNSで、服装の拘りが強い。基本的に自分が選んだ服以外は着ないが、あすかの意見は聞く。脚が出る服装が好き。\n\n・あすか(私のキャラクター)\n23歳男。芸名はそのまま「あすか」。\n普段は女装は全くしない。頭の回転が良く手先も器用なため、大抵のことはこなせる。\n何に対しても興味が薄く退屈な日々を送っていたが、最近はりおんといるのが楽しいと感じている。\nアクセサリーに拘りがある。洋服は人に勧められて気に入ったら着る。りおんが自分の服を着ることにはダサくなければ寛容。柄物が好き。(デザインは柄物でなくても構いません)\n\n\n◾︎キャラデザ資料\n\nhttps://drive.google.com/drive/folders/1-9p4cH_2uoPDenn4hnCdJ7FcWQGLIAEv\n\n\nご多忙の中大変恐縮ですが、よろしければご一考いただけましたら幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-9p4cH_2uoPDenn4hnCdJ7FcWQGLIAEv", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@iei_trpg/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1011647, "client_id": 849490, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59df424f/uploads/origins/0608f74d-fce3-4e6a-bccb-6560b8e51e42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f22cd1c968496c5406cfecf058784bdb", "srcset": "https://si.imgix.net/59df424f/uploads/origins/0608f74d-fce3-4e6a-bccb-6560b8e51e42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f22cd1c968496c5406cfecf058784bdb, https://si.imgix.net/59df424f/uploads/origins/0608f74d-fce3-4e6a-bccb-6560b8e51e42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ae607c7da692afe95ae56e520e37cab 2x, https://si.imgix.net/59df424f/uploads/origins/0608f74d-fce3-4e6a-bccb-6560b8e51e42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=088204ece42fa47382e49bf1b5843b0d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59df424f/uploads/origins/0608f74d-fce3-4e6a-bccb-6560b8e51e42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e233be9cad9a75265faf44a363317cd0", "srcset": "http