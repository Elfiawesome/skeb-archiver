d-450f-8c9a-bfc092fc9d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75df02bbee48540937b9cf802fce0b63 2x, https://si.imgix.net/ad728341/uploads/origins/d7ce5e01-cf3d-450f-8c9a-bfc092fc9d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81c007fa082a1d420689d5d474f2d7a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad728341/uploads/origins/d7ce5e01-cf3d-450f-8c9a-bfc092fc9d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc0fb645c62a52189a77ace8124effbd", "srcset": "https://si.imgix.net/ad728341/uploads/origins/d7ce5e01-cf3d-450f-8c9a-bfc092fc9d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc0fb645c62a52189a77ace8124effbd, https://si.imgix.net/ad728341/uploads/origins/d7ce5e01-cf3d-450f-8c9a-bfc092fc9d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe30f755173760f8e8547dddd9aab7ba 2x, https://si.imgix.net/ad728341/uploads/origins/d7ce5e01-cf3d-450f-8c9a-bfc092fc9d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=344061a3018a8e76d7ed26800f42a5a5 3x"}, "body": "さぐなえさん、こんばんは。\nデッドマンクルーズ自陣の映画ポスター風イラストを描いていただきたいです。\n\n描いて欲しいイラストは下記の通りです。\n・PC全員が写っている、映画ポスター風のイラスト\n(同卓PLには許可をもらっています)\n\n下記の記載を行ってもらえると嬉しいです。\n・シナリオ名やGM/PLの名前などが映画のタイトルやキャストのように表記されている、プレイ開始日(2024/7/21)が映画の公開日のように表記されているなど、映画のポスターっぽい表現\n・映画ポスター風の記載有りのものと、イラストのみのもので差分をいただけると嬉しいです\n\nその他の要望\n・できればイラストを納品していただいたあとにクリアファイルにして映画グッズ気分を味わいたいので、A4サイズ+印刷用に少し大きめくらいのキャンバスサイズで描いていただけると嬉しいです\n　　・グッズ化不可だったりサイズが大きくて描きにくいなどあればこの要望は無視していただいて構いません\n　　・クリアファイルは自分用と、もしかしたら同卓者用のみで、他の用途には使用しません\n\n\n構図案\nわたしの方で案出しした構図のイメージがあるので一応共有させていただきます。\nただ、さぐなえさんの方で思いつく映画ポスターっぽい構図があればそちらを優先して描いてください。\n\n・一番上に大きく死者の宝冠が輝いている\n・真ん中にPC全員が腰上までのイラストで描かれている\n　　・カイリくんが一番大きく、中央で「踊りませんか？」って感じで手を差し伸べている\n　　・カイリくんの左側後ろにジジくん、右側にオリヴィアさん、オリヴィアさんの後ろにオーナーがいる\n・一番下に豪華客船(シルエット)がある。シルエットに重なる形でタイトルやクレジット風の文字が表記されている\n・背景は黒っぽい感じ\n\n以上です。\nよろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SCro1000TN/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2857198, "client_id": 1332241, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92489fe2/uploads/origins/7955b2d7-44e9-409e-9b93-9dab3ac1d31b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f129c531bf2edf0fdd711fa793a3b64", "srcset": "https://si.imgix.net/92489fe2/uploads/origins/7955b2d7-44e9-409e-9b93-9dab3ac1d31b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f129c531bf2edf0fdd711fa793a3b64, https://si.imgix.net/92489fe2/uploads/origins/7955b2d7-44e9-409e-9b93-9dab3ac1d31b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fc2cfa907c67387b47acd8faf11f759 2x, https://si.imgix.net/92489fe2/uploads/origins/7955b2d7-44e9-409e-9b93-9dab3ac1d31b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53467b33a5b3c449069b9f788a872ae5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92489fe2/uploads/origins/7955b2d7-44e9-409e-9b93-9dab3ac1d31b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08de3f45e2db5195469fb501cd38a3f8", "srcset": "https://si.imgix.net/92489fe2/uploads/origins/7955b2d7-44e9-409e-9b93-9dab3ac1d31b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08de3f45e2db5195469fb501cd38a3f8, https://si.imgix.net/92489fe2/uploads/origins/7955b2d7-44e9-409e-9b93-9dab3ac1d31b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=54fe2545bb30bac953e4054d93fe7182 2x, https://si.imgix.net/92489fe2/uploads/origins/7955b2d7-44e9-409e-9b93-9dab3ac1d31b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=680451bc6497698afb09732fdc7cf5a6 3x"}, "body": "MARU＋2さん、こんにちは。\n先日はアピールありがとうございました。\n私とフォロワーのキャラクターのバディについて、丁寧に見ていただいてありがとうございます！\n少し時間は空いてしまったのですが、ぜひ描いていただきたく、リクエストをお送りしました！\n\n以下、アピールの際に見ていただいたリクエストと重複する部分もありますが、参考資料や設定などです。\n\n---\n\n▪︎参考資料\nhttps://x.com/asaotrpg/status/1484119123752001537?s=20\nhttps://x.com/asaotrpg/status/1575833606122971137?s=20\nhttps://x.com/asaotrpg/status/1582328233961222144?s=20\n\n▪︎概要\n二人は『ダブルクロス The 3rd Edition』というTRPGのプレイヤーキャラクターです。\nUGNエージェントでバディを組んで任務に当たっています。\n\n▪︎キャラクターについて\n伊吹大地(いぶき・だいち)　23歳・男・176cm\n異能力：右腕にリニアキャノンを仕込んでいる。優れた視覚と思考力による精密な射撃が得意。\nシンドローム：ブラックドッグ/エンジェルハィロゥ/ノイマン\nエフェクト：《コンセントレイト:ブラックドッグ》《ハードワイヤード》《アタックプログラム》《小さな塵》《コンバットシステム》イージーエフェクト《写真記憶》《セキュリティカット》\n性格など：一見クールで愛想がないように見えるが、意外と人付き合いは良い。賢いが、ちょこちょこ鈍かったりポンコツだったりするところがある。\n相手への感情(初期)：\n過去に元相棒を失っており、表向きは立ち直っているがまだ引きずっている。心に余裕がないため、杉宮とも向き合えていない。\n相手への感情(現在)：\n元相棒のことを昇華し、杉宮ときちんと相棒になりたいと思っている。\n\n杉宮楓(すぎみや・かえで)　21歳・女・162cm\n異能力：電撃を操る\nシンドローム：ブラックドッグ/ハヌマーン\nエフェクト：《コンセントレイト：ハヌマーン\t》《イオノクラフト》《雷神の鎚》《振動球》《バトルビート》\n性格など：クールでダウナー系。平均点を取るのが得意なタイプの要領の良さがある。一方で、表には出さないが自分に自信がない。\n相手への感情(初期)：\n過去に伊吹(とその元相棒)に助けられたことがあり、憧れを抱いている。が、だからこそ自分が伊吹の現バディであることに対して拒否感を感じ冷たく当たっている。\n相手への感情(現在)：\n少しずつ、伊吹の存在が遠い憧れではなくなって、距離が近づいている。\n\n▪︎シナリオとハンドアウトについて\n※もしもシナリオをご存じでしたら参考までにと思っての記載です。ご存じない場合、ネタバレやお時間の都合などもあると思いますので、シナリオを確認していただくなどはしなくて大丈夫です\nWhat am I to youというシナリオに参加したキャラクターです。\nシナリオURL　https://www.pixiv.net/novel/show.php?id=11101305\n伊吹がPC2、杉宮がPC4です。\n続編のThe Black Curtainにも参加しています。(続編時は伊吹がPC3、杉宮がPC4)\nシナリオURL　https://www.pixiv.net/novel/show.php?id=11630183\n\n\n▪︎二人の関係性\n初めのうちはギスギスしていたけれど、ちょっとずつ相棒らしくなってきている……と言う感じの二人です。\n\n＞最初はギスギスだったお二人が今はどんな日常を過ごされているかや、仕事休憩にお茶をしたりするのでしょうか😊\nとのことでしたが、キャンペーンのエンディングでは「きちんと相棒になりたい」という気持ちから、伊吹が杉宮を食事に行く誘いました。杉宮は「奢りならいいですよ」と答えました。たぶんパスタとかを食べに行きます。\n仕事休憩時は、自動販売機で飲み物などを買って一緒に休憩することもあるかもしれません。\n伊吹はブラックコーヒーを買い、杉宮にはミルクティーかカフェオレなどを買うと思います。\n伊吹が女の子はミルクティーとかカフェオレだと思いこんでるためですが、実際に杉宮は甘いものが好きなのでチョイスは合っているみたいです。\n\n\n▪︎構図やシチュエーションについて\nお任せします！\nMARU＋2さんのTwitterのメディア欄を拝見して、企画名が入っている縦長のイラストがちょっと同人誌の表紙みたいでいいな......！となったので、もしイラストにタイトルなどあれば、同人誌の表紙風に配置していただけると嬉しいです。\nその場合、納品時はタイトルありとイラストだけでどちらも見れるようにしていただけるとありがたいです。\n\n▪︎補足\nもしキャラクターの参考資料が足りない場合、こちらからダウンロードできるPDF内にもう何枚か彼らを描いたイラストがありますのでご確認ください。\nhttps://gochamazetoybox.booth.pm/items/5055998\n\n\n以上です。\n読んでくださりありがとうございました。\nご検討いただけると幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurimori_/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1487809, "client_id": 1332241, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20a6b4b3/uploads/origins/f2c23db7-c6ae-4ee3-83d4-78f1f9c26968?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9657fe9f0302739ae2ca749ccf68dc63", "srcset": "https://si.imgix.net/20a6b4b3/uploads/origins/f2c23db7-c6ae-4ee3-83d4-78f1f9c26968?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9657fe9f0302739ae2ca749ccf68dc63, https://si.imgix.net/20a6b4b3/uploads/origins/f2c23db7-c6ae-4ee3-83d4-78f1f9c26968?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef85c8eedee179e3d0dd7b32ec60870e 2x, https://si.imgix.net/20a6b4b3/uploads/origins/f2c23db7-c6ae-4ee3-83d4-78f1f9c26968?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f50206e990277185bcea817ea97b9fdf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20a6b4b3/uploads/origins/f2c23db7-c6ae-4ee3-83d4-78f1f9c26968?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f45eee6ea405a53fdda57fd3d1e043f1", "srcset": "https://si.imgix.net/20a6b4b3/uploads/origins/f2c23db7-c6ae-4ee3-83d4-78f1f9c26968?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f45eee6ea405a53fdda57fd3d1e043f1, https://si.imgix.net/20a6b4b3/uploads/origins/f2c23db7-c6ae-4ee3-83d4-78f1f9c26968?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b1dca7073631b62724f6c2be2a2d9be9 2x, https://si.imgix.net/20a6b4b3/uploads/origins/f2c23db7-c6ae-4ee3-83d4-78f1f9c26968?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8360dcec58321642b2ab4af983a938b0 3x"}, "body": "くりもりさん、こんにちは。\n私のキャラクターとフォロワーのキャラクターのバディを描いてもらいたく、リクエストをお送りしました！(フォロワーには依頼してもOKと了承をもらっています)\n\n▪︎参考資料\nhttps://x.com/asaotrpg/status/1484119123752001537?s=20\nhttps://x.com/asaotrpg/status/1575833606122971137?s=20\nhttps://x.com/asaotrpg/status/1582328233961222144?s=20\n\n▪︎概要\n二人は『ダブルクロス The 3rd Edition』というTRPGのプレイヤーキャラクターです。\nダブルクロスの世界は基本的には私たちの住む世界とほとんど変わらないのですが、人々の知らない日常の裏側に異能力者が存在しています。\n異能力によって起こるトラブルや犯罪などもあり、そのような出来事から人々を守るために戦っている組織が存在します。\n今回依頼したい二人は、その組織に所属するエージェントで、バディを組んで任務に当たっています。\n\n▪︎キャラクターについて\n伊吹大地(いぶき・だいち)　23歳・男・176cm\n異能力：右腕にリニアキャノンを仕込んでいる。優れた視覚と思考力による精密な射撃が得意。\n性格など：一見クールで愛想がないように見えるが、意外と人付き合いは良い。賢いが、ちょこちょこ鈍かったりポンコツだったりするところがある。\n相手への感情(初期)：\n過去に元相棒を失っており、表向きは立ち直っているがまだ引きずっている。心に余裕がないため、杉宮とも向き合えていない。\n相手への感情(現在)：\n元相棒のことを昇華し、杉宮ときちんと相棒になりたいと思っている。\n\n杉宮楓(すぎみや・かえで)　21歳・女・162cm\n異能力：電撃を操る\n性格など：クールでダウナー系。平均点を取るのが得意なタイプの要領の良さがある。一方で、表には出さないが自分に自信がない。\n相手への感情(初期)：\n過去に伊吹(とその元相棒)に助けられたことがあり、憧れを抱いている。が、だからこそ自分が伊吹の現バディであることに対して拒否感を感じ冷たく当たっている。\n相手への感情(現在)：\n少しずつ、伊吹の存在が遠い憧れではなくなって、距離が近づいている。\n\n二人の関係性\n初めのうちはギスギスしていたけれど、ちょっとずつ相棒らしくなってきている……と言う感じの二人です。\n\n▪︎構図やシチュエーションについて\nお任せします！\n\n▪︎補足\nもしキャラクターの参考資料が足りない場合、こちらからダウンロードできるPDF内にもう何枚か彼らを描いたイラストがありますのでご確認ください。\nhttps://gochamazetoybox.booth.pm/items/5055998\n\n\n以上です。\n読んでくださりありがとうございました。\nご検討いただけると幸いです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@youheiogm/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1255350, "client_id": 1332241, "vtt_url": null, "thumbnail_image_urls": {"