=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3f6d37a0b9c641f366f9b50035ade29, https://si.imgix.net/157c2fcd/uploads/origins/b4c484c9-39a7-4458-909d-12e912ae50af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ef072e48b24dcf0f3024f15d2febd7a 2x, https://si.imgix.net/157c2fcd/uploads/origins/b4c484c9-39a7-4458-909d-12e912ae50af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c3100a0585a8df0ad0150dc23236fc3f 3x"}, "body": "アサルトリリィの上田伊万里がサッカー・ドイツ代表モデルのスーツ（2018）を着用しているイラストをお願いします。\n\n参考URL\nhttps://style.president.jp/fashion/2018/0623_000266.php\n\nピシッとした黒のスーツに、白いスニーカーを合わせて軽さを演出してるのが素敵ですね。伊万里にも似合うのではないでしょうか。\n\n参考URLのスタイリングではガタイがいい男性が着用するからなのか、スーツもスニーカーもスリムな感じになっています。\nが、小柄な伊万里にコーデを真似させるにあたっては、敢えてフィット感やサイズ感をゆるめにアレンジするのもいいかも知れません。\n原作の、華奢な女の子がゴツいスニーカーはいてるギャップも好きだったので。\n\nまた、参考URLの皆さんは、インナーは色を揃えてるだけで、丸首だったり襟付きだったりしています。\n私の個人的な好みは襟付きシャツです。\n\nご検討、宜しくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inochi_relation/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1159989, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32da811a/uploads/origins/d0073590-d16f-4bf1-926a-65ae6e3144f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=617b10997681ffa707674d4c4a616f1a", "srcset": "https://si.imgix.net/32da811a/uploads/origins/d0073590-d16f-4bf1-926a-65ae6e3144f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=617b10997681ffa707674d4c4a616f1a, https://si.imgix.net/32da811a/uploads/origins/d0073590-d16f-4bf1-926a-65ae6e3144f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39d0885852800b6240b166f381616f5e 2x, https://si.imgix.net/32da811a/uploads/origins/d0073590-d16f-4bf1-926a-65ae6e3144f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ed01d866c377c8be86f0589b410b99f 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32da811a/uploads/origins/d0073590-d16f-4bf1-926a-65ae6e3144f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=478ee0fd2ebe8045ffa2431f8c0ca5ea", "srcset": "https://si.imgix.net/32da811a/uploads/origins/d0073590-d16f-4bf1-926a-65ae6e3144f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=478ee0fd2ebe8045ffa2431f8c0ca5ea, https://si.imgix.net/32da811a/uploads/origins/d0073590-d16f-4bf1-926a-65ae6e3144f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fbc837d217216ba739dbd7c0e76a87a6 2x, https://si.imgix.net/32da811a/uploads/origins/d0073590-d16f-4bf1-926a-65ae6e3144f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a75b810b8c266371bf0e31b5fb446bb2 3x"}, "body": "とんでもオーダー待ってますとのことだったので、他の方には頼みにくいアサルトリリィ依頼をさせていただきます\n\n\n前提設定\n〇生前露出狂だったおっさんの霊が憑依の力を会得して叶星に憑依して体も人生も乗っ取ってしまう\n〇さっそくグランエプレのみんなの前で露出しようと試みる\n〇高嶺はいると話がややこしくなりそうなので今日は用事でいない\n※中身がおっさんの叶星はそのまま叶星と表記します\n\n\n本文\nコートの下は全裸な叶星がエプレ一年生の前でその裸体を晒します。靴下だけ履いてます。\nがに股で裸体を見せつけてき、股間からは愛液が垂れ流れています。乳首もビンビンです。\n表情はアへ顔って感じで舌出してるイメージです　見られた発情してる感じでお願いします。\n全体的に下品です。　\n叶星のセリフはlilcute田中先生にお任せします、品性を疑うようなものをお願いします。　\n喘ぎ声を入れるなら汚い喘ぎ声の方が好ましいです。\n\nエプレの三人は描かなくても大丈夫です。セリフだけ先生にお任せしたいです。\n先生の解釈に全面的に任せますが、姫歌は軽蔑してドキツイこと言ってくれると嬉しいです。\n灯莉も辛辣めだと私が嬉しいです。紅巴はもう完全にお任せします。\n\n\n\nそれともしよろしければ体は動かせないが本物の叶星の意識だけは残ってて、現状に対しての誰にも聞こえない悲痛な心の声が描かれる、なんかもあると嬉しいです。\n別ファイルになってしまうと思いますがほんとセリフだけの違いです　本物叶星のセリフだけで大丈夫です　もしよろしければ程度なので全然なくても大丈夫です。\n\n\nご一考お願い致します。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inochi_relation/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1159989, "client_id": 2637841, "vtt_url": null, "thumbnail_image_urls": {"