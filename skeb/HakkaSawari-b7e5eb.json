びっくり\n（今日はずっとふたりでいたかったから）\n｢なんでそう唐突なの…｣照れ\n（唐突じゃないよ、見てたら気持ちがたかぶることあるじゃん）\n｢…今の私みたいに？｣\n（……かな）←照れ\n｢な〜に照れてるの？自分から言ったくせに｣←からかう\n｢私も今日はふたりでいたいよ｣\n｢せっかくのお休みだから、今日は隙間なくくっついていたいかな｣←満面の笑み\n（さわりちゃん…！）\n｢でも、今から朝ごはん作るんだから今はダメ！！｣\n｢ほら、作ってあげるんだから手伝ってね｣", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@HakkaSawari/works/1", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1988648158268911620%2Fsk77ltKh.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d6641034a3a5980f113eb5d3bfdefdd", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1988648158268911620%2Fsk77ltKh.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d6641034a3a5980f113eb5d3bfdefdd, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1988648158268911620%2Fsk77ltKh.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f6f2380c63bbabef5cbf1f64e5a2adab 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1988648158268911620%2Fsk77ltKh.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea7b1eaabd1115cd53e25fd662519f6e 3x"}, "private": true, "genre": "voice", "tipped": false, "creator_id": 157714, "client_id": 429548, "nc": 178}], "sent_works": [], "similar_creators": []}, "price_history": {"voice": [{"amount": 5000, "recorded_at": 1774027606.929317}], "art": [{"amount": 5000, "recorded_at": 1774027606.929317}]}, "custom": {"custo