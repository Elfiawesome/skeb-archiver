利用、個人鑑賞を想定しています。\n服装は資料URLの衣装ご自由に描いていただいて構いません、構図やポーズはお任せします。\nhttps://drive.google.com/file/d/16MWLIa8tC3_B6oIxv1ey5uc97zQpqLxm/view?usp=drive_link\nもし金額不備などがございましたら、お手数おかけいたしますが、再送いただけますと幸いです。\nその他不明な点はご自由に描いて頂いて大丈夫です、よろしければご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/12vRqTfg6hcWcxoqbgX-rxeQT-l1xDMRo?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nijimine/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3597252, "client_id": 2880416, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d4d13af/uploads/origins/8a630736-c934-4de7-bf8e-47df6eb1cd79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ee63b6f4016958869f382354b5b90fe", "srcset": "https://si.imgix.net/7d4d13af/uploads/origins/8a630736-c934-4de7-bf8e-47df6eb1cd79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ee63b6f4016958869f382354b5b90fe, https://si.imgix.net/7d4d13af/uploads/origins/8a630736-c934-4de7-bf8e-47df6eb1cd79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c41f8b208b6122f48a94531c9a0c8cf 2x, https://si.imgix.net/7d4d13af/uploads/origins/8a630736-c934-4de7-bf8e-47df6eb1cd79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=361b521b49255e46d3c3501ea7d7b230 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d4d13af/uploads/origins/8a630736-c934-4de7-bf8e-47df6eb1cd79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d73d8f77563a4e5e60b057e65cfd639", "srcset": "https://si.imgix.net/7d4d13af/uploads/origins/8a630736-c934-4de7-bf8e-47df6eb1cd79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d73d8f77563a4e5e60b057e65cfd639, https://si.imgix.net/7d4d13af/uploads/origins/8a630736-c934-4de