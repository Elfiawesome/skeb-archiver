ちが希望です。大まかなポーズのアイデアを送りました。ポットを持つ代わりに、彼女の腕を別のポーズにしてもらえますか？ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1JUs5ug8dh7lsUcBSdUOql7WhhHV5jSoF?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Herohero_illust/works/146", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/493972ce/uploads/origins/82cf3a44-0709-4143-bfd9-a58572a4dc08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=16aade250876aaffaa3d4e4f07d85d8b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 272924, "client_id": 916862, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Herohero_illust/works/145", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 272924, "client_id": 207733, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08f4e345/uploads/origins/c0501672-1f4d-45ae-8765-5328ce1ca745?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d3320f2914f2fe54e6e17fd78155078", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08f4e345/uploads/origins/c0501672-1f4d-45ae-8765-5328ce1ca745?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cc09bf3dd3bbb83a9c2cd0cd8a86abb", "src_set": ""}, "body": "突然の連絡失礼します。Twitterに挙げられています競泳水着のウマ娘がとても素晴らしいものでしたので、以下の内容でリクエストしたくご連絡させていただきました。\n〇キャラ\nホッコータルマエ（ウマ娘）\n〇服装\n競泳水着\n勝負服のカラーリングを参考に先生のオリジナルデザインでお願いします。\n先生の作品の競泳水着ダンツイラストの光沢感と密着感が好きだったので、よろしくお願いします。\n〇構図\n身体を見せつけている感じ。\n〇要望\n・先生の作品のアルダンやダンツの様にスタイル良くお願いいたします。\n〇備考\nファイルはPSDファイルで大丈夫です。\n\nご検討、よろしくお