x.net/0b5517e0/uploads/origins/cd597087-4778-4872-be48-100b2d9f9511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80305d32fd37ef03ae48f8f9205dbc0b", "srcset": "https://si.imgix.net/0b5517e0/uploads/origins/cd597087-4778-4872-be48-100b2d9f9511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80305d32fd37ef03ae48f8f9205dbc0b, https://si.imgix.net/0b5517e0/uploads/origins/cd597087-4778-4872-be48-100b2d9f9511?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=48f200cf8cf53d1c5bde4190d669a942 2x, https://si.imgix.net/0b5517e0/uploads/origins/cd597087-4778-4872-be48-100b2d9f9511?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=920548e79ef46adba68095e6bc8826ee 3x"}, "body": "◆ 申し訳ありません、前のリクエストに誤りがありました...\n\nこんにちはめぐを先生～( ˵´ ꒳ `˵ )ノ\n\n\nあなたの作品が本当に大好きです！先生のファンアートは最高です！OCカップルの絵をお願いしたいです。\n\n◆参考リンク： https://sta.sh/2264lcjzqo5s\n\n◆キャラクター：\n\nゆうやくん：188cm、赤毛。\n厳格で愛想がなく、短気なところがある。しかし、つむぎには好意を抱いており、言葉よりも行動で示すような愛情を注ぐ。つむぎに対しては独占欲が強い。野心が強く、CEOを目指している。米とコーヒーが好き。\n※ 体格は筋肉質である。※\n\nつむぎくん：173cm、白髪。\n穏やかで礼儀正しく、落ち着いた性格の持ち主。威圧感のあるゆうやだが、つむぎはそんなゆうやを怖がらず、忍耐強く優しく接する。美術館に勤務しており、写真と昆虫採集が趣味。\n\n\n※彼らは婚約者です。猫2匹と同居している。\n※どちらも忙しいが、それでもデートの時間を作っている。\n\n\n◆リクエスト詳細:\n※ この服装で描いてください。\nhttps://sta.sh/01hpy98w6fnd\n\n私は先生の描く食べ物が大好きなので.\n※モチーフ：コーヒーとミルク、いちご、テディベア、チョコレート\n\nもちろん、自分でテーマを決めることもできます！\n\n\n要望を聞いていただき、ありがとうございました！( ˵ˊ ᵕ ˋ˵)\n\nhttps://sta.sh/2264lcjzqo5s", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@GuyutyanKani/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1191450, "client_id": 2755750, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2632ff8d/uploads/origins/a887b9a9-fcc2-44ba-82be-96b2698647db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8365357c285c677179c1cb82e3ca868f", "src