igins/088e7c49-5151-4e93-ac8a-0992d3174345?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=178ade7c45d8355b277d704aad03b93b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47040574/uploads/origins/088e7c49-5151-4e93-ac8a-0992d3174345?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cbbf2b8e836829bd7d76450cfe5d5c2", "srcset": "https://si.imgix.net/47040574/uploads/origins/088e7c49-5151-4e93-ac8a-0992d3174345?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cbbf2b8e836829bd7d76450cfe5d5c2, https://si.imgix.net/47040574/uploads/origins/088e7c49-5151-4e93-ac8a-0992d3174345?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fdff7e98afe0bf12346356a624859a61 2x, https://si.imgix.net/47040574/uploads/origins/088e7c49-5151-4e93-ac8a-0992d3174345?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b440e6bcfb6dad336f2511207be33087 3x"}, "body": "こんにちは、アマノコ先生\n\nいつもお世話になっております。\n\nもしよろしければ、またマンハッタンカフェのイラストを依頼したいのですが、デンマークの童話『ザ・シャドウ』をほのめかすような、ゆるやかな表現でお願いします。\n\n想像する一つの描写としては、カフェが部室に座り、彼女のランプの光が壁に影を落としている場面です。しかし、実はその影はカフェの影そのものではなく、影のようなお友だちであることが判明するのです。\n\nだが、上記はあくまで一例に過ぎません。最終的には、その描写の仕方は先生にお任せします。\n\n『ザ・シャドウ』簡単な背景\nある学識者の影が自己意識を持ち、独自の生命を得る。その影は人間の行動の暗部に対する洞察を得る。\n\nよろしくお願いします。\n\nhttps://en.m.wikipedia.org/wiki/The_Shadow_(fairy_tale)#/media/File%3AShadow_Pedersen.jpg", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_AmAnok0/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1018322, "client_id": 62571, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5cf65c0/uploads/origins/ae40070c-4b77-4d68-89ac-d47cf85fed97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a6ae8842e9302045f0766a444b696d5", "srcset": "https://si.imgix.net/d5cf65c0/uploads/origins/ae40070c-4b77-4d68-89ac-d47cf85fed97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a6ae8842e9302045f0766a444b696d5, https://si.imgix.net/d5cf65c0/uploads/origins/ae40070c-4b77-4d68-89ac-d47cf85fed97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=023ee985ab516f31f85c089bde2668d1 2x, https://si.imgix.net/d5cf65c0/uploads/origins/ae40070c-4b77-4d68-89ac-d47cf85fed97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d37dfd61fe4cc03b2fd32a226db0dce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5cf65c0/uploads/origins/ae40070c-4b77-4d68-89ac-d47cf85fed97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30184360c78f7a7141b65172493d7929", "srcset": "https://si.imgix.net/d5cf65c0/uploads/origins/ae40070c-4b77-4d68-89ac-d47cf85fed97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30184360c78f7a7141b65172493d7929, https://si.imgix.net/d5cf65c0/uploads/origins/ae40070c-4b77-4d68-89ac-d47cf85fed97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d0e0e49e238d521a473b79851a1b63bd 2x, https://si.imgix.net/d5cf65c0/uploads/origins/ae40070c-4b77-4d68-89ac-d47cf85fed97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=25444025d79eec8ffff4d145938d1edd 3x"}, "body": "初めまして。\nアマノコ様に描いてもらいたい絵がありまして今回送らせて頂きました。\n\n(もし依頼を送った時点で二次創作がNG案件でしたら申し訳ございません…)\n\nリクエストしたい内容は下記の通りになります。\n\n■リクエスト内容\nウマ娘のマスク姿のイラスト\n\n■イメージ\nトレセン冬コートの格好を基本形お願いします(手袋やマフラーの有無はお好みで)\n防寒の一貫としてマスクをしているみたいな感じです。\n\n\nマスクは白の布地か不織布の普通の感じので構いません。\n\n詳しくは添付の資料を参考にお願いします。\n\nイメージ(造形の参考までに)\n布→https://images.app.goo.gl/EwXV8\n不織布→https://images.app.goo.gl/CEgHF\n\n\n■構図\nキャラの前面が映る角度でお願いします。\n距離は全身、もしくは腰ぐらいは映る距離感が望ましいです。\n\nhttps://www.pixiv.net/artworks/103815069\nhttps://www.pixiv.net/artworks/127250299\nアマノコ様の過去作品を引用していますが、こちらとかイメージとして理想な感じです…！\n\n\n■キャラクター候補\nグラスワンダー、マンハッタンカフェ\n\nどちらも好きなキャラなので誰が描かれても問題ありません(カフェは勿論のこと、アマノコ様の絵柄のグラスも見てみたい気持ちもありまして！)\n\n\n\n【！】可能なら見たい要素\n①素顔差分\nキャラの表情そのもの描写も好きなので、差支えなければお願いします。\n\n②二人組の組み合わせ\n厚かましくも希望だけ書くことをお許しください。\n\n\n\nこちらからは以上となります。\n\nよろしければご一考の程よろしくお願いします。\n\n最後になりましたが、今回の依頼に不都合等がございましたら申し訳ございません。\n\nうれぎ\n\nhttps://x.com/Phalanx_Lupo/status/1905585909015478489?t=ZLCKR0x1v84WLoyq8HC59w&s=19", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_AmAnok0/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1018322, "client_id": 2838293, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54b89c9c/uploads/origins/97f8bb55-023a-4092-bd03-626e918398cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4faf7240844a91c1bf36a2e4198fb887", "srcset": "https://si.imgix.net/54b89c9c/uploads/origins/97f8bb55-023a-4092-bd03-626e918398cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4faf7240844a91c1bf36a2e4198fb887, https://si.imgix.net/54b89c9c/uploads/origins/97f8bb55-023a-4092-bd03-626e918398cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e44939104d4a61252aa82bc548e38eb7 2x, https://si.imgix.net/54b89c9c/uploads/origins/97f8bb55-023a-4092-bd03-626e918398cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da5ffaf71e4d6325934e2c2915406f8b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54b89c9c/uploads/origins/97f8bb55-023a-4092-bd03-626e918398cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19b37c08c4b7c3879038394171ad3f94", "srcset": "https://si.imgix.net/54b89c9c/uploads/origins/97f8bb55-023a-4092-bd03-626e918398cf?bg=%23fff&auto=format%2Cc