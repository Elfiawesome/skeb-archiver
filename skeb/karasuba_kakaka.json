うにするためで、NSFWの内容かどうかは問いません！\nあとはよろしくお願いします！ドラゴンについての参考などはこのフォルダに入れました：\nhttps://drive.google.com/drive/folders/10HdhWUhUrUzRWMhyzsiQwVRYlVEssZch\n\nhttps://drive.google.com/drive/folders/1WSZhqSom99pW1G7WVK6f-gE-9RL5oHvn", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karasuba_kakaka/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2387188, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3214df5a/uploads/origins/7778fe76-a364-4987-9d1f-f42793c45f97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4198314389fcd1c587e4e8682154df17", "srcset": "https://si.imgix.net/3214df5a/uploads/origins/7778fe76-a364-4987-9d1f-f42793c45f97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4198314389fcd1c587e4e8682154df17, https://si.imgix.net/3214df5a/uploads/origins/7778fe76-a364-4987-9d1f-f42793c45f97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=753f7d5271981b462da128079633d84b 2x, https://si.imgix.net/3214df5a/uploads/origins/7778fe76-a364-4987-9d1f-f42793c45f97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e89163520ffdf52588bc28b4f279f99 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3214df5a/uploads/origins/7778fe76-a364-4987-9d1f-f42793c45f97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b092425da26d31c64f6d78dc263e1c49", "srcset": "https://si.imgix.net/3214df5a/uploads/origins/7778fe76-a364-4987-9d1f-f42793c45f97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b092425da26d31c64f6d78dc263e1c49, https://si.imgix.net/3214df5a/uploads/origins/7778fe76-a364-4987-9d1f-f42793c45f97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ecd875c296bac68fdec