 image for use on social media (Twitter, Twitch, Youtube), but it is not required.\n\nI would be very happy if you drew her, thank you so much!\n\nhttps://drive.google.com/drive/folders/1YBgKs1sBys8eswx-Tk-dG2XFgx5wjg7l?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chino_616/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3390875, "client_id": 537031, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a7cfe7e/uploads/origins/22df4cb1-47fc-4da7-b5c2-5338ade7d7cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ddbeaa0be28cd7fd56fe7f6ea77d63a", "srcset": "https://si.imgix.net/9a7cfe7e/uploads/origins/22df4cb1-47fc-4da7-b5c2-5338ade7d7cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ddbeaa0be28cd7fd56fe7f6ea77d63a, https://si.imgix.net/9a7cfe7e/uploads/origins/22df4cb1-47fc-4da7-b5c2-5338ade7d7cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=391a7c233db0c78d8e2f1bf7aee5531b 2x, https://si.imgix.net/9a7cfe7e/uploads/origins/22df4cb1-47fc-4da7-b5c2-5338ade7d7cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af59ce4c99c6993e524362da20634686 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a7cfe7e/uploads/origins/22df4cb1-47fc-4da7-b5c2-5338ade7d7cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94eb202b22efed080fa8acd5a2512602", "srcset": "https://si.imgix.net/9a7cfe7e/uploads/origins/22df4cb1-47fc-4da7-b5c2-5338ade7d7cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94eb202b22efed080fa8acd5a2512602, https://si.imgix.net/9a7cfe7e/uploads/origins/22df4cb1-47fc-4da7-b5c2-5338ade7d7cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur