fa7346bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dc938821946d57c9a66801ac1f4d2e79 3x"}, "body": "リクエストさせていただきます\n\n相馬夏美、槙原志保、柳瀬美由紀([いつか夢見る未来で]の特訓後の大人姿)が超乳＆巨尻の全裸で\n互いの乳首を合わせるように向かい合ってトリプルパイズリをしていて\nその様子を斜め上から見下ろす視点で3人の視線はこちらを向いている\n\n乳首から母乳が出ていて顔が蕩けている差分とおまかせでセリフをお願いします\n\n以上のシチュエーションでお願いします", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tourai/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2336, "client_id": 1037704, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/daa8d1f3/uploads/origins/01421f6f-e53e-4bcd-893b-1c1d51f44a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d14e6fd624bc400ac71862439d2fa4f9", "srcset": "https://si.imgix.net/daa8d1f3/uploads/origins/01421f6f-e53e-4bcd-893b-1c1d51f44a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d14e6fd624bc400ac71862439d2fa4f9, https://si.imgix.net/daa8d1f3/uploads/origins/01421f6f-e53e-4bcd-893b-1c1d51f44a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68633fb9ffe4684b668add3302aebf00 2x, https://si.imgix.net/daa8d1f3/uploads/origins/01421f6f-e53e-4bcd-893b-1c1d51f44a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb1b4de3cd379d4707c8bc900854f4c4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/daa8d1f3/uploads/origins/01421f6f-e53e-4bcd-893b-1c1d51f44a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa8c4c985eba11fc95c461c1c7cb85bf", "srcset": "https://si.imgix.net/daa8d1f3/uploads/origins/01421f6f-e53e-4bcd-893b-1c1d51f44a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa8c4c985eba11fc95c461c1c7cb85bf, https://si.imgix.net/daa8d1f3/uploads/origins/01421f6f-e53e-4bcd-893b-1c1d51f44a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4e4544388d30dc875d9a7bf32771d045 2x, https://si.imgix.net/daa8d1f3/uploads/origins/01421f6f-e53e-4bcd-893b-1c1d51f44a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1991986ec7fd695ea702c881cd70a713 3x"}, "body": "リクエストさせていただきます。\n\nシンデレラガールズの日下部若葉と的場梨沙と大沼くるみの全裸爆乳化イラストをお願いします。\n以前描いていただいた若葉・梨沙のセクシー対決(https://skeb.jp/@Tourai/works/4)の続編イメージで、グラビア撮影終了後に真のNo.1セクシーアイドルかをプロデューサーに決めさせるためアピールしている状況。\n\nポーズイメージは前回の様なセクシーポーズの若葉と梨沙の間に、両手広げてバンザイポーズをとっているくるみ\n\nシチュエーションの流れは\n①撮影終了後に若葉と梨沙によるセクシーアピール対決\n②勝った方がプロデューサーを独り占めと確認していたら、くるみが参戦\n③くるみが来た途端にいつもより激しい勃起に憤る梨沙、妄想に耽る若葉、今日も元気だと喜ぶくるみ\n④今日もの意図を聞くと最近くるみの胸を使ってイロイロしていたと判明、あーハイハイと呆れる梨沙\n⑤あくまで3人揃ったからいつもより激しいと弁明しながら証拠を見せると、激しくシゴくプロデューサーに雄を感じ目が離せない3人\n⑥激しい射精の量と匂いに即堕ちする3人\n⑦不安にさせてすまなかったとさらにシゴくプロデューサーを見て、担当がこのプロデューサーで幸せと思う3人\n⑧追加ぶっかけを受け、お嫁さん宣言するも貴方の1番は自分だと仲良く宣戦してハーレムエンド\n\n番外でマイクロビキニやスリングショットなどのエロ水着を着て撮影した架空のグラビアページ風差分をお願いします\n\nご検討のほどよろしくお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tourai/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2336, "client_id": 910290, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8c2921c/uploads/origins/4d540a9d-2dcc-4c56-b916-8b49ed765f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9484482756070958285c89d8c43cfed", "srcset": "https://si.imgix.net/b8c2921c/uploads/origins/4d540a9d-2dcc-4c56-b916-8b49ed765f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9484482756070958285c89d8c43cfed, https://si.imgix.net/b8c2921c/uploads/origins/4d540a9d-2dcc-4c56-b916-8b49ed765f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9f839724eff0a12034b0ef3695e8b66 2x, https://si.imgix.net/b8c2921c/uploads/origins/4d540a9d-2dcc-4c56-b916-8b4