278-4105-918b-c4656189e190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e23060b74b41e6b4c9f3b503e6cda4f0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7e968cb/uploads/origins/dcb011ca-5278-4105-918b-c4656189e190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67ee2012bb670a790748246c47b8d935", "srcset": "https://si.imgix.net/d7e968cb/uploads/origins/dcb011ca-5278-4105-918b-c4656189e190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67ee2012bb670a790748246c47b8d935, https://si.imgix.net/d7e968cb/uploads/origins/dcb011ca-5278-4105-918b-c4656189e190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2673b55ac23cb82c9fbafaff6e8967c2 2x, https://si.imgix.net/d7e968cb/uploads/origins/dcb011ca-5278-4105-918b-c4656189e190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8dfe49a6f15abf548313a4c615c1e406 3x"}, "body": "こんにちは、はじめまして。\n\nあなたの絵が好きなので、リクエストを送らせていただきます！よろしくお願いします。\n\nFate/EXTRA CCCのBBとザビ子を一緒にお願いしたいです。BBは床に座り、ザビ子はBBの膝に頭を乗せて寝かせ、膝枕にする予定です。BBにはザビ子の髪も撫でて欲しいです。\n\nBBの髪の毛は、床一面にカーテンのように長くしてほしい。そして、ザビ子には黒い制服を着てもらいたい。\n\nBB: https://imgur.com/a/mKi41VV\nザビ子： https://imgur.com/a/yb3qrBB\nポーズ： https://i.imgur.com/Xpz61yn.jpg\n\nご検討ありがとうございました。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riri08poster/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1468902, "client_id": 1246707, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d15a02a/uploads/origins/5d70c934-5cf5-43dc-a15e-6ebf721c5ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf1c8097a141a8858e7cbbca3af38b16", "srcset": "https://si.imgix.net/1d15a02a/uploads/origins/5d70c934-5cf5-43dc-a15e-6ebf721c5ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf1c8097a141a8858e7cbbca3af38b16, https://si.imgix.net/1d15a02a/uploads/origins/5d70c934-5cf5-43dc-a15e-6ebf721c5ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6cc491f3311ebcc320abff895a77808 2x, https://si.imgix.net/1d15a02a/uploads/origins/5d70c934-5cf5-43dc-a15e-6ebf721c5ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1cfa80e4e38401c9c2715e157bc83ceb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d15a02a/uploads/origins/5d70c934-5cf5-43dc-a15e-6ebf721c5ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e66b9f1c3e54b11e16d3b08c16b0389d", "srcset": "https://si.imgix.net/1d15a02a/uploads/origins/5d70c934-5cf5-43dc-a15e-6ebf721c5ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e66b9f1c3e54b11e16d3b08c16b0389d, https://si.imgix.net/1d15a02a/uploads/origins/5d70c934-5cf5-43dc-a15e-6ebf721c5ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e1ffabe68183a3547bccf53ea613bae 2x, https://si.imgix.net/1d15a02a/uploads/origins/5d70c934-5cf5-43dc-a15e-6ebf721c5ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=341abca509a30f5114bed883ac5016aa 3x"}, "body": "こんにちは。お忙しいところすいません。\nTRPGセッションで使う立ち絵の依頼をお願いしたいと考えています。\n\n●使用予定シナリオ：『カノヨ街』HO：貼紙\n\n●概要\nサイズ：全身立ち絵\n枚数：1枚\n差分：翅あり/なし　の二種類\n\n●詳細\n通過済とのことで秘匿バレありでお話します、よって非表示で依頼させていただきます。\n\n\n\n性別：女\n年齢：外見上10歳前後\nステータス：APP17,SIZ11（子供基準なので140 cmくらい）\n\n\n設定：弐番地の駄菓子屋に居つく看板娘。座敷わらしのような存在。時折生えては消える蝶の翅などから、純粋なそれというよりは精霊や付喪神に近い何かだと推察できるかもしれない。\nイメージモチーフ：紙風船\n\n髪：白髪にグラデーションのショート(詳しくは画像参照)\n目：銀\n肌：色白\n服装：白を基調とし、端が黄色のグラデーションになっている着物(詳しくは画像参照)、帯の紐は蘇芳色。柄として花弁が五枚の花の刺繍が六つ(5×6＝30、スパイっていったら裏切り者、裏切り者っていったらユダ、ユダっていったら銀貨三十枚の逸話……って発想です)\n靴：帯と同じ蘇芳色を基調とした下駄、白い足袋\nその他：\n・白い蝶々の大きな翅が背中から生えている。柄はジャノメチョウという蝶に似たイメージで、紙風船の吹き込み口を模したような銀の斑点(虫苦手だったらごめんなさい)\n・右肩と右手首がざっくりと切られた紙のようになっていて、切り口から折り紙の蝶々がひらひら舞っている\n\nポーズ：描きやすいかんじで構いません。右肩と右手首付近が蝶々になってるので、それがわかりやすいものだと嬉しいです\n\nキャラシ（参考にどうぞ）：https://charasheet.vampire-blood.net/3937637\n\nできればこれは残していただけると嬉しいこだわり\n・蘇芳色と黄色を取りいれる(裏切り者っぽい色ってことで……)\n・着物の刺繍\n・紙風船がモチーフになってる感\n・折り紙の蝶々と切れた右手首(人外要素)\n\n\nよろしくおねがいします。\n\nhttps://drive.google.com/file/d/1kNNvOGiSokvtBKJuIuxk4PR5A9j4CdEx/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riri08poster/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1468902, "client_id": 1196514, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f290b82/uploads/origins/fd36a203-8b6a-4be3-a1d5-713d3c70fc75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8f7301b44c8db9be3782ea9295e0dd7", "srcset": "https://si.imgix.net/6f290b82/uploads/origins/fd36a203-8b6a-4be3-a1d5-713d3c70fc75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8f7301b44c8db9be3782ea9295e0dd7, https://si.imgix.net/6f290b82/uploads/origins/fd36a203-8b6a-4be3-a1d5-713d3c70fc75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f32feca6af070390151ae3372f616888 2x, https://si.imgix.net/6f290b82/uploads/origins/fd36a203-8b6a-4be3-a1d5-713d3c70fc75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6fac3fd00186faf0973416181775a338 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f290b82/uploads/origins/fd36a203-8b6a-4be3-a1d5-713d3c70fc75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fba7649bc08d6e0804ba57a6f670fecb", "srcset": "https://si.imgix.net/6f290b82/uploads/origins/fd36a203-8b6a-4be3-a1d5-713d3c70fc75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200