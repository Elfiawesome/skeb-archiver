": false, "genre": "art", "tipped": false, "creator_id": 3055450, "client_id": 3646300, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aed20c00/uploads/origins/ee77eb59-64b8-447a-87af-8782a8ad1e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d5b0c5c8f9a703c151f17ac5c258556", "srcset": "https://si.imgix.net/aed20c00/uploads/origins/ee77eb59-64b8-447a-87af-8782a8ad1e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d5b0c5c8f9a703c151f17ac5c258556, https://si.imgix.net/aed20c00/uploads/origins/ee77eb59-64b8-447a-87af-8782a8ad1e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7521f1b69bba73b9272b2f6e5243dd9c 2x, https://si.imgix.net/aed20c00/uploads/origins/ee77eb59-64b8-447a-87af-8782a8ad1e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9b66e3d66123b00e369b66af41d99c1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aed20c00/uploads/origins/ee77eb59-64b8-447a-87af-8782a8ad1e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68bf5b05dccef9cb23e62521f560ace0", "srcset": "https://si.imgix.net/aed20c00/uploads/origins/ee77eb59-64b8-447a-87af-8782a8ad1e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68bf5b05dccef9cb23e62521f560ace0, https://si.imgix.net/aed20c00/uploads/origins/ee77eb59-64b8-447a-87af-8782a8ad1e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0442df9f8cd1a0c7cdaeac89b86e92dd 2x, https://si.imgix.net/aed20c00/uploads/origins/ee77eb59-64b8-447a-87af-8782a8ad1e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5c2824dac1b3757f6eef993972acee7c 3x"}, "body": "TRPGに利用するNPC立ち絵の依頼\n\n利用方法:TRPGおよびそれに類するなりきりチャット\n\n私のアークナイツTRPGでの自作シナリオ用NPCの立ち絵と、3等身程のSD絵の計2枚を依頼させて頂きます\n\nアークナイツの世界観をイメージしたオリジナルキャラクターです\n・コードネーム(キャラ名):チャレンジャー\n・性別:女性\n・年齢:14〜16歳\n・身長:150cm\n・髪色:黒、(#454545) くらいをイメージ\n・瞳の色:赤、(#993333)くらいをイメージ\n・髪型、服装等はキャラクターシートの立ち絵そのままで大丈夫です。\nキャラの説明も書いておきます。\n所謂毒親的な父親の精神・物理的虐待下で育ち、父親にある種支配されたまま生きていましたが、シナリオの中盤でPCによって育った街の外へ連れ出されます。\nですが、自分の軸となっていた物が消失した事、周りが全く分からない環境になった事、過去のトラウマなどから重度のPTSDと対人恐怖症を患い、その治療を少しずつして行くことになります(その部分がシナリオの後半)\n(細かなキャラクター性はキャラクターシートのプロファイル欄を読めばわかると読めば7、8割くらいは分かっていただけるつもりで書いているで読んでいただければと) \n\nキャラクターモチーフ:尻尾の長い黒猫、短毛種、耳はしっかりとした立ち耳で\nその他:人耳はなるべく見えない様にお願いしたいです。私が四つ耳あまり好きじゃないので.....\n最後にキャラクターシートを添付しておきます。よろしくお願いいたします\nhttps://docs.google.com/spreadsheets/d/1cnDZD_Rb7OF67Taq3nfKSQs9jXoPxOZscrRruq1bILE/edit?usp=drivesdk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiokonbu_trpg/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3055450, "client_id": 2734853, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73874527/uploads/origins/f35862fb-46ae-401c-be56-dc61cee968be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=277f3b30ddf6b938093225764bbc0096", "srcset": "https://si.imgix.net/73874527/uploads/origins/f35862fb-46ae-401c-be56-dc61cee968be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=277f3b30ddf6b938093225764bbc0096, https://si.imgix.net/73874527/uploads/origins/f35862fb-46ae-401c-be56-dc61cee968be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d88f6a0a8c8bf7d6a04de48080a01d2a 2x, https://si.imgix.net/73874527/uploads/origins/f35862fb-46ae-401c-be56-dc61cee968be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db8a51843a8b2c9e2fff414c0b3f964d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73874527/uploads/origins/f35862fb-46ae-401c-be56-dc61cee968be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&bl