fbf27c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d32b44ce9145bdcba5bc4ac8fe10414d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a13a8b2e/uploads/origins/1e696423-e701-488c-9db1-62a0cfbf27c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09a1833c57ba222792ebce206f5c525a", "src_set": ""}, "body": "初めまして。絵柄に惹かれ、この度FF14の自キャライラストのリクエストをさせていただきます。 \n装備のアップ画像等参加資料を添付しますので、ご確認いただけますと幸いです。\n\n◼︎キャラクター\n∟アウラゼラ、蟹角褐色\n∟黒髪、前髪パッツンロングヘア\n∟金目(目の輪郭あり)\n∟赤のシャドウとリップ\n∟クールビューティー、スタイリッシュ\n∟お胸は小さめです\n∟黒系、カチッとした服、軍服等のミラプリをよくしています。\n\n◼︎装備\n※武器有無はどちらでも構いませんが、もし描いてくださる場合は以下の武器でお願いいたします。\n武器：彼岸此岸【妖】\n頭：東方女学生絹紐\n胴：ヨルハ五三式軍装：格\n手：ヒップストリート・ハンドウェア\n脚：東方美玉袴下\n足：ヨルハ五一式軍靴：格\n耳：メネフィナイヤリング\n※ジェットブラックやスートブラックで染色\n\n◼︎ポーズや表情等\n∟ポーズや色味に特に指定はありません、お任せいたします。\n∟表情としては自信顔のような目つきが好きです。その他口元の表情はポーズと共にお任せいたします。\n\n◼︎その他\n∟用途はSNSアイコンやスマホなどの背景画像として\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Y1Yiki7M2attXvGirfeCCfNId3HMhYLB", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_x_x_x_zip/works/63", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8bfbfa3d/uploads/origins/ae87bedc-3995-48c2-90bf-3e64d19fddc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=82e9cb0c5ac87dfbedc0cfade03e22f7", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2875266, "client_id": 3660456, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@_x_x_x_zip/works/62", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2875266, "client_id": 1504375, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a993b821/uploads/origins/a8c08a80-5903-4043-873b-cad4d8b1eff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cd5614edce09eefaee466070eda8a5d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a993b821/uploads/origins/a8c08a80-5903-4043-873b-cad4d8b1eff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1daeac8e3e14c1d636ddbb1f4951b1e", "src_set": ""}, "body": "こんばんわ、とても好きな絵柄でしたのでうちの子をリクエストをさせていただきます。\n前髪ぱっつんロングの褐色ギャルアウラレンです\n\n参考フォルダ内の全体図資料の服装に鍛冶師AF胴を組み合わせてほしいです（ミラプリイメージ資料のような感じに）\n\nおへそにピアスを付けてほしいのと\nネイルをネイル資料のものに（手間でしたら無くても可）\n自分に入ってるのと同じタトゥー（タトゥー資料、三日月に蛇が絡みついているようなデザイン）を入れてほしいです\nタトゥーのサイズ感と細かい位置はお任せします\n\n構図、ポージング、背景もお任せします\n\nぜひよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1aqExOiYaOsUDIs01g17q1_aXbmLg3aZX?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_x_x_x_zip/works/61", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2875266, "client_id": 3692466, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2aa4e459/uploads/origins/101d911c-1ab8-4a0e-aa7b-c0525e10a599?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a52bf6a0ba8e2867dd23db275f61093", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2aa4e459/uploads/origins/101d911c-1ab8-4a0e-aa7b-c0525e10a599?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f376b7d9bf51d5eb8fef8c9bd9fde38", "src_set": ""}, "body": "親愛なる先生  \n\nこんにちは！先生の絵がとても好きで、ぜひイラストのご依頼をさせていただきたいです。よろしくお願いいたします！  \n\nこちらの4種類の服装デザインの中から1つ選んで描いていただければ大丈夫です！自由にアレンジしていただいて構いませんが、ドラゴン娘の場合は「クラゲヘア＋ロングヘア」でお願いしたいです。  \n\nキャラクター設定は、無表情で一見怖そうに見えますが、実際は陶器の人形のような顔をした、心優しいクールでダークな姉系キャラです。  \n\n先生には自由に創作していただきたいので、キャラのクールな一面やエレガントな一面を見せてください！🥹\n\n雰囲気の参考としてURLのサンプル画像を添付しました。  \nまた、ドラゴンの角の三面図も同封しております。  \n\n\nご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1vpd-Apy53NC0YAkSLq9bhds1UCmiWN1g", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_x_x_x_zip/works/60", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2875266, "client_id": 83091, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e7011354/uploads/origins/a4cb1c29-1117-4408-b6d4-513d7df59858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fb7c40f6d900921022b75a433e38e21", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e7011354/uploads/origins/a4cb1c29-1117-4408-b6d4-513d7df59858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02406324cbda5270c94c01c96c21415d", "src_set": ""}, "body": "前回は素晴らしい作品をありがとうございます！\n今回はサブキャラのアウラちゃんでリクエストお願いしたいです。(https://ibb.co/1mRJ3gZ)\n\n銀髪に褐色肌、左眼が赤で右眼が青です。\n胸は大きい方が好きなので出来るだけ大きく、腹筋はバキバキに盛って欲しいです！\nSSはバイクに乗っているポーズですが、特にポーズの指定はありません。好きなように描いていただいて構いません。\n表情や色なども同様で大丈夫です。\n一応キャラクターイメージとしては「自分のルックスに自信があって、よく男遊びしている、お調子者の問題児」です。※参考にしてもしなくてもOK！\n\n今回もまた受けてくださると嬉しいです。\nご一考よろしくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_x_x_x_zip/works/59", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ccbaaa59/uploads/origins/b5759bfa-ae3d-4c6e-b90e-c5f0fda8b80d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=222ca7d830e3de052eddbe5d41b30d03", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2875266, "client_id": 0, "vtt_url": "", "t