ess&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1861cc4599b850b169dc0e8a944c6479 3x"}, "body": "はじめまして。個人でVTuberをしております、宣さんと申します \nましゆき様の素敵な納品作品を拝見し、ぜひかいていただきたいと思いリクエストいたしました。\n活動で使用するイラスト描いていただきたいです。\n使用用途はYouTubeのサムネイル、動画、XなどのSNSでの宣伝です \n\n\n宣さんの特徴は、ささやかな胸、丸眼鏡、太眉、一重(二重線がない)、褐色肌です\n\nポーズ、構図はおまかせでお願いします\n\n資料\n\nhttps://drive.google.com/drive/folders/1CBwJSLnIXSxQ9Zjd9gjnUJUqNXZJaR9p \n\n可能であれば、人物のみの透過画像をいただけると嬉しいです。なくても構いません\nよろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/1CBwJSLnIXSxQ9Zjd9gjnUJUqNXZJaR9p", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mashiyuki_821/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3756200, "client_id": 3849347, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb62d1b7/uploads/origins/1194c700-22aa-4106-bb3f-b597c92f8220?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=762e02c9933ce143681d364d7e42b225", "srcset": "https://si.imgix.net/eb62d1b7/uploads/origins/1194c700-22aa-4106-bb3f-b597c92f8220?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=762e02c9933ce143681d364d7e42b225, https://si.imgix.net/eb62d1b7/uploads/origins/1194c700-22aa-4106-bb3f-b597c92f8220?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=014a01028e8003d6ede9b20362c8ec53 2x, https://si.imgix.net/eb62d1b7/uploads/origins/1194c700-22aa-4106-bb3f-b597c92f8220?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e7b024a944351edf62a4afd989323fd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb62d1b7/uploads/origins/1194c700-22aa-4106-bb3f-b597c92f8220?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5041fb034a2612e350ed86187b6145a", "srcset": "https://si.imgix.net/eb62d1b7/uploads/origins/1194c700-22aa-4106-bb3f-b597c92f8220?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5041fb034a2612e350ed86187b6145a, https://si.imgix.net/eb62d1b7/uploads/origins/1194c700-22aa-4106-bb3f-b597c92f8220?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b95643b9b50e81fca187224bd723ee34 2x, https://si.imgix.net/eb62d1b7/uploads/origins/1194c700-22aa-4106-bb3f-b597c92f8220?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=301ce53e33ef70b97ea5d9bce6f83711 3x"}, "body": "ましゆき様、はじめまして。\n個人Vtuber準備中の空乃ろぷと申します。\nとっても素敵なイラスト書く方がコミッションを募集しているのを発見したため、リクエストいたしました！\n\n■イラスト内容\nVtuber「空乃ろぷ」のイラストを描いて頂きたいです。\nウサギと宇宙がモチーフの人間です。\n(三面図がないため不明な部分は自由に解釈していただいて大丈夫です……！）\n\n■希望納品形式\n（可能であれば）キャラクターと背景がレイヤー分けされているpsdデータでいただけると嬉しいです。\n\n■用途\nYouTubeのサムネイルへの使用、Twitterで活動の際に使用させて頂きたいです。\nイラストを使用する際は、先生のTwitterアカウントをYouTubeの概要欄もしくはTwitterのツイート文にクレジットさせて頂きます。\n\n■構図や要望など\n基本おまかせします！\n顔が良く見える構図だと嬉しいです。\n頭の先や髪の毛などは、なるべくでよいので先端まで切れないよう作画頂けますと大変嬉しいです。　\n\nご検討、よろしくお願いします！\n\nhttps://drive.google.com/file/d/1p39w2Tf2I4zH1PSbAO-Vk_otUBRVdA1H/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mashiyuki_821/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3756200, "client_id": 2790549, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88cd5974/uploads/origins/d7730c2c-3838-4390-87aa-e25ba4e182e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b46fbcaf49ba311ba73a3555a12f073", "srcset": "https://si.imgix.net/88cd5974/uploads/origins/d7730c2c-3838-4390-87aa-e25ba4e182e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b46fbcaf49ba311ba73a3555a12f073, https://si.imgix.net/88cd5974/uploads/origins/d7730c2c-3838-4390-87aa-e25ba4e182e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=