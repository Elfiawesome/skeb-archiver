-4878-a9b3-05bb4bb41cf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94e151e18865752d933dd78f3cbc9e5b, https://si.imgix.net/3fa695cd/uploads/origins/244e443d-71f0-4878-a9b3-05bb4bb41cf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=829402aa6187765fdb3dfa4c3013c5f6 2x, https://si.imgix.net/3fa695cd/uploads/origins/244e443d-71f0-4878-a9b3-05bb4bb41cf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8d165d8af83f0fbcc6be7a9dfc4c6e26 3x"}, "body": "こんにちは。\n以前、「薬師設定」と「医者設定」のイラストをお願いした者です。　\nご都合が合いましたら、またお願いしたいと思います。\n\n◎前提　※これまで同様です\n・私のオリジナルキャラクター２名のイラスト化\n・私個人での鑑賞や自分用のグッズ制作のため。販売、配布は一切しません。\n\n◎イラスト\n・これまでお願いした２人のSDイラスト。\n　温湯様の以前描かれた「光とSDキャラ練習」の右上のイラストくらいのデフォルメ具合だと嬉しいです。（勝手に引用すみません）\n・２人で一緒ではなく、２キャラクター分でお願いしたいです。１枚に2人並んでいるのは大丈夫です。\n\n◎キャラクター\n・以前skebにて描いていただいた、「薬師設定」と「医者設定」の二人。\n・基本的には２人とも最初にデザインしていただいた姿でお願いします。SD化にあたり、細部の省略やアレンジ、小物や背景、ポーズ等はお任せします。\n\n◎全体イメージ\n・「同じ種類のランダムのアクリルキーホルダー２つ」のイメージです。「同じテーマ」や「同じモチーフ」だと嬉しいです。\n\n\nこれまで同様、細かい部分はすべてお任せします。曖昧な点は補完していただいて構いません。\n\n\n検討いただけると幸いです。\nよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nukuyuharu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2340369, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17f1f2e0/uploads/origins/76232872-9805-49d1-8495-5156752c930b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e0a02be6d31bcfab18f98d4ea0f3f81", "srcset": "https://si.imgix.net/17f1f2e0/uploads/origins/76232872-9805-49d1-8495-5156752c930b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e0a02be6d31bcfab18f98d4ea0f3f81, https://si.imgix.net/17f1f2e0/uploads/origins/76232872-9805-49d1-8495-5156752c930b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c78c6fa2b29bc212a86c719d82b92833 2x, https://si.imgix.net/17f1f2e0/uploads/origins/76232872-9805-49d1-8495-5156752c930b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=838a5a08607c84935a992097c99fa7b7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17f1f2e0/uploads/origins/76232872-9805-49d1-8495-5156752c930b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=158ba4d1bb4feb7fcf3e98c80285153c", "srcset": "https://si.imgix.net/17f1f2e0/uploads/origins/76232872-9805-49d1-8495-5156752c930b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=158ba4d1bb4feb7fcf3e98c80285153c, https://si.imgix.net/17f1f2e0/uploads/origins/76232872-9805-49d1-8495-5156752c930b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b90f41ad12f042e0b111e25a5fdda5b2 2x, https://si.imgix.net/17f1f2e0/uploads/origins/76232872-9805-49d1-8495-5156752c930b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0abccbc50711489b99162ccac73e0ba1 3x"}, "body": "こんにちは。\n以前、「薬師設定」と「医者設定」のOC（オリジナルキャラクター、うちの子）のイラストをお願いした者です。　\n続けての依頼になってしまうのですが、ご都合が合いましたら、またお願いしたいと思います。\n\n◎前提\n・私のオリジナルキャラクターのイラスト化\n・私個人での鑑賞や自分用のグッズ制作（クリアファイルのワンポイントなど）のため。販売、配布は一切しません。\n\n\n◎イラスト\n・等身イラスト。これまでがデフォルメだったため、細部はお任せします。全身でなくても大丈夫です。\n・日常の一コマの一枚絵。\n　オフの日のリラックスしたとある一瞬、の雰囲気だと嬉しいです。構図はお任せします。\n\n◎キャラクター\n・以前skebにて描いていただいた、「薬師設定」と「医者設定」の二人。\n・髪型等の細部や上着等の着脱はお任せします。アレンジ、変更していただいても構いません。\n\n◎設定（参考までに）\n〇関係等\n・薬師設定…活発で明るくわりと話します。直感で動くことが多いですが勘は鋭いです。時折薬草探しの旅に出ます。\n・医者設定…聞き手に回ることが多いです。人当たりがよく思慮深いです。ツッコミどころは絶対に見逃しません。\n・どちらも世話好き、知識欲高め、職業の近さといった類似点が多いので、仲良しというより話が合う感じです。互いに干渉しませんが、困ったときは自然にフォローしたり、相談したりできます。\n\n〇住居（外出していても構いません）\n・元々あった二世帯住宅（一軒家）を分けて住んでいます。別々に引っ越してきたため、仲良しゆえの同居ではないです。\n・基本的に居住スペースは別々で、用事があるときのみ訪ねています。それぞれ仕事場も兼ねています。薬師設定の方は薬草等の物が多く雑多（不在も多い）、医者設定の方は日当たりが良く物が少ないイメージです。\n・家電やプラスチック製品は存在しない様な気がします。ガラスや金属はあります。「山小屋風」と呼ばれる空間がやや近いかもしれません。\n\n◎その他\n・温湯はる様のイラストの陰影や光の表現が好きなので、その辺りの雰囲気があると嬉しいです。\n\n\n長々と色々書いてしまいましたが、基本的には温湯はる様の判断で大丈夫です。曖昧な点は補完していただいて構いません。\n\n\n検討いただけると幸いです。\nよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nukuyuharu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2340369, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8b5db18/uploads/origins/3e43a1ec-474c-4469-bcac-c141642e211a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82dcc0e262bcc0b50d66490f13333468", "srcset": "https://si.imgix.net/b8b5db18/uploads/origins/3e43a1ec-474c-4469-bcac-c141642e211a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82dcc0e262bcc0b50d66490f13333468, https://si.imgix.net/b8b5db18/uploads/origins/3e43a1ec-474c-4469-bcac-c141642e211a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba35f3a37a0c2a769da9ac4e7320916f 2x, https://si.imgix.net/b8b5db18/uploads/origins/3e43a1ec-474c-4469-bcac-c141642e211a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9fb8f53bfb609d27fee9b87778317911 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8b5db18/uploads/origins/3e43a1ec-474c-4469-bcac-c141642e211a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bf57ab3fde55904b77b342ba3568b7e", "srcset": "https://si.imgix.net/b8b5db18/uploads/origins/3e43a1ec-474c-4469-bcac-c141642e211a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bf57ab3fde55904b77b342ba3568b7e, https://si.imgix.net/b8b5db18/uploads/origins/3e43a1ec-474c-4469-bcac-c141642e211a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5f87b81cb36851d885ee855f46a05b25 2x, https://si.imgix.net/b8b5db18/uploads/origins/3e43a1ec-474c-4469-bcac-c141642e211a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05bed113677e0ff83ac35865a8d463f8 3x"}, "body": "こんにちは。\n前回イラストをお願いした者です。　\n再度リクエストをお願いしたいと思います。\n\n前提\n・私のオリジナルキャラクターのイラスト化\n・私的にアクリルキーホルダーを作りたい（販売、配布なし）\n※どちらも前回同様です。\n\nイラスト\n・ややデフォルメ（ＳＤ以上）\n※前回のキャラクターと対にしたいです…！\n\nキャラクター\n・中性的な少年\n・カウンセラーや町医者のような役割をしています。大病や大怪我がない世界のため、ちょっとした怪我や体調不良を診てくれたり、気持ちについての相談を聞いてくれたりします。\n・優しく思慮深い性格です。親しみやすさや安心感があります。\n・髪色…白。ショートとしては長め（伸びっぱなし）。\n・目の色…おまかせします。\n・服装…「白衣」のようなものは羽織っています。現代ではないので、中華やアジアっぽくアレンジしていただけると嬉しいです。仕事上、手の周り（袖周り）は動きやすく、あとはゆったりしているイメージです。寒色系よりは暖色系っぽい気がします。\n・前回リクエストのキャラクターとルームシェアをしています。互いに干渉しないので近くにいても楽だと思っています。\n・好きなもの（参考までに）…読書、ひだまり、杏仁豆腐\n\nその他\n・前回のキャラクターと、構図は一緒だと嬉しいです。（対にしたいです！）\n・前回のイラストのデザインや雰囲気がとても好きなので、同じような世界観でお願いしたいです。\n\n\n検討いただけると幸いです。\nよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nukuyuharu/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/57655c49/uploads/origins/9a7f542d-099a-4446-a220-cee49431709b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=863e14ed37ae65f0df97acb6d38886d8", "srcset": "https://si.imgix.net/57655c49/uploads/origins/9a7f542d-099a-4446-a220-cee49431709b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=863e14ed37ae65f0df97acb6d38886d8, https://si.imgix.net/57655c49/uploads/origins/9a7f542d-099a-4446-a220-cee49431709b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9822c54fa7844a7ced8bd3ce95daf988 2x, https://si.imgix.net/57655c49/uploads/origins/9a7f542d-099a-4446-a220-cee49431709b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&f