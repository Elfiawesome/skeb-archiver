て使用したいです。\n\nご配慮いただき、本当にありがとうございました！\n\nhttps://drive.google.com/file/d/1oXDgGPL4rSyfkeMbPP4CTtu2ADu9Ow_P/view", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@KanadukiMusic/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": false, "creator_id": 1679653, "client_id": 1774207, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1718084171573370880%2Fs2qCglie.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b720f92997c0342dc38caa47326eeacc", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1718084171573370880%2Fs2qCglie.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b720f92997c0342dc38caa47326eeacc, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1718084171573370880%2Fs2qCglie.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa58884df4ac482cab833ee80e0f745f 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1718084171573370880%2Fs2qCglie.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0dcaa2081d937b56e516767cac7d2247 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/0df6f556-ec25-4c20-81e3-19b69b1c260c?response-content-disposition=inline&Expires=1780677089&Signature=lnh4-PFJBQd7LYVvULg7qeEaRrb022FmFSFMBvQR0N8dENCdJ4LebXCiGP~-riLyK7~ucSO3l1yIXt7jF1SSrWoV-NxJGe5PmP40db-R-oO2779rCBR1Mh-xY35dTNsJzJTj2h6o8nofl54pwZ-n-Y7aWe5qim2yVq9H4ttbzwbdbx4QJX4MMY~2YOrFxPwWebQRB6CrvuWahhQUQL4xSS4BCcBf8GCADv3-F-g5VAZI0stWjcMuRV05~syBfVdGI1yWPkfqDpoCdLoAO61uw-75xx~aMmeWfIkk5miOvEfoNwAmEQ2ZFN2EHwGOupAvXXHPSpuGkavCNtnJK2t3lw__&Key-Pair-Id=K1GS3H53SEO647", "duration": 223, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2F