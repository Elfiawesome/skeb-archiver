ミンが大好きなのだ。\n\nポーズリファレンス」にあるアートと同じようなポーズにしてほしい。\n詳細はあなた次第です。\n\nありがとうございました！\n\nキキ・ピョンピョン 参考：https://imgur.com/a/F61ClQp\nマスコットチャンピー 参考：https://imgur.com/a/q2KA0ZY\nポーズ参考：https://imgur.com/a/qf8iJe0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marmellmin/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3488200, "client_id": 3845292, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78df26f3/uploads/origins/0f010c9e-453a-430a-b805-dd94d0356a79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f7e1cd2c358a420d60aa3f6ceba5ab2", "srcset": "https://si.imgix.net/78df26f3/uploads/origins/0f010c9e-453a-430a-b805-dd94d0356a79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f7e1cd2c358a420d60aa3f6ceba5ab2, https://si.imgix.net/78df26f3/uploads/origins/0f010c9e-453a-430a-b805-dd94d0356a79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ca0ab623b093f0c9424049d7209d322 2x, https://si.imgix.net/78df26f3/uploads/origins/0f010c9e-453a-430a-b805-dd94d0356a79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9c7960fc018d154923667277942fa88 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78df26f3/uploads/origins/0f010c9e-453a-430a-b805-dd94d0356a79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=671930310d1594ca17ba9ed3b27cf519", "srcset": "https://si.imgix.net/78df26f3/uploads/origins/0f010c9e-453a-430a-b805-dd94d0356a79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=671930310d1594ca17ba9ed3b27cf519, https://si.imgix.net/78df26f3/uploads/origins/0f010c9e-453a-430a-b805-dd94d0356a79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9bb47c8807947daa2829cbb6e