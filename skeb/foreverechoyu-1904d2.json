 OC 是一位羊驼女士，她通常温柔、体贴、善良、富有爱心。我希望您能根据歌曲的氛围绘制一幅插图。据我所知，这是一首关于近乎病态的爱情的中文歌曲，名叫《我的完美爱情》，歌曲中的一些歌词是这样的：\"今天你爱我吗？你在哪里？你在做什么？你想我吗？谁在你身旁？\"在这首歌中，作者讲述了那种控制欲很强、没有安全感的爱情。\n你可以随意改变我的 OC 的服装，以尽可能贴合整体构图。其他具体的姿势、表情你们可以自由发挥。\n[song]https://www.youtube.com/watch?v=yd3qLHYqFuc\n尺寸\n16:9\n\n使用方法\n在发行和视频中使用\n用作缩略图或在 bilibili 上使用\n\nhttps://drive.google.com/drive/folders/1xDtobcJ733K9Wik_TGGi4Y-a_adQbQMP?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@foreverechoyu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1541534, "client_id": 1906019, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/361d1452/uploads/origins/cc85a4ff-683d-4629-b32c-ab1035725c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94220649c1a662b3a0eec45f48776c8e", "srcset": "https://si.imgix.net/361d1452/uploads/origins/cc85a4ff-683d-4629-b32c-ab1035725c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94220649c1a662b3a0eec45f48776c8e, https://si.imgix.net/361d1452/uploads/origins/cc85a4ff-683d-4629-b32c-ab1035725c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d424bb488deacae0eefc41bbd485dd47 2x, https://si.imgix.net/361d1452/uploads/origins/cc85a4ff-683d-4629-b32c-ab1035725c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98cea88037ea2e7e05a5e0fdcfe49b16 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/361d1452/uploads/origins/cc85a4ff-683d-4629-b32c-ab1035725c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11284848ad23d33afd9054a15c04a000", "srcset": "https://si.imgix.net/361d1452/uploads/origins/cc85a4ff-683d-4629-b32c-ab1035725c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11284848ad23d33afd9054a15c04