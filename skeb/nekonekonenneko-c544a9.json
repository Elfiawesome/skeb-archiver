10977?s=21 の左側にいるネコ\n- https://twitter.com/yjsnp1/status/1064111543585894400?s=21 のイヌ\n- https://twitter.com/nekonekonenneko/status/837617344440512512?s=21 のイヌ\n\nイラストのフォーマットについて\n- 四角と丸形の2種類でいただくことは可能でしょうか？(または頂いたものをこちらで丸形に加工したパターンでも使用させていただきたいです)\n- e.g. https://bit.ly/315MCRG を https://speakerdeck.com/bells17/the-first-kubernetes?slide=2 のような形で利用するなど\n\nまた、利用用途ですが通常のSNS以外にも以下のような環境でも利用したいと考えています\n- speakerdeckやYouTubeなどにアップロードされる、(場合によっては所属企業名の入った)スライドやセッション動画内での利用\n- 技術同人誌や雑誌での連載、有償のオンライン教材での利用といった商業利用\n- またSNSとしてはTwitter以外にもGithubやspeakerdeckなど、アイコンを設定して利用するWebサービス全般を想定しています\n\nhttps://bit.ly/315MCRG", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nekonekonenneko/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bad49005/requests/128817_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a507518767b110fca0b797f30195e1cd", "srcset": "https://si.imgix.net/bad49005/requests/128817_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a507518767b110fca0b797f30195e1cd, https://si.imgix.net/bad49005/requests/128817_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02d7ff4c1c2ea5e5131e90930ff0d85b 2x, https://si.imgix.net/bad49005/requests/128817_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a026981a987b583e1dcc13413bba6569 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 57736, "nc": 128}, {"path": "/@nekonekonenneko/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art