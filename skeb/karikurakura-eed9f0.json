80f-8002-14c8b6cd9da0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91be5375ca6547555fb5ef8c139f0ffa, https://si.imgix.net/2c216488/uploads/origins/7a7aabae-7801-480f-8002-14c8b6cd9da0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c766a7da5e19331a69a9b954488f9c8b 2x, https://si.imgix.net/2c216488/uploads/origins/7a7aabae-7801-480f-8002-14c8b6cd9da0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8e9265efdceaa7b7257358c999b92c42 3x"}, "body": "私の精神擬人化［八香須 織戸音（はちかすおとね）］\n性格[ちょっとクズ・雑魚・お金好き・パチスロ好き・いい根性をしているちょっとカス]です。\n\n要素\n必須：大きめの胸\n可能であれば：ふともも、八重歯\n\n衣装\n・資料URL内の新衣装2面図\nまたは\nhttps://skeb.jp/@A_My_d100/works/138\nこちらを参考にしてください。カスタマイズはお任せいたします。\n\n構図\nファンボにあるような、ちょいエロ雰囲気な感じのイラストをお願いしてもよろしいでしょうか。\n出来ればチラありだったりな感じ希望です。\nhttps://www.fanbox.cc/@atatata71/posts/10431768\nhttps://www.fanbox.cc/@atatata71/posts/11782780\nこちらのような雰囲気で出来ればと思います。\nしっかりと可愛い感じは残しておいてください。\n\n出来れば壁紙用16:9サイズが所望ですが、難しければ大丈夫です。\n\n下書きやラフを見るのが好きなので残して納品いただけると嬉しいです。\n\n〇用途\n当方で運用するアカウントやSNSで使用させていただく予定です。内輪などのDiscordで使用予定です。\nまた、見え部分は他の方に描いていただいた、見せられないよスタンプで隠してSNS投稿するかもしれません\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/4/folders/1hQcVWpYAhCda6fqcG_-X6X7uts7G22mY", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karikurakura/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3094295, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1162cec3/uploads/origins/09f6b958-7030-41a9-a2ed-4692e6ed0c9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea86c9b2f2f0dfc5a5c67d0efc63abd6", "srcset": "https://si.imgix.net/1162cec3/uploads/origins/09f6b958-7030-41a9-a2ed-4692e6ed0c9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea86c9b2f2f0dfc5a5c67d0efc63abd6, https://si.imgix.net/1162cec3/uploads/origins/09f6b958-7030-41a9-a2ed-4692e6ed0c9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d475061dd147af42cceaa9038fd2c131 2x, https://si.imgix.net/1162cec3/uploads/origins/09f6b958-7030-41a9-a2ed-4692e6ed0c9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de3df000783da428d45b21f1790cd9a3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1162cec3/uploads/origins/09f6b958-7030-41a9-a2ed-4692e6ed0c9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8617ce93b244551f6623f4e1242640bf", "srcset": "https://si.imgix.net/1162cec3/uploads/origins/09f6b958-7030-41a9-a2ed-4692e6ed0c9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8617ce93b244551f6623f4e1242640bf, https://si.imgix.net/1162cec3/uploads/origins/09f6b958-7030-41a9-a2ed-4692e6ed0c9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d946529ef5f5b7a190d52c4f21d2feae 2x, https://si.imgix.net/1162cec3/uploads/origins/09f6b958-7030-41a9-a2ed-4692e6ed0c9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3226bff1f359cbc9a2017c214eaef816 3x"}, "body": "はじめまして仮倉さん。イラスト１枚を頼みたいと思います。\n\n【キャラクター】\n・調月リオ（ブルアカ）\n\n【服装】\n・いつものまま\n\n【シチュエーション】\n・EXアニメーションと同じようにモニターを見ながらヘッドホンをつけて観察中\n\n【構図】\n・EXアニメーションの最初ですがちょっと横になってモニターとリオの視点で正面斜め左上からの角度\n\n【ポーズ】\n・モーションと同じ、タブレットを持ち、集中的に観察中\n\n【その他】\n・吹き出しや思考出しで「これでキヴォトス内の全て見聞きできるようになったわ。ヒマリより合理的な「全知」だけれど。」\n・上の内容差分を英字でも書いてもらえれば幸いです。通訳はこちらで「With this, I can now observe everything that happens within Kivotos. It's more logical than Himari's \"Omniscience\".」\n・ヘッドホンのデザインにはコタマの、またはミレニアム姿の方がいいだと思います。ミレニアム生徒の武器を資料してください。\n\nhttps://imgur.com/a/KQBSC6T", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karikurakura/works/8", "private_thumbnail_image_urls": null, "private": false, "genr