ds/origins/ac6f8d12-48fe-41ec-a1ac-e9992a818cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b9dbe421cb93e41a92a30066d867150, https://si.imgix.net/c535fe95/uploads/origins/ac6f8d12-48fe-41ec-a1ac-e9992a818cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2d0a132cfe6cf2a3be7b3b772d18b999 2x, https://si.imgix.net/c535fe95/uploads/origins/ac6f8d12-48fe-41ec-a1ac-e9992a818cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64a4156130947129989ae8bae6941f2b 3x"}, "body": "こんにちは！リクエストを再送信してしまってすみません。修正すべきミスに気づきました！\n\nあなたの作品が大好きで、またアルダを描いた別のイラストをお願いしたいのですが、今回は友人がデザインを手伝ってくれたオリジナルの衣装を着せたバージョンです。スチームパンクをテーマにしています。\n\nアルダが着ている衣装の背景に描かれているような、歯車やそれに似たものを描いていただけると、イラストの背景デザインがより素敵になると思います。よろしくお願いします！\n\nhttps://x.com/NoctusWindsor/status/1974677812675301862", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Haru_HP25/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1948460, "client_id": 3131173, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95558df6/uploads/origins/cfe30341-e18e-4f94-934c-f03051b50748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=094260027e2a3d9683477a5352b7688e", "srcset": "https://si.imgix.net/95558df6/uploads/origins/cfe30341-e18e-4f94-934c-f03051b50748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=094260027e2a3d9683477a5352b7688e, https://si.imgix.net/95558df6/uploads/origins/cfe30341-e18e-4f94-934c-f03051b50748?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d3f7d127859d077c18732aa662e72ff 2x, https://si.imgix.net/95558df6/uploads/origins/cfe30341-e18e-4f94-934c-f03051b50748?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85afa21b192eebfaf8692f23e52e704c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95558df6/uploads/origins/cfe30341-e18e-4f94-934c-f03051b50748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c9850401ce449b3c73d8e70f995f7dd", "srcset": "https://si.imgix.net/95558df6/uploads/origins/cfe30341-e18e-4f94-934c-f03051b50748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c9850401ce449b3c73d8e70f995f7dd, https://si.imgix.net/95558df6/uploads/origins/cfe30341-e18e-4f94-934c-f03051b50748?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f07daae7fb9875360e5eb84040badb32 2x, https://si.imgix.net/95558df6/uploads/origins/cfe30341-e18e-4f94-934c-f03051b50748?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=88cee3f7c9d4ead865ded03f8b8d3c65 3x"}, "body": "オリジナル漫画の制作をお願いしたいです。\n\n創作作品『コネクト』のキャラクター・作品コンセプト・設定資料を添付しています。\n\n漫画の内容や構成、演出などは自由に解釈していただいて大丈夫です。\n日常・シリアス・ギャグ・関係性重視など、絵師様の描きやすい形で描いていただけたら嬉しいです。\n\nページ数やコマ数も無理のない範囲でお任せいたします。\n\n【キャラクターイメージ】\n\n■リアン\n・金髪 / 黄色の瞳\n・王子のような服装\n・顔に線が入っている\n\n■結\n・茶髪 + 赤いバンダナ\n・水色の瞳\n・赤パーカーを改造したような暗い青系の学生服\n・左利き\n・左側にリアンが繋げた線がある\n\n■ラフィネ\n・紫髪 / ピンクの瞳\n・頭に大きな花を乗せている\n・ふわふわした雰囲気の服装\n\n■ガルデ\n・青髪 / 黄緑の瞳\n・鎧を着たがっしり系\n\n複数キャラクターでの掛け合いや集合シーンなども大歓迎です。\n\n使用用途は基本的に個人鑑賞用ですが、\n漫画制作・VTuber活動（X / YouTube）などで使用させていただく可能性があります。\n常識の範囲内で大切に使用いたします。\n\n細かい部分はすべてお任せしますので、\n絵師様の作風で自由に描いていただけたら嬉しいです！\n\nよろしくお願いいたします。\n\n設定資料集\nhttps://drive.google.com/drive/folders/13TPeyD8COYEhYQGjsQcpggAv90bHag5D\n\nhttps://drive.google.com/drive/folders/13TPeyD8COYEhYQGjsQcpggAv90bHag5D", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Haru_HP25/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1948460, "client_id": 3912616, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29797217/uploads