t=crop&crop=top&w=200&h=200&blur=200&s=be427b41075f9c53ede7f6c247d6ffd0", "src_set": ""}, "body": "はじめまして、からす様の描くイラストが魅力的なのでリクエストさせていただきます。お願いしたいのは『いきいきごんぼ』という作品の『今木麻紀(作中ではイマキマキーと呼ばれています)』というキャラのイラストをお願いしたいと思います。\n\nいきいきごんぼは随分前に週刊少年チャンピオンで連載されていた男子中学生のお下品なギャグ漫画で人を選ぶ内容に反して出てくる女の子が妙に可愛く、その中でイマキマキーちゃんは茶髪でショートカットの目つきがキツめのSっ気が強めの女子でカースト低めの主人公たちをイジってくるタイプのキャラです。\nキャラの参考になればと下記に画像URLも貼らせていただきます。\nttps://livedoor.blogimg.jp/b00ks/imgs/7/8/7869586d.jpg\nttps://livedoor.blogimg.jp/b00ks/imgs/7/8/7869586d.jpg\n\nポーズ、構図などはからす様のセンスにおまかせで構わないのですが\n強いて言うならスタイル良く胸も大きめに描いて頂き、足を組んで座って挑発的にこちらを見下した様な笑顔だと嬉しいです。\n\n以上の内容でもしよろしければお願い致します。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KARASU2023_2/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2713308, "client_id": 2128759, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a51ba713/uploads/origins/37900f9d-7c2e-4482-8457-45990b5944a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f2b0cd5bc41f320da07242c4b710e2a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a51ba713/uploads/origins/37900f9d-7c2e-4482-8457-45990b5944a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b2538ea4b4c72a59cd71b32d1c1c502", "src_set": ""}, "body": "こんにちは！ 逆バニーを着せられたナズーリンを描いていただけませんか？ よろしくお願いします！ お任せします！", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KARASU2023_2/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2713308, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07eca0a6/uploads/origins/5c90c632-9bcd-4fd7-aa89-cecbe0362511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a712a45d9153c7754