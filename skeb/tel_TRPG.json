sored_thumbnail_image_urls": {"src": "https://si.imgix.net/61b4be76/uploads/origins/b1b82f2d-812c-4a27-b56e-3a1affbd0df5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=445b9b1993367cbc53df38500714a721", "srcset": "https://si.imgix.net/61b4be76/uploads/origins/b1b82f2d-812c-4a27-b56e-3a1affbd0df5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=445b9b1993367cbc53df38500714a721, https://si.imgix.net/61b4be76/uploads/origins/b1b82f2d-812c-4a27-b56e-3a1affbd0df5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=084fa685bef8219b435a8d6d7dbeac14 2x, https://si.imgix.net/61b4be76/uploads/origins/b1b82f2d-812c-4a27-b56e-3a1affbd0df5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ff234a7d59e43fdc4d36f7fe82343224 3x"}, "body": "はじめまして。個人Vtuberの騙離きつねと申します。\n素敵なイラストを拝見しリクエストをお送りします。下記確認して頂き、ご検討くださいますと幸いです。もし難しい場合は遠慮なくキャンセルして頂ければと思います。\n\n【使用用途】\n・Vtuber活動への利用（動画や配信、サムネイル、SNS告知用画像など）\n\n【依頼内容】\n・Vtuber「騙離きつね」\nテウメーッソスの狐など様々の怪物や狐の逸話のエッセンスを持つ、人型の狐の怪物Vtuberです。性別は男女両方に化けており、荒廃した劇場に住んでいます。普段はギャルソンのような衣服を着用しております。容姿の分かるリンクを載せますので、そちらの中から筆がノリノリになる姿で描いていただけますと幸いでございます。\n\n・妖しくも美しい\n・ヴィランっぽい\nニュアンスですと嬉しいです\n\nサムネや動画に使用する関係上、透過データもあると助かります。また耳や髪の毛・尾などを見切れないようにして頂けたら助かります。そしてPSDファイルでサインのON/OFFができるようレイヤー分けをお願いできますと幸いです。\n\nご検討よろしくお願いいたします。\n\n人物画：https://katarikitune.fanbox.cc/posts/6388485?utm_campaign=manage_post_page&utm_medium=share&utm_source=twitter\n\n騙離きつね\n・キツネ系の怪物Vtuber\n・イメージカラー青・紫・黒白\n・メインのコンテンツとして「人外コス〇コ」「独断と偏見でVtuberのイメージ香水を語る」を行っています\n・怖い世界が大好きホラゲ強強/人の悲鳴大好きの化け物です\n・女子高の王子様のような声色をしています\n・ヘリウムガスを使い、丹下桜さんのような少女系の声色を出すことが出来ます", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tel_TRPG/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2182869, "client_id": 3143432, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c9f6d620/uploads/origins/2e1f076b-952a-4e77-9c63-e8cad49f2253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc9fb6bb2409aede2f56f5d3d1741854", "srcset": "https://si.imgix.net/c9f6d620/uploads/origins/2e1f076b-952a-4e77-9c63-e8cad49f2253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc9fb6bb2409aede2f56f5d3d1741854, https://si.imgix.net/c9f6d620/uploads/origins/2e1f076b-952a-4e77-9c63-e8cad49f2253?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=973140a442f4684c428d17c3e0bdcee8 2x, https://si.imgix.net/c9f6d620/uploads/origins/2e1f076b-952a-4e77-9c63-e8cad49f2253?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57b8c1f0b6abe487e5f825c2242575fc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c9f6d620/uploads/origins/2e1f076b-952a-4e77-9c63-e8cad49f2253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4f093a3726f9d7d2465c7532bc1e0dd", "srcset": "https://si.imgix.net/c9f6d620/uploads/origins/2e1f076b-952a-4e77-9c63-e8cad49f2253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4f093a3726f9d7d2465c7532bc1e0dd, https://si.imgix.net/c9f6d620/uploads/origins/2e1f076b-952a-4e77-9c63-e8cad49f2253?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=318dee597496e2c29bb416f12f7abe65 2x, https://si.imgix.net/c9f6d620/uploads/origins/2e1f076b-952a-4e77-9c63-e8cad49f2253?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e484ab7e289002c6180c05418158fe78 3x"}, "body": "時芽井 てる様こんばんは！みゅーと申します。\nYouTubeでVTuberとして活動しております。\n\nTwitterでかわいらしいイラストを拝見させていただき、絵柄がとっても好みだったので\nもし良ければ描いていただければと思い連絡させて頂きました。\n\n\n当方、みゅー・あうろーらのイラストを依頼させていただければと思います。\n\n\n衣装や構図、ポーズに関してはお任せします。当方の衣装でもよいですし何かしらのコスプレでも構いません。座っていても寝ていてもどのような角度でもかまいません。ゲームのキャラ風でも何かのボカロ曲モチーフでもOKです。セクシーなものでも問題ありません！\n時芽井 てる様の世界観で表現していただければと思います。\n（前髪は片目隠れでお願いします。）\n\n\n\n人物の透過PNGかPSDを合わせて頂ければ嬉しいです。\n\n\n用途はXでの投稿や収益化したライブ配信や動画、アイコンやヘッダー使用、ネットプリント、グッズ、ファンボックスなどのVTuberとしての活動で使用させていただければと思っております。\n\n立ち絵などの資料は下記URLから確認していただければと思います。\n\n\n\nスケブでの依頼は慣れていないので至らない点があると思いますが、よろしくお願いします。\n\n\n\n\n\n\n\n\n\n\nhttps://lit.link/mewaurora\n\nhttps://lit.link/mewaurora", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 161534, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ツナミノユウ", "screen_name": "tsunaminozazen", "avatar_url": "https://pbs.twimg.com/profile_images/781285030966329344/t0o089u2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/18575496/1571591215/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 49}, {"id": 852565, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぐじゃ太🍼", "screen_name": "NrU6c", "avatar_url": "https://pbs.twimg.com/profile_images/1611751118153093120/vq6gsoGB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/775633948697202688/1680187723/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 176}, {"id": 2537896, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "なり", "screen_name": "nariritrpg", "avatar_url": "https://pbs.twimg.com/profile_images/1871233869435076609/oKSTNt0w.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1257851383891456000/1704778925/1500x500", "appeal_receivable": false, "popular_creator_ra