fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1497bea3ec04820cf0110751dfb76aee", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dcc3cc73/uploads/origins/92322e84-8813-453e-bc8b-6a09282ffccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d97e1e8c766182301fe13388de6c7e40", "src_set": ""}, "body": "はじめまして！\nVTuberの月乃ねむりと申します。\n\n𝑴𝑬𝑼𝑲𝑨@Skeb様イラストを\nお見かけしとても可愛くて、\n素敵な色使いだったので\nぜひ私のイラストを\n描いていただきたくリクエストを\n送らせていただきました。    \n\n\n・使用用途  \n・YouTubeのサムネイル  \n・XやFANBOXでの公開  \n・FANBOXでのカレンダー配布  \n\n\n服装は新衣装を着せていただきたいです。\nベレー帽とカーディガンありバージョンで\nお願いいたします。\n\n  \nポーズはおまかせで、\n表情は\n・通常の表情\n・ジト目の表情\n・ぐるぐる目の表情\n3種類描いていただけたらとても\n嬉しいです。\n\n\nお願いいたします。 \n髪の毛は三つ編みで流し前髪バージョンで\nお願いいたします。\n\nサムネイルに使用を考えているので  \n頭が見切れていないととても助かります。   \n背景を描いてくださる場合は、  \n人物と分けた PSDデータで  \n納品していただけるととても助かります！   \n\nリットリンクに資料がございます。\n\nお忙しいとは思いますがご検討  \nよろしくお願いいたします！   https://lit.link/nemuritsukino", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@meumeuka/works/71", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2758072, "client_id": 1610109, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9235bd02/uploads/origins/25cb69bc-d43d-4f09-b3a1-222ba720b353?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbf5b196be451b8b9626320aae13fb84", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9235bd02/uploads/origins/25cb69bc-d43d-4f09-b3a1-222ba720b353?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98c302aaf0fad500f0579912c0bd3b93", "src_set": ""}, "body": "初めまして、ドラゴン系Vtuberのコルコルと申します！新着で作品を拝見し、可愛らしい絵柄と綺麗な色塗りにぜひ活動用のイラストをお願いしたいと思いました。\n\n【要望】\n人物のみ・背景透過のコルコルのイラストをお願いしたいです。カメラ目線で、色んな素材（サムネ・おはV）に合わせやすいMEUKAさんの思うえへへ〜と笑うドラゴン娘イメージの表情・ポージングだと嬉しいです。\n可能であれば、頭が上で切れていたり、腕のサイド切れていない構図（下に伸ばした手が下に切れているのは大丈夫です！）でお願いします。\nお手数をおかけしますが、キャラクターの資料は私の固定ツイートよりご確認ください！\nhttps://x.com/KoruKoruV/status/1925517300830282015\n\n【使用用途】\nyoutubeサムネやおはＶの他に、是非ともMEUKA様のイラストでグッズ化等もさせていただきたいので、それらの商用利用が可能であればご検討いただけますと幸いです。\n\n細かい指定ができず恐縮ですが、MEUKA様の絵柄を活かした仕上がりで、どうぞよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@meumeuka/works/70", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2758072, "client_id": 1731466, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97645441/uploads/origins/dcb2c8cf-ff9a-4605-8503-b7de58119865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb2987b27b209072cdfff666de735e31", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97645441/uploads/origins/dcb2c8cf-ff9a-4605-8503-b7de58119865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=882704b81c39323b1c88e4a4e3b918de", "src_set": ""}, "body": "こんにちは！あなたのアートスタイルがとても好きです。私のVtuberをあなたの画風で描いてくれませんか？\n表情：怖そうだけどかわいい\nポーズ：お任せします\nキャラクターの参考：https://imgur.com/a/z1D9Waj.目の色は赤です。\nサムネイル動画に使わせていただきます。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@meumeuka/works/69", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2758072, "client_id": 2943863, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f46ec61c/uploads/origins/0e03402f-b9b7-4eac-8b34-c921f678eabf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0613834fcd6c96135d9845da4df5b0c7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f46ec61c/uploads/origins/0e03402f-b9b7-4eac-8b34-c921f6