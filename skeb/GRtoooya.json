origins/fc6bed95-ded6-479a-b8df-cfc259ad4250?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=156416c9cd5b19d5769ec9e437e7e20c", "srcset": "https://si.imgix.net/7b6b3982/uploads/origins/fc6bed95-ded6-479a-b8df-cfc259ad4250?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=156416c9cd5b19d5769ec9e437e7e20c, https://si.imgix.net/7b6b3982/uploads/origins/fc6bed95-ded6-479a-b8df-cfc259ad4250?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61441a9948e3f81a5bc1c8030eaa70ad 2x, https://si.imgix.net/7b6b3982/uploads/origins/fc6bed95-ded6-479a-b8df-cfc259ad4250?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7036513490dfcad4694b06fec07090d6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b6b3982/uploads/origins/fc6bed95-ded6-479a-b8df-cfc259ad4250?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=401d668149ebea15d8edbba985abbef7", "srcset": "https://si.imgix.net/7b6b3982/uploads/origins/fc6bed95-ded6-479a-b8df-cfc259ad4250?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=401d668149ebea15d8edbba985abbef7, https://si.imgix.net/7b6b3982/uploads/origins/fc6bed95-ded6-479a-b8df-cfc259ad4250?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f63aaa4907c6fc11f42ab29324f659b 2x, https://si.imgix.net/7b6b3982/uploads/origins/fc6bed95-ded6-479a-b8df-cfc259ad4250?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=907f110cde66091b3e6ac54f350c1de6 3x"}, "body": "真崎清明様\n\n初めまして、りんこと申します。\n先日、新着クリエイター欄からアクセスさせていただき、X/pixivより作品を拝見させていただきました。\n男女共、魅力的な表情の表現がとても素敵だと思い、もしよろしければ私と友人のOC（TRPGのうちよそ）を是非描いていただきたく、リクエストをお送りさせていただきます。\n是非、ご検討ください。\n\n\n◆関係性\nお互い孤独な人生経験を経てきており、その傷を埋め合うように自然と惹かれ合っていった。\n普段は少し抜けている静香を香月が揶揄うことが多いような仲睦まじい関係。\nまた重要な局面では、静香が香月の精神的支えとなり、香月は肉体的に静香を守るという、お互いに一緒に生きていきたいと強く思い合っている関係。\n出会って半年ほどで交際開始。そこから丸2年後に婚約。晴れて夫婦となった。\n\n◆月都海 丞（つづみ たすく）旧姓：香月（かづき）\n深緑の髪・紅色の目　185㎝ 32歳　細身の筋肉質\n正義感の強い青年。元警察官で現特殊組織の所属。\n元は明るい性格であるが、紆余曲折あり孤独な人生を送っていた。\n静香に出会うまでは人を寄せ付けないような振る舞いだったが、隣を支え歩いてくれる彼女に徐々に心を開いていった。\n好きな人は愛を持って虐めたい。自覚ありのＳ。\n\n◆月都海　静香（つづみ　しずか）\n茶色の髪・薄緑の目　164㎝　29歳　細身\n穏やかな雰囲気の女性。祖父から受け継いだ骨董店を営んでいる。\n不幸な事件で家族を失い天涯孤独でありながら、自分より他人を癒してあげたいと思う献身的な心の持ち主。\n困っている時に丞に助けられたことがきっかけで彼の孤独に触れ、寄り添ううちに惹かれていった。\n着瘦せ体系E～Fカップ。天然Ｍ気味。\n\n◆依頼内容\nNSFW有にて依頼させていただきましたが、有・無含め自由に描いていただいて構いません。\n服なども資料のものでも、そうでなくともOKです。\nTLの男女のイラストがとても素敵だったので、そのような雰囲気だととても嬉しいです。\n\n◆イラストの使用用途\n・私と友人間で鑑賞目的での共有\n・真崎清明様のお名前を明記した上でのSNSへの投稿\n\n\nここまで読んでいただきありがとうございました。\n内容が不適切でしたり詳細や金額の不足がありましたらキャンセルや差戻しお願いいたします。\n\n何卒、宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1_Aij0E7enR9yHJYMPksqXYJt25dTzgwk?usp=sharing", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 13787, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🪼もこきよ🪼", "screen_name": "mokokiyo", "avatar_url": "https://pbs.twimg.com/profile_images/1982271227466027009/-j4MvMMQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/280561743/1761445453/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 176}, {"id": 106278, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "まぐぜる", "screen_name": "magzel", "avatar_url": "https://pbs.twimg.com/profile_images/1845837237407367168/IRkgU-kP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/99922057/1565785871/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expirat