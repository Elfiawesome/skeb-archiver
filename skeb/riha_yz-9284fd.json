意志に反して身体が勝手に動き次々と着ているものを脱いで全裸になります。そして舞台の真ん中で客席に向けてM字開脚オナニーを始めるという内容です。\n構図についてはオナニーを始めている場面をやや俯瞰的に見下ろす形で脱いだ服が周囲に散らばるのがわかるものだと嬉しいです。\n提示する予算で可能であれば、涙を浮かべて嫌々やっている様子から段々と舞台の上で恥ずかしい行いをしていることに興奮してメス顔になる表情差分の加筆もお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@riha_yz/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2583806, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c07c614/uploads/origins/8970517b-63c0-4e89-8bc3-79a2abc922b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f67c235ab75b016b3fc7b283a8cc0bd7", "srcset": "https://si.imgix.net/9c07c614/uploads/origins/8970517b-63c0-4e89-8bc3-79a2abc922b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f67c235ab75b016b3fc7b283a8cc0bd7, https://si.imgix.net/9c07c614/uploads/origins/8970517b-63c0-4e89-8bc3-79a2abc922b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1caafa5f57276f1670d6dd77788d4029 2x, https://si.imgix.net/9c07c614/uploads/origins/8970517b-63c0-4e89-8bc3-79a2abc922b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ac8702ece75215ff33b27a62371ff74 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c07c614/uploads/origins/8970517b-63c0-4e89-8bc3-79a2abc922b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=acf10277d3a738aecba95dfcaf7a2d1a", "srcset": "https://si.imgix.net/9c07c614/uploads/origins/8970517b-63c0-4e89-8bc3-79a2abc922b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=acf10277d3a738aecba95dfcaf7a2d1a, https://si.imgix.net/9c07c614/uploads/origins/8970517b-63c0-4e89-8bc3-79a2abc922b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=50b224d501368d4318460a0daa3a6f7a 2x,