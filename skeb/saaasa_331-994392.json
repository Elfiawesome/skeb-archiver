長も普通〜やや高いくらいのイメージです。\n・服装\nモノトーンに差し色を１色でお任せします\n\n描写範囲も含め、多々お任せします。\n御縁がありましたら幸いです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 275636, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "屋頼/yarai", "screen_name": "k0xyu", "avatar_url": "https://pbs.twimg.com/profile_images/1968529949968711680/UnJopT9v.jpg", "header_url": "https://pbs.twimg.com/profile_banners/909415746387587075/1743886074/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 48}, {"id": 446962, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "旅行", "screen_name": "3San_325", "avatar_url": "https://pbs.twimg.com/profile_images/2006510538487115779/0wJVgHkv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/757870607211999232/1742906504/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}, {"genre": "correction"}], "nc": 33}, {"id": 1394696, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "雲丹園", "screen_name": "uninosono", "avatar_url": "https://pbs.twimg.com/profile_images/1551439992093753345/ViPBYwH3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1414795900732338177/1773982111/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"