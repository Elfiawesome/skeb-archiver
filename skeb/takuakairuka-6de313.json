ください、沈伯安のダンスの動きの幅はそれほど大きくなくて大丈夫です。なぜなら、彼はあまりダンスが得意ではないからです\n*申し訳ありません、私は外国人です、台詞に変なところがあるかもしれませんから、細かいところは自由に変えてください\n\n\n可能であれば、psdファイル内の別のレイヤーにサインをお願いします\n依頼内容に何か難しい点か問題点があれば、お気になさらずこの依頼をキャンセルしてください\nご検討のほど、何卒よろしくお願いします", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takuakairuka/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2663669, "client_id": 1291989, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8d0effd/uploads/origins/486ea6c3-eb6d-4e23-b8d9-43af926c63fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8e208cbd49f07e4c7d47c67eb822f4a", "srcset": "https://si.imgix.net/d8d0effd/uploads/origins/486ea6c3-eb6d-4e23-b8d9-43af926c63fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8e208cbd49f07e4c7d47c67eb822f4a, https://si.imgix.net/d8d0effd/uploads/origins/486ea6c3-eb6d-4e23-b8d9-43af926c63fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db324f2fd20ad34cc9f1f5d3225a69bb 2x, https://si.imgix.net/d8d0effd/uploads/origins/486ea6c3-eb6d-4e23-b8d9-43af926c63fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6808a79471b0916a6b772b3f1d926558 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d8d0effd/uploads/origins/486ea6c3-eb6d-4e23-b8d9-43af926c63fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3956cd1e802c9c3e4bc25715d3cfe28", "srcset": "https://si.imgix.net/d8d0effd/uploads/origins/486ea6c3-eb6d-4e23-b8d9-43af926c63fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3956cd1e802c9c3e4bc25715d3cfe28, https://si.imgix.net/d8d0effd/uploads/origins/486ea6c3-eb6d-4e23-b8d9-43af926c63fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&