ff0be607768a8ec78eed4f7a31, https://si.imgix.net/6a2c8cda/uploads/origins/5be9d6a4-9eb3-4b1a-a3a1-a7183c3e1a99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13e60055674027764036e8aa39960359 2x, https://si.imgix.net/6a2c8cda/uploads/origins/5be9d6a4-9eb3-4b1a-a3a1-a7183c3e1a99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42c7a560ac47f0b5c12fd4b2b6025b7c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a2c8cda/uploads/origins/5be9d6a4-9eb3-4b1a-a3a1-a7183c3e1a99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f55180da20dc29a4ec6486bd0da883d3", "srcset": "https://si.imgix.net/6a2c8cda/uploads/origins/5be9d6a4-9eb3-4b1a-a3a1-a7183c3e1a99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f55180da20dc29a4ec6486bd0da883d3, https://si.imgix.net/6a2c8cda/uploads/origins/5be9d6a4-9eb3-4b1a-a3a1-a7183c3e1a99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4b1104ee691b502c0d312c6a9881f051 2x, https://si.imgix.net/6a2c8cda/uploads/origins/5be9d6a4-9eb3-4b1a-a3a1-a7183c3e1a99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28759fe44f1d300acfaa15799af75b20 3x"}, "body": "前回も描いていただき、ありがとうございました。\n今回も可能であれば、以下の内容をお願い出来ればと。\n\n最初の依頼時と同じクロスオーバーで、\n□男性：【Fate/Grand Order(FGO)】\n⇨藤丸立香。\n□女性：\n【転生したらスライムだった件(転スラ)】\n⇨ミザリー／原初の緑《ヴェール》\n⇨レイン／原初の青《ブルー》\n\n□今回は、前回のデート後の夕飯時の場面。\n・立香とミザリーとレインが、並んで座って食事中。\n※立香の座っている位置は、ミザリーとレインの間。\n・３人は正座している。\n・食事(夕飯)のメニューは和食。白米や焼き魚、漬物や天ぷら等のイメージ。\n※細かなメニューはお任せで。\n・３人の食事は、其々が個別のお膳の上に。\n・３人共に右利き。\n・レインが箸で摘んだ品を隣の立香の口許に、\n「はい、ダーリン。あ～ん❤」\nと笑顔で言いながら添えているポーズ。\n※摘んだ品はお任せで。 \n・立香はレインを見ながら「大丈夫だよ。」\nと、やや苦笑いしながら言っているような表情。\n・ミザリーはレインのその行動に、前を向きながら、半ば呆れるように溜め息。\n\n□藤丸立香の服装は、\n・入浴後に着る浴衣。\n・浴衣の色は、紺色または黒。\n・浴衣の模様や色合いはお任せで。\n\n□ミザリーとレインの服装は、\n・入浴後に着る浴衣。\n・浴衣の色は、桃色。\n・浴衣の模様や色合いはお任せで。\n\n□場所／風景は、純和室。\n・温泉旅館の和室をイメージ。\n※または、【転生したらスライムだった件】の原作内でヒナタやルミナスたちルベリオスの一団がリムルたちと開いた食事会の場のイメージ？\n・床は全て畳。\n・掛け軸や壺が有る。\n・天井の照明の色は、白またはベージュ？\n・襖や障子は取り外されていて、外の庭が完全に見える状態。\n\n以上となります。\n前回と同様に、\n『内容または金額的に難しい場合』には、お手数なのですが、其々で、また再送要請をお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sagiriwing/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3693102, "client_id": 2586431, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e8d9d1e/uploads/origins/fd0f372b-338b-4712-8e97-944d56c57a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9883ce4093179ce8d727de79a60b12d", "srcset": "https://si.imgix.net/5e8d9d1e/uploads/origins/fd0f372b-338b-4712-8e97-944d56c57a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9883ce4093179ce8d727de79a60b12d, https://si.imgix.net/5e8d9d1e/uploads/origins/fd0f372b-338b-4712-8e97-944d56c57a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8adeba8f7fcc4f8b12e12e6fe23bc044 2x, https://si.imgix.net/5e8d9d1e/uploads/origins/fd0f372b-338b-4712-8e97-944d56c57a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42911370b716202ed0277a73cfc4681b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e8d9d1e/uploads/origins/fd0f372b-338b-4712-8e97-944d56c57a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=986b0fed9712af7a876bcfe971a35c6f", "srcset": "https://si.imgix.net/5e8d9d1e/uploads/origins/fd0f372b-338b-4712-8e97-944d56c57a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=986b0fed9712af7a876bcfe971a35c6f, https://si.imgix.net/5e8d9d1e/uploads/origins/fd0f372b-338b-4712-8e97-944d56c57a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3ea1f2bc6f6f5179e74df9b16e20d6ad 2x, https://si.imgix.net/5e8d9d1e/uploads/origins/fd0f372b-338b-4712-8e97-944d56c57a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=571b566e67253e36b59322de845925aa 3x"}, "body": "前回も描いていただき、ありがとうございました。\n今回も可能であれば、以下の内容をお願い出来ればと。\n\n最初の依頼時と同じクロスオーバーで、\n□男性：\n【Fate/Grand Order(FGO)】の、藤丸立香。\n□女性：\n【転生したらスライムだった件(転スラ)】の、\nミザリー／原初の緑《ヴェール》\nレイン／原初の青《ブルー》\n\n\n□今回は漫画(コミック)形式での依頼です。\n\n□最初の依頼時の続きで、『藤丸立香がミザリーとレインの２人と一緒にデート中』という設定。\n□今回は、デート終わりの場面を。\n①\n立香が「２人共ありがとう。楽しかったよ」と告げる。\nミザリーが自分の指先を唇に添えながら礼を求める。\n②\n立香から真剣に、ミザリーへ熱烈で濃密なキス。\n・立香がミザリーの頬と背中に手を。\n・ミザリーは立香の後頭部と背中に両手を回して受け止めている。\n・互いに目を閉じている。\n③\n立香「…俺なりの誠意だよ」\nミザリー「えぇ。ちゃんと受け取ったわ」\n・恥じらう立香に対し、ミザリーも頬を赤らめてはいるが喜んでいる。\n④\nレインは「むぅ…」と若干不貞腐れてる様子。\n「ダーリン、私も〜」と言いながら、立香の腕を握って甘えてくるレインに、立香は「も、もちろん」と返す。\n・『ダーリン』にルビで『立香』と振れたら。難しそうでしたら無くて大丈夫です。\n⑤\n立香は真剣に、レインにも熱烈なキス。\n・レインから「ん…❤」と微かに声が漏れる。\n・立香がレインの後頭部と背中に手を。\n・レインは両手を立香の脇の下から背中に回して受け止めている。\n・互いに目を閉じている。\n・立香が真剣な表情に対し、レインは嬉しそう。\n立香「…満足？」\nレイン「えぇ、とっても❤」\n⑥\nミザリー・レイン\n「ふふっ。次のデートも」\n「楽しみですね❤」\n・この時、ミザリーとレインは嬉しそうにしながら、立香の右手を握る。\n\n□３人の服装は、最初の依頼時と同じ。\n\n□場所／風景は、\n・自宅の敷地内の、噴水の有る庭園。\n・中世西洋(ヨーロッパ)の庭園をイメージ。\n・時刻は、夕方または夜。\n・他の人の描写は無しで。\n※背景に関しましては、上記の内容または簡易(簡素)なデザインなものでも構いませんので。\n\n\n以上となります。\n前回と同様に、\n『内容または金額的に難しい場合』には、お手数なのですが、其々で、また再送要請をお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sagiriwing/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3693102, "client_id": 2586431, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ee4dd86/uploads/origins/848b8ab4-e98d-4219-9435-9e98cfb05a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f6af1d6b50f234b5f9c66557d529868", "srcset": "https://si.imgix.net/3ee4dd86/uploads/origins/848b8ab4-e98d-4219-9435-9e98cfb05a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f6af1d6b50f234b5f9c66557d529868, https://si.imgix.net/3ee4dd86/uploads/origins/848b8ab4-e98d-4219-9435-9e98cfb05a78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43dd42879b5b18564196e6fbed9176d1 2x, https://si.imgix.net/3ee4dd86/uploads/origins/848b8ab4-e98d-4219-9435-9e98cfb05a78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c78f7de829aff8405d512d7646db958 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ee4dd86/uploads/origins/848b8ab4-e98d-4219-9435-9e98cfb05a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20191ad63ad4dccbe37f4493546b5b0d", "srcset": "https://si.imgix.net/3ee4dd86/uploads/origins/848b8ab4-e98d-4219-9435-9e98cfb05a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20191ad63ad4dccbe37f4493546b5b0d, https://si.imgix.net/3ee4dd86/uploads/origins/848b8ab4-e98d-4219-9435-9e98cfb05a78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f39b532ab1d51dae1332fa3784c2658f 2x, https://si.imgix.net/3ee4dd86/uploads/origins/848b8ab4-e98d-4219-9435-9e98cfb05a78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d619d3134abacdd00e43007f7587c571 3x"}, "body": "前回も描いていただき、ありがとうございました。\n今回も可能であれば、以下の内容をお願い出来ればと。\n\n□女性：\n【転生したらスライムだった件(転スラ)／まおりゅう】\nの、レイン／原初の青(ブルー)\n\n\n□今回は、【Rimuru's emotions２】の、\n『レイン版(ver.)』のイラストを。\n\n□レインの身体の描写は、【上記の作品】と同様に胸から上で。\n・身体や顔の向きも【同じ】で。\n・服装は、『前回の依頼で描いていただきました時のと同じスクエアネックのオフショルダー』で。\n\n\n□描いてほしい感情は、\n『喜』『怒』『哀』『楽』『蔑』『照(照れ)』です。\n・『喜』『哀』『楽』『照(照れ)』は、前回の依頼で描いていただきました、〘藤丸立香という男性〙に向けての感情という設定です。\n・『怒』『蔑』は、〘藤丸立香とは別の人間相手〙に向けての感情という設定です。\n\n・『怒』は、「あ゛？」と言ってそうな顔で。\n・『哀』は、【上記の作品】と同様に涙を。\n・『蔑』は、【上記の作品】と同様に、顔に影が掛かっていて、目もハイライトがオフになっているような状態で。\n・『照(照れ)』は、やや俯きながら、\n「そ、そうですか…////」と言ってそうな顔で、嬉しさのあまり、頬から耳までを『カァァァ…////』と紅く染め上げてドキドキしている状態を。\n※【上記の作品】の『恥』ような汗の描写を、幾つか。\n※涙の描写は無しで。\n\n以上となります。\n前回と同様に、\n『内容または金額的に難しい場合』には、お手数なのですが、其々で、また再送要請をお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sagiriwing/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3693102, "client_id": 2586431, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d2ce9595/uploads/origins/f71267cd-69da-4453-b44a-4bf3aa3c5318?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce1201fa00bd697ac59d0498259dbf40", "srcset": "https://si.imgix.net/d2ce9595/uploads/origins/f71267cd-69da-4453-b44a-4bf3aa3c5318?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce1201fa00bd697ac59d0498259dbf40, https://si.imgix.net/d2ce9595/uploads/origins/f71267cd-69da-4453-b44a-4bf3aa3c5318?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7200bf2fbdcf0bfe7628c8f282d6c71 2x, https://si.imgix.net/d2ce9595/uploads/origins/f71267cd-69da-4453-b44a-4bf3aa3c5318?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ccc659a4f945b5d4dc218c0377853d86 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2ce9595/uploads/origins/f71267cd-69da-4453-b44a-4bf3aa3c5318?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32ab7ddc9783c3f08033f5af170dae5e", "srcset": "https://si.imgix.net/d2ce9595/uploads/origins/f71267cd-69da-4453-b44a-4bf3aa3c5318?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32ab7ddc9783c3f08033f5af170dae5e, https://si.imgix.net/d2ce9595/uploads/origins/f71267cd-69da-4453-b44a-4bf3aa3c5318?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b991d32708eaaa0b080caa704a78b779 2x, https://si.imgix.net/d2ce9595/uploads/origins/f71267cd-69da-4453-b44a-4bf3aa3c5318?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ee13d4feb45c9d79b0ab465cb96f07f0 3x"}, "body": "前回は素敵なイラストを描いていただき、ありがとうございました。感無量です。\n今回も可能であれば、以下の内容をお頼み出来ればと。\n\n□女性：\n【転生したらスライムだった件(転スラ)／まおりゅう】\nの、ミザリー／原初の緑(ヴェール)\n\n\n□〘さぎりアスカ２さん〙が以前描かれて、Pixivにも掲載されました、\n【Rimuru's emotions２】\n此方の、『ミザリー版(ver.)』のイラストを。\n\n□ミザリーの身体の描写は、【上記の作品】と同様に胸から上で。\n・身体や顔の向きも【同じ】で。\n・服装は、『前回の依頼で描いていただきました時のと同じノースリーブのブラウス』で。\n・以下で希望する一部の感情で、手の描写も。\n\n□描いてほしい感情は、\n『喜』『怒』『哀』『楽』『蔑』『照(照れ)』です。\n・『喜』『哀』『楽』『照(照れ)』は、前回の依頼で描いていただきました、〘藤丸立香という男性〙に向けての感情という設定です。\n・『怒』『蔑』は、〘藤丸立香とは別の人間相手〙に向けての感情という設定です。\n\n・『喜』は、微笑んでいる表情で。\n※前回の依頼で描いていただきましたミザリーの表情でも、大丈夫ですので。\n・『哀』は、【上記の作品】と同様に涙を流している状態を。\n・『楽』は、口許に軽く握ったようなイメージの形の手を添えながら「ふふふっ」または「はははっ」と小さく笑っている状態を。\n※頬は【上記の作品】と同様に少し赤い程度の描写で。\n※手の形の伝え方が下手で、ごめんなさい。別の形でも大丈夫ですので。\n・『照(照れ)』は、目線を逸らしながら、頬から耳までを紅く染め上げてドキドキしている状態を。\n※【上記の作品】の『恥』ような汗の描写を、幾つか。\n※『口許に手を添えた描写』の有無はお任せします。\n\n以上となります。\n前回と同様に、\n『内容または金額的に難しい場合』には、お手数なのですが、其々で、また再送要請をお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sagiriwing/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3693102, "client_id": 2586431, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6dddcfd4/uploads/origins/d7247787-74d8-462d-bb8d-5e3dc114d8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=694aaa74e070269bf4fae767a16e2d16", "srcset": "https://si.imgix.net/6dddcfd4/uploads/origins/d7247787-74d8-462d-bb8d-5e3dc114d8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=694aaa74e070269bf4fae767a16e2d16, https://si.imgix.net/6dddcfd4/uploads/origins/d7247787-74d8-462d-bb8d-5e3dc114d8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=54f481a31fe093945f49de3ebbffe578 2x, https://si.imgix.net/6dddcfd4/uploads/origins/d7247787-74d8-462d-bb8d-5e3dc114d8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b99b42e5064f90a0f29f5d0c9812b13 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6dddcfd4/uploads/origins/d7247787-74d8-462d-bb8d-5e3dc114d8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5dc0910fe753ee81dc728079dac0b335", "srcset": "https://si.imgix.net/6dddcfd4/uploads/origins/d7247787-74d8-462d-bb8d-5e3dc114d8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5dc0910fe753ee81dc728079dac0b335, https://si.imgix.net/6dddcfd4/uploads/origins/d7247787-74d8-462d-bb8d-5e3dc114d8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e98c42ba719235211b912044da588748 2x, https://si.imgix.net/6dddcfd4/uploads/origins/d7247787-74d8-462d-bb8d-5e3dc114d8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=15c864353d46207b9259268b0fd6d6a4 3x"}, "body": "初めまして。\n可能であれば、以下の内容をお頼み出来ればと。\n\nクロスオーバーとなるのですが、\n□男性は、\n【Fate/Grand Order(FGO)】の、藤丸立香。\n□女性は、\n【転生したらスライムだった件(転スラ)】の、\nミザリー／原初の緑\n＆\nレイン／原初の青\nの２人。\n\n□藤丸立香がミザリーとレインの２人と一緒にデート中。\n・ミザリーとレインの立ち位置は、立香の横に其々。\n・ミザリーは、指を絡めて手を繋ぐ恋人繋ぎ。もう片方の手も腕を握っている。\n・レインは、腕に胸をしっかりと押し当てて抱きついている。\n・３人共に微笑んでいる。\n・立香はミザリーの顔に向いていて、ミザリーも立香に向いている。レインは話しかけている。\n\n□藤丸立香の服装は、\n・上はボタンダウンシャツ。色は紺色。\n・シャツは第１ボタンまで外している。\n・シャツの裾は出している。\n・下はデニムスラックス。色は黒。\n□ミザリーの服装は、\n・上はノースリーブのブラウス。色は白。\n・ボタンの色は黒。\n・ブラウスは第２ボタンまで外している。\n・首に細いチェーンのネックレス。\n・下はスラックス、またはスキニーパ◯ツ。色は黒。\n・足に履いてるのはグルカサンダルで、色は茶色。\n□レインの服装は、\n・上はスクエアネックのオフショルダー。色は橙または赤。\n・オフショルダーへのフリルの有無はお任せで。\n・オフショルダーの丈はお臍が見えるまで。\n・首には小さなネックレス。\n・下はテーパードパ◯ツ。色は白。\n\n□デート場所／風景は、\n・中世西洋(ヨーロッパ)の街並みの中。\n⇨異世界漫画に出てくるような街並みでも可\n・日中なので、青空を。\n・他の人の描写は無しで。\n※背景に関しましては、上記の内容または簡易(簡素)なデザインなものでも構いませんので。\n\n□描写の角度にもよりますが、藤丸立香の右手の甲には『令呪』を。\n\n\n以上となります。\n重ねてですが、『異なる原作のキャラクターの組み合わせ、クロスオーバー』である事と、描いてほしい人数が『３人』です。\n\n↓↓↓\nですので、\n☆『クロスオーバー、または知らない原作のキャラクターが難しい場合』には『内容変更の再送要請』を。\n☆クロスオーバーが大丈夫な場合でも、『人数によって価格が違う場合』には『価格変更の再送要請』を。\n\nお手数をお掛けしますが、其々お願いできればと思います。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sagiriwing/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3693102, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0796b966/uploads/origins/0fcc944f-6426-4da8-8d24-f11d062b38a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4623b6d8fc1988ff0258714812966d49", "srcset": "https://si.imgix.net/0796b966/uploads/origins/0fcc944f-6426-4da8-8d24-f11d062b38a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4623b6d8fc1988ff0258714812966d49, https://si.imgix.net/0796b966/uploads/origins/0fcc944f-6426-4da8-8d24-f11d062b38a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03bc32080e3795c222621ec0a20cc6c7 2x, https://si.imgix.net/0796b966/uploads/origins/0fcc944f-6426-4da8-8d24-f11d062b38a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e3154511b941705b5b6d20f1d98a664 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0796b966/uploads/origins/0fcc944f-6426-4da8-8d24-f11d062b38a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc1ee844cb8f47e80bb9bb2fc444f1af", "srcset": "https://si.imgix.net/0796b966/uploads/origins/0fcc944f-6426-4da8-8d24-f11d062b38a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc1ee844cb8f47e80bb9bb2fc444f1af, https://si.imgix.net/0796b966/uploads/origins/0fcc944f-6426-4da8-8d24-f11d062b38a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b1934da7564bd33deca3bdcdd509aaa8 2x, https://si.imgix.net/0796b966/uploads/origins/0fcc944f-6426-4da8-8d24-f11d062b38a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69713a283d61