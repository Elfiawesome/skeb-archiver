core": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4096034/uploads/origins/e034b9df-e035-45c3-a352-ba7043f70b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2e2d0ade3f8383b116d4f6b256be7e8", "srcset": "https://si.imgix.net/b4096034/uploads/origins/e034b9df-e035-45c3-a352-ba7043f70b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2e2d0ade3f8383b116d4f6b256be7e8, https://si.imgix.net/b4096034/uploads/origins/e034b9df-e035-45c3-a352-ba7043f70b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b0d78b2aae6187e1916f4d13d786e38 2x, https://si.imgix.net/b4096034/uploads/origins/e034b9df-e035-45c3-a352-ba7043f70b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e1fa2e86e30ea635c986ab31601a7cd2 3x"}, "body": "こんにちは。あなたの絵がとても好きなので、私のキャラクター「コーデリア」を描いてほしいです〜。\n参考：https://sta.sh/024h1j6x1jym\n\n彼女は甘やかされて育った傲慢なツンデレ姫です。お化粧とショッピング、そして歌が大好き。\n背が低く(147cm)、胸も小さい。\n\n以下は、私のアイデアです。\n1.ショッピングバッグを持って街を歩くCordelia。\n2.パソコンのデスクで歌を録音するコーデリア、デスクにはスタンドマイクが置いてある。\n\n他にもアイデアがあれば、彼女の個性に合っていれば自由にどうぞ！ありがとうございました。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@raumcar/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 310151, "client_id": 2052957, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/372da9d2/uploads/origins/399d99ef-602b-4d5e-85e9-abd50f79f20f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96e9397162953c51091e0c118b5b5051", "srcset": "https://si.imgix.net/372da9d2/uploads/origins/399d99ef-602b-4d5e-85e9-abd50f79f20f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96e9397162953c51091e0c118b5b5051, https://si.imgix.net/372da9d2/uploads/origins/399d99ef-602b-4d5e-85e9-abd50f79f20f?bg=%23fff&auto=format%2Ccompress&fm=webp&dp