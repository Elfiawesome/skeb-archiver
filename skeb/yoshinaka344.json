せんので、承諾ご一考頂けると幸いです。\n\n一次創作の親子キャラクター2人を描いて頂きたいです。\n様々な星を巡って地球外生命体を研究する宇宙船員達の創作世界観です(特に必須シチュエーションではありません、キャラクターへのご参考までに)。\n高めの等身で、男女差＆年齢(大人と子供)差が分かりやすいイラストですと嬉しいです。\n構図はお任せいたします。\n\n拙いイラストで大変恐縮ですが、こちらに資料がございます。\nデザインとして分かりにくいところ、破綻しているところ多々ございますので、描きやすいよう頂いて構いません。\n\nhttps://drive.google.com/drive/folders/1qTwP64Sv9zDtVFJFuX7r1HJOkI5-L80B\n\nhttps://drive.google.com/drive/folders/1pbN2lbTDk4J2AmSZjw6b9adgtD4jNSNR\n\n目を通してくださりありがとうございます。\nどうぞよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoshinaka344/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0272538f/uploads/origins/17965a45-b577-468e-9310-8ec178bafe5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=808e6d8dd9b886f2adfe33dc3f8fad41", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1269740, "client_id": 206892, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yoshinaka344/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1269740, "client_id": 206892, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a4e6ee3/uploads/origins/6b2f42da-1fcc-46d5-b3a2-c9acdeea8033?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13d753edc45195540f5863126d4380ea", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a4e6ee3/uploads/origins/6b2f42da-1fcc-46d5-b3a2-c9acdeea8033?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d23ce38c66264129a39af8c839d656fd", "src_set": ""}, "body": "こんにちは！\n\nまた新しいヤンキーロボットの作品をお願いします！金髪のヤンキーロボットと口論になった後のシーンをお願いします。彼女は密かに、それがとてもエキサイティングで魅力的だと感じているので、トップレスになって、ベッドで彼女の機械の一部を見せながら、前の言い争いのことを考えたり、もしかしたら自分自身を弄んだりするかもしれません。\n\nありがとうございました！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoshinaka344/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1269740, "client_id": 206892, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b53ac0b6/uploads/origins/67acd168-6870-4c46-9d53-e9f90693845e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5561a1c107a38a11c4f0248176a34cf", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b53ac0b6/uploads/origins/67acd168-6870-4c46-9d53-e9f90693845e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed125bcf193fc508f2265e18f43702ac", "src_set": ""}, "body": "こんにちは！\n\n新しいロボットレディを主人公にした別の作品を依頼したいのですが、お願いします。前回依頼したヤンキーロボットおばさんと同じ場所に住んでいる、背の高いヤンキーロボットおばさんの絵が見たいです。\n\n胸はヤンキーより大きいけど、運動神経はいいタイプにしてほしい。前髪はストレートのロングポニーテール。胸があるので放熱しにくいのだが、この気候の中、オーバーヒートしないようにしてほしい。\n\nインスピレーション：\nhttps://x.com/raita_z/status/1279671098494210049\nhttps://x.com/WolffeldPrice/status/1768989026684678161\n\nありがとうございました！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoshinaka344/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1269740, "client_id": 206892, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3aec364e/uploads/origins/d1505dcd-89b8-47c7-bc80-67f16fd78a68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7892a3b9443d08aafd1132c19f2b6ad1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3aec364e/upl