=200&s=4280ffc0f118ad876fa8e679ba20e45e 2x, https://si.imgix.net/83e3c33c/uploads/origins/19208a1f-7a5f-4da5-b832-45c2c6e96c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1338d99b2c320dec88ed12e57a4e00f9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83e3c33c/uploads/origins/19208a1f-7a5f-4da5-b832-45c2c6e96c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02f42638a4cfafc588e6c00baee8e960", "srcset": "https://si.imgix.net/83e3c33c/uploads/origins/19208a1f-7a5f-4da5-b832-45c2c6e96c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02f42638a4cfafc588e6c00baee8e960, https://si.imgix.net/83e3c33c/uploads/origins/19208a1f-7a5f-4da5-b832-45c2c6e96c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=06fc77718d5153b8bf5bdc300fec791f 2x, https://si.imgix.net/83e3c33c/uploads/origins/19208a1f-7a5f-4da5-b832-45c2c6e96c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=55a46ae74d33051de87b3f2d703734a5 3x"}, "body": "こんにちは、クリエイターさん。私はあなたの作品がとても好きなので、2人のイラストをお願いしたいと思っています。\n\nもし可能であれば、この作品の作風を参考にしていただきたいです。https://x.com/_Mulog/status/1984583691872751965/photo/1\n\n二人の制服姿を見てみたいのですが、リンク内のお揃いの服装を参考にさせていただき、密着したやりとりでも、別々の動きでも構いません！二人の関係は、親密な友情でもいいし、どこか曖昧であいまいなものでもいいと思います。\n\n具体的なキャラクターの参考は、リンク内の該当フォルダで確認できます。\n\nY.\n男性、プラチナブロンドの髪、スカイブルーの目、右目の脇にほくろ。\n177cm、痩せ型だが少し筋肉質。\n陽気で明るく、ちょっとクールなおてんば娘。感情表現が少し鈍く、笑ったり冗談を言ったりするのが大好き。\n\nW.\n男性、グレーのハイライトの入った黒髪（重要な特徴！）。右目の下に小さな傷がある。黒いイヤリングをしている。\n192cm、Yより少し強く、頭半分ほど背が高い。\nストイックで冷静だが、ユーモアのセンスがあり、やや真面目な外見とは対照的に内面的な感情も豊か。\n\n日本人ではないので、翻訳者が変なことや失礼なことを言ったら許してください！\nいつかあなたの作品を拝見できたら嬉しいです！ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1PXgha5SfJvbzKGOkgY0KTK5umK1DW0sg?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mulog/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2124137, "client_id": 2462364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aceac361/uploads/origins/0cbd7213-00ce-4286-9ed2-47dcc5687a87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e3036a3c4187e3f2f5136ad8a79a2d3", "srcset": "https://si.imgix.net/aceac361/uploads/origins/0cbd7213-00ce-4286-9ed2-47dcc5687a87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e3036a3c4187e3f2f5136ad8a79a2d3, https://si.imgix.net/aceac361/uploads/origins/0cbd7213-00ce-4286-9ed2-47dcc5687a87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8888c6fb86cc5314aa41aab14fa1dd82 2x, https://si.imgix.net/aceac361/uploads/origins/0cbd7213-00ce-4286-9ed2-47dcc5687a87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4c8e3935a9702d417678837f6384458 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aceac361/uploads/origins/0cbd7213-00ce-4286-9ed2-47dcc5687a87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=067cee5d3e91a82e3d8ff2c2f38fea60", "srcset": "https://si.imgix.net/aceac361/uploads/origins/0cbd7213-00ce-4286-9ed2-47dcc5687a87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=067cee5d3e91a82e3d8ff2c2f38fea60, https://si.imgix.net/aceac361/uploads/origins/0cbd7213-00ce-4286-9ed2-47dcc5687a87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=50b07a9d6ce63037a687466ff701e3a7 2x, https://si.imgix.net/aceac361/uploads/origins/0cbd7213-00ce-4286-9ed2-47dcc5687a87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a8d24ab792db04a719a284a712b226e 3x"}, "body": "こんにちは！お忙しいところ大変申し訳ありません！今回の依頼ですが、可能であれば私のocたちのインタラクティブなイラストを描いていただきたいです↓以下、彼らの性格や要望を簡単に説明します。\n\nどちらも20世紀が舞台です\n(下）コンスタンティン：24歳、金髪、赤い瞳孔、182cm、長身痩躯、エレガントな風貌。コンスタンチーヌは貴族で、家はとても裕福、両親と兄は彼をとても愛している。貴族気質でプライドが高く、自尊心が高いが、非常に頭が良く優秀で、人に優しく接するが、人を遠ざけることもある。大学を早々に卒業し、文学の道に進んだ彼は、文筆業でもジャーナリズムでも中心的な存在であり、その頭の良さから警察から事件の捜査協力を依頼されることもある。ヴィラカスに憧れ、その憧れは後に秘密を共有したことで好意を抱くようになる。\n\n(上）ヴィラカス：21歳、186cm、茶色の少しカールした髪、緑の目、標準的な体格、穏やかで礼儀正しい。ヴィラカスは裕福な家庭の平民で、コンスタンティンの助手である。コンスタンティンに憧れ、相手の通信社に応募に来たところ、アシスタントに抜擢された。コンスタンチンの日常生活や生活の世話をし、非常に従順で、忠犬のような性格に見え、コンスタンチンをとても頼りにしている。\n\nどのようなコスチュームで描くかは自由です！(西洋ファンタジーの設定が好きなら、写真28のコスチュームを選ぶことができる）！もちろん他のコスチュームもあります！)\n\n金額に満たない場合は、再度リクエストを送っていただけると助かります！ご面倒であれば、キャンセルしていただいても構いません。この度はご依頼をお受けいただき、誠にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1mP_-_aYjvuPUdyoPB12Sek3bUxpMOry1?usp=share_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mulog/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2124137, "client_id": 2963416, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/071662cb/uploads/origins/001db9cb-5fa6-4fcd-96b7-03e9cd68ac4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5257e30ac0b039c775d248e2714bf0d8", "srcset": "https://si.imgix.net/071662cb/uploads/origins/001db9cb-5fa6-4fcd-96b7-03e9cd68ac4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5257e30ac0b039c775d248e2714bf0d8, https://si.imgix.net/071662cb/uploads/origins/001db9cb-5fa6-4fcd-96b7-03e9cd68ac4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14978514934f70fb14d2d3178843ca14 2x, https://si.imgix.net/071662cb/uploads/origins/001db9cb-5fa6-4fcd-96b7-03e9cd68ac4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=833f90990f6b4c1eadcda41eca353cbd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/071662cb/uploads/origins/001db9cb-5fa6-4fcd-96b7-03e9cd68ac4b?b