00&h=200&s=d3ccb31e093cbc1ba4885650c300e21d, https://si.imgix.net/6e469278/uploads/origins/1052218e-32c8-4e94-972a-a7e14c506d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dae619b28cfaacfbc507536009d01ec0 2x, https://si.imgix.net/6e469278/uploads/origins/1052218e-32c8-4e94-972a-a7e14c506d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b696d91e10799464f6098773ee2a472c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e469278/uploads/origins/1052218e-32c8-4e94-972a-a7e14c506d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75af7f160a3a78472a0a3a5ef65adcf9", "srcset": "https://si.imgix.net/6e469278/uploads/origins/1052218e-32c8-4e94-972a-a7e14c506d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75af7f160a3a78472a0a3a5ef65adcf9, https://si.imgix.net/6e469278/uploads/origins/1052218e-32c8-4e94-972a-a7e14c506d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7c52b6c4a7d16ec6e2d79a15587b7543 2x, https://si.imgix.net/6e469278/uploads/origins/1052218e-32c8-4e94-972a-a7e14c506d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0538c772387ec7106067aa22705f9855 3x"}, "body": "しろむさん初めまして\n私は寝すぎた黒猫といいます\n\n私の推しである Vtuberの朝比奈美夜(@asahinamiya)さんと 柚子森律歌(@yuzumorikka)のイラストを是非描いていただけないでしょうか？\n※有償依頼における二次創作の許可はOKをもらっています\n【依頼内容】\n朝比奈美夜さんと柚子森律歌さんのハロウィンイラストを描いていただきたいです\n内容のイメージはチャイムが鳴り玄関を開けたら2人がトリックorトリート！！と言っているような風景のイメージになります\n細かいところは朝比奈美夜さんを白布を被ったお化けのコスプレ（参考資料のようにフードはズレていて髪の毛と顔が見える状態）、柚子森律歌さんを魔女のコスプレ（魔女帽子と魔女服）\n2人は仲良しなので2人でお菓子の入っている籠、持っているもしくは手を握っている状態（その場合は空いている手でお菓子の籠をお願いします）でお願いします\nコスプレの衣装はできればそれぞれのVtuberの衣装の特徴が出るようにしていただけると幸いです\n髪型はお任せします　\n【仕様用途】\n朝比奈美夜さんと柚子森律歌さんへのイラストのプレゼント\n私と朝比奈美夜さんと柚子森律歌さんのSNSへの投稿\n朝比奈美夜さんと柚子森律歌さんの配信活動における使用とFANBOXにおいての画像加工、再配布を許可していただきたいです\n【納品形式】\nPCの壁紙サイズでお願いします\nサインと背景と人物と小物を分けれるようにPSDファイルにて納品をお願いします\n\nもしよろしければご検討頂けましたら幸いです。\n『参考資料』\n朝比奈美夜Twitter：https://twitter.com/asahinamiya\n\n朝比奈美夜衣装：https://twitter.com/asahinamiya/status/1605870225437577217?s=20\n\n柚子森律歌Twitter：https://twitter.com/yuzumorikka\n\n柚子森律歌衣装：https://twitter.com/yuzumorikka/status/1520251763143901185?s=20\n\nhttps://sozai-good.com/uploads/84229/84229_sample.png,https://i.pinimg.com/originals/6e/71/4f/6e714f03e7d6ba3bba60c6aaced670ef.png", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mof_siromimi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 480656, "client_id": 2713364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54071403/uploads/origins/b74228da-ae60-4242-aad2-c058895adf09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=987a3bf2375d2f7f42f8c449019e70ce", "srcset": "https://si.imgix.net/54071403/uploads/origins/b74228da-ae60-4242-aad2-c058895adf09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=987a3bf2375d2f7f42f8c449019e70ce, https://si.imgix.net/54071403/uploads/origins/b74228da-ae60-4242-aad2-c058895adf09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8544805be16fb720add3aaf16180302d 2x, https://si.imgix.net/54071403/uploads/origins/b74228da-ae60-4242-aad2-c058895adf09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3393db26c0c2c4f1a55d31f7a503cea8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54071403/uploads/origins/b74228da-ae60-4242-aad2-c058895adf09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e72c067ceff701d1b9bb4d7be5823df", "srcset": "https://si.imgix.net/54071403/uploads/origins/b74228da-ae60-4242-aad2-c058895adf09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e72c067ceff701d1b9bb4d7be5823df, https://si.imgix.net/54071403/uploads/origins/b74228da-ae60-4242-aad2-c058895adf09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b0c1c3a9d0563204a4b4cb00791a5d79 2x, https://si.imgix.net/54071403/uploads/origins/b74228da-ae60-4242-aad2-c058895adf09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2fa6ea7ae2e33c813018dd7e9facdd67 3x"}, "body": "はじめまして。しろむさまのイラストをお見かけしとても素敵だと感じたので、リクエストのほう失礼します。\n私の推しである碓氷ゆらというVtuberを描いていただけないでしょうか?\n\n・人物像\n現XのURLを失礼します。\n「https://twitter.com/yurayura_usui」\n食べることが大好きな方です!\n\n・服装\nワンピースやふわふわした可愛い服でお願いします。\n\n・構想\nお祝いのパフェやケーキなど甘味をご馳走してるシチュエーションでお願いします。\n（2,3個あると嬉しいです。）\n\n・背景\nおまかせでお願いします。\n\n・使用用途\n個人ではPCの背景、Xのヘッダーなど観賞用\n活動者様の各種SNS、Youtubeサムネイル等での使用\n\n・納品形式\nPSDファイルでお願いします。\n背景を描いていただけるのであれば、差分もお願いいたします。\n\n企業所属のためガイドラインのほうをこちらに失礼します。\n「https://www.project-nebula.com/guideline」\n\nこの度は登録者1万人のお祝いイラストをお願いしたくリクエストしました。\n不躾なお願いで恐縮ですが、可能な範囲で早めの着手をいただけますと幸いです。\n\nお忙しいところ、何卒ご検討のほどよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mof_siromimi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 480656, "client_id": 926293, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f124e77/uploads/origins/461b7815-aaea-49db-bbfb-d1fbdb2b9c8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a5730b5ed43d44fd756fbc4a1ab4961", "srcset": "https://si.imgix.net/8f124e77/uploads/origins/461b7815-aaea-49db-bbfb-d1fbdb2b9c8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a5730b5ed43d44fd756fbc4a1ab4961, https://si.imgix.net/8f124e77/uploads/origins/461b7815-aaea-49db-bbfb-d1fbdb2b9c8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d66a20e6fca97eeb321a404bf359ea1 2x, https://si.imgix.net/8f124e77/u