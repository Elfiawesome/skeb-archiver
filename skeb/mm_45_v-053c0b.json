200&h=200&blur=200&s=d75d0f7ec0d48cf23901e8021425f2df 3x"}, "body": "はじめまして、匿名でリクエスト失礼します\n東方の風見幽香のイラストをお願いします\n衣装なんですけど、東方ロストワードの転生衣装「四季折々のホワイトフラワー」でお願いします。\n参考資料も送ります。\nhttps://img.altema.jp/lostword/shoujotensei/icon/101.jpg\n構図などは全てお任せします\nどうかご検討よろしくお願いします", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mm_45_v/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 410998, "client_id": 3241676, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0d20bba/uploads/origins/58110de1-7160-4fe8-9f33-952928a4d7b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb25eeee81f140774ab44f1cfc320145", "srcset": "https://si.imgix.net/c0d20bba/uploads/origins/58110de1-7160-4fe8-9f33-952928a4d7b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb25eeee81f140774ab44f1cfc320145, https://si.imgix.net/c0d20bba/uploads/origins/58110de1-7160-4fe8-9f33-952928a4d7b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a59c27cea6641eaa94d60faa7262c7df 2x, https://si.imgix.net/c0d20bba/uploads/origins/58110de1-7160-4fe8-9f33-952928a4d7b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c91efe2f8c5882cb90cebd4236119326 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c0d20bba/uploads/origins/58110de1-7160-4fe8-9f33-952928a4d7b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43439fff75ad5364e1c72287d2746682", "srcset": "https://si.imgix.net/c0d20bba/uploads/origins/58110de1-7160-4fe8-9f33-952928a4d7b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43439fff75ad5364e1c72287d2746682, https://si.imgix.net/c0d20bba/uploads/origins/58110de1-7160-4fe8-9f33-952928a4d7b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ca3db51ee5ae67e1244148ecd9f7a220 2x, https://si.imgix.net/c0d20bba/uploads/origins/58110de1-7160-4fe8-9f33-952928a4d7b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4c9ff779814da300fe4214bd1aa04687 3x"}, "body": "柏原まな先生、こんにちは。\n偶然でＸから先生の作品を拝見しました。先生が描いた藍のイラストはとても素晴らしいと思います。\n突然ですが、先生に絵をリクエストしたいです。依頼したいのは東方Projectの西行寺幽々子です。\n構図と背景は先生にお任せします。良かったら、幽々子の優雅と色気がイラストに表現したいです。可能であれば、キャラの半身や半身以下を含めていただけると嬉しいです。\n以上はリクエストしたい内容です。もし受けたら、先生の作品を期待しています！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mm_45_v/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 410998, "client_id": 656463, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1c8da9b/uploads/origins/625a2286-1162-466a-bac3-bf6c5ae7a6f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c9d7c46ef3bdd111d7e84d8741505d6", "srcset": "https://si.imgix.net/d1c8da9b/uploads/origins/625a2286-1162-466a-bac3-bf6c5ae7a6f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c9d7c46ef3bdd111d7e84d8741505d6, https://si.imgix.net/d1c8da9b/uploads/origins/625a2286-1162-466a-bac3-bf6c5ae7a6f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26cf49aa4865638a0a1f289fd0ece267 2x, https://si.imgix.net/d1c8da9b/uploads/origins/625a2286-1162-466a-bac3-bf6c5ae7a6f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcdd0e49e9f95edbc5a24cf9808848a3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1c8da9b/uploads/origins/625a2286-1162-466a-bac3-bf6c5ae7a6f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab3b0da1c9efd03986493db6c628d8da", "srcset": "https://si.imgix.net/d1c8da9b/uploads/origins/625a2286-1162-466a-bac3-bf6c5a