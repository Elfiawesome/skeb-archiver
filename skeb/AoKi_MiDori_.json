-d5fce2874b50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b1a8f2550067bc25fce1c4e68ea1725", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f85c7afc/uploads/origins/f4c575a6-5d7d-4b1e-8fb5-d5fce2874b50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c1a522e7277dee8a06afb5e87d004c2", "src_set": ""}, "body": "ねえ、僕の蜂のモンスターガールOCラマリを描いてくれないかな。彼女は蜂の巣のための怖くて脅威的な暗殺者なんだ。好きなように描いてください！ありがとう！\n\nhttps://sta.sh/02e58h1q1mgk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AoKi_MiDori_/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1539393, "client_id": 2102814, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f0eab5c/uploads/origins/74e73365-687a-42ef-8b4c-5882a19c2858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf28a4c80e67c51ebdeb6953677d3a2d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f0eab5c/uploads/origins/74e73365-687a-42ef-8b4c-5882a19c2858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=949fcea801e22d8566e57e6b51d2a7cf", "src_set": ""}, "body": "こんにちは！私はあなたの絵が本当に大好きで、私の蛾のキャラクターもあなたに描いてもらったら素敵だと思います。彼女はカビに感染した白い蛾です。ビジュアル・リファレンスは以下のリンクにあります。\n\nhttps://toyhou.se/23379027.lamin", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AoKi_MiDori_/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1539393, "client_id": 1940096, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ef20731/uploads/origins/97ffe9c7-22c2-4bb6-a945-cc562258d9e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1f33212bb3040dd8f8e521798af88f8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ef20731/uploads/origins/97ffe9c7-22c2-4bb6-a945-cc562258d9e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d3855e6c3f32131d74f55dc79780721", "src_set": ""}, "body": "こんにちは！前回描いていただいたキャラクターがとても気に入ったので、また描いていただけませんか？キャラクターの大まかなテーマは、彼女は感情的に冷たいバーテンダーで、ヒットマン／スナイパーとしても働いている。\n彼女は[参考文献1-2]のような白いシャツに黒いベストと黒いネクタイ、[参考文献3]のような無地の黒いスーツのズボンと靴を身に着けています。胸は平ら。ボタンのような外側のパーツは金色である。\n瞳は金色で、右の瞳孔が十字のようになっている。\n髪型はポニーテールのショート。前髪は[参考文献5]を参考にし、ポニーテールとサイドの髪を[参考文献6-7]のように胸の前に落とす。さらに、髪のどこかに金色のハイライトを入れてほしい。\n彼女はブリーフケースか銃、特にWA2000を持っている。(写真は[参考資料8-9]にあります。)複雑すぎるというのであれば、銃を描く必要はありません。代わりにブリーフケースを持たせ、取っ手と金属の縁を金色にしてもまったく構わない。\n\nhttps://drive.google.com/drive/folders/1eKgp6ovS3_xBCBxusscLpkNAi9XrYujv?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AoKi_MiDori_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1539393, "client_id": 1940096, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b83cb3aa/uploads/origins/0f4c1e36-d897-4db8-aee3-75a7f20f5f09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e189bd2fda9dedb80b952b8e01f34b1f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b83cb3aa/uploads/origins/0f4c1e36-d897-4db8-aee3-75a7f20f5f09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=285425650c950d88e9e97680d50b4a59", "src_set": ""}, "body": "こんにちは、あなたのアートスタイルは超クールです、私のキャラクターを描いていただけませんか？\n大まかなイメージは、「忘れられた宗教の、引きこもりで怠け者の巫女」です。彼女は神殿で一人暮らしをしているが、無気力な態度にもかかわらず、神に献身している。\n一般的な特徴としては\n- 猫のような耳\n- 身長153cm前後とやや低め\n- ロング、メッシーヘア、どんなスタイルでも。\n- これらをイメージしたゴシック・ロリータ風ファッション - https://drive.google.com/drive/folders/1SW5wRvtIYqleQ9UhaIdNVGLVVT5k7_fK?usp=sharing\n- 鎖や有刺鉄線をデザインのどこかに（肩にかけたり、手首に巻いたりするのも一案ですが、自由にやってください。）\nコンセプトは自由で、細かいところは好きなようにやってください。また、宗教的なモチーフとして、彼女の神様はこんな感じです。https://drive.google.com/drive/folders/1dYj0EQqgqOAHbUDZYeU0mPzZXyC3K6zv?usp=sharing。\nご検討のほど、よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 60137, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "塩八❀", "screen_name": "shiohachi", "avatar_url": "https://pbs.twimg.com/profile_images/1908204698458611714/yq00gJZK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/866554768520470528/1664964232/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 33}, {"id": 846825, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "いちご煮", "screen_name": "152_in_CAN", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F8b1920cd-2e5e-42a5-9cc2-54db4ad3dfb0.png&avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 0}, {"id": 899326, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "なまえび", "screen_name": "kasasagi191", "avatar_url": "https://pbs.twimg.com/profile_images/1110427663842205697/-hXEqcdW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/714448980755623936/1629385273/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{