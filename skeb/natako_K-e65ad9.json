ればレイヤーを分けてもらえますか？TwitchチャンネルとYouTubeのサムネイルに使いたいと思っています。\nリクエストを読んでいただき、ありがとうございました。\n\nhttps://drive.google.com/file/d/1pzH6Lp4kSmg-u2w0YieAe8Q9FdvUyKAR/view?usp=drivesdk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@natako_K/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1999981, "client_id": 1659129, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc831bcf/uploads/origins/bf0edc72-44b6-434d-a795-4a2f03d0ec0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7442bc85fca44623c523ba909f71368", "srcset": "https://si.imgix.net/cc831bcf/uploads/origins/bf0edc72-44b6-434d-a795-4a2f03d0ec0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7442bc85fca44623c523ba909f71368, https://si.imgix.net/cc831bcf/uploads/origins/bf0edc72-44b6-434d-a795-4a2f03d0ec0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b13cbc3e958d3ea988741fccefd26df2 2x, https://si.imgix.net/cc831bcf/uploads/origins/bf0edc72-44b6-434d-a795-4a2f03d0ec0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5d93345653bfe847089d2059190b7de 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc831bcf/uploads/origins/bf0edc72-44b6-434d-a795-4a2f03d0ec0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4e0e9c9a2958f1e749d1a534341e1f4", "srcset": "https://si.imgix.net/cc831bcf/uploads/origins/bf0edc72-44b6-434d-a795-4a2f03d0ec0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4e0e9c9a2958f1e749d1a534341e1f4, https://si.imgix.net/cc831bcf/uploads/origins/bf0edc72-44b6-434d-a795-4a2f03d0ec0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6bb8ff5910195666298c2765b2f72bf7 2x, https://si.imgix.