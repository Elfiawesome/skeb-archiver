unt": 2000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@ikaru/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3320981, "client_id": 2767686, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0bffb35b/uploads/origins/570bafad-727a-4120-a184-fce44d57af30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7a04c6a681edc9a32cf2299836a5e9f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0bffb35b/uploads/origins/570bafad-727a-4120-a184-fce44d57af30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c369c789e498f08936c0550fbc2601b7", "src_set": ""}, "body": "いかるさんこんにちは！リクエストさせてください！\n\nうちのこ（伺かゴースト）「大井道桃華」ちゃんを、描いていただきたいです。\nhttps://misskey.io/notes/a49feqrzfg8i09hm\n身長をはじめいろいろなところが大きい、ややドジ寄り（しっかり者になりたいが、なかなかなれない）のメイドです。銘菓と洗濯の知識だけは自信がある、というフレーバーを持っています。\n他の方の作例はSkebクライアントページを参照いただけると幸いです。\n\n表情、衣装、構図等ぜんぶおまかせなのですが、\n\nうおでっか\nさすがにこれは\nでかすぎる\n\nみたいな感じにしてもらえるとうれしいです\n自由に描いていただきたいので　NSFW有効にしておきました\nよろしくおねがいします！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikaru/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3320981, "client_id": 3185223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51d9d2be/uploads/origins/b818f60d-dbf4-480f-b829-25781e78e791?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=673de395258036e6da7069d1c9b5725b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51d9d2be/uploads/origins/b818f60d-dbf4-480f-b829-25781e78e791?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200