uto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84f39f1b7f59dc11db3b52a715756484 2x, https://si.imgix.net/748b0e84/uploads/origins/46cef541-9843-440d-a9e6-14d887f6dce0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c55de156286c9a8ddde405832244fbc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/748b0e84/uploads/origins/46cef541-9843-440d-a9e6-14d887f6dce0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=417e4a5277f6e780992c607ff439e539", "srcset": "https://si.imgix.net/748b0e84/uploads/origins/46cef541-9843-440d-a9e6-14d887f6dce0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=417e4a5277f6e780992c607ff439e539, https://si.imgix.net/748b0e84/uploads/origins/46cef541-9843-440d-a9e6-14d887f6dce0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fb5ec8afce11808f9371cb955afce022 2x, https://si.imgix.net/748b0e84/uploads/origins/46cef541-9843-440d-a9e6-14d887f6dce0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=27dc7444d03a819aa9032fe0396a6a2e 3x"}, "body": "リクエストしたいもの：一枚絵\nリクエストしたいキャラクター：TRPG自&よそ探索者（詳細以下）\n\nキャラクター詳細：\n　名前：舞桜 紅音（まいさ あかね）、舞桜 白音（まいさ あきと）\n　見た目等資料：\nhttps://twitter.com/lumi_k780/status/1645418061166682113?s=61&t=KE2yaEVau50aEO_QeZFEuQ\nhttps://twitter.com/reia_chat/status/1648680685094461441?s=61&t=KE2yaEVau50aEO_QeZFEuQ\nhttps://twitter.com/lumi_k780/status/1659880324422328321?s=61&t=KE2yaEVau50aEO_QeZFEuQ\n\n　キャラシ：白音の方だけです。閲覧する際は「メモ」欄以外の欄を見てしまうとネタバレになってしまうと思うので注意してください。\n　　https://iachara.com/char/view/5675623\n\n　設定：双子の兄弟（どっちが兄なのか弟なのかはシナリオ都合により伏せます…すみません！）\n　　　　24歳。タンゴダンサーをしていて、二人でペアダンスを踊っている。双子ならではの息のあった踊りにはたくさんのファンがついている。揃いのピアスをいつもつけている。ピアスは桜モチーフで紅音が赤、白音が白。\n　　紅音：明るく前向き。白音のことが好きで一緒に踊るのがとても好き。どこか儚い雰囲気を纏っている。\n　　白音：紅音より大人しく、あまり自己主張しない。クールだと思われていそう（本人は口下手だし…とか思ってる）。紅音のことは好きだけどあまり口には出さない。最近は写真を撮るのが趣味。\n\n　　　白音の方がしっかりしている…と思いきやちょっと子供っぽいところもあるので紅音の方がしっかりしている。何かを一緒に見たりしたりする時に、紅音がにこにこしている一方で、白音は素直じゃないのでちょっと距離を置いているところを紅音に腕を引っ張られて近づいてる感じ。\n　　　紅音「ね！やろやろ！」\n　　　白音「…まあいいけど」\n　　　みたいな。\n　　　\nリクエストしたいシチュエーション：\n　桜の木の下にいる二人が見たいと思っているのでできればそれをお願いしたいんですが、宵千さん絵柄の二人を見たいだけなので別の状況でも構いません。服装変更等も可。ただピアスはつけていてもらえると助かります。\n\n他の書いていない事柄はお任せします。\n\n初めてのリクエストなので至らない点があればすみません。\nよければお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoic_yoru/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2850982, "client_id": 184911, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c238a22/uploads/origins/99d79a3f-36f7-42f1-a53e-ca4f14a7c49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04eef63d8c8cf1c6f044df3b7e32d993", "srcset": "https://si.imgix.net/2c238a22/uploads/origins/99d79a3f-36f7-42f1-a53e-ca4f14a7c49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04eef63d8c8cf1c6f044df3b7e32d993, https://si.imgix.net/2c238a22/uploads/origins/99d79a3f-36f7-42f1-a53e-ca4f14a7c49f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9cfb5d5b8f4b5ae84d0991fdafa6990 2x, https://si.imgix.net/2c238a22/uploads/origins/99d79a3f-36f7-42f1-a53e-ca4f14a7c49f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=412de927d5fa4b0615322da51a82ad7d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c238a22/uploads/origins/99d79a3f-36f7-42f1-a53e-ca4f14a7c49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84b276faf802a80355e20e849d4bd726", "srcset": "https://si.imgix.net/2c238a22/uploads/origins/99d79a3f-36f7-42f1-a53e-ca4f14a7c49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84b276faf802a80355e20e849d4bd726, https://si.imgix