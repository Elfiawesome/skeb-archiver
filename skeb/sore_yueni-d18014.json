\n・胸元やおへそなどの肌の露出は少なめor無し\n・どこかにシースルーを用いた透明感のあるデザイン\n・満月よりは「三日月」「新月」のように多少影のある方向性\n\n\n可能であれば、サムネイルやSNSでの広告などで多様に使わせて頂きたいので背景と人物を分けたデータもいただけたらうれしいです。\n\n難しいご依頼であると思われますが、何卒ご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1V3B2abz4Lr5tSTqdXVwfDG8cYTA18nrp", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takakuke1/works/30", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 2574068, "client_id": 2598380, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8dd159e/uploads/outputs/670c88a6-3d90-4d11-b432-f3aa62a7b2bf?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=307fc55b04a1e14eba38d52b6b815975", "srcset": "https://si.imgix.net/f8dd159e/uploads/outputs/670c88a6-3d90-4d11-b432-f3aa62a7b2bf?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=307fc55b04a1e14eba38d52b6b815975, https://si.imgix.net/f8dd159e/uploads/outputs/670c88a6-3d90-4d11-b432-f3aa62a7b2bf?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=f22b5c81ae31996450b0ed35ab603795 2x, https://si.imgix.net/f8dd159e/uploads/outputs/670c88a6-3d90-4d11-b432-f3aa62a7b2bf?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=6be731075a525a35abc192b0d96b8194 3x"}, "duration": 2, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8dd159e/uploads/outputs/670c88a6-3d90-4d11-b432-f3aa62a7b2bf?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=25c1df5d73a26b9764c4133945d13bc3", "srcset": "https://si.imgix.net/f8dd159e/uploads/outputs/670c88a6-3d90-4d11-b432-f3aa62a7b2bf?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=25c1df5d73a26b9764c4133945d13bc3, https://si.imgix.net/f8dd159e/uploads/outputs/670c88a6-3d90-4d11-b432-f3aa62a7b2bf?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=51ec3842cecc8f7d92b9d9