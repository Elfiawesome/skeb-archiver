=200&h=200&blur=200&s=c8306f04c33b54d91bc07221be6c2497", "srcset": "https://si.imgix.net/04f8b1c4/uploads/origins/eac99206-334b-44cb-9f42-2e1108fcf268?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8306f04c33b54d91bc07221be6c2497, https://si.imgix.net/04f8b1c4/uploads/origins/eac99206-334b-44cb-9f42-2e1108fcf268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=355721f5bd2e5bf38b2100b56d538253 2x, https://si.imgix.net/04f8b1c4/uploads/origins/eac99206-334b-44cb-9f42-2e1108fcf268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=55bca313fdc61a0ff271b37695283a26 3x"}, "body": "こんにちは、ヒルさん。少し前にご依頼をいただきましたが、あなたの作風に合うキャラクターのアイデアが浮かびました。\n\nそのキャラクターの名前は佐藤 令子（サトウ・レイコ）です。彼女は56歳の「魔法少女」、というか「魔法ばば」です。佐藤はかつてモンスターとの戦いを指揮した軍人でしたが、右足を失ってしまいました。 魔法少女になった際、金属製の義足を手に入れましたが、これは変身アイテムとしても機能します。\n\n年齢の割に、佐藤はモンスターとの戦いに執着しており、戦闘中は狂乱状態になります。この点が、あなたの「荒削り」な画風にぴったりだと思いました。\n\n参考URLには、自作のスケッチに加え、ポーズ例付きの3Dモデルも含まれています。お好きなようにアレンジしてください！\n\nhttps://catbox.moe/c/jwjdnn", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hillnihil/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3587251, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6146091d/uploads/origins/80380850-caaa-4154-bf30-64fa172775db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86d3d0890d0b33bd21855245dd89a7c4", "srcset": "https://si.imgix.net/6146091d/uploads/origins/80380850-caaa-4154-bf30-64fa172775db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86d3d0890d0b33bd21855245dd89a7c4, https://si.imgix.net/6146091d/uploads/origins/80380850-caaa-4154-bf30-64fa172775db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2318797ad2a644ceaa83f71c391c94a 2x, https://si.imgix.net/6146091d/uploads/origins/80380850-caaa-4154-bf30-64fa172775db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e6a5b051156cd09f5aedd25856f0ac0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6146091d/uploads/origins/80380850-caaa-4154-bf30-64fa172775db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d219e7c3bbd828c4407f7c14e4395652", "srcset": "https://si.imgix.net/6146091d/uploads/origins/80380850-caaa-4154-bf30-64fa172775db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d219e7c3bbd828c4407f7c14e4395652, https://si.imgix.net/6146091d/uploads/origins/80380850-caaa-4154-bf30-64fa172775db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e3bead1adacaf96db4d4c9c6c536329e 2x, https://si.imgix.net/6146091d/uploads/origins/80380850-caaa-4154-bf30-64fa172775db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2e3e538d4035e11353577d4007fc6b72 3x"}, "body": "ひぐらしのファンアートを描かれていたのを拝見しました。\nよければひぐらしのなく頃に業/卒の北条沙都子をお願いしたいです。\n卒の後半で延々梨花ちゃまを殴り続ける沙都子のシーンがあるのですが、これがなんだか猛烈に好きなのです。\nので、殴りつける沙都子にフォーカスした絵を一枚頂きたいです。\n相手は梨花ちゃまを想定していますが映っているのは沙都子だけで構いません。\nお馴染みの緑のワンピース、中学？制服、ルチーア制服などなど沙都子の年齢や服装はおまかせしたいです。\n血などの表現があるかもしれないのでNSFWにしていますが、エッチである必要はありません。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hillnihil/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3587251, "client_id": 43679, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b8012fd/uploads/origins/4763943a-2a9b-46e4-a8c3-a427ed2251ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d84333622f571d1d9460d6e6a258b37", "srcset": "https://si.imgix.net/5b8012fd/uploads/origins/4763943a-2a9b-46e4-a8c3-a427ed2251ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d84333622f571d1d9460d6e6a258b37, https://si.imgix.net/5b8012fd/uploads/origins/4763943a-2a9b-46e4-a8c3-a427ed2251ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9521292e2af10225a3a591fb14899055 2x, https://si.imgix.net/5b8012fd/uploads/origins/4763943a-2a9b-46e4-a8c3-a427ed2251ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f1b3859a22a29296eb168113dfb988a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b8012fd/uploads/origins/4763943a-2a9b-46e4-a8c3-a427ed2251ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41a77d1cd29fcc0b3908e83c283bf541", "srcset": "https://si.imgix.net/5b8012fd/uploads/origins/4763943a-2a9b-46e4-a8c3-a427ed2251ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41a77d1cd29fcc0b3908e83c283bf541, https://si.imgix.net/5b8012fd/uploads/origins/4763943a-2a9b-46e4-a8c3-a427ed2251ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3fb1abb4eaa6e44d3ec2397ecb785d16 2x, https://si.imgix.net/5b8012fd/uploads/origins/4763943a-2a9b-46e4-a8c3-a427ed2251ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa8feffa9a2feb850c486b511413af7f 3x"}, "body": "こんにちは。先日はありがとうございました。\n同じキャラを500回くらいお願いしていて恐縮ですが、もしお手すきでしたら今回も拙作のキャラをお願いできますか？\n\n今回こちらの服装でお願いします：\nhttps://livedoor.blogimg.jp/mochimako/imgs/2/5/256ac4a1.jpg\n左腕と左脚は義手義足です。\n着衣でほとんど隠れているのですが留意点としまして、右目と右耳、左の乳房、鼻から下の一部も失っています。やけどのような跡という設定です。\n\nこれまたちょっと妄想したことがあります。下記は書き連ねたものです。\nhttps://x.com/mushikera_hoi2/status/2033112305286959464\nこれを形にしていただきたいです。\n\n具体的にはモンスター討伐直後に立ち尽くしている、というシーンをお願いしたいです。\nモンスターは攻撃ではなくキャラクターに性的な接触を繰り返しますが、これがキャラクターにとって想定外であり、不快感から衝動的に殺してしまったけれど自分が何をされたのかわからず、またわかりたくもなく思考停止で立ち尽くしてしまっているという状況を想定しています。\n状況的にNSFWにしていますが、しっかり衣服は残っており、本番なくともそういった接触があったのだろうと思えるくらいの着衣の乱れがある程度のイメージです。\nまたモンスターの描写は必須ではないので、キャラクターが返り血を浴びているなど戦闘事後っぽい雰囲気の範囲の描写でも構いません。\n\nご検討のほどいただけますと幸いです。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hillnihil/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3587251, "client_id": 543344, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51b1d4f9/uploads/origins/51747b07-f16d-4e80-b7cd-1a86ba393c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7be8b56b51b92a5d0bb02141ef1780cf", "srcset": "https://si.imgix.net/51b1d4f9/uploads/origins/51747b07-f16d-4e80-b7cd-1a86ba393c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7be8b56b51b92a5d0bb02141ef1780cf, https://si.imgix.net/51b1d4f9/uploads/origins/51747b07-f16d-4e80-b7cd-1a86ba393c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a4d943a6099bc5e4ed7be4d6e8542ca 2x, https://si.imgix.net/51b1d4f9/uploads/origins/51747b07-f16d-4e80-b7cd-1a86ba393c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e723b7cd73442441121e4fab7174dab7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51b1d4f9/uploads/origins/51747b07-f16d-4e80-b7cd-1a86ba393c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e580b031a51637f106a0d4b7b27fe4a3", "srcset": "https://si.imgix.net/51b1d4f9/uploads/origins/51747b07-f16d-4e80-b7cd-1a86ba393c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e580b031a51637f106a0d4b7b27fe4a3, https://si.imgix.net/51b1d4f9/uploads/origins/51747b07-f16d-4e80-b7cd-1a86ba393c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4203268d4cbe86d78c3c12242663adc0 2x, https://si.imgix.net/51b1d4f9/uploads/origins/51747b07-f16d-4e80-b7cd-1a86ba393c1f?bg=%23fff&auto=format%2Ccompres