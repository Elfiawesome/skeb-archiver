f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3e4aa4cd37574ea3fb2fdb48bbd4814, https://si.imgix.net/5107d1ad/uploads/origins/f8048614-fd40-4a9e-bd14-1efc4dfdb9ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6bb8000e43dd2b8355cf12f30903a0e7 2x, https://si.imgix.net/5107d1ad/uploads/origins/f8048614-fd40-4a9e-bd14-1efc4dfdb9ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=975dffd9205ba990fb69e8b818414c32 3x"}, "body": "こんにちは。\n先日はありがとうございました！また拙作のキャラをお願いしたいです。\n少し前にちょっと妄想したことがあります。下記は書き連ねたものです。\nhttps://x.com/mushikera_hoi2/status/2013638096957407743\n\nこれを形にしていただきたいです。\n具体的には下記URLのキャラ1とキャラ2がベッドの上で全裸でピザ食べてるシーンをお願いしたいです。\n全裸と言いましたが全て見えている必要はなく、ベッドという都合上下半身は布団の中とかでも構いません。\nまた、どちらかと言えば｢裸！エッチ！！｣というニュアンスより、だらしない格好でだらしないことしてる親密で自堕落で怠惰な時間を二人で過ごしているようなイメージでお願いできましたら幸いです。\n\n一部重複していますが下記はキャラについて：\n★キャラ1\n服装や髪型など色々ありますがいずれでも構いません(と言っても今回全裸ですが…)\n★キャラ2\n左腕と左脚は義手義足です。\n着衣でほとんど隠れているのですが留意点としまして、右目と右耳、左の乳房、鼻から下の一部も失っています。やけどのような跡という設定です。\n\n下記URLですが、｢キャラ1｣｢キャラ2｣フォルダだけ見ていただければ事足りるかと思います。\n｢その他｣とついたフォルダは情報が不足していた場合にご参考にしていただけますと幸いです。\nお目通しをありがとうございます。\n\nhttps://drive.google.com/drive/folders/1WDvml0XLkEAYBBNWQGysA1a_x1IzWjoM?usp=drive_link", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hillnihil/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3587251, "client_id": 36500, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28ec63c0/uploads/origins/8ed2c7c2-ecd7-487b-a30e-21b140417be5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=610fe0262eee15a66c4db32ad22cb1fa", "srcset": "https://si.imgix.net/28ec63c0/uploads/origins/8ed2c7c2-ecd7-487b-a30e-21b140417be5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=610fe0262eee15a66c4db32ad22cb1fa, https://si.imgix.net/28ec63c0/uploads/origins/8