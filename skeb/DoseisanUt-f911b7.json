。\n\n使用目的としてはファンアートとして送りたいです。そして宛名有り、宛名無し、背景透過のデータもいただけると嬉しいですね。配信のサムネイルとしても使っていただきたいので桃奈みゆいさん本人がサムネやグッツSNSで投稿など使用できるように許可して欲しいです。\n\nまた私もTwitterの背景画像やスマホやPCの壁紙等個人的な範囲で使用したいのでその許可も併せてお願いしたいです。\n\nお忙しいところ恐縮ですが、\nご検討宜しくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@DoseisanUt/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 522117, "client_id": 1689675, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8daf1ec2/uploads/origins/23405b50-344a-4dab-b3e7-f0014aac95b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=923c822878190ad632fa727052d09bcb", "srcset": "https://si.imgix.net/8daf1ec2/uploads/origins/23405b50-344a-4dab-b3e7-f0014aac95b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=923c822878190ad632fa727052d09bcb, https://si.imgix.net/8daf1ec2/uploads/origins/23405b50-344a-4dab-b3e7-f0014aac95b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=413bc42cc02f65d5a0e906cfc84ce724 2x, https://si.imgix.net/8daf1ec2/uploads/origins/23405b50-344a-4dab-b3e7-f0014aac95b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adce41ab7334281c952c5bb746cb89ce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8daf1ec2/uploads/origins/23405b50-344a-4dab-b3e7-f0014aac95b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c5b85f452b6b99bb1b546ccd2fae2d9", "srcset": "https://si.imgix.net/8daf1ec2/uploads/origins/23405b50-344a-4dab-b3e7-f0014aac95b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c5b85f452b6b99bb1b546ccd2fae2d9, https://si.imgix.net/8daf1ec2/uploads/origins/23405b50-344a-4dab-b3e7-f0014aac95b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&