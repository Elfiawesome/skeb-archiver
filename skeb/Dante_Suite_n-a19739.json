歌にしていただきたいです。幼子が男のために目を輝かせて見つけてくる季節の変わり目のものや花を共に感じ、穏やかに過ごしているような様子などを、どちらの視線でも良いので、短歌にして頂けましたら…\n\n短歌に触れてこなかった故に知識もなく、このようなお願いでよろしければ、何卒よろしくお願いいたします……", "nc": 0, "word_count": 225, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@Dante_Suite_n/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 2023487, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/775cf2c5/uploads/origins/cbba8b67-2a18-469e-86a0-a27b3202984e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=545fa9b79f0a4a7ce8ff9a16cb78f426", "srcset": "https://si.imgix.net/775cf2c5/uploads/origins/cbba8b67-2a18-469e-86a0-a27b3202984e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=545fa9b79f0a4a7ce8ff9a16cb78f426, https://si.imgix.net/775cf2c5/uploads/origins/cbba8b67-2a18-469e-86a0-a27b3202984e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37a98ef63f0be5498bbde1af2ab0e303 2x, https://si.imgix.net/775cf2c5/uploads/origins/cbba8b67-2a18-469e-86a0-a27b3202984e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03851b8d45447bacdbafe83b5f2c9ff8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/775cf2c5/uploads/origins/cbba8b67-2a18-469e-86a0-a27b3202984e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c8ec4fe9159dd6742e5817f9e1ee536", "srcset": "https://si.imgix.net/775cf2c5/uploads/origins/cbba8b67-2a18-469e-86a0-a27b3202984e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c8ec4fe9159dd6742e5817f9e1ee536, https://si.imgix.net/775cf2c5/uploads/origins/cbba8b67-2a18-469e-86a0-a27b3202984e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2896985731d40d91cd400c5717f1d324 2x, https://si.imgix.net/775cf2c5/uploads/origins/cbba8b67