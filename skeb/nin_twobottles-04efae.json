4-4af4-961b-87302f839249?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99a78da3a1c02d1c2a89f56186b5b1b8", "srcset": "https://si.imgix.net/2cbce366/uploads/origins/24a70c46-4ce4-4af4-961b-87302f839249?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99a78da3a1c02d1c2a89f56186b5b1b8, https://si.imgix.net/2cbce366/uploads/origins/24a70c46-4ce4-4af4-961b-87302f839249?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c720b8a30322bc46c961b78a7c172a4e 2x, https://si.imgix.net/2cbce366/uploads/origins/24a70c46-4ce4-4af4-961b-87302f839249?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f90d4bca15c7dc79115bd330c24f0cc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2cbce366/uploads/origins/24a70c46-4ce4-4af4-961b-87302f839249?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84bce19de329e24b3492b36cde2080fc", "srcset": "https://si.imgix.net/2cbce366/uploads/origins/24a70c46-4ce4-4af4-961b-87302f839249?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84bce19de329e24b3492b36cde2080fc, https://si.imgix.net/2cbce366/uploads/origins/24a70c46-4ce4-4af4-961b-87302f839249?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e8fd42b511fa636f03d4ffdeb778594 2x, https://si.imgix.net/2cbce366/uploads/origins/24a70c46-4ce4-4af4-961b-87302f839249?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=019c0f6f3476c29d63993b8235dc33c4 3x"}, "body": "お世話になっております、歪んだむと申します。\n前回は素敵な作品をありがとうございました。\n\n今回はうちの子の「シア」と「フォルン」のペアでのイラストをリクエストします。\nキャラデザは参考資料の通りです。\n資料で分かりにくい点、不明な点などは描きやすいように省略やアレンジしていただいて大丈夫です。\n\n●リクエスト内容\nhttps://x.com/nin_twobottles/status/1966491676006125765\nシチュは上記のイラストの様なストリートスタイルで、路地裏みたいな場所で思いのままに過ごしている、ちょっと治安の悪そうな様子の2人を描いてほしいです。\n\n\n構図や2人のポーズ他、\n服装の色やデザイン、体のペイントや装