胆でおしゃべり。彼の表情はいつも満面の笑みだ。\n\n以下のようなシーンが考えられます（描きたくなければ描かなくてもかまいません）：\n- 廃墟となった教会を一緒に探検\n- ロウソク、ナイフ、血を使った怖いカルトの儀式を行っている。\n- 怖いモンスターと戦ったり隠れたりしている。\n- お好きなシーン\n\nいずれにせよ、読んでくれて本当にありがとう！\n\nhttps://drive.google.com/drive/folders/1uV4UtcsimuwnNtJvnj3WmLZ-heBRzsN9?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MBMpaper/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2569046, "client_id": 2837939, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9df48703/uploads/origins/23aa2d1c-2587-4878-b568-0862206133d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee711c4c5a583809dcf8ce5c21af57f8", "srcset": "https://si.imgix.net/9df48703/uploads/origins/23aa2d1c-2587-4878-b568-0862206133d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee711c4c5a583809dcf8ce5c21af57f8, https://si.imgix.net/9df48703/uploads/origins/23aa2d1c-2587-4878-b568-0862206133d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb14b633373be842c7e8129509af442e 2x, https://si.imgix.net/9df48703/uploads/origins/23aa2d1c-2587-4878-b568-0862206133d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc8e4ab51acf21a96611d1fb3bfed623 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9df48703/uploads/origins/23aa2d1c-2587-4878-b568-0862206133d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b24c2dec7f145ed8201028afc331f61f", "srcset": "https://si.imgix.net/9df48703/uploads/origins/23aa2d1c-2587-4878-b568-0862206133d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b24c2dec7f145ed8201028afc331f61f, https://si.imgix.net/9df48703/uploads/origins/23aa2d1c-2587-4878-b568-0862206133d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=