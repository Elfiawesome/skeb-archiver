首にもふもふとした逆鱗があります\n・爬虫類に近いです\n\n背景透過Verも頂けますととても助かります。\nお忙しいとは存じますが何卒よろしくお願いいたします。\n\n▷youtube https://youtube.com/@Irohani_Wowali?si=poeVy3tSknQQ4ZHr\n\nhttps://drive.google.com/drive/folders/1nR2sbQ3DdOOhcwjURBdQgN4gTuOcCqZr", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MBMpaper/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2569046, "client_id": 2507340, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75938e12/uploads/origins/da35b25f-4be4-4fc1-90cf-12e7649f4423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca640717f8d6856e746ce0a6a4587e50", "srcset": "https://si.imgix.net/75938e12/uploads/origins/da35b25f-4be4-4fc1-90cf-12e7649f4423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca640717f8d6856e746ce0a6a4587e50, https://si.imgix.net/75938e12/uploads/origins/da35b25f-4be4-4fc1-90cf-12e7649f4423?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41470fe0cf1febb1032abbad28f1091e 2x, https://si.imgix.net/75938e12/uploads/origins/da35b25f-4be4-4fc1-90cf-12e7649f4423?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a85b348f2b9b97f7d7eec4c3e54213b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75938e12/uploads/origins/da35b25f-4be4-4fc1-90cf-12e7649f4423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e626233c1d2a7b1fa409f60faa0a368", "srcset": "https://si.imgix.net/75938e12/uploads/origins/da35b25f-4be4-4fc1-90cf-12e7649f4423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e626233c1d2a7b1fa409f60faa0a368, https://si.imgix.net/75938e12/uploads/origins/da35b25f-4be4-4fc1-90cf-12e7649f4423?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e