のですが、今回は射精は有りでも無しでも、どちらでも大丈夫です。\n（背景や、男の描写は最低限で大丈夫です）\n\nよろしくお願いします。\n\nhttps://www.pixiv.net/artworks/124596428", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nagisa_otoha/works/99", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1678935, "client_id": 87802, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37ff840c/uploads/origins/6f8bb69c-c846-4ea2-ba7f-536b7648a8d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b5785c26cdda259dd5627de2835a940", "srcset": "https://si.imgix.net/37ff840c/uploads/origins/6f8bb69c-c846-4ea2-ba7f-536b7648a8d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b5785c26cdda259dd5627de2835a940, https://si.imgix.net/37ff840c/uploads/origins/6f8bb69c-c846-4ea2-ba7f-536b7648a8d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52ec3fde3647a9483b277b3febd184d5 2x, https://si.imgix.net/37ff840c/uploads/origins/6f8bb69c-c846-4ea2-ba7f-536b7648a8d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2150c59b3bb6db2633fc2b81e32566f3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37ff840c/uploads/origins/6f8bb69c-c846-4ea2-ba7f-536b7648a8d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7a3f3f54bc326404cfd344a695282ab", "srcset": "https://si.imgix.net/37ff840c/uploads/origins/6f8bb69c-c846-4ea2-ba7f-536b7648a8d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7a3f3f54bc326404cfd344a695282ab, https://si.imgix.net/37ff840c/uploads/origins/6f8bb69c-c846-4ea2-ba7f-536b7648a8d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d75e56c12df893f36690fdb304e4ef4c 2x, https://si.imgix.net/37ff840c/uploads/origins/6f8bb69c-c846-4ea2-ba7f-536