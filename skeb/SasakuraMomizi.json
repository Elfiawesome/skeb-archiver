mage", "creator_acceptable_same_genre": true}, {"path": "/@SasakuraMomizi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3793498, "client_id": 688307, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea76e801/uploads/origins/027706fd-0e01-4afc-94c2-8f72af34de3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa996f1ead7ba817694b5dc9b659624d", "srcset": "https://si.imgix.net/ea76e801/uploads/origins/027706fd-0e01-4afc-94c2-8f72af34de3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa996f1ead7ba817694b5dc9b659624d, https://si.imgix.net/ea76e801/uploads/origins/027706fd-0e01-4afc-94c2-8f72af34de3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68aa3c02f7225db1f7118e2a22ad2a75 2x, https://si.imgix.net/ea76e801/uploads/origins/027706fd-0e01-4afc-94c2-8f72af34de3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f655de5db56fed6393e7bb3111fdedf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea76e801/uploads/origins/027706fd-0e01-4afc-94c2-8f72af34de3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc54d31814e8ea912701ba86e872f284", "srcset": "https://si.imgix.net/ea76e801/uploads/origins/027706fd-0e01-4afc-94c2-8f72af34de3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc54d31814e8ea912701ba86e872f284, https://si.imgix.net/ea76e801/uploads/origins/027706fd-0e01-4afc-94c2-8f72af34de3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=278849ee7733a02b701039a03f55836b 2x, https://si.imgix.net/ea76e801/uploads/origins/027706fd-0e01-4afc-94c2-8f72af34de3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2810c79759da56b52de61655f853d3ea 3x"}, "body": "笹倉紅葉先生、初めまして。かねてより先生の素敵なイラストのファンで、デスクマットなども愛用させていただいております。\n最近先生がskebを始められたのを知り是非に、と依頼を送らせていただいた次第です。\n\n■リクエスト内容\nVarium所属の飴望にぃな(@amemochinina)様のイラスト\n(いわゆる絵タグや三面図などはXのプロフィール・固定ツイート欄にございます。よろしければご参照ください。)\n\n■構図\n先日3Dモデルのお披露目配信があったのですが、その際に歌われた「群青」のライブがとても素敵だったので、そちらをイメージしたイラストをお願いできればと思います。\n必ずしもライブ中のお姿そのままを再現する必要はなく、曲の歌詞や本家YOASOBI様のMVなどからイメージした構図などでも構いません。\n題材以外に関しては基本的に先生におまかせとさせていただきたいスタンスでおります。\n(こちらはチャンネル内の群青のみの動画になります。https://youtu.be/ko7SnQ_rppg?si=PnTebfNTDigqgMbU)\n\n■使用用途・創作規約について\n・クライアント自身の用途としては待ち受けや壁紙、skebサービスの「印刷してお届け」利用による観賞用がメインになります。\n・御本人様のVTuber活動における使用(配信サムネイル、その告知などSNSでの使用。配信中の画像使用。)。\nリサイズ・トリミング、文字やエフェクト被せ、全体の色調補正といった使用用途に伴う一部加工の許可もいただけると幸いです。\n上記のためのサイン無し、背景透過などの差分があると非常に助かります。\n※当該チャンネルは収益化済み、メンバーシップも開設済みのチャンネルとなっています。\n\n・二次創作規約(Varium公式サイトより):https://varium.jp/guide_line/\nこちらよりファンアートについては原則問題ないという解釈をさせて頂いております。\n\nどうぞご検討のほど、よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SasakuraMomizi/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/50505a8d/uploads/origins/a389691a-56b7-4c0c-aaf7-4b75c8fe94be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d0c626a532febd279d05899080eeb7b", "srcset": "https://si.imgix.net/50505a8d/uploads/origins/a389691a-56b7-4c0c-aaf7-4b75c8fe94be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d0c626a532febd279d05899080eeb7b, https://si.imgix.net/50505a8d/uploads/origins/a389691a-56b7-4c0c-aaf7-4b75c8fe94be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90ffd15cb396990c5118a2d3542ce27e 2x, https://si.imgix.net/50505a8d/uploads/origins/a389691a-56b7-4c0c-aaf7-4b75c8fe94be?bg=%23fff