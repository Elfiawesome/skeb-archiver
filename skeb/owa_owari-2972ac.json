ae3-4d30-904e-bc7690c08105?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8158362ae0bfa7fe07b3a8523906d18 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aeb161a0/uploads/origins/394d727f-4ae3-4d30-904e-bc7690c08105?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5cbcf10b3cc40f6850823644e1a349c", "srcset": "https://si.imgix.net/aeb161a0/uploads/origins/394d727f-4ae3-4d30-904e-bc7690c08105?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5cbcf10b3cc40f6850823644e1a349c, https://si.imgix.net/aeb161a0/uploads/origins/394d727f-4ae3-4d30-904e-bc7690c08105?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dee9c7bd0b17fe4373192252de96d6be 2x, https://si.imgix.net/aeb161a0/uploads/origins/394d727f-4ae3-4d30-904e-bc7690c08105?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=10eb875d3f56a55041baeeec72294d9d 3x"}, "body": "こんにちは、はじめまして！\n\nあなたの作品の見た目やスタイルがとても好きで、特に以前作成された赤髪のOCデザインのファンです！\n\nhttps://misskey.io/notes/adpo5vaqx3440fuu\n\nそれを踏まえて、キャラクターデザインをお願いしたくご連絡しました。\n\nうちの子、ズリ（Zuri）は自称「ちんぽ検査官」です。簡単に言うと、健康検査という薄っぺらい適当な言い訳を使って、かわいい男の子を探してセックスしています。\n\n彼女に対抗するライバル的なキャラクターのデザインをお願いしたいです。  \nズリが巨乳で余裕のある感じなのに対して、ライバルは小柄で、どちらかというと短気で熱血な感じなど（細かい部分はお任せします）。\n\n青や緑のカラーリングが効果的な対比になるかと思いますが、他の色でも構いません。あなたの判断を信頼しています。\n\n可能であれば、完全にヌードのバリエーションと、いくつかの表情差分もいただけると嬉しいです。\n\nご検討のほど、よろしくお願いいたします！\n\nhttps://www.deviantart.com/stash/2ow7xvhjnj8", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@owa_owari/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4052863, "client_id": 153686, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4603a0dd/uploads/origins/997d546d-767e-4c09-bddc-cb3b9cb10c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3da5d0f1142e9aab39a208634f0cac21", "srcset": "https://si.imgix.net/4603a0dd/uploads/origins/997d546d-767e-4c09-bddc-cb3b9cb10c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3da5d0f1142e9aab39a208634f0cac21, https://si.imgix.net/4603a0dd/uploads/origins/997d546d-767e-4c09-bddc-cb3b9cb10c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6996fe3a48e6d89e05e2ee0f74587b1 2x, https://si.imgix.net/4603a0dd/uploads/origins/997d546d-767e-4c09-bddc-cb3b9cb10c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62265f341c29d4505bf6651b213fc2ab 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4603a0dd/uploads/origins/997d546d-767e-4c09-bddc-cb3b9cb10c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6178e171387ccb0fde8afeb211c3548f", "srcset": "https://si.imgix.net/4603a0dd/uploads/origins/997d546d-767e-4c09-bddc-cb3b9cb10c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6178e171387ccb0fde8afeb211c3548f, https://si.imgix.net/4603a0dd/uploads/origins/997d546d-767e-4c09-bddc-cb3b9cb10c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b86aca09fcc22e463e791ea652d71b91 2x, https://si.imgix.net/4603a0dd/uploads/origins/997d546d-767e-4c09-bddc-cb3b9cb10c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=524f0d74d8ec2988fd942ab3a7eb5d40 3x"}, "body": "うちの子のイラストを描いて頂きたく依頼しました。\n\n[内容]\n\n構図やシチュエーション等は資料を参考にお任せ致します。\nイメージとしては女性上位な雰囲気が好きですが負けてる感じも好きなのでどちらでもOKです。\n\nよろしくお願いします。\n\n[用途]\n\n依頼用資料や紹介としてSNSやドライブ等のストレージ、\nコミュニケーションツール(discord等)で利用させていただければと思います。\n\n納品はPSDファイルでお願いします。\nPSD 閲覧可能な環境ですので、下書きやラフもあれば入れていただけると助かります。\n宛名なしも別ファイル(png可)にて納品お願いします。\nよろしくお願いします。\n\n[設定・資料]\n\n髪型は資料の様な「二つ結びのおさげ」でおねがいします。\n衣装はデフォルト衣装もしくは「03.おさげ髪型・衣装」の中からお任せします。\n衣装で分かりづらい点は描きやすい様にしてください。\n\n※『眼鏡』は掛けさせてください。\n※ふたなりでなくてOKです\n\nアンニュイな雰囲気のダウナー系。\n小柄、薄め、眠そうな目、敬語キャラ、天然。\nかわいい服装と素麺が好き。\n\nキャラクター資料\nhttps://www.dropbox.com/scl/fo/mb7nph4pl6uuz4gez71tf/AH-PYx6PR7U1_5y-7O-QXa0?rlkey=qmfdtbuh6aezc43oj7lv9ics8&dl=0", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 13987, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ブラニン", "screen_name": "buraninn", "avatar_url": "https://pbs.twimg.com/profile_images/1381521033379733504/EzJcJtjq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/525039013/1732346355/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 367187, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぺろっぱふ🎨", "screen_name": "Meowstic__", "avatar_url": "https://pbs.twimg.com/profile_images/1735875448226373632/LqAcfnUM.png", "header_url": null, "appeal_receivable": true, "popular_creator_rank": 78, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 176}, {"id": 1156320, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "きし田", "screen_name": "Axiacid", "avatar_url": "https://pbs.twimg.com/profile_images/1839166378273636352/h5wCACq-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/73878884/1759662041/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_e