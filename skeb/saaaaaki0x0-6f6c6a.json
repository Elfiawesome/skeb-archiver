瞳にハイライトが無く、じっと見つめられると少し怖い印象があります。\n・海とクラゲとマシュマロが好きです。\n・同シナリオ自陣内に、結婚を前提にお付き合いをしている人がおり(画像資料内には無いのですが)、左手の薬指にシンプルな銀色の婚約指輪を付けています。\n\n上記【お付き合いをしている人】が翡翠色をイメージカラーにしているため、雰囲気だけふんわり翡翠色にしていただけると嬉しいです。その他、構図やシチュエーションなどは全てあめこ様にお任せいたします。細かい装飾など、いくらでも省略いただいて大丈夫です！\n\nご検討いただけますと幸いです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1wDc_AsMfzHWKAJrtiNKjg0K7zmH1rxAs", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@apple_san_po/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3315544, "client_id": 66361, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e08cff0/uploads/origins/9d2bad33-47d0-47e8-9362-e38ba6ae6f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a1ac4456072ab0a853ce354bd588439", "srcset": "https://si.imgix.net/8e08cff0/uploads/origins/9d2bad33-47d0-47e8-9362-e38ba6ae6f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a1ac4456072ab0a853ce354bd588439, https://si.imgix.net/8e08cff0/uploads/origins/9d2bad33-47d0-47e8-9362-e38ba6ae6f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c08894a16bf2c504f9d9840c6e692020 2x, https://si.imgix.net/8e08cff0/uploads/origins/9d2bad33-47d0-47e8-9362-e38ba6ae6f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65fee6dce0d8ab8538ab546b778c3767 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e08cff0/uploads/origins/9d2bad33-47d0-47e8-9362-e38ba6ae6f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1459fcb4a8f1e3c19a9e21bfa8de7dc", "srcset": "https://si.imgix.net/8e08cff0/uploads/origins/9d2bad33-47d0-47e8-9362-e38ba6ae6f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1459fcb4a8f1e3c19a9e21bfa8de7dc, https://si.imgix.net/8e08cff0/upl