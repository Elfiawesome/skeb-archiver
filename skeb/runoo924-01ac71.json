8fa/uploads/origins/57699a74-b9a8-4a45-abfd-85ede6d88185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f938989eb7471720ee8f3f1ccd8bcf2 2x, https://si.imgix.net/9b62a8fa/uploads/origins/57699a74-b9a8-4a45-abfd-85ede6d88185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81e0758214baf36d47e1dd35ef11ed03 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b62a8fa/uploads/origins/57699a74-b9a8-4a45-abfd-85ede6d88185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a92a7a5c1a32e31f3256d0cd71325eef", "srcset": "https://si.imgix.net/9b62a8fa/uploads/origins/57699a74-b9a8-4a45-abfd-85ede6d88185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a92a7a5c1a32e31f3256d0cd71325eef, https://si.imgix.net/9b62a8fa/uploads/origins/57699a74-b9a8-4a45-abfd-85ede6d88185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=84d40ab9bc3dbdb838f98d41f8dea563 2x, https://si.imgix.net/9b62a8fa/uploads/origins/57699a74-b9a8-4a45-abfd-85ede6d88185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8da16bdc3e8fe19b374396489dcc924f 3x"}, "body": "先生、こんにちは。またお邪魔して申し訳ありません。もしよろしければ、私が考案した2人のオリジナルキャラクターの漫画を描いていただけないでしょうか。以下に彼らの簡単な紹介を記載します↓\n\nWagner（1）：アメリカ人、警察官。29歳、身長186cm、ドイツ系、栗色の髪、灰青色の瞳。見た目は厳格で、頭の回転が速く、法を重んじ、物事の進め方は保守的、物欲は比較的低い。ステレオタイプ通りのドイツ系刑事で、厳格かつ自制心が強く、無秩序を嫌い、法律と論理を固く信じる。しかし、社交が苦手で無口→無口だから誰も話しかけてこないという悪循環に陥りがち。ユーモアのセンスは評価が難しい（自分では面白いと思っている）。\nTalonronanに対する現在の態度：気がかり、協力、監視、相手の言動への疑念（だが理解しようとはあまり思わない）、微妙な警戒心（彼の親密な振る舞いに対して）\n彼の象徴動物はハイイログマ🐻\n\nTalonronan（0）：作家、殺し屋。31歳、身長178cm、中国とアメリカのハーフ、黒髪に薄緑色の瞳、見た目は非常に若く見える。性格は少し変わり者で、非常に穏やかで謙虚、人に対して友好的だが、実のところ本性は少し冷淡で、決断力があり果断である。養父に引き取られて以来、ずっと利用され、操られてきたが、養母を守るためにリスクを冒してでも彼女の離婚を手助けすることを選んだ。成長して故郷を離れ、家族から離れようとしたが、依然として養父に支配されていたため、徹底的に彼に立ち向かうことを決意した。一連の事件を起こした後、警察に出頭し、ワグナーを自分の後見人にするよう仕組んだ。\n現在のワグナーに対する態度：気遣い、好奇心、友好、保護、そして「自分の支配から抜け出せる希望」として見ている\n彼の象徴動物はカワウソ🦦\n\nお好きな内容を自由に描いていただいて構いません。もし金額に見合わない場合は、再度リクエストを送っていただければ大変助かります！今回の依頼をお引き受けいただけましたら、本当に感謝いたします！\n\nhttps://drive.google.com/drive/folders/1H_KP1SbKS3V5HggDbwvkZRe1QVk2Z6aj?usp=share_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@runoo924/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3995577, "client_id": 2462364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a94a0be/uploads/origins/54405ecb-d670-452c-9782-cea16d665a82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be92ad1d94eb8691c734199e0be6165f", "srcset": "https://si.imgix.net/8a94a0be/uploads/origins/54405ecb-d670-452c-9782-cea16d665a82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be92ad1d94eb8691c734199e0be6165f, https://si.imgix.net/8a94a0be/uploads/origins/54405ecb-d670-452c-9782-cea16d665a82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3fc643a5fce194a1fddf9aa19e490481 2x, https://si.imgix.net/8a94a0be/uploads/origins/54405ecb-d670-452c-9782-cea16d665a82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a21ee517e75b6c1f35b945f8c96eadf9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a94a0be/uploads/origins/54405ecb-d670-452c-9782-cea16d665a82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1c710783ce8fea40fcfe41492f036fe", "srcset": "https://si.imgix.net/8a94a0be/uploads/origins/54405ecb-d670-452c-9782-cea16d665a82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1c710783ce8fea40fcfe41492f036fe, https://si.imgix.net/8a94a0be/uploads/origins/54405ecb-d670-452c-9782-cea16d665a82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&