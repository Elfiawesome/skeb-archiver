b9a99c/uploads/origins/b16ed939-58ca-41cb-a262-7a4ff032026c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bd6260ae17d94546d663cb91c04405f", "srcset": "https://si.imgix.net/7bb9a99c/uploads/origins/b16ed939-58ca-41cb-a262-7a4ff032026c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bd6260ae17d94546d663cb91c04405f, https://si.imgix.net/7bb9a99c/uploads/origins/b16ed939-58ca-41cb-a262-7a4ff032026c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05cc66fb4c7f01992d8830f36f7e5871 2x, https://si.imgix.net/7bb9a99c/uploads/origins/b16ed939-58ca-41cb-a262-7a4ff032026c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2044d6e58fce31bd649767d2951f228 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7bb9a99c/uploads/origins/b16ed939-58ca-41cb-a262-7a4ff032026c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0b1b6287cd8f6bb0ee7f28c979b8a4f", "srcset": "https://si.imgix.net/7bb9a99c/uploads/origins/b16ed939-58ca-41cb-a262-7a4ff032026c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0b1b6287cd8f6bb0ee7f28c979b8a4f, https://si.imgix.net/7bb9a99c/uploads/origins/b16ed939-58ca-41cb-a262-7a4ff032026c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fc8002926c5c8bbaa86df1032fed94a8 2x, https://si.imgix.net/7bb9a99c/uploads/origins/b16ed939-58ca-41cb-a262-7a4ff032026c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f80c082475b6163984f505c123a9b9a 3x"}, "body": "はじめまして。ツイッターで絵を見かけ、リクエスト募集中ということで依頼したいと思います。\n\n私のキャラのミントを書いてもらいたいのですが、出来上がったばかりのキャラのため、申し訳ありませんが画像の資料はございません。\n文字の資料を以下に記します。\n\n\n目が赤い。眠そう。常に微笑、あるいはニコニコ。\n紫色の三角帽子と外套を好んで着る。\n帽子は大きめで耳出し穴が開いている。外套は首元から足首まですっぽり覆うタイプ。\n背中側のスリットから尻尾を出す。\n\n世界を跨ぐ力を使い、出会いを求めて旅をしている。\n\n身長130cm程　体重は秘密。\n丸顔　ウサギ耳　リス尻尾\n尻尾が大きい（伸ばすと体長ほど）\n体毛は濃い目のピンク　体の前面は淡いピンク（ほぼ白）　手足の先は白。おなかは結構もふもふ。\n肉球はピンク。　四本指。\n尻尾の模様は縦縞、色はこげ茶。\n腰のくびれがない（気にしてる）\n脚がちょっと短い（すごく気にしてる）\n脚のつくりは人間型。まっすぐ。（アイルー型ではない）\n胸が大きい（誇らしげ）\n魔法が使える。\n\n\n作風に合わない部分もあると思いますので、好みでデフォルメをしていただいて大丈夫です。\n\n構図は旅の途中、帽子のつばを持ち上げて空を見上げる的な感じでお願いしたいです。\nおなかの色が見えるとありがたいです。\n\n使用用途は自キャラの画像としてピクシブ小説、およびツイッターなどで使う予定です。\nどうぞよろしくお願いします。\n（依頼文に重大なミスがあったので一度キャンセルしました、申し訳ありません）", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 120309, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "エクスリ", "screen_name": "exli3141", "avatar_url": "https://pbs.twimg.com/profile_images/1125514082243600384/_jnBSDNX.jpg", "header_url": "https://pbs.twimg.com/profile_banners/96005981/1642898535/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 45, "skills": [{"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 57}, {"id": 122680, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "assault", "screen_name": "assault__", "avatar_url": "https://pbs.twimg.com/profile_images/1265957786506035200/5H9ebFSb.png", "header_url": "https://pbs.twimg.com/profile_banners/738081907/1564807931/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "novel"}], "banned": false, "nc": 32}, {"id": 414487, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "シダン", "screen_name": "tsumekomishidan", "avatar_url": "https://pbs.twimg.com/profile_images/1101481480436379648/XUJ9etII.png", "header_url": "https://pbs.twimg.com/profile_banners/1101481075669233665/1565767445/1500x500", "appe