=top&w=200&h=200&blur=200&s=d5ae7eeb63b27d189f334289a969c4a7 2x, https://si.imgix.net/e30215c4/uploads/origins/9e67e3fc-c01c-4be0-80b1-3e604f53b652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=88c4e2c807f82875c99d88037a3364ce 3x"}, "body": "こんにちは。\n\n自分の小説に登場しているキャラに立ち絵を作成して頂きたくリクエストしました。\n\n描いて頂きたいのは全身の立ち絵とアイコン用のイラスト＋表情差分で、立ち絵のポーズはお任せします。背景はなくても構いません。\nアイコンは通常、笑顔、困り、ドキドキくらいがあればありがたいです。\n\n\nポイント\n\n二～三頭身くらいの猫の男の子（少年）\n身長120㎝\n二足歩行\n全身に毛が生えているくらいのケモ度\n肉球のある手足\n右手首に赤い首輪をつけている\n半袖半ズボン（上は黄色、下は水色）\n体色は茶トラ（お腹と手足と尻尾の先は白）\n\n\n全体的なイメージ\n\n素直で甘え好きな男の子。ビビリ。\n\n\nキャラ名\n\nトラ\n\n※描いて頂いたイラストは作者明記の上Twitter及びpixivその他に掲載することがございます。\n\n何卒よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@huton_iinioi/works/31", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2998467, "client_id": 254612, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1ed3d7e/uploads/origins/013c3211-00cf-485d-b513-4627af79eae9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3aba4fe090096e63b4910a952d7bfc0c", "srcset": "https://si.imgix.net/f1ed3d7e/uploads/origins/013c3211-00cf-485d-b513-4627af79eae9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3aba4fe090096e63b4910a952d7bfc0c, https://si.imgix.net/f1ed3d7e/uploads/origins/013c3211-00cf-485d-b513-4627af79eae9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9677ebe9e0f801704e62a899c7efba45 2x, https://si.imgix.net/f1ed3d7e/uploads/origins/013c3211-00cf-485d-b513-4627af79eae9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00522e7eaed4992ab52a1cdac14aef79 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1ed3d7e/uploads/origins/013c3211-00cf-485d-b513-4627af79eae9?bg=%23fff&auto=format%2Ccompress&fm=