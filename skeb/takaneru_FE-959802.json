6f45/uploads/origins/bb51a472-1059-4ed4-b498-3b9d8464a279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e3046f934b0f01d2bf9f5c69f3ff16e, https://si.imgix.net/3e656f45/uploads/origins/bb51a472-1059-4ed4-b498-3b9d8464a279?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=095e869f525b6717f3a097555ba14eb6 2x, https://si.imgix.net/3e656f45/uploads/origins/bb51a472-1059-4ed4-b498-3b9d8464a279?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eeb693003c94e4eca456b9b9c072c428 3x"}, "body": "こんにちは！あなたの作品がとても好きなので、リクエストさせてください。\n\nファイアーエムブレム ヒーローズ」のシャレーナがシンクロナイズドスイミングをしているポーズを2つ描いてほしいです。\n\n1つ目はシャレーナが水中で笑顔でポーズをとっているポーズで、2つ目は水面から足だけ出しているポーズです。\n\nシャリーナの衣装は白とゴールドのワンピース水着。正確なパターンはお任せします（もし入れたいなら）。\n\n舞台はお城の庭のプール。\n\n支払いは推奨された金額でお願いします。低すぎると感じたら、私にアピールを送ってください。\n\nまた、シャレーナと両方のポーズの参考写真をリンクします。参考写真に写っている水しぶきを描く必要はありません。\n\nありがとうございました。\n\nhttps://imgur.com/a/sharena-request-9AAmFDk", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takaneru_FE/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1247702, "client_id": 1438382, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/817ecfff/uploads/origins/ccb8d8d9-da0a-4630-ba78-1343247510dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cc46fb2e80c0004cb5a019b339c641f", "srcset": "https://si.imgix.net/817ecfff/uploads/origins/ccb8d8d9-da0a-4630-ba78-1343247510dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cc46fb2e80c0004cb5a019b339c641f, https://si.imgix.net/817ecfff/uploads/origins/ccb8d8d9-da0a-4630-ba78-1343247510dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00a3116f1dfad111eb9118ceed985e13 2x, https://si.imgix.net/817ecfff/uploads/origins/ccb8d8d9-da0a-4630-ba78-1343247510dc?bg=%23fff&auto=format%2C