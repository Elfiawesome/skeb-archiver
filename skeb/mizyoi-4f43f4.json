ークのヘアピン\n・首元のチョーカーとブレスレット(羊飼いの杖)\n・目の色は青磁色\n・イメージカラーはマンダリンオレンジ(その他白や黒色)\n\nキャラクターのアイデンティティである羊の角とメガネは描いていただきたいのですが、アクセサリー等は省いて頂いても構いません。\n\n使用用途について\n・IRIAM配信のサムネイル、返礼品\n・ネットプリント\n・Xでの投稿\n\nイラストの上と左右が見切れないようにして頂けると嬉しいです。キャラクターとその他がレイヤー分けされたPSD(もしくはキャラクターのみ・背景のみのPNG)をいただけますと大変助かります。 \nご検討の程、よろしくお願い致します！\n\n泉ちやい\nhttps://x.com/tiyaizumi_0521/status/2023581505063449005?s=46", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mizyoi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3842208, "client_id": 1855314, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07d386ee/uploads/origins/54cdaf6f-df47-4dea-b3e2-8ef891c34c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1d9d140393b76804a2a7155631c6900", "srcset": "https://si.imgix.net/07d386ee/uploads/origins/54cdaf6f-df47-4dea-b3e2-8ef891c34c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1d9d140393b76804a2a7155631c6900, https://si.imgix.net/07d386ee/uploads/origins/54cdaf6f-df47-4dea-b3e2-8ef891c34c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2bae1f817b57740aa434fb3f8512dbcc 2x, https://si.imgix.net/07d386ee/uploads/origins/54cdaf6f-df47-4dea-b3e2-8ef891c34c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58be34f364025a8c7517b69ab1ed7a82 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/07d386ee/uploads/origins/54cdaf6f-df47-4dea-b3e2-8ef891c34c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ae58bb920981683afa98fa893bf4730", "srcset": "https://si.imgix.net/07d386ee/uploads/origins/54cdaf6f-df47-4dea-b3e2-8ef891c34c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ae58bb920981683afa98fa893bf4730, https://si.imgix.net/07d3