lur=200&s=7beb00593ad38af397b12b3d56fe5834 3x"}, "body": "初めまして、リクエストから失礼します。\n架界ヒカルさんの空気まで澄んで透き通るような綺麗なイラストが好きで今回リクエストを送らせて頂きました。何卒ご一読とご検討のほどよろしくお願い致します。\n\n■概要\n歌唱中の蒼星すいさんのお写真をお願いしたいです。柔和で朗らかな姿とのギャップで、中低音ボイスでクールにカッコよく歌い上げる姿をイメージしてます。髪は下ろして欲しいですが、その他衣装、構図(バストアップ・ウエスト・全身等々)、背景等はお任せでお願い致します。\n\n■使用途/備考\n・個人的なSNSへの投稿、アイコン等\n納品データは人物と背景をレイヤー分けしたPSDファイルをお願いしたく、また、もし可能であれば蒼星すいさんご本人の活動での使用許可を頂けますと幸いでございます。\n\nお忙しい中お手数お掛けしますが、ご縁がありましたら何卒よろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kasakai_hikaru/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1227631, "client_id": 797367, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c1b431f/uploads/origins/87cf3c35-2d8e-4398-8964-927208daa44d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=110d2b817627c54b44a2625674075e02", "srcset": "https://si.imgix.net/4c1b431f/uploads/origins/87cf3c35-2d8e-4398-8964-927208daa44d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=110d2b817627c54b44a2625674075e02, https://si.imgix.net/4c1b431f/uploads/origins/87cf3c35-2d8e-4398-8964-927208daa44d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75415d65199eb8da8d07fbe148ea7a77 2x, https://si.imgix.net/4c1b431f/uploads/origins/87cf3c35-2d8e-4398-8964-927208daa44d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a6e0fb381d7db01afc03c8a539c0b45 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c1b431f/uploads/origins/87cf3c35-2d8e-4398-8964-927208daa44d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b274619f3ec7b9f937e834f7fa88870", "srcset": "https://si.imgix.net/4c1b431f/uploads/origins/87cf3c35-2d8e-4398-8964-927208daa44d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&