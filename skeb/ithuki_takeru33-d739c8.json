1-40e8-a043-15d51543f88c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32c81f2838a36911ece4c5dc7a81166a", "srcset": "https://si.imgix.net/335b2d06/uploads/origins/8a0ebb04-3f11-40e8-a043-15d51543f88c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32c81f2838a36911ece4c5dc7a81166a, https://si.imgix.net/335b2d06/uploads/origins/8a0ebb04-3f11-40e8-a043-15d51543f88c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c4f71541afa8cf4ce3c862b267186bfa 2x, https://si.imgix.net/335b2d06/uploads/origins/8a0ebb04-3f11-40e8-a043-15d51543f88c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d5d0e0c2c48632eca21d2f04b3c1969 3x"}, "body": "また会ったね、タケルさん！\n最近どうですか？\n\n昨年は泉を描いてくれてありがとう！\nあれから、お母さんのお古のコートを使って、新しい服を手に入れました。\nこの新しい服は、前の服よりずっと屋外に出かけるのに適しています。\nまた描いていただけませんか？\n\n最近、彼女は繰り返し夢を見る。\nどこか聞き覚えのある声が彼女に呼びかけている。\n\nそれは、\"もう半分の人はもう見つかったの？\"と言っている。\n\nそれが何を意味しているのか、いづみにはわからない。\n\nもう半分を。\n\n「探し続けなければならない。あなただけが、二人を再び引き合わせることができる。\n\nそうして彼女は続ける。夕焼けに染まるなだらかな丘を越え、廃墟と化した城の塔や生い茂るジャングルを抜け、穏やかな海岸線に沿って。\n\n日々は週となり、週は月となる。熱心に探し続けても、イズミは自分がゴールに近づいていないことを自覚している。\n\n「あなたでなければならなかったことが残念です」とその声は嘆く。「私がもっと強ければ...。私がもっと強かったら......こんな思いをさせなくて済んだのに......」。\n\n和泉が目を覚ますのは大体この頃で、声にそれ以上の導きを求めることもできず、夢という儚いもののため、大抵は1時間以内に忘れてしまう。\nできれば、そんな光景を写真に収めたい。\n\n前回同様、自由に描いていただいて構いませんが、いづみさんのサファイアのネックレスとブレスレットはキーアイテムなので外せません。\nお忙しい中、本当にありがとうございました！\n\nhttps://imgur.com/a/izumi-ushio-character-reference-version-2-pFJMlZZ", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ithuki_takeru33/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3168991, "client_id": 491931, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c71da5bc/uploads/origins/faa96db0-2c68-4f5f-bd46-cc775fd9ed05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=20