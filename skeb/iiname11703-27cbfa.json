4d85-a245-17f63bb6793c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=051d30f132e253278c02e97d261c7847", "srcset": "https://si.imgix.net/1c242b90/uploads/origins/d77de0a5-631f-4d85-a245-17f63bb6793c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=051d30f132e253278c02e97d261c7847, https://si.imgix.net/1c242b90/uploads/origins/d77de0a5-631f-4d85-a245-17f63bb6793c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a5577f0bd6f58360473429d6452d1cc8 2x, https://si.imgix.net/1c242b90/uploads/origins/d77de0a5-631f-4d85-a245-17f63bb6793c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bc394953fc81dbbde727588d9ee544f0 3x"}, "body": "初めまして！リクエスト失礼いたします！\n今回、テールナーとベトへドンを使った以下のシチュエーションのイラストをお願いしたく、リクエストさせていただきました。\n\n■キャラクター\n・テールナー\n・ベトへドン\n\n■希望シチュエーション概要\nテールナーがベトベトしたベトへドンにまとわりつかれ、そのまま全身を包み込まれるように固められてしまうシチュエーションを希望しています。\n\nベトへドンの体がテールナーに絡みつき、徐々に全身を覆っていった末に、身動きが取れなくなってしまっているようなイメージです。\n\n■詳細\n・テールナーのポーズは「気をつけ」のような姿勢を基本として、両腕と両脚を揃えた状態のまま固められている感じでお願いします。\n\n・固めの質感については、ラバー拘束のように体にぴったり密着し、テールナーのボディラインが出やすい感じを希望しています。\n表面はなめらかで少し艶があり、全身を包み込むように覆われつつも、その下の体型やシルエットがわかるような表現だと嬉しいです。\n色はベトへドンらしい紫色を基調にしていただきたいです。\n\n・また、ベトへドンや固められたテールナーの周囲には、強烈な悪臭が漂っていることが分かるような、紫色の臭そうなモヤも描いていただけると嬉しいです。\n\n・テールナーの表情については、顔がまだ外に出ている状態では、単純に苦しそうというよりも「ベトへドンの強烈な悪臭に耐えきれず悶えている」ような表情を希望しています。\n涙目になっているなど、かなり臭いに参っていることが伝わる表情だと嬉しいです！\n\n・固めの内部に顔がある場合は、目を開いたまま口を小さく縦に開けているような表情を希望しています。\n\n■差分\n可能であれば、以下の4種類をお願いしたいです。\n\n①顔出し差分\n首から下はほぼ完全に紫色の固めで覆われているものの、顔全体だけは外に出ている状態です。\nテールナーが悪臭に耐えきれず、涙目になりながら悶えている表情がしっかり見えるような感じを希望しています。\n\n②鼻先だけ出ている差分\n固めがさらに上まで進み、顔もほぼ完全に覆われている状態です。\nテールナーの顔のうち、鼻先の赤い部分だけが固めの外に出ているような状態を希望しています。\nこの差分では、①の顔出し差分よりもさらに苦悶の強い表情にしていただけると嬉しいです。\n顔の大部分が隠れている分、口を大きく開けて悶えている感じが伝わるような表現を希望しています。\n\n③完全に覆われた差分\n頭から足先まで、テールナーの全身が紫色の固めによって完全に覆われている状態です。\nテールナー自身の体は外から直接見えませんが、固めの表面にはテールナーらしい体型やシルエット、ボディラインがある程度浮き出ているような表現だと嬉しいです。\n\n④内部透過差分\n③の「完全に覆われた差分」をベースに、固めの内部にあるテールナーの顔部分だけが透けて見えるような差分を希望しています。\n\n全身を透過させる必要はなく、顔の部分だけ中の様子が分かるような表現で大丈夫です。\n内部のテールナーは、目を開いて口を小さく縦に開けている表情だと嬉しいです！\n\n■その他\n固められた状態でも、テールナーらしい体型やシルエットがある程度分かるようにしていただけると嬉しいです。\n\nベトへドンのまとわりつき方や細かな構図、固めの表面表現などについては、上記のイメージを大きく外れない範囲で、描きやすいようにアレンジしていただいて問題ありません！\n\n注文が多くなってしまい申し訳ありません。\nSkebでのリクエストにもまだあまり慣れていないため、文章に不備や不足などがありましたら申し訳ありません。\n\nフェチ寄りの内容にはなりますが、可能な範囲で描いていただけましたらとても嬉しいです！\n\nよろしくお願いいたします！\n\n参考イラスト（他の方の作品です）\nこちらは他の方が制作された作品になります。\n固めの質感や、ラバー拘束のような密着感・ボディラインの出方などの参考として共有しております。\n\nhttps://drive.google.com/drive/folders/1j3SbG6nX8YOpUDejbMLGNuCS7_FVMLae?usp=sharing", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@iiname11703/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3492621, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e5fb8f5c/uploads/origins/77f965f4-0759-4394-8b4b-596f45d125f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fddb0c503990428d1169651a9de7562", "srcset": "https://si.imgix.net/e5fb8f5c/uploads/origins/77f965f4-0759-4394-8b4b-596f45d125f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fddb0c503990428d1169651a9de7562, https://si.imgix.net/e5fb8f5c/uploads/origins/77f965f4-0759-4394-8b4b-596f45d125f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d03fc1414f941372d8b626e4d1d94e0 2x, https://si.imgix.net/e5fb8f5c/uploads/origins/77f965f4-0759-4394-8b4b-596f45d125f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fccb65e4c967ad4067bb130405173c7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e5fb8f5c/uploads/origins/77f965f4-0759-4394-8b4b-596f45d125f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59b7c4b2096e1594a85dc6c6fcb2a15c", "srcset": "https://si.imgix.net/e