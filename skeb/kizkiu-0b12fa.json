触れられる事に強い恐怖感、抵抗感を持つ。\n手先が器用で、料理が唯一の趣味。\n動物、特に狸が好きでLINEのアイコンにしている。\n綺麗好きかつ、お風呂に入るのが好きな為、1日に最低2回は入る。\n寒さに強く暑さに弱い為、冬の夜が好きで、夏の昼が苦手。\n夢は子供を産んでお母さんになる事と、小さくて良いので自分の料理の店を持つ事。\n\n・イメージ\n\nアイコンを希望します。\n髪型は資料URL01.05、衣装は資料URL00参考でお願いします。\nその他、表情等、お任せします！\n\n※サイン、線画、塗り、ラフ等が別々のレイヤーになっているPSDを可能であればお願いします。\n※資料URLの他、納品されているイラストもご参考下さい。\n\n以上、ヨロシクお願いします！\n\nhttps://x.gd/7E3Pi", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kizkiu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1196053, "client_id": 476844, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c8ceb04/uploads/origins/7e4c5404-748b-4ab5-9a43-dbadf96be965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de6ad7afa9fe90cbc258cc14ba1e60a3", "srcset": "https://si.imgix.net/1c8ceb04/uploads/origins/7e4c5404-748b-4ab5-9a43-dbadf96be965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de6ad7afa9fe90cbc258cc14ba1e60a3, https://si.imgix.net/1c8ceb04/uploads/origins/7e4c5404-748b-4ab5-9a43-dbadf96be965?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83cdf8f5677a741a9fc911a51b04e83f 2x, https://si.imgix.net/1c8ceb04/uploads/origins/7e4c5404-748b-4ab5-9a43-dbadf96be965?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee25dce8606020546af6c4cfb6f130ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c8ceb04/uploads/origins/7e4c5404-748b-4ab5-9a43-dbadf96be965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd4bf607c2b6f015382d85734f20e448", "srcset": "https://si.imgix.net/1c8ceb04/uploads/origins/7e4c5404-748b-4ab5-9a43-dbadf96be965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd4bf607c2b6f015382d85734f20e448, https://si.imgix.net/1c8ceb04/uploa