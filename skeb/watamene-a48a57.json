oodborneの世界観と同じように、全体的に灰色で、片方から月明かりがエルサを照らしているような照明や暗い雰囲気も希望します。\n\n全体的に暗く、落ち着いた雰囲気であることが望ましいです。\n\nエルザ\nhttps://drive.google.com/drive/folders/1CJkaMqpUA3Bi-yKdedhKC3HLzv0bwGgh?usp=share_link\n\nブラッドボーン人形\nhttps://imgur.com/a/sF4ZCBw\n\nご検討ありがとうございました。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@watamene/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1323670, "client_id": 1983764, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d856edfc/uploads/origins/1ec2a832-b548-4b5f-bd32-f4fb6a06fb00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63d3cf281e782cac099e13296fb42477", "srcset": "https://si.imgix.net/d856edfc/uploads/origins/1ec2a832-b548-4b5f-bd32-f4fb6a06fb00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63d3cf281e782cac099e13296fb42477, https://si.imgix.net/d856edfc/uploads/origins/1ec2a832-b548-4b5f-bd32-f4fb6a06fb00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c37ea1cc72da279a3bcdc96bb33fd2da 2x, https://si.imgix.net/d856edfc/uploads/origins/1ec2a832-b548-4b5f-bd32-f4fb6a06fb00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81418f4d986fc11edbdde9f3c6039ef8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d856edfc/uploads/origins/1ec2a832-b548-4b5f-bd32-f4fb6a06fb00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a538c8ceda2853fd72ae8f2c0b277946", "srcset": "https://si.imgix.net/d856edfc/uploads/origins/1ec2a832-b548-4b5f-bd32-f4fb6a06fb00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a538c8ceda2853fd72ae8f2c0b277946, https://si.imgix.net/d856edfc/uploads/origins/1ec2a832-b548-4b5f-bd32-f4fb6a06fb00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cro