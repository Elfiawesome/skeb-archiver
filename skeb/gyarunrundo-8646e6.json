duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95f41619/uploads/origins/28cfcf8c-c048-4647-a568-0d8dfb9cd4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=186644a4d6e518578c6ce7c8e69635a9", "srcset": "https://si.imgix.net/95f41619/uploads/origins/28cfcf8c-c048-4647-a568-0d8dfb9cd4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=186644a4d6e518578c6ce7c8e69635a9, https://si.imgix.net/95f41619/uploads/origins/28cfcf8c-c048-4647-a568-0d8dfb9cd4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d0210a60a933dc3f1fb60f1d680aa3d 2x, https://si.imgix.net/95f41619/uploads/origins/28cfcf8c-c048-4647-a568-0d8dfb9cd4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93195d5d00e7c2d97b75dccdb0c5e095 3x"}, "body": "ギャランマンジェ先生、はじめまして。\n\nRPG不動産に登場する風色琴音ちゃんが寝室で発情してしまい、他の人がいない時に素っ裸の格好で自分のおっぱいを自分で吸いながらスライムとエッチしてしまう絵をリクエストしてもよろしいでしょうか？\n\n希望する主な要素と内容は・・・\n・風色琴音ちゃんは素っ裸の格好でスライムと正常位セックス\n・スライムはオムツのように琴音ちゃんのヒップとアソコ辺りを覆っている\n・片方の手で自分のおっぱいを自分の口元まで寄せて、自分の乳首を丸ごと咥えながら気持ちよさそうにセルフ乳吸い\n・もう片方の手で乳首を露出させながら余ったおっぱいをイヤらしく揉む\n・体は汗まみれで、胸には唾液が垂れている\n・エッチが気持ち良すぎて涙目、または涙を流している\n\nシチュエーションに合ったエッチな擬音や台詞も入れていただけるととても嬉しいです。\n\n彼女がイッちゃう差分もあると嬉しいですけど、負担になるようでしたら無くても結構です。\n\n可能でしたら、psd内で台詞や擬音のオンオフも出来ると最高です。\n\nご検討のほどよろしくお願い致します。\n\n\n参考URL:\n風色琴音\nbit.ly/3HgS08C\nbit.ly/40cLVm1\n\nスライム\nbit.ly/3Jqu8Sy\nbit.ly/3Y4J3G3\nbit.ly/3Rddc3V\n\nスライム姦\nbit.ly/3WNyiaj\n\nセルフ乳吸い\nbit.ly/3rrLd56\nbit.ly/3ursPLC\nbit.ly/3sbPrwY\nbit.ly/3gsVzvn\nbit.ly/3z4bLvT", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gyarunrundo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 570850, "client_id": 93103, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d50fec70/uploads/origins/f066ed53-012d-4911-84cf-718add52cab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c7d6193694e2a0763b6d728a4389a6b", "srcset": "https://si.imgix.net/d50fec70/uploads/origins/f066ed53-012d-4911-84cf-718add52cab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c7d6193694e2a0763b6d728a4389a6b, https://si.imgix.net/d50fec70/uploads/origins/f066ed53-012d-4911-84cf-718add52cab9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea1200030ee74dea0e3feea1e8ab0bfa 2x, https://si.imgix.net/d50fec70/uploads/origins/f066ed53-012d-4911-84cf-718add52cab9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f641367dab2a44aeb8fdf3becfa1478 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d50fec70/uploads/origins/f066ed53-012d-4911-84cf-718add52cab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b7cdf25a1bb274ca0aee3cea83e371a", "srcset": "https://si.imgix.net/d50fec70/uploads/origins/f066ed53-012d-4911-84cf-718add52cab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b7cdf25a1bb274ca0aee3cea83e371a, https://si.imgix.net/d50fec70/uploads/origins/f066ed53-012d-4911-84cf-718add52cab9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd960b23b79952de4d101b9d94850d05 2x, https://si.imgix.net/d50fec70/uploads/origins/f066ed53-012d-4911-84cf-718add52cab9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=30908b622330b172113030810068479a 3x"}, "body": "初めまして！\n以前先生が描かれていた琴音ちゃんのイラストがきっかけでフォロー＆日頃より目の保養をさせていただいております。\n\n自分も先生の描かれていた琴音ちゃんがあまりにもエロ可愛すぎて頭から離れないので、リクエストの方をお送りさせていただきます。\n宜しければお目通しいただけますと有り難いです。\n\n\nシチュエーション内容\nRPG不動産より風色琴音ちゃんが水着姿で背後から胸を揉まれまくる\n\n\n琴音\n・アニメ5話の水着姿\n・先生が以前描かれていたイラストと同等、もしくは若干盛ったバストサイズ\n・帽子と首元の鍵は外していただいて構いません\n・羞恥の表情(目は開いている状態)\n・揉まれて肩や太もも等身体の至る所がビクッと反応\n・「いっぱい揉んでください…♥」と胸への愛撫を求める台詞の添付\n・♥マーク入り喘ぎ声や擬音の描き文字添付もお願い致します\n・自身の胸を揉む絡み相手の両手を掴む\n※こちら(https://skeb.jp/@maco_tie/works/6)のようなイメージで\n\n\n絡み相手\n・背後から琴音の両胸を水着の上から胸の中心を鷲掴むように揉みまくる\n・琴音の頬を舐め回す(白い唾液が付着)\n・髪型や表情は要らず最低限人間と認識出来る程度の描き込みで構いません\n\n\n以上の内容でお願い致します。\nご多忙の折、大変恐縮ではありますがご検討いただけますと幸いです。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gyarunrundo/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/54ac4938/uploads/origins/a4f5745b-5be9-4e6a-a818-ed85fcf41d59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b83e72247c8fdd6c289054368bb8e96a", "srcset": "https://si.imgix.net/54ac4938/uploads/origins/a4f5745b-5be9-4e6a-a818-ed85fcf41d59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b83e72247c8fdd6c289054368bb8e96a, https://si.imgix.net/54ac4938/uploads/origins/a4f5745b-5be9-4e6a-a818-ed85fcf41d59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a5e8242860e5ed3c8cd6b5e92203ace 2x, https://si.imgix.net/54ac4938/uploads/origins/a4f5745b-5be9-4e6a-a818-ed85fcf41d59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36b06e1d1ec8f107f41a1f1ee1a7ad9c 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 570850, "nc": 32}, {"path": "/@gyarunrundo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 570850, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c871f5e/uploads/origins/dcbcaeaa-75fd-4ebd-bd13-307cdcab05f7?bg=%23fff&auto=format