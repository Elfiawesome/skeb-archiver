NS、配信アプリでのアイコン、ヘッダー使用\n・配信アプリでのサムネイル使用等\n  【微睡まどろについて】 \n・食べること、寝ることが大好き \n・顔周りにレイヤーが入ったロングヘア\n・横ではねている髪\n・淡いピンク色の髪で、毛先へ行くにつれて銀髪\n・口元のほくろと八重歯がチャームポイント \n・つり目、ジト目で深い紫の瞳\n・目のハイライトは少なめ\n・少し下がり眉 \n・太ももはややむっちりめ  \nもしご不明点や金額不足などございましたら、お手数ですが再送いただけますと幸いです。 参考資料を下記URLにまとめておりますので、併せてご確認いただければと思います。  どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1juSMvN0RKHZ--DioloCX_6MJpt84tyra", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@xuxj9z/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3924236, "client_id": 3851050, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2ebe301/uploads/origins/b4b868a6-347b-4b85-ab3b-eedc3921ee00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4012e4f272419474ec195b2f7e670f3", "srcset": "https://si.imgix.net/b2ebe301/uploads/origins/b4b868a6-347b-4b85-ab3b-eedc3921ee00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4012e4f272419474ec195b2f7e670f3, https://si.imgix.net/b2ebe301/uploads/origins/b4b868a6-347b-4b85-ab3b-eedc3921ee00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f7700196f426a2744dd3b500ae6031e 2x, https://si.imgix.net/b2ebe301/uploads/origins/b4b868a6-347b-4b85-ab3b-eedc3921ee00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00668cca260a92a19197eddcc846d9a1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2ebe301/uploads/origins/b4b868a6-347b-4b85-ab3b-eedc3921ee00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eaded09279aca85eade3ef55f1188933", "srcset": "https://si.imgix.net/b2ebe301/uploads/origins/b4b868a6-347b-4b85-ab3b-eedc3921ee00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eaded09279aca85eade3ef55f1188933, https://si.im