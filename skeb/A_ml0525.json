n\nゲームスプライト:\n\nhttps://drive.google.com/drive/folders/1YHfM2F1Ky90Yz83b5bRUSnX_l4LGqeEK\n\n-\n\nhttps://drive.google.com/drive/folders/12eMzk7l84MDdzd3wPB23Kc1f04_yXcoH\n\n他に具体的なアイデアがあるわけではないので、差し支えなければお任せしたい。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@A_ml0525/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3425141, "client_id": 2291853, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4c6ed7e/uploads/origins/4ccf3614-1f77-444a-99a9-fc8f154cb8c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33e73a2acc4ab19a6ba945c95c361c80", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4c6ed7e/uploads/origins/4ccf3614-1f77-444a-99a9-fc8f154cb8c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d12d88c55590fd654c49044ec39e3114", "src_set": ""}, "body": "はじめまして、前回の依頼がとても良かったので、今回もお願いしたいと思います。\n添付のキャラクターで、憧れのミルカラの服を着て描いてほしいです。\nおまけとして、尻尾と義手をアブノーマルの手足やとげとげのつるを模したものに変えてほしいです。\nそれが面倒なら、尻尾は捨てて、腕は普通にしてください。\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1XpvEJrFeI0Q0uuqkEX1wb0is2dXrahle", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@A_ml0525/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3425141, "client_id": 3182797, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1f16d81/uploads/origins/681b22ca-f1b0-4cac-9e64-82a689758e13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a5dc3078970d9cef696fad56abe3a67", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1f16d81/uploads/origins/681b22ca-f1b0-4cac-9e64-82a689758e13?bg=%23fff&auto=format%2C