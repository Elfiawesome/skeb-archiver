添付のキャラクターで、憧れのミルカラの服を着て描いてほしいです。\nおまけとして、尻尾と義手をアブノーマルの手足やとげとげのつるを模したものに変えてほしいです。\nそれが面倒なら、尻尾は捨てて、腕は普通にしてください。\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1XpvEJrFeI0Q0uuqkEX1wb0is2dXrahle", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@A_ml0525/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3425141, "client_id": 3182797, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1f16d81/uploads/origins/681b22ca-f1b0-4cac-9e64-82a689758e13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a5dc3078970d9cef696fad56abe3a67", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1f16d81/uploads/origins/681b22ca-f1b0-4cac-9e64-82a689758e13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=845ef38e78626d8fafc4c1a2659aa0a7", "src_set": ""}, "body": "こんにちは、Aさん！またまた私です！前回描いていただいた絵がとても気に入ったので、またリクエストさせていただきます。\n\nヴェルギリウスと私のOCをまた描いてほしいです。二人がハグしているところを描いてほしいです！できればこんな感じでお願いします：\nhttps://drive.google.com/file/d/1eTES5zrXir9wRfq7pDx-XCYihwJpfTmg/view?usp=sharing\n\n参考文献のリンクはこちら：https://drive.google.com/drive/folders/1zrfsqHcH8xjyc9OF7YFHMZzr7BhPCNOX?usp=drive_link\n\nありがとうございました！💖", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@A_ml0525/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3425141, "client_id": 2291853, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a5169c7/uploads/origins/d63ec054-fbd4-4631-883f-24fa22d1935b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4529800cbebfd573ffd30ae95b308b9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a5169