をやっております、マーク・アイと申します。\nこの度、Skebを拝見しており、アークナイツのイラストがとても素敵だったのでリクエストさせて頂きました。\n\n依頼内容と致しましては、私と友人のアンデッド初瀬さんのイラストを描いて頂きたいです。（依頼の許可は頂いております。）\nポーズは、2人でスマホを見ている何かを探しているポーズでお願いしたいのですが、\nつながっているイラストですが別々でも完結しているイラストだと嬉しいです。\n\nまた、下記の活動で使用させて頂きたいので、髪の毛や服をはみ出ずに描いて頂けるとととても助かります。\n・SNSでのアイコン、ヘッダー、投稿\n・YouTubeのサムネ、配信画面　等\n\nデータはPSDで頂けますと幸いです。\n（背景の透過が可能でしたら透過を行ったイラストも頂けますと幸いです。）\n\n宜しくお願い致します。\n\n■参考\nhttps://twitter.com/markeyeisme\nhttps://twitter.com/paseriru", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@86_cnsnt/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 823475, "client_id": 2422412, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51fd7438/uploads/origins/dde006a3-1f8c-417b-a318-62ed06f0443c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c892d05e7d7c043e97d0cfb4907bf18", "srcset": "https://si.imgix.net/51fd7438/uploads/origins/dde006a3-1f8c-417b-a318-62ed06f0443c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c892d05e7d7c043e97d0cfb4907bf18, https://si.imgix.net/51fd7438/uploads/origins/dde006a3-1f8c-417b-a318-62ed06f0443c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d48e6c15e3f8ebf06e9ca5f2969f57bf 2x, https://si.imgix.net/51fd7438/uploads/origins/dde006a3-1f8c-417b-a318-62ed06f0443c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cec32027271859743cd27efb43744efa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51fd7438/uploads/origins/dde006a3-1f8c-417b-a318-62ed06f0443c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a3a129a8a1aac31b09dec9b550188a5", "srcset": "https://si.imgix.net/51fd7438/uploads/origins/dde006a3-1f8c-417b-a318-62ed06f0443c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top