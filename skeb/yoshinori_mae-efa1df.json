人物・背景等を分けたPNGデータでお願いいたします。\nサムネイル等で使用させていただきたいので、ツノや髪の毛左右が切れてない構図だと嬉しいです！\n\n\n使用用途に問題なければリクエストを受けて頂けると嬉しいです！\nお忙しいところ恐縮ですが、何卒よろしくお願いいたします。\n\n龍城りゅか(@Tatsuki_Ryuka)\n\nhttps://twitter.com/Tatsuki_Ryuka/status/1642446105622515713?s=20", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yoshinori_mae/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2108134, "client_id": 951419, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd4df8de/uploads/origins/ec9d1203-b604-4248-a097-bde964678c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06adb532f85fe9586ea5e4628fa5f758", "srcset": "https://si.imgix.net/fd4df8de/uploads/origins/ec9d1203-b604-4248-a097-bde964678c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06adb532f85fe9586ea5e4628fa5f758, https://si.imgix.net/fd4df8de/uploads/origins/ec9d1203-b604-4248-a097-bde964678c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=597156e7f22ead8dc789254316d8e1b2 2x, https://si.imgix.net/fd4df8de/uploads/origins/ec9d1203-b604-4248-a097-bde964678c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf8f68bb03e9ace747446e771b92cc20 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd4df8de/uploads/origins/ec9d1203-b604-4248-a097-bde964678c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01a76b9cb162e31f8b911bf2a0b90fcd", "srcset": "https://si.imgix.net/fd4df8de/uploads/origins/ec9d1203-b604-4248-a097-bde964678c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01a76b9cb162e31f8b911bf2a0b90fcd, https://si.imgix.net/fd4df8de/uploads/origins/ec9d1203-b604-4248-a097-bde964678c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=2