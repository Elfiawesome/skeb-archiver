も大丈夫です\n･しっぽは上向きです\n･トリケラトプスの女の子です\n\n構図について\nおまかせいたします。\n\n使用用途\n下記のような配信活動にて使用させていただきたいと考えております。\nXやTwitchのアイコンやヘッダーへの使用\nXでのポスト(おはツイやお知らせ画像での使用)\n(検討中:Twitch(収益化済み)の配信画面に表示)\n\nその他について\n･頭や肩など、端が見切れていない構図にしていただけますと嬉しいです。\n･可能でしたら人物と背景を分けたデータ、人物背景透過の差分データでいただけますと幸いです。\n･元気でかわいい雰囲気です\n\n何卒ご検討のほどをよろしくお願い申し上げます。\n\nhttps://drive.google.com/file/d/1nvJQuAEuCqQASSDo61Ha6qmBWyggZH8x/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@72komusubi/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/592b4c1d/uploads/origins/1c47dc47-10be-4da5-899e-26cb896d75a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c9d66fcbd64de188847def871b2185e", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2928622, "client_id": 2671616, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@72komusubi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2928622, "client_id": 227300, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ebf46fa/uploads/origins/c2eb0b3c-8c50-4746-81f5-f404548571ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e47886b383b3f96d4d0b2a8570133cff", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ebf46fa/uploads/origins/c2eb0b3c-8c50-4746-81f5-f404548571ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25d88581d46d8d210295240a836ed8ab", "src_set": ""}, "body": "初めまして、るげつぺぽと申します。\n以前よりツイッターで素敵な絵を拝見させていただいております。\n新アカウントで投稿されてい