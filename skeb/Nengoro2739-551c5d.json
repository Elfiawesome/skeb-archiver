0df7\nhttps://note.com/raysolstice/n/n8f9f8e4637b1\nhttps://twitter.com/RaySolstice/status/1456892869415870465\nhttps://twitter.com/RaySolstice/status/1456892513399164929\nhttps://twitter.com/RaySolstice/status/1456892189133271042\nhttps://twitter.com/RaySolstice/status/1388077835798069248\n✅細面\n✅ポニテ(編みほぐし少し\n✅髪色アッシュブラウン　中灰色から少し橙色寄り　柔らか透明感\n✅ほんの気持ちすこーしツリ目\n✅眉太さは気持ち少し太め、角度は気持ちすこーしキリっと(表情のほうは固くなく)\n✅虹彩はプリズムのグラデーション\n✅右涙ぼくろ\n✅右こめかみに青色に発光するLEDリング　\n✅左のデコルテとバストの間あたりに2連のほくろ\n✅身長162cm\n✅キーワード　夏至・冬至・夜明け・朝焼け・朝の光・水平線\n✅もし全身の場合には、コーデはフェミニン寄りのコンサバ\n\nと、人物の細かい設定は以上なのですが、シルエットになって上記が判別できなくても全然かまいません！\nNengoro先生の書きやすいシチュエーション・アングル・ライティングでお願いします！\nそのすてきな風景の一部に融けられたら無上の喜びです。\nなにとぞ、よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nengoro2739/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2190480, "client_id": 346464, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d243d28/uploads/origins/606dc440-e713-465f-bcd8-e7f90ceaf8a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=393c362ca653492ba9ff6f0a4c08e854", "srcset": "https://si.imgix.net/6d243d28/uploads/origins/606dc440-e713-465f-bcd8-e7f90ceaf8a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=393c362ca653492ba9ff6f0a4c08e854, https://si.imgix.net/6d243d28/uploads/origins/606dc440-e713-465f-bcd8-e7f90ceaf8a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98e7aa1886bcb1ed9515525c2945dd95 2x, https://si.imgix.net/6d243d28/uploads/origins/606dc440-e713-465f-bcd8-e7f90ceaf8a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=534c3bb1080525417e45240d70005a85 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d243d28/uploads/origins/606dc440-e713-465f-bcd8-e7f90ceaf8a3?bg=%23fff&auto=format%2Ccompress&fm