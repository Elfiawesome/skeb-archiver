": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wksg240015/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3254958, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1ebcbfd/uploads/origins/96ea5626-b03b-4a55-8789-be183edf466b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af442204e37a3f3edfd18065b39c434a", "srcset": "https://si.imgix.net/a1ebcbfd/uploads/origins/96ea5626-b03b-4a55-8789-be183edf466b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af442204e37a3f3edfd18065b39c434a, https://si.imgix.net/a1ebcbfd/uploads/origins/96ea5626-b03b-4a55-8789-be183edf466b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd93c1d179159ff4bd4e919f202c37df 2x, https://si.imgix.net/a1ebcbfd/uploads/origins/96ea5626-b03b-4a55-8789-be183edf466b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0223b902385a9c12147d9a5f3ba29c4d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1ebcbfd/uploads/origins/96ea5626-b03b-4a55-8789-be183edf466b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69265effbd7ae22f46640605f882a99f", "srcset": "https://si.imgix.net/a1ebcbfd/uploads/origins/96ea5626-b03b-4a55-8789-be183edf466b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69265effbd7ae22f46640605f882a99f, https://si.imgix.net/a1ebcbfd/uploads/origins/96ea5626-b03b-4a55-8789-be183edf466b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4ba75e99071a9615b52722ef6b921858 2x, https://si.imgix.net/a1ebcbfd/uploads/origins/96ea5626-b03b-4a55-8789-be183edf466b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ef524063f834c7e1b3fdb422634546e9 3x"}, "body": "はじめまして！私のTRPGキャラクターとその相棒を描いていただけないでしょうか？\n二人は未来の警察官とその相棒アンドロイドで、犬猿の仲です。\n\n私のキャラ\n警察官。生真面目で正義感が強い性格。古風な喋り方と古風な考え方をするため、やや世間ずれしてるところがある。日本刀の使い手。突っかかってくる相棒と口喧嘩になることが多いが、相棒とは友達になりたいと思っている。クソデカ感情には気づいていない。メガネは伊達。無知故に悪気なく相棒を傷つけることが多い。\n\n相棒キャラ\nアンドロイド。やや斜に構えた性格で、常に冷静。ズバッと物事を言うタイプ。敬語毒舌薄笑いキャラ。アンドロイドらしく合理的でロジカルな考え方をする。相棒に口喧嘩をふっかけるし、口喧嘩が強い。相棒にクソデカ感情を抱いていて、自分をモノとして扱ってほしいので、友達とは思えないから友達になることを拒否している。自己肯定感が低い。\n\n関係性\n普段は私のキャラが言ったことに相棒キャラが突っかかって来るので口論になることが多いです。私のキャラは友達になろうと真っ直ぐいいますが、相棒キャラは無視したり、「あなたのことを〝友達〟とは思えない」と言っています。これは相棒キャラは自分はモノとして扱ってほしいし、モノには愛着を持たず捨てられたいという存在意義によるものです。\n私のキャラは相棒キャラのことを全く理解しておらず、話せば分かり合えると思っていますが、相棒キャラは話すことを拒否していて、「わからないままでいてほしいですよ。そうじゃなきゃ報われないから」と言ってます。\n私のキャラが命をなげうって相棒キャラを救おうとしたとき、相棒キャラは優しい笑顔で詰め寄って今度そんなことをしたら首をへし折ると首を締めたことがあります。首を締められたあとは呆然と彼の後ろ姿を見送りました。\n\nふたりの関係性のような、闇を感じる絵にして頂けたら嬉しいです。軽く首を締めてるポーズだと嬉しいですが、WKSG様の描きやすいもので大丈夫です。\n詳細背景ありの絵でお願いします。\n服は通常と和服どちらでも構いません。\nもし金額が足りなければ再送して頂けたら嬉しいです！\n\nhttps://drive.google.com/drive/folders/1mYhgvucMMA38ynKhxaXCVMDLXlh_QuxR?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wksg240015/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/22b8f9e4/uploads/origins/1401a46d-10bc-4cde-b505-5b637afd1fc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce6bc8bed3d892a9953d956afd015762", "srcset": "https://si.imgix.net/22b8f9e4/uploads/origins/1401a46d-10bc-4cde-b505-5b637afd1fc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce6bc8bed3d892a9953d956afd015762, https://si.imgix.net/22b8f9e4/uploads/origins/1401a46d-10bc-4cde-b505-5b637afd1fc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ec