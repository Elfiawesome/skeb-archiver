-b106-df4ba14c53d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8f06279f9f01973535a850b78ab5eb7 2x, https://si.imgix.net/8070f6d0/uploads/origins/ab90f168-e233-459c-b106-df4ba14c53d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50097a9ff19c4784cb32bcb704206cf9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8070f6d0/uploads/origins/ab90f168-e233-459c-b106-df4ba14c53d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b00d593d60d19a3ba6c2a59cfa6e1d5", "srcset": "https://si.imgix.net/8070f6d0/uploads/origins/ab90f168-e233-459c-b106-df4ba14c53d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b00d593d60d19a3ba6c2a59cfa6e1d5, https://si.imgix.net/8070f6d0/uploads/origins/ab90f168-e233-459c-b106-df4ba14c53d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8900abf2a878b6fdef2d0a65c1a815ad 2x, https://si.imgix.net/8070f6d0/uploads/origins/ab90f168-e233-459c-b106-df4ba14c53d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=469837ffb3f949c48e6732556cc7ba52 3x"}, "body": "先生 はじめまして\n今回依頼したいキャラはセントルイスです\n\nセントルイスの水着姿を見て\nショタ指揮官のちっちゃい包茎チンボが勃起して\nセントルイスはそれに気付き\n前屈みの姿勢で 親指と人差し指で\n優しくシコシコしてくれた\n\nセントルイスにいじめられ\n目の前の長~~い谷間 \nそしてはみ出てる乳輪と丸見え乳首\n全部の刺激により\n指揮官のちっちゃいチンボはおもらし射精した\nちょっと顔に出ちゃったが\nセントルイスは微笑んで受け入れました\n\n背景は描かなくていいです\n\nシコシコと射精は差分で描いて頂けると幸いです！\n\n水着の参考資料はこちら:https://www.goodsmile.com/zh/product/1136143/%E8%81%96%E8%B7%AF%E6%98%93%E6%96%AF+%E6%B3%B3%E8%A3%9DVer.", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cc15915R/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2521676, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67b0104e/uploads/origins/4e644495-f8ec-46e4-96d4-9461335089b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abe0e51a76fab035a02fec14c62f9652", "srcset": "https://si.imgix.net/67b0104e/uploads/origins/4e644495-f8ec-46e4-96d4-9461335089b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abe0e51a76fab035a02fec14c62f9652, https://si.imgix.net/67b0104e/uploads/origins/4e644495-f8ec-46e4-96d4-9461335089b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be682cf7e3f510e918568adb3eff1a8b 2x, https://si.imgix.net/67b0104e/uploads/origins/4e644495-f8ec-46e4-96d4-9461335089b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4f39d30d72a1163e7d44b9e6f538ee0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67b0104e/uploads/origins/4e644495-f8ec-46e4-96d4-9461335089b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2921af7ea173b639051d4518e5f95c2", "srcset": "https://si.imgix.net/67b0104e/uploads/origins/4e644495-f8ec-46e4-96d4-9461335089b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2921af7ea173b639051d4518e5f95c2, https://si.imgix.net/67b0104e/uploads/origins/4e644495-f8ec-46e4-96d4-9461335089b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=173905ca76cc810d371801cae9435ac4 2x, https://si.imgix.net/67b0104e/uploads/origins/4e644495-f8ec-46e4-96d4-9461335089b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b1f607d2be6a9c96be361c2356b7d070 3x"}, "body": "rkさま、リクエストします。\n\nアズールレーンのネルソン・改（https://x.com/azurlane_staff/status/1660598901085466624）\nを描いてください。\n\n彼女には同作品の「ネレウス・デスカバリー」の衣装を着させてください。\nネレウス・デスカバリー：https://x.com/azurlane_staff/status/1305686734278025216\n\n高貴、高飛車でプライドの高い貴族のようなネルソンに恥ずかしいポーズと恥ずかしい掛け声をあげているイラストを描いてほしいという内容になります。\n\n具体的には以上の服着たネルソンに以下の行動をさせたイラストを描いてほしいです。\n\nシチュエーション：便利なスマホアプリによって身体の自由がきかなくなったネルソン\n\nネルソンの表情は、顔を真っ赤にして涙目であり、全身は震えている。\n首には同作品のベルファストと同じ首輪をしている。\n\nそんなネルソンは「ハイグレのポーズ」をしながら\n「ハイグレ、ハイグレ」と小声で発声させられている。\n\n時が経った後のイラストも描いてほしく\n\n便利スマホアプリの強度が高まり、ネルソンは「ハイグレのポーズ」に悦びを感じるようになる。\n\nネルソンちゃんはハート目になり、涎を垂らしている。\n\n着衣の鼠径部付近には湿り気も目立つようになる。\n\nさらに、大きな声で「ハイグレ！ハイグレッ！！」と叫び声をあげるようになっていく。\n\n以上の内容でネルソンちゃんを頭から足元まで描いてほしいです。\n胸の大きさはアズールレーン公式絵と同じ感じでお願いします。\n\nリクエストは以上です。\n\n\nハイグレポーズ参考\n\nhttps://x.com/tvasahi_cs/status/682335554340405248", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cc15915R/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2521676, "client_id": 2748099, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/223c0195/uploads/origins/7c7106c4-5e44-4b60-8c5a-77b96de2e4c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=222c090846361380c8477af707c2344c", "srcset": "https://si.imgix.net/223c0195/uploads/origins/7c7106c4-5e44-4b60-8c5a-77b96de2e4c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=222c090846361380c8477af707c2344c, https://si.imgix.net/223c0195/uploads/origins/7c7106c4-5e44-4b60-8c5a-77b96de2e4c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fd6ee331cdcce49f027be20f41a10b1 2x, https://si.imgix.net/223c0195/uploads/origins/7c7106c4-5e44-4b60-8c5a-77b96de2e4c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ef6e11c7d5aed4c1cbbffb515c2509b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/223c0195/uploads/origins/7c7106c4-5e44-4b60-8c5a-77b96de2e4c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2676336bacf5887cddae4f0c71d1485a", "srcset": "https://si.imgix.net/223c0195/uploads/origins/7c7106c4-5e44-4b60-8c5a-77b96de2e4c3?bg=%23fff&auto=format%2Ccompress&fm=w