2F%2Fpbs.twimg.com%2Fprofile_images%2F2023737104258494465%2FeGfQB7J8.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b33282dae16cd88a473372f74d746070, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2023737104258494465%2FeGfQB7J8.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a318e7be06f68b852fad7ca021fea66f 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2023737104258494465%2FeGfQB7J8.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=38bbcace0a0ff27497a7bb9bfe49be73 3x"}, "body": "らむだんさん、はじめまして！\n先日の納品でらむだんさんを知り、あまりにも素敵な音色に一目惚れ(一耳惚れ？)でした。\n『高き峰の挑戦者たち』も本当に素晴らしくて、作業のお供にヘビロテしております！\n(♪荒野の向こうで、♪荒涼たる道、♪あと少し！がお気に入りです！)\n\nさて、今回リクエストさせていただきたいのは、私の創作世界に存在する「吹雪に閉ざされた氷樹海」のテーマです。\n\n【詳細なイメージ】\nとある地方の果てにある雪深い樹海。本来は生命溢れる豊かな森林地帯だったが、一夜にして吹雪に閉ざされ永久凍土と化してしまった。猛烈な吹雪の原因は不明だが、噂では一頭の竜がその身ごと全ての熱を奪った為とされ、樹海の奥には凍てついた竜の亡骸が今も残されているという。\n\n物語は、この氷樹海に調査隊と共に迷い込んだ一人の少年が竜の心臓を探しに行くところから始まる。\n\nhttps://twitter.com/Z55M44/status/1589582254447394816?t=cbgI0s3ztHlcRaLFqSGu9Q&s=19\n\n♪旅路の果てに  や♪to the destination  のような壮大で試練に満ちた雰囲気がとても理想的です。\n\nループ処理はして頂けると嬉しいですが、曲調によってはなくても全く問題ありません。\n用途としてはTwitterでの動画投稿やホームページへの掲載を考えています。\n\nここまでお読みいただきありがとうございます。\nご検討頂けましたら幸いです。", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@dn_lmds_gl/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": false, "creator_id": 2387271, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2023737104258494465%2FeGfQB7J8.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2127247bbee08ef39543e25bd31eb188", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2023737104258494465%2FeGfQB7J8.png?bg=%23fff&auto=format%2Ccompress&