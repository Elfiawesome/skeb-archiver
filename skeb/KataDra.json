&w=200&h=200&blur=200&s=d036470635eeeb2c3f6cd11ee2fa14a3", "src_set": ""}, "body": "また、こんにちは。\n\n前回の絵がとても気に入ったのでもう一枚お願いしたいのです。\nリンというキャラクターの絵を描いてほしいのです。後ろからのアングルです。彼女は大きなお尻を見る人に見せています。笑顔で自信に満ち溢れている。あなたのこの絵のようなものがあればいいですね。服装は自由です。\n\nありがとうございました。\n\nhttps://fantia.jp/posts/66455\nhttps://fantia.jp/posts/89429\n\nhttps://imgur.com/a/IxuY2nj", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KataDra/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 15785, "client_id": 109881, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a7152bf/uploads/origins/2036842d-dd70-49e8-9fa7-65d4c035f75f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43ac2d128565519bedb9f1de46a427b2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a7152bf/uploads/origins/2036842d-dd70-49e8-9fa7-65d4c035f75f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8b6959c75ca570b05206196d4ae660c", "src_set": ""}, "body": "Hello! Nice to meet you! My character is enjoying a snack or candy. I will leave the rest to your judgement.\n\nhttps://imgur.com/a/wJM3QUA", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KataDra/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7d3441e6/requests/279839_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b093064bb8982cc9c4e912d6066afe5", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 15785, "client_id": 567744, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_coun