&w=200&h=200&blur=200&s=d6af39ca56d2a3b86d040637c07f69a7, https://si.imgix.net/2d3c1bd0/uploads/origins/8fc0c998-1051-4bcf-937c-1d5c5456ee91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=65dc554c05f8e72b8eaee40f96a45d49 2x, https://si.imgix.net/2d3c1bd0/uploads/origins/8fc0c998-1051-4bcf-937c-1d5c5456ee91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=61475bcaaa31e959c77afff8b99bde2b 3x"}, "body": "クリームソーダモチーフの衣装を着たCoCの自キャラ、尾茂白　稲成くんをお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Roze_dA/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 806600, "client_id": 2073722, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29a9418e/uploads/origins/0db2eb06-e016-4238-8c0e-c83584727328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec035ceda80937bff4da00cd4245efe6", "srcset": "https://si.imgix.net/29a9418e/uploads/origins/0db2eb06-e016-4238-8c0e-c83584727328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec035ceda80937bff4da00cd4245efe6, https://si.imgix.net/29a9418e/uploads/origins/0db2eb06-e016-4238-8c0e-c83584727328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28d400665fe8a46ddf3ec12745c204f5 2x, https://si.imgix.net/29a9418e/uploads/origins/0db2eb06-e016-4238-8c0e-c83584727328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd831ecd1e4725651411e566e4dc89aa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29a9418e/uploads/origins/0db2eb06-e016-4238-8c0e-c83584727328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab20d179eee9dbf816aac057ff78834c", "srcset": "https://si.imgix.net/29a9418e/uploads/origins/0db2eb06-e016-4238-8c0e-c83584727328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab20d179eee9dbf816aac057ff78834c, https://si.imgix.net/29a9418e/uploads/origins/0db2eb06-e016-4238-8c0e-c83584727328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=241aeb720ce332e22a8f8ee75533f734 2x, https://si.imgix.net/29a9418e/uploads/origins/0db2eb06-e016-4238-8c0e-c83584727328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4c0ac048602db936f687653a97fbde14 3x"}, "body": "こんにちはいつもお世話になっております。\n\n様々なTRPGのキャンペーンが終わりに近づくにつれ、この卓のスチルのようなものが欲しいなぁ、かといって知らない人にキャラクターを説明してもなぁ。といった気持ちを募らせていたところロゼさんのskeb募集の投稿を見かけ、これだ！と思い依頼させていただきます。\n\nまもなく終わりそうなグリフォンロードの各PCの4キャラクターが書いてある一枚絵をお願いしたいです。\n各キャラクターの参考画像に卓のスクリーンショットとPCの画像をまとめましたのでご参考になれば幸いです。\n\n\nサイズは用途として主に鑑賞用なのでなんでもよいのですが、あわよくばヘッダーにしたいなと思っているので、2:1～3:1くらいの横長の画像だと嬉しいです。\n\n構図のイメージとしてはロゼさんのskebのヘッダーのような感じで、ミニキャラで横にずらっと並べてほしいです！ポーズなどは指定ないですが、かなり走り回ったので←にみんなで走ってるみたいな構図が良いかなと思いました。（smooooch・∀・みたいな？）\n以下は余力がありましたら追加してほしい要素をわたしがほしい順に記載します。\n・GM（上方腕組み見守り面の感じで）\n・ダウレス君（実質本体だったので）\n・魔動機バイク、ゴーレム（ごちゃりそうな気もするので、余白あったら？）\n・ピンゾロダイス\n\n初Skebなため、勝手分からずなところ多々あるので、良く分かんねぇなって感じだったら遠慮せず蹴ってください。検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1J7MIWv8Ncn8oR4jtAa2WxhTaDEmKVckV?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Roze_dA/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 806600, "client_id": 2755901, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ebdee53/uploads/origins/089bf042-a8cb-4e2f-a01c-0e20efefaf6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c484cdad52909d48f147efe73a7aa439", "srcset": "https://si.imgix.net/1ebdee53/uploads/origins/089bf042-a8cb-4e2f-a01c-0e20efefaf6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c484cdad52909d48f147efe73a7aa439, https://si.imgix.net/1ebdee53/uploads/origins/089bf042-a8cb-4e2f-a01c-0e20efefaf6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff876e8acbdec433bf04cd1729ab77e2 2x, https://si.imgix.net/1ebdee53/uploads/origins/089bf042-a8cb-4e2f-a01c-0e20efefaf6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=910eb1357ed3872bb80de6070676bcd5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ebdee53/uploads/origins/089bf042-a8cb-4e2f-a01c-0e20efefaf6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe58e43328df73c758ef63aba27ce380", "srcset": "https://si.imgix.net/1ebdee53/uploads/origins/089bf042-a8cb-4e2f-a01c-0e20efefaf6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe58e43328df73c758ef63aba27ce380, https://si.imgix.net/1ebdee53/uploads/origins/089bf042-a8cb-4e2f-a01c-0e20efefaf6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d53513a5d5686fcdab96976a726dd510 2x, https://si.imgix.net/1ebdee53/uploads/origins/089bf042-a8cb-4e2f-a01c-0e20efefaf6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7cca09ded0df2618d92a029a6ece2b94 3x"}, "body": "自キャラのイラストをお願いします。\n和風ゴスロリで刀か西洋剣を持った姿をお願いします。\n\nまた任意で、シノビガミの公式NPCのイラストをお願いします。各流派の頭領(ハグレモノは加藤 段蔵)が希望です。此方は何人(0人)でも構いません。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Roze_dA/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 806600, "client_id": 201985, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/36623029/uploads/origins/5633b9f7-4314-4ccc-a0ee-3b825f0fb089?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a19f082b73eeab38ee9aa6d80711f4f3", "srcset": "https://si.imgix.net/36623029/uploads/origins/5633b9f7-4314-4ccc-a0ee-3b825f0fb089?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a19f082b73eeab38ee9aa6d80711f4f3, https://si.imgix.net/36623029/uploads/origins/5633b9f7-4314-4ccc-a0ee-3b825f0fb089?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=216639f896d5e6c1fc970e8471a766ee 2x, https://si.imgix.net/36623029/uploads/origins/5633b9f7-4314-4ccc-a0ee-3b825f0fb089?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02ceb6ceb97903f9f7e7b38068007993 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36623029/uploads/origins/5633b9f7-4314-4ccc-a0ee-3b825f0fb089?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8aff9a095f4de2ca77ce74fc53e397f5", "srcset": "https://si.imgix.net/36623029/uploads/origins/5633b9f7-4314-4ccc-a0ee-3b825f0fb089?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8aff9a095f4de2ca77ce74fc53e397f5, https://si.imgix.net/36623029/uploads/origins/5633b9f7-4314-4ccc-a0ee-3b825f0fb089?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=27b813dbc355229d75e1f86ef3244214 2x, https://si.imgix.net/36623029/uploads/origins/5633b9f7-4314-4ccc-a0ee-3b825f0fb089?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6e05fc95d82faa05be8cd3f1f53c14d 3x"}, "body": "こんにちは。いつも作品拝見しております！\n\n今回、自分がTRPGで使っているCoC探索者の立ち絵をお願いしたく思いまして、メッセージお送りさせていただきます。\n\n参考画像\nhttps://drive.google.com/drive/folders/1fmjNR5i7Hv2M8NRJZNtGsrDQ-bPPzVQS?usp=sharing\n※髪が金色の方のキャラで、ファイル名が青葉ナツメとなってる子です\n\n参考画像が、自分が描いたバストアップとちびキャラしかないのですが\n\n今回デフォルメでなく、「通常頭身の全身立ち絵」（ポーズお任せ）でお願いできますでしょうか。\n背景なしの透過データをいただけますと幸いです。\n\n差し支えなければTRPGの立ち絵として使用させていただけますと幸いです。\n※このキャラを使用する次の予定が未定なので、ゆっくりで大丈夫です。\n\n可能であれば、表情を　「無表情」と「微笑みウィンク」の２種で差分お願いできますと嬉しいです。\n\nまた、自分が描いたときに服をものすごく適当にしてしまったので\n服装何か思いつきましたら普段着っぽい洋服でアレンジお願いできましたら幸いです。お手間でしたら資料そのままの服装で大丈夫です。\n\n私の元の絵柄は気にせず、ロゼさんの絵柄で美人な感じ（？）で描いていただけますととってもうれしいです。\nロゼさんのかく、吊り目というか切れ長というか、気品ある感じの瞳が好きです。\n\nキャラシはるとエラーになっちゃったので簡単なキャラのプロフィールそえさせていただきます\n青葉ナツメ　男　20歳　職業アイドル\n\n通常頭身絵の相場があまり分かっておらず、失礼な金額になっておりましたり、他不都合ございましたら\nお気兼ねなくキャンセル頂いて大丈夫です…！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Roze_dA/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 806600, "client_id": 1240268, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40f74336/uploads/origins/54542cb3-fa31-4e15-8585-e1fd1c62a30c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db48a74d9fb5bfc57908a0b219b685ab", "srcset": "https://si.imgix.net/40f74336/uploads/origins/54542cb3-fa31-4e15-8585-e1fd1c62a30c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db48a74d9fb5bfc57908a0b219b685ab, https://si.imgix.net/40f74336/uploads/origins/54542cb3-fa31-4e15-8585-e1fd1c62a30c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27ddd773160877f0bf72a08e66640d39 2x, https://si.imgix.net/40f74336/uploads/origins/54542cb3-fa31-4e15-8585-e1fd1c62a30c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f184d55e07f257eb99a7f3d5e22da4d 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40f74336/uploads/origins/54542cb3-fa31-4e15-8585-e1fd1c62a30c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1656e2853ba24fa6f4e8a78a15deb87d", "srcset": "https://si.imgix.net/40f74336/uploads/origins/54542cb3-fa31-4e15-8585-e1fd1c62a30c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1656e2853ba24fa6f4e8a78a15deb87d, https://si.imgix.net/40f74336/uploads/origins/54542cb3-fa31-4e15-8585-e1fd1c62a30c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=