&w=200&h=200&blur=200&s=e09ded674c2d9672d1828d29d49d2855 3x"}, "body": "かつてゲームで描いていただいた\nシノミ\nhttp://cdn.tw4.jp/i/tw4/basic/0850/41860_d08503_bu.png\nhttp://cdn.tw4.jp/i/tw4/basic/0850/53514_d08503_totalbody.jpg\nクヌギ\nhttp://cdn.tw5.jp/i/tw5/basic/0043/334177_e00438_bu.png\nhttp://cdn.tw5.jp/i/tw5/basic/0043/348421_e00438_totalbody.jpg\nがえっちにヤられちゃっている所をリクエストしたいです！\n相手はでっぷりとした感じの汚っさんやゴブリンとかオークなどのヤられている感が強い相手だと嬉しいです…！\n二人とも処女を奪われちゃって破瓜描写があるといいかもです\nもう身体中色々とドロドロにされちゃってる感じで…！\n台詞擬音などは好きにしちゃってください！(無しでもOK)\nポーズ・アングルなど書いていない点は全てお任せいたします！\nよろしくお願いいたします！", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toritaku/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1021858, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/00e14c5c/uploads/origins/40845581-46c0-438e-87ca-7068b9345df8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe1188f033fdef0ae72da1cd7647d22b", "srcset": "https://si.imgix.net/00e14c5c/uploads/origins/40845581-46c0-438e-87ca-7068b9345df8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe1188f033fdef0ae72da1cd7647d22b, https://si.imgix.net/00e14c5c/uploads/origins/40845581-46c0-438e-87ca-7068b9345df8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61d094ece06d29490122bff9f60eb576 2x, https://si.imgix.net/00e14c5c/uploads/origins/40845581-46c0-438e-87ca-7068b9345df8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2e073b94e4932fddf61137014d2afbe 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00e14c5c/uploads/origins/40845581-46c0-438e-87ca-7068b9345df8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb2c1ae2413d1332b98b3c1562e97c9f", "srcset": "https://si.imgix.net/00e14c5c/uploads/origins/40845581-46c0-438e-87ca-7068b9345df8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb2c1ae2413d1332b98b3c1562e97c9f, https://si.imgix.net/00e14c5c/uploads/origins/40845581-46c0-438e-87ca-7068b9345df8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8015b9949f5053808951d34ad81bef4d 2x, https://si.imgix.net/00e14c5c/uploads/origins/40845581-46c0-438e-87ca-7068b9345df8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd676b7339b960f12a350541e5818774 3x"}, "body": "あなたの描かれた\nhttps://www.pixiv.net/artworks/14286624\nhttps://www.pixiv.net/artworks/14441969\nがとても好みだったので……\n\nこの2つの間にあったであろう、冒険中に「アリーナ姫の通常の冒険装束（とんがり帽子の衣装）」を着たまま、ひたすらトルネコに犯されて精液まみれにされているイラストをお願いします。\n「もう言葉だけで命令に従うようになっている状態で、特に拘束などされず、服を着たまま局部だけ破かれて行為をされている」という感じでお願いします。体位や背景の設定などはお任せします（簡易的な背景で構いません）。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toritaku/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1021858, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/971bee6c/uploads/origins/1e931353-de91-441c-a4aa-82d45c5dec12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d15d74572b148df1ceb797614b2c2950", "srcset": "https://si.imgix.net/971bee6c/uploads/origins/1e931353-de91-441c-a4aa-82d45c5dec12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d15d74572b148df1ceb797614b2c2950, https://si.imgix.net/971bee6c/uploads/origins/1e931353-de91-441c-a4aa-82d45c5dec12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5b3c8942a274def59846c60c814766f 2x, https://si.imgix.net/971bee6c/uploads/origins/1e931353-de91-441c-a4aa-82d45c5dec12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de93220a12e2b3fd93957b99ef76f463 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/971bee6c/uploads/origins/1e931353-de91-441c-a4aa-82d45c5dec12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c41f00df65eab760ed1057ed8609e24c", "srcset": "https://si.imgix.net/971bee6c/uploads/origins/1e931353-de91-441c-a4aa-82d45c5dec12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c41f00df65eab760ed1057ed8609e24c, https://si.imgix.net/971bee6c/uploads/origins/1e931353-de91-441c-a4aa-82d45c5dec12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3c595ac96c7419c665903b8b0b61e38e 2x, https://si.imgix.net/971bee6c/uploads/origins/1e931353-de91-441c-a4aa-82d45c5dec12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b09f56cb3bc82021d84286f3220f9559 3x"}, "body": "初めまして、とりたく氏のまどマギ絵が好きなのでリクエストさせていただきます。\n鹿目まどか＆眼鏡ほむら（二人ともふたなり）相手の3Pハーレムセックス絵を描いて頂けないでしょうか。\n竿役は透明人間状態あるいは画面外にいて姿は見えない形でお願いします。\n\nシチュエーションは二人が竿役に処女を捧げて中出しされ、精通している状況です。\n構図等はお任せしますが、ふたりの性器が良く見える形が良いです。\n\nもし表情差分を描いて頂けるのでしたら、\n二人とも痛みと快楽で半泣きの表情→イチャイチャビロートーク的な雰囲気でお願いします。\n（竿役にほむらちゃんがエッチだったと微笑みながら告げるまどかと、竿役に恥ずかしそうな表情を向けるほむらのイメージ）\n\nふたなりペニスに関しては氏の助けて！マミさんシリーズの短小包茎な感じでお願いします。\nまた、破瓜の血の描写が視認出来る程度に欲しいです。\n\n以上、よろしくお願いいたします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toritaku/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1021858, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f639dfc6/uploads/origins/2e8703b2-e63d-40af-a0e7-b62114ab83ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9dd213ced142e9d577cb051bba62a50", "srcset": "https://si.imgix.net/f639dfc6/uploads/origins/2e8703b2-e63d-40af-a0e7-b62114ab83ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9dd213ced142e9d577cb051bba62a50, https://si.imgix.net/f639dfc6/upl