×1.6の規格が望ましい）\n\nもしご都合あえばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-BS_qcPU_YJKV5-xmwkIJWWit5ScQkiG", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@higuresou098/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1439471, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/43c219ab/uploads/origins/4f00fae3-a5e7-4b5d-8df9-0c407b6fa367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=870834150818e2a836d2791999a598c1", "srcset": "https://si.imgix.net/43c219ab/uploads/origins/4f00fae3-a5e7-4b5d-8df9-0c407b6fa367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=870834150818e2a836d2791999a598c1, https://si.imgix.net/43c219ab/uploads/origins/4f00fae3-a5e7-4b5d-8df9-0c407b6fa367?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=314e2c5c81c4ba4a18be78d8d3c00967 2x, https://si.imgix.net/43c219ab/uploads/origins/4f00fae3-a5e7-4b5d-8df9-0c407b6fa367?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8de7820fa097fe72dcf61ae45d96b2a8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/43c219ab/uploads/origins/4f00fae3-a5e7-4b5d-8df9-0c407b6fa367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c85d37c88f84735692f5b661b701848", "srcset": "https://si.imgix.net/43c219ab/uploads/origins/4f00fae3-a5e7-4b5d-8df9-0c407b6fa367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c85d37c88f84735692f5b661b701848, https://si.imgix.net/43c219ab/uploads/origins/4f00fae3-a5e7-4b5d-8df9-0c407b6fa367?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f5a8de7f1fa613d5f4297b211dcb0f94 2x, https://si.imgix.net/43c219ab/uploads/origins/4f00fae3-a5e7-4b5d-8df9-0c407b6fa367?bg=%23fff&