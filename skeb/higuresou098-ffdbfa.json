ble_same_genre": false}, {"path": "/@higuresou098/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1439471, "client_id": 2612636, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6508d5bc/uploads/origins/5d72cf10-3ae0-4ff2-8d1e-f6a7180667da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0fe7e272976fb970dd113c091a041fd", "srcset": "https://si.imgix.net/6508d5bc/uploads/origins/5d72cf10-3ae0-4ff2-8d1e-f6a7180667da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0fe7e272976fb970dd113c091a041fd, https://si.imgix.net/6508d5bc/uploads/origins/5d72cf10-3ae0-4ff2-8d1e-f6a7180667da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a660d369d45d6a6a7f10ca0f8b829f3f 2x, https://si.imgix.net/6508d5bc/uploads/origins/5d72cf10-3ae0-4ff2-8d1e-f6a7180667da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b15536324789e0a888e9c7e79dbd013e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6508d5bc/uploads/origins/5d72cf10-3ae0-4ff2-8d1e-f6a7180667da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45ff80a944ef1b2adcc559a43ac4229f", "srcset": "https://si.imgix.net/6508d5bc/uploads/origins/5d72cf10-3ae0-4ff2-8d1e-f6a7180667da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45ff80a944ef1b2adcc559a43ac4229f, https://si.imgix.net/6508d5bc/uploads/origins/5d72cf10-3ae0-4ff2-8d1e-f6a7180667da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cadb021918531c37ed4b60503408615b 2x, https://si.imgix.net/6508d5bc/uploads/origins/5d72cf10-3ae0-4ff2-8d1e-f6a7180667da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56ca727440fc8743e754cf7d3c741bde 3x"}, "body": "ひぐれん様\nこんばんは！この度は是非ひぐれん様の絵柄でこの二人を描いていただきたいと思い、リクエストを送らせていただきました。\n\n・キャラ詳細\n一人目\n名前：大海ノ宮 焔（おおうみのみや ほむら）\n性別：男\n年齢：17歳\n身長：190cm\nイメージカラー：8D0200\n高校2年生。明るく元気、豪放磊落な性格。人にも自分にも厳しいタイプ。\n笑顔で無茶を言うこともあるが、それは「相手がそれをできる」と信じているから。\n感覚派だが努力は怠らない。しかしどこか大雑把。\nSTR：18　SIZ：17　APP：8（顔の傷とギザ歯）\n\n・二人目\n名前：小戸森 言未（こともり ことも）\n性別：女\n年齢：16歳\n身長：148cm\nイメージカラー：00AC9A\n高校1年生。小心者で泣き虫。実は勇気がなくて言えないが割とアクティブで好奇心も高め。\n「無理です；；」と言うことも多いが、きちんとやり遂げる。本心では楽しんでいることもあり、努力はきちんとできる真っすぐさもある。SFとオカルト小説が好きな本の虫。\nSTR：11　SIZ：9　APP：13（人並みに可愛い）\n\n・関係\n赤宮高校の不思議研究部という部活に所属している。この部活は表向きは不思議な現象を研究する部活であるが、その実態は人に害をなす怪異を倒すために設置されている組織である。二人はその部活の先輩と後輩。日本刀の所持が認められている。\n焔は言未がこの部活の実態を知らずに入部したにも関わらず今でも所属し、こちらの無茶な鍛錬や、危険も伴う依頼にもついてきてくれることに信頼を置いており、後輩として可愛がろうとしている。しかし、女子の後輩にどう接していいか分からず、押しが強すぎて怖がれることも。\n言未は焔のことを先輩として凄いと思っているが、押しの強さや大きさに怖いと思うこともあり、どんな話をすればいいか分からない。ただ、関わってくれるのならこちらも関わろうと頑張っている。\n二人の仲は悪くはなく、たまにぎこちなくなるが、放課後一緒にたい焼きを食べにいったり、言未の好きな本を先輩が頑張って読んで感想を言い合ったりする。戦闘のコンビネーションは良い。\n\n・構図\n「背中合わせで怪異と戦っている」か「放課後に並んでたい焼きを買って食べながら歩いている」のどちらかのシーンでお願いします！それ以外の指定は特にありません！\n\nhttps://drive.google.com/drive/folders/1OD-aSLx1QszGh_drk2oQ-D3DliOztOpG?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@higuresou098/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1439471, "client_id": 595743, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15adebcd/uploads/origins/b48b6f0b-f360-4ecf-9b8b-cdd71c5cae62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acd250c17d026e044f5c22681cba9d45", "srcset": "https://si.imgix.net/15adebcd/uploads/origins/b48b6f0b-f360-4ecf-9b8b-cdd71c5cae62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acd250c17d026e044f5c22681cba9d45, https://si.imgix.net/15adebcd/uploads/origins/b48b6f0b-f360-4ecf-9b8b-cdd71c5cae62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbaea015a5b6b15c261e0d659706d928 2x, https://si.imgix.net/