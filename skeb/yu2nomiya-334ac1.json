ださい\n⑥提示した展開に必ず沿う必要はありません\n あくまで参考程度としてください\n\n以上、詳細です。\n\nご検討いただけると幸いです。\n価格設定について問題ありましたら、条件付きの再送依頼頂けると助かります。", "nc": 57, "word_count": 13554, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 7905, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "オデュッセア", "screen_name": "7kgmc", "avatar_url": "https://pbs.twimg.com/profile_images/1245198467925868545/peB0UarM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2912737184/1768742082/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "novel"}], "banned": false, "nc": 160}, {"id": 57775, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "あいくち", "screen_name": "aikuchi0", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fwebpublic-a75a0df2-d0df-4950-8684-c8b777261f89.png?avatar=1", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "novel"}], "banned": false, "nc": 160}, {"id": 1225664, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "男爵平野@6/26 異世界縁交After発売", "screen_name": "baronhirano", "avatar_url": "https://pbs.twimg.com/profile_images/477677742960304128/1XqS_Ddk.png", "header_url": "https://pbs.twimg.com/profile_banners/79779186/1688371295/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 60, "skills": [{"genre": "novel"}, {"genre": "correction"}