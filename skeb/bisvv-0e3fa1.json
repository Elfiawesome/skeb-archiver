、インスピレーションで新しい服をデザインすることもできますよ。\n\nあなたの絵はとても生き生きとしていて、とても楽しいです。細かいところはおまかせします。王子様・王族というテーマで、楽しんでください。ご検討のほど、よろしくお願いいたします。\n\nhttps://i.imgur.com/HqbLbz9.png", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bisvv/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 258659, "client_id": 326685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dfd4ff17/uploads/origins/27b9b922-c24c-4ce6-986e-cb986a8767d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=901e5a0f308263d9091adb3a90d7b5ce", "srcset": "https://si.imgix.net/dfd4ff17/uploads/origins/27b9b922-c24c-4ce6-986e-cb986a8767d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=901e5a0f308263d9091adb3a90d7b5ce, https://si.imgix.net/dfd4ff17/uploads/origins/27b9b922-c24c-4ce6-986e-cb986a8767d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38358d406b58d9bac0849be6303ab10c 2x, https://si.imgix.net/dfd4ff17/uploads/origins/27b9b922-c24c-4ce6-986e-cb986a8767d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4100abb347e725f2c17d2c642363adea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dfd4ff17/uploads/origins/27b9b922-c24c-4ce6-986e-cb986a8767d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e03270f3e72164708ac0f6df8f614c1", "srcset": "https://si.imgix.net/dfd4ff17/uploads/origins/27b9b922-c24c-4ce6-986e-cb986a8767d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e03270f3e72164708ac0f6df8f614c1, https://si.imgix.net/dfd4ff17/uploads/origins/27b9b922-c24c-4ce6-986e-cb986a8767d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f7ba812fd2100eb07ce78648ed50570c 2x, https://si.imgix.net/dfd4ff17/upload