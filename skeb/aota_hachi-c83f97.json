compress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7b28df5619e3befc53533201093a532 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e73306b/uploads/origins/99afdcc0-40bd-488c-9fcc-e6cfce42f61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5778790b7923729d2e07b56442ef044c", "srcset": "https://si.imgix.net/2e73306b/uploads/origins/99afdcc0-40bd-488c-9fcc-e6cfce42f61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5778790b7923729d2e07b56442ef044c, https://si.imgix.net/2e73306b/uploads/origins/99afdcc0-40bd-488c-9fcc-e6cfce42f61d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e101050ae32486be972a6089b1a43f6b 2x, https://si.imgix.net/2e73306b/uploads/origins/99afdcc0-40bd-488c-9fcc-e6cfce42f61d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=010ca8baedcb09b32395f4da2bbf89f9 3x"}, "body": "小学校の地震避難訓練で、机の下で座ったままで隙パンしてる東北きりたんをお願いします。\n\nきりたんは長袖の白ブラウスに、左胸には「５-１　東北きりたん」の縦長の名札。紺色吊りスカートに紺色短パン。立膝で足はそれほど開脚じゃないけど、足を開ききってないだけに生じる隙間から純白の下着がチラリしている感じでお願いします。\n\nきりたん本人は、向かいにいる同級生に「ちょっと楽しいね？」という感じで、下着を見られてる事に気づかない無邪気笑顔。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aota_hachi/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1411605, "client_id": 1409182, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ace137a/uploads/origins/dc68f5ed-c84a-46b5-991d-e4c66ecc5b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ebca4ac3ef695165896b4c6e991f3ae", "srcset": "https://si.imgix.net/0ace137a/uploads/origins/dc68f5ed-c84a-46b5-991d-e4c66ecc5b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ebca4ac3ef695165896b4c6e991f3ae, https://si.imgix.net/0ace137a/uploads/origins/dc68f5ed-c84a-46b5-991d-e4c66ecc5b97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87c84759d5080004e1e04a6d95a94b57 2x, https://si.imgix.net/0ace137a/uploads/origins/dc68f5ed-c84a-46b5-991d-e4c66ecc5b97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad268efd01d53fb4e6b30f715d3b2180 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ace137a/uploads/origins/dc68f5ed-c84a-46b5-991d-e4c66ecc5b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0bc036339ba87eb2b9758094080a94d", "srcset": "https://si.imgix.net/0ace137a/uploads/origins/dc68f5ed-c84a-46b5-991d-e4c66ecc5b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0bc036339ba87eb2b9758094080a94d, https://si.imgix.net/0ace137a/uploads/origins/dc68f5ed-c84a-46b5-991d-e4c66ecc5b97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ee8197a04406903234d97cdbc9358c34 2x, https://si.imgix.net/0ace137a/uploads/origins/dc68f5ed-c84a-46b5-991d-e4c66ecc5b97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=22087d408f3f2daebebf5c0e90a8e32c 3x"}, "body": "シャツイン短パンの体操服姿で、お兄様にイタズラされてしまう東北きりたんをお願いします。\n\n上のイメージは\nhttps://auctions.yahoo.co.jp/jp/auction/o1133715974\n\n下のイメージは\nhttps://auctions.yahoo.co.jp/jp/auction/g1170502402\n\nきりたんはお兄様の力強い左手で両手首を体の前でまとめてつかまれていて抵抗ができない。\n\nお兄様はフリーの右手の人差し指と中指で、前からきりたんのアソコを短パンの上からスリスリ。\n\nきりたんは腰を曲げてお兄様の指と性的快感から逃れようとするが叶わない。幼い細い脚を肩幅程度に開いたまま、トロ目で愛液を内股にたらしつつ呼吸を荒くしてえちえちな表情になる。そのまま絶頂させられ失禁。両目を閉じておしっこを漏らしてしまう。\n\n両手拘束でのイタズラ開始直後の、片目をつぶった戸惑いの表情で腰を逃がそうと体を折ってる場面。\n\n同じ体制のまま腰を逃がしきれずイタズラの性的快感に負けて短パンと細い脚との隙間から愛液をたらすトロ目表情。\n\n両目を閉じた絶頂失禁との3枚差分でお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aota_hachi/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "