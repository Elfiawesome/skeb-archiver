92e2/uploads/origins/b4fe1d37-c724-45ea-a2ec-388a923a43f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b3dc8ca22bb9efc51ba232731dae09f 2x, https://si.imgix.net/44b292e2/uploads/origins/b4fe1d37-c724-45ea-a2ec-388a923a43f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1246816f4d608adf01155554aee2c0df 3x"}, "body": "すいせー様\n\n初めまして。\nIRIAMでライバー活動をしております、横浜美月と申します。\nすいせー様のイラストをXでお見かけしてから、ずっと依頼したいと思っておりました✨️\n是非、横浜美月をすいせー様の絵柄で描いていただきたいです！！\n\n【描いていただきたいキャラ】\n・横浜美月：ママ×ギャル×ナース\n・立ち絵はXのハイライト内にあります。お手数おかけしますが、ご確認いただけますと幸いです。\n・包容力のある優しさが持ち味のギャルです！\n\n【構図など】\n構図や表情、ポーズ、衣装などは基本お任せでお願いしたいです。\nピアスと口元の黒子、褐色肌は横浜美月のチャームポイントなので、その点のみ残していただきたいです。\nサムネイル等で活用する予定のため、頭や左右が切れないように描いていただけますと幸いです。\n\n【活用範囲】\nSNSでの活用、IRIAMサムネイル、IRIAM返礼品で活用予定です。\nそのため商用利用の可能性がございます。\n\n【納品形式】\nキャラクターのみの背景透過画像も可能でしたらいただきたいです。\n\n条件が合いましたら、何卒よろしくお願いします！！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suisei_comet_3/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2052063, "client_id": 3955757, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7cba41b7/uploads/origins/e2719d37-e5ec-442a-bafa-bfe85c1aed87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39265fcf96d296724e04137396dd1b6c", "srcset": "https://si.imgix.net/7cba41b7/uploads/origins/e2719d37-e5ec-442a-bafa-bfe85c1aed87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39265fcf96d296724e04137396dd1b6c, https://si.imgix.net/7cba41b7/uploads/origins/e2719d37-e5ec-442a-bafa-bfe85c1aed87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6f9eb6748bb9adc558ad8c3440e820b 2x, https://si.imgix.net/7cba41b7/uploads/origins/e2719d37-e5ec-442a-bafa-bfe85c1aed87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80ac6b3240a60d5b16e4d54d29