fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81bbe3bf3aa338c3cf3bc45e88911260, https://si.imgix.net/5c6e5048/uploads/origins/816ac45d-f902-40bb-8e54-5716be40f658?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=935df6d40fe2d987bab159233ef6602f 2x, https://si.imgix.net/5c6e5048/uploads/origins/816ac45d-f902-40bb-8e54-5716be40f658?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=497c48788ab1d36f453e9f65e33036b2 3x"}, "body": "初めまして。別サイトで塔子様の「花見れば」を読み、とても素敵な絵柄とキャラの表情にときめき、リクエストを送らせていただきます。\n\nリクエストはTRPGの創作キャラでのBLをお願いしたいです。（お相手様の了承は頂いています）\n\n■設定\n①室戸碕/むろとみさき\n一人称：僕　168cm\n無口寄り、感情の起伏が少ない。真面目で成績優秀な法学部の学生に見えるが、本当は音楽をやりたい。\nバンド活動ではギターをしている。身バレを隠す為、バンドでは黒髪になり【夜遊びのヨア】と名乗る。\nお笑いが好き。栄養が偏り麺類ばかり食べる。\n\n②ヨア\n一人称：俺、俺様\n感情の起伏が激しく、よく喋り、口調もすこし悪い感じになる。室戸の時よりもはっきり物事を言う。察しがいい。たまに言葉のチョイスで頭の良さが漏れ出る。\n\n③佐々木友晴/ささきともはる\n一人称：俺　170cm\n幼少期からデザイナーになるのが夢だが、周りに話せず、隠れて家で描いている。人に流されやすく孤立することが怖いタイプ。\n\n■呼び方\n佐々木：室戸、ヨア様、ヨア\n室戸：佐々木\nヨア：友晴\n※全員タメ口\n\n■関係性\n佐々木×室戸（ヨア）です。\n佐々木は「室戸＝ヨア」であることに気付いておらず、同時期に2人（室戸、ヨア）に恋愛感情を抱く。\nその事を悩み、ヨアには相談している。\n今は室戸の方が好き寄りだけど、どっちも好きで揺れている。\n\n■佐々木→ヨア\n偶然仲良くなり、立ち振る舞いや言動、存在の魅力に憧れ惹かれる。自信ある俺様節が心地よく、つい夢や恋バナを話している。\n煽ったり誘ったりして本気にさせるくせに、こちらが本気になるとかわすので悔しい。\n\n■ヨア→佐々木\n自分（ヨア）が2番目に好きなことを伝えられると、何故かヤキモチをやき、思わせぶりに佐々木を誘惑したり煽ったりする。\n\n◾️希望\n可能であれば佐々木×ヨアの漫画をお願いしたいです。難しいようであればイラストでも構いません。\n服装は細かい部分は省略したり、別の服装でも構いません。二人の距離が近いと嬉しいです。\n（設定がややこしくすみません）\n\n◾️使用用途\n個人での鑑賞、Xへのアップロード\n\n価格が不適切な場合は調整させていただきますので、お気軽に再送してください。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1GN6SK_mhgfqb7ZPDyvhwooXP90TFN3O9", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@touko_bang/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2c093cc3/uploads/origins/7210ed04-c119-47d7-a1d3-646462f45efd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ddcb25a1076c78a0a7834bcd3d4570bf", "srcset": "https://si.imgix.net/2c093cc3/uploads/origins/7210ed04-c119-47d7-a1d3-646462f45efd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ddcb25a1076c78a0a7834bcd3d4570bf, https://si.imgix.net/2c093cc3/uploads/origins/7210ed04-c119-47d7-a1d3-646462f45efd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8ab8e93646f21984d3fdd08d8a20b24 2x, https://si.imgix.net/2c093cc3/uploads/origins/7210ed04-c119-47d7-a1d3-646462f45efd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1613089a03f93cfeb803b762ce8d60cf 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2112750, "client_id": 2402220, "nc": 32}, {"path": "/@touko_bang/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2112750, "client_id": 292846, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1cba09fd/uploads/origins/27743071-70aa-4902-beaf-948d580e587b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb3c69022963f7b5e5a4061def8a357a", "srcset": "https://si.imgix.net/1cba09fd/uploads/origins/27743071-70aa-4902-beaf-948d580e587b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb3c69022963f7b5e5a4061def8a357a, https://si.imgix.net/1cba09fd/uploads/origins/27743071-70aa-4902-beaf-948d580e587b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e33d6d4b99c071ed78760b16f068ad32 2x, https://si.imgix.net/1cba09fd/uploads/origins/27743071-70aa-4902-beaf-948d580e587b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a570cb38524b8b8b08c034e5b57c7ce 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1cba09fd/uploads/origins/27743071-70aa-4902-beaf-948d580e587b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7cf126585ffe06e8dbdd129ef65f61c1", "srcset": "https://si.imgix.net/1cba09fd/uploads/origins/27743071-70aa-4902-beaf-948d580e587b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7cf126585ffe06e8dbdd129ef65f61c1, https://si.imgix.net/1cba09fd/uploads/origins/27743071-70aa-4902-beaf-948d580e587b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b856b27be1cdc82b50adb709428992a9 2x, https://si.imgix.net/1cba09fd/uploads/origins/27743071-70aa-4902-beaf-948d580e587b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3b2f5934df5e3571a03e574fba2d3247 3x"}, "body": "塔子様 \n\n初めまして。検索で塔子様の絵をお見掛けし、是非描いて頂きたくてリクエストのメッセージをお送りしました。 \n資料のキャラクター(TRPGでのキャラクター)での創作BLをリクエストさせて頂きたいです。\nお相手様には了承頂いています。 \n\n以下、詳細です。\n\n▼攻\n名前:リキ(正式表記は凌希、基本『リキ』)\n年齢:20\n身長:178\n体格:細身\n髪色:明るめの茶髪\n目の色:青緑\n\nその他：和装アイルランド人アイドル。明るい可愛い系イケメン。\n刀を使ったパフォーマンスや扇子を使ったダンスが得意。歌は苦手。\n日本が大好き。お酒も大好き。運が良い。アイドルという仕事が大好き。\nタケルの事は、自分の憧れで、超えたいアイドルだと思ってる。\n\n口調：誰にでも敬語。(「～デスか？」「わかりました！」「それはそうデスけど…」)\n\n一人称：ワタシ\n二人称：アナタ\n相手に対して：タケル\n\n\n▼受\n名前:龍神 タケル\n年齢:23\n身長:191cm\n体格:背が高く少しがっしり\n髪色:金\n目の色:オレンジがかった金\n肌：褐色\n\nその他：アイドル、スペイン人の父と日本人の母を持つハーフ。生まれも育ちも日本。\nファンも全人類も自分の事を好きだと思っているし自分も皆の事大好き。\nリキの事は大事にしたい(年下だし)ので、他の人より少し過保護。\n\n口調：口調は軽くてチャラそうに見える。一応ちゃんと考えて発言してる。\n(「お、いいねー」「俺って完璧だろ？」「おいおい、大丈夫か？」)\n\n一人称：俺\n二人称：アイドル中：～ちゃん(老若男女問わず)\n　　　プライベート：そっち、アンタ\n相手に対して：リキ\n\n▼二人について\nリキ×タケル\n2人でアイドルユニットを組んでいる。\n付き合っている。リキからは「憧れ！」という気持ち、タケルは「かわいい年下」という風な気持ち。\n勿論お互いの事が好き。\n2人とも顔が目立つのでお出かけは基本サングラスや帽子などで隠している。\n距離感が近い。\n\n▼希望\n漫画か、色んな二人の姿を描いて欲しいです。\nラフなもので大丈夫です、アイドル衣装は大変なので私服で構いません。\nR要素を少しでも入れてもらえたら嬉しいですが、無理であればハグかキスをしてほしいです。\n全身図が無いので無い