-4281-b2b6-ad10ed7aad34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b23be9f7ad23298c94267f4b202a7fe4 2x, https://si.imgix.net/40869155/uploads/origins/d42ccbe1-f29b-4281-b2b6-ad10ed7aad34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afa0a9851115c5a904488a86dbc4ec66 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40869155/uploads/origins/d42ccbe1-f29b-4281-b2b6-ad10ed7aad34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a296ab299bb4823eeddc3e82d14ed33", "srcset": "https://si.imgix.net/40869155/uploads/origins/d42ccbe1-f29b-4281-b2b6-ad10ed7aad34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a296ab299bb4823eeddc3e82d14ed33, https://si.imgix.net/40869155/uploads/origins/d42ccbe1-f29b-4281-b2b6-ad10ed7aad34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=67e267eab6943dca70463afaba112e39 2x, https://si.imgix.net/40869155/uploads/origins/d42ccbe1-f29b-4281-b2b6-ad10ed7aad34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a34def1cb85ea8aeeada4f29bb12fd9 3x"}, "body": "こんにちは。可憐な雰囲気にライティングがカッコいいイラストに惹かれて、今回うちの子のイラストリクエストをお願い致します。\n『メーテライト・ルミエーラ』という変身ヒロインの女の子です。詳細は資料URLをご参照ください。\n「人懐っこい・優しい・可愛らしい・清楚」モチーフの、少女から少し大人びた雰囲気の女の子です。\nデザインの補足要素に以下のものがあります。\n・星や夜空をモチーフにしたファンタジー系の異世界を舞台にこの子が魔法少女へ変身するキャライメージです。\n・瞳の中には小さな黄色い星のハイライトがある。\n・頭部の髪飾りやティアラ、白いもふもふの装飾はそれぞれ独立してついている。\n・後髪は首元で内側にまとまってから、背中辺りから分け目が外側にふわっと広がる。後髪半ばのシルエットが天使の羽根のようにも見える意図。\n・胴のドレスと二の腕のフリルとはそれぞれ独立した装飾。脇下は繋がっていません。\n\n以下シチュ希望です。過去イラストを拝見して動きを感じられるポーズや構図が素敵でした。\n夜空の下でほんのり照らされるもしくは晴れ空で、表情は微笑むイメージ。基本ポーズは軽やかに片足(左右不問)を少し上げるステップの雰囲気。\n上記は詳細な指定があった方が良い場合の案なので、その他に構図やポーズ案がありましたらそちらを優先して頂きたいです。\n資料から読み取れる細かなキャラ解釈は、自由にすべておまかせ致します。\n\n使用用途はTwitter(X)やMastodon、Misskey含む外部SNSでのアイコン、ヘッダー使用・イラスト紹介・紹介ツイートをtogetter(min.t)などの自身のまとめへ追加。\nリクエストする際に上記まとめのURLを引用する場合があります。\n\nファイルはPSD形式希望で、恐縮ですが宛名とイラストのレイヤー分けをお願いします。分離不可の場合は統合状態を問いません。もしPSD形式が不可の場合は、代替案としてPNG形式の宛名なし原寸サイズを頂きたいです。\nどうぞよろしくお願いします！\n\nまとめ一覧\nhttps://min.togetter.com/FfDRT8U\n\n資料URL\nhttps://drive.google.com/drive/folders/1ihjKCXY4RJREGyeVWG7U-1Gj8qlnE2Bm\n\nhttps://drive.google.com/drive/folders/1ihjKCXY4RJREGyeVWG7U-1Gj8qlnE2Bm", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@S_H_DarkKnight/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2535661, "client_id": 1201878, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd346257/uploads/origins/d0077e5c-adca-4088-828e-618fb1effbef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0f54d6b294d0a4c1c3735f03fcec64f", "srcset": "https://si.imgix.net/bd346257/uploads/origins/d0077e5c-adca-4088-828e-618fb1effbef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0f54d6b294d0a4c1c3735f03fcec64f, https://si.imgix.net/bd346257/uploads/origins/d0077e5c-adca-4088-828e-618fb1effbef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d3f6108419825c8b2007e5c85c7a5fa 2x, https://si.imgix.net/bd346257/uploads/origins/d0077e5c-adca-4088-828e-618fb1effbef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23e7e8dd2f0977855b73a4c4272e21ac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd346257/uploads/origins/d0077e5c-adca-4088-828e-618fb1effbef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b1d0978b97a93ed63e42a0d56673a22", "srcset": "https://si.imgix.net/bd346257/uploads/origins/d0077e5c-adca-4088-828e-618fb1effbef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b1d0978b97a93ed63e42a0d56673a22, https://si.imgix.net/bd346257/uploads/origins