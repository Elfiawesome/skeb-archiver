f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f66deec9d8dc29f322dddfaf773014f4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d8049e36/uploads/origins/e87cebaa-ee61-4c28-a042-55abfee3d91c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cfeff90b0a4cd12140bc9a6d19cc545", "src_set": ""}, "body": "もしよろしければ、巡音ルカちゃんをお願いします！\nピンクの髪に青の瞳＆ネイルの対比が特徴的な子なので、この3点画角に入れていただけると非ｯｯｯ…常に喜びます。\n衣装等のアレンジはオカさんの思うままにして頂ければと思います。\n\nまた、使用目的は非営利、観賞用となります。\n何卒よろしくお願いいたします…！！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@blackistat2/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 273968, "client_id": 3520404, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dfef99cf/uploads/origins/b0c5be49-2ff9-4c85-9cf5-b14b8e7007d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb132b2b6aefbf565ad7d330cadf91b9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dfef99cf/uploads/origins/b0c5be49-2ff9-4c85-9cf5-b14b8e7007d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5ccb39b2f8b10e6805b2fc7c3e31dd5", "src_set": ""}, "body": "こんにちは、先生。あなたの水彩画風の作品がとても好きです！\nもし可能であれば、イラストをお願いしたいです。\n私は日本の祭り文化にある水風船が好きです。\nキャラクターのアイデアとして、水風船を持った女の子のイラストを描いていただけませんか？\n女の子のスタイルはふわふわな感じがいいです。\nSNSのアバターとして使用したいと考えています。\n私は外国人なので、うまく伝えられていなかったら申し訳ありませんが、よろしくお願いします(__)", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@blackistat2/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 273968, "client_id": 2878380, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c36e3372/uploads