夜の街をイメージできるイラストだと嬉しいです。\n\n【キャラクター設定】\n戯 姦(あじゃら かん)\nドイツ語名：Ehebruch Spielen(エイボフ スピーレン)\n一人称：俺\n二人称：アンタ\nLike：ブラッドオレンジ、タバコ（ピース）、顔のいい男\nDislike：ナヨナヨしている人間\n\n【キャラクター像】\n強めのツンデレ。ダウナー系のめんどくさがり。顔のいい男を見つけるとすぐに近寄りナンパする。\n特定の人に対しては受け身になることがあります。\n自分の可愛さを理解しているが、表情は可愛いよりも挑発的な顔をすることが多いです。\n自分の魅せ方を分かっている男です。\n\nvoice\n「キミ可愛いね〜。俺と遊ばなぁい？」\n「まぁ、俺可愛いから。」\n\n\n以上が依頼内容になります。\n以前からご依頼させていただきたいと思っておりました...!!!\n金額等不備ありましたら再送いたします。\nお忙しいとは思いますが、ご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1iDnKCBrfVlOWWbE2FGISajSycjxnZeyS", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@85NEEO3/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4090572, "client_id": 431857, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b3a8c39/uploads/origins/60af3616-8958-4bc3-85b7-b5273824d680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c8a6b30d7946c790672cb371d756e34", "srcset": "https://si.imgix.net/8b3a8c39/uploads/origins/60af3616-8958-4bc3-85b7-b5273824d680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c8a6b30d7946c790672cb371d756e34, https://si.imgix.net/8b3a8c39/uploads/origins/60af3616-8958-4bc3-85b7-b5273824d680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72ccd5c2dc1b3fc1270585e1516dc95a 2x, https://si.imgix.net/8b3a8c39/uploads/origins/60af3616-8958-4bc3-85b7-b5273824d680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aea8bb05290e42b30cdd61bae33890d4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b3a8c39/uploads/origins/60af3616-8958-4bc3-85b7-b5273824d680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49daa01b75fdbb80152ca98215943151", "srcset": "https://si.imgix.net/8b3a8c39/uploads/origins/60af3616-8958-4