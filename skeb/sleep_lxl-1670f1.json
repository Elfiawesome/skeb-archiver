.net/ce4f93d2/uploads/origins/5ebb2a2c-6266-4eaa-903e-215f3b2566ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f4f3e28e1e400d87b523a87d3252856", "srcset": "https://si.imgix.net/ce4f93d2/uploads/origins/5ebb2a2c-6266-4eaa-903e-215f3b2566ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f4f3e28e1e400d87b523a87d3252856, https://si.imgix.net/ce4f93d2/uploads/origins/5ebb2a2c-6266-4eaa-903e-215f3b2566ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f98ddf8b3ef2f4ae2b6b8951c43c538 2x, https://si.imgix.net/ce4f93d2/uploads/origins/5ebb2a2c-6266-4eaa-903e-215f3b2566ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69ef3a5520664f60d3bfb896e19318ae 3x"}, "body": "こんにちは！\n私はこの2つのキャラクターを依頼したいです：\nhttps://toyhou.se/2450083.a-lys\nhttps://toyhou.se/41248.laerin\n二人ともティーンエイジャー（14歳くらい）です。二人ともよく旅行に行くので、新しい冒険で喜んでいる様子を描いてほしいです。\nまた、現代的な服装（必須ではありません）で描いていただけるとありがたいです。\n可能であれば、手をつないでいるところも描いていただけませんか？\nありがとうございました！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sleep_lxl/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2824174, "client_id": 1473258, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0446fcff/uploads/origins/38af0d38-f494-433e-97c8-77a1e53e3ce5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35736dbc26edefdecea39d3ec3a6ff10", "srcset": "https://si.imgix.net/0446fcff/uploads/origins/38af0d38-f494-433e-97c8-77a1e53e3ce5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35736dbc26edefdecea39d3ec3a6ff10, https://si.imgix.net/0446fcff/uploads/origins/38af0d38-f494-433e-97c8-77a1e53e3ce5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4da159f8a16a64491490abd2021a0b73 2x, https://si.imgix.net/0446fcff/uplo