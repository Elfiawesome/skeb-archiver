が大好きです！\n今回あまぐりさんに是非資料のキャラクターを描いていただきたく、リクエスト失礼いたします。\n\n◎TRPGで使用した当方のオリジナルキャラクター\n・25歳、男、165cm（+ブーツ8cm）\n・警官に近しい職業\n・草花を自在に操れる異能持ち\n・テンションが高く周りをよく見ている陽キャ、仕事は真面目にこなす\n・歌う事が好きでよく歌っている\n\n◎差し支えなければ2点お願いできればと思います\n・イラスト：シチュエーション、構図等はお任せいたします\n・SDイラスト（SNSアイコン用）：顔だけ等の簡素なもので構いません\n\n◎使用用途：X等SNSでの画像使用\n\nご検討のほどよろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/1nwUJh7tJZaaA2O3ZGipscvDK_3S4LdRH", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sleep_lxl/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2824174, "client_id": 2489570, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a8ff743/uploads/origins/fb327395-b54b-415b-b994-7764fab6f4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9a09014b1d29cd17f8cfe17bda60754", "srcset": "https://si.imgix.net/4a8ff743/uploads/origins/fb327395-b54b-415b-b994-7764fab6f4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9a09014b1d29cd17f8cfe17bda60754, https://si.imgix.net/4a8ff743/uploads/origins/fb327395-b54b-415b-b994-7764fab6f4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f5c63dfc6f612e4cf57db0678efdfca 2x, https://si.imgix.net/4a8ff743/uploads/origins/fb327395-b54b-415b-b994-7764fab6f4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b09865b5f66eb3b1b3ccc99299ca0090 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a8ff743/uploads/origins/fb327395-b54b-415b-b994-7764fab6f4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dacc1e0b8b527a26b45019719715f2cb", "srcset": "https://si.imgix.net/4a8ff743/uploads/origins/fb327395-b54b-415b-b994-7764fab6f4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dacc1e0b8b527a26b45019719715f2cb, 