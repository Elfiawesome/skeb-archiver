もみもみされながら正常位を主として交尾し\nご主人様の子種をたくさん注がれて椛は満足するようです。\n差分よりも新規絵を描かれる傾向があるとの事で\nどのように描かれるかはお任せします。\n\n服はおっぱいと結合部が見えれば全裸でも半脱ぎのどちらでもＯＫです。\n\nなお、同人誌の中では陰毛は生えていませんでしたが\n今回の依頼内では陰毛を描やしていただけると嬉しいです。\n\n以上、ご検討ください。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@koza900/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 956530, "client_id": 477526, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c97a0504/uploads/origins/e68ec56f-d83e-4e17-ad97-3fea2078d0be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=112cd7f5ecdfa3b3af72966ad1e176be", "srcset": "https://si.imgix.net/c97a0504/uploads/origins/e68ec56f-d83e-4e17-ad97-3fea2078d0be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=112cd7f5ecdfa3b3af72966ad1e176be, https://si.imgix.net/c97a0504/uploads/origins/e68ec56f-d83e-4e17-ad97-3fea2078d0be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76d83e98c3ae4a9e692abe5ef0ff2d67 2x, https://si.imgix.net/c97a0504/uploads/origins/e68ec56f-d83e-4e17-ad97-3fea2078d0be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a9515844250360f2cb75a714993bead 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c97a0504/uploads/origins/e68ec56f-d83e-4e17-ad97-3fea2078d0be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ca8e0c6dd7dc7275743c400a4cadb94", "srcset": "https://si.imgix.net/c97a0504/uploads/origins/e68ec56f-d83e-4e17-ad97-3fea2078d0be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ca8e0c6dd7dc7275743c400a4cadb94, https://si.imgix.net/c97a0504/uploads/origins/e68ec56f-d83e-4e17-ad97-3fea2078d0be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=abc2020231a6176ccdcc7665a9