us/1604058313708408833?s=46&t=yklg9bHOTvpxXzhASnkMGA ) ※ハトの顔やおめめは出ており、頭に付けている感じ。(ハトの顔が好きなので)\nあたりがあると嬉しいですが、あくまでもオプションリクエストなので、もちろん無くても嬉しいです。ハトだけで大喜び致します。\n\n何卒ご検討のほど、よろしくお願いします！！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 242, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "不知夜月🌟Skeb募集中", "screen_name": "izayoi_tuki", "avatar_url": "https://pbs.twimg.com/profile_images/2019261360430026752/WBUonr7p.jpg", "header_url": "https://pbs.twimg.com/profile_banners/898768568258449409/1762336843/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "novel"}], "banned": false, "nc": 16}, {"id": 70892, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ひおり🩵", "screen_name": "Ri_L_D", "avatar_url": "https://pbs.twimg.com/profile_images/1968876205886894080/02J2lxGT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1160610954956042240/1758251291/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "voice"}, {"genre": "novel"}], "banned": false, "nc": 17}, {"id": 407634, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ひや", "screen_name": "Shiya47", "avatar_url": "https://pbs.twimg.com/profile_images/1860638037304360960/q_lLzVxw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1189716876/1696857513/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expir