ナの他愛ないお喋りが彼の世界に彩りを添えていたりする。\n・夕食後、パートナーとともに紅茶を飲みつつ、その日自分が目にした景色や物事を話して聞かせるのが日課であり、毎日の楽しみ。本を朗読することも多い。\n・愛されている自信でいっぱい！\n\n＜その他＞\n・好きなもの：パートナー、甘いもの（特に紅茶や焼き菓子、フルーツタルトなど）、草花、ご機嫌な空模様\n・嫌いなもの：辛いもの、自分の翼（重いので）\n\n構図や衣服についてはお任せいたします。もしご負担が大きいようでしたらどうぞご放念ください。\n暑い日が続いています。くれぐれもお身体おいといください。\n\nhttps://drive.google.com/drive/folders/16SfQvNO-ud07pnAwLJApgVOxOpf2V0FZ?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@977red/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 746616, "client_id": 891266, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74705f84/requests/198471_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97efa222918bcf400db8c2c41c67c84c", "srcset": "https://si.imgix.net/74705f84/requests/198471_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97efa222918bcf400db8c2c41c67c84c, https://si.imgix.net/74705f84/requests/198471_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28c59611bee4891620a3acd555c2d85b 2x, https://si.imgix.net/74705f84/requests/198471_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bec1a46278979524d9c40fe9e2025a91 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74705f84/requests/198471_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4dd2be43454705a1e5cef3bb8b35ef7b", "srcset": "https://si.imgix.net/74705f84/requests/198471_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4dd2be43454705a1e5cef3bb8b35ef7b, https://si.imgix.net/74705f84/requests/198471_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1acf0a25be1466b9c7f53e03b2f931c9 2x, https://si.imgix.net/74705f84/requests/198471_0?bg=%23fff&auto=form