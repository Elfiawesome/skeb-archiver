n16歳、女性、水色髪、無表情キャラです。\nゲーム終盤でルミネスと敵対、戦闘になるシーンをお願いします。\n本来は主人公達に対して中立(味方寄り)で傍観しているキャラクターですが、ラスボスに意思を操られ、こちらを排除しようとしてきます。\n強そうな感じが分かるようなイラストだと嬉しいです。\n武器は槍、術は水属性を使用するイメージがあります(他の属性も使用します)。\nまた、\"不徳の羽\"という黒い羽を散らす攻撃が印象的です。\n\n資料URLの方に初登場時と戦闘時の動画を入れておりますので、宜しければ参考にしてください。\n無表情である事と、赤い耳飾りを忘れずにお願いします。構図的に見えない場合は無理に取り入れる必要はありません。\n\n御検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1QGG7tv8A0ejDwgBBGZQJnhhrDYJhCGas", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mubiuina/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 407443, "client_id": 61130, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aca763bf/uploads/origins/8e78c296-2bec-462f-bc6b-384c04951a38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a419a6793c87f0c0fa084d60ed678b7", "srcset": "https://si.imgix.net/aca763bf/uploads/origins/8e78c296-2bec-462f-bc6b-384c04951a38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a419a6793c87f0c0fa084d60ed678b7, https://si.imgix.net/aca763bf/uploads/origins/8e78c296-2bec-462f-bc6b-384c04951a38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df32f41ef205a5639f13ee94fd69e9ce 2x, https://si.imgix.net/aca763bf/uploads/origins/8e78c296-2bec-462f-bc6b-384c04951a38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba76266a4192d819ed4dfb58a4f5e468 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aca763bf/uploads/origins/8e78c296-2bec-462f-bc6b-384c04951a38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=566547eee39d0f84e55bbff5a37e98de", "srcset": "https://si.imgix.net/aca763bf/uploads/origins/8e78c296-2bec-462f-bc6b-384c04951a38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=566547eee39d0f84