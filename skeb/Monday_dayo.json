背景とキャラが分かれてるpsdまたは透過をを頂けると助かります。\n\n【イラストについて】\n・全身で動きのある構図(横見切れなし)だと嬉しいです！\n・基本衣装もしくは水着ゃ私服風でも大丈夫です(デザインはおまかせします)\n・髪型は前髪ありver(ロングヘアorポニーテール)\n・資料URLに立ち絵等あり。\n・私の魅力を引き出して頂きたい♪(にゃんにゃんポーズが多いので他のポーズだと助かります)\n\n【特徴】\n・目の色彩が虹色\n・胸元の肉球とハイビスカス\n・腰にポーション＆鞄\n・手のひらの手袋も肉球\n・耳にヒヨコ形のピアス\n・背中に金の羽\n\nX：https://twitter.com/nyaonuko_Vtuber\nYouTube：https://youtube.com/@nyaonuko\nHP：https://nyaonuko.my.canva.site/\n\nhttps://nyaonuko.my.canva.site/", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Monday_dayo/works/57", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ec9aec23/uploads/origins/a74ce56b-b423-4272-903d-fc22d85bc6ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f02d18822fc1d9d74b637d42232808eb", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 750573, "client_id": 283748, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Monday_dayo/works/56", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 750573, "client_id": 3394545, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd4c539f/uploads/origins/361da15d-c39f-47de-8113-ce6657e58a86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7345e2aa95214f64faaf9e46d807f221", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd4c539f/uploads/origins/361da15d-c39f-47de-8113-ce6657e58a86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbe617acc7f3c9bc327d16047e7fe604", "src_set": ""}, "body": "こんにちは！あなたの作品がかわいいので、私のキャラク