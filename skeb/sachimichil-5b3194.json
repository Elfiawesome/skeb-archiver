nscoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sachimichil/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 82294, "client_id": 3093296, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b740fb59/uploads/origins/6387caf2-48b6-4990-8a13-e0e2ddc8fbc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aae5d909a35a76308052f8cfc0736f5f", "srcset": "https://si.imgix.net/b740fb59/uploads/origins/6387caf2-48b6-4990-8a13-e0e2ddc8fbc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aae5d909a35a76308052f8cfc0736f5f, https://si.imgix.net/b740fb59/uploads/origins/6387caf2-48b6-4990-8a13-e0e2ddc8fbc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b50630fbeb8a0fe21a22de19f3571d6 2x, https://si.imgix.net/b740fb59/uploads/origins/6387caf2-48b6-4990-8a13-e0e2ddc8fbc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b440edeb42a838cb03e78d96bf91380e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b740fb59/uploads/origins/6387caf2-48b6-4990-8a13-e0e2ddc8fbc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9192d4121fb590c6cae6db79cc461769", "srcset": "https://si.imgix.net/b740fb59/uploads/origins/6387caf2-48b6-4990-8a13-e0e2ddc8fbc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9192d4121fb590c6cae6db79cc461769, https://si.imgix.net/b740fb59/uploads/origins/6387caf2-48b6-4990-8a13-e0e2ddc8fbc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b59a949f28b25bed8602ef42ac423ff 2x, https://si.imgix.net/b740fb59/uploads/origins/6387caf2-48b6-4990-8a13-e0e2ddc8fbc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=839bb4e596b227fc3c517b5ce99431f8 3x"}, "body": "お世話になっております、Vライバー事務所さ〜かす！所属のアン＝メイと申します。さちみちる先生のイラストのゆるタッチキャラのゾンビちゃんのイラストが縫い目や口内の色が人外っぽいにも関わらず大変可愛らしく自分もお願いしたいと思い今回依頼させていただきました。\n1枚目\n全身イラストで服装はお任せいたしますがロリィタ系の服でお願いしたいですが華ロリ、和ロリ以外のテイストでシチュエーションはお任せいたします。また、人物のみのPSDデータもいただけると嬉しいです。\nイラストを使用してグッズ、サムネイルを製作予定です、使えそうであれば配信の際に立ち絵として使用せていただくかもしれません。\n2枚目\n「暗明飯店」という架空のキョンシーメイドのコンセプトカフェのイラストでそちらの制服を着用したものをいただきたいです。膝くらいまでのイラストで出来れば目をうず目にしていただきたいです、イメージカラーが白と黒とシアンなのでその辺りの色も使いつつ制服のデザイン、構図はお任せいたします\nこちらも前述の通り使用させていただきます。\n3枚目\n2枚目のコンセプトカフェ制服姿のもので2頭身ゆるタッチキャライラストをお願いします、よろしければIRIAMで使える4000×2000px以内で正面向き、ポーズはお任せで描いていただけると嬉しいです（こちらがIRIAMの立ち絵ガイドになりますhttps://iriam.com/illustration_guide/）、差分で死に顔差分をくださいこちらも上記同様の使い方をする予定です。\n資料になります、人間の方で一枚目、ゾンビの方で2枚目、3枚目を描いてください。\nまた、瞳孔がひし形になっています、灰色の目の方は光の加減で何色にも見える灰虹色の瞳になっているのでお好きに塗ってください、青目側に小さい八重歯があります。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1Qwhq5aR0W9lIAesZBheORlnNkTlaFV64", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sachimichil/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 82294, "client_id": 3024343, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a6ed524/uploads/origins/4bf22dec-79b1-4b03-8581-8cfa90320e9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7eafb1f06956a694b7f814c60a1426fc", "srcset": "https://si.imgix.net/9a6ed524/uploads/origins/4bf22dec-79b1-4b03-8581-8cfa90320e9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7eafb1f06956a694b7f814c60a1426fc, https://si.imgix.net/9a6ed524/uploads/origins/4bf22dec-79b1-4b03-8581-8cfa90320e9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83f598ab4be01dd1e03c259c116f3446 2x, https://si.imgix.net/9a6ed524/uploads/origins/4bf22dec-79b1-4b03-8581-8cfa90320e9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=370805706dc6f2a8fb3ad1f1a2ff6e14 3x"}, "duration": null, "nsfw": false,