09a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8a32e8a13ffda3019324e2566539d44e 3x"}, "body": "突然のリクエスト失礼いたします。\n\npixivやFANBOXで、ににたんさんの描かれるかわいいキャラたちのお漏らしをいつも楽しんで拝見しています。\n\n今回、\n\n｢探偵の女の子のお漏らし｣\n\nをお願いしたいと思っています。\n\nターゲットの張り込みのシチュエーションで、証拠の写真を収めようとするもなかなかボロを出さず、先に尿意が限界に達してカメラ(またはスマホ)片手に漏らしちゃう感じです。\n\n女の子は探偵服に身を包んでいて、ボトムはキュロットでお願いしたいです。\n\n女の子や衣装の詳細なデザイン、背景等のもろもろの部分の表現はおまかせします。\n\nまた、ににたんさんの都合やリクエストの内容、金額等の条件がよくなければキャンセルしてもかまいません。\n\nもし、リクエストをお受けできそうでしたらよろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@22m_ninitan/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/51bcd077/uploads/origins/79f51f1a-7b03-4b5f-8401-18d278237cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e85c0c3961f3b55b3e71f65c09bf5704", "srcset": "https://si.imgix.net/51bcd077/uploads/origins/79f51f1a-7b03-4b5f-8401-18d278237cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e85c0c3961f3b55b3e71f65c09bf5704, https://si.imgix.net/51bcd077/uploads/origins/79f51f1a-7b03-4b5f-8401-18d278237cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c90f056de9dbb0361983cec3daa7e130 2x, https://si.imgix.net/51bcd077/uploads/origins/79f51f1a-7b03-4b5f-8401-18d278237cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e3ba2c93c67ad5df1a04112e4c19674 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3328023, "client_id": 2377243, "nc": 177}, {"path": "/@22m_ninitan/works/8", "private_th