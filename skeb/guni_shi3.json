ソースをかけた辛いピザが大好きです。 )  \n\n先生の静的でありながらtoxicな雰囲気が好きなので、PICKLEZの少し落ち着いた姿をリクエストしようと思います。 トイレの鏡の前での様子、配達を終えた後の暗い路地での休憩、自撮りやシャワー中の様子などなんでもいいです。 \n\nパーシュートベースですが、持ち味のかわいいデフォルメについていく必要はありません。 先生の絵柄、能力を思う存分発揮してください！ \n\n服や帽子、小物のディテールが正確でなくてもいいです！ よろしくお願いします！\n\n\nhttps://drive.google.com/drive/folders/1chGyc6lThzoqKsb1MfkvMfVTdy_Nz9El?hl=ko", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 727137, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "高縞✧新刊通販", "screen_name": "shima23k", "avatar_url": "https://pbs.twimg.com/profile_images/1969222153985015809/82W9QK3P.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1215968564844195845/1724957958/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 176}, {"id": 1304383, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "天魚いず", "screen_name": "amago_izu", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fb52c95dd-f850-4153-8281-18a7f8f4c4be.webp?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/96494897-a001-47f8-ba37-112e62c0d125.webp", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "skills": [{"genre": "art"}], "nc": 129}, {"id": 1673377, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "かなもの", "screen_name": "yayayakan", "avatar_url": "https://pbs.twimg.com/profile_images/1715657627756306432/owxKoTI-.png", "header_url": "https://pbs.twimg.com/profile_banners/120500297/1709443477/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": nu