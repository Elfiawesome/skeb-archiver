読みたい！と思い、skebお願いさせていただきました！\n\n二人がモチーフであったり登場していれば、小説でも短歌でも書きやすい形態で、かなむらさんに一任致します。\n強いて言えば、ゆきちゃんの事務所兼自宅でふたりが過ごしていると嬉しいです！\n\n「冬まほ」にちょうどの季節にskebを宣伝していらっしゃったので、今しかない！と思い、すかさずリクエストできて嬉しいです。\n\n最後に自探索者の資料もまとめて添付させていただきます……！よろしくお願い致します。\n\n【キャラシート】\nhttps://charasheet.vampire-blood.net/4231373\n\n【これまでの人生経緯SS】\nhttps://x.com/ituka_ituka_/status/1532796220090961920?s=46&t=Sua9rno0C2Rm4h39c7Q0ww\n\n【ビジュアル資料】\nhttps://x.com/ituka_ituka_/status/1502091518244704257?s=46&t=Sua9rno0C2Rm4h39c7Q0ww", "nc": 24, "word_count": 3160, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@liveindystopia/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 420233, "client_id": 2129137, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f821e2d/uploads/origins/c79a2a59-4318-4308-922c-8973ea9311c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8a2a029e630995d86a3d8227ada93f8", "srcset": "https://si.imgix.net/4f821e2d/uploads/origins/c79a2a59-4318-4308-922c-8973ea9311c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8a2a029e630995d86a3d8227ada93f8, https://si.imgix.net/4f821e2d/uploads/origins/c79a2a59-4318-4308-922c-8973ea9311c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3895b944e78356e980026c189307212 2x, https://si.imgix.net/4f821e2d/uploads/origins/c79a2a59-4318-4308-922c-8973ea9311c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c0b3033bfbed39a1c86ef614c864a7b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f821e2d/uploads/origins/c79a2a59-4318-4308-922c-8973ea9311c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d868b1cbe57be30156c20b2a7c3aafa1", "srcset": "https://si.imgix.net/4f821e2d/uploads/origins/c79a2a59-4318-4308-922c-8973ea9311c6?bg=%23fff&auto=fo