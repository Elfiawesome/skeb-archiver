899", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4185aeb/uploads/origins/dedd8dcb-f40a-4d85-b8fb-63fa625178a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38e70a5154d9b27f3a5bb147527b50c1", "src_set": ""}, "body": "はじめまして。\n\n東方Projectの藤原妹紅をお願いしたく存じます。\nカッコいいよりも美人系が望ましいです。\n\n構図などの指定はございませんので、お任せいたします。\n\n簡単な文章でのご依頼となり恐縮ですが、\nご検討のほど、よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yurerugin/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1805783, "client_id": 17477, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84295a35/uploads/origins/34afef37-32fe-4c61-8ecb-4d6efc8f3116?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0facb42735dc6b29ce71dd4fde93df0f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84295a35/uploads/origins/34afef37-32fe-4c61-8ecb-4d6efc8f3116?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d35b3ecb2538676ecca72f1807c59273", "src_set": ""}, "body": "はじめまして。\n大東方展で見てきた蓬莱人形のジャケ子さんをお願いしたいです。あのキャラは冴月麟説もかつてありましたが違うようですね、、、。ZUN絵では手足に天井から糸が付いていて、スカートが針で床に縫い付けられてる構図でしたが、構図はお任せします。勝手ながら赤色のイメージですが、色はお任せします。実は以前にワダンテさんに依頼しておりますが、是非銀木犀さんにも頼みたく、よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 19940, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "U-ka/ゆーか🐅", "screen_name": "u_ka", "avatar_url": "https://pbs.twimg.com/profile_images/1803432611139952640/kc_-NYIR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/28779695/1746948978/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "f