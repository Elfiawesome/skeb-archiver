いている。相手に近づいてからかい、彼に対して強い所有欲を抱いている。   \n\n二人の性格の範囲内であれば、どのようなやり取りでも自由に描いていただいて構いません！リンク先に詳細な設定や資料を用意しています。描きたい衣装も自由に選んでください！   https://drive.google.com/drive/folders/1cZmd90dTtnOVahtEIy8KzVNc4KVRZIrH?usp=share_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_v_x_x_v/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3759998, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75aff93f/uploads/origins/c9ff0761-ca51-49df-8bbd-f5123ea4cd70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d718a8445f7c09d0a10588ac48b61607", "srcset": "https://si.imgix.net/75aff93f/uploads/origins/c9ff0761-ca51-49df-8bbd-f5123ea4cd70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d718a8445f7c09d0a10588ac48b61607, https://si.imgix.net/75aff93f/uploads/origins/c9ff0761-ca51-49df-8bbd-f5123ea4cd70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f35bf88b5e3c437334f0713762421d8 2x, https://si.imgix.net/75aff93f/uploads/origins/c9ff0761-ca51-49df-8bbd-f5123ea4cd70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b0387ec7c0be7ee36b2a0d2c0108eab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75aff93f/uploads/origins/c9ff0761-ca51-49df-8bbd-f5123ea4cd70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d3d91f17a997ba4757a7a95c3e92f73", "srcset": "https://si.imgix.net/75aff93f/uploads/origins/c9ff0761-ca51-49df-8bbd-f5123ea4cd70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d3d91f17a997ba4757a7a95c3e92f73, https://si.imgix.net/75aff93f/uploads/origins/c9ff0761-ca51-49df-8bbd-f5123ea4cd70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2f49509962a168d42242d4707d3354da 2x