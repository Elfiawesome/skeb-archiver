fault_amount": 3000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@ssc_hideiyo/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 38686, "client_id": 806229, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf2eb2c8/uploads/origins/cad3a0d2-4482-46b4-bdb0-93e1bd8b516c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=958d1e129769d23b7d8cc3b8a4e5986d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf2eb2c8/uploads/origins/cad3a0d2-4482-46b4-bdb0-93e1bd8b516c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=960c1a8b129d654e5ba7f2f927d62995", "src_set": ""}, "body": "こんにちわ。伊予さんの昔の作品である「XOHリプレイ『災いの門【短編漫画】』」ので\nもしヒロインであるハンマーブレイカーが後手・持久戦の敗北ルートになってしまった場合のIFを依頼します\n\nハンマーブレイカーがキス魔怪人デロップにたくさんキスされ犯されて、デロップの永久奉仕奴隷になり、ヒロインを完全引退してしまう末路になるのをお願いします。\n\n細かい部分はお任せしますのが、可能であったらハンマーブレイカーの敗北宣言を入れてほしいです。\n\n是非ともお願いします\n\nhttps://www.pixiv.net/artworks/110154274", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ssc_hideiyo/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 38686, "client_id": 88626, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf12a00d/uploads/origins/b7064be5-fa37-4f54-b857-e2160787efb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a67af5de8a636d3152133096de125b30", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf12a00d/uploads/origins/b7064be5-fa37-4f54-b857-e2160787efb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9b2ea6527cba7a6d5cd2110cdcb9bf5", "src_set": ""}, "body": "こんにちは、skebでは初めて挨拶します！\n\nもし可能なら、勇者ちゃんが淫魔将に敗北後同族化する内容のイラストをお願いしたいと思います！\n\n設定では合わない描写という気がしますが、以前から見るたびに勇者ちゃんが淫魔将の同族になる内容のシチュあるいは絵を見たかったので機会があるときお願いします！\n\n一度分量と細部の内容と要素はすべてオマカセでお願いし、主に勇者ちゃんの淫魔眷属化の描写を見たいです！\n\n淫魔化以降の勇者ちゃん姿の場合、淫魔将と肌色と淫紋などが同じで、角や翼の有無、服装、目の色の変化の有無などはおまかせでお願いします。ヘアスタイルと髪の色の場合、人間時代の特徴が維持されると見たいです...！\n\n内容面では、主に敗北後最初は抵抗するような勇者ちゃんが徐々に自発的に、あるいは魅了や洗脳のような要因によって淫魔将の眷属に生まれ変わる展開と考えたので、変化描写と勇者ちゃんの身体的／心理的変化の描写などを見たいです..！\n\nいろいろ複雑なリクエストですが確認していただきありがとうございます、またよろしくお願いします！もしよろしければ、よろしくお願いします！", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ssc_hideiyo/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 38686, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b01764c3/uploads/origins/34e346c7-97f3-48bb-a63d-dad390198d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cafb762b23591312daa74f987c2d2f20", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b01764c3/uploads/origins/34e346c7-97f3-48bb-a63d-dad390198d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5192da10cab140d2359892571e250ff9", "src_set": ""}, "body": "こんにちは!!\n\n以前Pixivで拝見した「妖力ヌポイラー」\n(https://www.pixiv.net/artworks/65880206)のイラストが中々に性癖に来たので依頼しました!!\n\n何卒御一考よろしくお願いいたします。\n\n・依頼内容\n文の仇討ちに来た犬走椛(ふたなり)が案の定早苗に返り討ちに遭うr18イラスト\n\nメインの構図としては早苗にパイズリ搾精される椛の様子を第三者視点で見た構図でお願いします。\n搾られて悶える椛の表情が見える様な構図だと嬉しいです。\n\n指定のない点についてはお任せしますので何卒よろしくお願いいたします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ssc_hideiyo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 38686, "client_id": 517388, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/059c1bb7/uploads/origins/8d83bb02-535f-499b-8