lur=200&s=0a86c34f3af57931c031979177e67a27", "src_set": ""}, "body": "勇者ちゃんがモナク＝ノナ＝モガリカ（黒魔将）さんに捕まり\n上のお口でごっくん丸呑みされて\n魔力を吸収される度にお腹の中でイカされた後\n吐き出されちゃうシチュをお願いできればなぁと…\n（吐き出されたあともビクンビクン感じちゃう勇者ちゃん…）", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ssc_hideiyo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 38686, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc5c81ce/requests/158129_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13b2e63af1798a8dbf09bb89c2947046", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc5c81ce/requests/158129_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f2363fa858c77db74237fa877a61c65", "src_set": ""}, "body": "いつも描かれている、南十字秀伊予様の子さんの勇者ちゃんでお願いします。\n\n２コマでお願いします。\n\nお題としては、ソウルスティールとか魂抜き出しをキスでされて、魂を吸い取られる。です。\n\n・１コマ目\n勇者ちゃんが敗北して磔（十字架かなにか）にされており、\nサキュバスに濃厚なキスをされている。（クチュクチュ音とか、勇者ちゃんが涙目ながらも顔を赤らめている）\n\n・２コマ目\n\nサキュバスが口を思いっきり離すと（ダイナミックな動きがいいです）、サキュバスと勇者ちゃんの口の間をつなぐように青い光がつながっている。\n（勇者ちゃんの魂が吸い出されている）\n勇者ちゃんの表情は、瞳が宙を泳いでください。魂を吸引される快楽で何度も何度も絶頂させられている状態です。\n\nこちらの内容でよろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ssc_hideiyo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 38686, "client_id": 167014, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c988b21/requests/80644_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=980c3593d54177ba7164bd23db295711", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c988b21/requests/80644_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h