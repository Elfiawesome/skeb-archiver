________）のアイコンやヘッダ、同名義の他SNSのアイコン等\n\n先生の裁量におまかせするところ多く申し訳ありませんが、ご承認いただけますと幸甚です。\nよろしくお願いいたします。\n\n資料URLについて\nリンク先はWeather PlanetのHP、ひなたさんの紹介ページです。基本情報が記載されています。また、Galleryというボタンを押していただけましたら三面図が表示されますので、ご参考にいただければと思います。\n\nhttps://weather-pla.net/members/appare-hinata/", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Bame_Zayin/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3919222, "client_id": 2788731, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59a04bc9/uploads/origins/f53c0051-d473-46ec-a45d-18ef53eeb794?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf2565f9ec3936f948d09b1e84ebd590", "srcset": "https://si.imgix.net/59a04bc9/uploads/origins/f53c0051-d473-46ec-a45d-18ef53eeb794?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf2565f9ec3936f948d09b1e84ebd590, https://si.imgix.net/59a04bc9/uploads/origins/f53c0051-d473-46ec-a45d-18ef53eeb794?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4be26c9b02b1a22ef50bc2bfe9808273 2x, https://si.imgix.net/59a04bc9/uploads/origins/f53c0051-d473-46ec-a45d-18ef53eeb794?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4dedd601c9ecd2cd29c83296f8d440f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59a04bc9/uploads/origins/f53c0051-d473-46ec-a45d-18ef53eeb794?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d74f128d9349bf39077079337412754", "srcset": "https://si.imgix.net/59a04bc9/uploads/origins/f53c0051-d473-46ec-a45d-18ef53eeb794?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d74f128d9349bf39077079337412754, https://si.imgix.net/59a04bc9/uploads/origins/f53c0051-d473-46ec-a45d-18ef53eeb794?bg=%23fff&auto=format%2Ccompress&fm=webp&dp