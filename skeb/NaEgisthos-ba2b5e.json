ix.net/1fb25c5b/uploads/origins/524b4763-bb2b-4fd8-ad03-f8482e960baa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=212392cb8ba4a00bbbe7172bd089c0b4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1fb25c5b/uploads/origins/524b4763-bb2b-4fd8-ad03-f8482e960baa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d835c404d39db7e69b2a725c9554d911", "srcset": "https://si.imgix.net/1fb25c5b/uploads/origins/524b4763-bb2b-4fd8-ad03-f8482e960baa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d835c404d39db7e69b2a725c9554d911, https://si.imgix.net/1fb25c5b/uploads/origins/524b4763-bb2b-4fd8-ad03-f8482e960baa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eb09308acae28f29cc2cd05781b3cfd7 2x, https://si.imgix.net/1fb25c5b/uploads/origins/524b4763-bb2b-4fd8-ad03-f8482e960baa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b7896e14894ac299ea9506e038c77205 3x"}, "body": "🐯👋こんにちは！お元気ですか？あなたのアートスタイルが大好きです！私は「Taehoongie」という名のVTuberです。\n\n私のキャラクターを描いていただけませんか？ 私のキャラクターはオリジナルデザインです。トラをモチーフにした、明るく陽気な男の子です。怖がりだったり、恥ずかしがり屋だったりします。90年代（1990年代）のレトロな雰囲気、ファストフード、そしてかわいいビデオゲームを連想させるキャラクターです。\n\n🎨 キュートでチャーミング、あるいはセクシーなイラストを描いていただけると嬉しいです！ 衣装が複雑な場合は、遠慮なく簡略化していただいて構いません（ジャケットを着用しているか、脱いでいるかなど）。オレンジ色のアイメイク、フォーク、首元の黄色い髪、そしてトラの縞模様は忘れずに描いてください！体の作りは細身でも筋肉質でも、お任せします！可能であれば、PNGまたはPSD形式で、背景が透明な状態でキャラクターをいただけると嬉しいです。\n\n🔗 デザインシートはこのGoogleドライブにあります：https://drive.google.com/drive/folders/1FaYt6Px4gFoySrIxBBYUn-Vycgx70yzM?usp=sharing \n\n使用目的は、XなどのSNS（投稿、アイコン、グラフィック）です。ご依頼をご検討いただき、ありがとうございます！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@NaEgisthos/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2938673, "client_id": 2930062, "vtt_url": null