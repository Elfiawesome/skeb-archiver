op&w=200&h=200&s=2897e1445cd27ce8a0f7a65981f620a8, https://si.imgix.net/c4614bc7/uploads/origins/3814ab87-3855-40e9-b84a-3e7619ecf076?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d05f30ea0d244f0042173315c19134b8 2x, https://si.imgix.net/c4614bc7/uploads/origins/3814ab87-3855-40e9-b84a-3e7619ecf076?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e819333356bc8fbd1e781b6527de1d56 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4614bc7/uploads/origins/3814ab87-3855-40e9-b84a-3e7619ecf076?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d13f173f83ca1517ae0d544a11112e0", "srcset": "https://si.imgix.net/c4614bc7/uploads/origins/3814ab87-3855-40e9-b84a-3e7619ecf076?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d13f173f83ca1517ae0d544a11112e0, https://si.imgix.net/c4614bc7/uploads/origins/3814ab87-3855-40e9-b84a-3e7619ecf076?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e22818751eaf6b14ec89e4297ad8324b 2x, https://si.imgix.net/c4614bc7/uploads/origins/3814ab87-3855-40e9-b84a-3e7619ecf076?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eb208d0aa59bc4b06ee25b9928888ea6 3x"}, "body": "Triphonica！バージョンのセレネアちゃんのイラストをお願いします。\nhttps://ci-en.dlsite.com/creator/8262/article/1105300\n胸のパイズリ穴からちんぽを挿入して、両手で恋人繋ぎをしたノーハンドフェラで、\n以前に描いていた下記イラストが好きなので、同じように仮性包茎への皮フェラを希望します。\nhttps://skeb.jp/@almichadia/works/2\n\nシチュは、セレネア好きの住人からのセクハラを大目に見続けていた結果、\nなし崩し的にフェラ抜きしてあげる関係となり、\nなんだかんだ言って、セレネアちゃん的にもちんぽを気に入って積極的になっている、\nみたいなイメージですが、変えても大丈夫なので任せます。\n\nよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@almichadia/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1095317, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c3e0acfe/uploads/origins/b340b329-fc1f-4f34-bd4a-fb7477065cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dadb38039581d2edc54157734be605f", "srcset": "https://si.imgix.net/c3e0acfe/uploads/origins/b340b329-fc1f-4f34-bd4a-fb7477065cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dadb38039581d2edc54157734be605f, https://si.imgix.net/c3e0acfe/uploads/origins/b340b329-fc1f-4f34-bd4a-fb7477065cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e5df00fbe90c758b1c26fd0c01669fc 2x, https://si.imgix.net/c3e0acfe/uploads/origins/b340b329-fc1f-4f34-bd4a-fb7477065cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de9092ce0a8b4f37f9b92cfa50fa66a1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c3e0acfe/uploads/origins/b340b329-fc1f-4f34-bd4a-fb7477065cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d188afded641baa98f49cca759b4a17", "srcset": "https://si.imgix.net/c3e0acfe/uploads/origins/b340b329-fc1f-4f34-bd4a-fb7477065cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d188afded641baa98f49cca759b4a17, https://si.imgix.net/c3e0acfe/uploads/origins/b340b329-fc1f-4f34-bd4a-fb7477065cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dfe9010412a0315066637b9928754db7 2x, https://si.imgix.net/c3e0acfe/uploads/origins/b340b329-fc1f-4f34-bd4a-fb7477065cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=54850979df0ebf054c3be34cee6beaf3 3x"}, "body": "Fantanica!のルミカ(生えてる状態)をお願い致します。\nセリフ差分ありでお願いします。\n\nダンジョン奥深くに潜っていた所、床にピンク色の小さな穴が空いているのを見つける。\n→事前の情報収集で聞いていた「極上のオナホトラップ」だと気付き、あからさまな罠に引っかかる奴はいないと思いながらも、「極上」とまで呼ばれるオナホが気になり、「1回だけ・・」とイチモツを床の穴に挿し込む。(端から見れば床オナの様な姿勢)\n→確かに良い感触だが、期待した程ではないな、と手足に力を入れて引き抜こうとした瞬間、カリ部分を中心に凄まじい快楽が生まれ、足腰が砕け、引き抜きかけたイチモツを自重で再び根本まで押し込んでしまう。\n→引き抜く時の引っ掛かりで生まれる刺激に特化している事を理解し、刺激を抑える為にゆっくり、少しずつ引き抜いていく。\n→ジワジワとした刺激を耐え、射精寸前ながらも残り僅かで引き抜けるというところで、アームが左右に現れ、腰を掴んで強制ピストンさせられる。\n→溜まった射精欲が爆発するが、射精中も強制ピストンが止まらないので、連続絶頂\n→n時間後、泣いて許しを請いながらヘコヘコと腰を振らされ射精する姿\n→更にn時間後、頭が快楽で狂い受け入れる姿\n→更に更にn時間後、完全に出すもの出し尽くし、イチモツがスッカリ小さくなった事で漸く抜けるが、既に頭がパーになり目からハイライトが消え、意味を持たない声を呻きながら放心する姿(そのまま終わりを告げるようにお漏らししてエンド)", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@almichadia/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cac3e0a2/uploads/origins/61961ff7-cfbb-4b12-9aae-270fe01147b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32134b67eff1c02d64af72a5fd66d9e8", "srcset": "https://si.imgix.net/cac3e0a2/uploads/origins/61961ff7-cfbb-4b12-9aae-270fe01147b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32134b67eff1c02d64af72a5fd66d9e8, https://si.imgix.net/cac3e0a2/uploads/origins/61961ff7-cfbb-4b12-9aae-270fe01147b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=749e5f734b858050c06511de7e3f750e 2x, https://si.imgix.net/cac3e0a2/uploads/origins/61961ff7-cfbb-4b12-9aae-270fe01147b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2cc8e573d708c13d0056f1438078fa91 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1095317, "nc": 160}, {"path": "/@almichadia/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/019ff1f1/uploads/origins/e9ade23c-c715-470b-8685-ee202d0aa387?bg=%23fff&auto=format%2C