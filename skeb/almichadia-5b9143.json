lient_id": 44650, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e4ea78a/uploads/origins/dc552b97-66bd-4ee5-adef-bf64cedbe652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f5215a56b357a5bdc2e9a3925427021", "srcset": "https://si.imgix.net/1e4ea78a/uploads/origins/dc552b97-66bd-4ee5-adef-bf64cedbe652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f5215a56b357a5bdc2e9a3925427021, https://si.imgix.net/1e4ea78a/uploads/origins/dc552b97-66bd-4ee5-adef-bf64cedbe652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1142098aef8b0436ba7c4de54ef4c69d 2x, https://si.imgix.net/1e4ea78a/uploads/origins/dc552b97-66bd-4ee5-adef-bf64cedbe652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ddd5495c903e553cd652a512b1a4ff0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e4ea78a/uploads/origins/dc552b97-66bd-4ee5-adef-bf64cedbe652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c70b55d6a08f33afe4d50814c36df499", "srcset": "https://si.imgix.net/1e4ea78a/uploads/origins/dc552b97-66bd-4ee5-adef-bf64cedbe652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c70b55d6a08f33afe4d50814c36df499, https://si.imgix.net/1e4ea78a/uploads/origins/dc552b97-66bd-4ee5-adef-bf64cedbe652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a4a01459695849a085f776a6dedcdb6 2x, https://si.imgix.net/1e4ea78a/uploads/origins/dc552b97-66bd-4ee5-adef-bf64cedbe652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e1164a245b68c24f08b30e0536a98fc 3x"}, "body": "お久しぶりです、skeb再開お待ちしておりました。\n今回のリクエストですが以前描いて頂いたロキシーちゃんのスライム膀胱寄生イラストをもとに差分を複数点描いて欲しいです。\n\nシチュは『前回より強力なスライムに膀胱寄生され、強すぎる媚毒によって膀胱収縮筋が完全に弛緩してしまい、どんなに力んでもひり出せずパニックを起こしながらイキまくるロキシー』と言った感じのシチュを描いて欲しいです（いわゆる『したいのにできない』シチュ）。\n\n前回同様にスライムに寄生された膀胱断面図を描いて欲しいのですが、今回は膀胱だけでなく尿道部分も描写して欲しいです。\nまたスライムは前回の強化版ということでコアを２個に増量し、表面に無数のイボイボを生やして欲しいです（触覚ボールやリフレックスボールのような形状）。\n\n差分は以下のようなシチュを金額に見合う範囲でお願いします。\n・膀胱がパンパンになるどころか尿道すらはち切れそうなほどスライムが大量増殖\n・スライムが身体を縦横に伸縮させて尿道膀胱を歪ませるように激しく揺さぶる（膀胱そのものが電マのように振動する様子）\n・２つのコアがそれぞれ尿道内を高速反復＆膀胱内を跳ね回る\n・２つのコアがそれぞれ尿道口付近（陰核脚のある部分）と膀胱底（子宮側の膀胱壁、泌尿器で最も敏感な部分）に密着しながら高速回転\n・尿道からスライム粘液が僅かに出てきてロキシーに「やっと出ていてくれる…！」と希望を抱かせる\n・↑の続きで、尿道から出てきたスライム粘液がクリに纏わりついて、クリをサンドバッグのように上下左右に激しく弾き回す\n・スライム粘液が熱を帯びながら淡く発光（エネルギーチャージ的な）、命の危険を察知して子どものように泣きじゃくるロキシー\n・↑の続きで、スライム全体が激しく放電（アクメビームの全方位放射）\nその他、快楽と尿意に特化した責めを思い付く限り描いて貰えると嬉しいです。\n\n何度絶頂を繰り返してもどんなに泣き叫んで希っても、一生解放されない気が狂うほどの快楽と尿意に苦しめられ続けるロキシーちゃんをぜひよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@almichadia/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/73b1cb77/uploads/origins/3d0e7c16-c607-4683-914f-6e412cda0ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72ab149d815459243aa83cc849971f2c", "srcset": "https://si.imgix.net/73b1cb77/uploads/origins/3d0e7c16-c607-4683-914f-6e412cda0ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72ab149d815459243aa83cc849971f2c, https://si.imgix.net/73b1cb77/uploads/origins/3d0e7c16-c607-4683-914f-6e412cda0ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=74a5e24a49705ef551d976d75df3a976 2x, https://si.imgix.net/73b1cb77/uploads/origins/3d0e7c16-c607-4683-914f-6e412cda0ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=390f1e4509f7ec461bddc9