c-4ac7d05c43e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9dfbbbf79246991fc1e110d7fb6959b, https://si.imgix.net/40cbf74e/uploads/origins/f77a5291-794a-48d0-864c-4ac7d05c43e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b1657e8f5a8783f30bd1dc93fa7bf986 2x, https://si.imgix.net/40cbf74e/uploads/origins/f77a5291-794a-48d0-864c-4ac7d05c43e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a8c284af35cbf14625b92565b3c6914 3x"}, "body": "82さん\n\nなぜか大食いチャレンジに挑戦して、満身創痍になる篠澤広を描いていただけないでしょうか。\n具体的には、\n明らかにキャパオーバーなチャレンジに挑戦する広(3kgくらい)。\n・すぐギブアップするだろうと思って見ていたら意外と頑張る様子。\n・そこそこ食べてかなり辛そうだが、目の前の困難に興奮してる様子\n・完食は見えてきたが、興奮してる余裕もなく、青ざめた顔でえずきながらなんとか食べる様子。\n・完食したが満身創痍で、話す余裕もない様子。\n\n描いていただきたい要件としては、\n・段々膨れてパンパンになっていくお腹(ポッコリお腹ではなく、最終的には張り詰めてこれ以上入らない感じ)\n・食べ進めていくにつれ、余裕がなくなっていく表現\n\nご検討のほどよろしくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@82_tbk/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/19785d7e/uploads/origins/3a421f16-c25e-4dcd-a343-4cfacc722ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1987cdd3962e0d4c9da9284b235c31a2", "srcset": "https://si.imgix.net/19785d7e/uploads/origins/3a421f16-c25e-4dcd-a343-4cfacc722ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1987cdd3962e0d4c9da9284b235c31a2, https://si.imgix.net/19785d7e/uploads/origins/3a421f16-c25e-4dcd-a343-4cfacc722ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b9fed48740057507530577f269f0440 2x, https://si.imgix.net/19785d7e/uploads/origins/3a421f16-c25