ormat%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85262f5e0ceafee0ea403cd507f82aac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e550b086/uploads/origins/01ece81d-7c38-45b5-ace5-a9a910575c88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a2f21f76e49c9689667ca99a8c0c100", "srcset": "https://si.imgix.net/e550b086/uploads/origins/01ece81d-7c38-45b5-ace5-a9a910575c88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a2f21f76e49c9689667ca99a8c0c100, https://si.imgix.net/e550b086/uploads/origins/01ece81d-7c38-45b5-ace5-a9a910575c88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d0aa30ab1510876916d754c2e1495ce3 2x, https://si.imgix.net/e550b086/uploads/origins/01ece81d-7c38-45b5-ace5-a9a910575c88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16104a9424ef0e7373a0c9c78dbd67eb 3x"}, "body": "はじめまして、ツイッターやpixivなどでそちら様の作品を多数拝見させていただいております。\nアイドルマスターシンデレラガールズの「夢見りあむ」を中心としたシチュエーションを描いていただけないでしょうか。\nりあむと、「女性P」のカップリング絵のようなものをお願いしたいです\nなお、ふだんそちら様が描かれている女性Pとは別人という設定のようになるようにお願い致します。\nまた、露出などは無いものでお願い致します。宛先も無しでお願い致します。\nそれ以外の詳細な状況はお任せいたします。描きやすさ優先で自由にしていただければ幸いです。\n\n特に提供できる資料などもない中おまかせする部分が多くなり、負担増をうまく把握できていないなど複雑なもので申し訳ございませんが、可能であればお願いできればと存じます。\n女性Pを絡めた作風の素晴らしさや、絵のスタイルなどがとても好きです。これからも大変心より応援しております。\n\nなお大変恐縮ですが、現在ツイッターシャドウバン中につき、ツイッター側でのお礼はできないかもしれません、その場合ご容赦いただければと存じます。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nmkj344/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 989957, "client_id": 525935, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd938794/uploads/origins/0618dfee-64f6-4de8-a3e9-954ab5409daf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fd51e085b01941f0bdab