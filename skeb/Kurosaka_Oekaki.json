d&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad82a2a02d1cf055e28f7a979afe49e5", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 705711, "client_id": 441042, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Kurosaka_Oekaki/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 705711, "client_id": 52320, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84321b58/uploads/origins/a947856f-915f-477e-bf95-571f8db2244a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf1af06c98efa2976a0f82ab4e2f81b3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84321b58/uploads/origins/a947856f-915f-477e-bf95-571f8db2244a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bb50502d4ca97dc56650f2692e916cf", "src_set": ""}, "body": "黒坂イリアさんはじめまして。\n以前からTwitterやpixivで、黒坂さんの描かれる、ガチムチマッスルでセクシーえっちな美女のイラスト、毎回楽しませていただいております！\n新年記念リクエスト募集中との事で、ぜひリクエストさせていただきたいです！\n黒坂さんのオリジナルキャラである、褐色筋肉陥没乳首グラマラス美女の樹里さんが大変好みです!!\nそこで今回は、樹里ちゃんと、少し前に長身ガチムチ爆乳金髪番長美女として話題になった、『ブルーアーカイブ』の栗浜アケミ嬢をお願いできますでしょうか？\n黒坂さんのテイストにピッタリだと思うので、ぜひお願いしたいです！\n\nリクエストキャラ：樹里(黒坂さんOC)＆栗浜アケミ(『ブルーアーカイブ』)\n体型：2人とも腋毛や下の毛は無毛\n樹里→黒坂さんが描かれる樹里ちゃんそのものでお願いします\nアケミ→高身長でガチムチマッチョ メロン型の爆乳 エイトパックに割れた腹筋 ムキムキのぶっとい太もも\n表情：\n樹里→セクシーで色っぽい表情\nアケミ→公式のすました表情に、頬をほんのり赤く染めている\n服装：2人とも全裸\nポーズ：2人で向かい合うように立っている\n樹里→両手を乳房の下にまわして腕を組んでいる 胸の下に手を入れているせいで、爆乳がより強調されている\nアケミ→両手を腰に添えている 胸を張って仁王立ち 胸を張っているので、爆乳がより強調されている\n\n指定が細かく申し訳ございません。ぜひよろしくお願いいたします！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kurosaka_Oekaki/works/19", "private_thumbnail_image_u