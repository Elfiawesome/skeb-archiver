描いて欲しいメインのシーンは2つで、\n①おばさんが身体を洗ってあげると言ってゼシカの後ろから大きな胸をもみほぐすところ。両手とも乳首ごと押さえ込むようにガッチリ掴んでいてほしいです。\n\n②おばさんが後ろから手マンするところ。右手はゼシカのお腹側から、左手はゼシカの股の間から通しての手マン。ゼシカは顔を真っ赤にしながら爆乳を揺らして感じている風に描いて頂きたいです。\n\nその他のシーンは小さなコマでいいので、お風呂場に入ってきて「おっきくなったねぇ〜」と言われたり、大きなお尻を叩かれるシーンなどもあったら嬉しいです。\nゼシカの胸は目一杯大きく描いていただければ幸いです。\n\nhttps://www.pixiv.net/novel/show.php?id=14071113", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@machimachida3/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 53440, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/afdb4dd7/requests/162948_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf003f49b05761222cfc70112d6a82af", "srcset": "https://si.imgix.net/afdb4dd7/requests/162948_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf003f49b05761222cfc70112d6a82af, https://si.imgix.net/afdb4dd7/requests/162948_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=447c5b62ccb2cd28ba4f973a7e747f72 2x, https://si.imgix.net/afdb4dd7/requests/162948_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a94148960571604807abee96e72aeee4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/afdb4dd7/requests/162948_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f02de807b588addf2b6848b3649affd", "srcset": "https://si.imgix.net/afdb4dd7/requests/162948_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f02de807b588addf2b6848b3649affd, https://si.imgix.net/afdb4dd7/requests/162948_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dcf4e1be2bea710928f254c1abf59410 2x, https://si.imgix.net/afdb4dd7/requests/162948_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c10059d7139e65fc6e862ae4608b0abf 3x"}, "body": "skeb新着絵のマルティナに目が止まってリクエストしにきました。\n\n資料のような男性主観の尻コキ絵をお願いしたいです。\n衣装は先日のあぶない水着かデフォの衣装か迷いますが、デフォの方で。\n\nローション（オイル？）を垂らしたお尻で優しくお尻を押し付け尻コキ中。\nお尻のボリュームと包まれるヌルヌル感であっという間に射精しそうになって悶ている勇者。\n\n先日の絵のように優しくその様子を見るマルティナ。\n\n可能であれば、射精中～後も気づかないふりをして尻コキし続け「ん？　どうかした？」という状態のマルティナさんに対して快楽のあまり「もう出てるから止め・・・いや　やっぱ止めないで」と自分でも何を言ってるかわからず混乱状態になっている勇者の差分もお願いします。\n\nhttps://www.pixiv.net/artworks/29027256", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@machimachida3/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 53440, "client_id": 88832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9bef484c/requests/148126_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1d44723087ff5181df0c9e33fff3cf8", "srcset": "https://si.imgix.net/9bef484c/requests/148126_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1d44723087ff5181df0c9e33fff3cf8, https://si.imgix.net/9bef484c/requests/148126_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7b2063bb968188bd0dd30709e789aa6 2x, https://si.imgix.net/9bef484c/requests/148126_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ff4119035451e63c017db8b6358b6d6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9bef484c/requests/148126_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebacaaa4a37e53889db5b6d56f96ce10", "srcset": "https://si.imgix.net/9bef484c/requests/148126_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebacaaa4a37e53889db5b6d56f96ce10, https://si.imgix.net/9bef484c/requests/148126_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd812023b1f6e