format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44472b85ef7e3ad2135028b03db01a8f", "srcset": "https://si.imgix.net/97dd35ca/uploads/origins/719b06b0-2259-47a3-9c7f-3779f6c9071a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44472b85ef7e3ad2135028b03db01a8f, https://si.imgix.net/97dd35ca/uploads/origins/719b06b0-2259-47a3-9c7f-3779f6c9071a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20f4d2b7d5b158e999584126b358dc9e 2x, https://si.imgix.net/97dd35ca/uploads/origins/719b06b0-2259-47a3-9c7f-3779f6c9071a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e8e09306326c2cbb6d79dec17a92fc8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97dd35ca/uploads/origins/719b06b0-2259-47a3-9c7f-3779f6c9071a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57eba209a9edd84b8c2a31fcacd71743", "srcset": "https://si.imgix.net/97dd35ca/uploads/origins/719b06b0-2259-47a3-9c7f-3779f6c9071a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57eba209a9edd84b8c2a31fcacd71743, https://si.imgix.net/97dd35ca/uploads/origins/719b06b0-2259-47a3-9c7f-3779f6c9071a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1a5295d8834cfe62794571c53eaaec8d 2x, https://si.imgix.net/97dd35ca/uploads/origins/719b06b0-2259-47a3-9c7f-3779f6c9071a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dc322ec661ac189ef0cf670b1bf3b1d8 3x"}, "body": "あなたの作品が大好きです！私のオリジナルカップルです。男は穏やかで優しい男で、若い小説家だ。彼にはミューズ（彼が敬愛する人物でもある）がいる。無名の黒髪の少女で、彼の夢にランダムに現れるが、彼女の顔をはっきりと見ることはできない。一方、少女は彼を見ることはできるが、彼に触れることはできない。男の目から見るとかなりミステリアスに見えるが、実は大きな丸い目をした、笑顔が大好きな甘くて元気な女の子なのだ。\n\n実は、この男性キャラクターは少女の想像の一部に過ぎない。彼は実際には存在せず、少女の夢の領域に生きている。彼が彼女を見た瞬間はすべて、彼女が眠っているときであり、彼女の意識は夢の領域にとどまっていた。運命の恋人たち少女の身体は幽霊のようにどこか透明である。二人の代表的な花はヒナギクで、それは純愛を象徴し、二人の行くところどこにでも現れる。\n\n一緒に崖から落ちて、お互いに手を伸ばそうとして、それでも幸せそうに微笑む二人を見たい。落ちていくふたりの体は花びらに溶けていく。眼下には荒れ狂う潮騒の海が広がり、二人の顔は月明かりに覆われている。悲しく切ないラブストーリーの雰囲気を醸し出しながらも、不気味すぎない。\n\nhttps://drive.google.com/drive/folders/1XnMr8vlC1Qq7Dtd8JpOb2qieMwfHjc8v", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@XD_trpg/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3810425, "client_id": 702918, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/087b5f3d/uploads/origins/fb14219d-e9a5-4860-a99e-c78d7796170e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75a2d99c38b285930e5de4d3751d9649", "srcset": "https://si.imgix.net/087b5f3d/uploads/origins/fb14219d-e9a5-4860-a99e-c78d7796170e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75a2d99c38b285930e5de4d3751d9649, https://si.imgix.net/087b5f3d/uploads/origins/fb14219d-e9a5-4860-a99e-c78d7796170e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a0f7852410ad4ec56bea4ebcb490614 2x, https://si.imgix.net/087b5f3d/uploads/origins/fb14219d-e9a5-4860-a99e-c78d7796170e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d79e38623d1846d66b8272d2f6e63e3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/087b5f3d/uploads/origins/fb14219d-e9a5-4860-a99e-c78d7796170e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5216be5912b9bbea8f421ea78f468cd", "srcset": "https://si.imgix.net/087b5f3d/uploads/origins/fb14219d-e9a5-4860-a99e-c78d7796170e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5216be5912b9bbea8f421ea78f468cd, https://si.imgix.net/087b5f3d/uploads/origins/fb14219d-e9a5-4860-a99e-c78d7796170e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ddd10a61db92d