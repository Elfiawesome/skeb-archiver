っくりとしたイメージですが、\nhttps://www.pixiv.net/artworks/119754128\nこういった服装。\n\n前かがみのポーズが嬉しいです。\nhttps://www.pixiv.net/artworks/124388578\n\nファイル形式はpsd形式でお願いいたします。\n\nあと、せっかくなので、イラストをＸやBlueskyなどに掲載させていただければ嬉しいです。\n\n資料が足りないということで、どのようにお願いすればいいか考えましたが、まだ更に不足があるようでしたら、遠慮なく再送いただけると幸いです。\n\nなにとぞ検討のほど、よろしくお願いいたします。\n\nhttps://kakuyomu.jp/works/16817330650571755530/episodes/16817330650571771792", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mineru128127/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3411446, "client_id": 815408, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f6a3b30/uploads/origins/dd7ad6b2-de45-4aab-a293-dddaba12b190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01764e417d60cacb7e3361237bccccf4", "srcset": "https://si.imgix.net/6f6a3b30/uploads/origins/dd7ad6b2-de45-4aab-a293-dddaba12b190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01764e417d60cacb7e3361237bccccf4, https://si.imgix.net/6f6a3b30/uploads/origins/dd7ad6b2-de45-4aab-a293-dddaba12b190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c2546c4c5beb5354f4a31bfc0040577 2x, https://si.imgix.net/6f6a3b30/uploads/origins/dd7ad6b2-de45-4aab-a293-dddaba12b190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db4d8fb3b9e270ae845c07dc129b2a07 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f6a3b30/uploads/origins/dd7ad6b2-de45-4aab-a293-dddaba12b190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5eb7bbfb95772c0de9b0dd664129bca", "srcset": "https://si.imgix.net/6f6a3b30/uploads/origins/dd7ad6b2-de45-4aab-a293-dddaba12b190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5eb7bbfb95772c0de9b0dd664129bca, https://si.im