ble_same_genre": false}, {"path": "/@Tachakan139/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1388516, "client_id": 658387, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc879e0c/uploads/origins/9dda2020-0963-45d7-bd10-d97824f3bbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64c20de0d1abb69e33b1efd9cbf09ee7", "srcset": "https://si.imgix.net/bc879e0c/uploads/origins/9dda2020-0963-45d7-bd10-d97824f3bbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64c20de0d1abb69e33b1efd9cbf09ee7, https://si.imgix.net/bc879e0c/uploads/origins/9dda2020-0963-45d7-bd10-d97824f3bbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5375eebd130a7e4dff6f1222e7b3481 2x, https://si.imgix.net/bc879e0c/uploads/origins/9dda2020-0963-45d7-bd10-d97824f3bbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f9420646229d6f42bcddbbc4d872a80 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc879e0c/uploads/origins/9dda2020-0963-45d7-bd10-d97824f3bbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78e77e3819d12b3976c4afe60eda85fa", "srcset": "https://si.imgix.net/bc879e0c/uploads/origins/9dda2020-0963-45d7-bd10-d97824f3bbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78e77e3819d12b3976c4afe60eda85fa, https://si.imgix.net/bc879e0c/uploads/origins/9dda2020-0963-45d7-bd10-d97824f3bbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9e826006657e64ecd9821ffa9b90a938 2x, https://si.imgix.net/bc879e0c/uploads/origins/9dda2020-0963-45d7-bd10-d97824f3bbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=babfc3805c9980da8cfece324866bbc5 3x"}, "body": "よろしくお願いします。\n昔、3.5リットルぐらいミルクを絞ってそうな、ある神絵師のＣＧ集がありまして。ウェイトレスの女の子が、胸につけた搾乳機からミルクを出して接客するんです。\nよければ同様のシチュで、内装の明るい背景のお店で、メイド服orウェイトレス服で働く響をお願いします。\n\n\n衣装: 胸部分だけ開かれたメイド服orウェイトレス服。丸出しになった両胸に透明な搾乳機がつき、母乳が出てる。\n\n搾乳機から太めの黒いコードが背中側へと伸びている。\n設定として、背中にはミルクを貯める小さいタンクがあるが、コストがかかるので描写しなくていいです。\n\n同様の太めの黒いコードが、背中からスカートの中へと伸びて繋がっている。\n\n片手にミルクの垂れたノズルを持ち、もう片手にグラスの乗ったトレイを持つ。\nトレイには黄色い液体の入ったグラス、ミルクの入ったグラスがある。\n\n絵の構図は、真正面に響がいる、席に座った客の主観視点。\n客が響を呼び止めて注文しようとしてる状況です。\n\n恥じらいの無い素の表情が嬉しいです。快感に少し頬を染め息を荒らげ、\n「なんでしょうか？」とこちらの言葉を待って伺っている。\nこの姿が当たり前という様子で、搾乳機から母乳が強い勢いで噴出してます。\n\n響を中心にした絵の、左下手前あたりに、客が持つメニュー表が見切れてて欲しいです。\n『裏めにゅ〜\n　\n　乳搾り体験……5k\n　カルピスごっくん……10k\n　交尾ごっこ……20k\n　生ハメ……』\n\nなどと書かれて見切れている。\n\n以上です。よければよろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Tachakan139/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7c37f154/uploads/origins/175e2f26-b75e-41e9-84f6-9f6c311dfe24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b152e0d24203449e36175017bfc7624e", "srcset": "https://si.imgix.net/7c37f154/uploads/origins/175e2f26-b75e-41e9-84f6-9f6c311dfe24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b152e0d24203449e36175017bfc7624e, https://si.imgix.net/7c37f154/uploads/origins/175e2f26-b75e-41e9-84f6-9f6c311dfe24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0191389e90a2d85d6de4727459bbe9b 2x, https://si.imgix.net/7c37f154/uploads/origins/175e2f26-b75e-41e9-84f6-9f6c311dfe24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a034da963ef556140b3c53fce2f4354 3x"}, "pri