96a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5284f50d9baea36a850be17c14fc8b07", "srcset": "https://si.imgix.net/7fc7ee53/uploads/origins/b055681b-238a-4345-ac92-3970093096a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5284f50d9baea36a850be17c14fc8b07, https://si.imgix.net/7fc7ee53/uploads/origins/b055681b-238a-4345-ac92-3970093096a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=919c5b85eddaf1c62720345775e999e5 2x, https://si.imgix.net/7fc7ee53/uploads/origins/b055681b-238a-4345-ac92-3970093096a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=72193227cd69cbc3eb4a6d7f8044c69c 3x"}, "body": "始めまして、さにてぃーあいすと申します。\nX(旧Twitter)で癲彩さんが描いたイラストを拝見しました。食べ物がすっごく美味しそうで感動しました……！ミニキャラたちの絵柄や動きも可愛くて素敵です😭✨\nSkebでの依頼が不慣れなため、不備等ございましたら申し訳ございません。\n\n■内容\n自作ゲーム、「友チョコ推理」の犬餅　夜来乃(いぬもち　よこの)のイラストを制作いただけないでしょうか。\nご縁がありましたら、よろしくお願いいたします！\n\n･━━･ キャラ設定 ･━━･\n\n犬餅夜来乃\n■外見\n・茶髪のロング。\n・資料にて。見えない部分はご自由に解釈・省略してくださって構いません。\n\n■特徴\n・表情豊かで元気。\n・食いしん坊。甘い食べ物が特に好きです。(でも何でも美味しく食べます！)\n・優柔不断で頭を使うことが苦手。\n・高校2年生、美術部所属。\n\n■描いていただきたい内容\n食べ物と一緒に写っている夜来乃を描いていただきたいです……！甘い食べ物が好物ではありますが、わさび以外は何でも食べる子ですのでご自由に食べ物を描いていただけると幸いです。\nまた、犬餅にもなにか食べさせてくれると嬉しいです。\n\n全身映ってなくても構いません。資料では制服を着用しておりますが、服装お任せいたします。\nまた、制服の場合は必要に応じて省略や置き換え・アレンジなどしていただいて構いません。\n\n■使用用途\nSNSでの投稿\n個人鑑賞\n個人利用目的でのリアルグッズ化をする可能性がございます。\n\nご検討いただけると幸いです。よろしくお願いいたします。\n\nhttps://xfolio.jp/portfolio/sanity_ice/works/6082447", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Shame_on_1031/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3736478, "client_id": 2036050, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dea1c572/uploads/origins/46435922-662b-4af6-86c3-d98b8c63f895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44ca545446b05cf4846f19a6ed492e3b", "srcset": "https://si.imgix.net/dea1c572/uploads/origins/46435922-662b-4af6-86c3-d98b8c63f895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44ca545446b05cf4846f19a6ed492e3b, https://si.imgix.net/dea1c572/uploads/origins/46435922-662b-4af6-86c3-d98b8c63f895?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3d95c83925bd269f666e51ad51ff778 2x, https://si.imgix.net/dea1c572/uploads/origins/46435922-662b-4af6-86c3-d98b8c63f895?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dfac4c924c7e6665ad83377b56f37f23 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dea1c572/uploads/origins/46435922-662b-4af6-86c3-d98b8c63f895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c075f0b2787d504e15f49cb3490dfb1", "srcset": "https://si.imgix.net/dea1c572/uploads/origins/46435922-662b-4af6-86c3-d98b8c63f895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c075f0b2787d504e15f49cb3490dfb1, https://si.imgix.net/dea1c572/uploads/origins/46435922-662b-4af6-86c3-d98b8c63f895?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=494db8d869782fa959f2e5afaec7ba89 2x, https://si.imgix.net/dea1c572/uploads/origins/46435922-662b-4af6-86c3-d98b8c63f895?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=413cd173a2adf1f0c7e3b5a4eba25d8e 3x"}, "body": "先生、はじめまして！\n\n先生の料理をテーマにした作品を見ましたが、本当に素晴らしいです！私のVTuberキャラクター「ミューク」と料理を組み合わせた作品をぜひ描いていただきたいです。私も料理が大好きなので、先生の作品にとても惹かれました！\n\nキャラクター\n\nミュークは、背後に輪状に浮かぶ太鼓を従えた「猫雷神」です。2本のカナボを使って太鼓を叩き、雷と稲妻を生み出します。\n\n肩に乗せた仮面も、独立して周囲を見回すことができます。\n\nミュークが真剣になったり怒ったりすると、仮面を完全に現すことができます。 その際、目は真っ黒になり、周囲の雲が暗く染まり、遠くの村からも聞こえるほどの激しい嵐や雷を引き起こします。その怒りは洪水さえ引き起こすほど強力だとも言われています。\n\n参考までに、今年初めに日本で食べた牛カツの写真を添付しました。 ミュークと食べ物を組み合わせた素敵な作品になると思ったからです。\n\nただし、もし他に、これの方が良いと思われる食べ物のアイデアがあれば、遠慮なくそれを使ってください！選択は先生にお任せしますし、どのような構図が美しいか、先生の考えを聞かせていただけると嬉しいです。\n\nお時間を割いてこのメッセージをお読みいただき、私のリクエストをご検討くださり、ありがとうございます、先生！\n\nミューク\n\nhttps://drive.google.com/drive/folders/17q2paAsFkYLE2fostoatxdARm3Fv_yL7?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Shame_on_1031/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8b990e50/uploads/origins/194d4b61-bd29-4705-89fb-28b73f3ef017?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ecf7340c6d05919a962cc1d3465102f", "srcset": "https://si.imgix.net/8b990e50/uploads/origins/194d4b61-bd29-4705-89fb-28b73f3ef017?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ecf7340c6d05919a962cc1d3465102f, https://si.imgix.net/8b990e50/uploads/origins/194d4b61-bd29-4705-89fb-28b73f3ef017?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c9deb06a8a27fef5a7f47dc221ea091e 2x, https://si.imgix.net/8b990e50/uploads/origins/194d4b61-bd29-4705-89fb-28b73f3ef017?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a355ddf464a493b94d3ff5a61095016f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3736478, "client_id": 2613704, "nc": 144}, {"path": "/@Shame_on_1031/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3736478, "client_id": 2352669, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13565c8f/uploads/origins/a571e6f3-012a-48f2-b1c6-4ba5cdcff0b4?bg=%23fff&auto=format%2Ccompress