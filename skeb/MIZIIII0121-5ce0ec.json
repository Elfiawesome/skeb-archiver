ラー、スカルマーチャント（旧正月衣装）コスチュームの百目鬼かなた嬢のイラストをお願いしたいです。\nカラー有、ポーズや構図はお任せいたします。\n可能でしたらマスクの有無の差分をお願いします。\n\n【参考画像】\nhttps://twitter.com/KanataDomeki/status/1663177171886833665\nhttps://x.com/zikizin4646/status/1916028201413054623\n\n【使用用途】\n百目鬼かなた本人の使用許可を頂きたいです。※X、配信サムネイル等に使用する可能性があります！\n\n【その他】\n可能であればPSD形式でいただきたいです。\nキャラクターのみで使用する場合がございますので、背景等と分けていただけると嬉しいです。\n\nご検討よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MIZIIII0121/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2737319, "client_id": 2639312, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13175d96/uploads/origins/b570da75-b5f2-4aac-9456-566db4e056d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bebf415b7aae15620898430314d9d266", "srcset": "https://si.imgix.net/13175d96/uploads/origins/b570da75-b5f2-4aac-9456-566db4e056d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bebf415b7aae15620898430314d9d266, https://si.imgix.net/13175d96/uploads/origins/b570da75-b5f2-4aac-9456-566db4e056d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd9be30552c8aea00ba4996bd7cdbe58 2x, https://si.imgix.net/13175d96/uploads/origins/b570da75-b5f2-4aac-9456-566db4e056d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0162df0698bccbdf7ccf51ab9001931 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/13175d96/uploads/origins/b570da75-b5f2-4aac-9456-566db4e056d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=477fad3c223f4ac6300d92c1c330ef93", "srcset": "https://si.imgix.net/13175d96/uploads/origins/b570da75-b5f2-4aac-9456-566db4e056d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=477fad3c223f4ac6300d92c1c330ef93, https://si.imgix.ne