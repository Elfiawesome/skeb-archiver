f&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b605e4465ee2d8a37a9790d020dd717e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e29d1aa6/uploads/origins/3abe74ea-a942-48a9-a4fe-848c326e742d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de2bb395531844504c9b3e98a500b83e", "srcset": "https://si.imgix.net/e29d1aa6/uploads/origins/3abe74ea-a942-48a9-a4fe-848c326e742d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de2bb395531844504c9b3e98a500b83e, https://si.imgix.net/e29d1aa6/uploads/origins/3abe74ea-a942-48a9-a4fe-848c326e742d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=40e1e61be0a22eead00c360d7ff28285 2x, https://si.imgix.net/e29d1aa6/uploads/origins/3abe74ea-a942-48a9-a4fe-848c326e742d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4ccc4b037b4ce4903ca2864b3304733d 3x"}, "body": "こちらフロンティア・ミリシア特殊偵察戦隊のヴァンガード級タイタン。\n\n第一任務の戦果を確認した。作戦は第二段階へ移行する。\n\n**第二任務の目標は、『仲間を守って』のサキュバス、リリスだ。**\n\n今回も一枚に一人を描いてほしい。アストレフィアを中央に、リリスと第三任務の目標であるエルフのセレンを左右に配し、三枚で一枚絵となる構成だ。左右の配置は君の判断に委ねる。\n\n舞台は同じ洋館。装飾のあるソファで、見る者を誘う表情や仕草を頼む。構図やポーズは任せる。彩色・線・背景の統一感を保ちつつ、リリスならではの魅力を引き出してほしい。\n\n前回、カラー版に加えて線画のみのモノクロ版も納品してくれた配慮を高く評価する。君の線そのものを楽しめる、価値ある成果だった。**今回もカラー完成版と線画のみのモノクロ版を、別々の画像ファイルで納品してほしい。**\n\n我々は任務の真っ只中にある。苛烈な戦闘は続くが、君の感性と技量による、見事な戦果を期待している。\n\n健闘を祈る。通信終了。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MIZIIII0121/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2737319, "client_id": 3907466, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dffa0471/uploads/origins/8ae44cfd-855b-489c-9f8f-76319a57958c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e46f4b6216414e6eacd8cfa0846589a", "srcset": "https://si.imgix.net/dffa0471/uploads/origins/8ae44cfd-855b-489c-9f8f-76319a57958c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e46f4b6216414e6eacd8cfa0846589a, https://si.imgix.net/dffa0471/uploads/origins/8ae44cfd-855b-489c-9f8f-76319a57958c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99260bd1003f10e7d1a7b2d89be6713e 2x, https://si.imgix.net/dffa0471/uploads/origins/8ae44cfd-855b-489c-9f8f-76319a57958c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=947c01698f604de9788db6adfc39d482 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dffa0471/uploads/origins/8ae44cfd-855b-489c-9f8f-76319a57958c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17e9baede4c17696105dc61f728359b8", "srcset": "https://si.imgix.net/dffa0471/uploads/origins/8ae44cfd-855b-489c-9f8f-76319a57958c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17e9baede4c17696105dc61f728359b8, https://si.imgix.net/dffa0471/uploads/origins/8ae44cfd-855b-489c-9f8f-76319a57958c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=731a23afc6bf32d5c0f1de89b37f4c9d 2x, https://si.imgix.net/dffa0471/uploads/origins/8ae44cfd-855b-489c-9f8f-76319a57958c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea024c720f945df519f8299a1488a7a8 3x"}, "body": "こちらフロンティア・ミリシア部隊、特殊偵察戦隊バンガード級タイタン。私のパイロット、トミーこと樋野友行からの伝令を預かった。\n任務:『仲間を守って死んだら二十年後の同じ世界に生まれ変わった件』のイラスト納品\n目標:アストレフィア・ラインストール\n洋館の、3名程が座れるソファにて。背後一面のテラス窓からは紅い満月。\nカラー作画、大胆なベタ塗り、シャープな線画。縦長キャンバス。\n目標のキャラクター性を理解し戦況に応じて柔軟に判断せよ。\n\n備考…本作戦の全体像は、横に3枚並べると1枚の大きなイラストになるというものだ。アストレフィアはその3枚の中央に位置する。この任務を無事完遂し帰還したならば、続く任務を依頼するつもりだ。\n第二の目標はリリス、第三の目標はセレン。\n\n尚この納品物は後日、クライアントによって異なる媒体に掲載される可能性がある。その点を十分に理解してほしい。同意しかねる場合は任務の撤退を推奨する。\n\n< Skebでやり取りされた 作品のすべての権利はクリエイターに帰属し、クライアントは原則としてプロフィール画像への使用や個人鑑賞に限って利用可能 です。 >\n原則に対しては例外があり得る。例えば、クリエイターが別途許諾した場合や、特定の契約で拡張利用を認めるケースがそれに該当する。\n\n困難な任務になることが予想されるが、君を戦士と見込んでこの任務を託す。\n通信終了。健闘を祈る。\n\nhttps://www.dropbox.com/scl/fo/rthm25dw1oedodwizgmrb/AJnVwviiEsLdZ2fxlKGDWcM?rlkey=nwbkky1tuf8ogi7ytskzsa8mh&st=tiezp5jb&dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MIZIIII0121/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2737319, "client_id": 3140790, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc9b45b8/uploads/origins/1dab2fe0-5568-48ba-b1f2-f988e70800a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1397c5683890ad77607355124060f1db", "srcset": "https://si.imgix.net/fc9b45b8/uploads/origins/1dab2fe0-5568-48ba-b1f2-f988e70800a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1397c5683890ad77607355124060f1db, https://si.imgix.net/fc9b45b8/uploads/origins/1dab2fe0-5568-48ba-b1f2-f988e70800a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dcf2f443a6fbd5b29957ebb59dfc0d01 2x, https://si.imgix.net/fc9b45b8/uploads/origins/1dab2fe0-5568-48ba-b1f2-f988e70800a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=150046cb46d1a62287f71169065e2c41 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc9b45b8/uploads/origins/1dab2fe0-5568-48ba-b1f2-f988e70800a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccf363846b3e0e8fd4adb70b7b53ae9f", "srcset": "https://si.imgix.net/fc9b45b8/uploads/origins/1dab2fe0-5568-48ba-b1f2-f988e70800a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccf363846b3e0e8fd4adb70b7b53ae9f, https://si.imgix.net/fc9b45b8/uploads/origins/1dab2fe0-5568-48ba-b1f2-f988e70800a6?bg=%23fff&auto=format%2Ccompress&fm=web