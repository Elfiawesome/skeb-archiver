imgix.net/1aad7ff4/uploads/origins/b22f3b04-b120-413d-9f61-602125ef4053?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc6a7d17b09989a0246fdec095fe9daa", "srcset": "https://si.imgix.net/1aad7ff4/uploads/origins/b22f3b04-b120-413d-9f61-602125ef4053?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc6a7d17b09989a0246fdec095fe9daa, https://si.imgix.net/1aad7ff4/uploads/origins/b22f3b04-b120-413d-9f61-602125ef4053?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a17c48dd426b43c5f93e85fc8167a949 2x, https://si.imgix.net/1aad7ff4/uploads/origins/b22f3b04-b120-413d-9f61-602125ef4053?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bd5e9acae1065bb7167dd6f5a23cc7f2 3x"}, "body": "こんにちは、北屋けけ先生\n\n\n今回は以下のキャラクターでのご依頼になります。\n\n彼女の名前はルーリス。\nかつてはごく普通の少女だった。\n\nしかし、狼人である元恋人との関係をきっかけに、彼女自身も狼人へと変貌してしまう。\nそして狼人となった彼女は、雄の大型犬が好きになっていった。\n\n\nご希望の内容：\n\n彼女が学校の片隅で、以前から想いを寄せていた校犬と密会しているシーンです。\n犬の本能の影響を受け、さらに獣化が進行していく描写を希望しています。\n\n構図については、『猫の恩返し』のような差分表現をイメージしており、\n通常の獣化状態から、よりケモ度の高い姿へと変化していく流れを描いていただければ嬉しいです(差分)。\n\n\n通常の獣化状態: https://drive.google.com/file/d/1WWS3LnclJBcJioeCHRRleKxIe0Sh3iZY/view?usp=drive_link\n\nケモ度の高い姿: https://drive.google.com/file/d/1HhoI6EI2Ym3joAV2d61CgaPt5NL1N6wT/view?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1n_JLwuHwXHiWSe1oFEk_uywwuq0nZ4xk", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kitayak/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3944185, "client_id": 877247, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf0d7e15/uploads/origins/e9d310f2-beaf-4a0b-a7fd-a194d42b1b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d1c71948427d4c046331733b2e133a4", "srcset": "https://si.imgix.net/bf0d7e15/uploads/origins/e9d310f2-beaf-4a0b-a7fd-a194d42b1b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d1c71948427d4c046331733b2e133a4, https://si.imgix.net/bf0d7e15/uploads/origins/e9d310f2-beaf-4a0b-a7fd-a194d42b1b33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=54b45a0ded7ffeb642d0a3aa80d46b85 2x, https://si.imgix.net/bf0d7e15/uploads/origins/e9d310f2-beaf-4a0b-a7fd-a194d42b1b33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6172696a34a6558016559a628cc4ff2c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf0d7e15/uploads/origins/e9d310f2-beaf-4a0b-a7fd-a194d42b1b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f747559e9cf9601e913ca47b57927ee", "srcset": "https://si.imgix.net/bf0d7e15/uploads/origins/e9d310f2-beaf-4a0b-a7fd-a194d42b1b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f747559e9cf9601e913ca47b57927ee, https://si.imgix.net/bf0d7e15/uploads/origins/e9d310f2-beaf-4a0b-a7fd-a194d42b1b33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e5e44f1ab2cf2b583d8152f527e49db 2x, https://si.imgix.net/bf0d7e15/uploads/origins/e9d310f2-beaf-4a0b-a7fd-a194d42b1b33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=89bdf8b625b1277fd7ba6706257911e2 3x"}, "body": "北屋けけ先生、こんにちは。\nあなたの作品ウタカタノミナトがとても好きで、私のピアノ作品の雰囲気にも非常に合っていると感じています。\n\nこのたび、私の音楽作品の世界観に登場する4人のキャラクターのご依頼をお願いしたくご連絡いたしました。\n彼女たちはいずれも「音楽から生まれた幻想的な存在」で、\n人工精霊（Vanity）、蛇神（PP）、吸血鬼（Shiroma）、悪魔（Sienna）です。\nそれぞれ私の音楽チャンネルに対応するシリーズがあります。\n\nYouTube: https://www.youtube.com/@PYKAMIA/featured\n\nイラストの内容は、4人のキャラクターが街の郊外、橋の下の河川敷で、楽しそうに遊びながら散歩している様子で、\n子どものように無邪気で楽しそうな雰囲気をイメージしています。\n\nこちらの委託イラストの参考となる楽曲はこちらです：\nhttps://www.youtube.com/watch?v=6R52Ehiat10\n\nまた、このイラストのために新たな楽曲を制作する予定です。\n用途：楽曲ジャケット、個人鑑賞、チャンネルバナー用途\n\n16:9 橫\n解像度 300dpi\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/13lGZ9V0Fa0amT8Hokeunkv3gPfr7gn0I?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kitayak/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3944185, "client_id": 3116915, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e2aed96/uploads/origins/17687549-eea3-4d80-beff-cdb2d8afa61b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64b7e4e0f83e162ea3b2775ced03c5e4", "srcset": "https://si.imgix.net/6e2aed96/uploads/origins/17687549-eea3-4d80-beff-cdb2d8afa61b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64b7e4e0f83e162ea3b2775ced03c5e4, https://si.imgix.net/6e2aed96/uploads/origins/17687549-eea3-4d80-beff-cdb2d8afa61b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0cbd67572a9c4b59f0407e5f2ebae7b7 2x, https://si.imgix.net/6e2aed96/uploads/origins/17687549-eea3-4d80-beff-cdb2d8afa61b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=036e5b2bedbc2c7dafcb0c51d42166db 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e2aed96/uploads/origins/17687549-eea3-4d80-beff-cdb2d8afa61b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d201954e2e55559b553f926476e40c17", "srcset": "https://si.imgix.net/6e2aed96/uploads/origins/17687549-eea3-4d80-beff-cdb2d8afa61b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d201954e2e55559b553f926476e40c17, https://si.imgix.net/6e2aed96/uploads/origins/17687549-eea3-4d80-beff-cdb2d8afa61b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7369e4c23e10d93c733388991b5c62de 2x, https://si.imgix.net/6e2aed96/uploads/origins/17687549-eea3-4d80-beff-cdb2d8afa61b?bg=%23fff&auto