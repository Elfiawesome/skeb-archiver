srcset": "https://si.imgix.net/c51cf5af/uploads/origins/5cc1694e-8881-4626-9f1c-65db200675a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab05a558be92433a3391655f5037b030, https://si.imgix.net/c51cf5af/uploads/origins/5cc1694e-8881-4626-9f1c-65db200675a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8bb7d1ce58a88324f69c924806445afc 2x, https://si.imgix.net/c51cf5af/uploads/origins/5cc1694e-8881-4626-9f1c-65db200675a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8ba8b13b2ef85fdae0c9097bb9c73379 3x"}, "body": "遠炉さんこんばんは！\nいつも卓やX等でお世話になってる杜野です。\n灯籠さんのTRPGで使われているKPコマ、現在のXアカウントのアイコンの猫ちゃん風のミニキャラが大変かわいく、私にもミニキャラのデザインをしていただきたくてリクエストさせていただきました！\n\n使用用途\n個人観賞\nデザインされたものを元にイラストを描く等\n\n＊\nよく元気な犬やオコジョと言われることが多い。\n喜怒哀楽がしっかりとしている。\nイメージカラーを募集すると黄色やオレンジ、緑の他に紫やピンク等、全体的に明るめなカラーであることが多い。\n\n等です！\n私のイメージを募集したところ、こういった要素があげられることが多いですが、デザインする際は参考にしてもしなくても構いません。\n遠炉さんが思う杜野像を自由にデザインしていただけると幸いに思います。\nよろしくおねがいします～！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tooro_loxia/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1914131, "client_id": 1895651, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e7e2e38a/uploads/origins/08b931b5-165c-4663-93e1-771a82e22b05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11c3f69591ff92c1fc405c0ac602d4e0", "srcset": "https://si.imgix.net/e7e2e38a/uploads/origins/08b931b5-165c-4663-93e1-771a82e22b05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11c3f69591ff92c1fc405c0ac602d4e0, https://si.imgix.net/e7e2e38a/uploads/origins/08b931b5-165c-4663-93e1-771a82e22b05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=738294515ecb634413d88f73a22907eb 2x, https://si.imgix.net/e7e2e38a/uploads/origins/08b931b5-165c-4663-93e1-771