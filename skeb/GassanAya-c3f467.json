f&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=024fee90855c072f9e7f0f1abc130418 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/261b6f8a/uploads/origins/7c0cdff7-a9b5-4488-9e81-bf533b8842b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c650126e11e085420e1065374d09dac", "srcset": "https://si.imgix.net/261b6f8a/uploads/origins/7c0cdff7-a9b5-4488-9e81-bf533b8842b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c650126e11e085420e1065374d09dac, https://si.imgix.net/261b6f8a/uploads/origins/7c0cdff7-a9b5-4488-9e81-bf533b8842b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a2d650750933deb9a589fa0dc9b4d3fd 2x, https://si.imgix.net/261b6f8a/uploads/origins/7c0cdff7-a9b5-4488-9e81-bf533b8842b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9c210f2a82b9563d7e3d8ab65e4ba5b8 3x"}, "body": "月山先生、こんにちは。\nTwitterに掲載されていた守が満艦飾になる絵（Enable）がとても気に入っています。先生の絵をプライベート端末の壁紙にしたいです。\n\n受け取っていただける方、どうもありがとうございます！\n鳴門鳳のスカートめくりを作りたい（Ref: https://i.pinimg.com/564x/b9/9a/69/b99a691d8fe4c0dac2f195eb62ce9c36.jpg）。\n\n前回の決闘衣装の絵を参考に、スカートの下のXIやピンクの天球コレクションの一部など、装飾を少し減らし、脚のリングも外したり流したりしたいです。\n背景は、トレベと同じようなスタイルでイネーブルを書き、その下に彼女が勝った有名なG1（凱旋門賞、オークツリー、キングズステークスなど）を描きたいと考えています。私のアイデアは、例えばキングズステークス3勝＝王冠のシルエット3枚、オークツリー3勝＝オークの葉3枚というように、簡略化したシルエットを使用することです。もっと良いアイディアがあれば、それでも構いません。ただ、背景の残りは空白にしておいてください。\n\nありがとうございました！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@GassanAya/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2576601, "client_id": 2540661, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e137e18/uploads/origins/f7670184-1249-42f6-88e1-b9b3ecf33b47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=501c4a2a4f99368bc73e779414eeaf52", "srcset": "https://si.imgix.net/3e137e18/uploads/origins/f7670184-1249-42f6-88e1-b9b3ecf33b47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=501c4a2a4f99368bc73e779414eeaf52, https://si.imgix.net/3e137e18/uploads/origins/f7670184-1249-42f6-88e1-b9b3ecf33b47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=402dc4bc31e6bf5e05934774f2e94f7f 2x, https://si.imgix.net/3e137e18/uploads/origins/f7670184-1249-42f6-88e1-b9b3ecf33b47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1488c7ad38e8738d7f16feb2f8eb78f3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e137e18/uploads/origins/f7670184-1249-42f6-88e1-b9b3ecf33b47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d2d475571fc877952c19175d489229e", "srcset": "https://si.imgix.net/3e137e18/uploads/origins/f7670184-1249-42f6-88e1-b9b3ecf33b47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d2d475571fc877952c19175d489229e, https://si.imgix.net/3e137e18/uploads/origins/f7670184-1249-42f6-88e1-b9b3ecf33b47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=42a3b84d0d398c007068b8110c527acb 2x, https://si.imgix.net/3e137e18/uploads/origins/f7670184-1249-42f6-88e1-b9b3ecf33b47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=37b10e9e8935f6994657601da1467a6c 3x"}, "body": "はじめまして！いつも素敵なイラスト楽しみに拝見してます！\n私にとって、アヤさんは\"ウマ娘化\"という文化の始祖にも等しい存在で、いつか依頼してみたいな……と常々思っていました。\nskebリクエストを受け付けていらっしゃることを最近知りましたので、こちらから依頼させていただきたいと思います。\n\n今回ですが、いわゆる\"うちの子\"（とはいってもキャラクターデザインは別の方に依頼したものですが……）のオリジナルウマ娘を描いていただきたいです。\n下記にリクエスト概要を記載いたします。\n\n【リクエスト概要】\n☆馬名\nスピーディキック（ https://db.sp.netkeiba.com/horse/2019102512/ ）\nキャラクター設定・ビジュアルについては、別添の資料URLにまとめさせていただきました。そちらをご参照いただけますと幸いです。\n\n☆イラスト形式\n基本的にはいつものアヤさんの絵柄で、筆の乗るままお好きなように描いていただきたいです。\n2023年フェブラリーステークスをモデルにしていただきたいので、資料URLの勝負服デザインに加え、赤のマスクをつけていただけると嬉しいです（当日パドックにおいて馬の興奮を抑えるために二重にメンコを着用していたこと、厩務員さんが本馬のイメージカラーである赤のマスクで馬を引いていたことに由来）。\n\n☆使用用途\n主に個人鑑賞目的になりますが、別の方に同キャライラストを依頼する場合の参考資料としても使用させていただきたく可能性がございます。\n\n内容としては以上になります。ご検討いただければ幸いです。よろしくお願いいたします！\n\nhttps://www.dropbox.com/sh/359kt5k39s0zovk/AADeBcfed3HkyFIEzwuZ7x29a?dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@GassanAya/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2576601, "client_id": 419182, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6323c26a/uploads/origins/8e4a32cb-310c-4abe-8e78-ad1e0fe67fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cae2dfedde24ed5d0658709877f5e2b3", "srcset": "https://si.imgix.net/6323c26a/uploads/origins/8e4a32cb-310c-4abe-8e78-ad1e0fe67fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cae2dfedde24ed5d0658709877f5e2b3, https://si.imgix.net/6323c26a/uploads/origins/8e4a32cb-310c-4abe-8e78-ad1e0fe67fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e69ee218facd2700019d07dbbf3c0fba 2x, https://si.imgix.net/6323c26a/uploads/origins/8e4a32cb-310c-4abe-8e78-ad1e0fe67fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e68b8a9f212640928e04e1aaf3ee7824 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6323c26a/uploads/origins/8e4a32cb-310c-4abe-8e78-ad1e0fe67fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c2e24976b6aed71f3292214ca722c30", "srcset": "https://si.imgix.net/6323c26a/uploads/origins/8e4a32cb-310c-4abe-8e78-ad1e0fe67fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c2e24976b6aed71f3292214ca722c30, https://si.imgix.net/6323c26a/