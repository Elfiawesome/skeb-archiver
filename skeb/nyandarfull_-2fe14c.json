": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c92a527/uploads/origins/3066691e-bb0f-49b3-9032-56cedcd7cf12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db4028d4f009b54654915dd4b2cd8cf2", "srcset": "https://si.imgix.net/5c92a527/uploads/origins/3066691e-bb0f-49b3-9032-56cedcd7cf12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db4028d4f009b54654915dd4b2cd8cf2, https://si.imgix.net/5c92a527/uploads/origins/3066691e-bb0f-49b3-9032-56cedcd7cf12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4973b92c3130be62c4c46798079d2fc9 2x, https://si.imgix.net/5c92a527/uploads/origins/3066691e-bb0f-49b3-9032-56cedcd7cf12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a892aaf08e1255d60bf727cb19fea546 3x"}, "body": "にゃんと！さま\n\nはじめまして、この度はTwitterから見つけていただきアピール募集してくださってありがとうございました！衣装ごとのギャップを褒めていただけてとても嬉しかったです！\nとても丁寧にサンプルを共有していただけてとても助かります！\nラフからもうすでに綺麗な線画で、最初のサンプル、早さ重視のもの、どちらもとても素敵でした！\n\nにゃんと！さまの可愛らしさとセクシーさ、そして柔らかさと透明感のあるイラスト拝見させていただきました！どれも素敵でしたがTwitterとアイコンのブーケさんと依頼の中にある莉波ちゃんが素敵すぎます…！\nぜひうちの子（というより自分のことですが）、Vtuberの早乙女宵を描いていただきたいと思いリクエストさせていただきます！\n\n用途は配信用サムネとTwitter（X）での使用を考えております。\nポーズや衣装はお任せで、明るく笑顔な感じが見て見たいです！\nウォーターマークのない資料をURL経由で添付させていただきますので参考にしていただけますと幸いです。\n\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1CC9j__3cIXj0B1CnTK-cHr_rnVqL9bB0?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nyandarfull_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3227279, "client_id": 2828784, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0d2b22e/uploads/origins/9b5bc3cb-60d6-43b9-b833-b98845ff9c22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5838303603a13a05fb5dd0cd079399d", "srcset": "https://si.imgix.net/c0d2b22e/u