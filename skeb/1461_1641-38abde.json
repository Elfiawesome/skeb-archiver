野蛮だけどチャラい「スコール」(https://drive.google.com/file/d/1z8R5ANqP0-z_3O1DofGTbS06a4E6gegw/view?usp=drive_link)のアートワークをお願いします。\n\nどちらのキャラクターもサッカーの衣装を着てほしいです：(https://drive.google.com/file/d/1qPF3NXvgtU5s7jJEAW1lL-Ooc0IWssLs/view?usp=drive_link)(https://drive.google.com/file/d/1g6lEdORRcAVIvTKDAztq0zAFVPJxdNGt/view?usp=drive_link)\n\nシナリオは、テレビ中継されるサッカーの試合を見て、「スコール」が積極的に友好的な表情で勝利のジェスチャーをする一方、「イプシロン」はすぐに屈辱を味わうことになると知って動揺しているような作品を希望する。\n\nシナリオの舞台はバーで、登場人物のユニフォーム、ソックス、スニーカーが見えるようにする。\n\n2人のキャラクターが光沢のあるアンダーシャツだけを着ている別バージョンも素晴らしいだろう。", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@1461_1641/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1242749, "client_id": 187973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62a6b98e/uploads/origins/973c2caa-60e8-48f7-94b8-7ae72bb81067?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37c3b274168d12df6824dc13712c8309", "srcset": "https://si.imgix.net/62a6b98e/uploads/origins/973c2caa-60e8-48f7-94b8-7ae72bb81067?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37c3b274168d12df6824dc13712c8309, https://si.imgix.net/62a6b98e/uploads/origins/973c2caa-60e8-48f7-94b8-7ae72bb81067?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e05d33710679e6d79e752663fa8fbd40 2x, https://si.imgix.net/62a6b98e/uploads/origins/973c2caa-60e8-48f7-94b8-7ae72bb81067?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5d62efd0df85dd405894107aa1dbeba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62a6b98e/uploads/origins/973c2caa-60e8-48f7-94b8-7ae72bb81067?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34b5f7f07fee8f6746c8b88e1c25650a", "srcset": "https://si.imgix.net/62a6b98e/uploads/origins/973c2caa-60e8-48f7-94b8-