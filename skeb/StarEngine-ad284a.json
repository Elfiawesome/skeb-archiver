f1b1d/uploads/origins/cd2b4c87-eaf3-4173-ab6b-11cc9485c0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed94b0e534492b73d7d6b1610dbdff6d", "srcset": "https://si.imgix.net/d39f1b1d/uploads/origins/cd2b4c87-eaf3-4173-ab6b-11cc9485c0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed94b0e534492b73d7d6b1610dbdff6d, https://si.imgix.net/d39f1b1d/uploads/origins/cd2b4c87-eaf3-4173-ab6b-11cc9485c0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=15e97e1acad4d4b7efe78d7302509560 2x, https://si.imgix.net/d39f1b1d/uploads/origins/cd2b4c87-eaf3-4173-ab6b-11cc9485c0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05fd2d59317eaf815560f0e6d1c672ce 3x"}, "body": "こんにちは。まずはじめに、私はあなたの絵が大好きです！だからここで、私のキャラクターを描いてもらえないかとお願いしているのです。彼はイドリス/ミール、実は彼の国の皇太子なんだ。でも、実は冒険が大好きで、二重生活を送っているんだ。おっちょこちょいだけど、かなりミステリアスな冒険家イドリスと、真面目な皇太子メア。実はその肩書きが自由を奪っているため、ちょっと嫌われている......。というか、そんな感じ。王冠の騎士としての責任を自覚しているが、もっと自由でありたいと思うことも...。自由でありたいと思う。でも、今は、自分の立場があるからこそ、そう思うことができる。自分の住む土地に何か変化を与えたいと思い、旅を通じて人々のことをもっと知りたいと思っている。\n参考文献はこちら\nhttps://sta.sh/2ggsf1q0206?edit=1\nhttps://www.pinterest.es/smile_inc/meir/\nを弖紗することができます。しかし、彼の髪は低い尾で結ばれており、通常は黒い服を着ている（通常は王室のタイプ...）。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@StarEngine/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1026179, "client_id": 2289543, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a32cb19f/uploads/origins/3dcc662f-fcd2-46fb-955e-2d538cbff11f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3e2e676eb0b6f559f2960e2288f4948", "srcset": "https://si.imgix.net/a32cb19f/uploads/origins/3dcc662f-fcd2-46fb-955e-2d538cbff11f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3e2e676eb0b6f559f2960e2288f4948, https://s