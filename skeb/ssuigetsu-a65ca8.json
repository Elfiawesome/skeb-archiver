f-964b-4824-ab3f-f1f77274e2e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbbd9aa36143d4f735c2d6ce8ee8626e", "srcset": "https://si.imgix.net/2a3e28cb/uploads/origins/47e7c4af-964b-4824-ab3f-f1f77274e2e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbbd9aa36143d4f735c2d6ce8ee8626e, https://si.imgix.net/2a3e28cb/uploads/origins/47e7c4af-964b-4824-ab3f-f1f77274e2e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ebd6460cbf26571802dcb6b07b75df9f 2x, https://si.imgix.net/2a3e28cb/uploads/origins/47e7c4af-964b-4824-ab3f-f1f77274e2e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b1f6850b6ae3a6163c902e13ae7cbb19 3x"}, "body": "【お願いしたいテーマ】\nアイドルマスターシンデレラガールズに登場する水木聖來さんが、\nシンガポールを旅行している場面。\n\n【イラストの目的】\nApple Watchの文字盤背景で使いたいです。\n(可能でしたら1:1比率の正方形イラスト比率にしていただけると大変うれしいです)\n\n【細かい要望】\n・実際にシンガポールで見た印象深い場面。\n・服装や表情、ポーズ等は先生のお好みでお願いします。\n・先生の作風に合わせてデフォルメを入れていただいて大丈夫です。\n\n【備考】\n・描くのが難しい場合は遠慮なくキャンセルいただいて大丈夫です。\n・不備があった際もキャンセルいただいて大丈夫です。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ssuigetsu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5181, "client_id": 740648, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e162c97/uploads/origins/35ad6087-a127-48c7-99fa-210fe1571963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a346bbce4647356395825a533db5d21d", "srcset": "https://si.imgix.net/3e162c97/uploads/origins/35ad6087-a127-48c7-99fa-210fe1571963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a346bbce4647356395825a533db5d21d, https://si.imgix.net/3e162c97/uploads/origins/35ad6087-a127-48c7-99fa-210fe1571963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1210a9fa946e7e6643874ed83957629 2x, https://si.imgix.net/3e162c97/uploads/origins/35ad6087-a127-48c7-99fa-210fe1571963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=839b1c72892db1541f3004d2b784fad1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e162c97/uploads/origins/35ad6087-a127-48c7-99fa-210fe1571963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8468396469c567501039cdd82be691d6", "srcset": "https://si.imgix.net/3e162c97/uploads/origins/35ad6087-a127-48c7-99fa-210fe1571963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8468396469c567501039cdd82be691d6, https://si.imgix.net/3e162c97/uploads/origins/35ad6087-a127-48c7-99fa-210fe1571963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=82841085296ef028e3d76a818f72ad65 2x, https://si.imgix.net/3e162c97/uploads/origins/35ad6087-a127-48c7-99fa-210fe1571963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c4faf5005cefb7006c9d1031bca747a5 3x"}, "body": "先日投稿していただいたスキューバダイビングの絵がとても気に入りました！グランブルーファンタジーのカイラナとヴィカラが一緒にダイビングしているところを描いていただけませんか？\n\nウェットスーツ、フィン、BCD、タンクを身に着けています。オーギュストの美しい水中世界を見せるために、カイラナがヴィカラを案内しています。\n\nこの写真には2つのバージョンがあり、ヴィカラは白髪と黒髪のパーソナリティを行ったり来たりしている。彼女のポーズはどちらのバージョンでも同じですが、配色と表情が変わります。\n\nヤントピアモード（白髪＋ネズミ耳）では、ウェットスーツと装備は明るい白と銀色で、カイラナと一緒に興奮している。Yintopiaモード（黒髪）では、衣装は黒と灰色で、巨大な魚に食べられるのではないかと怯えている。\n\nたくさんの泡を吹きながら、二人の女の子がレギュレーターの周りに唇を寄せているのが見えるようなアングルで撮ってください（例：https://i.imgur.com/qTHvHTW.jpg）。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ssuigetsu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5181, "client_id": 3399871, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9a6b333/uploads/origins/572b5d19-9308-47e7-bb2e-e38687e5def2?bg=%23fff&auto=format%2Ccompress&fm=webp&f