ttps://www.falcom.co.jp/kuro/character/agnes.html）\n\n服装は帽子とコートを脱いだ状態（頭のリボンは有り）にして下さい。\n\nまた、シチュエーションとしては触手に締め付けられている状態で、体に巻き付いたり背景にウジャウジャしている触手は模様無しの白色にして下さい。※触手の太さはアスカのイラスト内のアーボックと同じでお願いします。\n\n是非ともご検討のほど、宜しくお願い申し上げます。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2862448kiyomi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1195469, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d058f6e/uploads/origins/1d038f8d-e0df-484a-83e2-ce8e3ba2de95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e916a6f7b3a200cdb89ff7793066ad65", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d058f6e/uploads/origins/1d038f8d-e0df-484a-83e2-ce8e3ba2de95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e29ccdd7615cb06a237aba7b675b46fd", "src_set": ""}, "body": "エヴァンゲリオンの惣流・アスカ・ラングレー(衣装はプラグスーツ)がアーボックの色違いに絞め付けられるイラストをお願いします\n首にも巻き付いていて両目閉じでお願いしたいです", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2862448kiyomi/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/32601928/uploads/origins/b4baec5d-b3a0-4af8-91df-aea2cf5c7d3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b1ee69117e305808f339b2ff0802d793", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1195469, "client_id": 3511045, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@2862448kiyomi/works/5", "private_thumbnail_image_u