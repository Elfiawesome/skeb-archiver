re": true}, {"path": "/@Selene_nazuki/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1397311, "client_id": 1185934, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/27717566/uploads/origins/4f36ceef-fa0b-4711-b244-e3d478024032?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd03bb8e7123ca57a6f4d8ff746c58b5", "srcset": "https://si.imgix.net/27717566/uploads/origins/4f36ceef-fa0b-4711-b244-e3d478024032?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd03bb8e7123ca57a6f4d8ff746c58b5, https://si.imgix.net/27717566/uploads/origins/4f36ceef-fa0b-4711-b244-e3d478024032?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6fd0a33f3da60a9ecd5c86c7dd4c57ae 2x, https://si.imgix.net/27717566/uploads/origins/4f36ceef-fa0b-4711-b244-e3d478024032?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8da7e9582527e23caeb205d572386b5e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27717566/uploads/origins/4f36ceef-fa0b-4711-b244-e3d478024032?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73502e4d6df31ffe2bbe568f99e9d754", "srcset": "https://si.imgix.net/27717566/uploads/origins/4f36ceef-fa0b-4711-b244-e3d478024032?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73502e4d6df31ffe2bbe568f99e9d754, https://si.imgix.net/27717566/uploads/origins/4f36ceef-fa0b-4711-b244-e3d478024032?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8fbe3581edfeea94516ae0ab74773ea6 2x, https://si.imgix.net/27717566/uploads/origins/4f36ceef-fa0b-4711-b244-e3d478024032?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4f0ffe5e45b8d234378c25caf0fd68a2 3x"}, "body": "OCを描けるか？\n-かわいいオオカミ少年です。男の娘。ケモミミ。\n-遊び好きな性格の持ち主。外向的。\n-狼の耳。狼の尾。\n-ペールブロンドヘア。肩につく長さの髪（もう少し長くても可）。ヘアスタイルはお任せします。\n-ピンク色の目。\n-鋭い歯。\n-肌の色が黒い。やや引き締まった体つき。\n-身長160cm。\n-裏地にファーをあしらったノースリーブジャケットを着用しています。\n-ファー付きグローブ。ファー付きハイブーツ。\n-半ズボン。パンツの上からTバックの紐が見えている状態。\n-背中に弓を背負っている。弓の長さは1m。弓は胴体に巻かれたベルトに取り付けられている。\n-腰の後ろに矢筒を装着している。\n-腰の横にショートソードをつけている。長さ60cm。\n-首には革の首輪を付けている。\n-狼の耳の片方にリングピアスをつけている。\n-ヘソに宝石のピアスをつけている。宝石は矢じりのような形をしている。\n\nhttps://drive.google.com/drive/folders/1URpuAlaHZnzXZnEm2pbR7Ad6jlSfwU_R?usp=sharing\nリファレンスは雑ですが、参考になれば幸いです。より良く見えると思えば、多少の変更は可能です。変更する場合は、毛皮の裏地をいくつか残しておくこと。お腹が露出していて、Tバックの紐が見えていること。\n参考資料の服の白い斑点は、裏地のファーを表しています。\n武器はあまり見えないと思うのですが、とりあえずリファレンスを入れてみました。\n服や武器の色は、より見栄えがすると思えば変えてもいい。(服の色は黒をメインにしないでください）\n\n長いリクエストで申し訳ありません。お忙しい中、ありがとうございました。\n(また、SKEBは私にNSFWとしてマークすることを強要した）", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Selene_nazuki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1397311, "client_id": 1471543, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/009611e4/uploads/origins/7bc6971e-48bf-46cc-a1cc-8577399ebe05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce9288f35beff7b367869990ac1ce6ad", "srcset": "https://si.imgix.net/009611e4/uploads/origins/7bc6971e-48bf-46cc-a1cc-8577399ebe05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce9288f35beff7b367869990ac1ce6ad, https://si.imgix.net/009611e4/uploads/origins/7bc6971e-48bf-46cc-a1cc-8577399ebe05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=daf73a45a87b30c18f0983b166a7d757 2x, https://si.imgix.net/009611e4/uploads/origins/7bc6971e-48bf-46cc-a1cc-8577399ebe05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e27be0e1bac9ab3065a452771083b0db 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/009611e4/uploads/origins/7bc6971