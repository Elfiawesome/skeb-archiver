_same_genre": true}, {"path": "/@morodasikamenn/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 197689, "client_id": 1256199, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41b6d052/uploads/origins/16dbc3ad-17fa-4039-8fa4-4271bce0ed5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05ec9e4af51a3d1a91cf5c84ca75fa22", "srcset": "https://si.imgix.net/41b6d052/uploads/origins/16dbc3ad-17fa-4039-8fa4-4271bce0ed5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05ec9e4af51a3d1a91cf5c84ca75fa22, https://si.imgix.net/41b6d052/uploads/origins/16dbc3ad-17fa-4039-8fa4-4271bce0ed5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b517e815a9d0b5f1bd47d27e3377679 2x, https://si.imgix.net/41b6d052/uploads/origins/16dbc3ad-17fa-4039-8fa4-4271bce0ed5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30a0387a09925e3cba70af581fa58d2e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41b6d052/uploads/origins/16dbc3ad-17fa-4039-8fa4-4271bce0ed5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be0c2e293ec76db7f42415f21af53ddc", "srcset": "https://si.imgix.net/41b6d052/uploads/origins/16dbc3ad-17fa-4039-8fa4-4271bce0ed5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be0c2e293ec76db7f42415f21af53ddc, https://si.imgix.net/41b6d052/uploads/origins/16dbc3ad-17fa-4039-8fa4-4271bce0ed5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=87ad1a66f724d2bb045c1921c61a086a 2x, https://si.imgix.net/41b6d052/uploads/origins/16dbc3ad-17fa-4039-8fa4-4271bce0ed5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eaa49e5d52c6769f4e0abb5cdb7042ca 3x"}, "body": "卑猥なイラストをお願いします。\n20代中頃の女性が、宅配業者に扮する押し入り強盗(二人組)に襲われる絵面をお願いします。\n\n女性の服装は上は白Tシャツまくり上げて黒ブラが露わでかつ片方がずらされてブラが見えてる感じ、下は黒下着を半脱ぎさせられてる感じです。\n女性の外観は髪は黒か茶髪のボブヘア程度の長さで、胸は大きめの美乳でお願いします。\n\n男の構図は、１人は襲う担当で、女性の口を片手で塞ぎながら正常位で襲うような恰好、１人は女性の頭上で両手を抑える格好です。\n男の外観は基本着衣、襲う担当のみ下半身を半脱ぎ、他は基本着衣でお願いします。\n\n女性の表情は、男を見ながら又は目をきゅっと閉じてボロ泣きでお願いします。\n\n女性の全身が収まる程度のカットでお願いします。\n男のほうは、構図がわかる範囲で書いていただければあとは見切れてて大丈夫です。\n\nアングルは、女性の左側、やや足寄りか手寄りのアングルから斜めに見下ろすような角度でお願いします。(分かりづらければ他でも可)\n背景については、玄関で、または白シーツのベッド上に連れ込まれて、のいずれかでお願いします。\n\n以上、前の依頼内容と被っていたり、伝わりづらいところもあるかと思いますが、よろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@morodasikamenn/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 197689, "client_id": 1256199, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/971398e9/uploads/origins/2d3142db-f241-498d-9d13-3060b4be5b79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e519b864157b3f008a29908994eb4b7d", "srcset": "https://si.imgix.net/971398e9/uploads/origins/2d3142db-f241-498d-9d13-3060b4be5b79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e519b864157b3f008a29908994eb4b7d, https://si.imgix.net/971398e9/uploads/origins/2d3142db-f241-498d-9d13-3060b4be5b79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=960b9497d261474305b185981fdb2f9b 2x, https://si.imgix.net/971398e9/uploads/origins/2d3142db-f241-498d-9d13-3060b4be5b79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b16745db1b32e2ee86c54bbffd50c8c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/971398e9/uploads/origins/2d3142db-f241-498d-9d13-3060b4be5b79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=658a0076bb23c919b0e193aaed8f46d3", "srcset": "https://si.imgix.net/971398e9/uploads/origins/2d3142db-f241-498d-9d13-3060b4