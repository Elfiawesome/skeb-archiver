るとへその豆部分がちょっと出てくる\n・へそ触っていいかと聞かれての反応\n・彼によるへそのアピール\n手で小さくバッテンのマーク作って言葉でエロくへそアピール\n以上の内容でお願い致します\n\n作者様のキャラなのでアドリブ大歓迎です\n彼のセリフにへそやでべそ発言多めだとうれしいです\n宜しくお願い致します", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Echimi0110/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/aefb0bcf/uploads/origins/08548b8b-3694-49bc-9a2c-143180ef10db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14ff287be8024b5a2471cd6d3d608342", "srcset": "https://si.imgix.net/aefb0bcf/uploads/origins/08548b8b-3694-49bc-9a2c-143180ef10db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14ff287be8024b5a2471cd6d3d608342, https://si.imgix.net/aefb0bcf/uploads/origins/08548b8b-3694-49bc-9a2c-143180ef10db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11444f9082d4c858f93e6e978e4450bb 2x, https://si.imgix.net/aefb0bcf/uploads/origins/08548b8b-3694-49bc-9a2c-143180ef10db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30222a08c347ab8cbe4e8975d7c233d1 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3799435, "client_id": 3726141, "nc": 35}, {"path": "/@Echimi0110/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3799435, "client_id": 3324395, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a9b12fc/uploads/origins/8273a204-2a72-4af8-a194-01111ec9e30c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72eacdeeac4700aac8aa7aec9d7817a9", "srcset": "https://si.imgix.net/4a9b12fc/uploads/origins/8273a204-2a72-4af8-a194-01111ec9e30c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72eacdeeac4700aac8aa7aec9d7817a9, https://si.imgix.net/4a9b12fc/uploads/origins/8273a204-2a72-4af8-a194-01111ec9e30c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f798ce5920f5e187ed54e1a7735ae772 2x, https://si.imgix.net/4a9b12fc/uploads/origins/8273a204-2a72-4af8-a194-01111ec9e30c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=608abe7a470c52617ca1eb54f681733a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a9b12fc/uploads/origins/8273a204-2a72-4af8-a194-01111ec9e30c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=675a8de5739e739682073fbd6e999094", "srcset": "https://si.imgix.net/4a9b12fc/uploads/origins/8273a204-2a72-4af8-a194-01111ec9e30c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=675a8de5739e739682073fbd6e999094, https://si.imgix.net/4a9b12fc/uploads/origins/8273a204-2a72-4af8-a194-01111ec9e30c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4d76cb2e1bd437ae131443a60f56a719 2x, https://si.imgix.net/4a9b12fc/uploads/origins/8273a204-2a72-4af8-a194-01111ec9e30c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5398d3b08129571481cc8c71859f09b4 3x"}, "body": "えちみさん、セリフ付きの漫画風イラスト4枚をよろしくお願いします。\n　内容は以下の通りでよろしくお願いします。\n①石造りの遺跡の中が舞台で、中央に全身包帯姿のミイラ男(包帯のみで装飾品等は無し、目元くらいしか素肌の部分は見えない)が立ちはだかっていて、対峙した二人組の盗掘者は「おい、アレって本物のミイラ男か！？」「あの包帯の下に何か武器を隠してるかもな……剥ぎ取ってやろうぜ！」と相談し合っている(セリフのみ、もしくは横顔か後ろ姿付き)。\n②包帯を半分くらい解かれて、可愛い素顔や細身の身体つきやピンク色の可愛い乳首がバレて赤面して慌てふためいているミイラ男を見て「怪物のくせに力が弱いと思ったら、包帯の中身は弱っちいガキかよww」「随分可愛い顔と乳首してるなww残りも全部取って裸にしちまおうぜ！」という盗掘者達(包帯を掴んでいる手が少し写っている)\n③全裸にされて、恥ずかしそうに股間を隠す赤面涙目のミイラ男に対して「おいおい、怪物のくせに今にも泣きそうだぜ？」「そんなに包帯返して欲しいのか？　じゃあ、両手を上げて脚を開いた格好になって小便するところを見せたら返してやるよwwどうする？」と言い放つ盗掘者達。\n④全裸のミイラ男は顔を真っ赤にして泣きながらガニ股にバンザイのポーズで、股間を丸出し(毛が一本も生えてないツルツルで赤ちゃんみたいな小さい皮余りの可愛い短小包◯)の格好で放尿し、盗掘者達はそれを爆笑しながら鑑賞しつつ「マジでやりやがったwwつうか、チ◯コ小さ過ぎだろww」「おもしれーから、もっと色々命令してやろうぜww」と話し合う。\n　ミイラ男の包帯の中身は細身でツルツルの可愛い系の顔立ちの男の子で、自分の身体に強いコンプレックスがあってすごく恥ずかしがり屋。\n　ミイラ男にもセリフを付けるかは、えちみさんの判断にお任せします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Echimi0110/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3799435, "client_id": 43394, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/581ade46/uploads/origins/d5025a0f-3fd4-4016-8239-2ee0c1a12114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65d633069d7ac9bcdb5feeb1b5b06806", "srcset": "https://si.imgix.net/581ade46/uploads/origins/d5025a0f-3fd4-4016-8239-2ee0c1a12114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65d633069d7ac9bcdb5feeb1b5b06806, https://si.imgix.net/581ade46/uploads/origins/d5025a0f-3fd4-4016-8239-2ee0c1a12114?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b14790bbe4f4b948a3256d8efee5b0a 2x, https://si.imgix.net/581ade46/uploads/origins/d5025a0f-3fd4-4016-8239-2ee0c1a12114?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69899bd287ca33db9fb7fc4e705ab610 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/581ade46/uploads/origins/d5025a0f-3fd4-4016-8239-2ee0c1a12114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c05d761b5642af948bae19710d03fb0c", "srcset": "https://si.imgix.net/581ade46/uploads/origins/d5025a0f-3fd4-4016-8239-2ee0c1a12114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c05d761b5642af948bae19710d03fb0c, https://si.imgix.net/581ade46/uploads/origins/d5025a0f-3fd4-4016-8239-2ee0c1a12114?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ee3f15c1ae84b52eedb74292f708292a 2x, https://si.imgix.net/581ade46/uploads/origins/d5025a0f-3fd4-4016-8239-2ee0c1a12114?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8ddfcf7f8db737c4ab6d919b72c44a1e 3x"}, "body": "はじめまして！えちみさんの程よい厚みある筋肉質な描写に惹かれました。\n先日描かれていた学ラン野球部でリクエストさせてください。学ランかっこいいですよね！ユニフォーム姿もカッコよかったです。\n\n\n我慢できなくなった彼がスラパンのままオナニーする様子を描いていただけないでしょうか？\n\n・練習後の更衣室のようなイメージ。\n・スラパン、上裸 or アンダーシャツ。日焼け跡などお好みで。\n・我慢できずスラパンの上から一心不乱に扱いている。\n・テント張った頂点から滲み出た我慢汁やら精液やら汗やらでぐちょぐちょ。\n\nアンダーシャツが捲れて腹筋が出ていたり、ユニフォームスボンを膝下まで下ろしているだけも良さそうですね。(お任せします)\nスラパンは参考画像のミズ○やゼッ○のような、ステッチが派手なデザインだと嬉しいです。\n\n仲間(キャッチャー？)にスラパンの上から扱くと違った刺激が…と唆され、試してみたらハマってしまい何度も射精して気持ちよさに一緒に止まらなくなっているようなシチュエーションが浮かびましたが、もちろんソロでも構いませんし、仲間のオナニーを見せつけられてムラついている様子も良いですね。\n\nいかがでしょうか？硬派そうな彼が快楽にガクガクと堕ちていく様を描いていただけたらと。ご検討のほどよろしくお願いいたします。\n\n\nhttps://jpn.mizuno.com/ec/disp/attgrp/12JBAP11/\nhttps://jp.mercari.com/item/m38293244211\nhttps://zettshop.net/itemdetail/Z/bp220-s-1100\nhttps://jp.mercari.com/item/m15011783508", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Echimi0110/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3799435, "client_id": 3825111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6bbd7677/uploads/origins/b2016fc3-aba7-4308-b2c7-61f42ad37cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec1f86c709151e3e66b718fd1da1e302", "srcset": "https://si.imgix.net/6bbd7677/uploads/origins/b2016fc3-aba7-4308-b2c7-61f42ad37cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec1f86c709151e3e66b718fd1da1e302, https://si.imgix.net/6bbd7677/uploads/origins/b2016fc3-aba7-4308-b2c7-61f42ad37cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35295df2bf7c903cbb86a911b8