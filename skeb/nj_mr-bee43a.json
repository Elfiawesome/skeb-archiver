489?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0a4d42ac623ae28feab2a49fdfa887e 2x, https://si.imgix.net/3fc113fb/uploads/origins/98ddcb5e-b222-4258-9fea-5637bbc31489?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9338096411f7b2c29a8d37b3202116e8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3fc113fb/uploads/origins/98ddcb5e-b222-4258-9fea-5637bbc31489?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5e93ac4f1faa913b6c19efc445dd6bd", "srcset": "https://si.imgix.net/3fc113fb/uploads/origins/98ddcb5e-b222-4258-9fea-5637bbc31489?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5e93ac4f1faa913b6c19efc445dd6bd, https://si.imgix.net/3fc113fb/uploads/origins/98ddcb5e-b222-4258-9fea-5637bbc31489?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a3e3f323398d94c346dce55069b0c0d6 2x, https://si.imgix.net/3fc113fb/uploads/origins/98ddcb5e-b222-4258-9fea-5637bbc31489?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2c47d01b8cbee2d05b37213950643f26 3x"}, "body": "こんにちは、にじゅーまる様。\n\nにじゅーまる様の絵柄で描いてくださるキャラが好きでたまらず、絶対に美味しいと分かっているお菓子を買っておかずにはいられないような気持ちでそわそわしてたまらないので、依頼を送らせていただきます。\n\n今回はいつもお願いしているアドレーヌとドロシアの他に、ペイントローラーというキャラの合計三人を描いていただきたいです。\n原作で直に接触した事はない三人ですが、芸術家という共通点で私が個人的に好きな組み合わせになります。\n 以下がペイントローラーに関する資料と、引き続き希望する点になります。\n\n・ペイントローラーは@kirby_jpの2020年6月10日の紹介画像や、 YouTubeでrenkuru337氏の投稿した「星のカービィ 夢の泉DX ペイントローラー戦」をご参照ください。身長はアドレーヌよりやや小さめで、ゲーム画面では省かれている黒い腕や足もついている状態でお願いいたします。\n・アドレーヌは大きくなっても5頭身までの身長で、カラーは「スターアライズ」という作品に登場した時の姿をご参照ください。\n・ドロシアはアドレーヌよりやや大きめという身長差で、カラーの基準は@kirby_jpの2019年11月28日のイラストでの姿や、YouTubeでMikey's Walkthroughs氏の投稿した「Kirby: Canvas Curse - Part 23 - The World of Drawcia + Final Boss」のプレイ動画をご参照ください。\n ・イラストの四隅のどこかに、あなた様のTwitterアカウントかサインの記載をしていただきたいです。 \n\n希望する構図ですが、にじゅーまる様がpixivに掲載している2020年10月24日の「あかりちゃん」や2020年12月13日の「らくがき詰め。」の1ページ目のような三人をお願いいたします。\n縦や横並び、奥行きで順番が生じるような位置関係なら１番目ペイントローラー→２番目アドレーヌ→３番目ドロシアの順で、ポーズや表情、色味はにじゅーまる様にお任せいたします。\n\n上記内容が問題なければ、どうぞお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nj_mr/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 180941, "client_id": 659572, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16f165a0/uploads/origins/efec1303-c881-4e5b-a2f9-3cab1ddf33e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a52b4af8750294b1793854aa70146d6", "srcset": "https://si.imgix.net/16f165a0/uploads/origins/efec1303-c881-4e5b-a2f9-3cab1ddf33e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a52b4af8750294b1793854aa70146d6, https://si.imgix.net/16f165a0/uploads/origins/efec1303-c881-4e5b-a2f9-3cab1ddf33e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19043c7c4f2daa04d43576eea965a7b4 2x, https://si.imgix.net/16f165a0/uploads/origins/efec1303-c881-4e5b-a2f9-3cab1ddf33e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a7350eb8d7dce41129c9914fc391c86 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/16f165a0/uploads/origins/efec1303-c881-4e5b-a2f9-3cab1ddf33e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47db9cfa0290c9066f2992fb2d0ffdf3", "srcset": "https://si.imgix.net/16f165a0/uploads/origins/efec1303-c881-4e5b-a2f9-3cab1ddf33e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47db9cfa0290c9066f2992fb2d0ffdf3, https://si.imgix.net/16f165a0/uploads/origins/efec1303-c881-4e5b-a2f9-3cab1ddf33e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a61831c006a02f43cb6618047daa4a36 2x, https://si.imgix.net/16f165a0/uploads/origins/efec1303-c881-4e5b-a2f9-3cab1ddf33e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56ff1c1d689c48b20707c9a932c22212 3x"}, "body": "こんにちは、にじゅーまる様。\n\nにじゅーまる様が描いてくださったアドレーヌとドロシアがたまらなくて、何度見返しても幸せになります。\n絵柄が本当に最高なので、また依頼させていただきたく思います。\n引き続き希望する点が以下の三点になります。\n\n・アドレーヌは大きくなっても５頭身までの身長で、カラーの基準は「スターアライズ」という作品に登場した時の姿。\n・ドロシアはアドレーヌよりやや大きめという身長差で、カラーの基準は@kirby_jpの2019年11月28日のイラストでの姿。\n・イラストの四隅のどこかに、あなた様のTwitterアカウントかサインの記載をしていただきたいです。\n\nそして今回希望する構図が次の内容になります。\n\n・花畑にいる二人。微笑んでいるアドレーヌが、ドロシアに花冠を載せています。花冠には花に混じって四つ葉のクローバーが一つ添えられています。「幸運をあなたに」と言っているような、絵本のような優しい空気です。\n・ドロシアは帽子を外しており、目を閉じておずおずと花冠を受け入れています。\n髪型はYouTubeのプレイ動画で、Mikey's Walkthroughs氏の投稿した「Kirby: Canvas Curse - Part 23 - The World of Drawcia + Final Boss」の2:41のやられモーション、4:10の攻撃モーション、5:10～に第二形態への変化途中のモーションなどが参考になるかと思いますが、にじゅーまる様の解釈にお任せします。\n・上記にカラー基準を希望しましたが、全体的に柔らかくて優しい色味にしていただけると嬉しいです。\n\n上記内容が問題ないようであれば、どうぞよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nj_mr/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 180941, "client_id": 659572, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c20b5d55/uploads/origins/90f443c1-dd1e-4e23-a23b-ecb601a5ee13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85f1696b3e67bb468eb1331b3da32b49", "srcset": "https://si.imgix.net/c20b5d55/uploads/origins/90f443c1-dd1e-4e23-a23b-ecb601a5ee13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85f1696b3e67bb468eb1331b3da32b49, https://si.imgix.net/c20b5d55/uploads/origins/90f443c1-dd1e-4e23-a23b-ecb601a5ee13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8db4f6622ad69b64b4e3b4244a999d01 2x, https://si.imgix.net/c20b5d55/uploads/origins/90f443c1-dd1e-4e23-a23b-ecb601a5ee13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddb2ebd07bd276d23454e4f6e7d98dc7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c20b5d55/uploads/origins/90f443c1-dd1e-4e23-a23b-ecb601a5ee13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=080f3332d4181fd92ecb472673c4eb98", "srcset": "https://si.imgix.net/c20b5d55/uploads/origins/90f443c1-dd1e-4e23-a23b-ecb601a5ee13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=080f3332d4181fd92ecb472673c4eb98, https://si.imgix.net/c20b5d55/uploads/origins/90f443c1-dd1e-4e23-a23b-ecb601a5ee13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa402b402d23630b27f4d589d2d36064 2x, https://si.imgix.net/c20b5d55/uploads/origins/90f443c1-dd1e-4e23-a23b-ecb601a5ee13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=09444a0dc69c4251fb9ebb535bb93a82 3x"}, "body": "こんにちは、にじゅーまる様。\n\n先日のアドレーヌとドロシアのイラストは、ラフやボツまでサプライズで入れてくださって本当に嬉しかったです！\n疲れがぶっ飛ぶ勢いで最高でしたので、また依頼させていただきたく思います。\n引き続き希望する点が以下の三点になります。\n\n・アドレーヌは大きくなっても５頭身までの身長で、カラーの基準は「スターアライズ」という作品に登場した時の姿。\n・ドロシアはアドレーヌよりやや大きめという身長差で、カラーの基準は@kirby_jpの2019年11月28日のイラストでの姿。\n・イラストの四隅のどこかに、あなた様のTwitterアカウントかサインの記載をしていただきたいです。\n\nそして今回希望する構図が次の内容になります。\n\n・カフェテラスのような場所で休憩、くつろいでいる表情。\n・アドレーヌはジュース、ドロシアは紅茶。飲んでいても飲んでなくても構いません。\n・二人も座っています。どんな姿勢かはお任せします。ドロシアのローブが姿勢によってシワができても構いません。にじゅーまる様の服のシワは最高です。\n・にじゅーまる様がpixivにあげている2020年9月27日の「グワキーーーーン」や、2020年10月31日の「らくがき」のような、白い外側に余白をあえて残して内側に主線の四角い枠を作り、あえて人物をそこからとび出させるという構図がかわいかったり印象に残って好きなので、その構図で描いて欲しいです。\n\n上記内容が問題ないようであれば、どうぞよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nj_mr/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 180941, "client_id": 659572, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe0f8f8d/uploads/origins/f34d0256-bd