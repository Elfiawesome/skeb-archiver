ます。\n・二人は道を真っ直ぐに進んでいます。ここの「道」は野道でも舗装された道でも、道であればなんでも大丈夫です。\n・二人の進行方向にむけて矢印の形の看板が立っており、看板には「GO！」の文字が書いてあります。\n\n上記内容が問題ないようであれば、どうぞよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nj_mr/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 180941, "client_id": 659572, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6bee6db8/uploads/origins/b8497ae7-fb7d-434a-b998-62c0e30661b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38fdf5c2bbe9333bee61dd651318707f", "srcset": "https://si.imgix.net/6bee6db8/uploads/origins/b8497ae7-fb7d-434a-b998-62c0e30661b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38fdf5c2bbe9333bee61dd651318707f, https://si.imgix.net/6bee6db8/uploads/origins/b8497ae7-fb7d-434a-b998-62c0e30661b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb53e591797c4211b5185f16d24434fe 2x, https://si.imgix.net/6bee6db8/uploads/origins/b8497ae7-fb7d-434a-b998-62c0e30661b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=200755b80ce3832a7b14555eac2591ef 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6bee6db8/uploads/origins/b8497ae7-fb7d-434a-b998-62c0e30661b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=515472e09403526ca583c75749707c85", "srcset": "https://si.imgix.net/6bee6db8/uploads/origins/b8497ae7-fb7d-434a-b998-62c0e30661b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=515472e09403526ca583c75749707c85, https://si.imgix.net/6bee6db8/uploads/origins/b8497ae7-fb7d-434a-b998-62c0e30661b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=74c8f15baf7839f54a5a6725fc1c4abf 2x, https://si.imgix.net/6bee6db8/uploads/origins/b8497ae7-fb7d-434a-b998-62c0e30661b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=729a2d7a4acf365891e8a6a5fd8fb00a 3x"}, "body": "はじめまして、にじゅーまる様。\n\npixivなどの作品を拝見しましたところ、とても個人的に好きな作風でしたので依頼をさせていただきます。\n星のカービィという作品に登場する「アドレーヌ」と「ドロシア・ソーサレス」というキャラの絵を描いていただきたいです。\nゲーム本編ではこの二名に接触はなく、私の好みによる組み合わせとなります。\n\n・アドレーヌは大きくなっても５頭身までの身長で、カラーの基準は「スターアライズ」という作品に登場した時の姿。\n・ドロシアはアドレーヌよりやや大きめという身長差で、カラーの基準は@kirby_jpの2019年11月28日のイラストでの姿。\n・希望する構図ですが、仲良しの友達が写真を撮る時のようにくっついて並んで正面にむけて笑っている二名を描いていただきたいです。\nアドレーヌはにっこりと目を細めて→😄のような顔で笑っていて(口の形に指定はありませんが歯の見えない笑顔です)、ドロシアもぎこちないながらも瞳を僅かに細めて笑っています。\n・最後に、イラストの四隅のどこかに、あなた様のTwitterアカウントかサインの記載をしていただきたいです。\n\n長くなりましたが、以上が依頼の内容となります。\nおそらくにじゅーまる様の触れたことのないジャンルのキャラクターかもしれませんが、もしよろしければお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 267326, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "角字🌷", "screen_name": "usaTNJ", "avatar_url": "https://pbs.twimg.com/profile_images/2037099349709320192/MkwkxEw2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1071551436507365377/1628008983/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 17}, {"id": 693924, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "がみー", "screen_name": "my11gum", "avatar_url": "https://pbs.twimg.com/profile_images/1555701840930832385/PtA1qzs1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2164532954/1766905336/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days