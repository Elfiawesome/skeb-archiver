faf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0a81f75efccf9ff0364557f820d6e7d", "srcset": "https://si.imgix.net/e4b0b882/uploads/origins/e4eb7ccf-0dad-412d-a0a5-0183bf3bbfaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0a81f75efccf9ff0364557f820d6e7d, https://si.imgix.net/e4b0b882/uploads/origins/e4eb7ccf-0dad-412d-a0a5-0183bf3bbfaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f4addf788d300dbf67f2d66f09b64419 2x, https://si.imgix.net/e4b0b882/uploads/origins/e4eb7ccf-0dad-412d-a0a5-0183bf3bbfaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4061a61949958e9ec8833731fa477090 3x"}, "body": "こんばんは、いつもお世話になっております。\n\n狐獣人のお姉さんと人間の男の子の平面化をお願いします、シーケンスとしては\n①男の子を抱いている人間に化けた獣人\n②呪いにより男の子を四角い紙にして摘み上げ、獣人姿になる狐獣人\n③さらに呪いによって二人が一体化した四角い紙になる\n\n②の折り紙の男の子は肌色のまま真四角になったような見た目で、③は四角い男の子を中心に四角い狐獣人が包んでいるような見た目でお願いします。\n\n男の子の見た目は褌のみを着た姿、狐獣人は黄金の毛並みと浴衣を着た見た目でお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@syasyouyamamoto/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1578484, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a947408e/uploads/origins/bb76baad-7516-41ae-843f-d827f118ea7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a961b91d14ebc354d9fda9c2a81b236b", "srcset": "https://si.imgix.net/a947408e/uploads/origins/bb76baad-7516-41ae-843f-d827f118ea7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a961b91d14ebc354d9fda9c2a81b236b, https://si.imgix.net/a947408e/uploads/origins/bb76baad-7516-41ae-843f-d827f118ea7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39327d56accc9a04120c82e1cad95cf7 2x, https://si.imgix.net/a947408e/uploads/origins/bb76baad-7516-41ae-843f-d827f118ea7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62c89eb0b28533dcfa244d69f331c4d6 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a947408e/uploads/origins/bb76baad-7516-41ae-843f-d827f118ea7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3563de5e1c7b85b7714bfcfa020ceac", "srcset": "https://si.imgix.net/a947408e/uploads/origins/bb76baad-7516-41ae-843f-d827f118ea7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3563de5e1c7b85b7714bfcfa020ceac, https://si.imgix.net/a947408e/uploads/origins/bb76baad-7516-41ae-843f-d827f118ea7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=800477ee9158d0eef43b65ad5efb0c32 2x, https://si.imgix.net/a947408e/uploads/origins/bb76baad-7516-41ae-843f-d827f118ea7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d91e2adc3743410ea9aa67c3d6cef9c7 3x"}, "body": "突然の依頼失礼します\n仮面ライダーの怪人と、改造されて番になった女性が並んでいるイラストを6枚依頼してもよろしいでしょうか？\n衣装指定など無い場合は、基本的に素体の女性が怪人TFした姿をイメージして頂ければ幸いです。\n（キャラ名などは人間含め、調べると公式の図鑑が出てきます、一部は個人的にまとめた資料も有）\n\n以下、キャラと内容、カッコ内は素体名\n\n1枚目\n蜘蛛男と蜘蛛女（緑川ルリ子）\n緑川博士の裏切りを未然に阻止した蜘蛛女\n彼女は蜘蛛男の横で返り血を拭いもせず、絶頂しながら笑う\nその様子に蜘蛛男も股間をギンギンに滾らせているようだ\n「あははっ！　さいこぉっ……！　快感すぎて濡れちゃったわぁ……」\n「おいおい……親を殺してそれか？　大した女だな」\n「裏切り者なんて親じゃないもの、それよりあなたぁ、ご褒美ちょうだい？」\n\n2枚目\nハサミジャガー2号（珠純子）とカメバズーカ2号（風見雪子）\nかつての兄を始末する任務を無事達成したカメバズーカ2号\n珠純子だった頃と同じ髪を残しているハサミジャガー2号に対し、カメバズーカ2号はその小柄な肉体と小さな膨らみに面影を残す程度だ\n赤熱したバズーカが発する熱と、舞い散る元兄の灰に興奮する彼女の隣で、ハサミジャガー2号もまた素晴らしい妹の完成に絶頂する\n「シザァーズ！　両親に続いて兄を始末した感想はどう？」\n「ズゥーカァー！　たまりません……！　これで私の家族はお姉様と、カメバズーカ1号お兄様だけになったのですから！」\n\n3枚目\nネオショッカー大首領と竜怪人ミドリ（叶みどり）\nネオショッカー大首領の隣に寄り添う薄紫の竜怪人ミドリ\nかつて人間だった彼女は、今や人の面影を持たないメスの竜となり、ネオショッカーのベルトが腰に輝いている\nミドリは生まれ変わった自分の大きな体に愉悦を感じ、人間を見下しているようだ……\n「うふふ……ああ、人間はなんてちっぽけなのかしら……ライダーも踏み潰せばこの通り」\n「良いぞミドリ、さあ……ちっぽけな人間のちっぽけな希望を火葬してやれ、お前のブレスでな」\n\n4枚目\nフォッグの王子ガライと王太子妃カナ（木村加那）\nhttps://imgur.com/a/NPoNa6t\nガライの傍らに立ち、仮面ライダーJの死体を踏みにじるカナ（見上げ視点、死体は影程度でOK）\nガライの対といえる黒い鱗の鎧や蒼いコアなどを持つ彼女は、小柄な体躯には少し大きいサーベルに着いた血を拭いもせず冷酷な目を向けている\nガライはそんな彼女に慣れない愛しさを感じつつ、後ろからぎこちなくスリットを指で弄るのだった\n「ガライ様に逆らう虫けらが……身の程を知りなさい」\n「よくやったカナ、お前の戦果となれてこの生物も本望だろう」\n\n5枚目\nン・ガミオ・ゼダと王妃ゴ・アイ・ダ（八代藍）\nhttps://imgur.com/a/MdYL80a\n黒煙の中ガミオと寄り添う、揃いの装束を着たメスのオオカミ種怪人\nかつて八代藍だった彼女は、獲物の血を拭いもせず交尾に勤しむ\n興奮しながら番を求め腰を振る彼女は、まさに狼の怪人だった\n「初めての狩りはどうだ、アイ」\n「最高ですわ、あ・な・た！　狩りも交尾も、下らない警察の百倍楽しい！」\n\n6枚目\n山本さんのキャラから舞美ちゃんと誰か一人、ショッカーの怪人に改造された姿\n悪のふたなり狸怪人となった舞美ちゃん、ベルトのバックルすら隠れるほどの剛直を、怪人化したもう一人が恍惚の表情で舐めている\nその様子を見ながら、舞美ちゃんは怪人パンデミック作戦の開始を首領へ伝えるのだった\n「はっ、首領様……！　この通り、チンポの効き目は抜群です！」\n「このまま、全てを私の虜にしてみせます！」\n\n以上です、マニアックな内容ばかりですが、いかがでしょうか？\nご一考頂けましたら幸いです！", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@syasyouyamamoto/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1578484, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/badecdf0/uploads/origins/1f09fd8a-30ba-435a-9ebf-7292af703439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecb9e39d260fca4e26316b94f0284152", "srcset": "https://si.imgix.net/badecdf0/uploads/origins/1f09fd8a-30ba-435a-9ebf-7292af703439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecb9e39d260fca4e26316b94f0284152, https://si.imgix.net/badecdf0/uploads/origins/1f09fd8a-30ba-435a-9ebf-7292af703439?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98d7817b457b5e6af46370fc8fdf5323 2x, https://si.imgix.net/badecdf0/uploads/origins/1f09fd8a-30ba-435a-9ebf-7292af703439?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=154b27bc81cf396617cc1745a8b5eb11 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/badecdf0/uploads/origins/1f09fd8a-30ba-435a-9ebf-7292af703439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=2