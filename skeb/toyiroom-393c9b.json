て海へやってくる。なので美味しい貝を育てるには、山に木を植え森を育てる事が大切。「森と海は相思い」である。\n以上ーーーーーーーーーーーーーーーーーーーーー", "nc": 16, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@saku_nosuke/works/133", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 669169, "client_id": 377999, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da378d42/uploads/origins/447ff126-2726-4de3-a2b8-99792da1ab21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09758656f229a1045d6f33ebe8c80d67", "srcset": "https://si.imgix.net/da378d42/uploads/origins/447ff126-2726-4de3-a2b8-99792da1ab21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09758656f229a1045d6f33ebe8c80d67, https://si.imgix.net/da378d42/uploads/origins/447ff126-2726-4de3-a2b8-99792da1ab21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22b8a6c855bb4af901e639803ac9f614 2x, https://si.imgix.net/da378d42/uploads/origins/447ff126-2726-4de3-a2b8-99792da1ab21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65d0333d95f4c40539efc8cf8bdd3c2c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da378d42/uploads/origins/447ff126-2726-4de3-a2b8-99792da1ab21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=560ba0c519ccbe3d0908628dd913a8fd", "srcset": "https://si.imgix.net/da378d42/uploads/origins/447ff126-2726-4de3-a2b8-99792da1ab21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=560ba0c519ccbe3d0908628dd913a8fd, https://si.imgix.net/da378d42/uploads/origins/447ff126-2726-4de3-a2b8-99792da1ab21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc3a077767170144058c33b1ff508a07 2x, https://si.imgix.net/da378d42/uploads/origins/447ff126-2726-4de3-a2b8-99792da1ab21?bg=%23ff