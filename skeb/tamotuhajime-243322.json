一緒にいるうちに素直になっていき微笑んだりするようになりました。\n\n▽OC2：男の子\n絵本作家＋誘拐犯／25歳／157cm\n髪：灰色#D7D6DD\n瞳：ブルーグレー#788FDA\nOC1の王子様としてふるまう男の子。\nOC1と一緒にいるうちに恋に落ちました。べたぼれです。\nハーフですが見た目がかなり幼く18歳程度にみえます。\n穏やかな話し方をする子です。\n\n▽関係性\n男の子が女の子を「誘拐」して一緒に暮らしています。\n傍から見ると高校生カップルのように見えるかもしれません。\nイメージソング：ロミオとシンデレラ\n\n------\n\n可能であれば2人のやり取りをいくつか描いていただけると嬉しいです。\n単色の詰め合わせでのイラストが希望ですが、有一さんの描きやすいように描いていただければと思います。\n\nご多忙の中恐縮ですが、ご検討いただけますと幸いです。\nもしご都合が合わないようでしたら、どうぞご遠慮なくキャンセルしていただいて構いません。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1SMqFM5J9kbpH9GZHQu84B5NggMs7PDyn?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tamotuhajime/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3438737, "client_id": 1473258, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ced00a54/uploads/origins/51d92ecc-c2a0-416b-adfa-6a59db91e0fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d44887145a3244513f3b001e0c1a01f", "srcset": "https://si.imgix.net/ced00a54/uploads/origins/51d92ecc-c2a0-416b-adfa-6a59db91e0fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d44887145a3244513f3b001e0c1a01f, https://si.imgix.net/ced00a54/uploads/origins/51d92ecc-c2a0-416b-adfa-6a59db91e0fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66d17cc5d0203c85bee6347101cea45d 2x, https://si.imgix.net/ced00a54/uploads/origins/51d92ecc-c2a0-416b-adfa-6a59db91e0fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2901aa4d299e0fe722339cffab14a36 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ced00a54/uploads/origins/51d92ecc-c2a0-416b-adfa-6a59db91e0fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea14ab634d0742598d05b35d01dfb843", "srcset": "https://si.imgix.net/ced00a54/uploads/orig