%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=013c1b63c067a9cbd5b86476823a0238", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e50260eb/uploads/origins/7aade375-42ac-4e3e-a8ca-7c5b17cb2d6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=513fe4eaed1df43181481cd32b841218", "src_set": ""}, "body": "こんにちは、あなたの作品を拝見し、その画風がとても気に入りました！\nコンピュータのモニターに照らされた暗いベッドルームに4人のキャラクターがいる壁紙のイラストを依頼したいのですが、可能でしょうか？\n\nキャラクター\n- エイサ（私のOC、KEEP MASK ON）\n- 本海スターレールのスパークル\n- 罰する灰色カラス』のジェタビー\n- 波濤のフロロヴァ\n\nコンテンツ\nエイサはパソコンに向かって真剣にゲームに集中している表情をしているが、その間、3人の女の子はエイサをからかっている。左側のジェタヴィーはいたずらっぽい表情でエイサの頬をつつく。右側のスパークルは、おもちゃの銃をエイサの頭めがけて撃つが、紙吹雪が舞う旗が出てくる。フロローヴァは、アイサの椅子の後ろで、両腕でアイサの頭にもたれかかり、ヤンデレな表情で彼岸花をアイサの髪にそっと挿す。エイサは動じることなく、まだ集中している。\n\nhttps://drive.google.com/drive/u/1/folders/1dk2MpkMlWUktYTksXb1V957oaEVTJ6cc", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@e_buki818/works/32", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2531428, "client_id": 2262537, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5825e7ea/uploads/origins/d89a94a9-6a55-4111-a834-fc3be8bc21f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76fe3a3a0b5d69adb0dc82cded1d59c7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5825e7ea/uploads/origins/d89a94a9-6a55-4111-a834-fc3be8bc21f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cd0bf2201c65f0e7f9187ff40edcf11", "src_set": ""}, "body": "初めまして、Vtuberとして活動している眠乃よると申します。\nスタレやゼンゼロの素敵なイラストからe武器様を知り、ぜひ私も描いていただきたくリクエストいたしました。\n\n【使用用途】\n・YouTube（収益化済・メンバーシップ含む）やFANBOXでの使用\n・X等のSNSへの投稿\n\n【人物】\n眠りの国の夢の使者として、人々に安眠を届ける仕事をしています。\n黙っていればおとなしそうな見た目の少女で、\n実際は喋ると騒がしい、無邪気、元気、負けず嫌い、見た目よりもかなり幼いタイプです。\n普段は明るく元気・表情豊かな少女のイメージですが、今回は若干お淑やかなような、儚げな雰囲気で描いていただけますと嬉しいです。\n\n【内容】\n「夏」「浴衣」をテーマにした一枚をお願いいたします。\n\nお祭りのような喧騒の中というよりも、少し離れた人気の少ない場所で見る（やる）花火や、風鈴やあじさい・朝顔のような花、縁側や海等の涼し気・落ち着いた場所や雰囲気・シチュエーションだと嬉しいです。\n上記はぱっと思いついたものですので全然違うシチュエーションでも問題ございません。\n\n浴衣の色やデザイン等、その他不明点すべておまかせいたします。\n髪型は通常おろしていますが、浴衣に合うようヘアアレンジしていただけますと嬉しいです。\n\n資料はURL内にございますのでご参照ください。\nまた、可能であればキャラと背景のレイヤーを分けていただけますと助かります。\n\nご検討いただけますと幸いです。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1iUqt9Fpj48YBJVYsL_RTyTuMZLuXEICz", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@e_buki818/works/31", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2531428, "client_id": 2725683, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8f89725/uploads/origins/17fb8f6b-5779-40f0-b0bd-c341d7f2776e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a99b2432b8981ca932d9adf14a729cd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8f89725/uploads/origins/17fb8f6b-5779-40f0-b0bd-c341d7f2776e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e7078acb9785f323ce69b18ad7f26c6", "src_set": ""}, "body": "e武器＠お仕事募集中様\n\n私はあなたの作品が大好きで、私のVtuberモデルのリデザインをお願いしたいんです。\n\n⋆┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈⋆\n\n✦全体の構成は先生が自由に作ることができます！\n\n⋆┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈⋆\nスケジュールが合わなく場合は、\n遠慮なくキャンセルして頂いて構いませんので、是非ご検討の程よろしくお願い致します！\n何があってもお疲れ様でした！\n\nhttps://drive.google.com/drive/folders/1VsbWKGBwJTLRHtm05kuTSHAJf9qrX8Gj?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@e_buki818/works/30", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2531428, "client_id": 3481829, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/981a73b5/uploads/origins/980df560-9b2c-4855-8ca6-d4bf40f6a5b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d167713f3dfdaef1ea2612931df75e17", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/981a73b5/uploads/origins/980df560-9b2c-4855-8ca6-d4bf40f6a5b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ff844f8a80f2b3c69e376725e4721f2", "src_set": ""}, "body": "創作は自由です！情報としては、蕎麦茶、カラオケ、他のヤクザ組と戦うのが好きらしい！\n\n参考画像：https://x.com/toramiyana/status/1879292651129979019?s=46&t=t43wxzEjivypZiSglCeesw", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@e_buki818/works/29", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f662d02d/uploads/origins/a6441ddd-9b25-461b-8fe1-4d981416ea45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d85332ce80a05ddabaec7b0946cb1774", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2531428, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@e_buki818/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2531428, "client_id": 2599548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d816d40c/uploads/origins/e44e13d1-772f-4d79-a79a-2ccb374bf37a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1b52b39acd4c2b6f4717fc1216885c3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d816d40c/uploads/origins/e44e13d1-772f-4d79-a79a-2ccb374bf37a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f4713d3b412cb1a19e566fb379bfc54", "src_set": ""}, "body": "こんにちは！\n\n私のオリジナルキャラクター、カイの作品を依頼したいと思っています。\n普段はスポーティーで運動量の多い服を着ていますが、この作品では、居心地の良いカジュアルな家でくつろいでいるような服を着てほしいです。髪を乱れたお団子にし、眼鏡をかけ、トレーディングカードのコレクション、新しく作ったガンプラ、好きな映画など、ニッチな趣味のひとつを熱心に披露してほしい。まるでカメラに向かって見せているかのように。これは個人的な使用になる。\n\nお忙しい中、ご覧いただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/14vbjALEa0W47HGF7vdCS8A9mIhzRppRp", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@e_buki818/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2531428, "client_id": 855856, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0c06ca7/uploads/origins/4e146c8f-e604-4815-b0be-10bfb5acf6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2882ec421fd61c977bafc1f32b4a06c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0c06ca7/uploads/origins/4e146c8f-e604-4815-b0be-10bfb5acf6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=debe2cb65159b54db13241ba887e7d2c", "src_set": ""}, "body": "안녕하세요, 제 캐릭터의 일러스트를 부탁드려도 될까요?https://drive.google.com/drive/folders/1ndM11BEfyTnnaKqiajdLjPRpCyjE92lP?usp=sharing  \n그녀는 포동포동한 미소녀입니다. 허벅지는 두껍고 포동포동합니다. 머리는 웨이브 머리에, 앞머리가 눈을 반 가리고 있어요. 머리는 에쉬브라운 + 연 분홍색입니다. 하얀색 머리띠는 그려주지 마세요. 골드색 머리핀은 꼭 다 그려주세요. 긴 머리로 부탁드립니다. \n\n발렌타인 데이를 위한 배경화면 일러스트를 그려주세요: https://files.catbox.moe/ttzq2j.jpg\n시청자와 데이트를 하고 있습니다. 시청자의 손을 잡고 있었으면 좋겠어요. 사랑에 빠진 모습으로 시청자를 바라보고 있었으면 좋겠습니다. \n의상은 하나 골라서 그려주시면 됩니다. 나머지는 맡기겠습니다. \n\n가능하다면 일러스트에서 캐릭터의 머리, 팔, 상반신이 잘리지 않았으면 좋겠어요. .psd파일에 캐릭터와 배경은 나눠주시길 바랍니다. 그림은 YouTube 썸네일, 방송화면, SNS등에 쓰이고, 선생님 닉네임 표기도 꼭 할 예정입니다. 그림 해상도는 16:9, 2880x1620px 이상으로 그려주세요. 리퀘스트가 불편하시다면 거절해주세요. 잘 부탁드립니다.", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@e_buki818/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2531428, "client_id": 1274553, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dab57efa/uploads/origins/4a547684-24f6-41b2-8c87-98927474b44c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d73ce94ae96b6a7267a1f6592a4a1b5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dab57efa/uploads/origins/4a547684-24f6-41b2-8c87-98927474b44c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd4f620d7379de013f5e3ba667d447ee", "src_set": ""}, "body": "初めまして！ステキな絵を拝見させていただき、今回依頼させていただきました！\n\n今回こちらの方のイラストを描いていただくことは可能でしょうか？\n\nhttps://gyazo.com/fd2f34e30ca9115f7b3afb8cc16924ee\n\n届いたイラストは↑のキャラの方がやっているIRIAMでの配信やアイコン、返礼品などに使用させていただきたいです。\nかわいさ、を強調して頂ければ構図やポーズはお任せ致します。\n納品時はPSDデータで人物、背景でレイヤー分けされた状態にしていただけると嬉しいです。\nどうかよろしくお願いいたします。\n\nhttps://x.com/konerishina/status/1863171595713540255", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@e_buki818/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2531428, "client_id": 3197157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db9c2469/uploads/origins/88549d35-8d04-4b7c-9f4e-20b2b3e4ae80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5b222fa00d8cc70df8daa1d8424abf4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db9c2469/uploads/origins/88549d35-8d04-4b7c-9f4e-20b2b3e4ae80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7cf5fbc7cf413434bf6b11561fecc179", "src_set": ""}, "body": "初めまして、e武器様。\n個人Vstreamerの藪内ぱんだと申します。\n\nXにて