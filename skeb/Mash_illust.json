bnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Mash_illust/works/59", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2501710, "client_id": 26970, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54bef86e/uploads/origins/1ee13b6a-6839-4378-ac34-cfe54d4e48c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c1dba5eafaf65ae83a87f73f8b1fa4d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54bef86e/uploads/origins/1ee13b6a-6839-4378-ac34-cfe54d4e48c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b370777222ea9ed191c194dd0a8699a5", "src_set": ""}, "body": "虚構菌糸ちゃんがぶっ刺さりしたのでご依頼致します。\n●キャラクター\n　「虚構菌糸」ちゃんをお願いします。\n●シチュエーション\n　マゾをバカにしてる態度で嘘喘ぎや罵倒しながら、嘘セックス（オナホコキ）してくれる虚構菌糸ちゃんをお願いします。\n　構図や体位、台詞等は全てお任せ致します。\n\n何卒宜しくお願い致します。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Mash_illust/works/58", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2501710, "client_id": 529560, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46a8eaa1/uploads/origins/9dbbd125-c18f-499c-b1b8-ae0667daba2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e57343e8a9b82ab79516724e6d0518a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46a8eaa1/uploads/origins/9dbbd125-c18f-499c-b1b8-ae0667daba2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8aec21d977e948dee2de093fac0b527f", "src_set": ""}, "body": "はじめまして。\n描かれているブルアカ絵に惹かれたので依頼させていただきます。\n\nキャラクター：ケイ（ブルーアーカイブ）\nシチュエーション：先生と「先生の獣欲を王女に向けさせないため」の名目でアリスの身体でセックス\n内容：\n・衣装についてはお任せします。全裸でも構いません。\n・「先生が興奮する→一度の射精量が増える→先生から搾り取り切るまでのセックスの回数を減らせる」\n　と言う論法でゴムなし。\n・結合部が見えるアングルの正常位で、口が押さえられないように両手を恋人繋ぎ。\n・先生を睨みながらも、食いしばった口から甘い声が漏れている表情。\n・先生の描写は腕と下半身のみの最低限で構いません。\n・差分として、\n　蕩けた顔で声も押さえていない表情と、\n　射精（断面図付き）に合わせて絶頂し、ヘイローがブレて霞んでいるところをお願いします。\n\n以上、細かくて恐縮ですがよろしくお願いします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Mash_illust/works/57", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/47485a94/uploads/origins/93d20953-91fa-44b3-aaa3-71795830ae3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a5277add3b40da5755b16ee15d548ff6", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2501710, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Mash_illust/works/56", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/803daac0/uploads/origins/5efcfc07-6543-42ed-bab8-8ea71468720f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=606b9a3b15b0551301c018a70ce4e408", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2501710, "client_id": 3218006, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Mash_illust/works/55", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7ca7b1a6/uploads/origins/7a2c8019-3aa0-48