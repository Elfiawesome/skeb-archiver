4ef2b14d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5522e34b0abc1a10c621d734705a18f7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d78a9e6/uploads/origins/ad6ae74f-0628-4cd9-b1d0-0bc4ef2b14d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7a2057d8e76fc045298b421de881ea1", "srcset": "https://si.imgix.net/6d78a9e6/uploads/origins/ad6ae74f-0628-4cd9-b1d0-0bc4ef2b14d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7a2057d8e76fc045298b421de881ea1, https://si.imgix.net/6d78a9e6/uploads/origins/ad6ae74f-0628-4cd9-b1d0-0bc4ef2b14d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e34788b79515db7b551bb146284ff4ec 2x, https://si.imgix.net/6d78a9e6/uploads/origins/ad6ae74f-0628-4cd9-b1d0-0bc4ef2b14d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=417704121aeef7092579b84b0b654b14 3x"}, "body": "こんにちは、あなたのイラスト、とってもかわいいですね！私と友達のイラストを描いていただけないでしょうか。\n\n合計で6人います：\n\n1. キャス\n2. トレイ\n3. サフ\n4. ホイティ\n5. クープス\n6. ナー\n\n具体的なポーズや表情は、お任せしたいと思います。\n\n私たちを描く際に、ぜひ盛り込んでいただきたい重要な特徴は以下の通りです：\n1. キャスの顔にはそばかすがあります。\n2. トレイのシャツには「fih」という文字と、魚の絵が描かれています。\n3. サフの顔にもそばかすがあります。\n4. ウィティーの目はハート型です。これは必須です！\n5. クープスの髪には複数の色が混ざっています。\n6. ナールの頭には、大きな色付きの角の後ろに小さな白い角があります。また、前髪には2本の白い筋があり、目立たない方は右側にあります。\n\nキャラクターアートと背景が分離されたバージョンも含まれていれば幸いです。もしよろしければ、そのイラストをSNSに投稿・使用させていただきたいと考えています。\n\nGoogleドライブのリンクにある「MiChuu」というフォルダは無視していただいて構いません。これは私たちのペットの犬のマスコットです！\n\nご配慮いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1Drz47Fd2yVRGsXNa7UisHUI3qSFGgwJS?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@paled0_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4137788, "client_id": 1713283, "vtt_url": null, "thumbnail_