supepo/status/1664293689412435968\n\n構図ですが、バイオハザード6の「センチネルナイン　レオンモデル」のキーアートのように、\nハンドガンを構えているものをお願いしたいです。\nhttps://www.tokyo-marui.co.jp/bio/special/sentinelnine/08/img/gr_01.png\n\n太極図のアクセサリは必ず入れて欲しいです。\nその他服装や細かい構図、銃の種類、シチュエーションなどはおまかせします。\nアイコンや、ヘッダ、YouTubeなどで使用する可能性があります。\nお手数おかけしますがキャラのみ透過差分も欲しいです。\n\n以上の内容でお受けできそうであれば、お願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jun0000000000/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2229904, "client_id": 1007331, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e3cc78e/uploads/origins/7967a663-45db-4543-93b8-b3caaa5d4a87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b7ebd2869f1102c57f6da7574e1419e", "srcset": "https://si.imgix.net/3e3cc78e/uploads/origins/7967a663-45db-4543-93b8-b3caaa5d4a87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b7ebd2869f1102c57f6da7574e1419e, https://si.imgix.net/3e3cc78e/uploads/origins/7967a663-45db-4543-93b8-b3caaa5d4a87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=08b66ae4fd2d5d99f6e77690a88f24e1 2x, https://si.imgix.net/3e3cc78e/uploads/origins/7967a663-45db-4543-93b8-b3caaa5d4a87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d753c533236551699fb77209ed89b1d2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e3cc78e/uploads/origins/7967a663-45db-4543-93b8-b3caaa5d4a87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c95dab12e048b3befe8043963cd3daea", "srcset": "https://si.imgix.net/3e3cc78e/uploads/origins/7967a663-45db-4543-93b8-b3caaa5d4a87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c95dab12e048b3befe8043963cd3daea, https://si.imgix.net/3e3cc78e/uploads/origins/7967a663-45db-4543-93b8-b3caaa5d4a87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac1c69b1472c79e7207f93999b50c1c6 2x, https://si.imgix.net/3e3cc78e/uploads/origins/7967a663-45db-4543-93b8-b3caaa5d4a87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e805d5cfff7fdc91332123fa766459da 3x"}, "body": "2度目のリクエスト失礼致します。\n\n「標的を小型リボルバー拳銃で撃った直後の仕事人結月ゆかり凪さん」をお願い致します。\n指定としては\n・武器はリボルバー拳銃1丁。（SAK●RA360のような5発リボルバーだとなお嬉しい）\n・凪さんの衣装のうちズボンのベルトバックルが尾錠止めにアレンジしていただけると嬉しい。\n・ベルトにホルスターとローダーポーチが付いていると嬉しい。\n・何発か撃った事を表現するために、リボルバーのシリンダー内の弾頭が1～2発消えていると嬉しい。\n\n不躾で恐縮ですが、何卒よろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jun0000000000/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2229904, "client_id": 1069497, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e3549ff/uploads/origins/51d01b06-dd72-4af2-b447-4a4a93660414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cf9720ed5e20ec9ad6c5725f463b31a", "srcset": "https://si.imgix.net/1e3549ff/uploads/origins/51d01b06-dd72-4af2-b447-4a4a93660414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cf9720ed5e20ec9ad6c5725f463b31a, https://si.imgix.net/1e3549ff/uploads/origins/51d01b06-dd72-4af2-b447-4a4a93660414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a3f0cb6cee47854aa6c00cd45ab939a 2x, https://si.imgix.net/1e3549ff/uploads/origins/51d01b06-dd72-4af2-b447-4a4a93660414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b0729e72ad7c7ff58e0b0f3742a81e6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e3549ff/uploads/origins/51d01b06-dd72-4af2-b447-4a4a93660414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02fbaa965d5dbf23b3f0384944b68106", "srcset": "https://si.imgix.net/1e3549ff/uploads/origins/51d01b06-dd72-4af2-b447-4a4a93660414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02fbaa965d5dbf23b3f0384944b68106, https://si.imgix.net/1e3549ff/uploads/origins/51d01b06-dd72-4af2-b447-4a4a93660414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5212f67acd37cf5f2eedc70f2cc109cc 2x, https://si.imgix.net/1e3549ff/uploads/origins/51d01b06-dd72-4af2-b447-4a4a93660414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=91d7df0352e23c7285a7791ff280e043 3x"}, "body": "いつも素敵なイラスト拝見しております！\nこの度はぜひJunagna様に、当方の同人誌に登場する特定の設定下の結月ゆかりを描いていただきたいです。\n設定画や本文の一部等をファイルにおまとめしましたのでご参考にいただければと思います。\n\nざっくりいうと、\n・ややサイバーパンクな世界観で\n・光る青い翅を生やし、空を飛んで戦うアンドロイドのゆかりさん\n\nその他詳細なシチュエーションなどは一切お任せいたします。\n設定等はあくまで参考程度に、自由に改変・解釈等していただいても構いません。\n\nもしお気が向けばどうぞよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/18hCmPvzIyGHDTXxEt-8gIrx8bi5hLch7?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jun0000000000/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1e4d9cc0/uploads/origins/0e111d11-2e65-4531-b225-6acb6281c870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4bdb1c7bc533e280ff15d988919ac9c6", "srcset": "https://si.imgix.net/1e4d9cc0/uploads/origins/0e111d11-2e65-4531-b225-6acb6281c870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4bdb1c7bc533e280ff15d988919ac9c6, https://si.imgix.net/1e4d9cc0/uploads/origins/0e111d11-2e65-4531-b225-6acb6281c870?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=m