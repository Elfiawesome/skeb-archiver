嬉しいです。それ以外の指定はありません。服装や髪型も自由に変更して貰って構いません。\nご検討よろしくお願いします。\n\n☆ざっくりしたキャラクタープロフィール\n御鏡 蜜柑(みかがみ みか)\n天使の輪っかのようなアホ毛が特徴的な26歳男性です。容姿はかなり整っている方で、かわいいタイプかな？と思ったらよくみると美人ってタイプかも？という感じをイメージして描きました。いつもニコニコ笑顔でいることを心がけています。人のためになることが好きで、休日はボランティア活動に参加したり、浜辺でゴミ拾いをしています。光属性です。\n実はゴリゴリのパワータイプで身体もしっかりしています。だいたいのスポーツはそつなくこなせます。\n\nhttps://drive.google.com/drive/folders/1DbzQxamVwEKl6zTUSyBX7D0kvcY9gBBd?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@U_sumika_U/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2912607, "client_id": 2886161, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87c2c752/uploads/origins/b22330be-84f4-41b3-95cb-ca55bfe91fb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c0ac598d38f415e41d9e1713c7c3a8d", "srcset": "https://si.imgix.net/87c2c752/uploads/origins/b22330be-84f4-41b3-95cb-ca55bfe91fb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c0ac598d38f415e41d9e1713c7c3a8d, https://si.imgix.net/87c2c752/uploads/origins/b22330be-84f4-41b3-95cb-ca55bfe91fb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53095b937aebaed80c2e094c6029c020 2x, https://si.imgix.net/87c2c752/uploads/origins/b22330be-84f4-41b3-95cb-ca55bfe91fb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3e8974db3c077ed7c68a37f2535c0dc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87c2c752/uploads/origins/b22330be-84f4-41b3-95cb-ca55bfe91fb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=685f9f9ba4eb32f70318ce1d93ad96ad", "srcset": "https://si.imgix.net/87c2c752/uploads/origins/b22330be-84f4-41b3-95cb-ca55bfe91fb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=685f9f9ba4eb32f70318ce1d93