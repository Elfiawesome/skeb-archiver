, {"path": "/@irodako/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2969188, "client_id": 1995832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9aa01879/uploads/origins/b8b32f17-7ecd-4957-b190-28169dec56cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cacff8cea5b480ede6805b95d733db8c", "srcset": "https://si.imgix.net/9aa01879/uploads/origins/b8b32f17-7ecd-4957-b190-28169dec56cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cacff8cea5b480ede6805b95d733db8c, https://si.imgix.net/9aa01879/uploads/origins/b8b32f17-7ecd-4957-b190-28169dec56cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44baeefa361bb53b3b08c6597d288d32 2x, https://si.imgix.net/9aa01879/uploads/origins/b8b32f17-7ecd-4957-b190-28169dec56cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba99e0a0617a659564ac79cb637bf1b1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9aa01879/uploads/origins/b8b32f17-7ecd-4957-b190-28169dec56cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc72fda6d93ee47dcb32b0f379423a28", "srcset": "https://si.imgix.net/9aa01879/uploads/origins/b8b32f17-7ecd-4957-b190-28169dec56cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc72fda6d93ee47dcb32b0f379423a28, https://si.imgix.net/9aa01879/uploads/origins/b8b32f17-7ecd-4957-b190-28169dec56cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=305cc71f2d45b895f2e13852ebcf5aaa 2x, https://si.imgix.net/9aa01879/uploads/origins/b8b32f17-7ecd-4957-b190-28169dec56cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6191b996c3b820ee0bb93e550386c53b 3x"}, "body": "いろだこ様\n\nこんばんは！\n個人でVTuberをしている、わんこ系VTuberの加々流がろらと申します。\nXにていろだこ様のイラストを拝見しており、いろだこ様の描く少年たちが可愛くて大好きです！\n\nそんないろだこ様がもしよろしければ、アイドル衣装の僕を描いていただけたらなと思い、リクエストさせていただきます…！\n絵の雰囲気など構図などはいろだこ様のお好きなように描いていただいて問題ございません！\n(資料URLにはドライブで複数角度から撮ったものを添付しておきます。)\n\nいただきましたイラストはYouTubeのサムネやTwitterの#おはようvtuberなどに使わせていただけると嬉しいです！※可能でしたら人物のみの背景透過もいただけるとありがたいです。\n\n拙い文章で申し訳ございませんがどうぞよろしくお願いします。\n今後もいろだこ様のイラストを楽しみにしております！！\n\nhttps://drive.google.com/drive/folders/1-5oxUjFzSv4aBxFr1wSFkmIZvIg1tuyR", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@irodako/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2969188, "client_id": 3057469, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4bca110e/uploads/origins/299ad438-3f29-4132-8ac8-c1d7f0ba34e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5190455e559399c2d7dc4788c3c8cd8", "srcset": "https://si.imgix.net/4bca110e/uploads/origins/299ad438-3f29-4132-8ac8-c1d7f0ba34e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5190455e559399c2d7dc4788c3c8cd8, https://si.imgix.net/4bca110e/uploads/origins/299ad438-3f29-4132-8ac8-c1d7f0ba34e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78940e10946424f25e5a92b9ea51da4a 2x, https://si.imgix.net/4bca110e/uploads/origins/299ad438-3f29-4132-8ac8-c1d7f0ba34e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92f1eb54ef28068011a642cca7f08f5c 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4bca110e/uploads/origins/299ad438-3f29-4132-8ac8-c1d7f0ba34e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0fc86632446e6f02b2e2d3ae441a9c15", "srcset": "https://si.imgix.net/4bca110e/uploads/origins/299ad438-3f29-4132-8ac8-c1d7f0ba34e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0fc86632446e6f