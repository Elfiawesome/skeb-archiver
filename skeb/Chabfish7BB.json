ipped": true, "creator_id": 384846, "client_id": 3012753, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03385987/uploads/origins/11d0431d-7fa9-4bca-8fb6-3f673137a76c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=737b3ae7d4650270c0c0c285b3e6d9b5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03385987/uploads/origins/11d0431d-7fa9-4bca-8fb6-3f673137a76c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5de9ba22f4033820e7f2944ed9ce3c13", "src_set": ""}, "body": "こんにちは、先生！先生のスケブ作品を拝見し、とても可愛いアートスタイルだと思いました！曲のカバーのための作品をお願いしたいです！\n\n友人のアレックスと私は、nqrseのByoushin（秒針）という曲をカバーする予定です。曲のリンクはこちらです：\nhttps://www.youtube.com/watch?v=BM75ALugj9w\n\nポーズや背景の構図は、曲に合うと思うのでお任せしたいです！ただ、背景は夜色を基調としたドリーミーな雰囲気でお願いしたいです。私のキャラクター(A)と友人のキャラクター(B)の参考資料を添付します。\n\n- 私のキャラクターデザインは、顔のハートマーク、緑とピンクの目、ハートのアホ毛、キツネの尻尾に注目してください。  \n- 髪を結んでいても（狐耳なし）、髪を下ろしていても（狐耳で右耳にピアス）構いません。\n\nもしご面倒でなければ、背景、友人、レイヤーを分けてください！\n\nこの度はご検討いただき、誠にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1fQd7a35by325gvRO0G8giHecTsJoAeIg?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Chabfish7BB/works/87", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fe019abb/uploads/origins/3f79f9ea-c098-43c1-b299-2ed884bb9519?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c6a95f80f3f204e2ef42539d5caac65", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 384846, "client_id": 2451271, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Chabfish7BB/works/86", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 384846, "client_id": 1928828, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c83822e/uploads/origins/138eeed4-ad8b-4c34-a5c2-b8f4085065cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bed690c6ffc3a7a6d7fa36dfe50a9e03", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c83822e/uploads/origins/138eeed4-ad8b-4c34-a5c2-b8f4085065cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e46a4f82457adabe85d5ca1c580d4a24", "src_set": ""}, "body": "こんにちは！コレットに対するあなたのアピールがとても気に入りました。\n\nコレットはとても自信家で、いつもちょっと目立ちたがり屋。コレットは熟練した剣士で、魔法学校の教師になっています。\nhttps://files.catbox.moe/jrp75l.png https://files.catbox.moe/d6vihd.png https://files.catbox.moe/zzoc8w.PNG （そして彼女の剣は https://files.catbox.moe/w4bgms.png ）。\n\nどちらのシーンもとても気に入りました！でも、（彼女が授業中に生徒を倒して満足する（そして他の先生たちに怒る））シーンが最初のシーンとしてはいいと思います。(もう一つのシーンも後で見に来ます :3 )\n\nポーズなどは特に考えていないので、お任せします。すでに聞いたアイデアで、きっと素晴らしいものになると思います！\n\nご検討ありがとうございました^^。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Chabfish7BB/works/85", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 384846, "client_id": 452479, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df1aefdd/uploads/origins/98d4ad6c-2243-4f03-9023-6987fd6ceb8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bcc1ac766ebcc625fb690a09d503100", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df1aefdd/uploads/origins/98d4ad6c-2243-4f03-9023-6987fd6ceb8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04c449bec52019b2e9e770f9fe34d5ff", "src_set": ""}, "body": "チャマさん！最後に作ってくれた作品に惚れました！言葉になりません！何度も私のカップルを描いてくれて本当にありがとうございました<3\n\nまた同じカップルを描いてもらってもいいですか？飽きないんです。今回は夏・ビーチのイラストを考えていました。\n\nLyyli: https://toyhou.se/20329161.lyyli-lila/28079027.summer-lyyli\n\nドリフト：https://imgur.com/a/summer-drift-oO4cl2x\n\nいつもご丁寧にありがとうございます。同じ2キャラを描くのに飽きたらお気軽にキャンセルしてください。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Chabfish7BB/works/84", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 384846, "client_id": 3301546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bdb0fe36/uploads/origins/3df43463-6275-41d4-8fcd-4ca36f32992d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7df82491b421866d1229afef5e5fcb51", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bdb0fe36/uploads/origins/3df43463-6275-41d4-8fcd-4ca36f32992d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1e523056dc3df98cf900dd115142f66", "src_set": ""}, "body": "こんにちは！\n\nあみやさんの絵のクールな感じが好きです。大好きなVtuberの網谷くんを描いてほしいです。\n参考にしてください：\nhttps://x.com/amiyaaranha/status/1716507535857922077\n\n普段はかわいいですが、牙を出したクールな一面も見てみたいです。衣装はどちらでも構いません。ポーズは皆さんの判断にお任せします。\n\nチャームポイントはクモの足と胸と太もものコルセットピアス、アホ毛、牙、額のクモの目、紫とピンクの髪。\n\n私のリクエストにお付き合いいただき、ありがとうございました。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 17065, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "チガサキユウ🐕chigasaki yu", "screen_name": "cgsk_3", "avatar_url": "https://pbs.twimg.com/profile_images/1346607634737025024/8g2P6Ibb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4257303194/1575250056/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30,