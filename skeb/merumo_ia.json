merumo_ia/status/1883107101419135287\nhttps://x.com/merumo_ia/status/1906306828511895740\n\n頭や髪の毛、体が切れていないキャラクターのみの透過データと背景込のデータをいただければ幸いです。   \n可能であれば、表情差分を入れていただけましたら嬉しいです。\n（難しそうであれば大丈夫です）\n ※その際はお手数ですがレイヤー分けしていただけましたら幸いです。\n\n\n   何とぞよろしくお願い致します……！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@merumo_ia/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2403743, "client_id": 2662106, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44625c22/uploads/origins/dae2607c-f1ff-4be7-9e55-3812c78acda8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f95760b33960db16039e4a9342d414c2", "srcset": "https://si.imgix.net/44625c22/uploads/origins/dae2607c-f1ff-4be7-9e55-3812c78acda8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f95760b33960db16039e4a9342d414c2, https://si.imgix.net/44625c22/uploads/origins/dae2607c-f1ff-4be7-9e55-3812c78acda8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a294f21cb2354cb4cdba0f635346aa5 2x, https://si.imgix.net/44625c22/uploads/origins/dae2607c-f1ff-4be7-9e55-3812c78acda8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4442326194320b4d0db47cbb4b82ca8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44625c22/uploads/origins/dae2607c-f1ff-4be7-9e55-3812c78acda8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d65f81ae58c5d93055d6ba9a98b3946d", "srcset": "https://si.imgix.net/44625c22/uploads/origins/dae2607c-f1ff-4be7-9e55-3812c78acda8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d65f81ae58c5d93055d6ba9a98b3946d, https://si.imgix.net/44625c22/uploads/origins/dae2607c-f1ff-4be7-9e55-3812c78acda8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=t