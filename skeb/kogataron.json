://twitter.com/kogataron/status/1774850864873922725）\n赤い爪は必ず描いてください。\nその他はお任せします。\n\nありがとうございました！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kogataron/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3182402, "client_id": 26072, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a191d3a/uploads/origins/15c56154-0f5a-42c7-859b-322270796a21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b6bd2da17b8c90d8685fbace027567f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a191d3a/uploads/origins/15c56154-0f5a-42c7-859b-322270796a21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcf4827aa3ce81aac1cdebf80026d817", "src_set": ""}, "body": "こちらのキャラクターを自由に描いていただけないでしょうか\n\nhttps://akuochi.com/vampire/character/vampiresierra/", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kogataron/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9a0de76a/uploads/origins/9517e4e2-9dfd-482c-a7dd-10d4198522fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef9884d0450afbcb5e2d9472c87ec689", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3182402, "client_id": 1191332, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kogataron/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3182402, "client_id": 2223302, "vtt_url": null, "thumbnail