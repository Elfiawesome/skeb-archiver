ンネルでの配信サムネイル、待機画面や動画内での使用、SNSやネットプリントなどで活用します。\n※今後グッズなど、商用利用をした場合はクレジット表記させていただきます。\n\n\n●参考URL\nhttps://drive.google.com/drive/folders/17mcpx1UsfOk3sKdfV63Wy-0vdSJwSxiL?usp=drive_link\n\n\nお忙しいところ恐縮ではありますが、ご検討よろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@iris_yucca/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3052737, "client_id": 2830533, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f7c82292/uploads/origins/11c465b4-09c0-42cd-974b-6204d8814ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa96d70b3b6034e6436159e91e5dbc13", "srcset": "https://si.imgix.net/f7c82292/uploads/origins/11c465b4-09c0-42cd-974b-6204d8814ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa96d70b3b6034e6436159e91e5dbc13, https://si.imgix.net/f7c82292/uploads/origins/11c465b4-09c0-42cd-974b-6204d8814ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=922d0c7889d0981779a0b8c509593664 2x, https://si.imgix.net/f7c82292/uploads/origins/11c465b4-09c0-42cd-974b-6204d8814ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcad61cd1fa9ffe4889afad0e81caf54 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f7c82292/uploads/origins/11c465b4-09c0-42cd-974b-6204d8814ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5286d8cad406116c9c713e4bede30af7", "srcset": "https://si.imgix.net/f7c82292/uploads/origins/11c465b4-09c0-42cd-974b-6204d8814ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5286d8cad406116c9c713e4bede30af7, https://si.imgix.net/f7c82292/uploads/origins/11c465b4-09c0-42cd-974b-6204d8814ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=66