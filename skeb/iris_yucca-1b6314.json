erの上月みやこさんへの\nプレゼントを予定しております。\nなので上月みやこさん本人のみ、\n収益化済み配信のサムネイル及び\n配信画面での使用の許可をいただきたいです。\n\nサイズは1920×1080で\n可能であれば透過素材をお願いします。\n\n以上になります。\nぜひご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/177Mm1JdXwPagnvfp_tBTKUmyBGzlioGX", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@iris_yucca/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b1f5a60c/uploads/origins/80089249-32d8-4c6e-9fc3-0c62b37694fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae37c82c948f614fa805d8da7a4bda15", "srcset": "https://si.imgix.net/b1f5a60c/uploads/origins/80089249-32d8-4c6e-9fc3-0c62b37694fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae37c82c948f614fa805d8da7a4bda15, https://si.imgix.net/b1f5a60c/uploads/origins/80089249-32d8-4c6e-9fc3-0c62b37694fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed715cbb21fdc40fdc2b0a7c1e52b974 2x, https://si.imgix.net/b1f5a60c/uploads/origins/80089249-32d8-4c6e-9fc3-0c62b37694fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19be9a6d1dffc1987ec0d65478065542 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3052737, "client_id": 3168657, "nc": 1}, {"path": "/@iris_yucca/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3052737, "client_id": 1485439, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8e54615/uploads/origins/8a9748e4-b451-4222-95b1-fa72918efdff?bg=%23fff&auto=format%2Ccompress