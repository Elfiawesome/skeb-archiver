す。\n\n初期衣装（1枚目）の場合頭の上のリスの省略可能、メイド服の場合ラズ（頭の上の小動物）省略可能。\nどちらの衣装でもリス尻尾は省略しても大丈夫です。\n服装は初期衣装とメイド服どちらでも、どちらも上着なしありおまかせ、\nお好みの方（描きやすい方）を描いて頂ければと思います。\n\n\n〇使用用途として可能性があるもの \n・各所SNSでの掲載、アイコンやヘッダーへの使用\n・Vtuber活動全般、配信上動画サムネイル画像、生放送配信画面に飾るなど\n・個人利用範囲内での私用グッズ作成（自分用のみ、使用と保存用の２個まで\n・その他Skebの利用規約やガイドラインで許可されていること  \n\nご検討どうぞよろしくお願いします。\n\nhttps://x.com/_ovovoip/status/1998297001881190764", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1235017, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "モイジ", "screen_name": "moimoiji", "avatar_url": "https://pbs.twimg.com/profile_images/2056188281222836224/65YDADRv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1830575754360561664/1736231914/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 1787818, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "美波ミナ", "screen_name": "minamimina01", "avatar_url": "https://pbs.twimg.com/profile_images/2074449452711206912/9ViQ533N.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1454028133032599552/1782391913/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 0}, {"id": 2306571, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ziu", "screen_name": "ziun_ziu", "avatar_url": "https://pbs.twimg.com/profile_images/1782338659490185216/jV2jxtp-.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "re