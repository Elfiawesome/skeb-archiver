ていただければうれしいです\n\nﾗｸﾕｲさんのXのアイコンがかわいくていつも癒されてます（今のも、少し前までのくまさんのも）\nFAきっかけでﾗｸﾕｲさんの事を知ったのでSkebを依頼できる機会がきてうれしいです\nもしご縁があればぜひお願いします\n引き続き活動を応援しています！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pine_ry000/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4020551, "client_id": 1748615, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20699efe/uploads/origins/02d462bf-46b9-43b8-9387-924f3dc9eb9b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=4fee4282aeba6e0fbbdedbd71cd5ec4c", "srcset": "https://si.imgix.net/20699efe/uploads/origins/02d462bf-46b9-43b8-9387-924f3dc9eb9b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=4fee4282aeba6e0fbbdedbd71cd5ec4c, https://si.imgix.net/20699efe/uploads/origins/02d462bf-46b9-43b8-9387-924f3dc9eb9b?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=45a6e4d6957ea1c3a6b442a13a7021dc 2x, https://si.imgix.net/20699efe/uploads/origins/02d462bf-46b9-43b8-9387-924f3dc9eb9b?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ee2d573e81199cba9753a786158a72c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20699efe/uploads/origins/02d462bf-46b9-43b8-9387-924f3dc9eb9b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=7ddaf41fa7fb955dfc9dd7d369dd8cd9", "srcset": "https://si.imgix.net/20699efe/uploads/origins/02d462bf-46b9-43b8-9387-924f3dc9eb9b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=7ddaf41fa7fb955dfc9dd7d369dd8cd9, https://si.imgix.net/20699efe/uploads/origins/02d462bf-46b9-43b8-9387-924f3dc9eb9b?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e1e270799bfbb8d3a717f4c1ccf7c7a0 2x, https://si.imgix.net/20699efe/uploads/origins/02d462bf-46b9-43b8-9387-924f3dc9eb9b?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=668a42261c26fea0c11ba536ee3cfdb8 3x"}, "body": "初めまして、漫画のアシスタントをしながら\nSNSにて配信など活動しております　まうねむ　と申します。\n\nXで募集されているのをお見掛けして…あまりにもかわいくて是非お願いしたくリクエストをお送りさせていただきました。\n\n✦概要\n୨୧私、まうねむを描いていただきたいです！\n୨୧メイド姿のうさぎの女の子です \nご縁がありましたら、お好きにたのしく描いていただけたらと思います！\n資料になります↓\nhttps://drive.google.com/file/d/1kuKj6bjww8zWx4X1TOwD5wiBi-pdZ-2d/view?usp=sharing\n\n✦用途\nＸなど活動、収益化済みのyoutube,twitchでの使用※不可でしたら大変失礼いたしました。\n※使用の際は、必ずお名前をクレジットさせていただきます。\n\nらくゆい様の作品、どれもとってもかわいくてたまりません…！ご検討いただけますと幸いです 🌷", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pine_ry000/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4020551, "client_id": 2496359, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e260e868/uploads/origins/5fedab1e-42cb-46c0-945f-34ed8014e2a2?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=8910553a3cd8b0782a6c7b9aba051abc", "srcset": "https://si.imgix.net/e260e868/uploads/origins/5fedab1e-42cb-46c0-945f-34ed8014e2a2?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=8910553a3cd8b0782a6c7b9aba051abc, https://si.imgix.net/e260e868/uploads/origins/5fedab1e-42cb-46c0-945f-34ed8014e2a2?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=35d8adf6fad7e8c049f6ebe936169f1f 2x, https://si.imgix.net/e260e868/uploads/origins/5fedab1e-42cb-46c0-945f-34ed8014e2a2?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec62897d9a6c7a8dabc21f8b20e916f4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e260e868/uploads/origins/5fedab1e-42cb-46c0-945f-34ed8014e2a2?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=25251975085ff94710e064afc1db8692", "srcset": "https://si.imgix.net/e260e868/uploads/origins/5fedab1e-42cb-46c0-945f-34ed8014e2a2?bg=%23fff&fm=webp&auto=c