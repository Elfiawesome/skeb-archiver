の作成\n・他の方へのイラスト等依頼時に資料として提出\n\n使用時は権利表記をさせていただきます。\n商用利用の予定はございません。\n背景にデザイン・装飾を入れて使用させていただく可能性がございます。\n\n■納品形式\nもし可能であれば背景透過PSDをいただけますと幸いです。他はおまかせいたします。\n\nどうぞご検討のほどよろしくお願いいたします…！\nもし金額に不足があれば再送依頼をお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Tz5ISrLuTlSnUpz4GsKaQtfI_U1UQ_Mm?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pine_ry000/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4020551, "client_id": 2838421, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3274faa9/uploads/origins/9816a1bd-aa6c-45d9-a3ac-5059c8a9294e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=10c036a516c7e75e2014492fa1e2507b", "srcset": "https://si.imgix.net/3274faa9/uploads/origins/9816a1bd-aa6c-45d9-a3ac-5059c8a9294e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=10c036a516c7e75e2014492fa1e2507b, https://si.imgix.net/3274faa9/uploads/origins/9816a1bd-aa6c-45d9-a3ac-5059c8a9294e?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b500e108e78cf3a3fae9f735726cb54 2x, https://si.imgix.net/3274faa9/uploads/origins/9816a1bd-aa6c-45d9-a3ac-5059c8a9294e?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=18da67fec66c285c863fff826b0e5527 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3274faa9/uploads/origins/9816a1bd-aa6c-45d9-a3ac-5059c8a9294e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=df7d46b0bdce1cf51f913634231dcc21", "srcset": "https://si.imgix.net/3274faa9/uploads/origins/9816a1bd-aa6c-45d9-a3ac-5059c8a9294e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=df7d46b0bdce1cf51f913634231dcc21, https://si.imgix.net/3274faa9/uploads/origins/9816a1bd-aa6c-45d9-a3ac-5059c8a9294e?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&b