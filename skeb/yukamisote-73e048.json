=88465cf01cfb6d8c58a444be892a06e9 2x, https://si.imgix.net/2c82d3b4/uploads/origins/49b65cd0-7980-4d76-ac22-199cc570fefd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99a9c6dfff76c5254418635ebb821557 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c82d3b4/uploads/origins/49b65cd0-7980-4d76-ac22-199cc570fefd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9741639920048964db3afd702284db3", "srcset": "https://si.imgix.net/2c82d3b4/uploads/origins/49b65cd0-7980-4d76-ac22-199cc570fefd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9741639920048964db3afd702284db3, https://si.imgix.net/2c82d3b4/uploads/origins/49b65cd0-7980-4d76-ac22-199cc570fefd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cdadc7f0079fce8974590f9df9047543 2x, https://si.imgix.net/2c82d3b4/uploads/origins/49b65cd0-7980-4d76-ac22-199cc570fefd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1a9323ca9a7ae3f52a787a5b3c88bad3 3x"}, "body": "初めて依頼をさせていただきます。\n普段ユカミソテ先生が描かれている漫画がとても良かったので今回リクエストさせていただきました。\n\n下記の様なシチュエーションのillumination STARSの3人の漫画をお願いいたします。\n話の流れが大まかに一致していれば問題ないので、ページ数に合わせて一部改変、簡略化、省略していただいても大丈夫です。\n\n※前提として、イルミネの3人は「3人で付き合い始めたばかりのポリアモリーな関係」という設定でお願いいたします。\nまだエッチはしておらず、ほんの数回キスした程度の湿度感です。\n\n\n①灯織が1人で事務所に向かう途中、真乃とめぐるの後ろ姿を見かける。\n2人は手を繋いで歩いていて、後ろに灯織がいる事には気付いていない。\n\n②灯織が前の2人に声をかけようとした矢先、突風が真乃とめぐるのスカートを捲り上げる。\n2人は慌ててスカートの前側を押さえるが、背後にいた灯織からは2人のパンツが丸見えに。\n\n③突然の出来事に灯織が思わず固まっていると、誰かに見られてないかと後ろを振り返った2人と目が合ってしまう。\n顔を赤くしながらぎこちなく挨拶を交わす3人。\n\n④真乃ははにかみながら(パンツを)見ちゃった？的な事を灯織に聞き、灯織は赤面しつつ謝る。\nめぐるが冗談でキスしてくれたら許してあげる的な事を言うと、それを真に受けた灯織がめぐるの唇にキスする。\n\n⑤驚いためぐるの表情を見て冗談だった事に気づいた灯織は謝るものの、横で見ていた真乃がビックリしつつも自分もしてほしいと照れながら言い出したので、灯織は真乃にもキスする。\n\n⑦その矢先、今度は灯織が風に煽られてスカートが舞い上がり、真乃とめぐるにパンツを見られてしまう。\n真乃とめぐるはドキドキしながら灯織にキスしようとにじり寄る。灯織はキスしてくれなくても許すから的な事を言いながら後ずさるものの、結局2人からキスしてもらう。\n\n\n※キスするのが灯織ばかりになってしまったので、どこかに真乃とめぐるがキスするシーンも入れてほしいです。\nどこに差し込むかはお任せします。\n\n※3人のパンツのデザインは3人の雰囲気に沿った感じでお願いします。\n\n\n\n作業量の多いリクエストかと思いますが、何卒ご検討頂けますと幸いです。 \nよろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukamisote/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/19abbbc1/uploads/origins/b7f2f1c8-41bf-4690-a1e7-fec01812510a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab18c504f96e01cc5884228070efb3ef", "srcset": "https://si.imgix.net/19abbbc1/uploads/origins/b7f2f1c8-41bf-4690-a1e7-fec01812510a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab18c504f96e01cc5884228070efb3ef, https://si.imgix.net/19abbbc1/uploads/origins/b7f2f1c8-41bf-4690-a1e7-fec01812510a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=344e8ca622a4289b83532e79a45b5db9 2x, https://si.imgix.net/19abbbc1/uploads/origins/b7f2f1c8-41bf-4690-a1e7-fec01812510a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f78a78bead5a6b4d10711e224e89aef2 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2638907, "client_id": 173648, "nc": 177}, {"path": "/@yukamisote/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2638907, "client_id": 439465, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47d37cdb/uploads/origins/095105ad-e0ef-453a-b12c-20423bb6edc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b1aa14cecf19cb013