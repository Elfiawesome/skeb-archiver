 "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amagasa098/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 509294, "client_id": 2540647, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d9596f9/uploads/origins/35290e8c-9d80-46b2-bac9-7e80feb93b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95c4f9d273dd12341faa5794ad6f3478", "srcset": "https://si.imgix.net/1d9596f9/uploads/origins/35290e8c-9d80-46b2-bac9-7e80feb93b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95c4f9d273dd12341faa5794ad6f3478, https://si.imgix.net/1d9596f9/uploads/origins/35290e8c-9d80-46b2-bac9-7e80feb93b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f99667eed2dad5bd3620f4db52e151c9 2x, https://si.imgix.net/1d9596f9/uploads/origins/35290e8c-9d80-46b2-bac9-7e80feb93b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7856ed18a08476cdbe22d8bc54f18dfd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d9596f9/uploads/origins/35290e8c-9d80-46b2-bac9-7e80feb93b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04642c98f9240de098ef2e3b2a6ebd14", "srcset": "https://si.imgix.net/1d9596f9/uploads/origins/35290e8c-9d80-46b2-bac9-7e80feb93b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04642c98f9240de098ef2e3b2a6ebd14, https://si.imgix.net/1d9596f9/uploads/origins/35290e8c-9d80-46b2-bac9-7e80feb93b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b618a8afd024d9fe762f0d3b45c0cd1d 2x, https://si.imgix.net/1d9596f9/uploads/origins/35290e8c-9d80-46b2-bac9-7e80feb93b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7878b8fbfa6bb4e38328a5cd4d871bc4 3x"}, "body": "前回はありがとうございました！\n今回はあなたのオリキャラの雫石ちゃんを描いていただきたいです。\nシチュエーションとしては、戦闘スーツ(https://x.com/amagasa098/status/1844887237206659214?t=xYnRAuxsHzq6aDQvX31NNg&s=19)を身に纏って戦うものの、メカ触手が手首足首に巻きついて手足を広げた状態で空中に拘束され、身動きが取れなくなる→電流を流し込まれてスーツのアーマー部分がパーンと破損、戦う力を失い完全敗北し、インナースーツ(無傷)だけの姿になってしまう\nという感じでお願いします。\n表情は目をつぶって悲鳴をあげる感じで、苦しむ表情を見せていただきたいです。\n細かい指定にはなりますが、アーマー部分は手足部分もさることながらパンツとブラ部分を特に破壊していただき、インナースーツは全くの無傷、ブラが弾けた衝撃で胸が揺れ、パンツが弾けて露になったインナースーツ越しに女性器が浮き出る感じでお願いしたいです。\nまた、可能であればなのですが、差分として、敗北直後という設定で破損アーマーなし、電流なしのインナースーツだけの姿で、心が折れかけて泣きそうな表情のものをお願いしたいです。\n差分に関しては都合が悪ければ描いていただかなくても大丈夫です。\n要求が滅茶苦茶多くて申し訳ありませんが、ご検討をお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amagasa098/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 509294, "client_id": 811237, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/571db847/uploads/origins/11f305e1-1c7b-4716-bc22-7b65d65d5e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3211dcecb431d1a0b8e207e659f3e791", "srcset": "https://si.imgix.net/571db847/uploads/origins/11f305e1-1c7b-4716-bc22-7b65d65d5e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3211dcecb431d1a0b8e207e659f3e791, https://si.imgix.net/571db847/uploads/origins/11f305e1-1c7b-4716-bc22-7b65d65d5e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=363f245dff5a13664733c82d54fc904e 2x, https://si.imgix.net/571db847/uploads/origins/11f305e1-1c7b-4716-bc22-7b65d65d5e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e48958e20e97543a4368580d7e5fa14d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/571db847/uploads/origins/11f305e1-1c7b-4716-bc22-7b65d65d5e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e757d591adbdd