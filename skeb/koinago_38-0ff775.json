髪です。\n\n【ポーズの構成】\nポーズは自由にお任せします！あなたのスタイルで、彼をハンサムでクールに描いてください。髪を少しセットした姿や、別の服を着せた姿を描いていただいても大歓迎です！服のスタイリングの仕方もとても魅力的です！伝統的なスタイルでもモダンなスタイルでも、どちらでも構いません！ \n\n【使用目的】\n  - DiscordサーバーやSNSへの投稿、およびDiscordやTwitchの配信での使用。作品にはお名前をクレジットとして記載して掲載させていただきます。(:\n\nありがとうございます。素敵な一日をお過ごしください！\n\nhttps://drive.google.com/drive/folders/1B9QBSnTpogJBkF1JW0WJzZlptp5OJD_t?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@koinago_38/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3696977, "client_id": 3866814, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45dfe01e/uploads/origins/71628209-403a-4fc1-8ece-96883b81418a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca289f30b78b518776c9be1b548ef56e", "srcset": "https://si.imgix.net/45dfe01e/uploads/origins/71628209-403a-4fc1-8ece-96883b81418a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca289f30b78b518776c9be1b548ef56e, https://si.imgix.net/45dfe01e/uploads/origins/71628209-403a-4fc1-8ece-96883b81418a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82ee732629d4de0a8563a62b3ba7b3c4 2x, https://si.imgix.net/45dfe01e/uploads/origins/71628209-403a-4fc1-8ece-96883b81418a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d1985316a9735c3e70e735528b1f792 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45dfe01e/uploads/origins/71628209-403a-4fc1-8ece-96883b81418a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8522ae80e946f181e308b8e24d29827b", "srcset": "https://si.imgix.net/45dfe01e/uploads/origins/71628209-403a-4fc1-8ece-96883b81418a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8522ae80e946f181e308b8e24d29827b, https://si.imgix.net/45dfe01