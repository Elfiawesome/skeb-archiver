ださい。\nまた、背景付きでお願いします。\nそしてポートレートで描いてください。\n\nありがとう！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 138817, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "壽@skeb募集中", "screen_name": "bukitikikaku", "avatar_url": "https://pbs.twimg.com/profile_images/1377123448569307146/iebZ7W4B.jpg", "header_url": "https://pbs.twimg.com/profile_banners/938843350160982016/1677470029/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 25, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 49}, {"id": 497613, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "蒼ウサギ♂", "screen_name": "AoUSA0328", "avatar_url": "https://pbs.twimg.com/profile_images/1582803535041015808/NNPFujB-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/752154761407795200/1666204745/1500x500", "appeal_receivable": false, "popular_creator_rank": 25, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 4, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "nc": 33}, {"id": 713168, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "小枝めめ", "screen_name": "koedamesan", "avatar_url": "https://pbs.twimg.com/profile_images/1591000560462811137/Ee06deJM.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 40, "skills": [{"genre": "art"}], "nc": 49}, {"id": 1526238, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "✦Roah", "screen_name": "roah_83", "ava