i.imgix.net/ba0af1e9/uploads/origins/73157ae8-2996-4f3c-a628-19488f177ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3bdc340e4cab4924292cd4fa883afc0 2x, https://si.imgix.net/ba0af1e9/uploads/origins/73157ae8-2996-4f3c-a628-19488f177ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b253898fed5458cd250762cbafe1b74d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba0af1e9/uploads/origins/73157ae8-2996-4f3c-a628-19488f177ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5121dd0c0b2d6abec048edaa8d965ec", "srcset": "https://si.imgix.net/ba0af1e9/uploads/origins/73157ae8-2996-4f3c-a628-19488f177ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5121dd0c0b2d6abec048edaa8d965ec, https://si.imgix.net/ba0af1e9/uploads/origins/73157ae8-2996-4f3c-a628-19488f177ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07be8c95b676b676d07a066f2d122a21 2x, https://si.imgix.net/ba0af1e9/uploads/origins/73157ae8-2996-4f3c-a628-19488f177ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=711d0fc1f46cf2f2855fe7b69b04bfe6 3x"}, "body": "お世話になります。\n1回目誰デザキャラの氷沢ほのかが、ゴミ箱に放尿するイラストをお願いしたいです。\n自作小説のワンシーンですが、細部の整合性は取れなくとも構わないです。\n\n◆概要\nおもらしをしてしまった彼女がお店の事務所でお片付けさせてもらい、替えの服を持ってきているのを待っている間にもう一度催してしまい、下着を脱ぎ、室内にあったゴミ箱にしてしまいます。\nゴミ箱の中身は1回目のお片付けでペーパーが山盛りになっていたので、ほのかのおしっこでレモンシロップのかかった、かき氷のようになります。\n\n◆服装\n服装は上は公式（？）のチュニック、下は既におもらしで濡らしていたので下着（みずいろ）オンリーです。\n2度目の限界ということがわかるように、脱いだ下着は濡れていると嬉しいです。\n\n◆舞台背景\n6畳程度のスーパーの事務室です。\nその場には妹だけがいますが、特に気にしなくても大丈夫です。\n\n◆その後の利用について\n小説の挿絵等の二次利用は致しません。\n\n\nお忙しいところ、細かい内容で申し訳ございません！\n何卒、よろしくお願いいたします！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mallowsheep/works/7", "private_thumbnail_image_urls": null, "private": false, "genre