で（赤黒の場合でも犬耳はありでお願いします）\n\n・案1\n尻尾型プラグをお尻に挿入した状態で、尻尾も抜き差しされながら後背位\n犬になりきりながら気持ちよくなっているイメージ\n\n・案2\nアナルセックスで、おしりでとても気持ちよくなっているイメージ\n\n構図などはお任せします\n上記のような内容で喘ぎ声、セリフがあると嬉しいです\n予算内で可能であれば絶頂・事後などの差分があると嬉しいです\n\nご検討をお願いします\n\nhttps://drive.google.com/drive/folders/1fhzXcECCRDrstZLwK__JSU2cEV_1NVpd", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hutonTatakiki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3320689, "client_id": 570593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca190484/uploads/origins/23df7ede-48df-4392-8d53-557c4620565e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f27f72d6ec74b178aec6e7733da1d72", "srcset": "https://si.imgix.net/ca190484/uploads/origins/23df7ede-48df-4392-8d53-557c4620565e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f27f72d6ec74b178aec6e7733da1d72, https://si.imgix.net/ca190484/uploads/origins/23df7ede-48df-4392-8d53-557c4620565e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77b883f45c509d214b095e2ce99d8a72 2x, https://si.imgix.net/ca190484/uploads/origins/23df7ede-48df-4392-8d53-557c4620565e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38b389a0391d6b7adb3f7c71b3522136 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca190484/uploads/origins/23df7ede-48df-4392-8d53-557c4620565e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57a3d50114a8602eed292570886d7513", "srcset": "https://si.imgix.net/ca190484/uploads/origins/23df7ede-48df-4392-8d53-557c4620565e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57a3d50114a8602eed292570886d7513, https://si.imgix.net/ca190484/uploads/origins/23df7ede-48df-4392-8d53-557c4620565e?bg=%23fff&auto=form