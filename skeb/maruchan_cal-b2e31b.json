00&h=200&s=d81080db6e55da032da5a38c18f7b353 2x, https://si.imgix.net/c6ebef72/uploads/origins/a390e280-b07c-465d-8ab6-7b3f28a04416?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac7418e874625d487822bd512cd85e0d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6ebef72/uploads/origins/a390e280-b07c-465d-8ab6-7b3f28a04416?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29ac927c9c6af78ebfbaa55767530591", "srcset": "https://si.imgix.net/c6ebef72/uploads/origins/a390e280-b07c-465d-8ab6-7b3f28a04416?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29ac927c9c6af78ebfbaa55767530591, https://si.imgix.net/c6ebef72/uploads/origins/a390e280-b07c-465d-8ab6-7b3f28a04416?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e2c66a394fc1b591ab5892c3ad6bd074 2x, https://si.imgix.net/c6ebef72/uploads/origins/a390e280-b07c-465d-8ab6-7b3f28a04416?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1e573142085d51597ee5be2ade8fc976 3x"}, "body": "マルちゃん、新年明けましておめでとう。\n今年もお願いがあります。熊虎とルーカスの再登場だ。\n熊虎は普通のバニースーツを着ています。片足には「ルーカスのムラムラバニー♡」と矢印が股間を指している。胸にも「♡Lucas♡」と書かれている。熊虎の胸の間にはリモコンがある（ワイヤレスバイブのコントロールのように見えるはず）。\nルーカスは少し恥ずかしそうに熊虎の隣に立っている。熊虎は笑顔を浮かべながら、ウィンクしているはずだ。\nもし可能なら、同じポーズで、ルーカスがコントローラーを手に持ち、熊虎が足を震わせて顔を赤らめている（ルーカスが熊虎の中でバイブレーターを作動させたことを暗示している）altも描いてもらえないだろうか。\n\nこのアイデアを気に入ってもらえるとうれしいです。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maruchan_cal/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 293365, "client_id": 2742893, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aefc0937/uploads/origins/e626bb91-59e7-4431-9d16-9b3f7a789e07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07784c399