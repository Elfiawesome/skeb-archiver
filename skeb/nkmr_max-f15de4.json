などから描きやすいようにしていただければ幸いです。\n・金額に見合わせたラフなイラストでも大丈夫です。\n・使用用途はSNS内でアイコンやヘッダーへの利用などを考えております。\n\nリクエスト内容は以上となります。お忙しい中恐れ入りますが、ご検討いただけますと幸いです。\nもし依頼内容が金額と見合わないならお気軽に再送要請してくださっても構いません。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Sk6Zp8eflX-KXjkXcfembPUa2u2dWRAZ?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nkmr_max/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/be623ac4/uploads/origins/c00ec520-2d63-4603-b708-b9b023227e97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b8f62a248fa5e3934091570b773a4ce", "srcset": "https://si.imgix.net/be623ac4/uploads/origins/c00ec520-2d63-4603-b708-b9b023227e97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b8f62a248fa5e3934091570b773a4ce, https://si.imgix.net/be623ac4/uploads/origins/c00ec520-2d63-4603-b708-b9b023227e97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c59080f845a352cc79d66d4447d8495 2x, https://si.imgix.net/be623ac4/uploads/origins/c00ec520-2d63-4603-b708-b9b023227e97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d66a213d9344f31944ac92020cb1346 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3147848, "nc": 160}, {"path": "/@nkmr_max/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3147848, "client_id": 2959888, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4dc99f37/uploads/origins/39135e9a-a849-4864-ac3b-cd668f089ab0?bg=