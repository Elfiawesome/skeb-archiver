（「ワシ」と「のじゃ」の喋方が好き）\n\nストーリーについて、\nこれは「正と反」の2つの宇宙が舞台となり、生存のために戦争が繰り広げられるストーリーの企画です。軍服を着た少女が宇宙のコアとして、世界を救える英雄たちを探し求める物語です。\n\n顔とポーズはお任せします～できれば資料リンク中のLịcℏtを参考して、宇宙ストーリーの雰囲気でお任せします。サイズは1：1でおおｋ。\n\n\nこの依頼は今後色々なイラストの参考資料になります、SNSの宣伝用意があります、\nどうぞご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/17yqD1DseADE017QwCG7ymAk760Zb5vOU?usp=share_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@16cha_izayoi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 845747, "client_id": 1727097, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cfb687a2/uploads/origins/b7d5f0ad-d007-4167-84ec-cd68dd033c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1a0d82951aea645582e5432a3d13b1c", "srcset": "https://si.imgix.net/cfb687a2/uploads/origins/b7d5f0ad-d007-4167-84ec-cd68dd033c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1a0d82951aea645582e5432a3d13b1c, https://si.imgix.net/cfb687a2/uploads/origins/b7d5f0ad-d007-4167-84ec-cd68dd033c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e18e773e8cef89118e0f48bcfbb9e4f3 2x, https://si.imgix.net/cfb687a2/uploads/origins/b7d5f0ad-d007-4167-84ec-cd68dd033c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7304b03be4e4582bf403cead3a789b9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cfb687a2/uploads/origins/b7d5f0ad-d007-4167-84ec-cd68dd033c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc4126d72fc0d5fb7b8f5390119505c0", "srcset": "https://si.imgix.net/cfb687a2/uploads/origins/b7d5f0ad-d007-4167-84ec-cd68dd033c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc4126d72fc0d5fb7b8f5390119505c0, https://si.imgix.net/cfb687a2/uploads/origi