.net/0c06e283/uploads/origins/89bc80b0-a725-482e-9fbb-169bb2bcc1dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29951ea829daf275e7371b19d515c612, https://si.imgix.net/0c06e283/uploads/origins/89bc80b0-a725-482e-9fbb-169bb2bcc1dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fffed9fb180a773b0e05f2c41568e89e 2x, https://si.imgix.net/0c06e283/uploads/origins/89bc80b0-a725-482e-9fbb-169bb2bcc1dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e72786cc85ad0dce2171f17d9db8a85 3x"}, "body": "はじめまして。ハンドメイド見習い作家Vtuber華崎びいずと申します。\nAka Tadaima🐟ྀི様のイラストを拝見し、ぜひ私のイラストを描いていただきたいと思いリクエストいたしました。\n\nyoutubeでハンドメイド、ゲーム、歌配信などを好きなことを好きなだけすることをモットーに活動しています。\n\nハンドメイド衣装、3面図\nhttps://twitter.com/hanasaki_biizu/status/1575454321289748482?s=46&t=xctcbpPklWZO-GZhs3Mx5Q\n\n\nアイドル衣装の立ち絵\nhttps://twitter.com/hanasaki_biizu/status/1593454319218544640?s=21&t=MyLl0ubdtbmPFSqoo3_4wA\n\n寝起きの私を描いていただけませんか？\nポーズや表情はAka Tadaima🐟ྀི様にお任せしますが、ベッドの上かお部屋にいる感じがよいです。また服装は少し薄着でもこもこのカーディガンを羽織っていて胸元はみえていると嬉しいです。セクシーかわいい感じが好みです。\n頭や髪、手足が見切れないようにしていただけますと助かります。\n可能でしたら背景、サイン、それぞれイラストの別データまたは透過データでいただけますと嬉しいです。\n使用用途はSNSやサムネイル、youtubeの動画で使用いたします。\n\nそれぞれのイラスト、背景を別で使用する場合がございます。\nご縁がありましたら嬉しいです。よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AkaTadaima/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1917744, "client_id": 2410654, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23c562c1/uploads/origins/2bba8e85-7ceb-49b3-a9e2-3839795a906e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d2b14daf21b4ba8ef375d5e9a61d293", "srcset": "https://si.imgix.net/23c562c1/uploads/origins/2bba8e85-7ceb-49b3-a9e2-3839795a906e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d2b14daf21b4ba8ef375d5e9a61d293, https://si.imgix.net/23c562c1/uploads/origins/2bba8e85-7ceb-49b3-a9e2-3839795a906e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad70b7331d5ef0b4de9377ec8fb1e018 2x, https://si.imgix.net/23c562c1/uploads/origins/2bba8e85-7ceb-49b3-a9e2-3839795a906e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ec915791cf0e735a5248c0c66f0b143 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23c562c1/uploads/origins/2bba8e85-7ceb-49b3-a9e2-3839795a906e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e44ce7480a79f82aee4ead271af7b1b", "srcset": "https://si.imgix.net/23c562c1/uploads/origins/2bba8e85-7ceb-49b3-a9e2-3839795a906e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e44ce7480a79f82aee4ead271af7b1b, https://si.imgix.net/23c562c1/uploads/origins/2bba8e85-7ceb-49b3-a9e2-3839795a906e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad511bfb8695afec5f733ee3d43e1fed 2x, https://si.imgix.net/23c562c1/uploads/origins/2bba8e85-7ceb-49b3-a9e2-3839795a906e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f81715590a0c16281e350324d5166894 3x"}, "body": "Aka Tadaimaさん、こんにちは。あなたのかわいい絵（https://skeb.jp/@AkaTadaima/works/2）を見て、私のキャラクター（https://imgur.com/a/8S4zyxx）を描くことをお願いしたいと思います。\n\n女の子の外見\n1.常に無表情で、のんきなキャラクター。\n2.首の周りに包帯を巻いている。\n3.黒いコートに「GRNZ」の文字がある。\n4.片腕の袖に「さかな」と書いてほしい。\n5.ショートパンツとシューズの例は参考までに\n6.胸のサイズは平らでもなく大きくもなく、普通の平均的なサイズ。\n\nポーズをとる。\n7.彼女は頭の上にボウルを持ち、その中にペットの魚を入れています。ボウルは彼女の頭の上で休んでいる。魚は帽子をかぶっており、ボウルをほぼ埋め尽くすほどの大きさです。\n\n\n背景なしのバージョンでSNSに使えるようにしたいです、よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AkaTadaima/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1917744, "client_id": 90105