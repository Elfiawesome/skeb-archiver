貸りるね！」\nみたいな緊急事態な状況で、いろいろ入っているかれぴの大事な鞄を携帯トイレ代わりにして、鞄の中に大量のおしっこをしてしまう女の子のイラストをお願いします。(おしっこは黄色濃いめで書いていただけると助かります)\n女の子は10代後半、黒髪でピンクのブラウスに黒色のスカート(いわゆる地雷系の服装)でお願いしたいです！\nぜひご検討いただければと思います。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@om_rimero/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c748d44d/uploads/origins/8a37b37d-ef22-41f3-ab3f-f9a5333b6bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b8d7bfdd452c614112bf27c01731851", "srcset": "https://si.imgix.net/c748d44d/uploads/origins/8a37b37d-ef22-41f3-ab3f-f9a5333b6bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b8d7bfdd452c614112bf27c01731851, https://si.imgix.net/c748d44d/uploads/origins/8a37b37d-ef22-41f3-ab3f-f9a5333b6bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45efca1e6ae8cd0a9d822fb64ce23a30 2x, https://si.imgix.net/c748d44d/uploads/origins/8a37b37d-ef22-41f3-ab3f-f9a5333b6bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=26b3c019d8e21a35c57f594ca6ef0d40 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1230710, "nc": 35}, {"path": "/@om_rimero/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1230710, "client_id": 80724, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55148c9c/uploads/origins/7471dcdb-bbc4-4bce-9db6-a2f4a876128d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0733384f8ccd7f8f119ff95cdbb7ddea", 