fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bcd690d88abe3a46d926fa7e215c3d76", "src_set": ""}, "body": "初めまして、現在VSingerとして準備中のねこねまおと申します。\n新着でお見かけし、とても素敵な絵柄に引かれぜひ描いていただきたいと思いリクエスト送らせていただきました。\n\n■依頼内容\n・サムネイル等で使用できるイラスト\n・ポーズはお任せしたいです。\n・サムネイル等で使用したいため、耳、尻尾、腕などが切れてないと大変助かります。\n\n\n■使用用途\nアイコン、各画像作成での使用、収益化予定のチャンネルでのサムネイルでの使用、ネットプリント等\n\n\n■キャラクター\n・化け猫\n・銀髪ウルフ\n・毛先は浅葱色\n詳しくはこちらをご覧いただけると幸いです：https://drive.google.com/drive/folders/13drouwkwZwMROs4Z42bjmGTO9q0U6Qiq?usp=drive_link\n（資料は右側でお願いいたします）\n\nご検討いただけると幸いです。\nよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kizu9chi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3617204, "client_id": 3529173, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51c87b3e/uploads/origins/158251f4-b90d-485d-99b0-501ceaeb8039?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad824d32ef842b90ee972e29ba39945c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51c87b3e/uploads/origins/158251f4-b90d-485d-99b0-501ceaeb8039?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b7b91656acc551136c2ed14ccbcb730", "src_set": ""}, "body": "᭻᭻Ɩ ı様\n\nはじめまして、現在ツイキャスを主に趣味として配信活動をしているぶい(散舞ぶい)と申します。\n\nポイピクの方に過去絵として投稿していたボアのデュース・スペード君のイラストに一目惚れしました！見やすい顔と、シンプルなのに感情の伝わる表情、なによりも透明感に圧倒され、数日経過した今もあの高鳴りは忘れられません。\n以前から長く大切に使用する一枚絵がほしいと考えていたこともあり、この度᭻᭻Ɩ ı様に一枚絵を描いてもらいたいと考えこちらに参りました。\n\n┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈\n【使用用途】\n_動画・配信サイトでの使用(サムネ、動画内)\n_アイコンやヘッダー、投稿等SNSでの使用\n\n【依頼内容の詳細】\n_ソファ型のベッドに寝そべっている私を上から見たようなイラスト\n_デュース君のような透き通る塗りを望んでおります。\n_可能であれば合わせて統一感のある色味で仕上げて頂けると嬉しいです。\n\n_他、資料URLから資料をダウンロードしご確認ください。以下が格納されています。\n\n・立ち絵+3Dモデル確認QRコード\n・3Dモデルを元に加筆したキャラ絵のイメージラフ\n・前景のイメージラフ\n・背景を描いたイメージラフ\n\nご査収のほどよろしくお願い致します。\n\n【背景について】\n_可能であればキャラクターのみで透過のものも頂けると嬉しいです。\n\n【画像サイズ】\n_1920×1080以上\n多少縦横の比率が変わっても問題ございません。\nイメージラフは3081×2001で作成してあります、顔をアップにしても綺麗に見えるサイズですとうれしいです。\n\n【ファイル形式】\n_png希望です。\n\n┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈\n以上となります。\nスケブからの依頼は初めてになりますので、もし不手際や失礼がありましたら申し訳ございません。金額については再送頂ければと思います。\nご検討よろしくおねがいします。\n\nhttps://drive.google.com/drive/folders/1gf1OPQesKxujMLo4pemkkdX2dleG5AuX", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kizu9chi/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/83808292/uploads/origins/53f98703-348c-40ee-a291-43546e334293?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=926f17a0d811dd5b3c84720207278110", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3617204, "client_id": 1291989, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 256, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "筆禍＠アリエスくん開発中", "screen_name": "hikka06", "avatar_url": "https://pbs.twimg.com/profile_images/1964220996204056578/VEYvKduT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/85097065/1737786245/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 176}, {"id": 1489240, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ななうえ", "screen_name": "tokeiiiiiii", "avatar_url": "https://pbs.twimg.com/profile_images/1318155455634403328/jdvwQlFP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/923877770383343616/1595099601/1500x500", "appeal_receivable": false, "