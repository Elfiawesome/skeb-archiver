へそが見える程度の丈です。\n・メイドのようなブリムとエプロンを付け、雲のようなもこもこのマントを羽織っています。\n自身でデザインしたキャラクターのイラストを以下に格納しておりますが、アレンジ頂いて構いません。\n\nhttps://drive.google.com/drive/folders/17v1Uo2yRQFcr6muLsuues8I06IWonPuJ?usp=drive_link\n\n【構図・ポーズ】\nお任せいたします。\n\n【用途】\n個人的なグッズの作成や、自身のイラスト制作・練習の参考資料として利用させて頂ければと思っております。\nまた、自身のSNSやブログ等の発信活動での使用の許可を頂けると幸いです（クレジット表記は必ず行います）。\n\nhttps://drive.google.com/drive/folders/17v1Uo2yRQFcr6muLsuues8I06IWonPuJ?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 101414, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Mr.Dirty_penguin", "screen_name": "neronero018", "avatar_url": "https://pbs.twimg.com/profile_images/1482246696423735296/EEqfgv4t.jpg", "header_url": "https://pbs.twimg.com/profile_banners/385902326/1601121251/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 264861, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ユヅキ", "screen_name": "yuduki_nh", "avatar_url": "https://pbs.twimg.com/profile_images/2044767924905480192/UOOdTDCU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3071225964/1716744378/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "banned": false, "nc": 33}, {"id": 1139836, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "しえ🌙", "screen_name": "011yoyo_", "avatar_url": "https://pbs.twimg.com/profile_images/2043715888822837249/saXmUF3X.jpg", "header_url": "https://p