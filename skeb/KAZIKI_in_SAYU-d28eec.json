9e1-61f644a7b471?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d22b2ca637e925b3e5edff01d96a4842, https://si.imgix.net/9d419db2/uploads/origins/f142b825-f6ff-409b-b9e1-61f644a7b471?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1521b777d89e845c07f259d048ceea23 2x, https://si.imgix.net/9d419db2/uploads/origins/f142b825-f6ff-409b-b9e1-61f644a7b471?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=88dd94571b17d54c48d13d20278d77a6 3x"}, "body": "⭐︎再送失礼いたします。\n\nいつもお世話になっております。 \n今回は「野狗子と薬師」を通過した探索者二人を是非描いていただきたいと思い依頼させていただきました。  \n\n＊PC情報＊\n 蓬（よもぎ）\n →懐かない野良犬…のようなひと。身長は2mを越えており、表情が動くことも少ないため怖い雰囲気がある。 　\n相方の前では多少懐いた野良犬くらいにはなる。\n笑うことはない（口端が縫われているため笑えない）が満足気な雰囲気などは感じ取れる。  \n\n貂幽（てんゆう）\n →テンションの高いお兄さん。善性の強い陽キャ。びびりな部分もあるが基本圧倒的光属性。 微笑むときと驚いた時だけ開眼するタイプの糸目。\n相方のことをわしゃわしゃ撫でたり肩に乗せてもらったり（歩くのが遅いと無理やり乗せられたり）する。   \n\n\nPC情報は以上です。\n構図、雰囲気はお任せいたします。\nお忙しいとは思いますが、お時間できましたらよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/r3a5mleonrrwzj7eb9d0f/AAerPXFjUg_M1sb2Y84gSrs?rlkey=2w0tqn8a0y10aqcf2rc6xnm7e&st=8pf0ic32&dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@den_tbn/works/183", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 29762, "client_id": 3640570, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dbfcda59/uploads/origins/27726348-4dfa-49e1-b9fa-17fe348a8cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7691df5abc4a75ad91b58c1043d7faa", "srcset": "https://si.imgix.net/dbfcda59/uploads/origins/27726348-4dfa-49e1-b9fa-17fe348a8cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7691df5abc4a75ad91b58c1043d7faa, https://si.imgix.net/dbfcda59/uploads/origins/27726348-4dfa-49e1-b9fa-17fe348a8cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed19bb7bba200024174f38e7d696d83e 2x, https://si.imgix.net/dbfcda59/uploads/origins/27726348-4dfa-49e1-b9fa-17fe348a8cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78f529340898e5dcaa5d867c5735d727 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dbfcda59/uploads/origins/27726348-4dfa-49e1-b9fa-17fe348a8cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=455a0254391311f08e10e8c0e06d2984", "srcset": "https://si.imgix.net/dbfcda59/uploads/origins/27726348-4dfa-49e1-b9fa-17fe348a8cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=455a0254391311f08e10e8c0e06d2984, https://si.imgix.net/dbfcda59/uploads/origins/27726348-4dfa-49e1-b9fa-17fe348a8cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8610f9b60c565e896f83ff4d34e28394 2x, https://si.imgix.net/dbfcda59/uploads/origins/27726348-4dfa-49e1-b9fa-17fe348a8cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e98bb18682054248853e622475c7ee9a 3x"}, "body": "お世話になっております。\nたぶんさんの絵をXでずっと拝見しており、以前別垢からご依頼したこともあるのですが、毎度大満足で大喜びしているため、今回も是非自陣を描いていただきたいと思い依頼させていただきました。\n\n\n今回描いていただきたいのはCoC「THESEUS（テセウス）」の自陣４PCです。\nシナリオ自体が特殊要素として秘密結社・異能力戦闘を掲示しているようなシナリオということもあるので、今回はその要素に似合うような「かっこいい」雰囲気の自陣を依頼出来たらと思っています。可能であれば映画ポスター風、雑誌写真のような雰囲気だと嬉しいですが、詳しい構図や色遣いはお任せいたします。\n通常時/戦闘時の指定もございません。\n資料にて色々置いておりますので、描きやすい雰囲気で自由に描いていただけると嬉しいです！\n\n\n以下各PC情報\n・・・・・・・・・・・・・・・・・・・\n\n●HO1  Ghislain Phénix（ジスラン・フェニックス）\n185cm/男\nフランス出身。リーダーとしての自覚を持って行動するが致命的にファッションセンスがない。\n上司と会う時にはもう少しちゃんとした服を着る。\n\n\n●HO2  明野 透吏（あけの とうり）\n182cm/男\nおっとりした最古参のお兄さん。得意なのは前衛。メンバーの皆のことを信頼している。\n\n\n●HO3 記虎 ともり（きとら ともり）\n172cm/男\nいわゆるヤンキーのような見た目をしているが本質はツンデレ。戦闘時はゴーグルをつける。\n\n●HO4 四分一 銹(しぶいち しゅう)\n158cm/男\n挨拶代わりに人のケツをはたく元気な距離バグ男。二人称はダーリン。\n\n\n●第一部隊の雰囲気\n楽しむときは楽しむしはしゃぐときははしゃぐ。基本HO3以外がボケ倒している。\nでも任務の時は真面目でかっこいい。\n仲間を信頼しあっている。\n\n\n・・・・・・・・・・・・・・・・・・・\n\n身長順\nHO1（185cm）＞HO2（182cm）＞HO3（172cm）＞HO4（158cm）\n\n・・・・・・・・・・・・・・・・・・・\n\n\n\n描いていただいたイラストはPL間での共有、また個人で楽しむ範囲での活用（個人で印刷、また非商用グッズの制作）ができたらと考えております。\n\n\n資料にネタバレは含んでいません。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Y0biEEhqVn8Glt2Gs65ATq3VG97yVGC3?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 583942, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "白畜生🤮強く生きる", "screen_name": "tamagoDX1414", "avatar_url": "https://pbs.twimg.com/profile_images/1485257104672067588/8J4BI7eY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1062268016258236422/1621819069/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 684693, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ヒルチョルソン", "screen_name": "httrpg", "avatar_url": "https://pbs.twimg.com/profile_images/1453281060020703235/AQH_La5r.jpg", "header_url": "https://pbs.twimg.com/profile_banners/970039808717340672/1660944882/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 2774893, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "しまっちゃうひと👊多忙👊", "screen_name": "gogogo", "avatar_url": "https://pbs.twimg.com/profile_images/2044072413810610176/LWEFY0CW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/940592147052425216/1604946691/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank