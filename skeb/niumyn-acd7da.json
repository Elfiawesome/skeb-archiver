バージョンもお願いしたいです。彼は「世界の管理者」として描かれていて、魔法の力で現実をコントロールする神のような能力を持っています。\n\nお時間とご配慮をありがとうございました。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@niumyn/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2799172, "client_id": 1986403, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75408ef1/uploads/origins/d419f531-0d8a-45ab-b4fd-f2e52bd309ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2148d5972f988e36f346f132b52b412", "srcset": "https://si.imgix.net/75408ef1/uploads/origins/d419f531-0d8a-45ab-b4fd-f2e52bd309ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2148d5972f988e36f346f132b52b412, https://si.imgix.net/75408ef1/uploads/origins/d419f531-0d8a-45ab-b4fd-f2e52bd309ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5dfd617aaa286ad6194f273919b2b397 2x, https://si.imgix.net/75408ef1/uploads/origins/d419f531-0d8a-45ab-b4fd-f2e52bd309ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=322a85316cfe80bc343fe348063f0368 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75408ef1/uploads/origins/d419f531-0d8a-45ab-b4fd-f2e52bd309ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb87f09e6d098e89e0a2940142e558f0", "srcset": "https://si.imgix.net/75408ef1/uploads/origins/d419f531-0d8a-45ab-b4fd-f2e52bd309ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb87f09e6d098e89e0a2940142e558f0, https://si.imgix.net/75408ef1/uploads/origins/d419f531-0d8a-45ab-b4fd-f2e52bd309ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=705efe37c6a0c6a0f206b741ebc1e077 2x, https://si.imgix.net/75408ef1/uploads/origins/d419f531-0d8a-45ab-b4fd-f2e52bd309ad?bg=%23fff&auto=