g=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd91fc352aec6f088454699f189a5abf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4fdb31cc/uploads/origins/0d58783f-023b-4929-942c-e2820423dbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85884e83dba03ba2792824ec233efdc0", "srcset": "https://si.imgix.net/4fdb31cc/uploads/origins/0d58783f-023b-4929-942c-e2820423dbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85884e83dba03ba2792824ec233efdc0, https://si.imgix.net/4fdb31cc/uploads/origins/0d58783f-023b-4929-942c-e2820423dbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=280eda28c7d52e36bb7745c706416b8d 2x, https://si.imgix.net/4fdb31cc/uploads/origins/0d58783f-023b-4929-942c-e2820423dbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f016c3434234936c3d9a65a8d448f2a9 3x"}, "body": "こんにちは。私はあなたの絵が本当に大好きです！とても印象的で美しいです。\n\nVera VeeというVtuberを描いてほしいです。ヴェラは優しくて努力家で、いつもベストを尽くしている女性です。彼女は夜更かしと早起きの癖があるので、それを反映したシーンを描いてほしいです。\n\nとても疲れて起きているヴェラを描いてください。ポーズとしては、資料のようにゆったりとしたシャツを着てベッドに座り、目をこすっているような感じにしてください。背景は、ぬいぐるみがたくさんある女の子らしい部屋と、空の水筒やコーヒーカップがたくさん置いてあるパソコンデスクでお願いします。ぬいぐるみとして、大小さまざまなイーブイを数体入れてください。アイヴィーは彼女のマスコット的存在で、とてもかわいいですよ。\n\nご検討のほど、よろしくお願いいたします\n\nポーズ参考：https://i.imgur.com/TUXa65k.jpg\nヴェラ参考：https://www.veravee.io/references\nアイヴィー参考： https://i.imgur.com/R4FjmFz.png", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kodukiako/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1969325, "client_id": 1976503, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/58b10eeb/uploads/origins/891d443c-b972-4c32-971b-c9b4025121e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=20