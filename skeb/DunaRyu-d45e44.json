auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=425d734b13d64ed02aae6bfdae1b97bb, https://si.imgix.net/01d8600a/uploads/origins/1e381644-43da-4f3d-b8ab-c53cf507b522?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8bf49b9151338882cb51c076e73be172 2x, https://si.imgix.net/01d8600a/uploads/origins/1e381644-43da-4f3d-b8ab-c53cf507b522?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8688b27ac3771b15d879d2ab607e3966 3x"}, "body": "以前ソーンやクビラのリクエストの際にはお世話になりました。\n久しぶりにＤ．Ｒｙｕさんの絵柄でくすぐられている推しが見たくなったのでリクエストさせていただきます。\n\nキャラはいつものごとくグラブルからでジョブ「ザ・グローリー」の衣装のジータちゃんをお願いします。\n多腕サキュバスとの戦いに敗れたジータちゃんがくすぐりでお仕置きされている、といったシチュエーションでお願いしたいのですが、イメージとしては以前D.Ryuさんがアップされた以下URLのマーキュリーのような感じで背後からＸ字に抑え込まれているところを腋の下、脇腹をくすぐられて大笑いさせられている様子をお願いします！くすぐり役のサキュバスのデザインについてはお任せします。\n\n以下細かいポイントになるのですが、\n１．ジータの表情は両目を閉じ、大きな口を開けて笑わされている状態\n２．サキュバスの腕はできれば8本　４本で両腕、両腿を抑え残った４本で両腋の下、脇腹をくすぐっている\n３．両腋の下の手はこちょこちょと指先で腋の下のくぼみを刺激している感じで両脇腹の手は衣装の上から指を立てるように揉みこんでいる感じでお願いします\n４．参考のイラスト同様、視点はキャラを正面寄りから見た視点でお願いします。\n５．衣装についてＸ字に拘束する都合上、邪魔であれば左肩の鎧は外していただいて大丈夫です。\n\n以前グレースケールのみで受け付けていたかと思いますが、カラーで再開されたのでしょうか？\n細かい注文かつ不躾に申し訳ないのですが、可能でしたらカラーでお願いしたいです・・・！\n以上よろしくお願いいたします。\n\nグローリージータ\nhttps://lh3.googleusercontent.com/0e7kX0gO-Kf_DDDssjeShCjot_RBe1iJE2tisEjtXQIGJWqs6HMfQb5M5PLbpJUDR2gTSXEG1SGUigcDSuqSgj3DA9Tzbm02HcHqtgfaHQZ2\n\nマーキュリー\nhttps://ci-en.dlsite.com/creator/1906/article/983643", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DunaRyu/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 62582, "client_id": 58207, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59d3c339/uploads/origins/3cc51711-f36c-47e7-8f45-365a2c705567?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b443d04c2acec4f7fc005b3b900d7231", "srcset": "https://si.imgix.net/59d3c339/uploads/origins/3cc5