09b1/uploads/origins/3e54559a-2040-4948-a2d9-5d04c6ee341b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24ebc579e6e8d860c17d966e8fbe044f, https://si.imgix.net/245b09b1/uploads/origins/3e54559a-2040-4948-a2d9-5d04c6ee341b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9839737d910719437a4928172357e9e2 2x, https://si.imgix.net/245b09b1/uploads/origins/3e54559a-2040-4948-a2d9-5d04c6ee341b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=698fa843d05d686f4ef0f27dd187efc0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/245b09b1/uploads/origins/3e54559a-2040-4948-a2d9-5d04c6ee341b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d055a26ba80edcc6e26bc42aaede14c", "srcset": "https://si.imgix.net/245b09b1/uploads/origins/3e54559a-2040-4948-a2d9-5d04c6ee341b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d055a26ba80edcc6e26bc42aaede14c, https://si.imgix.net/245b09b1/uploads/origins/3e54559a-2040-4948-a2d9-5d04c6ee341b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=acf6a952e5fa96ea715d2260f1592604 2x, https://si.imgix.net/245b09b1/uploads/origins/3e54559a-2040-4948-a2d9-5d04c6ee341b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=def7d8f0cd462dd69abcea82f0f89b67 3x"}, "body": "こんにちは、初めてのリクエスト失礼いたします。\nVtuberとして活動しております依符四六（いぷしろう）と申します。\n榎本さんの配信や動画をいつも楽しみに拝見させていただいております。\n\n依頼したい内容なのですが、「榎本蛍さんと依符四六（♀）がパジャマパーティをしている」イラストを描いていただきたくメッセージを送らせていただきました。\n依符四六の外見資料はURLからご確認いただけると幸いです。\n服装は寝間着・パジャマは自由なイメージで描いていただけたら嬉しいです。\n背景はクッションや枕・ぬいぐるみなど可愛くてふわふわしたものを描いていただきたいです。\nのんびりと楽しそうな雰囲気で2人が談笑している様子でお願いします。\n\nもし難しいようでしたら、２人が一緒に楽しそうに過ごしている内容で描いていただけたらと思います。\nぜひご検討の程よろしくお願いいたします。\n\n依符四六\n\nhttps://twitter.com/ipshirou", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptabl