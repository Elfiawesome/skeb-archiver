子をかぶっていません。）\nhttps://drive.google.com/drive/folders/1H-OWJiFL5yV-TaTWOUgqDJGB8euIqFVY\n\n目の形は、こちらの画像に似ています：https://skeb.jp/@DHA_56/works/6\n\nお好きなように描いてください！ポーズは自由にお任せします。\n\n必要であれば、適正な金額でリクエストしてください。\nご検討いただきありがとうございます。♥\n\nhttps://drive.google.com/drive/folders/1H-OWJiFL5yV-TaTWOUgqDJGB8euIqFVY", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DHA_56/works/21", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d3a6bfc9/uploads/origins/eb968f50-6a35-4e1c-815a-e415e226b739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ecececbc7897a092e5e04516f168676f", "srcset": "https://si.imgix.net/d3a6bfc9/uploads/origins/eb968f50-6a35-4e1c-815a-e415e226b739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ecececbc7897a092e5e04516f168676f, https://si.imgix.net/d3a6bfc9/uploads/origins/eb968f50-6a35-4e1c-815a-e415e226b739?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b68bd1ee4c29b90e81bdc8c55228cf73 2x, https://si.imgix.net/d3a6bfc9/uploads/origins/eb968f50-6a35-4e1c-815a-e415e226b739?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b8e32e7932cf203def626535b813ca2 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2811733, "nc": 144}, {"path": "/@DHA_56/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2811733, "client_id": 2005344, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/024236a5/uploads/origins/4572bd77-3a3f-47b7-9623-cec0d