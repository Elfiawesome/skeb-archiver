いただきたいキャラの説明です↓\n二人とも裏社会の同じ組織のメンバーです。\n帽子の子の方は組織では古株で執着心と独占欲の強い飄々としたサディストです。一つ目の子をどんな手を使っても手中におさめたいと思っています。\n一つ目の子の方は組織の中では新入りでお面を付けており荒っぽい言葉遣いですが育ちが恵まれていたおかげで良識がありマトモな女の子です。\n\n使用用途:個人鑑賞、SNSアイコン使用\n\nカプ絵を2枚お願いしたいです！\n1枚目は通常のもの、2枚目は暗めのアダルト、性的なものをお願いしたいです！\n構図やポーズはお任せしたいです！\ngutsさんの考えた衣装なども大丈夫です！\n\nここまで読んでいただきありがとうございます！\nご検討宜しくお願いします！\n\nhttps://drive.google.com/drive/folders/13zT4ctw7hwVJTUOCkTamgv6Xls9nlRe0", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DHA_56/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2811733, "client_id": 4004596, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/50e0c24e/uploads/origins/6f851412-71bf-4f6f-99c9-54f618e6b323?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=905f0af6031f48f54f471be771ce52dd", "srcset": "https://si.imgix.net/50e0c24e/uploads/origins/6f851412-71bf-4f6f-99c9-54f618e6b323?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=905f0af6031f48f54f471be771ce52dd, https://si.imgix.net/50e0c24e/uploads/origins/6f851412-71bf-4f6f-99c9-54f618e6b323?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3fc85671a6fbf5b0d6897fdcca37aa2 2x, https://si.imgix.net/50e0c24e/uploads/origins/6f851412-71bf-4f6f-99c9-54f618e6b323?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84da07518ce44168532f0a1146da82c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/50e0c24e/uploads/origins/6f851412-71bf-4f6f-99c9-54f618e6b323?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0868f8dfe4040722d7887fc228fccb3f", "srcset": "https://si.imgix.net/50e0c24e/uploads/origins/6f851412-71bf-4f6f-99c9-54f618e6b323?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0868f8dfe4040722d7