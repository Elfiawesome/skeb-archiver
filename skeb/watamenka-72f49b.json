utiful legs\nIf you don't wear a hairpin, please wear a \"dangly beetle\" design somewhere in your coordination.\n\nIf you don't want to wear a hairpin, please put a \"Dango Mushi\" design somewhere on your coordination. Facial expressions, poses, and other details are basically up to you!\nI'd be happy if you include the whole figure including the legs.\n\nhttps://twitter.com/superganglion/status/1221116225444438017?s=20", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@watamenka/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1022148, "client_id": 903, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e776b176/uploads/origins/d66cb07d-f288-4849-8418-049e8b013db7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f07031549f4c925a8d89bb3c4f80a7d", "srcset": "https://si.imgix.net/e776b176/uploads/origins/d66cb07d-f288-4849-8418-049e8b013db7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f07031549f4c925a8d89bb3c4f80a7d, https://si.imgix.net/e776b176/uploads/origins/d66cb07d-f288-4849-8418-049e8b013db7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aaf8aea0945a9ad51a1490b5228b4e96 2x, https://si.imgix.net/e776b176/uploads/origins/d66cb07d-f288-4849-8418-049e8b013db7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7567fa8795a83b9cd20aec48e75eb3c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e776b176/uploads/origins/d66cb07d-f288-4849-8418-049e8b013db7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cec2ddf383b8b6cb6f6964f7a7cd53bf", "srcset": "https://si.imgix.net/e776b176/uploads/origins/d66cb07d-f288-4849-8418-049e8b013db7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cec2ddf