rks": [{"path": "/@unoyado/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2451741, "client_id": 2929739, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a917a35/uploads/origins/3ff555dd-da18-4775-ba65-58fa4711ebb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec5b8fbf07c7919bf87b8f7e6e935c45", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a917a35/uploads/origins/3ff555dd-da18-4775-ba65-58fa4711ebb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28182caa63f68e2bd71fa39fe5cb0ded", "src_set": ""}, "body": "こんにちは！画風がとても気に入りました。もしよろしければ、私のオリジナルキャラクターを描いていただけませんか？キャラクターの特徴は以下の通りです。\n\nキャラクターの特徴\n\n* 薄い緑色の髪（毛先はピンク）\n* 赤い瞳\n* フード付きのグレーのレインコート\n* 花柄の白いスカート\n* 梨の花のヘアピン\n* 黒いストッキング、茶色のブーツ\n* 白い傘などの小物\n\n本が好きな、優しくて神秘的な少女です。背景はお任せしますが、白いシラカバなどが入っていても素敵だと思います。\n\nその他の詳細はURLをご参照ください。どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Rn1txpbnBZ6ZlJpxv6mZ3JC8dd8zFG7L", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unoyado/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2451741, "client_id": 3456561, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f53b09a/uploads/origins/2a555b16-c12e-420c-91c1-f54971125b20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cffcdcece6168cf90b4fb0308de23f3d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f53b09a/uploads/origins/2a555b16-c12e-420c-91c1-f54971125b20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3cbff6cf9c2707afaec7a4a59a14595", "src_set": ""}, "body": "卯の宿様\n\nVtuber準備中の篠崎104と申します。\n以前、ムービーのリクエストをした者です。\nとってもお気に入りです。\n\n今回はイラストをお願いしたく、\nリクエストをお送りさせていただきます。\n\n詳細は以下でお願いします\n\n──────────\n\n◆使用用途\n・収益化済みのTikTok、Youtubeのサムネイル、配信、動画内にて使用。\n・ヘッダーやアイコンなどSNSでの使用\n・サブスク特典としてリスナーさんに配布用のヘッダー、ネットプリント、壁紙などに使用\n・サイズ的に可能であればグッズとして販売(ポストカードやステッカーなど)の商用利用を希望\n\n◆依頼内容\n篠崎104イラスト\nhttps://drive.google.com/drive/folders/1HHkZ4C6lZqS6-GXnOId7obpdHk43j9ce\n\n▼こちらのイラストのように縦でも横でも使える感じだと嬉しいです\nhttps://skeb.jp/@unoyado/works/7\n\n\n◆構図・服装・髪型　\nすべてお任せで描いていただけるとありがたいです。\n\n◆その他\n背景をいただける場合、\nキャラのみのデータをいただけると嬉しいです\n\n──────────\n\nお忙しいところ恐れ入りますが、\nご縁がありましたらよろしくお願いします\n\nhttps://drive.google.com/drive/folders/1HHkZ4C6lZqS6-GXnOId7obpdHk43j9ce", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unoyado/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/742142a0/uploads/origins/d86a2679-1839-4c5c-8105-69c5bcc481ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c0f7c8864b70e06047a8ca70e2c19c6", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2451741, "client_id": 1786508, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@unoyado/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2451741, "client_id": 2850812, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f448c3f/uploads/origins/f3a932ba-20c6-4d0c-aef1-bf3c9ce1839f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab5bd3e072546106695a711e1f505d52", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f448c3f/uploads/origins/f3a932ba-20c6-4d0c-aef1-bf