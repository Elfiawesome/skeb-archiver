 "https://si.imgix.net/b3c349ae/uploads/origins/a5364dd3-a51e-4074-b31f-5003a59e002a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19750034a63654550026bc7b76649a6d", "src_set": ""}, "body": "はじめまして！\nいつも作品見させて頂いてます。\n\nチアネイチャと赤衣装テイオーの2人のコンビのイラストを描いて頂けないでしょうか?\n\nご多忙かと思いますが、ご検討頂ければ幸いです。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyamaV2/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2094773, "client_id": 8801, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a6e6f12/uploads/origins/066f6e28-abeb-41a8-9ede-e421a109f244?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99ba4ef75f55d290017f6a47144e0697", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a6e6f12/uploads/origins/066f6e28-abeb-41a8-9ede-e421a109f244?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=795bc8a8186ec16a95383da46ddc5d32", "src_set": ""}, "body": "お疲れ様です！skeb再開されたと聴きましたので。\nウマ娘のトウカイテイオーお願いします。\n服装は白の勝負服の方で。シチュエーションは女の子座り、ぺたん座りとも言うのでしょうか。\nちょっと上目遣いで「にっしっし♪」と笑ってる感じで。ちょっと太もも成分多めで、可能ならば目が見開いてるのと「^^」の差分があると嬉しいです(/ω＼)\n\nよろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyamaV2/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2094773, "client_id": 1271453, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9af409f/uploads/origins/9a213edc-b594-4790-8447-2545c6ac723e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01f35d38ede4a9df747946accdd8e5bd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9af409f/uploads/origins/9a213edc