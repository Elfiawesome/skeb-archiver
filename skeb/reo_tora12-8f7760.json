1-9a55-4787-84f1-f9f8f19f6db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdf45aa8492030c28294b54a4d646cfd, https://si.imgix.net/f2245f9b/uploads/origins/c83e5321-9a55-4787-84f1-f9f8f19f6db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7f7f2c7194dc34ad2c6015d83444486 2x, https://si.imgix.net/f2245f9b/uploads/origins/c83e5321-9a55-4787-84f1-f9f8f19f6db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f56c86525e59dc8cbc7d65ddf91b8557 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2245f9b/uploads/origins/c83e5321-9a55-4787-84f1-f9f8f19f6db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5997607d1c6c25457ba8b8c0e8a5e34f", "srcset": "https://si.imgix.net/f2245f9b/uploads/origins/c83e5321-9a55-4787-84f1-f9f8f19f6db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5997607d1c6c25457ba8b8c0e8a5e34f, https://si.imgix.net/f2245f9b/uploads/origins/c83e5321-9a55-4787-84f1-f9f8f19f6db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c4c121e454778040d9453f473553f1f 2x, https://si.imgix.net/f2245f9b/uploads/origins/c83e5321-9a55-4787-84f1-f9f8f19f6db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2bec330f15f28ae95dd976c69e1cbd4b 3x"}, "body": "れおたろーさん\n\nいつもお世話になっています。カワウソです。\n以前から、れおたろーさんの絵で自探索者を見てみたいと思っておりました。また、今回は動物もイラストに含むので、「これは…！」っと思い、この機会にご依頼をしようと思いいたりました。\n\n早速の依頼内容についてです。\n\n\n【　依頼内容について　】\nトドノツマリ海峡様作 〈終電逃したわ、一晩泊めてよ〉出身である自探索者とよその探索者のカラーイラストをお願いしたいです。\n\n\n【　リクエスト　】\n青空の元 ( 想定では夏 ) にいる探索者二人のイラストをお願いしたいです。\nアオリ構図、フカン構図のこだわりは有りませんので、お任せいたしますが、キャラクター + 羽ばたいている鳩が一羽いるとうれしいです！ただ、もし負担になるようでしたら省いていただいても全然かまいません！\n\n\n【　資料　】\nhttps://drive.google.com/drive/folders/1Bk7DBSZWw7twDpuNohnMNk24y1WgqW67?usp=sharing\n\n\n【　キャラクターについて　】\n●輝熊 光 ( てらぐま・ひかる )　\nバンダナを巻いているほう、24歳　169cm\n夏でもパーカーは着ています。\n\n●新舘 翼 ( にいだて・つばさ )\n赤茶髪の方、24歳　177cm\n\n2人の関係は親密で、仲も良好です。\n\n\n【　使用用途について　】\n使用用途は個人での利用、相方への共有。\nまた、携帯の待ち受けにしたいと思っております。\n\n\nお忙しいところだとは思いますので無理せず、厳しければスケブの規約通りスルーしていただければと思います！ご検討の程、よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reo_tora12/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2002400, "client_id": 2038866, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf1563b3/uploads/origins/e9f22e96-16bc-4eb3-a48d-120e96edbf52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f855610af18d6c5987a4eca1ae3ad987", "srcset": "https://si.imgix.net/bf1563b3/uploads/origins/e9f22e96-16bc-4eb3-a48d-120e96edbf52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f855610af18d6c5987a4eca1ae3ad987, https://si.imgix.net/bf1563b3/uploads/origins/e9f22e96-16bc-4eb3-a48d-120e96edbf52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3ac33a92aef028f7aed32dceb68e983 2x, https://si.imgix.net/bf1563b3/uploads/origins/e9f22e96-16bc-4eb3-a48d-120e96edbf52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=536dcca3f663e3fea41c223b5d772917 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf1563b3/uploads/origins/e9f22e96-16bc-4eb3-a48d-120e96edbf52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3669bb253bfae9584d02055070951d1", "srcset": "https://si.imgix.net/bf1563b3/uploads/origins/e9f22e96-16bc-4eb3-a48d-120e96edbf52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3669bb253bfae9584d02055070951d1, https://si.imgix.net/bf1563b3/uploads/origins/e9f22e96-16bc-4eb3-a48d-120e96edbf52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32