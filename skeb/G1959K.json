もらえればと思います。\n構図やポーズはもちろん、ディテールのアレンジや省略などもご随意にお任せいたします。\n\n用途：個人鑑賞、個人利用の為のグッズに利用する、skebで描いてもらったと知り合いに見せる\n\n以上、もしよろしければ、ご検討いただけますと幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@G1959K/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3776630, "client_id": 3780283, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/36f27427/uploads/origins/cadee771-e14c-4338-b3cf-2aaf51650375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f9878055746b23deb083354fd36c0df", "srcset": "https://si.imgix.net/36f27427/uploads/origins/cadee771-e14c-4338-b3cf-2aaf51650375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f9878055746b23deb083354fd36c0df, https://si.imgix.net/36f27427/uploads/origins/cadee771-e14c-4338-b3cf-2aaf51650375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28ebf40dcf6a6c644a52f511b9d6bd2f 2x, https://si.imgix.net/36f27427/uploads/origins/cadee771-e14c-4338-b3cf-2aaf51650375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13b2645ad8f64fb3b16f916f78201886 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36f27427/uploads/origins/cadee771-e14c-4338-b3cf-2aaf51650375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d73c77fdb076106ae6b4559c2f34a3c", "srcset": "https://si.imgix.net/36f27427/uploads/origins/cadee771-e14c-4338-b3cf-2aaf51650375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d73c77fdb076106ae6b4559c2f34a3c, https://si.imgix.net/36f27427/uploads/origins/cadee771-e14c-4338-b3cf-2aaf51650375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c0a26704ae6cfdd6c24cdaaaf44c1c8 2x, https://si.imgix.net/36f27427/uploads/origins/cadee771-e1