.imgix.net/43f8fd4b/uploads/origins/8ebcd85d-5cc5-4a34-92fa-dfe9c5f49c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14d52a6adff49039a2c7a10c05793c22, https://si.imgix.net/43f8fd4b/uploads/origins/8ebcd85d-5cc5-4a34-92fa-dfe9c5f49c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a7b6e8729c7708ad9fee3c254a1d61c4 2x, https://si.imgix.net/43f8fd4b/uploads/origins/8ebcd85d-5cc5-4a34-92fa-dfe9c5f49c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a562aeeb7ac9c95c614b2d49d906b64 3x"}, "body": "こんにちは！ かわいい画風の投稿を拝見したので、依頼をさせていただきたいです。ハロウィンが間近に迫っているので、私の白髪のオリジナルキャラクターと「時崎くるみ」が互いにコスチュームを交換しているフルカラーのイラストを描いていただけないでしょうか。 \n\nホワイトは左側にいて、膝を後ろに上げ、くるみの手を握っているポーズにしてください。口を開けて陽気に笑っています。また、髪は真っ白です。\n\nくるみは右側にいて、陽気に笑いながらホワイトの手を握り、もう一方の手で髪を整えています。 \n\nGoogleドライブにすべての参考画像を添付しました。\n\nもし著作権のあるキャラクターの使用が許可されていない場合は、リクエストを再送信してください。調整いたします。\n\nご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1OFrLHewp-2cnjDH2TVsyyIUQ4_-isg2r", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@azm_220/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4091818, "client_id": 3243570, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/854a168a/uploads/origins/ccc596db-e33f-4d02-b6ac-480f979d2f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8819ebf380030ba6bb9487a70edfc4d", "srcset": "https://si.imgix.net/854a168a/uploads/origins/ccc596db-e33f-4d02-b6ac-480f979d2f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8819ebf380030ba6bb9487a70edfc4d, https://si.imgix.net/854a168a/uploads/origins/ccc596db-e33f-4d02-b6ac-480f979d2f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6613311016b0a08a181a7a85bfd5d9cd 2x, https://si.imgix.net/854a168a/uploads/origins/ccc596db-e33f-4d02-b6ac-480f979d2f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=055fe15541a6144d8ea8f911e56acb9b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/854a168a/uploads/origins/ccc596db-e33f-4d02-b6ac-480f979d2f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=877d722d85a3347cffd54fd906bfb7dd", "srcset": "https://si.imgix.net/854a168a/uploads/origins/ccc596db-e33f-4d02-b6ac-480f979d2f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=877d722d85a3347cffd54fd906bfb7dd, https://si.imgix.net/854a168a/uploads/origins/ccc596db-e33f-4d02-b6ac-480f979d2f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c464045d769d4e218832a93353fdb12 2x, https://si.imgix.net/854a168a/uploads/origins/ccc596db-e33f-4d02-b6ac-480f979d2f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=97f089b9eb3db5a9977d38a69f9aa22b 3x"}, "body": "あずま様、初めまして！花田と申します。\nツイートでイラストを拝見し、もちもちとしたほっぺたに惹かれリクエストさせていただきました。\n\n描いていただきたいのは私の創作キャラの縹(はなだ)になります。\n\n【キャラクター設定】\n・16歳の少女\n・身長146cm\n・一重のツリ目でタレ眉\n・イメージカラー:縹色(日本の伝統色です)\n・黒髪をベースとして、左側に縹色のメッシュが入っています。髪型はハーフアップで、シュシュで髪を括っています。\n・喜怒哀楽が分かりやすく顔に出ます。表情豊かです。\n・一人称は「あたし」\n・元気で人懐っこく、誰とでもお友達になれます\n\n衣装については、縹の普段着が和装なのですが、そちらのアレンジや普段着など、縹に似合いそうなものをお任せしたいです！\n上記に限らず、あずま様が縹に似合うと思う衣装を好きなように描いてくださったら嬉しいです。\n\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1Ia9rlkxoFMOmDoI104f9fYiORLftsICc", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@azm_220/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4091818, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5f1953b/uploads/origins/5de08b3e-37d0-49b1-af4f-e99a8ae8793c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34cc54e3101aeada28767462706641b8", "srcset": "https://si.imgix.net/d5f1953b/uploads/origins/5de08b3e-37d0-49b1-af4f-e99a8ae8793c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34cc54e3101aeada28767462706641b8, https://si.imgix.net/d5f1953b/uploads/origins/5de08b3e-37d0-49b1-af4f-e99a8ae8793c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7f436d6f1ec1dfa25595e061cf1ea23 2x, https://si.imgix.net/d5f1953b/uploads/origins/5de08b3e-37d0-49b1-af4f-e99a8ae8793c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d407ccd70673050c9d23995963ed68c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5f1953b/uploads/origins/5de08b3e-37d0-49b1-af4f-e99a8ae8793c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2af07941e64fc3c665eca4f29311f46", "srcset": "https://si.imgix.net/d5f1953b/uploads/origins/5de08b3e-37d0-49b1-af4f-e99a8ae8793c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2af07941e64fc3c665eca4f29311f46, https://si.imgix.net/d5f1953b/uploads/origins/5de08b3e-37d0-49b1-af4f-e99a8ae8793c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=85d8301c52aaccd57a226e805b7e916d 2x, https://si.imgix.net/d5f1953b/uploads/origins/5de08b3e-37d0-49b1-af4f-e99a8ae8793c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=97cdaa8a43dd1dd50e0852da9c7abb5b 3x"}, "body": "はじめまして。これからライバーとして活動予定の、彼岸蘭々と申します。今回はあずまさまのポストを拝見し、ぜひリクエストさせていただきたいなと思いまして…！\n\n書いていただきたいもの\n・彼岸蘭々\n\n\n利用用途\n・SNSのアイコン、ヘッダー\n・おはようVTuberなど、ポストでの使用\n\n内容などはすべておまかせいたします。\n何卒よろしくお願いいたします！\n\nhttps://drive.google.com/file/d/1xZ9URyzheUflJXGIvGfIpFIa17IB5YXM/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@azm_220/works/1", "private_thumbnail_image_u