」が互いにコスチュームを交換しているフルカラーのイラストを描いていただけないでしょうか。 \n\nホワイトは左側にいて、膝を後ろに上げ、くるみの手を握っているポーズにしてください。口を開けて陽気に笑っています。また、髪は真っ白です。\n\nくるみは右側にいて、陽気に笑いながらホワイトの手を握り、もう一方の手で髪を整えています。 \n\nGoogleドライブにすべての参考画像を添付しました。\n\nもし著作権のあるキャラクターの使用が許可されていない場合は、リクエストを再送信してください。調整いたします。\n\nご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1OFrLHewp-2cnjDH2TVsyyIUQ4_-isg2r", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@azm_220/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4091818, "client_id": 3243570, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/854a168a/uploads/origins/ccc596db-e33f-4d02-b6ac-480f979d2f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8819ebf380030ba6bb9487a70edfc4d", "srcset": "https://si.imgix.net/854a168a/uploads/origins/ccc596db-e33f-4d02-b6ac-480f979d2f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8819ebf380030ba6bb9487a70edfc4d, https://si.imgix.net/854a168a/uploads/origins/ccc596db-e33f-4d02-b6ac-480f979d2f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6613311016b0a08a181a7a85bfd5d9cd 2x, https://si.imgix.net/854a168a/uploads/origins/ccc596db-e33f-4d02-b6ac-480f979d2f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=055fe15541a6144d8ea8f911e56acb9b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/854a168a/uploads/origins/ccc596db-e33f-4d02-b6ac-480f979d2f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=877d722d85a3347cffd54fd906bfb7dd", "srcset": "https://si.imgix.net/854a168a/uploads/origins/ccc596db-e33f-4d02-b6ac-480f979d2f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=877d722d85a3347cffd54fd906bfb7dd, https://si.imgix.net/854a168a/uploads/origins/