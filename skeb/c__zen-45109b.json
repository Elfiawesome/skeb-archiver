=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=405458ac4957c5392f3bbfbd48bd7c6c", "srcset": "https://si.imgix.net/61f39d74/uploads/origins/01f2cb07-f10f-48ca-96b1-0a507cd89377?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=405458ac4957c5392f3bbfbd48bd7c6c, https://si.imgix.net/61f39d74/uploads/origins/01f2cb07-f10f-48ca-96b1-0a507cd89377?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33b226c1dabb82966bbffcceb121b0be 2x, https://si.imgix.net/61f39d74/uploads/origins/01f2cb07-f10f-48ca-96b1-0a507cd89377?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28f90ce556a78fb7ab62dd492b8b0ba8 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2922266, "client_id": 3196940, "nc": 1}, {"path": "/@c__zen/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b587ab2e/uploads/origins/a31395c3-a14b-45e9-845d-fc45db04ed45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=116ab5201ca533e255a038af8aab08ae", "srcset": "https://si.imgix.net/b587ab2e/uploads/origins/a31395c3-a14b-45e9-845d-fc45db04ed45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=116ab5201ca533e255a038af8aab08ae, https://si.imgix.net/b587ab2e/uploads/origins/a31395c3-a14b-45e9-845d-fc45db04ed45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&tx