o", "creator_acceptable_same_genre": true}, {"path": "/@k0s1ank0/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": false, "creator_id": 2912307, "client_id": 106271, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1801069374377472000%2FneDcYQh6.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dcc8c9eb203f99a97dd5d63136f5b3e", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1801069374377472000%2FneDcYQh6.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dcc8c9eb203f99a97dd5d63136f5b3e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1801069374377472000%2FneDcYQh6.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5dd2df0cf93ff8297ff0dae5bef7a83 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1801069374377472000%2FneDcYQh6.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9591d4c86349892af7278e34cd45fc2 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/381e4c49-963c-47eb-8527-610ca1e72a28?response-content-disposition=inline&Expires=1783023361&Signature=AomSZbGVxChm8jO9sKnNHkC-9qFF76n40Zroof02ij3qxWrMEQsp9LpBRH-LiSGE2cp1gmcRfeNOFkgJaawMP-MSD5rvCd0XqAKvQbz63kgEr6CLHmCVPFmueBjqgasU335S5pYeyTrHN~0MEBJD4sH-euLE0YjuGQq1T7CTdGrSbqJeN9C4a2Ylo6knyqa-63Qtzk-P3sZ1oxh78qpzmFdczp0FNtLAdbvKoFxMTMqM44Zrl3SAbLnIca4Qcb3jvAm7aGhi8C7fb1py05SH68yYJ7FYFjW6NeaQFjzmd2xytdmzXtDb9V2bgl8iWrKGRa1XHuXqcrvvy4w67Zo5hA__&Key-Pair-Id=K1GS3H53SEO647", "duration": 218, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1801069374377472000%2FneDcYQh6.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=704133679a0643eb