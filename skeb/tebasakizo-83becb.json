aa8-8843-4a68-80e2-92c0bbba13cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be9b50749b49b2e925d1025670cb54dd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a3a39b6/uploads/origins/49888aa8-8843-4a68-80e2-92c0bbba13cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=253a84bffd0375e5df82974df7db343f", "srcset": "https://si.imgix.net/6a3a39b6/uploads/origins/49888aa8-8843-4a68-80e2-92c0bbba13cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=253a84bffd0375e5df82974df7db343f, https://si.imgix.net/6a3a39b6/uploads/origins/49888aa8-8843-4a68-80e2-92c0bbba13cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=16421e3661838f3c844b15ddc1016833 2x, https://si.imgix.net/6a3a39b6/uploads/origins/49888aa8-8843-4a68-80e2-92c0bbba13cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=806092f1691f1b3fe861c6e817462194 3x"}, "body": "初めまして、こんにちは。\n昔からsakizo様の描かれる美しいイラスト、特にスイーツモチーフやドレスに憧れており、リクエストさせていただきました。\n\nTRPGで創作したオリジナルキャラクターの女の子を描いていただきたいです。\nモデル業をしている女の子なので、「春～初夏の可愛く甘い新作香水」のイメージモデルに起用されたという内容で、お洋服など着せていただきたいです。\n\n性別/年齢： 20歳の女性\n外見の特徴： 髪色－赤茶　瞳の色－紫色\n性格・雰囲気： 明るく社交性がある\n趣味：化粧品や香水、服\n\n【構図・シチュエーション】\n構図やポーズ、背景などはすべておまかせでお願いします。\nsakizo様の世界観で描かれる彼女を見てみたいです。\n\n【用途】\nデジタル環境での個人鑑賞。また、完全に個人で鑑賞するためにポストカードなど印刷をさせてただきたいです。\n\nご多忙のところ恐縮ですが、ご無理のない範囲でご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1n3keo1hpJciB4dhf5nOus4CfNOdHwGV3/view?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tebasakizo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3962790, "client_id": 3969637, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc7722c3/uploads/origins/20b83fdd-462e-4849-b854-3