r=2&fit=crop&crop=top&w=200&h=200&s=526f0330cc094c5d83c36a0c99df5cb1 2x, https://si.imgix.net/df3c26e3/uploads/origins/babf989a-d9d0-45ed-9a43-d413df663b90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=297dd805a9d83605e9c546c476612489 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df3c26e3/uploads/origins/babf989a-d9d0-45ed-9a43-d413df663b90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03639c4d079c5ee894c1aab5d0d216c0", "srcset": "https://si.imgix.net/df3c26e3/uploads/origins/babf989a-d9d0-45ed-9a43-d413df663b90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03639c4d079c5ee894c1aab5d0d216c0, https://si.imgix.net/df3c26e3/uploads/origins/babf989a-d9d0-45ed-9a43-d413df663b90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f1ec01a87e76ac0a1016130be89221b6 2x, https://si.imgix.net/df3c26e3/uploads/origins/babf989a-d9d0-45ed-9a43-d413df663b90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=118b5c470ff348cfbec08001fd11330d 3x"}, "body": "It is nice to meet you.\nI was introduced to you by a friend and saw your illustration.\nI like your illustration so much that I have decided to commission you to do the illustration.\n\nRequest\nI would like you to illustrate my avatar in a VR game called VRChat and the avatar of a friend of mine.\n\n\u25bdComposition/Situation\nThe ratio of the image should be 16:9 or 9:16 as I would like to use it on a disk top or a lock screen of my phone.\nWe would be happy if the two people are depicted from the waist up.\nWe are not particular about the background.\nAs for the situation, we would like to have a drawing of two people wearing matching clothes and having fun.\n\nThe one with horns (Ryuga) is energetic, always smiling, and loves EVESON.\nHe is a water dragon, so his arms and legs are not human-shaped.\nHis body is covered with blue scales, and his mouth and tongue are also blue.\n\nOn the other hand, the silver-haired and red-eyed one (EVESON) is an android with a quiet smile.\nIn image, he is like 2B of NieR: Automata.\n\u25bdResources\nhttps://drive.google.com/drive/folders/1-1ueYVD-x4UZVLqweeSgo5hWTQEC50sK?usp=sharing\n\nMatching dock tag style necklace.\nhttps://booth.pm/ja/items/3796171\nMatching clothes.\nhttps://booth.pm/ja/items/3771374\nMatching bracelets.\nhttps://twitter.com/3pond_rond/status/1470671158391762944\n\n\u25bdUse outside of Skeb regulations.\nWe would appreciate your permission to use the following\nUse of cropped images as icons on VRChat, SNS sites, etc.\nDisplaying unedited images on my personal SNS or VRChat private world (*non-commercial use)\n\nThank you in advance.\n\nhttps://drive.google.com/drive/folders/1-1ueYVD-x4UZVLqweeSgo5hWTQEC50sK?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@8_hatidori/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1561435, "client_id": 192873, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fee167b2/uploads/origins/fa8525ff-5475-47fd-aeb6-9e0e61a799d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ec30d0d724ad7d76c9cd9ee11d12cd9", "srcset": "https://si.imgix.net/fee167b2/uploads/origins/fa8525ff-5475-47fd-aeb6-9e0e61a799d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ec30d0d724ad7d76c9cd9ee11d12cd9, https://si.imgix.net/fee167b2/uploads/origins/fa8525ff-5475-47fd-aeb6-9e0e61a799d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04412a3e09b261775be0f527bf669520 2x, https://si.imgix.net/fee167b2/uploads/origins/fa8525ff-5475-47fd-aeb6-9e0e61a799d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d25696f73c2019451e4e