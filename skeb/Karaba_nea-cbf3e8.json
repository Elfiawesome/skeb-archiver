BOX、Xへの投稿\n※使用の際、\n・OKUMONO様など権利的に問題のない素材の背景を入れる\n・イラスト全体の後ろにドロップシャドウを入れる\n・イラスト全体をシロフチで囲む\n・バストアップやウエストアップ等で切り抜く\nなどの加工を行う可能性があります。\n上記問題なければ、人物・背景・文字等が分かれたPSDファイル、または透過PNGファイルをいただけますと幸いです。\n\nご検討の程、どうぞよろしくお願いいたします！\n\n▪️参考資料\nhttps://drive.google.com/drive/folders/1RyKHAVFd20zsL0JE7lcQILlWkbwS_HlM\n\nhttps://drive.google.com/drive/folders/1RyKHAVFd20zsL0JE7lcQILlWkbwS_HlM", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Karaba_nea/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3823391, "client_id": 2223302, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8f0bdde/uploads/origins/780504f9-bf57-4ff1-b184-b28ec1fef4c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e06571174701e16a6c2402422ccc1601", "srcset": "https://si.imgix.net/a8f0bdde/uploads/origins/780504f9-bf57-4ff1-b184-b28ec1fef4c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e06571174701e16a6c2402422ccc1601, https://si.imgix.net/a8f0bdde/uploads/origins/780504f9-bf57-4ff1-b184-b28ec1fef4c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93c7682a7e19431d63d0e38b9973bed4 2x, https://si.imgix.net/a8f0bdde/uploads/origins/780504f9-bf57-4ff1-b184-b28ec1fef4c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a6408b0d6fe1e068fbc41a209b53b10 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8f0bdde/uploads/origins/780504f9-bf57-4ff1-b184-b28ec1fef4c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35f1453a1be26298efff3480012e9b5b", "srcset": "https://si.imgix.net/a8f0bdde/uploads/origins/780504f9-bf57-4ff1-b184-b28ec1fef4c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35f1453a1be26298efff3480012e9b5b, https://si.imgix.