場しますので、それに変更してもらいたいです。\n変更内容は…服とタイツを黒、ヘアバンドを紫、髪色を白髪、胸のブローチを紫のリボンに変更、胸が巨乳に……この4点です(少し目つきも鋭くなります)\n\nメリーはMUGENでのオリジナルキャラで資料が少ないですが、可能な限り集めました!\n\nこの3名の集合イラストをどうかよろしくお願いします。\nアングル、ポーズは前回同様お任せします。仲良さげな感じがでてると嬉しいです…!\n\nhttps://f.easyuploader.app/eu-prd/upload/20200914213008_48417263496874424b55.png", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chigusamitsuki/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7e45436c/requests/137138_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b0f27573d000fcb260ebccd0e8d24cb0", "srcset": "https://si.imgix.net/7e45436c/requests/137138_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b0f27573d000fcb260ebccd0e8d24cb0, https://si.imgix.net/7e45436c/requests/137138_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f92e064e11b3855da082e688ba76e0b6 2x, https://si.imgix.net/7e45436c/requests/137138_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46367feda4c0f0a5058db84e31fb24c5 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 608940, "client_id": 229963, "nc": 177}], "sent_works": [], "similar_creators": [{"id": 280310, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "コジロウ", "screen_name": "kojiou3", "avatar_url": "https://pbs.twimg.com/profile_images/1761357282552827904/HGWkyEJM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4698186384/1730218206/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master