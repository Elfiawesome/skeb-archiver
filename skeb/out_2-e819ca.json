om/assets/images/pc/index/img_kv-2.png\n衣装は半脱ぎで胸元が露出した状態を希望します。前回のイラストが非常に良かったので、今回も可能であれば下着の描写があると有り難いです。\n表情は涙を浮かべて気持ち良さそうな様子だと嬉しいです。\nもし可能であれば台詞や喘ぎ声などが入っていると非常に有り難いです。\nシチュエーションや構図・体位などは全てお任せします。\n要望は対応できる範囲で大丈夫です。\n\nご検討頂ければ幸いです。\nよろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@out_2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1321402, "client_id": 1111218, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66c03aba/uploads/origins/29a5b8c0-6e05-445a-a886-e8a7bb27e5cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07cab9b3faec8d310b55c99b46bc7676", "srcset": "https://si.imgix.net/66c03aba/uploads/origins/29a5b8c0-6e05-445a-a886-e8a7bb27e5cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07cab9b3faec8d310b55c99b46bc7676, https://si.imgix.net/66c03aba/uploads/origins/29a5b8c0-6e05-445a-a886-e8a7bb27e5cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aaa3ec99555bc21786014f138527b70d 2x, https://si.imgix.net/66c03aba/uploads/origins/29a5b8c0-6e05-445a-a886-e8a7bb27e5cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6be4b7c44110098930ccd10f379b56af 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66c03aba/uploads/origins/29a5b8c0-6e05-445a-a886-e8a7bb27e5cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=328afd5bb4cdec2811c0b8211ab27ce7", "srcset": "https://si.imgix.net/66c03aba/uploads/origins/29a5b8c0-6e05-445a-a886-e8a7bb27e5cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=328afd5bb4cdec2811c0b8211ab27ce7, https://si.imgix.net/66c03aba/uploads/origins/29a5b8c0-6e05-445a-a886-e8a7bb27e5cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&