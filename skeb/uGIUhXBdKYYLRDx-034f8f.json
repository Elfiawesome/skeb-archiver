00&s=3be15f0b120a5bb782a3ecf4987f3515 2x, https://si.imgix.net/400117d6/uploads/origins/582f749a-4e6f-4f2b-b0bd-b858423c3a67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c4bbda94b70ed1cf1399116cd127df44 3x"}, "body": "はじめまして。\n幽谷霧子（アイドルマスターシャイニーカラーズ）のふたなり絵をお願いします。\n陰茎は黒ずんだ雄々しい巨根（玉有り）で、アヘ顔で射精している絵を描いていただきたいです。\n可能なら、射精がおさまらずにトロトロの表情でイキ続けている差分もお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uGIUhXBdKYYLRDx/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1102677, "client_id": 23850, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e94dc9c/uploads/origins/707ee2e5-c04b-4d92-97c9-b4eb919b4100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d233ed338b60329e1059668d82d5b67", "srcset": "https://si.imgix.net/9e94dc9c/uploads/origins/707ee2e5-c04b-4d92-97c9-b4eb919b4100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d233ed338b60329e1059668d82d5b67, https://si.imgix.net/9e94dc9c/uploads/origins/707ee2e5-c04b-4d92-97c9-b4eb919b4100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11b7ebb2250e078be74227aa48970889 2x, https://si.imgix.net/9e94dc9c/uploads/origins/707ee2e5-c04b-4d92-97c9-b4eb919b4100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb0c98599b8e04a577f3e7d0fdaebf5d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e94dc9c/uploads/origins/707ee2e5-c04b-4d92-97c9-b4eb919b4100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ffc6f898827a1b601287305babe9e58", "srcset": "https://si.imgix.net/9e94dc9c/uploads/origins/707ee2e5-c04b-4d92-97c9-b4eb919b4100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ffc6f898827a1b601287305babe9e58, https://si.imgix.net/9e94dc9c/uploads/origins/707ee2e5-c04b-4d92-97c9-b4eb919b4100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=10b0ea9682c0dba5b90ba7d678d71c48 2x, https://si.imgix.net/9e94dc9c/uploads/origins/707ee2e5-c04b-4d92-97c9-b4eb919b4100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=74a08ca933db7cf667467d9f501bb7bb 3x"}, "body": "初めまして。\nroundscape adoreviaという海外のマイナーエロゲーの、あるイベントをコミック化していただけないでしょうか。\n\n辺境の林を旅していた女主人公。\n霧が出てきて仲間とはぐれ、気がつくと神秘的な湖のほとりに。\nゆっくりと一頭の大きな狼(spirit-wolf)が近づいてくる。ペニスが大きく勃起している。\nそれを見て何かを感じた主人公は自ら服を脱ぎ、股を開いて狼を受け入れる。\n主人公の膣にさんざん精液を注ぎ込んだ狼はまたどこかへと姿を消す。\n後日、主人公は妊娠が発覚。やがて元気な数頭の狼を出産する。\n（以上、これ本当にゲームであったそのままの内容です！）\n\nゲームのスクショも添付しましたが、変えていただきたい点があります。\n・狼ちんちんはもっと大きめに。なんなら狼自体もう一回り大きめでもいいかも（お任せします）。狼およびちんちんの形状は、解剖学的に正確である必要はありません。\n・正常位ではなくバックで。\n・シックスナインはなくていいです。主人公がよつんばいになってのフェラならアリ。\n\nその他、要望です。\n・「膣断面図（精液いっぱい）と卵子受精」、もしくは「狼が立ち去った後ぐったりしている主人公の性器から大量の精液が逆流する」のどちらか（できれば両方）は見たいです。\n・最後は、生まれた子供たちに「貴方たちのお父さんとは、こうして出会ったのよ」と暖かく語りかける主人公、で締めて下さい。エロゲーの女主人公だけあって本当にいろいろとエロい目に合う主人公ですが、それを後悔することは一度もないという性格です。\n\n特殊な性癖ですので、合わなければ遠慮なくキャンセルなさって結構ですが、ぜひ一度ご検討下さい。\n\nhttps://drive.google.com/drive/folders/1QxhK8_wqvSQ7I38-GdepMqntfM2XjHr_", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uGIUhXBdKYYLRDx/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6242529a/uploads/origins/f1bf6d77-2793-4816-8e80-b5184c940733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=420b61f2c25e0a3ac2a0b7a5c895ae19", "srcset": "https://si.imgix.net/6242529a/uploads/origins/f1bf6d77-2793-4816-8e80-b5184c940733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=420b61f2c25e0a3ac2a0b7a5c895ae19, http