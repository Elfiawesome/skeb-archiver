00&s=dc3f7df6f90be1fbb035d7101acc3fe9 3x"}, "body": "ふちなさんこんちは。前回ありがとうございました。\n\n今週いい事ありました、しぬことをやめました。私は今年の夏を満喫せず部屋にずっと引きこもっていい思い出全然いなかった。\n\n今回は「夏だー！」と感じさせる絵が見たいです！\n\n私は2か月ほど追い詰められる状況だったけど、今はずっとましになりました。ふちなさんも元気を出してように。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fucinami/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1868860, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5cf13522/uploads/origins/f4765256-a169-430d-bc2d-3d164be964ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c1efe6901a29050eb8560fa9d62654b", "srcset": "https://si.imgix.net/5cf13522/uploads/origins/f4765256-a169-430d-bc2d-3d164be964ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c1efe6901a29050eb8560fa9d62654b, https://si.imgix.net/5cf13522/uploads/origins/f4765256-a169-430d-bc2d-3d164be964ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c26f2d5378ecc7b0dfcc39699b724ca 2x, https://si.imgix.net/5cf13522/uploads/origins/f4765256-a169-430d-bc2d-3d164be964ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4eb3b19c99b9735d1bb662edd670543 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5cf13522/uploads/origins/f4765256-a169-430d-bc2d-3d164be964ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb5f7785073f02dbace3d68f5aec8e75", "srcset": "https://si.imgix.net/5cf13522/uploads/origins/f4765256-a169-430d-bc2d-3d164be964ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb5f7785073f02dbace3d68f5aec8e75, https://si.imgix.net/5cf13522/uploads/origins/f4765256-a169-430d-bc2d-3d164be964ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=091967ec339249c76c4908bde480e657 2x, https://si.imgix.net/5cf13522/uploads/origins/f4765256-a169-430d-bc2d-3d164be964ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f238e12e45b020cb418f7627481ea9a0 3x"}, "body": "私は朝6時から夜11時まで働いている。障害のある病気の妻を支えるために、この仕事に囚われている。私の人生は決して充実したものではないかもしれない。子供ができたり、一緒に出かけたり、家庭を持ったりと、他の人が刺激的な生活をしているのを見るだけだ。ただ時々、彼女と一緒に死にたくなる。\n\nあなたのようなアーティストを支えるために、私は生きていられるのかもしれない。感情を揺さぶるアートを創作することは美しいと思う。たとえ悲しい絵であっても、同じ感情を持つ人々に喜びをもたらす。\n\n上の文章は関係ないので、好きなように描いてください。ただ、死なないでください。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fucinami/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1868860, "client_id": 547885, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/078d6df4/uploads/origins/5704f1ad-c1b3-41ef-b12c-86b2ab8bbbb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e60d68e4fc8a422a4275a12e300272b", "srcset": "https://si.imgix.net/078d6df4/uploads/origins/5704f1ad-c1b3-41ef-b12c-86b2ab8bbbb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e60d68e4fc8a422a4275a12e300272b, https://si.imgix.net/078d6df4/uploads/origins/5704f1ad-c1b3-41ef-b12c-86b2ab8bbbb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f488f84d9f5c19f6c322c23ed6c9c5f 2x, https://si.imgix.net/078d6df4/uploads/origins/5704f1ad-c1b3-41ef-b12c-86b2ab8bbbb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f8329712e8aba48a2ed9870b35c7f89 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/078d6df4/uploads/origins/5704f1ad-c1b3-41ef-b12c-86b2ab8bbbb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b28068416edeada11599fe12078ecda", "srcset": "https://si.imgix.net/078d6df4/uploads/origins/5704f1ad-c1b3-41ef-b12c-86b2ab8bbbb