et/e1390db0/uploads/origins/575a9e0a-7072-4ebe-8578-759b3ec938c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83a4c9e705719d4d8d3195ddbd4cfc46 2x, https://si.imgix.net/e1390db0/uploads/origins/575a9e0a-7072-4ebe-8578-759b3ec938c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d40114f842e1425726973e7adad26ce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1390db0/uploads/origins/575a9e0a-7072-4ebe-8578-759b3ec938c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=afedbc76ecd87ae9fb95129b2026267b", "srcset": "https://si.imgix.net/e1390db0/uploads/origins/575a9e0a-7072-4ebe-8578-759b3ec938c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=afedbc76ecd87ae9fb95129b2026267b, https://si.imgix.net/e1390db0/uploads/origins/575a9e0a-7072-4ebe-8578-759b3ec938c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4a51d76e8d80d23605d0210276a554ef 2x, https://si.imgix.net/e1390db0/uploads/origins/575a9e0a-7072-4ebe-8578-759b3ec938c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c43eeb29d6c4ad979d971b5a8c3b8695 3x"}, "body": "初めまして、ツイートでの募集から来ました、良ければリクエストさせて下さい！\n\n描いて欲しいのは、桜弥（おうみ）というOCで、この子に自由にコスプレをさせて欲しいなと思っています。\n資料にいろいろ詰め込んであるので、その衣装でもいいですし、全く関係ないものでも大丈夫です！\n可愛く描いてくれたらとても嬉しいです！\n\n桜弥（おうみ）\n17歳、166cm、Dカップ。姉がいるが、姉が巨乳で自分が普通なのがコンプレックス。その割にオシャレのためなら胸をアピールすることも忘れない。姉がコスプレ好きで、それに付き合っていろんな服を着させられたりしている。\n\nもしご縁がありましたら、よろしくお願いします。\nhttps://drive.google.com/drive/folders/1ldnQ85FiD2bewf2m3tZyI8EBekVtrdmj\nhttps://drive.google.com/drive/folders/1vEsUUbtBMMe0u8itbaKtlOKZw4UYNphw", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mcot_3510/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3292292, "client_id": 460270, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55b8352d/uploads/origins/7df8cc12-4ea7-4be5-a270-e9b975f0c86b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f070c6c4a74c149a78189bca9ea4c17", "srcset": "https://si.imgix.net/55b8352d/uploads/origins/7df8cc12-4ea7-4be5-a270-e9b975f0c86b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f070c6c4a74c149a78189bca9ea4c17, https://si.imgix.net/55b8352d/uploads/origins/7df8cc12-4ea7-4be5-a270-e9b975f0c86b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbe0567d97bfc00e075a734735716d7a 2x, https://si.imgix.net/55b8352d/uploads/origins/7df8cc12-4ea7-4be5-a270-e9b975f0c86b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b5f98b425fa29d4536294066e2bb9ea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55b8352d/uploads/origins/7df8cc12-4ea7-4be5-a270-e9b975f0c86b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7201ed6adc7055fed736174cec20798a", "srcset": "https://si.imgix.net/55b8352d/uploads/origins/7df8cc12-4ea7-4be5-a270-e9b975f0c86b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7201ed6adc7055fed736174cec20798a, https://si.imgix.net/55b8352d/uploads/origins/7df8cc12-4ea7-4be5-a270-e9b975f0c86b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c5801fc1ce24fe49aa472f2f3b81dbb 2x, https://si.imgix.net/55b8352d/uploads/origins/7df8cc12-4ea7-4be5-a270-e9b975f0c86b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=463d588f3fc80d5f94fa972662b1b60b 3x"}, "body": "プロセカのイラストがとても良かったので、リクエストを送らせていただきました。\nかなりの特殊性癖ネタになるので、もし興味持たれたらで大丈夫です\nマリオワンダーのW4「ブースケ泳ぐ白砂漠」で変身することになるバルーン姿になったピーチ達のような姿のプロセカキャラ達を描いていただきたいです。\n\n参考画像＆イラスト↓\nhttps://x.com/MORITOKYOKUX/status/1718143055138836680\n\n・PSDなどレイヤーをできるだけ分けた状態でお願いします。\n・絵名、みのり、こはね、咲希を描いていただきたく。\n服装は制服か各々の衣装で。\nもしよければお好みの他の衣装や他のプロセカの娘でも描いていただけると嬉しいです。\n・全員同じサイズでお願いします。\n・ベースとなるのは資料URLイラストのような正面アングルでお願いします。\n・正面アングルになるので左右対称ツールなどを使っていただいて問題ありません。\n・顔は基本は正面向きで可愛い感じの顔だち、笑顔に近い通常表情でお願いします。\nデフォルメはせずに、みこと様の普段通りの絵柄で描いていただきたいです。\n・パーツは目や口などの顔、頭、後ろ髪、服、下半身、足、腕のように分けていただきたいです。\n腕は短めに描いてもらえると嬉しいです。\n・頭と体の大きさの比率は1:3目安です\n・顔のベースなど共通化出来そうなところは共通パーツにしていただいて構いません。\n着せ替えのようなイメージにしてもいいかもしれません。\n・頭は下記のイラストのような正面顔だけの状態も楽しみたいので埋もれて隠れている部分も描いていただきたいです。\nhhttps://t.co/izENVfLqGL\n・恥ずかしがってるなど表情の差分などもあると嬉しいです。\n・原作では下半身ドロワーズですが、下記の参考イラストのよう各々に似合うデザインの下着で描いていただきたいです。\n下着の形状は以下のものや資料URLのイラストを参考にしてください。\nhttps://x.com/Akihuzi_tform/status/1700792098952528005\nhttps://x.com/Akihuzi_tform/status/1759983049260007811\n\nよければよろしくお願いします。\n\nhttps://skeb.jp/@ikuraonigiri/works/82", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mcot_3510/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3292292, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/396ff766/uploads/origins/558d1bd3-c802-463d-95c0-5ca56d2b82e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d978f84abd2ea9085f1e2fb18f0e9ec6", "srcset": "https://si.imgix.net/396ff766/uploads/origins/558d1bd3-c802-463d-95c0-5ca56d2b82e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d978f84abd2ea9085f1e2fb18f0e9ec6, https://si.imgix.net/396ff766/uploads/origins/558d1bd3-c802-463d-95c0-5ca56d2b82e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce3909b5ba1ba3f88384497c0dc6fc72 2x, https://si.imgix.net/396ff766/uploads/origins/558d1bd3-c802-463d-95c0-5ca56d2b82e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6252166bb7ac7cfb8f530f8d3cc71a54 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"