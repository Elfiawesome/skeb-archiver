3ca1b8-f06d-429d-98ce-db75ed00788d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb52c674b2c4f2604790d9f5e67fb15b", "srcset": "https://si.imgix.net/26648e5d/uploads/origins/243ca1b8-f06d-429d-98ce-db75ed00788d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb52c674b2c4f2604790d9f5e67fb15b, https://si.imgix.net/26648e5d/uploads/origins/243ca1b8-f06d-429d-98ce-db75ed00788d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3c98c98d4da2259ebd4a78c79df07ec 2x, https://si.imgix.net/26648e5d/uploads/origins/243ca1b8-f06d-429d-98ce-db75ed00788d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0310000cab5da74ee497e23d0ced3602 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26648e5d/uploads/origins/243ca1b8-f06d-429d-98ce-db75ed00788d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1019c1e4ec0d990b56fd779e3e306f0", "srcset": "https://si.imgix.net/26648e5d/uploads/origins/243ca1b8-f06d-429d-98ce-db75ed00788d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1019c1e4ec0d990b56fd779e3e306f0, https://si.imgix.net/26648e5d/uploads/origins/243ca1b8-f06d-429d-98ce-db75ed00788d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9304e9c2861f4041e0dcf4b857c198cb 2x, https://si.imgix.net/26648e5d/uploads/origins/243ca1b8-f06d-429d-98ce-db75ed00788d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16e3f87ea7269cb5313aff6e30eea606 3x"}, "body": "フラワーナイトガールより、アブラナをお願いします。\n\n「服が透けるメガネ」のような遊びをしてみたいので、\n全裸のレイヤーの上にきちんと服を着ているレイヤーを重ねた形のイラストをお願いします。\n衣装は[希望の若き騎士]の進化前で、武具は外していただいても構いません。\n\nまた、表情差分として\n・本人にはまだ気付かれていないという設定での、普通の表情\n・同じく、「どうしたのよ……急にそんなじっと見つめてきて……」みたいに少し照れているような表情\n・「何やってるかはわかんないけど、なんか変なこと考えてるのだけはわかるわ……」とジト目になっているような表情\nの3種もいただけると嬉しいです。\n\n具体的な構図やシチュエーション等、仔細はお任せします。\n着衣の状態だと普通に騎士団の日常シーンにしか見えないような感じだと嬉しいです。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kerbyofleaf/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 401061, "client_id": 2663972, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e46ecb2/uploads/origins/01de23ef-d1a8-46cc-b767-029916479f69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bea9f14becca2812c03f572d3ff7ad3e", "srcset": "https://si.imgix.net/8e46ecb2/uploads/origins/01de23ef-d1a8-46cc-b767-029916479f69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bea9f14becca2812c03f572d3ff7ad3e, https://si.imgix.net/8e46ecb2/uploads/origins/01de23ef-d1a8-46cc-b767-029916479f69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ceabc0452b8c0f40340508085f08fae5 2x, https://si.imgix.net/8e46ecb2/uploads/origins/01de23ef-d1a8-46cc-b767-029916479f69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe4f00aeddb358d486d01e21ed4a83ef 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e46ecb2/uploads/origins/01de23ef-d1a8-46cc-b767-029916479f69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fab8569529b44dcdef15ed7541892aa3", "srcset": "https://si.imgix.net/8e46ecb2/uploads/origins/01de23ef-d1a8-46cc-b767-029916479f69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fab8569529b44dcdef15ed7541892aa3, https://si.imgix.net/8e46ecb2/uploads/origins/01de23ef-d1a8-46cc-b767-029916479f69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d7684a05216415e9ec86d38b805890a2 2x, https://si.imgix.net/8e46ecb2/uploads/origins/01de23ef-d1a8-46cc-b767-029916479f69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e9025808aba9eac1b2792174fc013aa3 3x"}, "body": "今回、２回目の依頼です。今回はかなり難しい内容です。\n\n簡単に言うと、「クルミの技の「クルミ・オン・ステージ！」を前斜めから見た構図」を書いて欲しいです。\n１、手前のギター(？)を持ったリスはカメラ目線でジャンプしてウィンクしてるポーズでお願いします。そして、クルミと奥のリスはお客目線でお願いします。\n\n２、クルミは開花衣装で描いて下さい。\n\n３、エフェクトの紙吹雪の他にクルミの周りにピンクのハートとピンクのキラキラのエフェクトをつけてください。\n\n４、全体として、クルミの「頭から太もも辺り」までが見えるように描いてください。最悪、奥のリスは一部しか見えないという状態になっても構いません。\n\n５、背景は暗いところにライトで照らす感じに見せてほしいです。\n\n最後に、今回のイラストは紙を横にして描いてください。ただし、紙のサイズは問いません。よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kerbyofleaf/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 401061, "client_id": 115971, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e95088e/uploads/origins/b0a00715-efda-4180-be07-cf67821d8b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11c64a1aca59e6178abe10b0b439f431", "srcset": "https://si.imgix.net/7e95088e/uploads/origins/b0a00715-efda-4180-be07-cf67821d8b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11c64a1aca59e6178abe10b0b439f431, https://si.imgix.net/7e95088e/uploads/origins/b0a00715-efda-4180-be07-cf67821d8b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03d37aebe2fc7eee21653b509e968ccf 2x, https://si.imgix.net/7e95088e/uploads/origins/b0a00715-efda-4180-be07-cf67821d8b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8365279ff619bbca9939933a14a544d6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e95088e/uploads/origins/b0a00715-efda-4180-be07-cf67821d8b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dac6ffaf678d22fe25e69664f7cac75", "srcset": "https://si.imgix.net/7e95088e/uploads/origins/b0a00715-efda-4180-be07-cf67821d8b7e?bg=%23fff&auto=format%2Ccompres