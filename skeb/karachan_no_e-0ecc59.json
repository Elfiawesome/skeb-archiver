&fit=crop&crop=top&w=200&h=200&blur=200&s=fd0deb9115955a15e9f3e6ccb0bcfb41 3x"}, "body": "はじめまして、VTuberのいしぴと申します\nkaraさんの絵柄に惹かれ、今回はハロウィンに向けて依頼をさせていただきました\nテーマは幼稚園児のコスプレです\n服装：白い丸襟の着いたピンク色のスモック\nそでは少し長めで萌え袖\n丈は太ももが3分の1隠れるくらい\nモデル：いしぴ\n表情：少し照れて困り気味で頬を赤らめ上目遣い\n髪型：耳下ツインテール(小さいツインテール)\n希望：等身大モデル(全身)\nポーズ：片手は顎あたり、片手はお股あたりで服をぎゅっと掴むようなイメージ\n\nご検討お願いします🙇‍♀️\n\nhttps://x.com/Ishipichan?t=VzHX7uz8J7l7k_1xp-FuUQ&s=09", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karachan_no_e/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2745832, "client_id": 2307234, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db95a04c/uploads/origins/e5896a7b-7be8-436c-9582-0aebeee643c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f544a6f83b162be3e61c7dda83e8a4f", "srcset": "https://si.imgix.net/db95a04c/uploads/origins/e5896a7b-7be8-436c-9582-0aebeee643c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f544a6f83b162be3e61c7dda83e8a4f, https://si.imgix.net/db95a04c/uploads/origins/e5896a7b-7be8-436c-9582-0aebeee643c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa1f095a06d842d685e6c51d2869abc9 2x, https://si.imgix.net/db95a04c/uploads/origins/e5896a7b-7be8-436c-9582-0aebeee643c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3df03e7ef0a027c6147cb2d90635834 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db95a04c/uploads/origins/e5896a7b-7be8-436c-9582-0aebeee643c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=631aad377a7b5fae43f6f26aef31385e", "srcset": "https://si.imgix.net/db95a04c/uploads/origins/e5896a7b-7be8-436c-9582-0aebeee643c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=631aad377a7b5fae43