 true, "creator_id": 5650, "client_id": 335677, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@HRGNSM/works/47", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/22282ec3/uploads/origins/f387a882-820b-4d6b-9617-e4edfcb37583?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d35c40ff592d048eb6ade112adbbcbf5", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 5650, "client_id": 1873389, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@HRGNSM/works/46", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 5650, "client_id": 463315, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7afb4ffb/uploads/origins/792f3963-49cd-46a4-acde-fe116cfee309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=401d35878efdf720aebdc4f3cdc3a291", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7afb4ffb/uploads/origins/792f3963-49cd-46a4-acde-fe116cfee309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aaae9fa17b8517810e8a3ed85f3a7c5a", "src_set": ""}, "body": "こんにちは！平素よりお世話になっております！\nいつも素敵なイラストを描いていらっしゃるすみさんにご依頼したくこの度skebでメッセージさせていただきました。\n\n依頼内容\nイラスト部類→カラーイラスト\nキャラクター→添付資料の拙宅の創作キャラクター\n構図等→キャラクターの構図はお任せします、何か植物のモチーフと一緒に描いていただけると嬉しいです。\n\n衣装に強いこだわりはないので、大まかなキャラクターの雰囲気が変わらないのであればカラーチェンジや簡略化、アレンジ、お好きにデザインを崩ししていただいても問題ありません。\n正直すみさんのイラストの自キャラが見たいだけなのでなんでも大丈夫です。\n\n以下資料\n【https://www.pixiv.net/artworks/93251922】\n【https://twitter.com/i/events/1464569967643226114?s=21&t=0HnAKXVGyxNSpiXG4a3N0g】", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HRGNSM/works/45", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/89271999/uploads/origins/dec17c67-d786-4b31-a414-22182a50695b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f34710e585d35c3176d9bea50c4cb70", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 5650, "client_id": 1018375, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@HRGNSM/works/44", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5650, "client_id": 644350, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3e8b30a/uploads/origins/d3859fed-3fdd-45ce-a5f1-f64c61c5056e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e194e7cccbbd849271eac85f506047fa", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3e8b30a/uploads/origins/d3859fed-3fdd-45ce-a5f1-f64c61c5056e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ea1b6d1263b651f1cfe9022522c1991", "src_set": ""}, "body": "こんにちは。あなたの絵が好きです!\nFF14のキャラの絵が欲しいです。\n下の \"スクリーンショット \"と \"アート \"のタブをクリックすると、もっと多くの参考資料を見ることができます。\n日焼けした肌と明るい金髪です。彼の目は赤ではなくマゼンタ色です。\n彼は平均的なMiqo'teより少し大きいです。\n大きくてはっきりした筋肉がある。胸にタトゥーがある。\n\n武道家である。\n運動と戦いが好き。\n性格はとても明るく、情熱的です。\n元気でかわいい笑顔でいてほしいです!\nポーズを選ぶことができます。\n衣装が細かすぎる場合は、簡略化することができます。\n\nこのアートに使った色彩のスタイルが好きです!\nhttps://skeb.jp/@HRGNSM/works/40\n\nありがとうございました。\n\nhttps://www.kirostyle.net/yshenn.html", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HRGNSM/works/43", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 5650, "client_id": 700848, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ed25137/uploads/origins/3ec49201-9e66-451c-ba37-2e875f691142?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83298e94eb28c99f2241cc476a761eb5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ed25137/uploads/origins/3ec49201-9e66-451c-ba37-2e875f691142?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09335c349607f1df2869941348c2d743", "src_set": ""}, "body": "こんにちは、私はあなたの絵が大好きで、私のffxivのキャラクターの絵をお願いしたいです!また、このような絵が好きで、私のffxivのキャラクターをリクエストしたいです！戦闘やクールなポーズで、真剣な表情でお願いします。頼もしくて、真面目で、強いキャラクターですまた、顔に傷があり、アイシャドウが赤いのが特徴です。あと、筋肉質な感じでお願いします。ありがとうございました。\n\nhttps://imgur.com/a/SlbMWei", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HRGNSM/works/42", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 5650, "client_id": 1425382, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/685aeb47/uploads/origins/ce480638-497e-430a-b341-173e4210a59d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28350c8410ba49d41ac47d5155673bce", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/685aeb47/uploads/origins/ce480638-497e-430a-b341-173e4210a59d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc21cb530ab513181435db4ebe120b8a", "src_set": ""}, "body": "こんにちは～♪ FFXIVのキャラクター、グラーハ・ティアのイラストを依頼したいのです