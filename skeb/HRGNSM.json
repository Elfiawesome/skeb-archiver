ます。\n踊って戦っているそんなワンシーンをお願いしたいです。\nスキルのエフェクトがきれいなので一緒に描いていただきたいです！\nスクリーンショットではうまく撮影できなかったので、お手数おかけして申し訳ないのですが動画のほうを参考にしていただけると嬉しいです。\n参考：https://youtu.be/WCVcgZ8dtD0?t=277\n\nキャラと一緒に家で飼っている熱帯魚を描いてほしいです。\nしつこくなりそうであれば無しで大丈夫です！\nhttps://twitter.com/nanami_0x0/status/1522466731561684992?s=20&t=1VAqKqcugm7Daewpch9gZA\nhttps://twitter.com/nanami_0x0/status/1494991895738478592?s=20&t=1VAqKqcugm7Daewpch9gZA\nhttps://twitter.com/nanami_0x0/status/1547371877206736899?s=20&t=1VAqKqcugm7Daewpch9gZA\nどの子でも大丈夫です、よろしくお願いします。\n\n使用用途としてSNS主にツイッターの、アイコンやヘッダーに利用したいと考えています。\n利用許可をいただけると嬉しいです。\n\nお忙しいところ恐れ入りますが、ご検討のほどよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HRGNSM/works/51", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/df18eeb6/uploads/origins/7a04b067-ab31-41fc-98fe-13a1ba623527?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9eba08d6bad0f4133a07235f8bfe954", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 5650, "client_id": 1157853, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@HRGNSM/works/50", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5650, "client_id": 116614, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/304fac26/uploads/origins/deb135fe-2ee9-487a-8a8f-e1db95cb034f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9780e8cf0e80ec63ffd6c5664d1f693", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/304fac26/uploads/origins/deb135fe-2ee9-487a-8a8f-e1db95cb034f?b