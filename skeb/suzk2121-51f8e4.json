ins/7d72fbea-6708-45e0-8481-b40e488a2272?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a887ce4ecc7a9063f2f7198335f330f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24d4ed78/uploads/origins/7d72fbea-6708-45e0-8481-b40e488a2272?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19bea5ac2d2277a733ca6fb4e61ad896", "srcset": "https://si.imgix.net/24d4ed78/uploads/origins/7d72fbea-6708-45e0-8481-b40e488a2272?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19bea5ac2d2277a733ca6fb4e61ad896, https://si.imgix.net/24d4ed78/uploads/origins/7d72fbea-6708-45e0-8481-b40e488a2272?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b5b538f95a3ea6cbb39ba289b8909bd1 2x, https://si.imgix.net/24d4ed78/uploads/origins/7d72fbea-6708-45e0-8481-b40e488a2272?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=34d2d4b6d7e166e8b72fd87608e116ec 3x"}, "body": "Madma𝕏@skeb募集中様\n\nお世話になっております。\nいつも素敵なイラスト楽しみにしています。\n\n早速ですが、五十鈴が深海忌雷の触手に手足を拘束され、ペニスのような形状をした触手を膣に挿入されそうになっているイラストの作成をよろしくお願いいたします。\n\n・場所は薄暗い感じの海の底です。\n・海の底の上で脚を拘束されてM字開脚をさせられています。両手を広げた状態で腕を拘束されています。腕については胸や性器を隠せない状態で拘束されており、結婚指輪が見えている状態なら大丈夫です。\n・壊れた艦装が下に転がっており、剝ぎ取られたマイクロビキニは海中を浮遊しています。(ここについてはカットでも構いません)\n・衣服は全く身に着けていない全裸の状態です。\n・恥ずかしさと口惜しさと恐怖で涙を流しています。\n・乳首は触手にもてあそばれています。\n・大陰唇と小陰唇は触手に引っ張られていてくぱぁの状態で、膣が完全に無防備です。\n・性器の状態は以前描かれたこちらのイラストと同じ感じでよろしくお願いいたします。https://madmax.fanbox.cc/posts/3909843\nただ、性器はパイパンでもっと黒ずんだ感じだと嬉しいです。\n・肌は以前描かれたようにビキニで隠れる部分以外は褐色だと嬉しいです。乳首も少し黒ずんで、肌よりも褐色が望ましいです。https://www.fanbox.cc/@madmax/posts/2691076\n・ペニスのような触手が五十鈴の膣に狙いを定めています。\n・五十鈴は「そこだけはやめて！提督だけのもの。提督の赤ちゃんを産むためのもの。」と言って泣き叫んでいます。\n・できれば差分として触手を膣に挿入され、「ごめんなさい、提督。」と力なくつぶやくシーンも描いていただける嬉しいです。\n\n設定が複雑ですが、検討していただけると幸いです。\n最後に参考になりそうなイラストのURLを添付させていただきます。\nhttps://www.pixiv.net/artworks/87283407\nhttps://www.pixiv.net/artworks/101455140\nよろしくお願いいたします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suzk2121/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/be7f18d4/uploads/origins/69bb946b-76ba-4177-96fa-1086e9d94b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=172f4786f13f7672b2a72ded96a27317", "srcset": "https://si.imgix.net/be7f18d4/uploads/origins/69bb946b-76ba-4177-96fa-1086e9d94b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=172f4786f13f7672b2a72ded96a27317, https://si.imgix.net/be7f18d4/uploads/origins/69bb946b-76ba-4177-96fa-1086e9d94b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92d0ea5d05c3ea11fddf5b1b4dc9b70a 2x, https://si.imgix.net/be7f18d4/uploads/origins/69bb946b-76ba-4177-96fa-1086e9d94b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3704f4e253c3d391cb3da3b1dc77fd33 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1782713, "client_id": 1508582, "nc": 176}, {"path": "/@suzk2121/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1782713, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7173608c/uploads/origins/a3e6f453-9a54-4968-960c-111fa59b4725?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c7124f4331d648d7b10e4b850ac898c", "srcset": "https://si.imgix.net/7173608c/uploads/origins/a3e6f453-9a54-4968-960c-111fa59b4725?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=to