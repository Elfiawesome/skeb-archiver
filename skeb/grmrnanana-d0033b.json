2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0fc98c61c6dc8d396af5d926b59c6d31", "srcset": "https://si.imgix.net/186b9f5b/uploads/origins/3b623978-4db2-42d8-8a0a-390875e8b610?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0fc98c61c6dc8d396af5d926b59c6d31, https://si.imgix.net/186b9f5b/uploads/origins/3b623978-4db2-42d8-8a0a-390875e8b610?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=41e47188e135ee041978753274ecb247 2x, https://si.imgix.net/186b9f5b/uploads/origins/3b623978-4db2-42d8-8a0a-390875e8b610?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9855676729d7aaae681bb91b09ac0af5 3x"}, "body": "tunral様\n\nはじめまして、いつも漫画や絵日記楽しみにしています。\nシロくじ、すごく好きだったので完結寂しいですが嬉しいです。素敵な作品ありがとうございました。リヴリーやゲームのキャラのイラストなども大変可愛くて、拝見すると嬉しくなっています。\n\n今回はオリジナルキャラクターのイラストをリクエストさせて頂きます。キャラクター2名の画像はURLから確認お願いします。\nSNSで公開したり、自分でたのしむ用にする予定です。\n\nhttps://x.com/grmrnanana/status/1814881784191967431?s=46&t=QAswAEcMpg1Guc7enoTVKQ\n\nhttps://x.com/grmrnanana/status/1818438260810826029?s=46&t=QAswAEcMpg1Guc7enoTVKQ\n\n〇どちらか1人でも構いません\n〇ピンク髪、青髪どちらも17.8歳くらいの外見年齢で顔がそっくりという設定です。また、青髪の子のほうが一応少し女性らしい体つきになっている設定です。\n〇ピンク髪のほうがふにゃふにゃと笑う、食べるのが好き。青髪は控えめに笑う、または無表情、ピンク髪のことはちょっと引いて見てる感じ。(参考まで)\n〇衣装、ポーズなど、自由に描いて頂けると嬉しいです。\n〇tunral様のミニキャラ(特に1.5等身くらいの……)がだいすきなので、ミニキャラがいると嬉しいです。\n\nここまでご覧いただきありがとうございます。\n不足や不備などありましたら、お戻し下さい。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_zura/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 114786, "client_id": 192761, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/392cdbd2/uploads/origins/27c3663c-19f4-40f4-9f4d-3db2fe32b358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc4254206f25f89f8be8035d1234f953", "srcset": "https://si.imgix.net/392cdbd2/uploads/origins/27c3663c-19f4-40f4-9f4d-3db2fe32b358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc4254206f25f89f8be8035d1234f953, https://si.imgix.net/392cdbd2/uploads/origins/27c3663c-19f4-40f4-9f4d-3db2fe32b358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=279d97f60f3dda86944ed3ac5d82c43e 2x, https://si.imgix.net/392cdbd2/uploads/origins/27c3663c-19f4-40f4-9f4d-3db2fe32b358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0824918a20d854881e7545fe18a4e39c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/392cdbd2/uploads/origins/27c3663c-19f4-40f4-9f4d-3db2fe32b358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e33ec23876ac29bab109a91b623a3f1", "srcset": "https://si.imgix.net/392cdbd2/uploads/origins/27c3663c-19f4-40f4-9f4d-3db2fe32b358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e33ec23876ac29bab109a91b623a3f1, https://si.imgix.net/392cdbd2/uploads/origins/27c3663c-19f4-40f4-9f4d-3db2fe32b358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=487086bbdec09a0c03de2eab86808e97 2x, https://si.imgix.net/392cdbd2/uploads/origins/27c3663c-19f4-40f4-9f4d-3db2fe32b358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e2475b5e7f3b23219cab1a2437fe4135 3x"}, "body": "ずらさん、こんばんは。\nいつもお世話になっております、ななな。です。\n今回は、カミツレとキョウチクトウのイラスト(まんが)をお願いしたく依頼しました。\nぐりまる内での生活のふとしたときや、依頼中など、ずらさんが描きやすいシチュエーションで1ページまんがか、イラストをお願いします。\nぼんやりとしたお願いですみません。ずらさんの自然な絵を見られたらうれしいです。\n資料を添付しますので、ご参考になれば。漫画の場合も考えて口調など書き添えました。\nまた、衣装や髪型などは描きやすいようにアレンジや簡易にしていただければと思います。\nまた、なにぶん相場が分からないもので金額が足りなかったり、依頼が曖昧すぎるなどありましたら再送依頼をお願いします。\n長くなりましたが、気軽にお絵描きしていただければと思いますので、よろしくお願いします。\n\nカミツレ\nhttps://x.com/grmrnanana/status/1814881784191967431?s=46&t=QAswAEcMpg1Guc7enoTVKQ\n語尾が間延びした敬語。たまにタメ口。\nまだすこしデリカシーがない。\n2人だとぼんやりうふふが加速する。実年齢はかなり上。\n\nキョウチクトウ\nhttps://x.com/grmrnanana/status/1818438260810826029?s=46&t=QAswAEcMpg1Guc7enoTVKQ\nです、ます調だけどちょっと偉そうな時あり。\nお嬢様言葉。\nカミツレに呆れながらも、最近は仲良し。\n2人だとお姉さんぽくなる。実年齢は下。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matsu_rra/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 235230, "client_id": 192761, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3a341ab/uploads/origins/2b18c8b6-6f7a-48f6-8aab-b676563102b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cab8ee7970ef49691f92df917183fab8", "srcset": "https://si.imgix.net/d3a341ab/uploads/origins/2b18c8b6-6f7a-48f6-8aab-b676563102b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cab8ee7970ef49691f92df917183fab8, https://si.imgix.net/d3a341ab/uploads/origins/2b18c8b6-6f7a-48f6-8aab-b676563102b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2139c26bc28fa64ba209693baad2779f 2x, https://si.imgix.net/d3a341ab/uploads/origins/2b18c8b6-6f7a-48f6-8aab-b676563102b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e713c7d53c80ddef5f210ecef8e16542 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3a341ab/uploads/origins/2b18c8b6-6f7a-48f6-8aab-b676563102b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b34a6d909ab4a7095866b836a825490", "srcset": "https://si.imgix.net/d3a341ab/uploads/origins/2b18c8b6-6f7a-48f6-8aab-b676563102b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b34a6d909ab4a7095866b836a825490, https://si.imgix.net/d3a341ab/uploads/origins/2b18c8b6-6f7a-48f6-8aab-b676563102b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ee44d8ffc9b598081319f37915cbc67 2x, https://si.imgix.net/d3a341ab/uploads/origins/2