衣ボテ腹内部に粘液まみれの触手を孕み、内部で大量の触手で蠢き外から見ても歪に変形していることがわかる描写と、\n下腹部に怪しく光る妊娠を示す淫紋の描写が可能なら希望します\n\nひなのスカート下の触手に関してですがスカートの表面を波打たせながら溢れ出る粘液まみれのブラシ状触手のほかに、\nアナル&前立腺責め用にお尻をガッチリと捕まえる触手花と、その中心に肉塊卵を産み付ける産卵管を持つ肉々しい産卵触手をメインにして頂ければ幸いです\nちとせの肉塊卵オナホは半不定形の肉塊で持っているだけで指がめり込む程柔らかで変形しやすく、\n開口部からは泡立つほど高粘度の大量の粘液を溢れさせており、\n大量の粘液を服越しにおっぱいの谷間に垂らしておっぱいに服がぴったり張り付いている描写を希望します\n\nできましたら背景は触手肉壁もしくは禍々しい感じで、psd形式希望で\n高粘度の粘液にまみれた肉塊&粘液まみれの触手が蠢く水音(効果音)の有無、二人の瞳のハイライト&顔上部の影の有無差分希望です\nさらに優先度低で、口調やキャラ付けはお任せしますので、人外の卵を受精させることに興奮する変態マゾ男への嫌悪感MAXの罵倒・侮蔑台詞差分を希望します\n肉塊卵参考：https://imgur.com/a/2XRmeKC\n各種触手参考：\n\nhttps://imgur.com/a/I02AVSy", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 359111, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "みそ🍜", "screen_name": "misomiso_154", "avatar_url": "https://pbs.twimg.com/profile_images/1684890246620848128/4zxRZaNR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3182208020/1672767737/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 40, "skills": [{"genre": "art"}], "banned": false, "nc": 185}, {"id": 655416, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "M・O", "screen_name": "MO13024474", "avatar_url": "https://pbs.twimg.com/profile_images/1296800880772050946/ho46VxPK.png", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 2002193, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "leyton(レイトン) 爆乳　ふたなり　 futanari big boobs", "screen_name": "leyton_oekaki", "avatar_url": "