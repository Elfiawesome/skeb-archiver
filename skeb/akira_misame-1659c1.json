動中です。  \n\n厚塗りの透明感に惹かれて、依頼致しました。  \n\n描いて欲しいキャラ:自キャラ \n\n用途: Twitter等のSNSで使用(アイコン・ヘッダー・おはV画像等)、収益化を含むIRIAMサムネイル、返礼品に使用(デジグ・リアグ)、IRIAMのパネル開け。\n\n自キャラ:ガラス・鏡・原石・虹入り水晶・宝石・人工石の破片の集合体の人外。相手の言動によって反射して光り輝く。 \n\n自キャラの容姿:https://x.com/ninomaemanoni/status/2038138399778079062?s=46  \n\nデータ:納品は透過のもあると助かります。PNG形式だと嬉しいです。\n\n和風な感じで好きなように自由に描いて頂けると助かります。 \n全身入ると嬉しいですが、難しい様なら大丈夫です。\n\n宜しくお願い致します。\n\nhttps://x.com/ninomaemanoni?s=11\n\nhttps://x.com/ninomaemanoni?s=11", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akira_misame/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4093014, "client_id": 3798269, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bfcb992a/uploads/origins/f6406c08-8673-4eed-96fe-060817cd0c19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1912f69ca7ff039ebd9c2eb49c565478", "srcset": "https://si.imgix.net/bfcb992a/uploads/origins/f6406c08-8673-4eed-96fe-060817cd0c19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1912f69ca7ff039ebd9c2eb49c565478, https://si.imgix.net/bfcb992a/uploads/origins/f6406c08-8673-4eed-96fe-060817cd0c19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b61dc1dde4959a514e7fe6077c1efa1d 2x, https://si.imgix.net/bfcb992a/uploads/origins/f6406c08-8673-4eed-96fe-060817cd0c19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed2def09dc7d003cffb218b3c49fc32e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bfcb992a/uploads/origins/f6406c08-8673-4eed-96fe-060817cd0c19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d863e36b56c09fc83beba829b8b5a832", "srcset": "https://si.imgix.net/bfcb992a/uploads/origins/f6406c08-8673-4eed-96fe-060817cd0c19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&c