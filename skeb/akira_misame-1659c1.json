らのイラストとても素敵です。\nご参考までに僭越ながら貼らせて頂きます。\nhttps://x.com/akira_misame/status/1974769790968623338\n\nhttps://x.com/akira_misame/status/2051963075738350075\n\n\n☆キャラクター☆\n星空や月がモチーフの女の子です。\n白い猫ちゃんが一緒に居ることが多いですがお任せします。\n\n☆深雨様の好きな作品☆\n\n\n\n背景と人物を分けたPSDデータで納品していただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1fWjcQM00HvwzFIXoJuSQaMgQVfhX6OwJ", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akira_misame/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4093014, "client_id": 2034094, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed8666b2/uploads/origins/e92aac0d-cd87-40c1-8c5f-7640e47fdf92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10d171c4d1a9a6f7ec40c6d854795076", "srcset": "https://si.imgix.net/ed8666b2/uploads/origins/e92aac0d-cd87-40c1-8c5f-7640e47fdf92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10d171c4d1a9a6f7ec40c6d854795076, https://si.imgix.net/ed8666b2/uploads/origins/e92aac0d-cd87-40c1-8c5f-7640e47fdf92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5025e08daabdb815846547fca066c7e6 2x, https://si.imgix.net/ed8666b2/uploads/origins/e92aac0d-cd87-40c1-8c5f-7640e47fdf92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=118d19c081bc89366ecbe1e87c9d1dc2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed8666b2/uploads/origins/e92aac0d-cd87-40c1-8c5f-7640e47fdf92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7669e7c3a905f8e6e0fe8639f2d0f80b", "srcset": "https://si.imgix.net/ed8666b2/uploads/origins/e92aac0d-cd87-40c1-8c5f-7640e47fdf92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7669e7c3a905f8e6e0fe8639f2d0f80b, https://si.imgix.net/ed8666b2/uploads/origins/e92aac