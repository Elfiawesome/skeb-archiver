トは、SNS・ソーシャルメディアでの使用やVTuber活動などに使用する予定です。そのため、可能であれば、背景とキャラクターを分離した状態の透明PNG、またはレイヤー分けされたPSD形式で納品していただけますと幸いです。\n\nご検討いただき、ありがとうございます！\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1XSruMSdpM71qHdgrq-R_2li4q1M6AX1z", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akira_misame/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4093014, "client_id": 3632098, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e1d7825/uploads/origins/81405497-6bd7-4a16-a942-94de665c3600?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db87a6007d3d8534f03e1f8893a5b79f", "srcset": "https://si.imgix.net/3e1d7825/uploads/origins/81405497-6bd7-4a16-a942-94de665c3600?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db87a6007d3d8534f03e1f8893a5b79f, https://si.imgix.net/3e1d7825/uploads/origins/81405497-6bd7-4a16-a942-94de665c3600?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acfd77909db51f4765ccdfbbb4f18025 2x, https://si.imgix.net/3e1d7825/uploads/origins/81405497-6bd7-4a16-a942-94de665c3600?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a925108ebd8bc068d8a17e1ddd5f8583 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e1d7825/uploads/origins/81405497-6bd7-4a16-a942-94de665c3600?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=682beadbb7db250e0166e3ba6fe3ce3e", "srcset": "https://si.imgix.net/3e1d7825/uploads/origins/81405497-6bd7-4a16-a942-94de665c3600?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=682beadbb7db250e0166e3ba6fe3ce3e, https://si.imgix.net/3e1d7825/uploads/origins/81405497-6bd7-4a16-a942-94de665c3600?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blu