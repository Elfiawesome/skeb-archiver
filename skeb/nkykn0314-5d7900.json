&s=f93288d5be921d303570b0c761f34d3c 2x, https://si.imgix.net/f3e46a1b/uploads/origins/0003c911-a42d-4ec7-8462-6734ba97115c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a97315cdacaeaff4f3d906247c65edda 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3e46a1b/uploads/origins/0003c911-a42d-4ec7-8462-6734ba97115c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bca726e2b15a3ee6fb923b124d9efafb", "srcset": "https://si.imgix.net/f3e46a1b/uploads/origins/0003c911-a42d-4ec7-8462-6734ba97115c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bca726e2b15a3ee6fb923b124d9efafb, https://si.imgix.net/f3e46a1b/uploads/origins/0003c911-a42d-4ec7-8462-6734ba97115c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4fa5a12af61a74fa30a0d3e10d21ad28 2x, https://si.imgix.net/f3e46a1b/uploads/origins/0003c911-a42d-4ec7-8462-6734ba97115c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dcc66fa522f46fca75cbbc086f6e50fd 3x"}, "body": "いつもストブラのイラストお世話になっております。\n\n煌坂紗矢華と仙都木優麻……を模した式神のイラストお願いします。\n【服装】\n煌坂：資料URL1枚目\n優麻：本人の私服(https://skeb.jp/@rourou_ill/works/2)、もしくは2枚目の彩海学園高等部制服\n【シチュエーション】\n無表情で気を付けの姿勢をとっている優麻の服装の乱れを煌坂が整えている場面。\n表情についてですが前者は先生が以前描かれたユスティナ(https://www.pixiv.net/artworks/104691684)のようなもの、\n後者は資料URL3枚目のような微笑でお願いします。\n\n何卒ご一考いただけると幸いです。\n\nhttps://x.com/ves_ZoL/status/1774700806786486370?s=20", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nkykn0314/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 355843, "client_id": 190032, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/229a1d4d/uploads/origins/07430f66-38aa-4e67-913c-a560fdf89858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200