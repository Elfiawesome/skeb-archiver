た1人どちらかを描いていただくのでもどちらでも大丈夫です。\n衣装は資料のままでもアレンジしたものでもオリジナルの物を着せていただくのでもどれでもOKです。\n\n使用用途\n個人鑑賞、有償依頼などでの資料用\n\n資料不備や料金不足などありましたら再送やキャンセルしていただけましたら幸いです。\n\nhttps://drive.google.com/drive/folders/1cAiK7Y8-4OqrR6bJw11I-9CJSboe47Qp", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SATO_0425_/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3951578, "client_id": 3497791, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fda25e51/uploads/origins/123bcc22-6ec4-4560-9481-e473ae55cdf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f60a29781a87956a7937730d749656b", "srcset": "https://si.imgix.net/fda25e51/uploads/origins/123bcc22-6ec4-4560-9481-e473ae55cdf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f60a29781a87956a7937730d749656b, https://si.imgix.net/fda25e51/uploads/origins/123bcc22-6ec4-4560-9481-e473ae55cdf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e6ab1cde421289b6a0ae945353207af 2x, https://si.imgix.net/fda25e51/uploads/origins/123bcc22-6ec4-4560-9481-e473ae55cdf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=871b0b2da50c7944cb6f53480f13bc74 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fda25e51/uploads/origins/123bcc22-6ec4-4560-9481-e473ae55cdf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee023778c2af1e9cb36fc43d1ed1612a", "srcset": "https://si.imgix.net/fda25e51/uploads/origins/123bcc22-6ec4-4560-9481-e473ae55cdf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee023778c2af1e9cb36fc43d1ed1612a, https://si.imgix.net/fda25e51/uploads/origins/123bcc22-6ec4-4560-9481-e473ae55cdf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe5e30e725a4c29664c7a119aca70af4 2x, https://si.imgix.net/fda25e51/uploads/origins/123bcc22-6ec4-4560-9481-e473ae55cdf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=054bd0eaeb8da9d874cbba5cfcd585c6 3x"}, "body": "初めまして！\n素敵なイラストに惹かれ、ぜひともOCをご依頼させていただきたくご連絡させていただきました。\n\n■依頼内容\n・該当キャラクター（💚）のイラスト\n・構図や服装など全ておまかせいたします。\n┗やや女の子らしい感じだと嬉しいです…！\n\n■使用用途\n・SNSアイコンに使用\n・壁紙に使用など\n┗全て非商用です！\n\n■キャラクター詳細\n💚女性（男装女子）/167cm\n何事も真面目に取り組むしっかりもの。負けず嫌いで嫉妬深い。\n男装をしている女性の探偵助手。探偵がだらしないので身の回りのお世話をしている。\n\n探偵（資料内🩵）とは長い時間をともにしており、恋愛的に好きだが、相手にその感情がないと思っているため死ぬまで抱えていくつもり。\n頭を撫でられるのが好きで「私、頑張ったんだけど。」と言ってはご褒美を強請る。素直に喜ぶのは恥ずかしいため、ツン、としているが内心は喜んでいる。最近は探偵にしてほしいことを少しだけ口に出せるようになった。\n\n\nご検討のほどお願いいたします。\n\nhttps://drive.google.com/drive/folders/1i2TX_PU84g6wrIf5jq4e2BORLpnOS_-T", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SATO_0425_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3951578, "client_id": 1825569, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/77f457fc/uploads/origins/55799366-91b6-42be-bfa9-acebbaa76b35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4cb3ddd29064b3f9effb8762aff1fae", "srcset": "https://si.imgix.net/77f457fc/uploads/origins/55799366-91b6-42be-bfa9-acebbaa76b35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4cb3ddd29064b3f9effb8762aff1fae, https://si.imgix.net/77f457fc/uploads/origins/55799366-91b6-42be-bfa9-acebbaa76b35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09b1ff649e6a9d3bbfe22cd5ac09c8a5 2x, https://si.imgix.net/77f457fc/uploads/origins/55799366-91b6-42be-bfa9-acebbaa76b35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3607ba7d89cd45bc70d8d498ef149df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.