/2749d3b0-d6c6-4fa4-8907-8514e3ea37cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d76acd9d4b8f4fc839b68fa2e84d8681 2x, https://si.imgix.net/b6c21931/uploads/origins/2749d3b0-d6c6-4fa4-8907-8514e3ea37cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb9a79982bcdbf0c1200909a17334c35 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3951578, "client_id": 909927, "nc": 0}, {"path": "/@SATO_0425_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3951578, "client_id": 3148333, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c0f7571/uploads/origins/02c5119c-dc72-4b27-b08e-202185a07bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=869c717e0eef751381e83ef80d851010", "srcset": "https://si.imgix.net/7c0f7571/uploads/origins/02c5119c-dc72-4b27-b08e-202185a07bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=869c717e0eef751381e83ef80d851010, https://si.imgix.net/7c0f7571/uploads/origins/02c5119c-dc72-4b27-b08e-202185a07bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ffd184391191bedd40614f3f072b977 2x, https://si.imgix.net/7c0f7571/uploads/origins/02c5119c-dc72-4b27-b08e-202185a07bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7aa65d4662df225c470435334d99f84 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c0f7571/uploads/origins/02c5119c-dc72-4b27-b08e-202185a07bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b9d5f4d5f0b10ffb13f8fac44070484", "srcset": "https://si.imgix.net/7c0f7571/uploads/origins/02c5119c-dc72-4b27-b08e-202185a07bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b9d5f4d5f0b10ffb13f8fac44070484, https://si.imgix.net/7c0f7571/uploads/origins/02c5119c-dc72-4b27-b08e-202185a07bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=55668dec615e2cdef78778a56903223e 2x, https://si.imgix.net/7c0f7571/uploads/origins/02c5119c-dc72-4b27-b08e-202185a07bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a9ab49f1fd64c4728a72107f310ac638 3x"}, "body": "お世話になっております。リクエスト失礼いたします！\n自分と友人のうちよそ百合を描いていただきたいです！（友人から許可を得ています）\nクトゥルフ神話TRPG「同じ空には昇れない。」の探索者で、恋人同士です。ゆうりから「僕たち結婚しようか」と伝えています。構図や表情はお任せですが、いちゃついていると嬉しいです！\n\n【Ballas=Etanity（バラス＝エタニティ）】\n女／217歳（人間換算21歳）／身長186cm\n黒髪ロングで鮮やかな赤のインナーカラー。\"ハイライトのない\"ジト目気味のつり目。一人称は「オレ」、二人称は「お前」、ゆうりを「ゆうり」と呼ぶ。\n適当に生きている人付き合いの薄い吸血鬼。お人好しな一面もある。性別を男に間違えられがちだが気にしていない。\n一途にゆうりを愛しており、とても大切に思っている。可愛いしかっこいいとも思っている。\nあまり自分の好きなものに興味がない為、基本的にゆうりに合わせる。\n「お前、こんなところでどうしたんだ？もう夜だぞ。迷子か？」\n「オレの名前？それ聞いてどうすんだよ。ほら、さっさと帰りな」\n\n【黒永ゆうり（くろなが ゆうり）】\n女／23歳／身長177cm\n白髪ポニーテール、金目のつり目。上下に一本ずつ下まつげがある。一人称は「僕」、二人称は「君」、バラスを「バラス」と呼ぶ。\n元子役で目立つことが好き。歌や踊り、演技が得意で、キザな言動で女の子をお姫様扱いする。バラスの優しいところが好きだけどいつも自分に合わせてくれるので、これじゃかっこよくない！と思っている。\n基本的にはバラスに対してもキザだがたまに素を見せる。\n「僕は黒永ゆうり。ふふっ、こんな場所で寝ちゃ体に悪いだろう。どうしたんだい？可憐なお嬢さん。」\n「バラス、僕は君の好きなものが知りたいんだけど。」\n\nゆうりはかっこつけようとして頑張ってる女の子で、バラスは天然でかっこいいしそれをかっこいいと思っていない女の子です。\n\n使用用途：鑑賞、相方への共有、Twitterへの投稿など\n\nご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1Xm0-fGDRtrfQPHw2XjryXklewmUywnmA?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SATO_0425_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3951578, "client_id": 4049944, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6feb84ea/uploads/origins/fb3d70fd-521e-4087-baf6-370d0b8c5cd5?bg=%23fff&auto=format%2Ccompress&fm=web