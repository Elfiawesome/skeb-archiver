\n\n【キャラデザインについての注意事項等】\n・デザイン元はクアッカワラビーです\n・ケモ耳のみあるタイプで、人間の耳はないです\n・目の下のハイライトはハートではなく葉っぱです\n・尻尾があります\n\n【使用用途】\n・座敷わらびさんにデータを送り、SNSやYoutubeでのプロモーション活動に使用していただく可能性があります。（その際固定ツイート内容についてもお伝えします）\n・その他、基本的に個人利用ですが、推し活としてアクスタなどの形にして写真等を投稿できたらと考えています（※グッズはあくまで非営利です）\n\nご検討いただけると幸いです。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1F3VsnPzy99w7HzScYrbtASd10pgXohpy?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Animal_0v0/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3449253, "client_id": 2939813, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66adb4ee/uploads/origins/5d2ccbf4-3b43-4c94-b108-3342ab6407aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19d3281255a91ef5761f28057ddbe61e", "srcset": "https://si.imgix.net/66adb4ee/uploads/origins/5d2ccbf4-3b43-4c94-b108-3342ab6407aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19d3281255a91ef5761f28057ddbe61e, https://si.imgix.net/66adb4ee/uploads/origins/5d2ccbf4-3b43-4c94-b108-3342ab6407aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7860d84c942e3f861231436b741e2a85 2x, https://si.imgix.net/66adb4ee/uploads/origins/5d2ccbf4-3b43-4c94-b108-3342ab6407aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=356cf1c0b00783e7b455ad36ffcbfa61 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66adb4ee/uploads/origins/5d2ccbf4-3b43-4c94-b108-3342ab6407aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22e7f32a81197a52165ae7c6a5f4d3ea", "srcset": "https://si.imgix.net/66adb4ee/uploads/origins/5d2ccbf4-3b43-4c94-b108-3342ab6407aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22e7f32a81197a52165ae7c6a5f4d3ea, https://si.