_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3896580, "client_id": 3834277, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/569aeb1f/uploads/origins/5be4c070-62a3-4fa9-963e-caebb6fcaf36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0053e3da7edebff87833e70a105b6cc", "srcset": "https://si.imgix.net/569aeb1f/uploads/origins/5be4c070-62a3-4fa9-963e-caebb6fcaf36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0053e3da7edebff87833e70a105b6cc, https://si.imgix.net/569aeb1f/uploads/origins/5be4c070-62a3-4fa9-963e-caebb6fcaf36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97274de305187c8396e8edc71e0902a4 2x, https://si.imgix.net/569aeb1f/uploads/origins/5be4c070-62a3-4fa9-963e-caebb6fcaf36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f53f18d2b546560ce6a34ee8d3137aa0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/569aeb1f/uploads/origins/5be4c070-62a3-4fa9-963e-caebb6fcaf36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7144aba0a2bfd6dc6b669c96048ed34b", "srcset": "https://si.imgix.net/569aeb1f/uploads/origins/5be4c070-62a3-4fa9-963e-caebb6fcaf36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7144aba0a2bfd6dc6b669c96048ed34b, https://si.imgix.net/569aeb1f/uploads/origins/5be4c070-62a3-4fa9-963e-caebb6fcaf36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=12c10f4ec3efd3aaf832aaf22160045e 2x, https://si.imgix.net/569aeb1f/uploads/origins/5be4c070-62a3-4fa9-963e-caebb6fcaf36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df06fa68c5bc0cb6ea4a30fbdb57d6e7 3x"}, "body": "茂木様\n\nvtuber準備中の牛使メイと申します。\nXでskeb募集中のポストを見かけ、メディア欄見せていただきました。\nミニキャラがとても可愛く、ぜひ活動で使用させていただきたいと思ったので、リクエストを送らせて