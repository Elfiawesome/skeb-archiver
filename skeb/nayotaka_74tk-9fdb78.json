68f7ad-9fa6-4cab-9719-b3f6f6273e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12984ab61d363f60b0c5e55ca0b2372f", "srcset": "https://si.imgix.net/a898b41e/uploads/origins/8268f7ad-9fa6-4cab-9719-b3f6f6273e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12984ab61d363f60b0c5e55ca0b2372f, https://si.imgix.net/a898b41e/uploads/origins/8268f7ad-9fa6-4cab-9719-b3f6f6273e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b772ede46278ef46fc81f346ea42564a 2x, https://si.imgix.net/a898b41e/uploads/origins/8268f7ad-9fa6-4cab-9719-b3f6f6273e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6748ff9275c6a80bb6742a6cd87ecac9 3x"}, "body": "こんにちはです。素敵なミニキャラに惹かれましたのでご依頼させていただきました。\nこの度はミラクルゲート所属のvtuber3人のイラストをお願いいたします。\n\n3人とも同じ構図でお願いします。\nパチンコのドル箱（赤色）にメダルか玉かは判別できない（灰色で丸いものがあるなぁ）くらいのものを持って喜んでいるイラストをお願いいたします。\n・きらりさんは歯を見せて笑顔\n・ぱいりんさんは口を閉じて笑顔\n・にじはさんは口を開けて笑顔\nでお願いしたいです。\nサイン・背景透過をレイヤーで変えられるPSDファイルをいただきたいです。\n上記のリクエストでモデルの方の配信内での使用、サムネイルの使用、ＳＮＳでの紹介が可能であれば承認よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1uIkSGd6HRgrJmm5jViBwaEiZMUaMKBhX", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nayotaka_74tk/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3896580, "client_id": 3834277, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/569aeb1f/uploads/origins/5be4c070-62a3-4fa9-963e-caebb6fcaf36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0053e3da7edebff87833e70a105b6cc", "srcset": "https://si.imgix.net/569aeb1f/uploads/origins/5be4c070-62a3-4fa9-963e-caebb6fcaf36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0053e3da7edebff87833e70a105b6cc, https://si.imgix.net/569aeb1f/uploads/origins/5be4c070-62a3-4fa9-963e-caebb6fcaf36?bg=%23fff&auto=