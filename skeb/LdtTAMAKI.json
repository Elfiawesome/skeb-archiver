0&h=200&s=d041092e66ec9fc255a445f454d7b0d3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1edfed62/uploads/origins/8317ae4b-932f-47f1-bd6d-5af38e926aee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e94a6db06fd7793f63dbcfaade689ea", "src_set": ""}, "body": "こんにちは、私はあなたのフタナリ作品がとても好きで、リクエストしたいのです。\n\nベルゼブブ（7 Mortal Sins X-tasy）とカリン（Blue Archive）とのクロスオーバー作品です。\n\nシチュエーションはどちらもフタナリで、かりんがベルゼバブにご褒美としてフェラチオで精液を口に射精するというものです。\n\nかりんはフェラチオで気持ちよくなり、イクのが止まらない。彼女はベルゼバブの頭を抱えて、ペニス全体をベルゼバブの喉の中に入れている。\n\nベルゼバブは大量の精液を飲み、彼女のフタナリペニスは勃起して濡れている。彼女の口は精液で少し溢れている。彼女のペニスの尿道は塞がれているので、無駄にイクことはできない。\n\nできれば睾丸には淫紋をつけてほしい。\n\nお読みいただきありがとうございました。\n\nhttps://drive.google.com/drive/folders/1zPKMSu_A6h1W5lwXPZKDt1vFD3y_oPrn?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@LdtTAMAKI/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2020366, "client_id": 1694143, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/655ce3de/uploads/origins/478b9bee-50d4-4dd4-947f-b7ec9af4c297?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1469744339527b8b2667bb569ef7809a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/655ce3de/uploads/origins/478b9bee-50d4-4dd4-947f-b7ec9af4c297?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cd14fcc252d9ec50d3e73336ab0215c", "src_set": ""}, "body": "ホロライブインドネシアのVtuber、紅葉オーリー https://imgur.com/a/IEcpufT を描いていただけませんか？\nそして私のキャラクター、GooGhoul: https://imgur.com/a/DDYldph\nGooGhoulはグーでいっぱいのグールです。頭には大きな穴が開いています。\n\nGooGhoulはOllieの前にひざまずいて欲しいです。\nグールはメイド服を着て、18インチのフタナリペニスをディープスロートしてご主人様のオリーにご奉仕する\nオリーはフランケンシュタインタイプのゾンビで、様々なペニスを装着することができます。\nGooGhoulはすでにOllieの精液を大量に飲んでいるので、このようにエプロンを上からかぶるとお腹が妊娠しているように見えるのです。\nhttps://twitter.com/lewdlemage/status/1444368310624268297\nGooGhoulはOllieの役に立って幸せです。\n\nオリーはこんな風にフォーマルなものを着るべきだ: https://imgur.com/a/tNqAZJY\nオリーはほとんど裸でもいいんですけどね\nOllieはGooGhoulの頭を強く掴み、エロティックな支配的な表情で彼女の喉の下にクンクンしている。\nOllie NSFW: https://imgur.com/a/rS8jrSl\n胸が平らで、お尻が大きくて、お腹が引き締まったオリーが好きです。\n\nhttps://virtualyoutuber.fandom.com/wiki/Kureiji_Ollie/Gallery", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 44648, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "棚から猫餅🔞", "screen_name": "mabo_guppue", "avatar_url": "https://pbs.twimg.com/profile_images/1759725671641935872/BNKPRIHk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/988848202467037184/1731572750/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 49}, {"id": 53179, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "照井聖 x1", "screen_name": "teruihijiri", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Ffe84a6ed-f0df-4883-bd07-1d8464c096a2.png&avatar=1", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "none", "accept_expiration_days": 7, "skills": [{"genre": "art"}], "nc": 177}, {"id": 281989, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "石炭", "screen_name": "sekitan_mmmm", "avatar_url": "https://pbs.twimg.com/profile_images/1776377108123758592/g9W8qyxJ.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_d