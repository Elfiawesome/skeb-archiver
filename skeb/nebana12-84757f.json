ーの参照は下のリンクにあります。\n全体的な雰囲気。クール、アーバン、サイバーパンク、廃墟の街で\n服装服装：ネオンイエローのハイライトが入った白い半袖ジャケットと、黒いアンダーシャツ。あなたのデザインに似たものはこちら：https://www.pixiv.net/en/artworks/84597435\nポーズ特に指定はありませんが、ご自由にどうぞ\nコメント私はあなたのアートとデザインスタイルがとても好きなので、あなたの好みに合わせて自由に追加、削除、調整してください。\n\nご検討いただきありがとうございました。\n\nhttps://drive.google.com/drive/folders/1-BDjb6dAdRrXO0LpBmmygEMCe_u3YslJ?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nebana12/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 434017, "client_id": 860314, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a0b8593/uploads/origins/71dac1b7-ba73-4e43-9ceb-6254ef0a8991?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a5905e47c55854852fb9c6886a92ebb", "srcset": "https://si.imgix.net/7a0b8593/uploads/origins/71dac1b7-ba73-4e43-9ceb-6254ef0a8991?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a5905e47c55854852fb9c6886a92ebb, https://si.imgix.net/7a0b8593/uploads/origins/71dac1b7-ba73-4e43-9ceb-6254ef0a8991?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=192510ffd9e237e732df5a6f5b3933d8 2x, https://si.imgix.net/7a0b8593/uploads/origins/71dac1b7-ba73-4e43-9ceb-6254ef0a8991?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca336796e3eff6cfe9c826b11da85a2c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a0b8593/uploads/origins/71dac1b7-ba73-4e43-9ceb-6254ef0a8991?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20f5e95a28402f9a9572b851b08b7308", "srcset": "https://si.imgix.net/7a0b8593/uploads/origins/71dac1b7-ba73-4e43-9ceb-6254ef0a8991?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20f5e95a28402f9a9572b851b08b7308, https://si.imgix.net/7a0b8593/uploads/origins/71