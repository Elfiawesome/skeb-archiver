n登場人物の詳細設定です：\nhttps://drive.google.com/drive/folders/1wn2uL1qAkiMOjN-pTaXYXvnbxAcogfbN\n\nもし下書きが残っていたら、ぜひ見てみたいです。\n絵を描いていただけるとありがたいです！気になるようでしたらキャンセルも可能です。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OGNGN_UC/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3405071, "client_id": 3139200, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b23eba24/uploads/origins/a3a9dfae-0c43-46ce-9c55-f6453ddb5465?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15a1be4c3f2ee6b7c53d8c03b0026f0f", "srcset": "https://si.imgix.net/b23eba24/uploads/origins/a3a9dfae-0c43-46ce-9c55-f6453ddb5465?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15a1be4c3f2ee6b7c53d8c03b0026f0f, https://si.imgix.net/b23eba24/uploads/origins/a3a9dfae-0c43-46ce-9c55-f6453ddb5465?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9b02fad9fcbd86408cf91a1b39875dc 2x, https://si.imgix.net/b23eba24/uploads/origins/a3a9dfae-0c43-46ce-9c55-f6453ddb5465?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66e73dd6cf00e3f6041a2c3ab9e02a71 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b23eba24/uploads/origins/a3a9dfae-0c43-46ce-9c55-f6453ddb5465?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c47a71165aad0a1f9834a770c99e0426", "srcset": "https://si.imgix.net/b23eba24/uploads/origins/a3a9dfae-0c43-46ce-9c55-f6453ddb5465?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c47a71165aad0a1f9834a770c99e0426, https://si.imgix.net/b23eba24/uploads/origins/a3a9dfae-0c43-46ce-9c55-f6453ddb5465?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7f7fa6db47775a1fa77a23022990617c 2x, https://si.imgix.net/b23eba24/u