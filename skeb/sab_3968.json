頼用」でお願いします\nヘアスタイルについては、以前描いていただいたように「髪を下ろしていただいて、『📕服装、③』のようなバンダナを額につけて」いただけると嬉しいです\n\n--------------------------------------\n\nもし可能でしたら、落書き程度で構いませんので2人のイラストを別枠で描いて頂きたいです(もちろんこちらは断っていただいても大丈夫です(*ᵕ ᵕ)\")\n\n大変わかりづらい説明、リンクで申し訳ございません\n金額等見合わなければ再度お送りさせていただきますのでどうぞ気兼ねなくよろしくお願いします\n\nhttps://lit.link/966coffee", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sab_3968/works/112", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/709640ad/uploads/origins/97ba8e37-363d-4fff-92e9-801024dcbba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e63560653e362477dffbc15990b0c11d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3095602, "client_id": 815076, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sab_3968/works/111", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d7aa4ca3/uploads/origins/05e95c44-4257-44fd-810d-7ea12950d489?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=768a9aba46b0fb65e83fc458269fe87b", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3095602, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sab_3968/works/110", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e2248ffc/uploads/origins/a605bfcc-17ad-47ab-9e9b-e80846952678?bg=%23fff&auto=format%2Ccompress&fm=webp&fit