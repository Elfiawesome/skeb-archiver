力な一面も持ち合わせたまさに混沌の化身である\nアスモさんを先生にぜひ描いていただきたいです。\n\nお忙しい中とは存じますが、ご一考の程お願いします。\n\nhttps://drive.google.com/drive/folders/1m0pcsC9d33CJGD0MIjTNNkT0fRlGe1ya", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2231055, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "彩藤ありさ", "screen_name": "ww0_eq00", "avatar_url": "https://pbs.twimg.com/profile_images/2065076724069744640/MvulmtYz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1515239524128813061/1782481447/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 2620286, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "いかわさ🦑(チゲ味)", "screen_name": "Midori_annte23", "avatar_url": "https://pbs.twimg.com/profile_images/1772462509385269248/3WO5dS3i.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1288136668696809473/1711452276/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 110, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 3393250, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "国産りんご。", "screen_name": "ringooooo0619", "avatar_url": "https://pbs.twimg.com/profile_images/2006730461473906688/AsA6kJp3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1748660868181880832/1734232345/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expirati