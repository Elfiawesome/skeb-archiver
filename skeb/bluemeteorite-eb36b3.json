t=crop&crop=top&w=200&h=200&blur=200&s=07554290d54970bbeccd5486e64bc3e6 2x, https://si.imgix.net/00cd6c8c/uploads/origins/886a4d4d-b2bd-410e-a1e7-89c89318b1da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=005fdb5d72a168d1e4214e14b53aca87 3x"}, "body": "Yashimaさん、こんにちは。\n私はあなたのロボ娘の大ファンです（私のお気に入りはPPXちゃんです）\nあなたのアートスタイルは古典的なメカアニメを懐かしくさせます\n\n変なお願いなんですが、メイド服を着たタクティカルドールのイラストをお願いできますか？ それともメイドをテーマにしたタクティカルドール？\n\nメイド服は布製でもいいですし、鎧をメイド服風にデザインしてもいいので、お好みでどうぞ！\n\nありがとう！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bluemeteorite/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2613213, "client_id": 19342, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2dd33575/uploads/origins/477e2d61-c0e7-4d65-96c6-a1b5869a22df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b7f2a52d2d792e16d5ee2214c02c4f6", "srcset": "https://si.imgix.net/2dd33575/uploads/origins/477e2d61-c0e7-4d65-96c6-a1b5869a22df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b7f2a52d2d792e16d5ee2214c02c4f6, https://si.imgix.net/2dd33575/uploads/origins/477e2d61-c0e7-4d65-96c6-a1b5869a22df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cdc7f71370330abea18a086690650c31 2x, https://si.imgix.net/2dd33575/uploads/origins/477e2d61-c0e7-4d65-96c6-a1b5869a22df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e97ad35b6f532f0ae0e78ff01402862 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2dd33575/uploads/origins/477e2d61-c0e7-4d65-96c6-a1b5869a22df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1724ced4030e4f23e337443a4af971f3", "srcset": "https://si.imgix.net/2dd33575/uploads/origins/477e2d61-c0e7-4d65-96c6-a1b5869a22df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1724ced4030e4f23e337443a4af971f3, https://si.imgix.net/2dd33575/uploads/origins/477e2d61-c0e7-4d65-96c6-a1b5869a22df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c24544e4165c5af79c9c7f2494987a94 2x, https://si.imgix.net/2dd33575/uploads/origins/477e2d61-c0e7-4d65-96c6-a1b5869a22df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8ceedcfa6ba6f52cf567e3cec2d22a24 3x"}, "body": "お久しぶりです、以前描いて頂いた架空の広告がとても素敵でその際に描いて頂いた限定モデルの娘もドストライクだったため是非またお願いしたく思いました。\n\n今回もタイプワンを題材にしたものなのですが、購入ガイドやパンフレットであった構造、材質、モデルの紹介等を行っていたページがとても魅力的なのでそういった方向の作品を見たく思いリクエストを送らせて頂きました。\n内容については、例えばタイプワンの大幅のモデルチェンジを振り返った「歴代モデル：〇代目タイプワン（X年ーY年）」などを想像しているのですが、正直自分ではあまりアイディアが出ないのでYASHIMAさんが今、もしくは将来、タイプワンのパンフレットや購入ガイドといったコンセプトの作品を作った際に入れるページの一つといったイメージで（自分が上記に書いた例には構わず）自由に描いて頂きたく思います。そして可能であればそのページに登場するタイプワン（もしくはそのうちの一機）を前回のSkebで描いて頂いた限定モデルの娘（非同一個体でもOKです）で描いて頂ければ嬉しいです！\n\nいつもありがとうございます、\nよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bluemeteorite/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2613213, "client_id": 2626349, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/efaa6a52/uploads/origins/643e4cb8-1387-4a3e-8452-edff1cb46018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7184d13b5059657ce7374367d5939e3c", "srcset": "https://si.imgix.net/efaa6a52/uploads/origins/643e4cb8-1387-4a3e-8452-edff1cb46018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7184d13b5059657ce7374367d5939e3c, https://si.imgix.net/efaa6a52/uploads/origins/643e4cb8-1387-4a3e-8452-edff1cb46018?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca120a9db1cba36b30d6fb86a485dab4 2x, https://si.imgix.net/efaa6a52/uploads/origins/643e4cb8-1387-4a3e-8452-edff1cb46018?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77eb2f0b5614fb1ab11fb09b6493180c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/efaa6a52/uploads/origins/643e4cb8-1387-4a3e-8452-edff1cb46018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a09dd4523d7ed867277512371447ed44", "srcset": "https://si.imgix.net/efaa6a52/uploads/origins/643e4cb8-1387-4a3e-8452-edff1cb46018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a09dd4523d7ed867277512371447ed44, https://si.imgix.net/efaa6a52/uploads/origins/643e4cb8-1387-4a3e-8452-edff1cb46018?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=30ba3a79676e4d383bfffadd8dea8e70 2x, https://si.imgix.net/efaa6a52/uploads/origins/643e4cb8-1387-4a3e-8452-edff1cb46018?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d03b14d0e50f3033fa4ed4f8c302ade4 3x"}, "body": "はじめまして。\nアンドロイドタイプワンのイラストをお願いしたくリクエストを送ります。\nタイプワンがどうしてもイメージできないのでオーナーのイメージから想像でお願いします。\n30歳くらいの女性オーナーで休日はバイクで都会の喧騒を離れた所に日帰りツーリングが趣味。\n家事用にタイプワンを購入したら意外と話が弾むのでタイプワンを後部座席に載せてツーリングするようになる。\n人と機械だしそう造られているからだけどいろんな風景とかみて会話とか経験を共にしてなんとなく心が触れ合うような感じがしている。\nオーナーがそう感じるようなタイプワンをできるようでしたらお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bluemeteorite/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2613213, "client_id": 19342, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/958b4ea1/uploads/origins/394e0e44-58f9-4b31-ba1e-5bc4bf861222?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e64e91c018aecae83943526a455db58c", "srcset": "https://si.imgix.net/958b4ea1/uploads/origins/394e0e44-58f9-4b31-ba1e-5bc4bf861222?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e64e91c018aecae83943526a455db58c, https://si.imgix.net/958b4ea1/uploads/origins/394e0e44-58f9-4b31-ba1e-5bc4bf861222?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48eb3556e93d43882328a14a96bdeef2 2x, https://si.imgix.net/958b4ea1/uploads/origins/394e0e44-58f9-4b31-ba1e-5bc4bf861222?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40990c0decd28ccca07c6639baff4ac0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/958b4ea1/uploads/origins/394e0e44-58f9-4b31-ba1e-5bc4bf861222?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e87545feebedd6792020e7eeef9e813d", "srcset": "https://si.imgix.net/958b4ea1/uploads/origins/394e0e44-58f9-4b31-ba1e-5bc4bf861222?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e87545feebedd6792020e7eeef9e813d, https://si.imgix.net/958b4ea1/uploads/origins/394e0e44-58f9-4b31-ba1e-5bc4bf861222?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a4cc48f4539907a9ca0f5c264750214c 2x, https://si.imgix.net/958b4ea1/uploads/origins/394e0e44-58f9-4b31-ba1e-5bc4bf861222?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=92c01656b6bce5c49fb058b141a7ee0b 3x"}, "body": "お久しぶりです、Skebを開いたらYASHIMAさんの名前があり驚きました！\n漫画も大好きですが是非YASHIMAさんの描く購入ガイドや宣伝材料のようなタッチのアンドロイドタイプワンの絵をまた見たく思いリクエストを送らせて頂きました。\n\n限定生産カラーのタイプワンを漫画一巻の店舗でディスプレイされている様なイメージ、若しくはオーナーにより起動されて間もない状態のイメージで見たく思います。\nこの限定生産カラーはパンフレットに登場するソルベカラー（パステルオレンジとブルー）を想像しているのですが、他にも未登場の限定生産カラーがありましたらそちらでもオッケーです！\nウィッグと衣服のコーディネートが稼働に干渉しない事をアピールする動態ディスプレイの様なイメージのイラストやオーナーとおめかしを楽しんでいるようなイラストだと嬉しいですが、基本購入ガイドやパンフにあるような現実感のあるイラストでありファッションカスタマイズ的要素があれば他のシチュエーションでも大丈夫です！\n\nあと可能であれば購入ガイドやパンフレットにある「タイプワンについて」や「注意事項」の様な世界観を深めるテキストがあるととても嬉しいです！\n\n素敵な作品をありがとうございます、応援しています！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bluemeteorite/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2613213, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/023e2b58/uploads/origins/ddea9d48-3612-48c9-93a0-273c96f50aa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7f1270dcb5d0e523a33b07d926f10c4", "srcset": "https://si.imgix.net/023e2b58/uploads/origins/ddea9d48-3612-48c9-93a0-273c96f50aa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7f1270dcb5d0e523a33b07d926f10c4, https://si.imgix.net/023e2b58/uploads/origins/ddea9d48-3612-48c9-93a0-273c96f50aa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a98a39b181d882231a58b72785b549e 2x, https://si.imgix.net/023e2b58/uploads/origins/ddea9d48-3612-48c9-93a0-273c96f50aa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d456ef3fcd0ab63aed17fc8539f1be36 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/023e2b58/uploads/origins/ddea9d48-3612-48c9-93a0-273c96f50aa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae1feeaa47ad5b81f8adc41a3f76e3fa", "srcset": "https://si.imgix.net/023e2b58/uploads/origins/ddea9d48-3612-48c9-93a0-273c96f50aa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae1feeaa47ad5b81f8adc41a3f76e3fa, https://si.imgix.net/023e2b58/uploads/origins/ddea9d48-3612-48c9-93a0-273c96f50aa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=03762a671f1291981ae5901da64e45f6 2x, https://si.imgix.net/023e2b58/uploads/origins/ddea9d48-3612-48c9-93a0-273c96f50aa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f2543c1b0215f115fd1a9805f27c2011 3x"}, "body": "始めまして、もしくはお久しぶりです。\n匿名でのリクエストをお許し下さい、10年前にアリスブックスさんから購入ガイドとパンフレットを購入させて頂いて以来ずっとYASHIMAさんの世界観に影響されてきましたカナダ人です。\n今回SKEBでYASHIMAさんを発見して何をお願いしていいのか分からないまま何かリクエストせねばという使命感に駆られてしまいました…！\n\nいきあたりばったりなのですが、可能であれば自分のキャラクターをYASHIMAさんの描くタイプワンを通して表現していただければと思っています。もちろんキャラクターとしてのつながりはまったくなく偶然外見のカスタマイズや衣装が似たタイプワンといった設定で大丈夫です。\n\n自分が一年近く前に描いた拙い絵なのですが、資料URLに添付させて頂きました、もし可能であれば似た外見特徴とファッションのタイプワンをお願いしたく思います。\n特徴としては赤オレンジの髪をヘアボンボンでショートツインに纏めている、猫っぽい印象を与える目といった要素さえ残っていれば自由にアレンジして頂いて構いません。\nYASHIMAさんに自分とつながりのある何かを書いて頂けるという事が何よりもの喜びなので極論こちらのキャラクターでなくても大丈夫です。\n\nシチュエーションや構図などはおまかせしたく思うのですが、架空の宣伝ポスターのような印象の正面からのイラスト（ノイと同系統の2056年アニバーサーリーモデルのイラストやコミティア113のポスター、通信販売の告知イラスト、…etc.）といった方向性だと嬉しいです。\n\n今回は変なリクエストになってしまいすみません。\nいつも応援しております。\n\nhttps://www.pixiv.net/artworks/96362156", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 110701, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "伊於🌵【6/5(金)】ﾜﾝｵﾍﾟ解雇⑤巻発売【6/7(日) ｺﾐﾃｨｱ156】も12a", "screen_name": "io_xxxx", "avatar_url": "https://pbs.twimg.com/profile_images/1557944337228779520/dz2vSrNG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/123593461/1762169733/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "comic"}, {"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 1}, {"id": 129755, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "A丸", "screen_name": "a_circle10", "avatar_url": "https://pbs.twimg.com/profile_images/1507403461947969539/0tPvtnhc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1136037748890980352/1688907260/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_day