folders/1umL6bP_qJsYGhPLdkkSpP8bRMCBOUqkK\n\n※三つ目の資料は数が多すぎるので全然見なくても大丈夫です。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moyoyoism/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3837120, "client_id": 3855680, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2e01df8f/uploads/origins/2b57a337-22f7-4421-b263-4fd2f1f61b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bc8982bb975c50240a800ae4acb9e76", "srcset": "https://si.imgix.net/2e01df8f/uploads/origins/2b57a337-22f7-4421-b263-4fd2f1f61b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bc8982bb975c50240a800ae4acb9e76, https://si.imgix.net/2e01df8f/uploads/origins/2b57a337-22f7-4421-b263-4fd2f1f61b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=637df640ad315df830bd1ea51d52d6b1 2x, https://si.imgix.net/2e01df8f/uploads/origins/2b57a337-22f7-4421-b263-4fd2f1f61b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1ebc4a02dbd9f18d8c7d2c7c70aee79 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e01df8f/uploads/origins/2b57a337-22f7-4421-b263-4fd2f1f61b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6142228464aaa33c9a8f087c3641508f", "srcset": "https://si.imgix.net/2e01df8f/uploads/origins/2b57a337-22f7-4421-b263-4fd2f1f61b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6142228464aaa33c9a8f087c3641508f, https://si.imgix.net/2e01df8f/uploads/origins/2b57a337-22f7-4421-b263-4fd2f1f61b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6816cc0c83b11f5c6990bcce1b7a6c20 2x, https://si.imgix.net/2e01df8f/uploads/origins/2b57a337-22f7-4421-b263-4fd2f1f61b7b?bg=%23fff&auto=format%2Ccompres