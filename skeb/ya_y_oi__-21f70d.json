を着せてほしいです。   着ぐるみの見た目は資料を 参考に描いていただければ幸いです  シチュエーションとしては 真夏の短期バイトとして遊園地のバイトを 申し込んだ2人 裏方作業の仕事をやるはずが 着ぐるみの従業員2人が急遽 来れなくなってしまい 偶然着ぐるみを着れそうなのが 三玖ちゃんと四葉   着ぐるみを着て 小さい子供（女の子）に 風船を配ったりハグしてあげる 三玖ちゃんと四葉ちゃん  休憩時間にて控え室で 着ぐるみの頭部を外す 三玖ちゃんと四葉ちゃん 真夏の着ぐるみのお仕事で 汗が大量に出ていて ムレムレした状態  セリフや細かいところなどは 主さんにお任せします！ 男キャラは描かないようお願いします。  なにとぞよろしくお願いします！\n\nhttps://skeb.jp/@saretaka_illust/works/1\n\nhttps://skeb.jp/@RideArk/works/39", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ya_y_oi__/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3079339, "client_id": 2657403, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3fbc1ee0/uploads/origins/dff2763c-c4c9-4ef5-8ae9-b2e696ad50a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfc034522ec0ff9b53014f84b2e0bd46", "srcset": "https://si.imgix.net/3fbc1ee0/uploads/origins/dff2763c-c4c9-4ef5-8ae9-b2e696ad50a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfc034522ec0ff9b53014f84b2e0bd46, https://si.imgix.net/3fbc1ee0/uploads/origins/dff2763c-c4c9-4ef5-8ae9-b2e696ad50a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=daf63ee0e12a32c3abc866e9e23c5b2e 2x, https://si.imgix.net/3fbc1ee0/uploads/origins/dff2763c-c4c9-4ef5-8ae9-b2e696ad50a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=861bad8fa6764d1f3c68d4f0f291bbf2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3fbc1ee0/uploads/origins/dff2763c-c4c9-4ef5-8ae9-b2e696ad50a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dee22d3e9219e4ccf87aa91cd91a6e8f", "srcset": "https://si.imgix.net/3fbc1ee0/uploads/origins/dff2763c-c4c9-4ef5-8ae9-b2e696ad50a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dee22d3e9219e4ccf87aa91c