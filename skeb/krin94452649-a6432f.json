n\n■シチュなど\nおまかせします。\n九九日様の素敵なお洋服のデザインもとても好きなので、特に記載のない点については、お好みの解釈で自由に描いて頂けたら嬉しいです。\n\nもし指定が必要でしたら、\n\n・ぽやっとかわいい感じ or おすましでミステリアスな感じ\n\n…でお願いします。\n\n■用途\n個人観賞用ですが、他の依頼の際に参考イメージとして使用する場合があります。\nもし条件と合わなければ、お気軽にキャンセルして下さい。\n\nご縁がありましたら、どうぞよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1QwFvhSHjG6uVAIEf2MyN6OuuNsXZMB1_?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@krin94452649/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2918591, "client_id": 2242039, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0278a16/uploads/origins/57920a14-2e17-4404-b135-8779f2b272c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25aa1c0e622c3f49eb1b294ad3e6c1b0", "srcset": "https://si.imgix.net/d0278a16/uploads/origins/57920a14-2e17-4404-b135-8779f2b272c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25aa1c0e622c3f49eb1b294ad3e6c1b0, https://si.imgix.net/d0278a16/uploads/origins/57920a14-2e17-4404-b135-8779f2b272c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f7f614f011d03c10030ffa0ddb2e391 2x, https://si.imgix.net/d0278a16/uploads/origins/57920a14-2e17-4404-b135-8779f2b272c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9fff53a0367ec0a08aa4ea638eae95fd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0278a16/uploads/origins/57920a14-2e17-4404-b135-8779f2b272c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98f8a3d5b077dc609b37e5af9095c632", "srcset": "https://si.imgix.net/d0278a16/uploads/origins/57920a14-2e17-4404-b135-8779f2b272c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98f8a3d5b077dc609b37e5af9095c632, https://si.imgix.net/d0278a16/uploads/origins/57920a14