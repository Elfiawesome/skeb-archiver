&h=200&s=00d67526ab955bf0724ffc62135bcfcb 2x, https://si.imgix.net/cf6a8510/uploads/origins/542af39b-b203-421c-b52e-49e33908d945?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09f18c8809a98a8059d107ccb9e59c57 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf6a8510/uploads/origins/542af39b-b203-421c-b52e-49e33908d945?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43d1aa16aad770fba1db2ebca980de2d", "srcset": "https://si.imgix.net/cf6a8510/uploads/origins/542af39b-b203-421c-b52e-49e33908d945?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43d1aa16aad770fba1db2ebca980de2d, https://si.imgix.net/cf6a8510/uploads/origins/542af39b-b203-421c-b52e-49e33908d945?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f83241c16d5c1b0aaa14e578060274f0 2x, https://si.imgix.net/cf6a8510/uploads/origins/542af39b-b203-421c-b52e-49e33908d945?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe692164b2b71b771caf2635e6f86c93 3x"}, "body": "こんにちは！イラストを沢山見させてもらっております！\nあなたのOCキャラがすごく可愛かったので、特に自分が好きなキキちゃんとヨミくんのイラストを依頼したいなと思います。\n\n1枚目は、キキちゃんが「長い舌見ていい？」ってお願いして、ヨミくんが快くOKしてすごく長い舌を勢いよく出す感じです。\n2枚目はキキちゃんが長い舌を遠慮なくぷにぷに触りまくって、ヨミくんが笑いながらもちょっとだけ恥ずかしそうにしてる感じでお願いします。\n長い間舌を出してるので、舌の先からはよだれがちょっとずつ垂れちゃってる感じだと嬉しいです。\n\nよろしくお願いいたします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nobebosandayo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2555638, "client_id": 629765, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/773e4e4a/uploads/origins/83da2889-fc74-430d-bde4-bb9de8ae9915?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06be6abd37233db9395260daba873caa", "srcset": "https://si.imgix.net/773e4e4a/uploads/origins/83da2889-fc74-430d-bde4-bb9de8ae9915?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06be6abd37233db9395260daba873caa, https://si.imgix.net/773e4e4a/uploads/origins/83da2889-fc74-430d-bde4-bb9de8ae9915?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e38972a2642d98e655f989e3afde6589 2x, https://si.imgix.net/773e4e4a/uploads/origins/83da2889-fc74-430d-bde4-bb9de8ae9915?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80f2d4ff34779242b00e3375e0a669f8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/773e4e4a/uploads/origins/83da2889-fc74-430d-bde4-bb9de8ae9915?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=616044706582de06412af1c011e0924b", "srcset": "https://si.imgix.net/773e4e4a/uploads/origins/83da2889-fc74-430d-bde4-bb9de8ae9915?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=616044706582de06412af1c011e0924b, https://si.imgix.net/773e4e4a/uploads/origins/83da2889-fc74-430d-bde4-bb9de8ae9915?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=55a2b53509627048628fee3705c78f27 2x, https://si.imgix.net/773e4e4a/uploads/origins/83da2889-fc74-430d-bde4-bb9de8ae9915?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=292849fab0ce4f0a8f7cfe994e53a759 3x"}, "body": "ノベボー様\nお疲れ様です。星ぶどうです。\nノイちゃんがおくちを大きく開いて、ギザ歯をベルにぇに見せてるイラストをお願いします。\n差分その1（普通のイラスト）\nベルにぇに、｢ギザ歯見せてー｣って言われて、ノイちゃんが綺麗な歯並びを見せてくれます。奥歯はギザギザで大きめだと嬉しいですね。上の歯も下の歯も見せてください！👀\n差分その2\nベルにぇに｢ムシ歯あるの〜？｣って言われて、ノイちゃんがうっかり治療した詰め物を見せちゃうシチュをお願いします。\n痛まないレベルの軽いムシ歯も見つかっちゃう感じだと嬉しいです。\n差分その3\n歯医者通いしているノイちゃんが、興味津々なベルにぇにムシ歯をみせちゃうシチュをお願いします。ムシ歯の酷さはお任せしますし、妄想オチ夢オチでもOKです！？\n限界依頼ですが、良ければよろしくお願いします🍇", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nobebosandayo/works/4", "private_th