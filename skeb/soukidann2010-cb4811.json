ient_id": 93299, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8574ec35/uploads/origins/4d138fdf-8a0a-4e32-92b4-51f53142d5d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=308a13cb2f10909a3cd8b1b8d966d6f8", "srcset": "https://si.imgix.net/8574ec35/uploads/origins/4d138fdf-8a0a-4e32-92b4-51f53142d5d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=308a13cb2f10909a3cd8b1b8d966d6f8, https://si.imgix.net/8574ec35/uploads/origins/4d138fdf-8a0a-4e32-92b4-51f53142d5d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b03272d0369b086f604487861ac89c0 2x, https://si.imgix.net/8574ec35/uploads/origins/4d138fdf-8a0a-4e32-92b4-51f53142d5d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c29ca4b5926cde3f96bc1e0754d37af0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8574ec35/uploads/origins/4d138fdf-8a0a-4e32-92b4-51f53142d5d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6011f6e8fbfa1d4396154e23eb17d03", "srcset": "https://si.imgix.net/8574ec35/uploads/origins/4d138fdf-8a0a-4e32-92b4-51f53142d5d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6011f6e8fbfa1d4396154e23eb17d03, https://si.imgix.net/8574ec35/uploads/origins/4d138fdf-8a0a-4e32-92b4-51f53142d5d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5998bacf562b056cf1cbe0d1fb311689 2x, https://si.imgix.net/8574ec35/uploads/origins/4d138fdf-8a0a-4e32-92b4-51f53142d5d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=00cf4eff058471f79a5c45ddac4284a0 3x"}, "body": "恐縮ですが、以前描かれていたこちら(https://x.com/soukidann2010/status/1680970028135616512?s=46&t=7ZthkWPVJZaDXgLcKh6AKA)の漫画の敵キャラ淫魔の、えっちをしつつも主導権を握りきれずに倒されてしまうような描写がとても可愛く感じましたので、似た雰囲気のイラストをお願いしたいです！\n\nリクエスト用にデザインいただいたキャラクターでのリクエストになります。\n\n【概要】\nキャラクターが、搾精しようとセックスしているものの、感じさせられて追い詰められているイラスト\n\n以下、細かい指定になります。\n【キャラ設定想定】\n・精を求めて人を襲うサキュバス\n・明るさや包容力を魅力(武器)としている\n\n【構図・ポーズ】\n・キャラの表情が見える形の構図・ポーズ\n\n【キャラ】\n・眉八の字で口角の上がらない、性的に感じている表情\n・頬染め\n\n【その他】\n竿役は、性器のみなどごく簡素な描写で構いません。体型が分かる形で描写する場合は、「射精した回数分─」のアルバロくんに近い体型でお願いします。\n\n【キャラクター資料】\nhttps://x.com/dodontata/status/1695446530885665068?s=46&t=7ZthkWPVJZaDXgLcKh6AKA", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@soukidann2010/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c9172245/uploads/origins/9371276e-1dd0-4ae1-9cc1-a84b6a2ada68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6fb96f80a63416d18d853d8208d1922b", "srcset": "https://si.imgix.net/c9172245/uploads/origins/9371276e-1dd0-4ae1-9cc1-a84b6a2ada68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6fb96f80a63416d18d853d8208d1922b, https://si.imgix.net/c9172245/uploads/origins/9371276e-1dd0-4ae1-9cc1-a84b6a2ada68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=08ef65b07be27cd26a56b84ef2714a5c 2x, https://si.imgix.net/c9172245/uploads/origins/9371276e-1dd0-4ae1-9cc1-a84b6a2ada68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=24b5953c421c7b6fe21ada6c883dcf34 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 381190, "client_id": 90534, "nc": 177}, {"path": "/@soukidann2010/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2cc7c853/uploads/origins/03d7adb8-1917-40a6-886b-951583d86582?bg=%23fff&auto=fo