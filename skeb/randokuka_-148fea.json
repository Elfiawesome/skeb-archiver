ress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cfb51f7a0888cc369af891b8ce73f6de 3x"}, "body": "skeb開設おめでとうございます。\nもうゲームはやられてないとのことですが、宜しければご検討下さい。\nミストトレインガールズのフィンチリー教官をお願いします。\nhttps://misttraingirls.wikiru.jp/index.php?plugin=attach&refer=%E3%83%95%E3%82%A3%E3%83%B3%E3%83%81%E3%83%AA%E3%83%BC&openfile=%E3%83%95%E3%82%A3%E3%83%B3%E3%83%81%E3%83%AA%E3%83%BC.png\n\n先年の9月16日にタイシェトの背中に乗って腕立てをさせているイラストを描いて頂きましたがあのフィンチリー教官のお尻の柔らかそうな感じはとても良かったです。\nあの流れでの、車掌も尻の下に敷いて腕立てさせているものをお願いしたいです。\n\n上記イラストでは斜め後ろから見た感じでしたが、今回は正面からでお願いします。\nフィンチリーとしては車掌に多少の情もあるので流れで腕立てさせたものの(重くないか？大丈夫だろうか)と心配しているような感じで。\n車掌については特に資料がありませんので、必要最低限(もしくはご自由に)描いて頂ければと思います。\n宜しくご検討下さい。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 510148, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "みずの", "screen_name": "okn66_3z", "avatar_url": "https://pbs.twimg.com/profile_images/1522535125866921985/aU59msOy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1081279104547082240/1576669805/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 756741, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "うー玉ᙏ̤̰", "screen_name": "331ab31", "avatar_url": "https://www.gravatar.com/avatar/?d=identicon", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 161}, {"id": 2104164, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "瑠璃たては✒️🦋",