る交易品として。\n\n等々。\n\nコーヒーもカップなのか紙コップなのか、缶コーヒーなのか。はたまた瓢箪にコーヒー！？なのか。無重力空間で中空に浮かぶ球体かもしれません。中身もブラックからもこもこにデコられたラテまで、いろんな種類があります。\n\nシチュエーションは色々あるかと思いますが、お任せします。長々と書いてはいますが、好みの状況で描いていただけたらと思います。性別、種族（生物／非生物）、構図、小物の有無等問いません。\n描いていただいた絵を何かに使う予定はありません。こんな絵を描いてもらいました、と紹介する程度になるかと思います。\nよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1241388, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "蝉", "screen_name": "_se_mi__", "avatar_url": "https://pbs.twimg.com/profile_images/1254720661215277056/MvuX5gW5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1247651285379108864/1753621495/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "comic"}, {"genre": "art"}, {"genre": "correction"}], "nc": 177}, {"id": 2825887, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "𝙋𝘼𝙉𝙂𝙀𝘼@skeb募集中", "screen_name": "A_hyperbius", "avatar_url": "https://pbs.twimg.com/profile_images/1911433584600031232/6sOt4t_c.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1677531149617500160/1748514966/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 176}, {"id": 3199799, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "koharu🌸skeb募集中", "screen_name": "koharunoillust", "avatar_url": "https://pbs.twimg.com/profile_images/1970760721643511813/irHzDeiU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1432638257100038147/1759159988/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": nul