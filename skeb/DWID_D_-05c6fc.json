かけられながらだとなおいい)\nメリーは普段の服装で蓮子は局部の見えない程度の半脱ぎがいいですが、それ以外でもokです。NSFW一応有効にしておきますが、一般的な意味でのR-18じゃなくてもokです。\nジャンルはコミック指定しましたがイラスト形式(1コマ)でもokです。出来たらセリフは入れて頂けると嬉しいです。純粋なイラストというよりは漫画の1コマ的な感じで。\n\n以上が指示となりますが、作画上、表現上変えたい部分があれば変更して頂いて全く構いません。依頼を受けて下さるようでしたら先生に解釈されたメリ蓮を楽しみにしています。\n\np.s.\n劣等種と暁闇を読ませて頂きました。テーマが明確で非常に強い印象の残る二作でした。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DWID_D_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 430965, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d92a1a2/uploads/origins/4b281f68-67ca-4061-b1b0-6d79b24a04c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f91e6bf45e1626871e5df9847e0bcd3f", "srcset": "https://si.imgix.net/0d92a1a2/uploads/origins/4b281f68-67ca-4061-b1b0-6d79b24a04c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f91e6bf45e1626871e5df9847e0bcd3f, https://si.imgix.net/0d92a1a2/uploads/origins/4b281f68-67ca-4061-b1b0-6d79b24a04c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e7555c7f6213583c46d31185bc2ab15 2x, https://si.imgix.net/0d92a1a2/uploads/origins/4b281f68-67ca-4061-b1b0-6d79b24a04c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e6b34c7a427a633209b56a0717663bf 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d92a1a2/uploads/origins/4b281f68-67ca-4061-b1b0-6d79b24a04c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7f021417d1c62d9a95f81a3618eaef1", "srcset": "https://si.imgix.net/0d92a1a2/uploads/origins/4b281f68-67ca-4061-b1b0-6d79b24a04c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7f021417d1c62d9a95f81a3618eaef1, https://si.imgix.net/0d92a1a2/uploads/origins/4b281f68-67ca-4061-b1b0-6d79b24a04c7?bg=%23fff&auto=format%