099053568\n\n\nお忙しいところ恐縮ですが、お引き受けくださるかご検討くださると幸いです。\nどうぞよろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1p-CjcjdeNrm09if9rwP6Hyn4XPbSsIKA?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pit_eno/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2796985, "client_id": 2861821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e8dd599/uploads/origins/98aeed24-f60d-4874-8e53-493356f0ab4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fcb6c2f0db07e9400a953aced19d358", "srcset": "https://si.imgix.net/6e8dd599/uploads/origins/98aeed24-f60d-4874-8e53-493356f0ab4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fcb6c2f0db07e9400a953aced19d358, https://si.imgix.net/6e8dd599/uploads/origins/98aeed24-f60d-4874-8e53-493356f0ab4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6e6a3d919fec14271c5e274723e68dc 2x, https://si.imgix.net/6e8dd599/uploads/origins/98aeed24-f60d-4874-8e53-493356f0ab4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e6e356137deaf761522faba1463720d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e8dd599/uploads/origins/98aeed24-f60d-4874-8e53-493356f0ab4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=549af266beab9c0d844bfe9c835dc2f7", "srcset": "https://si.imgix.net/6e8dd599/uploads/origins/98aeed24-f60d-4874-8e53-493356f0ab4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=549af266beab9c0d844bfe9c835dc2f7, https://si.imgix.net/6e8dd599/uploads/origins/98aeed24-f60d-4874-8e53-493356f0ab4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8adf10d55da39cb13a2fee1155cba697 2x, https://si.imgix.net/6e8dd5