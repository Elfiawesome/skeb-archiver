意志の体現で、魔法少女が変身した後の衣装に似ている。\n表面上は親切な人だが、本質的には彼女は自分と関係のない人を気にせず、家族だけを気にしている。医者になることを選んだのは趣味のためで、善意からではない。\n社交仮面を離れた後、正体は冷酷で傲慢な騎士です、常に自己を閉ざした囚人（姉）のそばを守り、彼女を見守り、導く。\n\n具体的な構図と内容は君に任せる！\n\n最終作品はPSDで提出をお願いしたいのですが、下書きとデザインのアイデアを追加できれば嬉しいです！なくても大丈夫です。\n内容や金額に問題があれば、再送が可能かと思います。何か不合理な点があれば、お断りしていただいても結構です。ありがとう。\n\nhttps://drive.google.com/drive/folders/10KqhvlSSHOo8MhG2ul41hzdnxtVesweb", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ananasso696/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3772150, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a4339fa/uploads/origins/9ca6366d-5e10-423b-ac06-884f5899dd70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f252f15fd0d80f4ba98fde5afd28e6e5", "srcset": "https://si.imgix.net/5a4339fa/uploads/origins/9ca6366d-5e10-423b-ac06-884f5899dd70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f252f15fd0d80f4ba98fde5afd28e6e5, https://si.imgix.net/5a4339fa/uploads/origins/9ca6366d-5e10-423b-ac06-884f5899dd70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c44652553e82549dcb03722aad8ad78 2x, https://si.imgix.net/5a4339fa/uploads/origins/9ca6366d-5e10-423b-ac06-884f5899dd70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aedeef7436a767850c0d46e38fa66c6f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a4339fa/uploads/origins/9ca6366d-5e10-423b-ac06-884f5899dd70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=270ab1f6573ab8dd6e2211ffc584d107", "srcset": "https://si.imgix.net/5a4339fa/uploads/origins/9ca6366d-5e10-423b-ac06-884f5899dd70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=270ab1f6573ab8dd6e2211ffc584d107, https://si.imgix.net/5a4339fa/uploa