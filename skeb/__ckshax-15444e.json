前「南野　燐　(みなみの　りん)」\n日本人\n17歳の高学生\n性別は不明\nイメージカラーは深紅\nどんな人にも基本敬語\nミステリアスで夜は1人で出掛けて星を見るのが日課\n身長166cm\n棒付きキャンディーを持ち歩いている(タバコと間違えられて教師に怒られかけたことがある)\n将来は錠前技師(あかない扉の鍵を開ける仕事)の家を継ぐ予定。\n\n南野燐さんの私服をイメージで描いていただきたいです。\n仄時チコ❤️‍🔥美少年展【前期】1/5-11原宿さんの描くクラッシクなお洋服が大好きなのでそう言った雰囲気のシャツを着せていただけたらと思います。\n\nいつも素敵なイラスト拝見させて頂いております。美少年展も最高でした。\n\nもし気が向きましたら、燐さんをどうぞよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-Ra3i2Y_u6vY_9hnPejqVXMsDfin1cWI", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__ckshax/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 378234, "client_id": 1073535, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d415fbab/uploads/origins/41a8e747-ef25-4050-95ef-29a116e20a58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34583d27d71c5ae2918a0473dafb568e", "srcset": "https://si.imgix.net/d415fbab/uploads/origins/41a8e747-ef25-4050-95ef-29a116e20a58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34583d27d71c5ae2918a0473dafb568e, https://si.imgix.net/d415fbab/uploads/origins/41a8e747-ef25-4050-95ef-29a116e20a58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=291da6b2b70c1ccd9f74967306f11b83 2x, https://si.imgix.net/d415fbab/uploads/origins/41a8e747-ef25-4050-95ef-29a116e20a58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b39e661921dcd9d1dea4c8d8381dee2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d415fbab/uploads/origins/41a8e747-ef25-4050-95ef-29a116e20a58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca3f79426c4d99e78c2947aeca4c3c54", "srcset": "https://si.imgix.net/d415fbab/uploads/origins/41a8e747-ef25-4050-95ef-29a116e20a58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca3f