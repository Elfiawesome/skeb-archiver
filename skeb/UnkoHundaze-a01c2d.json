や内容は指定ではございませんので、あくまでイメージの参考程度に扱っていただいて構いません）\n先生の杉山響さんとの解釈と違っていたら申し訳ありません。\n情緒不安定になっているシーンでも、シリアスなシーンでもなんでもよく、先生が思う杉山響さんの全力他責が見たいです。\n以前、近いシチュエーションのイラストを描かれていたかと思いますが、あのイラストで本当に魂が震えました。\nぜひ、一枚絵全力他責が見たいと思い、この度はご依頼させていただきました。\n\nご検討の程よろしくお願い申し上げます。\nご多忙かとは存じておりますが、体調を崩されぬよう、お気をつけてお過ごしくださいませ。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@UnkoHundaze/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3969362, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c2ec3e9/uploads/origins/0af9ec46-5a19-4b8c-87da-51a3013e00ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d535d73b1e9fda6db950152fc63b272e", "srcset": "https://si.imgix.net/7c2ec3e9/uploads/origins/0af9ec46-5a19-4b8c-87da-51a3013e00ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d535d73b1e9fda6db950152fc63b272e, https://si.imgix.net/7c2ec3e9/uploads/origins/0af9ec46-5a19-4b8c-87da-51a3013e00ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0f4e14bf8ed67fb0e26523c756c4063 2x, https://si.imgix.net/7c2ec3e9/uploads/origins/0af9ec46-5a19-4b8c-87da-51a3013e00ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bca33947e59557bb6c5c0c93baf9ff31 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c2ec3e9/uploads/origins/0af9ec46-5a19-4b8c-87da-51a3013e00ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14db4d86c0e12bf072e6e6712bb50f0c", "srcset": "https://si.imgix.net/7c2ec3e9/uploads/origins/0af9ec46-5a19-4b8c-87da-51a3013e00ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14db4d86c0e12bf072e6e6712bb50f0c, https://si.imgix.net/7c2ec3e9/uploads/origins/0af9ec46-5a19-4b8c-87da-51a3013e00ab?bg=%23fff&auto=format%2Ccompress&fm=webp