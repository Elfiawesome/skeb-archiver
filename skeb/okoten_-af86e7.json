お願い〗\nサムネなどに使用させていただきたいため、背景と人物分けされたものを頂けると助かります！\nまた頭が切れていないと嬉しいです…！\n\n\n〖キャラクターについて〗\nガゼルから人間体になったVtuberです。\n猫化もしております。\n明るく、優しいイメージです！\n\n\nお忙しいところ恐縮ですが、ご確認とご検討のほど、\n何卒宜しくお願いいたします!\n\nhttps://drive.google.com/drive/folders/1Qs-W6nMXCOQvGsboWU3oH4VQxu4tNY-i?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@okoten_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3745299, "client_id": 2891732, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8bdc532e/uploads/origins/fcacee3b-602a-40da-a76e-7678f74beec3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98ab287db81d62b42112869d9a1f6d56", "srcset": "https://si.imgix.net/8bdc532e/uploads/origins/fcacee3b-602a-40da-a76e-7678f74beec3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98ab287db81d62b42112869d9a1f6d56, https://si.imgix.net/8bdc532e/uploads/origins/fcacee3b-602a-40da-a76e-7678f74beec3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84635af02ca25aec71bfdd8fc5baf165 2x, https://si.imgix.net/8bdc532e/uploads/origins/fcacee3b-602a-40da-a76e-7678f74beec3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad5dd4994724f7086f24f4ee0602dca3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8bdc532e/uploads/origins/fcacee3b-602a-40da-a76e-7678f74beec3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46188daca58ccc5ff441bb48ba6c467d", "srcset": "https://si.imgix.net/8bdc532e/uploads/origins/fcacee3b-602a-40da-a76e-7678f74beec3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46188daca58ccc5ff441bb48ba6c467d, https://si.imgix.net/8bdc532e/uploads/origins/fcacee3b-602a-40da-a76e-7678f74beec3?bg=%23fff&auto=format%2Ccompress&fm=webp