net/9b565ef3/uploads/origins/61dfedb3-103d-4da2-87ab-d4e927a7a1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbae97c682195542cdb08eca56420adf, https://si.imgix.net/9b565ef3/uploads/origins/61dfedb3-103d-4da2-87ab-d4e927a7a1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d9aa207affa7e0d9db205b61ad7dc861 2x, https://si.imgix.net/9b565ef3/uploads/origins/61dfedb3-103d-4da2-87ab-d4e927a7a1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4038d2dd1b6dd2d957b729d8c278077b 3x"}, "body": "初めてのリクエストをお願い致します。\n巨人女性好きが想像するR-18のエッチな内容なので、もし駄目でしたらキャンセルして頂いて結構です。\n\n・キャラクター\n艦隊これくしょんの「島風」\n\n・服装\n戦闘で大破し、ほとんど裸同然の恰好\nそれと島風の大きさは人間より数十倍大きい巨人の状態でお願いします。\n\n・構図\n海戦で大破した、巨人の島風が建物のコンビニをパンツ代わりに履いて恥ずかしがってる所を描いて下さい。バッグの背景には大破した艦娘の股間を隠す為、代替パンツもといコンビニを2軒積んだ補給船が浮いている所も描写願います。\n\n・参照\nコンビニ貨物船\nhttps://seiga.nicovideo.jp/seiga/im1670881\n\nでは、ご検討の程よろしくお願い足します。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HAL9000/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 327358, "client_id": 206892, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe4afbe0/uploads/origins/037d3592-6c1d-4f06-b54d-daf269869431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a33450e8be7a506ec81f8b08110f9b77", "srcset": "https://si.imgix.net/fe4afbe0/uploads/origins/037d3592-6c1d-4f06-b54d-daf269869431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a33450e8be7a506ec81f8b08110f9b77, https://si.imgix.net/fe4afbe0/uploads/origins/037d3592-6c1d-4f06-b54d-daf269869431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36402a814f52c59890cee0a77c51667e 2x, https://si.imgix.net/fe4afbe0/uploads/origins/037d3592-6c1d-4f06-b54d-daf269869431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dfb522be2096b817623eeca05e803531 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe4afbe0/uploads/origins/037d3592-6c1d-4f06-b54d-daf269869431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba680fd38fcc01cb2e8f10d9acce9ef6", "srcset": "https://si.imgix.net/fe4afbe0/uploads/origins/037d3592-6c1d-4f06-b54d-daf269869431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba680fd38fcc01cb2e8f10d9acce9ef6, https://si.imgix.net/fe4afbe0/uploads/origins/037d3592-6c1d-4f06-b54d-daf269869431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b5dc958653f8cfa9890429779c230ce 2x, https://si.imgix.net/fe4afbe0/uploads/origins/037d3592-6c1d-4f06-b54d-daf269869431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9ca3d41cb49dc9b7179c770f40135452 3x"}, "body": "こんにちは！\n\nオリジナルタンクのデザインをお願いしたいのですが。\n\nIS-7のような重戦車のシャーシをベースにした砲塔型駆逐戦車を希望します。コンセプトはFV4005 Stage IIやObject 120 'Taran'駆逐戦車のようなもので、重装甲で、準備された防御陣地から後退しつつ、来襲する砲火に耐えることができるようなものです。可能であれば、イラストはこれ（https://skeb.jp/@Gemeinschaft/works/5）と同様のスタイルで提示されるべきである。\n\n参考文献\nhttps://wiki.warthunder.com/FV4005\nhttps://wiki.warthunder.com/Object_120\n\nありがとうございました！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HAL9000/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 327358, "client_id": 454523, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/906e0cdf/uploads/origins/93626b2f-1e9d-4d9e-b0d1-b8bf3e218ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=030e42db7ebe9ddbe9e80e9ea0847ad0", "srcset": "https://si.imgix.net/906e0cdf/uploads/origins/93626b2f-1e9d-4d9e-b0d1-b8bf3e218ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=030e42db7ebe9ddbe9e80e9ea0847ad0, https://si.imgix.net/906e0cdf/uploads/origins/93626b2f-1e9d-4d9e-b0d1-b8bf3e218ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d19384042941fa4234705de06b106819 2x, https://si.imgix.net/906e0cdf/uploads/origins/93626b2f-1e9d-4d9e-b0d1-b8bf3e218ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=840e982f34e758860278fa136f5ae7b6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/906e0cdf/uploads/origins/93626b2f-1e9d-4d9e-b0d1-b8bf3e218ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6628da83eeef62223ca8ffe6167269db", "srcset": "https://si.imgix.net/906e0cdf/uploads/origins/93626b2f-1e9d-4d9e-b0d1-b8bf3e218ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6628da83eeef62223ca8ffe6167269db, https://si.imgix.net/906e0cdf/uploads/origins/93626b2f-1e9d-4d9e-b0d1-b8bf3e218ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=afb0821a9da107b912cbc80552b073e0 2x, https://si.imgix.net/906e0cdf/uploads/origins/93626b2f-1e9d-4d9e-b0d1-b8bf3e218ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64ce0b9910bc9d00c5fd1b885cf57574 3x"}, "body": "何時も素敵なイラストありがとうございます。\n今回は佐藤大輔先生の『レッドサン ブラッククロス』に登場する「七式中戦車」のIFの未来を、古いネットのSSを元ネタに描いていただきたく依頼させていただきました。\n以下の三つの未来の姿から描きやすいものを一つ描いていただきたいと思います。\n\n・南アフリカで〈オリファント〉と名付けられた現地国改修モデル（ファイル「ori」参照）。\n・農家に買われた中古車両がトラクターに改装されたもの（ファイル「tora」参照）。\n・欧州諸国紛争で使われてた輸出車両（塗装のみの変更でも構いません）（ファイル「sel」参照）。\n\n各構図、シチュ等はお任せします。人物の有無も特に指定はありません。\n資料用のURL先に元ネタ（原案であるSS）と各IFの参考になりそうな画像を入れていますので参考にされてください。もし資料や依頼額不足の場合キャンセルされてください。\n宜しくお願いします。\n\nhttps://www.dropbox.com/sh/6bmsf50g0dsi4jb/AADBM_14VcA9rCSJfulA0KjBa?dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HAL9000/works/4", "private_thumbnai