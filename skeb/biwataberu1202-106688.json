着させられたりしている。髪が短いのは姉にアレンジさせられまくるのを回避するため。\n髪にインナーカラーが入っている（三面図参照）目の色はインナーカラーと同じで緑ではないです（AIで資料を制作しているためややこしいですが、三面図参考でお願いします）\n\nもしご縁がありましたら、よろしくお願いします。\nhttps://drive.google.com/drive/folders/1ldnQ85FiD2bewf2m3tZyI8EBekVtrdmj\nhttps://drive.google.com/drive/folders/1vEsUUbtBMMe0u8itbaKtlOKZw4UYNphw", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 766695, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "IZ（あいぜっと）@『Witch's Heart』の中の人。", "screen_name": "blueiziz", "avatar_url": "https://pbs.twimg.com/profile_images/1704769743725666304/1Cf7deKu.png", "header_url": "https://pbs.twimg.com/profile_banners/962013116765675521/1734268894/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 2975610, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ひつじの いももち@Skeb募集中！", "screen_name": "Imomochi_Baabaa", "avatar_url": "https://pbs.twimg.com/profile_images/1603483737240797184/1vggx1XX.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1090771186319949824/1671135289/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "video"}], "banned": false, "nc": 145}, {"id": 3268842, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "__.", "screen_name": "tori_txfn04", "avatar_url": "https://pbs.twimg.com/profile_images/2000913129920978946/gqUlkJZc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1720237896966537216/1773417799/1500x500", "appeal_receivable"