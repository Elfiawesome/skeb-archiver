200&s=711d5c910ea0af7b9673fb1c3bf5b3c0", "srcset": "https://si.imgix.net/c9404408/uploads/origins/a6c2429f-1fa9-4d62-a61e-62eb968457fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=711d5c910ea0af7b9673fb1c3bf5b3c0, https://si.imgix.net/c9404408/uploads/origins/a6c2429f-1fa9-4d62-a61e-62eb968457fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=900de4d83f15d2a6f8dd9f5176d93143 2x, https://si.imgix.net/c9404408/uploads/origins/a6c2429f-1fa9-4d62-a61e-62eb968457fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c9217a5501ad487abb5c7936075e9176 3x"}, "body": "こんにちは、初めまして。\n以前ツイッターで拝見した梅野さんのイラストがとても素敵だったので、自創作のキャラクターを描いていただければと思いリクエストさせていただきました。\nお忙しい等あればお断りいただいても構いませんのでご一考よろしくお願いいたします。\n\n以下キャラクターの資料、要素\n・蜂モチーフの職業ヒーロー\n・すこし垂れ目でみどり色の瞳、穏やかな顔立ち\n・ヘアはゆるめのみつあみ、前髪に黒メッシュ\n・ピンク系カラーのゴーグル、黒のイヤーマフ\n\n背景ベタ塗りで構いませんので簡単に入れていただけると嬉しいです。\n\nhttps://drive.google.com/drive/folders/1U44etb7832ZZnunMSKBsDrCOUc8WbXUw\n\nhttps://drive.google.com/drive/folders/1U44etb7832ZZnunMSKBsDrCOUc8WbXUw", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ume/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1850706, "client_id": 908109, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22d772ec/uploads/origins/63e1d9cb-db15-4d96-aa8d-f18f94c6a6be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6a524705d4588c240e9f121fe2835ec", "srcset": "https://si.imgix.net/22d772ec/uploads/origins/63e1d9cb-db15-4d96-aa8d-f18f94c6a6be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6a524705d4588c240e9f121fe2835ec, https://si.imgix.net/22d772ec/uploads/origins/63e1d9cb-db15-4d96-aa8d-f18f94c6a6be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e6102c5e464538a08c76eb6ad87f32c 2x, https://si.imgix.net/22d772ec/uploads/origins/63e1d9cb-db15-4d96-aa8d-f18f94c6a6be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0cebb365bab03aee2794c3d4173e98b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22d772ec/uploads/origins/63e1d9cb-db15-4d96-aa8d-f18f94c6a6be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ebbe1378b3d884f77595a92c1fd7542", "srcset": "https://si.imgix.net/22d772ec/uploads/origins/63e1d9cb-db15-4d96-aa8d-f18f94c6a6be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ebbe1378b3d884f77595a92c1fd7542, https://si.imgix.net/22d772ec/uploads/origins/63e1d9cb-db15-4d96-aa8d-f18f94c6a6be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b74bfcaa6d4fb8a75d8fa58c35c1c18a 2x, https://si.imgix.net/22d772ec/uploads/origins/63e1d9cb-db15-4d96-aa8d-f18f94c6a6be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bf5676437bca8d712d7639dfd1c9cd00 3x"}, "body": "こんにちは。いつも素敵なイラスト拝見しております。\n\n私のオリジナルキャラクター「リイ」を描いていただきたく、ご依頼しました。\n下記URL先に「リイ」の資料として、イラスト/他の登場人物/世界観の設定と小説作品があります。\n\n納品いただいた作品はパソコンの壁紙に使用させていただく他、Twitterなどのサイトのアイコンやヘッダー等にお借りできればと考えております。（その際は梅野さんのTwitterアカウントの記載をさせていただきます。）\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://ci-en.dlsite.com/creator/13778/article/726345#d71fc3a225\n\nhttps://twitter.com/tsuduminu/status/1468599304059506688\n\nhttps://twitter.com/tsuduminu/status/1587768535291338753?s=46&t=aNibkmjA4L80gQz5NwWhkg", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ume/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1850706, "client_id": 1333156, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8184fed2/uploads/origins/02340c66-a4eb-4647-ac50-6c4b094793c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae1216ad382abe5c81428333bbfc4ce7", "srcset": "https://si.imgix.net/8184fed2/uploads/origins/02340c66-a4eb-4647-ac50-6c4b094793c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae1216ad382abe5c81428333bbfc4ce7, https://si.imgix.net/8184fed2/uploads/origins/02340c66-a4eb-4647-ac50-6c4b094793c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0e4d99ff6911ea3ac7ec232a88cb0a5 2x, https://si.imgix.net/8184fed2/uploads/origins/02340c66-a4eb-4647-ac50-6c4b094793c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31ecd8a52ba10ee1512307cf684a4aa8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8184fed2/uploads/origins/02340c66-a4eb-4647-ac50-6c4b094793c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0be1a1e634ad7ee66363f616b2c84d26", "srcset": "https://si.imgix.net/8184fed2/uploads/origins/02340c66-a4eb-4647-ac50-6c4b094793c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0be1a1e634ad7ee66363f616b2c84d26, https://si.imgix.net/8184fed2/uploads/origins/02340c66-a4eb-4647-ac50-6c4b094793c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81417a3916e0922bd840b377423401f7 2x, https://si.imgix.net/8184fed2/uploads/origins/02340c66-a4eb-4647-ac50-6c4b094793c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=36f4039b2bee78dfe62375e298dc89b5 3x"}, "body": "お世話になっております。せろりすと と申します。\n前回は本当に本当にありがとうございました……。\n\n今回梅野様に描いていただきたく思っているのは、昔あるシナリオに連れて行った私の探索者2人です。\nそれぞれ別のPLとシナリオ（タイマン）に行っているため2人に関りは全くありませんが、思い入れのあるシナリオなので……。\nそのため、2人の絡みというよりは、それぞれが別の人間に向けている表情が見たい……です……。カメラの一人称視点等で構いません。我儘をすみません……。\n\nネタバレになりかねないのでシナリオは伏せておきます。世の中にはタイマンシナリオがいっぱいあるので名前さえ言わなければ大丈夫だと勝手な判断をしていますが、資料の中には表情の話の上で必要だったためシナリオの内容にかかわることがふんわりと書いてあります。この時点で嫌なにおいを感じたら突き返してくださって構いません。お手数をおかけします…。\n\n\n〇掛橋 正記 / かけはし まさのり（34歳）\n職業：刑事\n\n〇八雲 想助 / やくも そうすけ（享年20歳）\n職業：時代作家\n\n\n以下資料URLです。\n掛橋正記の方の画像3枚目のシナリオは最近まわったもので、前述したものとは関係ないのでご安心ください。\n他PLからは立ち絵を載せる許可を取ってあります。\nhttps://twitter.com/Serolist_TRPG/status/1528821508100849664\nhttps://twitter.com/Serolist_TRPG/status/1528821528883654656\n\n私事で申し訳ありませんが、前回のスケブやSKIMAで梅野様に本当に素敵な絵を描いていただきまして、またぜひ頼みたく思い、お金に余裕ができる機会をうかがっていました。\nこの度初任給が出たので参りました……！\n梅野様の絵が本当に好きです……。\n\n急ぎのものではないので、もしお暇な時間があれば……！\nよろしくお願いします🙇‍♀️", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ume/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1850706, "client_id": 304315, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c0dc668/uploads/origins/ac7af469-7c1e-4004-9238-d45778486c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=741efe723154573de3de26e6c337cfd0", "srcset": "https://si.imgix.net/9c0dc668/uploads/origins/ac7af469-7c1e-4004-9238-d45778486c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=741efe723154573de3de26e6c337cfd0, https://si.imgix.net/9c0dc668/uploads/origins/ac7af469-7c1e-4004-9238-d45778486c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=444ad06ce9a5394d251d9a4190821684 2x, https://si.imgix.net/9c0dc668/uploads/origins/ac7af469-7c1e-4004-9238-d45778486c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fb96030cd635a8ede1fa6380c5e8d46 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c0dc668/uploads/origins/ac7af469-7c1e-4004-9238-d45778486c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69bdf5a21ffd264d8ac37bee6fb2fe42", "srcset": "https://si.imgix.net/9c0dc668/uploads/origins/ac7af469-7c1e-4004-9238-d45778486c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69bdf5a21ffd264d8ac37bee6fb2fe42, https://si.imgix.net/9c0dc668/uploads/origins/ac7af469-7c1e-4004-9238-d45778486c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=65ffcbff5419e7b37dc2a3b2a40761cc 2x, https://si.imgix.net/9c0dc668/uploads/origins/ac7af469-7c1e-4004-9238-d45778486c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b013bac2369d0bdb87685e08bff9a8dd 3x"}, "body": "こんにちは、はじめまして。斉藤さんの作品が大好きで、リクエストさせていただきました。\n\n私のOCのリデザインを、出来れば参考シートか全身イラストでお願いしたいです。使用目的は、将来的にRPGのインディーズゲームに組み込む予定ですが、今は自己娯楽目的だけのキャラです。\n\n私のキャラクターは、神となる前は人間だった死神です。真面目な表情をしているため、最初は威圧的で怖いと思われていますが、実際はとても臆病で一人の時間には憂鬱になり、誰も見ていないと泣いてばかりいるそうです。また、傷跡が多く隠しきれないため、大きな服で体を覆っている。\n\n身だしなみとしては、眉毛が太く（私が好きなだけですが）、裸足です。この辺はデザインとして残しておきたいところです。あとはあなたの判断で変えてください。\n\nhttps://drive.google.com/file/d/10HRT8jEXAPp7zKO2nQPZjVjjPObRpRYl/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ume/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1850706, "client_id": 1333156, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42549d15/uploads/origins/82255b8a-19b4-467f-a12d-276cc3721b94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e1d4c296629ef4561151d35fa3a7e7f", "srcset": "https://si.imgix.net/42549d15/uploads/origins/82255b8a-19b4-467f-a12d-276cc3721b94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e1d4c296629ef4561151d35fa3a7e7f, https://si.imgix.net/42549d15/uploads/origins/82255b8a-19b4-467f-a12d-276cc3721b94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f02c28782b84c5ea76ccce7a7d809cf1 2x, https://si.imgix.net/42549d15/uploads/origins/82255b8a-19b4-467f-a12d-276cc3721b94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s