はとても美しいので、私の北極ギツネの絵をお願いできますか？彼は細身で少し女性的な体格の男性です。バーテンダーとして働く、穏やかで自信に満ちた男性です。可能であれば、タバコを吸いながら夜道を歩く姿を描いていただけないでしょうか。服装は自由です。興味がなかったり、すでに依頼が多すぎる場合は断っても構いません。依頼を検討していただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1C2_gWV9MxYs35BFrT-SMEjQEpXakhDQc?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@simesaba_poteto/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3197456, "client_id": 450719, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/641f45eb/uploads/origins/54853c9a-dd07-4ed7-b6f5-a865a4a5561f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=254b1395c96a95b0baec3627a7cc3c1c", "srcset": "https://si.imgix.net/641f45eb/uploads/origins/54853c9a-dd07-4ed7-b6f5-a865a4a5561f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=254b1395c96a95b0baec3627a7cc3c1c, https://si.imgix.net/641f45eb/uploads/origins/54853c9a-dd07-4ed7-b6f5-a865a4a5561f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=823b0daf7b47d7efbfe7202ce9b97c13 2x, https://si.imgix.net/641f45eb/uploads/origins/54853c9a-dd07-4ed7-b6f5-a865a4a5561f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7dce50183f326f85018f95b389ac623f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/641f45eb/uploads/origins/54853c9a-dd07-4ed7-b6f5-a865a4a5561f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=771dc217d9817dd16349719ffd752d8a", "srcset": "https://si.imgix.net/641f45eb/uploads/origins/54853c9a-dd07-4ed7-b6f5-a865a4a5561f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=771dc217d9817dd16349719ffd752d8a, https://si.imgix.net/641f45eb/uploads/origins/54853c9a-dd07-4ed7-b6f5-a865a4a5561f?bg=%23fff&auto=format%2Ccompress&fm=webp&