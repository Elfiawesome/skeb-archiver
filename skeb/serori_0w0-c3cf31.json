igins/e0f0b416-b6c8-47a5-b024-962966cd044c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5fdc7661fd1355acca6ce79de53c405 3x"}, "body": "いつもお世話になっております。とうとう来ました国家の依頼その１です（？）\n個人的な読書ノートを、ネップリを使用して作成したいため、その表紙イラストを描いて欲しいです。作った読書ノートを定期的に読み返したくなるようにするためには、推しが読書している姿が表紙にあれば良いんじゃないかなとの天啓を受けました。\n\nサイズ：A5サイズ表紙（縦画像）\n内容：マンサナ・アナナッサが頭良さそうな単行本を真剣な表情で読んでいる姿\n※マンサナ（制服姿）が椅子に座ってる姿で、全身入っていると嬉しいです\n※全体の雰囲気は明るい感じで、色味はお任せします\n※マンサナのプリティでパーフェクトなお顔が見える感じの角度だと仰げば尊し\n\nあとは毒芹神の性癖の寄る辺に従ってもろて、どうか私めにマンサナ・アナナッサをお恵みください…。よろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@serori_0w0/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 994548, "client_id": 1335236, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/107b2eba/uploads/origins/141e73f2-de17-49cd-a9b7-f1945d3a8c4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f19e59af91af5f3cd6a804de5f031045", "srcset": "https://si.imgix.net/107b2eba/uploads/origins/141e73f2-de17-49cd-a9b7-f1945d3a8c4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f19e59af91af5f3cd6a804de5f031045, https://si.imgix.net/107b2eba/uploads/origins/141e73f2-de17-49cd-a9b7-f1945d3a8c4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da8a7d3863679d4c7abf1a6e558c3f20 2x, https://si.imgix.net/107b2eba/uploads/origins/141e73f2-de17-49cd-a9b7-f1945d3a8c4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3cde996a932ecca14cb00895819f7ba9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/107b2eba/uploads/origins/141e73f2-de17-49cd-a9b7-f1945d3a8c4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30b299d6f94d6b5a4b518a5ff6da8df1", "srcset": "https://si.imgix.net/107b2eba/uploads/orig