ess&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eeda4ece2df4639973c073e7f1959202", "srcset": "https://si.imgix.net/54f5afd4/uploads/origins/43e32072-a53f-4277-91ef-10e80ede6d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eeda4ece2df4639973c073e7f1959202, https://si.imgix.net/54f5afd4/uploads/origins/43e32072-a53f-4277-91ef-10e80ede6d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9235b019fdcbe3072bd8ec0b2fe582b8 2x, https://si.imgix.net/54f5afd4/uploads/origins/43e32072-a53f-4277-91ef-10e80ede6d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2c966f2424a17e5b2d42b9870ec29ffc 3x"}, "body": "Hello, i saw your spacesuit art and really liked it! I would love if you could draw my character Mikha (https://i.imgur.com/hw8MNFO.jpg) in a spacesuit. For the spacesuit, please have some blue and orange highlights. For the pose and background, please choose any you would like. Some suggestions if you do not have a preference would be working on something in space, like a satellite. Thank you very much!", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kiabook/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 21652, "client_id": 1434949, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/637d202f/uploads/origins/2782617a-e812-4a39-9f9c-4ff5255dab50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef13a9569ae16736946dfa2035192143", "srcset": "https://si.imgix.net/637d202f/uploads/origins/2782617a-e812-4a39-9f9c-4ff5255dab50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef13a9569ae16736946dfa2035192143, https://si.imgix.net/637d202f/uploads/origins/2782617a-e812-4a39-9f9c-4ff5255dab50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69e8bd9473109f8749b3ce2258a286ad 2x, https://si.imgix.net/637d202f/uploads/origins/2782617a-e812-4a39-9f9c-4ff5255dab50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e26a42172dcb10eaefaf02795358bb34 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/637d202f/uploads/origins/2782617a-e812-4a39-9f9c-4ff5255dab50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b1ab56bb05275aefbc973ef85fb4326", "srcset": "https://si.imgix.net/637d202f/uploads/origins/2782617a-e812-4a39-9f9c-4ff5255dab50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b1ab56bb05275aefbc973ef85fb4326, https://si.imgix.net/637d202f/uploads/origins/2782617a-e812-4a39-9f9c-4ff5255dab50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62545b9e0e1ae78d182c61972d069958 2x, https://si.imgix.net/637d202f/uploads/origins/2782617a-e812-4a39-9f9c-4ff5255dab50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a4cf371a5d8d96ca07174e1cc17cd64 3x"}, "body": "はじめまして、キアシヨ様。\nVtuber活動をしている白昼夢ティアラと申します。\n素敵なイラストを拝見し、リクエストさせていただきます！\n\n✦希望内容✦\nシチュエーション：人物とバク（資料ドライブ中のファンマスコット）一緒に宇宙に旅行く\nポース、構図：人物とバクも無重力の宇宙の中で浮いている\n（例：https://www.pixiv.net/artworks/122633042）\n衣装：人物は宇宙服でお願いいたします！\nバクの方は動物の宇宙服、またはProject Hail MaryのRockyみたいにガラスのボール、またはシャボン玉の中に入れるも良いと思います！\n髪型と表情：お任せいたします。\nサイズ比率：16:9 （横：縦）・3840px2160px～（待機動画とサムネ用）\n\n✦キャラの詳細✦\n種族：エルフ\n身長：158cm\n髪型の特徴：ハートのアホ毛\n瞳の色：オッドアイ（紫と黄色）\n耳の特徴：左（⇐）の耳割目があります。\n\n✦使用用途✦\nVtuberの活動：\n・YouTube動画、配信のサムネイル\n・メンバーシップ特典\n・SNS掲載・アイコン・ヘッダー等での使用（Twitter、Facebook、Instagram）\n・個人用な印刷などの使用\n・グッズ化などの利用\n\n✦形式✦\n可能であればPSDファイルで宛名・背景・人物のレイヤーを分けて納品頂けると助かります。\n\nお忙しいところ恐れ入りますが、ご検討いただきますようお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1p4Owl8mBb8Ri-XQucsiaNapw1eXCps_Y\n\nhttps://drive.google.com/drive/folders/1p4Owl8mBb8Ri-XQucsiaNapw1eXCps_Y", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kiabook/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 21652, "client_id": 2367169, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/317b7d99/uploads/origins/6880eca1-21af-4f35-bf0b-1ee16cd404e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9934a7e9f6329a24d3b2f13322be85b", "srcset": "https://si.imgix.net/317b7d99/uploads/origins/6880eca1-21af-4f35-bf0b-1ee16cd404e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9934a7e9f6329a24d3b2f13322be85b, https://si.imgix.net/317b7d99/uploads/origins/6880eca1-21af-4f35-bf0b-1ee16cd404e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5cfc2d4e2783f61ee613495e3ef1c67 2x, https://si.imgix.net/317b7d99/uploads/origins/6880eca1-21af-4f35-bf0b-1ee16cd404e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92764c8219c44aff32cdd7d27e5eeeba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/317b7d99/uploads/origins/6880eca1-21af-4f35-bf0b-1ee16cd404e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ec0fea2983d2d2d1004f1227afa4e42", "srcset": "https://si.imgix.net/317b7d99/uploads/origins/6880eca1-21af-4f35-bf0b-1ee16cd404e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ec0fea2983d2d2d1004f1227afa4e42, https://si.imgix.net/317b7d99/uploads/origins/6880eca1-21af-4f35-bf0b-1ee16cd404e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=afafbd2af4bb549e8a368f52e4870992 2x, https://si.imgix.net/317b7d99/uploads/origins/6880eca1-21af-4f35-bf0b-1ee16cd404e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=73229e727b39b51d7832c343cc317757 3x"}, "body": "キアシヨ様\nskeb閲覧していたところ、とても目を惹き素敵だなと思いご依頼させていただきました。\n\n【使用用途】\nSNS(YouTube/X)にて使用/YouTubeメンバー限定壁紙配布\n\n【描いていただきたいキャラクター】\n卯月ちゅん\n\n【服装、ポーズ】\nジャージ着せて頂けると嬉しいです。\n髪型や諸々お任せでお願いします。\n上半身より上は切れてないと嬉しいです。\n\n確認しづらい所が数点ありますので文字にて失礼致します。\n・ギザ歯\n・右目下のピンクの×××\nこちらは必ず入れて頂けると嬉しいです。\n\n【イラストサイズ、ファイル形式】\npng形式でお願い致します。\n(可能であればPSD※キャラクターのみで使用する場合がございますので、背景等と分けていただけると嬉しいです。)\nイラスト　/　署名なし　/背景なしのデータで頂けますと助かります。\n\n長くなりましたがご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1YuFu0coMjAa1YQJ7by7nVTEj-5Aehfzx", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kiabook/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 21652, "client_id": 248850, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a705089/uploads/origins/424d4fd9-db5b-41c0-b1b3-d754d18e36c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d509a4824408a2b9389c8fbee85149bc", "srcset": "https://si.imgix.net/0a705089/uploads/origins/424d4fd9-db5b-41c0-b1b3-d754d18e36c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d509a4824408a2b9389c8fbee85149bc, https://si.imgix.net/0a705089/uploads/origins/424d4fd9-db5b-41c0-b1b3-d754d18e36c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30d0c5d6cd071637f356a644f4d54db3 2x, https://si.imgix.net/0a705089/uploads/origins/424d4fd9-db5b-41c0-b1b3-d754d18e36c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b98d2a8ac3672232df93237893d07b6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a705089/uploads/origins/424d4fd9-db5b-41c0-b1b3-d754d18e36c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=867ab6b539a44337692f5e4295cc6000", "srcset": "https://si.imgix.net/0a705089/uploads/origins/424d4fd9-db5b-41c0-b1b3-d754d18e36c4?bg=%23fff&auto=