=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f3a11cbe8ca1683048a4ac411d72924c 3x"}, "body": "艦これの夏雲の「夏の釣りmode」を描いていただきたいです。\n全体のイメージとしては、夏休みに山や川に遊びにいく少年のような感じで。\n帽子は麦わら帽子。上着は「NA　SUGUMO」のロゴとナスの形をした紫の雲が描いてある変Tシャツ（必須）。ズボンは、デニムのオーバーオール（ジーパンでも可、ヒザ下ぐらいの長さがいいですが全体とのバランス優先で）。靴はサンダルでもなんでもOK。釣り竿は、木の棒にヒモつけたようものでも本格的なやつでもなんでもOK。\n全体的には少年ですが、麦わら帽子にリボンがついてたり、ブレスレットをしてたりと細部は女子って感じで！\nバランスをとるのが難しいと思いますが、よろしくお願いします！！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@3548tl/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 343628, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1467a759/uploads/origins/1e5ae07a-bca0-491e-91a0-97d708f1a319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d106d7ad6ce25f900b8b793037a51904", "srcset": "https://si.imgix.net/1467a759/uploads/origins/1e5ae07a-bca0-491e-91a0-97d708f1a319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d106d7ad6ce25f900b8b793037a51904, https://si.imgix.net/1467a759/uploads/origins/1e5ae07a-bca0-491e-91a0-97d708f1a319?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c25873ba79eb03968d38455369ce812 2x, https://si.imgix.net/1467a759/uploads/origins/1e5ae07a-bca0-491e-91a0-97d708f1a319?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=464f675eee3d0b7fc44d1118a6353c1b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1467a759/uploads/origins/1e5ae07a-bca0-491e-91a0-97d708f1a319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b97d7862dfc6bbf2900922f949227b58", "srcset": "https://si.imgix.net/1467a759/uploads/origins/1e5ae07a-bca0-491e-91a0-97d708f1a319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b97d7862dfc6