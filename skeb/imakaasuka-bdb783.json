 would like you to draw an illustration for me.\nDetails of the OC are in the reference materials.\n\n◆Composition\nI'll leave it to you!\nThere are a lot of characters, so it's okay if you just draw the face...!\nIt's okay if you simplify the clothes, etc.\n\n◆Reference materials\nhttps://drive.google.com/drive/folders/1TC8NE_S_DCXGg37POExfe-lXVQHhRRUZ?usp=drive_link\n\nI know you're busy, so it's okay if you don't ask◎\nThank you for your consideration.\nI'll continue to support you!", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@imakaasuka/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 684704, "client_id": 1731826, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2c1e909/uploads/origins/db5ab5b0-a0f7-4f9f-8705-56158bf24e93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c53f620f74622728680929771d92c01e", "srcset": "https://si.imgix.net/c2c1e909/uploads/origins/db5ab5b0-a0f7-4f9f-8705-56158bf24e93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c53f620f74622728680929771d92c01e, https://si.imgix.net/c2c1e909/uploads/origins/db5ab5b0-a0f7-4f9f-8705-56158bf24e93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f51d17beccf8047b676b256c41a67d1 2x, https://si.imgix.net/c2c1e909/uploads/origins/db5ab5b0-a0f7-4f9f-8705-56158bf24e93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d59187868955e3caf3b7870b2620c98e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c2c1e909/uploads/origins/db5ab5b0-a0f7-4f9f-8705-56158bf24e93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65a0870e6517d7211b0d48a5fd38e985", "srcset": "https://si.imgix.net/c2c1e909/uploads/origins/db5ab5b0-a0f7-4f9f-8705-56158bf24e93?bg=%23fff&auto=format%