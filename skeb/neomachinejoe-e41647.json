_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neomachinejoe/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 90241, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ae87a7a/uploads/origins/c40a18bf-002b-4ff8-959c-dcd2c4e0e655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d65adb998533c72224f4bef765444ea0", "srcset": "https://si.imgix.net/4ae87a7a/uploads/origins/c40a18bf-002b-4ff8-959c-dcd2c4e0e655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d65adb998533c72224f4bef765444ea0, https://si.imgix.net/4ae87a7a/uploads/origins/c40a18bf-002b-4ff8-959c-dcd2c4e0e655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01aef7b98811360a22ad8bf2d5a8a2bd 2x, https://si.imgix.net/4ae87a7a/uploads/origins/c40a18bf-002b-4ff8-959c-dcd2c4e0e655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22a4b4131a00fccaf66b99099ade388b 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ae87a7a/uploads/origins/c40a18bf-002b-4ff8-959c-dcd2c4e0e655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d480921a695d690f2677e336a7dcfd1f", "srcset": "https://si.imgix.net/4ae87a7a/uploads/origins/c40a18bf-002b-4ff8-959c-dcd2c4e0e655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d480921a695d690f2677e336a7dcfd1f, https://si.imgix.net/4ae87a7a/uploads/origins/c40a18bf-002b-4ff8-959c-dcd2c4e0e655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=127c505210dd58f651fc8eb82b4ef536 2x, https://si.imgix.net/4ae87a7a/uploads/origins/c40a18bf-002b-4ff8-959c-dcd2c4e0e655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8f6afdef5708a689f9569d23c8cca584 3x"}, "body": "リクエストさせていただきます。\nキャラ名：ルヴィ（古いゲームですがベルウィックサーガというゲームのキャラです）\n\nこのキャラは元々深窓の令嬢的なお嬢様だったのですがある事情で立派な騎士になるべく気丈に振舞っている。という設定なのですが（敵に囲まれてしまった等で）完全に心が折れてしまった状態で情けなく尻餅、がに股状態下着丸見えで涙よだれ、鼻水を流しながら何でもするから命だけは･･･的な台詞で命乞いしてるシーンをお願いします。\n（武器と盾はなくても大丈夫です。\n設定画では黒タイツをはいていますが生足、下着はサテン地を意識した清楚な白パンティでお願いします。\nさらにマニアックで恐縮ですが行軍中にお手入れなど出来ないということで腋毛あり、パンティはおりものやトイレの後の処理があまいのでおしっこやウン筋で汚れている感じでお願いします）\n\n・差分として更なる恐怖でそのまま下着の中に大小お漏らししてしまう差分\n・さらに命乞いむなしくそのまま腹を一文字に割かれて内臓露出＋斬首で痙攣している\n\nの差分をお願いいたします\n\nhttps://www.google.com/search?q=%E3%83%99%E3%83%AB%E3%82%A6%E3%82%A3%E3%83%83%E3%82%AF%E3%82%B5%E3%83%BC%E3%82%AC+%E3%83%AB%E3%83%B4%E3%82%A3&source=lnms&tbm=isch&sa=X&ved=2ahUKEwjr2uHWsoD1AhXrKqYKHdjSAkUQ_AUoAXoECAEQAw&biw=1920&bih=937&dpr=1", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neomachinejoe/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 90241, "client_id": 453524, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ceab8694/uploads/origins/df11cf48-c44f-414a-9f0c-ebfdc2430264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e386e6b7edce3ca2469faec04850d068", "srcset": "https://si.imgix.net/ceab8694/uploads/origins/df11cf48-c44f-414a-9f0c-ebfdc2430264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e386e6b7edce3ca2469faec04850d068, https://si.imgix.net/ceab8694/uploads/origins/df11cf48-c44f-414a-9f0c-ebfdc2430264?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=038b2c08e0d2f1ad1956d0edf4763c85 2x, https://si.imgix.net/ceab8694/uploads/origins/df11cf48-c44f-414a-9f0c-ebfdc2430264?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab8db9d06b7546d63a43a53d74309224 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ceab8694/uploads/origins/df11cf48-c44f-414a-9f0c-ebfdc2430264?bg=%23fff&auto=for