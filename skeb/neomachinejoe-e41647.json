ble_same_genre": true}, {"path": "/@neomachinejoe/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 90241, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ae02cea/uploads/origins/38d74878-cf85-48d0-a691-748e8dd810cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8d2e45c450e84bcfbc62c602a4e4c11", "srcset": "https://si.imgix.net/8ae02cea/uploads/origins/38d74878-cf85-48d0-a691-748e8dd810cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8d2e45c450e84bcfbc62c602a4e4c11, https://si.imgix.net/8ae02cea/uploads/origins/38d74878-cf85-48d0-a691-748e8dd810cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95f1597b7dc90ab32f8e1d2a85b80f9f 2x, https://si.imgix.net/8ae02cea/uploads/origins/38d74878-cf85-48d0-a691-748e8dd810cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70eb5fe5ea3adb896a908d43c5ac4ce7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ae02cea/uploads/origins/38d74878-cf85-48d0-a691-748e8dd810cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae8e97bf75d1fe8cbe527d895088a29d", "srcset": "https://si.imgix.net/8ae02cea/uploads/origins/38d74878-cf85-48d0-a691-748e8dd810cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae8e97bf75d1fe8cbe527d895088a29d, https://si.imgix.net/8ae02cea/uploads/origins/38d74878-cf85-48d0-a691-748e8dd810cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=75d9018c938f3fa84059240cf12d4773 2x, https://si.imgix.net/8ae02cea/uploads/origins/38d74878-cf85-48d0-a691-748e8dd810cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d7d5380733dbffe1e17bb7664c33153 3x"}, "body": "ロムのスカトロ差分絵依頼です。ムダ毛はなしでお願いします。\n\n差分元\nhttps://y-denjin.fanbox.cc/posts/698053\n\n差分元のレオタードのハイレグ傾斜は小さく、覆いは多めにしてほしいです。ケツも覆い広めに。\nhttps://y-denjin.fanbox.cc/posts/752156\n幸のレオタードぐらいに。\n\n\n以下、１～5の差分を描いていただけたら嬉しいです。\n\n１．\nハイキックポーズを決めて格好つけているロムだが、様子がおかしい。EPSメインスーツに着衣の乱れはないが。。。\n顔がアヘって面白くなってる。\n乳首が勃起して、特殊混紡の部分が乳首形に浮き上がってる。少しばかり濡れている。\n股間がピクピク痙攣している。特殊混紡の部分の割れ目に内側から白いシミが付着してる。\nロム「おっ、、、おっ。」。何かにこらえているのか？\n\n２．\nいきなりロムがぶっ壊れた。その瞬間は同時に訪れた。\nロムは、下品な音をたてながら、体液を噴射しぶちまけた。\n母乳は、特殊混紡布越しに、乳首から噴射。\n真っ白ラブジュースが、スーツ股間の割れ目から噴射。\n下痢まじりのクソが、ケツから発射。\n絶頂の声を上げるロム。背後からは怪物の笑い声が聞こえる。\n\n３．\n何が起こったのか？種明かしはすぐに訪れた。\n「インビジブルデバイス。不意打ちにはもってこいだな」\nロムの背後にある透明の何かがじょじょに半透明になり姿を現す。\n\n４．\n謎の何かが実体を表した。肥満体のヤラシイ目つきの異星人だ。\n「相変わらずマスラズの女戦士は、凶悪チンポには勝てんよな。ぐひひひひ」\n\n５．\n異星人の興奮したチンポには、ロムのものと思われるクソが付着している。\nEPSメインスーツはよく見ると、肛門の部分に穴が開いてる。その穴から覗くアナルは少し盛り上がり痙攣してる。\nそう答えは、ロムはハイキックを放っている最中に、この異星人にアナルを掘られたのだった。凶悪チンポはEPSメインスーツの特殊混紡されてない肛門に穴を穿ち、アナルに侵入。ポルチオゾーンなどを間接的に刺激した。この性刺激はマスラズ星人特有の過剰反応を引き起こし、ロムがぶっ壊れたのだった。\n\n\n細かく描きましたが、3割ぐらい一致してれば御の字です。よろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neomachinejoe/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3ef4b71a/uploads/origins/5c967f97-56e0-41e1-b133-04c8dc13ee71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57267c8e3d90a22c6363920ac8c8b1f6", "srcset": "https://si.imgix.net/3ef4b71a/uploads/origins/5c967f97-56e0-41e1-b133-04c8dc13ee71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57267c8e3d90a22c6363920ac8c8b1f6, https://si.imgix.net/3ef4b71a/uploads/origins/5c967f97-56e0-41e1-b133-04c8dc13ee71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f66e7a3502c3b8f187de3238473bdf3 2x, https://si