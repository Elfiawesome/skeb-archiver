orks/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2775211, "client_id": 3537523, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a8e69cd/uploads/origins/088e3203-2ae2-4203-bce2-cab89ff09bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd5ed184bf37c289ce6d9e1ea0e48af1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a8e69cd/uploads/origins/088e3203-2ae2-4203-bce2-cab89ff09bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f6a321feee710bd96fba00701bc6854", "src_set": ""}, "body": "こんにちは！InklingとOctolingのOCでお願いがあります！\n\n二人ともビーチにいて、オクトリングの女の子は青いスクールガール水着を着ていて、インクリングの男の子は黒いスイミングパンツをはいている。彼はまだ赤いメガネとマスクをしている。インクリング少年はオクトリング少女のおっぱいもつかんでいる。オクトリングの女の子は、インクリングの男の子におっぱいをつかまれて恥ずかしそうにしている。\n\nまた、オクトリングの少女にとても大きな胸を与えてください！\n\n参考文献はgoogle driveのフォルダにあります。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/u/1/folders/1owppIVg4DGYlvQ735jl1G9W96ulsX_4V", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hs3_ika/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a36c98a1/uploads/origins/87de12c2-f4eb-488a-aa24-65a1f1bb23a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6030cfd26ead0e18b356588a8d08e025", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2775211, "client_id": 1415908, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Hs3_ika/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator