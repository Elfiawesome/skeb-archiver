200&h=200&s=c15a71e90b97d50635e33b1650f44c1f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be56ee64/uploads/origins/303a9fd7-2732-44a6-b1a6-3fcc2e1fd942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c04a62670459785b52681ac3ef3d5431", "srcset": "https://si.imgix.net/be56ee64/uploads/origins/303a9fd7-2732-44a6-b1a6-3fcc2e1fd942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c04a62670459785b52681ac3ef3d5431, https://si.imgix.net/be56ee64/uploads/origins/303a9fd7-2732-44a6-b1a6-3fcc2e1fd942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6425ed30037520dacfe47fed906a2bf3 2x, https://si.imgix.net/be56ee64/uploads/origins/303a9fd7-2732-44a6-b1a6-3fcc2e1fd942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cf9f7aa02a273ce555d37793fff6fec1 3x"}, "body": "こんにちは！アピールありがとうございます！あなたの作品のスタイル、雰囲気、色彩がとても気に入っています。\nキャラクターがヴァンパイアなので、できれば彼女が豪華な食卓で、血まみれのもの、たぶんステーキを生か少し火を通したものを食べているところを見てみたいです。もちろん、もしご不快であれば、ご自由にお好きなものを描いてください！ありがとうございます！一緒に仕事ができるのを楽しみにしています！\n\nhttps://drive.google.com/drive/u/0/mobile/folders/1S5CMblC9rHiad6eALg9HpMY08HLfFFST", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hiomote/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3634741, "client_id": 2739748, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0e08e7b/uploads/origins/e7c9dcf8-bb52-4032-b8e7-5ee2c950044b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=282c75b12555565a6c66e133f40c4154", "srcset": "https://si.imgix.net/b0e08e7b/uploads/origins/e7c9dcf8-bb52-4032-b8e7-5ee2c950044b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=282c75b12555565a6c66e133f40c4154, https://si.imgix.net/b0e08e7b/uploads/origins/e7c9dcf8-bb52-4032-b8e7-5ee2c950044b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b36cffde84712a425b836730d845f13b 2x, https://si.imgix.net/b0e08e7b/uploads/origins/e7c9dcf8-bb52-4032-b8e7-5ee2c950044b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a85fe1c3ace40b8450654ac4e697dae3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0e08e7b/uploads/origins/e7c9dcf8-bb52-4032-b8e7-5ee2c950044b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f6101cc15be10a48532f89068b948f4", "srcset": "https://si.imgix.net/b0e08e7b/uploads/origins/e7c9dcf8-bb52-4032-b8e7-5ee2c950044b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f6101cc15be10a48532f89068b948f4, https://si.imgix.net/b0e08e7b/uploads/origins/e7c9dcf8-bb52-4032-b8e7-5ee2c950044b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1238ec34291a31a52ee9115202e263d6 2x, https://si.imgix.net/b0e08e7b/uploads/origins/e7c9dcf8-bb52-4032-b8e7-5ee2c950044b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0b66700f87c5defe5aa625313ab60032 3x"}, "body": "はじめまして。  \nアピールありがとうございました！\n\n落ち着いた雰囲気の色合いでありながら、とても印象的でキャラクターの存在感が際立ったイラストに惹かれました。\nぜひ私のオリジナルキャラクターを描いて頂きたいと思いリクエストを送らせていただきます。  \nご縁がありましたらよろしくお願いいたします！  \n\n好奇心旺盛で快活、一見紳士的ですが倫理観が欠けているマッドサイエンティストの男性です。  \n\n容姿はURLをご参照下さい。 \n服装などはアレンジ等ご自由にして頂いて構いません。\n表情・構図などもすべてお任せします。  \n\n描いていただいたイラストは、SNSのアイコンなどプロフィール部分への使用や、依頼する際の参考イラストとして使用させていただく可能性があります。\n\n何か不備がありましたらお手数ですが再送・キャンセルをお願いいたします。  \n\n目を通して頂きありがとうございました。 \nこれからも応援しています！\n\nhttps://drive.google.com/drive/folders/1le47GfdQlh9oSwoDCTVtmQmu9Y3wCYmD", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hiomote/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tippe