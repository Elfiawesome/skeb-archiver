s=600f85db8065622b94bfcbc2e84cd677", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3104035, "client_id": 2228625, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@UMA_mohumohu/works/44", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3104035, "client_id": 1467, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d1102de/uploads/origins/165f6e49-5301-48df-ae55-dd683398ce92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1f0676179124cf38e561999c4458c07", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d1102de/uploads/origins/165f6e49-5301-48df-ae55-dd683398ce92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43240ba189efe434ab8ad563a0d4e606", "src_set": ""}, "body": "はじめまして、月影楼と申します。\n素敵な納品をお見かけしリクをお送りいたしました。\nうちの子狐のお姉さん「翠燐」をリク致します。\n\nキャラデザインは参考資料の通りです。\n資料で不明な点や分かりづらい点は先生の描きやすいように調整・アレンジして頂いて大丈夫です。\n\n衣装は競泳水着・バニー服・チャイナドレスから先生がピンと来たものをお選び下さい。\nそれぞれの衣装デザインはすべてお任せで、\n水着やバニーのときは光沢感とハイレグ感重点、\nチャイナドレスの場合は光沢感とぴっちり感重点でお願いいたします。\n\nその他ポーズや表情、あと盛り具合などはお任せ致します。\n\n宛名につきましてはPSDレイヤーでon/off出来ると嬉しいです。\nよろしくご検討お願い致します。\n\n\nキャラクター資料（立ち絵・３面図・注意事項含む\nURL：https://twitter.com/Tukikagerou/status/1586588803682119680\n※上記ツイのツリーに資料記載\n（耳と双尾先端の緑色のワンポイントは見落としやすいのでご注意ください）\n\nキャラ資料（予備URL）：https://min.togetter.com/VrQdsKr\nこれまでの納品一覧　 ：https://min.togetter.com/Gyo3MrY\nVRCスクショ（VRChatアバター）：https://min.togetter.com/pC5ggJd", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@UMA_mohumohu/works/43", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 310403