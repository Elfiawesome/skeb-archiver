pular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 129}, {"id": 3579575, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "雉サーカス", "screen_name": "kinkan8cc", "avatar_url": "https://pbs.twimg.com/profile_images/1870825962872754176/xzVYEte9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1609600641260990466/1743478471/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 16}]}, "price_history": {"art": [{"amount": 5000, "recorded_at": "2025-10-10T18:57:10.948481"}]}, "works": [{"path": "/@yu_kmkmuri/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2494991, "client_id": 2706525, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1e23f0e/uploads/origins/8f4cebf3-9558-4d89-a2ee-d350bfff2e9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cfaeeda76c418c17359950a65dbacd4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1e23f0e/uploads/origins/8f4cebf3-9558-4d89-a2ee-d350bfff2e9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2d25408e1ec757365387e5fd4558bb8", "src_set": ""}, "body": "ゆげ♨️様\n\n初めまして、個人勢としてVtuber活動をしている御伽の国の住民の粽葉かえりと申します。\n\nリクエストをお送りさせていただきます。\n\n詳細は下記に記載いたします。\n\n──────────\n\n◆使用用途\n・Youtubeのサムネイル、配信、動画内にて使用。\n・SNSでの使用\n\n◆依頼内容\n粽葉かえりのイラスト\n\nVALORANT　フェイドというキャラの衣装を着ているお姿をお願いできますでしょうか。\nhttps://playvalorant.com/en-us/agents/fade/\n\n◆構図\nすべてお任せいたします。\n\n◆その他\n背景をいただける場合、\n人物のみのデータをいただけると嬉しいです\n\n──────────\n\nお忙しいところ恐れ入ります。\nゆげ♨️様がたのしく描いていただければ私自身嬉しく思います。\nご縁がございましたらぜひお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1k95NQlQtkgAfbc2pgii8je_SlDB5hRI_?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yu_kmkmuri/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2494991, "client_id": 1300477, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11b6429d/uploads/origins/b219f5ff-5af0-4a4e-999f-cdc50b10779c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01b240c4ca5e6f2af90d30d1295ff1e6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11b6429d/uploads/origins/b219f5ff-5af0-4a4e-999f-cdc50b10779c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4baa9dd125c8d0a638a9d7911340f32", "src_set": ""}, "body": "ゆげさんこんにちは！\nしがない一次創作している者です。\nゆげさんの絵柄のうちの子が見たいので、描いてくれると嬉しいです！\n何をどう描くかは全てお任せします。\nよろしくお願いします。\n\nhttps://novelup.plus/story/424409277/921146752", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yu_kmkmuri/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2494991, "client_id": 3322863, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2737d599/uploads/origins/d385ece6-5748-4f55-a462-73c0a11a9a11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f896e539755018c7d6bd15f638008878", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2737d599/uploads/origins/d385ece6-5748-4f55-a462-73c0a11a9a11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=587f9091c34e9913e9516b39922f5474", "src_set": ""}, "body": "こんにちは！あなたのスタイルが大好きです。\n\n私のVT