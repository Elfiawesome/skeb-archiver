e_urls": {"src": "https://si.imgix.net/ce11a93e/uploads/origins/011fe9af-9b38-4133-bf0e-0918da4b1473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5165ebb0658f7fbe2cfeeb8d7dabe886", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce11a93e/uploads/origins/011fe9af-9b38-4133-bf0e-0918da4b1473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26de288b1bfe82ae99023985dba858bb", "src_set": ""}, "body": "閃乱カグラ　芭蕉で\n\nポーズ　I字開脚\n恰好 https://www.pixiv.net/artworks/113850755\nやっていただける最大の爆乳　基本1　差分2の3つでお願いしたいです\n基本　\n全身　クソガキたちに指でアナル広げられてやらせてくれるようにおねだりされている　必死に断っている\n\n差分　クソガキにアナルなら大丈夫と太めのペニス一本挿入されている　ニプルにも挿入　\n差分2　まてないクソガキにアナル無理やり二本挿入されて痛がっている\n以上になりますがこれでよろしければお願いいたします", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inaiti_INA/works/93", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6017a95e/uploads/origins/6ea71675-b0ea-4238-9f57-1383af730e91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f19819fbec92c6b684aaddcd97cc9e3", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2466396, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@inaiti_INA/works/92", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2466396, "client_id": 1832132, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e1a360d/uploads/origins/d6ef8316-89a2-431a-b569-4ce31bfaecd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3c6844a6d32beb75a1feb22f118b9d9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e1a360d/uploads/origins/d6ef8316-89a2-431a-b569-4ce31bfaecd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d724a17b9235176cc7eb0ca4153d862", "src_set": ""}, "body": "閃乱カグラでアメスクコスの四季\n\n(参考：シノビマスター 閃乱カグラ NEW LINK ビジュアルアクリルプレート \n四季（爆乳祭）)\n\nキモデブハゲの「たっくん」専用の雌奴隷となっている\n\nビジュアル\n\n1.上記のアメスクコス\n\n2.左目の下に「●と▼」で男子トイレマークの入れ墨\n\n3.おっぱいに「95cm(I)」・「雌牛」と落書き\n\n4.ブラはベースはこのままでオープンブラにして，乳首ピアスを装着させる＋母乳を噴かせる\n\n5.お腹におまんこに向けて矢印＋「たっくん専用」と♡で囲う落書き\n\n\nシーン1(愛撫されながらカメラに向かってドスケベ自己紹介)\n\n※ 「●REC」録画描写\n\n1.右手を目の横で横にしたギャルピース\n\n2.左手は下着が見えるように自らスカートを捲し上げる\n\n3.たっくんは四季の真後ろでおっぱいを指が食い込むほど強く揉んでいる\n\n台詞：死塾月閃女学館 1年 四季です♡ 3サイズは上から 95 54 83 Iカップです♡\n\n          たっくん専用の雌奴隷を務めさせて頂いてま～す♪\n\n          ※ \n上記台詞とは別に小さな吹き出し文字で「ぴ～す♡」「母乳噴いてイっちゃう♡」\n\n\nシーン2(カメラに向かって立ちバック)\n\n※ 「●REC」録画描写\n\n1.四季はWピースさせる(指の角度をハの字の様に)\n\n2.表情は「んほぉぉぉ♡」という感じで涙を流させる\n\n3.乳揺れさせ母乳を撒き散らさせる\n\n4.たっくんは四季の髪を掴み，カメラにしっかり顔を向けさせる\n\n\n台詞：いや～ん♡カメラで四季のアクメ顔撮られて恥ずかしいのにぃ♡\n\n          たっくんのハメ腰すっごいのぉぉ♡ \nこんなの女の子は絶対に耐えられないのぉ♡\n\n\n※ 上記台詞とは別に小さな吹き出し文字で「んほぉぉぉ♡」「イク♡イク♡イックぅぅ♡」", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inaiti_INA/works/91", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2787cd40/uploads/origins/e5d425fc-9753-4bbd-bdc2-fdaf4bdeef7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=167644fbda4ebabfd9320dec11ceed24", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2466396, "client_id": 1556969, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@inaiti_INA