.net/45f87ae5/uploads/origins/990578b6-2053-48e8-97c1-594115fbac30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=461c9d7f1a87949cb7843973d6a82330, https://si.imgix.net/45f87ae5/uploads/origins/990578b6-2053-48e8-97c1-594115fbac30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=76ed5c39f3b5814b61ee1dda9be72215 2x, https://si.imgix.net/45f87ae5/uploads/origins/990578b6-2053-48e8-97c1-594115fbac30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8fdf54e12edd8c6d290a8e518ef921ac 3x"}, "body": "先生、こんにちは。あなたの作品をとても気に入っています。今回は私のオリジナルキャラクター（OC）のイラストを依頼したいです。https://x.com/saechisuki/status/2011607357919543517?s=46&t=nqgJYXt5US-fnHYJf49HzA。\n私のキャラクターはウサギの耳を持つ占星術師です。太陽のように温かいオレンジ色の瞳を持ち、とても明るく人助けが好きな子です。\n要するに上品で活発なキャラクターで、服装はリンク先のスタイルを参考にできます。キャラクター設定に沿った範囲で、先生のご自由なアレンジをお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Monano_sub/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3539199, "client_id": 3814975, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b430308/uploads/origins/862a8217-1a73-495c-b590-d1b3ede95e40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2a3017a5771cdb2a2f973ef3923905e", "srcset": "https://si.imgix.net/0b430308/uploads/origins/862a8217-1a73-495c-b590-d1b3ede95e40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2a3017a5771cdb2a2f973ef3923905e, https://si.imgix.net/0b430308/uploads/origins/862a8217-1a73-495c-b590-d1b3ede95e40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52bc6191519a9cdbe685d822f203eb82 2x, https://si.imgix.net/0b430308/uploads/origins/862a8217-1a73-495c-b590-d1b3ede95e40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aca03f1f222efe2634e960e3182d2070 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b430308/uploads/origins/862a8217-1a73-495c-b590-d1b3ede95e40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd05df7b40ee3deb63b430dd74d6c83c", "srcset": "https://si.imgix.net/0b430308/uploads/origins/862a8217-1a73-495c-b590-d1b3ede95e40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd05df7b40ee3deb63b430dd74d6c83c, https://si.imgix.net/0b430308/uploads/origins/862a8217-1a73-495c-b590-d1b3ede95e40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=36fd1a251209c391ca466ff7a8b5f716 2x, https://si.imgix.net/0b430308/uploads/origins/862a8217-1a73-495c-b590-d1b3ede95e40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eaaeb015e6b2e87c38c955e07232b2b9 3x"}, "body": "初めまして。動画配信等で活動している者です。\nskebからXのイラストを拝見させていただいて女性イラストの描き方が好みだったので依頼させていただきました。\n内容ですが狼面や狼をモチーフとしたもの、もしくは狼耳の男性を描いてもらいたいと思ってます。\nもし男性が描きづらい、イメージが浮きづらい等あれば中性的な雰囲気で描いていただけたらと思います。\nカラーリングは髪が青や藍色で瞳は紫でチャームポイントとして目元にほくろをつけてもらえたらと思ってます。\n服装に関しては上下は袴、インナーにワイシャツ、上掛けに洋風のコート（長短どちらでも）に手袋、下はブーツにしていただけたらと思ってます。\n大体この辺かな？ってのを他ゲーのキャラクリで作ってみて添付するのでそれを参考にして頂けると幸いです。（ゲームの仕様上一部刀が映ってますが無しでお願いします）\nまた、これは思い付きなので有り無しどちらでもいいのですがゲーム配信メインなのでコントローラーの根付みたいな物を付けてくれたらうれしいです。\n仕様用途としてはyoutubeやTwitch、Xのヘッダー等で使いたいのでご承諾いただきたいと思います。\nまた、Vや２DLive等動かすことは考えておりません。\n依頼することがまだ不慣れなのでもしかするとご不便おかけしますがよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1aLmexLOYgWT-sG-1Fhpz2YN0pZV53hmU?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Monano_sub/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3539199, "client_id": 3460949, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e89b4de0/uploads/origins/fecefc1b-b238-42d6-aead-1cf68b434407?bg=%23fff&auto=f