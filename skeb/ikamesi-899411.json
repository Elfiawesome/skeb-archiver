は一度に3本の矢を射ることができる。\n\n🐰キャラクターB。貴族。穏やかな性格。詩が好き。首と両腕に包帯を巻いている。月と縁がある。\n\n豆知識：料理好きだが、作った料理はひどい味。\n\n🤝 関係：2人は同じ目的地に向かう途中で知り合った。赤の他人だが、友情が芽生えるかも？\n\n平安時代のような雰囲気のものを希望します。ポーズや表情はお任せします。何か問題があれば、遠慮なくお断りください。\n\nありがとうございました！\n\n以下リンク👇。\n\nhttps://www.dropbox.com/sh/oar6k52rzyaz2bs/AADWPTI85Bl3gBnStg_VpWJSa?e=1&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikamesi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2612903, "client_id": 2133420, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98ceaaf9/uploads/origins/280a1856-efb1-4c9f-8f2f-050423536f5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08245ec137a308aadd61f9f3f1db3a5a", "srcset": "https://si.imgix.net/98ceaaf9/uploads/origins/280a1856-efb1-4c9f-8f2f-050423536f5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08245ec137a308aadd61f9f3f1db3a5a, https://si.imgix.net/98ceaaf9/uploads/origins/280a1856-efb1-4c9f-8f2f-050423536f5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32e71a92573de1af5be576cf35cd589a 2x, https://si.imgix.net/98ceaaf9/uploads/origins/280a1856-efb1-4c9f-8f2f-050423536f5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60f8b0b0b73eefc09e7db891b1ca1aaf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98ceaaf9/uploads/origins/280a1856-efb1-4c9f-8f2f-050423536f5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc1a6c2fb6326bc6e28598ab8f6263b7", "srcset": "https://si.imgix.net/98ceaaf9/uploads/origins/280a1856-efb1-4c9f-8f2f-050423536f5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc1a6c2fb6326bc6e28598ab8f6263b7, https://si.imgix.net/98ceaaf9/uploads/origins/280a1856-efb1-4c9f-8f2f-050423536f5c?bg=%23f