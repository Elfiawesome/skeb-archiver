向き合っており、それを親友に食べてもらうことが好き。\n\nに立ち絵とキャラクターシート、小物の資料をURLで添付させて頂きます。\n\nhttps://twitter.com/sor_snhr/status/1332990795683491845?s=21\nhttps://www.viviennewestwood-tokyo.com/f/dsg-1627100\n\n＜使用用途＞\nクトゥルフTRPGのセッションにおける立ち絵\nキャラクター紹介のためのSNS等掲載\nSNSやセッションのアイコン等使用におけるトリミングや軽度の加工\n完全に身内向けのアクリルスタンド\n\n私も初めての依頼の為、失礼あればすみません。\n無理のない範囲で、ご検討頂ければ嬉しいです。\n\n応援しております。\n\nhttps://charasheet.vampire-blood.net/3532620", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@you1123581321/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3589352, "client_id": 904464, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c5bc9d9/uploads/origins/e31fd4ba-b859-4b5f-bb8d-cdc9e699f98b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6053eb2fc4e2e0cc85a5e01edc57eeee", "srcset": "https://si.imgix.net/3c5bc9d9/uploads/origins/e31fd4ba-b859-4b5f-bb8d-cdc9e699f98b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6053eb2fc4e2e0cc85a5e01edc57eeee, https://si.imgix.net/3c5bc9d9/uploads/origins/e31fd4ba-b859-4b5f-bb8d-cdc9e699f98b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c88a89420b4d6d95242d86225738f0f2 2x, https://si.imgix.net/3c5bc9d9/uploads/origins/e31fd4ba-b859-4b5f-bb8d-cdc9e699f98b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60a439110fbbb23f470e9d03f176bf9e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c5bc9d9/uploads/origins/e31fd4ba-b859-4b5f-bb8d-cdc9e699f98b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad0a7b590e44450aaea1ad088fc87ab8", "srcset": "https://si.imgix.net/3c5bc9d9/uploads/origins/e31fd4ba-b859-4b5f-bb8d-cdc9e699f98b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad0a7b590