ity illustrations to FANBOX supporters\n・Promotion on social media, etc.\n・Goods for free distribution, etc.\n\nTwintail Reference\nhttps://drive.google.com/file/d/13ZdiKHbuCAbtHn4Qy6Y3yraSEKONh4X3/view?usp=drivesdk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1010yuge1010/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2076892, "client_id": 2762352, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f55f9fe8/uploads/origins/f547906d-6715-4e66-8164-a87a38f2173d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b7574cb071e1635862c253b1d4b159f", "srcset": "https://si.imgix.net/f55f9fe8/uploads/origins/f547906d-6715-4e66-8164-a87a38f2173d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b7574cb071e1635862c253b1d4b159f, https://si.imgix.net/f55f9fe8/uploads/origins/f547906d-6715-4e66-8164-a87a38f2173d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1277597c88344110472a08fb371e2058 2x, https://si.imgix.net/f55f9fe8/uploads/origins/f547906d-6715-4e66-8164-a87a38f2173d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dbed55c043918ea0b6734b5e3049bb58 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f55f9fe8/uploads/origins/f547906d-6715-4e66-8164-a87a38f2173d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc8eff8c4cb434b78fd2eb7cb0bb53b9", "srcset": "https://si.imgix.net/f55f9fe8/uploads/origins/f547906d-6715-4e66-8164-a87a38f2173d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc8eff8c4cb434b78fd2eb7cb0bb53b9, https://si.imgix.net/f55f9fe8/uploads/origins/f547906d-6715-4e66-8164-a87a38f2173d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d6fc2