1d0b/uploads/origins/5da99ae9-49a5-421d-9cf1-5ea87813fc39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b01719180a007cd2a99c7ed3af7f917f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f88f1d0b/uploads/origins/5da99ae9-49a5-421d-9cf1-5ea87813fc39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d4ccb6656db3407cb5e2b5984b3bc8e", "srcset": "https://si.imgix.net/f88f1d0b/uploads/origins/5da99ae9-49a5-421d-9cf1-5ea87813fc39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d4ccb6656db3407cb5e2b5984b3bc8e, https://si.imgix.net/f88f1d0b/uploads/origins/5da99ae9-49a5-421d-9cf1-5ea87813fc39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b45182f2a868c072561a41974053557 2x, https://si.imgix.net/f88f1d0b/uploads/origins/5da99ae9-49a5-421d-9cf1-5ea87813fc39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3255eaa59cc516a5b38c633900a9581f 3x"}, "body": "冬の寒い日にベタベタくっつくレイマリが見たいので、リクエストさせていただきます。\nありがちなシチュエーションな気もしますが、これをひなぎくさんの作風で見てみたいです。\n\nシチュエーションと構図：\n・(ほんとはそこまで寒くないけど)寒さを言い訳にして無邪気に霊夢に抱き着く魔理沙\n・魔理沙の背中と頭の後ろに手を回して抱き返してあげる霊夢\n・二人とも冬の日に外にいるという設定で、マフラー等の防寒着を着けている\n　ただし背景は描いていただかなくても問題ありません\n・二人が抱き合っているところを横から見た構図で、できれば二人の手の位置や表情が分かるように描いていただけると嬉しいです\n\nよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hinagiku417/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2384499, "client_id": 2568174, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c106289/uploads/origins/dcfa8176-66c5-4de4-8c8b-68432adc909f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=805b63d7f5b4fa4dc39121cbf8a8d07b", "srcset": "https://si.imgix.net/8c106289/uploads/origins/dcfa8176-66c5-4de4-