t=crop&crop=top&w=200&h=200&s=4199718805051c17b082ccc104715392, https://si.imgix.net/406306b7/uploads/origins/b10b8f47-36db-47bd-9589-9a02e3115492?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2607246bc691161729ad1fc235cb0486 2x, https://si.imgix.net/406306b7/uploads/origins/b10b8f47-36db-47bd-9589-9a02e3115492?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72db5d23a7c9d29b440bb8c0dc4b802d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/406306b7/uploads/origins/b10b8f47-36db-47bd-9589-9a02e3115492?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2eab3161913b0eb4568eb4ea5786755", "srcset": "https://si.imgix.net/406306b7/uploads/origins/b10b8f47-36db-47bd-9589-9a02e3115492?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2eab3161913b0eb4568eb4ea5786755, https://si.imgix.net/406306b7/uploads/origins/b10b8f47-36db-47bd-9589-9a02e3115492?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=acd1904ecdc7496bda382f5236dacbdb 2x, https://si.imgix.net/406306b7/uploads/origins/b10b8f47-36db-47bd-9589-9a02e3115492?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3bdffb96b7137b7bb5360797ed5aaa59 3x"}, "body": "リクエストさせて頂きます。\nニッチな内容となりますので、もしご迷惑でなければよろしくお願いいたします。\n\nリクエスト内容は以下の通りです。\n\n■キャラクター\n遊戯王のブラックマジシャンガール\n\n■服装\n体操服ブルマ\n\n■シチュエーション\n基本的にバラエティ番組にある内容に近いですが、ホースに繋がった風船を、ブルマの中(前側)に入れられて割れるまで膨らまされている所です。\n\n風船は割れる寸前まで膨らまされていて、ブルマの上や横から少しゴムが食い込み気味ではみ出てる状態です。ホースはブルマの上側から挿入されてる感じでお願いします。\n\nキャラに関しては耳をふさいでいて、風船が割れるのが怖くても必死に耐えている表情でお願いします。(怖がっているセリフがあったら嬉しいです)\nまた、少しでも風船が割れないように、足をがに股にしてブルマの前側のスペースを作っている姿勢でお願いします。(姿勢はイメージ画像を参照してください)\n\n背景は簡単でも良いので体育倉庫のようなイメージで、周りに膨らんだ風船や割れた風船を散りばめてください。料金内で難しければ無くても大丈夫です。\nまたもし料金内で可能でしたら割れたあとの差分も描いていただけたら幸いです。\n\n■シチュエーションイメージ画像\nhttps://imgur.com/a/Rf3i13c\n体勢や風船は上記のイメージで、両手は耳をふさいでいる感じでお願いします。\n\nリクエスト内容は以上です。\n要望が多くてお手数をお掛け致しますが、もし可能であれば、よろしくお願いします", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 124348, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "津久田くるみ", "screen_name": "nyarunyorunyeru", "avatar_url": "https://pbs.twimg.com/profile_images/2025964338331484160/ol7cugzW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2864659689/1653794713/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 4, "complete_expiration_days": 21, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1137983, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "Mlko A1fnad", "screen_name": "ooke", "avatar_url": "https://pbs.twimg.com/profile_images/1995860623469514752/OCeOeEIp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1374026715895275526/1764684698/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 161}, {"id": 1306220, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "おもちパセリ@skeb募集中", "screen_name": "mothipaseri", "avatar_url": "https://pbs.twimg.com/profile_images/2047422028253376512/Adg3KCLo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1232296342778564608/1761899089/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned":