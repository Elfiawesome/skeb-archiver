de9cea-0825-43df-9744-0b5104f47bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bfdec08a0859dfcd06afb2b21686d859 3x"}, "body": "とろなさんの可愛いイラストが大変好みで、イラストを描いてもらえたらなという想いでリクエストを書かせてもらいます。\n脳汁たぎるちゃんというVなのですが、お誕生日が近いということもあって、是非とろなさんの描かれる脳汁たぎるが見たいと思いました。\n\n服装は白いワンピース。ポーズはこちらを振り返りながら右手をこちらに伸ばしている（自分の左手首が掴まれているイメージではあるが、ここが手間であれば私の腕はなくてもいいです）\n　表情は笑顔（目は閉じ切らず、優しさ・愛しさが溢れる感じ。普段よりちょっとだけ細いくらいの目）\n　目線は多分たぎるんの方が身長的に低いので視覚的に少しだけ見下ろす構図（若干の俯瞰構図）になるかと思います。\n\nシチュエーションとしましてはお昼前のデートの待ち合わせ。5-6月のピクニックのイメージでたぎるんが会えたことの嬉しさと、この後にするデートへの楽しさを押し出してもらえたらと思います。\n\nたぎるん以外の人物が写るかは上記にあげた自分の腕が写るかどうか程度で。\n\n背景などは多分二人の世界みたいになりそうなので外観・場所は描きこまなくても大丈夫です。\n\n今回は誕生日イラスト企画で使う点を考えるのであれば、上記にある１枚で差分は基本的には大丈夫です。とろなさんの表情練習や時間の余裕があるならば、完全に目を閉じた笑顔とちょっとむすっとした表情があったらお願いしたい所です。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 138817, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "壽@skeb募集中", "screen_name": "bukitikikaku", "avatar_url": "https://pbs.twimg.com/profile_images/1377123448569307146/iebZ7W4B.jpg", "header_url": "https://pbs.twimg.com/profile_banners/938843350160982016/1677470029/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 25, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 49}, {"id": 1410760, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "真田しろ", "screen_name": "sanada_46", "avatar_url": "https://pbs.twimg.com/profile_images/1842977249735393280/L7jiM7lf.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1287692914689105920/1728311286/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "