or_id": 2625615, "client_id": 229883, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e6d2371e/uploads/origins/c7a64dfe-e953-4ff0-bca6-b8986c586232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96f7641f8f4872e4374cfedffebfd523", "srcset": "https://si.imgix.net/e6d2371e/uploads/origins/c7a64dfe-e953-4ff0-bca6-b8986c586232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96f7641f8f4872e4374cfedffebfd523, https://si.imgix.net/e6d2371e/uploads/origins/c7a64dfe-e953-4ff0-bca6-b8986c586232?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a8a1c7e23437d59af58a9134416bcba 2x, https://si.imgix.net/e6d2371e/uploads/origins/c7a64dfe-e953-4ff0-bca6-b8986c586232?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a28c6b80e40329fbda05f13d69cf5f0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e6d2371e/uploads/origins/c7a64dfe-e953-4ff0-bca6-b8986c586232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03bf5ed20b4ad46944106ba6ea21ea63", "srcset": "https://si.imgix.net/e6d2371e/uploads/origins/c7a64dfe-e953-4ff0-bca6-b8986c586232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03bf5ed20b4ad46944106ba6ea21ea63, https://si.imgix.net/e6d2371e/uploads/origins/c7a64dfe-e953-4ff0-bca6-b8986c586232?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c79418d49bfc10a43726204e6df0c308 2x, https://si.imgix.net/e6d2371e/uploads/origins/c7a64dfe-e953-4ff0-bca6-b8986c586232?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3720aedb07130faa5de43f2248899260 3x"}, "body": "初めまして、めいねんと申します！\nْ様のイラストの可愛くてカッコいい絵柄や彩度控えめの色づかいがとても素敵で、\nぜひお願いさせていただきたいと思いましたのでリクエストを送らせていただきます！\n\n自作のクトゥルフ神話TRPGシナリオ「殺屋と首輪」(そぎやとくびわ)\nに登場するキャラクターを描いていただきたいです！\nお送りする資料にシナリオに関するネタバレはないのですが、\nNPCのプロフィールや性格などの情報が含まれますのでご注意ください...！\n\n・シナリオの雰囲気\n殺し屋がテーマで、基本的に殺伐としていて冷たく、命が失われていく儚いお話なのですが、合間に心が温まるようなシーンや切なくて悲しくなるようなできごともあり、彼らは殺し屋でありながらも仕事以外では普通の人々とほとんど変わらない日常を送っていて、複雑な感情を抱きながらも前を向いて生きている...というような内容を描いた作品になります...！お話の雰囲気はGUNSLINGER GIRLやDARKER THAN BLACK 流星の双子に似ていると思います！\n\n・キャラクター資料\n信頼関係のある2人になります！\nhttps://drive.google.com/drive/folders/1YR9aCZnTHrRufw8HPi18vafsFtQ0ZTsD?usp=sharing\n\n・イラストのイメージなど\n殺し屋の仕事中、または仕事を終えた2人をお願いしたいです！\n可能であれば、2人とも少し返り血を浴びていて、\n武器か煙草を持たせていただけるととても嬉しいです...！\n\nイラストの使用用途は主にTwitter(X)、YouTubeになります！\n可能であれば、キャラクターのみの透過済みのものもいただけますと助かります！\n\n難しそうな場合には遠慮なくキャンセルしていただいて大丈夫です...！\nどうぞ宜しくお願いいたします！！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_sakma/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f725203d/uploads/origins/48c5ecb4-5747-4270-95a4-fa2ef6e93ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=afc0a8f5d684482cf2772165abb589a1", "srcset": "https://si.imgix.net/f725203d/uploads/origins/48c5ecb4-5747-4270-95a4-fa2ef6e93ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=afc0a8f5d684482cf2772165abb589a1, https://si.imgix.net/f725203d/uploads/origins/48c5ecb4-5747-4270-95a4-fa2ef6e93ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b973cdc33b65c4bca27adf2ca64e8ba 2x, https://si.imgix.net/f725203d/uploads/origins/48c5ecb4-5747-4270-95a4-fa2ef6e93ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=693b8a60a529741cfc79de16141ad653 3x"}, "private": true, "genre": "art", "tip