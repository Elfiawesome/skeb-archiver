整然とした印象や、ノスタルジックな趣、少しアンティークな雰囲気が彼女の性格に合います。\n\nただし構図の配置や小物の選択はご自由に決めてください。ポーズについてもご判断にお任せします。あなたの芸術的センスを完全に信頼しております。\n\nご検討いただき誠にありがとうございます！\n\nhttps://www.dropbox.com/scl/fo/upb49q5evl5y6mum3f88k/AOJDJszuqlZCEiTS8erXsbs?rlkey=ymyoaefrf6h8lhi0c674icsbv&e=1&st=6yvpu5dg&dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@star_furu/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3181007, "client_id": 2333635, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad31d17e/uploads/origins/cc3454d4-8d4a-4b58-963a-4ff24f63c61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bfe8bad6e9305120ca3d47ad205d066", "srcset": "https://si.imgix.net/ad31d17e/uploads/origins/cc3454d4-8d4a-4b58-963a-4ff24f63c61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bfe8bad6e9305120ca3d47ad205d066, https://si.imgix.net/ad31d17e/uploads/origins/cc3454d4-8d4a-4b58-963a-4ff24f63c61d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06719776826a2d8c45dd54a200c06fef 2x, https://si.imgix.net/ad31d17e/uploads/origins/cc3454d4-8d4a-4b58-963a-4ff24f63c61d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bd18f9b1885f89119caa2cb5633b9d8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad31d17e/uploads/origins/cc3454d4-8d4a-4b58-963a-4ff24f63c61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=006ab6c8006ecfe13e631debb8229b4c", "srcset": "https://si.imgix.net/ad31d17e/uploads/origins/cc3454d4-8d4a-4b58-963a-4ff24f63c61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=006ab6c8006ecfe13e631debb8229b4c, https://si.imgix.net/ad31d17e/uploads/origins/cc3454d4-8d4a-4b58-963a-4ff24f63c61d?bg=%23fff&auto=format%2Ccompress&fm=w