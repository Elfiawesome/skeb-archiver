て「大井川鐵道のSLキャップ」を被った状態にして頂きたいです。(側面のプレートの数字は「C11  227」を希望、サイズ的に潰れてしまうようならプレートを実物より大きめにして頂いても大丈夫です)\n\nポーズ:Googleドライブ内のリンク内に添付した、「じゃ〜ん」のポーズ\n\n表情:「普通の微笑み」、「>ワ<(じゃ〜ん顔)」、「ドヤ顔」、「ニッコリ笑顔」の差分を頂きたいです\n\n利用目的:完全な個人利用ですが、アクリルスタンドを作製して自身が所有するSLの模型と並べて写真が撮りたい(Xに写真をアップする可能性も有ります)と考えております。\n\nお手数をおかけしますが、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Arx7n_90s76xLaTPEbXHqA8916G_Ix-a", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hyashiro_88/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2829718, "client_id": 1293775, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c140febb/uploads/origins/093bee54-b0d4-4bc7-960e-c37436175e50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0db575cc90b1b6777fe015fc7e4e8c99", "srcset": "https://si.imgix.net/c140febb/uploads/origins/093bee54-b0d4-4bc7-960e-c37436175e50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0db575cc90b1b6777fe015fc7e4e8c99, https://si.imgix.net/c140febb/uploads/origins/093bee54-b0d4-4bc7-960e-c37436175e50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f2f9f6f2ec92802b8b196d5f90103e2 2x, https://si.imgix.net/c140febb/uploads/origins/093bee54-b0d4-4bc7-960e-c37436175e50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a2c5eb4058b42a62ff456a7d25daab7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c140febb/uploads/origins/093bee54-b0d4-4bc7-960e-c37436175e50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed8b0e43b271740d2aebf5697b5d1b11", "srcset": "https://si.imgix.net/c140febb/uploads/origins/093bee54-b0d4-4bc7-960e-c37436175e50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed8b0e43b271740d2aebf5697b5d1b11, https://s