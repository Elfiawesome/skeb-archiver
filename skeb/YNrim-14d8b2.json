=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=29ad75164dccf917f88ba3465a32c1ab 2x, https://si.imgix.net/2e7af235/uploads/origins/3ec383e0-f1a1-42e3-bf47-d610f0fc2d35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a73dbd5606498e8c6890956fc7cbf8c 3x"}, "body": "やのらいむ様 はじめまして！きびと申します。\nXにてポップでユニークなイラストに一目惚れをし、是非とも やのらいむ様の絵柄で私のOCを見てみたくなり、リクエストさせていただきました。\n\n〇リクエスト内容\n資料内複数キャラがいるのですが、人物D(赤髪の男性)をお願いしたいです。\n\n〇使用用途\n・紙に印刷\n\n〇希望\n可能であれば、イケメンに描いていただけると大変嬉しいです。\n構図、表情などはおまかせいたします🙇‍♀️\n\n〇備考\n人物Dは服装が2種類ありますが、今回は黒スーツの方でお願いしたいです。\n\nその他の理由で不都合等ありましたら 遠慮なくお断りください。 ここまで読んでいただき、ありがとうございました！ ご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1_BrwfLscT7ZjsRo-nnpjTFYyLbqOAuAa", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@YNrim/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 158006, "client_id": 3058445, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f267120/uploads/origins/777b3274-6d7d-4616-b42a-77ca9874f4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11f292d70801092a9589be0d9871e049", "srcset": "https://si.imgix.net/9f267120/uploads/origins/777b3274-6d7d-4616-b42a-77ca9874f4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11f292d70801092a9589be0d9871e049, https://si.imgix.net/9f267120/uploads/origins/777b3274-6d7d-4616-b42a-77ca9874f4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a4b983372cbd242e96ec4920f4a6c73 2x, https://si.imgix.net/9f267120/uploads/origins/777b3274-6d7d-4616-b42a-77ca9874f4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2070b278df75fe44023b13c8f7a21c83 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f267120/uploads/origins/777b3274-6d7d-4616-b42a-77ca9874f4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99e42b59413fd047976825f93c71fdc6", "srcset": "https://si.imgix.net/9f267120/uploads/origins/777b3274-6d7d-4616-b42a-77ca9874f4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99e42b59413fd047976825f93c71fdc6, https://si.imgix.net/9f267120/uploads/origins/777b3274-6d7d-4616-b42a-77ca9874f4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a62fb607dd00281db6f2d3738889390d 2x, https://si.imgix.net/9f267120/uploads/origins/777b3274-6d7d-4616-b42a-77ca9874f4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=09c1e7e090a246a467bf4a3ab1ca949b 3x"}, "body": "初めまして。SNSで見た絵柄がとても可愛らしくて好きです！もしよければ私のOCを描いて欲しいです。\n\n外見や衣装の詳細はURLにまとめています。せいなはスレンダーな体型で、音夢はバストを大きめに描いて欲しいです。その他のポーズや構図はお任せいたします。二人は同じ高校のクラスメイトで、魔法少女として共闘する友達でもあります。\n\n一人目…中村せいな（ピンク色の魔法少女）\n性格…前向き。基本的には笑ってなんでも許しちゃうようなおおらかさがある。普段から笑顔を絶やさないが、それは周りから嫌われること＝ひとりぼっちになることを異様に恐れているため。\nhttps://drive.google.com/drive/folders/1l7vGcTXMCSZdLQCGNqr3SC2l1Itq9pDR\n\n二人目…田中音夢（紫色の魔法少女）\n性格…ネガティブ。6歳上の優秀な姉と比べられがちで劣等感が強い。自分はいてもいなくても変わらない、という考えがあり、自分を犠牲にしがち。\nhttps://drive.google.com/drive/folders/1gVxiHsfmwE-uy5XrOPjPrUAUs_1etUn8\n\nお手隙の際にご検討いただければ幸いです。どうぞよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@YNrim/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 158006, "client_id": 2628835, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1af95852/uploads/origins/30463e0a-9798-4401-88ff-cde796c9089e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7083452fb63d69e0226d578c9c24b5f", "srcset": "https://si.imgix.net/1af95852/uploads/origins/30463e0a-9798-4401-88ff-cde796c9089e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7083452fb63d69e0226d578c9c24b5f, https://si.imgix.net/1af95852/uploads/origins/30463e0a-9798-4401-88ff-cde796c9089e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ca35bcc69da7720195396aeecfef286 2x, https://si.imgix.net/1af95852/uploads/origins/30463e0a-9798-4401-88ff-cde796c9089e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=745910f987a9f8812760975cf2b6ad9c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1af95852/uploads/origins/30463e0a-9798-4401-88ff-cde796c9089e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5adc6d8db728e60d5decf79e285cb9b6", "srcset": "https://si.imgix.net/1af95852/uploads/origins/30463e0a-9798-4401-88ff-cde796c9089e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5adc6d8db728e60d5decf79e285cb9b6, https://si.imgix.net/1af95852/uploads/origins/30463e0a-9798-4401-88ff-cde796c9089e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f7933db027c4277109ac4c12204198a2 2x, https://si.imgix.net/1af95852/uploads/origins/30463e0a-9798-4401-88ff-cde796c9089e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=af415226200109d68d4a26cccd38ecd7 3x"}, "body": "Misskeyのどこかでいつもお世話になっております！\nやのらいむさんの絵柄でうちの子(OC)を描いていただきたいです！\n\nただし、OCと言っても『版権系オリキャラ/二次創作オリキャラ/夢主』という類になり、ご無理なさらずにご検討頂ければ幸いです。URL先の資料についても版権に関わるイラストが含まれますがご容赦ください。\n\n複数のOCの資料が入っています。描きやすそうな子を選んでください。どの子でも描いていただけたら嬉しいです。表情もお任せです。\n肌や髪などの色は必ずしもの指定ではないので、近い範囲で使いやすい色をお使いください。また細かい箇所もOCを作った本人がよくわかってない部分もあるので適当に省略などして大丈夫です。\n版権要素はなるべく含まないでほしいです。資料内の版権要素のない服を使っても良いですし、好きな服を着させても大丈夫です。またはバストアップ以上や角度などで版権要素が見切れるなどの描き方でも大丈夫です。\n\nと色々と書きましたがシンプルに【うちの子をどの子か描いてほしい】というリクエストです！\n\nガイドラインにおける『クライアントと紐づいたSNSのアカウントに限り、クリエイターの許可なく、データを添付してシェアしたり、プロフィール画像として使用することが可能です。』という点について、描いて頂いた際にはこのskebアカウントと紐づいているMisskey．ioのアカウントで画像をそのように投稿するかと存じます。\n\nお忙しいとは思いますが描いて頂ける場合はのんびりとどうぞです！ご