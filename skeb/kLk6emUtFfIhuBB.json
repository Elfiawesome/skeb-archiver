200&s=64b928613a1a6721ed580b547c69df6c", "srcset": "https://si.imgix.net/45b45fbc/uploads/origins/daaf3bba-79ba-4391-84bc-540da43a504a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64b928613a1a6721ed580b547c69df6c, https://si.imgix.net/45b45fbc/uploads/origins/daaf3bba-79ba-4391-84bc-540da43a504a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=47327c187822de5cad587f53dd4c78ab 2x, https://si.imgix.net/45b45fbc/uploads/origins/daaf3bba-79ba-4391-84bc-540da43a504a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=954278256220b8c4d16a3c23752493a3 3x"}, "body": "さんでー様\n\n初めまして。Twitchで配信活動をしております、おこめ。と申します。\n\nSkebにてさんでー様のイラストを見つけて絵柄やふわふわな色づかい、雰囲気がとても素敵で是非わたしも描いていただきたいと思い、リクエストさせて頂きました。\n\n-使用用途-\n・200人記念のポストカード(デジタル)でデスクトップやスマホ画像用\n\n・SNS投稿\n\n-参考資料-\nまだ全然キャラができていないので、グラーデーションや服はさんでー様に全ておまかせします！好きにかわいく描いちゃってください✨\n\n-お願い-\nデスクトップ用をメインにしたいので、デスクトップにしたときにキャラの胸まで映る感じで描いてほしいです。\nスマホの画像にもするので膝上くらいまでだと大丈夫です！\n緑のとうがらしのクッションをぎゅっとハグしてる感じ、私が頭の中でイメージしてる絵も載せておきます。\n全然さんでー様が考えたかわいいポーズで大丈夫です🙇\n宛名や背景等レイヤー分けされているキャラクターのみの透過pngを頂ければ幸いです。\n\n初めてSkebをさんでー様に依頼するため、至らない点がありましたら申し訳ありません。\n\nお忙しい中だと思いますが、ご検討のほど何卒よろしくお願いします。\n\nhttps://drive.google.com/file/d/1eH5aHmE32_oR7FfmleUfSOtbEwNrkQYO/view?usp=sharing, https://drive.google.com/file/d/1kLJmh5WzaDSEm8kCN8El_DSHt1xuFeO-/view?usp=sharing, https://drive.google.com/file/d/1koT_8QEP4t-ykMY4m7oYPs7bL0oWbiqs/view?usp=sharing, https://drive.google.com/file/d/1r6lO4U-iU6uVE39RlgY3-y6A-2dr5GfM/view?usp=sharing, https://drive.google.com/file/d/1yn5WbWUqEwTPo5TdXq2spB6NSKeqVAPR/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kLk6emUtFfIhuBB/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 986737, "client_id": 3550306, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/601267ed/uploads/origins/e92e79b1-3618-4e3f-88ee-128b2cf9e1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65915ebf721775e8eef1af3f237ea263", "srcset": "https://si.imgix.net/601267ed/uploads/origins/e92e79b1-3618-4e3f-88ee-128b2cf9e1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65915ebf721775e8eef1af3f237ea263, https://si.imgix.net/601267ed/uploads/origins/e92e79b1-3618-4e3f-88ee-128b2cf9e1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67e7e1ca1b4484a9402c8ca9f691c22b 2x, https://si.imgix.net/601267ed/uploads/origins/e92e79b1-3618-4e3f-88ee-128b2cf9e1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4e9f74cf120ffa7cc515fd7fbd595f6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/601267ed/uploads/origins/e92e79b1-3618-4e3f-88ee-128b2cf9e1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f01791abe6058be8a1c30651cd43d84", "srcset": "https://si.imgix.net/601267ed/uploads/origins/e92e79b1-3618-4e3f-88ee-128b2cf9e1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f01791abe6058be8a1c30651cd43d84, https://si.imgix.net/601267ed/uploads/origins/e92e79b1-3618-4e3f-88ee-128b2cf9e1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f08f0b2c3d2d43723f7a1f5a9606294d 2x, https://si.imgix.net/601267ed/uploads/origins/e92e79b1-3618-4e3f-88ee-128b2cf9e1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=26c6aaee8a7b39ce8838c59adaddcb8a 3x"}, "body": "はじめまして。\n個人VTuberの 天羽シア（あまはね しあ） と申します。\n\nこの度、天羽シア（うちの子）のイラストをお願いしたく、リクエストを送らせていただきました。\n詳しい参考資料は、以下のGoogleドライブにまとめております。\n\n【リクエスト内容】\n・キャラクター：天羽シア\n・構図・ポーズ：おまかせ（可愛い雰囲気でお願いいたします）\n・可能でしたら頭が切れないように全体を描いていただけると嬉しいです\n・人物と背景を分けたPSD（またはレイヤー分けデータ）での納品ですと嬉しいです\n\n【利用用途】\n・ファンクラブでの利用\n・X（旧Twitter）やYouTubeなどでの宣伝・告知素材として使用予定\n\n素敵な作品を拝見し、ぜひ天羽シアを描いていただきたいと思いました。\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1l5SjlN7filydsDScqLx59kbkqUsHC3U5/view?usp=drivesdk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kLk6emUtFfIhuBB/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 986737, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a909931d/uploads/origins/acddb420-6445-46e6-8b5b-bd54cce44e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12243edb486349d92a6f812c17be3092", "srcset": "https://si.imgix.net/a909931d/uploads/origins/acddb420-6445-46e6-8b5b-bd54cce44e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12243edb486349d92a6f812c17be3092, https://si.imgix.net/a909931d/uploads/origins/acddb420-6445-46e6-8b5b-bd54cce44e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=888ee282fde1553004a0af3cfaf3bf00 2x, https://si.imgix.net/a909931d/uploads/origins/acddb420-6445-46e6-8b5b-bd54cce44e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1bf02279a5fb744caf1f4b3ffe293637 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a909931d/uploads/origins/acddb420-6445-46e6-8b5b-bd54cce44e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffe2cf5306934c909692ec7e3f5089a9", "srcset": "https://si.imgix.net/a909931d/uploads/origins/acddb420-6445-46e6-8b5b-bd54cce44e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffe2cf5306934c909692ec7e3f5089a9, https://si.imgix.net/a909931d/uploads/origins/acddb420-6445-46e6-8b5b-bd54cce44e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=26a187b835aec69e031c1be0790bcd8b 2x, https://si.imgix.net/a909931d/uploads/origins/acddb420-6445-46e6-8b5b-bd54cce44e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e970fb87aa82eaf26d726a471dd42a4 3x"}, "body": "My name is Mikuri Hoshigoromo, a Vtuber belonging to UniVIRTUAL.\n\nI like Sande-sama's illustrations very much, so I have made this request.\n\nI would like her pose and facial expression to be cute!\n\nPlease\nI would like to use it as a thumbnail,\nIf possible, we would appreciate a transparent PNG or PSD of the character only, with the address, background, etc. layered.\n\nReference Materials\nWe would appreciate it if you could refer to a standing picture of the clothes from the URL of the reference material. (We don't have a three-sided drawing yet, so you can just imagine what you can't see!)\nI am an idol-type Vtuber.\n\n\nI am an idol-type Vtuber.\nThumbnails for videos and distribution\nPosting on SNS\nUse as a calendar of images for fan sites to give back.\nWe would be grateful for your permission.\n\nWe understand that you are busy,\nWe would be very grateful if we could have a chance to work with you...!\n\nhttps://drive.google.com/file/d/1fupDdByccmt70SUd8VBYocbg6TS4puIF/view?usp=drivesd", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kLk6emUtFfIhuBB/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 986737, "client_id": 3142126, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c78641e/uploads/origins/c9133c72-a2b1-4574-8b89-2d1a013e58c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7336a1748045eb60a62a641dcbd53cfa", "srcset": "https://si.imgix.net/9c78641e/uploads/origins/c9133c72-a2b1-4574-8b89-2d1a013e58c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7336a1748045eb60a62a641dcbd53cfa, https://si.imgix.net/9c78641e/uploads/origins/c9133c72-a2b1-4574-8b89-2d1a013e58c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1be3a6e4c87006cf1004d27495b268c9 2x, https://si.imgix.net/9c78641e/uploads/origins/c9133c72-a2b1-4574-8b89-2d1a013e58c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c08ed3c050e347399441fdb1b297b8da 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c78641e/uploads/origins/c9133c72-a2b1-4574-8b89-2d1a013e58c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10acfa1bc12c3d8203e465561c9aedf4", "srcset": "https://si.imgix.net/9c78641e/uploads/origins/c9133c72-a2b1-4574-8b89-2d1a013e58c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10acfa1bc12c3d8203e465561c9aedf4, https://si.imgix.net/9c78641e/uploads/origins/c9133c72-a2b1-4574-8b89-2d1a013e58c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9b9e1292abcd505bc94824ba0b5307e1 2x, https://si.imgix.net/9c78641e/uploads/origins/c9133c72-a2b1-4574-8b89-2d1a013e58c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3b8cff3d8cc3480f7fed10fed240e21 3x"}, "body": "Buddha, sutras and priesthood\n\nHello, my name is Honoka Yokaya, and I am a Vtuber.\nI saw your Skeb on X, and I would love to have you draw my character as well, so I made a new request.\nThank you very much for your consideration!\n\n┈┈┈┈┈┈┈┈┈┈┈┈\nIntended use\n(1) Non-profit use (I will not sell goods or the illustrations I received.\n(2) Use in post images on X and use as thumbnails for distribution (Monetization is turned on for distribution.)\n\nCharacter\nName: Honoka Yokaya\nHeight: 162 cm Personality: Energetic Age: Adult\nCharacter Motif / Bear and checkered pattern. Her image color is blue-green (mint, Hatsune Miku's hair color).\nWhen she smiles with her eyes closed, she has a troubled eyebrow.\n\nRequest Details\nI would like you to leave the composition, pose, and situation to me!\n\nIf possible, we would appreciate it if you could give us a transparent version of the background in addition to the integrated version.\nI would appreciate it if you could give me a transparent version of the background in addition to the integrated version.\nI would appreciate it if you could give me a transparent version of the background as well as an integrated version of the background! 🙇‍♀️\n\nWe would appreciate your consideration!\n┈┈┈┈┈┈┈┈┈┈┈┈\n\nCharacter design details\nhttps://drive.google.com/file/d/1nKQmQqdwY2u-tywVFkjodoPHOQeakjh2/view?usp=sharing\nStanding picture (high quality)\nhttps://drive.google.com/file/d/15ubpovN7Zz2H9GAfO4nXSudGDczdUI0p/view?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kLk6emUtFfIhuBB/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 986737, "client_id": 3269571, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f079962/uploads/origins/910e2a9f-6599-4757-be49-898409c78f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4328cfcd7a7375faa5f66917ba7a93e6", "srcset": "https://si.imgix.net/0f079962/uploads/origins/910e2a9f-6599-4757-be49-898409c78f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4328cfcd7a7375faa5f66917ba7a93e6, https://si.imgix.net/0f079962/uploads/origins/910e2a9f-6599-4757-be49-898409c78f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a672332b630fcc2cdb24accea86132a2 2x, https://si.imgix.net/0f079962/uploads/origins/910e2a9f-6599-4757-be49-898409c78f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e0229fef2062d95208566898caff56b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f079962/uploads/origins/910e2a9f-6599-4757-be49-898409c78f6e?bg=%