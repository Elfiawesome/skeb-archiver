ヘアクリップには光ったり色が変わったりする矢印がついているのが特徴です。\n好きなものは、バブルティー、リズムゲーム、歌、ダンス、猫、虹色やキラキラしたかわいいもの。\n\nゲームセンターでDDRをしている姿や、カラオケに行っている姿を描いてみてはいかがでしょうか。服装は参考リンクのキャラクターシートにあるオリジナルのものでお願いします。DeeDeeのデザインが気に入ったら、おまけで表情や服のデザイン、ポーズなどを描いてもいいですね。\n\n可愛くて迫力のある絵をお願いします。♡\n\n私のリクエストを考慮していただきありがとうございます。\nそれでは、今日も一日お疲れ様でした\n\nhttps://drive.google.com/drive/folders/15rNW3cFvUkwZRjJvift-uZn-GGxTOK1S?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@omisonchan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1693363, "client_id": 1717905, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/565087f6/uploads/origins/536d3d34-b023-4250-ad2e-2eb540005a06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b8fb1301da1f3aec8314f188afecb7b", "srcset": "https://si.imgix.net/565087f6/uploads/origins/536d3d34-b023-4250-ad2e-2eb540005a06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b8fb1301da1f3aec8314f188afecb7b, https://si.imgix.net/565087f6/uploads/origins/536d3d34-b023-4250-ad2e-2eb540005a06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c991cd254a28ad89de9daa79f531dd55 2x, https://si.imgix.net/565087f6/uploads/origins/536d3d34-b023-4250-ad2e-2eb540005a06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62664ff0c86324d4575be3541167a42e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/565087f6/uploads/origins/536d3d34-b023-4250-ad2e-2eb540005a06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00e0e9086fe462502a955b1542c0af87", "srcset": "https://si.imgix.net/565087f6/uploads/origins/536d3d34-b023-4250-ad2e-2eb540005a06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00e0e9086fe462502a955b1542c0af87, https://si.im