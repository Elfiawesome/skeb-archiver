。先生のえっちで素敵なイラストがより多くの方に楽しまれることを願っております。\n\n年末のお忙しい所恐縮ですが、ご検討の程よろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AngstromDayo/works/99", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 8198, "client_id": 465200, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c228001/uploads/origins/c6f95aeb-b042-45a5-b91e-58f858d566d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8b6d96b33540849e85b04b66bd2b5d4", "srcset": "https://si.imgix.net/3c228001/uploads/origins/c6f95aeb-b042-45a5-b91e-58f858d566d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8b6d96b33540849e85b04b66bd2b5d4, https://si.imgix.net/3c228001/uploads/origins/c6f95aeb-b042-45a5-b91e-58f858d566d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edb64ac0c5982df1e7a9bb32429ab0b5 2x, https://si.imgix.net/3c228001/uploads/origins/c6f95aeb-b042-45a5-b91e-58f858d566d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0f38d23347737d6f030140ae1d7468a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c228001/uploads/origins/c6f95aeb-b042-45a5-b91e-58f858d566d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28b99f1d34f85ad0e4cb552928f83b21", "srcset": "https://si.imgix.net/3c228001/uploads/origins/c6f95aeb-b042-45a5-b91e-58f858d566d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28b99f1d34f85ad0e4cb552928f83b21, https://si.imgix.net/3c228001/uploads/origins/c6f95aeb-b042-45a5-b91e-58f858d566d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=969444f2bcf7353fc5abb1330e9093a7 2x, https://si.imgix.net/3c228001/uploads/origins/c6f95aeb-b042-45a5-b91e-58f858d566d2?bg=%23fff&auto=format%2Ccompress&