る、というものです。\n場所はトイレ(男性用小便器の前)で、夕雲、提督共に服を着ており、夕雲は立ちションするためにノーパンで、後ろにいる提督が手を前に回して夕雲のスカートをめくっている状態を想定してます。あと細かい部分ですが、女性はクリトリスが勃起すると尿道も引っ張られておしっこが前に飛びやすくなるらしいので、元のイラストの通り提督が夕雲のクリトリスを刺激して立ちションしやすくさせようとしている感じです。しかし初めての立ちションだったので、結局半分程度しか前に飛ばず、残りは太腿を伝って夕雲のニーソやブーツを濡らしてしまっているという描写もあると大変ありがたいです。ただ、このプレイ自体は楽しむことが目的なので、元のイラストと同じく夕雲は足元の状況に目もくれず提督とイチャついているという感じを想定してます。\n以上、受けていただけるようでしたら宜しくお願い致します。\n\nhttps://x.com/angstromdayo/status/1753983408072692039?s=61&t=cecjdNf08fp2Uieb9B2Hgw", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AngstromDayo/works/86", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 8198, "client_id": 448481, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef762c70/uploads/origins/81e6588c-9514-4d64-bcd5-3868420269a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d3a19820689f1a4498d24a19a11370a", "srcset": "https://si.imgix.net/ef762c70/uploads/origins/81e6588c-9514-4d64-bcd5-3868420269a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d3a19820689f1a4498d24a19a11370a, https://si.imgix.net/ef762c70/uploads/origins/81e6588c-9514-4d64-bcd5-3868420269a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1abed129bc372896bd82e477459c0b1d 2x, https://si.imgix.net/ef762c70/uploads/origins/81e6588c-9514-4d64-bcd5-3868420269a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2205e454631844b797e176de51917021 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef762c70/uploads/origins/81e6588c-9514-4d64-bcd5-3868420269a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=032a46a02a381d3bdd5a4ba868900006", "srcset": "https://si.imgix.net/ef762c70/uploads/origins/81e6588c-9514-4d64-bcd5-3868420269a8?bg=%23fff&auto=format%2Ccompress&fm=w