立ちション姿なのですが、今回はシンプルに斜め下から見上げた構図だけのイラストでお願いします。(小便器は透過するか無しで)\nどの娘にされるかはお任せしますが、普段着もしくは私服などでロングブーツを履いている娘でお願いします。(例えば神風型など)\n更に、例によって立ちションが上手くできず脚やブーツに伝ってしまっているような描写があると大変ありがたいです。\n以上、受けていただけるようでしたら、何卒宜しくお願い致します。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AngstromDayo/works/95", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 8198, "client_id": 1071896, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f20b5ba2/uploads/origins/6ff488b5-a53f-4c94-aa96-6169b4e8d7d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc9884165710bd1396d2f621051db5a3", "srcset": "https://si.imgix.net/f20b5ba2/uploads/origins/6ff488b5-a53f-4c94-aa96-6169b4e8d7d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc9884165710bd1396d2f621051db5a3, https://si.imgix.net/f20b5ba2/uploads/origins/6ff488b5-a53f-4c94-aa96-6169b4e8d7d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=296251d7be2229ef85fd8cc67963c9e2 2x, https://si.imgix.net/f20b5ba2/uploads/origins/6ff488b5-a53f-4c94-aa96-6169b4e8d7d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd0fbc9240a5785913666f7020fe82c8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f20b5ba2/uploads/origins/6ff488b5-a53f-4c94-aa96-6169b4e8d7d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5656064322725e0408ed87e1984b822", "srcset": "https://si.imgix.net/f20b5ba2/uploads/origins/6ff488b5-a53f-4c94-aa96-6169b4e8d7d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5656064322725e0408ed87e1984b822, https://si.imgix.net/f20b5ba2/uploads/origins/6ff488b5-a53f-4c94-aa96-6169b4e8d7d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9160990c954513