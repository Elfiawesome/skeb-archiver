く使うことで、世界と世界の間のヴェールが薄くなり、彼女の存在に誘われて人間界に入り込み始める妖怪たちを引き寄せる。\n\n玲は優雅なポーズで描いてほしい。白い般若の面を片手に持ち、あるいは腰に差して、魅惑的な笑みを浮かべて見る人を見つめてほしい。彼岸花のモチーフはオプション。\n\nリクエストをお読みいただき、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1BLLDNX30NhKJ1UsSsvXYCmq6W8upepwn", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@z_we6n/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3568143, "client_id": 2873979, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/750bf39d/uploads/origins/58bf12bd-03b3-4234-b562-a3e1213311e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84276834ad017ac07fe6ecb481216a20", "srcset": "https://si.imgix.net/750bf39d/uploads/origins/58bf12bd-03b3-4234-b562-a3e1213311e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84276834ad017ac07fe6ecb481216a20, https://si.imgix.net/750bf39d/uploads/origins/58bf12bd-03b3-4234-b562-a3e1213311e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6c894afd40e652a404b8bec6397b90e 2x, https://si.imgix.net/750bf39d/uploads/origins/58bf12bd-03b3-4234-b562-a3e1213311e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f4b13e7996addef42c40cd2ab4863dc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/750bf39d/uploads/origins/58bf12bd-03b3-4234-b562-a3e1213311e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=604b5cfae9451068873af5a7f35e265f", "srcset": "https://si.imgix.net/750bf39d/uploads/origins/58bf12bd-03b3-4234-b562-a3e1213311e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=604b5cfae9451068873af5a7f35e265f, https://si.imgix.net/750bf39d/uploads/origins/58bf12bd-03b3-4234-b562-a3e1213311e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h