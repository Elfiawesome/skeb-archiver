ar.com/avatar/3c0d59e949e4cfd2ffb68c77142d0977030821529f4190fbc76c9ac215c7f6c0?size=1500\n\n以上、よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 2122292, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "健康法", "screen_name": "da_da114", "avatar_url": "https://pbs.twimg.com/profile_images/1512040182823874561/iMni-DmZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1512039883921002498/1768318802/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 2240037, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "牛乳(skeb小説依頼募集中)", "screen_name": "gyunyupixiv", "avatar_url": "https://pbs.twimg.com/profile_images/1857726889810620416/R_GvNtxS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/864845396/1732436871/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 27, "skills": [{"genre": "novel"}], "banned": false, "nc": 33}, {"id": 3130753, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ねこのは🐾", "screen_name": "naminecokiri", "avatar_url": "https://pbs.twimg.com/profile_images/1593554096707244033/dMCEHdd6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1593226983961669634/1668772313/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned"