るさき/ちゃるさきオリキャラ参考資料も添付させていただきました！\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1JbRk2TlhYrOPcUSzSV9N5LuX5zL2YrdC?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_saba_77/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6a857963/uploads/origins/f8355a59-802c-464a-a57b-c55aeab42acf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=081976b00f98824cddadb3ced510695d", "srcset": "https://si.imgix.net/6a857963/uploads/origins/f8355a59-802c-464a-a57b-c55aeab42acf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=081976b00f98824cddadb3ced510695d, https://si.imgix.net/6a857963/uploads/origins/f8355a59-802c-464a-a57b-c55aeab42acf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc488c56ec9f1c49fd6a29721e7395db 2x, https://si.imgix.net/6a857963/uploads/origins/f8355a59-802c-464a-a57b-c55aeab42acf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6170a53b391e2920f4b5ff8fef5ebc0 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 3798194, "client_id": 727718, "nc": 0}, {"path": "/@_saba_77/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d2af38c3/uploads/origins/1e836bd9-0e4c-4880-b314-84a1da66d685?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b3b5e20e08fc44614aa9c67007ea4d9c", "srcset": "https://si.imgix.net/d2af38c3/uploads/origins/1e836bd9-0e4c-4