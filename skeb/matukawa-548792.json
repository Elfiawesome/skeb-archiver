://si.imgix.net/2115981e/uploads/origins/04a2904a-dde9-434a-87a3-d0eca0987481?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd0c45c2f12d16bf58a6d889cbfdfe6d 3x"}, "body": "初めまして！リクエスト募集とのことでよろしくお願いします！\n\n先生の作品の睡華に出てくる\n千紗（ツインテの貧乳）のイラストをお願いしたいと思います。\n\n下着姿（上下違う下着）と全裸で\nニーソックスを履いて\n眠らされて横倒しにされて犯される寸前\n（睡華25ページのような体位で顔がよく見えるように）\nのイラストをお願いしたいと思います。\n\n是非とも受け付けてもらえると幸いです。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@matukawa/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 22839, "client_id": 1027250, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/552e1a06/uploads/origins/4e16d120-db0e-4e38-88c7-82db1f687f88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faacb9cc69bda17aabb5463a5c5880a5", "srcset": "https://si.imgix.net/552e1a06/uploads/origins/4e16d120-db0e-4e38-88c7-82db1f687f88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faacb9cc69bda17aabb5463a5c5880a5, https://si.imgix.net/552e1a06/uploads/origins/4e16d120-db0e-4e38-88c7-82db1f687f88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7921f2bd4e4b2673a6bf10e8c940f24d 2x, https://si.imgix.net/552e1a06/uploads/origins/4e16d120-db0e-4e38-88c7-82db1f687f88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0984cf177ab84193e301d726d06665d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/552e1a06/uploads/origins/4e16d120-db0e-4e38-88c7-82db1f687f88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8723f4fbf64157ad7280fea4c8e22f4", "srcset": "https://si.imgix.net/552e1a06/uploads/origins/4e16d120-db0e-4e38-88c7-82db1f687f88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8723f4fbf64157ad7280fea4c8e22f4, https://si.imgix.net/552e1a06/uploads/origins/4e16d120-db0e-4e38-88c7-82db1f687f88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c86ab189417797b44b2493c37b3c82b 2x, https://si.imgix.net/552e1a06/uploads/origins/4e16d120-db0e-4e38-88c7-82db1f687f88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=12b586c22da9b1e26603a40820985663 3x"}, "body": "初めまして。\n\n5年ほど前の作品ですが、松河先生の『比較対象』（資料URL）がお気に入りの一つです。\n徐々に”パパ“のペースに乗せられて、ショーツに染みをつくってしまうJKがどストライクです。\n枕に顔をうずめて我慢する様子と、ちらりと見える乳首もとても好きです。\n\n今回のskebでは、こちらのシーンの続きをカラーイラストにて描いていただけないでしょうか。\n\n●キャラクター\n椎菜ちゃん（資料URL）\nURLと同じ制服、ショーツ着用でお願いします。\n今回も資料URLのように、股間部分のアップを\nカットインでいただきたいです。\n\n●シチュエーション\n・URLの場面後、”パパ“の手技で何度も絶頂させられてしまい、ぐったりとしている椎奈ちゃん。\nショーツを愛液で広範囲に濡らしただけでなく、ワイシャツが肌に張りついて透けて見えるほど、汗だくになっている状態です。\n・椎奈ちゃんはハアハアと荒く息を吐きつつ、悔しそうな表情を浮かべて、両目から涙を流し枕を濡らしている状態です。\n口から垂れたよだれも枕や制服に糸を引いており、乳首も勃起しているようお描き下さい。\n股間からは、白濁した彼女の本気汁が溢れてショーツに絡みついている状態です。\n・”パパ“が射精した精液は、ほとんどがスカートにかかってしまい、べっとり染み付いているようにお描き下さい。\n\n以上、液体描写、彼女の屈辱感を多めに描いていただければ幸いです。\n\nまた可能であれば、絶頂失禁してベットに大きな染みをつくった差分もお願いします（難しければ不要です）\n\n●ファイル\nPSDデータにてお願いします。\nもし可能であれば、キャラクターと背景はレイヤーを分けていただきますようお願いします。 \n\n難しい内容でありましたらキャンセル、もしくはお手数ですが再送依頼を頂けましたら幸いです。\n\nhttps://fantia.jp/posts/417301", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 95254, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "しろがね🌱", "screen_name": "sirogane", "avatar_url": "https://pbs.twimg.com/profile_images/1476389727305875457/C9Nl6Iq_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/22873862/1636938081/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 45, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 120819,