b98192e/uploads/origins/b818e30d-18f1-4895-ba60-72280970070a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9ae14fb44a9f16124c335e46471f5446 3x"}, "body": "こんにちは、あなたのイラストは素敵ですね。私のキャラクターを描いていただけませんか。\n\n参考画像：https://drive.google.com/drive/folders/1y1G5C-jimBSyoBRc64CzJumj42NlbLFG\n\nハサキは、自己愛が強く、尊大で人気のある女の子です。とても得意げな様子です。アルビノです。\nそれにもかかわらず、彼女はかなり優しい性格です。\n\nぜひ自由に描いてみてください。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MAGURO_SOS/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2458187, "client_id": 1194784, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3ca5b9a/uploads/origins/ae54534f-a59a-444d-8a63-20c4ad7ca2e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b61f6ba0d7c0e652cfb00d0a6ae686e3", "srcset": "https://si.imgix.net/d3ca5b9a/uploads/origins/ae54534f-a59a-444d-8a63-20c4ad7ca2e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b61f6ba0d7c0e652cfb00d0a6ae686e3, https://si.imgix.net/d3ca5b9a/uploads/origins/ae54534f-a59a-444d-8a63-20c4ad7ca2e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17e9bb973358fa186cb0da29f1035cfd 2x, https://si.imgix.net/d3ca5b9a/uploads/origins/ae54534f-a59a-444d-8a63-20c4ad7ca2e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b6eef2d3534f9e4ca98a1a841e5688f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3ca5b9a/uploads/origins/ae54534f-a59a-444d-8a63-20c4ad7ca2e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e6081560fa40320586e017e4e29a31d", "srcset": "https://si.imgix.net/d3ca5b9a/uploads/origins/ae54534f-a59a-444d-8a63-20c4ad7ca2e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e6081560fa40