\n定期的にアイコンに使わせていただこうと考えています。\n\n資料①：https://drive.google.com/drive/folders/1kKjBX6jI3xkWn6luAT6IZS4E3SNYj3U2\n資料②：https://drive.google.com/drive/folders/1-4A80C-dLKls_dYsAq47syFGEIEGYomO\n\nよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tetuw/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3374324, "client_id": 1792698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2832ed6e/uploads/origins/ff4369e2-3f3f-484a-8c7a-b9897f3ffe22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74aea9875008f89b3f34395167bd9a1d", "srcset": "https://si.imgix.net/2832ed6e/uploads/origins/ff4369e2-3f3f-484a-8c7a-b9897f3ffe22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74aea9875008f89b3f34395167bd9a1d, https://si.imgix.net/2832ed6e/uploads/origins/ff4369e2-3f3f-484a-8c7a-b9897f3ffe22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e8ce0cb195a6fcd1c610e4827bde712 2x, https://si.imgix.net/2832ed6e/uploads/origins/ff4369e2-3f3f-484a-8c7a-b9897f3ffe22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b0ca07a47120f387e2d148c9d3c7617 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2832ed6e/uploads/origins/ff4369e2-3f3f-484a-8c7a-b9897f3ffe22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffee055230dce124aebb4864f37e1daa", "srcset": "https://si.imgix.net/2832ed6e/uploads/origins/ff4369e2-3f3f-484a-8c7a-b9897f3ffe22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffee055230dce124aebb4864f37e1daa, https://si.imgix.net/2832ed6e/uploads/origins/ff4369e2-3f3f-484a-8c7a-b9897f3ffe22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81127b7735d81e5b197a06efa