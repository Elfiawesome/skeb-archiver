を見きれないようお願いします。\n\n\n【サイズ】\n3人の集合と背景と各キャラは分けたデータ、一人一人のPSDを納品頂けると嬉しいです。サイズは各それぞれが3000×4000、dpi600 ⇐以上であれば問題ありません。\n\n\n【使用用途】\n入賞した際にポスターとして掲載する可能性（※ランキングですので確定ではありません）・配信・サムネ・SNS・グッズ・印刷物・返礼品・頒布等\n\n\n不慣れで拙い文章ではありますが最後までお読み頂きありがとうございます。掲載イベントが近いですがぜひ宜しくお願い致します🙇‍♀️💓‪\n\nhttps://drive.google.com/drive/folders/15buNeSNXjcdJqa4todZpFzThkdUcXvp0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kiryu_takase/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 903647, "client_id": 1807877, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ff8d479/uploads/origins/952d91d9-ae74-40db-a2a7-e4ec29c963a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9dc30b11dbc03672587ad214a7c4e66", "srcset": "https://si.imgix.net/1ff8d479/uploads/origins/952d91d9-ae74-40db-a2a7-e4ec29c963a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9dc30b11dbc03672587ad214a7c4e66, https://si.imgix.net/1ff8d479/uploads/origins/952d91d9-ae74-40db-a2a7-e4ec29c963a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de0bd212d4c33dfbb74807be8c3053a1 2x, https://si.imgix.net/1ff8d479/uploads/origins/952d91d9-ae74-40db-a2a7-e4ec29c963a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45ef5a89e6890bf16a9485bf11112865 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ff8d479/uploads/origins/952d91d9-ae74-40db-a2a7-e4ec29c963a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b58109a839c2eaf5800bf6b8b2ba1cec", "srcset": "https://si.imgix.net/1ff8d479/uploads/origins/952d91d9-ae74-40db-a2a7-e4ec29c963a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b58109a839c2eaf5800bf6b8b2ba1cec, https://si.imgix.net/1ff8d479/uploads/origins/952d9