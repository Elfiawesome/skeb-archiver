p=top&w=200&h=200&s=39588d1f29e63d5d4a1c3aeba1f4caab 2x, https://si.imgix.net/1bafb4db/uploads/origins/cadaab4d-dd31-4874-882b-6edccbc4d268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=418c822dea3765171841184b56947026 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1bafb4db/uploads/origins/cadaab4d-dd31-4874-882b-6edccbc4d268?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c696ec4a533deaa588330790ad32558c", "srcset": "https://si.imgix.net/1bafb4db/uploads/origins/cadaab4d-dd31-4874-882b-6edccbc4d268?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c696ec4a533deaa588330790ad32558c, https://si.imgix.net/1bafb4db/uploads/origins/cadaab4d-dd31-4874-882b-6edccbc4d268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=37d8a7ffa52c68d35618f83e3062abe2 2x, https://si.imgix.net/1bafb4db/uploads/origins/cadaab4d-dd31-4874-882b-6edccbc4d268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=500c8ccf88695bf18510bf3878e256f7 3x"}, "body": "はじめまして。IRIAMでVliver活動をしている月城礼亜と申します。\nSkebを見てイラストのタッチが非常に好きだったので、\n私もご依頼させていただきたいと考え、ご連絡いたしました。\n（ピンク髪の女の子のイラストが好きです）\nよろしければ、下記ご確認の上描いていただけますと幸いです。\n\n■希望のイラスト\n私自身を描いていただければと思っております。\nよろしければ、季節感のある（クリスマスやお正月）衣装をお願いできないでしょうか。\n表情や背景などはお任せいたします。\nまた、もし可能であれば別の表情も描いていただけますと嬉しいです…！\n\n■使用用途\n配信活動におけるサムネイルや返礼品（ネップリやヘッダー、缶バッジ等）\nサムネイル等に使用するため、髪の毛の先や指の先等が切れていない構図だと嬉しいです。\n\n■その他\n背景がある場合、人物のみの透過もいただけますと幸いです…！\nPSDとPNGデータ両方いただけますと大変嬉しく存じます。\n\nご縁があると嬉しいです。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1xSFnNjiilJiwwpAaEqflhy43XbnNI3cn/view", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kiryu_takase/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 903647, "client_id": 2855705, "vtt