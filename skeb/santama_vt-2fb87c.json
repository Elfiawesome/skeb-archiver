umbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1870632, "client_id": 751755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ebf0df24/uploads/origins/6b629541-4a5c-492e-b398-087da1b378e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99fcf5c926d6cae901f3d6085b3626a9", "srcset": "https://si.imgix.net/ebf0df24/uploads/origins/6b629541-4a5c-492e-b398-087da1b378e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99fcf5c926d6cae901f3d6085b3626a9, https://si.imgix.net/ebf0df24/uploads/origins/6b629541-4a5c-492e-b398-087da1b378e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c62c15562a8541fe1bd4c6c6073df173 2x, https://si.imgix.net/ebf0df24/uploads/origins/6b629541-4a5c-492e-b398-087da1b378e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64aa33b91e17be4fd2518d5db138f20e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ebf0df24/uploads/origins/6b629541-4a5c-492e-b398-087da1b378e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ceb67f077d3e6af8cb52669d74d1c3b", "srcset": "https://si.imgix.net/ebf0df24/uploads/origins/6b629541-4a5c-492e-b398-087da1b378e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ceb67f077d3e6af8cb52669d74d1c3b, https://si.imgix.net/ebf0df24/uploads/origins/6b629541-4a5c-492e-b398-087da1b378e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed9bcff7f8b7c24c2087f21f550c52e3 2x, https://si.imgix.net/ebf0df24/uploads/origins/6b629541-4a5c-492e-b398-087da1b378e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c1bbbee530a4bad8acd4f34f9bd10e81 3x"}, "body": "あらためましてさんたま先生、こちらでははじめまして、牛の王子さまでち@86kと申します。\n先だっては先走ってしまい、大変失礼いたしました。\n再度先生がskebで依頼を受けられていると知り、飛んできました！\n早速リクエストさせていただきます。\nよろしければで結構ですのでお受けいただければ幸いです。\n\n【作品】フラワーナイトガール\n【キャラクター】ハツユキソウ（花騎士）\nhttps://i.imgur.com/b2FNAPo.png\n正面首元はこちらになります\nhttps://i.imgur.com/HWi038U.png\n髪型と体型につきましてはこちらの方がわかりやすいと思います\nhttps://i.imgur.com/ketEKFQ.png\n（腰まである白髪ストレートロングでやや小ぶりのおっぱいに大きめのお尻の子です）\n【衣装】ウェディングドレス姿\n\n【シチュエーション】\nウェディングドレス姿で笑顔のハツユキソウをお願いいたします。\n左手が見えるのであれば薬指に金色の指輪（作中の祝福の指輪のイメージですが、シンプルな金の指輪で結構です）をしている姿をお願いします。\n\n具体的なイメージとしましては、団長さんとハツユキソウの結婚式で、彼女が団長さんを待ってたたずんでいる姿をお願いします。視点は団長さん視点でお願いします。\n彼女が結婚式に着るであろうドレスについては全て先生の御裁量にお任せいたします。\n可能であれば、満面の笑顔と、はにかんでいる顔と、調子に乗ってドヤっている顔の表情差分があれば嬉しいです。\n\n先生にウェディング姿のハツユキソウを可愛らしく描いていただきたいとの思いでの依頼です。\n\n以上が私の要望ですが、わかりにくい点や難しい点等ございましたら先生のやりやすいようにアレンジしていただいて構いません。\n是非ともよろしくお願いいたします。\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%8F%E3%83%84%E3%83%A6%E3%82%AD%E3%82%BD%E3%82%A6", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 241326, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "べんあわー", "screen_name": "awa_ben_0521", "avatar_url": "https://pbs.twimg.com/profile_images/1954054241750069256/pdQ3Y35X.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1081924676702486529/1713712869/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}], "nc": 161}, {"id": 285802, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Darjeeling@Skeb募集中", "screen_name": "xdarjeelingxtea", "avatar_url": "https://pbs.twimg.com/profile_images/1587012861372473344/ZNVDbJWg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3151075550/1606468000/1500x500", "appeal_receivable": false, "popular_creator_rank": 50, "request_master_rank": null, "first_requester_rank": null, "deleted_at": nul