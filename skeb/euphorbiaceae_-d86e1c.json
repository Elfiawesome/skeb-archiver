、その他いかなる営利活動にも使用しません。\nどのような用途においても、作者の名前と出典を明記します。\n\n[依頼内容]\nモリは28歳、身長172cmで、先天性心疾患を持っています。 彼女は静かで優しい性格です。\n詳細や服装の参考画像は、添付のURLをご確認ください。\nモリにふさわしいと思うどんなシーンでも構いませんので、彼女の日常の情景を描いてください！\n\nもし予算が不足する場合は、ご希望の金額をお知らせください。喜んで足し足しさせていただきます。 お時間を割いてリクエストをお読みいただきありがとうございます。素晴らしい作品を楽しみにしています！\n\nhttps://drive.google.com/drive/folders/1BUGOgx7k43RvNw-mEjTaqgiEA7He7FB1?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@euphorbiaceae_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3903219, "client_id": 19126, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5edd510b/uploads/origins/125087d1-277e-4e8b-8cdf-3a7a6dacee7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b4f3007a37c0a37ea366eaecac6e175", "srcset": "https://si.imgix.net/5edd510b/uploads/origins/125087d1-277e-4e8b-8cdf-3a7a6dacee7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b4f3007a37c0a37ea366eaecac6e175, https://si.imgix.net/5edd510b/uploads/origins/125087d1-277e-4e8b-8cdf-3a7a6dacee7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d43378a75bcb7172add0b9f60800b18 2x, https://si.imgix.net/5edd510b/uploads/origins/125087d1-277e-4e8b-8cdf-3a7a6dacee7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05cc1382b732d5bb3c95022e32a88138 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5edd510b/uploads/origins/125087d1-277e-4e8b-8cdf-3a7a6dacee7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=347dca1fed7bd4cfe101ff1e0d59608a", "srcset": "https://si.imgix.net/5edd510b/uploads/origins/125087d1-277e-4e8b-8cdf-3a7a6dacee7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=347dca1fed7bd4cfe101ff1e0d59608a, https://si.imgix.net/5