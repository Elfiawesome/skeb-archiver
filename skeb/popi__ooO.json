n指定等はとくにありません！服やヘアアレンジ等もお任せします。 ぽぴ様のお好きに描いていただければと思います！\n\n【用途】\n基本デジタル画像、印刷での個人観賞です。 なにか不備あれば申し訳ありません。 料金や依頼文等で気になるところがあれば再送依頼をいただけると助かります。  よろしくお願いします🙇‍♀️  ̖́-", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@popi__ooO/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2808892, "client_id": 3550165, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e0bd5f5/uploads/origins/fb6509bc-c3b7-44cd-9934-4249fd69ec66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92789c469fd2f937012556a093bfc098", "srcset": "https://si.imgix.net/8e0bd5f5/uploads/origins/fb6509bc-c3b7-44cd-9934-4249fd69ec66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92789c469fd2f937012556a093bfc098, https://si.imgix.net/8e0bd5f5/uploads/origins/fb6509bc-c3b7-44cd-9934-4249fd69ec66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf011baf3483e2f050640e07d9d8c24d 2x, https://si.imgix.net/8e0bd5f5/uploads/origins/fb6509bc-c3b7-44cd-9934-4249fd69ec66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0faea7d35f9e3c50f21a52fdf166e6c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e0bd5f5/uploads/origins/fb6509bc-c3b7-44cd-9934-4249fd69ec66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8b04e014f9b617289d947ec7922a647", "srcset": "https://si.imgix.net/8e0bd5f5/uploads/origins/fb6509bc-c3b7-44cd-9934-4249fd69ec66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8b04e014f9b617289d947ec7922a647, https://si.imgix.net/8e0bd5f5/uploads/origins/fb6509bc-c3b7-44cd-9934-4249fd69ec66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b54cc8c56f37b3cb2cf2f00adcc4024 2x, https://si.imgix.net/8e0b