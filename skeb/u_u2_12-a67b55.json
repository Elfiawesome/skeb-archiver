200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=038eae103cf91db0636c24f625995619", "srcset": "https://si.imgix.net/fba84a75/uploads/origins/b825f050-f6e0-408f-8090-9d33b44c37ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=038eae103cf91db0636c24f625995619, https://si.imgix.net/fba84a75/uploads/origins/b825f050-f6e0-408f-8090-9d33b44c37ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72a29d237642ae3135d8f9f46eb49936 2x, https://si.imgix.net/fba84a75/uploads/origins/b825f050-f6e0-408f-8090-9d33b44c37ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23a0733097e86d67f41951ca82d3655d 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2973285, "nc": 160}, {"path": "/@u_u2_12/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2973285, "client_id": 2100, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6072083a/uploads/origins/a4c0b605-ded4-4343-9eb9-10bd567f8a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cc676d0d89fe52723ddfd369e6edfb7", "srcset": "https://si.imgix.net/6072083a/uploads/origins/a4c0b605-ded4-4343-9eb9-10bd567f8a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cc676d0d89fe52723ddfd369e6edfb7, https://si.imgix.net/6072083a/uploads/origins/a4c0b605-ded4-4343-9eb9-10bd567f8a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b267748ad03f13336e6cc65368327cf7 2x, https://si.imgix.net/6072083a/uploads/origins/a4c0b605-ded4-4343-9eb9-10bd567f8a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57158a2acea8047f092b4130fa7b02e6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6072083a/uploads/origins/a4c0b605-ded4-4343-9eb9-10bd567f8a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bc8e63c43ec9d705717bd96ebfcab18", "srcset": "https://si.imgix.net/6072083a/uploads/origins/a4c0b605-ded4-4343-9eb9-10bd567f8a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bc8e63c43ec9d705717bd96ebfcab18, https://si.imgix.net/6072083a/uploads/origins/a4c0b605-ded4-4343-9eb9-10bd567f8a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9771896b9aa0817d7daea82155f0a092 2x, https://si.imgix.net/6072083a/uploads/origins/a4c0b605-ded4-4343-9eb9-10bd567f8a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=14610d5337d89b4b51499bfefe4c3cf4 3x"}, "body": "初依頼失礼します\n新着順から素敵な作品を見かけてご依頼したいと思いました\n知り合いのOCの白い狐な女の子とうちのOCの男の組み合わせで描いてもらいたいです\n作者側から諸々の許諾は得ておりますのでご心配なく\n参考資料をドライブに用意しておきました\n\n【描いてほしい内容・重要な要素】\n・どエロいデザインのシスター服　またはモンハンのアスール装備(ガンナー用)のコスプレで中出しセックス(体位はお任せします)\n・結婚しているので指輪付き(重要/男性側と相互/片方は見えて欲しい)\n・サイン等をする場合はレイヤー等オンオフ切り替えができると幸いです\n・https://skeb.jp/@u_u2_12/works/11のスタイルがいいなと思ったのでこの形に近いと嬉しいです\n\n女性側の要点\n・身長は170cm\n・顔と結合部は見えてほしい\n・エッチな事は好き(快楽には素直　というか弱い)\n・受けか攻めかで言うと受け寄り\n・若干こっちの方がお姉さんなのでご奉仕などでリードできる時はしたい感じ\n・バック系の体位が好き(必ずしもそうである必要はありません)\n・挿入される事と中出しされるのが好き\n・着痩せする方なので胸はかなり大きめ\n・陰毛描写は不要\n・普段はクールな性格だが婚約者の前ではやや恥じらいが出る\n・アヘ顔とかみたいな下品寄りなのは避けてほしい\n・明確に子作りが目的なので基本ゴムはしない\n\n男性側の要点\n・身長は189cm\n・筋肉の引き締まった細身、所謂細マッチョ(青年想定)\n・男側の描写量は肌色があまり濃すぎない事以外は必要最低限でお願いします(他のリク絵のように手や身体の一部が映る程度、極論体色や体格がよほど乖離してなければそこまで問題ありません)\n\nあると嬉しい要素(可能な限りで構いません)\n・耳や尻尾の感情表現(尾を動かしたり身体に絡めたりとか)\n・事後表現などで受精描写\n・胸揉みか乳首責め\n\nよろしければご検討頂けると幸いです\nまた、完成品は他に依頼を行う時等に資料として引用する事をご了承ください\n\nhttps://drive.google.com/drive/folders/1d0t9xx3Pt9Luy1H3ikLxMXL0-9IMCj64?usp=sharing", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_u2_12/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2973285, "client_id": 1451518, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a14b3c97/uploads/origins/2f12a2a3-0dd0-4928-b29d-e6aa5e35710a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ed1e5cd50586dab82d844958d030674", "srcset": "https://si.imgix.net/a14b3c97/uploads/origins/2f12a2a3-0dd0-4928-b29d-e6aa5e35710a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ed1e5cd50586dab82d844958d030674, https://si.imgix.net/a14b3c97/uploads/origins/2f12a2a3-0dd0-4928-b29d-e6aa5e35710a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2260196da2d920c1beb7ba24920358a2 2x, https://si.imgix.net/a14b3c97/uploads/origins/2f12a2a3-0dd0-4928-b29d-e6aa5e35710a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83dc44102c80f527f023993b6b3076ec 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a14b3c97/uploads/origins/2f12a2a3-0dd0-4928-b29d-e6aa5e35710a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a4b619d6e7fecd88c50aef413f45bc3", "srcset": "https://si.imgix.net/a14b3c97/uploads/origins/2f12a2a3-0dd0-4928-b29d-e6aa5e35710a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a4b619d6e7fecd88c50aef413f45bc3, https://si.imgix.net/a14b3c97/uploads/origins/2f12a2a3-0dd0-4928-b29d-e6aa5e35710a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f48369ac7bfe1bbd72ba93d27ed7e7e9 2x, https://si.imgix.net/a14b3c97/uploads/origins/2f12a2a3-0dd0-4928-b29d-e6aa5e35710a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2983de88c0af55165202e551aad3098f 3x"}, "body": "初めまして。貴方の鳴潮の絵が可愛かったのでリクエストしようと思いました。\nR-18もいけそうなのでそのような内容を依頼します。\n版権物のR18ですがもし良ければお願いします。\n\n[作品名]\n鳴潮\n\n[キャラ名]\nシャコンヌ\n\n必要ないかもですがキャラの見た目の資料は、下記URLのドライブやモデル配布サイトを参照してください。\n\nhttps://drive.google.com/drive/u/0/folders/1YwsyVMF9zYQ2m3CoY0hsMWrCSDss3kWh\nhttps://www.aplaybox.com/details/model/AvGpJ96ajwav\n\n[シチュエーション]\n激しめセックス\n\n[想定している状況]\n接合部からばちゅんばちゅんという音が聞こえてきそうなぐらい液体多めの激しめのセックスをしているがとても気持ちよくなっている\n\n[体位]\n下記のようなバック\n\nhttps://drive.google.com/drive/u/0/my-drive\n\n[補足]\n- シチュエーションがあっていれば[想定している状況]や[体位]を変えていただいて問題ございません。\n- 服装や構図、細かい部分、書いてない部分等についてはお任せします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_u2_12/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2973285, "client_id": 345289, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bfdbff4a/uploads/origins/4ba16453-c32b-4594-a256-432d46a02522?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa38bc246f6d88857798db97c699b024", "srcset": "https://si.imgix.net/bfdbff4a/uploads/origins/4ba16453-c32b-4594-a256-432d46a02522?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa38bc246f6d88857798db97c699b024, https://si.imgix.net/bfdbff4a/uploads/origins/4ba16453-c32b-4594-a256-432d46a02522?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb3350e94c8561ae9b387120ef3e045f 2x, https://si.imgix.net/bfdbff4a/uploads/origins/4ba16453-c32b-4594-a256-432d46a02522?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cde6e36531816e922ccc5fab3c40db00 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bfdbff4a/uploads/origins/4ba16453-c32b-4594-a256-432d46a02522?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6180761b7bbea82c63dca