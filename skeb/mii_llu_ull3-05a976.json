に再アピールしてください。\n\n私のOC、ラム（♂）はおとぎ話のような物語を持っています。彼はかつて強力な魔法使いだったが、悪事を働いた罰として人間に呪いをかけられ、魔法を失ってしまった。呪いを解くためには、罪を償い、善人になることを学ばなければならない。無力な彼は現在、人間の教会で暮らし、仕えているが、ラムが現在の苦境に憤りを感じていることは周知の事実だ。\nラムは尊敬されることを切望しているが、身長が小さい（140cm）のが難点だ。ラムはただ、自分が真面目な魔法使いであることを証明し、皆の上に立ちたいだけなのだ！\n\nこのOCの説明が参考になれば幸いです！訳がおかしかったらごめんなさい。あとはお任せします。ありがとうございました！(๑ᴖ◡ᴖ๑)(๑ᴖ◡ᴖ๑)\n\nhttps://drive.google.com/file/d/1-RFhWtuHOZWzbtqlu3Bve8uZVKDxKZXm", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mii_llu_ull3/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3256374, "client_id": 3236640, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cfdef545/uploads/origins/6c9f85b1-81a2-4a45-87f0-2332cd255f42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15532e78c26919b884b99a965f4ac1c1", "srcset": "https://si.imgix.net/cfdef545/uploads/origins/6c9f85b1-81a2-4a45-87f0-2332cd255f42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15532e78c26919b884b99a965f4ac1c1, https://si.imgix.net/cfdef545/uploads/origins/6c9f85b1-81a2-4a45-87f0-2332cd255f42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65d98e857e8ac7abfa1ce2c2fd553b8d 2x, https://si.imgix.net/cfdef545/uploads/origins/6c9f85b1-81a2-4a45-87f0-2332cd255f42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6c5b0c7f4d8ad15ef2332b0e6f70a3f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cfdef545/uploads/origins/6c9f85b1-81a2-4a45-87f0-2332cd255f42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c89a1edf63d129d92b23be7b7e6fab0", "srcset": "https://si.imgix.net/cfdef545/uploads/origins/6c9f85b1-81a2-4a45-87f0-2332cd255f42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c89a1edf63d129d92b