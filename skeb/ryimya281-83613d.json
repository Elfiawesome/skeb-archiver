rop=top&w=200&h=200&blur=200&s=f823b060585ea0f1c1508af571be2092 3x"}, "body": "初めまして、さんそと申します。\nSkebにて作品を拝見し、ぜひイラストを描いていただきたいと思い、リクエストしました！\n初音ミク(マジカルミライ2016メインビジュアル、通称幕張ちゃん)を描いていただきたいです。元気で明るい感じが全面に出ている形を希望します。\nサイズは16:9でお願い致します。また、背景につきましては明るくポップな感じで、できれば音符もあると嬉しいです。\n主に自分のパソコン画面での壁紙で使用する予定です。また、初音ミクやVRchat関連のイベントで使用する名刺、SNSのアイコンなど個人での使用となります。\n何卒、ご検討をお願い致します！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ryimya281/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1953190, "client_id": 2288505, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d85eacb/uploads/origins/5368be9d-3c91-45a2-a404-caf8356c9090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2df5ed7550c1a3af3e88bd3520aacf43", "srcset": "https://si.imgix.net/2d85eacb/uploads/origins/5368be9d-3c91-45a2-a404-caf8356c9090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2df5ed7550c1a3af3e88bd3520aacf43, https://si.imgix.net/2d85eacb/uploads/origins/5368be9d-3c91-45a2-a404-caf8356c9090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=097d4663f209024ead480f5637c6eb78 2x, https://si.imgix.net/2d85eacb/uploads/origins/5368be9d-3c91-45a2-a404-caf8356c9090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d71faef7a3093efc002898b56711bc1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d85eacb/uploads/origins/5368be9d-3c91-45a2-a404-caf8356c9090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=907efeb2df73f5203f0ebdc630617d06", "srcset": "https://si.imgix.net/2d85eacb/uploads/origins/5368be9d-3c91-45a2-a404-caf8356c9090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=907efeb2df73f5203f0ebdc630617d06, https://si.imgix.net/2d85eacb/