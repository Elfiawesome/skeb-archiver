容の不備、金額不足等ございましたら気軽に再送要請してください。\nまた、不都合などあればリクエストをキャンセルしていただいて構いません。\n\n長くなりましたが内容は以上となります。\n御検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/18hXyiUv8S8YZtCtM1ju_o-gKjTbjuimV", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sys_rc/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3793696, "client_id": 3102311, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f7d0b27/uploads/origins/2e6e192d-cc18-4855-a7a5-22089df73e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4690aa8628681a383e337e380b11a608", "srcset": "https://si.imgix.net/6f7d0b27/uploads/origins/2e6e192d-cc18-4855-a7a5-22089df73e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4690aa8628681a383e337e380b11a608, https://si.imgix.net/6f7d0b27/uploads/origins/2e6e192d-cc18-4855-a7a5-22089df73e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2eaf0b13d03581b98d4c303ae0e55989 2x, https://si.imgix.net/6f7d0b27/uploads/origins/2e6e192d-cc18-4855-a7a5-22089df73e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8432438c78bd65001e625994de2fcdd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f7d0b27/uploads/origins/2e6e192d-cc18-4855-a7a5-22089df73e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e86c9b983b04e1c374dcab247f885416", "srcset": "https://si.imgix.net/6f7d0b27/uploads/origins/2e6e192d-cc18-4855-a7a5-22089df73e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e86c9b983b04e1c374dcab247f885416, https://si.imgix.net/6f7d0b27/uploads/origins/2e6e192d-cc18-4855-a7a5-22089df73e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=914b858de5a9af23bcfffe64c6eb32d7 2x, https