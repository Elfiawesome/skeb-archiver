、現在は銀髪の不良っぽい見た目。\n一見怖そうだがとても優しく、甘やかしたいかつ甘えたがりな一面もある。\n黒江のことを尊敬しており、基本は「黒江さん」呼び＋敬語\n（気持ちが溢れると敬語が崩れることも）。\n勉強は苦手だが、ベースへの愛と努力は人一倍。\nお年頃で少々ツンデレ気味\n\n【二人の関係性】\n・幼少期は「みんなのお兄ちゃんと弟みたいに接してくれていた1人」のような関係\n・高校入学後、黒江が茜を恋愛対象として意識し始め距離が縮まる\n・現在は恋人同士（※周囲には内緒、幼馴染たちにはほぼバレている）\n・茜は「自分よりもっとお似合いな人がいるのでは」と不安を抱きがち\n・黒江はそんな茜を余裕のある態度で包み込みつつ、独占欲と嫉妬も強め\n・これから少しずつ運命の相手だと確信するように二人の時間を過ごしていく\n\n使用用途\n・SNSのアイコンやヘッダーに使用\n・個人非商用の鑑賞グッズ制作\n・今後の依頼の参考資料\nなど\n\nお忙しい中大変恐縮ですがご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1NWjoBcBffJNdFWEMqJTU9xjWt93MXRdY", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sys_rc/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3793696, "client_id": 2641188, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4bd97e1/uploads/origins/d60a82cc-4097-49c2-b2e1-8fc372805999?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67165b263395a5576a7d60d34a72ad25", "srcset": "https://si.imgix.net/f4bd97e1/uploads/origins/d60a82cc-4097-49c2-b2e1-8fc372805999?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67165b263395a5576a7d60d34a72ad25, https://si.imgix.net/f4bd97e1/uploads/origins/d60a82cc-4097-49c2-b2e1-8fc372805999?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c114c2b8d219a903767d4a89df780814 2x, https://si.imgix.net/f4bd97e1/uploads/origins/d60a82cc-4097-49c2-b2e1-8fc372805999?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2af6865c2845acfd815e94299e7451bf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4bd97e1/uploads/origins/d60a82cc-4097-49c2-b2e1-8fc372805999?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7864b1dace142636771ad052b3754c2a", "srcset": "https://si.imgix.net/f4bd97e1/uploads/origins/d60a82cc-4097-49c