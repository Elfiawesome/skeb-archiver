mage", "creator_acceptable_same_genre": true}, {"path": "/@sys_rc/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3793696, "client_id": 2714740, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/084b629d/uploads/origins/05ca0e73-5835-4319-ac15-d62b3f72b2be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e8051040317af5ddcc58097fc920883", "srcset": "https://si.imgix.net/084b629d/uploads/origins/05ca0e73-5835-4319-ac15-d62b3f72b2be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e8051040317af5ddcc58097fc920883, https://si.imgix.net/084b629d/uploads/origins/05ca0e73-5835-4319-ac15-d62b3f72b2be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6150ae41bc5ffea88670612d1cf847d 2x, https://si.imgix.net/084b629d/uploads/origins/05ca0e73-5835-4319-ac15-d62b3f72b2be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc06649f980e6636c69451879d60f1a2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/084b629d/uploads/origins/05ca0e73-5835-4319-ac15-d62b3f72b2be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88c33cf27ed1e41b2b11d9cd8f03a467", "srcset": "https://si.imgix.net/084b629d/uploads/origins/05ca0e73-5835-4319-ac15-d62b3f72b2be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88c33cf27ed1e41b2b11d9cd8f03a467, https://si.imgix.net/084b629d/uploads/origins/05ca0e73-5835-4319-ac15-d62b3f72b2be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cce4f3ba051ab4dad917f8f85d207ce3 2x, https://si.imgix.net/084b629d/uploads/origins/05ca0e73-5835-4319-ac15-d62b3f72b2be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1e23bd9d6ec38cfcf840df20d2e1a4e4 3x"}, "body": "こんにちは、いつも素敵なイラストをありがとうございます！前回のリクエストで描いていただいたイラストも大切に飾っております。\n今回も私のOCを描いていただきたく、リクエストを送信させていただきました。\n\n構図・ポーズ・サイズ等の指定は特にありませんのでご自由に描いていただければ、と思います。\n以下キャラクター詳細です⤵︎ ︎\n\n┈┈┈┈┈┈┈┈┈┈\n〇キャラ詳細\n名前 オーエン・カルヴァート\n性別 男性\n年齢 30〜？(数えていないらしい)\n身長 175\n\n通常は薄らと笑みを浮かべており、表情の起伏はあまりありません。目は真っ黒で、ハイライトは入れないでください。\n笑っていながらもなんだか近寄り難いような、怒らせたくないような、けれど吸い込まれるような。そんな雰囲気をしています。\nこれといった趣味はありませんが、任務が無い時は預かっている子の稽古をしたり、誰にも連絡をせずどこかふらっと散歩をしていたりします。\n傭兵をしながらも臨時の指揮をとったりと、頼まれた依頼は割に合えばなんでもやります。\nただ、現場人間なので後方にいるよりも前線で戦っていることの方が多いです。\n煙草は吸いません。\n\n(以下は読まなくてもいい、解像度を高めたい用の文です)\n空っぽな人。子供の無邪気による狂気がそのまま育ってしまったような、けれど空虚な人。\n善悪の観念を己の理解ではなく、世間一般でそう言われているもの、とあくまで知識としてただ知っている。\n人として生きているが、なんだかそれらと自分が違うような感覚がずっとあって、けれどそれが何かも分からない。人間仕草を真似てみれば余計にその違いがぼんやりと、けれど確実に感じてしまい、人に生まれながらも人として生きることを諦めてしまったような人。ただ今はそれとなく自由に生きています。しかし、諦めたことに悲しみや落胆などはありません。\n彼には倫理観も恐怖心も無く、悪意も善意も無いでしょう。\n\nhttps://drive.google.com/drive/folders/18hXyiUv8S8YZtCtM1ju_o-gKjTbjuimV\n\n┈┈┈┈┈┈┈┈┈┈\n\n描いていただいたイラストは\n・個人観賞用のグッズ制作\n・スマホの背景などの個人的使用\n・友人への共有\n・SNSのアイコン・背景、投稿への掲載(IDを記載させていただきます)\n・依頼での参考資料\nに使わせていただく可能性があります。\n\n納品の際、背景がある場合は背景透過、宛名別の差分をいただけると助かります。\n内容の不備、金額不足等ございましたら気軽に再送要請してください。\nまた、不都合などあればリクエストをキャンセルしていただいて構いません。\n\n長くなりましたが内容は以上となります。\n御検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/18hXyiUv8S8YZtCtM1ju_o-gKjTbjuimV", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sys_rc/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3793696, "client_id": 3102311, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f7d0b27/uploads/origins/2e6e192d-cc18-4855-a7a5-22089df73e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4690aa8628681a383e337e380b11a608", "srcset": "https://si.imgix.net/6f7d0b27/uploads/origins/2e6e192d-cc18-4855-a7a5-22089df73e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4690aa8628681a383e337e380b11a608, https://si.imgix.net/6f7d0b27/uploads/ori