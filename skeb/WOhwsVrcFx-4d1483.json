しぃくんの喉穴をお願いします‼︎\n\n前回の3コマ目では真正面からみて右側にぷるんと揺れていたので、\n\n1, 2段目の1コマ目は、それぞれのどちんこが真正面から見て左に、\n2コマ目は右に揺れている感じでお願いします！\n\n3段目\nわにくんが「お口開けて寝てる…いけないんだー…😏」というような表情をしているのをしぃくんのお口の中からの目線で見た描写。わにくんはまるでしぃくんのお口のなかを覗き込んでいるような感じでお願いします！  \n\n\n描き文字は前回同様、喉穴やのどちんこに被らないようお願いします！\nまた、資料URLには虫歯差分イラストも載っていますが、虫歯差分は無しでお願いします。\n\nよろしくお願いします！\n\nhttps://x.com/zivavorefan/status/1987818946033299673?s=46&t=EvkjwesGN-bdahugIKUCcQ", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@WOhwsVrcFx/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3230289, "client_id": 47683, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ccdcd770/uploads/origins/c30c8c97-e8a5-4f43-ae45-d257fb57a152?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=defbd421cb7651767b86554f82ee659c", "srcset": "https://si.imgix.net/ccdcd770/uploads/origins/c30c8c97-e8a5-4f43-ae45-d257fb57a152?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=defbd421cb7651767b86554f82ee659c, https://si.imgix.net/ccdcd770/uploads/origins/c30c8c97-e8a5-4f43-ae45-d257fb57a152?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9c150fa153c113a15e1b2f3a7eeb865 2x, https://si.imgix.net/ccdcd770/uploads/origins/c30c8c97-e8a5-4f43-ae45-d257fb57a152?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a662a2d0bf5d01d49bf61b2be3944b3e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ccdcd770/uploads/origins/c30c8c97-e8a5-4f43-ae45-d257fb57a152?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41d9f8464b82ea716e9c3131615edb42", "srcset": "https://si.imgix.net/ccdcd770/uploads/origins/c30c8c97-e8a5-4f43-ae45-d257fb57a152?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41d9f8464b82ea716e9c31316