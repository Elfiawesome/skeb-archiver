範囲はお任せでお願いさせて頂きたいです❕\n\nOCでご依頼させて頂きたいのですが、衣装に少々他界隈の要素が入っているので、衣装の方を下記に変更させて頂こうと思っております🙏🏻‎🤍\n・白シャツ\n・黒ネクタイ\n・黒スカート\n・白ニーハイに黒靴\n髪飾りの方は完全にオリジナルのためそのままお描きして頂けましたら幸いです✨️\n要素として黒猫が居たらいいなと思っているのですが、それ以外はあまり決まっておらず、\n構図や背景などはぜひﾊﾅ様におまかせさせて頂きたいなと思っております🥲︎💕︎\n性格はツンデレに近く、しっかり者のイメージです❕構図や表情の参考になりましたら幸いです🙏🏻\n\n詳しい見た目やイラストはﾘｯﾄﾘﾝｸに添付させていただきます❕\nご不明な点や分かりにくい部分などございましたらいつでもご指摘ください！この度はskebを募集して下さりありがとうございます🥺✨️\n\nhttps://lit.link/en/A104Xx2n4tdnm31Og8zHO0Gbutu1", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 375744, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "百恵もこ🌷お仕事募集中", "screen_name": "MomoeMoco", "avatar_url": "https://pbs.twimg.com/profile_images/1910210789547593728/ByXeZ701.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1168519953785352192/1743495779/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 40, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 1166238, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "瀬戸", "screen_name": "ebi_oishiiii", "avatar_url": "https://pbs.twimg.com/profile_images/1680886966345412608/8RWeXDJG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1382099772966805507/1771244744/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 1938177, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "キラ", "screen_name": "snakr_momo_all", "avatar_url": "https://www.gravatar.com/avatar/?d=identicon", "header_url": null, "appeal_receivable": fa