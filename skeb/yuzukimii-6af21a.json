れで颯爽と店内を移動してお客様にゆずアイスとミントアイスを届ける店員さんとして描いてほしいです。アイスのコーンはワッフルコーンでお願いします。\n\nどうぞよろしくおねがいします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuzukimii/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 162877, "client_id": 1785763, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b1ad873b/uploads/origins/c9924b31-7195-4baa-a52e-4af8fbe8341b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88caba3252490de9889824ce6fd5293f", "srcset": "https://si.imgix.net/b1ad873b/uploads/origins/c9924b31-7195-4baa-a52e-4af8fbe8341b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88caba3252490de9889824ce6fd5293f, https://si.imgix.net/b1ad873b/uploads/origins/c9924b31-7195-4baa-a52e-4af8fbe8341b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1f89de19b94b6c49187e130abdd3720 2x, https://si.imgix.net/b1ad873b/uploads/origins/c9924b31-7195-4baa-a52e-4af8fbe8341b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1371ec9bcfd74cd57629274f7e59e346 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1ad873b/uploads/origins/c9924b31-7195-4baa-a52e-4af8fbe8341b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c74a6aaa44a21765d1a5a485fab61df", "srcset": "https://si.imgix.net/b1ad873b/uploads/origins/c9924b31-7195-4baa-a52e-4af8fbe8341b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c74a6aaa44a21765d1a5a485fab61df, https://si.imgix.net/b1ad873b/uploads/origins/c9924b31-7195-4baa-a52e-4af8fbe8341b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ace8d2e13374e70a691976474c4d5c47 2x, https://si.imgix.net/b1ad873b/uploads/origins/c9924b31-7195-4baa-a52e-4af8fbe8341b?bg=%23fff&auto=f