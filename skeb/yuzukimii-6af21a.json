false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef59c8eb/uploads/origins/62338a6b-9add-4142-a207-642ca6f724de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78264f63a14bf60d54d10adb133608e5", "srcset": "https://si.imgix.net/ef59c8eb/uploads/origins/62338a6b-9add-4142-a207-642ca6f724de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78264f63a14bf60d54d10adb133608e5, https://si.imgix.net/ef59c8eb/uploads/origins/62338a6b-9add-4142-a207-642ca6f724de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=04e94e4aa2f92425fc73760a9d3c4307 2x, https://si.imgix.net/ef59c8eb/uploads/origins/62338a6b-9add-4142-a207-642ca6f724de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d9c1f0d04079136cd10f74c721ea41b6 3x"}, "body": "喜多見柚がバドミントンの試合に出る姿+フリスク3人（工藤忍、綾瀬穂乃香、桃井あずき）がお忍びで応援来ているイラストお願いします。\n柚ちゃんシンデレラヒストリーの「フリスク加入大作戦！」と観るとバドはかなりの実力者に見えるので活躍している姿もっと見たくてリクエストさせていただきました。\n構図は柚ちゃんは試合中でも、試合前後でも構いません。フリスク3人はお忍びで回りにバレないような洋服で。\nしかし、柚ちゃんの活躍で、3人がはしゃいで周りにバレて大変なことになるのもあり。逆にバレずに周りと一緒に応援しているのもあり。どちらも絵になるのでお任せします。よろしくお願いいます。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuzukimii/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 162877, "client_id": 287452, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8860926/uploads/origins/a550c045-7a79-43e3-ad18-d16578924988?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6aa6679cb4f60387cae2e5b1ea0d9995", "srcset": "https://si.imgix.net/b8860926/uploads/origins/a550c045-7a79-43e3-ad18-d16578924988?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6aa6679cb4f60387cae2e5b1ea0d9995, https://si.imgix.net/b8860926/uploads/origins/a550c045-7a79-43e3-ad18-d16578924988?bg=%23fff&auto=format%2Ccompress&fm=webp&d