。\n③P90ちゃんはブルアカのミナさんのコスプレをしていますですがいつもの髪形をしています。\n④P90ちゃんは同人イベントで自分のコスプレ写真を売っています。\n\nよろしくお願いします。\n\nキャラについて\nhttps://wikiwiki.jp/dolls-fl/P90#f08b27f6\n\n立ち絵\nhttps://iopwiki.com/wiki/P90#Gallery\nhttps://www.gfwiki.org/w/P90\nhttps://www.gfwiki.org/images/1/1f/Pic_P90_HD.png\nhttps://www.gfwiki.org/images/b/bc/Pic_P90_D_HD.png\nhttps://www.gfwiki.org/images/3/37/Pic_P90_2802_HD.png\nhttps://www.gfwiki.org/images/c/cb/Pic_P90_2802_D_HD.png\nhttps://iopwiki.com/images/c/cb/P90_costume2.png\nhttps://iopwiki.com/images/7/76/P90_costume2_D.png\n\nセリフ\nhttps://www.gfwiki.org/w/P90/语音", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ringotyasan/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2594940, "client_id": 128585, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ba8077f/uploads/origins/b5275d95-ca18-4f9e-9f9c-f425b2513115?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ee60481f8a8e5db1e5d3ea840cf4115", "srcset": "https://si.imgix.net/5ba8077f/uploads/origins/b5275d95-ca18-4f9e-9f9c-f425b2513115?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ee60481f8a8e5db1e5d3ea840cf4115, https://si.imgix.net/5ba8077f/uploads/origins/b5275d95-ca18-4f9e-9f9c-f425b2513115?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=842471bd40b2bb21736cc9d3e5134ed1 2x, https://si.imgix.net/5ba8077f/uploads/origins/b5275d95-ca18-4f9e-9f9c-f425b2513115?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c2a94384ee2fbfaae5c6b9ea7d61461 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ba8077f/uploads/origins/b5275d95-ca18-4f9e-9f9c-f425b2513115?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=545293005e4527cbc0e99f93cd063840", "srcset": "https://