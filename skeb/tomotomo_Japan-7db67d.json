rop=top&w=200&h=200&s=2dfdfe7221de5b9af1334f3f53e3f3b8, https://si.imgix.net/d08550eb/uploads/origins/a729abc1-5960-4a8e-ac2b-c13e73efda60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fced71f8295f41fe54a59603118d4eb 2x, https://si.imgix.net/d08550eb/uploads/origins/a729abc1-5960-4a8e-ac2b-c13e73efda60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1cf8da77b416b753c89dd35e90f0932f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d08550eb/uploads/origins/a729abc1-5960-4a8e-ac2b-c13e73efda60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2318e2edf08b8a85f78cf53a8b2c739e", "srcset": "https://si.imgix.net/d08550eb/uploads/origins/a729abc1-5960-4a8e-ac2b-c13e73efda60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2318e2edf08b8a85f78cf53a8b2c739e, https://si.imgix.net/d08550eb/uploads/origins/a729abc1-5960-4a8e-ac2b-c13e73efda60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0307eaa38f5a6fcebd3dabda8064affb 2x, https://si.imgix.net/d08550eb/uploads/origins/a729abc1-5960-4a8e-ac2b-c13e73efda60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2262ef31c7ddb8b8e86c81ddc6fbf2cc 3x"}, "body": "お世話になります。\n「マケヒメゼンラ」を始め、素敵な作品をいつもありがとうございます。\n非常に楽しませていただいております。\n\n「マケヒメゼンラ」のカノちゃんのおもらし絵をリクエストしたいと思います。\n日々の役目として中央広場に行き、衆人環視の中、台の上で我慢できずに立ったままおしっこをしてしまい、足元に大量の水たまりを作ってしまっているシチュです。\n本編のように、周囲にたくさん人がいるような様子があるとありがたいです。（シルエットで表現など）\n\n羞恥にあふれた表情と、周りから嘲笑と罵声を浴びている様、生理現象とはいえ恥ずかしい液体を大量に出してしまっている様子を是非、お願いしたいと思います。\n\nお忙しいところ恐れ入りますが、よろしくお願いいたします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tomotomo_Japan/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1478954, "vtt_url": null, "thumbnail_imag