の快感を誇るクリピアスを装着しているので為す術も無く絶頂し続けます。\nヒロインは人一倍恥ずかしがり屋ですが同時に人一倍、無意識に興奮もしています。\nヒロインは処女です。（重要）\nピアスと鈴は、こちらの画像を参考にして描いてください。\nhttps://www.pixiv.net/artworks/18840476\nこれ以外の設定は全てお任せします。\n\n長くなりましたがリクエスト内容は以上です。ご検討をお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 33653, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "憑インキャのリバイブ（全年齢向け）", "screen_name": "ribaibu", "avatar_url": "https://pbs.twimg.com/profile_images/2008879606024261632/BI21u2iS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/148719631/1765269598/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 49}, {"id": 104254, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "パンダィン", "screen_name": "pandain95", "avatar_url": "https://pbs.twimg.com/profile_images/1875926066407321600/JhgXr0v8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/166391703/1651322168/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 161}, {"id": 122141, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "†すづめ† 🥚", "screen_name": "sudumenooyado", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fmisskey%2F41520218-ce68-4e5b-85b9-980d2d0466fe.png?avatar=1", "header_url": "https://media.misskeyusercontent.jp/misskey/25adf84a-c527-4d23-81b5-dea0905e0c47.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, 