0&h=200&s=d2a2ee610435f37f98fb41b4ceb7abd3", "srcset": "https://si.imgix.net/68f20ee1/uploads/origins/947e7c28-f0fa-4a91-9540-abc52849181e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2a2ee610435f37f98fb41b4ceb7abd3, https://si.imgix.net/68f20ee1/uploads/origins/947e7c28-f0fa-4a91-9540-abc52849181e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da09b66bf20d0b4e4744600d601d664a 2x, https://si.imgix.net/68f20ee1/uploads/origins/947e7c28-f0fa-4a91-9540-abc52849181e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3201bd7a5842fd4d8930bca1c4cfc6e4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68f20ee1/uploads/origins/947e7c28-f0fa-4a91-9540-abc52849181e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b347cf71d64a21f68498e0cc8644e4b", "srcset": "https://si.imgix.net/68f20ee1/uploads/origins/947e7c28-f0fa-4a91-9540-abc52849181e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b347cf71d64a21f68498e0cc8644e4b, https://si.imgix.net/68f20ee1/uploads/origins/947e7c28-f0fa-4a91-9540-abc52849181e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8824195b7845e1ef8246e5e228131311 2x, https://si.imgix.net/68f20ee1/uploads/origins/947e7c28-f0fa-4a91-9540-abc52849181e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eee030535012d3874d3a4395e10cbae0 3x"}, "body": "キュー5様、お世話になっております。\n\nセンシティブ占いが非常に良かったので、今度は別のキャラクターでお願いしたくリクエストさせて頂きました。自分のロールプレイキャラクター(OC)である「パトリック」のセンシティブ占いをお願いします！テオドールとも関係(？)のあるキャラクターなので、その相性的なところも占って頂けると嬉しいです。\n\n【キャラクター詳細】\nパトリック・ジュスト・ユロー(Patrick Juste Hureau)\n生年月日：1994年4月26日(32歳)\n出身地：フランス・マルセイユ\n\nテオドールと同じ過激派マフィア組織に与する、殺し屋とは名ばかりの雑用。元々は若手アクション俳優としてそれなりに活動していたが、撮影中に発生した原因不明の爆発事故に巻き込まれて顔に火傷を負う。生来のナルシストでプライドが高く、金遣いが荒かったことが災いして満足な治療が受けられなかった為に精神に異常をきたし、借金をキッカケに裏社会へと転げ落ちていった。\n\n蒸発した父親を探す手段として子役をやらされていたことから「何者かになりたい」という強烈な願望とコンプレックスを抱いている。その為、自分よりも遥かに幼いテオドールが、自分よりも殺し屋として評価されていることに激しく嫉妬し、時たまテオドールを「使って」憂さ晴らしをすることがある。認知が歪んでおり、根拠なくマフィアの首魁を自分の父親だと思い込んでいる。\n\n好きなもの：自分、写真、昔の映画、ブランド物の服や小物、サラダ\n苦手なもの：炎、鏡、甘すぎるもの、カロリーの高いもの、無駄なこと\n\n外見や雰囲気などはURLのものをご参照ください。何卒ご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1Loh-oOifSctcPL8bFh1SxVWUfOG2IfmL?usp=sharing", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kyu5_95/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/27dddb11/uploads/origins/df4ca09d-5dba-4530-a4da-1f71a2658403?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a186e3d48bfe24f35064ebe80d1f3906", "srcset": "https://si.imgix.net/27dddb11/uploads/origins/df4ca09d-5dba-4530-a4da-1f71a2658403?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a186e3d48bfe24f35064ebe80d1f3906, https://si.imgix.net/27dddb11/uploads/origins/df4ca09d-5dba-4530-a4da-1f71a2658403?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8caae48215f49e84eac400758da275e7 2x, https://si.imgix.net/27dddb11/uploads/origins/df4ca09d-5dba-4530-a4da-1f71a2658403?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62c36248a5d567fbc796c6db748f873f 3x"}, "private": true, "genre": "correction", "tipped": false, "creator_id": 4091911, "nc": 161}, {"path": "/@kyu5_95/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "correction", "tipped": true, "creator_id": 4091911, "client_id": 3930760, "vtt_url": null,