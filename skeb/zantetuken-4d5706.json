-4535-8a31-d7a61ba9f94d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c742b81cd9c35d35657e731f9877515a 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a699e3b2/uploads/origins/662ef7ab-7fe9-4535-8a31-d7a61ba9f94d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4d6bdf5a417e04f99ca79aa8c4b6a05", "srcset": "https://si.imgix.net/a699e3b2/uploads/origins/662ef7ab-7fe9-4535-8a31-d7a61ba9f94d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4d6bdf5a417e04f99ca79aa8c4b6a05, https://si.imgix.net/a699e3b2/uploads/origins/662ef7ab-7fe9-4535-8a31-d7a61ba9f94d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=477da6e5095c846346401d52b60afeae 2x, https://si.imgix.net/a699e3b2/uploads/origins/662ef7ab-7fe9-4535-8a31-d7a61ba9f94d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f873839994f4ec1e74a86b9d3f7f69d4 3x"}, "body": "コミッションさせて頂きたいです、自動 翻 訳を使っているのですが、間違いがあって申し訳ありません。\n\nシチュエーションは、\n美しいエルフ娘は、謎の部族に誘拐され、変態司祭たちに色々なくすぐり方で責めにされていた、\n数日間にわたるくすぐり拷問で凄くエッチなニオイするエルフは、部族のペットたちに囲まれて、変な儀式を行う。\n\n・衣装は脱がされ、非常に露出度の高い部族の服とアクセサリに着替えさせられた、上半身裸。　面倒であれば全裸でも構いません。\n・エルフの姉さんはベッド（または祭壇）に縛り付けられ、部族の小さなペットたちに全身をメチャクチャにくすぐられる。\n・特に脇の下、乳首、ヘソ、股間、足の裏...などニオイがするところを舐め回される。\n・料金で可能であれば、以下のような差分をお願いします（オミット・改変してもOKです）\n\n①くすぐりの前、エルフの胸やおへそや足にココナッツジュースをかけられ続け、くすぐり用の小動物の群に囲まれて、次に何が起こるかわかっているようだ、焦っている涙目で許しを懇願する。\n②ペットたちに全身を舐め回されてくすぐられ、くすぐったすぎて彼女が笑い狂いながら悶える。暴れたせいで腰蓑がずれてしまう。\n③窮状はさらに悪化しており、興奮しすぎて我慢できないペットたちがエルフを掴んだり抱いたり、交尾のようペニスで彼女の全身を擦りつけたりする。ペットの毛むくじゃらな体、手、足、ペニスのせいで、彼女は地獄のようなくすぐったさと快感を感じる。（腋コキ、腹コキ、素股、足コキさせられるようだ）\n④事後、エルフは放心状態で全裸の体が涎や汗や愛液や変な白い汁まみれになった。後はキレイになるまで洗いくすぐる、汚れがひどくて洗うのが大変そう...\n\nその他\n\nエルフ娘：キレイで優しくて、ちょっと欲求不満のエロフの姉さん。\n謎の部族：美しい女性を誘拐してくすぐり性奴隷にする変態部族。\n部族のペット（♂）：もふもふかわいい小動物、淫獣だけど。蜜や女性の汗や愛液が大好き。舌、手足、しっぽ、さらにはペニスのくすぐる能力が高い、効果抜群だ。\n\nエルフの人選はお任せします、フィブや他のオリキャラなど。\nリクエストの内容が面倒だったり、気分が乗らなかったりされたらキャンセルしても大丈夫です。\nご検討よろしくお願いします。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zantetuken/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1086744, "client_id": 735062, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4cfe7495/uploads/origins/d8d46866-df6d-49ed-ace3-572050d2e9de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd2eed23c2b21c8800dab56048d02ce3", "srcset": "https://si.imgix.net/4cfe7495/uploads/origins/d8d46866-df6d-49ed-ace3-572050d2e9de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd2eed23c2b21c8800dab56048d02ce3, https://si.imgix.net/4cfe7495/uploads/origins/d8d46866-df6d-49ed-ace3-572050d2e9de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f307cfadf1e4592dd681736c4583a736 2x, https://si.imgix.net/4cfe7495/uploads/origins/d8d46866-df6d-49ed-ace3-572050d2e9de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=076e53b2f5ffa6141c7c94f603d069cc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4cfe7495/uploads/origins/d8d46866-df6d-49ed-ace3-572050d2e9de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20ba6a553971fb4ec7e9f9406bef83ec", "srcset": "https://si.imgix.net/4cfe7495/uploads/origins/d8d46866-df6d-49ed-ace3-572050d2e9de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20ba6a553971fb4ec7e9f9406bef83ec, https://si.imgix.net/4cfe7495/uploads/origins/d8d46866-df6d-49ed-ace3-572050d2e9de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9703d7da1878441a4bb91cc2d74c18fa 2x, https://si.imgix.net/4cfe7495/uploads/origins/d8d46866-df6d-49ed-ace3-572050d2e9de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=