の姿は平成のギャルのイメージです！\n細かなディテールは是非歌詞を読んで頂き、テナテル様のご想像にお任せしたいです！\n\n分かりにくい文章でしたら申し訳ありません。\nいつもTwitterで拝見しております！フォロー返して下さりありがとうございます、嬉しいです！\nこれからも応援しております！\n\n\n\n歌詞はこちらです↓\n1A\n服で足の踏み場もないのに\n明日着ていく服がない\n待ち受け変えたのに　運気は上がらない\n\n1B\nあたしはこれでいいのかな\nあたしはこれでいいのかな\n勘繰られてまた不幸になる\n\n1C\nあたし何も信じてないから\n神様だって簡単に唱える、\n頭のねじれは治らない\nグロいこの世なんか見えない見えない\n\ninter\n\n1A \nどんどん薄くなる液晶\nなのにあの時よりやけに重い\nおとなになっても　世界は手に負えない\n\n2B \nzの先はあるのかな\n私のこの先どうなるのかな\nあ〜\n\ninter（long）\n\nD\n見えすぎてる今を抜け出したい\nあのザラザラな画素に帰りたい\n繋がれない過去に戻りたい\n同じ位置で君を待ってみたい\n\n見えすぎてる今を抜け出せない\nツルツルな今だって愛したい\n繋がらない過去に戻れないけど\n同じ場所で君を待っている\n\n\nlast c \nあたし株式会社じゃ無いから\nあなたの言うことなんて聞いてあげない\nあたし株式会社じゃないから\nキミの指図には従わないの\n\nあたしのこれはいい身体\nあたしたちはこれで良いからさ\nあたしたちはこのままでいいから\nゴミに価値がつくなら私にだって", "nc": 1, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@TENATR121/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 2074861, "client_id": 2583388, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee4ef2a8/uploads/outputs/e6ffe442-ce95-4c4f-a1ff-e1431d81d147?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=99cb0f9790ddea8a480f894a40a11a5e", "srcset": "https://si.imgix.net/ee4ef2a8/uploads/outputs/e6ffe442-ce95-4c4f-a1ff-e1431d81d147?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=99cb0f9790ddea8a480f894a40a11a5e, https://si.imgix.net/ee4ef2a8/uploads/outputs/e6ffe442-ce95-4c4f-a1ff-e1431d81d147?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=6030dc11028f959da49395583cdfda48 2x, https://si.imgix.net/ee4ef2a8/uploads/outputs/e6ffe442-ce95-4c4f-a1ff-e1431d81d147?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=e32bbec374f726918b1fe88d25efbcaf 3x"}, "duration": 4, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee4ef2a8/uploads/outputs/e6ffe442-ce95-4c4f-a1ff-e1431d81d147?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=