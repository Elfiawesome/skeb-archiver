 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ryolyo/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 665409, "client_id": 27685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2ec21d3/uploads/origins/5233e640-12ce-4c42-83ea-c2e08c4b7783?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71b53517cf8e81c28ee9e99320777542", "srcset": "https://si.imgix.net/b2ec21d3/uploads/origins/5233e640-12ce-4c42-83ea-c2e08c4b7783?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71b53517cf8e81c28ee9e99320777542, https://si.imgix.net/b2ec21d3/uploads/origins/5233e640-12ce-4c42-83ea-c2e08c4b7783?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5caa657508b175512a7fe4db8101a6be 2x, https://si.imgix.net/b2ec21d3/uploads/origins/5233e640-12ce-4c42-83ea-c2e08c4b7783?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bea155aa9e3a8e90ae8ec829c87f4510 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2ec21d3/uploads/origins/5233e640-12ce-4c42-83ea-c2e08c4b7783?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ff729c3b91c9b909a49c4c1136c092d", "srcset": "https://si.imgix.net/b2ec21d3/uploads/origins/5233e640-12ce-4c42-83ea-c2e08c4b7783?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ff729c3b91c9b909a49c4c1136c092d, https://si.imgix.net/b2ec21d3/uploads/origins/5233e640-12ce-4c42-83ea-c2e08c4b7783?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f105e2535ed87d0dadb22df4b36f234 2x, https://si.imgix.net/b2ec21d3/uploads/origins/5233e640-12ce-4c42-83ea-c2e08c4b7783?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d661b72c2c42a856b27f28034857eb1a 3x"}, "body": "涼涼様\n\nこんばんは、涼涼様。\nピクシブからのファンです。\n絵柄がとても魅力的ですごく好きです。\nもしよろしければこちらのオリキャラのことを涼涼様の絵柄で依頼したいです。\n\nお願い申し上げたいのはこちらのオリキャラ狐娘の万里香（まりか）という子です。\n狐耳と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の子です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。一人の時や知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘で涼涼様の絵柄でのイラストをどうかお願いしたいです。\n夏の制服姿でベンチに座って本を読んでるのが見たいんですがどうでしょうか？\nご検討くださいませ！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ryolyo/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 665409, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f17a9c0c/uploads/origins/d27ed398-3856-4c2e-8c35-38534a71fb41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c7bdec9936be83693abd618c9de6893", "srcset": "https://si.imgix.net/f17a9c0c/uploads/origins/d27ed398-3856-4c2e-8c35-38534a71fb41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c7bdec9936be83693abd618c9de6893, https://si.imgix.net/f17a9c0c/uploads/origins/d27ed398-3856-4c2e-8c35-38534a71fb41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd20094039d0dbff1066d05da61aaa88 2x, https://si.imgix.net/f17a9c0c/uploads/origins/d27ed398-3856-4c2e-8c35-38534a71fb41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99efe6f00898d1e53dc7d78a05b3dcef 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f17a9c0c/uploads/origins/d27ed398-3856-4c2e-8c35-38534a71fb41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36f06b2c49c73031b07bd7ee05eef188", "srcset": "https://si.imgix.net/f17a9c0c/uploads/origins/d27e