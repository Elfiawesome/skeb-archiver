f95a/uploads/origins/1dfa93c3-dd49-4b9e-97a6-79694db1ca90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24de8ec0a47208cbc985ab8e5678bb3d", "srcset": "https://si.imgix.net/f967f95a/uploads/origins/1dfa93c3-dd49-4b9e-97a6-79694db1ca90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24de8ec0a47208cbc985ab8e5678bb3d, https://si.imgix.net/f967f95a/uploads/origins/1dfa93c3-dd49-4b9e-97a6-79694db1ca90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97c6a661a4283177b2d379b21c16cc0c 2x, https://si.imgix.net/f967f95a/uploads/origins/1dfa93c3-dd49-4b9e-97a6-79694db1ca90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4938d3cf225c87648313e2d576a7813b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f967f95a/uploads/origins/1dfa93c3-dd49-4b9e-97a6-79694db1ca90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3efe07733591958f62a5f171e83cf690", "srcset": "https://si.imgix.net/f967f95a/uploads/origins/1dfa93c3-dd49-4b9e-97a6-79694db1ca90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3efe07733591958f62a5f171e83cf690, https://si.imgix.net/f967f95a/uploads/origins/1dfa93c3-dd49-4b9e-97a6-79694db1ca90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e213aa3a021be212ae0a35e2f44e65da 2x, https://si.imgix.net/f967f95a/uploads/origins/1dfa93c3-dd49-4b9e-97a6-79694db1ca90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e53c94d451ad6e1793472aabf5afbef6 3x"}, "body": "パチェキチ様\n\nはじめまして、ありのみと申します\n先生に東方projectのチルノさんと大妖精さんをお願いしてもよろしいでしょうか？\n\n依頼用に２人の資料画像を用意しておりますので、もしよろしければ下記URLをご参照下さい。\nhttps://twitter.com/ARINOMI7/status/1549022259926695938\n　個人的なイメージではありますが\n　チルノさんは裏表の無い活発・積極的なタイプ\n　大妖精さんは口数が少なくどちらかと言えば受け身なタイプ\n　身長体格にパッと見てわかるほどの差はなく\n　２人ともお胸はぺたんこ\n　並んで立って目線が合う同身長カプ\n　よく一緒にいる仲良しコンビの印象があります。\n　\n　羽のデザインは媒体によってよく変わりますので、それっぽい雰囲気であれば\n　大きさや形、枚数や付いている場所(浮いているかどうか)など自由\n　　大妖精さんはドット絵の様子から鳥のようなふわっとした羽の印象を持っていますが\n　　ピンとこない、かきにくいようならスルーして下さい\n\n場所や季節、服装の指定はございません。\n世界観等も含めて先生におまかせでお願いしたく存じます。\n\nもしよろしければご検討下さいますよう、何卒お願い申し上げます。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ryolyo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 665409, "client_id": 1765701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f222466/uploads/origins/805d6b14-7022-45e8-b6a9-3a6fef109fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e80eec7a92754e5e842baae69af543e6", "srcset": "https://si.imgix.net/1f222466/uploads/origins/805d6b14-7022-45e8-b6a9-3a6fef109fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e80eec7a92754e5e842baae69af543e6, https://si.imgix.net/1f222466/uploads/origins/805d6b14-7022-45e8-b6a9-3a6fef109fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3a0cc81205447f9a48169731de1fba0 2x, https://si.imgix.net/1f222466/uploads/origins/805d6b14-7022-45e8-b6a9-3a6fef109fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d0d9592fa63730aa895849dce7d0460 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f222466/uploads/origins/805d6b14-7022-45e8-b6a9-3a6fef109fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c3ca3aa2cddc784233d738c17b2e783", "srcset": "https://si.imgix.net/1f222466/uploads/origins/805d6b14-7022-45e8-b6a9-3a6fef109fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c3ca3aa2cddc784233d738c17b2e783, https://si.imgix.net/1f222466/uploads/origins/805d6b14-7022-45e8-b6a9-3a6fef109fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cr