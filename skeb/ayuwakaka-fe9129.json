ue, "genre": "art", "tipped": false, "creator_id": 3906281, "client_id": 826594, "nc": 17}, {"path": "/@ayuwakaka/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3906281, "client_id": 1179131, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0aa2537/uploads/origins/8963baf0-2a3e-4853-a806-6a57a49ed6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=026cab7de022df32015a70cfd4f7d2bd", "srcset": "https://si.imgix.net/e0aa2537/uploads/origins/8963baf0-2a3e-4853-a806-6a57a49ed6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=026cab7de022df32015a70cfd4f7d2bd, https://si.imgix.net/e0aa2537/uploads/origins/8963baf0-2a3e-4853-a806-6a57a49ed6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=627e313e9c1e21e4fd70e95a1de36585 2x, https://si.imgix.net/e0aa2537/uploads/origins/8963baf0-2a3e-4853-a806-6a57a49ed6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba2897cb7bf69854b6759e0d88ed7030 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0aa2537/uploads/origins/8963baf0-2a3e-4853-a806-6a57a49ed6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d35f3d6652fc5b07efb00c5ea449709", "srcset": "https://si.imgix.net/e0aa2537/uploads/origins/8963baf0-2a3e-4853-a806-6a57a49ed6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d35f3d6652fc5b07efb00c5ea449709, https://si.imgix.net/e0aa2537/uploads/origins/8963baf0-2a3e-4853-a806-6a57a49ed6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4772bf0c874cb9020babb3f0e20db8d2 2x, https://si.imgix.net/e0aa2537/uploads/origins/8963baf0-2a3e-4853-a806-6a57a49ed6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=caf759a48ac9c8862d972e6e7d4bb965 3x"}, "body": "はじめまして、先生の作品は超素晴らしいです！\n先生の描かれる、可愛らしく柔らかで、見ているだけで癒されるような、それでいて動物それぞれの特徴を的確に捉えたイラストが大好きです！！\nもしよろしければ、私のTRPGキャラクターたちを動物化した姿で描いていただけないでしょうか？\nフォルダ内にある S（ソレル／茶色の髪のキャラクター） を中心に描いていただけたら嬉しいです。\n\n描くキャラの組み合わせやパロ設定は先生のお好きなように選んでいただいて構いません。私は雑食なので（……）、キャラ同士の関係性が少しでも感じられれば嬉しいです！\nご希望の金額の範囲内で、描きたい人数を選んでいただけると嬉しいです！\n\n以下はご参考までに、それぞれのキャラクターの動物化の種別です：\nS→メキシコハイイロオオカミ\nN→ソアイヒツジ\nE→サーバルキャット\nB→ジャガー（アメリカヒョウ）\nCにつきましては、先生のご印象で自由に決めていただければと思います！\nもし先生のほうでより良いアイデアがありましたら、お好きな種類で描いていただいて構いません！！どうぞご自由にご判断ください。\n\nこのような作品の形式で描いていただけましたら、とても嬉しいです！\nhttps://x.com/ayuwakaka/status/2086416437569319337\nhttps://x.com/ayuwakaka/status/2084429633291002282\n動物化としてのデザインには特に固定の設定はありませんので、先生のご解釈やお好みに合わせて自由に描いていただけたら嬉しいです！\n猫や犬、鳥など、シンプルで身近な伴侶動物として描いていただいても問題ありません。\n\n動物化についてのその他の参考資料：\nhttps://drive.google.com/drive/folders/1zzgeRqlru3DjA9rujJDobfUd1JrAvYvl?usp=sharing\n\n可能であれば、別レイヤーにサインを入れたpsdファイルをご提供ください。また、先生が下書きや未使用のrkgkなどを作品に残しておいてくださると、アイデアの変遷を見ることができるのでありがたいです！\n\nご依頼をお読みいただき、ご検討くださり誠にありがとうございます！お気に召さない場合は、遠慮なく直接キャンセルしてください。\n\nhttps://drive.google.com/drive/folders/1G2yldDUusWRmjXtyBZvMCJr11FJAh5xc?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 880650, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あのん⌇どたばた", "screen_name": "anoyo_030", "avatar_url": "https://pbs.twimg.com/profile_images/1773704016545165312/7qjSnBdM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1312453553600909314/1637252391/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 1298118, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "海野ゐるか🐋🧫🧪Skeb受付中", "screen_name": "akutagawa_FI_", "av