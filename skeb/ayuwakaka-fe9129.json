p&crop=top&w=200&h=200&blur=200&s=3085acf0f9a343fd41dcb3c104552825, https://si.imgix.net/abcd93ce/uploads/origins/1bd98cdb-f2ad-42c6-a777-e1b0d10401a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4124ff5539c0bfa5499343f3e5e8662c 2x, https://si.imgix.net/abcd93ce/uploads/origins/1bd98cdb-f2ad-42c6-a777-e1b0d10401a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d7ee98a051b23da79926245d7dea866b 3x"}, "body": "はじめまして。\nあまぐもさんの描かれる動物のイラストがとても素敵だったのでぜひ我が家に迎えたばかりのポメラニアンを描いていただきたくてご依頼を送らせていただきました。\n\n線画無しのイラストがとても素敵でしたので線画無しでお願いしたいです。\n\nポメラニアンの情報は以下となります。\n・名前：えびす\n・生後二か月の女の子\n・毛色：オレンジ(子犬のため今はたぬきのような色味です)\n・顎下の泥棒ひげが特徴的です。\n・ロブスターの人形とよく一緒に寝ています。\n・エビフライ、にんじん、いちごの人形がお気に入りです。\n\n資料としてドライブにて写真を送付させていただきます。\nhttps://drive.google.com/drive/folders/1P5GXUWc5_JTOVu16fyxP8y1eHukF7-q1?usp=sharing\n\nイラストの使用用途としましてはLINEのアイコンやスマートフォンなどの壁紙での使用を想定しております。\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1P5GXUWc5_JTOVu16fyxP8y1eHukF7-q1?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ayuwakaka/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6c31fa56/uploads/origins/b177f4dd-e8eb-4acd-a76a-2cbf67612ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad743a7fc4249a1080129f191acba974", "srcset": "https://si.imgix.net/6c31fa56/uploads/origins/b177f4dd-e8eb-4acd-a76a-2cbf67612ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad743a7fc4249a1080129f191acba974, https://si.imgix.net/6c31fa56/uploads/origins/b177f4dd-e8eb-4acd-a76a-2cbf67612ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5c19bca4935fcace72e49faaf9bade5 2x, https://si.imgix.net/6c31fa56/uploads/origins/b177f4dd-e8eb-4acd-a76a-2cbf67612ecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7700f3c0d539b4cd217c7ba2b86f3fe0 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3906281, "client_id": 484686, "nc": 144}, {"path": "/@ayuwakaka/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3906281, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20eae949/uploads/origins/659a52d4-230f-4043-a747-94835ca28a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49fb164866ef20bed13b7bcdfceee7d2", "srcset": "https://si.imgix.net/20eae949/uploads/origins/659a52d4-230f-4043-a747-94835ca28a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49fb164866ef20bed13b7bcdfceee7d2, https://si.imgix.net/20eae949/uploads/origins/659a52d4-230f-4043-a747-94835ca28a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bcaee2e48e2cf08aa0364a69b5a8e116 2x, https://si.imgix.net/20eae949/uploads/origins/659a52d4-230f-4043-a747-94835ca28a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c5a034ef4c5e0575c78a7496a865ebf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20eae949/uploads/origins/659a52d4-230f-4043-a747-94835ca28a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8c3c5d3f64e1547c28cecf685410606", "srcset": "https://si.imgix.net/20eae949/uploads/origins/659a52d4-230f-4043-a747-94835ca28a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8c3c5d3f64e1547c28cecf685410606, https://si.imgix.net/20eae949/uploads/origins/659a52d4-230f-4043-a747-94835ca28a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8a0ec7dd31f29c291e5ef5396aed56f7 2x, https://si.imgix.net/20eae949/uploads/origins/659a52d4-230f-4043-a747-94835ca28a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a8ca707b754711bb9c42065d0e464dcb 3x"}, "body": "初めまして！\nXでお見かけした動物化イラストがとても可愛いくて、ご依頼させていただきたく参りました！\n\n私と相互さんのOCをリクエストさせていただきたいです。\nキャラクターはTRPG「レプリカントの葬列」というゲームに使用したキャラクターです。2人は絵画専門の怪盗で、怪盗と贋作師の相棒関係にあります。\n以下、必要な箇所のみご確認ください。\n\n\n ▌怪盗　ルー\n怪盗名:Lanter・Loo(ランター・ルー)\n年齢:見た目20代半ば〜後半\n身長:177cm\n外見:毛先に藍色のようなメッシュが混ざった、長い銀色の髪。深い青色と月のような黄色のオッドアイ。\n呼称:俺/君\nモチーフ:狼、満月\n\n最近巷を騒がせている怪盗。 明朗快活な性格で距離感が近い。\n「会えて嬉しいよ！！気軽にルーって呼んで。これからよろしくね！」\n「俺にとって君はどんな絵画や宝物よりも大切だから」\n「ホリ〜！見て、今日はこの花を買ってきたんだ！」\n\n\n▌贋作師　ホリ\n年齢:25\n身長:166cm\n外見:暗めの紺色の髪に黄色のインナーカラー\n呼称:僕/あんた\n元ネタ:エルミア・デ・ホーリー(画家)\n\n強情で素直じゃない性格。 一度見たものならどんな絵も真似をして描ける贋作師。素直じゃない上に捻くれているところがあるがデレる。\n「…よろしく。」\n「あまりべたべたしないでよ」\n「関係ないでしょ、絡んでこないで」\n\n\n【構図や雰囲気】\nキャラクターの動物化をお願いいたします\n\n【使用用途など】\n個人鑑賞、相互さんへの共有。もしかしたら個人用のイラストまとめ本に掲載させていただくかもしれませんが、販売はしない(TRPGの著作権的にできない)ため、金銭が絡むことはありません。\nまた、可能であれば個人用グッズ(非売)を作成させていただきたいため、PSD納品などイラスト単体のデータがあると助かります。\n※あくまで希望ですので上記内容通りに納品いただく必要はございません…！\n\n\nご縁がありましたらどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1Ehe5NAgfcpbG7rnsCoWntJbx93BFZUB5", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ayuwakaka/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3906281, "client_id": 3561043, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a7ac713/uploads/origins/1fbb3539-8580-48ef-a23b-a79277103a57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=154f1ac4d0d84c7eaed6ccef8f99d2af", "srcset": "https://si.imgix.net/5a7ac713/uploads/origins/1fbb3539-8580-48ef-a23b-a79277103a57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=