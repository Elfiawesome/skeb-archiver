もし可能でしたらエリザベスウェアを着ていて背中の毛がボフッとしている猫も描いていただきたいです。\n猫宛にも宛名を描いていただきたいです。\n・使用用途\nアイコン、ヘッダー、壁紙、個人鑑賞用のグッズの作成、SNSに投稿\n・納品形式\npsdで納品していただきたいです。\nお忙しい中恐れ入りますがご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1hkV-xQqgVgpyTS-E9h1fHf3NlbdofRCl", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ayuwakaka/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3906281, "client_id": 3876837, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34173acc/uploads/origins/0253c7d1-b87e-484c-bffa-cb15ce44e25e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76a0c0397fe4089a193bc579d66a262e", "srcset": "https://si.imgix.net/34173acc/uploads/origins/0253c7d1-b87e-484c-bffa-cb15ce44e25e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76a0c0397fe4089a193bc579d66a262e, https://si.imgix.net/34173acc/uploads/origins/0253c7d1-b87e-484c-bffa-cb15ce44e25e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44d0cc11150dde08c53fc69268408b45 2x, https://si.imgix.net/34173acc/uploads/origins/0253c7d1-b87e-484c-bffa-cb15ce44e25e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a434bf79e5da5c30d52260ab915b215d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34173acc/uploads/origins/0253c7d1-b87e-484c-bffa-cb15ce44e25e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd1d41e7b0bff2c13bb2d43eee341bad", "srcset": "https://si.imgix.net/34173acc/uploads/origins/0253c7d1-b87e-484c-bffa-cb15ce44e25e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd1d41e7b0bff2c13bb2d43eee341bad, https://si.imgix.net/34173acc/uploads/origins/0253c7d1-b87e-484c-bffa-cb15ce44e25e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h