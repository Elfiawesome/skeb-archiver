f6/uploads/origins/57022a92-91dc-4bc9-ac51-c8f120bafa97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94fa05770634ee211b6e57a0ab885dcd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55246df6/uploads/origins/57022a92-91dc-4bc9-ac51-c8f120bafa97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3898ec8a55a2bdd7d215f89ed237507", "srcset": "https://si.imgix.net/55246df6/uploads/origins/57022a92-91dc-4bc9-ac51-c8f120bafa97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3898ec8a55a2bdd7d215f89ed237507, https://si.imgix.net/55246df6/uploads/origins/57022a92-91dc-4bc9-ac51-c8f120bafa97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=33dd22668ae95a51f8dca8a41a633f30 2x, https://si.imgix.net/55246df6/uploads/origins/57022a92-91dc-4bc9-ac51-c8f120bafa97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a5eb6fd3bbdb8711589d342b01f099c3 3x"}, "body": "だめお様\nノエル・オルタのイラスト（https://www.pixiv.net/artworks/140924534）を拝見いたしました。\nダークな雰囲気に染まってしまい哀しい反面、妖しい魅力が溢れており、とても素晴らしいと感じました。\nぜひとも、甘雨・オルタを描いていただけないでしょうか。\n\n\n◆【キャラクター】\n原神の甘雨\nhttps://wiki.hoyolab.com/pc/genshin/entry/28\n\n◆【衣装】\nオルタ化した衣装をデザインしていただきたいです。\nベースとしてはゲーム内初期衣装で構わないのですが、色見と装飾の調整を主にお願いしたいです。少しくらい露出が増えてしまっても問題ないと思います。\nまた、太ももの金色の衣装は結構気に入っており好きなので、場合によっては色を変えるなどして残してもらえると嬉しいです。\n\n◆【希望シチュエーション】\n甘雨・オルタの立ち絵\n\n◆【体位や構図】\nお任せします。\n\n◆【背景】\n単色もしくは透過で構いません。\n\n◆【用途】\nSNSやhoyolabへの投稿（ただし作者を必ず記します）\nスマホやPCの壁紙、など\n\n\n検討していただけると幸いです。\nよろしければお願いします！！\n\nhttps://www.pixiv.net/artworks/140924534", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 11189, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "天空 翔@C108(土)西た-03b(西2ホール)", "screen_name": "Yamashigo5", "avatar_url": "https://p