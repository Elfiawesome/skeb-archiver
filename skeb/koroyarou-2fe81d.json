ています。\n\nエベントの時、作品はSNS（Twitter、YouTubeとか）で投稿するつもりです。そのため、12月前に納品くださっていただけませんか？\n\nこれまで読んでありがとうございました！色々なことを頼んだ本当に申し訳ございませんでした。\nよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koroyarou/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1096144, "client_id": 1522376, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/908e0058/uploads/origins/485ed949-ca59-4749-8b94-4f12ee0c226c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c18a8198a83de30e8be93008902a1987", "srcset": "https://si.imgix.net/908e0058/uploads/origins/485ed949-ca59-4749-8b94-4f12ee0c226c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c18a8198a83de30e8be93008902a1987, https://si.imgix.net/908e0058/uploads/origins/485ed949-ca59-4749-8b94-4f12ee0c226c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46f04849ea639122ba85bf43d218c97e 2x, https://si.imgix.net/908e0058/uploads/origins/485ed949-ca59-4749-8b94-4f12ee0c226c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bad22243ca460e06a13fe4fbdfce5290 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/908e0058/uploads/origins/485ed949-ca59-4749-8b94-4f12ee0c226c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efb862b6eba53986c14e381368d8775a", "srcset": "https://si.imgix.net/908e0058/uploads/origins/485ed949-ca59-4749-8b94-4f12ee0c226c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efb862b6eba53986c14e381368d8775a, https://si.imgix.net/908e0058/uploads/origins/485ed949-ca59-4749-8b94-4f12ee0c226c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c41cb56f1092ed78870bd5a63590621 2x, https://si.imgix.net/908e0058/uploads/origins/4