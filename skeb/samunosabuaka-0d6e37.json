実がしっかりと見えている。\n懐に入り込んでから手をすり抜ける女。(全て善から来る行動であるが天使のような悪魔のような…)\n\n服装やポーズ、シチュエーション等の指定はありません。細かな装飾なども省いても、好きにデザインしていただいても構いません！\nサムさんのイラストと世界観が大好きなので、どうか好きなように描いて頂けたらと思います。\n\n使用用途としては個人的な鑑賞に使用したいと考えています。\n何か金額等失礼がありましたら申し訳ありません、もし難しいようでしたら再送して頂けると嬉しいです。\nご検討の程、何卒宜しくお願いします…！\n\nhttps://drive.google.com/drive/folders/1DdZZJURoKDORea2vvUdX2-OTxY3rpHBM?usp=drive_link", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@samunosabuaka/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ae505573/uploads/origins/9b9bd0a9-c35f-465b-86fe-e4d41115cd6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4c97cc6cb30dbf44b541d2822bc5cac", "srcset": "https://si.imgix.net/ae505573/uploads/origins/9b9bd0a9-c35f-465b-86fe-e4d41115cd6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4c97cc6cb30dbf44b541d2822bc5cac, https://si.imgix.net/ae505573/uploads/origins/9b9bd0a9-c35f-465b-86fe-e4d41115cd6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=624d27c45fe49ee265f83494ed60d014 2x, https://si.imgix.net/ae505573/uploads/origins/9b9bd0a9-c35f-465b-86fe-e4d41115cd6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da214c68ff95218bd7c52334206f2251 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 3980882, "client_id": 1500785, "nc": 144}, {"path": "/@samunosabuaka/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3980882, "vtt_url": null, "thumbnail_image_urls": {"sr