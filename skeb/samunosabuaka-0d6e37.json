c-433fbc4487d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c126e3754ee4ed66357c1e1ccd5c2553, https://si.imgix.net/38c505be/uploads/origins/80b9f6df-3356-43cc-981c-433fbc4487d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bf16e551da8e17910a050ffb43e4dd34 2x, https://si.imgix.net/38c505be/uploads/origins/80b9f6df-3356-43cc-981c-433fbc4487d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=70bb1e8e13805b2fb32de415d29d2607 3x"}, "body": "初めまして！\nXでサムさんの可愛らしく魅力的な絵柄に一目惚れし、是非ともサムさんの作風で男女OCを描いて頂きたくリクエストに参りました。\n\n✧セス（男）\n髪／金髪\n瞳／青、下睫毛\n20歳。188cm。次期国王（現王子）。\n冷酷かつ氷のような男。有能。基本スン…としておりあまり表情が変わらないが、姉の前では言動が少し柔らかい。\n嫉妬深く、姉と誰かが会話していると普通に姉さん。と割り込んでくる。後方腕組み彼氏面もする。\n幼い頃、冷遇されていた自分に関わり続け受け入れてくれた姉にかなり依存している。\n\n✧ミラ（女）\n髪／茶色、インテークの中が桃色\n瞳／緑と桃\n24歳。152cm。王女。\n天真爛漫、ゴーイングマイウェイお姫。人を振り回しがち。\nセスは義理とはいえ初めてできた自分の弟であり、うんと可愛がり、ヨシヨシとしてきた。\nふわふわにこにことしているが、セスが思っているより現実がしっかりと見えている。\n懐に入り込んでから手をすり抜ける女。(全て善から来る行動であるが天使のような悪魔のような…)\n\n服装やポーズ、シチュエーション等の指定はありません。細かな装飾なども省いても、好きにデザインしていただいても構いません！\nサムさんのイラストと世界観が大好きなので、どうか好きなように描いて頂けたらと思います。\n\n使用用途としては個人的な鑑賞に使用したいと考えています。\n何か金額等失礼がありましたら申し訳ありません、もし難しいようでしたら再送して頂けると嬉しいです。\nご検討の程、何卒宜しくお願いします…！\n\nhttps://drive.google.com/drive/folders/1DdZZJURoKDORea2vvUdX2-OTxY3rpHBM?usp=drive_link", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@samunosabuaka/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ae505573/uploads/origins/9b9bd0a9-c35f-465b-86fe-e4d41115cd6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4c97cc6cb30dbf44b541d2822bc5cac", "srcset": "https://si.imgix.net/ae505573/uploads/origins/9b9bd0a9-c35f-465b-86fe-e4d41115cd6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign