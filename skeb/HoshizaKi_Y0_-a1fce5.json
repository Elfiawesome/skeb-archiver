ive/folders/1ldnQ85FiD2bewf2m3tZyI8EBekVtrdmj\nhttps://drive.google.com/drive/folders/1vEsUUbtBMMe0u8itbaKtlOKZw4UYNphw\nhttps://drive.google.com/drive/folders/1umL6bP_qJsYGhPLdkkSpP8bRMCBOUqkK", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 785631, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "水深子", "screen_name": "ewokaku335", "avatar_url": "https://pbs.twimg.com/profile_images/1758418417651224576/n9cfKuj0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1157257464112279552/1744115912/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 3094087, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "るり", "screen_name": "ruriekaku", "avatar_url": "https://pbs.twimg.com/profile_images/2043220443637907456/aZionKny.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1723312952856752128/1771258878/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 3250413, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "海鳴カイン@ちびキャラ", "screen_name": "kain5109", "avatar_url": "https://pbs.twimg.com/profile_images/2027551277119639552/5mvhikcN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1442245831784951811/1768628832/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_da