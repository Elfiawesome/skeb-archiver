mat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c2d72e132d6d8c50839f1a77b14a140, https://si.imgix.net/6b6355ba/uploads/origins/456769de-14ec-42e9-8eac-e6e617b6777d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e625b571705fce6bcf07ae351755b645 2x, https://si.imgix.net/6b6355ba/uploads/origins/456769de-14ec-42e9-8eac-e6e617b6777d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d8410ad581e0dc97b6876e259b6004b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b6355ba/uploads/origins/456769de-14ec-42e9-8eac-e6e617b6777d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=841318d1018b0a0d778c24560a9e623d", "srcset": "https://si.imgix.net/6b6355ba/uploads/origins/456769de-14ec-42e9-8eac-e6e617b6777d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=841318d1018b0a0d778c24560a9e623d, https://si.imgix.net/6b6355ba/uploads/origins/456769de-14ec-42e9-8eac-e6e617b6777d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d0bf39c43ba866d692de98d27fd00a6 2x, https://si.imgix.net/6b6355ba/uploads/origins/456769de-14ec-42e9-8eac-e6e617b6777d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b048b19e573774811c396cd8de6a8473 3x"}, "body": "こんにちは！いつも陰ながら応援しております。\n\n1年ほど前にメルヘンスローターをプレイし衝撃を受け、そこからフリーゲームをプレイするようになり次第に自分でもゲームを作り始めるようになりました。メルヘンスローターは本当に思い入れのある作品で、1年経った今でも私の中で鮮明に輝いております。\n\n【リクエスト詳細】\nEND6の後のアルドとヒューのお話をお願いしたいです。正解ではないが、これも一つの道なのだろう。そう思わせてくれるEND6が大好きで、彼らの続きを見てみたいとずっと焦がれておりました。漫画やイラストなど形式は問いませんので、遺伝子ケーキ様の思いのままに描いていただければ嬉しいです！\n\nご検討のほどよろしくお願いいたします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@CakesDna/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3096285, "client_id": 309735