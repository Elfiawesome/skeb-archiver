ただけると大変うれしいです…！\n\n要望が数多く大変恐縮でございますが、是非とも、よろしくお願いいたします…！\n\nhttps://drive.google.com/file/d/1uYCGY9eAZu1Vc-4wrCv0aaqv7MKc15AX", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 22365, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "せかいせいは", "screen_name": "sekaiseihasann", "avatar_url": "https://pbs.twimg.com/profile_images/2033655555303354368/C06z2XIj.png", "header_url": "https://pbs.twimg.com/profile_banners/3294835633/1719139599/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "novel"}, {"genre": "video"}, {"genre": "music"}], "banned": false, "nc": 145}, {"id": 89076, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ゼフィ", "screen_name": "zephy_full", "avatar_url": "https://pbs.twimg.com/profile_images/1794362231423172608/YjbpQ0cB.png", "header_url": "https://pbs.twimg.com/profile_banners/4419859332/1754218553/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 1187928, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "巳船", "screen_name": "_Uawa", "avatar_url": "https://pbs.twimg.com/profile_images/1418783833688662020/y-XniCGv.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 25, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 1