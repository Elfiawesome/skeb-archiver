ate_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2274960, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9523fe4/uploads/origins/2893d43d-da90-4c3e-a5c4-e5c8959b0cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52907ffae08d66bae4776bc896c269d8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9523fe4/uploads/origins/2893d43d-da90-4c3e-a5c4-e5c8959b0cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58f3b847f1aa9789bc4799b2946d3f0d", "src_set": ""}, "body": "仕事が終わって嬉しい、艦これの戦艦アイオワをお願いします。\nイラストのどこかに「しごおわ」「しごおわ！」などと入っていると嬉しいです。\n仕事が終わって帰宅した際にインターネット掲示板へ貼り付ける事を目的としていますが、可能であればよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mocchichani/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2274960, "client_id": 422964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b80f46a7/uploads/origins/c128bf80-e47a-446f-9064-0cfee717cb2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cdd2b086a13d5b7d70e89307e09b659", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b80f46a7/uploads/origins/c128bf80-e47a-446f-9064-0cfee717cb2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b744bfb3c6395ba6c7bf91c8c3f45bdc", "src_set": ""}, "body": "艦これの神通をお願いします！\n\n衣装は改二の姿で、腕と脚の艤装とサラシを省略した素手素足の格好にしてください。\n\nポーズはリラックスした体育座りのような体勢で、頭を少し傾げながら、こちらに微笑んでいる表情をお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mocchichani/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2274960, "client_id": 2291369, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bbb9225/uploads/origins/a4d23373-e28d-4c5c-bae6-4070ee59820c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b859fa7432ce9f18aa73e440538b51f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5bbb9225/uploads/origins/a4d23373-e28d-4c5c-bae6-4070ee59820c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db5f2217be858b938fc4be6983e794fc", "src_set": ""}, "body": "もっち先生いつも可愛いイラストありがとうございます。\n今回、先生の既刊、海防艦ＬＶ１がとっても可愛かったので、プリンツオイゲンの可愛いＬＶ１状態のイラストをお願いします。\n予算上可能であれば赤ちゃんの世話などしたことがないビスマルクがアタフタしながらあやしているシーンにして下さると嬉しいです。（お忙しい時期かと思いますのでプリンツオイゲンＬＶ１単艦でもかまいません。その場合のシチュエーション、小物などはお任せ致します）\nよろしくご検討の程、お願いします。", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mocchichani/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2274960, "client_id": 2291369, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c997073/uploads/origins/a92f7b5f-ccc6-4b8a-9fa4-07c35390fcc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64ce1f12d1ffd8ed60437fa76da15c89", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c997073/uploads/origins/a92f7b5f-ccc6-4b8a-9fa4-07c35390fcc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d607eb055b060a64c9e858ec40812e0f", "src_set": ""}, "body": "２０２３夏イベント、ついに丁型海防艦第二十二号、通称ふーふちゃんが着任しました。\nそこで今回のリクエストですが、着任直後に鎮守府へと連れられ、右も左も分からずに半べそのふーふちゃんをよつとみとが慰めている微笑ましい様子をリクエストいたします！\nよつはスキャンプから受け取った星型の雨を差し出し、みとは頭を撫でている、みたいな感じを想像していますがそれぞれの表情や仕草はお任せいたします。\n作画コストとご予算の都合で可能であれば、壁角（または扉の影など）から頭を出してこっそり見守る松、スキャンプ、雲龍を入れて下さると嬉しいです（いなくてもかまいません）\nご検討宜しくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mocchichani/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2274960, "client_id": 2291369, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3da9144/uploads/origins/849fb9b4-695a-4f61-9d2b-20c7f6fab38b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5f98820650d335c7e642cfa5892d12c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3da9144/uploads/origins/849fb9b4-695a-4f61-9d2b-20c7f6fab38b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d5fa1c8bdf92dca17df03ac799d3e15", "src_set": ""}, "body": "もっち先生、こんにちは！　久しぶりのリクエストです。\n\nスキャンプに肩車して貰って夏祭りの屋台を巡るよつのイラストをお願いします！！\n衣装は二人とも浴衣でお願いします！\n状況としては、何かの屋台を見つけてよつが「あ、あそこに行って下さいすきゃんぷ！」といった感じで行きたいところを指差し、スキャンプはやれやれまたか、と言った表情（それでいてとても嬉しそうな感じ）でお願いします。\n周囲の屋台、取り巻くキャラクターのシチュエーションは可能であれば追加願います。\n例：微笑ましく見つめる松型駆逐艦や、みとと鵜来ちゃんなど。\n\n全体の雰囲気は、先生の既刊、よつのおしごと２　すきゃんぷといっしょの鎮守府をイメージしています。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mocchichani/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2274960, "client_id": 2291369, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9477de0b/uploads/origins/c43d16af-6298-4cae-8e5d-4cb5e890a743?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42997e1b83f635a523b208ae9d8fd029", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9477de0b/uploads/origins/c43d16af-6298-4cae-8e5d-4cb5e890a743?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b93bcf4584f253f627bc866fef227fd", "src_set": ""}, "body": "もっち先生、再びリクエストさせていただきます！\n\n以下イメージです。\n\n鎮守府では潜水艦VS海防艦の演習を実施していた。\n鵜来、よつ、みとの３名対スキャンプ、ゴーヤ、まるゆ３名の演習である。\n\n潜水艦の動きに翻弄され、追い込まれた海防艦達は、鵜来を筆頭に戦艦ばりの\n爆雷タッチを発動し、勝利を収めた。\n\nというイメージイラストをお願いします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mocchichani/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2274960, "client_id": 2291369, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bba9a8af/uploads/origins/e4e94d04-cd08-496b-bec3-5cdc27971ffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=760bc5e5615e6fe8e371137e002da03a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bba9a8af/uploads/origins/e4e94d04-cd08-496b-bec3-5cdc27971ffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcad4641077cf2fc45c42dc7fe2bc6ef", "src_set": ""}, "body": "激しい戦いを共に乗り切ったアイオワと択捉型海防艦達、沈んでしまったアイオワが再び顕現した事に気づいた大破状態の松輪はアイオワに駆け寄る。\n\n－　二人の再会、記憶を取り戻したアイオワと、松輪は固く抱き合う。\nお互いの温もりを確かめ合うように。\n\nというワンシーンをもっちさんの絵で見たいと思いリクエストしました。よろしくお願いします！\n\n資料『７人のアイオワ』ラストシーン　未来へ(17ページ）をイメージしています。\n\nhttps://www.pixiv.net/novel/show.php?id=17792536", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 213957, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "鈍挫", "screen_name": "gyosonnotamiyo", "avatar_url": "https://pbs.twimg.com/profile_images/1581370223281963014/5nSMrHOJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1187287187928178688/1650779742/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "skills": [{"genre": "art"}], "nc": 49}, {"id": 1219293, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ke