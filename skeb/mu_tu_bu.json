クエストを送る前に、以前描いていただいたリクエストに感謝申し上げます。\n\n今回は、ファイアーエムブレム エンゲージのアイヴィーがソロのシンクロナイズドスイミングの演技をしているイラストを2点描いていただきたいです。\n\n最初のイラストは、水中に直立した姿勢でポーズを取るアイビーの絵です。2つ目のイラストは、水面から脚を伸ばしただけのアイビーの絵です。両方のポーズとアイビー本人の参考資料を以下に提供します。\n\n彼女がパフォーマンスで着用する衣装は、『ファイアーエムブレム ヒーローズ』の夏用衣装（スカート部分を除く）となります。\n\n舞台はソムニエルのプールでお願いします。\n\nよろしくお願いします。\n\nhttps://imgur.com/a/ivy-request-u4ytJQN", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mu_tu_bu/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1058507, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b2f9202/uploads/origins/890cade3-3ef2-424f-8b28-748b0b4f9748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af8202d746be2cd2f074103c90393c4f", "srcset": "https://si.imgix.net/5b2f9202/uploads/origins/890cade3-3ef2-424f-8b28-748b0b4f9748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af8202d746be2cd2f074103c90393c4f, https://si.imgix.net/5b2f9202/uploads/origins/890cade3-3ef2-424f-8b28-748b0b4f9748?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f182688a6e78b882292df53af5d9b6e 2x, https://si.imgix.net/5b2f9202/uploads/origins/890cade3-3ef2-424f-8b28-748b0b4f9748?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0f9bb09495f4712166b54ca3396f77b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b2f9202/uploads/origins/890cade3-3ef2-424f-8b28-748b0b4f9748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6cef07b32a048589cd48e8ffc19badf", "srcset": "https://si.imgix.net/5b2f9202/uploads/origins/890cade3-3ef2-424f-8b28-748b0b4f9748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6cef07b32a048589cd48e8ffc19badf, https://si.imgix.net/5b2f9202/uploads/origins/890cade3-3ef2-424f-8b