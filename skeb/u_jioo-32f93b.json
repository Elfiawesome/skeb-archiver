igins/5d1bfb14-c67d-42a6-bd32-befd626e4ca4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f5f0b3898e9a590bec79574a274822a, https://si.imgix.net/af508bb4/uploads/origins/5d1bfb14-c67d-42a6-bd32-befd626e4ca4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b63a0c768c54beb900b5d0ba3cc78ae0 2x, https://si.imgix.net/af508bb4/uploads/origins/5d1bfb14-c67d-42a6-bd32-befd626e4ca4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=42bb7fa6f30b4b571cddad96b4f3e462 3x"}, "body": "宇治様、こんばんは。今回、OC2名のイラストを描いていただきたくリクエストさせていただきました。\nOCの詳細は資料URLをご参照ください。\n\n【関係（ざっくり）】\n・友達以上恋人未満\n・ドキが千行のことを溺愛している\n・千行はドキのことが嫌い\n\n【リクエスト内容】\n・不穏で少し緊張感のある暗めの雰囲気\n・距離が近め\n・危うさや謎めいた印象を感じられる構図だと嬉しいです。\n・衣装や髪型、構図、描写範囲などはおまかせでお願いいたします。詳細にNGと書いているもの以外であれば好きに描いていただいて構いません。\n\n【要望】\n・どちらも男性ですので、そちら意識していただければ嬉しいです。また、アクセサリーやネイル等が忘れられがちなので、こちらも意識していただきたいです。\n・通常のデータ、サイン（ある場合）なしのデータ、キャラクターのみ（透過）のデータと分けて納品していただければ嬉しいです。\n\n【使用用途】\n・個人鑑賞\n・SNSへの投稿やアイコン、ヘッダーへの使用、キャラクター資料への使用\n商標利用はいたしません。\n\n以上、ご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1i8sM5f5mnFqtQzwg3Qrl0WpFpRd7QPiO", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_jioo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3812600, "client_id": 3830126, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/58b34fb9/uploads/origins/31cefe12-6845-40de-b0c2-bf441e0753ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a560c8ae18d6f66bc14ea538bf8a1160", "srcset": "https://si.imgix.net/58b34fb9/uploads/origins/31cefe12-6845-40de-b0c2-bf441e0753ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a560c8ae18d6f66bc14ea538bf8a1160, https://si.imgix.net/58b34fb9/uploads/origins/31cefe12-6845-40de-b0c2-bf441e0753ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69f88085c775220a9844fa710b574240 2x, https://si.imgix.net/58b34fb9/uploads/origins/31cefe12-6845-40de-b0c2-bf441e0753ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83420a3d69ce020f0a31c2ad894d8bf0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/58b34fb9/uploads/origins/31cefe12-6845-40de-b0c2-bf441e0753ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f16f5d76fa13cc3500d02e286aa50ac", "srcset": "https://si.imgix.net/58b34fb9/uploads/origins/31cefe12-6845-40de-b0c2-bf441e0753ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f16f5d76fa13cc3500d02e286aa50ac, https://si.imgix.net/58b34fb9/uploads/origins/31cefe12-6845-40de-b0c2-bf441e0753ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7c8e82ad501dba72a5dd07e5abb09041 2x, https://si.imgix.net/58b34fb9/uploads/origins/31cefe12-6845-40de-b0c2-bf441e0753ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3f8da63c2b8be769de003496aed19ffe 3x"}, "body": "はじめまして、こんばんは！\n 宇治様の素敵なイラストを拝見し、オリジナルキャラクターを描いていただきたくリクエストを送らせていただきました。依頼する際の参考資料、アイコン、観賞用として使用させていただきたく思います。可能であれば背景が透過されたものもいただければ幸いです。\n\n  ・名前▶︎蒼猫羊 \nNG等ありませんので、お好きに書いて頂ければと思います。服装も、URLの中の制服か私服から選んで頂けると嬉しいです！ \n\n 目は、開眼と糸目ver.がありますがどちらでも大丈夫です！  \n\n・性格▶︎普段は冷静であまり騒がないタイプ。大きく笑ったり、大きなリアクションを取ることはあまりない。\n\n  ・身長▶︎177cm  \n\nご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/16WxiimhFZEshrvcfraeKKAvNzIHVfzHL", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_jioo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3812600, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e7d910a/uploads/origins/5da21dad-a3db-463a-a04e-09035ff87e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=397570fda56c7dbc3e9f1a532b480955", "srcset": "https://si.imgix.net/3e7d910a/uploads/origins/5da21dad-a3db-463a-a04e-09035ff87e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=397570fda56c7dbc3e9f1a532b480955, https://si.imgix.net/3e7d910a/uploads/origins/5da21dad-a3db-463a-a04e-09035ff87e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6840552a3090e8731a6921a275e43d0b 2x, https://si.imgix.net/3e7d910a/uploads/origins/5da21dad-a3db-463a-a04e-09035ff87e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9a320cc9b42aa45ec3ceb30d25b7e1d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e7d910a/uploads/origins/5da21dad-a3db-463a-a04e-09035ff87e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28cf07ecd3ef4e1494929d46742b1379", "srcset": "https://si.imgix.net/3e7d910a/uploads/origins/5da21dad-a3db-463a-a04e-09035ff87e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28cf07ecd3ef4e1494929d46742b1379, https://si.imgix.net/3e7d910a/uploads/origins/5da21dad-a3db-463a-a04e-09035ff87e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=173558385996a45a3ce61f5cfdc371d4 2x, https://si.imgix.net/3e7d910a/uploads/origins/5da21dad-a3db-463a-a04e-09035ff87e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f96a38198a72e9e619b61ecfa42e0f7 3x"}, "body": "宇治@Skeb募集中さんはじめまして。\n当方の創作CPをぜひ描いていただければと思い、リクエストさせていただきました。\n\n服装、構図など自由に描いて頂きたいです…！白髪OCが金髪OCを小馬鹿にしている感じですと助かります。\n\n不足などありましたら再送申請をよろしくお願いします。\nご検討よろしくお願いします♩\n\nhttps://drive.google.com/drive/folders/1MCWzbi8SUtZCqA2feaAhViV-aASao17k", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_jioo/works/4", "private_thumbnail_ima