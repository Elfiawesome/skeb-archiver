可はいただいております。\n\n◇依頼内容\nOC二人が写ったイラストをお願いしたいです。\n構図や描写範囲は、描きやすい形でおまかせさせていただければと思います。\n\n◇参考資料\nGoogleドライブ内の立ち絵・キャラクター資料をご参照ください。\n\n◇使用用途\n・SNSでの納品報告\n・壁紙やアイコンなど個人利用\n・一緒に写っているOCの製作者への共有（個人利用の範囲内）\n\n金額や条件が難しい場合は、お手数ですがキャンセルしていただいて大丈夫です。\nご多忙のところ恐れ入りますが、ご検討いただけますと幸いです…！\n\nhttps://drive.google.com/drive/folders/1pi-54ryIR7J043mK7RY4ocx-zJJmRV_p", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_jioo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3812600, "client_id": 3676848, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b2541fc/uploads/origins/b32a434f-1bb6-494f-89e0-d8915cd672e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66bbee0ef14b9c182b5137f1e48d6e58", "srcset": "https://si.imgix.net/4b2541fc/uploads/origins/b32a434f-1bb6-494f-89e0-d8915cd672e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66bbee0ef14b9c182b5137f1e48d6e58, https://si.imgix.net/4b2541fc/uploads/origins/b32a434f-1bb6-494f-89e0-d8915cd672e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=670520e9f53eb85b68906d5bbbe7d9c9 2x, https://si.imgix.net/4b2541fc/uploads/origins/b32a434f-1bb6-494f-89e0-d8915cd672e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1c22d5f74c2830d6aa38d2d68e60061 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b2541fc/uploads/origins/b32a434f-1bb6-494f-89e0-d8915cd672e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=066918c8b7f20daba8d6c22fd294c576", "srcset": "https://si.imgix.net/4b2541fc/uploads/origins/b32a434f-1bb6-494f-89e0-d8915cd672e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=066918c8b7f20daba8d6c22fd294c576, https://si.imgix.net/4b2541fc/uploads/origins/b32a434f