-4fd3-a3e2-439d56346f97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b9834776f975f2f468689796bf0c69e 2x, https://si.imgix.net/44756066/uploads/origins/5ca757e1-a35a-4fd3-a3e2-439d56346f97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07f10ef0d9d089409a07d7dfac6d9761 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44756066/uploads/origins/5ca757e1-a35a-4fd3-a3e2-439d56346f97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2fe1e668c557418e2229577bc971114", "srcset": "https://si.imgix.net/44756066/uploads/origins/5ca757e1-a35a-4fd3-a3e2-439d56346f97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2fe1e668c557418e2229577bc971114, https://si.imgix.net/44756066/uploads/origins/5ca757e1-a35a-4fd3-a3e2-439d56346f97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=da507e5e76d3801010af6172809e4e23 2x, https://si.imgix.net/44756066/uploads/origins/5ca757e1-a35a-4fd3-a3e2-439d56346f97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=97aa19e1213882862bc7eb5c2162e8a1 3x"}, "body": "吉沢ファラヲさん初めまして！ \n 吉沢ファラヲさんのイラストや漫画の空気感に一目ぼれをし、ぜひ依頼させていただきたいと思い、リクエストを送りました！  \n\n依頼内容なのですが、クトゥルフ神話TRPGにて作成したキャラクターのコミックを描いていただきたいと考えています。 \n資料としてGoogleドライブのリンクを置かせていただきます。\n\n■水色の髪の女性：九日 菜月（ここのか なつき）\n年齢：29歳　公安部所属\n天才的な才能を持つ孤高の女性で、感情表現に乏しく、他人と距離を置いてきた。ただし、相笠に対しては並び立つ存在であってほしいという期待を抱いている。\n\n■黒髪の男性：相笠 くゆる（あいがさ くゆる）\n年齢：25歳　同じく公安所属の新人。菜月のバディ\n自分を“秀才止まり”と自認しながらも、彼女を尊敬し、心の奥では恋心を抱いている。感情表現が苦手な菜月に寄り添おうとし、真っ直ぐに彼女を見ている。寡黙で不器用ながら、人を安心させるような優しさと意志を持っている。無愛想で口下手ではあるが、その分行動で示す。\n\n【関係性の補足】\n菜月にとって、相笠は孤独を理解してくれるかもしれない人物で、完璧であることを求められ続けてきた彼女が、初めて自分の“わからなさ”と向き合うきっかけをくれた存在です。\n相笠にとって菜月は、遠くにいる光のような存在でありながら、自分の手で守りたいと願う人です。\nいまだ不完全で不器用ですが、お互いを知ろうとしている最中という関係性です。\n\nもしよろしければご依頼を受けてくださると幸いです。\n\nhttps://drive.google.com/drive/folders/1-LCeZSBvqztDfBM_z6XsGx_5lOveSos7", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sazaraka_22/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3696915, "client_id": 3114719, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/05788397/uploads/origins/aafc4f75-274b-46b3-b28d-a8e66d3e53af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d676ffc79b87d415cecb8671003a493", "srcset": "https://si.imgix.net/05788397/uploads/origins/aafc4f75-274b-46b3-b28d-a8e66d3e53af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d676ffc79b87d415cecb8671003a493, https://si.imgix.net/05788397/uploads/origins/aafc4f75-274b-46b3-b28d-a8e66d3e53af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8badf157e07a07b3f4d192e7568cacb2 2x, https://si.imgix.net/05788397/uploads/origins/aafc4f75-274b-46b3-b28d-a8e66d3e53af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0b81a41ec5cf62d8fd0178edb936445 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/05788397/uploads/origins/aafc4f75-274b-46b3-b28d-a8e66d3e53af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df4d966b1196b0938b3b758f42363c04", "srcset": "https://si.imgix.net/05788397/uploads/origins/aafc4f75-274b-46b3-b28d-a8e66d3e53af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df4d966b1196b0938b3b758f42363c04, https://si.imgix.net/05788397/uploads/origins/aafc4f75-274b-46b3-b28d-a8e66d3e53af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28ae5589e25cf999b5f075f4938d8648 2x, https://si.imgix.net/05788397/uploads/origins/aafc4f75-274b-46b3-b28d-a8e66d3e53af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2817ba35471609228c6d5aebdd1eeb17 3x"}, "body": "さざちか✊新刊通販🌈✨さん、skeb開設本当にありがとうございます！！！！とってもうれしいです！\nぜひ依頼させていただきたいと思い、リクエストを送りました！  \n\n依頼内容なのですが、クトゥルフ神話TRPG『遺香廻り』にて作成したキャラクターを描いていただきたいと考えています。 \n資料としてGoogleドライブのリンクを置かせていただきます。\n\n■水色の髪の女性：九日 菜月（ここのか なつき）年齢：29歳　公安部所属\n天才的な才能を持つ孤高の女性で、感情表現に乏しく、他人とは距離がある。ただし、相笠に対しては「並び立つ存在」であってほしいという期待があった。最近は並びたってくれたためそのままで居続けて欲しいとおもっている。自分を孤独とは感じていない。\n\n■黒髪の男性：相笠 くゆる（あいがさ くゆる）年齢：25歳　同じく公安所属の新人。菜月のバディ\n自分を秀才止まりと自認しながらも、彼女を尊敬し、恋心を抱いている。感情表現が苦手な菜月に寄り添おうとし、真っ直ぐに彼女を見ている。寡黙で不器用ながら、人を安心させるような優しさと意志を持っており、口よりも行動で示す。彼女からの期待が重荷になっているが、それを気づけずに過ごしている。\n\n【関係性の補足】\n菜月にとって相笠は孤独を埋めてくれる人物(隣に立つ存在)で、完璧であることを求められ続けてきた彼女が、初めて自分の“わからなさ”と向き合うきっかけをくれた存在。\n相笠にとって菜月は、遠くにいる光のような存在でありながら、自分の手で守りたいと思う人物です。このように2人の認識に乖離があります。\n\n2人のキャラクターシートです\nクトゥルフ神話trpg『遺香廻り』のネタバレを含みますので、閲覧が大丈夫であればご覧ください↓\nhttps://iachara.com/view/10301938\nhttps://iachara.com/view/10429373\n\nもしよろしければご依頼を受けてくださると幸いです。\n\nhttps://drive.google.com/drive/folders/1-LCeZSBvqztDfBM_z6XsGx_5lOveSos7", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Hachi8_8888/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3019024, "client_id": 3114719, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a0a2c44/uploads/origins/ad7fd69f-4c4f-485b-8340-408c133a7670?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11c9f4c667d6dd0df38a55c5265edb45", "srcset": "https://si.imgix.net/5a0a2c44/uploads/origins/ad7fd69f-4c4f-485b-8340-408c133a7670?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11c9f4c667d6dd0df38a55c5265edb45, https://si.imgix.net/5a0a2c44/uploads/origins/ad7fd69f-4c4f-485b-8340-408c133a7670?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d9c71e87d1a2adc166ae36d8cb02c1b 2x, https://si.imgix.net/5a0a2c44/uploads/origins/ad7fd69f-4c4f-485b-8340-408c133a7670?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d41ba143785a6968a40ecb720a16f65 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a0a2c44/uploads/origins/ad7fd69f-4c4f-485b-8340-408c133a7670?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25487be21603c1dbbaac0d348afac197", "srcset": "https://si.imgix.net/5a0a2c44/uploads/origins/ad7fd69f-4c4f-485b-8340-408c133a7670?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25487be21603c1dbbaac0d348afac197, https://si.imgix.net/5a0a2c44/uploads/origins/ad7fd69f-4c4f-485b-8340-408c133a7670?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d1c85cee4eeb5412a0d9597a0545b175 2x, https://si.imgix.net/5a0a2c44/uploads/origins/ad7fd69f-4c4f-485b-8340-408c133a7670?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a360b517c3d45a907c0591d8476300a5 3x"}, "body": "はちさん🎱、こんにちは。\nいつもはちさんの素敵なイラストを拝見し、その表現力や雰囲気に憧れています。\nこのたびぜひ描いていただきたく、Skebにて依頼をお送りいたしました。\n\n依頼内容は、クトゥルフ神話TRPG『Paranormal Crime』で作成した HO4のイラストです。\n服装は添付資料かはちさんが描きやすいもの、構図はおまかせでお願いいたします。\n参考資料は Google ドライブにまとめておりますので、下記リンクからご確認ください。\n\n【キャラクター説明】\n名前：アガサ・グレアム（Agatha Graham）\n年齢：25歳\n性別：女性\n身長：150cm\n\n控えめな性格ながら、数年のFBI勤務で自信を得た。元々会話好きで、人の話をよく聞く。\n不幸体質で、毎朝の星座占いを欠かさずチェックし、日替わりのラッキーアイテムを必ず持ち歩く（ときどき謎の物も多い）。\n観葉植物を育てるのが趣味で、静かな時間や小さな幸せを大切にしている。\n\n完成イラストは個人鑑賞のほか、Twitterのヘッダーやアイコン等にも使用予定です。\nお忙しい中恐縮ですが、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1JnnKV9UFUvbCmlUhtuZRSu7rIBi2nE-p", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": []}, "price_history": {"art": [{"amount": 700, "recorded_at": 1774038992.267964}, {"amount": 500, "recorded_at": 1779818865.734067}, {"amount": 2000, "recorded_at": 1783778644.794556}], "novel": [{"amount": 700, "recorded_at": 1774038992.267964}, {"amount": 500, "recorded_at": 1779818865.734067}, {"amount": 2000, "recorded_at": 1783778644.794556}], "comic": [{"amount": 500, "recorded_at": 1779818865.734067}, {"amount": 2000, "recorded_at": 1783778644.794556}]}, "custom": {}}