わりに行動で示す。菜月に対して盲目的ではないが、菜月の話すことは基本的に正しいので従っている。表情は硬いが、元々は感情が豊かであるため、片鱗は垣間見える。\n\n金額が足りない場合や不備があった場合、再送してくださると幸いです。\n\nhttps://drive.google.com/drive/folders/1-LCeZSBvqztDfBM_z6XsGx_5lOveSos7", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Uy8Dg/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3901292, "client_id": 3114719, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95278f4e/uploads/origins/bab6265f-d1ae-404c-9a9d-4bf93ab63afa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e8153815b3e1df3957fb55cc61944dd", "srcset": "https://si.imgix.net/95278f4e/uploads/origins/bab6265f-d1ae-404c-9a9d-4bf93ab63afa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e8153815b3e1df3957fb55cc61944dd, https://si.imgix.net/95278f4e/uploads/origins/bab6265f-d1ae-404c-9a9d-4bf93ab63afa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55135ade20c668ee85db2958aebe7b88 2x, https://si.imgix.net/95278f4e/uploads/origins/bab6265f-d1ae-404c-9a9d-4bf93ab63afa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf987ae99d903a5dcaa8f68afda54804 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95278f4e/uploads/origins/bab6265f-d1ae-404c-9a9d-4bf93ab63afa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6c5f783c2ff7ac6b69ffa036a50a235", "srcset": "https://si.imgix.net/95278f4e/uploads/origins/bab6265f-d1ae-404c-9a9d-4bf93ab63afa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6c5f783c2ff7ac6b69ffa036a50a235, https://si.imgix.net/95278f4e/uploads/origins/bab6265f-d1ae-404c-9a9d-4bf93ab63afa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8cb14d0da23e52b7aa84bdce670fa558 2x, h