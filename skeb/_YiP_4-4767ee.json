6d-1b0716a2a8d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b60c2863f9e322e640c03b651980e997, https://si.imgix.net/4604b6d8/uploads/origins/10cae126-fcfa-49b3-a56d-1b0716a2a8d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51d71f1ce163bb21630e13aafe45c766 2x, https://si.imgix.net/4604b6d8/uploads/origins/10cae126-fcfa-49b3-a56d-1b0716a2a8d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed631b6c9f6b2e266a1336953bd0eede 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4604b6d8/uploads/origins/10cae126-fcfa-49b3-a56d-1b0716a2a8d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22bf217a6e61eeec23bf8b39b5c75d5d", "srcset": "https://si.imgix.net/4604b6d8/uploads/origins/10cae126-fcfa-49b3-a56d-1b0716a2a8d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22bf217a6e61eeec23bf8b39b5c75d5d, https://si.imgix.net/4604b6d8/uploads/origins/10cae126-fcfa-49b3-a56d-1b0716a2a8d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=46ac2d19527886c5a49db5136fe3a356 2x, https://si.imgix.net/4604b6d8/uploads/origins/10cae126-fcfa-49b3-a56d-1b0716a2a8d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5df2bbd11e95217163ad6e30b2eba39 3x"}, "body": "いつもかわいい絵を描いてくださり、ありがとうございます。\nおかげで毎日癒されています。。。\n\n◆リクエスト\nマビノギの、私のサブキャラの絵をお願い致します。\n\n【テーマ】\n・魔法使い装備（ケルティックガーディアンスタッフ）\n・衣装はいくつかサンプルを示していますが、お好きな衣装を選んでいただければ。\n\n【ポーズ】\n・「魔法をぶちかまして、敵をやっつけるぞ！」って感じの躍動感と勇ましさを表現くださるとうれしいです。\n\n【その他要望】\n・小さくてかまいませんので、足元にぶたさんも描いていただけますと、幸いです。\n・ご都合に合わせて、ゆっくり描いてくださって問題ありません。\n　先生の絵でしたら、いくらでも待ちますっ！！\n\nよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_YiP_4/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped"