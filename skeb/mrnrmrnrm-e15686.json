et/e0d97f61/uploads/origins/2f01da1d-dd70-4d80-93b0-02b88bfeacad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c5a8f61fd313819cc08100d40304057, https://si.imgix.net/e0d97f61/uploads/origins/2f01da1d-dd70-4d80-93b0-02b88bfeacad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ab8c4ca3da396c031d95eb9fd6bb631 2x, https://si.imgix.net/e0d97f61/uploads/origins/2f01da1d-dd70-4d80-93b0-02b88bfeacad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7bd59d99e9184088c102f3bfa31ae6b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0d97f61/uploads/origins/2f01da1d-dd70-4d80-93b0-02b88bfeacad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce11649c2f3b2ff3cf28cb68cc44963a", "srcset": "https://si.imgix.net/e0d97f61/uploads/origins/2f01da1d-dd70-4d80-93b0-02b88bfeacad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce11649c2f3b2ff3cf28cb68cc44963a, https://si.imgix.net/e0d97f61/uploads/origins/2f01da1d-dd70-4d80-93b0-02b88bfeacad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0993e04d4d19b51300ff9137e4a6c00c 2x, https://si.imgix.net/e0d97f61/uploads/origins/2f01da1d-dd70-4d80-93b0-02b88bfeacad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=35f3610f9b8a1e042636de37a24722da 3x"}, "body": "misskey.designから来ました！\nめらめらのさんに、自キャラの現パロ一枚絵を描いていただきたいです。服装は参考までに記載しますが、所持品含め自由に描いていただいて構いません。\n\n■キャラ名\n★セルシア（20歳、男）183cm\n赤みがかった銀髪前上がりボブ、瞳孔のない銀色のカラコンを愛用、やや垂れ目、左利き。灰色のコートの下は黒いノースリーブシャツ、深緑色のズボン。演奏筋がそれなりについている。\nニューヨークのダウンタウンで生まれ育つ、ロックバンド「The Arrested Angels」（通称Arre'N）のギター＆ボーカル、兼娼夫（男女不問）。刹那的で快楽主義、だいたいいつも笑顔、被虐の方が得意で、顔以外は傷だらけ。\n\n☆リノ（16歳、男）167cm（余裕があれば。セルシアのみでも大丈夫です）\n金髪ロング三つ編みの色白華奢美人、瞳は黒、少し吊り上がった切れ長の目。原作では喉に自傷痕があるが、現パロではまだ無い。ファッションはピンクやアメカジが好き。\n自身の激しい加虐欲求を抑圧して生きてきた。ずっと憧れだった幼馴染のクリスと1日だけ恋人関係を成就させ、これ以上は自分を抑えられないと判断して身を引く。\n高一の終わり、留学先のニューヨークにてセルシアと邂逅。年齢を偽り加虐欲求を発散させてもらう。\n\n■参考資料（必要に応じ参考にしてください。上記のみで描いていただいても構いません）\n小説〈僕らの壊せない三角〉「僕が最悪と出会った日」\nhttps://www.pixiv.net/novel/show.php?id=21942556\n参考イラスト（現パロのイラストはまだ無いので原作の方を添付します）\nセルシア\nhttps://misskey.design/notes/9p6w17btrv\nリノ\nhttps://misskey.design/notes/9rvgxikp3h\n\n■その他\n納品物をPNG方式で保存した状態で、カクヨム・みすでざ・ツイッター等SNSでの宣伝に使用するかもしれないです。\n\n以上になります、よろしくお願いいたします！\n\nhttps://www.pixiv.net/novel/show.php?id=21942556", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mrnrmrnrm/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1147735, "client_id": 2843424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/046761f2/uploads/origins/143669e6-f559-4b39-9627-fbe416d3755a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c8d895493a589675d8e561a4becdec9", "srcset": "https://si.imgix.net/046761f2/uploads/origins/143669e6-f559-4b39-9627-fbe416d3755a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c8d895493a589675d8e561a4becdec9, https://si.imgix.net/046761f2/uploads/origins/143669e6-f559-4b39-9627-fbe416d3755a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df6090570dd926b3f6c21169452e2905 2x, https://si.imgix.net/046761f2/uploads/origins/143669e6-f559-4b39-9627-fbe416d3755a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22fffc19121258e4db01af5d8743f62f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/046761f2/uploads/origins/143669e6-f559-4b39-9627-fbe416d3755a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc7e5f0bd6bcf9aaecd7416b3e7f6d42", "srcset": "https://si.imgix.net/046761f2/uploads/origins/143669e6-f559-4b39-9627-fbe416d3755a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc7e5f0bd6bcf9aaecd7416b3e7f6d42, https://si.imgix.net/046761f2/uploads/origins/143669e6-f559-4b39-9627-fbe416d3755a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8f3cb0a1526944518ed1ee8e8b58895e 2x, https://si.imgix.net/046761f2/uploads/origins/143669e6-f559-4b39-9627-fbe416d3755a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd8feb58bc0a2586b8300881fa95224c 3x"}, "body": "いつもMisskey.designでお世話になっております。\n\nこのたびはめらめらのさんのキャラクター、リチャードさんとメイデルさんを描いていただけないかと思い、リクエストいたしました。\n\n希望は、朝の一場面。先に目覚めたリチャードさんが、眠っているメイデルさんを見つめているというシーンです。デフォルメ調＆全年齢な感じだとうれしいです。\n一番の希望は上記ですが、「そんなことはしない」といった解釈違いの場合は、別のシーンをおまかせします。寿司を食べているふたりでも、冬のお忍びデートでもなんでも！\nふたりの関係性が好きなので、とにかくリチャードさんとメイデルさんが一緒にいる新規イラストが何か一枚見られたらうれしいです！\n今回に関しては、デフォルメ調のものを新規で見てみたいという希望はあります。\n\n条件面で難しければ、遠慮なく断ってください。\nお忙しいと思いますが、よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mrnrmrnrm/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1147735, "client_id": 932268, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8afb856f/uploads/origins/e03113b8-3a14-4295-87a1-0a00138f5507?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8fe2c219d1147b0a92dad6023ae7d9e", "srcset": "https://si.imgix.net/8afb856f/uploads/origins/e03113b8-3a14-4295-87a1-0a00138f5507?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8fe2c219d1147b0a92dad6023ae7d9e, https://si.imgix.net/8afb856f/uploads/origins/e03113b8-3a14-4295-87a1-0a00138f5507?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb2a7cc9a33186094cbf2cc4f6d08347 2x, https://si.imgix.net/8afb856f/uploads/origins/e03113b8-3a14-4295-87a1-0a00138f5507?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60bea34ba290f2b1ef5b4b88a7743b1a 3x"