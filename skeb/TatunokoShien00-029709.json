rop=top&w=200&h=200&s=1ec573855da524e54cdca23de5ade624 2x, https://si.imgix.net/9c1efde8/uploads/origins/e47d2b10-09b7-4182-b131-3671c284bdad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a35b16ea30b1b4655a6b8307c3ed1cb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c1efde8/uploads/origins/e47d2b10-09b7-4182-b131-3671c284bdad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e10cf05d610df61d4e0ac4615462f99f", "srcset": "https://si.imgix.net/9c1efde8/uploads/origins/e47d2b10-09b7-4182-b131-3671c284bdad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e10cf05d610df61d4e0ac4615462f99f, https://si.imgix.net/9c1efde8/uploads/origins/e47d2b10-09b7-4182-b131-3671c284bdad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab2cf144a26b75219a5e076876facf5f 2x, https://si.imgix.net/9c1efde8/uploads/origins/e47d2b10-09b7-4182-b131-3671c284bdad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d0aa7f5ecfb0b483503bd9c053ae16dd 3x"}, "body": "はじめまして、成人向けの活動をしているVTuberの猫羽かりんと申します。\nSkebでイラストをお見かけして、お顔がかわいくて、さらに肌の透明感や汁感がとっても素敵だと思い、ぜひイラストのご依頼をさせていただけないかと思いご連絡させていただきました。\n\nお受けいただいた場合、イラストはTwitterのアイコンやヘッダー、\nYouTubeのサムネイル、チャンネルアート、 有料支援サイトのヘッダー、\n記事のサムネイル、音声作品のジャケット等、\n広報活動に使用させていただきたいと考えております。\n可能でしたら、なにとぞよろしくお願いいたします。\n\n【概要】\n耳舐めASMR・フェラ配信のサムネイル用イラスト\n可能であれば表情差分、衣装差分、キャラクターの透過差分をいただきたいです。\n金額の範囲内で可能であればよろしくお願いいたします。\n\n【キャラクターについて】\n参考資料　\nhttps://www.kemomimirefle.com/karin\n\n【構図】横構図だと使用しやすいです…！\n\n【シチュエーション】\n発情した様子でベッドの上で馬乗りになり、前かがみ？添い寝をしているような体勢で舌を出している。\n胸を強調してご描写いただけますと幸いです。\n\n【表情】①発情して舌を出した表情　②にっこりと誘うような表情\n少し熱で瞳が潤んでいるようなイメージです。\n\n【服装・髪型】\nパジャマ衣装\nhttps://gyazo.com/7cfa09b02fa5c7471b2c972e7ba21757\nhttps://gyazo.com/b3e2c5f5ca4537a1d43bf74ec9029e42\n髪型については可能でしたらショート・ロングの差分を希望します。\n（金額内で難しい場合にはどちらかで問題ございません。）\n可能であればルームウェアの脱着差分(裸カーディガン）をいただけると大変嬉しいです。\n（金額内で差分が難しい場合は裸カーディガン状態でご描写いただきたいです。）\n\nなにとぞ、よろしくお願いいたします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TatunokoShien00/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1618414, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f7f90146/uploads/origins/81ccb564-0e31-48f0-a999-c790b8a85cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=789118456470d1fbf241a2a288ba1576", "srcset": "https://si.imgix.net/f7f90146/uploads/origins/81ccb564-0e31-48f0-a999-c790b8a85cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=789118456470d1fbf241a2a288ba1576, https://si.imgix.net/f7f90146/uploads/origins/81ccb564-0e31-48f0-a999-c790b8a85cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe353c2fd2c094df909a56d110332e58 2x, https://si.imgix.net/f7f90146/uploads/origins/81ccb564-0e31-48f0-a999-c790b8a85cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6bdb1199f89c87e8ff79fa6f9973cea9 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f7f90146/uploads/origins/81ccb564-0e31-48f0-a999-c790b8a85cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=acfe07457a04f86378d4cb383cc17f45", "srcset": "https://si.imgix.net/f7f90146/uploads/origins/81ccb564-0e31-48f0-a999-c790b8a85cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=acfe07457a04f86378d4cb383cc17f45, https://si.imgix.net/f7f90146/uploads/origins/81ccb564-0e31-48f0-a999-c790b8a85cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3ab8ebfcf07029e3ec3f87557e30b05c 2x, https://si.imgix.net/f7f90146/uploads/origins/81ccb564-0e31-48f0-a999-c790b8a85cf9?bg=%23fff&auto=format%2Ccompress&fm=