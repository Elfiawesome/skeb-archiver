助手として、成長するにつれ護衛も兼ねた従者となった\n・性的な成熟に伴って、魔女に対して欲情を抱くようになり、最近は夜の関係も持つようになった\n\n精神的には受け役優位、肉体的には攻め役優位の、合意のあるレイプ気味なエロといった感じでイメージをしています。個人的に身長差のあるカップルが好きなため、攻め役と受け役の身長差が2倍程度（またはそれ以上でも）あると嬉しいです。\n\n上記はあくまでイメージなので、ほいみんさんの作風と考えに合わせて、ある程度柔軟に描いていただいて大丈夫です。\n\nご検討いただけると幸いです。宜しくお願い致します。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@frosted_hoim_in/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 741124, "client_id": 1622696, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20a59566/uploads/origins/f101359b-beeb-411e-8bcd-6d9e38d9dac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd51926645b9c7c376253b1b08a2c630", "srcset": "https://si.imgix.net/20a59566/uploads/origins/f101359b-beeb-411e-8bcd-6d9e38d9dac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd51926645b9c7c376253b1b08a2c630, https://si.imgix.net/20a59566/uploads/origins/f101359b-beeb-411e-8bcd-6d9e38d9dac5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c67b6e7f5601b63a7e2f8b5fed74a36 2x, https://si.imgix.net/20a59566/uploads/origins/f101359b-beeb-411e-8bcd-6d9e38d9dac5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=579847fd2e8562f1ea8063dd1451d231 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20a59566/uploads/origins/f101359b-beeb-411e-8bcd-6d9e38d9dac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77178e3bb0c3c875c6959de18428f77b", "srcset": "https://si.imgix.net/20a59566/uploads/origins/f101359b-beeb-411e-8bcd-6d9e38d9dac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77178e3bb0c3c875c6959de18428f77b, https://si.imgix.net/20a59566/uploads/origins/f101359b-beeb-411e-8bcd-6d9e38d9dac5?bg=%23fff&auto=format%2Ccompress&