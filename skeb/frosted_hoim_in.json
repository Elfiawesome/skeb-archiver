ストが格好よくて大好きです。\nもしよろしければ、ゲームで使用している自キャラクターのイラストをお願いしたく思い、依頼させていただきました。\n\n資料は下記の通りで、不明点は自由に創作いただいて構いません。\n二人は新婚夫婦で普段は野菜や果物を育てたりしています。\nダンジョン攻略時には男性は銃で戦い、女性は剣で戦うキャラクターです（この格好のままダンジョンに潜っています）。\n構図などの指定は特にありません。\nぜひよろしくお願い致します。\n\nhttps://twitter.com/yusu_s/status/1487107830696280064?s=29", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 13951, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぜろた", "screen_name": "zerota0", "avatar_url": "https://pbs.twimg.com/profile_images/1782606054695841792/jrTjGfYR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/267059660/1686055341/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 161}, {"id": 1153167, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "にろり🍣Skeb受付中", "screen_name": "tatutaage_uma", "avatar_url": "https://pbs.twimg.com/profile_images/2022501259027316737/g-9TZwJQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/240720353/1761916898/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 184}, {"id": 1532395, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ねこ山椒", "screen_name": "nekoneko_sansho", "avatar_url": "https://pbs.twimg.com/profile_images/1381649636574683136/aGpacvTV.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1298962168973414400/1618246038/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "t