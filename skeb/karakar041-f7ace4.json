ation": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6c04136/uploads/origins/1af20cc7-b675-45d9-8f0c-9095d04b58f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c62f8cc4e9b78e4cb22fba2d39379127", "srcset": "https://si.imgix.net/d6c04136/uploads/origins/1af20cc7-b675-45d9-8f0c-9095d04b58f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c62f8cc4e9b78e4cb22fba2d39379127, https://si.imgix.net/d6c04136/uploads/origins/1af20cc7-b675-45d9-8f0c-9095d04b58f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b8897926889a8bd2b59fc34ef4fd49cc 2x, https://si.imgix.net/d6c04136/uploads/origins/1af20cc7-b675-45d9-8f0c-9095d04b58f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=226a704e8e0e739b54aa32b7113bc1d0 3x"}, "body": "カラカロさん、はじめまして。\n\nX（Twitter）に投稿されていたロスモンティス（https://x.com/karakar041/status/1956730309187379665）やアーミヤ（https://x.com/karakar041/status/1949911021973639195）のイラストがとても素敵でリクエストさせていただきました。\n\nよろしければロスモンティスのオーケストラコーデ（https://orchestra.arknights-anime.jp/）をお願いできないでしょうか。\nコーデの情報が少ないため不明な部分はアレンジいただいて問題ございません。\nまた、コーデ以外の細かい指定はございません。\n納品形式はpsdだと嬉しいです。\n\nその他、以下の通りクライアントに紐付く各種SNS（X（Twitter）やMisskey、Mastodon等）で利用させていただく場合がございます。\n\n・アイコン\n・ヘッダー\n・スマートフォン等の壁紙\n・上記各種SNSへの作品投稿（紹介目的に限定しSkebのURLを必ず併記します）\n・その他Skebの利用規約やガイドラインで許可されていること\n\nご検討くださいますよう、お願いいたします。\n\n※参考：「アークナイツ」二次創作・ゲーム実況配信及び動画投稿に関するガイドライン\nhttps://arknights.jp/fankit/guidelines", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karakar041/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3708336, "client_id": 3106476, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72997d1b/uploads/origins/8a0f1217-619e-48d4-9eaa-1760a6b2803c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86b5d30c58fa0970091a82bbc57225f2", "srcset": "https://si.imgix.net/72997d1b/uploads/origins/8a0f1217-619e-48d4-9eaa-1760a6b2803c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86b5d30c58fa0970091a82bbc57225f2, https://si.imgix.net/72997d1b/uploads/origins/8a0f1217-619e-48d4-9eaa-1760a6b2803c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a4a918ab4db20fed091df27a285375b 2x, https://si.imgix.net/72997d1b/uploads/origins/8a0f1217-619e-48d4-9eaa-1760a6b2803c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=592e3f316e179762d8cf6ddeb97240ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72997d1b/uploads/origins/8a0f1217-619e-48d4-9eaa-1760a6b2803c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24e908e0482bd3558e3c755bf59b4252", "srcset": "https://si.imgix.net/72997d1b/uploads/origins/8a0f1217-619e-48d4-9eaa-1760a6b2803c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24e908e0482bd3558e3c755bf59b4252, https://si.imgix.net/72997d1b/uploads/origins/8a0f1217-619e-48d4-9eaa-1760a6b2803c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8110976090a9eb6d50816ead8658ff77 2x, https://si.imgix.net/72997d1b/uploads/origins/8a0f1217-619e-48d4-9eaa-1760a6b2803c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16cec63f4e7b8974827442dc7aa038d3 3x"}, "body": "カラカロ先生、こんにちは。\nXで偶然先生の作品を拝見し、その圧倒的な構図とダイナミックな表現力に魅了されました。\nぜひ、先生のスタイルで私のオリジナルキャラクターを描いていただきたく、今回ご依頼させていただきます。\n\n私のOCの名前は「nekozri」で、新しい衣装は「機械女王」をテーマにしています。\n\nキャラクターの設定や背景については、こちらをご参照ください：\nhttps://skeb.jp/@mytea_soso/works/142\n\n● 背景と性格\n彼女は「オズの大魔女」と深い関係を持ち、契約によって強大な魔力を得た魔女です。\n氷魔法と近接戦闘に秀でており、太刀やロングソードといった武器を氷の力で強化・創造することができます。\nまた、変身魔法で青灰色のメインクーンの姿になることも可能ですが、その姿は主にオズ国にいるとき、武器研究中に限られています。\n\n見た目には猫らしさはあまりありませんが、性格はまさに猫そのもの。気まぐれで好奇心旺盛、未知なるものに強く惹かれ、たとえ危険でも臆せず飛び込むタイプです。\n\n彼女の身体には「S.I.N.」と「D.E.V.」という自我を持つ二つの機械装甲が存在します。\nS.I.N.は機動性を高め、触手の先端から氷魔法のビームや氷弾を放つなど遠距離攻撃を得意とします。\nD.E.V.は機械と魔法の融合体で、氷の爪やスパイクを装甲に生成できる他、氷晶を用いて形状や装飾を変えることも可能です。\n\n彼女は冷酷さと魅惑の二面性を併せ持つ存在です。\n氷のように冷たく鋭い外見の裏に、官能的な魅力で相手を翻弄し、支配することに快感を覚える一面も秘めています。\n\n背景や構図はすべて先生にお任せいたします。\n大胆で動きのあるポーズで、彼女の高貴さ、カッコよさ、そしてセクシーさを存分に描いていただけると嬉しいです。\n先生の素晴らしい作品を楽しみにしております！\n\nもし金額が不足している場合は、再度依頼させていただきます。\n今回もご検討いただければ幸いです。どうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1_s0GBjVjLp-hol0sEiGIEzkL52meoRxU?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 364822, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "絶品", "screen_name": "kancan310", "avatar_url": "https://pbs.twimg.com/profile_images/2080297646020055040/NtQRvwyZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1819660400453165056/1722676138/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 75, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 1031397, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "暁サトル", "screen_name": "subtle_dawn", "avatar_url": "https://pbs.twimg.com/profile_images/1882781496647573504/zRtKU2SO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/860811332483899392/1785332149/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id": 2621348, "creator": true, "nsfw_acceptable": false, "acceptable"