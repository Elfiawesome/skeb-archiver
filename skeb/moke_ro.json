c4e94/uploads/origins/f98c15e8-10e9-46f4-bf0e-13194999e2c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9746c0b82e261cc0ec60cb8c1c8df07", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4dfc4e94/uploads/origins/f98c15e8-10e9-46f4-bf0e-13194999e2c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf009da1c20fe83257d1f6d2c791cc8d", "src_set": ""}, "body": "艦娘MSをリクエストさせて頂きます\n\nキャラ：海風改二(艦これ)\nMS :リ・ガズィ・カスタム\n好きなキャラと好きなMSの組み合わせが見たいので選びました。\nMSはパワードスーツの様に装着してる感じにしてください。\nパイロットスーツは、水色をベースにしたレオタードタイプで乳首がスーツ越しに判る様にしてください。\n可能であれば、全裸の上にパイロットスーツとMSパーツをレイヤー分けで描いてください。上半身だけMS形体や下半身だけMS形態等、着せ替えを行って遊びたいためです。\n一応、NSFWは有効にしておきます\n\n検討方よろしくお願いします。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moke_ro/works/41", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 721111, "client_id": 1012968, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e7d1436/uploads/origins/374e05d7-12e4-432d-8a2c-37179335b393?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=414a4a48c430dc87c5361be9483e820a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e7d1436/uploads/origins/374e05d7-12e4-432d-8a2c-37179335b393?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e3a7ca84bbbb5c2ec044e2a17bc0ad2", "src_set": ""}, "body": "こんにちは。\n\n今回もバニー衣装を着せてほしいというリクになります。\n\nPCゲーム「千の刃濤、桃花染の皇姫」\n翡翠帝(鴇田奏海)\n\nバニー衣装は松風で描いておられるエメラルドグリーンの和風バニーでお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moke_ro/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 721111, "client_id": 3443029, "vtt_url": null,