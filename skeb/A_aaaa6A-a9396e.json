0&h=200&s=4ba305a708ef9982f73404a8dc67ad89, https://si.imgix.net/439515bd/uploads/origins/2c48d7bc-7a35-40fc-9c90-8e9146e46295?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da0d8be5eac7aeb775203c109d0c8214 2x, https://si.imgix.net/439515bd/uploads/origins/2c48d7bc-7a35-40fc-9c90-8e9146e46295?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a843f1692c6194a045f413020dba058d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/439515bd/uploads/origins/2c48d7bc-7a35-40fc-9c90-8e9146e46295?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b5cc34b76d56e1e1b002b362e4db386", "srcset": "https://si.imgix.net/439515bd/uploads/origins/2c48d7bc-7a35-40fc-9c90-8e9146e46295?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b5cc34b76d56e1e1b002b362e4db386, https://si.imgix.net/439515bd/uploads/origins/2c48d7bc-7a35-40fc-9c90-8e9146e46295?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ef24ed67696426e51b2d091921f7eaf5 2x, https://si.imgix.net/439515bd/uploads/origins/2c48d7bc-7a35-40fc-9c90-8e9146e46295?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8f635d9222c01ddab3bb8406eeb898b5 3x"}, "body": "うわああさんこんにちは！\n貴方様の描く絵の質感やデフォルメの仕方、作風が本当に大好きでいつも楽しく拝見させていただいております！\n\n今回は私の創作を元にイラストを描いていただきたくリクエストさせていただきました。\n・キキ\n金髪にウルフカット/瞳はグレー〜紫で猫目/両耳に流星のピアス\n\n幼馴染で親友のライカと共に一緒に月の裏側で会う約束をしていたが、ライカが失踪してしまい寂しさを抱えながら彼女を探すために宇宙へ旅をしに行く決意をする高校生。柴犬のイオくんを飼っている。\n -モチーフ：流星/地図/ヘッドフォン/向日葵\n\n・ライカ\n水色のパッツンで前下がりのボブ/瞳は黄色寄りのオレンジでつり目\n\nキキの幼馴染で親友。天才的な頭脳の持ち主で、天文学者を目指している高校生。\nキキと共に誕生日を迎えたら月の裏側で待ち合わせるはずだったが、直前で「地球は赤かった！」という書き置きを残して失踪してしまった。\n -モチーフ：月食/天球儀/カメラ/ハルジオン\n\n【世界観】\nアポロ11号が月面着陸に成功してから60余年。宇宙開発技術が飛躍的に進歩した現代では、国際宇宙法に基づき特別な訓練や資格を有さずとも16歳を迎えれば誰でも簡単に月へ行くことが出来るようになった。今や日本でも、南極に行くよりは簡単なくらいには月面旅行が浸透しつつある。\n\n・イメージソング：アイラ/ストラトステラ/Sci-Fi ROMANCE TLAVELER/熱異常/DiSTANCE/秘密(はるまきごはん)/ハネムーン(LOLUET)\n\n・作品全体のキーワード：宇宙/ロケット/手紙/月/流星/祈り/待ちぼうけ/孤独/共鳴/天球儀/憧れ/希望/自然/天体観測/\n\n\n上記を基にしていただければ、キャラはどちらか片方でも構いません！服装なども好きに変えていただいて大丈夫です！\n今回はデフォルメでの募集とのことですので、あまり創作の世界観自体は気にしないでいただいて結構です。描きやすいように描いていただけたら嬉しいです！\n\n\n\nあらすじなどの文章\nhttps://privatter.me/page/6828a8b68f1e5\n\n画像等\nhttps://drive.google.com/drive/folders/1StcIUcp747KVpt0OZSEMVMnoeO5Wjwa_", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@A_aaaa6A/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2213498, "client_id": 1116701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cab333ac/uploads/origins/c8ba77d5-01b0-4d2d-a590-798b87f8304a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2585fe048766889ee352f3801d9ee3e", "srcset": "https://si.imgix.net/cab333ac/uploads/origins/c8ba77d5-01b0-4d2d-a590-798b87f8304a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2585fe048766889ee352f3801d9ee3e, https://si.imgix.net/cab333ac/uploads/origins/c8ba77d5-01b0-4d2d-a590-798b87f8304a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=534ba4d1fbc6e21eac2eaf0d26b611c6 2x, https://si.imgix.net/cab333ac/uploads/origins/c8ba77d5-01b0-4d2d-a590-798b87f8304a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=516c201ab5f20a6de35edcd4a77c09c9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cab333ac/uploads/origins/c8ba77d5-01b0-4d2d-a590-798b87f8304a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3302ee25b66214102b9265f128aee569", "srcset": "https://si.imgix.net/cab333ac/uploads/origins/c8ba77d5-01b0-4d2d-a590-798b87f8304a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3302ee25b66214102b9265f128aee569, https://si.imgix.net/cab333ac/uploads/origins/c8ba77d5-01b0-4d2d-a590-798b87f8304a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=71359da2cde2a298dba0fa923b7e4fe6 2x, https://si.imgix.net/cab333ac/uploads/origins/c8ba77d5-01b0-4d2d-a590-798b87f8304a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=98e917f1c4ad17c5e6e827eb99ee35d3 3x"}, "body": "こんにちは、うわああさん！前回の作品、本当に楽しませていただきました。\nまた私のオリジナルキャラクターを描いていただけませんか？\n\n世界設定：大気組成の急激な変化により人類が絶滅した、終末後の世界。それに続く幾つかの二次災害を経て、人類が残した唯一の遺産は、わずかなアンドロイドと機械だけとなった。\n\nそんな荒廃した世界で、本来のプログラムされた機能を忘れてしまったアンドロイドが、残されたすべての機械に祝福と赦しを与える、放浪する総主教と出会います。二人は同じ外見をしていますが、その事実に気づくことはできません。\n\nリクエストをお読みいただきありがとうございます。良い一日をお過ごしください。\n\nhttps://drive.google.com/drive/folders/1ywwxdD-SeZttrd-cDfAu_s4zcTZBAKbj", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@A_aaaa6A/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2213498, "client_id": 3084398, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70583bf6/uploads/origins/ebcd2a21-8976-4d8f-8b85-ef1e701ab396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2ca46ca936918e066c83e028009a0fa", "srcset": "https://si.imgix.net/70583bf6/uploads/origins/ebcd2a21-8976-4d8f-8b85-ef1e701ab396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2ca46ca936918e066c83e028009a0fa, https://si.imgix.net/70583bf6/uploads/origins/ebcd2a21-8976-4d8f-8b85-ef1e701ab396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ac429728b3ad582771d43977158bf2a 2x, https://si.imgix.net/70583bf6/uploads/origins/ebcd2a21-8976-4d8f-8b85-ef1e701ab396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f738b964c8db41a20817cf1e3c7ad958 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https: