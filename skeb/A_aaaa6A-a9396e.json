ss&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c8183c58b588513601b614f8ac71a8f, https://si.imgix.net/1105e848/uploads/origins/52a799eb-296f-413c-bc3e-888d2ec3aad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a66c26038a7e19ff46685974432fed8 2x, https://si.imgix.net/1105e848/uploads/origins/52a799eb-296f-413c-bc3e-888d2ec3aad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c9f3fe64e1133c5c516d6662fd9373b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1105e848/uploads/origins/52a799eb-296f-413c-bc3e-888d2ec3aad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb7b2f4e329a4183d31f30143b1688a4", "srcset": "https://si.imgix.net/1105e848/uploads/origins/52a799eb-296f-413c-bc3e-888d2ec3aad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb7b2f4e329a4183d31f30143b1688a4, https://si.imgix.net/1105e848/uploads/origins/52a799eb-296f-413c-bc3e-888d2ec3aad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e6df021d51fe9de7cead8e99d47ef57 2x, https://si.imgix.net/1105e848/uploads/origins/52a799eb-296f-413c-bc3e-888d2ec3aad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f7b7ba5148151c2f839dcd66013edb39 3x"}, "body": "うわああさんこんにちは、もしよければわたしのキャラクターを描いてもらえませんか? \n\n女性\n髪はサックスブルー、目はピンクです。大人っぽく安定感のあるタイプで、27歳です。身長は175センチです。\n彼女は狼人種であり、満月の夜になると制御が効かず、血に飢えた狼人に変身してしまいます。\n非常に強くで、協会では誰も手を出せない超難易度の依頼を受けることがあります。時には他の人やモンスターの血を浴びて協会に戻ることもあります。武器は大きい斧です。\n初対面の人には無愛想で慎重ですが、親しくなると意外と面倒見が良い一面も見せます。また、彼女はお酒を飲むのが大好きです。\n\n男性\n赤い髪に金色の目で、27歳です。身長は185センチです。\n彼はドラゴンと人間の混血であり、目は金色と黒色の異なる瞳を持っています。普段の姿は普通の人と変わりませんが、時折角やドラゴンの鱗を見せることがあります。基本的に弱気な表情を見せることはなく、たとえ死の危機に直面しても余裕を持った態度を崩さず、とても頑固です。\n彼の血液には、女性の嗜血症状を和らげる特別な効果があります。\n\n関係\n男性は女性の強さに興味を持って近づいてくることがあります。面白い理由もありますが、強い者同士が引き寄せ合うようなものでもあります。\n女性は男性がとても怪しいと感じていましたが、彼の血液の効果が非常に役立つため、一緒に行動することを了承しました。\n\nhttps://drive.google.com/drive/folders/1MkROMQIGNgUq0P5sPva8-Jy9XQPVv3bu?usp=share_link\n\nもし納品の中でラフなどを含んだPSD形式であれば嬉しいです。\nどうぞ自由にしてください。\nお忙しい中ご検討頂きありがとうございます。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@A_aaaa6A/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3bef106e/uploads/origins/d36b204a-51bc-4cd0-8f69-79db53298cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7eb588829c49ceca1c376db23fcd6422", "srcset": "https://si.imgix.net/3bef106e/uploads/origins/d36b204a-51bc-4cd0-8f69-79db53298cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7eb588829c49ceca1c376db23fcd6422, https://si.imgix.net/3bef106e/uploads/origins/d36b204a-51bc-4cd0-8f69-79db53298cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4c75401f92abc7748e8d2ea32569c7e 2x, https://si.imgix.net/3bef106e/uploads/origins/d36b204a-51bc-4cd0-8f69-79db53298cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=15a8b8848cf4a07b65d66cd3b4d87170 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2213498, "client_id": 2106379, "nc": 145}, {"path": "/@A_aaaa6A/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2213498, "client_id": 225174, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78f96897/uploads/origins/4228d70c-e845-4f50-89c8-f2505d8bb667?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f99d