uber!\n\nI'm a hamster girl who loves strawberries!\nI'm a cheerful hamster girl who loves strawberries!\nMy favorite things\n　Strawberries, sunflower seeds, cosmetics, cute things, sweet things, flowers\nUsage\n　We will use them in our activities (distribution, thumbnails, SNS, goods, distribution, etc.)\nWe would also like to receive data of only people with transparent backgrounds.\nIf there are items that are not allowed, we would appreciate it if you could put them on a separate layer.\n\nThank you very much!\n\nhttps://drive.google.com/file/d/1ZQiiWPAVaZbaIgqrv5UD6FAH9iVBoqRD/view?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amabierakuto/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 677021, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5595009c/uploads/origins/fcd6a462-1aab-4ff1-8bec-2842d6d761fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d80b6b92d1a04a30a07db672f102fc18", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5595009c/uploads/origins/fcd6a462-1aab-4ff1-8bec-2842d6d761fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92fb949b910d8805eb22a2d5d4e8c0b4", "src_set": ""}, "body": "Uro is leaning against a stuffed animal and looking at his phone.", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amabierakuto/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 677021, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4db303a4/uploads/origins/c0bea06e-6edc-401d-8a7c-8fc83a7f68c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=def0cd5f0f3862f5ff9304bf4f1a8ab4", "src