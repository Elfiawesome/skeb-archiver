ic": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 5, "received_works": [{"path": "/@amabierakuto/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 677021, "client_id": 2061160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2cb99f78/uploads/origins/fb3d684a-ef03-49e5-9b4e-b2c41ea09db9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4a526fdf5580418cac7c01a9491b15d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2cb99f78/uploads/origins/fb3d684a-ef03-49e5-9b4e-b2c41ea09db9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0ea9cecfa1e2db2cd8de91ccf87b01f", "src_set": ""}, "body": "初めまして！個人Vtuberの舞嶽ぽん子と申します。\n娘さんの狐さんといつも仲良くしていただいております。\n\n以前からみゆちゃんのイラストを拝見して、素敵だな～お願いしたいな～と思いつつ、\n3人でコラボしていた山葵つんちゃんのイラストも拝見して、さらに素敵だな～と思い、\nあまりタイミングがかぶると…！と思いタイミングを狙っていました。\n先日のみゆちゃんの4周年のイラストを拝見して、\nもう我慢ならん！という気持ちになったので、ぜひイラストをお願いしたいです。\n\n最近自力で新衣装とLive2Dを作ったのですが、\nこの衣装のイラストをお願いいたします。\n3面図などが無くて本当に申し訳ありません。。。\n構図表情はお任せさせていただきます。\n\nyoutube（収益化済）での配信サムネイル、ヘッダー、配信画面での表示、\nXなどのSNSでの告知など配信活動全般に使用させていただきたいと考えております。\n顔回りのパーツが切れていない透過データをいただけると嬉しいです。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1IoDrbcsjdwZ5V1C1KlfU73AHhRWAJqxR/view?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amabierakuto/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 677021, "client_id": 3644810, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4b66413/uploads/origins/273dede7-4be2-402d-b808-6a20a641f443?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b0d6b1200d8a655878db9dc005b7558", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4b66413/uploads/origins/273dede7-4be2-402d-b808-6a20a641f443?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47eb95b49745d5133e8176c9ce961b0a", "src_set": ""}, "body": "初めまして、小鳥遊春歌（たかなし はるか）と申します。普段、YouTubeで動画投稿を中心に活動している者です。\nSNSで、甘冷らくと様の素敵なイラストをお見かけし、ぜひともご依頼させていただけたらと思います。 \n\n今回、描いて頂きたいのは、私と私の肩に乗ってる鳥のまさおです。\n\n添付資料の「ケープの方の衣装」で描いていただきたいです。\nこちらのイラストはYouTubeのサムネイル等で使用させていただきます。\n頭や手の端が切れない範囲であれば、ポーズや構図はおまかせいたしますので、自由に描いていただけると嬉しいです。\nどうぞよろしくお願いいたします。\n\nhttps://lit.link/WvY17pHc9de0IJbWauvJVcDXr2m2", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amabierakuto/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 677021, "client_id": 2092702, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c6c10bd/uploads/origins/17dc185b-ca59-41c6-97cb-02a9b9813c48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5810405094c681ed6a0d1211b796eff1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c6c10bd/uploads/origins/17dc185b-ca59-41c6-97cb-02a9b9813c48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8d20d7e9d65419a697251a9622ac77e", "src_set": ""}, "body": "甘冷らくと🌸🍨様はじめまして！\n Vtuber・Vliverとして活動している怪盗アンサーと申します。 甘冷らくと🌸🍨様の絵柄がとても可愛く、ぜひ私のキャラクターを描いていただきたくリクエストを送らせていただきました。\n\n資料はURLをご確認ください。\n\n表情や細かい構図などおまかせいたしますので、自由に描いてください。\n元気でかわいい雰囲気だと嬉しいです。\n\n配信画面などに使いたいので、髪や手などが見切れてないと嬉しいです。\nまた、キャラクターのみの透過差分(もしくはPSD)をいただきたいです。\n\n 使用する可能性のある用途は下記になります↓\nYouTube・17Live・ツイキャス等の配信・動画サムネイル、Twitter等のSNSでの利用、アイコン、ヘッダー、壁紙、グッズ等\n\n内容が合わなければキャンセルしていただいて大丈夫です。\n お忙しいなか恐れ入りますが、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1wq1HsFeUVEwmClci4u89WCvbb6gjaDV-", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amabierakuto/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/79787bbf/uploads/origins/693836c3-5083-4474-ad79-05d28b9a3e83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bcee7a4b79a0d1785e1e1b254bdc1848", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 677021, "client_id": 3371729, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@amabierakuto/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 677021, "client_id": 2240974, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a018b86e/uploads/origins/3c71a359-7246-481e-89e8-e4304f56d566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afebe0fc283b2e0ebc6ac1ff062132af", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a018b86e/uploads/origins/3c71a359-7246-481e-89e8-e4304f56d566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c44d65a07f3b0e45689edf0a0f8ebcb5", "src_set": ""}, "body": "甘冷らくと先生こんにちは。\nSNSなどで先生の素敵なイラストいつも楽しく拝見しております。\nこの度は胡蝶つくもさんというVtuberの方のファンアートを描いていただきたく連絡いたしました次第です。\n\n【イラストのイメージ及び補足事項】\n・笑顔でいろいろな色の折り鶴に囲まれているような感じでおねがいします。\n・関節は球体関節となっております。\n\n【使用用途・お願いしたいこと】\n・胡蝶つくもさんにプレゼントとしてお渡しすること\n・胡蝶つくもさん本人が配信画面上に映したり配信のサムネイルとして用いること\n・胡蝶つくもさん本人がSNSへ投稿すること\n　以上のことをお願いしたいです。\n\nまた可能ならば人物のみの画像もいただけると幸いです。\n\n【参考資料】\n・全身図が掲載されている胡蝶つくもさんの所属事務所のホームページのURL\nhttps://meta-w.jp/liver/liver.php?page_id=4\n・初配信のURL（開始1時間あたりのところから細部のアップや全身が確認できます）\nhttps://www.youtube.com/live/iBSnDiL0_hQ?si=UFwtpncZt6lODI_u\n・胡蝶つくもさんのXアカウント\nhttps://x.com/KochoTsukumo\n\nご多忙のところ申し訳ございませんがどうかご検討のほどよろしくお願いいたします。\n\nhttps://meta-w.jp/liver/liver.php?page_id=4", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amabierakuto/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 677021, "client_id": 3369503, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/972c0dd0/uploads/origins/bba7205b-fc6c-452d-8d27-5d520050fb2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebf29bbfcc93698049c639d860b1826b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/972c0dd0/uploads/origins/bba7205b-fc6c-452d-8d27-5d520050fb2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30d050be38634fa35471ffcb5afcca5f", "src_set": ""}, "body": "甘冷らくと 様\n\n初めましてYouTubeを中心に活動しております、ゆめちと申します。\n Xでイラストをお見かけして、宝石のような瞳の表現と女の子のキラキラ可愛い雰囲気に惹かれて、この度リクエストを送らせて頂きました！  \n\n==========\nらくと様おまかせでゆめちのイラストを描いていただきたいです！三面図画像を添付しますので参考にしていただけますと幸いです。\n  用途としては、\n・Xでの使用（おはようポスト、宣伝等）\n・YouTubeでの使用(サムネイル等)\n※もし描いていただけた場合にはYouTubeの配信で、ご紹介をする可能性があります。\nご了承ください！\n\n甘冷らくと様の思うがまま、好きな様に描いて頂けたら嬉しいです♡\n 特徴としては、タレ目つり眉、ふわふわ癖っ毛のみつあみ、八重歯、です！リスナーさんからは元気で明るくてちょっと不憫なところをよく褒めていただきます。\n\nskebでのリクエスト依頼が不慣れなもので、至らぬ点がございましたら誠に申し訳ございません。\nご検討の程よろしくお願いいたします！\n\n==========\n\nhttps://drive.google.com/drive/folders/1PXJhN0xPLf1-vuTJUxRwBkv4LyMlCcPW", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amabierakuto/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 677021, "client_id": 1207446, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7fcef4f/uploads/origins/5b0a7b9e-940a-441f-ab3f-c771b94643d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0f6d21dd017b5a48076a514d2e451ea", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7fcef4f/uploads/origins/5b0a7b9e-940a-441f-ab3f-c771b94643d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=762e52fb9c0160426ba0c84e799e24fd", "src_set": ""}, "body": "本当に良いのだろうか、、と言う気持ちですがXのポストを見てリクエストさせて頂きます。\n個人Vtuberの山葵つんと申します。\nみゆちゃんと仲良くさせていただいており、らくとさんのキラキラで可愛いイラストも拝見しています。\n\n【依頼内容】\n私を描いていただきたいです。\n資料にある衣装で、髪形や衣装の袖の有り無しは描きやすいもので描いていただきたいです。\n構図もお任せでお願いします。\n\n【使用用途】\n収益化済のyoutubeのサムネイルやヘッダーなど配信活動や配信告知に使用させていただきたいです。\nまた、顔周りのパーツが見切れておらず、背景透過のデータを頂けたら嬉しいです。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1MHVQtAC2U3MTUVwSOdOH_12iqOxkXhC8?usp=sharing\n\nhttps://drive.google.com/drive/folders/1MHVQtAC2U3MTUVwSOdOH_12iqOxkXhC8?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amabierakuto/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 677021, "client_id": 1861295, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42d2c981/uploads/origins/a62883ca-4da1-4479-859e-603d711810dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c209c050def5181a52544e4632e2e40", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42d2c981/uploads/origins/a62883ca-4da1-4479-859e-603d711810dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f64780ae01daa5b334a96117172c764", "src_set": ""}, "body": "I want Mumu-chan to have an adult-like atmosphere.\nThe image is that of a mature, cool, older woman.\nThe main color should be blue.\nI want her to wear a military uniform and a skirt.\nI would appreciate it if you could make her dress in a cool and cute way.\nI would like her to wear her hair waist length and have a mature look. I will leave the hairstyle up to you.", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amabierakuto/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 677021, "client_id": 2115511, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4858e739/uploads/origins/8adb52a5-0cde-44e0-89d8-b0442f46d8b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=513dfeb159f6fa14907311111c5b77aa", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4858e739/uploads/origins/8adb52a5-0cde-44e0-89d8-b0442f46d8b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79f542916cbc677598a7e8b8a06bdd8d", "src_set": ""}, "body": "Thank you so much for all your hard work last time! It was beautiful!\n\nI would like to have a character drawn in a pose like the one in the reference. Also, could you please make it full bodied?\n\nThank you very much!\n\nhttps://imgur.com/a/KhxGgsT", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amabierakuto/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 677021, "client_id": 388610, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21210a6d/uploads/origins/fd742dc7-118b-4881-95b1-0886ca70f04a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbfeefe6b28cc16bba689455155f4f60", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21210a6d/uploads/origins/fd742dc7-118b-4881-95b1-0886ca70f04a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=123abb910b17cbd7b09247cfcb5cbbd2", "src_set": ""}, "body": "T