fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d9de953b669d5f6eba916a883b791ec", "srcset": "https://si.imgix.net/3fca9c37/uploads/origins/848276e5-65e0-4927-9905-c3e43e5cacc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d9de953b669d5f6eba916a883b791ec, https://si.imgix.net/3fca9c37/uploads/origins/848276e5-65e0-4927-9905-c3e43e5cacc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e85b2a58266c14052f0a8ab428b96399 2x, https://si.imgix.net/3fca9c37/uploads/origins/848276e5-65e0-4927-9905-c3e43e5cacc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2688affcc9889b8c0c8536d49d043cfe 3x"}, "body": "はじめまして、こいわい様　新着クリエイターでお見掛けしましてお声をかけさせていただきました。\nうちの子のイラストを依頼したくご連絡させていただきました。\n\nうちの子は三神ヨキというVRCHATアバターの色改変（青色基調）したものです。\nとても気に入っていて、いつもこの姿になっています。\n\nVrchatにて主に使っているアバターです。\nこいわい様のTwitterを拝見させていただきまして、できればうちの子をこいわい様の画風で描いていただけるとうれしいです。\n\n服装等については変えていただいたりしていただいて構いませんし構図やポーズにつきましてもおまかせいたします。\n\n主な使用用途は、ツイッター等でヘッダーにしたりアイコンにしたり、眺めてニヨニヨするつもりです。\n\n色の参考についてはツイッターのツイート\nhttps://twitter.com/kashiwagi_miyu/status/1645552923781533697?s=20\nhttps://twitter.com/kashiwagi_miyu/status/1611360355841867779?s=20\n\nこちらを参考にしていただけると助かります。\n\n資料URLにはアバター改変元を入れさせていただきました。\nよろしくお願いします。\n\nhttps://booth.pm/ja/items/1558097", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@koiwai0325/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2788213, "client_id": 2342069, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84d04815/uploads/origins/11e33f37-5d31-46c7-8ca5-0543010718b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=464fe7dad03201236cf874bb9b97baeb", "srcset": "https://si.imgix.net/84d04815/uploads/origins/11e33f37-5d31-46c7-8ca5-0543010718b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=464fe7dad03201236cf874bb9b97baeb, https://si.imgix.net/84d04815/uploads/origins/11e33f37-5d31-46c7-8ca5-0543010718b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dacac9a5f7f66b58399d518eb5cfc499 2x, https://si.imgix.net/84d04815/uploads/origins/11e33f37-5d31-46c7-8ca5-0543010718b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2d9f864b88ad4a50d6720b7bba0f148 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84d04815/uploads/origins/11e33f37-5d31-46c7-8ca5-0543010718b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24502277c479acf002a53074b6cf6086", "srcset": "https://si.imgix.net/84d04815/uploads/origins/11e33f37-5d31-46c7-8ca5-0543010718b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24502277c479acf002a53074b6cf6086, https://si.imgix.net/84d04815/uploads/origins/11e33f37-5d31-46c7-8ca5-0543010718b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=86c951f56fe84dbf271d1430878b58c6 2x, https://si.imgix.net/84d04815/uploads/origins/11e33f37-5d31-46c7-8ca5-0543010718b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=945ac5d89b334247a33fb95a13751fd1 3x"}, "body": "こいわい様、はじめまして。Vtuberとして活動しております月ノ瀬ききとと申します。\n\nこいわい様のイラストをTwitterにて拝見し、ご連絡いたしました。\nぜひわたくし自身をこいわい様に描いていただきたく依頼させていただきます。\n\n\n依頼内容…\n\n私、月ノ瀬ききとのイラスト（最後に参考資料がございます。）\n構図やポーズはお任せでお願いします！\n個人的にこいわい様のアイコンのような透明感のあるイラスト（色素が薄め？）がすっっっごく可愛くて好みです！私自身、白を基調とした（？）イラストが少なくこいわい様のアイコンのような雰囲気だと嬉しいです…！\n\n服装や髪型はお任せでお願いしたく存じます…！（髪型について、アレンジしていただいて構いません！ボブやロング等も可能です！）\n\n\n\n使用用途…\nTwitterでの掲載・配信サイトでのサムネイル、待機画面を予定しております。\n（最近はasmrや雑談、食べ物レポが多いです）\n\n\n納品について…\n可能であれば、サムネイルでも使いやすいように、人物のみの背景透過版もpsdデータのレイヤーとしていただけると嬉しいです…！（pngでも可）\n\n頭が切れてしまっていたり腕や髪の毛も切れていないと非常に助かります…！（サムネ作成上）\nもしそういうのは受け付けてない！とのことでしたらスルーしてくださいませ\n\n\nイメージ・参考資料…\n\n月ノ瀬ききと→歌・ゲーム・ダンスが好き。声は低めでお姉さん声を出すことができます。胸が大きいのとオッドアイがチャームポイントです。イメージカラーは水色・青です。\n\nhttps://twitter.com/kiki_shu_kiki/status/1555391377864699905?s=46&t=p4E7Ot9o2zNZl20dTcbx_A\n\n\nご多忙とは存じますが、ご検討していただけますと幸いでございます。\n（skeb依頼に関して不慣れでして、ご気分を害されましたら大変申し訳ありません）\n\n月ノ瀬ききと", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1125553, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "にんじん@依頼受付中", "screen_name": "nin_11", "avatar_url": "https://pbs.twimg.com/profile_images/2034995099164450820/Rcb-qYuN.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 1638989, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "unimaru", "screen_name": "uni_maru231", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:xnresyzuddmttgfw4kwk7s77/bafkreih4zsidgh52ywabsbd2rfbitc6lfpxxkxyx6n3gfeqjoz2ragdo3y", "header_url": "https://cdn.bsky.app/img/banner/plain/did:plc:xnresyzuddmttgfw4kwk7s77/bafkreibswgt4aswt5yeethqx4srxobixisi2zcwzr4qj2zaqxhfbhdslpm", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 2620286, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "いかわさ🦑(チゲ味)", "screen_name": "Midori_annte23", "avatar_url": "https://pbs.twimg.com/profile_images/1772462509385269248/3WO5dS3i.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1288136668696809473/1711452276/1500x500", "appeal_receivable": true, "popular_creator_rank": nul