リスマス\n・秋、冬\nのいずれかでこいわい様の描きやすいものでお願いします！\n\n服と髪型はデフォルト以外（ロングやショートアレンジしていただいて大丈夫です！）で、こいわい様にお任せいたします！\nポーズ構図もお任せします！\n\n【用途】\nTwitterへの掲載、YouTube動画配信での使用（サムネやshorts等）、（もしかしたら）ネットプリント\n商用利用はございません。\n\n【納品形式】\nサムネイルに使えるよう、人物と背景（ある場合のみ）を別にいただけると嬉しく思います…！\n\nお忙しいとは存じますが、もしよろしければご検討のほどよろしくおねがいいたします。\n\nつきのせききと参考↓\n\nhttps://twitter.com/kiki_shu_kiki/status/1555391377864699905?s=46&t=p4E7Ot9o2zNZl20dTcbx_A\n\n\nつきのせききと", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@koiwai0325/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2788213, "client_id": 2737614, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f5beb61/uploads/origins/699560e3-65d3-4bcf-b2e3-964f7a55fa7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c35671ca9cee82a61da54590e797e1ef", "srcset": "https://si.imgix.net/4f5beb61/uploads/origins/699560e3-65d3-4bcf-b2e3-964f7a55fa7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c35671ca9cee82a61da54590e797e1ef, https://si.imgix.net/4f5beb61/uploads/origins/699560e3-65d3-4bcf-b2e3-964f7a55fa7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e0311561e110d1c5ffb73a8d7e93d0a 2x, https://si.imgix.net/4f5beb61/uploads/origins/699560e3-65d3-4bcf-b2e3-964f7a55fa7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c565b2570489b4a45aeeeae4c747e506 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f5beb61/uploads/origins/699560e3-65d3-4bcf-b2e3-964f7a55fa7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8a387f77a03214931ac37c5a44ff276", "srcset": "https://si.imgix.net/4f5beb61/uploads/origins/699560e3-65d3-4bcf-b2e3-964f7a55fa7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8a387f77a032