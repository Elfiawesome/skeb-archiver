喜びや笑顔といった感情が世界樹のエネルギーの源になるため\n世界樹のエネルギーを蓄えるため、配信活動をしています。\n\n以下ムービーイメージです。\nリスナー様へおまじないを送るイメージムービーをお願いします。\n両手をひろげて画面左から画面右へ無邪気にくるっと回るようなイメージ\n回る瞬間胸に下げている水時計が光ります。\n\nデザインにつきましては、下記URLの資料画像にてご確認ください。\n\n\n【使用用途】\n配信上でリスナー様からなにかを頂いた際にカットインで使用したいです。\nVTuber活動全般。\nYouTube、Twitch、SHOWROOMの配信等で使用するムービー・Twitter各種SNS・FANBOX等での使用\n\nなにとぞご検討のほど何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Hs6EfoPl-3FdD6Dpinb1uNyLEP0GNiP9?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@reizoukoyakko/works/133", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 543504, "client_id": 2917303, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54654f3f/uploads/outputs/fb0fcbcb-0d8f-42c4-b958-64db0e5cd68e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=aa860c6a938dd7fdf229b59e16687e33", "srcset": "https://si.imgix.net/54654f3f/uploads/outputs/fb0fcbcb-0d8f-42c4-b958-64db0e5cd68e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=aa860c6a938dd7fdf229b59e16687e33, https://si.imgix.net/54654f3f/uploads/outputs/fb0fcbcb-0d8f-42c4-b958-64db0e5cd68e?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f82af4a850b7fec3c409f0aabb7573e 2x, https://si.imgix.net/54654f3f/uploads/outputs/fb0fcbcb-0d8f-42c4-b958-64db0e5cd68e?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6a81a6d100eff279227dda2c415c713 3x"}, "duration": 2, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54654f3f/uploads/outputs/fb0fcbcb-0d8f-42c4-b958-64db0e5cd68e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=f1edaefe7cc6babe721e6c34230df998", "srcset": "https://si.imgix.net/54654f3f/uploads/outputs/fb0fcbcb-0d8f-42c4-b958-64db0e5cd68e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=f1edaefe7cc6babe721e6c34230df998, https: