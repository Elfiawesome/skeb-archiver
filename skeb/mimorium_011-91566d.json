lit.link/mimorium011#\n\n暑い日が続きますがご無理なさらずお過ごしくださいませ。\nご縁がありますように。よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@asayumehajime/works/122", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 2120867, "client_id": 2917303, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/149ce0a5/uploads/outputs/f192bcd9-8254-4622-82cb-d06634bfa1b8?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=d0a7601c3620e488a0cc7f18e964fd7e", "srcset": "https://si.imgix.net/149ce0a5/uploads/outputs/f192bcd9-8254-4622-82cb-d06634bfa1b8?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=d0a7601c3620e488a0cc7f18e964fd7e, https://si.imgix.net/149ce0a5/uploads/outputs/f192bcd9-8254-4622-82cb-d06634bfa1b8?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=64df7cc52ebf78a3b849351dfbc377d6 2x, https://si.imgix.net/149ce0a5/uploads/outputs/f192bcd9-8254-4622-82cb-d06634bfa1b8?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=93ec21a5cf5bff09763a9263c04a3caa 3x"}, "duration": 24, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/149ce0a5/uploads/outputs/f192bcd9-8254-4622-82cb-d06634bfa1b8?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=206c57c829220f94a00170b8a0434821", "srcset": "https://si.imgix.net/149ce0a5/uploads/outputs/f192bcd9-8254-4622-82cb-d06634bfa1b8?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=206c57c829220f94a00170b8a0434821, https://si.imgix.net/149ce0a5/uploads/outputs/f192bcd9-8254-4622-82cb-d06634bfa1b8?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=68fa6bf1ba3f2ef726a2ed7ebc274f4e 2x, https://si.imgix.net/149ce0a5/uploads/outputs/f192bcd9-8254-4622-82cb-d06634bfa1b8?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2341883db0fc56ec76ea4c741a933c2e 3x"}, "body": "朝夢はじめ様\n\n初めまして、かねてよりあなた様の投稿されるドット絵作品のクオリティに惹かれ、\n是非ご依頼させていただきたく機会を伺っておりました。\nVTuber活動をさせていただいております、翠みもりと申します。\n\n私は世界樹のふもとにある妖精の国から配信活動をしています。\n私たちにとっての大切な存在である世界樹がパワーを失っているので\n人間界からパワーを分けて貰うため配信活動を始めました。\nかねてより人間界のカルチャーにも興味があるため\n人間界にあるレトロな雑貨やゲームを集めることが大好きな妖精です。\n\n【依頼内容】\n私、翠みもりの配信待機中のループ動画をお願いしたいと思っています。\n\n場面は自分のお部屋で、\n朝ベッドから起きて眠そうにゆっくりクローゼットに向かって行き\n(移動は歩きでも羽移動でもokです)\n正装にくるっと着替えて配信スペースに向かう、といったものです。\nお部屋は横スクロールのような平面図で下記のような並びで\n配信スペース←クロゼット←ベッド\nといった順番でイメージしています。\n\n・家は木の中に居住空間をつくって住んでいます。\n・クロゼットには私のお気に入りのお洋服が何着か並んでいます。ほかの人が見ると全部おなじ服にみえるらしいですが･･･\n・配信スペースは人間界とをつなぐ魔法の泉(木の割れ目にある鏡のような泉)を使って配信していますが、PCデスクでもOKです。\n\n【使用用途】\nYouTube、twitch、SHOWROOM配信の待機画面\n\n【三面図】\nhttps://drive.google.com/file/d/1yzoE0Y6c73e97nlD_NxtlhQO3o-YPkRm/view?usp=sharing\n【立ち絵】\nhttps://drive.google.com/file/d/13P8bM85NEh0gXB46COZJDrfx9bzih1AT/view?usp=sharing\n\nお忙しい中恐縮ではございますがご検討のほどよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 115915, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "唯ノイロ", "screen_name": "_nnwnoiros", "avatar_url": "https://pbs.twimg.com/profile_images/1821085221355450368/dCavEu4L.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2594782885/1654934758/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 49}, {"id": 527624, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "けもみん之助", "screen_name": "simanokoB", "avatar_url": "https://pbs.twimg.com/profile_images/1280684987071688704/pQbeV3as.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1037190349373038593/1749528851/1500x500", "appeal_receivable": false, "popular_creator_rank": 4, "request_