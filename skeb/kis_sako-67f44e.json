490e-957b-4946315df1fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d851606e35dd65b57d48fca259b2e30", "srcset": "https://si.imgix.net/59460c58/uploads/origins/17c66516-555c-490e-957b-4946315df1fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d851606e35dd65b57d48fca259b2e30, https://si.imgix.net/59460c58/uploads/origins/17c66516-555c-490e-957b-4946315df1fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bb6a4e6aa61bcff3620c623e6258fb89 2x, https://si.imgix.net/59460c58/uploads/origins/17c66516-555c-490e-957b-4946315df1fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=74b8c6e464591066737876d1213ee301 3x"}, "body": "キッサコさん初めまして。\nX名でMoleと活動しているものです。\nキッサコさんの頼るとBADENDに行く自称探偵の子に凄く惹かれ是非うちの子にもその様な雰囲気を持った立ち絵をキッサコさんに描いて欲しいと思い、リクエストをお送り致しました。\n描いて欲しい様なイメージ\n・黒手袋を付けていてベルト付きの帽子を被っている\n・全体的に薄ら暗いけど微笑んでる様な雰囲気を放っている\n・仕込み杖を常備しており杖を片手で付いている\n・ブレザー型の少し古い学生服に白いシャツに赤いマフラーを付けてネクタイがその下から見えている\n・長い紐ブーツを履いており黒色である\n以上がイメージで残りはキッサコさんのBADENDに行く自称探偵の子の様な風にうちの子を仕上げて貰えると幸いです。またこれいいなと思ったものがあれば盛り込んで貰えるのも嬉しいです。\n\n使用用途:TRPGの立ち絵キャラ絵、Xでのキャラ紹介絵\n形式:PSDで白背景を透過出来る様になっていると嬉しいです。\n\n長々と文を書き連ねましたが一度ご検討の方をしていただけないでしょうか。\n宜しくお願い致します。\n\nhttps://drive.google.com/file/d/1N_e4VgLMhdIwNROc0mxIBUgQMQBLObyU/view?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kis_sako/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 138742, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e71599e/uploads/origins/3f7a0b1b-721f-4525-8e34-2d7b2694023e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54f90b4fea44025393dac160d335bde4", "srcset": "https://si.imgix.net/5e71599e/uploads/origins/3f7a0b1b-721f-4525-8e34-2d7b2694023e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54f90b4fea44025393dac160d335bde4, https://si.imgix.net/5e71599e/uploads/origins/3f7a0b1b-721f-4525-8e34-2d7b2694023e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b4d35f799a3b6048b4a770970018e68 2x, https://si.imgix.net/5e71599e/uploads/origins/3f7a0b1b-721f-4525-8e34-2d7b2694023e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=843cbe17501c227dfb925633ca32a6fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e71599e/uploads/origins/3f7a0b1b-721f-4525-8e34-2d7b2694023e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2976e29f7ba43e9976d015a6e6cd146", "srcset": "https://si.imgix.net/5e71599e/uploads/origins/3f7a0b1b-721f-4525-8e34-2d7b2694023e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2976e29f7ba43e9976d015a6e6cd146, https://si.imgix.net/5e71599e/uploads/origins/3f7a0b1b-721f-4525-8e34-2d7b2694023e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=57718918bb95e6ddf79acf32672e6e70 2x, https://si.imgix.net/5e71599e/uploads/origins/3f7a0b1b-721f-4525-8e34-2d7b2694023e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa005f63fe19153655de586a49935c23 3x"}, "body": "はじめまして。\nアークナイツのスペクターをお願いします。\n前衛の修道服コーデで、サメ精神が表れた力強く得意気な笑顔を見たいです。\n\n表情は過去に描かれていました下記作品が近いと思います。\nhttps://misskey.io/notes/9jfvp9cj9d\n\n同じキャラだとこちらも参考になるかもしれません。\nhttps://twitter.com/payopayo326a/status/1614937512992182272\n\n構図やポーズなどの指定はありませんので、自由に描いていただければと思います。\nご検討のほどよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kis_sako/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 138742, "client_id": 2170899, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92d94b38/uploads/origins/4072ba4d-8cbd-435b-a3f6-08be2ea2d6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ead7e0f863edc5f0cdcbf96a0d80396", "srcset": "https://si.imgix.net/92d94b38/uploads/origins/4072ba4d-8cbd-435b-a3f6-08be2ea2d6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ead7e0f863edc5f0cdcbf96a0d80396, https://si.imgix.net/92d94b38/uploads/origins/4072ba4d-8cbd-435b-a3f6-08be2ea2d6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9946e2c3f581d06dc16e8b9357825e6 2x, https://si.imgix.net/92d94b38/uploads/origins/4072ba4d-8cbd-435b-a3f6-08be2ea2d6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=416b0cf632f44de385138a0b58c242d5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92d94b38/uploads/origins/4072ba4d-8cbd-435b-a3f6-08be2ea2d6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42b29e3dc94fb4b55ddee1787b08fbab", "srcset": "https://si.imgix.net/92d94b38/uploads/origins/4072ba4d-8cbd-435b-a3f6-08be2ea2d6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42b29e3dc94fb4b55ddee1787b08fbab, https://si.imgix.net/92d94b38/uploads/origins/4072ba4d-8cbd-435b-a3f6-08be2ea2d6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62380dfa198980c941d61b1b10e10cdf 2x, https://si.imgix.net/92d94b38/uploads/origins/4072ba4d-8cbd-435b-a3f6-08be2ea2d6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=514c9a38dbde5887c161d32542c2fd07 3x"}, "body": "再びこんにちは！\n私のVtuberキャラクター、Ajayのアートワークを依頼したいです。\n\nAjayの参考：https://imgur.com/a/1bNaKsU\n\n彼の目が青く光って、ニヤニヤしているところを描いてください。\n\nこの剣もアートに入れてほしい。https://imgur.com/a/Rj7VmEs\n\n自分の剣とこの剣の両方を持って、このポーズでやっているところを描いてください：https://imgur.com/a/DygsFs5\n\n\nまた、このナイフもいくつかアートに入れてほしい。https://imgur.com/a/W3DOEtt\nこの写真のように、ナイフが彼の周りに浮いているように描いてください: https://imgur.com/a/5OOm89R\n\nまた、ジャケットのフードをかぶってマスクをかぶり、マスクの目も青く光るような別バージョンのアートもお願いします。\n\n青をテーマにした背景を作ってください。\n\nありがとうございました！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kis_sako/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 138742, "client_id": 192797, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7334109a/uploads/origins/6593ac5b-a1f8-429c-8457-b13e4097759b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43e9c6e61067ffc3bc474318c60487e5", "srcset": "https://si.imgix.net/7334109a/uploads/origins/6593ac5b-a1f8-429c-8457-b13e4097759b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43e9c6e61067ffc3bc474318c60487e5, https://si.imgix.net/7334109a/uploads/origins/6593ac5b-a1f8-429c-8457-b13e4097759b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7e3f640ceba11de5665c3f0bee87538 2x, https://si.imgix.net/7334109a/uploads/origins/6593ac5b-a1f8-429c-8457-b13e4097759b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e068dfa3a9f4ed42dcfe6f16e387144 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7334109a/uploads/origins/6593ac5b-a1f8-429c-8457-b13e4097759b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9ccb8146d99831567767c0fac2499a7", "srcset": "https://si.imgix.net/7334109a/uploads/origins/6593ac5b-a1f8-429c-8457-b13e4097759b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9ccb8146d99831567767c0fac2499a7, https://si.imgix.net/7334109a/uploads/origins/6593ac5b-a1f8-429c-8457-b13e4097759b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5faa377fec382809e0eb7f0dd5d2e544 2x, https://si.imgix.net/7334109a/uploads/origins/6593ac5b-a1f8-429c-8457-b13e4097759b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8e3b20e1042dc11d5b8974e31274e545 3x"}, "body": "はじめまして、きさこさん！バトルシーンに出てきそうな素敵な作品を拝見して以来、ぜひお願いしたいと思っていました！今回お願いしたいキャラクターは、私のロボットキャラクター「VE-G4」ことベガです。彼女は夏の三角形の同じ星の名前で、青い色を連想させます。ベガは持ち主を守る役目があり、敵から身を守るときは姿を変えます。普段は明るい水色の目をしているが、攻撃モードになると赤く光る。身長は153cmほどで、真面目な一面はブルーアーカイブスの＜キー＞の性格に似ている。お願いしたいテーマは、彼女がパワーアップしているシーン、おそらくリミッターを外して太陽のような水色の炎に包まれているシーン。そして、青い目から赤い目へと攻撃モードに切り替わる！もしよろしければ、青い目のバージョンと赤い目のバージョンでイメージの違いをお願いしたいです！背景はお任せします。服装は、ほぼそのままでいいと思いますが、細部は自由です。\n\n以下は、私がとても感銘を受けたあなたの作品です。このクールさと、映画的な雰囲気が気に入っています！\nhttps://www.pixiv.net/en/artworks/104519961\n\nhttps://drive.google.com/drive/folders/1reckYi34GndEKpVMROkNfaDeQE5jvreq?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kis_sako/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 138742, "client_id": 2170899, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/601874c3/uploads/origins/eacf95cd-b3e3-44de-bd7c-0b3b251e247e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0e6e0c6eaa2decf1b021ca39ce74d73", "srcset": "https://si.imgix.net/601874c3/uploads/origins/eacf95cd-b3e3-44de-bd7c-0b3b251e247e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0e6e0c6eaa2decf1b021ca39ce74d73, https://si.imgix.net/601874c3/uploads/origins/eacf95cd-b3e3-44de-bd7c-0b3b251e247e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9b35d5328ffb468c2a36a0942208053 2x, https://si.imgix.net/601874c3/uploads/origins/eacf95cd-b3e3-44de-bd7c-0b3b251e247e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b1477891327ae9fe0270ffe7faecc28 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/601874c3/uploads/origins/eacf95cd-b3