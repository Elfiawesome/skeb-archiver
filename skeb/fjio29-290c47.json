8527-abbc6be11283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c978cbc44725bd409e5dda43d14b8b52 2x, https://si.imgix.net/f76497c4/uploads/origins/33eb13fb-046f-4a5b-8527-abbc6be11283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32b775d037a4db9eb0c957886e75ac1d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f76497c4/uploads/origins/33eb13fb-046f-4a5b-8527-abbc6be11283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=331ae2e08a5922763df0d29341fab03e", "srcset": "https://si.imgix.net/f76497c4/uploads/origins/33eb13fb-046f-4a5b-8527-abbc6be11283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=331ae2e08a5922763df0d29341fab03e, https://si.imgix.net/f76497c4/uploads/origins/33eb13fb-046f-4a5b-8527-abbc6be11283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=abb060c174551415f3d5ef28de3641db 2x, https://si.imgix.net/f76497c4/uploads/origins/33eb13fb-046f-4a5b-8527-abbc6be11283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=259669630c1364c5223cf784cd76b67d 3x"}, "body": "TLのおすすめでイラストを拝見して、とても可愛くてコミッションをさせていただきました\nふじおさんのデフォルメされたポップな色使いのイラストが大好きなので私のキャラの二人を洋風メイドと中華メイドのデフォルメイラストでお願いしたいです\n\n【キャラ1】 ラア\nとある国の王女（側室の娘）で18歳のハーフエルフ\n側室の娘とはいえ家族仲が良く、将来は結婚して王家から出るので思考が庶民的\nキィとは友人で、食べ歩きと服を買うのが大好きなお嬢さん\nハーフエルフだけど人間の血が濃いので細身ではない\n\n【キャラ2】 キィ \nラアとは別の国の貴族の娘（17歳）\n黒髪ショートの髪型とオッドアイが特徴\n仏頂面で表情が乏しく、小柄で身のこなしが機敏だが、ラアの好みで押し付けられた服を着ることが多いヒラヒラふわふわの服も割と好き\n\n 二人の外見イメージは下記のリンクを参考にしてください \n\nラア\nhttps://www.dropbox.com/scl/fi/gvtta04vf7tyzrrws5igm/2025-04-30-20-04-36.jpg?rlkey=fh7dhflqzqd66xkpgdq1cs6tu&st=ufx988nn&dl=0\n\nキィ\nhttps://www.dropbox.com/scl/fi/489lrdxnlz21trjeqqggp/2026-11-18-22-04-47.jpg?rlkey=b64r0wzbpno26jp2d4676nudi&st=xjysvuid&dl=0\n\n上記の資料はあくまでビジュアルの基礎なのでラアの太眉とぱっちり目、キィのつり目（ジト目）と短眉の特徴と目の色や髪の色以外は髪型やアクセサリーなどたくさんアレンジしていただいて構いません\nデフォルメの全身の構図でお願いします \n衣装はふじお様のキャラデザセンスと衣装のデザインが好きなので、『メイドさんごっこ』がテーマでおまかせしたいです\nイメージテーマはラアが緑or紫でカラーで洋食系、キィが赤or黒で中華系です\n\n可能でしたら背景透過のデータもいただけると幸いです  \n\n【用途】 \n ●個人と友人で楽しむ印刷物のアクスタやカードの作成（可能であれば）", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fjio29/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3545521, "client_id": 3926715, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/adcbd41a/uploads/origins/7c1cc043-ef5f-4eab-a329-6fc28335d2f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=006077cc174f978d63c33fb458f563d2", "srcset": "https://si.imgix.net/adcbd41a/uploads/origins/7c1cc043-ef5f-4eab-a329-6fc28335d2f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=006077cc174f978d63c33fb458f563d2, https://si.imgix.net/adcbd41a/uploads/origins/7c1cc043-ef5f-4eab-a329-6fc28335d2f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73b326e483d521acf7e7e1c0c6ac7eb7 2x, https://si.imgix.net/adcbd41a/uploads/origins/7c1cc043-ef5f-4eab-a329-6fc28335d2f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=046669aa8ad44237687b8e1b95342df6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/adcbd41a/uploads/origins/7c1cc043-ef5f-4eab-a329-6fc28335d2f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2a712d5fdb9450d8011952c2e7d474a", "srcset": "https://si.imgix.net/adcbd41a/uploads/origins/7c1cc043-ef5f-4eab-a329-6fc28335d2f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2a712d5fdb9450d8011952c2e7d474a, https://si.imgix.net/adcbd41a/uploads/origins/7c1cc043-ef5f-4eab-a329-6fc28335d2f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=003ccb25