9440a4588bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9511be56e0b4483d5e126319e5967815", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15db328a/uploads/origins/c0d58350-7c92-4736-aa5a-9440a4588bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb11b143aba6d1b62465b3e101578011", "src_set": ""}, "body": "こんにちは！過去のリクエストを簡略化したいと思います。\n\nキャラクター：レイファン（DOA）\nDOA4でのエンディングを参考にしました：\n\nhttps://youtu.be/eO3IJokYrg8\n\n中年サラリーマンの復讐！電車の床でオジサンに犯されるレイファン。\n\nお好きなポーズを選んでください。レイファンは同じ服を着ている。シャツのボタンを外し、ブラジャーを下げて胸を露出している。レイファンは泣きそうな表情で、恐怖で目を見開いている。\n\n可能であれば、彼女の腹筋と顔にあざがあるリョナのバリエーションがあってもいい。\n\nご検討のほど、よろしくお願いいたします！", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@GsOW22vjcx/works/83", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1134738, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1da16e0/uploads/origins/c0429a4d-89dc-42ee-a217-325078083822?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a97af6ebc710edb3a0d2f2419e65b8f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1da16e0/uploads/origins/c0429a4d-89dc-42ee-a217-325078083822?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b826bce9743503c3319ef9e28d15db0f", "src_set": ""}, "body": "キャラ『ストリートファイター　ハン・ジュリ』\nコスチューム『紫と黒のライダースーツ（5のデフォコス、バイク中の衣装）インナーの損傷はお好みで』\nシチュエーション『敵集団による拘束凌辱』\n体勢『拘束＋仰向け開口器イラマ＋膣内凌辱＋』\nシーンの具体例『コードギアスシリーズで、紅月カレンが拘束されるシーンがイメージに近いです。\nカレンが台に複数のベルトで腰や腕を固定されている場面です』\n\n備考：アルバロさんのドラマを感じる一枚絵がとても好きです。\n過不足なく情報が入り、なおかつ美麗なイラストに仕上がる素晴らしさ……\n完成度は絶対的の信頼をしているので、アルバロさんが描きやすく、筆が進み、なおかつ負担の少ないスケージュルでお願いします。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@GsOW22vjcx/works/82", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1134738, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11b51bfb/uploads/origins/9cb3da95-3735-49eb-bed9-077eba74eac3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd80a69066a4932c01e60feae2c38f6c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11b51bfb/uploads/origins/9cb3da95-3735-49eb-bed9-077eba74eac3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba6930a367e2e641648a2fcda108bf96", "src_set": ""}, "body": "こんにちは。\n以前DOAほのかのエロリョナイラストをリクエストした者です。\n今回もリクエストお願いします。\n\n今回依頼したいイラストはDOAXVVのエリーゼ。\n\n服装はデフォルトのノースリーブヘソ出しYシャツ、タイトスカート、太もも丈のストッキングにヒールの格好で。\n\n構図はエリーゼがリングの中央で両手を頭の後ろに手を回し、エロ蹲踞をしているイラストをお願いします。\n\nここからは細かい内容として、\n・まず私が想像しているシチュエーションが格闘技の試合に敗北し、罰ゲームでやらされている状態。\n・その為表情は辱めを受け屈辱的な表情。\n・衣装はYシャツが破かれ胸が露出、タイトスカートが脱がされ秘部が丸見えの格好でお願いします。（Yシャツの破れ方は以前のほのかと同じ感じで大丈夫です。）\n下着は無しで大丈夫です。\n・また陰毛と試合に敗北しているシチュエーションなのでボコ顔＋全身に痣の差分をお願いします。\n\n上記の内容でリクエストお願いします。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@GsOW22vjcx/works/81", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1134738, "client_id": 2109408, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae91279e/uploads/origins/26fe2f74-e490-4efc-a1d1-1834f1316616?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4efb8c0f3b16dbeebca47950c8de8066", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae91279e/uploads/origins/26fe2f74-e490-4efc-a1d1-1834f1316616?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a78f652ec42f64aa9fba53e5ff388227", "src_set": ""}, "body": "こんにちは、リクエストお願いします。\n以前不知火舞でリクエストさせていただきましたが、再び舞でお願いします。\n\nお願いしたいイメージとしては\n仰向けないし横倒しの体勢にされ背後からチョークスリーパーで首を絞められる舞。\n舞は必死に抵抗するが、ペニスで体を固定され、動きも封じられ脱出できない。そして白目をむいて意識を失ってしまう。\n勝利した相手は満足そうに膣内射精まで決める。\n\nという内容をお願いします。\nよろしければ、どうぞお願いいたします。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@GsOW22vjcx/works/80", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/273648fb/uploads/origins/ccb51f26-a377-408a-ac72-bb30a21e9e51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88c9105113690e01499508c81591ae23", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1134738, "client_id": 27643, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 178, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@GsOW22vjcx/works/79", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e0cf2554/uploads/origins/b1c3b274-4364-4a16-b69e-6f8b7009521a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=973a41aa72901bfd9f38ce767940c65a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1134738, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 178, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@GsOW22vjcx/works/78", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1134738, "client_id": 855536, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f13a56f/uploads/origins/09d208ec-97f4-4f5e-9c6b-e6cd8b258a10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc512ca341e295d418f8cf106a1627cc", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f13a56f/uploads/origins/09d208ec-97f4-4f5e-9c6b-e6cd8b258a10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67b63a218e2755791f6670061b35cd17", "src_set": ""}, "body": "こんにちは、\n\n私はあなたの絵が大好きです。そこで、ストリートファイターのレインボー・ミカの絵を描いてほしいです。\n\nhttps://www.pixiv.net/en/tags/%E3%83%AC%E3%82%A4%E3%83%B3%E3%83%9C%E3%83%BC%E3%83%BB%E3%83%9F%E3%82%AB/artworks?ai_type=1\n\nミカの試合後の絵を描いてください。敗北し、衣装が破れて胸が裸になっている状態です。試合の勝者はミカをバックで犯します。ミカのツインテールを馬に乗るときの手綱のように引っ張ります。強く引っ張るので、ミカの背中は後ろに伸びます。こうすると、胸がより強調されます。\nミカが戦いで少し怪我をして、あざがあるバージョンを描いていただけると嬉しいです。そして、ミカが本当にひどく怪我をしているバージョンも。顔は血だらけで、胸もひどく怪我をしている。\n男の人は筋肉質な人でお願いします。でも、あまり細かく描かなくてもいいです。男の人の外見はお任せします。\n\nでは、良い一日を。\n\nアレックス／コールドウィル", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@GsOW22vjcx/works/77", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1134738, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92f8d27e/uploads/origins/32389dfb-1aca-4e72-bad6-edb7410b43f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49556bfed262d51e220532a6d8c6d7ca", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92f8d27e/uploads/origins/32389dfb-1aca-4e72-bad6-edb7410b43f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad7bb92d21dd9273c5cb8312973b2f4f", "src_set": ""}, "body": "リアリティのある肉付きと重量を感じさせる乳房の変形具合が大変素晴らしかったのでリクさせてください！\n\n【作品/キャラクター名】\nディノクライシス/レジーナ\n【シチュエーション/ポーズ】\n破壊工作のため敵軍施設に潜入するも捕縛され兵士らに嬲られてしまう。\n\n・立ちバックでハメられている\n・捕縛/尋問時に反抗したため痣や傷あり\n・ベルトなどを首に括り付けられ犬の首輪のように引っ張られている\n他はお任せします。\n\n【希望差分(可能であれば)】\n・ダクトテープギャグ(猿轡)\n\n【服装/見た目】\n髪型/髪色は資料のCGアートワークに準拠\n衣装は資料のゲーム内3Dポリゴンモデルに準拠\n・片乳と秘所部分の露出以外の破損はお任せします(タイツ/スーツが好きなので完全脱衣は無し)\n\nhttps://imgur.com/a/4AaO3eU", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@GsOW22vjcx/works/76", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1134738, "client_id": 51344, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dcefa06c/uploads/origins/e60abdb8-7119-4710-a978-030373380b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fee9612d0e37cc04172c0caf2f29167", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dcefa06c/uploads/origins/e60abdb8-7119-4710-a978-030373380b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bb66cb584e3e2401569d7c012caae19", "src_set": ""}, "body": "リクエスト再開お待ちしておりました、早速リクエストさせてください！\nDOAシリーズのこころをお願いします。\n衣装は資料URL、並びに下記のような和装姿\nhttps://drive.google.com/file/d/1v-sBqpTsO7rt3bbFYG5p6tRDOINVYyxb/view?usp=drivesdk\nhttps://drive.google.com/file/d/1jr0s_vSHPBggFIxDVZOy5vz1-EXKanYy/view?usp=drivesdk\nhttps://drive.google.com/file/d/1E7MeyTuQctOza8K4Q5VI-slIMqVe7VtM/view?usp=drivesdk\nhttps://drive.google.com/file/d/1F0Vj2Bf9uH21W3ZSXgHiVwC4enKiCpXb/view?usp=drivesdk\n\nシチュエーションは、格闘に破れて傷だらけの状態で腰を抜かして怯えている姿。\n背後（背中側）には金網が存在し、それに背中を預けている為にもう逃げられない形。\n表情は\nhttps://skeb.jp/@GsOW22vjcx/works/56の絵の時のように涙ぐみ、怯えている様子（戦意は完全に喪失している）。\n服はボロボロ、和装の片方は肩側からずりおろされ肩〜乳房まで丸出し、\n既に強姦済みであったりしても良いです。\n\n可能であればボコ顔の有無の差分があると嬉しいです（ボコ顔は徹底的に、歯が折れている様子がはっきりわかるような形だととても嬉しいです）。\n\nよろしくお願いします！\n\nhttps://www.gamecity.ne.jp/doa5/chara10.html", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@GsOW22vjcx/works/75", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6a989e98/uploads/origins/6ca