リフ多めだととても嬉しいです…！\n\nhttps://skeb.jp/@emons03/works/387", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 64788, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "牛乳ケーパー", "screen_name": "gyuunyuukeepaa", "avatar_url": "https://pbs.twimg.com/profile_images/1580065464998572033/vpX8tYu9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2575087574/1633813072/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 177}, {"id": 204691, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "拝一樹", "screen_name": "ogami2160", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F10f4da7f-3e0f-45b7-b087-1efbf2d43169.png?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/4386038c-7022-49e5-89af-01dbb5fbca83.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 32}, {"id": 445172, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ファラオ如来スカイ🔞", "screen_name": "Asch57Pharaoh", "avatar_url": "https://pbs.twimg.com/profile_images/1456624003008073728/f4dEgkIt.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "skills": [{"genre": "art"}], "nc": 33}, {"id": 759349, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "藍川ありか🔞", "screen_name": "aikawa_arika", "avatar_url": "https://pbs.twimg.com/profile_images/170884448308392755