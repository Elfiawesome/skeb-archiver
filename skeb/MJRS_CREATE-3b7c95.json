n\n名前：リドル・スナーク\n\n概要：ドラゴンとサキュバスのハーフ悪魔。\n元暗殺者のメイドで、大抵の事を十分にこなせる。\n火を噴いたり、他人の夢の中に潜り込むこともできる。\n\n性格：明るい。物怖じしない。努力家。猫かぶりで小狡く計算高い。主人が好き。主人に対しては無邪気。\n\n身長：153cm(ツノを含まない)\n\n髪型：クアドラプルテール(ツインテールの2倍)\n\n§\n\n資料不足や、金額が不十分などありましたら、再送をお願いします。\nその他、不都合があれば、キャンセルしていただいて構いません。\n\n以上、ご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1vRxLv3oKrtXoOaPlXYKNrJzUpUVgTGhL", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@162siR/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1112451, "client_id": 1722408, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01d4ce47/uploads/origins/2872e651-ecc2-425e-90d5-c8a18909a553?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e123f4b9970c9a9dbb9cf23f9bbc8b4", "srcset": "https://si.imgix.net/01d4ce47/uploads/origins/2872e651-ecc2-425e-90d5-c8a18909a553?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e123f4b9970c9a9dbb9cf23f9bbc8b4, https://si.imgix.net/01d4ce47/uploads/origins/2872e651-ecc2-425e-90d5-c8a18909a553?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f7e473f4cbbb1c5d4c5106dc453a5da 2x, https://si.imgix.net/01d4ce47/uploads/origins/2872e651-ecc2-425e-90d5-c8a18909a553?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bbd381b92907ec4fbbb1735fb1a256db 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01d4ce47/uploads/origins/2872e651-ecc2-425e-90d5-c8a18909a553?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aad72a98ad025b77631b336fa041b302", "srcset": "https://si.imgix.net/01d4ce47/uploads/origins/2872e651-ecc2-425e-90d5-c8a18909a553?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aad72a98ad025b77631b336fa041b302, https://si.imgix.net/01d4ce47/uploads/