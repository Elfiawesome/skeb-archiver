ess&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebcc799f9625153588d8e7fdf6ab6a9e, https://si.imgix.net/24b9e8bc/uploads/origins/a4b7ed53-361c-4b15-b056-2c3440e556ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88d429ffa625c3203a3af498a487372a 2x, https://si.imgix.net/24b9e8bc/uploads/origins/a4b7ed53-361c-4b15-b056-2c3440e556ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53aa781efef78b7b0590fbe6d0bdf74c 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24b9e8bc/uploads/origins/a4b7ed53-361c-4b15-b056-2c3440e556ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78e5086cfd6c7d550082b98c165343b2", "srcset": "https://si.imgix.net/24b9e8bc/uploads/origins/a4b7ed53-361c-4b15-b056-2c3440e556ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78e5086cfd6c7d550082b98c165343b2, https://si.imgix.net/24b9e8bc/uploads/origins/a4b7ed53-361c-4b15-b056-2c3440e556ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fc2480b7b998f95dc7456113a062a5ca 2x, https://si.imgix.net/24b9e8bc/uploads/origins/a4b7ed53-361c-4b15-b056-2c3440e556ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=423b9c571f19961ac9d1cd1781ad4f68 3x"}, "body": "以下のセッティングをお願いしたいのですが：\n\n養護教諭のパイズリで、コンドームがギリギリ入らない大量のペニスが大量クンニ。\n\n登場人物\n男性：とても細そうな小学生。生徒のデザインはあまり気にせず、生徒のデザインのペニスだけを気にする。\n\nペニス：できれば先生には、先生が描ける最大級の怪獣のようなペニスをすごく血管っぽく描いてほしい。あらゆる意味で馬のペニスに匹敵するペニス。\n\n女性：黒いランジェリーで、授乳可能な逆さ乳首の超巨乳のセクシーな養護教諭。\n\n通常の学校検診のように「精液サンプル採取」というシチュエーションにしてほしい。本来ならセルフオナニーで十分なはずだが、オナニーでは射精まで1時間以上かかるため、養護教諭が乳房で補助する。\nできれば、射精はとても激しくしてほしい。 \n\nコンドームが上に持ち上げられ、精液がコンドームの下から漏れるような勢いで。\n最後のパネルには、ペニスに精液の詰まった巨大なコンドームの風船を付けなければならない。養護教諭でさえ持ち上げるのに苦労するサイズだ。\n\nオプション\n- 可能であれば、ペニスは小さく始まり、モンスターサイズになるまで大きくなってほしい。\n- 養護教諭の乳首が丸見えであること。\n- 可能であれば、ペニスのサイズや大きさについて保健室の先生からコメントが欲しい。\n\nここに指定がないものは、uminoq先生がデザインを選んでください。\n\nありがとうございました！", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uminoqb/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 275427, "client_id": 1182625, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b932727b/uploads/origins/1dace3ff-a183-4aca-9a4d-7374239e9497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cc988d38c20eaac1112aca997ef514d", "srcset": "https://si.imgix.net/b932727b/uploads/origins/1dace3ff-a183-4aca-9a4d-7374239e9497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cc988d38c20eaac1112aca997ef514d, https://si.imgix.net/b932727b/uploads/origins/1dace3ff-a183-4aca-9a4d-7374239e9497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=54a64f39cd42c4f452bc1a34e3c3277d 2x, https://si.imgix.net/b932727b/uploads/origins/1dace3ff-a183-4aca-9a4d-7374239e9497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b18dc29bc6694b5e03480981275357a4 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b932727b/uploads/origins/1dace3ff-a183-4aca-9a4d-7374239e9497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5a83e490f1433e1e84c6b200c9a6fd0", "srcset": "https://si.imgix.net/b932727b/uploads/origins/1dace3ff-a183-4aca-9a4d-7374239e9497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5a83e490f1433e1e84c6b200c9a6fd0, https://si.imgix.net/b932727b/uploads/origins/1dace3ff-a183-4aca-9a4d-7374239e9497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d9cc386839e4d0a4984e952e2ed794be 2x, https://si.imgix.net/b932727b/uploads/origins/1dace3ff-a183-4aca-9a4d-7374239e9497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=68647cb5a4f273f150dacfc51eecb816 3x"}, "body": "またリクエストさせていただきます\n\nシチュエーション\nボーイッシュなハーフ幼馴染に告白するも他人に調教されておりコスプレセックスにハマって肉便器妻になっている報告をされる\n\nキャラ設定\n・人種は北欧系のハーフ\n・髪型や髪色はお任せしますがショートカット系だと嬉しいです\n・学校の王様として女子から人気がある\n・性的な事に興味はあるが恋人ができなかったため、性欲を持て余していた\n・チンポが大好き\n・爆乳でパフィーニップル\n・完全に調教されて肉便器妻になる宣言を動画に取られている(合意の上で)\n\nポーズや構図\nお任せしますが胸や局部が見えるようにしてください\n\n衣装\n・お任せしますので好きな衣装を着せてください(可能であれば牛柄ビキニ等の差分があると嬉しいです)\n・全裸差分もあると嬉しいです\n\n表情\nアヘ顔やオホ顔\n(ハート目があると嬉しいです)\n\n台詞や効果音\n下品な喘ぎ声や「ヘッヘ」などの息遣い\n(ハートマーク付で淫語沢山でお願いします)\n\n備考\n・可能でしたら衣装差分かキャラクターデザイン画があると嬉しいです\n・身体中に卑猥な落書き\n・衣装に使用済みゴムを括り付ける\n・精液ぶっかけ\n・周辺に大人の玩具や使用済みゴムが散乱\n・ピアス等はなし　\n・竿役はいなくても大丈夫です\n\n上記を踏まえて先生の性癖モリモリで好きな様に描いて頂けると嬉しいです\n時間はどれだけかかっても大丈夫です。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uminoqb/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 275427, "client_id": 18708, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c73965bf/uploads/origins/66d951a9-6a7e-461b-8535-ff06786305df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0eb2e29670fc3db3d48308aed6f00024", "srcset": "https://si.imgix.net/c73965bf/uploads/origins/66d951a9-6a7e-461b-8535-ff06786305df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0eb2e29670fc3db3d48308aed6f00024, https://si.imgix.net/c73965bf/uploads/origins/66d951a9-6a7e-461b-8535-ff06786305df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e877c57863f0287cd03737d63e950f1 2x, https://si.imgix.net/c73965bf/uploads/origins/66d951a9-6a7e-461b-8535-ff06786305df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59f336309fb2d15a5cd44bd486860089 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c73965bf/uploads/origins/66d951a9-6a7e-461b-8535-ff06786305df?bg=%23fff&auto=for