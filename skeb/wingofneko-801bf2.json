3-4b2b-99af-72afb3a89246?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=77d4bf258f0facdb5d7811a6ffa9858c, https://si.imgix.net/310ed4dc/uploads/outputs/ce4f0927-8cb3-4b2b-99af-72afb3a89246?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dc2205b47d27d9e615780879b99d0631 2x, https://si.imgix.net/310ed4dc/uploads/outputs/ce4f0927-8cb3-4b2b-99af-72afb3a89246?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6022cebabbd467f5c4f9c4c5991c7dc0 3x"}, "body": "はじめまして、あのにむ太郎と申します。\nskebにてムービーを制作してくださる方を探していたところ、ねこま様のアニメーションがとても魅力的に感じましたので依頼をさせていただきたいと思っております。\n\n【要望】\nリンク先のツイートにあるアズラエルというキャラクターを描いていただきたいです。\n細かい部分や色味などは描きやすいように変えていただいても大丈夫です。\n格闘ゲームの待機モーションのようなゆらゆら揺れる感じで、時折小型のナイフ(形はお任せしたいです)をステッキのようにクルクル回すような動きが入っていると嬉しいです。\n私自身にアニメーションについて造詣が無く、難しい事を言っているようでしたら動きはお任せいたします。\nまた、資料が自分用のものの流用ですので、タメ口っぽい部分があります。\n申し訳ございません。\n\n【使用用途】\n観賞用と、描いていただいたうちの子を宣伝のように投稿させていただきたいと思っております。\n勿論作者は自分で無い旨を表記いたします。\n\n【キャラについて】\nご承知おきいただかなくても大丈夫ですが、設定等が必要になる場合の為に書かせていただきます。\n・富豪同士の蹴落とし合いで暗殺等が黙認されている世界観で、ある家に遣える従者(元お坊ちゃん)\n・露悪的な少年(所謂、\"敵陣営のショタ幹部枠\"だと思っていただければ幸いです)\n・暗器のように服や靴など、至るところに無数の刃物を隠し持っている。\n・常に笑顔\n\n\nよろしくお願いいたします。\n\nhttps://twitter.com/anonym_tarou/status/1719742068472582567?t=_GsjrqFYZr_ZeUzAmdDPIQ&s=19\n\nhttps://twitter.com/anonym_tarou/status/1719742068472582567?t=_GsjrqFYZr_ZeUzAmdDPIQ&s=19", "nc": 137, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@wingofneko/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 1655305, "client_id": 2298990, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6efd26a/uploads/outputs/4b48ce46-84cb-4f55-af9a-26c774c166ef?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2fe3d9dc62bb3c0473e4982800651aec", "srcset": "https://si.imgix.net/c6efd26a/uploads/outputs/4b48ce46-84cb-4f55-af9a-26c774c166ef?bg=%23fff&fm=webp&auto=com