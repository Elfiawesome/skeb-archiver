e, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e7beab7/uploads/origins/52415880-a54d-4901-89dc-8ce25c09773c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b64a6f4283af7bf55175d8c2d59a4223", "src_set": ""}, "body": "セリザワ4％様、先日は大変かわいらしいSDイラストありがとうございました！！\nTwitterの方でもいつも素敵なイラスト拝見させて頂いてます♡\n\n改めまして今回はデフォルメ以外のイラストもセリザワ4％様に描いていただきたいなと思いリクエストを送信させていただきました！\n\nポージングは座っているものでお願いしたいです…！\n下記に使用予定ですので、髪の毛や服などが見切れのないように描いて頂きますと幸いです。その他描写範囲や髪型や服装は変更自由で、お任せします！\n可能であれば背景と人物のレイヤーを分けたPSDで頂きたいです。\n\n【キャラ詳細】\nぽんこつ\n髪の毛はシルバーに前髪の一部が水色。\nまつ毛は白色。\n自身から見て右頬にホクロ、胸にもほくろがあります。\n（今回は猫シスター衣装をお願いしたいです）\nhttps://drive.google.com/drive/folders/1HAqzl5Vi130iOuGOjGqlfvgFswRG-d0W?usp=drive_link\n\n【使用用途】\nグッズ使用、YouTubeサムネ、Twitterアイコンやヘッダー、ツイート等広報活動、ネットプリント、Twitch（Twitchは収益化済）\n不可な使用目的が御座いましたら、PSD内にご記載お願い致します。\n\n図々しいお願いかもしれませんが、顔のみでも可能ですのでSDイラストも頂けたら嬉しです…！\nご検討のほどよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1HAqzl5Vi130iOuGOjGqlfvgFswRG-d0W?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0x0com/works/85", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7ec93fb2/uploads/origins/4aa9db6d-12fa-4bd9-8c5f-fea2a2b63262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47d3db5f9d90f2ff63bbeef0f2a94188", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1662480, "client_id": 2528370, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@0x0com/works/84", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1662480, "client_id": 931834, "vtt_url": null, "thumbna