ee-71a854110d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be0618b2de867a37c71c0aff74be6052", "srcset": "https://si.imgix.net/928ea812/uploads/origins/e868c029-511b-4bb5-bfee-71a854110d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be0618b2de867a37c71c0aff74be6052, https://si.imgix.net/928ea812/uploads/origins/e868c029-511b-4bb5-bfee-71a854110d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=055e45c7014ef357bdc3c125a5a98ea0 2x, https://si.imgix.net/928ea812/uploads/origins/e868c029-511b-4bb5-bfee-71a854110d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4b3c8d02e1d1e7409d9dd1012d2d6437 3x"}, "body": "眼鏡ちくわ様\n\nTwitchメインで活動しているケイト・アストライアでございます。\n前回・前々回に引き続き、再度ご依頼したくリクエストをお送りいたします。\n前回のブライダルもとてもファンの皆様や初見の方にも大変好評でした！\n---------------\n・使用用途\n　-YoutubeやTwitchなど配信サイトに投稿するサムネイルにおいての使用\n　-動画や配信内での使用\n　-Twitterやブルースカイ、DiscordなどのSNSへの投稿\n　-アイコンやヘッダーへの使用\n　-コンビニで行えるネットプリントでの配布\n\nとなります。　\n\n・デザインやカラーの詳細(服装、目、髪形など)\n今回は吸血鬼(ヴァンパイア)のコスプレをしている私を描いていただきたいです。\nお貴族様というよりかはローブをまとうようなタイプの方向性の服装だと嬉しいです。\n※参考資料フォルダ内の3周年記念イラストのようなローブ\n\n眼は何か人外を思わせるような妖しい光を放っていると嬉しいです。\n\n・表情\n舌を出して舌の上に首から提げている十字架のチャームを乗せて「まるでこんなものが私に効くとでも？」というような挑発をしているが、\n目の前に立つ誰かに血を飲ませたいと思うような煽動するような表情\n\n\n・ポーズ、構図：\n吸血鬼(ヴァンパイア)としてあなたをこちら側へ手引きし誘い込み、人から見えないところで吸血を楽しむためにどこかへ連れ去ってしまいそうに見えるようなポーズだと嬉しいです\n\n・背景（無しの場合は、色や透過にするかなど）：\n背景は無しのパターンときれいな満月が浮かぶ夜の街のパターンがあると嬉しいです\n(満月が映っていなくとも月明かりが強く満月を感じるといったものでも構いません)\n\n・画像サイズ（px）：\n横1051　縦1500pxでお願いいたします\n\n・ファイル形式（jpg、pngなど）：\npngでいただけると嬉しいです\n\n・解像度、dpi（印刷用かweb用か）：\n300dpiでお願いいたします。\n---------------\n三面図などを参考資料フォルダに格納しております。良ければご一読くださいませ。\nhttps://drive.google.com/drive/folders/1Svn4_K0FBHRHjhV7CU3GtykMfowI8wFO?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chikuwa_glasses/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2b97b2f1/uploads/origins/c0094665-2ae4-4cae-be09-1fb60bcbe9b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c3615e3ded777d5c2d0d4d6b29f278f", "srcset": "https://si.imgix.net/2b97b2f1/uploads/origins/c0094665-2ae4-4cae-be09-1fb60bcbe9b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c3615e3ded777d5c2d0d4d6b29f278f, https://si.imgix.net/2b97b2f1/uploads/origins/c0094665-2ae4-4cae-be09-1fb60bcbe9b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc0de1e2dbea6094d65d96dd8a0bafde 2x, https://si.imgix.net/2b97b2f1/uploads/origins/c0094665-2ae4-4cae-be09-1fb60bcbe9b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c8ebfdf6aef110af747094691f69315 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3154605, "client_id": 3402681, "nc": 0}, {"path": "/@chikuwa_glasses/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3154605, "client_id": 2464282, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33cb5a68/uploads/origins/dafb182a-8a61-4ee6-af1f-9ece1a85eef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e9cfe10efd9ea5d3d1100172966bd0a", "srcset": "https://si.imgix.net/33cb5a68/uploads/origins/dafb182a-8a61-4ee6-af1f-9ece1a85eef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e9cfe10efd9ea5d3d1100172966bd0a, https://si.imgix.net/33cb5a68/uploads/origins/dafb182a-8a61-4ee6-af1f-9ece1a85eef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1afd738de019ad8b9024db17bf4bbb5 2x, https://si.imgix.net/33cb5a68/uploads/origins/dafb182a-8a61-4ee6-af1f-9ece1a85eef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=373ac0ff8f7890b954d3d73db680c4e2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33cb5a68/uploads/origins/dafb182a-8a61-4ee6-af1f-9ece1a85eef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a629f6083b81a44ed9f9656df80d609f", "srcset": "https://si.imgix.net/33cb5a68/uploads/origins/dafb182a-8a61-4ee6-af1f-9ece1a85eef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a629f6083b81a44ed9f9656df80d609f, https://si.imgix.net/33cb5a68/uploads/origins/dafb182a-8a61-4ee6-af1f-9ece1a85eef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab83484e30cae95920731e0b7eb2840b 2x, https://si.imgix.net/33cb5a68/uploads/origins/dafb182a-8a61-4ee6-af1f-9ece1a85eef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64e37441b9af66d6d204fb560c91e44b 3x"}, "body": "眼鏡ちくわ様\n\nTwitchメインで活動しているケイト・アストライアでございます。\n前回イラストを依頼した際に大変クオリティが高く、リスナーさんにも喜んでいただけたため再度ご依頼させていただきたいです。\n---------------\n・使用用途\n　-YoutubeやTwitchなど配信サイトに投稿するサムネイルにおいての使用\n　-動画や配信内での使用\n　-Twitterやブルースカイ、DiscordなどのSNSへの投稿\n　-アイコンやヘッダーへの使用\n　-コンビニで行えるネットプリントでの配布\n\nとなります。　\nもし、ネットプリントでの配布が商用利用にあたるとお考えの場合は、一度別のサイトから依頼をさせていただきます。\nその際はお気軽にリクエストの却下をしていただければと思います。\n\n・デザインやカラーの詳細(服装、目、髪形など)\nナイトウエディングでの私を描いていただきたいです。\n服装はタキシードでタキシード自体のデザインや髪型・服装のアレンジはお任せいたします。\n服装以外では淡い紫のブートニアが刺さっていると嬉しいです。\n\n・表情\nこれから結婚する画面の前の人との新しい生活が楽しみにしているのが分かるような表情だと嬉しいです。\n(個人的には眼鏡ちくわ様が5/17に投稿したトレイ・クローバーの「おあじはいかが？」のような煽情的な表情がとても好きです……！)\n\n・ポーズ、構図：\n結婚指輪の入っているリングケースに口づけをするかのように軽く口に寄せつつ、もう片方の手で相手の手を取るようなポーズ\n画面の前の人に手を向けている構図になります\n\n・背景（無しの場合は、色や透過にするかなど）：\n背景は無しのパターンとブライズルームのイメージが付くような背景があるとよいです\n\n・画像サイズ（px）：\n横1051　縦1500pxでお願いいたします\n\n・ファイル形式（jpg、pngなど）：\npngでいただけると嬉しいです\n\n・解像度、dpi（印刷用かweb用か）：\n300dpiでお願いいたします。\n---------------\n三面図などを参考資料フォルダに格納しております。良ければご一読くださいませ。\nhttps://drive.google.com/drive/folders/1Svn4_K0FBHRHjhV7CU3GtykMfowI8wFO?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chikuwa_glasses/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3154605, "client_id": 2464282, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/773fd5aa/uploads/origins/a1e0b355-4597-4340-907e-1be6f121f32a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fa8da2a58c1b45e432e833194880e3e", "srcset": "https://si.imgix.net/773fd5aa/uploads/origins/a1e0b355-4597-4340-907e-1be6f121f32a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fa8da2a58c1b45e432e833194880e3e, https://si.imgix.net/773fd5aa/uploads/origins/a1e0b355-4597-4340-907e-1be6f121f32a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06665845f54f57027a369e6bf24de290 2x, https://si.imgix.net/773fd5aa/uploads/origins/a1e0b355-4597-4340-907e-1be6f121f32a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=855079ef3e7c4bba736b0e29c689069f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/773fd5aa/uploads/origins/a1e0b355-4597-4340-907e-1be6f121f32a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6516d4b66143438577e85532c454539b", "srcset": "https://si.imgix.net/773fd5aa/uploads/origins/a1e0b355-4597-4340-907e-1be6f121f32a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6516d4b66143438577e85532c454539b, https://si.imgix.net/773fd5aa/uploads/origins/a1e0b355-4597-4340-907e-1be6f121f32a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a77477fec0c4f76991087bd59c157f36 2x, https://si.imgix.net/773fd5aa/uploads/origins/a1e0b355-4597-4340-907e-1be6f121f32a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7407086ddb966e7509240ea2614a05ee 3x"}, "body": "眼鏡ちくわ様\n\n初めてリクエストをお送りします。\n\nTwitch配信メインで活動をしている個人VTuberのケイト・アストライアと申します。\nTwitterなどで大変素敵なイラストを拝見させていただき、ぜひ私のイラストを描いていただきたくリクエストをさせていただきました。\n\n使用用途といたしましては、\n\n・YoutubeやTwitchなど配信サイトに投稿するサムネイルにおいての使用\n・配信内での使用\n・Twitterやブルースカイ、DiscordなどのSNSへの投稿\n・アイコンやヘッダーへの使用\n\nとなります。　\n\n▪︎イラストについて\n夜寝る前のおやすみツイートだったり配信終了時の画面に使用するのを想定しています。\nベッドで横になっているような構図でパジャマを着ていて、色気のあるもので画面の前の誰かをちょっとあおっているようにも見える表情だとよいです。\n(衣装がはだけてたり少し肌色が見える分には問題ないです)\n\n・イラストに関しての仕様などについて\n -サムネなどに利用する可能性があるので、人物と背景でレイヤーが分けされたものが別個であると助かります\n -カラー希望になります\n -1920*1080のサイズだと助かります\n\nご参考に三面図などを参考資料フォルダに格納しております。良ければご一読くださいませ。\n\n▼三面図など資料格納先はコチラになります▼\nhttps://drive.google.com/drive/folders/1Svn4_K0FBHRHjhV7CU3GtykMfowI8wFO?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chikuwa_glasses/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3154605, "client_id": 2843611, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e72cc5c1/uploads/origins/0f807974-6100-474b-89cb-3f1091015d51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=653a983b89724ac2bef9e458772d79d1", "srcset": "https://si.imgix.net/e72cc5c1/uploads/origins/0f807974-6100-474b-89cb-3f1091015d51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=653a983b89724ac2bef9e458772d79d1, https://si.imgix.net/e72cc5c1/uploads/origins/0f807974-6100-474b-89cb-3f1091015d51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6016564ded4d30b0a396801575145396 2x, https://si.imgix.net/e72cc5c1/uploads/origins/0f807974-6100-474b-89cb-3f1091015d51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit