e7-341a-4dc3-82b5-ea1b017c7f04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d15a17458a4bc6a3959d84921285fd5", "srcset": "https://si.imgix.net/3e5aa3d3/uploads/origins/9fdd3be7-341a-4dc3-82b5-ea1b017c7f04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d15a17458a4bc6a3959d84921285fd5, https://si.imgix.net/3e5aa3d3/uploads/origins/9fdd3be7-341a-4dc3-82b5-ea1b017c7f04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e60c354556729a925973f0e3acccf43f 2x, https://si.imgix.net/3e5aa3d3/uploads/origins/9fdd3be7-341a-4dc3-82b5-ea1b017c7f04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c1d267d48d5b38dabe164907350465ac 3x"}, "body": "はじめまして！\nわわわさんの描かれるイラストをお見掛けして、線のタッチに惹かれました。\nよろしければ私のOCを自由なスタイルで描いていただきたいです。\n\n■キャラクター詳細\n世界観：アラビアン、ファンタジー\n\n名前：ナキ（Naqi）\nモチーフ：火星\n職業：王子専属の騎士。\n性格：王子の忠犬。剣術の腕は確か。普段は寡黙に振舞う従者だが、実は戦うのが好きな戦闘狂。王子を守るためならば死ぬことを恐れない。\n容姿：183cm。20代。赤紫の髪をしており、威圧的な見た目。顔に傷があり、目に常に陰がかかっている。目はぐるぐると渦巻いたデザイン。髪の耳っぽい部分は寝ぐせ。\n\n■使用用途\n個人観賞、個人利用のヘッダー・アイコン・壁紙など金銭が絡まない範囲での利用。\nまた、依頼する際の参考資料としてGoogleドライブにて提示する可能性もあります。\n\n■納品形式\npsdまたはpng。\n可能ならラフや線画を分けたものも残していただけますと嬉しいですが、なくても大丈夫です。\n\n構図などはお任せいたします。\n細かい装飾などは補完したり自由に増やしたりして頂いて構いません。\n他にパーティーメンバーが同行しており、彼らの要素を含むことも問題ありません。\n条件が難しい場合や金額が足りない場合は再送リクエストをお願いします。\nお忙しいところ恐縮ですがご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1MzS6zhJPmLJJkk1JrF019ZJV9dJNAFct?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wwma28/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3774102, "client_id": 3032600, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad13d235/uploads/origins/a03be711-d596-4fd7-b2c0-d9d7d72d660d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65f803491c23bc2be4657f0ae076fb41", "srcset": "https://si.imgix.net/ad13d235/uploads/origins/a03be711-d596-4fd7-b2c0-d9d7d72d660d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65f803491c23bc2be4657f0ae076fb41, https://si.imgix.net/ad13d235/uploads/origins/a03be711-d596-4fd7-b2c0-d9d7d72d660d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46966a8a0ccfcb03e775a10b734aa59b 2x, https://si.imgix.net/ad13d235/uploads/origins/a03be711-d596-4fd7-b2c0-d9d7d72d660d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73ed3fa518c41b5ba0ff364efa7523ce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad13d235/uploads/origins/a03be711-d596-4fd7-b2c0-d9d7d72d660d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49018d3e9e4a5bb924caf6d8820e2c1d", "srcset": "https://si.imgix.net/ad13d235/uploads/origins/a03be711-d596-4fd7-b2c0-d9d7d72d660d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49018d3e9e4a5bb924caf6d8820e2c1d, https://si.imgix.net/ad13d235/uploads/origins/a03be711-d596-4fd7-b2c0-d9d7d72d660d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=95f5fc0bc39cff5282526525d2920c5a 2x, https://si.imgix.net/ad13d235/uploads/origins/a03be711-d596-4fd7-b2c0-d9d7d72d660d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=119d2d620453d53111f7039f56411602 3x"}, "body": "先生、こんにちは。先生の絵が大好きです。本当にかっこいいです！\n動きのある表現がとても素晴らしいです！\n私のOCを描いていただきたいです。\n彼女は人間に道具として使われている小さな使い魔です。\n\nOCの設定：\n\n身分： 人間ではなく、人間が作り出し使用する人工の存在です。\n　* ただし、彼女の魂は外の世界から来た幽霊であり、そのことを隠しています。\n\n外見： 身長155cm、見た目は13歳くらいですが、実際にはこの世界に生まれてまだ9か月しか経っていません。\n\n性格： 時々は静かでおとなしく見せかけていますが、本当は世界に対して強い好奇心を持っており、心の奥はとても活発です！\n\n戦い方： 遠距離の魔術タイプ。服装の設定によって、魔法、骨の鞭、クロスボウ、または儀式用の長刀などを使います。\n\n特徴：\n　・額に緑色のリボン（とても大事な固定の特徴）\n　・宝石のような緑色の瞳\n　・整った前髪\n　・狐のように大きくふわふわした耳と尻尾\n\n彼女のそばには、いつも青い幽霊の友達がいます。その幽霊はいたずら好きで、三つの異なる姿を持っています。\nどの姿を描いていただいても構いません。\nどうぞご自由に描いてください！\n\nhttps://drive.google.com/drive/folders/1gQDOErGAgS2F3rGwm2fOhB6LlJZy6X-L?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wwma28/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3774102, "client_id": 3097042, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c23e2f1/uploads/origins/ecab227d-b755-40c2-ae55-28e3c74f9fde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eca2dbb77c5a1ed3a6f411f996578d72", "srcset": "https://si.imgix.net/4c23e2f1/uploads/origins/ecab227d-b755-40c2-ae55-28e3c74f9fde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eca2dbb77c5a1ed3a6f411f996578d72, https://si.imgix.net/4c23e2f1/uploads/origins/ecab227d-b755-40c2-ae55-28e3c74f9fde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1ee54635e1c4ea79d56161930b42a52 2x, https://si.imgix.net/4c23e2f1/uploads/origins/ecab227d-b755-40c2-ae55-28e3c74f9fde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=225e29c3f5b3c8557f55625a21bf030b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c23e2f1/uploads/origins/ecab227d-b755-40c2-ae55-28e3c74f9fde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1aa82a2255511b06fbfe1568d273162", "srcset": "https://si.imgix.net/4c23e2f1/uploads/origins/ecab227d-b755-40c2-ae55-28e3c74f9fde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1aa82a2255511b06fbfe1568d273162, https://si.imgix.net/4c23e2f1/uploads/origins/ecab227d-b755-40c2-ae55-28e3c74f9fde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fad6b72a4f023991935a830e1cd5adee 2x, https://si.imgix.net/4c23e2f1/uploads/origins/ecab227d-b755-40c2-ae55-28e3c74f9fde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4ed2c136f1fb2adbe2e6b20891c02b49 3x"}, "body": "前回の作品が気に入ったので、また依頼しました～今回は私のOCのために職業に合わせて新しい服をデザインしてもらいたいです。特別な要求はなく、自由に発揮できます。\n\n姐（178cm/29岁/灰色の目、右目が火傷したところは任意の色の義眼に変えることができます）：\n冷淡で笑わない女性、眼鏡をかけている。右頬から首筋にかけて火傷の痕があります、習慣的に火傷を隠せる服を着る、自分の顔の傷跡に劣等感を感じる。\n過去に他人に裏切られて傷ついたことがあるので、他人を信じるのは難しいです。しかし、妹が一番好きで、何があっても彼女を守り、妹のすべての決定を無条件に信じます。\n妹を補佐するために看護師になった。二人の中で戦闘能力が高い方。\n\n妹（174cm/20岁/青い目）：\n明るく快活で、自信に満ちた天才少女。少し腹黒いところがありますが。\n姉が大好きで、表面的には二人の中でしつけられているように見えるが、本質的には関係の主導権を握っている、ロープを握っているあの人です。\n職業は医者。生と死を掌る感覚や、他人を容易く救えることに快感を覚えるためこの道を選んだ。また、物を分解し組み立てる行為にも強い興味を持っている。\n\n最終作品はPSDで提出をお願いしたいのですが、下書きとデザインのアイデアを追加できれば嬉しいです！なくても大丈夫です。 \n内容や金額に問題があれば、再送が可能かと思います。何か不合理な点があれば、お断りしていただいても結構です。ありがとう。\n\nhttps://drive.google.com/drive/folders/1-9V_7btGSSQDZH7g1QXI1ua8IIA4u-eM", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wwma28/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3774102, "client_id": 3280149, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47a428db/uploads/origins/493a32a0-0d28-4d67-aba3-cf5d6d3aef5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a4eeb8ce458d706fced83068fe53610", "srcset": "https://si.imgix.net/47a428db/uploads/origins/493a32a0-0d28-4d67-aba3-cf5d6d3aef5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a4eeb8ce458d706fced83068fe53610, https://si.imgix.net/47a428db/uploads/origins/493a32a0-0d28-4d67-aba3-cf5d6d3aef5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79196b0ee193479e504be2b2d1f8186c 2x, https://si.imgix.net/47a428db/uploads/origins/493a32a0-0d28-4d67-aba3-cf5d6d3aef5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fceccccef33365f3b25de7e3c2428ab8 3x"}, "duration": null, "nsfw": f