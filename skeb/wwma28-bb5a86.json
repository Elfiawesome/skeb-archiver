f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42800de20bdb574f2b3fcc2f4ea8a3f4, https://si.imgix.net/1efe3a0a/uploads/origins/f1ef0d94-dedb-46ac-9441-4b6e09052c7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=190596b3e478bce07f66c7d2a44a2f74 2x, https://si.imgix.net/1efe3a0a/uploads/origins/f1ef0d94-dedb-46ac-9441-4b6e09052c7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3601ec037dace690431dc1f24d21ec1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1efe3a0a/uploads/origins/f1ef0d94-dedb-46ac-9441-4b6e09052c7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a991520e798ed10de89e4c200840a09c", "srcset": "https://si.imgix.net/1efe3a0a/uploads/origins/f1ef0d94-dedb-46ac-9441-4b6e09052c7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a991520e798ed10de89e4c200840a09c, https://si.imgix.net/1efe3a0a/uploads/origins/f1ef0d94-dedb-46ac-9441-4b6e09052c7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=27b06751773e4c8060adb0576a8f48fa 2x, https://si.imgix.net/1efe3a0a/uploads/origins/f1ef0d94-dedb-46ac-9441-4b6e09052c7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=631c4b492b5a083ca2deb1526d898679 3x"}, "body": "わわわ先生、こんにちは。\n\n先生の描かれるイラストの雰囲気がとても好きで、今回ご依頼を送らせていただきました。私のオリジナルキャラクターを描いていただけないでしょうか。\n\n【世界観】\nスチームパンク\n\n【キャラクター設定】\n性別：女\n年齢：16歳\n身長：162cm\n性格キーワード：明るい、活発、強い\n外見的特徴：\n①少しボサボサした黒髪\n②ぱっちりとした黒い瞳\n③腕には作業でできた傷跡あり\n④服装全体的に子犬の要素を取り入れており、ゴーグルの両側には子犬のような耳、後ろにはしっぽのようなパーツ付き。靴はローラースケート。\n\n彼女はスラム街の下層に住む孤児で、機械を作ることが何よりの趣味であり、夢は優秀なエンジニアになることです。\n彼女には2体のロボットの相棒がいます。大きなロボットは不器用で動きは遅いですが、家族を静かに見守っています。小さなロボットは賢くて機転が利き、彼女の頼もしい助手です。\n\n用途：個人のSNSのアイコンやスマホの壁紙など、あくまで個人的に使用するもので、商用利用はいたしません。\n\n最終納品はpsd形式でお願いいたします。もし線画もいただけると大変嬉しいです。\n\nSkebでのご依頼は初めてですので、至らぬ点がありましたらどうかお許しください。よろしくお願いいたします。\n\nわわわ老师，您好。我非常喜欢您的画作风格，因此来向您发送委托请求，希望您能画我的原创角色。\n\n世界观：蒸汽朋克\n\n【角色设定】\n性别：女\n年龄：16岁\n身高：162cm\n性格关键词：开朗、活泼、坚强\n外貌特征：\n①有点乱的黑发\n②圆圆的黑瞳\n③手臂上有工作时留下的伤痕。\n④服装整体融合了小狗的元素，头上的护目镜两侧有小狗般的耳朵，身后也有小狗般的尾巴。鞋子是轮滑鞋。\n\n她是一位住在底层贫民窟的孤儿，最大的兴趣爱好是制作机器，梦想是成为一名出色的工程师。\n她有两只机器人伙伴。大机器人笨拙、行动缓慢，默默守护着家人；小机器人聪明伶俐、是少女的得力助手。\n\n用途：仅作个人社交媒体的头像、手机壁纸等个人使用，不会商用。\n\n希望您最终交付psd格式的成稿，如果带有线稿那就再好不过了。\n\n这是我第一次使用skeb进行委托，若有得罪还请谅解。\n\nhttps://drive.google.com/drive/folders/1iQ8SbxqMuQL7YBf7N3ziW9_z8g-8zPDx", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wwma28/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3774102, "client_id": 909437, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da6d874f/uploads/origins/7cf0376e-8f80-4b32-85c9-d93bb2b29db4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d641805a486c0ef92f2e9a851b78c61", "srcset": "https://si.imgix.net/da6d874f/uploads/origins/7cf0376e-8f80-4b32-85c9-d93bb2b29db4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d641805a486c0ef92f2e9a851b78c61, https://si.imgix.net/da6d874f/uploads/origins/7cf0376e-8f80-4b32-85c9-d93bb2b29db4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c91c2286fe446df2954c668623a3d01c 2x, https://si.imgix.net/da6d874f/uploads/origins/7cf0376e-8f80-4b32-85c9-d93bb2b29db4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca306d4aa4335dccf3ff65adb4bf2d73 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da6d874f/uploads/origins/7cf0376e-8f80-4b32-85c9-d93bb2b29db4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=157afae70429f021886b2d8d7b07e271", "srcset": "https://si.imgix.net/da6d874f/uploads/origins/7cf0376e-8f80-4b32-85c9-d93bb2b29db4?bg=%23fff&auto=format%2Ccompress&fm=