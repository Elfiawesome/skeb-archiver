を取っているところを見てみたい。\n\nご自由に描いてください。先生にとってかっこいいシーンであればうれしいです。\n\nご検討よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wwma28/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c4b2839e/uploads/origins/fc908943-69ea-40e5-b838-731a8ec776bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=511ccba1241988eb771767abb4284d72", "srcset": "https://si.imgix.net/c4b2839e/uploads/origins/fc908943-69ea-40e5-b838-731a8ec776bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=511ccba1241988eb771767abb4284d72, https://si.imgix.net/c4b2839e/uploads/origins/fc908943-69ea-40e5-b838-731a8ec776bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db4a8264aa155883d15204210ba4be07 2x, https://si.imgix.net/c4b2839e/uploads/origins/fc908943-69ea-40e5-b838-731a8ec776bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=870827fe4de7a6347e223158e77930cb 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3774102, "client_id": 1095124, "nc": 144}, {"path": "/@wwma28/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b4191358/uploads/origins/9bca1e45-3018-4c0d-bfd1-83d7f4e37493?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14cfdb0da1ffd34558296ae047664e17", "srcset": "https://si.imgix.net/b4191358/uploads/origins/9bca1e45-3018-4c0d-bfd1-83d7f4e37493?bg=%23fff&auto=format%2Ccompress&fm=webp&fi