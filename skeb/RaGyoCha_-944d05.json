gins/1921a7bf-c32f-4268-b6e9-5f8d0338eec4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c69a4de313a476220b9231d3e2592f22, https://si.imgix.net/4744b78f/uploads/origins/1921a7bf-c32f-4268-b6e9-5f8d0338eec4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ef06218b9f5187ab09e63e19e8c9f78 2x, https://si.imgix.net/4744b78f/uploads/origins/1921a7bf-c32f-4268-b6e9-5f8d0338eec4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5c848a6756def6a7ded6461023ba710 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4744b78f/uploads/origins/1921a7bf-c32f-4268-b6e9-5f8d0338eec4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a33e6f9f89c5a1f776c4f6b164ab38a", "srcset": "https://si.imgix.net/4744b78f/uploads/origins/1921a7bf-c32f-4268-b6e9-5f8d0338eec4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a33e6f9f89c5a1f776c4f6b164ab38a, https://si.imgix.net/4744b78f/uploads/origins/1921a7bf-c32f-4268-b6e9-5f8d0338eec4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=82981ce68138ea7ea91849a06ec2e2b9 2x, https://si.imgix.net/4744b78f/uploads/origins/1921a7bf-c32f-4268-b6e9-5f8d0338eec4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7515d2395dd5ec452c3b902c04acdc7b 3x"}, "body": "こんにちは、あなたの絵はかわいくて柔らかいので、参考リンクにある私のキャラクターのイラストを作っていただけませんか？成なれ果て（Made in Abyss）を彷彿とさせるようなフクロウタイプのケモノキャラクターです。\nイラストの構図は、このキャラクターをどう解釈するかで、水着やビキニなどの女性的な服装や、タイトな服装、露出度の高い服装でも構いませんし、以前描いたことのあるようなかわいい服装や、描いてみたい服装でも構いません。また、露出度の高い服装を選んだ場合は、スカーフで顔を少し隠して、少し顔を赤らめながら恥ずかしそうにしているかもしれません。\nその他、可能であれば作品の詳細はお任せしたいです。\nこの度はありがとうございました。\n\nhttps://drive.google.com/drive/folders/1f8-G7XGpkwVEYTOY74B5vz77AzYqN9XH?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RaGyo