2ad4d3-6022-4683-b2e9-a095101887f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd98cc3a518ec300aa9aded13dc279cc", "srcset": "https://si.imgix.net/4c63e565/uploads/origins/db2ad4d3-6022-4683-b2e9-a095101887f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd98cc3a518ec300aa9aded13dc279cc, https://si.imgix.net/4c63e565/uploads/origins/db2ad4d3-6022-4683-b2e9-a095101887f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dd290b4f5b840f7de7fea69b86053c33 2x, https://si.imgix.net/4c63e565/uploads/origins/db2ad4d3-6022-4683-b2e9-a095101887f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cb185afe21685798dbc7bfc55f0a1ad8 3x"}, "body": "ハバ様、突然の連絡失礼します。\n久々に、BLACK NESTをプレイしました。特にコフィさんがステキでした。なので「ミリタリージャケット姿のコフィ」をリクエストします。\n以下、リクエスト内容です。\n\n・構図について…正面向きの腰当てポーズ\n構図はロゥ君の時の様な感じです。片方または両方の手を腰に当てる様にお願いします。（できれば両手両腕が隠れずに見えるようにして欲しいです。）\nこの時のロゥ君のイラストは、ちゃんと目線がこちらを見て笑顔になっているので、この様な感じにして頂ければと思います。\nhttps://skeb.jp/@eremiro/works/12\n\n・ワッペンの有り無し差分をお願いしたいです。\n・表情は、ゲーム内の立ち絵（体力１００％状態）や、ユニットステータス画面の顔グラや、CIENのコフィプランの様な、明るい笑顔で。（特に顔グラのコフィの顔が好きです！）\n・笑顔の表情差分は、何種類かあると嬉しいです。（しっかりとこちらに目線が行くように、こちらを見るように。）\n・下半身の服装は、今までのリクエストと同じズボン＆ブーツスタイルでOKです。\n・以前のコフィのリクエストでは、杖を持っていましたが、今回は何も持ってない状態でお願いします。\n・背景は無しでお願いします。\n・PSD形式での納品をお願いします。\n\n条件を色々と述べてしまいましたが、ご検討のほどよろしくお願いいたします。\nゲーム制作の方も、応援しております！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eremiro/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8868e5d3/uploads/origins/a5243da0-43d4-47f5-8a85-fdbe47fee642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a3dd0200ed3d7c0824843723fe744120", "srcset": "https://si.imgix.net/8868e5d3/uploads/origins/a5243da0-43d4-47f5-8a85-fdbe47fee642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a3dd0200ed3d7c0824843723fe744120, https://si.imgix.net/8868e5d3/uploads/origins/a5243da0-43d4-47f5-8a85-fdbe47fee642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c999a0661e69f4486dfa54ebc7ddb5a3 2x, https://si.imgix.net/8868e5d3/uploads/origins/a5243da0-43d4-47f5-8a85-fdbe47fee642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66ff81750fb1196734160f7604dd6f61 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2439287, "nc": 128}, {"path": "/@eremiro/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2439287, "client_id": 3245694, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f1b0d66/uploads/origins/3aaf8260-6b96-4adf-a23b-db0691d72a72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=169d11774e4d70aa491db651cc2de41d", "srcset": "https://si.imgix.net/1f1b0d66/uploads/origins/3aaf8260-6b96-4adf-a23b-db0691d72a72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=169d11774e4d70aa491db651cc2de41d, https://si.imgix.net/1f1b0d66/uploads/origins/3aaf8260-6b96-4adf-a23b-db0691d72a72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d105509fbef2bd678815eb3fdbbf8c5d 2x, https://si.imgix.net/1f1b0d66/uploads/origins/3aaf8260-6b96-4adf-a23b-db0691d72a72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=092f43bf3f1a51df72bf8f40d9dc6809 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f1b0d66/uploads/origins/3aaf8260-6b96-4adf-a23b-db0691d72a72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8f85845208da54ee8798a5183e7ad04", "srcset": "https://si.imgix.net/1f1b0d66/uploads/origins/3aaf8260-6b96-4adf-a23b-db0691d72a72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8f85845208da54ee8798a5183e7ad04, https://si.imgix.net/1f1b0d66/uploads/origins/3aaf8260-6b96-4adf-a23b-db0691d72a72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe6bfd4e70c9673d6f31a543186a615e 2x, https://si.imgix.net/1f1b0d66/uploads/origins/3aaf8260-6b96-4adf-a23b-db0691d72a72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6ebbed67b1b659121699de11de1fa25 3x"}, "body": "ハバ様、初めまして。『BLACK NEST』の制作を、こっそり応援しています。\n私も、ミリタリージャケットネタをリクエストしたいです！ロゥ君にも、ミリタリージャケットを着せたイラストをお願いしたいです！このロゥ君は、素晴らしいです！\nhttps://skeb.jp/@eremiro/works/7\nそして、下半身の方はネメアのと同じジーンズとブーツでお願いします。ロングブーツ姿の男の子を見たいです！（最近描かれたこのネメアも良いですね！）\nhttps://skeb.jp/@eremiro/works/11\n\n前回のロゥ君との違いとして、正面向きの笑顔でこちらを向いてください。\n前回と同じ様な明るく元気な笑顔で良いのですが、お口は前回よりも小さめに開いて、でも八重歯は見えるようにお願いします。\n両手を腰に当てたポーズで、両手が見えるよう（もちろん黒手袋付けて！）にして欲しいです。\n今までのミリタリージャケットのイラストでは、片腕にだけワッペンが付いていましたが、今回は両腕に付けて欲しいです。同じデザインで構いません。\n\nそして、可能であれば、ワッペンの有り・無し差分をお願いしたいです。\n表情も、上記の笑顔以外も見てみたいです。無表情などでしょうか。こちらは、無理しなくても大丈夫です。\n\n前回の～という表現を何度か使いましたが、前回のロゥ君は本当に素晴らしかったので、ミリタリージャケットのロゥ君も楽しみです！少年らしさとカッコ良さが存分に発揮されると思います！\nご縁がありましたら、よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eremiro/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2439287, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b5ba24e/uploads/origins/db565106-5cff-40a3-b132-1cd1c56b25ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7612e9a785ede3db491540ba996aaab6", "srcset": "https://si.imgix.net/9b5ba24e/uploads/origins/db565106-5cff-40a3-b132-1cd1c56b25ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7612e9a785ede3db491540ba996aaab6, https://si.imgix.net/9b5ba24e/uploads/origins/db565106-5cff-40a3-b132-1cd1c56b25ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b4f6cf5c53648ca2724f9eb4fbdda87 2x, https://si.imgix.net/9b5ba24e/uploads/origins/db565106-5cff-40a3-b132-1cd1c56b25ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9623aede4ab838f6c017122bd74885bc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b5ba24e/uploads/origins/db565106-5cff-40a3-b132-1cd1c56b25ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=618be7e8c97cb4c118d0145fd8121b67", "srcset": "https://si.imgix.net/9b5ba24e/uploads/origins/db565106-5cff-40a3-b132-1cd1c56b25ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=618be7e8c97cb4c118d0145fd8121b67, https://si.imgix.net/9b5ba24e/uploads/origins/db565106-5cff-40a3-b132-1cd1c56b25ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fc093d3918e47de1107a18def2b164ca 2x, https://si.imgix.net/9b5ba24e/uploads/origins/db565106-5cff-40a3-b132-1cd1c56b25ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5e9277733e49b5f86c5ed92d65e6ad06 3x"}, "body": "ハバ様のBLACKNESTのネメアにも、ミリタリージャケット姿のイラストをお願いします。\nこの時のミロの様なポーズで、こちらを向いてもらいたいです。\nhttps://www.pixiv.net/artworks/119964220\n\n下半身の方のズボンは、コハクの時の様な普通のジーンズとロングブーツでお願いします。\nhttps://skeb.jp/@eremiro/works/1\n\n表情差分も可能でしたら、お願いします。クールな表情と微笑（見てみたい！）です。現代服なので、ネメアの兜は無しですね。\n（クールな表情に関しては、ゲーム画面のＨＰ１００％の表情の様な感じです。）\n今回は顔と髪がちゃんと見えるように、手などで顔を隠さないようにお願いします。（ミロと同じ様なポーズなので、問題ないと思います。）\n\nミリタリージャケットのネタは4度目になるのでしょうか。同じネタばかりですが、ご一考いただけますと幸いです。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eremiro/w