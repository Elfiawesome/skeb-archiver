imgs/e/a/ea730b6b.jpg\n\nhttps://imgur.com/04vTKZ8", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eremiro/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2439287, "client_id": 2591057, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c4a3939/uploads/origins/f07930f5-ab8a-457d-8c31-7afc93a263e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9748c78b13b5314a069ca6decd384c28", "srcset": "https://si.imgix.net/3c4a3939/uploads/origins/f07930f5-ab8a-457d-8c31-7afc93a263e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9748c78b13b5314a069ca6decd384c28, https://si.imgix.net/3c4a3939/uploads/origins/f07930f5-ab8a-457d-8c31-7afc93a263e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47605aed5550a461ba37b20896c38622 2x, https://si.imgix.net/3c4a3939/uploads/origins/f07930f5-ab8a-457d-8c31-7afc93a263e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f9f1d89e20367f1db4f7652095ee31b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c4a3939/uploads/origins/f07930f5-ab8a-457d-8c31-7afc93a263e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=721dd346659bfdd2a1994b8bbbdddd51", "srcset": "https://si.imgix.net/3c4a3939/uploads/origins/f07930f5-ab8a-457d-8c31-7afc93a263e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=721dd346659bfdd2a1994b8bbbdddd51, https://si.imgix.net/3c4a3939/uploads/origins/f07930f5-ab8a-457d-8c31-7afc93a263e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=78019788912bffb35858000ff35e6b20 2x, https://si.imgix.net/3c4a3939/uploads/origins/f07930f5-ab8a-457d-8c31-7afc93a263e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ef3667ac59b16af905121e14f0f62191 3x"}, "body": "今回は、イブキの水着姿をリクエストします。\n「DOAXVV」というゲームに「ワイルドウインド」という、黒のレザージャケットの水着があります。資料のURLです。\nhttps://doaxvv.blog.jp/archives/15266258.html\nこんな感じの水着を、イブキに着せてみて欲しいです。\n左腕に赤いバラのマークがありますが、これは不要です。背景もなしで大丈夫です。\nイブキらしい、明るく元気な表情をした水着姿を見たいです。\n\nhttps://doaxvv.blog.jp/archives/15266258.html", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eremiro/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2439287, "client_id": 2591057, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b559bf9a/uploads/origins/5ad9b4b8-8f58-4309-bb9b-1d4c74c52086?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=986279c54458cf22d9be37c140acc161", "srcset": "https://si.imgix.net/b559bf9a/uploads/origins/5ad9b4b8-8f58-4309-bb9b-1d4c74c52086?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=986279c54458cf22d9be37c140acc161, https://si.imgix.net/b559bf9a/uploads/origins/5ad9b4b8-8f58-4309-bb9b-1d4c74c52086?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbac88b8df4ed467953fc048d5b5bf8d 2x, https://si.imgix.net/b559bf9a/uploads/origins/5ad9b4b8-8f58-4309-bb9b-1d4c74c52086?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1bb7162356ff178cef39bb89d52faea5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b559bf9a/uploads/origins/5ad9b4b8-8f58-4309-bb9b-1d4c74c52086?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7cb64cec1738f1d5ef9557c1836cf62", "srcset": "https://si.imgix.net/b559bf9a/uploads/origins/5ad9b4b8-8f58-4309-bb9b-1d4c74c52086?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7cb64cec1738f1d5ef9557c1836cf62, https://si.imgix.net/b559bf9a/uploads/origins/5ad9b4b8-8f58-4309-bb9b-1d4c74c52086?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb3ada721d92a968aa28a65db5ba5a52 2x, https://si.imgix.net/b559bf9a/uploads/origins/5ad9b4b8-8f58-4309-bb9b-1d4c74c52086?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c0c22fff7eb3faec87edb3a134264c0f 3x"}, "body": "前回はリクエストを受けていただき、ありがとうございました！\nコハクのイラストが素晴らしかったです！\n物理攻撃だけでなく魔法攻撃もはね返しそうな位、強そうでカッコ良かったです！\nさて今回は、茶色のミリタリージャケットを着たレンリーの立ち絵をリクエストします。\n背景は不要です。参考資料のURLを貼ります。\nhttps://zozo.jp/shop/avirexbelle/goods/6815701/?did=19023222&rid=1019 \nこんな感じのブカブカしていて、襟元がファー（毛糸）になっていて、\nポケットやワッペンが付いたコテコテな衣装をレンリーに着せて、\nちょっとだけドヤ顔（自信あり気な表情）をして欲しいです。\n（彼女のキャラクターが、まだ良く分からないのですが、中々のくせ者だと思いました。プレイして好きになりました！）\n何かワッペンがたくさんついていますが、少しで（無くても）大丈夫です。\n下シャツを見せるよりも、ジャケットのチャックを上げてくれた方が良いです。\nURLの画像だと、2枚目の様な状態が良いですね。\n下半身も、ズボンとロングブーツで良いと思います。\n私の趣味丸出しで、前回のイラストと同じような感じもして、申し訳ないのですが…。\nもしよろしければ、お願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eremiro/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2439287, "client_id": 2591057, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e8e7c32/uploads/origins/fac7a48e-1d18-42e1-afff-d3d799e8a12b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ee8d6f1951434a811e8b18a2f073bd3", "srcset": "https://si.imgix.net/9e8e7c32/uploads/origins/fac7a48e-1d18-42e1-afff-d3d799e8a12b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ee8d6f1951434a811e8b18a2f073bd3, https://si.imgix.net/9e8e7c32/uploads/origins/fac7a48e-1d18-42e1-afff-d3d799e8a12b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24a0e3b097ce6bfe841ea2341622f1f0 2x, https://si.imgix.net/9e8e7c32/uploads/origins/fac7a48e-1d18-42e1-afff-d3d799e8a12b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f83bcf1709aecee404cc575b388c1d98 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e8e7c32/uploads/origins/fac7a48e-1d18-42e1-afff-d3d799e8a12b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2063643ec109efa22a062f27f671227", "srcset": "https://si.imgix.net/9e8e7c32/uploads/origins/fac7a48e-1d18-42e1-afff-d3d799e8a12b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2063643ec109efa22a062f27f671227, https://si.imgix.net/9e8e7c32/uploads/origins/fac7a48e-1d18-42e1-afff-d3d799e8a12b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=85f3b7059782c16c945fc2947a6d158b 2x, https://si.imgix.net/9e8e7c32/uploads/origins/fac7a48e-1d18-42e1-afff-d3d799e8a12b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5128bb7e0ff9d13dec86234d9bea6985 3x"}, "body": "初めまして。BLACK NEST、楽しくプレイさせてもらいました。\n7章以降も楽しみに待っています！\nさて、私はアーマーナイトのコハクが気に入ったので、彼女の私服姿をリクエストします！\n（支援会話で、鎧姿で盾を持ちながら、アズちゃんとプリンの話をするのも何なので…。）\n服装は、黒のレザージャケット（革ジャンやライダースジャケットとも言いますね）です。\nよく白いシャツの上に羽織っている、あの黒いツヤツヤの衣装です。\n表情もキリっとしたカッコいい感じの立ち姿でお願いします。\n下半身は、スカートよりもズボン系の方が似合うと思います。\nレザージャケットを着たカッコ可愛い女の子は、私の完全な趣味です。\nコハクに似合うかは分かりませんが、もし宜しければ、お願いいたします！\n（実はこの前のリンとメヴァのイラストがカッコ良かったので、リンでお願いしようかと迷ったのは秘密です…）", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 63201, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ひーりんまる", "screen_name": "HEALING00", "avatar_url": "https://pbs.twimg.com/profile_images/1530434440844890112/Y57TPznL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/315481202/1743685898/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "compl