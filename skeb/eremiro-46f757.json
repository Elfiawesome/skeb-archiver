f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1351adcec721d38b694df6c9f2a070a, https://si.imgix.net/8664d790/uploads/origins/0706249c-7a54-422e-8a43-63b003fc6d45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=beec82d18beb49d56647f8b4c5b09e4f 2x, https://si.imgix.net/8664d790/uploads/origins/0706249c-7a54-422e-8a43-63b003fc6d45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9cf3464d2e5be783f6364794d15da449 3x"}, "body": "「BLACK NEST」のアカネ様に、真っ赤なボディスーツを着せたイラストをお願いします。セクシーなスパイ！？表情は、ゲーム内の立ち絵の様な通常の微笑みでお願いします。\n\n私はSRPGの他に格闘ゲームも好きなのですが、女性キャラはボディスーツのコスチュームが多いので、これらのURLの画像も参考にしていただければと思います。色やパーツも、アカネ様に合うように自由にデザインしてください。お任せします！\n\nhttps://www.deviantart.com/lorisc93/art/TK7-Nina-Williams-Leather-Outfit-689194651\nhttps://www.deviantart.com/momijihayabusa/art/Nyotengu-38-483700279\n\nご検討宜しくお願いいたします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eremiro/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2439287, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c9ddef39/uploads/origins/8b0295d5-57fe-4a05-8d4a-23fb5fe1124d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b31dd8ea414dfb9b2649d3c31445d23", "srcset": "https://si.imgix.net/c9ddef39/uploads/origins/8b0295d5-57fe-4a05-8d4a-23fb5fe1124d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b31dd8ea414dfb9b2649d3c31445d23, https://si.imgix.net/c9ddef39/uploads/origins/8b0295d5-57fe-4a05-8d4a-23fb5fe1124d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c2af8f2ba5dc72f841f0633295bd32f 2x, https://si.imgix.net/c9ddef39/uploads/origins/8b0295d5-57fe-4a05-8d4a-23fb5fe1124d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bda7cfa6666a167eaed7521e80297cc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c9ddef39/uploads/origins/8b0295d5-57fe-4a05-8d4a-23fb5fe1124d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ea30922fa234053df0d3eb3f46664b4", "srcset": "https://si.imgix.net/c9ddef39/uploads/origins/8b0295d5-57fe-4a05-8d4a-23fb5fe1124d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ea30922fa234053df0d3eb3f46664b4, https://si.imgix.net/c9ddef39/uploads/origins/8b0295d5-57fe-4a05-8d4a-23fb5fe1124d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=abe5d995fa2c10596a030f24326f057f 2x, https://si.imgix.net/c9ddef39/uploads/origins/8b0295d5-57fe-4a05-8d4a-23fb5fe1124d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=003a1394e5548876b8cbdd4ac3d84a5d 3x"}, "body": "先月エレのミリタリージャケットのイラストをリクエストした者です。前回はありがとうございました。\nそしてPIXIVリクエストの方の制作も、お疲れ様でした。2枚とも素敵なイラストでした。\nPIXIVリクエストで東方キャラプランを始めたそうですが、私はSKEBでBLACKNESTのリクエストを送ります。\n（東方のリクエストも、何か思いついたらリクエストするかもしれません。その時はよろしくお願い致します。）\n\nさて今回は　・ロゥ君に　・パーカーと　・黒いレザージャケットを着せて　・こちらを向いて笑顔のイラスト　をリクエストします。\n男性キャラのリクエストは初めてかもしれませんが、是非描いて頂きたいです。\n\n男の子と言えば、やはりパーカーですね。そこに黒のレザージャケットを着ると、カッコ良くなると思います。\nhttps://store.hpplus.jp/fs/shop/g/gR06UGG/\n参考のURLです。あくまでも参考画像なので、ロゥ君に合う様に、ジャケットやパーカーのデザイン、色やズボンなど自由に調整して頂きたいです。\n\nhttps://ci-en.net/creator/9155/article/673218\nそして、CIENのこの記事にある4章初登場時のロゥ君のような感じ（体格・雰囲気など）で、笑顔でお願いします。\n\nパーカーに黒いレザージャケット、というコーディネートは、ハバ様が他の方のリクエストで何度か描かれていますね。\n似たような服装のリクエストで申し訳ないのですが、だからこそ男の子のロゥ君でも、描いて欲しいです。\n\n以上です、今回もよろしくお願い致します。\n\nhttps://store.hpplus.jp/fs/shop/g/gR06UGG/", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eremiro/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/34f96e59/uploads/origins/0b0a2b5d-dc40-4804-a67a-738c4e33be9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200