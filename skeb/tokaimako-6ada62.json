316-2fb8-4fe3-87af-50c925f6efbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd3a6748bf7d4c72bdaf79d30a90a2e2, https://si.imgix.net/1b71f291/uploads/origins/b6f6c316-2fb8-4fe3-87af-50c925f6efbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3dbfe9a028a74c73a37c76bab7f09b64 2x, https://si.imgix.net/1b71f291/uploads/origins/b6f6c316-2fb8-4fe3-87af-50c925f6efbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fccd1fc529be27e6e18453fbf6987e3e 3x"}, "body": "よろしければアイドルマスターシンデレラガールズの長富蓮実さん、衛藤美紗希さん、相馬夏美さんの三人のイラストをお願いできないでしょうか。\n衣装はそれぞれ廻る季節と乙女心、明日のあたしにかける魔法、フルーティー・ポップの特訓後でお願いしたいです。\n構図等は基本的にお任せで問題ありませんが、華やかな雰囲気にまとめていただけると地に伏して感謝に打ち震えます。\n\n何卒ご検討のほど、よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tokaimako/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2914490, "client_id": 1469904, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21b0eadd/uploads/origins/ec3f5fe3-6a3a-4898-ab2d-221c3a18442b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9c65caf56da6361771f861329f31a99", "srcset": "https://si.imgix.net/21b0eadd/uploads/origins/ec3f5fe3-6a3a-4898-ab2d-221c3a18442b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9c65caf56da6361771f861329f31a99, https://si.imgix.net/21b0eadd/uploads/origins/ec3f5fe3-6a3a-4898-ab2d-221c3a18442b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2907b3e177cc2409b57df31a60a728e2 2x, https://si.imgix.net/21b0eadd/uploads/origins/ec3f5fe3-6a3a-4898-ab2d-221c3a18442b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a36ef2242a69cd2fda1ce5392cd12a52 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21b0eadd/uploads/origins/ec3f5fe3-6a3a-4898-ab2d-221c3a18442b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db70b32703760f23a7b1e5bf7286ae1c", "srcset": "https://si.imgix.net/21b0eadd/uploads/origins/ec3f5fe3-6a3a-4898-ab2d-221c3a18442b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db70b32703760f23a7b1e5bf7286ae1c, https://si.imgix.net/21b0eadd/uploads/origins/ec3f5fe3-6a3a-4898-ab2d-221c3a18442b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9bf53f4f0e4c741305c29e736dd7c324 2x, https://si.imgix.net/21b0eadd/uploads/origins/ec3f5fe3-6a3a-4898-ab2d-221c3a18442b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=54e1a2617241d3db9a7cca34c0580899 3x"}, "body": "渡海まこ様\n\nこんにちは。\n先日はデレマスの相葉夕美と高森藍子の絵をありがとうございました。\n\n今回も相葉夕美と高森藍子の絵をお願いします。\n\n【内容】\n([ひみつの森のマイネ・リーベ]高森藍子＋の世界観が基になっています)\n執事の夕美と令嬢の藍子が、藍子の住んでいる屋敷を抜けだしてデートしている絵をお願いします。\n\n・夕美の服装：黒を基調とした執事服で、白手袋(縫い目と、手の甲に三本線がある)を着用。\n・藍子の服装：「[ひみつの森のマイネ・リーベ]高森藍子＋」\n(https://imas.gamedbs.jp/cg/idol/detail/133?h=imcgss-c3838)\n(https://imas.gamedbs.jp/cgss/card/detail/3837/3838)\n\n【設定(※個人的な妄想)】\n藍子は森の屋敷の令嬢であり、屋敷から出ることを許されていなかった。\n\n藍子の住んでいる屋敷に新たに夕美が執事として雇われた。\nその執事は、藍子が昔ピクニックをしているときに出会い、惚れた人物と同一人物だった。\nある日、夕美は「外の世界に出かけよう」と藍子に言い、他の使用人には内緒で2人で屋敷を出た。そして、屋敷の外で2人きりで、誰にも邪魔されない幸せな時間を過ごす。\n\n\nお忙しいところ恐縮ですが、ご検討の程よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tokaimako/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2914490, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c33d5ccd/uploads/origins/6fb50bfe-666b-40e6-a83f-30574d66b025?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3df03b6087647eea6bde1d9645bb8406", "srcset": "https://si.imgix.net/c33d5ccd/uploads/origins/6fb50bfe-666b-40e6-a83f-30574d66b025?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3df03b6087647eea6bde1d9645bb8406, https://si.imgix.net/c33d5ccd/uploads/origins/6fb50bfe-666b-40e6-a83f-30574d66b025?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=806b324bfb8fcfd46d5acd98ca40809e 2x, https://si.imgix.net/c33d5ccd/uploads/origins/6fb50bfe-666b-40e6-a83f-30574d66b025?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44377c70226472f34f045afbc81a6f65 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c33d5ccd/uploads/origins/6fb50bfe-666b-40e6-a83f-30574d66b025?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6488cea7e7465bd25305eccff124f647", "srcset": "https://si.imgix.net/c33d5ccd/uploads/origins/6fb50bfe-666b-40e6-a83f-30574d66b025?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6488cea7e7465bd25305eccff124f647, https://si.imgix.net/c33d5ccd/uploads/origins/6fb50bfe-666b-40e6-a83f-30574d66b025?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=56cc6885419b1c1b4684dee99b2bd13f 2x, https://si.imgix.net/c33d5ccd/uploads/origins/6fb50bfe-666b-40e6-a83f-30574d66b025?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2e58f6c2afc660d8e0ba0c888c528166 3x"}, "body": "大胆なコーデに挑戦しようと、事務所におへそが見える短い丈の黒の襟付きノースリーブに超ミニスカ、生脚で膝下丈の黒ハイソックスを合わせたコーデの小日向美穂ちゃんを全身でお願いします。 \n\n指定としては\n・ノースリーブは肩を完全に出し、袖にフリルとかがないシンプルなデザインで、襟はブラウスかポロシャツのような感じで、着丈はおへそが見える丈でお願いします。\n・スカートはフレアかプリーツスカートで裾が広がるデザインのもの、丈は少しでも動いたら危ないくらいのギリギリの超ミニ丈で、ウエストはおへそが見える低い丈でお願いします。スカートの柄は単色のシンプルなデザインでも大丈夫です。色は濃い目のえんじ色でお願いします。\n・スパッツやインナー等の描写は無しでお願いします。\n・ハイソックスの丈はラブレターの制服衣装くらいの膝下を完全に覆う丈で、黒一色で透けないシンプルなデザイン。\n・靴は黒でローファーかヒールが高めのパンプス。それ以外の靴でも良いですが、ブーツなど足首以上の長めの丈のものは避けてください。\n・構図ですが、アングルは正面からで、ポーズは立った状態で両手は後ろに、「プロデューサーさん、どうでしょうか？」と笑顔で顔を赤め少し照れた表情で、両足を揃えて少し内股にし、膝とふとももを中央に寄せ、美脚なふとももをアピールする感じでお願いします。\n・ガーターリング等ふとももの装具はなしでお願いします。\n・脚は美脚で長めで、脚全体、特にふとももが映える感じでお願いしたいです。ふとももはむっちりではなく、すらりとした美脚でお願いしたいです。\n・背景はなしか単色といったシンプルなもので大丈夫です。\n\n指定が多く恐縮ですが検討していただけると幸いです。よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tokaimako/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2914490, "client_id": 313223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/370b1f46/uploads/origins/e4bc3bfd-ebf1-4a44-9362-7e9be7306a10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a1a10b1774a80971bc2386c23eb31e6", "srcset": "https://si.imgix.net/370b1f46/uploads/origins/e4bc3bfd-ebf1-4a44-9362-7e9be7306a10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a1a10b1774a80971bc2386c23eb31e6, https://si.imgix.net/370b1f46/uploads/origins/e4bc3bfd-ebf1-4a44-9362-7e9be7306a10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa738dfa49e1bc493ae7e90ebbc7526b 2x, https://si.imgix.net/370b1f46/uploads/origins/e4bc3bfd-ebf1-4a44-9362-7e9be7306a10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d783f9e566908a57c4ebb204431c202b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/370b1f46/uploads/origins/e4bc3bfd-ebf1-4a44-9362-7e9be7306a10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d14b43a85e2c89c4fe52f17038f2f28", "srcset": "https://si.imgix.net/370b1f46/uploads/origins/e4bc3bfd-ebf1-4a44-9362-7e9be7306a10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d14b43a85e2c89c4fe52f17038f2f28, https://si.imgix.net/370b1f46/uploads/origins/e4bc3bfd-ebf1-4a44-9362-7e9be7306a10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e3c7d4d489b29371f82a7df5a1410f4f 2x, https://si.imgix