裕があれば信楽くろがねの私服系のイラストを1枚描いて頂けないでしょうか。\n\n服は可能ならば自由に描いて頂くか、資料のクリスマスラッピング等でお願いしたいです。構図はお任せで、全身像に拘らず自由にお願いしたいです。デジタルか万年筆絵かはその時の気分でお任せします。でんこの方に重点を置き、背景はごく軽くまたは無しでも大丈夫です。\n\n元気なキャラクタですが、設定文に少し背伸びしたい感じの時もある様子が見られるので、今回は気持ちお洒落な雰囲気だと嬉しいです。が、おくらさんの画風自体とてもお洒落なので、多分手なりで自然に描いて頂ければそれで大丈夫です。\n\nもし引き受けて頂ける場合でも、決して無理はなさらず、楽しく描ける範囲でお願いしたいです。\n\n以上、宜しくご検討ください。\n\nhttps://x.com/vgloTDcrhxRn5B2/status/1981443499074736475?t=saUZNflWF4-t7gKWTL0zfA&s=19", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@S_amphi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1421986, "client_id": 1087255, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6f8ced9/uploads/origins/53be8c68-cac9-45b3-a5bc-e9f5e0821a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9287f6e6a29a71902c6a65d63df1aa9d", "srcset": "https://si.imgix.net/f6f8ced9/uploads/origins/53be8c68-cac9-45b3-a5bc-e9f5e0821a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9287f6e6a29a71902c6a65d63df1aa9d, https://si.imgix.net/f6f8ced9/uploads/origins/53be8c68-cac9-45b3-a5bc-e9f5e0821a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8c1818ffa6e95062a93ae37b30cd7e6 2x, https://si.imgix.net/f6f8ced9/uploads/origins/53be8c68-cac9-45b3-a5bc-e9f5e0821a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89bd6b14388b32fe0aecdc8b84dadbb2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f6f8ced9/uploads/origins/53be8c68-cac9-45b3-a5bc-e9f5e0821a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=820663708b1d6bf0754e704e4e34bc54", "srcset": "https://si.imgix.net/f6f8ced9/uploads/origins/53be8c68-cac9-45b3-a5bc-e9f5e0821a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200