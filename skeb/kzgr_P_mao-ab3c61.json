『ダークストーカーズ』のモリガンのコスプレをしているはずです。優子の髪の毛は元の紫色であること。優子は怒ったような、照れたような表情をしていること。優子は、腕で自分を覆い隠そうとしているはずである。まりもは、優子の隣に立っているはずである。まりもは大きな声で笑っている。イラストは、夢幻の雲のような枠で囲む。右下には、ちびまる子のまりもがいる。あごをなでたり、いたずらっぽい表情をしているまりも。\n\nご検討のほど、よろしくお願いいたします。\n\nまりも： https://imgur.com/a/vGXOo4U\nゆうこ： https://imgur.com/a/smvrVNN", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kzgr_P_mao/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 17068, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7cdf32eb/uploads/origins/b902603c-4a39-4ae7-ab8e-20834812638c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8354abe0c4f747811183bcd37e624755", "srcset": "https://si.imgix.net/7cdf32eb/uploads/origins/b902603c-4a39-4ae7-ab8e-20834812638c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8354abe0c4f747811183bcd37e624755, https://si.imgix.net/7cdf32eb/uploads/origins/b902603c-4a39-4ae7-ab8e-20834812638c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2f624dd8f6fd121461480f1ccb836f5 2x, https://si.imgix.net/7cdf32eb/uploads/origins/b902603c-4a39-4ae7-ab8e-20834812638c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0361579fb8d9bccb83ad803848116002 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7cdf32eb/uploads/origins/b902603c-4a39-4ae7-ab8e-20834812638c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9169ab414c764b384b73b7b5256b4c59", "srcset": "https://si.imgix.net/7cdf32eb/uploads/origins/b902603c-4a39-4ae7-ab8e-20834812638c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9169ab414c764b384b73b7b5256b4c59, https://si.imgix.net/7cdf32eb/uploads/origins/b902603c-4a39-4ae7-ab8e-20834812638c?bg=%23fff&auto=format%2Ccompress&fm=webp&dp