com/drive/folders/12xh5wr0pSGU1Mh9qjzZ1NvthQPD2G7_P\n\n具体的なポーズや背景などは先生にお任せします！PCの壁紙に使用したいと考えているので、横長の絵にして頂けると嬉しいです。\nすべての要求に答えるのが難しいようであれば、先生のお好きなように描いて大丈夫です。\n\nどうぞよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@peppermint_jet/works/37", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/90dd9352/uploads/origins/f3a8a410-3b95-44b9-85b2-58e1478955bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ce9d08358a064eeb46534dfffe599d4", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 802538, "client_id": 1227592, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@peppermint_jet/works/36", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 802538, "client_id": 1336233, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20904a0c/uploads/origins/a74d9670-fc1b-4e83-9a2e-7dc348cb4b55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc071dbee11843018f3c954b77051a1e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20904a0c/uploads/origins/a74d9670-fc1b-4e83-9a2e-7dc348cb4b55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c916ba54231ddeea387d8e5babee7dd3", "src_set": ""}, "body": "こんにちは、ペパーミント・ジェットさん\n\nあなたの作品が大好きです！私のOCは恋人同士です。\n\nアネカ：地雷系の女の子。いつも孤独を感じている。好きな飲み物はオートミルクラテ。訂正されるのが嫌い。身長は160cmくらい。彼女と一緒にウサギを描いてください。頭の角と羽が特徴です。\n\n名前のない「女の子」：ストーカー気質でマスクが好き。JKの制服を着ていると安心する。とても怠け者で、お酒を持ち込むのが大好き。[ヤンデレ系]好きな人と一緒にいたい女の子。身長は169-170cmくらい。ランドセルとマスクはお好みで。\n\n痛いほど恋をしている二人。お好きなように描いてください。\n\nありがとうございました！\n\nhttps://imgur.com/a/etGhXyp", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@peppermint_jet/works/35", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 802538, "client_id": 1746351, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c82852b/uploads/origins/181ea31f-0df6-4936-9a9c-416bf955383a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=775d192f9bdcfc1bbe5681ce90287ebe", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c82852b/uploads/origins/181ea31f-0df6-4936-9a9c-416bf955383a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e09cbf8d35c427f6a6c9fa42c33193f0", "src_set": ""}, "body": "peppermint jetさん、初めまして！peppermint jetさんの作品がとても好きです！\n今回はキャラクター二人のイラストを一枚お願いしたいです。キャラクター紹介と参考は下記内容に纏めました。もしキャラ衣装の細かいところが見づらい場合、ディテールを省略しても、そこを自由に描いても大丈夫です。\nhttps://imgur.com/a/wDKcd3b\nhttps://imgur.com/a/YoesuoU\n\nキャラクター紹介：\n白髪の方のキャラ：攻め（黒い瞳、身長180cm）。クールで男前、やや孤独で自由を愛する。高い戦闘能力を持つ武人。二本の刀を武器として使い、戦闘中は狂気的な一面を見せる。懐中時計が化けた妖怪である。酒を飲む事と月が好き。\n青髪の方のキャラ：受け（淡い灰色の瞳、身長179cm）。優しくて穏やかな性格で、たまに人をからかったりする。やや理想主義である。戦術について造詣が高い軍師。羅針盤が化けた妖怪で、未来を予知する能力がある。趣味は品茶、文章を書くことと通りすがりの子供に飴をあげること。願いはぐっすり眠れること。\n\n二人が一緒にいるときの雰囲気：\n１．気持ちが通じて、相手に対して並外れた理解を持ち、十分な敬意を保っているが、どちらも相手ともっと深い関係になりたがる。\n２．彼らが無意識に相手に近寄る感じと、同じ目標に向かって励む姿を見るのが好きです。\n二人の関係は、甘いカップルというよりは、気の置けない兄弟、あるいは結婚して何年も経った歳がとった伴侶に近いです。\n\nイラストの内容はお任せいたします！\nよろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@peppermint_jet/works/34", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a5249908/uploads/origins/7bbc8c8a-a37b-4995-b37d-8b37555b34a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccente