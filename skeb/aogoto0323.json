_guidelines/\n\nご検討のほど、よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1hIDYIRsm6K5cIbcQ9rWT7KqcIIb4G4gO?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aogoto0323/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3532034, "client_id": 2645931, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a001a71f/uploads/origins/806b823c-6fd3-46d5-b9a2-0ede93c7fc27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88575136674ae0056e60ad20871d28ed", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a001a71f/uploads/origins/806b823c-6fd3-46d5-b9a2-0ede93c7fc27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a076f5d6758bbc75972d95ef5441814", "src_set": ""}, "body": "こんにちは！\nあなたのツイッターとpixivのアートを見ました！ぜひ注文したいです :3\n私のOCを描いていただけませんか？エレガントでキュートなものが大好きな、フェミニンなキャットボーイ・ヴァンパイアです。ちょっとおバカでおちゃめで、フェミニンな服を着るのももう怖くない。\n私のキャラクターを毛皮にしたバージョンをぜひ見てみたい。もちろん、彼は男性的というより女性的に見えることもある。\n\n彼の将来の服装はこんな感じになるけど、もっとダークな感じになる。https://drive.google.com/file/d/1IAeCbuXVwqyWUj5QkRczZqLMUiSIv59N/view?usp=drivesdk\nしかし、あなたが好きな服装で彼を描くのは自由です。\n\nかわいい感じで描いてほしいですね。自由に解釈してください。\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1PXI3Hm8saWaoQpcAmBbQ82ESOn3kJfyW", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 158006, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "やのらいむ", "screen_name": "YNrim", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fwebpublic-c2244152-3091-41c1-ae67-9883160a6489.png?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/webpublic-f45b3f48-a32a-4c99-826d-543935cf910e.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank":