b767547ffca55494c", "skills": [{"genre": "art", "default_amount": 4000}, {"genre": "correction", "default_amount": 3000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@Pin_of_necktie/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1176101, "client_id": 515379, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae02a27c/uploads/origins/f2acc858-ae4f-40b7-8737-0fa4ffbb4651?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=513d3c5d15b9f99868e5255aa4aac203", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae02a27c/uploads/origins/f2acc858-ae4f-40b7-8737-0fa4ffbb4651?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6169fa695a92443ec75e21757cd8d0bc", "src_set": ""}, "body": "こんにちは！　すなじろと申します。\nねくぴんさんのイラスト、いつも楽しみにしております！\n最近描かれていたファンタジーモチーフのキャラクターデザインとポーズがすごく好みだったので、もしよろしければそちらをモチーフにしてうちの子を描いていただけないでしょうか？\n\n今回お願いするうちの子は名前をノラちゃんと言います。\n狐をモチーフとした、ケモミミとしっぽのある10代半ばの女の子です。\n癖のあるボブぐらいの長さの金髪で、けだるそうでジトっとした青い目に、八重歯のちらりと見える笑顔がよく似合う子です。\nおでこにひっかけた青い眼鏡がトレードマークです。\n\n前述のとおり、よろしければ今回は剣と魔法のファンタジー世界に出てくるような服装にアレンジしてノラちゃんをお願いしたいです。\n職業や持たせる武器等、おまかせでお願いできればと思いますが、小柄なキャラが大きな武器を構えているのが好きなので、大きめな武器をぜひ持たせていただけたらと思います！\nポーズも躍動感のあるものだと嬉しいですが、キャラのイメージやモチーフに合うかどうかがわからないのでお任せします。\n楽しく描いていただければ幸いです！\n\nその他の事項、構図、表情、背景の有無、イラストサイズなどについては何でも構いません。\n納品形式もお任せします。\n\n資料が過去のSkebリクエストのみとなることをご容赦ください。\n頂いたイラストは、私の所有するSNS等のアカウントにてアイコン・ヘッダーとして使用することがあります。\nよろしくお願いします！\n\nhttps://skeb.jp/@sunajiro8", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pin_of_necktie/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1176101, "client_id": 532093, "vtt_url": null, "thumbnail_