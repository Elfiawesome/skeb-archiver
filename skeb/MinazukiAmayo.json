トさせていただきました。\n\n可能でしたら他の配信者の方と私の2人を描いていただけないでしょうか？\n\n構図・ポーズはすべてお任せします。\n出来れば髪や顔が等が切れないように描いていただけると助かります。\n各々がSNSや配信用のサムネイルで使用する場合がございますので人物（と背景ももしございましたら分けたもの）をファイル形式をPSDでいただけますと有り難いです。\n\n可能でしたらよろしくお願いします。\n\n①甘杖リトリー\nhttps://x.com/amatsue_littley/status/1720688572150559140?s=20\n\n②Lieuka-リューカ-\nhttps://drive.google.com/file/d/1cMxw-Dz3ADglWDGiaeAdevCobRIZvaQG/view?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MinazukiAmayo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3815391, "client_id": 3388645, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e95fe90e/uploads/origins/478ffd12-c342-4738-9348-2a4535b5b44d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa6604dba4cbc841153c7d43baf2b475", "srcset": "https://si.imgix.net/e95fe90e/uploads/origins/478ffd12-c342-4738-9348-2a4535b5b44d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa6604dba4cbc841153c7d43baf2b475, https://si.imgix.net/e95fe90e/uploads/origins/478ffd12-c342-4738-9348-2a4535b5b44d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac71bf2dbe75d9100664539d5c61e7a2 2x, https://si.imgix.net/e95fe90e/uploads/origins/478ffd12-c342-4738-9348-2a4535b5b44d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3afb4830d53ee5232fd5a8988f63882a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e95fe90e/uploads/origins/478ffd12-c342-4738-9348-2a4535b5b44d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9badad1f9993eec4092c27f9e1eac82b", "srcset": "https://si.imgix.net/e95fe90e/uploads/origins/478ffd12-c342-4738-9348-2a4535b5b44d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9badad1f9993eec4092c27f9e1eac82b, https://s