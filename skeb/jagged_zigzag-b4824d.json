ざいますが\nワタクシは自身の音声ライブラリや動画を用いて活動している者です。\n\nもしもpicdoさんが宜しければ\n頂いた音源での動画制作もできればと考えております。\nその際はお名前やYouTube・TwitterのURLなどのクレジット記載をさせて頂きます。\n\nご依頼内容に失礼がないか……\nメッセージを送らせて頂くだけでも大変恐縮でドキドキではございますが、\nご検討の程、何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/u/0/folders/1zPgs1POgaLyEaKq53ld5O5xSGGh5m-PD", "nc": 129, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@jagged_zigzag/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/441fff76/uploads/origins/10a08141-abfd-4831-9777-089d518d1591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=24c70035a37af7e58c3d3593e1722886", "srcset": "https://si.imgix.net/441fff76/uploads/origins/10a08141-abfd-4831-9777-089d518d1591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=24c70035a37af7e58c3d3593e1722886, https://si.imgix.net/441fff76/uploads/origins/10a08141-abfd-4831-9777-089d518d1591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d5d6937f66d84771b836316294a2342 2x, https://si.imgix.net/441fff76/uploads/origins/10a08141-abfd-4831-9777-089d518d1591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cec6e6f9dc9de4817b362bef5796e44c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1790407, "client_id": 796382, "nc": 0}, {"path": "/@jagged_zigzag/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1790407, "client_id": 725539, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38352060/uploads/origins/0f4b9f