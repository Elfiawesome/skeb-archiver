待ち望んでいる。\n\n・シチュ希望\n長女ということでいつも以上に容赦なく、巨人型モンスターのデカマラと触手による同時責め。\n下からは爆根の大量射精、上は口から耳から穴という穴を触手に塞がれ、逆流すら許されずに破裂寸前の肉オナホ化。\n\n構図や詳細は今回もお任せ、できれば顔は隠れない感じで。前回など挟んでいただいた衣装破壊や自分の武器による拘束、出血なども挟めるなら嬉しいです\nよろしくお願いします\n\nhttps://drive.google.com/file/d/17Ljmjs55ehUaYhOXIvxHL3wjn-sTjTfT/view?usp=drive_link", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@touen_pg/works/20", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/657ae101/uploads/origins/6f47e001-6cbc-4d45-a918-5fae0a2965eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47aefe4da46f09ccfaa96bc3cde4249e", "srcset": "https://si.imgix.net/657ae101/uploads/origins/6f47e001-6cbc-4d45-a918-5fae0a2965eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47aefe4da46f09ccfaa96bc3cde4249e, https://si.imgix.net/657ae101/uploads/origins/6f47e001-6cbc-4d45-a918-5fae0a2965eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bff8832928557fef4900b0916821f208 2x, https://si.imgix.net/657ae101/uploads/origins/6f47e001-6cbc-4d45-a918-5fae0a2965eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=754b6342a4572cfb278cf793b69464cb 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 15012, "client_id": 376667, "nc": 32}, {"path": "/@touen_pg/works/19", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c28b6984/uploads/origins/31b5ff45-3890-4976-a0bb-99c3cba80951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&tx