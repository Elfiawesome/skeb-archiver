-88500aa33316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ded906b9c6451a57c86d6e394937f574", "srcset": "https://si.imgix.net/acb9022c/uploads/origins/70ba5978-8b17-4122-af17-88500aa33316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ded906b9c6451a57c86d6e394937f574, https://si.imgix.net/acb9022c/uploads/origins/70ba5978-8b17-4122-af17-88500aa33316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b786a55b0f55b995111bd1e75265445 2x, https://si.imgix.net/acb9022c/uploads/origins/70ba5978-8b17-4122-af17-88500aa33316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7322d80214839bbfdb094c06aebfd5bd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/acb9022c/uploads/origins/70ba5978-8b17-4122-af17-88500aa33316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0dd2ce15ac679cf339717f05ccad47eb", "srcset": "https://si.imgix.net/acb9022c/uploads/origins/70ba5978-8b17-4122-af17-88500aa33316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0dd2ce15ac679cf339717f05ccad47eb, https://si.imgix.net/acb9022c/uploads/origins/70ba5978-8b17-4122-af17-88500aa33316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a086640b12dce91cfbedafcae40ea97 2x, https://si.imgix.net/acb9022c/uploads/origins/70ba5978-8b17-4122-af17-88500aa33316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=82f672d53db06a60d3488abbede65f0e 3x"}, "body": "狐の嫁入りイラストをお願いします\n\n表情　結婚式を控え、はにかみつつも嬉しそう、又は幸せそうに微笑んでる\n(上記に限らず、幸せそうな感じであれば嬉しいです。嬉し泣き等も可)\n\n特徴　けもみみ(キツネ耳)\n(作者様判断で「けもみみ無し」でも可です。その場合の注意点を一番下に記載)\n\n髪のスタイル　おまかせします\n髪の色　おまかせします。白狐等も可\n\n服装　白無垢\n服の色　白　又は少し黄色味のある白色等　(お好きな他色を薄く混ぜ可。模様等もご自由に)\n\n使用しないで欲しい物のお願い(小物や装飾品で使用は可)\n綿帽子(頭の被り物)　なし　(ケモミミが隠れるため。半透明のものは可)\n赤色和傘の所持　なし　(人物よりも目立つため)\n狐のお面の装着　なし　(顔が隠れるため。斜め掛けや所持は可)\n\nその他の装飾品や小物等はおまかせします\n\n季節　収穫の秋(イチョウ、モミジ)、又は芽吹きの季節の春(サクラ)\n　　　（本榊の花を装飾品に使用する場合は７月設定で)\n天候　天気雨又は、雨上がりの晴れ\n（季節と天候は参考情報です。気にせず自由に描いてください）\n\n構図、解像度はおまかせします\n展覧用のため、宛名等はナシでお願いします\n\n参考資料等\nhttps://twitter.com/pinsuke_m/status/1459135013924978694\n\n使用用途\nSkeb規約に準拠、キツネ関連の振興で使用(広報・地域の祭り等、非商用に限る)許可願います\n\n楽しみながら描いてくれると嬉しいです\nご検討お願いします\n\n※例外\nけもみみ無しの場合\n通常の人として扱います\n狐の嫁入り設定のため、白無垢に「白狐のお面」を所持等させてください\n（※狐面と猫面の違いにご注意ください）", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 718315, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "𝑺𝒖𝒑𝒆𝒓♡𝑫𝒓𝒚", "screen_name": "super_dry_rr", "avatar_url": "https://pbs.twimg.com/profile_images/1489554188103462915/sQRJvZSF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1218523218606051328/1627365841/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 1045307, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "saku", "screen_name": "saku5885", "avatar_url": "https://pbs.twimg.com/profile_images/1281468358437699585/0elDEZtx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/739700714117599232/1750839568/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 128}, {"id": 1325880, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "皐月 恵@Kei Satsuki", "screen_name": "kuroe16370547", "avatar_url": "https://pbs.twimg.com/profile_images/1622801511863701504/0wTPh