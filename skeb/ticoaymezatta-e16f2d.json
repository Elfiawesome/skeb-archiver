6e\u30b5\u30a4\u30f3\u304c\u3042\u308a\u307e\u3059\u3002\n\u9996\u306b\u306f\u30ac\u30b9\u30de\u30b9\u30af\u3092\u3064\u3051\u3066\u3044\u307e\u3059\u3002\n\u767d\u9ed2\u306e\u30a4\u30e9\u30b9\u30c8\u306e\u3088\u3046\u306b\u80f8\u306e\u8c37\u9593\u3092\u898b\u305b\u3066\u3044\u308b\u3002\n\u9aea\u306f\u9ed2\u304f\u3001\u76ee\u306f\u7dd1\u3067\u3059\u3002\n\u3082\u3057\u3042\u306a\u305f\u304c\u671b\u3080\u306a\u3089\u3001\u5f7c\u5973\u306e\u30dd\u30fc\u30ba\u3092\u3042\u306a\u305f\u306b\u304a\u4efb\u305b\u3057\u307e\u3059\u3002\u3082\u3057\u305d\u3046\u3067\u306a\u3051\u308c\u3070\u3002\n\u5f7c\u5973\u306f\u656c\u793c\u3057\u3066\u3044\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\n\u5f7c\u5973\u306f\u3082\u3046\u7247\u65b9\u306e\u624b\u3067\u30ec\u30fc\u30b6\u30fc\u30ac\u30f3\u30e9\u30a4\u30d5\u30eb\u3084\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb\u3092\u63e1\u3063\u3066\u3044\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u5f7c\u5973\u306f\u719f\u7df4\u3057\u305f\u30b9\u30ca\u30a4\u30d1\u30fc\u3067\u3057\u305f\u3002\n\n\u30e1\u30c3\u30bb\u30fc\u30b8\u4ed8\u304d\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3068\u3001\u30e1\u30c3\u30bb\u30fc\u30b8\u306a\u3057\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u304c\u3042\u308a\u307e\u3059\u3002\n\u30a2\u30e9\u30a4\u30ba\u30fb\u30ce\u30fc\u30d6\u30eb\u30fb\u30dc\u30b9\u30c8\u30ed\u30e4!\n\u30b3\u30ca\u30c8\u30a5\u30b9\u306b\u7687\u5e1d\u306e\u9244\u69cc\u3092!\n\n\u3054\u691c\u8a0e\u304f\u3060\u3055\u3044\u3002\n\nhttps://imgur.com/a/1Utbjgg", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ticoaymezatta/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 181240, "client_id": 42179, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1eaf711/uploads/origins/145354fc-cc21-4449-86a2-0cedcccb2f54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=998984dcbcf4fe29