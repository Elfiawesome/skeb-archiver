", "tipped": false, "creator_id": 3398703, "nc": 35}, {"path": "/@veve_vesta/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 3398703, "client_id": 626697, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1607065303284080640%2FQbrY2Ery.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64734911cc1c63c8b77a434a3e94111e", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1607065303284080640%2FQbrY2Ery.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64734911cc1c63c8b77a434a3e94111e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1607065303284080640%2FQbrY2Ery.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=662b207480f5f9ba5cbb4dbce00a4839 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1607065303284080640%2FQbrY2Ery.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34b2bd380bf021e015bb21b144988cfa 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1607065303284080640%2FQbrY2Ery.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9980106a946c5eadf59fec63200e57db", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1607065303284080640%2FQbrY2Ery.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9980106a946c5eadf59fec63200e57db, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1607065303284080640%2FQbrY2Ery.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=531d219dbec2db90cfaed3954523bfc1 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1607065303284080640%2FQbrY2Ery.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0299dcfa0d77aa0b6f45f53825f11037 3x"}, "body": "あの日見た花の名前を僕達はまだ知らない。の安城鳴子の話をお願いします。\n\n内容はじんたんとアナルセックスをしようとした鳴子にめんまが「抜け駆けするあなるにお仕置きだよ！」と怒って鳴子の生尻にカンチョーします。生の尻穴にカンチョーが根元まで刺さった鳴子は激痛に泣き叫ぶ。カンチョーのダメージで鳴子は尻を突き出して涙を流して動けなくなる。\n\nしかし怒りが収まらないめんまは鳴子が悶絶してる隙にこっそり鳴子の自転車のサドルに細工する。帰宅中に自転車を走らせる時にサドルが外れてそれに気付かない鳴子は座ろうとするが、勢いよく尻を下ろしたのでサドルのパイプが尻の穴に根元まで突き刺さり絶叫。再び尻穴の激痛に襲われた鳴子は泣きながら悶える。\n\n数日後に鳴子はじんたんの家でアナルセックスをしようと向かうが、めんまは阻止しようと道中、鳴子に気づかれない様に鳴子が乗ってる自転車に細工する。走行中にサドルが外れて再び鳴子の肛門にパイプが刺さって絶叫。鳴子が痛みで泣いてる隙に落とし穴をしかける。鳴子が回復してじんたんの家に向かうが、めんまの落とし穴に引っ掛かり仕込まれた棒が肛門に刺さって再び悶絶する羽目に。\n\n尻の痛みに泣きながらもじんたんの家に付き、じんたんに前戯で尻の穴を舐めて貰おうとする。しかしめんまが阻止しようと激辛からしを塗った棒を鳴子の尻穴に全力で突き刺す。棒が刺さった痛みとからしの刺激に鳴子は泣き叫ぶ。\n尻の穴に棒が刺さった鳴子は痛みに泣きながら「抜いて～！！」と尻を突き出す。「抜け駆けした分お尻の穴で反省するんだよ！！」とめんまは鳴子の尻穴に刺さった棒をぐりぐりと動かして鳴子の尻の穴に苦痛を与える。\n\nめんまのお仕置きで尻の穴の激痛に目覚めた鳴子はわざとめんまの前でノーパンの尻を振って挑発したりじんたんとアナルプレイをしようと抜け駆けする。\n\nめんまも鳴子に容赦せずカンチョーしたり、時には竹槍を突き刺したり鳴子の肛門にお仕置きする。\n\n尻の穴にお仕置きをされる度に痛みで悶絶する鳴子。めんまのお仕置きのせいで鳴子の尻の穴は常に痛みに苛まれる羽目になる。", "nc": 43, "word_count": 13190, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@veve_vesta/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/859b9dc0/uploads/origins/0fcf8682-5495-4949-9e54-f8857f003efc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=022b9633576d79811f0f580d18ae14a5", "srcset": "https://si.imgix.net/859b9dc0/uploads/origins/0fcf8682-5495-4949-9e54-f8857f003efc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=022b9633576d79811f0f580d18ae14a5, https://si.imgix.net/859b9dc0/uploads/origins/0fcf8682-5495-4949-9e54-f8857f003efc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5dcaf17ef1cd0a59de248013602732cd 2x, https://si.imgix.net/859b9dc0/uploads/origins/0fcf8682-5495-4949-9e54-f8857f003efc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=353c383d85835ff89dba25ef8b77c2af 3x"}, "private": true, "genre": "novel", "tipped": false, "creator_id": 3398703, "nc": 32}], "sent_works": [], "similar_creators": [{"id": 435131, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ねず", "screen_name": "nezumimaro", "avatar_url": "https://pbs.twimg.com/profile_images/2028149319044567040/1tABWHV4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/140028536/1676382978/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_