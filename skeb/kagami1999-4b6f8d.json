さい。\nhttps://imgur.com/a/4Qu7mmj\n\n背景はなくてもいいです。\n先生の絵が素敵で膝の上とかお尻までは見たいです!", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kagami1999/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3981078, "client_id": 300145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d236919b/uploads/origins/b0686f08-166d-4244-b827-e8ec43f28ce2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=206816309d7f881838ee1a699b93fc13", "srcset": "https://si.imgix.net/d236919b/uploads/origins/b0686f08-166d-4244-b827-e8ec43f28ce2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=206816309d7f881838ee1a699b93fc13, https://si.imgix.net/d236919b/uploads/origins/b0686f08-166d-4244-b827-e8ec43f28ce2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=921c9f09f18bdc3a0202afef019cc6d3 2x, https://si.imgix.net/d236919b/uploads/origins/b0686f08-166d-4244-b827-e8ec43f28ce2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=127980973d3c94faf852e9c5a21f686d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d236919b/uploads/origins/b0686f08-166d-4244-b827-e8ec43f28ce2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3087af7f598aeada6fbbc5708f09cb24", "srcset": "https://si.imgix.net/d236919b/uploads/origins/b0686f08-166d-4244-b827-e8ec43f28ce2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3087af7f598aeada6fbbc5708f09cb24, https://si.imgix.net/d236919b/uploads/origins/b0686f08-166d-4244-b827-e8ec43f28ce2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ee77710ce2da07aa22e28760f5283fc8 2x, https://si.imgix.net/d236919b/uploads/origins/b0686f08-166d-4244-b827-e8ec43f28ce2?bg=%23fff&auto=format%2Ccompre