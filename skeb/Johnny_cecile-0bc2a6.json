rigins/b062fac2-2035-47e5-9de0-4c38d675bc22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38542b665151428fed5b71c7bf0a1701", "srcset": "https://si.imgix.net/b0457c38/uploads/origins/b062fac2-2035-47e5-9de0-4c38d675bc22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38542b665151428fed5b71c7bf0a1701, https://si.imgix.net/b0457c38/uploads/origins/b062fac2-2035-47e5-9de0-4c38d675bc22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc7c45817671e12cf78b635079dec13f 2x, https://si.imgix.net/b0457c38/uploads/origins/b062fac2-2035-47e5-9de0-4c38d675bc22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9900b72898e581cb1c01270c6e978ff5 3x"}, "body": "初めまして。\npixivでのブラックマジシャンガールの絵柄が好みでフォローさせていただきました。\n初めてリクエストさせていただきます。\n\nキャラクター　ブラックマジシャンガール\nシチュエーション　リベンジサクリファイスに捕われて苦しむブラックマジシャンガールをお願いします。\n\n可能ならば、漫画風に3コマで\n1コマ目　触手に絡みつかれて焦りながらも抵抗するBMG。（片目をつむりながら嫌がる表情で）\n2コマ目　触手に完全につかまって締め上げられ苦悶するBMG。\n　　　　（特に胴体は腕ごと胸を強調するように巻き付かれて）\n3コマ目　抵抗むなしく悲鳴を上げながらカードに向かって引き寄せられるBMG。\n　　　　　（口を大きく開けて苦痛の表情で。BMGの向きはリベンジサクリファイスのカードに背を向ける\n　　　　　　形でお願いします。）\n\n細かい要望ですがよろしくお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Johnny_cecile/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 585573, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fde98f44/uploads/origins/0a5f1bb4-0e0c-4947-93fa-7c6b2945b164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=790da1d78c768f815d8132b8ca5fdefe", "srcset": "https://si.imgix.net/fde98f44/uploads/origins/0a5f1bb4-0e0c-4947-93fa-7c6b2945b164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=790da1d78c768f815d8132b8ca5fdefe, https://si.imgix.net/fde98f44/uploads/origins/0a5f1bb4-0e0c-4947-93fa-7c6b2945b164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13f564cd8234d679b68ab1ea9b28eaa6 2x, https://si.imgix.net/fde98f44/uploads/origins/0a5f1bb4-0e0c-4947-93fa-7c6b2945b164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9de61691215f0964b7e401767206496 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fde98f44/uploads/origins/0a5f1bb4-0e0c-4947-93fa-7c6b2945b164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad47328683b2637b98414329e0fd733e", "srcset": "https://si.imgix.net/fde98f44/uploads/origins/0a5f1bb4-0e0c-4947-93fa-7c6b2945b164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad47328683b2637b98414329e0fd733e, https://si.imgix.net/fde98f44/uploads/origins/0a5f1bb4-0e0c-4947-93fa-7c6b2945b164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aaa44e4c8e8c9c6c8f1b3a16f92d4626 2x, https://si.imgix.net/fde98f44/uploads/origins/0a5f1bb4-0e0c-4947-93fa-7c6b2945b164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=76bcca6d90336430e7cac6e8be2c0140 3x"}, "body": "はじめまして！ジョニー様のブラックマジシャンガールの絵柄がとても好みだったので今回依頼をさせていただきました。どうぞよろしくお願いいたします。\n\n内容: アニメ遊戯王66話にてブラックマジシャンガールがオシリスのサンダーフォースを受けているシーンの美麗イラスト化\n\n以下の点を特にこだわっていただければと思います。\n\n・オシリスの攻撃を受けて体全体が大きく仰け反っている\n・仰け反った姿勢から強調される肩の露出と胸の膨らみ(出来れば脇も…)\n・健康的なスラットした太腿が顕になり、前垂れでレオタードはギリギリ隠れているが、鼠蹊部は見えてしまっている\n・口を大きく開けて痛みを伴う悲鳴をあげている\n\nポーズのイメージは下記リンクの画像のカットが1番好みなので、このカットのポーズをなるべく再現する、という感じでお願いします。上述したポイントを押さえつつ、表現が難しそうな場合細かいアングルの調整はお任せします。\n\nまた、差分で服の損壊が激しいverもお願い出来ればと思います。こちらは服のほとんどがはだけていたり、レオタードが見えていてokです。\n\n色々とマニアック且つ要望が多く申し訳ありませんが、どうぞよろしくお願い致します。\n\nhttps://azumi.moe/wp-content/uploads/2018/09/dark-magician-girl-yu-gi-oh-duel-monsters-0234.jpg", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Johnny_cecile/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 585573, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aad2a61d/uploads/origins/e1823fb5-e935-4004-8adb-a7ba3e6cd49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9911272fa41306deed4326fb9cbcfe35", "srcset": "https://si.imgix.net/aad2a61d/uploads/origins/e1823fb5-e935-4004-8adb-a7ba3e6cd49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9911272fa41306deed4326fb9cbcfe35, https://si.imgix.net/aad2a61d/uploads/origins/e1823fb5-e935-4004-8adb-a7ba3e6cd49f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6996ab2043daf47ade9b27f471cb0599 2x, https://si.imgix.net/aad2a61d/uploads/origins/e1823fb5-e935-4004-8adb-a7ba3e6cd49f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c9c340a7c5a0d00bab23023e00a84f1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aad2a61d/uploads/origins/e1823fb5-e935-4004-8adb-a7ba3e6cd49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=102f721b4b1b2d35e20e31a29ddb0fba", "srcset": "https://si.imgix.net/aad2a61d/uploads/origins/e1823fb5-e935-4004-8adb-a7ba3e6cd49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=102f721b4b1b2d35e20e31a29ddb0fba, https://si.imgix.net/aad2a61d/uploads/origins/e1823fb5-e935-4004-8adb-a7ba3e6cd49f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=410a34f6c926d275c547d43fa8c71f83 2x, https://si.imgix.net/aad2a61d/uploads/origins/e1823fb5-e935-4004-8adb-a7ba3e6cd49f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fbdad401d8a8229e9c155e6bebab34e5 3x"}, "body": "匿名で失礼致します。\n「帰ってきたウルトラウーマン」を題材にお願いしたく思います。\n\nシチュエーション\n多対１の不利な状況で、同時攻撃を受けて追いつめられる\n\n参考資料\nhttps://drive.google.com/drive/folders/1ePBbF4vRvbmLi1yL_teCblGgVfEgKkW8?usp=sharing\n\n\n・構図はお任せします。\n　参考資料もモチーフ程度で考えて頂いて構いません\n・背景についても特に指定はございません\n・複数の敵を想定してはいますが実際に構図に入れるかどうかは\n　工数と予算の兼ね合いもありますのでお任せします。\n　おさまりが悪ければ省いて頂いて構いません。\n・2体のガッツ星人に追いつめられるセブン、又はifになりますが\n　バット星人に羽交い絞めにされた所へ攻撃を受けるといったシーンを\n　イメージしています。\n（ドラマであればそのまま敗北、次週救出作戦といった流れのイメージです）\n・構図自体はお任せしますが、カメラを引いた構図を採用頂く場合\n　カラータイマーのある胸元付近のカットイン等があると嬉しいです\n　\nご検討を宜しくお願い致します。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Johnny_cecile/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 585573, "client_id": 590136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0358efc/uploads/origins/51781fdf-3529-4d08-b851-f4e9b048a1a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ff2d5d7db0d4f6b6bac37bf73f76b22", "srcset": "https://si.imgix.net/f0358efc/uploads/origins/51781fdf-3529-4d08-b851-f4e9b048a1a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ff2d5d7db0d4f6b6bac37bf73f76b22, https://si.imgix.net/f0358efc/uploads/origins/51781fdf-3529-4d08-b851-f4e9b048a1a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c9b3f4a2a0659e0dd6ca023e997ef8c 2x, https://si.imgix.net/f0358efc/uploads/origins/51781fdf-3529-4d08-b851-f4e9b048a1a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e64a01df03ca40f0dd5e3b1d60fc97ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0358efc/uploads/origins/51781fdf-3529-4d08-b851-f4e9b048a1a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6df923cf578801ff14521d9d7814879", "srcset": "https://si.imgix.net/f0358efc/uploads/origins/51781fdf-3529-4d08-b851-f4e9b048a1a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6df923cf578801ff14521d9d7814879, https://si.imgix.net/f0358efc/uploads/origins/51781fdf-3529-4d08-b851-f4e9b048a1a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4ec9f48e6ba8ec90937a127920664e03 2x, https://si.imgix.net/f0358efc/uploads/origins/51781fdf-3529-4d08-b851-f4e9b048a1a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b0b7ff6256536b06012fdc1bdd5993d2 3x"}, "body": "はじめまして、ジョニー先生のリクエスト募集再開を心待ちにしていました。\n早速リクエストさせていただきます。\n\nキャラクター\n遊戯王のブラックマジシャンガール\n\nシチュエーション\nオシリスの召雷弾を喰らってギリギリ耐えるもボロボロになっている\n\n衣装\n全体的にボロボロ\n左足のブーツが脱げている\n\nポーズ・表情\n内股でガクガク震えながら杖を両手で握りしめ涙目になり怯えている\n\nまた、可能であれば帽子が無い(脱げている)状態の差分もあれば嬉しいです。\nどうぞよろしくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Johnny_cecile/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 585573, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45654584/uploads/origins/da7df2b1-21a7-48eb-be06-280571d6af54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74a5b42e7904873ae75e7eab54f08b39", "srcset": "https://si.imgix.net/45654584/uploads/origins/da7df2b1-21a7-48eb-be06-280571d6af54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74a5b42e7904873ae75e7eab54f08b39, https://si.imgix.net/45654584/uploads/origins/da7df2b1-21a7-48eb-be06-280571d6af54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e48c3b847f9df78575f0ed909f922c78 2x, https://si.imgix.net/45654584/uploads/origins/da7df2b1-21a7-48eb-be06-280571d6af54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed9b40984bd791c10c207660e5b1ef71 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45654584/uploads/origins/da7df2b1-21a7-48eb-be06-280571d6af54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&bl