0-4bfb-8ca9-8a492c656f46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b473c5618aa99cb91db918430a82f483, https://si.imgix.net/37b76a63/uploads/origins/ca8cab6e-5910-4bfb-8ca9-8a492c656f46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8dc7cb6ff3c1d09d20d97ca43adcbee4 2x, https://si.imgix.net/37b76a63/uploads/origins/ca8cab6e-5910-4bfb-8ca9-8a492c656f46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de7f4236797ccf0b5ead22d842197945 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37b76a63/uploads/origins/ca8cab6e-5910-4bfb-8ca9-8a492c656f46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a98a96f533ea53a49d1fa4a114c71d3c", "srcset": "https://si.imgix.net/37b76a63/uploads/origins/ca8cab6e-5910-4bfb-8ca9-8a492c656f46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a98a96f533ea53a49d1fa4a114c71d3c, https://si.imgix.net/37b76a63/uploads/origins/ca8cab6e-5910-4bfb-8ca9-8a492c656f46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dc3650de589c88f20c6eb650a8591c3b 2x, https://si.imgix.net/37b76a63/uploads/origins/ca8cab6e-5910-4bfb-8ca9-8a492c656f46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56768e228af0b473976685da854704b5 3x"}, "body": "こんにちは、オオキトラです！skebを見ていて、あなたのアートスタイルに惚れました。\n何度もリクエストして申し訳ありません、前のリクエストは間違えてしまいました。\n\n- OC\n無口で、疲れていることが多いので、外見的には幸せそうに見えません。\nしかし、ひとたび話せば温厚でユーモアのある人だ。\n笑うときは閉じた手で口をふさぐタイプ。\n\nOCの参考資料\nhttps://drive.google.com/drive/folders/1BGQuEdyd6FcuuTEsFUZztDTDBHncmKMe\n\n- リクエスト\n私のOCの地味なポーズのイラストが欲しいです。\n深く考え込んでいるようなポーズが希望です。\nこのフォルダにある参考画像のようなポーズは、私が探しているものに似ています。https://drive.google.com/drive/folders/1CFFuZYdDHZ981Te1zq1atmlo2o0o8aQt\n\nそれ以外のことは、あなたの判断や変更に任せたいと思います。\n私はあなたの創造性を信頼していますし、それを妨げるつもりはありません。\n\n-使用方法\n個人的な使用、SNSのプロフィール用アイコン/ヘッダー画