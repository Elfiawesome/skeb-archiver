f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cf4033bcc52bdb9907f17af25a6f3e9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04db9a9c/uploads/origins/1dfcbaaa-14b5-46d2-8499-d8056c357414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=503169cf0f6a77343721be37f1df2c35", "src_set": ""}, "body": "わしん様、先日は納品ありがとうございました。高クオリティで非常に満足しております。\n続けての依頼になるのですが、ブルーアーカイブキャラで空知英秋先生の作品「銀魂」のパロディ漫画をお願いします。\nシチュはエピソード「Ｚ～～～～～～（アニメでの題名：メガネは魂の一部です）」の一場面です。\n該当シーンの画像を添付します\nhttps://www.tumblr.com/reioh15060/762028961712701440/skeb?source=share\n新八（黒髪メガネの青年）　　　　　　　　→ヒナに置き換え\n神楽（肩出し着物の少女）　　　　　　　　→ミカに置き換え\n銀時（笠を被った男性）　　　　　　　　　→ホシノに置き換え\n全蔵（最後の方に出てくる目隠れの男性）　→ネルに置き換え\n細かいポーズやセリフの口調、衣装などはお任せします。また、背景の建築物や部屋などは現代の様式に置き換えてもらえればと思います。\n\nご検討いただけますと幸いです。\n何卒宜しくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Washin_DD/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2038521, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/50a59c44/uploads/origins/56b2edb1-7620-4bfa-8af3-43a2a39214f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a57d9ae390f733302a7190c91809b0f0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/50a59c44/uploads/origins/56b2edb1-7620-4bfa-8af3-43a2a39214f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f11e25eb09d151dbc58ad877767c3cb", "src_set": ""}, "body": "わしん様、はじめまして。\nブルーアーカイブより空崎ヒナ、小鳥遊ホシノ、美甘ネル、剣先ツルギ、聖園ミカの５人のイラストをお願いします。\nシチュは空知英秋先生の作品「銀魂」のエピソード「ジジィになってもあだ名で呼び合える友達を作れ」の一場面のパロディです。\n該当シーンの画像を添付します\nhttps://www.tumblr.com/reioh15060/761312493075300352\nお登勢（一番奥で腕組んでいる女性）　　　　　　→ツルギに置き換え\n倒れているヘルメットの男性　　　　　　　　　　→うごあつ顔のホシノに置き換え\n新八（ヘルメットの男性に手を添えている青年）　→ヒナに置き換え\n神楽（救急車と叫んでいる少女）　　　　　　　　 →ミカに置き換え\n銀時（一番手前の男性）　　　　　　　　　　　　→ネルに置き換え\n細かいポーズやセリフの口調などはお任せします。\n\nご検討いただけますと幸いです。\n何卒宜しくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Washin_DD/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2038521, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/05415e24/uploads/origins/f027602a-c972-4cfd-bd7f-92c3ea4072a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75beb45d1b8d6b8d8266e420acfb3b36", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/05415e24/uploads/origins/f027602a-c972-4cfd-bd7f-92c3ea4072a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6e6d1978f7467bbcfe4a2dacc585ae5", "src_set": ""}, "body": "ブルアカとウマ娘のキャラでコラボ漫画ぽいのをお願いします\n２コマ程度の対比になっている形で\n\nブルアカサイド\n「この間生身なのに物凄いスピードで走ってる奴らを見た」\n「絶対人間じゃないよあれ」\n\nウマ娘サイド\n「この間銃火器で撃ち合いしてるのにピンピンしてる奴らを見た」\n「絶対人間じゃないよあれ」\n\n…のような感じで　セリフは別にこの通りでなくて構いません\nキャラは描きやすい子を適当にチョイスしてください", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Washin_DD/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2038521, "client_id": 340053, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac639a46/uploads/origins/be605232-582c-4ff0-9e43-b67d122fd683?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3da25003935106a297e3c730e80f25b8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac639a46/uploads/origins/be605232-582c-4ff0-9e43-b67d122fd683?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7fe7a671baffadce4bbf19956ea8208", "src_set": ""}, "body": "「親子かめはめ波（孫悟飯・少年期）」を打つシュン（幼女）をお願いします。\n悟空役はシュン（通常）で。\n\n金額内で可能であれば\n対戦相手として、セル側のチセ（通常）が\n「ちきゅうごと〜、きえてなくなれ〜」\nと太陽系破壊かめはめ波を打つのもお願いします。", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Washin_DD/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2038521, "client_id": 1502585, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4de4335/uploads/origins/a6ff4fa2-fa5d-4afe-b2fb-5bda2f46a92d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=979145dde3b502765fc8a556e85987f0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4de4335/uploads/origins/a6ff4fa2-fa5d-4afe-b2fb-5bda2f46a92d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88f107372103662da88a699d41470d57", "src_set": ""}, "body": "いつもイラスト、漫画を楽しませていただいています。そろそろ復刻が来そうなブルーアーカイブの飛鳥馬トキ(バニー)が好きなので、かっこよく潜入任務をしている様子を希望します。構図や小ネタがあれば先生におまかせします。\nよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Washin_DD/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2038521, "client_id": 439569, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b1068f72/uploads/origins/08a6365a-74cd-44a7-85ee-47bf84b87c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5c227233f566a50700a56430e5ddea0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1068f72/uploads/origins/08a6365a-74cd-44a7-85ee-47bf84b87c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0edbae37a8a44ec2c11c89c490ca7ba", "src_set": ""}, "body": "初めまして｡\nいつも面白いパロディイラストを陰ながら楽しませてもらっております｡\n\nもしブルアカ以外のリクエストも受け付けておられましたら､とある動物写真のパロディを､雀魂という麻雀アプリのキャラでお願いしたいです｡\n\n【使用用途】\n雀魂仲間が負けたり高い手に振り込んだ時の煽り､及び自分がそうなった時の自虐として､身内用トークアプリで貼らせて頂きます｡\n\n【アスペクト比の指定】\n上記の理由から特に無いです｡\nご自由に描かれてください｡\n\n【描いてほしいキャラクター及び参考資料】\nhttps://x.com/shu10douzi/status/1774278181698376169?s=20\n\n画像1枚目の狼達と同じ表情をしている､ジョセフ·九条璃雨·二之宮花(画像2～4枚目のキャラ)をお願いします｡\n私と友人の雀魂での持ちキャラです｡\n\nそしてお手数ですが､前述の理由で誰が負けた時にも使えるように､真ん中で煽られている担当を全員でローテーションするように3パターン分用意して頂きたいです｡\n\nまた､手元に雀卓があると嬉しいですが､こちらは必須ではありません｡\n背景の有無もお任せします｡\n\n要望は以上になります｡\nよろしくお願いします｡", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Washin_DD/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2038521, "client_id": 563859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c699988/uploads/origins/77d2e71d-fb55-44c2-8472-d259f3a93f34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3eeb3ffce2087f3a6e634f1a85dfa5b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c699988/uploads/origins/77d2e71d-fb55-44c2-8472-d259f3a93f34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d25f4766b44037910b3c0ceb608fafbe", "src_set": ""}, "body": "無課金誓いウォーカーと化したシャーレの先生がマワスベキダー(最近復刻ピックアップ募集されたアツコ)と戦っている漫画をお願いします\n\n結末はわしん先生にお任せます", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Washin_DD/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2038521, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/879a269e/uploads/origins/a09717ce-84ba-4280-b093-32f33499e6e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69448e8758c9fdc840d8578ffc52be9a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/879a269e/uploads/origins/a09717ce-84ba-4280-b093-32f33499e6e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b41dc7bb1a904cdd742efba904ee9ab0", "src_set": ""}, "body": "わしんさん初めまして、いつも楽しく拝見させていただいています。先生が描いたバラエティネタ絵が好きです。\n今回のリクエストは『明星ヒマリがとあるバラエティーを出演した』をお願いしたいです。もしこのリクエストがNSFWだと思いましたら、キャンセルしても問題ありません。\nこれは外国のバラエティー番組です。フライングチェアーは、このバラエティー番組でよく使う道具です。ルールは、真ん中に座ったゲストがNGワード（通常は口癖）を言った時、罰ゲームとして、このNGワード対応したメンバーは、フライングチェアーで飛ばされて、後ろのプールにドボンします。\nキャラは明星ヒマリとヴェリタスの四人『各務チヒロ、小鈎ハレ、小塗マキ、音瀬コタマ』\nヒマリは真ん中に座ったゲスト、チヒロのNGワードは『天才』、ハレのNGワードは『病弱』、マキのNGワードは『美少女』、コタマのNGワードは『ハッカー』。\nシチュエーション詳細：\n真ん中に座ったヒマリが『超天才清楚系病弱美少女ハッカー』を言った。\n左右に座った四人が座っているフライングチェアーが作動した。四人はそれぞれのポーズで飛ばされ、そのまま身体が空中に浮いています。\n構図について、参考画像のように、作動していたフライングチェアーと後ろのプールが必要。\nもし可能であれば、ヴェリタスの四人は水に入る予定なので、裸足にしてほしいです。\nシーンを描くのが面倒なら飛ばされた四人がはっきりと見えなくても構いません、キャンセルしても問題ありません。\nご検討の程よろしくお願いします！\n参考はこちらになります：\nhttps://drive.google.com/drive/folders/1wVV7RqMC-zjquP0C7kkucwyO00NTFEaU?usp=sharing\nhttps://www.pixiv.net/artworks/77625120\nhttps://www.pixiv.net/artworks/85116240\nhttps://www.pixiv.net/artworks/83309912\n元ネタのバラエティー番組：https://www.youtube.com/watch?v=IhdR0eqS_DA", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Washin_DD/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2038521, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d3a6ff1/uploads/origins/bc46a4a3-8fd7-41f6-8e21-8e330baa60b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed8d5e56ad28d4776b7aa22e618d3be0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d3a6ff1/uploads/origins/bc46a4a3-8fd7-41f6-8e21-8e330baa60b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9adfd4ca7255dbe9fc7cf0c9aa7c6ceb", "src_set": ""