をレイヤー分けしていただけると嬉しいです。\n\n\n金額不足や内容不備などがございましたら、お手数ですが再送のご要請をいただけますと幸いです。\nご検討のほど、よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ehokun/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3771436, "client_id": 3649724, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/190bffd9/uploads/origins/4fc3000f-d9fd-454a-ab1d-1a1d74334d61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=050bf73532241213e499f6f1b7a4d603", "srcset": "https://si.imgix.net/190bffd9/uploads/origins/4fc3000f-d9fd-454a-ab1d-1a1d74334d61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=050bf73532241213e499f6f1b7a4d603, https://si.imgix.net/190bffd9/uploads/origins/4fc3000f-d9fd-454a-ab1d-1a1d74334d61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f8e049dc0a32f252fef6bc70da5f3fe 2x, https://si.imgix.net/190bffd9/uploads/origins/4fc3000f-d9fd-454a-ab1d-1a1d74334d61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=546190c282d67657e35aabdb273c2886 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/190bffd9/uploads/origins/4fc3000f-d9fd-454a-ab1d-1a1d74334d61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9ab987c4abe718a198852b5e088ecfd", "srcset": "https://si.imgix.net/190bffd9/uploads/origins/4fc3000f-d9fd-454a-ab1d-1a1d74334d61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9ab987c4abe718a198852b5e088ecfd, https://si.imgix.net/190bffd9/uploads/origins/4fc3000f-d9fd-454a-ab1d-1a1d74334d61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f21333861d5f0a39cdf8115d46c19567 2x, https://si.imgix.net/190bffd9/uploads/origins/4fc3000f-d9fd-454a-ab1d-1a1d74334d61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a3169e82ba36801aa8e6c6d7d527cb83 3x"}, "body": "こんにちは。あなたの画風をとても尊敬しているのですが、今回は「魔法少女ノ魔女裁判」の紫藤アリサのイラストをお願いしたいです。\n\nそのシーンは、志藤アリサが路地の壁にもたれかかり、正面を向いている。右腕は胸の上で交差させ、右手は左肘を押さえている。左手はゲーム中で炎を放つときの仕草をしており、指先から小さな炎が出ている。\n\n可能であれば、マスクを外したバージョンもお願いできますか？具体的な表情は、マスクを取った後の志藤アリサで決めていただいて構いません。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ehokun/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3771436, "client_id": 300145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/edd90108/uploads/origins/acaafa8e-8f8e-469c-b05a-2ba0b8de2cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61d9a030f65b3e521dad1922a25f6c7d", "srcset": "https://si.imgix.net/edd90108/uploads/origins/acaafa8e-8f8e-469c-b05a-2ba0b8de2cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61d9a030f65b3e521dad1922a25f6c7d, https://si.imgix.net/edd90108/uploads/origins/acaafa8e-8f8e-469c-b05a-2ba0b8de2cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e996a38c6ca747185ca2a48b4b87f9d 2x, https://si.imgix.net/edd90108/uploads/origins/acaafa8e-8f8e-469c-b05a-2ba0b8de2cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1fbeddc9ed4038ec88bb87f681ef758 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/edd90108/uploads/origins/acaafa8e-8f8e-469c-b05a-2ba0b8de2cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a155728cb5977bd8c74e8475f82ab43c", "srcset": "https://si.imgix.net/edd90108/uploads/origins/acaafa8e-8f8e-469c-b05a-2ba0b8de2cf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a155728cb5977bd8c74e8475f82ab43c, https://si.imgix.net/edd90108/uploads/origins/a