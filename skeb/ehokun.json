=crop&crop=top&w=200&h=200&blur=200&s=30ec46ffa013ef339976f738d4e23f33, https://si.imgix.net/0b8a296e/uploads/origins/f7c3d648-5a71-4b26-a628-ce6b643e2ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9b0551777ea2bf32a8ccd758920ae8c7 2x, https://si.imgix.net/0b8a296e/uploads/origins/f7c3d648-5a71-4b26-a628-ce6b643e2ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0626321e141bfd52cd9b7651044211e5 3x"}, "body": "はじめまして！世界にはもっと鍵山雛が必要です。東方プロジェクトの可愛いキャラクター、鍵山雛を描いていただけませんか？胸を大きく、太ももまでのストッキングを履かせたいです。その他の指定はありませんので、自由にデザインしてください。よろしくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ehokun/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3771436, "client_id": 56790, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac556755/uploads/origins/dcda1147-12c0-4491-b8ed-9bb505c851e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cec8c89fb16ed9c00e90c79cd0daf8a", "srcset": "https://si.imgix.net/ac556755/uploads/origins/dcda1147-12c0-4491-b8ed-9bb505c851e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cec8c89fb16ed9c00e90c79cd0daf8a, https://si.imgix.net/ac556755/uploads/origins/dcda1147-12c0-4491-b8ed-9bb505c851e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01c7e9dc649f1e797108abd8a5f9953c 2x, https://si.imgix.net/ac556755/uploads/origins/dcda1147-12c0-4491-b8ed-9bb505c851e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ec5fa868e6a0d728c36be05c2f5f72c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac556755/uploads/origins/dcda1147-12c0-4491-b8ed-9bb505c851e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4872a8a704c48625646967a99a6a8ae", "srcset": "https://si.imgix.net/ac556755/uploads/origins/dcda1147-12c0-4491-b8ed-9bb505c851e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4872a8a704c48625646967a99a6a8ae, https://si.imgix.net/ac556755/uploads/origins/dcda1147-12c0-4491-b8ed-9bb505c851e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=47bcce4da391b548885bec51b5d4f3bc 2x, https://si.imgix.net/ac556755/uploads/origins/dcda1147-12c0-4491-b8ed-9bb505c851e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=787301c780686b6c7819dd2cb4fb992e 3x"}, "body": "会帆様\n\nいつも素敵な作品をありがとうございます。\n今回は古明地姉妹を描いていただきたく、リクエストをお送りいたしました。\nご多忙のところ恐縮ですが、ご一読いただけますと幸いです。\n\n\n◇リクエスト内容\n\n古明地さとりの背後から飛び掛かるように抱きつく古明地こいし\n\nさとり様は困惑と照れが入り混じった表情で、こいしちゃんは満面の笑みでお願いします。\n構図やその他の細かい部分はお任せいたします。\n\n【使用用途】\n個人利用の範囲でのグッズ制作、SNSやブログでの使用、PC壁紙など。\n\n【その他】\n解像度5000px×3000px以上の横長イラストでお願いします。\n納品の際は人物と背景をレイヤー分けしていただけると嬉しいです。\n\n\n金額不足や内容不備などがございましたら、お手数ですが再送のご要請をいただけますと幸いです。\nご検討のほど、よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ehokun/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3771436, "client_id": 66613, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e8ad08b/uploads/origins/bdd8e313-930d-445d-b029-1da2de31d4c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c20f62150cf46457b219fc857da369d", "srcset": "https://si.imgix.net/0e8ad08b/uploads/origins/bdd8e313-930d-445d-b029-1da2de31d4c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c20f62150cf46457b219fc857da369d, https://si.imgix.net/0e8ad08b/uploads/origins/bdd8e313-930d-445d-b029-1da2de31d4c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b48e23979f5febc14abf9737e930a8b1 2x, https://si.imgix.net/0e8ad08b/uploads/origins/bdd8e313-930d-445d-b029-1da2de31d4c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0e4e7564e8445b77c6db7aee767b6f1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e8ad08b/uploads/origins/bdd8e313-930d-445d-b029-1da2de31d4c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce2d01ff53a1759793d12755a23c42f7", "srcset": "https://si.imgix.net/0e8ad08b/uploads/origins/bdd8e313-930d-445d-b029-1da2de31d4c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce2d01ff53a1759793d12755a23c42f7, https://si.imgix.net/0e8ad08b/uploads/origins/bdd8e313-930d-445d-b029-1da2de31d4c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3a827a76515e17eefcd220a23dfafc7e 2x, https://si.imgix.net/0e8ad08b/uploads/origins/bdd8e313-930d-445d-b029-1da2de31d4c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d30a27ee283fae2f6bb1cd973307da8 3x"}, "body": "初めまして。\nこの度Skebを開設された事を知りまして、\n是非にと思い1件リクエストさせて頂きます。\n\n以下、リクエスト内容です。\n\n東方Projectの名無しの本読み妖怪（朱鷺子）\nが水着姿で川で水遊びをしようとしているイメージのイラストをお願いします。\n水着はハイカットタイプの競泳水着でお願いします。\n・形状参考リンク\nhttps://skeb.jp/@ikuraonigiri/works/165\nhttps://skeb.jp/@maizumi_illust/works/108\nhttps://www.pixiv.net/artworks/104058481\nライン等細部デザインは自由にして下さい。\n\nまた、霊夢の顔のラクガキを貼り付けたスイカと木の棒を用意してこれからスイカ割りするわよ！と楽しそうな、またはちょっとヤンチャそうな得意気な感じの表情でいるシチュエーションでお願いします。\n\nその他ポーズや構図はお任せいたしますが、ボディラインがあまり隠れない感じになっていると嬉しいです。\n基本的には普段会帆様が描かれている朱鷺子ままのイメージで構いません。\n\n幻想郷に海はないので川という指定を入れましたが、\n金額的に背景はご無理でしたら背景無しでお願いします。\nその他内容に対しての金額不備等あれば再送要求をしていただければと思います。\n\n以前より会帆様の朱鷺子が大好きで、機会が来るようであれば是非朱鷺子リクエストをお送りしたいと思っておりました。\n何卒ご一考の程をよろしくお願いいたします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ehokun/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3771436, "cli