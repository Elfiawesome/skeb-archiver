to=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e8cd7b1042af4a5e0d0b01ca4c34fcf, https://si.imgix.net/febdb090/uploads/origins/d98e6cae-0232-47b9-93d1-469e1a3e8d43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f667a2ec7f317b05615d6f5209c6393f 2x, https://si.imgix.net/febdb090/uploads/origins/d98e6cae-0232-47b9-93d1-469e1a3e8d43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6879ce659da53ad0f81074b83e64c011 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/febdb090/uploads/origins/d98e6cae-0232-47b9-93d1-469e1a3e8d43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6508deb0ca0251c0cead2c06328bf8a", "srcset": "https://si.imgix.net/febdb090/uploads/origins/d98e6cae-0232-47b9-93d1-469e1a3e8d43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6508deb0ca0251c0cead2c06328bf8a, https://si.imgix.net/febdb090/uploads/origins/d98e6cae-0232-47b9-93d1-469e1a3e8d43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9561687fe6962aadf6f4489ebd5b9898 2x, https://si.imgix.net/febdb090/uploads/origins/d98e6cae-0232-47b9-93d1-469e1a3e8d43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=18c36b3d5f97f2320b50116cdde65edb 3x"}, "body": "こんにちは。いつもお世話になっております。 一次創作の男キャラの軍服設定イラストをリクエストさせて頂きたいと思います。 \n\n ■使用目的\n観賞用として個人利用の範疇です。 私の垢（@arkmifu）に掲載させて頂きたく思いますが、許可頂けるのであれば楽之さんのお名前を表記した上でskebのリンク先を載せさせて頂きます。 もし私の名前を記載して頂けるのであれば「由地ミフ」でお願いしたいと思います。 \n\n ■内容 \n・黒っぽい緑の軍服を着ていて、ネクタイをしめています。コートは真っ黒で肩にかけています。左手に銀の持ち手の杖、右手に軍帽をもっています。ブーツは膝下でブラウンのコンバットブーツでお願いします。\n\n■資料\nhttps://x.com/arkmifu/status/1888567450700021834?s=46&t=sd4z16uqF7Ajl-Y04oH3zw\n\nお忙しいとは思いますが、よろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ranoAmph/works/13", "private_thumbnail_image