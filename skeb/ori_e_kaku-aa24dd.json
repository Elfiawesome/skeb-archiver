は付き合って10年くらいの熟年カップルのようです。\n\nポーズやシチュエーションですが、おり様がこの二人から思いつくイメージで自由に描いてくださって構いません。(現代風にアレンジしていただいてもOKです）\n\n下記にキャラクターのメモと参考画像をＵPしておりますが、おり様のほうで衣装や髪形など自由にアレンジしていただいて大丈夫です！\n\n好みに合わなかったり、料金に見合わない場合はキャンセルしていただいて大丈夫です。\n\n是非おり様に私うちの子を描いていただけるととっても嬉しいので、ご検討のほど、何卒宜しくお願い致します。\n\nhttps://www.dropbox.com/sh/uv9wnsidzr6twz0/AAA5vC37fdrbz0gN8fwBXv1oa?dl=0\n\nhttps://www.dropbox.com/sh/uv9wnsidzr6twz0/AAA5vC37fdrbz0gN8fwBXv1oa?dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ori_e_kaku/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2487030, "client_id": 1794874, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/428d4d87/uploads/origins/1d76853e-3ff4-4cb2-94ce-25fcb6cfa30d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd47e89d1913bdc8531011206e05b02e", "srcset": "https://si.imgix.net/428d4d87/uploads/origins/1d76853e-3ff4-4cb2-94ce-25fcb6cfa30d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd47e89d1913bdc8531011206e05b02e, https://si.imgix.net/428d4d87/uploads/origins/1d76853e-3ff4-4cb2-94ce-25fcb6cfa30d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a9dd5ad72f0237324b235879af3e29c 2x, https://si.imgix.net/428d4d87/uploads/origins/1d76853e-3ff4-4cb2-94ce-25fcb6cfa30d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f8328575b76bbdf5164e2afe5b7e7e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/428d4d87/uploads/origins/1d76853e-3ff4-4cb2-94ce-25fcb6cfa30d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d309576c9e1d50e9c89ee3b5657fe6ac", "srcset": "https://si.imgix.net/428d4d87/uploads/origins/1d76853e-3ff4-4cb2-94ce-25fcb6cfa30d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d309576