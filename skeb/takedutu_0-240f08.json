でもいいです。\n\n使用用途はSNS、サムネイル等を予定していますが、キーチャーム等のグッズ化もあり得ますので、出来れば商権も含めてお願いします...！\n\n金額が低すぎる場合はご自由に調整してください。\n\nご検討よろしくお願いします\nよろしくお願いします\n\nhttps://drive.google.com/drive/folders/1-CZ-e2Ih6k0i-PhclYxEN8xCOdT7JcCx?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takedutu_0/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3353238, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b42240b2/uploads/origins/d4e8f0f3-912b-4f73-9a0c-978dc26f76c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=917166bd8fffda2c95b2f78ae583b495", "srcset": "https://si.imgix.net/b42240b2/uploads/origins/d4e8f0f3-912b-4f73-9a0c-978dc26f76c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=917166bd8fffda2c95b2f78ae583b495, https://si.imgix.net/b42240b2/uploads/origins/d4e8f0f3-912b-4f73-9a0c-978dc26f76c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43a51b757ed25dc7a2bd201cf8f5c80a 2x, https://si.imgix.net/b42240b2/uploads/origins/d4e8f0f3-912b-4f73-9a0c-978dc26f76c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9af5e5b469b3f0b8fe329fd9d0d1366b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b42240b2/uploads/origins/d4e8f0f3-912b-4f73-9a0c-978dc26f76c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e185b75e3c2ee84244f94e2608fb610a", "srcset": "https://si.imgix.net/b42240b2/uploads/origins/d4e8f0f3-912b-4f73-9a0c-978dc26f76c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e185b75e3c2ee84244f94e2608fb610a, https://si.imgix.net/b42240b2/uploads/origins/d4e8f0f3-912b-4f73-9a0c-978dc26f76c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=27a9bb27bac81269d42846