\u3070\u3093\u306f\uff01\n\u3044\u3064\u3082\u7d75\u3092\u62dd\u898b\u3055\u305b\u3066\u3044\u305f\u3060\u3044\u3066\u304a\u308a\u307e\u3059\u3001\u3044\u3042\u81d3\u3067\u3059\u3002\n\u3053\u306e\u5ea6\u306f\u3001\u56fd\u57ce\u3055\u3093\u306e\u7d75\u3067\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u81ea\u30ad\u30e3\u30e9\u304c\u304a\u308a\u307e\u3057\u305f\u304c\u6545\u3001Skeb\u306e\u4f9d\u983c\u3092\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002\n\n\n\u25fc\ufe0f\u63cf\u3044\u3066\u3082\u3089\u3044\u305f\u3044\u3082\u306e\nTRPG\u3067\u4f7f\u7528\u3057\u3066\u3044\u308b\u81ea\u30ad\u30e3\u30e9\u306e\u300c\u7532\u7530\u3044\u3055\u304a\u300d\u3068\u300c\u30cf\u30c1\u30ed\u30a6\u300d\u306e\u8a08\u4e8c\u540d\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\n\n\u3010\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306b\u3064\u3044\u3066\u3011\n\u30fb\u300c\u7532\u7530\u3044\u3055\u304a\u300d\u306f\u4f1a\u793e\u54e1\u98a8\u3092\u88c5\u3063\u305f\u66b4\u529b\u56e3\u54e1\u306e57\u6b73\u306e\u7537\u6027\u3067\u3059\u3002\n\u5de6\u982c\u306b\u306f\u201c#\u201d\u306e\u5f62\u306e\u5207\u50b7\u304c\u3064\u3044\u3066\u3044\u307e\u3059\u3002\n\u670d\u88c5\u306f80\u5e74\u4ee3\u3092\u5f77\u5f7f\u3068\u3055\u305b\u308b\u30bd\u30d5\u30c8\u30b9\u30fc\u30c4\u3092\u7740\u7528\u3057\u3066\u3044\u308b\u30a4\u30e1\u30fc\u30b8\u3067\u3059\u3002\n\n\u30fb\u30fb\u30fb\u30fb\u30fb\u30fb\u30fb\u30fb\u30fb\u30fb\u30fb\u30fb\u30fb\u30fb\u30fb\n\n\u30fb\u300c\u30cf\u30c1\u30ed\u30a6\u300d\u306f\u8a50\u6b3a\u3084\u7a83\u76d7\u3092\u3057\u3066\u3044\u308b\u72af\u7f6a\u8005\u306e36\u6b73\u306e\u7537\u6027\u3067\u3059\u3002\n\u9aea\u306e\u6839\u5143\u304c\u5730\u6bdb\u306e\u9ed2\u8272\u306b\u306a\u3063\u3066\u3044\u308b(\u3044\u308f\u3086\u308b\u30d7\u30ea\u30f3\u9aea)\u306e\u91d1\u9aea\u30ed\u30f3\u30b0\u30d8\u30a2\u3067\u3001\u5de6\u76ee\u5074\u306f\u9aea\u306e\u6bdb\u3067\u96a0\u308c\u3066\u3044\u307e\u3059\u3002\n\u982c\u304c\u3084\u3084\u75e9\u305