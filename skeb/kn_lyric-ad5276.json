くおねがいします。\n\nhttps://www.dropbox.com/scl/fi/yk4q3brmg7mmw3am81tqx/mado.png?rlkey=w6qjixdbtlzajn7olq6aac2ji&dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kn_lyric/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 460559, "client_id": 2154068, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a416ba4d/uploads/origins/6f043d51-f15b-4773-b21e-ecc4efa55c92?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=488f6a5da7475e4a5456a3228738329f", "srcset": "https://si.imgix.net/a416ba4d/uploads/origins/6f043d51-f15b-4773-b21e-ecc4efa55c92?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=488f6a5da7475e4a5456a3228738329f, https://si.imgix.net/a416ba4d/uploads/origins/6f043d51-f15b-4773-b21e-ecc4efa55c92?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=34c1bbb4356471b001925d25df8ff5c8 2x, https://si.imgix.net/a416ba4d/uploads/origins/6f043d51-f15b-4773-b21e-ecc4efa55c92?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9d6855e38162a4f75f7d86272a2b1a1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a416ba4d/uploads/origins/6f043d51-f15b-4773-b21e-ecc4efa55c92?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=8a824ddc6ba3cca85623da9de29f009e", "srcset": "https://si.imgix.net/a416ba4d/uploads/origins/6f043d51-f15b-4773-b21e-ecc4efa55c92?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=8a824ddc6ba3cca85623da9de29f009e, https://si.imgix.net/a416ba4d/uploads/origins/6f043d51-f15b-4773-b21e-ecc4efa55c92?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c31bdf2e39897e8c0fb2933de9c4764b 2x, https://si.imgix.net/a416ba4d/uploads/origins/6f043d51-f15b-4773-b21e-ecc4efa55c92?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&