ormat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98cdbd107269e667efdb9f8ffd172120", "srcset": "https://si.imgix.net/ec19e886/uploads/origins/a2b6677d-0cf5-4854-9222-e9aff187d37e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98cdbd107269e667efdb9f8ffd172120, https://si.imgix.net/ec19e886/uploads/origins/a2b6677d-0cf5-4854-9222-e9aff187d37e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd049c5f6ea4d59f9732e84a2c9bcc10 2x, https://si.imgix.net/ec19e886/uploads/origins/a2b6677d-0cf5-4854-9222-e9aff187d37e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ffe8b9c1d01761f0f6e5b9665f1b103 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec19e886/uploads/origins/a2b6677d-0cf5-4854-9222-e9aff187d37e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f5cce7e5d592196c30e437f627969ad", "srcset": "https://si.imgix.net/ec19e886/uploads/origins/a2b6677d-0cf5-4854-9222-e9aff187d37e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f5cce7e5d592196c30e437f627969ad, https://si.imgix.net/ec19e886/uploads/origins/a2b6677d-0cf5-4854-9222-e9aff187d37e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dbc1d38c26ca2e532de490ed9829ee12 2x, https://si.imgix.net/ec19e886/uploads/origins/a2b6677d-0cf5-4854-9222-e9aff187d37e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=335bc8f31cd921283746cd64150f475d 3x"}, "body": "さむえさん\n\n前回大食いするタイシンのイラストを依頼させていただいた者です。\nあの話の続きを見たくなったため依頼をさせていただきました。\n\nあの後意地で、さらに3個ちょっと食べるも完全に限界が来てしまうタイシン。\n一緒に来てる人(トレーナー？)に「も、持って帰ろうよ」と言われるも、話す余裕が一切なく吐き気と闘ってる様子を描いていただきたいです。\n\n描いていただきたい要点としては、\n・前回から3個ちょっと食べた分、さらに膨れたお腹\n・もう一口も入らない、気を抜いたら戻してしまいそうなくらい満身創痍な様子(口に手を当てててほしいです)\n・ちょっとかじったくらいの4個目のハンバーガー\n・前回のような心の声\n\nせっかくなので、前回と違うアングルでお願いします(正面の方、前から見た感じも見てみたいです)\nまた、一緒に来てる人はセリフのみで大丈夫です。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://skeb.jp/@tea76225914/works/1", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tea76225914/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1277927, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c1bc860/uploads/origins/f7e58bc3-b0a8-4443-b6fa-2c041631e668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7c706b41b57a82611e2a9721d96ec47", "srcset": "https://si.imgix.net/3c1bc860/uploads/origins/f7e58bc3-b0a8-4443-b6fa-2c041631e668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7c706b41b57a82611e2a9721d96ec47, https://si.imgix.net/3c1bc860/uploads/origins/f7e58bc3-b0a8-4443-b6fa-2c041631e668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96f42bb93a9ab21fae2c61bbd2cdd63b 2x, https://si.imgix.net/3c1bc860/uploads/origins/f7e58bc3-b0a8-4443-b6fa-2c041631e668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f99b4ee8497728597b23c486c5b56cf7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c1bc860/uploads/origins/f7e58bc3-b0a8-4443-b6fa-2c041631e668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=816a5cada1bcef2dd681ebcbe7b65dc4", "srcset": "https://si.imgix.net/3c1bc860/uploads/origins/f7e58bc3-b0a8-4443-b6fa-2c041631e668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=816a5cada1bcef2dd681ebcbe7b65dc4, https://si.imgix.net/3c1bc860/uploads/origins/f7e58bc3-b0a8-4443-b6fa-2c041631e668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=708d105259097a6152700a6aee49da7f 2x, https://si.imgix.net/3c1bc860/uploads/origins/f7e58bc3-b0a8-4443-b6fa-2c041631e668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&f