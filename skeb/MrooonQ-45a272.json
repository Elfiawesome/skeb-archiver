t=mWnS0E4C7RIzyxqDj7eHuA\n\nご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://x.com/nagino_mashiro/status/1705845708610499031?s=46&t=mWnS0E4C7RIzyxqDj7eHuA", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MrooonQ/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 313753, "client_id": 2604172, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07c42102/uploads/origins/f13e4ace-753c-4e52-8e24-9f83171ee223?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9274b09a59bde16392376dd8d2d6b2e7", "srcset": "https://si.imgix.net/07c42102/uploads/origins/f13e4ace-753c-4e52-8e24-9f83171ee223?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9274b09a59bde16392376dd8d2d6b2e7, https://si.imgix.net/07c42102/uploads/origins/f13e4ace-753c-4e52-8e24-9f83171ee223?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca65957c8b9b8ca9d6817bc1149f92ae 2x, https://si.imgix.net/07c42102/uploads/origins/f13e4ace-753c-4e52-8e24-9f83171ee223?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74df6d196996446ec637cdd8f38718bc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/07c42102/uploads/origins/f13e4ace-753c-4e52-8e24-9f83171ee223?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac1be023e429c9c1ace54247482b2fa1", "srcset": "https://si.imgix.net/07c42102/uploads/origins/f13e4ace-753c-4e52-8e24-9f83171ee223?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac1be023e429c9c1ace54247482b2fa1, https://si.imgix.net/07c42102/uploads/origins/f13e4ace-753c-4e52-8e24-9f83171ee223?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b3edc093e39e1b052d0146999fff9a84 2x, https://si.imgix.net/07c42102/uploads/origins/f13e4ace-753c-4e52-8e24-9f83171ee223?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=19b311ac53b5c4e9efc3399697309397 3x"}, "body": "ねこまろさんの描かれる美麗で可愛い少年が大好きです。繊細で切なくなるような、それでいて不穏さや鋭さを感じるような作品の数々、いつも楽しく拝見させていただいております。\n\nもしよろしければ、資料URL先のオリジナルキャラクターのイラストをお願いできますでしょうか。\n\nキャラの外観：黒髪青眼で見た目年齢は12〜13くらいです。\n顔の造形は美少年！という感じで…つり目気味です。頭のてっぺんの触覚は仕様です、蝶の口吻イメージでくるん！としています。目隠れしている髪の毛だけ先っぽが若干パッツンです。その他はやわらかくくるくるしている感じです。\n\n服装は基本はURLの先の服装ですが、サスペンダーや上着はよく変わってるので、その部分を描かれる場合はお好みでひらひら描いてくださって大丈夫です！\nまた、基本の服装はありますが、基本というだけでお好きに改造改変してくださっても大丈夫です〜！\n\nポーズや雰囲気もおまかせいたします。可愛い雰囲気も怖い雰囲気もミステリアスもきゃぴっとしたのも本人よくやるので、描きたい！と思っていただけた構図でお願いします。\n青が映える雰囲気だと嬉しいかも…しれないです…！\n\n特にNG等はないです！\n\n以下はキャラ設定です、特に不必要です！という場合は読み飛ばして下さい…！\n\nお名前はディエレイといいます。\n蝶々モチーフで、主食は血液です。捉えどころがないようなくるくるふわふわした態度で人を弄んだりからかったり慈しんだり嘲笑ったり…という感じです。\n特定の相手に対しては、心から切なげな儚げな微笑みを向けることも。(そういう振りをする時も。)\nミステリアスかと思えば結構ノリがいい時もあるので純粋に楽しそう〜！にしている時もあります。お好きに描いてくださいませ…😌\n\n長文失礼しました、読んでくださってありがとうございます！\n\nURL、お好きな方から飛んでくださいますと幸いです。\n\nhttps://misskey.design/notes/9kc05lfz4u\n\nhttps://x.com/tehutehu_sizimi/status/1730176619527242165?s=46&t=NgZ2vE8X7XuWbvzlDbN0Mw", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MrooonQ/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9acec398/uploads/origins/e9ce557f-076d-42d7-9778-137b64e9610c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3444ec17c9bd9569fb0cb0b8cdc1fcec", "srcset": "https://si.imgix.net/9acec398/uploads/origins/e9ce557f-076d-42d7-9778-137b64e9610c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3444ec17c9bd9569fb0cb0b8cdc1fcec, https://si.imgix.net/9acec398/uploads/origins/e9ce557f-076d-42d7-9778-137b64e9610c?bg=%23fff&auto=format%2Ccompress&fm=webp