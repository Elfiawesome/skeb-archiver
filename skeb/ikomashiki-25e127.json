9ea59a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d70116ebd1c06dc1b25671010b3700af", "srcset": "https://si.imgix.net/db3867f6/uploads/origins/66a83886-6170-4363-8acc-bba89ea59a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d70116ebd1c06dc1b25671010b3700af, https://si.imgix.net/db3867f6/uploads/origins/66a83886-6170-4363-8acc-bba89ea59a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b128ffb2319a6d1495892012bb2bfef8 2x, https://si.imgix.net/db3867f6/uploads/origins/66a83886-6170-4363-8acc-bba89ea59a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a3b48b27b3686c2af49c9eeef2582406 3x"}, "body": "匿名にて失礼いたします。特撮の版権キャラクターにつきジャンル外でしたら申し訳ございません。『星獣戦隊ギンガマン』の悪の女幹部「操舵士シェリンダ」をお願い出来ればと存じます。\n\n衣装につきましては普段のビキニアーマーでも、想像の赴くまま任意のものを着せる形でも差支えございません。尚、衣装チェンジの例は資料中に他クリエイター様のものがございますので、よろしければ参考程度にご覧下さいませ。\n\nクールかつ可能な範囲でセクシーに、顔立ちや体型を無理にオリジナルへ寄せることなく、いこましき様の絵柄でご自由に描いていただけますと幸いです。ニッチな題材につきご面倒おかけしますが、ご検討の程何卒宜しくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Afl5NRsMDvNrdsE_8PeCZLEKpEmq3nbn?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikomashiki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1503815, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fec70e6c/uploads/origins/4f83c408-bc5e-4338-bb16-6496fd595498?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cffa99b664c6cfbff56525883a732175", "srcset": "https://si.imgix.net/fec70e6c/uploads/origins/4f83c408-bc5e-4338-bb16-6496fd595498?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cffa99b664c6cfbff56525883a732175, https://si.imgix.net/fec70e6c/uploads/origins/4f83c408-bc5e-4338-bb16-6496fd595498?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f9cf5404ba4fb38ad0220e083cee982 2x, https://si.imgix.net/fec70e6c/uploads/origins/4f83c408-bc5e-4338-bb16-6496fd595498?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2ffd7aade99b64e0ca708ebd9e53b36 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fec70e6c/uploads/origins/4f83c408-bc5e-4338-bb16-6496fd595498?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da93f116d5eedb63b5d2c33e3036169f", "srcset": "https://si.imgix.net/fec70e6c/uploads/origins/4f83c408-bc5e-4338-bb16-6496fd595498?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da93f116d5eedb63b5d2c33e3036169f, https://si.imgix.net/fec70e6c/uploads/origins/4f83c408-bc5e-4338-bb16-6496fd595498?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5026a8fbab732c4b03dbcfa4fc6e13e6 2x, https://si.imgix.net/fec70e6c/uploads/origins/4f83c408-bc5e-4338-bb16-6496fd595498?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b9661e912520e57904d2e018fa38ec1 3x"}, "body": "初めましていこましきさん。\nFGOでご依頼を掛けられる方を探している所、いこましきさんのことを見つけさせて頂きました。\n……と思い、過去作を確認させて頂きました所、更にまさかのウマ娘まで！？\nウマ娘は既に離れてしまった身かもしれませんが、それでも曲りなりにも両ジャンルを扱っていたお方！\nこれも巡り合わせと思い、よろしければ「ウマ娘のメジロアルダンに、FGOの源頼光／丑御前（アヴェンジャー）・第一再臨のコスプレ」をさせたイラストをお願いできるでしょうか！？\n\n参考\n・キャラ：メジロアルダン\nhttps://umamusume.jp/character/mejiroardan\n\n・衣装：源頼光／丑御前（FGO）\nhttps://fgogamemeister.com/archives/39506333.html\n（第一再臨はぴっちりタイツのものです）\n\n発想に至った経緯として、サポカイベントにてアルダンさんが「源頼光になった空想をする」というエピソードがあったこと。その上で彼女の勝負服が黒ベースにグリーンをあしらう丑御前（＝源頼光）カラーリングだったり、身を削る固有スキルと宝具同士や、ぶっ壊す発言繋がりなどなど……こじつけるに足る理由に個人的に盛り上がってしまったためです……。\n\n表情や構図・ポーズついては、いこましきさんが思うアルダンさんのイメージのまま描いて頂けましたらOKです。あくまで「着せ替えしたアルダンさん」を拝みたいので、コスプレ元になりきって描いて頂く必要はないです。（というか元ネタになりきられて暗く病んじゃう感じのアルダンさんは本意ではないためｗ）\n\nただ、いこましきさんがアルダンさんに触れる前にウマ娘から離れてましたら、そこは苦労を掛けてしまうかもしれませんが……その場合はもういこましきさんのイメージを信じ、感じたままの印象で描いて頂ければと思います……！ｗ\n一応キャラの備考としましては、深窓の令嬢を思わせる雰囲気から、ちょっとお茶目な面があったり、勝負（レース）に関しては覚悟が決まった芯の強さなど、ギャップによる味わいを持った子でもあります。（個人的主観ですｗ）\n\nお茶目だったりお淑やかだったり、時々カッコつけたがったり、ノリノリで着こなすでも衣装に恥じらうでも、どれも可能性としてはありそうなシーン足り得ますので、そこからとにかくいこましきさんの解釈するアルダンさんの「らしい」振る舞いとリアクションで着こなして頂ければ十分です！\n一応、コスプレ（衣装）がメインなので、なるべくならの範疇で十分ですが、全身が収まるような構図で、衣装姿のほどをご堪能させて頂ければ特に嬉しく思います……！\n\n難しいお題ということは自覚しておりますが、それでも両ジャンルに触れた経緯に信頼を託させて頂き、よろしければ何卒よろしくお願いいたします！\n\nhttps://www.pixiv.net/artworks/115999216", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 88659, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "R.シュタットフェルド/Ryuno Stadtfeld ☆Skeb募集中", "screen_name": "ryuno_stadtfeld", "avatar_url": "https://pbs.twimg.com/profile_images/1841667279777628164/5muhUAA4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/127416968/1773754224/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 49}, {"id": 100221, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ふうじゅ", "screen_name": "fujyu_koyo", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-e40547fd-2c5c-413d-87bd-50af32c1868b.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fef9568a-23a4-400d-934d-e586869228fc.gif", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 49}, {"id": 118230, "creator": true, "nsfw_acceptable": false, "acceptable": tr