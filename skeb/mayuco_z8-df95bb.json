ドしてキャラクターを用いたゲーム(TRPG)を行う可能性もございます。\n納品形式は透過PNGもしくはPSDですと非常にありがたいです。\n商用・二次配布はいたしませんが、それぞれのキャラクターの作成者さんと共有（上記と同様の使用の可能性あり）は行うと思います。\nもし不可の用途ございましたらイラスト内に記載か、透過不可の形式で納品いただければと思います。\n\nご縁があればどうぞよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mayuco_z8/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3051987, "client_id": 305783, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9842838/uploads/origins/fc0bfc40-28c6-4c92-9650-6b63d254feba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c59b934222fb4557d95c068c68ab5465", "srcset": "https://si.imgix.net/d9842838/uploads/origins/fc0bfc40-28c6-4c92-9650-6b63d254feba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c59b934222fb4557d95c068c68ab5465, https://si.imgix.net/d9842838/uploads/origins/fc0bfc40-28c6-4c92-9650-6b63d254feba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e23a07be59ed6d9f93a0eb3ac5e6efd9 2x, https://si.imgix.net/d9842838/uploads/origins/fc0bfc40-28c6-4c92-9650-6b63d254feba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b0f2e011c511eb520fb6376adc72d81 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9842838/uploads/origins/fc0bfc40-28c6-4c92-9650-6b63d254feba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5b3203e708efbde61d09abdac4ff16c", "srcset": "https://si.imgix.net/d9842838/uploads/origins/fc0bfc40-28c6-4c92-9650-6b63d254feba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5b3203e708efbde61d09abdac4ff16c, https://si.imgix.net/d9842838/uploads/origins/fc0bfc40-28c6-4c92-9650-6b63d254feba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=de8f7016cfe15090e8