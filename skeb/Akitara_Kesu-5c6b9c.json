\n最近回ったシナリオで、どっぷり浸かりに浸かったうちよそが生まれまして…\nお持ち歩きしたいのと形にしたいということで、大好きな絵柄のすり身先生にお願いしたく思います🙇‍♂️\n\n2人ともお医者さんコンビで、男性の方がちょっと距離を空けながら接しているんですけれど女の子の方がギャルマインドでガッツリ距離を詰めている距離感です。\n\n2人で1枚のアクスタにしたいと思いますので、ポーズは抱きつく女の子とちょっと慌ててる男性でお願いいたします！\n良き構図があれば全く違っても問題ないです！！\n\n28歳と43歳の15歳カップルちゃんです！\n\nどうぞよろしくお願いいたします。\n\n参考資料は以下添付いたします。\n\nhttps://drive.google.com/drive/folders/1--D49UtMbQYg3EWAJ8aUJLeMY2v6BsEA", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Akitara_Kesu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3154286, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8da99a7e/uploads/origins/0809cbe1-ff00-49a6-9d09-a57b01d6a1ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17ffb8ba78dbce147240a9aa9e69696b", "srcset": "https://si.imgix.net/8da99a7e/uploads/origins/0809cbe1-ff00-49a6-9d09-a57b01d6a1ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17ffb8ba78dbce147240a9aa9e69696b, https://si.imgix.net/8da99a7e/uploads/origins/0809cbe1-ff00-49a6-9d09-a57b01d6a1ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=effaa3ece5a061857c908817b9527679 2x, https://si.imgix.net/8da99a7e/uploads/origins/0809cbe1-ff00-49a6-9d09-a57b01d6a1ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2296ed576a84a8c145619a5a9bd9ff33 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8da99a7e/uploads/origins/0809cbe1-ff00-49a6-9d09-a57b01d6a1ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90ab33e7b514e9859e5c1fb08e0f00e4", "srcset": "https://si.imgix.net/8da99a7e/uploads/origins/0809cbe1-ff00-49a6-9d09-a57b01d6a1ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90ab33e7b514e9859e5c1fb08e0f00e4, https://si.imgix.net/8da99