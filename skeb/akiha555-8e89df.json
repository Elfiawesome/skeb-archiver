d5e1e064-6681-480f-86a0-bcfeedea32b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7ffa580d0b24fc5886dda9e7b9bf8a98 3x"}, "body": "テーマは『｢◯◯さん(2◯歳:主婦)の告白｣｢1年前､夫の留守中に新聞の拡張員に強姦されました｣』で､お願いします‼︎\n女性\n•20代くらい\n•全裸\n•放心状態\n•床に無気力な感じで大の字で倒れている\n•快感表情無し\n•ヘアあり(多少手入れがしてある程度)\n•結婚指輪が見えるように\n拡張員\n•40代くらい\n•いかにもオッさん的な感じ\n•(可能なら)ヤリ終えて一服中\n•(可能なら)人妻さんを煽るようなセリフ(｢いっぱい出たよ､奥さんw｣｢また来るからさ｡旦那によろしくなw｣等)\n•シルエット､省略可\n場所\n•リビング\n•玄関で裸にされたので､服や下着は無し\nその他\n•射精は1回だけ(中出し)\n•セリフ等改編省略可\n•名前､年齢等はお任せします\nイメージとしては｢ある性犯罪被害者の告白:平凡な主婦を襲った悲劇｣という感じで\n以上でお願いします‼︎\n\n〜〜〜追記〜〜〜\n可能ならコマ割りor複数枚にしていただけると幸いです｡\n1.対応する人妻さん\n2.玄関に散らばった服や下着\n3.本編", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@akiha555/works/18", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/36160c09/uploads/origins/9d49f8fc-3388-4eec-be6a-d6184c147f42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=efc7522d24215ccfb2092874c05c019f", "srcset": "https://si.imgix.net/36160c09/uploads/origins/9d49f8fc-3388-4eec-be6a-d6184c147f42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=efc7522d24215ccfb2092874c05c019f, https://si.imgix.net/36160c09/uploads/origins/9d49f8fc-3388-4eec-be6a-d6184c147f42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41cd262063c2db8d03bff1b6896e5328 2x, https://si.imgix.net/36160c09/uploads/origins/9d49f8fc-3388-4eec-be6a-d6184c147f42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7e2faeab91123be373b362ab9ccb4b0 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 169516, "client_id": 53190, "nc": 32}, {"path": "/@akiha555/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 169516, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21adfdc4/uploads/origins/546427ff-48ce-4ff6-8ee2-0078e035eca4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=590b08cdd12abec1c425f0446a436182", "srcset": "https://si.imgix.net/21adfdc4/uploads/origins/546427ff-48ce-4ff6-8ee2-0078e035eca4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=590b08cdd12abec1c425f0446a436182, https://si.imgix.net/21adfdc4/uploads/origins/546427ff-48ce-4ff6-8ee2-0078e035eca4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81f1882925ef9a46f4854371d23b4161 2x, https://si.imgix.net/21adfdc4/uploads/origins/546427ff-48ce-4ff6-8ee2-0078e035eca4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce2a72f336078a061213946cf6d675cc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21adfdc4/uploads/origins/546427ff-48ce-4ff6-8ee2-0078e035eca4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b04567d6a01cdc76795697cacaa881f8", "srcset": "https://si.imgix.net/21adfdc4/uploads/origins/546427ff-48ce-4ff6-8ee2-0078e035eca4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b04567d6a01cdc76795697cacaa881f8, https://si.imgix.net/21adfdc4/uploads/origins/546427ff-48ce-4ff6-8ee2-0078e035eca4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc49d143b0cf4c41cbbe2a7b0f1ce296 2x, https://si.imgix.net/21adfdc4/uploads/origins/546427ff-48ce-4ff6-8ee2-0078e035eca4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=78e8bfd4307dd6734cdc27f319cbb046 3x"}, "body": "ナマイキな人妻は薬で〜の、高岡麗子をリクエストいたします。カラーが可能なら、髪と目の色は黒色でお願いします。ネックレスは不要です。\n衣装ですが、白色のスキッパーシャツの襟が大きめで、黒色で光沢感のあるスーツでお願いします。パンストの色は原作通りです。https://imagenavi.jp/search/detail.asp?id=10603468\nスカートをまくる程度の、胸は見せない完全着衣を希望します。\n\n犯しているモブは、高岡麗子の息子みたいな、真面目に見える若い子がいいです。原作の教師くらい巨根で、全裸でいいです。ただ、麗子が小さくなるくらいなら、このモブは全身描かなくても良いです。\n\nポージングは立ちバックで後ろから激しく犯されて中出しさせて下さい。https://blog-imgs-107.fc2.com/e/r/o/erog/tachi_backstyle_20200714_033.jpg\n\nすごい気持ち良さそうな表情でお願いします。\n\nセリフが入るなら\n麗子は僕のものだ！レイプでしかイけない身体にしてやる！麗子！麗子！と暴走したモブのセリフ。\nもう許してぇ！レイプにハマっちゃう！いやぁぁぁ！と嫌がる麗子のセリフを入れて下さい。\n\nもしもう一枚可能ならば先のスーツ姿で膝立ちをし、仁王立ちしているモブの勃起して愛液や精子がつきまくっている亀頭をトロンとした表情で舐めているように描いて下さい。\nなお、全身で無くとも、お腹から上半身を描いていただき、エロい表情が大きめに描かれていれば良いです。\nセリフは、麗子のマンコをもっと苛めてぇ。レイプチンポで犯してハメ殺してぇ。くらいの、犯されすぎて、おかしくなったようなセリフを入れて下さい。\n\nなお、どちらも背景は無しで構いません。また、予算合わないと思った際には、モノクロにして頂いて構いません。\nお手数かと思いますが、是非、よろしくお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@akiha555/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 169516, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bda81b4e/requests/274022_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3da9d482c88b977647c8b3d167a03f6", "srcset": "https://si.imgix.net/bda81b4e/requests/274022_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3da9d482c88b977647c8b3d167a03f6, https://si.imgix.net/bda81b4e/requests/274022_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bc752e0b8f33eac2e7a7c1ca861cd3e 2x, https://si.imgix.net/bda81b4e/requests/274022_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b856ab1de5313f6c7e8242c6519778b 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bda81b4e/requests/274022_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5e41597dfa90ebabc9f2b025e755870", "srcset": "https://si.imgix.net/bda81b4e/requests/274022_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5e41597dfa90ebabc9f2b025e755870, https://si.imgix.net/bda81b4e/requests/274022_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=282d73c0cb8bbdf3b9a73a91b0e73ff9 2x, https://si.imgix.net/bda81b4e/requests/274022_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc7f42b6d1f897bd68d1dfc3d4b13f4e 3x"}, "body": "はじめまして\n定点視点のイラストがとても素晴らしかったので、今回ご依頼をさせていただきました。\n\nご依頼の内容は以下でお願い致します。\n\n定点視点4コマ\n深夜の公衆トイレでチンポ狂いの変態女がストレスが溜まっているサラリーマン（2人）に激しく犯される内容でお願い致します。\n\nキャラクターはPCゲーム月姫のメイド 翡翠\n衣装はメイドカチューシャ以外全裸でお願い致します。\n\n⓵トイレに入ったサラリーマンがチンポ狂いの変態女（翡翠）に声をかけられる。\n翡翠はチンポに飢えていて下品なポーズで誘う\n\n⓶正常位で中出し翡翠はガッチリと脚で男をホールド 男は乱暴な言葉を吐く 翡翠はめちゃくちゃ感じて喜んでいます。\n\n⓷お任せ致します。\n\n⓸散々犯されてトイレに捨てられる。\n翡翠のアソコにはブラシやゴミなど詰められて落書きされピクピクしています。\n\nサラリーマン達はストレス解消の為 乱暴な扱いや乱暴な言葉使いをお願い致します。\n翡翠は、どんなプレイも喜びます。\n物や家畜みたいに酷く扱われるのが、とても好きなので、よろしくお願いします。\n（ギャグレベルの行き過ぎたぐらい）\n\n以上でお願い致します。（追加など良いアレンジが御座いましたら、どんどん変更されても大丈夫です）\nお手数をお掛けいたしますが、何卒ご依頼をよろしくお願い致します。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@akiha555/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cca71df0/requests/249762_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba1a4608d0b576eb5fe9a227ba7728e6", "srcset": "https://si.imgix.net/cca71df0/requests/249762_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba1a4608d0b576eb5fe9a227ba7728e6, https://si.imgix.net/cca71df0/requests/249762_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalig