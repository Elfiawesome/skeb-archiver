b2733?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f645ae12501ffd6efcda785966ad093d 2x, https://si.imgix.net/403aeb5e/uploads/origins/e7fd991c-a334-40b2-a3c4-0ddab6eb2733?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=979095ca81e095afd91780fd296acb38 3x"}, "body": "gu-さん、こんにちは!\nいつも素敵なイラストをありがとうございます！\ngu-さんが描かれたイラストがと好きです！\nもし可能であれば、資料にあるオリジナルキャラクターを描いていただけると嬉しいです！\n\n下記の資料にあるキャラクターの中から、どなたかお一人を描いていただけたら嬉しいです!（gu-さんが描きやすい方をお選びいただければと思います）\nもちろん、もしお二人を描いていただけるようでしたら、それも大歓迎です！\nですが、どうかご無理のない範囲でお願いいたします!\n\nどうぞよろしくお願いいたします！\n\n▼キャラクター資料リンク(詳細)\nhttps://drive.google.com/drive/folders/19MJ2twPZRjbLh_WyaUP0bfuT7BiGXkK3?usp=sharing\n\n▼キャラクターについて\n舞台は江戸時代です。\n\n彼らは「靳令組（きんれいぐみ）」の局長と副局長です。\n二人が所属する組織は、歴史上の新選組に似た形式のものです。日常的な活動やその他の資料については、それを参考にしていただければと思います。\n（新選組に似た組織形式ですが、実際には完全に架空の組織で、一部の設定のみ歴史上の新選組を参考にしています。）\n\n▼キャラクター設定\n・局長（黒髪のキャラクター）\n・副局長（淡いグレー髪のキャラクター）\n\n局長・朝（あした）\n少し退廃的な雰囲気がありますが、とても明るく、仕事は丁寧にこなします。\n\n副局長・敬海（としみ）\n最大の特徴は謙虚さですが、見た目は親しみやすくても、実際には恐ろしい一面を持つ人物です。\n\n▼二人\n二人が一緒にいる時、局長はリラックスして自由な態度を見せ、副局長は控えめで謙虚な様子（いつも笑顔の表情）です。\n大多数の場合、二人は仕事に専念しており（共に任務を遂行し）、順調に進みます。\n\n▼要望など\n丁寧な一枚イラストよりも、もし可能であれば複数のラフ（rkgk）を描いていただけたら大変嬉しいです！(そうしなくても大丈夫です！)\n描きやすいように描いてください！\n\nもし金額が不足しているようでしたら、引き上げて再度お送りすることも可能ですので、どうぞよろしくお願いいたします！\nもし他の理由で描けない場合には、どうぞ遠慮なくキャンセルしてください！\n\nご検討いただけると大変感謝いたします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@m0guD2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2758640, "client_id": 989712, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/939aa9b1/uploads/origins/2edd0c8a-04c3-4cdb-9359-308dfee888b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc95711e557d4094b3d6522b1d49156e", "srcset": "https://si.imgix.net/939aa9b1/uploads/origins/2edd0c8a-04c3-4cdb-9359-308dfee888b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc95711e557d4094b3d6522b1d49156e, https://si.imgix.net/939aa9b1/uploads/origins/2edd0c8a-04c3-4cdb-9359-308dfee888b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=153b6168b951c50ef22bceaf9b418f8f 2x, https://si.imgix.net/939aa9b1/uploads/origins/2edd0c8a-04c3-4cdb-9359-308dfee888b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e0c93db92a79155b5084545cabae322 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/939aa9b1/uploads/origins/2edd0c8a-04c3-4cdb-9359-308dfee888b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9b064ea9ab3a5348e14f6d8afac524b", "srcset": "https://si.imgix.net/939aa9b1/uploads/origins/2edd0c8a-04c3-4cdb-9359-308dfee888b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9b064ea9ab3a5348e14f6d8afac524b, https://si.imgix.net/939aa9b1/uploads/origins/2edd0c8a-04c3-4cdb-9359-308dfee888b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8f4ef10f0601fb47695a676198c2e45e 2x, https://si.imgix.net/939aa9b1/uploads/origins/2edd0c8a-04c3-4cdb-9359-308dfee888b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6d67ef1be3b9b37f4356de2f3674a5e 3x"}, "body": "はじめまして。\ngu-さんの描かれるゆるいデフォルメが効きながらも整ったバランス感、可愛い顔立ちのキャラクター達がとても素敵で、リクエストを送らせて頂きました。\n差し支えなければ、資料のOCを描いていただきたいです。\n\n┈┈┈┈┈┈┈┈┈┈\n■🧀\n名前：Algernon(アルジャーノン)\n190cm後半/20代後半〜30代前半くらいの見た目/男性\n\nモチーフ：不思議の国のアリスに出てくる眠りネズミ\n\n穏やかで、僅かな影が目立つ男性。性善説を信じている。\n感情を激しく揺らすこともなければ、他からの言葉に過敏に反応することもほとんど無い。\n理屈を重視し、相手の立場や心情に配慮したうえで会話や行動を選びたがる。\n\n尻尾はそのまま、カバーは無しで、顔の包帯も無しが正規のデザインです。\n\n┈┈┈┈┈┈┈┈┈┈\n\nシチュエーションや構図は思いついたものを自由に描いて頂けたら嬉しいです。\n金額や資料に不足がありましたら、御手数ですが再送やキャンセルをお願いします。\nご検討いただけましたら幸いです。よろしくお願いします🌸\n\nhttps://drive.google.com/drive/folders/13MBGn4V5FvJ6HZyDSJeyTIoqIsAZ8WfP", "nc": 128, "word_count": 0, "transc