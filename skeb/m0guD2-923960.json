たかったわけじゃない」と装いながら、結局すぐに絆されてしまう。\n\n📌関係設定：\nhttps://drive.google.com/file/d/1fVDagCedAsU1R-VHvJHYIpGdHEBnymrM/view?usp=drive_link\n\n✨植物や海の要素を取り入れていただけると嬉しいです。\nあくまで参考まで、個人的には幸せな日常の中に、少し切なさや夢のような歪んだ雰囲気が気に入ったが、何よりもgu-様のインスピレーションを最優先にしてお願いします。\n構図等はすべてお任せ致します。\n\nお忙しい中、ご検討ありがとうございました。よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1Gguym4jHG1nAIjkipDXRChoyOZGK4WOf?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@m0guD2/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2758640, "client_id": 3137473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2e8c6857/uploads/origins/7d20a8b0-39fc-41a1-b1c7-651ff7663938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=660fd004f60fb0d45efbcd140a3257ba", "srcset": "https://si.imgix.net/2e8c6857/uploads/origins/7d20a8b0-39fc-41a1-b1c7-651ff7663938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=660fd004f60fb0d45efbcd140a3257ba, https://si.imgix.net/2e8c6857/uploads/origins/7d20a8b0-39fc-41a1-b1c7-651ff7663938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=753172cc2a1634eee4ca350604a0954c 2x, https://si.imgix.net/2e8c6857/uploads/origins/7d20a8b0-39fc-41a1-b1c7-651ff7663938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10696fddd0977b1faff0406a9e00e870 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e8c6857/uploads/origins/7d20a8b0-39fc-41a1-b1c7-651ff7663938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=477494442e2ec1e3840b8a72a6dd2d09", "srcset": "https://si.imgix.net/2e8c6857/uploads/origins/7d20a8b0-39fc-41a1-b1c7-651ff7663938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=477494442e2ec1e3840b8a72a6dd2d09, https://si.i