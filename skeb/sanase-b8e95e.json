fc28a3f7b4b9d8bea13f 2x, https://si.imgix.net/b3814d47/uploads/origins/e1cba4a1-aded-433b-bbb9-bb048fa11e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed2bc5fae1181fdb1fdc878452637e5b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3814d47/uploads/origins/e1cba4a1-aded-433b-bbb9-bb048fa11e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9d9aa2898c1e1819206f446763cc9be", "srcset": "https://si.imgix.net/b3814d47/uploads/origins/e1cba4a1-aded-433b-bbb9-bb048fa11e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9d9aa2898c1e1819206f446763cc9be, https://si.imgix.net/b3814d47/uploads/origins/e1cba4a1-aded-433b-bbb9-bb048fa11e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a4c2250b193a572152ca3edaea6affbf 2x, https://si.imgix.net/b3814d47/uploads/origins/e1cba4a1-aded-433b-bbb9-bb048fa11e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=94a8ac752f87167f4dd3f81fa25cc562 3x"}, "body": "こんにちは！\n\n他のアーティストのイラストを発展させてほしい。\n\n黒髪のキャラクター（ステファニー・マクレール）には、ある種の長い銃が必要です。ダブルバレルショットガンとか、レバーアクションライフルとか。\n\n金髪のキャラクター（ステラ・スター）には、腰のリボルバーと、彼女が普段持っている双剣の、より良いバージョンが必要だ。  参考のために彼女の普段着を載せておくが、このカウボーイ服の場合、双剣は背中の鞘に入れて背負うのだろう。\n\nブーツも参考までに載せておきます。それ以外の変更は最小限にしてください。\n\nご検討ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1hb7EZIG_SH-iU_oVlbVDwJIy19bmB63U", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sanase/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1329706, "client_id": 1007331, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e886976/uploads/origins/c2940b04-1e3c-4c75-9d2b-269144d2a505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f97b4f436dcb167b4dda6cc4b5380f6f", "srcset": "https://si.imgix.net/3e886976/uploads/origins/c2940b04-1e3c-4c75-9d2b-269144d2a505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f97b4f436dcb167b4dda6cc4b5380f6f, https://si.imgix.net/3e886976/uploads/origins/c2940b04-1e3c-4c75-9d2b-269144d2a505?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6ea5ad6d096bdeb911e762fc9965ceb 2x, https://si.imgix.net/3e886976/uploads/origins/c2940b04-1e3c-4c75-9d2b-269144d2a505?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26253b5125b187568694b4dc0b0097b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e886976/uploads/origins/c2940b04-1e3c-4c75-9d2b-269144d2a505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4053e42f3b45425d0f01f5b79289f6f0", "srcset": "https://si.imgix.net/3e886976/uploads/origins/c2940b04-1e3c-4c75-9d2b-269144d2a505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4053e42f3b45425d0f01f5b79289f6f0, https://si.imgix.net/3e886976/uploads/origins/c2940b04-1e3c-4c75-9d2b-269144d2a505?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=83e23552a7ceae7283e8876675960c32 2x, https://si.imgix.net/3e886976/uploads/origins/c2940b04-1e3c-4c75-9d2b-269144d2a505?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=315ae387ea7598c4d6c55aca15c82d34 3x"}, "body": "先日は素晴らしいガンマン娘の漫画、ありがとうございました。今回は2Pの漫画を希望いたします。\n\n1P\n・前回の漫画の1,2Pの間のシチュ\n・ガンマン娘登場な雰囲気の全身を映した大ゴマ\n（自信ありげな表情。ホルスターから少し手を離している。）\n・捕まえた悪党にリボルバーを向けながら2人で歩くコマ。悪党の弾が当たった場所には包帯。リボルバーの撃鉄が上がっており「やるときはやる」という描写。\n\n2P\n・前回の漫画の3,4Pの間のシチュ（射撃練習）\n・柵の上の瓶が割れるコマ\n・真剣な表情でリボルバーを撃つガンマン 娘のコマ\n・可能でしたら上記2コマの別角度シチュをもう1度\n・6回の「パン」「パンッ」「パァン」等銃声の描き文字（６発撃った事の表現、配置はお任せします。）\n・撃ち終わった後、硝煙が出ているリボルバーを手に安堵している表情のガンマン娘のコマ\n\n・自由にシーン・コマの追加をしていただいても構いません。\n\n恐れ入りますがよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sanase/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1329706, "client_id": 1007331, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68827d8a/uploads/origins/0a188e23-8c28-48ad-a999-cc5b2cb02a72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff5a11aac14b02918d6eaa7b2c12c77f", "srcset": "https://si.imgix.net/68827d8a/uploads/origins/0a188e23-8c28-48ad-a999-cc5b2cb02a72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff5a11aac14b02918d6eaa7b2c12c77f, https://si.imgix.net/68827d8a/uploads/origins/0a188e23-8c28-48ad-a999-cc5b2cb02a72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1968ea230650a150c2d6b4cb5993d55c 2x, https://si.imgix.net/68827d8a/uploads/origins/0a188e23-8c28-48ad-a999-cc5b2cb02a72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66b08e37ae3f8cb6af531f631a631c72 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68827d8a/uploads/origins/0a188e23-8c28-48ad-a999-cc5b2cb02a72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a21a1595063bbe59f577448199820fca", "srcset": "https://si.imgix.net/68827d8a/uploads/origins/0a188e23-8c28-48ad-a999-cc5b2cb02a72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a21a1595063bbe59f577448199820fca, https://si.imgix.net/68827d8a/uploads/origins/0a188e23-8c28-48ad-a999-cc5b2cb02a72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aebcddb5e2b9df33ef4866f40ff69461 2x, https://si.imgix.net/68827d8a/uploads/origins/0a188e23-8c28-48ad-a999-cc5b2cb02a72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95b6fa7e889b82d2ad51c6aa52b635c7 3x"}, "body": "2度目のリクエスト（前回は匿名）を希望致します。コミックをされているという事でガンマン娘の短編漫画を依頼したいと思います。\n\n内容として\n1P\n・ガンマン娘が悪党との決闘に臨み、リボルバーを撃つコマ。\n・硝煙の出るリボルバーの銃口にフッと息を吹くコマ。\n・ホルスターにリボルバーをしまうコマ。\n2P\n・賞金を貰って大喜びするガンマン娘のコマ\n・貰った賞金で日常を過ごす数コマ（肉をがっつり食べてる、牛に干し草あげてるなど…内容はおまかせします。）\n3P\n・街中で財布が軽くなって泣いてるコマ\n・悪党の手配書に気がつくコマ\n・悪党の手配書のコマ\n・ガンマン娘の自信ありげな表情のコマ。\n（私にでもやっつけられそうな表情）\n4P\n・自宅に帰ってリボルバーに弾を込めるコマ。\n・リボルバーにキスをするコマ。\n・「明日はよろしくね。相棒。」とリボルバーに話しかけるガンマン娘のコマでエンド\n\n・ガンマン娘の服装はニコニコ静画、前回のイラストと同じ服装。\n・基本的に台詞は無し\n・コマの間に自由にシーン等を入れていただいても構いません。\n\n大変恐縮ですが、よろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sanase/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1329706, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e7c7bd1/uploads/origins/4b178b7e-b9ff-44e0-9d2a-5559f809a1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea07aae12cdd3f4635049654cf5c84f2", "srcset": "https://si.imgix.net/7e7c7bd1/uploads/origins/4b178b7e-b9ff-44e0-9d2a-5559f809a1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea07aae12cdd3f4635049654cf5c84f2, https://si.imgix.net/7e7c7bd1/uploads/origins/4b178b7e-b9ff-44e0-9d2a-5559f809a1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c302320bac520ceef0c9ef56308eee42 2x, https://si.imgix.net/7e7c7bd1/uploads/origins/4b178b7e-b9ff-44e0-9d2a-5559f809a1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c098e50aadff3861cc7e58ab6e35b4ee 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e7c7bd1/uploads/origins/4b178b7e-b9ff-44e0-9d2a-5559f809a1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d98162dc6871cc63fae71c3654ef3f61", "srcset": "https://si.imgix.net/7e7c7bd1/uploads/origins/4b178b7e-b9ff-44e0-9d2a-5559f809a1fa?bg=%