ーは最後に彼に「いい子ね <3」と告げる。\n\nできればコミックにはこれらのシーンを盛り込んでほしいですが、必要に応じて自由に変更していただいて構いません。どのような仕上がりでも私にとっては良い結果です。\nもし何か失礼な点があればお詫びします。ご配慮いただきありがとうございます。\n\nhttps://drive.google.com/drive/folders/1LcKt-Tc9rTdXZnPfOdx9tWlngITQ-GER", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Chokipeace/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/542e16fc/uploads/origins/63a412ed-8ca0-4b21-a141-0d90507253ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69aaabecda122b6b1802f201ca4a4033", "srcset": "https://si.imgix.net/542e16fc/uploads/origins/63a412ed-8ca0-4b21-a141-0d90507253ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69aaabecda122b6b1802f201ca4a4033, https://si.imgix.net/542e16fc/uploads/origins/63a412ed-8ca0-4b21-a141-0d90507253ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1553c032f51c13137bd1861f6580c4b8 2x, https://si.imgix.net/542e16fc/uploads/origins/63a412ed-8ca0-4b21-a141-0d90507253ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=babd6d86b7aa20717cdeccb44f3b0688 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3624759, "client_id": 3385141, "nc": 160}, {"path": "/@Chokipeace/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/df38c5fb/uploads/origins/3e179f12-e103-49a6-917e-8b93772bbf78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9fdcbcae07aa2e3dd80