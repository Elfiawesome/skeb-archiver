ak&start_radio=1&ab_channel=%E3%81%9F%E3%81%8B%E3%82%84%E3%82%93%2FTakayan\n\nキャラクターがカメラ目線で、手元のスマートフォンを何気なくいじっている様子をお願いします。スマートフォンの画面には、アンチからの通知が表示されているようにしてください。\n\n表情差分として、以下をお願いします：\n不機嫌そうな表情\n自信たっぷりで挑発的な表情\n\n衣装はキャラクターと歌とに似合うかっこいいでお願いします。\n\nキャラクタ特徴：\n·左目の下と口の右側の下のほくろ、目の下のクマ、長いまつげ、オレンジと青色のマニキュアです。（バストCカップ）\n·髪色を変わらないでほしいですが、髪型や長さは先生が自由に決めてもいいです。\n\nサイズ・形式\n・ビデオを作るので、16:9の横書きで、なるべく高い解像度でお願いします。\n・キャラクターと前景と背景を別レイヤーにしてもらいたいです。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1mqTTo0BuZBHgnm4pU5R7cfoC4N2j085g?usp=sharing\n\nhttps://drive.google.com/drive/folders/1mqTTo0BuZBHgnm4pU5R7cfoC4N2j085g?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@okakiatta/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2790496, "client_id": 2942826, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86ef85a5/uploads/origins/a5f1cc25-fe40-4c7f-a7d4-1534c72bdcd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ddc4be00190856e85474cd77850d8d9", "srcset": "https://si.imgix.net/86ef85a5/uploads/origins/a5f1cc25-fe40-4c7f-a7d4-1534c72bdcd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ddc4be00190856e85474cd77850d8d9, https://si.imgix.net/86ef85a5/uploads/origins/a5f1cc25-fe40-4c7f-a7d4-1534c72bdcd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98ace4129e8ea9c533bbdfbb05f03be0 2x, https://si.imgix.net/86ef85a5/uploads/origins/a5f1cc25-fe40-4c7f-a7d4-1534c72bdcd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2cc21de2c3c1961891d320dc9c041a4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86ef85a5/uploads/origins/a5f1cc25-fe40-4c7f-a7d4-1534c72bdcd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8aad4310ca4ea81a08f