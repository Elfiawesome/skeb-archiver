により敵を倒すペリドット\n④敵は撃退しても、身体が限界を迎えていたペリドットは変身を解いたあと動くことができず、変身の際ベースとなった森に住む魔物たちの実体に無力な女の子の姿で犯される\nこんな感じになります。この全てをイラスト化いただきたいとは申しませんので、金額の範囲内で可能な範囲で、気が進めば受注のほどお願いいたします。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kunon909/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 232562, "client_id": 44650, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb9d61c1/uploads/origins/a67af929-ccf1-4c6f-aecd-290c94603df1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1da6e1050a9ace7632bd6392a3ede480", "srcset": "https://si.imgix.net/bb9d61c1/uploads/origins/a67af929-ccf1-4c6f-aecd-290c94603df1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1da6e1050a9ace7632bd6392a3ede480, https://si.imgix.net/bb9d61c1/uploads/origins/a67af929-ccf1-4c6f-aecd-290c94603df1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9cf8215b7da491868294026890edd52f 2x, https://si.imgix.net/bb9d61c1/uploads/origins/a67af929-ccf1-4c6f-aecd-290c94603df1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fb496cbbacef1547b8e0fd77a371e87 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb9d61c1/uploads/origins/a67af929-ccf1-4c6f-aecd-290c94603df1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=973a83e19441eaac03405a0657a9f77c", "srcset": "https://si.imgix.net/bb9d61c1/uploads/origins/a67af929-ccf1-4c6f-aecd-290c94603df1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=973a83e19441eaac03405a0657a9f77c, https://si.imgix.net/bb9d61c1/uploads/origins/a67af929-ccf1-4c6f-aecd-290c94603df1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=84b5875449e4c27ca93426cde1f39cc6 2x, https://si.imgix.net/bb9d61c