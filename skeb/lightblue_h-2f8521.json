ranscoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usui_iigame/works/237", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 564290, "client_id": 1401203, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/113df4ee/uploads/origins/bd4a45dd-c0cd-459e-9b64-509d63378ddd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77d4d695735c7cd4b58074aee135a0e8", "srcset": "https://si.imgix.net/113df4ee/uploads/origins/bd4a45dd-c0cd-459e-9b64-509d63378ddd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77d4d695735c7cd4b58074aee135a0e8, https://si.imgix.net/113df4ee/uploads/origins/bd4a45dd-c0cd-459e-9b64-509d63378ddd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45989b07982c433a9d1dd97575fe44ef 2x, https://si.imgix.net/113df4ee/uploads/origins/bd4a45dd-c0cd-459e-9b64-509d63378ddd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d395b4ac7556cc348394146795e3754a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/113df4ee/uploads/origins/bd4a45dd-c0cd-459e-9b64-509d63378ddd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8d58a3b130a9c378910b13e7446cdca", "srcset": "https://si.imgix.net/113df4ee/uploads/origins/bd4a45dd-c0cd-459e-9b64-509d63378ddd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8d58a3b130a9c378910b13e7446cdca, https://si.imgix.net/113df4ee/uploads/origins/bd4a45dd-c0cd-459e-9b64-509d63378ddd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2b7f5a0de289a1d2dcdfe8fa9e9fa150 2x, https://si.imgix.net/113df4ee/uploads/origins/bd4a45dd-c0cd-459e-9b64-509d63378ddd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4df4508586f693049285e86404498b92 3x"}, "body": "ウスイ兄チャマこんにちは。先日は超会議内超メイド村&カラオケ館掲出、誠におめでとうございました。どちらも来場し、楽しませていただきました。\n\nリクエストですが、「オールスター感謝祭におさると一緒に出演したものの、クイズパートで全くおさるの力になることができず、悔しがるバーチャルいいゲーマー」をお願いします。\n2023/04/22の放送「ゲーム★タレント名鑑 」内でプレイされた「TBSオールスター感謝祭 Vol.1 超豪華!クイズ決定版」で、おさるの代わりにクイズに回答するが、まったく爪痕を残せず悔しがるバーチャルいいゲーマーがとても印象に残ったので、リクエストさせていただきました。\n\nイラストの内容として、本家オールスター感謝祭のお祭り感のあるセットが好きなので、背景はオールスター感謝祭だとわかるものでお願いします。回答席に座り、横に番号のランプと名札のある構図だと嬉しいです。また、人物はバーチャルいいゲーマーだけでも問題ありません。\n資料URLはリクエストを送るきっかけになったすきシーンのスクショをまとめたものですので、もしよろしければ参考にご覧ください。\n以上、よろしくお願いいたします。\n\nhttps://twitter.com/lightblue_h/status/1659883261940891648?s=20", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usui_iigame/works/160", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 564290, "client_id": 1401203, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33ba52f7/uploads/origins/c1afa6ca-40a6-444d-ad73-12b6f67b0c42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bddfee70837aa6275e52fdbdad0816bc", "srcset": "https://si.imgix.net/33ba52f7/uploads/origins/c1afa6ca-40a6-444d-ad73-12b6f67b0c42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bddfee70837aa6275e52fdbdad0816bc, https://si.imgix.net/33ba52f7/uploads/origins/c1afa6ca-40a6-444d-ad73-12b6f67b0c42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c703ebac6f699e5784b41c0926970ad 2x, https://si.imgix.net/33ba52f7/uploads/origins/c1afa6ca-40a6-444d-ad73-12b6f67b0c42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81eb7ab6aa53abfa48989d5273b484d5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33ba52f7/uploads/origins/c1afa6ca-40a6-444d-ad73-12b6f67b0c42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e13d2d07d0be37252392339d14f711fb", "srcset": "https://si.i