ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e1c1434233930e79f88801523998399, https://si.imgix.net/66635716/uploads/origins/e0016077-d904-475c-b441-8d691ac102bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad66a529fb304c335e91a098799d109a 2x, https://si.imgix.net/66635716/uploads/origins/e0016077-d904-475c-b441-8d691ac102bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ef59f47d9b8bfc7d8d6951832aef35d9 3x"}, "body": "こんにちは！私の友人が、以前あなたからいただいたイラストをとても気に入っていて、私を通じて依頼したいと言っています。以下が彼からのメッセージです：\n\nこんにちは、ナイトと申します。あなたのイラストは本当に素晴らしいので、ぜひ依頼させていただきたいです！\n\n私のキャラクターの名前は「キメラ」です。彼女はクールで物静かですが、実はかなり不器用で、暗殺者として働いています。\n\nリンク先に、彼女の外見や服装の参考画像を添付しました。もしよろしければ、彼女の全体的な雰囲気に合うよう、提供した服装を少し未来的なデザインにアレンジしていただいても構いません。\n\nご依頼をご検討いただき、ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1902USFLnON_PZGlhcykeCY0e9E8fzr8S?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kmnnk69315/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1650521, "client_id": 3154071, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c410c469/uploads/origins/3c9077de-5c03-4b98-9869-238206ad00e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cb33ea27d831b99c5b82de737c8f398", "srcset": "https://si.imgix.net/c410c469/uploads/origins/3c9077de-5c03-4b98-9869-238206ad00e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cb33ea27d831b99c5b82de737c8f398, https://si.imgix.net/c410c469/uploads/origins/3c9077de-5c03-4b98-9869-238206ad00e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=483b65f7735fcc2b6ec95f959e6f9a3d 2x, https://si.imgix.net/c410c469/uploads/origins/3c9077de-5c03-4b98-9869-238206ad00e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c493af887ecf8177bffafb734b383e48 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c410c469/uploads/origins/3c9077de-5c03-4b98-9869-238206ad00e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46cbb977873b4d98fab3dc1184066e4c", "srcset": "https://si.imgix.net/c410c469/uploads/origins/3c9077de-5c03-4b98-9869-238206ad00e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46cbb977873b4d98fab3dc1184066e4c, https://si.imgix.net/c410c469/uploads/origins/3c9077de-5c03-4b98-9869-238206ad00e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a88bfb4a3a604508d6d75bfc90caa0c6 2x, https://si.imgix.net/c410c469/uploads/origins/3c9077de-5c03-4b98-9869-238206ad00e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f0f86521f3e344ef4dfecc3e9a7f61e 3x"}, "body": "獣のケさん、Skebを再開してくださって、とても嬉しいです。いつも素敵な作品を拝見しています🥺\nもし可能でしたら、前回の二人をもう一度描いていただけたら嬉しいです。ご都合が難しい場合は、もちろんお断りいただいて大丈夫です。\n\n資料は↓をご確認いただけると幸いです。\nhttps://drive.google.com/drive/folders/1Pa71hrUHT8dRwUp4x1t8GgJEk6x7tQhB?usp=drive_link\n世界観　未来主義の戦後平和時代\n\n・P（攻）\n・紫髪紫眼・三白眼\n・彼は服装にはあまり気を使わないのでネクタイが乱れています\n・イヤリングは羽根素材です\n・183cmくらい\n・ある組織のリーダー、見た目は軽薄で、いつも笑っていますが、恋愛感情が少し幼稚です.\n能力が高い,基本的に欲しいものは何でも手に入るので、自分のことも仕事のことも好き勝手です（でも、下手なわけではありません）、欲しいものが自分のものではないと、気むずかしいで怒りっぽくなりがちです。\n基本的にGの前では90%本物の彼です。\n\n・G（受）\n・赤髪黒目・常に「顔は女のように綺麗」と言われま\n・いつも無表情で無愛想に見える・表情があっても幅が小さいです\n・171ｃｍくらい\n・過去のトラウマが感情的欲求や記憶の一部を失っているため鬱状態になっているのです\n\n彼らの関係は簡単に言えば、「主人」と「寄生植物」のようなものです。Pは口では「面倒だ」と言いながらも、植物を丁寧に世話する世話係のような存在であり、Gはか弱く美しい植物のような存在です。\n\nもし可能でしたら、先生に新しい衣装を着た二人を描いていただけたら嬉しいです。\n\nぜひ、自由に描いてみてください。ポーズ、色、衣装はお任せします。\nラフ画や下絵があれば、お送りいただけると嬉しいです。\nPSDデータで納品していただけると幸いです。また、背景や宛名がある場合は別レイヤーでお願いできるととても助かります。\n何か不都合があれば、遠慮なくお断りいただいても構いません。お忙しいところ恐れ入りますが、ご検討のほどよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kmnnk69315/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1650521, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b7df063/uploads/origins/e6bfb59e-2bd9-46eb-a9a7-52b4203191d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebaecfbc71d6365a7da71d78376acec7", "srcset": "https://si.imgix.net/4b7df063/uploads/origins/e6bfb59e-2bd9-46eb-a9a7-52b4203191d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebaecfbc71d6365a7da71d78376acec7, https://si.imgix.net/4b7df063/uploads/origins/e6bfb59e-2bd9-46eb-a9a7-52b4203191d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2825c61df1452a1aceefb32fc4984aa3 2x, https://si.imgix.net/4b7df063/uploads/origins/e6bfb59e-2bd9-46eb-a9a7-52b4203191d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7cfe4b624477e331b255b6a6f4771a25 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b7df063/uploads/origins/e6bfb59e-2bd9-46eb-a9a7-52b4203191d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d06a57126a50a9ac743e4b6ffba7827e", "srcset": "https://si.imgix.net/4b7df063/uploads/origins/e6bfb59e-2bd9-46eb-a9a7-52b4203191d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d06a57126a50a9ac743e4b6ffba7827e, https://si.imgix.net/4b7df063/uploads/origins/e6bfb59e-2bd9-46eb-a9a7-52b4203191d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=24af8a1564a453c5ca0e1791c44da472 2x, https://si.imgix.net/4b7df063/uploads/origins/e6bfb59e-2bd9-46eb-a9a7-52b4203191d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e974d0cad6fadfa32d9c716a6a368a1 3x"}, "body": "私のOCを描いていただけませんか？\n\n特徴は？\n-非常に青白い肌、わずかにピンクや紫がかっている。奇妙で異質に見える。\n-明るいヘーゼル色の目。\n-黒髪で、頭から後ろに向かって梳いてある。肩より上の長さで、少し不揃いにカットされている。髪は細く、ひょろひょろしている。生え際は浅いピーク。\n\n服装は、リンク先の参考資料のどれかに従っていただいても結構ですし、多少逸脱していただいても結構です。デザインが逸脱していても、以下の服装の詳細を記載してください：\n-ハイネックシャツ、灰色がかった紺色。襟には明るい銀色の装飾。長袖で、袖の裾に明るいシルバーの装飾がある。クロージャーは中央ではなくサイドにある。\n-黒い手袋は背中に硬い金属が付いている。\n-右耳は軟骨の縁の上にシルバーのイヤーカフ。\n-両耳に銀のピアス。\n\n性格\n-自己満足的で飄々としている。他人の意見を気にせず、自分が正しいと信じることに向かって独自に行動する。冷静に面白がっているように見せかけ、周囲の世界は自分には関係のないただの娯楽であるかのように振る舞うが、その仮面の裏では非常に観察力が鋭く、計算高い。非常に支配的な振る舞いをする。自分が関わるどんな状況でもコントロールしようとし、観察力を駆使してできるだけ多くの情報を得て利用しようとする。気にかける人は少ないが、気にかける数少ない人に対しては非常に強い独占欲を抱く。善を行いたいと願っており、それに値する人々を助けたいと心から願っている。未来のため、そして愛する数少ない人々のために、すべてを犠牲にすることも厭わないが、信頼に欠けており、信頼がなければ助けようとはしない。\nテクノロジーに長けており、自分に興味のある人物を観察したりコントロールしたりするために、どんな道具でも使う。彼はしばしば孤独である。孤独を感じることが多いが、これは個人的な弱点であり、すぐに直すべきものではないと考えている。彼の行動は他人を自分から遠ざけ、普段は他人と直接交流しないようにしている。\nこのキャラクターを好きなように描いてください。\n\nhttps://drive.google.com/drive/folders/1hmWvDjGd7yj3fTG0jZDk8UC2-mR5Lg0Q", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kmnnk69315/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8a912541/uploads/origins/722cef86-a55b-4923-bc37-d5134d8af7c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f01f74e168360a60e9bf3382b9dec567", "srcset": "https://si.imgix.net/8a912541/uploads/origins/722cef86-a55b-4923-bc37-d5134d8af7c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f01f74e168360a60e9bf3382b9dec567, https://si.imgix.net/8a912541/uploads/origins/722cef86-a55b-4923-bc37-d5134d8af7c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ff86d0c3deeedf6274b4e5baedebbbf 2x, https://si.imgix.net/8a912541/uploads/origins/722cef86-a55b-4923-bc37-d5134d8af7c3?bg=