ogle.com/drive/folders/1ZLv6zz12P_tKkzZg0HCWZoHsJeUjG0nP?usp=drive_link \n\n\n【構図など】\n・シチュエーション：キッチンでお料理している姿（背景有無はお任せします）\n・構図：サムネ等に使用したいため、頭や髪が見切れない構図で、\n　　　　もし可能であれば腰回りまで入れていただけますと幸いです...！\n・イメージ：『お姉さん・可愛い』雰囲気\n　下記のイラストがとても好みでした！こちらに近いととても嬉しいです！\n　　https://www.pixiv.net/artworks/106151307\n　　セクシーな衣装にフブキちゃんの可愛さが溢れていて大好きです！\n　　https://www.pixiv.net/artworks/101198647\n　　可愛らしい表情と、今にも動きそうなミオちゃんの躍動感あるポーズがとっても素敵です！\n\n\n【データ形式】\n　もし可能でしたら下記データにていただけますと幸いです。\n　・PSD\n　・人物、背景、サインのレイヤーが分かれている状態\n\nご縁がございましたら、何卒よろしくお願いいたします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@minekazuna/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1233667, "client_id": 2191345, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb88f79d/uploads/origins/ec2070b4-eaf4-4c55-ab38-10d05ab10696?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10d83791c20f18ee70c9b663f89504d1", "srcset": "https://si.imgix.net/bb88f79d/uploads/origins/ec2070b4-eaf4-4c55-ab38-10d05ab10696?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10d83791c20f18ee70c9b663f89504d1, https://si.imgix.net/bb88f79d/uploads/origins/ec2070b4-eaf4-4c55-ab38-10d05ab10696?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce924d4b026084d5c7e6d87665250b3c 2x, https://si.imgix.net/bb88f79d/uploads/origins/ec2070b4-eaf4-4c55-ab38-10d05ab10696?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1cc1d8a7ab8e03d8c8530584a5a6828 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb88f79d/uploads/origins/ec2070b4-eaf4-4c55-ab38-10d05ab10696?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2694c6782bfb55d40d1588d0405cfc4", "srcset": "https://si.imgix.net/bb88f79d/uploads/origins/ec2070b4-eaf4-4c55-ab38-