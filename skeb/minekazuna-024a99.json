イラスト\n\n〇詳細\nこのたび彼女の新衣装をお披露目があり、その衣装をお願いしたくてリクエストをしました！\n希望としては、サイドテールの髪型でメガネを両手で持ち上げてるような仕草をお願い出来たらと思います！\n↓こちらが彼女の衣装のリンクですのでこちらを参考にしていただけたらと思います！\nhttps://nekiprofile.amebaownd.com/posts/48462473/\n\n・もし可能であれば、リクエストした本人のVtuber活動での使用の許可(配信サムネイルやSNSでの告知等)を頂ければ幸いです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@minekazuna/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1233667, "client_id": 2506061, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d99979e/uploads/origins/437029da-7253-49b7-af60-9b28be1a9ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c63ff64790e66c545f13741a6abfbe20", "srcset": "https://si.imgix.net/2d99979e/uploads/origins/437029da-7253-49b7-af60-9b28be1a9ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c63ff64790e66c545f13741a6abfbe20, https://si.imgix.net/2d99979e/uploads/origins/437029da-7253-49b7-af60-9b28be1a9ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=471fe9ea5b0986a6fc0d61bb85d08f31 2x, https://si.imgix.net/2d99979e/uploads/origins/437029da-7253-49b7-af60-9b28be1a9ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f165297cd5e9c01b8e028ae4c0146362 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d99979e/uploads/origins/437029da-7253-49b7-af60-9b28be1a9ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=825c6a5fb91aba8443ecee8f4325b6ea", "srcset": "https://si.imgix.net/2d99979e/uploads/origins/437029da-7253-49b7-af60-9b28be1a9ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=825c6a5fb91aba8443ecee8f4325b6ea, https://si.imgix.net/2d99979e/uploads/origins/437029da-7253-49b7-af60-9b28be1a9ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&dp