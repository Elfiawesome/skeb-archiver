rop&crop=top&w=200&h=200&blur=200&s=f0a5212eb24c0b646f9d2b8b86cb593e", "src_set": ""}, "body": "募集が開始されたのでリクエストします。\n\nキャラは理麻ちゃん！！\n\nバニーガールの衣装でストッキングを履いているのが見えるくらいでお願いします。\n全身が見えるイラストでも可。服装に色の指定はありません。\n手でハートを作って欲しいです。\nバニーガール衣装の乳首がギリギリ見えるか見えないくらいの誘ってる感じでお願いします。\nエッチなイラストになるのは問題ありません。飾るのにギリギリのチラリズムが好みなだけなのでむとさんの理麻ちゃんはこっちの方が似合うがある場合はそちらを優先して欲しいです。\n\n\nアソコは露出無しでお願いします。\n\n今回も印刷の利用をしたいと思っているので台詞等は無しでお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yumanonnon/works/41", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/522adfd3/uploads/origins/b369c275-27cf-4b23-87e6-6e85bb732579?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=296c2856113cad2ef2a5d9aa91b2cb0a", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 49066, "client_id": 126448, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yumanonnon/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 49066, "client_id": 1155744, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1728e99/uploads/origins/1084d2ce-1aad-4498-93c4-7448cb9971f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d428bfb3e73041242c1fb93acf2e79a9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1728e99/uploads/origins/1084d2ce-1aad-4498-93c4-7448cb9971f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc2ea01eab854fe2c65c99c7da6243c1", "src_set": ""}, "body": "いつもお世話になっております。\n募集が来たのでリクエストさせていただきます。\n\nキャラは理麻ちゃん又