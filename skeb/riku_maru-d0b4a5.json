&fit=crop&crop=top&w=200&h=200&blur=200&s=486620d81864092a67b64dad3e59ffbf 3x"}, "body": "こんにちは。\nポケットモンスターシリーズに登場するデオキシス（ノーマルフォルム）のイラストをお願いしたいです。\n構図としては、資料URLのGBA版に登場した時のような、片腕を手の形に変形させている状態で、正面向きに描いてほしいです。\n使用用途はアイコンやヘッダー、もしくは動画などを想定しています。\nよければお願いします。\n\nhttps://drive.google.com/drive/folders/1NdJAIGnFi9PmErba_mI0KKTMOPliSqa6?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@riku_maru/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 429267, "client_id": 538122, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/27dc250b/uploads/origins/ae6992d2-e6fc-463f-8a9f-ceb31aa7df20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f75c7a564b79cdc43c41259211c5c303", "srcset": "https://si.imgix.net/27dc250b/uploads/origins/ae6992d2-e6fc-463f-8a9f-ceb31aa7df20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f75c7a564b79cdc43c41259211c5c303, https://si.imgix.net/27dc250b/uploads/origins/ae6992d2-e6fc-463f-8a9f-ceb31aa7df20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e413619e39ffbe4a1fa69a391c800206 2x, https://si.imgix.net/27dc250b/uploads/origins/ae6992d2-e6fc-463f-8a9f-ceb31aa7df20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a8ba994dcb3c341bfc3864ca676d3b6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27dc250b/uploads/origins/ae6992d2-e6fc-463f-8a9f-ceb31aa7df20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43acf0f9c4680e4bfc0101ea81ec7487", "srcset": "https://si.imgix.net/27dc250b/uploads/origins/ae6992d2-e6fc-463f-8a9f-ceb31aa7df20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43acf0f9c4680e4bfc0101ea81ec7487, https://si.imgix.net/27dc250b/uploads/origins/ae6992d2-