ur=200&s=d57f8b18c2a005c64d72f755f815ad3a 3x"}, "body": "へたた様、初めまして。タニエルと申します。\n\nへたた様の作品「妻を抱かせる夫達」を読んでNTRの沼にハマりました。\n\n今回、もし可能であれば「妻を抱かせる夫達」の真由さんがまさひろとセックスしているシーンを描いて頂きたいです。\n\n体位は背面座位で、真由さんがとても気持ち良さそうにセックスしている姿が見たいです。\n\nご検討の程宜しくお願い致します。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@altyane_hetata/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/febe1662/uploads/origins/3c15a74e-0139-4216-bc41-966d126edffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2bb3c6bf38277678c44a3c66d703b5fe", "srcset": "https://si.imgix.net/febe1662/uploads/origins/3c15a74e-0139-4216-bc41-966d126edffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2bb3c6bf38277678c44a3c66d703b5fe, https://si.imgix.net/febe1662/uploads/origins/3c15a74e-0139-4216-bc41-966d126edffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=017cb8c2df7c9485d2038b9be930811d 2x, https://si.imgix.net/febe1662/uploads/origins/3c15a74e-0139-4216-bc41-966d126edffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=29cded20518788569b15555ed6376e3a 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1084768, "nc": 177}, {"path": "/@altyane_hetata/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1084768, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e69d324/uploads/origins/d1a407f7-280c-42e2-8de2-c7f33e02cc35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26993a0ff12ce7a4ef45ad4399d721a5", "srcset": "https://si.imgix.net/7e69d324/uploads/origins/d1a407f7-280c-42e2-8de2-c7f33e02cc35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26993a0ff12ce7a4ef45ad4399d721a5, https://si.imgix.net/7e69d324/uploads/origins/d1a407f7-280c-42e2-8de2-c7f33e02cc35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=936f0e920485fcf8320336f0a6805c4e 2x, https://si.imgix.net/7e69d324/uploads/origins/d1a407f7-280c-42e2-8de2-c7f33e02cc35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ed6efaf872b07466ad66817e1fbe4c8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e69d324/uploads/origins/d1a407f7-280c-42e2-8de2-c7f33e02cc35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1bd8a7efc888f15f9e46ba5b90f91b3", "srcset": "https://si.imgix.net/7e69d324/uploads/origins/d1a407f7-280c-42e2-8de2-c7f33e02cc35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1bd8a7efc888f15f9e46ba5b90f91b3, https://si.imgix.net/7e69d324/uploads/origins/d1a407f7-280c-42e2-8de2-c7f33e02cc35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e0847673958a67049b7e5207440f660b 2x, https://si.imgix.net/7e69d324/uploads/origins/d1a407f7-280c-42e2-8de2-c7f33e02cc35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e2b3e27360d511cb824aa050a5a7e9e3 3x"}, "body": "はじめまして\n先生の寝取られ系の作品が好きなので依頼させていただきます\n\n■キャラクター\n妻を抱かせる夫達の真由\n\n■シチュエーション\n夫の目の前で他の男のアナル舐めをする真由\n\n■構図\n四つん這いの男のアナルを舐めながら陰茎をしごき射精させる真由と奥の方でその様子を見て勃起している夫\n・真由は片手の人差し指と中指でアナルを拡げながら舐めさせて下さい\n・鼻を尻に押し付けるくらい深めに相手の尻に顔を押し付けている感じでお願いします\n・奥の夫は顔等は見えなくて大丈夫です寝取らせて勃起しているところがわかれば幸いです\n・夫は男が射精させられているところを見て腹につくくらいガチガチに勃起させてください\n・全員ムダ毛等は無しでお願いします\n\n前回の寝取らせからエスカレートして直接見ながらの寝取らせをしているような感じでお願いします\n何卒よろしくお願いします", "nc": 177, "word_c