早い納品（https://skeb.jp/@altyane_hetata/works/13）誠にありがとうございます！\n\n想定していた構図とちょっと違いロリっ娘の足が映えるため（もちろん悪いという意味ではないです！）、ロリっ娘の足に以下の追加をお願いできますでしょうか？（両イラストとも）\n\n・右足に前作（https://skeb.jp/@altyane_hetata/works/9）のコンドーム（フットファックで挿入されたところまでローション汚れ）。\n・左足に前作の靴下。\n\n・またもう1点、右腕挿入時のみ、カウパーとろとろの量をもう少しだけ増量いただけると（左腕挿入時と差をつけていただけると）嬉しいです。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@altyane_hetata/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1084768, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1f5ac51/uploads/origins/27e1fed6-e22f-4186-8a82-b2a8d084a1cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=344c51ae444343145ab46976a4632084", "srcset": "https://si.imgix.net/f1f5ac51/uploads/origins/27e1fed6-e22f-4186-8a82-b2a8d084a1cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=344c51ae444343145ab46976a4632084, https://si.imgix.net/f1f5ac51/uploads/origins/27e1fed6-e22f-4186-8a82-b2a8d084a1cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32188bed2c7110b4c386c30105814f3a 2x, https://si.imgix.net/f1f5ac51/uploads/origins/27e1fed6-e22f-4186-8a82-b2a8d084a1cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07863c5044b03a2c625590a8a03fee6f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1f5ac51/uploads/origins/27e1fed6-e22f-4186-8a82-b2a8d084a1cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f2c6601903dec843c80bbdde80e93ab", "srcset": "https://si.imgix.net/f1f5ac51/uploads/origins/27e1fed6-e22f-4186-8a82-b2a8d084a1cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f2c6601903dec843c80bbdde80e93ab, https://si.imgix.net/f1f5ac51/uploads/origins/27e1fed6-e22f-4186-8a82-b2a8d084a1cb?bg=%23fff&auto=