rop=top&w=200&h=200&s=931a5afcdbfae96d3ea5bf47a6bdb107, https://si.imgix.net/d3d3e62f/uploads/origins/f97b0072-7609-4249-96d3-442e511e6fef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a5bf66f0804a65a1345f43844be8047 2x, https://si.imgix.net/d3d3e62f/uploads/origins/f97b0072-7609-4249-96d3-442e511e6fef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ae551379945c4bd5506ed29ccb0d0d8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3d3e62f/uploads/origins/f97b0072-7609-4249-96d3-442e511e6fef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05e8276fd6a4dc16d3150c0503823bab", "srcset": "https://si.imgix.net/d3d3e62f/uploads/origins/f97b0072-7609-4249-96d3-442e511e6fef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05e8276fd6a4dc16d3150c0503823bab, https://si.imgix.net/d3d3e62f/uploads/origins/f97b0072-7609-4249-96d3-442e511e6fef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a477605a4563e2c68361ab1aa1f959c 2x, https://si.imgix.net/d3d3e62f/uploads/origins/f97b0072-7609-4249-96d3-442e511e6fef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb7124ab2c2714c6d3bcfa412653d450 3x"}, "body": "初めまして！\nVGGC7thをきっかけに七彩様のイラストを知り、とても好みの画風なのでこの度依頼させていただきました。\n\n【リクエスト内容について】\n人物:ぶいすぽっ！の一ノ瀬うるは様\n衣装:光るならのMVの時の制服の上からジャージを着ているもの(資料↓の0:56~1:20)\nhttps://www.youtube.com/watch?v=C49BA6cDkY0\n背景:学校の屋上\n構図:お手数おかけしますがお任せしたいです(縦長、横長どちらでも大丈夫です)\n\n【用途について】\n主にSNSのプロフィールまたはスマホ、PCの壁紙などに使う予定ですので、使用許可と最低限のトリミングの許可をいただきたいです。\n\n長々と失礼しました。お引き受けいただけましたら、是非よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sitisaie/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1562094, "client_id": 1067282