ー：アズールレーンの三笠\n内容：お願いされて恥ずかしがりながらも、スカートをたくし上げてパンツを見せてくれているイラストです。\n構図はお任せしますが、パンツ全体がしっかり見えるぐらいには大きくたくし上げて頂きたいです。\n衣装は公式の通常衣装で、パンツのデザインなどはお任せします。\n\n以上の内容で特に指定の無い部分はお任せします。\nよろしくお願いいたします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@darkdaikan/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/601cbf4c/uploads/origins/95da4b99-77c8-4be6-9ebb-0d6e7d049c5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44e5a3b019bd5c4a6f82eab3d90f7acc", "srcset": "https://si.imgix.net/601cbf4c/uploads/origins/95da4b99-77c8-4be6-9ebb-0d6e7d049c5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44e5a3b019bd5c4a6f82eab3d90f7acc, https://si.imgix.net/601cbf4c/uploads/origins/95da4b99-77c8-4be6-9ebb-0d6e7d049c5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=396651185831dc9e4239e3c094d8da01 2x, https://si.imgix.net/601cbf4c/uploads/origins/95da4b99-77c8-4be6-9ebb-0d6e7d049c5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30c7d1a9eb055880493753aaf5ebb2a4 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 4075046, "client_id": 2752312, "nc": 176}, {"path": "/@darkdaikan/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4075046, "client_id": 2231946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/576d5baf/uploads/origins/5d33726f-0f08-4166-8aed-114318ad6109?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9