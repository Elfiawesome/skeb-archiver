be.com/@ayanome_riko?si=EabS3hmmgkXk4AZl  \nX \n・https://x.com/riko_ayanome?s=21&t=XfCzie2C-biA-ATeWhN9UQ   \n\n【リクエスト内容】  \nキャラクター  \n・1名：妖乃眼 凛狐  \n\n 構図  \n・表情やポーズに関しては全てお任せをしたいと思っております。 \n依頼金額の範囲内で可能でしたら私は普段目隠しをしているのですが目隠しありの差分も頂けますと幸いです。   \n\nキャラクター概要  \n・真面目でいつもみんなを笑顔にしたいけど時々おっちょこちょいなバ美肉妖狐  \n\n 見た目の特徴 \n ・狐耳がありますのでいわゆる人の耳はありません  \n・片耳に鈴のピアス  \n・方ニーハイ   \n\n【使用用途】\n ・ SNSでの利用(XにてのおはVやアイコンなど)  \n・配信用サムネイルでの利用  \n・リットリンク等へのイラスト掲載   \n\n【納品形式】\n  ・人物や文字など全て透過で全て別れていますと幸いです。\n 上記PDS形式データでの納品をお願いしたく思います。  \n\n 【資料】 大変申し訳ございませんが三面図等はございませんが正面図のみ添付を致します。  ご参考になれば幸いです。 \n\nhttps://drive.google.com/drive/folders/1hY-P6C6biXfgr4GSejhqIm9XZFUgstjE\n\n  大変ご多忙のことと存じ上げますが、 ご確認、ご検討のほどよろしくお願いいたします。   \n\n妖乃眼 凛狐\n\nhttps://drive.google.com/drive/folders/1hY-P6C6biXfgr4GSejhqIm9XZFUgstjE", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tokoito_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3704219, "client_id": 3223624, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ee39c2f/uploads/origins/689e1ef5-db1b-4d69-9980-17b7ed03ec4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3648af5f72ddc06c270ddfe75d710899", "srcset": "https://si.imgix.net/2ee39c2f/uploads/origins/689e1ef5-db1b-4d69-9980-17b7ed03ec4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3648af5f72ddc06c270ddfe75d710899, https://si.imgix.net/2ee39c2f/uploads/origins/689e1ef5-db1b-4d69-9980-17b7ed03ec4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c2f07ee18172297034dea04735e6dec 2x, https://si.imgix.net/2ee39c2f/uploads/origins/689e1ef5-db1b-4d69-9980-17b7ed03ec4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7a937eed2482fb7050826ea7a124f12 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.ne