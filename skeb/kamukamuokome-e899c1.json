nt_methods": {"credit_cards": {"jcb": {"nsfw": true}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@kamukamuokome/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2970279, "client_id": 989391, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/968836e3/uploads/origins/b60eeddb-010d-4443-ab1a-e518f784cac7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84b486a13c1f212f31f2877d95f412ea", "srcset": "https://si.imgix.net/968836e3/uploads/origins/b60eeddb-010d-4443-ab1a-e518f784cac7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84b486a13c1f212f31f2877d95f412ea, https://si.imgix.net/968836e3/uploads/origins/b60eeddb-010d-4443-ab1a-e518f784cac7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7317d90cc027dd05f18dc70576987208 2x, https://si.imgix.net/968836e3/uploads/origins/b60eeddb-010d-4443-ab1a-e518f784cac7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d1fed2bdc6ec58ab24bd9c59d38934f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/968836e3/uploads/origins/b60eeddb-010d-4443-ab1a-e518f784cac7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be04d753ac14cf5fcc2811318d90fa92", "srcset": "https://si.imgix.net/968836e3/uploads/origins/b60eeddb-010d-4443-ab1a-e518f784cac7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be04d753ac14cf5fcc2811318d90fa92, https://si.imgix.net/968836e3/uploads/origins/b60eeddb-010d-4443-ab1a-e518f784cac7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9e4cb26fc7c6553e6873d22d34f6bac1 2x, https://si.imgix.net/968836e3/uploads/origins/b60eeddb-010d-4443-ab1a-e518f784cac7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d69d5adbb19ee94412cff9d9dd554b6 3x"}, "body": "鉢蜜さん、こんにちは。蟹です。\n鉢蜜さんの作品がとても魅力的でいつも楽しませていただいております。\n雨宮十夜さんが本当に美しく、ずっと僕にとって最高のキャラですので、十夜さんのイラストをリクエストさせていただきます。\n\nカントボーイにされ、2体の怪人も出産した後に、怪人の基地から救出されてから約1年後という設定で描いてほしいです。\n怪人対策組織が十夜の治療を試みたが、カントボーイも、感度倍増、常時発情、淫乱化、母乳も何も治せていない。\n十夜はそれを筋トレや戦闘訓練、瞑想など、心身を更に鍛えて耐えようとしたら、それが星の力を引き出したことで、常時発情にある程度耐えることができ、パワーアップも果たして戦線に復帰した。\n十夜は怪人の大部隊と１人で戦い、怪人たちを次々と倒す。その度に怪人のピンク色の体液や肉片が十夜を濡らす。激戦の末、部隊を率いる上級怪人の胸を貫いた時、上級怪人の肉体は弾け、そこから飛び出した触手が十夜を拘束した。\n\nということを１ページ目で文章で語ってほしいです。\nイラストはこのような内容です。差分で変化させていってほしいです。\n\n十夜のスーツには金色の線が入り、強化されたことを示している。スーツの下は筋肉の塊なことが分かるようスーツは膨らんでいる。スーツは怪人の体液で濡れている。戦いにより、頭を守って、マスクは無くなった。顔にも怪人の体液が付着している。\n胸の装甲とスーツが破けて、元々の胸筋に加えて、母乳が溜まり大きく膨らんだ胸が出ている。\n細いが力強い触手が四肢を拘束し、両腕を横に伸ばさせ、足を大きく開かせている。\nそして十夜を拘束している触手とは色の違う小型の触手（イメージは歯が無く、単眼の、エイリアンのチェストバスター）が、画面の一部に表示されて、小さな触手からは上級怪人の声が聞こえる「私に致命傷を与えるとは…コアだけで逃げなければ死んでいたぞ。恐ろしい男め」と言う。\n十夜は往生際の悪い奴。などを上級怪人を睨みながら言う。\n上級怪人は「だが、私を倒すほどの戦士の肉体、強化され、より潤沢になった魔力、使わない手はない。しかもカントボーイ化されているとは素晴らしい」という。\n\n十夜は嫌な予感がして拘束を破ろうとするが、体の感度が敏感で、少し動いただけで顔を赤くし、快感を感じてしまう。上級怪人は「お前が倒した私の部下は倒した相手を弱体化させるために全て体液を媚薬化させている。改造された体では辛かろう」と言う。それでも、家族や仲間にこれ以上心配はさせないと歯を食いしばり、気合で十夜は触手を千切りそうになる。\n\n上級怪人は単眼を光らすと、十夜の淫紋がスーツの下にあってもわかるほど光輝き、十夜は目を見開いて、舌を出し、絶頂して動けなくなる。あの感度でまだ動けるとはとんでもない奴だと驚きながら、他の怪人が刻んだ淫紋でも私は干渉し、強化することもできると上級怪人は言う。\n\n小型の触手になった上級怪人は十夜の乳首に取りつく。「この胸からお前の魔力を吸い上げてくれる」と猛烈に十夜の乳首を吸い、魔力の混ざった母乳を吹き出す。元から弱点な上に、基地での日々もあって感度が特に高まっている乳首への攻撃で十夜はメスイキする。十夜は怪人の子どもたちを思い出し、それを頭から追い出して、この状況の打開に集中しようとする。\n\nダメージ蓄積、魔力吸収、絶頂で変身が解除され、十夜は全裸になる。救出後の鍛錬により、十夜の筋肉は以前よりも更に増している（重要：いつもより、更に全身の筋肉増量で、どうかお願いします）鍛錬と出動の日々で剃る暇が無く無精ひげも濃い。\n強化された淫紋は輝きを増している。\n十夜の表情は快感に耐えようとしている。心の声で、まずいと叫んでいる。\n上級怪人はそんな十夜の肉体を賞賛する。\n\n上級怪人は「この素晴らしい肉体こそ、私を新生させる母体に相応しい」と十夜の股間に飛びつき、膣に入る。\n十夜は「俺に寄生して魔力を奪い復活するつもりか！」と叫ぶ。十夜は「こんな触手引き千切って、テメェも引っ張り出してやる」と、腕の筋力で拘束を破ろうとする。\n上級怪人が「我が残骸よ、こいつを止めろ」と言うと、細い触手が十夜の乳首を引っ張り、クリトリスを掴み、太い触手が肛門に入り込む。この攻撃で十夜はメスイキし、動けなくなる。\n\nその間に上級怪人は音を立てながら膣を通り、子宮口をこじあけて、子宮に侵入した。その感覚に、目が上を向き、絶頂する十夜。母乳を吹き出し、女性器から液も出す。子宮内部の状況を画面の一部で映す。\n\n子宮に入った上級怪人は壁に張り付いて十夜の魔力を吸収し、成長を始める。この小さな触手が子宮で大きくなることを想像し、過去の妊娠のトラウマが蘇る十夜。他の場所を責める触手は交代し、胸にはヒトデ状の触手が、びっしりと小型の触手を生やした触手が女性器に、アナルビーズ状の触手が肛門に迫っている。\n\n外から見ても妊娠していることがわかる大きさに十夜の腹は膨れ、子宮の中では上級怪人は胎児になっている。女性器を覆った触手がぐちゅぐちゅと責め、ヒトデ触手が胸を絞り、アナルビーズ触手が肛門の中で暴れる。十夜はこれ以上、怪人を産んだりしないと叫び、顔を真っ赤にしながら全身に力を込めて拘束を抜けようとしている。心の中で、家族のことを思い浮かべ、それを力に変えている。そんな十夜の顔の近くに、マスクの形をした触手が迫っていた。\n\n十夜の口と鼻はマスク状の触手に塞がれ、栄養液と媚薬と酸素が流される。十夜は心ここにあらずな表情だ。女性器、胸、肛門は依然、触手が責めている。十夜の腹はとても大きく膨れ、子宮の中では十夜の魔力と遺伝子を得た上級怪人が十分な赤子に成長し、間もなく産まれる時だ。\n\nという内容です。\n差分が変わるタイミングは鉢蜜さんの判断で変えてかまいません。\n十夜さんの筋肉の多さ、腕や足の太さをよろしくお願いいたします。スーツはその上から着ているので、より盛り上がってください。髭も最近お願いした作品のように濃くお願いします。陰毛、腋毛も濃くお願いします。\n何卒よろしくお願い申し上げます。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kamukamuokome/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2970279, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74bccdc8/uploads/origins/098d610d-b1a6-4ce4-8893-439c17229d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04fff0fec5cd3c5c1e942aec8791102c", "srcset": "https://si.imgix.net/74bccdc8/uploads/origins/098d610d-b1a6-4ce4-8893-439c17229d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04fff0fec5cd3c5c1e942aec8791102c, https://si.imgix.net/74bccdc8/uploads/origins/098d610d-b1a6-4ce4-8893-439c17229d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2506a5c87bdfde3833bab7f7d5365f77 2x, https://si.imgix.net/74bccdc8/uploads/origins/098d610d-b1a6-4ce4-8893-439c17229d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a502eac111ab4dc5daf2b13ac56a8ae 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74bccdc8/uploads/origins/098d610d-b1a6-4ce4-8893-439c17229d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c1f76e37a0f2a4a2928fbfafdd9129e", "srcset": "https://si.imgix.net/74bccdc8/uploads/origins/098d610d-b1a6-4ce4-8893-439c17229d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c1f76e37a0f2a4a2928fbfafdd9129e, https://si.imgix.net/74bccdc8/uploads/origins/098d610d-b1a6-4ce4-8893-439c17229d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=98a1fdc63c29aa07445192f5c07c7f08 2x, https://si.imgix.net/74bccdc8/uploads/origins/098d610d-b1a6-4ce4-8893-439c17229d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=009d085ad9a715ff46896ec355036c7c 3x"}, "body": "へへっ！あなたのヒーロー漫画と、キャラクターのエッチな表情が本当に気に入りました。ちょっと変わったアイデアを思いついてしまって申し訳ないのですが、遠慮なく正直な感想を伝えてください。リクエストをお断りいただいても構いませんし、もし不適切だと思われたらその旨教えてください。 雨宮ジュヤ、あるいはこちらの投稿で紹介されているキャラクターを登場させた、数ページにわたるコミックを描いていただけると嬉しいです：https://www.fanbox.cc/@hatimitu/posts/9871051 1ページ目： 彼にはヒーローの衣装を着て、目の前に立っているモンスターの対処法について、通信機やイヤホン越しに息子と話し合っているようなシーンを描いてほしいです。 モンスターの具体的なイメージは特にありませんが、描いていただけるなら、彼が負けるのが屈辱的だと感じるようなものを想像しています。肥満体で少し臭いがする、しかし人間ではないようなモンスターです。モンスターを倒すことについて語りながら、英雄的なポーズをとっている姿を描いていただいても構いません。 2ページ目：見開きページにするなら、1ページ目はモンスターが拳で彼の顔を殴りつけ、彼が卑猥な唸り声を上げる場面。2ページ目は、彼が強烈な抱擁を受け、体が軋みながらその巨大な抱擁に反応する様子を描いてください。 最初は傷を負ったものの、それでも戦いに勝てるのだと語り、息子に「下がっていろ」と警告する。ヘルメットの中で痛みに反応する彼の表情を描いても構わない。3ページ目：モンスターが彼を地面に叩きつけ、ヘルメットが割れて彼の可愛い顔が露わになる。 別の分割パネルで、モンスターが「こいつは簡単に倒せたな」と呟きながら胸や腹を殴りつける場面。ジュヤは冷静さを保とうとしながら、一撃ごとにうめき声を上げる。 4ページ目：モンスターがジュヤの敗北した顔をお尻で押しつぶし、気絶させる（モンスターのお尻に押し付けられたジュヤの卑猥な表情を描く）。息子は彼と意思疎通を図り、モンスターによって父親の体力が完全に奪われてしまったことに気づき、ジュヤの最期に絶望と悲しみに満ちている。 これからも素晴らしい作品を作り続けてください。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kamukamuokome/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2970279, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ce054a2/uploads/origins/66cd6a06-11ec-4674-9071-34fa4f26d3ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18117cd82745b15ecd33ac52075e2bbb", "srcset": "https://si.imgix.net/5ce054a2/uploads/origins/66cd6a06-11ec-4674-9071-34fa4f26d3ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18117cd82745b15ecd33ac52075e2bbb, https://si.imgix.net/5ce054a2/uploads/origins/66cd6a06-11ec-4674-9071-34fa4f26d3ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dcb3abb24d8f09f3a4968ad7a924a7f1 2x, https://si.imgix.net/5ce054a2/uploads/origins/66cd6a06-11ec-4674-9071-34fa4f26d3ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e9221583f0c7affd866451a655ab28a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ce054a2/uploads/origins/66cd6a06-11ec-4674-9071-34fa4f26d3ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86dfdd0bf00e48271842759eacdfb149", "srcset": "https://si.imgix.net/5ce054a2/uploads/origins/66cd6a06-11ec-4674-9071-34fa4f26d3ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86dfdd0bf00e48271842759eacdfb149, https://si.imgix.net/5ce054a2/uploads/origins/66cd6a06-11ec-4674-9071-34fa4f26d3ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e53e6a32da16a391343e6b9ba504c7e6 2x, https://si.imgix.net/5ce054a2/uploads/origins/66cd6a06-11ec-4674-9071-34fa4f26d3ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=596c710cc5a1ed1b125f3388772964a7 3x"}, "body": "先生、こんにちは！ 先生の漫画は昔から大好きです。見るたびにすごくワクワクします！ 私のオリジナルキャラクター（OC）を題材に、「カントボーイ」をテーマにした漫画を描いていただけたら、本当にありがたいです！ 私のOCは、ドラゴンの特徴を持つ若い男性です！ 参考リンクはこちらです：\nhttps://x.com/i/status/2062500706251341973\n漫画の内容はこんな感じです：ある日、主人公は謎の小包を受け取りました。箱には「性的な面で人を強力にするポーション1本」と書かれたメモが添えられていました。 主人公は待ちきれずにポーションを全部飲み干してしまったが、その結果、自分は「マンコボーイ」に変身してしまったことに気づく。彼の体は強制的に発情状態に陥り、手と人工ペニスを使って自慰行為を始めた（水しぶきを飛ばすほどの絶頂を見せられたら、さらに最高だ！）。 最後の発情期が終わり、ソファに座って休んでいた主人公は、小さな薬瓶を手に取ると、その底にメモが貼られているのを見つけた。\n本製品は半分までしか摂取しないでください。それ以上摂取すると、その効果が永久的なものとなります。結局、主人公はマンコボーイになる生活にハマり、常に性具を使って自慰行為にふけるようになる。\nお忙しい中、私のリクエストをお読みいただきありがとうございます！もしこの依頼をお引き受けいただけたら、この上ない光栄です！幸せな人生をお祈りしています！！\nhttps://x.com/i/status/2062500706251341973", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kamukamuokome/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2970279, "client_id": 989391, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29eba0ea/uploads/origins/33198d04-c967-4695-8ccd-f3b6643b040b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80f191847629c215359a21271598a3ba", "srcset": "https://si.imgix.net/29eba0ea/uploads/origins/33198d04-c967-4695-8ccd-f3b6643b040b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80f191847629c215359a21271598a3ba, https://si.imgix.net/29eba0ea/uploads/origins/33198d04-c967-4695-8ccd-f3b6643b040b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=426dffe6d2bf243a6db421ca6d235ce7 2x, https://si.imgix.net/29eba0ea/uploads/origins/33198d04-c967-4695-8ccd-f3b6643b040b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e9f5088bc3505e4c840ad0bd655e5b2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29eba0ea/uploads/origins/33198d04-c967-4695-8ccd-f3b6643b040b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=220c31196b65081dffe752b2faf9f414", "srcset": "https://si.imgix.net/29eba0ea/uploads/origins/33198d04-c967-4695-8ccd-f3b6643b040b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=220c31196b65081dffe752b2faf9f414, https://si.imgix.net/29eba0ea/uploads/origins/33198d04-c967-4695-8ccd-f3b6643b040b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4cb1c1c047b62e3001a4dd16f20cd369 2x, https://si.imgix.net/29eba0ea/uploads/origins/33198d04-c967-4695-8ccd-f3b6643b040b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=72c7eefef625900638c9aaa2e1864b58 3x"}, "body": "鉢蜜様、こんにちは。蟹です。\n鉢蜜様の作品がとても魅力的でいつも楽しませていただいております。素晴らしいキャラデザにいつも感激しています。\n氷室睦月くんのイラストを描いていただきたいです。\n\nこの雨宮十夜さんのエロステータス画面と同じようなものをお願いしたいです。\nhttps://www.pixiv.net/artworks/130332549\n\n十夜さんの時と同じく、プロフィールや能力や性の経験の記述がほしいです。後半では状態異常欄に状態異常を書いてほしいです。エロステータスに感度や射精回数を書いてほしいです。開発度も上昇させていってほしいです。\nどうやら彼の武器はメイスのようなので、特に筋肉が逞しいと納得がいくし、僕の性癖としても嬉しいです。\n内容は私服とヒーロースーツを表示した後、怪人に敗北した状態、怪人に捕まって基地に連れて行かれて捕虜になっている状態、肉体改造の経過、魔力タンクにされている姿というものです。\n立ち絵を以下のように変化させていってほしいです。\n\n私服\nヒーロー姿\nヒーロー姿敗北　マスクオフ。スーツの破損。\n全裸　　　　　　弱体化・感度倍増の効果を持つ奴隷の首輪をされている。状態異常に弱体化・感度倍増を追加。\n胸改造　　　　　胸に注射針を刺され、母乳が出るようになる薬を注射されている。陰茎を触手が触っている。状態異常に母乳を追加。\n巨根改造　　　　改造をする力を持つ触手に陰茎が飲み込まれている。触手に揉まれた胸から母乳が垂れている。状態異常に巨根化を追加。\n睾丸改造　　　　睾丸にレーザーで淫紋を刻まれている。巨大になった陰茎から射精し、触手に引っ張られた胸から母乳を噴出する。状態異常に精液大量製造・常時発情・魔力生成効率上昇を追加。\n搾精・搾乳　　　淫紋の効果で睾丸が大きく肥大化している。陰茎と胸に牛の搾乳機のような機械が取り付けられて、機械が大量の精液と乳を搾り取っている。\nという内容です。\n\n何卒よろしくお願い申し上げます。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kamukamuokome/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2970279, "client_id": 989391, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c39df11/uploads/origins/7d7f63e1-8026-4558-8490-cf8e4d9bedf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=475257dd2e27b2573c82652b0a03ef40", "srcset": "https://si.imgix.net/0c39df11/uploads/origins/7d7f63e1-8026-4558-8490-cf8e4d9bedf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=475257dd2e27b2573c82652b0a03ef40, https://si.imgix.net/0c39df11/uploads/origins/7d7f63e1-8026-4558-8490-cf8e4d9bedf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96a2d6d542ffd28b24f2232c9a356b21 2x, https://si.imgix.net/0c39df11/uploads/origins/7d7f63e1-8026-4558-8490-cf8e4d9bedf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=154f32050844ba41e4009ecad143fa28 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c39df11/uploads/origins/7d7f63e1-8026-4558-8490-cf8e4d9bedf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dd9da94e2cc75a07ace1f2cc21dacf6", "srcset": "https://si.imgix.net/0c39df11/uploads/origins/7d7f63e1-8026-4558-8490-cf8e4d9bedf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dd9da94e2cc75a07ace1f2cc21dacf6, https://si.imgix.net/0c39df11/uploads/origins/7d7f63e1-8026-4558-8490-cf8e4d9bedf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49ada5ab87301bfed49515a74baa7180 2x, https://si.imgix.net/0c39df11/uploads/origins/7d7f63e1-8026-4558-8490-cf8e4d9bedf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d50ea0872b023b78b4fc2ec33986fe99 3x"}, "body": "鉢蜜様、こんにちは。蟹と申します。\n鉢蜜様の作品がとても魅力的でいつも楽しませていただいております。素晴らしいキャラデザと興奮させられる展開にいつも感激しています。\n特に私が鉢蜜様のキャラの中で一番大好きな雨宮十夜さんのコミックを依頼をさせていただきます。\n\nXで「ガチ敗北バットエンド漫画も描いてみたいな」とのポストを拝見いたしました。鉢蜜様がお考えになったガチ敗北バットエンドはどんなものになるだろうかと期待で胸を膨らませています。\nですから、十夜さんがガチ敗北バットエンドになる漫画を描いていただきたいです。\n\nカントボーイ化とはまた別の世界線として、十夜さんには男性器をつけていてください。（カントボーイも好きですが！！）\n鉢蜜様の描いたヒーロースーツのデザインも魅力的だと思っています。私は特撮などヒーロー作品が好きなのでヒーロースーツのままのエロを今回は見たいです。\n十夜さんが変身状態で怪人と戦い、敗北する展開を希望します。\nマスクとヒーロースーツを着たままエロが始まりその状態で一回はイッてほしいです。途中から魔力吸収などの怪人の力でマスク、スーツの装甲、スーツという順で消失していき、素顔、裸へとなっていってほしいです。（スーツも好きですが、十夜さんは素晴らしい肉体美ですね。そしてお顔が大好きです）\n私はリョナ、ヒーローやられなども好きです。ですから十夜さんが怪人の攻撃で大きなダメージを受けて敗北するという展開だと嬉しいです。更にバットエンドも精神的に堕ちるより肉体的な破滅、例えば吸収や、装置に組み込まれたり、不可逆な変形などが思いつくものなのですが、鉢蜜様にとって不快でない範囲のダメージ描写でかまいませんし、バットエンドの形もお任せします。\n\n十夜さんは怪人に反抗的、挑発的な態度をとるのがかっこよくて好きです。\n今回も十夜さんには反抗的、挑発的な態度をしてほしいです。バットエンドになる最後まで抵抗する姿を見たいです。\n\n何卒よろしくお願い申し上げます。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kamukamuokome/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2970279, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69994a69/uploads/origins/5f5e9641-a79d-4aac-94d0-6caf0e06288e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9adc880a3e66128e954aa257ef6f43d", "srcset": "https://si.imgix.net/69994a69/uploads/origins/5f5e9641-a79d-4aac-94d0-6caf0e06288e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9adc880a3e66128e954aa257ef6f43d, https://si.imgix.net/69994a69/uploads/origins/5f5e9641-a79d-4aac-94d0-6caf0e06288e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34b437284c749738b005ad7ec97b1010 2x, https://si.imgix.net/69994a69/uploads/origins/5f5e9641-a79d-4aac-94d0-6caf0e06288e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94e19798bdbce8d7665f351e810f2bf0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69994a69/uploads/origins/5f5e9641-a79d-4aac-94d0-6caf0e06288e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46bfdb1e918b50d930a497d26f19344b", "srcset": "https://si.imgix.net/69994a69/uploads/origins/5f5e9641-a79d-4aac-94d0-6caf0e06288e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46bfdb1e918b50d930a497d26f19344b, https://si.imgix.net/69994a69/uploads/origins/5f5e9641-a79d-4aac-94d0-6caf0e06288e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a4d7cc02cf576220995c64106364e574 2x, https://si.imgix.net/69994a69/uploads/origins/5f5e9641-a79d-4aac-94d0-6caf0e06288e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3b4b31f6ca36fed060de9950733ee851 3x"}, "body": "鉢蜜さん、こんにちは。数々のすばらしい作品をありがとうございます。\nXでヒーローゲーム制作も計画していると拝見いたしました。応援させていただきます。完成したら必ずかいます。\n鉢蜜さんキャラの中で私が一番大好きな雨宮十夜さんの依頼をさせていただきます。\n\nチンポのある十夜さんを見たいです。\n\n全裸にされて、触手に四肢を掴まれて、大の字で拘束されている十夜。しかし、怪人たちが標的にしていた重要人物も、一般市民たちも十夜は盾になって守り、逃がすことができたため、十夜は怪人を相手に挑発的な表情と言動をしている。\n怪人は怒り、触手から電撃を十夜に流す。苦しむ十夜。\nしかし、それが終わると更に挑発的な態度になる十夜。\n怪人は屈辱を与えようと、絶頂光線を放つ。十夜は顔を赤らめ歯を食いしばりながら耐える。チンポは勃起しているが、まだ射精していない。\n怪人は分離された小さな触手を十夜の尿道に入れる。怒りの表情で叫ぶ十夜。\nここからは断面図をお願いします。膀胱に到達した触手が膀胱の壁に張り付いて寄生して、十夜の尿と魔力を吸って大きくなっていく。その感触に青ざめる十夜。\n寄生触手は膀胱から伸びていき前立腺を刺激して十夜を絶頂させ、それをエネルギーにする。怪人も伸縮自在の腕を伸ばして、十夜の胸を揉む。\n大きく太くなった寄生触手は分裂する。太い触手が尿道を広げながらチンポから出て行くことでアへ顔になる十夜。怪人は十夜の乳首を引っ張りながら十夜を嘲笑する。\n膀胱に残っている寄生触手は十夜の魔力をまた吸って成長を再開し、チンポから出た触手は本能的に十夜の乳首に吸い付いて、乳を出させようと引っ張る。拷問のような快楽に叫ぶ十夜。乳も出せるように改造してやる、これからチンポで触手を産む苗床だと宣言する怪人。\n\nという内容です。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kamukamuokome/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2970279, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9fa0bc2/uploads/origins/266c0d87-8851-4f52-84e7-a0343b8fc88e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=557dfc238fc6cf32654668ceb5ac51e1", "srcset": "https://si.imgix.net/f9fa0bc2/uploads/origins/266c0d87-8851-4f52-84e7-a0343b8fc88e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=557dfc238fc6cf32654668ceb5ac51e1, https://si.imgix.net/f9fa0bc2/uploads/origins/266c0d87-8851-4f52-84e7-a0343b8fc88e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3f1d8a0c4552285140d331f289fad90 2x, https://si.imgix.net/f9fa0bc2/uploads/origins/266c0d87-8851-4f52-84e7-a0343b8fc88e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c40308a76d0d5ce485f13b01f1647ecf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9fa0bc2/uploads/origins/266c0d87-8851-4f52-84e7-a0343b8fc88e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e56a4db4663166a399f687a4ef97165", "srcset": "https://si.imgix.net/f9fa0bc2/uploads/origins/266c0d87-8851-4f52-84e7-a0343b8fc88e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e56a4db4663166a399f687a4ef97165, https://si.imgix.net/f9fa0bc2/uploads/origins/266c0d87-8851-4f52-84e7-a0343b8fc88e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5b5e15ac5da71c29963c7923dac2fac 2x, https://si.imgix.net/f9fa0bc2/uploads/origins/266c0d87-8851-4f52-84e7-a0343b8fc88e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd1870d2f515a82d3f26eb40d4242897 3x"}, "body": "鉢蜜さんの凄腕傭兵が快楽堕ちするまでの3日間から新人剣士アンリをリクエストさせてください。\n\nシチュエーションとしましては、アイザックにリベンジされ敗北…\n凄腕傭兵が快楽堕ちするまでの3日間の19ページにあったぴっちりタイツを身につけさせられ、闘技場で晒し者にされて、羞恥を感じている姿をリクエストさせてください。\n\n細かいリクエストとしましては、アンリは髪を解かれており、ぴっちりタイツでボディラインが丸わかりな状態で破いたりしないでください。\n先走りがジワっと染みてで汗でムワァな状態、もし可能でしたら一コマにぴっちりタイツの尻を描いていただけないでしょうか？\n同人でアンリの敗北を願っていた紳士たちがアンリを視姦し、「アンリちゃん結構ケツデカいんだなw」みたいな念願のアンリ敗北に悦んでいる感じのセリフを入れていただきたいです。\n\n私自身もアンリの敗北を願っていた紳士なので大変でなければ、よろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kamukamuokome/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2970279, "client_id": 441269, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03f1a443/uploads/origins/1e964194-2c4e-4d6c-b8a1-06b76582e7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc9a98b723ffaf3803c99e9ada785251", "srcset": "https://si.imgix.net/03f1a443/uploads/origins/1e964194-2c4e-4d6c-b8a1-06b76582e7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc9a98b723ffaf3803c99e9ada785251, https://si.imgix.net/03f1a443/uploads/origins/1e964194-2c4e-4d6c-b8a1-06b76582e7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ce10108964b0459ed0e06a23c95440d 2x, https://si.imgix.net/03f1a443/uploads/origins/1e964194-2c4e-4d6c-b8a1-06b76582e7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b05231d371fbb7e5907c4e0d0ddbac65 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03f1a443/uploads/origins/1e964194-2c4e-4d6c-b8a1-06b76582e7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ce9fa3d63b5fff148d674157f9f3495", "srcset": "https://si.imgix.net/03f1a443/uploads/origins/1e964194-2c4e-4d6c-b8a1-06b76582e7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ce9fa3d63b5fff148d674157f9f3495, https://si.imgix.net/03f1a443/uploads/origins/1e964194-2c4e-4d6c-b8a1-06b76582e7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e5f0910d45599e3bbb5374a859c98f6 2x, https://si.imgix.net/03f1a443/uploads/origins/1e964194-2c4e-4d6c-b8a1-06b76582e7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5a626ff92a128840bad9bedbda603ede 3x"}, "body": "初めまして！鉢蜜さん！\n今回、オリキャラの雨宮十夜さんのエロリクエストを送らせてください！\n\n内容は\n先日上がったカントボーイ&出産後、自身が産んだ怪人の子供や他の怪人達の魔力タンク兼触手に身体の隅々まで慰め者にされる。\nその上家族との別居から愛に飢え、戦闘員達の言葉責めや自身の子(怪人)からの愛の囁きや触手に身体を求められる度に自身に新たに付いた女性器がきゅん♡きゅん♡疼き、それに伴って十夜の精神も淫乱や性奴隷として堕ちて行きついに怪人、触手達や自身の子の性奴隷になる宣言をして、顔と股間部だけ見える全身タイツを着た性処理肉便器兼他のヒーロー達も堕とす戦闘員に堕ちてしまう\nという内容です！\n\nファンボに上がった内容があまりにもエロかったので善は急げとリクエストを送らせいただきました！\n\n入れて欲しい描写や細かい要求\n十夜さんが、怪人達や触手、子供に陵辱されている時の体勢はガニ股腋見せの体勢を取らせて欲しいのと、つま先立ちでの絶頂をさせてほしいです。\nそして最後の戦闘員堕ちの際には女性器を触手に弄られながら直立敬礼射精をさせて欲しいです\nあと人物は十夜さんや触手を写して貰えるだけで構いません。他の怪人や十夜さんの子供(怪人)声だけで構いません！\nまた差分で髭無し差分をお願いします！\n承認お願いします！\n\nただ鉢蜜さんがこれ分類的にはコミックだな、キャンセルしていただいて構いません。コミックで改めてリクエスト送信をさせていただきます！", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kamukamuokome/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2970279, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6cfb5d2a/uploads/origins/a4ab45f3-0398-460b-9615-4bb225917375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3c87c61b66da8ea70653d9a44844a7b", "srcset": "https://si.imgix.net/6cfb5d2a/uploads/origins/a4ab45f3-0398-460b-9615-4bb225917375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3c87c61b66da8ea70653d9a44844a7b, https://si.imgix.net/6cfb5d2a/uploads/origins/a4ab45f3-0398-460b-9615-4bb225917375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a48ab9eb0c0ff11518e71b994c71b6c 2x, https://si.imgix.net/6cfb5d2a/uploads/origins/a4ab45f3-0398-460b-9615-4bb225917375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6a73d4cccd29f27a8aa7be33363985b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6cfb5d2a/uploads/origins/a4ab45f3-0398-460b-9615-4bb225917375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ff4e851bb22d244ab2f44c6f2fd6bcb", "srcset": "https://si.imgix.net/6cfb5d2a/uploads/origins/a4ab45f3-0398-460b-9615-4bb225917375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ff4e851bb22d244ab2f44c6f2fd6bcb, https://si.imgix.net/6cfb5d2a/uploads/origins/a4ab45f3-0398-460b-9615-4bb225917375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cad211302187a8eef7b7b5b1d4604eea 2x, https://si.imgix.net/6cfb5d2a/uploads/origins/a4ab45f3-0398-460b-9615-4bb225917375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=060caa962d503b82306a59eeb94e35ad 3x"}, "body": "鉢蜜さま、こんにちは。\n鉢蜜さまの作品がとても魅力的でいつも楽しませていただいております。\nお題箱でお願いした『カントボーイに改造されるヒーロー』の雨宮十夜をありがとうございました。素晴らしく、魅力的な姿に感動しました。\n十夜さんがもっともっと大好きになり、更に彼を見たいと思いリクエストをいたします。\n\n十夜さんのエロゲーのエロステータス画面風のイラストを描いていただきたいです。\n体力、魔力、精神力、ヒーローとしての人気、男性器の勃起した時のサイズ、体の部位の開発度、メスイキなどの性経験回数、状態異常などの表示と、裸立ち絵で構成される画面です。\n『カントボーイに改造されるヒーロー』で改造される過程とその後の妊娠をエロステータスの数値変化と、立ち絵変化で、別側面から描いてほしいです。\nまた、この戦い以前でもエロ攻撃を受けた経歴を知れる要素があると嬉しいです。\n\n何卒よろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kamukamuokome/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0b1bcc94/uploads/origins/733b0a98-60ac-48db-bb06-ec0d9301c004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6309f9a24966f7a73c62ac4f37a9149", "srcset": "https://si.imgix.net/0b1bcc94/uploads/origins/733b0a98-60ac-48db-bb06-ec0d9301c004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6309f9a24966f7a73c62ac4f37a9149, https://si.imgix.net/0b1bcc94/uploads/origins/733b0a98-60ac-48db-bb06-ec0d9301c004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=04fcba5c137de8189cfe86b5dada5a18 2x, https://si.imgix.net/0b1bcc94/uploads/origins/733b0a98-60ac-48db-bb06-ec0d9301c004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9af5df4de6a9c83d8d0b7f2af4497743 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2970279, "nc": 32}, {"path": "