す。\n\n構図諸々全てお任せ致します！\n\n以下ネタバレなし\n名前：朧 ザフラ(おぼろ ざふら)\n年齢：30歳\n性別：男\nモチーフ：四神の青龍、朧花、朧月 等\n特徴：176cmの長身で非常に細身。肩幅も狭めではある。怪我が多いため身体には包帯を巻いている。中性的で、儚く美しい顔立ち。長髪。\n性格：飄々としていて掴みどころがなく、常にどこか余裕のある笑みを浮かべている男。気分屋でイタズラ好き、やや意地の悪い冗談やからかいを好み、人の反応を見ることを楽しんでいる節がある。\n\n添付ファイルにイラストや立ち絵をいれてあります。\n是非、問題ないようでしたらよろしくお願いいたします……！\n\nhttps://www.dropbox.com/scl/fo/rmo4wpyg1wlktm6ienmm3/AN0JqfIPgMA1-6kleLv0o3k?rlkey=uzy6bd3fcw6n2yart84esysaa&st=x3mxwn9u&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kuri1922/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2929462, "client_id": 2735695, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4a3a104/uploads/origins/dcd8b195-84f5-49d7-a36b-cc9d649f512d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d434d129cb3b2072aaaa7ff081521320", "srcset": "https://si.imgix.net/b4a3a104/uploads/origins/dcd8b195-84f5-49d7-a36b-cc9d649f512d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d434d129cb3b2072aaaa7ff081521320, https://si.imgix.net/b4a3a104/uploads/origins/dcd8b195-84f5-49d7-a36b-cc9d649f512d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13b4c4676702c6d2ee255ecf50975d32 2x, https://si.imgix.net/b4a3a104/uploads/origins/dcd8b195-84f5-49d7-a36b-cc9d649f512d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da05201a16ebea70560ad02cdde82515 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4a3a104/uploads/origins/dcd8b195-84f5-49d7-a36b-cc9d649f512d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=217d2afd48aa9630b2ceb927e0b6884e", "srcset": "https://si.imgix.net/b4a3a104/uploads/origins/dcd8b195-84f5-49d7-a36b-cc9d649f512d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&