！ありがとうございます。\nフレンチブルドッグFrench bulldogのイラストをお願いします。犬の色が薄茶色(ほとんど金色に近く)、顔だけが黒色種類です。名前は思樂といいます。彼女の性格は甘えん坊でわがままですが、優しく聡明で気が弱いです。ねこまるさんのセンスにほとんどの事をおまかせしたいと思っています。しかし可能なら、テーマ カラーはミント色がいいな~と思います。もしも許可をしていただく事ができるなら、イラストを完全に個人利用するアクキーに作りたいと思っています。検討をよろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nekomaru_xn/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2307692, "client_id": 2075730, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1efed147/uploads/origins/0bc8c442-2a1f-4acd-b083-9c3a332cb76b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e041b16a2dd8e8a57994c76e536e367", "srcset": "https://si.imgix.net/1efed147/uploads/origins/0bc8c442-2a1f-4acd-b083-9c3a332cb76b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e041b16a2dd8e8a57994c76e536e367, https://si.imgix.net/1efed147/uploads/origins/0bc8c442-2a1f-4acd-b083-9c3a332cb76b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96d441f0cd8a7f456bd326c672c9675e 2x, https://si.imgix.net/1efed147/uploads/origins/0bc8c442-2a1f-4acd-b083-9c3a332cb76b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=345c91271ad9a74b6f26c953adb1abe1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1efed147/uploads/origins/0bc8c442-2a1f-4acd-b083-9c3a332cb76b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e19723b9b6a77b734b3f80768e0d4ed1", "srcset": "https://si.imgix.net/1efed147/uploads/origins/0bc8c442-2a1f-4acd-b083-9c3a332cb76b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e19723b9b6a77b734b3f80768e0d4ed1, https://si.imgix.net/1efed147/uploads/origins/0bc8c442-2a1f-4acd-b083-9c3a332cb76b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&c