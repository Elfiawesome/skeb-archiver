ムにやさしい色使い、全てがmeisaさんの指先からしか得られない感動があります…！いつも楽しみにしてます。\nあたたかく柔らかなmeisaさんのタッチで見てみたいと思っていた天使と悪魔のふたりをお願いさせてください。よろしければ男性も見てみたいのです…！\n\n構図やシチュエーションについてはお任せ致します。衣装デザイン簡略化、アレンジなどもOKです…！描きやすいようにして頂けたら…！\n\nご検討頂けますと嬉しい限りです、よろしくお願いします。\n\nhttps://1drv.ms/u/s!ApZep_8BMuvwv1iqN8XN2TpQ_oeO?e=BlekWz", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@meisa_work/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/efcb277b/uploads/origins/d8583371-7bf4-426a-aea9-5e5af0bfe54d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1cfc2f895c4484c31d7a482ceb909892", "srcset": "https://si.imgix.net/efcb277b/uploads/origins/d8583371-7bf4-426a-aea9-5e5af0bfe54d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1cfc2f895c4484c31d7a482ceb909892, https://si.imgix.net/efcb277b/uploads/origins/d8583371-7bf4-426a-aea9-5e5af0bfe54d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63ea26f729d77979e37d34f958c2b863 2x, https://si.imgix.net/efcb277b/uploads/origins/d8583371-7bf4-426a-aea9-5e5af0bfe54d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b16f30f713e1d83eab1cc9a96d2b94c0 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 470432, "nc": 0}, {"path": "/@meisa_work/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 470432, "client_id": 39263, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01a48baf/uploads/origins/5648b65a-6658-447d-83ec-062b2d26194a?bg=%