m%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73d2fcfbd61de31d6c349484db412663 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=300a58feccacf6cf51e435e5784bbf05", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=300a58feccacf6cf51e435e5784bbf05, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=152dfcc84428a5093e28543882a29b6a 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dba458b6af68355f42a7879b68700522 3x"}, "body": "初めてのリクエスト失礼します！\nアズレンより、ふたなりのエンプラとエセックス改が仲良く敗北する話です！\n\n①2人で鏡面海域に出てスカベンジャーと遭遇。特殊な装置が作動して艤装と服が消失して全裸。\n②それでも戦おうとするけど装置が作動して勝手に腋見せがに股ポーズになり、2人して腰振りダンスをしてしまう。\n③装置を操作し、マジックハンドが2人を掴み上げ、互いの顔面を押し付けて強制濃厚ベロチューさせられる。お互いの涎や鼻水で顔がベトベト。下半身も押し付けられ、強制兜合わせをさせられて射精。\n④オナホが出現。互いに両側から挿入させて腰を振らせる。オナホ内部で互いのチンポが擦られて感じる。そのまま射精。\n⑤隙を衝いて全力逃走。2人の尻穴に砲弾を撃ち込まれ、射精しながら転倒、自爆ボートに仲良く転がり落ちる。\n⑧そのまま発進し通常海域へ。放棄された人工島の岸壁へ激突し爆発。爆風に乗って吹き飛ぶ。\n⑨エセックスは島内の廃墟のトイレの個室に突っ込む。便器に首から上を突っ込んだ犬神家状態に。ガニ股開脚してる股間に上から自身のクロスボウ型艤装の残骸が降ってきて股間を直撃。悶絶しながら勃起チンポから射精。犬神家状態のまま脱力して放尿、気絶。\n⑩エンプラは島内施設の外壁に頭から突っ込んで壁尻状態に。近くに自身の弓型艤装の残骸が投げ捨てられて暴発し股間を直撃。悶絶し勃起チンポから射精。壁尻のまま脱力して放尿、気絶。\n\n・エンタープライズ\nチンポ:長さ10センチ、太さ4センチ。長さの割に太い寸詰まりチンポ。\n陰毛:濃い目。処理は適当。ケツ毛も生えてる。\nおっぱい:美乳。\n・エセックス改\nチンポ:長さ11センチ、太さ3センチ。粗チンだけど形は整ってる。\n陰毛:薄目。女の子として処理はしてる。\nおっぱい:巨乳で乳輪大きめ。ちょっと垂れ気味。\n\n　普段の尊敬してる先輩・真面目な後輩の姿とは全く違う無様な姿や、互いの身体を見たり見られたりして興奮・勃起したり、アブノーマルなプレイを強要される感じで。2人は双方包茎で、亀頭の先がちょっと出てる感じで金玉は大きめ。\n　無様に命乞い・謝罪・土下座したり、白目剥いてアへ顔で感じたり、射精してお互いの身体を精液で汚辱するシーンも多めで。スカベンジャーは一貫して無表情・無言・無反応で装置を操る感じで。", "nc": 168, "word_count": 15718, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@ukifune_asagiri/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 3832755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bec2c69635a6f6bb3d6641175e9ff7a7", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bec2c69635a6f6bb3d6641175e9ff7a7, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d94f41ef73cea2203c2aca6237b7c7e8 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e85500bb086e5f338fe551ef09fedfbc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=337a3409b14bf32e52a651081c50bdff", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=337a3409b14bf32e52a651081c50bdff, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f2504c611cc3673e278b0484a87feb7 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dcd5b9b401c40c8ec703274c5a7ea209 3x"}, "body": "いつもお疲れ様です、リクエスト失礼致します\n原作\n・アズールレーン\n・シチュエーション\n東煌の裏市街に最近突如として現れた謎の宝具屋と呼ばれる怪しげな店、そこで日夜怪しい商品が出回っている事を察知した定安達は東煌を守るため、及び商売敵を倒すため店に潜入をするが浅はかな作戦はあっさりバレており逆に店員の美女達に童貞を見抜かれたりコンプレックスを詰られたり爆乳を玩具にされたり無理矢理露出プレイや精液評価など屈辱的な扱いをされ自分達の痴態を映像に撮られ逆に店の売上に貢献してしまう完全敗北を味わってしまう\n最終的に用済みになった定安達は全裸のまま路地裏にゴミのように捨てられ敗走、すっかり全身やちんぽを開発されきり空気が触れるだけでも射精してしまう敏感体質となってしまいKAN-SENとしてまともに戦う事が出来なくなってしまう…\n後日ちんぽも乳首も勃起したまま出撃せざるを得無くなった定安達はそんな状態で戦える訳も無く惨敗、自分達より幼い飛雲や撫順に助けられてしまう…\n\n希望キャラ詳細\n・定安\n胸：100cm Iカップですぐに勃起してしまう敏感乳首\nちんぽ：約11cmの童貞ふにゃちん、皮余り\nコンプレックス：今回のメンバーで1番の貧乳枠である事、周りには見栄で大きく言っている\n\n・海容\n胸：130cm Uカップでデカ乳輪に陥没乳首\nちんぽ：4cmの太さしかない雑魚童貞ちんぽ、勃起しても5cm程\nコンプレックス：ちんぽ同様ムチムチとした身体付きと爆乳\n\n・建武(ドレススキン)\n胸：117cm Pカップの美爆乳で不細工黒乳首\nちんぽ：勃起して約7cmの見栄剥き童貞黒ちんぽ、リボンで無駄に飾り付け虚勢を張っている\nコンプレックス：情けない乳首とちんぽ、巨乳に非常に弱く海容に興奮している\n\n・彰武\n胸：125cmSカップで黒乳首で陥没している丸おっぱい\nちんぽ：約5cmの見栄剥き童貞不健康ちんぽ、金タマが無駄にデカく敏感\nコンプレックス：救いようの無いマゾであり建武で日夜シコっている\n\n店員\n海容以上の爆乳美女集団、定安達を「モブ顔」「不細工」と称する程の自信家で性の手練\n\n・備考\n定安達の情けなさや巨乳さを強調して下されば構成やプレイ等書きやすいよう書いて下されば大丈夫です\n精液描写はうきふねさんに全てお任せ致します、個人的に建武と海容は早漏気味だと嬉しいです", "nc": 185, "word_count": 18808, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@ukifune_asagiri/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 3832755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e46dadec02b4a9432d9b6e30e700a3fe", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e46dadec02b4a9432d9b6e30e700a3fe, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=153c0894cfceb1832867b247d19c47eb 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d18b7d721689b3e94ea62666f324633 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94f31fc0020575fdbf06103e922d39c3", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94f31fc0020575fdbf06103e922d39c3, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4d3087695e0f39199569c6c4db26203f 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985247722186928128%2FpHe6okfk.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5a4f771ea8b106e3cd9ced1950922f8d 3x"}, "body": "お忙しい中リクエスト失礼致します\n\n原作\n『アズールレーン』\nキャラ\n★エセックス改\n★アンカレッジ\n★フランクリン\n★レキシントンII\n☆ベル\nあらすじ\n・母港近海に出現した不可思議な鏡面海域の調査の為愛する女指揮官と共にやって来たエセックス達、安全確保の為指揮官の護衛をベルに任せエセックス達は鏡面海域へと足を踏み入れる\n鏡面海域の内部は不気味な程穏やかな海であり戦いなどとは無縁に見えた、しかし突如エセックス達を襲ったのは見覚えのある艦載機──何と仲間であるカウペンスとアルビオンが襲ってきたのだ、本物ではなく鏡面海域の手により生み出されたコピーであるがエセックス以上の爆乳とレキシントン以上の溢れでる母性と色香で童貞のエセックス達はあっさりと勃起してしまい戦闘力が激減してしまう\n性知識が乏しいアンカレッジとエセックスは訳も分からぬままアルビオンの暴力的な母性に包まれ何度も手すら触れず射精してしまい動けなくなった所を爆撃機に襲われ艤装と服を破壊され無力化、レキシントンとフランクリンもカウペンスに搾乳手コキをされ普段のお姉さんらしさは消え失せ惨めなマゾ童貞のイキ声を挙げエセックス達と同じく艤装を破壊され無力化\n全裸のままバスト順に並べられたエセックス達はそのままカウペンス達の罵倒混じりの囁きと濃厚な攻めに耐えきれず射精を続けKANSENとしての力を失いちんぽ共々再起不能となってしまう\n最後は全裸のまま自爆ボートに括り付けられ情けない悲鳴を上げながら海域の外で待機していたベルと指揮官の乗る量産艦に特攻させられそのまま2人を巻き込み完全敗北\n敗走中に普段なら楽に倒せるセイレーンの駒が現れまた惨敗を繰り返すのだった…\n\n備考\n・バストサイズは爆乳が基本でその中でも\nエセックス＞＞アンカレッジ＞フランクリン＞＞レキシントン＞ベル\n・ちんぽサイズは全員小さめ\nアンカレッジ＞ベル＞＞エセックス＞フランクリン＞レキシントン\nアンカレッジは唯一10cm近いサイズだな頭まで被った敏感包茎でフランクリンはお子様ちんぽ見栄剥きしている感じです、その他のちんぽの感じは全てお任せします\n・プレイや台詞等は基本お任せします、アンカレッジとエセックスは圧迫オナが趣味な描写があると嬉しいです\n・エセックスは陥没乳首、レキシントンは黒乳首がコンプレックです\n・胸好きなので爆乳の描写が沢山欲しいです…！", "nc": 169, "word_count": 14600, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 133384, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "春上里央@skeb募集", "screen_name": "HaRUKAmi_RIO", "avatar_url": "https://pbs.twimg.com/profile_images/1538017125666697217/d--lmRyg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/161639836/1682083835/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_ex