てる二人\n・稽古が終わって妖夢が後ろを向いて一息ついてる時を見計らって椛くんがそれっぽい理由(汗かいてる妖夢が色っぽく見えた)をつけてバックで青姦エッチを始める\n・一回エッチが終わるとガチ泣きする妖夢と、いじめすぎた...と反省してる椛くん\n・優しくエッチして欲しかったとエッチのやり直しを求める涙目妖夢(正常位待ち)と、そんな妖夢を見て急に畏まった感じ(真面目にエッチしようと)でエッチを再開する(この辺りから服が完全に脱がれ始める)\n・同人誌の最後らへんの同サイズのコマで様々な体位でエッチしてる\n・最後は仲直りした感じで見つめあって笑ってる二人\n\npixiv等に上げる際には依頼者の名前を消してください\nよろしくお願いします", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@00sec_s/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3611378, "client_id": 514283, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/25e30454/uploads/origins/f51a7f02-2472-4e7e-99e9-f37f825e83fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=179543b55324a8c88e260ee67e1b9279", "srcset": "https://si.imgix.net/25e30454/uploads/origins/f51a7f02-2472-4e7e-99e9-f37f825e83fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=179543b55324a8c88e260ee67e1b9279, https://si.imgix.net/25e30454/uploads/origins/f51a7f02-2472-4e7e-99e9-f37f825e83fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b26ad0f2bdc2eade2f06fea2d81d9a69 2x, https://si.imgix.net/25e30454/uploads/origins/f51a7f02-2472-4e7e-99e9-f37f825e83fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55c55d6605fcc74e37d185e715f11384 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25e30454/uploads/origins/f51a7f02-2472-4e7e-99e9-f37f825e83fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb91b6becc5bd6303456804d76c1b6c1", "srcset": "https://si.imgix.net/25e30454/uploads/origins/f51a7f02-2472-4e7e-99e9-f37f825e83fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb91b6becc5bd6303456804d76c1b6c1, https://si.imgix.net/25e30454/uploads/origins/f51a7f02-2472-4e7e-99e9-f37f82