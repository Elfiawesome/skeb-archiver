イメージ\n\n・石化していない生身の差分\n\n・服を着ている状態の石化\n　現実だと変ですが、パンツは脱いでする前の履いたままと\n　片足に掛けているのをお願いします\n\n表情の差分\n\n・真顔\n　口を閉じている、上記の真顔がこれです\n・突然の出来事に理解が追いつかず、口をポカンと開いた間抜けな表情\n・恍惚顔と言われている表情\n　目を閉じていて、う～　の口になっている表情のイメージ\n・ダメージを受けた時の表情\n　口の開き方ですが歯が見えないように　あいう　の【い～】の形に\n　ダメージを受けた時の「痛い！」のイメージ\n・羞恥顔\n　口を大きく開き驚きながらも恥ずかしいといった表情\n・怒りの顔\n　眉が逆八の字で　歯を食いしばっている表情\n・笑顔　\n　目を閉じているにっこり顔\n　口も閉じていて口角が上がっている\n\n・各表情の目の瞳の表現のありとなし\n\n検討のほどよろしくお願いします。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AI_NS/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 458071, "client_id": 941736, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0cee6955/uploads/origins/9865dd2a-5ca3-4a5e-80a1-d797a71eceb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e27b0e7032d1ea07b69446f1cc0119f3", "srcset": "https://si.imgix.net/0cee6955/uploads/origins/9865dd2a-5ca3-4a5e-80a1-d797a71eceb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e27b0e7032d1ea07b69446f1cc0119f3, https://si.imgix.net/0cee6955/uploads/origins/9865dd2a-5ca3-4a5e-80a1-d797a71eceb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4cf96fa4cd1f8467b70396b51d38450 2x, https://si.imgix.net/0cee6955/uploads/origins/9865dd2a-5ca3-4a5e-80a1-d797a71eceb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=810ed6e07015d2b4ac871eb6c902346b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0cee6955/uploads/origins/9865dd2a-5ca3-4a5e-80a1-d797a71eceb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee1bfda9712320e28462f258e5c79a8b", "srcset": "https://si.imgix.net/0cee6955/uploads/origins/9865dd2a-5ca3-4a5e-80a1-d797a71eceb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee1bfda9712320e28462f2