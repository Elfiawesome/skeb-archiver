2d11344898a1ccd5634727b5f5f73f2 2x, https://si.imgix.net/57031bcc/uploads/origins/1cd44468-3df4-4873-ac89-f60402db28e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9302c4b9ca84519931028563d3ee881 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57031bcc/uploads/origins/1cd44468-3df4-4873-ac89-f60402db28e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d26335b909d24e3b6a48ffa97972e904", "srcset": "https://si.imgix.net/57031bcc/uploads/origins/1cd44468-3df4-4873-ac89-f60402db28e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d26335b909d24e3b6a48ffa97972e904, https://si.imgix.net/57031bcc/uploads/origins/1cd44468-3df4-4873-ac89-f60402db28e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f098178b5f7c56495d0a4d99551e3c0 2x, https://si.imgix.net/57031bcc/uploads/origins/1cd44468-3df4-4873-ac89-f60402db28e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bcf159e462c38f283f6466aa22c56abe 3x"}, "body": "はじめまして！\nあなたの真面目で大雑把な作風が超クールで、ぜひ私のオリジナルキャラクターの絵をお願いしたいです。自信家で、生意気で、独りよがりなおてんば娘で、かなりいじわるです。反抗的でもある。\n鋭い目、ピンクの毛先が特徴的な野性的な白髪、エジプトの犬に似た尖った長い耳と小さな尻尾が特徴です。\n彼女を描いたスケッチをいくつか載せておきます。参考にしてください。衣装は考えていません。ごめんなさい。つまり、どんなポーズでも、どんな表情でも、どんな服装でも、このキャラクターに合うと思うものがあれば最高です。露出度の高い服や、ダンスに使うスケーター風のセクシーな服が好きです。\nアイコンや参考画像など個人的な用途で使用させていただきたいです。\nこの度はありがとうございました！\n\nhttps://photos.app.goo.gl/SSwWhjZbBC8hrjvs6\n\nhttps://photos.app.goo.gl/SSwWhjZbBC8hrjvs6", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@para995/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3517582, "client_id": 3530451, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac4f7cf8/uploads/origins/97cd002b-79cd-4ba7-ac5f-a90808a589f4?bg=%2