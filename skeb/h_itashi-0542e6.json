c3e-3e8feb2068d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b782f209bce5e08d4c3e13963079bd9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/247922ed/uploads/origins/01293cc7-49a1-4478-9c3e-3e8feb2068d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97af1b05780ad0edee5cc3b22ebc81c6", "srcset": "https://si.imgix.net/247922ed/uploads/origins/01293cc7-49a1-4478-9c3e-3e8feb2068d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97af1b05780ad0edee5cc3b22ebc81c6, https://si.imgix.net/247922ed/uploads/origins/01293cc7-49a1-4478-9c3e-3e8feb2068d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5827a59081261654fe0107e7b7b1612a 2x, https://si.imgix.net/247922ed/uploads/origins/01293cc7-49a1-4478-9c3e-3e8feb2068d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4e927c112d6d9127b9b43b332598e689 3x"}, "body": "はじめまして。ひたしと申します。\n平素からイオンの狂気様のイラストを楽しみに拝見しております。ぜひご依頼したいと思い立ち、この度リクエストを送信させていただきました。\n【内容】\n私の創作キャラクターを描いていただきたいです。\nアイドルパロ創作のため、パステルもしくは明るいイメージで描いていただけると幸いです。\n構図やシチュエーションはお任せいたします。\n\n【キャラクターについて】\n男/10代\n4人組アイドルグループの緑担当。\nアイドルとしては新人で、グループ内では末っ子ポジション。自然体ながら元気いっぱいのパフォーマンスが特徴。\n明るく朗らかな性格。一方で周囲の顔色を伺っていることも多い。自分を拾ってくれた社長に恩を返すため、練習に打ち込んでいる。\n\n【アイドルグループについて】\n白髪の少年キャラクターを集めた一次創作アイドルパロです。\n4人を見分けるために、コンセプトカラーと別にイメージカラーを割り振っています。\nメンバー間でご飯に食べることも多く、グループ仲は良好です。\n\n【資料】\nGoogleドライブの共有リンクです。\nhttps://drive.google.com/drive/folders/14xqBYVTicixVHrdbHIX_jXkC_RXpwbJV\n衣装や雰囲気の参考にしていただければと思います。\n\n【備考】\n・金額、依頼内容、資料等に不備がございましたら、再送要請またはキャンセルをお願いいたします。\n・デザインに曖昧な点がありますが、描きやすいようにアレンジしていただいてかまいません。\n・商用利用、サムネ利用等はしませんが、SNS上でフォロワー様向けに公開させていただく可能性がございます。その場合はイオンの狂気様のアカウントを明記いたします。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/14xqBYVTicixVHrdbHIX_jXkC_RXpwbJV", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptabl