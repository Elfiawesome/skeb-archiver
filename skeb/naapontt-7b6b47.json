くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 394581, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ユタリビャク🌳", "screen_name": "byaku_yutari", "avatar_url": "https://pbs.twimg.com/profile_images/1352468317638823938/tbO0sm_8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1129765432267661312/1559660936/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 1228878, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ミリ", "screen_name": "emicha2001", "avatar_url": "https://pbs.twimg.com/profile_images/2007832507191099392/xssRl0aZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1628696887783194626/1738679396/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 2680878, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "べる茶", "screen_name": "IRASUTO__7520", "avatar_url": "https://pbs.twimg.com/profile_images/2049401301801549824/6eqbvdH-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1429613156549103617/1767377294/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 120, "skills": [