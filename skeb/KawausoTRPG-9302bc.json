などはせずとも大丈夫です。\nお忙しいところだとは思いますので無理せずにスケブの規約通りスルーしていただければと思います！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 273409, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ヨシマロ@お仕事募集中", "screen_name": "yoshimaro77", "avatar_url": "https://pbs.twimg.com/profile_images/2010377168464011264/6dKjBVbS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1092659617367154688/1768146253/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 296024, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "zip/cheavy", "screen_name": "el3ctricbuster", "avatar_url": "https://pbs.twimg.com/profile_images/1993370724682416131/_leoCwvU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1991068333790388224/1781890124/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 547761, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "えだまめ", "screen_name": "Ma_trpg_me", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F1c88e2e0-0e10-4ab3-8e23-8a7bc4a4c5ee.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/a4ae74a8-d6ca-4f10-b0f7-1a4eff05c14b.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": 