google.com/drive/folders/1ipv7T5JZPhdVFjozJoF699izOpE633Yr\n\n・キャラクターについて\n2人とも同じジムに通うトレーニーで、筋肉質かつ大柄な体格です。\n細マッチョではなく、がっしりと骨太でたくましい体の持ち主です。\nただゴツゴツしているだけでなく、女性的なしなやかさも持っています。\n性格は負けず嫌いで、どちらの力が強いかを決めるために相撲で勝負します。\n\n・シチュエーション・構図\n小細工なしで真正面からがっぷり四つに組み合う場面をお願いします。\n胸を合わせて汗だくで激しく押し合っている様子を描いていただきたいです。\n顎を相手の肩にしっかり噛ませて深く組み合って、相手の頬が歪むような迫力ある表情があると嬉しいです。\n\n・構図に関して\nもし二人の顔を同時に描くのが難しい場合は、参考資料にあるように吹き出し形式で\n一方の顔を追加していただけれるととても嬉しいです。\n\n・補足\n参考資料の姿やがっぷり四つのポーズをベースにしていただきつつ、\nあばかすさんの描きやすいようにアレンジしていただいて大丈夫です！\n(最近描かれていた黒髪と金髪の筋肉質な二人の戦い素晴らしかったです)\n\nどうぞご検討よろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/1ipv7T5JZPhdVFjozJoF699izOpE633Yr", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@avakass39/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1861997, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7193fcfd/uploads/origins/42218d95-f3b7-491c-bfc5-a3899dbc8e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b37b460356415faccca9e70c98ee2835", "srcset": "https://si.imgix.net/7193fcfd/uploads/origins/42218d95-f3b7-491c-bfc5-a3899dbc8e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b37b460356415faccca9e70c98ee2835, https://si.imgix.net/7193fcfd/uploads/origins/42218d95-f3b7-491c-bfc5-a3899dbc8e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15b5b67174193bd745e38b7f8329539a 2x, https://si.imgix.net/7193fcfd/uploads/origins/42218d95-f3b7-491c-bfc5-a3899dbc8e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b86497170693915948d81bc563545ce 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7193fcfd/uploads/origins/42218d95-f3b7-491c-bfc5-a3899dbc8e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=255cfeee54bc5e4846ae23131ef5