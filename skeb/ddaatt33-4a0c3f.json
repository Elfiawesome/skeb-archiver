\n・とても力が強い\n・角は通常白だが、感情に応じて色が変わる\n\n・シチュエーションはお任せします。\n・いろんなメイド服がある設定なので資料のメイド服にアレンジが入っても問題ありません。（露出があまりにも多すぎるのは無しでお願いします。）\n・胸はどんなに盛っても良いです。\n以下任意\n・大きいので比較対象があると良いです。\n\n描いた頂いた絵は資料として使わせていただいたり、\nSNSに載せます。\n\nご検討の程よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1EEjl94BygCO4uzS--Qb8E1hGUlDu0qA0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 42307, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "きりのは", "screen_name": "_kirinoha_", "avatar_url": "https://pbs.twimg.com/profile_images/2053436723292712960/IBSvjsVY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3004331725/1698341247/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 25}, {"id": 1539393, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あおきみどり", "screen_name": "AoKi_MiDori_", "avatar_url": "https://pbs.twimg.com/profile_images/1475246040152707073/CTdEHfa0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1194910776940564480/1738623954/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 2167827, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "M花ラピ", "screen_name": "M6ka_28", "avatar_url": "https://pbs.twimg.com/profile_images/1823642327631716358/ICA1vEBF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1542358952662700032/1696855993/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "