nscoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hearts_Cry39/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2729929, "client_id": 1366155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/565465e2/uploads/origins/0f03fdba-f9e4-45e6-851d-0744bce07b54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=199b7707520a1c2e39b71aaa702bc6f6", "srcset": "https://si.imgix.net/565465e2/uploads/origins/0f03fdba-f9e4-45e6-851d-0744bce07b54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=199b7707520a1c2e39b71aaa702bc6f6, https://si.imgix.net/565465e2/uploads/origins/0f03fdba-f9e4-45e6-851d-0744bce07b54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85eca31a298d514b74d8d49a2ebb14d2 2x, https://si.imgix.net/565465e2/uploads/origins/0f03fdba-f9e4-45e6-851d-0744bce07b54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac90ccf244b0ef2aa166e45234a8a7f1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/565465e2/uploads/origins/0f03fdba-f9e4-45e6-851d-0744bce07b54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dac74b311e2e9ea14d117229111f2428", "srcset": "https://si.imgix.net/565465e2/uploads/origins/0f03fdba-f9e4-45e6-851d-0744bce07b54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dac74b311e2e9ea14d117229111f2428, https://si.imgix.net/565465e2/uploads/origins/0f03fdba-f9e4-45e6-851d-0744bce07b54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=486866bcb438a459a3c22c20ad19a61d 2x, https://si.imgix.net/565465e2/uploads/origins/0f03fdba-f9e4-45e6-851d-0744bce07b54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=951405f6b0acc9d0045d6fdf8d7e0975 3x"}, "body": "遊戯王のRAI-MEIとトリックスター・ノーブルエンジェルのコンビがフタナリのトリックスター・リリーベルとヒヨスにハメ潰されるイラストをリクエストさせて頂きます\n\n受け:RAI-MEI&ノーブルエンジェル。生えてない。全身むちむちで乳のサイズは頭より大きく上半身を目一杯覆い、股間がギリギリ見えるくらいの超乳(可能な限り盛って下さい)\n\n攻め：リリーベル&ヒヨス。ロリ体型に腹ボコ余裕そうな巨根付き。\n\n服装は全員元のカードのイラストで着ている物で、受け側は股間が♡型の穴空きで露出勃起した乳首と盛り上がった乳輪が布越しにくっきり浮かび上がっており、攻め側は陰茎がスカートを持ち上げて露出した状態です。体位は正面が良く見えるアングルでの正常位で受け二人が横並び、攻め側の様子はバストアップのワイプを受け二人の顔の横に別枠で写すようお願いします。\n\n挿入前。攻め側が挿入を焦らし、受け側は完全に堕ちきった様子で媚びながら挿入を懇願する。\n↓\n挿入時。攻め側がSッ気のある表情で一気に挿入し、受け側はその衝撃で間抜けな叫び声を上げ即堕ちアへ顔アクメを晒す。\n↓\n挿入後。激しくピストンしながら全員軽めのアへ顔でオホ声混じりの淫語を連発しよがっている。\n↓\n膣内射精&絶頂。全員汚い口調で淫語を絶叫しながらイき、白目を剥いたここ一番の変顔に片足突っ込んだアへ顔になる。\n｢トリックスタートークン｣型の精子が卵子に受精するカットインあり。\n\n…という流れで、それぞれに二人のセリフを付けて頂きたいです。キャラの性格や口調はRAI-MEIがくっ殺の似合う隠れマゾなお姉さん系、ノーブルエンジェルは言葉遣いが上品で、バブみを感じさせるお姉さん、攻め二人はドSで遠慮知らずのメスガキといったイメージです。\n\n細かく指定してしまいましたが何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/14yhwCzNly1V-U9cFag4hy2Gl7y6BvWs3", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hearts_Cry39/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2729929, "client_id": 3448762, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/64b34eb6/uploads/origins/7e23e89f-6b90-4e90-8fdb-bd990896d5de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3366dfdc9888c06edf10b14be898838", "srcset": "https://si.imgix.net/64b34eb6/uploads/origins/7e23e89f-6b90-4e90-8fdb-bd990896d5de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3366dfdc9888c06edf10b14be898838, https://si.imgix.net/64b34eb6/uploads/origins/7e23e89f-6b90-4e90-8fdb-bd990896d5de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a420d460358f6dca8b85ca258dcfaa06 2x, https://si.imgix.net/64b34eb6/uploads/origins/7e23e89f-6b90-4e90-8fdb-bd990896d5de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=737ca0515146b27c5508ab130b767729 3x"}, "duration": null, "nsfw": t