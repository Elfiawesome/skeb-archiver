す。\n構図や背景、怪異の種類など自体はお任せしますが、コミカルな感じになってくれると嬉しく思います。全身写っていなくても構いませんし、視線もカメラに向かなくて大丈夫です。\nただ、SNSでアイコンとしてイラストの一部を使いたいので、顔やその周りを使いやすいようにして頂けると幸いです。\n\n以下はキャラクターの資料です。\nhttps://1drv.ms/i/s!AuE3CqlfKTdogohhbzmPJCTW23P_Ig\nこちらの絵柄の問題でそこそこデフォルメされた見た目をしていますか、pskさんの描きやすい等身で描いて頂けたらなと思います。\n(身に付けているドックタグには\"Kosmaro\"と掘られていますが、描写しなくても問題無いです)\n\n読みにくい文章且つ要望多めで大変申し訳ありませんが、よろしくお願い出来たらなと思います。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@psk_psk_p/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2772198, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72a373e8/uploads/origins/f96a8dca-04d6-4cd1-84fe-a201099bf0a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26eff86a2475ea0da4d5055e27ab8edb", "srcset": "https://si.imgix.net/72a373e8/uploads/origins/f96a8dca-04d6-4cd1-84fe-a201099bf0a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26eff86a2475ea0da4d5055e27ab8edb, https://si.imgix.net/72a373e8/uploads/origins/f96a8dca-04d6-4cd1-84fe-a201099bf0a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8294ae32e30fb842cb913c6f1d0e4de8 2x, https://si.imgix.net/72a373e8/uploads/origins/f96a8dca-04d6-4cd1-84fe-a201099bf0a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b650692b4003f6518feab2a049ca8cb8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72a373e8/uploads/origins/f96a8dca-04d6-4cd1-84fe-a201099bf0a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bed17bf89df6f19b758997342291772a", "srcset": "https://si.imgix.net/72a373e8/uploads/origins/f96a8dca-04d6-4cd1-84fe-a201099bf0a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bed17bf89df6f19b758997342291772a, https://si.imgix.net/72a373e8/uploads/ori