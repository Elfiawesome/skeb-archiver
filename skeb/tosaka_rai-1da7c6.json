たの絵がとても好きです!とても素晴らしいです!私のオリジナルドラゴンをお願いしたいのですが、彼は崖の上に立ち、空を見ています。太陽は彼を照らしている。翼の先端は水のようで、尻尾は枯れ木のような質感です。\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1SMUAvcMY2ZkWMTj3TEoLBLWrja7c7SbT", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tosaka_rai/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 899461, "client_id": 1682360, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf3ea19c/uploads/origins/58ed6569-29ec-4fb3-89b4-ba7128831ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49acad1873078d3a7a33c4fde6b7cd91", "srcset": "https://si.imgix.net/bf3ea19c/uploads/origins/58ed6569-29ec-4fb3-89b4-ba7128831ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49acad1873078d3a7a33c4fde6b7cd91, https://si.imgix.net/bf3ea19c/uploads/origins/58ed6569-29ec-4fb3-89b4-ba7128831ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20b5738987d23a689375c0dd2b4b2d0e 2x, https://si.imgix.net/bf3ea19c/uploads/origins/58ed6569-29ec-4fb3-89b4-ba7128831ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2a630fc365295f8824885053f4e91a3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf3ea19c/uploads/origins/58ed6569-29ec-4fb3-89b4-ba7128831ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a4df7d3db2f0d6a16dbb590783f3935", "srcset": "https://si.imgix.net/bf3ea19c/uploads/origins/58ed6569-29ec-4fb3-89b4-ba7128831ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a4df7d3db2f0d6a16dbb590783f3935, https://si.imgix.net/bf3ea19c/uploads/origins/58ed6569-29ec-4fb3-89b4-ba7128831ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc711de546c3fa73ef5cacaea0b871d9 2x, https://si.imgix.net/bf3ea19c/uploads/origins/58ed6569-29ec-4fb3-89b4-ba7128831ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cad0d5300f55f35ef7b15e9a54025661 3x"}, "body": "はじめまして。私はあなたの絵がとても好きで、いつもあなたの描くドラゴンに驚かされています。私のocは竜人なのですが、竜の姿を持ちたいので、手伝ってくれませんか？好きな要素で構わないので、自由に遊んでください。ただ、なるべく私の設定（色、傷、刺青）に合わせていただけると幸いです。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1sDDjPKSFI0-SDfg7XA8WHVnCnDclEMbw?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tosaka_rai/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 899461, "client_id": 365568, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab96ed3d/uploads/origins/3e2e61f6-14cc-4a31-8970-4fef19ec4763?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a15b59dfb6f921f129b2dfb2571afa0", "srcset": "https://si.imgix.net/ab96ed3d/uploads/origins/3e2e61f6-14cc-4a31-8970-4fef19ec4763?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a15b59dfb6f921f129b2dfb2571afa0, https://si.imgix.net/ab96ed3d/uploads/origins/3e2e61f6-14cc-4a31-8970-4fef19ec4763?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec8f4a08943246c33d656da123458be6 2x, https://si.imgix.net/ab96ed3d/uploads/origins/3e2e61f6-14cc-4a31-8970-4fef19ec4763?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2266cefb3f4b01ea7cd0e0bc7b2369e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab96ed3d/uploads/origins/3e2e61f6-14cc-4a31-8970-4fef19ec4763?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5824bb73af0578c6300dee44f9865ba", "srcset": "https://si.imgix.net/ab96ed3d/uploads/origins/3e2e61f6-14cc-4a31-8970-4fef19ec4763?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5824bb73af0578c6300dee44f9865ba, https://si.imgix.net/ab96ed3d/uploads/origins/3e2e61f6-14cc-4a31-8970-4fef19ec4763?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23260247a6ce3d1c0d9faeed2ff441f2 2x, https://si.imgix.net/ab96ed3d/uploads/origins/3e2e61f6-14cc-4a31-8970-4fef19ec4763?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=33d24cd1f08a3a5d3c3379ef52b0f91b 3x"}, "body": "こんにちは、冬狼と申します。\n先日依頼したイラストを拝見しました、実は素晴らしい作品でした。\n誠にありがとうございました！\n\n今回依頼していただきたい内容は：\n- うちの仔が夜明けの空を貫いたクリスタルタワーの頂上で盤踞して、翼を威勢よく広げて、\n塔と共に虹のような光るエーテルエネルギーを身にまとって、\n世界まるごとを再生しようとする姿を描いていただきたいです。\n(クリスタルタワー: https://www2.cs.ccu.edu.tw/~lws98m/crystal_tower.jpg )\n- サインがあれば、別レイヤでお願いしたいです。\n\nよろしくおねがいします！\n\nhttps://www2.cs.ccu.edu.tw/~lws98m/AFX_drg-v21.08-F_ja_220530.png", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tosaka_rai/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 899461, "client_id": 365568, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/56f8bdc4/uploads/origins/2846b6f4-3ddb-4b4e-9c55-65f9c5f06066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c81c65056befdc07d020fa0c928725b2", "srcset": "https://si.imgix.net/56f8bdc4/uploads/origins/2846b6f4-3ddb-4b4e-9c55-65f9c5f06066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c81c65056befdc07d020fa0c928725b2, https://si.imgix.net/56f8bdc4/uploads/origins/2846b6f4-3ddb-4b4e-9c55-65f9c5f06066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c06a05e85b8db4645c107a29c2ea5315 2x, https://si.imgix.net/56f8bdc4/uploads/origins/2846b6f4-3ddb-4b4e-9c55-65f9c5f06066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddfa92851bbef2b8425445abee35a3f0 3x"}, "duration": null, "nsfw": false, "h