op&w=200&h=200&s=920d363853dc7d6c03bb2b168a696760", "srcset": "https://si.imgix.net/6d26745b/uploads/origins/320618f4-3d46-4aeb-b4c6-af1898facb24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=920d363853dc7d6c03bb2b168a696760, https://si.imgix.net/6d26745b/uploads/origins/320618f4-3d46-4aeb-b4c6-af1898facb24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a18f11d889d5e9b933cea3c5f7c433c 2x, https://si.imgix.net/6d26745b/uploads/origins/320618f4-3d46-4aeb-b4c6-af1898facb24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0fbf622e990c669ef1710cdfd2a03b96 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d26745b/uploads/origins/320618f4-3d46-4aeb-b4c6-af1898facb24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=024f76191b23b456b17fb30652a5ff2a", "srcset": "https://si.imgix.net/6d26745b/uploads/origins/320618f4-3d46-4aeb-b4c6-af1898facb24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=024f76191b23b456b17fb30652a5ff2a, https://si.imgix.net/6d26745b/uploads/origins/320618f4-3d46-4aeb-b4c6-af1898facb24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b354bda569cbdb2290986aaf12aa2bfe 2x, https://si.imgix.net/6d26745b/uploads/origins/320618f4-3d46-4aeb-b4c6-af1898facb24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=462b0f62be3c822a024fd88a11acd77a 3x"}, "body": "柚ノ輪霧 様\nはじめまして。\nVtuberの早乙女宵と申します。\n美しくて可愛いイラストたちに惹かれ、ぜひご依頼させていただきたくリクエストしました。\n友人の転寝実兎と私、早乙女宵のツーショットのPC壁紙（16:9）が欲しいです。\n\nYouTubeでの配信やSNS、ネットワークプリントまたはグッズなどで利用させていただきたいです。\n\nポーズや構図はお任せしたいのですが、頭部とうさ耳部分に見切れがないと嬉しいです。\nまた、衣装ですが、双子コーデのように色違いやポイント違いのワンピースにしていただけましたらありがたいです。\nワンピースイメージ：ボディラインがわかりやすいように胸の下で切り替えがある、花柄をあしらいがある\n\nそれぞれの特徴\n転寝実兎の耳はうさぎ耳のみで、胸元は矢印ではなくダイヤです。\n早乙女宵の耳もうさ耳のみで、左目の下に泣き黒子があり、黒（紫）色の髪にピンクのインナーカラー、目が赤ベース～黄色のグラデーションです。\n詳しくは添付いたしますそれぞれの三面図と立ち絵の資料でご確認いただけますと幸いです。\n\n背景、早乙女宵、転寝実兎でレイヤー分けしたpsdファイルか、各人物のみの背景透過もいただけると助かります。\n\n二人分の依頼でどれくらいの値段になるのかわからず、一旦おすすめ金額で依頼させていただいております。\nもし、足りない場合はリクエスト再送依頼を出していただけたらと思います。\n\nお忙しいところ読んでいただきありがとうございます。\nご縁がありましたらぜひよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1r239hyE3SXTjoiqqSek5oZnhuwlRQe0K?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nyandarfull_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3227279, "client_id": 2568412, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c92a527/uploads/origins/3066691e-bb0f-49b3-9032-56cedcd7cf12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f9993ed7342350b58ee18cd9872a416", "srcset": "https://si.imgix.net/5c92a527/uploads/origins/3066691e-bb0f-49b3-9032-56cedcd7cf12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f9993ed7342350b58ee18cd9872a416, https://si.imgix.net/5c92a527/uploads/origins/3066691e-bb0f-49b3-9032-56cedcd7cf12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf7659ad2911bb8d1fa5a47974835260 2x, https://si.imgix.net/5c92a527/uploads/origins/3066691e-bb0f-49b3-9032-56cedcd7cf12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64aad9eed8b56888726fdbd608a0cbf4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c92a527/uploads/origins/3066691e-bb0f-49b3-9032-56cedcd7cf12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db4028d4f009b54654915dd4b2cd8cf2", "srcset": "https://si.imgix.net/5c92a527/uploads/origins/3066691e-bb0f-49b3-9032-56cedcd7cf12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db4028d4f009b54654915dd4b2cd8cf2, https://si.imgix.net/5c92a527/uploads