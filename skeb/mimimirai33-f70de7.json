c-ed856e56b18a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5273dbc07c0fec35878121d1b8057221 2x, https://si.imgix.net/b3d2aac5/uploads/origins/6df8ac5f-0ccd-4b8e-b01c-ed856e56b18a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e50b0c47ec88af14933ad101352116c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3d2aac5/uploads/origins/6df8ac5f-0ccd-4b8e-b01c-ed856e56b18a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d8e8327492399f6172cf33089e82cd4", "srcset": "https://si.imgix.net/b3d2aac5/uploads/origins/6df8ac5f-0ccd-4b8e-b01c-ed856e56b18a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d8e8327492399f6172cf33089e82cd4, https://si.imgix.net/b3d2aac5/uploads/origins/6df8ac5f-0ccd-4b8e-b01c-ed856e56b18a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=03f6461fc3781a840ba25c9799ef4461 2x, https://si.imgix.net/b3d2aac5/uploads/origins/6df8ac5f-0ccd-4b8e-b01c-ed856e56b18a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c27834bad6fd0bbac5f04ea4cdd9340a 3x"}, "body": "こんにちは\n\n漫画プランが出来ていたので現在対応していただいてるところ恐縮ですが漫画形式でもお願いしたくリクエストさせていただきました\n\n⬛︎キャラクター\n前回と同じくクラリス\n体系は原作依拠で陰毛＆脇毛有り\n毛の色は髪の色と一緒でお願いします\n\n⬛︎設定\n\n原作で舞台女優と戦闘部隊を兼任してるという設定なのですが、敵に敗北して部隊は解散\n国にも帰れずスラムで底辺売春婦に堕ちてるという設定\nあくまで生きるために仕方なく売春をしてて恥じらいや抵抗がある\n\n⬛︎漫画の形式\n\n一枚絵パターンでもコマ割りパターンでも描きやすい方で構いません\n口調が敬語というだけの特徴のないキャラなので可能でしたら台詞もお願いしたいです\n\n下記の内容の台詞はニュアンスだけの箇条書きなので適宜アレンジしていただければ、台詞入れるのが不可能な場合は流れの参考にしていただければ幸いです\n\nPSD納品で台詞と吹き出しがあればレイヤー分けをお願いします\n\n⬛︎内容\n\n・服装は原作のカチューシャに露出狂が着るようなトレンチコート\nトレンチコートの下が乳輪と陰毛がはみ出てるマイクロビキニ\n・スラムの一角でチンピラ風の男複数人にトレンチコートを開いて「わ、私と遊んでくれませんか」と引き攣った笑顔で売春を持ちかけてる\n・「あれ？こいつ有名だったやつじゃね？」と髪を引っ張られながら興味を持たれ\n・無洗のチンカスチンコフェラ強要から始まり\n・濡れてない性器に強引に挿入され痛がる\n・締まりが悪いと尻を叩かれたり乳首を思いっきり抓ったり引っ張られる、尻にタバコで根性焼きされる\n・使ったことないアナルにも無理やり挿入されて裂けて流血\n・首絞めたら締まると首絞めックス\n等リンチに近い形で輪姦される\nページ数に余裕があり上記以外でも何か良いアイデアがあればこちらのNGは特にないので入れていただければ幸いです\n・最終的に全裸でボロボロにされた挙句「淫売」「無価値マンコ」等身体に落書きされ、両穴にタバコ詰まった空き缶挿入されゴミ捨て場に大股開きで捨てられる\n泣きながら呻いてる所に男たちに小便をかけられて〆\nといった形でお願いします\n・男たちは見下して馬鹿にしてる態度\n・クラリスはチンカスチンコ突きつけられ「ひっ…は、はい」と抵抗のある感じ\n「痛いです！」\n「すいません頑張って締めます！」\n「や、優しくしてください…」\n「無理です避けちゃいます！」\nみたいな感じの態度でお願いします\n\n以上の内容をこちらの金額で可能なページ数で描いていただけますでしょうか？\n想定のページ数に対して金額が不足してる場合お手数ですが再送していただければ幸いです\nまたも要望が多く申し訳ないのですが何卒よろしくお願いします", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mimimirai33/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c353bda0/uploads/origins/233d9f60-00d3-42ce-939c-efb6e6c4ed0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32caf0c3a79d92aa8f526d2e485d3d30", "srcset": "https://si.imgix.net/c353bda0/uploads/origins/233d9f60-00d3-42ce-939c-efb6e6c4ed0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32caf0c3a79d92aa8f526d2e485d3d30, https://si.imgix.net/c353bda0/uploads/origins/233d9f60-00d3-42ce-939c-efb6e6c4ed0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f27fe7dcbb975811b4a33f20b1acef7 2x, https://si.imgix.net/c353bda0/uploads/origins/233d9f60-00d3-42ce-939c-efb6e6c4ed0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=625897434900dd73852db9d6c97c8b3d 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3391071, "client_id": 415155, "nc": 176}, {"path": "/@mimimirai33/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c9107c4a/uploa