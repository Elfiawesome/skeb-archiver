2f61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17769e3a6d2f656cd753785fdd7c4c5b", "srcset": "https://si.imgix.net/e29c1f24/uploads/origins/d314eade-8803-4e4e-ad74-35a7d0e92f61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17769e3a6d2f656cd753785fdd7c4c5b, https://si.imgix.net/e29c1f24/uploads/origins/d314eade-8803-4e4e-ad74-35a7d0e92f61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9e7a4e49cda0aec43cb4a7e876b3b373 2x, https://si.imgix.net/e29c1f24/uploads/origins/d314eade-8803-4e4e-ad74-35a7d0e92f61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=12f778e669c713ec2f5e24560f515438 3x"}, "body": "久々のリピート依頼失礼します、今回も自分の代理君を題材に描いていただきたくリクエストしました…！ \n\nhttps://x.com/y_watch2015/status/1703783839200633014?t=niWWgoG5ErE_ESUeyqySog&s=19 \n\nhttps://x.com/y_watch2015/status/1968329100503683524?t=6FR5448ds-jx_A_J6H6SbQ&s=19 \n\n内容としては\n・ある日「あなたは今年のサンタに選ばれました」という手紙が届けられその日から段々容姿が変わっていき月日が経ち次のクリスマスには立派なサンタになっている代理君 \n\n詳細\n・月日が経つ部分については日めくりカレンダーがパラパラと捲れていく感じで \n\n・変わっていく描写は\n└体重が増えていきそれと比例する様に身体もブクブク太っていく \n\n└顔には眉毛や口・顎髭も生え始める \n\n└赤い服を好む様になっていく \n\n└クリスマスに近づくにつれ更に太り眉毛や髭はグレーから白く毛深くなっていき特に髭は何度剃っても直ぐに生える \n\n└老眼鏡をかけないと見えない位視力が落ちる \n\n・サンタとしての容姿は\n真っ白のモフモフ眉毛やもっふりカールされた口髭、ボリュームたっぷりの顎髭が生えシワも目立つ顔、小さな老眼鏡をかけウェーブがかった肩までかかる髪も生えている(後頭部のみでなく頭頂部と前髪以外は普通に生え揃っている感じでお願いします) \n\n・でっぷり突き出たお腹と髭を触りながら「ありゃりゃ…」と言った様な困惑した表情 \n\n描いてもらえる際もし不都合があれば描写等を変更してもらって構いません、その他細かい部分等もお任せしますので宜しくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tbbtt28/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 872719, "client_id": 284909, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d162d2fd/uploads/origins/58733c83-e6c6-4203-a202-59914954e2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dec3c7688fd63b06b9c8c8c22a2f5bb7", "srcset": "https://si.imgix.net/d162d2fd/uploads/origins/58733c83-e6c6-4203-a202-59914954e2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dec3c7688fd63b06b9c8c8c22a2f5bb7, https://si.imgix.net/d162d2fd/uploads/origins/58733c83-e6c6-4203-a202-59914954e2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c88a2e232bc1931116b040f38411df0 2x, https://si.imgix.net/d162d2fd/uploads/origins/58733c83-e6c6-4203-a202-59914954e2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6098e0631d26e85ee905ba2e7085cb6c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d162d2fd/uploads/origins/58733c83-e6c6-4203-a202-59914954e2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f93d22b63f46e7539c4cba905484a2b1", "srcset": "https://si.imgix.net/d162d2fd/uploads/origins/58733c83-e6c6-4203-a202-59914954e2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f93d22b63f46e7539c4cba905484a2b1, https://si.imgix.net/d162d2fd/uploads/origins/58733c83-e6c6-4203-a202-59914954e2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=68ccc40b1f65438834f7f5a0d0540d98 2x, https://si.imgix.net/d162d2fd/uploads/origins/58733c83-e6c6-4203-a202-59914954e2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0f702054d89b9aac572a8c683f7a1101 3x"}, "body": "リピート依頼失礼します！ 今回も代理君を題材に描いていただきたく依頼しました…！ \n\n[資料１]\nhttps://x.com/y_watch2015/status/1703783839200633014?t=ILJxknXqJRDoaoxs-6VPgA&s=19 \n\n[資料２]\nhttps://x.com/y_watch2015/status/1835653892732039243?t=1VaoExem0960gchryszyfg&s=19 \n\n内容としては\n・代理君が不思議な巫女衣装を着用した途端ボワッと煙に包まれ気づくとヨボヨボに老いた姿になっている \n\n詳細として\n・代理君は巫女衣装を着る為に女装メイクをしている \n\n・巫女衣装は一般的に知られた紅白の色とデザインで \n\n老いた姿の詳細として\n・顔はシワシワ、シミもたっぷりと増え頬には肉も付いて如何にもヨボヨボお爺さんという顔 \n\n・眉、口髭、顎髭が生え更に側頭部、後頭部からは長髪も生えている(毛は全て真っ白) \n\n・眉と口髭はもっふり感、顎髭と側頭部に後頭部の髪はくっついており下方にボリュームたっぷりのサラサラ感(資料２のように頭頂部は禿げていて髪は生えていない) \n\n・身体にもたっぷりと贅肉が付いて衣装がはち切れんばかりのでっぷりお腹 \n\n・女装したままなのでメイクもそのままに \n\n・「またぁ？」と言った感じの汗をかきつつ困った様な表情\n\n\n\n細かい部分等はお任せで、宜しくお願いします…！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tbbtt28/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 872719, "client_id": 284909, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fcf892e6/uploads/origins/912ee873-b6e0-424a-ba71-a038abd49f7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=342e48cc967e3e8e012e6b63a9672b0f", "srcset": "https://si.imgix.net/fcf892e6/uploads/origins/912ee873-b6e0-424a-ba71-a038abd49f7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=342e48cc967e3e8e012e6b63a9672b0f, https://si.imgix.net/fcf892e6/uploads/origins/912ee873-b6e0-424a-ba71-a038abd49f7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=741dcfe78a5b472560283a6d82b9242e 2x, https://si.imgix.net/fcf892e6/uploads/origins/912ee873-b6e0-424a-ba71-a038abd49f7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ddda2908cb6edc55240c92bf97fb549 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fcf892e6/uploads/origins/912ee873-b6e0-424a-ba71-a038abd49f7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a568b22c174d6c0ae4f3682b7aea07f", "srcset": "https://si.imgix.net/fcf892e6/uploads/origins/912ee873-b6e0-424a-ba71-a038abd49f7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a568b22c174d6c0ae4f3682b7aea07f, https://si.imgix.net/fcf892e6/uploads/origins/912ee873-b6e0-424a-ba71-a038abd49f7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=557198d1e7ded18c03317c776babcf62 2x, https://si.imgix.net/fcf892e6/uploads/origins/912ee873-b6e0-424a-ba71-a038abd49f7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed959882056157abd34d7e7dbbc836a8 3x"}, "body": "リピート依頼失礼します…！ 前回の老代理君がとても素敵だったので今回も代理君を描いていただきたくリクしました。 \n\n[資料１]\nhttps://x.com/y_watch2015/status/1703783839200633014?t=1rhWyiXDvc7qsjkxQQmAxA&s=19 \n\n[資料２]\nhttps://x.com/y_watch2015/status/1753040542228009445?t=Uxn06G41qeO1woG1pgKNPw&s=19 \n\n[資料３]\nhttps://x.com/y_watch2015/status/1835653892732039243?t=GdvAFLT73b2FEmQbL2SJUg&s=19 \n\nシチュとしては\n・祠を誤って壊してしまった代理君がその祠に封じられていた老狐の霊の祟りでジワジワと同じような姿にされてしまう \n\n詳細について\n・代理君は祟りで猫の姿から老狐の霊と同じような狐の姿にされてしまう \n\n・マズルは伸び真っ白もふもふ眉に口と頬から顎に沿って広がりお腹にかかる程ボリューミーな髭、後頭部には長髪が生えてきている(口髭は他の髭とは繋がっていない) \n\n・顔には深い皺やシミが増え目尻も下がっている \n\n・身体の模様は代理君の時のまま、毛色は元の代理君よりもくすんだ色に \n\n・服装は緑パーカー、紺のハーフズボンから全身深緑色の着物に変化 \n\n・身体は元の代理君よりも肉が付いて太りお腹に至っては着物の上からでもはっきりわかる程でっぷり突き出ている \n\n・ジワジワ変化していく自身の身体に困惑と驚きの表情で両手で頬の髭をくしゃくしゃ触っている \n\n・老狐の霊は身体の毛色・模様以外は狐化された代理君とほぼ同じ姿 \n\nその他細かい部分等はお任せします…！\n宜しくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tbbtt28/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 872719, "client_id": 284909, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c5b49e6/uploads/origins/75e548bc-01b2-4ae2-86b2-78b6ec70390b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb6602129726e5007c3eddb216db3094", "srcset": "https://si.imgix.net/0c5b49e6/uploads/origins/75e548bc-01b2-4ae2-86b2-78b6ec70390b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb6602129726e5007c3eddb216db3094, https://si.imgix.net/0c5b49e6/uploads/origins/75e548bc-01b2-4ae2-86b2-78b6ec70390b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd9a88f2b90ee1827639d2792fa58cbd 2x, https://si.imgix.net/0c5b49e6/uploads/origins/75e548bc-01b2-4ae2-86b2-78b6ec70390b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee52430b3787686bc0b73f3dad3376e3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c5b49e6/uploads/origins/75e548bc-01b2-4ae2-86b2-78b6ec70390b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=714ab9ca9761c0859939938434136e82", "srcset": "https://si.imgix.net/0c5b49e6/uploads/origins/75e548bc-01b2-4ae2-86b2-78b6ec70390b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=714ab9ca9761c0859939938434136e82, https://si.imgix.net/0c5b49e6/uploads/origins/75e548bc-01b2-4ae2-86b2-78b6ec70390b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e0fe545f10824909b2b7da6c45ad9a32 2x, https://si.imgix.net/0c5b49e6/uploads/origins/75e548bc-01b2-4ae2-86b2-78b6ec70390b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f6423249ce0668a24174558d70933c5f 3x"}, "body": "ちびちょこさん初めましてユートと申します。ケモノのもふもふ絵柄に惹かれ依頼をさせていただきます！ \n\n今回自分の代理君の\"老いた姿\"(下記の資料３に描かれている服装で)を描いて貰いたくリクエストしました。 \n\n[資料１]\nhttps://x.com/y_watch2015/status/1703783839200633014?t=PLSEXDiFuj2zC_iWaHNeAQ&s=19 \n\n[資料２]\nhttps://x.com/y_watch2015/status/1753040542228009445?t=_mIFFJRY1sTirYYF7Uv0Rw&s=19 \n\n[資料３]\nhttps://x.com/y_watch2015/status/1835653892732039243?t=0d3R10I-wDHHftZXtYDOxQ&s=19 \n\n前提として\n・還暦祝いの手紙を受け取り開いた代理君が不思議そうにすると突然ボン！っと煙に包まれ気づくと杖を突くほどヨボヨボに老いた姿になってしまったという体で描いていただけると \n\n詳細\n・元の年齢(３０代)から倍に年を重ねた代理君はヨボヨボになり毛色はくすんだ色となって目尻は下がり顔や手、身体にはシミ皺があちこち浮き上がっている \n\n・ボリューミーな口・顎髭が生え顎髭に至ってはお腹にかかる程の毛量(資料１、２は眉が描いてありますが眉無し、元の代理君の眉間に生えている細い白い毛のみでお願いします) \n\n・服装は暗めのオレンジ色シャツに深緑のベストを羽織っていて下は紺色のズボンを履いている \n\n・身体には贅肉が増えお腹はでっぷり突き出てシャツから下っ腹がはみ出している \n\n・突然の出来事に訳が分からず？？？となり驚いた表情 \n\nその他細かい部分等はお任せ致します、描いたことの無いシチュのリクエストかと思いますが何卒宜しくお願いします…！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_