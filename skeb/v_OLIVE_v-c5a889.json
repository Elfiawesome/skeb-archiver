\n・衣装、装飾などのデザインは先生の描きやすいように別衣装へ変更、またはアレンジしていただいて構いません\n・ポーズはカッコよく、かつセクシーな感じにしていただければと思います(難しいようなら先生の作風でお好きなように描いていたたければと思います)\n\n\n依頼内容と金額が合わなければお手数おかけしますが金額指定で再送依頼を送っていただけると有難いです。長々と要望を書いてしまいましたが何卒ご検討の程よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@v_OLIVE_v/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3508494, "client_id": 45236, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4dc1514/uploads/origins/48a4e062-0be2-4c3e-bbe7-f8f2929d0269?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7409efea0d7c3fd107b38bd7f143d0b4", "srcset": "https://si.imgix.net/a4dc1514/uploads/origins/48a4e062-0be2-4c3e-bbe7-f8f2929d0269?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7409efea0d7c3fd107b38bd7f143d0b4, https://si.imgix.net/a4dc1514/uploads/origins/48a4e062-0be2-4c3e-bbe7-f8f2929d0269?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0cfc5fc8707128c78315b8e8ed42e96 2x, https://si.imgix.net/a4dc1514/uploads/origins/48a4e062-0be2-4c3e-bbe7-f8f2929d0269?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6614fa70979e2a7099a70272119c7c77 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4dc1514/uploads/origins/48a4e062-0be2-4c3e-bbe7-f8f2929d0269?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2777e26873063322ced2634a9b9b7b2", "srcset": "https://si.imgix.net/a4dc1514/uploads/origins/48a4e062-0be2-4c3e-bbe7-f8f2929d0269?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2777e26873063322ced2634a9b9b7b2, https://si.imgix.net/a4dc1514/uploads/origins/48a4e062-0be2-4c3e-bbe7-f8f2929d0269?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed6830da