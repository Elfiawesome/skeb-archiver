b-4531-a4d6-3482c432c64e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df602529f50cebae961d5882b00aae6f, https://si.imgix.net/f7be64fb/uploads/origins/080dee4b-e41b-4531-a4d6-3482c432c64e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31ec029699b74abf930a6941889c1ac8 2x, https://si.imgix.net/f7be64fb/uploads/origins/080dee4b-e41b-4531-a4d6-3482c432c64e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49feac5013942577a9cc505a0a9e1a00 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f7be64fb/uploads/origins/080dee4b-e41b-4531-a4d6-3482c432c64e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80f69850b2ac0289c038bd136ab19ef1", "srcset": "https://si.imgix.net/f7be64fb/uploads/origins/080dee4b-e41b-4531-a4d6-3482c432c64e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80f69850b2ac0289c038bd136ab19ef1, https://si.imgix.net/f7be64fb/uploads/origins/080dee4b-e41b-4531-a4d6-3482c432c64e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a31ca047e13830ef3b6a437472c91b11 2x, https://si.imgix.net/f7be64fb/uploads/origins/080dee4b-e41b-4531-a4d6-3482c432c64e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=46b0bd74154073b07f3136282142092c 3x"}, "body": "こんにちは！台湾からの個人勢VTuber、赤魑です。\n\nXの作品を見て、先生の作品の色使いとライティングは本当に美しいですね！\n\n私のvtuberキャラクターを先生のスタイルで描いていただきたいです。\n\n✦ キャラクター詳細\n\n    性別：中性 / 無性別\n    種族：墮神 (穢神）\n    身高：155 cm\n    髪色：黒→暗い赤\n    瞳色：金色（黒目白）\n      ‼️ 通常は顔と髪の上の目は閉じていますが、感情がはっきりしている時にだけ開けます。\n      ‼️ 身体の目は常に開いており、無意識に動き回っています。\n\n参考画像に描かれていない部分は、先生が自分の想像で補完していただいても構いません！\n\n✦ 背景故事\n\n    この山神の微笑みはかつて彼と人間の間の架け橋でした。彼は軽薄な態度とユーモラスな話術で、人々に喜びと慰めをもたらしました。しかし、山林の開発による汚染によって、彼は堕神となり、感情は複雑で不安定になりました。\n\n    彼の目は常に半閉じで、彼の内なる痛みと心配を表しています。微笑みは感情が比較的落ち着いた時にしか現れませんが、笑顔が顔に浮かんでも、その中には悲しみの色合いも含まれています。\n\n    彼は一人の時、心は静かになります。彼は騒々しさから逃れ、山林の静寂に浸るのが好きです。この静けさの中で、彼は過去の美しい時光を思い出すことができますが、二度と戻ることはできません。\n\n✦ 畫面呈現\n\n    構図やポーズは特定しないで、光源と雰囲気に重点を置いたイメージですね。\n\n     あまり気にせずにやってくださいね！\n            \n✦ 使用用途 \n\n    OP or ED、SNS社群、ライブ配信プラットフォーム、実体商品の製作が可能です。\n\n✦ 納品希望\n\n    キャラクター部分は独立したレイヤーで描いていただけると嬉しいです。\n\nhttps://drive.google.com/file/d/1-mRfsWrwf8xWEInC0h0S9G21W8d20cfs/view?usp=drivesdk", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1224240, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "こめだ", "screen_name": "sushi_kuine7", "avatar_url": "https://pbs.twimg.com/profile_images/1555171332794765312/CmF7Qn5C.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1215485957345951744/1679479147/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 128}, {"id": 1933200, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "といとい", "screen_name": "toitoitoi23", "avatar_url": "https://pbs.twimg.com/profile_images/2057044898944315392/K14xg636.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1450694813540487169/1779027736/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 129}, {"id": 2610607, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "蓮/はす", "screen_name": "hasunohato_", "avatar_url": "https://pbs.twimg.com/profile_images/1799474768032444416/Pu61EYxF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1418359247708901376/1777554569/1500x500", "appeal_rec