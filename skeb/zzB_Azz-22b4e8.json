大胆で、しかし魅力的な微笑みを持っている。古代エルドリッチの神で、人間がなぜ良いことをするのかに興味がある。\n\n私は、ばんさんが描く人間以外の素晴らしいキャラクターをとても楽しんでいます。今回のリクエストでは、タイスを怪物の女の子として解釈した作品をぜひ見てみたい！\n\n以前、完全に「怪獣」なタイスを依頼したのですが、ぜひ、もっと「人型」なタイスを描いていただきたいです。基本的には、人間と非人間の中間のようなフォルム。\n\n解釈は自由です！基本的には自由にデザインして描いてください！何でもOKです。\n\nよろしくお願いします！\n\nhttps://www.deviantart.com/stash/221mhvi2j14e", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@zzB_Azz/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ecdd16fc/uploads/origins/d4eee8f2-daf8-483a-b0b8-e4fc3ced7d92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b4d5e36bd1abc0bcf32f2c36bf524b3", "srcset": "https://si.imgix.net/ecdd16fc/uploads/origins/d4eee8f2-daf8-483a-b0b8-e4fc3ced7d92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b4d5e36bd1abc0bcf32f2c36bf524b3, https://si.imgix.net/ecdd16fc/uploads/origins/d4eee8f2-daf8-483a-b0b8-e4fc3ced7d92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46174f345ba67ca7be1c3ecae06817cc 2x, https://si.imgix.net/ecdd16fc/uploads/origins/d4eee8f2-daf8-483a-b0b8-e4fc3ced7d92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=316d0251297e4a5fc7c34e79ca708cd1 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2178277, "nc": 16}, {"path": "/@zzB_Azz/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2178277, "client_id": 1646004, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8a59661/uploads/origins/4311115a