oose one clothes to draw.\n1.  https://drive.google.com/file/d/1UiLPFhP5ek8a1UnPn68FJwN-WOpu_9DM/view?usp=drive_link\n2. https://drive.google.com/file/d/1Bmt_jnIo8DcXsOT09nZZh3A-CCLfnrSe/view?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RSN_07/works/225", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 515461, "client_id": 1910270, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11503c8f/uploads/origins/ee750734-b4a3-470e-9e46-ce735b1079b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5f79ef010a640c840599ce6f3ed9513", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11503c8f/uploads/origins/ee750734-b4a3-470e-9e46-ce735b1079b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ba9c6588842ab67a5b64a059e841329", "src_set": ""}, "body": "こんにちは！僕のスフィンクス・ガールのアートが欲しいんだ。彼女が魔法をかけられたら素晴らしいだろうね！彼女の魔法は金色です。\n\nhttps://imgchest.com/p/vj4jk283378", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RSN_07/works/224", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 515461, "client_id": 1328807, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8dcad3e/uploads/origins/45ee6286-68da-4915-9d68-2cf3d3faabeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ba4f01d8e2d8286c255f35c077d0ecc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d8dcad3e/uploads/origins/45ee6286-68da-4915-9d68-2cf3d3faabeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6653debca4240a2ad671d7a37a0af67e", "src_set": ""}, "body": "やあ、RSN！またまたスケブに来ました！\nあなたの素