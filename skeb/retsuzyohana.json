fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=79a3cbe3630939aa8d16824243a3e9c6 3x"}, "body": "こんにちは！UNDERTALEに登場するモンスターの子供のシナリオを描いて欲しいです。あなたの画風を見てみたいです！シナリオは、大人の人間がモンスターキッドを騙してフェラチオをさせ、オナホールのように使うというものです。モンスター・キッドは人間の解剖学的構造を知らないので、一種のゲームだと思っている。勝てば「温かい塩味のミルク」がもらえる。そして大人の人間は、下の口から食べさせると言って彼らをだまし、モンスター・キッドはオナホールのように使われることになる。モンスター・キッドは性別がないとされているので、トカゲに似ていることから、肛門（総排出腔）があるのだと思う。大人の人間との新しい経験を学んで恍惚とする彼らの顔が見たい！  性別がはっきりしていないにもかかわらず、\"ミルク \"で満たされ、つま先がキュッとなるようなオーガズムを感じているところを見てみたい。私のアイデアを気に入ってもらえると嬉しい！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@retsuzyohana/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2185126, "client_id": 3399419, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f51166f2/uploads/origins/05b24238-8840-4295-8fad-7e4fc1a922f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27a5fd2a3c4a042afde81a99da4cdd76", "srcset": "https://si.imgix.net/f51166f2/uploads/origins/05b24238-8840-4295-8fad-7e4fc1a922f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27a5fd2a3c4a042afde81a99da4cdd76, https://si.imgix.net/f51166f2/uploads/origins/05b24238-8840-4295-8fad-7e4fc1a922f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=daa9e07a5756ca9d5534839748a592ff 2x, https://si.imgix.net/f51166f2/uploads/origins/05b24238-8840-4295-8fad-7e4fc1a922f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=885fa7fd2464f930b04163b30c8dac04 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f51166f2/uploads/origins/05b24238-8840-4295-8fad-7e4fc1a922f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eabdc50901edc671a5a234a4c90f6dd0", "srcset": "https://si.imgix.net/f51166f2/uploads/origins/05b24238-8840-4295-8fad-7e4fc1a922f6