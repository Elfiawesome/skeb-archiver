外で遊ぶタイプではなく、特別な約束がなくても気づけば自然と一緒にいることが多かった。\n\n愛斗は昔から変わらず距離感が近く、軽く肩に触れたり頭を撫でたりと、何気ないスキンシップが多い。\n本人に自覚はなく、昔と同じ調子で琥珀に接している。\n\n一方で琥珀は、思春期以降その距離感を強く意識するようになり、以前のようには受け止めきれずにいる。\n何気ない仕草や言葉にさえ、どこか落ち着かない感情を覚えてしまう。\n\nhttps://drive.google.com/drive/folders/1_X5jtgLRGpBbQ78VheXt817VAmGzpyOM", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@title_mei/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3787647, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9dbd190/uploads/origins/ca02dc42-367f-4162-bcc8-8c38719f76e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f01bdea5c970d60b8fcec5a2ce292e8b", "srcset": "https://si.imgix.net/f9dbd190/uploads/origins/ca02dc42-367f-4162-bcc8-8c38719f76e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f01bdea5c970d60b8fcec5a2ce292e8b, https://si.imgix.net/f9dbd190/uploads/origins/ca02dc42-367f-4162-bcc8-8c38719f76e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=713772ef937b844e1f69d393fe140361 2x, https://si.imgix.net/f9dbd190/uploads/origins/ca02dc42-367f-4162-bcc8-8c38719f76e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9a602de600d5c594441573e87214aba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9dbd190/uploads/origins/ca02dc42-367f-4162-bcc8-8c38719f76e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf70bbb57d1a0ed89ad2188edb179fd8", "srcset": "https://si.imgix.net/f9dbd190/uploads/origins/ca02dc42-367f-4162-bcc8-8c38719f76e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf70bbb57d1a0ed89ad2188edb179fd8, https://si.imgix.net/f9dbd190/uploads/origins/ca02dc42-367f-4162-bcc8-8c38719f76e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=