n服装やポーズ、シチュエーション等の指定はありません。細かな装飾なども省いていただいて構いません！\nメロウさんのイラストと世界観が大好きなので、どうか好きなように描いて頂けたらと思います！\n\n使用用途としては個人的な鑑賞に使用したいと考えています。\n何か金額等失礼がありましたら申し訳ありません、もし難しいようでしたら再送して頂けると嬉しいです。\nご検討の程、何卒宜しくお願いします…！\n\nhttps://drive.google.com/drive/folders/1DdZZJURoKDORea2vvUdX2-OTxY3rpHBM?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yudansurunayo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3949039, "client_id": 3839551, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f5751eb/uploads/origins/9b022735-f26d-48ab-bfa4-5d5fee42f40d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5b97e6273c71e50aa816dcdbcc217f7", "srcset": "https://si.imgix.net/8f5751eb/uploads/origins/9b022735-f26d-48ab-bfa4-5d5fee42f40d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5b97e6273c71e50aa816dcdbcc217f7, https://si.imgix.net/8f5751eb/uploads/origins/9b022735-f26d-48ab-bfa4-5d5fee42f40d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3df935fdca910d31e94e10e76554df7e 2x, https://si.imgix.net/8f5751eb/uploads/origins/9b022735-f26d-48ab-bfa4-5d5fee42f40d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3625ea8dda41007e428691a49504713c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f5751eb/uploads/origins/9b022735-f26d-48ab-bfa4-5d5fee42f40d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a1d90cfd21e8eb0f3539d6d44ef0023", "srcset": "https://si.imgix.net/8f5751eb/uploads/origins/9b022735-f26d-48ab-bfa4-5d5fee42f40d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a1d90cfd21e8eb0f3539d6d44ef0023, https://si.imgix.net/8f5751eb/uploads/origins/9b022735-f26d-48ab-bfa4-5d5fee42f40d?bg=%23fff&auto=forma