4a-b97691a343d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8c46dc0cb3e0287693f8da799050d1d, https://si.imgix.net/2edebe84/uploads/origins/6b3b0f93-fdc0-4520-b44a-b97691a343d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0cd298901c4a5c99191740ce6232d9e8 2x, https://si.imgix.net/2edebe84/uploads/origins/6b3b0f93-fdc0-4520-b44a-b97691a343d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1f5669965638a4e4feec671688032c55 3x"}, "body": "いつもお世話になっております。\n\nそれでは依頼内容となりますが、今回は2人のオリジナルキャラクターを描いていただきたく思っております。\n\nキャラクターの詳細は以下の通りです。\n\n1人目は白髪の少女。髪の色は真っ白よりも生成色くらいが良いです。髪は腰あたりまで長く、胸は小さめ。瞳の色も髪色と同様に。\n彼女は真紅の片手長剣を持っています。鞘はありません。\n服装は動きやすい軽装。フード付きの黒いマントを羽織っていますが、フードは被らず、前は中に着ている服が見えるように開けてほしいです。その他、細かな部分はお任せします。\n\n2人目は桃髪の少女。薄ピンクくらいが良いです。髪は肩より少し長いくらい、胸はそこそこある程度。瞳の色は水色。\n彼女は見習いの魔法使いで、主に炎系の魔法が得意です。\n服装はお任せします。ファンタジー寄りであれば、自由に描いていただいて構いません。\n\n構図も特に指定は無いためお任せします。もし可能であれば、表紙のように名前とロゴ入れをしていただけると幸いです。作品名は「女剣士の魔法事情」です。\n\n用途といたしましては何時もの通りです。\n都合が良ければ、何卒よろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tena_kc/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 859978, "client_id": 995788, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/752e7504/uploads/origins/e615221f-840b-4e97-a0ac-4564feee864e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b83818c3bb393ceb81a33bc7de03daf0", "srcset": "https://si.imgix.net/752e7504/uploads/origins/e615221f-840b-4e97-a0ac-4564feee864e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b83818c3bb393ceb81a33bc7de03daf0, https://si.imgix.net/752e7504/uploads/origins/e615221f-840b-4e97-a0ac-4564feee864e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b95d17998c0538d5f560ee5d3abb8e26 2x, https://si.imgix.net/752e7504/uploads/origins/e615221f-840b-4e97-a0ac-4564feee864e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70f9981882b2c0164f25bce4b2d3eb1f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/752e7504/uploads/origins/e615221f-840b-4e97-a0ac-4564feee864e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62f21aaa9910a650e78099f9bf206c71", "srcset": "https://si.imgix.net/752e7504/uploads/origins/e615221f-840b-4e97-a0ac-4564feee864e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62f21aaa9910a650e78099f9bf206c71, https://si.imgix.net/752e7504/uploads/origins/e615221f-840b-4e97-a0ac-4564feee864e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=01cc454fd28ec9e9324e9d88464ca03b 2x, https://si.imgix.net/752e7504/uploads/origins/e615221f-840b-4e97-a0ac-4564feee864e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=705e2fd2f72e8f3803fff53ff8110a0c 3x"}, "body": "大変お待たせ致しました。\n\nそれでは依頼内容となりますが、今回は1枚に4人。そのうち1人はオリジナルキャラクターで、残りの3人は既存のキャラクターを描いいただきたく思っています。\n\nオリジナルキャラクターの詳細は以下の通りです。\n\n金髪の少女。髪の長さは腰あたりまであり、胸はそこそこ。瞳の色は黄緑、歳は18歳ほど。\n服装は戦闘用に鎧ですが、ゴツゴツしたものではなくスカート付きの軽装。腰に剣を携えています。イメージとしては女騎士のようなものを。細かなデザインなどは自由に描いていただいても構いません。\n\n彼女は王女様です。自作小説内では、セレシアというキャラクターで登場します。\n\n他の3キャラクターは、最初に描いて頂いたノーラ ( 銀髪の少女 )。そして、テレサ ( 魔族の女性 ) とレナ ( 宿屋の女の子 ) です。\n\n構図としましては、セレシア と テレサ の2人が並んで口論している所をメインにし、その後ろで レナ がオロオロとした様子で、レナ の隣で ノーラ が呆れた様に2人を眺めているといった感じでお願いします。\n\n少し怒っている様子のセレシアに対し、テレサは余裕の笑みであしらうように。\nレナは2人を止めるよう、ノーラに助けを求めている感じがいいです。\n\n配置は右側にセレシアとテレサ、左側にレナとノーラです。隣同士のキャラは描きやすい様に入れ替えていただいても構いません。今回も表紙となりますので、以前と同じく両端のロゴがキャラの顔に被らないようにお願いします。\n\n用途と致しましてはいつもの通りです。\n\n長くなってしまい、申し訳ございません。今回もかなり無理を書いてしまいましたが、都合が良ければで構いませんので、何卒よろしくお願いします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tena_kc/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 859978, "client_id": 995788, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b124a29/uploads/origins/902d3693-2064-43c0-b900-dc7281b8e2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37db4312736169cf6b8fe665d1d8250e", "srcset": "https://si.imgix.net/2b124a29/uploads/origins/902d3693-2064-43c0-b900-dc7281b8e2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37db4312736169cf6b8fe665d1d8250e, https://si.imgix.net/2b124a29/uploads/origins/902d3693-2064-43c0-b900-dc7281b8e2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9bf2348f61a4003286ed50aa3db0397 2x, https://si.imgix.net/2b124a29/uploads/origins/902d3693-2064-43c0-b900-dc7281b8e2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bb1b3dbe75ec3dbd4ec1d621f0d31c1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b124a29/uploads/origins/902d3693-2064-43c0-b900-dc7281b8e2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c6a58cb7092f49792a28e12299adf77", "srcset": "https://si.imgix.net/2b124a29/uploads/origins/902d3693-2064-43c0-b900-dc7281b8e2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c6a58cb7092f49792a28e12299adf77, https://si.imgix.net/2b124a29/uploads/origins/902d3693-2064-43c0-b900-dc7281b8e2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4826a24b05adddf9e1e43011ffe558e9 2x, https://si.imgix.net/2b124a29/uploads/origins/902d3693-2064-43c0-b900-dc7281b8e2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e1aa03fdfb698cfb58857bbfb00a4e11 3x"}, "body": "お待たせしました。\n依頼内容ですが、どうしても長くなってしまう事をお許しください。\n\n今回は、1枚に2人のオリジナルキャラクターを描いていただきたく思っております。\n\n1人目の容姿は赤髪の女性。髪の長さは腰あたりまで長く、胸は大きめ。背中には悪魔のような翼があります。瞳の色も赤で、服装は黒を基準としたドレス。ドレスの色は黒以外にも自由に取り入れてもらって構いません。\n彼女は魔族なのですが、肌の色は人間と同じ肌色でお願いします。そのまま、魔族をイメージして描いていただければと思います。\n\n2人目の容姿は水色の髪をした少女。背は低く、だいたい8〜10歳を目安に。髪の長さは肩より少し長いくらい。瞳の色は髪と同じく水色、服装は村人などが着るようなものをイメージしていただければ。細かな部分はお任せします。ちなみに、彼女は宿屋の娘という設定です。\n\n構図としましては、赤髪の女性の与太話を興味津々に聞く少女。という感じです。なるべく、仲睦まじい様子でお願いします。タイトルロゴ用に、右側はキャラの顔と被らないようにしていただけると嬉しいです。\n\n用途といたしましては以前と同様です。\n\n長くなってしまい、本当に申し訳ございません。都合が悪いようでしたら、1人に絞って描いていただく方向でも構いませんので。何卒、よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tena_kc/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 859978, "client_id": 1062466, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c3281a68/uploads/origins/034d0ce0-d37b-476e-ab74-95f82adc5f18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=285e4c758dfe22ef5ac39460cf4d3636", "srcset": "https://si.imgix.net/c3281a68/uploads/origins/034d0ce0-d37b-476e-ab74-95f82adc5f18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=285e4c758dfe22ef5ac39460cf4d3636, https://si.imgix.net/c3281a68/uploads/origins/034d0ce0-d37b-476e-ab74-95f82adc5f18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abc0e3dc7676f957a967cae74dcb6506 2x, https://si.imgix.net/c3281a68/uploads/origins/034d0ce0-d37b-476e-ab74-95f82adc5f18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0f29e416a75dc92a92b8212594b4e37 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c3281a68/uploads/origins/034d0ce0-d37b-476e-ab74-95f82adc5f18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53d368fcea5102f6a2254f9a5fd1b9c1", "srcset": "https://si.imgix.net/c3281a68/uploads/origins/034d0ce0-d37b-476e-ab74-95f82adc5f18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cro