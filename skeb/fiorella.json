enre": "art", "tipped": true, "creator_id": 2606803, "client_id": 3462138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef35f48b/uploads/origins/b7230fb9-b422-411e-8b39-79d1b73690be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dba8a6597462e21e2831c172288c8b1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef35f48b/uploads/origins/b7230fb9-b422-411e-8b39-79d1b73690be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64c461ba18e2279c636de37893908eb0", "src_set": ""}, "body": "こんにちは！僕のOCのリノとディーゼルを描いてもらえないかな？二人とも私立探偵なんだ。デートもしてる。\n\nリノは身長180.34cm、男性、黒い肌、赤い目、顔に傷。彼はとても女性的です。\n\nディーゼルは身長187.96cm、オス、黒目1つと銀目1つ、耳と尻尾。\n\nディーゼルは真面目で、リノは彼をからかうのが好き。\n\nまた、ディーゼルはリノよりも体格がいい。\n\nディーゼル：https://www.dropbox.com/scl/fo/q1ugav5jsixi1awp9e460/AHttpz3tbYMJ7Fw2fDrZbcQ?rlkey=685uqovrk4j7m731z9exp8lhx&st=ovs4yq4x&dl=0\n\nリノ：https://www.dropbox.com/scl/fo/nse4gzjwaa5i8bfaesbrh/ACsKXi3vBb9iSyy7qZ_ZuFs?rlkey=ucohg1ud11h0t4rnxx9tiqm0n&st=n8i0ddvq&dl=0\n\nリノのネックレスは必要ありません。代わりにシンプルな十字架のネックレスを与えることができます。\n\nありがとうございます。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fiorella/works/122", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2606803, "client_id": 2368347, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72d9b78b/uploads/origins/2500c5a5-b7eb-45a9-b47f-e1a0553c0daf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=235ce3dc4d66b493bd4b988e4b74ff7a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72d9b78b/uploads/origins/2500c5a5-b7eb-45a9-b47f-e1a0553c0daf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd849d5b569d9eb592a5df90404dbc38", "src_set": ""}, "bo