057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=591579246b89bab577c2f376a49a053b, https://si.imgix.net/44849e8b/uploads/origins/8678ddcf-3385-4759-9ac8-c6c58a50d057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12bc07cd534837622e72cad9a339cc53 2x, https://si.imgix.net/44849e8b/uploads/origins/8678ddcf-3385-4759-9ac8-c6c58a50d057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e32a183e72e61030d8553e15a88942d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44849e8b/uploads/origins/8678ddcf-3385-4759-9ac8-c6c58a50d057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86166a91a995889df352ee68a5aac0ac", "srcset": "https://si.imgix.net/44849e8b/uploads/origins/8678ddcf-3385-4759-9ac8-c6c58a50d057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86166a91a995889df352ee68a5aac0ac, https://si.imgix.net/44849e8b/uploads/origins/8678ddcf-3385-4759-9ac8-c6c58a50d057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=128e3827be629f90ee89afbff1ee60c3 2x, https://si.imgix.net/44849e8b/uploads/origins/8678ddcf-3385-4759-9ac8-c6c58a50d057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0917c905ad6a224b5abdb94458221c02 3x"}, "body": "(https://www.pixiv.net/artworks/120320276)の陸上部女子を描いていただきたいです。\n\nシチュエーションは上記の絵の続編で、「再び先輩に頼まれて肛門の臭いを嗅がせる」という感じでお願いします。「一週間ずっと肛門を洗っていない」「さっきも排泄をしてきた」といった臭さを引き立てる追加要素もあると嬉しいです。\n\n体勢は\n(https://www.pixiv.net/artworks/116501305)のように視線をこちらに向けつつ尻を突き出すという感じですが、脚は内股ではなくガニ股で、さらに手で尻たぶを広げている形でお願いします。\n\nまた、可能であればセリフや擬音の有無で差分を用意していただけると助かります。\n\n\nぜひ、ご検討のほどよろしくお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@deshi2deshi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "