40c7-5585-400c-813e-cbbf737880f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e99d869a380198e2152b0864d7302f17, https://si.imgix.net/622add7d/uploads/origins/682040c7-5585-400c-813e-cbbf737880f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4139cadebff8460f0490788b5c24a6e 2x, https://si.imgix.net/622add7d/uploads/origins/682040c7-5585-400c-813e-cbbf737880f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=961b663560fdd4a66828164bd1af66a3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/622add7d/uploads/origins/682040c7-5585-400c-813e-cbbf737880f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f10806d5daf251c1de0670bd1c320f0b", "srcset": "https://si.imgix.net/622add7d/uploads/origins/682040c7-5585-400c-813e-cbbf737880f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f10806d5daf251c1de0670bd1c320f0b, https://si.imgix.net/622add7d/uploads/origins/682040c7-5585-400c-813e-cbbf737880f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=de564d890c030e82d3945b412c8afaee 2x, https://si.imgix.net/622add7d/uploads/origins/682040c7-5585-400c-813e-cbbf737880f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ca07ac01b1aa602508be2116b71a26a7 3x"}, "body": "初めまして、ﾂﾈ様。\n伏黒家のイラストから知り、ﾂﾈ様の描かれるスーツはとても素敵だなと思いながら、楽しく拝見しております。\n\n今回依頼したいのは、私の創作キャラクターの審神者になります。\n自作キャラクターの容姿は、Twitterに投稿しております画像のURLを添付させていただきます。\n\n・自作キャラ\n29歳\n185cm\n一重の青い三白眼\n常に眉間に皺が寄っており、笑みを浮かべた方が人相が悪くなる。\n刀がなければ素手でも戦う武闘派で、非常に血の気が多く、先陣を切っては派手に怪我をこさえて怒られる。が9割聞いていない。\n豪快な性格と人間離れした身体能力もあり、自分のことにかなり無頓着で、髪型はいつも近侍に任せている。\nその代わり物は大切に扱うため、物持ちが良い。\n\n服装については基本的に着物を着ていますが、ﾂﾈ様の描きやすい服装で構いません。\nただし、洋服の場合でも刀だけは帯刀ベルトなどで帯刀しておいてくださると嬉しいです。\n構図等、描きやすいように描いていただければ、と思うのですが、”審“の布面をつける場合は、片目だけでも良いのでひらりと靡いて見える感じにしていただければ幸いです。\n\nもし条件等合いませんでしたら、遠慮なくキャンセルして下さいませ。\n少し長くなってしまいましたが、ご検討のほどよろしくお願い致します。\n\nhttps://twitter.com/aoba0505/status/1675063708790456321?s=21&t=jbpTRgNH6PeZZCjXJSH4Mg", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@agopasta/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1791892, "client_id": 248548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c920d7c/uploads/origins/897a74f8-74d7-4dc9-ba95-316d9f45c623?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87d8c805a8b8f96f6fc38bbfcd2069c2", "srcset": "https://si.imgix.net/4c920d7c/uploads/origins/897a74f8-74d7-4dc9-ba95-316d9f45c623?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87d8c805a8b8f96f6fc38bbfcd2069c2, https://si.imgix.net/4c920d7c/uploads/origins/897a74f8-74d7-4dc9-ba95-316d9f45c623?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a7276988ab489d76bf16107b18c4cfb 2x, https://si.imgix.net/4c920d7c/uploads/origins/897a74f8-74d7-4dc9-ba95-316d9f45c623?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c7463cc5cc317b4254b1452758cd523 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c920d7c/uploads/origins/897a74f8-74d7-4dc9-ba95-316d9f45c623?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04aafb94c1d606afab9c89923096f384", "srcset": "https://si.imgix.net/4c920d7c/uploads/origins/897a74f8-74d7-4dc9-ba95-316d9f45c623?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04aafb94c1d606afab9c89923096f384, https://si.imgix.net/4c920d7c/uploads/origins/897a74f8-74d7-4dc9-ba95-316d9f45c623?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=440aa72e3ec5635f4cefd8cfdac0678f 2x, https://si.imgix.net/4c920d7c/uploads/origins/897a74f8-74d7-4dc9-ba95-316d9f45c623?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc87fb9909d4e55c29ec23a682aa7edf 3x"}, "body": "Nice to meet you, Mr. Chin Pasta.\nI like the muscles you draw and always enjoy looking at your JoJo illustrations.\n\nWhat I would like to request this time is a character of my own creation.\nI will attach the URL of the image I have posted on Twitter for the appearance of my character.\n\nThe character is good at floating in the air and aerial combat, so a composition that gives a sense of wind would be great.\nI would appreciate it if you could draw the character in a way that is easy for you to draw, such as clothing, composition, black and white or color of the illustration, etc.\n\nWe would be happy to use the illustration to advertise a paid commission.\nThank you in advance for your consideration.\n\nhttps://twitter.com/aoba0505/status/1468110936867471360?s=21&t=mSEXURC_SQG77sz6TELJFA", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nsgw_E/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2216383, "client_id": 248548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d1ef0ce/uploads/origins/2225e252-8e24-4333-a88c-1516a15a9912?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dacf8c0f7b7f29b19815b947e895841d", "srcset": "https://si.imgix.net/0d1ef0ce/uploads/origins/2225e252-8e24-4333-a88c-1516a15a9912?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dacf8c0f7b7f29b19815b947e895841d, https://si.imgix.net/0d1ef0ce/uploads/origins/2225e252-8e24-4333-a88c-1516a15a9912?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8730433d9d14f395dc9eaf36f7d89152 2x, https://si.imgix.net/0d1ef0ce/uploads/origins/2225e252-8e24-4333-a88c-1516a15a9912?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4fe0469630305edae839c065e1bc498 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d1ef0ce/uploads/origins/2225e252-8e24-4333-a88c-1516a15a9912?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da217084dc7de81b15b6784f18fb1e47", "srcset": "https://si.imgix.net/0d1ef0ce/uploads/origins/2225e252-8e24-4333-a88c-1516a15a9912?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da217084dc7de81b15b6784f18fb1e47, https://si.imgix.net/0d1ef0ce/uploads/origins/2225e252-8e24-4333-a88c-1516a15a9912?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=76dc92470eff7a1b532d963bb3b17d1f 2x, https://si.imgix.net/0d1ef0ce/uploads/origins/2225e252-8e24-4333-a88c-1516a15a9912?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1d2cd6347b1a0d3816afe0850e46d3c4 3x"}, "body": "逆瀬川様、初めまして。\n素敵なイラストをお見かけして、是非私の創作を描いていただけたらな、と思いご依頼させていただきました。\n\n・屑原敬壱\n36歳、179cm\n青みがかった癖毛の白髪\n目の色はハイライトのない孔雀青\n服装は青系統のスーツで、眼鏡と弁護士バッジは必ずお願いいたします。\n金の装飾品(ネクタイピンクやボタンなど)があると嬉しいです。\n\n・人物像\n金さえ積まれれば、どんな裁判でもどんな依頼人でも、手段を選ばずに勝ってみせる。\n腕は確かだが、正確に難ありなため、法廷界にも世間にも味方の少ない銭ゲバ弁護士。\n常に眉間に皺の寄った不機嫌そうな表情をしているが、相手が不利な言動をするとうっすらと冷ややかな笑みを浮かべる。\n恨みを買うこともあるため、多少の護身術はできる。\n営業時間外になると、事務所で煙草を吸いながら、集めた証言や証拠の整理を始める。\n\n自作キャラクターの容姿は、Twitterに投稿しております画像のURLを添付させていただきます。\n\n営業時間外の事務所で、資料の束を片手に作業をしている風景か、法廷で弁舌をしている構図だと嬉しいのですが、描きやすいように描いていただければ幸いです。\nご検討のほどよろしくお願いします。\n\nhttps://twitter.com/aoba0505/status/1503349917443833862?s=21&t=K9-8tP-fHuzw26E_qWt1Og", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ISUMI_136/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1229521, "client_id": 248548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f3ca035/uploads/origins/3e4ccb58-e6d0-4db6-8f11-445fd404bbd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=451921747de9b38a44ca3448e5a25660", "srcset": "https://si.imgix.net/1f3ca035/uploads/origins/3e4ccb58-e6d0-4db6-8f11-445fd404bbd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=451921747de9b38a44ca3448e5a25660, https://si.imgix.net/1f3ca035/uploads/origins/3e4ccb58-e6d0-4db6-8f11-445fd404bbd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73199012308b4c9473e5ddf79f8c4f17 2x, https://si.imgix.net/1f3ca035/uploads/origins/3e4ccb58-e6d0-4db6-8f11-445fd404bbd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6fe3e40d5b182cab093a84922563f271 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f3ca035/uploads/origins/3e4ccb58-e6d0-4db6-8f11-445fd404bbd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b8ffa0adfc30cbe57cc30a2c65bb9d4", "srcset": "https://si.imgix.net/1f3ca035/uploads/origins/3e4ccb58-e6d0-4db6-8f11-445fd404bbd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b8ffa0adfc30cbe57cc30a2c65bb9d4, https://si.imgix.net/1f3ca035/uploads/origins/3e4ccb58-e6d0-4db6-8f11-445fd404bbd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1d98b0b914ea8be24db79d28a7b1caf5 2x, https://si.imgix.net/1f3ca035/uploads/origins/3e4ccb58-e6d0-4db6-8f11-445fd404bbd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6dd18d7e75a998ffa26ad5c0c8cb02d2 3x"}, "body": "イサム様、はじめまして。青葉と申します。 \n五十嵐くんと中原くんのファンで、pixivやTwitterなど「こんなに良い作品を無料で見てしまってもいいの…？」という気持ちで拝見させていただいております。\n今回、私の創作キャラクターをリクエストさせていただきたいのです。\n以前から、自身の描いた創作キャラクターを、一度でいいから好きな絵師様に描いていただきたい、という思いがあり、イサム様がskebをやっていらっしゃるのを拝見し、依頼させていただきたいと思いました。\nキャラクターの容姿は、Twitterに投稿しております画像のURLを添付させていただきます。\n二人一緒に描いて頂ければ嬉しいのですが、厳しい場合はどちらか片方で構いません。その場合は、イサム様が描きやすいと感じる方を描いていただければ幸いです。\n背景の希望も通るのであれば、pixivに載っておりました、中原くんと背景が海で写真を撮った風に描かれたイラストのような、写真風のものがいいな、と思っておりますが、構図や背景、服装などはイサム様にお任せ致します。\nTwitterでのアイコン、もしくはスマホのホーム画面で個人的な観賞用としての使用を考えております。\nご検討の程、よろしくお願いいたします。\n\nhttps://twitter.com/aoba0505/status/1433383033529257988?s=21", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 583942, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "白畜生🤮強く生きる", "screen_name": "tamagoDX1414", "avatar_url": "https://pbs.twimg.com/profile_images/1485257104672067588/8J4BI7eY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1062268016258236422/1621819069/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 177}, {"id": 1820357, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "爆裂チキン定食🦆", "screen_name": "tori_bakuretu", "avatar_url": "https://pbs.twimg.com/profile_images/1911449244331859968/ibxI_FFi.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1071475678212571136/1666131184/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 16}, {"id": 2006439, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "2g✖︎✖︎✖︎🪽", "screen_name": "2g_trpg", "avatar_url": "https://pbs.twimg.com/profile_images/1711350518994653184/v9qSOOSb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1461741488598093829/1726374102/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip