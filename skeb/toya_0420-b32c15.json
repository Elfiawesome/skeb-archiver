13c/uploads/origins/68971f2e-39a1-4104-bcb4-462d0b1194f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f51a22b4a3c0b330ac54bb1f1f47482d, https://si.imgix.net/4473913c/uploads/origins/68971f2e-39a1-4104-bcb4-462d0b1194f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d8ad2395f7b59728f4078c4ff0f48f8 2x, https://si.imgix.net/4473913c/uploads/origins/68971f2e-39a1-4104-bcb4-462d0b1194f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2299adda365cbd8b34eeb3270a1a9b9a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4473913c/uploads/origins/68971f2e-39a1-4104-bcb4-462d0b1194f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=761716ca367b534e6c7cef746719117c", "srcset": "https://si.imgix.net/4473913c/uploads/origins/68971f2e-39a1-4104-bcb4-462d0b1194f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=761716ca367b534e6c7cef746719117c, https://si.imgix.net/4473913c/uploads/origins/68971f2e-39a1-4104-bcb4-462d0b1194f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e38a0a3ef7e37cb131c63daf99715311 2x, https://si.imgix.net/4473913c/uploads/origins/68971f2e-39a1-4104-bcb4-462d0b1194f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8d9fb4b4d53f790aeafee459087c5227 3x"}, "body": "初めまして、ヵ様。\n\n様々なホラゲの二次創作から知り、ヵ様の描かれる色味やキャラクターの表情が好きで楽しく拝見しております。\n\n今回依頼したいのは、ペルソナという作品の世界観を借りて創作したキャラクターの養護教諭です。\n自作キャラクターの容姿は、Twitterに投稿しております画像のURLを添付させていただきます。\n\n・自作キャラ\n25歳\n178cm\n疾風属性、回復役\nたれ目気味で少し瞼は重め。視力がとても悪く眼鏡がなければ何も視えず、その影響で眼鏡を取るとかなり目つきがきつくなる。\nおっとりした温和な性格で、戦闘向きではないものの、攻撃役からサポート役まで幅広く熟せる器用さを持ち合わせている反面、戦闘中以外は基本的にどんくさい。\n自分の背丈より少し大きい槍を使用して戦うが、本来は弓が得意。弓を使用すると、温和な性格から一変するため使用しようとしない。\nまた、痛みに鈍く無茶を通した捨て身の戦い方をすることもあり、傷が絶えない。\n\n構図に関しましては、槍を用いていて、風を感じるシーンだと嬉しいのですが、ヵ様の描きやすいように描いてくだされば幸いです。\n\n使用用途に致しましては、スマホのホーム画面に使用させていただこうと考えています。\n\nもし条件等合いませんでしたら、遠慮なくキャンセルして下さいませ。\nご検討のほどよろしくお願い致します。\n\nhttps://x.com/aoba0505/status/1749009096374894918?s=20", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@5mario/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1507484, "client_id": 248548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f603e049/uploads/origins/3dd3836b-368b-4a43-a1e3-36a9eb82b8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95c932f2da8249148627a493ab0a66f1", "srcset": "https://si.imgix.net/f603e049/uploads/origins/3dd3836b-368b-4a43-a1e3-36a9eb82b8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95c932f2da8249148627a493ab0a66f1, https://si.imgix.net/f603e049/uploads/origins/3dd3836b-368b-4a43-a1e3-36a9eb82b8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=280505cd0f88cdd6168432eb551fba6f 2x, https://si.imgix.net/f603e049/uploads/origins/3dd3836b-368b-4a43-a1e3-36a9eb82b8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c83dde829c48ccfcd4127318c21e53f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f603e049/uploads/origins/3dd3836b-368b-4a43-a1e3-36a9eb82b8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2321efb20bf2c85e60a96d43751fc4c2", "srcset": "https://si.imgix.net/f603e049/uploads/origins/3dd3836b-368b-4a43-a1e3-36a9eb82b8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2321efb20bf2c85e60a96d43751fc4c2, https://si.imgix.net/f603e049/uploads/origins/3dd3836b-368b-4a43-a1e3-36a9eb82b8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=777d81a040cbd771117ed61d89c34be7 2x, https://si.imgix.net/f603e049/uploads/origins/3dd3836b-368b-4a43-a1e3-36a9eb82b8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8197186cd763c81fe1fa2227e0735176 3x"}, "body": "初めまして、五月病マリオ様。\nマリオさんのアイコンでもあるチップさんのイラストが好きで、ぜひマリオさんにうちの子を描いていただけたらと思い、依頼させていただきました。\n\n描いていただきたいうちの子というのも、我が家で15年間家族として暮らしていた、私にとって姉の様な犬です。\n“ミミ”という名前の女の子で、名前の通り耳が大きいのが特徴です。\n\n犬種はミニチュアダックスフンド(最終8kgの大きな子)で、ロングのシルバーダップル。\n見た目にはブラックっぽいのですが、毛を短く刈るとシルバーが現れる、変わったカラーの子です。\n\n参考程度に彼女の性格です。\n辛抱強くて非常に面倒見が良く、我儘を言っても「やれやれ」といった表情をしながらも付き合ってくれる反面、かなり臆病で後ろに隠れる。\n食べるのが大好きで、その中でも特に野菜が好き。夜中にこっそり抜け出して摘み食いしていたり、非常に食いしん坊。\n\nTwitterに投下しております写真のURLを添付致しますので、そちらを参考にお願い致します。\nもう少し参考にできる写真があれば、と思うのですが、思い出の詰まったスマホが水没し、少ない資料となります。\n\n容姿は獣人系統だと嬉しいのですが、マリオさんに任せ致します。\n服装、構図も同様に描きやすい様にしていただければ幸いです。\n\n長くはなりましたが、ご検討の程よろしくお願い致します。\n\nhttps://twitter.com/aoba0505/status/1689240111081525248?s=21&t=NtVan2BdWkjA9wqaEF0TQg", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@me95881363/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2067097, "client_id": 248548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a94edae/uploads/origins/b6d60f95-981b-4b22-9892-ceefa2e7461d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03efe219869f4affe5d7a66368b43b5b", "srcset": "https://si.imgix.net/1a94edae/uploads/origins/b6d60f95-981b-4b22-9892-ceefa2e7461d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03efe219869f4affe5d7a66368b43b5b, https://si.imgix.net/1a94edae/uploads/origins/b6d60f95-981b-4b22-9892-ceefa2e7461d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9689f79f4d439fe57b4b307dc1db8c6 2x, https://si.imgix.net/1a94edae/uploads/origins/b6d60f95-981b-4b22-9892-ceefa2e7461d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1cea7a9418ae43e209a9d3c2aa41647 3x"}, "duration": null, "nsf