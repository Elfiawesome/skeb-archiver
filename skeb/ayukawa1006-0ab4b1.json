1f72fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af8f86e65e904d39f27ab102c1b1af9b, https://si.imgix.net/f79a99db/uploads/origins/c1168ee9-75c0-4c36-bba1-ba0c31f72fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14f460dd489b1b554cf8dc5be029d81c 2x, https://si.imgix.net/f79a99db/uploads/origins/c1168ee9-75c0-4c36-bba1-ba0c31f72fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c98fd21f2ecd5f1381a18a877f04251d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f79a99db/uploads/origins/c1168ee9-75c0-4c36-bba1-ba0c31f72fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fd5bda817906b5e4bc46d64c9921d3e", "srcset": "https://si.imgix.net/f79a99db/uploads/origins/c1168ee9-75c0-4c36-bba1-ba0c31f72fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fd5bda817906b5e4bc46d64c9921d3e, https://si.imgix.net/f79a99db/uploads/origins/c1168ee9-75c0-4c36-bba1-ba0c31f72fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=513a9fd8b9c7bcd913c06d77d0f7e56a 2x, https://si.imgix.net/f79a99db/uploads/origins/c1168ee9-75c0-4c36-bba1-ba0c31f72fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4c87b16aa7eea57223f858e0a71717d2 3x"}, "body": "システム:クトゥルフ神話TRPG6版\nプレイ人数:2〜4人\nタイトル:「あんぎゃ」\nコピー:行脚\n１ 仏道修行のために、僧侶が諸国を歩き回ること。\n２ ある目的で諸地方を巡り歩くこと。\nあらすじ:探索者達はオカルトサークルの活動の一環として、とある村を訪れることとなる。\nその村にはお盆の季節になると灯籠を流す燭光祭と呼ばれる祭りがあり、何でも流された灯籠は「あんぎゃ様」のために流されているらしい。\n探索者達が灯籠を流し、民宿へ泊まっていた夜のこと。短宅者達は自分達が船に乗って灯籠と共に川を下る夢をみる——。\n推奨技能:＜目星＞＜聞き耳＞＜図書館＞\n準推奨技能:＜オカルト＞\n\nシナリオ概要:\n遠い昔に別の村を追い出され、いくあてもなく放浪していた身重の女性が異国の神を呼び出す巫女として探索者達が訪れた村の神官に見初められ、村へと迎え入れられる。\nしかし命は名ばかりで、生贄として出産したばかりの胎児を捧げられてしまい、村はシュブ＝ニグラスの召喚を成功させ、その加護を得ることとなる。\nしかしそれを許さなかったのが村へ迎え入れられた女性であり、女性はシュブ＝ニグラスとの契約に一遍の呪いを混ぜ込んだ。\nその呪いとは、お盆の時期に帰ってくる先祖の霊を生贄としてシュブ＝ニグラスに捧げ続けるというものであり、それで手打ちにすると狂死した。\nその呪いが今も効力を発揮しており、灯籠を流した探索者はお盆終わりに魂をシュブ＝ニグラスへと捧げられてしまうというシナリオ。\nシナリオ途中に着物姿の古風な少女の登場を予定しており、この少女こそが村へ迎え入れられた女性であり、「あんぎゃ様」と呼ばれてる女性です。\n\nトレーラーイメージ:呪いと因習が関わるシナリオのため。全体的に彩度も明度も低いイメージです。\nイメージカラーは黒と赤、鳥居やしめ縄などの神社を彷彿とさせるもの、もしくは民宿での夢から始まるシナリオなので襖や障子、または川を流れる灯籠がイメージです。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 410351, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "竹輪屋本舗.＠日に41", "screen_name": "curonoria", "avatar_url": "https://pbs.twimg.com/profile_images/1954104343399206912/9HJJPqH2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/265414637/1609769314/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 128}, {"id": 1230473, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "海野", "screen_name": "uminomokuzu09", "avatar_url": "https://pbs.twimg.com/profile_images/1588094006449573888/pCygd86n.jpg", "header_url": "https://pbs.twimg.com/profile_banners/735414864395567104/1643640322/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 1634007, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "_s", "screen_name": "ISB52765277", "avatar_url": "https://pbs.twimg.com/profile_images/1638505213874282496/8MLaU5y-.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at"