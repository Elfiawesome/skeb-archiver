_amount": 6000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@tukimisou_d/works/30", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1066902, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3ab76dd/uploads/origins/c211d318-08b6-4c08-80f0-7301037e75d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22dcff2271dd03e791630b6672070708", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3ab76dd/uploads/origins/c211d318-08b6-4c08-80f0-7301037e75d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ff78ad7bf4e3ac1af37b4ef92eee514", "src_set": ""}, "body": "前回はありがとうございました。今回は資料の続きでレベル3、4をお願いします。\n\nhttps://skeb.jp/@tukimisou_d/works/29", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukimisou_d/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1066902, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a0ec3e6/uploads/origins/4b00d42e-8aaf-47d4-ad95-e67c17998818?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f3455fb772612820199f2efb5127a18", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a0ec3e6/uploads/origins/4b00d42e-8aaf-47d4-ad95-e67c17998818?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5eb4fe2006dc57fc5b3e91156cc909bb", "src_set": ""}, "body": "お久しぶりです。今回からFGOの絆レベルで胸が大きくなるシリーズをキャラクターはアルトリアオルタ(ランサー)で1から依頼させていただきます。今回はレベル1と2をお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukimisou_d/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1066902, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3720ec82/uploads/origins/0b4e9409-26ea-4a65-aadd-c0928b84268f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd934aa10164a3719e10fc8795695cf3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3720ec82/uploads/origins/0b4e9409-26ea-4a65-aadd-c0928b84268f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d05150bc9e81761cfce067f1a1c29fff", "src_set": ""}, "body": "お久しぶりです。またFGOのダヴィンチのイラストをお願いします。\n内容は前回からの続きで大きくなりすぎた胸を搾乳しその反動でさらに大きくなってしまうといった内容です。\n全体の流れ等はお任せしますが描いて欲しい点のみ下記に記載します。\n・胸のサイズは300cmを超す勢いで日常生活に支障が出まくりレベル。形は丸を基本に崩れないようにしてください。母乳も沢山で搾乳により350cm超えになる。\n・前回の子供は出産済み。ウエストはまた細く引き締まっている\n・マスター(旦那)のリクエストでヒップも150cm超えの丸い巨尻に。後ろからのアングルのイラストもお願いします。太もももぶっとくです。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukimisou_d/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1066902, "client_id": 64104, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12847ea6/uploads/origins/128d1ab5-bdb7-44a9-8290-c084fe729ff1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=530519a930db36d57ba7c7e7422fa909", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12847ea6/uploads/origins/128d1ab5-bdb7-44a9-8290-c084fe729ff1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08b6916c12198f601639527af2c8887d", "src_set": ""}, "body": "前回依頼させて頂いた「最近霊基の異常で服が消える現象が起きているカルデア」シチュイラストの成人向け差分をお願いします！\n\n出来ればキャラ違いでバーヴァンシーとモルガンの絵差分もお願いします。\n前回の4~5枚目は水着差分で、バーヴァンシーは第1再臨、モルガンは水妃霊基でお願いします！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukimisou_d/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1066902, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53849ca7/uploads/origins/59eae3a1-3906-46fa-b8da-dda782bde1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5d3d032b39f11c72d9d3b83bc4d718f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53849ca7/uploads/origins/59eae3a1-3906-46fa-b8da-dda782bde1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ee326b09b7f8f34d963158e744f75ab", "src_set": ""}, "body": "お久しぶりです。FGOのイラストをリクエストします。\n\n内容は源頼光、ブーディカ、マタ・ハリの3人で男性マスターにトリプルパイズリをするイラストをお願いします。\n\n3人の胸のサイズはパッションリップ以上、股間がギリギリ見えるくらいの超乳サイズ\n(絆レベル15以上)\n\n射精だけでなく同時噴乳もお願いします。\n\nどうかよろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukimisou_d/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1066902, "client_id": 2829318, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fad10376/uploads/origins/213aa0bc-1aa5-43ce-ab14-ca9bde046b30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=151ab51c214489600bd4d5844d00978d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fad10376/uploads/origins/213aa0bc-1aa5-43ce-ab14-ca9bde046b30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=644be27c471f40c5f6c1ee6ebcab8b49", "src_set": ""}, "body": "こんにちは！\n\nFGOのモルガンで膨乳母乳イラストを書いて欲しいのですが\n\n爆乳から溢れ出す母乳が大好きなマスターに自身の母乳を飲ませるために魔法でおっぱいを大きくするも、手違いで魔法が暴走して爆乳に留めようとしていたおっぱいが超乳まで大きくなっておっぱいの自重で倒れ込んで母乳を吹き出してしまう\n\nという内容でお願いしたいです！\nおっぱいは出来るだけ大きくしてくれると嬉しいです！よろしくお願いします！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukimisou_d/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1066902, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6add7635/uploads/origins/5c048022-fbe7-4787-ac10-932cfd3ab57b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ac3aa468bf22ecf5c05899495b49b52", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6add7635/uploads/origins/5c048022-fbe7-4787-ac10-932cfd3ab57b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e8ffe8b274721c80b530d728e475b3c", "src_set": ""}, "body": "初めましてだんなさん、依頼お頼みします。\nコスイベントでパッションリップ（第一再臨）のコスプレイヤーさんが胸を再現する為ホースの付いた風船を衣装脇に仕込み貧乳状態から巨乳→爆乳→超乳と空気を入れ擬似膨乳したけど元のキャラクターより凄く大きくなってしまった漫画をリクエストします\n 台詞効果音お任せで\nリップのコスプレイヤーさんは一通り着替えているものの、爪も付けていない普通の手で胸もぺたんこの格好でお願いします。\n膨乳は前に描かれていていたダ・ヴィンチちゃんの様に衣装は破れずまん丸乳で服もパツパツにして欲しいです。\nhttps://skeb.jp/@tukimisou_d/works/11", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukimisou_d/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1066902, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea727915/uploads/origins/2971ab1f-c216-49bf-83a5-3107626b91ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc502ec29d10fa45cb2ebda410f84e76", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea727915/uploads/origins/2971ab1f-c216-49bf-83a5-3107626b91ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60883e6f6b914c13d17c520bd1786602", "src_set": ""}, "body": "また依頼お願いします。\n今回もダヴィンチちゃんです。\n内容は後日談でマスターと生活中という設定で夜の寝室で妊娠していた告白をするといった内容です。\n流れは\n①嬉しい発表があるとウキウキのダヴィンチちゃん\n②妊娠検査薬にて陽性判定を見せる\n③絆レベルが100になり更に胸が大きくなる\nです。\n①と②は小さなコマで大丈夫です。\n③は前回のラストより2回り大きくさせてください。胸の形はバランスボールのような垂れないものでお願いします。大きい胸をお願いします。母乳も前回より増量です。\n今回も膝までで服装は第一再臨です。③でまた上着を破ってください。\n差分として臨月の妊婦のものをお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukimisou_d/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1066902, "client_id": 64104, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6cf04b0f/uploads/origins/11fc40cf-de76-4816-9a6a-c3a1f80e64df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ef3e0b97de27abbc10ac9d88e477b48", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6cf04b0f/uploads/origins/11fc40cf-de76-4816-9a6a-c3a1f80e64df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19c4d50846d9748112aa79ac3a470315", "src_set": ""}, "body": "第二再臨の邪ンヌ&第二再臨ジャンヌの胸部分だけ消えるイラストをお願いしたいです\n「最近霊基の異常で服が消える現象が起きているカルデア」シチュだと良いです。\n\n①通常会話、邪ンヌ達がフラグ発言をしながらカルデアを歩いている\n②魔力が霧散し、2人の胸部分だけが消えていく様子を\n③ジャンヌは照れながらも見せてくれ、邪ンヌはキレながらも嬉しそうな表情をしてる\n④数日後、異常が直らずマスターに見られ続け何かに目覚めそうなハート目ジャンヌと、みられる事に慣れつつも顔が赤い邪ンヌのシーンを\n母乳差分と水着差分も有ると嬉しいです！\n初リクでこれで良いのか分かりませんが、検討の程よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukimisou_d/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1066902, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a9b70db/uploads/origins/f09f931f-5390-4b31-9812-3d79c35bfe9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc8cd89a1514ba316901607382c41e7f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a9b70db/uploads/origins/f09f931f-5390-4b31-9812-3d79c35bfe9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e50568d340e449e9ca133012cd69453b", "src_set": ""}, "body": "だんなさん、はじめまして。\nいつもあなたの描くHなイラストを楽しませていただいております。\nだんなさんが胸の表現が得意である事を見込んで今回リクエストさせていただきます。\n内容は『Fateシリーズを題材にしてジャンヌがジークに対してパイズリするイラスト』になります。\n個人的にはジャンヌがジーク君にパイズリしているところとジーク君が射精している差分の両方が欲しいです。\n\nちなみにこの作品はXやpixiv等のSNSで公開して頂いてもかまいません。\n色々と注文をつけてしまいましたがよろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukimisou_d/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1066902, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4abf4109/uploads/origins/cbebd65a-d5d8-4d90-8905-a657b039c184?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a20315d1c5f43ca9689a6d3c63ae524", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4abf4109/uploads/origins/cbebd65a-d5d8-4d90-8905-a657b039c184?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5692577fe570e2ff468c60fa60f2b862", "src_set": ""}, "body": "また依頼お願いします。\n今回もFGOでダヴィンチのイラストをお願いします。\n内容はマスターに度々深夜に部屋で令呪にて膨乳されるといった内容です。\n流れは\n①マスターにマイルームに呼び出される(第一再臨。絆レベル15以上)\n②令呪が発動する(マスターは描写無し。手のみ)\n③ダヴィンチの胸が段階的に大きくなる。最後は本人も絶頂する\n④最後のセリフに「ダーリン❤️」\nです。全体的に膝まで描いてください。\n③の段階は細かいほど嬉しいです。最後の胸は臍が見えなくなるぐらい大きくしてください。とにかく大きくです。母乳も沢山吹き出してください。\n大きな胸を期待してます。よろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukimisou_d/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1066902, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/593e6dc5/uploads/origins/af97fc40-04fa-4814-b5bf-3c4e60f0036d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce1ca1271a0333bc7b88474608a3d06c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/593e6dc5/uploads/origins/af97fc40-04fa-4814-b5bf-3c4e60f0036d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97f9c169fcb91522f4e7445adc2f0ded", "src_set": ""}, "body": "お久しぶりです。\n今回もFGOのダヴィンチちゃんのイラストをお願い致します。\n内容は前回より、マスターの誕生日にプレゼントを贈り、そのプレゼントの効果でさらに胸が大きくなってしまうと言った内容です。\nプレゼントはリモコン式で膨乳を操作する物です。形はお任せします。\n流れは\n①プレゼントを渡し効果を説明(前回の最後のコマと同じ胸の大きさ)\n②説明を最後まで聞かずにマスターが使ってしまい膨乳スタート\n③最大値で一度止まるが絆レベル(20超え)の相乗効果で更に膨乳\n④膨乳完了&レベルカンストによる解除不可の魅了付与(溺愛)\nでお願いします。\nよろしくお願い致します。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukimisou_d/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1066902, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e1465be/uploads/origins/bd3c34d2-d984-4d10-9da7-fec554d613b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc7e338176afd1b40f37b2555503e28c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e1465be/uploads/origins/bd3c34d2-d984-4d10-9da7-fec554d613b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50949add46eaa75f212549b455ed876a", "src_set": ""}, "body": "ある女子高生が登校前にボーイフレンドとキスをしていて、自分の胸が少し大きくなっていることに気づく。これは彼女にアイデアを与える。登校中、彼女はまた彼氏にキスをし、そのたびに胸が大きくなっていく。彼氏に聞かれても知らないふりをしながらも、密かに楽しんでいる。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukimisou_d/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_i