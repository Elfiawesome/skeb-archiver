e_genre": true}, {"path": "/@extarbo/works/73", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1255415, "client_id": 3188870, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c79e9f62/uploads/origins/06fb9d97-8f6f-474e-a56e-8d980ef4461b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=362bdb3a74cb095cdbe17c266bc4227c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c79e9f62/uploads/origins/06fb9d97-8f6f-474e-a56e-8d980ef4461b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=baa61f76a5674c1fc16bd12226727d02", "src_set": ""}, "body": "https://drive.google.com/drive/folders/17sFclQZufRsKqH2ZobBi1FS3VG57bFVg\n\nこんにちは！私の名前はブライアン・リベラ-リベラ、ライトノベルシリーズを書いています。武器は楽器であり、世界は音楽を奏で、オーロラが空を埋め尽くし、満開の花や花びらが雨のように空から降ってくる。\n\n主人公のスタンジール・クインテットを描いてほしい。彼女は純粋なブルーサファイアでできた伝説のヴァイオリンを操るヴァイオリニストだ。彼女はチェックのハーフコートを着て、チェックの手袋をはめている。\n\n剣の代わりにサファイアブルーのバイオリンを持っていることを除けば、君に送ったリンクにあるゼノブレイド2の箱に描かれているレックスのようなポーズをしてほしい。バイオリンは顔の片側を覆って、光るようにしたい。\n\n背景は海のあるビーチで、ヤシの木と音符のココナッツ、空には緑のオーロラが雨のように花や花びらを落としている。\n\n彼女の顔は、獰猛で決意に満ちていて、でもちょっと優しそうであってほしい。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@extarbo/works/72", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6c530662/uploads/origins/032715b8-502b-48c1-a3eb-d409e7ae798a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e04e482e4d17442fcded284763486112", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1255415, "client_id": 3496800, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_ac