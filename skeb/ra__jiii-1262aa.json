ゃ明るくて元気いっぱい、運動が得意で食いしん坊な女の子ですが、口元には目立つ二本の長い八重歯があって、実は人を食べることもあるちょっと危ない子です。 \n\nもし可能であれば、新しい衣装をデザインしていただけると嬉しいです（どんな雰囲気でも大歓迎です！）\nもちろん、現在の衣装で描いていただいても問題ありません！\n\nキャラクターデザインはこちらをご参考ください：\n\nhttps://drive.google.com/file/d/1vq6Ndf6hIGJKEg-R6sy6Y1XR2hrfuRlb/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1ytGne8hlj4hSCBBjs9KsLO3RURMSoDCT/view?usp=drivesdk\n\n構図や表情などは、ぜひ自由にアレンジしていただけると嬉しいです！\n\nもしご提示した金額がご希望に合わない場合は、金額を変更して再リクエストしていただいて構いません。\n\nお忙しいところ恐れ入りますが、ご検討いただけましたら幸いです。\nどうぞよろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ra__jiii/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3376075, "client_id": 3513008, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89406fbd/uploads/origins/51ffaadf-e0f7-42a2-aa64-7f2352d5e29e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3ad2b7987186ab4737ff4996a6dbfb9", "srcset": "https://si.imgix.net/89406fbd/uploads/origins/51ffaadf-e0f7-42a2-aa64-7f2352d5e29e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3ad2b7987186ab4737ff4996a6dbfb9, https://si.imgix.net/89406fbd/uploads/origins/51ffaadf-e0f7-42a2-aa64-7f2352d5e29e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbce7ebf0007da70bda464440e78aa32 2x, https://si.imgix.net/89406fbd/uploads/origins/51ffaadf-e0f7-42a2-aa64-7f2352d5e29e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=723492e86cea13f4c0032628a9bdc459 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89406fbd/uploads/origins/51ffaadf-e0f7-42a2-aa64-7f2352d5e29e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3a95cf714c4461731d9a980275d9135", "srcset": "https://si.imgix.net/89406fbd/uploads/origins/51ffaadf-e0f7-42a2-aa64-7f2352d5e29e?bg=%23fff&a