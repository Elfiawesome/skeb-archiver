\n180 厘米。金发男性。非常瘦小。\n健谈、调皮、性格狡猾，但也很容易尴尬。通常的表情是大大咧咧的。\n他是加布忠诚的下属。他非常爱加布。\n\n加布\n北极熊\n186 厘米。灰色毛发，雄性。\n通常的表情是微笑。性格冷漠、随意，但暗地里也非常危险。\n他是阿洛伊斯冷酷迷人的上司。\n他对待阿洛伊斯就像对待不听话的下属一样，但他也很关心阿洛伊斯。\n\n请画一幅他们早上一起准备上班的可爱插图。想法包括他们一起刷牙，阿洛伊斯给加布做早餐等。\n\n预期用途：SNS、OC 活动、打印，仅供个人观看\n\n谢谢\n\nhttps://drive.google.com/drive/folders/1Zovag9J6SWh0jPvzh-SwAMHRSSJlVgUV?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Okari_001/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3536449, "client_id": 829888, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f4d10a6/uploads/origins/16d10443-97d4-4947-8d0a-919d2a49786b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8daa6c8966ebca1166ceec0a59886b35", "srcset": "https://si.imgix.net/1f4d10a6/uploads/origins/16d10443-97d4-4947-8d0a-919d2a49786b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8daa6c8966ebca1166ceec0a59886b35, https://si.imgix.net/1f4d10a6/uploads/origins/16d10443-97d4-4947-8d0a-919d2a49786b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bedd2e23e257e34cc5b462248e0ed54 2x, https://si.imgix.net/1f4d10a6/uploads/origins/16d10443-97d4-4947-8d0a-919d2a49786b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b27ca82750a94c8ff07f95b63ae7d996 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f4d10a6/uploads/origins/16d10443-97d4-4947-8d0a-919d2a49786b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=940f53cd36d402d860d0078e3b78223d", "srcset": "https://si.imgix.net/1f4d10a6/uploads/origins/16d10443-97d4-4947-8d0a-919d2a49786b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=940f53cd36d402d860d0078e3b78223d, https://si.imgix.net/1f4d10a6/uploads/origins/16d