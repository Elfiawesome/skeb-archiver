、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miltiyo3/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2879382, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47f33bb9/uploads/origins/fc56c2dd-1755-40b0-90bc-54538260ba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dd49f59732f5cac48caf9f4ce3b1b5b", "srcset": "https://si.imgix.net/47f33bb9/uploads/origins/fc56c2dd-1755-40b0-90bc-54538260ba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dd49f59732f5cac48caf9f4ce3b1b5b, https://si.imgix.net/47f33bb9/uploads/origins/fc56c2dd-1755-40b0-90bc-54538260ba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d16e262d972174ca671df8e00b889ce 2x, https://si.imgix.net/47f33bb9/uploads/origins/fc56c2dd-1755-40b0-90bc-54538260ba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=007543f72c63aeb9734292d3b5479e18 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47f33bb9/uploads/origins/fc56c2dd-1755-40b0-90bc-54538260ba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16a985da3d93326f7a8b2c45449a7576", "srcset": "https://si.imgix.net/47f33bb9/uploads/origins/fc56c2dd-1755-40b0-90bc-54538260ba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16a985da3d93326f7a8b2c45449a7576, https://si.imgix.net/47f33bb9/uploads/origins/fc56c2dd-1755-40b0-90bc-54538260ba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ccafc09c79591dcb1f18788602bab9f7 2x, https://si.imgix.net/47f33bb9/uploads/origins/fc56c2dd-1755-40b0-90bc-54538260ba3c?bg=%23fff&auto