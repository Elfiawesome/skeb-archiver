lsite.com/books/work/=/product_id/BJ001489.html\nボンデージコスチュームに白のサイハイブーツがセクシーな怪盗ヒロインです。\nコスチュームの一部はシースルーになっています。\nこのキャラクターのセクシーな立ち姿をブーツの足元まで画面に入るように描いてください。\nイメージとしては目的の施設に侵入する前、ビルの屋上あたりで余裕の笑みを浮かべている感じ。\nできればブーツのヒールまで見えるような構図にしてください。\n目元の仮面の有り無しで差分をいただけると助かります。\n背景は簡素なものか、なくても構いません。\nご検討のほどよろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TORONBOOM/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3119017, "client_id": 104044, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4e7ed81/uploads/origins/6c8d297e-2a90-4fc5-9754-e29657e7950a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9a56c0c38d5c9f0773d2c68bf8b928a", "srcset": "https://si.imgix.net/c4e7ed81/uploads/origins/6c8d297e-2a90-4fc5-9754-e29657e7950a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9a56c0c38d5c9f0773d2c68bf8b928a, https://si.imgix.net/c4e7ed81/uploads/origins/6c8d297e-2a90-4fc5-9754-e29657e7950a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8ac69fe8cf51b47f8c8f3b64df0c48e 2x, https://si.imgix.net/c4e7ed81/uploads/origins/6c8d297e-2a90-4fc5-9754-e29657e7950a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a17fa0e4c8c03422b5e4670158a2210 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4e7ed81/uploads/origins/6c8d297e-2a90-4fc5-9754-e29657e7950a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d1a1a170928d4e017883d17ac1f033d", "srcset": "https://si.imgix.net/c4e7ed81/uploads/origins/6c8d297e-2a90-4fc5-9754-e29657e7950a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d1a1a170928d4e017883d17ac1f033d, https://si.imgix.net/c4e7ed81/uploads/origins/6c8d297e-2a90-4fc5-9754-e29657e7950a?bg=%23fff&auto=