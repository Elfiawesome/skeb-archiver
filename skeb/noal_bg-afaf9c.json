ix.net/1077cfe4/uploads/origins/7bd2eaf3-594b-40a2-81dc-2b96979abbdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a68ba4300b2c3413e913b2276a830fe", "srcset": "https://si.imgix.net/1077cfe4/uploads/origins/7bd2eaf3-594b-40a2-81dc-2b96979abbdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a68ba4300b2c3413e913b2276a830fe, https://si.imgix.net/1077cfe4/uploads/origins/7bd2eaf3-594b-40a2-81dc-2b96979abbdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2209e87a150566c9a387247fa97dc5cc 2x, https://si.imgix.net/1077cfe4/uploads/origins/7bd2eaf3-594b-40a2-81dc-2b96979abbdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=934ba5ce889698f1f2fcb55e7c149656 3x"}, "body": "こんにちは。\nVTuberの \"SquChan \"を描いていただけませんか？\n「SquChan \"は、\"Pokatto \"と呼ばれる彼女の宇宙猫の友人の一人をピックアップするために彼女の乾燥機の中に手を伸ばしています。\n彼女のパンティーを盗もうと乾燥機の中に入ってきた宇宙猫の友達。\nポーズとカジュアルな服装はこれに似ている https://x.com/hews__/status/1911237025879216201\nサーモン色のトップス。パンツは参考資料と同じダークオリーブグリーン。\nパンティは乾燥機の中に見える。  \n「SquChan \"は宇宙猫の友達を心配しているが、少し怒っている。\nこれらの特徴に注目してください：\n- 顔のマーク\n- 髪の紫の筋\n- ふわふわの尻尾\n- 中くらいの胸\n- 太ももとお尻\n\nhttps://drive.google.com/drive/folders/1A23RYRAs0aXOdB2rIRnwueVB8bbXlopO?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noal_bg/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1238560, "client_id": 2449298, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6729556d/uploads/origins/d3013dcd-7c30-4a67-85ea-4029c8a74d78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb2b369490f3fd2312542aa9bfe42ba1", "srcset": "https://si.imgix.net/6729556d/uploads/origins/d3013dcd-7c30-4a67-85ea-4029c8a74d78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb2b369490f3fd2312542aa9bfe42ba1, https://si.imgix.net/6729556d/uploads/origins/d3013dcd-7c30-4a67-85ea-4029c8a74d78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55989793f9547215a54ce638959cebe4 2x, https://si.imgix.net/6729556d/uploads/origins/d3013dcd-7c30-4a67-85ea-4029c8a74d78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=965cc61e8270592ddffa3b11e460c953 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6729556d/uploads/origins/d3013dcd-7c30-4a67-85ea-4029c8a74d78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ca3f0a803ee11b74a402eacf425e350", "srcset": "https://si.imgix.net/6729556d/uploads/origins/d3013dcd-7c30-4a67-85ea-4029c8a74d78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ca3f0a803ee11b74a402eacf425e350, https://si.imgix.net/6729556d/uploads/origins/d3013dcd-7c30-4a67-85ea-4029c8a74d78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=963e00fdcea253d7d5af43ad3b1bb2de 2x, https://si.imgix.net/6729556d/uploads/origins/d3013dcd-7c30-4a67-85ea-4029c8a74d78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=edf0c60f7113f9327cddae3115a64834 3x"}, "body": "noalさん、はじめまして。\n大変失礼いたしました。\nダークファンタジーのイラストのキャラクターがみんなかわいくてステキですね。\n\nもしよろしければ、私のキャラクターの一人の萌香ちゃんを描いていただけないでしょうか。\n彼女は悪の組織に蜘蛛怪人として改造されてしまい、通っていた中学校(中高一貫校の女子校の中等部)で蜘蛛の女王として支配していくことになります。\n\n姿形は人間に近く2本足で立ち、背中から脚が4本生えています。\n\n構図等はお任せいたしますが、前述の通りアラクネのように下半身が蜘蛛というわけではないので、萌香ちゃんの周りに蜘蛛の巣をたくさん張って、蜘蛛の女王として君臨している様子にしていただけるとありがたいです。\n\nお忙しいところ恐縮ですが、どうか、ご検討をよろしくお願いいたします。\n\n資料はにAIの小説を含みます。\n\nhttps://x.com/chano254/status/1878388055436153342?t=vvfIQjhiaJ--DXfm_MJLvA&s=19", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noal_bg/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creato