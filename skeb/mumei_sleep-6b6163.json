ト、ショートパンツ、シャツ丈を長くして見えないようにする等なんでも自由にして下さい。\n\n期間等厳しい場合は遠慮せずに締め切りブッチして再送して下さい\n\nリクエストの設定をセンシティブにしておきますが、これは前述の下履きの選択によっては微妙なラインなため設定するもので、センシティブにしてくれというソレではないのでよろしくお願い致します", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mumei_sleep/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2688452, "client_id": 3426602, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7fae940b/uploads/origins/5269e98a-2916-4eb1-af80-161a55748e4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13e7580a60723bafcec4be0b5baa41f1", "srcset": "https://si.imgix.net/7fae940b/uploads/origins/5269e98a-2916-4eb1-af80-161a55748e4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13e7580a60723bafcec4be0b5baa41f1, https://si.imgix.net/7fae940b/uploads/origins/5269e98a-2916-4eb1-af80-161a55748e4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc72c9279b8bc51092ac8dd5a4b4b4cd 2x, https://si.imgix.net/7fae940b/uploads/origins/5269e98a-2916-4eb1-af80-161a55748e4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=936a974759e179a134db5c1eea365f91 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7fae940b/uploads/origins/5269e98a-2916-4eb1-af80-161a55748e4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5775f033205cd3554421b11b75b69311", "srcset": "https://si.imgix.net/7fae940b/uploads/origins/5269e98a-2916-4eb1-af80-161a55748e4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5775f033205cd3554421b11b75b69311, https://si.imgix.net/7fae940b/uploads/origins/5269e98a-2916-4eb1-af80-161a55748e4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=762499b4d8549ab630ea975b68982c1e 2x, https://si.img