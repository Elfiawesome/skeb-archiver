feb9dc0 3x"}, "body": "オースリーさん\n\nあなたのチビはスタイリッシュで魅力的だと思います。あなたのスタイルで2人のOCをチビにしてほしい。ヴァレリウスとアスカです。\n\nヴァレリウスは170cmで赤毛。とてもストイックで、あまり感情を顔に出さない。彼にまつわるイメージは、火、剣、蛾。顎の傷にご注目。\n\n飛鳥は176センチ、黒髪。非常に疲れた顔をしており、健康管理にはあまり気を遣っていない。彼にまつわるイメージは、カラス、本、夜。\n\n服装は参考と違うものでも構いません。ファンタジーなデザインで描くもよし、モダンなデザインにするもよし。\n\nありがとうございました！\n\nhttps://sta.sh/216g5aiqi9aj", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2124, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "鉄島", "screen_name": "ironjima", "avatar_url": "https://pbs.twimg.com/profile_images/1828405457905659904/lXJF0zkT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1002772832512720896/1738070264/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 70, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 128}, {"id": 70420, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "かぼちゃ太郎🎃", "screen_name": "hayashimochiko", "avatar_url": "https://pbs.twimg.com/profile_images/1664663300582555648/3aLt--v2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1031186451021492224/1766013415/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 129}, {"id": 1157027, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🐊㌠3𝐗", "screen_name": "RRARIKANTO", "avatar_url": "https://pbs.twimg.com/profile_images/1687158662933213184/xymlrqrR.png", "header_url": "https://pbs.twimg.com/profile_banners/3186555176/1687019086/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request