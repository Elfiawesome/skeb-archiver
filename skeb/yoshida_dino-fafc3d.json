trixのようなものです。(https://ja.wikipedia.org/wiki/%E3%83%A9%E3%83%86%E3%83%8B%E3%83%B4%E3%82%A7%E3%83%8A%E3%83%88%E3%83%AA%E3%82%AF%E3%82%B9).構図は縦長で、トロオドン類がフレームの上部にいて、獲物に迫っているようなものがいいです。獲物はトカゲ、小型哺乳類、小型恐竜など。\n\nできれば、鳥のような羽毛や姿勢、色彩を強調したい。オオミチバシリ（Geococcyx californianus）のようなイメージで。トーンはナチュラルに。\n\n参考までにロードランナーの映像をいくつか紹介します。https://www.youtube.com/watch?v=APuUhHRuvng https://www.youtube.com/watch?v=1eRpKkHXYW0\n\nありがとうございます！ご配慮に感謝いたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoshida_dino/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2199231, "client_id": 1887164, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a6683b2/uploads/origins/4ef58397-49a4-46b2-9d68-9cb8410a715a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a61b8768b1d7656131140a38863c0e35", "srcset": "https://si.imgix.net/0a6683b2/uploads/origins/4ef58397-49a4-46b2-9d68-9cb8410a715a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a61b8768b1d7656131140a38863c0e35, https://si.imgix.net/0a6683b2/uploads/origins/4ef58397-49a4-46b2-9d68-9cb8410a715a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=661dcb1baaf72ee6e4f77ac440682c8b 2x, https://si.imgix.net/0a6683b2/uploads/origins/4ef58397-49a4-46b2-9d68-9cb8410a715a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20875821a2ba827bd90a8ebfd55a6272 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a6683b2/uploads/origins/4ef58397-49a4-46b2-9d68-9cb8410a715a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=111b494bb1e11a2fb54d8eb1bc1d7c10", "srcset": "https://si.imgix.net/0a6683b2/uploads/origins/4ef58397-49a4-46b2-9d68-9cb8410a715a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s