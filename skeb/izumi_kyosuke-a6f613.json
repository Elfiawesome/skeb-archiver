f-4825-ba06-0123d46d820e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9b1a735fe27bb9c62b443a615b2b0dd, https://si.imgix.net/665df022/uploads/origins/d0d29eff-a92f-4825-ba06-0123d46d820e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=829e190143f1b88126039c2ad2adfb32 2x, https://si.imgix.net/665df022/uploads/origins/d0d29eff-a92f-4825-ba06-0123d46d820e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc386bb56eda8e0fb66f97eb2964372d 3x"}, "body": "I need you to draw me a twitter icon.\n\nI would like you to draw one sleeping phoenix (it doesn't have to be strictly a phoenix, a huge bird...)\n(Reference for the system: https://jp.mercari.com/item/m81070230514)\nI would like you to make both wings so big that the legs are not visible, in the same system as in the image.\n\n(Color reference: https://ja.pikbest.com/png-images/qiantu-ancient-chinese-style-burnt-blue-phoenix-hairpin_2721948.html)\nI want the tips of the wings to be darker blue than the tips of the feathers, as in the image.\nThe background should be black or indigo if possible.\nNo nose lanterns, please.\n\nThank you very much.", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@izumi_kyosuke/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2247134, "client_id": 424716, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8130ffed/uploads/origins/7dc7327d-0389-4e48-b6a7-478dab7faff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbcab2810a3be839084b71b0a42ef3bf", "srcset": "https://si.imgix.net/8130ffed/uploads/origins/7dc7327d-0389-4e48-b6a7-478dab7faff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbcab2810a3be839084b71b0a42ef3bf, https://si.imgix.net/8130ffed/uploads/origins/7dc7327d-0389-4e48-b6a7-478dab7faff6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=184617295b6c581030e43e02dc1df127 2x, https://si.imgix.net/8130ffed/uploads/origins/7dc7327d-0389-4e48-b6a7-478dab7faff6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab60a149444bde8bdc8dbda813dad3d4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8130ffed/uploads/origins/7dc7327d-0389-4e48-b6a7-478dab7faff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3277cfcb26e32cf184c3fcdd4a7035e", "srcset": "https://si.imgix.net/8130ffed/uploads/origins/7dc7327d-0389-4e48-b6a7-478dab7faff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3277cfcb26e32cf184c3fcdd4a7035e, https://si.imgix.net/8130ffed/uploads/origins/7dc7327d-0389-4e48-b6a7-478dab7faff6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ad7ffd45971663fb3a097fe5bdc7540 2x, https://si.imgix.net/8130ffed/uploads/origins/7dc7327d-0389-4e48-b6a7-478dab7faff6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ee383560b6293afc8bbfd504e79d37a9 3x"}, "body": "My name is 26 and this is my first request. I am 26 and this is my first commission. I thought the illustration of a kimono you just delivered was wonderful and decided to commission one myself.\nI would like to request a standing picture for a TRPG, including character design.\nPlease deliver a full-body drawing with a transparent background.\nHere are the details\n\nMotif, gender\nWe would like a girl based on the first illustration in the tweet.\n\nHeight\nshort\n\nClothing\nBlack gothic lolita. We would like the slit part of the skirt to be a rainbow color like the one in the second and third illustrations in the material tweets.\n\nHair\nHair style is up to you.\nWe would like her to have black hair with a purple inner color.\n\nEyes\nWe would like the eyes to be yellow-green with triangular pupils. (Image of the two hands in the motif illustration)\n\n・Accessories\nBandages on both wrists.\nOther parts are left up to you.\n\nShoes\nPlease use something like the fourth document tweet.\n\nThat's all.\nI am sorry that this is a rough request and that you are busy, but thank you in advance for your cooperation.\n\nhttps://x.com/26_XXVI/status/1804791982260416955?t=Upy-lsR7LT68830Ooe_Mcg&s=19", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@izumi_kyosuke/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2247134, "client_id": 2690128, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60d4a735/uploads/origins/47b91917-9f82-44bf-b974-b9177400d32e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a48de3d364b6b194b25632749334d91d", "srcset": "https://si.imgix.net/60d4a735/uploads/origins/47b91917-9f82-44bf-b974-b9177400d32e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a48de3d364b6b194b25632749334d91d, https://si.imgix.net/60d4a735/uploads/origins/47b91917-9f82-44bf-b974-b9177400d32e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a56ec0d5ad7e93a2d264cee547c3a775 2x, https://si.imgix.net/60d4a735/uploads/origins/47b91917-9f82-44bf-b974-b9177400d32e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7edc9da875dbc740483fb7d7984198d4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/60d4a735/uploads/origins/47b91917-9f82-44bf-b974-b9177400d32e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab2ad012168a7b8f08d3895a0e1f3656", "srcset": "https://si.imgix.net/60d4a735/uploads/origins/47b91917-9f82-44bf-b974-b9177400d32e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab2ad012168a7b8f08d3895a0e1f3656, https://si.imgix.net/60d4a735/uploads/origins/47b91917-9f82-44bf-b974-b9177400d32e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f3542ba787d885bc623241b5853a6ccf 2x, https://si.imgix.net/60d4a735/uploads/origins/47b91917-9f82-44bf-b974-b9177400d32e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=441a00c05ca2b3b33e564f493803990e 3x"}, "body": "reprint\n\nHair color Brown\n\nCurly, center parted, half up, long hair. Generally the same as Mary Belle of Poe's family.\n\nSkin color\nWhite. Caucasian white.\n\nFacial expression: Any expression\n\nEye color Blue\n\nEyebrow color Blue\n\nEyelashes: Fluttering\n\nFacial accessories None\n\nMake-up around the eyes (lower, upper, or the entire face is up to your taste) I want it to be reddish to pinkish.\n\nType of clothing: Kimono!\nI would like you to draw a type of kimono called \"Hiki-Furisode\". It is a type of kimono that is worn by layering two kimonos and dragging them on top of each other without taking the o-hashori off. It generally looks like this.\nhttps://youtu.be/HJ3xiUMAScw?si=DAwM-T7cIQDhX0Jg\nhttps://youtube.com/shorts/nsM1rb1mLXk?si=Tn6Mka35vXp23has\nThe first one in the reference video shows two kimonos docked and worn over a lintel (underwear) for simplification. I would like you to draw a pullover kimono like that. The kimono pattern is up to you, and the way it is tied is also up to you. I like both Japanese/Western mix style and orthodox obi!\nIzumi Kyosuke's lines have elegance of drape and beauty of fingertips, so I would like the tips of her hands and toes to be exposed. Without tabi.\n\nI want the tips of her hand nails to be sparkling. Nail omission is acceptable.\n\nPoses and accessories\nLeave it to me!\nI like the atmosphere of Kyosuke Izumi's drawings, so I will specify only the avatar and leave the expressions and poses to you.", "nc":