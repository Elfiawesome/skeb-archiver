fd4c", "src_set": ""}, "body": "こんばんは\nいつも山素さんの遊び心溢れるイラストや漫画を楽しませていただいております！\n\n船を漕ぐ（居眠りする）人のイラストを描いていただきたいです。\n眠るシチュエーションは、授業中でも、電車内でも、これらとは全く異なるものでも、何でも構いません。お任せいたします。\n\nよろしくお願いいたします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@5670000000LDK/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1283093, "client_id": 194122, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a72b47b9/uploads/origins/91096222-5961-40b4-9baa-5d415a07deda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55bc8d54d59061ebe5cd25562267b2da", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a72b47b9/uploads/origins/91096222-5961-40b4-9baa-5d415a07deda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4be3773fe241471be2e80fd3b7fc9432", "src_set": ""}, "body": "前回みたいな感じで、春の絵をお願いしたいです！\n>玄関や部屋に飾るような、風景+人物の絵画が欲しいです...！(モノクロもカッコいいのでモノクロ/カラー問いません)", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@5670000000LDK/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1283093, "client_id": 2724983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d6933b4/uploads/origins/9f62e276-de64-46cd-9627-250b8ffe9d54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8841fe1a061b63f7c922fac7af82f61f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d6933b4/uploads/origins/9f62e276-de64-46cd-9627-250b8ffe9d54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=341e62260e750ee246d7cc9093a460da", "src_set": ""}, "body": "初めまして。\nSkebリクエストで描かれていた中華まんのイラストに一目惚れして、山素様をフォローした者です。\n\n「本を読むのが好きな女の子」のイラストをぜひ描いていただきたいです。\n\n【イラストの内容について】\n「本を読むのが好きな女の子」のイラストで「縦長の構図」でお願いします。\n過去にSkebで描かれていた中華まんのイラストや、棒アイスが海になっているイラストが大好きなので、それらのイラストのような「ちょっと捻りの効いた楽しい構図」で描いていただけますと嬉しいです。\n\n・女の子の髪色は赤毛で、髪型は三つ編みのおさげ髪。\n・女の子の服装はガーリーなワンピース\n・女の子は本を手に持っている（本を読んでいる最中でも、そうでなくても構いません）\n・背景には、女の子よりも背の高い本棚がある（その子の書斎のようなイメージ）\n\n【絵の使用用途と、キャンバスサイズについて】\n描いていただいたイラストは、私が使っているiPad（電子書籍を読むのに使っています）の壁紙にさせていただくことを想定しております。\nそのため、構図は「縦長」でよろしくお願いします。\n私のiPadは「11インチのiPad Pro第二世代」で、画面サイズは「2,388×1,668ピクセル」です。\nとはいえ、「縦長の構図」でしたら、キャンバスのサイズやアスペクト比にはそこまでこだわりません。\n上記のiPadの画面サイズについても、「もしキャンバスサイズに迷ったら参考にする」程度で構いません。\n\nリクエストの内容については以上です。\nぜひご検討いただけますと幸いです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@5670000000LDK/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7c70593d/uploads/origins/6eb3291e-e744-4364-82c8-1c0fb88cd14b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e89af78ddd0b5bdace59fb14a526ef98", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1283093, "client_id": 194122, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@5670000000LDK/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1283093, "client_id": 1006597, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/732dcd78/uploads/origins/ade62f44-36dc-4e0d-9300-ae9c6c31fc09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=550deed002f1c92f36b5ccb1d2a1d6d7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/732dcd78/uploads/origins/ade62f44-36dc-4e0d-9300-ae9c6c31fc09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=532774a2d5353c08b43e7f315f19a77c", "src_set": ""}, "body": "山素様\n\nteheと申します。\n「食べ物と、キャラクター」という要素で描いていただけないでしょうか。\n\n〜〜〜\n※skebですので自由に描いて頂きたいですが、一応補足すると、キャラクターは人でも人以外の動物でも無機物でも構いません。\"食べ物\"についても自由に解釈頂いて大丈夫です。\n\n※当方、似たようなテーマをこれまで他の作家さんにもご依頼しており、今後もその可能性があります。\n気にされるようであればもちろんご遠慮なくキャンセルなさってください。\n\ntehe\n—", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@5670000000LDK/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1283093, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce96eda3/uploads/origins/039cba31-e775-4f1a-8c79-fc76d768418a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19e52185bc0b7f6bf5992295eb86347d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce96eda3/uploads/origins/039cba31-e775-4f1a-8c79-fc76d768418a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6097bc9ca56ec4aefab42dcfeef403c6", "src_set": ""}, "body": "こんにちは！いつもイラスト楽しませて頂いています！\n夏をイメージして思い浮かぶものを詰めたイラストをお願いします。PC壁紙比率(16:9)ですと嬉しいです！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@5670000000LDK/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1283093, "client_id": 2506944, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b25d9c55/uploads/origins/5dff4b83-6722-4743-879f-e72ef20be90b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e43d7e0ca9fbad56f11b085eea03ec5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b25d9c55/uploads/or