f55-93b2-326980237375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfb45c0fcf6c80f6614fae63c30a751c, https://si.imgix.net/d47e825a/uploads/origins/c36a1075-3243-4f55-93b2-326980237375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6954e0d2fba5470515cf6e4166a6180f 2x, https://si.imgix.net/d47e825a/uploads/origins/c36a1075-3243-4f55-93b2-326980237375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd2cdda47d162257c70e243150b1b61c 3x"}, "body": "こんにちは！あなたの絵が大好きです。私の推しメンであるポコらくんと、彼女のグループメイトで親友の佐古田カイの2キャラを描いていただけませんか？\nカイは残念ながら、3週間後の6月30日に卒業を発表したばかりなので、2人のために何かかわいいものを依頼しようと思っていました。私が考えたのは、カイがポコを後ろからそっと抱きしめるほのぼのとしたもの。\n構図、色、表情、雰囲気など、インスピレーションを得るために参考資料を添付します。背景はノスタルジーを感じさせるような、シンプルで穏やかなものを。\n服装は、ポコは青・黒・白、カイは赤・青・黒を基調とした高校の制服を着てもらおうと考えている。髪型については、参考シートを参照してほしい。\n突然のお願いで申し訳ありませんが、よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1DbohdupAC_lZs5bAJVgXNdEEvOlQMfkP", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_HouKou/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2657637, "client_id": 120542, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0a26e0a/uploads/origins/b1f12d1e-2b68-4cb2-b68b-110e271111d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1312bc0be03d9e7146f07a2cbbf81f58", "srcset": "https://si.imgix.net/d0a26e0a/uploads/origins/b1f12d1e-2b68-4cb2-b68b-110e271111d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1312bc0be03d9e7146f07a2cbbf81f58, https://si.imgix.net/d0a26e0a/uploads/origins/b1f12d1e-2b68-4cb2-b68b-110e271111d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6737c3ea8e667fea69df06a2564a1f2 2x, https://si.imgix.net/d0a26e0a/uploads/origins/b1f12d1e-2b68-4cb2-b68b-110e271111d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43fd24cc91de7f55b1cd5a6d401e4d9c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0a26e0a/uploads/origins/b1f12d1e-2b68-4cb2-b68b-110e271111d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1634bc209948dcadc31e36a376b5281c", "srcset": "https://si.imgix.net/d0a26e0a/uploads/origins/b1f12d1e-2b68-4cb2-b68b-110e271111d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1634bc209948dcadc31e36a376b5281c, https://si.imgix.net/d0a26e0a/uploads/origins/b1f12d1e-2b68-4cb2-b68b-110e271111d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fdc90337d2d95c9e4c68439bd8b6c314 2x, https://si.imgix.net/d0a26e0a/uploads/origins/b1f12d1e-2b68-4cb2-b68b-110e271111d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d5fab84508191263a5fc02a9491b04d7 3x"}, "body": "初めまして！イラストレーター、またVtuberとしても活動しておりますユッカと申します。\nXのタイムラインでHoukouさんのイラストを拝見し、光と影の表現、かわいくも美しい作品に一目ぼれしました…！\n可能でしたら私のVtuberとしての姿を描いて頂きたくリクエストを送らせて頂きました。\n\n\n✦描いて頂きたいキャラクターについて\n資料を添付させて頂きます。\nhttps://drive.google.com/drive/folders/1LMCWFjsd17PpaFIBq1iwe8jmFMV5Jr5o?usp=sharing\n（ユッカ通常三面図、衣装一覧というファイル2つが資料となります。）\n\n✦イラストの内容について\n基本的にすべてお任せしたく思います、Houkouさんが思い思いに作られる世界が見たいです…！\n参考に、Houkouさんを知るきっかけとなったこちらの作品がとても好きです！\nhttps://x.com/_HouKou/status/1923566695706394714\nまた職業がイラストレーターで絵を描くことが好きなこと、とにかく楽しいこと、人を楽しませることが好きであること…\nお花、自然、海、真逆ですが都会も、ダンス、スイーツなども好きです。\nこれらから自由にイメージして頂けると嬉しく思います。\n\n✦イラストの使用用途について\n基本的に鑑賞用となります。\nまた、もし今後機会があれば配信活動用のサムネイルにだけ使用させて頂くことがあるかもしれません。\nその際はサムネイル内にHoukouさんのお名前とXのアカウントIDを記載させて頂きたく思います。\n（サムネイルへの使用は難しい場合も問題ございません。その際はリクエストを再送させて頂きたく思います。）\n\n\n長文失礼いたしました。\nご検討頂けますととても嬉しく思います…！よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1LMCWFjsd17PpaFIBq1iwe8jmFMV5Jr5o?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_HouKou/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2657637, "client_id": 27685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30e40e1e/uploads/origins/1dc4b45f-0ccd-460e-8d80-50e3e3110ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb9d30184f3a1a3f0c38182adb500eeb", "srcset": "https://si.imgix.net/30e40e1e/uploads/origins/1dc4b45f-0ccd-460e-8d80-50e3e3110ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb9d30184f3a1a3f0c38182adb500eeb, https://si.imgix.net/30e40e1e/uploads/origins/1dc4b45f-0ccd-460e-8d80-50e3e3110ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bdc8bb2b4ded0f1b5f86d7118007e9ac 2x, https://si.imgix.net/30e40e1e/uploads/origins/1dc4b45f-0ccd-460e-8d80-50e3e3110ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ba4447a34495954a0c12119c47ef137 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30e40e1e/uploads/origins/1dc4b45f-0ccd-460e-8d80-50e3e3110ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=539cbe6e9f95df338bf1bed097e17ec6", "srcset": "https://si.imgix.net/30e40e1e/uploads/origins/1dc4b45f-0ccd-460e-8d80-50e3e3110ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=539cbe6e9f95df338bf1bed097e17ec6, https://si.imgix.net/30e40e1e/uploads/origins/1dc4b45f-0ccd-460e-8d80-50e3e3110ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c6e037a4ba7a80050e88e48bcd7df76b 2x, https://si.imgix.net/30e40e1e/uploads/origins/1dc4b45f-0ccd-460e-8d80-50e3e3110ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2372b06e967be5d942111d648b4bd2cd 3x"}, "body": "ほ～こう様\n\nこんばんは、ほ～こう様。\nツイッターからイラストを拝見させて頂いてファンになったものです。\n塗り方と絵面全体の構成からの、雰囲気の表現に感動しました！高いセンスを感じました…！\nそんなほ～こう様がスケブを開いていらっしゃることを知り、もしよろしければこちらのオリキャラのことを依頼したいです。\n\nお願い申し上げたいのはこちらのオリキャラ狐娘の万里香（まりか）という子です。\n狐耳と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の子です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。一人の時や知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘でほ～こう様の絵柄でのイラストをどうかお願いしたいです。\n衣装は設定画のうちの一つで、夏と花をテーマにしたイラストをお願いしても大丈夫でしょうか？\nご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_HouKou/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 2657637, "client_id": 1134169, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37de6c01/uploads/outputs/b6108050-c83d-4cb7-b6bd-f5b8dc77e74e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=af3d3c66aac563ef1f6c274fa2887adb", "srcset": "https://si.imgix.net/37de6c01/uploads/outputs/b6108050-c83d-4cb7-b6bd-f5b8dc77e74e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=af3d3c66aac563ef1f6c274fa2887adb, https://si.imgix.net/37de6c01/uploads/outputs/b6108050-c83d-4cb7-b6bd-f5b8dc77e74e?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=38deaf0ece381c8ccabd1965605e2c23 2x, https://si.imgix.net/37de6c01/uploads/outputs/b6108050-c83d-4cb7-b6bd-f5b8dc77e74e?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad276a8583f871c728c7171bbe07d47a 3x"}, "duration": 1, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37de6c01/uploads/outputs/b6108050-c83d-4cb7-b6bd-f5b8dc77e74e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=b9541ab4dc190d4f04d313a024aeb606", "srcset": "https://si.imgix.net/37de6c01/uploads/outputs/b6108050-c83d-4cb7-b6bd-f5b8dc77e74e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=b9541ab4dc190d4f04d313a024aeb606, https://si.imgix.net/37de6c01/uploads/outputs/b6108050-c83d-4cb7-b6bd-f5b8dc77e74e?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c511262e13dc142d1a3bec5924b83362 2x, https://si.imgix.net/37de6c01/uploads/outputs/b6108050-c83d-4cb7-b6bd-f5b8dc77e74e?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c7ffb0491bd71e465082ca0c48ca1a6f 3x"}, "body": "こんにちは！はじめまして。\nおいたんと申します。\n\n私は配信をしているのですが、OPやゲーム中の待機画面のアニメーションが欲しいと思っていた中\n𝗛𝗼𝘂𝗸𝗼𝘂さんが作成されたアニメーションに一目ぼれしました…！\nぜひアニメーションの作製をお願いしたいです！\n\n【使用用途】\n〇Twitter、サムネ、アイコン、ヘッダー、配信の背景等の活動への使用\nを検討しています。許可いただける場合のみ、\nリクエストをご承認いただけますと幸いです。\n\n【内容】\n・おにぎりがモチーフなので🍙のヘアピンや飾り等を入れてもらえると嬉しいです。\n・𝗛𝗼𝘂𝗸𝗼𝘂 (ほ～こう)さんの過去アニメーションがかわいかったので、キャラクターの大きさや動きはこちらに寄せていただけると幸いです。（https://x.com/_HouKou/status/1743967719068680393）\n・その他の構図はお任せします。\n・参考情報：田舎に住んでいる、コメ農家、ご飯が好き、肉とサーモンも好き、季節は秋が好き、家では髪を結んでいることが多い\n\n・参考資料\n・https://drive.google.com/file/d/1vl9f6FAauHyyaRbpGME6SXskbZAQgN1X/view?usp=sharing\n・https://drive.google.com/file/d/1RmDmPikIhx2wxIh2yfYGhW7nQ2i34F5N/view?usp=sharing\n・https://drive.google.com/file/d/1D3Fz90Ow_CKrqFvAl0-5us0AQzGXrewL/view?usp=sharing\n・https://twitter.com/oioioitanch\n\n\nとても楽しみにお待ちしています。よろしくお願いします！！", "nc": 129, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@_HouKou/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2657637, "client_id": 584527, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f563fcd7/uploads/origins/bb9c82fa-098e-404a-82c1-f67fc827e823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f18e994708b401a97be531dc18c7f32d", "srcset": "https://si.imgix.net/f563fcd7/uploads/origins/bb9c82fa-098e-404a-82c1-f67fc827e823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f18e994708b401a97be531dc18c7f32d, https://si.imgix.net/f563fcd7/uploads/origins/bb9c82fa-098e-404a-82c1-f67fc827e823?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d88ca04ad3757658573f241ab5d7389f 2x, https://si.imgix.net/f563fcd7/uploads/origins/bb9c82fa-098e-404a-82c1-f67fc827e823?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=238f0040e118ba20d15de8f88b97e4d3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f563fcd7/uploads/origins/bb9c82fa-098e-404a-82c1-f67fc827e823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50bb90df13c974c64437d88d82866a73", "srcset": "https://si.imgix.net/f563fcd7/uploads/origins/bb9c82fa-098e-404a-82c1-f67fc827e823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50bb90df13c974c64437d88d82866a73, https://si.imgix.net/f563fcd7/uploads/origins/bb9c82fa-098e-404a-82c1-f67fc827e823?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b36d3c8414bee3feeb47142ce96a5fe3 2x, https://si.imgix.net/f563fcd7/uploads/origins/bb9c82fa-098e-404a-82c1-f67fc827e823?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0eabe131cfb52e656b1aab9c044a56d7 3x"}, "body": "こんにちは、初めて依頼させていただきます。\n描き込まれている背景と、可愛らしい人物を見て依頼を決めました。\nそれではさっそく依頼の内容に入らせていただきます。\n\n内容:背景、人物、ライフル\n\n背景:近未来都市\n青空が綺麗な美しい、自然と科学が融合した都市。\n\n人物:バーチャルYouTuber、虚無\n\n武器:アサルトライフル\nhttps://photos.app.goo.gl/kkEbcTF5SW7g6T4s6\nストックを短くした場合、長さが750mm位になるブルパップ式のアサルトライフルです。\n上のはスコープ、側面はM-LOK、使用弾薬は6mm PPC、弾倉は樹脂製で半透明であり取手が着いています。\nピカティニーレールが着いている方を改修して完成したのが、今回のアサルトライフルです。\n\n詳細内容:アサルトライフルを構えながら走っている感じで、楽しげで快活な表情です。服装はMGSのヘイブントルーパー（https://livedoor.blogimg.jp/evidevi-gazou/imgs/7/d/7d0255ac.jpg）の様な戦闘服に新ビジュアル（https://www.youtube.com/live/wH2Mut-KBVs?si=HbSzZTs4L1QBh9na）の要素を足して、アレンジしていただきたいです。\nただし、ヘルメットは無し、又はバブルヘルメットの様な、髪型まで見れる様な物で御願い致します。\nイメージとしてはApexやVALORANTの様な未来FPSみたいな感じです。\n\n使用用途:観賞、虚無さんへのプレゼント\nその為、配信で紹介される、動画のサムネイル等に使用される、twitter等のSNSにアップロードする又は、それが無理な場合は虚無さんへ直接渡す、などの可能性があります。その場合、絵師様の名前を伝えさせていただきます。\n\nどうか宜しくお願い致します。\nhttps://www.mumin-0u0.life/voidwiki/index.php/%E3%82%88%E3%81%86%E3%81%93%E3%81%9D%EF%BC%81VoidWiki%E3%81%B8\nhttps://www.youtube.com/live/wH2Mut-KBVs?si=_x0PxK75agD3o2WE\nhttps://youtu.be/So2VGX3-mqQ", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_HouKou/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2657637, "client_id": 1361964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d2f5517/uploads/origins/5ef3f2bf-7e59-48f2-8005-d96635212705?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aae5d18387905d98b4bccc37c5f570b9", "srcset": "https://si.imgix.net/1d2f5517/uploads/origins/5ef3f2bf-7e59-48f2-8005-d96635212705?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aae5d18387905d98b4bccc37c5f570b9, https://si.imgix.net/1d2f5517/uploads/origins/5ef3f2bf-7e59-48f2-8005-d96635212705?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d0feaea2be52b5c7b2a4d9fcec8859e 2x, https://si.imgix.net/1d2f5517/uploads/origins/5ef3f2bf-7e59-48f2-8005-d96635212705?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d62c03be83b792ec297783e8f4cf7860 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d2f5517/uploads/origins/5ef3f2bf-7e59-48f2-8005-d96635212705?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e0de2008973857d6b54621dab3827a5", "srcset": "https://si.imgix.net/1d2f5517/uploads/origins/5ef3f2bf-7e59-48f2-8005-d96635212705?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200