b9-5f93-4df6-b636-5d77f56c1f4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f8a29634fcab72b9053fba39cd4ffe0, https://si.imgix.net/68d299c2/uploads/origins/219588b9-5f93-4df6-b636-5d77f56c1f4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=333922c5df8047f188d46702b272a281 2x, https://si.imgix.net/68d299c2/uploads/origins/219588b9-5f93-4df6-b636-5d77f56c1f4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df762442b859ff9d22878ec6e9ef3bed 3x"}, "body": "こんにちは！\n私のVTuberの友人たちのグループイラストを依頼したいと思っています。このイラストは、いつもそばにいてくれる彼らへの感謝の気持ちを込めたプレゼントです。彼らと過ごせる日々をどれほど大切に思っているかを表現した作品にしたいです。\n\n参考画像はこちら：https://imgur.com/a/7M799R0\nそして、このような作風に近いものが理想です：https://skeb.jp/@_HouKou/works/13\n\n参考画像のフォルダには、構図上の各キャラクターの位置を示す矢印を添付しました。ファイル名は各キャラクターに対応しています：\nMiel = 優しくて穏やか\nJust1Chat = 子供っぽくて、おどけた感じ\nKatchan = 優しくて穏やか\nHosa = 控えめで、あまり表情が豊かではない\nChaama = カオスで、面白い \n\n表情やポーズ、全体の雰囲気については、ご自身の芸術的なスタイルに従い、一番しっくりくるように描いてください！\n\n背景や構図、全体の雰囲気は完全に自由です。温かみがあり、誠実で、友情に満ちたイラストに仕上げていただけると嬉しいです。\n\nご依頼をご検討いただき、誠にありがとうございます！ 💖\n\nhttps://drive.google.com/drive/folders/1NHiEMNmRfVEbpkqUHkixDdXtOLURdKLb", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_HouKou/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/057c1627/uploads/origins/9f8d8316-bca3-43d7-9158-b4ed4ed0e6be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b3b66c4b577c9c0e1c29182aacd2276", "srcset": "https://si.imgix.net/057c1627/uploads/origins/9f8d8316-bca3-43d7-9158-b4ed4ed0e6be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b3b66c4b577c9c0e1c29182aacd2276, https://si.imgix.net/057c1627/uploads/origins/9f8d8316-bca3-43d