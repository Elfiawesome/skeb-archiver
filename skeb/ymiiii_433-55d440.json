目\n自称ド陰キャ。普段は貧血なのと疲れやすいから省エネモードなだけで、喋ることそのものは嫌いではない(好きでもない)。ただし、誰かと話をするのは好きじゃない。自分の言葉になんでも従う者たちも、何気ない言葉にすら力を持たせてしまう自分自身も嫌い。自己肯定感は底辺を貫いて地にめり込んでる。でも自分に求められている仕事は果たす、仕事なので。\n\n・ゲーム実況・配信について\n最も得意なゲームはギャルゲーと乙女ゲー。人の心の機微を知り尽くした解説込み、迷いのない選択肢選びと主人公や攻略キャラクターに対する容赦のない言葉の棘のギャップが視聴者の心を鷲掴み。女性視聴者の方が多いかと思えば半々くらいの割合で、どんなにリクエストがあってもホラゲーはやらない（怖いわけではない)。典型的なゲーム実況・配信してる時の自分と現実の自分を分けてるタイプ。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ymiiii_433/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3078717, "client_id": 227300, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af3fc7b6/uploads/origins/46b26ad0-7296-43e1-b9bf-1d6ca1b3fdc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9f24ca36e9c6feffb9aed0ef6091777", "srcset": "https://si.imgix.net/af3fc7b6/uploads/origins/46b26ad0-7296-43e1-b9bf-1d6ca1b3fdc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9f24ca36e9c6feffb9aed0ef6091777, https://si.imgix.net/af3fc7b6/uploads/origins/46b26ad0-7296-43e1-b9bf-1d6ca1b3fdc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23a4d0ca4fde9813332a49d9a447c64c 2x, https://si.imgix.net/af3fc7b6/uploads/origins/46b26ad0-7296-43e1-b9bf-1d6ca1b3fdc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c3b09045fe98a1cb028c6d7013a662c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af3fc7b6/uploads/origins/46b26ad0-7296-43e1-b9bf-1d6ca1b3fdc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2154acfacff4b9ffd1833d83eef2a41e", "srcset": "https://si.imgix.net/af3fc7b6/uploads/origins/46b26ad0-7296-43e1-b9bf-1d6ca1b3fdc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2154acfacff4b9ffd1833d83eef2a41e, https://si.imgix.net/af