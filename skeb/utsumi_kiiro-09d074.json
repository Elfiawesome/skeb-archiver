3OtQYkk.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9c1cdab0f34e96d508fae23838e12a1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1823814724091568130%2Fb3OtQYkk.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3aa6a6af0a7b88327d04947ffb3bf0bd", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1823814724091568130%2Fb3OtQYkk.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3aa6a6af0a7b88327d04947ffb3bf0bd, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1823814724091568130%2Fb3OtQYkk.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e91f5302c1efc31c61d4f0e6c86d7401 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1823814724091568130%2Fb3OtQYkk.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bce79d6796c45d6cd69082d72968610f 3x"}, "body": "初めまして、共通の相互さんから興味を持ち依頼します。\n私の創作百合の小説を書いてほしいです。\nキャラクターに名前が無く、文に起こしにくいかもしれません。私は青髪(高校までは暗い赤紫)銀髪とそれぞれ呼んでいます。\nどちらかといえば青髪の方が主人公で、私は漫画もそちらをメインに描きましたが、視点はどこからでもお任せします。\n彼女らを少し説明すると、青髪はレズビアンです。中学時代、同じバレー部の自称レズ(思春期の思い違い)と少しの間付き合い、やっぱり違ったと振られます。そこからは同じ中学の人が少ない高校に進学し、なんとなく過去を捨てる気持ちで髪を青に染めます。\n銀髪のセクシャリティは私にも分かりません。彼女自身恋愛に興味がなく無頓着で、考えたことがなかったからです。彼女の小学校からの友達(三つ編み)も、漠然と恋愛に憧れが無くはないものの世の中的に異性と付き合うものという感覚がうっすらある程度で、銀髪共々特段考えず過ごしてきました。\n長くなりますが経緯を書いていきます。\n青髪は高校で銀髪と同じクラスになり、もともと社交的だった青髪は普通にクラスメイトとして接します。\n初夏、少し仲良くなった頃の朝、自分に挨拶した銀髪が眩しくてついに意識し始めますが、中学のことを思い出して恐れ蓋をします。\n2年生の春までは結局罪悪感を抱えつつも仲の良い友達として過ごしますが、2度目の初夏に気持ちが抑えられなくなり、恐怖と罪悪感から銀髪を避けるようになります。\n夏休みの間に気持ちを切り替える決心をしますが、1学期の終わりに差し掛かる頃、銀髪が声を掛けます。\n銀髪は友達として青髪が好きだったので、青髪が離れていくのが嫌だったためです。\n怯え躊躇いつつも青髪はそこで、自分が銀髪に恋愛感情を持っていることを明かします。\n銀髪は、恋愛のことは分からないけれど、それで離れていかないでくれるならと前置きして、付き合うことを提案します。\nそれからしばらくは、青髪は過去と同じ轍になるのではという不安や、銀髪に言わせてしまった罪悪感、銀髪が変な目でみられてしまわないかという心配などから落ち着かない日々を過ごします。\n一方で銀髪は、青髪が好きですし、だんだん可愛い愛しいという気持ちが芽生えて微塵も後悔がありませんでした。\n夏休みの初デートで2人が駅にいるときに、偶然三つ編みと会ってしまい青髪は青ざめますが、恋愛以前に異性も同性も考えてこなかった銀髪は、当然のように付き合ったことを三つ編みに話してしまいます。\nただ三つ編みも銀髪と大して変わらない大雑把な性格なので、同性同士なことなど違和感を持たず、むしろ青髪を歓迎して友達になります。\nメインの時間軸では全員大学1年生で、銀髪のみ他大学の建築系、青髪は環境系、三つ編みは教育系で同じ大学に進んでいます。\n三つ編みは特に言いふらすこともなかったので、高校では2人はただ仲の良い2人として過ごすことができました。信頼関係も深いのでどのコンビでいても浮気などの疑惑もなく仲の良い3人です。\n銀髪と青髪の詳細は、2つURLを添付します。\n説明がとても長くなってしまい申し訳ありません。彼女らのことは、Twitter上で、「#充電器のやつ」でも呟いています。\n自分でもどこをどう依頼したものか決めかねている状態なので、お話のどこを切り取っていただいても構いません。どの部分をどんな視点で小説にするかはお任せします。\nもし足りない情報があれば、捏造で補完していただいて大丈夫です。\nもしよろしければ、よろしくお願いします。\n以下資料です。\nhttps://x.com/lycoris170/status/1789668636179001471?s=19\nhttps://x.com/lycoris170/status/1801581528662810707?s=19", "nc": 136, "word_count": 7157, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@utsumi_kiiro/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 3145963, "client_id": 1251178, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1823814724091568130%2Fb3OtQYkk.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2572a04527a556e531e2ffb202f3c46a", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1823814724091568130%2Fb3OtQYkk.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2572a04527a556e531e2ffb202f3c46a, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1823814724091568130%2Fb3OtQYkk.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd4f28baf4d03621941d772ec79cb5a8 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1823814724091568130%2Fb3OtQYkk.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b0cab6ca9908fb457a316abafe01eae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1823814724091568130%2Fb3OtQYkk.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db800b91f555caa9a079d745fc0a89d2", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1823814724091568130%2Fb3OtQYkk.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db800b91f555caa9a079d745fc0a89d2, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1823814724091568130%2Fb3OtQYkk.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8be0e1846376e1f745fdd93646496553 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1823814724091568130%2Fb3OtQYkk.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ca90f0eeaa190139492c154dd16a6afd 3x"}, "body": "申し訳ありません、資料に不備があったので送り直させていただきました。\n\nうつみきいろ先生いつもお世話になっております。私の創作っ子の小説をお願いしたくリクエストを送りました。\n\nブロムくん、ラバーンくん、セレナちゃんという三人の幼馴染のお話をぜひ読みたいです。\n\n利用目的としては基本個人観賞用ですが創作サイトに載せることもあるかもしれません。\n\n\n以下設定を書いていきますが、不明瞭な部分はお好きなように設定を付け足していただいても構いません。よろしくお願いします。\n\n●ブロム\n現在18歳の男の子。私の創作の主人公です。外見は薄いピンクに染めた髪(地毛は茶髪)に水色の瞳、身長はラバーンと同じくらいだが彼よりは少し低め。\nブロムは幼少期に小児喘息で田舎の祖父母の家に預けられ育ちました。両親は頻繁に面倒を見に来ていましたがそれでも幼いブロムは寂しい思いをしていました。\nその寂しさから誰からも嫌われたくない、愛される存在でいようと素直で優しい子に育ちました。学校では皆の王子様的ポジションでちやほやされていました。喘息だったころは運動させてもらえなかったのでか弱い感じです。かわいい物が好きです。\n18歳になった現在は田舎を離れ両親と二人の姉と一緒に暮らしています。セレナに密かに恋心を抱いています。\n一人称は僕、二人称君、口調は「～だよ」「～だね」「～なの？」「～じゃないか」。ラバーンとセレナのことは名前呼び。\n\nセリフ\n「皆と仲良くしちゃいけないの？人から嫌われるよりは好かれたいと思ってるんだけど。」\n「ちょっと、君の価値観を押しつけないでよ。どうして君にそんなこと言われなきゃいけないのさ。」\n「最悪だ！なんなのあいつ！？今日は12回ﾀﾋねって言われたよ！？暇なの！？」\n\n●ラバーン\n同じく18の男の子。田舎生まれ田舎育ち。外見は雑にハネた薄い茶髪に濃いピンクの瞳。不良みたいな恰好をしています。\n小学校がブロムと同じで、ラバーンは性格が悪いので学校の皆からは遠巻きにされていました。ブロムと出会った当初から二人は相性が悪く喧嘩も多くなりました。\nラバーンはブロムの優しさがエゴからきていると見抜いて、誰にでも優しいのは誰にも優しくないし誰か一人を大切にできない奴だと考えているため、ブロムのことが気に入らなくて突っかかっています。何を怖がって媚び売ってるんだ？という感じに思ってます。\nセレナにも変わらずガラ悪い対応してます。スパイダーコークという商品(コークとは名ばかりのルートビア)が好物でいつも飲んでます。ちなみにブロムはこの飲物が苦手です。\n一人称は俺、二人称お前。口調は「～だろ」「～なのか？」「～してんだよ」。ブロムとセレナのことは名前呼び。\n\nセリフ\n「仲良しごっこは楽しいか？そうやって好きでもない奴にも優しくすんのか。」\n「うざい。見ててイラつくんだよ。」\n「…これくらいで大袈裟なんだよ、余計なお世話だ。」\n\n●セレナ\n18歳の女の子。内気で読書ばかりしています。外見は褐色肌にウェーブのかかった黒髪、グリーンの瞳、身長は低め。\n学校で上の男子二人と出会った時は、ラバーンはもちろんのことブロムのことも怖いと感じていました。学校できらきらしているブロムに、話しかけられると震えて逃げてました。どうして自分なんかにも優しく話しかけてくるのかわからず不信に思い、ブロムに〝どうして皆と話さないの？僕らのことが嫌い？〟と言われた時はもう内心自分のことを詮索しないでくれとパニックになりました。\nある日、「友達語りたいなら友達作ってからにしなよ。」「……！！俺は一人が好きなんだよ！」というようなラバーンとブロムの喧嘩を目撃したセレナはその会話を聞き、ブロムも自分と同じで嫌われるのが怖いと気づき、怖くなくなります。\nそれから勇気を出して自分からブロムに挨拶をするようになりました。いつも逃げられていたセレナから「気を使わなくても私はブロムのこと嫌ったりしないよ」と言われた頃からブロムはセレナのことが好きです。\n最終的にいつも仲悪い二人を見かねてセレナは仲直りしなさいと怒り、強制的に謝らせます。それから三人はなんだかんだ一緒にいることが多くなりました。ブロムは元から嫌ってくるラバーンと優しくなくても嫌わないと言ってくれたセレナといる時は素の自分でいられます。\n一人称は私、二人称あなた。口調は「～だよ」「～なの」「～でしょ」。ブロムとラバーンのことは名前呼び。\n\nセリフ\n「あの…わたしは…なにを話せばいいかわからなくて、失敗した時のことを考えると怖くて…声が、でない…から。」\n「うまく、言えなくて…ごめん…。話すのは苦手なの…。」\n「仲直り！謝りなさい！」\n\n\n\n長くなってしまいすみません。資料画像はリンク先にあります。\nCP風味の小説でも問題ないです、むしろ嬉しいです。ブロム×セレナになりたかったブロムのラバーン×ブロムとかなんでも美味しいです。\nどんな内容でも構いません、先生の小説楽しみに待っています。\n内容に不備がありましたら、お手数ですが再送要請を送っていただけると助かります。\n\nhttps://drive.google.com/drive/folders/1xJhKWc6vYIzPdbee-1UKfGbhAneZ6o59?usp=sharing", "nc": 8, "word_count": 7388, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2570969, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "黒タン@地味に活動中", "screen_name": "kurotan", "avatar_url": "https://pbs.twimg.com/profile_images/1613783123518722050/RHHYRd22.jpg", "header_url": "https://pbs.twimg.com/profile_banners/828443905263755264/1673590866/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 1}, {"id": 2868279, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "卍課金ヤメロマン卍", "screen_name": "Gintulizao", "avatar_url": "https://pbs.twimg.com/profile_images/2013123806424928256/L_WVuKre.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1372153817580539906/1710107322/1500x500", "appeal_receivable": false