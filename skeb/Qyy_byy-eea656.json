エンジニア\n\n\n⚫︎服装\nおまかせ、または資料にある衣装いずれか(アレンジやデザインの省略OKです)。\nまた必須ではございませんが、審神者の夫を連想させるモチーフや概念もどこかに少し取り入れられていたら嬉しいです…！\n⇒💧水滴　▼逆三角形　🐧ペンギン　黒い柴犬　ツァボライト　タンザナイト　菫　黒いレザー素材(ベルト・手袋など)\n\n\n⚫︎利用目的\n個人鑑賞用、Xのアイコン・ヘッダーへの使用、キャラ資料への掲載(他の方へ提示する場合がございます)\n\n\n⚫︎その他\n背景がある場合は、可能でしたら透過バージョンもご用意いただけますと大変助かります。\n\n\n説明が細かく恐縮ですがあくまでも参考情報なので、あんこ様のお好み・描きやすい形で自由に描いていただけましたら幸いです🌸\nご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1_uYjFroKHPly10ezcryG2RATHPCeGeYc", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Qyy_byy/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a30b9ff2/uploads/origins/8159a70d-54d4-4040-b5dc-9b001ce34c07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6fb3c6e5d9901003d688e85bfb49a3ec", "srcset": "https://si.imgix.net/a30b9ff2/uploads/origins/8159a70d-54d4-4040-b5dc-9b001ce34c07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6fb3c6e5d9901003d688e85bfb49a3ec, https://si.imgix.net/a30b9ff2/uploads/origins/8159a70d-54d4-4040-b5dc-9b001ce34c07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76616fef7126f9f41e12ca755b53bd46 2x, https://si.imgix.net/a30b9ff2/uploads/origins/8159a70d-54d4-4040-b5dc-9b001ce34c07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99340e370577235555f8146c492e0858 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 3526877, "client_id": 3385585, "nc": 16}, {"path": "/@Qyy_byy/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6da6399d/uploads/origins/988