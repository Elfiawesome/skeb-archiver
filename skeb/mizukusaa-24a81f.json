rop=top&w=200&h=200&s=ce179b83a0873f51f4b27295bc5aaa2f", "srcset": "https://si.imgix.net/5ac633c7/uploads/origins/1fb406a3-301a-42b1-bf9e-a163ba01c516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce179b83a0873f51f4b27295bc5aaa2f, https://si.imgix.net/5ac633c7/uploads/origins/1fb406a3-301a-42b1-bf9e-a163ba01c516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e6c2a1332907c8e72608f2b6838cea9 2x, https://si.imgix.net/5ac633c7/uploads/origins/1fb406a3-301a-42b1-bf9e-a163ba01c516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11c8802907b61f51b292fcddd2076e79 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ac633c7/uploads/origins/1fb406a3-301a-42b1-bf9e-a163ba01c516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54c9db203cae2e6560d39b9873c31d64", "srcset": "https://si.imgix.net/5ac633c7/uploads/origins/1fb406a3-301a-42b1-bf9e-a163ba01c516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54c9db203cae2e6560d39b9873c31d64, https://si.imgix.net/5ac633c7/uploads/origins/1fb406a3-301a-42b1-bf9e-a163ba01c516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bcc3918b978e12a1d45dcf50e1c1a9d5 2x, https://si.imgix.net/5ac633c7/uploads/origins/1fb406a3-301a-42b1-bf9e-a163ba01c516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=52c772b92b5771b80acd8ee2f2b6b562 3x"}, "body": "Tomoyami様、はじめまして。\n\n平素より素敵なイラストを拝見しており、陰ながら応援させていただいております。\n絵画のような繊細なタッチ、迫力の構図や配置、緻密かつ鮮明に描き込まれた小物などとにかく全てが大好きです。いつかイラストを依頼してみたいと考えていた為募集を心待ちにしておりました。\nこの度は私のOCのイラストを描いていただきたく、リクエストさせて頂きました。お忙しいと存じますが、確認いただけますと幸いです。\n\n────────\n\n名前：狼谷 椿季(かみや つばき)\n性別：男性\n身長：185cm\nイメージカラー：黒とクリムゾンレッド\nモチーフ：狼\n好きな物：家族、星空、自由\n嫌いな物：じっとしていること、暑さ、朝\n少々変わった葬儀屋を営む青年。初対面では見た目から警戒されることが多いが、話してみると面倒見が良く気前も良い。特に仲のいい人間のことは「きょうだい」と呼び慕う。弟や妹が多い為か少々世話焼きを通り越してお節介な面がある。\n\n─────────\n\n構図内容はお任せします。葬儀屋かつモチーフが狼なのもありゴシック系の雰囲気が含まれたイラストだととても嬉しいです。また、色味としてはイメカラである黒や赤系統だと嬉しいです。\n\n服装につきましては資料通りのものでも構いませんし、多少装飾の省略等していただいても問題ありません。Tomoyami様のデザインが大好きなのでアレンジ等も自由にして頂いて問題ありません。\n\n使用用途としては\n・個人的な用途での鑑賞やSNSのアイコン等での使用\n・非営利目的かつ個人的鑑賞用の印刷\nに使用させて頂きたいです。\n\nもし上記の内容に不備等ございましたら、お気軽にキャンセルしてください。ご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/10DVTKmPoPMtAU8B5FKTOZAxWHRUjXlug", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mazoio_0203/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3162609, "client_id": 3365539, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed69687f/uploads/origins/182b07d0-b8f7-4feb-abef-f7043d965f55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fa8d704b4194daafc98fbc9c3931af7", "srcset": "https://si.imgix.net/ed69687f/uploads/origins/182b07d0-b8f7-4feb-abef-f7043d965f55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fa8d704b4194daafc98fbc9c3931af7, https://si.imgix.net/ed69687f/uploads/origins/182b07d0-b8f7-4feb-abef-f7043d965f55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f28f86a97319d429cb87695376eb3501 2x, https://si.imgix.net/ed69687f/uploads/origins/182b07d0-b8f7-4feb-abef-f7043d965f55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee56c359497b859e0be323cebafc8848 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed69687f/uploads/origins/182b07d0-b8f7-4feb-abef-f7043d965f55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ac348ea0f2309bd03689f511ed21d29", "srcset": "https://si.imgix.net/ed69687f/uploads/origins/182b07d0-b8f7-4feb-abef-f7043d965f55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blu