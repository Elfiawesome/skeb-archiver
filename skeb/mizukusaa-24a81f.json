すが、\n放出する水の量をコントロールすることが難しく、\n定期的に空が所属する研究所に赴いては、\nカウンセリングやメンテナンスを受けています。\n\n医師と患者、のような関係性です。\n凪姫はあまり他者に自信の感情を打ち明けることはしませんが\n空には少しこぼすこともあるようです。\n\nこのことから想像できる2人を自由に、\n楽しく描いていただけますと幸いです。\nイラストの系統はシチュエーションに沿ったものでお願いします。\nまた、2人とも無表情がデフォルトですので笑顔や泣き顔、\n怒った顔はお控えください。\n(空の微笑程度は問題ありません)\nどうぞよろしくおねがいします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@lauren_cos95187/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4122276, "client_id": 3365539, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed5baafd/uploads/origins/19f7c289-502c-48d2-a392-50e7dc01ef06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86f2aeff3f7ab057c2f08075511edde0", "srcset": "https://si.imgix.net/ed5baafd/uploads/origins/19f7c289-502c-48d2-a392-50e7dc01ef06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86f2aeff3f7ab057c2f08075511edde0, https://si.imgix.net/ed5baafd/uploads/origins/19f7c289-502c-48d2-a392-50e7dc01ef06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b67184719b4f1dd9136c7c4fbc55d40 2x, https://si.imgix.net/ed5baafd/uploads/origins/19f7c289-502c-48d2-a392-50e7dc01ef06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66eb46cf76435b49b7a0cef5c424ca87 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed5baafd/uploads/origins/19f7c289-502c-48d2-a392-50e7dc01ef06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2612d2b54d26647ecbae971d6eba4507", "srcset": "https://si.imgix.net/ed5baafd/uploads/origins/19f7c289-502c-48d2-a392-50e7dc01ef06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2612d2b54d26647ecbae971d6eba4507, https://si.imgix.net/ed5baafd/uploads/origins/19f7c289-502c-48d2-a392-50e7dc01e