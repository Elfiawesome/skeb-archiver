3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f82bdafbe917a00985bb4698ae10c88, https://si.imgix.net/ee2f1453/uploads/origins/709944bf-b8dd-4691-bcef-28b094d8b0b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6adbb0566005c0d024373da36e177ca4 2x, https://si.imgix.net/ee2f1453/uploads/origins/709944bf-b8dd-4691-bcef-28b094d8b0b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=68f199f59bed4e8e4e84ebc1793749fe 3x"}, "body": "こんにちは、\nリクエストとしては、星宮いちごがパラシュートにすっぽり覆われて、パラシュートの下でバカ笑いしている様子を吹き出しで表現してほしいです。\n\n参考：いちご：\nhttps://photos.app.goo.gl/rQYaFsqU5BtvV7h77\n\nパラシュートの参考文献\nhttps://1drv.ms/f/s!AvsEDH0kEzsHgeQSiwgrnM21euqrfg?e=9AMRJs\n\n文字を示す吹き出しのリファレンス：\nhttps://1drv.ms/f/s!AvsEDH0kEzsHgeQTz51rAlx57Gr-TQ?e=0IUmTT", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amn17P/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3161449, "client_id": 460270, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94320ada/uploads/origins/c6a8ac5f-ba44-4fb7-813b-8b1ea5c1741c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=063cb3bfbd66bb5e57ce54b8e5d1315b", "srcset": "https://si.imgix.net/94320ada/uploads/origins/c6a8ac5f-ba44-4fb7-813b-8b1ea5c1741c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=063cb3bfbd66bb5e57ce54b8e5d1315b, https://si.imgix.net/94320ada/uploads/origins/c6a8ac5f-ba44-4fb7-813b-8b1ea5c1741c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8da9458a19d22bd6a083fd6d0ab488c9 2x, https://si.imgix.net/94320ada/uploads/origins/c6a8ac5f-ba44-4fb7-813b-8b1ea5c1741c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65b23cd4fa00f04c98fbe3e9518b6375 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94320ada/uploads/origins/c6a8ac5f-ba44-4fb7-813b-8b1ea5c1741c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e8099d9eeafb3c994fa3264361cf5d8", "srcset": "https://si.imgix.net/94320ada/uploads/origins/c6a8ac5f-ba44-4fb7-813b-8b1ea5c1741c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e8099d9eeafb3c994fa3264361cf5d8, https://si.imgix.net/94320ada/uploads/origins/c6a8ac5f-ba44-4fb7-813b-8b1ea5c1741c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=808f52edd667fe3a22bbd0421bf96968 2x, https://si.imgix.net/94320ada/uploads/origins/c6a8ac5f-ba44-4fb7-813b-8b1ea5c1741c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc2ef48a79282787eea21f13815b2b4f 3x"}, "body": "絵柄が可愛らしく、ミクのイラストよかったので、リクエストを送らせていただきました。\nかなりの特殊性癖ネタになるので、もし興味持たれたらで大丈夫です\nマリオワンダーのW4「ブースケ泳ぐ白砂漠」で変身することになるバルーン姿になったピーチ達のような姿のボカロの子達を描いていただきたいです。\n\n参考画像＆イラスト↓\nhttps://twitter.com/MORITOKYOKUX/status/1718143055138836680\nhttps://twitter.com/MORITOKYOKUX/status/1718281611073163591\n\nhttps://twitter.com/Akihuzi_tform/status/1700792098952528005\nhttps://twitter.com/Akihuzi_tform/status/1759983049260007811\n\n・PSD形式などレイヤーを分けた状態でお願いします。\n・ミク、リン、ルカを描いていただきたく。\nそれぞれのデフォルトの衣装とピーチ姫のようなドレスの2種の衣装でお願いします。\n他にもお好みの衣装やキャラがいれば描いていただけると嬉しいです。\n・全員同じサイズでお願いします。\n・ベースとなるのは資料の参考図のような正面アングルでお願いします。\n・正面アングルになるので左右対称ツールなどを使っていただいて問題ありません。\n・顔は基本は正面向きで基本は笑顔に近い通常表情でお願いします。\n・髪は少しボリューム多めだと可愛くなりやすいと思います。\n・原作のような背景はあってもなくてもお任せいたします。\n・パーツは顔、頭、後ろ髪、服、下半身、足、腕のようにできるだけで分けていただきたいです。\n・頭は正面顔だけの状態も楽しみたいので埋もれて隠れている部分も描いていただきたいです。\n・恥ずかしがってるなど表情の差分などもあると嬉しいです。\n・下半身は原作だとドロワーズですが、上記の参考イラストのような形状で各々に似合うデザインの下着でお願いします。\n・参考までに大体頭と風船ボディの大きさ比は1:3程度みたいです。\n・色変えなども出来るようにレイヤーはできるだけ分けた状態でいただけると嬉しいです。\n\nよければよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amn17P/works/3", "private_thumbnail_image_urls"