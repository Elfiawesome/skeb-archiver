を作っているポーズ(ピンクのハートを周りに散らしてほしいです)\n\nいぬやよ様のHiスタンプのようなゆるいイラストがすごくかわいらしくて大好きなので、太めの線で描いてくださると嬉しいです\n\n【使用用途】\n・配信用のスタンプ(収益化済)\n\n宇宙猫以外は透過されているファイルもいただけますと幸いです。\n\n難しい場合は遠慮なくキャンセルして頂いて大丈夫です。金額が足りない場合は再送してください。\nお忙しいところ恐れ入りますが、ご縁がありましたらぜひよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1qMm-W77py7jd-OpHw0Et0WiRYLL4VyVL?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uyu_milk_02/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3692255, "client_id": 3374736, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0bcf7ac/uploads/origins/6898b9bc-c45a-46db-afb4-346cd26f42ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9f5d30ec64f71b2a7f443d02f3849cf", "srcset": "https://si.imgix.net/a0bcf7ac/uploads/origins/6898b9bc-c45a-46db-afb4-346cd26f42ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9f5d30ec64f71b2a7f443d02f3849cf, https://si.imgix.net/a0bcf7ac/uploads/origins/6898b9bc-c45a-46db-afb4-346cd26f42ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce9e64c0ce753ae3cf48cc1da22e9b9e 2x, https://si.imgix.net/a0bcf7ac/uploads/origins/6898b9bc-c45a-46db-afb4-346cd26f42ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60dded0d89becda020838e0c185d0d12 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0bcf7ac/uploads/origins/6898b9bc-c45a-46db-afb4-346cd26f42ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4480df6ffe43cfdb6647be926170d1ac", "srcset": "https://si.imgix.net/a0bcf7ac/uploads/origins/6898b9bc-c45a-46db-afb4-346cd26f42ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4480df6ffe43cfdb6647be926170d1ac, https://si.imgix.net/a0bcf7ac/uploads/origins/6898b9bc-c45a