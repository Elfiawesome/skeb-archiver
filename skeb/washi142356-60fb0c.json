-9768-4cfde0a97eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c25c6cbbc109a28dac9c521ffb154046", "srcset": "https://si.imgix.net/48bfe684/uploads/origins/30ce5219-302c-4b25-9768-4cfde0a97eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c25c6cbbc109a28dac9c521ffb154046, https://si.imgix.net/48bfe684/uploads/origins/30ce5219-302c-4b25-9768-4cfde0a97eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=65edb1ee33912266dda00ceab2371d67 2x, https://si.imgix.net/48bfe684/uploads/origins/30ce5219-302c-4b25-9768-4cfde0a97eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b9027a18c76c84618363a7ca5e337696 3x"}, "body": "お世話になっております。前回のコミックがとても良かったので、また依頼をさせて頂きました。\n\n①自分のトレーナーであるスターちゃんのグラビアが出ると聞いて、出版社の人からサンプルを貰うテイオー\n➁スターちゃんの普段見れないカッコいい姿や可愛い姿が沢山あって、この可愛さが世間に出ていいわけないと文句を言うテイオー\n③そうしたら出版社の人から、「今回のグラビアに乗せられなかった秘蔵写真です」と言われて少し過激な感じの写真を渡されてしまう\n④黙りこくって、次の開催はいつなの？と尋ねそうになるテイオー。そして同じ写真を貰ってほくほくしている同チームでありスターちゃんの妹であるカフェがるんるん気分で後ろを歩いている。\n\n見た目や設定などは参考資料のURLの「スターゲイザーの設定画」など今までのイラストを見ていただけたら幸いです。\n\nhttps://syosetu.org/?mode=ss_detail&nid=268791\nhttps://syosetu.org/?mode=img_user_gallery&uid=367287\n\nその他指定のない箇所はおまかせいたします。\nセリフや流れ等は描きやすいように変えて頂いて構いません。\n金額不足や描くのが難しい場合は再送またはキャンセルをしていただけたら幸いです。\n変わったご依頼になりまして恐縮ですが、ご検討いただけますと幸いに存じます", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@washi142356/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2851781, "client_id": 3306146, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95c565a9/uploads/origins/f9df6457-e459-491c-975b-99e2f339a490?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a0e779e6e72686b3c2c5b877d5aeb89", "srcset": "https://si.imgix.net/95c565a9/uploads/origins/f9df6457-e459-491c-975b-99e2f339a490?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a0e779e6e72686b3c2c5b877d5aeb89, https://si.imgix.net/95c565a9/uploads/origins/f9df6457-e459-491c-975b-99e2f339a490?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb5a07053d8f663dcffc5b648165653c 2x, https://si.imgix.net/95c565a9/uploads/origins/f9df6457-e459-491c-975b-99e2f339a490?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b55c4a43974d1aafd1ac5cf2b0b2f122 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95c565a9/uploads/origins/f9df6457-e459-491c-975b-99e2f339a490?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93cd26d8771495df8cad46e350ba0596", "srcset": "https://si.imgix.net/95c565a9/uploads/origins/f9df6457-e459-491c-975b-99e2f339a490?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93cd26d8771495df8cad46e350ba0596, https://si.imgix.net/95c565a9/uploads/origins/f9df6457-e459-491c-975b-99e2f339a490?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6108dcac0bca894576f43988737888d9 2x, https://si.imgix.net/95c565a9/uploads/origins/f9df6457-e459-491c-975b-99e2f339a490?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cbb858d9439e321128caf4366b6f0f48 3x"}, "body": "いい漫画をありがとうございました。\n　もう一本4コマをお願いしたいのと、おまけのラモーヌさんがとてもかわいかったので、同じような感じの描き方で何人かウマ娘をお願いしたいです。\n　4コマの方は、好感度測定器の暴走によってウマ娘からトレーナーへの好感度が完全に可視化されてしまった話。台詞と効果音以外は完全にピンク一色に塗りつぶされてしまっています（キャラなども一切描写なしのピンク一色）。\n　トレーナー室で担当バ達と「これじゃ今日のトレーニングは中止かな」といった話をしていたところ、「緊急！担当バが近くにいる時視界がほぼないトレーナーはすぐに逃げてくれ！強い恋愛感情がなければそうならない！」という放送が流れてきますが、担当バ達は既に色々と準備を終えており……な感じで。\n　トレーナーとの会話中にも服の落ちる音や鍵のかかる音がしています。\n　\n　何人かのウマ娘の方は、4コマ後何かあったあとの感じ。髪型はポニーテール、格好はジャージにブルマ（トレーナーの好きな格好）でお願いします。描く対象はジェンティルドンナ＋メジロラモーヌ＋誰かしらたち（人数・誰にするかはお任せします。ダスカ・ゴルシ・ライトオあたりだと嬉しいです）で。\nこっちで描いた子達が4コマでの担当バたちな感じです。\n\n　胸が大きめかつhttps://skeb.jp/@takkuphones/works/14のようにジッパーが胸の下でつかえてしまっています。それぞれが4コマ時トレーナー室で何があったのかちょっとだけ言及している感じだと嬉しいです。よろしくお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@washi142356/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2851781, "client_id": 3306146, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5385f907/uploads/origins/890f5194-4b50-4a8e-8a51-9166bcb9340d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a22bbd30a926059e99b0198b2af463fe", "srcset": "https://si.imgix.net/5385f907/uploads/origins/890f5194-4b50-4a8e-8a51-9166bcb9340d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a22bbd30a926059e99b0198b2af463fe, https://si.imgix.net/5385f907/uploads/origins/890f5194-4b50-4a8e-8a51-9166bcb9340d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76dad0a64daffbb9ac852d92533600a9 2x, https://si.imgix.net/5385f907/uploads/origins/890f5194-4b50-4a8e-8a51-9166bcb9340d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f23546f42dce873311e6a64a381ead95 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5385f907/uploads/origins/890f5194-4b50-4a8e-8a51-9166bcb9340d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ebfec2b434959b213983e48d3e4c64f", "srcset": "https://si.imgix.net/5385f907/uploads/origins/890f5194-4b50-4a8e-8a51-9166bcb9340d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ebfec2b434959b213983e48d3e4c64f, https://si.imgix.net/5385f907/uploads/origins/890f5194-4b50-4a8e-8a51-9166bcb9340d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0dbf800d9ede335c35e58ae1e6e05955 2x, https://si.imgix.net/5385f907/uploads/origins/890f5194-4b50-4a8e-8a51-9166bcb9340d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69bc97b91a5cb61727d188cb9d19d36c 3x"}, "body": "はじめまして。絵柄がとても好みだったので依頼させてほしいです。\n　ハグしないと出られない部屋に閉じ込められたトレーナー・メジロラモーヌ・ジェンティルドンナの4コマをお願いします。\n　全体的な流れはお任せしますが、「ドンナとラモーヌがハグすればいいのでは？」と無粋なことをトレーナーに言わせてほしいです(余計なことを言った結果、本来ハグだけで終わったはずのところが……)。\n　可能であればドンナとラモーヌの服装は体操着かジャージ、漫画の柱部分にジェンティルドンナの紹介文(顔+「サクランボのヘタ結びをやろうとしたところ、誤ってダイヤ化させたと噂」といったもの)をお願いしたいです。", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@washi142356/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2851781, "client_id": 1643546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c953a990/uploads/origins/f51f4d34-a0a2-42ec-8927-ae9ca54de85e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df33d761067880ecffd90e713a64bb4b", "srcset": "https://si.imgix.net/c953a990/uploads/origins/f51f4d34-a0a2-42ec-8927-ae9ca54de85e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df33d761067880ecffd90e713a64bb4b, https://si.imgix.net/c953a990/uploads/origins/f51f4d34-a0a2-42ec-8927-ae9ca54de85e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b82412a053d867a8d2e5adbcab456e9c 2x, https://si.imgix.net/c953a990/uploads/origins/f51f4d34-a0a2-42ec-8927-ae9ca54de85e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31c1fdf95fc3cc64439bc27b1502beae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c953a990/uploads/origins/f51f4d34-a0a2-42ec-8927-ae9ca54de85e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8873869b09a5bb3dbdf08a5f73ebb9fa", "srcset": "https://si.imgix.net/c953a990/uploads/origins/f51f4d34-a0a2-42ec-8927-ae9ca54de85e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8873869b09a5bb3dbdf08a5f73ebb9fa, https://si.imgix.net/c953a990/uploads/origins/f51f4d34-a0a2-42ec-8927-ae9ca54de85e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d8e2c42ade5c3c0f05cf4a616cc6c941 2x, https://si.imgix.net/c953a990/uploads/origins/f51f4d34-a0a2-42ec-8927-ae9ca54de85e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c3cd379e100bd9781cdc786ff3889551 3x"}, "body": "初めまして。あなたの4コマ漫画が好きで依頼させて頂きました。\n\n今回依頼させて頂きたいのは、オリウマ娘の４コマ漫画です。\n\n①ジャケットの下に少しセクシーな水着を着たスターちゃんがベッドの上で仰向けになりながら寝ている。\n➁それを見たテイオーが、「これはチャンスなのでは？」と考えながらも顔真っ赤にしながら思考している。\n③葛藤後、自分のトレーナーに手を出せないヘタレテイオーは優しく布団をかけてパタパタとその場を立ち去る。\n④少し襲われたかった受けのスターちゃんは「ヘタレ……」と思いながら自分でも攻めれずにもよもよしながら判目でテイオーを見送る。\n\n見た目や設定などは参考資料のURLの「スターゲイザーの設定画」など今までのイラストを見ていただけたら幸いです。\n\nhttps://syosetu.org/?mode=ss_detail&nid=268791\nhttps://syosetu.org/?mode=img_user_gallery&uid=367287\n\nその他指定のない箇所はおまかせいたします。\nセリフや流れ等は描きやすいように変えて頂いて構いません。\n金額不足や描くのが難しい場合は再送またはキャンセルをしていただけたら幸いです。\n変わったご依頼になりまして恐縮ですが、ご検討いただけますと幸いに存じます", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@washi142356/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2851781, "client_id": 1257830, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b9bd4b6/uploads/origins/f2c17907-e754-4e03-beb9-5a6edb5804d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=705a21d173a0bebbc6172b41018708d3", "srcset": "https://si.imgix.net/7b9bd4b6/uploads/origins/f2c17907-e754-4e03-beb9-5a6edb5804d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=705a21d173a0bebbc6172b41018708d3, https://si.imgix.net/7b9bd4b6/uploads/origins/f2c17907-e754-4e03-beb9-5a6edb5804d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e238a00fac593b0f940d23966e0eddca 2x, https://si.imgix.net/7b9bd4b6/uploads/origins/f2c17907-e