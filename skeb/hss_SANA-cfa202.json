みたいです！\n(ドスケベする対象やサナさんの職業(勇者や魔法使い)などはお任せいたします。)", "nc": 184, "word_count": 35318, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@hss_SANA/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cda69826/uploads/origins/79d9afd3-b40c-48ba-b9e1-4a39f38873a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=254ce7f8d7eb39d132c092d156a005af", "srcset": "https://si.imgix.net/cda69826/uploads/origins/79d9afd3-b40c-48ba-b9e1-4a39f38873a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=254ce7f8d7eb39d132c092d156a005af, https://si.imgix.net/cda69826/uploads/origins/79d9afd3-b40c-48ba-b9e1-4a39f38873a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0cd992c9bb65f902615ee1ad6af1fdda 2x, https://si.imgix.net/cda69826/uploads/origins/79d9afd3-b40c-48ba-b9e1-4a39f38873a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=58334a6412419d28e333437facd4ad27 3x"}, "private": true, "genre": "novel", "tipped": false, "creator_id": 3736631, "client_id": 286948, "nc": 48}, {"path": "/@hss_SANA/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 3736631, "client_id": 286948, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1966410661430448128%2FEhhApzUu.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w