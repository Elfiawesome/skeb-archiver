髪をかけている状態でお願いします。\n手を肩にかけるということで顔は近めになると思いますが、顔は近い程良い。\n背景にはこだわりません。家だということすらわからないでよい。暗めの単色に黄色か赤っぽい色で丸をぼかして入れる程度で。なんかハロウィンっぽく。\n\nあとはもうなんかいい感じにお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 120310, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あずまさつき@新刊書店委託してます", "screen_name": "satsuki3506", "avatar_url": "https://pbs.twimg.com/profile_images/2050161786687737856/EzeAp7i0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4345025473/1710928033/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 524172, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ホクトロ@Skeb募集中", "screen_name": "hohohoho64", "avatar_url": "https://pbs.twimg.com/profile_images/2058147145589682176/e2maRBBl.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2489264562/1775750977/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 1381029, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "suzuno", "screen_name": "suzuno3110", "avatar_url": "https://pbs.twimg.com/profile_images/1745636408021434368/kkrfwyqv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1396366491704991753/1771261656/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 