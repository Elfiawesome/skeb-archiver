si.imgix.net/252b2aa9/uploads/origins/590fc59b-578d-4733-85be-9e12cdcab04d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8455876be72b86f5ff434aa3975728ab, https://si.imgix.net/252b2aa9/uploads/origins/590fc59b-578d-4733-85be-9e12cdcab04d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94f7d741e27796702f3d4c14f1bdff22 2x, https://si.imgix.net/252b2aa9/uploads/origins/590fc59b-578d-4733-85be-9e12cdcab04d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1446ae0867cecde772c1116c79f8d3f9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/252b2aa9/uploads/origins/590fc59b-578d-4733-85be-9e12cdcab04d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7250ad51ede82184b4acd10af1906543", "srcset": "https://si.imgix.net/252b2aa9/uploads/origins/590fc59b-578d-4733-85be-9e12cdcab04d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7250ad51ede82184b4acd10af1906543, https://si.imgix.net/252b2aa9/uploads/origins/590fc59b-578d-4733-85be-9e12cdcab04d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f7770ef8b014c6128329b3bb83244fa 2x, https://si.imgix.net/252b2aa9/uploads/origins/590fc59b-578d-4733-85be-9e12cdcab04d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c80ab32f4f4bf25ae3a9bc75e4bde5cd 3x"}, "body": "こんにちは。私は巨大なプリキュアの絵が好きなのですが巨大なましろ（またはキュアプリズム）が小さなそらを抱いたり、抱きしめたりしているところを描いていただけないでしょうか。家とか建物の横に巨大なましろを描いてほしいです。その他、細かいことは何でも結構です。描けないものであれば、それでも構いません。ありがとうございました。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mars_oekaki/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1281515, "client_id": 808233, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0d2719a/uploads/origins/812d5e9c-e458-4cef-92d7-9cdb591f1710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f41551a442ca31e1c61f54ef91e6809", "srcset": "https://si.imgix.net/b0d2719a/uploads/origins/812d5e9c-e458-4cef-92d7-9cdb591f1710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f41551a442ca31e1c61f54ef91e6809, https://si.imgix.net/b0d2719a/uploads/origins/812d5e9c-e458-4cef-92d7-9cdb591f1710?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e38f6bebedb0d1f5a866da0c03f1f6a6 2x, https://si.imgix.net/b0d2719a/uploads/origins/812d5e9c-e458-4cef-92d7-9cdb591f1710?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=feedefcd0981c3a977fb8bc9fbfdc042 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0d2719a/uploads/origins/812d5e9c-e458-4cef-92d7-9cdb591f1710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b2ca04607b06bcfecc60e3e653730ec", "srcset": "https://si.imgix.net/b0d2719a/uploads/origins/812d5e9c-e458-4cef-92d7-9cdb591f1710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b2ca04607b06bcfecc60e3e653730ec, https://si.imgix.net/b0d2719a/uploads/origins/812d5e9c-e458-4cef-92d7-9cdb591f1710?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b38f3a52d2d4f394bcb968c228fa2e12 2x, https://si.imgix.net/b0d2719a/uploads/origins/812d5e9c-e458-4cef-92d7-9cdb591f1710?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4f2308c6b18f200d235c78bc7f634902 3x"}, "body": "はじめまして♪可愛いイラストを描かれているためリクエストさせていただきたいと思います。HUGっと!プリキュアのルールー・アムールと格闘ゲーム、ソウルキャリバーに登場するタリムという女の子を描いてほしいです。服装は資料にあるようにルールーはキュアアムールに変身した状態、タリムは資料にある基本のコスチュームでお願いします。\n\nシチュエーションは二人とも声優さんが田村ゆかりさん繋がりということで二人が自己紹介しあっているシーンでお願いします。差分でルールーは心の中で「私と声が似てる…。」と思っていて、タリムは心の中で「プリキュアだ…。可愛い…♡」という心境でお願いしたいです。ソウルキャリバーは16世紀が舞台の作品ですが、制服やジャージ、メガネなど現代のものも沢山登場するため私の中ではタリムは既にプリキュアを知っているという感じです。\n\n差し支えなければ描いてくださったイラストをTwitterのアイコンやヘッダーにさせていただいたり、スクショやダウンロードをして鑑賞させてくださると嬉しいです。個人的に大好きな二人なのでもしよろしければよろしくお願いいたします。\n\nhttps://twitter.com/Soululkoy2/status/1636478743245127680", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mars_oekaki/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1281515, "client_id": 662576, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bac95a68/uploads/origins/0517602b-0cae-4bcc-ab1c-6968437b5e51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65ed6132768e018ed032b98ca34c43ad", "srcset": "https://si.imgix.net/bac95a68/uploads/origins/0517602b-0cae-4bcc-ab1c-6968437b5e51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65ed6132768e018ed032b98ca34c43ad, https://si.imgix.net/bac95a68/uploads/origins/0517602b-0cae-4bcc-ab1c-6968437b5e51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f71449c0f035b6bb084e4a8eb65f9bfc 2x, https://si.imgix.net/bac95a68/uploads/origins/0517602b-0cae-4bcc-ab1c-6968437b5e51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b360b0b846f46226a778a4b2754aaef4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bac95a68/uploads/origins/0517602b-0cae-4bcc-ab1c-6968437b5e51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ddb081fa513e3e8cb5f45e67f952c7f1", "srcset": "https://si.imgix.net/bac95a68/uploads/origins/0517602b-0cae-4bcc-ab1c-6968437b5e51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ddb081fa513e3e8cb5f45e67f952c7f1, https://si.imgix.net/bac95a68/uploads/origins/0517602b-0cae-4bcc-ab1c-6968437b5e51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=00effd5d2a0323c8050c8725a3091fd0 2x, https://si.imgix.net/bac95a68/uploads/origins/0517602b-0cae-4bcc-ab1c-6968437b5e51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3904cf27241d565247c868e62bdc6376 3x"}, "body": "まーず様ご無沙汰しております\n\n今回もうちの子である柄葉五鈴(つかは いすず)ちゃん系のリクエスト失礼いたします！\n\n今回はコラボイラストではなく\n参考画像にあるような\n胸から上の様々な種類の髪型のまとめ作品です！\n以前に別の方に表情集をお願いしたことがあり、今回はその派生で髪型集というのを是非とも以前にお世話になったまーず様にお願いできればと思いリクエストさせていただきました。\n\n\n理想は参考にある表情集と同じ9種類\n\n①ツインテール(参考画像のようなツインテが好みです！)\n\n②デコだし\n\n③ポニーテール\n\n④サイドテール\n\n⑤ロング\n\n⑥パーマ\n\n⑦プリキュアの姿時の髪型(これだけお手数ですが胸上のをプリキュア姿にしていただけるとたすかりますが、作業量が上がりすぎてしまう場合通常服で問題ありません！)\n\n⑧インカラー(色と髪型はお任せ)\n\n⑨自由枠\n\n\nこれは本当に自由枠なので\nまーず様の好みの髪型ですとか\nロングでもショートでもベリーショートでも髪染めでも\nなんでも構いません！\n髪型詳しくなく約2つ自由枠になってしまいました\n\n\n最後に五鈴ちゃんの肌色は褐色ではなく通常の肌色でお願いします！\nこちらのミスで前回書きそびれ設定資料のままの色になってしまいました！\n表情もお任せします！\n\nhttps://www.dropbox.com/sh/opf781bnz3of459/AAC2J4sDplzSyAl3Stqlmv3Ga?dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mars_oekaki/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1281515, "client_id": 1028705, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4645d72a/uploads/origins/46183acf-7d53-4cb1-b4de-3774831ff992?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b80f052eec3d1f9a3816b772736407df", "srcset": "https://si.imgix.net/4645d72a/uploads/origins/46183acf-7d53-4cb1-b4de-3774831ff992?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b80f052eec3d1f9a3816b772736407df, https://si.imgix.net/4645d72a/uploads/origins/46183acf-7d53-4cb1-b4de-3774831ff992?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d502c59ed87cc21e66bb22c0b0c7a0c8 2x, https://si.imgix.net/4645d72a/uploads/origins/46183acf-7d53-4cb1-b4de-3774831ff992?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&cro