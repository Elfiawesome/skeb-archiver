=200&s=f01edd835ddc4420b8d459339c312150 2x, https://si.imgix.net/c89c3596/uploads/origins/01064cc2-a161-475e-b1d0-7230c321b2b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=392bcb078010fcafbd2167c45a73e101 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c89c3596/uploads/origins/01064cc2-a161-475e-b1d0-7230c321b2b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=327c4008b9ebd2d194df02c854b9c2ff", "srcset": "https://si.imgix.net/c89c3596/uploads/origins/01064cc2-a161-475e-b1d0-7230c321b2b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=327c4008b9ebd2d194df02c854b9c2ff, https://si.imgix.net/c89c3596/uploads/origins/01064cc2-a161-475e-b1d0-7230c321b2b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ea8ff2767ede74d7cc7d520b0301bd3 2x, https://si.imgix.net/c89c3596/uploads/origins/01064cc2-a161-475e-b1d0-7230c321b2b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b2ab53902714de8e1bc785d9c86c1118 3x"}, "body": "ひばりこ様\n\n初めまして、うずらと申します。\nいつも素敵なイラストを拝見しております。\n\nこのたび、もしご縁がありましたら、私とフォロワーがTRPGで使用したキャラクターを描いていただけないでしょうか？\n\n■ご依頼内容・ご希望\nひばりこ様の描かれる色合いや雰囲気がとても好きで、ぜひその世界観でキャラクターを描いていただきたいと考えております。\n構図や雰囲気などはお任せで、自由に描いていただけますと幸いです。（もし指定をした方が良いのであれば二人が幸せそうに笑っている場面などを描いていただけますと嬉しいです…！）\n\n■キャラクター詳細\n\n【A】笹良 紬（ささら つむぎ）\n・男性／21歳／175cm\n・終末世界で唯一生き残った最後の人類。\n・人類を奪還する軍の指揮官。\n・死への恐怖と使命感の間で揺れるが、気丈に振る舞い、指揮官としてやるべきことを全うしている。\n・臆病だがそれを悟らせず、強く頼れる存在であろうとしている。\n\n【B】ヘルスタ\n・女性／159cm\n・アサルトライフルが擬人化した存在。\n・素直で愚直。小柄だが力持ち。\n・一度信頼した相手には深く尽くすタイプで、距離感は近め。例えるなら犬のような性格。\n・真面目で無理をしがち。戦いは本来好まないが、託された使命のために戦っている。\n\n■関係性\n終末世界で戦う軍の「指揮官」と「戦士」という立場で、互いに強い信頼を抱き、かけがえのない存在として支え合っています。\n\n■参考資料\n[キャラクター資料はこちらにまとめております]\nhttps://drive.google.com/drive/folders/1-HNtjbUcNty_D4pJ1FTbXCyGlFv76nwN?usp=drive_link\n\n■使用用途\n・個人鑑賞\n・SNSでの画像投稿（アイコン・ヘッダー等）\n・個人間でのグッズ制作など\n※SNSで使用する際は、プロフィールにひばりこ様のお名前を記載させていただきます。\n\n金額や内容に不都合がございましたら、キャンセルや再依頼などご自由にご判断いただけますと幸いです。ご検討いただけるだけでも大変うれしく思います。何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-HNtjbUcNty_D4pJ1FTbXCyGlFv76nwN?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hiba__riko/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3555555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/febd292b/uploads/origins/73bf678f-f6b7-4dda-ba97-7109f9fc842b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cf138204fe58124b01502d3675b9fd9", "srcset": "https://si.imgix.net/febd292b/uploads/origins/73bf678f-f6b7-4dda-ba97-7109f9fc842b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cf138204fe58124b01502d3675b9fd9, https://si.imgix.net/febd292b/uploads/origins/73bf678f-f6b7-4dda-ba97-7109f9fc842b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=394d844e0e9e1d719e7b4f454722c7fc 2x, https://si.imgix.net/febd292b/uploads/origins/73bf678f-f6b7-4dda-ba97-7109f9fc842b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adf1c075221e863d1194bd32d97c6441 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/febd292b/uploads/origins/73bf678f-f6b7-4dda-ba97-7109f9fc842b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efb2204b921b2120c1d90f21ce09f359", "srcset": "https://si.imgix.net/febd292b/uploads/origins/73bf678f-f6b7-4dda-ba97-7109f9fc842b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efb2204b921b2120c1d90f21ce09f359, https://si.imgix.net/febd292b/uploads/origins/73bf678f-f6b7-4dda-ba97-7109f9fc842b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d3de1cf3b3f511fc3c68a145