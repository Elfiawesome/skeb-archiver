fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=abff71fdfec845ec52e3c0875fbb7082 3x"}, "body": "【イラスト内容】\n一九いちじく・九白みどり両名の、4/28活動1周年を祝っていることがわかる短い文面を入れていただきたいです。\n1枚絵の中にお二人と、お二人への花or花束がいっぱい描かれたものをお願いしたいと思います。色味やテイストの明暗などは、いわゆるママでありますKoyusukeさんに一任したく思います。\n\n【ご挨拶】\n初めまして。skebのシステム上不要とのことでしたが、文字数もありますので少しばかり書かせてください。\n私はKoyusokeさんがキャラデザを担当されました、kirahikaliveの一九いちじくさん、九白みどりさんのファンです。お二人の姿を生み出していただき、ありがとうございます。\n来る4/28のお祝いに、お二人へのお祝いを送りたくリクエストを送らせていただきました。無論、期限はそれを過ぎても異論ないことをここに明言します。\n何分こういったことは初めてですので、不躾がありましたら申し訳ございません。なにとぞよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kygraffiti/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3365079, "client_id": 3309008, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d499aa3/uploads/origins/f2fb98c3-c627-48f7-a146-e4cb9e52d64c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5536eb78b3450b5e1c1bc2d338d8ac9e", "srcset": "https://si.imgix.net/4d499aa3/uploads/origins/f2fb98c3-c627-48f7-a146-e4cb9e52d64c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5536eb78b3450b5e1c1bc2d338d8ac9e, https://si.imgix.net/4d499aa3/uploads/origins/f2fb98c3-c627-48f7-a146-e4cb9e52d64c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6576bfb775012ceabb7ef2a6d70d870c 2x, https://si.imgix.net/4d499aa3/uploads/origins/f2fb98c3-c627-48f7-a146-e4cb9e52d64c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aff50544926923c633a3c7db31d215b0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d499aa3/uploads/origins/f2fb98c3-c627-48f7-a146-e4cb9e52d64c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=018c961e94fa17f9ee3e9b6d6b2ef8e0", "srcset": "https://si.imgix.net/4d499aa3/uploads/origins/f2fb98c3-c627-48f7-a146-e4cb9e52d64c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=018c961e94fa17f9ee3e9b6d6b2ef8e0, https://si.imgix.net/4d499aa3/uploads/origins/f2fb98c3-c627-48f7-a146-e4cb9e52d64c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6acba537a361f2da2a38f7903bc98425 2x, https://si.imgix.net/4d499aa3/uploads/origins/f2fb98c3-c627-48f7-a146-e4cb9e52d64c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7bd000edf640d254d38d1c0bbad015f9 3x"}, "body": "先生、こんにちは。\n私のVtypeキャラクター「七二夜」を描いていただきたく、ご連絡させていただきました。\n彼女は怠惰で賢く、ユーモアがあり、少し狡猾な性格を持つキャラクターです。\n\n先生のデザインが本当に大好きで、ぜひ彼女のテックウェア風の衣装デザインをお願いできればと思い、ご依頼させていただきました。\nスタイリッシュで機能的な雰囲気など、先生のご自由な発想で描いていただけたらとても嬉しいです！\n\nhttps://drive.google.com/drive/folders/1ht8uO8nurConq1N5UMVr-YLzWDsnEHi5?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kygraffiti/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3365079, "client_id": 3766010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a20bdbc/uploads/origins/44c20cd4-db57-4d02-8bdc-da7f8b08b42d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a30045a48ac3060cb0ea1572515d725f", "srcset": "https://si.imgix.net/5a20bdbc/uploads/origins/44c20cd4-db57-4d02-8bdc-da7f8b08b42d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a30045a48ac3060cb0ea1572515d725f, https://si.imgix.net/5a20bdbc/uploads/origins/44c20cd4-db57-4d02-8bdc-da7f8b08b42d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d13d15a5e84a0e7f16febf1871db74fc 2x, https://si.imgix.net/5a20bdbc/uploads/origins/44c20cd4-db57-4d02-8bdc-da7f8b08b42d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85443e4aa9c2278cad28025ad942f65e 3x"}, "duration": null, "nsf