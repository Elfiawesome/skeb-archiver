島にある天然温泉の湯守です。\n\n構図や表情、背景などは自由に創作していただいて構いませんが、できるだけエッチでセクシーな仕上がりにお願いします。 このイラストはSNSやソーシャルメディア、VTuberの活動、コマーシャルなどで使用される予定ですので、可能であればSFW版もご用意いただくと幸いです。また、背景が透明なPNGファイル、またはレイヤーが分離されたPSDファイルもお願いいたします。\n\nご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1juMoQGxz7_BS2AoUGbYwOjsy0iY1BNUf", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@AAAAchiriakuta/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3892558, "client_id": 2699898, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3be9d492/uploads/origins/cf4b8918-a848-428c-b56e-560f6364e549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03ff4f67075f92efafdefcd99f6009f0", "srcset": "https://si.imgix.net/3be9d492/uploads/origins/cf4b8918-a848-428c-b56e-560f6364e549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03ff4f67075f92efafdefcd99f6009f0, https://si.imgix.net/3be9d492/uploads/origins/cf4b8918-a848-428c-b56e-560f6364e549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fbd85afe0b89be90dbb458dd1230818b 2x, https://si.imgix.net/3be9d492/uploads/origins/cf4b8918-a848-428c-b56e-560f6364e549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dbfaad11663021fa67a3ba4dadf238e6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3be9d492/uploads/origins/cf4b8918-a848-428c-b56e-560f6364e549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67d45d29840cb7c86413b9c63b66afe2", "srcset": "https://si.imgix.net/3be9d492/uploads/origins/cf4b8918-a848-428c-b56e-560f6364e549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67d45d29840cb7c86413b9c63b66afe2, https://si.imgix.net/3be9d492/uploads/origins/cf4b8918-a848-428c-b56e-560f6364e549?bg=%23ff