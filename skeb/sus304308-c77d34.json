用予定です。\n\n雰囲気、ポーズはお任せします！\n可能でしたら、\n背景透過PNG、もしくは PSDデータ にて納品いただけますと大変助かります\n（難しい場合はご無理なさらず問題ありません）。\n\nGBVSR新参者でこれから高みを目指していく予定でして、ランクがあがらなくなり・・・かつせ様の描くヴェルサシアで気合いを入れてランクマを回していきたいと思っております！！\n何卒ご検討いただけましたら幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1C6bvVrKlSs1f16OzxZAH65kkLmnI2zIG?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 43766, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "れんとん", "screen_name": "rent_83", "avatar_url": "https://pbs.twimg.com/profile_images/1652644845599731714/iJzXq9uK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2441484204/1760364367/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}], "banned": false, "nc": 177}, {"id": 1008205, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "まほたろう", "screen_name": "MaHoTaRu", "avatar_url": "https://pbs.twimg.com/profile_images/1723462921341292544/13Y9ftXN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/784841415310217216/1709129591/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 16}, {"id": 1401535, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "花鶏", "screen_name": "a__ttori", "avatar_url": "https://pbs.twimg.com/profile_images/1849413422984888320/0SyoDxeL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1408052000089014283/1775206716/1500x500", "appeal_receivabl