h-CEfApEr6tljlO2VzjaQsRrgC-ZlT?usp=share_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jinriki_inu/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 95233, "client_id": 316839, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/186dfe87/uploads/origins/8b4f82ab-5a61-4e57-9405-a1ff9f60a66d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3a8cae35f297d1f2a6ef6930d19a608", "srcset": "https://si.imgix.net/186dfe87/uploads/origins/8b4f82ab-5a61-4e57-9405-a1ff9f60a66d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3a8cae35f297d1f2a6ef6930d19a608, https://si.imgix.net/186dfe87/uploads/origins/8b4f82ab-5a61-4e57-9405-a1ff9f60a66d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=062b4e54875b337c9c5379cfa88ebaaf 2x, https://si.imgix.net/186dfe87/uploads/origins/8b4f82ab-5a61-4e57-9405-a1ff9f60a66d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b5c8ede935766655b96675a9f9358cc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/186dfe87/uploads/origins/8b4f82ab-5a61-4e57-9405-a1ff9f60a66d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69418629537bf8cd6f19c4fb3bbf590e", "srcset": "https://si.imgix.net/186dfe87/uploads/origins/8b4f82ab-5a61-4e57-9405-a1ff9f60a66d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69418629537bf8cd6f19c4fb3bbf590e, https://si.imgix.net/186dfe87/uploads/origins/8b4f82ab-5a61-4e57-9405-a1ff9f60a66d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f7b477d20c53b65f45a0dad3f2a6fd3 2x, https://si.imgix.net/186dfe87/uploads/origins/8b4f82ab-5a61-4e57-9405-a1ff9f60a66d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=865a87110d0089853ee59109bf8669b3 3x"}, "body": "こんにちは、初めまして！　マッチョさと可愛さが両立する絵が好きで、人力犬さんにいつかご依頼したいと思っていました。\n可能でしたら、自キャラの絵をお願いできないでしょうか？\n\n【キャラ資料】\n虎の「秋穂」\n（基本設定等）\nhttps://wa-ryu.net/wp/char/akiho/\nhttps://twitter.com/tigrr_/status/1460970487891181576\n（一般資料）\nhttps://drive.google.com/drive/folders/10OLIvjI4LadiJaszi5xGegKeNYZYxPCR?usp=sharing\n\n【シチュエーション】\nある日、秋穂は遠い親戚の馬獣人のお兄さんに出会う。\nマッチョ好きな秋穂は、お兄さんを拝み倒し、筋肉を触らせてもらって興奮する。\n一方でお兄さんのほうは、照れ／しょうがないなという表情を浮かべる……的なシーンを考えています。\n馬獣人のイラストや設定は特にないのですが、人力犬さんが以前描かれていたメカクレの牡馬くんみたいな感じだと良いな、と思っています。\n\n以上、ご検討いただければ幸いです！！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jinriki_inu/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 95233, "client_id": 3007987, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b663317e/uploads/origins/89e1e1fe-5f8b-4b23-8367-dc60cd237d8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdd4c333e8141516f7e49db3537fefa6", "srcset": "https://si.imgix.net/b663317e/uploads/origins/89e1e1fe-5f8b-4b23-8367-dc60cd237d8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdd4c333e8141516f7e49db3537fefa6, https://si.imgix.net/b663317e/uploads/origins/89e1e1fe-5f8b-4b23-8367-dc60cd237d8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8604a9b07212c11771dc60c2fc6cbdb8 2x, https://si.imgix.net/b663317e/uploads/origins/89e1e1fe-5f8b-4b23-8367-dc60cd237d8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5764647a9a1419e330b1cc88b565915b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b663317e/uploads/origins/89e1e1fe-5f8b-4b23-8367-dc60cd237d8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62f0dd43f05af82bf7a75ef4a6c2c6af", "srcset": "htt