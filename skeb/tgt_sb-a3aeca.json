わからないですが、記載しておきます)\n・ゲーム(FF14、原神)や、音楽が好き\n・趣味は水族館巡り\n・キャラクターのイメージはきつね\n・明るく、誰とでも話せる性格で、たまにPONがある\n・笑いの沸点が低いので配信中は結構笑うことがおおい\n\n以上、ご検討いただけますと幸いです。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1RCI-ahd9kNZOYiH4SfWduk7ps9d3Ow2X?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tgt_sb/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3728215, "client_id": 629365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91c8b139/uploads/origins/138a2265-3fd3-414f-b8d6-f49264223adc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28946d1fcd8f832145fc88420ab00ab4", "srcset": "https://si.imgix.net/91c8b139/uploads/origins/138a2265-3fd3-414f-b8d6-f49264223adc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28946d1fcd8f832145fc88420ab00ab4, https://si.imgix.net/91c8b139/uploads/origins/138a2265-3fd3-414f-b8d6-f49264223adc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=640758bde02f5378f6aa433e8aaceb8b 2x, https://si.imgix.net/91c8b139/uploads/origins/138a2265-3fd3-414f-b8d6-f49264223adc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b74b8bf552790f8f1fc1116ddd2ecb33 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91c8b139/uploads/origins/138a2265-3fd3-414f-b8d6-f49264223adc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00214f2b26bb716f27f059552c8b7952", "srcset": "https://si.imgix.net/91c8b139/uploads/origins/138a2265-3fd3-414f-b8d6-f49264223adc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00214f2b26bb716f27f059552c8b7952, https://si.imgix.net/91c8b139/uploads/origins/138a2265-3fd3-414f-b8d6-f49264223adc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200