ムネイルやSNSなどに使わせて頂きたいと考えております。\n\nhttps://drive.google.com/drive/folders/1Z0UaZCbUq5w_cZJptY52vT_NmedTxSDm?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@niko_msa/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2332522, "client_id": 2288449, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df355fe1/uploads/origins/0f337155-2313-4a7d-9452-01c5d72c39f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd957e9ec7f70767877cbd029ddc9af9", "srcset": "https://si.imgix.net/df355fe1/uploads/origins/0f337155-2313-4a7d-9452-01c5d72c39f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd957e9ec7f70767877cbd029ddc9af9, https://si.imgix.net/df355fe1/uploads/origins/0f337155-2313-4a7d-9452-01c5d72c39f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=591f1ab0a2f08b3ed27f791d98328b07 2x, https://si.imgix.net/df355fe1/uploads/origins/0f337155-2313-4a7d-9452-01c5d72c39f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=232ae746613f40b759ad01c69ecb0361 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df355fe1/uploads/origins/0f337155-2313-4a7d-9452-01c5d72c39f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b88a414d0886a27fb549a22bdb725ef8", "srcset": "https://si.imgix.net/df355fe1/uploads/origins/0f337155-2313-4a7d-9452-01c5d72c39f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b88a414d0886a27fb549a22bdb725ef8, https://si.imgix.net/df355fe1/uploads/origins/0f337155-2313-4a7d-9452-01c5d72c39f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2e15be0707307703bd3b92ca7156a9f1 2x, https://si.imgix.net/df355fe1/uploads/origins/0f337155-2313-4a7d-9452-01c