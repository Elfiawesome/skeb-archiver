るナミとロビンの様子が収められたビデオレター(映像電伝虫の映像)が届けられる。\nそのビデオレターの内容、というシチュエーションのイラストをお願いいたします。\n2人のチャルロスへの呼び方はチャルロス様。\nチャルロスはルフィ達を煽る様な態度\nキャラデザは新世界編の姿で、天竜人の焼印もお願いしたいです。\nもし興味を持たれましたら、制作をお願いいたします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Raski4uf/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3918953, "client_id": 136428, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a0f57c6/uploads/origins/08b0bdb6-e3c0-4ada-a76f-e5b6e508981a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9774f06364198860aa15f11d762ff108", "srcset": "https://si.imgix.net/6a0f57c6/uploads/origins/08b0bdb6-e3c0-4ada-a76f-e5b6e508981a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9774f06364198860aa15f11d762ff108, https://si.imgix.net/6a0f57c6/uploads/origins/08b0bdb6-e3c0-4ada-a76f-e5b6e508981a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d99d6ef77b7ee12061cc1d9a6b225f7 2x, https://si.imgix.net/6a0f57c6/uploads/origins/08b0bdb6-e3c0-4ada-a76f-e5b6e508981a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78a1396c10f11d6e54ec88618d8a611e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a0f57c6/uploads/origins/08b0bdb6-e3c0-4ada-a76f-e5b6e508981a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8a02bf5765fcf58031a501df0ccd455", "srcset": "https://si.imgix.net/6a0f57c6/uploads/origins/08b0bdb6-e3c0-4ada-a76f-e5b6e508981a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8a02bf5765fcf58031a501df0ccd455, https://si.imgix.net/6a0f57c6/uploads/origins/08b0bdb6-e3c0-4ada-a76f-e5b6e508981a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=15cc6354fc672b165585595d684d5db0 2x, https://si.