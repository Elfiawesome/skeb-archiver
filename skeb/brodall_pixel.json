nail_image_urls": {"src": "https://si.imgix.net/2503389c/uploads/origins/d5208ea7-084e-4fb3-a2f3-feb6abbd835f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e96cb268cb068e7d718413fe53881aa", "srcset": "https://si.imgix.net/2503389c/uploads/origins/d5208ea7-084e-4fb3-a2f3-feb6abbd835f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e96cb268cb068e7d718413fe53881aa, https://si.imgix.net/2503389c/uploads/origins/d5208ea7-084e-4fb3-a2f3-feb6abbd835f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3c36ce17dad7b68c1b7c30f79f667e5b 2x, https://si.imgix.net/2503389c/uploads/origins/d5208ea7-084e-4fb3-a2f3-feb6abbd835f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7978cf70a5e6eae3b6f82de8309fbb12 3x"}, "body": "初めまして。以前からぶろだるさんの描かれる絵、作品が大好きで拝見させていただいており、不躾ながらもご依頼したいと思いました次第です。\nご依頼したい内容なのですが、以前描かれていましたドット絵の競泳水着の天子が表情含めとても大好きなので、我儘ですがそのドット絵競泳水着天子の全身版を是非ともお願いしたいです。とっても自分の好きに刺さった天子でしたので…\n詳細な表情、ポーズ等はぶろだるさんのお任せで構いません。\n\nお忙しい中でしたら大変申し訳ありません。よろしければで構いませんのでご一考お願いします！", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@brodall_pixel/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1495114, "client_id": 782133, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ca8588c/uploads/origins/67e1193b-e9d0-4f09-80e5-80dbc2357925?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80fe0281114fd5e0b420c733a6843938", "srcset": "https://si.imgix.net/3ca8588c/uploads/origins/67e1193b-e9d0-4f09-80e5-80dbc2357925?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80fe0281114fd5e0b420c733a6843938, https://si.imgix.net/3ca8588c/uploads/origins/67e1193b-e9d0-4f09-80e5-80dbc2357925?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7403ce09f3667194192afbc5440f6580 2x, https://si.imgix.net/3ca8588c/uploads/origins/67e1193b-e9d0-4f09-80e5-80dbc2357925?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0512480e611793c60f64dc6f238834cc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ca8588c/uploads/origins/67e1193b-e9d0-4f09-80e5-80dbc2357925?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5624e68a9fe5764d0547ccc4c82dd855", "srcset": "https://si.imgix.net/3ca8588c/uploads/origins/67e1193b-e9d0-4f09-80e5-80dbc2357925?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5624e68a9fe5764d0547ccc4c82dd855, https://si.imgix.net/3ca8588c/uploads/origins/67e1193b-e9d0-4f09-80e5-80dbc2357925?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=59484b27813ce5a06af15f505c573405 2x, https://si.imgix.net/3ca8588c/uploads/origins/67e1193b-e9d0-4f09-80e5-80dbc2357925?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=07be04775a5493a55d4a12af68eeab34 3x"}, "body": "東方プロジェクトの八雲紫（道士服）をリクエストします。\n\nポーズに関しては、東方非想天則での『ぶらり廃線下車の旅』発動後に、廃電車が現れる瞬間の腕を振り払ったポーズ風でお願いいたします。\n厳密に元のポーズと同じような構図である必要はなく、おおよそ同じような形であれば自由にアレンジ等を加えてもらって構いません。描く際の視点に関しては細かい要望はありません。\n\n１点だけ叶えていただけると嬉しく思う要望として、髪はロング状態で見える方が好きなので、原作ドットのように髪を束ねた状態ではなくロングのまま上記の構図にしていただけると、より嬉しいです。\n\nそれ以外には特に要望は無く、さまざまな有無含め自由にお任せいたします。\n\n以上です。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@brodall_pixel/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1495114, "client_id": 486358, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb41137f/uploads/origins/510d5e0b-2d6b-4ed4-aa22-9499c0e0098f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cbb803e3542013d44ef0b1f0867ed13", "srcset": "https: