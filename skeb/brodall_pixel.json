outputs/d0c547f4-561a-4344-94e0-b662cd6513fc?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=d1ef6623a520f2bf8cbb5b5c2683d21b, https://si.imgix.net/26237ef7/uploads/outputs/d0c547f4-561a-4344-94e0-b662cd6513fc?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9db8420f0575dc5e515fae931d1cabb 2x, https://si.imgix.net/26237ef7/uploads/outputs/d0c547f4-561a-4344-94e0-b662cd6513fc?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ef09c8c12126df677edaa9b5c33e5fa 3x"}, "duration": 0, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26237ef7/uploads/outputs/d0c547f4-561a-4344-94e0-b662cd6513fc?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=4c91eeea347ee9720a5465d8fd8f15d4", "srcset": "https://si.imgix.net/26237ef7/uploads/outputs/d0c547f4-561a-4344-94e0-b662cd6513fc?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=4c91eeea347ee9720a5465d8fd8f15d4, https://si.imgix.net/26237ef7/uploads/outputs/d0c547f4-561a-4344-94e0-b662cd6513fc?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=783d5c229cfd9352ea2a3be19dfa208a 2x, https://si.imgix.net/26237ef7/uploads/outputs/d0c547f4-561a-4344-94e0-b662cd6513fc?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ff5791a71baa8e5d48c9bfef8e3574a 3x"}, "body": "ぶろだるさんの描くドット絵のサイズ感がとても好みなので依頼したいです。\n\n◆依頼内容\nグール×グーラのマリーカの格ゲー風の待機モーション（ループモーション）\n\n◆依頼補足\nhttps://twitter.com/Epic7buraha/status/1579432489139212288?s=20\nの２枚目のサイズ感や、東方非想天則などのサイズ感が好きなので、同じようなデフォルメ感だと嬉しいです。\n大きなドクロの髪飾りが映えそうなので、向きは１P側（顔が右向き）だと嬉しいです。\n具体的な待機モーションについてはお任せします。\nその他指定の無い事（例えば背景や、格ゲー風ということでそれっぽいUIを付けるなど）もお任せします。\n\nドット絵を繋げてgifアニメに変換したりgifアニメを止めた絵を書き出す方法を知らず、またgifアニメで動いている様子とgifアニメを止めた絵をじっくり眺めたりして鑑賞したいので、「gifアニメと各部分部分のドッド絵を纏めたPSD」をそれぞれご用意頂けると幸いです。\n宛名は有り無し両パターンあると嬉しいです。\n\n◆衣装資料など\n作者のツイッターやHPに幾つか参考となる絵があります。最下部のURL参照\n◇グール×グーラのマリーカ\nグーラ化前、緑髪、肌色に白く欠けた部分（要はハイライト）のある黄緑色の目\n右手側に大きな口の閉じた髪飾り、左手側に小さく口の空いた髪飾り\nhttps://twitter.com/ColorJelly_/status/957973361396662274?s=20\n\n目の書き方や頭身などはご自身の絵柄に合わせて頂けると嬉しいです。\n◇三面図\nhttp://colorjelly.jp/note_snmn.html\n\n◆性格など、参考までに\n努力家で研究者。機転が利き、打算的。\nトラブルがあっても「なんとかなる」と解決してきたのもあり、どちらかというと楽観的\n仲間想いだがいざとなると自分を犠牲にする節がある\n本を読みながら独り言話すタイプ\nネクロマンサーでドクロ型のグッズが好き\n戦闘能力はアンデッド系に対しては強いが、それ以外に対してはめっぽう弱い\n執念深く、頭ごなしに否定される事を嫌う\n主人公との関係は相棒であり共犯者\n主人公の事となると時折少しワガママなところを見せたり、不意にデレるところが凄く可愛い\n口調については体験版序盤など参照\n\n◆公式資料及び作中の表情集や作中セリフなどのまとめ\n\nhttps://min.togetter.com/PnSsvaE", "nc": 129, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 499618, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "すちよこすみいけ", "screen_name": "sumimi_sub", "avatar_url": "https://pbs.twimg.com/profile_images/1642647384344899584/s1xtVTGr.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1006374793099165697/1708272957/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 1}, {"id": 1610011, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Kayoluha🍘skeb募集中", "screen_name": "kayoluhataso", "avatar_url": "https://pbs.twimg.com/profile_images/2004458066851610625/XD2CEfd2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1448946397051453454/1758097452/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 16}, {"id": 2485075, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "BAZA @ご依頼募集中", "screen_name": "BAZA629", "avatar_url": "https://pbs.twimg.com/profile_image