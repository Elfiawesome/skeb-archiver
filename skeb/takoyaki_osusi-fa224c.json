&w=200&h=200&blur=200&s=dd4e5f25c59025b7ff800a6b4a306399 3x"}, "body": "こんにちは、私は先生の作品が本当に好きです！\n私のOCの漫画を依頼したいです。ぜひご検討いただければ幸いです。\nもしご希望の価格に合わない場合は、リクエストの再送をご案内いただけますと幸いです。\n\nhttps://drive.google.com/drive/u/1/folders/12aTFjgWK2XEOK7CAH5WM7IzNaF55VApt\n↑リンク先には3人がいますが、お好きな2人を選んで描いていただければ嬉しいです。もし可能でしたら、3人で描いていただけるとさらに嬉しいです。 ↑\n\nキャラクターの解釈や表現については、先生のご判断でご自由にアレンジしていただいて構いません。\n上記の内容をもとに、自由に制作していただけますと幸いです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takoyaki_osusi/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1331975, "client_id": 3285434, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31b2c05b/uploads/origins/e3f6659d-e7b6-49ef-95d3-a46edf34ddd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=330ec5d6043dd6e6badcb283f5c91c1c", "srcset": "https://si.imgix.net/31b2c05b/uploads/origins/e3f6659d-e7b6-49ef-95d3-a46edf34ddd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=330ec5d6043dd6e6badcb283f5c91c1c, https://si.imgix.net/31b2c05b/uploads/origins/e3f6659d-e7b6-49ef-95d3-a46edf34ddd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf610190c2f1518b46d4680c14ecae70 2x, https://si.imgix.net/31b2c05b/uploads/origins/e3f6659d-e7b6-49ef-95d3-a46edf34ddd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a7b8f371d5f7b040d891fbbbf92237d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31b2c05b/uploads/origins/e3f6659d-e7b6-49ef-95d3-a46edf34ddd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4a3d45138217e9269b04b6fec896388", "srcset": "https://si.imgix.net/31b2c05b/uploads/origins/e3f6659d-e7b6-49ef-95d3-a46edf34ddd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4a3d45138217e9269b04b6fec896388, https://si.imgix.net/31b2c05b/uploads/origins/e3f6659d-e7b6-49ef-95d3-a46edf34ddd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c834742d525dbd9b3ed439afaf8bf30d 2x, https://si.imgix.net/31b2c05b/uploads/origins/e3f6659d-e7b6-49ef-95d3-a46edf34ddd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e1d4d3ac76fd4442975e3c2b985bb5ea 3x"}, "body": "こんにちは、お忙しいところ失礼いたします！先生の画風と作品がとても好きで、ぜひ私のOCたちを漫画で描いていただきたいと思いまして…！\n\nリンク先の衣装から自由にお選びください。衣装の変更も問題ありません。\n\n▼キャラクター設定  \n・眼鏡をかけている方が兄、バンダナをしている方が弟です  \n・二人は兄弟関係かつ恋人同士です  \n・ocコンビは喫茶店を経営しており、営業時間外にこっそり「社会の闇を片付ける」副業を持っている。\n\n【兄：179cm/26歳】\n喫茶店のオーナー。変装が得意で、仕事中はいつもおちゃめで優しい顔をしている。キツネのような笑顔をよく見せる。\n副業が終わるといつも暗い笑顔を見せる。\n\n【弟：187cm/22歳】\n職業は喫茶店のシェフ。料理を作るのが得意。穏やかでいつも無表情な性格で、人とコミュニケーションを取ることはほとんどなく、人付き合いも苦手。\n副業の時は事件現場の後処理を担当することが多い。\n\nキャラクターの性格を読んだ上で、自由に描いていただければと思います。\n\n私の出す金額が低すぎる場合は、リクエストを再送してください。もしよろしければ、リクエストを受け入れていただけると幸いです。\n最後までお読みいただき、本当にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1DDSgUG2jVEvFO7kr5g3Cw1fEtIXjyHxO", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takoyaki_osusi/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1331975, "client_id": 3527041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/165dbc15/uploads/origins/ccbc850e-5fe9-43be-b38e-07eecd714023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6192da950472e7980e370a2f96d60b3", "srcset": "https://si.imgix.net/165dbc15/uploads/origins/ccbc850e-5fe9-43be-b38e-07eecd714023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6192da950472e7980e370a2f96d60b3, https://si.imgix.net/165dbc15/uploads/origins/ccbc850e-5fe9-43be-b38e-07eecd714023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c777930905080151740e9ecf1eeee00d 2x, https://si.imgix.net/165dbc15/uploads/origins/ccbc850e-5fe9-43be-b38e-07eecd714023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17cddec000c90e99d51103ee3b8f57d0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/165dbc15/uploads/origins/ccbc850e-5fe9-43be-b38e-07eecd714023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a892ccceb025855d6c509304e6b0fc8", "srcset": "https://si.imgix.net/165dbc15/uploads/origins/ccbc850e-5fe9-43be-b38e-07eecd714023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a892ccceb025855d6c509304e6b0fc8, https://si.imgix.net/165dbc15/uploads/origins/ccbc850e-5fe9-43be-b38e-07eecd714023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=358bd12de1abb55c74a6c1d955c6b69e 2x, https://si.imgix.net/165dbc15/uploads/origins/ccbc850e-5fe9-43be-b38e-07eecd714023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=97aeb73ec043721234637ca3a478daa6 3x"}, "body": "先生、こんにちは！\n私のCPを描いてくれませんか？\n\n◆コスモ（黒髪）\n・突拍子もない発言や予想外の行動が多く、周囲から少し浮きがち\n・眉毛がなく、しょっちゅうケガをしている\n・平然と意味のない嘘を吐くタイプ。たまに本当のことも混ぜるので、何が本音なのか分かりづらい\n\n◇アーシャ（金髪）\n・人当たりが良くフレンドリー\n・内面に葛藤を抱えているが、本当の自分をなかなか見せられない\n・人を喜ばせるために嘘を吐くタイプ。時々、自分のために嘘を吐くこともある\n\n二人は同学年の高校生で、関係性としては「嘘つき×嘘つき」の同軸リバです。\n両片思いではあるものの、本心と向き合うのが苦手な二人なので、ものすご～～～く遠回りをする関係です。\n冗談っぽくイチャイチャしたり、お互いをからかったりするのが好きです。\n\n好きなものを自由に描いてください！どんなコーディネートや構図でも大丈夫です！\n\nhttps://drive.google.com/drive/folders/1quxP_uRrJ9IZXPsQ6eGMgFkAR2UOYASj?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takoyaki_osusi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1331975, "client_id": 667554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3f152b4/uploads/origins/2f37decd-74fb-4920-