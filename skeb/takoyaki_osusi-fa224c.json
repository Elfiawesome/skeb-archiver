=2&fit=crop&crop=top&w=200&h=200&s=87f415023d03666cc72ab6f9260c4330 2x, https://si.imgix.net/75ccc8a8/uploads/origins/a905aadc-ab54-409b-b45a-20d7f0523a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b9772ba57503858fca20294f1cc8048 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75ccc8a8/uploads/origins/a905aadc-ab54-409b-b45a-20d7f0523a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ad93a35b27f4168db3f5f3156eab6ec", "srcset": "https://si.imgix.net/75ccc8a8/uploads/origins/a905aadc-ab54-409b-b45a-20d7f0523a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ad93a35b27f4168db3f5f3156eab6ec, https://si.imgix.net/75ccc8a8/uploads/origins/a905aadc-ab54-409b-b45a-20d7f0523a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c05e52341b309a69f2b245dd94d4610 2x, https://si.imgix.net/75ccc8a8/uploads/origins/a905aadc-ab54-409b-b45a-20d7f0523a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6eab67724a68c1841909a8807070f0c 3x"}, "body": "ﾂﾅﾏｻ🌊様\n\n初めまして、リクエスト失礼致します！ \n先生の作品がすごく好きです、もしよろしければオリキャラ二人のイラストを描いていただきたいです。\n\nキャラクターの詳細な設定については、こちらのURLからご確認いただければと思います。複数パロ（全部読む必要はありませんので直感で選んで下さっても構いません！）があるのですが資料の中からご自由に選んでいただいて構いません。\nキャラクターの印象や関係性に基づいて、自由に描いていただければと思います。\n\n没ラフや下描きなどがあれば残したままにしていただけると嬉しいです。不備な点がございましたら、お気軽にキャンセルまたは再送依頼のご対応をしてくださればと思います。\n\n依頼を読んでいただき、ありがとうございました...！ご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1yID4wMXL1ySAJGWPAfWfWcue68Q1RXW0?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takoyaki_osusi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1331975, "client_id": 667554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d550ff2c/uploads/origins/137ad477-e2e7-47b7-839c-15d082b95505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8dadcc10d94cd4f13568de50cc2e03ca", "srcset": "https://si.imgix.net/d550ff2c/uploads/origins/137ad477-e2e7-47b7-839c-15d082b95505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8dadcc10d94cd4f13568de50cc2e03ca, https://si.imgix.net/d550ff2c/uploads/origins/137ad477-e2e7-47b7-839c-15d082b95505?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04b74e653c4b865fc1ac2e2636d0578d 2x, https://si.imgix.net/d550ff2c/uploads/origins/137ad477-e2e7-47b7-839c-15d082b95505?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb59623b4fbcc01f36dd8e08f076b2e2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d550ff2c/uploads/origins/137ad477-e2e7-47b7-839c-15d082b95505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8764695db28f653738f45abb9e555cd", "srcset": "https://si.imgix.net/d550ff2c/uploads/origins/137ad477-e2e7-47b7-839c-15d082b95505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8764695db28f653738f45abb9e555cd, https://si.imgix.net/d550ff2c/uploads/origins/137ad477-e2e7-47b7-839c-15d082b95505?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e4c090fa0e40f416230074bc4e7ce9be 2x, https://si.imgix.net/d550ff2c/uploads/origins/137ad477-e2e7-47b7-839c-15d082b95505?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f41e59908817bab94112e1454eee8bce 3x"}, "body": "こんにちは、ツナマサさん！何度もお願いして申し訳ありません。お騒がせしましたら、お許しください。ツナマサさんのイラストがとても好きなので、カジノにいる2匹のオーク（ブランケとサイド）のイラストを描いていただけたらと思います。\n参考リンク： https://sta.sh/22f2fgmu0xjx\n\n-キャラクターについて\nブランケ（茶色）：無表情なマフィアのリーダー。身長は190cm。\nサイド（ブロンド）：ブランケの部下で、普段は真剣な表情をしている。身長は158cm。\n\n-プロットについて\nサイドはカジノに潜入しており、ブランケはカジノにやってきたマフィアのリーダーである。破壊や銃撃の準備の過程は、あなた次第で描くことができます！自由に描いてください！ルーレット、ポーカー、サイコロなど、カジノにまつわる要素を追加することができます。\n*ブランケの服装は、フォーマルスーツ、サイドウェアのカジノコスチュームなど、自由に描いてください。\n\nツナマサさんが私の要望を受け入れてくれることを願っています。もし、不適切だと感じたら、この依頼をキャンセルしてもかまいません。ありがとうございました！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takoyaki_osusi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1331975, "client_id": 667554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8928fd1d/uploads/origins/24020901-f180-4072-be72-9fbb6fa7f536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66e6a9fdf225751143eee8f4872b1347", "srcset": "https://si.imgix.net/8928fd1d/uploads/origins/24020901-f180-4072-be72-9fbb6fa7f536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66e6a9fdf225751143eee8f4872b1347, https://si.imgix.net/8928fd1d/uploads/origins/24020901-f180-4072-be72-9fbb6fa7f536?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68dd0aa812555fc12fc5662e55fdab57 2x, https://si.imgix.net/8928fd1d/uploads/origins/24020901-f180-4072-be72-9fbb6fa7f536?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ba9931df28238d67682d8a2b184d2f7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8928fd1d/uploads/origins/24020901-f180-4072-be72-9fbb6fa7f536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0c16583875d005e929d8613f28cce24", "srcset": "https://si.imgix.net/8928fd1d/uploads/origins/24020901-f180-4072-be72-9fbb6fa7f536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0c16583875d005e929d8613f28cce24, https://si.imgix.net/8928fd1d/uploads/origins/24020901-f180-4072-be72-9fbb6fa7f536?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b84856cd9f5326ac408e9417b13fc72 2x, https://si.imgix.net/8928fd1d/uploads/origins/24020901-f180-4072-be72-9fbb6fa7f536?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c246d24c36db463b5832b6af0bb5b8ad 3x"}, "body": "こんにちは、ツナマサ🌊さん！ツナサさんのイラストが大好きなので、私のOC(ブランケ＆サイド)のイラストを描いていただけたらと思います。\n参考：https://sta.sh/21uovyw07ads\n\n-キャラクター\nBlanke(190cm)：マフィアのリーダー。普段は無表情だが、愛情表現の仕方は非常に直接的。デザートを食べたり、猫で遊んだり、サイドをからかったりと、子供っぽい行動をとることもある。\nサイド（158cm）：リーダー格の部下。ツンデレで、普段は真面目な表情をしている。感情の表現がとても繊細で、ブランケに近づきすぎると緊張してしまう。\n\n-リクエスト\n車（サイドが運転手、ブランケがその隣に座る）に乗って、海辺をドライブしているところを見てみたい。\n具体的な雰囲気としては、このイラストのアメリカンな雰囲気が好きです。リンク先の「雰囲気」をご参照ください。\n\n不適切と感じたら、この依頼をキャンセルしても構いません。ご検討、本当にありがとうございました", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takoyaki_osusi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1331975, "client_id": 187973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d414123/uploads/origins/85147902-2635-4c1c-b1c2-3c3bf9566b2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1a6396b39bc71eb9e749e28192f8747", "srcset": "https://si.imgix.net/4d414123/uploads/origins/85147902-2635-4c1c-b1c2-3c3bf9566b2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1a6396b39bc71eb9e749e28192f8747, https://si.imgix.net/4d414123/uploads/origins/85147902-2635-4c1c-b1c2-3c3bf9566b2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=648029b57ac6b65d9d5fa5cb785fe432 2x, https://si.imgix.net/4d414123/uploads/origins/85147902-2635-4c1c-b1c2-3c3bf9566b2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12a11b056619ce7ac8d3a238d918484e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d414123/uploads/origins/85147902-2635-4c1c-b1c2-3c3bf9566b2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd4b198f304b62af79ee63685206c7cb", "srcset": "https://si.imgix.net/4d414123/uploads/origins/85147902-2635-4c1c-b1c2-3c3bf9566b2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd4b198f304b62af79ee63685206c7cb, https://si.imgix.net/4d414123/uploads/origins/85147902-2635-4c1c-b1c2-3c3bf9566b2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=44397a13346aba28d9b8aa8fb94c15c4 2x, https://si.imgix.net/4d414123/uploads/origins/85147902-2635-4c1c-b1c2-3c3bf9566b2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=32bf26bef7dca06835dac9c003bc1bf0 3x"}, "body": "よろしくお願いします！\n\nこの2人のキャラクターのイラストを描いていただけませんか？\n二人は一緒に魔女と魔法使いのための魔法学校に通っています。学校は中世のお城のようなスタイルです。\nファンタジーがテーマです（しゃべる植物、飛ぶ本、飛ぶほうき、動く絵、空想上の生き物、動く羽ペン、呪文書、ふくろう、猫、コウモリ、かぼちゃなど）。\n\nアロイス金髪の少年。トラブルメーカー、ミスフィットタイプ。いたずら好きで気が強い。趣味：スケッチ、ロックミュージック。\nゲイブ。茶髪。自信家、フレンドリー、アロイスをからかうのが好き。宇宙船と科学が好き。いつか宇宙船を設計したいそうです。\n\n2人の関係は、ゲイブが人気者で、不適合者のアロイスを驚かせ、仲良くなろうとするものです。\n\nポーズの例としては、以下のようなものがあります：\n- ゲイブがアロイスの勉強を手伝っている\n- ゲイブとアロイスが一緒に箒でお城の上を飛んでいるところ\n- ゲイブとアロイスが一緒に魔法薬を作っている。\n- その他、お好きなポーズをお選びください。\n\nこのリクエストを読んでいただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1aijBfN9Jila_sth9TnmhdCSuzLHHwOaj?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takoyaki_osusi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1331975, "client_id": 210632, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fdb41f66/uploads/origins/7e100386-5b85-4e5b-830a-31598e78b83e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d55353df4c0bf67f3c132cdf4fa082bf", "srcset": "https://si.imgix.net/fdb41f66/uploads/origins/7e100386-5b85-4e5b-830a-31598e78b83e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d55353df4c0bf67f3c13