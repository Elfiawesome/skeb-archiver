-eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%8F%E3%83%84%E3%83%A6%E3%82%AD%E3%82%BD%E3%82%A6", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@z59730671/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1160755, "client_id": 3200509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08f438fe/uploads/origins/67af1fe1-fdcc-49d7-984c-5debf9dae6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=340448b33b957e947bd97306a856f808", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08f438fe/uploads/origins/67af1fe1-fdcc-49d7-984c-5debf9dae6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d419c42f0f3a11b56f73a9eae91f800", "src_set": ""}, "body": "こんにちは！個人Vtuberのももてんと申します。\nガネットさんの描かれる可愛いイラストが大好きなので、ご縁をいただけましたら私ももてんのイラストを描いていただきたいです！！\n\n▼キャラクター\n下記の資料をご参照ください。\nhttps://drive.google.com/drive/u/2/folders/1SNVJCbWx5XJKqx4jWAWQl-6M3BFcaHNb\n\n美少女ゲームが大好きで、よく笑いよく驚く、リアクションが大きい表情豊かな女の子です。\n身長は150センチ程度であまり高くありません。\n\n▼リクエスト内容\n服装は参考資料の夏服衣装でお願いいたします。\n構図やシチュエーションはガネットさんにお任せいたします！\nちょっと幼いイメージで描いていただけると嬉しいです～！\n\n▼使用用途\nYouTubeのサムネイル、XなどのSNSでの使用を予定しています。\n商用利用の予定はございません。\n\n▼納品形式\nPSD形式でお願いいたします。\nキャラと背景のレイヤーデータは分けていただけると嬉しいです。\n\n▼その他\nyoutube：https://www.youtube.com/c/momotenchannel\nX:https://twitter.com/momoten_channel\n\nお忙しいかと存じますが、ご縁がありましたらリクエストを受けていただけると嬉しいです！\n何卒よろしくお願いいたします！", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 6704, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "兎福もに@絵仕事募集中", "screen_name": "Nonisakuhana222", "avatar_url": "https://pbs.twimg.com/profile_images/1860259077697449984/SH_f9SZ4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3186037141/1758110721/1500x500