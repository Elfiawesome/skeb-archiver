e-4787-93cd-f8cddf48243e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0da68951bbcf03ef74a415723f4f6662", "srcset": "https://si.imgix.net/7928fe54/uploads/origins/5019d363-1c9e-4787-93cd-f8cddf48243e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0da68951bbcf03ef74a415723f4f6662, https://si.imgix.net/7928fe54/uploads/origins/5019d363-1c9e-4787-93cd-f8cddf48243e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8735965a6def3247b580510dbdbb4be7 2x, https://si.imgix.net/7928fe54/uploads/origins/5019d363-1c9e-4787-93cd-f8cddf48243e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=871085cb1d903009f5a3d578a12036b6 3x"}, "body": "何時もお世話になっております。\n今回はいづきち絵師さまの美麗なイラストで、もう一度うちのキャラクターであるユメの姿を見たいと思ってリクエストをさせて頂いております。\n\nご縁がありましたらどうぞ宜しくお願い致します。\n\n\n・キャラ\n以前、お願いしましたキャラクター、ユメ・キリハナです。\n赤い髪、赤い瞳の吸血鬼のお嬢様。\n優雅さを感じられる美しさだと大変嬉しいです。\n\n・表情\nクールビューティーな雰囲気。\n流し目で、微笑みを浮かべさせて頂けるととても嬉しいです。\n\n\n・描写範囲や背景\n描写範囲は腰の上かあたりから。\n背景はなしや簡易で大丈夫です。いづきち絵師さまの描かれたキャラを見たい、というのが本音ですので。\n\n\n姿、衣装などは以前のイラストの際のものを。\nアレンジや変更などはあると嬉しいものの、いづきち絵師さまの好きにして頂けると幸いです。(元に囚われず、いづきち絵師さまの好きに描いてください)\n\n不明瞭点や矛盾点がありましたら、いづきち絵師さまのご判断にお任せ致します。\n\nだいぶお任せが多めとなってしまっておりますが、ご縁がありましたらどうか宜しくお願い致します。\n\nhttps://skeb.jp/requests/1708013", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@registreriva/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1268657, "client_id": 2703502, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c269e7a/uploads/origins/df8bc5a2-7114-43aa-b42f-7cbb48d6b8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ebd2632eeea16419802d1d6edc7f6e1", "srcset": "https://si.imgix.net/6c269e7a/uploads/origins/df8bc5a2-7114-43aa-b42f-7cbb48d6b8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ebd2632eeea16419802d1d6edc7f6e1, https://si.imgix.net/6c269e7a/uploads/origins/df8bc5a2-7114-43aa-b42f-7cbb48d6b8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed491ac8a70932fa4b69635e2fbe8459 2x, https://si.imgix.net/6c269e7a/uploads/origins/df8bc5a2-7114-43aa-b42f-7cbb48d6b8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f853a19a4b5d6d3295d3865b8b07c5a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c269e7a/uploads/origins/df8bc5a2-7114-43aa-b42f-7cbb48d6b8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe9a716fe3a9147e2cbb4370b0907ba1", "srcset": "https://si.imgix.net/6c269e7a/uploads/origins/df8bc5a2-7114-43aa-b42f-7cbb48d6b8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe9a716fe3a9147e2cbb4370b0907ba1, https://si.imgix.net/6c269e7a/uploads/origins/df8bc5a2-7114-43aa-b42f-7cbb48d6b8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=19b0c1565e51bb0835882e2332704e67 2x, https://si.imgix.net/6c269e7a/uploads/origins/df8bc5a2-7114-43aa-b42f-7cbb48d6b8fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b0a82dc304065d0dec57ddae8611b15c 3x"}, "body": "何時も美麗で素敵なイラストを拝見させて頂いております\n私の一次創作で使いたい、というキャラクターの全身イラストをリクエストさせて頂いています\nどうかご検討をお願い致します\nアレンジやアドリブ等は歓迎で、いづきち絵師さまのセンスや感性、好きを重視して描いて頂ければ嬉しいです\n綺麗で、かつ妖艶な吸血鬼の雰囲気にして頂ければと\nただし、露出が過ぎる(横乳など)がお好きではない場合はなくして頂いて構いません\n\n【キャラクター】\n・ユメ\n吸血鬼の貴族のお嬢様\n和風が好きな、和風ファンタジー系でのと\n\n【全体イメージ】\nクールビューティー風の、美しい貴族の令嬢めいた女性\n凛としつつも微笑みや優雅さを常にと\nただ、少しの妖艶さがあると嬉しく思いますっ\n\n【キャラ】\nクールビューティーで、優雅な令嬢風に\n\n髪の毛はさらりとした質感の赤い髪\nロングストレートで腰の下あたりまで長く伸ばして\n\n瞳もまた赤い色彩\n\nスタイルは細身でスレンダー\nただし胸は大きめに、強調して頂けると嬉しいです\n\n【衣装等】\n改造巫女服めいたデザイン\n全体的に和風ファンタジー風\n舞踏を躍る為にと軽やかなイメージ\n上は肩を出すようなホルターネック式のものにして、肩やちらりと横乳などが窺えるように\n(※ただ、横乳などがお嫌いでしたら削って頂いて構いません。妖艶さはテイストで、綺麗さ重視です)\n\n装飾として赤い花、シャクナゲを模した髪飾りを\n\n腰は帯で止めつつ、下は片側にスリットの深く入った袴を\nスリットは深く、ふとももなど魅せられるように\nただし足には黒いタイツを履かせて頂いて、深いスリットでも安心な設計で\n\n改造巫女服での全身イラスト\n和風ファンタジーといった、綺麗な雰囲気と方向性でお願いしますっ\n\n靴はお任せさせて頂けると嬉しいです……\n\n【ボーズ等】\n基本的にポーズはお任せ\n綺麗さと丁寧さ、お嬢様風にとして頂けば\n\nただ袖や裾などは靡かせて頂けるととても嬉しいです\n\n\n【背景等】\n基本的になくて構いません\nいづきち絵師さまの負担となるのでしたら、透過や白背景で大丈夫です\nただ見栄えとしてあった方がというのでしたら、甘えさせて頂けると嬉しく……(本当にいづきち絵師さまの負担や描きやすさ重視でお願いします)", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@registreriva/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1268657, "client_id": 884668, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/10b34869/uploads/origins/b1195872-0081-4248-8a32-f6c6f143b8ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20be801577e38296cadb385b8792db17", "srcset": "https://si.imgix.net/10b34869/uploads/origins/b1195872-0081-4248-8a32-f6c6f143b8ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20be801577e38296cadb385b8792db17, https://si.imgix.net/10b34869/uploads/origins/b1195872-0081-4248-8a32-f6c6f143b8ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34fdbbe4ccc9a2059a9c00b869556964 2x, https://si.imgix.net/10b34869/uploads/origins/b1195872-0081-4248-8a32-f6c6f143b8ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ac09e5c4244c571d3b7d653f495fb32 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10b34869/uploads/origins/b1195872-0081-4248-8a32-f6c6f143b8ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0bf4e60d04bd014cbd2fe302bdd4000f", "srcset": "https://si.imgix.net/10b34869/uploads/origins/b1195872-0081-4248-8a32-f6c6f143b8ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0bf4e60d04bd014cbd2fe302bdd4000f, https://si.imgix.net/10b