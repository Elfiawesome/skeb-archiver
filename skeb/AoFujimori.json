auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7a9b66a640046e3b56f15bc3f28ad15", "src_set": ""}, "body": "こんにちは、はじめまして。\n先生のご作品を以前より拝見しており、いつも心惹かれております。\nこのたび、ご縁がありましたら、ぜひイラストをお願いしたくリクエストを送らせていただきました。\n\n構図やポーズ、背景などの詳細は、すべて先生のご判断にお任せいたします。\n作品は個人での鑑賞およびSNSでの使用を目的としており、商用利用は一切いたしません。\n\nご多忙のところ恐縮ではございますが、\nご検討いただけましたら幸いです。何卒よろしくお願い申し上げます🙇‍♀️\n\nhttps://drive.google.com/drive/folders/1Ezb2BumEF57cUSDAYn1PgxK-lb3rfMWa?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AoFujimori/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 8589, "client_id": 3620825, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/554d32ee/uploads/origins/f77a418b-3065-4b8b-bf46-04d2f462496c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be49dcb85ca5d8c8d10eccff7646fc14", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/554d32ee/uploads/origins/f77a418b-3065-4b8b-bf46-04d2f462496c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb8d36b3dda80734af158965ef72cf78", "src_set": ""}, "body": "AOさん、はじめまして。\n私はAOさんの作品が本当に大好きな韓国のファンです。Miliの楽曲に使われたイラストから個人作品まで、心から感動しています。（特に「Space Colony」と「Rubber Human」に使用されたイラストが大好きです。）\nSkebというサイトを今回初めて知り、AOさんにイラストを依頼できることになり、とても嬉しく思っています！\n\nこの度は、私のオリジナルキャラクター（OC）を描いていただけたらと思います。\nこちらのキャラクターは、ゲーム『マビノギ』の私のアバターを元に、自分で設定を考えたオリジナルキャラクターです。\n\nキャラクターの外見や設定については、以下のリンクにまとめております：\n[https://drive.google.com/drive/folders/1p_NNPIHLmelb0gFTZEqF1N7s-qEFUvIl?usp=drive_link]\n（ご自由にアレンジしていただいて構いません）\n\n自由な構図・シチュエーションで大丈夫です。すべてお任せいたします。\n※本依頼は個人鑑賞用です。\n\nそれでは、どうぞよろしくお願いいたします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AoFujimori/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 8589, "client_id": 2554850, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9947a563/uploads/origins/dbcfbd67-755f-4a67-ad1e-63ca62756fcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36c1436d5b891fa3b570caf0091e6973", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9947a563/uploads/origins/dbcfbd67-755f-4a67-ad1e-63ca62756fcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b70f0765888987bb5ad976d0e4c0ffd", "src_set": ""}, "body": "こんにちはこんにちは～～～miliで数年前からあなたの作品を見ていたので、リクエストを出せるのがとても楽しみです！これで大丈夫だといいのですが！もし値段の調整が必要でしたら、遠慮なく直してください^_^。\nOCです：\n[Aeneas] https://imgur.com/a/LdVOgx4\nエネアスは楽園のビジョンを持つ天使の司祭ですが、彼は彼の人々のためにベストを尽くしていないので、彼には暗い面があります。\nRTRTのmiliのビデオであなたが描いたキッチンの構図がとても気に入っています！\nご配慮、本当にありがとうございました！お元気でお過ごしでしょうか^_^？", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AoFujimori/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/796df90b/uploads/origins/94b80fd4-7496-47ed-9d8d-4cee5270d88e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=16508e1e032a1b161c1f5a2c8d60092d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 8589, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@AoFujimori/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5344a480/uploads/origins/951916e8-f594-4cc6-b01a-47252bdf6108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=m