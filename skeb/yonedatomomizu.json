f0e1547-c468-4882-8be3-25d6a075c459?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b970e6e4fa32e31570da7e9fb2c77963", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2619753, "client_id": 3224659, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yonedatomomizu/works/111", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2619753, "client_id": 811098, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66db5b22/uploads/origins/7c82b6c4-215c-4ba6-a6f9-e7c7eb2ddba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63f602e8fad1884ed6f987f5925662f0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66db5b22/uploads/origins/7c82b6c4-215c-4ba6-a6f9-e7c7eb2ddba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65f917a3beb0a333b3f6a300267c55f1", "src_set": ""}, "body": "こんにちは\n私はあなたのユーモラスな絵のファンです。\n私のサメの女の子のOCを描いてほしいです。\n\n左頬にほくろがある、陽気なおてんば娘です。\n釣りのルアーをピアスにしている。\nちょっと間抜けで、人というよりサメのように振る舞うこともある。\n背中に背びれがある。\n尾の付け根近くに2つの小さなヒレがある。\n尾びれの上下に2つの小さなひれがある。\n両前腕にひれがある\n身長168cm\n\nシナリオは、参考フォルダにある「000」という名前の画像に似ていて、サメの女の子が額縁を持っている。\n背景はトロピカルアイランドのビーチ\n額縁の中身は、特に面白ければ何でもOK。\n額縁の中の写真には、私の友人のキャラクターを使っても構いません。\n額縁は変更可能です。\n\n好きな画像を簡単に入れられるように、フォトフレームに透過性を持たせることもできますか？\n\nご不明な点や間違っている点がございましたら、お気軽に再送をご依頼ください。\n\nありがとうございました、\n\nhttps://drive.google.com/drive/folders/1v7DsH2FJlK363z_qJ_mIkGdtegxQUXaw?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yonedatomomizu/works/110", "