c50a26d2-796d-417b-8b99-05c1c1774dc0?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf60fba793b98347c74755b9faaa8525 2x, https://si.imgix.net/9617f7c9/uploads/outputs/c50a26d2-796d-417b-8b99-05c1c1774dc0?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5a288c4d4f4cec8fdd9d33d6773fd67 3x"}, "duration": 14, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9617f7c9/uploads/outputs/c50a26d2-796d-417b-8b99-05c1c1774dc0?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=c7f0bc81c3716990244f68b394be9f3f", "srcset": "https://si.imgix.net/9617f7c9/uploads/outputs/c50a26d2-796d-417b-8b99-05c1c1774dc0?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=c7f0bc81c3716990244f68b394be9f3f, https://si.imgix.net/9617f7c9/uploads/outputs/c50a26d2-796d-417b-8b99-05c1c1774dc0?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=040fef28fa034e75aeafc521c05a0f4e 2x, https://si.imgix.net/9617f7c9/uploads/outputs/c50a26d2-796d-417b-8b99-05c1c1774dc0?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f47a2d319527fe88fa93ba2a59294616 3x"}, "body": "以前作ってくれたアート、すごく気に入りました！本当に素晴らしかったです！今度は動画作品でどんなものを作ってくれるのか、ぜひ見てみたいです！キャラクターは前回と同じでお願いします！彼は凍った飲み物と人間のハーフで、とても友好的で陽気な性格です。日差しの強いビーチも寒い冬も大好きで、どちらの季節でも冷たいスイーツを楽しんでいます。カードゲームやシュールなビデオゲームも大好きです！彼をどう描いてくれるのか、楽しみにしています！ご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1D1nroBMB3OAbdpWURujvrbaAutRhtKG0?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@Izuruha_uno/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2237055, "client_id": 3520606, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b92561a/uploads/origins/e39ff60b-24d6-4b28-b969-7bc800fe4fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1d34fa5b54155dc61215a50594cd882", "srcset": "https://si.imgix.net/8b92561a/uploads/origins/e39ff60b-24d6-4b28-b969-7bc800fe4fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1d34fa5b54155dc61215a50594cd882, https://si.imgix.net/8b92561a/uploads/origins/e39ff60b-24d6-4b28-b969-7bc800fe4fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5fdcfd82e1fe2d5c364e097cd93745d3 2x, https://si.imgix.net/8b92561a/uploads/origins/e39ff60b-24d6-4b28-b969-7bc800fe4fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9d70e6bbda00e9b6fc99b19a9d16ff3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b92561a/uploads/origins/e39ff60b-24d6-4b28-b969-7bc800fe4fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=76a45897d74316349d57bcdd4f83abc1", "srcset": "https://si.imgix.net/8b92561a/uploads/origins/e39ff60b-24d6-4b28-b969-7bc800fe4fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=76a45897d74316349d57bcdd4f83abc1, https://si.imgix.net/8b92561a/uploads/origins/e39ff60b-24d6-4b28-b969-7bc800fe4fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd8740b7101ad8e2d7f8f3f60e0c6fef 2x, https://si.imgix.net/8b92561a/uploads/origins/e39ff60b-24d6-4b28-b969-7bc800fe4fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69bc6fa5f2164d038719f4f83e6896d9 3x"}, "body": "越口 ふまり様、初めまして！\nもぐもと申します。\nこの度はリクエスト失礼致します。\n\n\n<内容>\nもぐもの固定キャラを描いていただきたいです。構図はお任せします。\n\nまた、余力がありましたらメンダコも描いていただけると嬉しいです(こちらは本当に余力があればで大丈夫です)。\n\n\n<固定キャラの参考資料&設定>\n・中性キャラ(重要)\n・右目がピンク、左目が紫\n・顔に絆創膏を貼っている(ピンク、水色)\n・左耳にアクセサリー\n・髪留め(ピンク、水色)\n・髪型が耳のようになっている(耳ではない)\n・襟足が長い\n・アホ毛あり\n※目の色の左右がややこしいと思いますが、間違えないようお願い致します。\n\n\n<注意事項>\n中性キャラであることをご留意願います。\n(喉仏、胸の描写等に気をつけていただきたいです)\n\n\n<使用用途>\n・YouTubeのサムネイル等への使用\n・SNSのア