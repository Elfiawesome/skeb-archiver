t=crop&crop=top&w=200&h=200&blur=200&s=0f08786d8d54d32e30a035c6ff4d1fe3, https://si.imgix.net/6af18d10/uploads/origins/317f9a5a-6122-4958-b1e8-28bca679f147?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5dfccdf4a59ea8670af0ef251a684edc 2x, https://si.imgix.net/6af18d10/uploads/origins/317f9a5a-6122-4958-b1e8-28bca679f147?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2200868d97b22ed7f9da40c69643782a 3x"}, "body": "燈翠きよ様、初めまして!\nXで作品を拝見しました。鮮やかで透明感のある色使いがとても素敵で、中性な雰囲気のキャラクターの描写もすばらしいと感じています。リクエストを送らせていただきますが、ご無理でなければ…！\nこれは私のオリジナルキャラクター「离帆」です\n資料 URL に画像を添付したので参考にして下さい。\n年齢・身長： 21歳、身長171cm\n· 基本設定： 非常に聡明で、華奢かつ病弱な青年。長生きできるとは思っておらず、病院で常時療養生活中。\n· 身分・特技： ゲーム実況者。学業成績もゲームの腕前も超一流ですが、ゲームスタイルは「千を討ち、八百を失う」ような、自らにもリスクを厭わない攻撃型です。\n· 外見：\n  · 黒褐色の肩まで届く長さの髪で、かろうじて結べる程度。\n  · 血のように赤い瞳\n  ·  特徴： 左目に涙ぼくろがあり！！鋭い美貌で、少し女性的な印象を受ける\n· 性格：表面上は優しい隣のお兄さん風だが、実際は腹黒く毒舌な「笑面虎」。非常に神秘的な雰囲気を持ち、まるで風が吹けば消えてしまいそうな儚さがあります。\n· 服装： グレーの半袖シャツに、青藍色のブロックが拼接された白いジャケットを、いつもだらりと羽織っている\n· 嗜好・習慣：\n· 暑さに弱い。\n·  甘い物と激辛料理が大好き（医師の指示には全く従わない）\n  · 公園でジグソーパズルをするのが好き。\n  · 瀬戸物のように扱われることを嫌う。\n象徴アイテム：\n· 紙の舟\n· ルビー（赤い宝石）\n· ザクロ\n· ルコウソウ\n· チェスの駒（特に「クイーン」か「ナイト」）\nその他：\n  · 少年時代に交通事故で亡くした男性の恋人（幼馴染）がいる。\n  · その恋人との関係では、受け側であり、相手の前では意外にも柔らかく、わがままになり、甘えん坊になる一面があった。\n個人用の壁紙として使用したいのですが、可能であれば縦向きの構図、9:16の比率でお願いします。衣装自由にアレンジしていただいても構いません！\n長文をここまで読んで頂き、ありがとうございました。\n何卒ご検討いただければと思います!\n\nhttps://drive.google.com/drive/folders/1ZTolazmdWUv63FndOr1XcBPxMvImTsif?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Rg7Jy/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3688248, "client_id": 766472, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/909f6254/uploads/origins/c4613e93-dbdd-400f-95c7-b44159796907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a823414be93224957780d9993675897", "srcset": "https://si.imgix.net/909f6254/uploads/origins/c4613e93-dbdd-400f-95c7-b44159796907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a823414be93224957780d9993675897, https://si.imgix.net/909f6254/uploads/origins/c4613e93-dbdd-400f-95c7-b44159796907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0106782d5414a70d794dadd8dddc1c29 2x, https://si.imgix.net/909f6254/uploads/origins/c4613e93-dbdd-400f-95c7-b44159796907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f042afd377a953df224e5d0c70f2b52a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/909f6254/uploads/origins/c4613e93-dbdd-400f-95c7-b44159796907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32edcd6770b8bcb22da19e6d572917dc", "srcset": "https://si.imgix.net/909f6254/uploads/origins/c4613e93-dbdd-400f-95c7-b44159796907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32edcd6770b8bcb22da19e6d572917dc, https://si.imgix.net/909f6254/uploads/origins/c4613e93-dbdd-400f-95c7-b44159796907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e5891c54ed14a3f0ab4314f9e9aa4709 2x, https://si.imgix.net/909f6254/uploads/origins/c4613e93-dbdd-400f-95c7-b44159796907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d71bec419b416732f5fcc9fdc948f5bf 3x"}, "body": "はじめまして、個人Vtuberとして活動しております、ハシナと申します。\nTwitterの「#夏の創作クラスタフォロー祭り」のタグで燈翠きよ様のイラストを拝見し、可愛くかつどこかノスタルジックな雰囲気やアジアンな雰囲気を感じる、とても素敵な色遣いに惹かれ、ぜひイラストを描いてほしいと思いリクエストをお送りいたしました。\n\n◇リクエスト内容\n私、ハシナを描いていただきたいです。\nシチュエーションは燈翠きよさまのお描きになりやすいように決めていただければと思います。\nまた、衣装のデザインについては資料をお送りいたしますが、こちらも燈翠きよさまの描きやすいようご自由にアレンジしていただいて問題ございません。\n全く違うお洋服でも大丈夫です！\n\n◇使用用途\n・TwitterやYoutube、FANBOXに掲載する予定表や、配信のサムネイル等に使用予定です。\nいずれも収益化はしておらず、FANBOXは有償プランの設定をしていません。\n\n◇納品形式\nお手数をおかけしてしまい大変申し訳ないのですが、\n可能であればレイヤー分けされたPSD、もしくは背景透過のPNG画像をいただけるととてもうれしいです\n\nどうぞご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/11obVdRUaOGxsbtc0-0hPJh29rxsDHj9o?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Rg7Jy/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3688248, "client_id": 2832997, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b639ff52/uploads/origins/6ff4d3d5-97d9-483f-82df-04c68ca2f511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a341ac58238186f8b52d455cc6b029e", "srcset": "https://si.imgix.net/b639ff52/uploads/origins/6ff4d3d5-97d9-483f-82df-04c68ca2f511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a341ac58238186f8b52d455cc6b029e, https://si.imgix.net/b639ff52/uploads/origins/6ff4d3d5-97d9-483f-82df-04c68ca2f511?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56078750ee8095018e3cb24f70332e15 2x, https://si.imgix.net/b639ff52/uploads/origins/6ff4d3d5-97d9-483f-82df-04c68ca2f511?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef8ab398a0c05d1c1024a6b27fa986ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b639ff52/uploads/origins/6ff4d3d5-97d9-483f-82df-04c68ca2f511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=261022661c7101231f267865c2bcf643", "srcset": "https://si.imgix.net/b639ff52/uploads/origins/6ff4d3d5-97d9-483f-82df-04c68ca2f511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=261022661c7101231f267865c2bcf643, https://si.imgix.net/b639ff52/uploads/origins/6ff4d3d5-97d9-483f-82df-04c68ca2f511?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=31ca3b5473191fe140565df2719fcb32 2x, https://si.imgix.net/b63