s/9eea126d-35e2-498c-8ede-efdd2e0d10ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e425bd7db32a55732a75e3d4c4b4c7f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27568a05/uploads/origins/9eea126d-35e2-498c-8ede-efdd2e0d10ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ddd2dfdbbb8f2f1cecf0cd97eee4bf96", "srcset": "https://si.imgix.net/27568a05/uploads/origins/9eea126d-35e2-498c-8ede-efdd2e0d10ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ddd2dfdbbb8f2f1cecf0cd97eee4bf96, https://si.imgix.net/27568a05/uploads/origins/9eea126d-35e2-498c-8ede-efdd2e0d10ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dcda6684a4427f3c664da6d4172d005b 2x, https://si.imgix.net/27568a05/uploads/origins/9eea126d-35e2-498c-8ede-efdd2e0d10ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea7314aebeb4a8fa22ec66edd12de1c8 3x"}, "body": "はじめまして\nu様の素敵なイラストに惹かれリクエスト失礼いたします。\n\nお願いしたいのは私と友人のオリジナルキャラクターである以下の2人です。\n構図、範囲、服装等はお任せでお願いしたいです🙏\n\nキャラクター詳細\n/看守　（白髪）\n監獄島の最深部で一人で囚人を監視する仕事を担っている。\n5年ほど前から一人で仕事をしている。頭が固い。\n\n\n/囚人　（灰髪）\n最深部に長くいる囚人。\n寒さに耐性があり、空気中の水分を集めて彫刻を作ることなどが可能。\n看守が外していいと判断した場合以外、両腕が拘束具で戒められている。\nそのため、看守に身の回りの世話をされることもある。\n\n\n\n世界観\n/日本海のどこかにある監獄島。2人が居るのは監獄島の最深部であり、空気も凍てつくような寒い場所。\n\n\n\n服装等細かいデザインは書きやすいものにしていただけたら嬉しいです。\nご検討いただけますと幸いです。よろしくお願いいたします🙇‍♀️\n\nhttps://drive.google.com/drive/folders/1V49u9eBMw8rFd2jIHC0ZYQEI-dGo75Fu?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kawaiiusacha_n/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 988523, "client_id": 405731, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4993d4fa/uploads/origins/5d65bd50-c372-43b3-b878-e1e7842ea07a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7171efaac738bb33a3b0348a1f90a5b", "srcset": "https://si.imgix.net/4993d4fa/uploads/origins/5d65bd50-c372-43b3-b878-e1e7842ea07a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7171efaac738bb33a3b0348a1f90a5b, https://si.imgix.net/4993d4fa/uploads/origins/5d65bd50-c372-43b3-b878-e1e7842ea07a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04b0e3f3b7a23d37195709e4ea642e79 2x, https://si.imgix.net/4993d4fa/uploads/origins/5d65bd50-c372-43b3-b878-e1e7842ea07a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad2879d500ddfa6461d09ded523282c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4993d4fa/uploads/origins/5d65bd50-c372-43b3-b878-e1e7842ea07a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d324cf7e4e1e881e40939cd83be1740f", "srcset": "https://si.imgix.net/4993d4fa/uploads/origins/5d65bd50-c372-43b3-b878-e1e7842ea07a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d324cf7e4e1e881e40939cd83be1740f, https://si.imgix.net/4993d4fa/uploads/origins/5d65bd50-c372-43b3-b878-e1e7842ea07a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=418cf5c508e75fe551c70a1e9059366a 2x, https://si.imgix.net/4993d4fa/uploads/origins/5d65bd50-c372-43b3-b878-e1e7842ea07a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4fe122b787bfdaf7e5f3b4be8c6572bb 3x"}, "body": "いつも素敵なイラストをありがとうございます。\n\n早くもケイエスミラクルがサポカとして登場しましたが、\n儚さと格好良さと色気が相まった仕草にドキッとしてしまいました。\nそしてこれは是非ともuさんの描いたミラクルが見たいと思い依頼させていただくことにしました。\nカプ違いなどあればサクッとキャンセルしてしまって下さい。\n\nベッドに腰掛けたケイエスミラクルと、その脚をマッサージしているダイイチルビーをお願いします。\nなんとなく想定しているものを記載しますが、uさんのイメージを優先して下さい。\n・トレーニング後のお風呂から戻ってきた寮の自室\n・服装は部屋着もしくはジャージ\n・ルビーはとても大切なものを扱うような慈しむ表情をしている\n\n既にご覧になったかもしれませんが、競走馬ケイエスミラクルの最期のレースになってしまったスプリンターズS\nhttps://www.youtube.com/watch?v=0zQsjCJjBZc\n0:58前後の脚が砕けて後退していくミラクルと、その真横を駆け抜けて勝利へ向かうルビーの構図が眼に焼き付いてしまって離れません。\nウマ娘のミラクルにとっても無事では済まないレースになってしまうと思います。\nそれでももう一度奇跡を起こすため諦めずリハビリ・トレーニングに奮闘するミラクルと、\nそれを献身的に支えるルビー…というようなものが見たいです。\n\n長々と書いてしまいましたが、ご検討のほどよろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kawaiiusacha_n/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 988523, "client_id": 2062115, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8cf2d95e/uploads/origins/0c8e1904-79a6-435d-a81c-8e483fd71942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c388052e036f717ddc4d848ee426cebd", "srcset": "https://si.imgix.net/8cf2d95e/uploads/origins/0c8e1904-79a6-435d-a81c-8e483fd71942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c388052e036f717ddc4d848ee426cebd, https://si.imgix.net/8cf2d95e/uploads/origins/0c8e1904-79a6-435d-a81c-8e483fd71942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=901b32e73a2ec49e01c585fa78b0f753 2x, https://si.imgix.net/8cf2d95e/uploads/origins/0c8e1904-79a6-435d-a81c-8e483fd71942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3b88cd3b5d5b34271b19a3e80e2f9ae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8cf2d95e/uploads/origins/0c8e1904-79a6-435d-a81c-8e483fd71942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35c7a3e330a4040ca34bb103edd188a6", "srcset": "https://si.imgix.net/8cf2d95e/uploads/origins/0c8e1904-79a6-435d-a81c-8e483fd71942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35c7a3e330a4040ca34bb103edd188a6, https://si.imgix.net/8cf2d95e/uploads/origins/0c8e1904-79a6-435d-a81c-8e483fd71942?bg=%23fff&auto=forma