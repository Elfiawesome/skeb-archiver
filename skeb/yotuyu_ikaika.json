s": [{"path": "/@yotuyu_ikaika/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 672260, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/27423377/uploads/origins/a5ee65c1-8d37-4ac8-806a-43a5360f3dfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=931a34ea2919728052ce5a055f887220", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27423377/uploads/origins/a5ee65c1-8d37-4ac8-806a-43a5360f3dfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49361df79778ac2b2652f41d2d275f12", "src_set": ""}, "body": "こんにちは！日頃お世話になっております。\n今回は友人とのOCをお願いしたく、リクエストさせて頂きます。\n\n◼︎内容\n資料内男女OCのイラスト\n└OC資料内にはCoCシナリオの要素を含みますが、いずれもネタバレになる内容はありません。\n一枚絵や詰め込み、デフォや落書き詰めなど、イラストの形式は完全にお任せいたします。立ち絵やデフォルメなど、パーツとして分けられるイラストになる場合は透過のデータを頂けると嬉しいです。\n\nまた、資料内には本編軸と現代コンバートの2種がありますが、どちらを描いて頂いても構いません。\n本編軸の場合は隊服でのイラストをお願いしたいです。現代コンバートの場合はどんな服を着せて頂いても大丈夫です。よつゆさんだぞさんのセンスにお任せいたします。\n\n◼︎使用用途\n観賞用、個人利用\n└セッション内での使用、グッズ化、等\n\n以上になります。\n不備等あればお手数ですが再送申請をお願いいたします。\n\nhttps://drive.google.com/drive/folders/1_seODlagk5dPko1Uf1XXu65hNTW5lqid?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yotuyu_ikaika/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 672260, "client_id": 2774924, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bce069ce/uploads/origins/de8f4d12-421f-47b3-aa8d-aaf96311ba0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a8e04c92df90e6997fdb75e38a2aa8b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bce069ce/uploads/origins/de8f4d12-421f-47b3-aa8d-aaf96311ba0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0448c468c28682fdb5aa3b167a6c28e6", "src_set": ""}, "body": "よつゆ様、初めまして。こんばんは。いぬみりんと申します。\nいつも素敵なイラスト拝見させていただいております。\n今回、宜しければ自探索者のイラストを依頼させていただきたいです。\n\n以下設定といたしまして\n◇職業：刑事\n◇性格：几帳面で論理的。冷静だが友人や仕事関係の人以外に興味がない。\n◇その他：重度のヘビースモーカー\n◇情報：38歳、182cm　笑う時は眉を下げて控えめに笑う\n\n参考資料などは下記に載せさせていただきます。リンク先ネタバレ等はありません。\n\nよつゆ様の絵に対する構図や色使い、表情などのセンスが大好きなので、そちらはお任せさせていただければと思います。\n洋服等も資料として複数枚入れさせていただいています。お好きなものを描いていただければ幸いです。\n\n作業量等、見合わない金額でしたらキャンセルしていただいて大丈夫です。\n\nお忙しいかと思いますが、何卒ご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10FR2KDvDUDFfre7HCHebN7EAapVmwVyN", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 274225, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "古河おどろ", "screen_name": "RE_yomawari", "avatar_url": "https://pbs.twimg.com/profile_images/1925546316228435973/tmR-hNDu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/370459500/1758207182/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 48}, {"id": 1032884, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "wat1/2", "screen_name": "nojimanonojiko", "avatar_url": "https://pbs.twimg.com/profile_images/1770443290011394048/1XlzS93x.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 49}, {"id": 1175523, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "異常なし", "screen_name": "tensentensen", "avatar_url": "https://pbs.twimg.com/profile_images/1406182404285362179/6DO-BS6d.jpg", "header_url": "https://pbs.twimg.com/profile_banners/13381