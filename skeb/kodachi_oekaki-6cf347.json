&fit=crop&crop=top&w=200&h=200&blur=200&s=294d48e78bb83199b1239f59e2b24db5, https://si.imgix.net/540aa39b/uploads/origins/6eae74c0-4f95-4d6a-ad2b-d417524082a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c74a2c521c8422f09378b417259fcb9 2x, https://si.imgix.net/540aa39b/uploads/origins/6eae74c0-4f95-4d6a-ad2b-d417524082a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e96ef54a35ab820b2772bb2b7a422149 3x"}, "body": "こんにちは、はじめまして。『艦隊コレクション』のヒビキを描いていただけませんか？ 彼女と提督がラブラブなセックスをしている様子を描いてほしいです。今回は首に装置はつけていませんが、それでも激しく、愛情あふれるシーンにしてください。胸とアソコは露出させています。提督は後ろから彼女を抱きしめ、子宮を刺激しています。\n\n二人が同時にイくシーンにしてください。可能であれば、ヒビキに潮を吹かせてほしいです。\n\nセリフを入れる場合は、日本語で構いません。よろしくお願いします！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kodachi_oekaki/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 20295, "client_id": 17722, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0289497/uploads/origins/553cf75a-69b4-4f2a-9982-ad6ffd957876?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2b3e114e17e085b0971a00506ccc772", "srcset": "https://si.imgix.net/b0289497/uploads/origins/553cf75a-69b4-4f2a-9982-ad6ffd957876?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2b3e114e17e085b0971a00506ccc772, https://si.imgix.net/b0289497/uploads/origins/553cf75a-69b4-4f2a-9982-ad6ffd957876?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3af56710cebcb2dcd1d593adc1c08e0 2x, https://si.imgix.net/b0289497/uploads/origins/553cf75a-69b4-4f2a-9982-ad6ffd957876?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe51fe187860d63f9332df0ad4c0e022 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0289497/uploads/origins/553cf75a-69b4-4f2