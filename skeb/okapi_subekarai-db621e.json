。\n\nご検討の程よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@okapi_subekarai/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 2946439, "client_id": 3532032, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/49bb0b77-b63f-4669-8c9f-386392bf8779?response-content-disposition=inline&Expires=1785050737&Signature=Twk2AoODmhetBy6SpAXkHeQ1FUt0d7~qsgdQ3Ohlz7X8hD-MoGyRoYLKyQ4A16JHmBoVRhlmULhE1uES5nB-CWCmt6XyO6Rf-Pe7IT5r89coakVQxSZBf~0NePk-c8LdNqp7TJAYdnIfC5jwsiGht4XxppxYu~xmbKo6Krq~U6MkrWPHWe00LqJNH-Oa~462knA~~GdDRN7Hv3X0rwor5JvXHr8blysUVuY5N6a6tVWQya4f0dzm-1DZH3APPbhYRQEsN6S0~Jyeo-NFKSepk6vmrHxWw2d7nx~wT5~Wu57wy0-H4xxXDaiUqeyVIjEb3tPOrBMmOJN~g~0DZSBqrw__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774779604999577600%2FYYt3e_EJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77275ef15e7ef518728591be0696294e", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774779604999577600%2FYYt3e_EJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77275ef15e7ef518728591be0696294e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774779604999577600%2FYYt3e_EJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22162629ccb8187adf59c900c5f23f2a 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774779604999577600%2FYYt3e_EJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47927733ad7f72a89dfae44052d12f4c 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/4c946109-1e98-4dd3-82ca-019e9d56d094?response-content-disposition=inline&Expires=1785050737&Signature=ZHfaFbbQVgX6Dl9tbDTteAVuD7rBmprzgNsYpHjBSHMCHL3LWONtomhrSMlm6~Phz1s5dt8-B3dOdfxUioum8m4Ilb