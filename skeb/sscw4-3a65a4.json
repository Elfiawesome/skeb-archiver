200&s=91dbe55fe0c9fd45eed0f1487194c39a, https://si.imgix.net/e236a93a/uploads/origins/24fd5ce4-48b3-4f6b-8087-54cbc6fcdbe4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7ba3e811822b7ab2c53c89badf26b49 2x, https://si.imgix.net/e236a93a/uploads/origins/24fd5ce4-48b3-4f6b-8087-54cbc6fcdbe4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=411f61f5b54e79d71584b28df204c753 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e236a93a/uploads/origins/24fd5ce4-48b3-4f6b-8087-54cbc6fcdbe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b8ab2f71d78fd62a4bb00ac5dc3eb18", "srcset": "https://si.imgix.net/e236a93a/uploads/origins/24fd5ce4-48b3-4f6b-8087-54cbc6fcdbe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b8ab2f71d78fd62a4bb00ac5dc3eb18, https://si.imgix.net/e236a93a/uploads/origins/24fd5ce4-48b3-4f6b-8087-54cbc6fcdbe4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=121c7b3678b1d07f1b1aa074c5c1b47f 2x, https://si.imgix.net/e236a93a/uploads/origins/24fd5ce4-48b3-4f6b-8087-54cbc6fcdbe4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a53009f2413f7be6b9b15ba74ef80147 3x"}, "body": "煤川様\n\nあなたのイラストが好きなのですが、お困りのようでしたので、少しでもお力になれればとリクエストをお送りさせて頂きました...!!\n(おかゆんのファンアートがどれも好きです。)\n\n▷対象\n海外VtuberのDr.NOVA(e)さんをお願いできれば幸いです。(本人許諾済)\nマッドサイエンティストで、デビュー配信の最後に死んだりする愉快な子です。\nhttps://www.youtube.com/watch?v=Ggq1t2uAiUk&t=2066s\n化学実験や、モンスター、ホラーなどを好んでいます。\n\n参考ツイート\nhttps://x.com/Dr_NOVAe/status/1783985125060907430\n\n▷シチュエーション\n実験っぽい感じであればなんでも大丈夫です。\n背景の描かれ方が好きなので、背景は欲しいですが\nサムネイル用に使ってもらいたいので、大きさとしては人物が中心で、顔は見えるようにお願いします。\n\n参考例\nhttps://shadowverse-evolve.com/wordpress/wp-content/uploads/2022/08/16105242/1001%E3%83%A9%E3%83%90%E3%83%BC%E3%83%9E%E3%83%83%E3%83%8803_2-1024x576.png\n\nhttps://www.cardrush-sv.jp/phone/data/cardrush-sv/product/CP01_221001_57.jpg\n\n▷仕様\n背景と人物のレイヤーが分かれているPSDファイルで頂けると有り難いです。\n\nhttps://drive.google.com/drive/u/0/folders/1QVL6sq2Moeqh6bkZw-XSPDjvlSOY6nS5", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sscw4/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 100590, "client_id": 1213948, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d30dac85/uploads/origins/aed948e1-124d-422e-aa38-582b609f0cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaa26505d06e6acf257f528a218a5555", "srcset": "https://si.imgix.net/d30dac85/uploads/origins/aed948e1-124d-422e-aa38-582b609f0cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaa26505d06e6acf257f528a218a5555, https://si.imgix.net/d30dac85/uploads/origins/aed948e1-124d-422e-aa38-582b609f0cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bba48380690e130fff2849930f90fe9 2x, https://si.imgix.net/d30dac85/uploads/origins/aed948e1-124d-422e-aa38-582b609f0cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89a4a3e719d5bc8a0e559d7c9f2aad57 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d30dac85/uploads/origins/aed948e1-124d-422e-aa38-582b609f0cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6a637c463f530129d4da311004e98a9", "srcset": "https://si.imgix.net/d30dac85/uploads/origins/aed948e1-124d-422e-aa38-582b609f0cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6a637c463f530129d4da311004e98a9, https://si.imgix.net/d30dac85/uploads/origins/aed948e1-124d-422e-aa38-582b609f0cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c8637505f14166ba96b5b362c4873557 2x, https://si.imgix.net/d30dac85/uploads/origins/aed948e1-124d-422e-aa38-582b609f0cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a3fd115f7117a463b5178d877e21eaf0 3x"}, "body": "煤川さんの絵が本当に大好きです！\n可愛くてセクシーな女の子から儚さのあるドラマティックな1枚まで幅広い画風や、オリジナルのキャラクター性を尊重しつつ、その子の魅力を引き出す画作りに感動しています。煤川さんの描くキャラクターは特別な存在感があって大好きです！\n光や空気感、艶やかでしっとりとした肌や布の質感の表現がいつも素敵で惚れ惚れしています。\n\n今回は私のオリジナルキャラクターの2人を描いて頂きたいと思いご依頼させて頂きました。難しい場合は、どちらかお好きな方を1人選んで描いて頂けますと幸いです。\n用途は鑑賞のみです。キャラクターデザインは資料URLを御参照頂ければとおもいます。文字が沢山書いてあるものがありますが、読まなくても大丈夫です。\n2人を描いていただける場合は、2人の扱いが平等である必要はなく構図にあわせてどちらかを小さく描いたりなどもご自由になさってください。視線がこちらにある必要はありませんが2人とも顔が見えていると嬉しいです。\n髪型もファッションも描きやすいようアレンジしたり、その他省略したりご自由に変えて頂いてかまいません。\n煤川さんが自由に描く世界観の2人が見たいので描くのが楽しくなるようになんでもご自由にしてください。\n難しい場合はお気軽にキャンセルしてください！御検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1UyPGV5cvBH3Gi9-SGyOmNRFANzSU3sJ7?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sscw4/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 100590, "client_id": 279301, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/060c88c6/uploads/origins/bda91ef4-765f-4a12-a335-95581c803087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de4682b7e51d7d3930dbd9a15857480e", "srcset": "https://si.imgix.net/060c88c6/uploads/origins/bda91ef4-765f-4a12-a335-95581c803087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de4682b7e51d7d3930dbd9a15857480e, https://si.imgix.net/060c88c6/uploads/origins/bda91ef4-765f-4a12-a335-95581c803087?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ef43ef4482b3fb2f02b7775c191b2be 2x, https://si.imgix.net/060c88c6/uploads/origins/bda91ef4-765f-4a12-a335-95581c803087?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f5cd8e9dbb8c9fd8b5a75951866968c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/060c88c6/uploads/origins/bda91ef4-765f-4a12-a335-95581c803087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e4fd55b39d8a6709c92ab780a73eaab", "srcset": "https://si.imgix.net/060c88c6/uploads/origins/bda91ef4-765f-4a12-a335-95581c803087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e4fd55b39d8a6709c92ab780a73eaab, https://si.imgix.net/060c88c6/uploads/origins/bda91ef4-765f-4a12-a335-95581c803087?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e42688af83db5efa62178b9bf31c27dc 2x, https://si.imgix.net/060c88c6/uploads/origins/bda91ef4-765f-4a12-a335-95581c803087?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9ac255f19946ead7801eaaaf4bc0e006 3x"}, "body": "初めまして。\nX（Twitter）にて煤川様の作品を拝見し、艶やかなキャラクターとの描き方と奥行きを感じる背景がとても素敵だなと思い、リクエスト送信させていただきました。\n\n私のOCのイラストをお願いできますでしょうか。\n\n■キャラの特徴\n・身長155cm程、細身で華奢\n・ツインテの結び目＋左サイドヘアーに黒の髪飾り\n・蠍の尻尾、左足太ももからふくらはぎにかけて蠍の尻尾の模様\n・性格はクールに見えて実はダウナーで面倒くさがり屋なタイプ\n\n服装については、赤のアウターを着ている通常着の姿でお願いいたします。\n三面図等の詳細資料がなく申し訳ありませんが、装備類の見た目は\n「Helena_Original.png」、「Helena_9.png」、「Helena_10.png」\nが分かりやすいかなと思います。\n\n■構図・シチュエーション等\n詳細はお任せしますが、背景多めな構図だと嬉しいです。\n一応、近未来・ポストアポカリプス的な世界観を想定しているので、（アークナイツが割と近いです）\nそれに準じたシチュエーションにしていただけると幸いです。\n\n■使用用途について\n個人利用、また本キャラクターのイラストを依頼させていただく際の参考資料にさせていただきます。\n\n金額・工数的に難しければ遠慮なくキャンセル・再送ください。\nご検討の程、何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1xcFOzKTRnGpyfgSnJCVzF8G_nG3VOn0n?usp=share_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sscw4/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 100590, "client_id": 702891, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bcc73d6/uploads/origins/83d739da-ed5c-4645-a3d6-dc22d8ea3549?bg=%23fff&auto=format%2