p=top&w=200&h=200&blur=200&s=a1f1c295eaf05b0cde65b84d0b827f2c 3x"}, "body": "こんにちは。これらのキャラクターを見て、自由に音楽を作ってほしいです。 あなたのよろしければこの要請を受諾していただけますか？\n\n現代を背景に路地出身のプログラマーたちです。 基本的にはプログラム開発でお金をもらいますが、他人の依頼を受けてハッキングをしたりするなどの副収入を得ています。\n二人とも独特な考え方を持っていて、自分たちだけの世界が確固としていて、二人だけの世界で一緒に生きていくキャラクターたちです。 通常、地下に自分たちだけのアジトを改造して居住しています。\n\nhttps://drive.google.com/drive/folders/1BsI3iasksE9mZ64P2JeTV63FjrJRfeoD?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@yutaro39compos/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": true, "creator_id": 3302155, "client_id": 1344016, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1792003929007624192%2FJdoIDF20.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7500969839bdd2e17e8bc552d4322665", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1792003929007624192%2FJdoIDF20.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7500969839bdd2e17e8bc552d4322665, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1792003929007624192%2FJdoIDF20.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb7f706b6f871271e08360df72aef6ef 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1792003929007624192%2FJdoIDF20.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9e2b7b441e1037d3f5afc796b477307 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/00b5be46-9d5e-48d9-bf9d-e3d50e28cb3d?response-content-disposition=inline&Expires=1774627729&Signature=qYerqQ0blH~n356lacseXlXtqX-2L4uuS4ttgVwjBRb6l4HVeT46vqraBJNLxfGyCuVFwZWDbRm2jvGOFEPZDTC9uz8LSrj--CwlRD9gzcn0FvRk6tGjUrt1BPRV3wZjR3JWfvstwnzONcFRzrGHEW8BFXeMntMCh7Okpd8oGoRyvldoPM2DDo9peSAXRLlkkW1ccV8Yv-~9rUEFqG7rRaF49