nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29a6ce98/uploads/origins/62908adc-5c40-41f4-a167-572eac81668d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f472be25dcf1e95c9f93e4e75b68e956", "srcset": "https://si.imgix.net/29a6ce98/uploads/origins/62908adc-5c40-41f4-a167-572eac81668d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f472be25dcf1e95c9f93e4e75b68e956, https://si.imgix.net/29a6ce98/uploads/origins/62908adc-5c40-41f4-a167-572eac81668d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9b0900dd51e57d8e19381d7807335855 2x, https://si.imgix.net/29a6ce98/uploads/origins/62908adc-5c40-41f4-a167-572eac81668d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4de88fc8ae50bd581085b45178753608 3x"}, "body": "初めまして。配管矢さんの鏡音レンをずっと前から好きです。よろしければ、メダリストの鴗鳥理凰のイラストをリクエストします。BL風味の健全なリクエストです。\n\nキャラとポーズ参考：\nhttps://drive.google.com/drive/folders/1P1jfBzQW3JdFtZ8v6pJHsY6GmLhUQVTh?usp=sharing\n\n内容：\n理凰をバストアップ構図で描いてください。眼鏡をかけている。彼は、意外と女子っぽい仕草で耳に手を当て、ピアスを見せている。そのピアスも意外にも女性的なデザインで、キラキラした宝石が付いていたり、少しぶら下がっていたりしている。少し笑顔を浮かべているが、照れて顔を赤らめ、恥ずかしそうにカメラから目をそらしている。\n\n雰囲気：\n理凰は、特別な想いを抱いている年上のお兄さんと二人きり。普段はツンツンした態度の理凰も、この人の前ではその殻が完全に崩れてしまう。こんなことをするのは恥ずかしいけれど、もしその人に女の子みたいに見てくれたら、とても嬉しい。「こういう顔を見せるのは、君だけだよ」みたいな感じです。\n\n曖昧な表現ですみません。ご検討のほどよろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kubari_Kanya123/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2185810, "client_id": 248850, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f96ee965/uploads/origins/d25a77f6-6a7a-4053-9206-8bbaec7858fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d18d4ab82c81833663d0466e67db385", "srcset": "https://si.imgix.net/f96ee965/uploads/origins/d25a7