る派。でもなんでも飲むよ。\n・タバコは吸わないよ。\n・好きな食べ物はカレー。とくに焼きカレー。\n・嫌いな食べ物はないよ。強いて言うと虫。\n・得意な料理はカレー。玉ねぎは狐色まで炒めて入れる野菜デカ目圧力鍋派閥。\n・香草大好き。パクチーも好き。ニンニクネギ生姜入れれば入れるだけ美味いんだから\n\nえまだ100文字以上書けるの？もうやめていい？", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 946163, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "燈ともす@男装VTuber", "screen_name": "akaritomosu_", "avatar_url": "https://pbs.twimg.com/profile_images/1901312962964647936/JuZoPX4w.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1291881165687623680/1749824849/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}, {"genre": "voice"}], "nc": 144}, {"id": 1873433, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "オサムサ/Osamusa(costume design)", "screen_name": "osamusa828", "avatar_url": "https://pbs.twimg.com/profile_images/1638524612635152384/zitGkRgt.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1483796954669019137/1646397682/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 33}, {"id": 3011655, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "kyupo(浜山きゅぽ)🖥✍️Emotes", "screen_name": "9pokamoyo", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fa85a6de6-cf6e-4773-bf6a-fc6d2e1ff488.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/9ee03d86-b956-4a78-8eac-0e34ec82ae9f.gif", "appeal_receivable": false, "popular_creator_rank": 60, "request_master_rank