=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5ffb065ddb2148bb6746751422546c0", "src_set": ""}, "body": "初めまして、個人でVtuberとして活動予定の月橘 なぎさ(ゲッキツ ナギサ)と申します。\nこちらのサイトでハラペコ様のイラストをお見掛けし、イラストを描いていただきたいと思い、リクエストを送らせていただきました。\n\n〖キャラクター〗\n外見　三面図\nhttps://drive.google.com/file/d/1vjr4CI-SqKK76KqTRiSob75s7Q2Yrdwb/view?usp=drive_link\n中身\n◦海軍に所属している18歳の女の子。\n◦真面目だが抜けている。\n◦ホラーが大好き。\n\n〖依頼内容〗\n◦髪型、服装はそのままで表情、ポーズ、構図はおまかせします。\n◦可能であればキャラクターのみ透過されたものをPSDファイルでいただけますと助かります。\n\n〖使用用途〗\n◦SNS全般\n　収益化は出来ておりませんが、出来るようになればするつもりです。\n\nお忙しいと思いますがご検討よろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@harapek1206/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/934549c9/uploads/origins/5c0f9a6d-ff9e-46a0-a1c6-07ec6bec7ab3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b1e23a5ad7914a0354233774490b5116", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3556701, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@harapek1206/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3556701, "client_id": 3727835, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c24e1a73/uploads/origins/8ec1e628-b16b-46b0-9835-6a97d6c38850?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0c093311ff3e9262762cf405ff8d2c2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c24e1a73/uploads/origins/8ec1e628-b16b-46b0-9835-6a97d6c38850?bg=%23fff&auto=format%2Ccompress&fm