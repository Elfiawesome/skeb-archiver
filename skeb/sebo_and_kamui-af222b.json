m=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a951fa68f8885b42b3d78ada7da873c8 3x"}, "body": "はじめまして。\nポケモンORASのジムリーダー、ランがマグマ団に洗脳される小説をお願いします。\nトクサネ宇宙センターの襲撃を計画していたマグマ団が、そこで行われている超能力の研究に協力しているランに目をつけ洗脳する、という感じです。\n洗脳後に元の自分を装って戻ったランが、双子であるフウをルナトーンの催眠術と自身の超能力によって、自分と同様に洗脳するような描写を入れていただきたいです。\nその他の部分はお任せさせてください。\n\n話の流れなどは、書きやすい形で自由に変更していただければ幸いです。\nご検討よろしくお願いします。", "nc": 41, "word_count": 4321, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@sebo_and_kamui/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 354987, "client_id": 3063649, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3b2675e4/uploads/origins/1e93c841-9e44-4f75-8117-61065b19abab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ba9de4d0a989fb2f5007149ea0d1057", "srcset": "https://si.imgix.net/3b2675e4/uploads/origins/1e93c841-9e44-4f75-8117-61065b19abab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ba9de4d0a989fb2f5007149ea0d1057, https://si.imgix.net/3b2675e4/uploads/origins/1e93c841-9e44-4f75-8117-61065b19abab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0cc2c1cb164112648699948bb0e94cd9 2x, https://si.imgix.net/3b2675e4/uploads/origins/1e93c841-9e44-4f75-8117-61065b19abab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21f521bcd7151e1fefca80dbe4b967d7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b2675e4/uploads/origins/1e93c841-9e44-4f75-8117-61065b19abab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e6637bd1a9b019025f48a0e1a077245", "srcset": "https://si.imgix.net/3b2675e4/uploads/origins/1e93c841-9e44-4f75-8117-61065b19abab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e6637bd1a9b019025f48a0e1a077245, https://si.imgix