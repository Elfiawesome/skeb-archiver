rc": "https://si.imgix.net/e6d203cd/uploads/origins/deb15b87-1ebf-42bb-827c-5295362e35b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5520ead950b64fb5074b2c4bd5720362", "srcset": "https://si.imgix.net/e6d203cd/uploads/origins/deb15b87-1ebf-42bb-827c-5295362e35b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5520ead950b64fb5074b2c4bd5720362, https://si.imgix.net/e6d203cd/uploads/origins/deb15b87-1ebf-42bb-827c-5295362e35b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=019187f7dc8546e3c688ff27e8a9a20c 2x, https://si.imgix.net/e6d203cd/uploads/origins/deb15b87-1ebf-42bb-827c-5295362e35b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9997187cbc1d52c88aba498a494ceeec 3x"}, "body": "初めまして、アピールありがとうございます！\n\n今回依頼したいのはポケモンダイヤモンド・パールに出てくるシロナというキャラクターがギンガ団幹部のマーズやジュピターに捕らえられ洗脳されギンガ団へと堕ちるといった小説です。\nギンガ団へと堕ちた後、他人のポケモンを奪ったり施設を爆破させたりと言った悪事を働く描写があると嬉しいです。\n洗脳方法など細かい部分はお任せします。\n\nご検討のほどよろしくお願いします。", "nc": 40, "word_count": 6175, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@sebo_and_kamui/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 354987, "client_id": 97802, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e8c395b/uploads/origins/86df42b4-9573-4b10-a68c-de310a4d654b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2a6e6aed19da0b611b511d4a3036156", "srcset": "https://si.imgix.net/8e8c395b/uploads/origins/86df42b4-9573-4b10-a68c-de310a4d654b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2a6e6aed19da0b611b511d4a3036156, https://si.imgix.net/8e8c395b/uploads/origins/86df42b4-9573-4b10-a68c-de310a4d654b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e85a12cfc20da73de83f7831eedf2aaf 2x, https://si.imgix.net/8e8c395b/uploads/origins/86df42b4-9573-4b10-a68c-de310a4d654b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=770ccfecf516875a72dc4bfc57b4fd97 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e8c395b/uploads/origins/86df42b4-9573-4b10-a68c-de310a4d654b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df62f9c06fa59973c9a6e7c27401ad22", "srcset": "https://si.imgix.net/8e8c395b/uploads/origins/86df42b4-9573-4b10-a68c-de310a4d654b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df62f9c06fa59973c9a6e7c27401ad22, https://si.imgix.net/8e8c395b/uploads/origins/86df42b4-9573-4b10-a68c-de310a4d654b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e415b1f575b53f010473b1e15e884d82 2x, https://si.imgix.net/8e8c395b/uploads/origins/86df42b4-9573-4b10-a68c-de310a4d654b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=457ee2d113e894ff1dc2d9d830214c67 3x"}, "body": "プラ瀬暮様、先日は素晴らしい作品を有難う御座います。\nリクエストさせて頂きます。\n\nロマサガ3のミューズ・クラウディア・クラウディウスが夢魔に全てを乗っ取られてしまうSSを宜しくお願い致します。\n\nミューズが単独で門を開いてしまい、夢魔に囚われてしまいます。\n夢魔はミューズを犯し、ミューズの\n「何故その様な真似をするのですか!?」\nの問に夢魔は\n「お前が生娘であっては困るからだ。お前には私の全てを継承して貰う」\nと言うと\n「先ずは我が知識、受け取れ!」\nとミューズの胎内に注ぎ込みます。\nミューズは一度絶頂すると膨大な性知識、中には性に深く精通する者でなければ得られぬ物までを刻み込まれそれにより欲情してしまい、更に耳がエルフの様に鋭利に尖ります。\nミューズは淫らな欲望に翻弄されつつも夢魔を睨みつけ怒りをぶつけます。\nすると夢魔はならば一矢報いてみよとけしかけます。\nミューズはせめて穢れた知識で一矢報わんと夢魔にフェラを行い、初行為にも関わらず熟練の娼婦顔負けの快楽を与えます。\n夢魔は先程の余裕が失せ絶頂間際になるとミューズは寸止めを行い、何故か夢魔が初々しい反応をしている事を指摘し\n「私に穢れた知識を与えたせいで貴方が忘却するという軽率な過失をしまして？」\nと言うと騎乗位で夢魔を搾り取ります。\n夢魔を絶頂させると今度は夢魔の戦闘スキルを吸収してしまい、夢魔から角が消えるとなんとミューズに角が生えます。\nミューズは嗜虐的な顔で\n「後は貴方の力と精を吸い尽くすだけ♥」\nと夢魔をちんぐり返しで犯します。\n夢魔は内心で\n(これで贄になる事で我が目的成就せり!汝は我、我は汝となる!)\nと思い、最終的に夢魔は灰と化します。\nするとミューズの背中から夢魔の羽根が生え、夢魔の全てを吸収し自身が夢魔そのものと化した事を理解します。\nするとミューズは元のドレスを烈風剣で細切にし、それを灰と混ぜ合わせ身体に纏わりつかせると淡緑のボンデージと化します。\nhttps://www.pixiv.net/artworks/109062740\n(作者様の資料貼り付けの了承を得ております。)\nラストは後から駆けつけてきた主人公達と対峙するシーンで締め括って下さい。\n\nその際に采配でご自由にアレンジして頂いて構いません。\n不都合があれば再送キャンセルして構いません。\nどうぞ御検討宜しく御願い致します。", "nc": 168, "word_count": 2929, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@sebo_and_kamui/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/af1d686d/uploads/origins/2f3bf1aa-8e40-4029-9864-943ddeec4218?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a30a1736d9fba980c1fd493a733fa027", "srcset": "https://si.imgix.net/af1d686d/uploads/origins/2f3bf1aa-8e40-4029-9864-943ddeec4218?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a30a1736d9fba980c1fd493a733fa027, https://si.imgix.net/af1d686d/uploads/origins/2f3bf1aa-8e40-4029-9864-943ddeec4218?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a840a8c12e783e6b83992f80988c877 2x, https://si.imgix.net/af1d686d/uploads/origins/2f3bf1aa-8e40-4029-9864-943ddeec4218?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77ab368a0265c10630d26749174604f6 3x"}, "private": true, "genre": "novel", "tipped": false, "creator_id": 354987, "client_id": 97802, "nc": 176}, {"path": "/@sebo_and_kamui/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2d03fa0a/uploads/origins/1fb0fc3e-6d1c-4bbe-9534-b2115eda584b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=610f872e0dbde3f56cce8ad3d7795da2", "srcset": "https://si.imgix.net/2d03fa0a/uploads/origins/1fb0fc3e-6d1c-4