fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c1c9db2762ab201794d3cf018fb0134 2x, https://si.imgix.net/9a5734a4/uploads/origins/b2d776de-6eb8-4d11-b615-2f1ab337aa60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c81684282950aad22e416101929351aa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a5734a4/uploads/origins/b2d776de-6eb8-4d11-b615-2f1ab337aa60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84ce95430836e7e9f9e89a8b1c9bf9da", "srcset": "https://si.imgix.net/9a5734a4/uploads/origins/b2d776de-6eb8-4d11-b615-2f1ab337aa60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84ce95430836e7e9f9e89a8b1c9bf9da, https://si.imgix.net/9a5734a4/uploads/origins/b2d776de-6eb8-4d11-b615-2f1ab337aa60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=42b984534bb69114598a22a079857be9 2x, https://si.imgix.net/9a5734a4/uploads/origins/b2d776de-6eb8-4d11-b615-2f1ab337aa60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=938f649b6cefbb56bf6e0bdaf80b2d0c 3x"}, "body": "お世話になっております、ｏｍです！宇治川さんにオリジナルキャラクターのララド・ゴ・イチアを描いていただきたくリクエストを送らせていただきました。\n\nララドはひとつの物語における黒幕キャラです。優しく穏やかな雰囲気の人格者ですが、微かに得体の知れない奇妙な違和感を滲ませています。\n\nイラストにつきまして、簡単にで構わないのですが、背景のついた一枚絵を描いていただけましたら幸いです。イメージは、中世ヨーロッパのような街並み、ゴシック建築・インテリア、ダークファンタジーの空気感です。ポーズ、シチュエーションはお任せさせていただければと存じます。\n\n以上、お忙しいところ恐れ入りますが、ご検討の程よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1-CuItPET2PA0v2T4if_pcDc1z2Wo7kC3", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ujikawa_03/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1568260, "client_id": 534110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a296a7e9/uploads/origins/46fc0a15-b