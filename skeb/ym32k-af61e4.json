d3b8a0de/uploads/origins/aaac5fa6-541b-4d50-8fee-cdbb40e65e35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9236d064e2616ee5c874772ffa9283e8, https://si.imgix.net/d3b8a0de/uploads/origins/aaac5fa6-541b-4d50-8fee-cdbb40e65e35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c9375348f8ee55b57fa57f59654e274 2x, https://si.imgix.net/d3b8a0de/uploads/origins/aaac5fa6-541b-4d50-8fee-cdbb40e65e35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8a93162b587ef533a26984643640a717 3x"}, "body": "またよろしければオリキャラ竜人のシリュウがトラブルに見舞われた姿をお願いします。\n\nシリュウが魔物と激闘して倒したが魔物が倒れ際に放った強力な石化ブレスの煙を浴びてしまい\n煙が消えた頃には完全に身体が石化してしまう。\n風圧で身体が煽られて踏ん張ってるような体勢をした竜人の石像が\n助けがこないまま時間が経過して劣化して佇んでいる雰囲気でお任せでお願いします。\n\n・シリュウ参考画像\nhttps://drive.google.com/file/d/1MXNTZCpUL9XTLRG65uYCVmcUSXaOkgN1/view", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ym32k/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1495726, "client_id": 498295, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b58bd316/uploads/origins/9dbfb2a5-a4db-4ce3-b8c0-626dd6398a38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c572ed914d54332df0f827821b770f25", "srcset": "https://si.imgix.net/b58bd316/uploads/origins/9dbfb2a5-a4db-4ce3-b8c0-626dd6398a38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c572ed914d54332df0f827821b770f25, https://si.imgix.net/b58bd316/uploads/origins/9dbfb2a5-a4db-4ce3-b8c0-626dd6398a38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c52b9e23d028609576f7fa76fa65ac33 2x, https://si.imgix.net/b58bd316/uploads/origins/9dbfb2a5-a4db-4ce3-b8c0-626dd6398a38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0eccdb9ef9a9464c08deec92e5071d64 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b58bd316/uploads/origins/9dbfb2a5-a4db-4ce3-b8c0-626dd6398a38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56fe4411be051e2abe335ea053c3ee26", "srcset": "https://si.imgix.net/b58bd316/uploads/origins/9dbfb2a5-a4db-4ce3-b8c0-626dd6398a38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56fe4411be051e2abe335ea053c3ee26, https://si.imgix.net/b58bd316/uploads/origins/9dbfb2a5-a4db-4ce3-b8c0-626dd6398a38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4315e0050c2d92ea563fe1de172b79af 2x, https://si.imgix.net/b58bd316/uploads/origins/9dbfb2a5-a4db-4ce3-b8c0-626dd6398a38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a96b945e7fbfd5da91da19955d28f10b 3x"}, "body": "はじめまして。\nよろしければオリキャラ狼獣人のリュガロがトラブルに見舞われた姿を描いて頂きたいです。\n\nリュガロが迷宮探索中に石化の呪いが籠められたトラップの発動に巻き込まれて\nそれに驚いて一瞬反応が遅れて逃げようとした体勢のまま石化してしまい\n迷宮内に驚きの表情を浮かべた精巧な狼獣人の石像がひっそりと佇んでいるイメージで\nどのような雰囲気でも構いませんのでお任せでお願いします。\n\n・リュガロ参考画像\nhttps://drive.google.com/file/d/1FiGmonsltgfLreYDUyzKa-ub61HGXmEz/view", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ym32k/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1495726, "client_id": 3051732, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bba484f5/uploads/origins/f92a608e-4a1a-4f26-8958-2e8b71d233b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b098d91dc21a8f44b19e845416a09037", "srcset": "https://si.imgix.net/bba484f5/uploads/origins/f92a608e-4a1a-4f26-8958-2e8b71d233b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b098d91dc21a8f44b19e845416a09037, https://si.imgix.net/bba484f5/uploads/origins/f92a608e-4a1a-4f26-8958-2e8b71d233b5?bg=%23fff&auto=format%2Ccompress&fm=w