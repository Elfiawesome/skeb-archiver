んの描かれる男性キャラがかっこよく、また清涼感のある鮮やかな色使いのイラストが美しく、この度あむまもさんの絵柄で見てみたいイラストがあり、ご依頼させていただきました！\n\n潜航機動隊に参加している自宅キャラクターが組んでいるうちよそCP「イオキョウ」を描いていただくことは可能でしょうか？\nご依頼にあたり、相手の親御さんには許可をいただいております。デザインや設定は添付の資料にまとめております。\n\n・転生後の水瀬伊於と虍藤恭八郎くんの女優位の男女カップリングです。転生後の恭八郎くんは185cm92kgあり、眼鏡をかけています。\n・服装は学生服を着ている姿でお願いします。恭八郎くんは学ラン、伊於は白セーラーです（夏服と冬服どちらでも問題ありません！）\n・シチュエーション等はお任せします！が、清涼感のある青春を思わせるイラストだと嬉しいです！\n\nこちらご検討いただけますと幸いです。よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1KPzk25LDQ759Hyz-GvLpr8KtHo89ECin", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 663892, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "コバヤシ⁉️", "screen_name": "iaia_58", "avatar_url": "https://pbs.twimg.com/profile_images/1879864942024916993/qF118kpe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1668309895777763328/1759167662/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 45, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "banned": false, "nc": 16}, {"id": 826517, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "輪九@skeb募集中", "screen_name": "link53tw", "avatar_url": "https://pbs.twimg.com/profile_images/1688873124778127360/41mq21aW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/404600149/1775792146/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 1498805, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ふじよしはる", "screen_name": "DLHL0219", "avatar_url": "https://pbs.twimg.com/pr