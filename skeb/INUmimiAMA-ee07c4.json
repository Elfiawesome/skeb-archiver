22-493c-bda0-2e99069e9cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=290fe36a910406067f098d3e94428030", "srcset": "https://si.imgix.net/e4d22c3d/uploads/origins/a0aa2f55-ea22-493c-bda0-2e99069e9cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=290fe36a910406067f098d3e94428030, https://si.imgix.net/e4d22c3d/uploads/origins/a0aa2f55-ea22-493c-bda0-2e99069e9cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fafe002dfdd218f085a8b42de6ec2c02 2x, https://si.imgix.net/e4d22c3d/uploads/origins/a0aa2f55-ea22-493c-bda0-2e99069e9cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8eca8b51899cc86e1e1fb9ba5090c2e6 3x"}, "body": "こんばんは。野菜田isukiと申します。\nキラキラした宝石みたいなお目目が素敵です！素敵なイラストに惹かれて、\nぜひ私の創作、野菜擬人化創作、ベジラブるフュージョンのキャラクターを誰かを描いて欲しいと思いました！\n\n6人メインのキャラクターと忘れやすいポイント\n\n・玉山甘根(たまやま あまね) 玉ねぎの擬人化 168センチ 口元にホクロあり \n\n・仁陣(にん じん) 人参の擬人化 178センチ ヘッドバンドに白い線あり\n\n・出雲芽依(いずもめい) じゃがいもの擬人化 174センチ\n\n・大雄寺権(だいおうじ ごん) 大根の擬人化 185センチ 髪に緑のグラデーションあり\n\n・的馬斗磨(まとま とうま) トマトの擬人化 170センチ 左耳に黒の耳飾りあり 髪にオレンジのグラデーションあり\n\n・唐山梓真(とうやま あずま) ピーマンの擬人化 175センチ\n\n\nが居るので、好きな・描きやすいキャラクターで構いません。\n\nシチュエーション・構図も自由におまかせします。デザインも描きやすいように変更して頂いても構いません！\n犬耳あまさんの思う最高に萌える1枚をお願いします！\n\nパロコラ⬇️(親キャラという画面からキャラクター詳細が見れます)\nhttps://parocolla.net/users/profile/yasaiprince1\n\nTwitter⬇️\nhttps://x.com/yasai_prince/status/1999139927959667070?s=46&t=y_KGX2YCwZEburRKwrl6rg\n\npixivアカウント(skeb資料用の漫画やイラストはここにあります)⬇️\nhttps://www.pixiv.net/users/122826606", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@Hino_888/works/52", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3318975, "client_id": 3913881, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8ffff9b/uploads/origins/210c4f80-c385-4154-a369-95cc8a2fa77c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac646b29f2882736f380c5d1ad7da6cc", "srcset": "https://si.imgix.net/e8ffff9b/uploads/origins/210c4f80-c385-4154-a369-95cc8a2fa77c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac646b29f2882736f380c5d1ad7da6cc, https://si.imgix.net/e8ffff9b/uploads/origins/210c4f80-c385-4154-a369-95cc8a2fa77c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c34b9c5a80c048e482ac29da1b7e79ee 2x, https://si.imgix.net/e8ffff9b/uploads/origins/210c4f80-c385-4154-a369-95cc8a2fa77c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e99c8dd860b1ec83b33bd9197183bd4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8ffff9b/uploads/origins/210c4f80-c385-4154-a369-95cc8a2fa77c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9c47e6a20586dde6d0fa5ffd0a1f209", "srcset": "https://si.imgix.net/e8ffff9b/uploads/origins/210c4f80-c385-4154-a369-95cc8a2fa77c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9c47e6a20586dde6d0fa5ffd0a1f209, https://si.imgix.net/e8ffff9b/uploads/origins/210c4f80-c385-4154-a369-95cc8a2fa77c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c57ea9cfcdde77cf43687e683f63dc8 2x, https://si.imgix.net/e8ffff9b/uploads/origins/210c4f80-c385-4154-a369-95cc8a2fa77c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=051abe17c127aa8e033eebba1c0f7115 3x"}, "body": "こんにちは！いつもお忙しい中、最高のイラストをアップしてくださりありがとうございます！大好きです！特に体格差がほんま…！！！ありがとうございます！！！\n\n再度の依頼になるのですが、OCふたりのイラストを描いていただきたいです…！！\nたくさんずっと見ていたいので、PCの壁紙にしたいなぁと考えております。(前に描いていただいたものも両方ともずっと壁紙に設定しております…！すべて並行して使用していく予定です！)\n\n\nキャラクター詳細\n\n同じ騎士団で働く上司と部下。剣以外に興味がなかったふたりが仲良くなっていく話です。\n\n\n1人目、赤髪に金グラデの女の子　レオニス\n身長→162cm\n年齢→18\nラウフのことはすごいと思っているし信頼している(仲間、友人)\n手にひどい傷があり、常に手袋をしているが、ラウフに勲章だと言ってもらえてとっても嬉しかった…！\nいつもニコニコして、あまり顔に出ないけれど跳ねのけられるとちょっと傷つく。落ち込んでいると撫でてくれるのがなぜかお気に入り。\n\n\n2人目、茶髪に白グラデの男性　ラウフ\n身長→198cm\n年齢→26\nレオニスのことが大好き。かわいすぎ。何があっても守りたい！\nが、何もかもが初めてなのでうぶな反応をしてしまうし、照れるあまりに跳ねのける、睨むなど、傷つけることをしてしまうこともある。傷つけてしまったらほんとうに必死で謝る。\n落ち込んでたら昔母にそうしてもらったように、なでたりもする。\n\n\n\nシチュエーションなどは日野さんにお任せしたいです！\n(手をつないでいる描写があると大変うれしいです！)\n\n\nもし問題がある場合は訂正をお願いいたします、\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1Xkivxz4DMvOU4_KJ-f59FMaScqo7zz16?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@motigome_0130/works/46", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2065663, "client_id": 3913881, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e31af9e/uploads/origins/e1668390-a105-4e4a-abff-b62fa014c1b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=515b37e0ff991c89b8c7af0809bbbd97", "srcset": "https://si.imgix.net/0e31af9e/uploads/origins/e1668390-a105-4e4a-abff-b62fa014c1b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=515b37e0ff991c89b8c7af0809bbbd97, https://si.imgix.net/0e31af9e/uploads/origins/e1668390-a105-4e4a-abff-b62fa014c1b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b89ec696738ab018039e02f33c4374d 2x, https://si.imgix.net/0e31af9e/uploads/origins/e1668390-a105-4e4a-abff-b62fa014c1b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a81003e68f97757935ce079939333319 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e31af9e/uploads/origins/e1668390-a105-4e4a-abff-b62fa014c1b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=712e4d7e9d35d6387a81deac45edb87a", "srcset": "https://si.imgix.net/0e31af9e/uploads/origins/e1668390-a105-4e4a-abff-b62fa014c1b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&