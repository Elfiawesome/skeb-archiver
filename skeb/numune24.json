total_appeals_count": 0, "received_works": [{"path": "/@numune24/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3606625, "client_id": 3534931, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e129ede/uploads/origins/fe70ce21-5d92-404c-aec9-0291727f104c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26818e31505a85a0808024819e54965d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e129ede/uploads/origins/fe70ce21-5d92-404c-aec9-0291727f104c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b5dff83c41bc7963fb7b7012a9bcb97", "src_set": ""}, "body": "先生、こんにちは、\n\n先生の絵がとても好きです。僕のVTuberを描いてくれませんか？\n\nアクセルは、神秘的で難解な領域に深く同調する孤独なローバーである。多くの人が尻込みするような依頼も引き受け、しばしば超自然的なものに遭遇する。そのようなとき、彼は落ち着きのない精霊の助けを借りて敵を倒す。驚くべきスピードで、熟練した暗殺者のように正確かつ優雅に動く。しかし、その激しい決意の裏には、温かく親しみやすい態度がある。\n\nアクセルは現在、自分の家として使っている廃倉庫でくつろいでいる。\n\nリラックスした姿、激しい姿、幸せそうな姿、おどけた姿、どれを描いてもいい。ジャケットバージョンとジャケットなしバージョンから自由に選んでください。\n\n\nあなたが似合うと思うものを自由に追加してください。\n\nhttps://drive.google.com/drive/u/1/folders/10I4W5xPhmy039RpznOuH1LNwRg-Hls9D", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@numune24/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3606625, "client_id": 3324122, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0bea2c95/uploads/origins/af2fa669-6afb-4f99-be88-60ea7bdc62c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=559706a6075a6b0caa1050693996627f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0bea2c95/uploads/origins/af2fa669-6afb-4f99-be88-60ea7bdc62c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2