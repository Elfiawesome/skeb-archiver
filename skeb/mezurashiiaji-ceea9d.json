-95b7-4bdd2445baf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11e0bf73b029a027448d98afe777790e, https://si.imgix.net/3dce27bb/uploads/origins/e2dfb186-c640-4238-95b7-4bdd2445baf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34dfc39fd6a53f3e3fdfea0b7cf3cbb1 2x, https://si.imgix.net/3dce27bb/uploads/origins/e2dfb186-c640-4238-95b7-4bdd2445baf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a911ae391c699f64f7c2bb3e9ebfe61 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3dce27bb/uploads/origins/e2dfb186-c640-4238-95b7-4bdd2445baf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=788c2ec29202be9afd1c3036e564f4ff", "srcset": "https://si.imgix.net/3dce27bb/uploads/origins/e2dfb186-c640-4238-95b7-4bdd2445baf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=788c2ec29202be9afd1c3036e564f4ff, https://si.imgix.net/3dce27bb/uploads/origins/e2dfb186-c640-4238-95b7-4bdd2445baf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0467b57ade7bd0611a7f92aa1591f6a 2x, https://si.imgix.net/3dce27bb/uploads/origins/e2dfb186-c640-4238-95b7-4bdd2445baf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e1a7da1ea8d21cdbdc5b9160a9ae2ee 3x"}, "body": "先生こんにちは\n\n先生からの古戦場ボストリオを完成させたいと思います。今回はマーズを描いてください。\n\n鎧や頭髪は簡略化していただいて結構です。武器は描かなくても大丈夫です。\n\nマーズは照れくさそうな表情で、まだ見ぬ鑑賞者を振り返っています。マーズの前にはベッドがある。 マーズといえば、お尻にフォーカスしたものでなければならないと思うのです。\n\n適当なものがあればテキスト版で入力してください。\n\n希望するポーズの参考画像を添付します。よろしくお願いします。\n\nhttps://sta.sh/211a6tagq6oa", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mezurashiiaji/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 164022, "client_id": 2622678, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69a415e6/uploads/origins/c457ee38-3f11-4487-b736-3915adcb7e05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad154e40ae5a5e050ba33863c40fa820", "srcset": "https://si.imgix.net/69a415e6/uploads/origins/c457ee38-3f11-4487-b736-3915adcb7e05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad154e40ae5a5e050ba33863c40fa820, https://si.imgix.net/69a415e6/uploads/origins/c457ee38-3f11-4487-b736-3915adcb7e05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7845d891292a9c75a20e83895f5e8fb 2x, https://si.imgix.net/69a415e6/uploads/origins/c457ee38-3f11-4487-b736-3915adcb7e05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=196fb66d5b276ee66cb9be7b25993ae4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69a415e6/uploads/origins/c457ee38-3f11-4487-b736-3915adcb7e05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03f2aa44b3a669f5d1ee7bcb9e784e97", "srcset": "https://si.imgix.net/69a415e6/uploads/origins/c457ee38-3f11-4487-b736-3915adcb7e05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03f2aa44b3a669f5d1ee7bcb9e784e97, https://si.imgix.net/69a415e6/uploads/origins/c457ee38-3f11-4487-b736-3915adcb7e05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b8a6674a589670bd56e71feabc8f14bf 2x, https://si.imgix.net/69a415e6/uploads/origins/c457ee38-3f11-4487-b736-3915adcb7e05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=94865f1d8d89c49db7c6a5efa1bc2bde 3x"}, "body": "ちんみ様\n\n初めまして、個人Vチューバーとして活動をしている空望くみ花（そらもちくみか）と申します。\n\n私事ですが、4月1日に活動1年になります。\nそれを機に、YouTubeやTwitterでサムネイル、宣伝、動画、配信、アイコン、ヘッダー等に使うイラストをちんみ様に描いていただきたいです。\n\n希望として、キャラクター（空望くみ花）、背景や文字を別レイヤーでお願いしたいです。\nファイルはPNGだと助かります。\n\n■リクエスト内容\n下からのアングルでパーカー系の可愛い感じの服装、カメラ目線の全身像を希望します。猫を飼っているので一緒にいると嬉しいです。\n髪型、ポーズなどはお任せしたいです。アクセなどもあると嬉しいです。\n\n設定として、髪はグレー系、ヘアピンまたはヘアゴムにでバッテンにしてゆってる？感じ。\n身長153センチ、バストA～B、甘いものが好きな女の子です。よく寝ます。\n\nご検討宜しくお願い致します！\n\n空望くみ花\n\n参考\nhttps://www.youtube.com/@soramochikumika\nhttps://twitter.com/soramochikumika\n\nhttps://www.youtube.com/@soramochikumika", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mezurashiiaji/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 164022, "client_id": 1525507, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/592669ae/uploads/origins/586c7430-5b75-475a-a5bf-1b4b97f1330b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0c7a76d118075b6f71655599eeac70f", "srcset": "https://si.imgix.net/592669ae/uploads/origins/586c7430-5b75-475a-a5bf-1b4b97f1330b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0c7a76d118075b6f71655599eeac70f, https://si.imgix.net/592669ae/uploads/origins/586c7430-5b75-475a-a5bf-1b4b97f1330b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05b246ff2ca6652a45a388dd48f81c11 2x, https://si.imgix.net/592669ae/uploads/origins/586c7430-5b75-475a-a5bf-1b4b97f1330b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9650666d6bd20cb0999b8cae66c49394 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/592669ae/uploads/origins/586c7430-5b75-475a-a5bf-1b4b97f1330b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cf7837dd8c2e0f0599a1ce6cb909d7d", "srcset": "https://si.imgix.net/592669ae/uploads/origins/586c7430-5b75-475a-a5bf-1b4b97f1330b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cf7837dd8c2e0f0599a1ce6cb909d7d, https://si.imgix.net/592669ae/uploads/origins/586c7430-5b75-475a-a5