ss&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96648e0399535fcd31b24139f6e0915c", "src_set": ""}, "body": "こんにちは。藤田さんの描く絵がとても好きなので、X等のアイコンやスマホの壁紙に使用できるイラストをお願いしたいです。\n珈琲と短髪の青年(短髪、黒眼鏡、髭なし)をテーマにイラストを描いて欲しいです。ポーズや構図はお任せします！\n\n抽象的なリクエストになりますが、ご検討よろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@16hiroorih61/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2586065, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5624a50/uploads/origins/0f0867e4-d4a5-4de3-ae6e-13e4101f6b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf89fa5a2673084d30a4d1bfeae40993", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5624a50/uploads/origins/0f0867e4-d4a5-4de3-ae6e-13e4101f6b7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce995a848ebf97b57aac2ad42736a1e2", "src_set": ""}, "body": "ヒロさんの絵柄や色使いが大好きなのでイラストをお願いしたいです。\n自作楽曲のMVに使うイラストをお願いしたいです。\nMVはニコニコ動画、YouTube、Twitter等へ投稿します。\nまた、note記事のサムネに使用させていただく可能性があります。\n・サイズ：16:9、5760×3240px\n・リュックまたはビジネスバッグを持ち、スーツを着たサラリーマン（上京した新社会人）\n・シーンは電車内、もしくは駅のホームで電車待ちをしているところ\n・MVのシーンによって人物のみや背景のみの画像を使用させていただく可能性があります\n\n資料URLは楽曲デモ版です。\n\nお引き受けくださるとうれしいです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/15RIGJkclH2Z7VmUaockawAlZ8WtmH_G6/view?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@16hiroorih61/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2586065, "client_id": 375954, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65ae6e9a/uploads/origins/1f55b12f-e208-49e1-8866-7dd9dfcce0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bf5fb32b8da4ca1866d3c433f2c9e3f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65ae6e9a/uploads/origins/1f55b12f-e208-49e1-8866-7dd9dfcce0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=655a3d51893fa10bd59a9ef55ff1e28a", "src_set": ""}, "body": "はじめまして！\nもしよろしければ、私のオリジナルキャラクターを描いていただけませんか？\n「日常生活」をテーマに、あなたのキャラクターを描いてほしい。構図はお任せします！\n\nキャラクター情報\n名前：森雷/サンレイ（SANREI）\n特徴：白い髪、金色の目、虎の耳と尻尾\n性格：自信、元気、集中力が高い\n\nイヤーペンダントとおさげはキャラクターの重要な特徴なので、必ず描いてください🙇‍♂️\n\nキャラクターの衣装デザインは2種類ありますので、2つの服のデザインの違いは、コートと帽子だけです。1つ目の服装はグレーのジャケットを腰に結ぶデザインで、もう1つは透ける半袖のジャケットです。お好きなものの1つを選んで描けばいいですね！\n\n好きなように描いてください！\n\nSNS（バナー・アイコン等）で使用したいです！\nご検討のほど、何卒よろしくお願い致します。\n\n参考資料↓\nhttps://drive.google.com/drive/folders/1HJj31d-LMqIagNMH51ZZDc5BBZdECNhP?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@16hiroorih61/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2586065, "client_id": 360832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/567cfbd0/uploads/origins/8a6f0a2c-f7c2-471a-8d9d-e36397335b40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496c508cc3f66d3dd684b684abd77e6e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/567cfbd0/uploads/origins/8a6f0a2c-f7c2-471a-8d9d-e36397335b40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=927ee893d0aa8da077934ece49f698d8", "src_set": ""}, "body": "こんにちは。\nリハビリを兼ねてでも再開したいただき嬉しい限りです！\n\n前回描いていただいたSNSアイコン用の彼をお願いします。\n今回は鼻歌でも歌いながらフライパンを振ってるイメージが希望で、アイコンにも使用したい感じです。\n相変わらずボンヤリした感じの依頼ですがよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@16hiroorih61/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6ee6f8b3/uploads/origins/08daf7c0-e9dd-4ed3-b610-74f791ec5eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02ab856e21ac4bfa9d1733a0e0de47d2", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2586065, "client_id": 3284996, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@16hiroorih61/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2586065, "client_id": 45444, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5cc66879/uploads/origins/fc4b7015-f279-4c1d-9b75-ce5a9d349410?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34eb91f9543787e0d64bd9cc2c75d9bb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5cc66879/uploads/origins/fc4b7015-f279-4c1d-9b75-ce5a9d349410?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=425e8fd5d4409bea50fca5fa6f5fefba", "src_set": ""}, "body": "再開とても嬉しく思っております。以下のリクエストをお願いします。\n\n・20代前半男の子\n・工房で働いてるイメージ。ツナギの上を脱いだ状態でTシャツ、軍手をつけた手でアゴ下の汗をぬぐっている\n・暑さにまいって半目、口はへにゃっとしている\n・ぬぐう手に工具持ってると嬉しいですが作画コストと相談で\n・アングル、画角はおまかせで\n\nよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@16hiroorih61/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2586065, "client_id": 1807381, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a12b2ca/uploads/origins/ecd30937-6166-426f-a17d-159cce260399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efe32bae029c12846e5d26c090f0d37e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a12b2ca/uploads/origins/ecd30937-6166-426f-a17d-159cce260399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2e00732106a0e19505bef92be08092d", "src_set": ""}, "body": "こんにちは。雷柏磷と申します！\n\n今回は1920*1080のイラストを1枚依頼したいです。\n雷柏磷の設定は体育教師、少年の設定は雷先生の許嫁です。\n\nプロット内容は二人、2人がホテル内のバスルームに、ポーズやシーンを自由に決めてください。純愛の雰囲気を際立たせてみてください。\n\nhttps://drive.google.com/drive/folders/1JTXN3Y0th9jwtqbBkm9RtbMJ20cXcfRs?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@16hiroorih61/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2586065, "client_id": 360832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d74b1e0e/uploads/origins/61664c30-4e6e-41a0-9930-2fcc6cc6604a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5f47406375ffd8f83bb19a11693aca5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d74b1e0e/uploads/origins/61664c30-4e6e-41a0-9930-2fcc6cc6604a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f21fb36538c2df8361b8ebef78ef6d7", "src_set": ""}, "body": "こんにちは。\n\n【ネコと青年(髭無し）】をテーマに描いていただきたいです。\n構図はお任せで、スマホの待ち受けにして末永く愛でられたらいいなぁと思います。\nぼんやりとした依頼で申し訳ないのですが、お受けいただければ幸いです。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@16hiroorih61/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c4c86a24/uploads/origins/d0cf507b-eb8f-4895-8914-a6c143b37eb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf6eff8cdc24450b2d