ression.\nThe ring costume can be a bikini or a normal bikini of the original anime. The ring is not easy or necessary. Thank you very much.\nhttps://www.pixiv.net/artworks/102553153\n\nhttps://www.pixiv.net/artworks/102553153", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sleet126/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1406309, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72706422/uploads/origins/cefc7609-9451-448d-aad8-29d2b78e5274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd067eee94b5e2674c74de056abcbc08", "srcset": "https://si.imgix.net/72706422/uploads/origins/cefc7609-9451-448d-aad8-29d2b78e5274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd067eee94b5e2674c74de056abcbc08, https://si.imgix.net/72706422/uploads/origins/cefc7609-9451-448d-aad8-29d2b78e5274?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8222a6f0c4a8acd4ee8769e7f1e61c35 2x, https://si.imgix.net/72706422/uploads/origins/cefc7609-9451-448d-aad8-29d2b78e5274?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bdb0e52bca702cb3f20a00db4ae02788 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72706422/uploads/origins/cefc7609-9451-448d-aad8-29d2b78e5274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0074f8677a5d4dfee9dc9a38ee1db98b", "srcset": "https://si.imgix.net/72706422/uploads/origins/cefc7609-9451-448d-aad8-29d2b78e5274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0074f8677a5d4dfee9dc9a38ee1db98b, https://si.imgix.net/72706422/uploads/origins/cefc7609-9451-448d-aad8-29d2b78e5274?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cdfd5ebd0e0b95c4b0f3de