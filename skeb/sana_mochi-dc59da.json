のイメージでのイラストで構いません）\n\n以上が私の要望ですが、わかりにくい点や難しい点等ございましたら先生のやりやすいようにアレンジしていただいて構いません。\nよろしくお願いいたします。\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%8F%E3%83%84%E3%83%A6%E3%82%AD%E3%82%BD%E3%82%A6", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sana_mochi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2844415, "client_id": 706365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/496872e7/uploads/origins/9272ef79-3167-42d7-bd80-047e0ccf8a4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3b2a79c99689e9b1f44bfa84561d9fc", "srcset": "https://si.imgix.net/496872e7/uploads/origins/9272ef79-3167-42d7-bd80-047e0ccf8a4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3b2a79c99689e9b1f44bfa84561d9fc, https://si.imgix.net/496872e7/uploads/origins/9272ef79-3167-42d7-bd80-047e0ccf8a4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adaa1a57e3b71c78095ab13bc5c76b2b 2x, https://si.imgix.net/496872e7/uploads/origins/9272ef79-3167-42d7-bd80-047e0ccf8a4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f06dca8a72de7eb4fc1129451b6baf5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/496872e7/uploads/origins/9272ef79-3167-42d7-bd80-047e0ccf8a4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=032dd1dfb817ce6e932a64b235731f39", "srcset": "https://si.imgix.net/496872e7/uploads/origins/9272ef79-3167-42d7-bd80-047e0ccf8a4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=032dd1dfb817ce6e932a64b235731f39, https://si.imgix.net/496872e7/uploads/origins/9272ef79-3167-42d7-bd80-047e0ccf8a4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f89dfa4