a-6a20-46eb-9225-669a5e86c756?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccba11641c8ed99bfded6ee635e2d2c9, https://si.imgix.net/846739c3/uploads/origins/e95fca7a-6a20-46eb-9225-669a5e86c756?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=627cc06e11e2f812b57192f3c4737064 2x, https://si.imgix.net/846739c3/uploads/origins/e95fca7a-6a20-46eb-9225-669a5e86c756?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d92735fad78cac24b21984ac9037470 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/846739c3/uploads/origins/e95fca7a-6a20-46eb-9225-669a5e86c756?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fcd1a8071a14b99e0a1c0b27a371f88", "srcset": "https://si.imgix.net/846739c3/uploads/origins/e95fca7a-6a20-46eb-9225-669a5e86c756?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fcd1a8071a14b99e0a1c0b27a371f88, https://si.imgix.net/846739c3/uploads/origins/e95fca7a-6a20-46eb-9225-669a5e86c756?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=72d43d477f37eade9a947ac5d3cb8e9b 2x, https://si.imgix.net/846739c3/uploads/origins/e95fca7a-6a20-46eb-9225-669a5e86c756?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=602418e26d71d7acdd1390e15c798732 3x"}, "body": "初めまして、こんばんは。\nskebで拝見した麺太様のイラストがとても素敵で、是非依頼したいと思いリクエストさせていただきました。\nTRPGのCoCというゲームのオリジナルキャラクターのイラストをお願いしたいです。\n\n⭕️HO1 中瀬蒼(AO)\n身長185センチ25歳\n少し無愛想で見た目は冷たそうにみえるけど、音楽にはとても熱い音楽バカ。ユキの歌が好きだけど素直ではない。\n基本的に音楽のことしか考えていない朴念仁。\n4人バンド『dye』(ﾀﾞｲ)のギター＆ボーカル。\n動物で例えるとクロヒョウ。\n\n️⭕️HO2 星名 小雪(YUKI)\n身長175センチ25歳\nふわふわ飄々としている自由人。顔がとてもきれい。欲望には忠実で蒼と出会う前はセフレもいた。距離が近く寂しがり屋。\n3人バンド『NovaLights』(ノヴァライツ)のベース＆ボーカル。\n動物で例えるとユキヒョウ。\n\n両方メジャーデビューしているバンドマンで、友達以上恋人未満の関係。 \n\n 麺太様の描かれる詰め込みイラストの人物の表情がとても素敵なので好きなように描いて頂けましたら嬉しいです。(服や髪型のアレンジなどもなんでも大丈夫です。)\n見た目等の資料はURLでお送ります。\n\nご縁がありましたら嬉しいです。\n\nhttps://drive.google.com/drive/folders/15oiRpGWVek3gH-Wbb_KmwAtiHT5j6xz8", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ske6_bs/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3668055, "client_id": 1208881, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63f8a512/uploads/origins/51d71af2-965b-496b-b51f-d81621884b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00d30319b860fe681a5edd3d80e92eda", "srcset": "https://si.imgix.net/63f8a512/uploads/origins/51d71af2-965b-496b-b51f-d81621884b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00d30319b860fe681a5edd3d80e92eda, https://si.imgix.net/63f8a512/uploads/origins/51d71af2-965b-496b-b51f-d81621884b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7dfb4cc0d7e625a2f0d408053d812db 2x, https://si.imgix.net/63f8a512/uploads/origins/51d71af2-965b-496b-b51f-d81621884b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ee0edb41343d365acca4ab69f294b04 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63f8a512/uploads/origins/51d71af2-965b-496b-b51f-d81621884b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cab1f6374f53724ef77fe59ec41c495", "srcset": "https://si.imgix.net/63f8a512/uploads/origins/51d71af2-965b-496b-b51f-d81621884b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cab1f6374f53724ef77fe59ec41c495, https://si.imgix.net/63f8a512/uploads/origins/51d71af2-965b-496b-b51f-d81621884b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fc0f1953006af3f7e4daf19fdfbac007 2x, https://si.imgix.net/63f8a512/uploads/origins/51d71af2-965b-496b-b51f-d81621884b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1dbef1263b6aab8179d8fe641f2a2aa8 3x"}, "body": "彼らの物語は、運命の糸が人々を結びつける世界を舞台にしています。糸の色はさまざまで、片思いは黄色い糸となり、ネガティブな感情や執着は黒い糸となり、赤い糸は運命の恋人同士を結ぶものです。この糸を見ることができる人はごくわずかです。\n\n🦊 スミン | 37歳 | 178cm \n\n質屋の店主。彼の秘密の仕事は「糸を切る」ことだ。スミンには、自分自身の糸を結ぶことができないという特異な能力がある。その代わり、彼は糸を断ち切る能力を持っている。\n\n狐のような魅力を持つ。気まぐれだが、同時に抜け目がない。他人を、自分の目標にとって有益か有害かのどちらかでしか見ない。気にかけない相手を見捨てることに何の躊躇いもない。糸を結べないため、自分自身は愛など存在しないと信じている。\n\nモチーフ：夜の海。夏の夕暮れ。線香花火。質屋。ハサミ。\n\n🐰 シカモア | 38歳 | 188cm \n\n小児外科医。成功を収めているが謙虚。気さくで友好的。人の心を読むのが得意。境界線を尊重し、予防措置として誰に対しても一定の距離を保っている。気まぐれに見えるが、本質的には極めて用心深い。\n\n彼には知らず知らずのうちに何百本もの糸が絡みついている。中には彼に執着する患者によって形成されたものもあれば、ある看護師の彼への執着から生まれた、より危険な黒い糸もある。\n\nモチーフ：秋の日。イチョウ。スズメ。夕暮れ。物差し。\n\n* 両目の下にほくろが一つずつある。\n* 傷跡、タトゥー、包帯は描かないでください。\n\n🦊🐰：シカモアは看護師にストーカーされ、最後の手段としてスミンの店を訪れる。シカモアは当初、「糸」というものを信じていなかったため、警戒していた。スミンはその警戒心を面白がり、シカモアをからかう。\n\nシカモアに絡みついた糸の数が多いため、週に2回、糸を切る予約を入れることになった。訪れるたびに、シカモアはスミンとの会話がますます刺激的だと感じるようになる。シカモアはスミンに恋をする。なぜなら、スミンだけがシカモアに自由を感じさせてくれる唯一の人物だからだ。\n\nシカモアは自分の気持ちを率直に伝える。スミンも惹かれているが、シカモアの赤い糸が他の誰かと結ばれることを知っており、警戒心を抱いている。\n\n構図、衣装、ポーズは自由です。ご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1RmyRSztQHsGaoUawS_aALd2_ZUKxhXh8?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ske6_bs/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3668055, "client_id": 350566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f033dbe/uploads/origins/efc96f1a-a5ab-45cf-8e2d-fd23bba441e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5258546be4825c00591ea2f07f4269d3", "srcset": "https://si.imgix.net/9f033dbe/uploads/origins/efc96f1a-a5ab-45cf-8e2d-fd23bba441e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5258546be4825c00591ea2f07f4269d3, https://si.imgix.net/9f033dbe/uploads/origins/efc96f1a-a5ab-45cf-8e2d-fd23