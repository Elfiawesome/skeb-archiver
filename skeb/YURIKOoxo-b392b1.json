よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1lsYa6PuiDVkQbFs0vuaO_YcznJOxVX1V?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YURIKOoxo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1160124, "client_id": 2778061, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0d52009/uploads/origins/cc19997a-db62-4745-b251-35ec358783fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f6a1b0c4b53c398f248473822814aa6", "srcset": "https://si.imgix.net/e0d52009/uploads/origins/cc19997a-db62-4745-b251-35ec358783fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f6a1b0c4b53c398f248473822814aa6, https://si.imgix.net/e0d52009/uploads/origins/cc19997a-db62-4745-b251-35ec358783fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6046b315202c344438c3bef5a82ccf3f 2x, https://si.imgix.net/e0d52009/uploads/origins/cc19997a-db62-4745-b251-35ec358783fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ba9b5ae40fcd20dec662e387f0eeb58 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0d52009/uploads/origins/cc19997a-db62-4745-b251-35ec358783fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5dc0d29aaf87bb0b903db68092550772", "srcset": "https://si.imgix.net/e0d52009/uploads/origins/cc19997a-db62-4745-b251-35ec358783fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5dc0d29aaf87bb0b903db68092550772, https://si.imgix.net/e0d52009/uploads/origins/cc19997a-db62-4745-b251-35ec358783fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c6dd80f55be52b2933f0887b399dec5e 2x, https://si.imgix.net/e0d52009/uploads/origins/cc19997a-db62-4745-b251-35ec358783fb?b