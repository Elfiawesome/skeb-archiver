に応募しに来て、アシスタントに選ばれた。コンスタンチンの日常生活や生活の世話をし、非常に従順で、忠犬のような性格に見え、コンスタンチンをとても頼りにしている。\n\nコンスタンティンはバイセクシャルなので、できれば女性器を描きたい！(このような設定が受け入れられない場合は、依頼をキャンセルしても構いません！)\n\n金額に満たない場合は、再度依頼を送っていただけると助かります！めんどくさいと思ったら、直接キャンセルしていただいて構いません。この度はご依頼をお受けいただき、誠にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1mP_-_aYjvuPUdyoPB12Sek3bUxpMOry1?usp=share_link", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tonamido/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/63fd2a6c/uploads/origins/69e155d1-cc98-48bf-bc23-74c2a47b8c05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37735574c3df2cfcf7bd0e9594b58a52", "srcset": "https://si.imgix.net/63fd2a6c/uploads/origins/69e155d1-cc98-48bf-bc23-74c2a47b8c05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37735574c3df2cfcf7bd0e9594b58a52, https://si.imgix.net/63fd2a6c/uploads/origins/69e155d1-cc98-48bf-bc23-74c2a47b8c05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7b4b7324e1772c5bcfebd794161422b 2x, https://si.imgix.net/63fd2a6c/uploads/origins/69e155d1-cc98-48bf-bc23-74c2a47b8c05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee95f8f366b2794c42ca1b66e4c030e2 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3192541, "nc": 32}, {"path": "/@tonamido/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/86050351/uploads/origins/5d7e27d8-0418-4e79-9f49-b31bc0ff8ff8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bol