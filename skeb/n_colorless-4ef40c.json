ザイクでもOKです。\n\n★参考URL\nhttps://dic.pixiv.net/a/ナンジャモ\nhttps://dic.pixiv.net/a/ハルト%28ポケモン%29\nhttps://img.game8.jp/7453371/596ab622cba4f58b845da099a4f927c7.png/original\n\nご検討いただけますと誠に幸いです。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@n_colorless/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c41b4adc/uploads/origins/8f4edb45-ec33-4367-b931-f195b6964844?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1259a2348d9b06321e6e5e3469af356e", "srcset": "https://si.imgix.net/c41b4adc/uploads/origins/8f4edb45-ec33-4367-b931-f195b6964844?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1259a2348d9b06321e6e5e3469af356e, https://si.imgix.net/c41b4adc/uploads/origins/8f4edb45-ec33-4367-b931-f195b6964844?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f61b54e36d1c526bc5e16fe414de4187 2x, https://si.imgix.net/c41b4adc/uploads/origins/8f4edb45-ec33-4367-b931-f195b6964844?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=06052a70ae4c702a39f53b7f3e36864f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2998968, "nc": 49}, {"path": "/@n_colorless/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2998968, "client_id": 962512, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f55ed455/uploads/origins/ac6ae740-4e46-48a5-ae7d-30d312626f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b661f6f8d66d07a61faa23d2