rticles/profile/arwW95YUZ3GMWg4BmrqC8ZoP\n\n【構図や衣装など】\n以前200°F様が描かれていたこちらのようなポーズでお願いできますでしょうか？\n（https://x.com/pattimon36/status/1799372126954357113）\n衣装は下着（ランジェリー系）でお願いいたします。\nまたもし可能であれば、ハート目の差分もお願いしたいです。\n\n可能でしたらデータはpsdで、\nキャラと背景のレイヤーを分けていただけると嬉しいです。\n\n以上になります。\n何卒ご検討よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pattimon36/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1099315, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f7461d4/uploads/origins/43d06d1f-11c5-4f0c-85c4-dd265001e200?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02a287d1bf0fbabcc6588c68c37e07b2", "srcset": "https://si.imgix.net/0f7461d4/uploads/origins/43d06d1f-11c5-4f0c-85c4-dd265001e200?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02a287d1bf0fbabcc6588c68c37e07b2, https://si.imgix.net/0f7461d4/uploads/origins/43d06d1f-11c5-4f0c-85c4-dd265001e200?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=602f1d6fd71a3e67448a9644a4a278ea 2x, https://si.imgix.net/0f7461d4/uploads/origins/43d06d1f-11c5-4f0c-85c4-dd265001e200?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfee09ebf56291b9af72c9b00f184d0c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f7461d4/uploads/origins/43d06d1f-11c5-4f0c-85c4-dd265001e200?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41f5ddb2f3e9fad7e5240c820737351a", "srcset": "https://si.imgix.net/0f7461d4/uploads/origins/43d06d1f-11c5-4f0c-85c4-dd265001e200?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41f5ddb2f3e9fad7e5240c820737351a, https://si.imgix.net/0f7461d4/uploads/origins/43d06d1f-11c5-4f0c-85c4-dd265001e200?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fi