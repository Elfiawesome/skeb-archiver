f-47cf-9106-a4cc33c99ada?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8ec46d0dfbe52d73972fe2dad913fd0", "src_set": ""}, "body": "「いちゃいちゃ♡モーニング」のJKちゃんで2コマイラストをお願いします。\n1コマ目:髪を束ねた裸Yシャツの姿で先生と密着対面座位キスハメ。\n・両者目元は見えず、唇をみっちり重ねて貪り合ってる。\n・「んっ♡…んんっ…♡♡」とJKちゃんの喘ぎ声が漏れてる。\n2コマ目:1コマ目と同じ姿でパイズリフェラ事後(先生視点)。\n・チンポをおっぱいで挟んだままの状態、乳首とはっきり瞳が写った両目が見えてる。\n・淫らな笑みを浮かべながら精液でいっぱいの口内(舌)を見せてる。\n・閉じてゴキュっと精液をごっくんしてるお口のワンカットあり。\n右から左にコマを並べて2コマ目を大きく描いていただければ幸いです。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@JiroHanzaki/works/24", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/20a762bf/uploads/origins/134b8159-1a4e-47c6-b25e-a9f87e7224b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac52f4b2faf4ef23d36e5dac314f1730", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1743634, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@JiroHanzaki/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1743634, "client_id": 1509886, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1b307f0/uploads/origins/9a2a7a36-0e7a-42cf-ad1b-9f73dbcc5c48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2825c8d8de8b5ea453f614b2c32d297e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1b307f0/uploads/origins/9a2a7a36-0e7a-42cf-ad1b-9f73dbcc5c48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0be306850ff9fd20a0b2a631271e6b9", "src_set": ""}, "body": "素敵なスーツを着て、杖をつき、お金を片手に、帽子をかぶったポン引きがサキュビに囲まれている絵が描けるだろうか？邪悪な笑みを浮かべているのは、彼が彼らの主人だからだ！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@JiroHanzaki/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1743634, "client_id": 2582195, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1836c7b/uploads/origins/caa30e5c-630b-4e8e-8d40-10553e373895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb8299a624018db23391e606d648c60e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1836c7b/uploads/origins/caa30e5c-630b-4e8e-8d40-10553e373895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=341c55a5f7fb5ab6e3f6a59ee70c2a7e", "src_set": ""}, "body": "こんにちは！\n\n　前回のリクエスト『男が希少で女が多いハーレム推奨の並行世界』に転移して校内唯一の男子となった絶倫ドスケベ高校２年生と、元いじめっ子の主人公ガチ惚れ勢と化した美少女３人グループとのハーレム４Ｐイチャラブセックスの続きで、黒髪ロングお嬢様とサイドテールツンデレ巨乳ヤンキーとツインテール甘えんぼメスガキの、それぞれが大量中出しされて絶頂シーンと、３人がシーツの上に全裸で川の字に並んで絶頂の余韻に浸りながらワレメからドロドロ中出し精液を溢れさせているシーンと、３人でうっとりしながら主人公の『専属苗床（セフレ）』になる宣言をするシーンをお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@JiroHanzaki/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1743634, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad2aff33/uploads/origins/32294b65-285f-47ed-b287-db43cf26a347?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2894aa1d9a9322c5fa971bb29ef51299", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad2aff33/uploads/origins/32294b65-285f-47ed-b287-db43cf26a347?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72255e1ceb65673cc2f12250738a83ab", "src_set": ""}, "body": "初めまして！\nモンスターハンターライズのヒノエ姉妹が慕っている女ハンターを夜這いし手籠めにしているイラストをリクエストさせて頂きます！\n女ハンターは両手首を縛られ、為す術なく一方的に絶頂させられている感じでお願いします。\n\n【女ハンター】\n・燃えるような赤髪で、イズチテールという髪型\n・黄色い瞳、ちょっと垂れ目気味\n・優しく優しいが押しに弱く、初心\n\nまた、ヒノエ姉妹は竜人族という種族で、指が4本となっていますのでご注意下さい。\n\nその他委細お任せします！\n何卒ご検討をお願いします！", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@JiroHanzaki/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1743634, "client_id": 2582195, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b35486f7/uploads/origins/24204522-94b9-41ad-8893-45d267fde405?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ec22b82dc1e9b24598e3152b2815009", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b35486f7/uploads/origins/24204522-94b9-41ad-8893-45d267fde405?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f16dd33103e6159b80f547cad9b06418", "src_set": ""}, "body": "はじめまして！\n\n　フツメン絶倫ドスケベ高校２年生が『男が希少で女が多いハーレム推奨の並行世界』に転移して学校唯一の男子となり、元の世界の学校で自分をいじめていた美少女３人グループ（３年生リーダー格スレンダー体型サラサラ黒髪ロング美乳高慢お嬢様・２年生金髪サイドテール巨乳ヤンキー・１年生茶髪ツインテール貧乳メスガキ）が従順な性格（高慢→おしとやか・ヤンキー→ツンデレ・メスガキ→甘えんぼ）に変わり３人とも主人公に惚れていたので、合法ハーレム全裸イチャラブ生ハメ中出しセックスでイカせまくり３人まとめてセフレにするシチュをお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@JiroHanzaki/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1743634, "client_id": 357882, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16bfddfe/uploads/origins/c20ab2df-4321-4a16-82d8-44a2143255a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc56d3c9f47f7bbb90ce1f30a02b5d42", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_