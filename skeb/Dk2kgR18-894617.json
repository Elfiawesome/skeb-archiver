//si.imgix.net/a12c655a/uploads/origins/2b1c74ec-9917-401e-8e73-57f02fe76d27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d7e2ec3aab28ed5642a9e7842c3885f0 3x"}, "body": "もしよろしかったら下記の内容でお願いいたします。\n\n■コミック依頼内容\n即落ち2コマ風にお願いします。\n\n・キャラクター\nホ□ライブの夜空□ルと癒月□ょこ\n\n・1コマ目\n参考資料動画(https://youtu.be/JkB-31qUkeU)の4分30秒頃のようにゲームの乳搾りをクスクス笑いながらプレイする二人。\n\n・2コマ目\n資料(https://www.pixiv.net/artworks/106802845#manga)のように、今度は壁乳状態の自分達が乳搾りをされ、獣のような雄叫びの媚声を叫びながら噴乳アクメをする。\n二人の顔写真が貼られたミルクサーバーに母乳がどんどん貯まっていく描写もあるとありがたいです。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dk2kgR18/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/61357a68/uploads/origins/a472e79b-2c64-4a67-962c-b59bf95c11ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8a355967973c74fdf0878c6298c7030", "srcset": "https://si.imgix.net/61357a68/uploads/origins/a472e79b-2c64-4a67-962c-b59bf95c11ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8a355967973c74fdf0878c6298c7030, https://si.imgix.net/61357a68/uploads/origins/a472e79b-2c64-4a67-962c-b59bf95c11ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e544e2cef8e9e43fb93adaf15fa93ff 2x, https://si.imgix.net/61357a68/uploads/origins/a472e79b-2c64-4a67-962c-b59bf95c11ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76730710acf6fdd0f64f1b0b2d3a31b3 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 712278, "nc": 33}, {"path": "/@Dk2kgR18/works/6", "private_thumbnail_