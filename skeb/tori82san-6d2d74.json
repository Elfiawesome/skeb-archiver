&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ecc1d14b8ddfc409d33d562b752d331 3x"}, "body": "彩とりさん、こんにちは！よいけと申します\n\nよければ自創作の子を描いていただきたいです！\n資料：https://drive.google.com/drive/folders/1XAcTNpkAv8qEtXJwyeDodTQlKEfX8x6h?usp=drive_link\n\nポーズやシチュエーション、衣装などにこだわりはありませんので\n改変等自由に描いていただけましたら幸いです\n\n等身、デフォルメのこだわりも無いため自由に描いていただきたいですが\n指定が必須な場合は、タイプBの描き方が特に好きなのでお願いしたいです！\n\n\n資料が少ないので、難しい場合や問題等ありましたら\n遠慮なくキャンセルや再送リクエストをお願いします\nご検討のほどよろしくお願いいたします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tori82san/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3331829, "client_id": 16618, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0258315/uploads/origins/106975d5-bc3a-4129-a447-248cc39bb821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7e1ea7b83704806255e7cc0d5a18bf3", "srcset": "https://si.imgix.net/d0258315/uploads/origins/106975d5-bc3a-4129-a447-248cc39bb821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7e1ea7b83704806255e7cc0d5a18bf3, https://si.imgix.net/d0258315/uploads/origins/106975d5-bc3a-4129-a447-248cc39bb821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab723d62b8dd13f5b4381614c24e0670 2x, https://si.imgix.net/d0258315/uploads/origins/106975d5-bc3a-4129-a447-248cc39bb821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f08e0b335f3c0a1cf660fc7617db36bd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0258315/uploads/origins/106975d5-bc3a-4129-a447-248cc39bb821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b5d74cb26ab3225955bc5349af7beb7", "srcset": "https://si.imgix.net/d0258315/uploads/origins/106975d5-bc3a-4129-a447-248cc39bb821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b5d74cb26ab3225955bc5349af7beb7, https://si.imgix.net/d0258315/uploads/origins/106975d5-bc3a-4129-a447-248cc39bb821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=90e39ce57fd14cd1c10944161905a7f9 2x, https://si.imgix.net/d0258315/uploads/origins/106975d5-bc3a-4129-a447-248cc39bb821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=afb4e9004e0222b078d5220fe18aa233 3x"}, "body": "私のオリジナルキャラのイラストをお願いしたいです。\n服飾などアレンジしていただけると嬉しいです（しなくても大丈夫です）\n\nよろしくお願いいたします。\n\nhttps://xfolio.jp/portfolio/erurich/works/6060113\nhttps://xfolio.jp/portfolio/erurich/works/4408572", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tori82san/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3331829, "client_id": 1907361, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b14f7cb/uploads/origins/d5191fac-7505-475f-9405-1164dae8162c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=393087ddab0da7d74489dd4f22f981aa", "srcset": "https://si.imgix.net/6b14f7cb/uploads/origins/d5191fac-7505-475f-9405-1164dae8162c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=393087ddab0da7d74489dd4f22f981aa, https://si.imgix.net/6b14f7cb/uploads/origins/d5191fac-7505-475f-9405-1164dae8162c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7082c99300c99a289a685a69946e38be 2x, https://si.imgix.net/6b14f7cb/uploads/origins/d5191fac-7505-475f-9405-1164dae8162c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a36098306ca66644ef7e2a5977f8341 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b14f7cb/uploads/origins/d5191fac-7505-475f-9405-1164dae8162c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=486d07851e7c02706adc497782e2ac4e", "srcset": "https://si.imgix.net/6b14f7cb/uploads/origins/d5191fac-7505-475f-9405-1164dae8162c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=486d07851e7c02706adc497782e2ac4e, https://si.imgix.net/6b14f7cb/uploads/origins/d5191fac-7505-475f-9405-1164dae8162c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0cca99c56d6d7990b844df830e6da4da 2x, https://si.imgix.net/6b14f7cb/uploads/origins/d5191fac-7505-475f-9405-1164dae8162c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=496039695802397f2ee92f28058aa623 3x"}, "body": "彩とり様\n　\nこんにちは、こたぱんと申します。\n\nいつも可愛らしいイラストを描かれるお方だなと拝見しておりましたところ、skeb募集をされていたのでリクエストさせていただきました。\n\n\n私のオリジナルキャラクター2人を描いていただけたら嬉しいです！\n外見の詳細は添付資料を参考にしてください。\n\n↓下記URLの資料が見られない場合\nhttps://x.com/kotatsukarakita/status/2078438922942840903/photo/1\nhttps://x.com/kotatsukarakita/status/2091129653885067264/photo/1\n\nもし2人とも描くのが難しければ、どちらか1人だけでも大丈夫です。\n今回はデフォルメではなく、通常の頭身でお願いできればと思っています。\nポーズ、構図、背景などはお任せします！\n衣装や髪型はお好きなデザインやキャラクターに似合うと思うものがある場合、そちらに変更していただけると嬉しいです。\n元の衣装を使っていただく場合も、細かいところは省略したりアレンジしたりしていただいて大丈夫です。\n彩とり様が普段描かれているような雰囲気のイラストにしていただけたら嬉しいです。\n\nまた、私のXアカウントで彩とり様に描いてもらった旨のコメントともに投稿したいと考えております。\n\n\n\n以下はキャラクターの性格などです。描く際の参考程度にしていただければと思います。\n\n・金髪の小さい方\nクールな研究者です。白髪のことは、手はかかるけれど可愛いと思っています。\n態度は大きいし、自分のことを天才だと言うちょっと困ったところがあります。\n可愛い服が好きで、似合うと思っていますが、性格と合わないのであまり人前では着ません。\n運動は苦手で走るたびに転びます。\n白髪が自分がいなくなっても不自由しないように、彼の言語を調べたり、人間の常識などを教えようとしています。\n\n・白髪の大きい方\nちょっと臆病な人外です。金髪のことは、頭が良くて優しいと思っています。\nまだまだ人間社会に慣れていませんが、知能と自認は成人男性です。\n脂肪と糖が大好きで、甘いものをよく食べます。コンピュータや運動が得意です。\n同じものを見てほしい、一緒についてきてほしいと言う気持ちで、金髪のことを勝手に抱えて運んだりします。\n\n\n\n内容的に難しいところや、イメージに合わないところがありましたら、キャンセルしていただいて大丈夫です。\nご検討いただけましたら嬉しいです！\nどうぞよろしくお願いします。\n\n@kotatsukarakita\n\nhttps://drive.google.com/drive/folders/1EeBlTU_pQIq6wrw39IEJtS9KOeVwvawo?usp=share_link", "nc": 128, "word_count": 0, "transcoder": "image", 