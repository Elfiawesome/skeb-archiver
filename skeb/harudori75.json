=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13117f5e67c9f3ceea233cfbac099c01", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/557be147/uploads/origins/bf9772bf-bb0b-4274-baa3-293d3b4a360c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb2fb5afe9642470f05b47a16ad102a2", "src_set": ""}, "body": "オミカ様\n\nこの度は素敵なアピールをいただき、誠にありがとうございます…！\nぜひ、お写真をお願いさせていただければと思っております！\n\n⬛︎使用用途 \nSNS宣伝、サムネ、将来的に商用可能性あり。 \n\n ⬛︎構図\n全身が見える構図で、ポーズ、表情などは全部オミカ様にお任せします。（表情差分があれば幸いです。）\nサムネ使用のため、頭や体が切れるのは避けていただけますと幸いです。\n\n ⬛︎納品 \n可能であればpsdファイルの納品だと助かります。\n\nもし金額に不備がございました再送も可能です。\nご縁がございましたら、ぜひお願い致します！\n\nhttps://drive.google.com/drive/folders/1Ram93AVaeFgK6C06UJVSX0QFJdHkqA3a", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@harudori75/works/161", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 825663, "client_id": 3512081, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ce57530/uploads/origins/5b649104-390c-47a5-af3e-a2655171271a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=498ae49e2b66611d38c3ea4c4c791280", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ce57530/uploads/origins/5b649104-390c-47a5-af3e-a2655171271a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92dd9fdb1496ca911db5d95f66a15c84", "src_set": ""}, "body": "はじめ\n Vtuberの影花れんと申します \nskebのアピールからオミカ様のイラストを拝見し是非お願いしたくご連絡致しました  \n\n配信のサムネやSNS上で使用出来るイラストをお願いしたいです  \n雰囲気としては \n・上目遣いで目元を影で暗くしながら笑っているダークな雰囲気 \n・左目のオッドアイ(黒)の赤い瞳孔が強調されている 形でお願いしたいです \n\n データはpsdで透過素材を希望で 三面図が無く正面からの素材しか無く申し訳御座いません。\nご検討頂けると幸いです\nよろしくお願い致します\n\nhttps://x.com/kagehana_renv/status/1925156240147284417?s=46", "nc": 0, "word_count": 0, "transcoder