描いていただけましたら幸いです。\n\n【そのほか】\n･リンク先資料内に新衣装･旧衣装ございますが、今回は新衣装でお願いいたします。サングラスや上着、アクセサリー等の着脱、小物の追加はお任せいたします！\n･普段の活動での利用や商用利用の可能性もありますので、ご了承いただければと存じます。\n･背景がある場合、透過画像もいただけたら嬉しいです！\n\n楽しみにお待ちしております✨\n\nhttps://drive.google.com/drive/folders/1Y62vz5k5yvvtaIhLDOweDVXXCNNmMrgY", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 398838, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ヒヨヨ@skeb募集中", "screen_name": "kou_hiyoyo", "avatar_url": "https://pbs.twimg.com/profile_images/1820725109768003584/nFqwhAAN.png", "header_url": "https://pbs.twimg.com/profile_banners/105523086/1725285923/1500x500", "appeal_receivable": false, "popular_creator_rank": 5, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 160}, {"id": 2417796, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "成河りん💫🚀🖌絵描き", "screen_name": "narukawarin_ne", "avatar_url": "https://pbs.twimg.com/profile_images/1950191144534786048/pJu0CzIy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1257139201130127360/1746887532/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "novel"}, {"genre": "video"}], "nc": 144}, {"id": 2441678, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "塩だれ", "screen_name": "SSS_iiiOP", "avatar_url": "https://pbs.twimg.com/profile_images/1875446498567286784/QmhBS18c.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1553722176591007747/1756475474/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_ac