to=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83e920b463f30dbeb9ec035c6af2cb08", "srcset": "https://si.imgix.net/2f17539e/uploads/origins/d1d3f84f-6b7a-4526-a6df-a20a18bac9ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83e920b463f30dbeb9ec035c6af2cb08, https://si.imgix.net/2f17539e/uploads/origins/d1d3f84f-6b7a-4526-a6df-a20a18bac9ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63c6a7af80af73b7e61401d001375dd0 2x, https://si.imgix.net/2f17539e/uploads/origins/d1d3f84f-6b7a-4526-a6df-a20a18bac9ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9587f63af3e13bb21f3d8c6a2e50f2a2 3x"}, "body": "Tiger様、どうかリクエストを送信させてください。\n　Tiger様の艦これ二次創作作品である『夜灯す電光雪火!』を読みましたが、深雪と電の絆と熱い展開の連続に心が燃えました。\n　もしよかったら、艦これの特型駆逐艦の一員である深雪と電のツーショットを描いて下さい。\n　私は絵に詳しくないので、詳細は全てお任せいたします。\n　ぜひ引き受けて欲しいと思っております。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@guraham7777/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 567174, "client_id": 448481, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cfa1962f/uploads/origins/6b946aeb-6478-4c10-b3d2-233c45bb993f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86e1c089040b3e8695b16322b63ab516", "srcset": "https://si.imgix.net/cfa1962f/uploads/origins/6b946aeb-6478-4c10-b3d2-233c45bb993f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86e1c089040b3e8695b16322b63ab516, https://si.imgix.net/cfa1962f/uploads/origins/6b946aeb-6478-4c10-b3d2-233c45bb993f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3d433d41a3b1cb9ce689af7cc6c5c56 2x, https://si.imgix.net/cfa1962f/uploads/origins/6b946aeb-6478-4c10-b3d2-233c45bb993f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=026306d2f60e43f1fac28e34e910e872 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cfa1962f/uploads/origins/6b946aeb-6478-4c10-b3d2-233c45bb993f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c2ef486e466f38fadbc0fe54e635ec8", "srcset": "https://si.imgix.net/cfa1962f/uploads/origins/6b946aeb-6478-4c10-b3d2-233c45bb993f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c2ef486e466f38fadbc0fe54e635ec8, https://si.imgix.net/cfa1962f/uploads/origins/6b946aeb-6478-4c10-b3d2-233c45bb993f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f975a7fd1affa33be73f7f0f97033cfa 2x, https://si.imgix.net/cfa1962f/uploads/origins/6b946aeb-6478-4c10-b3d2-233c45bb993f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0076025f298ec45ce63adf4b667569aa 3x"}, "body": "艦これの敷波と提督の身体が入れ替わり、敷波になった提督が鏡を見て驚いているイラストをお願いします。\n\n・提督(中身は敷波)の描写は不要です\n・構図は敷波(中身は提督)の一人称視点\n・敷波は片手は口元を押さえて、もう片方の手は胸に手を当てている\n・敷波からは吹き出しで中身である提督の顔を描いてください(制帽を被った男性とわかる程度で細かい表情は不要です)", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@guraham7777/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 567174, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d594344/uploads/origins/699eda2a-d45a-4875-afe9-232423acd0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa0a4351586aa3995a8cf889f20bd9ba", "srcset": "https://si.imgix.net/3d594344/uploads/origins/699eda2a-d45a-4875-afe9-232423acd0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa0a4351586aa3995a8cf889f20bd9ba, https://si.imgix.net/3d594344/uploads/origins/699eda2a-d45a-4875-afe9-232423acd0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01a921132994af9904f7b40f72155958 2x, https://si.imgix.net/3d594344/uploads/origins/699eda2a-d45a-4875-afe9-232423acd0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4d6a8f5a6b6f1eca9bdec454d5ffc08 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d594344/uploads/origins/699eda2a-d45a-4875-afe9-232423acd0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcb9d4b3fd60f86775aebab9170a73be", "srcset": "https://si.imgix.net/3d594344/uploads/origins/699eda2a-d45a-4875-afe9-232423acd0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcb9d4b3fd60f86775aebab9170a73be, https://si.imgix.net/3d594344/uploads/origins/699eda2a-d45a-4875-afe9-232423acd0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=205d02cb4c8c95d541eb2277648f4cec 2x, https://si.imgix.net/3d594344/uploads/origins/699eda2a-d45a-4875-afe9-232423acd0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8bb8e4e3033d93906317e6b7daaa695e 3x"}, "body": "手数料無料期間ですので、リクエスト再送いたします。\n\n前回の素晴らしい絶望感溢れる漫画を描いていただきありがとうございました。\n\n前回の漫画が素晴らし過ぎたので、同じ題材で更に１リクエスト大丈夫でしょうか？\nもっと護衛要塞にされた艦娘達の様子を見たくなりました。\n\n「護衛要塞に改造された電、高波、陽炎、霞、時雨、初霜が、深雪とラスボスの戦闘を観戦して、バトルの解説をしたり抵抗したりしている様子」を漫画で計6ページ程度でお願いします。\n\n以下ざっくりと展開とその捕捉を書きます。以下の流れを踏まえていれば細かい部分や台詞はお任せします。\n展開に書いてある台詞については、大筋に沿っていれば勝手に変えてくださっても結構です。\n\n①囚われたまま、ラスボス越しに戦闘を観戦して、深雪の状態を解説する人質達\n　・深雪の動きが明らかに鈍いことを怪訝に思う電や霞に対し、「電の言葉を理解はしているが、感情で割り切れていない」と時雨が指摘します。\n　・時雨の言葉に、初霜が「撃とうとしても、私達の顔を見て深雪の動きが止まっている」と歯がゆそうに付け加えます。\n\n②深雪を助けるために護衛要塞から抜け出そうと抵抗する人質達\n　・「私達のせいで……。盾にされたままこんなところで……ずっと見てろっていうの？」と陽炎。歯がゆそうに戦闘を眺める人質達。\n　・「畜生っ！こんな奴に利用されて何もできないなんて……！」と霞が叫び、人質達はぐぐぐ……と力を入れて護衛要塞に首から下を包まれたまま抵抗しますが、ビクともしません。\n\n③必死な人質達を煽るラスボス\n　・抵抗する人質達に向かってラスボスは「無駄だ」と言います。\n　・ラスボスは「護衛要塞は完全にお前達の艤装と同化し肉体に接続している」「仲間に傷つけられる時、そして仲間が倒れる時を、そこで大人しく待っていることだな」と言い放ちます。\n　・それに対し、人質達は悔しそうに歯噛みします。\n\n④ラスボスに抗議するも敢え無く盾にされる初霜\n　・初霜が、耐えかねてラスボスに「ふざけないで！」「私達は……深雪さんと共に電さんを助けに来たの！決してあなたなんかを護りに来たわけじゃ――」と叫びますが、言い終わる前に盾にされ、深雪の砲撃を食らってしまいます。\n　・悔しさを滲ませながら呻く初霜に、人質達が「初霜！」と呼びかけます。\n\n以上です。大丈夫そうでしたら是非お願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@guraham7777/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 567174, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ead2809c/uploads/origins/d0b56d80-61a8-4eb1-99bb-04c734279bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09d3a99cd911d860b5c26e3b805fceb7", "srcset": "https://si.imgix.net/ead2809c/uploads/origins/d0b56d80-61a8-4eb1-99bb-04c734279bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09d3a99cd911d860b5c26e3b805fceb7, https://si.imgix.net/ead2809c/uploads/origins/d0b56d80-61a8-4eb1-99bb-04c734279bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=991363e080597f14d64f65ff53ac13d3 2x, https://si.imgix.net/ead2809c/uploads/origins/d0b56d80-61a8-4eb1-99bb-04c734279bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2bcfd7a9c8ccdf6242d29cab11a3923 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ead2809c/uploads/origins/d0b56d80-61a8-4eb1-99bb-04c734279bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21dadfd0657ff8547ff3ac291133f477", "srcset": "https://si.imgix.net/ead2809c/uploads/origins/d0b56d80-61a8-4eb1-99bb-04c734279bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21dadfd0657ff8547ff3ac291133f477, https://si.imgix.net/ead2809c/uploads/origins/d0b56d80-61a8-4eb1-99bb-04c734279bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=02f695c49d5e8191cd77706ccd599389 2x, https://si.imgix.net/ead2809c/uploads/origins/d0b56d80-61a8-4eb1-99bb-04c734279bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c66fd38072e83a90f96bce25a6df63ff 3x"}, "body": "人面プラネットの絵が素晴らしかったので、再び特殊なシチュで依頼します。\n※特殊性癖を含みます。「このキャラではNG」や解釈違いという場合はキャラを変えていただいても大丈夫です。最悪キャンセルください。\n\n漫画形式で「深雪が、ラスボスに護衛要塞に改造された電、高波、陽炎、霞、時雨、初霜を見せつけられる戦闘前の展開」とその後の戦闘を、計6P、2シーンに分けてお願いします。\nコンセプトは「最終盤で味方側の頭数の調整とラスボスの脅威感を出す目的で味方が無力化される展開」です。\n\n以下ざっくりと粗筋と展開を書きます。以下の展開を踏まえていれば残りの細かい部分や台詞はお任せします。\n\n粗筋\n電が深海棲艦に連れ去られた。するとこれまで深雪と縁のある高波、陽炎、霞、時雨、初霜が加勢してくれ、電救出のために出撃する。そして道中、深雪以外の5人が敵艦隊に対して殿を務め、深雪を先の海域に送り出してくれた。\n\nシーン①（3P程度）\n深雪がラスボスと対峙していると、ラスボスが6体の護衛要塞を出現させる。その護衛要塞には、電と、殿を務めていたはずの高波、陽炎、霞、時雨、初霜の顔がそれぞれ浮かび上がっていた。高波たち5人はラスボスに敗北し、電共々護衛要塞に改造され、盾兼人質にされていた。\n・ラスボスの外見はお任せします。既出の深海棲艦でも構いません。\n・護衛要塞の外見は、公式ビジュアルの球体に艦娘の顔だけが出ている感じです。人面プラネットとほぼ同じ\n・護衛要塞化された6人はアーケード版の護衛要塞のように、意思に関係なく旗艦への攻撃の盾にされる設定です。\n・深雪は6人を見て、明らかに戦意喪失しています。\n・ラスボスは「こいつらは護衛要塞となった今、お前の敵となった。さあ、7対1だ」と護衛要塞を周囲に浮遊させながら深雪に告げます。\n\nシーン②（3P程度）\n深雪とラスボスの戦闘の一部分\n・深雪が苦し紛れに砲撃すると、護衛要塞の高波が引き寄せられて射線上に入り、ラスボスを庇って顔に傷を負います。高波は「や、やめ…」と抵抗しますが無駄です。\n・「護衛要塞となった艦娘はこのように私を護ろうとしてくれる。お前に攻撃できるかな？」と笑うラスボスに対し、陽炎or霞は「卑怯者…！」と怒りを募らせます。\n・躊躇する深雪を見かねて電が「電達にかまわず攻撃してください！」と深雪に対し叫びます。\n\n可能なら是非お願いします", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@guraham7777/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 567174, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e33d348a/uploads/origins/0f14f4ca-f839-4722-99dc-50fc615db16b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcb16bb94d1fe094e6fb7e99994f72f6", "srcset": "https://si.imgix.net/e33d348a/uploads/origins/0f14f4ca-f839-4722-99dc-50fc615db16b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcb16bb94d1fe094e6fb7e99994f72f6, https://si.imgix.net/e33d348a/uploads/origins/0f14f4ca-f839-4722-99dc-50fc615db16b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=856c8b1366fb81bd51a760b681fbc37e 2x, https://si.imgix.net/e33d348a/uploads/origins/0f14f4ca-f839-4722-99dc-50fc615db16b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71fbc191a55202a7098087079d3b1c9c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e33d348a/uploads/origins/0f14f4ca-f839-4722-99dc-50fc615db16b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7293e1b262430b954c6ff3c38c5d8fb", "srcset": "https://si.imgix.net/e33d348a/uploads/origins/0f14f4ca-f839-4722-99dc-50fc615db16b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7293e1b262430b954c6ff3c38c5d8fb, https://si.imgix.net/e33d348a/uploads/origins/0f14f4ca-f839-4722-99dc-50fc615db16b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c22f566c6c367f743d0160e5539bc0fa 2x, https://si.imgix.net/e33d348a/uploads/origins/0f14f4ca-f839-4722-99dc-50fc615db16b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=14684801ee9c659a092c23be24ff7ebc 3x"}, "body": "先日、人面プラネットのイラストを依頼したものです。\nあの時はリクエストに応えていただき本当にありがとうございました。\nスケブ受けつけられているとのことですので、依頼します。\nなお、【今回は特殊性癖ではありません】のでご安心ください。\n\n「敵に対してプロレス技をかける長門改二と、それを見て「ピェーッ！あの技は！」と叫んでリアクションする酒匂」をお願いします。\n\n・長門の対戦相手はお任せします。できれば長門と同格から大きい体格の姫級の深海棲艦でお願いします。\n・長門がかけているプロレス技は、できればキン肉マンの「“完肉”バトルシップ・シンク」でお願いします。\n・ただし、技名は「“完娘”バトルシップシンク」でお願いします。\n・さらに可能であれば、長門が「戦艦が沈める一撃……<完娘>〝元祖〟バトルシップ・シンク―――ッ！！」と叫んでいれば嬉しいです。\n・酒匂の台詞は「ピェーッ！あの技は！」です。元ネタはキン肉マンのゲェーッ！です。\n\n燃えというよりかは少々ギャグ風かもですが、可能でしたらよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@guraham7777/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 567174, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9e3a598/requests/233527_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fd95a8089baadd863f6e9c1359f7459", "srcset": "https://si.imgix.net/d9e3a598/requests/233527_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fd95a8089baadd863f6e9c1359f7459, https://si.imgix.net/d9e3a598/requests/233527_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10472570885e7440fbd5d9e7abb7b53e 2x, https://si.imgix.net/d9e3a598/requests/233527_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=787a3f2ba5c4ab14ad029144a1e40e2c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9e3a598/requests/233527_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dac36cb1787a97215b535e6036ff6361", "srcset": "https://si.imgix.net/d9e3a598/requests/233527_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dac36cb1787a97215b535e6036ff6361, https://si.imgix.net/d9e3a598/requests/233527_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=35c8e839390a89b469905d681e41c492 2x, https://si.imgix.net/d9e3a598/requests/233527_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bd88b76081c48a5d3e3fadad5a86402b 3x"}, "body": "はじめまして。\nSkebを介してですが、勇気を出してイラストをリクエストします。\n\nただしこれからリクエストするのは以下のような内容ですので、ダメでしたら遠慮なくキャンセルください。\n・艦これとキン肉マンのクロスネタで、両作に登場するキャラクターが敵対しているというシチュです。\n・キン肉マンという有名な少年漫画が元ネタですが、顔だけ出た状態で身体の一部にされるシチュが含まれます。\n\nリクエスト内容としては、\n「人面プラネットで大和以外の坊ノ岬沖組の艦娘を捕えて人質にしているプラネットマン」をお願いします。\nプラネットマンはキン肉マンのキャラクターで、『人面プラネット』はプラネットマンの技です。\n\n【構図】\n・所謂クロスネタです。シチュエーションとしては、大和と対峙しているプラネットマンが『人面プラネット』で大和以外の坊ノ岬沖組(初霜、矢矧、霞、雪風、磯風、浜風、朝霜、涼月)の顔だけを浮き上がらせて人質にしている感じです。\n・プラネットマンはこちら側を向いていて、人質にした艦娘の顔を見せつけています。大和は枠内に描かずに、イラスト全体にプラネットマンの全身と人質にされた艦娘を正面から映してください。\n・人面プラネットで浮き上がる艦娘の顔の配置はお任せします。\n・人質にされた艦娘の表情についてもお任せしますが、不安げに状況を見守るしかない者、プラネットマンを睨み上げる者、人質として利用され味方に迷惑かける自分が情けなく歯噛みする者、状況を呑み込めず驚いている者、のようにある程度バリエーションがあると嬉しいです。\n\nほぼダメ元のリクエストですが、万が一描いていただけましたらとても喜びます。\nよろしくお願いします。\n\nhttps://dic.pixiv.net/a/%E4%BA%BA%E9%9D%A2%E3%83%97%E3%83%A9%E3%83%8D%E3%83%83%E3%83%88", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@imanashidui/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 10329, "client_id": 567174, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/454e9829/requests/102195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1262b77a4a3ddd406107ebfeebc54a88", "srcset": "https://si.imgix.net/454e9829/requests/102195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1262b77a4a3ddd406107ebfeebc54a88, https://si.imgix.net/454e9829/requests/102195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6aef84587742f041561ad0316eb89979 2x, https://si.imgix.net/454e9829/requests/102195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=917cc329cf4f23c2174b33e91b568f0a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/454e9829/requests/102195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47b163b42d1fee2ef7d648fe53d9fd3d", "srcset": "https://si.imgix.net/454e9829/requests/102195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47b163b42d1fee2ef7d648fe53d9fd3d, https://si.imgix.net/454e9829/requests/102195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=db88ccf77c6c23769f4a1c1802254bcb 2x, https://si.imgix.net/454e9829/requests/102195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8387e7f3bd252b0d4642ac68d08589b4