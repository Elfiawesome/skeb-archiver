auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfa543d1f04a5043312ad678606f65eb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0eaedfd1/uploads/origins/2be0d238-1210-4db2-93cc-607b94cac89f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7f01b5005fd50fd112e4009f353a437", "src_set": ""}, "body": "白米先生、初めまして！\nベリーと申します！\n\n私は個人Vtuberです。てんとう虫のキャラクターです。\nhttps://drive.google.com/drive/folders/1rZdl1c5ZIYWhfRfYxQawvLoMpPw4txDS?usp=sharing\n\n彼女は独りよがりな性格です。クソガキです！先生のイラストの雰囲気がとても好きです！森を舞台に描いていただけたら嬉しいです。お気軽にポーズを描いてください。\n\nよろしくお願いします! ありがとうございます！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tamago_onRice/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/36781e3e/uploads/origins/34dbe2cc-18aa-4e85-929b-3e1fa73b9f59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55671b9f34e28187dd56672c886331a5", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1855618, "client_id": 1546655, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Tamago_onRice/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1855618, "client_id": 83992, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/337c80d0/uploads/origins/6439f5f4-cac6-415a-88cc-633f2d0153ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdb0b94a4265b94488ae8ace4171b23c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/337c80d0/uploads/origins/6439f5f4-cac6-415a-88cc-633f2d0153ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eac2bbbf498190416e6403b51407231a", "src_set": ""}, "body": "白米様、はじめまして。むぺぺと申します。\nX上で素敵なイラストを拝見し、仄暗い雰囲気に惹かれてリクエストをお送りさせていただきました。\n可能であれば、私のOCについてイラストを描いていただきたいと思います。\n\n▼キャラクター概要\n海からやってきた怪異であり、人間に擬態している。服装は黒のレインコート。\n常に笑みを浮かべており、目は真っ黒で光を返さない。\nいつの間にか傍に現れ、人を誑かして海に引きずり込もうとする。\n※参考資料として外見の画像を添付させていただきます。\n\nイラストの内容について、構図やシチュエーションなどの詳細はお任せいたします。\n不安や恐怖を掻き立てるようなホラー調のものであれば嬉しいですが、\n白米様の描きやすい形で仕上げていただければと思います。\n\n以上、ご検討いただければ幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1XbM_FoIQdp77J44jggfB5NQ4M1HVw3Li/view?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tamago_onRice/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1855618, "client_id": 3446742, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19dd1af6/uploads/origins/a6658fb0-c272-4259-b36b-0ab7e1b945cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1207c0b01f360b9ab30005de38064d20", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19dd1af6/uploads/origins/a6658fb0-c272-4259-b36b-0ab7e1b945cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02b307fcd6d30e27caa62108a3091902", "src_set": ""}, "body": "白米様\n\n初めまして。VTuber準備中の冥灯薔薇 甘棺と申します。\n（https://skeb.jp/@Tamago_onRice/works/12 ）\n上記のイラストを偶然拝見し、見る人を一瞬で惹き付けるダークでありながら魅惑的な絵柄に一目惚れいたしました。\nぜひ私のイラストを白米様に描いていただければと思い、ご連絡させていただきました。\n\n◯用途\n活動内で使用いたします （SNSや動画サムネイルなど） 。\n※ 上記作成のため、一部切り抜き、文字入れ、彩度調整など、原形を損なわない範囲での加工を行う可能性がございます。商用利用はございません。\n\n◯参考資料\n立ち絵等の資料は、お手数をお掛けしますが資料URLのページをご参照ください。\n\n◯キャラクター設定\n・人間を取り込みたい、愛されたいという欲望の強い、がしゃどくろの女の子である。\n悲しんでいる人や苦しんでいる人に「大丈夫、あまぎが一緒だよ。怖くないよ、助けてあげる」と言い、手を差し伸べ、黄泉の屋敷へ招き入れる。自身は人助けのつもりである。招き入れた男性はおうじさま、女性はおひめさまと呼び、心から慕う。\n•一緒に過ごしていた人間が自分から離れようとすると、途端に悲しみに囚われ、がしゃどくろ本来の姿に戻ってその人間をぐしゃぐしゃに壊してしまう。\n甘棺の隣で天寿をまっとうした人間はそのまま体内に取り込んでいる。\n\n\n◯構図、シチュエーション等\n\n・ボロボロのお屋敷の中で、骸骨を周りに何人も座らせて、冥灯薔薇 甘棺本人はティーパーティーを幸せそうに楽しんでいる様子。\n骸骨に関して、王子様/お姫様のモチーフアイテムがそれぞれにひとつずつ付いていると良いです（王冠やティアラを被らせたり、王様の着けるようなケープを羽織らせるなど）。\n部屋の隅にバラバラに崩された骸骨があると尚良いです。\n\nパッと見た時に不穏だったり、違和感を覚えるような不気味なお茶会であることが見る人に伝わると良いなと考えていますが、白米様のセンスがとても好きなので、画風を崩さず得意分野でお好きなように描いて頂けると幸いです。\n\n\n◯データ納品形式\n可能であればPSD形式で納品していただけると嬉しいです 。\n(PSDファイルは、①Skebサムネ用②人物③その他 のように各種結合されたレイヤーで分かれていると助かります） 難しい場合は任意の画像形式で構いません。\n禁止事項等ございましたら、お手数をおかけしますが別レイヤー等に記載ください。 \n\n◯その他\n・サムネイル等で使いやすいように縦ロールが大幅に見切れることがないようにして頂けると幸いです。\n・背景もありましたら嬉しいです。(無くても大丈夫です。)\n・金額の不足等ございましたら再送要請を頂けると幸いです。\n\nご多忙のところ誠に恐縮ではございますが、ご検討のほどよろしくお願い申し上げます。これからも白米様のご活動を心より応援しております。\n\nhttps://drive.google.com/drive/folders/1-GIb3SWMcOwgyhuBBOxIKPZjzvvdGEeQ", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tamago_onRice/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1855618, "client_id": 1311304, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0112215c/uploads/origins/75a04e72-351a-4e59-b657-51fc1d080c64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18ea1f0cd1d3ca878a2679889a6fb3fd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0112215c/uploads/origins/75a04e72-351a-4e59-b657-51fc1d080c64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd6d8d10ac8cdd95d80a38ed309ba253", "src_set": ""}, "body": "こんにちは！\n\nあなたの絵が大好きです！あなたのスタイルはとても不気味です！\n\n私のVtuberがかわいくて幸せそうで、おどろおどろしい霊か悪魔とお茶をしているところを描いてくれませんか？\n\nありがとうございます！\n\nhttps://drive.google.com/drive/folders/1B_1zDwqX6gCXIn9aAvYwm5KoQ3hQ5zyH?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre":