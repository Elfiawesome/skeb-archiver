ikes tasty food, playing games, and taking naps.\n\nYou may draw a pose and expression of your choice.\n\nPlease separate the background if possible (PSD ok)\n\nReferences: https://drive.google.com/drive/folders/19_0bjc6ToR5k1Sy6N7pgvAnk1_dOpiLW?usp=share_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tomatomozuku/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1217400, "client_id": 2849785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b5a22de/uploads/origins/673a5f43-eb5e-4ad5-8b02-ef4d51305a00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4b249ae7a97b17c0061dd74f840dfac", "srcset": "https://si.imgix.net/2b5a22de/uploads/origins/673a5f43-eb5e-4ad5-8b02-ef4d51305a00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4b249ae7a97b17c0061dd74f840dfac, https://si.imgix.net/2b5a22de/uploads/origins/673a5f43-eb5e-4ad5-8b02-ef4d51305a00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1e7440fd098aff14b29b296c6bc9c7f 2x, https://si.imgix.net/2b5a22de/uploads/origins/673a5f43-eb5e-4ad5-8b02-ef4d51305a00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9490c90556f09c9c08cb1abd3139d930 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b5a22de/uploads/origins/673a5f43-eb5e-4ad5-8b02-ef4d51305a00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d2711e5154f2ac766baf51077e1e2a3", "srcset": "https://si.imgix.net/2b5a22de/uploads/origins/673a5f43-eb5e-4ad5-8b02-ef4d51305a00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d2711e5154f2ac766baf51077e1e2a3, https://si.imgix.net/2b5a22de/uploads/origins/673a5f43-eb5e-4ad5-8b02-ef4d51305a00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit