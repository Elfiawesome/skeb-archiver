si.imgix.net/5532fa2c/uploads/origins/0b8d12ae-3c2a-4644-a4b1-218242faa13f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49823ed38f0053935cac65c802bd691e", "srcset": "https://si.imgix.net/5532fa2c/uploads/origins/0b8d12ae-3c2a-4644-a4b1-218242faa13f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49823ed38f0053935cac65c802bd691e, https://si.imgix.net/5532fa2c/uploads/origins/0b8d12ae-3c2a-4644-a4b1-218242faa13f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=075be83b11259178fe7ee307097e3ff0 2x, https://si.imgix.net/5532fa2c/uploads/origins/0b8d12ae-3c2a-4644-a4b1-218242faa13f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abc90d3f5eeb0898b70ae5b8a581033d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5532fa2c/uploads/origins/0b8d12ae-3c2a-4644-a4b1-218242faa13f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d1a5d3987194245c64efbce998317d7", "srcset": "https://si.imgix.net/5532fa2c/uploads/origins/0b8d12ae-3c2a-4644-a4b1-218242faa13f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d1a5d3987194245c64efbce998317d7, https://si.imgix.net/5532fa2c/uploads/origins/0b8d12ae-3c2a-4644-a4b1-218242faa13f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=82ab70dd9796404b6ff58048c123ac82 2x, https://si.imgix.net/5532fa2c/uploads/origins/0b8d12ae-3c2a-4644-a4b1-218242faa13f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=be26d8b97dcac60539815a65a7934666 3x"}, "body": "真っ白な砂浜は熱を帯びて、遠くの空、水平線をも揺らがせている。海に行きたいと言ったのは私だったが、私よりもずっと彼女の方がはしゃいでいた。\n\n　「わぁ〜！キレーっす～！」\n\n　そう言って彼女は、軽やかに駆け出した。彼女が跳ねるたび、蹴り上がった砂が太陽に乱反射する。時折くるりと回って笑う彼女は、まるで光と戯れているように見えた。\n　晴れ渡った空と海の境目は曖昧で、どこまでも遠く広がっている。果てしない青を後ろに、彼女の浅緑の髪が風に乗ってふわりと舞い上がった。\n　この子は、まるで命のかたまりのようだ、と思う。\n　全身で命を体現しているかのように、髪の先まで活き活きとしている。根無草のような生活を強いられ、どんなに生き苦しくとも、その命の輝きを失うことはない。\n　長い前髪に隠れていても分かる、豊かな表情。私はただそれに見惚れて、立ち尽くしたまま、彼女から目を離せないでいる。彼女はそんなことなど知らず、こちらへ向かって無邪気に手を振って、私は眩しさに目を細めた。\n　どうしても海を見たかった訳じゃない。だけど、彼女が夏に生まれたと知ってからずっと、こうして、一番きれいな海を見せたかった。生まれが何月、何日かも知らない。聞いても教えてくれない気がした。彼女はいつだって屈託なく笑いかけてくれたけど、私たちの間には明確に越えられない一線があった。\n　きっと私が、ただの人間だから。そして彼女は、魔法使いだから。\n　無力な私では、世界から彼女を守れない。分かっている。この恋の行先が彼女を傷つけるのなら私は彼女のことをなにも知らなくていい。だけど、今日だけは。\n　彼女が生まれてたいつかの日に思いを馳せながらおめでとう、と呟いて、鞄の中に潜ませた包みのことを考える。これは、私のわがまま。\n\n　「なんか言ったっすかーっ？」\n\n　駆け寄ってくる彼女を抱きとめて「なんでもない」と微笑みかける。\n　鞄の中のこれを渡したら、どんな顔をするだろう。きっと驚いて、不思議がって、でも、最後にはとびきりの笑顔で私を虜にするのだろう。\n　やけに眩しい日差しを片手で遮り、もう一方の手を引かれながら白い砂をふたりで蹴り上げていく。目の前には、間違いなく世界で一番きれいに輝く海。\n　私はこの光景を、いつまでも、眺めていたいと思った。\n\nという訳でプレゼントをもらってとびきりの笑顔のアニュちゃんをお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mufksin/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 33878, "client_id": 764616, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7e639a9/uploads/origins/5b614aae-aaf5-4648-9404-3d05bd8600e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95745e97080cd1341875be4e13a7fb87", "srcset": "https://si.imgix.net/b7e639a9/uploads/origins/5b614aae-aaf5-4648-9404-3d05bd8600e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95745e97080cd1341875be4e13a7fb87, https://si.imgix.net/b7e639a9/uploads/origins/5b614aae-aaf5-4648-9404-3d05bd8600e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d5d29d886ce56b04e1e35de7b01bd3e 2x, https://si.imgix.net/b7e639a9/uploads/origins/5b614aae-aaf5-4648-9404-3d05bd8600e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc6f5d40ab47309b777a38bff615171b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7e639a9/uploads/origins/5b614aae-aaf5-4648-9404-3d05