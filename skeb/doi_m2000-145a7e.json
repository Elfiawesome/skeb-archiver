o=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35ce8807f8445a40488e68099c194003, https://si.imgix.net/53c5e4ce/uploads/origins/c68ef3aa-6267-4f49-9e61-bccce42e8a56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3ac3057866889ffa998dc0fdcfad0dc 2x, https://si.imgix.net/53c5e4ce/uploads/origins/c68ef3aa-6267-4f49-9e61-bccce42e8a56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fee3d76533342b4b84591620d7982fb2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53c5e4ce/uploads/origins/c68ef3aa-6267-4f49-9e61-bccce42e8a56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4569f24d12130a9171ee96d56996a4c", "srcset": "https://si.imgix.net/53c5e4ce/uploads/origins/c68ef3aa-6267-4f49-9e61-bccce42e8a56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4569f24d12130a9171ee96d56996a4c, https://si.imgix.net/53c5e4ce/uploads/origins/c68ef3aa-6267-4f49-9e61-bccce42e8a56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3d4e678079cb725ba2a3749053e7ff3b 2x, https://si.imgix.net/53c5e4ce/uploads/origins/c68ef3aa-6267-4f49-9e61-bccce42e8a56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=548a86b05840411abf325efda7f1d06b 3x"}, "body": "こんばんは！pecopecoと申します。\n以前からdoiさんの作品を拝見しており、そのときから只者では無いなと感じておりました。\nカップヘッドの作品では画面内で繰り広げられるステージの臨場感を体験できるような構成能力を尊敬しています。\n通常では描かれない目を引く効果的なキャラアングルに感銘を受け、キャラだけでなく、そうした対象の動きによって生じる現象までも自然とステージに溶け込むように描かれていて、必然性のある物体の映り込みや影や光の反射表現に毎度驚かされ、同じ色でもそれぞれの質量を持ち、多様に使いこなす、\nそういったdoiさんの自然物への観察力の高さや混み合わず退屈させない色彩同士の関係の把握能力も好きです。\n\n油絵などでは生物の血液、体温、呼吸、を通して万物にある魂が画面の奥から伝わってくるような心地よい生命力を感じ、それらには本来の無垢な姿が映され胎児の持つ誕生の神聖さを帯びています。\nそこにはdoiさんの万物の本質を見抜き、突きとめる鋭さを感じ、\nまた、あらゆるものの美しさを知った上で真剣に見つめ合うように研ぎ澄まされた静寂の中で、皆には見ることのできない真実を描き続ける貴方が好きです。\n\nそんなあなたにリクエストしたく思いメッセージを送らせていただきます！\n私の創作『スラム南国のチンピラ』より、『アキヒコ』というキャラクターをお願いしようと思っております。\nシチュエーションとしては、\n『海や浜辺等に居る姿』\nを希望としていますが、doiさんが描きやすく楽しく描けるシチュがあればどんなものでも構いません。\n\n可能な範囲で構いませんので、もしよろしければよろしくお願いいたします。\n資料用リンクですがわかりやすいものがなくてすみません…【https://x.com/pepeen5/status/1622622353237884929?s=20】\n\nお忙しいところ失礼いたしました。これからも活動応援しております。大好き。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@doi_m2000/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/676d8205/uploads/origins/025e1339-9f7d-4b07-b832-f750d580dd72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92389ca0aef1480d7a504725ca6ff071", "srcset": "https://si.imgix.net/676d8205/uploads/origins/025e1339-9f7d-4b07-b832-f750d580dd72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92389ca0aef1480d7a504725ca6ff071, https://si.imgix.net/676d8205/uploads/origins/025e1339-9f7d-4b07-b832-f750d580dd72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aad873cb9542377637077e452ca03c60 2x, https://si.imgix.net/676d8205/uploads/origins/025e1339-9f7d-4b07-b832-f750d580dd72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7035f604d97676855e607ed689a4d27d 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2900677, "client_id": 1617038, "nc": 145}, {"path": "/@doi_m2000/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2900677, "client_id": 293143, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73cd64cc/uploads/origins/dea6c6af-dbbc-45e5-8094-0b928ff2e6