ました…！！\n\nOC詳細⬇️\nhttps://drive.google.com/drive/folders/10JJ_qn2-zIceSDTva12HvhPDtKVjvGlx\n\n構図なのですが、銃を持っている構図だと嬉しいです😭✨(銃の種類はなんでも大丈夫です◎)\n\nまた、透過をいただけると幸いです🎶\n\n以下、必ずお願いしたいことを記載させていただきます🙇🏻‍♀️\n\n･髪の長さは膝裏ぐらいまで長く\n･目のハイライトは無し\n･ピアスが見える場合ピアス(耳とへそ)\n･ネイル、タトゥーの描写\n\n金額不足や不備などありましたら再送の方お願い致します🙇🏻‍♀️語彙力が無いため分かりずらくなってしまったかもしれませんがご検討、承諾の方よろしくお願い致します！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ykii077/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3531834, "client_id": 3541620, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/458e46f5/uploads/origins/fec7bb7a-d945-4e8d-b575-4cd35c95d616?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b02c08cfd7a3bdf937fb1c8a33f0b40a", "srcset": "https://si.imgix.net/458e46f5/uploads/origins/fec7bb7a-d945-4e8d-b575-4cd35c95d616?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b02c08cfd7a3bdf937fb1c8a33f0b40a, https://si.imgix.net/458e46f5/uploads/origins/fec7bb7a-d945-4e8d-b575-4cd35c95d616?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=309bac55a1742c9a7672256fd79eaaa4 2x, https://si.imgix.net/458e46f5/uploads/origins/fec7bb7a-d945-4e8d-b575-4cd35c95d616?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca2024b2911a2332cf5c42fc2383ac7b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/458e46f5/uploads/origins/fec7bb7a-d945-4e8d-b575-4cd35c95d616?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec80687037233c7589433686949f50fb", "srcset": "https://si.imgix.net/458e46f5/uploads/origins/fec7bb7a-d945-4e8d-b575-4cd35c95d616?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec80687037233c7589433686949f50fb, https://si.imgix.net/458e46f5/uploads/origins/fec7bb7