。\n\n見ての通りとても'立派なもの'を持っている子です。衣装も結構刺激的です。ですが、あくまで健全な感じでお願いします。みやびさんのエッな絵も好きですが何卒よろしくお願いいたします(˙ཫ˙)\n\n\n資料として、衣装お披露目時の配信URLを添付いたします。また、既存のFAも参考になるかと思います。\n(なおFAタグは「#イオリの森美術館」です。)\n\n最後にですが、素敵な子ですので、作画のお供に彼女の雑談配信などをほんの少しでも聴いていただけたらとても嬉しく思います。\n\nhttps://www.youtube.com/live/YUCjdRT8dlY?feature=share", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MIYAfactory733/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 248923, "client_id": 859605, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/668f6451/uploads/origins/d4d4bced-851b-47e2-95b5-b66efc57f7cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=390df19843c8a90207d13491154ced26", "srcset": "https://si.imgix.net/668f6451/uploads/origins/d4d4bced-851b-47e2-95b5-b66efc57f7cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=390df19843c8a90207d13491154ced26, https://si.imgix.net/668f6451/uploads/origins/d4d4bced-851b-47e2-95b5-b66efc57f7cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f85cf3b78d23cb174ead2a7a3ceac9e7 2x, https://si.imgix.net/668f6451/uploads/origins/d4d4bced-851b-47e2-95b5-b66efc57f7cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f81dd68f0278cdecafb4be6d62b6a66 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/668f6451/uploads/origins/d4d4bced-851b-47e2-95b5-b66efc57f7cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=028953b66a0d582130b83c09899f2bdf", "srcset": "https://si.imgix.net/668f6451/uploads/origins/d4d4bced-851b-47e2-95b5-b66efc57f7cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=028953b66a0d582130b83c09899f2bdf, https://si.imgix.net/668f6451/uploads/origins/d4d4bced-851b-47e2-95b5-b66efc57f7cc?bg=%23fff&au