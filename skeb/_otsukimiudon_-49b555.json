\n羽根や角は外していただいたり、色や形をアレンジしていただいても大丈夫です！\nなるべく中性的なキャラクターを選びましたので、おつきみさんの世界観に染めていただけたら幸いです♡\n\n用途：\n個人観賞及び画像を当アカウントの連携先のXに投稿させていただきます。\n\n\n金額や内容に不備・不足がありましたら、ぜひ再送依頼をお願いいたします。\nおつきみさんのイラストと世界観が大好きなので、楽しく描いていただけたら嬉しいです！\nどうぞよろしくお願いいたします♡", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1328751, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ニラニラは冬コミ当落待ち", "screen_name": "nira_tch", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fmisskey%2F1d875bc6-5ab7-498d-aee1-075c82d5f069.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/65131270-5107-4246-b52d-e8e2ca7c72fe.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 31, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 3127896, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "namiki", "screen_name": "mina37mina03", "avatar_url": "https://pbs.twimg.com/profile_images/1843649450985828352/1NVpG_cE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1130380383126614018/1623557253/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 3150966, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "痲華(ましろ)", "screen_name": "masiro_1110", "avatar_url": "https://pbs.twimg.com/profile_images/2035734345881882624/JThq44lc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2035734149697585152/1774192369/1500x500", "appeal_receivable": false, "popular_creat