フで、襟足が肩にギリギリかからない程の長さです。\n参考画像のキャラクターは前髪をパッツンにしていますが、もう一枚の写真のような前髪にして頂きたいです。パッツンの前髪を流すようなイメージで、ちょうど顔の中心の前髪が少し長い感じです。(分かりにくくてすみません！)\n目の色は青で、猫目ぽいイメージです。\n下まつげが印象強めでお願いします！\n口はM字リップで、にゅんとした口です。\n口を開けると右に八重歯があります。\nピアスは右耳に4つ、左耳に3つでお願いします。\n全体の雰囲気はピンク系でお願いします。\nリボンや、苺があると嬉しいです。\n\nお忙しい中だと思いますが、何卒よろしくお願いいたします。\nかなり暑くなってきているので、体調もお気をつけください！\n応援しております。\n\nhttps://drive.google.com/drive/folders/1Z7vdNvJ0hLihIdikFZr8WwiBItz1iF45", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_otsukimiudon_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4040901, "client_id": 3208377, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f9588e9/uploads/origins/bb118ae5-76b8-46d9-87ba-20188066232b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89e96c638cad252f54d9d0d88234fefa", "srcset": "https://si.imgix.net/4f9588e9/uploads/origins/bb118ae5-76b8-46d9-87ba-20188066232b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89e96c638cad252f54d9d0d88234fefa, https://si.imgix.net/4f9588e9/uploads/origins/bb118ae5-76b8-46d9-87ba-20188066232b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddfa4eb67d3c2e1b84da6e4e62e4ea06 2x, https://si.imgix.net/4f9588e9/uploads/origins/bb118ae5-76b8-46d9-87ba-20188066232b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adfa5c2cb83e40e8cbc74b9b5c86c70d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f9588e9/uploads/origins/bb118ae5-76b8-46d9-87ba-20188066232b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fdd7f7ee0941d3de63bd9c8a6aa45653", "srcset": "https://si.imgix.net/4f9588e9/uploads/origins/bb118ae5-76b8-46d9-87ba-20188066232b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=