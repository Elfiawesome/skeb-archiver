やアイコン等での使用\n・ネットプリントや配布、グッズ制作&販売での使用\n・キービジュアルなどの宣伝画像制作素材\n・イベントの際などに企業様などの第三者にお渡しできるイラスト\n　（宣伝素材やポスター掲載、イベントグッズへの使用など多岐に渡る可能性がございます）\n※その他Vtuber活動全般にて使用の可能性がございます\n※いずれも商用利用の可能性がございます\n\n【その他】\n・グッズ販売も検討しておりまして、可能な限り高解像度・画像サイズでご制作いただけますと大変嬉しいです…！\n・psdにて背景や人物、サイン等を別レイヤーにして頂けますと幸いです\n・可能でしたら人物のみpng形式でも頂けましたら大変嬉しく存じます\n\n以上となります。\nご検討のほど何卒よろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1J2Q0LcOV-I2jn8BzDfJcaFWb813mxZoW?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 3274062, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🦆", "screen_name": "kamopp0", "avatar_url": "https://pbs.twimg.com/profile_images/1829864118771490816/yDnCUDKK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1796169258633973760/1721793528/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 3403117, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Show", "screen_name": "CrShow0113", "avatar_url": "https://pbs.twimg.com/profile_images/1901751788212301824/js0GwAhk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1712709703158104064/1697452565/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 3746488, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "yumi", "screen_name": "yumi__0313", "avatar_url": "https://pbs.twimg.com/profile_images/1965255764215574528/Y0rXbfdl.jpg", "header_url": "https://pbs.twimg.com/p