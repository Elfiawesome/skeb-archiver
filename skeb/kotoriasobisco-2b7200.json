9818624f5147915 2x, https://si.imgix.net/62fa4a29/uploads/origins/9b575a3c-a429-4a5d-8cb4-2d3e6d2d9958?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4d404c63dd83dab587ddf5ab33f7930 3x"}, "body": "はじめまして！\nXで偶然たかなし様が描かれた速水奏さんのハピバイラストをお見かけして、それがとても素敵だったので他のイラストも拝見させていただいたところ、フレちゃん、相葉ちゃん、乙倉ちゃん、にちかちゃん……どれもこれもがとても素晴らしく、これは是非自分の担当も描いていただきたいと強く思い、この度依頼させていただきました。\n率直に申し上げて、たかなし様の絵柄がとても好きです！\n\nここからが依頼文となりますが、キャラはアイドルマスターシンデレラガールズの水木聖來をカラーでお願いできますでしょうか？\n\n衣装については、たかなし様が今まで描かれてきたアイドルの衣装のチョイスがとても素敵なので、大変恐縮ではございますがお任せとさせていただきたいです。\nゲーム中でのレア度は問いませんので、たかなし様が、他の衣装に比べてこれが描きたいと感じた水木聖來の衣装を着せて素敵な水木聖來を見せていただければとても嬉しいです。\n\n構図も顔は見えるようにしていただきたいですが、それ以外はポーズ、シチュエーション、表情などはお任せ致します。\n\n重ね重ねになりますが、純粋にたかなし様が描かれた水木聖來が見たいと強く思い、リクエストさせていただきました。\n何卒ご検討のほど、よろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 365866, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ひびき透", "screen_name": "hibikitohru", "avatar_url": "https://pbs.twimg.com/profile_images/1081584795124027393/cxzb_hTS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2162599014/1734058686/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 144}, {"id": 551929, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "いとり", "screen_name": "Nozomine_Itori", "avatar_url": "https://pbs.twimg.com/profile_images/1826218120597708800/kq_ZuUWl.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2380380979/1727388860/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days"