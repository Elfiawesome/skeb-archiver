ivate_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2943919, "client_id": 278320, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/99971ca7/uploads/origins/14c62300-01ef-4710-a468-6e49d4c3e2d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b0c7ed2962f6537c0d39ac2e74ed549", "srcset": "https://si.imgix.net/99971ca7/uploads/origins/14c62300-01ef-4710-a468-6e49d4c3e2d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b0c7ed2962f6537c0d39ac2e74ed549, https://si.imgix.net/99971ca7/uploads/origins/14c62300-01ef-4710-a468-6e49d4c3e2d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd54c463c406ae7ca89ae53af60a7d6c 2x, https://si.imgix.net/99971ca7/uploads/origins/14c62300-01ef-4710-a468-6e49d4c3e2d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7788ee90d56c1946844cae981ea2a95a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99971ca7/uploads/origins/14c62300-01ef-4710-a468-6e49d4c3e2d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e89e9eda5d7bcea15f6c9ddd7e360d38", "srcset": "https://si.imgix.net/99971ca7/uploads/origins/14c62300-01ef-4710-a468-6e49d4c3e2d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e89e9eda5d7bcea15f6c9ddd7e360d38, https://si.imgix.net/99971ca7/uploads/origins/14c62300-01ef-4710-a468-6e49d4c3e2d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2d5d041d562a37d7cf44e820c05e5297 2x, https://si.imgix.net/99971ca7/uploads/origins/14c62300-01ef-4710-a468-6e49d4c3e2d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=798cf4142760b47874925b2f7cf8a076 3x"}, "body": "初めまして。えいる様の素敵なイラストをpixivで拝見しておりました。\n特に魔女さんの下記のイラストが素敵で、そちらに似たシチュエーションでリクエストをさせていただきたいです。\nhttps://skeb.jp/@eilev/works/2\n\n\nキャラクターは添付資料のゲームの自キャラをモチーフにしていただきたいと思います。\n植物型のモンスターにパイズリをするというシチュで、添付資料にあるモンスターが竿役でお願いします。\nヒロインが主体的にするのでも、敵に無理やりパイズリさせられるのでも、どちらでも問題ございません。\nパイズリさせられる触手の形状については、お任せいたします。\n敗北シチュですので、服が破け、おっぱいを完全に露出させられている感じでお願いしたいですが、痛々しい傷の描写などは必要ございません。\n\n差分をいただけるのであれば、射精前、射精後の差分があると嬉しいです。\n気が強く、プライドが高い設定ですので、悔しそうな表情でお願いします。\nセリフを書いていただける場合は、魔女さんと同じような感じの口調、内容で大丈夫です。\n\n\nもしよろしければ、どうぞ、よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1JOXBNmlRpMON9zDUv84WTXGNymtbjZHe/view?usp=sharing", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eilev/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2943919, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34a09678/uploads/origins/1ed819bc-80ae-4df1-9162-eaff98fa46f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baa9c23b9929cc7f9778a8974c12a41c", "srcset": "https://si.imgix.net/34a09678/uploads/origins/1ed819bc-80ae-4df1-9162-eaff98fa46f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baa9c23b9929cc7f9778a8974c12a41c, https://si.imgix.net/34a09678/uploads/origins/1ed819bc-80ae-4df1-9162-eaff98fa46f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=957991f9df67d7a77b1d1bd744ed5238 2x, https://si.imgix.net/34a09678/uploads/origins/1ed819bc-80ae-4df1-9162-eaff98fa46f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b39f089635fd23e40ca9c7209ca731dc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34a09678/uploads/origins/1ed819bc-80ae-4df1-9162-eaff98fa46f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90bda6559e33be8dce65359202833820", "srcset": "https://si.imgix.net/34a09678/uploads/origins/1ed819bc-80ae-4df1-9162-eaff98fa46f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90bda6559e33be8dce65359202833820, https://si.imgix.net/34a09678/uploads/origins/1ed819bc-80ae-4df1-9162-eaff98fa46f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=00de371c94d3fbca53aaa7f788bd21d0 2x, https://si.imgix.net/34a09678/uploads/origins/1ed819bc-80ae-4df1-9162-eaff98fa46f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c933d125591ddf3ec51890693c45fda1 3x"}, "body": "えいる🔞先生。\nいつも素敵なイラストありがとうございます。\n先生の描くオリキャラのデカ乳魔女さんがエロ可愛く感じてしまったのでお願いしたい動機となりました。\n私は触手好きですので触手モノをリクエスト致します。\n\nキャラ　デカ乳魔女さん\nシチュ　触手クリーチャーに捕まった魔女さんが自分が犯されたくないためムチムチおっぱいで触手さんの生殖触手をパイズリ奉仕して絶頂に導いて一旦難を逃れようとします。\nその過程をエロエロに描いて頂きたいです。\n真正面からのパイズリであれば他はどのようにでも描いて頂いて良いです。pixivのパイズリと同じくバストアップだけでも結構です。\n服装はpixivと同じく裸が良いです(帽子があったらなお嬉しいです)\nただ触手の表現は無◯正でお願いしたいです。\n(触手先端部分はとうもろこし型やゴウヤ型がで触手が紫色なら先端は赤色などメリハリがあるととっても興奮します)\n差分は舌でチョロチョロのパイフェラと大量射精で魔女さんのドロドロの顔が見たいです。\n何卒、宜しくお願い致します。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eilev/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2943919, "client_id": 1986473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86910e8e/uploads/origins/9d8947ad-b9e7-427c-885d-5c8f2fc570e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76a171ea5ede817a17db0d4e232d3f17", "srcset": "https://si.imgix.net/86910e8e/uploads/origins/9d8947ad-b9e7-427c-885d-5c8f2fc570e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76a171ea5ede817a17db0d4e232d3f17, https://si.imgix.net/86910e8e/uploads/origins/9d8947ad-b9e7-427c-885d-5c8f2fc570e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a20a75dec368e36d09448172168f21f2 2x, https://si.imgix.net/86910e8e/uploads/origins/9d8947ad-b9e7-427c-885d-5c8f2fc570e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=c