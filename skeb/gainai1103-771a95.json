webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=72826641a5c952204ac43467be2fde9f 3x"}, "body": "いつもお世話になっております。この度ガイナイさんにまたぜひ描いていただきたいと思うリクエストがあり送らせていただきました。\n遊戯王OCGのフレッシュマドルチェ・シスタルトのイラストをお願いしたいです。\n\n構図\n・カメラ目線\n・でっかいおっぱいの前で手を組みシスターらしく祈りを捧げるようなポーズで手を組みつつおっぱいを谷間で挟むように腕でムギュ〜ッ♡と抱き寄せている(イメージ参考イラストのURLを載せておきます)\n・周りに小さなハートがいくつも浮かんでいる\n\n表情\n・困り眉に片目ウィンク&軽く舌をベーっとだした笑顔のイタズラ小悪魔チックな表情\n\n服装\n・純白のフリルやリボンの柄ワンポイントが施された清楚可愛いランジェリー下着\n・(※描写いただける場合)下半身はニーハイ・ガーターベルト着用\n・頭のシスターベールは残したまま\n\n体型\n・全体的に肉つきの良いスタイル\n・長い谷間を目の前に見せつけられるくらいでっかいおっぱい\n・(※描写いただける場合)太ももは極太むっちむち\n・お腹〜腰回りはすっきり細め\n\nその他\n・擬音の語尾には♡を付けていただけると嬉しいです\n\nご多忙の中恐れ入りますが、どうかご検討のほどよろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/110387480", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gainai1103/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3057429, "client_id": 2844238, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/398ee071/uploads/origins/ce8dd2c5-0847-486d-9f29-c39824d163a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a559837a6d097ba3d1423c9a9e4083f", "srcset": "https://si.imgix.net/398ee071/uploads/origins/ce8dd2c5-0847-486d-9f29-c39824d163a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a559837a6d097ba3d1423c9a9e4083f, https://si.imgix.net/398ee071/uploads/origins/ce8dd2c5-0847-486d-9f29-c39824d163a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4ddd331c1c359a05ce8134386dc2531 2x, https://si.imgix.net/398ee071/uploads/origins/ce8dd2c5-0847-486d-9f29-c39824d163a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5581ee778d8950628ce2c482a06f4a77 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/398ee071/uploads/origins/ce8dd2c5-0847-486d-9f29-c39824d163a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd3fed020ed60f244e3e248a005c5d1b", "srcset": "https://si.imgix.net/398ee071/uploads/origins/ce8dd2c5-0847-486d-9f29-c39824d163a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd3fed020ed60f244e3e248a005c5d1b, https://si.imgix.net/398ee071/uploads/origins/ce8dd2c5-0847-486d-9f29-c39824d163a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=10c6432e5352c99ffd18d25637b721ac 2x, https://si.imgix.net/398ee071/uploads/origins/ce8dd2c5-0847-486d-9f29-c39824d163a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4eaa88088787b1547d228ff72a19134d 3x"}, "body": "はじめまして\n\nガイナイ様の作品を拝見して、ぜひ一枚描いていただきたくリクエストいたしました\n\nキャラクター：神芸学徒 ファインメルト(遊戯王OCG)と花海咲季(学園アイドルマスター)\n\n衣装：ファインメルトはエプロン(https://x.com/yugioh_ocg_info/status/1915737571013103826?s=46&t=KBhaTQzm5t7Kh8mNGYuc9g)\n咲季はハッピーミルフィーユ\n\nシチュエーション：ファインメルトはメディウス､咲季は佑芽のことを考えながら虹色のケーキを作る2人のイラストをお願いします", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gainai1103/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3057429, "client_id": 931082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe0409e1/uploads/origins/e91c4824-97c1-46f7-8bbd-bf8a0ccd2cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4ce0803e31af62d131ee5969de891b3", "srcset": "https://si.imgix.net/fe0409e1/uploads/origins/e91c4824-97c1-46f7-8bbd-bf8a0ccd2cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4ce0803e31af62d131ee5969de891b3, https://si.imgix.net/fe0409e1/uploads/origins/e91c4824-97c1-46f7-8bbd-bf8a0ccd2cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c430d6e270b75808fead51420d8c477c 2x, https://si.imgix.net/fe0409e1/uploads/origins/e91c4824-97c1-46f7-8bbd-bf8a0ccd2cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80e069822247a487043eea80e896742d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe0409e1/uploads/origins/e91c4824-97c1-46f7-8bbd-bf8a0ccd2cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cfa71d9ea358fd140c61efd2a5ec1c0", "srcset": "https://si.imgix.net/fe0409e1/uploads/origins/e91c4824-97c1-46f7-8bbd-bf8a0ccd2cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cfa71d9ea358fd140c61efd2a5ec1c0, https://si.imgix.net/fe0409e1/uploads/origins/e91c4824-97c1-46f7-8bbd-bf8a0ccd2cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8d405ef05c9231ffc2e644b1653cd166 2x, https://si.imgix.net/fe0409e1/uploads/origins/e91c4824-97c1-46f7-8bbd-bf8a0ccd2cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5ffdae454b09c718f999f2688c06d1d7 3x"}, "body": "いつもお世話になっております。この度ガイナイさんにまたぜひ描いていただきたいと思うリクエストがあり送らせていただきました。\n遊戯王OCGのフレッシュマドルチェ・シスタルトのイラストをお願いしたいです。\n\n構図\n・自分より小さい子に目線を合わせるようなイメージの前に少し屈んだ姿勢\n\n服装\n・ピンク色基調にフリル付きのブラジャーやワンポイントのリボンが付いたパンツのようなイメージの年頃の可愛い柄の下着姿(頭のシスターベールは残したまま)\n・足はガーター付き白ニーハイ着用\n\n表情\n・お姉ちゃん味溢れる甘えたくなるような慈悲に満ちた目を少し細めた優しい笑顔\n・頬は気持ち少し赤く染まってる\n\n体型\n・全体的に肉つきの良さめなスタイル\n・前屈みの姿勢で長い谷間をこちらの目の前に見せつけるようなでっかいおっぱい\n・太ももは極太むっちむち\n・お腹〜腰回りはすっきり細め\n\nご多忙の中恐れ入りますが、どうかご検討のほどよろしくお願いいたします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gainai1103/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a144d776/uploads/origins/1cb83027-330a-499a-b4ba-7734f4175abc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e59828f298cd234c5eb94e5edb8f2631", "srcset": "https://si.imgix.net/a144d776/uploads/origins/1cb83027-330