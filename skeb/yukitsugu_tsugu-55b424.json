5e1-a18946bd9ad2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b425a333c5308649c58a8bbe6c9a19b", "srcset": "https://si.imgix.net/b462421e/uploads/origins/72a8d03a-aa3e-4aea-95e1-a18946bd9ad2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b425a333c5308649c58a8bbe6c9a19b, https://si.imgix.net/b462421e/uploads/origins/72a8d03a-aa3e-4aea-95e1-a18946bd9ad2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a13d6ec4e24ce616b12cc9d5a052a8a 2x, https://si.imgix.net/b462421e/uploads/origins/72a8d03a-aa3e-4aea-95e1-a18946bd9ad2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9357174102e27c5337b1ed9c692ce416 3x"}, "body": "ゆきつぐ様、こんにちは。\n\nアピールを頂いた禾ズ真です。この度はうちの子、特にリナリーとピュリファに興味を持っていただきメッセージを下さりとても嬉しいです！\nリナリーは自分の一番好きな要素を可能な限り詰め込んだ自創作の看板ヒロインなので、ストーリーも含めてお褒めいただけて作者として冥利に尽きます…！\n\nゆきつぐ様の作品も拝見しました。青肌のタコの要素を持つ女の子など、異色肌の魅力あるキャラを美人に描かれていてとても好きな絵です…！\n\nぜひうちの子も素敵に描いていただけたらと思います！今回はリナリーをお願いします…！\n\n資料はこちらになります。\n■リナリー 基本資料\nhttps://note.com/psyan75_17_ra/n/nf22117fe1c2d\n■ストーリー 導入部分\nhttps://note.com/psyan75_17_ra/n/nf4994bf6ce3b\n\n■リナリーについて\n既に他の方へのリクエスト文から読み込んでいただいた通り、リナリーは青薔薇のアルラウネの女の子です。\nこの世界観においてアルラウネは元となる花や環境により善悪含めて個体差が激しいことから、良心や良識を持っていても魔物として扱われます。\n\nその中でも自然界に存在しないはずの青薔薇から生まれたリナリーはこの世界のアルラウネの中でも前例のない個体であり、本人も小さな頃の記憶がないために正体不明である自身にコンプレックスや不安を抱いていました。\n\n記憶喪失直後は見知らぬ土地で根を張って動けなくなっており、その境遇を見かねたエルフの薬師ルーチェに匿われ9年の時を彼女の義理の妹として共に過ごしました。\nある時ルーチェが冒険の果てにある魔女と「人魚姫の契約」に漕ぎ着けたことで、リナリーは根から離れ自由に動ける脚を得ます。\n\n義姉が自分に内緒で代償を肩代わりしたことをリナリーは察しており、献身を無駄にしないために日々散歩で歩く練習をしています。\nそれに加え自由の大切さが身に染みているのもあり、「会いたい人がいれば自分の足で会いに行く」ことを信条にしています。\n控えめな性格ながらも想い人の主人公に積極的にアプローチするのはそのためです。\n\n自身に宿る花言葉の言霊により夢や奇跡を叶える才能を秘めているリナリーは、とある経緯である物語から生まれた人間の血を半分継ぐ主人公と特別な影響を与え合う関係にあります。初めて会った時に消えかけていた彼の生命や存在を繋ぎ止めたのも、リナリーの無意識の才能が影響しています。\n\n分離した根は薔薇の杖に形を変え、彼女の半身として魔法の詠唱に使われています。\nこの杖による魔力の解放により着ている衣装にも次第に青薔薇の要素が発現していきます。\n\n■外見の特徴\n・エアインテーク+三つ編みの髪型。後ろ髪はふんわり気味に跳ねています。\n片三つ編みの先端は青薔薇となり咲いています。\n感情や体調で咲き具合がかわり、髪を解くと消失し代わりに薔薇の尻尾が生えます。\n・アルラウネならではの緑肌。明るめだけど遠目に見ても緑とわかる位が理想です。頬染めなども基本的には濃い目の緑色になる感じですが、季節の影響や魔力が高ぶった時には赤く紅潮することもたまにあります。\n・ピンクの4本ヅノ。髪束が魔力により薔薇のトゲのイメージで硬化したものです。耳も尖っています。\n・青薔薇種なので生まれつき爪が青いです。\n\n長文になりましたが概ねの説明は以上となります。健気な性格の女の子で、物語が進むにつれどんどん明るい性格になっていきます。\n\nゆきつぐ様の解釈で、素敵なリナリーを描いていただけると嬉しいです！\n\nお返事が遅くなりましたが、リクエスト内容に差し支えなければぜひよろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukitsugu_tsugu/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3754933, "client_id": 253119, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b9b7997/uploads/origins/a1f54ff8-db63-489c-9fc6-a0d95c6e2615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68827dd30a26294c1fc5928d4a0d8d3c", "srcset": "https://si.imgix.net/4b9b7997/uploads/origins/a1f54ff8-db63-489c-9fc6-a0d95c6e2615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68827dd30a26294c1fc5928d4a0d8d3c, https://si.imgix.net/4b9b7997/uploads/origins/a1f54ff8-db63-489c-9fc6-a0d95c6e2615?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53dd57119bd1fa8c0d53023b30015ad8 2x, https://si.imgix.net/4b9b7997/uploads/origins/a1f54ff8-db63-489c-9fc6-a0d95c6e2615?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d4e124c529a47364ab6bb995f14859b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b9b7997/uploads/origins/a1f54ff8-db63-489c-9fc6-a0d95c6e2615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7444a8414252662efa1af0d370d7baa4", "srcset": "https://si.imgix.net/4b9b7997/uploads/origins/a1f54ff8-db63-489c-9fc6-a0d95c6e2615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7444a8414252662efa1af0d370d7baa4, https://si.imgix.net/4b9b7997/uploads/origins/a1f54ff8-db63-489c-9fc6-a0d95c6e2615?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b85f454a9c67df283a68bdba3a9257e 2x, https://si.imgix.net/4b9b7997/uploads/origins/a1f54ff8-db63-489c-9fc6-a0d95c6e2615?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c8082dd2de3c244625d8765d20110261 3x"}, "body": "前回は素敵な作品をありがとうございました。\n連続となりますが、今回は別のOCを描いていただけますでしょうか。\n\n○半妖シスター \nキャラクターの設定\n・魔物を狩る半妖シスター。\n・魔物との混血のため、半魔物状態に変身ができる。\n\n構図等はお任せいたします。\nご検討の程をよろしくお願いいたします。\n\nhttps://imgur.com/a/2kfacqF", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukitsugu_tsugu/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3754933, "client_id": 2835866, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6956fc0d/uploads/origins/353fe0aa-52aa-42c8-9fc2-722bc0293771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d693baa94d0f670393ff73fefa905961", "srcset": "https://si.imgix.net/6956fc0d/uploads/origins/353fe0aa-52aa-42c8-9fc2-722bc0293771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d693baa94d0f670393ff73fefa905961, https://si.imgix.net/6956fc0d/uploads/origins/353fe0aa-52aa-42c8-9fc2-722bc0293771?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2761162a6e3f3252a5f7d08f9a1fbf04 2x, https://si.imgix.net/6956fc0d/uploads/origins/353fe0aa-52aa-42c8-9fc2-722bc0293771?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44050411b731dd3a401444069a950805 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6956fc0d/uploads/origins/353fe0aa-52aa-42c8-9fc2-722bc0293771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=abbb6adfe98b747b944bf08ec3598717", "srcset": "https://si.imgix.net/6956fc0d/uploads/origins/353fe0aa-52aa-42c8-9fc2-722bc0293771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=abbb6adfe98b747b944bf08ec3598717, https://si.imgix.net/6956fc0d/uploads/origins/353fe0aa-52aa-42c8-9fc2-722bc0293771?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9b2ac7debdd3920edd4df6c184e0d11a 2x, https://si.imgix.net/6956fc0d/uploads/origins/353fe0aa-52aa-42c8-9fc2-722bc0293771?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cbeb8a2596cca95e9d04b6559f78d800 3x"}, "body": "ご要望ありがとうございます！エレボスは古代の魔女であり、当初は単なる自由を求めていましたが、やがてどんな代償を払おうとも、あらゆる知識を習得することこそが人生の目標となりました。その結果、彼女は非常に強力な力を手に入れましたが、精神的には少々不安定です。しかし、遊び心があり、思いやりのある性格で、雷のような轟くような声の持ち主でもあります。\n\n全体的に、彼女は威圧的な「ギャップ萌え」の持ち主です。堂々とした体格と風貌、尽きることのない知恵、そして時折見せるサディスティックな一面を持ちながらも、他人に対しては驚くほど忍耐強く、友好的で優しい一面があります。\n非常に勤勉だが、皮肉屋で飽きっぽい。また、自分の無謀な好奇心が自分以外の誰かを危険にさらさないよう、細心の注意を払っている。\n\nこれで十分な情報だと思います！どうぞお好きなように描いてください。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukitsugu_tsugu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3754933, "client_id": 35693, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6dd2d89e/uploads/origins/d275a446-e282-4c17-8954-a726a248ad00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55e1bd7b223cb02707d121dc76177846", "srcset": "https://si.imgix.net/6dd2d89e/uploads/origins/d275a446-e282-4c17-8954-a726a248ad00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55e1bd7b223cb02707d121dc76177846, https://si.imgix.net/6dd2d89e/uploads/origins/d275a446-e282-4c17-8954-a726a248ad00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88d6e768734a03843f3c1b69ad4f1209 2x, https://si.imgix.net/6dd2d89e/uploads/origins/d275a446-e282-4c17-8954-a726a248ad00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee85656b332afb7aa483b206471cb44d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6dd2d89e/uploads/origins/d275a446-e282-4c17-8954-a726a248ad00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a60eb09e8348122beaa4e338641178cd", "srcset": "https://si.imgix.net/6dd2d89e/uploads/origins/d275a446-e282-4c17-8954-a726a248ad00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a60eb09e8348122beaa4e338641178cd, https://si.imgix.net/6dd2d89e/uploads/origins/d275a446-e282-4c17-8954-a726a248ad00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b56eb872f27eda135cf4e9c0fd57b518 2x, https://si.imgix.net/6dd2d89e/uploads/origins/d275a446-e282-4c17-8954-a726a248ad00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=048a58254eff75a0df1dd973227ac291 3x"}, "body": "ユキツグさん、こんにちは！\n\nご依頼ありがとうございます。お返事が遅くなってしまい、申し訳ありません。ぜひイラストを描いていただけると嬉しいです。\n\n私の「泣いているキツネ」と「シャム猫」のキャラクターにご興味をお持ちとのことですね。どちらでもお好きな方を描いてください。\n\nヤクハイ： https://drive.google.com/drive/folders/1MEYGSWahKDu5JVjibvPmPaimWjsL9P3I\n彼女は、ネズミを操る魔法を使い、スパイとして従わせる冒険の魔法使いです。また、生まれつき好奇心旺盛な研究者でもあります。呪いのせいでいつも泣いており、時にはその哀れな姿を利用して他人の同情を引くこともあります。 参考画像では尾が非常に大きいですが、少し細めの尾で描いてください。\n\n以下は、描く際の参考となるシチュエーションのアイデアです：\n- 自分が食べているクッキーやペイストリーを、ネズミに少し分けてあげる\n- 自分が通れないほど狭い窓や穴から這い込めるよう、こっそりとネズミを持ち上げて差し入れる\n- 鶏を抱きかかえている （彼女は時々、魔法の研究対象としてニワトリを使います）\n- 見る人に何か頼み事をしようとして、できるだけ哀れな顔をしている\n- 微笑みながら涙を拭う\n\n\n私のシャム猫のオリジナルキャラクター： https://drive.google.com/drive/folders/1kLII5SdVKVWqI-rJv2J6LMaLv4Jg94Us\n彼女の設定はそれほど詳細ではなく、名前もまだ決めていません。現代の日本に住んでいて、ロリータファッションや歴史的なファッションが好きです。家族は結構裕福なようで、たくさんの服を買う余裕があります。\n\n彼女に関するアイデアをいくつか挙げます：\n- 豪華な大きなパフェを食べている\n- スマートフォンでチャットしている\n- 新しい服を試着している\n- お祭りに出かけて串焼きを食べている\n\nいずれにせよ、どのキャラクターを選ばれても、私が書いたシチュエーションを使う必要はありません。どんなポーズやシチュエーションでも構いません。サプライズが大好きです！衣装替えもOKです。\n\nこのリクエストをご検討いただき、ありがとうございます！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukitsugu_tsugu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3754933, "client_id": 253119, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7889f2f2/uploads/origins/a7f85215-4e1c-4739-83ef-58079d7f06a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87bc29c8c513e9ef05d652c1f9c6712e", "srcset": "https://si.imgix.net/7889f2f2/uploads/origins/a7f85215-4e1c-4739-83ef-58079d7f06a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87bc29c8c513e9ef05d652c1f9c6712e, https://si.imgix.net/7889f2f2/uploads/origins/a7f85215-4e1c-4739-83ef-58079d7f06a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92101632356b6a0874806d1c7af3b7d4 2x, https://si.imgix.net/7889f2f2/uploads/origins/a7f85215-4e1c-4739-83ef-58079d7f06a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=153653e30e16382858c1e4ae7953295f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7889f2f2/uploads/origins/a7f85215-4e1c-4739-83ef-58079d7f06a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9461eacb9751e4a77957f2fdb348e5ea", "srcset": "https://si.imgix.net/7889f2f2/uploads/origins/a7f85215-4e1c-4739-83ef-58079d7f06a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9461eacb9751e4a77957f2fdb348e5ea, https://si.imgix.net/7889f2f2/uploads/origins/a7f85215-4e1c-4739-83ef-58079d7f06a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3aa289fe6a99eabb2a9bc87f3c8d8950 2x, https://si.imgix.net/7889f2f2/uploads/origins/a7f85215-4e1c-4739-83ef-58079d7f06a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&cr