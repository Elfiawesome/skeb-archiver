ef36d341/uploads/origins/8ca6cbc8-1d21-42d7-959d-d9a83daef699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d0e2035a188e35753c2db13fbdc9af3", "srcset": "https://si.imgix.net/ef36d341/uploads/origins/8ca6cbc8-1d21-42d7-959d-d9a83daef699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d0e2035a188e35753c2db13fbdc9af3, https://si.imgix.net/ef36d341/uploads/origins/8ca6cbc8-1d21-42d7-959d-d9a83daef699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38cbdc58bf26928f99cbd0df9d26d2e5 2x, https://si.imgix.net/ef36d341/uploads/origins/8ca6cbc8-1d21-42d7-959d-d9a83daef699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e6d2bf91ae919226b09161582dfc87d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef36d341/uploads/origins/8ca6cbc8-1d21-42d7-959d-d9a83daef699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96e928f98492662691237d2b53bb0e56", "srcset": "https://si.imgix.net/ef36d341/uploads/origins/8ca6cbc8-1d21-42d7-959d-d9a83daef699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96e928f98492662691237d2b53bb0e56, https://si.imgix.net/ef36d341/uploads/origins/8ca6cbc8-1d21-42d7-959d-d9a83daef699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d81ec22fadc8d5af4c12763fd95be4bb 2x, https://si.imgix.net/ef36d341/uploads/origins/8ca6cbc8-1d21-42d7-959d-d9a83daef699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=70ad337d306f4487515638098765cc36 3x"}, "body": "こんにちは、はじめまして。\n\n素敵なイラストですね！お願いがあります！\n\nFGOのBB、ネロ、玉藻でエロいマインドコントロールと洗脳シナリオをお願いしたいです。BBが催眠バイザーを使って玉藻とネロの精神をハッキングする。玉藻とネロがかぶるバイザーには、BBのエンブレムである催眠桜を描いてほしい。\n\nBBは黒いマントだけを羽織る。マントの下はヌードで、恥ずかしげもなく胸が露出している。髪はくるぶしまでのロングヘアでお願いします。\n\n玉藻とネロは水着バージョンで登場する。大きな胸が水着からはみ出し、乳首が露わになります。\n\n全員の胸をいつもより大きくしてください。\n\nポーズは自由です。\n\nBB: https://catbox.moe/c/zh8e4v\nネロ：https://files.catbox.moe/mezww1.jpg\nタマモ：https://files.catbox.moe/u7r0f5.jpg\nマインドコントロール：https://files.catbox.moe/zi47u1.jpg\n\nご検討ありがとうございました！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yukao_100/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 384054, "client_id": 1272769, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/045afb1b/uploads/origins/17240211-e087-4674-a313-fede6876496a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57da6e0ea41894861a2e736bfa676a53", "srcset": "https://si.imgix.net/045afb1b/uploads/origins/17240211-e087-4674-a313-fede6876496a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57da6e0ea41894861a2e736bfa676a53, https://si.imgix.net/045afb1b/uploads/origins/17240211-e087-4674-a313-fede6876496a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b42751100b5e5afb81749cc354df66d2 2x, https://si.imgix.net/045afb1b/uploads/origins/17240211-e087-4674-a313-fede6876496a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c23fc391a278bc3e8ff623236cf4564e 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/045afb1b/uploads/origins/17240211-e087-4674-a313-fede6876496a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed76ed3f685275507f3fa56984ad328b", "srcset": "https://si.imgix.net/045afb1b/uploads/origins/17240211-e087-4674-a313-fede6876496a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed76ed3f685275507f3fa56984ad328b, https://si.imgix.net/045afb1b/uploads/origins/17240211-e087-4674-a313-fede6876496a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6be7de1ca9cbd78fe83d02ff8beb6a68 2x,