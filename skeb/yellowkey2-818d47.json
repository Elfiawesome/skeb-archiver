れて依頼しましたのでリゾート地に旅行に来たのだなと分かればデザインは問いません！\n\n\n上記の内容で足りますでしょうか？\n他、何か資料になるのではと思った物をリンク先にまとめております。\nご検討宜しくお願いします！\n\nhttps://drive.google.com/drive/folders/1VW29jYVEU-jDRTcWokQmnAVVIn_e3T7g?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 215505, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "とらつき🐯", "screen_name": "tigerpger", "avatar_url": "https://pbs.twimg.com/profile_images/1627707401620316160/VakIPy3G.jpg", "header_url": "https://pbs.twimg.com/profile_banners/767895327021998080/1681639548/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 899508, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "よしお", "screen_name": "scomsio", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F1643ff31-9fe7-49c5-a8d6-74e745d202d0.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/a2332b22-d895-43ee-8c7f-713a5d903a09.png", "appeal_receivable": true, "popular_creator_rank": 75, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 14, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1604726, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "夜行貂", "screen_name": "yakoten", "avatar_url": "https://pbs.twimg.com/profile_images/1628296032789606400/Mlvo8Xh7.png", "header_url": "https://pbs.twimg.com/profile_banners/1567326521597259778/1662515503/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "fi