66895e-23b4-49a6-87c4-c4230b0e6c70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7bc02ad5cd930c544926a651186af2ae 3x"}, "body": "初めまして。\nhttps://skeb.jp/@kinnnichan/works/1を見てリクエストさせていただきました。\n\n・BDSPのコウヒカで、ヒカリが尻コキする漫画\n\n・ヒカリは下着も含めて脱衣無し\n\nご検討の程よろしくお願いいたします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kinnnichan/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2009387, "client_id": 3120220, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/161b1cd1/uploads/origins/799ecca2-18e2-4d00-8c8e-1416e9027ef5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da151457015a879b962f19d4eea737ec", "srcset": "https://si.imgix.net/161b1cd1/uploads/origins/799ecca2-18e2-4d00-8c8e-1416e9027ef5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da151457015a879b962f19d4eea737ec, https://si.imgix.net/161b1cd1/uploads/origins/799ecca2-18e2-4d00-8c8e-1416e9027ef5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc6be1fd1bfa96a37935076c8855d5ac 2x, https://si.imgix.net/161b1cd1/uploads/origins/799ecca2-18e2-4d00-8c8e-1416e9027ef5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01decb9057b556ec1d29a5fe17ea5cf2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/161b1cd1/uploads/origins/799ecca2-18e2-4d00-8c8e-1416e9027ef5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b6193ae34fcd990a544aab5515d6ef5", "srcset": "https://si.imgix.net/161b1cd1/uploads/origins/799ecca2-18e2-4d00-8c8e-1416e9027ef5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b6193ae34fcd990a544aab5515d6ef5, https://si.imgix.net/161b1cd1/uploads/origins/799ecca2-18e2-4d00-8c8e-1416e9027ef5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b9a14f1959a27c2d244ea76e9383c5c7 2x, https://si.imgix.net/161b1cd1/uploads/origins/799ecca2-18e2-4d00-8c8e-1416e9027ef5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d6fba1fbc83bc3a1f605555ac11c43d2 3x"}, "body": "こんばんは、はじめまして。\n早速ですがリクエストお願いしたいです。\n\n私のオリキャラの鹿の男の子がポケモンのニンフィアに襲われて食べられてしまうイラストをリクエストしたいです。\n\n具体的には、\n\nニンフィアに押し倒されてドレインキッスをされる\nオリキャラは抵抗しようとするもメロメロボディの効果でちょっとうっとりしてしまい力が入らない\n↓\n体力と一緒に体のサイズまで吸い取られてしまい、気が付いたら一口サイズくらいに体が縮んでしまっている\n↓\nそのまま成すすべ無くニンフィアに食べられて丸呑みにされてしまう\n↓\nお腹の中でメロメロボディにあてられて不思議と心地良く感じてしまう\nニンフィアは満足そうな様子\n\nといったイメージです。\n\nオリキャラの資料は以下の通りで、穏やかな性格の鹿の男の子です。\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1lHiuXZMTCMQ_Pe4yMez0OGohec3Xl8hK", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kinnnichan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2009387, "client_id": 798697, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d708f32/uploads/origins/759c30db-e6a6-4aaf-add4-9cf48ecf96db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=967817f4268eeb340c440096e9d3c98c", "srcset": "https://si.imgix.net/8d708f32/uploads/origins/759c30db-e6a6-4aaf-add4-9cf48ecf96db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=967817f4268eeb340c440096e9d3c98c, https://si.imgix.net/8d708f32/uploads/origins/759c30db-e6a6-4aaf-add4-9cf48ecf96db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19bbe1d7fa3ae09d8f803246835f523c 2x, https://si.imgix.net/8d708f32/uploads/origins/759c30db-e6a6-4aaf-add4-9cf48ecf96db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22ab7583a9aec94dc1d6a9ae26d4b353 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://s