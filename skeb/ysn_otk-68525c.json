": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a9c961c/uploads/origins/51bcf7a0-4f48-4870-bce4-048b18c70402?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1ab2e1dc28fe1bdc9067a011b99f048", "srcset": "https://si.imgix.net/7a9c961c/uploads/origins/51bcf7a0-4f48-4870-bce4-048b18c70402?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1ab2e1dc28fe1bdc9067a011b99f048, https://si.imgix.net/7a9c961c/uploads/origins/51bcf7a0-4f48-4870-bce4-048b18c70402?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=733d6ae8b71f9201c7bad8b84f464ddd 2x, https://si.imgix.net/7a9c961c/uploads/origins/51bcf7a0-4f48-4870-bce4-048b18c70402?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d655ed82ae7092b82995357c9e9af26e 3x"}, "body": "こんにちは　よしのさん\n海老の国でお世話になっております。\n\nこの度よしのさんにイラストの依頼をお願いしたく、連絡させて頂きました。\nロストンウルフのイラストなんですが、\n・振り返りながらサングラスを外してこちらを見上げる構図\n・目はタレ目の三白眼\n\nイラストの依頼に慣れておらず、至らぬ点があったら申し訳ありません。\nこの感じでお願い出来ますでしょうか？", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ysn_otk/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2623756, "client_id": 3016843, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/565f545e/uploads/origins/61ed69a0-5f0a-4082-b833-5f85f607740b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aebac1b169138793447538731a300ff4", "srcset": "https://si.imgix.net/565f545e/uploads/origins/61ed69a0-5f0a-4082-b833-5f85f607740b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aebac1b169138793447538731a300ff4, https://si.imgix.net/565f545e/uploads/origins/61ed69a0-5f0a-4082-b833-5f85f607740b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25418582a644bc3161756105a074a733 2x, https:/