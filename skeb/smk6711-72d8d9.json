の特典用壁紙配布\n\n◾︎納品形式\n・一枚絵のPNG、PSDデータ\n背景も描いていただける場合は透過した人物だけのデータも合わせていただけると幸いです。\n\nご多忙の中かとは存じますがお受けいただけると嬉しいです…！\n何卒ご検討の程よろしくお願い申し上げます！！\n\nhttps://drive.google.com/drive/folders/1-cqdXkQ1pGy1KlZ7WsMVODVCkfyPr_4w", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@smk6711/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/57aa2766/uploads/origins/b5d41793-957d-4d29-b8ae-444d7fe84af6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4cb05af5578f2edd3db36015f3d6298", "srcset": "https://si.imgix.net/57aa2766/uploads/origins/b5d41793-957d-4d29-b8ae-444d7fe84af6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4cb05af5578f2edd3db36015f3d6298, https://si.imgix.net/57aa2766/uploads/origins/b5d41793-957d-4d29-b8ae-444d7fe84af6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6836fa26dd9fb7dbb6d7934ec965344d 2x, https://si.imgix.net/57aa2766/uploads/origins/b5d41793-957d-4d29-b8ae-444d7fe84af6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86b380b9a2fb4ace94d394965f6cbf93 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3267965, "nc": 144}, {"path": "/@smk6711/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3267965, "client_id": 3418788, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/823898d9/uploads/origins/d64bd06d-4237-43a1-9ad1-9fd172233b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccf