//si.imgix.net/e916be2f/uploads/origins/286398cc-5781-4f4e-94b7-19f93709d912?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1145744587310ef7da64d9d7ec82b391", "srcset": "https://si.imgix.net/e916be2f/uploads/origins/286398cc-5781-4f4e-94b7-19f93709d912?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1145744587310ef7da64d9d7ec82b391, https://si.imgix.net/e916be2f/uploads/origins/286398cc-5781-4f4e-94b7-19f93709d912?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e509983dd13d2cfa2184fb61e1280604 2x, https://si.imgix.net/e916be2f/uploads/origins/286398cc-5781-4f4e-94b7-19f93709d912?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1857e54d7cdc98afca1544531ca982be 3x"}, "body": "茜詩ちとせ様\n\n初めまして、個人Vtuberの十七夜いなと申します！アピールにて素敵なお言葉を頂けて嬉しいです✨\n過去のリクエストやXを拝見しました。可愛らしく透明感のある素敵なイラストに惹かれましたので\nぜひ、僕自身を描いて頂きたくリクエストをさせて頂きました！\n\n【ご依頼内容】\n・構図、表情などはすべてお任せします！思うがままに描いて頂けたら嬉しいです✨\n・衣装、髪型のアレンジ大歓迎です！\n・三面図やイメージなどはlitlinkにてご確認いただけます。\n（無性別の人狼、好物は甘いものやコーヒーなど）\n\n【使用用途】\n・XやSNSなどでの利用（アイコン、ヘッダー、おはようVtuber投稿など）\n・Youtubeのサムネイルや動画内での利用\n・納品時に人物のみの透過版を頂けると幸いです！\n\n上記の内容で問題が無ければ、ぜひよろしくお願いいたします！\n\nhttps://lit.link/kanagi_ina", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ChitoseAkaneuta/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2935472, "client_id": 293059, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c30fb00c/uploads/origins/45428d71-0a41-4cfc-81c8-286a77dde7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d5bf9440c1de897ba5820a766692bf2", "srcset": "https://si.imgix.net/c30fb00c/uploads/origins/45428d71-0a41-4cfc-81c8-286a77dde7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d5bf9440c1de897ba5820a766692bf2, https://si.imgix.net/c30fb00c/uploads/origins/45428d71-0a41-4cfc-81c8-286a77dde7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc29b3c9098f2dd5d69105322b88f6b2 2x, https://si.imgix.net/c30fb00c/uploads/origins/45428d71-0a41-4cfc-81c8-286a77dde7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c92a7f7c353138159f326437cb8cf54e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c30fb00c/uploads/origins/45428d71-0a41-4cfc-81c8-286a77dde7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0387d216750540f0ea42f7cadcaa6e16", "srcset": "https://si.imgix.net/c30fb00c/uploads/origins/45428d71-0a41-4cfc-81c8-286a77dde7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0387d216750540f0ea42f7cadcaa6e16, https://si.imgix.net/c30fb00c/uploads/origins/45428d71-0a41-4cfc-81c8-286a77dde7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=95c3c5acc6a883516320c823d122779e 2x, https://si.imgix.net/c30fb00c/uploads/origins/45428d71-0a41-4cfc-81c8-286a77dde7a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cb3aa3a3946d853f99e20415f8313b4a 3x"}, "body": "茜詩ちとせさん、初めまして!\n素敵で可愛らしいイラストの数々を拝見して、ぜひうちの子を描いてほしく、リクエストをさせて頂きました!\n\n○リクエスト内容\n・顔まわりなどは、資料URLや過去のリクエストを参考にしてください。\n・髪型が2タイプあるので、どちらかお好きな方でお願いします。\n・衣装ですが、ご提案頂いた白系のワンピースでお願いします。\n・デザインなどは茜詩ちとせさんにお任せ致します、自由に描いて下さい✨️\n\n・花では無いのですが、エノコログサが好きなので、一緒に描いて頂けたら嬉しいです。\n・構図やシチュエーションなどはおまかせします。\n・使用用途はPCのの壁紙などを想定しているので、横向きでお願いしたいです。\n\nアピールへのお返しが遅くなりすみません...!\n以上、よろしくお願いします!\n\nhttps://drive.google.com/drive/folders/1a6CX2tzOk1jdGSHOMnE7wOUy9ymFqwZq?usp=sharing\nhttps://drive.google.com/file/d/1HPbxyOkBTBV-tXp4cPaP1Nf97gvrycuP/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ChitoseAkaneuta/works/14", "private_thumbnail_image_urls": null