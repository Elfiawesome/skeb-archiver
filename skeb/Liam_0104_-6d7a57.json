itchなどのOP,ED,配信待機画面,\n　サムネイル,マップ隠し,動画・配信内での使用\n②SNS等のアイコン,ヘッダー等やポスト\n③同人規模でのグッズ販売\n④歌ってみた動画のイラスト\n⑤サブスク・メンバーシップ、ファンサイトなど限定で\n　見ることが出来るコンテンツや壁紙配布(PC、スマホ壁紙用)\n\n【キャラクター】\n初期衣装という三面図をご参考にお願いします！\nツノありでツインテール参考という髪型でお願いしたいです！\n\n左目（正面から見ると右目）下にほくろがございます。\n(描き忘れの場合はほくろを描き足す許可をいただければ幸いです。)\n\n以上となります。\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1mYNR35ak-sGGPh8lRVdGFj-ErSLoS6k0?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Liam_0104_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3753840, "client_id": 3925112, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/05827eff/uploads/origins/4eec1854-fe3f-4dc8-b8b3-311e686f460a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95f18df0f5852da340d7ed58be52a73a", "srcset": "https://si.imgix.net/05827eff/uploads/origins/4eec1854-fe3f-4dc8-b8b3-311e686f460a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95f18df0f5852da340d7ed58be52a73a, https://si.imgix.net/05827eff/uploads/origins/4eec1854-fe3f-4dc8-b8b3-311e686f460a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0510e76813f28f2cd505fde13dc250cd 2x, https://si.imgix.net/05827eff/uploads/origins/4eec1854-fe3f-4dc8-b8b3-311e686f460a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52badd1e1cc9875cb82b153fd0629eb9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/05827eff/uploads/origins/4eec1854-fe3f-4dc8-b8b3-311e686f460a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6774f89340d7d072e84e01f0ff4f61b", "srcset": "https://si.imgix.net/05827eff/uploads/origins/4eec1854-fe3f-4dc8-b8b3-311e686f460a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6774f89340d7d072e