方法で構いません。\n\n■参考資料\n・Googleドライブ\n全身資料やテンプレ、他にもイメソン、関係性について記載しております。ご参考になれば幸いです。\n(添付資料の部分に載せております)\n\nもし何か不備等ございましたら申し訳ございません。\n金額が足りなければお手数おかけしますが再送をお願いいたします！😭\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1jWMeYSUfYmRSuZqy7YNXK66_zMqMjIZO", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 381492, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "名木タラコ🌿", "screen_name": "_nagi_onemu", "avatar_url": "https://pbs.twimg.com/profile_images/1984445823967772683/W8gsJ-pL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1247423923181858818/1772147529/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 1679829, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "☁︎usui☁︎", "screen_name": "usuixxxx", "avatar_url": "https://pbs.twimg.com/profile_images/1610657825767985154/9JH-g6N4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1339371788443140097/1713887948/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 128}, {"id": 3518683, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "犬原たんぽぽ", "screen_name": "inu_to_tanpopo", "avatar_url": "https://pbs.twimg.com/profile_images/2010649218860650496/Fq8GTkc0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1800839278962085888/1761816824/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "