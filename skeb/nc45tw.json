f0d38a36-452e-4aaf-be46-0114c2527ff8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b2d8f9db65c8ed0d4469afa134f1f8f", "src_set": ""}, "body": "EMユニとコンのふたなり巨大馬チ○ポを手コキし、ぶっかけられてアへ顔を晒すRAI-MEIをお願いします。\n\n構図は中央にRAI-MEIのバストアップ(頭から股間まで)、その左右にEMユニとコンの腰から太もも辺りのアップで、RAI-MEIの顔の横に左右から馬チ○ポが突き出されており、それをRAI-MEIが両手で握っている状態。また、ユニとコンそれぞれのバストアップを画面の上の方に別枠で描いて下さい。\n\nキャラは全員上半身一杯に覆うくらいの超乳で元々の衣装を完全着衣、馬チ○ポは股間に穴が空いていてそこから出ているものとします。性格や口調はそれぞれお好きなイメージで作っていただいて構いません。\n\nストーリーの流れは\n①3人がこれから行うプレイをマスターに向けて説明し、マスターにもそれを見ながらオナニーすることを促す。\n②手コキ開始。同時にRAI-MEIがユニコンマスターの3人に向けて卑猥な言葉を羅列し、射精を促す。ユニコンは快感に身悶えている。\n③手コキが激しくなり、RAI-MEIのオナサポもヒートアップ。彼女自身も興奮から絶頂しそうであり、ユニコンと3人でフィニッシュに向けてアへ顔で淫語を叫び出す。\n④射精&絶頂。大量の精液を放出するユニコンとそれを胸や頭に浴びるRAI-MEI。3人は白目を剥き理性の消し飛んだアホ面のようなアへ顔で、人の出す声とは思えない濁った雄叫びを上げながら絶頂を迎える。\n⑤射精後。ユニコンは白目のまま放心状態で虚ろな声を上げ、一仕事終えた馬チ○ポもだらしなく垂れ下がっている。そんな中RAI-MEIはアへ顔こそ直っていないものの、可愛らしくダブルピースをしながらマスターも気持ち良くオナニー出来たか聞いてくるのだった。\n\n…といった感じです。\nとにかく全編通してアへ顔と淫語と濁音混じりの喘ぎで埋め尽くしてください。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1OrmF-Yvki6G5dNhXF00bsfUEGbfqYxX_", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nc45tw/works/41", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/31b889d3/uploads/origins/b2255a4b-ead8-4367-8128-10fd4656323f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4756860a527ef2cd2b9a04641ecf68d", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3439715, "client_id": 3459176, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nc45tw/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3439715, "client_