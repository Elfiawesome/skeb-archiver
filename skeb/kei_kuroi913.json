_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3291266, "client_id": 481902, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ecefc10/uploads/origins/0c2f5b37-7e5b-4569-b3fe-6e1d9f6daf6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74a269f1075ec3c7cf16f298884d4266", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ecefc10/uploads/origins/0c2f5b37-7e5b-4569-b3fe-6e1d9f6daf6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4648593a97924e16af15d150588e8b53", "src_set": ""}, "body": "くろいけい様、こんにちは。先日はアピールをお送りいただきまして、ありがとうございました。\nお応えして、リクエストをお送りいたします。\n\nやわらかな水彩風タッチが当方のキャラクター「イヴ」の心優しいところに合うと思いましたので、彼女で一枚お願いしたいと思います。\nキャラクター概要やこれまで他の方にどのようにイメージして頂いているかは、以下のURLにまとめてあります。参考になさってください。\n\nhttps://dragonsnest.hatenadiary.jp/entry/2025/04/27/114218\n\n衣装やシチュエーションはお任せ致します。既存の衣装でも新しい衣装でも、現パロでもコスプレでも大丈夫です。着せたい衣装を着せてみてください。\n\nイラストの用途は\n・SNSやBlogでの紹介\n・オリジナルキャラクターを持ち込めるタイプのゲームでのキャラ絵\n・他イラストレーターへの同キャラクターのイラスト等依頼の際の参照画像\nなどになります。\nまた、イラストからインスピレーションを得た場合はイラストのシチュエーションを絡めた掌編を書いて公開する場合があります。\n\n以上、ご検討よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kei_kuroi913/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3291266, "client_id": 2524635, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/665358cb/uploads/origins/925a7e6a-57d0-4b91-bb86-63ca2b858acc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a48918bd0e8e7fda73140411f0759d8c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/665358cb/uploads/origins/925a7e6a-57d0-4b91-bb86-63ca2b858acc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=2