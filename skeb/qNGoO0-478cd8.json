dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7f3c98086acb1cf412430a47fdaab0e4 3x"}, "body": "初めましてこんにちは！\n🙇🏻‍♀️様のイラストを新着し、一目惚れしました！\nもしよろしければOCたちの一枚絵を描いていただけないでしょうか。\n\n詳細は以下の通りです！\n\nCoC「口渇ルルパ」の探索者たちになります！ネタバレはありません！\n\n【詳細】\nHOフォーク￤ノルド\n身長￤154cm\n少し無愛想。年頃にしては責任感のある少年。\n勉強は嫌いだが得意であり、よく相方があれこれと質問してくる度に答えてくれる。\n細かい作業は苦手だが、相方の髪を編んでくれたりもしてる。\n基本リリィの為ならなんでもしてくれる。\n\nHOナイフ￤リリィ\n身長￤134cm\n元気で明るい馬鹿。精神面はとても強い女の子。\n見た目も花のように美しく、歌も踊りも得意。\n何よりも相方に褒められることが嬉しくて努力してきた。\n好奇心旺盛純粋無垢で相方と一緒にいるのが一番の幸せだと感じてる。\n花冠を作ってノルドにあげたりもしている。\n\n【関係性】\n恋人などよりは兄妹に近い関係性の2人です。\nリリィがノルドを引っ張っていく様な感じ。\n\nお願いしたいところは特にありません。\n服装もこのままでも良いですし、描きやすいようにアレンジしていただいても構いません。\n\n使用用途としては\n・SNSのアイコン、ヘッダーへの使用\n・個人鑑賞\n・非商用かつ自分たち用のグッズ作成\nになります。\n\nもしご縁ありましたら、よろしくお願いします💌\n\nhttps://drive.google.com/drive/folders/1AmuOgxaHJhFO193GoSIN07wSo_t5h6pm", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@qNGoO0/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1636432, "client_id": 2380636, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6eb64142/uploads/origins/b72fa660-52ad-4c69-9094-2f8db87ecb2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95210d0e07041bfb57c4747bd5197335", "srcset": "https://si.imgix.net/6eb64142/uploads/origins/b72fa660-52ad-4c69-9094-2f8db87ecb2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95210d0e07041bfb57c4747bd5197335, https://si.imgix.net/6eb64142/uploads/origins/b72fa660-52ad-4c69-9094-2f8db87ecb2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c176972cb96603d02ca392547838729 2x, https://si.imgix.net/6eb64142/uploads/origins/b72fa660-52ad-4c69-9094-2f8db87ecb2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0feb9abd375262232dcb701882360f83 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "htt