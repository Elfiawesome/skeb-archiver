f2688-e197-4658-8f4d-7667f3d516b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e0c22559e70560bfa4de9e27e891411", "srcset": "https://si.imgix.net/3254d79f/uploads/origins/17ff2688-e197-4658-8f4d-7667f3d516b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e0c22559e70560bfa4de9e27e891411, https://si.imgix.net/3254d79f/uploads/origins/17ff2688-e197-4658-8f4d-7667f3d516b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69e1cc1c75a6340c28023b636f05721a 2x, https://si.imgix.net/3254d79f/uploads/origins/17ff2688-e197-4658-8f4d-7667f3d516b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a045d9db088c88afbcbef4befada8a4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3254d79f/uploads/origins/17ff2688-e197-4658-8f4d-7667f3d516b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fef4523ea5feef0bc47fac34145d940c", "srcset": "https://si.imgix.net/3254d79f/uploads/origins/17ff2688-e197-4658-8f4d-7667f3d516b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fef4523ea5feef0bc47fac34145d940c, https://si.imgix.net/3254d79f/uploads/origins/17ff2688-e197-4658-8f4d-7667f3d516b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e17c50f4decc6c1e9c999dc6481e319d 2x, https://si.imgix.net/3254d79f/uploads/origins/17ff2688-e197-4658-8f4d-7667f3d516b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=53f01277b9531ac9bb04a457c1b985c6 3x"}, "body": "はじめまして、しぐれ様の柔らかくも繊細なイラストに心を打たれ、是非ともTRPGにて生まれたOCを依頼させて頂きたくメッセージを送らせていただきました。リクエスト内容を以下に失礼します。\n\n【キャラクター概要】\nPC①\nPastora・Age (パストラ・エイジ) 女/167cm\n冷徹で人をよく使う我がままな女。\nいつでも冷静で、世界の中心は私だと言わんばかりに何事も意のままに動かす。\nしかしその実は酷く寂しがり屋で、強い愛情ゆえの執着と束縛が渦巻いている。従者が自分から離れて欲しくない一心であり「私に尽くすことが生き方そのものとなり、尽くすことなしでは生きられないようになって欲しい」。そして全てを命令しているのは本人が不器用だからでもあり、焼き菓子を焦がしたりなんとも珍妙な絵を描いたりしている。それらも言い様によって美化しているため、ボロが出ている自覚もない。\n\nPC②\nアントラ 男/175cm\n主人の事を心から想い、善く使える敬虔な従者。「お嬢様はいつも素敵なことを仰る」といつも褒めてくれ、主人の勘違いを加速させている。どんな仕事も完璧にこなし、絵も上手ければ一番得意なことは料理。主人がミスで飛ばしたクルミを華麗にキャッチした。しかし見えないところでは上手く手を抜いているという本物の器用。口から出る言葉は本心で彼女を慕い愛する感情であり、叶うならずっと傍にいたいと思ってくれている。主人に振り回されてばかりだがそんな彼女がたまらなく愛おしい。\n\n呼び方:HO1 私(わたし)／貴方\n               HO2 私(わたくし)／お嬢様\n関係性:主人が従者をリードしているように見せかけて、その構造を成り立たせているのは、全て従者が上手くフォローをしているから。主人はなんでも口にさせたいタイプ。言葉巧みに囲い込み従者から言葉を引き出す。\n\n【イメージ】\n横向き3:4比ですと嬉しいです。構図やポーズ、衣装の簡略化など全ておまかせ致します。色のない世界がモチーフですのでモノクロでお願いしたいです。\n\n 【用途】\n・個人鑑賞\n・グッズ作成（個人利用のための印刷依頼など） \n→可能でしたら文字なしイラストのみの画像も添付して頂きたいです。\n・依頼用の資料としてドライブへの掲載  \n\nお忙しい中と存じますが、ご縁がありましたら嬉しいです。ご検討の程よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1J748IuGFv_mpmQzwtituMr3NyeWskAfQ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1498245, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "やさ子🌿", "screen_name": "minto3835", "avatar_url": "https://pbs.twimg.com/profile_images/1971746225277095939/AFY1x2q9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/368617835/1777879523/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 2064745, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ktr", "screen_name": "ktori_oxo", "avatar_url": "https://pbs.twimg.com/profile_images/1877624328357031936/XOIsjOj6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1467836168259923968/1775071822/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expi