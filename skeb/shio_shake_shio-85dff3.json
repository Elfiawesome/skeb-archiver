の部分はお任せいたします。\n\n\n可能であれば、psdまたは背景を透過したキャラクターのみのファイルも同梱していただきたく思います。\nもしご承認頂けるようでしたら自由に描いていただければ幸いです。\n\n是非ともよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1E93OhoAXoKBxD3voSXcMdf23Ntn-Nj5y?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shio_shake_shio/works/37", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3541197, "client_id": 3018252, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ffcb677/uploads/origins/c7787aaf-cf4f-4fd1-bb10-1e9722f54895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef7f5a0c9e7d007254475d7474dc4e0e", "srcset": "https://si.imgix.net/0ffcb677/uploads/origins/c7787aaf-cf4f-4fd1-bb10-1e9722f54895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef7f5a0c9e7d007254475d7474dc4e0e, https://si.imgix.net/0ffcb677/uploads/origins/c7787aaf-cf4f-4fd1-bb10-1e9722f54895?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7d2c13d868e84489af7116114fadbbd 2x, https://si.imgix.net/0ffcb677/uploads/origins/c7787aaf-cf4f-4fd1-bb10-1e9722f54895?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a50b7e069e792838d21bd17fc5aecdbd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ffcb677/uploads/origins/c7787aaf-cf4f-4fd1-bb10-1e9722f54895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70ce6f5a855ad4c953a20711b71e3839", "srcset": "https://si.imgix.net/0ffcb677/uploads/origins/c7787aaf-cf4f-4fd1-bb10-1e9722f54895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70ce6f5a855ad4c953a20711b71e3839, https://si.imgix.net/0ffcb677/uploads/origins/c7787aaf-cf4f-4fd1-bb10-1e9722f54895?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7db192