9c81adc-ea59-44fa-a2b0-13de2e01fd31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4765adb93077b05dee404c49b691920f, https://si.imgix.net/626879f8/uploads/origins/f9c81adc-ea59-44fa-a2b0-13de2e01fd31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39d0d7966c1fd2594c6e67ecf9124bed 2x, https://si.imgix.net/626879f8/uploads/origins/f9c81adc-ea59-44fa-a2b0-13de2e01fd31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37258109640a63d32e728ad17562b4e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/626879f8/uploads/origins/f9c81adc-ea59-44fa-a2b0-13de2e01fd31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c7786f9ae901bf1c231a7cb57e4454a", "srcset": "https://si.imgix.net/626879f8/uploads/origins/f9c81adc-ea59-44fa-a2b0-13de2e01fd31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c7786f9ae901bf1c231a7cb57e4454a, https://si.imgix.net/626879f8/uploads/origins/f9c81adc-ea59-44fa-a2b0-13de2e01fd31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e1512e414649b54a9b4611b9e2d70df6 2x, https://si.imgix.net/626879f8/uploads/origins/f9c81adc-ea59-44fa-a2b0-13de2e01fd31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8f3abd3692e248ab447170aa4d816ab 3x"}, "body": "しおしゃけ様\n初めまして、とまと と申します。\nいつかご依頼したいと思っておりました。\n\n〇依頼内容\n個人VTuberの「宇井葉 宙」様をお願いします。\nFAとしてプレゼント予定です。\n\n宇井葉宙様\nX\nhttps://x.com/UibaSora_Vtuber\nyoutube\nhttps://youtube.com/@project-uibasora-?si=G0iN4QfR353d7bEb\n自己紹介shorts\nhttps://www.youtube.com/shorts/FPZOcqWcp3g\nリットリンク\nhttps://lit.link/uibasora\n\n構図等全ておまかせしたいです。衣装やネコミミの有り無しなど、全てしおしゃけ様のお好きなように描いていただきたいです。\n\n以下ご本人様からの注意事項になります。\n【注意点：通常衣装】\n・スカートではなくショートパンツです。\n・つめの色は青色です。\n・上着の袖の中は水色です。\n【特に留意していただきたい点：通常衣装】\n・パンツに巻いてあるリボンの先にある星のアクセサリー\n・太もものアクセサリー\n・パンツのベルトループ\n・胸ポケット\n・ブラウスの襟の星や月の柄\n・上着の下部、先端の石アクセサリー\n・袖口の裏地は水色一色です。\n【特に留意していただきたい点：アイドル衣装】\n・袖は半透明です。\n・向かって右側の白いスカートの部分は後ろにもう1枚同じものがあります。\n・襟には柄があります。金属製です。\n・スカート裏のリボンには両面に金属の飾りがあります。\n・スカート表の惑星飾りは球体です。\n・通常衣装と髪型は違います。\n・ケモ耳がある場合でも人間の耳はあります！\n・スカートの裏地は水色一色です。\n【その他】\nアクセサリーの位置、数などは三面図に忠実に描いていただけたらと思いますが、絵柄によって、形、描き方はその限りではございません。\n\n\n使用範囲として、宇井葉宙様のX、youtubeなど活動全般での使用と、私個人のXでのお披露目をご許可いただけますと幸いです。\n\n人物等レイヤ分けされたPSDデータでいただけますと大変ありがたいです。\n\n内容等不備がございましたら再送依頼をお願いいたします。\n\nお忙しい中恐縮ではございますが、何卒ご検討の程よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shio_shake_shio/works/33", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3541197, "client_id": 2754432, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32a66676/uploads/origins/613e6853-8957-4507-8122-08030d3629cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9129d9d22410a189328f007f76b6a9da", "srcset": "https://si.imgix.net/32a66676/uploads/origins/613e6853-8957-4507-8122-08030d3629cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9129d9d22410a189328f007f76b6a9da, https://si.imgix.net/32a66676/uploads/origins/613e6853-8957-4507-8122-08030d3629cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e6f8a6027e25ffbfd030a979d3615d5 2x, https://si.imgix.net/32a66676/uploads/origins/613e6853-8957-4507-8122-08030d3629cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a82863fdd28a25a4a9ae8fd4234e26c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32a66676/uploads/origins/613e6853-8957-4507-8122-08030d3629cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e88bb712b494cfdc5513eca50baef25f", "srcset": "https://si.imgix.net/32a66676/uploads/origins/613e6853-8957-4507-8122-08030d3629cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e88bb712b494cfdc5513eca50baef25f, https://si.imgix.net/32a66676/uploads/origins/613e6853-8957-4507-8122-08030d3629cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f9b619549ebe86a2e239d26f33f5b97 2x, https://si.imgix.net/32a66676/uploads/origins/613e6853-8957-4507-8122-08030d3629cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8f7c98e7b58a62ac86dd5bc350775509 3x"}, "body": "はじめまして！咲音しおんと申します！\n以前よりしおしゃけ様のイラストを拝見し、ぜひ描いていただきたくリクエストを送らせていただきます！\n\n〇使用用途・使用範囲  \n・YouTubeサムネイル(収益化済)  \n・動画内での使用 (short 横動画:収益化あり)\n・Xでの告知、あいさつ等\n\nポーズはおまかせしたく、表情はウインクでお願いさせていただきたいです！\n(楽しそうな感じであれば嬉しいです！)\n\nサムネイルに使用させていただきたいため、\nできれば耳、髪の毛、袖等が見きれないように描いていただければありがたいです\n\n人物の別データをいただきたいです！(人物は透過でお願いしたいです)\n\n長文失礼いたしました。 ご検討のほどよろしくお願いいたします！\n\nキャラクター\n・元気\n・明るい\n・無邪気\n\n三つ編み部分はハーフアップぽくなっている\n(下記キービジュアル参照願います)\nhttps://x.com/sakune_shion/status/1941799407424282778?s=46&t=1bC8vGcKyeT9I_zgvQkamw\n\n立ち絵\nhttps://drive.google.com/file/d/1RbHF1_g91Se_UmtHwfzTweKgczcpRbeh/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shio_shake_shio/works/32", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3541197, "client_id": 3062132, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed024c9f/uploads/origins/d653e835-f719-4285-b2e7-5eb96ec30b96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3491e53357bdeaeaeeab81a5fc34bb5b", "srcset": "https://si.imgix.net/ed024c9f/uploads/origins/d653e835-f719-4285-b2e7-5eb96ec30b96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3491e53357bdeaeaeeab81a5fc34bb5b, https://si.imgix.net/ed024c9f/uploads/origins/d653e835-f719-4285-b2e7-5eb96ec30b96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=