gix.net/6b77b517/uploads/origins/ddc9c560-ec8b-4e40-bd93-17cd3a10f4f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd43e77d7ed8f1b0030ea1d12963852c", "srcset": "https://si.imgix.net/6b77b517/uploads/origins/ddc9c560-ec8b-4e40-bd93-17cd3a10f4f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd43e77d7ed8f1b0030ea1d12963852c, https://si.imgix.net/6b77b517/uploads/origins/ddc9c560-ec8b-4e40-bd93-17cd3a10f4f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fae761411ec4f494789b7d6bf2d9cfac 2x, https://si.imgix.net/6b77b517/uploads/origins/ddc9c560-ec8b-4e40-bd93-17cd3a10f4f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfc8c2d633eb3fec39caab850edd2048 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b77b517/uploads/origins/ddc9c560-ec8b-4e40-bd93-17cd3a10f4f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a594004735a5af8d1e8956835fa872df", "srcset": "https://si.imgix.net/6b77b517/uploads/origins/ddc9c560-ec8b-4e40-bd93-17cd3a10f4f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a594004735a5af8d1e8956835fa872df, https://si.imgix.net/6b77b517/uploads/origins/ddc9c560-ec8b-4e40-bd93-17cd3a10f4f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5f3657bcb32a07c28209976b9efcc02 2x, https://si.imgix.net/6b77b517/uploads/origins/ddc9c560-ec8b-4e40-bd93-17cd3a10f4f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7f35970ca575b04f207265440c5b0a01 3x"}, "body": "こんにちは\nご活躍をTwitter等で楽しみに拝見しております\n当方、この様な取引は初めてなので、失礼がありましたらご容赦ください\n早速ではございますが、以前、描いて頂いたアイコン(芸術品)で更にマイキャラ愛が深まり、ねこ電力様の画風に心酔する様になりました\n６月にプリ☆チャンが終わる予定なので思い出としてマイキャラとの愛(性的)を描いて頂きたいのです\n以下、詳細となります\n\nイメージ＝ご奉仕メイドりんいん\n特徴＞緑髪パンキッシュウルフ・白縁眼鏡・ツリ目・右顎艶ぼくろ・紫アイシャドウ・エロ下着・高身長・巨乳・嫉妬深いドＳ\n「おかえり、ご主人」※様は付けない\n\nシチュ\n\n玄関開けたらドＳメイドがお出迎えから吸引力の減らない只一つの吸いつきフェラ抜き\n「おかえり～お疲れ様～♪いっぱい溜まってるかな〜？」とズボン越しに先端を指でカリカリ\n「出したいの？」と手コキするも自分が我慢出来ず「おっきい♪かたい♪」言いながら夢中でご奉仕\n咥えたまま唇や口元が見えるフェラ顔\n\n乳首見せ＆アソコ拡げておねだり(くぱぁ、陰毛あり)\n「ご主人のおっきいの好き♪おっきいの挿れて♪」\n\n高速ピストン杭打ち蜘蛛騎乗位\n本妻(東堂シオン)に負けてなるものかと既成事実を作る為、Ｓっ気を保ちつつ激しく腰を打ちつけて搾り取りに来る蜘蛛騎乗位\n「ご主人、気持ちいいんだ？イキそう？いいよ、出して♪あっ♪おっきい♪中に出して、いっぱい出して♪かたくなってきた♪あん♪かたい♪出して出して♪熱っ♪いっぱい出てる♪」\nパンッ！パンッ！パンッ！とイッても止めない中出しフィニッシュ\n\n(この後「責任取ってね♪」→第二婦人HAPPYEND)\n\n多々お任せとなってしまいますが、ねこ電力様にてりんいんの魅力が引き出されればと\n☆行為中、ヘッドドレスと眼鏡は付けたままをお願いしたいです\n上記をサンプル足コキみらいの様なコマ割かダイジェスト描写だと、とても嬉しいです\nねこ電力さんの描く赤城アラシの胸とアソコがツボです\n\n一方的な要望(性癖をぶつけて)で申し訳ありません\n咥えてる所が見えるフェラ・くぱぁ・ガニ股騎乗位が大好きで色々書きましたが、シチュ関係なくねこ電力さんの描いたエロい淫乱りんいんが見たい！です\n\nご多忙の中で申し訳ございませんが、何卒よろしくお願い致します", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NEKODENRYOKU/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 208, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9b84a28/uploads/origins/cf209d1c-7a10-4db4-80c9-61bf2a2bff66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c18e58f465407f5033bd61a8b5189de", "srcset": "https://si.imgix.net/f9b84a28/uploads/origins/cf209d1c-7a10-4db4-80c9-61bf2a2bff66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c18e58f465407f5033bd61a8b5189de, https://si.imgix.net/f9b84a28/uploads/origins/cf209d1c-7a10-4db4-80c9-61bf2a2bff66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22ba2f5bc805269771be3286e66e64ca 2x, https://si.imgix.net/f9b84a28/uploads/origins/cf209d1c-7a10-4db4-80c9-61bf2a2bff66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4dfc3d3d5917555c6e3cfa2aaa854bd0 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9b84a28/uploads/origins/cf209d1c-7a10-4db4-80c9-61bf2a2bff66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=793ff0061ec4fc1c7fd610afe6ba8477", "srcset": "https://si.imgix.net/f9b84a28/uploads/origins/cf209d1c-7a10-4db4-80c9-61bf2a2bff66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=793ff0061ec4fc1c7fd610afe6ba8477, https://si.imgix.net/f9b84a28/uploads/origins/cf209d1c-7a10-4db4-80c9-61bf2a2bff66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad181b0d15ef9768680ec01375432230 2x, https://si.imgix.net/f9b84a28/uploads/origins/cf209d1c-7a10-4db4-80c9-61bf2a2bff66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2b99eb285eda110c4b65032412b77221 3x"}, "body": "素晴らしいえっちな絵を拝見しています。デリバリーソルル最高でした。\nぜひねこ電力先生に描いていただきたいのは\nアイドルタイムプリパラのファララ・アラームちゃんがモブ男にフェラする絵をお願いしたいです。\nファララは優しみ溢れる感じ、ファララの事を大好きなモブ男くんに優しくフェラ\nモノクロマンガ形式で、複数コマでお願いできたら幸いです。\n\n* 優しく包茎おちんちん口にキス\n* 皮の間に舌を入れてぐるっと一周おそうじ\n* 男の腰に手を回し、頭を振ってフェラするファララ\n* 気持ちよさに思わず男はファララの頭を掴み「ファ、ファララちゃんっ、で、でるっ」とおもいっきり射精\n* 射精後にあーんと口を開けて口の中の精液を男に見せる\n* ごっくんして（飲んでるのがわかる喉のカット）優しくにっこり、飲んだ感想を言うファララ\n\nな感じの絵が入っていると嬉しいです。\nコマ数的に無理そうでしたら可能な分だけ適当にみつくろって描いていただくか、\nラフっぽい感じでも結構です。\nよろしくお願いします。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NEKODENRYOKU/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 208, "client_id": 408009, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8795663f/uploads/origins/ad7dec57-b270-4b9b-9bfe-233205478a28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94b7b342295216d33855c525a018743f", "srcset": "https://si.imgix.net/8795663f/uploads/origins/ad7dec57-b270-4b9b-9bfe-233205478a28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94b7b342295216d33855c525a018743f, https://si.imgix.net/8795663f/uploads/origins/ad7dec57-b270-4b9b-9bfe-233205478a28?bg=%23fff&auto=format%2Ccompress&fm=we