(グッズにするときに助かるため)\n・可能ならラフ、没ラフも欲しいです\n・顔周りは見切れないようにしてくれると嬉しいです\n・とにかくぐみちゃんの描きやすいように…！！！が最優先でお願いします◎\n\n\nよろしくお願いします♡♡\n\nhttps://drive.google.com/drive/folders/171rec9znbAYUUCEkSXWQWAGiCZXCOBMM", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1353365, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "っmn", "screen_name": "pogpa47985618", "avatar_url": "https://pbs.twimg.com/profile_images/1561795190238879744/1Nd1l1Md.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1391293374133465090/1703783693/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 32}, {"id": 1843330, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "333", "screen_name": "dai210924", "avatar_url": "https://pbs.twimg.com/profile_images/1517161999523741701/7plkxBLL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1390248900267708419/1747811102/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 176}, {"id": 2038291, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "鶫", "screen_name": "simasimaopantu", "avatar_url": "https://pbs.twimg.com/profile_images/1391360130373931008/4c2-WOgg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2995492867/1768087962/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "comple