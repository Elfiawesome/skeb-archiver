トさせていただきます。\nhttps://skeb.jp/@GUMIGU__/works/10\n\nコートを脱いでいるか、着ているかはおまかせします。\n彼女の原典キャラクターは「ハンニバル・レクター」であり、食人を好みます。そのため、苦手であると感じたらリクエストはキャンセルしていただいて構いません。\nうっすらと目を開いて笑う不気味な笑顔が可愛くて好きなので、よかったら描いてあげてください。\n\n好きな食べ物は焼肉、同僚。武器はチェーンソーですが難しいのでかかなくても構いません。エッセンスとして利用していただく場合資料を参考にしてください。\n\n「可愛いのにどこか恐ろしい、なのに目が離せない…という雰囲気」でぜひ描いていただきたいです。\n金額が足りなければ再送依頼を送っていただければと思います。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1A08Wgyas6-Rseds4WvCkmN09xy0ETBxY", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@GUMIGU__/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3344460, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bef7e802/uploads/origins/b7a762a7-a0e4-49eb-a293-71616d45eac7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85ea51b2059f2505ec9a6f7466795a9c", "srcset": "https://si.imgix.net/bef7e802/uploads/origins/b7a762a7-a0e4-49eb-a293-71616d45eac7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85ea51b2059f2505ec9a6f7466795a9c, https://si.imgix.net/bef7e802/uploads/origins/b7a762a7-a0e4-49eb-a293-71616d45eac7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0dac1c9d3c000630f884d22ec4e8182 2x, https://si.imgix.net/bef7e802/uploads/origins/b7a762a7-a0e4-49eb-a293-71616d45eac7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d22f08974a1dfc172e8184066d8065e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bef7e802/uploads/origins/b7a762a7-a0e4-49eb-a293-71616d45eac7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56c21b725bee16aa7c158cb9245164ac", "srcset": "https://si.imgix.net/bef7e802/uploads/origins/b7a762a7-a0e4-49eb-a293-71616d45eac7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56c21