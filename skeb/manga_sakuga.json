t_amount": 10000}, {"genre": "comic", "default_amount": 22000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@manga_sakuga/works/86", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2467367, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fbb7c268/uploads/origins/fa48b7bd-4a6e-4b2d-bac5-860dd7259f87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db39e54f6cfef83a313ca71087077f04", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fbb7c268/uploads/origins/fa48b7bd-4a6e-4b2d-bac5-860dd7259f87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3215a4e5883fb3f24429caf456c0249e", "src_set": ""}, "body": "アルノサージュのネロをお願いします。\n触手にアナルを犯されて、んほぉ系の表情で感じている。アヘ顔差分と白目差分をお願いします。また適当な喘ぎ声をお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@manga_sakuga/works/85", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2467367, "client_id": 54488, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90c1076a/uploads/origins/f2c4ab31-55bf-4ae9-9342-e8ec7652dd31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d09cd642f2b1d4ca7512e68845f6ae3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90c1076a/uploads/origins/f2c4ab31-55bf-4ae9-9342-e8ec7652dd31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81cadddede27d2477aad981692cc4e07", "src_set": ""}, "body": "お世話になります！\n前回は素晴らしい霧生鮮華さんのビフォアフ絵をありがとうございました！ \n\n今回も霧生鮮華さんで、「ベアハッグされながら陵辱中出しされて失神敗北絵」をリクエストしたいです！ \n\n衣装は前回と同じ参考資料のリング衣装で、地下闘技場の試合でマッチョ黒人の大男に敗北して、ベアハッグされながら陵辱されて、中出しされると同時に苦悶と絶頂の性感に耐えられず失神してしまうというシチュでお願いしたいです！ \n\n構図としては以前描かれていたヨルさんのベアハッグ絵（https://www.pixiv.net/artworks/135038073）の3P目からのベアハッグをベースに、キュアビューティのサバ折り絵（https://www.pixiv.net/artworks/135295874）のようにおっぱいに吸い付いて責めてほしいです！（おっぱいのサイズもその絵のヨルさんやキュアビューティと同じくらいで大丈夫です！）\n加えて、思い切り締め上げてる感じで、黒人マッチョの肘を鮮華さんの背中の後ろまで回してほしいです！ \n\nまた、効果音等の差分として、 \n\n1.アヘ顔でおっぱいを揺らしながら悲鳴と喘ぎ声を上げている鮮華さん。激しいピストンの音とおっぱいを吸われて責められている音、身体が締め上げられる音\n（※骨折の1歩手前くらいのダメージにしてほしいので、擬音は「ミシミシ」「メリメリ」「ゴキンッ」「グキンッ」等なら良いですが、「バキバキ」「ボギボギ」「ベキベキ」等の明らかに骨が折れているような音は無しでお願いします） \n\n2.中出しされて絶頂する鮮華さん。ヨルさんベアハッグ絵5P目のような絶頂の喘ぎ叫び声、中出しの断面図カットイン、射精の音 \n\n3.白目を剥いて失神している鮮華さん、弱々しい痙攣と呻き声、ドプッ…ドプッ…と失神してもなお胎内に精液を注ぎ続けられている音\n\nをお願いしたいです！ \n\nなお多分構図的に見えませんが、簡単にペニスを挿入出来るように鎖ガーターの構造は割れ目に鎖を食い込ませずにクリのリングから先は鎖が無い構造でお願いしたいです！ （資料の以前他の方に描いて頂いた絵を参考）\n\n今回も宛名は「ルォナ（キャラ原作:banemumu作、霧生鮮華）」でお願いします！ \n\nまた要望が多くて申し訳ありませんが、よろしければお願いします！\n\nhttps://www.dropbox.com/scl/fo/7zvkdfw6fhrmjfwkouxc4/AMX2WDCjN700ouRmpS-rgRI?rlkey=huauovn245g4dt9qrmyfjy7cg&st=fzc6ez2y&dl=0", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@manga_sakuga/works/84", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2467367, "client_id": 54488, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6207e72e/uploads/origins/a39bbc17-6c3a-4cbb-9431-8344e68ecac8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d38cab3dfdc970f1d37afa4c2c52364", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6207e72e/uploads/origins/a39bbc17-6c3a-4cbb-9431-8344e68ecac8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00f019d41d478f5b09fe96d697ab65a9", "src_set": ""}, "body": "はじめまして！\n可愛らしさとヒロピンが同居する作風を見てリクエストさせて頂きました！\nbanemumuさんという方のオリキャラの霧生鮮花さんのビフォアフ2枚絵をリクエストしたいです！ \n\n霧生鮮花さんは引き締まった体でおっぱいの大きい、八重歯と（関西出身でもないのに）関西弁がチャームポイントの明るく気さくなお姉ちゃんです！\n実家が中華料理屋で、店の手伝い等でチャイナ服を着ることが多いです！\nまた、幼い時から中国拳法とテコンドーを学んでいて、格闘の心得があります！ \n\n今回依頼したいのは2枚の差分で、鮮花さんの普段着のチャイナ服（1枚目）と、地下闘技場のリング衣装（2枚目）です！ \n\n1枚目の通常チャイナは、資料のチャイナ1をベースに太ももの伝票を外して、代わりにチャイナ2のニーソを穿かせてほしいです！（パンツはチャイナ2の緑の紐パンでお願いします！）\nまた、ポーズは以前漫画・作画チャンネルさんが描かれていたドラゴンヒールさんのカンフーポーズ（https://www.pixiv.net/artworks/134805570）のようなポーズと表情で、自信に溢れた不敵な笑顔でパンチラしながら片脚を大きく掲げてほしいです！\nあと、吹き出しで「なんやまだやるんか？ええで、うちがまとめて相手したるからかかってき！」という台詞をお願いしたいです！\n\n\n2枚目のリング衣装は、ポーズは1枚目と同じでアソコを丸見えにしながら、衣装を資料のリング衣装にして、調教で感度を上げられて鎖ガーターをつけられて感じてしまいながらも、羞恥と性感に耐えながら気丈に試合相手を睨みつけている表情でお願いしたいです！\n意思に反して発情して乳首を硬く勃たせて、荒い息をしながら時折噛み殺した喘ぎ声を漏らしながら、愛液を溢れさせてアソコをビショビショにしている感じでお願いしたいです！\nまた、吹き出しとモノローグで、「クソッ…！うちは…絶対に負けん…！」（アロエ…必ずお姉ちゃんが助けたるからな…！）という台詞をお願いしたいです！ \n\n鮮花さんの原作者が誰か解るように明記するのがbanemumuさんとの約束なので、宛名は「ルォナ（キャラ原作:banemumu作、霧生鮮華）」という宛名をお願いしたいです！ \n\n注文が多くなってしまい大変申し訳なく思っていますが、よろしければお願いします！\n\nhttps://www.dropbox.com/scl/fo/zfg3gu025hnhzqlg22gfv/ANGzLMvDfUMlPc3BAA0RCec?rlkey=mq52kadslwqm0tmx2qep5wh4n&st=1osdytg1&dl=0", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@manga_sakuga/works/83", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c98474b2/uploads/origins/6855a9ee-a5d9-41ea-b6a1-4795c6e233a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3df8f841c79042e89315e3d2f48776b5", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2467367, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@manga_sakuga/works/82", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d186d978/uploads/origins/ca4b70ec-65be-4dca-a7b3-8dfc17ce7ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&