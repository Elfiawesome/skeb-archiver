ate_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3620252, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5cc00b69/uploads/origins/1932d2e2-240e-4aee-af5b-be22f6c044b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8641f95f28439a85cd21b852f585cc0c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5cc00b69/uploads/origins/1932d2e2-240e-4aee-af5b-be22f6c044b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f92fc76aae9c5413d575d8fe1bdbe38", "src_set": ""}, "body": "うららさん初めまして。\nウマ娘にてご依頼を掛けられそうな人を探した所、可愛い絵柄で描かれているうららさんをお見かけさせて頂きました！\nキャラも幅広く、オールキャラで対応できそうな方でしたので、もしよろしければウマ娘の「エアメサイア」ちゃんをお願いしたく、更には「トサキントレオタード」をコスプレさせて頂いたイラストをお願いできますか。\n（※トサキントレオタード→初代のポケモンアニメ43話「ナッシーぐんだん　だいこうしん！」で、カスミがマジシャンのアシスタントの際に着用していた、トサキントを模した衣装を指してます）\n\n衣装の造形につきましては資料ページのURLをご参考頂ければと存じます。\nこの衣装がずっと大好きなため、完全に自分の趣味としてコスプレでご依頼させて頂きたいです。もちろん元ネタをご存じないだろうことは覚悟の上ですので、それでもよろしければお願いさせて頂きたく存じます……！\n\n表情や構図・ポーズ、あと多少のアレンジなどについては、うららさんが良いと思ったまま、ご想像されるままのエアメサイアちゃんで描いて頂ければOKです。\nセンシティブに配慮してストッキング履かせる等の微アレンジを加えて頂く等は問題ないですが、もちろん原作デザインそのままに素足で描かれてもOKです！\n（だけどロングな手袋が性癖なので、アレンジしても手袋は忘れないで頂ければとてもすごく嬉しいです……）\n一応コスプレ（衣装）姿がメインとなるため、できればで十分ですが、全身が拝める構図で衣装姿を堪能させて頂ければ特に嬉しく思います。\n\nやや無茶な依頼とは存じますが、それでもよろしければ何卒お願いいたします！\n\nhttps://bulbapedia.bulbagarden.net/w/index.php?title=File:Misty_Goldeen_outfit.png", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 532830, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぽひこ@", "screen_name": "EK1003o", "avatar_url": "https://pbs.twimg.com/profile_images/1751832113077428224/DijvN5zV.jpg", "header_url": "https://pbs.twimg.com/profile_banners/792749657747095554/1701523565/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": nul