もOKのカプ厨ツイ廃民。オタク。好きな食べ物はサーモン\n\nhttps://drive.google.com/drive/folders/1P6vmDr3EOW9K7hwpSUaKwWUbZ7ePOoVp", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nekonopoket2/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3727771, "client_id": 3735011, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d27617ed/uploads/origins/8cd31de9-bfc2-481a-b830-8ce759903627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccea5c6bf19f3c7268ba5553c6829d4f", "srcset": "https://si.imgix.net/d27617ed/uploads/origins/8cd31de9-bfc2-481a-b830-8ce759903627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccea5c6bf19f3c7268ba5553c6829d4f, https://si.imgix.net/d27617ed/uploads/origins/8cd31de9-bfc2-481a-b830-8ce759903627?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da53812298d2b1979e0fcd420e0c9dcd 2x, https://si.imgix.net/d27617ed/uploads/origins/8cd31de9-bfc2-481a-b830-8ce759903627?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=109e9ecd21c64c4e0033900768ad2640 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d27617ed/uploads/origins/8cd31de9-bfc2-481a-b830-8ce759903627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5876a2c35014f43ab63dcd193ad18391", "srcset": "https://si.imgix.net/d27617ed/uploads/origins/8cd31de9-bfc2-481a-b830-8ce759903627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5876a2c35014f43ab63dcd193ad18391, https://si.imgix.net/d27617ed/uploads/origins/8cd31de9-bfc2-481a-b830-8ce759903627?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d960617c0c2e9f2c355ae91a1fa1326d 2x, https://si.imgix.net/d27617ed/uploads/origins/8cd31de9-bfc2-481a-b830-8ce75990362