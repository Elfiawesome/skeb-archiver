すべてお任せいたします。お好きなように描いていただければと思います。  \n\n✧参考資料\nhttps://www.dropbox.com/scl/fo/v902shwmq1n5ewr8gzwf5/AOwdEL2jZOxfkCTSqTKmQwY?rlkey=s6mgfljfiickxfxfnhkj6gx6v&st=47cy43sm&dl=0\n（URLを間違えているのをすっかり忘れていました……再送ありがとうございます😭 お手数をおかけしました……！）  \n\n以上となります。 お忙しいとは思いますが、ご検討いただけたら幸いです。 \nもし資料や金額に不備がありましたら再送して下さると助かります🌸 何卒よろしくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@c5963522137006/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3758658, "client_id": 1219985, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46faa9b0/uploads/origins/9c3263fc-9abf-4c65-9dfd-0d255926c78a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdd2e999723d2b28b278fdc3b420d95e", "srcset": "https://si.imgix.net/46faa9b0/uploads/origins/9c3263fc-9abf-4c65-9dfd-0d255926c78a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdd2e999723d2b28b278fdc3b420d95e, https://si.imgix.net/46faa9b0/uploads/origins/9c3263fc-9abf-4c65-9dfd-0d255926c78a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97fa543c04c78d6f99c0c37dde57ccb7 2x, https://si.imgix.net/46faa9b0/uploads/origins/9c3263fc-9abf-4c65-9dfd-0d255926c78a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8aa991f34b725c4ab0bd1acf5e939784 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46faa9b0/uploads/origins/9c3263fc-9abf-4c65-9dfd-0d255926c78a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e345ded11ea965fdcbd216cd69b7b61b", "srcset": "https://si.imgix.net/46faa9b0/uploads/origins/9c3263fc-9abf-4c65-9dfd-0d255926c78a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e345ded11ea965fdcbd216cd69b7b61b, https://si.imgix.net/46faa9b0/uploads/origins/9c3263fc-9abf-4c65-9dfd-0