6歳、荒事担当、狼モチーフ\nピンク髪/黒いツリ目/たくさんのピアス /胸元にタトゥー\n\n短気ですぐ手が出る。\n地頭はいいが考えることが嫌いで、感覚で生きているタイプ。\n夕空に何か言われてもサラリと流し、いざと言う時には彼女を抱えて逃げたり庇ったりと、守る意識はかなりある。\n何かと武力で解決しがち。\n\n\n内容等に不備がございましたら、お手数ですがキャンセル・再送をお願いします。\nご検討いただけますと幸いです、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1xdfo4jVkzLQ0ZVXeTV810fDbp2XGkvsv", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kyekyepokopoko/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5c2b486e/uploads/origins/c97ca3b2-421b-4454-98ca-f8c377036e2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa785bf25b4055ede9f86e8b2dd8df3e", "srcset": "https://si.imgix.net/5c2b486e/uploads/origins/c97ca3b2-421b-4454-98ca-f8c377036e2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa785bf25b4055ede9f86e8b2dd8df3e, https://si.imgix.net/5c2b486e/uploads/origins/c97ca3b2-421b-4454-98ca-f8c377036e2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e7b1574f031565c788aed07277026bf 2x, https://si.imgix.net/5c2b486e/uploads/origins/c97ca3b2-421b-4454-98ca-f8c377036e2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=346104f47c895f6c9d086e75f5a6b28d 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 4036446, "nc": 0}], "sent_works": [], "similar_creators": [{"id": 1489778, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "はちうら", "screen_name": "Hachiura_two", "avatar_url": "https://pbs.twimg.com/profile_images/1437781052232278032/Y_PylO3Z.jpg", "header_url": "https://pbs.tw