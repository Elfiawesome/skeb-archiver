il_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4036446, "client_id": 1424711, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4e449bc/uploads/origins/725377bc-3ddb-4e6d-8739-d7946eadce11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a08985c2a176516374176a523f8e1015", "srcset": "https://si.imgix.net/a4e449bc/uploads/origins/725377bc-3ddb-4e6d-8739-d7946eadce11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a08985c2a176516374176a523f8e1015, https://si.imgix.net/a4e449bc/uploads/origins/725377bc-3ddb-4e6d-8739-d7946eadce11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa76ccc38cd010924a4955723b7c7318 2x, https://si.imgix.net/a4e449bc/uploads/origins/725377bc-3ddb-4e6d-8739-d7946eadce11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34934e21a73bfb7491ceb53c98754bec 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4e449bc/uploads/origins/725377bc-3ddb-4e6d-8739-d7946eadce11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08fda6133ec2954f17821a3c7cec7e50", "srcset": "https://si.imgix.net/a4e449bc/uploads/origins/725377bc-3ddb-4e6d-8739-d7946eadce11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08fda6133ec2954f17821a3c7cec7e50, https://si.imgix.net/a4e449bc/uploads/origins/725377bc-3ddb-4e6d-8739-d7946eadce11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c3c830273ac30a1555b093b2478f9dd9 2x, https://si.imgix.net/a4e449bc/uploads/origins/725377bc-3ddb-4e6d-8739-d7946eadce11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ae20b115de47541d085dcde7d828274e 3x"}, "body": "初めまして！\nとても素敵でどタイプなデザインとイラストの立ち絵をXにて拝見し、リクエストさせて頂きたくまいりました\n\nもし可能であれば、TRPG OCふたりをお願い出来ればと思います\nむずかしければ、水色髪の女の子(夕空)をお願いします\n\n可能であれば、2人或いは夕空の新しい私服を考えて頂ければ嬉しいなと考えております。\n\n▽参考資料\nhttps://drive.google.com/drive/folders/1xdfo4jVkzLQ0ZVXeTV810fDbp2XGkvsv\n\n▼関係性\n裏社会で、危なめな薬を売っているコンビ。\n 距離感はかなり近いが、お互いに恋仲にはならない「バディ」。\nふざけるなよ！と言い合ったり、怒ったりしても何だかんだ相方が一番大切な2人。\n\n▼哀川 夕空(あいかわ ゆあ)\n女、154cm、21歳、交渉役、兎モチーフ\n水色髪/三つ編み/赤いツリ目 /地雷系寄りの服\n(胸は小さめですが、絶壁ではないです)\n\n真面目な性格だが、裏社会に染まり愛想笑いが得意になった。\n一言で言えばツンデレ。\n 「ちょっと、ふざけんじゃないわよ！」 と相方に注意したり怒りがち。 \n心配性なだけで、気にかけているし大事にも思っている。   \n\n\n▼蓬 蓮(よもぎ れん) \n男、183cm、26歳、荒事担当、狼モチーフ\nピンク髪/黒いツリ目/たくさんのピアス /胸元にタトゥー\n\n短気ですぐ手が出る。\n地頭はいいが考えることが嫌いで、感覚で生きているタイプ。\n夕空に何か言われてもサラリと流し、いざと言う時には彼女を抱えて逃げたり庇ったりと、守る意識はかなりある。\n何かと武力で解決しがち。\n\n\n内容等に不備がございましたら、お手数ですがキャンセル・再送をお願いします。\nご検討いただけますと幸いです、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1xdfo4jVkzLQ0ZVXeTV810fDbp2XGkvsv", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kyekyepokopoko/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5c2b486e/uploads/origins/c97ca3b2-421b-4454-98ca-f8c377036e2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa785bf25b4055ede9f86e8b2dd8df3e", "srcset": "https://si.imgix.net/5c2b486e/uploads/origins/c97ca3b2-421b-4454-98ca-f8c377036e2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa785bf25b4055ede9f86e8b2dd8df3e, https://si.imgix.net/5c2b486e/uploads/origins/c97ca3b2-421b-4454-98ca-f8c377036e2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e7b1574f031565c788aed07277026bf 2x, https://si.imgix.net/5c2b486e/uploads/origins/c97ca3b2-421b-4454-98ca-f8c377036e2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txt