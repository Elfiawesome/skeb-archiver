い）。\n\nテーマは、似たようなゲーム／キャラクターのテーマを彷彿とさせるものでもよい。あなたが作った曲の中で一番好きなのは、この曲です： https://www.youtube.com/watch?v=QPhJzcdvOlg\n\n決意と希望に満ちた感じが好きです。また、私はアコースティックギターの大ファンなのですが、できればこの曲でも使っていただけたらと思います！私が選んだ曲と似たようなものがとてもよく合うと思います！\n\nhttps://drive.google.com/drive/folders/1UpO0pg9tMI3vcEW6uxJsa1N9lS7Idzm1?usp=share_link", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@kashiwade/works/3", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1946940106549477376%2FQAWIYBbu.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e2e6b3b70a0c11ed799f8e3fa4e807b", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1946940106549477376%2FQAWIYBbu.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e2e6b3b70a0c11ed799f8e3fa4e807b, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1946940106549477376%2FQAWIYBbu.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c0f8c9315499262c90da0be01606269 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1946940106549477376%2FQAWIYBbu.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d61430a265dcfc602dbcdc1617b4aa9 3x"}, "private": true, "genre": "music", "tipped": true, "creator_id": 187634, "nc": 145}, {"path": "/@kashiwade/works/2", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F19469401065494