。\n\n【使用用途】\n\n個人利用及びイラストをご依頼する際の参考資料として使わせていただきたいです。\n\n【設定】\n\n・年齢は10歳\n・身長は140cm\n・胸はAカップ\n・性格は無邪気な子供\n・髪色は銀髪で、アホ毛もありあます。\n・狐耳と尻尾は薄茶色なのでご注意ください。\n・瞳は灰色でジト目\n\n【イメージ】\n\n描いていただいたうちの娘ちゃんがとても素晴らしかったため、\n白ワンピを着た娘ちゃんの背面込みのキャラクターシートをリクエストさせていただきます。\n\n内容としては、描いて頂いた娘ちゃんのように、衣装は白ワンピ、髪型はロングでお願いいたします。\nシートの様式はアリス服のキャラシートを参考にしていただければ幸いです。\n\n金額等の不足がございましたら再送要求お願いいたします。\nキャラクターシートをお受けしていない場合は、お手数ですがキャンセルをお願いいたします。\n\nどうかご検討のほど宜しくお願いいたします。\n\n【参考資料】\n\nhttps://drive.google.com/drive/folders/1IRcvRdkKIkqc8Y_0FtUFelMA9IAGKCXX?usp=sharing\nhttps://drive.google.com/drive/folders/12gRFP9ms3alVu346424JT7EktcbG_pJx?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mori_nsr/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2652091, "client_id": 261479, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55255322/uploads/origins/f14e3e5a-c5fa-4e7a-a5bd-b248a2ee23e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f42127842a42fc2876f3cb467c3444bf", "srcset": "https://si.imgix.net/55255322/uploads/origins/f14e3e5a-c5fa-4e7a-a5bd-b248a2ee23e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f42127842a42fc2876f3cb467c3444bf, https://si.imgix.net/55255322/uploads/origins/f14e3e5a-c5fa-4e7a-a5bd-b248a2ee23e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17fa69b590930b38dd36d6097c436961 2x, https://si.imgix.net/55255322/uploads/origins/f14e3e5a-c5fa-4e7a-a5bd-b248a2ee23e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=371a1e27ba8050a69b6ec1a0b0e6d85f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55255322/uploads/origins/f14e3e5a-c5fa-4e7a-a5bd-b248a2ee23e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14ae9ff2368a91f3c1d53f15798