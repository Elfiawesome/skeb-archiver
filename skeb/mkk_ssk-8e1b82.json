%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=13beec71bb06837f9bdcaad85c6028e9 3x"}, "body": "先日は素敵なイラストをありがとうございました。あまりに可愛かったので、あの後どうなったんだろう？という続きネタが出来てしまいましてコミッションさせて頂きます。ご検討頂ければ幸いです。\nドギマギしながら学校へ向かうと、何故か元から女子だったということになっていた。誰も違和感を持たず、女子グループに迎えられる(逆に元々友達だった男子グループとは距離が)。憧れだった高嶺の花の女の子は大の仲良しになっていて、体育の着替えの時、上着を脱いだところを背後からイタズラで胸を揉まれて赤面してしまう(男の頃抱いていた彼女の落ち着いたイメージとのギャップにも驚きつつ)。体育の方も、女の子になって走ったり飛んだらしていると身体が色々揺れてしまいダメダメだ(本人は気づいていないが、色々無防備な所作をしてしまっているので男子から生暖かい目で見られている。汗だくでまた透けブラとかも)。極め付けに、どうやら男時代親友だった彼とは付き合っているらしく、放課後一緒に帰ることに。身体に引っ張られているのか本心なのかわからないが、手を繋いで彼と並んで歩いているだけでドキドキが止まらなくて…。\nキャラクターのデザイン、構図は指定ございません。\n\n長文失礼しました。\nご検討ください！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mkk_ssk/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2170700, "client_id": 363341, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41848879/uploads/origins/24083c39-cdb1-4435-97ea-f28d2a9ba9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4c4d90faa13ebb8854fbb866375529d", "srcset": "https://si.imgix.net/41848879/uploads/origins/24083c39-cdb1-4435-97ea-f28d2a9ba9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4c4d90faa13ebb8854fbb866375529d, https://si.imgix.net/41848879/uploads/origins/24083c39-cdb1-4435-97ea-f28d2a9ba9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e843db3bf6539b1608b54a798d3d781c 2x, https://si.imgix.net/41848879/uploads/origins/24083c39-cdb1-4435-97ea-f28d2a9ba9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f809f6e72a5a97908f08867f1eb2f9ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41848879/uploads/origins/24083c39-cdb1-4435-97ea-f28d2a9ba9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1eb2863d8ca272d88ecf2ff2f278612c", "srcset": "https://si.imgix.net/41848879/uploads/origins/24083c39-cdb1-4435-97ea-f28d2a9ba9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1eb2863d8ca272d88ecf2ff2f278612c, https://si.imgix.net/41848879/uploads/origins/24083c39-cdb1-4435-97ea-f28d2a9ba9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a02dae0c32bd36e55cf6f71c6dea804a 2x, https://si.imgix.net/41848879/uploads/origins/24083c39-cdb1-4435-97ea-f28d2a9ba9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=01643630fc290880118a3b90e7651610 3x"}, "body": "初めまして。TSFのイラスト拝見してコミッションさせて頂きました！\n形式はお任せさせていただきます！　ご検討いただければ幸いです。以下詳細です。\n夏服の男子高校生が気づかないうちに服装ごと女の子に変化し、夏制服JKになってしまう(若干透けブラ)。\nふと胸元のふくらみに気づき、スクールブラウスをつまみ上げると谷間と着けた覚えのない水色のブラジャーがチラ見えして赤面。\n慌ててボタンをすべて外すとやっぱり女の子になっていると思い知らされ、スカートまでめくりあげてショーツまで確認して大騒ぎしてしまう。", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mkk_ssk/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2170700, "client_id": 1673272, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d857dc8/uploads/origins/d060c765-0762-4705-8f2f-0e5af1a9981d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17bb6ebfdd3c62ade502bdfdc7a57c1f", "srcset": "https://si.imgix.net/3d857dc8/uploads/origins/d060c765-0762-4705-8f2f-0e5af1a9981d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17bb6ebfdd3c62ade502bdfdc7a57c1f, https://si.imgix.net/3d857dc8/uploads/origins/d060c765-0762-4705-8f2f-0e5af1a9981d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2079435a3d304b371a8b1a7835a482e 2x, https://si.imgix.net/3d857dc8/uploads/origins/d060c765-0762-4705-8f2f-0e5af1a9981d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f0cf84aa5f9c71d51419cc71bf6efbf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d857dc8/uploads/origins/d060c765-0762-4705-8f2f-0e5af1a9981d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc015720715564508cb673f18dc931f5", "srcset": "https://si.imgix.net/3d857dc8/uploads/origins/d060c765-0762-4705-8f2f-0e5af1a9981d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc015720715564508cb673f18dc931f5, https://si.imgix.net/3d857dc8/uploads/origins/d060c765-0762-4705-8f2f-0e5af1a9981d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=137a7ded953007235c1bc4378b6a77cb 2x, https://si.imgix.net/3d857dc8/uploads/origins/d060c765-0762-4705-8f2f-0e5af1a9981d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2d4a0453a5bff90005ab397f3bb0f50 3x"}, "body": "初めまして。\nこんばんは。\nはるまきこ様におまかせのイラストをご依頼させていただきたいです。\n下記の二人のイラストを希望です。\n・オリジナルキャラクター(女の子)135cm\n服装などは参考の画像と同じで良い\n\n二人共吊り目\n女の子の目はもっとでっかい\n肌は男性より白い\n前髪長い\n顔の両側の髪はカールしている\n性格設定:天然系だが、マイペース、神経質でヤンデレ\n恋愛的には嫉妬深い\n彼氏に対して甘え上手(犬系女子)\n\n\n男子:パーマ\n帽子外の髪はふわふわ\n\n・二次創作キャラクター(男の子)：Kyle Broflovski \n137cm\n服装などは参考の画像と同じで良い\n\n頭いい、モラルが高い\n問題解決が上手だが、時には衝動的な行動になりがち\n恋愛に不器用・純情\n彼女に過保護\n\n二人はカップル設定です。\nシチュエーションなどは特に希望がありませんので、全部おまかせします。\n\n\n\n長文になりますが、どうぞ、ご検討よろしくお願い致します。\nhttps://drive.google.com/file/d/1YKM5pqDRSCU4NohU7C6dNRcvHQm1ip6K/view?usp=drivesdk\nhttps://drive.google.com/file/d/19lCSCJxS6fPmaO0qyBTVxJCFtQ-qcJ6N/view?usp=drivesdk", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mkk_ssk/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2170700, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a80432de/uploads/origins/383a20d2-c3e8-4b2e-809e-e7e08fdbc786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=