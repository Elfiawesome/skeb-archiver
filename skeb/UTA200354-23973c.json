mgix.net/a456932f/uploads/origins/08be7b5f-67c1-481b-a723-e43b77f961bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c65a7daf35b937ad282fa46be26dbfa8", "srcset": "https://si.imgix.net/a456932f/uploads/origins/08be7b5f-67c1-481b-a723-e43b77f961bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c65a7daf35b937ad282fa46be26dbfa8, https://si.imgix.net/a456932f/uploads/origins/08be7b5f-67c1-481b-a723-e43b77f961bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=341b9fe295271325db4a4bfca451a07d 2x, https://si.imgix.net/a456932f/uploads/origins/08be7b5f-67c1-481b-a723-e43b77f961bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09dd50e95b6b17495e76ed34287a511a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a456932f/uploads/origins/08be7b5f-67c1-481b-a723-e43b77f961bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=405752cb8dfe366fb94f641354b0696d", "srcset": "https://si.imgix.net/a456932f/uploads/origins/08be7b5f-67c1-481b-a723-e43b77f961bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=405752cb8dfe366fb94f641354b0696d, https://si.imgix.net/a456932f/uploads/origins/08be7b5f-67c1-481b-a723-e43b77f961bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ffbf0e9619248872ed94430e7134adc 2x, https://si.imgix.net/a456932f/uploads/origins/08be7b5f-67c1-481b-a723-e43b77f961bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=044b9ea7d7d9487ed546ce47f119e0af 3x"}, "body": "こちらでは初めまして！\n\n謳さまの描かれるかっこよくて少しダークな世界観のイラスト、とても大好きです～！\n今回手数料無料期間ということでしたので、ぜひ自創作キャラを描いていただけないかと思いリクエスト送らせていただきました。\n\n資料は下記URL先にまとめてありますので、確認いただければと思います。\nベージュの頭でも、ピンクの頭の方でも、どちらか片方だけで構いませんのでお好きに描いていただけますと幸いです。\n（ 服装や髪形等、すべて絵柄に合わせ描きやすいようにアレンジしていただいて大丈夫です！ ）\n\nお時間、金額の都合が合いましたらよろしくお願いいたします