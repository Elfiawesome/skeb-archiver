げもなく晒し、深々と入ったスリットも瑞々しい太ももを露わにしている。紅の長髪はしっとり艶めき、唇も熟れた果実のようだ。伏せられた睫毛はフリルのように細やかで、今にも開眼し、あの緋色でクラウザーを再び睨んで来る気さえする。\"という箇所となります。\nこちらもルイが主体となるような構図で全身が映るように描いて頂きたいです。\n\n⓵、⓶の内、どちらかというと⓶の方にウェイトを置いて頂きたいです。\n何卒宜しくお願い致します。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@PassionateSnuff/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 17797, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/073e7a2b/uploads/origins/61e5baf2-e99c-4cdd-b8a8-07e227575c63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d8339105d1b13b1f958a00273671447", "srcset": "https://si.imgix.net/073e7a2b/uploads/origins/61e5baf2-e99c-4cdd-b8a8-07e227575c63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d8339105d1b13b1f958a00273671447, https://si.imgix.net/073e7a2b/uploads/origins/61e5baf2-e99c-4cdd-b8a8-07e227575c63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0cbdc3aa52221d239aa3cb69e1098a7 2x, https://si.imgix.net/073e7a2b/uploads/origins/61e5baf2-e99c-4cdd-b8a8-07e227575c63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1a764b3a2cbc82574f4d994f2236c31 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/073e7a2b/uploads/origins/61e5baf2-e99c-4cdd-b8a8-07e227575c63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c760df71c3b39697230cc2a40d1d72f", "srcset": "https://si.imgix.net/073e7a2b/uploads/origins/61e5baf2-e99c-4cdd-b8a8-07e227575c63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c760df71c3b39697230cc2a40d1d72f, https://si.imgix.net/073e7a2b/uploads/origins/61e5baf2-e99c-4cdd-b8a8-07e227575c63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c55dd1e524d573f65ee82794d0518