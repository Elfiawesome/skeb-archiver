bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=204f9d0021cea31a82ff75f512dccc1f, https://si.imgix.net/20a848e4/uploads/origins/4c5a3fc3-ba4f-46d7-8cc7-63145036c840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a5f386708157064db652825c23174c5 2x, https://si.imgix.net/20a848e4/uploads/origins/4c5a3fc3-ba4f-46d7-8cc7-63145036c840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3110010390e113bdd65b040233cbd91b 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20a848e4/uploads/origins/4c5a3fc3-ba4f-46d7-8cc7-63145036c840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5dbe39c1b930b1e0451674cfed365383", "srcset": "https://si.imgix.net/20a848e4/uploads/origins/4c5a3fc3-ba4f-46d7-8cc7-63145036c840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5dbe39c1b930b1e0451674cfed365383, https://si.imgix.net/20a848e4/uploads/origins/4c5a3fc3-ba4f-46d7-8cc7-63145036c840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cfb8400ffeac07b6d95eaa66a70f35d6 2x, https://si.imgix.net/20a848e4/uploads/origins/4c5a3fc3-ba4f-46d7-8cc7-63145036c840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9b2133c81d489793586867702d1b82aa 3x"}, "body": "はじめまして、デュラン×ホークアイの依頼をさせていただきます。\nブラックマーケットでいかがわしいアイテムを買い込んだ2人が宿でお楽しみに耽るという内容で、\n構図は上部がデュランの顔アップ(眼の周りだけで大丈夫です)のカットイン、\n下部がベッドの上で体育座りの姿勢のまま仰向けになり、膝の下に腕をやってお尻を見せつけるように腰を上げているホークアイというものです。\n1枚目：デュランは興奮して目を見開いて凝視。\nホークアイは下半身裸か股間部分を破かれて露出し、使い込まれているのに綺麗にすぼまった穴を見せつけて誘う表情。\n彼の前にはこれを使って弄んでくれとばかりにポトの油や魔法のロープやアナルパール状に数珠つなぎにされたモンスターの瞳が並べられている。\n\n2枚目：ホークアイの尻には繋がれた瞳が突っ込まれ、潤滑液として塗りたくられたポトの油と腸液の混ざり合った液体が溢れてシーツを濡らす。\nデュランは我慢できずこの光景をオカズに自慰行為の最中で、イラスト下部にデュランの男根とそれを扱く手が写る。\nデュランの表情はホークアイの色気に当てられた事が悔しくてならないと目を細めてしかめっ面で、\nホークアイは快楽で頬を染めつつ自慰を始めたデュランの若さをニヤニヤ笑いながら眺めている。\n\n3枚目：デュランの射精後でホークアイに白濁した精液がかけられている。\nアナルパールは引き抜かれたのかいきんで自力で出したのか尻の下に無造作に置かれ、\nぽっかりと広がった孔が物欲しげにひくつく。\n「こっちが誘ってるつもりだったのに、そんなの見せつけられたら我慢できなくなっちゃうよ」とホークアイにねだられ、\nガチガチに勃起するデュランの男根が表示されている。\nデュランの表情カットインは目ではなく口元のアップで、ごくりと唾を飲み込む。\n\nガチエロになってしまいますがお嫌でなければご一考お願いいたします。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@maguro0302/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2775049, "client_id": 1761585, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bb41e94/uploads/origins/fbd5620f-7e02-418c-9919-8260af7b0778?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77132649d5f3815303e42c19849210a9", "srcset": "https://si.imgix.net/3bb41e94/uploads/origins/fbd5620f-7e02-418c-9919-8260af7b0778?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77132649d5f3815303e42c19849210a9, https://si.imgix.net/3bb41e94/uploads/origins/fbd5620f-7e02-418c-9919-8260af7b0778?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e2bf7ca609e0931e9bfbf61ac25fd17 2x, https://si.imgix.net/3bb41e94/uploads/origins/fbd5620f-7e02-418c-9919-8260af7b0778?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ba069bbfccfc73d95ccd947b246606e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bb41e94/uploads/origins/fbd5620f-7e02-418c-9919-8260af7b0778?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b1ea466bc869eb24be31c1ebb0afa4e", "srcset": "https://si.imgix.net/3bb41e94/uploads/origins/fbd5620f-7e02-418c-9919-8260af7b0778?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b1ea466bc869eb24be31c1ebb0afa4e, https://si.imgix.net/3bb41e94/uploads/origins/fbd5620f-7e02-418c-9919-8260af7b0778?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&