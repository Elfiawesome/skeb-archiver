-content-disposition=inline&Expires=1783738802&Signature=DBFRtffNIbMGH9-pgPFW1~geEBLHMDMAJgyZXw1yPZ2iCud95~vp51QTsfCsIgXP-2TuXOwel0UOO29l-q7Lkz7fewd8Ers8maQceQ-hKGnfpI6NUgAp2qYmVP0uoWPVbEgu7Gn6WcyRx2xd1OcgehAB1MXeLmnyggY9tJYzCarN-RZzBBbGNV7mq3KWM8SMzymB~IVcDG~81DkL3mta10qUG3Rgp2wV0FfKkyy3O7YLt8ty3Wo1jhVCmeV8qGVk37FDREaOuifU4aSn0Kg833WYh5DhVutj2bsTpTTiVjBwMNP6T9BQpjW-ywo3z9h8rQ8vXrYFR-ybRXMT2TDgxA__&Key-Pair-Id=K1GS3H53SEO647", "duration": 173, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2016853475561525249%2FXbS48ZOb.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f766132289b159ad7cbdfbaf56b4b72c", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2016853475561525249%2FXbS48ZOb.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f766132289b159ad7cbdfbaf56b4b72c, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2016853475561525249%2FXbS48ZOb.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cdfbe45690c45882042bc2a45e977981 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2016853475561525249%2FXbS48ZOb.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=902818a5c34a32ec278ad87f7a456fae 3x"}, "body": "失礼いたします。\nオリジナルのポエトリーリーディング用の朗読ボイスをお願いしたく思います。\n真綿スピカさんの感情を自由に込めて読んでいただければと思います。\n\n頂いたボイスは、曲をつけてTwitterに投稿する予定です。\n\nなお、ト書きに0:00.000～とありますが、これは曲が始まるタイミングでして、\nこれ以前に数秒の無音部分があるとありがたいです。\n\n曲がなくて伝わりづらいかとは思いますが、何卒よろしくお願いいたします。\n\nーーー以下本文ーーー\n題名「向日葵」\n\n(カッコ内ト書き。BPM115。指定された尺に収めてください)\n\n(音楽1 爽やか　1小節～16小節 0:00.000～0:33.391)\nよく晴れた空の下、大きな黄色い花が咲いている。\n真っ直ぐに天を仰いで、気持ちよさそうに風に吹かれている。\n不意に、花と目が合って、私にお辞儀をしたように感じた。\n私は嬉しくなって、ニコッと笑ってお辞儀を返した。\n\n(音楽2 爽やか+寂しさ、24小節目は曲が静かになる　17小節～24小節  0:33.391～0:50.086)\n心の中にあった、薄曇りの気持ち。\nそんな、ちょっとしたもやもやが、あなたのおかげで晴れた様な気がした。\n\n(音楽1　25小節～40小節　0:50.086～1:23.478)\n日常にある、ちいさなささくれ。何気ないことから生まれる、小さな傷。\nあなたと一緒に風に吹かれていれば、そんな事は忘れられる気がする。\nだから、今はあなたと一緒に、一度足を止めてここで風に吹かれていようと思う。\n\n(音楽2　41小節～48小節　1:23.478～1:40.173)\nああ、私の心は、こんなに疲れていたんだな。\nあなたのその笑顔は、私にそんな気付きをくれた。\n\n(音楽1　49小節～64小節　1:40.173～2:13.565)\n上を向いてみる。とてもよく晴れた空が見える。\n隣を向いてみる。大きな黄色い花が咲いている。\n真っ直ぐに天を仰いで、気持ちよさそうに風に吹かれている。\n不意に、花と目が合って、ニコッと笑ったような気がした。\n私は、ニコッと笑い返して、暫く一緒に風に吹かれていた。", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@spica_mV/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 150288, "client_id": 1327135, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/f81c25f9-8942-4a21-8b93-0584d5286c6e?response-content-disposition=inline&Expires=1783738802&Signature=lsVmvpSSJHRnbSbQg3f-eFHOMLD2u-WRVoA0C54SolZwvlaF~O8MFDJGDgj~SW7p3Vd3kFckDnK0JpAR3r-9sbqQpmeFkVxbgIlZuignRCOXCfsfSHXwODIDwhyHzTNuEaNdLt8oe9LEchIkodgU8FYHaCgoVA-dQyyzxk0CWZbdQaku32IK8IEe84Q672rrjs99iV7h7NvOZ7g2R04p58zq9s~GOwpZbtAh2dw4JAAwxiMfoNcuitPVEQH7p8r0YP-FrgEirCfFyJfNjuej3xCr~Cb4KBaJYIQypEKMigWPEU1qYVbwYM3jCnnzAxSu01ezt5XAooxjIUw-8aWKTA__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2016853475561525249%2FXbS48ZOb.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=497c00b35dccbb540270d2ca7a2fca17", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2016853475561525249%2FXbS48ZOb.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=497c00b35dccbb540270d2ca7a2fca17, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2016853475561525249%2FXbS48ZOb.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00d50c70befb74c1ce4ddf759e61ffa4 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2