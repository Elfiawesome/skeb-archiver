5, "client_id": 329437, "nc": 162}, {"path": "/@omahsihs/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 416355, "client_id": 47436, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/694f2fb3/uploads/origins/6b07140c-f1aa-42c2-a0e5-557d1d5575d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1236bfd553e555688ee777a2a52cfc4d", "srcset": "https://si.imgix.net/694f2fb3/uploads/origins/6b07140c-f1aa-42c2-a0e5-557d1d5575d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1236bfd553e555688ee777a2a52cfc4d, https://si.imgix.net/694f2fb3/uploads/origins/6b07140c-f1aa-42c2-a0e5-557d1d5575d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a85ce18513d4c0fe432eff479d28234 2x, https://si.imgix.net/694f2fb3/uploads/origins/6b07140c-f1aa-42c2-a0e5-557d1d5575d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=665e1f3d19486d68574033e31b2e98c5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/694f2fb3/uploads/origins/6b07140c-f1aa-42c2-a0e5-557d1d5575d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e2155f7e2b4bedc8d7f7798d41f8211", "srcset": "https://si.imgix.net/694f2fb3/uploads/origins/6b07140c-f1aa-42c2-a0e5-557d1d5575d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e2155f7e2b4bedc8d7f7798d41f8211, https://si.imgix.net/694f2fb3/uploads/origins/6b07140c-f1aa-42c2-a0e5-557d1d5575d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=092300abc3de47450bc83b467f678c1a 2x, https://si.imgix.net/694f2fb3/uploads/origins/6b07140c-f1aa-42c2-a0e5-557d1d5575d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=671560ea2659c5b5f50c88ca8d755661 3x"}, "body": "いつも楽しく色んな絵見させてもらってます、スケブ始めたと知り大興奮でやってまいりました！\nししゃもさんの描くパイズリ絵大好きなのでリクエストさせてください！\n\n「キャラ」\n\n・エウロペ (グランブルーファンタジー)\n ⚪参考URL\nhttps://img.gamewith.jp/img/58ad889f68bdc429cae458ae20614141.jpg\n\n 「プレイ内容」\n\n・発情したエウロペが激しくパイズリで搾精、それに耐えられず顔に飛ぶくらい勢いのある射精で顔もおっぱいもドロドロにされる。\n\n・出された精子に興奮したエウロペがザーメン懇願し連続で射精させる。\n\n・最後にドロドロにされた胸の間のザーメンブリッジと腋を見せつけ小悪魔的な表情。\n⚪参考URL\nhttps://www.pixiv.net/artworks/97052522\n(ししゃもさんの作品です、ズリ事後のこの表情と腋見せ大好きです)\n\n\n「詳しいシチュや雰囲気」 \n\n・胸は露出し、乳首が見える状態\n\n・射精差分見てみたいです (ドロドロになった姿とザーメンブリッジか見たいです) \n\n・団長さんが大好きで発情、興奮した様子で積極的に行為を楽しんでる感じ\n\n・ししゃもさんの描くこちらを弄ぶような表情や、とろけたかわいい表情、舌ペロした小悪魔的な表情が大好きなので色々見てみたいです\n\n ・セリフと擬音アリで、下品でえっちなセリフ言わせて欲しいです\n\n・ししゃもさんの描いていたペコリーヌのこちらの反応を楽しむような上目遣いの視線が大好きなので、似たような視線を描いてくださると凄く嬉しいです。\n ⚪参考URL\nhttps://www.pixiv.net/artworks/96220948\n(ししゃもさんの作品です)\n\n\n⚫長文で描いてしまい申し訳ありません。 \n最近はあまりグラブル絵描いているのを見かけず、ししゃもさんの絵柄で前からエウロペを見てみたくリクエストさせていただきました。\n説明不足な点やわかりにくい点は、アレンジやししゃもさんの描きやすいように描いていただいてかまいませんので是非依頼を受けて頂けたらと思います。\n よろしくお願い致します。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 332268, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "島どうま", "screen_name": "ikura_momen", "avatar_url": "https://pbs.twimg.com/profile_images/1612661248679882752/udPZ30ax.jpg", "header_url": "https://pbs.twimg.com/profile_banners/982504366333554689/1601607243/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 65, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 32}, {"id": 550164, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "しんき🍼", "screen_name": "shinshin_ki", "avatar_url": "https://pbs.twimg.com/profile_images/1940079038095089664/974K26hK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/933364793280360448/1686992868/1500x500", "appeal_receivable": false, "pop