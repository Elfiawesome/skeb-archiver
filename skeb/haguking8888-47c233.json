94cb-884189fd88c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4618ed859013da73e07a7f23a444bb3e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2885c4e4/uploads/origins/77b77e33-8bb5-4fbc-94cb-884189fd88c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09bbccc9895a5a2ee078e50adc89b678", "srcset": "https://si.imgix.net/2885c4e4/uploads/origins/77b77e33-8bb5-4fbc-94cb-884189fd88c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09bbccc9895a5a2ee078e50adc89b678, https://si.imgix.net/2885c4e4/uploads/origins/77b77e33-8bb5-4fbc-94cb-884189fd88c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=afa30f05f3e8fcae6b33bcb255581fc3 2x, https://si.imgix.net/2885c4e4/uploads/origins/77b77e33-8bb5-4fbc-94cb-884189fd88c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=308f6edcd29f3dd1dae87f6634f9efce 3x"}, "body": "初めまして！先生のヘッダにもあるイラストを見かけた以来すっかり虜になってフォローさせていただいています…！\n\nhttps://twitter.com/haguking8888/status/1654890499260698624\n\n英語で創作小説を書いているものですが、もし良ければその登場人物のヴァスカをリクエストさせていただけないでしょうか。\n\n資料などは最後のほうに置いてあります。ご自由に描いてくださればと思います…！\n欲を言えば水（キャラのモチーフである忘却の水）も描いてくだされば嬉しい限りです。重めな設定ですが、物憂げだけではなく繊細で透明感のある感じでお願いしたいです。\n過去の依頼イラストも資料に含まれておりますので、イメージの手助けになれれば幸いです。\n\n髪型のポイントは右目（画面では←）を髪で隠していて、サイズ控えめの左耳（画面では→）を出しています。長さは膝丈に少し届かないくらい。\n目は切れ長の鋭く涼しくもどこかあどけなさのある目をイメージしています。（目を少し大きめに意識していただければと思います）\n表情筋の動きが少なく不思議な雰囲気を纏う人物です。\n髪は真っ白く、目は透き通った青緑色です。\n\n【人物設定】（軽く読み流しても大丈夫です…！）\nミステリアスな雰囲気を纏う魔術師の青年。自らの研究を経て神秘を体現する存在でもある。\n魔術の代償として常に記憶喪失状態にあって、一日の記憶がそのまま毎日リセットされる体質となっています。\nギリシャ神話ではレテという冥界の川があって、楽園（エリュシオン）にたどり着く前の最後越えなければならないものです。ヴァスカの脳脊髄液は少年時代に自らの研究でレテの”忘却の水”に作り替えられていて、就眠するとその水が魂を洗って再新してリセットするので、常に白紙状態のような魂を保つ。客観的な知識こそ失われないが、個人としての記憶はまっさらに戻ります。\n\n目が覚める時には、あらかじめ一定数の情報を元に再構築されています。過程や結果的にはパソコンやスマホをファクトリーリセット（工場出荷状態に戻す）のようなものです。初期設定や稼働には必要なものこそ残っていても、個人で保存したデータなどは全部飛んでいる感じです。\n---\n\n納品形式はPSDだと嬉しいです。長々と失礼いたしました。お手すきの際にご検討のほどよろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1W6AayaslgsZhFXH24tRQTW1-BaAtAhE7?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haguking8888/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2783495, "client_id": 1323432, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96f20aa5/uploads/origins/5c92dda1-63da-453b-8de7-cf8fc3753cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5288470e93b3451ef289c167599eacd", "srcset": "https://si.imgix.net/96f20aa5/uploads/origins/5c92dda1-63da-453b-8de7-cf8fc3753cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5288470e93b3451ef289c167599eacd, https://si.imgix.net/96f20aa5/uploads/origins/5c92dda1-63da-453b-8de7-cf8fc3753cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=490189e887b10eb74c33224b86d3bfbd 2x, https://si.imgix.net/96f20aa5/uploads/origins/5c92dda1-63da-453b-8de7-cf8fc3753cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13aee65a96eefd30f39487abff4d9200 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96f20aa5/uploads/origins/5c92dda1-63da-453b-8de7-cf8fc3753cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97a7b53e1099d2111a73f1358352bf82", "srcset": "https://si.imgix.net/96f20aa5/uploads/origins/5c92dda1-63da-453b-8de7-cf8fc3753cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97a7b53e1099d2111a73f1358352bf82, https://si.imgix.net/96f20aa5/uploads/origins/5c92dda1-63da-453b-8de7-cf8fc3753cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=648e731b221d500457318c55907554e6 2x, https: