e1b-885d-19e2e21851ee?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=545e9032bd3091dc39c081d32782ed52, https://si.imgix.net/456b130d/uploads/outputs/3ebe1365-4c66-4e1b-885d-19e2e21851ee?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=943f19ed74512aec5d89a2ed6f60e98a 2x, https://si.imgix.net/456b130d/uploads/outputs/3ebe1365-4c66-4e1b-885d-19e2e21851ee?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=a03bcdcf537ac6e2b3384dae2eab5fb9 3x"}, "duration": 28, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/456b130d/uploads/outputs/3ebe1365-4c66-4e1b-885d-19e2e21851ee?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=6777487ef252b3531d4fe08e5458666c", "srcset": "https://si.imgix.net/456b130d/uploads/outputs/3ebe1365-4c66-4e1b-885d-19e2e21851ee?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=6777487ef252b3531d4fe08e5458666c, https://si.imgix.net/456b130d/uploads/outputs/3ebe1365-4c66-4e1b-885d-19e2e21851ee?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=73a5d68013a142bf7eeb22029b3bd892 2x, https://si.imgix.net/456b130d/uploads/outputs/3ebe1365-4c66-4e1b-885d-19e2e21851ee?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5971dd3a3856c74962c3dd3493b6ac65 3x"}, "body": "先生、こんにちは。\n先生のアニメーション作品がとても大好きで、ぜひ私のOCを描いていただきたくご依頼いたしました💜🤲🏻\n\n—————————\n\n簡単に彼女の背景をご紹介させていただきます。\n\n彼女の名前はViola、17歳、身長164cmです。\nかつてはとても長い髪をしており、貴族の家の令嬢でしたが、天才の兄がいたため、一度も正当に評価されることはありませんでした。\n\n13歳の頃、両親は邪教に洗脳され、狂気に陥ってしまいます。気づいた時にはすでに手遅れで、両親はViolaを道連れに怪物に殺されることを選びました。\n\n最終的に父は彼女の目の前で命を落とし、母はViolaを守るため、彼女の腕の中で亡くなりました。\nその出来事により、Violaの右腕と手の甲には大きな傷跡が残り、それ以降「血」🩸に対して強いトラウマを抱えるようになります。\n\nその後、彼女は教会に対して復讐を行いました。\n教祖が全く悔いる様子もなく布教を続ける姿を目にし、激しい怒りに駆られて教祖を殺してしまいます。\n我に返った時、彼女の手は血に染まり、教祖の身体は無残に壊れていました。\nその瞬間、強い吐き気に襲われ、嘔吐してしまいます。\nそれ以降、血を見たり匂いを感じたりすると激しく嘔吐するようになりました。🤮\n\nその後、彼女は家を離れます。\n右腕の長い袖は傷跡を隠すためのものであり、左手首に付けている髪ゴムは幼い頃に母から贈られた大切なものです。\nその髪ゴムはピンク色の環状の刃に変形し、教祖を殺した際にも使用された武器でもあります。\n彼女は常にそれを身につけており、非常に重要な象徴となっています。\n\n以上が、彼女が血を嫌う理由です。\nBGMとして【Loveit?】の雰囲気をイメージしております🤲🏻\n\n—————————\n\n登場させていただきたいキャラクターは\nViola（💜）と、もう一人の赤い彼女（❤️・2P）の二人です。\n\nViola💜は落ち着いていて大人びた性格で、常に上品な微笑みを浮かべ、優しく丁寧に話しますが、どこか距離を感じさせます。\n感情は豊かであるにも関わらず、本心を隠してしまうタイプです。\n外から見ると頼もしく強く自信があるように見えますが、内面は繊細で優しく、少し自信のない一面もあります。\n\n一方、2Pの彼女❤️はその正反対の存在です。\nどこか不気味さを感じさせる笑みを浮かべ、言葉には棘がありますが、人を惹きつける魅力も持っています。\n\n2P❤️がViola💜に自ら近づき、耳元で囁いたり、距離が近すぎる身体的接触をしたりすることで、\nViola💜の冷静な仮面が崩れ、恐怖や不安の表情が露わになるような描写を希望しています。\n\n全体の雰囲気としては\n・血液\n・不快感\n・めまい、嘔吐\n・過度に近い距離感（曖昧で危うい親密さ）\nを重視していただけると嬉しいです。\n\n2P❤️が1P💜を精神的に追い詰め、崩壊させるような構図を見てみたいです。\n（2Pは感情を一切隠さず、歪んだ内面を持つ存在であり、同時にViola💜の最も本質的で“本当の姿”でもありますが、Viola💜自身はそれを受け入れたくない存在です。）\n\n—————————\n\nここまでお読みいただき、ありがとうございました。\n上記の内容はあくまで参考としていただき、すべて採用していただかなくても大丈夫です🙏基本的には先生のご自由な解釈にお任せいたします！！\n\nもし金額が不足している場合はお手数ですが一度リクエストをお返しいただければ、再度調整してお送りいたします。\n本リクエストをご検討いただけましたら幸いです。どうぞよろしくお願いいたします🥹🙏\n\nhttps://drive.google.com/drive/folders/1NFFwTKjI2ivMfoLyh9bwGl6OpTEpw4pa", "nc": 25, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@fffkace/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 3578914, "client_id": 2684551, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8306145/uploads/outputs/56055904-fcdf-4019-82c2-ed490ff2f33f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=253be39d1eca56b94642bfcce82d3615", "srcset": "https://si.imgix.net/b8306145/uploads/outputs/56055904-fcdf-4019-82c2-ed490ff2f33f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=253be39d1eca56b94642bfcce82d3615, https://si.imgix.net/b8306145/uploads/outputs/56055904-fcdf-4019-82c2-ed490ff2f33f?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=34e840548fed3c88aea00aeb0f50e81c 2x, https://si.imgix.net/b8306145/uploads/outputs/56055904-fcdf-4019-82c2-ed490ff2f33f?bg