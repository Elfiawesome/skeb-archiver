rop&crop=top&w=200&h=200&blur=200&s=85553176bc91087b227e8071e4ddbad9", "src_set": ""}, "body": "こんにちわ。前回はありがとうございました\n今回ですが以前のような雑魚モンスター化のデザインをお願いしたいです\n\n・前回と同じキャラクターを基にして欲しいです\nhttps://twitter.com/wa41245/status/1363891276483993604\n三面図\nhttps://pbs.twimg.com/media/ElWJvQtU8AMmMZX?format=jpg&name=4096x4096\nキャラの服装についてですが帽子とグローブの色は焦げ茶色です\n\n・モフモフ系にせずぷにぷにした感じのデザインにして欲しいです\n\n・吸血鬼の使い魔、手下をイメージしたような雑魚モンスターのような感じでデザインをお願いしたいです\n\n・髪と目は残した感じにしてほしいです\nまた、目は以前のモンスター化のような感じの目にして欲しいです\nhttps://skeb.jp/@yumemikitune/works/2\n\n・シチュエーション等はおまかせします\n\n・使用用途ですが他の人に依頼する際の参考画像としても使用したいです\n\n以上です\n\nそれともう一つお願いがありまして\nもしよろしければ前回(https://skeb.jp/@yumemikitune/works/11)の魔女ガエル化の部分ですが目の描写を以前のモンスター化のような感じの目にした差分も欲しいです", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumemikitune/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f69e8436/uploads/origins/807b5e0f-5dc3-4fa1-81a4-19debe37a62a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eedda4cb0b89bc9b33f490c50c360e71", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 777649, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yumemikitune/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 777649, "client_id": 90411, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a956dcb/uploads/origins/b950e03b-2f3e-4d18-b322-fb94c1fe9187?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=159d64ddb045bb89d505d7915d69d9ae", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a956dcb/uploads/origins/b950e03b-2f3e-4d18-b322-fb94c1fe9187?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ca59920462307151afb51920406879e", "src_set": ""}, "body": "すみません、承認期限が切れた依頼を再送したいです\n\n人外化のイラストお願いしたいです\n\n・基になるキャラクターは下記のリンクの女の子です\nhttps://pbs.twimg.com/media/ElWJvQtU8AMmMZX?format=jpg&name=4096x4096\n\n・「魔女ガエル」化をお願いしたいです。下記のリンクの参考画像を基に以下のようにして欲しいです\nhttps://drive.google.com/file/d/14jrsrZxs2Hzt4whe_PiOQ2Z9_DRAfrUV/view?usp=share_link\n目を普通の目にして欲しいです(口はそのままでお願いします)\n髪を描画して欲しいです\n身体の色は前回のモンスター化の身体の色にして欲しいです\nhttps://skeb.jp/@yumemikitune/works/2\n\nそれともしよろしければスラグ化もお願いしたいです\nhttps://www.pixiv.net/artworks/66821589\n\n・使用用途ですが他の人に依頼する際の参考画像としても使用したいです\n\n以上です", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumemikitune/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 777649, "client_id": 128546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ab70e5c/uploads/origins/eac326e3-1224-4296-ab6a-3e93ec7dad1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a00e92ff91f73e15c6435d2eba39fffe", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ab70e5c/uploads/origins/eac326e3-1224-4296-ab6a-3e93ec7dad1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0c767bfa9ca9482a5838dbd8e805b53", "src_set": ""}, "body": "森の十字路的な場所で、右側から歩いて来るマホイップと、左側から勢いよく走ってくるデカヌチャン\n→角で衝突\n→衝突した拍子にマホイップとデカヌチャンが融合してしまう。融合体の姿としては、\n・全体の配色はデカヌチャン、そこにマホイップの様に筋状の差し色が入っている(頭部・胴体・下半身のショッキングピンクの部位は白とピンクが反転しているイメージ)\n・頭髪(?)は上半分がマホイップ、下半分がデカヌチャン。頭頂部のクリームの左側からはデカヌチャンのアホ毛(?)の左半分が突き出ており、前髪(?)は右半分がマホイップ、左半分がデカヌチャン\n・目は片目がマホイップの赤、片目がデカヌチャンの黒のオッドアイ\n・腕はデカヌチャンのゴツイ腕\n・胴体・下半身はマホイップの脚が無い物。腰の辺りにデカヌチャンの葉(?)\n・得物のハンマーは三段重ねのデコレーションケーキの様な形状になっている\nという様な感じ。融合体は驚きとまどっている\n→森の道を癒着した下半身でぴょんぴょん飛び跳ねて進む融合体。不服そうな表情で、得物のハンマーを引きずっている。また、後方には点々とクリームの跡が残っている\n\nhttps://twitter.com/sedaoseda/status/1611482744663736320", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumemikitune/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 777649, "client_id": 337763, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c84ec28/uploads/origins/cf42d643-2781-4454-a7b6-cee74d054851?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f50f60adb55766d77d84e5c7437cdf69", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c84ec28/uploads/origins/cf42d643-2781-4454-a7b6-cee74d054851?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4012e9853f707d66d4c8c7bb4c92f67f", "src_set": ""}, "body": "こんにちは。今回も私のバニーガールを描いて頂きたいのです。\nFFXIVのロポリットって知ってますよね？\n私のキャラクターを強制的に仲間にしてほしいです。何しろ、人間の安全を守るためですからね～。あるいは、すでにロポリットと間違えられていて、他のロポリットと同じ姿になるよう「矯正」されるとか？体が勝手に動き出す。\n\nhttps://imgur.com/a/69dvblL", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumemikitune/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 777649, "client_id": 203165, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1225e22a/uploads/origins/ce23bcc1-6498-4e8d-98ba-b10f6b56fa71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=141dad0a342878d874d37843e0c6510d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1225e22a/uploads/origins/ce23bcc1-6498-4e8d-98ba-b10f6b56fa71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=747723f45b02051ca470406404e14574", "src_set": ""}, "body": "ゆめみのタマゴさん、はじめまして！\nいつも可愛い変化イラスト拝見させて頂いております。\n是非リクエストさせて頂ければと思いやってまいりました…！！\n\n資料にある私の代理キャラクターが、遊戯王のカードにされてモンスターとして召喚されてしまい、相手魔法カードの「お菓子の家」の効果対象にされてしまい、お菓子を無理やり沢山食べさせられて膨腹、太らされて破壊されてしまう寸前になっている様子をお願いできますでしょうか…！\n\n(キャラクターの頭身は、多少調整して頂いても構いません♪)\n・デュエリストとして人間状態から、資料のケモノへと変化させられてカード化されてしまう(資料の代理ケモノの人間バージョンのようなイメージで、似せて描いてもらえたらと思います！)\n\n・人間→ケモノ→カードへと変化させられた後に強制的に召喚させられて、お菓子の家の効果の対象にされてしまう。\n\n・お菓子の家の効果で、お菓子を無理やり食べさせられて太らされ、お腹が風船のようにパンパンに膨らみ切ってしまい攻撃力が2400となって、破裂(破壊)寸前になる。\n\n・そのまま膨らんだ状態で、今後お菓子の家の効果を発動せずに、相手のコレクションカード(モンスター)として保管されてしまう。\n\nニッチな内容となりますが、もし宜しければお受け頂けると幸いです！\nお願い致します…！！", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumemikitune/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 777649, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3544ab18/uploads/origins/57c3ded8-1e21-4247-8826-fd2766591827?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52b1a67e0c97860d8b2bb328b4c2d05c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3544ab18/uploads/origins/57c3ded8-1e21-4247-8826-fd2766591827?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=626b2681347623010b444410e5cb7666", "src_set": ""}, "body": "闇のカードコレクターTFシリーズで、モンスターやプレイヤーが何らかのカードの効果で『ドローバ』や『ドロドロゴン』などのドロドロしたモンスターに変えられてしまうものをお願いしたいです。\n追加要素やアレンジや細かなシチュ変更などはご自由になさられて一向に構いません。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumemikitune/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 777649, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/00129657/uploads/origins/e6e4c087-5068-489e-bb5c-cde275b39e17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bfaecce03b4281ce8c147e43f046af1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00129657/uploads/origins/e6e4c087-5068-489e-bb5c-cde275b39e17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2dcdc91858ad9dde811200193d58d00c", "src_set": ""}, "body": "いつもお世話になっております…！\n\n手数料無料期間でしたので、もしよろしければと思い依頼させていただきました…！\nジャンルとしてはTFになります。\n\n内容といたしましてはうちの子が、ゲームSOUND VOLTEXに登場する「雪翔くん」に変化させられるイラストをお願いしたく思います。\nうちの子資料/雪翔くんの資料は以下に添付致しましたので、確認をよろしくお願いいたします。\n\nシチュエーションはゆめみさんの描きやすいシチュエーションで構いません…っ\nよろしくお願いいたします…！\n\n【うちの子資料】\nhttps://www.dropbox.com/s/hancz17vum0gnan/279201-1.output.png?dl=0\n\n\n【雪翔くん資料】\nhttps://www.dropbox.com/s/0cpkoqxvopelqn1/%E9%9B%AA%E7%BF%94%E3%81%8F%E3%82%931.png?dl=0\nhttps://www.dropbox.com/s/u7i61iy8zshetzc/HP-1_EXH.png?dl=0\nhttps://www.dropbox.com/s/v9r6zdj2kwmx9si/SUPER_BUBBLE_JOURNEY.png?dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 265288, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "メカエナ", "screen_name": "MECHA_NRG_MAN", "avatar_url": "https://pbs.twimg.com/profile_images/1473148460568576004/jpi5jFF-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3523172952/1593795949/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 160}, {"id": 545475, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "かL(おなか)", "screen_name": "Onaka_L", "avatar_url": "https://pbs.twimg.com/profile_images/1625894832232370177/qpOCwfkX.jpg", "header_url": "https://pbs.twimg.com/profile_banners/984980499754987520/1730192819/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": n