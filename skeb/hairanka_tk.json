s/origins/9fa82b7a-9585-4f7e-b4e7-50f05b590b22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dac2f063036c1deb486cd33d8a97047a", "src_set": ""}, "body": "はじめまして、ころもやぎと申します。\n\n私のオリジナル特撮ヒーロー小説に登場する「瑠璃乃蒼空(るりのそら)」君(変身前の姿)を描いて頂きたいです。\n\n↓資料URLはこちらになります↓\nhttps://drive.google.com/drive/folders/1EraAfRaoKE-j9D5OPTmNyBM8HzP4Z7BP?usp=drive_link\n\nポーズやサイズはおまかせします。良ければわんぱく少年なイメージで描いて頂けると嬉しいです。宜しくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hairanka_tk/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3567830, "client_id": 2215166, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87ad8a58/uploads/origins/65bbb236-ea70-491d-813c-b0a088302d90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d039187242ee4c36ad3f0b9f408f014b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87ad8a58/uploads/origins/65bbb236-ea70-491d-813c-b0a088302d90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=588953f139961e4537e9e3dc2b32da73", "src_set": ""}, "body": "のさくさん、こんにちは！\n\nもしよければ以前企画でお世話になりました鳴海兄弟を描いていただけないでしょうか？\n資料 ( https://tegaki.com/286404/20303607.html )\nきちんとした資料がなくて申し訳ありません………！\n服装や見た目などアレンジしていただいて問題ありません！\nご自由に描いていただければと思います！\n\n何卒ご検討いただけると幸いです……！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hairanka_tk/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3567830, "client_id": 3058445, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a7fb069/uploads/origins/5ac1cca2-89ee-4cac-a5d2-9187efdc3563?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98668bdd73b2c1eafd3cdc65a07c2cce", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a7fb069/uploads/origins/5ac1cca2-89ee-4cac-a5d2-9187efdc3563?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e2037893505bc98dd5c0781c67f51a9", "src_set": ""}, "body": "はじめまして。skeb募集のノートを拝見し、素敵な作品に惹かれて依頼させていただきました。\nオリジナルキャラクター二人のイラストをお願いしたいです。\n資料はこちらにまとめています。\nhttps://nijimiss.moe/@dAnce_p0lka/pages/1741951427393\nhttps://nijimiss.moe/@dAnce_p0lka/pages/1747909649161\n\n衣装はアレンジや変更をしていただいて構いません。\nポーズもお任せいたしますが、二人が仲良さげに見える雰囲気だと嬉しいです。\nよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hairanka_tk/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3567830, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb7927a9/uploads/origins/6a8bdab0-3645-4fe1-b093-3829ef2556ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf540e960da2888a46ad3da0e6caa742", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb7927a9/uploads/origins/6a8bdab0-3645-4fe1-b093-3829ef2556ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3494d0857090637495caf08f92e91dd2", "src_set": ""}, "body": "はじめまして！のさくさんの描かれるイラスト、創作されるキャラクターをいつも楽しく拝見させていただいております。\n\n今回は、のさくさんの創作キャラクター橿本栄四郎さんと、さつま芋を擬人化したオリジナルのマスコットキャラクターぽてんしのイラストをお願いしたく、ご連絡差し上げました。\n\n〈依頼内容〉\n【人数】1人、1匹\n【人物】橿本栄四郎さん、ぽてんし\n【詳細】ぽてんしはさつま芋に手足と翼が生えた生き物です。さつま芋に手足と翼が生えていたらぽてんしなので、細部の造形はお任せいたします。\n【構図】指定はありません。\n\n世界観ぶち壊しリクエストなので難しい場合はキャンセルしてくださって大丈夫です。\n\n以上、よろしくお願いいたします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hairanka_tk/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3567830, "client_id": 3721771, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0157b5c4/uploads/origins/88e41a58-ba5a-4dd6-9574-11e3e06bef05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=887070389909621253dbc3c086dc5d3d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0157b5c4/uploads/origins/88e41a58-ba5a-4dd6-9574-11e3e06bef05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b2fc001d17ac56dff5c36f4f10731d5", "src_set": ""}, "body": "お世話になっております、クマァです。\n少しばかりですが支援しに来ました！病院に行ってください。\n\n＜依頼内容＞\n【人数】2人\n【人物】イタリア人少女お嬢様とその世話役のおじさん（両方マフィアです）\n【詳細】マイペースでわがまま、常に自信満々で美少女なお嬢様と、基本的には慇懃無礼な敬語で舐めた口をきいている自称色男で女好き（子供には興味なし）の従者の2人。どちらも思慮深いが、お嬢様はすぐ怒り、世話役は頭が回るが故にすぐ思考放棄してる。でもどちらも互いに大事に思っているので、なんだかんだ仲の良い2人です。ちなみにギャグ世界の人たちです。\n【構図】指定はありませんが、この2人がわちゃわちゃ賑やか楽しそうな構図だと嬉しいです。\n元の作画はぽてさんが担当しています。ご本人には資料借りる旨許可いただいております。\nhttps://drive.google.com/file/d/12E5zGKB4thjkRHG8KLHYRSXbLtT1R9E1/view?usp=drive_link\n\nよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hairanka_tk/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3567830, "client_id": 1225830, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94fe2c05/uploads/origins/908b7aa1-f847-472b-a8e6-b65fc57cd1ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=212add294da1cb46c1bfb8cffb6eb29b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94fe2c05/uploads/origins/908b7aa1-f847-472b-a8e6-b65fc57cd1ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bd48b970efd950639514ae9a4bc783c", "src_set": ""}, "body": "🥨のさくさん作画の勘タロ君が見たいです。クソザコ感溢れる勘タロ君をお願いします！！\n色ラフ→https://fedibird.com/web/statuses/115016120870524578", "nc