rop=top&w=200&h=200&blur=200&s=c2a3722a3fed058169374edda8eafc42, https://si.imgix.net/76937af4/uploads/origins/3d5148d8-1c85-47a9-b441-f387f89798f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=88e44c27e59e821fbbb15c0ad49f63a5 2x, https://si.imgix.net/76937af4/uploads/origins/3d5148d8-1c85-47a9-b441-f387f89798f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=803372668c01d0e42d12143a4cc8f301 3x"}, "body": "はじめまして。個人Vtuber活動をしているむのーちゃん。と申します。\nイラストが素敵で一目惚れしました。ぜひ私のOCを描いて頂きたくリクエストさせていただきました。\n\nSNS投稿、動画のサムネイルに使用させて頂きたいと考えており、可能でしたら背景透過画像を追加していただけますと幸いです。\n\n夏らしい青空に陰った(雲の影に入った)場所にキャラクターを描いてほしいです。キャラは空を見上げているイメージです。その他お任せできると嬉しいです。\n資料はリンク先Xの固定画像になります。(見えないところは想像で描いて頂いても大丈夫です)\n以上、可能な範囲で無理なくよろしくお願いいたします。\n\n簡単なプロフィール\nむのーちゃんは宇宙から来た猫耳天使型生物。インターネットガール。\n青いドーナツ、ホラーゲームが大好き。無邪気に笑ったり、のんびりぼーっとしている。エプロンの下はスク水です。相棒は白いねこ。\n\nhttps://x.com/muno_channel", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sana_kasa/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3673992, "client_id": 2626686, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34260140/uploads/origins/1b496ff6-da9b-4552-8079-3d107fc495a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4047698c9ea858827f8fa129b7173025", "srcset": "https://si.imgix.net/34260140/uploads/origins/1b496ff6-da9b-4552-8079-3d107fc495a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4047698c9ea858827f8fa129b7173025, https://si.imgix.net/34260140/uploads/origins/1b496ff6-da9b-4552-8079-3d107fc495a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a301fb2112b896eca138cb2119a1f47 2x, https://si.imgix.net/34260140/uploads/origins/1b496ff6-da9b-4552-8079-3d107fc495a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dfed50a