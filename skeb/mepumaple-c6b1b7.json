t=8AulRRNZDjNDFxnRLaGAgQ\n②和＋秋のイメージとして下記の方のテイストが素敵だと思いました。\nhttps://sozaino.site/archives/8249\n③円形でデザインが整っていると感じたイメージを載せます。（アイマスのポジティブパションのロゴです）\nhttps://www.google.com/url?sa=i&url=https%3A%2F%2Fwww.suruga-ya.jp%2Fkaitori_detail%2F871620810&psig=AOvVaw0gIuLZBLO3RoOVahJohK53&ust=1653936402454000&source=images&cd=vfe&ved=0CAwQjRxqFwoTCIiLraevhfgCFQAAAAAdAAAAABAI\n\n私自身の文字数の少なさはありますが、円形、和風、秋っぽさで賑やかにして頂けると嬉しいです。\n\n・その他\n今年の1月より1周年をすぎて、「よりVTuberらしく活動したい！」という事もあり、新衣装を仕立てました。\n新衣装に伴い、新しくロゴも新調できたら嬉しいなと思っています。\n描いて頂けるだけでも嬉しく思いますので、よろしくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@huku__inchoo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1881191, "client_id": 1992795, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f5c131c/uploads/origins/8b7331d5-76d2-4dea-b2d4-32db0e869704?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=298c878db3d81424450d3b2a9fe2a349", "srcset": "https://si.imgix.net/5f5c131c/uploads/origins/8b7331d5-76d2-4dea-b2d4-32db0e869704?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=298c878db3d81424450d3b2a9fe2a349, https://si.imgix.net/5f5c131c/uploads/origins/8b7331d5-76d2-4dea-b2d4-32db0e869704?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b073a47f496cf96a18d8a6eb0fb3b21e 2x, https://si.imgix.net/5f5c131c/uploads/origins/8b7331d5-76d2-4dea-b2d4-32db0e869704?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d573a1a4ad3221f97f1b1c234f9f2f82 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5f5c131c/uploads/origins/8b7331d5-76d2-4dea-b2d4-32db0e869704?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4141492ad045eb9cf74001fb0efe8af3", "srcset": "https://si.imgix.net/5f5c131c/uploads/origins/8