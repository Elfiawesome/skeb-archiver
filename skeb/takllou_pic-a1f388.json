。\n【社員証】\nhttps://tshop.r10s.jp/ayjudie/cabinet/product/s51-094/image.jpg?fitin=720%3A720\n・「読谷山さんって仕事はできるけど、ちょっときついよね～」って言われそうな感じのクールな表情にして下さい。\n\n以上、よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takllou_pic/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1636855, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f620d1e7/uploads/origins/5bc04362-a74a-4b46-9f66-0e98d6fdc39f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b238f91c849f1da3aa60b19accbffcb", "srcset": "https://si.imgix.net/f620d1e7/uploads/origins/5bc04362-a74a-4b46-9f66-0e98d6fdc39f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b238f91c849f1da3aa60b19accbffcb, https://si.imgix.net/f620d1e7/uploads/origins/5bc04362-a74a-4b46-9f66-0e98d6fdc39f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5bc2d08c8e5390f6b1bd2112c425b8c 2x, https://si.imgix.net/f620d1e7/uploads/origins/5bc04362-a74a-4b46-9f66-0e98d6fdc39f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7095fe94523313a2207dcb596a28b9a4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f620d1e7/uploads/origins/5bc04362-a74a-4b46-9f66-0e98d6fdc39f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9aabbabfb4e3ca2cfbc706c99e85d6d0", "srcset": "https://si.imgix.net/f620d1e7/uploads/origins/5bc04362-a74a-4b46-9f66-0e98d6fdc39f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9aabbabfb4e3ca2cfbc706c99e85d6d0, https://si.imgix.net/f620d1e7/uploads/origins/5bc04362-a74a-4b46-9f66-0e98d6fdc39f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=86227e842720e55b6badaad0f0ab519d 2x, https://si.imgix.net/f620d1e7/uploads/origi