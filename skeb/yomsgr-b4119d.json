fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9152af8c4eb60fff68047fe73a6f6a5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97dadf0c/uploads/origins/42581a61-777c-4c92-9612-2861e800cdf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72f21837ce5ee1de193b125ee9f1c430", "srcset": "https://si.imgix.net/97dadf0c/uploads/origins/42581a61-777c-4c92-9612-2861e800cdf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72f21837ce5ee1de193b125ee9f1c430, https://si.imgix.net/97dadf0c/uploads/origins/42581a61-777c-4c92-9612-2861e800cdf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cf0fe1b6acc551d3287af453c86f2dcc 2x, https://si.imgix.net/97dadf0c/uploads/origins/42581a61-777c-4c92-9612-2861e800cdf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2308b277da2241ea50862184b2aa4d73 3x"}, "body": "うろいち先生の描く肉感が好きです。\nラニの幾何学模様の火傷のデザインをしていただけませんか。\n前、後、両腕、足にも少しかかっていると嬉しいです。\n難しければ、ちゃんナルとのカプ絵でもかまいません。\n\nラニの髪はプラチナブロンドのプリズムカラーに好きに色を入れて\n目は虹色でも、赤でも、青でも自由にカラコンをつけさせてください。\nナルの髪は赤褐色で、目の色はサファイアブルーです。\n\nご検討のほど、何卒よろしくお願いします。\n\n資料\nhttps://x.com/urikota14/status/1966931737520582793/photo/1\n\nhttps://x.com/urikota14/status/1952316614365569506/photo/1", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomsgr/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 17636, "client_id": 1233617, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1476e866/uploads/origins/a843b0f5-d595-4c5d-997a-b6908bc86a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c78703df1546f901cc13c602a13500b3", "srcset": "https://si.imgix.net/1476e866/uploads/origins/a843b0f5-d595-4c5d-997a-b6908bc86a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c78703df1546f901cc13c602a13500b3, https://si.imgix.net/1476e866/uploads/origins/a843b0f5-d595-4c5d-997a-b6908bc86a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd7793fa6e9b2f17dd829db093b315c6 2x, https://si.imgix.net/1476e866/uploads/origins/a843b0f5-d595-4c5d-997a-b6908bc86a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2df5008932242afbe541cb27b20fdb04 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1476e866/uploads/origins/a843b0f5-d595-4c5d-997a-b6908bc86a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13f0625dcb358e0af321961186dcd0dd", "srcset": "https://si.imgix.net/1476e866/uploads/origins/a843b0f5-d595-4c5d-997a-b6908bc86a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13f0625dcb358e0af321961186dcd0dd, https://si.imgix.net/1476e866/uploads/origins/a843b0f5-d595-4c5d-997a-b6908bc86a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=09ff4efe9916c0b26e0211f148bc90eb 2x, https://si.imgix.net/1476e866/uploads/origins/a843b0f5-d595-4c5d-997a-b6908bc86a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d1ca0b0a52100f1b0db8b43268bd367b 3x"}, "body": "正常ラヂヲ様\n\n初めまして、あかりと申します。\n過去のコミッションを拝見し、この度立ち絵のリクエストを失礼いたします。\n用途としてはTRPGセッション用になります。\n\n【キャラクター詳細】\n性別/年齢/職業→女性/26歳/刑事（警部補）\n髪/目→銀髪で背中中央から腰上の間くらいの長さのストレートロング/橙色でクールな印象のあるツリ目\n性格→“真面目”が服を着て歩いているような頭の固い女性。眉間にしわを寄せる癖がある。自他共に対して厳しいため、部下からは畏怖の念を抱かれている。おばけが苦手だったり大の犬好きだったりと普通の女性らしい面もある。\n備考→左目に泣きぼくろがある。テーマは「ハイヒールが世界一似合う女」なのでハイヒールを履きこなしているイメージだととても嬉しいです。CoCシナリオ「胡桃炸裂症候群-Drosselmeyer Syndrome-　HO刑事」として使用したキャラクターです。\n\n継続使用で遊ぶにあたり、透過ファイルで作成をお願いできますでしょうか。\n不足・問題点などありましたら差し戻していただければと思います。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1nEFXvvAWtyDm-ZW37y1WxXt6RXl5xNuY?usp=sh