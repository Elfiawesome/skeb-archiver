あなたに自分のハムスターキャラクターを描いてもらいたいと興味を示しています。そこで、今回のリクエストとして、彼のハムスターのオリジナルキャラクターを描いていただけないでしょうか。 \n\n前回の依頼と同様、彼のハムスターのキャラクターに最も合うと思うポーズや服装で、自由に描いてください！毛並みの模様も自由に決めていただいて構いませんし、メガネをかける場合は、そのデザインもご自由に決めてください！彼のハムスターも、私の猫キャラクターと同じようにぽっちゃりした体型です。 \n\nNikiciyさん、またリクエストをお引き受けいただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1PiyfSrMnow4l5xIahgsuSt7y8TQQKuwg?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@konnikichan/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4104780, "client_id": 1087342, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5b3dfda/uploads/origins/780c84bd-db81-4ff5-af95-eb8cc1cb5a20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2981b150c93fd5061495885a08bd58ec", "srcset": "https://si.imgix.net/a5b3dfda/uploads/origins/780c84bd-db81-4ff5-af95-eb8cc1cb5a20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2981b150c93fd5061495885a08bd58ec, https://si.imgix.net/a5b3dfda/uploads/origins/780c84bd-db81-4ff5-af95-eb8cc1cb5a20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b17906aed79a44202e1abdd2b82db986 2x, https://si.imgix.net/a5b3dfda/uploads/origins/780c84bd-db81-4ff5-af95-eb8cc1cb5a20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eeb8057e68e94e8dd8891f2722f44936 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5b3dfda/uploads/origins/780c84bd-db81-4ff5-af95-eb8cc1cb5a20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d5d71373e19b54807e831aed77c1928", "srcset": "https://si.imgix.net/a5b3dfda/uploads/origins/780c84bd-db81-4ff5-af95-eb8cc1cb5a20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d5d71373e19b54807e831aed77c1928, https://si.imgix.net/a5