ress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97f9044d07eafe55038420b7491596af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ee3bb16/uploads/origins/12e7888a-0dfd-43c9-8ecc-a65bebf2c8fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1821a05517cf95508aced452447fc8c0", "srcset": "https://si.imgix.net/4ee3bb16/uploads/origins/12e7888a-0dfd-43c9-8ecc-a65bebf2c8fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1821a05517cf95508aced452447fc8c0, https://si.imgix.net/4ee3bb16/uploads/origins/12e7888a-0dfd-43c9-8ecc-a65bebf2c8fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ee216b807b5d7b95dbe02316ecfc7efd 2x, https://si.imgix.net/4ee3bb16/uploads/origins/12e7888a-0dfd-43c9-8ecc-a65bebf2c8fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=88c6fa108ca2100c8b41c1e9e7b296f7 3x"}, "body": "こんにちは！昔からずっとあなたの作品が大好きで、今回、あなたからSKEBをいただけることになって本当に嬉しいです！\n\n私のライオンとオオカミのハイブリッドキャラクター、「望月ヒー（Hy Mochizuki）」を描いていただけると嬉しいです。彼の性格は優しくて思いやりがある反面、時々恥ずかしがり屋でもあります。VOCALOIDが大好きで、いつかアイドルになることを夢見て、歌ったり踊ったりするのが好きです。でも、テクノロジーオタクな一面もあり、古いパソコンを直すのも好きです。 \n\nこのキャラクターには「ゲンのラーメン屋」で食事をしている姿を描いてほしいです。服装は、その場面や表情に合い、彼の性格に合ったもので構いません！また、参考画像よりも少しぽっちゃりした感じに描いてもらえると嬉しいです。\n\n参考リンク：\nhttps://drive.google.com/drive/folders/1dGxQRk0ycxGcd8UtBdKttbghjDmDIxSw?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@konnikichan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4104780, "client_id": 540698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db2feb7d/uploads/origins/eb9cee51-dede-4010-aa94-42adc6ddb6bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dff7e412fbe0f2f1ff1aaa8986b8c917", "srcset": "https://si.imgix