ファイル形式：カラー、png（可能であればpsdも）\n\n■使用用途\n・SNSへの投稿、アイコン・ヘッダー画像としての使用\n・個人利用目的でのグッズ化\n・その他、個人利用目的での使用・共有\n\n初心者故不手際ございましたら申し訳ありません。金額が合わないなどあれば再送いただけると幸いです。\nご検討の程よろしくお願いいたします︎！\n\nhttps://drive.google.com/drive/folders/1UnjcTv4pBHScwB0e-JvvRZRPNfoBUh1Z", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akira_1925/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1911615, "client_id": 661215, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84457e73/uploads/origins/3288b12c-e8d2-4e0d-9554-608a68f8ab0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aac037873342a2d8633e836c6a1de941", "srcset": "https://si.imgix.net/84457e73/uploads/origins/3288b12c-e8d2-4e0d-9554-608a68f8ab0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aac037873342a2d8633e836c6a1de941, https://si.imgix.net/84457e73/uploads/origins/3288b12c-e8d2-4e0d-9554-608a68f8ab0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b621c4928ebde5bd4ec888ec338bb93d 2x, https://si.imgix.net/84457e73/uploads/origins/3288b12c-e8d2-4e0d-9554-608a68f8ab0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f93ab3be068b9d1ea203204c5e5b9e18 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84457e73/uploads/origins/3288b12c-e8d2-4e0d-9554-608a68f8ab0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d132a41de235ddb568b3d4b21fc5eaa6", "srcset": "https://si.imgix.net/84457e73/uploads/origins/3288b12c-e8d2-4e0d-9554-608a68f8ab0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d132a41de235ddb568b3d4b21fc5eaa6, https://si.imgix.net/84457e73/uploads/origins/3288b12c-e8d2-4e0d-9554-608a68f8ab0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&