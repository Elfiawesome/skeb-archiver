るだけ欠かさず行うようにしている。誰かの歩んだ過去を自分の中の知識として今という時間に生かす事を目標にして生きている。\n\n\n▼構図について\n書庫、もしくは本を沢山積んだ静かな空間で本を読んでいる光景が見られると幸いです。\nゴーグルやモノクルは取り外し可能となっておりますので構図含めあきらんぬ様が描きやすいようご自由に変えて頂ければと思います。\n\n\n▼資料リンク\nhttps://drive.google.com/file/d/1HoUMD3YHo_BCqgelBbR0Trlm1dKevy6q/view?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akira_1925/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1911615, "client_id": 2778529, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f437a1b/uploads/origins/c5f3c0cb-0c44-43a6-8af6-b12b03eed185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eab99ce94f6eea26e5203d7bc16d6f8a", "srcset": "https://si.imgix.net/3f437a1b/uploads/origins/c5f3c0cb-0c44-43a6-8af6-b12b03eed185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eab99ce94f6eea26e5203d7bc16d6f8a, https://si.imgix.net/3f437a1b/uploads/origins/c5f3c0cb-0c44-43a6-8af6-b12b03eed185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=012317a7d82616aa22855626c163756d 2x, https://si.imgix.net/3f437a1b/uploads/origins/c5f3c0cb-0c44-43a6-8af6-b12b03eed185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef8801b0c973b3e1eb803eaccb33338f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f437a1b/uploads/origins/c5f3c0cb-0c44-43a6-8af6-b12b03eed185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1ef7fa09e20301a1d1ed3bfd7f3c779", "srcset": "https://si.imgix.net/3f437a1b/uploads/origins/c5f3c0cb-0c44-43a6-8af6-b12b03eed185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1ef7fa09e20301a1d1ed3bfd7f3c779, https://si.imgix.net/3f437a1b/uploads/origins/c5f3c0cb-0c44-43a6-8af6-b12b03eed185?bg=%23fff&auto=format%2Ccompress&fm