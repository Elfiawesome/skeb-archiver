it=crop&crop=top&w=200&h=200&blur=200&s=bdc184f8408314cc8dec4ad9406894cf", "src_set": ""}, "body": "こんにちは、私は小白です私はあなたの絵が好きなので、お手数をおかけしたいのですが私は私の自作のかわいい絵をあげたいです。私のocは白髪のウサギの耳を持つ女の子で、服装は私のURLを参考にすることができて、私のocが虹色の柔らかいが破裂しないシャボン玉の中に完全に包まれているのを見たいです。肢体はシャボン玉と親密に接触して、シャボン玉が体に接触する時のわずかな変形の様子を描くことができるほうがいいです。人物の表情はまず不思議に感じて、それから少し嬉しさを持っています。そしていくつかのキャンディとデザートの要素を追加して、その他のものは適切に自由に発揮することができます。もしあなたが私のニーズを満たすことができたら、私は感謝に堪えません！\n\nhttps://drive.google.com/drive/folders/15svKDsl8NJcw0pfCk26kxNUcsK6oQZ4S?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yachi0_081/works/305", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c1a3f033/uploads/outputs/130e6dae-b002-4018-9418-29ac5545f395?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b39d8a11c75bce0ea6a345df5492efc", "src_set": ""}, "private": true, "genre": "video", "tipped": true, "creator_id": 775050, "client_id": 1280944, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 35, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yachi0_081/works/304", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3bade4c5/uploads/origins/b5870283-35f7-4585-8c46-d3ea0c3f7a39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=370bea09d52762f8859b6e502ea9d595", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 775050, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"pat