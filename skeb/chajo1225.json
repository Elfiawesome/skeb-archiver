ers/1-Jo8GMcVOutSqJBx_dsV22B7KigMg-eJ", "nc": 1, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@chajo1225/works/48", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 706407, "client_id": 2517251, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46414ae1/uploads/origins/1dbc2107-b105-47ce-9edf-bee5d67ce49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16fb259e36bad6d28a4fd849304ed468", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46414ae1/uploads/origins/1dbc2107-b105-47ce-9edf-bee5d67ce49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=825a8f12df8b0e1bfcec4153fb5b49d6", "src_set": ""}, "body": "はじめまして！あざらしVTuberの木乃芽もん太と申します。\n以前からイラストを拝見しており、とてもすてきだなと思っておりました。\n是非ともデフォルメの私を描いて頂けませんでしょうか。\n資料URLに添付してある設定画のどのバージョンでも構いません。\n構図ポーズ等もおまかせでお願い致します。\nちょっとあほっぽい顔だといいなと思っております。\n\n用途\n・収益化済Youtube等への動画サムネイルへの一部使用、SNSでの使用。\n・HP、SNS宣伝活動での挿絵使用。\n・FANBOXで壁紙として配布\n\n人物や背景等レイヤーを分けたファイルでいただけると嬉しいです。\n\nご検討宜しくお願い致します！\n\nhttps://lit.link/montautauta", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chajo1225/works/47", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 706407, "client_id": 3449390, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe405ada/uploads/origins/fa445d42-0cfa-4a9d-a621-570b041d4091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d29158bf77cbb6a6c2d15e8351778e1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe405ada/uploads/origins/fa445d42-0cfa-4a9d-a621-570b041d4091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f626590ec1dc91