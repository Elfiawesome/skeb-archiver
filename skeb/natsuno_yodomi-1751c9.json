れぞれの肌の色にご注目ください。\n\nフォルダ内の「A01」と書かれたファイルにある服をAに、「B01」と書かれたファイルにある服をBに着せて描いてください。これらは彼らの夏の服装です！\n\nAとBは何とも言えない絆で結ばれており、お互いを深く思い合っている。二人は同じアパートで同じベッドを共有している。\n\nできれば、アンダルシアや沖縄で夏休みを過ごす2人を描いてください。\n\nありがとうございました！リクエストにそぐわない場合は、遠慮なく却下してください。\n\nhttps://drive.google.com/drive/folders/16y9NgqLddu6zrXJklqV0DQU31U1to-XS", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@natsuno_yodomi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3219534, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9dced5a7/uploads/origins/831506b6-ee11-4ccf-a0de-9c4a6ad39a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e149bcd98ad00415c31d3e0680fdd351", "srcset": "https://si.imgix.net/9dced5a7/uploads/origins/831506b6-ee11-4ccf-a0de-9c4a6ad39a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e149bcd98ad00415c31d3e0680fdd351, https://si.imgix.net/9dced5a7/uploads/origins/831506b6-ee11-4ccf-a0de-9c4a6ad39a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1a68dd070423c36c00d8aadd621f738 2x, https://si.imgix.net/9dced5a7/uploads/origins/831506b6-ee11-4ccf-a0de-9c4a6ad39a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8bb8f17635329c666c79932bc698c24 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9dced5a7/uploads/origins/831506b6-ee11-4ccf-a0de-9c4a6ad39a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cef7dd4dafc069b4342fa059324bc0f5", "srcset": "https://si.imgix.net/9dced5a7/uploads/origins/831506b6-ee11-4ccf-a0de-9c4a6ad39a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cef7dd4dafc069b4342fa059324bc0f5, https://si.imgix.net/9dced5a7/uploads/origins/831506b6-ee11-4ccf-a0de-9c4a6ad39a8b?bg=%23fff&auto=f