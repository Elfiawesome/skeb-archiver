\n・性格:明るい性格、顔に出やすい、恥ずかしがり屋 \n・小柄(151cm) \n\n【服装】 \nたら様のOCちゃん達の衣装が可愛くてとても大好きなので、可能であれば是非たら様のお好きな様に描いていただけたらと思います！ヘアアレンジも大歓迎です！(髪はおろすと肩ぐらいの長さです)\n\n\n また、金額等に不備がありましたら再送要請をして頂けるとありがたいです。\n\nhttps://drive.google.com/drive/folders/1V25-RLan7JwdrMmybMF4Ahgmr-qapHgG", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@0xbd9n/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3806012, "client_id": 3792138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3546235d/uploads/origins/439a9cc1-4cda-4151-a021-076b1ab31625?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c670559da54f359e1956ed912827e96", "srcset": "https://si.imgix.net/3546235d/uploads/origins/439a9cc1-4cda-4151-a021-076b1ab31625?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c670559da54f359e1956ed912827e96, https://si.imgix.net/3546235d/uploads/origins/439a9cc1-4cda-4151-a021-076b1ab31625?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8fd3cca24893d8bc1c124d282f77c570 2x, https://si.imgix.net/3546235d/uploads/origins/439a9cc1-4cda-4151-a021-076b1ab31625?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b55c21aa0b22f12d83130074a4e5ba52 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3546235d/uploads/origins/439a9cc1-4cda-4151-a021-076b1ab31625?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=815576e616009be36ef5be9d3bb064ad", "srcset": "https://si.imgix.net/3546235d/uploads/origins/439a9cc1-4cda-4151-a021-076b1ab31625?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=815576e616009be36ef5be9d3bb064ad, https://si.imgix.net/3546235d/uploads/origins/439a9cc1-4cda-4151-a021-076b1ab31625?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&