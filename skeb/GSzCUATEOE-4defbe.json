d2db-05a5-4b77-95f1-5cae3ec1f198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c8bf848a6d08921d305584b9f7ccf50", "srcset": "https://si.imgix.net/71d5568e/uploads/origins/b6c8d2db-05a5-4b77-95f1-5cae3ec1f198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c8bf848a6d08921d305584b9f7ccf50, https://si.imgix.net/71d5568e/uploads/origins/b6c8d2db-05a5-4b77-95f1-5cae3ec1f198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=166a620e5f40f348a4961b9a41bf869d 2x, https://si.imgix.net/71d5568e/uploads/origins/b6c8d2db-05a5-4b77-95f1-5cae3ec1f198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c32c6cad11ae2c624d49e202df35e32f 3x"}, "body": "まるぎつね。さん、はじめまして。Vtuberの月夜猟介と申します。\nまるぎつね。さんの描かれるイラストの鮮やかな色使いやタッチがとても好きです！ぜひ自身のイラストを描いていただきたいと思い、リクエストをさせていただきます！\n\n【ご依頼したい内容】\nキャラクター：月夜猟介(参考画像URLを添付いたします)\n衣装・髪型等：参考画像内にある、赤いシャツの衣装＋前髪を分けた髪型でお願いします。\nポーズ・構図・シチュエーション等：\n『腕を胸の前で組んで、得意げなドヤ顔をしている猟介』を描いていただきたいです。腕で雄っぱいが寄って谷間が強調されるような感じになっていると嬉しいです！\n\nサムネイル等に使用したいため、キャラクターの上や左右(髪や腕など)は途切れていないと助かります。\n\nもし予算内で可能でしたら、少し表情差分がいただけると大変嬉しいです(『戸惑う』『照れる』等…内容はおまかせします)。\n\n〇使用用途：Youtube等の配信やそのサムネイルでの使用、ウォーターマークなどの加工をした上でのSNSでの使用などを考えております。そのほか、もし可能であれば個人観賞用に印刷をする許可もいただければ嬉しいです(頒布・販売等は致しません。難しければ結構ですので、psd内などにその旨ご記載いただければ幸いです)。\n\n〇形式など：psd形式でいただけると嬉しいです。キャラクターと、そのほかの背景やサインなどは可能な範囲で別レイヤーに分けていただけると大変助かります。\n\n〇参考画像： Ｘアカウントとgoogle driveを記載いたします。\n①https://x.com/RyosukeTsukiyo\n②https://drive.google.com/drive/folders/19_zo9HFwtI_E9Ew6ID3ziu95biPTWZ9d?usp=sharing\n\nもしもご縁がありましたら、どうぞよろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@GSzCUATEOE/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2722128, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9955189/uploads/origins/55934c4f-686a-49c9-9bac-84f2d3631e1f?bg=%23