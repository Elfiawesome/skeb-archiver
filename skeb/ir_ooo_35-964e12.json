97ebc96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a0d390e7a624ae2973e36338790f5746 3x"}, "body": "いろさん、こんにちは！\n\nご依頼、本当にありがとうございます！！メイのデザインを気に入ってくださって嬉しいです。正直、あなたの可愛い画風で描かれたメイを見てみたいです！\n\nポーズや構図はあなたにお任せしますが、彼女の雰囲気は子供っぽくて遊び心のある感じです。ご検討いただきありがとうございます！ぜひ、あなたが一番楽しめる方法で描いてください！\n\nhttps://drive.google.com/drive/folders/1umaqheYYAgHcP1JhXSveRoQI-UXPgqHL?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ir_ooo_35/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3790452, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ede5eeb7/uploads/origins/3efabfd4-1e33-4b4d-a8ce-3f91b6b64599?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdbdec79f91ad2ef5c0931e8026cca68", "srcset": "https://si.imgix.net/ede5eeb7/uploads/origins/3efabfd4-1e33-4b4d-a8ce-3f91b6b64599?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdbdec79f91ad2ef5c0931e8026cca68, https://si.imgix.net/ede5eeb7/uploads/origins/3efabfd4-1e33-4b4d-a8ce-3f91b6b64599?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5801e6c699e575d12db5659a7b53a511 2x, https://si.imgix.net/ede5eeb7/uploads/origins/3efabfd4-1e33-4b4d-a8ce-3f91b6b64599?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7370acc8909e8cb5ee09695500191bfd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ede5eeb7/uploads/origins/3efabfd4-1e33-4b4d-a8ce-3f91b6b64599?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f0d2a2f6d34c11907387497388294bd", "srcset": "https://si.imgix.net/ede5eeb7/uploads/origins/3efabfd4-1e33-4b4d-a8ce-3f91b6b64599?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f0d2a2f6d34c11907387497388294bd, https://si.imgix.net/ede5eeb7/uploads/origins/3efabfd4-1e33-4b4d-a8ce-3f91b6b64599?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4ed0a7851a55d57af2599b84da9d631c 2x, https://si.imgix.net/ede5eeb7/uploads/origins/3efabfd4-1e33-4b4d-a8ce-3f91b6b64599?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d950b6616df4366d68ab68fb4972d897 3x"}, "body": "いろさま\nアピールありがとうございました！もしよろしければうちよそのふたりを描いていただけたらと思いリクエスト失礼いたします\nいろさまの好きなように描いていただけましたら幸いです♥️\n\n使用用途は個人観賞用になります。(友人間での共有や電子機器の壁紙などに使用させていただきたいです)\n\n資料を添付しておりますのでご参照ください。\n▽金髪のキャラクター\n178cm/28歳\nとある中学校の化学の先生。自分に自信があり、職員室に大きな鏡を設置していたり、自分の顔が良く見えるように特注のゴーグルをつけている。\n▽茶髪のキャラクター\n188cm/30歳\nとある中学校の家庭科の先生。基本的に赤いエプロンをしている。\n大食い。おおらかでマイペースだが、照れ屋なところがある。\n\n▽茶髪のキャラクター×金髪のキャラクターの恋人同士です。\n一見金髪が強気で振り回しているように見えますが、天然でマイペースな茶髪に金髪が翻弄されることもあり、空回りしがちです。スキンシップは茶髪→金髪の方が多めで、茶髪の方が素直に甘えたり触れたりします。\n\nお忙しいところ恐縮ですがご検討ください。\n\nhttps://drive.google.com/drive/folders/1HvcGwZNRYa1uZIkOQPrGXk40CRPA_Mc4?usp=sharing", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ir_ooo_35/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3790452, "client_id": 885660, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d41407cd/uploads/origins/5ec0fda9-21c4-447a-8050-81f63d0bdca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9d5dae66617031220f642ab495d4a0c", "srcset": "https://si.imgix.net/d41407cd/uploads/origins/5ec0fda9-21c4-447a-8050-81f63d0bdca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9d5dae66617031220f642ab495d4a0c, https://si.imgix.net/d41407cd/uploads/origins/5ec0fda9-21c4-447a-8050-81f63d0bdca0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92816cc8212c41dddcc2828147de8dcc 2x, https://si.imgix.net/d41407cd/uploads/origins/5ec0fda9-21c4-447a-8050-81f63d0bdca0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00fd4313b3abddab0ade0fc867b144a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d41407cd/uploads/origins/5ec0fda9-21c4-447a-8050-81f63d0bdca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8a6ca195471154fed558ac5554e35c4", "srcset": "https://si.imgix.net/d41407cd/uploads/origins/5ec0fda9-21c4-447a-8050-81f63d0bdca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8a6ca195471154fed558ac5554e35c4, https://si.imgix.net/d41407cd/uploads/origins/5ec0fda9-21c4-447a-8050-81f63d0bdca0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1a17b4622ae8722cb2c2d2f6d75690b4 2x, https://si.imgix.net/d41407cd/uploads/origins/5ec0fda9-21c4-447a-8050-81f63d0bdca0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a76c38803ba199855bc4e4559ed9ea77 3x"}, "body": "こんにちは！私のオリジナルキャラクター3人を一緒に描いていただけませんか？1人目は、コンビニで働くおとなしくてオタクっぽいブタ娘です。すぐに慌てふためき、外に出るより家で好きなことをしている方がずっと好きです。https://sta.sh/2131l7h9spj7\n\n2人目は奇妙で風変わりなギャル娘。時々不気味で少しベタベタするけど、良い子です。https://sta.sh/22e7rbretdb3人目はギャル風青い鬼。二人にとってクールなお姉さんみたいな存在で、とても気楽で優しい性格です。\nhttps://sta.sh/2lvae0isoad退屈な日常の中で、仕事中の最初のギャルを他の二人が遊びに来てからかう、楽しいシーンを描いてほしい。最初のギャルは制服姿で、他の二人はリファレンスフォルダにあるものかオリジナルデザインで自由に服装を決めてください。よろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ir_ooo_35/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3790452, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0fe0146a/uploads/origins/e9fc427a-8d03-4ccf-9975-eaa701a805ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e0224dedb4fcbea8ff776567089eaeb", "srcset": "https://si.imgix.net/0fe0146a/uploads/origins/e9fc427a-8d03-4ccf-9975-eaa70