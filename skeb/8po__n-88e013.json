たいのは、ふたなりの東北きりたんと同級生の男子がチンコ比べしてるイラストをお願いします。\n\n二人とも全裸でポーズはお任せしますが、目線はお互いのチンコを凝視して興奮して上気した表情。\nチンコは両者ともフル勃起、カウパー汗等体液多め、男子側は年相応のサイズで包茎気味で亀頭が少しだけ見えていて、きりたん側は男子よりちょっと大きめで亀頭が半分ぐらい露出してる感じだと嬉しいです。\n\nお任せする要素が多いですが、ご検討のほどよろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@8po__n/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3446417, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6004f46/uploads/origins/60e79822-c63a-4f47-a190-dd068e4b81f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4072757e77afd9c1585f5ca5d851bf1d", "srcset": "https://si.imgix.net/c6004f46/uploads/origins/60e79822-c63a-4f47-a190-dd068e4b81f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4072757e77afd9c1585f5ca5d851bf1d, https://si.imgix.net/c6004f46/uploads/origins/60e79822-c63a-4f47-a190-dd068e4b81f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe27f519ec4a187306d3f507f53629ed 2x, https://si.imgix.net/c6004f46/uploads/origins/60e79822-c63a-4f47-a190-dd068e4b81f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b2f00ee25a03edc8cb0d429225593d3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6004f46/uploads/origins/60e79822-c63a-4f47-a190-dd068e4b81f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab463b78f17280ccf6ac17d140db7388", "srcset": "https://si.imgix.net/c6004f46/uploads/origins/60e79822-c63a-4f47-a190-dd068e4b81f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab463b78f17280ccf6ac17d140db7388, https://si.imgix.net/c6004f46/uploads/origins/60e79822-c63a-4f47-a190-dd068e4b81f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7234a6761e8559b606d9ad605