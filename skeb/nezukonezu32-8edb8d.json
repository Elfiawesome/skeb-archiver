crop&crop=top&w=200&h=200&blur=200&s=add24af1ae398e20ab9411e0ce2121e0 3x"}, "body": "狐の嫁入りイラストをお願いします\n\n表情　結婚式を控え、はにかみつつも嬉しそう、又は幸せそうに微笑んでる\n(上記に限らず、幸せそうな雰囲気であれば大丈夫です。)\n\n特徴　けもみみ(キツネ耳)\n\n髪のスタイル　おまかせします\n髪の色　狐のイメージ色でおまかせします。白狐等も可\n\n服装　白無垢\n　(白色又は、少し黄色味のある白色等。お好きな他色を薄く混ぜ可。模様等もご自由に)\n\n使用しないで欲しい物のお願い\n(小物や背景、装飾品での使用は可)\n綿帽子(頭の被り物)　なし　(ケモミミが隠れるため。半透明のものは可)\n赤色和傘の所持　なし　(人物より目立つため)\n狐のお面の装着　なし　(顔が隠れるため。斜め掛けや所持は可。狐面と猫面の違いにご注意)\n\nその他の装飾品や小物等はおまかせします\n\n季節　春～秋\n（季節は参考のため、冬でも大丈夫です）\n天候　天気雨又は、雨上がりの晴れ　\n（天候も参考情報です。気にせず自由に描いてください。夜間の狐火などの描写も可です。）\n\n構図、解像度はおまかせします\n\n使用用途\nSkeb規約に準拠、キツネ関連の振興で使用(広報・配布品製作、地域の祭り等、非商用に限る)\n\n展覧用のため、宛名はナシでお願いします\n\n参考資料等\nhttps://twitter.com/pinsuke_m/status/1459135013924978694\n稲穂、巻物、宝珠、鍵の他、狐などの描写も歓迎です\n\n依頼文は他作者様と同様のものを送っておりますが、上記の各種設定にとらわれず、お好きなように自由に描いても大丈夫です。\n\nご検討お願いします", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nezukonezu32/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/52671ed4/uploads/origins/ace1ee87-7f73-476b-abe6-722f80f45e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee51e719c9c248bf4287f4ca1f2045fd", "srcset": "https://si.imgix.net/52671ed4/uploads/origins/ace1ee87-7f73-476b-abe6-722f80f45e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee51e719c9c248bf4287f4ca1f2045fd, https://si.imgix.net/52671ed4/uploads/origins/ace1ee87-7f73-476b-abe6-722f80f45e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=43ea903d2894dc1fe8744a6ac2ea2c0b 2x, https://si.imgix.net/52671ed4/uploads/origins/ace1ee87-7f73-476b-abe6-722f80f45e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88b4948b72cf9adc1c083b1ac57f0267 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 574286, "client_id": 2942646, "nc": 144}, {"path": "/@nezukonezu32/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "correction", "tipped": true, "creator_id": 574286, "client_id": 3553207, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16caad20/uploads/origins/2143d480-6031-471c-be10-4ed643b88331?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88319ce55f1a9f65b873c706cc79a94e", "srcset": "https://si.imgix.net/16caad20/uploads/origins/2143d480-6031-471c-be10-4ed643b88331?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88319ce55f1a9f65b873c706cc79a94e, https://si.imgix.net/16caad20/uploads/origins/2143d480-6031-471c-be10-4ed643b88331?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db4ca9a34fcddcfa2c380bd482841219 2x, https://si.imgix.net/16caad20/uploads/origins/2143d480-6031-471c-be10-4ed643b88331?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2abc204db39b6d7fbddceed40ae6735a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/16caad20/uploads/origins/2143d480-6031-471c-be10-4ed643b88331?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ea818adacef889fdba021528267f535", "srcset": "https://si.imgix.net/16caad20/uploads/origins/2143d480-6031-471c-be10-4ed643b88331?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ea818adacef889fdba021528267f535, https://si.imgix.net/16caad20/uploads/origins/2143d480-6031-471c-be10-4ed643b88331?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=88da6ff57243cc557a908e214b42f8fa 2x, https://si.imgix.net/16caad20/uploads/origins/2143d480-6031-471c-be10-4ed643b88331?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d8b77383da4b2ab1a3dfe3e1077baedd 3x"}, "body": "はむねずこ先生の描かれるノスタルジックな世界観が大好きなファンです。\n海辺で空を眺めるイラストを描いているのですが、\n先生のような「背景の奥行き」と「透き通るような空気感」を表現したいと思い、\nリクエストさせていただきました。\n\n特に以下の2点について、添削・加筆いただけますと幸いです。\n・遠景の表現：空をかすませて距離感を出すための効果的な色の選び方\n・視線誘導：海面の反射を利用して、見る人の視線を自然に奥へ導く表現\n\n初めてのリクエストのため、\nもし形式等に誤りがありましたらご容赦ください…（資料URLを添えさせていただきます）\n\n先生の描きやすい形で、自由に加筆・修正をお願いいたします。\nお手隙の際にご検討いただけますと幸いです。\n\nhttps://drive.google.com/file/d/1wapeiXjvGnNN10M0gJjLwBqeFp35ug8u/view?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nezukonezu32/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "correction", "tipped": false, "creator_id": 574286, "client_id": 2417875, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c33d3cbb/uploads/origins/7951b0f1-05dc-449d-b0ef-f281d3529fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43f8a14522afa166d5b8781696d0be8b", "srcset": "https://si.imgix.net/c33d3cbb/uploads/origins/7951b0f1-05dc-449d-b0ef-f281d3529fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43f8a14522afa166d5b8781696d0be8b, https://si.imgix.net/c33d3cbb/uploads/origins/7951b0f1-05dc-449d-b0ef-f281d3529fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c0217bcb3dcb4cde097437ee506fc8f 2x, https://si.imgix.net/c33d3cbb/uploads/origins/7951b0f1-05dc-449d-b0ef-f281d3529fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5dbd6b9c2ab256a984f10e8337058bb2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c33d3cbb/uploads/origins/7951b0f1-05dc-449d-b0ef-f281d3529fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f627eb3b40fef0aa9c87064f8336cb02", "srcset": "https://si.imgix.net/c33d3cbb/uploads/origins/7951b0f1-05dc-449d-b0ef-f281d3529fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f627eb3b40fef0aa9c87064f8336cb02, https://si.imgix.net/c33d3cbb/uploads/origins/7951b0f1-05dc-449d-b0ef-f281d3529fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=66b4a38ef530ca5190ffcb190df924b9 2x, https://si.imgix.net/c33d3cbb/uploads/origins/7951b0f1-05dc-449d-b0ef-f281d3529fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3c60a123aba5fb17752b179f93ca3838 3x"}, "body": "はむねずこ様\n\nはじめまして、織矢ささと申します。\n\n以前から、はむねずこ様の描かれるキャラクターのもちもちとした肌の質感や柔らかい線画、そして、本当にどこかにいるのではないかと思わせる存在感に心を奪われ、ずっと憧れております。\n画集の「またね、メランコリア」は私にとって宝物のような一冊で、何度も拝読しています…！\n\n――――――――――\n\n今回添削いただきたいイラストは、私のOCの一枚絵になります。\n\n大きな悩みは2点です。\n\n①OCのキャラクター設定を知らない方にも一目で魅力を感じてもらうための表現力や見せ方。\n\n②細部の塗り込みが好きなため、全体的に足し算の傾向があります。グレースケールでの明度確認などは行っているのですが、主観での判断に限界を感じております。\n画面全体の強弱の付け方についてアドバイスをいただけると嬉しいです。\n\n上記2点が現状悩んでいる部分ではございますが、はむねずこ様がご覧になった印象や、修正点・改善点等がありましたらぜひご助言いただけると幸いです。\n\n――――――――――\n\nなお、本作は自創作のイラストになりますので、色味の調整や描き足しなど、ご自由に手を加えていただいて構いません。\n\n何か不備等ございましたら、お手数ではございますが再送申請をいただけますと幸いです。\n\n何卒よろしくお願いいたします。\n\n――――――――――\n\n大変恐縮ながら、最終的な色味を保持したデータが統合済みの状態しかございません。\n 「最終色味のPNG（2種）」に加え、「色味調整前のレイヤー分け済みのPSD」も同封いておりますが、はむねずこ様のご都合の良い方をご活用いただけますと幸いです。\n\n▼xの投稿のURL\nhttps://x.com/sasa_oriya/status/2036749016504185072?s=46&t=JcGO628DaixVCNmOw--GlQ\n\n▼PNG/PSD\nhttps://drive.google.com/drive/folders/1atJKX9tK5VmVzFyyzwS59YHI5Mpv6IdJ", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 998539, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "YOTA SAKI 6/7ティア156【よ33b】", "screen_name": "shakep_p", "avatar_url": "https://pbs.twimg.com/profile_images/1997905314595876864/LtGkNP5f.jpg", "header_url": "https://pbs.twimg.com/profile_banners/8298686