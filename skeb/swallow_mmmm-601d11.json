3-4ad3-8b27-c0e013ade779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aded4630c651403e89c0ae4183697dd9", "srcset": "https://si.imgix.net/67bf16c6/uploads/origins/bb9b38e9-8883-4ad3-8b27-c0e013ade779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aded4630c651403e89c0ae4183697dd9, https://si.imgix.net/67bf16c6/uploads/origins/bb9b38e9-8883-4ad3-8b27-c0e013ade779?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=476c947ebf1ea9232a93fb4363a108fe 2x, https://si.imgix.net/67bf16c6/uploads/origins/bb9b38e9-8883-4ad3-8b27-c0e013ade779?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=92082d58b810dbb8b31ebae256067515 3x"}, "body": "こんにちは！あなたの作品とかわいいロボットガールの大ファンです。あなたのイラストを見て一目惚れしました...。最近の作品やデザインにとても刺激を受けています。そこで、私や私の友達のキャラクターのイラストをお願いしたいです！\n\n\"Gamer \"はシースルーのゼリーボディを持つロボット猫です。彼の顔にゲームカートリッジを差し込むとゲームができる！あまり人間には見えませんが、女の子を描くように自由に描いてください！目はつけられますが、顔はいつも緑です。あと、できれば体内の部品も見てみたい！\n\nCORA-5は動物のように行動するアンドロイドの猫の女の子です。彼女の頭には時計があり、首輪には感情が表示される。彼女の目、スカート、首輪、時計はすべて異なるものを表示することができます！そこに好きなものを追加してください。\n\nCORA-5は \"Gamer \"と遊んでいるのですが、力が強すぎて誤って壊してしまいます。もしかしたらキャンディだと思って耳をかじっちゃうかも。CORA-5がスパゲティのように食べているボタンやワイヤーが落ちているかもしれません。とにかく、他に何か好きなものを追加してください！このリクエストを楽しんでもらえるとうれしいです。\n\nゲーマー: https://ockimberkcally.carrd.co/#gamerboy\nCORA-5: https://sta.sh/2pqnhgg08ep", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@swallow_mmmm/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1142870, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76fe7961/uploads/origins/607f44d9-ab11-4207-ae03-30c8398660a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a479638ec5eb2a2c0bce5c1a967841e8", "srcset": "https://si.imgix.net/76fe7961/uploads/origins/607f44d9-ab11-4207-ae03-30c8398660a8?bg=%23fff&auto=format%2Ccomp