gix.net/2ffd1a8a/uploads/origins/7708b14b-43d2-4db7-8ef7-bebabf051084?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46dee2ca01af015d3371c3e14dfaf8e6 2x, https://si.imgix.net/2ffd1a8a/uploads/origins/7708b14b-43d2-4db7-8ef7-bebabf051084?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a8c2ef05e8e76e4b45fa3e3931a1146 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ffd1a8a/uploads/origins/7708b14b-43d2-4db7-8ef7-bebabf051084?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ea6c4a4fd981116e3482904acbe79e7", "srcset": "https://si.imgix.net/2ffd1a8a/uploads/origins/7708b14b-43d2-4db7-8ef7-bebabf051084?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ea6c4a4fd981116e3482904acbe79e7, https://si.imgix.net/2ffd1a8a/uploads/origins/7708b14b-43d2-4db7-8ef7-bebabf051084?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c9ddfcfad19daad9af9e9e26c6b24906 2x, https://si.imgix.net/2ffd1a8a/uploads/origins/7708b14b-43d2-4db7-8ef7-bebabf051084?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=251de39ad48b34d641e7dcb9c16389eb 3x"}, "body": "はじめまして！\n\nポケモンのマスキッパが、ゴルダックの頭にかぶりついているイラストをお願いしたいです。\n参考: youtubeでpokemon golduck kemoryonaと検索すると出てくるシーンのイメージです（アニポケdp7話）\n\nマスキッパの状態:\n腕の葉っぱでゴルダックのお腹にきつく絡みつき、口でゴルダックの頭にかぶりついている。\n表情は無表情。\n\nゴルダック の状態:\n体型はマッチョ体型。\n全身汗だく。\n頭はマスキッパの口の中にすっぽりおさまっている。\n口から脱出しようと手足・しっぽをバタバタさせている。\n※手足もしっぽもイラスト内でほぼ見切れず描写されていると嬉しいです。\n大胸筋と乳首は巨大で、ブルンブルンと揺れている。両乳首（ピンク色）には金色のリング状の乳首ピアスがついている。\n\nボッキして大量に射精している。\n金玉は大袈裟なくらい超巨大でブルンブルンと揺れている。\n\nお尻の穴にマスキッパの触手の一つがねじ込まれて責められている。※穴自体は画面に映らなくても問題ございません。\n\n背景:オレンジ色以外\n\n参考URL\nhttps://youtu.be/-WM7zfiQqFY?si=9vhPsmdbH9ejvF1G\n\n以上になります。\nお願いできれば嬉しいです！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@so