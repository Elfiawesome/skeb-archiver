うな縦長でも嬉しいです\n\nポーズ\n見た者を魅了するその瞳に心を見透かされる見られるだけで懺悔したくなるような凛々しい姿(？)\n背景や雰囲気はシラクーザの夜の様な暗め､又は裁判所の様な神々しさ？にして頂けると嬉しいです！\n\n細々とした希望になってしまいますが先生の腕を信じてるのである程度おまかせでも大丈夫です！！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_engw81O/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3476852, "client_id": 3550671, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80d1ceac/uploads/origins/19e2d245-36b1-48c8-bf44-b763548a31c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34b59474c0ef9c50266fea192f618330", "srcset": "https://si.imgix.net/80d1ceac/uploads/origins/19e2d245-36b1-48c8-bf44-b763548a31c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34b59474c0ef9c50266fea192f618330, https://si.imgix.net/80d1ceac/uploads/origins/19e2d245-36b1-48c8-bf44-b763548a31c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bde0c21db4114704dfaedfc0acc5abb2 2x, https://si.imgix.net/80d1ceac/uploads/origins/19e2d245-36b1-48c8-bf44-b763548a31c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfdbd75863e9e0ccfa07a7a0f394b761 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80d1ceac/uploads/origins/19e2d245-36b1-48c8-bf44-b763548a31c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7305592df370d3aa3d27599ebd4cb99e", "srcset": "https://si.imgix.net/80d1ceac/uploads/origins/19e2d245-36b1-48c8-bf44-b763548a31c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7305592df370d3aa3d27599ebd4cb99e, https://si.imgix.net/80d1ceac/uploads/origins/19e2d245-36b1-48c8-bf44-b763548a31c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b2f17e0402e246700878f39238c3a118 2x, https://si.imgix.net/80d1cea