n illust/124373378  \n\n自分をテーマにしていて、自分は作曲やイラスト、漫画制作をしたりお花が好きなので  \n\n・ピアノ \n・楽譜 \n・ヘッドホン \n・漫画の原稿、画材 \n・花  \n\nがモチーフに入ってるととても嬉しいです！  \n\n性格はクール目で、プライド高そうなクリエイター…みたいな設定です。 結構カッコいい感じのキャラです！ \n\n 構図や背景はモイジさんのイメージするように好きな感じで描いていただければ嬉しいです！  \n\n もし気乗りしなかったりご都合が悪ければキャンセルしていただいても構いません。 それでは失礼いたします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Whybe123/works/548", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2285556, "client_id": 2721695, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a021be58/uploads/origins/ee4c696a-2288-4977-a080-03154a9f9b4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70168cf95bc9398c5fd9407397275e8d", "srcset": "https://si.imgix.net/a021be58/uploads/origins/ee4c696a-2288-4977-a080-03154a9f9b4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70168cf95bc9398c5fd9407397275e8d, https://si.imgix.net/a021be58/uploads/origins/ee4c696a-2288-4977-a080-03154a9f9b4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96d8c8a2f836f2d1a24e5cf9cd34082c 2x, https://si.imgix.net/a021be58/uploads/origins/ee4c696a-2288-4977-a080-03154a9f9b4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b38a61d9f03d3c35e25e63bc6185e343 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a021be58/uploads/origins/ee4c696a-2288-4977-a080-03154a9f9b4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c46e997f1cedd8d46ce4017b6c09f0ab", "srcset": "https://si.imgix.net/a021be58/uploads/origins/ee4c696a-2288-4977-a080-03154a9f9b4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c46e997f1cedd8d46ce4017b6c09f0ab, https://si.imgix.net/a021be58/uploads/origins/ee4c696a-2288-4977-a080-03154a9f9b4d?bg=%23fff&auto=forma