格的にはやんちゃな男の子。召喚主大好き。よく弾み、よく転がる。\n\n類似リクエストを先んじてひとつ飛ばしておりましたが、諸々失礼がある内容なのでは、と一度取り下げました。\n結果、複数回お目汚しすることになってしまい申し訳ありません。\nご検討、宜しくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@del_DEPTHs/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 130287, "client_id": 932225, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94ef43e3/uploads/origins/8bbbbb5d-2d2c-410c-abe8-213707dd40c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c7480c47c0ed1526031bb23981b399b", "srcset": "https://si.imgix.net/94ef43e3/uploads/origins/8bbbbb5d-2d2c-410c-abe8-213707dd40c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c7480c47c0ed1526031bb23981b399b, https://si.imgix.net/94ef43e3/uploads/origins/8bbbbb5d-2d2c-410c-abe8-213707dd40c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=456228823e38766a0341b5b46b6a1dba 2x, https://si.imgix.net/94ef43e3/uploads/origins/8bbbbb5d-2d2c-410c-abe8-213707dd40c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28d77710717d9a795ed435511e257a3c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94ef43e3/uploads/origins/8bbbbb5d-2d2c-410c-abe8-213707dd40c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec13ea267515fe79d1a79ce762abbe5f", "srcset": "https://si.imgix.net/94ef43e3/uploads/origins/8bbbbb5d-2d2c-410c-abe8-213707dd40c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec13ea267515fe79d1a79ce762abbe5f, https://si.imgix.net/94ef43e3/uploads/origins/8bbbbb5d-2d2c-410c-abe8-213707dd40c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=52edeaf561701c8a7d1cde54a2154d3f 2x, https://si.imgix.net/94ef43e3/uploads/origins/8bbbbb5