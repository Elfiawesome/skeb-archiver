=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b03a6b8b96e0792a097e4ba9ed307e46 2x, https://si.imgix.net/90d87a3b/uploads/origins/fca4c632-1421-43f5-8923-5e2ae8c534ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad42b20e76e2e299b42a16fd662dfed5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90d87a3b/uploads/origins/fca4c632-1421-43f5-8923-5e2ae8c534ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=536a62b326f0b9c904914d9f88da4795", "srcset": "https://si.imgix.net/90d87a3b/uploads/origins/fca4c632-1421-43f5-8923-5e2ae8c534ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=536a62b326f0b9c904914d9f88da4795, https://si.imgix.net/90d87a3b/uploads/origins/fca4c632-1421-43f5-8923-5e2ae8c534ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62b794e6e27a74f3e442833ba5d89785 2x, https://si.imgix.net/90d87a3b/uploads/origins/fca4c632-1421-43f5-8923-5e2ae8c534ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bd078af8fa30a4b14099a98787a67b5c 3x"}, "body": "del先生、初めまして\nPixivに投稿されたシンクロの素敵なイラストに感銘を受けて、リクエストを送らせていただきました。\n\nもし宜しければシンクロニクルのアリンをお願いします。\n内容についてはとりあえず、先生のアリンに対しての印象でお好きなように描いて頂ければと思います。\n\nもし何かお題があった方が描きやすい場合、「普段着」のアリンをお願いしたいです。\nゲーム内ではボロ布のような服かド派手なハレギしか持ってないアリンですが、休日にへルドラの街を目立たずに歩き回れるよう、ラフで落ち着いた服装を着せるのが長年の悲願です。こちらの場合服装のデザインもお任せいたします。\n\nご検討のほどよろしくお願いいたします。\n\n必要ないかもしれませんが、一応資料URL\n通常：https://imgur.com/a/4d2adMV\n晴着：https://imgur.com/a/LsmRfi6", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@del_DEPTHs/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 130287, "client_id": 932225, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1c65839/uploads/origi