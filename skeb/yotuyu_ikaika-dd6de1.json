等\n\n以上になります。\n不備等あればお手数ですが再送申請をお願いいたします。\n\nhttps://drive.google.com/drive/folders/1_seODlagk5dPko1Uf1XXu65hNTW5lqid?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yotuyu_ikaika/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 672260, "client_id": 2774924, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bce069ce/uploads/origins/de8f4d12-421f-47b3-aa8d-aaf96311ba0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a8e04c92df90e6997fdb75e38a2aa8b", "srcset": "https://si.imgix.net/bce069ce/uploads/origins/de8f4d12-421f-47b3-aa8d-aaf96311ba0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a8e04c92df90e6997fdb75e38a2aa8b, https://si.imgix.net/bce069ce/uploads/origins/de8f4d12-421f-47b3-aa8d-aaf96311ba0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e5db83d26e63c3b48a4347d41c81018 2x, https://si.imgix.net/bce069ce/uploads/origins/de8f4d12-421f-47b3-aa8d-aaf96311ba0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8d6c3bc2103700be8d76eaab451b3a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bce069ce/uploads/origins/de8f4d12-421f-47b3-aa8d-aaf96311ba0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0448c468c28682fdb5aa3b167a6c28e6", "srcset": "https://si.imgix.net/bce069ce/uploads/origins/de8f4d12-421f-47b3-aa8d-aaf96311ba0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0448c468c28682fdb5aa3b167a6c28e6, https://si.imgix.net/bce069ce/uploads/origins/de8f4d12-421f-47b3-aa8d-aaf96311ba0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07cb5ff7a7f9ccaa634e25dd1df66f54 2x, https://si.imgix.net/bce069ce/uploads/origins/de8f4d12-421f-47b3-aa8d-aaf96311ba0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=144e7958bd83e4759ef92ae0bc3a10a6 3x"}, "body": "よつゆ様、初めまして。こんばんは。いぬみりんと申します。\nいつも素敵なイラスト拝見させていただいております。\n今回、宜しければ自探索者のイラストを依頼させていただきたいです。\n\n以下設定といたしまして\n◇職業：刑事\n◇性格：几帳面で論理的。冷静だが友人や仕事関係の人以外に興味がない。\n◇その他：重度のヘビースモーカー\n◇情報：38歳、182cm　笑う時は眉を下げて控えめに笑う\n\n参考資料などは下記に載せさせていただきます。リンク先ネタバレ等はありません。\n\nよつゆ様の絵に対する構図や色使い、表情などのセンスが大好きなので、そちらはお任せさせていただければと思います。\n洋服等も資料として複数枚入れさせていただいています。お好きなものを描いていただければ幸いです。\n\n作業量等、見合わない金額でしたらキャンセルしていただいて大丈夫です。\n\nお忙しいかと思いますが、何卒ご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10FR2KDvDUDFfre7HCHebN7EAapVmwVyN", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1652641, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "シケもく", "screen_name": "9302w", "avatar_url": "https://pbs.twimg.com/profile_images/2091160151126577152/FFcvY1CF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1301852582382501888/1786285822/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1688710, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "KiiKo @アニメ原画風skeb", "screen_name": "Kiiko_clip", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fd4b360a8-1c07-44f9-b59a-94c6982e2227.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fb207f67-3c6c-47bb-9795-c6d4b3977f4a.webp", "appeal_receivable": false, "popular_creator_rank": 35, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 8, "complete_