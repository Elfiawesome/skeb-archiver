状は先生にお任せ\n・女性提督の体位お任せ\n・女性提督は嫌がっていると嬉しいです(アヘ顏NG)\n・背景お任せ\n\n色々と事情が御座いましたら遠慮なくキャンセルくださいませ", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@taimajo_nikoru/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3519165, "client_id": 966238, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc244f90/uploads/origins/cabd0c82-6ad9-41d6-ace6-353dd6078265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d0e429ceacc54f9b4d280c8d348a0ca", "srcset": "https://si.imgix.net/bc244f90/uploads/origins/cabd0c82-6ad9-41d6-ace6-353dd6078265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d0e429ceacc54f9b4d280c8d348a0ca, https://si.imgix.net/bc244f90/uploads/origins/cabd0c82-6ad9-41d6-ace6-353dd6078265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b4536cb9086c3c166a5e2caa60c22bf 2x, https://si.imgix.net/bc244f90/uploads/origins/cabd0c82-6ad9-41d6-ace6-353dd6078265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d213f1843112bc6d5fd6b956aa29698e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc244f90/uploads/origins/cabd0c82-6ad9-41d6-ace6-353dd6078265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c60ac1ac546ef99d98c17a30c98a0e1", "srcset": "https://si.imgix.net/bc244f90/uploads/origins/cabd0c82-6ad9-41d6-ace6-353dd6078265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c60ac1ac546ef99d98c17a30c98a0e1, https://si.imgix.net/bc244f90/uploads/origins/cabd0c82-6ad9-41d6-ace6-353dd6078265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=70c1138724a40077d862e7ddf478bcd2 2x, https://si.imgix.net/bc244f90/uploads/origins/cabd0c82-6ad9-41d6-ace6-353dd6078265?bg=%23fff&au