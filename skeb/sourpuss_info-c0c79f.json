近づくと、彼の目と顔が温かな表情で輝き、彼女を迎える。彼女は、彼の派手なリップとアイメイクで色づいた顔を見る。キャシーは顔を赤らめながら、仕事の化粧はもちろん、彼が現れるとは思わなかったと告げる。アレクサンダーは、何か特別なもてなしをしたかったと言い、口紅をつけたまま頬にキスをする。彼女はさらに赤面し、二人は一緒に立ち去る。\n\n機会をくれてありがとう！もしこの仕事が多く、もっと報酬が必要な場合は、リクエストを再送してください。\n\nhttps://drive.google.com/drive/folders/1NHb-aM0Rr6VwyRRJmeFvtRN_UjWT0lxq?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sourpuss_info/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2038993, "client_id": 3596523, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef9ef028/uploads/origins/eb1294fc-b1b4-44dc-8ea6-a95d5107d545?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c01fb29f6ab949c7c3feabf8eec9489", "srcset": "https://si.imgix.net/ef9ef028/uploads/origins/eb1294fc-b1b4-44dc-8ea6-a95d5107d545?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c01fb29f6ab949c7c3feabf8eec9489, https://si.imgix.net/ef9ef028/uploads/origins/eb1294fc-b1b4-44dc-8ea6-a95d5107d545?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29deeb909bf737f81ea1ffb64bc9bd7b 2x, https://si.imgix.net/ef9ef028/uploads/origins/eb1294fc-b1b4-44dc-8ea6-a95d5107d545?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=327fa8ab0fb5b45195e5c43c9dd55c42 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef9ef028/uploads/origins/eb1294fc-b1b4-44dc-8ea6-a95d5107d545?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9782f5727feb2b382508ab49d73483c0", "srcset": "https://si.imgix.net/ef9ef028/uploads/origins/eb1294fc-b1b4-44dc-8ea6-a95d5107d545?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9782f5727feb2b382508ab49d73483c0, https://si.imgix.net/ef9ef028/uploads/origins/eb1294fc-b1b4-44dc-8ea6-a95d5107d545