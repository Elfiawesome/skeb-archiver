/uploads/origins/ccc03507-2ff3-4c43-a5a5-0bd7aecf3eea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79bea6def016c3cb65d4effb805e7896", "srcset": "https://si.imgix.net/c5e184ca/uploads/origins/ccc03507-2ff3-4c43-a5a5-0bd7aecf3eea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79bea6def016c3cb65d4effb805e7896, https://si.imgix.net/c5e184ca/uploads/origins/ccc03507-2ff3-4c43-a5a5-0bd7aecf3eea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94969d13e3feee24a400db1e15ebd24c 2x, https://si.imgix.net/c5e184ca/uploads/origins/ccc03507-2ff3-4c43-a5a5-0bd7aecf3eea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb29aec544cea44c81f058183c673613 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5e184ca/uploads/origins/ccc03507-2ff3-4c43-a5a5-0bd7aecf3eea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e457417a7456c0e1133ad0bf7d5184d3", "srcset": "https://si.imgix.net/c5e184ca/uploads/origins/ccc03507-2ff3-4c43-a5a5-0bd7aecf3eea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e457417a7456c0e1133ad0bf7d5184d3, https://si.imgix.net/c5e184ca/uploads/origins/ccc03507-2ff3-4c43-a5a5-0bd7aecf3eea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05bd46619784a63cd0109ceb58962093 2x, https://si.imgix.net/c5e184ca/uploads/origins/ccc03507-2ff3-4c43-a5a5-0bd7aecf3eea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=769ce00988fb52c1c4ce9a4911358ecb 3x"}, "body": "こんにちは！あなたの白黒マンガ風の絵が大好きです。友人のプレゼントにイラストをお願いしたいです。\nhttps://skeb.jp/@sourpuss_info/works/3 こちらのキャラクターイラストがとても気に入りました。\n\n彼女はドMで、人をからかうのが好きです。\nポーズと表情は「Pose_Composition_Ref」のような感じでお願いしたいです。もし、ポーズやフレーミングを少し調整した方がドMな雰囲気が出るようでしたら、遠慮なくしてください。\n\n友人については、ちょっと複雑なお願いがあります。\nLingerie_Outfit_Ref」のランジェリー衣装で、「Hair_Ref」と「Extra_Ref」のショートヘアでお願いします。\nまた、「Coat_Ref」のコートのみを追加してほしい。\n吹き出しは不要。2文字目は不要。\n\nもし色があるとすれば、それは目であってほしい。\n\nもし可能であれば、違うバージョンもお願いします：アソコを露出しているバージョンと、資料のようにロリポップで隠しているバージョン。可能であれば、下の方に人のシルエットも1バージョンで。\nまたは、自分でオプションをミックス＆マッチできるPSDファイルがあればうれしいです。\n\nもし金額が足りなければ、修正した金額を送ってください。\n\nhttps://drive.google.com/drive/u/1/folders/1DF0Gak010nY8gUYib-BksVBf6X0fVyDC", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sourpuss_info/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2038993, "client_id": 2952716, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/58846ea3/uploads/origins/bafee41d-8a31-42e3-b33e-819bd3757e65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7248b10623b4f076cae38a028c45ff6", "srcset": "https://si.imgix.net/58846ea3/uploads/origins/bafee41d-8a31-42e3-b33e-819bd3757e65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7248b10623b4f076cae38a028c45ff6, https://si.imgix.net/58846ea3/uploads/origins/bafee41d-8a31-42e3-b33e-819bd3757e65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3575009b62af162537537e7f631cc4e3 2x, https://si.imgix.net/58846ea3/uploads/origins/bafee41d-8a31-42e3-b33e-819bd3757e65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd2b06ac9259dc291f3b3def223c503a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/58846ea3/uploads/origins/bafee41d-8a31-42e3-b33e-819bd3757e65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36dddcc6b281b4972e15b3e3675a5ad2", "srcset": "https://si.imgix.net/58846ea3/uploads/origins/bafee41d-8a31-42e3-b33e-819bd3757e65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36dddcc6b281b4972e15b3e3675a5ad2, https://si.imgix.net/58846ea3/uploads/o