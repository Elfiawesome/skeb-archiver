n以下のイメージの連想が難しい場合は適当にカッコよくでお願いします。\n・激しめの音楽で使用可能なダーク寄りイメージ\n・チルめの穏やかな音楽で使用可能な若干明るめイメージ\n\n参考\n・使用予定BPM： 90～130\n・メインジャンル：House, Trap, Dubstep, Hyperpop, Electronica\n\nロゴについては2拡張子を格納してます。\n・PNG（白文字・黒透過）\n・SVG （Inkscapeにて制作・製作途中のレイヤー保持）\n\nロゴについては自前の素人制作なので、\nロゴが動画で使いにくい場合は雰囲気に影響の出ない範囲内で修正頂いて大丈夫です。\n以上です。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1BbNMwu8vbX_Ieau8zY4WlFiwWHr1DN_S?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 37298, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "初白まみむ👾", "screen_name": "ko_cha_22", "avatar_url": "https://pbs.twimg.com/profile_images/2030996667038838786/J7-TyIGT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/828583901392023553/1704788073/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 764529, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "PIKAO", "screen_name": "pikao_s", "avatar_url": "https://pbs.twimg.com/profile_images/1302279222224760834/Pw-Seqih.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1129073435768786945/1633877417/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 14, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 1299242, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "八波ヤナ / Yanami", "screen_name": "Tanaka_Yana_", "avatar_url": "https://pbs.twimg.com/profile_images/1874467635171364864/JZ8V80wg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/933153951