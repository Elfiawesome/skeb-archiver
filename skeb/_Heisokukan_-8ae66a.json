68817b57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9f37cdfc4ee976c78deb03505d382f6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e5c48ad8/uploads/origins/3cfa44b5-618b-4528-9f74-c28668817b57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4904b88b7be5c16d7dfa5d297b0f7f16", "srcset": "https://si.imgix.net/e5c48ad8/uploads/origins/3cfa44b5-618b-4528-9f74-c28668817b57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4904b88b7be5c16d7dfa5d297b0f7f16, https://si.imgix.net/e5c48ad8/uploads/origins/3cfa44b5-618b-4528-9f74-c28668817b57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4390f76e60f1d7916ec06e8f41fed45a 2x, https://si.imgix.net/e5c48ad8/uploads/origins/3cfa44b5-618b-4528-9f74-c28668817b57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ef9f6a71201ffa9f3ab0c45ba81365bf 3x"}, "body": "緋岡さま、初めまして。\nSNSでイラストを見て、ぜひ私のOCを描いていただきたいと思い、リクエストを送らせていただきました。\n\n使用用途は、\n・SNSのヘッダーやアイコンなどの利用\n・友人への共有\n・今後依頼する際の資料\nと考えています。\n\nキャラの見た目で描きにくい箇所やわからない箇所があれば省略していただいて構いません。\n構図、ポーズなどは特に指定ありません。服装や髪型も自由に変更していただいて構いません。\nキャラクターを自由に解釈して描いていただいて大丈夫です！一枚絵や落書きでも、描きたいものを描いていただけたら嬉しいです。\n\n不備や金額の不足などがありましたら遠慮なくキャンセルや再送をおねがいします。\n丸投げの形となってしまって申し訳ないですが、ご検討のほどよろしくおねがいします！\n\n設定や資料は以下にまとめています。\n\n▶︎斐廉 潔(ひかど いさぎ)-32歳-男性-175cm\n国語教師。書道部の顧問を持ってるがほとんどサブとして。\n猫背だし目つきも悪い。\n潔癖症のため、机には殺菌スプレーが置いてある。通勤はバイク。\n授業はちゃんと聞けば分かりやすい。けどめちゃくちゃ眠くなるし、面白さは無い。\n大の虫嫌い。\n\nhttps://drive.google.com/drive/folders/1-KPYSfBb9FYGFiMNUEsAVjES6YvhTCpe", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_Heisokukan_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2691646, "client_id": 2939238, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.