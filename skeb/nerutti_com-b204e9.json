c9293c-79c0-44bf-924c-05fee74e0a41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f20a85bfa4d24d5f8b3c52f932eca87f 3x"}, "body": "はじめまして！\nneruttiさまのイラストをみて一目惚れし依頼させていただきました\n\nうちの子とマスコット「多分ねこ」が一緒に描かれたイラストをお願いしたいです\n服装は参考資料内の制服ベースで、服装アレンジしても大丈夫です\n\n構図等はおまかせします、自由に描いていただければ嬉しいです\nご検討よろしくお願いします！\n\n参考資料：https://to.yan-k.tv/Yan-KMishe\n多分ねこ：https://yan-k.booth.pm/items/3934148", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nerutti_com/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3191245, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78307a41/uploads/origins/4c429c61-2df7-4b15-8aef-5c3c57e21f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=662100a082de2eee3d1e8a61fe55953e", "srcset": "https://si.imgix.net/78307a41/uploads/origins/4c429c61-2df7-4b15-8aef-5c3c57e21f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=662100a082de2eee3d1e8a61fe55953e, https://si.imgix.net/78307a41/uploads/origins/4c429c61-2df7-4b15-8aef-5c3c57e21f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8cb0310cf716fe5b568e9ead042d0213 2x, https://si.imgix.net/78307a41/uploads/origins/4c429c61-2df7-4b15-8aef-5c3c57e21f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc027adbd07cf1ea129327419ce864c4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78307a41/uploads/origins/4c429c61-2df7-4b15-8aef-5c3c57e21f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56b53057960e9ceec49c8524fb40e809", "srcset": "https://si.imgix.net/78307a41/uploads/origins/4c429c61-2df7-4b15-8aef-5c3c57e21f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56b53057960e9ceec49c8524fb40e809, https://si.imgix.net/78307a41/uploads/origins/4c429c61-2df7-4b15-8aef-5c3c57e21f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b819da70abaa286946bd71667b2e3d46 2x, https://si.imgix.net/78307a41/uploads/origins/4c429c61-2df7-4b15-8aef-5c3c57e21f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f51a3e29b0799d0d93b9ad356743ea57 3x"}, "body": "nerutti先生はじめまして！\n通りすがりで依頼させていただきます！\n\n先生のアイコンのイメージにかなり近いのですが、女の子と犬(イメージはお利口なジャーマンシェパード)がニヤリ顔(ドヤ顔との中間くらい)で並んでいる絵をお願いします！\n\nおりこうなシェパードの参考画像です\nhttps://wanko-peace-winds-org.s3.ap-northeast-1.amazonaws.com/wp-content/uploads/2021/08/01172447/no201.jpg\n\n女の子と犬の表示はらきすたの泉こなたのドヤ顔(笑顔)のイメージが近いです。\n\nhttps://www.pixiv.net/artworks/46481816\nこのこなたのドヤ感が100%ドヤ顔だとすると(?)、50-75%くらいのドヤ感でお願いします！\n\n\n配置はこのスタンプの右上の\nhttps://sale.24028.jp/line-stamp/202403/assets/_img/img_01.jpg\n「どう？」のような横並びで肘をついている配置でお願いします！(犬は肘を付けないか？なので伏せてる体勢？？)\n\nこのスタンプのちみ(ハムスター)の表情もかなりイメージに近いです。\n\n女の子のデザインは完全にお任せします！！\n\n女の子と犬は互いに「自分の方がえらい」と思っているみたいな関係性をイメージしています。\n\nまた可能であれば丸抜きのアイコンとして使えるように構図を配置していただけると嬉しいです！\n\n他にも先生の思いつきで色々足していただいて全然大丈夫です！\n\n雑な依頼で恐縮ですが楽しみにしております！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nerutti_com/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a76f7cfa/uploads/origins/986e879b-d28f-4876-bc82-795f3c2fcfc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ac2c1a0087a7665f719f0cd07b87d5f", "srcset": "https://si.imgix.net/a76f7cfa/uploads/origins/986e879b-d28f-4876-bc82-795f3c2fcfc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ac2c1a0087a7665f719f0cd07b87d5f, https://si.imgix.net/a76f7cfa/uploads/origins/986e879b-d28f-4876-bc82-795f3c2fcfc6?bg=%2