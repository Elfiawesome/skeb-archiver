す。\nるんば　様の仄暗い世界観が好きです。ポーズや表情などは、自由に描いていただけたらと思います。\n\n【使用用途】\n個人鑑賞、「skebで描いていただきました」とポストする可能性あり。\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1IZY-viHmQz8BueTCh4N0S3ldygsOuE3x", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1154158, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゆのり▼ご依頼受付中", "screen_name": "Mo_518_mO", "avatar_url": "https://pbs.twimg.com/profile_images/1994165821476896768/li1ulPsb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/898426277446549505/1765828903/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 25, "skills": [{"genre": "art"}, {"genre": "video"}], "banned": false, "nc": 177}, {"id": 1366068, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "お、", "screen_name": "ooo_0926", "avatar_url": "https://pbs.twimg.com/profile_images/1976456505617678337/k4n0GrRE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1393369213792751620/1768864254/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 161}, {"id": 2772909, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "アスカ", "screen_name": "ASUKA2k", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F8456385b-867b-415c-8f34-3840099f931d.gif?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/533609d5-2f21-45e5-8947-a9ad7e9f8d3d.gif", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_re