がとても素敵です。もし可能であれば、私のオリジナルキャラクターの絵を依頼したいです。\n\n彼は、星の間に生まれた狐の精です。真面目な性格ですが、まだ若いので可愛らしく無邪気な一面も持っています。ポーズや表情、背景は自由ですが、柔らかく軽やかで夢のような雰囲気を希望します。また、画像は横長でお願いします。\n\n参考：https://imgur.com/a/9V5jNE4\n\n私のリクエストを考慮していただき、ありがとうございました", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chimu_0520/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 821838, "client_id": 1430366, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15c91361/uploads/origins/172f211c-1812-4ebd-a186-cdae79ec2ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aead50f8ac04b9632c107ea534a634a6", "srcset": "https://si.imgix.net/15c91361/uploads/origins/172f211c-1812-4ebd-a186-cdae79ec2ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aead50f8ac04b9632c107ea534a634a6, https://si.imgix.net/15c91361/uploads/origins/172f211c-1812-4ebd-a186-cdae79ec2ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2d3ee7b734ad5bd7f295cd34a589022 2x, https://si.imgix.net/15c91361/uploads/origins/172f211c-1812-4ebd-a186-cdae79ec2ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55e2f931c58dc57b3f2652264c93afd5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15c91361/uploads/origins/172f211c-1812-4ebd-a186-cdae79ec2ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=681075c2e74f5d02f12aed11041d7b6e", "srcset": "https://si.imgix.net/15c91361/uploads/origins/172f211c-1812-4ebd-a186-cdae79ec2ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=681075c2e74f5d02f12aed11041d7b6e, https://si.imgix.net/15c91361/uploads/origins/172f211c-1812-4ebd-a186-cdae79ec2ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=495c8