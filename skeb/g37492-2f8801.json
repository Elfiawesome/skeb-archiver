ある。\n傲慢、尊大、わがまま。おしゃれさん。\n\n◆二人の関係性\n白髮白目男に黒髪ピンク目の男が振り回されたりツッコんだりしている事が多いです。基本的に白髮白目男はあまり表情がかわりませんが、時々にこりとすることもあります。\n黒髪ピンク目男はからかったり煽ったりする表情か、むっとした顔のことが多いです。付き合ってはいませんが距離は近いです。\n\n【服装や希望のシチュエーションについて】\n服装やイラストの構図などについてはプナヌロ様にお任せいたします。\n二人の距離が近いととても嬉しいです。\n\n以上になります。\n乱文失礼いたしました。ご検討頂けますと幸いです。\n\nhttps://drive.google.com/drive/folders/12tbgdeLNwtBMciG8hUx5IoAzDqeMGAO0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@g37492/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d5ac1fd4/uploads/origins/f39420ed-00a2-4004-a109-b6dd78a6247d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28a27f7223e2ea4a0299a71d30e38a18", "srcset": "https://si.imgix.net/d5ac1fd4/uploads/origins/f39420ed-00a2-4004-a109-b6dd78a6247d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28a27f7223e2ea4a0299a71d30e38a18, https://si.imgix.net/d5ac1fd4/uploads/origins/f39420ed-00a2-4004-a109-b6dd78a6247d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1fec87e94ef9a44e3d2570f3754e4f77 2x, https://si.imgix.net/d5ac1fd4/uploads/origins/f39420ed-00a2-4004-a109-b6dd78a6247d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d40a7ddf1dacd6f7970dcbaf74da83e5 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2939048, "nc": 177}, {"path": "/@g37492/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2939048, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/107b6ecf/