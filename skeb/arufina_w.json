奥側の構図でお願いします。\n\n参考になりそうな画像を資料として添付しますが、同じように描く必要は無く、けるまよさんの描きやすいように描いてください。\n\nhttps://www.dropbox.com/scl/fi/9s0usz3k2z50z0c35yzc7/IMG_7837.JPG?rlkey=u3ngqp6hl0cs6pq1ppzcgrnsc&dl=0\n\nhttps://www.dropbox.com/scl/fi/9s0usz3k2z50z0c35yzc7/IMG_7837.JPG?rlkey=u3ngqp6hl0cs6pq1ppzcgrnsc&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arufina_w/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a28bd6d0/uploads/origins/fb5f2fd3-011a-42d5-9c43-7850063a8d78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8758802c6139c04b964814178af84b19", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2888197, "client_id": 49855, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 35, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@arufina_w/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2888197, "client_id": 284909, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7fde90d/uploads/origins/b5992959-c0e4-4ae3-805f-773b19c39157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74af0257a664b0dc0189bdbac8c4da7a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7fde90d/uploads/origins/b5992959-c0e4-4ae3-805f-773b19c39157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=538fe597a3774d6c81e669a227c7436c", "src_set": ""}, "body": "けるまよさん初めまして、絵柄に惹かれ自分の代理君を描いて貰いたくリクエストしました！ \n\nhttps://x.com/y_watch2015/status/1703783839200633014?t=RSZqz7I-_d-KHfx_1RED_w&s=19 \n\nhttps://x.com/y_watch2015/status/1753040542228009445?t=MhUNAIWT6Y5rBzR40vDF5A&s=19 \n\nリク内容としては\n・自分の代理君が届いた赤いアロハシャツを着るとぼわっと白い煙に包まれ気づくとサマーなサンタの様な姿になっている \n\n詳細について\n・代理君は♂️、年齢３０代、体型はぽっちゃり、資料では緑パーカー・紺のハーフズボンを着用してますが今回はズボンはそのまま緑パーカーでなく赤いアロハシャツで(老いた姿の代理君もアロハシャツ・ハーフズボンで耳にサンタ帽子を被せていただきたいです) \n\n・老いた姿の代理君は年齢７０～８０歳代まで一気に歳を取り体型はぽっちゃりから完全にデブになって全身に贅肉が付きでっぷり突き出たお腹が露になっている \n\n・顔や手には皺シミが深く刻まれ真っ白もふもふな眉とボリューミーでサンタな口髭、もしゃもしゃ顎髭が生えている(顎髭はお腹にかかる位の量で) \n\n・サンタになってしまった事に気づき途方に暮れ片方の手は髭を触りもう片方は突き出たお腹を触っており表情は…といった困惑した感じの顔で \n\nその他細かい部分はお任せします！普段描かれないシチュかと思われますが宜しくお願いします…！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arufina_w/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4c2a5e1a/uploads/origins/cdc0db8c-346b-4afb-a5a5-ab77809e1d06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18cd716c7eed1476269f98d0fa4e38eb", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2888197, "client_id": 26729, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 35, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@arufina_w/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2888197, "client_id": 1520841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9813ccc7/uploads/origins/bbf8e7ab-a9a9-4917-ac4f-78ada520d9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeafaabd5372cbae489d7d7af79f8654", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9813ccc7/uploads/origins/bbf8e7ab-a9a9-4917-ac4f-78ada520d9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4304ec361238