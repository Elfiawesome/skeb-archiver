ールギャグのボールの色を白から赤に変更(歯を見せて描かれていたので歯の色との差別化のため)\n●差分で、シチュエーションに合った擬音や詩乃の喘ぎ声を付けていただく\n\nそれではまたご検討をよろしくお願い申し上げます", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@satoutoshio01/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8e065423/requests/63683_3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8d0fc18742c1042a83692afb32ecdf5f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 10845, "client_id": 115555, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 104517, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "棒の人@skeb募集中", "screen_name": "stickhuman", "avatar_url": "https://pbs.twimg.com/profile_images/1678401899257536513/W9SjkZWw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/191059422/1688996191/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "novel"}, {"genre": "correction"}], "nc": 177}, {"id": 123927, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "黒胡椒", "screen_name": "kurokosyou50", "avatar_url": "https://pbs.twimg.com/profile_images/1201549367569608704/R-dTMw5Q.png", "header_url": "https://pbs.twimg.com/profile_banners/915209088371277824/1572633179/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "novel"