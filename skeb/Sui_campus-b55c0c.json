ive/folders/1yXttoi61HYL_ThfF6Xvy101iqyy5q8qp", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 414611, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "飽画 飽子(Akie Akiko)", "screen_name": "AkiE_illust", "avatar_url": "https://pbs.twimg.com/profile_images/1926293174546223105/oF3sognf.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 2940059, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ちいず", "screen_name": "o3o_mv", "avatar_url": "https://pbs.twimg.com/profile_images/1708888832777895939/Nf1O-Gz2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1708878454907924480/1696265325/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 3560473, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Shisui", "screen_name": "Shisui880065", "avatar_url": "https://pbs.twimg.com/profile_images/2030968661431971841/fSnSOhm1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1776509014148632576/1779014893/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 129}, {"id": 3835812, "creator": true, "nsfw_acceptable": false, "acceptable": false, "n