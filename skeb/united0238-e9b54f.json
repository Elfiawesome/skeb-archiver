53a89442a5c5f99e9db06240ce630, https://si.imgix.net/0c14c7b7/uploads/origins/bcc519bc-6d93-4873-a0c9-65ede9e11e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62ad1e5e33a5073a80e66d35656f9195 2x, https://si.imgix.net/0c14c7b7/uploads/origins/bcc519bc-6d93-4873-a0c9-65ede9e11e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f2734340097e1897c1dae33c04e8742 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c14c7b7/uploads/origins/bcc519bc-6d93-4873-a0c9-65ede9e11e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f49a11cf9f6cd64e87c3214c7fbad16", "srcset": "https://si.imgix.net/0c14c7b7/uploads/origins/bcc519bc-6d93-4873-a0c9-65ede9e11e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f49a11cf9f6cd64e87c3214c7fbad16, https://si.imgix.net/0c14c7b7/uploads/origins/bcc519bc-6d93-4873-a0c9-65ede9e11e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9328a7819f71351ba1ed344d3ebf5ed2 2x, https://si.imgix.net/0c14c7b7/uploads/origins/bcc519bc-6d93-4873-a0c9-65ede9e11e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8440d06554d8ff646f9feb81b2fb6f05 3x"}, "body": "ユナイテッド様\n\nはじめまして！\n個人でVTuber活動をしております、森永ここあ と申します。\nユナイテッド様の丁寧で奥行きのある美しいイラストを拝見して、ぜひ私のイラストも描いていただきたいと思い依頼させていただきました！\n\n【依頼内容】\n・森永ここあ（私）のイラストをお願いいたします。\n・ウエディングをテーマとしたイラストを描いていただきたいです。\n・森永ここあ（私）は妖狐のキャラクターなのですが、狐といえば『狐の嫁入り』のように和装のイメージが強いと思うのですが、純白のウエディングドレスにも憧れがあるので今回は洋風のウエディングにしていただけると うれしいです！\n・サムネイル等にも使用させていただきたいので人物の上部と左右が見切れないもの、また可能でしたら背景と人物を分けたデータをいただけると幸いです。\n\n\n【自己紹介】\n名前：森永ここあ🦊🍫\nイチゴとココアが好きな銀色の二尾の妖狐。しっぽの数は2本。\n九尾の狐になるために人間界で修行中。\n本体は銀色の狐だが、人型に化けるときは人間界に馴染むように髪の毛をココア色にしている。\n好きな色は赤と緑。\n\n以下に参考資料を添付させていただきます。\nhttps://drive.google.com/drive/folders/1hcdBM2hfYgs7kag96u2faE0yGDPthMzc?usp=sharing\n\n紛らわしいポイントをピックアップさせていただきました。紛らわしくて申し訳ありません！\n・髪の毛はオレンジ味のかかった茶色\n・八重歯と髪飾りは左のみ\n・人耳はなく狐耳のみ\n・しっぽは二本(もっふもふにしていただきたいです)\n・しっぽと狐耳は銀色\n\n髪型などをテーマに沿ったものに変更していただいても うれしいです！\n\n\n【使用用途】\nXをはじめとするSNSへの投稿、サムネイルなどのYouTubeでの使用、ネットプリントやグッズに使用させていただく可能性があります。\n\n\nお忙しいと思いますが、ご検討いただけると幸いです。\nどうぞ、よろしくお願いいたします！！\n\nhttps://drive.google.com/drive/folders/1hcdBM2hfYgs7kag96u2faE0yGDPthMzc?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@united0238/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3594103, "client_id": 3595804, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6fe0fc6/uploads/origins/625d22d4-1627-4b16-a6a7-8fdb1bf388ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7894ec318fc424725033d8e035a349fc", "srcset": "https://si.imgix.net/d6fe0fc6/uploads/origins/625d22d4-1627-4b16-a6a7-8fdb1bf388ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7894ec318fc424725033d8e035a349fc, https://si.imgix.net/d6fe0fc6/uploads/origins/625d22d4-1627-4b16-a6a7-8fdb1bf388ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20cd7465a2a04718cb82edd49a865b18 2x, https://si.imgix.net/d6fe0fc6/uploads/origins/625d22d4-1627-4b16-a6a7-8fdb1bf388ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2cf67218ae062c5403c01945501f47c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6fe0fc6/uploads/origins/625d22d4-1627-4b16-a6a7-8fdb1bf388ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eed92ab41fe0faee257ec41f624a59df", "srcset": "https://si.imgix.net/d6fe0fc6/uploads/origins/625d22d4-1627-4b16-a6a7-8fdb1bf388ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eed92ab41fe0faee257ec41f624a59df, https://si.imgix.net/d6fe0fc6/upload