てくれるのか見てみたいです。\n もしファンタジーな衣装で描きたくないのであれば、他のアイデアも見てみたいです！\n\n舞台は紛争に悩まされるファンタジーの世界です。\n\n[シュウヘイ】は、過去の貴族生活に見切りをつけた、尊大で傲慢な男である。おちゃらけた感じで鼻につくのが好きだが、一人になると陰鬱な表情を見せる。\n傭兵団の臨時戦術家として旅をしている。\n\n[栞】無表情ですぐに照れてしまう少女で、軍事グループの私立探偵をしている。  幼い頃から自分のイメージを重視し、社交的な付き合いを避けてきた。\n現在は修平グループのスパイを任されている。\n\nいざとなれば、すべてを投げ打ってでも相手を助けようとする。\nhttps://drive.google.com/drive/folders/10FLPxoADB4cuthAVI29xu2h1dlUsWE-N?usp=sharing\n\nお時間とご配慮をありがとうございました！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@turu_0280/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2772520, "client_id": 2100, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/132108ca/uploads/origins/c4be3d9f-e286-460d-bd7e-10da57f89bc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8353da59fda1ad3759bc21ad535d0edd", "srcset": "https://si.imgix.net/132108ca/uploads/origins/c4be3d9f-e286-460d-bd7e-10da57f89bc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8353da59fda1ad3759bc21ad535d0edd, https://si.imgix.net/132108ca/uploads/origins/c4be3d9f-e286-460d-bd7e-10da57f89bc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a221880bb614d7db200b2eda189233c 2x, https://si.imgix.net/132108ca/uploads/origins/c4be3d9f-e286-460d-bd7e-10da57f89bc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=957d4f350aeaed32a0febff7a98163b8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/132108ca/uploads/origins/c4be3d9f-e286-460d-bd7e-10da57f89bc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a142783d6c36199628327ff1c551c5e", "srcset": "https://si.imgix.net/132108ca/uploads/origins/c4be3d9f-e286-460d-bd7e-10da57f89bc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a142783d6