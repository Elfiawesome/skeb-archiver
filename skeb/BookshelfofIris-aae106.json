U5t1fgqDy/view?usp=drivesdk", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BookshelfofIris/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 124537, "client_id": 3867081, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2daeddc6/uploads/origins/283ad40e-64d8-4bf2-9a3b-c9604930557d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cec549020ca583555c929d61ef8e739", "srcset": "https://si.imgix.net/2daeddc6/uploads/origins/283ad40e-64d8-4bf2-9a3b-c9604930557d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cec549020ca583555c929d61ef8e739, https://si.imgix.net/2daeddc6/uploads/origins/283ad40e-64d8-4bf2-9a3b-c9604930557d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5357962c6c15514c7dab9ea562dd34f4 2x, https://si.imgix.net/2daeddc6/uploads/origins/283ad40e-64d8-4bf2-9a3b-c9604930557d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3413926f6ad3a0d8a946ee4f5f2a63f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2daeddc6/uploads/origins/283ad40e-64d8-4bf2-9a3b-c9604930557d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24482a10cbc1436c44b226a4775a4e7a", "srcset": "https://si.imgix.net/2daeddc6/uploads/origins/283ad40e-64d8-4bf2-9a3b-c9604930557d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24482a10cbc1436c44b226a4775a4e7a, https://si.imgix.net/2daeddc6/uploads/origins/283ad40e-64d8-4bf2-9a3b-c9604930557d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0fc1412a4398ada31aa16ebc121c73b4 2x, https://si.imgix.net/2daeddc6/uploads/origins/283ad40e-64d8-4bf2-9a3b-c9604930557d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4f4120f1fc79a7235cbcc1273281b0fa 3x"}, "body": "司書 様\n\nはじめまして、個人で活動しているVtuberのぷにぷにだんごと申します。\n司書様のセクシーかつとても可愛いイラストに惹かれまして、\n是非イラスト制作をお願いしたいと思いリクエストさせていただきました。\n\n下記の内容でお引き受け可能かご検討いただきたく、お願い申し上げます。\n\n¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨\n\n【依頼内容】\n・人物\n　ぷにぷにだんご\n　特徴はあたまに目玉焼きが乗ってます…\n　\n・服装\n　参考として画像のＵＲＬを添付いたしますが、\n　司書様が描きやすい服装に変更していただいても構いません。\n\n・ 内容\n　🔽こちらのイラストの肩や首がとても好みでしたので、\n　リファレンスにしていただきたいです。\n　https://skeb.jp/@BookshelfofIris/works/8\n\n　構図や表情、ポーズはおまかせいたします。\n　可能であれば表情差分があると嬉しいです…！\n　\n\n・使用用途\n　twitch活動（サムネイルや動画、配信、アイコンヘッダー等）\n　X等SNS活動（投稿、アイコン、ヘッダー等）\n　ネットプリント\n　ファンコミュニティでの返礼品\nその他、未定ではありますがごく少数のグッズ化をさせていただく可能性が御座います。\n　\n・その他\n　サムネイルに使用したいので、頭や髪の毛が見切れないようお願いしたいです。\n　可能であればキャラと背景、サイン等のレイヤーを分けた、psdファイルもしくは\n　透過pngファイル形式でお願いいたします。\n\n以上です。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1VjvNxIA99PVedbVOwXOxVbMvdWV-Ae16?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BookshelfofIris/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3aeda1ae/uploads/origins/12972c1b-6809-46fa-bfab-ac45704cfe43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98d0709a0300aafc9484d745d21bb254", "srcset": "https://si.imgix.net/3aeda1ae/uploads/origins/12972c1b-6809-46fa-bfab-ac45704cfe43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98d0709a0300aafc9484d745d21bb254, https://si.imgix.net/3aeda1ae/uploads/origins/12972c1b-6809-46fa-bfab-ac45704cfe43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b03159951ba3129f9299031fc15ddbec 2x, https://si.imgix.net/3aeda1ae/uploads/origins/12972c1b-6809-46fa-bfab-ac45704cfe43?bg=%23fff&