4fcb-8389-390d4aaf0057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d5e0104b45e0fe0e6871c6859279462, https://si.imgix.net/1e1a4997/uploads/origins/cc79d70f-312b-4fcb-8389-390d4aaf0057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa675d60184697ea41e8e3945d543c25 2x, https://si.imgix.net/1e1a4997/uploads/origins/cc79d70f-312b-4fcb-8389-390d4aaf0057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cd465722ed8c203fc74973dd3b0afd57 3x"}, "body": "アピールありがとうございます！リクエストを送りますので、よければご検討ください。\n\n◯キャラクター\nロクサーヌ、セリー(異世界迷宮でハーレムを)\n※複数キャラNGであればロクサーヌのみでお願いします\n\n◯シチュエーション\nダンジョンで盗賊に敗北して連れ去られ、輪姦されて孕まされボテ腹になってしまったBADEND的なシチュエーションをお願いします。\n・ボテ腹状態で犯されている\n・ロクサーヌは精神的に壊れてしまい、レイプ目で涙を流しながらも悦んでいる様子\n・セリーもレイプ目で涙を流しており、犯されても無反応な様子\n・服装はおまかせ、肌露出多めを希望(全裸でもOK)\n・ロクサーヌのおっぱい、乳輪、乳首は大きめを希望(陥没乳首NG)", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuzzy0664/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 55036, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20a64f08/uploads/origins/ea9acf67-6293-4c7b-8e9d-c923d37c9ef0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f377d937f2dad114f4a6533986667c99", "srcset": "https://si.imgix.net/20a64f08/uploads/origins/ea9acf67-6293-4c7b-8e9d-c923d37c9ef0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f377d937f2dad114f4a6533986667c99, https://si.imgix.net/20a64f08/uploads/origins/ea9acf67-6293-4c7b-8e9d-c923d37c9ef0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6cfbeda1902553cb59022c9bd2dc0d1 2x, https://si.imgix.net/20a64f08/uploads/origins/ea9acf67-6293-4c7b-8e9d-c923d37c9ef0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f79e7730d99376185125914f1e2f987b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20a64f08/uploads/origins/ea9acf67-6293-4c7b-8e9d-c923d37c9ef0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dff71552e7a3dddfda6b875d906101b", "srcset": "https://si.imgix.net/20a64f08/uploads/origins/ea9acf67-6293-4c7b-8e9d-c923d37c9ef0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dff71552e7a3dddfda6b875d906101b, https://si.imgix.net/20a64f08/uploads/origins/ea9acf67-6293-4c7b-8e9d-c923d37c9ef0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=38850dcf62b5cbde3c117e7411b213b8 2x, https://si.imgix.net/20a64f08/uploads/origins/ea9acf67-6293-4c7b-8e9d-c923d37c9ef0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2d39241f70869087b2c2fabab292b4a7 3x"}, "body": "シャニマスで、片思いしてるPに襲われる月岡恋鐘を描いてもらえませんか？\n以下、お互いの心情です。（特にPの自己流解釈強めですすいません）\n\n【プロデューサー】\n事務所のアイドルからの好意に気づいてるが、Pとしての立場があるので道化を演じてはぐらかしている。また性欲もあるので、疲れている時等は彼女たちをついエロい目で見ることもある。\n恋鐘に関しては好かれすぎていること、エロい目で見られるのが嫌いなのを知っているので、特に気を使っている。\n【恋鐘】\n原作準拠。エッチについては普通のラブラブなやつじゃないと嫌、乱暴なのとか変態なのは絶対無理と思っている。\n\nシチュとしては「ばりうまかブルース」のコミュの続きifで、激務が続き、また深夜まで事務所に残っていたPの下に恋鐘が押しかけるも、二度目ということで少し口論になり、前回より疲れで気が立っていて、性欲も溜まっていたPがついに襲ってしまうという感じです。\n恋鐘の反応としては「こげん形で結ばれとうなか」みたいな感じで嫌がってください。\nあと着衣が好きなので裸じゃない方が嬉しいです。衣装とか脱げ具合はお好みで。\n普段の作風よりかなりハード目だと思いますが、ある程度マイルドにしていただいて結構です。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuzzy0664/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 55036, "client_id": 763017, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fda1f666/uploads/origins/9c4f60af-6a12-46cd-a14c-428ce70b615e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00fe7df08d7a629f1e9197fc190f32d5", "srcset": "https://si.imgix.net/fda1f666/uploads/origins/9c4f60af-