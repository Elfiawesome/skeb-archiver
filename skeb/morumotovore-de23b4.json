bp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e17f03bed1528bfbc7f3385827c3bbf 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c71a86c/uploads/origins/97bc6e66-51a0-43df-8c22-aaacf15c39f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36af2063dec34887141e625af3d5555f", "srcset": "https://si.imgix.net/9c71a86c/uploads/origins/97bc6e66-51a0-43df-8c22-aaacf15c39f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36af2063dec34887141e625af3d5555f, https://si.imgix.net/9c71a86c/uploads/origins/97bc6e66-51a0-43df-8c22-aaacf15c39f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=668587eac28f6a1308de77d790945915 2x, https://si.imgix.net/9c71a86c/uploads/origins/97bc6e66-51a0-43df-8c22-aaacf15c39f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8ab608be82571cf22850c0154324486c 3x"}, "body": "您好，我非常喜欢您的画风，希望可以委托关于游戏原神妮露的漫画\n角色名称：妮露角色来源：原神角色服装：演出服莎邦之息（这套服装本来就是光着脚的）vore生物：要确保角色有双手可以抱起Nilou\n大致剧情: Nilou今天被邀请上舞台表演，她并不知道这将是她最后一次演出。Nilou穿着演出服光着脚去舞台上跳舞，但她没意识到她并不是今天舞台上的主角，在光着脚跳完一曲后，突然从舞台后面走出了一只怪物，在Nilou还没反应过来时怪物已经在台下观众的欢呼中抱起了她，并把她送进了怪物自己的嘴里，最后Nilou无助的蜷缩在怪物的肚子里等待自己被消化，她的头饰是她留在这个世界上最后的东西。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@morumotovore/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 4018690, "client_id": 2603948, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/118648aa/uploads/origins/f44a5a2c-6246-45fe-9f2f-b80da0e81006?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=957f4f8e205086fbcfd1d25ac34b542b", "srcset": "https://si.imgix.net/118648aa/uploads/origins/f44a5a2c-6246-45fe-9f2f-b80da0e81006?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=957f4f8e205086fbcfd1d25ac34