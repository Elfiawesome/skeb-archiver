r=2&fit=crop&crop=top&w=200&h=200&s=6ad61d27ee1d54fefa80c79d855c38dc 2x, https://si.imgix.net/56cafa82/uploads/origins/5cc37aca-d697-49b5-b916-f8bda7bb4328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9f264522750053a22d4b2dd17f85faf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56cafa82/uploads/origins/5cc37aca-d697-49b5-b916-f8bda7bb4328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33b65d2a14e197e6dfeeaa315f90f5d6", "srcset": "https://si.imgix.net/56cafa82/uploads/origins/5cc37aca-d697-49b5-b916-f8bda7bb4328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33b65d2a14e197e6dfeeaa315f90f5d6, https://si.imgix.net/56cafa82/uploads/origins/5cc37aca-d697-49b5-b916-f8bda7bb4328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=419b0ba8e67c51c7c4e9c6d62eb82a47 2x, https://si.imgix.net/56cafa82/uploads/origins/5cc37aca-d697-49b5-b916-f8bda7bb4328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9beda5e9d1ab903b6b6730fc47f6ec9d 3x"}, "body": "こんにちは！\n前回のチャイナ服凛世ちゃんもとっても素晴らしい作品でしたのでまたまたリクエストをお願いしたいです!\n今回は巫女服風な衣装を着ている凛世ちゃんをお願いしたいです!\n\n●キャラクター\nラブアールの姫乃樹凛世\n\n●服装\nスカートタイプの巫女服\n前回のチャイナ服のように腰部分にスリットが入っており、直立しているだけで横からパンツが丸見え状態\nスカートの裾は長めを希望\n細かいデザインは描きやすいものでおまかせ\n腕の袖なども短かったり、ノースリーブタイプのものでも可\n\n●ポーズ①\n前回同様の直立\n腕は後ろに回してある\n\n●ポーズ②\nスカートを持ち上げてパンツを見せつけている\n\n●構図\n全身像ではなく、前回のような太ももから上を映した構図を希望\n\n●下着\nこちらも前回同様のお子様パンツ\n・赤いリボンが付いた白\n・子どもっぽいピンク色のフロントプリントパンツ\n\n●表情\n明るい笑顔\nキョトン顔\n恥ずかしそうな顔\nジト目でドヤ顔\n\n以上です!!\nまたどうかよろしくお願い致します！", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Suikablue/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1714980, "client_id": 317324, "vtt_url": null, "thumbnail_image_urls": {"src": "https://