dio.com/ja-jp/detail?id=1688907\n\n●ポーズ②\n前布部分を持ち上げてパンツを見せつけている\n\n●構図\n全身像ではなく、太ももから上を映したようなイメージ\n※参考\nhttps://skeb.jp/@gari_mayo/works/67\n\n●体格\n身長が低いムチロリ\n全体的に肉付きが良い\n\n●下着\n布面積が広くスジが浮き出ないお子様パンツ\n・赤いリボンが付いた白\n・子どもっぽい縞パン\n\n※可能であればこちらの作品のようなものを希望\nときめきメモリアルの如月未緒 | すいかPX #pixiv https://www.pixiv.net/artworks/135129554\n\n\n●表情\n明るい笑顔\nキョトン顔\nジト目でドヤ顔\nメ◯ガキのような二ヘラ顔\n\n以上です!\nまたよろしくお願いします!!", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Suikablue/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1714980, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91a222aa/uploads/origins/c0cd2d9c-b13b-4077-ad76-f8fd31edc961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f0c68a65288fa55d50e9d6ea3889fb3", "srcset": "https://si.imgix.net/91a222aa/uploads/origins/c0cd2d9c-b13b-4077-ad76-f8fd31edc961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f0c68a65288fa55d50e9d6ea3889fb3, https://si.imgix.net/91a222aa/uploads/origins/c0cd2d9c-b13b-4077-ad76-f8fd31edc961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6cca9bd84bf71b163170e65a828c7ad 2x, https://si.imgix.net/91a222aa/uploads/origins/c0cd2d9c-b13b-4077-ad76-f8fd31edc961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61883f2642442dbaa73c606b2b92f4eb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91a222aa/uploads/origins/c0cd2d9c-b13b-4077-ad76-f8fd31edc961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5ccdd9763cedd3f8926d52adb358bdd", "srcset": "https://si.imgix.net/91a222aa/uploads/origins/c0cd2d9c-b13b-4077-ad76-f8fd31edc961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5ccdd9763cedd3f8926d52adb358bdd, https://si.imgix.net/91a