ムネイルなどに使用しやすいように人物（上半身）が見切れないように描いていただけるとありがたいです。\n\nどうぞよろしくお願いします♡ご縁がありますように♡\n\nhttps://drive.google.com/drive/folders/1Z0oenXLDIhbI9VF2Yk_xGlwbvkMs6MSf?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kochitora_9/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3116893, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/316cf859/uploads/origins/6ce7d4c4-7534-42e3-a17e-2235a60acfe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2b5fc92f585761a024ef7f79a5efd8a", "srcset": "https://si.imgix.net/316cf859/uploads/origins/6ce7d4c4-7534-42e3-a17e-2235a60acfe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2b5fc92f585761a024ef7f79a5efd8a, https://si.imgix.net/316cf859/uploads/origins/6ce7d4c4-7534-42e3-a17e-2235a60acfe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6df1da5351cbd46a269128ace66241da 2x, https://si.imgix.net/316cf859/uploads/origins/6ce7d4c4-7534-42e3-a17e-2235a60acfe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d47503f44a9fb361018249ce68645004 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/316cf859/uploads/origins/6ce7d4c4-7534-42e3-a17e-2235a60acfe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab97b98f460d705769d3c18d737a1d6a", "srcset": "https://si.imgix.net/316cf859/uploads/origins/6ce7d4c4-7534-42e3-a17e-2235a60acfe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab97b98f460d705769d3c18d737a1d6a, https://si.imgix.net/316cf859/uploads/origins/6ce7d4c4-7534-42e3-a17e-2235a60acfe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5b778d6b475cb254d4484b0f3b3d1d4d 2x, https://si.imgix.net/316cf859/uploads/o