8e6e9dc5db2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=640c78ac0ec604de95f00734374ebaf8, https://si.imgix.net/dd6b01ca/uploads/origins/7931c6e9-873e-473f-9927-8e6e9dc5db2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d70d707f81941b79e05dc56bdde9cb52 2x, https://si.imgix.net/dd6b01ca/uploads/origins/7931c6e9-873e-473f-9927-8e6e9dc5db2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6959f39fa01febe37c76e629b4b707c3 3x"}, "body": "明石カーレーシング先生、こんにちは。先生の絵柄がとても好きで、ぜひ1980年代の北米を舞台にした私のOC二人をお願いしたいです。\n\n【キャラクター】\nA（黒髪／178cm・65kg）\n垂れ目、クマ、やや太い眉、大きめの口。左耳にゴールドのイヤーカフとピアス。強いくせ毛の乱れた巻き髪で、タトゥーあり。ゲーム好きの可愛い女の子。静かで率直、本能的な性格。ややがっしりした体格。\n\nB（茶髪／183cm・75kg）\n長いまつげ、三白眼、厚い唇、濃い眉、えくぼ、多めのほくろが特徴。ハイブランドが好きな綺麗な女の子。社交的でチャーミング、遊び心のある性格。がっしりした体格。\n\n二人とも20歳前後の幼なじみで、同じ大学のsororityに所属しています。裕福な家庭育ちで、少し傲慢で時々ばかっぽいところもありますが、とても仲の良い親友です。\n\n【シナリオ】\n二人のかっこいい姿、または可愛い姿が見られたら嬉しいです！表情や動きが生き生きしていると嬉しいです。\n\n髪型、ポーズ、表情などは先生のお好みで自由にアレンジしていただいて大丈夫です。可能であれば、Aの子犬もどこかに描いていただけると嬉しいです。\n全体的に、可愛くて青春らしい雰囲気を希望しています！\n\n金額に応じた範囲で、ご無理のないよう描いていただければ大丈夫です。難しい場合はキャンセルしていただいても問題ございません🙇‍♀️\n\nどうぞよろしくお願いいたします。\n\nhttps://imgur.com/a/BabSM9k", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ashi_kare/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 197578, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/638afa69/uploads/origins/607b7fe4-40a1-4109-a1be-c3fd0a338968?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a81b88fd7b8cf8dae3050d294836361", "srcset": "https://si.imgix.net/638afa69/uploads/origins/607b7fe4-40a1-4109-a1be-c3fd0a338968?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a81b88fd7b8cf8dae3050d294836361, https://si.imgix.net/638afa69/uploads/origins/607b7fe4-40a1-4109-a1be-c3fd0a338968?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=001ade5431bbe52b0aa302af510eb949 2x, https://si.imgix.net/638afa69/uploads/origins/607b7fe4-40a1-4109-a1be-c3fd0a338968?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41330d09c8bc89b75093fcd9928dc5f1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/638afa69/uploads/origins/607b7fe4-40a1-4109-a1be-c3fd0a338968?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc19375ee4c14f7518e8636643c279cd", "srcset": "https://si.imgix.net/638afa69/uploads/origins/607b7fe4-40a1-4109-a1be-c3fd0a338968?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc19375ee4c14f7518e8636643c279cd, https://si.imgix.net/638afa69/uploads/origins/607b7fe4-40a1-4109-a1be-c3fd0a338968?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=42f853ccd78da34e98765af3c24ce4b9 2x, https://si.imgix.net/638afa69/uploads/origins/607b7fe4-40a1-4109-a1be-c3fd0a338968?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a1447b560f56452bf702b9d9d43147bb 3x"}, "body": "明石カーレーシング先生\nこんにちは。いつも美しい作品を拝見しております。\n\n先生の描かれる線の美しさと、キャラクターの生き生きとした魅力にいつも惹かれています。\n\nもしよろしければ、私のオリジナルキャラクター（恋人同士の二人組です）のイラストを、先生の世界観で描いていただけたらとても嬉しいです。\n\n【キャラクター設定】\nお手数ですが、以下のリンク先の資料をご参照ください。外見や雰囲気がまとめてあります。\nhttps://www.dropbox.com/scl/fo/37pmvwgf8y53nbc53vdz6/ABt40mmGdSuSyN2qvDX_ir0?rlkey=pzo2n4wywonhaga51geysvr0i&st=jm6128gh&dl=0\n\n【重要なご依頼】\n二人の役割についてですが、黒髪のキャラクターが「攻め」、茶髪のキャラクターが「受け」と決まっております。この関係性だけはどうぞお間違いのないようお願い申し上げます。\n\n【構図・用途】\n・親密なツーショットを希望しています。構図やポーズ、表情などは先生のご自由な解釈にお任せします。\n・使用用途は個人でのコレクションです。\n・もしご予算にご不便があれば、お知らせくださいませ。\n\nお忙しいところ大変恐縮ですが、何卒よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ashi_kare/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 197578, "client_id": 293143, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1dd6248e/uploads/origins/0345b963-0f8c-4dbf-a252-439cbdc53c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57ce65879767ddc249ac6e14482056f8", "srcset": "https://si.imgix.net/1dd6248e/uploads/origins/0345b963-0f8c-4dbf-a252-439cbdc53c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57ce65879767ddc249ac6e14482056f8, https://si.imgix.net/1dd6248e/uploads/origins/0345b963-0f8c-4dbf-a252-439cbdc53c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f21ccfed86c176ccf3935a79eae965ed 2x, https://si.imgix.net/1dd6248e/uploads/origins/0345b963-0f8c-4dbf-a252-439cbdc53c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2fafc30dd8615e0d60e5f80796c931c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1dd6248e/uploads/origins/0345b963-0f8c-4dbf-a252-439cbdc53c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b64b1907653819b5ae50388a00307f5", "srcset": "https://si.imgix.net/1dd6248e/uploads/origins/0345b963-0f8c-4dbf-a252-439cbdc53c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b64b1907653819b5ae50388a00307f5, https://si.imgix.net/1dd6248e/uploads/origins/0345b963-0f8c-4dbf-a252-439cbdc53c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=660b2c84355ab41d7dc6c052289d5168 2x, https://si.imgix.net/1dd6248e/uploads/origins/0345b963-0f8c-4dbf-a252-439cbdc53c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1d206bb37a07e40bcf7b96d2dab918ec 3x"}, "body": "明石カーレーシング先生初めまして。先生のイラストの可愛くて人体を感じて元気が出る感じが素敵だと思い依頼させて頂きました。\n\n  今回依頼したいのは魔法や悪魔や吸血鬼やゾンビが存在する世界のロイヤルな4人の少年少女が冒険したり事件に巻き込まれたりイチャついたりするファンタジー小説っぽい雰囲気をイメージした創作のキャラクターです。\n\n4人からお好きなキャラクターもしくは組み合わせなどを選び(カップリング以外も大歓迎です。)、自由に描いて頂ければと思います。ちょっとエッチ(エロ絵ではなく、健康的なギャルみたいな、、)で元気が出る感じ、、、えちかわ肉食獣的な、、が嬉しいです。\n\nムロ　主人公。ネクロマンサーの少年。呪われた出自で、頭はあまり良くないが素直で努力家。人懐っこい。エヴァ(後述)の弟で、重度のシスコン。 半分悪魔であることが後々判明するが、周囲からは大型犬っぽいと思われている。アル(後述)にガチ恋。\n\nアル　人の心が読める捻くれた少年。神出鬼没で、破滅的な奇行を繰り返す。表面的には明るくお喋り。 ムロの従兄弟であり、友人であり、彼氏、、主人のような存在。霊感が強く幽霊の友達が多い。抵抗力が弱いのでたまに取り憑かれている。将来的にエクソシストを志すが、破戒僧。\n\nエヴァ　元人間のお姫様で、天才、国の宝。現吸血鬼。美少女然としたルックスで国民から天使と呼ばれているが、面白い事が好きで、面白くない人間に興味がない残酷な面がある。カイ(後述)に運命を感じており、この女と化石になると決めた。また重度のブラコンで、弟のムロを溺愛している。\n\nカイ　吸血鬼一族の末妹で、エヴァの結婚相手。尊大な性格で、すぐに調子に乗って痛い目を見る。エヴァにベタ惚れ。\n公表していないが先祖返りで、一般的な吸血鬼に比べて魔法の才能に乏しかったり身体的特徴(尻尾)がある事がコンプレックス。\n\nデフォルメ具合や雰囲気、衣装や年齢感は明石カーレーシング先生にお任せします。 描いて頂いたイラストは自分用に最小ロットにてグッズに使用する場合があります。販売など、商業利用はしません。\n   https://drive.google.com/drive/u/0/mobile/folders/1-J8L_bxJswG-xHZyVxbeLsr9zOO5GG1H?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ashi_kare/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0ec0c983/uploads/origins/f0bf08f8-11da-4d23-b343-fc06a8a49f72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ff2bfccd63df822f11548137e79a755", "srcset": "https://si.imgix.net/0ec0c983/uploads/origins/f0bf08f8-11da-4d23-b343-fc06a8a49f72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ff2bfccd63df822f11548137e79a755, https://si.imgix.net/0ec0c983/uploads/origins/f0bf08f8-11da-4d23-b343-fc06a8a49f72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dee56e7961fef98695f8d69a5a4c7178 2x, https://si.imgix.net/0ec0c983/uploads/origins/f0bf08f8-11da-4d23-b343-fc06a8a49f72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit