eceived_works": [{"path": "/@jito410/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3531970, "client_id": 954379, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9aacc89f/uploads/origins/1916354d-8fb8-4202-b073-31175926c20a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42ffb47afa0b05849b9c152603bae0cd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9aacc89f/uploads/origins/1916354d-8fb8-4202-b073-31175926c20a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5e669c00af87fdd7ef1713edde51fbb", "src_set": ""}, "body": "はじめまして。かわいいイラストに惹かれて、またジト目が好きなので是非と思いリクエストさせていただきます。\n\n以下、希望事項及び資料となります。\n---\n・自身のオリジナルキャラクターを描いて頂きたいです。資料は下部URLにて添付しております。\n\n・シチュエーションとしては「料理をしている」または「絵を描いている」を希望しますが、そのどちらでなくとも問題ありません。\n　その他の服装・構図・ポーズに関しては特に希望はありません、お任せします。\n\n・イラストについてはPSDなどの形式を希望します。困難な場合は画像形式でも問題ありません。\n　用途として、鑑賞用の他にDiscordなどのプライベートな場で友人に紹介することがあります。\n---\n\n以上、ご検討のほどよろしくお願いいたします。\n\nhttps://x.com/Suis0u/status/1894752707589902356", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jito410/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3531970, "client_id": 2387049, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff835de7/uploads/origins/0c6e59a2-7786-4945-a39d-9a2ec3d6f390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c98cba2709384f1629833223de175d1a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff835de7/uploads/origins/0c6e59a2-7786-4945-a39d-9a2ec3d6f390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca343b914cf8ae016d3961228d923685", "src_set": ""}, "body": "こんにちは、カノツメです。\nいつも可愛いジト目イラストに癒されています。\n\nもしよろしければ、ずんだもんと春日部つむぎちゃんが、秋っぽい雰囲気の中で紅葉を眺めるデートをしているイラストをお願いしたいです。\n\nお忙しいところ恐縮ですが、よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jito410/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3531970, "client_id": 953313, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ff5f3f4/uploads/origins/831dbb32-ff33-43ea-afa4-59cd6ea8f1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a2fc16f71586316b92dde48b703644d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ff5f3f4/uploads/origins/831dbb32-ff33-43ea-afa4-59cd6ea8f1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7a87d18ce9dad1997ae513f77b7e111", "src_set": ""}, "body": "わたしがVRなどで使っている小さいキツネっ子アバターのちびキャライラストを描いていただきたいです！\nジト目ながあも、明るく元気なイメージでお願いします！\n頭に付いているバッジの絵柄は省略しても構いません！\n\n使用用途は「SNSなどのアイコンやイメージなどに設定する」「VR内でのアイテムに入れてみんなに見せる」ことです！\n\nhttps://virtualcast.jp/items/ea94f99f6da1dcf523507cdd56f0ef17fca09a3fa8b027cd8b16aad2ff1ccd23\nhttps://ul.h3z.jp/jRI4gJW7.jpg\nhttps://ul.h3z.jp/MO9viGj6.png", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jito410/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3531970, "client_id": 174016, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d86b9230/uploads/origins/dafc77a0-1084-4883-8740-c847e274c702?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6be2788f2045ec0266a32221e2434df", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d86b9230/uploads/origins/dafc77a0-1084-4883-8740-c847e274c702?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97747f449ab8b589b86517ae77d97425", "src_set": ""}, "body": "初めまして。\n最近偶然可愛いイラストを拝見し、もちもちで可愛いジト目のイラストが素敵だと思い依頼をさせて頂きました。\n新参者ですので、お好みでない依頼となっていたら申し訳ありません。\nうちの子「三樹沙良」のイラストを依頼いたします。\n\n下記設定、依頼内容については、お値段と比較して受けて頂ける範囲で加味頂けるとありがたいです。\n\n【キャラ説明】\n・ジト目系、一部毛先に白髪の混ざった黒髪、黒目\n・10～13歳\n・ジト目真顔系、笑っても口元が緩むぐらいで目はジト目のまま。\n・屋台を見かけると両手いっぱいになるまで買い食いしたり、花火を持って走り回ったり、楽しいことに忠実な子。\n・見た目や年齢、頭身等は絵柄に合わせて頂いて構いません。\n・服装等は資料と同じでも、シチュエーションに合わせた格好やその他お洒落着等なんでも構いません。\n\n\n【依頼内容】\n・ポーズや背景、シチュエーション全てについて、何かアイデアや描きやすい姿などがあれば、それを優先して頂きたいです。\n・特になければ「コーヒーのドリップを眺めてその香りとぽたぽた溜まる様子を（わくわくしながら）眺めている」姿をお願いいたします。\n\n\n【その他】\n資料は複数あり、どれを参考しても問題ありませんが、迷った場合は「沙良立ち絵202505」か「ですの様作skeb依頼絵1.png」をご参照ください。\n\n\nよろしくお願い致します！\n\nhttps://www.dropbox.com/scl/fo/erayx1xbrwekt42msa5im/ALIFZ4FpPbKPLoKAxjs5rqw?rlkey=ekzsu2b0mggoqdnydknszswx5&st=fvkupwft&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jito410/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 3531970, "client_id": 2714064, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/784b0144/uploads/outputs/c7c81283-d3c9-4258-b06b-d857dd09ab07?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=36a93f3a6a804894e1f0206e52144bb3", "src_set": ""}, "duration": 4, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/784b0144/uploads/outputs/c7c81283-d3c9-4258-b06b-d857dd09ab07?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=efee0128568d2b59e10bf54e53e117f7", "src_set": ""}, "body": "こんにちは！Skebであなたの作品を見つけ、あなたのキュートな作風がとても気に入ったので、チビアニメーションをお願いしたいです！\n\nキャラクター\n東方鬼想剣のスノーコーディアです。\n\nリクエスト内容\n\nチビ（SD）アニメで、可愛く遊び心ある感じで描いてください。\n\nフレッシュなフルーツ（イチゴ、レモンなど）を入れてください。\n\n背景のロゴ（参考フォルダ参照）を追加し、キャラクターがその風船とインタラクションするようにしてください（風船を持ったり引っ張ったりするなど）。\n\n表情や動きはあなた次第です。自由に創造してください！\n\n彼女の衣装は、このデザインをベースにしてください：\n🔗 https://x.com/AobaHosino/status/1834547575996965249/photo/1\n→ 袖を短くして軽やかに。\n\n色の調整や装飾の追加など、細かいデザインも大歓迎です！\n\n背景はシンプルにして、キャラクターに焦点を当てましょう。\n\n参考資料\n参考URL\n\n使用方法\n個人利用（アイコン、閲覧）のみ、非営利。\n\nご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1qNobRUF53LRSHGt2fMlDU8-ZX19T8Tvc?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@jito410/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3531970, "client_id": 28724, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ffe6164/uploads/origins/24f31a18-19f8-4cd2-a7ed-75d468feb3fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=490ba8153e9fe945002bfd3fd4baa64e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ffe6164/uploads/origins/24f31a18-19f8-4cd2-a7ed-75d468feb3fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee3a008d5771afd82e9db58dd7922bc3", "src_set": ""}, "body": "初めまして！\n可愛らしいイラストを拝見し、是非にと思いリクエストさせて頂きます！\nご検討お願いします！\n\n◆概要\nTRPG『ソード・ワールド2.5』で使用している自PC、ナリアのイラストのリクエストです。\n\n◆構図・ポーズ\n特に指定無し\nキャラに合うようなものでお任せします。\n自由に描いて頂ければと思います。\n\n◆キャラクター\n12歳の人間の女の子\n身長130〜140cm程度\n表情薄めのやる気なさげ。アホ寄りのクール系\n見た目には子供だが、人並み以上の力持ち\n貧乏\n\n◆使用用途\nTwitter等SNSでの自慢、ディスコード等でのアイコンとして使用\n眺めて楽しみます\n\nTRPGで使用しているキャラシートを添付しますので、良ければ雰囲気参考程度にして頂ければと思います。\n他記載無い部分や不明点に関してはお任せします。\nよろしくお願いします！\n\nhttps://yutorize.2-d.jp/ytsheet/sw2.5/?id=jBIZqk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jito410/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3531970, "client_id": 1399247, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/260f6f62/uploads/origins/9c2ea2d1-1f06-4b21-99c2-103352f9bf4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b10917969520647520f3313ec4940ee2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/260f6f62/uploads/origins/9c2ea2d1-1f06-4b21-99c2-103352f9bf4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c438e64857d9a91389dcf28c45b3729a", "src_set": ""}, "body": "はじめまして！\nXでイラスト拝見して、とっても素敵だったのでリクエストいたします！\n\n●依頼\n猫屋敷クロを描いていただけると幸いです\nポーズや表情、背景などすべてお任せします！\n\n●参考画像(全身イラスト)\nhttps://drive.google.com/drive/folders/1XY6bvLzEihYDD9jy3954xHkLWfQjEF6U?usp=sharing\n\n●用途\nアイコンと動画のサムネイルに使用する予定です\n背景と分離できると嬉しいです！\n\nご検討のほどよろしくお願いいたします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jito410/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3531970, "client_id": 3117445, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47a60cba/uploads/origins/bf5ad7ea-d6fa-46b3-a9d3-682f7a216a5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4e56714bdccaf4202323cd73966833b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47a60cba/uploads/origins/bf5ad7ea-d6fa-46b3-a9d3-682f7a216a5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77c6342fdc209bab92c4e98d44a2f06d", "src_set": ""}, "body": "はじめまして。こんにちは。\nイラストの絵柄がとても好きで、ぜひリクエストをお願いしたくご連絡いたしました。\n4月のアニメ『MONO』に登場するジト目の敷島桜子ちゃんを描いていただきたいです。\n特に細かい指定はなく、できるだけ可愛らしく描いていただければ嬉しいです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jito410/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3531970, "client_id": 3622770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5780dbcb/uploads/origins/e425fc1b-bb5a-4c96-8ceb-f59d8abc6c54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c49a67e2715f93540b166103a35ce0c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5780dbcb/uploads/origins/e425fc1b-bb5a-4c96-8ceb-f59d8abc6c54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b3ed84998c1af832855061502733745", "src_set": ""}, "body": "はじめまして、みじんこと申します。\nジト目をすころうさんのイラストを拝見させて頂いて、単純に絵柄が好みなのと、ジト目が自分にとってささるのだと気付かされたので最近になってフォローさせていただきました。\nさて、リクエストのほどですが、サービス終了をして久しい最愛のゲーム、幻獣契約クリプトラクトというゲームの、「ディオネ」という子を描いて頂きたいのです。人生初の推しをジト目をすころうさんのジト目と絵柄で描いて欲しいのです。\n構図や背景に関してはおまかせしたいのですが、参考になるかもしれませんので書いておきますと、土星の子としてゲーム内で活躍しておりました。\n人生初のskebでの依頼のため資料不足、文章の稚拙さなど至らない点があるかと思いますが、ご検討よろしくお願いします。\n\n資料用のURL\nディオネちゃんのX公式での画像(全体像としてはおそらくこれが1番の画質だと思います。また、資料URLのものはこちらと同じです。)\nhttps://x.com/cryp_boi/status/828166203403153408?s=46\n\n幻獣契約クリプトラクトのゲーム(こちらでは表情などをストーリー上で確認できますが、下半分程が表示されていません。)\nhttps://apps.apple.com/jp/app/%E5%B9%BB%E7%8D%A3%E5%A5%91%E7%B4%84%E3%82%AF%E3%83%AA%E3%83%97%E3%83%88%E3%83%A9%E3%82%AF%E3%83%88/id931337752\n\nhttps://x.com/cryp_boi/status/828166203403153408?s=46", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jito410/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3531970, "client_id": 3178883, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7672938b/uploads/origins/667e4b89-0c41-4dd9-bf9a-27e385c8439b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48328c19b11ab3c8134f0f1d9e129b6c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7672938b/uploads/origins/667e4b89-0c41-4dd9-bf9a-27e385c8439b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6290eb42c52934948fd25347b57e742c", "src_set": ""}, "body": "初めまして。\nXで偶然お見かけした、ジト目をすころう先生の描くジト目がとても可愛らしく、是非推しのVtuberさんを描いていただきたいと思いご連絡いたしました！\nご検討の程お願い致します。\n\n<リクエスト>\nハコネクト所属のVtuber「翠森アトリ」さんをお願いします。\nポーズや髪型は先生のおすすめでお願いします。\nジト目でお願いします。\n\n<使用用途>\nFAとして「翠森アトリ」さんにプレゼントする予定ですので「翠森アトリ」さんの活動(SNSへの投稿や配信、動画への使用等)への使用許可をお願いいたします。\n<参考資料>\n参考資料として3面図等のリンクを記載します。\n\n・3面図等\nhttps://xfolio.jp/portfolio/haconectatori\n\n• YouTube\nhttps://youtube.com/@suimoriatori?si=3gPsV_AyWg9dPiRy\n\n・ハコネクト様の二次創作規約\nhttps://haconect.com/guideline\n\nhttps://xfolio.jp/portfolio/haconectatori", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jito410/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3531970, "client_id": 3561840, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9b42312/uploads/origins/146cd38d-3cd4-4c8d-857c-5da7320857df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c23fee5a7fc0fed3da6a2a147078e35", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9b42312/uploads/origins/146cd38d-3cd4-4c8d-857c-5da7320857df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf0cf246a111fbc6a94d87383df35dfa", "src_set": ""}, "body": "初めまして。\nつむぎちゃんの立ち絵、とても可愛かったです！\n今回、初めてSkebを利用し、ご依頼させていただきます。\n\n■希望のイラスト\nVOICEVOXのキャラクター「冥鳴ひまり」と「春日部つむぎ」の2人を描いていただきたいです。\n仲良しで“てぇてぇ”な雰囲気だと嬉しいです！\nアイコンにしやすい構図だと助かります！\n\n「モンスターハンター」のような雰囲気を取り入れていただけると嬉しいです！\n例えば、キャラクターの衣装をモンハン風の防具にしたり、狩猟武器（大剣・弓・双剣など）を持たせたり、ハンターっぽいポーズをつけたり…といった感じです。\nどの要素を取り入れるかはおまかせしますので、自由に描いていただければと思います！\n\nまた、アイコンにした際に見える位置に「ZERO」と入れていただけると嬉しいです。\nイニシャル（Zなど）のみでも構いません。\n目立つデザインでも、さりげないワンポイントでも、どちらでも大丈夫です！\nイラストの雰囲気を損ねそうであれば無理に入れなくても大丈夫です。\n\n■使用用途\n・YouTubeアイコン・ヘッダー・動画内素材\n・Xのアイコン・ヘッダー\n\n■その他\n・背景透過の人物のみのデータ(個別のものと2人一緒のもの)と、背景単体のデータを添付していただけると嬉しいです。（動画素材としても活用したいため）\n\nお引き受けいただけましたら、何卒よろしくお願いいたします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jito410/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3531970, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91fe0361/uploads/origins/0f1bf56e-6cb6-4e9f-9b40-4aac7d794e19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f77b160475976fb0664d398de89092c8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91fe0361/uploads/origins/0f1bf56e-6cb6-4e9f-9b40-4aac7d794e19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12a1ba3fc57d3413b00f770c75e5e9f3", "src_set": ""}, "body": "いつも楽しく拝見しております。ニコニコ動画にてほそぼそと動画を投稿しておりますもりなかちひろと申します。\nさて、ジト目をすころうさんが動画用立ち絵素材として公開してくださいました春日部つむぎちゃんなのですが、\nこちらに追加差分として『後ろ姿』を追加していただきたく、もちろんニコニコ静画を利用している皆さんも規約を遵守したうえで使用可能となる形式で公開していただきたく、ご相談にまいりました。\n\n前回送信した説明文内に重大な誤りを発見いたしましたので、再度別件としてリクエストさせていただきました。お手数をおかけいたしまして誠に申し訳ございません。どうぞよろしくご検討お願いいたします。\n\nhttps://seiga.nicovideo.jp/seiga/im11553879", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 2070555, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "柚梨きょう🍐", "screen_name": "yuzu09skm", "avatar_url": "https://pbs.twimg.com/profile_images/1611295946280927232/UXhCKd8u.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1242033203096866816/1736173882/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 129}, {"id": 2305127, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "maka☀️", "screen_name": "rakugaki0108", "avatar_