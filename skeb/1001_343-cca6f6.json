1-0241e074e264?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=96c73b3fe7bc78aba71d5c3e04fec999 3x"}, "body": "1001(momoi)様、初めまして。\n配信活動をしております、はるちぐさと申します。\n\nこの度、1001(momoi)様のイラストを拝見し、詰め込みイラストの可愛らしさや世界観がとても素敵で印象的だったため、ぜひ描いていただけたらと思いリクエストをお送りいたしました。\n\n使用用途は、\n・SNSへの投稿\n・配信活動内での使用\nを予定しております。\n\n参考資料を2点添付しておりますが、どちらをベースにしていただいても大丈夫です。\n\nイメージとしては、\n「ふんわりと微笑んでいる、お姉さんっぽい雰囲気」\nの人物を想定しております。\n\nそのほかの構図や、小物・モチーフの配置など細かな表現につきましては、1001(momoi)様の素敵な感性にお任せできれば嬉しいです。\n\nご機会がございましたら、ぜひご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Nq8KDXBZi-ZGa8Ol8qY8fTRW6lMfp5fk?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@1001_343/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/41ff6623/uploads/origins/e3026e28-ba81-4321-8fd6-34b3278cbd94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9d77c9c8263b161023752d5597d3d00", "srcset": "https://si.imgix.net/41ff6623/uploads/origins/e3026e28-ba81-4321-8fd6-34b3278cbd94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9d77c9c8263b161023752d5597d3d00, https://si.imgix.net/41ff6623/uploads/origins/e3026e28-ba81-4321-8fd6-34b3278cbd94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d87f7457bb72cbbaefcd79d35e147a37 2x, https://si.imgix.net/41ff6623/uploads/origins/e3026e28-ba81-4321-8fd6-34b3278cbd94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c8520da5999920f5c0cb94f5181e96a 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3922115, "client_id": 2407512, "nc": 1}, {"path": "/@1001_343/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3922115, "client_id": 2949700, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/799d9d2c/uploads/origins/d77405f7-b5e9-47b8-a47c-4720cee088db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=411b3f647065b638070a237066a251c0", "srcset": "https://si.imgix.net/799d9d2c/uploads/origins/d77405f7-b5e9-47b8-a47c-4720cee088db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=411b3f647065b638070a237066a251c0, https://si.imgix.net/799d9d2c/uploads/origins/d77405f7-b5e9-47b8-a47c-4720cee088db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81e7f4780019bb46f7ea526fe651e721 2x, https://si.imgix.net/799d9d2c/uploads/origins/d77405f7-b5e9-47b8-a47c-4720cee088db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95b3d99b94233e9458bccfefbefb2795 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/799d9d2c/uploads/origins/d77405f7-b5e9-47b8-a47c-4720cee088db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04ee9d6e7ec4e8e9e9994fc1dbbb7681", "srcset": "https://si.imgix.net/799d9d2c/uploads/origins/d77405f7-b5e9-47b8-a47c-4720cee088db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04ee9d6e7ec4e8e9e9994fc1dbbb7681, https://si.imgix.net/799d9d2c/uploads/origins/d77405f7-b5e9-47b8-a47c-4720cee088db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23513542a85b045015cc2f1339814ded 2x, https://si.imgix.net/799d9d2c/uploads/origins/d77405f7-b5e9-47b8-a47c-4720cee088db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=70aaac62389ea4510be439a03f69d654 3x"}, "body": "1001(momoi)様\n\n初めまして。 イラストをX(旧Twitter)にて拝見し、1001(momoi)様の描かれるOCやTRPGのPCの子が大変好みだった為リクエストを送らせていただきました。 もしご縁がありましたら私のOCの衣装デザインをしていただけないでしょうか？  \n\nリクエスト内容▼\n資料にある女性の衣装デザインをしていただきたいです。金額内で可能でしたら詰め込みイラストだと嬉しいです。\n季節想定は春/秋服。スポーティーな服装でレースやフリルのある可愛らしい要素が少しあると嬉しいです。ショートパンツなどズボンを履くことが多いので短めのスカート(中にスパッツを履いている)だと命が助かります。\nヘアアクセにつきましては、1001(momoi)様の自由に描いていただきたいです。ピアスは必須だと嬉しいです。靴はショートブーツ(少しヒールのある靴)でお願いします。色のイメージといたしましては、今までの洋服が黒メインなのでグレー(少し明るめ)にイメージカラーでもある暗めのグリーンだと嬉しいです。\n髪型に関しましては、デフォルトの髪型やアレンジ等(低めのポニーテールなど)好きに描いていただきたいです。イラストは背景がある場合は透過の方もいただけると大変助かります。   \n\nOC詳細▼\n27歳/女性/169cm(厚底含め172cm)/ フリーター イメージ絵文字┊︎🐺🚬 モチーフ┊︎狼(一匹狼)、翡翠色、タバコ  一人称:あたし 二人称:あんた 見た目┊︎右目の下ににホクロがある。長めのウルフカット(資料の服ver.3のような後ろ髪のボリュームは少なめ)。胸はCカップ。髪の毛先にグリーンのグラデーション。インテークなし。\n性格︎┊︎面倒見が良いタバコ(電子タバコ派)と酒が大好きな女性。見た目に反してかわいいものが好きだが、好きなことを必死に隠している。しかし周りにはバレている。 スカートが苦手ではあるがかわいいものに憧れがある為最近は履こうと努力している。\n\n使用用途▼\nSNS上の掲載とアイコン使用・他依頼等への参考画像使用・個人鑑賞用・個人間のグッズ制作(完全個人用です)\n\n金額が厳しければ再送やキャンセルしてください。 お忙しい中申し訳ございませんが、ご検討のほど宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1bbpPUDx-EaE68PtlRzSsadU--R2CfUtq?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 367187, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぺろっぱふ🎨", "screen_name": "Meowstic__", "avatar_url": "https://pbs.twimg.com/profile_images/1735875448226373632/LqAcfnUM.png", "header_url": null, "appeal_receivable": true, "popular_creator_rank": 79, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 161}, {"id": 934033, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "マコトウ", "screen_name": "mako_makotoo", "avatar_url": "https://pbs.twimg.com/profile_images/1704475610133958656/GZzgY-Yj.jpg", "header_url": "https://pbs.twimg.com/profile_banne