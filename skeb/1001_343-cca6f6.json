が大好きです。\n合うモチーフは海外っぽい玩具、風船、トランプ、煙草など。\n\n❚使用用途\n個人観賞用、SNSでの使用、個人用グッズへの使用（×販売）\n\n\n構図、服装は絆創膏様のお好きなように描いていただければと思います。\n金額に不備がございましたら再送して頂けますと幸いです。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1uzamNFGf0dUbQf1vL2BCFG3coyVpa6Rl?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oeee9th/works/218", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3357568, "client_id": 3922115, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb8dcc9a/uploads/origins/eeb864ba-42de-4adb-afa6-9b75984c1c75?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=0de31995aa3c4a50817812da3c9e7bfe", "srcset": "https://si.imgix.net/fb8dcc9a/uploads/origins/eeb864ba-42de-4adb-afa6-9b75984c1c75?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=0de31995aa3c4a50817812da3c9e7bfe, https://si.imgix.net/fb8dcc9a/uploads/origins/eeb864ba-42de-4adb-afa6-9b75984c1c75?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8ae6d01505a01cd8707ae7d64ffc90a 2x, https://si.imgix.net/fb8dcc9a/uploads/origins/eeb864ba-42de-4adb-afa6-9b75984c1c75?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcb845a6952c1bd3c97f392d3fc7f325 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb8dcc9a/uploads/origins/eeb864ba-42de-4adb-afa6-9b75984c1c75?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=6d04ffbd75e55e5f77ffe2af92774c3a", "srcset": "https://si.imgix.net/fb8dcc9a/uploads/origins/eeb864ba-42de-4adb-afa6-9b75984c1c75?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=6d04ffbd75e55e5f77ffe2af92774c3a, https://si.imgix.net/fb8dcc9a/uploads/origins/eeb864ba-42de-4adb-afa6-9b75984c1c75?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b3b008cba05cc165a74f27ec00f67af2 2x, h