60cm／年齢：20歳  \n真面目でしっかり者の女の子です。理性的で、危険な状況でもできるだけ冷静に考えて行動しようとします。根は優しく世話焼きで、ツッコミ役になることも多いです。恋愛にはやや鈍感で、感情よりもまず現実的なことを考えてしまうタイプです。  \n異世界転移のお話です。蛇獣人と番になった影響で異化しており、瞳孔は蛇のような縦長です。髪型はぱっつん前髪の一つ結びです。\n\n使用目的として、小説投稿アプリ、SNS、個人鑑賞を予定しています。\nポーズや構図はお任せいたします。もし金額が不足していましたら、再送していただけますと幸いです。\nご検討いただけますと幸いです。\n\nhttps://drive.google.com/file/d/1T-eq2un3tYywlAOgCdBrsJMGzb2Aaf2_/view?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@byo_sec2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4053580, "client_id": 3396404, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7de2cae2/uploads/origins/a86007d8-a949-4fe8-b0a9-e147815d9fab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f83eb807d24cf35b1c6366b47f6c5a1c", "srcset": "https://si.imgix.net/7de2cae2/uploads/origins/a86007d8-a949-4fe8-b0a9-e147815d9fab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f83eb807d24cf35b1c6366b47f6c5a1c, https://si.imgix.net/7de2cae2/uploads/origins/a86007d8-a949-4fe8-b0a9-e147815d9fab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fcf018395a04a134d4e398bd2f3933fa 2x, https://si.imgix.net/7de2cae2/uploads/origins/a86007d8-a949-4fe8-b0a9-e147815d9fab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b54fdc6ed152de28893f433ad08c609f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7de2cae2/uploads/origins/a86007d8-a949-4fe8-b0a9-e147815d9fab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d54eb68e4a16ae9e34c3ec25f1aba699", "srcset": "https://si.imgix.net/7de2cae2/uploads/origins/a86007d8-a949-4fe8-b0a9-e147815d9fab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d54eb68e4a16ae9e34c3ec25f1aba699, https://si.i