a8dU0IR\n\n◆内容\n人物設定の新衣装でお願いします。\n要素参考：光と闇。白いチューリップと黒いユリ。太陽と月。\n\n新衣装の時間線で二人の関係性：\n女は王宮に軟禁されている。男が自分を心から愛していることに気づいた。彼を殺しても彼に苦痛を与えることはできない。男には複雑な感情を抱いている。\n男は女を深く愛しています。彼女を宝物として扱う。自分の愛のために、非常に恐ろしい計画を実行することにした。\n\n記載がない点は自由に描いていただいて構いません。\nよろしくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@311tarou/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1172766, "client_id": 667554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/970fe8c7/uploads/origins/133b8a8c-072d-4cc1-92ae-ae339af69eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80c5c3bb43068a2d57fa1931fb4ed722", "srcset": "https://si.imgix.net/970fe8c7/uploads/origins/133b8a8c-072d-4cc1-92ae-ae339af69eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80c5c3bb43068a2d57fa1931fb4ed722, https://si.imgix.net/970fe8c7/uploads/origins/133b8a8c-072d-4cc1-92ae-ae339af69eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b679cf5f9a78232c571caefcd1b75fc 2x, https://si.imgix.net/970fe8c7/uploads/origins/133b8a8c-072d-4cc1-92ae-ae339af69eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5aa2f2784b0eeb3c707b3409dc84a448 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/970fe8c7/uploads/origins/133b8a8c-072d-4cc1-92ae-ae339af69eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a249866cc902ad276ab3f65cb7789603", "srcset": "https://si.imgix.net/970fe8c7/uploads/origins/133b8a8c-072d-4cc1-92ae-ae339af69eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a249866cc902ad276ab3f65cb7789603, https://si.imgix.net/970fe8c7/uploads/origins/133b8a8c-072d-4cc1-92ae-ae339af69eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=t