82-42e6-b27e-a61d0d8332f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe0b31f89fe5f4e4dc2e82ed3dfaf8aa", "srcset": "https://si.imgix.net/153ecca5/uploads/origins/615e14c5-0d82-42e6-b27e-a61d0d8332f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe0b31f89fe5f4e4dc2e82ed3dfaf8aa, https://si.imgix.net/153ecca5/uploads/origins/615e14c5-0d82-42e6-b27e-a61d0d8332f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=189fa769131c457f15f9aef370f45f33 2x, https://si.imgix.net/153ecca5/uploads/origins/615e14c5-0d82-42e6-b27e-a61d0d8332f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2a3ea7b9fb64ef43804f17f9eeed661a 3x"}, "body": "こんにちは。お世話になります。ショートヘアのつるぺたな消学生の女の子がスーパー銭湯の男湯に性別を偽って入泉して(男湯の女の子)、シャワー・洗面台の前で膝立ちになって同伴の男の中指をソーププレイのように膣内に挿入させている(壺洗い)ところをお願いします。\n\nスーパー銭湯の制度\n入館時に60分/90分コースかフリータイムか申告し、退館時に精算する。\n身長120cmを超えた者の混浴はできない。\n\n女の子\nJS:女子消学生\n服装：全裸\n髪：ショートヘア\n肌：日焼けしてない色白、\n体つき：身長130cm台、胸はまだ膨らんでいなく真っ平、陰毛はまだ生えてない、ヒップなど体のくびれがほぼない\n目つき：垂れ目\n表情：眉毛はハの字、ウインク、口は開く、恥ずかしそうに赤面\n身長が120cmを超えているために本来は男湯に入泉できないので性別を偽った\n壺洗いしてもらうのは同伴の男で手腕のみの描写とする\n男の右腕にロッカーの鍵のバンド(輪っか)がはめられている\nバンド(帯)は電話機の受話器のカールコードのようなもの\n姿勢など\n膝立ち(女の子は椅子に座らない)、両膝は肩幅くらい開く、両足首側は更に外側に広げる\n※女の子の身体が画像からはみ出ないようお願いします。\nプレイ：手マン・壺洗い\n手前から男の右腕(ロッカーの鍵のバンドあり)が出る\n女の子の両手は男の右手首をつかむ\n男の右手中指を女の子の膣内に挿入する\nアングル:女の子を真正面から向き合う。\n背面はスーパー銭湯のシャワーや洗面台：身体を洗う場所\n\n以上よろしくお願いします。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@awahime_studio/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3808483, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/39ebc343/uploads/origins/cf2fa041-ec94-4115-87c8-5b111a81c1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b02ac5f294b69fc5d94ef5d409cf4f9", "srcset": "https://si.imgix.net/39ebc343/uploads/origins/cf2fa041-ec94-4115-87c8-5b111a81c1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b02ac5f294b69fc5d94ef5d409cf4f9, https://si.imgix.net/39ebc343/uploads/origins/cf2fa041-ec94-4115-87c8-5b111a81c1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d995e7f7ecd40786831a61151b41cc12 2x, https://si.imgix.net/39ebc343/uploads/origins/cf2fa041-ec94-4115-87c8-5b111a81c1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19bcfb40ecf1181db72b61fef9db0df5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/39ebc343/uploads/origins/cf2fa041-ec94-4115-87c8-5b111a81c1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96d3c412e6b8bf6e7fd954441c588f71", "srcset": "https://si.imgix.net/39ebc343/uploads/origins/cf2fa041-ec94-4115-87c8-5b111a81c1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96d3c412e6b8bf6e7fd954441c588f71, https://si.imgix.net/39ebc343/uploads/origins/cf2fa041-ec94-4115-87c8-5b111a81c1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ddcb14c3cf65d55f787578e3ad094500 2x, https://si.imgix.net/39ebc343/uploads/origins/cf2fa041-ec94-4115-87c8-5b111a81c1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8ae33c8f9f4a7b6f4648f6712c2856a8 3x"}, "body": "先日はありがとうございました。\nまた、リクエストをお送りさせて頂きます。\nこちらと\nhttps://skeb.jp/@awahime_studio/works/7\n同じ世界線で指名されなかった罰を受けている、音霊魂子 栗駒こまる 春雨麗女の三人をお願いします。(栗駒こまるさんは金額的可能でしたらお願いします)\n\n服装\n三人とも白いスク水\n\n手の拘束https://skeb.jp/@awahime_studio/works/7と同じ+手を使えない様にカバー\n\n拘束方法\n立っている状態で頭だけ出して透明なケースに入れられている\n\n前回と同じで差分のお願いになりますが、金額が価しないのでしたら見ずともOKです。(栗駒こまるさんより差分の方を優先する形でお願いします)\n\n1ケースに媚薬を入れられる前で三人ともにらみつけている\n2腰丈くらいまで媚薬を入れられかなり発情しながらもにらんでいる(音霊魂子は睨まずに股に手を伸ばそうとして胸が引っ張られている)\n3胸元まで媚薬を入れられ全員困り眉で発情しどうにか股をいじろうとしている。\n4首元まで媚薬を入れられ口にディルドを挿入されている(性欲を発散は出来てなくどうにか股を触ろうとしている)\n\nかなり長くなってしまいましたがよろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@awahime_studio/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3808483, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/593076c3/uploads/origins/f3278606-3a5d-4621-a610-53c8c0085374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c3da11df48f00faf4aaafb6daf1bf42", "srcset": "https://si.imgix.net/593076c3/uploads/origins/f3278606-3a5d-4621-a610-53c8c0085374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c3da11df48f00faf4aaafb6daf1bf42, https://si.imgix.net/593076c3/uploads/origins/f3278606-3a5d-4621-a610-53c8c0085374?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=588faa114b9dd8e1abfa119ada7d6e16 2x, https://si.imgix.net/593076c3/uploads/origins/f3278606-3a5d-4621-a610-53c8c0085374?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56dc4b2f882317e10fd47fdf1fcdd956 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/593076c3/uploads/origins/f3278606-3a5d-4621-a610-53c8c0085374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe319f2d805e45f5eac7861abd8b4ea1", "srcset": "https://si.imgix.net/593076c3/uploads/origins/f3278606-3a5d-4621-a610-53c8c0085374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe319f2d805e45f5eac7861abd8b4ea1, https://si.imgix.net/593076c3/uploads/origins/f3278606-3a5d-4621-a610-53c8c0085374?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe7fb0574f62e28e1ac1ca33f0befa09 2x, https://si.imgix.net/593076c3/uploads/origins/f3278606-3a5d-4621-a610-53c8c0085374?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4a6779760f379fde473059f996a1de63 3x"}, "body": "初めまして。\n絵柄がとても好みでしたのでリクエストをお送りさせて頂きます。\n周防パトラの風俗堕ちシチュをお願いします。\nもし二次創作を受けていられなければ作者様の好きなキャラクターにてお願いします。\n\n細かい設定として\nhttps://www.youtube.com/shorts/-cCGM8sdjh4\nの髪型をそのままで、服装が腰しか隠せない丈のスカートと胸が出ているインナーと金属で溶接されている首輪のみでお願いします。\n\n首輪からは前後にリードが伸びていて、エロ蹲踞で乗せられているシビアンに繋がって立てなくされている。\n乳首は左右の乳首と手首がくっつく様にピアスと手錠で拘束されている。\nhttps://x.com/koyatofu3/status/2001258491537998011?s=20\nこの画像のさらにチェーンが短い状態\n\n上記の状態で快楽を我慢しつつ無理やり笑顔を作っている表情で言葉が途切れ途切れになりながら\n「パトラをご指名頂きありがとうございます」\n「NG無し2日間パトラがご奉仕させて頂きます」\nのセリフをお願いします。\n\n差分もお願いしたいのですが金額的に不可でしたら下記はご覧になられなくとも良いです。\n1上記の状態\n2説明後に絶頂\n3絶頂後にシビアンが強くなり謝りながら再度絶頂", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@awahime_studio/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3808483, "client_id": 2668955, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/783c8870/uploads/origins/d1ddb42c-9fe0-4e71-9d79-186a85c72bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad8b6c74d90c61d90b35f66d61e6eeda", "srcset": "https://si.imgix.net/783c8870/uploads/origins/d1ddb42c-9fe0-4e71-9d79-186a85c72bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad8b6c74d90c61d90b35f66d61e6eeda, https://si.imgix.net/783c8870/uploads/origins/d1ddb42c-9fe0-4e71-9d79-186a85c72bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e15db180994eebcee28dc0e14cea947c 2x, https://si.imgix.net/783c8870/uploads/origins/d1ddb42c-9fe0-4e71-9d79-186a85c72bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba0cb05029352e7727f657d6e198e16d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/783c8870/uploads/origins/d1ddb42c-9fe0-4e71-9d79-186a85c72bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8515b4ddc625a7647f009fe883d406ab", "srcset": "https://si.imgix.net/783c8870/uploads/origins/d1ddb42c-9fe0-4e71-9d79-186a85c72bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8515b4ddc625a7647f009fe883d406ab, https://si.imgix.net/783c8870/uploads/origins/d1ddb42c-9fe0-4e71-9d79-186a85c72bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e341f685f28c0509845afb852e31928 2x, https://si.imgix.net/783c8870/uploads/origins/d1ddb42c-9fe0-4e71-9d79-186a85c72bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=42d941ed47f86f12719da4e01611780e 3x"}, "body": "こんにちは。こんな妄想風俗物が見たいです。セクシー巨乳美女の風俗嬢が拘束夜這いイメクラヘルスの独房のようなプレイルームで裸にされ両腕を鎖に繋がれて膝立ちの姿勢を強いられ、ガシガシ指入れ:手マンされているイラストをお願いします。\n※美女が拷問されてるみたいに映るが夜這いであってSMでないので嬢にむち打ちとか殴打などはしてはならない\n\n風俗嬢\n服装：全裸\n髪：こげ茶色の胸の高さくらいまで伸びた長い髪\n体つき：巨乳(Gカップ以上)\n陰毛あり\n殴打とか傷跡はない\n\n背景:鎖手錠(鉄枷)が壁から吊り下がった薄暗い独房のようなプレイルーム\n壁は黒に近いグレー。 \n左右の幅は2ｍくらい\n嬢のそばにバイブや電マや懐中電灯が置かれている。(※SMでないので鞭など殴打するものはない)\n\n嬢の姿勢\n両腕:手首は頭より高い位置に壁から吊り下がった鎖手錠をはめられてバンザイのように強いられる。両手の指はグーッと握らず外向きでダランとする。\n両足:膝立ち(膝から下は床に接触する)。左右の膝～足首はそれぞれ50cmぐらい離す。足の甲は床に接触する。足首あたりに床の金具で固定される。\n膝から上の胴体は垂直になるようにする(前後に傾かない)。\n\nプレイ\n指入れ／手マン\n責め役の客の人差し指と中指を美女の膣内にガシガシ突っ込む\n膣から汁が滴る\nこのとき客の手は手のひらをこちらに向けるようにする。\n嬢は「イクーイクー♡」とあえいでいる。\n\nアングル:拘束されて膝立ちの姿勢を強いられた嬢に真っ正面から向き合う(両腕と両足ははみ出さないようお願いします)。左右に壁が見えるようお願いします。\n\n補足図\nhttps://hstorage.io/dl/20240627064457_6d634d55.jpg\n\n\n以上よろしくお願いします。\n\nhttps://hstorage.io/dl/20240627064457_6d634d55.jpg", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@awahime_studio/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/78b52fcc/uploads/origins/284137f0-6611-4890-8c65-c655163f8015?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50b26ae1ab2266354fb72cd1129699a2", "srcset": "https: