で瞳孔の中心は少し赤い、顔つきは少し不愛想\n　服装はシンプルにシャツとスラックス\n　該当シーンでも資料のような表情でした\n\nサイズ：\nお手数おかけして申し訳ないのですが、下記二種でお願いしたいです。\n1. シナリオ中の例の写真としての縦向き\n2. 個人利用の範囲でPCの壁紙等に使用したいため、16:9か4:3の横向き\n\n備考：\n細かい部分に関しては惑星コーティ様の描きやすいように描いていただいて構いません！\n『GoodMorning ALL』というシナリオの継続探索者です。\nご依頼にあたり、PLさまからは資料として立ち絵の共有は許可を得ています。\n──────────\n\nSkeb依頼に関して不慣れなため、\nお手数おかけして申し訳ないのですが、何か不都合等ございましたら再送していただけますと幸いです。\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/136eEaR5TJ9aEA2kfw3nUGPo5mkCI2cCd?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@planet_coati/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2872698, "client_id": 3367950, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/49643348/uploads/origins/f271e641-52ac-42f5-85af-8e8f5b8958ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a141b99e01309adebd46362b455ea676", "srcset": "https://si.imgix.net/49643348/uploads/origins/f271e641-52ac-42f5-85af-8e8f5b8958ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a141b99e01309adebd46362b455ea676, https://si.imgix.net/49643348/uploads/origins/f271e641-52ac-42f5-85af-8e8f5b8958ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e389f2178633b6dd05724841aa09f80 2x, https://si.imgix.net/49643348/uploads/origins/f271e641-52ac-42f5-85af-8e8f5b8958ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=285f4c72a1385eb313c4ac7b27c11c48 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/49643348/uploads/origins/f271e641-52ac-42f5-85af-8e8f5b8958ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d44a2a53b2834fae0ecc72975fb9c999", "srcset": "https://si.imgix.net/49643348/uploads/origins/f271e641-52ac-42f5-85af-8e8f5b8958ed?bg=%23fff&auto=format%2Ccompress