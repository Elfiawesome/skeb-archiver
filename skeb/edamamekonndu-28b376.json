品でも嬉しいです。大切なのは、描くことを楽しんでいただくこと。ぜひ楽しんで描いてくださいね！ d(^▽^)\n\nご検討いただきありがとうございます！\n\nhttps://toyhou.se/Feffie/characters", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 22789, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "蒼烏ぷんこ", "screen_name": "aokarasu2626", "avatar_url": "https://pbs.twimg.com/profile_images/1418250326222675973/URwO79R7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/538240381/1635693537/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1233614, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "🌺じゅんこ🌴BOOTH通販🏖", "screen_name": "junko__105__", "avatar_url": "https://pbs.twimg.com/profile_images/1980050951470710784/Ty9b0OLj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1106819800590766080/1662358395/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 2017661, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "セリザワ4%(2)", "screen_name": "0u0_mgmgtime", "avatar_url": "https://pbs.twimg.com/profile_images/1647393638614437888/RPsZXMzy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1521119675358228482/1781015054/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}]