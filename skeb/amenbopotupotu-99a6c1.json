礼儀正しいノンバイナリー植物の女の子で、緑色の髪、黄色の目、陽気な笑顔、頭のてっぺんにはアロエベラの耳があります。趣味はガーデニングとソフトウェア開発。\n\n彼女の頭の大きさに対する耳の大きさはとても重要なので注意してください。\n\nこれが私の参考シートです： https://files.catbox.moe/psgnur.png\n\nあなたの決断に満足します。ポーズやディテールは完全にあなた次第です。\n自由に創造してください！\n\nもっとインスピレーションを得るために私のストリームを見たい方は、こちらが私のTwitchです：\nhttps://www.twitch.tv/hexadigital\n\nソーシャルメディアやストリームで使いたい。\n\nよろしくお願いします！\n\nhttps://files.catbox.moe/psgnur.png", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amenbopotupotu/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3687329, "client_id": 1376497, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ab4f312/uploads/origins/a3164b3f-d938-450a-b4c5-63768b6c9279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=683441ae9e604c340d46f2aa4824cfbb", "srcset": "https://si.imgix.net/8ab4f312/uploads/origins/a3164b3f-d938-450a-b4c5-63768b6c9279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=683441ae9e604c340d46f2aa4824cfbb, https://si.imgix.net/8ab4f312/uploads/origins/a3164b3f-d938-450a-b4c5-63768b6c9279?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2263a909e2b5f30ca7dca7af193fe05f 2x, https://si.imgix.net/8ab4f312/uploads/origins/a3164b3f-d938-450a-b4c5-63768b6c9279?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e5b68570b788be3d607d684554ab4fd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ab4f312/uploads/origins/a3164b3f-d938-450a-b4c5-63768b6c9279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c50d75442ec8bd8be0f964566dec40c0", "srcset": "https://si.imgix.net/8ab4f312/uploads/origins/a3164b3f-d938-450a-b4c5-63768b6c9279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c50d75442ec8bd8be0f964566dec40c0, http