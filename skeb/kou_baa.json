f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46d2ebec596afe8c9e5559e51270bbb1", "src_set": ""}, "body": "こんにちは！あなたの絵が大好きで、私の大好きなVTuberのNeppienep (https://x.com/neppie_nep)を描いてほしいです！彼女はシャイでハッピーな変人で、世界で一番優しくて思いやりがあるんだけど、ダークサイドも持っているんだ！ひまわりとうさぎが大好き！彼女を好きなように描いてください！\n\n使用方法としては、彼女と共有し、彼女のストリーミング/VTuber活動に関連して、X/Twitch/Youtube/SNSなどのサイトに投稿・使用させたいと思います。その際、用途に合わせてトリミングや回転などの加工をする場合があります。\n\nご検討のほど、よろしくお願いいたします！ᐢ _ ıᐢ₎ ♡ᐢ\n\nhttps://icedrive.net/s/6f9XygxVP8i77tB9b6iV7QtY4Dhu", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kou_baa/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 269249, "client_id": 2361019, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3f68db5/uploads/origins/0da54d0c-72cb-437d-ba22-93250c615c32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=466c75fef29c6d69f32a937f7ef3dd1d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3f68db5/uploads/origins/0da54d0c-72cb-437d-ba22-93250c615c32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f457df4f6803e99bb5cd7fbbc5885e0", "src_set": ""}, "body": "スイーツ化した頭を食べさせようとする赤蛮奇のイラストをお願いいたします。本体についてる頭はプリンで出来ていて既に半分弱くらいなくなった状態で、その頭のプリンをスプーンですくってこちらにあーんしてる感じでお願いします。机の上には他のスイーツ製(ケーキなど)の蛮奇ヘッドが並べられており、その内の一つは切り分けられた状態で置いてある。机の位置は蛮奇の前でも後ろでも左右でもOKです。背景色は明るめでお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kou_baa/works/39", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 269249, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b89dcec/uploads/origins/82c5ba35-f9d3-45cb-a3fe-c3cbbaf1c313?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cba238db6d56c3456c78f9fc92e5a641", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b89dcec/uploads/origins/82c5ba35-f9d3-45cb-a3fe-c3cbbaf1c313?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=671b7bbc8d049de09fbbd4e6bc0ca7d3", "src_set": ""}, "body": "はじめまして。いつもイラストを楽しく拝見させていただいています。\n\n東方Projectのナズーリンについて、1つ漫画でお話を描いていただきたいです。\nこうばさんが考える「ナズーリンのここが可愛い！」をテーマに描いていただけると嬉しいです。\n\nこうばさんの描くナズーリンがとても好きなので（先日頒布されていた同人誌の中のナズーリンもとても可愛かったです…！）、少しアバウトすぎる依頼かもしれませんが、是非お願いできればと思います。\nテーマ以外の点については、全ておまかせいたします。\nよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kou_baa/works/38", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 269249, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d73ee6b3/uploads/origins/a883bd6f-04a1-49cb-b5b4-ff5545a8119d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4498510fc1ea3a64b90e039e7c5294e7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d73ee6b3/uploads/origins/a883bd6f-04a1-49cb-b5b4-ff5545a8119d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31714c06a8c45e791db9372c4577c58b", "src_set": ""}, "body": "こんにちは！\nあなたのイラストはいつもとても美しいです。\nナズーリンを描いていただけませんか？\n暖かみのあるテーマでナズーリンを描いてほしいです！\n全てお任せします！\nありがとうございました！\n\nHello!\nYour illustrations are always so beautiful.\nCan you please draw Nazrin?\nI'd like for you to draw Nazrin with a warm theme!\nI'll leave everything up to you!\nThank you very much!", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kou_baa/works/37", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 269249, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc78a5e1/uploads/origins/c295a39f-6156-42a4-9139-239c49dd6660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccbfceab4e594059843224afccec0b4b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc78a5e1/uploads/origins/c295a39f-6156-42a4-9139-239c49dd6660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d65c077156e97d01855f6d65ff92815", "src_set": ""}, "body": "ご依頼失礼します。\n参考資料のような感じの衣装を着た女の子をあなたの絵柄で描いて頂けますか？\n\n指定は衣装の大まかな形状と女の子であるという部分のみですので、\n中の女の子のデザインはそちらのお好きなように描いて頂く形となります。\n\n衣装はアレンジを加えたりしていただいても全然大丈夫ですが、\n必ずキャラの手や足先までが衣装の袖や裾に包まれて見えないように描いて下さい。\n\n手と脚全体を覆い隠すような衣装ではありますが、\nステレオタイプの幽霊のように脚や下半身部分が先細りだったり消えているようには描かず、\nあくまで床まで引きずるような長い裾で隠れていて足が見えないという感じでお願いしたいです。\n\nまた、可能であれば 裾に隠れたままの足の部分まで見えるように全身を描いて頂きたいです。\n\n構図やポーズ等はそちらにお任せします。\n\n参考資料↓\nhttps://imgur.com/a/BoRro2t", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kou_baa/works/36", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 269249, "client_id": 3432392, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/948e2abf/uploads/origins/448e424f-3703-436e-ac8a-314ac46516dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b269867bc5569d063fe76882573a81d3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/948e2abf/uploads/origins/448e424f-3703-436e-ac8a-314ac46516dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b90c9fdc8b7acc1eae52ddc79ecd2e5", "src_set": ""}, "body": "はじめまして\nサン・モーニンの傘の魔法使いさんを描いて頂きたいです\n気持ち秋っぽい雰囲気で、それ以外、例えばポーズとかは本当にどんなのでもいいです\nよろしくお願いします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre"