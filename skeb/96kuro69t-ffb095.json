だきたいこと\n・モノクロ可。\n・体が操られる箇所の描写はざっくり、または省略で問題ありません。認識を変えられた攻めが恥ずかしがりながらも襲う、というのが重要ポイントになります。\n・乳首責め、ディープキスを中心にハナハナの能力を使って四方八方から受けが思いっきりレズレイプされる。\n・攻めと受け、両方とも「♡（ハート）」を語尾につけたセリフがある。\n・上記に加え、受けが命令されて自分または攻めの体を弄る描写があると嬉しいです。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@96kuro69t/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2635587, "client_id": 1887057, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b86a1c6/uploads/origins/7db47586-bddf-432c-8ca9-10d158f36db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1598eba95a91ed847e9ffb2bfdcb5140", "srcset": "https://si.imgix.net/2b86a1c6/uploads/origins/7db47586-bddf-432c-8ca9-10d158f36db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1598eba95a91ed847e9ffb2bfdcb5140, https://si.imgix.net/2b86a1c6/uploads/origins/7db47586-bddf-432c-8ca9-10d158f36db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7fec234e0a8782e4378797c94b90795 2x, https://si.imgix.net/2b86a1c6/uploads/origins/7db47586-bddf-432c-8ca9-10d158f36db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=134f20b890839b1f9ee470fa6e11be46 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b86a1c6/uploads/origins/7db47586-bddf-432c-8ca9-10d158f36db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87bb8a6e7d9280256e556155f20754e1", "srcset": "https://si.imgix.net/2b86a1c6/uploads/origins/7db47586-bddf-432c-8ca9-10d158f36db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87bb8a6e7d9280256e556155f20754e1, https://si.imgix.net/2b86a1c6/uploads/origins/7db47586-bddf-432c-8ca9-10d158f36db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=104b633