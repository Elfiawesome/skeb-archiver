2b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=069f902b8edb09f1f9d1850db6d827ed, https://si.imgix.net/a4eebaa8/uploads/origins/974b9562-e63d-4a8e-adc0-0341808ea2b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad4e81ca366ee9e2720b4cdc763afa5a 2x, https://si.imgix.net/a4eebaa8/uploads/origins/974b9562-e63d-4a8e-adc0-0341808ea2b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9df4415615fdf4796a2a8d2bfae1ff41 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4eebaa8/uploads/origins/974b9562-e63d-4a8e-adc0-0341808ea2b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6dd2503b605986a1ba55aaa945cd0193", "srcset": "https://si.imgix.net/a4eebaa8/uploads/origins/974b9562-e63d-4a8e-adc0-0341808ea2b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6dd2503b605986a1ba55aaa945cd0193, https://si.imgix.net/a4eebaa8/uploads/origins/974b9562-e63d-4a8e-adc0-0341808ea2b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07d621a422760b99d7c59b9e40915f14 2x, https://si.imgix.net/a4eebaa8/uploads/origins/974b9562-e63d-4a8e-adc0-0341808ea2b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=23edcd2632670edbe18d3d8c6f301be5 3x"}, "body": "こんにちは。\nげんぶ様のイラストがとても可愛くて大好きなので、今回初リクエストさせて頂きました。\nリクエスト内容ですが、レミリア(〇〇化等は無しの普通の状態)が、手のひら大(20〜30cm程度想定)の小さな妖精に敗北し、テレキネシスで軽々持ち上げられて誘拐され、ペット化されてしまうところを描いていただきたいです！(白い布で口を塞がれて喋れなくされたり、後ろ手に拘束されたり…)\n色々と注文が多く申し訳ありません。\nお忙しい中恐縮ですが、何卒よろしくお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matamata890/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 419721, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c3e39dd5/uploads/origins/9ef52ba0-1d0b-4383-915a-8602a9a87ab1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6be5fcb46177729a7753779fef98d5ec", "srcset": "https://si.imgix.net/c3e39dd5/uploads/origins/9ef52ba0-1d0b-4383-915a-8602a9a87ab1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6be5fcb46177729a7753779fef98d5ec, https://si.imgix.net/c3e39dd5/uploads/origins/9ef52ba0-1d0b-4383-915a-8602a9a87ab1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a054d3db157192918b7e7cfe3275a636 2x, https://si.imgix.net/c3e39dd5/uploads/origins/9ef52ba0-1d0b-4383-915a-8602a9a87ab1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ecd0da64c8b3950dfa99dde80a20d064 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c3e39dd5/uploads/origins/9ef52ba0-1d0b-4383-915a-8602a9a87ab1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=332bd27b89058000b00f24ffb1605fc2", "srcset": "https://si.imgix.net/c3e39dd5/uploads/origins/9ef52ba0-1d0b-4383-915a-8602a9a87ab1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=332bd27b89058000b00f24ffb1605fc2, https://si.imgix.net/c3e39dd5/uploads/origins/9ef52ba0-1d0b-4383-915a-8602a9a87ab1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a63cb55dd87432c7ead3a22c177cce1f 2x, https://si.imgix.net/c3e39dd5/uploads/origins/9ef52ba0-1d0b-4383-915a-8602a9a87ab1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e48211a4d4c3b39e4afbbb34f81578a2 3x"}, "body": "こんにちは！東方Projectの作品とシナリオを楽しみにしています。もしよろしければ、アリス・マーガトロイドとメディスン・メランコリーのシナリオをお願いしたいのですが。\n\nアリスは拘束されたまま目覚め、メディスンに声をかけられる。メディスンは毒の力を利用してアリスを性的にいたぶり、拷問する。メディシンの毒はアリスにフタナリ巨根と巨乳を与える。さらに媚薬効果で敏感になり、徐々に正気を失っていく。\n\nメディシンはアリスの胸とチンコを執拗にいじめる。アリスは何度も何度もクンニし、徐々に理性を失い、快楽に溺れていく。アリスは部屋中に精液を浴びる。もし可能なら、メディスンがアリスの上海人形をオナホールのように使って、アリスをさらに拷問するのを見たい。アリスの巨根が人形の腹を膨らませる。複数の人形が使われ、床に転がっている様子を見せることで、時間の経過を感じさせてもよい。\n\nご検討ありがとうございました！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matamata890/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2c0f5b5b/uploads/origins/34bac23c-911c-4dc9-a22d-98f06173c39c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68950ecb3acfc5829bfb7b229e90d3d3", "srcset": "https://si.imgix.net/2c0f5b5b/uploads/origins/34bac23c-911c-4dc9-a22d-98f06173c39c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68950ecb3acfc5829bfb7b229e90d3d3, https://si.imgix.net/2c0f5b5b/uploads/origins/34bac23c-911c-4dc9-a22d-98f06173c39c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=132dcb86f3ca63749b786d51abf173cd 2x, https://si.imgix.net/2c0f5b5b/uploads/origins/34bac23c-911c-4dc9-a22d-98f06173c39c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2022180e957ca081abd92421881d7274 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 419721, "client_id": 845653, "nc": 176}, {"path": "/@matamata890/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 419721, "client_id": 895567, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b525752c/uploads/origins/265abb60-cdb0-4ff1-85f4-d861b923defe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e21d971bff29675ff5cd50ec55a09500", "srcset": "https://si.imgix.net/b525752c/uploads/origins/265a