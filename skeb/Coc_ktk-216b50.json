d863fc94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d19309a2776e74cc35b71153149b082d, https://si.imgix.net/2b9d80a0/uploads/origins/57500927-d169-4409-a901-6e80d863fc94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3af21822271e7fa358b3f474099c9cc7 2x, https://si.imgix.net/2b9d80a0/uploads/origins/57500927-d169-4409-a901-6e80d863fc94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0b9786de1286ae5bc0cc0567ac4b24a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b9d80a0/uploads/origins/57500927-d169-4409-a901-6e80d863fc94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b28712ffada6b15bb205f3033d293b8", "srcset": "https://si.imgix.net/2b9d80a0/uploads/origins/57500927-d169-4409-a901-6e80d863fc94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b28712ffada6b15bb205f3033d293b8, https://si.imgix.net/2b9d80a0/uploads/origins/57500927-d169-4409-a901-6e80d863fc94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d97e9fa440d846402d696bc29861fe3f 2x, https://si.imgix.net/2b9d80a0/uploads/origins/57500927-d169-4409-a901-6e80d863fc94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9c3b4c98ad19d933bdc1f075c4abcbaa 3x"}, "body": "るどさま\n\n初めまして、ことこと申します。\n\n検索よりお邪魔させていただき、イラストを拝見させていただきました。\nとても素敵な絵柄だとおもい、是非私と友人のOCたちを描いていただければと思い依頼をお送りいたします。\n依頼させていただくのはTRPGの同人シナリオの「GODARCA」のOCで、下記の内容にネタバレは含まれません。\n\n◆キャラクター\n架空世界の19世紀末のロンドンにある抗神組織「アルカナ」で働いている隊長たちです。\n※見た目・補足の情報については資料ご確認いただければ幸いです。\n\n服装に関しましては、現コバ・本編どちらでも構いません\n\n◆イラストの使用用途\n・私と友人間で鑑賞目的での共有\n・作者様の名前を明記した上でのSNSへの投稿・アイコンやヘッダーへの使用\n\n長文となりましたが、ここまで読んでいただきありがとうございました。\n内容が不適切でしたり詳細や金額の不足がありましたら、キャンセルや差戻しをいただければと思いますので、一度ご検討いただけましたら幸いです。\n\n何卒、宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1fnDOybIVMVBmUAfm_abO33V1p-kMx