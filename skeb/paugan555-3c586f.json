2c20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d469d75f56dcbc07c5e7fecef6e4d02, https://si.imgix.net/d48e6b7b/uploads/origins/8dddd449-6722-43bb-ac24-eb1625cc2c20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=584e649d59d415c5f1b31cfa361055f4 2x, https://si.imgix.net/d48e6b7b/uploads/origins/8dddd449-6722-43bb-ac24-eb1625cc2c20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d62a234da767c1381dc451d801dc1beb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d48e6b7b/uploads/origins/8dddd449-6722-43bb-ac24-eb1625cc2c20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e3b7d44504ef50eab7f7c5906807351", "srcset": "https://si.imgix.net/d48e6b7b/uploads/origins/8dddd449-6722-43bb-ac24-eb1625cc2c20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e3b7d44504ef50eab7f7c5906807351, https://si.imgix.net/d48e6b7b/uploads/origins/8dddd449-6722-43bb-ac24-eb1625cc2c20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7f26062e5ee4d45026e526aa8e3d6ec1 2x, https://si.imgix.net/d48e6b7b/uploads/origins/8dddd449-6722-43bb-ac24-eb1625cc2c20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=da9583194b2738bc2c3cc892a69ab3f4 3x"}, "body": "何度も失礼いたします。\n次点でリクエストしたかったシチュがあります。\n(一応、金額はこれで宜しかったですか？)\n\n〇キャラクター\n\n・ゆるふわ巨乳お姉さん系の料理部部長(髪型はセミロングのカーリーヘア)\n頭脳明晰で海外留学有望な高校のマドンナで女子達からも愛されキャラとして人気。\n教師の信頼も厚く、よく休日に二つ返事で調理室を借りては試作料理を試している。\n\n同じ料理部の女子グループに囲われていた上に、別格過ぎて男子達も浮足立ってた為\n性体験どころか恋愛経験も皆無だが、遠くから自分を性的な目で眺める男子達を見て\n(もしも押し倒されたらどうなるんだろう)等という、ちょっとした破滅願望の持ち主。\n\n順風満帆に卒業が迫る日々に一抹の寂しさを覚えた彼女は、同じ料理部の男子の一人を\n試作を手伝ってほしいと休日の調理室へ呼んで、珍しく二人で作った料理を堪能した。\nそして調理準備室で後片付けをしている最中、彼女は徐に制服の胸元を大きく広げた。\n\n「お腹一杯になって熱くなっちゃったね、エヘヘ。……ねぇ？\nずっと見てたよね？……今だけなら良いけど……どうする？」\n\n・料理部のデブな後輩男子\n食べるの大好き。女性のおっぱいも大好き。女子偏重の料理部に入ったのは両得の為。\nそれなりに料理は出来るほうで、セクハラする気も殆ど無いが今一つ信用されてない。\n\n初めて休日の学校に呼び出され、二人きりで料理している時はドキドキが止まらず\nそうして出来上がった海鮮丼は今までで一番美味しく感じたが、まさかそのすぐ後\nあの部長の初めてを、それも生で食べさせてくれるとは微塵も思っていなかった。\n\n彼は迷わず彼女を押し倒し、はしたなく豊満で綺麗な果実に喰らいついた。\n\n〇シチュエーション\n\n事後、調理準備室には二人のエプロンやらブラジャーやらが散乱している。\n初めてのセックスで腰が抜けて、地べたに座って向き合う部長とデブ後輩。\n何とも言えない表情で先ほどまで挿入されていた男性器を両手で掴む部長と\nそんな部長の巨乳を名残惜しそうに黙々と揉み続けるデブ後輩。\n\n(うわぁ……本当にシちゃった)\n(これ…私の膣内に…血と愛液と精液でべっとり)\n(脚が震えて…お腹もジンジンする…これで妊娠したら…)\n(この子まだ二年先だし…そもそも絶対追いつけないよ)\n(凄い揉んでる…まだシたいの？…流石に先生来ちゃうよ？…エヘヘ)", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@paugan555/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/426857fa/uploads/origins/823a5cb9-c490-4631-babf-7607a80c664b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fcaaf64352fbeaf276698c5490ffd38e", "srcset": "https://si.imgix.net/426857fa/uploads/origins/823a5cb9-c490-4631-babf-7607a80c664b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fcaaf64352fbeaf276698c5490ffd38e, https://si.imgix.net/426857fa/uploads/origins/823a5cb9-c490-4631-babf-7607a80c664b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7209bf6212aa114c3d5a57fc27558aab 2x, https://si.imgix.net/426857fa/uploads/origins/823a5cb9-c490-4631-babf-7607a80c664b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1fc24729441332a965eb47a8d7ca0130 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1747728, "client_id": 1876140, "nc": 32}, {"path": "/@paugan555/works/2", "private_thumbnail_image_urls": {"src": "https: