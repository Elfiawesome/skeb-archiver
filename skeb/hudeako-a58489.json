b9/uploads/origins/2dfaeaf0-d522-4f7f-a6e2-4334e7a59fd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ff3e1356b2d938e66202aaa58214f84", "srcset": "https://si.imgix.net/6d730eb9/uploads/origins/2dfaeaf0-d522-4f7f-a6e2-4334e7a59fd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ff3e1356b2d938e66202aaa58214f84, https://si.imgix.net/6d730eb9/uploads/origins/2dfaeaf0-d522-4f7f-a6e2-4334e7a59fd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3c561c9d3154a8e606d9752370757628 2x, https://si.imgix.net/6d730eb9/uploads/origins/2dfaeaf0-d522-4f7f-a6e2-4334e7a59fd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28319ca4ff35379d9271f6ca8a7fe0df 3x"}, "body": "こんにちは、ふであこさん！\n\n以前、私のキャラクターを描いていただいた作品をとても気に入ったので、またお願いしたいと思っています。\n今回は、もしよろしければ私のサキュバスキャラクターを登場させていただけないでしょうか。\n彼女はかなりのわがままっ子で、一緒にいる男性たちを弄ぶのが大好きなんです。 \n\nもし、彼女が男性に腰をすりつけながら、何らかの形でからかうような姿を描いていただけたら、とても嬉しいです！\n彼女は幻術も使えるので、魔法的な要素を取り入れていただいても構いません。\nもし編集をお願いしてもよければ、彼女の中に挿入されるシーンも描いていただけないでしょうか？\n\nポーズの参考画像 - https://imgur.com/a/LWwaKOW\n\n普段は服を着ていませんが、お好きなセクシーな衣装を着せていただいても構いません。\nご検討いただき、誠にありがとうございます！\n\nhttps://imgur.com/a/bKkGWEZ", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hudeako/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1926898, "client_id": 2616430, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/add63f8d/uploads/origins/f50ebbe8-c714-41d3-a9e9-63a1d895a9de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f29bf9cd60fda75c2c26e0f602b941fd", "srcset": "https://si.imgix.net/add63f8d/uploads/origins/f50ebbe8-c714-41d3-a9e9-63a1d895a9de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f29bf9cd60fda75c2c26e0f602b941fd, https://si.imgix.net/add63f8d/uploads/origins/f50ebbe8-c714-41d3-a9e9-63a1d895a9de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b83af47630ff53456b315ca20d8f932 2x, https://si.imgix.net/add63f8d/uploads/origins/f50ebbe8-c714-41d3-a9e9-63a1d895a9de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4ed3451f386dd448cd7e2412923a3ed 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/add63f8d/uploads/origins/f50ebbe8-c714-41d3-a9e9-63a1d895a9de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b697822309ee76825e6d9a3703349e8", "srcset": "https://si.imgix.net/add63f8d/uploads/origins/f50ebbe8-c714-41d3-a9e9-63a1d895a9de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b697822309ee76825e6d9a3703349e8, https://si.imgix.net/add63f8d/uploads/origins/f50ebbe8-c714-41d3-a9e9-63a1d895a9de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9972e389a3814613e78eaee4decb0414 2x, https://si.imgix.net/add63f8d/uploads/origins/f50ebbe8-c714-41d3-a9e9-63a1d895a9de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=710c7f9120bb945f0aa949c877b3c77d 3x"}, "body": "こんにちは。\nこちらで素敵なイラストを拝見しリクエストさせて頂きました。\nよろしければうちの子（OC）を描いて頂けると嬉しいです。\n是非よろしくお願いします。\n\n◆キャラ\n小日向來音（こひなた くおん）\nhttps://x.com/i/status/1624678045637550083\n\nhttps://skeb.jp/@Laurier_rori/works/8\nhttps://skeb.jp/@imo_umai02/works/55\n\n◆シチュエーション\nフェラ抜きシーンをお願いしたいです。\n\n◆構図・ポージング\nこちらのような横向きフェラシーン\nhttps://www.pixiv.net/artworks/115837462\n\nとても丁寧で慈愛に満ちた、ストロークの深いフェラをお願いします。\n\n足元まで画面に収めて頂き、いわゆるエロ蹲居姿勢でショーツが丸見えです。\n胸もはだけていてブラが見えています。\n\n◆服装\nこちらの制服スタイルでお願いします。\nhttps://skeb.jp/@imo_umai02/works/55\n\nブラとショーツについてはこちらのデザインがとても良かったので、このデザインでカラーを紺色（ネイビー）系にしてください。\nhttps://skeb.jp/@hudeako/works/1\n\n◆表情\nややジト目がちな感じで、少しイヤそうな顔をしつつも丁寧に奉仕する感じでお願いします。\n\n◆差分\nフェラの進行に応じた差分をお願いします。\n①亀頭へのキス\n②先っぽを口に含んだ状態\n③竿の真ん中あたりまで咥えた状態\n④竿の根元まで咥えた状態\n\nもし可能でしたらブラを外して胸が露出した状態もお願いします。\n\n胸のサイズ感はこちらをご参照\nhttps://skeb.jp/@sonao/works/146\n\n◆納品\nPSDとPNG形式\n（PSDを扱うソフトがないため、PNG形式も併せて納品頂けると助かります）\n\n◆宛名\n宛名は「Quon」でお願いします。\n\nご検討いただけますと幸いです。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hudeako/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1926898, "client_id": 427649, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b00a328/uploads/origins/bd02b472-e330-4adc-9d93-295d98b29efd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=862772f5d664d781cd9f3f8bbf5a2892", "srcset": "https://si.imgix.net/5b00a328/uploads/origins/bd02b472-e330-4adc-9d93-295d98b29efd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=862772f5d664d781cd9f3f8bbf5a2892, https://si.imgix.net/5b00a328/uploads/origins/bd02b472-e330-4adc-9d93-295d98b29efd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc93dcc1885c03cb9dc0fe2ba46ea289 2x, https://si.imgix.net/5b00a328/uploads/origins/bd02b472-e330-4adc-9d93-295d98b29efd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7472c855933f2fd738a8c3a6ebe030f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b00a328/uploads/origins/bd02b472-e330-4adc-9d93-295d98b29efd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=437b2d32c09fed42de4811a09f33ffd0", "srcset": "https://si.imgix.net/5b00a328/uploads/origins/bd02b472-e330-4adc-9d93-295d98b29efd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=437b2d32c09fed42de4811a09f33ffd0, https://si.imgix.net/5b00a328/uploads/origins/bd02b472-e330-4adc-9d93-295d98b29efd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c1a76d1346abe30330da14913d40a90a 2x, ht