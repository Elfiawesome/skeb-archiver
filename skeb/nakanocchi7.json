さについては、前と同じ感じで、\n　向き全体を正面に\n・悪いやつらに脅され、怯えて泣きながら、\n　股を大きく開き、画面手前におしっこをしている\n・服は全部脱がして、パンツだけ半脱ぎで足にかけて、\n　ちぢれ毛と、多めの黄色の尿汚れと、まん汁を垂らしてください\n・おっぱいとおま〇ことヘソと尻穴と腋が、全部見えるようにお願いします\n・おま〇こと尻穴の両方を、指でくぱぁと広げてください\n・乳首とクリトリスは勃起で\n・両耳にピアスをしています\n・陰毛、尻毛、腋毛はモサモサの多めに生やしてください\n・腋毛と身体と胸などに汗やメス汁を\n・まん汁は大量にお願いします\n・髪の毛は金髪で、他キャラみたいな感じで\n・絵はチェルだけでお願いします\n\nイラストのみを見たいので、宛名やセリフなどは書かなくて良いです。\n湯気などのエフェクトはお任せします。\n\n余裕があれば差分で、無毛のみと、おしっこの有無があると嬉しいです。\nあと、SNSなどに掲載するかもしれないので、許可いただけると助かります。\n\nチェルの資料⇒https://www.pixiv.net/artworks/108613543\n\nhttps://www.pixiv.net/artworks/108613543", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 17233, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "む＠紅楼夢つ-16a", "screen_name": "urouror", "avatar_url": "https://pbs.twimg.com/profile_images/1032579525345869824/JOzQW99c.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 48}, {"id": 79896, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ひざのうらだってばよ🔞", "screen_name": "Hizanoura219", "avatar_url": "https://pbs.twimg.com/profile_images/1760690999314317312/2GCth3cv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1759553052133228546/1708527556/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "skills": [{"genre": "art"}], "nc": 177}, {"id": 226122, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "糞野郎", "screen_name": "kusoyarou1515", "avatar_url": "https://pbs.twimg.com/profile_images/1961732856730042368/MzRX9Sd4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/716555778539139074/1725770746/1500x500", "appeal_r