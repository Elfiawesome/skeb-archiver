4bb-aee33fc6726e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=44a169ddf738012e9eb096a828415a6f 3x"}, "body": "はじめましてよかったらリクエストしたいです\n\nキャラは、異種族レヴュアーズのゼルくんが好きなので彼でお願いします\n内容は、へそフェチなのでへそに関するカラーイラストをお願いします\nサキュバス街のカミナリ娘の店に行ってそこのサキュ嬢からヘソに関する\n羞恥プレイをされるゼルくんが見たいです\n描写はゼルくんだけで構いません\n\n構図は、マイクロビキニの格好でへそは可能ならちょっとでべそがいいです\n以下の答えをセリフとして入れてください\n・へその形について教えてください\n・へそ見られて恥ずかしいか\n・へそは誰と元々つながっているか\n・へその中身はどんな感じか　豆やしわはどのくらい\n・へそに関する経験したエピソードを教えてください\n・お母さんからは自分のへその形　どんなか言われたことあるか\n\nマニアックなリクエストですが、ゼルくんがへそについて語ってる姿がぜひ見たいです！\n彼のセリフにへそやでべその発言多めだと嬉しいです\nよろしくお願いいたします", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pnpt000/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e2228fd1/uploads/origins/7592f968-1108-4d05-814a-069e49983708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=faccce5027c18068a669ee477005893b", "srcset": "https://si.imgix.net/e2228fd1/uploads/origins/7592f968-1108-4d05-814a-069e49983708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=faccce5027c18068a669ee477005893b, https://si.imgix.net/e2228fd1/uploads/origins/7592f968-1108-4d05-814a-069e49983708?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ec7ddd4966c0b6f0c07c3654eb27501 2x, https://si.imgix.net/e2228fd1/uploads/origins/7592f968-1108-4d05-814a-069e49983708?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1719da2ce7a0e9960b0eb36abee21eb 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2089460, "cl