gins/f3cf556a-83f5-4139-be7c-1cd581a4a7f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a4b9ef7b8ce31d06515e30d2c6eaf26, https://si.imgix.net/fbc561ae/uploads/origins/f3cf556a-83f5-4139-be7c-1cd581a4a7f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed4ac9011200febe16cefbfa0389adf4 2x, https://si.imgix.net/fbc561ae/uploads/origins/f3cf556a-83f5-4139-be7c-1cd581a4a7f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=68eb7b57f97372e4b1db2ce2cce217e0 3x"}, "body": "こんにちは！私はあなたの作風の大ファンで、友人のオリジナルキャラクター「コナン」のイラストをお願いしたいと思っています。\n彼は既存キャラクターの「バゼット」をモデルにしたキャラクターで、彼女と関係のある設定です。そのため、彼女と同じような戦闘ポーズで描いていただけると嬉しいです。もし可能でしたら、腕の差分も描いていただけると大変ありがたいです（追加料金もお支払いできますので、無理のない範囲でご対応いただければ嬉しいです！）\n\nキャラクターの参考画像とポーズの参考画像はこちらです：\nキャラクター\nhttps://drive.google.com/drive/folders/1TnAU_DnLVyluhP1Pql4fd1yUcD2BpsMW?usp=sharing\nポーズ \nhttps://imgur.com/a/CN2rcpM\n\nありがとうございます！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takamatu_hajime/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3287396, "client_id": 1825989, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e2876d62/uploads/origins/a43a28f1-e51b-4e8a-8c01-2efcb8afd8d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5139bd446b719d55f59510f0ff95468", "srcset": "https://si.imgix.net/e2876d62/uploads/origins/a43a28f1-e51b-4e8a-8c01-2efcb8afd8d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5139bd446b719d55f59510f0ff95468, https://si.imgix.net/e2876d62/uploads/origins/a43a28f1-e51b-4e8a-8c01-2efcb8afd8d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d0c945c1b711f82828effe7166fb051 2x, https://si.imgix.net/e2876d62/uploads/origins/a43a28f1-e51b-4e8a-8c01-2efcb8afd8d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e589199f16e98c37b1a5fc45238e9bdf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2876d62/uploads/origins/a43a28f1-e51b-4e8a-8c01-2efcb8afd8d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b654218b1b52de12d192f6c2fee95802", "srcset": "https://si.imgix.net/e2876d62/uploads/origins/a43a28f1-e51b-4e8a-8c01-2efcb8afd8d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b654218b1b52de12d192f6c2fee95802, https://si.imgix.net/e2876d62/uploads/origins/a43a28f1-e51b-4e8a-8c01-2efcb8afd8d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc4b65a9c80827e3534e312105352455 2x, https://si.imgix.net/e2876d62/uploads/origins/a43a28f1-e51b-4e8a-8c01-2efcb8afd8d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=db6a7b1c65481e635709a595eef31ace 3x"}, "body": "こんにちは、はじめまして！\nあなたのイラスト、特に『Punishing Gray Raven』の作品が本当に大好きです！\nあなたのアートスタイルはとてもスタイリッシュでユニークで、個人的にすごく惹かれます。以前の作品にも感じられた、あの陰鬱なトーンや雰囲気も大好きです！\nもしよろしければ、あなたのスタイルやクリエイティブなビジョンにぴったりだと思う、私のオリジナルキャラクター（OC）を描いていただけないでしょうか！\n\n私のサイエンス・ファンタジー・ミリタリー系のオリジナルキャラクター、「キャプテン・エリカ・フォン・ストロス」を描いていただけませんか？\n現在のデザインのリファレンスはこちらです：https://imgur.com/a/captain-erika-von-stross-O48wqJO\n追加のリファレンス資料をまとめたGoogleドライブのフォルダも、以下に添付します。\n彼女の性格や設定に関する情報は、こちらおよびリンク先の作品でご確認いただけます：https://skeb.jp/@mitsu349/works/53\n\nエリカは、ぜひあなたの思い通りに描いてください！\n\nご検討いただきありがとうございます！\n気に入っていただければ幸いです。\n翻訳の不備や参考資料の分かりにくさなどがありましたら、お詫び申し上げます。\n\nhttps://drive.google.com/drive/folders/1znnqCEGJR6aX3H7Dd0seQp9d9Xz3tFLT?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takamatu_hajime/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3287396, "client_id": 3606903, "vtt_url": null, "thumbnail_image_urls": {"src":