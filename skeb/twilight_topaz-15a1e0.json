cc88ee30-5152-41fc-a8f6-0439c7d5654b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=06913dc462891bf63ab036b114fbe7f0 3x"}, "body": "「はなのゆにわ」もしくは「はなのひつぎ」の短編が読みたいです。\n世界観も登場人物もとても好きなので、こんな話を希望というのは無く、どんなお話でも読めたら嬉しいです。\n恋愛主体でなくてもいいですし、登場人物も本編の主人公たちでなくても構いません。（他の登場人物の視点などなど）", "nc": 17, "word_count": 5676, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@nattsu_bl/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1755195, "client_id": 883595, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/707dde2c/uploads/origins/483b9cf0-5722-4a1b-be7f-093107d84577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8ce6ad2769d3d128a0a43cdd5d3a28a", "srcset": "https://si.imgix.net/707dde2c/uploads/origins/483b9cf0-5722-4a1b-be7f-093107d84577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8ce6ad2769d3d128a0a43cdd5d3a28a, https://si.imgix.net/707dde2c/uploads/origins/483b9cf0-5722-4a1b-be7f-093107d84577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=123fcdecc39a320025c8f25d2d32092a 2x, https://si.imgix.net/707dde2c/uploads/origins/483b9cf0-5722-4a1b-be7f-093107d84577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a661e8c2cee44c01cde43c700dfb3d8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/707dde2c/uploads/origins/483b9cf0-5722-4a1b-be7f-093107d84577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5969315cde04addbf08d5266d60ebe52", "srcset": "https://si.imgix.net/707dde2c/uploads/origins/483b9cf0-5722-4a1b-be7f-093107d84577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5969315cde04addbf08d5266d60ebe52, https://si.imgix.net/707dde2c/uploads/origins/483b9cf0-5722-4a1b-be7f-093107d84577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=71bcc314f735da08ac467a18150e43ca 2x, https://si.imgix.net/707dde2c/uploads/origins/483b9cf0-5722-4a1b-be7f-093107d84577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8514ad3bc74537d121fe8c046449a766 3x"}, "body": "なっつさんこんにちは。なっつさんの陰キャくん×陽キャくんに元気をいただいているものです。\nこの度は日頃の妄想をなっつさんのコミックで拝見したいという思いから、リクエストさせていただければと思います。\n\n【シチュエーション】\nギャルお兄さん（受け）が童貞くん（攻め）に対して、「いぇ〜い♡童貞くん見てる〜〜？♡お兄さんのなか、もうこんなにトロトロだよ〜〜♡」と、ビデオレターを送る漫画が読みたいです。\nこちらのシーンがありましたら前後はお任せで構いません。童貞くんと書きましたが、攻めは童貞でなくても問題ないです。\n\n【キャラクター】\n攻め 黒髪 受けに対して若干引き気味\n受け 明るい髪、長髪 攻めに対して押せ押せ\nだと嬉しいです！\n年齢は学生社会人問いません。\nもちろん、館川くんと祢々くんでいただいても嬉しいです。\n\nこのワンシーンがただ浮かんだだけでもろもろお任せしてしまい申し訳ありませんが、よろしくお願いいたします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@38_1jo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3147446, "client_id": 883595, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6382db12/uploads/origins/fe97c6f3-a8e0-47c2-b49f-fbcc60982f94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16e3282da5a4ce80f29408bb9bf2c61f", "srcset": "https://si.imgix.net/6382db12/uploads/origins/fe97c6f3-a8e0-47c2-b49f-fbcc60982f94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16e3282da5a4ce80f29408bb9bf2c61f, https://si.imgix.net/6382db12/uploads/origins/fe97c6f3-a8e0-47c2-b49f-fbcc60982f94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b815a0346500d30ad235377ff06fcf90 2x, https://si.imgix.net/6382db12/uploads/origins/fe97c6f3-a8e0-47c2-b49f-fbcc60982f94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a58cc8335a6e998289545851b32fd2c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net