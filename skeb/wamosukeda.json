0&h=200&blur=200&s=082a7f8b2497a0b02053f0b6f2e07d53", "src_set": ""}, "body": "初めまして、わもち様！いつも素晴らしいイラストを拝見し、それで私のオリキャラのイラストのリクエストをしたい！\n\n▼キャラクター設定はUrl内の画像と下記の情報を参照させていただけたら幸いです\n\nこの子は電脳世界に住む謎の女の子で、お茶目でエネルギッシュな性格です、主に元気表情をしています。 小悪魔的な一面もあり、悪戯が大好き。\n\n·八重歯があります\n·前髪には浅葱色のメッシュが3本あり\n·キャラの後ろ髪の一部（内側）は液体に変わります\n\nその他構図等もお任せします\n\n-使用用途：頂いたイラストはPC壁紙、SNSアイコン、ヘッダーなどに使用する可能性があります。\n\n以上、よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1JJcX1_gOqilo2gcOmviS5sJB-9Fbpa9Y", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wamosukeda/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/81f84854/uploads/origins/5062a875-baa2-419d-8d78-efefba8e7a12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b7fc776a020f355566640892758265a", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3290513, "client_id": 807680, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@wamosukeda/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3290513, "client_id": 203995, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2be8d911/uploads/origins/039400d3-f47f-46fa-88f8-adfb2cb019c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fe08af3baaf34caf7a834196a616e94", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2be8d911/uploads/origins/039400d3-f47f-46fa-88f8-adfb2cb019c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47d632db6edb7797ee5baf40e1c7c2fa", "src_set": ""}, "body": "ゎ₺ㄘ様、はじめまして！\n男女ともにとても魅力的で、透明感ある素敵な絵柄に惹かれてリクエストをお送りしました。キャラクターの表情の描き方が好きです。\n\n今回は、自創作で使用しているOC1人（男性）のイラストをお願いしたいです。\n外見などの詳細はリンク先にまとめてあります。\n世界観は、異形(死霊やアンデッドなどのイメージです)と戦うホラー寄りの現代ファンタジーです。\n用途は主に観賞用、個人・非商用の範囲です。切り抜きや文字入れなど最低限の加工をさせていただく可能性があります。差し支えなければ、資料としてネット上にアップしたりさせていただきたいです（都度無断転載防止の透かしなどを入れます）。\n文字や背景のオンオフがあると嬉しいです。\n\nキャラクターが「5本の白いバラ」を持って笑っている様子をお願いします。持ち方やポーズなどはお任せです。\n\n不都合などがありましたら、お手数をおかけしますがキャンセルや再送をお願いします。\nリクエストを読んでいただきありがとうございました！ご縁がありましたらよろしくお願いいたします。\n\n\nhttps://drive.google.com/drive/folders/1-zG5TRqt5vOOuuFREbcgysh4Ycc6kqNQ", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wamosukeda/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3290513, "client_id": 2815932, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c979b871/uploads/origins/4e839d81-af37-4f29-8a9a-603dc0f90a00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66d69a9934440a2ebbc23db9c190d1ba", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c979b871/uploads/origins/4e839d81-af37-4f29-8a9a-603dc0f90a00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=514ac91baa655f76a91741531e6a856e", "src_set": ""}, "body": "こんにちは！あなたの絵はとてもきれいで、私のオリジナルキャラクターを描いてもらえるとうれしいです！\n\n清志郎はクールでやんちゃな半妖の半人間です。彼の主な特徴やアクセサリーは、片方の角、「VII」のヘアクリップ、片方にスペードのついた耳のピアス、「VII」と書かれた黒い包帯、2つの指輪です。主な色は白、グレー、黒、赤。\n\nポーズと表情はお任せします！\n\nTwitch/YouTubeやSNSのサムネイルに使いたいと思います。背景あり、なしのPSDファイルもお願いしたいです。ちゃんとクレジットはアーティスト様にお渡しします。\n\nご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1FRiRhrZqsj-z3HBAmyZZsksR0OhUPwgX?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wamosukeda/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3290513, "client_id": 1219549, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83306890/uploads/origins/8c3d5894-54ef-49ce-b458-69478aa50bd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee6f0f9ed7d706771499716d3da01d02", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83306890/uploads/origins/8c3d5894-54ef-49ce-b458-69478aa50bd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba0ebc825970233aee686e87f01b3fa8", "src_set": ""}, "body": "こんにちは、わもち様！\n\nわもち様のご作品がとても好きで、ぜひ私のOCを描いていただきたく、ご連絡させていただきました！\n\n※\nキャラクターの外見年齢は15〜17歳程度です。\n\n【設定】\n電子世界に存在する謎めいた少年で、身体の炎はコンピュータウイルスのような存在です。データを燃やすことで破壊する能力を持っています。\n\n指を鳴らすことで指先に火を灯すことができ（それを使ってカッコつけたりもします）、掌からも炎を発生させることができます。\n\n【性格】\n基本的に自信家で、やや傲慢な態度を取ることが多いです。短気で怒りっぽく、一度怒るとユーザーのデータを破壊して仕返しをします。\n\nまた、自分の正体をAIだと誤解させるように振る舞い、その嘘を信じた相手を「バカだな」と心の中で見下しています。\n\n【その他】\nデータのコーディングが得意で、暇なときにはコードをいじって、オンラインゲームのプレイヤーやネットユーザーにちょっとしたイタズラを仕掛けたりもします。\nそうした行動が一部のネットユーザーの間で噂になり、「ネット都市伝説」として語られるようになっています。\n\n※\n-希望納品形式：できれば、宛名ありなし両方のpng とpsdファイルをも願いします…!\n-使用用途：頂いたイラストはPC壁紙、SNSアイコン、ヘッダーなどに使用する可能性があります。（作者表記は必ずいたします。）\n\n依頼内容が金額と見合わない・その他不備などがあればお気軽に再送要請してください。できる限り対応させていただきます。それでも難しければキャンセルして大丈夫です\n\n以上、よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1C9U0GZH3GrO7ZYw4KvbHKKGQNo7m_8zd", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wamosukeda/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3290513, "client_id": 1462110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb03cf8f/uploads/origins/8f2ac2a5-b861-41a9-b718-654a49c76350?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=150832551d26f0310f47ad35ad2c387f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_u