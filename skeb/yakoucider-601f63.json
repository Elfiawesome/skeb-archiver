net/aff1a7d3/uploads/origins/241df101-f7d6-444a-b4a9-a578231de636?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ed075db4984b43a5cbe58bd008ec091", "srcset": "https://si.imgix.net/aff1a7d3/uploads/origins/241df101-f7d6-444a-b4a9-a578231de636?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ed075db4984b43a5cbe58bd008ec091, https://si.imgix.net/aff1a7d3/uploads/origins/241df101-f7d6-444a-b4a9-a578231de636?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2f88f06f1f882434fbacca4e91a9876 2x, https://si.imgix.net/aff1a7d3/uploads/origins/241df101-f7d6-444a-b4a9-a578231de636?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4db13393103929f64d8f8ababab416a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aff1a7d3/uploads/origins/241df101-f7d6-444a-b4a9-a578231de636?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3058ccaef6ae1259bd0d2a4f06fc6590", "srcset": "https://si.imgix.net/aff1a7d3/uploads/origins/241df101-f7d6-444a-b4a9-a578231de636?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3058ccaef6ae1259bd0d2a4f06fc6590, https://si.imgix.net/aff1a7d3/uploads/origins/241df101-f7d6-444a-b4a9-a578231de636?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e223c68a0044bf5476edfaaa2a902fd 2x, https://si.imgix.net/aff1a7d3/uploads/origins/241df101-f7d6-444a-b4a9-a578231de636?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7079409ca0ebadbaad9fd4937c661099 3x"}, "body": "こんにちは、千百てふと申します。\n\nもしよろしければこの手数料無料期間でぜひご縁がいただければとリクエスト送らせていただきました。\n\n【使用用途】\n主に個人の観賞用です。\n\n【内容】\n資料URL先のキャラクターのスケブをお願いしたいです。\n夜光さんの繊細なモノクロ画が好きなので、可能であればモノクロ画が見てみたいと思っております…！\n\nMisskeyリンク↓\nhttps://misskey.design/notes/9kc05lfz4u\n\nTwitterリンク↓\nhttps://x.com/tehutehu_sizimi/status/1730176619527242165?s=46&t=NgZ2vE8X7XuWbvzlDbN0Mw\n\nポーズや構図はおまかせでよろしくお願いします。描きたい！と思っていただけた構図で描いていただければ幸いです。\nNG等も特にございません。\n\n以下、キャラクターの見た目や雰囲気の詳細ですので不要であれば読み飛ばしていただいても構いません。\n\nキャラの外観：黒髪青眼で見た目年齢は12〜13くらいです。\n顔の造形は美少年！という雰囲気、つり目気味です。頭のてっぺんの触覚は蝶の口吻イメージでくるん！としています。目隠れしている髪の毛だけ先っぽが若干パッツンです。その他はやわらかくくるくるしている毛質です。\n\n服装は基本はURLの先の服装ですが、サスペンダーや上着はよく変わるのでお好きに描いてくださると嬉しいです。\n\n以下はさらに細かいキャラ設定になります。\n\nお名前はディエレイといいます。\n蝶々モチーフで、主食は血液です。捉えどころがないようなくるくるふわふわした態度で人を弄んだりからかったり慈しんだり嘲笑ったり…という雰囲気です。結構ノリがいい時もあるので純粋に楽しそうにしている時もあります。\n\n出し入れ自在の人外パーツがあります。あってもなくても問題ありません。基本形は蝶々の片翼の形をしていますが、黒いドロドロの流動体であるので、違う形に出来たりもします。\n↓参考資料です。\nhttps://x.com/tehutehu_sizimi/status/1664240993749831681?s=46&t=NgZ2vE8X7XuWbvzlDbN0Mw\n\n長文失礼しました、読んでくださってありがとうございます！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yakoucider/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2886220, "client_id": 53582, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2491a032/uploads/origins/879bb265-a7e0-4792-a4d4-f7cdf2d549dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e587d520e54defe7bf92c13118aaca57", "srcset": "https://si.imgix.net/2491a032/uploads/origins/879bb265-a7e0-4792-a4d4-f7cdf2d549dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e587d520e54defe7bf92c13118aaca57, https://si.imgix.net/2491a032/uploads/origins/879bb265-a7e0-4792-a4d4-f7cdf2d549dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19ad83947aaa9cca23a0d14d612d336d 2x, https://si.imgix.net/2491a032/uploads/origins/879bb265-a7e0-4792-a4d4-f7cdf2d549dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b7d6f9f82e06264a75f68d62adc96c4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2491a032/uploads/origins/879bb265-a7e0-4792-a4d4-f7cdf2d549d