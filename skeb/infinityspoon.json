ころはお任せします\n\n別の方の依頼にて能代を沢山描かれたと推察し、また能代のリクで大変恐縮ではございますが何卒宜しくお願い致します", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@infinityspoon/works/81", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/684389a3/uploads/origins/c31eed9a-193c-433c-98cf-eec89ba81240?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d72dc02e2cf9c50b1be300d84456090f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1080989, "client_id": 839224, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@infinityspoon/works/80", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f147b897/uploads/origins/262805f3-d9ae-4d1d-a4c5-1fc590a0b1f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b552e086d90523320a6359d6e23da852", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1080989, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@infinityspoon/works/79", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2c8198de/uploads/origins/cf42e440-ca7d-40b1-b4ea-6977f62d8766?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a098adcff26a9f1b11cb962c456b382", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1080989, "client_id": 1508582, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@infinityspoon/works/78", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1080989, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a716774/uploads/origins/98f3695d-4ab9-45bd-a5fc-e58ac377f097?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfbbe5f17c9116041aea59bbe2225e02", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a716774/uploads/origins/98f3695d-4ab9-45bd-a5fc-e58ac377f097?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4099137cc2e111cb4ed2aa65351facba", "src_set": ""}, "body": "こんにちは！ファイナルファンタジーのティファ・ロックハートの漫画をリクエストしたいです。\n\n彼女は革の手袋をはめた男につかまる。彼は厚手の布にクロロホルムを染み込ませてから襲いかかる。彼は彼女に吸入を強要する。ティファは必死にもがき、自由になろうとする。もう少しで成功しそうだったが、彼は布を吸い込ませ続ける。彼女は意識を失う。\n\n彼はティファをベッドに連れて行き、意識を失ったティファとセックスする。その間、彼は彼女にキスをする。セックスが終わると、彼は彼女を毛布で覆い、枕に頭を乗せる。男は言う。\"ティファちゃん、素直でいてくれてありがとう\"。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@infinityspoon/works/77", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1080989, "client_id": 63804, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9d77eef/uploads/origins/86b14927-4246-4776-8d72-2d26972cb951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bd6a9996d2c206717007e58d10093c4", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9d77eef/uploads/origins/86b14927-4246-4776-8d72-2d26972cb951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fea8a3b1824ef46055932eac8d02acce", "src_set": ""}, "body": "いつもお世話になっております。この度は艦これの那智がショタ提督に後ろから絡みついて手コキして言葉責めしながら、二人でモニターでエッチな動画を見ているイラストをお願いします。\n\n　以下箇条書きでお願いしたい要素を書き出します。\n【那智】\n容姿：髪はいつものサイドポニー、それ以外は全裸。\n表情：少しいたずらっぽく口を閉じてにんまり笑っている感じで。目線は提督の方でお願いします（提督にささやきかけている状態）\n腕：左腕は提督を抱え込み、右手は提督に手コキしている\n\n【ショタ提督】\n容姿：全裸。明るい茶髪、前髪は7-3分けで。７のほうの毛束で片目は隠れでお願いします。もう一方の目は灰色で、エッチな動画にのぼせてぐるぐる目な感じでお願いします。体系は小柄細身。\n表情：紅潮し、口は情けなくふにゃふにゃしている感じで。\n腕：後ろに回されて自由が効かない感じで男捨離してください。\n\n【共通】\n構図：こちらから見て、二人の手前にテレビ→ショタ提督→抱え込んでいる那智……の順でお願いします。手コキの様子が分かれば二人の下半身は省略して構いません。テレビの内容はこちらからは見えない形でお願いします。\n音：テレビからは「ああぁあん」「でちゃうよ～」と声が聞こえている状態。吹き出しではなく＼／でテレビから声がしている感じでお願いします。「シコシコ」と手コキの擬態語と、できれば射精差分のときの「びゅくっ」って擬態語を入れてください。\nセリフ：那智「ほぉら、あんなにいやらしく貴様のモノが出入りしているぞ」「画面の貴様といっしょに射精するか？」　提督「あっ、あっ！　那智さん、もうだめぇ・・・」でお願いします。\n背景：特に指定なし\n他：射精差分と文字なし差分があると嬉しいです。\n\n以上です（skebの確認事項は了承）。ご一考のほどよろしくお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@infinityspoon/works/76", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8f0d77b2/uploads/origins/8cb1bf3f-d18c-44a4-868e-e9d341072abc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6fd7f4c6c92dacdf519a7a5a277c952e", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1080989, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@infinityspoon/works/75", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1080989, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71403451/uploads/origins/65f7d5e7-b785-4f2