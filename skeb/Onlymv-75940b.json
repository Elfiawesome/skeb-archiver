table_same_genre": true}, {"path": "/@Att_dcs/works/138", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3208906, "client_id": 3876463, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0cddaa84/uploads/origins/e92fe08d-7c89-4f75-a732-2362df8bbc53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=332e13aa3988118dd82a0d2afbd34d46", "srcset": "https://si.imgix.net/0cddaa84/uploads/origins/e92fe08d-7c89-4f75-a732-2362df8bbc53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=332e13aa3988118dd82a0d2afbd34d46, https://si.imgix.net/0cddaa84/uploads/origins/e92fe08d-7c89-4f75-a732-2362df8bbc53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b93b547b2a6dd29b367eab48fa2cefcb 2x, https://si.imgix.net/0cddaa84/uploads/origins/e92fe08d-7c89-4f75-a732-2362df8bbc53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f624bc05b8a064633c397be27e01bb7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0cddaa84/uploads/origins/e92fe08d-7c89-4f75-a732-2362df8bbc53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c5dce21a80b84b414f2bf17310649a4", "srcset": "https://si.imgix.net/0cddaa84/uploads/origins/e92fe08d-7c89-4f75-a732-2362df8bbc53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c5dce21a80b84b414f2bf17310649a4, https://si.imgix.net/0cddaa84/uploads/origins/e92fe08d-7c89-4f75-a732-2362df8bbc53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bb8f7709236017ea09e4888897e4b7ea 2x, https://si.imgix.net/0cddaa84/uploads/origins/e92fe08d-7c89-4f75-a732-2362df8bbc53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9056645b7c1b6ee56f9d06b9f6ac987d 3x"}, "body": "初めまして。お忙しい中失礼します。\nあなたのイラストが大好きです。もし良かったら私の依頼を受けるかどうか、検討していただけませんか？\n\n私のOC2人をリクエストさせていただきたいです。\n\n【キャラクターについて】\n\n2人はとある宗教施設で暮らしています。この施設では神を親として信仰しており、施設で暮らす歳上の教育者達を兄や姉、歳下の子達を妹弟としています。この兄妹の関係は非常に特別で密接で切れることの無いものです。\n\n・メアリー\nこの施設の最年長者の1人です。彼は神に愛された天賦の才を持っており、施設長の護衛から臨時講師まで幅広く仕事をこなします。ですが、昔からの失敗が重なり酷く情緒不安定です。元気な時は自分はなんでも出来る天才だと自信満々ですが、平時は自分は何も出来ない役たたずだと言い引きこもっています。\n\n・ヴェル\nこの施設では真ん中辺りの年齢の人物です。施設長を実兄に持ちます。非常に温厚で人当たりがよく、いるだけでチームの潤滑剤になります。\n自身の人喰い花としての暴力的な本能に悩んでおり、それを逆手にとって表で言えないような庶務雑務を担当しています。ギザ歯を気にしているのであまり口を開けません。\n\nメアリーは昔ヴェルの教育係でした。訳あって今はもう教育係ではありませんが、2人は永遠を誓った人生のパートナーであり現在は一緒に暮らしています。昔からとても仲睦まじく、2人は現在に至るまでまったくいざこざがありません。施設長繋がりでよく2人で仕事をします。\n\n【モチーフ】\nメアリー/青薔薇、龍\nヴェル/赤薔薇、赤色の花\n2人共通/宗教関連のもの全て\n\n【使用用途】\n個人鑑賞\nSNSのアイコンやヘッダーに使用\n\n【その他】\n2人共かなり女性的に描いていただけると嬉しいです。また2人はつり目に見えますが、おはな様の描かれるイラストが大好きなので、是非描きやすいように描いていただけたら幸いです...！\n耳はエルフ耳ではないので耳の中の詳細な書き込みは不要です。\n\nNG等は特にありません。もし受けていただける場合はお好きに制作をしてください！\nご検討のほどよろしくお願いいたします！\n\nhttps://app.notion.com/p/39452b46c5e180778858ccac6a461c4f?source=copy_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NASUBI_07/works/158", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2407774, "client_id": 3876463, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90badc17/uploads/origins/6664dbb6-5c5a-41f6-b46f-d8e5aaf705b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3df103841ce0aaad1a67c8267154168a", "srcset": "https://si.imgix.net/90badc17/uploads/origins/6664dbb6-5c5a-41f6-b46f-d8e5aaf705b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3df103841ce0aaad1a67c8267154168a, https://si.imgix.net/90badc17/uploads/origins/6664dbb6-5c5a-41f6-b46f-d8e5aaf705b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=277d3fc24fd5d23479bd0ff3c1b0a60c 2x, https://si.imgix.net/90badc17/uploads/origins/6664dbb6-5c5a-41f6-b46f-d8e5aaf705b0?bg=%23fff&auto=format%2Ccompress&fm=webp