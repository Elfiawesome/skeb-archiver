ます。(アクセサリーも自由につけていただいて大丈夫です！)\n\n使用用途として、お洋服や髪型をお仕立ていただいた時には自分でも描いて楽しんだり、描いていただいた絵を参考元としてskebリクエストの資料に使用したいと考えております。使用用途や内容に問題がある場合はキャンセルでお願いします。\n\n\nお忙しいところ最後まで読んでくださりありがとうございます。\nご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1wc-khGM4p1nRTCBIHLZjZNKYL-YkYnMh", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ki10_nori/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2704314, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e075f0c/uploads/origins/71aeccf9-6e3c-4ca4-8a1e-9952c4f0e072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18cf741b0af59e2b272521387625e847", "srcset": "https://si.imgix.net/8e075f0c/uploads/origins/71aeccf9-6e3c-4ca4-8a1e-9952c4f0e072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18cf741b0af59e2b272521387625e847, https://si.imgix.net/8e075f0c/uploads/origins/71aeccf9-6e3c-4ca4-8a1e-9952c4f0e072?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=954f90028920a266a4797a0074c627f0 2x, https://si.imgix.net/8e075f0c/uploads/origins/71aeccf9-6e3c-4ca4-8a1e-9952c4f0e072?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42d6c22f9868ca4dd329c5633c815708 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e075f0c/uploads/origins/71aeccf9-6e3c-4ca4-8a1e-9952c4f0e072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08ab564d7e333be475e6d7949d2fa827", "srcset": "https://si.imgix.net/8e075f0c/uploads/origins/71aeccf9-6e3c-4ca4-8a1e-9952c4f0e072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08ab564d7e333be475e6d7949d2fa827, https://si.imgix.net/8e075f0c/uploads/origins/71aeccf9-6e3c-4ca4-8a1e-9952c4f0e072?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=