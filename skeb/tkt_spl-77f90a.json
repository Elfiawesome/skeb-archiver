op&crop=top&w=200&h=200&s=4cca2cbf1aaaf8cc79c404ca3d1011fd 2x, https://si.imgix.net/b0b3a377/uploads/origins/019e6e8c-f5b5-44ca-ae5e-0a27d86a591e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2138703240e0cd51276084165cb5c187 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0b3a377/uploads/origins/019e6e8c-f5b5-44ca-ae5e-0a27d86a591e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1e2045914f692c7b1e910c7820b9cd6", "srcset": "https://si.imgix.net/b0b3a377/uploads/origins/019e6e8c-f5b5-44ca-ae5e-0a27d86a591e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1e2045914f692c7b1e910c7820b9cd6, https://si.imgix.net/b0b3a377/uploads/origins/019e6e8c-f5b5-44ca-ae5e-0a27d86a591e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c3e20773539ebed049a473718d9b7669 2x, https://si.imgix.net/b0b3a377/uploads/origins/019e6e8c-f5b5-44ca-ae5e-0a27d86a591e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5f88015e2ffd9c3df13eec341e3f434 3x"}, "body": "またまたこんにちは!\n前回描いていただいた絵がとても気に入りました!\n今回は、黒髪の男と、もう一人の主人公である赤髪の男を描いていただきたいと思います。\n彼らは酒場にいます。\n赤髪の男は、一人でビールを飲みたかったので、イライラした表情をしています。\n彼はビールのグラスを片手でテーブルに置いています。\n赤髪の男は少し肌が黒いですね。(右上の参考資料を見ればわかります)\n黒髪の男は少し酔っ払っていて、赤髪の男に悪そうな笑みを浮かべています。ポーズはお好みで調整してください。\n背景も楽しんでくださいね。\n\nできればpsdファイルで、サインの宛先のレイヤーを変えてください。\n\nhttps://cdn.discordapp.com/attachments/694684223700992051/853737850523615232/ref3.png", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tkt_spl/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 363072, "client_id": 1235069, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d0f0a22/uploads/origins/e9d83947-d1fa-4de8-b7ab-2c5d57bb5858?bg=%23fff&auto=format%2Ccompr