自分、堪らないです！\n\nこんな依頼も大丈夫でしょうか。\n可能ならカラーでお願いしたいです…っ！(肌の色的にモノクロぽいですがｗ)\nＯＫ頂けましたらエロ可愛さめいっぱいでお願いしますっ！(›w‹", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@daromeon/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 20459, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/626ba975/uploads/origins/b0c60be1-680c-4409-87b9-1af9d690f227?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55cabd478e8cf2244e680e23d1c202d3", "srcset": "https://si.imgix.net/626ba975/uploads/origins/b0c60be1-680c-4409-87b9-1af9d690f227?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55cabd478e8cf2244e680e23d1c202d3, https://si.imgix.net/626ba975/uploads/origins/b0c60be1-680c-4409-87b9-1af9d690f227?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=936a15121d82a7fc5ab95371b053114d 2x, https://si.imgix.net/626ba975/uploads/origins/b0c60be1-680c-4409-87b9-1af9d690f227?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2565054b277e1659561798e673ea5b44 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/626ba975/uploads/origins/b0c60be1-680c-4409-87b9-1af9d690f227?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d7d463ecd4436dea70d9f21b34f0f0e", "srcset": "https://si.imgix.net/626ba975/uploads/origins/b0c60be1-680c-4409-87b9-1af9d690f227?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d7d463ecd4436dea70d9f21b34f0f0e, https://si.imgix.net/626ba975/uploads/origins/b0c60be1-680c-4409-87b9-1af9d690f227?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3553119cad3409eb96d11e37249a670a 2x, https://si.imgix.net/626ba975/uploads/origins/b0c60be1-680c-4409-87b9-1af9d690f227?bg=%23fff&auto=format%2Ccompr