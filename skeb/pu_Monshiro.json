true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@pu_Monshiro/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2214469, "client_id": 1490960, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f7e15a3/uploads/origins/29026d82-86a0-4345-b7b7-774fe8463d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1535d01023a80de282f27d11832f93b", "srcset": "https://si.imgix.net/4f7e15a3/uploads/origins/29026d82-86a0-4345-b7b7-774fe8463d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1535d01023a80de282f27d11832f93b, https://si.imgix.net/4f7e15a3/uploads/origins/29026d82-86a0-4345-b7b7-774fe8463d84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=147d3c0082b5d864b87e8ae0cbcfd991 2x, https://si.imgix.net/4f7e15a3/uploads/origins/29026d82-86a0-4345-b7b7-774fe8463d84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6adf67b5b2439fe5ae9f37db75e61f6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f7e15a3/uploads/origins/29026d82-86a0-4345-b7b7-774fe8463d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40b6a1a6bdfe048f0254261f7c4d1f7e", "srcset": "https://si.imgix.net/4f7e15a3/uploads/origins/29026d82-86a0-4345-b7b7-774fe8463d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40b6a1a6bdfe048f0254261f7c4d1f7e, https://si.imgix.net/4f7e15a3/uploads/origins/29026d82-86a0-4345-b7b7-774fe8463d84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8a719db777bd70ee0d8f19f332e942f7 2x, https://si.imgix.net/4f7e15a3/uploads/origins/29026d82-86a0-4345-b7b7-774fe8463d84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8fe4868edf7fc75e003300f7cd126ac 3x"}, "body": "初めまして。\n先生の作品を拝見し、伯母のむっちりした体型や服装の装飾を意識して描いてある所が魅力的でシリーズが続くほど性行為で正直になっていく伯母の姿が自分好みの作品で楽しみにさせて頂いています。\n最近先生がskebをやっていることを知り是非依頼したいと思い来ました。\nよろしければ下記の内容をイメージして推しキャラの作品を描いて頂かないでしょうか\n\n⬛︎作品\n僕に抱かれ喘ぐ妻は、他の男に抱かれた話を紡ぐ\n\n⬛︎キャラクター\n深川佳乃\n※資料URL参照\n\n⬛︎あらすじ\n夜の公園にて参加者に佳乃を寝取らせていたが、美人局かと警戒していた男達も度重ねる奉仕に慣れ始め、次第に過激なプレイを要望する者が出始める。\n夫の賢一は男達に注意を促すが、欲求を抑えられない1人の男が賢一に暴行を加え倒してしまう。\n佳乃は夫のもとに駆け寄ろうとするも男達に阻止され賢一のいない所で交わる為に連れ去られ消息を絶ってしまう…\n\n⬛︎内容\nどれ程の月日が経ったであろうか、とある建物の隔離部屋で男達の性の掃き溜めとして佳乃は終わる事ない陵辱が繰り広げられていた。\n白のセクシーランジェリーとチェーン付きの首輪を装着され、佳乃の豊満な胸に噛み跡を残しながら授乳した痕や相手の肉棒を受け入れては膣内に強制的に射精され続けていた。\n入れ代わりでやってくる男達から逃げることが出来ず佳乃はせめて避妊をする様に男性達に懇願したが今まで膣内射精を許可していて今更やめてくれるはずもなく逆に悲しそうにする姿が男達の心を刺激してしまい何度も膣内射精され続け遂に夫ではない誰かの子を身籠った佳乃。\n孕ました証明に陽性の妊娠検査薬をアクセサリーに加工し佳乃の首輪につけられ、性行為で疲れ放心している姿関係なく首輪のチェーンを引っ張り寄せ佳乃の口に1人の男が肉棒を近づけると長い間調教された事により佳乃は意識が朦朧としていても男の肉棒を無意識に咥え込み舌を使いながら亀頭やカリを舐め回し奉仕する。\n背徳感ある姿に見ていた男達も興奮し再び佳乃の膣内に挿入し性処理肉便器として扱われ続けるのであった。\n\n⬛︎備考\n下記にあるセクシーランジェリーに股下をオープンショーツの様に加工して着せて欲しいです\n（模様等も改変して大丈夫です）\nhttps://item.rakuten.co.jp/plusnao/inn-50012/\n\nよろしくお願いします\n\nhttps://www.hs-crowd.co.jp/anim/product/pro_pc/pc055/index.html", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pu_Monshiro/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2214469, "client_id": 2541732, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/564cf00a/uploads/origins/09e62e39-18eb-4b2e-bc00-6aa1b52d34b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=285f74932d2622bc5074609c11426154", "srcset": "https://si.imgix.net/564cf00a/uploads/origins/09e62e39-18eb-4b2e-bc00-6aa1b52d34b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=285f74932d2622bc5074609c11426154, https://si.imgix.net/564cf00a/uploads/origins/09e62e39-18eb-4b2e-bc00-6aa1b52d34b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0c26fc