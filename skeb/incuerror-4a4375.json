ix.net/602726b6/uploads/origins/2a110350-dc83-42f1-a051-5e6b0e869c28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=716a73629ca19b85b8be5365e61e14bf", "srcset": "https://si.imgix.net/602726b6/uploads/origins/2a110350-dc83-42f1-a051-5e6b0e869c28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=716a73629ca19b85b8be5365e61e14bf, https://si.imgix.net/602726b6/uploads/origins/2a110350-dc83-42f1-a051-5e6b0e869c28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bd845dbbf9ec719ad8aeb3d64a6bf0b 2x, https://si.imgix.net/602726b6/uploads/origins/2a110350-dc83-42f1-a051-5e6b0e869c28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10eaeaad594622011638dd899b0c3511 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/602726b6/uploads/origins/2a110350-dc83-42f1-a051-5e6b0e869c28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1ca7fd4ec7edd8dacffa3200c671737", "srcset": "https://si.imgix.net/602726b6/uploads/origins/2a110350-dc83-42f1-a051-5e6b0e869c28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1ca7fd4ec7edd8dacffa3200c671737, https://si.imgix.net/602726b6/uploads/origins/2a110350-dc83-42f1-a051-5e6b0e869c28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a4e6d4db31d71641e2f1ba56ebd4a2a 2x, https://si.imgix.net/602726b6/uploads/origins/2a110350-dc83-42f1-a051-5e6b0e869c28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=85a05adb6955790cf0bdd254b3b805c4 3x"}, "body": "個人利用目的で依頼させていただきます。\n机上に飾るアクリルグッズを制作するため、その印刷用に使用するイラストをお願いしたくご連絡させていただきました。キャラクターはOC（オリジナルキャラクター）であり、権利上の問題はございません。\n\n\n表情：全体的に穏やかな雰囲気で、初めてプラネタリウムを見たときのような静かな感動や驚きを感じさせる表情をお願いいたします。軽く口を開けたり、目を大きく見開いたような描写を希望します。\nポーズ：軽く脱力した手や足を大きく開かない大の字のような形です。手や足が体の前にはなく、背中を押されたような形、無重力空間で体が勝手に前に進んでいくような姿勢で手と足は完全に脱力しきった形でお願いします\n背景：宇宙空間でお願いします。太陽や地球などの固有の形や特徴を持つ惑星は描かずに様々な等星の星を背景にちりばめてください。\n服装：宇宙服などは着せずに参考画像で来ているパーカーとジャージのズボンでお願いします。靴はスニーカーブーツのような形でメインカラーはパーカーよりも少し暗めな紺でひもやソールの色は白色でお願いします。細部はお任せします。\nその他：服や髪をなびかせてください。強風を正面から受けているような形でお願いします。全身があらかた見えるようにしてください。\n\n身長が168cmの19歳なイメージでお願いします。\n\n可能であれば、背景／人物／エフェクト（ある場合）をそれぞれ分けた画像として納品いただけますと助かります。psdでのレイヤー分け、または透過PNGの分割など、ご都合の良い形式で問題ございません。\nイラストは全体の解像度を1748px×1181px(148mm×100mmの300dpi)で制作していただけると助かります。\n\nご多忙の中恐縮ではございますが、ご検討のほど何卒よろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fi/5vzleslyj0bh07anihchb/4.png?rlkey=enu2lxzd7ajha25e29ibxlh34&st=5yb1hou9&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@incuerror/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a8b0e3bf/uploads/origins/fae50c84-c17d-44c4-9dc0-a16f4b2aaeca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c94c5de39dd4ec3b6056f10590005dd7", "srcset": "https://si.imgix.net/a8b0e3bf/uploads/origins/fae50c84-c17d-44c4-9dc0-a16f4b2aaeca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c94c5de39dd4ec3b6056f10590005dd7, https://si.imgix.net/a8b0e3bf/uploads/origins/fae50c84-c17d-44c4-9dc0-a16f4b2aaeca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=829442ce818ecc0a4af6b5584b5d6da8 2x, https://si.imgix.net/a8b0e3bf/uploads/origins/fae50c84-c17d-44c4-9dc0-a16f4b2aaeca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44082ca223cbc90aa01e7705ce6ed560 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id