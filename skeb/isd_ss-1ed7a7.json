.imgix.net/89679522/uploads/origins/9ede9a91-118d-460d-9598-3817cb768f93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85c92b14e057941356d92c7fb7c3014e 2x, https://si.imgix.net/89679522/uploads/origins/9ede9a91-118d-460d-9598-3817cb768f93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fff95a6fcaf8e8bed5150563964e2184 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89679522/uploads/origins/9ede9a91-118d-460d-9598-3817cb768f93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=950aaebe992ee9c38c865823829a5150", "srcset": "https://si.imgix.net/89679522/uploads/origins/9ede9a91-118d-460d-9598-3817cb768f93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=950aaebe992ee9c38c865823829a5150, https://si.imgix.net/89679522/uploads/origins/9ede9a91-118d-460d-9598-3817cb768f93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3426b5343f89aaaddfc44c2aa476fa12 2x, https://si.imgix.net/89679522/uploads/origins/9ede9a91-118d-460d-9598-3817cb768f93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=02b1e86f01e0492d9845e1a1fbe44522 3x"}, "body": "初めまして、Bilibiliという動画サイトで活動する予定になっているVtuber、希思Heathと申します。先生の人物、場面、雰囲気の描き方が素晴らしいですね、今回リクエストさせて頂きたく存じます。\n\n参考資料:\n希思Heath（ヒース）は、Bilibiliの配信で占いや雑談をメインに活動しているVtuberです。\n身長は１８１㎝、男性、外見は２４歳に見えるけど、実際の年齢は謎。\n髪の色は青寄りの白で、髪の一部が金色になっている、瞳はオレンジ色です。\nファンタジーな夢の世界に生まれて暮らしてきました彼は、自らエクソシストと名乗り、悪夢を追い払い人々の夢を守ることを担っている。\n夢の世界に迷い込んだ人を救い、特別な占い能力と魔法を使って、多くの人達を助けるのは彼の日常です。\n服装は中世期のスタイルをベースに、金属や宝石素材のアクセサリーなどに飾れております。身の回りには常に霊体の白猫が一匹ついています、その姿は少し透明に見える、描かなくてもいい。\n状況に応じてタロットカードや魔杖などを使って魔法を使うこともあります、必ずしもそれらを描く必要はありません。\nいつも微笑んでいて、話しやすい雰囲気をしている優しい青年です。\nhttps://drive.google.com/file/d/1Bzo-h8L93X3prLivB_j9dQs5QZK0_CQA/view?usp=sharing\n\n・サイズは16:9でお願いします。\n・シチュエーション・ポーズ・構図は先生にお任せします。衣装は設定図の衣装を参考にしたり、新しい衣装を描いたりすることができます。どうかご自由に描いてください！\n\n使用方法：\n自分のチャンネル、表紙、壁紙、SNS、有料メンバー様へのプレゼントなどに使用させて頂きたいです。\n\n人物・背景・サインを分けたpsdデータを希望いたします。\n\n以上、\nお忙しいかと思いますが、お手隙の際にご確認いただければ幸いです。\nぜひよろしくお願いいたします！\n\nhttps://drive.google.com/file/d/1Bzo-h8L93X3prLivB_j9dQs5QZK0_CQA/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@isd_ss/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 676518, "client_id": 2677494, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd9203c6/uploads/origins/45a2482f-39a0-4721-8fa3-195948abf5e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e794ab7a7d05fc6d0bd7c7fc3ac5fb8", "srcset": "https://si.imgix.net/cd9203c6/uploads/origins/45a2482f-39a0-4721-8fa3-195948abf5e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e794ab7a7d05fc6d0bd7c7fc3ac5fb8, https://si.imgix.net/cd9203c6/uploads/origins/45a2482f-39a0-4721-8fa3-195948abf5e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b160b46162e3e217babae1999f2fd2c 2x, https://si.imgix.net/cd9203c6/uploads/origins/45a2482f-39a0-4721-8fa3-195948abf5e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1589e0c515599b82ffd679d853757d3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd9203c6/uploads/origins/45a2482f-39a0-4721-8fa3-195948abf5e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=787975c0cfc7a9bb11079ff207c26fe7", "srcset": "https://si.imgix.net/cd9203c6/uploads/origins/45a2482f-39a0-4721-8fa3-195948abf5e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=787975c0cfc7a9bb11079ff207c26fe7, https://si.imgix.net/cd9203c6/uploads/origins/45a2482f-39a0-4721-8fa3-195948abf5e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&f