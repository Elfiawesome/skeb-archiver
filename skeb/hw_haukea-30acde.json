ている。\n\nツクヨの背後に浮いているウインドウには、\n『膣感度Lv〇　肛門感度Lv〇　乳首感度Lv〇　クリ感度Lv〇』\n『初体験相手・姉（レズ）』\n『性癖・レズビアン　クリトリス　マゾヒスト』\n等さまざまな性癖が書かれている。\n（各感度Lvの数値は適当で構いませんが、バランスはクリ＞膣≧乳首＞肛門くらいです）\n\nツクヨ自身は、自分のエロステータスが開示されていることに真っ赤になって恥ずかしがっていて、こちらから目を逸らしている。\n\n他にもゲーム画面のような表示や、えっちなステータス表記を盛ってください。\n参考・原作でのステータス画面↓\n\nhttp://t-walker.jp/eb/status/?chrid=c05620", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hw_haukea/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 231378, "client_id": 365900, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3603ffd/requests/75440_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e168a18d4f814d353d936bb8fe14ff7c", "srcset": "https://si.imgix.net/a3603ffd/requests/75440_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e168a18d4f814d353d936bb8fe14ff7c, https://si.imgix.net/a3603ffd/requests/75440_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7736eb86aa33251c328f3c29787176d 2x, https://si.imgix.net/a3603ffd/requests/75440_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19436e5603551e17e8a5178ee30f40ce 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a3603ffd/requests/75440_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34d496b413ed1b1840a41c3af38baf82", "srcset": "https://si.imgix.net/a3603ffd/requests/75440_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34d496b413ed1b1840a41c3af38baf82, https://si.imgix.net/a3603ffd/requests/75440_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2d4089fb7a3fb0a3a3b0a279adbb5686 2x, https://si.imgix.net/a3603ffd/requests/75440_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w