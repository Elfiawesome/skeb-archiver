いです。\n\nhttps://x.com/grayraven1006/status/1863430295967748406?t=7IY4FmXtECI-hvIVXO27mQ&s=19", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yaki555/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 804656, "client_id": 3288607, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89bae0ac/uploads/origins/95f8e3a5-8223-4973-a4b5-5cbefe2481ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e7afc4c2ac144d3f9cb4d0f7f1ea2b6", "srcset": "https://si.imgix.net/89bae0ac/uploads/origins/95f8e3a5-8223-4973-a4b5-5cbefe2481ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e7afc4c2ac144d3f9cb4d0f7f1ea2b6, https://si.imgix.net/89bae0ac/uploads/origins/95f8e3a5-8223-4973-a4b5-5cbefe2481ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d3917aac02573c4482a84e14d8e5412 2x, https://si.imgix.net/89bae0ac/uploads/origins/95f8e3a5-8223-4973-a4b5-5cbefe2481ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f45b7535a1ef556ebc8cb9c3b2092fa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89bae0ac/uploads/origins/95f8e3a5-8223-4973-a4b5-5cbefe2481ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87132203c025daf65af7b5628441f1bb", "srcset": "https://si.imgix.net/89bae0ac/uploads/origins/95f8e3a5-8223-4973-a4b5-5cbefe2481ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87132203c025daf65af7b5628441f1bb, https://si.imgix.net/89bae0ac/uploads/origins/95f8e3a5-8223-4973-a4b5-5cbefe2481ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1784ef4a7d8c561c34c156ce3ca4fa95 2x, https://si.imgix.net/89bae0ac/uploads/origins/95f8e3a5-8223-4973-a4b5-5cbefe2481ff?bg=%23fff&aut