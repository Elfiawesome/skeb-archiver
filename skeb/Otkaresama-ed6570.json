crop&crop=top&w=200&h=200&s=516b88f4d16d93c39a5274810449175e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94600dae/uploads/origins/90995b39-0c5d-45e5-a243-3d3ab030a58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60ce33811020f7a5cf8889f14acb8914", "srcset": "https://si.imgix.net/94600dae/uploads/origins/90995b39-0c5d-45e5-a243-3d3ab030a58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60ce33811020f7a5cf8889f14acb8914, https://si.imgix.net/94600dae/uploads/origins/90995b39-0c5d-45e5-a243-3d3ab030a58b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e6dbfbf8e4062b6dbb566f2c1903615 2x, https://si.imgix.net/94600dae/uploads/origins/90995b39-0c5d-45e5-a243-3d3ab030a58b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=955825fcf2146a60dea3d26eac4e4ae7 3x"}, "body": "こんにちは、私はあなたの作品に出会い、これらの絵で表現された雰囲気や感情がとても好きです。もし可能であれば、私のオリジナルキャラクターをあなたのスタイルで描いていただけないでしょうか。\n白髪のキャラクターは、人間と吸血鬼のハーフの少女（12～15歳くらい）で、赤い瞳と薄い肌の色、そしてかわいい牙を持っています。孤児で、母親は難産で亡くなっている。人間の男性（茶髪のキャラクター）の養女になったが、誤って彼を殺してしまった。\n感情としては、怖いとか、寂しいとか、落ち込んでいるとか、そんな感じにして欲しいです。身を寄せたり、廃墟に隠れたり、海に向かって歩いたりしているかもしれません。大まかなイメージはこんな感じで、細かいところはお任せしますので、このコンセプトのまま、好きなように描いてください。ご検討のほど、よろしくお願いします。\nhttps://drive.google.com/drive/folders/191n8LnDMEKOQgJWDE_c4grfmL8Aoc8Nr?usp=share_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Otkaresama/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1991228, "client_id": 1116701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65513b7b/uploads/origins/94483fb5-6c69-4cdc-8ae7-56b279f949d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d08013731546dee2c27973efa2f63726", "srcset": "https://si.imgix.net/65513b7b/uploads/origins/94483fb5-6c69-4cdc-8ae7-56b279f949d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d08013731546dee2c27973efa2f63726, https://si.imgix.net/65513b7b/uploads/origins/94483fb5-6c69-4cdc-8ae7-56b279f949d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbc81b8b5fcbd6558806f6b1b277977b 2x, https://si.imgix.net/65513b7b/uploads/origins/94483fb5-6c69-4cdc-8ae7-56b279f949d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a19afb669aec0d2a676f2e89e9ee265 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65513b7b/uploads/origins/94483fb5-6c69-4cdc-8ae7-56b279f949d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d1bf82f646425c1ae7df5d1c7be6548", "srcset": "https://si.imgix.net/65513b7b/uploads/origins/94483fb5-6c69-4cdc-8ae7-56b279f949d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d1bf82f646425c1ae7df5d1c7be6548, https://si.imgix.net/65513b7b/uploads/origins/94483fb5-6c69-4cdc-8ae7-56b279f949d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8a25a5ddc13db55277eb832737d4d5a0 2x, https://si.imgix.net/65513b7b/uploads/origins/94483fb5-6c69-4cdc-8ae7-56b279f949d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5509787f82a30b23f7a38dc725746075 3x"}, "body": "こんにちは、つららさん。あなたのアートワークはとても魅力的です。\n私のオリジナルキャラクターのアートワークをお願いしたいです。\n彼女は痩せ型で、関節や血管が皮膚の下に見えています。飛行機事故で左腕を失い、左顔面も大やけどを負っています。\nできれば、水槽の中に沈んでいる姿や、ゴミの山の中でネズミと一緒にいる姿などを希望します。\nその他はご判断にお任せします。私の依頼を読んでいただき、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1GcsT_ISP9ql1M-qWaXYrmErmfg6Kzmdy", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Otkaresama/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id":