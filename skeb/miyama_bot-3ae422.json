4-4ef0-8afb-7bd0b367eaad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c435a12826f6e7be0c00225ed4e3dabc", "srcset": "https://si.imgix.net/901faf9e/uploads/origins/961604e3-aeb4-4ef0-8afb-7bd0b367eaad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c435a12826f6e7be0c00225ed4e3dabc, https://si.imgix.net/901faf9e/uploads/origins/961604e3-aeb4-4ef0-8afb-7bd0b367eaad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dc14bafdc801d0ed0a7dfb7a5f5b44eb 2x, https://si.imgix.net/901faf9e/uploads/origins/961604e3-aeb4-4ef0-8afb-7bd0b367eaad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=951b4623ef9fe71e2b241eec0ae272a8 3x"}, "body": "こんにちは\nれんぼるとと申します。\nうちの子をミヤマ様の絵で見てみたいと思い、リクエストを送らせていただきました。\nうちの子の羅　桜花という子を描いてもらえないでしょうか。\n資料はこちらです。（サブ垢の画像アップ\nhttps://twitter.com/l_volt_sub/status/1684110856618119168?s=20\n\nリンク先に設定が書いてますが元気なチャイナっ子です。\n\nもしお手が空いていたらよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyama_bot/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 335876, "client_id": 2704903, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3af47b5a/uploads/origins/8d55a6ec-e01f-4564-a2dd-33b0910f32ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c02c065c53b0abb8322a3a6a9016255a", "srcset": "https://si.imgix.net/3af47b5a/uploads/origins/8d55a6ec-e01f-4564-a2dd-33b0910f32ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c02c065c53b0abb8322a3a6a9016255a, https://si.imgix.net/3af47b5a/uploads/origins/8d55a6ec-e01f-4564-a2dd-33b0910f32ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53d8a6a10370cd0fa8a47f1f00be8a1f 2x, https://si.imgix.net/3af47b5a/uploads/origins/8d55a6ec-e01f-4564-a2dd-33b0910f32ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73b1b6752c3d519ed789bb975c49dce4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3af47b5a/uploads/origins/8d55a6ec-e01f-4564-a2dd-33b0910f32ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffc356e181cbf4b638aea9e6d0c098f3", "srcset": "https://si.imgix.net/3af47b5a/uploads/origins/8d55a6ec-e01f-4564-a2dd-33b0910f32ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffc356e181cbf4b638aea9e6d0c098f3, https://si.imgix.net/3af47b5a/uploads/origins/8d55a6ec-e01f-4564-a2dd-33b0910f32ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b67e5a1a1d2579f686cc968215a55e05 2x, https://si.imgix.net/3af47b5a/uploads/origins/8d55a6ec-e01f-4564-a2dd-33b0910f32ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8e408e2dc033c7f821d67730aae3620f 3x"}, "body": "私はプロフィル画像がいつもヨロッパの伝統的なメイド服を着ている私と似ている女の子でした。\nSNSで使うために、個人的にも仕事でも使えるバストサイズのキャラクターイラストを、依頼してもよろしいでしょうか。\n\nもし、依頼をお受け付けでしたら、いくつかの参考画像が集まった画像を作りました。上の画像は、私が過去に依頼した画像で、デザインのいいベースとなりそうなものです。\nhttps://i.imgur.com/yhmmCrp.png\n\n-サイズは顔から首か胸まで。\n-可能であれば（追加料金があってもかいません）、伝統的なメイドのかぶり物ではなく、サウンドヘッドギアとメイドのかぶり物の間のようなデザイン（以前依頼された@gemini_inkのイラストの2枚目にあるようなもの）。\n-アイコンが円形でサイズダウンしても、遠くからでもよくわかるようなもの。\n-服装はヨーロッパの伝統的なロングメイドドレスでお願いします。白いエプロンと黒いドレス以外、デザイン自体にあまりこだわりはありません。必要であれば、ここにドレスのインスピレーションがありますが、ここまで詳細である必要はありません。\nhttps://i.imgur.com/pKjfn3e.png\n-ポーズは特に硬くする必要はありません。キャラクターは寝そべっていても、目を閉じていてもかまいません。\n-髪の毛はとてもカールしていることが重要ですが、極端になりすぎず、アフロのような髪型にならないように、以前依頼されたアートワークと似", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyama_bot/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 335876, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.ne