いる感じで手にあたる部分をゲッターロボの頭部の角の様にＶ字に伸ばしていただけると再現度が高いかと思います\n\n飛行中のイラストには「応ッ！チェィィィンジ！！」というセリフを入れていただけると助かります\n\n意味不明な依頼だとは思いますがこちらも思いつきで送っているので気が向いたらで結構です\n宜しくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yokoi_bitko/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1430651, "client_id": 1496818, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42dc94e3/uploads/origins/8493eac6-ce68-4917-9c35-5b9826af7b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39aa51fc6fa1a1fea91c4b5f470cd2e5", "srcset": "https://si.imgix.net/42dc94e3/uploads/origins/8493eac6-ce68-4917-9c35-5b9826af7b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39aa51fc6fa1a1fea91c4b5f470cd2e5, https://si.imgix.net/42dc94e3/uploads/origins/8493eac6-ce68-4917-9c35-5b9826af7b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d5238592d8b37b52bdb3746dfc608ac 2x, https://si.imgix.net/42dc94e3/uploads/origins/8493eac6-ce68-4917-9c35-5b9826af7b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11b903a078fb475ce227d0eea880aada 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42dc94e3/uploads/origins/8493eac6-ce68-4917-9c35-5b9826af7b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95955ddfd2f9577ff9c1e11802d23d24", "srcset": "https://si.imgix.net/42dc94e3/uploads/origins/8493eac6-ce68-4917-9c35-5b9826af7b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95955ddfd2f9577ff9c1e11802d23d24, https://si.imgix.net/42dc94e3/uploads/origins/8493eac6-ce68-4917-9c35-5b9826af7b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a88448aa7800892df37f64c7c98b82e1 2x, https://si.imgix.net/42dc9