3d7-4935-89ee-c1d4bbc8112e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe6e8b4c66a011317f5829004fa58f1a", "srcset": "https://si.imgix.net/7b9e922d/uploads/origins/bc360e86-13d7-4935-89ee-c1d4bbc8112e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe6e8b4c66a011317f5829004fa58f1a, https://si.imgix.net/7b9e922d/uploads/origins/bc360e86-13d7-4935-89ee-c1d4bbc8112e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a6b9d68d3b8df321b660a718c2befda8 2x, https://si.imgix.net/7b9e922d/uploads/origins/bc360e86-13d7-4935-89ee-c1d4bbc8112e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=51fccfc6d54e5f2bdd495e90fa284bde 3x"}, "body": "唯鬼さんのイラストが大好きすぎ！\n\n私のオリジナルキャラクターを描いてほしいです! 黒髪の人は吸血鬼で、金髪の人は半分人間です。二人は、黒髪の方がもう一人の方を食料として必要としているような関係です。彼らは必要に迫られて一緒にいるが、望んでいるわけではない。複雑な関係! 黒髪の方は少し厳格で、金髪の方はとてものんびりしています。しかし、最初は仲が悪くても、そのうち恋愛関係になる。ヴァンパイアでありながら、普通の10代の高校生でもある。黒髪の方は少し厳格で、金髪の方はとてものんびりしています。\n\n金髪の方はとても馴れ馴れしく、粘着質（そしてちょっとバカ）ですが、黒髪の方は触ったり、コミュニケーションをとるのが苦手なようです。この二人は正反対で、どんな困難があっても、一緒になることを余儀なくされるのです。\n\n服装を変えたり、デフォルメしたりと、キャラクターを自由に解釈して描いてください。\n\nありがとうございましたー！！\n\nhttps://imgur.com/a/a5nAzgY\n\nhttps://imgur.com/a/a5nAzgY", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yuioni/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 238625, "client_id": 742047, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1c4de32/uploads/origins/1e758134-54bf-417e-a75a-3bfe376506c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c5eb3c51755d9846f7a0f29c700e0cc", "srcset": "https://si.imgix.net/c1c4de32/uploads/origins/1e758134-54bf-417e-a75a-3bfe376506c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c5eb3c51755d9846f7a0f29c700e0cc, https://si.imgix.net/c1c4de32/uploads/