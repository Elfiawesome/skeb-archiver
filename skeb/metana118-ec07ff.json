=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ef5494b7d6b511f1d1756ee5982cadc 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5946588a/uploads/origins/eeff5731-a1fe-4da8-9b68-85627b6092c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d0e0c2292e7e9a969fb0e1ef44809f9", "srcset": "https://si.imgix.net/5946588a/uploads/origins/eeff5731-a1fe-4da8-9b68-85627b6092c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d0e0c2292e7e9a969fb0e1ef44809f9, https://si.imgix.net/5946588a/uploads/origins/eeff5731-a1fe-4da8-9b68-85627b6092c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=92b3db319655e1e3af6ee34aabba8107 2x, https://si.imgix.net/5946588a/uploads/origins/eeff5731-a1fe-4da8-9b68-85627b6092c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9076827824f5c6d04d1a45eef0e66e08 3x"}, "body": "依頼失礼します。\n以前依頼致しました続きものをお願いします。\n褐色ちゃんが銭湯来て、ショタ君が勃起したちんちんで勝負を挑みます。\nしかし、最初の勃起で負けてしまい、お兄さんと勝負した時よりも包茎チンチンが玉や竿が更に大きくなります。\nその後負けたショタ君は、褐色ちゃんの玉で玉ズリし射精します。\n褐色ちゃんはムラムラきながら更に大きくなり剥けます。\nそしてゼリーのような精子を撒き散らしながら勢いよく射精します。\n何回かぶっかけ、精液まみれになるのを希望します。\nショタ君はちんちん大きめでお願いします。\n可能でしたら、セリフをお願いします。\nよろしくお願いします。\n\nhttps://skeb.jp/@metana118/works/2", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@metana118/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 971517, "client_id": 273262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e81f66c6/uploads/origins/65168785-1058-44c9-9b67-aa1ce9dcecfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e79fc8c5bb4bf673b6663e050eb375d1", "srcset": "https://si.imgix.net/e81f66c6/uploads/origins/65168785-1058-44c9-9b67-aa1ce9dcecfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e79fc8c5bb4bf673b6663e050eb375d1, https://si.imgix.net/e81f66c6/uploads/origins/65168785-1058-44c9-9b67-aa1ce9dcecfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a299c3d58a134dacc5018ae502feb8c2 2x, https://si.imgix.net/e81f66c6/uploads/origins/65168785-1058-44c9-9b67-aa1ce9dcecfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f5c9cdd078e4c5553aea34f463f8ea4 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e81f66c6/uploads/origins/65168785-1058-44c9-9b67-aa1ce9dcecfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=309cc6f09c9fac5cb49f8b43d113779a", "srcset": "https://si.imgix.net/e81f66c6/uploads/origins/65168785-1058-44c9-9b67-aa1ce9dcecfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=309cc6f09c9fac5cb49f8b43d113779a, https://si.imgix.net/e81f66c6/uploads/origins/65168785-1058-44c9-9b67-aa1ce9dcecfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=95e8ca3c796b2b15dacfe140f31903dd 2x, https://si.imgix.net/e81f66c6/uploads/origins/65168785-1058-44c9-9b67-aa1ce9dcecfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0dc8696ee95ddf3a1bade1855f08696a 3x"}, "body": "Xでめたな様の素敵なイラストを見てリクエストした次第です。可能であればイラスト作成をお願いします。\n・キャラクター\nめたな様がX及びpixivに投稿した『下駄箱マークングちゃん』でお願いします。\nhttps://www.pixiv.net/artworks/115395862\n\n●構図・シチュエーション\nhttps://x.com/mizi_kayo_r18/status/1864882460451864806?s=46\nのような正面を向き、爆乳を窓ガラスに押し付けて乳ワイパーみたいになっており、制服の間から谷間が見えるほか、制服からブラジャーが透けて見える感じでお願いします。シチュエーションは、電車の扉付近に立っており、通勤ラッシュ時に車内があまりにも窮屈のため窓ガラスに爆乳を押し付けて悶絶している中、並走している電車に好きな人が乗ってこちらを見ているのに興奮しまい、徐々に勃起してしまい窓ガラスと爆乳に挟まれてセルフパイズリ状態になって射精するイラストもお願いします。\n車内の人たちは、参考資料と同じでお願いします。\n\nまた、可能でしたら、『下駄箱マーキングちゃん』の設定画をお願いします。イラスト依頼と設定画をリクエストしましたが、この子の名前などのパーソナルデータを出していただきたいです。推しの子を知りたいので……！\n※金額的に厳しそうでしたら、設定画は無しでも構いません。\n長々と失礼しました。お受けいただければ幸い\nです。何卒よろしくお願いします。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@metana118/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 971517, "client_id": 707430, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21545bf3/uploads/origins/55bbead6-cf7d-4b8a-9608-8e83843b62e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=495438270fd4c0d00cf71eb14d6d9f8e", "srcset": "https://si.imgix.net/21545bf3/uploads/origins/55bbead6-cf7d-4b8a-9608-8e83843b62e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=495438270fd4c0d00cf71eb14d6d9f8e, https://si.imgix.net/21545bf3/uploads/origins/55bbead6-cf7d-4b8a-9608-8e83843b62e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c84aea427f2c79c1204995ad80c8705a 2x, https://si.imgix.net/21545bf3/uploads/origins/55bbead6-cf7d-4b8a-9608-8e83843b62e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c46e3902e46f6ec76d3fdf109c73e190 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21545bf3/uploads/origins/55bbead6-cf7d-4b8a-9608-8e83843b62e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83ac6a13818638b8970c189c6a230f31", "srcset": "https://si.imgix.net/21545bf3/uploads/origins/55bbead6-cf7d-4b8a-9608-8e83843b62e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83ac6a13818638b8970c189c6a230f31, https://si.imgix.net/21545bf3/uploads/origins/55bbead6-cf7d-4b8a-9608-8e83843b62e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b8692711cb1bbe8617f3d3996b9f57b5 2x, https://si.imgix.net/21545bf3/uploads/origins/55bbead6-cf7d-4b8a-9608-8e83843b62e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=12e15ed1d6860a9baa65667a4eed6285 3x"}, "body": "リクエストに不備があったので再送致します。\n東方の四季映姫様が、ショタ君とちんこ比べし最後に思いっきりぶっかけるのをお願いします。映姫様とショタ君が互いに勃起したちんこをくっつけます。その後、擦り合いショタ君が射精します。そして、映姫様が刺激で更に勃起し、全身にぶっかけを行いながら大量射精をします。\nショタ君はやや大きめの包茎ちんちんで、15cmぐらいでお願いします。\n映姫様は最初は胸くらいまで長さがあるちんちんで、少ししか剥けていない包茎ちんちん。その後の勃起で、顔より大きなちんちんになり太さも倍増し、ズルムケになります。玉も大きめでお願いします。また映姫様のおっぱいは爆乳で希望します。\n可能でしたらセリフなど入れていただきたいです。よろしくお願いします。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@metana118/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 971517, "client_id": 1996912, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/77362a88/uploads/origins/514c0b63-9dfd-40f2-8f35-d3507ea4a79f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e24fd2354a368b105ea12fa30219e1a", "srcset": "https://si.imgix.net/77362a88/uploads/origins/514c0b63-9dfd-40f2-8f35-d3507ea4a79f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e24fd2354a368b105ea12fa30219e1a, https://si.imgix.net/77362a88/uploads/origins/514c0b63-9dfd-40f2-8f35-d3507ea4a79f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d85279100390aab8f7a67701ef5faf1d 2x, https://si.imgix.net/77362a88/uploads/origins/514c0b63-9dfd-40f2-8f35-d3507ea4a79f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=615ced0d12993f503b8add704a818380 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/77362a88/uploads/origins/514c0b63-9dfd-40f2-8f35-d3507ea4a79f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38cef23bc9f96d6920572991d5a5797b", "srcset": "https://si.imgix.net/77362a88/uploads/origins/514c0b63-9dfd-40f2-8f35-d3507ea4a79f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38cef23bc9f96d6920572991d5a5797b, https://si.imgix.net/77362a88/uploads/origins/514c0b63-9dfd-40f2-8f35-d3507ea4a79f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d935165d372b2737534e2ac3f6af3549 2x, https://si.imgix.net/77362a88/uploads/origins/514c0b63-9dfd-40f2-8f35-d3507ea4a79f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0f3f6f90bcc3ab4466db94d59088f10f 3x"}, "body": "下記資料urlより私のOC、ロリ爆乳ツインテメイド乳魔のリアラちゃんをお願いします。\nメスガキチックですが一途で世話焼きな娘です。\n\n構図\n・膝上ご奉仕生乳パイズリを正面から\n・\nhttps://www.pixiv.net/artworks/108510186\nめたなさんが直近に描かれたこの作品のような構図がめちゃ好みです。おっぱいはこれくらいに超絶特大、乳首も大きく。竿役の亀頭もこんな感じで谷間から飛び出している。一方で、普通に手をおっぱいに添えた女性上位的なスタンダードご奉仕パイズリをお願いします。\n・おっぱいにローションをぶちまけた光沢を\n・射精シーンではエグい量の黄ばんだ精液が勢いよく大量噴出する。\n・擬音をしつこめに沢山入れて頂けると嬉しいです。\n・ズリ1 ズリ2 射精　の三枚組程度\n\nセリフ類\n「旦那さま♡パイズリされながら聞いて欲しいんですけどぉ♡実は今日、体に幻覚魔法かけ忘れたままお買い物行っちゃいました♡」\n「旦那さまにしか絶対見せないリアラのたゆたゆぷるもちおっぱい、町の男の人たちにも視姦されちゃいました♡」\n「み〜んな急に前屈みになって♡隠れておち◯ぽしこしこ始めちゃって♡と〜っても気持ち悪かったです♡」\n\n「あんっ♡♡旦那さまのおち◯ぽさんビクってしました♡しこしこのおかずにされるリアラを想像しちゃったんですか？♡」\n「えへへ〜♡そんな無差別発情おっぱいで旦那さまは毎日何十回もパイズリされてるんですよ〜♡♡優越感すごいですよね♡」\n「他の人は自分のお手てで寂しいぴゅっぴゅ♡でも旦那さまだけはリアラの愛をこめたおっぱいずりずりで幸せどっぴゅん♡♡♡」\n「あっ♡もう出ますか？♡いいですよ♡♡♡旦那さまの幸せみるく♡リアラの143cmおっぱいでぶち撒けてく〜ださい♡♡♡」\n\n「あはー♡溶岩みたいなお精子どっぴゅん♡♡♡量も勢いもエグくって♡ギットギトで臭いもすっごぃですよ♡♡なんだか幸せよりも別の情念が篭ってますね〜♡♡なんでしょう？♡」\n「えっ…？リアラのこと、絶対誰にも渡さないって…？」\n「あぅ…♡♡♡旦那さまにそんなこと言われたら 幸せすぎて倒れちゃいますよ…♡♡♡大好き…♡♡♡」\n\nhttps://drive.google.com/drive/folders/1sBcCC-2ahTPsnnty3xpgdvNXTGG77EBC?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@metana118/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 971517, "client_id": 607637, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a3bf027/uploads/origins/a160370e-db12-45b3-9869-a0a0cc28df2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd1375d405a7f25ad69b35431f6ecbfa", "srcset": "https://si.imgix.ne