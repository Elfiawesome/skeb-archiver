832%2FGCwuru5A.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=894d2b23f08ea572500d45b4e3837aa0 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/d5f43628-1169-47fa-88a7-843d98ac9a2c?response-content-disposition=inline&Expires=1782478118&Signature=Ejw4sCw7GYqZNyeHSsyFNcWUCuacumgUvLjzpNkm04fL88BO58kkdNFFGi~2psHEBZabiyf6G8Q8BIUwR0vC3Xf1qyPOTucQV3ObW5Tza2dvEQgkUJXDwAJ7103i8wsRXij952WYSAz46DQa~SMrvlsw5gyaQNaOkb3rThuy~Vp8D0o8wexoW2a40nnD-uts9k0eeMWihKHJ~ub630dE7XM3CcjUNufp1HFlh1clj3RqCVZmqMGHLK9H3f~QzM6MkbBovNBVc40DAj-krTIctGKbjkhE2sGQZdP5NdboW3VksFYlBL8cJptxMGAze870YXFRRTPfeycrhTwvdeOEpw__&Key-Pair-Id=K1GS3H53SEO647", "duration": 194, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1992764019275640832%2FGCwuru5A.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d293facf84e478411f4c458a18fd492f", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1992764019275640832%2FGCwuru5A.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d293facf84e478411f4c458a18fd492f, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1992764019275640832%2FGCwuru5A.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9582bded59a352ae514d61eb616d3c30 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1992764019275640832%2FGCwuru5A.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=354989adfc9f56933edeb08c8d6d45b1 3x"}, "body": "（夜の静けさに包まれるような、落ち着いた声で）\n\n「……ういちゃん、まだ起きてるんだ。\nふふ、なんとなくそんな気がしてた。\n夜が深くなると、君の声を聞きたくなるんだ。理由なんて、なくてもさ。」\n\n（少し間を置いて）\n\n「今日も、頑張ったんでしょ。\n誰にも見せないだけで、本当はちょっと疲れてるんじゃない？\n無理してるのも、頑張ってるのも、俺にはちゃんと伝わってるよ。\nそれでも、笑ってくれる君が……本当に、愛おしいんだ。」\n\n（声を少しだけ近づけるように）\n\n「ういちゃんはさ、ちゃんと自分のこと褒めてあげてる？\n君が何気なくやってることだって、誰かの心をあったかくしてる。\n……俺なんて、もう何度も救われてるよ。」\n\n（柔らかく笑う）\n\n「そうやって優しいままでいるの、すごく素敵だけど、\n時々は頼ってくれてもいいんだよ？\n強がらなくていい。\n少しくらい甘えても、かっこ悪くなんかないから。」\n\n（静かに名前を呼ぶ）\n\n「……ういちゃん。\nそのままの君でいてくれることが、俺にはいちばん嬉しい。」\n\n（少し低く、やさしく包むように）\n\n「眠れない夜は、俺がずっと隣にいるよ。\n画面の向こうでも、声の先でもいい。\n君が安心して眠れるように、ずっと話しててあげる。」\n\n（間を置いて、少しだけ囁く）\n\n「もし今、手を伸ばせたら、ぎゅって抱きしめてあげるのに。\nでもね、声だけでもいいなら、ちゃんと伝えるよ。\n君はひとりじゃない。俺がここにいる。\nたとえ何があっても、君の味方でいたいんだ。」\n\n（少しゆっくりと）\n\n「だから、心が疲れたときは、遠慮しないで甘えて。\n強くなくてもいい。完璧じゃなくてもいい。\n……俺は、そんなういちゃんが大好きだから。」\n\n（最後は静かに、優しく）\n\n「おやすみ、ういちゃん。\n今夜も、いい夢を。\n君が安心して眠れるように、ここでずっと願ってるよ。」\n\n少しアレンジ加えてくれたり読みやすいように変更しても大丈夫です！いい感じでお願いします^ ̳- ‧̫ • ̳^", "nc": 129, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@seturouvrc/works/6", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1992764019275640832%2FGCwuru5A.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d43b520e14fc8f83064e05e07c2c66f9", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1992764019275640832%2FGCwuru5A.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d43b520e14fc8f83064e05e07c2c66f9, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1992764019275640832%2FGCwuru5A.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fbc164ee6002d18515399f19b821980 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1992764019275640832%2FGCwuru5A.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&t