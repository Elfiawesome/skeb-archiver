89bc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f96af7edd60aebb3ef9176bf1d33f4cf 3x"}, "body": "もつ煮込鍋様こちらでははじめまして！\nこの度は私の創作キャラを描いたいただくべくリクエストさせていただきました！\n\n《利用目的》\n個人鑑賞、個人利用範囲内でのグッズ作成(ネップリなど)\n\n《依頼内容》\n 創作キャラのイラストをお願いしたいです！ \n刀を抜いて笑いながら戦っている場面を敵目線で描いていただきたいです！可能であれば氷エフェクトも入れてもらえたら嬉しいのですがごちゃごちゃしすぎるようでしたら無くても大丈夫です…！\n\n《キャラクター詳細》\n黒髪で白メッシュが入った男性。元々は人間でしたが鬼側の村にいった際に血を飲まされてしまい、今では鬼と人間の2つの人格が1つの体にいます。\n鬼の人格が主導権を握っており、誰と会うにも彼が表に出ている。鬼の彼は飄々とした性格です。\n常に相手に対し煽り口調であり、相手を怒らせて戦意を削ぐ方法をしています。\n身長は181cm(ヒール込みだと185cm)見た目年齢29歳。まつ毛が長いです。\n「あははっ！俺とお話したい？面白いこと言うねぇ。君、警戒心何処かに置いてきたの？」\n「はーぁ、思ったよりも弱かったな。つまらない」\n「あっはは！中々骨があるねぇ君。面白いなぁ！」\n「暗い？足元気をつけなよ。そこ木の根があるからころ…ほら転ぶでしょ？鈍臭いねぇ君」\n\n\n こちら資料になります。\nご検討どうかよろしくお願いいたします！\nhttps://www.foriio.com/works/1536916\n\nhttps://www.foriio.com/works/1536916", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 819702, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "おさかな🐠主に告知用", "screen_name": "osakanahome", "avatar_url": "https://pbs.twimg.com/profile_images/1992959294988500994/s3rK7udN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/754467324736835584/1763993039/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 1377233, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "千夜糸（ちよいと）", "screen_name": "zattathiyo", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-72465562-d2e8-4bd6-ac1b-f5c2c9c39802.png&avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null,