ed_works": [{"path": "/@nstime23/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 413876, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03316cfa/uploads/origins/ea076344-9b3c-4c9b-b360-a74eacf38a44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c2b46539cfda0333528816e60b62e56", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03316cfa/uploads/origins/ea076344-9b3c-4c9b-b360-a74eacf38a44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6550a300f2d887a762a5b0554c607e37", "src_set": ""}, "body": "ひろプリより、キュアスカイを是非お願いいたします。強敵との戦闘中…のような、緊張感ある雰囲気でお願いしたいです。イメージは、『ヒロアカ』原作36話(第5巻p.17)の、爆豪と戦闘しているお茶子のような感じです。汗か、口元の擦り傷を拭うような、そんな構図でお願いいたします。\n\n先生の作品に元気をもらっています。\n連載も開始されたとのこと、\nこれからも応援しております！\nお忙しいとは存じますが、\n何卒よろしくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nstime23/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 413876, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e12670f7/uploads/origins/7a06ab64-9f7d-49c0-a9a5-c82c7814ba9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6abdadee81aaf95be9b66984d040b70e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e12670f7/uploads/origins/7a06ab64-9f7d-49c0-a9a5-c82c7814ba9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c36656dbeb6e517e54cf1c26c951ced", "src_set": ""}, "body": "野口祥汰 様\n\nいつも先生の素敵な作品を\n楽しく拝見しております。\nお忙しいところ恐縮ですが、\nリクエストさせていただきます！\n\n特に、先生のお描きになるプリキュア作品が大好きでして、この度、こむぎのリクエストをさせていただきます。\n\n・突飛な内容で恐縮ですが…「夏目漱石の格好をしたこむぎ(犬ver.)」をお願いできればと思います！漱石は、あの有名な、こめかみに手を当てている肖像画のものでお願いしたいです！\n\n本日の『キミプリ』にて、「俺様は犬である」が出てきたので、これは是非、野口先生に描いていただきたい！と思いました。笑\n\nこれからも応援しております！\nお身体にお気をつけてご活躍ください！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nstime23/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 413876, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/806f4b9c/uploads/origins/5b8da531-a0c8-47c6-87ba-39244cb5134c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=782547db4b98a33c1ebfdde783cc6d23", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/806f4b9c/uploads/origins/5b8da531-a0c8-47c6-87ba-39244cb5134c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cac9d52c47f260828ecc09eb8ddd0c50", "src_set": ""}, "body": "こんにちは! 1pマンガ形式で\n\n私のオリジナルキャラクター(ポニーテールの少女、名前はレイ、不良ヤンキー少女)\nをプリキュアに敗北して逃げるアイワーンの姿を見てあざ笑うと怒ったアイワーンが直接体を奪取してアイワーンの姿に変化した姿を見たいです。\n\n(プリキュアは登場しません。)\n\nhttps://imgur.com/a/hkESxNJ", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nstime23/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 413876, "client_id": 231268, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0df59a1e/uploads/origins/600b175d-8d1d-4c72-9262-207d194bb312?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b231f6ca9ce191b0f1b45b0073820c1b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0df59a1e/uploads/origins/600b175d-8d1d-4c72-9262-207d194bb312?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03c626a5c045dd9915fc24b62d0fb32d", "src_set": ""}, "body": "こんにちは、お邪魔します。野口祥汰さんのミルワーンのノットレイダープリキュア計画シリーズがとても好きです。キュアラメールに焦点を当てたシーンが見たいです。ノットレイダー化に落ちていくローラちゃんの精神を描いてほしいです。ノットレイダーがアスミの精神を侵食しているシーンと同じように、「意識も朦朧として」ような雰囲気で。\n\nノットレイダープリキュア計画シリーズの一環でも、似たような洗脳ものでも、どちらがいいかはお任せします。説明のためのセリフがあるといいのですが、それ以外の構成やセリフはお任せします。\n\nリクエストを読んでいただきありがとうございました。", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nstime23/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 413876, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55e3d943/uploads/origins/85aa7bdd-4b85-47e6-8d89-0dbbfb6e84c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec951c5699d6d53e713ece4d6a1e5546", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55e3d943/uploads/origins/85aa7bdd-4b85-47e6-8d89-0dbbfb6e84c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f69b1676acd5c57d0e297432fde61224", "src_set": ""}, "body": "もし良かったら固め系シチュエーションの漫画を依頼できないでしょうか！\n\n依頼したいシチュエーションは「FGOの清姫（水着版）が、黄金のゴーレムと戦闘中に、ゴーレムから浴びせられた光によって体を金に変えらて、黄金像にされてしまう」という内容です。\n清姫の水着衣装は何パターンかあるのですが、できれば黄色い水着の衣装でお願いします。\n\n以上、よろしくお願いします！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nstime23/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 413876, "client_id": 725527, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e1fb287/uploads/origins/1e0b48ec-1a68-48aa-ab45-d7b4266caa14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77002477600abdc73f062a1ef0e92a00", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e1fb287/uploads/origins/1e0b48ec-1a68-48aa-ab45-d7b4266caa14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a42a6f15c133a788ae9d808fd57cd73f", "src_set": ""}, "body": "デュラララの折原臨也さんがパーカーを着てニヤリとした表情をしています。背景には月が写っています。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nstime23/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 413876, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e93677d3/requests/247213_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0aee3034d0e5d5a2c7b5c2f3f3229d79", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e93677d3/requests/247213_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfac5a15c28f83e04f5db04dcc812aab", "src_set": ""}, "body": "初めまして。\n野口様の描かれる固め漫画が大好きです！なので、自分も依頼したくなりこのコミッションを送らせていただきます！\n\nもし良かったら、艦これの川内の固め漫画をお願いします！\nシチュエーションは「艦娘対抗水泳大会のために用意されていた優勝トロフィーを壊してしまった川内が、罰として固められてトロフィー代わりの黄金像にされて飾られてしまう」という内容です。\n川内の服装はピッチリとフィットした競泳水着で、罰を拒否しようとした瞬間に金化されてツルテカな黄金像にされた感じでお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nstime23/works/22", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8689c0e3/requests/217727_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3e5d09577e130cada69fb1960d16585", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 413876, "client_id": 662576, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nstime23/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true