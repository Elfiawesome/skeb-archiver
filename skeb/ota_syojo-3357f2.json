%e3%82%a4%e3%83%a1%e3%83%bc%e3%82%b8%e3%82%ad%e3%83%a3%e3%83%a9%e3%82%af%e3%82%bf%e3%83%bc/\n\n【イラスト詳細】\n以前投稿されていたヴァイキング姿の女の子のイラストがとても素敵でした。\n\n是非ともヴァイキング風な衣装でお願いしたいです。\n髪型は下ろしている方のイラストのような感じでお願いします。\nポーズや表情等はお任せいたします。\n\n【用途】\nイラストはキャラクターの詳細ページにて掲載と紹介。\n印刷して自宅に飾らせていただきたいです。\n\nよろしくお願いいたします。\n\nhttps://blaise-tacos.com/blaise%e3%82%a4%e3%83%a1%e3%83%bc%e3%82%b8%e3%82%ad%e3%83%a3%e3%83%a9%e3%82%af%e3%82%bf%e3%83%bc/", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ota_syojo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1033243, "client_id": 105614, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ade0ec99/uploads/origins/6bafaaa1-27fc-41d5-9c74-0492264efd6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c208a30e47fc7fdf0921f042ed0f2cec", "srcset": "https://si.imgix.net/ade0ec99/uploads/origins/6bafaaa1-27fc-41d5-9c74-0492264efd6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c208a30e47fc7fdf0921f042ed0f2cec, https://si.imgix.net/ade0ec99/uploads/origins/6bafaaa1-27fc-41d5-9c74-0492264efd6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a79e94a1fb45e4473f184e6046d669c 2x, https://si.imgix.net/ade0ec99/uploads/origins/6bafaaa1-27fc-41d5-9c74-0492264efd6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c809fcfe40fb4e87b4bf7db93a78754 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ade0ec99/uploads/origins/6bafaaa1-27fc-41d5-9c74-0492264efd6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26d83bb779aa27a24620a34dce0f40e5", "srcset": "https://si.imgix.net/ade0ec99/uploads/origins/6bafaaa1-27fc-41d5-9c74-0492264efd6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26d83bb779aa27a24620a34dce0f40e5, https://si.imgix.net/ade0ec99/uploads/origins/6bafaaa1-27fc-41d5-9c74-0492264efd6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c5d5e05627dd398fb4099367239378a6 2x, https://si.imgix.net/ade0ec99/uploads/origins/6bafaaa1-27fc-41d5-9c74-0492264efd6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a6621ed3ac46526aa5b1af524bec018 3x"}, "body": "はじめまして。個人VTuberの光りりあと申します。\nTwitterでお見かけした先生のVTuberをメカ少女化したイラストが素晴らしかったので、ぜひ私も描いていただきたいと思い、お声がけいたしました。\n\nいつもの姿をベースにパワーアップした【メカりりあ】という姿を描いていただきたいです。\n\n【いつもの姿参照リンク】\nhttps://riria-hikari.fanbox.cc/\n\n【メカりりあのイメージ】（後述のリンクにラフあり）\n・腕にバスターつけてる。（ロックマンX3のマックスアーマーみたいな豪華な感じ）\n・ランドセル装備（ガンダムのみたいなものを背負ってる）\n・メカっぽい羽がついてる（νガンダムやフリーダムガンダム、デスティニーガンダム的なもの）\n・元々の特徴のヘッドホンが進化した（よりゴージャスで、かっこよく）\n・ヘッドギア的なのをつけてる\n・胸部はオシャレなジャケット（ロックマンゼロのゼロ的な衣装）\n・胸部中央に菱形の輝くコア的なのがついてる\n・スカートはブースター的なのがついてる（ウマ娘のミホノブルボンみたいな感じ）\n・膝から下がメカメカしい\n・肩もなんか強そう\n・全体的に東方地霊殿の霊烏路空みたいなフォルムをしてる\n・カラーリングは黒白メインに赤が少し\n\n【メカりりあの設定】\n・パワーもスピードもすごい！\n・パンチ力2tくらい\n・かわいい！かっこいい！\n・光りりあの魂と記憶をある程度受け継いでるが、別個体\n・オリジナルより少しクールな性格\n\n【オリジナルの光りりあの特徴】\n・プリキュアなどの女児向けアニメ好き\n・ヘッドホンが外見上の特徴\n・割と明るい\n・天然ボケだと言われる\n・かわいくなりたい、という信念を持っている\n\n【使用用途】\nSNS・ブログでのアイコンやヘッダーなどでイメージイラストとして使用したり、Youtube活動の中で、動画や配信のサムネイルとして使用させて頂きたく思います。\n\n\n拙いラフかとは思いますが、これが清書されて素晴らしいものになる所を見てみたいです。\nぜひともよろしくお願い申し上げます。\n\nhttps://riria-hikari.fanbox.cc/posts/2199087", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ota_syojo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1033243, "client_id": 955889, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6577edf2/uploads/origins/e3e9187d-bf2b-43ea-ac1f-5ed2192ba994?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a50614994e4a49b6110895fb36f8fb0c", "srcset": "https://si.imgix.net/6577edf2/uploads/origins/e3e9187d-bf2b-43ea-ac1f-