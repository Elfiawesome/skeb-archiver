ィガン(でかい)\n・白のハイネック\n・黒のパンツ\n・黒のブーツ\nこのイメージで描いて頂けると嬉しいです。\n宛名、背景有無の差分などもお願いします。\n\nまたこちらのイラストですがファンアートとして、AMUさんのクレジット表記をした上で彼女のファンアートタグである#絵リート邪神をつけて投稿させて頂きたいと思っております。\n※ファンアートは配信活動において使用させて頂く事があるそうです\nご検討の程よろしくお願い致します。\n\nhttps://twitter.com/erisyty/status/1536355147051585538?s=46&t=OpsFvxlDoyYMStxSyj5iHg", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AMU_NUNUNU/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2121010, "client_id": 1121354, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87e77d89/uploads/origins/491ce4b0-6eb1-4b14-93cc-55a2e0ec7142?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e958a30183c1035a37a1d668186f2d2", "srcset": "https://si.imgix.net/87e77d89/uploads/origins/491ce4b0-6eb1-4b14-93cc-55a2e0ec7142?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e958a30183c1035a37a1d668186f2d2, https://si.imgix.net/87e77d89/uploads/origins/491ce4b0-6eb1-4b14-93cc-55a2e0ec7142?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c042954ece87776483373bc657af1dfa 2x, https://si.imgix.net/87e77d89/uploads/origins/491ce4b0-6eb1-4b14-93cc-55a2e0ec7142?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a21ade100ee3ac263e08fe1357c6d57f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87e77d89/uploads/origins/491ce4b0-6eb1-4b14-93cc-55a2e0ec7142?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a137558884a243a645bfec5e76575ab9", "srcset": "https://si.imgix.net/87e77d89/uploads/origins/491ce4b0-6eb1-4b14-93cc-55a2e0ec7142?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a137558884a243a645bfec5e76575ab9, https://si.imgix.net/87e77d89/uploads/origins/491ce4b0-6eb1-4b14-93cc-55a2e0ec7142?bg=%