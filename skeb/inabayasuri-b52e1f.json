00&blur=200&s=f453f20e34626138afc06c5337acbd75 3x"}, "body": "こんにちは！あなたの絵が好きなので、私のキャラクターをあなたの絵で見ることができたら嬉しいです。キャラクターは参考として金のクマで、ポーズ参考のように座っていて、ペニスが半分出ているような服装でXD、背景も自然の中で描いてもらえたらと思うのですが。また、作風の参考のように、セルの陰影が際立つ描き方がとても好きです。あと、ちょっと欲張りなお願いかもしれませんが、フォルダに入れたようなスケッチも描いてもらえると嬉しいです。何でもいいですし、この部分はどうしてもやりたくないということでもOKです XD\n\nhttps://drive.google.com/folderview?id=1KePVDTTF3_6nWdB3cQDuxyRyORaXDwH-", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inabayasuri/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1045434, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/344ac0d0/uploads/origins/fb2cf4c9-5d14-4ef2-ae39-642664ae3dd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=026b9f274530338a00c3edcbe442a912", "srcset": "https://si.imgix.net/344ac0d0/uploads/origins/fb2cf4c9-5d14-4ef2-ae39-642664ae3dd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=026b9f274530338a00c3edcbe442a912, https://si.imgix.net/344ac0d0/uploads/origins/fb2cf4c9-5d14-4ef2-ae39-642664ae3dd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b65bddab9ced667531ebcbf8f498023 2x, https://si.imgix.net/344ac0d0/uploads/origins/fb2cf4c9-5d14-4ef2-ae39-642664ae3dd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a97736ba843670274c52f8e741ed08f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/344ac0d0/uploads/origins/fb2cf4c9-5d14-4ef2-ae39-642664ae3dd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a44185d7848522ec26cde90bb32f9ec4", "srcset": "https://si.imgix.net/344ac0d0/uploads/origins/fb2cf4c9-5d14-4ef2-ae39-642664ae3dd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a44185d7848522ec26cde90bb32f9ec4, https://si.imgix.net/344ac0d0/uploads/origins/fb2cf4c9-5d14-4ef2-ae39-642664ae3dd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c48a7f7b0c0d4c6a40e43462cbaf6cf 2x, https://si.imgix.net/344ac0d0/uploads/origins/fb2cf4c9-5d14-4ef2-ae39-642664ae3dd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=01e2b136213980425ee68fcc147df776 3x"}, "body": "初めまして。うちの子のイラストを依頼頂きたいです。\n\nhttps://www.dropbox.com/sh/736ojqjx2xuauie/AADn1uv9ASGb5nSk46lkWyi4a?dl=0\n\nお風呂に入ってくつろいでいて、木製の丸い種類お風呂です。お風呂が少し小さいから腕と足が辺にちょっと垂れ下がっています。\nよろしければ差分をお願いしたい、1枚目に股間が蒸気に隠れている、2枚目に股間が見られていて勃起がが水面から突き出ています。\n\nご検討をよろしくお願いします！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inabayasuri/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1045434, "client_id": 49360, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/046bc3c3/uploads/origins/9cfb4f95-8f3e-4a29-9c15-ac428aef6e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c406f9584e386986d4cf7b05aa5f267", "srcset": "https://si.imgix.net/046bc3c3/uploads/origins/9cfb4f95-8f3e-4a29-9c15-ac428aef6e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c406f9584e386986d4cf7b05aa5f267, https://si.imgix.net/046bc3c3/uploads/origins/9cfb4f95-8f3e-4a29-9c15-ac428aef6e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d9e8194b907c90c37e7e0e5728f7225 2x, https://si.imgix.net/046bc3c3/uploads/origins/9cfb4f95-8f3e-4a29-9c15-ac428aef6e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bca71bb16884a3e86d77c49cf2429596 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/046bc3c3/uploads/origins/9cfb4f95-8f3e-4a29-9c15-ac428aef6e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=780f85afb95e84248d72a2ee045ce087", "srcset": "https://si.imgix.net/046bc3c3/uploads/origins/9cfb4f95-8f3e-4a29-9c15-ac428aef6e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=780f85afb95e84248d72a2ee045ce087, https://si.imgix.net/046bc3c3/uploads/origins/9cfb4f95-8f3e-4a29-9c15-ac428aef6e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0dbaac151b3a304a5cc0f5100727d4ef 2x, https://si.imgix.net/046bc3c3/uploads/origins/9cfb4f95-8f3e-4a29-9c15-ac428aef6e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=48e21345c3bcc3a93f9d3e79d4003108 3x"}, "body": "こんにちは、いつもお世話になっております！\nよければイラストの作成をお願い致します！\n\n描いて頂きたいのは参考URLのタヌキ獣人ヒーロー ガッツバックスで、悪者に拘束された彼が実験と称した拷問によって陰嚢を切り捌かれ去勢されてしまう様子です。\n細かな希望なのですが、スーツの白い部分は艶やかに、腕や脚は太く逞しいガチムチ調に、やや大きめの乳首がスーツ越しに浮いている感じにして頂けると嬉しいです…！\n金額等問題がなければ差分による三枚でシチュエーションを描写して頂ければ幸いです。\n\n1枚目\n悪者に囚われ四肢を拘束されたガッツバックス\n既に肉体やスーツが解析されており、スーツの股間部分のみ切り取られていて、とても大きな陰嚢と小さな皮被りの陰茎が露になっています\n陰嚢は皮を前から裂かれて精巣が繋がったまま取り出されており、片方は執刀した拷問官(手だけのシルエットなどで構いません)が両手で持って弄んでおり、もう片方は無造作に皿に置かれています\nガッツバックスは涙を流しながら元に戻すよう叫びますが、拷問官は捌いてしまった以上もう手の施しようはなく、完全に戻すことは不可能と返答します\nさらに拷問官は精巣のサイズに驚嘆の言葉を述べつつ、戻すことのできないこれらは切除するのみと告げ、ガッツバックスは狼狽しながらも抵抗の言葉を吐くのでした\n\n2枚目\n拷問官は耐久試験と称して、持っていた方の精巣を道具によって完全に潰してしまいます(使用する用具はお任せ致します。お手間でしたら潰れてしまったカットを入れて頂く形でも大丈夫です)\n放置されていた方の精巣も既に精巣上体から切り離され捨て置かれており、これで完全にガッツバックスは去勢されてしまいました\n切除と圧壊による今まで受けたことのない甚大な痛みに加え、雄として再起不能になってしまった絶望感によって、ガッツバックスは大粒の涙、鼻水や口泡までもはき散らしながら声にならない絶叫をあげています\n生存本能からか小さいながらも硬く勃起した短小包茎は最期の悲鳴の様に勢いよく精液を噴出します\n拷問官はその様子を嘲笑しながら、元よりガッツバックスの粗末な男根では満足に性交渉も果たせなかったであろうとなお心を抉る言葉を吐きます。さらに計器の数値からヒーローとしてのエネルギー値が急激に低下していることを確認し、ガッツバックスが生殖機能だけでなくヒーローとしても再起不能になりつつあるのだと告げてしまいます\n\n3枚目\nかろうじて意識が飛ぶのを押し留めたガッツバックスですが、完全に破壊されてしまった自身の性器を絶望に満ちた面持ちで眺め、嘆きながら啜り泣いてしまいます。\n拷問官は心の折れた彼はもはやヒーローではないと断じる様に煽り、ガッツバックスは言葉の通りただ子供のように泣きじゃくることしかできなくなってしまうのでした。\n\nこのようなイメージです。\nよければそれぞれにシチュエーションに沿って下記の様なセリフも入れて頂けないのでしょうか？ ヤスリさんの方でアレンジ下さってももちろん大丈夫です…！\n\n一枚目\n「外道達め…！ 早く元に戻すんだっ…！！」\n「こんなに裂けばもう戻せるわけないだろう。しかし…本当に異常発達と言えるぐらいデカいな…まぁこうなれば後はもう切除するだけだが。」\n「そんな！？ やめろっ、元に戻せっ…戻してッ！」\n\n二枚目\n(吹き出し中に広がる声にならない叫び)\n「中身は大して硬くもないか…簡単に潰れてしまったな。これで雄としてはもうお役御免だ。まぁどのみち貴様の粗末なイチモツじゃ満足に交尾もできやしなかったろうがな。\nおや、これは面白いな。ご自慢のエネルギー値がどんどん減ってきてるぞ。雄どころかヒーローとしても終わってしまったか？」\n\n三枚目\n「ガキみたいに泣きじゃくってみっともない。本当にただぷくぷく太ったよわっちい豚タヌキになってしまったな。ヒーローごっこももうおしまいだ。」\n「うう…あぁ…こんなの…うそだ…僕の…きんたま…なくなっちゃった……おちんちんが…こわれちゃった…いやだ…いやだよぉ……\nおちんちん…いたいよぉ……」\n\n以上となります。\n長々とした文面ですみません。\n玉破壊に並々ならぬ描写理解をお持ちのヤスリさんに描いて頂くには全力のシチュエーションが必要と思い、熱を入れて書いてしまいました…;\nどうかよろしくお願い致します…！\n\nhttps://twitter.com/gar_ger_k/status/1587290133052940288?s=46&t=oYDg7KZYoToSfxdGJqjbtA", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inabayasuri/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1045434, "client_id": 45426, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51905d7b/uploads/origins/9ce7c909-f29b-4637-b9a4-18e578e098ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c66d9d6a8eaf601d0104b79130d9d5ea", "srcset": "https://si.imgix.net/51905d7b/uploads/origins/9ce7c909-f29b-4637-b9a4-18e578e098ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c66d9d6a8eaf601d0104b79130d9d5ea, https://si.imgix.net/51905d7b/uploads/origins/9ce7c909-f29b-4637-b9a4-18e578e098ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfd48c5b5a35e52f8b4c4f460b00a478 2x, https://si.imgix.net/51905d7b/uploads/origins/9ce7c909-f29b-4637-b9a4-18e578e098ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=272b025ac1e28b42374ff5fcd4fc3e22 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51905d7b/uploads/origins/9ce7c909-f29b-4637-b9a4-18e578e098ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e971e69a7fd71bc5dff