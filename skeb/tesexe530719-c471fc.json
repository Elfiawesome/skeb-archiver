\n\n以下詳細なお願いです。\n・壁紙用途として用いたいので解像度はFHD以上で頂きたいです。（大きい分には大歓迎）\n・不穏さ、不気味さという点以外は好きになさって頂いて結構です。シチュエーションはあくまでイメージです。全身を引きで、はまたまバストアップで...構図等についてもお任せいたします。なんならシチュエーションそのものを弄り逆光等にして頂いても大丈夫です。\n・OCの衣装は暫定的にしか定めておりません（というか優柔普段故定まっておりません）。ふんわり白髪、緑目、大きい羊角、という点以外はお好きに改変なさって下さい。下記に参考資料を添付させて頂きますが充実したものを用意することが出来ませんでしたので、あくまで参考までによろしくお願いいたします。\n\n資料\nhttps://drive.google.com/drive/u/0/folders/1bzO-BNDdXHYvDegTrxEPLb1_3rtTLuoF", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@4gatsu_itsuka/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3541471, "client_id": 3735284, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d541bb89/uploads/origins/e3350bf6-8afc-468a-9f44-730a24da10cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90923211a68a37e6d1340db48244ca10", "srcset": "https://si.imgix.net/d541bb89/uploads/origins/e3350bf6-8afc-468a-9f44-730a24da10cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90923211a68a37e6d1340db48244ca10, https://si.imgix.net/d541bb89/uploads/origins/e3350bf6-8afc-468a-9f44-730a24da10cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69ea29bb51099aa36f57635483131179 2x, https://si.imgix.net/d541bb89/uploads/origins/e3350bf6-8afc-468a-9f44-730a24da10cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc56da4eca026b92d28297bc9bd4d8b6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d541bb89/uploads/origins/e3350bf6-8afc-468a-9f44-730a24da10cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc7429b103aae1a613f45e5b47f68fe9", "srcset": "https://si.imgix.net/d541bb89/uploads/origins/e3350bf6-8afc-468a-9f44-730a24da10cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur