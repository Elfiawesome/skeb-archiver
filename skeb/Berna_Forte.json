と幸いです。\n\n●内容\nFF14のミコッテという大きく張り出した耳といった猫の特徴があるキャラクターのイラストをお願いいたします。\n\n●キャラ\n資料URLの画像やこれまでの依頼品をご参照いただけますと幸いです。\n※胸は気持ち大きめに描いていただけますと幸いです。\nhttps://drive.google.com/drive/folders/102viZG-vpWaZTEMsvcuQF4DkhnQZ0yaq?usp=sharing\n\n●衣装\n画像は下記URL先をご確認いただけますでしょうか。\nhttps://drive.google.com/drive/folders/1wOoFBQb0jqJet1RbC6tObPWt1I4fZhhs\nもし、可能であればシャツの有/無の差分をいただけますと幸いです。\nサングラスを片手で少し上にずらしているようなポーズでその際、水着のみの場合は脇が見えるようなものですと大変嬉しいです。\n\n\n以上、ご検討の程何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/102viZG-vpWaZTEMsvcuQF4DkhnQZ0yaq?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Berna_Forte/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1977380, "client_id": 1834631, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68df4cec/uploads/origins/29b70487-a261-4f1c-9969-fd31675bd004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96261e955eaf802bd43fc105631b37c4", "srcset": "https://si.imgix.net/68df4cec/uploads/origins/29b70487-a261-4f1c-9969-fd31675bd004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96261e955eaf802bd43fc105631b37c4, https://si.imgix.net/68df4cec/uploads/origins/29b70487-a261-4f1c-9969-fd31675bd004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c89a323fa2d123cb9c5622c13e400dda 2x, https://si.imgix.net/68df4cec/uploads/origins/29b70487-a261-4f1c-9969-fd31675bd004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a646adfcf9eb9b0539becae39cec908 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68df4cec/uploads/origins/29b70487-a261-4f1c-9969-fd31675bd004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20bdcbba228835aeb8f8ba5abc7ae09c", "srcset": "https://si.imgix.net/68df4cec/uploads/origins/29