して作られたロボットです。彼には記憶がなく、少女との過去のことも知りません。彼もまた、何事にも困惑した状態にあります。\n\n少女が研究台でこのロボットを制作している過程の絵を描いていただけますでしょうか。男性は無表情で、少女は非常に専念している様子、もしくは微笑んでいる様子でお願いいたします。】その様子をお願いしたい。 キャラクター設定や参考は、【https://drive.google.com/drive/folders/1CZoClmaqrFuZJmNqCCBZm7RLewwlQVUe?usp=sharing】にあります。お役に立ててのはなによりです。 衣服のデザインや細部についてはあまりこだわらなくて大丈夫です\n何卒よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1CZoClmaqrFuZJmNqCCBZm7RLewwlQVUe?usp=sharing\n\nhttps://drive.google.com/drive/folders/1CZoClmaqrFuZJmNqCCBZm7RLewwlQVUe?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sandborer_24/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2640611, "client_id": 2741885, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/420400c7/uploads/origins/6e0ea85b-75cd-4dbc-96a9-793dbbb1eb55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27a2fa8ac58e17886808c4eb20b15a7b", "srcset": "https://si.imgix.net/420400c7/uploads/origins/6e0ea85b-75cd-4dbc-96a9-793dbbb1eb55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27a2fa8ac58e17886808c4eb20b15a7b, https://si.imgix.net/420400c7/uploads/origins/6e0ea85b-75cd-4dbc-96a9-793dbbb1eb55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e00093f15d46d960c7aea387ca23878 2x, https://si.imgix.net/420400c7/uploads/origins/6e0ea85b-75cd-4dbc-96a9-793dbbb1eb55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c59457352698e669df04f446eda91ab0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/420400c7/uploads/origins/6e0ea85b-75cd-4dbc-96a9-793dbbb1eb55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=725072a81c2a406f6aae30ec10534013", "srcset": "https://si.imgix.net/420400c7/uploads/origins/6e0ea85b-75cd-4dbc-96a9-793dbbb1eb55?bg=%2