なし\nでお願いいたします。\n\n３：希望納品形式\n希望形式：PSD\nPSDで、各キャラクターの表情をカスタマイズできるようにしていただきたいです！\n希望サイズ：【幅2500px】×【高さ3200px】   \n\n\n以上となります。\n\nどうか、ご検討の程よろしくお願いいたします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_Neji_rK/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 189453, "client_id": 79966, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6616a808/uploads/origins/11195c1d-943c-477c-928d-4348722cb59a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cb9a2937e7bd256191cd0f5036f95ec", "srcset": "https://si.imgix.net/6616a808/uploads/origins/11195c1d-943c-477c-928d-4348722cb59a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cb9a2937e7bd256191cd0f5036f95ec, https://si.imgix.net/6616a808/uploads/origins/11195c1d-943c-477c-928d-4348722cb59a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c41177ac0a4c1949c30fc493fdfc9b9 2x, https://si.imgix.net/6616a808/uploads/origins/11195c1d-943c-477c-928d-4348722cb59a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29e5f40778737a2a9f04d10698afc931 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6616a808/uploads/origins/11195c1d-943c-477c-928d-4348722cb59a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=509958cbcb1ea15b8baebc52c4f2e3e3", "srcset": "https://si.imgix.net/6616a808/uploads/origins/11195c1d-943c-477c-928d-4348722cb59a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=509958cbcb1ea15b8baebc52c4f2e3e3, https://si.imgix.net/6616a808/uploads/origins/11195c1d-943c-477c-928d-4348722cb59a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f6dae93497ed3bd6537489f383608177 2x, https://si.imgix.net/6616a808/uploads/origi