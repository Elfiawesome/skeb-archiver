します。\n\n３：希望納品形式\n\n希望形式：PSD\nPSDで、各キャラクターの表情をカスタマイズできるようにしていただきたいです！\n\n希望サイズ：【幅2500px】×【高さ3200px】\n\n\n以上　どうかよろしくおねがいします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_Neji_rK/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5ec3b5b8/uploads/origins/503cfc31-3739-4085-ab6a-c2c214119e08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e69c3a11e184dd344399b033d24204c", "srcset": "https://si.imgix.net/5ec3b5b8/uploads/origins/503cfc31-3739-4085-ab6a-c2c214119e08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e69c3a11e184dd344399b033d24204c, https://si.imgix.net/5ec3b5b8/uploads/origins/503cfc31-3739-4085-ab6a-c2c214119e08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8521f31f6278f5096b1f16eb26e4086e 2x, https://si.imgix.net/5ec3b5b8/uploads/origins/503cfc31-3739-4085-ab6a-c2c214119e08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90d2edd58091b15888ef9fd92b171290 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 189453, "nc": 161}, {"path": "/@_Neji_rK/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 189453, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b7e562b/uploads/origins/a17dcfff-ccde-4815-90c2-a269ec7faa7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5097336f79b5d953afe14c772de86c14", "srcset": "https://si.imgix.net/9b7e562b/uploads/origins/a17dcfff-ccde-4815-90c2-