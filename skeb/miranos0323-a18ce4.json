ks/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1251632, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c010704e/uploads/origins/ecc24dba-def6-41c4-906b-679773efc261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9446051aa0019866fd3af314783ca31", "srcset": "https://si.imgix.net/c010704e/uploads/origins/ecc24dba-def6-41c4-906b-679773efc261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9446051aa0019866fd3af314783ca31, https://si.imgix.net/c010704e/uploads/origins/ecc24dba-def6-41c4-906b-679773efc261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc3153da93e23380d4175968d517d981 2x, https://si.imgix.net/c010704e/uploads/origins/ecc24dba-def6-41c4-906b-679773efc261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=705d0d33e334bb28715860ca1b6d07e6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c010704e/uploads/origins/ecc24dba-def6-41c4-906b-679773efc261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d4fa00e741161006e9cb01084afdfa7", "srcset": "https://si.imgix.net/c010704e/uploads/origins/ecc24dba-def6-41c4-906b-679773efc261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d4fa00e741161006e9cb01084afdfa7, https://si.imgix.net/c010704e/uploads/origins/ecc24dba-def6-41c4-906b-679773efc261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=78e01d9d6f7ff03171217a8046c45546 2x, https://si.imgix.net/c010704e/uploads/origins/ecc24dba-def6-41c4-906b-679773efc261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b5d6b642cbc04def255ed962bf56e681 3x"}, "body": "ミラノスさん初めまして。\nskebでご依頼を掛けられそうな方を探しているところ、ミラノスさんのことを見つけさせて頂きました。\nウマ娘にてご依頼をお願いできそうでしたのと、また、ウマ娘ちゃんを着替えさせてお願いしても問題がなさそうな気配を感じましたため、もしよろしければウマ娘の「グラスワンダー」に「トサキントレオタード」をコスプレさせたイラストをお願いできますか。\n（※トサキントレオタード→初代のポケモンアニメ43話「ナッシーぐんだん　だいこうしん！」で、カスミがマジシャンのアシスタントの際に着用していた、トサキントを模した衣装を指してます）\n\n衣装の造形につきましては資料ページのURLを添付いたしますので、ご参考頂ければと存じます。\nコスプレとしてのご依頼させて頂くのは、完全に自分の趣味の都合となりますため、元ネタをご存じないだろうことは覚悟の上ですが、それでもよろしければお願いさせて頂きたく存じます……！（ポケモン自体はご存知とは思いましたが、さすがに元ネタの方は古過ぎると思いまして……ｗ）\n\n表情や構図・ポーズ、あと多少のアレンジなどについては、ミラノスさんが良いと思ったまま、ご想像されるままのグラスちゃんのリアクションで描いて頂ければOKです。過去作でもグラスちゃんを取り扱っていたのを確認させて頂きましたので、グラスちゃんをお願いしても相応に解像度の高いリアクションを期待できると期待いたしました。（フラッシュさんと迷いましたがｗ）\nコスプレ（衣装）姿がメインなので、せめて全身絵で衣装姿を堪能させて頂ければ特に嬉しく思います。\nセンシティブに配慮してストッキング履かせる等の微アレンジを加えて頂く等は問題ないですが、もちろん原作デザインそのままに素足で描かれてもOKです！\n（だけどロングな手袋が性癖なので、アレンジしても手袋は忘れないで頂ければとてもすごく嬉しいです……）\n\nやや無茶な依頼とは存じますが、それでもよろしければ何卒よろしくお願いします！\n\nhttps://bulbapedia.bulbagarden.net/w/index.php?title=File:Misty_Goldeen_outfit.png", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 398838, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ヒヨヨ@skeb募集中（特殊な内容もOK！）", "screen_name": "kou_hiyoyo", "avatar_url": "https://pbs.twimg.com/profile_images/1820725109768003584/nFqwhAAN.png", "header_url": "https://pbs.twimg.com/profile_banners/105523086/1725285923/1500x500", "appeal_receivable": false, "popular_creator_rank": 6, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 80, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 177}, {"id": 1587401, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "七月", "screen_name": "sichinotuki", "avatar_url": "https://pbs.twimg.com/profile_images/1372542760306176005/Nh1Lp2yQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/235469414/1625579801/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "delet