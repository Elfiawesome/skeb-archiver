200&h=200&s=ddbf76bb77f49866a76631a8c6847505, https://si.imgix.net/6880d90a/uploads/origins/f4c6bb4d-6018-43cd-8201-71da783c1b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebb454889e405205e1b6844651b032ba 2x, https://si.imgix.net/6880d90a/uploads/origins/f4c6bb4d-6018-43cd-8201-71da783c1b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8d171acde82905a11992e7dbfada8ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6880d90a/uploads/origins/f4c6bb4d-6018-43cd-8201-71da783c1b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e583673c6dede8b489e70d59155b2e9b", "srcset": "https://si.imgix.net/6880d90a/uploads/origins/f4c6bb4d-6018-43cd-8201-71da783c1b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e583673c6dede8b489e70d59155b2e9b, https://si.imgix.net/6880d90a/uploads/origins/f4c6bb4d-6018-43cd-8201-71da783c1b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0b28dd5d1d799f8a04b40dd725ba64dc 2x, https://si.imgix.net/6880d90a/uploads/origins/f4c6bb4d-6018-43cd-8201-71da783c1b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=99a07e4036b0fedf7fc893ed594e7dfb 3x"}, "body": "ちよこ様\n初めまして。\nVライバー事務所 LIVED3に所属しております、白凪ましろ(しらなぎ ましろ)と申します。主にIRIAMにて配信活動をしております。\n\nこの度、IRIAMの配信で使用する1枚絵をぜひ、ちよこ様に描いていただきたくリクエストさせていただきました。\n\n\n【キャラクター】\n① https://drive.google.com/file/d/1e1RCVXAGnj3sWD_lMNZCDJNjR5JTiCbp/view?usp=drivesdk\n\n【衣装】\n①画像参照です、設定は皆を癒すために天界からやってきた天使メイドです。\n\n【髪型】\n② https://drive.google.com/file/d/1QFIQlIzbcONnVWSJBorvsOv5mObe_KZJ/view?usp=drivesdk\n\n①画像ですと正面で髪型が分かりにくいため、②URL画像参照でお願いします。\n髪の横は編み込みのハーフアップとなっております。\nまたあまり目と髪が被らないように描いてくださると助かります🙏\n\n【表情】\n口を開けて笑っている様子(あまり口を大きすぎず柔らかい笑顔でお願いします。)\nまた①画像のように少し困り眉ぎみでお願いします！\nかわいらしい雰囲気ですとなおうれしいです、ここまで要望が多く大変申し訳ありません。\n\n【構図】\n立っている構図、その他は特に指定はありません。\nまたサムネイル等に使いたいため、頭や髪などがあまり見切れないようにして頂けると幸いです。\n\nもし背景を付けて頂ける場合基本お任せします。\nファンマークが🥛(牛乳)と‎🤍(白いハート)なのでこれらの小物を後ろに描いていただいても大丈夫です。\n\n【使用用途】\n・収益化された配信での使用、サムネイルへの使用(プラットフォームIRIAM)\n・デジタルグッズ(アイコン、ヘッダー、壁紙等)\n・リアルグッズ(アクスタ・アクキー・ネップリ・ステッカー等)\n\n上記内容に使用予定です。\n\n【納品方法】\nグッズに使用したいため透過含めたPSDファイルでお願いします。\n\nもし金額の不足や不備等ございましたら再送要求お願いいたします。\n長文になってしまい大変申し訳ありません、ご検討の程よろしくお願いします🙇🏻‍♀️", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tykchiyo/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d7616637/uploads/origins/d3beaa87-6fa9-4e0b-bbdc-8abecb6dc819?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2378fa5294915126cc713cd018f25dfc", "srcset": "https://si.imgix.net/d7616637/uploads/origins/d3beaa87-6fa9-4e0b-bbdc-8abecb6dc819?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2378fa5294915126cc713cd018f25dfc, https://si.imgix.net/d7616637/uploads/origins/d3beaa87-6fa9-4e0b-bbdc-8abecb6dc819?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a08747102a6d1a92da9eb2bba34fc043 2x, https://si.imgix.net/d7616637/uploads/origins/d3beaa87-6fa9-4e0b-bbdc-8abecb6dc819?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc1f53b7035168765befe498f2913d20 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 219373, "client_id": 753062, "nc": 32}], "sent_works": [], "similar_creators": [{"id": 16613, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ototoi", "screen_name": "ototoi813", "avatar_url": "https://pbs.twi