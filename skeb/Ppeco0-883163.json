小説のURLを載せておきます。\n勿論強制などではありませんが、より雰囲気を掴みたいなどあれば、お読みいただければと思います。\n\n以上です。\nもしお受けいただけるのであれば、何卒よろしくお願いいたします。\n\nhttps://estar.jp/novels/25923284", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ppeco0/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2085722, "client_id": 2112363, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a36b7a1/uploads/origins/eaba96ef-ad4f-421d-861a-f42374b07b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84f1da33692814372860423cd98683da", "srcset": "https://si.imgix.net/2a36b7a1/uploads/origins/eaba96ef-ad4f-421d-861a-f42374b07b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84f1da33692814372860423cd98683da, https://si.imgix.net/2a36b7a1/uploads/origins/eaba96ef-ad4f-421d-861a-f42374b07b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a0ce169d6b9e7157f74febfa9b92ae1 2x, https://si.imgix.net/2a36b7a1/uploads/origins/eaba96ef-ad4f-421d-861a-f42374b07b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5fd15e7fd27dac8fc4ef6075c46b5de7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a36b7a1/uploads/origins/eaba96ef-ad4f-421d-861a-f42374b07b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f118fb073cbb2f9af9bafa0606fc916f", "srcset": "https://si.imgix.net/2a36b7a1/uploads/origins/eaba96ef-ad4f-421d-861a-f42374b07b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f118fb073cbb2f9af9bafa0606fc916f, https://si.imgix.net/2a36b7a1/uploads/origins/eaba96ef-ad4f-421d-861a-f42374b07b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8755872e3087d36f2d410099d5032eab 2x, https://si.imgix.net/2a36b7a1/uploads/origins/ea