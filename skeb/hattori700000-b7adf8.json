lur=200&s=ea81ced41cb157bfa83b5312049f5aa0 3x"}, "body": "こんにちは！あなたの作品、本当に素敵だと思います。私のキャラクター「Ling」のスケッチをお願いしたいのですが。そのイラストをプロフィール画像として使わせてもらいたいです。よろしいでしょうか。ご検討いただき、ありがとうございます！\n\nhttps://imgur.com/a/c7mAXs3", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hattori700000/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3971052, "client_id": 4006299, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f7c48542/uploads/origins/d9eb0b80-025c-4282-948c-0a08e7b8b021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5b7c42186de2de0f16f35508e6c98cd", "srcset": "https://si.imgix.net/f7c48542/uploads/origins/d9eb0b80-025c-4282-948c-0a08e7b8b021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5b7c42186de2de0f16f35508e6c98cd, https://si.imgix.net/f7c48542/uploads/origins/d9eb0b80-025c-4282-948c-0a08e7b8b021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=906b6dd365204d9c7cead4fdfb8afd4d 2x, https://si.imgix.net/f7c48542/uploads/origins/d9eb0b80-025c-4282-948c-0a08e7b8b021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=374d15dd28535eeb6a9ed22d05a3466e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f7c48542/uploads/origins/d9eb0b80-025c-4282-948c-0a08e7b8b021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b4031e9fe0407c2e380f0dd8ee74cab", "srcset": "https://si.imgix.net/f7c48542/uploads/origins/d9eb0b80-025c-4282-948c-0a08e7b8b021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b4031e9fe0407c2e380f0dd8ee74cab, https://si.imgix.net/f7c48542/uploads/origins/d9eb0b80-025c-4282-948c-0a08e7b8b021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b0c77baf8c96382b