ZYRUylBU.jpg?1447915675\n\nふたりはお互いにアイドルとして輝ける時間が限られていても身に来てくれるファンのために研鑽を重ねる共通点がありますので、「励まし合うふたり」をテーマに描いてくれるとうれしいです。\nhttps://blog-imgs-113-origin.fc2.com/c/g/g/cggekijo/1311.jpg", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@5rnrnrn5/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2702833, "client_id": 667554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc1e88dd/uploads/origins/fce66d38-5d2f-4a9a-b5ac-a04f171db037?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17a5a057bc12b900540f1f2d86a957b0", "srcset": "https://si.imgix.net/fc1e88dd/uploads/origins/fce66d38-5d2f-4a9a-b5ac-a04f171db037?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17a5a057bc12b900540f1f2d86a957b0, https://si.imgix.net/fc1e88dd/uploads/origins/fce66d38-5d2f-4a9a-b5ac-a04f171db037?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b68f43d9e78d47218497b44d6e7eaa16 2x, https://si.imgix.net/fc1e88dd/uploads/origins/fce66d38-5d2f-4a9a-b5ac-a04f171db037?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41cb5243e3d6ffa9908185d2a10dbf7e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc1e88dd/uploads/origins/fce66d38-5d2f-4a9a-b5ac-a04f171db037?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2c7f02fb25d3d63f8207e821d6ad919", "srcset": "https://si.imgix.net/fc1e88dd/uploads/origins/fce66d38-5d2f-4a9a-b5ac-a04f171db037?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2c7f02fb25d3d63f8207e821d6ad919, https://si.imgix.net/fc1e88dd/uploads/origins/fce66d38-5d2f-4a9a-b5ac-a04f171db037?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=246eb2b873b51158dfb5c0a045b0238e 2x, https://si.i