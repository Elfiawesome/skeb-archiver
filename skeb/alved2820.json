creator_id": 3236656, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bc48f96/uploads/origins/025d8318-1099-4297-9557-eec10a100740?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdc4d569508b63736ac08ed806a82aa2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bc48f96/uploads/origins/025d8318-1099-4297-9557-eec10a100740?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=599359e393ed74074563cc1f2c89bf64", "src_set": ""}, "body": "初めまして。\nいつも素敵なイラストを拝見しております\n私は台湾人です。文法に間違いあるかもしれませんが、ご容赦ください。\n\n天狗+天狐\n陽キャで健氣の天然ボケ、笑うと犬歯が見える、\n時折見せる冗談のような振る舞い\nメッシュの色は気分によって色が変わる 。\n一般アクアマリンのメッシュ（恥ずかしい時はピンク色になり、感情が高ぶると赤色になります）\n現在のイメージは白髪で白い尻尾です。参考資料にある黒髪の柴犬耳の亜人イメージは以前のものです\n\n構図、ポーズ：\n今回の構図は、先生がデザインしてくださった衣装でイラストを描いていただきたいです！！\n構図はおまかせします！\n髪型はM字前髪に変更したバージョンを見てみたいです。\n髪型は、添付に記載した説明のようなM字前髪にしていただきたいです。\nもし可能であれば、2種類の差分をご用意いただけると大変嬉しいです！\n\n楽しみにお待ちしております！\nありがとうございました！\n\n希望納品形式：\nキャラの背景透過と未統合PSDファイルの提供が可能でしたらお願いします。\nできれば人物の透過やサインなどは別レイヤーに分けていただけると助かります。\nその他、細かいリクエストはございません。\nよろしくお願いします！\n\n【使用用途】\n・SNSのアイコンやPR画像、Youtube等の配信、そのサムネイルでの使用などを考えております。\n・個人用な印刷などの使用\n・他の方への依頼の際に資料として使用させていただくことがあります。\n・SNS、ネットで公開する時には、先生を注記してから投稿します。\n\nまた、今回の衣装デザインの依頼は、今後ほかのイラストをお願いする際にも使用させていただく予定です。\nその際に、服装に少し変更を加えたり、髪型を変えたりする場合があるかもしれませんが、ご了承いただければ幸いです。\n\nhttps://drive.google.com/drive/folders/14kvsaFybSkRbx5AMpIdMcI2Vaiz6OBKE", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@alved2820/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a8a7f23a/uploads/origins/0f8c593f-5f53-4811-8dca-c18f33afbfbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5114c591bd2b849b50e3b4997079f804", "src_set": ""}, "private": true, "genre": "art", "tipped