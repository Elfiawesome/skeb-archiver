女VSデーモン）や、SKEBの依頼作品（https://skeb.jp/@youkai_ankake/works/4）\nのように、怪物に犯される内容です。\n両足は無理矢理開かされ、スパッツもろとも触手で貫かれるようにしていただきたいです。\n怪物のデザインや構図などは、おまかせいたします。\n以上、よろしくお願い致します。\n\n女性主人公（葵）：https://www.nintendo.co.jp/n08/aorj/character/player/p00.jpg", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@youkai_ankake/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5158, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86428df9/uploads/origins/15dfb6e6-31a0-48be-8393-f7c40d210bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bb2d1f73cbc985b19a2ae1f99532b56", "srcset": "https://si.imgix.net/86428df9/uploads/origins/15dfb6e6-31a0-48be-8393-f7c40d210bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bb2d1f73cbc985b19a2ae1f99532b56, https://si.imgix.net/86428df9/uploads/origins/15dfb6e6-31a0-48be-8393-f7c40d210bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6825f6465b1148122b0d207290e2350 2x, https://si.imgix.net/86428df9/uploads/origins/15dfb6e6-31a0-48be-8393-f7c40d210bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc5dec25a52e6e5fc51ffc87cc7db8db 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86428df9/uploads/origins/15dfb6e6-31a0-48be-8393-f7c40d210bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41076fc5695f98077bdbdb7a7d8979a1", "srcset": "https://si.imgix.net/86428df9/uploads/origins/15dfb6e6-31a0-48be-8393-f7c40d210bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41076fc5695f98077bdbdb7a7d8979a1, https://si.imgix.net/86428df9/uploads/origins/15dfb6e6-31a0-48be-8393-f7c40d210bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=75fa0a6353