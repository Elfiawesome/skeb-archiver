edia/Fvh8IzpaYAEHEPe?format=jpg\n\n★全体イメージ\n夏時期をイメージした構図でお願いできればと思います。\n蒼月先生の、背景が水色貴重な絵（例：下記URL）が好きなので本依頼もそれでお願いできればと思います。\n例：https://www.pixiv.net/artworks/96589120、https://www.pixiv.net/artworks/103630018\n\n★服装\nメイド服でお願いできればと思います。\n資料にもメイド服はありますが、メイド服の柄や構図は資料に拘らず\nお好みでアレンジ頂ければと思います。\n（可能であれば、下着が見えるor透ける差分があると嬉しいです。）\n\n★その他\n細かい部分、足りないところは蒼月先生のほうでアレンジ頂ければと思います。\n\nご検討頂けますと幸いです、よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@xxx_czm/works/166", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1865298, "client_id": 324223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ca36a2b/uploads/origins/d71dbc37-16e3-44c6-a91e-af37e51ebd63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ae2d6844301f3e5f24b2fc7b78fd54e", "srcset": "https://si.imgix.net/3ca36a2b/uploads/origins/d71dbc37-16e3-44c6-a91e-af37e51ebd63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ae2d6844301f3e5f24b2fc7b78fd54e, https://si.imgix.net/3ca36a2b/uploads/origins/d71dbc37-16e3-44c6-a91e-af37e51ebd63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb981761835dcfd79a60edafae1ca002 2x, https://si.imgix.net/3ca36a2b/uploads/origins/d71dbc37-16e3-44c6-a91e-af37e51ebd63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4c63381e4aa9a1eb65fd57501e397fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ca36a2b/uploads/origins/d71dbc37-16e3-44c6-a91e-af37e51ebd63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a2ced5ee6b2526ad0b657baaacb21ed", "srcset": "https://si.imgix.net/3ca36a2b/uploads/origins/d71dbc37-16e3-44c6-a91e-af37e51ebd63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a2ced5ee6b2526ad0b