ェラピケの青色ボーダーパーカ( https://x.gd/1w89E )\n眼鏡はかけているがリボンの髪飾りは付けていない\n\n備考：\n・アニメ塗りでお願いします\n・李胡は身長154cm、B87/W57/B84(推定Fカップ)、碧依は身長161cm、B88/W59/B87(推定Fカップ)です\n・薄暗い状態でも、 https://skeb.jp/@2423ruri/works/18 の様に虹彩が元の色のまま輝いていると嬉しいです\n\nよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 339, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "星霖るおん", "screen_name": "2423ruri", "avatar_url": "https://pbs.twimg.com/profile_images/2007815887697678336/Wh31YlMx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/890138209405079552/1773058649/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 40, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 144}, {"id": 888242, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "黒字くん", "screen_name": "mmmmmmmisto_", "avatar_url": "https://pbs.twimg.com/profile_images/1691995422569766913/wU_nHeXL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4840232784/1699534842/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1518620, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "朧々", "screen_name": "rourou_ill", "avatar_url": "https://pbs.twimg.com/profile_images/1789863829922549760/Ee9Fm1Io.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expir