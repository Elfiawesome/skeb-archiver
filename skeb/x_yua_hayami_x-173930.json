bae, https://si.imgix.net/eb5dff1d/uploads/origins/31d23e95-139b-40c4-8331-ba837960e048?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9de450651591366039796f0d4f6ade9c 2x, https://si.imgix.net/eb5dff1d/uploads/origins/31d23e95-139b-40c4-8331-ba837960e048?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=709e4b40d39d9b37d0a837613c4853e3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb5dff1d/uploads/origins/31d23e95-139b-40c4-8331-ba837960e048?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=204ea96ff172feb058721774f6d60142", "srcset": "https://si.imgix.net/eb5dff1d/uploads/origins/31d23e95-139b-40c4-8331-ba837960e048?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=204ea96ff172feb058721774f6d60142, https://si.imgix.net/eb5dff1d/uploads/origins/31d23e95-139b-40c4-8331-ba837960e048?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c75faf0d7ffa3a34ae4ea2e896cd4f7 2x, https://si.imgix.net/eb5dff1d/uploads/origins/31d23e95-139b-40c4-8331-ba837960e048?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=40f5ec0db6e59e5d3c891363af8327b2 3x"}, "body": "うちのこの白幡李胡ちゃん(https://note.com/shirahata_ccr/n/ne1abf196fbfa)と乾ヶ峰碧依ちゃん(https://x.com/SRHT_Yaritsu/status/1756182543890817375)の百合イラストをお願いします。\n\nシチュエーション:\n・碧依が李胡をベッドの上に押し倒し、濃厚なスキンシップを取っている。李胡は一切抵抗せず、碧依のされるがままになっている\n・碧依が李胡の性感帯である耳を甘噛みしている。既に耳を舐めた後なのか、李胡の耳が唾液まみれになっている\n・李胡は気持ちよさに顔を蕩かし、碧依も頬を赤らめ半ば興奮したような表情になっている\n・碧依の狼耳が後ろに垂れ、柴犬の飛行機耳のようになっている\n\n服装:\n二人ともセーラー冬服（https://x.com/srht_yaritsu/status/1836299884582080951）\n\n構図:\nhttps://www.pixiv.net/artworks/39082436 の様な構図でお願いします\n出来れば腰あたりまでを画角に入れていただけると嬉しいです\n\n備考:\n李胡は身長154cm、B87(F)/W57/B84、碧依は身長161cm、B88(F)/W59/B87です。ご確認いただけると幸いです。 \n李胡の耳の形は https://skeb.jp/@housandang/works/20 の様になっています。ご確認いただけると幸いです。\n\nよろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@x_yua_hayami_x/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3108840, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/342cb256/uploads/origins/1fdd84eb-e19d-4026-8e42-5df9e0cff6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1a6ad1ce0e855a2229bf8d30a7631a8", "srcset": "https://si.imgix.net/342cb256/uploads/origins/1fdd84eb-e19d-4026-8e42-5df9e0cff6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1a6ad1ce0e855a2229bf8d30a7631a8, https://si.imgix.net/342cb256/uploads/origins/1fdd84eb-e19d-4026-8e42-5df9e0cff6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d53d83ce109a87677a86f8c117f5c793 2x, https://si.imgix.net/342cb256/uploads/origins/1fdd84eb-e19d-4026-8e42-5df9e0cff6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3144fc1a6aa4d2c39d3f60454b2d950a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/342cb256/uploads/origins/1fdd84eb-e19d-4026-8e42-5df9e0cff6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26cb148a4dc21702a4d8d603a241392d", "srcset": "https://si.imgix.net/342cb256/uploads/origins/1fdd84eb-e19d-4026-8e42-5df9e0cff6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26cb148a4dc21702a4d8d603a241392d, https://si.imgix.net/342cb256/uploads/origins/1fdd84eb-e19d-4026-8e42-5df9e0cff6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8dbf4ea311b98aa8120de8f4dd0f5676 2x, https://si.imgix.net/342cb256/uploads/origins/1fdd84eb-e19d-4026-8e42-5df9e0cff6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1f1a9cf32cd5c458d6c9ebc5a36