d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4085891b84a2705765803c7aafe9c00a, https://si.imgix.net/44af9425/uploads/origins/f7d0f43d-2ad6-4e59-bde9-96bc0d91221d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d7d72dd604cbc6a4f610a02a4387c66 2x, https://si.imgix.net/44af9425/uploads/origins/f7d0f43d-2ad6-4e59-bde9-96bc0d91221d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c283fc789d8232a39517b00899906a84 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44af9425/uploads/origins/f7d0f43d-2ad6-4e59-bde9-96bc0d91221d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=734bf15f51ef9dbb0a7707512daaea8a", "srcset": "https://si.imgix.net/44af9425/uploads/origins/f7d0f43d-2ad6-4e59-bde9-96bc0d91221d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=734bf15f51ef9dbb0a7707512daaea8a, https://si.imgix.net/44af9425/uploads/origins/f7d0f43d-2ad6-4e59-bde9-96bc0d91221d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2641f7d76c51b9b8144033a52c6c9444 2x, https://si.imgix.net/44af9425/uploads/origins/f7d0f43d-2ad6-4e59-bde9-96bc0d91221d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=512f4729240eff667a504b9889e99975 3x"}, "body": "アピールありがとうございます。麻雀物語のドロシー・ジェファーソンと神楽詩音のカップル双子コーデで自撮りするシーンのイラストをお願いいたします。\n\nドロシーは右腕で神楽の肩を抱き、左手は小顔ポーズのように親指と人差し指を顎の辺りに、神楽は左手をピースにし自分の左胸の辺りに右手でスマホを持って自撮りをし、2人がバストアップで映るイメージです。(なので神楽の右手はあまり映らない感じですね)神楽はちょっと照れた笑顔、ドロシーはキメ顔のようにキリッとした表情で、2人の顔は頬が当たるくらいなるべく近いと良いです。\n\n双子コーデのイメージは資料のとおりですが、ドロシーのボーダーは白と黒、神楽のボーダーは白と赤で、ジャケットは別資料のものが良いです。\n\nまた、撮影場所のイメージはテーマパークです。\n自撮りで映るツーショットがメインですが念のため。以上です。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10GbZnxKPNOzDFcnFz1WIgxDDGhHptGx5", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@abtrsayun_info/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 90897, "client_id": 2784612, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab306183/uploads/origins/6e1b8e09-ab81-4aad-b0e8-5d242fba1677?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7cb55a2af44918e2a83b2e6cb3ffb08", "srcset": "https://si.imgix.net/ab306183/uploads/origins/6e1b8e09-ab81-4aad-b0e8-5d242fba1677?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7cb55a2af44918e2a83b2e6cb3ffb08, https://si.imgix.net/ab306183/uploads/origins/6e1b8e09-ab81-4aad-b0e8-5d242fba1677?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3524d9802d8dccc6c30b6b37f2b8c3d 2x, https://si.imgix.net/ab306183/uploads/origins/6e1b8e09-ab81-4aad-b0e8-5d242fba1677?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a45b12dd61376b12bf9cb825cb625bfd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab306183/uploads/origins/6e1b8e09-ab81-4aad-b0e8-5d242fba1677?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=806907532f3152a6f225a51739a98ffb", "srcset": "https://si.imgix.net/ab306183/uploads/origins/6e1b8e09-ab81-4aad-b0e8-5d242fba1677?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=806907532f3152a6f225a51739a98ffb, https://si.imgix.net/ab306183/uploads/origins/6e1b8e09-ab81-4aad-b0e8-5d242fba1677?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=15f227580b831bf94f899ac14d9bdab0 2x, https://si.imgix.net/ab306183/uploads/origins/6e1b8e09-ab81-4aad-b0e8-5d242fba1677?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=995d26fb4c0e0dba35d15329a00fa8a3 3x"}, "body": "初めまして\nalabasと申します。\nMisskeyではお世話になっております。\n\nもしよろしければうちの子のみさらちゃんを描いて頂けないでしょうか？\n詳細はこちらのリンクにございます。https://misskey.io/notes/9ktgkunj2w\n\n構図やシチュエーションは特に指定しませんので、あなたの思うみさらちゃんを描いてあげてください。\n\n以下自分的なメモみたいなものになります。\n参考にできるところは参考にしてください。\n\n・髪型\n肩当たりまでのセミロングで色は茶色系でお願いします。\n\n・耳\n人の耳の部位にケモ耳が付いてます（東方のミスティア・ローレライのようなケモ耳といえば分かるでしょうか？）。\n\n・野戦服\n開襟で色はグリーン系を想定しています。モデルはドイツ軍の野戦服でポケットが４つ付いています。これにY型サスペンダーを付けています。\n\n・肩章、襟章、袖章、アームバンド、ベルトバックルのエンブレム\n厳格にこういうのというのは無いので好きなようにデザインしてみてください。\n\n・ライフル\nボルトアクション型であれば自由なデザインで構いません。お好みで別の銃に交換してしまっても大丈夫です。\n\n・ブーツ\nよく軍人が履いてそうな黒の長ブーツです。\n\n・後盒、雑のう、水筒、銃剣\n背中に装備してる設定です。ベルトで固定してあります。デザインは後盒以外はWW2のドイツ兵が身につけてた物がイメージとして近いです。\n参考資料：https://twitter.com/ala4648/status/1669309348340973568\n　　　　　https://twitter.com/ala4648/status/1669793163186421760\n\n・スカート\n二重構造で表側が白で裏側のフリルが黒色を想定していますが配色を変えても大丈夫です。柄などは自由に付け加えても構いません。\n\nそれ以外でも基本部分を抑えてあれば簡易化やアレンジは自由にしてもらって構いません。\n\nご検討の程よろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@abtrsayun_info/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 90897, "client_id": 382878, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8fda8f24/uploads/origins/f05785fb-663f-449a-90a2-c457c7dbe407?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4f4b93324c056440073a2cb7100afa8", "srcset": "https://si.imgix.net/8fda8f24/uploads/origins/f05785fb-663f-449a-90a2-c457c7dbe407?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4f4b93324c056440073a2cb7100afa8, https://si.imgix.net/8fda8f24/uploads/origins/f05785fb-663f-449a-90a2-c457c7dbe407?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d7c7372cae047f1d6ecfa7b762e5ece 2x, https://si.imgix.net/8fda8f24/uploads/origins/f05785fb-663f-449a-90a2-c457c7dbe407?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4720f0abfb61958c760039f31cdc1d6 3x"}, "duration": null, "nsfw": false, "hardcore": fal