4b18-4584-b564-984d53b83699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff7e32922637a81179859c1ec3e39d84 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a659178/uploads/origins/30beaaf8-4b18-4584-b564-984d53b83699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c68a402be41fbabc23a0c5426539542", "srcset": "https://si.imgix.net/4a659178/uploads/origins/30beaaf8-4b18-4584-b564-984d53b83699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c68a402be41fbabc23a0c5426539542, https://si.imgix.net/4a659178/uploads/origins/30beaaf8-4b18-4584-b564-984d53b83699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a49597496094a87fbf2ecdf12f335f41 2x, https://si.imgix.net/4a659178/uploads/origins/30beaaf8-4b18-4584-b564-984d53b83699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=294cd8c4085f257bb1cc495429213c83 3x"}, "body": "いつもお世話になっております！今回はOC2人の依頼がしたいです。\n\n【依頼形式】\nイラストを3枚ほどお願いしたいです。\n\n【依頼内容】\n1枚目︰事件のことを羽鳥に言及された殺人鬼が「僕のせいじゃない、だって君が怖いこと言うから…！羽鳥が殺したんだよ、僕悪くないもん！」って泣いて責任を押し付けており、羽鳥が(ここまで彼は僕のせいにするのか！)と興奮しているイラスト\n\n2枚目︰学生時代、二人で夏を恋人として過ごしていたのと、現在の対比が見たいです。\n学生時代は半袖の夏服を着ていると喜びます。\n夏は全体的に青めいた色合いをしていると嬉しいです。\n\n3枚目︰二人を紹介する際のテンプレに使えるイラストを描いて下さると嬉しいです。\n\n細かい形式はお任せします。\n\n【キャラクター解説】\n日奈影 羽鳥(ひなかげ はとり)\nファムファタル気質の攻め。探偵。優しげで上品な優等生で、自分が絶対に正しいと思っている。殺人鬼を運命の人だと信じ、「僕が何をしても彼は絶対に全てを信じて、受け入れるべき」と考えるロマンチスト。学生時代はわざと殺人鬼を孤立させ、自分だけが優しくし依存させていた。躾で手を出してくるタイプ。罪悪感は全くない。\n\n殺人鬼\n臆病な受け。惚れっぽい性格。不器用で周囲から怒られることが多かったため、自分の感覚に自信が持てず、「正しい」を示してくれる羽鳥に依存していた。今は恐怖しかない。学生時代は羽鳥のことが大好きで、彼にだけ笑顔を見せていた。\n今の髪型は羽鳥が昔「長い髪、素敵だね。でも短いところも見てみたいな」と発言したため、両方叶えるために変えたのがそのままになっている。学生時代は髪が長く、下で1つに括っていた。\n\n【関係性解説】\n「探偵×殺人鬼」に見せ掛けた「殺人鬼×殺人鬼」です。殺人鬼を怖がらせた人間は殺人鬼に殺され、殺人鬼に好意を抱いた人間は羽鳥に消されるので殺人鬼の周囲は物凄い勢いで人が死んでいます。\n昔は恋人同士でしたが、殺人鬼が羽鳥の発言を発端に自らの両親を殺してから逃走、今は所々で事件を起こす彼を羽鳥が追いかけています。攻めが絶対的に優位です。\n\n【細かい指定】\n・背の高さ︰殺人鬼＞羽鳥(10cm差くらい)\n・羽鳥の顔を綺麗に描いて下さるととても嬉しいです\n・殺人鬼の睫毛は髪と同じ色だと嬉しいです\n\n【使用用途】\n依頼の際、参考資料として用いる可能性があります。\n\nhttps://drive.google.com/drive/folders/1UP1n3QHowi7LuGozem4pIz4YeH9pEkjS", "nc": 179, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mizu_mo_chi_/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0e419cb5/uploads/origins/08226f1d-050a-46f0-a4cf-6683b270c519?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc9ee4f9ae70af9a5905688ddebeae2f", "srcset": "https://si.imgix.net/0e419cb5/uploads/origins/08226f1d-050a-46f0-a4cf-6683b270c519?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc9ee4f9ae70af9a5905688ddebeae2f, https://si.imgix.net/0e419cb5/uploads/origins/08226f1d-050a-46f0-a4cf-6683b270c519?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a10ed1660531ac7479958f08ddf1be93 2x, https://si.imgix.net/0e419cb5/uploads/origins/08226f1d-050a-46f0-a4cf-6683b270c519?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf375f9c42aab42ab77784fbd46e43b5 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3514335, "client_id": 771724, "nc": 161}, {"path": "/@mizu_mo_chi_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3514335, "client_id": 1398516, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f81b9a8/uploads/origins/92997902-a0f9-4219-aa69-d90290723f30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3