の物語の主人公アリアのシーンです。彼女は落ちぶれた貴族の剣の女で、腕にオーラから武器を作り出す魔法の紋章を持っています。鴉と薔薇の花びらがテーマです。\n\nイラストは、アリアがオーラを纏った通常剣と、オーラを纏ったレイピアの二刀流を描いてほしい。アリアの紋章が光っているのはリクエストだけです。アリアがアビリティを使用すると、目が青から緑になります。リクエストに応えてくれてありがとう！\n\nアリアの参考文献\nhttps://drive.google.com/drive/u/1/folders/1i7zuLfo5svdEmKtW6hh8lVjhigBoFhiC", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kasamachi88/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/22a7c432/uploads/origins/5a72d9dc-9953-4e54-928e-076c517fdb7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03eac2b5eb05c180427cbc35d0ac080c", "srcset": "https://si.imgix.net/22a7c432/uploads/origins/5a72d9dc-9953-4e54-928e-076c517fdb7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03eac2b5eb05c180427cbc35d0ac080c, https://si.imgix.net/22a7c432/uploads/origins/5a72d9dc-9953-4e54-928e-076c517fdb7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=42a22214e7619d5252e212ec769d13db 2x, https://si.imgix.net/22a7c432/uploads/origins/5a72d9dc-9953-4e54-928e-076c517fdb7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4556d0dd1946b0607f271ee1d84780e4 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2336799, "client_id": 3385501, "nc": 128}, {"path": "/@kasamachi88/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f0427a59/uploads/origins/00073fb0-c58b-4028-bbfb-a875bf9baa79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&tx