ads/origins/f3758329-7ab2-4b5b-ac03-f374017958d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0e6d47fb92678d5d108ca79fde16747b 3x"}, "body": "毎度毎度お世話になっております、肉です🐔\n以前描いてもらった下記2人のイラストをもう一度頂きたく🙇‍♀️\n(お相手の方より許可貰ってます！)\n\n構図など全てお任せで、衣装なども適宜変更アレンジして頂いて大丈夫です！お願いします🩵\nhttps://www.dropbox.com/scl/fi/bp1rzuzkstvyfqqk4xp96/2.png?rlkey=x0hqlfa7qt3ywhq5dfso5bk42&st=8p8cvygj&dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FH_jiji0/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1303125, "client_id": 2011574, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11f2f91f/uploads/origins/1f4bf15d-d15f-443e-a7ad-a63dcf66444e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d62daafb950f4efb697f7ed2bea4a3f", "srcset": "https://si.imgix.net/11f2f91f/uploads/origins/1f4bf15d-d15f-443e-a7ad-a63dcf66444e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d62daafb950f4efb697f7ed2bea4a3f, https://si.imgix.net/11f2f91f/uploads/origins/1f4bf15d-d15f-443e-a7ad-a63dcf66444e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67fa5c3fbc32b3a5a09aad4906a20667 2x, https://si.imgix.net/11f2f91f/uploads/origins/1f4bf15d-d15f-443e-a7ad-a63dcf66444e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f534a2253a3168803058e30d8b55141 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11f2f91f/uploads/origins/1f4bf15d-d15f-443e-a7ad-a63dcf66444e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d101a83a79c61a24ebed19dc414c3f68", "srcset": "https://si.imgix.net/11f2f91f/uploads/origins/1f4bf15d-d15f-443e-a7ad-a63dcf66444e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d101a83a79c61a24ebed19dc414c3f68, https://si.imgix.net/11f2f91f/uploads/origins/1f4bf15d-d15f-443e-a7ad-a63dcf66444e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1fe8a128d26c599a7c14a5b1e622735d 2x, https://si.imgix.net/11f2f91f/uploads/origins/1f4bf15d-d15f-443e-a7ad-a63dcf66444e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c61f25ef31b99d69d033e8ada6c33948 3x"}, "body": "ふじこさん、お世話になっております！ \n資料を用意する元気がある時にぜひ依頼したいな……🎶と常々思っており、今回依頼メッセージを送らせていただきました。\n\n内容についてですが、CoCシナリオ「酩と錆色」のPC2人をお願いしたいです。\n\n以下、PCの説明になります。\n容姿についてはリンク先の資料を見ていただければと思います。  \n(リンク先、依頼文ともにネタバレはありません)\n\n──── \n\n💛KPC (後輩)\n男/21歳/APP14/SIZ15\n\nチャラついてはいるが好青年風で友人も多く、優秀な大学3年生。\n世渡りが上手く、犬のような愛嬌がある。\n実際は束縛が強くDV気質であり、恋人等の閉じた関係性の中でのみ本性を見せる。\n本人は無自覚ではあるが、愛着障害における試し行動に近い。相手がどこまで許してくれるかを確かめるという意味で暴力を振るってしまう。\n父がDV気質で、家族仲が悪い。兄がいる。\n家庭環境のせいで子供の様な甘えが消えず、根が子供。\n\n💙PC (先輩)\n男/22歳/APP13/SIZ14\n\n面倒見がよく、さっぱりした性格の青年。国立大学の国際学部に通う4年生。\n自分の意見はきちんと口に出す。立ち振る舞いは男性的。根が真面目。器用貧乏。\n理屈と感情を切り分けて考えるが、感情を無視しない。怒りの瞬発力が凄まじく、悲しみは全て怒りに変換される。\n家族仲は良好。5つ下の妹がいる。年下に弱い。\n学費を理由にやむを得ず、家族に黙って不特定多数の男性から金銭的な援助を受けている。\n\n💙💛関係性\n同じ大学の同じ学部に通っている。\n顔くらいしか知らなかった頃、金銭的な援助をネタにKPCがPCを脅迫している。\n紆余曲折ありなんだかんだ和解のようなものをし、現在は先輩後輩に収まっている。\n所謂うちよそと呼ばれる関係に近い。\n\n💛→💙\nよく懐いている。基本的に友好的。\n相手に好かれたい。更に踏み込みたいが、関わり方を知らず、時折暴力的な手段に出る。\n\n💙→💛\n仕方のないやつ……と思っている。\n好かれること自体満更でもなく、甘えられると弱い。\n正しい手順で関係性を進展させることを望んでおり、相手が暴力に走る度に叱り飛ばしている。\n\n──── \n\n構図やキャラデザの簡略化等についてはお任せします🌸\n使用目的はSNSのアイコンや個人利用のみです。\n\n以上、よろしくお願いいたします🦕🎶\n\nhttps://drive.google.com/drive/folders/1tsn_1km0fvRshgc3n8rLW5W31l6Hi38y", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FH_jiji0/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dfc9dad6/uploads/origins/15fb2971-fc37-4aaa-a243-130ed76aebb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a281b0c970d5823