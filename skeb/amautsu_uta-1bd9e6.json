uration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ce51b43/uploads/origins/9332153c-68d0-484d-b86f-3a8bbe41944f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bae98e5638637781bed52fd6dbe8aa4a", "srcset": "https://si.imgix.net/9ce51b43/uploads/origins/9332153c-68d0-484d-b86f-3a8bbe41944f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bae98e5638637781bed52fd6dbe8aa4a, https://si.imgix.net/9ce51b43/uploads/origins/9332153c-68d0-484d-b86f-3a8bbe41944f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=30ac66fb3af6985ca0a788229f528ce2 2x, https://si.imgix.net/9ce51b43/uploads/origins/9332153c-68d0-484d-b86f-3a8bbe41944f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa1d463fca0da495335c8d3eb025d5c7 3x"}, "body": "甘鬱うたさん、こんにちは。\n少し遅くなりましたが、メリークリスマスです。\n\n今回は、私のVTuber「@curseromi」の新しいロゴをお願いしたく、リクエストしました。\n商用利用予定で、主に配信での使用や、グッズのロゴとして使わせていただく予定です。\nまた、透過版もいただけると助かります。\n\n全体の雰囲気は、前回リクエストしたものと大きくは変わりませんが、改めて詳細を書かせていただきます。\n\n🎀デザインイメージ🎀\n\n配色\n・ピンク\n・ブラウン\n・白\n・黒\n\nモチーフ・雰囲気\n・メンヘラ系、病みかわいい雰囲気\n・薬、ナイフ、カミソリなどのモチーフ\n・「可愛いこと自体が呪い」\n・サキュバスっぽい要素（羽など）、ガーリーな印象\n\n🎀表記🎀\n「呪い呂美」（大きい）\n「Curse Romi」（小さい）\n\n今回も、甘鬱うたさんのセンスにお任せできたら嬉しいです。\nどうぞよろしくお願いします。\n\n参考資料：\nhttps://photos.app.goo.gl/nyNGi4M12Pq81LdM8", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amautsu_uta/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2880513, "client_id": 3354548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/77c78873/uploads/origins/e4c629ee-6881-4ee7-b434-853fecdad031?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8873bd77b5c310f7d0f661edd83d3624", "srcset": "https://si.imgix.net/77c78873/uploads/origins/e4c629ee-6881-4ee7-b434-853fecda