景に使用したいと思っています。\n\n背景透過PNGや背景人物が別のPSDファイルだと嬉しいです。\n\n不都合があったり、難しいようでしたら断っていただいて大丈夫です。\nとっても好きな絵柄なのでどうぞご縁がありましたらよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@5hunk4/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b869d0fd/uploads/origins/be90cd69-8295-4642-92b7-38fec205356a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa78eff47d810f89414db68aa94fcca5", "srcset": "https://si.imgix.net/b869d0fd/uploads/origins/be90cd69-8295-4642-92b7-38fec205356a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa78eff47d810f89414db68aa94fcca5, https://si.imgix.net/b869d0fd/uploads/origins/be90cd69-8295-4642-92b7-38fec205356a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02249cac4741875c9f28b63174b6186d 2x, https://si.imgix.net/b869d0fd/uploads/origins/be90cd69-8295-4642-92b7-38fec205356a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a123abb570bd93c55e6fc99c8890d96 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3471682, "client_id": 3719719, "nc": 129}, {"path": "/@5hunk4/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e13f13bf/uploads/origins/f7ea7699-88a2-4c00-90ff-d2254d732ebf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fba2fc940b5f590302b1af287983e46b", "srcset": "https://si.imgix.net/e13f13bf/uploads/origins/f7ea7699-88a2-4c00-90ff-d2254d732e