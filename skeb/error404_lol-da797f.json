4-07116ab54fac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4658c9193284ee2d11e5281cb7175990, https://si.imgix.net/e4dffe9e/uploads/origins/a54a5126-e4f4-49ef-8444-07116ab54fac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a56f2efa1e42e70e9be428166af49c7f 2x, https://si.imgix.net/e4dffe9e/uploads/origins/a54a5126-e4f4-49ef-8444-07116ab54fac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa47d80da9828c216b364cb9afd3e5b4 3x"}, "body": "よろしくお願いします！\n\nこの2人のキャラクターのイラストを描いていただけませんか？1990年代を舞台にした2人です。二人は一緒に魔法学校に通っています。\n\n金髪の少年アロイスは、いたずら好きで気が強いトラブルメーカーでミスフィットタイプ。スケッチが好きで、ロックミュージックが好き。\n茶髪の少年ゲイブは、自信家でフレンドリーな性格だが、からかうのも好きだ。アロイスをからかうのが好きだ。宇宙船と科学が好き。いつか宇宙船を設計するエンジニアになりたいと思っている。\n\n2人の関係は、ゲイブが人気者で、不良のアロイスを驚かせて仲良くなろうとするものです。\n\nポーズの例としては、以下のようなものがあります：\n- ゲイブがアロイスの勉強を手伝っている\n- ゲイブとアロイスが一緒に宇宙船の模型を作っています\n- 一緒にギターを習うゲイブとアロイス\n- その他、お好きなポーズをお願いします。宇宙をテーマにしたものがあるとうれしいです！\n\nいずれにせよ、私のリクエストを読んでいただき、本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1aijBfN9Jila_sth9TnmhdCSuzLHHwOaj?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@error404_lol/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2700772, "client_id": 898356, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0680d0ba/uploads/origins/5a4b28c9-3937-47b9-a86b-9f74b9b1cfbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ae1fa7a4d0f7ded496bac2068ce80ad", "srcset": "https://si.imgix.net/0680d0ba/uploads/origins/5a4b28c9-3937-47b9-a86b-9f74b9b1cfbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ae1fa7a4d0f7ded496bac2068ce80ad, https://si.imgix.net/0680d0ba/uploads/origins/5a4b28c9-3937-47b9-a86b-9f74b9b1cfbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=305101394a7090c085