作成者さんと個人的に鑑賞したり印刷して楽しみたいなと思っています。 有償利用などは致しませんが紙面にプリントしたいため解像度350dpi～だと助かります。 難しければ大丈夫です！  \n\n長文失礼いたしました。 不備などございましたら申し訳ありません。 ご一考ほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1KE3nR4brG13_yrTelO9caX0BKpey5g4N?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Zalbatorz/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/963d337b/uploads/origins/2a6db2f6-989e-47d1-8123-40e283ea9fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b9fbdb3bc6b095e8df2f3f9c94f4b7b", "srcset": "https://si.imgix.net/963d337b/uploads/origins/2a6db2f6-989e-47d1-8123-40e283ea9fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b9fbdb3bc6b095e8df2f3f9c94f4b7b, https://si.imgix.net/963d337b/uploads/origins/2a6db2f6-989e-47d1-8123-40e283ea9fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c512103cf868220de614d2772fe5333f 2x, https://si.imgix.net/963d337b/uploads/origins/2a6db2f6-989e-47d1-8123-40e283ea9fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de555bdfc05eef57e2844ae9d7bd2bdc 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3327665, "nc": 145}, {"path": "/@Zalbatorz/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5dbb1f3e/uploads/origins/418b7a8b-b49c-4d63-a4bd-478029791208?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78904d77978fa7d0b0a7e832662f5c