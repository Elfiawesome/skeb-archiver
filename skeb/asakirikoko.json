src_set": ""}, "body": "UMP45のなり垢を作るにあたって、先生の素敵な絵でのUMP45のイラストが欲しいです。初めての依頼で申し訳ないのですが、クールでニヒルな笑みが似合いそうだけどどこか儚げなUMP45ちゃんの絵が欲しいです…、、、、、\n我儘言ってしまい申し訳ありません…()", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@asakirikoko/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 53772, "client_id": 903, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbc0946c/requests/22937_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=121802b3acca36a7e739a6acbaaa826a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbc0946c/requests/22937_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7ab10ee8dfac7163cca6c6cc22e9598", "src_set": ""}, "body": "ドルフロのM200をリクエストさせていただきます。\n映画「ザ・シューター/極大射程」のポスター風でお願いします。\nポスターに記載されているキャッチコピーについてはドルフロ風に記載していただければ幸いです。\n\nhttps://movies.yahoo.co.jp/movie/327455/", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 734293, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "けんいち", "screen_name": "ken1ro_u", "avatar_url": "https://pbs.twimg.com/profile_images/810833954219511810/Ule8TCM5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3315404808/1598627608/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 32}, {"id": 1995919, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "七色ないろ", "screen_name": "kanzenseimeitai", "avatar_url": "https://pbs.twimg.com/profile_images/1074289254556098561/9Bhzkssu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1066303897038245888/170339