に弄ばれている。性的パートナーの見える部分はフォルダ内の褐色肌のOC（ローハン）を参考にしてください。\n可能であれば、ルーファスが淫らな顔をしながら、ロハンがキツネの尻尾を引っ張り、ルーファスの肛門からアナルビーズが滑り出しているバリエーションもお願いします。\n構図やディテールはお好きなように描いてください。\n\nいずれにせよ、このリクエストを読んでいただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/1pJD0Tvvevq_IG491b2x4G-VUan_ELBMO?usp=sharing", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aoba_original/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3096852, "client_id": 1959473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0dc3f59c/uploads/origins/8145cb51-7097-45ef-af5e-9601e43427f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fe0afcfe9c7b7fb944a522d4355b1b1", "srcset": "https://si.imgix.net/0dc3f59c/uploads/origins/8145cb51-7097-45ef-af5e-9601e43427f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fe0afcfe9c7b7fb944a522d4355b1b1, https://si.imgix.net/0dc3f59c/uploads/origins/8145cb51-7097-45ef-af5e-9601e43427f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f6049629116be7a08c35ad47b11f292 2x, https://si.imgix.net/0dc3f59c/uploads/origins/8145cb51-7097-45ef-af5e-9601e43427f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52f5ab045d553c5fa488d566de6111b4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0dc3f59c/uploads/origins/8145cb51-7097-45ef-af5e-9601e43427f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=981d3e1217b50bacd64d9c3e8cba388e", "srcset": "https://si.imgix.net/0dc3f59c/uploads/origins/8145cb51-7097-45ef-af5e-9601e43427f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=981d3e1217b50bacd64d9c3e8cba388e, https://si.imgix.net/0dc3f59c/uploads/origins/8145cb51-7097-45ef-af5e-9601e43427f6?bg=%23fff&auto=format%2C