e up to you. Thank you for your consideration!\n\nhttps://drive.google.com/drive/folders/1LI2iAD93RlXA6MRqjw6Z23G_B7FZ_BHb?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miro_x_maru/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2367561, "client_id": 8144, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d706686/uploads/origins/de2ed2ee-cdf7-4432-9040-f4b5597106ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cb068329a18fd765b243f55d7e70eac", "srcset": "https://si.imgix.net/1d706686/uploads/origins/de2ed2ee-cdf7-4432-9040-f4b5597106ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cb068329a18fd765b243f55d7e70eac, https://si.imgix.net/1d706686/uploads/origins/de2ed2ee-cdf7-4432-9040-f4b5597106ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edea7e9fde7b74739f7901051c7230ab 2x, https://si.imgix.net/1d706686/uploads/origins/de2ed2ee-cdf7-4432-9040-f4b5597106ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83cf6dcb1632e5ecbf91c089d7494564 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d706686/uploads/origins/de2ed2ee-cdf7-4432-9040-f4b5597106ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab5390ddc3603d4e8fbcd0635b68ddd4", "srcset": "https://si.imgix.net/1d706686/uploads/origins/de2ed2ee-cdf7-4432-9040-f4b5597106ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab5390ddc3603d4e8fbcd0635b68ddd4, https://si.imgix.net/1d706686/uploads/origins/de2ed2ee-cdf7-4432-9040-f4b5597106ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=271fdff483f8073789c1ff802ee6249d 2x, https://si.imgix.net/1d706686/uploads/origins/de2ed2ee