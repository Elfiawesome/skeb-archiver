2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=584bfae7402c540f99657c4c470547dc, https://si.imgix.net/b9372995/uploads/origins/c4ff70aa-ede8-4d33-bc63-8dc9fd23db6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec38fbcd35e9e89db7f722bc84f1ad36 2x, https://si.imgix.net/b9372995/uploads/origins/c4ff70aa-ede8-4d33-bc63-8dc9fd23db6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8de063aa6bf2b90735582ca4cbae1913 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9372995/uploads/origins/c4ff70aa-ede8-4d33-bc63-8dc9fd23db6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=088610b17e85b6b46786f44984e39e25", "srcset": "https://si.imgix.net/b9372995/uploads/origins/c4ff70aa-ede8-4d33-bc63-8dc9fd23db6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=088610b17e85b6b46786f44984e39e25, https://si.imgix.net/b9372995/uploads/origins/c4ff70aa-ede8-4d33-bc63-8dc9fd23db6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=504f15e8b97105aba3e9e93af607168d 2x, https://si.imgix.net/b9372995/uploads/origins/c4ff70aa-ede8-4d33-bc63-8dc9fd23db6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c169bddd5b71fbd2185f1403c7d58f6c 3x"}, "body": "こんにちは。できれば、僕のオリジナルTRPGキャラクターを描いてほしいんだ。彼女の名前はオフィーリア。\n\n彼女は、人間とババアの間の操られた関係の産物である。この人と生き物の未知の関係から、彼女にはとても不思議な特徴があります。彼女の世界では「チェンジリング」と呼ばれて 。\n\n-彼女はドルイドだが、その血統からウィッチのサブクラスも持っている。ドルイドの仲間は黒いイノシシで、親友だと思っている。 魔女として青いマムシを飼っている。この毒蛇はかなり不吉な性格だが、オフィーリアは彼を味方だと思っている。どちらも描く必要はないが、希望すれば自由に描いてよい。彼女は動物を傷つけるよりも、交渉したり友好的に接したりすることを常に好むが、多くの生き物が積極的に脅威となったり、自然のバランスを崩したりすることを理解している。 このように、彼女は他のさまざまな生き物の助けを借りることができる。\n\n-超ロングな黒髪。この髪で敵を攻撃したり、物体を操作したりすることもできる。\n\n-片方の目は灰色で、もう片方は紫色です。彼女は通常、片方を隠していますが、必要であれば両方を表示することも可能です。\n\n-長く鋭い2本の鉤爪を持っている。この爪は冷たい鉄でできている。彼女の呪文のひとつに、爪の破片を砕いて敵に飛ばすものがある。この破片は呪文が終わると彼女の元に戻ってくる。\n\n-暗い表情や深刻な表情をすることが多い。彼女の存在の本質が冒涜的であると考えられている 。そのため、多くの人間とはうまくやっていけない。オフィーリアはどんな味方にも忠実だ。そのため、彼らのためならほとんど何でもする。\n\n表面的には、かなり冷淡な少女ですが、心の奥底には善良な部分がたくさんあります。怪物のような母親と、幼い頃に殺された父親の間で生きてきたため、人を信じることがとても苦手です。\n\n私は、彼女がどんな服を着ているかにはこだわりがありません。しかし、正確を期すために、モンスターのパーツから作られた鱗状の鎧を身につけることが多い。または、長く鋭い爪を少し隠せるような長袖の服。 が、この場合はまだ見えやすいので、いつもうまくいくとは限りません。\n\n彼女がいろいろな形で描かれているのを見るのはいつも興味深い\n\nどんなシナリオで彼女を描くかは自由だ。\n\nhttps://imgur.com/a/TXpy837", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riresu/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f972e3ac/uploads/origins/20d9272e-3df7-4d93-a31b-3efb2d2cfc47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2bbab04788f3e74f9c59e8ffbf983a8a", "srcset": "https://si.imgix.net/f972e3ac/uploads/origins/20d9272e-3df7-4d93-a31b-3efb2d2cfc47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2bbab04788f3e74f9c59e8ffbf983a8a, https://si.imgix.net/f972e3ac/uploads/origins/20d9272e-3df7-4d93-a31b-3efb2d2cfc47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=656c0e46205b3ff78a5e051aea13855f 2x, https://si.imgix.net/f972e3ac/uploads/origins/20d9272e-3df7-4d93-a31b-3efb2d2cfc47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab07888c7d7bc44dbb30ef8f46bcb88f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1815752, "nc": 17}, {"path": "/@riresu/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1815752, "client_id": 2801