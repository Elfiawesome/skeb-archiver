ぶん、ビクトリア調でフリルとコルセットがあるようなものです。彼女の容姿は参考URLの通りですが、念のためhttps://drive.google.com/drive/folders/1wocCoFOu_1XQt2Z6QNYzB1J-LkpY2fsR?usp=sharing。\n\n彼女はとてもエネルギッシュなアーチャーで、とてもフレンドリーで、（肉体的にも精神的にも）強く、とても自立している。仕事に関してはとてもまじめです。自由な時間には、本を読んだり、昼寝をしたり、ヒノカの側にいるのが好き。  着心地がよくて動きやすい服が好き。星団王族の一人であるヒノカと結婚している。だから、指輪を付けてほしい。ネアはヒノカにとても優しいが、ノリノリで触発されることもある。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1wocCoFOu_1XQt2Z6QNYzB1J-LkpY2fsR?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aio_cartolaio/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 135982, "client_id": 1072725, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08c06301/uploads/origins/20ab4a35-2848-428a-87f3-f83a458ce9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=791824ab5cf69f01d8b4283a29a0fd72", "srcset": "https://si.imgix.net/08c06301/uploads/origins/20ab4a35-2848-428a-87f3-f83a458ce9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=791824ab5cf69f01d8b4283a29a0fd72, https://si.imgix.net/08c06301/uploads/origins/20ab4a35-2848-428a-87f3-f83a458ce9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a281870bc1c7db058feacf5e5829fb10 2x, https://si.imgix.net/08c06301/uploads/origins/20ab4a35-2848-428a-87f3-f83a458ce9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e0a6a222e2a950334d3042f2763e570 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08c06301/uploads/origins/20ab4a35-2848-428a-87f3-f83a458ce9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff685357158de53a7a6c42e4bff83aaf", "srcset": "https://si.imgix.net/08c06301/uploads/origins/20ab4a35-2848-428a-87f3-f83a458ce9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blu