ly_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@kurowana/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2583374, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3d90a29/uploads/origins/09baaf1c-b438-448f-bf3f-63cad6ba45a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbcf7f8e19597a2ae46e657af875c5eb", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3d90a29/uploads/origins/09baaf1c-b438-448f-bf3f-63cad6ba45a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2380a96e7564dd4a36494e922fb66c1a", "src_set": ""}, "body": "リクエストさせていただきます。\n\nキャラクター：ベレス(ファイアーエムブレム風花雪月)\n\n少し前に投稿されたポケモンのトウコのようにお尻を向けた構図で男たちから色々されちゃうイラストをお願いしたいです。\n\n衣装は通常の衣装、または水着でお願いします。\n\n何卒よろしくお願いいたします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurowana/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2583374, "client_id": 437702, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/accf5f8d/uploads/origins/b53d7c06-b619-4f8a-a14f-c546ff3dd099?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9baa449e8e72ebd71845af9045303b1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/accf5f8d/uploads/origins/b53d7c06-b619-4f8a-a14f-c546ff3dd099?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5aeaadf85dac8671d2f9d41c623f41a4", "src_set": ""}, "body": "【キャラ】\n四季映姫・ヤマザナドゥ（東方Project）\n\n【バストサイズ】\n頭部よりでっかく。\n合わせて乳輪、乳首も大き目でお願いします。\n\n【シチュエーション】\nでっかいおっぱいを揉まれながらの着衣ラブラブエッチ\n\n【構図】\nベッド上での正常位\n\n【服装】\n胸元の開いた原作服＋帽子＋レースの黒パンツ\nパンツは穴が開いていて穿いたままのエッチでお願いします。\n\n【差分】\n中出し、噴乳", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurowana/works/20", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9db77d8c/uploads/origins/58e96b79-7b1f-4126-ab76-b61543b9939b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=852b7d9ba05166b8ca8506f03f7fa1f2", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2583374, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kurowana/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2583374, "client_id": 3432153, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/902fe733/uploads/origins/294bec0e-12c3-482e-bc73-6897817fea6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37282c85089217c50e4bf0272cd9d72a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/902fe733/uploads/origins/294bec0e-12c3-482e-bc73-6897817fea6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f87a737cd9aa0961e5f21c2da4d30d9f", "src_set": ""}, "body": "こんにちは！ファイアーエムブレムシリーズのリンの画像セットをお願いしたいです。リンの服装はオリジナルで、過去に描いていただいたような胸と股間を露出させたものになります。これは合意の上でのセックスなので、彼女は嬉しそうに顔を赤らめているはずです。背景はいつものシンプルな赤を使い、ベッドやシーツを表面として加えてもいい。男性は一般的なもので、目を隠す乱れた髪を除けば、それほどディテールは必要ない。茶髪もいいが、オプションだ。\n\nhttps://serenesforest.net/wp-content/uploads/2020/12/img_sketch.png\nhttps://www.pixiv.net/en/artworks/116797278\n\nポーズとしては、膣内セックスをしながら、片足を空中に上げて横向きに寝てほしい。\nこの画像セットの2枚目の写真のような感じでもいい。https://www.pixiv.net/en/artworks/93232474\n\n少し違う点を挙げるとすれば、片方の手でリンの上げた足を太ももで支え、もう片方の手でリンの片方のオッパイを掴んで揉んでいるところです。太くてふにゃふにゃした太ももと大きなおっぱいが彼女の最大の魅力であることを強調してください。リンの空いている片方の腕は、舌でキスをしながら男性の側頭部を愛撫することができる。\n\n通常、ディープキス、効果音と吹き出し（日本語と英語）、片方のオッパイに吸い付く男性の小さな吹き出し、男性が絶頂に達する前と後のアソコの内部ショット、母乳、精液にまみれた外見など。\n\nご検討のほど、よろしくお願いいたします！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurowana/works/18", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c1c3c307/uploads/origins/43b751f8-3f07-40be-8184-a3e5f87599e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df0537d75f5608aae711afedbc71ba7f", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2583374, "client_id": 1314443, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kurowana/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2583374, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4d813a2/uploads/origins/b3badbcd-0581-47c0-b735-3e7f88935c5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04ae3572119dd17388f4d4e02cd1bd5b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4d813a2/uploads/origins/b3badbcd-0581-47c0-b735-3e7f88935c5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0193457d8ccecf035645f8d9f1c749a", "src_set": ""}, "body": "はじめまして。\nリクエストさせていただきます 。\n\nキャラクター\nトウコ(ポケモンブラック・ホワイトの女主人公)\n\n 構図\n過去に描かれていたメイやツツジ先生のように、お尻を向けた立ち姿の構図でお願いします。\n\n内容\n大きなお尻や胸を揉まれたりいじられたりしながら感じさせられたうえで、挿入→中出しされるまでを描いていただきたいです。\n\nまた、ホットパンツ、下着(ピンク)を脱がされる…というように段階を経ていただけると嬉しいです。\nこちらは難しければ、既に脱がされた状態から開始で問題ございません。\n\nご検討のほど、よろしくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurowana/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2583374, "client_id": 700267, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bff0af8/uploads/origins/37c32e3b-e448-4b91-9cb7-4459e23a57d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2831abd4e0399ee0d02b6c73a6331e61", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5bff0af8/uploads/origins/37c32e3b-e448-4b91-9cb7-4459e23a57d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ddaae6e11a86eab9ccff9b9014131f1c", "src_set": ""}, "body": "また会ったね！\n\n前回の依頼がとても良かったので、もしよければもう1セットお願いしたいです！\n同じキャラで、ファイアーエムブレムヒーローズの妖精のデザインでお願いしたいです。\n\n参考URL以外にも角度が必要であれば2つほど参考を。\nhttps://cdn.fireemblemwiki.org/2/2e/FEH_Palla_Eldest_Whitewing_R02.png\nhttps://cdn.fireemblemwiki.org/2/2d/FEH_Palla_Eldest_Whitewing_R03.png\n\nシナリオについては、お送りした2つの画像をベースにしてほしい。\nリンクとして載せたいのですが、ホスティングサイトの関係で追加するのが難しいです。\nできれば、参考画像と同じようなプロポーションで、おっぱいもお尻も見えるような体の角度にしてほしいです。\nおっぱい、お尻、脚は大きめでお願いします！\n服装は、緑のチュニックとオレンジの蝶のマント以外は全部着てほしいです。\nスカートは参考資料のようにお尻が丸見えになるように押し上げてほしいです！\n背景はなくてもいいですが、工夫してください！\n\nリクエスト読んでくれてありがとう！\n\nhttps://cdn.fireemblemwiki.org/2/21/FEH_Palla_Eldest_Whitewing_R01.png", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurowana/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2583374, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c000ccdb/uploads/origins/1349097f-dd52-418b-bb29-dd8d21088c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fda352a8a6e0db3a2ef83c1aad4ace68", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c000ccdb/uploads/origins/1349097f-dd52-418b-bb29-dd8d21088c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c629c9b1dae87ccd60934c764f84bc3", "src_set": ""}, "body": "はじめまして。最近胸を持った初音ミクが流行っていますので、リクエストさせていただきます\n\nキャラクター\n初音ミク\n\n構図　以前投稿されたファイアーエンブレムのワユのような構図\n\n内容　胸をはだけさせた超爆乳の初音ミクが、彼氏とラブラブエッチをしている。\n乳首をいじめられたり胸を揉まれながらSEXして、途中から母乳が噴き出す。\n最終的に中出しされながら絶頂し、母乳と精子まみれになりながら絶頂の余韻に浸っている。\n\nその他\n下はパイパンで、パンツは白と水色の縞模様でお願いします\n\nよろしくお願い致します", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurowana/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c31722fb/uploads/origins/ff505990-5eb6-40dc-9670-5387f696d273?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8b59c079ba2d95ae311d3b812784b45", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2583374, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kurowana/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2583374, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a67574e8/uploads/origins/d7904b16-7278-4df6-8d8f-a9672de6013f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c2c1a0e208bb5def3cc9bd9ddff36e6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a67574e8/uploads/origins/d7904b16-7278-4df6-8d8f-a9672de6013f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf8390b48ef9aa7c7b815de74c8fcba0", "src_set": ""}, "body": "東方Projectの姫虫百世のイメージセットを描いていただけませんか？早苗さんのイメージセットのように、搾乳機が欲しいです。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurowana/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2583374, "client_id": 2032785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f151f097/uploads/origins/d14fe05a-6295-484b-bb5c-c52c660faafc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f9515f845b42afead895ab0e05dcaf1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f151f097/uploads/origins/d14fe05a-6295-484b-bb5c-c52c660faafc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc0b3047dd7b818b13b15389e3023086", "src_set": ""}, "body": "こんにちは！ファイアーエムブレムのワユの画像セットをお願いしたいのですが\n\nワユの巨乳を揉みしだきながらのミッションセックスが見たいです。\n\nhttps://fireemblemwiki.org/wiki/Mia#Gallery", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurowana/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2583374, "client_id": 700267, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73f71fed/uploads/origins/1863985f-90d3-4279-8e65-158de6abf93d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acac79395469c6fd5fb69e55f7313401", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73f71fed/uploads/origins/1863985f-90d3-4279-8e65-158de6abf93d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=634a077ebd6a524045a54d45d3ff0f4c", "src_set": ""}, "body": "こんにちは！お元気でしょうか！\n拙い日本語で依頼をしようと思ったのですが、代わりに機械翻訳を使わせていただきます。誤訳があったらごめんなさい！\nもしよろしければ、ファイアーエムブレム EchoesのPallaをお願いしたいです：Shadows of Valentia.母性溢れる姿で、大きな胸はおっぱい責めに使ってください。\n彼女の緑色のドレスはロールアップしてください。鎧は描かないでください！\nプロポーションとポーズについては、あなたの「おっぱい_SANAE[東方]」の投稿にある早苗の位置のように描いてください。\n基本的には、早苗をイメージして描いてほしいです！\n一回目の射精の後、さらに大きな二回目の射精で体全体を覆って終わらせてください！\nリクエストを読んでいただきありがとうございました！\n\n参考URLに1つしかリンクを貼れないので、早苗さんのpixivの投稿をここに載せておきます。\nhttps://www.pixiv.net/en/artworks/115760148\n\nhttps://cdn.fireemblemwiki.org/9/98/FESoV_Palla.png", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurowana/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2583374, "client_id": 68936, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24ef9b34/uploads/origins/d01bca57-95e7-41f2-bb54-25a373a1e8da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e712d376421fa265b57dec9b4454ee8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24ef9b34/uploads/origins/d01bca57-95e7-41f2-bb54-25a373a1e8da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33841fee0dee915dcfaf6fb6621fdad6", "src_set": ""}, "body": "ファイアーエムブレムエンゲージのシトリニカでリクエストよろしいでしょうか。\n\nシチュエーションはイチャラブパイズリで、\n上目づかいでこちらを見ながら\n大きな胸でやさしく射精させてくれる感じのものをお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurowana/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2583374, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae6fbcac/uploads/origins/a554e297-6994-4369-a4e1-50c827b501b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdc13e0ce86247c18e4e32655692a811", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae6fbcac/uploads/origins/a554e297-6994-4369-a4e1-50c827b501b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b80cb00e93bc22a2c26a863bd3b385a", "src_set": ""}, "body": "初めまして、宜しくお願いします。\n以下の内容でリクエストを送信させていただきます。\n\n【キャラクター】「炎の孕ませ転校生」の三咲 若菜(資料URLの青髪の少女)\n【シチュエーション】\nチアリーディング部のユニフォームを来た若菜さんが、ユニフォームを捲り上げて爆乳をさらけ出し、パイズリをしながら亀頭を舐めている\n\nOVA版(https://www.dmm.co.jp/digital/anime/-/detail/=/cid=h_400ands08001/)のサンプル画像にあるように、若菜さんが自分自身の手で爆乳を上下に動かしているようにしていただき、胸の間からはみ出した亀頭を舌で舐めているようにしてください。\n110cmのMカップという設定なので、若菜さんの胸はかなりの爆乳にしてください。\nまた、元のゲームが男性1人：女性複数のハーレムゲームなので、登場人物は男性1人と若菜さんの2人だけにしてください。(男性の描写は陰茎と下半身のみの最低限に留めてください。)\n可能であれば、射精差分を付けていただけると幸いです。\n\n以上、ご検討の程宜しくお願い申し上げます。\n\nhttps://www.google.com/search?client=ms-android-sonymobile-rev1&sca_esv=597807857&hl=ja&sxsrf=ACQVn0_OT5vlqK2b-Opy90l8NCnt9z3ZSg:1705066062806&q=%E7%82%8E%E3%81%AE%E5%AD%95%E3%81%BE%E3%81%9B%E8%BB%A2%E6%A0%A1%E7%94%9F+%E4%B8%89%E5%92%B2%E8%8B%A5%E8%8F%9C&t", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurowana/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2583374, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3dccb8c8/uploads/origins/ee7c419c-92c7-40fd-b68b-2bf0e858672c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b9df1b965e4427269b04453b2017a79", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3dccb8c8/uploads/origins/ee7c419c-92c7-40fd-b68b-2bf0e858672c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca00282e14e52f05214af43ee0a48ec5", "src_set": ""}, "body": "こんにちは。東方Projectの八雲ゆかりさんが、https://www.fanbox.cc/@umezawaitte/posts/5460632 のように、隙間から複数のペニスに奉仕しているアートワークをお願いしたいです。\n\n手、胸、口で奉仕しているところを見てみたいです。また、時間差や複数同時、射精差なども入れていただけるとありがたいです。\n\nご迷惑でなければ幸いです。私の依頼を検討していただき、ありがとうございました。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurowana/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2583374, "client_id": 2015931, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1d252ca/uploads/origins/1fdd9a8e-73fb-4ad5-ab93-b4c31d3e5c93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6d27f60afce40c381380d3ebde5ca6a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1d252ca/uploads/origins/1fdd9a8e-73fb-4ad5-ab93-b4c31d3e5c93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=223551a4df74305d0a9fb98a211e2801", "src_set": ""}, "body": "『まちカドまぞく』のシャミ子こと吉田優子\n\nプレイ内容：イチャラブパイズリ(亀頭は見えるように)\n\n衣装：危機管理フォームで、ビキニ部分は捲られ、生おっぱいや乳首が丸出しの状態\n\nバストサイズ：以下のリンクのキャラと同じで↓\nhttps://www.pixiv.net/artworks/96629680\n\nシチュ内容：\nシャミ子が恥ずかしがりながらの笑顔でパイズリさせてあげる感じで。射精させた後は気持ち良くしてあげられた喜びでニコニコしてする感じで。\n可能ならば連続射精差分もお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurowana/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2583374, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e74c2d80/uploads/origins/f44f7df9-ec45-46f8-a467-0f5c3a6a5325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4905b0cbd86adad6e3c76a721d033b8d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e74c2d80/uploads/origins/f44f7df9-ec45-46f8-a467-0f5c3a6a5325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b21cb093b6a982e73719c3e54a2f656c", "src_set": ""}, "body": "参考URLのFanboxリンクのように、東方Projectの水橋パルスィの射精、挿入、母乳の画像セットを描いていただけませんか？\n\nhttps://www.pixiv.net/en/artworks/36228277\n\nいろいろお手数おかけしてすみません。\n\nhttps://www.fanbox.cc/@kurowana-72831/posts/5065628", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurowana/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2583374, "client_id": 672202, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47a48927/uploads/origins/98bb7dc1-197f-4b59-894e-c818ecf3186c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b2a0934e2c3880f8b47933344663acb", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47a48927/uploads/origins/98bb7dc1-197f-4b59-894e-c818ecf3186c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78f89456fadbba87f3f74c4faf37f885", "src_set": ""}, "body": "こんにちは。\n\npixivfanboxのえちちイラストが素敵でしたのでご依頼させていただきます。\n\n今回描いてほしいキャラクターはオトメディウスの空羽亜乃亜をお願いします\n\n参考画像\nhttps://static.wikia.nocookie.net/gradius/images/4/4e/Aoba_3.jpg/revision/latest?cb=20110316031359\nhttps://m.media-amazon.com/images/I/41MZD-ZxhqL._AC_UF894,1000_QL80_.jpg\n\n・顔より大きいサイズの胸\n\n・男性側が胸を掴んだ馬乗りパイズリ\n\n背景等はお任せします\n\nよろしくお願いします", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurowana/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/efa76503/uploads/origins/b498c398-94e5-46ca-bad2-72f0eb49c527?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=400ac4540eb2c60bb3b999fa2248ab3e", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2583374, "client_id": 619808, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kurowana/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2583374, "client_id": 1762246, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f459958/uploads/origins/01d82804-2f13-448c-9c54-7092a4c4c469?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1475595dbb092dfe8d7568e12391f39", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f459958/uploads/origins/01d82804-2f13-448c-9c54-7092a4c4c469?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eca128fb0dfa0b2cdcf61987feeb3aaf", "src_set": ""}, "body": "こんにちは。\n\npixivのパイズリイラストが大好きです!ファイアーエムブレムフェイトのかげろうでロマンチックなパイズリイラストを描いていただけませんか？彼女はベッドに腕を後ろに回して寝ています。男性はかげろうの巨乳をしっかり抱いて竿を挿入しています。その他は先生にお任せします。\n\nhttps://nintendo.fandom.com/wiki/Kagero", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurowana/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2583374, "client_id": 1322433, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba49122a/uploads/origins/b86105bf-4090-45af-8e45-be159859eca9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d9b1bd045827dee244749215c6b2a12", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba49122a/uploads/origins/b86105bf-4090-45af-8e45-be159859eca9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=772b5b946b4625ca89d603a1ff670826", "src_set": ""}, "body": "こんにちは。\n\nイラストをお願いしたいのですが。\n\n八坂神奈子を描いていただけませんか？\n服を着ていて、シャツをまくり上げて胸が見えるよ