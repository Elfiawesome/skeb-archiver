f0-6a0e807d4785?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9eebd38408b4f90fecaafb93a3fc0205 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d04065e5/uploads/origins/4bd1ae38-e3a6-4217-8df0-6a0e807d4785?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66409eb354b7b4df3871a40ef790fe27", "srcset": "https://si.imgix.net/d04065e5/uploads/origins/4bd1ae38-e3a6-4217-8df0-6a0e807d4785?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66409eb354b7b4df3871a40ef790fe27, https://si.imgix.net/d04065e5/uploads/origins/4bd1ae38-e3a6-4217-8df0-6a0e807d4785?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a0e7be230c10a7635ca4e1dc037c715d 2x, https://si.imgix.net/d04065e5/uploads/origins/4bd1ae38-e3a6-4217-8df0-6a0e807d4785?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=951adbba71b6575c9c258d8bfcb717e0 3x"}, "body": "お世話になります。再びご依頼させていただきたいです。\n\n「だがしかし」より枝垂ほたるの主観舌出しイラストをお願いできればと思います。\n\n無邪気な雰囲気を醸し出しながら「あなたのことも駄菓子のように味わってあげましょうか？」的な感じで口を大きく開け、長さ40cm・横幅15cmほどの凄まじい広さ・大きさを誇る先の丸い長舌を見せつけるように思いっきり伸ばしている、といったシチュエーションでお願いします。\n\nそしてもしよろしければ、目隠し差分も描いて頂けると大変ありがたいです。\n\n前回と同様少々細かく書いてしまいましたが、よければご一考のほどよろしくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@soakbrain/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3096810, "client_id": 2922868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81e0fa93/uploads/origins/7dfb2e9c-2759-42a2-80c2-6fa48be65359?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd2961819df17a17bd40bde8bc21e56b", "srcset": "https://si.imgix.net/81e0fa93/uploads/origins/7dfb2e9c-2759-42a2-80c2-6fa48be65359?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cro