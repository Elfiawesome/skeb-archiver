to=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=abfdeca978a72eb2441d31aa9744139c, https://si.imgix.net/592f95d7/uploads/origins/4035ca9d-59e2-4a3f-8efc-e726ff620d06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=54820ec3e758cbd0d3aa2079436d63fd 2x, https://si.imgix.net/592f95d7/uploads/origins/4035ca9d-59e2-4a3f-8efc-e726ff620d06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=24bb898b4355ae9788b6551310ff5f5d 3x"}, "body": "こんにちは！Twitterに投稿されている『Arknights』のイラストをいつも楽しませていただいています。ススーロの夏用コスチューム姿を描いたイラストをリクエストしてもよろしいでしょうか？\n\nポーズは立ち姿で、少なくとも膝から上をフレームに収めてください。ススーロは水着の上に、普段着の白い白衣を着ています。 両手でコートの前を開き、その下にある水着をちらりと見せるようなポーズです。表情は、照れくささとふくれっ面が混ざったようなものが理想的です。体の汗や赤らんだ顔を強調していただけると嬉しいです。\n\nぜひこのリクエストをご検討いただければ幸いです！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@barurun_pen/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2689453, "client_id": 3814063, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/753679c8/uploads/origins/5be5f6a1-d5d6-4c37-b297-e3c84185bfa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ed71d81f188b6a92ad61f3c8c499854", "srcset": "https://si.imgix.net/753679c8/uploads/origins/5be5f6a1-d5d6-4c37-b297-e3c84185bfa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ed71d81f188b6a92ad61f3c8c499854, https://si.imgix.net/753679c8/uploads/origins/5be5f6a1-d5d6-4c37-b297-e3c84185bfa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44b4764a1e736ef2e7aaf46b4946d757 2x, https://si.imgix.net/753679c8/uploads/origins/5be5f6a1-d5d6-4c37-b297-e3c84185bfa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a873e8e73102adf1f580e51986cb03c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/753679c8/uploads/origins/5be5f6a1-d5d6-4c37-b297-e3c84185bfa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99bfc149037c554aa79c44bdd281c4e8", "srcset": "https://si.imgix.net/753679c8/uploads/origins/5be5f6a1-d5d6-4c37-b297-e3c84185bfa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99bfc149037c554aa79c44bdd281c4e8, https://si.imgix.net/753679c8/uploads/origins/5be5f6a1-d5d6-4c37-b297-e3c84185bfa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b3fb72b9194dd80725b45eed4ec16bc 2x, https://si.imgix.net/753679c8/uploads/origins/5be5f6a1-d5d6-4c37-b297-e3c84185bfa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2af479683a88fe684471c36a89fa3ab0 3x"}, "body": "はじめまして。\nXで拝見したイラストの可愛さに惹かれ、リクエストさせていただきます。\n\n【依頼内容】\n「魔法少女ノ魔女裁判」登場キャラクターの橘シェリーちゃんのイラストをお願いいたします。\nまた、個人的に長年大切にしているシマエナガのぬいぐるみも一緒に描いていただきたいです。高さが28cm程度あるものですが、サイズ感は厳密でなくても構いません。キャラクターとぬいぐるみ、それぞれの参考画像を添付しております。\n構図などはお任せいたしますが、頭部や帽子、帽子の装飾が切れずに収まる形にしていただけますと幸いです。\n\n【使用用途】\nアイコンやヘッダー、壁紙等に使用します。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1CJWfA9ZwhKpYe61CER7drbzoMT8ZGxuH?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@barurun_pen/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2689453, "client_id": 774710, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/029ef666/uploads/origins/f8e6d94a-c2dc-44b9-a1c1-e54c6fd433e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1be162cd3dd1ef7fb60e898ecc6cc36", "srcset": "https://si.imgix.net/029ef666/uploads/origins/f8e6d94a-c2dc-44b9-a1c1-e54c6fd433e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1be162cd3dd1ef7fb60e898ecc6cc36, https://si.imgix.net/029ef666/uploads/origins/f8e6