n・髪型も衣装に合わせてアレンジしていただいて大丈夫です。\n・PSDデータで納品いただけると幸いです。\n　また背景がある場合は、別レイヤーにしていただけますと大変嬉しいです。\n\n【キャラクター】\n3面図を固定ツイートに載せておりますので参考にしていただければ幸いです。\n描きやすいように描いていただいて大丈夫です。\nhttps://twitter.com/N_yorise_V\n\n何卒よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@GuremaruYAKUSHI/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 755401, "client_id": 1421831, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94b07455/uploads/origins/9d3d8a97-7dc4-4ef5-a005-33bf87822b63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=417b5c765ed8de1341e608e8889927e6", "srcset": "https://si.imgix.net/94b07455/uploads/origins/9d3d8a97-7dc4-4ef5-a005-33bf87822b63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=417b5c765ed8de1341e608e8889927e6, https://si.imgix.net/94b07455/uploads/origins/9d3d8a97-7dc4-4ef5-a005-33bf87822b63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=08640df39999af26f6acf4bab4c4a03f 2x, https://si.imgix.net/94b07455/uploads/origins/9d3d8a97-7dc4-4ef5-a005-33bf87822b63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c55f6042852d647bb7f74a92e96e9183 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94b07455/uploads/origins/9d3d8a97-7dc4-4ef5-a005-33bf87822b63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22581117b7341992e27be37a090a9119", "srcset": "https://si.imgix.net/94b07455/uploads/origins/9d3d8a97-7dc4-4ef5-a005-33bf87822b63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22581117b7341992e27be37a090a9119, https://si.imgix.net/94b07455/uploads/origins/9d3d8a97-7dc4-4ef5-a005-33bf87822b63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=57d3