b-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962179324829962240%2FenfLSivc.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eded306bfb6183217b542ff5ff9921ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962179324829962240%2FenfLSivc.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ccfb479a7d1de354f18357b4c981361", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962179324829962240%2FenfLSivc.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ccfb479a7d1de354f18357b4c981361, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962179324829962240%2FenfLSivc.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fad73cebc50042a63e2086dd2027d2ec 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1962179324829962240%2FenfLSivc.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b6608e971ad03b8d45773bbb18144486 3x"}, "body": "霞禄さん\nお世話になっております。里里と申します。（鍵垢承認ありがとうございます！）\n\nいつもフェチにぶっ刺さるワンピイラストありがとうございます。\n\nイラストを初めて2.5年となりました。\n今年に入ってやっと「頑張れたかな」「前より崩れてないな」という自己評価をつけることができるようになり、9月になり「友人にもイラストがんばってる！と見せられるかな」と思えるようになりました。\n\n霞禄さんからアドバイスいただきたく、依頼いたしました。\n顔→身体→服→背景..の順に成長したいと思っています。\n・毎回フェチ度の高いイラストが素晴らしいなとみています。盛り込むコツなど教えていただけますでしょうか？服とかも毎回「このキャラ着てそう～～」と思うのですが、どのようにチョイスしていらっしゃるのでしょうか...?\n・立体的な影もかすみさんの魅力だと思います。\n　私のイラストは影がまだまだ淡いです。(勇気をもって濃くできない)\n　どのようにして力を磨かれたのでしょうか...?\n・霞禄さんから見て直すべき点を教えていただきたいです。\n・私のイラストとは離れますが、これまで成長のためによかったもの(本/動画/習慣)などよろしければ教えていただきたいです。\n\n＿＿＿＿＿＿＿\n以降、アドバイスの材料になるかと私の自己分析を記載しておきます。\n・グリザイユ画法で描いています。以下のような手順です。\n　ラフ⇒線画⇒モノクロベタ塗り⇒｛モノクロライティング⇒カラー｝繰り返し⇒仕上げ\n　直近の2Bのイラストは7Hほどで完成しております。\n・かわいい×美人な絵を描きたい（可能であればフェチを付属したい）と思っています。\n・骨格を意識した身体どりを以前別の方にskebでご指摘いただきました。\n　→少しずつ改善できている..とは思っています。まだまだですが,,,\n・肌を塗るのは楽しい。\n・服が苦手だなー、、と思っています。素材の意識やシワの意識が弱いのだろうなと思っています。\n\n以上です。最後までご確認いただきありがとうございます。よろしくお願い申し上げます。\n\nhttps://www.pixiv.net/users/5403410", "nc": 16, "word_count": 2358, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@1234rabitto/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 313161, "client_id": 2719562, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9accaaee/uploads/origins/d17ae941-45c3-44fc-b3dd-82fc703d7842?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=388dbf1f07c21a056ebaa75b0e7c8b2b", "srcset": "https://si.imgix.net/9accaaee/uploads/origins/d17ae941-45c3-44fc-b3dd-82fc703d7842?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=388dbf1f07c21a056ebaa75b0e7c8b2b, https://si.imgix.net/9accaaee/uploads/origins/d17ae941-45c3-44fc-b3dd-82fc703d7842?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=331060256a98d2e72acf489d6cd5f5d2 2x, https://si.imgix.net/9accaaee/uploads/origins/d17ae941-45c3-44fc-b3dd-82fc703d7842?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3ecfab27e48b5abd5bfdc81baec82d9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_t