-4de8-949f-e07226e68ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c2340add6ca166bf02b225c09393021", "srcset": "https://si.imgix.net/d577783c/uploads/origins/be12acd1-7a71-4de8-949f-e07226e68ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c2340add6ca166bf02b225c09393021, https://si.imgix.net/d577783c/uploads/origins/be12acd1-7a71-4de8-949f-e07226e68ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66066f0270d4c59511537545824df17b 2x, https://si.imgix.net/d577783c/uploads/origins/be12acd1-7a71-4de8-949f-e07226e68ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82e73054f3579740eeaee5642509d7ee 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d577783c/uploads/origins/be12acd1-7a71-4de8-949f-e07226e68ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e832337640a644d578b5c0692af8ceb", "srcset": "https://si.imgix.net/d577783c/uploads/origins/be12acd1-7a71-4de8-949f-e07226e68ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e832337640a644d578b5c0692af8ceb, https://si.imgix.net/d577783c/uploads/origins/be12acd1-7a71-4de8-949f-e07226e68ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9281df6506cf3ad57b0b8f317e04b90 2x, https://si.imgix.net/d577783c/uploads/origins/be12acd1-7a71-4de8-949f-e07226e68ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1eab0f35d7311fbbe9a2d8478d837cca 3x"}, "body": "雑念様\n\nこんばんは、Skebの新着でイラスト拝見し、一目惚れでした…！描かれる空気感のきらびやかさ、キャラクター同士の距離感の表現が素敵で、またXの版権イラストもとても美しくて…！\nぜひ雑念様に私と友人のキャラクターを描いていただけないかと思い、リクエスト失礼いたします。\n\n◆使用用途\n個人鑑賞/個人利用のみのアクリルグッズ作成\n友人と共有させていただき、思い出に花を添える\n\n◇キャラクターについて\nエモクロアTRPG『フロムヘル』というシナリオを一緒に遊んだ、キャラクター2名です。\n現代日本をベースに怪異と呼ばれる異形が出現する世界観で、『夕影』という警察の特殊組織に所属しており、市民を守るために怪異と戦っている先輩後輩バディです。武器として日本刀を使っています。\n女性の方が先輩、男性の方が後輩です。\n\n・先輩（女性のほう）\n月桃染 幽良 / 28歳\n天賦の身体能力と武芸百般の才を持つ先輩。ゆるい言動の大型犬気質、後輩に対して甘く面倒見がよい。\n二刀流ではなく一刀を必要に応じて使い分けるタイプ。後輩の前ではあまり吸わないが喫煙者。好物は甘いもの。\n\n・後輩（男性のほう）\n柊 千歳 / 22歳\n『夕影』に所属したばかりの新人。無気力気味、やりたくないことはサボりがち、無表情で眠たげだがたまに年頃らしいもする。戦闘に関しては恐ろしいほどの才能を見せる。\n\n\nお互いに恋愛感情はない先輩後輩ですが、後輩が年頃の男の子らしく意識したり…といったことはあるかもしれない2人です。上記内容からどんなものでも、自由に描いていただけたらと思います！\nぜひご縁をいただけたら嬉しいです、ご検討何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1nALI3QMvF4Lreb7Dd5dP6mTg76sT0ETq?usp=share_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@zat___296/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4084854, "client_id": 1389755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/210f1db1/uploads/origins/68e80cbd-42c3-483f-8a11-152d23600582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f88a39ec07b3c9565087ab09500b64c", "srcset": "https://si.imgix.net/210f1db1/uploads/origins/68e80cbd-42c3-483f-8a11-152d23600582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f88a39ec07b3c9565087ab09500b64c, https://si.imgix.net/210f1db1/uploads/origins/68e80cbd-42c3-483f-8a11-152d23600582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a907331c698b740b3e2226ee2f221be1 2x, https://si.imgix.net/210f1db1/uploads/origins/68e80cbd-42c3-483f-8a11-152d23600582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15c17e7b9706f706af532ad7882b020d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/210f1db1/uploads/origins/68e80cbd-42c3-483f-8a11-152d23600582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af632804a65a4e834449500620a9cdd6", "srcset": "https://si.imgix.net/210f1db1/uploads/origins/68e80cbd-42c3-483f-8a11-152d23600582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af632804a65a4e834449500620a9cdd6, https://si.imgix.net/210f1db1/uploads/origins/68e80cbd-42c3-483f-8a11-152d23600582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5f56ee7f50aadc8494659efcdea8119 2x, https://si.imgix.net/210f1db1/uploads/origins/68e80cbd-42c3-483f-8a11-152d23600582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=249d8a1635004e3b393b5eb353640d10 3x"}, "body": "こんにちは、skebの受付を開始してくれてとても嬉しいです！\n私のOCに依頼したいです。\nhttps://lemon-beauty-455.notion.site/34743213d261802893c9f0ed8709c759?pvs=74", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@zat___296/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4084854, "client_id": 2462364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4dff342c/uploads/origins/7f2f0a02-5783-485b-bea9-0fee3d286f55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2008b50189a4e20e2bcbfb1fb7f52f72", "srcset": "https://si.imgix.net/4dff342c/uploads/origins/7f2f0a02-5783-485b-bea9-0fee3d286f55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2008b50189a4e20e2bcbfb1fb7f52f72, https://si.imgix.net/4dff342c/uploads/origins/7f2f0a02-5783-485b-bea9-0fee3d286f55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e484db6cb44208dda5d8438a4e9554cb 2x, https://si.imgix.net/4dff342c/uploads/origins/7f2f0a02-5783-485b-bea9-0fee3d286f55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a38aef0fcedb37be4f71134038b81b0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4dff342c/uploads/origins/7f2f0a02-5783-485b-bea9-0fee3d286f55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35bdec3429bc19fd66aaf9defdf8f0cb", "srcset": "https://si.imgix.net/4dff342c/uploads/origins/7f2f0a02-5783-485b-bea9-0fee3d286f55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35bdec3429bc19fd66aaf9defdf8f0cb, https://si.imgix.net/4dff342c/uploads/origins/7f2f0a02-5783-485b-bea9-0fee3d286f55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b77370226f6d519d418186762cabfe78 2x, https://si.imgix.net/4dff342c/uploads/origins/7f2f0a02-5783-485b-bea9-0fee3d286f55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4aa920de1345f8ca800a9cad3a7726ab 3x"}, "body": "こんにちは！お邪魔して申し訳ありません！この依頼についてですが、もしよろしければ、私のオリジナルキャラクター（OC）たちのやり取りを描いていただけないでしょうか。二人の時代設定はともに20世紀初頭で、ストーリーに関する詳細はすべて【すべての物語の完全なあらすじ】に記載されています。\n\n↓以下に、彼らの簡単なキャラクター紹介と要望を記載します。\n\n（ボトム）コンスタンティン：24歳、金髪・赤瞳、身長182cm、背が高く細身で、体つきは華奢、物腰は優雅。コンスタンティンは貴族で、一族は非常に裕福であり、両親や兄からも溺愛されています。コンスタンティンは聡明で優秀ですが、貴族らしい気性があり、高慢で自尊心が強い反面、人当たりは穏やかですが、どこか距離感を感じさせる人物です。大学を早期卒業した後、文学の道に進み、執筆活動やジャーナリズムの分野で重要な地位を占めている。その聡明さゆえに、時折警察から事件の捜査協力を依頼されることもある。彼はヴィラカスを高く評価しており、その評価は後に二人が共通の秘密を持つようになったことで、好意へと変わっていった。\n\n（トップ）ヴィラカス：21歳、186cm、茶色の軽くウェーブのかかった髪、緑の瞳、標準的な体格、穏やかで礼儀正しい。ビラカスは比較的裕福な平民の出身で、コンスタンティンの助手である。コンスタンティンを崇拝していたため、彼の新聞社に就職を志願し、助手として採用された。コンスタンティンの身の回りの世話をし、とても従順で、まるで忠犬のようなキャラクターであり、コンスタンティンに強く依存している。\n\n描いてみたい衣装は、お好きなものを自由に選んでください！（西洋ファンタジーの設定がお好きなら、画像28の衣装を選んでみてください！もちろん、それ以外の衣装もすべて選択可能です！）\n\nもし金額が合わない場合は、再度リクエストを送っていただけると大変助かります！もしお手数だとお感じでしたら、そのままキャンセルしていただいても構いません。もし今回の依頼をお引き受けいただけましたら、心より感謝いたします！\n\nhttps://drive.google.com/drive/folders/1mP_-_aYjvuPUdyoPB12Sek3bUxpMOry1?usp=share_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@zat___296/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4084854, "client_id": 2618136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f17ed19/u