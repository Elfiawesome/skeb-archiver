=200&h=200&s=f52c4ad3ebcb939e889d5139489818e3, https://si.imgix.net/783035b7/uploads/origins/daad2646-d173-40f6-9831-de49eba5e6fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05b1463d7d253c78dd7b73fb8d7d8606 2x, https://si.imgix.net/783035b7/uploads/origins/daad2646-d173-40f6-9831-de49eba5e6fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90fe4ca25e9c912aad846db19352c036 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/783035b7/uploads/origins/daad2646-d173-40f6-9831-de49eba5e6fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69d2b660e30f0e2222d4ffd25edae6f7", "srcset": "https://si.imgix.net/783035b7/uploads/origins/daad2646-d173-40f6-9831-de49eba5e6fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69d2b660e30f0e2222d4ffd25edae6f7, https://si.imgix.net/783035b7/uploads/origins/daad2646-d173-40f6-9831-de49eba5e6fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f2537c3e72e2826b86dd5abf8c71e64 2x, https://si.imgix.net/783035b7/uploads/origins/daad2646-d173-40f6-9831-de49eba5e6fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=049724b8d76ca564bb8130b478deaf44 3x"}, "body": "はじめまして！\n殻付き様のイラストがとても大好きでして、\nリクエストをさせて頂きました。\n私のオリジナルキャラクターの\n魔女とその手下の女の子をお願いいたします。\n構図や服装なども殻付き様の描きやすいようにして頂いて大丈夫です…！\n出来れば手下の女の子が10歳ほどの外見で幼いので、可能であればちょっと成長した感じでお願いしたいです。\n資料でピクシブに掲載した漫画を\n送らせて頂きます。\nhttps://www.pixiv.net/artworks/67334551\n\nこちらはちょっと長めの漫画になります。\n（読まなくても大丈夫です！）\nhttps://www.pixiv.net/artworks/72341954\n\nご検討お願いいたします。\n殻付き様のイラストとっても可愛くて大好きです…！\nご活動応援しております！\nよろしくお願いいたします。", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karatukikarara/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 102724, "client_id": 2459188, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aae7999f/uploads/origins/491d1e27-ed8b-4cb8-be83-e436bb7c9009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff7c7e29ff3a2792f68c0b137618a9d7", "srcset": "https://si.imgix.net/aae7999f/uploads/origins/491d1e27-ed8b-4cb8-be83-e436bb7c9009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff7c7e29ff3a2792f68c0b137618a9d7, https://si.imgix.net/aae7999f/uploads/origins/491d1e27-ed8b-4cb8-be83-e436bb7c9009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1608c424d1915ac61a2dd672819a813e 2x, https://si.imgix.net/aae7999f/uploads/origins/491d1e27-ed8b-4cb8-be83-e436bb7c9009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=196b7642ad12d54ac9f125f73a0f9180 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aae7999f/uploads/origins/491d1e27-ed8b-4cb8-be83-e436bb7c9009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1db7068b5742540658fe38bba2bf67f4", "srcset": "https://si.imgix.net/aae7999f/uploads/origins/491d1e27-ed8b-4cb8-be83-e436bb7c9009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1db7068b5742540658fe38bba2bf67f4, https://si.imgix.net/aae7999f/uploads/origins/491d1e27-ed8b-4cb8-be83-e436bb7c9009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b2208aed86bb07193b9dcab769705572 2x, https://si.imgix.net/aae7999f/uploads/origins/491d1e27-ed8b-4cb8-be83-e436bb7c9009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a4ce51405bd16747993b67419a108d94 3x"}, "body": "殻付き様\n\n殻付き様の柔く、センスの溢れるイラスト、いつも楽しく見させていただいております。以前より機会があればご依頼したいと思っており、もしよろしければ無理のない範囲で下記をお願いできたらと思っております。不足などあればお手数ですが再送いただければと思います。ご検討ください……！\n\n◇使用用途\n・利益の発生しない完全個人利用\n・相方PLとのデータ共有（アイコン、ヘッダーなど）\n・個人観賞用のグッズ製作（アクスタやポストカード、自分用のログ本での印刷）\n\n■希望\n以前描いていただいたキャラクターの幼少期で下記のモチーフの中から殻付き様がお好きなものでイラストを描いていただけたら嬉しいです！資料はグーグルドライブに添付しております。\n\n・水兵さん（セーラ服や海）モチーフ\n・クラゲモチーフ\n・和風モチーフ\n・紫陽花モチーフ\n・雨モチーフ\n\n小さいふたりが仲良くしてる感じだと嬉しいです！\n殻付き様のセンスが大好きですのでご自由に描いていただけたら嬉しいです……！\n\n◇その他\nタトゥーや火傷は今回ありませんので資料には幼少期のものを中心にいれております。\n大人の時のデザインなども資料にありますので適宜見ていただけたら幸いです……！\n\nhttps://drive.google.com/drive/folders/1boZa5Ao9YViZ_76fzqURJheoYrjXnKqm?usp=sharing", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karatukikarara/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 102724, "client_id": 1327078, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5df334e/uploads/origins/db656a26-477c-4d8e-b22c-2cb1d9fa192d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=365d698f4317238ab81401732ad10d90", "srcset": "https://si.imgix.net/a5df334e/uploads/origins/db656a26-477c-4d8e-b22c-2cb1d9fa192d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=365d698f4317238ab81401732ad10d90, https://si.imgix.net/a5df334e/uploads/origins/db656a26-477c-4d8e-b22c-2cb1d9fa192d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea6c32dd192a4a784de399011792d077 2x, https://si.imgix.net/a5df334e/uploads/origins/db656a26-477c-4d8e-b22c-2cb1d9fa192d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bdace8c547037d3bf975f1b20351fa58 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5df334e/uploads/origins/db656a26-477c-4d8e-b22c-2cb1d9fa192d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b3502a65ab8276f9d021236df47fd62", "srcset": "https://si.imgix.net/a5df334e/uploads/origins/db656a26-477c-4d8e-b22c-2cb1d9fa192d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b3502a65ab8276f9d021236df47fd62, https://si.imgix.net/a5df334e/uploads/origins/db656a26-477c-4d8e-b22c-2cb1d9fa192d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=681a69d66912d92ca2c2f8d63d7c4025 2x, https://si.imgix.net/a5df334e/uploads/origins/db656a26-477c-4d8e-b22c-2cb1d9fa192d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1d3c2f6812bc5116adb50bd663acb2c1 3x"}, "body": "殻付き様\n\nいつもお世話になっています！お豆です！\n大大大好きな殻付き様の依頼チャンスに飛びついてしまいました。もしよろしければ、ショタの立ち絵をお願い出来ないでしょうか？\n\n［依頼内容］\n□概要\n過去にご依頼したフィクと弟切（参考資料：フィク.png、）の子供の立ち絵\n※紆余曲折あり、子供が出来ました！\n\n□使用用途\nTRPGセッション、観賞用（※完全個人利用です）\n\n□使用用途\n個人利用のみ。\nTRPGセッションでの使用、観賞用\n\n□テーマ\n冬の雪が降った日\n親子で雪が降る中で遊ぶようなイメージですが、ざっくり冬服と受け取って頂ければと思います！\n\n□キャラクター\nデザインは［子供.png］を参考にしてください。\n※髪に藤がついて描かれていますがこれは装飾ですので除いて下さい\n\n□キャラクター詳細\n・イメージカラー「紫色」\n・小学4年生（10歳）\n・白→黒のグラデーションヘアー／赤瞳\n・前髪の分け目は左寄りですが、整えたりするため好きに変えてもらって問題無し\n・八重歯\n・蛇目の瞳孔\n・やんちゃな瞬間もあるが、基本的には大人しくお利口で、賢い少年。「うん、分かったよお父さん」「パパ、俺もそれやりたい」と無邪気さもある。\n・髪型は短くするも、長くするも、結ぶも、好きにアレンジしてもらって大丈夫です！\n\nざっくり以上となります。\n「冬服の子供」をテーマに好きに描いて頂ければ嬉しいです！\n髪型から服装まで、ぜひぜひ楽しく描きやすいように描いてください！\n\nもし難しければこのリクエストは拒否していただいて構いません。\n失礼がありましたら再送依頼を頂けると情報の追加、もし不足分の金額を追加し再度依頼したいと考えております。\n\nいつも素敵な作品をありがとうございます。\n今後も応援しています！\n\nhttps://drive.google.com/drive/folders/1TwLkkn24E-CekUBF48s7PrDy16lFUvDF?usp=sharing", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karatukikarara/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bb4bde17/uploads/origins/83c6dbe6-c1de-4bfb-bba4-9f7b437b181f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ec4f8c183384208d00446e1e16cfca0", "srcset": "https://si.imgix.net/bb4bde17/uploads/origins/83c6dbe6-c1de-4bfb-bba4-9f7b437b181f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtsha