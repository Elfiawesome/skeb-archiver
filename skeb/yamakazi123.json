e", "creator_acceptable_same_genre": true}, {"path": "/@yamakazi123/works/64", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 69866, "client_id": 164472, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/36dbd095/uploads/origins/a3722eff-3d9e-4f7a-ab2b-e9d7030bbbd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64cd558f6de2a23c5716465a82a53ca2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36dbd095/uploads/origins/a3722eff-3d9e-4f7a-ab2b-e9d7030bbbd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe0b2b3e2bce0d96a33203ec1e9494e9", "src_set": ""}, "body": "白神風吹を巨女にリクエスト。大げさな胸をしてほしい。小さな男の子を胸に閉じ込めて、もう一人を飲み込んでほしい。\n\nhttps://imgur.com/a/dPXm9xy", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamakazi123/works/63", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/84797462/uploads/origins/e8277787-19c4-4164-8121-87e0f6fbdcd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=386d25f5ac51cdf6abf31c319e52fe16", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 69866, "client_id": 164472, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yamakazi123/works/62", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 69866, "client_id": 1533762, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f028fd86/uploads/origins/e5538d90-88e1-41fa-993f-7c2442236db1?bg=%23fff&auto=format%2Ccompress