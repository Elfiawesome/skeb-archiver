会話を交わすことって大事だなと思う。やはりツラがいいから許せるのかもしれない  \n\nご制作いただいたイラストはsnsやグッズ制作等、自分とうちよそ御相手様で個人利用をさせていただきたいです。  ここまで読んでいただきありがとうございました！ご検討お願い致します🙏\n\nhttps://drive.google.com/drive/folders/130nT72FQcNMQMEJuIfAba7fZ8OKqP9BU", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 2801851, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "穴屋", "screen_name": "Arara_kaibunsyo", "avatar_url": "https://pbs.twimg.com/profile_images/2029355938705227777/GjfHSmaP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1954842180138545152/1772671089/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 128}, {"id": 2875278, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あんどう本舗", "screen_name": "Andou_Honpo", "avatar_url": "https://pbs.twimg.com/profile_images/1346146310349488128/EHaNtlie.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1346146116614557697/1609931174/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "novel"}], "banned": false, "nc": 49}, {"id": 3225341, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "fy_fp7", "screen_name": "fy_fp7", "avatar_url": "https://pbs.twimg.com/profile_images/1964226856087146499/IjTD8lar.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1885511593070649344/1746858486/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "de