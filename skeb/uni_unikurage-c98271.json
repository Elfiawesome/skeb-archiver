8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4739bfff7cc5fa7f19c53f72838027da, https://si.imgix.net/bee92871/uploads/origins/a9257587-8407-46d3-8f4b-7d3167bb458f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74b5096c3f36aed262bb1b9f9caa4b66 2x, https://si.imgix.net/bee92871/uploads/origins/a9257587-8407-46d3-8f4b-7d3167bb458f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1f9e7a454e24314985cf37b80dde141 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bee92871/uploads/origins/a9257587-8407-46d3-8f4b-7d3167bb458f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf0448bcacf8b17e2dcb9eab9725d0ef", "srcset": "https://si.imgix.net/bee92871/uploads/origins/a9257587-8407-46d3-8f4b-7d3167bb458f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf0448bcacf8b17e2dcb9eab9725d0ef, https://si.imgix.net/bee92871/uploads/origins/a9257587-8407-46d3-8f4b-7d3167bb458f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=257e577aef765fd0522459e3e7452a76 2x, https://si.imgix.net/bee92871/uploads/origins/a9257587-8407-46d3-8f4b-7d3167bb458f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e3c906759c9c609e8e8dd44a41c6e303 3x"}, "body": "いつも作品楽しく拝見しています。\n前回はとても素敵なイラストをありがとうございました。\n今回もリクエストを送らせて頂きます。もしよろしければお願いします。\n依頼内容ですが、ソウルハッカーズ２のリンゴでいちゃラブセックスをお願いします。\nhttps://soul-hackers.jp/character/ringo/\n衣装は半脱ぎで胸元が露出した状態を希望します。前回の作品の下着が非常に良かったので、もし可能であれば今回も下着の描写があると有り難いです。\n男性描写は最低限で、表情は涙を浮かべて気持ち良さそうな様子でお願いしたいです。\n構図と体位にシチュエーションはお任せしますが、海栗様の描く足の描写が好きなので素足が見える状態で挿入されていると嬉しいです。\n更に可能であれば台詞なども簡単な内容で構いませんので何かあると凄く有り難いです。\n要望が多くなりましたが、対応できる範囲で大丈夫です。\n\nご検討頂ければ幸いです。\nよろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uni_unikurage/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 48573, "client_id": 763017, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24aedde2/uploads/origins/acbf0424-fc34-4882-ac2c-e3615fc2a9a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b77c68be6d49baf2df943c16e02d3ea", "srcset": "https://si.imgix.net/24aedde2/uploads/origins/acbf0424-fc34-4882-ac2c-e3615fc2a9a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b77c68be6d49baf2df943c16e02d3ea, https://si.imgix.net/24aedde2/uploads/origins/acbf0424-fc34-4882-ac2c-e3615fc2a9a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfc8bf1b8b8fb7f2e576786c5d5c27f7 2x, https://si.imgix.net/24aedde2/uploads/origins/acbf0424-fc34-4882-ac2c-e3615fc2a9a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a133b1069f19e6a98bce68726b7650d9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24aedde2/uploads/origins/acbf0424-fc34-4882-ac2c-e3615fc2a9a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d00aeccf4f815d107c2b00a00c4223c", "srcset": "https://si.imgix.net/24aedde2/uploads/origins/acbf0424-fc34-4882-ac2c-e3615fc2a9a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d00aeccf4f815d107c2b00a00c4223c, https://si.imgix.net/24aedde2/uploads/origins/acbf0424-fc34-4882-ac2c-e3615fc2a9a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=afeebeff66919901e440dde56f763e4e 2x, https://si.imgix.net/24aedde2/uploads/origins/acbf0424-fc34-4882-ac2c-e3615fc2a9a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2bab643b876bd572e640aafeb76899a 3x"}, "body": "海栗 様\n\nはじめまして。\n絵のタッチが大変好みでしたのでリクエストさせていただきました。\n断髪系のリクエストとなります。苦手に感じられましたら遠慮なくキャンセルしてください。\n\nリクエスト内容：\nかぐや様は告らせたいの【藤原千花】と【伊井野ミコ】が\nバリカンで丸坊主にされてしまうシーンをお願いします。\n\nシチュ指定：\n・デフォルト状態と断髪差分2枚を含めて全3枚の構成\n・ポーズは蹲踞\n・表情は涙を流しつつ睨んでいる（or嫌がってる）感じで\n・2人の服装は白のマイクロビキニですが胸や性器は布をずらすなどして露出させてください\n・顔、頭、胸にぶっかけられた精液が付着していて、膣内からも中出しされた精液が垂れている状態\n・刈り手は全裸の男性（勃起中　※1キャラに付き男1名）\n\n差分指定：\n・髪が普通にある劇中通りの状態（デフォルト状態）\n・髪の左右どちらか半分がバリカンで刈られたハーフ丸坊主状態（差分1）\n・髪が全部に刈り落されて完全に丸坊主になった状態（差分2）\n\nレイヤー分けについて：\n・精液は表示のON/OFFが出来るようにレイヤー分けしてください\n・刈り手の男性も同様にON/OFFできるようレイヤー分けしてください\n\nその他ポイント：\n・丸坊主の長さは一厘刈りで、ほとんど剃ったのと同じくらい短い状態にしてください\n・五厘刈り以下の長さになると坊主頭の色味は灰青色に近い色になります、これは肌や髪色とはまた違う色味です\n・刈った髪はそのまま床や体に落としてください。\n・バリカンで刈った髪は意外と毛束となってブロック単位で落ちます、落ちた髪にも元の髪型の痕跡が所々に残ってる感じでお願いします\n（床に落ちた髪については質感や長さが頭に付いていた時と同様になっているのが理想です）\n・使うバリカンのイメージは「ヘアークリッパー MODEL 5500」というモデルで、なるべくこれに似せてもらえるとありがたいです\n　（大きさはだいたい500ミリペットボトル位です、メーカー名部分は消すか改変願います）\n・背景の細かい指定はありませんが、明るい空間で行われてる雰囲気となるようにお願いします\n・画像の長辺は3000px以上でお願いいたします。\n\n下記サイトの掲示板でも掲示する場合があります\nhttps://www.futabafetish.com\nどうぞよろしくお願いいたします", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uni_unikurage/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 48573, "client_id": 2264581, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/395ed492/uploads/origins/6ac5cc36-c642-4b62-a5c7-66a89f55ab5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f952338b17e4502d077585dc3eac5333", "srcset": "https://si.imgix.net/395ed492/uploads/origins/6ac5cc36-c642-4b62-a5c7-66a89f55ab5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f952338b17e4502d077585dc3eac5333, https://si.imgix.net/395ed492/uploads/origins/6ac5cc36-c642-4b62-a5c7-66a89f55ab5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76ae4c4210db8742e2bd97f4d84ae287 2x, https://si.imgix.net/395ed492/uploads/origins/6ac5cc36-c642-4b62-a5c7-66a89f55ab5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=2