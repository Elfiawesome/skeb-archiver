ターを理解するのに役立ちそうな資料があります。\n胡桃のキャラクターデモ：https://www.youtube.com/watch?v=qrH9vMZBwAk\n胡桃の参考画像：https://genshin-impact.fandom.com/wiki/Hu_Tao?file=Character+Hu+Tao+Card.png\n\nありがとうございました。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@DrawDrawDeimos/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1448614, "client_id": 1457670, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c09a7fc/uploads/origins/9016b62e-bed5-4bc1-a211-78bde06eb562?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b71a9d2158ae44e32e07e22bf301ad0", "srcset": "https://si.imgix.net/0c09a7fc/uploads/origins/9016b62e-bed5-4bc1-a211-78bde06eb562?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b71a9d2158ae44e32e07e22bf301ad0, https://si.imgix.net/0c09a7fc/uploads/origins/9016b62e-bed5-4bc1-a211-78bde06eb562?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b87ffbceedc082ba9f782bda4f37e12 2x, https://si.imgix.net/0c09a7fc/uploads/origins/9016b62e-bed5-4bc1-a211-78bde06eb562?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a74d22a255a8333930d3fab2e489609 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c09a7fc/uploads/origins/9016b62e-bed5-4bc1-a211-78bde06eb562?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e92a5f5384e1758de0d4100a7a39501c", "srcset": "https://si.imgix.net/0c09a7fc/uploads/origins/9016b62e-bed5-4bc1-a211-78bde06eb562?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e92a5f5384e1758de0d4100a7a39501c, https://si.imgix.net/0c09a7fc/uploads/origins/9016b62e-bed5-4bc1-a211-78bde06eb562?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b4ab5314ac69e961620683bfa29c3a33 2x