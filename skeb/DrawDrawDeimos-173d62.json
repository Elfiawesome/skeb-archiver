200&h=200&blur=200&s=5451512fb4f6a1b615bb230da9a28e16 2x, https://si.imgix.net/65ac676b/uploads/origins/94e96c39-ee9b-4afa-a632-8b6a36450d51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4229127fbab96329f5e7086554c80f07 3x"}, "body": "もし可能であれば、私のオリジナルキャラクターであるミシャの絵をお願いしたいです。無職の酒乱で、とても情けないのですが、いざとなったらカッコよくなれるクマ娘です。よろしくお願いします！\n\nhttps://tenkotenkotenkotenkotenko.tumblr.com/post/715230285607927808/this-pic-goes-hard-feel-free-to-rb-do-not-ask-if", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@DrawDrawDeimos/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1448614, "client_id": 843546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/004aa804/uploads/origins/aa685203-da0a-4b77-bab5-c0d300512d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcf6b3fc9a2fc4e3785a2a9223641a59", "srcset": "https://si.imgix.net/004aa804/uploads/origins/aa685203-da0a-4b77-bab5-c0d300512d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcf6b3fc9a2fc4e3785a2a9223641a59, https://si.imgix.net/004aa804/uploads/origins/aa685203-da0a-4b77-bab5-c0d300512d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9a6b1c173ad74c88051a5b533db484c 2x, https://si.imgix.net/004aa804/uploads/origins/aa685203-da0a-4b77-bab5-c0d300512d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f076b2bd1ba1e200a571dcbaa894b45e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/004aa804/uploads/origins/aa685203-da0a-4b77-bab5-c0d300512d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7aa5eea7ecf65ae1f98f1b1aff6d236a", "srcset": "https://si.imgix.net/004aa804/uploads/origins/aa685203-da0a-4b77-bab5-c0d300512d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7aa5eea7ecf65ae1f98f1b1aff6d236a, https://si.imgix.net/004aa804/uploads/origins/aa685203-da0a-4b77-bab5-c0d300512d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f88cc92cb2c6811b9c3fcbe3d9fa2dd 2x, https://si.imgix.net/004aa804/uploads/origins/aa685203-da0a-4b77-bab5-c0d300512d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5cf6e1584b8bb6fce63c01167235fa49 3x"}, "body": "でいもすさん、こんにちは。\n以前描いていただいた陽炎がとても素敵だったので、もしよろしければ再び艦これのキャラクターでリクエストさせて下さい……！\n\n今回描いていただきたいのは嵐です。\n•艦これアーケード紹介キャラ動画：\nhttps://youtu.be/VMyGA--mbH8\n•ブラウザ版：\nhttps://imgur.com/a/KtUwWHm\n\n前回同様、制服姿で全身が入っている内容であれば、表情や構図はおまかせします。\n上記の内容でよろしければ、ぜひお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@DrawDrawDeimos/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1448614, "client_id": 2616430, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f87b2a57/uploads/origins/93ba293f-58e6-427e-82bb-5d3304322733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3badec2afe4701154913cff508d5b765", "srcset": "https://si.imgix.net/f87b2a57/uploads/origins/93ba293f-58e6-427e-82bb-5d3304322733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3badec2afe4701154913cff508d5b765, https://si.imgix.net/f87b2a57/uploads/origins/93ba293f-58e6-427e-82bb-5d3304322733?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f74e911e55caabdbb8c80e3dc429500f 2x, https://si.imgix.net/f87b2a57/uploads/origins/93ba293f-58e6-427e-82bb-5d3304322733?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab810a6391629cc18d30cf5de5239c7f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f87b2a57/uploads/origins/93ba293f-58e6-427e-82bb-5d3304322733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f3a330da3bce3adf61c26c90dec3912", "srcset": "https://si.imgix.net/f87b2a57/uploads/origins/93ba293f-58e6-427e-82bb-5d3304322733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f3a330da3bce3adf61c26c90dec3912, https://si.imgix.net/f87b2a57/uploads/origins/93ba293f-58e6-427e-82bb-5d3304322733?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=745f5e688ea7a5fdd994ca90f4d52d0c 2x, https://si.imgix.net/f87b2a57/uploads/origins/93ba293f-58e6-427e-82bb-5d3304322733?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4b90f6d6ac83a277ea36c5db5b1e7876 3x"}, "body": "はじめまして。\nでいもす様が描かれる魅力的な女の子の絵柄に惹かれました。\n是非うちの子を描いて頂きたくリクエストさせていただきます。\n\n◆用途\ntwitter等SNSでの使用\n\n◆三面図・キャラ参考資料\nうちの子の参考資料です。\nhttps://twitter.com/silas_012/status/1624678045637550083?s=20\n\n◆構図・ポージング\nこちらのクールで魅力的な立ち姿がとても好きなので、この構図・ポージング・表情をベースにして頂けると嬉しいです。\n（あくまでイメージですので、こちらのイメージをベースに自由にアレンジ頂いて構いません）\nhttps://twitter.com/DrawDrawDeimos/status/1644556177408397312?s=20\n\nなお、手に持つのはタバコではなく、うちの子が愛用する万年筆でお願いします。\nhttps://www.montblanc.com/ja-jp/%E4%B8%87%E5%B9%B4%E7%AD%86_cod1647597288538744.html?gclid=CjwKCAiA_6yfBhBNEiwAkmXy57IfQLxcHXpAfxmwKulJ3tYb1QFS6M3CNDtRoMqYP1Hqi98mJJGUbxoCwUsQAvD_BwE&gclsrc=aw.ds\n\n◆服装\n制服でお願いします。\nもしよろしければ制服の上にニットやカーディガン、あるいはパーカーやジャケットなど、クールに羽織らせてもらえると嬉しいです。\n\n◆納品データ\nPSDとPNGで納品希望です。\n\n以上、\nご検討のほどよろしくお願いいたします。\n\nhttps://twitter.com/silas_012/status/1624678045637550083?s=20", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@DrawDrawDeimos/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1448614, "client_id": 2060218, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/43174adc/uploads/origins/bcd98a8b-f7d7-47d