a11-98a4-4c9e-8850-204e3898d9d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f412e804d81f774d031bb9d34ac9744 2x, https://si.imgix.net/343429eb/uploads/origins/bf5ffa11-98a4-4c9e-8850-204e3898d9d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=275c999ca749aed32b8f959a94e95d49 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/343429eb/uploads/origins/bf5ffa11-98a4-4c9e-8850-204e3898d9d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffc756c3ba9ba9515cb9be23c4a17a29", "srcset": "https://si.imgix.net/343429eb/uploads/origins/bf5ffa11-98a4-4c9e-8850-204e3898d9d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffc756c3ba9ba9515cb9be23c4a17a29, https://si.imgix.net/343429eb/uploads/origins/bf5ffa11-98a4-4c9e-8850-204e3898d9d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2702dde602ec1def3652cc22633087e0 2x, https://si.imgix.net/343429eb/uploads/origins/bf5ffa11-98a4-4c9e-8850-204e3898d9d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=82a8c76f90bcc13f88703f01d6db476a 3x"}, "body": "新着に上がっていた島村さんの陰毛が素晴らしかったので、同ユニットのアイドルでリクエストさせてください\n実在するAV「あなたの陰毛みせてください」の投稿雑誌版に事務所に無断で出演する小日向美穂をお願いします\n\n構図：以前描かれていた「パンツはいてない浅倉」のスカートをつまみ上げ、パンツをずり下げているような感じで\nhttps://www.pixiv.net/artworks/82985835\n個人的な解釈で陰毛は普段描かれているキャラの2倍近い濃さにしてください\n自重なしで盛って下さって構いません\n\n服装：下記資料から設定に近いイメージで描きやすいものを選んでください\nhttps://imas.gamedbs.jp/cgss/card/detail/1891/1891\nhttps://imas.gamedbs.jp/cg/idol/detail/11?h=658b39b8d4cebd6c30cfc5e2d7dd04c6\nhttps://imas.gamedbs.jp/cg/idol/detail/11?h=458dbe35da00fb337bf37d735cc8f54c\n\n値段の範囲内で可能なら、実際に発売された雑誌の記事を別レイヤーとしてpsdでお願いします（3サイズなどのプロフィール＋本人のコメント等の構成）\n一応街角で勧誘した素人として紹介しているが、あの有名アイドル激似と本人を匂わせるような感じで作って頂けると有難いです\n\n以上、ご検討宜しくお願い致します。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_