cGek.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c258025f5b17013efb3daa9764c628a", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2020168078521475072%2FLJQ7cGek.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c258025f5b17013efb3daa9764c628a, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2020168078521475072%2FLJQ7cGek.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd2ae547e47b872cec66993d4dbf6a98 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2020168078521475072%2FLJQ7cGek.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ed12519319bb6ddfb51a47e23d17f2f 3x"}, "body": "こんにちは！最近あなたの音楽を知ったのですが、あなたの作曲の仕方が大好きです。\n楽器がだんだんと盛り上がっていく様子や、曲の中でテンポが変化していく様子は、まるで音符を通して語られる物語のようでした！\n\n私のOC、フィクティオ・ソフィアのために曲をリクエストしたいです。\n彼らは論理、数学、推理の天才で、賢者集団であるアカデミーに所属しています。\n彼らは幽玄で神秘的なオーラを持っています。\n\n私はこの曲で、研究と発見に集中した彼らの人生の数年間を物語り、謎が解き明かされ、すべてが彼女の頭の中でつながった瞬間に至る物語を作りたいと思う。新たな明るくエキサイティングな未来に向かう「ユーレカ！」の瞬間！(このシーンについては、mt_tsuruta氏によるアートが私のスケブにあります！)\n\n本当にありがとうございました！\n私は音楽の専門的な知識がないので、あなたの創造性を全面的に信頼しています。\n\nあなたの創作したもの、特に最新のスケブ作品が大好きです!\n本当にありがとう\n\nhttps://drive.google.com/drive/folders/1-XRy6wdXuZ8n5sirI4617S4H2Y_E4TR8?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@e11laa/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": true, "creator_id": 3542182, "client_id": 3460777, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2020168078521475072%2FLJQ7cGek.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0852c329ae8a6de329b9ab33688ca6e7", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_imag