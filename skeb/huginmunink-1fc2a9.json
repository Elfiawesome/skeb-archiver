://si.imgix.net/80c2c20a/uploads/origins/69059c87-5e65-4414-8475-a8d1e0d22cb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=838387486f3f78f7cecb96afb0ca4d04 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80c2c20a/uploads/origins/69059c87-5e65-4414-8475-a8d1e0d22cb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48c317ec07255bc3c0da45e062c036fc", "srcset": "https://si.imgix.net/80c2c20a/uploads/origins/69059c87-5e65-4414-8475-a8d1e0d22cb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48c317ec07255bc3c0da45e062c036fc, https://si.imgix.net/80c2c20a/uploads/origins/69059c87-5e65-4414-8475-a8d1e0d22cb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=58116d1bd8bb800cbdefdb15088a3fa8 2x, https://si.imgix.net/80c2c20a/uploads/origins/69059c87-5e65-4414-8475-a8d1e0d22cb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=681bc46a570db0cb7b11d220cb5d4449 3x"}, "body": "初めてご依頼させていただきます。\n『スイートプリキュア』よりキュアリズム（奏）をお願いします。\n\n瞳の形についてはアニメの作画よりプリキュアカードのイメージでお願いします。\nhttps://img07.shop-pro.jp/PA01455/769/product/189576583.jpg\n\nシチュエーションは以前のまゆちゃんのような処女喪失セックスとなります。\nhttps://www.pixiv.net/artworks/129899313\n・服装は変身後で、なるべく着衣のまま、おっぱいとパンツを見せてください。\n・正常位で、レイプではなくチャラ男の口車に乗せられるイメージです。（王子先輩ではない）\n・可能であれば中出しの差分までお願いします。\n\n以上、ご検討のほどよろしくお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@huginmunink/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3139322, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6142be8c/uploads/origins/f2385bb3-c521-41b9-96d3-2484ad99b2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb009b68cbbe2993d35331bfe2530ea3", "srcset": "https://si.imgix.net/6142be8c/uploads/origins/f2385bb3-c521-41b9-96d3-2484ad99b2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb009b68cbbe2993d35331bfe2530ea3, https://si.imgix.net/6142be8c/uploads/origins/f2385bb3-c521-41b9-96d3-2484ad99b2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c106c1a17e3325d3d2bf5677021c4b1 2x, https://si.imgix.net/6142be8c/uploads/origins/f2385bb3-c521-41b9-96d3-2484ad99b2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad80aacb71bc07b3436c6382ba5ec730 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6142be8c/uploads/origins/f2385bb3-c521-41b9-96d3-2484ad99b2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aab5b528c1039b3a66e017dd3ed3c84e", "srcset": "https://si.imgix.net/6142be8c/uploads/origins/f2385bb3-c521-41b9-96d3-2484ad99b2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aab5b528c1039b3a66e017dd3ed3c84e, https://si.imgix.net/6142be8c/uploads/origins/f2385bb3-c521-41b9-96d3-2484ad99b2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=328c1cf933c344aa0e4c875e51354c52 2x, https://si.imgix.net/6142be8c/uploads/origins/f2385bb3-c521-41b9-96d3-2484ad99b2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6129c8e069fca1e73827db39a5a2ff5f 3x"}, "body": "waka様。pixivのメッセージでの質問にはお世話になりました。ありがとうございます。\npixivユーザー名ワキことあずき餅です。\n\nこの度、リクエストをお願い致します。\n甘神さんちの縁結びの甘神夕奈ちゃんの\nエッチな画を差分で6ページお願い致します。\n甘神夕奈ちゃんは血の繋がりのない三姉妹の次女で、三姉妹ともに甘神神社という神社に身を寄せています。\n今回、依頼させて頂く内容は、\n甘神神社の協賛継続の為に協賛者のお金持ちのおじさんを接待することになり、着物姿でお酌していたらおじさんが酔っ払って甘神夕奈ちゃんを押し倒して、処女喪失中出しレイプしてしまう。\nという内容でお願いします。\n\n以下は、各ページのお願いしたい内容です。\n①1ページ目の時点で、おっぱい、膣が露わになっていて、膣がアップになりおじさんが「おぼこか」と言われている。\n②2ページ目でおじさんの男根が甘神夕奈ちゃんの膣に擦り当てられて甘神夕奈ちゃんが「やめて」と拒んでいる。\n③3ページ目は挿入、破瓜出血で甘神夕奈ちゃんが処女喪失する。\n④4ページ目はピストンで、おじさんが「膣内射精する」と言い、甘神夕奈ちゃんが「やめて、赤ちゃん出来ちゃう」と拒んでいる。\n⑤5ページ目で、中出しされる。\n⑥6ページ目で、男根が抜かれて、甘神夕奈ちゃんの膣部から破瓜の血と精液が垂れ流し。\n以上のシナリオでお願いします。\n以下は、構図等、お願いしたい細かなことです。\n・体位や画角は正常位を真上から見える構図でお願いします。\n・着物による着衣エッチを希望の為、着物の帯を解かずに締めたままでお願いします。またおじさんの腕や甘神夕奈ちゃんの足などが着物の上にかからないようにお願いします。\n（帯は見えるほどにお願いします。）\n・甘神夕奈ちゃんの表情は泣いていて、顔、左右両方のおっぱい、膣部が（コマ割せずに）一枚絵として描かれているようにお願いします。\n・竿役のおじさんがおっぱいを揉んで、おっぱいが見えなくなるのは避けて頂きたいです。\n・おっぱいの大きさですが、資料の画像を参照して頂けたらと思います。\n・髪型、着物の柄は指定致しません\n\nhttps://drive.google.com/drive/folders/1Q9I-zAtWNxPeDNSRfIl0qt0D84c4fcy5\n\n以上、何卒よろしくお願い致します。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@huginmunink/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3139322, "client_id": 2615152, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83ad39dc/uploads/origins/f4b45849-64e7-4b17-a9ba-25f1b1a1b261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5338b7d83f201ce2bfbf2b6b0c6b9905", "srcset": "https://si.imgix.net/83ad39dc/uploads/origins/f4b45849-64e7-4b17-a9ba-25f1b1a1b261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5338b7d83f201ce2bfbf2b6b0c6b9905, https://si.imgix.net/83ad39dc/uploads/origins/f4b45849-64e7-4b17-a9ba-25f1b1a1b261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d565b20233d058505e6f5f596ae1dda 2x, https://si.imgix.net/83ad39dc/uploads/origins/f4b45849-64e7-4b17-a9ba-25f1b1a1b261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0266432fd545904164926ee51eb083e3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83ad39dc/uploads/origins/f4b45849-64e7-4b17-a9ba-25f1b1a1b261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d09ae7f7984564e201e8e5c64d242e2a", "srcset": "https://si.imgix.net/83ad39dc/uploads/origins/f4b45849-64e7-4b17-a9