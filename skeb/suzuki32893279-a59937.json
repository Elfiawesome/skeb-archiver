7-899d-dafc2f664ba7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3af2ce29d3cf96c2badeb134585790e8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28db0144/uploads/origins/4a7c9867-2ed2-43a7-899d-dafc2f664ba7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21ad2bf258bd5fa7978bfd5dbada5130", "srcset": "https://si.imgix.net/28db0144/uploads/origins/4a7c9867-2ed2-43a7-899d-dafc2f664ba7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21ad2bf258bd5fa7978bfd5dbada5130, https://si.imgix.net/28db0144/uploads/origins/4a7c9867-2ed2-43a7-899d-dafc2f664ba7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1857152f04b936c2d1973d49bcd561ab 2x, https://si.imgix.net/28db0144/uploads/origins/4a7c9867-2ed2-43a7-899d-dafc2f664ba7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b06f44d7ad6fd47ef4ef7257feb0c40d 3x"}, "body": "こんにちは、『suzuki』様。\n今までは『pixiv』でずっとやり取りしていましたが、今回初めてこの『Skeb』にて『request』を致しますので、宜しくお願い致します。\nまず自分がリクするものは、『鉄拳シリーズ』の『リリ』とかつて90年代に『SEGA』が制作した3Dスポーツゲーム『DecAthlete』のプレイヤーキャラ『リーファン(https://www.giantbomb.com/a/uploads/scale_medium/3/34651/2715130-li.jpg)』で、その二人が姉妹の様に仲良く揃っているという百合絵です。ずっと昔から『鉄拳シリーズ』をやり続けておりますが、中には『5DR』に思い入れがありそのOPムービー(https://www.youtube.com/watch?v=82uRNGeE_tk&t=40s)で初めて『リリ』を見た瞬間思わず一目惚れしそれ以来彼女の『虜』となっております(*つω｀*)♪\n勿論『6』のその『飛鳥』との対決シーン(https://www.youtube.com/watch?v=rWRTa-OB4C8&list=LL&index=400&t=125s)もかなり好きで、それを何回か繰り返して見ております♪次に『リーファン』は僕が子供の頃『セガサターン』でやっていた時たまたまCM等でそれを見て知り、彼女のあの青色の『ハイレグレオタード(https://pbs.twimg.com/media/EIY5yHpXsAQFDOA.jpg)』に思わず見惚れてしまい、よく『夏季オリンピック』や『世界陸上』の時期に毎回自ら描いておりますぅ～(*＞3＜)♪\nどちらも僕にとって今でも思い入れがありゲーム内で『理想』のタイプのキャラで、こうも『崇拝』かつ『熱愛』しておりこういう異色のタッグとして選びました!!\n無論二人の身長差も考えており、『リリ』は174cmで『リーファン』は167cmでお願い致します。ちなみに『リリ』の衣装を従来のメインコス(5DR~7)である『純白のミニスカドレス(https://i.pinimg.com/736x/39/5e/a1/395ea11d45816362fff58e171ccea698.jpg)』にして下さい。\nまたイラストの中央に表示する『SAMPLE』という文字を無くして頂ければ幸いです。\n\nhttps://www.youtube.com/watch?v=KKL-95slgSA&list=PL4fQOU_76pcP599Y091Ziv_lNcyc4RJgU&index=4&t=480s", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suzuki32893279/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 445488, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a59a0f9/uploads/origins/aa5775e4-73b7-4051-8f5f-b99b45dfdc64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e99a3c3a245ae9ef4b2d3224bb7bdf3", "srcset": "https://si.imgix.net/0a59a0f9/uploads/origins/aa5775e4-73b7-4051-8f5f-b99b45dfdc64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e99a3c3a245ae9ef4b2d3224bb7bdf3, https://si.imgix.net/0a59a0f9/uploads/origins/aa5775e4-73b7-4051-8f5f-b99b45dfdc64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddd9911046d8cebe30d848e59d4a0dd6 2x, https://si.imgix.net/0a59a0f9/uploads/origins/aa5775e4-73b7-4051-8f5f-b99b45dfdc64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=892325ac155166728a0eaf73a998c209 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a59a0f9/uploads/origins/aa5775e4-73b7-4051-8f5f-b99b45dfdc64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a63bf60037f4841776ed6aa0320a7d7", "srcset": "https://si.imgix.net/0a59a0f9/uploads/origins/aa5775e4-73b7-4051-8f5f-b99b45dfdc64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a63bf60037f4841776ed6aa0320a7d7, https://si.imgix.net/0a59a0f9/uploads/origins/aa5775e4-73b7-4051-8f5f-b99b45dfdc64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cdda6ff37898d0adfd2508f702d84dab 2x, https://si.imgix.net/0a59a0f9/up