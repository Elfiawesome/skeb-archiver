の宣伝やYouTubeでの配信内での紹介、ASMR配信等のサムネイルに使用することに限定してお許しください。主に脚フェチ向けASMRでのサムネイル使用を想定しています。\n\n何卒ご検討のほどよろしくお願いします。\n\n参考URL\nYouTube　→　https://www.youtube.com/channel/UCjQEaq8rhcK6-gc9lg6OA7Q\nTwitter　→　https://twitter.com/V_chisseneko\n髪型　→　https://twitter.com/V_chisseneko/status/1581933444556210176", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NamikiShiho/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2404704, "client_id": 2337340, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95edc47f/uploads/origins/eeaeff3a-c3ea-467d-bdc6-8c41077969a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7e6084c981e0fab7cb4ba4196d4bad0", "srcset": "https://si.imgix.net/95edc47f/uploads/origins/eeaeff3a-c3ea-467d-bdc6-8c41077969a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7e6084c981e0fab7cb4ba4196d4bad0, https://si.imgix.net/95edc47f/uploads/origins/eeaeff3a-c3ea-467d-bdc6-8c41077969a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb5f30a4c2bf0afdba80bb2e7b52ab1c 2x, https://si.imgix.net/95edc47f/uploads/origins/eeaeff3a-c3ea-467d-bdc6-8c41077969a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8627aaa1fb442e7146e6e1a65014c040 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95edc47f/uploads/origins/eeaeff3a-c3ea-467d-bdc6-8c41077969a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e535f79f63f6228d7f75076604fbd023", "srcset": "https://si.imgix.net/95edc47f/uploads/origins/eeaeff3a-c3ea-467d-bdc6-8c41077969a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e535f79f63f6228d7f75076604fbd023, https://si.imgix.net/95edc47f/uploads/origins/eeaeff3a-c3ea-467d-bdc6-8c41077969a8?bg=%23fff&auto=