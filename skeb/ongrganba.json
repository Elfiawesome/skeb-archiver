core": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33c562d7/uploads/origins/b629710f-91a7-4a3a-ba6c-6c40323ecd3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77d32e01ddb587b4e691d0b26cff8de5", "src_set": ""}, "body": "はじめまして、新着でお見かけして素敵な絵を描いていらしたのでリクエストいたしました。\nポケモンBW2のカミツレを描いていただけないでしょうか。\nジムリーダー兼ファッションモデルなので\nおにぎりさんの想像でいいのでセクシーでかっこいいポーズでお願いします。\n黄色いモコモコは作画コストが高そうなので省いてもらっていいです。\nネイルと美脚にこだわっていただけると嬉しいです。\nご検討よろしくお願いいたします。\nhttps://www.pokemon.co.jp/ex/b2w2/characters/character09.html\nhttps://www.kotobukiya.co.jp/product/detail/p4521329292328/", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ongrganba/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3632958, "client_id": 1431040, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e4a2429/uploads/origins/4b046376-93db-4352-9894-485dd4f8bd21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2ead3cb93a6ebb22fcc3bebfe6bf86c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e4a2429/uploads/origins/4b046376-93db-4352-9894-485dd4f8bd21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87bd3afbae6ae551d4a5821444c2d0f3", "src_set": ""}, "body": "こんにちは。劇場版忍たま乱太郎ドクタケ忍者隊最強の軍師の劇中に登場した『ドクタケ忍者隊巻ノ一』内の鬼娘ユキちゃんとトモミちゃん(指は５本で)をお願いしたいのですが宜しいでしょうか?\nhttps://drive.google.com/drive/folders/1O9o5Ez3WjleDhATwvvncX0RHXua4KDAk\n\nhttps://drive.google.com/drive/folders/1MW1EocZNqnu1RN6LQI1-JbEMrB66uC8Q", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ongrganba/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3632958, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "http