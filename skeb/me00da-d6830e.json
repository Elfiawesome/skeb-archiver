s://www.youtube.com/watch?v=AI29dHDkJh4&list=RDAI29dHDkJh4&start_radio=1）で、失望させる男性や恋愛を諦め、代わりに雲の中に浮かんでドラマと向き合わずに済むようにする歌です。 歌手は「どんな男も私の内なるドリーマーを殺せない」と歌い、これからも夢を追い続けると宣言しています。私の推しキャラ、ホジをまた描いてほしいです！夢のような雰囲気で、幸せそうな表情で雲の上を漂う姿をお願いします。クリエイティブな判断は信頼しています。服装も、彼とわかる範囲で自由に変更しても構いません！ありがとうー\n\nキャラクター参考：https://drive.google.com/file/d/1flloNzy37t9Uv_qVfBORgIT5i-yoH9pp/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@me00da/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2510897, "client_id": 3864933, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11628047/uploads/origins/e7fe9aca-581a-4cd6-a1fc-ff5253f4f0eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be1795e0aebcabbd1b7e861687812a2b", "srcset": "https://si.imgix.net/11628047/uploads/origins/e7fe9aca-581a-4cd6-a1fc-ff5253f4f0eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be1795e0aebcabbd1b7e861687812a2b, https://si.imgix.net/11628047/uploads/origins/e7fe9aca-581a-4cd6-a1fc-ff5253f4f0eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80acc45a379092d1c46ec6e412ff3d87 2x, https://si.imgix.net/11628047/uploads/origins/e7fe9aca-581a-4cd6-a1fc-ff5253f4f0eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0316451a6f764c1d23d279ba451e8e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11628047/uploads/origins/e7fe9aca-581a-4cd6-a1fc-ff5253f4f0eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e679b826ab4504736cb6ed120458a71a", "srcset": "https://si.imgix.net/11628047/uploads/origins/e7fe9aca-581a-4cd6-a1fc-ff5253f4f0eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e679b826ab4504736cb6ed120458a71a, https://si.imgix.net/116