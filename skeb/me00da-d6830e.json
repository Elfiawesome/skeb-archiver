f&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=e1dfe52f16bd86f0fc0f6518ceb5ed50, https://si.imgix.net/333d76d7/uploads/outputs/10c47a3a-4f8c-48b6-9d3a-c667a68646e0?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=069912b7d2732231748074b8b89ecb69 2x, https://si.imgix.net/333d76d7/uploads/outputs/10c47a3a-4f8c-48b6-9d3a-c667a68646e0?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e148a3a72589be52c8d3d3f7d0b59b83 3x"}, "body": "目田さん、はじめまして！\n\n個人でvtuber活動をしております、レインと申します！\nレインの短いループアニメーションを作成していただけますか？彼女は鳥で、政府の錬金術部門のマネージャーです。賢くてかわいい。緑、アイスコーヒー、モバゲーが大好き！レインはオウム（ラブバード）です。\nレインは大人びた威圧的なOLですが、実は超オタクです。\n\n[用途]\nライブ配信時の「読み込み中」／「すぐに戻ります」アニメーション\n\nご検討よろしくお願いします。(*^▽^*)\n\nhttps://drive.google.com/drive/folders/1s-OsFFlL-BqzheUuoiP4zTVDfjuKGj7Y?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@me00da/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2510897, "client_id": 3370234, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4601c72/uploads/origins/7f7cf564-39b6-4736-9977-6bb2f0087f89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03538cfd4f79b905e3d1a12a21986059", "srcset": "https://si.imgix.net/f4601c72/uploads/origins/7f7cf564-39b6-4736-9977-6bb2f0087f89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03538cfd4f79b905e3d1a12a21986059, https://si.imgix.net/f4601c72/uploads/origins/7f7cf564-39b6-4736-9977-6bb2f0087f89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e10a11dcf2dd76079e335a65becd79ef 2x, https://si.imgix.net/f4601c72/uploads/origins/7f7cf564-39b6-4736-9977-6bb2f0087f89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c4cd7cb28c0949352d559a7df4269b8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4601c72/uploads/origins/7f7cf564-39b6-4736-9977-6bb2f0087f89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e230cdf39a3c3a409aa217356025514", "srcset": "https://si.imgix.net/f4601c72/uploads/origins/7f7cf564-39b6-4736-9977-6bb2f0087f89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e230cdf39a3c3a409aa217356025514, https://si.imgix.net/f4601c72/uploads/origins/7f7cf564-39b6-4736-9977-6bb2f0087f89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d48a30540f4b12d4601cb02556243011 2x, https://si.imgix.net/f4601c72/uploads/origins/7f7cf564-39b6-4736-9977-6bb2f0087f89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=79d8c124c504297ad23dd4b9e3a28933 3x"}, "body": "目田さん初めまして！\nとっても素敵な納品イラストを目にし、淡いタッチと柔らかい雰囲気の絵柄が好みでしたので是非自分のOCを描いて頂きたいなと思いこの度リクエストをしに来ました！\nもし金額が見合わないようでしたら再送信のほうお気軽にお願い致します！🙇🏻‍♂️\n\n 以下詳細です！  \n\n◇💎◇ \n名前：御鏡・T・シグマ(みかがみ しぐま)\n男/23歳/180cm \n性格・設定：ドイツにて古物研究家を営んでいる。\nかなりと言っていいほど自由奔放な性格。周りを振り回しやすく悩み事が無さそうとよく言われる。好奇心の赴くままに行動しがちだが、頭脳がよくキレる上運も良いため彼の向かった先には必ず何かが起こりがち。好きなものは面白いもの、こと。嫌いなものは面白くないもの、こと。\nミドルネームのＴはテオフィロス。ギリシア語で『神に愛されし者』という意味を持つ。\n\n見た目：ふんわりとしたブロンド髪に左目が青、右目が緑色。左目は少し特殊。裸足。\n\n見た目については添付した画像を参照して頂けたら幸いです！\n分かりにくい箇所などは描きやすいようにアレンジして頂いて構いません\n\nイラストの構図や雰囲気は、目田さんの思う解釈で描いて頂けましたら幸いです🙇🏻‍♂️  \n\nお忙しい中かとは思われますが、何卒よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1Mj5a36f6NdERRtHf87D-Au3GvGl9iPqc", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@me00da/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2510897, "client_id": 2793950, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d39f7bd/uploads/origins/76523ce8-d676-4c3f-a02a-b3799ac86644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f5b6f09acc1142cef36c658