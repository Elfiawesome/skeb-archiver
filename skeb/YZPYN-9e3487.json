おまかせ　それか、\nhttps://www.pixiv.net/artworks/96806408\nが上半身の筋肉美が見えて好きです。\n筋肉盛ってください！。\n\n・毛は首から下は無しでお願いします。\n・おでこの装備以外は無しが良いです(エロさと筋肉の肉体美を優先でお願いします)\n・裸体で褌(褌色は黒でお願いします/触手が褌の布を破るか、褌の脇からボロんのどちらがが良いです)\n\n「何よりYZPYNさんの描いたマッチョなザンダルフをお願いします！」\n\nhttps://pbs.twimg.com/media/ETearGuVAAAwRtS?format=jpg&name=orig", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YZPYN/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 51861, "client_id": 1426064, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c2071da/uploads/origins/734b5328-7382-48af-b32e-66499ddf055e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c65433f3d727ee3bb7b1badf4ef8747", "srcset": "https://si.imgix.net/5c2071da/uploads/origins/734b5328-7382-48af-b32e-66499ddf055e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c65433f3d727ee3bb7b1badf4ef8747, https://si.imgix.net/5c2071da/uploads/origins/734b5328-7382-48af-b32e-66499ddf055e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1eea8d1b676e730a89aa729469008c1a 2x, https://si.imgix.net/5c2071da/uploads/origins/734b5328-7382-48af-b32e-66499ddf055e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bec36faaa1f56bdd111a65f43931e1d0 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c2071da/uploads/origins/734b5328-7382-48af-b32e-66499ddf055e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cd8f28b74ffa58d6bc3123b97a40079", "srcset": "https://si.imgix.net/5c2071da/uploads/origins/734b5328-7382-48af-b32e-66499ddf055e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cd8f28b74ffa58d6bc3123b97a40079, https://si.imgix.net/5c2071da/uploads/origins/734b5328-7382-48af-b32e-66499ddf055e?bg=%23fff&auto=form