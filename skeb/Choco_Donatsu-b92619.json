79e5e45-a532-4d54-8b38-7889e8a6b53a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=444a118bc9c73d476d483582f1ab7828, https://si.imgix.net/9172ea7f/uploads/origins/379e5e45-a532-4d54-8b38-7889e8a6b53a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff00fd405da15ea72377b4d21ace780b 2x, https://si.imgix.net/9172ea7f/uploads/origins/379e5e45-a532-4d54-8b38-7889e8a6b53a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20a4bc0d1b67207af58ff737b7c8ce58 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9172ea7f/uploads/origins/379e5e45-a532-4d54-8b38-7889e8a6b53a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5467005a94a56ba3ce6144e51475390e", "srcset": "https://si.imgix.net/9172ea7f/uploads/origins/379e5e45-a532-4d54-8b38-7889e8a6b53a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5467005a94a56ba3ce6144e51475390e, https://si.imgix.net/9172ea7f/uploads/origins/379e5e45-a532-4d54-8b38-7889e8a6b53a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4dcf2f616ac45d1de03a25daa4da1fd3 2x, https://si.imgix.net/9172ea7f/uploads/origins/379e5e45-a532-4d54-8b38-7889e8a6b53a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9070a47179382f85929bf5ef7a01199b 3x"}, "body": "最近、TwitterやSkebで見かけたあなたの素晴らしい作品に感動しました！私は現在制作中の未リリースのゲームのキャラクターの描画を依頼したいと思っています。\n\n「ラナ」はうぬぼれたようなで生意気かつ大胆なな火のドラゴン娘です。彼女はプレティーン体型をしており、その特徴的な笑顔とドヤ顔が彼女の個性を際立たせています。(ぺったん)\n\nアクセサリーやパターンには正確さを保ってください。彼女の服の色は髪よりも少し暗く、目は少し光沢があり、燃えるような色をしている。また、彼女の目と爪がドラゴンのように少し鋭いことに注意してください。ポニーテールは頭の横（少し後ろ）にあります。彼女の特徴は八重歯（かわいい牙）です。\n\n背景を含めてください。作品の構成は自由にお願いします！顔とポニーテールの根元が見えるようにしたいです。ポーズに関しては、彼女の個性をよく表現していただければ幸いです。\n\n参考画像 \"参考[ラナ].png\"をご利用ください。\n\n※その作品をYouTubeやソーシャルメディア、私のウェブサイト、そして私のデジタル/物理的なアートブックの委託セクション（私自身や他のアーティストの作品と一緒に）など、さまざまな目的で使用するかもしれません。\n\n※作品の .PSD ファイルを添付し、キャラクターを別レイヤーにしていただけると助かります。\n\nhttps://drive.google.com/drive/folders/1__QYx1daG5FdqzmvUWqNj6i_rSyDQ3sz?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Choco_Donatsu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1521597, "client_id": 851537, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7879afd/uploads/origins/905dce82-0c34-4434-9b98-7fd6865aae0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7005d226a664b84a03f884aa082b4aec", "srcset": "https://si.imgix.net/b7879afd/uploads/origins/905dce82-0c34-4434-9b98-7fd6865aae0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7005d226a664b84a03f884aa082b4aec, https://si.imgix.net/b7879afd/uploads/origins/905dce82-0c34-4434-9b98-7fd6865aae0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=364f96f5e93f2d9192b0ff4b48f38e6c 2x, https://si.imgix.net/b7879afd/uploads/origins/905dce82-0c34-4434-9b98-7fd6865aae0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30886f1e1da336d9396746e38c28a43d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7879afd/uploads/origins/905dce82-0c34-4434-9b98-7fd6865aae0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37e6b8966cd1c168a7aa3d5530d492e7", "srcset": "https://si.imgix.net/b7879afd/uploads/origins/905dce82-0c34-4434-9b98-7fd6865aae0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37e6b8966cd1c168a7aa3d5530d492e7, https://si.imgix.net/b7879afd/uploads/origins/905dce82-0c34-4434-9b98-7fd6865aae0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=679c34ab550099f2b66df6fcd2c05cff 2x, https://si.imgix.net/b7879af