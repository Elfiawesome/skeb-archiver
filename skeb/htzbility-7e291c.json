ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ae8be2624f140998ab2f9914adc69b5, https://si.imgix.net/5b127d11/uploads/origins/381072a2-787c-4676-83d9-f08e5526fdea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69ef794148126c215ce298c039a3d766 2x, https://si.imgix.net/5b127d11/uploads/origins/381072a2-787c-4676-83d9-f08e5526fdea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=027f6b0a1c8d5ef233eb5a4d444724a2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b127d11/uploads/origins/381072a2-787c-4676-83d9-f08e5526fdea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4bfb0ae0e967159d5d0516adb654efc", "srcset": "https://si.imgix.net/5b127d11/uploads/origins/381072a2-787c-4676-83d9-f08e5526fdea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4bfb0ae0e967159d5d0516adb654efc, https://si.imgix.net/5b127d11/uploads/origins/381072a2-787c-4676-83d9-f08e5526fdea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f05866360b570f40f0f088646bef49f7 2x, https://si.imgix.net/5b127d11/uploads/origins/381072a2-787c-4676-83d9-f08e5526fdea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56c6638cbd43f2f66f94e96c649471d1 3x"}, "body": "はじめまして。ミスキーでイラストをお見かけし、可愛くてえっちな作風に一目惚れしましたのでリクエストさせて頂きます。\n\nもしオリジナルのインピオものが可能でしたら、第二次性徴がきてまもない年頃の男の子と女の子同士で興味本位からえっちし、赤ちゃんができちゃうイラストをお願いします。\n\n1.女の子が脚を開きあそこがよく見えるように自分の両指でくぱぁ(可能なら膜あり)\n↓\n2.男の子が興奮して大きくなったあそこを女の子に当てがう→挿入\n↓\n3.抽挿のち種付けプレスの体位で女の子の最奥に突き入れきんたまをビクビクさせながら射精。射精中の断面図などのカットインもあれば嬉しいです。\n↓\n4.男の子が抜いた後、2と同じ構図で再度脚を開き両指でくぱぁ。膜が破れたあそこから中出しされた濃厚な精液が卑猥な音を立てて溢れ、シーツに女の子の初めての証と混ざって紅白またはほんのりピンク色に染まった精液溜まりができる。お腹の辺りに受精のカットイン\n↓\n5.大きくなったお腹の女の子イラスト(裸)\n\n参考URLは以前私が他の作家様にリクエストしたシチュになりますが、これを羊ビリティさんの絵と作風で拝見したいと言うのが今回の趣旨になります。\n(キャラの雰囲気や構図などはお任せします)\n\nなお金額的に厳しければ3,4のみ、または4のみでも可能です。\n(もしそのイラストを見て続きが気になったら追加でリクエストします)\n\nご検討宜しくお願い致します。\n\nhttps://www.pixiv.net/artworks/130487188", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@htzbility/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2490e12b/uploads/origins/5c83ee27-ba18-4edf-94ab-1fa92a02ce8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3fa3b3c9f9373712ce84a53d574d324", "srcset": "https://si.imgix.net/2490e12b/uploads/origins/5c83ee27-ba18-4edf-94ab-1fa92a02ce8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3fa3b3c9f9373712ce84a53d574d324, https://si.imgix.net/2490e12b/uploads/origins/5c83ee27-ba18-4edf-94ab-1fa92a02ce8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad7c023c564aa8c06bd6b0358b1a5a93 2x, https://si.imgix.net/2490e12b/uploads/origins/5c83ee27-ba18-4edf-94ab-1fa92a02ce8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=612254fefbef91bef0034c139f0a8fef 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3706955, "nc": 161}, {"path": "/@htzbility/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3706955, "client_id": 1632499, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e9cf4a3/uploads/origins/e6547485-241e-4e55-b497-7cbf21c26030?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35be6fbc37f77641c5ed626d570de52c", "srcset": "https://si.imgix.net/4e9cf4a3/uploads/origins/e6547485-241e