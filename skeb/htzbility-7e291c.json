rop=top&w=200&h=200&blur=200&s=7e8296e39cf005ae2b233f0acd18a6a5 3x"}, "body": "こんにちは！\n私のOCが幼児状態でオナニーしている絵を描いてほしい。\n\n具体的な内容はお任せします。ただ、全裸に比べたら、最低限のものは着せてあげてください。参考資料から選んでもいいし、適当にセクシーな服をピックアップしてもいい。\n\n参考文献\n\nhttps://drive.google.com/drive/folders/17VMeiTt2akINIkhZn7ATTjbFJ6WkLsWh?usp=sharing", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@htzbility/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3706955, "client_id": 72782, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3c9efe7/uploads/origins/aa65e37a-92cd-4f16-9dc2-fc4e293aa961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc34e50a5639c1afc670dd3ba7eb1f8d", "srcset": "https://si.imgix.net/f3c9efe7/uploads/origins/aa65e37a-92cd-4f16-9dc2-fc4e293aa961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc34e50a5639c1afc670dd3ba7eb1f8d, https://si.imgix.net/f3c9efe7/uploads/origins/aa65e37a-92cd-4f16-9dc2-fc4e293aa961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb08d479f817de89d4760ef8865aaa60 2x, https://si.imgix.net/f3c9efe7/uploads/origins/aa65e37a-92cd-4f16-9dc2-fc4e293aa961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e9431fe42cf196c6f563fae40f50434 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3c9efe7/uploads/origins/aa65e37a-92cd-4f16-9dc2-fc4e293aa961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cddc7ac5a106808c91fd25b65f4b437", "srcset": "https://si.imgix.net/f3c9efe7/uploads/origins/aa65e37a-92cd-4f16-9dc2-fc4e293aa961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cddc7ac5a106808c91fd25b65f4b437, https://si.imgix.net/f3c9efe7/uploads/origins/aa65e37a-92cd-4f16-9dc2-fc4e293aa961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9b72c5404c55905bdd95948c22933a2c 2x, https://si.imgix.net/f3c9efe7/uploads/origins/aa65e37a-92cd-4f16-9dc2-fc4e293aa961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5b9bf48800817c55b03bfca2b4eb3305 3x"}, "body": "はじめまして、羊ビリティさま。先生の描くイカ腹に惹かれリクエストを出しました。\nおそらく先生がご存じないキャラクターだとは思いますが大丈夫でしょうか？\nご一考いただけると嬉しいです。\n【登場キャラ】\n容姿は下記URLをご参照ください。\nクルクマ・クルクマのぬいぐるみ\nhttps://pastelcrayon.net/data/0302.html\n【内容】\n幼児化したクルクマのイラストをお願いしたいです。\n詳細は下記の要件をご参照ください。\n\n・クルクマの身長は推定130(9yo)程度あるため90~100(3~4yo)の身長・体型で描いてほしいです。\n・元絵にあるクルクマのぬいぐるみを持っている描写があること。デザインはクルクマ同様【登場キャラ】リンクをご参照ください。\n・服装は全裸でおねがいします。\n\n【構図要件】\n先生の投稿絵によく見られる(下記リンクなど) 身長測定とえっちをそれぞれ描く2枚絵構図でお願いしたいです。\nhttps://www.pixiv.net/artworks/134109090\n\n①身長測定\n・クルクマがぬいぐるみを抱きかかえていて人見知りしている表情・描写をお願いしたいです。\n　（はじめての人に会うこわさをぬいぐるみを抱くことでごまかしているイメージ）\n②えっち\n・体位は正常位　状況はセックスしている最中または事後\n・表情は気持ちよくなっているが戸惑いを感じている表情\n・ぬいぐるみを抱きしめている描写（性知識がなく性感という未知の感覚にまだ理解が追い付かずそのこわさをぬいぐるみをだきしめることでごまかしているイメージ）\n\nその他不明点などあれば先生のご裁量におまかせいたします。\nご検討宜しくお願い致します。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1303, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "武侍", "screen_name": "takezamurai", "avatar_url": "https://pbs.twimg.com/profile_images/1965119675362410503/gEaHuwKK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/68666440/1551150026/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 161}, {"id": 35750, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "けだま", "screen_name": "mofu_mofu_ugaa", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fmisskey%2F2a03