crop&crop=top&w=200&h=200&blur=200&s=ae92cdd1b18f1f99bcea0b47762a01cb", "src_set": ""}, "body": "ちびキャラサンプルかわいかったので、ククリくんバージョンも見たいです！\n詳細はおまかせします。大丈夫でしたらよろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuisd02/works/76", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2421082, "client_id": 2999721, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7eca2e72/uploads/origins/7ce5e6d8-40ae-4b93-b02c-4b3654a325b5?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=cbd47a63b371d1789b150a735c515288", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7eca2e72/uploads/origins/7ce5e6d8-40ae-4b93-b02c-4b3654a325b5?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=23c0d17df85753aa4b979eea48603553", "src_set": ""}, "body": "またまた\n\n僕の新しい悪魔の姿をモチーフにしたチビが欲しいんだ。\n\n僕のストリーム、スケジュール、ソーシャルメディア、...で使いたいんだ。\n 表情やポーズはお任せしてもいいですか？ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1WKglVToHqZyQ3nk2Rwwr4EvGXzx1y89h?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuisd02/works/75", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2421082, "client_id": 1941823, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61d9f3cb/uploads/origins/5e59cd14-ca64-4ccc-9fd8-035708be53c4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=dff02ee1b004df996a30e700cd49bc4c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61d9f3cb/uploads/origins/5e59cd14-ca64-4ccc-9fd8-035708be53c4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=cc2acef00494add527efc4c6032a4b62", "src_set": ""}, "body": "あらためてこんにちは。