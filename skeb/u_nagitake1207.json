96c/uploads/origins/d5e2a0e3-86d8-461c-a0e4-12494e188b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31132ed0b8b51d3dc38fdf0d45fa516c, https://si.imgix.net/58acf96c/uploads/origins/d5e2a0e3-86d8-461c-a0e4-12494e188b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f15328c21bb10081643ff7ed4c7177b 2x, https://si.imgix.net/58acf96c/uploads/origins/d5e2a0e3-86d8-461c-a0e4-12494e188b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=00560c1c84759fabaf0a56073ac5ad77 3x"}, "body": "はじめまして！アピールありがとうございます。\nVTuberとして活動している雨丁てんと申します。 \n夕凪たけ様の(https://x.com/u_nagitake/status/1802300508532879657?s=46&t=HO82p6oCcQsRM5U7OuuWXA)の\nイラストを拝見し、暖かみのある色彩がとても素敵でぜひ描いていただきたくリクエストいたしました。  \n\n【使用用途】  \n歌ってみた動画、SNS、サムネイルの使用\nネットプリントなどで使用する可能性がございます。\n\n・16:9サイズ\n・背景とキャラクターを分けた透過データもいただけると助かります。 \n\n【参考資料】 \nhttps://drive.google.com/file/d/1iO-19q_clwr19HB72dy3O-dpjhZfg-Vo/view?usp=drivesdk \n\nhttps://x.com/uchou_10\n\n【キャラクター・補足】\n右目下涙ボクロあり\n犬歯(口を開ける場合)\nまろ眉\n\n【希望内容】\nhttps://youtu.be/ru6i9lo4zBE?si=ZVPyXfxYKFxfFqK4\n\nこちらの曲のイメージに合うようなイラストをお願いしたいです！\n\n個人的に宝石がモチーフとして入っていると嬉しいですが、夕凪たけ様のご自由に創作していただければ幸いです。\n\n全体の雰囲気、構図やポーズ、服装などもお任せしたいと思っております。\n\n以上となります。 \nぜひご検討いただけますと幸いです。 よろしくお願いいたします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_nagitake1207/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3281227, "client_id": 85581, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb310ed8/uploads/origins/522145a7-5e7e-41ac-8be9-b29707f7bdc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b3d45d4282e5b2a43c6aa53d8414f06", "srcset": "https://si.imgix.net/fb310ed8/uploads/origins/522145a7-5e7e-41ac-8be9-b29707f7bdc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b3d45d4282e5b2a43c6aa53d8414f06, https://si.imgix.net/fb310ed8/uploads/origins/522145a7-5e7e-41ac-8be9-b29707f7bdc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c731c46c064b72328fd162a2218bbff0 2x, https://si.imgix.net/fb310ed8/uploads/origins/522145a7-5e7e-41ac-8be9-b29707f7bdc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=578e7a11efcbd7e21c10bc730cc6467a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb310ed8/uploads/origins/522145a7-5e7e-41ac-8be9-b29707f7bdc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c222bbe5a91c36573e416e8bee65fe08", "srcset": "https://si.imgix.net/fb310ed8/uploads/origins/522145a7-5e7e-41ac-8be9-b29707f7bdc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c222bbe5a91c36573e416e8bee65fe08, https://si.imgix.net/fb310ed8/uploads/origins/522145a7-5e7e-41ac-8be9-b29707f7bdc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cafacb42a73d7b78a15975446790fa51 2x, https://si.imgix.net/fb310ed8/uploads/origins/522145a7-5e7e-41ac-8be9-b29707f7bdc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f6bfbfd5bf907d53f5169a069508e37f 3x"}, "body": "アピールありがとうございます！\n暖かみのある色使いがとても魅力的だったので、お年玉リクエストさせていただきました！\nご検討いただけますと幸いです。\n\n描いていただくキャラは、夕凪たけ様の描きたいキャラを描いていただいて構いません。\n「嶋香結月」単体で描いていただくも良いですし、「結月と星姫」で描いても良いですし、\n【銀雪の涙に金色の毒が滴る】のふたり、「白狼森宵乃」と「麦琥珀陽耀」でもOKです。\n他にもたくさんキャラいますので、気が向いたらサイト見ていただいて、他のキャラで描きたいキャラがいましたらそちらでも全然問題ありません。\n\nキャラさえ大切に描いていただければ、シチュも構図もお任せいたします。\n衣装などもこういう服着せたいなと思ったら服を仕立てていただいてもOKです！\nご検討宜しくお願い致します。\n\n\n◆銀双環の舞巫女：キャラ・世界観設定（概要）\nhttps://primitive-species.com/worldofyounggirls/\n\n◆銀雪の涙に金色の毒が滴る：キャラ・世界観設定（概要）\nhttps://primitive-species.com/silvergoldlotv/", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_nagitake1207/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3281227, "client_id": 3445956, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cda1eb99/uploads/origins/7b44739d-c6db-4d77-9b87-f538bd4ac0ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec53e845a4ae6da82c3c315a3dc1031e", "srcset": "https://si.imgix.net/cda1eb99/uploads/origins/7b44739d-c6db-4d77-9b87-f538bd4ac0ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec53e845a4ae6da82c3c315a3dc1031e, https://si.imgix.net/cda1eb99/uploads/origins/7b44739d-c6db-4d77-9b87-f538bd4ac0ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce58abe6f427bd8f084130426790c288 2x, https://si.imgix.net/cda1eb99/uploads/origins/7b44739d-c6db-4d77-9b87-f538bd4ac0ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d81ab047e899167eb5d12cf115f6bcf8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cda1eb99/uploads/origins/7b44739d-c6db-4d77-9b87-f538bd4ac0ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24046464b6a1d339875fe1f10f5f28ed", "srcset": "https://si.imgix.net/cda1eb99/uploads/origins/7b44739d-c6db-4d77-9b87-f538bd4ac0ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24046464b6a1d339875fe1f10f5f28ed, https://si.imgix.net/cda1eb99/uploads/origins/7b44739d-c6db-4d77-9b87-f538bd4ac0ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4d6a827ff84d61676c319cba85b6577b 2x, https://si.imgix.net/cda1eb99/uploads/origins/7b44739d-c6db-4d77-9b87-f538bd4ac0ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b50272bae8ef2939c84e150068a0c6b5 3x"}, "body": "アピールありがとうございます。\n作品拝見させていただきました！線や色使いがとっても素敵で、ぜひ、私のOCの紫苑フブキちゃんも描いて頂きたいと考えリクエストさせていただきました。\n紫苑フブキちゃんは儚げな少女で歳は14歳、身長は160cmです。\n眠ることが大好きで、紫苑の花と雪の結晶がモチーフになっております。\n\n\n構図、ポーズや、表情全ておまかせに致しますのでどうかお好きに書いていただきたいです。\nもちろん、夕凪たけ様の解釈で衣装に変更、アレンジを加えてくださっても構いません。\n\nどうぞ御検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1azhWdi6MrEBv2KntLmScWJ65mL2pSTBH", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_nagitake1207/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3281227, "client_id": 3236466, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/feebdec5/uploads/origins/f330b209-94d6-4619-87e7-e8b261266409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c597933adbdc88f2f4239b180d0ef7e8", "srcset": "https://si.imgix.net/feebdec5/uploads/origins/f330b209-94d6-4619-87e7-e8b261266409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c597933adbdc88f2f4239b180d0ef7e8, https://si.imgix.net/feebdec5/uploads/origins/f330b209-94d6-4619-87e7-e8b261266409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=857f02234ac107ba15b96f430925f48a 2x, https://si.imgix.net/feebdec5/uploads/origins/f330b209-94d6-4619-87e7-e8b261266409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d05c1bf35937e4de244576210f960363 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/feebdec5/uploads/origins/f330b209-94d6-4619-87e7-e8b261266409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b94b03f84dc677b0858eb061e08a2eb", "srcset": "https://si.imgix.net/feebdec5/uploads/origins/f330b209-94d6-4619-87e7-e8b261266409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b94b03f84dc677b0858eb061e08a2eb, https://si.imgix.net/feebdec5/uploads/origins/f330b209-94d6-4619-87e7-e8b261266409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=052e507dcbe7565403423c9770d6d102 2x, https://si.imgix.net/feebdec5/uploads/origins/f330b209-94d6-4619-87e7-e8b261266409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=de1a9cbdca20c1661ecd627c9956dce0 3x"}, "body": "先生の絵柄が本当に大好きで、ぜひ私のOCを描いていただけたら嬉しいです。\n楚忻薄（赤髪・攻め）\n忻薄は、貧しい家庭に生まれ、幼い頃から「権力」と「資源」の重要性を痛感してきました。そのため極限環境でも素早く適応し、生き延びるための知恵と優れた学習能力を身につけました。彼はまるでハンターのような鋭さを持ち、決断力があり、迅速かつ冷酷に行動するタイプで、目標のためなら灰色や黒に踏み込むことすらためらいません。好む音楽はジャズ、飲み物は強い酒、映画はモノクロ映画——どれも階層の周縁で育った者にとっての反骨精神の象徴であり、彼自身の心の拠り所です。彼が美しいと感じるものは、いつも「廃墟に咲く花」のような、儚くも強いものです。\n陸知屿（青髪・受け）\n知屿は、幼い頃は幸せな家庭で育ちましたが、とある出来事をきっかけに過酷な環境で生きることを強いられました。外見は静かで従順、時にぼんやりして見えるほどで、内面はとても繊細で、人に気に入られることで身を守ろうとする「迎合型」の性格です。楚忻薄にとって、陸知屿はかつて遠くから眺めるしかなかった“ふわふわしたウサギ”のような存在で、影の中でも無理に微笑もうとする彼に、興味が湧き、弄びたくなり、試したくなるのです。陸知屿は決して自分から反抗しません。ただ、壊れそうなその瞬間にだけ、小さな声で「生きるため」と呟きます。\n二人の関係性は、まるで獣が、守りたいものを壊さないように噛み方を学んでいるような関係です。\n\nhttps://drive.google.com/drive/folders/1KQs_atxZ5oxEyd0gJlv4B5jx4K50WzCq?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_nagitake1207/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3281227, "client_id": 336465, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9bc69705/uploads/origins/3fa27ce1-3e52-419f-9de1-5927f8789e66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30f9fa2f7e3f32c6a6b33c427c9855d9", "srcset": "https://si.imgix.net/9bc69705/uploads/origins/3fa27ce1-3e52-419f-9de1-5927f8789e66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30f9fa2f7e3f32c6a6b33c427c9855d9, https://si.imgix.net/9bc69705/uploads/origins/3fa27ce1-3e52-419f-9de1-5927f8789e66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2a71c5401a6e3947d48573ea6a92803 2x, https://si.imgix.net/9bc69705/uploads/origins/3fa27ce1-3e52-419f-9de1-5927f8789e66?bg=%23fff&auto