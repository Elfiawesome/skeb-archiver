b0-ec4c0262597a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37e12c3f1a058f9a55763392399f936e, https://si.imgix.net/1ac49b15/uploads/origins/3dcdc752-5706-4581-b7b0-ec4c0262597a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35f910275734c0ab24f7871aa87c0baa 2x, https://si.imgix.net/1ac49b15/uploads/origins/3dcdc752-5706-4581-b7b0-ec4c0262597a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67b2d00db327b57492de577571aab7e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ac49b15/uploads/origins/3dcdc752-5706-4581-b7b0-ec4c0262597a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b528a185c41c0c72fceea4289dba2433", "srcset": "https://si.imgix.net/1ac49b15/uploads/origins/3dcdc752-5706-4581-b7b0-ec4c0262597a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b528a185c41c0c72fceea4289dba2433, https://si.imgix.net/1ac49b15/uploads/origins/3dcdc752-5706-4581-b7b0-ec4c0262597a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd7470a792a921a9d8b59d6a5aaf9ac7 2x, https://si.imgix.net/1ac49b15/uploads/origins/3dcdc752-5706-4581-b7b0-ec4c0262597a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bcd7c11ec91da9c080b85c857abefc60 3x"}, "body": "こんにちは！\nりまもさんが描くフブキちゃんがとても可愛くて大好きです。\n\n今回スケブを募集中とのことで、自分の好きなシチュエーションで白上フブキちゃんを描いて頂きたく依頼させていただきました。\n\nシチュエーションの内容としましては、ジムで筋トレの応援をしてくれているトレーナー風のフブキちゃんを描いていただきたいなと思ってます。\n\n細かな要望としまして\n・トレーニングウェアは前にりまもさんが描いていたトレーニングのフブキちゃんみたいなへそ出し\n・｢追い込め｣と文字の書かれたボードをフブキちゃんの手に持たせる(持ち方はお任せします)又は背景に描く\n・ジムにいるシチュなので背景はジムっぽく\n\n全身描くのではなく頭から膝上辺りまででも構いません。ポーズなどのその他の構図はりまもさんにお任せします。\n\nスケブでの依頼が初めてなので足りないところがあったら申し訳ありません。\nこのような感じでお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rimomoh2o/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1109838, "client_id": 819199, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c21ec2d/uploads/origins/cb75566d-6736-4a1f-800a-8cf489eb01b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0fd320e74a014dc65a05cb83ad58b12", "srcset": "https://si.imgix.net/6c21ec2d/uploads/origins/cb75566d-6736-4a1f-800a-8cf489eb01b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0fd320e74a014dc65a05cb83ad58b12, https://si.imgix.net/6c21ec2d/uploads/origins/cb75566d-6736-4a1f-800a-8cf489eb01b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ed7758c0a551f8a5a01bdf904d13d56 2x, https://si.imgix.net/6c21ec2d/uploads/origins/cb75566d-6736-4a1f-800a-8cf489eb01b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b2ff4c376f89b5935e4fe98d235d2b1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c21ec2d/uploads/origins/cb75566d-6736-4a1f-800a-8cf489eb01b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5b45058832c63c3616b38f8e4ce8148", "srcset": "https://si.imgix.net/6c21ec2d/uploads/origins/cb75566d-6736-4a1f-800a-8cf489eb01b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5b45058832c63c3616b38f8e4ce8148, https://si.imgix.net/6c21ec2d/uploads/origins/cb75566d-6736-4a1f-800a-8cf489eb01b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ddf052717b8b74b8a7f85da159c097bb 2x, https://si.imgix.net/6c21ec2d/uploads/origins/cb75566d-6736-4a1f-800a-8cf489eb01b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cbdaf5688ba20a4925f8060a61c86dad 3x"}, "body": "たぬぽんです\n\n今回りまも先生にたぬき娘ちゃんを描いてもらいたくてリクエストさせて頂きました。\n以下容姿設定になります。\n参考資料としてこれまでに描いてもらったたぬき娘ちゃんも添付致します。\n\n容姿について\n・属性：たぬき娘(そのためしっぽとたぬき耳あり)、腰まで届きそうなロングヘア、巫女、碧眼\n・髪色(sRGB#F44F12のような明るめのオレンジ)、髪飾り有り\n・服装：属性に巫女と書いてありますが今回は制服(紺のブレザーに白のミニスカート)でお願いします。\n先生よって容姿が異なるため先生も好きに描いてもらって大丈夫です。\n\nシチュエーションは今回制服ということでそれに見合った場所、構図としてはたぬき耳としっぽがみえるようにお願いします。\n可能であれば表情差分と宛名のレイヤー分けもお願いします。\n\n以上の内容でよろしくお願いします。\n\nhttps://twitter.com/tanupon_fox/status/1492364160050823170?t=vY8krVaLnB8A6A-T9waXyw&s=19", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rimomoh2o/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1109838, "client_id": 1316092, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cecb2a12/uploads/origins/77aa6cc5-4797-452f-9ea0-9700eb5b9443?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=371e506deecf8ff88172cac6497a07a2", "srcset": "https://si.imgix.net/cecb2a12/uploads/origins/77aa6cc5-4797-452f-9ea0-9700eb5b9443?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=371e506deecf8ff88172cac6497a07a2, https://si.imgix.net/cecb2a12/uploads/origins/77aa6cc5-4797-452f-9ea0-9700eb5b9443?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7cefc9d5ab976adf81b60f05c7e6fca3 2x, https://si.imgix.net/cecb2a12/uploads/origins/77aa6cc5-4797-452f-9ea0-9700eb5b9443?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d25edd8a24eea979cd57b4570a2560c1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cecb2a12/uploads/origins/77aa6cc5-4797-452f-9ea0-9700eb5b9443?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8df7a2b771ca57e1e91210c6505dfe9b", "srcset": "https://si.imgix.net/cecb2a12/uploads/origins/77aa6cc5-4797-452f-9ea0-9700eb5b9443?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8df7a2b771ca57e1e91210c6505dfe9b, https://si.im