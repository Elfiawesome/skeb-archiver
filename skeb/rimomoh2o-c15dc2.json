5c7c/uploads/origins/7feccf8d-ad3b-4094-b8e6-d67097ebda04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=223ea2c2460338c50a7f561767e4df77", "srcset": "https://si.imgix.net/5b6b5c7c/uploads/origins/7feccf8d-ad3b-4094-b8e6-d67097ebda04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=223ea2c2460338c50a7f561767e4df77, https://si.imgix.net/5b6b5c7c/uploads/origins/7feccf8d-ad3b-4094-b8e6-d67097ebda04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e998a631c997ef0b1ec030eb122425a4 2x, https://si.imgix.net/5b6b5c7c/uploads/origins/7feccf8d-ad3b-4094-b8e6-d67097ebda04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=04ca336f13f55b68dc2a88cad4ee9133 3x"}, "body": "こんにちは。私はあなたの作品が大好きで、彼の誕生日に私の彼氏と私のキャラクターが一緒に写っている作品をお願いしたいと思っています。私のキャラクターが彼の膝の上に乗っていたり、彼が私の頭を撫でていたりして、二人が座って少し抱き合っているような感じがいいのですが、二人が愛し合っているようなかわいいポーズを自由に選んでください。\n\n私のキャラクター（ピンク）の耳を髪と同じ色にして（髪に花や顔に星はつけない）、白い綿毛をつけてほしいです。彼のキャラクターは、私よりも少し背が高く、耳の色も髪と同じ色にしてほしいです。\n\n衣装は、参考資料の白いワンピースや白黒のツーピースに似ていますが、より似合うように、あるいは可愛くなるようにカスタマイズできるといいですね。私のキャラクターに鎖はないかもしれません。背景はあなた次第です。\n\nどうもありがとうございました。\n\nhttps://imgur.com/a/5pv8r9r", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rimomoh2o/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1109838, "client_id": 1050468, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16aa6433/requests/291220_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf70fe9cc008d0067608df009b9960cd", "srcset": "https://si.imgix.net/16aa6433/requests/291220_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf70fe9cc008d0067608df009b9960cd, https://si.imgix.net/16aa6433/requests/291220_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6b1c55d7df60f1