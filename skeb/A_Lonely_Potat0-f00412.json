a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e3cc4430d11896c07cf1bd1ca82f3a0, https://si.imgix.net/4f588bfc/uploads/origins/f880ded5-4f18-486a-9441-c6efa7ec9a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e61f5322edc1fbb9aba4e2e02282312 2x, https://si.imgix.net/4f588bfc/uploads/origins/f880ded5-4f18-486a-9441-c6efa7ec9a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0bf6d631c853d147915d72ff4a6824f5 3x"}, "body": "Xin chào.\nXin hãy chung tay cứu giúp những người Kansaijin kém may mắn ở đất nước V.\nTôi muốn có hình minh họa về con gái tôi (Shirasaki Noria) và chiếc Yamaha Tricker.\nTôi muốn bức ảnh trông sáng nhất có thể.\nTôi thích bức ảnh này của bạn.\nhttps://www.pixiv.net/artworks/114271359\nVui lòng tham khảo pixiv hoặc artbook của tôi để biết thiết kế nhân vật và chọn trang phục theo sở thích của riêng bạn.\nTôi muốn chiếc xe đạp có thông số kỹ thuật của EENYADE chứ không phải là Tricker tiêu chuẩn. Các bức ảnh được tải lên ở đây.\nhttps://drive.google.com/drive/folders/1-CJ6p3DsI62U4Jaxz0gp4o_SYnxqV17X?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@A_Lonely_Potat0/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2597652, "client_id": 838657, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20d73ddd/uploads/origins/04825d5f-96e5-4b7c-8fe4-920da19dcf69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6d03f850f496a221a35b18147ae0af3", "srcset": "https://si.imgix.net/20d73ddd/uploads/origins/04825d5f-96e5-4b7c-8fe4-920da19dcf69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6d03f850f496a221a35b18147ae0af3, https://si.imgix.net/20d73ddd/uploads/origins/04825d5f-96e5-4b7c-8fe4-920da19dcf69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c31424dbb5af0a9ce424c97d5ff092d 2x, https://si.imgix.net/20d73ddd/uploads/origins/04825d5f-96e5-4b7c-8fe4-920da19dcf69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0367f6bab26b104c5b5c621936b7804b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20d73ddd/uploads/origins/04825d5f-96e5-4b7c-8fe4-920da19dcf69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0804ecffbf572c27e975df9584c1f91", "srcset": "https://si.imgix.net/20d73ddd/uploads/origins/04825d5f-96e5-4b7c-8fe4-920da19dcf69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0804ecffbf572c27e975df9584c1f91, https://si.imgix.net/20d73ddd/uploads/origins/04825d5f-96e5-4b7c-8fe4-920da19dcf69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f621dc30adaa7c2b7f34c2d71239adf3 2x, https://si.imgix.net/20d73ddd/uploads/origins/04825d5f-96e5-4b7c-8fe4-920da19dcf69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3c5289e55d51938faad88baa9f6b650c 3x"}, "body": "はじめまして、YouTubeにてVtuber活動をしている斑鳩 剣鬼（いかるが つるぎ）と申します。\nXやPxivで、おいもさんの飛燕イラストが素敵だったので、今回依頼させていただきました。\nテーマは、飛行場を滑走中の三式戦闘機飛燕です。\n\n・構図、シチュエーション、塗装など\n構図の参考画像が少なく、申し訳ありません。画像は資料URLに添付してあります。\n三式戦は、丙型。\n森林をバックに滑走中。ビルマなどの南西方面のどこかの飛行場という設定です。\n風防開放中。\n増槽あり。\n塗装は、濃緑色/濃緑＆斑 混合はどちらでも構いません。\n部隊マークは、赤色で円枠ありの三つ巴。\n国籍マークは白枠の日の丸。\n時間帯は朝～昼。\n\n搭乗員は、斑鳩剣鬼にしていただけると幸いです。(以下、イラスト内容と設定です。)\nこちらも、下記のURLに画像を添付してあります。\nhttps://drive.google.com/drive/folders/1izDyJf3Fzf7inXwDt-X7WvcaOiS50sOe?usp=sharing\n【構図など】\n赤い一本角が生えている。\n白いハチマキあり。\n飛行防は、毛皮張り(防空隊仕様?)。\nゴーグルを被っている。\n【設定】\n種族：半人半鬼/日本人\n所在地：日本\n性別：男\n身長：167cm\n年齢：259歳（1765年12月8日生まれ)　\n職業：大日本帝国陸軍(航空隊)　→　【戦後】日本航空防衛軍、戦闘機パイロット\n\n\nといった感じです！\n\n\nサイズはYouTube等サムネやPC壁紙として使用したいと思っていますので16：9でお願いします。\n\n制作頂いたイラストをVtuber活動（サムネやSNS、キャラクターの世界観）にて使用したいと思っております。\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1bcLX52nTwtx08FK-zUWgVqpJnh64BsQ4", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@A_Lonely_Potat0/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2597652, "client_id": 2331865, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d18e2fae/uploads/origins/e2367b2c-0be0-4afa-bb32-3c252f6b5a39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e09e171b2ce93c0f31e1dbd48378cb58", "srcset": "https://si.imgix.net/d18e2fae/uploads/origins/e2367b2c-0be0-4afa-bb32-3c252f6b5a39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e09e171b2ce93c0f31e1dbd48378cb58, https://si.imgix.net/d18e2fae/uploads/origins/e2367b2c-0be0-4afa-bb32-3c252f6b5a39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0f96268054fff2789c6c495201c52a9 2x, https://si.imgix.net/d18e2fae/uploads/origins/e2367b2c-0be0-4afa-bb32-3c252f6b5a39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79f57bf89d3bf6d713ee2e184156a78b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d18e2fae/uploads/origins/e2367b2c-0be0-4afa-bb32-3c252f6b5a39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70dedaac70ad6bbf8dc758c46c64d1e6", "srcset": "https://si.imgix.net/d18e2fae/uploads/origins/e2367b2c-0be0-4afa-bb32-3c252f6b5a39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70dedaac70ad6bbf8dc758c46c64d1e6, https://si.imgix.net/d18e2fae/uploads/origins/e2367b2c-0be0-4afa-bb32-3c252f6b5a39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4ef88971c13080df825f1f0f746914ce 2x, https://si.imgix.net/d18e2fae/uploads/origins/e2367b2c-0be0-4afa-bb32-3c252f6b5a39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=67ce532ac4de8faadcbbb394e8b32d0b 3x"}, "body": "こんにちは、初めてイラストのリクエストをします。十円禿が出来たユウです。\nいつもおいもさんのかっこええイラストとRC見させてもらってます！リクエストができると知って、それなら是非うちの子をかっこよく描いて貰いたいなと思い人生で初めてイラストの依頼をしようと思った所存です！\n\n本題ですが、うちのYZF-R25Zのイラストを描いて欲しいです。\n・iPhoneの壁紙やLINEなどのアイコンに使いたいなと思っているので縦にして欲しいです。\n・過去絵のポップな色味が素敵だったので背景はシンプルな雰囲気でお願いします。\n・その他は基本おまかせします。\nどの程度指定や指示を出していいのか分からないので、資料としてイメージの写真を数点添付します。\nもし追加の資料が必要な場合は言って頂ければ送ります。\n\nイラストになるまでの流れをあまり理解できていないので不十分な点や拙いやり取りをしてしまうかもしれません、その時は遠慮なく言ってもらえるとありがたいです。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/u/0/mobile/folders/1FBTae2vbck7j_XGE_X1Mg22OoxlBHFzp?sort=13&direction=a", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@A_Lonely_Potat0/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2597652, "client_id": 3179661, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8312401/uploads/origins/c083ed97-00b8-4d02-a199-d6a17cdba427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb82b152043c2d783287340663ceaa6a", "srcset": "https://si.imgix.net/f8312401/uploads/origins/c083ed97-00b8-4d02-a199-d6a17cdba427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb82b152043c2d783287340663ceaa6a, https://si.imgix.net/f8312401/uploads/origins/c083ed97-00b8-4d02-a199-d6a17cdba427?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50d62383f075a3000bb093e4a983a9ea 2x, https://si.imgix.net/f8312401/uploads/origins/c083ed97-00b8-4d02-a199-d6a17cdba427?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=630d96761042750d7f4106e68ffdd5f6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8312401/uploads/origins/c083ed97-00b8-4d02-a199-d6a17cdba427?bg=%23fff&auto=format%2Ccompress&fm=webp