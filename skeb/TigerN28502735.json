"src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9efc840f/uploads/origins/4e54bede-ed1b-4511-a7db-04043e3aea30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4958a342ca65098b066c8eb74cfb536e", "src_set": ""}, "body": "架空パンター戦車(古い方)とガールズ&パンツァーの逸見エリカのイラストを依頼したいです\n\nシチュエーション\n黒森峰に新しい納入された新型パンターと、レースクイーンのようにポーズをとるバニーエリカ\n\nパンター\n砲塔はパンターⅡ、車体はパンターGをベースに小改良を施したオリジナル\n\n砲塔デザインはWar ThunderのパンターⅡ\n\n車体のベースはパンターG、車体機銃は廃止され車体正面装甲はシンプルな構成に\n車体正面装甲に予備履帯吊り下げラックが溶接され全面を覆う様に吊り下げられている\n転輪はゴム内蔵式鋼製転輪\nシュルツェン装備\n塗装は納車直後のためダークイエロー単色\n砲塔側面に黒森峰校章付き\n\nエリカ\n衣装はハイレグバニー、ピンヒール\n脇見せポーズ、恥ずかしげな赤面\n足は肩幅に開いて直立\n\nhttps://wikiwiki.jp/warthunder/Pz.Kpfw.%20Panther%20II", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1872, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ふでレリカ", "screen_name": "N_Fderelica", "avatar_url": "https://pbs.twimg.com/profile_images/1942040308545474560/MIUqA0gB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2842307262/1711874099/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 32}, {"id": 12061, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ハチミツB", "screen_name": "hachimitub", "avatar_url": "https://pbs.twimg.com/profile_images/1660226230640324610/LdHV_Mvl.jpg", "header_url": "https://pbs.twimg.com/profile_banners/131482251/1684583428/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 56}, {"id": 62781, "creator": true, "nsfw_acceptable": true, "accepta