ls": [{"genre": "art"}, {"genre": "comic"}], "nc": 49}]}, "price_history": {"art": [{"amount": 15000, "recorded_at": "2025-10-06T11:56:01.205709"}], "comic": [{"amount": 20000, "recorded_at": "2025-10-06T11:56:01.205709"}]}, "works": [{"path": "/@TigerN28502735/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1160893, "client_id": 121069, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/556025ef/uploads/origins/e0656241-5ec3-489f-a6d9-c9dc4675b456?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00f8458ae6c6a8ebe9236f47ae1bf96b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/556025ef/uploads/origins/e0656241-5ec3-489f-a6d9-c9dc4675b456?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4225a9f4796537e66be6244cf2016b52", "src_set": ""}, "body": "いつもお世話になっています\nTigerさんはチェンソーマンはご存知のようですが、映画の方のレゼ編は既にご覧になられましたか？\n先日見に行ってあまりに余韻が鮮烈に残ったので今回、レゼのイラストを依頼したくリクエスト送らせて頂きます\n\nシチュ\nレゼがデンジと再会できた、もしもな世界線\n深夜の学校で、扇状的な衣装に身を包みデンジを誘惑するレゼ\n\nポーズ、構図\nhttps://x.com/wokada156/status/1819318402194010602?s=46&t=CGlAcSWGEosxkiuWwW-VYA\nリンク先イラストを参考に\n正面絵、足を大きく開いて椅子に座っているレゼ\n左手は脇が露出するよう頭の後ろへ\n右手は手の平を開き誘うように正面へ突き出す\nレゼが座っている椅子は丸椅子形でお願いします\nhttps://miharakikou.co.jp/products/chair-pm_10/\n\n衣装\nハイレグ競泳水着(色はレゼの髪色と揃えて)\n長手袋、ニーソ(色はお任せします)\nパンプス(厚底ヒール、色はお任せします)\n\n表情\n赤面しつつも挑発するような笑顔(満更でも無い様子)\n\n背景\n深夜の学校、教室内\n\nその他\n水着を脱いだ差分を一枚お願いします\n(長手袋、ニーソ、パンプスはそのまま)\n\n検討宜しくお願いします！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TigerN28502735/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1160893, "client_id": 121069, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea8d8576/uploads/origins/8810e1e8-01ba-455f-bb2f-3572a25a39da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=838f8b0a4efe82930b29a143ecbc6731", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea8d8576/uploads/origins/8810e1e8-01ba-455f-bb2f-3572a25a39da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ed95873ad8448133057634cab744dc6", "src_set": ""}, "body": "いつもお世話になっています、前回は素晴らしいイラストありがとうございました\n\nキャラ\nガールズ&パンツァーから逸見エリカ\n\nシチュ\n露出の多い踊り子衣装を着て、大口スポンサーへ踊りを披露する逸見エリカ\n\n衣装\nhttps://www.pixiv.net/artworks/114148950\n上半身は乳暖簾、乳首が隠れる程度の布が垂れている\n下半身は腰布の前垂れのみ、ノーパン\n股間がギリギリ隠れる程度のきわどいサイズ\n上下共に赤色\n\n長手袋、ニーソ(黒色)\nヒールブーツ\n黒森峰戦車道略帽\n細かな装飾品は必要ありません\n\nポーズ\n片足を上げ、脇が見えるアングル\nそれ以外はお任せします\n\n構図\n正面から、全身を収めて\n\n表情\n赤面しつつ、挑発するような笑顔\n\nその他\n乳首勃起\n汗だく\n\n差分\n布がズレて乳首とスジが露出している差分を1枚お願いします\n\n検討宜しくお願いします", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TigerN28502735/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1160893, "client_id": 121069, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e8d2d2c/uploads/origins/8f2e8e60-dbd9-4ed0-a49c-8d7a5ab2ae19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ba15310bc04938be92c77687ee724f9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e8d2d2c/uploads/origins/8f2e8e60-dbd9-4ed0-a49c-8d7a5ab2ae19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b669b201fe60d99f12bcc5204bed0d1", "src_set": ""}, "body": "いつも素晴らしいイラストありがとうございます！\n\nシチュ\nスポンサーから寄付(意味深)された拳銃を片手に広報撮影をする逸見エリカ\n\nキャラ\nガールズ&パンツァーから逸見エリカ\n\nポーズ\n基本リンク先の画像の様な背中メインのポーズ\nhttps://x.com/kyojin_desuu/status/1949037476309356730?s=46&t=CGlAcSWGEosxkiuWwW-VYA\n・左手は脇が見えるように頭の後ろへ\n\n・右手に新品のモーゼルC96(着脱式20連マガジンタイプ、M1932シュネルフォイヤー、追加ストックは無し)\nhttps://ja.m.wikipedia.org/wiki/%E3%83%A2%E3%83%BC%E3%82%BC%E3%83%ABC96\n\n表情\n赤面しつつ、挑発するような笑顔\n\n衣装\nハイレグTバック競泳水着(お尻がほとんど露出している)\n長手袋、黒ストッキングニーソ\nロングブーツ(ヒール高め)\n\n背景\n昼の野外\n\nその他\n乳首勃起\n\n差分\n水着を脱いだ差分を1枚(長手袋、黒ストニーソ、ブーツ、C96はそのまま)\n汗を追加、特に脇と背中\n\n検討宜しくお願いします！", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TigerN28502735/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7a8488d1/uploads/origins/29b32170-44f1-4bac-838c-02f5a3dfb71b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c057c31d1eaa3fcda20d094ed72fd02b", "src_set": ""}, "private": true, "genre": "comic", "tipped": true, "creator_id": 1160893, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@TigerN28502735/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1160893, "client_id": 498428, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf371e2d/uploads/origins/bb2b939a-67a0-4f69-9f51-37b559771e0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cf6a57238bb17b9993486d1e184142a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf371e2d/uploads/origins/bb2b939a-67a0-4f69-9f51-37b559771e0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d79eed3aaf8d1f0dab55e09ef169726d", "src_set": ""}, "body": "こんにちは、\n\nフルカラーのマンガを2ページお願いします。\nグリーン・ブラザーとケイトのミックス・ボクシング・マッチです。\npixivのリンクを見てください。すべての詳細がそこにあります。\n最初のページは6コマ。\n2ページ目は5コマでお願いします。\n頑張ってください！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_g