nt_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@okki_b/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3745292, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c044769/uploads/origins/e8f5b162-434f-4e78-9282-97adc1d8f144?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82e133a858b0ef125626978884dc7eb9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c044769/uploads/origins/e8f5b162-434f-4e78-9282-97adc1d8f144?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3ded3d3519dc3ad9b4ba88c4a7229df", "src_set": ""}, "body": "依頼送らせていただきます。\n以下リクエスト内容になります。\n-----\n『フタナリ女子のソロプレイ』\n人物\n・ボーイッシュ女子（スレンダー、短髪、フタナリ）\n\nセリフなど色々な設定\n・最初は「早く出さないと」と急ぎで処理するが、最後に果てる直前は「手、止まりなさい」と気持ちよさを長引かせようとするが、我慢出来ずに出してしまう。\n※一枚絵でしたら果てる直前の方を描いていただければと思います。\n-----\n以上、よろしくお願いいたします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@okki_b/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3745292, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aea19b55/uploads/origins/aeeca71a-33cf-4ace-92e3-50108c48f560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fdb748d0156505285643f6fb8a1dd68", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aea19b55/uploads/origins/aeeca71a-33cf-4ace-92e3-50108c48f560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bd45a95aadbaa1fd630c8f42e441a3b", "src_set": ""}, "body": "Skeb開設ありがとうございます！\n早速リクエスト失礼いたします。\n\n☆キャラ\nやんちゃギャルの安城さんから安城アンナ\n\n☆竿役\nキモオタまたは不良\n\n☆描いていただきたいシチュ\n安城さんが他の男のチンポに寝取られていて、んほ面や中出し後に舌出ししながらアヘ顔で寝取られ報告動画を撮っているような挿入前から中出し後のトロ顔のまま余韻に浸っているところまでのシチュエーションを描いていただきたいです。出来れば軽くセリフなどあると嬉しいです\n\n☆ポーズ\nバックまたはフルネルソン\n\n☆服装と容姿\n・衣装は出来ればおっぱいが露出されているドスケベな衣装がいいですが、\n　こちらからこれ！というものがないので基本おまかせで問題ないです！\n・出来れば乳首ピアスや使用済みコンドームの着用\n　雌豚などの落書きを描かれているハードな方向に持っていただけると幸いです。\n・体が細かったり、おっぱいがオリジナルみたいに大きくないので\n　先生の塩梅でムチムチにしたり大きくしてくださっても問題ないです！\n・個人的には体ムチムチのおっぱいは大きい方が好きなのですがおまかせいたします！\n　寝取られた後ということで心体共に変化したという事にするのもありかなと思っています\n\n☆差分要望\n・撮影という事でカメラのフレーム有り無し\n・落書きなしや鼻フックなどのした時の表情なども見てみたいです！\n差分は工数とモチベーションがある場合に対応していただけると幸いです。\n\nキャラやシチュ、差分など難しい要望を初回にリクエストしてしまっているかもしれませんが\n一度、ご検討していただけますと幸いです。お気軽にキャンセルしていただいても大丈夫です！\n\nどうぞ、よろしくお願いいたします！！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 132234, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Moco", "screen_name": "_moco_28", "avatar_url": "https://pbs.twimg.com/profile_images/1283311414296276992/PyRL3U94.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1062693966854807552/1656729196/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 177}, {"id": 315726, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "鳴海アミヤ📚単行本３巻発売中", "screen_name": "NarumiAmiya", "avatar_url": "https://pbs.twimg.com/profile_images/1150797122771410946/XamJjoKf.png", "header_url": "https://pbs.twimg.com/profile_banners/1174598334/1600442638/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "correction"}], "nc": 176}, {"id": 1323613, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "一願", "screen_name": "hinegai_64", "avatar_url": "https://pbs.twimg.com/profile_images/1771524