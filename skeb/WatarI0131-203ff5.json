=200&s=10fdc33af9680f5027ba0e8db8bfccb7, https://si.imgix.net/160b442c/uploads/origins/0f74d364-cb3b-4a8b-905a-b26c2fc4a942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e5006d997fe70a725d1f030fd7dcfd5a 2x, https://si.imgix.net/160b442c/uploads/origins/0f74d364-cb3b-4a8b-905a-b26c2fc4a942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=feb3fdd1d68fc9749601444e66515fba 3x"}, "body": "Hello, my name is Roca Rourin and I'm a Vtuber. I really like your art style, and would like to request an illustration of me. \n\nRoca Rourin is a rock-star and loves rock music, but likes other music too! She loves singing and playing guitar. Her personality is bold, charismatic, playful and mischievous, with a seductive side. Her fashion style is gothic/punk-rock, and she can be both cool and cute. She also has an elegant and feminine side. Despite all, she can be a little bit of a chuunibyou and easily gets embarrassed... \n\nPlease draw her as you like. The pose, hair style, accessories and clothing are up to you! Keep the clothes style punk-rock/gothic, and make her look playful and charismatic!\n\nThis art will be used for SNS, such as Twitter, YouTube, so please reject the application if this isn't allowed. If you could provide a transparent image that would be really helpful!\n\nhttps://drive.google.com/drive/folders/1IcqZxAPnAqdV8r6QwsaXIlS82zN9vTJR?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@WatarI0131/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1669807, "client_id": 2026904, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93dff013/uploads/origins/cb8a9914-c92c-4a31-a174-136d52f00eb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4d10cc263bfea7f965876f69d7bbf3f", "srcset": "https://si.imgix.net/93dff013/uploads/origins/cb8a9914-c92c-4a31-a174-136d52f00eb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4d10cc263bfea7f965876f69d7bbf3f, https://si.imgix.net/93dff013/uploads/origins/cb8a9914-c92c-4a31-a174-136d52f00eb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09e82c09497087b3a858a62d515746f0 2x, https://si.imgix.net/93dff013/uploads/origins/cb8a9914-c92c-4a31-a174-136d52f00eb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66da04a0ec8458b4251f225625f297d0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93dff013/uploads/origins/cb8a9914-c92c-4a31-a174-136d52f00eb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e986860d95030a75fab8670de18b9bc", "srcset": "https://si.imgix.net/93dff013/uploads/origins/cb8a9914-c92c-4a31-a174-136d52f00eb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e986860d95030a75fab8670de18b9bc, https://si.imgix.net/93dff013/uploads/origins/cb8a9914-c92c-4a31-a174-136d52f00eb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=665bbfe0af5755a808330b1ba1496d41 2x, https://si.imgix.net/93dff013/uploads/origins/cb8a9914-c92c-4a31-a174-136d52f00eb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fda96a469360ffc59b81eb171c4bd9dd 3x"}, "body": "はじめまして、個人Vtuberの神咲リリカと申します。\nﾊﾙ様のクオリティの高くかわいらしい素敵なイラストに惹かれました！\nよろしければぜひ私自身を描いて頂きたく、リクエストを送信させていただきます。\n\n\n【依頼内容】\n・気持ちセクシーな感じでかわいく照れながら寝転んでいる感じのイラストをおねがいします！\n・サムネなどに使用したいので、頭のてっぺんからお顔回りの髪の毛等は切れないように描いていただけるとうれしいです。（難しい場合は大丈夫です！）\n・16:9の横で書いていただけると助かります。\n・可能な範囲でお顔の差分もいただけたらとってもうれしいですが、ご無理はなさらないでください！\n\n\n【使用用途】\n・Twitterなど各種SNSでの使用、ASMR等のサムネ想定\n・収益化をしているYouTubeチャンネル内での使用\n・FANBOX内での使用\n・ネットプリントにて使用\n\n【納品形式】\n・お手数をおかけいたしますが\n人物・背景・宛名等がレイヤー分けされたPSDデータで頂けると大変助かります！\n\n\n大変お恥ずかしながら三面図はまだありませんので、お手数ですが私のfanboxのホームに全身画像がありますのでそちらを参考にしていただけたら幸いです。分かりにくくて申し訳ないのですが、お胸のサイズはBくらい想定です。\n\nこの度はご縁がありましたらよろしくお願いいたします。\n\nツイッターアカウント\nhttps://twitter.com/Kanzaki_Ririka\n\nhttps://kanzaki-ririka.fanbox.cc/", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@WatarI0131/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1669807, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f27ccc73/uploads/origins/d78d47f1-9860-4801-80e7-340dc2b5456f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35e1ad68e1f912bbc5ce6210354b805b", "srcset": "https://si.imgix.net/f27ccc73/uploads/origins/d78d47f1-9860-4801-80e7-340dc2b5456f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35e1ad68e1f912bbc5ce6210354b805b, https://si.imgix.net/f27ccc73/uploads/origins/d78d47f1-9860-4801-80e7-340dc2b5456f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db35166ae6d450abe6068949a03a66f5 2x, https://si.imgix.net/f27ccc73/uploads/origins/d78d47f1-9860-4801-80e7-340dc2b5456f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8f69b5570bb93e532ee6f6eb96d0020 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f27ccc73/uploads/origins/d78d47f1-9860-4801-80e7-340dc2b5456f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0afc4d5be1e07f559f0f80953bf53a40", "srcset": "https://si.imgix.net/f27ccc73/uploads/origins/d78d47f1-9860-4801-80e7-340dc2b5456f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0afc4d5be1e07f559f0f80953bf53a40, https://si.imgix.net/f27ccc73/uploads/origins/d78d47f1-9860-4801-80e7-340dc2b5456f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ca9ea66364ec2b6fa9272dd999b73f3 2x, https://si.imgix.net/f