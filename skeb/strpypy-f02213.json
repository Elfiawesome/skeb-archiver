ます！また、制作されたVtuberさんの泡沫碧空くんと仲良くさせていただいております！\n\nいつもお世話になっている泡沫碧空くんの誕生日が近い（9/20）とのことで、僕涼鳴ハッカが碧空くんのお誕生日のお祝いをしているイラストをお願いしたいと思います。\n泡沫碧空くんが自由に使用できるようしていただけるとありがたいです。\n\n涼鳴ハッカ資料・三面図\nhttps://twitter.com/suzunari_hakka/status/1406226880974389251\n\nどうぞよろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@strpypy/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 981316, "client_id": 2829659, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b90265fe/uploads/origins/ac108794-f240-4e0e-8d0a-3f557ee8b72e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7578da5d3cff1edbbe38457b68118f7b", "srcset": "https://si.imgix.net/b90265fe/uploads/origins/ac108794-f240-4e0e-8d0a-3f557ee8b72e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7578da5d3cff1edbbe38457b68118f7b, https://si.imgix.net/b90265fe/uploads/origins/ac108794-f240-4e0e-8d0a-3f557ee8b72e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98b359dfc785dabb9243a1417a789489 2x, https://si.imgix.net/b90265fe/uploads/origins/ac108794-f240-4e0e-8d0a-3f557ee8b72e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba43d2787433f4eef25846590e33de38 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b90265fe/uploads/origins/ac108794-f240-4e0e-8d0a-3f557ee8b72e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9056260faf4de694b88ca4d15d7b55fc", "srcset": "https://si.imgix.net/b90265fe/uploads/origins/ac108794-f240-4e0e-8d0a-3f557ee8b72e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9056260faf4de694b88ca4d15d7b55fc, https://si.imgix.net/b90265fe/uploads/origins/ac108794-f240-4e0e-8d0a-3f557ee8b72e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&