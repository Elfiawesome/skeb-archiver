unt": 1000}, {"genre": "correction", "default_amount": 7000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@okatanuki/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2140110, "client_id": 2555628, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1452c120/uploads/origins/f73a1e46-f798-475c-b7aa-41549c221a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb3778844829bccad3838fc0c207b1ab", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1452c120/uploads/origins/f73a1e46-f798-475c-b7aa-41549c221a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5a18fb5f6556a98bc03aaa544860ff4", "src_set": ""}, "body": "こんにちは。もしよろしければリクエストをお願いしたく思います。\n\n■内容\n「宇宙にいるポケモンとトレーナー」という内容をお願いしたいです。キャラクターの候補を挙げますが、可能な範囲で描いていただければOKです。\n\nトレーナー\n・BW女主人公のトウコ\n・BWモブトレーナーのミニスカート\n\nポケモン\n・タブンネ\n・シキジカ(はるのすがた)\n・チラーミィ\n・シママ\n\n皆にはアニポケAG99話に登場した宇宙服を着せていただきたいです。(以下のように、白色のボディ／透明なヘルメット／アンテナ付きのものです。)\nhttps://www.pixiv.net/artworks/108375506\nhttps://www.pixiv.net/artworks/109060720", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@okatanuki/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2140110, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac247c91/uploads/origins/63a71e87-4bde-4424-84cb-ce5f75f28095?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8cf062c817484efcc70159b8f7e1a01", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac247c91/uploads/origins/63a71e87-4bde-4424-84cb-ce5f75f28095?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4934d331c82b9e1da889da6ea4fcf64", "src_set": ""}, "body": "こんにちは。ケロロ軍曹のイラストを描かれておられましたので、もしよければ私からも同作品でリクエストをお願いしたく思います。\n\n「ケロン人姿のプルル看護長」をベースとして、ご自由に描いていただきたいです。プルル看護長単独でも良いですし、地球人風の姿と一緒に描いていただいても良いです。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@okatanuki/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2140110, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/037f6ddf/uploads/origins/b83798d8-9df1-448b-b121-4a446aaa884d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95b732d28ea27177c9c9bd825adcd9d2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/037f6ddf/uploads/origins/b83798d8-9df1-448b-b121-4a446aaa884d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70bd743a358ec3aca000bc3c83bda4f3", "src_set": ""}, "body": "前回描いていただいたキルリアの予防接種に関する、下記のイラスト３枚をお願い致します。\n\n・１枚目\n資料URLを参考に、横顔パターンでルージュラがキルリアの唇にキス\n\n・２枚目\n１枚目と同じく横顔パターンで、下記URLの４枚目を参考に唇のみで思いっ切り引っ張るようなキス\n\nhttps://x.com/okatanuki/status/1912698015980359930?t=4Jp_4-ePLTDZaClASJa7kQ&s=19\n\n・３枚目\n待合室にて、キルリア含む数匹のポケモン達が気絶している\n※キスで吸い付かれた跡が付いている\n\n何卒、よろしくお願い致します！\n\nhttps://x.com/indozou/status/1611696645837819907?t=wqOdkTMpdu5mdDkCS0-QqA&s=19", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@okatanuki/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2140110, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76483aa5/uploads/origins/44cf50f1-73d5-437e-bea0-1f61671d8072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5546ca20cb44f80f476d500e2c8bb6e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76483aa5/uploads/origins/44cf50f1-73d5-437e-bea0-1f61671d8072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c559cc72ab7af47e8b53151702ecba4d", "src_set": ""}, "body": "オカタヌキさん、初めまして。\n今回、初リクエストとなります。\n\n依頼内容ですが、ルージュラが女の子トレーナーとキルリア♀にキスする話になります。\n\n下記、詳細な内容になります。\n\n1枚目\n今日は私のキルリアの予防接種日。\n何とか病院まで連れて来れた...(ゼェゼェハァハァ)。\n\n2枚目\n病院内では、看護師さんと一緒にナース服を着たルージュラが予防接種の対応をやってました。\n\nなんでもベテランなルージュラらしく、どんなポケモンでも逃さずキスで気絶させて大人しく注射させてるんだって。\n\n3枚目\n案の定、注射嫌いな私のキルリアは逃亡を図った挙句に私をキスの盾にしやがりました...。\n\nわ、私のファーストキスがぁ...泣\n※ルージュラが間違って女の子トレーナーの唇にキスしたため、双方ともにビックリしている\n\n4枚目\nその後すぐにキルリアは捕まり、お仕置きも兼ねて唇に長めのキスをされてました。\n\nこれに懲りて、次は大人しく予防接種を受けてくれるといいなぁ...。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@okatanuki/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2140110, "client_id": 2905364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d21e2e6/uploads/origins/5f94ac82-69b2-491c-b133-7ce729585e78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e94ce1372817f30e195e7ff3abbcccbb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d21e2e6/uploads/origins/5f94ac82-69b2-491c-b133-7ce729585e78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80fa687bf9150f623d23f57315b52877", "src_set": ""}, "body": "こんにちは、ポケモンのシルビオン（ニンフィア）が漫画のキャラクターのようにぺったんこになるのを描けますか？\nここにいくつかの例があります。\nhttps://drive.google.com/drive/folders/16dmNVZ7PswVQl0-_goGTTAz9wK6Ko5Ib?usp=drive_link\n\nhttps://drive.google.com/file/d/1B1ZNAMZQ1FxAXB4KJ_ysC9qLD6PXDDDM/view?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@okatanuki/works/3", "private_thumbnail_image