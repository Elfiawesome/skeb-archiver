がよければ、どうかよろしくお願い致します！\n\n参考ツイート\nhttps://twitter.com/hakuto_iwashi/status/1336847550909825027?s=21\n\nキャラクター詳細\nhttps://www.pixiv.net/novel/series/1488236/glossary/62162\n\n小説本編\nhttps://ncode.syosetu.com/n5891gt/", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@papermoon_game/works/110", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 14616, "client_id": 1076430, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e56dc203/uploads/outputs/cc16be38-fd67-4df4-bf2c-d16e73387788?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=ba2148d482a4a4f9a6df70962725bdb9", "srcset": "https://si.imgix.net/e56dc203/uploads/outputs/cc16be38-fd67-4df4-bf2c-d16e73387788?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=ba2148d482a4a4f9a6df70962725bdb9, https://si.imgix.net/e56dc203/uploads/outputs/cc16be38-fd67-4df4-bf2c-d16e73387788?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f3d19fac90f40dd89fdef5f0733feb3 2x, https://si.imgix.net/e56dc203/uploads/outputs/cc16be38-fd67-4df4-bf2c-d16e73387788?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9c9fa60a92d4c1c4105c21dac88154b 3x"}, "duration": 3, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e56dc203/uploads/outputs/cc16be38-fd67-4df4-bf2c-d16e73387788?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=284ec7de52cd61ad4b1d7d0c636bdb37", "srcset": "https://si.imgix.net/e56dc203/uploads/outputs/cc16be38-fd67-4df4-bf2c-d16e73387788?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=284ec7de52cd61ad4b1d7d0c636bdb37, https://si.imgix.net/e56dc203/uploads/outputs/cc16be38-fd67-4df4-bf2c-d16e73387788?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9c704abed1c934ad2ec2f52a05f6660 2x, https://si.imgi