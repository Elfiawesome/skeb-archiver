ですが、これは参考画像中のオリジナルスキンのようなシンプルなものにして頂ければ幸いです。（むしろ別のマークや何かでもOKです）\n・ハイタッチですが、\n　→両手ではなく片手で、\n　→両キャラの右手と左手が合わさっていて、\n　→2人とも体の大体正面がこちらを向いていて、\n　→目線も2人ともこちらを向いている感じ\n　にしていただけますと嬉しいです。（説明が難しい…参考資料中のテキストファイル中のURLをご参照下さい）\n・色々描いてしまいましたが上記はあくまでこちらの願望なので、最後はitucaさんの思う通りにお描きください…！\n\nキャラ2体で手間も2倍だと思いますので、ご無理なさらずどうぞ…。\nもしお請け頂ける場合も、お忙しいと思いますのでご自身のペースで進めて頂ければと思います。\n\nそれではよろしくお願い致します、長々としてしまいすみませんでした！\n\nhttps://drive.google.com/drive/folders/12VSWk-GFnCH2WGrmZDTs-Cp6Z09GN50y?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mnsknyu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 29770, "client_id": 610845, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/930c0060/requests/113606_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08173242efb39f467b9f52a64e223579", "srcset": "https://si.imgix.net/930c0060/requests/113606_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08173242efb39f467b9f52a64e223579, https://si.imgix.net/930c0060/requests/113606_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dad28a1b14081b9d65be333d783f457f 2x, https://si.imgix.net/930c0060/requests/113606_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d98ef95ceb659a3a9822586a1689a4d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/930c0060/requests/113606_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ff78a5a6608a2486fd193dada2fde7c", "srcset": "https://si.imgix.net/930c0060/requests/113606_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ff78a5a6608a2486fd193dada2fde7c, https://si.imgix.net/930c0060/requests/113606_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=20