プ程度～つるぺたまでお好みで）\nランジェリーの場合は着たままでお願いします（シチュエーションによって胸や股のクロッチを開いてください）\n\nご検討をお願いいたします\n\nhttps://drive.google.com/drive/folders/1gXZVDfcsl66QZ8VxPLKFXERqQXKioNsJ", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 209130, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "へるじょぐ", "screen_name": "healthy_jog", "avatar_url": "https://pbs.twimg.com/profile_images/1479461847644655618/QYlERJvI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/542024249/1600857202/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 1227718, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "まやｍ", "screen_name": "Jin_Mayam", "avatar_url": "https://pbs.twimg.com/profile_images/1755183464402591744/haC7AH7N.jpg", "header_url": "https://pbs.twimg.com/profile_banners/894866994/1551844518/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 0}, {"id": 1596881, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ひとや", "screen_name": "hito61631", "avatar_url": "https://pbs.twimg.com/profile_images/1671906057701167105/JXEwFJXZ.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id"