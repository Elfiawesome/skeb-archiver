i444/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3873032, "client_id": 300145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b18b677/uploads/origins/a41aa0ff-09d0-49e5-82c3-efea8868d0e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90ded3685cbb6e457a097e7f69d1de18", "srcset": "https://si.imgix.net/9b18b677/uploads/origins/a41aa0ff-09d0-49e5-82c3-efea8868d0e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90ded3685cbb6e457a097e7f69d1de18, https://si.imgix.net/9b18b677/uploads/origins/a41aa0ff-09d0-49e5-82c3-efea8868d0e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f15f9c8a4d8ffeb5206239f7f0ffeb7 2x, https://si.imgix.net/9b18b677/uploads/origins/a41aa0ff-09d0-49e5-82c3-efea8868d0e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=302ee1cbc7624817a96fac23da4a6c32 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b18b677/uploads/origins/a41aa0ff-09d0-49e5-82c3-efea8868d0e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27bd77797c3f5d8656b65930a0126383", "srcset": "https://si.imgix.net/9b18b677/uploads/origins/a41aa0ff-09d0-49e5-82c3-efea8868d0e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27bd77797c3f5d8656b65930a0126383, https://si.imgix.net/9b18b677/uploads/origins/a41aa0ff-09d0-49e5-82c3-efea8868d0e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb80006aacaa409117d1a9381cd64842 2x, https://si.imgix.net/9b18b677/uploads/origins/a41aa0ff-09d0-49e5-82c3-efea8868d0e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cfa527cf317e317cb0b1de596750caf0 3x"}, "body": "オレンジ色のビキニを着たオリジナルキャラクターを描いてください。セクシーなポーズで。瞳の色：グレー身長：5フィート9インチ（約175cm）年齢：20歳犬の耳あ