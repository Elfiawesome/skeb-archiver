-4c3e9b5eafc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36c00dfba35b21f5ad3b0b558cceec4e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6094690c/uploads/origins/cdeec608-c3f9-470a-b152-4c3e9b5eafc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b19c6b3223a84cccf4fecaeeb204e8d5", "srcset": "https://si.imgix.net/6094690c/uploads/origins/cdeec608-c3f9-470a-b152-4c3e9b5eafc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b19c6b3223a84cccf4fecaeeb204e8d5, https://si.imgix.net/6094690c/uploads/origins/cdeec608-c3f9-470a-b152-4c3e9b5eafc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c221fa7b614d5eb800e2e7945b526f3 2x, https://si.imgix.net/6094690c/uploads/origins/cdeec608-c3f9-470a-b152-4c3e9b5eafc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8546960cf3a611388a352f3ccbf2dd19 3x"}, "body": "こんにちは、いつもお世話になっております。TRTです。\n早速ですが、今回のご依頼内容についてお伝えいたします。\n今回は、アイカツ!より、\n『瀬名さんのぬいぐるみを愛おしいそうに眺める大空あかりさん』\nをお願いしたいです。\n今年、瀬名さんのぬいが発売され、アイカツ!世界でも発売されていた場合…の妄想みたいなシチュエーションです。\n是非、よしおかさんのイラストで瀬名あかを供給して下さると大変ありがたいな、と思っております。\nご都合、また解釈違い等なければ、是非よろしくお願いいたします…！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoshioka_326/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2237322, "client_id": 1913547, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dbe11252/uploads/origins/552f7a40-ab1a-44a0-b83f-a58e16071adc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3e236c4db81778a24a5cd053214dbca", "srcset": "https://si.imgix.net/dbe11252/uploads/origins/552f7a40-ab1a-44a0-b83f-a58e16071adc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3e236c4db81778a