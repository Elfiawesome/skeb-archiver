w=200&h=200&blur=200&s=2823fc02ccecdcf8d7ca0d47ec34c9b1", "srcset": "https://si.imgix.net/b669297b/uploads/origins/0b4d2a69-3770-4e05-a437-a174d1221ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2823fc02ccecdcf8d7ca0d47ec34c9b1, https://si.imgix.net/b669297b/uploads/origins/0b4d2a69-3770-4e05-a437-a174d1221ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3f5c0b78abb91fd6439dc360d0d7f7ef 2x, https://si.imgix.net/b669297b/uploads/origins/0b4d2a69-3770-4e05-a437-a174d1221ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd818355340b5d5997357b2631a06bdf 3x"}, "body": "こんにちは！こちらは私のOC二人です。以下がご依頼したい内容になります。参考にしていただければ幸いです。金額にご不便な点がございましたら、どうぞお気軽にご調整ください。\n\n描いてほしいシーン：\n\n姉が徐々に家族の支配から離れ、より華やかで輝かしい生活を手に入れていく一方で、妹は苦しみに苛まれ続けている…そんな対比が描かれたシーンが見てみたいです。妹が姉の腕を掴みながら、こんな言葉を投げかけるような場面が理想です：\n\n「あんたが私をこの地獄に連れ込んだのに、どうして何食わぬ顔で私を置き去りにできるの？」\n\nという感じの、妹の怨念と姉への問いかけが込められた一枚をぜひお願いしたいです。\n\nhttps://1drv.ms/f/c/052908CB7828A72E/IgBvF09MtwZjR7ZWtlR7yPWMASTzMGxlgX4ekH0D2M02F0w", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@orange1140/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3516528, "client_id": 2326632, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2603f614/uploads/origins/199f8ced-b153-49d2-ac01-a9400498638d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04ae5b670b4921de2b28752fe38bfee2", "srcset": "https://si.imgix.net/2603f614/uploads/origins/199f8ced-b153-49d2-ac01-a9400498638d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04ae5b670b4921de2b28752fe38bfee2, https://si.imgix.net/2603f614/uploads/origins/199f8ced-b153-49d2-ac01-a9400498638d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e8d6ef5111d180627d94bed5fbdbf3a 2x, https://si.imgix.net/2603f614/uploads/origins/199f8ced-b153-49d2-ac01-a9400498638d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f9b2a2bb768bcaa0d5c692c9bd325ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2603f614/uploads/origins/199f8ced-b153-49d2-ac01-a9400498638d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=006187f75649697e5412e8180132e757", "srcset": "https://si.imgix.net/2603f614/uploads/origins/199f8ced-b153-49d2-ac01-a9400498638d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=006187f75649697e5412e8180132e757, https://si.imgix.net/2603f614/uploads/origins/199f8ced-b153-49d2-ac01-a9400498638d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=02e3a0617c54ca55149afd3e76120577 2x, https://si.imgix.net/2603f614/uploads/origins/199f8ced-b153-49d2-ac01-a9400498638d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6812fb0e9dbccf10bffa5b16ff32cfd2 3x"}, "body": "おらんじ様\nはじめまして。Skebで新しく公開された漫画を拝見し、そのコマ割りや、キャラクターの個性に合った表情が強く印象に残りました。もしご縁がありましたら、うちの子二人を描いていただきたく、リクエストさせていただきました。\n【キャラクターについて】\n・オフィーリア\n元気いっぱいで、天然系のお姫様です。周囲に友達がおらず、寂しい環境で育ちました。いつも鏡越しにセツナの姿を眺め、彼女の自由な暮らしに憧れていました。\nセツナが落ち込んだときには、オフィーリアは夢を通じて励ましていました。けれど、セツナにはその姿が見えず、夢の中で誰かがいつも傍にいてくれることだけは分かっていました。その後、オフィーリアがセツナの世界へやって来て、二歳違いの二人はとても仲のよい友達になりました。\n\n・セツナ\n物静かな高校一年生です。髪を結んでいるせいで運動部系だと思われがちなのですが、実際は運動が苦手で、どちらかというと頭脳派です。\nセツナも友達はあまり多くありませんが、オフィーリアがずっと傍にいてくれたため、寂しさを感じたことはありません。\nオフィーリアはうっかりしたところがあるので、セツナがいつもフォローしてカバーしている、という関係性です。本来は年上のお姉さんであるはずのオフィーリアの方が妹分に世話を焼かれている、そのギャップが二人らしさだと思っております。\n\n【リクエスト内容】\n二人で買い物をしたり、一緒にクレープを食べたりする、女の子同士の楽しいやり取りを描いていただけましたら嬉しいです。\n\n【使用用途】\n個人鑑賞を予定しております。\nご自由に描いていただいて大丈夫です。\n金額が不足している場合は、再送をお願いいたします。\nご検討のほど、よろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/1bl5_JeTIDlhknPefZL5xZLm-8Q4Ix-o2?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@orange1140/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3516528, "client_id": 1291989, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9fcb5311/uploads/origins/c4ea2ba8-6fb7-496e-aa87-2e8cd7a14cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb2dbc69cb82df8171821221664a743c", "srcset": "https://si.imgix.net/9fcb5311/uploads/origins/c4ea2ba8-6fb7-496e-aa87-2e8cd7a14cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb2dbc69cb82df8171821221664a743c, https://si.imgix.net/9fcb5311/uploads/origins/c4ea2ba8-6fb7-496e-aa87-2e8cd7a14cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2888874a877e2edb09d564ac0ab17ed 2x, https://si.imgix.net/9fcb5311/uploads/origins/c4ea2ba8-6fb7-496e-aa87-2e8cd7a14cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5553c8d14ae16158d1e376e059e77d42 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9fcb5311/uploads/origins/c4ea2ba8-6fb7-496e-aa87-2e8cd7a14cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27818e24c9828b57ffe9bb0fd34c1d71", "srcset": "https://si.imgix.net/9fcb5311/uploads/origins/c4ea2ba8-6fb7-496e-aa87-2e8cd7a14cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27818e24c9828b57ffe9bb0fd34c1d71, https://si.imgix.net/9fcb5311/uploads/origins/c4ea2ba8-6fb7-496e-aa87-2e8cd7a14cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=50d1845ccc9843f314ab4d4adcba4205 2x, https://si.imgix.net/9fcb5311/uploads/origins/c4ea2ba8-6fb7-496e-aa87-2e8cd7a14cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=579da7a5070b7f69eb8990e7ebdb573d 3x"}, "body": "はじめまして、先生の作品は素晴らしいです!!!!特に先生の絵のキャラクターへの理解と雰囲気が好きです！できれば私のキャラの漫画を先生に依頼したいです！\n彼らは終末世界の特殊な軍事施設で働く少年少女たちで、困難な任務を遂行する兵士たちです。本来なら夢を語る年齢であるはずなのに、すでに未来はありません\n\n————————————————————\n█キャラクター\n🐺ヘルメス(175cm):\n黒髪、灰青色の目\n兵士の中で一番強い。\n明るく、知的で、人気者。 明るくいい人に見えるが、実はかなりの悪党でエゴイスト。\n彼の欠点を挙げるとすれば、「人の弱さをうまく表現できないからこそ完璧すぎる」ということだろう。\n精神体（力が具現化した存在で、ペットとして扱うこともできる、また、オーナーの潜在意識も表している。）:しなやかな黒狼\n\n🐈アルテミス(162cm):\n金髪、緑色の目\n優等生で、よく笑顔を浮かべ、群衆の人気者、優しい高嶺の花。\n実は愛情表現が薄く、自分のことしか考えていない。\nアレースの現在のパートナー。管理に従わず処分されかけたアレースを救い、彼とコンビを組むことになった。\nかつてヘルメスと共に「聖所」で育ったが、ある理由で当時二人の関係は途絶えた。\n精神体:ゴールデンチンチラ・ブリティッシュロングヘア\n\n🐶アレース(175cm):\n深茶色の髪、青緑色の目\n外界から強制的にタワーに入れられ、その全てを嫌っている。迷惑そうな顔をすることが多い。\n不良少年の感じ、よく他人と対立したり喧嘩したりして怪我をする。体力は非常に強いですが、戦い方が無謀なのでよく怪我をします。\n実は、一度仲間と認めた相手を決して見捨てない、素直でいい子。\n甘いものが大好き。\n後天的に力に目覚めたため、普通の人間からガーディアンへと変わる際の拒絶反応にうまく適応できなかった。精神が敏感で、怒りやすい。\n彼は自分の力を制御するのが難しいため、任務中に刺激を受けて暴走してしまうことがあります。その際には、パートナーであるアルテミスが精神的なケアを行い、さらにその後、安定剤の注射を行う必要があります。\n精神体:片方の耳が立っていない犬 (彼が普通の兵士たちから差別されていたため、「野良犬」という軽蔑的なあだ名を付けられたこともあります。)\n\n🥼ホペリクス(180cm):\n白髪、水色の目\n軍医。\n軍の特殊機関で軍医、研究員として働いていた。\nとても細いです。いつ倒れてもおかしくない印象。\nいつも疲れた顔をしていて、人に心を見せず、笑わない。\n事故で顔の右側と右半身に大やけどを負い、右腕は右手の甲まで、肩は顔の右側まで、背中の右側にも傷がある。\n右足も負傷したままで、普段はカスタマイズした杖をついて歩く必要がある。\n純白のフェレットを飼っている。\n他人に心を見せず、笑顔を浮かべることもない。大切な人を失い、よく悪夢を見る。\n彼はすべてを失った男、哀れな男だった。愛を知り、愛を得、そして愛を失った。愛した人の死は自分のせいではなく、それでも他人を憎むことはできず、ただ自分を憎み、後悔と苦しみの中で永遠に生きるしかなかった。\n精神体:純白のフェレット\n\n🖥️主母(マイア):\n薄いピンクの髪、ピンクの目、瞳には渦巻き模様がある\n特殊軍事組織のすべてを支配する存在。20歳の女性の外見をしており、兵士たちには“母親”的な存在としても見られている。外見は優しそうだが、実際は恐ろしく残忍な存在。でも、疑いようもなく、彼女は自分の愛するすべてを愛している。\n本体は最高級のAI。\n彼女は大多数の人間を「管理可能なデータと資源」と見なし、駒やアルゴリズムの一部と考える。しかし、ヘルメスだけは彼女の予測アルゴリズムの外に飛び出した変数であり、まるで「奇跡」のような存在だ。（内戦が勃発し、ヘルメスの手で消滅した。）\n※服装に関しては特に固定したものはないので、資料に基づいて自由に描いてください。研究者風の服装、私服、AIっぽい服装など何でもOKです！\n\n登場人物の人間関係についてはリンク先の情報をご覧ください！\n————————————————————\nお好きなキャラクターやカップリングを選んで自由に描いてください！\n\n普段の様子やキャラクターの内面的な考え（陰鬱な感じ）など、どちらでも大丈夫です！重い描写や過激な描写も全く問題ありません！キャラクタープロフィールを元に自由に作ってください\n\n衣装や構図など全てお任せします。マンガの小ネタ、台詞、セリフの変化、なんでも自由に作ってください！自由に描いて頂けると嬉しいです！\n可能であれば、別レイヤーにサインを入れたpsdファイルをお願いします。\nもし可能でしたら、吹き出しと漫画の絵は別のレイヤーにしていただけると助かります！感想を書いていただけると嬉しいです! 先生のアイデアや構想を見ることができたら、とても嬉しいです\nお忙しい中、ご覧いただきありがとうございます。お引き受けいただけると幸いです。\n\nこの依頼がお気に召さない場合は、遠慮なくキャンセルしてください。\n\nhttps://drive.google.com/drive/folders/1WMjT4kZbfu2KiN4S9qhKD00rm9XR0ode?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@orange1140/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3516528, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/065ed303/uploads/origins/6823f807-198b-4eeb-ab6b-6202ace4a338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9855edc57a24d07b87958dad5d9d7158", "srcset": "https://si.imgix.net/065ed303/uploads/origins/6823f807-198b-4eeb-ab6b-6202ace4a338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9855edc57a24d07b87958dad5d9d7158, https://si.imgix.net/065ed303/uploads/origins/6823f807-198b-4eeb-ab6b-6202ace4a338?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f97cc26aee84f413a5f6a2f87ad90d36 2x, https://si.imgix.net/065ed303/uploads/origins/6823f807-198b-4eeb-ab6b-6202ace4a338?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4ddffbf28dd134040108af2cefb144e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/065ed303/uploads/origins/6823f807-198b-4eeb-ab6b-6202ace4a338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1665710eb9bfdbb2a24c396636b9304b", "srcset": "https://si.imgix.net/065ed303/uploads/origins/6823f807-198b-4eeb-ab6b-6202ace4a338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1665710eb9bfdbb2a24c396636b9304b, https://si.imgix.net/065ed303/uploads/origins/6823f807-198b-4eeb-ab6b-6202ace4a338?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d82c53018a994a8d13432217f896eaf7 2x, https://si.imgix.net/065ed303/uploads/origins/6823f807-198b-4eeb-ab6b-6202ace4a338?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d627fcf26fd9e9d9a0d8076231405e8 3x"}, "body": "はじめまして！以前からおらんじ様の漫画が大好きで、コマ割りや言葉選びのセンスにいつも惹かれています。ぜひおらんじ様に私のOCの漫画をお願いしたいと思い、このたびリクエストを送らせていただきました。\n\n二人の関係性や性格が伝わる内容でしたらシチュエーション、服装などはすべてお任せいたします！複雑な服装については簡略化していただいても大丈夫です◎\n\n日常シーン、戦闘シーン、感情メイン、ドライブ内にない捏造シーンなど、なんでも大歓迎です。お好きな雰囲気で自由に描いていただけましたら幸いです。\n\nNG：女体化、パロディ（if世界線のようなもの）\n\n使用用途はSNSへの掲載および個人での鑑賞を予定しております。自作発言は一切いたしません。\n\n金額や内容などにご都合の悪い点がございましたら、再送またはキャンセルしていただいて問題ございません。\n\nご検討いただけましたら幸いです！どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1A9K7EfkmagHsU3kQ_O3hdMnxbu3b2VUp", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@orange1140/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3516528, "client_id": 1836395, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28287099/uploads/origins/d8f5dcee-e8cc-451a-ba11-59d55184c137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=888c74cb72bec4b0d9c1d03bb23fdae5", "srcset": "https://si.imgix.net/28287099/uploads/origins/d8f5dcee-e8cc-451a-ba11-59d55184c137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=888c74cb72bec4b0d9c1d03bb23fdae5, https://si.imgix.net/28287099/uploads/origins/d8f5dcee-e8cc-451a-ba11-59d55184c137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec8537c2c209f5481112bdea63aa6731 2x, https://si.imgix.net/28287099/uploads/origins/d8f5dcee-e8cc-451a-ba11-59d55184c137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=850342b96a11985c76b0c0fd3608d0e3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28287099/uploads/origins/d8f5dcee-e8cc-451a-ba11-59d55184c137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a821fd7e0f0b4b7bdd1e0b3aa881854", "srcset": "https://si.imgix.net/28287099/uploads/origins/d8f5dcee-e8cc-451a-ba11-59d55184c137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a821fd7e0f0b4b7bdd1e0b3aa881854, https://si.imgix.net/28287099/uploads/origins/d8f5dcee-e8cc-451a-ba11-59d55184c137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c80dc5ed366c7f5a9a04d8acab88a9a 2x, https://si.imgix.net/28287099/uploads/origins/d8f5dcee-e8cc-451a-ba11-59d55184c137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8f7668d26724a18d3bc9314ff751e6ea 3x"}, "body": "おらんじ様\n\nはじめまして。Xでお見かけした百合コミックが素敵で、是非リクエストさせていただきたく思いました。\nもし現在skeb募集されていない…等でしたら読まずにキャンセルしてしまってください。\n\nTRPGのうちよそ（OC）イラストをお願いしたいです。御相手様の許可は取っております。\n\n【キャラ概要】  \n\n・吉野/166cm/女性\nいつも優しい微笑を浮かべている。真面目で頑固で負けず嫌いな努力家だが、たまに天然。思ったことは何でも火の玉ドストレートで言う。\nあまり感情を表情には出さないが、言葉やスキンシップで愛を伝えることは多い。意外と嫉妬するタイプ。\n\n・津波 栞/146cm/女性\n元気で人懐っこい。とても素直で嘘が下手、全てが表情に出るタイプ。\n調子が良く甘え上手。何かとカッコつけたがりだが大体うまくいかず、情けないことになっている。\n吉野のことが大好き。\n\n\n【資料】 \nhttps://drive.google.com/drive/folders/1Uyq711Rdl0meoBWRqC6__MRB0Gv6vhA6\n\n\n【構図等】\n恋人らしい雰囲気、というより友人の延長線のような、お互い必要以上に意識せず楽しそうな表情をしているものを希望します。おらんじ様の描かれるキャラクターの笑顔がとても可愛かったので、是非笑っているキャラクターを描いていただきたいです…！\n服装等はご自由に描いていただいて構いません。\n\n\n長文となり失礼しました。以上となります。不都合がございましたら再送・キャンセルしてください。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Uyq711Rdl0meoBWRqC6__MRB0Gv6vhA6", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 328140, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "となか", "screen_name": "kuroiidononaka", "avatar_url": "https://pbs.twimg.com/profile_images/1613888856918745093/FyJ5aGmm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/110496148380330803