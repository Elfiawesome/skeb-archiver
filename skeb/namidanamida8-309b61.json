わせてください\nお名前とアカウント名は明記します\nhttps://www.pixiv.net/novel/show.php?id=13105392\n\nアレンジ歓迎\n不明点や詳細おまかせ\n\n※幽霊の彼方（体が半ば透けてる）も描いていただければ嬉しいですが、お値段的に厳しければ遥一人で全然大丈夫です！\n\nご縁がございましたらよろしくお願いします", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 346772, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🎀銀座ラッキョ寿司🎀", "screen_name": "15_muwi", "avatar_url": "https://pbs.twimg.com/profile_images/2066878138433601536/3tkqKHbS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3021927816/1781617629/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 576850, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🧁ミズガルズXV🧁", "screen_name": "_etoriaka_", "avatar_url": "https://pbs.twimg.com/profile_images/1722902326271475712/XC9nQdU7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/828187843038097409/1635083419/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 1686210, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "yoni/よに", "screen_name": "yoni_bixid", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:dycivmpnup56b4wsosvkwqls/bafkreiasoj6jowwpjh2jqe7mo74zawgvipynapu2iamg4kljhjjkvf3u3u", "header_url": "https://cdn.bsky.app/img/banner/plain/did:plc:dycivmpnup56b4wsosvkwqls/bafkreicehj2ml4beo5xyiwtdiujwztw7kjimaqzb7g7rlwfpnu3xqwf3my", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "fi