ところは雰囲気でお願いします…！\n\n複数人の方が描きやすいようであればうちの牧場主(肌8、髪24、装飾28)を使ってください。大体なんでもする里崎です。服は大体なんでも着ます。\n\n資料として公式wikiと牧場主を送ります。\nhttps://stardewvalleywiki.com/Shane\n\nhttps://www.pixiv.net/artworks/128994191\n\nhttps://stardewvalleywiki.com/Shane", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pqas_ou/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3172058, "client_id": 3024290, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f1d5d6b/uploads/origins/65dd1cf9-7e88-4bd7-9ceb-9ed1163e8618?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e918cdf532e62cee2eecf102ccea09ac", "srcset": "https://si.imgix.net/4f1d5d6b/uploads/origins/65dd1cf9-7e88-4bd7-9ceb-9ed1163e8618?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e918cdf532e62cee2eecf102ccea09ac, https://si.imgix.net/4f1d5d6b/uploads/origins/65dd1cf9-7e88-4bd7-9ceb-9ed1163e8618?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=727c61cb0ad48f61755d4f74154396f6 2x, https://si.imgix.net/4f1d5d6b/uploads/origins/65dd1cf9-7e88-4bd7-9ceb-9ed1163e8618?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a170bcef9ab1baa47ede5951bb15aa1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f1d5d6b/uploads/origins/65dd1cf9-7e88-4bd7-9ceb-9ed1163e8618?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5ed8d147c95126d037168a5f4f7d2fa", "srcset": "https://si.imgix.net/4f1d5d6b/uploads/origins/65dd1cf9-7e88-4bd7-9ceb-9ed1163e8618?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5ed8d147c95126d037168a5f4f7d2fa, https://si.imgix.net/4f1d5d6b/uploads/origins/65dd1cf9-7e88-4bd7-9ceb-9ed1163e8618?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&bl