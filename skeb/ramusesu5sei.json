eport_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@ramusesu5sei/works/73", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 841417, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1736106b/uploads/origins/58b774c3-aecd-4fe7-8896-128d8e546968?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0237210534f4913ca41bdc62867e9f84", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1736106b/uploads/origins/58b774c3-aecd-4fe7-8896-128d8e546968?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a11b9b3e8c89be16ba708bd52ee3064a", "src_set": ""}, "body": "依頼させていただきます。\n\nメガネを掛けた冴えない青年が真夜中のシャッター商店街で女性に出逢う。\nすると女性が11m級に巨大化し、逃げ場が無くなった青年はその足で踏み潰され、ギャグ漫画みたいに紙のようにペラペラになる。\n↓\nその後女性は元のサイズに戻る。青年だった物は女性に頭を掴まれヒラヒラとされ、その後放り投げられ真夜中の空に飛んでいった…\n\n女性　イメージ\n◯30歳ぐらい\n◯黒髪の長髪\n◯八尺様みたいな白いドレス\n◯裸足\n\n青年　イメージ　\n◯紺碧色のシャツ、黒のズボン\n◯黒髪のボサボサヘアー\n◯眼鏡(四角い形)\n資料\nhttps://x.com/tz_tech/status/538614035315310592\n\nhttps://twitter.com/some_one11/status/536080741520515072?t=FXSqPgNaH56On1KJ8QQAEg&s=19\n\nhttps://x.com/tka24/status/551190347838009345\n\nご検討よろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ramusesu5sei/works/72", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bcc0dbbb/uploads/origins/8c151a45-2c5b-4182-81db-791e2c90903e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7db89912c7d08fbf0d95b4b80586d51", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 841417, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ramusesu5sei/works/71", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 841417, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0cbc613e/uploads/origins/9f07ee8f-a8a8-488d-b3e7-b8b273f0dd21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dfcfb3636253edd4fbc005cd4b76146", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0cbc613e/uploads/origins/9f07ee8f-a8a8-488d-b3e7-b8b273f0dd21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9303e84f38af4ec7f5f819b53f755209", "src_set": ""}, "body": "こんにちは、今日も元気にお過ごしでしょうか！\n\nプリンセスコネクトのきゃるが、夏服の巨女に変身！ https://drive.google.com/drive/folders/1xev8ePR0CKr_2iote1lv-PEb1zYUhJXm?usp=drive_link\n\nそして、タイニーはいつものOCの裸です。https://drive.google.com/drive/folders/1zSUPdel-36OqBmwSUodAzlwEtmLJ--os?usp=drive_link\n\n彼女は開いた口を見せ、そして小さなコマで小さな子を飲み込むだろう: https://drive.google.com/drive/folders/1dG7h2V2pLGnq7hIY8ISqW_-lrWm5dfb5?usp=drive_link\n\nそしてメインの絵は、胃の中でオナニーしているタイニーをX線写真で見ながら、タイニーを食べた後にオナニーしている彼女だ。https://drive.google.com/drive/folders/1dOEcNAEo1lWikVYF0FIjN4D9_HIpyNDs?usp=drive_link\n\n可能であれば、タイニーと巨女の両方が射精している差分を追加する。\n\n本当にありがとうございました！", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ramusesu5sei/works/70", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 841417, "client_id": 2926923, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/adab3194/uploads/origins/ca6f03bf-6218-48b9-9159-99cdb1102daf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10ae8a34b64c8cec0a8b10dbea4335fb", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/adab3194/uploads/origins/ca6f03bf-6218-48b9-9159-99cdb1102daf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=add8a135babc60ace416af8b15103631", "src_set": ""}, "body": "親愛なる先生、あなたの作品がとても好きです。リクエストを送りたいです！私は外国人で、日本語が上手ではないので、間違いがあったら本当にごめんなさい！自動翻訳ができると聞きました。お許しください！\n短い作品が描けたらいいなと思います。内容は、巨大な母、飲み込む、消化する、排泄する、が含まれています。フォフォフォのやつ（https://skeb.jp/@ramusesu5sei/works/62）みたいに。今回のヒロインは、『雪崩星空鉄道』（honkai:star rail）のスパークルを使いたいと思っています。 https://honkai-star-rail.fandom.com/wiki/Sparkle\n主に以下のようなシーンを入れたいと考えています（もちろん、全体としては飲み込み、消化し、排泄するという定番の枠組みを踏襲していればOKです！）。\nスパークルが悪役をナンパし、その悪役を媚びるような目で見る（彼女の一癖も二癖もある陽気な性格通り）、悪役がパニックになる。(悪役はパニックになる。）\nブロッサム・ファイヤーは巨大な口を開け、恐ろしい舌と喉を見せ、悪役を中に送り込む。\n悪役は胃の中に落ち、恐怖のあまり上に登ろうとするが、やはり胃液から逃れることはできず、上昇する胃液に溺れてしまう。(ここで外からスパークスが舌を出し、唇を舐めて満足げに見せると同時に、胃の中を分割画面にして悪役が消化される様子を映し出せればいいのだが）。\n排便パートについて：HANABIがトイレに来て、ズボンを下ろしてしゃがむ準備をし、同時に臭いオナラをする。 (排便が始まる前に、ヒロインがトイレに来るところと同じように、しゃがむ準備があればいいのに。『気づかずに丸吞みされてフルツアー』の19ページだったかな？)\n肛門が開いて便を排出するのだが、その便は太くて大きく、悪役の骨が入っている。スパークスは楽しげで歓喜に満ちた表情を見せ、ちょっとした邪悪さと狂気さえ感じさせる。(できれば糞便のシーンは独占してほしい、いつも最も重要で魅力的な部分なのだから）。\n最後に、フラワーファイアは満足げに排便を終え、カメラはついに便器に大きな糞の山を映し出し、悪役のバッドエンドを象徴する・・・・・・。\n\nもし間違いがあったり、わかりにくい訳があったら、わかるようにプレイしてください！ご迷惑をおかけしたなら、お詫びします！本当にありがとうございます！あなたの作品を楽しみにしています！", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ramusesu5sei/works/69", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 841417, "client_id": 1795103, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a809ea3/uploads/origins/c716a09e-8fd1-40ba-88ac-e34ca9080771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=806e2ea0abbb25884739c8abffcfd33e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a809ea3/uploads/origins/c716a09e-8fd1-40ba-88ac-e34ca9080771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b31ae08aaee1af6be0dfd9730df9748b", "src_set": ""}, "body": "ジャイアンテス：風すみれ【墜落：スタードーム鉄道\nタイニー：神風嵐【私のオーク\n指名の対象は、【神風嵐】が【風すみれ】の足元にいる足元シーンで、【風すみれ】の足元に関する様々な差異が含まれている：\n1.風すみれ】は靴を履いており、【神風嵐】は靴を履いている。\n2.【風すみれ】は靴を履かず、靴下を履いており、【神風嵐】は靴下の中にいる。\n3.裸足\n4.[1][2][3]を含むNSFWバージョン\n追記：私のOCは青い固体エネルギーでできたエネルギー生命体で、砕けると青い液体エネルギーがにじみ出る。\n\n参考\n[風のコーディアル] https://drive.google.com/drive/mobile/folders/1BIkcfgJzCWMsCP9E6qLGmgG5wrrgbK44/1qXzwV1lo6b_Ktn8_Gk5HC4qmdhz3pJZR?usp=share_link&sort=15&direction=d\n\n[Kamikaze Arashi] https://x.com/shenfengxiaren1/status/1915067842149695698?s=19", "nc": 35, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ramusesu5sei/works/68", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 841417, "client_id": 1995561, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80a058d0/uploads/origins/2626c5d4-c2da-4e6c-a17b-a6b3dd8e15b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b942b7ad2810700c72baa1d526fa2fa", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80a058d0/uploads/origins/2626c5d4-c2da-4e6c-a17b-a6b3dd8e15b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c20c398fd9f00fd63e2084b873af844f", "src_set": ""}, "body": "Hello I am looking for a shrunken character gets eaten art. This time it would be Trigger from Zzz eating a flustered, blushing, struggling tiny Belle from the same game with a cutaway of inside of her cramped/tight stomach. Preferably both are clothed. Other details are at your discretion. Thank you for your consideration!!\n\nhttps://imgchest.com/p/a846w5lzvyx", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ramusesu5sei/works/67", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/81af6671/uploads/origins/5af207e0-c1d8-4353-9188-556c0f21f287?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aba6a56c442485071d0adfc2a415a4da", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 841417, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 50, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ramusesu5sei/works/66", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c01f4110/uploads/origins/d756c277-2b9e-40fc-9720-2aa74ea15319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3df92efcc82b02687c29c1abcb384df", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 841417, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 34, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ramusesu5sei/works/65", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ca7eddf4/uploads/origins/c2e40819-217f-4683-9d80-edfc6a585ca4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8da90391a1a1e723104e93a401990d9b", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 841417, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ramusesu5sei/works/64", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 841417, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/286ca4fd/uploads/origins/4729745c-8960-49d8-a8f0-792c1f3bc890?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46fe2b3f06a10d58efc13a9dc9adf29f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/286ca4fd/uploads/origins/4729745c-8960-49d8-a8f0-792c1f3bc890?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdf8fe3076a8fd1614f1dddc86988411", "src_set": ""}, "body": "大体3ページ程度でお願いします。\n\n私の名前は李寅杰です。設定としては中国からの転校生にしてください。私は既に小さくされた状態で、桜さんの足元にいるところからストーリーを始めていただければと思います。桜さんが私を見下ろしながら、「中国からわざわざ転校してきた理由って、日本の女子高生の足を見るため？」や、「授業中に私の足をじっと見てたけど、そんなに興味があるの？」と嘲笑するセリフを入れてください。\n\nその後、「君の願いを叶えてあげる」と宣言し、「これから君を私の靴下の裏にある汚れにしてあげるね」と言いながら、汚れて臭い靴下をわざと見せつける場面を描いてください。また、学校で体力測定が必要という設定を加え、「体重測定をするから、君にも“協力”してもらうよ」と言い、私を体重計に乗せるシーンをお願いします。その際、「君は日本の女子高生のこんなに汚くて臭い靴下の下で死んで、粘つく汚れとして残るんだよ」と告げるセリフも加えてください。\n\n体重測定では、桜さんが靴下越しに私を押しつぶして体重を測り、数字が変化する様子を描いてください。体重計の数値は自由に設定していただいて構いません。その後、桜さんが「体重が全然減ってないね。きっと君が重すぎるせいだよ」と嘲笑し、体重計に残った汗と血の足跡を楽しむ場面を追加してください。体重計の惨状（汗、血、潰れた跡など）を詳細に描いていただけると嬉しいです。\n\n処刑シーンでは、桜さんの足指で私の頭をゆっくり潰す特写を希望します。頭が潰れる際に目玉が飛び出し、神経線が靴下越しに引き裂かれる様子をグロテスクに描写してください。その後、私の体が潰れ、汚れた靴下の裏に貼り付く描写をお願いします。\n\n最後に、桜さんが靴下の裏をわざと見せつけながら、「ほら、君はもう私の靴下の一部だね」と嘲笑するシーンを加えてください。そして、第1部や第2部の犠牲者たちと同じように、私も記念品として靴下の中に保存される場面をお願いします。靴下に私の名前を書き込む描写もぜひ入れていただきたいです。\n\nセリフはあくまで参考用ですので、具体的な内容は桜の元々の設定に沿って自由に調整していただければと思います。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ramusesu5sei/works/63", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 841417, "client_id": 1906330, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db67fffc/uploads/origins/4742fd00-a7a2-40d3-aa65-1377250a50b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f23aa61217156ae70eb1bfa4cc8e6da", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db67fffc/uploads/origins/4742fd00-a7a2-40d3-aa65-1377250a50b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1120d0fafb29e917c8ab36885ca359d", "src_set": ""}, "body": "久しぶりです アホ寺先生~\nいつも新作で楽しんでます\n最近の怪獣サイズイラストも 素晴らしかったです!\n私可愛い男の子香港の VTUBER 虎咪 (ふみ) です\n今回の依頼わ 新しい僕を 描きたいです \nカラ一でお願いします\n巨大な虎咪とチビメイト(ニビちゃん/カルアちゃん)\nたちと一緒に 町の中でお騒ぎ\n足で町おふみふみ破壊する 怪獣のようなサイズで\nお願いします ありがとうございます \n(ニビちゃん/カルアちゃん怪獣のようなサイズになって すごく可愛いと思う!!!)\n\nhttps://drive.google.com/drive/folders/1QnwZm3Wo87QbterGeOwrIhVxYdGpUibY?usp=drive_link", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ramusesu5sei/works/62", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 841417, "client_id": 2926923, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0d994d5/uploads/origins/ee820c7d-01d6-4183-9c12-cbf8b22e2f9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cea92dd48765a2481c583605efc703ce", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c0d994d5/uploads/origins/ee820c7d-01d6-4183-9c12-cbf8b22e2f9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=743c6db77c29b4bb2ce3808517b16e03", "src_set": ""}, "body": "親愛なる先生、こんにちは！先生のご活躍を拝見し、楽しませていただいています。skebを使ってリクエストを送れることを知ったので、やってみようと思っています。使い方が下手なので、間違いがあったらごめんなさい！私は外国人で、日本語が下手です。自動翻訳を有効にすることができると聞きました。お許しください！\n白黒の短い漫画を描きたいです。できれば2枚でお願いします。内容は巨大ニャンコ、飲み込み、脱糞などです。\nヒロインは『ワイプアウト 星空鉄道』のパチュリー（胡蝶／フォフォ）を使いたいです。\nhttps://honkai-star-rail.fandom.com/wiki/Huohuo\n\n前編：\nパチュリーは悪党を捕まえ、口を開き、その悪党を始末しようとする。犯人は怯える。\nその後、悪党はフィフィの胃の中に飲み込まれ、消化されるのを待つ。カメラは彼女の胃の中の様子を映し出す。大量の胃液が悪役を浸し、首まで浸水する。\n彼女はベッドに横たわり、愛らしい胃を見せつけながら、ゴボゴボと音を立てて眠る。\n翌日、勤務時間中に突然臭い屁を放つと、彼女は恥ずかしそうな表情を浮かべ、体内の便の呼び声を感じている。\n\nその2：\nフォフォフォはしゃがんで便意を催し、壺をお尻の下に置いた。太い便が肛門から出て、下の方は瓶の中に入っている。便の中には小人の骨が入っている。排便は熱と悪臭を伴っている。(可能であれば、このイメージを支配してほしい）（あなたの過去の類似作品のいくつかのように、視点は正面である）。\n排便が終わり、大量の糞が壺の中に入り、フォフォフォは少し恥ずかしそうに、悪い表情で自分の作品を見下ろしている。\n最後に、彼女は去り際に糞便の詰まった壺を棚の上に置く。その棚の上には、先ほど彼女がここに置いたのと同じ壺が、やはりすべて糞便で一杯になっており、彼女が犯罪者をトロフィーのように処分する作業の多くを終えたことを示している。\n\n脱糞の絵の構図は、あなたの以前の「沈黙の脱糞」や「瓶の中の小男の脱糞」のようになるかもしれない！あなたのスタイルに従ってください！\n\n間違いやわかりにくいところがあれば、適当に流してください！ご迷惑をおかけしたなら、お詫びさせてください！本当にありがとうございました！", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ramusesu5sei/works/61", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/93559e2c/uploads/origins/4a974706-f8b0-4861-a7ce-8a6ac508353f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0255365c08d35bb3ce2f9bd0f6a2226", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 841417, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 178, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ramusesu5sei/works/60", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 841417, "client_id": 75672, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f3b3e6b/uploads/origins/3381265a-07d4-4bd6-8982-a06706869835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=753b4de788e82c9d5a64490757fd11c1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f3b3e6b/uploads/origins/3381265a-07d4-4bd6-8982-a06706869835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b31deaefe5c22e14e5feae1f08c8922", "src_set": ""}, "body": "「瓶の中の小人に排便」のラッテちゃんのイラストのようなシチュで、\n怒ったニビにゃんが捕まえた侵入者の小人の少年を透明な容器の中に閉じ込めて、その中に容赦無く、たっぷり排便してうんち漬けにして殺処分してしまうモノクロイラストを、台詞と差分付きでお願いしたいです。\n\n出来ればうんちのシーンの前に、容器の中に排便直前の強烈な臭いのおならを何発も注ぎ込んで、小人の少年を虐めるシーンも描いて欲しいです。\n\n差分は可能であれば、\n1.おならをする前\n2.おなら責め\n3.うんち出始め\n4.うんちの下敷きになり埋もれてしまうところ\n5.容器の中がうんちでいっぱいになっているところ\nで5枚程欲しいですが、負担であればどこかを削ってもかまいません。\n\nおならの臭いで苦しむ小人の少年を蔑み、なじる台詞や、泣いて命乞いする小人の少年にうんち漬けにして殺すことを宣言する台詞など、\n初めは怒り気味に、だんだん少年を排泄物で嫐ることを楽しむ感じの台詞があると嬉しいです。\n\nその他、構図などはお任せします。\nよろしくお願いします。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ramusesu5sei/works/59", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/64e69a66/uploads/origins/86a0e7eb-706e-4a0a-bbc9-84151a0624a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d66a1093b2cf3941a39006217708e16", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 841417, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 51, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ramusesu5sei/works/58", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ad6042d9/uploads/origins/354d1956-b11a-4a51-8d0a-bd32aaa2d64f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b58e8b7e8cc68c93ac9dc7eabe8709f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 841417, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 162, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ramusesu5sei/works/57", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/856af7b9/uploads/origins/8a718e86-1a1a-498c-8cda-acd60059c466?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=724998d7e1e82e6be0b3631e544335f8", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 841417, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 178, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ramusesu5sei/works/56", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0df6af66/uploads/origins/cfaa5f60-a7b7-48c7-8ff6-9d8ff2838c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67b79fe0e9f423b94031163b4839e922", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 841417, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 178, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ramusesu5sei/works/55", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 841417, "client_id": 69317, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb422ea4/uploads/origins/e9a88a11-2726-4901-8303-610e78704f5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7a6d927f4c7c98dd701e4da1fe8f3d5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb422ea4/uploads/origins/e9a88a11-2726-4901-8303-610e78704f5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a56f2697c88636446f9c4d06c9c8c136", "src_set": ""}, "body": "こんにちは．またお願いします。\n\n【人物】 FGO\nニトクリス(キャスター、第1再臨)\n小さくされたマスター(男、ニトクリスの靴のヒールと同じ高さ)\n\n【シチュエーション】\n魔術でマスターを小さくして、自分の凄さを見せつけようとするニトクリス。\n\n① 小さくされたマスターは、遥かに大きいニトクリスを見上げている。ニトクリスはしゃがみ込んで、マスターを見下ろしている。表情は誇らしげ。\n「その大きさで、私に触れられますかマスター」\n↓\nマスター礼装で大ジャンプをして、ニトクリスの股間にしがみつく。\nニトクリスは恥ずかしがりながら、放尿する。\n\nモノクロマンガ形式(セリフあり)でお願いします。\nマスターのセリフもあると嬉しいです。\n\n\n参考図\n① https://www.pixiv.net/artworks/93446535\n↑の1コマ目のような、ローアングルでお願いします\n\nhttps://www.pixiv.net/artworks/93446535", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ramusesu5sei/works/54", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5a72c2fa/uploads/origins/747209e4-24f6-46a8-8557-c352c3da040d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7dbad20d076ffb20060359b1c7a1ce36", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 841417, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 50, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ramusesu5sei/works/53", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/163897a5/uploads/origins/e7b0862f-312b-47eb-9325-488921e8f749?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b6b2adc61be13124406f1fe34fda131", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 841417, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 178, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ramusesu5sei/works/52", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 841417, "client_id": 503632, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ce3cd7d/uploads/origins/d4b0c141-60f0-4b91-a022-9402ba760420?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5cdf98a3533e1127865ab4d42ec692b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ce3cd7d/uploads/origins/d4b0c141-60f0-4b91-a022-9402ba760420?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41e5c4c52f50b44ae78a18f0b77ad984", "src_set": ""}, "body": "お久しぶりです！大変おまたせ致しました！前回の中津さんの続きをリクエストさせていただきます！\n\n前回の続きで中津さんは自分の両足裏を代表の小人2人に登らせて競争させます。(右足側に女子・左足側に男子)中津さんは足を揺らしたり、突いたりして妨害します。やがて右足側の女子が先に親指の頂上に到着したのを確認すると、褒美として自分の胸の谷間に挟み、左足側の男子を大勢が避難している足跡の中に落とします。そしてそのまま中津さんは足跡の中に自分の足をはめ込み小人達を踏み潰して、次の退屈凌ぎへと向かう所までを描いていただきたいと思います。\n構図やセリフ等は前回同様おまかせ致します。\n何卒忙しいとは思いますがご検討のほどよろしくお願い致します。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ramusesu5sei/works/51", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 841417, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/008fafb7/uploads/origins/2bd433a4-0230-46c2-91e7-04e50031bccb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3605ab8bf0253de5fe08b758432a4796", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/008fafb7/uploads/origins/2bd433a4-0230-46c2-91e7-04e50031bccb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b82a2778f74071edab29d02b7c4a65d5", "src_set": ""}, "body": "FGOからエウリュアレとマシュのカラーイラストをリクエストさせていただきます。\n\n小さくされてしまったマシュをエウリュアレは素足で踏み潰そうとする。マシュは踏み潰されまいと、巨大なエウリュアレの素足を両手で支えて必死に耐えるという内容でお願いします。\n\n細かいリクエストとしては、マシュは片目と口を閉じて必死そうな表情かつ腕が少し曲がっている内股で中腰の姿勢で、エウリュアレは余裕な感じが出ている不適な笑みを浮かべた表情かつ腰に手を当てた姿勢でお願いします。また、マシュの四肢とエウリュアレの素足が震えてるように描いて欲しいです。\n\n要望が少し多いですが、どうかよろしくお願いします。", "nc": 34, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ramusesu5sei/works/50", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 841417, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3464c913/uploads/origins/7fc6eef8-5bb3-410e-bffd-83ea69e55aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f48a741532fa642c9be30e075995ff12", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3464c913/uploads/origins/7fc6eef8-5bb3-410e-bffd-83ea69e55aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f05b71ddb2c140c138f6f0128c4c6d9d", "src_set": ""}, "body": "ブルーアーカイブのゲーム部でカラー漫画１Pのリクエストをお願いします。\n\n１コマ目：小さくなってしまったアリスとモモイとミドリは、自分達の所に近づいてくるユズに助けを求めるが、ユズは寝ぼけているのかアリス達に気づかず片目をこすりながら歩き続ける。\n２コマ目：ユズの素足がアリス達の真上まで来てしまい、モモイとミドリはアリスに抱きつきながら怯え、アリスは不安そうにしながらも覚悟を決めた顔をする。\n３コマ目：アリスはユズの巨大な素足を両手で受け止め、踏まれまいと必死に支えて抵抗する。ユズは違和感を感じるのかはてなを浮かべる。\n４コマ目：アリスはユズの巨大な素足に苦戦しており、両目を閉じた苦しそうな表情かつ中腰状態になってしまい、徐々に押し負けそうになる。\n\nなお３コマ目のアリスがユズの素足を両手で必死に支えるシーンですが、ユズの足裏が見えるようにかつそれを支えてるアリスを目立つように描いてほしいです。\nどうか、よろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ramusesu5sei/works/49", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 841417, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f28b0477/uploads/origins/a84db2a7-2d68-4403-b90b-15a3297fc0d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b7524fc1bef884cfbaf539a33b1239c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f28b0477/uploads/origins/a84db2a7-2d68-4403-b90b-15a3297fc0d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd5eab18f1c74bceae02e9d357cc83a9", "src_set": ""}, "body": "はじめまして。依頼させていただきます。\n\n突然男子高校生が25センチ程に小さくされる。道端で通りかかった女子学生に助けを求めるも、気付かれずにそのまま学生のスニーカーに踏み潰され、ギャグ漫画みたいに紙のようにペラペラになる。彼はこの先、スニーカーにへばり付くガムとして生きていく事になる…\n\n女子学生\n◯20歳ぐらい\n◯黒髪のセミロングボブ\n◯スニーカーを履いてる\n\n男子高校生\n◯黒の学ラン\n◯黒髪のショート\n◯真面目そうな顔、若干ツリ目\n◯眼鏡(四角い形)\n\nご検討よろしくお願いします。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ramusesu5sei/works/48", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 841417, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1a2d558/uploads/origins/e091740b-ab5a-4bcc-880c-023aecccef86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e9afdcd5e69f7c179ced25b1cccf2fe", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1a2d558/uploads/origins/e091740b-ab5a-4bcc-880c-023aecccef86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3383285674d42492105f84b35ea8c5c", "src_set": ""}, "body": "こんにちは、あなたの最近の作品が気に入ったので、同じような新作をお願いしたいのですが。\n\nこれと同じシナリオになります：\nhttps://skeb.jp/@ramusesu5sei/works/47\n\n巨女は以下のOCになります：\n\nhttps://drive.google.com/file/d/1WQCn33IZ3Ac5B_M46zMouXmPu_7Ywbcc/view?usp=sharing\n\nそして、ちっちゃいのはこれ：\n\nhttps://drive.google.com/file/d/1G8HpTMYobq53LPRh_sGMTp4qgjOPUyAn/view?usp=sharing\n\n巨人に飲み込まれる前に親指を立てるポーズができれば、前回のリクエストと同様だ。\n\nありがとうございました！", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ramusesu5sei/works/47", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 841417, "client_id": 1995561, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11f1e96c/uploads/origins/3a5c6d72-a239-4854-9e64-d19b60a7c5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4d25191401c6a67576b087b38273434", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11f1e96c/uploads/origins/3a5c6d72-a239-4854-9e64-d19b60a7c5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8149d2262a07f8fbae89e65ca26a1205", "src_set": ""}, "body": "Hello I am a big fan of your work. I want a scenario where one tiny mouse boy is plummeting into the girl's mouth while the girl is smug and streaming herself with a smart phone. If possible also a second picture of her screen with the stream chat and such with a now closed mouth. Thank  you for your consideration.\n\n\ngirl:  https://cdn.imgchest.com/files/l7lxc2dk2l7.png\nboy : https://cdn.imgchest.com/files/345xcw9lw57.png", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ramusesu5sei/works/46", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 841417, "client_id": 2455770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e81b5bed/uploads/origins/94b7defa-8916-4c2b-a0f3-e17a7c74fab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c08c19885360ffc5a8f298755d75f9f6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e81b5bed/uploads/origins/94b7defa-8916-4c2b-a0f3-e17a7c74fab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=396ecc57d8a5fa042bc3b332f7fc03f0", "src_set": ""}, "body": "リクエストお願いします。キャンセル、再送OKです。\n\n作品・キャラ\n\nはたらく細胞black \n\n白血球1196 \n\n被食者\n希望の外見は防護服とガスマスクですが難しい場合はモブ男性でOKです。\n\nシチュエーション(コマ)\n\n口内の色参考：https://livedoor.blogimg.jp/anico_bin/imgs/3/5/357c0873.jpg\n\n1\n構図参考：https://skeb.jp/@ramusesu5sei/works/44\n落ちている対象を睨みながら大量の涎が垂れる口を開けて待ち構えて丸吞みにしようとする1196。\n\n2\n右下(2コマ目)構図参考：https://skeb.jp/@ramusesu5sei/works/42\n被食者視点で口蓋垂辺りまで落ちており、閉じている前方に手を伸ばす。\nこちら(https://skeb.jp/@ramusesu5sei/works/42)と同じ血まみれ、開口版の差分も可能であればお願いします。\n\n3\n胃で消化され骨になった。可能であればその他にも食べられた人骨(人数はお任せします)をお願いします。体内の色は口内と同じ、胃液は透明。\n\nご検討宜しくお願い致します。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ramusesu5sei/works/45", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 841417, "client_id": 503632, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4464f2cc/uploads/origins/1bc4b717-1c88-4f9f-addf-6451afb413c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=112a7aed731a2e698e581bfe3ea0d6cc", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4464f2cc/uploads/origins/1bc4b717-1c88-4f9f-addf-6451afb413c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=628e487aa129dbb3a9c36aef7c462e88", "src_set": ""}, "body": "お久しぶりです！前回の続き(https://skeb.jp/@ramusesu5sei/works/40)を描いて頂きたくリクエストします！\n学校に到着した中津さんは運動場に巨大な足跡をつけてそこに生徒を避難するように促します。その直後に見せしめとして体育館や校舎を踏み潰していきます。足跡に避難した全校生徒に対し、中津さんは一部の生徒達を左足のサイズを計測するグループと右足の五本指に縄をつけて綱引き勝負させるグループに分けます。左足グループは計測後、中津さんに報告して手のひらで叩き潰されます。右足グループは必死に抵抗するも呆気なく持ち上げられ、そのまま口の中に入れられて丸呑みされます。足跡で怯える生徒達を前に両足裏を見せながら中津さんは次のゲームを思いつく。ここまでをお願いいたします。\n構図やセリフ等は前回同様おまかせ致します。\n何卒忙しいとは思いますが、ご検討のほどよろしくお願いいたします。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ramusesu5sei/works/44", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 841417, "client_id": 2455770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d758c96b/uploads/origins/3bc8394a-e7fe-475c-b31d-f8efe0ff7099?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=619f98076896d6a1fba88d2c5a8d6824", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d758c96b/uploads/origins/3bc8394a-e7fe-475c-b31d-f8efe0ff7099?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1798c569a5ef24563544f455abbbba88", "src_set": ""}, "body": "前回は素晴らしい作品を描いて頂きありがとうございました！またリクエストをお願いします。キャンセル、再送OKです。\n\n作品・キャラ\n\n魔都精兵のスレイブ：東風舞希\n\n被食者\n外見はモブ男性ですが腕だけでもOK。\n\nシチュエーション\n\n台詞は有り無しどちらでも構いません。\n\n1:落下している縮小化した被食者に大きく口を開けて待ち構える。\nこちら(https://www.pixiv.net/artworks/97883228)を右側から描いた様な構図と口内絵を描いて欲しいです。\n被食者はコマ外で腕だけ見えている感じでOK、コマの大きさは上半分です。\n可能であれば前作の様に大量の涎をお願いします。\n\n2:パクリと音を出して口を閉じる。\n\n3:ゴクリと音を出して吞み込んで喉が膨らむ。\n\n4(可能であればOK)：胃袋の中で消化されて骨だけになっている。\n\nご検討宜しくお願い致します。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 9886, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "👑ぽせき", "screen_name": "psk_sk3", "avatar_url": "https://pbs.twimg.com/profile_images/1938680489109549056/nw0TgP_z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/106787761/1755695794/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 48}, {"id": 151642, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "rakiA", "screen_name": "rakiA00309", "avatar_url": "https://pbs.twimg.com/profile_images/1727631414995378176/FycBJq4J.jpg", "header_url": null, "appeal_rece