d-200e854751d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7713541e42b157f7394dfc982af4ab3, https://si.imgix.net/17e76daa/uploads/origins/f5bdb7c2-ba1d-46ba-a88d-200e854751d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=30d1e6c59333b514e7323d185445c318 2x, https://si.imgix.net/17e76daa/uploads/origins/f5bdb7c2-ba1d-46ba-a88d-200e854751d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dbc82dc2f6c2c886693f8a2fe07f8a81 3x"}, "body": "skeb受付再開ありがとうございます。\nいつも尾花先生の作品を楽しませていただいております。\n今回も、先生の作品の「ふたりの円盤」のメインキャラ「ちぐさくんとかすみくん」の2人のイラストをリクエストさせていただきます。\n希望は以下の通りです。\n・可能なら通常頭身（デフォルメではない）\n・全体的に青系（水色系）\n・夏っぽくて爽やかで可愛い感じ\n・細かい描き込みがあると嬉しい\n\n服装構図等お任せしますが、描いていただいたイラストについては、個人鑑賞としてスマホ等の壁紙に利用したいなと考えております。\nご検討のほどよろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@seishoobi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2453618, "client_id": 505031, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/908f978f/uploads/origins/4db39146-e2c6-4076-bae5-9200b4d3d7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54aa7a3e5dcdf5dbe3c11c046421fbb3", "srcset": "https://si.imgix.net/908f978f/uploads/origins/4db39146-e2c6-4076-bae5-9200b4d3d7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54aa7a3e5dcdf5dbe3c11c046421fbb3, https://si.imgix.net/908f978f/uploads/origins/4db39146-e2c6-4076-bae5-9200b4d3d7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6096f9399fe6c0dbbadc8368fec5618 2x, https://si.imgix.net/908f978f/uploads/origins/4db39146-e2c6-4076-bae5-9200b4d3d7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89f00def753ccad97b4380f199d604af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/908f978f/uploads/origins/4db39146-e2c6-4076-bae5-9200b4d3d7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38c47ff75719887de2afa8342e8bcc9c", "srcset": "https://si.imgix.net/908f978f/uploads/origins/4db39146-e2c6-4076-bae5-9200b4d3d7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38c47ff75719887de2afa8342e8bcc9c, https://si.imgix.net/908f978f/uploads/origins/4db39146-e2c6-4076-bae5-9200b4d3d7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d15adb0757e3bd40e967a93a17eedae9 2x, https://si.imgix.net/908f978f/uploads/origins/4db39146-e2c6-4076-bae5-9200b4d3d7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ae846f1e749471ea7c0e4b647edfafc1 3x"}, "body": "おはようございます。\n今回はまんが絵のリクエストをお願いしたいと思いリクエスト送らせて頂きます！\n\nもしよければ私がTRPGで使用しているキャラクターのイラストを描いていただけたらと思っております。\n\n立ち絵、キャラクターデザインはUAPAMI(@upami_3)さんに描いて頂いたものです。\nキャラクターの外見については添付資料を確認して頂ければと思います。\n\n男性のキャラクターで、中学で美術の先生をしています。20代後半です。\n自分の作品も作っていて、心電図や心音をテーマに映像作品や立体の作品（インスタレーション）を主に制作しています。（私がクリスチャン・ボルタンスキーの「心臓音のアーカイブ」という作品が好きで、このキャラクターを作った際の元ネタです）\n見た目通り少し変わった人ですが、性格は素直で、誰とでも分け隔てなく接するタイプです。\n\n服装デザインは簡略化したり省略したりしていただいても構いません。\n個人用にポストカードサイズで印刷しようと思っているので、全身絵というよりは、イベントで出していらっしゃった色紙絵や、漫画の扉絵のような感じをイメージしておりますが、どちらでも嬉しいので、構図やポーズなどはお任せします！\n\n使用用途は、個人鑑賞(ポストカード）、SNSアイコン/ヘッダーなどで使用させて頂けたらと思っております。\n\nもし受けて頂けるようでしたらよろしくお願いいたします！\n\nhttps://www.dropbox.com/scl/fo/etmiyd2qadydgunmz1hdd/h?rlkey=avl9kj0vls87bbsxi6hb4u3p7&dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@seishoobi/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5697f79e/uploads/origins/60a8d702-a540-4478-9bf8-6327c61416e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77acb7