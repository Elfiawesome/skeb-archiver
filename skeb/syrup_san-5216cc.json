d4-9646-4f11-8ec9-596beb1143cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4da459ef6bd6942c315eb785b5b79914, https://si.imgix.net/4b3186e2/uploads/origins/6544f4d4-9646-4f11-8ec9-596beb1143cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=859fdb2e558a9cd2785f34a1534eadff 2x, https://si.imgix.net/4b3186e2/uploads/origins/6544f4d4-9646-4f11-8ec9-596beb1143cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3938fdb2e907f668c0108de72271928d 3x"}, "body": "こんにちは。私はずっと前からみつだむ様のイラストの大ファンです！この度リクエスト再開したのを見て、申し込みたいと思いました。みつだむ様のイラストの綺麗な色と線とシールの使い方が大好きです。\n\n私のキャラクター二人を描いていただけると嬉しいです。\n\n参考資料\n一人目：Karin\nhttps://www.dropbox.com/scl/fo/nn4ou5wb1pu9zsbkkgcpt/AAL0J5dAgQOP_T0_yowwKhU?rlkey=1kz2up9i08o442oy4au1mrknv&st=zcc28z5s&dl=0\n二人目：Chay\nhttps://www.dropbox.com/scl/fo/ufo0ey74g08mqgjrixm09/AIxN1PH52EZ0qxc6BGbzv0U?rlkey=8zk2rl9fllmm95tqq05xhazsx&st=99ilz18x&dl=0\n\nトレカデコの雰囲気で、お花、リボン、星の要素あったら嬉しいです〜\n衣装は自由でお願いします。二人は違う世界感の創作のキャラクターなのでくっついているより離れて個別にいる方が嬉しいです。\n\nSNSアイコン・ヘッダーなどで使いたいと思ってます。\nご検討のほど、よろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@syrup_san/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/746f7c0d/uploads/origins/bf1e331f-5ed7-452c-9541-829e50b33c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b42a1d788354b9b18e33a2e69c46f4a2", "srcset": "https://si.imgix.net/746f7c0d/uploads/origins/bf1e331f-5ed7-452c-9541-829e50b33c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b42a1d788354b9b18e33a2e69c46f4a2, https://si.imgix.net/746f7c0d/uploads/origins/bf1e331f-5ed7-452c-9541-829e50b33c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2