うとする野生児君に「行かないで‼︎」と追い縋るミラ。野生児君は、「俺に服従するか？」とミラが座っていた玉座に腰掛け問うと、「はい」と答え、その証として豊満な胸でパイズリをして、野生児君の巨チンに長い舌を使って奉仕し、出てきたザーメンを一滴も溢さず飲み込む。卵とミラを抱えた野生児君は、ダンジョンを後にし、魔族領へ戻るのでした。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2695, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "そるとん", "screen_name": "sorutonton", "avatar_url": "https://pbs.twimg.com/profile_images/1351857794715029504/zwhcvTe2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1351836712356335616/1611144585/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 176}, {"id": 127242, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "サンク 🔞C107本DLsiteで配信中", "screen_name": "ThAlter39o", "avatar_url": "https://pbs.twimg.com/profile_images/1555117556771725312/CMP6Uesh.png", "header_url": "https://pbs.twimg.com/profile_banners/1555115535083327488/1691391231/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 49}, {"id": 427458, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ぎろ🍗関けも L-05", "screen_name": "girokemo", "avatar_url": "https://pbs.twimg.com/profile_images/1641694904966578176/5g4zMoGb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/265375835/1529679626/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 80, "s