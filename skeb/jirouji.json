orks/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec1300a2/uploads/origins/8dd8a448-7957-42ec-b77d-e657a683e618?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78138a71937b3f14a594dbd7e748161d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec1300a2/uploads/origins/8dd8a448-7957-42ec-b77d-e657a683e618?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31e7c37edf3455e1d2a739798aa54dc2", "src_set": ""}, "body": "ナズーリン お願い!", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a355410/requests/251378_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d515619518670f7dc59c64e5f5551ca", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a355410/requests/251378_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b0844bdfd7386e15b51863c5ba77576", "src_set": ""}, "body": "ポケモン剣盾の戦闘態勢でキリッとしてるかっこいいサイトウちゃんをお願いします！！！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 62963, "client_id": 147120, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0548d4e8/requests/79237_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6260b92f237a493faff4ebc352a9a248", "src_set": ""}, "dura