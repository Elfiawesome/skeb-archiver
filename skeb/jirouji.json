lt_amount": 12000}, {"genre": "novel", "default_amount": 3000}, {"genre": "correction", "default_amount": 500}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@jirouji/works/31", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 446356, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/985b76ed/uploads/origins/8bcdc1f3-0075-4a3a-9e5c-6bded6493efd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea60edd3537fac0bb6996e15ca7ae938", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/985b76ed/uploads/origins/8bcdc1f3-0075-4a3a-9e5c-6bded6493efd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2683703c6d91701de42875fd714ac9ed", "src_set": ""}, "body": "はじめまして、\n\n・キャラは東方のナズーリン\n・表情は八の字眉で弱々しく恥ずかしがっている\n・構図は膝から上\n・服装は金ビキニと同素材同色の越中褌のみ(トップレス)\n\n※他の方の作品で申し訳ありませんが越中褌の資料です\nhttps://www.pixiv.net/artworks/92065910\n\n・越中褌の紐の結び目はおへその位置で締めている為前垂れは一般的な越中褌の半分位の長さになり股布が見えてしまっている\n・前垂れを上に引っ張り上げて結び目が見えている差分をお願い致します。\n\n金額に問題ありましたら再送要請して頂けましたら出来る限り対応させて頂きますのでご検討の程宜しくお願い致します。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/30", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ac0e975/uploads/origins/228b2084-9290-40f8-ba79-8697f2535419?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6afeb5c315f7c0f1ae412ddd00fed9dd", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ac0e975/uploads/origins/228b2084-9290-40f8-ba79-8697f2535419?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d615f3d636d7b7bc551d88769d4ef9fe", "src_set": ""}, "body": "こんにちは！\nいつも素敵なイラストをありがとうございます！\n最近とても暑くなってきましたね！\n次のリクエストなのですが、暑くて汗だくのナズーリンを描いていただけませんか？\n全てお任せします！\nありがとうございました！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/82094e57/uploads/origins/4a9c1356-0c7c-4e63-90bb-11681154fdb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=963415c144e10a23b2fa3c6247c40dad", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82094e57/uploads/origins/4a9c1356-0c7c-4e63-90bb-11681154fdb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2ef0895f32b2ac7d1dbaf96bdfbb1e2", "src_set": ""}, "body": "こんにちは、\nまたナズーリンがおいしいものを食べているところを描いてください！\nすべてお任せします！\nありがとうございました！\n\nHello,\nPlease draw Nazrin eating something tasty again!\nI'll leave everything up to you!\nThank you very much!", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 1804950, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e1cf7b8/uploads/origins/9157fec7-0857-4ace-80ff-6dc7d67214fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26b4b16343471e4c210fdefd6ecf6251", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e1cf7b8/uploads/origins/9157fec7-0857-4ace-80ff-6dc7d67214fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9479af5c5aa13d6a658af87fb7a1f114", "src_set": ""}, "body": "こんばんは。再送失礼します。\n今回はパワプロの入江真琴をお願いします。\n\nパワ体ではなく以前のイラストのようにリアル頭身でお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a25d3425/uploads/origins/deae6e49-99b4-4e81-a9cf-45141874c644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfcb6460a12fe3d6a682b54e3e1d180a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a25d3425/uploads/origins/deae6e49-99b4-4e81-a9cf-45141874c644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2012740cb7e1be8bf752cda95d371df", "src_set": ""}, "body": "こんにちは！\n小さくて露出度の高い水着やビキニを着せられて、恥ずかしがるナズーリンが見たいです！\nすべてお任せします！\nありがとうございました！\n\nHello!\nI would like to see a Nazrin who is wearing a cute swimsuit!\nI’ll leave everything up to you!\nThank you very much!", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7c569bd/uploads/origins/6d8c28ea-45b8-4cbd-9743-329153edbddd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54b205502a91c39a5d42cd82b8ec9d83", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7c569bd/uploads/origins/6d8c28ea-45b8-4cbd-9743-329153edbddd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e1937cac4e8cafdd4f5388d48494f32", "src_set": ""}, "body": "Hello, Thank you very much for your Nazrin illustration! It was very wonderful! For my next request, please draw Nazrin again however you wish! Thank you!  \n\nこんにちは、 ナズーリンのイラスト、ありがとうございました！ とても素晴らしかったです！ 次回のリクエストは、またお好きなようにナズーリンを描いてください！ ありがとうございました！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1ff6ac1/uploads/origins/bad1e859-e53f-4d72-8b07-1f96e791e7a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01c17dcc5a890b01e00a6182d1883fb5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1ff6ac1/uploads/origins/bad1e859-e53f-4d72-8b07-1f96e791e7a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a8c9bfbee9953dd7e9d8b9c4c3db34f", "src_set": ""}, "body": "こんにちは！ いつも素敵なナズーリンのイラストをありがとうございます！ 今回は、こんなテーマでお願いしたいと思います： ナズーリンのどこが一番好きですか？ ナズーリンの好きなところを強調して描いてほしいです！ 全てお任せします！ ありがとうございました！  \n\nHello! Thank you very much for your always wonderful Nazrin illustrations! For my request, I would like to ask you to draw this following theme!: What part of Nazrin do", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 1804950, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d725f6dc/uploads/origins/075a2c9b-8383-4de0-a996-c6d26079ed95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a76f856da9f1aac4f1b6453979f57d3c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d725f6dc/uploads/origins/075a2c9b-8383-4de0-a996-c6d26079ed95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0578fc124709248cbad258714b889721", "src_set": ""}, "body": "こんばんは。再送となりますがリクエストさせていただきます。\nキャラは実況パワフルサッカー(パワサカ)の碓氷ゆきの。以前のパワプロキャラのイラストのようにリアル頭身でお願いします。\n衣装はシンプルなスク水。胸元に「うすい」と苗字の書かれた白ゼッケンもありで。照れて少し恥ずかしそうな表情で背景はプール。構図はお任せします。\nよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fc92868/uploads/origins/9d38712b-9c2b-4ed3-a8c3-e3752873d6ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00f63102d9398c92e5fd5da28a3e6e7d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6fc92868/uploads/origins/9d38712b-9c2b-4ed3-a8c3-e3752873d6ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c2226ab64134b40f3365a7feb0091b1", "src_set": ""}, "body": "こんにちは、\n素晴らしいナズーリンのイラストをありがとう！\n次のリクエストなのですが、またナズーリンを描いていただけないでしょうか？\nナズーリンがもっと美味しいものを食べているシチュエーションが見たいです！\nお好きなように描いてください\nありがとうございました！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6889e49f/uploads/origins/54c17067-5317-488d-b0d3-14c8cd0e5de5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a7c49af85bd102ffef326c61cf4273a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6889e49f/uploads/origins/54c17067-5317-488d-b0d3-14c8cd0e5de5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80813f4186e4b12c08bfeb8d9313c4e7", "src_set": ""}, "body": "Hello,\nThank you very much for your Nazrin illustration!\nIt was very wonderful!\nFor my next request, please draw Nazrin again however you wish!\nThank you!\n\nこんにちは、\nナズーリンのイラスト、ありがとうございました！\nとても素晴らしかったです！\n次回のリクエストは、またお好きなようにナズーリンを描いてください！\nありがとうございました！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c6738b4/uploads/origins/0fbd4244-d2fa-46f1-bd91-6092d8a54a77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dfb88d89e492a37e1ff84d2c4e4cdf9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c6738b4/uploads/origins/0fbd4244-d2fa-46f1-bd91-6092d8a54a77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a287771aa84caf845caa1b2532bae9e0", "src_set": ""}, "body": "Hello! I hope you are doing well! For my request, can you please draw Nazrin enjoying a lot of Japanese sweets and/or snacks? I'll leave everything up to you! Thank you very much!  \n\nこんにちは！ お元気ですか？ リクエストなのですが、和菓子やお菓子をたくさん食べているナズーリンを描いていただけませんか？ 全てお任せします！ ありがとうございました！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 62963, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/58b7f58d/uploads/origins/5df9f8cc-f391-4450-8e00-29d9f54dd246?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3694631bc4ab62e629c4f6a73580ef08", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/58b7f58d/uploads/origins/5df9f8cc-f391-4450-8e00-29d9f54dd246?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c758051134cf519c8ee6f0ad46444a2c", "src_set": ""}, "body": "いつも可愛いイラストを見させていただいています……！\n\n東方Projectの秘封倶楽部（宇佐見蓮子・マエリベリー・ハーンの二人）を描いていただきたいです。\n服装は\"蓮台野夜行\"時のもので、全身が映っている構図だと嬉しいです！\nシチュエーションはおまかせいたします！\n\nよろしくお願いいたします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f787f84c/uploads/origins/77a62a32-d47d-4c31-a4e3-8352f544b239?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64923dc840801c553e4dcc3e1594e8b4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f787f84c/uploads/origins/77a62a32-d47d-4c31-a4e3-8352f544b239?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e5ff26a03207076e445e143765ab9ae", "src_set": ""}, "body": "Hello,\nThank you for your previous Nazrin illustration!\nFor my next request, can you please draw Nazrin eating something tasty?\nI'll leave everything up to you.\nThank you very much!\n\nこんにちは、\n前回のナズーリンイラストありがとうございました！\n次のリクエストは、ナズーリンがおいしそうに食べているところを描いていただけませんか？\n全てお任せします。\nありがとうございました！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84102712/uploads/origins/e7812974-a2fe-4193-a275-d6452137c968?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dac4213f804ab07f12a1725e2f190e4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84102712/uploads/origins/e7812974-a2fe-4193-a275-d6452137c968?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4163c05acb7828fec40339efe88801e1", "src_set": ""}, "body": "Hello 次郎次-san! Thank you always for your wonderful and beautiful Nazrin illustrations! For my request, please draw Nazrin again however you wish! I'll leave everything up to you! \n\n こんにちは、次郎次さん！ いつも素敵で美しいナズーリンのイラストをありがとうございます！ リクエストなのですが、また好きなようにナズーリンを描いてください！ 全てお任せします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fee65d6c/uploads/origins/5804b6f5-608a-4eb6-aa98-45a0f976d267?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08f81427de6330445f152e2443d8775e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fee65d6c/uploads/origins/5804b6f5-608a-4eb6-aa98-45a0f976d267?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fae86c77bdacc7a801c74f512f67095c", "src_set": ""}, "body": "素敵なナズーリンのイラストをありがとうございます!!!!\n次回のリクエストは、ナズーリンを好きなように描いてください!\n全てお任せします!", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e23023e7/uploads/origins/fc648d9b-3b29-4e99-8deb-1240cd77250e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5fb7a630075ede82ef5ec5c0a67d570", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e23023e7/uploads/origins/fc648d9b-3b29-4e99-8deb-1240cd77250e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0006b34c161e80f7c8c7d438eb3d0f29", "src_set": ""}, "body": "Hello, please draw Nazrin however you wish!\n\nこんにちは！ナズーリンを好きなように描いてください。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 62963, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70555f09/uploads/origins/8e2804b9-a293-465c-bd16-7d3eeeb29607?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b416440f4583ef21ffa93b0f07dbfa4b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70555f09/uploads/origins/8e2804b9-a293-465c-bd16-7d3eeeb29607?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cf0a8f8a14c8fe776a16ee7c880df91", "src_set": ""}, "body": "Hello 次郎次-san,\nFor my next request, please draw Nazrin fishing at a beach!\nIf that's not possible, it would be nice to see her relaxing at the beach instead!\n\n次郎次さん、こんにちは。\n次のリクエストは、ナズーリンが海辺で釣りをしているところを描いてください。\nそれが無理なら、ビーチでくつろいでいる姿でもいいです!", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 62963, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6bf05a2e/uploads/origins/ae4dc936-2ffc-41bb-9d59-3ea5c58b0c75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddbb2c6866fb48cbd8e13265311e96db", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6bf05a2e/uploads/origins/ae4dc936-2ffc-41bb-9d59-3ea5c58b0c75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b40a83e8c84c43bfef0a5e9aaa839b75", "src_set": ""}, "body": "Thank you always for your wonderful art!!\nFor my next request, can you please draw Nazrin enjoying \"afternoon tea\"?\nいつも素敵なアートをありがとうございます!!!\n次のリクエストですが、「アフタヌーンティー」を楽しむナズーリンを描いていただけませんでしょうか？\n\nhttps://tinyurl. com/2p97wvnw\nhttps://tinyurl. com/4cpw6mwh", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 62963, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4078b9a3/uploads/origins/3e1b08f1-9579-4aa6-9089-f2d572d67eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef2dd8b9a88bb0f9b9a63b933aa260f8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4078b9a3/uploads/origins/3e1b08f1-9579-4aa6-9089-f2d572d67eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6e065182e9a47ae604fd271aa034b2c", "src_set": ""}, "body": "Hello! Please draw Nazrin again however you wish!\n\n次郎次さん、こんにちは。\nナズーリンを好きなように描いてください", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/687a9600/uploads/origins/54ca82d4-93c9-4357-8eaf-69f62011a5de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=947a34a9edb24b3701533f837ac663b9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/687a9600/uploads/origins/54ca82d4-93c9-4357-8eaf-69f62011a5de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e02ba7a59589d74f40274453eb184b4b", "src_set": ""}, "body": "Thank you so much for the previous beautiful request! It was so wonderful and it made me really happy to see it!! Thank you!!\nFor my next request, please draw Nazrin however you wish!\n\n前回の素敵なご依頼、本当にありがとうございました! とても素敵で、見ていて本当に幸せな気持ちになりました!!! ありがとうございました!!!\n次のリクエストは、ナズーリンを好きなように描いてください!", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jirouji/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62963, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/573aafe7/uploads/origins/1ff6d7c4-2323-4083-a944-29f5fc2e798f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7db6de2df9b6df657ef52528e3df4d71", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/573aafe7/uploads/origins/1ff6d7c4-2323-4083-a944-29f5fc2e798f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7de1cec02cf7d84ed022bd5852af774c", "src_set": ""}, "body": "次郎次さん、こんにちは。\nいつも素敵なナズリンのイラストをありがとうございます いつもどの作品も大好きで、それぞれとても素敵で個性的です どれもこれも、とても素晴らしいです\n次のリクエストは、ナズーリンを好きなように描いてくださいね。\n全てお任せします!\n\nThank you very much for all your previous wonderful Nazrin illustrations!\nFor my next request, please draw Nazrin however you wish! \nI'll leave everything up to you!", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path"