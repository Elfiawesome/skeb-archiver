はお腹辺りまで水没、スク水コキラストスパートからの射精～大津波に呑み込まれる時に首元まで水没と徐々に水に呑み込まれていくみたいな徐々に水没していく感じで、時間をかけてよろしいので描写多めでお願いいたします。\n\n以上になります。\n細かくなってしまいましたが、ご検討をよろしくお願いいたします", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neet9696/works/22", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/636cd67d/uploads/origins/de07e237-a0e6-413c-8d7c-158c18b66797?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c4cfcf198cd89537bc5f9ea7e63e6bc", "srcset": "https://si.imgix.net/636cd67d/uploads/origins/de07e237-a0e6-413c-8d7c-158c18b66797?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c4cfcf198cd89537bc5f9ea7e63e6bc, https://si.imgix.net/636cd67d/uploads/origins/de07e237-a0e6-413c-8d7c-158c18b66797?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f74c69dcbbdec857305a595899a453a 2x, https://si.imgix.net/636cd67d/uploads/origins/de07e237-a0e6-413c-8d7c-158c18b66797?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ce4c208aab9e7ffb9bcafb96bf76411 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 506302, "nc": 33}, {"path": "/@neet9696/works/21", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0cd61104/uploads/origins/f8eec200-103f-4790-956c-1795019cc01d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9da50ac2a8aaed2ceda0dafd6c8bc017", "srcset": "https://si.imgix.net/0cd61104/uploads/origins/f8eec200-103f-4790-956c-17