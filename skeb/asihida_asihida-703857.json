759732253a81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82b0ceeeda724bfa34fb49afedfaa8ba", "srcset": "https://si.imgix.net/2d46a600/uploads/origins/7460f5f6-0cbc-4ce9-b5d9-759732253a81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82b0ceeeda724bfa34fb49afedfaa8ba, https://si.imgix.net/2d46a600/uploads/origins/7460f5f6-0cbc-4ce9-b5d9-759732253a81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=14fc24e0b1fe17f2dcdfd26052dfd1e1 2x, https://si.imgix.net/2d46a600/uploads/origins/7460f5f6-0cbc-4ce9-b5d9-759732253a81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=725c6872e4120d2638421f8815c895cf 3x"}, "body": "こんにちは！私の彼女はムカデが大好きで、バレンタインデーにあなたからアート作品をもらえたら嬉しいです。付き合い始めた頃、彼女が気に入っているムカデの種類を見せてくれたんです。私はその彼女に小さな帽子をかぶせたイメージを思い浮かべて「レディ・キチン・トーズ」と呼びました。以前には、小さな人形の帽子をかぶせた剥製ムカデをプレゼントしたこともあります。  今回、可能であればイラストを依頼したいです。公園でピクニックデートをする「レディ・キチン・トーズ」と、もう一匹の虫（私）を描いていただけると嬉しいです。私は蛾として登場します。日光が苦手なので蛾がぴったりです！ 眼鏡をかけた姿も良いですね。そうすれば小さなピクニックデートで紅茶をすすりながら、二匹の虫が寄り添う絵になります！なお、私と彼女は非常にプライベートを重視しています。作品を共有される際は、恋人向けであることは伏せていただけますと幸いです。よろしくお願いします！https://drive.google.com/drive/folders/1FO3Pv-jx39Zb9bUXbU9w8EhxAebq4x1C", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@asihida_asihida/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3753940, "client_id": 2205675, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/49ae9885/uploads/origins/cbddb677-1792-42f5-a068-98efd4a64e1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1577627efcd1fbb018e3ea155a07ec61", "srcset": "https://si.imgix.net/49ae9885/uploads/origins/cbddb677-1792-42f5-a068-98efd4a64e1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1577627efcd1fbb018e3ea155a07ec61, https://si.imgix.net/49ae9885/uploads/origins/cbddb677-1792-42f5-a068-98efd4a64e1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ff9cc11b5fb220f6f00e332662d234f 2x, https://si.imgix.net/49ae9885/uploads/origins/cbddb677-1792-42f5-a068-98efd4a64e1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79b44fadb44d3a32cd22f2ed4e347290 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/49ae9885/uploads/origins/cbddb677-1792-42f5-a068-98efd4a64e1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=803baced31de145381d6aa46c23ec1cb", "srcset": "https://si.imgix.net/49ae9885/uploads/origins/cbddb677-1792-42f5-a068-98efd4a64e1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=803baced31de145381d6aa46c23ec1cb, https://si.imgix.net/49ae9885/uploads/origins/cbddb677-1792-42f5-a068-98efd4a64e1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e01e79bad8fc494a1d2ae3c0fca9b14c 2x, https://si.imgix.net/49ae9885/uploads/origins/cbddb677-1792-42f5-a068-98efd4a64e1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2c1e460369c467d25abc18da161cd0cc 3x"}, "body": "こんにちは。あなたの作品をとても楽しみにしています！私の愛猫ゼルダが最近亡くなったのですが、彼女を描いていただけたらとても光栄です。\n\n彼女は黒と白で、とてもぽっちゃりしていて、魂のこもった大きな目をしていました。私はいつも、彼女に小さな帽子を被せたいと冗談を言っていたので、もし彼女が古典的な方法で人のようにドレスアップしていたら、それは楽しいかもしれません。小さな蝶ネクタイ、小さなボーラーハット......私のかわいい娘の最高の衣装を着たポートレート。インスピレーションが湧くものなら何でも。ありがとう。\n\nhttps://drive.google.com/drive/folders/1eTLW0i7698qvqNKYels-w_FQ6C-TvknC", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@asihida_asihida/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3753940, "client_id": 3181620, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19309648/uploads/origins/313d7b6e-b130-4