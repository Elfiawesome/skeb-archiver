蓋ブラシを持ってます。\nお腹周りの服がはだけておへそが見えてます。\nネイルはこういう感じのやつです。\nhttps://toy.bandai.co.jp/series/precure/item/detail/12341/\n\n◎背景は適当でも大丈夫です。女の子重視でお願いできればと…\n\n◎絵には足の先まで入っていてほしいのと、\n欠損してる肩の肌のところとおへそは髪や足で隠れず、見えていてほしいです。\n\n\n鳥の子やウロミオ、Twiiterのイラストなどを拝見してそういうフェチに理解が深いんじゃないかというのと、脚の描き方にこだわりを感じていいな～って思ったこと、それと純粋に絵柄が好きなので依頼しました。フェチ全開のアレな絵ですが引き受けていただけるととても嬉しいです！", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@o0x0o0o/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 811729, "client_id": 577612, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96be244f/uploads/origins/ce4d0607-cd44-4db9-a981-6c279e7c001e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c693ee5b84cdac7b3e339c752e3afd45", "srcset": "https://si.imgix.net/96be244f/uploads/origins/ce4d0607-cd44-4db9-a981-6c279e7c001e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c693ee5b84cdac7b3e339c752e3afd45, https://si.imgix.net/96be244f/uploads/origins/ce4d0607-cd44-4db9-a981-6c279e7c001e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c8babc13e2eeb32bf2227a604411001 2x, https://si.imgix.net/96be244f/uploads/origins/ce4d0607-cd44-4db9-a981-6c279e7c001e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f71390e5f074cc4bef2699bb6595feb2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96be244f/uploads/origins/ce4d0607-cd44-4db9-a981-6c279e7c001e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b22aef29b7395839bf872c732c08b57", "srcset": "https://si.imgix.net/96be244f/uploads/origins/ce4d0607-cd44-4db9-a981-6c279e7c001e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b22aef29b7395839bf872c732c08b57, https://si.imgix.net/96be244f/uploads/origins/ce4d060