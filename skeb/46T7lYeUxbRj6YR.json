23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57100521fa194afc042ba73cf04a9e90", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/14c7fbfc/uploads/origins/d4618224-f326-4b8e-abaf-6d3825aa921c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b650d09b7e0c69bae0e090e91fa6d574", "src_set": ""}, "body": "リクエスト失礼します。\n\n犬耳なミクちゃんのイラストをお願いしたいです。\n(ネコミクちゃんのワンちゃんバージョン)\n(衣装に首輪要素があると嬉しいです)\n\nよろしければ、下記のようなシチュエーションでお願いします。\n「普段帰宅するととびきり笑顔でお迎えしてくれるワンコなミクちゃんが、\n　今日はなんだかよそよそしいと思ったら、発情期だった、、、」\n\nよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@46T7lYeUxbRj6YR/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1273358, "client_id": 2788583, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/340a6a0a/uploads/origins/7c486f3e-36ca-4f36-8323-1915a6c569f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ff46d187711072ef2f7c7b2299dfaae", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/340a6a0a/uploads/origins/7c486f3e-36ca-4f36-8323-1915a6c569f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=300dd7b131e925ab705db0e7ba8c07a7", "src_set": ""}, "body": "初めまして。\nいつも素敵な作品を拝見させて頂いてます✨️\nリクエスト内容なのですが、ハニーウィップ衣装のミクちゃんをお願いします。\n背景、表情ポーズ等はわいもにく様のイメージ通りにお任せ致します。\nお任せ内容が多く申し訳ありませんが、ご検討の程よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@46T7lYeUxbRj6YR/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1273358, "client_id": 103289, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/488ad18e/uploads/origins/6a8f958c-dc46-4275-b07a-28bd2a2b082e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=154155f7386a789e218b25c4f8083b5d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/488ad18e/uploads/origins/6a8f958c-dc46-4275-b07a-28bd2a2b082e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14b6d270154319db11f318eedbf54334", "src_set": ""}, "body": "初音ミクを描いてください。四角い髪留めが切れて悲しそうです。\n\nその他はお任せします。\n\nありがとうございました。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@46T7lYeUxbRj6YR/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1273358, "client_id": 127734, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba931fb5/uploads/origins/0013c44e-6d1a-42ad-89d2-3138e508e22a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa7dcdf3447aac90e7de84d71ef4104d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba931fb5/uploads/origins/0013c44e-6d1a-42ad-89d2-3138e508e22a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b3688afe9f268d2a84bfb2b7c1ee5a4", "src_set": ""}, "body": "はじめまして、わいもにくさん。\nわいもにくさんの素敵な作品に目を惹かれたので依頼をさせてもらいます。特にラビットホールミク、ハート目とメスガキミクに一目惚れしました。\n\n依頼内容は、私のオリキャラ - シャーロットを描いて頂きたいです。\nうちの子は、血をシャボン液に変えられた突然変異の泡血鬼(原ヴァンパイア)。彼女は血液を操るようにシャボン玉とシャボン液を操る能力を持っている。もともとはヴァンパイアで、性格はちょっと意地っ張りで生意気で、\"小悪魔系\"や\"メスガキ\"に似ている。彼女はシャボン玉を使ってイタズラをしたり、他の人と遊ぶのが好きだ。例えば、シャボン玉の中に人を閉じ込めて、彼女と一緒に空を飛ぶとか。\n\n服装については、\"変身後の服装\"のコートはシャボン玉で作られ、中の袖はシャボン液で満たされている。必要があれば、手元が見える袖丈に調整してください。\n\nそして、いいふともも と いいおっぱいもお願いします~\nhttps://x.com/waimoniku/status/1750471128622203199\n\n今回の主なテーマは\"シャボン玉\"x\"メスガキ\"だ。\nうちの子のシャーロットちゃんを、生意気そうな表情でも、ハート目でも、\"メスガキ\"っぽい雰囲気が強くなるような要素で描いてほしい。\nこの絵のように、すごくかわいくて、少しエッチな絵になるといいです。\nhttps://x.com/waimoniku/status/1801546294395289724\nhttps://x.com/waimoniku/status/1801828594945282228\n\n構図やポーズなどは、シャボン玉に関連するものであれも基本的に自由です。シャボン玉の上に横たわり、シャボン玉を吹くだり、シャボン玉で遊んだり、シャボン玉の中に入れたりすることもokです。\n\nシャボン玉を操るメスガキが、シャボン玉と絡みながら生意気な顔をしたり、かわいい顔をしたりする、先生がメスガキに負けたくなるようなかわいい絵になることをお願いします。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/17zjsGwWw2DlmPm-lepceMGmT2nUgfDY0?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@46T7lYeUxbRj6YR/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1273358, "client_id": 3092616, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22a78572/uploads/origins/173d925f-0484-43d8-a28a-84942a579ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5e8edd2709ef7446b83102a623fc7bb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22a78572/uploads/origins/173d925f-0484-43d8-a28a-84942a579ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1159ce264f783da1cfe9cc30e82ee2df", "src_set": ""}, "body": "こんにちは、わいもにくさん。大好きなミクさん（レーシングミク2014）の絵をお願いしたいです。大人っぽい感じと、緑から青のグラデーションの髪が好きです。ポーズはお任せします。Xのプロフィール画像に使わせていただきます！本当にありがとう。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@46T7lYeUxbRj6YR/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1273358, "client_id": 1523235, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e011364/uploads/origins/dfc18ab9-aaa6-4ce5-a947-5e835cdc142d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6580bba50e6d94331d9b85e16b1dee2b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e011364/uploads/origins/dfc18ab9-aaa6-4ce5-a9