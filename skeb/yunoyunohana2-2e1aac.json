ix.net/57d22f96/uploads/origins/4add20ac-447d-4ee9-99b6-c580924bf5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d5dd9c0078b21ce31afef994b93fc1a", "srcset": "https://si.imgix.net/57d22f96/uploads/origins/4add20ac-447d-4ee9-99b6-c580924bf5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d5dd9c0078b21ce31afef994b93fc1a, https://si.imgix.net/57d22f96/uploads/origins/4add20ac-447d-4ee9-99b6-c580924bf5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3c94e6ec3fb2790e4bb78e7fd562b69d 2x, https://si.imgix.net/57d22f96/uploads/origins/4add20ac-447d-4ee9-99b6-c580924bf5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f8552577328115a2cb95be157fc241b 3x"}, "body": "こんにちは湯の花さん❗️❗️❗️\nお忙しいところ失礼します、どうしても湯の花さんにお金を払って描いていただきたいうちの子がいるので今回イラストをリクエストさせていただきたく・・・。\n\nミステリアスな雰囲気の男性\n身長は178㎝、職は中学校の美術教師\n肩ぐらいまである黒色の髪の毛、基本口内は開けると黒ベタ塗りで描きます。\n目元は黒色のツリ目。泣きぼくろ。大体虚ろ。ハイライトは無いことが多いですがちゃんと存在感をもって入る場合黒目の真ん中に宿ります\n\n変な趣味を持っていて、骨格標本(魚などの水生生物が主。人型も○)が大好き。 標本を作ったり眺めたり。あとは骨と筋肉、臓器も愛している。新鮮で生々しい色だと更によし。鬱くしいものよし。\nただ生きている魚や水槽/水族館も好きなので、青色の使い方やさわやかな雰囲気の描き方が大ファンの湯の花さんに描いていただきたいと思ったところですが流血要素があったり鬱くしい雰囲気も好きなのでそっちの方向でも見たいしやっぱり淡くて可愛い湯の花さんも見たいような　何が言いたいかってご自由に描いていただけると幸いです。\n\n性格は変人。見た目と同じくミステリアスでひょうひょうとした人間。趣味も相まって得体が知れない。\n情緒が不安定なので不気味に笑っていることもあれば急に虚無に陥ったりよく涙を浮かべたり。　\n意外にも人見知りかつ臆病な面も持ち合わせるので、やはり表情もご自由に描いていただければな・・・と思います。\n\n容姿資料も添付いたします！構図も何もかも湯の花さんにお任せしたいです！！よろしくお願いします！！！！\n\nhttps://www.dropbox.com/s/z1vsd2s6c00goxu/skeb%E7%94%A8%E8%B3%87%E6%96%99%E3%80%80202110.png?dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@aosorahinogi/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1360607, "client_id": 921556, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c9d8197/uploads/origins/40659fb3-db51-