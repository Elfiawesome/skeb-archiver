483e04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3931a3b1284d16c2c6f948e95e8f8ef8, https://si.imgix.net/1ebf1b87/uploads/origins/0838180a-1b76-45c4-b71b-c60c9c483e04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8023e8b5b738bc51fdf6d913da05ad21 2x, https://si.imgix.net/1ebf1b87/uploads/origins/0838180a-1b76-45c4-b71b-c60c9c483e04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b42e7d59b53b45f4711b61eecdd8616b 3x"}, "body": "こんにちは〜。黒エキスさんの爆乳薄ピンクデカ乳首が好きなのでリクエストします。\n\nよければウチの子のネムリちゃんの乳首オナニー絵お願いします、谷間は開いてないのが好きです。\n下半身描く場合はパンツはかせてください。\n\n乳首オナニー大好きで毎日チクニーで母乳出しながらイクのが好きな子。\nシチュとしてはベッドで寝転んで最初服の上から乳首の長さ3分の1位で指でスリスリしてだんだん勃起してきたら手全体で握ってグニグニして引っ張って乳首がフル勃起した時に手を下ろして自分の服の上から勃起したデカ乳首見て乳首ビンビン・・・💖って言いながら嬉しそうな顔をする。その後服を脱いでもう1度自分のデカ乳首を見て興奮した後デカ乳首をチンコ擦る見たいにシコシコして先端から母乳ビュルルルってペットボトル2L位の量吹き出しながら可愛くイクって感じでお願いします。（面倒なら服はなくていいです。）\nデカ乳首はフル勃起で缶コーヒー位の大きさ、通常時は2cm位の長さ。\n\n宛名とサインは別レイヤーでお願いします。\n\nB5サイズ 350dpi 塗足3mm (横2591x縦3624pix) RGBモード psd形式\n\nウチの子\nhttps://pbs.twimg.com/media/Fam20aOUYAE2zDB?format=jpg&name=4096x4096\n\nhttps://pbs.twimg.com/media/Fam22A3VsAAb8b4?format=jpg&name=4096x4096\n\n好きな体型とデカ乳首\nhttps://x.com/nohara1072e/status/1670417333926658048?s=20\nhttps://twitter.com/nohara1072e/status/1781385280110674026/photo/1\n構図困った場合の好きな構図\nhttps://www.pixiv.net/artworks/107816130\nhttps://www.pixiv.net/artworks/95792666\nhttps://www.pixiv.net/artworks/86634921\n横向きに寝転がってるのも好きです\nhttps://www.pixiv.net/artworks/112802781", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuroekisu/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 125183, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90f03fc3/uploads/origins/22723a2b-99c4-4998-95a9-0315ed14432d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f52d58a9f953cc493006aa458a148e0f", "srcset": "https://si.imgix.net/90f03fc3/uploads/origins/22723a2b-99c4-4998-95a9-0315ed14432d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f52d58a9f953cc493006aa458a148e0f, https://si.imgix.net/90f03fc3/uploads/origins/22723a2b-99c4-4998-95a9-0315ed14432d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfecfa5c16131172cdb754ce59cb0e4d 2x, https://si.imgix.net/90f03fc3/uploads/origins/22723a2b-99c4-4998-95a9-0315ed14432d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82db7b2f62569f497bb75c376031a373 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90f03fc3/uploads/origins/22723a2b-99c4-4998-95a9-0315ed14432d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31b0d28924c2526b146c8f822f75bcea", "srcset": "https://si.imgix.net/90f03fc3/uploads/origins/22723a2b-99c4-4998-95a9-0315ed14432d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31b0d28924c2526b146c8f822f75bcea, https://si.imgix.net/90f03fc3/uploads/origins/22723a2b-99c4-4998-95a9-0315ed14432d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f506132b68f8a1f76aba240d3656bf8 2x, https://si.imgix.net/90f03fc3/uploads/origins/22723a2b-99c4-4998-95a9-0315ed14432d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5da60fee93d97fbf6b08a053467afa45 3x"}, "body": "黒エキス先生のデカクリ、デカ乳首が刺さりましてファンになりました。\n是非描いていただきたいと思い、リクエストさせていただきます。\n\n勝利の女神：NIKKEよりマナをお願いします。\nシチュエーションは仕事のストレス解消に服をはだけて下着ごしにアソコを広げて指揮官を誘っている感じでお願いします。\n\n差分が可能でしたら下着無しで中だし後にアソコから垂れている差分をお願いします。\n\n金額が見合わなければできる限りでかまいません。\nよろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuroekisu/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 125183, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7e56825/uploads/origins/c547f47b-30ea-4483-a70a-d933da5e5313?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5064993a0e53d40c4068dd8cd9da960", "srcset": "https://si.imgix.net/a7e56825/uploads/origins/c547f47b-30ea-4483-a70a-d933da5e5313?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5064993a0e53d40c4068dd8cd9da960, https://si.imgix.net/a7e56825/uploads/origins/c547f47b-30ea-4483-a70a-d933da5e5313?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5addf66d4594d6f95fd929866ca5f659 2x, https://si.imgix.net/a7e56825/uploads/origins/c547f47b-30ea-4483-a70a-d933da5e5313?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b95038ac9eeb256e8e847fde0ab1965 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7e56825/uploads/origins/c547f47b-30ea-4483-a70a-d933da5e5313?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ad64cda50819727b8d99ba206366a3c", "srcset": "https://si.imgix.net/a7e56825/uploads/origins/c547f47b-30ea-4483-a70a-d933da5e5313?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ad64cda50819727b8d99ba206366a3c, https://si.imgix.net/a7e56825/uploads/origins/c547f47b-30ea-4483-a70a-d933da5e5313?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=353f0190497c44d1bd04b5cb8d35580a 2x, https://si.imgix.net/a7e56825/uploads/origins/c547f47b-30ea-4483-a70a-d933da5e5313?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=62687e2d42a68ebb25ba7b9b352c468b 3x"}, "body": "匿名で再度依頼失礼します。\n以下のような馬乗り搾乳パイズリをリクエスト致します。\n内容は前回と同じです。\n\n■キャラクター／シチュエーション\n・メインの女の子はNIKKEのソーダ。頭よりも一回り以上大きな爆乳で巨乳輪、下記イラストのような大きさで描いて頂ければ。\n　おっぱいが性感帯で気持ち良くなると母乳が出る体質。お好きな衣装で。\nhttps://www.pixiv.net/artworks/117646542\n\n・竿役は指揮官。ズリキチにして絶倫。\n\n・ソーダに馬乗り搾乳パイズリをするシチュエーション。\n　甘々いちゃらぶな雰囲気で一緒に気持ちよくなっている。\n\n■詳細\n・竿役主観の構図。ソーダは胸部を開けており腋見せのポーズの体勢。\n・竿役がおっぱいを指が沈むぐらい鷲掴みで揉んで搾乳、谷間に流れ溜まってる母乳を\n　ローション代わりにセックスのように激しく腰を振っている。\n・竿はほぼおっぱいに埋もれていて、思いっきり腰を突いたときだけ上乳から少し先っぽが出る程度の大きさ。\n・既に何度か顔や髪に射精済みで、さらに頭を超える勢いで射精しようとしている。\n・ソーダは竿役の行為を母性溢れる表情で見つめている。\n・射精時は絶頂しながら勢いよく噴乳。涙描写あり。\n\n■希望\n・汗・吐息の描写、母乳・精液・表情の差分、擬音、台詞などをお願い致します。\n・バストサイズ・カップ数の申告や射精誘発の台詞があると嬉しいです。\n・ファイル形式はpsd。キャラ、精液、母乳、擬音、セリフの各パーツのレイヤー分けを希望。\n\n上記に書かれてない内容はおまかせ致します。\nご検討の程よろしくお願い致します。\n\nhttps://dic.pixiv.net/a/%E3%82%BD%E3%83%BC%E3%83%80(%E5%8B%9D%E5%88%A9%E3%81%AE%E5%A5%B3%E7%A5%9E%3ANIKKE)", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuroekisu/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/41cea8ef/uploads/origins/21c28505-7741-4863-ac02-d5d760b1d01a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f525067c1b77fc32e1234cfec7ff600", "srcset": "https://si.imgix.net/41cea8ef/uploads/origins/21c28505-7741-4863-ac02-d5d760b1d01a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f525067c1b77fc32e1234cfec7ff600, https://si.imgix.net/41cea8ef/uploads/origins/21c28505-7741-4863-ac02-d5d760b1d01a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1aed5c1952ad05bd9dc1fe610db7b340 2x, https://si.imgix.net/41cea8ef/uploads/origins/21c28505-7741-4863-ac02-d5d760b1d01a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af19786f90bd4912fb5b43fb0079d157 3x"}, "private": true, "genre": "art", "tip