ers/148R4slZ30UKLejX1U2ExwOQvNmD9wGTl  \n\n容姿について\nボブ\n・単純なボブではなく、ショートボブです\n・瞳の色が黒とグレーで、ハイライトがありません。\n\n長髪\n・瞳の色が黒で、ハイライトがありません\n\nふたりの関係性\n大人気歌い手×ストーカーフリーターのカプです。\nふたりは同棲していて、長髪の方はボブを怖がっており、ボブは長髪のことを本当に愛しており本気で長髪の恋人になれていると信じています。 \n\nモチーフ\nボブ\n血塗れナイフ\nくまさん人形\n首吊りロープ\n\n長髪\n青いバラ\nマイク\n青い蝶\n\nふたりの服装 \n適当なものを着させて頂ければ嬉しいです。 ボブはサブカル、地雷系の黒を基調とした洋服（半袖の場合両腕に傷があります） 長髪はモード系のパンツコーデを着させていただければ嬉しいです。  \n\nまた、没ラフなどあれば一緒に入れていただければ嬉しいです。\nNGはないので、好きなように描いていただきたいです。\n長々と失礼しました。 よろしくお願いいたします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@iiinaciii/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d7d4012a/uploads/origins/14791183-03ec-472f-a130-823caf8b94db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6caf980b39b4b7401c1065f1e7b0b466", "srcset": "https://si.imgix.net/d7d4012a/uploads/origins/14791183-03ec-472f-a130-823caf8b94db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6caf980b39b4b7401c1065f1e7b0b466, https://si.imgix.net/d7d4012a/uploads/origins/14791183-03ec-472f-a130-823caf8b94db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b16b1f7467cdd26d2a83e458bc46d7b9 2x, https://si.imgix.net/d7d4012a/uploads/origins/14791183-03ec-472f-a130-823caf8b94db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dfa505f714acee35175cc96935baa8b0 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2879235, "nc": 161}, {"path": "/@iiinaciii/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/169fe8a9/u