ploads/origins/abfc6d46-120b-485d-881c-769b39da849f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaa2ea877aa90885d1ee55c7622f245a, https://si.imgix.net/184efd9a/uploads/origins/abfc6d46-120b-485d-881c-769b39da849f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46ed453dad49721f283d72cabebafadc 2x, https://si.imgix.net/184efd9a/uploads/origins/abfc6d46-120b-485d-881c-769b39da849f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7359d04c6a49fdf2d6750990e238f73 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/184efd9a/uploads/origins/abfc6d46-120b-485d-881c-769b39da849f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e91db511864af958a1925058d7939bae", "srcset": "https://si.imgix.net/184efd9a/uploads/origins/abfc6d46-120b-485d-881c-769b39da849f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e91db511864af958a1925058d7939bae, https://si.imgix.net/184efd9a/uploads/origins/abfc6d46-120b-485d-881c-769b39da849f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f8b9061331b133dfdf77a262f93d240 2x, https://si.imgix.net/184efd9a/uploads/origins/abfc6d46-120b-485d-881c-769b39da849f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9105b154382323bcb6b05bf59b326eae 3x"}, "body": "コトコさん、こんばんは。\n『きょうの調伏課』の連載お疲れ様でした！\nSkeb募集との文面を見て今回リクエストを送信いたしました。\n\n今回依頼したいのは『祝福の塔2』というTwitterリアルタイム企画に参加させていただいた自宅キャラとなります。\n\n【世界観、キャラクター】\n●小野寺りこ\n毛先が赤色の黒髪、緑色の瞳、アホ毛と笑顔が特徴。\n生き物全般のお世話、たいやき、蜘蛛が大好きな人懐っこい性格。\n\n同じ日に亡くなった方が集められる「塔」にて1カ月かけて巡礼を行い、各階層の主から「祝福」を授かった状態で生き返り新たな人生を歩んでいくストーリー。\n『強運』の持ち主になれる祝福を授かり生まれ直した。\n\n●モチーフ：彼岸花・金木犀・ラッキー・蜘蛛の糸・お線香・無邪気な悪事\n\n【内容】\nどこか不穏さも感じるけれどキャラクター本人は明るい笑顔の1枚イラストに一言台詞を付けたものでお願いいたします。\n台詞に関してはコトコさんが浮かんだものでも、資料中の印象的な言葉でもどちらでも構いません。\n\nもし可能であれば、モチーフである彼岸花と蜘蛛の糸、お香の煙を入れていただけると嬉しいですが、取り入れるモチーフや服装、構図、カラー/モノクロ、サイズ等は全てお任せいたします。\n基本的にご自由に描いていただけたら幸いです。用途としては個人鑑賞のみです。\n\n【資料】\nhttps://www.dropbox.com/scl/fo/prjk4irx6yxr3r1mpobgb/ADSmeZra5rJQOjRA5BaQLK8?rlkey=ezq251gwyvjh1qru5eww8iaml&st=fhbv3hzv&dl=0\n\nコトコさんの台詞回し、画面構成、笑顔の女の子が好きなので今回コミックというジャンルで依頼しました。\nもしご縁がありましたら、よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kotoko0/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 17042, "client_id": 1125625, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55a00c3a/uploads/origins/275cdc1e-f51b-4b77-a058-87524faa9ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c966ad9d846a1e6d014b5ebe9dfee58c", "srcset": "https://si.imgix.net/55a00c3a/uploads/origins/275cdc1e-f51b-4b77-a058-87524faa9ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c966ad9d846a1e6d014b5ebe9dfee58c, https://si.imgix.net/55a00c3a/uploads/origins/275cdc1e-f51b-4b77-a058-87524faa9ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e13fb7838fa470a53c802514c3025b3b 2x, https://si.imgix.net/55a00c3a/uploads/origins/275cdc1e-f51b-4b77-a058-87524faa9ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bdc96229e9cddfe6e25857ef3199176 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55a00c3a/uploads/origins/275cdc1e-f51b-4b77-a058-87524faa9ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45fe17ee0278cd30d598631505bf95a3", "srcset": "https://si.imgix.net/55a00c3a/uploads/origins/275cdc1e-f51b-4b77-a058-87524faa9ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45fe17ee0278cd30d598631505bf95a3, https://si.imgix.net/55a00c3a/uploads/origins/275cdc1e-f51b-4b77-a058-87524faa9ddc?bg=%23fff&auto=form