タナを手に疲れて座っていて、目の前の地面に突き刺さっている！彼女の耳はおそらく下を向いていて、ため息をついているだろう。ちょっと血まみれ（モンスターや悪のチンピラと戦ったばかりみたいな感じ）でもいいし、単に疲れている感じ（ちょっと修行した後みたいな感じ）でもいい。\n\nこれで十分だと思う。デザインの細部や部分については、あなたの好みに合わせて自由に調整してください！\n\nhttps://drive.google.com/drive/folders/1XP3DC7D8SsCru-oBW9_xAVVz_3lkQbIM?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tawaketch/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1236859, "client_id": 1693586, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8b86f47/uploads/origins/4fa50dbe-fb37-4f8d-91ad-ce56a54106f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f2252516922cef6941c5cb225707a6a", "srcset": "https://si.imgix.net/a8b86f47/uploads/origins/4fa50dbe-fb37-4f8d-91ad-ce56a54106f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f2252516922cef6941c5cb225707a6a, https://si.imgix.net/a8b86f47/uploads/origins/4fa50dbe-fb37-4f8d-91ad-ce56a54106f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a21b5e9a4ab4d9e26ed16678a08f382b 2x, https://si.imgix.net/a8b86f47/uploads/origins/4fa50dbe-fb37-4f8d-91ad-ce56a54106f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da35831fb1431d4a96f401dedd1af614 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8b86f47/uploads/origins/4fa50dbe-fb37-4f8d-91ad-ce56a54106f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9849e033781a45111533b7fed4c6ffa", "srcset": "https://si.imgix.net/a8b86f47/uploads/origins/4fa50dbe-fb37-4f8d-91ad-ce56a54106f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9849e033781a45111533b7fed4c6ffa, https://si.imgix.net/a8b86f47/uploads/origins/4fa50dbe-fb37-4f8d-91ad-ce56a54106f5?bg=%23fff&auto=format%2Ccompress&fm=webp&