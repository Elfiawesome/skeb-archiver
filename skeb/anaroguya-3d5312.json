レイヤー分け出来るPSDデータで頂けるとありがたいです。\nTwitterで納品報告をする場合は「#るーるふ美術館」のタグを付けていただければ幸いです。\n\nご検討よろしくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@anaroguya/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ce1bc152/uploads/origins/d02f13bb-84ec-4b46-a7ef-c0ccc9f918fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6fb02917b90d26e571c461394058f2a2", "srcset": "https://si.imgix.net/ce1bc152/uploads/origins/d02f13bb-84ec-4b46-a7ef-c0ccc9f918fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6fb02917b90d26e571c461394058f2a2, https://si.imgix.net/ce1bc152/uploads/origins/d02f13bb-84ec-4b46-a7ef-c0ccc9f918fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4ec23fd83b094bcc1e305c513e13e64 2x, https://si.imgix.net/ce1bc152/uploads/origins/d02f13bb-84ec-4b46-a7ef-c0ccc9f918fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8b11bd5998f05e1cc67a59b09cbbe40 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 792648, "client_id": 1379093, "nc": 17}, {"path": "/@anaroguya/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 792648, "client_id": 9088, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/797fc9cf/uploads/origins/0868c484-d426-4497-bdd7-9ddbd00d889b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=767248afda61d5711f6e8fdc76406f91", "srcset": "https://si.imgix.net/797fc9cf/uploads/origins/0868c484-d