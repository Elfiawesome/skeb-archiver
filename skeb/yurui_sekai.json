poon(配信サイト)での背景\n《女の子》 \n髪の長さ:肩に着くかつかないかのボブ \n髪色:ろーちゃんの好きな色を使った髪色でお願いします！  白っぽく薄い青などを使った柔らかい印象の色にはしたいです。\n表情:幸せそうな表情(参考として添付致します)\n目:三日月のように笑った時の目\n服装:参考にして頂きたい服があるので添付致します。首元は襟があると嬉しいです！写真添付致します！\n小物系:くまか猫のヘアピン。\n背景:もし可能であれば、夜空をイメージした背景をお願いしたいです。\n 以上となります。\nご検討いただけると幸いです！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yurui_sekai/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2765698, "client_id": 3304287, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1254cb2/uploads/origins/269a7769-09c0-476e-8b40-fe4e03a1c31c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae25accc594edbfd19310bee9ee39f10", "srcset": "https://si.imgix.net/f1254cb2/uploads/origins/269a7769-09c0-476e-8b40-fe4e03a1c31c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae25accc594edbfd19310bee9ee39f10, https://si.imgix.net/f1254cb2/uploads/origins/269a7769-09c0-476e-8b40-fe4e03a1c31c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9abc2bfc2805c1dcc4884b93b1a309cd 2x, https://si.imgix.net/f1254cb2/uploads/origins/269a7769-09c0-476e-8b40-fe4e03a1c31c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f442484703e7084d7b1247f6de018faa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1254cb2/uploads/origins/269a7769-09c0-476e-8b40-fe4e03a1c31c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59c3948af7fb765d2a147395fdefe8e1", "srcset": "https://si.imgix.net/f1254cb2/uploads/origins/269a7769-09c0-476e-8b40-fe4e03a1c31c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59c3948af7fb765d2a147395fdefe8e1, https://si.imgix.net/f1254cb2/uploads/origins/269a7769-09c0-476e-8b40-fe4e03a1c31c?bg=%23fff&auto=format%2Ccompress&fm