本人。身長は186cm。刀は簡略化するもしくは描かなくてもかまいません。タロットカードの戦車をモチーフにしております。\n\n【2人の関係】\n主従関係であり、恋人同士。\n\n・①→②への印象\n∟自分のもの、自慢の刀、男性としての魅力も感じている、困らせたい(振り回したい)\n\n・②→①への印象\n∟ 自分の皇帝、誇りと人間らしさを与えてくれた人、希望、かっこいい姿を見せたい相手、最初で最後の恋の相手\n\n【資料】\nhttps://drive.google.com/drive/folders/1zprFVVVHcOUn8SB3uxZzlgVOQt_ctbeP\n\n\nーーーーーーーーーーーーーーーーーーーー\n\n\n【用途】\n個人鑑賞、個人利用の範囲で待ち受け、SNSアイコン使用、印刷物(ブロマイドやグッズなど)オンラインセッションでの使用、などに利用させて頂く可能性がございます。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bawad__/works/34", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2552e0fa/uploads/origins/668d471c-88a7-4673-8654-d510f6ffdd40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6cf0b18968acf8e63d22369e223ac512", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3625642, "client_id": 3666079, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@bawad__/works/33", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3625642, "client_id": 1895383, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd6bd247/uploads/origins/9694150f-2197-4f0a-82da-c4f70c556f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11442416260407409177c30afdbac64d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd6bd247/uploads/origins/9694150f-2197-4f0a-82da-c4f70c556f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e132e9681b6550ee071447b84beefc69", "src_set": ""}, "body": "ゴンゾィーナ様、はじめまして！\n\n私のTRPGキャラクター2体のイラストを作成していただけますでしょうか（同伴者の許可