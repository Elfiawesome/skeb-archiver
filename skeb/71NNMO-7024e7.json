d-41f6-96b0-0ec7e5417ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e07e198a42c0c21241c5f4090adf88e, https://si.imgix.net/74b0daa0/uploads/origins/d0c55a03-435d-41f6-96b0-0ec7e5417ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b39b9bdb15c1de60ae8ad69517fdaf5 2x, https://si.imgix.net/74b0daa0/uploads/origins/d0c55a03-435d-41f6-96b0-0ec7e5417ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a8aebed6cb5a6b1ec669a70093768f9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74b0daa0/uploads/origins/d0c55a03-435d-41f6-96b0-0ec7e5417ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c98e4eda307b7a0c4e261845af472312", "srcset": "https://si.imgix.net/74b0daa0/uploads/origins/d0c55a03-435d-41f6-96b0-0ec7e5417ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c98e4eda307b7a0c4e261845af472312, https://si.imgix.net/74b0daa0/uploads/origins/d0c55a03-435d-41f6-96b0-0ec7e5417ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a177ac494ed8631632053399b862b45 2x, https://si.imgix.net/74b0daa0/uploads/origins/d0c55a03-435d-41f6-96b0-0ec7e5417ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c8d5e9af1cacc6bcdf579ad1c4fc609f 3x"}, "body": "Nan先生、こんにちは。\n先生の絵柄が本当に大好きです！今回、私のオリジナルキャラクター2人（姉妹）のイラストをお願いしたくご連絡しました。金額が足りない場合は、再度送信できます...！\n\n【❤キャラクター1：新垣有希（姉）】\n・女性、160cm、見た目年齢18～19歳\n・明るく快活で社交的。周囲を元気にする存在です。\n・赤い巻き髪（時々ローマ巻）、赤い目。髪色はオレンジ寄りの赤で、青みや紫みは避けてください。髪の長さはお尻より短く。\n\n【🩵キャラクター2：新垣惠理（妹）】\n・女性、163cm、見た目年齢16～17歳\n・電波系でマイペース。よく自分の世界に浸っていますが、内向的ではありません。\n・青いストレートヘア、赤い目。髪は腰までで柔らかめ、できるだけ跳ねないように。\n\n【❤🩵キャラクター関係性】\n二人は実の姉妹であり、強い信頼と親密さで結ばれています。互いを支え合い、それぞれにとってかけがえのない存在です。姉妹ならではの自然な距離感と、時に友達のような親しさが特徴です。\n姉妹関係を強調しても、GL風に描いていただいても大丈夫です。\n\n【衣装・デザイン参考】\n衣装やアクセサリーは下記リンクの中から先生が一番好きなものを選んで描いていただければ幸いです。画面の美しさのための小さなアレンジは大丈夫です。\n\n【参考資料リンク】\nhttps://photos.app.goo.gl/osYJSPqCHpGov7JCA\n\n【好きな構図】\n具体的なポーズや構図などは、先生にお任せしたいです！自由に描いていただければ嬉しいです！\n\n【用途】\n用途は個人コレクション、SNSアイコンやスマホの壁紙等です。\n\n【納品形式】\nもし可能でしたら、PSD形式のファイルをいただけると嬉しいです。レイヤー分けの細かさにはこだわりませんが、PSDだとより高画質な気がして安心できるので……！ラフやボツ案などがありましたら、PSDファイルに含めていただいても大丈夫です。歓迎です！\n\n【禁止事項】\nえっちな内容。過度に陰鬱な表情や場面は禁止です。\n\nhttps://photos.app.goo.gl/osYJSPqCHpGov7JCA", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@71NNMO/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3114747, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ab648ba/uploads/origins/f46033f7-b2e5-41c6-a9bc-9ae73de04675?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8389e3978707a9285ecf20e685e79628", "srcset": "https://si.imgix.net/8ab648ba/uploads/origins/f46033f7-b2e5-41c6-a9bc-9ae73de04675?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8389e3978707a9285ecf20e685e79628, https://si.imgix.net/8ab648ba/uploads/origins/f46033f7-b2e5-41c6-a9bc-9ae73de04675?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b48486e574fe87ec3bdb5cf6d0bd37c3 2x, https://si.imgix.net/8ab648ba/uploads/origins/f46033f7-b2e5-41c6-a9bc-9ae73de04675?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e99618cc6e1199053ac334fa2d2157e8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ab648ba/uploads/origins/f46033f7-b2e5-41c6-a9bc-9ae73de04675?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ba5302dc96fab1f2c8e482aa7438573", "srcset": "https://si.imgix.net/8ab648ba/uploads/origins/f46033f7-b2e5-41c6-a9bc-9ae73de04675?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ba5302dc96fab1f2c8e482aa7438573, https:/