ploads/origins/3c034733-c81a-4083-b71f-3f96f9e54df5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3862e2763b542293a152f8e467487338", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2473812, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@oda_utk/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2473812, "client_id": 2428665, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f556f532/uploads/origins/91ce4d83-d542-4d24-bcd7-d49ae6fe7943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a59b7066be580e913c62c5f130cad7cf", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f556f532/uploads/origins/91ce4d83-d542-4d24-bcd7-d49ae6fe7943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30c722505431f0891f6e82813fb4cac0", "src_set": ""}, "body": "織田様 \n初めまして、個人Vtuberをしておりますあさはねむゐと申します。 \n\n突然のご連絡失礼いたします。\nXでイラストを投稿されているのを拝見し、とても素敵なイラストを描かれており、Skebのご依頼をさせて頂きました。\n\nお忙しい中大変恐縮ですが、是非ご検討いただけますと幸いです。\n下記イラスト依頼の詳細となります。\n\n【人物】 \nあさはねむゐ（X・@asa_nemui_zzz）のイラスト\n以下、あさはねむゐの資料となりますのでご確認お願い致します。\nhttps://drive.google.com/drive/folders/1et0mSKHRcg7eeOUSAg5DhjOD4BikU7Ta?usp=drive_link\nキャラクターとしては大おしゃべり関西弁でお歌を歌います。\nゲーマーで歌と映画と舞台と服と寿司がすきです。\n\nまた、お友達に羊を２匹飼っています。\nこちらはもし描いて頂けたら嬉しいな、程度です。\n\n【特徴】\n・前髪だけ銀(白)髪で、あとは金髪\n・左耳に3連ピアス\n・左側に八重歯\n・ネイルをしている\n髪型やピアスの形、ネイルの色などは特にこだわりがありませんので髪などはものによっては伸ばしていただいても構いません。\n\n【雰囲気・服装・構図】 \n服装は共有したあさはねむゐの衣装ではなく、織田様の得意とする分野で自由に描いて頂きたいです。\n(特に水色の上着を着ている服は避けていただきたいです、資料としての共有のみですみません)\n髪型も自由なので色の特徴さえ押さえていただければご自由に遊んでください。\n\n【使用用途】\n・サムネイル、Xでの投稿画像などの活動での使用\n・また、待ち受けやネットプリントなどでのリスナーへの無料配布も行えればうれしく思います。\n(難しい場合は記載いただけますと幸いです)\n\n【他】 \n背景と人物を分けてPSDでの納品が好ましいです。\n\n以上になります、内容をご確認の上、ご縁がありましたら是非よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oda_utk/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3783437a/uploads/origins/a66d9fc4-7535-4a19-a49d-b787df761fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9331af23bfe661530e6f1ef039ab0e17", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2473812, "client_id": 3357792, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 62759, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "山吹色", "screen_name": "bukiiro", "avatar_url": "https://pbs.twimg.com/profile_images/1510825466865008641/CY5HAeys.jpg", "header_url": "https://pbs.twimg.com/profile_banners/458234440/1644456464/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 176}, {"id": 727043, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "神人@ロー誕準備中", "screen_name": "shinto_s", "avatar_url": "https://pbs.twimg.com/profile_images/1971571808668426240/hBZTfH6m.jpg", "header_url": "https://pbs.twimg.com/profile_banners/625336814/1714071216/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_accept