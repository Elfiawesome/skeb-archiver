12a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=752d9f5bce2bc84106affe2f18e4d2d5", "src_set": ""}, "body": "私がVRChatで使用しているアバター「つみげ」のイラストをお願いします。\n希望ポーズなど\n・眼鏡有\n・立ち\n・リバーシ(オセロ)の石をコインのように弄んでいる\n・ちょっと悪そうな顔\n\n希望差分\n・宛名あり&なし\n\n主に使用する用途\n・X(Twitter)/VRChatなど、各種SNSでのアイコン\n・VRChatの自作ワールドへの使用\n\nhttps://drive.google.com/file/d/1TY4DmsNIW7TBx2BiBdzY0qhCkOUtue5j/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yakko_Picture/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 737502, "client_id": 1798206, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3559a48f/uploads/origins/ec3801c8-8b77-481d-b33c-3decf58b6494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e94d2083c8cf5f0fc48ed8c5d58500c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3559a48f/uploads/origins/ec3801c8-8b77-481d-b33c-3decf58b6494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9375a40930e3714026470d1e92cc0542", "src_set": ""}, "body": "こんにちは。\n今回VRChatで私が使用しているアバターを描いていただきたいと思い、リクエストさせていただきました。\nカメラを片手に世界を巡り、風景や人物を写真に収めていく、旅する写真家な女の子です。\n\n・アバターは「Rono」を改変したものです。\n・一眼レフカメラを肩から掛けており、バックパックにはフラッシュライト、三脚、旧VRCカメラのストラップを装着。\n\nカメラは肩に掛けている状態でも手に持っていても構いません（身に付けていなくても構いませんが写真家であることが分かるとうれしいです）\nそれ以外のアクセサリー等の有無、ポーズや構図はすべておまかせさせていただきたいと思います。\n\n描いてくださったイラストはTwitterやVRChat上への投稿やプロフィールとして使用させていただきたいと思っています。\nアバターのBOOTHリンク（https://booth.pm/ja/items/3011302）\nカメラのモデルのBOOTHリンク（https://namisan.booth.pm/items/2993622）\n他参考画像\n（https://drive.google.com/drive/folders/1OWP4KEy9SqifR7MhBv4Rsi3pmCBDWJNF?usp=sharing）", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yakko_Picture/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 737502, "client_id": 79113, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/6f367f73-75f3-4961-a10f-021475dc6e14?response-content-disposition=inline&Expires=1761265774&Signature=bpAhs6Sxmck~R-fh80ixKMsuXA-U6VjsYM2fQDXwjrhy6jRC1cALNI68aRJTGAzMJ65DvYRZ77bOmxYjnpns0hI7bqi-uhl2qtAY8gtquiWNQs8H3lsL3-8xv3RogIoWA8vAy07lU-TlkvEOWxxa3bYW38lckSqnT5uCt7EVSYMyhIuetYYi6TDhb89aMpn6bdMjQpBW4~FYx3FE2eifOpnQpNah3pdZfSojRBe5~xAEi1TpKGsadzpzInUW-gPVp0Mh5hQdNEZWc-nIY8fWcxUN41loHOXFSFxvJkhGBLzzqSkiqvYIGR5WyvMYFXFyqGeNdjbdFrbn4F48TGpu8w__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1835335780140716032%2FZWi_kDNo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92eb2101d4a5f3936ad63c413257242c", "src_set": ""}, "duration": 35, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1835335780140716032%2FZWi_kDNo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b21766ce1bf4f054f5620cc7d876265d", "src_set": ""}, "body": "ずんだ餅を食べた感想を聞かせてほしいのだ！\nあと、踊り子ゆきミーシェちゃんを見た(描いた)感想も聞かせてほしいのだ！\nよろしくなのだ！", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@Yakko_Picture/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 737502, "client_id": 79113, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07b68a02/uploads/origins/1f1cf46b-36cf-4b47-89e1-c02ab83186b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69b0de1e4122141e6de0324c5b533601", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/07b68a02/uploads/origins/1f1cf46b-36cf-4b47-89e1-c02ab83186b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1b1765254bc963e2ca413bf1855138a", "src_set": ""}, "body": "踊り子ミーシェちゃんの絵を描いてもらってうれしかったので、本格的に描いてもらいたいと思いました～\n白い踊り子衣装で、煽情的なダンスをしているわたしの絵をお願いします。\n\n描いてくださった絵は踊り子ミーシェちゃんのBoothの画像や、Twitter、VRChatなどで使わせていただきたいと思っています。\n\nhttps://profile.yukiyukivirtual.net/", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yakko_Picture/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 737502, "client_id": 58149, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb075764/uploads/origins/bb720e33-740e-4305-88f0-ae4871081e86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27b4c9b1285bcad4b60ed8bb8d9c8c06", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb075764/uploads/origins/bb720e33-740e-4305-88f0-ae4871081e86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d6068e72e41ba6f40f3aa414e24a07f", "src_set": ""}, "body": "やころーさんはじめまして「えるえふ、」と申します。\nやころーさんのイラストに心惹かれて依頼させて頂きました。\n\n今回の依頼は、正月で晴れ着姿で羽根突き勝負に負けて、アイブラックのスティックで猫ひげ（鼻の頭を黒く塗られ、両頬に三本ヒゲ）を塗られている最中（相手側の視点で右頬と左頬には三本ヒゲを塗られ、最後にアイブラックのスティックで鼻の頭を黒く塗られている最中のところ）のうちの娘るいちゃんをお願いします。\n\n・塗りはアニメ塗りでお願いします。\n・野球少女ですが、羽根突きで晴れ着姿なので帽子は無しで、ただし鼻の白い絆創膏と目の下の逆三角のアイブラックはつけた状態でお願いします（鼻の絆創膏とアイブラックがギリギリ重なるか重ならないかぐらいの大きさでお願いします）\n・うちの娘るいちゃんの目の下のアイブラックはほんの若干薄めでお願いします。\n・鼻の絆創膏とアイブラックが猫ひげと必ず一部重なるようお願いします。（下記羽根突きイラスト参考絵参照）そして絆創膏は猫ひげより上、アイブラックは猫ひげより下に重なるようにお願いします。\n・左手に羽子板を持った姿で、反対の右手には羽根突きだと普通は筆ですが、筆ではなくアイブラックのスティックと羽根突きの羽根を持った状態でお願いします。（下記アイブラックのスティック参照）\n・羽子板は野球少女なので野球関係の道具が施されたデザインでお願いします。\n・晴れ着姿は白系統の色でお願いします。\n・白系の猫ミミカチューシャと白系の猫の尻尾をつけた状態でお願いします。\n・塗られている最中は、相手はるいちゃんの左頬を触りながら（触ってる手の一部がアイブラックのスティックで描かれた猫ひげを触ってる感じ）、右手に持ったアイブラックのスティックで鼻の頭を塗られてる感じでお願いします。またるいちゃん塗られてる顔の向きは真正面でお願いします。\n・るいちゃんの顔に描かれた猫ひげは太めでお願いします。（下記羽根突きイラストの2枚目の猫ひげぐらいの太さでお願いします。）\n\n以上が依頼になります。よろしくお願いいたします！\n\nうちの娘設定画像\nhttps://twitter.com/LyurmFabre/status/1343620348562948105\n\nるいちゃん羽根突きイラスト参考絵\nhttps://twitter.com/LyurmFabre/status/1550909103106428928\n\nアイブラックのスティック参照\nhttps://2minutes.shop/?pid=116533153\n（サイズ的に口紅と同じ大きさになります。透明のガラスを外して、文字の部分を捻るととがった黒い部分が出る仕組みです。イメージより結構太目の線が出ます。）", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yakko_Picture/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 737502, "client_id": 568594, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23db4a11/uploads/origins/b48ed20b-2dc3-43bd-bd37-dd4d8c844f9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60f6fb36d4286bfeff8dc4772cc3006e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23db4a11/uploads/origins/b48ed20b-2dc3-43bd-bd37-dd4d8c844f9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e94c45eddd1759534e7b9a1aa27cd681", "src_set": ""}, "body": "こんにちは。先日辻描きして頂いた赤髪の桔梗ちゃんを使ってたコイン精米機です。\n\n資料にあるうちのフィリナちゃんをお願いします。\nポニテであることがわかると喜びます。\nその他おまかせです。\n\nhttps://drive.google.com/drive/folders/1kRogaAFPVArJ0tQBnG7IRj8HR7l_p3l6", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yakko_Picture/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 737502, "client_id": 598254, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5dd84b4/uploads/origins/cc4a1915-8b4d-43e3-a9f0-5b24f1628428?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8368ef3ef9e7e07e3179ff7552297e3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5dd84b4/uploads/ori