毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の子です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。一人の時や知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘でかずは様の絵柄でのイラストをどうかお願いしたいです。\n衣装は設定画のうちの一つで、他はご自由にお願いします！\nご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 11019, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "子野日🌸お仕事募集中", "screen_name": "Neno_Vi", "avatar_url": "https://pbs.twimg.com/profile_images/1912836218632761344/NS4MjNOw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/857168694174248960/1779260924/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 712934, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ぽぴち_skeb再開未定⏹️", "screen_name": "popichi_skeb", "avatar_url": "https://pbs.twimg.com/profile_images/1716958295968350208/DO8prkAO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1930971415/1724440757/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 1375806, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ご", "screen_name": "go_e_0000", "avatar_url": "https://pbs.twimg.com/profile_images/2039623400126398464/-9CxFqBs.jpg", "header_url": "