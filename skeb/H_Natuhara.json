ranscoder": "", "creator_acceptable_same_genre": false}, {"path": "/@H_Natuhara/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2793629, "client_id": 2617582, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0cb56308/uploads/origins/ac12085f-b215-466e-ba2f-5696c5286f28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78d69d83c6302c3205d45598b22d822a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0cb56308/uploads/origins/ac12085f-b215-466e-ba2f-5696c5286f28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b97a479d7611d489852c5350357e3c96", "src_set": ""}, "body": "こんにちは！\nいつも素晴らしいイラストをありがとうございます！\n\n今回は、前回の\nhttps://skeb.jp/@H_Natuhara/works/4\nの続きのイラストをお願いしたいです。\nエロゲの触手妊娠ENDみたいなイメージ。\n\nカレンちゃんとさゆりちゃんがあの後もずっと触手に犯され続け、最終的に妊娠・出産を繰り返しているイメージです。いわゆる苗床。\n触手に針を刺され、おっぱいや乳首が肥大化されると更に嬉しいです。\n（おっぱいで妊娠させてもいいですよ・・・）\n触手により、どの穴でも妊娠できるように改造される・・・とか。\n\n妊娠・出産を繰り返す内に、自分たちが産んだ子供に愛着が出てくる。\nそして快楽を受け入れて二人で触手の苗床に墜ちる。。。\n\n触手にやらせたいことはなんでもやらせてあげてください！\n構図についてもお任せします。\n\nその他不明な点や修正箇所は全てアルさんのご判断にお任せします。\n\n今回も素晴らしい触手イラストをお願いしたいです。\nご検討をお願い致します。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@H_Natuhara/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2793629, "client_id": 1366155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11da360d/uploads/origins/704dc612-8bc5-47f6-856b-215dcddf0e42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8246f74792039c24f46935a56a507b2a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11da360d/uploads/origins/704dc612-8bc5-47f6-856b-215dcddf0e42?bg=%23fff&auto=format%2Ccompress&fm=webp&f