blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be3ae55cd3696299ff13bbb57ac404a4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774816278685122560%2FadabYrSs.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5abf628505d3ac52e31a0632ce8c6752", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774816278685122560%2FadabYrSs.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5abf628505d3ac52e31a0632ce8c6752, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774816278685122560%2FadabYrSs.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6571e9e11b849127972d49c2bb980ba0 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774816278685122560%2FadabYrSs.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6637b81915e9a272e432410f82ae15c3 3x"}, "body": "矢矧が作戦会議中に失禁する、矢矧の一人称視点(多少は視点が動いても問題ないです)の小説をお願いしたいです。\n展開としては、事前にトイレに行き損ねた矢矧が、会議中に座席で失禁し、阿賀野に後始末をしてもらうというものです。\n\n会議には阿賀野型の他に、重巡以上の先輩艦娘も参加していて、阿賀野型は全員「性能は優秀だが、最近建造されたばかりの新入り」といった立ち位置です。\n艦娘の性格、他の登場艦娘、鎮守府・会議の設定などについては、おまかせします。\n\nまた、できれば次の2点を入れて頂きたいです。\n\n1.会議中、先に阿賀野がトイレに行きたいことを告げ、許可は貰えるものの、その際に能代が「皆さんのお時間を頂いているのに」「姉妹艦として恥ずかしい」といったニュアンスのことを言ったため、同じくトイレを我慢していた矢矧は言い出すことができなくなる。\n\n2.会議終了後、失禁していて椅子から立ち上がることのできない矢矧の様子に、阿賀野だけが気付いており、阿賀野は適当な言い訳をして二人だけで会議室に残り、(珍しく)姉らしい優しさを見せながら、矢矧の後始末を手伝う。\n\n我慢の様子や、決壊までの流れ、失禁後の描写は、全ておまかせ致します。", "nc": 176, "word_count": 6150, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@ogerwillow/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 635008, "client_id": 457984, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9e37653/uploads/origins/73a24ccb-5d88-4f9f-9c54-c0f0dac1cf6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f5a6e0d19170fc26555ee1fc98b30a9", "srcset": "https://si.imgix.net/b9e37653/uploads/origins/73a24ccb-5d88-4f9f-9c54-c0f0dac1cf6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f5a6e0d19170fc26555ee1fc98b30a9, https://si.imgix.net/b9e37653/uploads/origins/73a24ccb-5d88-4f9f-9c54-c0f0dac1cf6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe26022d6b81b966c9b377c9786ec318 2x, https://si.imgix.net/b9e37653/uploads/origins/73a24ccb-5d88-4f9f-9c54-c0f0dac1cf6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08c7e04eee56bfbc05b7c7a358dd7aea 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9e37653/uploads/origins/73a24ccb-5d88-4f9f-9c54-c0f0dac1cf6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f27a39420c139599653f3b827b6bba07", "srcset": "https://si.imgix.net/b9e37653/uploads/origins/73a24ccb-5d88-4f9f-9c54-c0f0dac1cf6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f27a39420c139599653f3b827b6bba07, https://si.imgix.net/b9e37653/uploads/origins/73a24ccb-5d88-4f9f-9c54-c0f0dac1cf6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6