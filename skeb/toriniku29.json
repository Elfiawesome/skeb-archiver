b3-2d9a5d3b0480?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70414201495e90ff4db357c804e37b2b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4228e34e/uploads/origins/57be1b78-15c6-4513-a2b3-2d9a5d3b0480?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=348d30e6e67af421c2f14d8d35c60eb1", "src_set": ""}, "body": "鶏肉様\n\n個人でVtuberをしている深海ギンと申します\n\nいつも素晴らしいイラスト(語彙力がなくて申し訳ないです…)拝見させていただいております\n\n鶏肉様の大きい葵ちゃんやゲス顔のあかりちゃん大好きです\n総じてギザ歯の時が特に…\n\n現在リクエストができる状態でしたので、思わずこちらを送信させていただきました\n\n可能であれば、鶏肉様に私を描いていただきたいです\n\n以下詳細\n・範囲は可能であれば全身(難しければ上半身)\n・使用用途はSNSやYouTubeのサムネイル(横が切れていると使用が難しい場合があるので、イラストの左右が切れてなければ嬉しいです)\n・背景透過のイラストをいただければ嬉しいです\n・1920×1080である程度拡大しても問題ない大きさ\n\n御一考どうかよろしくお願いいたします\n\nhttps://twitter.com/fukami_gin/status/1845073179347206441?s=46&t=HLHLGzRn_ZHSYTM5d0DRvw", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toriniku29/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2360827, "client_id": 3485107, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb8d684a/uploads/origins/8883a05a-a99a-4d60-b837-ea74e6349c16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d51d37ef0fc566a648cad4c4a8869d87", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb8d684a/uploads/origins/8883a05a-a99a-4d60-b837-ea74e6349c16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff59cef2cdfb1203cd4b176ca03a3660", "src_set": ""}, "body": "鶏肉様初リクエスト失礼します\n氏のむちむちもっちりのボイロキャラのイラストとても楽しく拝見しています\n今回はcevioのone_-aria_on_the_planetes-をもっちり体型にして描いてもらいたいです\n内容は以前は運動をしていて痩せていたが、油断して運動をサボり食べ過ぎた結果太って体型がもっちりしてしまい以前のスレンダーな体型の時の写真と比べて危機感を感じているというイラストをお願いしたいです\n衣装はもっちり時スレンダー時両方共スポブラとショートパンツでもっちり体型はこのxのポスト（https://x.com/toriniku29/status/1793630671103279384)のキャラクター達の、特に紲星あかりの様ににお腹をできる限りもっちりにして欲しいです。可能なら氏が描ける限界までお腹を重点的にもっちりむちむちな体型にしてほしいです。スレンダー体型は運動をしている為、軽く腹筋が割れ、引き締まった健康的なスレンダー体型でお願いします。スレンダー時の写真では全身を写し、太らないからと調子に乗って両手にはタピオカミルクティーやハンバーガーなど高カロリーな食べ物を食べようとしている風にして欲しいです。氏が描く葵ちゃんやゆかりさんの様なクールな雰囲気でOИEちゃんを描いて貰えると嬉しいです。ただ、氏が思うOИEちゃんのイメージがある場合は無理せずそちらを優先して欲しいです。\n長文になり失礼しました。ご一考の程宜しくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toriniku29/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2360827, "client_id": 32721, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3839e287/uploads/origins/6b033943-a27e-465c-b31d-4b65f80932ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd7199e82d5f9e87775fa84b6bd14030", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3839e287/uploads/origins/6b033943-a27e-465c-b31d-4b65f80932ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5127eedb395888a10272bc89ffba91b7", "src_set": ""}, "body": "いつも素敵なイラスト拝見させていただいています。\n私のオリジナルキャラクター、アカシャのイラストをお願いしたく依頼させて頂きます。\n春らしいかわいらしいファッションでお願いします。\n表情、ポーズ等はお任せ致します。\n\nhttps://x.com/syakoba3/status/1845404117096608064", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toriniku29/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2360827, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/49a8f85e/uploads/origins/2a7ed164-5789-4629-b07b-7aaee1ac1001?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df024c9debeecace89383ccf41be0cfc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https: