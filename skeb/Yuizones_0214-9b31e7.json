200&s=32d8cbba546ef9cc1a5d762ac2da3de4 2x, https://si.imgix.net/9ae5fb80/uploads/origins/1780a96d-5404-4f46-8236-176df7f2f3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08f813a8265febf26e567c64f6deceb4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ae5fb80/uploads/origins/1780a96d-5404-4f46-8236-176df7f2f3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d94fe97a405175125f6e794b4f9790b", "srcset": "https://si.imgix.net/9ae5fb80/uploads/origins/1780a96d-5404-4f46-8236-176df7f2f3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d94fe97a405175125f6e794b4f9790b, https://si.imgix.net/9ae5fb80/uploads/origins/1780a96d-5404-4f46-8236-176df7f2f3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=70bde4cdb2707f562554abecfd592c8b 2x, https://si.imgix.net/9ae5fb80/uploads/origins/1780a96d-5404-4f46-8236-176df7f2f3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95d909803386c22c1ef78953bda05c16 3x"}, "body": "こんにちは！あなたのデザインに感銘を受けたので、ぜひお願いしたいと思っていたのですが......！\n\n私のキャラクターの新しいコスチュームを描いていただけませんか？彼はビジュアル系バンドのドラマーで、主に和服を着ています。衣装は2種類考えています：\n\n1.1.着物をベースに、モダンやサブカルチャーの要素を取り入れた衣装。これが最もキャラクターらしい選択肢だ！\n2.占いが趣味なので、ファンタジーや超常現象の影響を受けた古風な和服。普通のスタイルではないので、これは面白いと思う！\n\n上記の中から、一番魅力的に思えるテーマを選んでください！正面と細部のみでもOKです。三面全部描く必要はありません。\n\nコスチュームはダークカラーを中心にお願いしたいのですが、お好みで明るい副色やアクセントカラーを加えてもかまいません。また、彼の黒く日焼けした肌の色にも注意してください。\n\nよろしくお願いします！機械翻訳で変なところがあったらすみません。\n\nhttps://drive.google.com/drive/u/1/folders/1gAIRiRalrZpFcnDdwmw5-Kor6r9VrH74", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yuizones_0214/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3216588, "client_id": 2928251, "vtt_url": null, "thumbnail_image_urls": {"src": "ht