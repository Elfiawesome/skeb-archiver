2966005935b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe995edb8155110aa665a3d3102e076f 2x, https://si.imgix.net/27336d1b/uploads/origins/a089af88-10fb-4536-8861-2966005935b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f85803572aae5c1befde2073e8db7cf7 3x"}, "body": "リィサ様\n\n個人Vtuberとして活動しています。沁晦とまると申します。\nお見掛けしたイラストがすごく好みで、ご連絡致しました！\n\n■描いてほしいキャラクター\nオリジナルキャラクター「沁晦とまる」を頂けますと幸いです。\n\n■イラスト内容\n頭や手などの上半身が見切れていないとありがたいです。\nお正月っぽい衣装でお願いしたいです。\nポーズ　お任せします。\n\n■使用用途\nTwitter,配信(基本：Youtube)などで活動用のイラストとして使用させて下さい。\n\n■ファイル形式について\n統合されていない人物透過のPSDデータだと幸いです。\n\n元旦に間に合いますと大変嬉しいです。\nよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1Xd4MYd4h5KgX5hSPsbTz2RpTRLGKpIyE?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@R__ryi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1812176, "client_id": 1815889, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fab3e9b/uploads/origins/23d32222-39cc-4a13-a45c-46b2da4fcefc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6868fb1b6712ed3f2958c05179a55bca", "srcset": "https://si.imgix.net/6fab3e9b/uploads/origins/23d32222-39cc-4a13-a45c-46b2da4fcefc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6868fb1b6712ed3f2958c05179a55bca, https://si.imgix.net/6fab3e9b/uploads/origins/23d32222-39cc-4a13-a45c-46b2da4fcefc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c9574047a9f72b0013b49dabb8f56df 2x, https://si.imgix.net/6fab3e9b/uploads/origins/23d32222-39cc-4a13-a45c-46b2da4fcefc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b49c4d431a6fb1e92a8b6b25b55dcca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6fab3e9b/uploads/origins/23d32222-39cc-4a13-a45c-46b2da4fcefc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e17e79280afb4dc231037abfd36d2397", "srcset": "https://si.imgix.net/6fab3e9b/uploads/origins/23d32222-39cc-4a13-a45c-46b2da4fcefc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e17e79280afb4dc231037abfd36d2397, https://si.imgix.net/6fab3e9b/uploads/origins/23d32222-39cc-4a13-a45c-46b2da4fcefc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=73a0436de45d811e5b053dc667f60fd3 2x, https://si.imgix.net/6fab3e9b/uploads/origins/23d32222-39cc-4a13-a45c-46b2da4fcefc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=86a385a3e849a36688943419f42c412b 3x"}, "body": "リィサ様\n\n初めまして！個人Vtuberの牛タン 紅狐🦊🎀と申します。\nリィサ様のskebやTwitterで素敵なイラストを拝見しまして、\nどれもとてもかわいらしく綺麗で素敵なもので、リィサ様が描く紅狐を見てみたい…！と、\n思いご依頼させていただきました。\n\n【参考資料】\nhttps://drive.google.com/drive/folders/130PRAoRw96ByGIi97N5gsT1xnsa5uxhy?usp=sharing\nhttps://youtu.be/i3m2YeE-R1U\n\n【性格・イメージ】\n明るい元気な気分屋の女の子です。\n\n今回は来年の兎年に向けてのイラストを、\nご依頼させていただきたいと思いました。\n\n・衣装：着物\n・羽子板や千歳飴などお正月らしきものなんでも大丈夫です。\n　(あると嬉しいです）\n・兎年なのでうさぎちゃん\n\n\n描いていただいたイラストは、\nSNSやYoutubeなどのサムネなどVtuberの各活動場面で使用したいと考えております。\n構図や背景や衣装などアレンジしていただいても大丈夫です。\n(可能でしたら、背景透過のデータもいただけると嬉しいです。）\n\n\nお忙しいところ大変恐縮ですがご検討のほどよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@R__ryi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1812176, "client_id": 406099, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/020252b3/uploads/origins/b711f625-f2da-48ce-a30b-b70f98bd6bb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76b7f794c26c498b7efd1148d483f727", "srcset": "https://si.imgix.net/020252b3/uploads/origins/b711f625-f2da-48ce-a30b-b70f98bd6bb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit