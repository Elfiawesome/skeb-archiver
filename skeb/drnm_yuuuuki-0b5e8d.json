q5eVKdbCNA&s=19\n\n【要望内容について】\n衣装などはなるべく上記の衣装にしていただきたいです。\nポーズや表情はお任せで、ひりやさんの趣味全開でお願いできたらと思っております。\n\n文字などがある場合、人物と別々にしたデータで納品していただけますと幸いです。\n\n【ファイル形式について】\nファイル形式はpng又はpsdデータにてお願いできればと思っております。\n\n\n以上、よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 529427, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🦔おてん🦔", "screen_name": "if959u", "avatar_url": "https://pbs.twimg.com/profile_images/1406272195551055876/lM_zqnxg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/790832008561692672/1687880086/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 128}, {"id": 1029971, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "🌱Aoi Ichizaki@skebやってます", "screen_name": "egoister_0206", "avatar_url": "https://pbs.twimg.com/profile_images/1422226371439255554/pMloP7Z0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2414442530/1779024110/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 0}, {"id": 3135825, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "おず OZ", "screen_name": "oznooekaki", "avatar_url": "https://pbs.twimg.com/profile_images/2035566321493217280/snrRSVP2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1761915227845939200/1745585635/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_