4-4e38-a156-938e1255b274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1730650e26767d57e0617d9bae69876c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/116fbe17/uploads/origins/857683f9-6294-4e38-a156-938e1255b274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf12461ab3070d807cf8fe2012586392", "src_set": ""}, "body": "犬甘ぽみ様、アピールありがとうございます。\nエモンガのことに興味を持っていただき光栄です。\n犬甘ぽみ様の作品拝見させていただきました。\nどのイラストもとても可愛く素敵だと思いました。\n是非、彼女のことを描いていただきたいです。\nよろしくお願いします。\n\n・キャラ\nアピールいただいたエモンガ(擬人化)\n\n・構図等\n特に指定はありません。\n思うように可愛く描いていただければと思います\n\n・形式\n可能であればpsdファイルで背景等とレイヤーを分けていただけますと幸いです。\n\n以上、ご検討よろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@potarou_pomi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3261912, "client_id": 2793996, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22e8711a/uploads/origins/373f68ee-6fd5-4065-9f64-45103b704b3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=597bd4e44751f82a15bb490d00286f99", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22e8711a/uploads/origins/373f68ee-6fd5-4065-9f64-45103b704b3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d9cf0948185a4f23cd6e794609f9796", "src_set": ""}, "body": "こんにちは！お返事が遅くなって申し訳ありません。\n\n素敵な作風だと思うので、学園モノのような絵の提案に興味があります！私の金髪のキャラクターは18歳なので、適切なアイデアだと思います。私は日本の学校がどうなっているのか知らないので、制服や備品などの詳細はお任せします。彼女が90年代のファッションやレトロなテクノロジーを愛していることを示すようなものを付け加えられたらクールだと思いますが、これはオプションです。何を描いても自由なのが一番だと思います！だから、彼女の外見は、あなたがベストだと思うものに変えることができます。\n\n参考になればと思い、いくつか追加しました！\n\nよろしくお願いします！\n\nhttps://www.dropbox.com/scl/fo/d95vhcculgpll5dt4zx17/ACgUHk9hWEODYrufnR9yhuk?rlkey=fahhmkdw5pljaqhb7logwepnk&st=11fsi5n2&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@potarou_pomi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3261912, "client_id": 3310365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52da3374/uploads/origins/33cb4ec8-85d8-46f8-8dcf-4df35ffa983e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4087d14d0fd5f2f87b2db0b1b777df88", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52da3374/uploads/origins/33cb4ec8-85d8-46f8-8dcf-4df35ffa983e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dc2ea046c7542b817453a62388a92ec", "src_set": ""}, "body": "Xで見かけるマヤノトップガンの\nイラストの絵柄がとても好きなので \nアイコンをイラストをお願いしたいです！\n\n  ・要望 \n現在Xでのアイコンのキャラクターを元に \n自分に似せたキャラクターを描いて\nいただきたいです。 \n\n参考資料\nhttps://x.com/yuppy_1205\n\nまた、子供（0歳）がいるので \n赤ちゃんを抱っこしているような感じで\n一緒に 子供も描いてもらいたいです！ \nポーズや構図はお任せします。 　\n\n基本の絵柄はマヤノトップガンの\nイラストの様な 絵柄だと嬉しいです！ \n\n  ・使用用途 \n頂いたイラストはSNSアイコンとして使用したいと思っています。 \n\n よろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@potarou_pomi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3261912, "client_id": 13036, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8bc3268d/uploads/origins/a8073686-4a0b-4f11-9860-c76ef7eb7ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e17a0e3d86014e9f65b2a6a2566c03b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8bc3268d/uploads/origins/a8073686-4a0b-4f11-9860-c76ef7eb7ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78bc964f7264ca882cd60f5aea9d5d10", "src_set