ャラクター詳細です\n\nメロシェ\nおっとりしているが狡猾でよく人を騙す。その割に自分も騙されやすい。友達がいない。\n飴と羊、学生服がモチーフ\n\n\n構図はお任せします。衣装が2種類ありますが、どちらで描いても構いません。また、アレンジなども歓迎です。\n\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1wnamiJ55HLG6VfJTsRBmCqwS81Ch9NJU", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kumonahi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4122334, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea0adc32/uploads/origins/994b2a95-301b-4775-aefb-3dcd7a846265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7056b133d8cb4daaf517472a1c2c93a4", "srcset": "https://si.imgix.net/ea0adc32/uploads/origins/994b2a95-301b-4775-aefb-3dcd7a846265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7056b133d8cb4daaf517472a1c2c93a4, https://si.imgix.net/ea0adc32/uploads/origins/994b2a95-301b-4775-aefb-3dcd7a846265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09c1b95a6ee5463b07cea0d5fdf35d6f 2x, https://si.imgix.net/ea0adc32/uploads/origins/994b2a95-301b-4775-aefb-3dcd7a846265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2cd765de345161b875a6d5c4087dc46 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea0adc32/uploads/origins/994b2a95-301b-4775-aefb-3dcd7a846265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e9a5a6fe0130aacc675628a56234a4d", "srcset": "https://si.imgix.net/ea0adc32/uploads/origins/994b2a95-301b-4775-aefb-3dcd7a846265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e9a5a6fe0130aacc675628a56234a4d, https://si.imgix.net/ea0adc32/uploads/origins/994b2a95-301b-4775-aefb-3dcd7a846265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7768777d712d282a8