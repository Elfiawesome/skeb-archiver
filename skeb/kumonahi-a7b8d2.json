です。\n\n私のキャラクター、連邦捜査官のキャラクター[REF1]を、[REF2]と同じポーズで、携帯電話を持っている姿で描いていただきたいです。表情は[REF3]のような感じにしてください。\n\n以上です。ありがとうございます。\n\nhttps://drive.google.com/drive/folders/18b_inCHzOSgn16-Lwy9yLEN5CEikwg68?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kumonahi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4122334, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/967a5b3c/uploads/origins/3292791c-51ad-4b9a-9e63-dd113eb360dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fab72a9dc668f9af5f1c80ea604631f0", "srcset": "https://si.imgix.net/967a5b3c/uploads/origins/3292791c-51ad-4b9a-9e63-dd113eb360dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fab72a9dc668f9af5f1c80ea604631f0, https://si.imgix.net/967a5b3c/uploads/origins/3292791c-51ad-4b9a-9e63-dd113eb360dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c9cdb76452c17638cbf39e8765df9e3 2x, https://si.imgix.net/967a5b3c/uploads/origins/3292791c-51ad-4b9a-9e63-dd113eb360dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d260af3d35aeda7f89bbc1b4aac53d57 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/967a5b3c/uploads/origins/3292791c-51ad-4b9a-9e63-dd113eb360dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9638f7a32dfd6c39479ed2c91cdff8b8", "srcset": "https://si.imgix.net/967a5b3c/uploads/origins/3292791c-51ad-4b9a-9e63-dd113eb360dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9638f7a32dfd6c39479ed2c91cdff8b8, https://si.imgix.net/967a5b3c/uploads/origins/3292791c-51ad-4b9a-9e63-dd113eb360dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e819f18d378b48ee23bb7afc92e6ae6 2x, https://si.imgix.net/967a5b3c/uploads/origins/3292791c-51ad-4b9a-9e63-dd113eb360dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc3e55b436c91bb91a73f9cb27976b72 3x"}, "body": "くもなひさんへ\n\n初めまして…！\nVTuberとして活動しております、うみねこ ほたてと申します！！\n\n新着にて くもなひさんの作品を拝見し、優しい絵柄やふわっとした塗りがとても可愛らしかったのでぜひ私のキャラクター(うみねこ ほたて)も描いて頂きたく、リクエストさせていただきました…！\n\n以下リクエスト内容となります。もしご縁がありましたらこちらを描いていただきたいです…！\n\n\n▶︎ うみねこ ほたてのイラスト\n\nポーズはお任せいたします！\nぜひくもなひさんのお好きなテイストで楽しく描いていただければと思います！\n\nお洋服はドライブ内の②新衣装で願いしたいです…！\n(もし描写しにくい点や分かりにくい点がありましたら、省略・改変して頂いても問題ありません！)\n\nその他キャラクター設定などもドライブ内にございます！\n\n\n配信サムネイル、活動に伴うSNS運用で使用させて頂きたいため、顔周りの見切れが無い背景透過のファイルを頂けますと非常に嬉しいです…！\n\n※サムネイル素材等に合わせて少しだけ色味や明るさを編集する場合や、文字を重ねたりトリミングを行う場合があります…！\n\n\n条件が合わなければ、お手数お掛けいたしますがキャンセルして下さい…（ ;  ; ）\n\nご縁がありましたらぜひよろしくお願いいたします＞＜\n\nhttps://drive.google.com/drive/folders/1h7mZ9VGj_8MnW4XjGiso729eRjw3fEOY", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kumonahi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4122334, "client_id": 1621813, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f855bba/uploads/origins/310c9401-bb9d-4b17-a43e-b9ed215ad61a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1e57e44169fec1f851bf772e939755f", "srcset": "https://si.imgix.net/2f855bba/uploads/origins/310c9401-bb9d-4b17-a43e-b9ed215ad61a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1e57e44169fec1f851bf772e939755f, https://si.imgix.net/2f855bba/uploads/origins/310c9401-bb9d-4b17-a43e-b9ed215ad61a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f19f6312db0dade30216e035c081e4be 2x, https://si.imgix.net/2f855bba/uploads/origins/310c9401-bb9d-4b17-a43e-b9ed215ad61a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be29005afad626deeeef82ea2327ff9d 3x"}, "duration": nul