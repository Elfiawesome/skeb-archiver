乱雑で、片側に三つ編みで、後ろに少し長い、男性としてそれらを描いてください。服装やポーズの参考はgoogleドキュメントに入れた。\n\n私としては、私のキャラクターには社交的な服装をさせたいと思っています。参考資料にあるベストコートの女性のように、下はワインレッドのシャツで、彼のアクセサリーは任意にします。シルバーのバラのネックレスと羽のイヤリングで、彼女を女性として描いてほしいのですが、私は彼女が女性として描かれた参考資料をいくつか残しています（かわいいキツネ耳をつけるかどうかも、あなたの判断にお任せします）。\n\nポーズの構図は、私のキャラクターである紫色の髪の子は足を組んで座り（参考にしました）、私が座っているソファーに向かって立っています。\n\nhttps://drive.google.com/drive/folders/1MuQ4UL7ABJTXQvz59eux_LouUYXq7IAn?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ei_17_ei/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2731167, "client_id": 1733802, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da11a56b/uploads/origins/c375f8d1-d3c7-4b65-b7cd-fff9120e5613?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44437bc124074dc9ce1366f9ddf50f5d", "srcset": "https://si.imgix.net/da11a56b/uploads/origins/c375f8d1-d3c7-4b65-b7cd-fff9120e5613?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44437bc124074dc9ce1366f9ddf50f5d, https://si.imgix.net/da11a56b/uploads/origins/c375f8d1-d3c7-4b65-b7cd-fff9120e5613?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ff3ae96912050ed9f12ba19faa71d50 2x, https://si.imgix.net/da11a56b/uploads/origins/c375f8d1-d3c7-4b65-b7cd-fff9120e5613?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=242f64ac3e5021fb9c0ed0add8146274 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da11a56b/uploads/origins/c375f8d1-d3c7-4b65-b7cd-fff9120e5613?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d86402aed122ef6663e106f0dc36397", "srcset": "https://si.imgix.net/da11a56b/uploads/origins/c375f8d1-d3c7-4b65-b7cd-fff9120e5613?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d86402aed122