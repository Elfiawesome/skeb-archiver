いたします\n\n・人物１\n高見沢りり（たかみさわ りり）\n添付資料の茶髪の子です。ヨーヨー釣りの水風船を持っている。その他所持品などはお任せです\n\n・人物２\n辻村 希美（つじむら のぞみ）\n添付資料の黒髪の子です。齧りかけのりんご飴を持っている。その他所持品などはお任せです\n\n・背景\n二人の衣装＆雰囲気に合わせて、熊沢さわさんが描きやすい形にお任せしたいと思います\n\n◇参考資料\nhttps://www.dropbox.com/scl/fo/ksnzuxumcqo3fwrp67vwq/AIeKgvtLFKLZePGw_xyNa1s?rlkey=cihtbp75ou34ftz8ylj7f5us5&dl=0\n（容姿、雰囲気などのご参考になればと思います）\n\n◇使用用途\n個人（キャラクターそれぞれの所有者である私と友人）鑑賞目的です\nイラストはSNSのヘッダーなどに使用させて頂くかもしれません\n\nまた、宛名をレイヤー分けして頂けると幸いです\n\n以上、ご検討宜しくお願い致します\n\nhttps://www.dropbox.com/scl/fo/ksnzuxumcqo3fwrp67vwq/AIeKgvtLFKLZePGw_xyNa1s?rlkey=cihtbp75ou34ftz8ylj7f5us5&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kmzw_sw/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1319410, "client_id": 1484114, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc1bab89/uploads/origins/1035732e-47c5-41fb-961b-0714022ebbab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc61ddecc9cb27ea636f4b7dc5b52da3", "srcset": "https://si.imgix.net/dc1bab89/uploads/origins/1035732e-47c5-41fb-961b-0714022ebbab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc61ddecc9cb27ea636f4b7dc5b52da3, https://si.imgix.net/dc1bab89/uploads/origins/1035732e-47c5-41fb-961b-0714022ebbab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99ce1af506d10168119eef3114dd34a6 2x, https://si.imgix.net/dc1bab89/uploads/origins/1035732e-47c5-41fb-961b-0714022ebbab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9c676a040635465ac0c422d514ef748 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc1bab89/uploads/origins/1035732e-47c5-41fb-961b-0714022ebbab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37d2d3e2e7a284f7913d832271ca7141", "srcset": "https://si.imgix