ord等)で利用させていただければと思います。  \n納品はPSDファイルでお願いします。 \nよろしくお願いします。\n\n  [設定・資料] \nうるかちゃん \n・一人称「あーし」\n ・ウルフカット \n・ダウナー系\n ・普段は表情の機微が乏しい \n・外面営業スマイルとかはできる \n・身長145cmくらい  \n\nキャラ資料 \nhttps://www.dropbox.com/scl/fo/2zyc2f3anbrpnoka984pc/AEn9JYdJnnsV7E5mSc8k4n8?rlkey=d4435p2te6cvts0t1o5g3wx56&dl=0", "nc": 35, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mikenko2n5/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3926621, "client_id": 362407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bc4d2a0/uploads/origins/47f9ea11-139b-45fd-abc6-8ae42bc070ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aeff644fef73efcc6cfc89817e357cd4", "srcset": "https://si.imgix.net/5bc4d2a0/uploads/origins/47f9ea11-139b-45fd-abc6-8ae42bc070ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aeff644fef73efcc6cfc89817e357cd4, https://si.imgix.net/5bc4d2a0/uploads/origins/47f9ea11-139b-45fd-abc6-8ae42bc070ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3deb4920c017feac71cf73638e4796c1 2x, https://si.imgix.net/5bc4d2a0/uploads/origins/47f9ea11-139b-45fd-abc6-8ae42bc070ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40807622defb16446c54f35518178401 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5bc4d2a0/uploads/origins/47f9ea11-139b-45fd-abc6-8ae42bc070ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77aa874739917d7055c2e29aea536c95", "srcset": "https://si.imgix.net/5bc4d2a0/uploads/origins/47f9ea11-139b-45fd-abc6-8ae42bc070ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77aa874739917d7055c2e29aea536c95, https://si.imgix.net/5bc4d2a0/uploads/origins/47f9ea11-139b-45fd-abc6-8ae42bc070ff?bg=%23fff&auto=format%2Cc