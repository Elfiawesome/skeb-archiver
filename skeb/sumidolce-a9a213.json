e-a6911a2cae6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3317fc11e062f89a39d8e6cebc6471ef 2x, https://si.imgix.net/a7302bc9/uploads/origins/2cf44811-15cb-424e-bfde-a6911a2cae6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0070be59733a84a43c23a77d58a3b127 3x"}, "body": "初めまして。\nいつもイラスト楽しませて頂いております！\n服装の細部までお洒落に仕立てられおりとても素敵です……！\nこの度リクエスト受付再開とのことで、自分のOCを服装アレンジでお願いしたいです。\nご検討の程よろしくお願いいたします！\n\n◆或香（Alca）\n・愛用の天球儀を媒体にして星魔法を使う、占星術師の女の子です。身長は160cm前後です。\n・落ち着いた性格ですが、アクティブな面もあります。\n・濃紺色の髪、金色の眼、黒と青を基調・金をワンポイントとした服装です。\n・家では天文台の付いているちょっと変わった洋菓子店をやっており、星や星空をモチーフとした様々なお菓子を売っています。\n・服装につきましては、お好きなようにアレンジして頂けると嬉しいです！\n\nhttps://drive.google.com/drive/folders/1_SBwLN-lB7VnCTXbF9FQiAHo4ZBzg8yH?usp=sharing\nhttps://drive.google.com/drive/folders/14zrTes4sb7kgPPu_Cj7KMQxv9py7U7nd?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sumidolce/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1356051, "client_id": 3342903, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01a5c17a/uploads/origins/c0fbf8f6-4fc9-437e-b979-848bdef22147?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff86597df673e663acc556014a70d952", "srcset": "https://si.imgix.net/01a5c17a/uploads/origins/c0fbf8f6-4fc9-437e-b979-848bdef22147?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff86597df673e663acc556014a70d952, https://si.imgix.net/01a5c17a/uploads/origins/c0fbf8f6-4fc9-437e-b979-848bdef22147?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ed152b23c4b21673d37f83e9419786f 2x, https://si.imgix.net/01a5c17a/uploads/origins/c0fbf8f6-4fc9-437e-b979-848bdef22147?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7c6ef3e368d6306999ae5e8519d656d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01a5c17a/uploads/origins/c0fbf8f6-4fc9-437e-b979-848bdef22147?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f809b6dffe488ece85a882b9e4534eaf", "srcset": "https://si.imgix.net/01a5c17a/uploads/origins/c0fbf8f6-4fc9-437e-b979-848bdef22147?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f809b6dffe488ece85a882b9e4534eaf, https://si.imgix.net/01a5c17a/uploads/origins/c0fbf8f6-4fc9-437e-b979-848bdef22147?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5fb28df7564556a957d459293ad7fae1 2x, https://si.imgix.net/01a5c17a/uploads/origins/c0fbf8f6-4fc9-437e-b979-848bdef22147?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d869bb9c0c01cd13f5fdd54039982a5 3x"}, "body": "親愛なるすみすさん、私はあなたの画風がとても好きです。私のキャラクター、スジブルーを描いてほしいです。彼女はブルーベリーをテーマにしたスライムの女の子で、頭に覚醒魔法使いの帽子をかぶっています。彼女の参考画像を添付します。スージーをかわいい服装で描いてください。魔法使いの帽子をかぶっていれば、どんなスタイルでもOKです。\n\nhttps://drive.google.com/drive/folders/10O-u2rwClxFIN4XMTekRq5Tsis931uCV?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sumidolce/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1356051, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a9349a9/uploads/origins/600b3467-bd9e-431b-8351-a7a88dae6ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6878275e8cca2b2b25cd0a6fef45885e", "srcset": "https://si.imgix.net/1a9349a9/uploads/origins/600b3467-bd9e-431b-8351-a7a88dae6ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6878275e8cca2b2b25cd0a6fef45885e, https://si.imgix.net/1a9349a9/uploads/origins/600b3467-bd9e-431b-8351-a7a88dae6ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fcd861dc4b3aa06876398a0fd29eba3b 2x, https://si.imgix.net/1a9349a9/uploads/origins/600b3467-bd9e-431b-8351-a7a88dae6ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66e61b20a0b931c4adc4ce003420cbdb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a9349a9/uploads/origins/600b3467-bd9e-431b-8351-a7a88dae6ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de71aa8125fca22394729db6d031e844", "srcset": "https://si.imgix.net/1a9349a9/uploads/origins/600b3467-bd9e-431b-8351-a7a88dae6ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de71aa8125fca22394729db6d031e844, https://si.imgix.net/1a9349a9/uploads/origins/600b3467-bd9e-431b-8351-a7a88dae6ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b3c4b217ce6ad6e57b67a19efa6f3808 2x, https://si.imgix.net/1a9349a9/uploads/origins/600b3467-bd9e-431b-8351-a7a88dae6ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a829884e06aeefa258ca2e0352f8c54 3x"}, "body": "こんにちは。お世話になります。\nすみすさんのイラストがpixivファンタジアの時からとても好きで、この度skebリクエストをお送りさせて頂きました。\nもしご一考頂けたら嬉しいです……！\n\n・リクエスト内容\nオリジナルキャラクターのイラストをお願いしたいです。\nキャラクター設定：亡くなった花嫁の幽霊\n外見：女性、20歳程度、幽霊、ウエディングドレス、髪色ピンク、瞳色は青色（ハイライトなし）\n備考：幽霊の自覚あり、明るい性格、兄あり\n\n・利用目的\n個人鑑賞\nオリジナルキャラクター登録型のブラウザゲーム　プロフィールイラスト使用\n#TRPGの立ち絵のような感じです。ゲーム利用時にはクレジットを明記いたします。\n\nご参考に資料URLを添付します。\n添付画像の服装は仮のものなので、ウェディングドレスや装飾を自由に描いて頂けたら嬉しいです。\n\nhttps://drive.google.com/drive/folders/1oRQxMh-OPdd5Wk0W9xaOdfjceLMM1z-Y", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sumidolce/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1356051, "client_id": 1083784, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6e17585/uploads/origins/b0252cd8-0c76-43c6-a873-8cadad067f46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43342d11aaf21eed7018381327cee03d", "srcset": "https://si.imgix.net/c6e17585/uploads/origins/b0252cd8-0c76-43c6-a873-8cadad067f46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43342d11aaf21eed7018381327cee03d, https://si.imgix.net/c6e17585/uploads/origins/b0252cd8-0c76-43c6-a873-8cadad067f46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0838073b608749e7b665769cf46c282b 2x, https://si.imgix.net/c6e17585/uploads/origins/b0252cd8-0c76-43c6-a873-8cadad067f46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5221c5cf5251330cd03d966c022be23b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6e17585/uploads/origins/b0252cd8-0c76-43c6-a873-8cadad067f46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85365033f020be7806c8a3a37e7cfaed", "srcset": "https://si.imgix.net/c6e17585/uploads/origins/b0252cd8-0c76-43c6-a873-8cadad067f46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85365033f020be7806c8a3a37e7cfaed, https://si.imgix.net/c6e17585/uploads/origins/b0252cd8-0c76-43c6-a873-8cadad067f46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d73bec65dadd15128bd47ac9a57f9e69 2x, https://si.imgix.net/c6e17585/uploads/origins/b0252cd8-0c76-43c6-a873-8cadad067f46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=674ffa1ba607f2018aa9b81529dc087f 3x"}, "body": "すみす先生、こんにちは。 先生のデザインスタイルが本当に好きです！もし可能でしたら、私のOC2人の新しい衣装をデザインしていただけないでしょうか？二人ともゴシック風の服装が似合いそうですが、女の子の方は修道女風の要素も取り入れているかもしれません。OCのイメージに合ったデザインをぜひお願いします。先生の好きな方向で自由に描いていただけたら嬉しいです！\n\n黑 (170cm)：\nファンタジー作家。 自分自身に対して低い評価を持ちましょう。\nその昔、死の概念を司る龍神であり、行く先々に災いをもたらすことから邪龍と呼ばれ、人間に災いと死をもたらした。今は、なかなか力を発揮せず、戦う気もありません。 過去に起こったことがあるので、ある程度の刺激を受けると狂ってしまうかもしれません。\n\n白 (163cm)：\n夢と眠り、そして生き物の魂を司る龍。静かな性格で、人の心を透視する不思議な力を持っています。他人の夢を観察し、制御する能力を持つ。 世の中の苦しみはとても残念ですが、見ていると心が痛くなります。 現実世界にはあまり興味がなく、空想にふけり、泡を吹くように毎日次から次へと世界を創り上げています。時々、親友に膝枕をします。夢への依存が強いため、現実をはっきりと区別できなくなることがあるかもしれません。\n\n関係\nはたから見ると紳士と淑女に見えますが…？二人は実生活で会うことはめったにありませんが、精神的には良い友人です。 彼らは夢を通して出会い、交流し、お茶会を開きました。相手の気持ちを理解して共感することができ、手を差し伸べ認めてあげることで痛みや悲しみが癒されていきます。\n\n画像は個人使用のみを目的としています。自由に描いていただければ嬉しいです！\n先生が絵の中に残した下書きやスケッチを拝見できれば嬉しいです。\nご検討のほどよろしくお願いいたします！\nURL にはさらに多くの設定があります。\n\n参考URL\nhttps://drive.google.com/drive/folders/1PrLzsniis--wfn2Z6XIbLUFZ_hQTleq7?usp=sharing\n\nhttps://drive.google.com/drive/folders/1PrLzsniis--wfn2Z6XIbLUFZ_hQTleq7?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sumidolce/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/aec8fd17/uploads/origins/db88e1a3-420a-426a-9afd-add7164a70d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=053e4f50f17a03b1331a94575615e920", "srcset": "https://si.imgix.net/aec8fd17/uploads/origins/db88e1a3-420a-426a-9afd-add7164a70d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=053e4f50f17a03b1331a94575615e920, https://si.imgix.net/aec8fd17/uploads/origins/db88e1a3-420a-426a-9afd-add7164a70d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66fb76302ba992e192f1dbd7dde1f697 2x, https://si.imgix.net/aec8fd17/uploads/origins/db88e1a3-420a-426a-9afd-add7164a70d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d40b17b583147c100b052f6a7fbfa5c 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1356051, "client_id": 1467562, "nc": 128}, {"path": "/@sumidolce/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1356051, "client_id": 3063934, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbf986f6/uploads/origins/0f983a4c-e0c8-400c-a9e3-15c9ed201284?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5735d79c2ddfec797dfb309cd710df30", "srcset": "https://si.imgix.net/cbf986f6/uploads/origins/0f983a4c-e0c8-400c-a9e3-15c9ed201284?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5735d79c2ddfec797dfb309cd710df30, https://si.imgix.net/cbf986f6/uploads/origins/0f983a4c-e0c8-400c-a9e3-15c9ed201284?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2b0226f7ec70f18ac1b413885250dc3 2x, https://si.imgix.net/cbf986f6/uploads/origins/0f983a4c-e0c8-400c-a9e3-15c9ed201284?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=731a64093e828d20fbd3ac9113126e4a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbf986f6/uploads/origins/0f983a4c-e0c8-400c-a9e3-15c9ed201284?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=432a66e8f0ed0b6d670d3cb7db554872", "srcset": "https://si.imgix.net/cbf986f6/uploads/origins/0f983a4c-e0c8-400c-a9e3-15c9ed201284?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=432a66e8f0ed0b6d670d3cb7db554872, https://si.imgix.net/cbf986f6/uploads/origins/0f983a4c-e0c8-400c-a9e3-15c9ed201284?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e96864813f320782f96f66c770f34359 2x, https://si.imgix.net/cbf986f6/uploads/origins/0f983a4c-e0c8-400c-a9e3-15c9ed201284?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ddcd74b2de590fc3fc366aa9133d83fa 3x"}, "body": "すみすさんのイラストがとても気に入ります、イラストを依頼したいです。\n\n使用用途は主に配信、SNS、鑑賞などです。\n\nOCの新しい服のデザインを手伝ってほしいんですが！特別な要求はありませんので、自由に発揮してください，本当にありがとう！\n\nキャラクターのイメージ参考：\nhttps://drive.google.com/drive/folders/1cV2kdNDNzLTY4-Y1dNCxkmLXQxjG8mye\n\nhttps://drive.google.com/drive/folders/1cV2kdNDNzLTY4-Y1dNCxkmLXQxjG8mye", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sumidolce/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1356051, "client_id": 217772, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a899533/uploads/origins/30416e8b-0af8-4bbd-9b92-f0358eca296f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=915062bfab8c8290c25342d82aceeb52", "srcset": "https://si.imgix.net/2a899533/uploads/origins/30416e8b-0af8-4bbd-9b92-f0358eca296f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=915062bfab8c8290c25342d82aceeb52, https://si.imgix.net/2a899533/uploads/origins/30416e8b-0af8-4bbd-9b92-f0358eca296f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9d8adcc837837e1dcbdca5c841dc5d7 2x, https://si.imgix.net/2a899533/uploads/origins/30416e8b-0af8-4bbd-9b92-f0358eca296f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db3b6f889c622399ff37557869264b58 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a899533/uploads/origins/30416e8b-0af8-4bbd-9b92-f0358eca296f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cd9173783fbe7a2770601775f889fd9", "srcset": "https://si.imgix.net/2a899533/uploads/origins/30416e8b-0af8-4bbd-9b92-f0358eca296f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cd9173783fbe7a2770601775f889fd9, https://si.imgix.net/2a899533/uploads/origins/30416e8b-0af8-4bbd-9b92-f0358eca296f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=545f30c6716c5a7afbde11b2df0a79d3 2x, https://si.imgix.net/2a899533/uploads/origins/30416e8b-0af8-4bbd-9b92-f0358eca296f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e5fecdc39df32b34309bdd03bc3d57ac 3x"}, "body": "すみすさん、お初にお目にかかります。\n窓開けされているの拝見して、skebリクエストの方思い切って送信させて頂きました。\n\n内容としましては、自身と友人の描いたキャラクターになります。\n（※相手方にskebリクエストの許可は得ております）\n①16歳の女の子（160cm/歌手/少し浮世離れ感/髪は黒・ｲﾝﾅｰｶﾗｰ藍）と②18歳の男の子（179cm/民俗学専攻学生/少しぽやっとしている/片目隠れ）の、お互いが大事な距離感近めの幼馴染同士です。\nイメージモチーフとしては夜空・細やかな星の光・静かな夜\n\n良ければ衣装デザイン等を、すみすさんがよく描かれているようなファンタジーチックめな雰囲気のものでお着替えさせて頂けると嬉しいです！\n\nよろしければご一考頂けると幸いです。\n\nhttps://drive.google.com/drive/u/0/folders/13CHjM6UZYlYS0iz01CNKZz1bOj71F3mX", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sumidolce/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/59d3fee3/uploads/origins/4b3cb9a8-f508-4555-8ccf-a491736016bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e93b45e7ed34f43a43b68537643596a", "srcset": "https://si.imgix.net/59d3fee3/uploads/origins/4b3cb9a8-f508-4555-8ccf-a491736016bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e93b45e7ed34f43a43b68537643596a, https://si.imgix.net/59d3fee3/uploads/origins/4b3cb9a8-f508-4555-8ccf-a491736016bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d16bedb034e7ed5acb421a5fe1aaed88 2x, https://si.imgix.net/59d3fee3/uploads/origins/4b3cb9a8-f508-4555-8ccf-a491736016bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtf