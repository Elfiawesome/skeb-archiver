e-df88-4334-bd5c-abd70bdf9e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=058720376cb5a10e69443b5dc589df19 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00e1cba0/uploads/origins/2fba932e-df88-4334-bd5c-abd70bdf9e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=607161f9aceece17b191c988725f8601", "srcset": "https://si.imgix.net/00e1cba0/uploads/origins/2fba932e-df88-4334-bd5c-abd70bdf9e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=607161f9aceece17b191c988725f8601, https://si.imgix.net/00e1cba0/uploads/origins/2fba932e-df88-4334-bd5c-abd70bdf9e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=240f53eda45e9c5af987f3ecf00e5cfd 2x, https://si.imgix.net/00e1cba0/uploads/origins/2fba932e-df88-4334-bd5c-abd70bdf9e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95392c1dfc1e3d404149ed55320e97e7 3x"}, "body": "こんにちは、先生！  \n先生のアートスタイルが本当に大好きです！ぜひ先生にイラストをお願いしたいです。作品はSNSのアイコンやスマホの壁紙として個人利用する予定です。\n\n🦋April【184cm／見た目19歳】\n彼を見た目14歳の少年として描いていただいても大丈夫です。\n\n彼は明るく楽観的で、人々に紳士的な礼儀を持って接します。彼は黒い蝶でできた存在です。マフィアファミリーのボスの右腕として、家族を脅かす存在を排除する役割を担っています。繊細で感情的、時には非理性的な一面もあります。  \n黒髪で、左目を覆う髪型をしていますが、一本だけ白髪が混じっています。両目は緑色で、頭には黒い蝶の羽が2枚あります。\n\nデザインの変更は自由ですので、先生が描きたいように描いてください！\n\nお忙しい中リクエストを読んでいただき、ありがとうございます。もし内容が不適切であれば、いつでもキャンセルしてください！  \nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-5fjc5Nj8BS7W_xGaMUypgtTUzfUMjiF", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yowaiinudasi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2679637, "client_id": 96534, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2267d81/uploads/origins/ac3e0f85-d093-460d-a8e9-12a0751936c8?bg=%23fff&auto=format