きたいです。\n（マシンガンではなくビームライフルや\nビームサーベルを用いる絵にしていただいても問題ないです）\n\nガンダムについてはアムロが最初の搭乗したRX-78-2で\nアムロはコックピットでパイロットスーツを装着した状態で\nお願いしたいです。\nその際にアムロはヘルメットの下に表情が見えるように\nしていただきたいです。\n\n全体として絵の感じとしては\n映画「ククルス・ドアンの島」を\n基本にしてください。\n\nこのような感じになります。\nご検討をよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@blackelle22210/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 44434, "client_id": 1133194, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9ea8d62/uploads/origins/71344b42-0161-4def-9352-3012eabb8387?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20a9806403e77e529615a260da2f7c9a", "srcset": "https://si.imgix.net/e9ea8d62/uploads/origins/71344b42-0161-4def-9352-3012eabb8387?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20a9806403e77e529615a260da2f7c9a, https://si.imgix.net/e9ea8d62/uploads/origins/71344b42-0161-4def-9352-3012eabb8387?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7fdb7915e7ba61ed58b0b18ac41c0ee9 2x, https://si.imgix.net/e9ea8d62/uploads/origins/71344b42-0161-4def-9352-3012eabb8387?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5093c75915c0d59a4a77fb05fba788b7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9ea8d62/uploads/origins/71344b42-0161-4def-9352-3012eabb8387?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2352b1e8ce076e010e755b00651b0dc2", "srcset": "https://si.imgix.net/e9ea8d62/uploads/origins/71344b42-0161-4def-9352-3012eabb8387?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2352b1e8ce076e010e755b00651b0dc2, https://si.imgix.net/e9ea8d62/uploads/origins/71344b42-0161-4def-9352-3012eabb8387?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=17af131faf7414f53930eccb86767d68 2x, https://si.imgix.net/e9ea8d62/uploads/origins/71344b42-0161-4def-9352-3012eabb8387?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b8ec2d3cc79eba20fb0d11d2d4825ba6 3x"}, "body": "初めまして。イラストをお願いしたくご連絡させていただきます。\n聖闘士星矢の星矢と瞬の、普段のトレーニングの一環で模擬試合をしているところでお願いします。\nクロスは着ていなくて、瞬はチェーンを使っています。\nシーンとしては瞬が有利な試合運びをしていますが、余裕はなく瞬は懸命な表情です。\n星矢の首にチェーンが巻き付いて絞めながら星矢の動きを制していて、そこに瞬がさらに星矢のみぞおちにパンチを一撃お見舞いしている感じです。\n二人とも顔には傷はほとんどなく、星矢はパンチを喰らって口からやや多めの唾液を吐き出している、という感じでお願いします。\n\n以上、ご検討いただけますと幸いです。よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@blackelle22210/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 44434, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a38aeae8/uploads/origins/c533e856-5a58-493e-9b7b-0cedce3e5301?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=276023f7b33483b49b74c746e4011ab8", "srcset": "https://si.imgix.net/a38aeae8/uploads/origins/c533e856-5a58-493e-9b7b-0cedce3e5301?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=276023f7b33483b49b74c746e4011ab8, https://si.imgix.net/a38aeae8/uploads/origins/c533e856-5a58-493e-9b7b-0cedce3e5301?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c954379e90dac14db5d9b4b327f024f 2x, https://si.imgix.net/a38aeae8/uploads/origins/c533e856-5a58-493e-9b7b-0cedce3e5301?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23f686a41c27eac8085b4a99070a21be 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a38aeae8/uploads/origins/c533e856-5a58-493e-9b7b-0cedce3e5301?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=faa80ad2290822d5c6deb19c044e744d", "srcset": "https://si.imgix.