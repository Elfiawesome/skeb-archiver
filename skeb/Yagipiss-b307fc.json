a9790e53c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=929d83f19a393cdbdbd09c8518138d64, https://si.imgix.net/0ca2c739/uploads/origins/1b122aa0-a2ec-4261-9c33-1b4a9790e53c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=84e5597f7a278c4db2724597c7c23b84 2x, https://si.imgix.net/0ca2c739/uploads/origins/1b122aa0-a2ec-4261-9c33-1b4a9790e53c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0c0762a338ad4b109e6d84c97f99cc0f 3x"}, "body": "いつもイラスト拝見しております。\n\n今回、ご依頼したいイラストは「ゆるキャン△ 」に登場するキャラ「志摩リン」がおねしょしてしまっているイラストをお願いしたいです。内容は以下のようにお願いします。\n\nベッドでおねしょをしてしまったリンが、おねしょに気付き上体だけ起こしておねしょのシミを見下ろして恥ずかしそうにしていたシーン。表情は赤面涙目で、頬から耳まで真っ赤に染まっている様子。服装は衣服の股がぐっしょりおねしょで濡れているのが分かる状態。\nおねしょのシミは大きく、上は腰周りまで、下は太ももの裏までぐっしょり濡らしているサイズでお願いします。おねしょのシミは見切れないようお願いします。\nまた設定として、実はリンはおねしょの癖が直っておらずおねしょの常習犯であるのを隠しており、パジャマや布団は他の日のおねしょのシミが薄らと残り、シミだらけになっているようにお願いします。\n\nそれ以外の部分については作者様の裁量にお任せいたします。細かい部分もありますので、一度ご検討いただければ幸いです。何卒よろしくお願い申し上げます。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yagipiss/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1310097, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bd4297f/uploads/origins/e749dbe2-af44-4373-bbf7-ed4935130ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b6380f68e6e4ddd204e09d0adcd73f9", "srcset": "https://si.imgix.net/5bd4297f/uploads/origins/e749dbe2-af44-4373-bbf7-ed4935130ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b6380f68e6e4ddd204e09d0adcd73f9, https://si.imgix.net/5bd4297f/uploads/origins/e749dbe2-af44-4373-bbf7-ed4935130ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9dbf4496a31d0f43b166914c2e7b843d 2x, https://si.imgix.net/5bd4297f/uploads/origins/e749dbe2-af44-4373-bbf7-ed4935130ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19264fa9a06c93ecfa3771b0a5b9f74c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5bd4297f/uploads/origins/e749dbe2-af44-4373-bbf7-ed4935130ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=feba78388afef79aa96396dda4d137c6", "srcset": "https://si.imgix.net/5bd4297f/uploads/origins/e749dbe2-af44-4373-bbf7-ed4935130ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=feba78388afef79aa96396dda4d137c6, https://si.imgix.net/5bd4297f/uploads/origins/e749dbe2-af44-4373-bbf7-ed4935130ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=255abcc9f400e7bc04e1ddc239a20170 2x, https://si.imgix.net/5bd4297f/uploads/origins/e749dbe2-af44-4373-bbf7-ed4935130ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba8c1078f5e1fb93e9eaee1562431895 3x"}, "body": "初めまして。以前よりやぎぬまさんのおむつの描写が好きですので今回リクエストさせていただきます。\nステージの舞台袖でおむつの交換をしようとしているアイマスの橘ありすのイラストを希望します。\nシチュエーションのイメージとしては長丁場のイベントの合間の僅かな休憩時間に大急ぎでおむつだけ交換し次の出番に備える…というような感じで、以前やぎぬまさんが描かれたhttps://www.pixiv.net/artworks/91920329のような場面に近いかと思います。\n衣装等は詳しくないため選択はお任せしますが、これまで舞台に上がっていた状況をイメージして汗ばんだような感じを出してもらえたらと思います。\nおむつの柄はSB(女の子用)を希望します。それまでトイレに行けておらずぐっしょり濡れた感じであれば嬉しいです。\n交換は本人のセルフでもスタッフのサポート下でも可ですのでそのあたりの描写はお任せします。\n以上、宜しければご検討下さい。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yagipiss/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1310097, "client_id": 576645, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2562965f/uploads/origins/c88fea05-5e7b-4526-8a03-5637cbd7fd7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=938a43851bd4dc5192a9cc169ce76ebf", "srcset": "https://si.imgix.net/2562965f/uploads/origins/c88fea05-5e7b-4526-8a03-5637cbd7fd7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=938a43851bd4dc5192a9cc169ce76ebf, https://si.imgix.net/2562965f/uploads/origins/c88fea05-5e7b-4526-8a03-5637cbd7fd7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39def50e57f0b363fd3fe360fdb59777 2x, https://si.imgix.net/2562965f/uploads/origins/c88fea05-5e7b-4526-8a03-5637cbd7fd7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72ea0ae606e1e803b30dab003ec3e845 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2562965f/uploads/origins/c88fea05-5e7b-4526-8a03-5637cbd7fd7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a610d4ff56688b632ad0228101f0d68", "srcset": "https://si.imgix.net/2562965f/uploads/origins/c88fea05-5e7b-4526-8a03-5637cbd7fd7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a610d4ff56688b632ad0228101f0d68, https://si.imgix.net/2562965f/uploads/origins/c88fea05-5e7b-4526-8a03-5637cbd7fd7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eae893c7057ec70a35e871f9b0481984 2x, https://si.imgix.net/2562965f/uploads/origins/c88fea05-5e7b-4526-8a03-5637cbd7fd7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f9d643b27c57604b41eb1fd522f66dd 3x"}, "body": "いつも大変お世話になっております。もし可能であればまたリクエストをさせて頂きたいのですが、アイドルマスターシンデレラガールズの橘ありすちゃんですが、おねしょ布団の横におねしょパジャマのまま立たされてるイラストが見てみたいです。\n\nおねしょの地図は特大で真っ白ふかふかのお布団を盛大にぐっしょり濡らしちゃってるのが希望です。ほかほか湯気が立っててたっぷりおねしょをお布団にすわせたんだなってわかる形だと嬉しいです…", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yagipiss/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1310097, "client_id": 116917, "vtt_url": null, "thumbnail_image_urls": {"src": "