2a3/uploads/origins/dfba6a0e-0de4-43bc-a644-2aad2442c65f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ab82e2cf8081064ee49c7f714a04a61, https://si.imgix.net/da7972a3/uploads/origins/dfba6a0e-0de4-43bc-a644-2aad2442c65f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b76395cebca92dbcf38df9224987b0c 2x, https://si.imgix.net/da7972a3/uploads/origins/dfba6a0e-0de4-43bc-a644-2aad2442c65f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8013432f9794e1fc444c7e3fdd510ae9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da7972a3/uploads/origins/dfba6a0e-0de4-43bc-a644-2aad2442c65f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32c5f3da61854dd95036d23e24e8529c", "srcset": "https://si.imgix.net/da7972a3/uploads/origins/dfba6a0e-0de4-43bc-a644-2aad2442c65f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32c5f3da61854dd95036d23e24e8529c, https://si.imgix.net/da7972a3/uploads/origins/dfba6a0e-0de4-43bc-a644-2aad2442c65f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=67701de14c954bdbc561aabb1b737b93 2x, https://si.imgix.net/da7972a3/uploads/origins/dfba6a0e-0de4-43bc-a644-2aad2442c65f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e1bf38915ac52d223ff4accc9b9a2d8 3x"}, "body": "번역기를 사용중입니다\n\nこんにちは先生が描かれた\nhttps://www.pixiv.net/artworks/76970073\nこのイラストに一目惚れしてイラストを依頼します\n\nオリジナルキャラクター(OC)を申請します\nhttps://drive.google.com/drive/folders/1EdcfLhQ5XWcrs7aevWjhhLX2KwnDHTAf?usp=drive_link\nセイバー・アルターのように蒼白な肌、脱色した金髪を持つ\n巨乳＋狐耳キャラクターです\n\nhttps://www.pixiv.net/artworks/110006046\n以前描かれた「モリガン」と似た体型で、胸はもっと大きくお願いします。\n\n■衣装\nhttps://drive.google.com/drive/folders/1VrsKs5J-7CIJZlGbHuU42Bv0h7_6EOX5?usp=drive_link\nブレイヴンに登場するルルの衣装です\n体中央の紫色部分は内側が透けて見える素材に変更してください\n\n2-1-1と2-2-2を参考にしてください\n上記イラストより肌がより透けて見えるようにしてください\n\n■ポーズ\nhttps://www.pixiv.net/artworks/76970073\nしのぶの時と同じように、髪を整える姿で胸と脇が強調されるポーズをお願いします\n\n口にはヘアピンをくわえていてほしい\n\nhttps://drive.google.com/drive/folders/1TF1mNvnOfNDOCZWlAPJO5NahqvWFqvSj?usp=sharing\nヘアピン参考資料\n\nPCの壁紙として使用したいので\n4K解像度（3840×2160）でお願いします\n背景は作者にお任せし、全身をお願いします", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 29533, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "wara", "screen_name": "Xwara", "avatar_url": "https://pbs.twimg.com/profile_images/1865294328358465536/GNQN7rGM.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id": 436952, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "日下氏", "screen_name": "yukkieeeeeen", "avatar_url": "https://pbs.twimg.com/profile_images/1785810983539380224/iJAvk3AS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/790440869379780608/1561543456/1500x500", "appeal_receivable": false, "popular_creator_rank": 62, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 160}, {"id": 1280557, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "B茶@C108土西つ22b", "screen_name": "bkyuuocha", "avatar_url": "https://pbs.twimg.com/profile_images/2039177842676916224/lugjhlEx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/76368233/1780656970/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "del