w-ZiGqvz2BKitvmMyDqxeTEmm8Vldt5YizKDaMQvEGHo9jJ7WSGS2AKVZZylpNC3NyWH1JAqpzCNgOC3ZwM8z~vpDktILr-juV8Q6dKAvmJzYlvraH5xCeorZ-kG9mRPnF-S5FqzxWSrJ74b9SE7dQbPVyWZqWufd0BXD6UcRmXdLzqXWCAr1~L7EWgfbiaNcBEp1BRgA__&Key-Pair-Id=K1GS3H53SEO647", "duration": 519, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1641767892902629376%2FLnPvfOyW.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4967b368f7a0af7dbbf56dc1c1898c32", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1641767892902629376%2FLnPvfOyW.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4967b368f7a0af7dbbf56dc1c1898c32, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1641767892902629376%2FLnPvfOyW.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b6409671e50ca61640b0e5354c408b0 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1641767892902629376%2FLnPvfOyW.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9c463ffaf26f31f76b246d005fdf8441 3x"}, "body": "あ、目が覚めた？\n良かったよ\n昨日キミのおちんちんシコシコして遊んでたら射精しすぎて気絶しちゃうんだもん\nまぁ、おはよう\n何してるのって…キミのおちんちん、ちんぐり返しの格好でじっくり見てるの\n\nあ、今おちんちんピクって震えたね\n怖いの？違うよね見られて気持ちいいんだよね？\nじゃあ、見られたいなら自分でおちんちんの根元押さえてピーンってボクのほう向かせて\n嫌だったらお部屋出ていっていいよ？\n抑えつけてるの解いてあげる\nどうする？\n\nよく出来ました〜恥ずかしい格好でボクに大切なおちんちん捧げちゃったね\nどうされちゃうのかな？わかる？\n痛くされちゃうのかな？\nガブガブ〜って噛まれちゃったりするのかな？　フフ、冗談だよ\n痛くなんてしないよ、ほら（キス音）\n\nイブキもイブキのおちんちんも食べちゃいたいくらい好きだけど痛いことはしないよ\n安心した？\nあ、そのおちんちん写真撮っていい？\nいつでもキミのおねだり見返したいから\n\nアレ？おちんちんさっきよりも大きくなってるね\nもしかして……何されるか分かんないのが興奮したの？\n変態だねw\nねぇ、痛くはしないけど激しくはするかも\nおちんちんの上に覆い被さって私のエッチなところで貪ったりするかもだけど…いいよね？\nおちんちん捧げたんだもんね？\n\nまぁ、我慢できないけど一方的に犯し潰すのも味気ないし一つだけお願い聞いてあげる\nおちんちん、どうやって壊してほしい？\n\nん？鈴口舌でほじくったり暇な時に金玉舐め続けて溶かされたい？\nいいよ。金玉だけじゃなくてカリも裏筋も舐め続けてあげる\n私のオナネタにもなりそうだし\n\nあ、そうだオナネタもういらないんだったね\nイブキのおちんちんで遊べるんだもんね\nまぁ最初だしお願い聞いてあげる\n私もオナりながらイブキのタマと鈴口舐め続けてあげるからね\n\n（舐め音お願いします）\nとびきりのオカズ目の前にあるしオナニーするからよーく見ててね\n（オナニー音お願いします）\n\nあ、ねぇ。ちょっと自分でおちんちんの穴クパァってして。いいから\n\n私のエッチなお汁。もうビチャビチャだから鈴口からおちんちんの中に入れてあげる\n良かったね〜身体の中も外も私の愛液まみれになっちゃうね〜\nもう他の女の人とはエッチできなくなって…\n私専用の肉ディルドになるんですよ〜って証明…\n\n\nあ～やっぱダメだ\n我慢できない\n今から犯し潰すからさ\nちゃーんといい声で鳴いて壊れてね♪\n\n低音での読み上げお願いします", "nc": 40, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@tsuru_hamu/works/11", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1641767892902629376%2FLnPvfOyW.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0bc71e9c3d9901ece533c1723e5e042e", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1641767892902629376%2FLnPvfOyW.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0bc71e9c3d9901ece533c1723e5e042e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1641767892902629376%2FLnPvfOyW.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c553c92c87443120465a779062c8179 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1641767892902629376%2FLnPvfOyW.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0f531a4763eb18b20d316a2254c885d 3x"}, "private": true, "genre": "voice", "tipped": true, "creator_id": 3663163, "client_id": 3552642, "nc": 35}, {"path": "/@tsuru_hamu/works/10", "private_thumbnail_image_urls": null, "pr