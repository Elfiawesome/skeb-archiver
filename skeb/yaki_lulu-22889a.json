mgix.net/da508d8d/uploads/origins/0f46324d-a70d-45f2-a08e-b0cf536d4299?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bb6d42608e17522cc4325c513148a2a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da508d8d/uploads/origins/0f46324d-a70d-45f2-a08e-b0cf536d4299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0db6e2e786b4dfff7ecfcc3ee44b8c3", "srcset": "https://si.imgix.net/da508d8d/uploads/origins/0f46324d-a70d-45f2-a08e-b0cf536d4299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0db6e2e786b4dfff7ecfcc3ee44b8c3, https://si.imgix.net/da508d8d/uploads/origins/0f46324d-a70d-45f2-a08e-b0cf536d4299?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b71141470e465081a33c1f57e7059339 2x, https://si.imgix.net/da508d8d/uploads/origins/0f46324d-a70d-45f2-a08e-b0cf536d4299?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3b7b9ca70e67f63241d7f6fcc6c5f633 3x"}, "body": "先生のイラストはどれも大好きですもしお時間があれば、私のオリジナルキャラクターをあなたのスタイルで、悲しく辛い雰囲気で描いて頂きたいのです。ストーリーは、友人や家族をひたすら助け、それがきっかけでヒーローのような存在になった。やがて彼はヒーローになることに夢中になり、自分を助ける前に他人を助けすぎてしまう。彼の友人や家族は、やがて彼を無視し、笑い、彼の夢や思想が狂っているように見え、彼のアドバイスが意味をなさないように見えるため、彼を透明な存在として感じるようになる。彼の精神衛生と自信は滅茶苦茶だ。今、彼は悪役に変身したが、夢を達成し、自分自身をとても誇りに思っているが、今はとても孤独である。昔の方が良かったかもと思いつつ、戻りたくないと思っている。服装や構図はお好みで自由に変更してください。\nhttps://imgur.com/a/yAZPzvW", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yaki_lulu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1788449, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a7a638f/uploads/origins/baa16b78-6b66-4c40-9679-c5eaed513808?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcfd7ae0536ef87f20e49ab9556aedab", "srcset": "https://si.imgix.net/3a7a638f/uploads/origins/baa16b78-6b66-4c40-9679-c5eaed513808?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcfd7ae0536ef87f20e49ab9556aedab, https://si.imgix.net/3a7a638f/uploads/origins/baa16b78-6b66-4c40-9679-c5eaed513808?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8801964608bb29117ec01ff469baee7 2x, https://si.imgix.net/3a7a638f/uploads/origins/baa16b78-6b66-4c40-9679-c5eaed513808?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5e669d8926234b3f06d94c2fc502b5c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a7a638f/uploads/origins/baa16b78-6b66-4c40-9679-c5eaed513808?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b79c301b2fb0e25681fbb35b4639115b", "srcset": "https://si.imgix.net/3a7a638f/uploads/origins/baa16b78-6b66-4c40-9679-c5eaed513808?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b79c301b2fb0e25681fbb35b4639115b, https://si.imgix.net/3a7a638f/uploads/origins/baa16b78-6b66-4c40-9679-c5eaed513808?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=15813ad16e957b115958df4e35bcdfbd 2x, https://si.imgix.net/3a7a638f/uploads/origins/baa16b78-6b66-4c40-9679-c5eaed513808?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b9896828b4e08d5c2824989932f885e0 3x"}, "body": "怖いバーコード様はじめまして。skebで初めてお見かけしたのですが、画風などとても大好きです。\nお時間など大丈夫でしたら、怖いバーコード様の絵柄で見てみたいOCがいるのでお願いしてもよろしいでしょうか…？\n---------\n今は飄々？としているけれど、【元・いじめられっこ】の大道芸人になります。\n参考にいくつか立ち絵を添付していますが、衣装の方、【スーツ】のもの（腕まくりしていないもの）でよろしくお願いいたします。\n（装飾が多いので、衣装の方はお好きにしてくださって大丈夫です！）\n\nよかったら背景を、おどろおどろしいサーカス🎪風（モチーフ・あるいは舞台）にしてもらえるでしょうか。\nタロットや大道芸に使う小道具などが、床に散らばっていると最高です。\n表情は怯えた表情（うまく言えないのですが、現行で虐められている子の顔でなく、元・虐められていた人の恐怖の表情）で、はなぢが出ていたり、どこか痛ましいものが見たいです。\n\nまた、もしキャラクターから影が伸びている場合は、【蛇の形】をしていて欲しいです。\n\n怖いバーコード様の絵柄に、どこか物騒で怪しくて不気味なサーカスが絶対似合う！見てみたい！と思ってのチョイスですが、その他シチュエーションや似合いそうなモチーフなどあればお好きなもので大丈夫です！好きなように描いてくださいませ！\n\nキャラクターを嘲笑うような気配の一枚絵に仕上げていただけると幸いです！\n\n【使用用途】\n個人鑑賞になります。PSDで納品希望。\n画像サイズが大きいものだと嬉しいです。（その他skebの納品作品ほどの大きさがあれば助かります。）\n\n以上になります。\nもし何か足りない条件があれば、条件付き再送などしてくださいませ。\nよろしければ、ご一考よろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1xfXLSdG0SVkWnO_cGeayWny5A-P0NFgA?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yaki_lulu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1788449, "client_id": 930205, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d463608/uploads/origins/69581953-e057-41c6-995a-8bf7464367b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2da878f24590c98e8ca38b7ac13ed35f", "srcset": "https://si.imgix.net/4d463608/uploads/origins/69581953-e057-41c6-995a-8bf7464367b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2da878f24590c98e8ca38b7ac13ed35f, https://si.imgix.net/4d463608/uploads/origins/69581953-e057-41c6-995a-8bf7464367b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bd36a20b5549e69bcf7ca060ddf1f25 2x, https://si.imgix.net/4d463608/uploads/origins/69581953-e057-41c6-995a-8bf7464367b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c8daa3cab74671cfbcc50e016308642 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d463608/uploads/origins/69581953-e057-41c6-995a-8bf7464367b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc0e2a729b9a48b1ad43ae61b004de50", "srcset": "https://si.imgix.net/4d463608/uploads/origins/69581953-e057-41c6-995a-8bf7464367b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc0e2a729b9a48b1ad43ae61b004de50, https://si.imgix.net/4d