情\n涙目で恥ずかしさを感じながらもキッと睨みつけている表情\n\n■構図\n胸から陰部まで見える構図だと嬉しいです。\n手先や足先は見切れてもOKです。\n\n■陰毛\n陰毛あり(がっつり多め、少なめなど毛量でパターンがあると嬉しいです)\n腋毛なし(脇が見えるなら)でお願いします。\n可能であれば、陰毛部分は別レイヤーにしていただけると嬉しいです(無毛とのオンオフを切り替えて楽しみたいため)\n\n■希望\n可能であればpsdファイルでいただけると嬉しいですが、難しければおまかせいたします。\nCLIP STUDIOで確認可能です。\n\nhttp://gallery.minitokyo.net/view/296701", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@a41103/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1146263, "client_id": 222864, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/059b6dc0/uploads/origins/4e04a42b-f0e9-4517-9d1b-6c40687142cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21ff5772125c87fd5a11bdb959b58aa0", "srcset": "https://si.imgix.net/059b6dc0/uploads/origins/4e04a42b-f0e9-4517-9d1b-6c40687142cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21ff5772125c87fd5a11bdb959b58aa0, https://si.imgix.net/059b6dc0/uploads/origins/4e04a42b-f0e9-4517-9d1b-6c40687142cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=791d68c7ced9bedde2082facce461de7 2x, https://si.imgix.net/059b6dc0/uploads/origins/4e04a42b-f0e9-4517-9d1b-6c40687142cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56c93ba2fb2ad2431567350d74554451 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/059b6dc0/uploads/origins/4e04a42b-f0e9-4517-9d1b-6c40687142cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb86e6fe1f26d35d55ef6bd565039766", "srcset": "https://si.imgix.net/059b6dc0/uploads/origins/4e04a42b-f0e9-4517-9d1b-6c40687142cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb86e6fe1f26d35d55ef6bd565039766, https://si.imgix.net/059b6dc0/uploads/origins/4e04a42b-f0e9-4517-9d1b-6c40687142cb?b