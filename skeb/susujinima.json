rmat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0a1fd00f786ceb87f4f14351eb45ef9", "srcset": "https://si.imgix.net/1632bf73/uploads/origins/39e0a0d9-e138-4bef-a15e-24298067d795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0a1fd00f786ceb87f4f14351eb45ef9, https://si.imgix.net/1632bf73/uploads/origins/39e0a0d9-e138-4bef-a15e-24298067d795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=483147264d6ccbbc66b1e6b16ce3510c 2x, https://si.imgix.net/1632bf73/uploads/origins/39e0a0d9-e138-4bef-a15e-24298067d795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=366fdc3735fa861daea7d4564c7d89ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1632bf73/uploads/origins/39e0a0d9-e138-4bef-a15e-24298067d795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1af9156a305e4c5ff7a756a6e4af412", "srcset": "https://si.imgix.net/1632bf73/uploads/origins/39e0a0d9-e138-4bef-a15e-24298067d795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1af9156a305e4c5ff7a756a6e4af412, https://si.imgix.net/1632bf73/uploads/origins/39e0a0d9-e138-4bef-a15e-24298067d795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed8a87946a8b5fc58fe51ad9ae09c525 2x, https://si.imgix.net/1632bf73/uploads/origins/39e0a0d9-e138-4bef-a15e-24298067d795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8ab7db82ab7c4104521a0206cf5237fd 3x"}, "body": "しつい様初めまして！ 個人Vsingerの淡井月と申します。\n\nXにてしつい様のイラストを拝見し、落ち着いたメロウで可愛らしい雰囲気が素敵だったため、ぜひ依頼したいと思いご連絡させていただきました！\n\nご縁がございましたら下記キャラクターのイラストをお願いいたします。依頼経験が少ないため、文章に失礼があったら申し訳ございません。\n\n【依頼内容】\n・「ムーンライト/星街すいせい」歌ってみた動画に使用する淡井月の1枚絵を描いていただきたいです。 \n本家様MV：https://youtu.be/UmN7Fr_Kf-8?si=t62ReNzY76r8oty6\n・原曲mvの雰囲気をふまえつつ、構図や淡井の服装等々はしつい様おまかせでお願いいたします。\n・背景を描いていただける場合、もしくは現在納品されている詰め合わせイラストのような形式でしたら、それぞれのキャラクターデータを透過形式等で分けて納品していただきたいです。\n ・投稿時の概要欄等でのしつい様のクレジット表記 、また動画内でのイラスト上への歌詞文字入れ、をあわせて許可いただけると幸いです。\n (NGがありましたら差し戻しいただけると幸いです。)  \n\n【使用用途】\n・「ムーンライト」歌ってみた動画\n・YouTube・X・Tiktok・niconico(画像投稿、サムネイル、ヘッダー等)での使用\n・ネップリでのフォロワー様向け配布\n ※ 商用利用(グッズ化や販売)は行いません。\n\n✦︎活動キャラクター参考資料︎✦︎  \n・狼の耳と尻尾、青みがかった黒髪、瞳の三日月形のハイライトが特徴です。\n・上記の特徴以外の服装や装飾はしつい様におまかせいたします。淡井月の基本ビジュアル詳細は下記URLからご確認よろしくお願いいたします↓ \n\n寒さが厳しい季節ですので、 ご自愛くださいませ🌙\n\nhttps://drive.google.com/drive/folders/1HbQw96DT6fEdx1bSD6lK7w7JBSfhhj6k", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@susujinima/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3387726, "client_id": 3416672, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5081ec61/uploads/origins/af726e17-1c95-443a-89c5-a998e9628d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b3cbecaea1c3af93816505a78e48b41", "srcset": "https://si.imgix.net/5081ec61/uploads/origins/af726e17-1c95-443a-89c5-a998e9628d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b3cbecaea1c3af93816505a78e48b41, https://si.imgix.net/5081ec61/uploads/origins/af726e17-1c95-443a-89c5-a998e9628d52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2452c158f451eb173fb91ba135359609 2x, https://si.imgix.net/5081ec61/uploads/origins/af726e17-1c95-443a-89c5-a998e9628d52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3946b7f8b9f34a8c9f8e19787e80acc0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5081ec61/uploads/origins/af726e17-1c95-443a-89c5-a998e9628d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0971d049778ea9c520f7b9736a5d2418", "srcset": "https://si.imgix.net/5081ec61/uploads/origins/af726e17-1c95-443a-89c5-a998e9628d52?bg=%23fff&au