ress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcb77f92ea4ac094c03d937aefc6a330, https://si.imgix.net/e40b98a9/uploads/origins/3c2e2a3c-b7f4-4936-9801-367f2d87db9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff0d396e8a855f19fd8c350038eb21cd 2x, https://si.imgix.net/e40b98a9/uploads/origins/3c2e2a3c-b7f4-4936-9801-367f2d87db9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31ebcd51c9982d562db84a5224bbc0c1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e40b98a9/uploads/origins/3c2e2a3c-b7f4-4936-9801-367f2d87db9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d0793bf90418352575123e51ffc4db1", "srcset": "https://si.imgix.net/e40b98a9/uploads/origins/3c2e2a3c-b7f4-4936-9801-367f2d87db9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d0793bf90418352575123e51ffc4db1, https://si.imgix.net/e40b98a9/uploads/origins/3c2e2a3c-b7f4-4936-9801-367f2d87db9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f10c05bb8cc9bf30dd973d1f3ef4110 2x, https://si.imgix.net/e40b98a9/uploads/origins/3c2e2a3c-b7f4-4936-9801-367f2d87db9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0284621f0ecf5b0df98ed8a4ed0a6a78 3x"}, "body": "Hello, thank you for your previous artwork! I would like to make another request.\nhttps://toyhou.se/6656456.mint (adult version)\nHe is gentle and caring.\nnotes: semi-thick eyebrows, the hair on top of his head is shaped like a halo. \n\nhttps://toyhou.se/2251034.fenn    (adult version)\nCafe owner, outgoing and down to earth. I would like to see him in the left outfit \nnotes: tanned skin\n\nI would like to see Fenn trying to show that he genuinely cares for Mint. Mint is hesitant to accept it (due to ptsd with other people) because he doesn't know what Fenn's true intentions are. However, Mint also likes Fenn but he himself isn't aware of that, so he subconsciously also wants to accept Fenn's feelings. \n\n\nThank you for considering!", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@PykE_nkr/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3478074, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a998f94/uploads/origins/ffdfb427-ae1b-4915-bda3-e4108a2f5535?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdce5e0a5995e14f96b7eeb99be3e823", "srcset": "https://si.imgix.net/5a998f94/uploads/origins/ffdfb427-ae1b-4915-bda3-e4108a2f5535?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdce5e0a5995e14f96b7eeb99be3e823, https://si.imgix.net/5a998f94/uploads/origins/ffdfb427-ae1b-4915-bda3-e4108a2f5535?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79fbf03d3984225c9dfcdddcb61a935e 2x, https://si.imgix.net/5a998f94/uploads/origins/ffdfb427-ae1b-4915-bda3-e4108a2f5535?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bee121a3b185a5b494fd06a8361a64e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a998f94/uploads/origins/ffdfb427-ae1b-4915-bda3-e4108a2f5535?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03ad80ceef218250f17a8b954fb55ee9", "srcset": "https://si.imgix.net/5a998f94/uploads/origins/ffdfb427-ae1b-4915-bda3-e4108a2f5535?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03ad80ceef218250f17a8b954fb55ee9, https://si.imgix.net/5a998f94/uploads/origins/ffdfb427-ae1b-4915-bda3-e4108a2f5535?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=491d0b808da6525797ba818f603a046e 2x, https://si.imgix.net/5a998f94/uploads/origins/ffdfb42