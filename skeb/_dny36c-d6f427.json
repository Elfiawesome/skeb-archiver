ers/1NcFf_DPJZFAFInaq_wISKkni-OuAQBPb?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_dny36c/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1657703, "client_id": 350566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5fdc7b9/uploads/origins/e79dd236-59d0-4978-a1af-2fa4782618e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75fed3719a84ed289880f56e284e4f62", "srcset": "https://si.imgix.net/a5fdc7b9/uploads/origins/e79dd236-59d0-4978-a1af-2fa4782618e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75fed3719a84ed289880f56e284e4f62, https://si.imgix.net/a5fdc7b9/uploads/origins/e79dd236-59d0-4978-a1af-2fa4782618e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b06d8d631bd507819b63e63ba320f42 2x, https://si.imgix.net/a5fdc7b9/uploads/origins/e79dd236-59d0-4978-a1af-2fa4782618e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=440359c69010eb0d41fe3253606091b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5fdc7b9/uploads/origins/e79dd236-59d0-4978-a1af-2fa4782618e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d17174db81507226d970e2630e5cb06b", "srcset": "https://si.imgix.net/a5fdc7b9/uploads/origins/e79dd236-59d0-4978-a1af-2fa4782618e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d17174db81507226d970e2630e5cb06b, https://si.imgix.net/a5fdc7b9/uploads/origins/e79dd236-59d0-4978-a1af-2fa4782618e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=90eb6833915b2a8c6584401404bc9ba4 2x, https://si.imgix.net/a5fdc7b9/uploads/origins/e79dd236-59d0-4978-a1af-2fa4782618e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=94a5cde9a9afddc292b90eb00801f75d 3x"}, "body": "でにー様、はじめまして！ツイッターでイラストを楽しく拝見させて頂きました。素敵な絵柄とデザインに惹かれて、可能ならば自キャラ２人の新衣装デザインを依頼したいと思っております。\n\n【依頼内容】\nキャラ参照は下記のURLをご覧ください。ファンタジー世界の海岸王国に住んでいる「幼馴染」の2人です。小さい頃からずっと一緒にいて、今は同じ魔法大学に通っている。\n\n元デザインURL：https://sta.sh/2yk4umwb2bi\n\n【⚔️ 1】黒・灰色髪の子は王国の後継者であり、北欧語のルーン魔法を使ってる格闘家。天使族の子ですので、背中に黒い翼があります。普段は無表情ですが、身内だけに対して微笑み・小さな笑いとか色んな表情を見せます。身長は175cm。髪型はハーフアップで、内側は灰色に染めています。中性的な子ですが、体はちょっと男性寄り。かっこいい系。\n→ 新衣装参照：https://sta.sh/2154rfm5vx04\n→ 衣装スタイルは上記のリンク先のものになります。基本は女性用の服を着ます。メイン色は紺青、黒と銀色。\n→ 髪のリボンは元のデザインのままでお願い致します。\n→ 可能ならば、星と雪のモチーフを衣装に入れて頂ければ大変嬉しいです。\n\n【🛠️ 2】褐色肌の子は元海賊で発明家です。自信屋でお喋りな性格をしていて、いつも（大声で）新しい発見やアイデアにはしゃいでいます。怖いもの知らずでリスクテイカー。銃を良く使ってます。身長は181cm。眉毛は太めで、犬歯もあります。肌の色をご注意ください！\n→ 新衣装参照：https://sta.sh/2fc3aqrbe0a\n→ 衣装スタイルは上記のリンク先のものになります。スチームパンク系。メイン色は海色、黒と白。\n→ 胸はチラッと見える様な衣装をお願い致します。\n→ 髪のバンダナは元のデザインのままで、柄は海波を思わせるパターンに変えてください。\n→ 可能ならば、海と羅針盤のモチーフを衣装に入れて頂ければ大変嬉しいです。\n\n2人を全身構図で新衣装デザインをお願い致します。衣装はスタイルとメイン色に沿えば何でも構いませんので、でにー様のテイストにお任せ致します。\n\n依頼内容に何か難しいか問題点があれば、是非断ってください。ご検討のほど、何卒宜しくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_dny36c/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1657703, "client_id": 1669, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/992ffb65/uploads/origins/f99fdb4d-cb68-40f0-81a3-a5fdb987ef75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7e54c39e8a89dc8929623facf7ff7bc", "srcset": "https://si.imgix.net/992ffb65/uploads/origins/f99fdb4d-cb68-40f0-81a3-a5fdb987ef75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7e54c39e8a89dc8929623facf7ff7bc, https://si.imgix.net/992ffb65/uploads/origins/f99fdb4d-cb68-40f0-81a3-a5fdb987ef75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a6164170908995fc153eb5f07e6d2e2 2x, https://si.imgix.net/992ffb65/uploads/origins/f99fdb4d-cb68-40f0-81a3-a5fdb987ef75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cba8db7d5f44ce90331fddeedc31780d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/992ffb65/uploads/origins/f99fdb4d-cb68-40f0-81a3-a5fdb987ef75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94010e8012ec23bb7d3e75696b9d1259", "srcset": "https://si.imgix.net/992ffb65/uploads/origins/f99fdb4d-cb68-40f0-81a3-a5fdb987ef75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94010e8012ec23bb7d3e75696b9d1259, https://si.imgix.net/992ffb65/uploads/origins/f99fdb4d-cb68-40f0-81a3-a5fdb987ef75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7c5e84ded3b7dcabe50800c419cb0d9e 2x, https://si.imgix.net/992ffb65/uploads/origins/f99fdb4d-cb68-40f0-81a3-a5fdb987ef75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab8c4ff3375bcf9256358fc24f7ef498 3x"}, "body": "はじめまして\nよろしければ資料の少年のクゼの服デザインをお願いできないでしょうか？\n\n彼が支援職かつ支援回復を得意とするため\nでにー様のツイッターの固定ツイートにある2段目中央にある「信仰」とある聖職者ののような服がイメージに近いです\n\n杖は自前の物がありますのでそれを持たせてもらえるとありがたいです\nあとは少年である事と髪型さえ抑えてもらえれば、構図等自由にやられて構いません\n背面側などあると嬉しいですが、こちらはなくて構いません\nPSD等でサインのオンオフ、もしくはサインの有る状態とない状態の絵があると嬉しいです\n\nこちら個人使用と資料参考として他の方にも描いてもらう事があるかもしれません\n条件等や現在忙しいようでしたらキャンセルされて構いません\nよろしくお願いします\n\nhttps://drive.google.com/drive/folders/1-16aziN1rfbsj7P8UtveL2HWPFc9vui9", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_dny36c/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1657703, "client_id": 1179131, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/402f50bf/uploads/origins/b65fec45-7de8-42c6-bf65-cb08d489ac6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6de0e2bd1