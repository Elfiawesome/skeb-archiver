.net/0a4a35c2/uploads/origins/2086ed20-b387-4e1f-a82e-29b7341e4cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c39c5d67ba16d35b01fa8d590b1b34ae, https://si.imgix.net/0a4a35c2/uploads/origins/2086ed20-b387-4e1f-a82e-29b7341e4cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44fb56b3420c89d10f301c9e785480b3 2x, https://si.imgix.net/0a4a35c2/uploads/origins/2086ed20-b387-4e1f-a82e-29b7341e4cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4bf37152615a62a8cbc515fce61a935 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a4a35c2/uploads/origins/2086ed20-b387-4e1f-a82e-29b7341e4cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8947c34c28b510f355a27a08a39b0165", "srcset": "https://si.imgix.net/0a4a35c2/uploads/origins/2086ed20-b387-4e1f-a82e-29b7341e4cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8947c34c28b510f355a27a08a39b0165, https://si.imgix.net/0a4a35c2/uploads/origins/2086ed20-b387-4e1f-a82e-29b7341e4cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ce5afd46e7275a67d86b815382bc28f 2x, https://si.imgix.net/0a4a35c2/uploads/origins/2086ed20-b387-4e1f-a82e-29b7341e4cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6ff2dbc8cc1ddc771f864bc5fca7eadc 3x"}, "body": "五藤加純さん、初めまして。\n「とても大きなでべその雷様の女の子」\nをリクエストします。\n\n○雷様の女の子\n・とても大きなでべそ\n・衣装はもちろんでべそ丸出し\n・雲や雨、雪、雷など、晴れ以外の天気を操る\n・その中でも雷は得意\n・太鼓や指先、角、そしてでべそから雷を発することができる\n・力や雷、栄養、幸せなどをでべそに集めて、でべそをさらに大きくすることができる\n・おへそが大好きでおへそを集めている\n・取ったおへそを舐めたりして、おへそからエネルギー、おへそパワーを接種、充電することができる\n\n①「へそ取りをする雷様の女の子」\n・雷様の女の子が雷を鳴らす、光らせる、落とすなどをしている\n・地上にいる、おへそを隠していない人間のや動物（狸、狐、犬、猫など）、時には鬼や人魚、河童などのお化け（⁉）のおへそやでべそを取る\n・人間の一人は完全におへそを取られて、お腹にはおへそが無い\n・また別の人間は、今にも取れそうな、取られかけのでべそになっている\n・取ったおへそは雷様の女の子の周りに漂っている。また、おへそを集めるための枡があり、その中には沢山の取ったおへそが集められて貯まっている\n\n②「でべそが取れちゃった雷様の女の子」\n・雷様の女の子が取った人間のおへそを舐めて味わっている\n・おへそからエネルギー、おへそパワーを接種、充電していて、雷様の女の子のでべそに溜まっている\n・おへそパワーの溜まりすぎで、とうとう雷様の女の子のでべそが取れちゃった！\n・その時の雷様の女の子は、自分のでべそが取れちゃったことに恥ずかしくなった\n\n①と②、余裕があってどちらも描くことや、①か②のどちら１点描いてみたいと思ったものでも大丈夫ですよ。\n初めてですが、どうかよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 190834, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ところによりはれ", "screen_name": "tokoro_tokoro10", "avatar_url": "https://pbs.twimg.com/profile_images/1365484871380918275/97RKLxK-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/515602419/1740328655/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 129}, {"id": 805736, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ウェストメゾン［WEST-MAISON］", "screen_name": "westmaison1", "avatar_url": "https://pbs.twimg.com/profile_images/2038177673806241792/svKmns_z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1191709846795476999/1774711068/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 994985, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "シウ", "screen_name": "shiuriri", "avatar_url": "https://pbs.twimg.com/profile_images/1346462501727207424/Yt9TXQC2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/360488515/1683537541/1500x500", "appeal_receivable":