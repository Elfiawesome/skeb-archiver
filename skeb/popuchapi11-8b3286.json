します。\n　配信サムネ、チャンネルメンバー様へのプレゼント、SNSの宣伝などに使用させて頂きたいです。\n\nお時間とご都合が合っていれば、\n何卒ご検討のほどよろしくお願い申し上げますm(_ _)m\n\n\nhttps://drive.google.com/drive/folders/18gNWMwmIDfKprHkSMgCAiBy46gJJ9yVP?usp=drive_link\n\nhttps://drive.google.com/drive/folders/18gNWMwmIDfKprHkSMgCAiBy46gJJ9yVP?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@popuchapi11/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2698928, "client_id": 2771474, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f18e6e0/uploads/origins/1a282486-f949-428f-b550-7ac78d3d35a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b738c5ef5c2c4760878d089ddef114f", "srcset": "https://si.imgix.net/6f18e6e0/uploads/origins/1a282486-f949-428f-b550-7ac78d3d35a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b738c5ef5c2c4760878d089ddef114f, https://si.imgix.net/6f18e6e0/uploads/origins/1a282486-f949-428f-b550-7ac78d3d35a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a72b3552a1b434948df35193cb125ea1 2x, https://si.imgix.net/6f18e6e0/uploads/origins/1a282486-f949-428f-b550-7ac78d3d35a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49f2d80c525af017cb6ffcfd3f3d2ea7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f18e6e0/uploads/origins/1a282486-f949-428f-b550-7ac78d3d35a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90b91c94c35b72aa51458898933815d9", "srcset": "https://si.imgix.net/6f18e6e0/uploads/origins/1a282486-f949-428f-b550-7ac78d3d35a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90b91c94c35b72aa51458898933815d9, https://si.imgix.net/6f18e6e0/uploads/origins/1a282486-f949-428f-b550-7ac78d3d35a3?bg=%23fff&auto=format%2