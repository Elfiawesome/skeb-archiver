体\n-魔王の子分の中でも忠実で邪悪な例。\n-身長は192cmで痩せ型。\n-ゾンビを戦力として作り出すことを生業とする天才研究者。\n-代表的な動物は白黒猫。\n\n\n\"ゾンビ \"と \"キング \"の関係\n\"ゾンビ \"と \"王 \"は、先に死んだ者の死体からゾンビを作ることで合意した。\n\"死体 \"はいつも \"王 \"を困らせている。\n\"王 \"は \"死体 \"に寛容である。\n\n\n以上！お読みいただきありがとうございました！\n分量が合わなかったり、情報が見づらかったりした場合は、編集して再度送っていただいても構いません！\nとにかく、ありがとうございました!!!!❤️\n\nhttps://drive.google.com/drive/mobile/folders/1mrnFJRjvliCdF0OOUzqfqzYFN5T46xFD?sort=13&direction=a", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@popuchapi11/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2698928, "client_id": 2544199, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90dbe383/uploads/origins/44ba3a72-9522-4670-891a-1decc34cc091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4286a50bf29beaeed2b23a16f4a66265", "srcset": "https://si.imgix.net/90dbe383/uploads/origins/44ba3a72-9522-4670-891a-1decc34cc091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4286a50bf29beaeed2b23a16f4a66265, https://si.imgix.net/90dbe383/uploads/origins/44ba3a72-9522-4670-891a-1decc34cc091?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28e3f894aef1b4e59b42a1d494fc577c 2x, https://si.imgix.net/90dbe383/uploads/origins/44ba3a72-9522-4670-891a-1decc34cc091?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=713c46e9fe82b2cd12cdc2a7565980b8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90dbe383/uploads/origins/44ba3a72-9522-4670-891a-1decc34cc091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=102e6b693e011b4247d986c28b462f7d", "srcset": "https://si.imgix.net/90dbe383/uploads/origins/44ba3a72-9522-4670-891a-1decc34cc091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=102e6b693e011b4