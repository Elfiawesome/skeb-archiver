a9d-a0db-bd672faa3d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b166ec02ec19cb4e39f0a201f0a0550e, https://si.imgix.net/8f7eb06a/uploads/origins/6c2c2842-967a-4a9d-a0db-bd672faa3d38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=86a7379217678f1e1a84d51386b11e01 2x, https://si.imgix.net/8f7eb06a/uploads/origins/6c2c2842-967a-4a9d-a0db-bd672faa3d38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=35464f7eb10feefae41cba6c03cd9489 3x"}, "body": "はじめまして！\nYouTubeにてゲーム配信をしているVTuberの芙蓉夜絡と申します。\nぜひ私のVTuberキャラクターを描いていただきたく、リクエストさせていただきました！\n\n\n【芙蓉夜絡について】\n娯楽のために造られたはずが、いつの間にか自分自身が遊ぶことに夢中になってしまった、近未来型アンドロイドVTuberです。\n性格はいたずら好きで、少し生意気。\n人間をからかうことが好きですが、ゲームで劣勢になると途端に余裕がなくなってしまいます。\n\n【構図・表情について】\n構図・ポーズ・表情などはお任せいたします！\n衣装や髪型についても、アレンジや新規デザインなど大歓迎ですので、描きたいように自由に描いていただけましたら嬉しいです。\nキャラクターの性格や雰囲気から「この子にはこんな表情やポーズが似合いそう」と思うものがございましたら、ぜひそのイメージでお願いいたします！\n\n【使用用途】\n・YouTube配信/動画のサムネイル\n・YouTube配信画面や動画内での使用\n・X（旧Twitter）などSNSへの掲載\n・メンバーシップ関連での使用\n・配信告知や活動関連の画像への使用\n・個人用グッズの作成\nなど、VTuberとしての活動全般で使用させていただく予定です。\n\n【納品について】\nサムネイルなどで使用したいため、可能でしたら以下の形式でいただけますと大変ありがたいです。\n・頭や髪の毛など、キャラクターが見切れていない構図\n・キャラクターのみの透過PNG\nまた、背景を描いていただいた場合は、可能でしたら背景とキャラクターを分けたデータもいただけますと嬉しいです。\n\n\nご検討いただけましたら幸いです！\n素敵なご縁がありましたら、ぜひよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/11kIbl2FsWd9tvkp3f785FhbrOK7mVqPO", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@piero_Illust/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1477023, "client_id": 1288698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a548d271/uploads/origins/7b4bbfba-bc60-4e3f-b0d8-6fb644446dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a217e3c1d0a68906a23a70823f99e43a", "srcset": "https://si.imgix.net/a548d271/uploads/origins/7b4bbfba-bc60-4e3f-b0d8-6fb644