f452-0073-48f8-91f2-5a7a2aa96ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9c009d1200c6fecefb877e2e63fad06 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/250cec52/uploads/origins/53edf452-0073-48f8-91f2-5a7a2aa96ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbc480a4388e047b8fabb984cef8b937", "srcset": "https://si.imgix.net/250cec52/uploads/origins/53edf452-0073-48f8-91f2-5a7a2aa96ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbc480a4388e047b8fabb984cef8b937, https://si.imgix.net/250cec52/uploads/origins/53edf452-0073-48f8-91f2-5a7a2aa96ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c86252f0b3c8e21d03b007fa6d040604 2x, https://si.imgix.net/250cec52/uploads/origins/53edf452-0073-48f8-91f2-5a7a2aa96ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8945e60b24b451a71fdb5d9d84e18ec 3x"}, "body": "内容にミスがあったので変更して再送しました！\n\nバニーガール服を着た豊川風花に色仕掛けされて賭けに負けた後搾り取られるイラストをお願いします！\n\n風花がPにカード勝負を持ちかけブラックジャックで勝った方の言うことをなんでも聞くと約束したという設定で、Pのカードは10になるカードが2枚の状態\n\n・胸にカードを挟んだ風花がもう1枚引きませんか♡と誘惑する\n\n・胸からカードを引きバーストして負けちゃいましたねと笑う(可能であれば谷間の汗でムワッと湿ってエッチに濡れたカードのカットインも入れて欲しいです)\n\n・騎乗位をしようと跨いだ状態で、約束通り言うことを聞いてくださいね♡と挿入しようとする\n\n・勢いよく腰を落としピストンしながら気持ちよさそうなPの表情を見てもっと責めようとする\n\n・射精しそうな事が分かると中出しまで約束ですから絶対離さないと言いながら絶対に引き抜けないように力を入れ膣内を締める\n\n・その刺激に我慢できないPに射精しろと煽る\n\n・大量に中出しする(可能であれば中出しカットインもお願いします)\n\nといった感じでお願いします！\nよろしければ中出し後に、また勝負しませんか？と誘惑によって絶対に勝てない勝負を持ちかけてるシーンも描いて欲しいです！\n\nセリフはこんな感じでと内容に書いてますがお任せします！\n\n内容が多くなりましたがご検討の程よろしくお願いします！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ExKatariui/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2684737, "client_id": 3324453, "vtt_url": null, "thumbnail_image_urls": {"s