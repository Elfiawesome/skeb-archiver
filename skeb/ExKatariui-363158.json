写(背後視点)のカットをできれば添えていただきたいです\n\nよろしくお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 96586, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "zv", "screen_name": "zv14587228", "avatar_url": "https://pbs.twimg.com/profile_images/1165287203720744960/IXpvHcZ8.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 947892, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "しろとけ🔞", "screen_name": "torotoroshiroto", "avatar_url": "https://pbs.twimg.com/profile_images/1121081037063245824/VIH6SRVr.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3178973510/1591799409/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 49}, {"id": 1186276, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ゔぇふと", "screen_name": "VerTe13060408", "avatar_url": "https://pbs.twimg.com/profile_images/1738779093536280576/UrbDzEWO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1363116018613166085/1703305880/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 1196220, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "瀬良彩都🔞", "screen_nam