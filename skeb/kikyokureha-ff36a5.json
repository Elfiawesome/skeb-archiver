n\n\n【使用用途】\n・PCやスマホ待受(トリミングの可能性あり)\n・サムネイルや配信背景\n・グッズ\n\n\n【自己紹介】\n・神社の天女で羽衣をまとっている\n・喜怒哀楽豊かで食いしん坊\n・頭に目玉焼き(毎朝焼きたての非常食)\n・相棒の神獣 白キツネ：いなり\n・リスナーマスコット 黒キツネ：かぐら\n\n\n\n【希望内容】\n・お正月の着物(暖色系に、花柄、和柄などのあしらい)\n\n・私、マスコット、相棒の3人で楽しそうにしている(おみくじをひいてる、羽子板で遊んでる、炭で顔に落書き、などお正月らしいものだとなお嬉しいですが、ていと様の思うままに描いていただけたらと思います)\n\n\n16:9の横サイズで、人物と背景やサインを分けてPSDデータで頂けると嬉しいです。(マスコットや相棒も人物と別レイヤーだと大変助かります...！)\n立ち絵リンク添付させていただきました。ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ZK9nknwEGTBis_pUOUZGy77lpbALdUHq?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Whybe123/works/543", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2285556, "client_id": 2810562, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f138cbb3/uploads/origins/1c6de105-6a63-48da-beb1-6650158589eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5ffb189cfc8b2fe6d978040ae296221", "srcset": "https://si.imgix.net/f138cbb3/uploads/origins/1c6de105-6a63-48da-beb1-6650158589eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5ffb189cfc8b2fe6d978040ae296221, https://si.imgix.net/f138cbb3/uploads/origins/1c6de105-6a63-48da-beb1-6650158589eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86081966826284a1fd96df9314029331 2x, https://si.imgix.net/f138cbb3/uploads/origins/1c6de105-6a63-48da-beb1-6650158589eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=251085ac565aef75fdc59d090f4485ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f138cbb3/uploads/origins/1c6de105-6a63-48da-beb1-6650158589eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=986775d4e03dfdcbbc772c4964d72b31", "srcset": "https://si.imgix.net/f138cbb3/uploads/origins/1c6de105-6a63-48da-beb1-6650158589eb?bg=%