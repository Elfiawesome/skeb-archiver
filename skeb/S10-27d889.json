涙を流しながら、目の前のドフラミンゴをキッと睨んでいます。\n\n◆容姿\n・全裸\n\n◆構図\n・URL先の画像を参考にしていただければ幸いです。\n\n◆その他要望\n可能でしたら下記の差分をお願いします。\n・精液のON/OFF\n・目隠し\n・口枷 (ビットギャグ)\n\n\nお手数をおかけしますが、ご検討の程よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1hO0oePWU71aiLCwa7wh0uFFF1yqyDk8h?usp=sharing", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@S10/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/be243351/uploads/origins/131531c9-70dc-408e-8882-421593f55a95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=efe216dd7f29c4a4f1c4f148c146c28d", "srcset": "https://si.imgix.net/be243351/uploads/origins/131531c9-70dc-408e-8882-421593f55a95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=efe216dd7f29c4a4f1c4f148c146c28d, https://si.imgix.net/be243351/uploads/origins/131531c9-70dc-408e-8882-421593f55a95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1ef1f890e299fd78b9a8d19e1002012d 2x, https://si.imgix.net/be243351/uploads/origins/131531c9-70dc-408e-8882-421593f55a95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=58591b98c5cc6481696624dccce5b142 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3942004, "client_id": 1820275, "nc": 176}, {"path": "/@S10/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cdcef38f/uploads/origins/2f5331df-067b-43cb-be69-a4eb07b35cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRI