=top&w=200&h=200&s=8a86ef172953da18b6bdf3b949c91cb2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c721620/uploads/origins/7749522f-83a8-485f-ab70-549d431e344b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=839f592f7de839be468ac2755c4ecffe", "src_set": ""}, "body": "こんにちは！\n\n最近、あなたの作品に出会いましたが、生き生きとした表情を幅広く捉える能力に驚きました。あなたの作風は大胆でダイナミックで、ミーポリスにぴったりです！\n\nミーポリスはいたずら好きで、ちょっと間抜けで、でもたまらなくチャーミングなカオスの代理人です。\n\nあなたにミーポリスを描いてもらえたら嬉しいです！彼女のお茶目でスタイリッシュな性格を表現できるようなポーズや表情を自由に選んでください。作品はYouTubeのサムネイルやプロフィール写真などに使用する可能性があるので、できれば背景透過のPNGでお願いします。\n\nhttps://drive.google.com/drive/folders/1ygM7FZ_G6RtjiTDdoL5bUd8-GoS9svzc?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mt_nmti/works/185", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1937920, "client_id": 3423515, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5252e7be/uploads/origins/1e2339ef-16c9-4ed2-a017-41bd64b1c6c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bf25c5f34eeae45318fe9d46e5a7174", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5252e7be/uploads/origins/1e2339ef-16c9-4ed2-a017-41bd64b1c6c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0e03acc510115dff73509aa255f9c3c", "src_set": ""}, "body": "はじめまして、YouTubeでボカロPとして活動をしているmila(みら)と申します。\niru様の繊細で綺麗なイラストが目に留まり、ぜひボカロ曲のイラストを担当して頂きたいと思いご連絡させていただきました。\n\nイラストの内容としましては\nサイズ16：9\n・白い長髪の女の子(胸上)\n・目は水色\n・白のワンピース\n・両手に鍵を持っている\n・背景は水色(淡い水色の絵の具をぼかした感じ)\n\n儚い雰囲気でお願いします。\n\n人物透過も可能であればお願いしたいです。\n\n何卒よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mt_nmti/works/184", "private_thumbnail_image_urls": nul