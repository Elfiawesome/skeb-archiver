it=crop&crop=top&w=200&h=200&s=e47ae4d8d5cc5023942864b11262672f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04d3b9f1/uploads/origins/6dcce52e-865c-4207-ae51-002323c428c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2703a670e447384cba28a81f2f513b8", "src_set": ""}, "body": "こんにちは、私はセンスの画風がとても好きです。\n\n白髪（上）は殺し屋で、普段はとても優しいのですが、強い独占欲を持っています。青髪（下）は作曲家。冷めた性格で仕事人間だが、生活の面倒は見られず、白髪の支配下に身を置いている。\nもし服装が気に入らなければ、自由に弄ってくれて構わない。\n\nhttps://drive.google.com/drive/folders/12auE60NfMahTIAJRozvTsXIG4yBC1oBI?usp=share_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mt_nmti/works/200", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e944dd96/uploads/origins/a9ba1023-7f52-4c45-8c7a-76a5670aa5e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1b5d1fc838ec0a8454ac9be0451b302", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1937920, "client_id": 1144752, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@mt_nmti/works/199", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1937920, "client_id": 839642, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eff8a818/uploads/origins/ffd9dbaa-1808-473d-9b68-32ac5d129fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9250a81244842ed1f0b02c5702a42469", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eff8a818/uploads/origins/ffd9dbaa-1808-473d-9b68-32ac5d129fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a53914d1e50c2f77f99bc637f95d73d", "src_set": ""}, "body": "ご無沙汰しております。以前は素敵なイラストを描いて頂きありがとうございました……！\n以前描いていただいた2人（https://skeb.jp/@mt_nmti/works/145）が紆余曲折を経て交際に至りましたので、月日の経過や関係性の変化を踏まえて再度イラストの制作をお願いしたく、リクエストさせていただきました。（相方さんの許可は頂いております）\n\n\n❖睦見 白鈴(むつみ しらすず)\n男/29歳/180cmぐらい/ウェディングプランナー\n色々あってピアスを開ける事になり、八神に開けて貰った。今着けているピアスもクリスマスプレゼントに彼から貰った物。\n八神といる時は職場やベランダなどの彼に煙を吸わせないような場所で煙草を吸うようにしている。\n八神の事はかっこよくて強い人だと思っているが、実は可愛いところや脆い部分があって、そういう優しさやギャップに惹かれている。\n\n❖八神 天（やがみ てん）\n男/27歳/177cm/植物園職員（植物学研究者）\n家に上げた際にぬいぐるみ好きは睦見にバレた。クリスマスプレゼントにはラッコの抱き枕を買って貰った。\n睦見が自分の前で煙草を吸わないようにしている事に気づいている。遠慮しなくていいのにと思いつつ、優しさがちょっぴり嬉しい。\nお人好し故に危なっかしい所のある睦見を心配している。危険に晒される度に彼を助ける内、失いたくない・少しでも長く一緒に歩んでいきたい相手だと思うようになった。\n\n❖関係について\n・事件で受けたストレスから八神が精神的に不安定になり、一時期睦見の家で半同棲生活を送っていたことがある。\n・精神不安の件がきっかけで、互いに合鍵を交換している。\n・クリスマスの日にデートをし、想いを確かめあって結ばれた。\n・睦見が独身時代に住んでいた街の桜や、八神の幼少期の思い出の場所でネモフィラを一緒に見に行こうと約束した。\n・交際に至ってからまだ一線は越えていない。\n\n\n上記のエピソード等は制作の参考になりそうな要素があれば……で載せた物なので、全てを拾っていただく必要はありません。性格の詳細等は、お手数おかけしますが前回の依頼ページの情報を参考にしていただけますと幸いです。\n構図やシチュエーションなどはお任せしますので、自由に描いていただければと思います。\n服装等、細かいデザインは描きやすいように一部変更して頂いても大丈夫です。\n使用用途はSNSアイコンの他、相方さんへのデータ共有をしたいと考えております。\n\n資料・金額不足など、不備がありましたら再送いただけますと幸いです。\nお手数おかけしますが、ご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/u/1/folders/1buNGIYnm0o-pHhXF7q_iKazZKnimG274", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mt_nmti/works/198", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8352c5f0/uploads/origins/7a6019b9-4fda-4dda-9215-17b5dc4e2feb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e3b9ab902171f59b6ac430cdfbeaaba2", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1937920, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": nu