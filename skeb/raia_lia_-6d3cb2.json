分を摂取する必要がある。\n外向的な性格で、表向きは陽気で冗談が好きだが、快楽犯の核を持ち、傲慢で人間離れしている。 会話上手で、口が回るほど完璧な嘘をつく。\n亡くなった有名人の記憶と容姿を持っているため、多くの人に知られるようになり、他人から与えられる希望を嫌う。\nその人が残したラジオを持ち歩き、訪れる先々で紹介する。\n高いところにいてジュースを飲んだり、頭の水晶で遊んだりするのが好き。\n触られるのは好きではない。 (ただし、28を除く）\n\nお読みいただきありがとうございます。\nよろしくお願いします。♡\n\nhttps://drive.google.com/drive/folders/1X4dEFioiEKVpLlmXAKaNhaQUXtV_6qx9", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 567135, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "にるべっか", "screen_name": "kuma14n", "avatar_url": "https://pbs.twimg.com/profile_images/2023999660822851587/R8fSIR_j.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2240395412/1685904658/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 936728, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "らいすゅ", "screen_name": "ieki_doro_bou", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F27290093-cf74-49d8-8659-5afb23fdbd17.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/webpublic-95c41c57-8864-4901-abd4-8b44b832f878.png", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 95, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1366068, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "お、", "screen_name": "ooo_0926", "avatar_url": "https://pbs.twimg.com/profile_images/1976456505617678337/k4n0GrRE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/13933