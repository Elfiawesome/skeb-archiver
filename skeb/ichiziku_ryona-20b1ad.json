s/origins/83c6dcc4-9031-4e08-9333-3b2c9d112021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a89fd522ecc3ac1afeab3e4f293ec9f4, https://si.imgix.net/31a5c2b9/uploads/origins/83c6dcc4-9031-4e08-9333-3b2c9d112021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73e2bb557a272b641bbee65a35d47aa8 2x, https://si.imgix.net/31a5c2b9/uploads/origins/83c6dcc4-9031-4e08-9333-3b2c9d112021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=559153b6441175f05dfba25d23f3cec7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31a5c2b9/uploads/origins/83c6dcc4-9031-4e08-9333-3b2c9d112021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74897bfb6c8b93d99ae12c46d5d0c621", "srcset": "https://si.imgix.net/31a5c2b9/uploads/origins/83c6dcc4-9031-4e08-9333-3b2c9d112021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74897bfb6c8b93d99ae12c46d5d0c621, https://si.imgix.net/31a5c2b9/uploads/origins/83c6dcc4-9031-4e08-9333-3b2c9d112021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=16296b1e79671caa14e279b110690354 2x, https://si.imgix.net/31a5c2b9/uploads/origins/83c6dcc4-9031-4e08-9333-3b2c9d112021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d4daa15eca84870d7b5fd31b6d03933 3x"}, "body": "いつも素敵なリョナエロ作品をありがとうございます！！！\n\n今回も御オリキャラの「拓眞」で依頼させてください！\n\n依頼するシーンとしては、「気を失いかけている拓眞が前髪を無造作に掴まれ、無理やり上体を起こされている」みたいなのをお願いしたいです。\n\n拓眞の表情等は一二九さんにお任せしたいなぁ～と思いますが、一点お願いがあります。\nそれは、前髪を掴まれる際は、拓眞の左眉上にある傷跡が露わになるようにして頂ければ幸いです。\n\n体の状態としては、腹筋の一部が陥没している状態を可能であれば描写していただけると嬉しいです！\n所々擦り傷があったり、頭部から少し血が流れて顔を汚していてくれると嬉しいです。\n\n服装は格闘フォームでも普段着でも一二九さんの描きやすい方で構いません。\n\nアングルとしては、拓眞の前髪を掴む奴の一人称視点だと嬉しいです。\nイメージとしては、前回の依頼で納品していただいた作品の３ページ目の２コマ目みたいな感じ、かつ、同人誌の表紙とかになりそうな感じです。後半曖昧過ぎるイメージですみません！\n\n塗りに関しては、モノクロがいいのでモノクロでお願いできればと思います！\n\n他にもご依頼のほどあるかと思いますが、ご一考のほどよろしくお願いいたします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ichiziku_ryona/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3663917, "client_id": 1398644, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a66b4afc/uploads/origins/3a7187d7-c15d-4ccb-a27e-a71b6bcb470d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc6c8bf6d4d7aa9b53190e892a955421", "srcset": "https://si.imgix.net/a66b4afc/uploads/origins/3a7187d7-c15d-4ccb-a27e-a71b6bcb470d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc6c8bf6d4d7aa9b53190e892a955421, https://si.imgix.net/a66b4afc/uploads/origins/3a7187d7-c15d-4ccb-a27e-a71b6bcb470d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba598afb6f6f2644e1aabd3226de8c2c 2x, https://si.imgix.net/a66b4afc/uploads/origins/3a7187d7-c15d-4ccb-a27e-a71b6bcb470d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c06e1f0f8a32991581354e368e5facda 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a66b4afc/uploads/origins/3a7187d7-c15d-4ccb-a27e-a71b6bcb470d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4c84bd1c7cd1c45996880d9ea098138", "srcset": "https://si.imgix.net/a66b4afc/uploads/origins/3a7187d7-c15d-4ccb-a27e-a71b6bcb470d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4c84bd1c7cd1c45996880d9ea098138, https://si.imgix.net/a66b4afc/uploads/origins/3a7187d7-c15d-4ccb-a27e-a71b6bcb470d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=898d1ae296e99e439f4267dd3e915272 2x, https://si.imgix.net/a66b4afc/uploads/origins/3a7187d7-c15d-4ccb-a27e-a71b6bcb470d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=24aca1881b3a552e6db3644394a6d1b7 3x"}, "body": "一二九さん\nこんにちは!今回はskebからリクエストさせて下さい！\n前回pixivで依頼した身長差対決の続きをお願いできればと思います。\n長身の男性がボディブローを受けたところからです。\n・ボディブローを受けた長身の男性が悶絶している所に背が低めな男性は密着してボディのラッシュ。\n・長身の男性は、背が低い男性にもたれかかりグロッキーな状態。\n・長身の男性にはうめき声をあげてくれると嬉しいです。\n\n可能な範囲で結構です。\nよろしくお願いします!", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ichiziku_ryona/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/081c880a/uploads/origins/9e740a5a-7aef-40b3-9049-89d7f37752c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94eff057f522a666b550e8078dc8ffd9", "srcset": "https://si.imgix.net/081c880a/uploads/origins/9e740a5a-7aef-40b3-9049-89d7f37752c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94eff057f522a666b550e8078dc8ffd9, https://si.imgix.net/081c880a/uploads/origins/9e740a5a-7aef-40b3-9049-89d7f37752c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8bb9ffc136cc53cbbb788bff2c9f8187 2x, https://si.imgix.net/081c880a/uploads/origins/9e740a5a-7aef-40b3-9049-89d7f37752c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=51b99f2c084427325af130e8989de3d0 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3663917, "client_id": 3516550, "nc": 49}, {"path": "/@ichiziku_ryona/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3663917, "client_id": 1062594, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5892565/uploads/origins/062c6706-4dc3-4668-964b-47786877f285?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d73114f30a61b0ed79d12c45993fe5ae", "srcset": "https://si.imgix.net/c5892565/uploads/origins/062c6706-4dc3-4668-964b-47786877f285?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d73114f30a61b0ed79d12c45993fe5ae, https://si.imgix.net/c5892565/uploads/origins/062c6706-4dc3-4668-964b-47786877f285?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3f27b534d761d3982cfab8265e13e7b 2x, https://si.imgix.net/c5892565/uploads/origins/062c6706-4dc3-4668-964b-47786877f285?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9090a701230feb35f3487316e9afe375 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5892565/uploads/origins/062c6706-4dc3-4668-964b-47786877f285?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d37e6d598e7d9af7a603c1c60c849e18", "srcset": "https://si.imgix.net/c5892565/uploads/origins/062c6706-4dc3-4668-964b-47786877f285?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d37e6d598e7d9af7a603c1c60c849e18, https://si.imgix.net/c5892565/uploads/origins/062c6706-4dc3-4668-964b-47786877f285?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=059b56b62c4e395f9f2948ea2c489f34 2x, https://si.imgix.net/c5892565/uploads/origins/062c6706-4dc3-4668-964b-47786877f285?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e1b27110510ef41608c63761d74b5406 3x"}, "body": "先日は納品のほどありがとうございました！\n\n今回は、前回納品していただいた拓眞の作品の続きを描いて頂ければと思いまして、リクエストを送らせていただければと思います。\n\n前回の一撃で集中力が途切れた拓眞が度重なる拳のラッシュで吐いてしまうまでの過程をお願いしたいです！\n\nイメージとしては、\n\n金網に串刺しにされた拓眞が態勢を立て直す前に、相手選手のボディへの猛追が始まり、必死に腹を固めて耐える拓眞。先ほどの一撃で弱った腹で拳を受けるも表層に隆起する筋肉は叩き潰され、衝撃が腹に伝わる。\nそんな拓眞のいじらしい抵抗を嘲笑くかのように差し込まれたレバーブローが拓眞の襲い掛かる。\n痛烈なる一撃を前に腹の中で衝撃が荒れ狂い、再三揺さぶられ続けた胃が遂に激しく暴れ拓眞を苦しめる。\nそこに再び差し込まれるボディアッパーが、拓眞が必死に堪えてきたものを吐き出してしまう。\n\nみたいなものを描いて頂ければ嬉しいです。\n\n同人誌の制作でお忙しい中とは存じますが、ご検討いただけますと幸いです。\nよろしくお願いいたします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ichiziku_ryona/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3663917, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7fc781a/uploads/origins/897dd0a6-afd9-4f73-b9b6-1d7142fb4320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61495f75ee0b5f7116ab6894b7ff5419", "srcset": "https://si.imgix.net/d7fc781a/uploads/origins/897dd0a6-afd9-4f73-b9b6-1d7142fb4320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61495f75ee0b5f7116ab6894b7ff5419, https://si.imgix.net/d7fc781a/uploads/origins/897dd0a6-afd9-4f73-b9b6-1d7142fb4320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=889cf2b1f90a270b3be43139904f86e6 2x, https://si.imgix.net/d7fc781a/uploads/origins/897dd0a6-afd9-4f73-b9b6-1d7142fb4320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf69998eb1057879fb94631be8f30aa0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7fc781a/uploads/origins/897dd0a6-afd9-4f73-b9b6-1d7142fb4320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87fdd8ebb1c8536f36af1d3446818cb9", "srcset": "https://si.imgix.net/d7fc781a/uploads/origins/897dd0a6-afd9-4f73-b9b6-1d7142fb4320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87fdd8ebb1c8536f36af1d3446818cb9, https://si.imgix.net/d7fc781a/uploads/origins/897dd0a6-afd9-4f73-b9b6-1d7142fb4320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ffceea73027b09a501d2811bf666e7a 2x, https://si.imgix.net/d7fc781a/uploads/origins/