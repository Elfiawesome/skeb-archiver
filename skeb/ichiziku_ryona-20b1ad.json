de5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec8cb25e5819c58b1de0cb10d56a458d, https://si.imgix.net/79d4c91a/uploads/origins/716e7161-e07d-4006-97cc-9683958fade5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58a03ea999a23c91cf0a148b0c44d204 2x, https://si.imgix.net/79d4c91a/uploads/origins/716e7161-e07d-4006-97cc-9683958fade5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f27f4f31c2760df7260102ff2e4aaaff 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/79d4c91a/uploads/origins/716e7161-e07d-4006-97cc-9683958fade5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=adc93f56f2ee0232c8159d843c918fa6", "srcset": "https://si.imgix.net/79d4c91a/uploads/origins/716e7161-e07d-4006-97cc-9683958fade5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=adc93f56f2ee0232c8159d843c918fa6, https://si.imgix.net/79d4c91a/uploads/origins/716e7161-e07d-4006-97cc-9683958fade5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=732cfee27f1776e9881a82cd097eb597 2x, https://si.imgix.net/79d4c91a/uploads/origins/716e7161-e07d-4006-97cc-9683958fade5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ad1a89ea5b63df12ad7e9cabf667d719 3x"}, "body": "平素より大変お世話になっております！\n今回も拓眞くんで依頼をさせていただければと思います！\n\n内容と致しましては、拓眞くんの腹責め漫画の続きをお願いしたいです！\n\n依頼したい内容としては、イメージとしては以下の通りです。\n腹にモロにボディアッパーを貰ってしまった拓眞。\n度重なるボディへの連撃、レバーブロー、そしてボディアッパーにより肉体が反射的に嘔吐反応を引き起こし、口がわなわなと震える。（試合前に軽く飲んだ水分を含んだサラサラとした胃液、または、唾液を吐かせていただきたいのですが、吐かせるかどうかは一二九さんの裁量にお任せさせていただければと存じます！）\n苦しみの中、腹から拳を引き抜こうとその腕に両手を伸ばし掴むが、相手は拓眞の腹を苛むように腹に埋もれた拳を捻る。\n\n腕を掴む拓眞の力が弱まり、腕がだらりと垂れる。（両手、または片手）\nそれを視認した相手が拓眞の腹から腕を引き抜くと同時、拓眞は膝から崩れ落ちリングに土下座をするように額を付け、額を擦りつける。\n疼く腹を両腕で守るように抱え込む拓眞。\n\nまでを２ページでほどで描いて頂けますと幸いです。\nもし盛り込めるのであれば、拓眞君が仰向けにされるところまで盛り込んでいただければと思うのですが、難しい場合は次回の依頼でさせていただければと思いますので、一二九さんのご判断にお任せいたします！\n\n個人誌の作成、並びに他のご依頼で忙しい中とは存じますが、何卒ご検討いただけますと幸いです。\nよろしくお願いいたします！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ichiziku_ryona/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/487a371c/uploads/origins/c18a5d9a-677a-4d52-879b-fef12277b30c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=005788d96b723b6724e34ae5c3495291", "srcset": "https://si.imgix.net/487a371c/uploads/origins/c18a5d9a-677a-4d52-879b-fef12277b30c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=005788d96b723b6724e34ae5c3495291, https://si.imgix.net/487a371c/uploads/origins/c18a5d9a-677a-4d52-879b-fef12277b30c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f52fb88d3d2b2afc6971d84b9b4ced8 2x, https://si.imgix.net/487a371c/uploads/origins/c18a5d9a-677a-4d52-879b-fef12277b30c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c97062a3be6e133afad087fc02d2d49b 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 3663917, "nc": 176}, {"path": "/@ichiziku_ryona/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bbe5b954/uploads/origins/b011136b-be9f-435d-983a-faca4dbdd6ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=74c13165caa0ff170cd6ee5628ee4f77", "srcset": "https://si.imgix.net/bbe5b954/uploads/origins/b011136b-be9f-435d-983a-faca4dbdd6ee?bg=%23fff&auto=format%