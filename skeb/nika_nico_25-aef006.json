750-1a7b194cb612?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0b8fa4209ee438cf16d5db3289eda4aa 3x"}, "body": "自分のキャラクターの誕生日をテーマにしたイラストを依頼したいと思っています。キャラクターがケーキの一切れを食べている姿を描いてほしいです。風船やパーティーハットも入れてもらえると嬉しいです。色はパステル調のピンク、黄色、青などを考えています。また、キャラクターのカラーパレットに合わせて、虹色のような色も少し入れてほしいです。片手にフォークを持ち、もう片方の手にはお皿に乗ったケーキの一切れを持っている、そんな可愛い表情で描いてください。口元に食べ物のくずがついているような感じも良いですね。\n\nhttps://drive.google.com/drive/folders/17e82gvaCjSKB0aLil0StnNO1kd9F17q8", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nika_nico_25/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3503467, "client_id": 3915026, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c4aa0ba/uploads/origins/07392059-509c-4fb7-8e64-bf8a2243cfa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=511efa7478ce357ffa2948e22de80262", "srcset": "https://si.imgix.net/8c4aa0ba/uploads/origins/07392059-509c-4fb7-8e64-bf8a2243cfa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=511efa7478ce357ffa2948e22de80262, https://si.imgix.net/8c4aa0ba/uploads/origins/07392059-509c-4fb7-8e64-bf8a2243cfa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab6a8424f83f0a7bf65e4088f02fca58 2x, https://si.imgix.net/8c4aa0ba/uploads/origins/07392059-509c-4fb7-8e64-bf8a2243cfa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1672aa131a6fae64ede0b6cb8a61ce54 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c4aa0ba/uploads/origins/07392059-509c-4fb7-8e64-bf8a2243cfa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99badb4e3efd075f041ede1e3722c069", "srcset": "https://si.imgix.net/8c4aa0ba/uploads/origins/07392059-509c-4fb7-8e64-bf8a2243cfa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99badb4e3efd075f041ede1e3722c069, https://si.imgix.net/8c4aa0ba/uploads/origins/07392059-509c-4fb7-8e64-bf8a2243cfa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7d5d63203dadeca0daad8b189e0ecb5e 2x, https://si.imgix.net/8c4aa0ba/uploads/origins/07392059-509c-4fb7-8e64-bf8a2243cfa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=180940abb3efa03d7b0ee6943cc0f8ed 3x"}, "body": "はじめまして。\n現在IRIAMで活動しております。まぶち。と申します。\nXでイラストを拝見し、絵柄がとても素敵だったので、ぜひ描いていただきたくリクエストを送らせていただきます！\n現在スケブがログインできないためサブ垢からの依頼をさせて頂いております、申し訳ありません。\n\n【構図・衣装・表情について】 \n〇キャラクター詳細\nイメージ：中性的な女、20代、身長168cm\nキーワード：中性的、メロい\n 髪色：全体的にラベンダー、毛先にかけて濃い紫色にグラデーション\n 髪型：襟足ちょっと長め（胸上くらい）までのウルフカット\n 目の色：髪の毛と合わせた紫\nアクセ：ＲＯＹという文字(犬の名前)のヘアアクセとチェーンでつながったピアス\nよく使うマーク：割れたハート💔、ヘッドホン🎧\n\n・イリアム→https://\nourl.jp/f6ded\n・X→https://x.com/imamabuchese\n\n\nヘアアレンジ、衣装デザイン、表情、構図など全てお任せしたいです！\n中性的なイメージなので、胸はほぼなしでお願いします。\nサムネや返礼品として使用させて頂きたいため、髪、服がキャンバスに収まるように描いて頂けたらと思います。\n\n【使用用途】\n・SNSへの投稿 \n・配信\n・動画内での使用/サムネイル画像\n・アイコン・ヘッダーへの使用\n・今後YouTubeをやるのでそちらでの使用\n ・デジタルグッズ/リアルグッズの作成 を予定しており、許可をいただけますと幸いです。 \n\n 【納品形式について】\nサムネなどでの使用のため頭部が切れていないようにお願いしたいです。\n 可能であれば、宛名・人物・背景などをレイヤー別にしたPSDまたはそれぞれのPNG形式でお願いできれば幸いです。  \nお忙しい中恐縮ですが、ご縁がありましたら嬉しいです。\n何卒ご検討のほどよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nika_nico_25/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3503467, "client_id": 775940, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a1c4342/uploads/origins/112302ae-b6e3-4d96-8fc5-fd9060ff43a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53689a5bdab0d6c02ba94b4b3dad5370", "srcset": "https://si.imgix.net/1a1c4342/uploads/origins/112302ae-b6e3-4d96-8fc5-fd9060ff43a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53689a5bdab0d6c02ba94b4b3dad5370, https://si.imgix.net/1a1c4342/uploads/origins/112302ae-b6e3-4d96-8fc5-fd9060ff43a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a3ee4480322a8651e72674a420f4247 2x, https://si.imgix.net/1a1c4342/uploads/origins/112302ae-b6e3-4d96-8fc5-fd9060ff43a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b98a86ba5c27928a510ad3a4e540f293 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a1c4342/uploads/origins/112302ae-b6e3-4d96-8fc5-fd9060ff43a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d81a16fb4d9840ff46cfdec9fd4c6ce6", "srcset": "https://si.imgix.net/1a1c4342/uploads/origins/112302ae-b6e3-4d96-8fc5-fd9060ff43a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d81a16fb4d9840ff46cfdec9fd4c6ce6, https://si.imgix.net/1a1c4342/uploads/origins/112302ae-b6e3-4d96-8fc5-fd9060ff43a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d6c03a113a86cda79f9ca2df91b7ae6 2x, https://si.imgix.net/1a1c4342/uploads/origins/112302ae-b6e3-4d96-8fc5-fd9060ff43a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=398e0d60f225fd2d10cae8a2667f658d 3x"}, "body": "桃李様\n初めまして、ここいちかと申します。\n\n\n桃李様の描かれるイラスト偶然作品を拝見し、透明感を感じさせるイラストの雰囲気が大変好みだった為リクエストをさせて頂きました。\n\n\nこの度リクエストしたい内容は自身のTRPG探索者キャラクターです。\n\nキャラクターの見た目の資料はGoogleドライブにてまとめましたので、お手数ですがご確認頂けますでしょうか。\n\n\n\n\n■ キャラクター\n『神と悪魔のおまじない』というCoCシナリオの『HO3 蝸牛の煙草屋さん』の探索者になります。\n\n以下秘匿ネタバレのない範囲の設定等です。\n\nーーーーー\n◇雨貝 凪流（うかい なる）\n男/年齢26/身長174cm\n性格：温厚　一人称：僕\n職業：タトゥーアーティスト\nイメージカラーコード：#DDCCC1（薄ベージュ）\n\n言動が所々妖艶で思わせぶりな発言が多め。（語彙に♡が良くつくタイプ）人との距離感も近い。気に入った人にはなんでもしてあげる人。相手に隙があればセンシティブな空気感を作り出してくる貞操観念が緩めのドM。\n喫煙者。普段携帯している物は紙ではなく電子タバコを所持。シーシャも自身のタトゥーを店に施す店に設置・所持をしており、こちらも好んで嗜んでいる。甘めのフレーバーの方が好き。\n\nーデザイン関連ー\n・タトゥーが入っているため、基本的に首や腕は長めの隠れるものを人前では着ている。こだわりはないが少しオーバーな服が好き。（立ち絵で見えている箇所は、正面左の首のバーコード柄、手の甲あたりまでのエスニック風の柄、足首）\n・アクセサリーも好み、多めに着用していることが多い。ピアスも至るところに空いているが、人から見える範囲は両耳（耳たぶは少し拡張）と舌上。\n・カタツムリデザインを多少意識し、瞳は殻のようにぐるっとしておりハイライトはない感じ。前髪の中心と左、右サイドの細い3本の束だけ少し白いメッシュが入っている。ほんのり全体の毛先が暗め。\nーーーーー\n\n\n■ 希望\n夜の空気を纏ったチルっぽい雰囲気だと嬉しいです。\n服装などのデザインは何でも大丈夫です。全て自由な解釈でお任せします。\n\n\n■ 使用用途\nアイコン、鑑賞用、グッズ等での印刷に使用させて頂く可能性があります。\n\n\n内容や金額に問題がありましたら再送依頼を頂ければ幸いです。\nご一考の程よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1cKw9ftCOfT595ttnODR4xv4akm-S-prd?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nika_nico_25/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3503467, "client_id": 3939999, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df3dda35/uploads/origins/ef80228c-f9c3-4b7d-ad4e-9b4408831b55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c04cfd61f536fefb0f6d094a108cf0fd", "srcset": "https://si.imgix.net/df3dda35/uploads/origins/ef80228c-f9c3-4b7d-ad4e-9b4408831b55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c04cfd61f536fefb0f6d094a108cf0fd, https://si.imgix.net/df3dda35/uploads/origins/ef80228c-f9c3-4b7d-ad4e-9b4408831b55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bef0ef36271030933571f2e9b0cd7125 2x, https://si.imgix.net/df3dda35/uploads/origins/ef80228c-f9c3-4b7d-ad4e-9b4408831b55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=765da2b59d6ec1d5be7ed98a245914ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df3dda35/uploads/origins/ef80228c-f9c3-4b7d-ad4e-9b4408831b55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97f14d3a8c8bdd092f02280824d5ac1a", "srcset": "https://si.imgix.net/df3dda35/uploads/origins/ef80228c-f9c3-4b7d-ad4e-9b4408831b55?bg=%23fff&auto=form