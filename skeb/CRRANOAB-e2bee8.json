大きなクマがある。忠実で無邪気、誠実だが短気。教育を受けたことがないので、少し間抜けに見える。基本的に子犬だ。\nニコとテオは兄弟で、ニコが16歳のときに出会った。数ヶ月間一緒に逃亡生活を送り、その後離れ離れになった。その後、ニコは兄の行方を何年も探し続け、ようやく再会したときには、ちょっと雰囲気が違っていた。\n16歳のニコと23歳のニコがテオの関心を巡って争うシーンが見たい。一方、テオはその2人に対して異なる感情傾向を持っているので葛藤している。年下のニコには兄弟愛があり、成長したニコには複雑な感情を抱いている。\n雰囲気は自由に解釈してください。金額を調整したい場合は再送してください。ご配慮ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1A0yzHsM3PvVqs8n9iW1jNyzhzkxgrO1t?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@CRRANOAB/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1594985, "client_id": 3472248, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88f9dc79/uploads/origins/9263b324-1e16-4dce-83a3-a6ed23e92c81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e37f43761d026147df80cddb9769b1dc", "srcset": "https://si.imgix.net/88f9dc79/uploads/origins/9263b324-1e16-4dce-83a3-a6ed23e92c81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e37f43761d026147df80cddb9769b1dc, https://si.imgix.net/88f9dc79/uploads/origins/9263b324-1e16-4dce-83a3-a6ed23e92c81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9afe944f83f3b78f1eec4b64f98e5787 2x, https://si.imgix.net/88f9dc79/uploads/origins/9263b324-1e16-4dce-83a3-a6ed23e92c81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5ace7afc7b43d6c04e4badd9f6e89fe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88f9dc79/uploads/origins/9263b324-1e16-4dce-83a3-a6ed23e92c81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95dbc87a1ccddfcd38fb62db84ad7ba7", "srcset": "https://si.imgix.net/88f9dc79/uploads/origins/9263b324-1e16-4dce-83a3-a6ed23e92c81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95dbc87a1ccddfcd38fb6