68e34f/uploads/origins/691f8779-95f7-40c3-a064-cf1f5c47dbfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85de1c75d7d79916774b75499466dc64, https://si.imgix.net/0068e34f/uploads/origins/691f8779-95f7-40c3-a064-cf1f5c47dbfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=afac34985d8b9ec3c227824bb51a743a 2x, https://si.imgix.net/0068e34f/uploads/origins/691f8779-95f7-40c3-a064-cf1f5c47dbfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4e2865d246b6bf9df3a601e1a22fb12d 3x"}, "body": "こんにちは。私のキャラクターの写真をお願いできませんか？彼女はハンターで、ハーブで薬を作ります。アーチェリー、夕日、雨嵐が大好きです。\n\n瞳は銀色で、下の方が赤くなっています。ブーツとフードには、バラの花と葉っぱが詰め込まれています。腕の包帯の下にはバラの花。スカートの下には大きなバラの茂みがあります。鼻の下にはバンドエイドが貼ってあります。\n\nhttps://i.imgur.com/Xq6TFh6.png\nhttps://i.imgur.com/n4WYtfQ.png\n\n可能であれば、彼女の上に雨が降り、バックラウンドにシンプルな夕日があるようにリクエストしてもいいですか？彼女は目に涙を浮かべて濡れていてもいい。もしかしたら、彼女の腕の包帯が解けているかもしれません。\n\nご検討のほど、よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_harochan_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1203796, "client_id": 742047, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4cfa085/uploads/origins/977152cc-fbfd-44ec-afb7-503889c5c6df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a83e45ba7fec201f756fd02156c6c47", "srcset": "https://si.imgix.net/c4cfa085/uploads/origins/977152cc-fbfd-44ec-afb7-503889c5c6df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a83e45ba7fec201f756fd02156c6c47, https://si.imgix.net/c4cfa085/uploads/origins/977152cc-fbfd-44ec-afb7-503889c5c6df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c445863d893379b8257abffd2241cfb3 2x, https://si.imgix.net/c4cfa085/uploads/origins/977152cc-fbfd-44ec-afb7-503889c5c6df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr