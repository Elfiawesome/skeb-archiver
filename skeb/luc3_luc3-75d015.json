るよう、\n文字類だけ別レイヤーに記載いただけると大変ありがたいです。\n※ その他細かなレイヤーは結合いただいて全然問題ありません\n\nまた、完成したイラストを PSD にてご提供いただくことが難しい場合、\n文字類有り / 文字類無し の 2 パターンで PNG 形式などのファイルを\nご提供いただけるとありがたいです。\n\n以上、ご検討だけでもいただければ幸いです！\nどうぞよろしくお願いいたします<(_ _)>\n\nNepuX", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@luc3_luc3/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1630792, "client_id": 2518724, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d722301/uploads/origins/7070b416-bd18-491e-b803-33ff9501c1ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da005c5879a7278b7e1d7e72117f1ba2", "srcset": "https://si.imgix.net/5d722301/uploads/origins/7070b416-bd18-491e-b803-33ff9501c1ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da005c5879a7278b7e1d7e72117f1ba2, https://si.imgix.net/5d722301/uploads/origins/7070b416-bd18-491e-b803-33ff9501c1ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f181087e59c07a6fd65d69f5b9dd26c 2x, https://si.imgix.net/5d722301/uploads/origins/7070b416-bd18-491e-b803-33ff9501c1ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c37f71a892f036af8162baa7bc3a8d44 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d722301/uploads/origins/7070b416-bd18-491e-b803-33ff9501c1ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b937e8eff7f472c610a370bdf00c250", "srcset": "https://si.imgix.net/5d722301/uploads/origins/7070b416-bd18-491e-b803-33ff9501c1ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b937e8eff7f472c610a370bdf00c250, https://si.imgix.net/5d722301/uploads/origins/7070b416-bd18-491e-b803-33ff9501c1ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4