化など大歓迎です！\n\nお忙しいところ恐縮ですが、何卒ご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/118EIhmkJXyyYtOtMQ4Cv9tGPrr32Dw9_?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hosano4679/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3497978, "client_id": 3750703, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3b528219/uploads/origins/cd2c26da-356f-452c-b45d-3bb693592cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d9f2aa8b04ba4c9d7df6228b6ca25e8", "srcset": "https://si.imgix.net/3b528219/uploads/origins/cd2c26da-356f-452c-b45d-3bb693592cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d9f2aa8b04ba4c9d7df6228b6ca25e8, https://si.imgix.net/3b528219/uploads/origins/cd2c26da-356f-452c-b45d-3bb693592cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=588515fb667f4e214e43c6858e569317 2x, https://si.imgix.net/3b528219/uploads/origins/cd2c26da-356f-452c-b45d-3bb693592cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ecd2e8b370dbd3424fb09faf45d2204 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b528219/uploads/origins/cd2c26da-356f-452c-b45d-3bb693592cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee36c59cce286c01828aba4645cafad7", "srcset": "https://si.imgix.net/3b528219/uploads/origins/cd2c26da-356f-452c-b45d-3bb693592cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee36c59cce286c01828aba4645cafad7, https://si.imgix.net/3b528219/uploads/origins/cd2c26da-356f-452c-b45d-3bb693592cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=50f279be98ab099a42f5532315a7dd97 2x, https://si.imgix.net/3b528219/uploads/origins/cd