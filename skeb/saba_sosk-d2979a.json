e6a0/uploads/origins/3cbcef11-ed69-4a94-96d2-e9fd8ef116e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d658dcb418656facc84ecb1335928f9 2x, https://si.imgix.net/2da2e6a0/uploads/origins/3cbcef11-ed69-4a94-96d2-e9fd8ef116e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a43218673f6166a19e9db73107f10121 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2da2e6a0/uploads/origins/3cbcef11-ed69-4a94-96d2-e9fd8ef116e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98ffc67b4d7a05ad9037e1913053a7ed", "srcset": "https://si.imgix.net/2da2e6a0/uploads/origins/3cbcef11-ed69-4a94-96d2-e9fd8ef116e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98ffc67b4d7a05ad9037e1913053a7ed, https://si.imgix.net/2da2e6a0/uploads/origins/3cbcef11-ed69-4a94-96d2-e9fd8ef116e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d0be74dc4ba88d647988f0c11dbf8d7e 2x, https://si.imgix.net/2da2e6a0/uploads/origins/3cbcef11-ed69-4a94-96d2-e9fd8ef116e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d4a5b3b508fb0fddf72830e54bdff370 3x"}, "body": "添付ファイルに関する問題をお知らせいただき、ありがとうございました！\n\nこんにちは！あなたのアートが大好きです！ocsをリクエストしてもいいですか？\n\n1) GEIST｜183cm、40歳。\n元刑事。性格は優しく、物わかりがよく、そつがない。深いところでは計算高く、人を操ることもある。\n\nおバカなことが多く、情けない一面も秘めている。恋愛経験はない。照れ屋。\n\nモチーフ：冬、雪、氷、刑事事件簿、狩猟犬、フランプリン、手袋、忘れな草。\n\n2）コーリー｜172cm、37歳\n面倒くさがりで不器用な学者。物静かで思慮深いが、密かに茶目っ気がある。怠け者で空気が読めず、よく物をなくす。実験や読書をしていることが多い。ガイストをからかうのが好き。\n\n左目の上にほくろがある！\n\nモチーフ：秋、死、本、落ち葉、ワラビ、骨。\n\n二人の関係について：\nふたりはロマンチックな関係にある。ふたりは時にケンカしてバカを演じ、時に怠けて一緒に昼寝をする。\n\n2人とも過保護で執着心が強く、付き合うまでは長い間親友として過ごしてきた。2人とも過去に大切な人を失っているため、常に互いのことを心配し、傷つくのを見るのが嫌いだ。\n\nカップルとして、2人はとても愛し合っており、肉体的にも愛情深い。二人は互いを唯一無二の存在だと考えている。たとえ死んでも、一緒に死んで一緒に生まれ変わる。ハグ、キス、抱擁などの行為はすべてOK！\n\n普段とは違う格好で描いてもらえると嬉しいです！メイドやバニー、エプロンなど、テーマに沿った衣装でもOKです！\n\n個人印刷に限ります！よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1qMbIdLhd7Lp66QQSvv6pW5479ywa8zaE?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@saba_sosk/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2506348, "client_id": 2002761, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e68287a3/uploads/origins/822b0da9-b207-4fcc-9e85-8728ec4e1e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84e40a80302a1ab2cd3665b7bc1cf42b", "srcset": "https://si.imgix.net/e68287a3/uploads/origins/822b0da9-b207-4fcc-9e85-8728ec4e1e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84e40a80302a1ab2cd3665b7bc1cf42b, https://si.imgix.net/e68287a3/uploads/origins/822b0da9-b207-4fcc-9e85-8728ec4e1e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f089ff66407acb28c68903901d663fa 2x, https://si.imgix.net/e68287a3/uploads/origins/822b0da9-b207-4fcc-9e85-8728ec4e1e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab31ff84175f980997b7367e73c15f12 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e68287a3/uploads/origins/822b0da9-b207-4fcc-9e85-8728ec4e1e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=780fc438d215a55e3066af894670f5b4", "srcset": "https://si.imgix.net/e68287a3/uploads/origins/822b0da9-b207-4fcc-9e85-8728ec4e1e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=780fc438d215a55e3066af894670f5b4, https://si.imgix.net/e68287a3/uploads/origins/822b0da9-b207-4fcc-9e85-8728ec4e1e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d86faec81c42d79cdab452ff2b3c4ac9 2x, https://si.imgix.net/e68287a3/uploads/origins/822b0da9-b207-4fcc-9e85-8728ec4e1e54