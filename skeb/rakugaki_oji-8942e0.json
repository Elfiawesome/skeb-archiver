あると嬉しいです！\nガールは【sirius】ボーイは【れないろ】と名前をいれた場合と入れない場合で2通り頂けると嬉しいです！\n以上です！今回はよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1x-DV4-oVIOFLygKgr3NosVjPOBxLd_L9", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rakugaki_oji/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2861060, "client_id": 75156, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30e4f07a/uploads/origins/cf431de5-02be-42d2-9aed-d6f37e8adcbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ee9b17d319553f1f9b9f72b0ad0e4c2", "srcset": "https://si.imgix.net/30e4f07a/uploads/origins/cf431de5-02be-42d2-9aed-d6f37e8adcbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ee9b17d319553f1f9b9f72b0ad0e4c2, https://si.imgix.net/30e4f07a/uploads/origins/cf431de5-02be-42d2-9aed-d6f37e8adcbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4795b0c90742a40e9992a12f568d893e 2x, https://si.imgix.net/30e4f07a/uploads/origins/cf431de5-02be-42d2-9aed-d6f37e8adcbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3470947d6f3517ba47c5320ccd358119 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30e4f07a/uploads/origins/cf431de5-02be-42d2-9aed-d6f37e8adcbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ab82787fe880c5845b8747f31dfe2f0", "srcset": "https://si.imgix.net/30e4f07a/uploads/origins/cf431de5-02be-42d2-9aed-d6f37e8adcbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ab82787fe880c5845b8747f31dfe2f0, https://si.imgix.net/30e4f07a/uploads/origins/cf431de5-02be-42d2-9aed-d6f37e8adcbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9349a71b70a3f11316592b08bb17040a 2x, https://si.imgix.net/30e4