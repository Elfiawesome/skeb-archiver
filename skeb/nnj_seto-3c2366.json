s/1545367434890080256?s=20&t=rC7lIa3y_cfPzhYpqjuzYA\n\nご多忙だとは思いますが、ぜひよろしくお願いいたします。\nご検討いただけますと幸いです！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nnj_seto/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1224018, "client_id": 2033, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b62427b1/uploads/origins/db15ded0-b8d5-4fb4-b40e-00d7dd4f639a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a2defb979f78ad4d505ab07fa8a0233", "srcset": "https://si.imgix.net/b62427b1/uploads/origins/db15ded0-b8d5-4fb4-b40e-00d7dd4f639a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a2defb979f78ad4d505ab07fa8a0233, https://si.imgix.net/b62427b1/uploads/origins/db15ded0-b8d5-4fb4-b40e-00d7dd4f639a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b51df715213b509aded02e37e9db6b8f 2x, https://si.imgix.net/b62427b1/uploads/origins/db15ded0-b8d5-4fb4-b40e-00d7dd4f639a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34961550a2570a1ad5d6375f1981cfac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b62427b1/uploads/origins/db15ded0-b8d5-4fb4-b40e-00d7dd4f639a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cd16099b8764d6cc3ceae51187d9a3f", "srcset": "https://si.imgix.net/b62427b1/uploads/origins/db15ded0-b8d5-4fb4-b40e-00d7dd4f639a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cd16099b8764d6cc3ceae51187d9a3f, https://si.imgix.net/b62427b1/uploads/origins/db15ded0-b8d5-4fb4-b40e-00d7dd4f639a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4cb05d92d05821da5b6b467a96ae59d3 2x, https://si.imgix.net/b62427b1/uploads/origins/db15ded0-b8d5-4fb4-b40e-00d7dd4f639a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=43afd2f63a24b7d58c8b0a754082939a 3x"}, "body": "こんにちは、えちゃんねるというDiscordサーバーを管理している者です。\nこの度サーバーバナーを実装する運びとなりまして、そこに載せるロゴをナナジさんに制作していただきたくご依頼しております。\n載せる場所は現在私の自作イラストが載っているサーバー上部・サーバーへの招待画面となります。\n\n文字は「えちゃんねる」を横書きに、それ以外の装飾等は全てお任せします。\nナナジさんがえちゃんねるから受けた印象を、今まで制作されているようなおしゃれでかわいいポップでスタイリッシュな感じに落とし込んでいただけると嬉しいです。\n\n作成サイズについてですが、可能であれば1920×1080と960×540の２つ（アスペクト比は同じなので出力サイズだけ変えていただければ）、２つが不可能であれば1920×1080の方を第一希望にどちらかひとつだけでも、またサイズ指定も不可能であれば16:9の横長画像で作成していただけると大変嬉しいです。（これも不可であれば横長であれば大丈夫です）\n\nお子様が産まれたばかりでご多忙であり、また体調もまだまだ回復されないであろう中恐縮ですが、ご検討いただけると幸いです。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nnj_seto/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1224018, "client_id": 635458, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61004a96/uploads/origins/303c34eb-1a76-44bf-b3d5-d6aac773e1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e2222f762006ebee19a45d0e2ba7dfa", "srcset": "https://si.imgix.net/61004a96/uploads/origins/303c34eb-1a76-44bf-b3d5-d6aac773e1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e2222f762006ebee19a45d0e2ba7dfa, https://si.imgix.net/61004a96/uploads/origins/303c34eb-1a76-44bf-b3d5-d6aac773e1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ab73cd9dd28f8169a1208db1339e654 2x, https://si.imgix.net/61004a96/uploads/origins/303c34eb-1a76-44bf-b3d5-d6aac773e1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0bf81b6f3c84d9c5f905b46498bd7c28 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61004a96/uploads/origins/303c34eb-1a76-44bf-b3d5-d6aac773e1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2995eec6a535ee4b36aa2c4e062d6b2e", "srcset": "https://si.imgix.net/61004a96/uploads/origins/303c34eb-1a76-44bf-b3d5-d6aac773e1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2995eec6a535ee4b36aa2c4e062d6b2e, https://si.imgix.net/61004a96/uploads/origins/303c34eb-1a76-44bf-b3d5-d6aac773e1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a92c7225b90ae51216e7358aaf206630 2x, https://si.imgix.net/61004a96/uploads/origins/303c34eb-1a76-44bf-b3d5-d6aac773e1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6c342bcccbbac4c1cc6a104a72843345 3x"}, "body": "自身の動画チャンネルのヘッダ及び動画自体で使うロゴを依頼させていただきたいです。\n文字は「気楽にゆるっとWARFRAME」、自身がWARFRAMEというオンラインTPSアクションゲームの実況プレイをする目的で使用します。（公式のガイドラインで実況プレイ、有償コミッションともに許諾されているタイトルです。ご安心ください。）\n改行や段組みなどおまかせいたします。ポップで、文字の可読性のいいデザインだと嬉しいです。\n自身にはロゴ系のセンスが皆無なので、あまり具体的なイメージをお伝えできません。全面的におまかせでよろしくおねがいします！\n\n（以下、イメージの助けになればと記述している内容ですので無視してくださっても構いません）\nゲームについて…SF世界観、銃で戦うタイプの、強化外骨格のスペースニンジャが太陽系をまたにかけて高速で暴れまわるタイプのやや尖った世界観のゲームです。対象年齢高めの洋ゲーです。\n動画の方針について…日常プレイです。タイトルどおりのんびりとしたペースで日常的なタスクをこなしたり、そのときどきのコンテンツを消化するタイプの動画です。\nキャラクターについて…正八面体（？）のアイコンめいたオリジナルキャラクターがいます。このキャラクターそのものを描く必要はありませんが、念の為画像を共有させていただきます。\nhttps://drive.google.com/drive/folders/1fv6QkbNqOvMeWtlQ_kySPE7dLbIUcPnY?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nnj_seto/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1224018, "client_id": 1556029, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3b1d7dc3/uploads/origins/79fef0a2-89e6-4571-a25d-1283ea4bf637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d91090ceacecbbbb8282536731dad81d", "srcset": "https://si.imgix.net/3b1d7dc3/uploads/origins/79fef0a2-89e6-4571-a25d-1283ea4bf637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d91090ceacecbbb