ix.net/988a7ade/uploads/origins/0eeaf22f-ce64-418b-8d19-954fd8428f2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58072c42c5c7dcf7cc45d36b9a69f386, https://si.imgix.net/988a7ade/uploads/origins/0eeaf22f-ce64-418b-8d19-954fd8428f2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8c5162fdf470a0db0a42b104c0309b2 2x, https://si.imgix.net/988a7ade/uploads/origins/0eeaf22f-ce64-418b-8d19-954fd8428f2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=431cb3a74edcdccdea67956e03ebbf4f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/988a7ade/uploads/origins/0eeaf22f-ce64-418b-8d19-954fd8428f2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2c2cf0dade510ae28d48b6bc575072e", "srcset": "https://si.imgix.net/988a7ade/uploads/origins/0eeaf22f-ce64-418b-8d19-954fd8428f2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2c2cf0dade510ae28d48b6bc575072e, https://si.imgix.net/988a7ade/uploads/origins/0eeaf22f-ce64-418b-8d19-954fd8428f2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a539f6fde44f61d7fec065b51cb3b935 2x, https://si.imgix.net/988a7ade/uploads/origins/0eeaf22f-ce64-418b-8d19-954fd8428f2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=923a347d5c291134fab99659a92ffd85 3x"}, "body": "いつもお世話になっております\n\nこの度是非こよたさんに自キャラのドスケベエッチザセックスピクチャー（）を描いていただきたくリクエストしてしまいました\n\n大変迷ったのですが龍竹の二人でお願いしたいです\n以下キャラ紹介です↓\n\n月野竹彦（受け）\nかぐや姫の生まれ変わり高校2年生。\n常にしかめっ面人と馴れ合うことはほぼしない。\n言動もきつく周囲からは一目置かれ（というより怖がられ）ている。\nhttps://pribo.web.fc2.com/charatakehiko.html\n\n猿飛龍馬（攻め）\n竹彦の従者でいつも一緒にいるが犬猿の仲。\n竹彦にはいつも喧嘩腰だが本当は主として尊敬し誰よりも大切に思っている。\nhttps://pribo.web.fc2.com/charatatsuma.html\n\n以下は、要望がだいぶ細かくて申し訳ないのですが、シチュエーションなどについて参考にしていただければと思います\n\n自身のセルフ二次創作をご覧になっていただきたいのですが↓\nhttps://www.pixiv.net/artworks/84541958#manga\n\n二人の基本スタイルは「ヘイトセックス」になります\nイライラや嫌いな感情をセックスを通して相手にぶつけるみたいな感じです\nというより、龍馬の一方的なDVに近いです\nただ、竹は一応嫌がってはいますが根本は乱暴に痛くされるのが好きな無自覚ドMなので全力抵抗しますが感じてしまっている状態です\n\n【シチュエーション】\n・竹彦の自宅で和室。資料↓\nhttps://pribo.web.fc2.com/0taketatsu1.html\nhttps://pribo.web.fc2.com/015act.html\nあまり参考にならなくてすみません…💦\nイメージは障子、襖、床の間みたいな感じです。\n・竹彦は部屋着の甚平、髪は下ろしている。\n龍馬は制服、眼鏡はかけてても外してもどちらでも大丈夫です\n・二人とも眉毛を吊り上げて険しく余裕のない表情。汗をかいている。（前述したpixivの資料を参照していただけると🙇）\n・竹は甚平の前がはだけて片方肩が出ている。首筋や肩〜胸上にかけてキスマークや噛み跡（必要に応じてよだれ）が沢山ついている\n※乳首の描写はすいませんが無しでお願いしたいです…！\n・できれば二人とも正面（もしくは正面〜横の中間くらいのアングル）向いて竹が後ろから突かれてるみたいな感じでお願いしたいのですが\n（膝立ち？？）\n難しければ横向きで正常位みたいな感じでお願いしても良いですか…！\nあとほんと細かくて申し訳ないのですが、性器描写に関しては竹は下を脱がされているが隠れて見えない状態、太ももあたりに汗？精液？？が付いている\n龍馬はズボンを履いたままの状態で挿入\nこちらは接続部がチラ見えするか、見えなくてもどちらでも大丈夫です\n構図的に難しかったら龍馬のズボン脱がしたり性器描写（竹も）したりしちゃって大丈夫です！\n\n指定がめちゃめちゃ細かい上に2人ですいません…\n細かすぎて描けない、金額が足りないようでしたら遠慮なくキャンセルや再送していただいてかまいませんので…！\n\nもし、要望で難しい部分があったらいくらでもスルーしてかまいませんし、資料をご覧になった上でこよたさんのおまかせイメージで龍竹のセックスピクチャーを書いて頂いても全然構いません！（散々細かく指定しといてあれなんですが…）\n\n何か失礼があったら申し訳ありません。\nよければ、ご検討いただけますと幸いです。\n失礼いたしました。\n\nhttps://www.pixiv.net/artworks/84541958#manga", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@i_kemeeeeen/works/87", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 866060, "client_id": 2262996, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e729ffc/uploads/origins/7ca1e59a-f103-4cfb-afd2-a07411b9ddf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c22335365a1e86d1ef56718a4061428", "srcset": "https://si.imgix.net/4e729ffc/uploads/origins/7ca1e59a-f103-4cfb-afd2-a07411b9ddf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c22335365a1e86d1ef56718a4061428, https://si.imgix.net/4e729ffc/uploads/origins/7ca1e59a-f103-4cfb-afd2-a07411b9ddf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8b21a8f57761b7749427f3b88aaa3d9 2x, https:/