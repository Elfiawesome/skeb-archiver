か?\n\n●リクエスト内容\n\n【黒髪のキャラクター】\n・男、身長174cm\n・細長い目\n・軽薄な性格で、真面目に見えず、人をからかうのが好きである。蛇のような印象を受けた。\n\n【白髪のキャラクター】\n・男、身長161cm\n・内気で落ち着いた性格。話は少ないが、正直な性格ゆえに、黒髪のキャラクターにいつもからかわれている。いつも眠たげな表情をしている。彼はチームの魔法使である。\n\n【使用用途】\n・個人鑑賞\n\nリンクに詳細な資料がありますので、それらを参考にしてデザインしてください。ポーズ、構図等はすべて先生にお任せしますので、ご自由に描いて頂けたら幸いです！\n\nもし金額が足りないようでしたら、お手数ですが指定の後再送要請を送っていただけると嬉しいです。よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/14B9bt5BAdKJrCnUbNTlRTflAoJoW-XLU", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oniku00/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4091187, "client_id": 3941439, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60800803/uploads/origins/bba0a21e-1ff0-4790-921f-9e872542348d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=057fd1476adae92c2ae034cc1dbd1c6e", "srcset": "https://si.imgix.net/60800803/uploads/origins/bba0a21e-1ff0-4790-921f-9e872542348d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=057fd1476adae92c2ae034cc1dbd1c6e, https://si.imgix.net/60800803/uploads/origins/bba0a21e-1ff0-4790-921f-9e872542348d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6841b800ece0438eaf63932fe826d2d6 2x, https://si.imgix.net/60800803/uploads/origins/bba0a21e-1ff0-4790-921f-9e872542348d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83e2722b1f2c68ab9b6d6b515c236c93 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/60800803/uploads/origins/bba0a21e-1ff0-4790-921f-9e872542348d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4732a74dfa0228ba48fe5c02009cc5c4", "srcset": "https://si.imgix.net/60800803/uploads/origins/bba0a21e-1ff0-4790-921f-9e872542348d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&