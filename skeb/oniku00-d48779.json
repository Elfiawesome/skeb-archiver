c28 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/02788d59/uploads/origins/2f53983d-f7b6-42cb-85b4-5da7f8584d17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef74e874210911895e3141ab173da373", "srcset": "https://si.imgix.net/02788d59/uploads/origins/2f53983d-f7b6-42cb-85b4-5da7f8584d17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef74e874210911895e3141ab173da373, https://si.imgix.net/02788d59/uploads/origins/2f53983d-f7b6-42cb-85b4-5da7f8584d17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ead928d3673fc480674a43ddb924bfb 2x, https://si.imgix.net/02788d59/uploads/origins/2f53983d-f7b6-42cb-85b4-5da7f8584d17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=939e219f57d8f728300e6bed6f447828 3x"}, "body": "おにく先生、こんにちは！私はあなたの色と画風がとても好きで、できれば私のOCを依頼したいです。\n\n13歳の頃の彼を描いていただくことは可能でしょうか？\n彼はもともと、華奢で穏やかな性格の少年でした。人助けをすることが好きで、SF小説をよく読んでおり、将来はパイロットになって世界中を旅することを夢見ていました。\nしかしその後、周囲から孤立させられ、いじめを受けるようになり、さらに事故に遭って右半分の顔に火傷の痕が残りました。右目にも後遺症があり、あまりよく見えません。強い光に敏感で、暗い場所でもうまく物を見ることができません。\n事故の後はドイツへ渡り、田舎の農場で療養していました。その経験を境に性格や心境にも変化があり、見知らぬ環境を怖がるようになりました。以前のように笑顔を見せることもなくなり、慣れ親しんだ場所から離れることを嫌がります。\nこの頃の趣味は、木を彫って木彫りの作品を作ることです。\n\n具体的な構図と内容は君に任せる！\n\n最終作品はPSDで提出をお願いしたいのですが、下書きとデザインのアイデアを追加できれば嬉しいです！なくても大丈夫です。\n内容や金額に問題があれば、再送が可能かと思います。何か不合理な点があれば、お断りしていただいても結構です。ありがとう。\n\nhttps://drive.google.com/drive/folders/12ohr-iDdD7hQuZLmL7Ddm5fZzFtr_1yM", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oniku00/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4091187, "client_id": 595361, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8be34aa4/uploads/origins/b5e9f7ef-d22a-40b1-95ec-0dbe9cba6bce?bg=%23fff&auto=format%2Ccompress&fm=webp&f