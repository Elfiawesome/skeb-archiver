実験体で、外見は人間の少年の形態を保っていますが、すでに明らかなゾンビの特徴が見られます。長期間にわたって無理やり薬を試されたため、精神年齢は低いレベルに退行しており、複雑な思考はほとんどできません。感情や論理は再び学ぶ必要があります。\n\n構図と姿勢は自由に決めてください。服装も任意に変更できますので、自由に描いてください！  \n\n彼らとの関係を自由に説明して描いてください。もし他の考えがあれば、自由に描くこともできます（*^3^）  \n\n金額が足りない場合は、適切に再送信してください。問題ありません。ご検討ください。受け入れていただければ、とても嬉しいです！！よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oniku00/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4091187, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0627f83b/uploads/origins/21dfa20b-3a1e-4d7c-b705-34848018b1f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37d302034ee3ecdeb7869ebeecf9dcbc", "srcset": "https://si.imgix.net/0627f83b/uploads/origins/21dfa20b-3a1e-4d7c-b705-34848018b1f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37d302034ee3ecdeb7869ebeecf9dcbc, https://si.imgix.net/0627f83b/uploads/origins/21dfa20b-3a1e-4d7c-b705-34848018b1f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6487b8e1623268483b5dcdd1018a552c 2x, https://si.imgix.net/0627f83b/uploads/origins/21dfa20b-3a1e-4d7c-b705-34848018b1f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f38f4264178bf24810cc83ea85aa1be 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0627f83b/uploads/origins/21dfa20b-3a1e-4d7c-b705-34848018b1f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d7314c4792ca5142fa3e0ae7a775677", "srcset": "https://si.imgix.net/0627f83b/uploads/origins/21dfa20b-3a1e-4d7c-b705-34848018b1f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d7314c4792ca5142fa3e0ae7a775677, https://si.imgix.net/0627f83b/uploads/origins/21dfa20b-3a1e-4d7c-b705-34848018b1f9?bg=%23fff&auto=format%2Ccompress&fm