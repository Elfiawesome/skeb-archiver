&blur=200&s=b70c11f2bf51e4c3fb5d6f6a05f822e6 3x"}, "body": "はじめまして\n個人VTuberの猫鳥苗來(ねことりみつき)です。\n乃々間るい様の素敵なイラストいつも拝見させていただいております。\n\nこの度は、猫鳥苗來のイラストを描いていただきたくリクエストさせていただきます。\n\n猫鳥苗來はモチーフがフクロウの\n森のお屋敷で暮らしているお酒(特にウィスキー)が大好きな男の子です。\nポーズ・構図はおまかせでお願いします。\n(ちょっとダークな雰囲気の猫鳥をるい君の絵柄でみてみたいです...!!)\n\nTwitter(現X)の投稿やYouTubeなどの配信・動画のサムネイル、ネットプリント等、VTuber活動に使用させていただきます。\n可能であれば、人物背景透過もしくはPSD形式でいただきたいです。\n\nご検討のほど、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1bk5tQnga8K33kwfWVghTEt1zBgAk1PaL?usp=sharing\n\nhttps://drive.google.com/drive/folders/1bk5tQnga8K33kwfWVghTEt1zBgAk1PaL?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@031_subaru/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 115095, "client_id": 2808900, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7fbedfc6/uploads/origins/fef45444-6c54-4e51-a7d8-11e93dee696e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa228afc55d5ef578d64d76eb89d4e98", "srcset": "https://si.imgix.net/7fbedfc6/uploads/origins/fef45444-6c54-4e51-a7d8-11e93dee696e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa228afc55d5ef578d64d76eb89d4e98, https://si.imgix.net/7fbedfc6/uploads/origins/fef45444-6c54-4e51-a7d8-11e93dee696e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1119fc40bcad42ac8bc5867501003a0c 2x, https://si.imgix.net/7fbedfc6/uploads/origins/fef45444-6c54-4e51-a7d8-11e93dee696e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c4c5aa17d719e8ba9f1b66b2b0a2154 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7fbedfc6/uploads/origins/fef45444-6c54-4e51-a7d8-11e93dee696e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=858d5482fe1b27c9a452c47fbdacd887", "srcset": "https:/