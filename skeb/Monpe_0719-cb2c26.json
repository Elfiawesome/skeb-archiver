=200&blur=200&s=bc5b4378a77581e77218acaac164af6d", "srcset": "https://si.imgix.net/4244e147/uploads/origins/98086eac-9c69-465a-9ad7-04d77fc09754?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc5b4378a77581e77218acaac164af6d, https://si.imgix.net/4244e147/uploads/origins/98086eac-9c69-465a-9ad7-04d77fc09754?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=326c2652715780cd3c613ff10e7684ac 2x, https://si.imgix.net/4244e147/uploads/origins/98086eac-9c69-465a-9ad7-04d77fc09754?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=896026e3d30003b1f8c216909af7d144 3x"}, "body": "いつもモんぺさんの作品を楽しみに見ております！\n今回依頼したい内容ですが、オリキャラの子…代理ですが\n【https://x.com/UsamiAmano/status/1901119826736894170】\nの子の経営する喫茶店にドヤヒマちゃんとモチジュちゃんが来店して、青色のクリームソーダを食べている。\nというシチュエーションで描いて頂けますと嬉しいです。\nセリフや漫画形式？にするかはお任せします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Monpe_0719/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1721235, "client_id": 3495150, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea136703/uploads/origins/16ce2be1-723b-4c1a-8ee1-71f54623fd21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb38d5b8ac2eb9a8a361c3bdc7e1dde5", "srcset": "https://si.imgix.net/ea136703/uploads/origins/16ce2be1-723b-4c1a-8ee1-71f54623fd21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb38d5b8ac2eb9a8a361c3bdc7e1dde5, https://si.imgix.net/ea136703/uploads/origins/16ce2be1-723b-4c1a-8ee1-71f54623fd21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=443a81c7311d3d70895deea56711d6ff 2x, https://si.imgix.net/ea136703/uploads/origins/16ce2be1-723b-4c1a-8ee1-71f54623fd21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebfd938fe7cc2147566a8bdb1fc4fc7b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea136703/uploads/origins/16ce2be1-723b-4c1a-8ee1-71f54623fd21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=128ebd72dfe67b67873d14d3112dfe97", "srcset": "https://si.imgix.net/ea136703/uploads/origins/16ce2be1-723b-4c1a-8ee1-71f54623fd21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=128ebd72dfe67b67873d14d3112dfe97, https://si.imgix.net/ea136703/uploads/origins/16ce2be1-723b-4c1a-8ee1-71f54623fd21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6660c470907eb921ffe4678988faf077 2x, https://si.imgix.net/ea136703/uploads/origins/16ce2be1-723b-4c1a-8ee1-71f54623fd21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=796276ee21deddda7e28d567e617f654 3x"}, "body": "いつもドヤヒマちゃんの作品を楽しみにしてしています✨お題なのですが\n\nドヤヒマちゃんがプリンを食べていて\n(ちゃむちゃむ、ほっぺたがぷるぷるしている)その後ドヤヒマちゃんが\n\nまだ小腹が空いており2個目のプリンを食べるか悩んでいると(台詞あり)\n\nドヤヒマちゃんの頭上.\n左側に天使のドヤヒマちゃん(天使のわっか、天使の翼あり)がプリンアラモードをすすめて\n\n右側に悪魔のドヤヒマちゃん(格好が思いつきませんでした💦)が現れてめちゃくちゃ美味しいけど高カロリーなプリンのアレンジをすすめて\n\nそれを聞いたドヤヒマちゃんが\nむっ！どっちも美味しそうなので両方頂きますねぇ！…←台詞はお任せします。\nと呟いたら、えいみに\n\nプリンは１日一個までだよ！←台詞はお任せします。みたいな絵を是非みてみたいです✨\n\nモンペさんが描く天使&悪魔のドヤヒマちゃん絶対かわいいと思うので機会があれば\nアクスタ、クッション、トランプ等のグッズ化して欲しいです✨", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Monpe_0719/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1721235, "client_id": 69317, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7e232af/uploads/origins/8895f0f6-c0db-4c03-8452-013b8c686e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e08ffc3dd58fa84fc726600d6d63f841", "srcset": "https://si.imgix.net/b7e232af/uploads/origins/8895f0f6-c0db-4c03-8452-013b8c686e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e08ffc3dd58fa84fc726600d6d63f841, https://si.imgix.net/b7e232af/uploads/origins/8895f0f6-c0db-4c03-8452-013b8c686e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89f517972aad017174f3ea654d503fc8 2x, https://si.imgix.net/b7e232af/uploads/origins/8895f0f6-c0db-4c03-8452-013b8c686e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=508918e53bef356e9bc174bce985b1f3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7e232af/uploads/origins/8895f0f6-c0db-4c03-8452-013b8c686e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0955c66dbef836cecedfe3ee1c7952bf", "srcset": "https://si.imgix.net/b7e232af/uploads/origins/8895f0f6-c0db-4c03-8452-013b8c686e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0955c66dbef836cecedfe3ee1c7952bf, https://si.imgix.net/b7e232af/uploads/origins/8895f0f6-c0db-4c03-8452-013b8c686e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=345ac05da9bf9d1d2c6059636027a50a 2x, https://si.imgix.net/b7e232af/uploads/origins/8895f0f6-c0db-4c03-8452-013b8c686e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9cd50a2653cb6df4b49e715cdee7a758 3x"}, "body": "はじめまして。特殊なシチュエーションですが、よろしければお願いします。\n\n【人物】東方プロジェクト\n・霧雨魔理沙（ドロワーズでなく下着、森の探索後なので汗をかいている）\n・小人になった村人（魔理沙の くるぶし くらいの高さ）\n\n【シチュエーション】\n魔法の森で遭難した村人。生えていたキノコを食べると、身体が縮んでしまった。\nちょうど通りかかった魔理沙に助けれられたが、研究材料とし捕まってしまう。\n\n① 小さくなった村人を見つけて驚く魔理沙。魔理沙を見上げてヘルプする村人。\n\n② 家に持ち帰り、床に置いた村人に実験を始める魔理沙。\n「小さくなると嗅覚も倍になるのか？」放屁→放尿。\n\n着衣の有無差分があると嬉しいです。\nまた、２人のセリフつきでお願いします。\n\n【参考図】　ローアングルベースでお願いします。\nhttps://drive.google.com/drive/folders/1Hx-gM85MH4fYDJ2Vr_sQv-S-rGJd0s9l?usp=sharing", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Monpe_0719/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1721235, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15d98e91/uploads/origins/8957f2f9-66a5-4ccf-8791-fcd7bcb8d389?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6019346804d41087d45e434088c5873e", "srcset": "https://si.imgix.net/15d98e91/uploads/origins/8957f2f9-66a5-4ccf-8791-fcd7bcb8d389?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6019346804d41087d45e434088c5873e, https://si.imgix.net/15d98e91/uploads/origins/8957f2f9-66a5-4ccf-8791-fcd7bcb8d389?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=716ef8e6ff29aa8de5987c01a2cb6c5e 2x, https://si.imgix.net/15d98e91/uploads/origins/8957f2f9-66a5-4ccf-8791-fcd7bcb8d389?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e732c024c922d91a5d100c00ec0f40e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15d98e91/uploads/origins/8957f2f9-66a5-4ccf-8791-fcd7bcb8d389?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bae4b0e2229268259e051a933edadf98", "srcset": "https://si.imgix.net/15d98e91/uploads/origins/8957f2f9-66a5-4ccf-8791-fcd7bcb8d389?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bae4b0e2229268259e051a933edadf98, https://si.imgix.net/15d98e91/uploads/origins/8957f2f9-66a5-4ccf-8791-fcd7bcb8d389?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=230cac78ec95ca29286605c52eeda0c5 2x, https://si.imgix.net/15d98e91/uploads/origins/8957f2f9-66a5-4ccf-8791-fcd7bcb8d389?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=58c95f7ff676a3d23d9f28ab3cc1da03 3x"}, "body": "こんにちは！\nお世話になっております 直近でヒマリのイラストをお願いしていたものです。\nヒマリのイラスト大変匂いが籠ってそうでえっちで最高でした…\n\n手数料無料期間ですのでもし宜しければまた一枚依頼させていただくたく思います。\n\n今回は『ブルーアーカイブ』から『水着ウイ』でお願いします。\n\nシチュとしては、先生と一緒に海に来ているウイ。ウイなりに楽しむも何らかのハプニング(先生が転けて水着を掴む、野生動物、単純に緩む等)から水着が脱げてしまい、周りのモブ男たちに全裸姿を見られてしまう…みたいな感じでお願いします！\n\nキヴォトスに他に男いるのかって感じなんですけどそこは目を瞑っていただいて。あわよくばタイミングよく撮影されちゃってたりして形に残ってたりすると尚えっちです。\n\nウイの身体は水着や上着で隠してたものの脇や性器の処理が甘く剛毛な感じだったり乳首乳輪大きめのだらしない身体だと嬉しいです！\nまたお値段内可能であれば全剃りの剃り跡差分も付けていただけると大変助かります。\n\n以上です！\n可能であればお願い致します…！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Monpe_0719/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1721235, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/184461ff/uploads/origins/14e808b0-5b54-4667-8505-5e07bdeeb6a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=667a659e169b26c94f817acb69ea6217", "srcset": "https://si.imgix.net/184461ff/uploads/origins/14e808b0-5b54-4667-8505-5e07bdeeb6a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=667a659e169b26c94f817acb69ea6217, https://si.imgix.net/184461ff/uploads/origins/14e808b0-5b54-4667-8505-5e07bdeeb6a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f648c0f9a45b9508bc4c664793980ce7 2x, https://si.imgix.net/184461ff/uploads/origins/14e808b0-5b54-4667-8505-5e07bdeeb6a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=717e932fbde141d642c76e9b83aae2a9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/184461ff/uploads/origins/14e808b0-5b54-4667-8505-5e07bdeeb6a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffaabecd0c5bbce41ef9499c2c88ca7d", "srcset": "https://si.imgix.net/184461ff/uploads/origins/14e808b0-5b54-4667-8505-5e07bdeeb6a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffaabecd0c5bbce41ef9499c2c88ca7d, https://si.imgix.net/184461ff/uploads/origins/14e808b0-5b54-4667-8505-5e07bdeeb6a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f53cb5948b108e196781494f7f8c639 2x, https://si.imgix.net/184461ff/uploads/origins/14e808b0-5b54-4667-8505-5e07bdeeb6a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2ea5b120a31e81d1f908208746daece 3x"}, "body": "こんにちは！\nむわっとした女の子がとても好みで最高なので良ければ依頼させていただいてもよろしいでしょうか…？\n\nキャラクターは『ブルーアーカイブ』の『明星ヒマリ』で。\n\nシチュエーションとしては、座って足を開くヒマリの長スカートに頭を入れて匂いを堪能するみたいな感じでお願いします！！\n\nまた良ければ何日かお風呂に入ってないぐらいのむわっとした感じで、主観視点で局部のドアップ構図も描いていただけると嬉しいです！！\n\n性癖依頼で申し訳ないのですが、もし良ければお願いいたします…！！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Monpe_0719/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1721235, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de922e9f/uploads/origins/0c9a3f0d-872d-4acb-81c5-fb653949ffa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=204b46846ac369f498dc43f6581295f4", "srcset": "https://si.imgix.net/de922e9f/uploads/origins/0c9a3f0d-872d-4acb-81c5-fb653949ffa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=204b46846ac369f498dc43f6581295f4, https://si.imgix.net/de922e9f/uploads/origins/0c9a3f0d-872d-4acb-81c5-fb653949ffa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3554d9df2f146cd87fc80cb2a076b594 2x, https://si.imgix.net/de922e9f/uploads/origins/0c9a3f0d-872d-4acb-81c5-fb653949ffa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4adc911502fd3942c98a889e5e2211ac 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de922e9f/uploads/origins/0c9a3f0d-872d-4acb-81c5-fb653949ffa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a16ac2f5be8e59edef5213c298d9e25", "srcset": "https:/