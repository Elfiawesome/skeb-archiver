ぽく描いてくれていいのよ…（！？）\nツイッター #アリ缶note タグも参考になれば\nあわよくば何かに印刷したいので印刷用解像度（細かいサイズ、縦横比はお任せ）でお願いします\n工数、枚数、手間をかける程度、背景のち密さなどは予算に見合うとのふくさんが思える範囲で構いません。ご検討頂けますと幸いです\n\nhttp://tocca571.parallel.jp/original/arc/\n\nhttps://twitter.com/paradoxicaltheo/status/1421715295769567233?t=TWcXz4cd5fJYwN49FwdvyQ&s=19", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shiodanu39/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "correction", "tipped": true, "creator_id": 1222528, "client_id": 2271, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2de1624/uploads/origins/5a798bf2-e69e-4c1b-a48f-4d81650375d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55b965b9cedc05f9be3b10bb161e0a19", "srcset": "https://si.imgix.net/b2de1624/uploads/origins/5a798bf2-e69e-4c1b-a48f-4d81650375d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55b965b9cedc05f9be3b10bb161e0a19, https://si.imgix.net/b2de1624/uploads/origins/5a798bf2-e69e-4c1b-a48f-4d81650375d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dffec07c553d8103a9f4fa3bc11a6a9f 2x, https://si.imgix.net/b2de1624/uploads/origins/5a798bf2-e69e-4c1b-a48f-4d81650375d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb71b8a7fc699c78aa29e7732e84390b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2de1624/uploads/origins/5a798bf2-e69e-4c1b-a48f-4d81650375d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06a27a64675db9324c86cb7d602cda26", "srcset": "https://si.imgix.net/b2de1624/uploads/origins/5a798bf2-e69e-4c1b-a48f-4d81650375d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06a27a64675db9324c86cb7d602cda26, https://si.imgix.net/b2de1624/uploads/origins/5a798bf2-e69e-4c1b-a48f-4d81650375d0?bg=%23fff&aut