crop&crop=top&w=200&h=200&s=9b481dc9b4c3f20b5373c679cecfc0b6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a9a89b8/uploads/origins/4abbdb53-d710-4f09-8abe-4ec43a723f15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d22db4665718fac480c4fdedfb326414", "srcset": "https://si.imgix.net/3a9a89b8/uploads/origins/4abbdb53-d710-4f09-8abe-4ec43a723f15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d22db4665718fac480c4fdedfb326414, https://si.imgix.net/3a9a89b8/uploads/origins/4abbdb53-d710-4f09-8abe-4ec43a723f15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8658148fa5465a1097322c36b4a0f550 2x, https://si.imgix.net/3a9a89b8/uploads/origins/4abbdb53-d710-4f09-8abe-4ec43a723f15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5ea861fc0785a671d79f8594f2f45f6b 3x"}, "body": "伯爵のイラストいつも楽しみにしています。\n「あやかしランブル」の「オオミヤノメ」をお願いします。\nシチュエーションは「かき氷を食べるシーン」で、背景にかき氷を作っている「ミユキ」をお願いします。\n衣装は、通常・覚醒・限定衣装どれも問いません。\nオクトモ伯爵の思い描く衣装でお願いします。\n構図は伯爵にお任せします。\n\n暑い日が続くので、オクトモ伯爵が描く涼しいイラストをお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@Mucoro/works/33", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 454465, "client_id": 2446833, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4a68e86/uploads/origins/24a726e2-a3da-44c1-8fd4-b78bf4c109bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=093af745c2fc22ae56de658090761d30", "srcset": "https://si.imgix.net/f4a68e86/uploads/origins/24a726e2-a3da-44c1-8fd4-b78bf4c109bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=093af745c2fc22ae56de658090761d30, https://si.imgix.net/f4a68e86/uploads/origins/24a726e2-a3da-44c1-8fd4-b78bf4c109bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0857959d18aef9c6e697a3173652b93a 2x, https://si.imgix.net/f4a68e86/uploads/origins/24a726e2-a3da-44c1-8fd4-b78bf4c109bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9efed5806e80bc37b599c1845ba168b7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4a68e86/uploads/origins/24a726e2-a3da-44c1-8fd4-b78bf4c109bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2f4dcb7d2c35800ca36b766168dafed", "srcset": "https://si.imgix.net/f4a68e86/uploads/origins/24a726e2-a3da-44c1-8fd4-b78bf4c109bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2f4dcb7d2c35800ca36b766168dafed, https://si.imgix.net/f4a68e86/uploads/origins/24a726e2-a3da-44c1-8fd4-b78bf4c109bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0eebcbb8b4060daa2ef97cb757cc933e 2x, https://si.imgix.net/f4a68e86/uploads/origins/24a726e2-a3da-44c1-8fd4-b78bf4c109bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cf044900476747e71f0c61c5595d37b8 3x"}, "body": "依頼では初めまして、ミユキが大好きな一般陰陽師です。\n以前に投稿されていました「あやかしランブル！」のミユキのイラストに感銘を受けまして、今回またミユキを描いて頂きたいと思いリクエストしました。\n衣装:「六花咲く剣 ミユキ」のものを\n時間帯と場所:真夜中の雪山の小屋\n視点:主人公から見た視界\nシチュエーション:任務の帰路途中で吹雪いてきたため、いつも使っていた山小屋に避難。吹雪は収まったものの遅い時刻なので寝泊まりすることに。しかし布団は1つしかなく仕方ないので2人で1つの布団へ。当然狭いもので、ミユキの柔らかな胸や肢体の感触が直に伝わってきて顔も心も熱さを増していく。\n(ここから絵にして頂きたい部分)ふとした瞬間ミユキと目が合い、お互いに顔を紅潮させ、同じ想いをしていたことに気がつき微笑み合う。するとミユキは服の胸元に右親指をかけ、形の良い乳房(彼女から見て右側)を露出させてきた。こちらを誘うような眼差しで見つめてきて、我慢できなさそうに息を荒らげ、顔をさらに紅く染めている…。\n体勢:2人とも布団に寝転がり、天井に向かいミユキが右側、主人公が左側になっている\nこのようなシチュエーションでお願いしたいです。今年あやらぶ内で追加された新機能「追想心景」のような感じで、式神との距離がグッと縮まっている状態、真夜中の雪山とはいえ月の光に小屋内が青白く照らされている様子、それらとミユキの白い素肌が紅潮するギャップを感じられたら幸いです(欲を言えば元から露出している右太もも、自ら露出させた右胸、紅潮させたお顔を見ることができれば…)。完成致しましたらお顔だけアイコンにさせて頂いたり、discordやXにて告知をさせて頂くことは可能でしょうか？一触即発で見ていて焦れったくなるようなイラストをお願いします！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toshirou9/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 599205, "client_id": 2446833, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4747b806/uploads/origins/499e1061-b8a6-42c4-862a-10075ee5844c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50cdd07989429cd92e7a7ee3a6b40cba", "srcset": "https://si.imgix.net/4747b806/uploads/origins/499e1061-b8a6-42c4-862a-10075ee5844c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50cdd07989429cd92e7a7ee3a6b40cba, https://si.imgix.net/4747b806/uploads/origins/499e1061-b8a6-42c4-862a-10075ee5844c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d191cfbb0c55a887f16d90d1e2af3763 2x, https://si.imgix.net/4747b806/uploads/origins/499e1061-b8a6-42c4-862a-10075ee5844c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2c81beb2d9f32a5309961a97c961bf7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4747b806/uploads/origins/499e1061-b8a6-42c4-862a-10075ee5844c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87cc9f24f43f25ecf474d4546f03602a", "srcset": "https://si.imgix.net/4747b806/uploads/origins/499e1061-b8a6-42c4-862a-10075ee5844c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87cc9f24f43f25ecf474d4546f03602a, https://si.imgix.net/4747b806/uploads/origins/499e1061-b8a6-42c4-862a-10075ee5844c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c2a4147d10955357c847d607cc3520f4 2x, https://si.imgix.net/4747b806/uploads/origins/499e1061-b8a6-42c4-862a-10075ee5844c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=41fd08c23cc6a6a515493bc687aa0d7d 3x"}, "body": "初めまして、オクトモです。\n「あやかしランブル！」に登場する雪女「六花咲く剣 ミユキ」のイラストをお願いします。「マガツヒと戦っている(刀を抜いて戦闘をしている)ワンシーン」を希望します。\n冷気や霊力が溢れ、力強くも美しいミユキの姿がそこに表現されていれば嬉しいです(余裕があれば誰かと共闘させて頂いても大丈夫です)。\nトーシローさんの描くミユキが見たい、かっこいいミユキも見たいと思ってリクエストしました、よろしくお願いします。\n\nhttps://ayarabu.wikiru.jp/?%E2%98%855/%E5%85%AD%E8%8A%B1%E5%92%B2%E3%81%8F%E5%89%A3+%E3%83%9F%E3%83%A6%E3%82%AD", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tksmk3/works/50", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1492969, "client_id": 2446833, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd7f142d/uploads/origins/e891c6bc-12c5-417f-b2af-52bb80ecf833?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=655a0189892a4d624997a84ffdec5ef6", "srcset": "https://si.imgix.net/bd7f142d/uploads/origins/e891c6bc-12c5-417f-b2af-52bb80ecf833?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=655a0189892a4d624997a84ffdec5ef6, https://si.imgix.net/bd7f142d/uploads/origins/e891c6bc-12c5-417f-b2af-52bb80ecf833?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=54afbf470ae267093d2be3f76202b08a 2x, https://si.imgix.net/bd7f142d/uploads/origins/e891c6bc-12c5-417f-b2af-52bb80ecf833?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9be46ffc135eb42b1cf912ce38c45d6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd7f142d/uploads/origins/e891c6bc-12c5-417f-b2af-52bb80ecf833?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04aacfe1519ce465a67e02a65b97104c", "srcset": "https://si.imgix.net/bd7f142d/uploads/origins/e891c6bc-12c5-417f-b2af-52bb80ecf833?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04aacfe1519ce465a67e02a65b97104c, https://si.imgix.net/bd7f142d/uploads/origins/e891c6bc-12c5-417f-b2af-52bb80ecf833?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b35b59d60573facd738c6c077804a39 2x, https://si.imgix.net/bd7f142d/uploads/origins/e891c6bc-12c5-417f-b2af-52bb80ecf833?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d42cd0b9d69e9c5c180c4081a8e931d 3x"}, "body": "tks様、初めまして、オクトモと申します(伯爵の部分は有るようで無いようなもの)。\n以前からあやらぶ内の式神たちや、他のゲームのキャラクター達の素晴らしいイラストを描かれているのを見ております。今回は私自身の誕生日も程々に近づいてきたので、「誕生日にイラスト描いてもらうのも良いかもなぁ」という心境で今回初めてリクエストを送ろうと思い、この文章を入力しております。\n\n「あやかしランブル！」に登場する雪女「ミユキ」をリクエストさせて頂きます。衣装はクリスマス版。\nサンサンと雪の降る日のデート、ミユキは幸せそうに微笑みながら陰陽師の腕を抱きしめ、夜の街を練り歩いていく様子。雪女の肌は冷たいはずなのに、そのデートの時はほんのり暖かかった…。\nミユキを主体に描いてほしいのと、抱きしめたときにおっぱいや肌の柔らかさが伝わるような感じ、白い肌や降る雪が街の光に照らされて淡く光るようなロマンチックな雰囲気が出ていたら心臓を射抜かれます。陰陽師側の服装は制服を着用して、軽く防寒対策(マフラーや手袋等)をしている感じだとリアリティがあります。\n最後に厚かましいのですが、ミユキや主人公が隠れない位置に「誕生日おめでとうございます」のようなちょっとした一文があれば今後も生きる勇気が湧きそうです。\nここで聞けば良いのか分かりませんが、頂いたイラストをdiscordのアイコンに使用させて頂くことは可能でしょうか？\n初めてのskebリクエストでどう伝えれば良いか悩みました。分かりずらい部分もあるかもしれませんが、ご検討をよろしくお願いします。\n\nhttps://ayarabu.wikiru.jp/?%E2%98%855/%E8%81%96%E5%A4%9C%E3%81%AE%E7%99%BD%E9%9B%AA+%E3%83%9F%E3%83%A6%E3%82%AD", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1711709, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Stella", "screen_name": "SStella_JP", "avatar_url": "https://pbs.twimg.com/profile_images/1948232322844938240/vukz--jz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1098147966429188097/1772612561/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 2278859, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "MUSASHI🐾Kemo