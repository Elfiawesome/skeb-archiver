ttps://si.imgix.net/b51f3c20/uploads/origins/491953a1-daa2-4b06-a3ba-d77afd39e607?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7babd926f5924259a2bac20ca7d78839 3x"}, "body": "こんにちは！ジュヴラーです。この蛇の女性を描いていただけませんか？\nhttps://drive.google.com/drive/folders/1H8x7JA87E0K3FE2QsidVJlM5DtMZs4dU  「1OG1」「1OG2」「1OG3」という名前の画像ファイルを参考にしてください。 \n 彼女はダンサーで、体を自在に曲げ伸ばすことができます。偽物の蛇の手を持っており、それを使って獲物や天敵の注意をそらします。その偽物の蛇の手の牙の部分には、2本の指型短剣が付いています。普段は砂漠にいます。彼女はゆったりとした服を着るのが好きで、生地が邪魔になることなく、体を自由に曲げたり形を整えたりできるからです。砂漠の住人でありながら、彼女は冷徹な性格の持ち主です。 この冷たさをイラストで表現していただけると嬉しいです。目はそのままにしてください。お腹が露出している姿にしてください！ポーズは自由です！よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Koo0T_Tocc/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3948985, "client_id": 830730, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9457771/uploads/origins/9c4646c0-57b0-4af9-933c-571eda8e1a48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebf0c41d8066a66d5fb1a6c190685848", "srcset": "https://si.imgix.net/d9457771/uploads/origins/9c4646c0-57b0-4af9-933c-571eda8e1a48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebf0c41d8066a66d5fb1a6c190685848, https://si.imgix.net/d9457771/uploads/origins/9c4646c0-57b0-4af9-933c-571eda8e1a48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=444df968b0ffce1adb6f94040ce3a9c4 2x, https://si.imgix.net/d9457771/uploads/origins/9c4646c0-57b0-4af9-933c-571eda8e1a48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=796d79eb9d0d9bfe2b1e3b06faad8f92 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9457771/uploads/origins/9c4646c0-57b0-4af9-933c-571eda8e1a48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e