atus/1518023720584974336\n\n愛で動いているバーチャルアンドロイドです。\n猫が好きで猫耳を生やしていて、人間の耳は付いていません。\n服装や髪型はこの通りでなくても歓迎です。\nアクセサリーや装飾なども自由にしただければと思います。\n\n■構図等\n全てお任せ致します。\n耳が見切れないようにしていただけると幸いです。\n\nTwitter上やYoutubeのサムネイル等に使用させて頂きたいので、許可を頂ける場合にリクエスト承認して頂ければと思います。\nキャタクター、サイン等のレイヤーが別の状態のpsdデータで頂けるとありがたいです。\n\nよろしくお願い致します。\n\nhttps://twitter.com/shi_na_matatabi/status/1518023720584974336", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suu2501/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 713127, "client_id": 2160883, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52a758f3/uploads/origins/531df66f-afed-42bf-a3dd-50fe751cb614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0af40d1fa2fe1d267383300828760845", "srcset": "https://si.imgix.net/52a758f3/uploads/origins/531df66f-afed-42bf-a3dd-50fe751cb614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0af40d1fa2fe1d267383300828760845, https://si.imgix.net/52a758f3/uploads/origins/531df66f-afed-42bf-a3dd-50fe751cb614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=660e8668193b52f5db7d60d7c4bc7d8c 2x, https://si.imgix.net/52a758f3/uploads/origins/531df66f-afed-42bf-a3dd-50fe751cb614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5622c561b6f57e1bb462f7d6503b2f78 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52a758f3/uploads/origins/531df66f-afed-42bf-a3dd-50fe751cb614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=280475a133d0752b41d236619484baab", "srcset": "https://si.imgix.net/52a758f3/uploads/origins/531df66f-afed-42bf-a3dd-50fe751cb614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=280475a133d0752b41d236619484baab, https://si.imgix.net/52a758f3/u