ue, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@rubbish198/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1539507, "client_id": 13320, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b912585/uploads/origins/f5f51977-432d-43a5-8b11-69c70244bfba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61597f823eecdaf1407b98b2dc72d8cc", "srcset": "https://si.imgix.net/9b912585/uploads/origins/f5f51977-432d-43a5-8b11-69c70244bfba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61597f823eecdaf1407b98b2dc72d8cc, https://si.imgix.net/9b912585/uploads/origins/f5f51977-432d-43a5-8b11-69c70244bfba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb79e27cd1e07494fec210001909de4e 2x, https://si.imgix.net/9b912585/uploads/origins/f5f51977-432d-43a5-8b11-69c70244bfba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc6ad07ae9c8ef68bb60858871ab5415 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b912585/uploads/origins/f5f51977-432d-43a5-8b11-69c70244bfba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0cbf70dd4ccfa47ec64d5f4f8547303", "srcset": "https://si.imgix.net/9b912585/uploads/origins/f5f51977-432d-43a5-8b11-69c70244bfba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0cbf70dd4ccfa47ec64d5f4f8547303, https://si.imgix.net/9b912585/uploads/origins/f5f51977-432d-43a5-8b11-69c70244bfba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a47b745eb4afd016d4df842097244cc5 2x, https://si.imgix.net/9b912585/uploads/origins/f5f51977-432d-43a5-8b11-69c70244bfba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b3a8fca14456376b8c24e289287d2f03 3x"}, "body": "お世話になっております！\n以前から鮮やかなアニメ塗りや可愛い女の子が素敵だな思いながら拝見していたので（特にバニーの日の妖精さんたちが一目惚れで……！）、この機にリクエストをお送りいたしました。\n制作中の作品で恐縮なのですが、拙作の双子の姉妹、イーナとニーナをお願いしたいです。\n以下に情報を明記しましたので、ご参照お願いいたします。\n本質はダークな作品なので、その雰囲気が出ていると嬉しいです！\n\nいただいたイラストはX、ブルースカイに投稿させていただきたいです。\nゲーム制作のやる気の糧にしたいので、よろしくお願いいたします！\n\n\n【体験版紹介ツイート】\nhttps://x.com/fecmomomuu/status/1775875917342179707\nツイートに画像が４枚あるのでご参考までに！\n\n【世界観】\n　ある山小屋に暮らす、双子の少女と一人の男。\n　朝はパンを食べ、授業をし、余暇を過ごし、夕飯の後は三人で団欒をする。\n　何の変哲もない日々は、今から五日後に、必ず終わりを迎える。\n　\n　謎の寄生生物に蝕まれた少女たちを助ける方法はただ一つ。\n　片方の少女の心臓を、もう片方の少女に食べさせること。\n　二人とも救う方法はない。\n\n　決断の日までに、貴方は選ばなければならない。\n　誰を救うため、誰を犠牲にするのかを。\n\n　一人の少女を救うために、もう一人の少女の命を奪う、救済選択ADV\n\n【イーナ】\n赤い花の双子の姉。タレ目。\n身長149cm。18歳（ただし、寄生された11歳の時から身体の成長は止まっている）。\nちょっと生意気な明るいギャル。両親と住んでいた頃はよく手伝いをしていたため、家事全般はわりと得意。しかしやや大雑把な所も。得意料理はごろっと野菜のポトフスープ。\n現在は身を隠している状況のため地味な服装だが、本当は派手で可愛いものが好き。\nニーナのことが嫌い。\n\n【ニーナ】\n青い花の双子の妹。タレ目だが瞼が重めでジト目ぎみ。\n身長149cm。18歳（ただし、寄生された11歳の時から身体の成長は止まっている）。\nいつも飄々とした皮肉屋で、イーナに輪をかけて生意気。イーナからは「厨二病」と呼ばれることも。\n読書家で冷静な判断に長けており、勉強もイーナより得意（イーナも頭は悪くない）。\nガサツで整理整頓はできない。\nイーナのことは嫌いではない。\n\n※靴は二人とも茶色のショートブーツです", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rubbish198/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1539507, "client_id": 1318798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83e4e28e/uploads/origins/7ba46cde-2ccf-4f30-8004-8e71f363bfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b593ddbbb83b13a6e5d4649131f8301", "srcset": "https://si.imgix.net/83e4e28e/uploads/origins/7ba46cde-2ccf-4f30-8004-8e71f363bfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b593ddbbb83b13a6e5d4649131f8301, https://si.imgix.net/83e4e28e/uploads/origins/7ba46cde-2ccf-4f30-8004-8e71f363bfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e58cc4691dcf46d80d13013eabb346d7 2x, https://si.imgix.net/83e4e28e/uploads/origins/7ba46cde-2ccf-4f30-8004-8e71f363bfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b89c8199207e501dc03060a3eeaaf292 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83e4e28e/uploads/origins/7ba46cde-2ccf-4f30-8004-8e71f363bfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1c7534874a1effacd68c0b4479a8b88", "srcset": "https://si.imgix.net/83e4e28e/uploads/origins/7ba46cde-2ccf-4f30-8004-8e71f363bfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1c7534874a1effacd68c0b4479a8b88, https://si.imgix.net/83e4e28e/uploads/origins/7ba46cde-2ccf-4f30-8004-8e71f363bfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=68cd37a5eb2fa1eac1fdcb14cd3a524e 2x, https://si.imgix.net/83e4e28e/uploads/origins/7ba46cde-2ccf-4f30-8004-8e71f363bfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=53b916c1fdd91c94a9140bc094f49aca 3x"}, "body": "はじめまして\n\n東方LostWordの秘封レミリア(小さな悪魔令嬢)をお願いします。\n\n羽根を描き忘れないようにお願いします。\nまた、帽子のリボンは(第三者視点で)左側で、雫を3つ付けてください。\n(この2点は必ず立ち絵通りがいいので、よろしくお願いします)\n\nhttps://x.com/touhou_lw/status/1672902452088131587?s=46\n\n何卒、よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@keronfrog/works/164", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1549008, "client_id": 1539507, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6aac9610/uploads/origins/2b679d03-0bdb-4ac0-892b-6930ccf8a81b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5beb668214e9fcec07d06c799e78bf92", "srcset": "https://si.imgix.net/6aac9610/uploads/origins/2b679d03-0bdb-4ac0-892b-6930ccf8a81b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5beb668214e9fcec07d06c799e78bf92, https://si.imgix.net/6aac9610/uploads/origins/2b679d03-0bdb-4ac0-892b-6930ccf8a81b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a9ec26d36fc0dc70175ded09615c0b8 2x, https://si.imgix.net/6aac9610/uploads/origins/2b679d03-0bdb-4ac0-892b-6930ccf8a81b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e64f6b4689572c909ad5cf9dd37175d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6aac9610/uploads/origins/2b679d03-0bdb-4ac0-892b-6930ccf8a81b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8da0a76fbbc4d8062eb1fd5f6ba7ac7d", "srcset": "https://si.imgix.net/6aac9610/uploads/origins/2b679d03-0bdb-4ac0-892b-6930ccf8a81b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8da0a76fbbc4d8062eb1fd5f6ba7ac7d, https://si.imgix.net/6aac9610/uploads/origins/2b679d03-0bdb-4ac0-892b-6930ccf8a81b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d871db2b3cbea46576d8de70cfbc8d34 2x, https://si.imgix.net/6aac9610/uploads/origins/2b679d03-0bdb-4ac0-892b-6930ccf8a81b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c7703195752a9736bf9fb93f17c4799e 3x"}, "body": "ご依頼では初めまして！\nいつもお世話になっております。\nうちのメインヒロイン、タルトの別衣装デザインを描いていただきたく依頼させていただきました。\n前からキャラデザ依頼気になってたので…\n\nタルトは14歳の女の子で、口調は男っぽいイメージ。\n茶髪青緑目で肌は中間（白くも極端に焼けてもない程度）くらい。\n横髪がくるんとしてます。前髪は真ん中分けですが、ちょっと鼻筋かかる程度の髪もあります。\n後ろ髪はセミロングくらい…？お話の途中で切りますがまた伸ばすので成長後もそれなりに長いかも。\n普段はツインテールにしてますが髪型は変えてしまってもOKです。\n身長小さめ。\n魔法使いの生まれですが戦闘時は結構物理に近いです。\n一応セレナ（風の精霊さん）と契約したことで風魔法は扱える設定です。\n短気で怒りっぽいように見えますが、気弱なのを隠している意地っ張りみたいなところがあります。\n\n①春服\n②夏服\n③秋服\n④冬服\n⑤おまかせ\n\nひな祭りや夏祭り、ハロウィンやクリスマス等イベントの服でもOKです！\nデート着とか戦闘服とか……\n現代服でもファンタジー世界でいけそうなのでも、どちらでも嬉しいです！\n↑の番号のはフレーバーとして参考になれば良いなぁ程度に描いたので、\n「思いついたもの5選！！」とかでも構いません…！\nちょっと成長後に着てる服！とかも歓迎です！\n色々書きましたが、細かいとこはお任せしてみたいです！\n\nhttps://x.com/rubbish198/status/1958446427383931206", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 75267, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "sa-nu", "screen_name": "sa__nu", "avatar_url": "https://pbs.twimg.com/profile_images/1898683738692997120/6N5F7LxJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/96351418/1753767969/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 70, "skills": [{"genre": "art"}], "nc": 48}, {"id": 287439, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "RYK@名華祭B-31", "screen_name": "rykyukkuri", "avatar_url": "https://pbs.twimg.com/profile_images/2041111115816747009/EIPrUpwf.jpg", "header_url": "https://pbs.twimg.com/profile_banners/701096717823770628/1758121231/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 0}, {"id": 3297274, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "紫音", "screen_name": "shion__art", "avatar_url": "https://pbs.twimg.com/profile_images/1993913374728704002/-ZISTN9u.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 160}, {"id": 3487332, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ざこてゃ", "screen_name": "mamezako_chan", "avatar_url": "https://pbs.twimg.com/profile_images/205150723