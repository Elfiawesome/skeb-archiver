179-4252-bbb5-67a9ceeb83ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=073d6a7634674b5b67481df994c2c1fb", "srcset": "https://si.imgix.net/641f1505/uploads/origins/f6794ecd-d179-4252-bbb5-67a9ceeb83ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=073d6a7634674b5b67481df994c2c1fb, https://si.imgix.net/641f1505/uploads/origins/f6794ecd-d179-4252-bbb5-67a9ceeb83ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac5167bee8501edd301bc11584e42014 2x, https://si.imgix.net/641f1505/uploads/origins/f6794ecd-d179-4252-bbb5-67a9ceeb83ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dfe5a27681ba9778ede4f78bdd47f665 3x"}, "body": "こんにちは！\n\n「午後8時の瀬戸さんの足」から瀬戸さんをモノクロ漫画リクエストさせてお願いします。漫画が無理なら差分付きのモノクロイラストも大丈夫です。\n\nシチュエ\n瀬戸さんは全裸でベッドに横たわり、素足を長谷川に舐められています。気持ちいいかどうか聞いてが、彼女は認めなかった。\n\nいきなり瀬戸さんの足をくすぐる。声をこらえようとするが、思わず大きな笑い声が漏れてしまう。長谷川は、正直になるまでくすぐり続けると彼女に告げる。\n\n彼女は恥ずかしがりながら足を舐められると気持ちいいと認めた。\n\n長谷川は瀬戸さんの素直に報い、足を気持ちよくしてあげます。\n\n彼は彼女の足の裏をマッサージしながら同時に足指を吸う。長時間土踏まずを舐められて足の裏だけでイってしまう。\n\n面倒なリクエストで申し訳ありません、よろしくお願いします！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mi_tsujiro/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3624245, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30908bf8/uploads/origins/bec37883-d61f-4701-9aee-382e8388ab6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aa2dddf1d3d67b113bd33a547c822bc", "srcset": "https://si.imgix.net/30908bf8/uploads/origins/bec37883-d61f-4701-9aee-382e8388ab6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aa2dddf1d3d67b113bd33a547c822bc, https://si.imgix.net/30908bf8/uploads/origins/bec37883-d61f-4701-9aee-382e8388ab6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a79fa431963094efccd24d85a3f26fa8 2x, https://si.imgix.net/30908bf8/uploads/origins/bec37883-d61f-4701-9aee-382e8388ab6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30b8becec1ecccd68399b0d16789c794 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30908bf8/uploads/origins/bec37883-d61f-4701-9aee-382e8388ab6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6681c24938623813a1696f86698a5da", "srcset": "https://si.imgix.net/30908bf8/uploads/origins/bec37883-d61f-4701-9aee-382e8388ab6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6681c24938623813a1696f86698a5da, https://si.imgix.net/30908bf8/uploads/origins/bec37883-d61f-4701-9aee-382e8388ab6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f755b2d51a6449a3173efbb7842d9dbf 2x, https://si.imgix.net/30908bf8/uploads/origins/bec37883-d61f-4701-9aee-382e8388ab6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b610aa16ddfb2c0ffea22db28a89192f 3x"}, "body": "こんにちわ\nオリジナルキャラで、昔の農家の30歳前後、\nもんぺ姿の黒髪女性の緊縛カラーイラストをリクエストしたいです。\n髪型、顔だち、体型等はお任せします。\n恰好\n野良着、もんぺ、足袋履きで、\n胸を出して、片足立ち、上半身ともう一方の片足が上から吊られています。\n表情は号泣している感じにしてほしいです。\n頭から、爪先まで全身を描いてほしいです。\n服装\n野良着の色は紺、模様は適当に、\nもんぺはへその下辺りで紐を結ぶ袴式、長さはくるぶしまでで、色、模様は濃い紫系の縞、\nもんぺの腰脇は袴の様にスリットを開けてほしいです。\n足袋はくるぶしまでの長さで、色は青緑にしてほしいです。\nポーズイメージは資料URLをご覧ください。\nまた、\nもんぺの股間部分を破られ、陰部に張型が挿入され\n表情も苦しそうに涙を流し絶叫している状態もお願いします。\nつたない説明で恐縮ですが、\n説明不足な点、構図など自由に、変更、アレンジしていただいて構いませんが、\n必ず、全身のイラストでもんぺが破れていない状態と、破れた状態を描いていただきたいです。\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fi/pcj1ahyu22xhjhiel70vl/k01.png?rlkey=7ksncn4umz3viwoimgllrhhe8&st=p17etkqz&dl=0", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 96586, "creator": true, "nsfw_acceptable": true, "acceptable": true, "na