s backstory has to do with space, sunsets, and monsters like Cthulhu!\n\nPlease draw him however you’d like, and please include a PNG version of the artwork!!\n\nhttps://drive.google.com/drive/folders/1cBAN5pi71M3rhvWiP_L7fTWVyQ2lBo66", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@testmfos/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2357384, "client_id": 552598, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a30fad13/uploads/origins/69bf0e4d-3dcf-4402-bd20-3a118cf52a74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5894628641773bad91e09b11d66d522", "srcset": "https://si.imgix.net/a30fad13/uploads/origins/69bf0e4d-3dcf-4402-bd20-3a118cf52a74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5894628641773bad91e09b11d66d522, https://si.imgix.net/a30fad13/uploads/origins/69bf0e4d-3dcf-4402-bd20-3a118cf52a74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a205389372fa690d0c7c8dd08435b6d 2x, https://si.imgix.net/a30fad13/uploads/origins/69bf0e4d-3dcf-4402-bd20-3a118cf52a74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=540c6cd2170f7bc679fa4b78b47ab1e5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a30fad13/uploads/origins/69bf0e4d-3dcf-4402-bd20-3a118cf52a74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd568cdc634a043b66c643ed9e8e914f", "srcset": "https://si.imgix.net/a30fad13/uploads/origins/69bf0e4d-3dcf-4402-bd20-3a118cf52a74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd568cdc634a043b66c643ed9e8e914f, https://si.imgix.net/a30fad13/uploads/origins/69bf0e4d-3dcf-4402-bd20-3a118cf52a74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&bl