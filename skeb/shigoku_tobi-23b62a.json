イル形式は、キャラクターと背景を分けたPSDファイルでいただけると幸いです。\n・構図やポーズに関してはお任せいたします。（笑顔で描いていただけるとありがたいです）\n\n以上になります。\nぜひともご検討のほど、よろしくお願いいたします。\n\nhttps://twitter.com/oha_eleme/status/1685855675791081472/photo/2", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shigoku_tobi/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1383027, "client_id": 1538216, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ac10c3d/uploads/origins/ec568257-f3dd-4fb1-a6f5-61ef83d72d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf4818319ba4f23347b5eee1de462faa", "srcset": "https://si.imgix.net/9ac10c3d/uploads/origins/ec568257-f3dd-4fb1-a6f5-61ef83d72d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf4818319ba4f23347b5eee1de462faa, https://si.imgix.net/9ac10c3d/uploads/origins/ec568257-f3dd-4fb1-a6f5-61ef83d72d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62480982146d1ed4b9c19ad11f85d3e6 2x, https://si.imgix.net/9ac10c3d/uploads/origins/ec568257-f3dd-4fb1-a6f5-61ef83d72d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5dfed51169d80f73d1edf5fbf28417c9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ac10c3d/uploads/origins/ec568257-f3dd-4fb1-a6f5-61ef83d72d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3fdfbe1992e9e6b32fa433b8f00feef", "srcset": "https://si.imgix.net/9ac10c3d/uploads/origins/ec568257-f3dd-4fb1-a6f5-61ef83d72d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3fdfbe1992e9e6b32fa433b8f00feef, https://si.imgix.net/9ac10c3d/uploads/origins/ec568257-f3dd-4fb1-a6f5-61ef83d72d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=58ecc34b13561a59b7b60a0e792eca2