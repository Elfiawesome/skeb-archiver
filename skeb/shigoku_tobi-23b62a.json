setti.com/mainyosegakis/invite?id=2523163&sc=hLvhY\n・寄せ書きを募集をする際、私の拡散力の問題でタグつきツイートを本人に拡散していただく予定です(本人了承済み)ので、念の為早めに納品いただいても募集中は載せない予定です。\n・私の想像力が貧弱なため大変申し訳ございませんが、構図や表情などはお任せしたいです。\n私がskebを利用する経験が少ない都合上至らぬ点や失礼がございましたら申し訳ありません。ご検討のほど何卒よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shigoku_tobi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1383027, "client_id": 2862778, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e0511e0/uploads/origins/f213fdcf-f4e8-40ae-806b-f13e6c5465c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ef0b38dfed8ba39abe7deae2b906a26", "srcset": "https://si.imgix.net/0e0511e0/uploads/origins/f213fdcf-f4e8-40ae-806b-f13e6c5465c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ef0b38dfed8ba39abe7deae2b906a26, https://si.imgix.net/0e0511e0/uploads/origins/f213fdcf-f4e8-40ae-806b-f13e6c5465c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ca9ad4b6107dea6c6c28731cc9cebf1 2x, https://si.imgix.net/0e0511e0/uploads/origins/f213fdcf-f4e8-40ae-806b-f13e6c5465c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6945878c94815e90888c4825427a5d37 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e0511e0/uploads/origins/f213fdcf-f4e8-40ae-806b-f13e6c5465c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ec966a82ab12a9a7e174abc2f4424d7", "srcset": "https://si.imgix.net/0e0511e0/uploads/origins/f213fdcf-f4e8-40ae-806b-f13e6c5465c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ec966a82ab12a9a7e174abc2f4424d7, https://si.imgix.net/0e0511e0/uploads/origins/f213fdcf-f4e8-40ae-806b-f13e6c5465c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop