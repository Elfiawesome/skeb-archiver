人物が別れているpsd形式での納品希望\n・可能であればラフもいただければ嬉しいです\n\n使用用途:お相手のフォロワーへのプレゼント、個人利用目的でのグッズ制作\n\n金額に見合わない場合は再送要請お願いします。\nお忙しい中恐縮ですが、どうかよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1UPlhCXy_mrPKeBg9v7u8CTqlZuJ1s2M9?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nitsuki_09/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2701724, "client_id": 3104722, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62665da3/uploads/origins/d75fc3cb-5846-43ab-b0f5-ec63ba2dbe20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e2225f54629906a4f672b5b975024bd", "srcset": "https://si.imgix.net/62665da3/uploads/origins/d75fc3cb-5846-43ab-b0f5-ec63ba2dbe20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e2225f54629906a4f672b5b975024bd, https://si.imgix.net/62665da3/uploads/origins/d75fc3cb-5846-43ab-b0f5-ec63ba2dbe20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e08ba3acd3f8729bfcb25787f502fb44 2x, https://si.imgix.net/62665da3/uploads/origins/d75fc3cb-5846-43ab-b0f5-ec63ba2dbe20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f3e4abe866a947e84b5b8296421919c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62665da3/uploads/origins/d75fc3cb-5846-43ab-b0f5-ec63ba2dbe20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03f409a98f10c0829674550cc48746e3", "srcset": "https://si.imgix.net/62665da3/uploads/origins/d75fc3cb-5846-43ab-b0f5-ec63ba2dbe20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03f409a98f10c0829674550cc48746e3, https://si.imgix.net/62665da3/uploads/origins/d75fc3cb-5846-43ab-b0f5-ec63ba2dbe20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=20