ed_thumbnail_image_urls": {"src": "https://si.imgix.net/d4c3fc31/uploads/origins/159e469e-6c92-4304-b235-068aa2491d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3f911e4589c8fa842ef0ad4b6f9fce5", "srcset": "https://si.imgix.net/d4c3fc31/uploads/origins/159e469e-6c92-4304-b235-068aa2491d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3f911e4589c8fa842ef0ad4b6f9fce5, https://si.imgix.net/d4c3fc31/uploads/origins/159e469e-6c92-4304-b235-068aa2491d38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eb8dc81edfb309db66f90d1e5be667e6 2x, https://si.imgix.net/d4c3fc31/uploads/origins/159e469e-6c92-4304-b235-068aa2491d38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a5184513e1a46aec48c66043aa79ea3f 3x"}, "body": "はじめまして❕Twitchで配信活動を行っている黒岡ましろと申します。タイムラインで長月様の素敵な初音ミクイラストを拝見し、自分も依頼したいと思いリクエストをおくらせて頂きました。\n\n・要望\n元気いっぱいで可愛らしい（アバウトですみません💦）イメージのイラストをお願いしたいです。下半身がほんの少し見えるくらいの構図でお願いします。透過のデータもいただけると嬉しいです……❕\n\n・使用キャラ\n○髪型…白髪のくるくるツインテール（黒いリボン）\n○瞳の色…茶色\n○服装…黒に近い紺色のセーラー服､リボンは赤､スカートの長さは膝よりほんの少し上\n\n資料URLの方にも画像を貼っておきます❕\n\n・使用用途\n○𝕏で投稿\n○ファンボックスに加入してくれている方へ､ネットプリントの配布（その際メッセージをイラストに書き足したいです）\n\nご検討の程、よろしくお願い致します…❕\n\nhttps://x.com/kurokamashiro/status/1752177879411233233", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nitsuki_09/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2701724, "client_id": 1204429, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e2263b7/uploads/origins/9bf7bdac-f22a-4873-af6e-7bb8fc479dae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e00b254c586e847a7dd1040ae9e6db0", "srcset": "https://si.imgix.net/0e2263b7/uploads/origins/9bf7bdac-f22a-4873-af6e-7bb8fc479dae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e00