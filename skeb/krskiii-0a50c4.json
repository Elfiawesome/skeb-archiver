n※服装や家事・料理道具は現代と全く変わりません。もし小道具が必要な場合は何も気にせず描いていただいて大丈夫です！\n\nよろしければ、お願いいたします！\n\nhttps://www.dropbox.com/s/q57bxl2g7trwxza/incho.zip?dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@krskiii/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 126884, "client_id": 135761, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a664021c/requests/56166_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e95f8d2d54f94cfc8c57afadb7ac680b", "srcset": "https://si.imgix.net/a664021c/requests/56166_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e95f8d2d54f94cfc8c57afadb7ac680b, https://si.imgix.net/a664021c/requests/56166_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a174be73a3e6184ead839d4c6ac09067 2x, https://si.imgix.net/a664021c/requests/56166_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcb60c5f16c37fbe46af7f9483223927 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a664021c/requests/56166_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0e072c38ceefba7ff5cf030500ecf2a", "srcset": "https://si.imgix.net/a664021c/requests/56166_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0e072c38ceefba7ff5cf030500ecf2a, https://si.imgix.net/a664021c/requests/56166_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c00f8c6e8087380246872ef3e4c034c7 2x, https://si.imgix.net/a664021c/requests/56166_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5bca1c313c8cf2a25e1daf24a64a3fe9 3x"}, "body": "鬼滅の刃から神崎アオイをお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "