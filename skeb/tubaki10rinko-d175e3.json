 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/603a87f0/uploads/origins/87bee901-3234-4bb6-ac17-a87369c9252c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27caaec800f0f72cc8cd2ee520ecd989", "srcset": "https://si.imgix.net/603a87f0/uploads/origins/87bee901-3234-4bb6-ac17-a87369c9252c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27caaec800f0f72cc8cd2ee520ecd989, https://si.imgix.net/603a87f0/uploads/origins/87bee901-3234-4bb6-ac17-a87369c9252c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9eeb66abc0edd50ca1cef51daf28c44 2x, https://si.imgix.net/603a87f0/uploads/origins/87bee901-3234-4bb6-ac17-a87369c9252c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c2cd45d6a5a7b41555bbee8856321bf5 3x"}, "body": "以前東しじま。様の描くラフ画のイラストをはじめて見て、人物や小物の雰囲気にとても惹かれてぜひ依頼させていただきたいと思っていたのですが、遅くなってしまい申し訳ないです。\n\nいちご、お花、猫が好きなので、それをモチーフにした小物と資料の女の子を描いていただきたいです。\n\n小物のみのイラストの納品も可能であればお願いしたいです。\n\nhttps://drive.google.com/file/d/1Un9MBmr8J_KbWlxlq-dsV1dxTkL5a-C2/view?usp=drivesdk", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tubaki10rinko/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3752185, "client_id": 2376694, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d90935b/uploads/origins/49fd4396-c05a-44c9-817c-25263f3a1a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c4f22fb4bbb37d077267c719ad0db23", "srcset": "https://si.imgix.net/3d90935b/uploads/origins/49fd4396-c05a-44c9-817c-25263f3a1a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c4f22fb4bbb37d077267c719ad0db23, https://si.imgix.net/3d90935b/uploads/origins/49fd4396-c05a-44c9-817c-25263f3a1a31?bg=%23fff&auto=form