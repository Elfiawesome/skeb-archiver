"genre": "comic"}], "nc": 48}, {"id": 2080061, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ଳ", "screen_name": "diaper_aya", "avatar_url": "https://pbs.twimg.com/profile_images/1941872750228094976/u6s_Xpsd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1162919356294057986/1698278228/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 177}]}, "price_history": {"art": [{"amount": 9000, "recorded_at": "2025-10-05T22:36:41.406039"}, {"amount": 9000, "recorded_at": "2025-10-06T11:55:09.501945"}], "correction": [{"amount": 500, "recorded_at": "2025-10-05T22:36:41.406039"}, {"amount": 500, "recorded_at": "2025-10-06T11:55:09.501945"}]}, "works": [{"path": "/@aimabc_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3481934, "client_id": 3434671, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b89d6d7b/uploads/origins/e99450a8-6834-4751-a035-02395ae00391?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d16e53dbb807bbc09ca6467345f0de23", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b89d6d7b/uploads/origins/e99450a8-6834-4751-a035-02395ae00391?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6eb09c65aeefd58097be6c6d58a524a6", "src_set": ""}, "body": "ブルアカの調月リオ、一之瀬アスナ、角楯カリンが\n性欲旺盛なチビ幼児と化した先生のドスケベなエロママになっておちんちんのお世話をするイラストをお願いします。\n\nシチュエーションのイメージは以下です。\nL字型のコーナーソファーの真ん中に座ったリオ会長のムッチムチの太ももの上の特等席に\n爆乳の両乳房を俵のように肩に担いで大股開きで王様みたいに座るちっちゃい先生。\n顔や体はママ達のちゅるちゅるリップのキスマークまみれですでにかなり甘やかされた形跡が見られる。\nソファーの両辺にアスナとカリンが寝そべって2人がかりで先生のおちんちんのカリ首や裏スジをながぁ〜いベロでニュル…ニュル…💕と甘やかして射精寸前の一番気持ちいい状態をキープ。\n玉袋をロングネイルで優しくサワサワしてあげたり、アナルにローターを当ててあげて精子をグツグツと煮えたぎらせてあげながらお世話を続ける。\n「お゛ぉ゛〜う💕お゛ぉ゛っほっ💕」と小さな体を容赦なく襲う強烈な快楽に声を漏らしながらビキビキに勃起させたおちんちんの先っぽからカウパー腺液をトロぉ…💕と垂らす先生。\n複数の温かくてヌメヌメしたベロにおちんちんの敏感な部分を愛撫される感触をママのおまんこだと思い込んだ先生はリオ会長の乳肉にぎゅ〜っ💕と小さな指を食い込ませながらこの幸せな時間を1秒でも長く愉しもうと必死に射精をこらえる。\n「ママぁあああああああッ💕💕」と、いつも気持ちよく射精をさせてくれる母親(リオ)に助けを呼ぶように大声で叫びながらヨダレを垂らし、舌を突き出し、ちっちゃいあんよをピーン💕と伸ばして先っぽからピュッ💕とカウパー腺液を漏らす。\nそんな先生を内心(かわいい…💕)と思いながら先生の頭をよちよちなでなでしてあげるリオ会長。\n\nリオ会長のセリフイメージは以下です。\n「まったく…だらしない顔になってるわよ…カウパー腺液こんなに飛ばして…\nあったかくてヌメヌメのベロをママのおまんこだと勘違いしておちんちんがお漏らしの準備始めちゃったみたいね\n良いのよ…気持ちのいい種付けぴゅっぴゅができるようにママ達のベロベロで限界までおちんちんムズムズさせなさい… \nこのあと貴方の大好きなソープごっこ用のマットでママ達といっぱいイチャイチャして限界まで昂らせたら\nお布団の中で密着恋人ベロチューしながらおまんこの中に幸せなお漏らしさせてあげる…」", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aimabc_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3481934, "client_id": 1280452, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f054f42/uploads/origins/1a01d4da-049c-4bdd-a3e8-1de7d14aa054?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c133640bf01205b40df2d890e4fb781", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f054f42/uploads/origins/1a01d4da-049c-4bdd-a3e8-1de7d14aa054?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c7580b83e5fd383ff2364ba2cab2e54", "src_set": ""}, "body": "こんにちは\n依頼　お願いします\n\nキャラ：カトレア ( クイーンズブレイド)\n\n大体の內容↓\nセックス/中出し/断面図/高身長/体格差/甘々/エロガキ\n汗気は多めの匂い立つ感じで\n\n\n台詞をつけて欲しい （内容はお任せ\n\n差分欲しいてす((射精直前、射精の瞬間)\n\n參考：\nhttps://www.pixiv.net/artworks/121922378\n\nhttps://x.com/howlsfm/status/1821783508215291984?s=46&t=9XIWPzGQooGjKWWa9UlvRw\n\n\n身体\n太り、腹にはひだがある\nムチムチで爆乳\n化粧が濃く\n\n\n以上になります\n要望が多く申し訳ございませんが、ご検討よろしくお願いします", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aimabc_/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d9b98520/uploads/origins/9a031a0e-c11d-4eff-8308-0fc46caf3327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e97abbccce4dd0c9a40f6a9dbaf1c4d2", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3481934, "client_id": 864322, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@aimabc_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3481934, "client_id": 1209560, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9f4a2a3/uploads/origins/72ca7960-b576-4072-985e-2fdc818408a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=261167ab96173252c04c01d4d4f17cb5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9f4a2a3/uploads/origins/72ca7960-b576-4072-985e-2fdc818408a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3287ced047ef80876d9d362aeec7c4a", "src_set": ""}, "body": "こんにちは！フタナリ×フタナリの漫画ページが欲しいです。登場人物は、Kantai collectionのRO-500VSアズールレーンのCharybdisです。\nRO-500は背の低いロリです。おちんちんが大きいです。肌は黒く、胸は平ら（胸はない）。1-4と同じくスクール水着にセラフ。\nチャリブディスは長身で巨乳のアラフォー。ペニスは中くらい。資料5-7のようにチャイナ服を着ています。背景はプロレスのリング（資料8）。\n4コマ漫画のページが欲しい：\n1.1.チャリブディスは勃起したペニスをRO-500に見せ、巨大な胸をRO-500の顔に押し付ける。\n2.RO-500はチャリブディスに大きなペニスを見せる。チャリブディスはショックを受け、膝をつき、RO-500はペニスでチャリブディスの顔を叩く。\n3.RO-500はチャリブディスの喉を激しく犯し、資料11のように中に射精する。\n4.RO-500はチャリブディスを倒し、チャリブディスのケツの穴を犯し、チャリブディスのペニスを撫でる。2人ともイキまくり。\n\nhttps://drive.google.com/drive/folders/1-XIe8TwINfypPp-ZWUbWcitHdt652_4N", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}