ter&txtsize=60&txtshad=10&auto=format%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=027e79e8563d2dcb255255fc54af7beb", "skills": [{"genre": "novel", "default_amount": 3000}], "payment_methods": {"credit_cards": {"jcb": {"nsfw": true}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@udukiuzuki/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1233305, "client_id": 1274420, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63554c35/uploads/origins/216aec26-5e8d-44b1-bd37-27a3cad8efca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4beeeae65a9a0d462ccf4e9f891c2b3e", "srcset": "https://si.imgix.net/63554c35/uploads/origins/216aec26-5e8d-44b1-bd37-27a3cad8efca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4beeeae65a9a0d462ccf4e9f891c2b3e, https://si.imgix.net/63554c35/uploads/origins/216aec26-5e8d-44b1-bd37-27a3cad8efca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d54798e5f5bcf12f654073f08ce757b 2x, https://si.imgix.net/63554c35/uploads/origins/216aec26-5e8d-44b1-bd37-27a3cad8efca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5995d4b5aa512fb2fc2e6fd695db118b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63554c35/uploads/origins/216aec26-5e8d-44b1-bd37-27a3cad8efca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d11d7aa4f80e52fbd170cbe9d7b84d8", "srcset": "https://si.imgix.net/63554c35/uploads/origins/216aec26-5e8d-44b1-bd37-27a3cad8efca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d11d7aa4f80e52fbd170cbe9d7b84d8, https://si.imgix.net/63554c35/uploads/origins/216aec26-5e8d-44b1-bd37-27a3cad8efca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9b53d1bcb69f6d58990393c6006e6898 2x, https://si.imgix.net/63554c35/uploads/origins/216aec26-5e8d-44b1-bd37-27a3cad8efca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08f20578bffea4530a7f849183572ffe 3x"}, "body": "お世話になってます、今回は英雄クロニクルで友人とのRPの小説化をお願いします。\n話の大筋の流れと台詞は基本添付資料のログに沿っていただき、細かい描写はお任せしても良いでしょうか。\nログ雰囲気としてはハードボイルド小説のようなものになっています。\n私のキャラクターだけでなく、お相手様のキャラクターの心理描写も小説内に入れて戴けますと幸いです。\n\nログの内容ですが、私のキャラクター（シャンディ・ガフ）が率いるギャング団が根城にしている酒場へ\n1人の女軍人が現れ知人と酒を呑み比べしたいから何本か購入したいと、箱いっぱいの酒を抱えて現れます。\n突然の訪問者に警戒をしつつ、シャンディが目ざとく1本の粗悪な密造酒を発見し、その酒を手放すよう促します。\n彼が発見したのは、自分たちの縄張りで最近まで余所者が勝手に製造販売していた密造酒でした。\n当然、愚か者は始末済みですが、目の前の女軍人が何故そんな代物を持ってギャング団の根城まで来たのか\n女の狙いは？誰の差し金なのか、威圧するも飄々と受け流す彼女に苛立ちを覚え店内は緊迫した空気に\nという感じです。\n\n独自設定としましては、添付ログ中にある黒狼の旦那ですが、公式NPCの黒狼騎士団団長ヴォルフムントの事であり、彼らとシャンディ・ガフ率いるギャング団がある種の取引相手であることを匂わせております。\n\nまたお相手様の事を貴族である事から、帝国軍において貴族主義の黒獅子騎士団になぞらえて、黒獅子派と認識しています。\n\nお相手様のキャラについて\n口調は敬語、性格は自信があって清濁併せ呑んでるようだけど、何処かで自分は正義で相手は悪、自分は貴族で相手は平民みたいな傲慢さがある。\n性別は女性、外見、髪は腰までありヴァルトリエ帝国軍の制服を着用、公式NPCのナグルファルが来ているような軍服になりますが、スカートでは無くズボンになります。\n（キャラ外見及び服装参考資料を添付）\n\n友人からはログ及びキャラクターの使用承諾を得ております。\nまた成果物について、個人利用及び本RPにお付き合いいただいた友人への贈答を目的としております。\n\n以上よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/13zLHa5vpP9rDt5wFFnjmj0F_B1VZoADt?usp=sharing", "nc": 145, "word_count": 12109, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@udukiuzuki/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1233305, "client_id": 1255090, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf614442/uploads/origins/b0aff7da-733f-4c36-a3ea-90953130e722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b06951cae31354ce4a009850d7acf4f9", "srcset": "https://si.imgix.net/cf614442/uploads/origins/b0aff7da-733f-4c36-a3ea-90953130e722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b06951cae31354ce4a009850d7acf4f9, https://si.imgix.net/cf614442/uploads/origins/b0aff7da-733f-4c36-a3ea-90953130e722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb2e2ec759b564ec0418bf57d2990865 2x, https://si.imgix.net/cf614442/uploads/origins/b0aff7da-733f-4c36-a3ea-90953130e722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=508b273f3b940d85b78a6b7d25e93feb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf614442/uploads/origins/b0aff7da-733f-4c36-a3ea-90953130e722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40597c467440218e5596a017ce6256fc", "srcset": "https://si.imgix.net/cf614442/uploads/origins/b0aff7da-733f-4c36-a3ea-90953130e722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40597c467440218e5596a017ce6256fc, https://si.imgix.net/cf614442/uploads/origins/b0aff7da-733f-4c36-a3ea-90953130e722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3a5002425627eceffb162546f9db44d6 2x, https://si.imgix.net/cf614442/uploads/origins/b0aff7da-733f-4c36-a3ea-90953130e722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=334c2442e2c630b0cf0e2de9a21471c6 3x"}, "body": "こんにちは。\n以前うずきさんに書いていただいたフレーバーテキスト（資料URLにリンクを貼らせていただきました）がとても嬉しく、このアニマルテイマーさんのお話でSSをお願いすることは可能でしょうか？\n（例えば、魔女と呼ばれるまでのあらましであるとか、冷寒地でどう過ごしているのか、どんなお話でも嬉しいです）\n\nフワッとしたお願いで申し訳ないのですが、うずきさんに作っていただいた世界観やキャラクターをもっと見たい、という気持ちが一番にあるので、よろしければご一考いただけましたら幸いです。\n\nhttps://twitter.com/udukiuzuki/status/1583803471425200128?s=46&t=E311z8seGxFsWb00qHW3IA", "nc": 144, "word_count": 4346, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@udukiuzuki/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1233305, "client_id": 1274420, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0348df6/uploads/origins/08202e5e-a0ce-4db1-9c06-4bdd034417f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34a1efe51c8a3b41c3c4540625fd6aa7", "srcset": "https://si.imgix.net/a0348df6/uploads/origins/08202e5e-a0ce-4db1-9c06-4bdd034417f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34a1efe51c8a3b41c3c4540625fd6aa7, https://si.imgix.net/a0348df6/uploads/origins/08202e5e-a0ce-4db1-9c06-4bdd034417f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21623e350917ddaaacf427e8f11f3871 2x, https://si.imgix.net/a0348df6/uploads/origins/08202e5e-a0ce-4db1-9c06-4bdd034417f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ccff36186ae825800df9a4c74bec6ad7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0348df6/uploads/origins/08202e5e-a0ce-4db1-9c06-4bdd034417f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e90e1f653c9fb20dd3a6a3f098e906b", "srcset": "https://si.imgix.net/a0348df6/uploads/origins/08202e5e-a0ce-4db1-9c06-4bdd034417f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e90e1f653c9fb20dd3a6a3f098e906b, https://si.imgix.net/a0348df6/uploads/origins/08202e5e-a0ce-4db1-9c06-4bdd034417f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=10505d113cf88b21fa800f8b77c777ee 2x, https://si.imgix.net/a0348df6/uploads/origins/08202e5e-a0ce-4db1-9c06-4bdd034417f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ca9408ccbeac12f8a7d9c96f18e53829 3x"}, "body": "いつもお世話になっております。\n英雄クロニクルs鯖（休止中）ムーンシャインギャング団の首魁シャンディ・ガフのssをお願いします。\n今回は久しぶりに真っ黒なお話になります。\n\nテーマは【拭えぬ過去】\nシャンディから金を盗んでオーラムへ高飛びした元部下の男\n高飛びに成功して数年後、盗んだ金を元手に、オーラムで小規模だが自分のギャング団を持つようになり、一部の地区の顔役になっていた。\n\n縄張りの中心にある、行きつけの理髪店で髪と髭を整えに行く。\nボスになって先行きは順調、地元で歯向かう勢力は全員返り討ちにして来た。\nここら一帯の住人は、自分が通れば挨拶しながら道を譲るほど。\n\n理髪店に到着、当然男がいる間は貸切状態に店がしている。\n（男が強要しているわけではない、あくまで自発的にという体で）\n何時もであれば老齢の店主が、引きつった顔で出迎えるが、その日は年若い男（シャンディ本人）がにこやかに待っていた。\n\n元部下「おい若造、いつもの爺さんはどうした？それでお前は誰だ」\nシャンディ「○○さんですね、いつもありがとうございます。私は店主の息子です、父ですがこの間腰を痛めてしまいまして」\n　　　　　「1週間前程から私が、父の代理で皆様の髪を整わせていただいてます」\n元部下「……まぁ良いか、おい若造、ジジイの倅なら当然俺の話は聞いてるだろうな」\nシャンディ「ええ勿論、御髭のお手入れと長くなってきた髪の散髪ですね」\n元部下「そうだ、もし俺の肌に傷でも入れてみろ……後は分かるな？」\nシャンディ「……えぇ存じ上げてますとも、では此方の席へどうぞ」\n\n威圧する元部下に対し、テキパキと準備を整え仕事をこなしていくシャンディ\nウィットに富んだ小話で飽きさせず、元部下の警戒も緩み気に入られる。\n\n元部下「ガハハハお前の話は面白いな若造、ジジイは腕は良いが会話は下手くそだからな」\n　　　「その点お前は、腕も良いし会話も飽きないな。自分の店は持っていないのか？」\nシャンディ「一時は父の様に、自分の店を……と思っていたのですが、此処近年の他国との小競り合いに巻き込まれまして」\n元部下「そうか、そりゃ気の毒だな……俺はお前が気に入った、自分で言うのも何だが俺はこの地区の市長と『親友』でな」\n　　　「俺が口利きして、ここらで一番立地の良い場所に、お前の店を立ててやろう」\n　　　「店に俺のサインも付けてやる。○○御用達理髪店ってな、すぐにでも満員になるだろうよ」\nシャンディ「それはありがたい申し出で、でも良いんですか？」\n元部下「ガハハハッ【何も支払わなかった、なんて言わせない】ってが俺の信条でな、そうだ若造、名前は何て言うんだ？」\n\n\nシャンディ「それは素晴らしい信条ですね、えぇ私の名前ですか……」\n　　　　　「【ムーンシャイン】と言えば、分かるか○○、随分と羽振りがいいようだな？」←ゾッとするような声で\n\n元部下「（一瞬呆けるが）っ●●（護衛の名前）！！」\n\nすぐさま懐からピストルを出そうとする護衛に、シャンディが素早くナイフを投擲し無力化する（護衛の生死は問わず）\n\nシャンディ「おっと動くなよ、今動くと唇が無くなるぜ」（元部下の鼻の下に剃刀が添えられる）\n元部下「な、なんでお前がっどうして？！」\nシャンディ「おいおい俺から盗った金で、成り上ったにしちゃぁ冷たいじゃねぇかHA HA HA」\n　　　　　「俺はお前の事を買ってたんだぜ（ここ過去形なのを強調）、独り立ちした奴を祝いに来てやったのに随分な態度じゃねぇか」\n\n元部下「……」\nシャンディ「んだよ、だんまりか……ならいいちょっとした昔話をしてやろう」\n　　　　　「俺はガキの頃に近所の理髪店で下働きしててな、まぁその頃から同じ悪童同士で悪さはしちゃいたが」\n　　　　「親方は厳しい人でな、しょっちゅう怒られたもんさ『この剃刀を手入れしたのは誰だ！』ってね」\n　　　　「理髪屋にとっちゃ剃刀ってのは、命と同じくらい大事な商売道具だ、そりゃ指導にも熱が入るってもんだ」\n　　　　　「御蔭で理髪屋としての俺の腕は、どんどん上達した。この剃刀だってそん時からの品なんだぜ？」\n　　　　　「もう随分とガタが来てるから、『滅多』な事じゃ使わない事にしてるんだよ」\n　　　　　「あぁ話が反れたな、んでそこら一帯の街じゃ俺に敵う理髪屋が居なくなったころ、当時そのシマを仕切ってた親分を担当する事になった」\n　　　　　「まるで今日のお前と俺の関係のようにな、親分の肌に初めて刃を当てた時は、チビリそうだったぜ」\n　　　　　「力加減を間違えてみろ、あっという間に墓場行きだ……まぁ幸い親分さんは、懐の広い漢だったが」\n　　　　　「んで無事、親分に気に入られて店を止めて親分の所で、親分と手下相手に住み込みで働くようになったよ」\n　　　　　「親分からは、ギャングとしての色んな事を教わったよ、稼業の方も手伝い始めたのはその頃からだ」\n\n（この間、淡々と元部下の髪や髭を整えていくシャンディ）\n\n　　　　　「おいくすぐったいのは分かるが、あんまし動くなよ？耳を切っちまう」\n　　　　　「ある程度、ギャングとしての腕も付いて来た頃、俺は大きな仕事を任された」\n　　　　　「親分に楯突いた町役場の役人の暗殺だよ、方法は簡単だった……役人の通う理髪店で俺が働くようにして何度も担当してやった」\n　　　　　「もともと町一番の俺の技量だ、直ぐに心を許したよ……お前みたいに」\n（スッと剃刀を元部下の喉元へ当てて、3分ほど重い沈黙が続く）\n\n　　　　　「※※※※!（間抜けと罵る）」←突然大声で叫ぶシャンディ\n\nビクついて、座ったまま飛び上がる元部下\n\nシャンディ「そう罵ってやってから喉笛を切り裂いてやったよ……ん？おいおい漏らしたのか？」\n　　　　　「（溜息）店主には悪い事をしちまったな、追加で清掃代を払わんとな」\n　　　　　「【何も支払わなかった、なんて言わせない】か、元は俺の言葉だったな」\n　　　　　「どんな気分だ？俺から逃げおおせて、自分のシマを持って、順風満帆なギャング街道を歩いていたのは？」\n\n元部下「ゆゆゆ、許してくださいシャンディさん、お金も返します、俺のシマもシノギも全部渡します」\n　　　「お望みであれば、シャンディさん──いやボス、貴方の靴だって舐めますからどうか……」\n\nシャンディ「そうか、そうか○○また俺に忠誠を誓ってくれるのか」\n\n元部下「はい、誓います。私は貴方の忠実な下僕であることを神に誓いますから、どうか命だけは」\n\n★部は、直接の表現がマズイなら匂わすか濁してください。\n\nシャンディ「……違うな」（★冷たく言い放つと腕を横へ振るう）\n\n元部下「はい？」（★これが元部下の最後の言葉）\n\n★（喉から血を噴きもだえる元部下を、背後に店をでながら一言）\n\nシャンディ「神に誓うんじゃなくて……俺に誓うんだったな〇〇、Addio（永遠にさようなら）」\n\nEND", "nc": 8, "word_count": 8319, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@udukiuzuki/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1233305, "client_id": 1274420, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/499ef768/uploads/origins/a09e54df-df81-4841-aaa1-ea82fbffbaf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f38fd9d1cbd0e387708f769e2a4c70f8", "srcset": "https://si.imgix.net/499ef768/uploads/origins/a09e54df-df81-4841-aaa1-ea82fbffbaf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f38fd9d1cbd0e387708f769e2a4c70f8, https://si.imgix.net/499ef768/uploads/origins/a09e54df-df81-4841-aaa1-ea82fbffbaf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28f79fdaa397f7ab9bfd9026eb087563 2x, https://si.imgix.net/499ef768/uploads/origins/a09e54df-df81-4841-aaa1-ea82fbffbaf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=defd74157dd9ceffe26b481f70c95686 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/499ef768/uploads/origins/a09e54df-df81-4841-aaa1-ea82fbffbaf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa2a2d4cc021ef2db7992de021326461", "srcset": "https://si.imgix.net/499ef768/uploads/origins/a09e54df-df81-4841-aaa1-ea82fbffbaf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa2a2d4cc021ef2db7992de021326461, https://si.imgix.net/499ef768/uploads/origins/a09e54df-df81-4841-aaa1-ea82fbffbaf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=44a2e6a7a10978018b03f04ff55496b7 2x, https://si.imgix.net/499ef768/uploads/origins/a09e54df-df81-4841-aaa1-ea82fbffbaf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f7ae3e01e4061cac288acc10c50fbd9 3x"}, "body": "英雄クロニクル S鯖(休止中) ヴァルトリエ帝国でのシャンディ・ガフ率いるギャング団のSSをリクエスト致します。\nうずき先生、前回は素晴らしい作品をありがとうございました。\n\n今回はボスであるシャンディを支える組織のNo.2、スティンガーをメインにしたSSを戴ければなとリクエストさせていただきました。\n\nギャング団幹部の紅一点、父親は警察幹部、母親は財界大御所の令嬢そして本人も元警察官\n明らかに此方側（無頼の住人）ではない彼女が何故、ボスの右腕になれたのか、持ち前の残忍さと実力か？\nそれともボスの弱みを握ってるのか？はたまたボスの女だからなのか？そういやボスと彼女はデキてる（男女の仲）のか？　という問答をアジトの酒場で、下っ端ギャング達がポーカーの最中にしだす感じです。\n\n下っ端のイメージとしては3人組で、ボスとスティンガーがアジトを野暮用で留守にしているときの暇つぶしのポーカー（勿論賭け試合）、最初は負けが込んでいる奴がこちらの動揺を誘う為の番外戦術かと思っていたら、段々気になる噂を話始めてポーカーを忘れて問答に熱中しはじめる。\n\nオチとしては、問答が一番盛り上がって来た時にいつの間にかスティンガーが会話に混ざっていて\n下っ端たち「……あ、姐さん。い、いつからそこに？」\nスティンガー「さぁ何時からだろうねぇ？クスクス……でもアタシがボスの女だから\"右腕\"を名乗ってる訳じゃないってことを教えてやるよ……拳でねぇ、覚悟しな」\n\nボコボコにされる下っ端3人組、それを離れた場所から見るシャンディと別の部下\n部下「で？ボスと姐さんってソウ（恋仲）言う仲なんで？」\nシャンディ「さぁどうだろうな？でもアイツのああいう所（どう猛さと残忍性）は気に入ってるぜ」\n\n~end~\n\nのような感じで、お願いしたいと思っております。\n以下にスティンガーについての組織としての評判の資料を記載します。(添付画像2枚目上部)\n今年ももう残り僅か、何かとお忙しいかと思われますので気向きましたらお願いします。\n\nhttps://twitter.com/moonshine_auc/status/1355524719508746241?s=20", "nc": 1, "word_count": 3692, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@udukiuzuki/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1233305, "client_id": 102854, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48d5e38e/uploads/origins/e1d34ff0-ad25-43f8-aab0-0409a15f00fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4eaf777111210f22b851ad4d2364a2a", "srcset": "https://si.imgix.net/48d5e38e/uploads/origins/e1d34ff0-ad25-43f8-aab0-0409a15f00fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4eaf777111210f22b851ad4d2364a2a, https://si.imgix.net/48d5e38e/uploads/origins/e1d34ff0-ad25-43f8-aab0-0409a15f00fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55a1ffad4759afb5f89ff2ce54379ab2 2x, https://si.imgix.net/48d5e38e/uploads/origins/e1d34ff0-ad25-43f8-aab0-0409a15f00fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a33cf9f42d24c27069266951497cc456 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48d5e38e/uploads/origins/e1d34ff0-ad25-43f8-aab0-0409a15f00fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b214d58b2799116310254358d428314e", "srcset": "https://si.imgix.net/48d5e38e/uploads/origins/e1d34ff0-ad25-43f8-aab0-0409a15f00fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b214d58b2799116310254358d428314e, https://si.imgix.net/48d5e38e/uploads/origins/e1d34ff0-ad25-43f8-aab0-0409a15f00fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2f479269de216a4f4cf93f3ddfdf3dfd 2x, https://si.imgix.net/48d5e38e/uploads/origins/e1d34ff0-ad25-43f8-aab0-0409a15f00fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4c29e4315625e369f9f7a8f9536d0e6d 3x"}, "body": "英雄クロニクルの緋色尾の烏(ID:103e)さんのキャラクター、アマーテさんとアズノくんの二人の会話を見てみたいです。詳細な内容やシチュエーションなどは特に問いませんが、あまり深刻な事態にならない平和なお話を希望します。\nもし余地がありましたら、当部隊ホワイトデザート(ID:2r5p)の私のキャラクターの誰かを端役で登場させるか、または会話の話題にちょっぴり挙げていただけると嬉しいです。\n差し支えなければ、よろしくお願いします。", "nc": 16, "word_count": 3209, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@udukiuzuki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1233305, "client_id": 1274420, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/520253ac/uploads/origins/fa8b67a1-8d0d-44b3-aff0-2528d245069c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b81ab5ca2fb4df820741b17955d19cd", "srcset": "https://si.imgix.net/520253ac/uploads/origins/fa8b67a1-8d0d-44b3-aff0-2528d245069c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b81ab5ca2fb4df820741b17955d19cd, https://si.imgix.net/520253ac/uploads/origins/fa8b67a1-8d0d-44b3-aff0-2528d245069c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aae330f277d763bf3176692d68b1e40f 2x, https://si.imgix.net/520253ac/uploads/origins/fa8b67a1-8d0d-44b3-aff0-2528d245069c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55936a8883a8539d111844ad9aa6defd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/520253ac/uploads/origins/fa8b67a1-8d0d-44b3-aff0-2528d245069c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=269960045068564819dcb0fffe99d051", "srcset": "https://si.imgix.net/520253ac/uploads/origins/fa8b67a1-8d0d-44b3-aff0-2528d245069c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=269960045068564819dcb0fffe99d051, https://si.imgix.net/520253ac/uploads/origins/fa8b67a1-8d0d-44b3-aff0-2528d245069c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=798d71fc697d913a2e1134259b409cf4 2x, https://si.imgix.net/520253ac/uploads/origins/fa8b67a1-8d0d-44b3-aff0-2528d245069c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=334e83e650200275a95e78d4eaed69e3 3x"}, "body": "英雄クロニクル S鯖 ヴァルトリエ帝国でのシャンディ・ガフ率いるギャング団のSSをリクエスト致します。\n\nテーマ：制裁\n・シャンディ一家傘下の裏カジノ（小規模）を、マッカから来たばかりの年若く血気盛んな傭兵3人（兄弟と兄の許嫁）がシャンディ一家の事を知らずに襲撃、売上を収奪するも捕まり一家が所有する倉庫で沙汰が下されるのを待っている。\n\n・3人に表面上は上機嫌で紳士然と喋るシャンディ\n「俺に歯向かう骨のある奴がまだいるとは、生きて此処を出たいなら話をしようか」的雰囲気で\n・怯え混じりだが無鉄砲さと反骨心で話に応じる三人\n・順調に話が進んで希望が見えたと思いきや、唐突に激怒し3人のうち1人を手下に命じて「別室」に送る。\n　その後シャンディが講釈を再開するや隣の部屋から壁越しに絶叫、静まり返る部屋笑いながら話を続けるシャンディ、相槌が無いのが気に入らずもう一人も「別室」に送る。\n\n・語り終えたシャンディが、最後の一人を立ち上がらせ金貨を一枚握らせると倉庫の外まで見送る。\n　親し気に最後の一人の顔を両手で触れると一言「さぁ帰っていいぞ」\n\n・脱兎のごとく1人が暗闇に消えた後、倉庫からエプロン姿(血濡れ※濁した表現で)のスティンガーが、不満げに「逃がして良かったのか？」と問詰めるも、「誰か生き残りが居ないと話が広まらないだろ？」と笑うシャンディ。\n\n以上になります、長々と書きましたが特に絶対にこうして欲しいという訳ではありません。\nただSSのコンセプトと致しましては、「笑っているけど笑っていない、命を握られている緊張感、何を考えているか分からない危険性」が漂ってくるような感じでよろしくお願いします。", "nc": 144, "word_count": 9705, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@udukiuzuki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1233305, "client_id": 608403, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1457289367006121985%2FFGSn9X4E.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cf950a78069c51d0d5565694eeff1c3", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1457289367006121985%2FFGSn9X4E.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cf950a78069c51d0d5565694eeff1c3, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1457289367006121985%2FFGSn9X4E.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfn