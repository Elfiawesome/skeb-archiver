ns/8e18a8f8-9b84-481f-a96b-23547c758917?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06886f08e7de87073a1878f20a04f975", "srcset": "https://si.imgix.net/bc3c991f/uploads/origins/8e18a8f8-9b84-481f-a96b-23547c758917?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06886f08e7de87073a1878f20a04f975, https://si.imgix.net/bc3c991f/uploads/origins/8e18a8f8-9b84-481f-a96b-23547c758917?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63e46857963bafa4c7fafd565b852a32 2x, https://si.imgix.net/bc3c991f/uploads/origins/8e18a8f8-9b84-481f-a96b-23547c758917?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e7634d5a9823c1751a1631c030e0bd68 3x"}, "body": "こんにちは！私はレインボーと申します！私のキャラクター、レインボーと私の彼女のキャラクター、チサイを一緒に描いてください。ポーズもレインボーが前、千彩が後ろでお願いします。背景や表情はお任せします。\n\n以下、私のキャラクターレフシートと千彩のキャラクターレフシートを添付します！\n\n読んでくれてありがとう。\n\nhttps://imgur.com/a/sCheEH5", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@100_wnkr/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2986207, "client_id": 2684015, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78136fc8/uploads/origins/19870198-f54c-47cb-8c37-f18838dfc32c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b6f1b1a14828e5b7a3f5d58326c9878", "srcset": "https://si.imgix.net/78136fc8/uploads/origins/19870198-f54c-47cb-8c37-f18838dfc32c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b6f1b1a14828e5b7a3f5d58326c9878, https://si.imgix.net/78136fc8/uploads/origins/19870198-f54c-47cb-8c37-f18838dfc32c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8992797e035e5f81d89a9e7eb3a9a01 2x, https://si.imgix.net/78136fc8/uploads/origins/19870198-f54c-47cb-8c37-f18838dfc32c?bg=%23fff&auto=format%2Ccompress&fm