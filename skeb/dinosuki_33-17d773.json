玉を割られるポエット。そのまま川に落ちる。\n4.びしょ濡れになったポエットが\nhttps://popnmusic.fandom.com/wiki/Poet/Gallery?file=Poet_SP_1P_Lose.gif のように\n魚たちに浮き輪で助けられる。\n\n背景・ハチなどは次のプレイ動画を参照。\nhttps://youtube.com/watch?v=-thuzrJs9bg", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 843722, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ちこ", "screen_name": "star_pocco", "avatar_url": "https://pbs.twimg.com/profile_images/2033514294428700672/oCUpLcQj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1019384599879696384/1773666176/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 1358471, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ポエット", "screen_name": "0622_poet", "avatar_url": "https://pbs.twimg.com/profile_images/1715559664086331392/8qPDfZ_H.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2905146056/1763970367/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 1803893, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "浅利治武@お絵描きSkeb絵師", "screen_name": "OekakiAsari", "avatar_url": "https://pbs.twimg.com/profile_images/1736122552039469056/gpLKYnop.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1442484420561178625/1678406991/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_d