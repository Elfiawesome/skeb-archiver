aa9044a7d6b8f6b6fb9&sid=&from=index&col_name= ） \n\nポーズや構図としては、大きく柔らかそうで衣装からこぼれ落ちそうな横乳と引き締まった美脚が強調され、こちらを見てキリッとした表情を浮かべているようなイラストをお願い致します。\n差分として頬を少し赤く染めてこちらにジト目を向けているものも希望です。\nハイヒールのデザインが好みなのでなるべく全身が見える構図だと嬉しいですが詳しくは先生にお任致します。\nあとはPSD納品希望です。\nご多忙の中申し訳ございませんが、何卒ご検討の程宜しくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@114_usamaro/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/41eb195e/uploads/origins/d35584ec-0b66-4198-a3e5-c3ed3a7473bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f2dcfb4eab08e396def29d4b9c1f78c", "srcset": "https://si.imgix.net/41eb195e/uploads/origins/d35584ec-0b66-4198-a3e5-c3ed3a7473bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f2dcfb4eab08e396def29d4b9c1f78c, https://si.imgix.net/41eb195e/uploads/origins/d35584ec-0b66-4198-a3e5-c3ed3a7473bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=927dfa592445e13297aa7c3ecea90d15 2x, https://si.imgix.net/41eb195e/uploads/origins/d35584ec-0b66-4198-a3e5-c3ed3a7473bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fb44d2c45f04dc86cc6110c6d644784 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1814312, "client_id": 58864, "nc": 0}, {"path": "/@114_usamaro/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0dca1e50/uploads/origins/7bc60045-36d7-46f6-b0b9-94c2dfe03ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middl