\nポーズや背景はおまかせでお願いします！！\n可愛い感じでお願いいたします\n\n◆使用用途\n・YouTubeチャンネルのプロフィール画面・サムネイル\n・SNS（Twitter）のプロフィールのヘッダー・アイコン\n・ネットプリント\nへの使用を想定しております。\n\n◆資料\nこちらにイラスト置いておきます！\nこちらを参考にお願いいたします！\n\nお忙しいところ申し訳ございませんが、検討の程よろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/1zQM8vrEbkEHnOqwGJwHUcxK9qrhhUR1U", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@YodukiR/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 120565, "client_id": 1703402, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4e7926e/uploads/origins/3f9abc8d-1cb9-41b7-ad5d-e5b9154c8c5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06d96caa523b6af35ba08019b919fb93", "srcset": "https://si.imgix.net/d4e7926e/uploads/origins/3f9abc8d-1cb9-41b7-ad5d-e5b9154c8c5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06d96caa523b6af35ba08019b919fb93, https://si.imgix.net/d4e7926e/uploads/origins/3f9abc8d-1cb9-41b7-ad5d-e5b9154c8c5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8ede86e7ca4ecd33f5df32cba79666c 2x, https://si.imgix.net/d4e7926e/uploads/origins/3f9abc8d-1cb9-41b7-ad5d-e5b9154c8c5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67c9236c0cd2b6aee4c293cbee2d6378 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4e7926e/uploads/origins/3f9abc8d-1cb9-41b7-ad5d-e5b9154c8c5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45c3944b447ffba1391071ee8e97911b", "srcset": "https://si.imgix.net/d4e7926e/uploads/origins/3f9abc8d-1cb9-41b7-ad5d-e5b9154c8c5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45c3944b447ffba1391071ee8e97911b, https://si.imgix.net/d4e7926e/uploads/origins/3f9abc8d-1cb9-41b7-ad5d-e5b9154c8c5a?bg=%23fff&auto=format