98/uploads/origins/8726e995-175d-4eba-9348-a45abc8dfed6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=be6dd469477d6f8c07ef26c9e3717afe 2x, https://si.imgix.net/1a2ec898/uploads/origins/8726e995-175d-4eba-9348-a45abc8dfed6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2291a07fe1d24f4d67b2dea7c07b26e4 3x"}, "body": "はじめまして、田中ロクロと申します。\nリクエスト再開ありがとうございます！\nfujisakiさんの作品が大好きで、ご本も購入して楽しく拝見しております。\n\nとくにモノクロイラストが大好きで、今回モノクロも受け付けてくださるとのことでリクエストを送らせていただきました。\n\n添付資料のキャラをご依頼したいです\n配信などに使用したいと考えております。\nビジュアルについては添付資料の通りになりますが、衣装などお好きな形にアレンジしていただいても大丈夫です！\n\nお忙しい中恐縮ですが、ご縁がありましたらどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/13cjEIU-wkRo6sQ_D_qs2FrC3vx8hFzed/view?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@argt/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1534322, "client_id": 1835775, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/486b5769/uploads/origins/f29aeb63-9a25-4350-ba2d-4cfc0d934c99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8f8e16eb1ab8e09978b287598af9e46", "srcset": "https://si.imgix.net/486b5769/uploads/origins/f29aeb63-9a25-4350-ba2d-4cfc0d934c99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8f8e16eb1ab8e09978b287598af9e46, https://si.imgix.net/486b5769/uploads/origins/f29aeb63-9a25-4350-ba2d-4cfc0d934c99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b9277b7188717436f41a6d309835c7b 2x, https://si.imgix.net/486b5769/uploads/origins/f29aeb63-9a25-4350-ba2d-4cfc0d934c99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40e05812aaf0ceb9191f7c93764eea94 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/486b5769/uploads/origins/f