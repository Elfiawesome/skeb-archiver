0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4b13f5ef26d6928e7c9a6cf03007890", "srcset": "https://si.imgix.net/2b4796c3/uploads/origins/42f6e29c-e628-4100-bdc0-58e88290e40e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4b13f5ef26d6928e7c9a6cf03007890, https://si.imgix.net/2b4796c3/uploads/origins/42f6e29c-e628-4100-bdc0-58e88290e40e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=209bd48858740182c374eda0ec9c5810 2x, https://si.imgix.net/2b4796c3/uploads/origins/42f6e29c-e628-4100-bdc0-58e88290e40e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d869ce9d91e800c75a76a27c0bab6a14 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b4796c3/uploads/origins/42f6e29c-e628-4100-bdc0-58e88290e40e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95803e74b72e31f415ab75c1c81384bb", "srcset": "https://si.imgix.net/2b4796c3/uploads/origins/42f6e29c-e628-4100-bdc0-58e88290e40e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95803e74b72e31f415ab75c1c81384bb, https://si.imgix.net/2b4796c3/uploads/origins/42f6e29c-e628-4100-bdc0-58e88290e40e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a37f5b765f1c736b420b10ecabb37242 2x, https://si.imgix.net/2b4796c3/uploads/origins/42f6e29c-e628-4100-bdc0-58e88290e40e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3d7b175a79005395ffddd163803119e 3x"}, "body": "はじめまして、田中ロクロと申します。\n以前よりもちさまのイラストを楽しく拝見しており、リクエスト再開を知りご依頼をさせていただきました。\nもちさまの描かれるパキッとしたイラストが本当に大好きです。\n\nリクエスト内容といたしましては、サムネイルや待機画面、ヘッダー、アイコンなど活動に使用するための、自分のイラストを制作していただきたく思います。(横長だととても嬉しいです)\nまた、個人で制作するグッズ用にイラストを使用したいのですが可能でしょうか？別途商用利用料がかかる場合は改めて金額をご提示いただければと思います。\n商用利用が全面的に不可であればリクエストを蹴っていただいて大丈夫です(改めて個人利用のみのリクエストで送信いたします) \n\nビジュアルについては添付資料の通りになります。そのほかお好きに描いていただければと思います。\n参考としてモチーフになりそうな要素を記入しております。また、衣装については簡略化していただいても大丈夫です。\n\n長々と要望を書いてしまい申し訳ありません！\nよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/13cjEIU-wkRo6sQ_D_qs2FrC3vx8hFzed/view?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@RAIKAN_RIKANTO/works/244", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 106153, "client_id": 1835775, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c146f33e/uploads/origins/619d503d-fc9e-4b1e-810f-76e2d00d6934?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=e1baf30c28bcfa2047c374cd903b52d5", "srcset": "https://si.imgix.net/c146f33e/uploads/origins/619d503d-fc9e-4b1e-810f-76e2d00d6934?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=e1baf30c28bcfa2047c374cd903b52d5, https://si.imgix.net/c146f33e/uploads/origins/619d503d-fc9e-4b1e-810f-76e2d00d6934?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=05769b2b64879c8fd7b762504386b121 2x, https://si.imgix.net/c146f33e/uploads/origins/619d503d-fc9e-4b1e-810f-76e2d00d6934?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea8cf5147412b2cdd55767b57a53bf81 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c146f33e/uploads/origins/619d503d-fc9e-4b1e-810f-76e2d00d6934?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=ba44b85a88994380448026681cf377f3", "srcset": "https://si.imgix.net/c146f33e/uploads/origins/619d503d-fc9e-4b1e-810f-76e2d00d6934?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=ba44b85a88994380448026681cf377f3, https://si.imgix.net/c146f33e/uploads/origins/619d503d-fc9e-4b1e-810f-76e2d00d6934?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b6212b79c68c4a620c7a96e2d1319b95 2x, https://si.imgix.net/c146f33e/uploads/orig