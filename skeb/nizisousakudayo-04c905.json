近い姿に擬態して人間をサングラス越しに観察しており、今は人間が生み出す娯楽や食べ物にハマっているからなにもしていないが、あくまで人間は非常食として見ているのでもしもの場合は食べる予定。\n\n⇓三面図がなく正面だけです。ごめんなさい\nhttps://drive.google.com/drive/folders/1Y4O3ERc_-9hbyQ1NoqXD3Z0YputaGbB7?usp=sharing\n\nお忙しいところ申し訳ございませんがご検討をよろしくお願いいたします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nizisousakudayo/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2523017, "client_id": 1421083, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5a292df/uploads/origins/26844caa-dba9-4da1-b6c0-5c5c9b78c6f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bebea3fa4b553432ba973825b4ead154", "srcset": "https://si.imgix.net/a5a292df/uploads/origins/26844caa-dba9-4da1-b6c0-5c5c9b78c6f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bebea3fa4b553432ba973825b4ead154, https://si.imgix.net/a5a292df/uploads/origins/26844caa-dba9-4da1-b6c0-5c5c9b78c6f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e26ab42c98b563281c1a09cd2973c44b 2x, https://si.imgix.net/a5a292df/uploads/origins/26844caa-dba9-4da1-b6c0-5c5c9b78c6f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=108b982d578103c4253c1aecfae7f391 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5a292df/uploads/origins/26844caa-dba9-4da1-b6c0-5c5c9b78c6f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5369d29fa7a6c9b80f13658ef5da597b", "srcset": "https://si.imgix.net/a5a292df/uploads/origins/26844caa-dba9-4da1-b6c0-5c5c9b78c6f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5369d29fa7a6c9b80f13658ef5da597b, https://si.imgix.net/a5a292df/uploads/origins/26844caa-dba9-4da1-b6c0-5c5c9b78c6f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top