い。もしよろしければ、この絵をT/witchやT/twitter、Y/YouTubeなどのSNSで使いたいと思います。また、背景が透けているバージョンもお願いします。\n\nスケブの金額で足りるようでしたら、別の金額で再依頼することも可能です。\n\nお忙しい中、ご検討いただき、誠にありがとうございました。\n\nhttps://drive.google.com/file/d/1Zf_JX9f8__q_Aok7shHL06uti5hyE8rD/view?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nizisousakudayo/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2523017, "client_id": 607745, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34b2bd54/uploads/origins/e629d9a8-2272-4050-9704-a3cb00a8f41b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e4243522ee20b3742551963826fef27", "srcset": "https://si.imgix.net/34b2bd54/uploads/origins/e629d9a8-2272-4050-9704-a3cb00a8f41b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e4243522ee20b3742551963826fef27, https://si.imgix.net/34b2bd54/uploads/origins/e629d9a8-2272-4050-9704-a3cb00a8f41b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ec02594ea6dec2c80c139d9e001687a 2x, https://si.imgix.net/34b2bd54/uploads/origins/e629d9a8-2272-4050-9704-a3cb00a8f41b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a611c348f6b9d849e706bd6f6025e6e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34b2bd54/uploads/origins/e629d9a8-2272-4050-9704-a3cb00a8f41b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17e284a88a64a97ea8b2620fe68ca83e", "srcset": "https://si.imgix.net/34b2bd54/uploads/origins/e629d9a8-2272-4050-9704-a3cb00a8f41b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17e284a88a64a97ea8b2620fe68ca83e, https://si.imgix.net/34b2bd54/uploads/origins/e629d9a8-2272-4050-9704-a3cb00a8f41b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=2