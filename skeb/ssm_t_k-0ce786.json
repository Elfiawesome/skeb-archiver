59/uploads/origins/f6dd4bec-c01c-4917-9e06-559d7c9ba6eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=094655fdbdaa4349386729348dba488f", "srcset": "https://si.imgix.net/83e89959/uploads/origins/f6dd4bec-c01c-4917-9e06-559d7c9ba6eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=094655fdbdaa4349386729348dba488f, https://si.imgix.net/83e89959/uploads/origins/f6dd4bec-c01c-4917-9e06-559d7c9ba6eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7b2c851697d927280d2134bc4ad8183 2x, https://si.imgix.net/83e89959/uploads/origins/f6dd4bec-c01c-4917-9e06-559d7c9ba6eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b4c6908021cae67efcf89ced76993ef 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83e89959/uploads/origins/f6dd4bec-c01c-4917-9e06-559d7c9ba6eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d38827d473c81304da3aeaf065a2ec77", "srcset": "https://si.imgix.net/83e89959/uploads/origins/f6dd4bec-c01c-4917-9e06-559d7c9ba6eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d38827d473c81304da3aeaf065a2ec77, https://si.imgix.net/83e89959/uploads/origins/f6dd4bec-c01c-4917-9e06-559d7c9ba6eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f26c431fe23259bd115aacb2bd4c2f2 2x, https://si.imgix.net/83e89959/uploads/origins/f6dd4bec-c01c-4917-9e06-559d7c9ba6eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6ccb76e469ebd05c43f134182037853 3x"}, "body": "お世話になっております、はなあさぎです！\n今回はTRPGのキャラクター二人の絵をお願いしたいと思いリクエストを送らせていただきました。\n\nJACK・ラビットは月夜に微笑むというシナリオのPCです。資料内に簡単なプロフィール等を記載しており、事前概要以上の情報は省くように調整したのですが無理に読んで頂かなくても大丈夫です！（関係やログの部分も本編開始前の相談で出たものです）\n▼以下資料になります。\nhttps://twitter.com/asagi_cthu/status/1607188458786934784?s=20&t=lu4ACK5CoZGcL5G4K3OmmA\n(服、髪型は資料のものでもそうでなくても大丈夫です！できれば男性の方は長髪だと嬉しいです)\n雰囲気・構図等はお任せでお願いできればと思います。二人が同じ画面の中にいればどんなものでも大丈夫です…！\n\n以前から鋏さんのアンティークな雰囲気のイラストがとても素敵だなと思っており、ぜひ鋏さんの絵柄でこの二人が見てみたいと思ってリクエスト出させていただきました。全然縁もゆかりもない人たちですみません！！\n今回のご縁の有無にかかわらず、今後の創作活動を応援しています！\nここまで読んでくださりありがとうございました！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ssm_t_k/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 576305, "client_id": 1662518, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c1b5544/uploads/origins/b4f06a42-fc6e-4d81-9955-b0696e1939f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1050628ce5b0bcff981a258bb229e413", "srcset": "https://si.imgix.net/2c1b5544/uploads/origins/b4f06a42-fc6e-4d81-9955-b0696e1939f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1050628ce5b0bcff981a258bb229e413, https://si.imgix.net/2c1b5544/uploads/origins/b4f06a42-fc6e-4d81-9955-b0696e1939f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f2e3e84455d5ea81f943bc2b6077abd 2x, https://si.imgix.net/2c1b5544/uploads/origins/b4f06a42-fc6e-4d81-9955-b0696e1939f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0e71ac74283936bccae724004366992 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c1b5544/uploads/origins/b4f06a42-fc6e-4d81-9955-b0696e1939f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=240509de8961a8c050208eb50d8de8fe", "srcset": "https://si.imgix.net/2c1b5544/uploads/origins/b4f06a42-fc6e-4d81-9955-b0696e1939f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=240509de8961a8c050208eb50d8de8fe, https://si.imgix.net/2c1b5544/uploads/origins/b4f06a42-fc6e-4d81-9955-b0696e1939f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w