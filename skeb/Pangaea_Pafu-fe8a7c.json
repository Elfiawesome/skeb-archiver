e": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4555afb5/uploads/origins/cb808d3a-de13-4a5d-be09-ad8ac212bccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2cf58c25259038d91e2be5ebd6d56210", "srcset": "https://si.imgix.net/4555afb5/uploads/origins/cb808d3a-de13-4a5d-be09-ad8ac212bccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2cf58c25259038d91e2be5ebd6d56210, https://si.imgix.net/4555afb5/uploads/origins/cb808d3a-de13-4a5d-be09-ad8ac212bccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad6ad15502fd5e8186832e09145ec0d7 2x, https://si.imgix.net/4555afb5/uploads/origins/cb808d3a-de13-4a5d-be09-ad8ac212bccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0c92385884dce02d38a8608cffb4df13 3x"}, "body": "Vtuberの白羽みりあと申します。\n\nPANGAEA様のイラストがとても素敵で是非お願いしたいと思いました。\n\n恐竜が大好きで、アンキロサウルスが推しです。\n是非、私のキャラクターの衣装を着たアンキロサウルスを描いていただけないでしょうか？\n\n全部の衣装が難しければ、一部のみでも大丈夫です。\n\n\n可愛らしく描いていただけたら嬉しいです。\n\n\n【使用用途】\nSNS全般やYouTubeでの配信関係に使用したいです。\n\n\nhttps://drive.google.com/drive/folders/13d0JO9IafKUCbBjKbldCRaWC6mpBLSLi", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pangaea_Pafu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3584459, "client_id": 861621, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/25760226/uploads/origins/2a09ed6d-9469-4ace-9729-f385fec657dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f76ecab1be1d8a24f412ac948b9865b", "srcset": "https://si.imgix.net/25760226/uploads/origins/2a09ed6d-9469-4ace-9729-f385fec657dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f76ecab1be1d8a24f412ac948b9865b, https://si.imgix.net/25760226/uploads/origins/2a09ed6d-9469-4ace-9729-f385fec657dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=742d486083984025b615994b330f2a63 2x, https://si.imgix.net/25760226/uploads/origins/2a09ed6d-9469-4ace-9729-f385fec657dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e149706698cdb12686147b28f75cb7b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25760226/uploads/origins/2a09ed6d-9469-4ace-9729-f385fec657dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=925c2f85e57092c7a4dcffd858688ef5", "srcset": "https://si.imgix.net/25760226/uploads/origins/2a09ed6d-9469-4ace-9729-f385fec657dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=925c2f85e57092c7a4dcffd858688ef5, https://si.imgix.net/25760226/uploads/origins/2a09ed6d-9469-4ace-9729-f385fec657dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bb6304232e1cb37acd9cda7f9db55a20 2x, https://si.imgix.net/25760226/uploads/origins/2a09ed6d-9469-4ace-9729-f385fec657dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fbc3547d49e620f9ae58406617bf14ec 3x"}, "body": "PANGAEA様\n\n初めまして、ハローチキンと申します。\nskebの新着クリエイターからイラストを拝見し、とても可愛らしいイラストに心惹かれました。ぜひ私のOCを描いていただきたいと思い、リクエストさせていただきます。\n\n▶︎リクエスト内容\n私のOC「ストク」と「エクル」を描いていただきたいです。\n\n▶︎参考資料\nhttps://drive.google.com/drive/folders/1gEdQaTZoJQB_brckBE9zm3WWx36oVEYT\n\n▶︎キャラクター詳細\n〈ストク(緑)〉\n・身長：163cm\n・年齢：16歳\n・性別：男\n・一人称：ボク\n・性格：やんちゃ、好奇心旺盛、不真面目\n・表情：コロコロ変わる、感情豊か\n・嗜好・趣味：キャンディーが好き／ボードゲーム\n\n〈エクル(赤)〉\n・身長：165cm\n・年齢：16歳\n・性別：女\n・一人称：ワタシ\n・性格：おとなしい、真面目、世話焼き\n・表情：少し硬い\n・嗜好・趣味：コーヒーが好き／お菓子作り\n\n※資料内に人物詳細を載せていますが、読まなくても問題はないです。\n\n※彼らの住む世界の設定資料です。こちらも読まなくても問題はないです。参考程度にどうぞ。\nhttps://drive.google.com/drive/folders/1-Pw3TGFKQvWKMdVA2ZqOVnP2V0N2upl0\n\n▶︎構図\nPANGAEA様が描かれる恐竜がすごく可愛いと思いましたので、もし可能であるならば、2人を恐竜化していただきたいです(種は問いません)。\n難しい場合は全て自由に描いていただけますと幸いです。\n衣装も自由に変更していただいて構いません。\n\n▶︎使用用途\n・SNSのアイコンやヘッダー、PC・スマホの壁紙としての個人利用\n・アクリルキーホルダーや本など、個人鑑賞目的でのグッズ作成\n・今後skeb等依頼する際の参考資料としての活用\n\n▶︎その他\nキャラクターと背景等を分けたPSD形式のイラストだと嬉しいです。\nまた、ラフ段階のイラストや没になったもの等がありましたら、残していただけると嬉しいです。\n\nご依頼内容や金銭面で不明点や問題がある場合は、遠慮なく再送・キャンセルしてくださいませ。\nご多忙のところ恐れ入りますが、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1gEdQaTZoJQB_brckBE9zm3WWx36oVEYT", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 78075, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ななっとぅー(松前漬けちゃん)", "screen_name": "suzunana0730", "avatar_url": "https://pbs.twimg.com/profile_images/1927793252083847169/SNFGLBTa.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2325383815/1772375186/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 177}, {"id": 1650526, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "あいのすけ。", "screen_name": "AINosuke_031", "avatar_url": "https://pbs.twimg.com/profile_images/1541101378348945408/VMwd7o21.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1437775714544091136/1709743819/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "nc": 16}, {"id": 2047323, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "まるの🖋️", "screen_name": "SuketoHanaHana", "avatar_url": "https://pbs.twimg.com/profile_images/1705750932863262720/m-hxxCpu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1115364616127766528/1762316633/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_ran