s=4f086c2e58db11e04262793054562c40, https://si.imgix.net/a7a05ded/uploads/origins/dcc5f97d-cb27-4d27-aef0-82f374e9fecf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=02b91578189f22e2d44dc60bad35214c 2x, https://si.imgix.net/a7a05ded/uploads/origins/dcc5f97d-cb27-4d27-aef0-82f374e9fecf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8e75a8830c08c1cc2aa6b5ed118b6765 3x"}, "body": "はじめまして、乃木さん！イラストも漫画もとても素敵ですね。あなたの画風が大好きです！私のOC、ファングとアクセルの漫画をお願いしたいです。\n\n- ファング（緑髪）は時計屋を経営していて、アナログ時計を作ったり修理したりする時計職人です。実は時計屋の店主になりすましたスパイである。\n- アクセル（ダークグレーの髪）はアナログ時計好きで、時計の音が好きで趣味で集めている。ファングは彼の敵だが、彼はファングの変装した姿に気づかない。\n- 二人とも20代後半で身長は同じくらい。\n\nファングが暗い路地でアクセルを後ろから静かに尾行しているシチュエーションをリクエストしたい。彼はアクセルの1日のスケジュールを調査している。アクセルは誰かに尾行されているような気がして、夜まで食料の買い出しや園芸用具の購入など、あまり怪しくない行動をすることにした。ファングは諦めて家に戻ることにした。\n\n注釈\n- アクセルはいつも敬語を使います。\n- ファングの服装は「fang2(disguise).png」にマントを羽織って描いてください！\n- アクセルの服装は \"accel_casual_A.png \"で描いてください。\n- 舞台はファンタジーRPGのような感じで、建物はFF7のセクター7（七番街）とFF8のウィンヒルをミックスしたような感じです（世界観のイメージの一例ですので、描かなくても大丈夫です）。\n- 説明するのが苦手なので、台本に100％従う必要はありません。自由にアドリブで描いてください！\n\n情報が十分であることを願っています。\n無理な場合は遠慮なくお断りください！\n\nhttps://drive.google.com/drive/folders/1bKJoXL4wmx4DJDRGaYlBn0m-su03rsZX?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nogi_219/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1b5d232c/uploads/origins/64047cae-3243-4fea-91b2-23252305d3d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5ba97b7c26e933c0442159fb98e5388", "srcset": "https://si.imgix.net/1b5d232c/uploads/origins/64047cae-3243-4fea-91b2-23252305d3d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5ba97b7c26e933c0442159fb98e5388, https://si.imgix.net/1b5d232c/uploads/origins/64047cae-3243-4fea-91b2-23252305d3d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1cae0c06cce480080cb0dbe38d855ed6 2x, https://si.imgix.net/1b5d232c/uploads/origins/64047cae-3243-4fea-91b2-23252305d3d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57152f3a43c9f00f7d600ff5c95070df 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3076382, "client_id": 2609195, "nc": 1}, {"path": "/@nogi_219/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3076382, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/296b167f/uploads/origins/ef897204-ace3-4069-a1f0-d6f3f43d424b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa95d707dcd6d358bf6e8ad3d4301170", "srcset": "https://si.imgix.net/296b167f/uploads/origins/ef897204-ace3-4069-a1f0-d6f3f43d424b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa95d707dcd6d358bf6e8ad3d4301170, https://si.imgix.net/296b167f/uploads/origins/ef897204-ace3-4069-a1f0-d6f3f43d424b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25a2234aa73ce4e5cd007a275b05abe7 2x, https://si.imgix.net/296b167f/uploads/origins/ef897204-ace3-4069-a1f0-d6f3f43d424b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3de402fd5406b6f835a75b34262159d5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/296b167f/uploads/origins/ef897204-ace3-4069-a1f0-d6f3f43d424b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3770d4d5a118b9830ff4ac3379b892af", "srcset": "https://si.imgix.net/296b167f/uploads/origins/ef897204-ace3-4069-a1f0-d6f3f43d424b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3770d4d5a118b9830ff4ac3379b892af, https://si.imgix.net/296b167f/uploads/origins/ef897204-ace3-4069-a1f0-d6f3f43d424b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60068c7771a1d38fd986b50dc0961f85 2x, https://si.imgix.net/296b167f/uploads/origins/ef897204-ace3-4069-a1f0-d6f3f43d424b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a1a43538f0b73d0948870078eefdb46e 3x"}, "body": "乃木様、初めまして。\n\n貴方様の男女共に色気溢れる柔らかで美しい絵柄と\nそこから描かれるコミカルで表情豊かな可愛らしいイラストが大好きです…！\n新着作品を巡っていたところ、見覚えのある乃木様の絵柄の\n素敵な作品を見掛け、衝動的にリクエストを送らせて頂いた次第です。\n\n今回は、当方の一次創作を描いて頂きたくリクエストさせて頂きました。\n\nキャラクターの人選、解釈や描き方は乃木様の思うように描いて頂きたく、\nシチュエーションや構図、描写範囲やカラーの有無も全てお任せ致します。\n出来れば複数人描いて頂けるととても嬉しいです。\n\n大好きな乃木様の絵柄でどのキャラクターも見たい、と考えた結果の\n何もかもお任せの多い難しいリクエストとなり申し訳ございません…！\n\n難しければキャンセル、また再送要請等はお気軽にお願い致します。\n\nお目に留まりましたら、どうかよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1xyZmeJiYDsOFHj571LpK5vkj_1_i_L0L?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nogi_219/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7a9ee2cd/uploads/origins/df12fad4-4660-445a-9da6-5286143957e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ed3810f7e7a53ca4dc9f703cc49b5bf", "srcset": "https://si.imgix.net/7a9ee2cd/uploads/origins/df12fad4-4660-445a-9da6-5286143957e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ed3810f7e7a53ca4dc9f703cc49b5bf, https://si.imgix.net/7a9ee2cd/uploads/origins/df12fad4-4660-445a-9da6-5286143957e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78c5512ab4dba74ee47faf5e8cdc54e7 2x, https://si.imgix.net/7a9ee2cd/uploads/origins/df12fad4-4660-445a-9da6-5286143957e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de59b337b3571a6ed18642f77922e4dc 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3076382, "client_id": 2188498, "nc": 177}, {"path": "/@nogi_219/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3076382, "client_id": 2957476, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/77d4066b/uploads/origins/b02cc39b-a0d6-4398-b525-7fda4ba1082c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d97c79139d5c01bfeafbd345faf9030e", "srcset": "https://si.imgix.net/77d4066b/uploads/origins/b02cc39b-a0d6-4398-b525-7fda4ba1082c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d97c79139d5c01bfeafbd345faf9030e, https://si.imgix.net/77d4066b/uploads/origins/b02cc39b-a0d6-4398-b525-7fda4ba1082c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86f5d079218f7eec7122893929f420da 2x, https://si.imgix.net/77d4066b/uploads/origins/b02cc39b-a0d6-4398-b525-7fda4ba1082c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91f21c7f045dfcf025d1aec0663c5bdf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/77d4066b/uploads/origins/b02cc39b-a0d6-4398-b525-7fda4ba1082c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3ba1481b768ddb73e4962a513a663e3", "srcset": "https://si.imgix.net/77d4066b/uploads/origins/b02cc39b-a0d6-4398-b525-7fda4ba1082c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3ba1481b768ddb73e4962a513a663e3, https://si.imgix.net/77d4066b/uploads/origins/b02cc39b-a0d6-4398-b525-7fda4ba1082c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d35f57b30da4184f04d02327303a68bc 2x, https://si.imgix.net/77d4066b/uploads/origins/b02cc39b-a0d6-4398-b525-7fda4ba1082c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=252dfdace28fcaafd002a834e8e3ece6 3x"}, "body": "乃木様初めまして！\nイラストを拝見して、是非イラストを制作していただけないかと思いリクエストさせていただきます…！\n\nお願いしたいのは私の創作キャラクター2人のカップリングイラストです。\n◾️鯱(しゃち)\n29歳の男性/身長193cm/【攻め】\n落ち着いていていつも余裕が有ります。\n海が好きで瀬戸内の島に住んでいます。\n彼自身も海のような独特の雰囲気を纏っていて、穏やかでありながら強さと固い芯を持つ存在です。決めたことは貫き、時折ちょっと強引な時もあります。\n\n◾️登月(とげつ)\n23歳の男性/身長175cm/【受け】\n化粧や綺麗な髪飾りやネイルなど、お洒落が好きな男性です。「〜だと思うわ」「そうね」「頼むわね」等、柔らかな語尾(語感)が好きで口調に染み付いています。所作も女性に近いところがあります。元々鯱と対立する軍勢にいた剣士ですが、反逆して鯱の仲間になった経歴があります。\n\n◾️2人の雰囲気\nお互い想い合って仲良しなのですが、特に年上で芯の強い鯱に登月がメロメロしています。\n鯱は若干スパダリ気質が入っています。\n\n\n◾️作品自体の世界観\n現代の日本です。お話自体は魔法がテーマですが、和の要素を取り入れています。\n鯱は住んでいる島で仲間たちが使う魔具(張子)を作る仕事と、仲間たちが魔力を補充するための御神木を護る仕事をしています。\n登月は鯱の補佐として定期的に島に訪れて、\n張子作業の手伝いをしたり、\n島に御神木を狙った侵入者が来た際は鯱と登月で戦い、侵入者を仕留めます。\n\n◾️「バレンタイン」をお題にしたものをお願いしたいです…！\n構図等は自由に描いていただいて構いません。\nお題はバレンタインになりますが、日にちはこだわりませんので納品日は乃木様のご都合で構いません。\n\nもし差し支えなければ宜しくお願い致します…！(気が進まない場合や難しい場合は遠慮なくスルー、キャンセルしてください!)\n\n◾️2人の資料はURL先にまとめております。\n\nhttps://www.tumblr.com/gocigohan3", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nogi_219/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3076382, "client_id": 1475518, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6c266e5/uploads/origins/71b60535-cbb4-4ff1-a6c4-30c11fdac5f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa20cfc0c000eeaa1378a7fad3e8836f", "srcset": "https://si.imgix.net/b6c266e5/uploads/origins/71b60535-cbb4-4ff1-a6c4-30c11fdac5f9?bg=%23fff&auto=format%