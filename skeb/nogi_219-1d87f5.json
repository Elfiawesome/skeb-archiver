.net/03e8863d/uploads/origins/61572a2e-da75-4888-b7e9-f7a8d847c7c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f069543460fba05e1d26b61df6206a9", "srcset": "https://si.imgix.net/03e8863d/uploads/origins/61572a2e-da75-4888-b7e9-f7a8d847c7c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f069543460fba05e1d26b61df6206a9, https://si.imgix.net/03e8863d/uploads/origins/61572a2e-da75-4888-b7e9-f7a8d847c7c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0f95b5dc3d9e9b2ca992dfe13b7b23e 2x, https://si.imgix.net/03e8863d/uploads/origins/61572a2e-da75-4888-b7e9-f7a8d847c7c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0206ebb224b4803845b84cc05c86415 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03e8863d/uploads/origins/61572a2e-da75-4888-b7e9-f7a8d847c7c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcfb367f7e9bf6791a14e085fce75d55", "srcset": "https://si.imgix.net/03e8863d/uploads/origins/61572a2e-da75-4888-b7e9-f7a8d847c7c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcfb367f7e9bf6791a14e085fce75d55, https://si.imgix.net/03e8863d/uploads/origins/61572a2e-da75-4888-b7e9-f7a8d847c7c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5190958bbfefefaaee2c7a411a7a9ba9 2x, https://si.imgix.net/03e8863d/uploads/origins/61572a2e-da75-4888-b7e9-f7a8d847c7c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb491f88ba63ff73f41c9b5a6ec50d4a 3x"}, "body": "こんにちは！\n\nこのオリジナルキャラクターの漫画を描いていただけませんか？現代の設定です。超常現象捜査組織の上司（ゲイブ）と部下（アロイス）で、付き合っています。\n\nアロイス\n180センチ。金髪の男性。痩せ型。\nおしゃべりでいたずら好き、ずる賢い性格。\nゲイブの忠実な部下。ゲイブのことが大好き。\n\nゲイブ\n186センチ。グレーヘアーの男性。筋肉質。\n普段の表情は笑顔。クールでチャーミング、不遜でカジュアルな性格だが、密かに非常に危険な人物でもある。\nアロイスを素行の悪い部下のように扱うが、アロイスのことも大切に思っている。\n\nシナリオ\nゲイブとアロイスは森の中の山小屋で休暇を過ごすことにする。\n山小屋に着くと、そこは大きくて美しい湖の隣だった。\nゲイブとアロイスは一緒に湖に釣りに行くことにする。\nアロイスはとても興奮し、一番大きな魚を釣ると自慢する。ゲイブは面白がる。\n二人は湖の真ん中にボートを漕ぎ出し、釣り糸を投げる。\n巨大な魚を引き寄せようとして、アロイスは誤ってボートを転覆させてしまう。\nアロイスとゲイブは岸まで泳いで戻る。ゲイブは軽い苛立ちを見せる。アロイスは羊のように微笑み、自分のシャツから魚を取り出す。\n\n使用目的SNS、OC活動、個人的な閲覧のための印刷のみ。\n\nいずれにせよ、私のリクエストを読んでくれて本当にありがとう！\n\nhttps://drive.google.com/drive/folders/1atjIzPqghGCslfuaHI8uE5rk5gzVuPSz?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nogi_219/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3076382, "client_id": 187493, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8f66b31/uploads/origins/42ff18a3-f55c-441c-b729-9c8d978da3f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5714088859b8b78f5666077e867a57de", "srcset": "https://si.imgix.net/d8f66b31/uploads/origins/42ff18a3-f55c-441c-b729-9c8d978da3f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5714088859b8b78f5666077e867a57de, https://si.imgix.net/d8f66b31/uploads/origins/42ff18a3-f55c-441c-b729-9c8d978da3f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a45ab1c4cf3e0ae04a1aacf124431ee9 2x, https://si.imgix.net/d8f66b31/uploads/origins/42ff18a3-f55c-441c-b729-9c8d978da3f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d135ba1a50f7422d8ea8127083a465f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d8f66b31/uploads/origins/42ff18a3-f55c-441c-b729-9c8d978da3f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43b0ac5c41bd980f1a64e406a02cdba1", "srcset": "https://si.imgix.net/d8f66b31/uploads/origins/42ff18a3-f55c-441c-b729-9c8d978da3f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43b0ac5c41bd980f1a64e406a02cdba1, https://si.imgix.net/d8f66b31/uploads/origins/42ff18a3-f55c-441c-b729-9c8d978da3f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=69e092b1cc6a5097e3278fca41240b3b 2x, https://si.imgix.net/d8f66b31/uploads/origins/42ff18a3-f55c-441c-b729-9c8d978da3f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=87ac950a350a7b40c64947d2eb99edfd 3x"}, "body": "はじめまして。\nこの2人のオリジナルキャラクターの漫画を描いていただけませんか？\n\nヨーロッパの中世ファンタジーの世界です。\n\nルーファス\n魔道士で昆虫学者。真面目でぶっきらぼう、高慢な性格。ローハンをからかうのが好き。\n相手の呼び方「ローハン\n\nローハン\nルーファスに仕える黒ヒョウのシェイプシフターで騎士。礼儀正しく、威厳があり、責任感が強く、内気な性格。禁酒の一族で育つ。ルーファスに恋心を抱いている。\n相手の呼び方「ご主人様\n\nシナリオ\n中世の酒場で、ルーファスがローハンに酒を飲ませようとする喜劇の場面を描いてください。\nローハンは酒を飲もうとしないが、ルーファスはローハンに少し飲むように説得する。\nローハンはアルコールの影響に弱く、性格が内気から攻撃的なセクシータイプに変わる。ローハンはルーファスを誘惑しようとするが、ルーファスはローハンの大胆さにショックを受け、ローハンを酔わせたことを後悔する。\n\n不備があれば遠慮なく再アピールしてください。\n台詞は全て日本語でも構いません。\n使用用途：sns、oc活動、個人的な閲覧のみを目的とした画像の印刷の可能性。\nいずれにせよ、このリクエストを読んでくれてありがとう。\n\nhttps://drive.google.com/drive/folders/1wY0ev9O7TRqAAmsjoskacOizI-fqOD5h?usp=drive_link", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nogi_219/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3076382, "client_id": 23138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f2548c1/uploads/origins/98b3a531-c21f-4f12-a8be-580924827c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20593c76f3036290e657fceb64193e68", "srcset": "https://si.imgix.net/0f2548c1/uploads/origins/98b3a531-c21f-4f12-a8be-580924827c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20593c76f3036290e657fceb64193e68, https://si.imgix.net/0f2548c1/uploads/origins/98b3a531-c21f-4f12-a8be-580924827c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=730e86add551fe1ff34bc4dd2cce5082 2x, https://si.imgix.net/0f2548c1/uploads/origins