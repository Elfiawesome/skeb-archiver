Ung-WqwJZSCMxuXpqTsDbpF/view?usp=sharing\n参考フォルダ内の他の画像は、彼らの関係を表示するためのものです。\n\nシナリオ\nゲイブとアロイスが市場にいる。\nアロイスはゲイブに高級な短剣を買ってほしいと頼む。\nゲイブはアロイスをからかい、召使いがそんなことを頼むのは大胆だと言うが、それでも短剣を買ってやる。アロイスは興奮して喜ぶ。\n翌日、ゲイブはアロイスに、その品物を弁済するためにたくさんの仕事を命じる。\n\nありがとう！\n\nhttps://drive.google.com/drive/folders/1LHDUEqFpRQLqmIGVBtt1dERab3xH8XQe?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zusammenbleiben/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 16023, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c248b8e/uploads/origins/77a49304-ef2c-441b-8b0d-c0ee3a5cc81b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ceb92197b8d401e35e5a0f4fa2243aa0", "srcset": "https://si.imgix.net/6c248b8e/uploads/origins/77a49304-ef2c-441b-8b0d-c0ee3a5cc81b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ceb92197b8d401e35e5a0f4fa2243aa0, https://si.imgix.net/6c248b8e/uploads/origins/77a49304-ef2c-441b-8b0d-c0ee3a5cc81b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c60c6052687e92de7a592121e56d919 2x, https://si.imgix.net/6c248b8e/uploads/origins/77a49304-ef2c-441b-8b0d-c0ee3a5cc81b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44b30f24e2e193ad05042110ef580da7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c248b8e/uploads/origins/77a49304-ef2c-441b-8b0d-c0ee3a5cc81b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b82945e471849b552ed2ec37d35d0527", "srcset": "https://si.imgix.net/6c248b8e/uploads/origins/77a49304-ef2c-441b-8b0d-c0ee3a5cc81b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b82945e471849b552ed2ec37d35d0527, https://si.imgix.net/6c248b8e/uploads/origins/77a49304-ef2c-441b-8b0d-c0ee3a5cc81b?bg=%23