//si.imgix.net/e6c67375/uploads/origins/7215eba3-a2b3-49b1-b9f9-9320abec5132?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e97f483225b1e6c9ec4ec229eb86db79, https://si.imgix.net/e6c67375/uploads/origins/7215eba3-a2b3-49b1-b9f9-9320abec5132?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ef979664e72356613ccaaea2f6241f2d 2x, https://si.imgix.net/e6c67375/uploads/origins/7215eba3-a2b3-49b1-b9f9-9320abec5132?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b6dfa5e546d0bd26bd57f97cd5e9b603 3x"}, "body": "いつもお世話になっております。\nうちの子わんこいんちゃんの水着イラストをお願いします！\n\n服装として水着のデザインは以前描いていただいたビキニ（パレオも似合いそう？）で\nポーズ等はお任せしますが、グラビアっぽいポーズで投げキッスしていると嬉しいです。（参考URL貼っておきます）\n背景は無理にとは言いませんが、せっかくなのでビーチっぽい雰囲気でお願いします\n\n以上、ご検討お願いいたします。\n\nhttps://www.pixiv.net/tags/%E7%99%92%E6%9C%88%E3%81%A1%E3%82%87%E3%81%93%20%E6%B0%B4%E7%9D%80/artworks?p=2&s_mode=s_tag&ai_type=1", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hmn_mrr/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 999987, "client_id": 2757385, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1858f6fa/uploads/origins/c22f0f4f-254f-4456-850b-29d48731e2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb1dcaf6e71b9bc59ef69d129c0886e1", "srcset": "https://si.imgix.net/1858f6fa/uploads/origins/c22f0f4f-254f-4456-850b-29d48731e2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb1dcaf6e71b9bc59ef69d129c0886e1, https://si.imgix.net/1858f6fa/uploads/origins/c22f0f4f-254f-4456-850b-29d48731e2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bcdd1f6899f47b555e938e748712691 2x, https://si.imgix.net/1858f6fa/uploads/origins/c22f0f4f-254f-4456-850b-29d48731e2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=322d09439078d67ade59b7656f4ed075 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1858f6fa/uploads/origins/c22f0f4f-254f-4456-850b-29d48731e2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23215e51d4235f7c0406422b36fa8594", "srcset": "https://si.imgix.net/1858f6fa/uploads/origins/c22f0f4f-254f-4456-850b-29d48731e2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23215e51d4235f7c0406422b36fa8594, https://si.imgix.net/1858f6fa/uploads/origins/c22f0f4f-254f-4456-850b-29d48731e2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c418a342e230cfe15e9e63e20e5aff9a 2x, https://si.imgix.net/1858f6fa/uploads/origins/c22f0f4f-254f-4456-850b-29d48731e2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df272c2dc97e9162e9b14d3c257cf0ba 3x"}, "body": "白雪めり　様\n\nはじめまして。朱雀【Suzaku】と申します。\nVtuberの萌中もここを描いていただきたくリクエストをお送りしました。\n初めて送るのでおかしな点ありましたら申し訳ございません。\n\n✧使用用途 \n萌中もここが下記の活動で使用します。\n・YouTubeのサムネイル (YouTubeは収益化しております) \n・Twitter等のSNSでの宣伝 \n・FANBOXでの配布\n\n✧要望\n　全体的な構図と髪型及び服装はお任せしたいと存じます。\n左手側で『もこっこ』を抱きかかえて、右手はマイクを持って歌ってる感じにして頂ければ嬉しいです。\n可能であれば表情差分をつけて頂けるととてもうれしいです！\n\nまた、サムネイル等に使用するため髪や衣装の左右に見切れがないようにお願いしたいです。\n納品はキャラクターと背景をレイヤー分けしていただけると幸いです。\n\n三面図\nhttps://mokoko08.fanbox.cc/\nもこっこは羊をモチーフにしたものになります。\n参考になるか分かりませんが、こちらのサイトのコースターに描かれている感じです。\nhttps://kindcreation.stores.jp/items/645b0d25820089000180d0dd\n\nご検討宜しくお願い致します！\n\nhttps://mokoko08.fanbox.cc/", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hmn_mrr/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 999987, "client_id": 2435836, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38ad7a32/uploads/origins/a3f6ff66-f8af-48dd-8e24-46a0d0e8c185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73e0f0020f3977851b4777ab4be8342f", "srcset": "https://si.imgix.net/38ad7a32/uploads/origins/a3f6ff66-f8af-48dd-8e24-46a0d0e8c185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73e0f0020f3977851b4777ab4be8342f, https://si.imgix.net/38ad7a32/uploads/origins/a3f6ff66-f8af-48dd-8e24-46a0d0e8c185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e461614a20eada692ccd1cbbb145be7 2x, https://si.imgix.net/38ad7a32/uploads/origins/a3f6ff66-f8af-48dd-8e24-46a0d0e8c185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b438c2c448149cf84df709670f728cdd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38ad7a32/uploads/origins/a3f6ff66-f8af-48dd-8e24-46a0d0e8c185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f705d8b12569a7ec176c081ec189e193", "srcset": "https://si.imgix.net/38ad7a32/uploads/origins/a3f6ff66-f8af-48dd-8e24-46a0d0e8c185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f705d8b12569a7ec176c081ec189e193, https://si.imgix.net/38ad7a32/uploads/origins/a3f6ff66-f8af-48dd-8e24-46a0d0e8c185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=169a74e2f9cf345c558afa664b540bc4 2x, https://si.imgix.net/38ad7a32/uploads/origins/a3f6ff66-f8af-48dd-8e24-46a0d0e8c185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e056cf8672c2d26f252323f8aad06d25 3x"}, "body": "こんばんははるぼうです。\n自分の推しの萌中もここさんのイラストを白雪めりさんに描いてもらいたくて依頼しました。\nもうすぐ夏ということで衣装は浴衣でお願いします。\n浴衣の色や柄、ポーズや表情等はお任せします。\n\n（使用用途）\n完成したイラストは萌中もここさんがサムネイル等に使うと思います。\n\nまた、個人的に自分がデスクトップの壁紙やツイッターのヘッダー等に使用します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hmn_mrr/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "