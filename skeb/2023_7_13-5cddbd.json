ほくろ。✂️ オレンジ色の短い髪の彼女を描いてください！\n- 🐰: 音楽プロデューサーです。細い目、口紅、猫背、小さくて恥ずかしそうな笑顔。お姉さんのような。\n- 二人は高校時代にロック/メタル・バンドを組んでいた。\n- 二人とも音楽の才能があり、エレキギターを弾く\n- お互いを深く愛するソウルメイト\n- 二人が一緒にいるとき、二人はとても愛情深く、のんきで、まるで他の誰も存在しないかのようにラブラブだ。\n- 二人ともカジュアルでジェンダーレスな服装が好きで、着心地のいいものなら何でもOK。\n\n先生の絵を信頼していますので、自由に描いてください！ご検討ありがとうございました！\n\nhttps://sta.sh/2jwpdnu7a5c?edit=1", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2023_7_13/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3369688, "client_id": 667554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/428519f7/uploads/origins/eab12ade-ce91-4a40-bd65-dac5e391a957?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd07d05f0372fb37de3f4e486b3612d7", "srcset": "https://si.imgix.net/428519f7/uploads/origins/eab12ade-ce91-4a40-bd65-dac5e391a957?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd07d05f0372fb37de3f4e486b3612d7, https://si.imgix.net/428519f7/uploads/origins/eab12ade-ce91-4a40-bd65-dac5e391a957?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc3fda1ac43a7cc1554680356dd289cc 2x, https://si.imgix.net/428519f7/uploads/origins/eab12ade-ce91-4a40-bd65-dac5e391a957?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e09db3cb21113e682e96360218a7565e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/428519f7/uploads/origins/eab12ade-ce91-4a40-bd65-dac5e391a957?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9017ca67aafe887509088d4c0678ce4", "srcset": "https://si.imgix.net/428519f7/uploads/origins/eab12ade-ce91-4a40-bd65-dac5e391a957?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9017ca67aafe887509088d4c0678ce4, https://si.imgix.net/428519f7/uploads/origins/eab12ade-ce91