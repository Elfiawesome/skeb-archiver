と同時に、弟を感情のはけ口にしている。重度の感情障害を持ち、そのため感情を正しく表現することができず、愛情さえも非常に歪んでいるように見える。\n支配欲が極めて強くて大抵のことは暴力的に解決する。\n\n【弟】\n髪色：緑\n年齢：21\n身長/体重：187cm/71kg\n兄に軍隊の管理に手伝わされ、管理職ぶって威張ることを強制されたが、実はプライベートではとても親切だった。\n何があっても笑顔で本当の気持ちをごまかし、元々とても優しい人なんだ。実は泣きがちだけど、それを表に出す機会がなかなかない。\n依存的な兄を精神的な支えとして扱い、兄への尊敬と兄のねじれた愛への恐れの両方を抱いている。\n\nこの部分の内容を参考しないでご自由に描いても構いません！この中からお気に入りの格好を選んで描いてください！\nご検討よろしくお願いします。\n\nhttps://weibo.com/7847198449/5107825409262815", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2023_7_13/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3369688, "client_id": 2714974, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/705cc347/uploads/origins/cfde2ea5-db6c-481c-83b6-06f3acebc0f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df87e32d711bccebbc3adab8ffcc7621", "srcset": "https://si.imgix.net/705cc347/uploads/origins/cfde2ea5-db6c-481c-83b6-06f3acebc0f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df87e32d711bccebbc3adab8ffcc7621, https://si.imgix.net/705cc347/uploads/origins/cfde2ea5-db6c-481c-83b6-06f3acebc0f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fb026c5415926848e5e5bd40c307d9d 2x, https://si.imgix.net/705cc347/uploads/origins/cfde2ea5-db6c-481c-83b6-06f3acebc0f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d021fae27ce8c5c16d7a6e96a1ba8b22 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/705cc347/uploads/origins/cfde2ea5-db6c-481c-83b6-06f3acebc0f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9f80b94c9cff6d8e87e2bc2b3538452", "srcset": "https://si.imgix.net/705cc347/uploads/origins/cfde2ea5-db6c-481c-83b6-06f3acebc0f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9f80b