rue}, {"path": "/@2023_7_13/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3369688, "client_id": 3474968, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/177b6e57/uploads/origins/c7f6b82a-9fe7-4528-ab12-d71de063fae5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6364158aa0e58c8bacee59dc6243f89a", "srcset": "https://si.imgix.net/177b6e57/uploads/origins/c7f6b82a-9fe7-4528-ab12-d71de063fae5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6364158aa0e58c8bacee59dc6243f89a, https://si.imgix.net/177b6e57/uploads/origins/c7f6b82a-9fe7-4528-ab12-d71de063fae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95d65e34cdd0b09f720d70af8fc2585f 2x, https://si.imgix.net/177b6e57/uploads/origins/c7f6b82a-9fe7-4528-ab12-d71de063fae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc4565e4c4aa2c53cac070fe9e26fba0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/177b6e57/uploads/origins/c7f6b82a-9fe7-4528-ab12-d71de063fae5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e06bc0e2e3134aa4a44370aa29180265", "srcset": "https://si.imgix.net/177b6e57/uploads/origins/c7f6b82a-9fe7-4528-ab12-d71de063fae5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e06bc0e2e3134aa4a44370aa29180265, https://si.imgix.net/177b6e57/uploads/origins/c7f6b82a-9fe7-4528-ab12-d71de063fae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=03820f8d68d73e9b119094ad6a646fc1 2x, https://si.imgix.net/177b6e57/uploads/origins/c7f6b82a-9fe7-4528-ab12-d71de063fae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=90cc33ba25381f0f9836b22a170962c6 3x"}, "body": "はじめまして！\nSkebで九里先生のイラストを拝見し、空気感や描写にとても惹かれました。ご依頼を受け付けていらっしゃると知り、この機会にぜひお願いしたく、リクエストさせていただきます。\n\n今回ご依頼させていただきたいのは、クトゥルフ神話TRPG『演繹＆本我』というシナリオに登場するキャラクター2名です（うち一人は公開NPCです）。もしご興味を持っていただけましたら、詳細は下記リンクよりご確認いただけますと幸いです。\nhttps://drive.google.com/drive/folders/1guSsSQb4-l6Rzb0jkFDIRiZPtXew2pKC\n\n\n【キャラクター紹介】\n\n◆ 河原木 楓（かわらぎ かえで）（NPC）\n男性／32歳／195cm／刑事（後輩）\n明るめの茶髪、左右で色味が異なる緑のオッドアイ（左目の方が淡い）。\n日英ハーフで、穏やかで落ち着いた話しやすい人物。常に礼儀正しく紳士的な振る舞いを心がけており、内面には重たい感情を抱えている。視線はいつも三日月を追っている。\n\n◆ 三日月 悠一（みかづき ゆういち）\n男性／38歳／187cm／刑事（先輩）\n黒髪、グレーの瞳。左目の下と右首元にホクロがあります。\n明るく朗らかで、周囲を元気にする太陽のような存在。高い能力で多くの人に慕われていますが、実際はかなり自己主張が強く、ルールに縛られるのを嫌う自由な性格です。\n\n\n【ご依頼内容】\nこの二人の関係性を描いたツーショットイラストをお願いしたいです。\n雰囲気としては、親密ながらもどこか歪んでいて重く、強い圧を感じるような構図・空気感を希望しております。（刑事としての仕事の合間ではなく、休日に出かけるデートのような、穏やかで温かい雰囲気のある日常シーンを希望しております。）\nシチュエーションや構成はお任せいたしますので、先生の個人のスタイルで自由に描いていただけたら嬉しいです。\n\n【使用用途】\n個人観賞用・個人使用の範囲での少部数印刷・SNSアイコン・ヘッダー等\n\n金額に不足がございましたら、再度リクエストを送らせていただきます。\nご縁がございましたら、どうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1guSsSQb4-l6Rzb0jkFDIRiZPtXew2pKC", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2023_7_13/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3369688, "client_id": 3585197, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/85993bc5/uploads/origins/2c358c74-0883-4146-befa-0dc1e7470150?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd126107aa843bf8ac0e0b18bed192c4", "srcset": "https://si.imgix.net/85993bc5/uploads/origins/2c358c74-0883-4146-befa-0dc1e7470150?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd126107aa843bf8ac0e0b18bed192c4, https://si.imgix.net/85993bc5/uploads/origins/2c358c74-0883-4146-befa-0dc1e7470150?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=feb0d6d15f47eb36609fd40c56cead6a 2x, https://si.imgix.net/85993bc5/uploads/origins/2c358c74-0883-4146-befa-0dc1e7470150?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&f