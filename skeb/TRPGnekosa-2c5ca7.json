": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@TRPGnekosa/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1019426, "client_id": 1291989, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab79fda0/uploads/origins/4f81da25-4f59-4fc9-83a9-aee37ae3ef4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=301609da581e96f5ee8abb486c3b4d9b", "srcset": "https://si.imgix.net/ab79fda0/uploads/origins/4f81da25-4f59-4fc9-83a9-aee37ae3ef4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=301609da581e96f5ee8abb486c3b4d9b, https://si.imgix.net/ab79fda0/uploads/origins/4f81da25-4f59-4fc9-83a9-aee37ae3ef4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63a8b4a91fad45ffecd1ee739c8e0434 2x, https://si.imgix.net/ab79fda0/uploads/origins/4f81da25-4f59-4fc9-83a9-aee37ae3ef4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3193881d6e079070c479879c5057c2ce 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab79fda0/uploads/origins/4f81da25-4f59-4fc9-83a9-aee37ae3ef4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdff17121405d43dad89300283c3ec3d", "srcset": "https://si.imgix.net/ab79fda0/uploads/origins/4f81da25-4f59-4fc9-83a9-aee37ae3ef4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdff17121405d43dad89300283c3ec3d, https://si.imgix.net/ab79fda0/uploads/origins/4f81da25-4f59-4fc9-83a9-aee37ae3ef4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6dfa108e8116c01de03584846e4b359a 2x, https://si.imgix.net/ab79fda0/uploads/origins/4f81da25-4f59-4fc9-83a9-aee37ae3ef4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fbb79080e2cc478bb4dc07d1c0b94eae 3x"}, "body": "はじめまして、先生の作品は素晴らしいです!!!!特に先生の絵のキャラクターへの理解と雰囲気が好きです！私のキャラクターの漫画を描いていただけませんか？\n近未来の世界で、人々は人類最後の希望として特殊軍事組織を作った。彼らは「星の塔」と呼ばれる軍事施設で暮らす16、17歳のティーンエイジャーです。\n\nフォルダ『トリオ-プロフィール』の資料を参考にしてください。総計三人です\n彼らは友達であり同僚です。\n\n█キャラクター\nヘルメス(175cm): \n黒髪、灰青色の目\n兵士の中で一番強い。\n明るく、知的で、人気者。 明るくいい人に見えるが、実はかなりの悪党でエゴイスト。\n彼の欠点を挙げるとすれば、「人の弱さをうまく表現できないからこそ完璧すぎる」ということだろう。\n\n精神体（力が具現化した存在で、ペットとして扱うこともできる、また、オーナーの潜在意識も表している。）:しなやかな黒狼\n\nアルテミス(162cm): \n金髪、緑色の目\n優等生で、よく笑顔を浮かべ、群衆の人気者、優しい高嶺の花。\n実は愛情表現が薄く、自分のことしか考えていない。\nアレースの現在のパートナー。管理に従わず処分されかけたアレースを救い、彼とコンビを組むことになった。\nかつてヘルメスと共に「聖所」で育ったが、ある理由で当時二人の関係は途絶えた。\n精神体:ゴールデンチンチラ・ブリティッシュロングヘア\n\nアレース(175cm): \n深茶色の髪、青緑色の目\n外界から強制的にタワーに入れられ、その全てを嫌っている。迷惑そうな顔をすることが多い。\n不良少年の感じ、よく他人と対立したり喧嘩したりして怪我をする。体力は非常に強いですが、戦い方が無謀なのでよく怪我をします。\n実は、一度仲間と認めた相手を決して見捨てない、素直でいい子。\n甘いものが大好き。\n後天的に力に目覚めたため、普通の人間からガーディアンへと変わる際の拒絶反応にうまく適応できなかった。精神が敏感で、怒りやすい。\n彼は自分の力を制御するのが難しいため、任務中に刺激を受けて暴走してしまうことがあります。その際には、パートナーであるアルテミスが精神的なケアを行い、さらにその後、安定剤の注射を行う必要があります。\n精神体:片方の耳が立っていない犬 (彼が普通の兵士たちから差別されていたため、「野良犬」という軽蔑的なあだ名を付けられたこともあります。)\n\n登場人物の人間関係についてはリンク先の情報をご覧ください！\n\n普段、三人が一緒に過ごす時間は少ないですが、大体は二人の聡明な優等生が（悪意なく）アレースをからかいます。そして、アレースは普通の人間なのでツッコミ役を担っています。また、この二人は何かと彼を守ったり、愛情を持って接したりする感じがあります。\n以下はいくつかの参考シーンです。\n1.食堂での食事中、ヘルメスが二人を見つけると自然と近づいて座ります。\nアレース：なんでここに座るんだ、空席はいくらでもあるだろ。\nヘルメス：邪魔だったかな？本当に仲がいいね。これ、許してくれ。（おまけのデザートを差し出す）\nアレース：…別に仲良くない（デザートを受け取る）\n2.元々三人並んで廊下を歩きながら話していると、この二人の人気が高いため、いつの間にか人混みに囲まれてしまい、アレースは腕を組んで一人で待っている。\nしばらくして人混みが散った後、二人がアレースを見つけて、彼に「お利口に待ってて偉いね、寂しかった？」と褒める。\nアレースはわけもわからず恥ずかしそうに：？は？誰が寂しいって？\n3.アレースとヘルメスが衝突して口論になり、最後には\nアレース：ああもう我慢できない、今日は絶対にお前を倒してやる！\nヘルメス：いいね、これから「教育」の時間だ。\n後に「切磋」と称される対決はヘルメスの勝利で幕を閉じ、特にアレースを見に来たアルテミスが二人が背中合わせに休んでいるのを見つけ、水筒を持ってきて差し出す：お疲れ様、勝敗はどうだった？\nヘルメス：24対3\n後ろのアレースが不機嫌そうに舌打ちをする。\n\n█委託内容：\nhttps://drive.google.com/file/d/14YbdqZ1u11WeKjM5HhwTFUONVz7_JXvv/view?usp=sharing\n\n█注意すべき点：\n彼らは16歳前後の少年であるため、あまり大人っぽく描かないようにしてください。\n\nもし可能であれば、テキストと吹き出しは異なるレイヤーに配置していただけると助かります！\n可能であれば、別レイヤーにサインを入れたpsdファイルをお願いします。\nお忙しい中、ご覧いただきありがとうございます。お引き受けいただけると幸いです。難しい場合は遠慮なくお断りください。\n\nhttps://drive.google.com/drive/folders/1tZM0CbVhpyQKjMLnWj0ykQ8gya_XUGi9?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TRPGnekosa/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/75bcc84e/uploads/origins/33618a85-054b-4f75-975a-22d3b747dd83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4bbc6707414abef38290835c1ca1a71", "srcset": "https://si.imgix.net/75bcc84e/uploads/origins/33618a85-054b-4f75-975a-22d3b747dd83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4bbc6707414abef38290835c1ca1a71, https://si.imgix.net/75bcc84e/uploads/origins/33618a85-054b-4f75-975a-22d3b747dd83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c4582f6a20244d1c46913191b87cbcc 2x, https://si.imgix.net/75bcc84e/uploads/origins/33618a85-054b-4f75-975a-22d3b747dd83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d57dfbd932539a4f32af06f12d27d0d 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1019426, "client_id": 1327078, "nc": 177}, {"path": "/@TRPGnekosa/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1019426, "client_id": 1164612, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31044d4a/uploads/origins/bf713921-0c1a-4475-8e82-23af1e7493b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=353861b9e6efd42d86d97dd52dce669b", "srcset": "https:/