p&w=200&h=200&blur=200&s=055dd751a4d6301fbe78cf3c2d4bd347", "src_set": ""}, "body": "いつもお世話になっております！\nオリキャラのイラストを依頼させていただきたいです！\n\n使用目的\nSNSのヘッダー・アイコン　配信画面　壁紙等\n\n依頼内容\n資料URLに三面図を載せておきます\n\n髪型\n高めのツインテール (ラビットスタイル)\nもみあげが長めで髪飾りがついています\nテールともみあげはどちらも胸くらいの長さです\n前髪は目に掛かるくらいの長さでおろしてます\n\n髪色\n水色(細かい色味の調整はお任せします)\n\n瞳\n水色(同上)\n\n肌\n白め\n\n服装\n白と水色のセーラー服\nスカートは水色ベース\n細かい部分はお任せします\n\nその他\nポーズの指定等はありませんので自由に描いていただきたいです\n雰囲気とか構図も全部お任せします！！\n\nhttps://drive.google.com/drive/folders/1cDFFiv3mhITrCsspzUJYXeuY-YvTILoX?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gyokuo1007/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2536762, "client_id": 1264124, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9705a112/uploads/origins/b736b3aa-5165-42a5-af29-5023be264497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa76ade7cbd221211034b002ef69ae7d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9705a112/uploads/origins/b736b3aa-5165-42a5-af29-5023be264497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d7ad752bf729e8cbc9698cd59d1d9f0", "src_set": ""}, "body": "はじめまして\n絵がとてもきれいでかわいい\n本当に大好きです\n\nオリキャラのイラストをお願いしたいです。\n\n▷ オリキャラ詳細\n\n-彼女は16歳。\n-髪の色は白、目の色は青。\n-身長は154cm、体型は小柄。\n-胸はとても小さいので、平らな胸で描いてください。\n\n-彼女はとても親切で優しい女の子で、明るい一面もあります。\n\n参考資料\nhttps://sta.sh/2im3r6zmza0\n\n\nできれば私のオリキャラをかわいい表情で描いてください。\nそれ以外は自由に描いてください。\n\nよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gyokuo1007/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2536762, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c30d6c9/uploads/origins/aeb0057f-5402-4e07-87a6-4c4b1c9dc8be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b35d07b4662e1f3e11ab712e6a3f95d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c30d6c9/uploads/origins/aeb0057f-5402-4e07-87a6-4c4b1c9dc8be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa8fe3aac38bd11a55ee20781ff5169e", "src_set": ""}, "body": "こんばんは！\n素敵なイラストを拝見してぜひ描いていただきたいと思い依頼しました。\n\n【依頼内容】\n・私がVRChatにて使用しているアバターのイラストを描いていただきたいです。\n・構図、ポーズ等はお任せします。細かい部分はアレンジしていただいて構いません。\n・左手が義手になっています。アウターありの状態で描いていただきたいのでほぼ隠れますが、一応腕全体の資料も載せております。\n・資料の中に髪飾りが違うものもありますが、Tポーズの髪飾り（赤いサメ）のほうを描いていただけると嬉しいです。\n\nもし機会がありましたらよろしくお願いします！\n\nhttps://imgur.com/a/shinano-GA7c0vo", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gyokuo1007/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2536762, "client_id": 375024, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/36962031/uploads/origins/237ee1b5-e880-4783-bfba-d549663c51f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7f30f6a59d3084976a28e347b14adb5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36962031/uploads/origins/237ee1b5-e880-4783-bfba-d549663c51f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a16ba45ef317cecf03a258f911b26df", "src_set": ""}, "body": "いつもイラスト拝見させていただいております。\nスタレのホタルちゃんの\n『ホタルとひと夏の約束 Ver.1.2』の最後に表示される一枚絵の\n星核ハンターの衣装をリクエストします。\n構図はお任せいたします。\nよろしくお願いいたします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gyokuo1007/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2536762, "client_id": 674760, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e5b9dcb7/uploads/origins/89c6858e-5f20-43b2-9e1b-416829d61dac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=babf0f10dda53084d50726af5f5e84d6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e5b9dcb7/uploads/origins/89c6858e-5f20-43b2-9e1b-416829d61dac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd3f0a44da511d3c24102bf25f15a04d", "src_set": ""}, "body": "折紙ぎょくお先生、こんにちは。\n先生の絵が好きです。\nもしよろしければ、うちのオリジナルキャラクターの描き下ろしをお願いしたいと思います。\n\nこの子は旅の召喚士です。無邪気で、好奇心が強い、たいてい純真で、明るく、優しい女の子。本質的には無意識の、魔物に似た混沌とした性質を持つ(意識的な悪意ではない)が、普段はコントロールできる状態。\nファンタジーJRPGのような世界観の中にいるキャラクターです。\n平和な時代、とある小さな異界の全ての魔物の代理外交官として、皆の食費を稼ぐために雇われて各国を渡り歩いていた。「伝説の一人兵団」と呼ばれる。\n彼女がもともと所属していた異界「タロエルム」は、資源に乏しく単調で狭い、魔物しかいないの世界だった。そのため境界のないほど広い世界、人間やその他さまざまな種族が共に生きる世界に対して、探究心に満ちている。\n\nフードをかぶっているかどうか、リュックを肩にかけているかどうか、好きな状態を選んでください。フードをかぶっていない状態では、背中の長いおさげが見えてしまうので注意してください。黒い羽は彼女のシュシュです。\n人間の若い女の子のようにはつらつとした明るい一面もあれば、魔物の集合意識の塊としての混沌な一面(ぼんやりとした、うつろな、ハイライトを失った感情状態に近い、この状態では髪がバラバラになってしまいます)もあるキャラクターです。どんな形で描いてもOKです。\n構図やポーズは、ご自由に決めてください。\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1kFCz6id6FcZqEA5VTOul-LnzQvY6KqHj?usp=share_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gyokuo1007/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2536762, "client_id": 2362, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ebfaa3e9/uploads/origins/b058a6d3-4532-42cb-b071-cfdb2be0de5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f957dedfbe31764c2cbf9c175620f6b4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ebfaa3e9/uploads/origins/b058a6d3-4532-42cb-b071-cfdb2be0de5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f58171f7614d88c53ca6a24fe6baec24", "src_set": ""}, "body": "うちの娘レイラちゃんをお願いします。\n\n衣装は制服と夏服の2つありますがどちらかはおまかせします。\nかわいく描いてあげてください！！\n\n✱左目の下に黄色の星が2つあります。周りは黒等で縁取らずになじませる感じでお願いします。\n\n\n\n納品はPSDデータで、名前ありなしの2つ(レイヤー分け可)あると嬉しいです、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1TYGC76YQtEUR6dbuf-0PQ40DK4P3tsai", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gyokuo1007/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2536762, "client_id": 735135, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f7a6a83d/uploads/origins/986da335-d0f0-4188-98f0-23677f9195ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e122bd45227128c416f4cd4573ecf1f7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f7a6a83d/uploads/origins/986da335-d0f0-4188-98f0-23677f9195ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9587adbdd4bed8e042c269067101c481", "src_set": ""}, "body": "私のVRCでの姿（アクティブヴァンパイア風ラスク）のイラストを\nぎょくおさんのお好きな温度感でしたためて欲しいです！\n\nVRC上で鎌を上手く使うのが中々難しいので、\nせっかくならこれをイラストの構図に落としていただきたいなという気持ちがあります\n鎌と一緒に映えてると嬉しいです。\n\n少ないですが参考画像です\nhttps://drive.google.com/drive/folders/1kp74j7wvgcOB-2P_3nZzjn_lAGPpz_Rk?usp=sharing\n\n用途ですが、\nVRCのアバターサムネイルになります！\nSNSのアイコン映えしそうなら2か月～4か月くらいアイコンに設定します！\nまた、サイズ次第ではヘッダに鎮座するかもしれません！\n\n最後に、\nバストアップだけだったから残念とか、デフォルメ具合が肌と逢わないとか、\nそういうのは一切ないです。\n今回で言うと「鎌と私」の映えを意識して取り掛かってくだされば、\n最終アウトプットはどんな形式でも嬉しいです！！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 529427, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🦔おてん🦔", "screen_name": "if959u", "avatar_url": "https://pbs.twimg.com/profile_images/14062721955