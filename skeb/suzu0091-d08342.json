p&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7f8708a5f695eaf33fd93a358249dfc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e424064b/uploads/origins/ae3cf34a-2f69-42af-8f9f-619bcde7378b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aaa7b742d88230e90b6e4f53c33d3f0e", "srcset": "https://si.imgix.net/e424064b/uploads/origins/ae3cf34a-2f69-42af-8f9f-619bcde7378b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aaa7b742d88230e90b6e4f53c33d3f0e, https://si.imgix.net/e424064b/uploads/origins/ae3cf34a-2f69-42af-8f9f-619bcde7378b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=31926f721a19f78eee97dd6bfceb9640 2x, https://si.imgix.net/e424064b/uploads/origins/ae3cf34a-2f69-42af-8f9f-619bcde7378b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=24a3f65c4676e8f66287795d510b26a6 3x"}, "body": "はじめまして。\n個人VTuberとして活動中の熊宮てくと申します。\n検索していた際に偶然お見かけした、すずもり様がskebで納品されていた爽やかな夏のイラストに一目惚れし、リクエストさせて頂きました。\n\n以下、リクエスト内容になります。\n\n○資料\nhttps://drive.google.com/drive/folders/1PmW36TvCQBEhR_25TDGNEFVf7O-dbFIp?usp=sharing\n\n○リクエスト内容\n・熊宮てくが寝る前のような雰囲気の1枚絵を描いて頂きたいです。\n・服装・ポーズ・構図・背景は全てお任せ致します。\n・お手数おかけ致しますが、納品時に透過版（PSDや背景が白いもので大丈夫です。）も合わせて、頂けると幸いです。\n\n○使用用途\n配信や動画のサムネイル（YouTube）、SNSのツイート等のVTuber活動に使用致します。\n\nもしご縁がございましたら、熊宮てくをすずもり様の素敵な絵柄で描いて頂きたいです。\n\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1PmW36TvCQBEhR_25TDGNEFVf7O-dbFIp?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suzu0091/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2683641, "client_id": 2828784, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/408bf1b3/uploads/origins/b7892b07-bc00-4f81-96cd-80b442a2ccd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop