に住む人々の幸せな結婚生活の願望を体現したような女神で、恋バナが大好き。ただ、夫婦内のケンカの仲裁や家庭裁判所の裁判官のような面もあり、時々厳しい信託も下します。\n\nそんなレティアーナのてぇてぇ日常の一幕を書いていただきたく思います", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amonesshiomiya/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3993884, "client_id": 2403555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cedd2c04/uploads/origins/99412e35-66ef-4fd6-a71d-1d4258c2ee2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cbf8463757f077d7c4f9386ed458e63", "srcset": "https://si.imgix.net/cedd2c04/uploads/origins/99412e35-66ef-4fd6-a71d-1d4258c2ee2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cbf8463757f077d7c4f9386ed458e63, https://si.imgix.net/cedd2c04/uploads/origins/99412e35-66ef-4fd6-a71d-1d4258c2ee2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f9248867375fac8de47146c09ec2a86 2x, https://si.imgix.net/cedd2c04/uploads/origins/99412e35-66ef-4fd6-a71d-1d4258c2ee2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9eb2a726911af7d1575581d4693c121 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cedd2c04/uploads/origins/99412e35-66ef-4fd6-a71d-1d4258c2ee2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c741cb8cf00ff58c5079c1ba43bc7664", "srcset": "https://si.imgix.net/cedd2c04/uploads/origins/99412e35-66ef-4fd6-a71d-1d4258c2ee2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c741cb8cf00ff58c5079c1ba43bc7664, https://si.imgix.net/cedd2c04/uploads/origins/99412e35-66ef-4fd6-a71d-1d4258c2ee2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d4aebadd19f2658cb2ee3ccb1bf71aa9 2x, https://si.imgix.net/cedd2c04/uploads/origins/99412e35-66ef-4fd6