&h=200&blur=200&s=63c75df8f41266ef6d42ae1bd509680c", "src_set": ""}, "body": "ブショカさんまたご依頼失礼します！\nもしよろしければ僕のキャラクターのイラストをお願いします！\n僕のキャラが巨大な蛇に巻きつかれてぐるぐる洗脳目で催眠をかけられて蕩け顔にさせられてるシチュエーションをお願いしたいです。\n細かい構図などはお任せします\nよろしくお願いします...!\n\nキャラの資料:https://x.com/Furrikku/status/1915790542585401590", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_busho/works/92", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2987324, "client_id": 2680607, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/908315ab/uploads/origins/311463e6-2249-4ce1-a8b4-3702073893fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd78215851c844670712022cbe92000b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/908315ab/uploads/origins/311463e6-2249-4ce1-a8b4-3702073893fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39276e105aee9c4ad91a1dbd12fa1500", "src_set": ""}, "body": "私のピラニアプラントとクッパをモチーフにしたアートピースが欲しいです。\n\nパート1では、クッパの頭がピラニア・プラントの口の中に入り、唾液で頭を覆っている。クッパはショックを受けているか怖がっているように見え、ピラニアプラントのお腹が非常に大きくなっているのがわかります。\n\nパート2では、クッパの甲羅が完全に空になり、ピラニア・プラントが甲羅にもたれかかっている。クッパの腹は非常に大きくなっており、うなり声も出ている。\n\nhttps://drive.google.com/file/d/1byesCX4pz7_EZoP0G-p6qR5SsrHfnqzY/view?usp=drivesdk", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_busho/works/91", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a8ab0c32/uploads/origins/bfb4837c-a3d3-4d37-aa83-9b8f3dec43a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5a62c673b94cb726b705268512cb690", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 2987324, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@k_busho/works/90", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2987324, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7feb45c/uploads/origins/d3847d99-6d84-4969-8a91-442d2be44965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0c44e76922aed173f658da5d4dd3b3f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7feb45c/uploads/origins/d3847d99-6d84-4969-8a91-442d2be44965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33b2847ab062af4771b848ac4bead93e", "src_set": ""}, "body": "こんにちは。舐めている写真をお願いしたいのですが。\n\n中二病でも恋がしたい！の二風谷シンカがポケモンのでっかいアルカニンに全身舐められてる写真が欲しいです。そして、彼女が逃げようとしているときに、もう一匹の大きなアルカニンが彼女を止めて、同じように彼女を舐めるので、今では二匹のアルカニンが彼女を舐めている。アルカニンが彼女の全身を舐め終わった後、彼女が唾液でびしょびしょになっているのを確認してください。ありがとう。\n\nシンカ\nhttps://images.app.goo.gl/UA4uh", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_busho/works/89", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2987324, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/99df29ef/uploads/origins/6e61dc2d-27e8-4bd3-9bfe-a6794cae5b05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=013bf4775212ffb30ab6732f8c265b97", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99df29ef/uploads/origins/6e61dc2d-27e8-4bd3-9bfe-a6794cae5b05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a4cbffd092cce5b81cfd6e12662260b", "src_set": ""}, "body": "お世話になっております。次のリクエストをお願い出来ないでしょうか？\n前回まではメルだったのですが、今度はキティのお友達のディアダニエルをお願いできないでしょうか？\n\nダニエルがライクライクと知らずにツンツンする。ライクライクが口を伸ばしてダニエルがびっくりする。ダニエルは食べられ、足でジタバタする。ライクライクがダニエル全体を食べて膨らみ、「ごっくん」と共にダニエルを飲み込んだ。ライクライクの脈打ちと共に、ダニエルは膨らんだライクライク の体内で喘ぎながらぐにゅぐにゅされる。満足したライクライクはダニエルを吐き出すために上へ膨らむ。「ぺっ」と共にダニエルをベトベトまみれにして吐き出す。\nライクライクは満足してどこかへ消えたが、ダニエルは顔を赤らめてベトベトまみれとぐるぐる目にされて倒れた。\n\nセリフや音類はあるとめっちゃ嬉しいです！\nダニエルの服装ですが、ピューロランドの普段のグリーティングの服装でお願いしたいのですが可能でしょうか？ライクライクのデザインは前回と同じでお願いします。\n初のコミックリクエストなのでとても楽しみにしてます！よろしくお願いします！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_busho/works/88", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2987324, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72639d81/uploads/origins/7d522698-ceee-4b00-9738-509eb22843e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b76faf57d6ff03649c7c85eebf9eb4d4", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72639d81/uploads/origins/7d522698-ceee-4b00-9738-509eb22843e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad3fbf84278a344166ca0b5fd69da4fe", "src_set": ""}, "body": "こんばんは。\nカイリューが3匹のゾロアを丸呑みしちゃうvore漫画をお願いします。\n\n・お腹をすかせたカイリューが3匹のゾロアを捕まえて丸呑み\n↓\n・カイリューはお腹がぱんぱんになって満足だがゾロア3匹はちょっと多すぎて苦しくなり1匹を口から吐いてしまう。\n↓\n・数時間後食べられた2匹のうちの1匹は消化を免れてベトベトになってそのままお尻から排泄（残る1匹はお腹の中に閉じ込められたまま）\n\n可能でしたら上記の内容でお願いいたします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_busho/works/87", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2987324, "client_id": 32548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad7307f0/uploads/origins/5bb7a6bf-b5a2-480d-98e1-58cf0b2d3083?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6be643f3953c8f8b185100f17758dc70", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad7307f0/uploads/origins/5bb7a6bf-b5a2-480d-98e1-58cf0b2d3083?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee8f51bf08b4221e78d036c75a8be586", "src_set": ""}, "body": "ビークインが蜘蛛の巣蜘蛛糸で捕まってる絵をお願いします！\n糸の質感はねばねばべとべと系で捕まって覆われて動けなくなっちゃってる様子をお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_busho/works/86", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d7e4b7dd/uploads/origins/3b42cbf7-952c-4d77-8ed3-47d0567d91d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6aaba85fbab516d6f7201dcbe1c430f4", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 2987324, "client_id": 2307848, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@k_busho/works/85", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6e8d542c/uploads/origins/baf86251-e49b-4ee2-bb99-27f00133840c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a83651b2de71c5021321207b0a64991b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2987324, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@k_busho/works/84", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2987324, "client_id": 1165153, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a00c97d9/uploads/origins/4c9098ec-f881-45b3-8583-75832d30e3bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cfc732c8e05a23f3f539611f0622256", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a00c97d9/uploads/origins/4c9098ec-f881-45b3-8583-75832d30e3bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d24f6bb8a6bb8789af6e3d8b542d244b", "src_set": ""}, "body": "こんにちは！あなたが描いたピーティ・ピラニア（ボスパックン）が好きなので、彼と一緒にアートをお願いしたいです！\n\n-----\n\n詳細\n\nレイは地面に座り、両手を広げてピーティに止めるよう必死に訴えている。ピーティはスカンクの前に立ち、口を開けて深呼吸している。\n\nそして突然、ピーティは茶色のグープをレイの体中に吐き出す。\n\n最後に、ピーティは口からグープを垂らしながらニヤリと笑う。レイは身震いし、グープまみれで気持ち悪いと感じる。しかし、レイは密かに赤面し、このすべてに飼いならされている。\n\n-----\n\n参考文献\n\nPetey Piranha (あなたの作品のようにぽっちゃりしてください)\nhttps://skeb.jp/@k_busho/works/72\nhttps://youtu.be/818L2DcbobM\n\nレイ\n(参考URL）\n\nhttps://www.dropbox.com/scl/fi/uj6d123xsf8u8hwrbsr47/Ray-Rhythmus-Reference-Sheet-SFW.png?rlkey=42un8gbq8vb3gbx30r4aa34ua&st=vwb4e30y&dl=0", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_busho/works/83", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2987324, "client_id": 1700639, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6845a42d/uploads/origins/e5f28fc5-48c8-408e-b536-72bc097cbcd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=787d4148c257c6afc067e9f4e59bdfee", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6845a42d/uploads/origins/e5f28fc5-48c8-408e-b536-72bc097cbcd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cee3139e739d980165434f3c4eb17705", "src_set": ""}, "body": "こんにちは！\nわたしのキャラクターの下水道スライムくんを描いてください！！\nhttps://x.com/hgprDragon/status/1922635131174425003\n\nブショカさんのネモちゃんが下水道スライムくんの身体の中で、運悪く取り込まれてしまったかわいそうな獲物に触手を絡めて可愛がっているシチュエーションをお願いします。\n下水道スライムの表情は、出来れば無邪気で嬉しそうな表情にしていただければと思います！\n\n補助的な情報で、以下のような設定があります。\n（必ずしも以下のシチュエーションに沿う必要はありません）\n\n・ニンゲン（※１）だ～いすき！！\n・液状にならない程度にちょっと固めな、ぷるぷるもっちもちな身体。\n・身体の成分は…特に設定なし。ご想像にお任せします。\n・とても人懐こい性格。好きな相手は抱きしめたいしナデナデしたいし頬ずりしたい。\n・自由に身体の大きさを変えられる。\n　＞2mくらいになってニンゲンを抱きしめてぬくもりを感じるのも好き\n　＞3mくらいになってニンゲンをおなかに取り込んで揉み潰して味わうのも好き\n　＞5m（2階建ての家）くらいの大きさになってニンゲンを撫でて優しく握りつぶすのも好き\n　＞極端に大きくなって、ドラゴンやビルを優しく抱きしめてうっとりするのも好き\n\n※１：人間というより、獣人でもドラゴンでも、意思疎通の出来る相手が好き。\n\nhttps://x.com/hgprDragon/status/1922635131174425003", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_busho/works/82", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5c683272/uploads/origins/b8a9974c-135d-42b2-bb7c-6c43538d1c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b3b70bdc7a25e18427023e4ef200d16", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2987324, "client_id": 2893946, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@k_busho/works/81", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2987324, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7de112f1/uploads/origins/b412718e-c263-49bf-8852-520c874e3e79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de954e7cc4e11798c58af79ce0f44aa3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7de112f1/uploads/origins/b412718e-c263-49bf-8852-520c874e3e79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ba0148ac30f24a20695783ce351617a", "src_set": ""}, "body": "先日はメルのイラストありがとうございました😊\n次も、メルのリクエストをお願いしてもいいですか？\n\n次は、ゼルダの伝説に出てくるライクライクに食べられてぐるぐる目とベトベトにされて吐き出されるメルをお願いします！\n\nメルがライクライクと知らずにライクライクに近づく。\nライクライクが口を伸ばす。\nメルを食べてライクライクが膨らむ。\n「ごっくん」という音とともにライクライクはメルを飲み込む。\nライクライクの脈打ちと共に体内の肉壁にぐにゅぐにゅされるメル。\nライクライクがメルを吐き出す。\n\nメルはぐるぐる目と全身ベトベトにされ、倒れる。\n音類や、体内のメルの様子があるととても嬉しいです！セリフなどはブショカ様にお任せします！\nライクライクのデザインは、64時代のゼルダやスマブラDXのアドベンチャーモードに出てくるものでお願いしたいです！\nよろしくお願いします🙇", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_busho/works/80", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2987324, "client_id": 2893946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aba2ea71/uploads/origins/8c0cf93d-6bd1-459a-8125-781bf3daa192?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c56bef603a0bf586bdc80dd813ff299", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aba2ea71/uploads/origins/8c0cf93d-6bd1-459a-8125-781bf3daa192?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22daa4777f212867e240527e109cb3fe", "src_set": ""}, "body": "こんにちは^^また依頼したいです^^。\n\n私のアイデアは、大きな猫きよペロンの手のひらに、私の小さなライチュウが乗っているというものです。\n猫きよペロンが大きな指の一本でライチュウのお腹をさすっているところを想像しています。\nその後、猫きよペロンがライチュウを大きく舐める（ライチュウは舐められるのを楽しんでいるようだ）。\n猫きよペロンはそれからライチュウの尻尾をそっとつかみ、ライチュウを舌の上に落とす。\nライチュウは猫きよペチュウの舌の上を滑り落ち、猫きよペチュウは面白そうにライチュウを見る。\n\nまた、猫きよペプロンの手と私の小さなライチュウのキャラクターとのインタラクションを描いていただけませんか？ 私は本当に猫きよペプロンの手が大好きなんです<3\n\nいつもありがとうございます！https://imgur.com/a/vJa9kAy。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_busho/works/79", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2987324, "client_id": 451368, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/daeb1990/uploads/origins/bbc81fc7-1fde-4466-ac5e-c9bb18bf786e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d38ccb19f1f906d17fd8c68f37881549", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/daeb1990/uploads/origins/bbc81fc7-1fde-4466-ac5e-c9bb18bf786e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78078d9831c6d47ca9b831901b80c9ac", "src_set": ""}, "body": "ボートに乗るをテーマにしたコミックを依頼したいのですが！             \nMOFUとDongが同じバナナボートに乗っているところ\n速い川でのカヌー（水しぶきを描写）\nカーブを曲がった先に小さな崖があるところ，彼らは急いで降りてきた\nRukrが目を覚まし、滝の下に水を飲む\n（口のアップがあるといいな）\nDongとMofuはそのままRukrの口に入\nRukrは何かを察知し、ボートとともに彼らを飲み込む。\n（あることを願っています2~3シーン、その過程を描写してほしい）。\n非常に困惑した表情でお腹をさするルック\n （ここで、大きな写真があればいいのに，Rukrの胃壁に包まれ、圧迫されているような感覚。\n\nこれがMofuの参考画像だ:https://drive.google.com/file/d/1lLR5Jv3Q_7XUiSgHhYz1OojFO38OZq_N/view?usp=drive_link\n\nこれがDongの参考画像だ:https://drive.google.com/file/d/1atiWGZV99aOVFrGhAzyori1_EXq8H2zx/view?usp=drive_link\n\nこれがRukrの参考画像だ:\nhttps://drive.google.com/file/d/1J7Oj-i2GF32p-p-z9yzRC4kFwyST1ywu/view?usp=drive_link\nhttps://drive.google.com/file/d/1eODaum3isjeE-NmYhVpWK3m_91JHU5Tf/view?usp=drive_link\n\nこれがボートに乗るの参考画像だ:https://drive.google.com/file/d/1uoY-NB3OJ74hNjDecDHWpr_0gHdtaPQM/view?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_busho/works/78", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2987324, "client_id": 2866341, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26a43813/uploads/origins/36e3a897-f80b-4d8b-aa1d-5078d37acab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4b2b820190a026e02894b303bdfd2dc", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26a43813/uploads/origins/36e3a897-f80b-4d8b-aa1d-5078d37acab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc1460c52eb3a7ea79d880ddcaa50e25", "src_set": ""}, "body": "こんにちは、Bibuと申します。\nvore漫画（2～3ページ）を依頼したいです。\n\n登場人物は3人：略してA、B、Cと呼びます。\nAはCの口から体内に入り、Cに丸呑みされます。\nその後、BはCの肛門に飲み込む、そして腸内でAと会う。\nAとBはCの体内でセックスし、3人同時に射精します。\n最後にAとBはCのお尻から排出される。\n\nキャラの資料はこちら：\nhttps://drive.google.com/drive/folders/1gL25amcWewzT9iniSywCGZFolpA715Dw?usp=drive_link", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_busho/works/77", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2987324, "client_id": 32548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b89eb36b/uploads/origins/6907baac-a3cd-4e5b-a8c2-30e1c90b4ef7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=321e3c111c9098a78f64684859827028", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b89eb36b/uploads/origins/6907baac-a3cd-4e5b-a8c2-30e1c90b4ef7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bf96a6ae85284d7ce3f530d4dceabf3", "src_set": ""}, "body": "いつもありがとうございます！\n今回はハハコモリが蜘蛛の巣蜘蛛糸で捕まってねばねばべとべとにされちゃってる絵をお願いします！\n今まで同様全身ネバネバ糸で捕まって覆われて動けなくなっちゃってる様子をお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_busho/works/76", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2987324, "client_id": 3231204, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fab9e067/uploads/origins/a996b703-c1d1-4484-8e5a-b7b382208f65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4b3feeff31c7674418e2fa35b568c15", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fab9e067/uploads/origins/a996b703-c1d1-4484-8e5a-b7b382208f65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e15a6abe4c470e7d7cc60f2dea82541", "src_set": ""}, "body": "こんにちは、私のシャチ（グレイシャー）が勢いよくコボルドのサムを舐めているアートをお願いします。グレイシャーはとてもドヤ顔で楽しそうにコボルドのサムを舐めています。サムはビクビクしているが、内心、こんなに激しく舐められるのを楽しんでいるかのように顔を赤らめている。二人とも水中にいて、サムの下半身は氷に覆われている。もし続きをお望みなら、氷河がとても満足そうな表情で泳ぎ去る一方、サムはお腹の中でぎゅっと抱きしめられている。どちらも参考にさせていただきます。ご検討ありがとうございました！\n\nhttps://drive.google.com/drive/folders/10aIHWMJeS0pVzNpslOMSW75dc22df71I?usp=sharing", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_busho/works/75", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2987324, "client_id": 1010849, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7cf1de6d/uploads/origins/c980cc90-c779-4fce-a90b-ad606ed2dca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e74df09cb16179d80205b51f99d75655", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7cf1de6d/uploads/origins/c980cc90-c779-4fce-a90b-ad606ed2dca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d93ca14a6fe88ce27ae5ebe7cf188d1", "src_set": ""}, "body": "ピカチュウが巨大なベトベトン(6メートルくらい)に捕まってしまい、舌に埋まってしまっているところをお願いします。\n\n【流れ】\nピカチュウは埋まっている舌から首から上と手だけが出ている状態で、身体が沈まないようにもがいて抵抗しています。\nベトベトンは舌を伸ばして、ピカチュウを見えるようにしています。\n↓\nベトベトンはピカチュウの様子を楽しみながら、口の奥から毒ガスを出してピカチュウを苦しめています。\n↓\nベトベトンは毒ガスで苦しんでいるピカチュウにギガドレインを使い、ピカチュウの体力をどんどん奪っています。\n↓\n体力を吸われ尽くしたピカチュウは完全に舌に沈んでしまい、ベトベトンは嬉しそうにしながら舌を口の中に戻します。\n\n以上です、よろしくお願い致します。", "nc": 160, "word_count": 0, "transcoder": "