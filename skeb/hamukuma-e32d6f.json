mat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=541a95a8ed728f36e3384f70ec4844c9", "srcset": "https://si.imgix.net/c468df1f/uploads/origins/b1e46e92-c390-40ef-a607-c401ffdc3253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=541a95a8ed728f36e3384f70ec4844c9, https://si.imgix.net/c468df1f/uploads/origins/b1e46e92-c390-40ef-a607-c401ffdc3253?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=926d2a8c493d1232b9e0a155c037e4f8 2x, https://si.imgix.net/c468df1f/uploads/origins/b1e46e92-c390-40ef-a607-c401ffdc3253?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d2cbe92589323966f97612549d8db82 3x"}, "body": "どうも！またサクラちゃんのリクエストを送らせていただきます…！\n\n・キャラ\nサクラ(FEHの温泉衣装)\n\n・シチュエーション\n温泉サクラちゃんは異界での役目を終え元の世界へと送還された、しかし送還された先は何故か賊の拠点であり、サクラちゃんはそこで慰み者にされてしまう…。\n\n・体位 構図 \n即堕ち2コマ的な構図で、上のコマに送還される直前のアスク王国で共に戦った仲間との別れを惜しむサクラちゃん、下のコマで賊の肉便器として使われているサクラちゃん…という感じでお願いします！\n犯されてる体位や服の敗れ具合などはお任せします。\n\nご検討よろしくお願いします！", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamukuma/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2646271, "client_id": 665317, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/865b26dc/uploads/origins/23cf684b-0d88-4921-8064-a9eecd1bcb7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5bb238c96db33006c4c598f23083883", "srcset": "https://si.imgix.net/865b26dc/uploads/origins/23cf684b-0d88-4921-8064-a9eecd1bcb7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5bb238c96db33006c4c598f23083883, https://si.imgix.net/865b26dc/uploads/origins/23cf684b-0d88-4921-8064-a9eecd1bcb7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a29ab884518984ee5a18e56efc0799c 2x, https://si.imgix.net/865b26dc/uploads/origins/23cf684b-0d88-4921-8064-a9eecd1bcb7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f4b8db46cfdb5beec8ca400cb4fed5f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/865b26dc/uploads/origins/23cf684b-0d88-4921-8064-a9eecd1bcb7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51ea0e432064ff02a9cad982e359681f", "srcset": "https://si.imgix.net/865b26dc/uploads/origins/23cf684b-0d88-4921-8064-a9eecd1bcb7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51ea0e432064ff02a9cad982e359681f, https://si.imgix.net/865b26dc/uploads/origins/23cf684b-0d88-4921-8064-a9eecd1bcb7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a9197fa5edffde3f6a2c73a172bcb32 2x, https://si.imgix.net/865b26dc/uploads/origins/23cf684b-0d88-4921-8064-a9eecd1bcb7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ae427381aa75dfa6696a0cb061a80359 3x"}, "body": "どうも、今回もハードですがまたサクラちゃんのリクエストを送らせていただきます！\n\n・キャラ\nサクラ(FEif)\n\n・シチュエーション\n暗夜18章のカムイ達がイズモ公国に立ち寄らなかったifでゾーラの勢力に捕えられたサクラちゃんは処刑時間までの退屈しのぎとして暗夜兵に犯される。\n\n・体位\n猿轡をされ腕を縛られた状態での立ちバック\nサクラちゃんが前から見えるカメラアングルでお願いします。カメラアングルのイメージとしては他の方の作品で恐縮ですがこちらの作品のように↓\nhttps://www.pixiv.net/artworks/69526265\n\n・服装\n今回も髪飾りとニーハイ以外は脱がされた裸でお願いします。\n\n・サクラちゃんの表情\n涙を流し苦しく辛そうな感じで\n\n・差分\n挿入前→挿入→ピストン→中出し→事後\nみたいな感じでお願いします。\n\n・細かい設定など\n竿役の暗夜兵は「どうせすぐ処刑されるし良いだろう」という考えでサクラちゃんを犯す。\nその場に居た他の暗夜兵は呆れながらも自慰を始める(実際に竿を描かれなくても台詞だけで大丈夫です)\n\n中出しまでした後、サクラちゃんの処刑の時間になり「なかなか楽しめたぜw」みたいな事を暗夜兵が喋り「白夜王族が処刑された事により白夜と暗夜の戦は終結した」みたいなテロップで締め……な感じで。\n台詞は意味さえ変わらなければはむくまさんの好きなようにアレンジしてください。\nサクラちゃんの台詞は猿轡をしているので呻き声みたいなのだけでお願いします。\nちなみに触れなくてもいいですがサクラちゃんが犯されてる時点で他の白夜王族の処刑は完了済みという設定。\n\n以上です、もし他に追加したい描写とかあったら追加してもらって構いません、ご検討よろしくお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamukuma/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2646271, "client_id": 665317, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29485b25/uploads/origins/dbd5dc23-12c5-4f92-8c11-87cebc0d40f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=682960e02bedfa9a5ca5d9f0fafa638e", "srcset": "https://si.imgix.net/29485b25/uploads/origins/dbd5dc23-12c5-4f92-8c11-87cebc0d40f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=682960e02bedfa9a5ca5d9f0fafa638e, https://si.imgix.net/29485b25/uploads/origins/dbd5dc23-12c5-4f92-8c11-87cebc0d40f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13d7bc12f5c44f57796173d73b6dbec2 2x, https://si.imgix.net/29485b25/uploads/origins/dbd5dc23-12c5-4f92-8c11-87cebc0d40f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19e9dc2bb226b6db38137247a7d82f35 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29485b25/uploads/origins/dbd5dc23-12c5-4f92-8c11-87cebc0d40f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ac39015c8c842b3a325e6bfcbf17035", "srcset": "https://si.imgix.net/29485b25/uploads/origins/dbd5dc23-12c5-4f92-8c11-87cebc0d40f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ac39015c8c842b3a325e6bfcbf17035, https://si.imgix.net/29485b25/uploads/origins/dbd5dc23-12c5-4f92-8c11-87cebc0d40f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=19a0927922aa96284fc7dd5c9591a1ec 2x, https://si.imgix.net/29485b25/uploads/origins/dbd5dc23-12c5-4f92-8c11-87cebc0d40f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f3a18272b92fa94cd17aea1c0709c095 3x"}, "body": "どうもです、またサクラちゃんのリクエストをさせていただきます！\n\n•キャラ\nサクラ(FEif)\n\n•シチュエーション\n暗夜軍に敗北したサクラちゃんは仲間の助命を条件に暗夜の肉便器として犯される、自らの身を犠牲にし仲間を守ったつもりが約束を反故にされてしま