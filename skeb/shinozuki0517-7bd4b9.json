も大丈夫です)\nどんなに遅くてもずっと待っていますので時間があったタイミングで描いて頂ければ幸いです✨🙇\n\n資料(Twitterに繋がっております)\nhttps://twitter.com/sazanami0114/status/1655522630185922562?t=_mQ5FWuzCh6eZPRToZiylQ&s=19\n\nhttps://twitter.com/sazanami0114/status/1655522630185922562?t=_mQ5FWuzCh6eZPRToZiylQ&s=19", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shinozuki0517/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 672378, "client_id": 2659801, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa88a5dc/uploads/origins/df6889a3-6c01-4b8e-bb69-aa27917d5e39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbc9acf65d890b2b9c85e1fffac9e6f6", "srcset": "https://si.imgix.net/aa88a5dc/uploads/origins/df6889a3-6c01-4b8e-bb69-aa27917d5e39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbc9acf65d890b2b9c85e1fffac9e6f6, https://si.imgix.net/aa88a5dc/uploads/origins/df6889a3-6c01-4b8e-bb69-aa27917d5e39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1fa98cde3a8659d7fc4160bfaecbb84 2x, https://si.imgix.net/aa88a5dc/uploads/origins/df6889a3-6c01-4b8e-bb69-aa27917d5e39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae81dc9a324278854c3e977c02a77b25 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa88a5dc/uploads/origins/df6889a3-6c01-4b8e-bb69-aa27917d5e39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=188fdfbff7f6d1e6bdafcbc5fdeb76fa", "srcset": "https://si.imgix.net/aa88a5dc/uploads/origins/df6889a3-6c01-4b8e-bb69-aa27917d5e39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=188fdfbff7f6d1e6bdafcbc5fdeb76fa, https://si.imgix.net/aa88a5dc/uploads/origins/df6889a3-6c01-4b8e-bb69-aa27917d5e39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&f