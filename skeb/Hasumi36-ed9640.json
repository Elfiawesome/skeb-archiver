-4f67-a861-c18f9f911fe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c3644fb72d6bb139e57649c60e1c19a", "srcset": "https://si.imgix.net/15a9ccd7/uploads/origins/1e55b4ea-dd93-4f67-a861-c18f9f911fe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c3644fb72d6bb139e57649c60e1c19a, https://si.imgix.net/15a9ccd7/uploads/origins/1e55b4ea-dd93-4f67-a861-c18f9f911fe4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=056fa3febfa4d6140f970574ba82329c 2x, https://si.imgix.net/15a9ccd7/uploads/origins/1e55b4ea-dd93-4f67-a861-c18f9f911fe4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98c0246ba9133c22f0472b71670375f0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15a9ccd7/uploads/origins/1e55b4ea-dd93-4f67-a861-c18f9f911fe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78d0c7bf9ad6e9b1cd3046802f9d0b83", "srcset": "https://si.imgix.net/15a9ccd7/uploads/origins/1e55b4ea-dd93-4f67-a861-c18f9f911fe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78d0c7bf9ad6e9b1cd3046802f9d0b83, https://si.imgix.net/15a9ccd7/uploads/origins/1e55b4ea-dd93-4f67-a861-c18f9f911fe4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c7b2d63069e2d856e502fbbd78451b7 2x, https://si.imgix.net/15a9ccd7/uploads/origins/1e55b4ea-dd93-4f67-a861-c18f9f911fe4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=89b029f14d869887183bd88b2ee0aef3 3x"}, "body": "はすみ様\n\n前回は夏らしい水着姿のチルノさんと大妖精さんをありがとうございました。\n先生にまた同じ２人を、セクシーでかわいい虎娘姿でリクエストしてもよろしいでしょうか？\n\n寅年も終盤なので、虎っぽい装いの二人をお願いしたく存じます。\nその際、水着やレオタードに虎耳や虎フード、ぶかぶかの着ぐるみ等を合わせた様な\n露出が多めだったり身体のラインが出たりする方向を希望致します。\n(例えば虎柄ビキニ姿の二人ですとか)\n\n構図やシチュエーション等は先生にお任せしたく存じます。\n(2人1枚の構図が大変でしたら2人が別のカットでも問題ございません)\n\n念の為２人の資料を記載させて頂きます。\nhttps://twitter.com/ARINOMI7/status/1549022259926695938\n　２人とも胸はぺたんこの無乳系のイメージを持っています。\n\nもしよろしければ、ご検討のほどお願い申し上げます。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hasumi36/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 172372, "client_id": 1063221, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f63aac59/uploads/origins/b626871b-e0ce-4d7d-badf-519f38fc2ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=add6bd569cd51b4f9403dded7e12b599", "srcset": "https://si.imgix.net/f63aac59/uploads/origins/b626871b-e0ce-4d7d-badf-519f38fc2ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=add6bd569cd51b4f9403dded7e12b599, https://si.imgix.net/f63aac59/uploads/origins/b626871b-e0ce-4d7d-badf-519f38fc2ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c47cf1ca0529f7b6b4255f15cb2390eb 2x, https://si.imgix.net/f63aac59/uploads/origins/b626871b-e0ce-4d7d-badf-519f38fc2ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49b7f1f0d766d36f8fc93397e827766f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f63aac59/uploads/origins/b626871b-e0ce-4d7d-badf-519f38fc2ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b2f34de81e122b504dc6973f4622881", "srcset": "https://si.imgix.net/f63aac59/uploads/origins/b626871b-e0ce-4d7d-badf-519f38fc2ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b2f34de81e122b504dc6973f4622881, https://si.imgix.net/f63aac59/uploads/origins/b626871b-e0ce-4d7d-badf-519f38fc2ccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c5c6431f0bb12dcb92a4507ed29e3c4c 2x, https://si.imgix.net/f63aac59/uploads/origins/b626871b-e0ce-4d7d-badf-519f38fc2ccf?bg=%23fff&auto=format%2Cc