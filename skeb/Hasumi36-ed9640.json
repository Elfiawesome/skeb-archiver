200&h=200&blur=200&s=7f8976aaa0e056da853a7a31c1a97136 3x"}, "body": "こんにちは、アークナイツの蜜蝋（ビーズワックス）とカーディガン（カーディガン）の百合をリクエストしたいです。\n\nビーズワックス - https://drive.google.com/drive/folders/1vi8CUECTZQ5oxrymY7zE35NvaoNYt7k2\nカーディガン (カーディ) - https://drive.google.com/drive/folders/1bj7fAuRMq2NkuHA6EHtXPGUWHwoe93oC\n\n二人はロマンチックに食べ物を与え合っている。\n\n参考例\n https://imgur.com/a/nD21Xec\n例文の中で、最後のものが私のお気に入りです。\n\n餌の選択はお任せします。蜜蝋に餌を与えるのはカーディガンにやってもらいたい。\n二人の親密さと親密さを強調してください。\n\nhttps://drive.google.com/drive/folders/1UIICDE4UxnDNLNbC-pBSLvb-fWsVOT18?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hasumi36/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 172372, "client_id": 347107, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9aa38744/uploads/origins/b8f842a5-34c1-4d9e-bea7-0c6e248e4a61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1a2cb7fde224f91fd1eea78777081e0", "srcset": "https://si.imgix.net/9aa38744/uploads/origins/b8f842a5-34c1-4d9e-bea7-0c6e248e4a61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1a2cb7fde224f91fd1eea78777081e0, https://si.imgix.net/9aa38744/uploads/origins/b8f842a5-34c1-4d9e-bea7-0c6e248e4a61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21b34afea15343a5d4e41dba55e55b53 2x, https://si.imgix.net/9aa38744/uploads/origins/b8f842a5-34c1-4d9e-bea7-0c6e248e4a61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd996e31486e0540285eba2fac2bf0a6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9aa38744/uploads/origins/b8f842a5-34c1-4d9e-bea7-0c6e248e4a61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9780f4e0f942cae7c91e0f60d4971722", "srcset": "https://si.imgix.net/9aa38744/uploads/origins/b8f842a5-34c1-4d9e-bea7-0c6e248e4a61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9780f4e0f942cae7c91e0f60d4971722, https://si.imgix.net/9aa38744/uploads/origins/b8f842a5-34c1-4d9e-bea7-0c6e248e4a61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=33f537b96dcef438e7f1627821870d0f 2x, https://si.imgix.net/9aa38744/uploads/origins/b8f842a5-34c1-4d9e-bea7-0c6e248e4a61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f33ccc59d26f839f7e4f5cfca4d6231 3x"}, "body": "以前依頼を受けてくださりありがとうございます。\nまたお願いしたく思います。\n\nキャラはプリンセスコネクトの覇瞳皇帝とペコリーヌ\n\n覇瞳皇帝（https://twitter.com/ShixiTake/status/1550059302249168897/photo/1）\nペコリーヌ（https://priconne-redive.jp/character/　美食殿）を参照ください。\n\n衣装は二人とも腰のくびれ位のハイレグの競泳水着でデザイン、配色はなんとなく公式衣装に近い感じで\n乳首が水着を押し上げる胸ぽち状態でお願いします。\n二人とも頭の装飾は無しでお願いします。\n\n構図は正面からで膝から上で大丈夫です。\nhttps://twitter.com/darumoon/status/1421738130625888257\nここすきの部分をお願いしたいです。\n二人並んだセクシーな感じのポーズでお願いします。\n\n可能であれば差分半脱ぎ競泳水着でお胸がポロリしている状態をお願いします。\n\n以上となりますがよろしくお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hasumi36/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 172372, "client_id": 2669965, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dfbfa85f/uploads/origins/13817bcc-9f31-4b81-986e-733e66b450f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=126efac1ed94daad7d2ee5966c2da33f", "srcset": "https://si.imgix.net/dfbfa85f/uploads/origins/13817bcc-9f31-4b81-986e-733e66b450f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=126efac1ed94daad7d2ee5966c2da33f, https://si.imgix.net/dfbfa85f/uploads/origins/13817bcc-9f31-4b81-986e-733e66b450f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf741368e3fb19c374de745ec3cf0e96 2x, https://si.imgix.net/dfbfa85f/uploads/origins/13817bcc-9f31-4b81-986e-733e66b450f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12e67c3df9a2fd30dbed9b1a25e45cbd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dfbfa85f/uploads/origins/13817bcc-9f31-4b81-986e-733e66b450f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58a540f461a43ddab6371b0be5fdb804", "srcset": "https://si.imgix.net/dfbfa85f/uploads/origins/13817bcc-9f31-4b81-986e-733e66b450f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58a540f461a43ddab6371b0be5fdb804, https://si.imgix.net/dfbfa85f/uploads/origins/13817bcc-9f31-4b81-986e-733e66b450f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=abde235820840e0042076de3a9ba177b 2x, https://si.imgix.net/dfbfa85f/uploads/origins/13817bcc-9f31-4b81-986e-733e66b450f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=60a2a255192d567afdfa3917c450ece1 3x"}, "body": "はすみさまこんにちは。\ntwitterでいつも作品を拝見しております！\n\n音律聯覚のキービジュアルの怪盗Wをリクエストします\nいつものいたずらっぽい笑顔だと嬉しいです。\n背景は無くても大丈夫です。構図やポーズはお任せいたします。\n\n音律聯覚のイベントを応援をしたいので、どこかで投稿していただけると嬉しいです（宛名不要。問題等ありましたらこちらは無視してください）\nもし可能でしたらプリントして飾りたいです（それ以外には使用いたしません。不可でしたらすみません）\n\n宜しくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hasumi36/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 172372, "client_id": 1078768, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc44c0d2/uploads/origins/2baa778f-ff25-4922-92f1-2a139b143dd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5705cff7bc146dc3d33d0cb079ef93c2", "srcset": "https://si.imgix.net/cc44c0d2/uploads/origins/2baa778f-ff25-4922-92f1-2a139b143dd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5