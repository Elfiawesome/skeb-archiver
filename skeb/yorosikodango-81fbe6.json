8-9d04-d53c2f89df3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcc360dda484627613ed8460dcfdc9c4", "srcset": "https://si.imgix.net/75c7a7ad/uploads/origins/c7142045-abbc-4ff8-9d04-d53c2f89df3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcc360dda484627613ed8460dcfdc9c4, https://si.imgix.net/75c7a7ad/uploads/origins/c7142045-abbc-4ff8-9d04-d53c2f89df3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2db307a44d0a3e306fc58aecbe292a5 2x, https://si.imgix.net/75c7a7ad/uploads/origins/c7142045-abbc-4ff8-9d04-d53c2f89df3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f66f0febee2f6562419301e41fa7252 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75c7a7ad/uploads/origins/c7142045-abbc-4ff8-9d04-d53c2f89df3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a1f9e2fcb47c9b64ff2553ec289384e", "srcset": "https://si.imgix.net/75c7a7ad/uploads/origins/c7142045-abbc-4ff8-9d04-d53c2f89df3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a1f9e2fcb47c9b64ff2553ec289384e, https://si.imgix.net/75c7a7ad/uploads/origins/c7142045-abbc-4ff8-9d04-d53c2f89df3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e5561ccf806a53b148f124e9841ce509 2x, https://si.imgix.net/75c7a7ad/uploads/origins/c7142045-abbc-4ff8-9d04-d53c2f89df3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a5b24127ea872bfe5cb91c4b4d736834 3x"}, "body": "いつもよろしこさんのイラスト楽しんでます。\n改めましてうちの子をこよなく愛するkaintsと申します。\nよろしこさんの絵でうちの子を見たいと思い依頼します。\n\n・依頼内容\n姫騎士アリスちゃんQOS浮気デート\nキャラ立ち絵みたいに観賞したいので背景無しと竿役無しの差分もpsd形式でお願いたいです。\n\nこちらのBBC浮気イラストの続き的なもの\nhttps://x.com/Kaints31/status/1821318812022837744\n\n・アリスちゃんキャラ設定\n勇者パーティの一員、快活で優しいお姫様\n勇者くんとは幼馴染みで異性として好き、自分のプロポーションに自信満々\n頭のミニチュア王冠は勇者くん作の大切なもの\n超チョロイン\n\n参考絵など\nhttps://drive.google.com/drive/u/1/folders/1_c6nOonEW_KF2s3yrOSaXZmc4WmKx2QS\n\n・ポーズや構図など\nよろしこさんのいつもの黒人魅了NTR絵みたいなもの希望\n服装もお任せしますがバイブorディルドinパンツ希望\n\n・シチュ\n魅了後浮気イチャラブデート\n\n・構成（参考程度に）\n『ビフォーやや暗転モノローグ』\n女性を堕落させることに特化した希少人種、BBC人\n黒い肌に逞しい肉体はそれだけで強力な魅了魔法に匹敵する。\n姫騎士アリスも例外ではなくかつての指名手配犯の雌として想い人に隠れて浮気を続けていた。\n\n『ビフォー』\n魅了(永続)にかかり続ける描写\n「ダメッ！街中で密着しないで！嬉しくて隠蔽魔法解けちゃうから・・・」\n「嬉しいならいいだろって・・・ッそうだけどぉ」\n「あ、あのね♡キスされたら♡魔法解けちゃうかも・・ね♡？」\n\n何かキスの描写を入れてくれると嬉しいです。\n\n『アフター』\n「魅了(永続)」と「QOS(永続)」にかかり続ける描写\n彼好みの衣装とタトゥーを纏った本当の姿のアリスが彼に愛を語る。\n台詞は素敵な彼とイチャラブの方向性でお任せします。\n・この姿ね、あなたに染められたって感じで好き\n・勇者くんはちょっと雄として弱そうだし、あなたが勇者だったらなあって\n頭のミニチュア王冠をティアラなどQOSモチーフのアクセに変更してください。\n\n以上、もしよければうちのアリスちゃんを描いて頂きけないでしょうか？\nどうかよろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yorosikodango/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3313432f/uploads/origins/e96a4bb5-5ca2-4214-b9c7-df9bbce53311?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7159c43c9cd86d93daf6a39c842331c6", "srcset": "https://si.imgix.net/3313432f/uploads/origins/e96a4bb5-5ca2-4214-b9c7-df9bbce53311?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7159c43c9cd86d93daf6a39c842331c6, https://si.imgix.net/3313432f/uploads/origins/e96a4bb5-5ca2-4214-b9c7-df9bbce53311?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cdda5a167814b91070a41c0260fa0615 2x, https://si.imgix.net/3313432f/uploads/origins/e96a4bb5-5ca2-4214-b9c7-df9bbce53311?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21d93