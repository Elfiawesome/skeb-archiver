duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d88947b/uploads/origins/254624d3-cdb0-4ab2-8e55-13d8e9bdd8e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0520fa760c6da270d03169112583a88b", "srcset": "https://si.imgix.net/6d88947b/uploads/origins/254624d3-cdb0-4ab2-8e55-13d8e9bdd8e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0520fa760c6da270d03169112583a88b, https://si.imgix.net/6d88947b/uploads/origins/254624d3-cdb0-4ab2-8e55-13d8e9bdd8e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0a481f93749deee86c7e66fa7b5b1a8 2x, https://si.imgix.net/6d88947b/uploads/origins/254624d3-cdb0-4ab2-8e55-13d8e9bdd8e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d2abbdffb20bcff4e662e2c297bb2085 3x"}, "body": "しもふみさんのOCのヘイミル・ロゥとドラネーちゃんが仲睦まじい様子を見てみたいです\n人物を主題として絵に占める割合を大きめに描いてくださると助かります。感覚としては以前描いていた\nhttps://fedibird.com/@tukinami_seika/115707189728326000\nこのイラスト程度に人物を明確に主題にしていただけると嬉しいです。背景や小物はそれほど描かなくてよいです。\n構図の指定は特に無いのですが、例えば一例としては、膝枕しつつ髪の毛を弄っているとかそんな感じとか？\n\n服装に関しては基本衣装をベースに描きやすいように改変してもらえればと思います。\n例としてドラネーちゃんのフェイスベールの有無とかヘイミル・ロゥの外套の袖の有無とかもどちらでもよいです。絵を描いていて邪魔だなと思えば外して、あった方が顔が良いなとか思えば付けちゃうとかそんな感じでよいと思います。\n\n結論としては\n・ヘイミル・ロゥとドラネーちゃんのとても仲睦まじい様子を主題とする。\n・諸々はお任せ！\nです。\n\nドラネーちゃんの資料\nhttps://drive.google.com/drive/folders/1QrXCvK3buB5FlQuXk0GIgzQLgwgMlee_?usp=sharing\nヘイミル・ロゥの資料\nhttps://drive.google.com/drive/folders/1BKCGT6-EMj_OaZL4_InH-gmFpIZfYOYy?usp=sharing\n今までに描いたへーちゃんのイラスト\nhttps://drive.google.com/drive/folders/10O5LKJbMSTdHSlZEy6kD9yA4nC8uzZ11?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukinami_s/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2906685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.im