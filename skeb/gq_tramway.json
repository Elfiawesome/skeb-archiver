 "total_appeals_count": 0, "received_works": [{"path": "/@gq_tramway/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 611370, "client_id": 74659, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6ee425d/uploads/origins/2fba37d7-494d-4275-af12-ab3d5b2f2a13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88c7a616c13ddb3618bc01b26f118a79", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f6ee425d/uploads/origins/2fba37d7-494d-4275-af12-ab3d5b2f2a13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66b10fc6f63dc37678218beddfe35427", "src_set": ""}, "body": "URLのバイクに跨ってる黒髪きつね娘さんを描いて頂ければと思います。\n小柄で、胸はかなり控え目です。笑顔が似合う癒し系です。ほのぼの。\n前回は通常等身だったので今回はSDで描いて欲しいです。\nデザインとしては荷物を積載してるバイクに跨ってこっちを向いて笑顔になってるやつです。\n構図が無理でなければ絶対領域が描写されてると嬉しいです。\nバイクはトライアンフのボンネビルT120というバイクでお願いします。\nhttps://drive.google.com/drive/folders/1I62Ou07pIc3YpLxwpgOQtmB9JpDfs74U?usp=sharing\n用途としてはアクキーにしてバイクのバッグに取り付けたり、小さいアクスタを作って旅先で一緒に写真を撮ったりしたいなと…\nもしよろしければ考えて頂ければと思います。\n\nhttps://drive.google.com/drive/folders/1Pq3mBZ6NhLm4RpxD4RZMFycTWtk0ycoX?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gq_tramway/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f3d4218a/uploads/origins/b6310a8b-3d17-4e80-9dc7-b50d3a78edc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd6d5c722d9c54f7ec932b08162f0332", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 611370, "client_id": 1693343, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder"