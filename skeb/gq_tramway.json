-44cd-ba0d-a69762a958cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bba046f562e0babde5c144d8910ef80f", "src_set": ""}, "body": "URLの黒髪きつね娘さんを描いて頂ければと思います。許可はとっております。\nちょっと小柄で、胸はかなり控え目です。笑顔が似合う癒し系です。ほのぼの。\nSDではなく通常に近い等身でお願いします。(SDも非常に好きなんですが今回は、ということで)\n服装はおまかせします。URLの制服でもいいですしカスタマイズしてもいいですし。あっもしマフラーを外すなら首輪を付けてほしい(\nシチュエーションとしては\n①2月くらいだしバレンタインということで、チョコを渡そうと照れてるやつ\n②最近寒いしオキシトシン足りてないので、照れつつも両手を広げてハグ待ちのポーズ\n③群鳩さんの好きなシチュ。季節感ガン無視でも大丈夫。好きに描こう！\nこれのどれかでお願いします。\n\n可能であれば笑顔や照れ表情などの差分があると非常に嬉しいです。\nおまかせが多くて申し訳ないですが考えて頂ければと。\n\nhttps://drive.google.com/drive/folders/1Pq3mBZ6NhLm4RpxD4RZMFycTWtk0ycoX?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gq_tramway/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 611370, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0112d2c7/uploads/origins/0b8af2a0-5903-469d-a216-6c2146d31231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72ad5e31c2131dc43d3ffefa41855007", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0112d2c7/uploads/origins/0b8af2a0-5903-469d-a216-6c2146d31231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56c7a0df3f790076e55a0866c96b628a", "src_set": ""}, "body": "群鳩電軌さん、あけましておめでとうございます。メンダコちゃん好きの者です。\n寒い時期が続きますね。メンダコちゃんも下半身がみずみずしいので寒そうだなと想像しています。\nところで、メンダコちゃんは制服のようなセーラー服を着ているシーンがあったので学校に通っているのかなと想像していますが、メンダコちゃんは椅子に座りますか？それとも椅子を使わず立って授業受けてたりするんでしょうか？体の構造的に椅子に座りづらそうだし椅子がぬるぬるになりそうだし、学校ではどうしているのかなと気になっていました！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gq_tramway/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 611370, "client_id": 726443, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51845d94/uploads/origins/6d87baec-548b-4c38-ae18-64b002996563?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=498f868f0e1229f9652f997a344410d1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51845d94/uploads/origins/6d87baec-548b-4c38-ae18-64b002996563?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ffb32e18e1c35d75760007df2873901", "src_set": ""}, "body": "こんにちは、うちのこイラストのリクエストです。\n\nうちのこ、えっちんのSDイラストをお願いします。\n資料URLの魔法少女衣装で、武器を構えたポーズで描いて欲しいです。\n衣装の装飾やデザインなどは省略、アレンジおまかせです。\nよろしくお願いします！\n\nhttps://twitter.com/_muika6/status/1730268372536062076", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gq_tramway/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 611370, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7db80c14/uploads/origins/92ad0f7d-027a-4798-87b1-66831b5f3c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efdd14c5825cde595994b6fc57a26a49", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7db80c14/uploads/origins/92ad0f7d-027a-4798-87b1-66831b5f3c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0150ea0cdca6b89ab2298a6687115e12", "src_set": ""}, "body": "前にメンダコちゃんをリクエストした、メンダコちゃんを応援する者です！メンダコちゃんの生態を知れば知るほどかわいさが増してきました。急いで走っても遅くて愛おしいですね。\nメンダコちゃんの生態をもっと知りたいので、新規リクエストさせていただきます！\n梯子もヌルヌル登れるということで、どうやって登るのかなぁと気になっています。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gq_tramway/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 611370, "client_id": 0, "vtt_url": n