ン/ヘッダー\n配信・動画内での使用/サムネイル\n\n【備考】\n三面図は下記リンク(googleドライブ)を参照してください。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1X0ihOJI5B8nqWbGHdwoWr9kbxoMm3x17?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@trn71n9/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2390013, "client_id": 1807319, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a745c8df/uploads/origins/e330eae2-da85-48d2-9fb4-6732ccb3bc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f99cb460a2cf450df935c84977851fef", "srcset": "https://si.imgix.net/a745c8df/uploads/origins/e330eae2-da85-48d2-9fb4-6732ccb3bc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f99cb460a2cf450df935c84977851fef, https://si.imgix.net/a745c8df/uploads/origins/e330eae2-da85-48d2-9fb4-6732ccb3bc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acf33701c80c2ec83871e361e70da4d1 2x, https://si.imgix.net/a745c8df/uploads/origins/e330eae2-da85-48d2-9fb4-6732ccb3bc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=617ef04216b8077f558067f5a0b9be4e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a745c8df/uploads/origins/e330eae2-da85-48d2-9fb4-6732ccb3bc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d653d0ccf37f5f357d3cb74f66eff31", "srcset": "https://si.imgix.net/a745c8df/uploads/origins/e330eae2-da85-48d2-9fb4-6732ccb3bc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d653d0ccf37f5f357d3cb74f66eff31, https://si.imgix.net/a745c8df/uploads/origins/e330eae2-da85-48d2-9fb4-6732ccb3bc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07845b12c1ff7c5724bce7f822086047 2x, https://si.imgix.net