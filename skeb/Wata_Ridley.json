cceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@Wata_Ridley/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 608191, "client_id": 3628223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad6502bb/uploads/origins/c51fbd57-84cc-405d-9ba6-8e4a3b4e9101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f91f02924f5921f767eeb43ba0ec77c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad6502bb/uploads/origins/c51fbd57-84cc-405d-9ba6-8e4a3b4e9101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42406349a8c1566cd8cceb5e58a84d1a", "src_set": ""}, "body": "こんにちは、あなたのメトロイドのアートワークが大好きです！\n\n私の好きなVTuberの一人がメトロイドプライムが大好きなんですが、メトロイドプライム1のヴァリアスーツを着た彼女のVTuberキャラをあなたのスタイルで描いてもらえますか？\n\nhttps://x.com/EepySleepyCh\nhttps://i.imgur.com/gOXvj6o.jpeg\nhttps://i.imgur.com/6BhY1Xa.jpeg\nhttps://i.imgur.com/Q9CqJGk.png\n\n彼女の名前はEepy Sleepy。とてもやんちゃでキュート。とがった耳とポニーテールに注目してください！\n\nYouTubeのサムネイルやTwitterのスケジュールに使いたいそうなので、SNS利用をお願いしたいです。\n\nよろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Wata_Ridley/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 608191, "client_id": 789311, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/14b5891e/uploads/origins/781432a2-b6eb-4aec-986c-c0f76811a6e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9b2f572e816876f7cdda6f741ea5695", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/14b5891e/uploads/origins/781432a2-b6eb-4aec-986c-c0f76811a6e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94a406e1ce562e61f0700cb58f9453be", "src_set": ""}, "body": "お世話になります。ルゼロスと申します。\nいつも素敵なイラスト、メトロイド同人誌、拝見させていただいております。\n現在、「メトロイドプライム　フェデレーションフォース」の攻略動画を制作しており、\nその動画に使用するサムネイルイラストの制作をお願いしたいです。\n\n【内容】\n・中央にメック1機　ポーズは正面に向かって走っている感じ\n・背景には爆発　周りには吹き飛んでるパイレーツ\n\nお忙しいところ恐縮ですが、査収の程よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Wata_Ridley/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 608191, "client_id": 365900, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f59749cb/uploads/origins/6c04f55e-070a-492e-9ebf-dd33cc775734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fa04a0f7595cff626f4471f57d653bf", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f59749cb/uploads/origins/6c04f55e-070a-492e-9ebf-dd33cc775734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a7bc203252577d96ab167fef4e4d1e0", "src_set": ""}, "body": "Skebではお久しぶりです。ツイッターでいつもりどりぃ先生の創作拝見して楽しませていただいています。\n\n今回は、りどりぃ先生に『サムスとカービィ』というお題でリクエストをお出しします。\n昔、スーファミの星のカービィ3にサムスがゲスト出演していたことがあったのでそれをイメージソースに、ストーリー制のある経緯があってサムスがポップスターにやってきたというショートショートをサムス視点で描いてほしいです。\n\n大まかには、スペースパイレーツが極秘に培養していた少数のメトロイドが辺境惑星に紛れ込み、その対処のためにサムスが飛んだのがなんだかファンシーな形状の星ポップスター。サムスは戸惑いながらもその星でピンクの現住生物と協力しメトロイドを撃退する…みたいなイメージです。\n奇妙な原住生物であるカービィを注意深く観察するなサムスのモノローグをりどりぃ先生の解釈で盛ってほしいです。\n\n最後は、ほかの生物を捕食し、コピーしてしまうカービィの能力を目の当たりにしたサムスが「もしかしてXなのではないのか？」と勘違いをしてしまうというオチで締めてください。\nサムスのシリアスさと、カービィのマイペースなほんわかさのギャップがある、コメディ系のノリでまとめてほしいです。\n\nご一考いただければ幸いです。\n\nPS.コミケも楽しみにしております。陰ながら応援しています。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Wata_Ridley/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 608191, "client_id": 2733946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dac371b3/uploads/origins/d4b9eecf-d0e7-42d2-8bd1-09b57f1f3bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f5adf25839a22ebcca56e290fd81ea8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dac371b3/uploads/origins/d4b9eecf-d0e7-42d2-8bd1-09b57f1f3bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9ea2ca85e8a1ef401e8067850656233", "src_set": ""}, "body": "はじめまして!\nYouTubeの配信用のサムネイルイラストを依頼したくご連絡しました\nご検討のほどよろしくお願いします\n\n@アカウント\nhttps://x.com/misaka_fire\n\n@依頼\n「御坂炎」がパワードスーツを来ているイラストをお願いしたいです\n全身絵でお願いしたく、またサムネイルは1920*1080で制作していますので\nこれらを考慮されたサイズ感だと嬉しいです。\nポーズやパワードスーツのバージョン等についてはおまかせします!\n※ 可能であればヘルメットあり・なしがあると嬉しいです\n※ アレンジなども自由にしていただいて構いません\n\nサムネイルで利用する際は該当配信・動画の概要欄に記載させていただきますmm", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Wata_Ridley/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b2da29ad/uploads/origins/00144277-ed27-4610-9f15-77eac2e9bb61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3adf9b558b89c1c7628842f2bedcc88f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 608191, "client_id": 460270, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Wata_Ridley/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 608191, "client_id": 365900, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f9ab1db/uploads/origins/f7a890be-e99d-457f-b660-01066cd734d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2de10cbb72691f83f366c5ad8cca73b6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f9ab1db/uploads/origins/f7a890be-e99d-457f-b660-01066cd734d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7f6234e29add0bc44ea3ded09ae2e04", "src_set": ""}, "body": "こんにちは。去年の冬コミでわたりどりぃ先生の本を拝見し大変楽しめました。\n是非、Skebでリクエストをさせて頂ければと思います。\n\nお願いしたいお題は『サムス・アラン……のコスプレをしたベヨネッタ』です。\nネタの内容のあらすじ・イメージとしては、（スマブラ時空で？）リドリーがサムスに戦いを挑みに出向いたものの、そこのいたのはサムス本人ではなく、サムスの格好をしたベヨネッタでリドリーが困惑してしまう……という感じです。\nベヨネッタは、原作内のコスチュームチェンジ要素でサムスのコスプレをするネタがあったので、その衣装です。\n\n絵としては、決めポーズを取っているサムスのコスプレをしたベヨネッタをメインに、小さいコマ割りでリドリーの導入シーンを添える形を想定しています。\n\n・導入コマ\n大乱闘に向かうリドリーが息巻いている\n「サムス・アラン！！　今日こそ地獄に叩き落としてやる！！」\n\n・メインイラスト\nしかし出てきたのはサムスのコスプレをしたベヨネッタ。\n決めポーズを取りながら、リドリーをおちょくる。\nベ「生憎だけど、そっちにはいいお友達が多くて顔が効くの。あんたこそ地獄のホームパーティに招待してあげるわ。ダンスは踊れるかしら？」\n困惑しながらツッコむリドリー\nリ「お前じゃねーよ！！　サムスをどこにやった！？？」\n\nセリフはフキダシで演出して漫画っぽくして欲しいです。\n話の流れ的には2～3コマ漫画っぽいイメージでしょうか。\nキャラクターの口調やセリフ回しについては、先生のご判断で適宜修正してください。\n（同人誌で『※漫画ではリドリーは普通に喋ります』と添え書きされていたシーンがツボでした）\n\n作画カロリー的に可能でしたら、画面済に本物のサムス（ゼロスーツ）のミニコマを添えて「風邪を引いてしまったので代理を頼んだ」とコミカルにオチを付ける要素を添えて欲しいです。\n\n※念のため、ベヨネッタ原作のサムスコスのスクリーンショットを資料URLに添えておきます。\n\nhttps://drive.google.com/drive/folders/1BoHGjw3v5QHO-4kk8OBAoJcLQNoldHN8", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Wata_Ridley/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 608191, "client_id": 1345415, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/02f4666e/uploads/origins/f8ed6e01-1c73-43ad-9707-f5ea180603e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2efef62fbd43a3ddf71d7c0688ccec1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {