mat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5335892f2096769abca7dcef4f605c18", "srcset": "https://si.imgix.net/ba573a4e/uploads/origins/001bfefc-1c23-4c95-8b76-453c3f2d374e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5335892f2096769abca7dcef4f605c18, https://si.imgix.net/ba573a4e/uploads/origins/001bfefc-1c23-4c95-8b76-453c3f2d374e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fbdd4b559dfc1cad6e06fd9c6faf444f 2x, https://si.imgix.net/ba573a4e/uploads/origins/001bfefc-1c23-4c95-8b76-453c3f2d374e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f205893f4e8919ad6c52c7d09e7d46c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba573a4e/uploads/origins/001bfefc-1c23-4c95-8b76-453c3f2d374e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54c038d13d97bdc4b168169578f2d599", "srcset": "https://si.imgix.net/ba573a4e/uploads/origins/001bfefc-1c23-4c95-8b76-453c3f2d374e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54c038d13d97bdc4b168169578f2d599, https://si.imgix.net/ba573a4e/uploads/origins/001bfefc-1c23-4c95-8b76-453c3f2d374e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c61829c2b109730b11e2dbd64986a30a 2x, https://si.imgix.net/ba573a4e/uploads/origins/001bfefc-1c23-4c95-8b76-453c3f2d374e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f1481bb92ba04647f491eddbadf015b8 3x"}, "body": "お世話になります\n\n●概要\nhttps://akira-yamagata.fanbox.cc/posts/3952788\n\nこちらのチャイナくんとお兄さんのセックスシーンを描いて下さい\n\n台詞や構図など、山形様のセンスで適宜に改変・追加して頂けると嬉しいです！\n\n●構図・流れ\n参照元イラストと同じ様に、お兄さんに抱き締められ乳首を弄られながら、立ちバックか四つん這いの後背位で後ろからガン突きされる感じ\n\nこれを基本として、下記の流れを差分にして下さい\n\n1.挿入\nゆっくりと挿入\nチャイナくんのチンポもムクムク\n\n「ハアハア…ママ…」\n「お兄さん拗らせ過ぎアル…でも、いいヨ…」\n「今夜だけ、ぼうやの妈妈(マーマ)になってアゲル…」\n\n2.腰振り\n激しく突くお兄さん\nチャイナくんのチャイナ服の前垂れに染みがじわり\n\n「ママっ❤️すきっ❤️孕んでっ❤️」\n「いいヨ…妈妈がぼうやの赤ちゃん産んでアゲル…」\n\n3.射精\n大量に種付けするお兄さん\nチャイナくんも激しく射精\n\n「でるっ❤️孕めっ❤️」\n「啊ッ❤️」\n\n4.余韻\n最後の一滴まで流し込むお兄さん\nチャイナくんのチャイナ服の前垂れにも大量のトコロテン白濁がぶちまけられ、べっとりと粘度の高い精液が前垂れの内側からボタボタと零れ垂れ落ちる(重要！！)\n\n「ママ…ママ…」\n「いい子…いい子…イッパイ出たネ…」\n「もっともっと妈妈に種付けして…可愛いぼうや…」\n\n●チャイナくん\n元イラストよりも肉付き良く、ぽっちゃりむちむち、母性たっぷりのメス男子にして下さい\n乳房の膨らみとお尻と腰回り、腹肉もかなり女性っぽくお願いします\n\n●お兄さん\n詳細な容姿描写は不要です\nかなり拗らせており、チャイナくんへの母性執着・孕ませ願望を口走ります", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Akira__Yamagata/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1687264, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff5c4939/uploads/origins/0a2dcf28-201e-4547-83cc-642a25ebf46b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6e0e949178d1871d2f2dde1ab55aea7", "srcset": "https://si.imgix.net/ff5c4939/uploads/origins/0a2dcf28-201e-4547-83cc-642a25ebf46b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6e0e949178d1871d2f2dde1ab55aea7, https://si.imgix.net/ff5c4939/uploads/origins/0a2dcf28-201e-4547-83cc-642a25ebf46b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=575eb8af7ed586b009eac5eb6747c142 2x, https://si.imgix.net/ff5c4939/uploads/origins/0a2dcf28-201e-4547-83cc-642a25ebf46b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99f37b27390c801c9cdd5962074650de 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff5c4939/uploads/origins/0a2dcf28-201e-4547-83cc-642a25ebf46b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1482ebb384e0a8a648f3885eead11a6a", "srcset": "https://si.imgix.net/ff5c4939/uploads/origins/0a2dcf28-201e-4547-83cc-642a25ebf46b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1482ebb384e0a8a648f3885eead1