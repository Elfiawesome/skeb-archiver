て\n・Misskey他SNSにて描いていただいた報告をする目的でのアップロード\n・非営利目的の個人観賞用のグッズ制作\n\nぜひご検討いただければと思います。よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wata_post0_/works/158", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1612326, "client_id": 2775133, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7bbccdd6/uploads/origins/80ce1799-988a-4cc7-bcbd-2a7a43480627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13d75ae7a268e1de71551a50121d2d69", "srcset": "https://si.imgix.net/7bbccdd6/uploads/origins/80ce1799-988a-4cc7-bcbd-2a7a43480627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13d75ae7a268e1de71551a50121d2d69, https://si.imgix.net/7bbccdd6/uploads/origins/80ce1799-988a-4cc7-bcbd-2a7a43480627?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=918a5f1c158b8fe7c783111a69a8d6fd 2x, https://si.imgix.net/7bbccdd6/uploads/origins/80ce1799-988a-4cc7-bcbd-2a7a43480627?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2f9d4b80a9f508dc685f8c9c2738b0b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7bbccdd6/uploads/origins/80ce1799-988a-4cc7-bcbd-2a7a43480627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc9ba8febb0afa7f2fff7a72e103899b", "srcset": "https://si.imgix.net/7bbccdd6/uploads/origins/80ce1799-988a-4cc7-bcbd-2a7a43480627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc9ba8febb0afa7f2fff7a72e103899b, https://si.imgix.net/7bbccdd6/uploads/origins/80ce1799-988a-4cc7-bcbd-2a7a43480627?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0fdb2b2e963dd2c0c991a2c023d450f6 2x, https://si.imgix.net/7bbccdd6/uploads/origins/80ce1799-988a-4cc7-bcbd-2a7a43480627?bg=%23fff