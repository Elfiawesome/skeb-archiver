at%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff841e150652b5e162a59bd0caac4ab2 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4af9c53/uploads/origins/8d8bebaf-9135-48c5-8b05-69f08bc0dfc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e011fb18f621dabf6bfab5f6be965f9", "srcset": "https://si.imgix.net/e4af9c53/uploads/origins/8d8bebaf-9135-48c5-8b05-69f08bc0dfc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e011fb18f621dabf6bfab5f6be965f9, https://si.imgix.net/e4af9c53/uploads/origins/8d8bebaf-9135-48c5-8b05-69f08bc0dfc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ba3ca5798c23c876c9f7c4aed89a4657 2x, https://si.imgix.net/e4af9c53/uploads/origins/8d8bebaf-9135-48c5-8b05-69f08bc0dfc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8c5e6d08596437072e9531437bee9109 3x"}, "body": "巨大な馬チ○ポ型のディルドでアへ顔アクメをキメる遊戯王OCGの《RAI-MEI》と《WW アイス・ベル》、《E・HERO バーストレディ》の三人をリクエストします。\n\nキャラの造形は\n・全員頭身高めのむちむち、股間の少し上に届き下半身が普通に見えるくらいの超乳\n・服装はカードと同じ物(RAI-MEIの全身の装飾はシンメトリーでお願いします)で乳首と乳輪は大きめかつ勃起してパフィーニップル状態の物が布地越しにくっきりと浮き出ている。\n・髪型はRAI-MEIが腰まで届く長さ途中で稲妻型の折れ曲がりがあり、太さのあるツインテール。\n・アイス・ベルの髪色は青色。\n・性格のイメージはそれぞれお好きなようにお願いします。\n\n三人が横並びしている姿(中央はRAI-MEI固定)を頭から太ももまで写し、以下のようなストーリーで台詞付きの差分を用意して欲しいです。\n\n挿入前。淫語混じりの嘘喘ぎや扇情的な表情など、いかにも余裕のある態度でこちらを挑発しながら、二人でマスターに自分達の痴態を見てもらうよう声を掛ける。また三人それぞれの斜め手前に馬ぺニス型の巨大なディルドが置かれている。\n↓\n挿入時。全員立ったままの姿勢から軽く腰を降ろしてディルドを挿入し、その衝撃で間抜けな叫び声を上げ即堕ちアへ顔アクメを晒す。\n↓\n挿入後。激しく腰を振りながらディルドのピストンにより軽めのアへ顔でオホ声混じりの淫語を連発しよがっている。\n↓\n同時絶頂。ディルドが根本まで完全に挿入され汚い口調で淫語を絶叫しながらイき、思い切り白目を剥いたここ一番の変顔に片足突っ込んだアへ顔になる。\n\nよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1JTPfY698ve9fO6-JxjxkgncH_mtg6dvP", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shan_shan_net/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 327173, "client_id": 2370346, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ace98e33/uploads/origins/05af11f9-b0aa-4e9d-a714-b8329b449472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b32a130d3f95bd2c502d56bceefdb0c", "srcset": "https://si.imgix.net/ace98e33/uploads/origins/05af11f9-b0aa-4e9d-a714-b8329b449472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b32a130d3f95bd2c502d56bceefdb0c, https://si.imgix.net/ace98e33/uploads/origins/05af11f9-b0aa-4e9d-a714-b8329b449472?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f368199df0a1ab7524b2f1bef38f8874 2x, https://si.imgix.net/ace98e33/uploads/origins/05af11f9-b0aa-4e9d-a714-b8329b449472?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8ffb8f1dee8b7522a25fefb793a1988 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ace98e33/uploads/origins/05af11f9-b0aa-4e9d-a714-b8329b449472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9849e46d7d92515267240c4bde94924b", "srcset": "https://si.imgix.net/ace98e33/uploads/origins/05af11f9-b0aa-4e9d-a714-b8329b449472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9849e46d7d92515267240c4bde94924b, https://si.imgix.net/ace98e33/uploads/origins/05af11f9-b0aa-4e9d-a714-b8329b449472?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=de808f086be0649c391c8715b9d4bf57 2x, https://si.imgix.net/ace98e33/uploads/origins/05af11f9-b0aa-4e9d-a714-b8329b449472?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=47c5a23f89b122c25eec9ad6571e7864 3x"}, "body": "こんにちは！首の挿げ替えのイラストをお願いします。\nあらすじ：原神のナヒーダが森の中で首から下を中年男の身体に挿げ替え、オナニーを楽しんだところをニィロウに見られる。そして、ニィロウと一緒に孕ませセックスしたり、ナヒーダの元の身体に挿げ替え中出ししまくる。\n挿げ替える男の身体は、40代後半で身長170cmほど、体重150kgぐらいで太り気味。チンポは長さ30cmの巨根、玉も大きく絶倫。1回に100mlの精液を射精して、10回以上セックスできる体力がある。\nこの身体はナヒーダが作った人形みたいなもので、人のいないところで挿げ替えて遊んでるという設定です。\n①ナヒーダが自分の首を挿げ替えるシーン。\nナヒーダは直立している首なし男ボディ（首なしでも生きており、我慢汁を流しながら勃起してる、首断面に草元素のマークが書いてある）を持ってくる。ナヒーダは男ボディの玉袋を握ると、反応して少し射精する。\n②次にナヒーダは自分の首元で円状になぞり、首元が光ると頭を持ち上げて首を外す。（ナヒーダの首なしボディは生きており、首の断面が草元素マークが描かれており、興奮して愛液を垂らしてる）ナヒーダは自分の頭を男ボディの首元に持っていくと、首元の光が消え挿げ替えられる。挿げ替前と後の全身絵をお願いします。首には縫合跡を付けてください。\n③ナヒーダはくっついた男ボディの手足を動かして確認する。すると、男ボディのチンコが徐々に勃起し始める。ナヒーダは手コキし始め、精液を吐き出し賢者モードになる。\n④影でその一部始終を見ていたニィロウに気づいたナヒーダ。ナヒーダは驚き取り繕うとしたが、ニィロウはナヒーダが好きと告白しナヒーダのチンポをおっぱいで挟む。そのままパイズリをしてナヒーダはニィロウに顔射する。ニィロウは自分の顔に着いた精液を舐めてナヒーダとキスする。\n⑤2人はダブルベッドに行き正常位でセックスする。ナヒーダはニィロウのおっぱいを揉みながら腰を突き、ボテ腹になるほど射精する。⑥ナヒーダはニィロウの首元をなぞりニィロウの首を外す。そして元自分の体にニィロウの首をくっつける。そして2回戦がはじまり、今度は騎乗位でニィロウがピストン運動してボテ腹になるほど中出しされる。\nセックスシーンは中だし前と後の差分をください。中出し後は着床する様子をお願いします。\n修正は黒海苔でお願いします。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shan_shan_net/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 327173, "client_id": 507009, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ddb2c1aa/uploads/origins/98146089-f1fd-4a1b-a26f-5d06587b1ba9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ccae848623e5127345b89f655af100e", "srcset": "https://si.imgix.net/ddb2c1aa/uploads/origins/98146089-f1fd-4a1b-a26f-5d06587b1ba9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ccae848623e5127345b89f655af100e, https://si.imgix.net/ddb2c1aa/uploads/origins/98146089-f1fd-4a1b-a26f-5d06587b1ba9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4ed5edbcf89c452218176a3c99090d6 2x, https://si.imgix.net/ddb2c1aa/uploads/origins/98146089-f1fd-4a1b-a26f-5d06587b1ba9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f37ec81c3b70aedb9fabe953baf3d80 3x"}, "duration": null, "nsfw": true, "hardcore"