f&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da66f06b6bce04b8a0759115063dfdfd 2x, https://si.imgix.net/f681f573/uploads/origins/d6d75eb0-665a-4041-adc1-3b771945947d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34be3876f3d8395ba0c739af9b6c2762 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f681f573/uploads/origins/d6d75eb0-665a-4041-adc1-3b771945947d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d5bfb74631f9382efde522c1cad651d", "srcset": "https://si.imgix.net/f681f573/uploads/origins/d6d75eb0-665a-4041-adc1-3b771945947d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d5bfb74631f9382efde522c1cad651d, https://si.imgix.net/f681f573/uploads/origins/d6d75eb0-665a-4041-adc1-3b771945947d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=867bca5f0254f892aa1d5bb6fbbf53d2 2x, https://si.imgix.net/f681f573/uploads/origins/d6d75eb0-665a-4041-adc1-3b771945947d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=18a52946054b9577030c11ab1498a1ee 3x"}, "body": "いつも素敵なイラスト拝見しています！\n依頼を受け付けていらっしゃったので、ぜひご依頼をさせて頂きたくご連絡しました！\nイラストをお願いしたいです。絵柄がとても好きなので、ぜひ描いていただきたいです！\n\n茶髪ロングヘアで少しプリン、レイヤーカットをザクザクでお願いします！内巻きで！前髪は右2:左8くらいでぱっつんに分けていただけると幸いです🙇‍♀️\n> <みたいな顔で両手ピースして欲しいです、目にまつ毛が少しあると嬉しいです！平行寄りのつり目でお願いします！\n服装はカッターシャツ、プリーツのチェック柄のミニスカートの制服姿で、黄色のネクタイを着けて欲しいです！\n靴下は黒のニーハイで、靴は黒の厚底ローファーでお願いします！\nその他構図はお任せしたいです🙇‍♀️🙇‍♀️\n何卒よろしくお願いいたします！", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Y3LL0WKN1F3/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4062484, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b3954f0/uploads/origins/e8fb49ec-6742-4e3f-bddf-765f4c446b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5212f619998a791d3388ea58150d121", "srcset": "https://si.imgix.net/2b3954f0/uploads/origins/e8fb49ec-6742-4e3f-bddf-765f4c446b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5212f619998a791d3388ea58150d121, https://si.imgix.net/2b3954f0/uploads/origins/e8fb49ec-6742-4e3f-bddf-765f4c446b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3257beafdb1d61b650a813e1e36bb861 2x, https://si.imgix.net/2b3954f0/uploads/origins/e8fb49ec-6742-4e3f-bddf-765f4c446b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69d7e18e9d44367232a1b8d79cc22b74 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b3954f0/uploads/origins/e8fb49ec-6742-4e3f-bddf-765f4c446b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5deafe2ccc5034ae7998da0d76037901", "srcset": "https://si.imgix.net/2b3954f0/uploads/origins/e8fb49ec-6742-4e3f-bddf-765f4c446b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5deafe2ccc5034ae7998da0d76037901, https://si.imgix.net/2b3954f0/uploads/origins/e8fb49ec-6742-4e3f-bddf-765f4c446b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=19dedbe364e62655054d23712da87c3a 2x, https://si.imgix.net/2b3954f0/uploads/origins/e8fb49ec-6742-4e3f-bddf-765f4c446b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b0c57df5c656b664ecc1b9dc76783c2f 3x"}, "body": "突然のご連絡失礼いたします。\n以前から先生の作品を拝見しており、緩急のあるカッコいいタッチや、キャラクターの鋭さ・躍動感を感じる表現がとても素敵だなと思っていました。\n\n今回、OCを描いていただきたく、依頼を検討しています。\n\n容姿はミナミイワトビペンギン(Eudyptes chrysocome)がモチーフとして取り入れられています。\n彼は成人男性で、かなりトゲのある不愛想な性格をしています。 \n一方で、内面にはかなり強い愛着欲求や寂しさを抱えており、「人に近づいてほしいのに、近づかれると拒絶してしまう」という矛盾を持ったキャラクターです。\n自分の弱さや感情を言葉にすることが苦手で、苛立ちや自己嫌悪を自分自身へ向けてしまうところがあります。\nそのため、腕には自傷による傷があり、手首にはそれを抑えようとした意味合いもあるタトゥーが入っています。\nただ、本人は傷つくことを美化しているわけではなく、自分を守ろうとしているのに、結局うまく自分を守れないという未熟さや痛々しさを持った子です。\n\nそのため、イラストでは、彼の\n✦鋭くトゲトゲした雰囲気\n✦幼さの残る顔立ち\n✦バチバチした長いまつ毛\n✦成人男性としては比較的小柄な体格\n✦腕の傷\n✦荒々しさや攻撃性\n✦脆さ、幼さ、愛着への飢え\n\nあたりを感じられるものにしていただけたら嬉しいです。\n\nまた、バイオレンスな表現ともとても相性が良いと感じているため、もし可能でしたら、傷や流血を含む痛々しい・暴力的な雰囲気の表現もお願いできればと思っております。\n\nお手数おかけしますが、描写範囲含め、構図やシチュエーションについては完全にお任せしたいです。\n\n商用利用の予定はなく、個人の範囲で使用させていただく予定です。\n\nまた、上記の中で表現が難しいものや、ご負担になりそうな内容がございましたら、無理にすべて取り入れていただかなくても大丈夫です。\n描きやすい範囲・形に調整していただければ嬉しいです。\n\n初めてのご依頼というのもあり、稚拙な文章になってしまい申し訳ございません。\n金額不足、不備等ございましたら、キャンセル・再送要請をしていただけますと幸いです。\n\nお忙しいところ恐縮ですが、依頼のご検討の程、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1adoig9lwuVd5NLA5XNTFleuBxlf-AMzR", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 766695, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "IZ（あいぜっと）@『Witch's Heart』の中の人。", "screen_name": "blueiziz", "avatar_url": "https://pbs.twimg.com/profile_images/1704769743725666304/1Cf7deKu.png", "header_url": "https://pbs.twimg.com/profile_banners/962013116765675521/1734268894/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 808256, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "黒川くろ✧︎*", "screen_name": "hana_kuro3", "avatar_url": "https://pbs.twimg.com/profile_images/1745751910509051904/9m3EHwWT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1152547594658172928/1685520980/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 65, "skills": [{"genre": "art"}, {"genre": "correct