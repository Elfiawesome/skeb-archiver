mage", "creator_acceptable_same_genre": true}, {"path": "/@watabosi_28/works/60", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2130388, "client_id": 3085558, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af0b8d2f/uploads/origins/b755fcdd-8058-45ef-b798-4685ce5d45d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=528745e1598be395074d2b06ca4e821d", "srcset": "https://si.imgix.net/af0b8d2f/uploads/origins/b755fcdd-8058-45ef-b798-4685ce5d45d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=528745e1598be395074d2b06ca4e821d, https://si.imgix.net/af0b8d2f/uploads/origins/b755fcdd-8058-45ef-b798-4685ce5d45d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af87fb68c72af400c4919a12c6e4d491 2x, https://si.imgix.net/af0b8d2f/uploads/origins/b755fcdd-8058-45ef-b798-4685ce5d45d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=207b37d525801c8eb2b9c605affa0b51 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af0b8d2f/uploads/origins/b755fcdd-8058-45ef-b798-4685ce5d45d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b92f26f10bca0a9d0a2ca48b4975860", "srcset": "https://si.imgix.net/af0b8d2f/uploads/origins/b755fcdd-8058-45ef-b798-4685ce5d45d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b92f26f10bca0a9d0a2ca48b4975860, https://si.imgix.net/af0b8d2f/uploads/origins/b755fcdd-8058-45ef-b798-4685ce5d45d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a446135767e375e3b6bb090311052c15 2x, https://si.imgix.net/af0b8d2f/uploads/origins/b755fcdd-8058-45ef-b798-4685ce5d45d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f606940174fa26246892d271788e1d93 3x"}, "body": "初めまして！わたぼうしさんのイラストが好きで、今回初依頼いたします！\n\n描いて頂きたいのは、ベネチアの街並みと星空を背景にした、ゴンドラに乗るお嬢様とゴンドリエーレです。\n\n・お嬢様の服装は【ロマンチック・スタイル】https://wiki3.jp/dress-kaiga/page/18 で、金髪碧眼だと嬉しいです！\n腕まで伸びる白い手袋を着用。その手元に小さな日傘を添えるように置くことは可能でしょうか？\n髪形、帽子、ドレスの模様・装飾品などはイラストに映えるようにお任せいたします。\n夜なので軽い羽織物を着用してほしいです。イメージはお淑やかな女性です。\n・ゴンドリエーレの服装は伝統的な縞模様シャツと黒ズボンに帽子着用です。青年だと嬉しいです。\n\nゴンドラでの立ち位置はお嬢様が手前で座り、ゴンドリエーレが奥で立つ構図が望ましいですが、もっといい見せ方があれば（あくまでもお嬢様の方が主役です）そちらでも大丈夫です。\n水面は見えていると嬉しいです。入りきらないようでしたら大丈夫です。\n人物の仕草は星空を眺めているでも、お嬢様が紅茶を嗜んでいるでも、わたぼうしさんの技術にお任せします！\n\n背景のイメージは下記URLの星空の映っている写真ような、僅かな街の灯りと満天の星空をお願いします。\n\nPC背景にしたいと考えていますので、横描きだと嬉しいです。\n\n長くなりましたが、ご検討のほどよろしくお願い致します。\n\nhttps://www.gettyimages.co.jp/search/2/image-film?phrase=%E3%83%99%E3%83%8D%E3%83%81%E3%82%A2%20%E6%98%9F%E7%A9%BA&sort=mostpopular", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pinartroom/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2815368, "client_id": 3085558, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e1ddd28/uploads/origins/3087b452-b3cd-4b74-ab21-df62db1c00b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a3c0cd634d97f4c7689b833ec9b72b1", "srcset": "https://si.imgix.net/4e1ddd28/uploads/origins/3087b452-b3cd-4b74-ab21-df62db1c00b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a3c0cd634d97f4c7689b833ec9b72b1, https://si.imgix.net/4e1ddd28/uploads/origins/3087b452-b3cd-4b74-ab21-df62db1c00b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f72078671a6f1e6a929a11aedea6ca2c 2x, https://si.imgix.net/4e1ddd28/uploads/origins/3087b452-b3cd-4b74-ab21-df62db1c00b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbfcb9e8950bbccf403cce66932eff2c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e1ddd28/uploads/origins/3087b452-b