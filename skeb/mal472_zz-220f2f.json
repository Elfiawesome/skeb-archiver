VATE&s=8d5cb9291d8aba0de5d78cb3680e8380 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2675454, "nc": 160}, {"path": "/@mal472_zz/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2675454, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7621e30d/uploads/origins/5b871b86-f971-45c6-92c7-5ad46b038d02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57540e2917a69e604c24127ee06d736f", "srcset": "https://si.imgix.net/7621e30d/uploads/origins/5b871b86-f971-45c6-92c7-5ad46b038d02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57540e2917a69e604c24127ee06d736f, https://si.imgix.net/7621e30d/uploads/origins/5b871b86-f971-45c6-92c7-5ad46b038d02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c055e586a64f43420302a2b3d26ec1dd 2x, https://si.imgix.net/7621e30d/uploads/origins/5b871b86-f971-45c6-92c7-5ad46b038d02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45dc053667940e782100811ab09114b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7621e30d/uploads/origins/5b871b86-f971-45c6-92c7-5ad46b038d02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6675011996193f31e5c6ae3db331220f", "srcset": "https://si.imgix.net/7621e30d/uploads/origins/5b871b86-f971-45c6-92c7-5ad46b038d02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6675011996193f31e5c6ae3db331220f, https://si.imgix.net/7621e30d/uploads/origins/5b871b86-f971-45c6-92c7-5ad46b038d02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c5b93fd72f21903c142fb1c3807bebf 2x, https://si.imgix.net/7621e30d/uploads/origins/5b871b86-f971-45c6-92c7-5ad46b038d02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8a6febf7182f5dcafa51eec4dc53a9c9 3x"}, "body": "初めまして、ひっそりとまいろさんのジク北を楽しませて頂いておりますファンのひとりです。\nこの度、まいろさんのskebページを見つけてしまったので、よろしければ是非、ご依頼させて頂けましたら幸いです……！\n\nお題ですが、FGOより「葛飾北斎ちゃんに、スカサハ師匠（ランサー）のコスプレ」をさせたイラストをお願いできるでしょうか？\nまいろさんと言えばやはり北斎ちゃん。そんな訳で北斎ちゃんにて是非依頼をさせて頂きたく思い。また最近セタンタ絡みで、私の推しのスカサハ師匠も描いておられたことに衝撃と感激を受けたこともありまして、完全に個人的な趣味の衣装チェンジお題として投げさせて頂ければと存じました。\n\nそして、着せる「北斎ちゃん」につきましては……どちらが着るかはまいろさんにお任せしてもよろしいでしょうか？\nこれはどちらでもいいということではなく、どちらに着せるか決めかねた上でのお願いとなります……。\nもちろん、2人はそれぞれ別の個性、別のキャラクターを持った存在だと重々承知しています。\n仮に水着の北斎ちゃんが着れば得意気に、武芸者としての箔が付いたと着こなすとイメージが浮かびます。\n元の北斎ちゃんが着れば、「何で自分がこんな格好……」と水着の自分を意識しつつ多少の葛藤を抱くのではというイメージが出ます。\n（かと言って水着北斎ちゃんがジークフリートさん関連以外を着こなすのはどうなの？　という感情も湧いてしまいます……）\nそれぞれで違う感情、違うリアクションを取ると思ったからこそ、着る方をまいろさん自身に選んで頂き、その上で「まいろさんの思う北斎ちゃんのリアクション」として、描いて頂きたいと思った次第です。\n\nですので、表情や構図・ポーズなどについては、まいろさんのセンスをそのまま光らせて頂ければOKです！\n例に出したのとは全然別のリアクションになっても、むしろ期待通りとさえ考えてます！\n一応、コスプレ（衣装）がメインなので、衣装姿を拝める全身絵を拝ませて頂ければ非常にありがたく思います……。また、衣装の再臨段階としては、第二か第三かで自分でも迷っているので、こちらもお好きな方で描いて頂ければと思います！（これについては、やっぱり顔はちゃんと見たいなという気持ちですｗ）\n\n相当無茶な注文を振ったとは重々承知しております……ですが、それでもよろしければ是非とも、何卒よろしくお願いいたします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 8285, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "お湯うどん", "screen_name": "oh_you_udon", "avatar_url": "https://pbs.twimg.com/profile_images/944375451958390784/j8T8pf_y.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 28517, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Y2＠6/28 幽香オンリー 華激ノ宴５　香19 七輪大社　Skeb募集中&作業中", "screen_name": "Y2_sichirin", "avatar_url": "https://pbs.twimg.com/profile_images/206