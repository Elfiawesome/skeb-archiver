order=DESC&since=0&type=&start=80\nhttps://web.archive.org/web/20130327144836/http://www.tekepon.net/fsm/modules/imgbb/viewforum.php?forum=10&sortname=p.post_time&sortorder=DESC&since=0&type=&start=20\n\n2曲とも原曲に近い曲調で、後者のみピッチを-1下げた状態でアレンジしていただければと思います。\n完成した曲は是非midiと一緒に、サイト更新時に改めて素材として公開していただければ幸いです。\n\nこういった形式でのリクエストは初めてで、2曲同時のリクエストになるのも相まってどう送ればいいか迷いながら文章を打っているので、分かりづらい点が多々あるかもしれませんが宜しくお願いします。", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@tukito_moonwind/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": false, "creator_id": 1378991, "client_id": 77252, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1217268530216718336%2Fcfh5jnkH.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b70ae576df844ea081f7ef0664bc5ba", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1217268530216718336%2Fcfh5jnkH.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b70ae576df844ea081f7ef0664bc5ba, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1217268530216718336%2Fcfh5jnkH.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e78f42ee10231f14d520814a1eb8692 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1217268530216718336%2Fcfh5jnkH.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=543ba7eecb78d59d76c51d2f1ed65dda 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/7674dd8c-7fa7-4f2b-875f-207a3bf65e10?response-content-disposition=inline&Expires=1783016838&Signature=TkATYaBQMLcIeh~NZkc9uFuuFpuYLnqAf9s5i0HE7wSfwdJ2jxMg4QZ8289gLw0tcPHG1wo8XlTz-MlicF0xL5fYYlWvKRj2dT61zbMB8ugyzO5ct~eF-h9BPpEWRb0ZTvzZLe6o1hiuW2DsHhKHflllvgy0ljmYQHgb39oijPvnjzZjYC5q0z5TXjIWgSfAp8wxrxxZWprzn2A8lmrB6vw6XEjO6v2Ik