//si.imgix.net/6b6e357f/uploads/origins/6f58f8ad-e6a6-4c1a-8913-272ab62b8204?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0689544aa8f39af942b8832f79cb5d71, https://si.imgix.net/6b6e357f/uploads/origins/6f58f8ad-e6a6-4c1a-8913-272ab62b8204?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9b2aee4cca412fba23686624a231cccb 2x, https://si.imgix.net/6b6e357f/uploads/origins/6f58f8ad-e6a6-4c1a-8913-272ab62b8204?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=676a8becbc49ee384f4c1ae614f2e059 3x"}, "body": "蟹鳴さんはじめまして。\n蟹鳴さんの描く素敵なイラストが好きで、リクエスト失礼します。\n私のオリジナルキャラクターを描いていただきたいです。\n\n資料\nhttps://drive.google.com/drive/folders/1hRI_omQxP9j60ITJ6vMvtGXbzuLBcuJj\n\n特徴\n・外ハネ気味のウェーブボブ\n・ジト目\n・灰色の上着・ショートパンツ・ニーハイソックス\n・ネガティブなので満面の笑み！はあまりしないかも\n\nポーズ等は蟹鳴さんの好きなように描いていただきたいです。\n使用用途としては基本的に個人で観賞することになりますが、アイコンやヘッダー等にも使用したいと思っています。\n納品形式はお任せいたします。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1hRI_omQxP9j60ITJ6vMvtGXbzuLBcuJj", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaninaki2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3057614, "client_id": 3737425, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35809212/uploads/origins/7baf8f59-a88e-46ea-a0b6-83650ed764b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c346dcbde22ffe008853220c3caf623d", "srcset": "https://si.imgix.net/35809212/uploads/origins/7baf8f59-a88e-46ea-a0b6-83650ed764b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c346dcbde22ffe008853220c3caf623d, https://si.imgix.net/35809212/uploads/origins/7baf8f59-a88e-46ea-a0b6-83650ed764b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2033087f8e4200b2ecca38d9960ee765 2x, https://si.imgix.net/35809212/uploads/origins/7baf8f59-a88e-46ea-a0b6-83650ed764b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83cff3bb2ece8261bf9b9e766ef7dcd6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35809212/uploads/origins/7baf8f59-a88e-46ea-a0b6-83650ed764b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2e72c719cd8fc42bc4dbcb5d8a482da", "srcset": "https://si.imgix.net/35809212/uploads/origins/7baf8f59-a88e-46ea-a0b6-83650ed764b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2e72c719cd8fc42bc4dbcb5d8a482da, https://si.imgix.net/35809212/uploads/origins/7baf8f59-a88e-46ea-a0b6-83650ed764b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b8ffc7cb170f8f4897c2974c2ff60537 2x, https://si.imgix.net/35809212/uploads/origins/7baf8f59-a88e-46ea-a0b6-83650ed764b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=de52b031251b78c34ce5a99e30ec6191 3x"}, "body": "こんにちは。以前こちらで描いていただいたイラストがとんでもなくかわいかったので、再度リクエスト失礼いたします。\n\n前回同様、私のオリジナルキャラクターの「茗花 ひう(なばな ひう)」を描いていただきたいです。\n蟹鳴さんがいつも描いているようなかわいい系統の衣装が好みなので、蟹鳴さんの思うかわいい服を自由に着せてほしいです。\nスカートでもパンツでも、メイド服のようなコスプレっぽい衣装でも嬉しいです。\n一応、イメージカラーは黄色ですが、全くこだわりはないので他の色でも構いません。\n\n構図やポーズ、納品形式などすべてお任せいたします。\n\n用途は個人的に眺めてニッコニコする、です。\nそれから、私もその衣装のひうを描きたいと思っています。(その際には、リンクをのせる等、skebで描いてもらった衣装を参考にしているということがわかるようにします。)\n\nこちらが資料です。\n(髪型はバナナっぽい部分を描いていただければ、あとは簡略化していただいて問題ありません。)\n↓\nhttps://drive.google.com/drive/folders/1l_6peUzYP8UP7hS_bCNrhxPQBVY32nWH?usp=sharing\n\nよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaninaki2/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3057614, "client_id": 3737425, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f76afd1f/uploads/origins/d11c7c94-5444-4081-