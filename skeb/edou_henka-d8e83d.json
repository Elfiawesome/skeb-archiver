core": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7fe76e8a/uploads/origins/f611f527-bc0b-4db7-bc8e-871fe92e1a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c1ccb363ec8e568be2568cf2510a82f", "srcset": "https://si.imgix.net/7fe76e8a/uploads/origins/f611f527-bc0b-4db7-bc8e-871fe92e1a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c1ccb363ec8e568be2568cf2510a82f, https://si.imgix.net/7fe76e8a/uploads/origins/f611f527-bc0b-4db7-bc8e-871fe92e1a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=377d5645abc54e819d32ae5e24e9eece 2x, https://si.imgix.net/7fe76e8a/uploads/origins/f611f527-bc0b-4db7-bc8e-871fe92e1a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8bb78fbfed8abb43ebee2fdb74ce33dd 3x"}, "body": "お初にお目にかかります\n\n今回某ファンタジー14の自キャラの平面化をお願いします\n\n自キャラ資料\n[https://photos.app.goo.gl/hWhLafsT3qznU5wp9]\n(パンツは黒色で少し大人っぽい感じ)\n再現が難しい部分は簡略化してもかまいません。\n\nシチュエーションとしては敵との戦闘中に攻撃を食らって平面化。その後もてあそばれる的な感じでお願いします。\n\n\n不可とのことであれば却下しても構いません。\n\n以上よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@edou_henka/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 84103, "client_id": 248293, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2908dc05/uploads/origins/aab92986-ef45-45ea-b06a-9e349a5cd44d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bb29ed5c93731473eef9d6a6daa1809", "srcset": "https://si.imgix.net/2908dc05/uploads/origins/aab92986-ef45-45ea-b06a-9e349a5cd44d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bb29ed5c93731473eef9d6a6daa1809, https://si.imgix.net/2908dc05/uploads/origins/aab92986-ef45-45ea-b06a-9e349a5cd44d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=