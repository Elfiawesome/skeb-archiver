ter.jp/idol/cometik/hana.html　(公式プロフィール)\n衣装：イミット・イノセンシア　https://x.com/nil4lv2/status/1900205089400524859\n構図：前回は手のひらを上に、人に差し伸べるものでしたが、今回はこちらが空(太陽)視点で空(太陽)に向かって手のひらを下にして手を伸ばしているものをお願いします。\n要望：この羽那ちゃんは以前依頼させていただいた羽那ちゃんより少し大人っぽく、可愛くというより美しくお願いします。\n用途：SNSのアイコン・名刺(プロフィールカード)に使用します。\n\nご検討のほどよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@coxxco12/works/211", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7f9269c8/uploads/origins/6d81111b-2a8d-4a89-b16e-5678f73239af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5cdc2c57f085a940b97e735a2cb463e5", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1299176, "client_id": 342925, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@coxxco12/works/210", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2be696e8/uploads/origins/7d4cbbaa-6fa5-449a-bbba-9ee893e5d4ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=991a9f1602aff6190472855829cc694b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1299176, "client_id": 3524044, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@coxxco12/works/209", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/acf50852/uploads/origins/c7ef088e-273c-47b0-91cc-411cfd029332?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=