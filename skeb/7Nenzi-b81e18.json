無表情で、なぜか彼女自身はこの表現にかなり惹かれる。\n\n\n男性\n\n赤穂 準（あかほ じゅん）\n\n外見判断は人間年齢22歳くらい男性、身長185。\n口を開かなければその顔で女好きな顔だけど、口を開くと残念系男子のになるだけだ。\n\n他のはあなた好きなままに。女性の方は貧乳です。\nもし金額は少なら、調整してお願いします。\n\n「バレリーコ」\n女の子は、あるゲームのNPCです。毎日同じ音楽を聴け、ダンスします。でも、男子の方（プレーヤー）は特別のプレーヤーです。他のプレーヤーと違って、彼女と一緒踊る後、ただ情報を持ち帰りじゃなくて、毎日ここを戻り、彼女と話す。だんだん、女の子は「設定外」の言葉を言う…こんな感じ。\n\n\nバレリーコ：https://imgur.com/a/a6qe3oN", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@7Nenzi/works/55", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3009815, "client_id": 3032811, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81a369ec/uploads/origins/cbb4696f-5949-42fa-883a-3a0feee2ea9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42d3f1728b77e149583158524aa3f800", "srcset": "https://si.imgix.net/81a369ec/uploads/origins/cbb4696f-5949-42fa-883a-3a0feee2ea9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42d3f1728b77e149583158524aa3f800, https://si.imgix.net/81a369ec/uploads/origins/cbb4696f-5949-42fa-883a-3a0feee2ea9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6dceffc410e619a0a1b833741f7044c4 2x, https://si.imgix.net/81a369ec/uploads/origins/cbb4696f-5949-42fa-883a-3a0feee2ea9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=296e5e7c69d3557fc1e11c2a173c7306 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81a369ec/uploads/origins/cbb4696f-5949-42fa-883a-3a0feee2ea9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c927b02ea303abc2ae6fe2e0d7b67ed7", "srcset": "https://si.imgix.net/81a369ec/uploads/origins/cbb4696f-5949-42fa-883a-3a0feee2ea9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c927b02ea303abc2ae6fe2e0d7b67ed7, https://si.imgix.net/81a369ec/uploads/o