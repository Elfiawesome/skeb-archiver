p=top&w=200&h=200&blur=200&s=c4926b2468feda511c82ba3f660c4ff3 3x"}, "body": "こんにちは。アピールをありがとう私のOCを気に入っていただけてとても嬉しいです！\nあなたの絵の雰囲気と色使いがとても好きです！登場人物のストーリーがよく伝わってきます!\n\nこの2人のキャラクターを描いてもらえますか？\n\n世界設定は魔法と獣人のいるファンタジーの世界です。\n\n[キャラクターA］\n- 赤ずきんちゃん\n- 白銀の髪に紫の瞳\n- 17歳、身長168cm\n- 明るく、賢く、親切で優しい。\n- 花が好きで、植物に詳しく、ハーブの知識が豊富。\n- オオカミさんを助ける\n\n[キャラクターB］\n- オオカミさん\n- 赤毛、金色の瞳\n- 半獣人、狼の耳と尻尾を持つ\n- 20代、身長190cm\n- ハンサムで力持ち\n- 体格：筋肉質\n- 赤ずきんちゃんに助けられ、彼女を永遠に守ると誓った。\n- 冷淡で寡黙、他人に無関心。\n\nすべてお任せします。衣装のアレンジはご自由にどうぞ。\n\npsdファイルにはキャラクターのみのレイヤーがあると嬉しいです。できればサインなしも！\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1GWpVjg6JirreQqXU1FJ0w3yUQorJXThe", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@7Nenzi/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3009815, "client_id": 3173637, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1857dfdc/uploads/origins/4e3c1dc2-aa7e-4119-8617-c3f696714e46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6165ce441b762c4a0747024c309b5ac4", "srcset": "https://si.imgix.net/1857dfdc/uploads/origins/4e3c1dc2-aa7e-4119-8617-c3f696714e46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6165ce441b762c4a0747024c309b5ac4, https://si.imgix.net/1857dfdc/uploads/origins/4e3c1dc2-aa7e-4119-8617-c3f696714e46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf86dbeadf9188c668d741289bb33600 2x, https://si.imgix.net/1857dfdc/uploads/origins/4e3c1dc2-aa7e-4119-8617-c3f696714e46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b229394f9d3f9a4596a61a6ed07c9e0d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1857dfdc/uploads/origins/4e3c1dc2-aa7e-4119-8617-c3f696714e46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d8a845933