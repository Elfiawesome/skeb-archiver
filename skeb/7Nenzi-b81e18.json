 https://si.imgix.net/8387642e/uploads/origins/42535c7a-5a08-4811-b920-8aa20a300767?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6bc8168ad3d34509195c3b081e555ea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8387642e/uploads/origins/42535c7a-5a08-4811-b920-8aa20a300767?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2ee1a1a83197dd900b9f4c4dbecbfad", "srcset": "https://si.imgix.net/8387642e/uploads/origins/42535c7a-5a08-4811-b920-8aa20a300767?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2ee1a1a83197dd900b9f4c4dbecbfad, https://si.imgix.net/8387642e/uploads/origins/42535c7a-5a08-4811-b920-8aa20a300767?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4678085ffe69be5dfaff1c5535d6e884 2x, https://si.imgix.net/8387642e/uploads/origins/42535c7a-5a08-4811-b920-8aa20a300767?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a9ffc04e628554eeaadd3b2c797c944b 3x"}, "body": "Hello! I love your artworks so much, and thank you so much for liking them! Would you like to accept this skeb request to draw these two TRPG PCs?\n\nThey are two adventurers who travels around the world, while Hyacinthie (the girl with a blue eyeball) is an archaeologist, and Freia (the person with red eyes) is a bard. They are really close friends that treats each other like they are a real family, thus are willing to sacrifice themselves because they love this world and cares about each other more than anything.\n\nFor some key elements when you are making this illustration, it’s “dandelion”, “star”, “hyacinth (the flower)” and “musical notes”. Thank you so much again for reading this request!\n\n\nhttps://drive.google.com/drive/folders/13OykkBO1DZrP0kT0fslPxvpfxRBaGKIw", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@7Nenzi/works/52", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3009815, "client_id": 2403555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e3ceca0/uploads/origins/c3ec65fa-c50d-4026-be7d-63e07b0115d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c1495d9f2c6f19e80fd93534b7c0435", "srcset": "https://si.imgix.net/6e3ceca0/uploads/origins/c3ec65fa-c50d-4026-be7d-63e07b0115d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c1495d9f2c6f19e80fd93534b7c0435, https://si.imgix.net/6e3ceca0/uploads/origins/c3ec65fa-c50d-4026-be7d-63e07b0115d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7a6e2138cbe5ca8f4f6ee3aa6a7f23a 2x, https://si.imgix.net/6e3ceca0/uploads/origins/c3ec65fa-c50d-4026-be7d-63e07b0115d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d90ef48b53a664a5b6c44c1043e2faf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e3ceca0/uploads/origins/c3ec65fa-c50d-4026-be7d-63e07b0115d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d156e5ffcb55e7fac2a3fac826a4ed5", "srcset": "https://si.imgix.net/6e3ceca0/uploads/origins/c3ec65fa-c50d-4026-be7d-63e07b0115d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d156e5ffcb55e7fac2a3fac826a4ed5, https://si.imgix.net/6e3ceca0/uploads/origins/c3ec65fa-c50d-4026-be7d-63e07b0115d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6cf7bd11d715af43704eaab558f64141 2x, https://si.imgix.net/6e3ceca0/uploads/origins/c3ec65fa-c50d-4026-be7d-63e07b0115d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8f2d03ade47acde1983af349bab5e1fa 3x"}, "body": "いつも素敵なイラストありがとうございます！前回も格好良く描いて頂いてハチャメチャに気に入ってます。\nキャンペーン滑り込み失礼します。間に合え…！\n\n実は、前回の2人でまた見てみたいもあるし、折角なら別のキャラクターも見てみたいしで迷っているので、お好きな方を選んで頂けたらと思います…！\n\n【案１】\nhttps://skeb.jp/@7Nenzi/works/36 と同じ2人組で、前回は敵対でしたが今回は四天王（のうちの半分ですが）として勇者の前に共に立ちはだかっている、というものをお願いしたいです。こちらの2人の方が圧倒的な感じでお願いしたいです。\n\n【案２】\n3名をお願いしたいです。赤髪が主人公で、狼、教会、夜、墓、月、仮面等がイメージのキャラクターです。\nこちらについてはシチュエーションお任せでお願いしたいと思っています。\n\n■利用用途\n個人観賞用です。\n他、BlueSkyでのアイコン・ヘッダー利用をする場合があります。\n\n以上、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1tFfowd5pX0k_mvI7gyVtV8nF2iMF0PEl?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@7Nenzi/works/51", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9d4761ab/uploads/origins/28e19811-8685-45a9-b1c7-19fc14d1c015?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d8e9e4a9cf2b97d4d55ccd52a31d4a0", "srcset": "https://si.imgix.net/9d4761ab/uploads/origins/28e19811-8685-45a9-b1c7-19fc14d1c015?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d8e9e4a9cf2b97d4d55ccd52a31d4a0, https://si.imgix.net/9d4761ab/uploads/origins/28e19811-8685-45a9-b1c7-19fc14d1c015?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13e2e4740a94654b6e78790fc5a3e22e 2x, https://si.imgix.net/9d4761ab/uploads/origins/28e19811-8685-45a9-b1c7-19fc14d1c015?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d46dbaa1fda2800a1a9a5dbfdb8355cb 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 3009815, "client_id": 2267225, "nc": 144}, {"path": "/@7Nenzi/works/50", "private_thumbnail_image_urls": null, "