に住む魔女で、はりもみは旅人。\nある日二人は森で出会い、ハリモミはミドリの唯一の友達になる。\n\nハリモミはいつも森に行き、ミドリに贈り物を持ってくる。\nミドリはハリモミのために毎回お菓子を用意する。\nふたりは秘密の幸せな時間を過ごす。\n\nありがとうございました！\n\nhttps://sites.google.com/view/character-reference/P_HM_0608", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@7Nenzi/works/49", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3009815, "client_id": 1983764, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f7f3c306/uploads/origins/4a88c72c-4d63-4c23-98df-9a9fd2bb6bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9ab150f5c5468cd126d14b8ea66cb3c", "srcset": "https://si.imgix.net/f7f3c306/uploads/origins/4a88c72c-4d63-4c23-98df-9a9fd2bb6bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9ab150f5c5468cd126d14b8ea66cb3c, https://si.imgix.net/f7f3c306/uploads/origins/4a88c72c-4d63-4c23-98df-9a9fd2bb6bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96603b3f262e5287d1ecd5a40a1abbce 2x, https://si.imgix.net/f7f3c306/uploads/origins/4a88c72c-4d63-4c23-98df-9a9fd2bb6bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=445f44336bd507bc74b366f5cb5fa3ae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f7f3c306/uploads/origins/4a88c72c-4d63-4c23-98df-9a9fd2bb6bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=857cbb7a71ef8202d51a7d86537899a2", "srcset": "https://si.imgix.net/f7f3c306/uploads/origins/4a88c72c-4d63-4c23-98df-9a9fd2bb6bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=857cbb7a71ef8202d51a7d86537899a2, https://si.imgix.net/f7f3c306/uploads/origins/4a88c72c-4d63-4c23-98df-9a9fd2bb6bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2e0cc020b6a7e33246614dc