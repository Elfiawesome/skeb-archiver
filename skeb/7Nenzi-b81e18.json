it=crop&crop=top&w=200&h=200&s=d59cb54ae44fc1025705e820f165e597 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d964af1/uploads/origins/42dde961-28ce-4018-b221-0cd21beeba6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0497f1a7ffa74ea00791215ed27bb7c", "srcset": "https://si.imgix.net/3d964af1/uploads/origins/42dde961-28ce-4018-b221-0cd21beeba6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0497f1a7ffa74ea00791215ed27bb7c, https://si.imgix.net/3d964af1/uploads/origins/42dde961-28ce-4018-b221-0cd21beeba6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9eb300939b23550f7bcfd55c3699e8e7 2x, https://si.imgix.net/3d964af1/uploads/origins/42dde961-28ce-4018-b221-0cd21beeba6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05d6d31eb3091e524cc1787a9900e4bc 3x"}, "body": "こんにちは！あなたの作品が好きで、イラストをお願いしたいのですが！\n\nミドリとハリモミに興味を持っていただきありがとうございます！ポーズや構図はお任せしますので、自由に描いてください！\n\nキャラクター情報\n\nファンタジー世界のカップル。\nみどりは森の奥に住む魔女で、はりもみは旅人。\nある日二人は森で出会い、ハリモミはミドリの唯一の友達になる。\n\nハリモミはいつも森に行き、ミドリに贈り物を持ってくる。\nミドリはハリモミのために毎回お菓子を用意する。\nふたりは秘密の幸せな時間を過ごす。\n\nありがとうございました！\n\nhttps://sites.google.com/view/character-reference/P_HM_0608", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@7Nenzi/works/49", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3009815, "client_id": 1983764, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f7f3c306/uploads/origins/4a88c72c-4d63-4c23-98df-9a9fd2bb6bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9ab150f5c5468cd126d14b8ea66cb3c", "srcset": "https://si.imgix.net/f7f3c306/uploads/origins/4a88c72c-4d63-4c23-98df-9a9fd2bb6bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&