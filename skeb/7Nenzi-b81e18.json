65fa-c50d-4026-be7d-63e07b0115d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d90ef48b53a664a5b6c44c1043e2faf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e3ceca0/uploads/origins/c3ec65fa-c50d-4026-be7d-63e07b0115d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d156e5ffcb55e7fac2a3fac826a4ed5", "srcset": "https://si.imgix.net/6e3ceca0/uploads/origins/c3ec65fa-c50d-4026-be7d-63e07b0115d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d156e5ffcb55e7fac2a3fac826a4ed5, https://si.imgix.net/6e3ceca0/uploads/origins/c3ec65fa-c50d-4026-be7d-63e07b0115d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6cf7bd11d715af43704eaab558f64141 2x, https://si.imgix.net/6e3ceca0/uploads/origins/c3ec65fa-c50d-4026-be7d-63e07b0115d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8f2d03ade47acde1983af349bab5e1fa 3x"}, "body": "いつも素敵なイラストありがとうございます！前回も格好良く描いて頂いてハチャメチャに気に入ってます。\nキャンペーン滑り込み失礼します。間に合え…！\n\n実は、前回の2人でまた見てみたいもあるし、折角なら別のキャラクターも見てみたいしで迷っているので、お好きな方を選んで頂けたらと思います…！\n\n【案１】\nhttps://skeb.jp/@7Nenzi/works/36 と同じ2人組で、前回は敵対でしたが今回は四天王（のうちの半分ですが）として勇者の前に共に立ちはだかっている、というものをお願いしたいです。こちらの2人の方が圧倒的な感じでお願いしたいです。\n\n【案２】\n3名をお願いしたいです。赤髪が主人公で、狼、教会、夜、墓、月、仮面等がイメージのキャラクターです。\nこちらについてはシチュエーションお任せでお願いしたいと思っています。\n\n■利用用途\n個人観賞用です。\n他、BlueSkyでのアイコン・ヘッダー利用をする場合があります。\n\n以上、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1tFfowd5pX0k_mvI7gyVtV8nF2iMF0PEl?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@7Nenzi/works/51", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9d4761ab/uploads/origins/28e19811-8685-45a9-b1c7-19fc14d1c015?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalig