d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a02e88ef897ad6091ec1a0dc384a2dee 2x, https://si.imgix.net/aa2c8a61/uploads/origins/652b03dc-e707-4cbe-85b4-9cde56f48ebd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fdbcd6cf5416a2dfebbc906a1ab13412 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa2c8a61/uploads/origins/652b03dc-e707-4cbe-85b4-9cde56f48ebd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c916b84c9ec1daa9b9cf8cab59e102bd", "srcset": "https://si.imgix.net/aa2c8a61/uploads/origins/652b03dc-e707-4cbe-85b4-9cde56f48ebd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c916b84c9ec1daa9b9cf8cab59e102bd, https://si.imgix.net/aa2c8a61/uploads/origins/652b03dc-e707-4cbe-85b4-9cde56f48ebd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6bee3e7eaeb27a342f7de67b573d139e 2x, https://si.imgix.net/aa2c8a61/uploads/origins/652b03dc-e707-4cbe-85b4-9cde56f48ebd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dcc6e616646c08fd9851172e5ca9317a 3x"}, "body": "こんばんは、石見硯と申します。\n私事ですが、先日CoCの自探索者が誕生日を迎え、この機会に私がめちゃくちゃ好きなあまむら様のイラストで彼が見たい……！と思ったのでリクエストを送らせていただきます。\n\n構図などはお任せしますが、入れてほしい要素があるのでキャラ設定と共に以下に記載させていただきます！\n\n【キャラ設定】\n花枝冬彦/20代後半/164㎝/53kg\n・バンド活動をしており、そこそこ売れている\n・バンドのベース/副リーダー/作曲担当\n・しっかりしているが、ちょっと熱いところがあり、音楽バカ\n\n・資料内に別キャラの顔の作画資料も同梱されていますが、コンビなので同じファイルに描いているだけで描いてほしいというものではございません！紛らわしくてすいません…\n・服装が2種類ありますが、季節によって立ち絵を使い分けているものです。衣装についても特に指定はありません(資料の通りの服である必要もございません)\n\n\n【入れて頂きたい要素】\n\n・王冠、または戴冠式\n→相方とやっているバンドの名前が「North Empress Waltz」かつ、相方にとっての自分がついていきたい王様のような存在であるため。\n\n・光\n→誕生日祝いも兼ねているので、キャラクターには光が当たっているイラストだと嬉しいです！\n\n【用途】\n観賞・保存・自慢用です。個人的に楽しむためのものです……！！\n\n\nこれ以外の要素・表情・構図などに関しましてはすべてあまむら様の手腕にお任せしたいな……！と考えております。\n何卒ご検討のほどよろしくお願いいたします！\n\n硯\n\nhttps://drive.google.com/drive/folders/1qiCgHtPrHPR05Rrm8v4mUFZTgu0aPrUk?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@auflebend_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2062378, "client_id": 1849929, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c28d0a9/uploads/origins/903768a1-493d-4581-8dde-1c2c08b0b577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81764a6c19918ae4bb8355e416cabd35", "srcset": "https://si.imgix.net/8c28d0a9/uploads/origins/903768a1-493d-4581-8dde-1c2c08b0b577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81764a6c19918ae4bb8355e416cabd35, https://si.imgix.net/8c28d0a9/uploads/origins/903768a1-493d-4581-8dde-1c2c08b0b577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a508ec9d487957396e6e896294dacdd 2x, https://si.imgix.net/8c28d0a9/uploads/origins/903768a1-493d-4581-8dde-1c2c08b0b577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13cf854797aa3fd42463e6a03e6c6505 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c28d0a9/uploads/origins/903768a1-493d-4581-8dde-1c2c08b0b577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38caea036decb5837f4ed1dfa0dde5d7", "srcset": "https://si.imgix.net/8c28d0a9/uploads/origins/903768a1-493d-4581-8dde-1c2c08b0b577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38caea036decb5837f4ed1dfa0dde5d7, https://si.imgix.net/8c28d0a9/uploads/origins/903768a1-493d-4581-8dde-1c2c08b0b577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=65474291fac11e40a018bb24a837eadf 2x, https://si.imgix.net/8c28d0a9/uploads/origins/903768a1-493d-4581-8dde-1c2c08b0b577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=to