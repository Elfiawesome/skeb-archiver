4d6b-a00b-ebd07163815e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=558a931f1faaa863ac7bd051b1978aa4 2x, https://si.imgix.net/89013858/uploads/origins/9f912bd8-602f-4d6b-a00b-ebd07163815e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=90fbc4e8bfacae68b3fb8d3cc4f76b7b 3x"}, "body": "こんにちは、はじめまして。\n直近のＶｔｕｂｅｒさんのリクエストイラストを見てリクエストしようと思いました。\n\nこれからゲームの配信画面用の立ち絵を用意しようと思っていて特に資料とかのないオリジナルキャラなのですが、よろしければ御受けして頂ければと思います。\n\n要望としましては\n狸モチーフの女の子\n服装は可能であれば胸元の開いた白のワンピース\n気持ち大き目の胸\n髪型はセミロングのゆるふわ系で頂点から黒＞こげ茶＞ライトブラウンと毛先に向かって明るくなるグラデーション\nポーズはおまかせで、体の付近に尻尾があるようにしておいて貰えると助かります\n尻尾は狐の尻尾をむっちりした感じで配色は髪の逆で先端が黒っぽくなる感じでお願いします。\n耳は三角でふち黒の中が茶色、根元が白の配色でお願いします。\n気持ちアイライン強めで\n背景は透過でお願いします。\n\n使用用途は配信、サムネ使用になります。\n長々とした要望で申し訳ありません、可能であれば叶えてほしい物を並べたのでそれっぽくあればがんがん無視してもらって構いません、参考資料もありませんので。\n追記で他の方のリクエスト同様バストアップでお願いします。\nそれではよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@noaru_amase/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3115004, "client_id": 1004478, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1488e401/uploads/origins/139a8d62-29ff-4f7f-a5d1-24b58e802eb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48c85633a7adad51535b65d36d98695d", "srcset": "https://si.imgix.net/1488e401/uploads/origins/139a8d62-29ff-4f7f-a5d1-24b58e802eb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48c85633a7adad51535b65d36d98695d, https://si.imgix.net/1488e401/uploads/origins/139a8d62-29ff-4f7f-a5d1-24b58e802eb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2fa417f837bfeb062a893bc8bfaab96 2x, https://si.imgix.net/1488e401/uploads/origins/139a8d62-29ff-4f7f-a5d1-24b58e802eb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a63226efb0f8655ce9c934022f739a09