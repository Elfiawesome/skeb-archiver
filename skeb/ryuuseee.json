/uploads/origins/fa71b187-8958-4d2f-9228-7c9b4ce9d626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7806e667be1f30ca54096737a55c6f2e, https://si.imgix.net/8f18a411/uploads/origins/fa71b187-8958-4d2f-9228-7c9b4ce9d626?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=253e060459e97f2917404390d3c3a30a 2x, https://si.imgix.net/8f18a411/uploads/origins/fa71b187-8958-4d2f-9228-7c9b4ce9d626?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=deee4dfff298d479e89c7f445dd46ccb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f18a411/uploads/origins/fa71b187-8958-4d2f-9228-7c9b4ce9d626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=faffaabf06d9efec436d22a7b944a2e4", "srcset": "https://si.imgix.net/8f18a411/uploads/origins/fa71b187-8958-4d2f-9228-7c9b4ce9d626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=faffaabf06d9efec436d22a7b944a2e4, https://si.imgix.net/8f18a411/uploads/origins/fa71b187-8958-4d2f-9228-7c9b4ce9d626?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=02ecdd648f6dfe83d047d5de5d497d28 2x, https://si.imgix.net/8f18a411/uploads/origins/fa71b187-8958-4d2f-9228-7c9b4ce9d626?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8d837827c4103f5145bc1830dd0d6e0e 3x"}, "body": "りゅうせーさんこんばんは！\nskebを開いていると聞きまして、りゅうせーさんの絵柄で描かれる我が家の一次創作キャラをどうしても見たくリクエスト送らせて頂きました！\n\n【リクエスト内容】\n〇一次創作(オリジナル)男性キャラクターのイラスト \nお好きな構図・シチュエーションで構いません🙏🏻\n\n【使用用途】\nSNSのアイコン又はヘッダー使用、缶バッジやポスカ等の個人用のグッズ制作(商用利用なしで個人用のみ)\n名前とIDを表記した上で使用させて頂きたいと思っております。\n\n---------------------------------------------\n\n↓キャラ資料等はこちらになります。 \n《特徴詳細》\n【肌色】褐色肌(青め)\n【髪】白髪(真っ白では無くかすんでいてほんの少し灰色がかっています)\n【瞳】両目灰色でハイライト無。目元に青色のアイシャドウ、下睫毛。(怒った時は瞳孔が赤くタコ目)\n【年齢】推定20代\n【属性】水・闇属性(中立・中庸)\n【性格・詳細】\n無愛想で冷たい態度を取る青年(人型人外の半神)。しかし冷たい態度を取るのは自身に掛けられた『呪い』の影響を他人に及ぼさないようにするためであり実際の彼は心優しい。主人に愛する息子を殺され強い恨みを持っている。現在は息子の亡骸に自身の魂を移しているため本来の姿では無い。\n【絵文字モチーフ】🐙💧🌫🔮\n\n《キャラクター立ち絵やその他詳細》\nhttps://drive.google.com/drive/u/2/mobile/folders/1hYmWVxp76IXukAPIp2W58suXex-xwpEX/1-7vQZ9H9tcW61L0sBpXWP5Q6STLzv_rj/1-shn_fFgS75GXCmdO_Q4YOtw0pZsF50f?sort=13&direction=a\n\n--------------------------------------------\n\nたくさんのリクエストが来ていると思いますので内容的に難しい場合はキャンセルして頂いても構いません…！\nご検討の程宜しくお願い致します🙇🏻\n\nhttps://drive.google.com/drive/u/2/mobile/folders/1hYmWVxp76IXukAPIp2W58suXex-xwpEX/1-7vQZ9H9tcW61L0sBpXWP5Q6STLzv_rj/1-shn_fFgS75GXCmdO_Q4YOtw0pZsF50f?sort=13&direction=a", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ryuuseee/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 71915, "client_id": 2593758, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f60304b5/uploads/origins/a8dac4f2-a791-449c-a6c2-e1e57649536f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0ca7b47ea1dec869ef6bcd155ea6856", "srcset": "https://si.imgix.net/f60304b5/uploads/origins/a8dac4f2-a791-449c-a6c2-e1e57649536f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0ca7b47ea1dec869ef6bcd155ea6856, https://si.imgix.net/f60304b5/uploads/origins/a8dac4f2-a791-449c-a6c2-e1e57649536f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19e05a6047783483cba832f026646c00 2x, https://si.imgix.net/f60304b5/uploads/origins/a8dac4f2-a791-449c-a6c2-e1e57649536f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0d97f0f636473a295d877ce5b9a0692 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f60304b5/uploads/origins/a8dac4f2-a791-449c-a6c2-e1e57649536f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b049993c2550ace87a8ad54a4979ac87", "srcset": "https: