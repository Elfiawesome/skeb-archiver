夫だと思う😀\n▼元の立ち絵など\nhttps://drive.google.com/file/d/1hGT6B2gYuZDi8DiAj7-0M4I3a3n00BsF/view?usp=drivesdk\n\n細かい構図の指定は特にありませんのでご自由に描いて頂ければと思います🤩\nユウリがけいちゃんをからかっているような感じがすると嬉しいです❣️\nskeb送るの初めてだからなんか間違ってたりしたらごめんなさい！！！🤯🫨🫠🫣\n\nよろしくお願いいたします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 27430, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "そらねこ*", "screen_name": "skycat_00", "avatar_url": "https://pbs.twimg.com/profile_images/2054191528948707328/7SLzkl2h.jpg", "header_url": "https://pbs.twimg.com/profile_banners/547408629/1720398388/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 45, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 16}, {"id": 993483, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "木犀", "screen_name": "mokusei0516", "avatar_url": "https://pbs.twimg.com/profile_images/1717418282679242752/kNfpaaa7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1334448316436762624/1696083071/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 2825679, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "絵が好き", "screen_name": "noname__da", "avatar_url": "https://pbs.twimg.com/profile_images/1992984809367564288/jda4CUZZ.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration