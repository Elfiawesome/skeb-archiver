使用用途・範囲】\n・個人での鑑賞、SNSアイコン、YouTubeの動画や配信サムネイル、告知画像等、Vtuber活動での使用を予定しております。\n サムネイル等に使用させていただきたいので、キャラクターの透過レイヤーをいただけると助かります。 \n・配信画面への表示、使用\n\n【X(旧twitter)】 https://twitter.com/Kamikura_Kudaku?t=0BlHpx7Ku7_VqhdWS6-_Jw&s=09 \n\n金額に不足などあれば、リクエストの再送をお願い出来れば幸いです。\nお忙しいとは思いますが、ご検討いただけると幸いです。 何卒よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sorane_kekekemo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1086711, "client_id": 3460311, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3a0754b/uploads/origins/dfab0cd5-cd93-4b2c-906b-193770f9cb02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58a11dc764f4f9293a76eedbd62b1009", "srcset": "https://si.imgix.net/b3a0754b/uploads/origins/dfab0cd5-cd93-4b2c-906b-193770f9cb02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58a11dc764f4f9293a76eedbd62b1009, https://si.imgix.net/b3a0754b/uploads/origins/dfab0cd5-cd93-4b2c-906b-193770f9cb02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c44454e6da3e4c4dd61c7b01f9b09b2d 2x, https://si.imgix.net/b3a0754b/uploads/origins/dfab0cd5-cd93-4b2c-906b-193770f9cb02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05863e8f678c904b89bd15029b1b3f07 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3a0754b/uploads/origins/dfab0cd5-cd93-4b2c-906b-193770f9cb02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=182856b96196ce208b11ef10a6afed6e", "srcset": "https://si.imgix.net/b3a0754b/uploads/origins/dfab0cd5-cd93-4b2c-906b-193770f9cb02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=182856b96196ce208b11ef10a6afed6e, https://si.imgix.net/b3a0754b/uploads/origins/dfab0cd5-cd93-4b2c-906b-193770f9cb02?bg=%