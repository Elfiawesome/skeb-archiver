/\n\n衣装を作成する際は胸の谷間が見えるものを考慮してください。\n\nポーズはあなた次第です。ただし、この作品はキャラクターの胸に注目してもらいたい。彼女が衣服を脱いでいる様子を描くこともできます。 \n\n優しくて優しいお姉さんのような性格のキャラクターです。彼女は気になる人をふざけてからかい、とても誘惑することがあります。\n\nその他の詳細はすべてあなた次第です。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ant0coffee/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 14880, "client_id": 43932, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/79bf56a7/uploads/origins/a7170477-cef8-40fd-ab89-d45161bc3600?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fba39ec107130362f3ae5fabeeb99e9f", "srcset": "https://si.imgix.net/79bf56a7/uploads/origins/a7170477-cef8-40fd-ab89-d45161bc3600?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fba39ec107130362f3ae5fabeeb99e9f, https://si.imgix.net/79bf56a7/uploads/origins/a7170477-cef8-40fd-ab89-d45161bc3600?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b987340ccc88b9ef5c6ee29e634c6ff6 2x, https://si.imgix.net/79bf56a7/uploads/origins/a7170477-cef8-40fd-ab89-d45161bc3600?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e7042349a00986c03ac554dd3a88926 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/79bf56a7/uploads/origins/a7170477-cef8-40fd-ab89-d45161bc3600?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f6ed3a148ab078ac24a90a56836fb6d", "srcset": "https://si.imgix.net/79bf56a7/uploads/origins/a7170477-cef8-40fd-ab89-d45161bc3600?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f6ed3a148ab078ac24a90a56836fb6d, https://si.imgix.net/79bf56a7/uploads/origins/a7170477-cef8-40fd-ab89-d45161bc3600?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=841bcf1b5be0e31d762d68a47bbbb92c 2x, htt