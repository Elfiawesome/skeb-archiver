44a0-a686-cbfa09e90a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bd4877d76ced2dfd82996a9feaff1e1, https://si.imgix.net/1f6e6b9f/uploads/origins/604ec516-a046-44a0-a686-cbfa09e90a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e4496098e00b9de5f5936a64a21bb88 2x, https://si.imgix.net/1f6e6b9f/uploads/origins/604ec516-a046-44a0-a686-cbfa09e90a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a7897a941d69886c808b7ae95bd671d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f6e6b9f/uploads/origins/604ec516-a046-44a0-a686-cbfa09e90a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5b1f332fd9dc9b787cc56d5462ae1b3", "srcset": "https://si.imgix.net/1f6e6b9f/uploads/origins/604ec516-a046-44a0-a686-cbfa09e90a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5b1f332fd9dc9b787cc56d5462ae1b3, https://si.imgix.net/1f6e6b9f/uploads/origins/604ec516-a046-44a0-a686-cbfa09e90a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=10aa6444e2fc6abca9b70dd6b2f6ccd9 2x, https://si.imgix.net/1f6e6b9f/uploads/origins/604ec516-a046-44a0-a686-cbfa09e90a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f8409f6f7169485f17f7d571a262ce1a 3x"}, "body": "はじめまして。あなたの絵が本当に好きです!\n\nこのキャラクターを描いていただけませんか？現代のTRPG「Call of Cthulhu」（CoC）の設定です。ヒーローとヴィランという構図です。\n\nアロイス\n180cm。金髪の男性。痩せ型。\nおしゃべりで茶目っ気があり、ずるがしこい性格。普段の表情は満面の笑み。\n超常的な脅威と戦う組織に所属している。\nゲイブが悪役であるにもかかわらず、アロイスはゲイブに執着している。\n\nゲイブ\n186センチ。白髪の男性。筋肉質。\n普段の表情は笑顔。不遜でカジュアルな性格だが、密かに非常に危険な存在でもある。\n物語の悪役である。\n\n二人がトランプで遊んでいるイラストを描いてください。\nアロイスはカードゲームに勝っているのですが、手品のようなトリックでごまかしているのです。\nGabeはそのことに気づいていますが、気にせず愛想笑いを浮かべています。\n\nいずれにせよ、このリクエストを読んでいただき、本当にありがとうございました\n\nhttps://drive.google.com/drive/folders/1atjIzPqghGCslfuaHI8uE5rk5gzVuPSz?usp=share_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@A_dracunculus/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 869867, "client_id": 2459698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/251ad36f/uploads/origins/bcdb172f-a06e-4901-8577-12d2ed948778?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=640024db56ab37ef8d69394c5407d6f5", "srcset": "https://si.imgix.net/251ad36f/uploads/origins/bcdb172f-a06e-4901-8577-12d2ed948778?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=640024db56ab37ef8d69394c5407d6f5, https://si.imgix.net/251ad36f/uploads/origins/bcdb172f-a06e-4901-8577-12d2ed948778?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72f389c7303fd4de6dcd1a0399c89f73 2x, https://si.imgix.net/251ad36f/uploads/origins/bcdb172f-a06e-4901-8577-12d2ed948778?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23ddf90a795095084f38c5c0cb0df3df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/251ad36f/uploads/origins/bcdb172f-a06e-4901-8577-12d2ed948778?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce1928c38bfdc2c90b4d42f14777577c", "srcset": "https://si.imgix.net/251ad36f/uploads/origins/bcdb172f-a06e-4901-8577-12d2ed948778?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce1928c38bfdc2c90b4d42f14777577c, https://si.imgix.net/251ad36f/uploads/origins/bcdb172f-a06e-4901-8577-12d2ed948778?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8f37f59b90b90e0752a834a821a56d52 2x, https://si.imgix.net/251ad36f/uploads/origins/bcdb172f-a06e-4901-8577-12d2ed948778?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d63c216bb3f0c459253d5e1edd5fbdd 3x"}, "body": "こんにちは、はじめまして。あなたの作品に出会い、特にヤクザのファンアートがとても気に入りました！私は、あなたの絵が大好きです。今回お願いしたいのは、1890年代のアメリカかヨーロッパ風のファンタジーの世界で、私のオリジナルキャラクターを2人組で描いていただくことです。\n黒髪ストレートは成人男性（30～40歳）、神父です。身長190cm、細身だが力強い体型、アイボリーの肌色、黒い瞳、皺がある。見た目は親しみやすく、温厚そうだが、威圧的で道徳心が全くない。\n茶髪のキャラクターは中年男性（35~45歳）で、賞金稼ぎです。身長は200cmほどで、筋肉質な体型、日焼けした肌、金色の目、鼻に傷がある。精神的に不安定で、アルコール依存症で、怒りっぽい。しかし、娘を養女として迎え入れ、心から愛している。  \n昔からの知り合いで、秘密の恋人になろうとしたが、うまくいかなかったので、友達として付き合っている。できれば、タバコのキスを交わすシーンが見たい。曖昧で親密な雰囲気。それ以外は特になし。服装、ポーズ、色など自由に選んで、あなたのスタイルで描いてください。ご検討のほど、よろしくお願いします。\n参考までにキャラクターの画像です。https://drive.google.com/drive/folders/1Qh95MMc5W1XJElHog7K9mrZohBBtdGHi?usp=share_link。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@A_dracunculus/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 869867, "client_id": 1925418, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/135c4dfb/uploads/origins/0f1f901d-2fe5-4067-a38f-77da9630632b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fce2ae3a4f8eeb4d34cc8c2a7270c5b", "srcset": "https://si.imgix.net/135c4dfb/uploads/origins/0f1f901d-2fe5-4067-a38f-77da9630632b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fce2ae3a4f8eeb4d34cc8c2a7270c5b, https://si.imgix.net/135c4dfb/uploads/origins/0f1f901d-2fe5-4067-a38f-77da9630632b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db8f7de2a6ac5ac220754e0bcf8b1887 2x, https://si.imgix.net/135c4dfb/uploads/origins/0f1f901d-2fe5-4067-a38f-77da9630632b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=983b24c98b0072ee257d5d73ac1df1a4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/135c4dfb/uploads/origins/0f1f901d-2fe5-4067-a38f-77da9630632b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5c4e145fe302e5b66c36b27c8f46b0a", "srcset": "https://si.imgix.net/135c4dfb/uploads/origins/0f1f901d-2fe5-4067-a38f-77da9630632b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5c4e145fe302e5b66c36b27c8f46b0a, https://si.imgix.net/135c4dfb/uploads/origins/0f1f901d-2fe5-4067-a38f-77da9630632b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=345a525fdf8712784b72e58e583c6aec 2x, https://si.imgix.net/135c4dfb/uploads/origins/0f1f901d-2fe5-4067-a38f-77da9630632b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dffc99d25e7d96ef014c3468639907d7 3x"}, "body": "こんにちは。私はあなたの絵が大好きです\n私や私の友人のオリジナルキャラクターを、あなたのスタイルで描いてほしいです。私たちが解釈した三国志のキャラクターです。白いスーツを着た迅羽（https://i.imgur.com/xCi0ho3.png）と夏侯惇（https://i.imgur.com/cVNiS2Y.png）が一緒にロマンチックに踊っているところを見たいですね。宣禹は夏候敦より少し背が低く、夏候敦は日焼けが目立ちます。\n\nここには他の参考文献も載せていますが、スーツのスタイルなどは皆さんの解釈にお任せします。\n\nよろしくお願いします。\n\nhttps://imgur.com/a/vauENeT", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@A_dracunculus/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8e039b55/uploads/origins/362d6920-64da-462b-8bad-0c108cd56497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a94a124a6039b067202f4e413aed74c9", "srcset": "https://si.imgix.net/8e039b55/uploads/origins/362d6920-64da-462b-8bad-0c108cd56497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a94a124a6039b067202f4e413aed74c9, https://si.imgix.net/8e039b55/uploads/origins/362d6920-64da-462b-8bad-0c108cd56497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=824588a3fc7