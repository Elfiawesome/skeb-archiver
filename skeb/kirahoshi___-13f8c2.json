/13dzqHYQTJmjH9gNRAuESby6q4KQ4pNww", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kirahoshi___/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3925426, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b31d7c26/uploads/origins/41719c30-fba4-4390-9090-ad1ef44d6b32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c1753c5351e47d9c74827d999f9f03f", "srcset": "https://si.imgix.net/b31d7c26/uploads/origins/41719c30-fba4-4390-9090-ad1ef44d6b32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c1753c5351e47d9c74827d999f9f03f, https://si.imgix.net/b31d7c26/uploads/origins/41719c30-fba4-4390-9090-ad1ef44d6b32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c045ae612e80bca7013e0cf44b18d5c5 2x, https://si.imgix.net/b31d7c26/uploads/origins/41719c30-fba4-4390-9090-ad1ef44d6b32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1449247881dedae2740e6846767df383 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b31d7c26/uploads/origins/41719c30-fba4-4390-9090-ad1ef44d6b32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9b3b27146af0d500ecc68b607cc5bc7", "srcset": "https://si.imgix.net/b31d7c26/uploads/origins/41719c30-fba4-4390-9090-ad1ef44d6b32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9b3b27146af0d500ecc68b607cc5bc7, https://si.imgix.net/b31d7c26/uploads/origins/41719c30-fba4-4390-9090-ad1ef44d6b32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d228ba3ffc3f16678077248affa8c674 2x, https://si.imgix.net/b31d7c26/uploads/origins/41719c30-fba4-4390-9090-ad1ef44d6b32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=