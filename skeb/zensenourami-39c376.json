6b-f29c3cfe18ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c89353752bcad8d09e50567529ba9ff, https://si.imgix.net/ae62cb38/uploads/origins/476d2cef-ef75-4179-886b-f29c3cfe18ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=26cfdf1b19d06e8d6f6a78db4339eed5 2x, https://si.imgix.net/ae62cb38/uploads/origins/476d2cef-ef75-4179-886b-f29c3cfe18ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f268cd00b339d2647cccdd8c4b0f8356 3x"}, "body": "以前もスケブを依頼したのですが、\nまだ枠に余裕があるようでしたら再度依頼させていただきたいです。\n餅山さんの描かれる女の子が大好きです。\n\n■要望\n餅山さんのオリジナルの女の子を描いていただきたいです。\n以下の要素を含んでいると助かりますが、餅山さんの一番描きやすい形で作成していただけると嬉しいです。\n要素はいくらでも省いて、好きな要素を足していただいて大丈夫です。\n↓\n・色白\n・そばかす\n・黒のツインテール\n　※肩を超える程度の現実的な長さでも、身長程度の非現実的な長さでも、他要素の兼ね合いで決めていただいて大丈夫です\n・黒の垂れ目\n　※目の中にハートが入っていると助かります\n・上記要素の割には陰気で卑屈そうな雰囲気\n\n■使用用途\nPixivのアイコン＆ヘッダーに利用いたします。\nTwitterでもスケブを受けていただいたという形で、公開いたします。\n\nお忙しいところ申し訳ありません。\n要望の項目が殆ど餅山さんにお任せしてしまう形になりますので、\n描くのが難しければ依頼は弾いていただけますでしょうか。\n\n以上、よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@zensenourami/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 485651, "client_id": 2473119, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c33af4a/uploads/origins/4b40e6db-6780-484b-b898-1eafd1612a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac3650af92c9b7d151b2362e0327d9c8", "srcset": "https://si.imgix.net/1c33af4a/uploads/origins/4b40e6db-6780-484b-b898-1eafd1612a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac3650af92c9b7d151b2362e0327d9c8, https://si.imgix.net/1c33af4a/uploads/origins/4b40e6db-6780-484b-b898-1eafd1612a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65d6a16f54a00ab5e2bb68b1f2a42b7a 2x, https://si.imgix.net/1c33af4a/uploads