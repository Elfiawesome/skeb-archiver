=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb7209971d650ab1c702e9e5ba0766af 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df83e926/uploads/origins/ba5eccc7-d6ff-4ef4-9f05-1495578c5313?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0e6c7a330a0476f95a8b731fc1d58d5", "srcset": "https://si.imgix.net/df83e926/uploads/origins/ba5eccc7-d6ff-4ef4-9f05-1495578c5313?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0e6c7a330a0476f95a8b731fc1d58d5, https://si.imgix.net/df83e926/uploads/origins/ba5eccc7-d6ff-4ef4-9f05-1495578c5313?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bbc85513b1ee8f631d4069b7a230c428 2x, https://si.imgix.net/df83e926/uploads/origins/ba5eccc7-d6ff-4ef4-9f05-1495578c5313?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb138a1bc0c67659841bec3adb5cb825 3x"}, "body": "初めまして。最近X（Twitter）でお見掛けし、絵柄が大変好みでしたのでリクエストさせていただきます。\n\nゲーム「Akiba's trip plus」より、JKV をお願いします。\n\nhttps://www.youtube.com/watch?v=rizrC_cDMwo&t=93s\nhttps://www.youtube.com/watch?v=_vFbThNxIWg&t=12s\n\n・詳細\n　秋葉原の駅前でオヤジ狩りをしていた女吸血鬼。ハンターに制服の大部分を脱がされほどんど下着姿にされている（下着は動画通り上下とも水色ボーダー）。ブラから乳房がこぼれだし母乳が噴き出している。吸血鬼であるため日光にさらされて肌の大部分が青く変色しており、大量に汗をかいている。ハンターに狩られる寸前の焦りと、下着姿に剥かれた羞恥の表情。\n　配下の黒髪JK吸血鬼も複数人、同じくらい脱衣させられて焦ったり恥じらったりしている様子（下着はピンク無地）。彼女らはモブなので描写はある程度簡素でOK。\n\n\n奇妙な内容で恐縮ですが、ご検討いただけますと幸いです。よろしくお願いいたします。\n\nhttps://seesaawiki.jp/villainess/d/JKV%a1%caAKIBA%60STRIP%a1%bfAKIBA%60STRIP%20PLUS%a1%cb", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@makingtawawa/works/286", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1488326, "client_id": 44102, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26087354/uploads/origins/32c1c603-1932-404a-ac56-e10460e2285b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=640c08abcb25c5abf23d7e63db86db21", "srcset": "https://si.imgix.net/26087354/uploads/origins/32c1c603-1932-404a-ac56-e10460e2285b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=640c08abcb25c5abf23d7e63db86db21, https://si.imgix.net/26087354/uploads/origins/32c1c603-1932-404a-ac56-e10460e2285b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab102629b8facdf67c1cbd9c548c2767 2x, https://si.imgix.net/26087354/uploads/origins/32c1c603-1932-404a-ac56-e10460e2285b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=058172806ef6242ee2a48c46e5558f4b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26087354/uploads/origins/32c1c603-1932-404a-ac56-e10460e2285b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6855d198e205debcb011e20562fe9169", "srcset": "https://si.imgix.net/26087354/uploads/origins/32c1c603-1932-404a-ac56-e10460e2285b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6855d198e205debcb011e20562fe9169, https://si.imgix.net/26087354/uploads/origins/32c1c603-1932-404a-ac56-e10460e2285b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9e7fd404692b07f4a49a83996500bb46 2x, https://si.imgix.net/26087354/uploads/origins/32c1c603-1932-404a-ac56-e10460e2285b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bfdb9d670a03488046e5d41a9315e3a0 3x"}, "body": "こんにちは。ゲーム\"Akiba's Trip Plus\"より「制服を脱がされるJKV」をお願いします。\n場面の展開については書くと長いので、まず以下の動画をご覧ください。\n\nhttps://youtu.be/rizrC_cDMwo\nhttps://youtu.be/_vFbThNxIWg\n\n「女子高生の制服を着て秋葉原の駅前でオヤジ狩りをしていた女吸血鬼\"JKV\"（ピンク髪の娘）がハンターに服を脱がされ陽光を浴びて炭化し、護衛と共に倒される」という場面です。\n\nリクエスト内容としては「制服を脱がされブラ（水色ボーダー）をズラされて両乳房が露出、パンツ（同じく水色ボーダー）も降ろされて恥部が晒された状態。陽光を浴び肌の一部が少し焦げて黒い煙が立つ。吸血鬼なので命がかかっているため、恥じらいつつも戦闘マンガ的な焦った表情」となります。\n\nぜひご検討いただければ幸いです。よろしくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 174905, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ちびねこ", "screen_name": "chibineco_m", "avatar_url": "https://pbs.twimg.com/profile_images/497673356691243009/S5eRNA50.jpeg", "header_url": "https://pbs.twimg.com/profile_banners/107930554/1422759736/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 176}, {"id": 183935, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "たんこぶぼうや", "screen_name": "rianistako", "avatar_url": "https://pbs.twimg.com/profile_images/1726970649279873024/PVMuFb57.jpg", "header_url": "https://pbs.twimg.com/profile_banners/971989747835977728/1548426497/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 177}, {"id": 198683, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "一十千 楓🍁", "screen_name": "hitotose_kaede", "avatar_url": "https://pbs.twimg.com/profile_images/1638532768211820545/cBPAKzeg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/376254247/1770999320/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 177}, {"id": 491430, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "MIY", "screen