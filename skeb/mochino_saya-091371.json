髪の長さは変更なしでお願いしたいです。\n背景と人物を分けて納品していただけると嬉しいです。\n可能であれば16：9のサイズで描いていただきたいです。\n表情差分も可能であればお願いしたいです。金額に不足がありましたらお手数ですが再送要請いただけると幸いです。\n\n使用用途\n\n収益化済みの配信やＳＮＳへの掲載\nサブスクライバー限定で壁紙として配布\nおはようVtuberなどの素材と合わせての使用\n\nぜひ春風るぅ様に描いていただきたいです。よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1nMFUymrmU5INhNJrT9tLUb0sQSBxXeHb?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sui__123/works/91", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2053647, "client_id": 3116847, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59472255/uploads/origins/f1583299-9725-460e-b914-4bc6200191a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6128b7d2d31902c2d70efe9841a3c95", "srcset": "https://si.imgix.net/59472255/uploads/origins/f1583299-9725-460e-b914-4bc6200191a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6128b7d2d31902c2d70efe9841a3c95, https://si.imgix.net/59472255/uploads/origins/f1583299-9725-460e-b914-4bc6200191a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70d52c7b3208d3845604c74f372063c9 2x, https://si.imgix.net/59472255/uploads/origins/f1583299-9725-460e-b914-4bc6200191a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=162153b40cd9c84b55abab17117bc2ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59472255/uploads/origins/f1583299-9725-460e-b914-4bc6200191a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c2e75abb716c95d5fbb17fb919a0a50", "srcset": "https://si.imgix.net/59472255/uploads/origins/f1583299-9725-460e-b914-4bc6200191a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c2e75abb716c95d5fbb17fb919a0a50, https://si.imgix.net/59472255/uploads/origins/f1583299-9725-460e-b