dfd5b/uploads/origins/0ea7af33-683f-459b-a1e5-30b7bf1fe1b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9984e79c449714a12a9915189fe9e6b7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/761dfd5b/uploads/origins/0ea7af33-683f-459b-a1e5-30b7bf1fe1b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=535e7b933496fdd156603a82d8687f01", "srcset": "https://si.imgix.net/761dfd5b/uploads/origins/0ea7af33-683f-459b-a1e5-30b7bf1fe1b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=535e7b933496fdd156603a82d8687f01, https://si.imgix.net/761dfd5b/uploads/origins/0ea7af33-683f-459b-a1e5-30b7bf1fe1b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05503263380dcf2578acba5a8b42ed3b 2x, https://si.imgix.net/761dfd5b/uploads/origins/0ea7af33-683f-459b-a1e5-30b7bf1fe1b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5fa745921e5796103f9b8f7f46da90e7 3x"}, "body": "こんにちは！あなたの絵に出会って、表情やダイナミックなポーズの描き方が大好きになりました！\n\n私のVtuberを描いてもらえたらとても嬉しいです！名前はたんたんで、牛の女の子でアイドル育成中です。\n優しくて、元気で、ドジな女の子です。アイドルになるために、練習と努力を惜しまず頑張っています。とっても優しくておバカ。\n\n表情やポーズはお任せしたいです！楽しく可愛く描いて頂ければ嬉しいです！\nイラストでは、前髪のディテールもお願いします。前髪が乱れていて、2点出ています。これは提供されたリンクで見ることができます。\n\nできれば16:9でお願いします。このアートをパソコンの壁紙や背景として使い、ソーシャルメディアで共有したいです！\n\nhttps://drive.google.com/drive/folders/1fBeEHmRxDZxG5unFruDEtC7sva7FFSQG?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ms968542341/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3593866, "client_id": 394678, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f75f1cd7/uploads/origins/592839f0-66fb-48a7-aaa5-3eda2af9925d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba8f04ad7c