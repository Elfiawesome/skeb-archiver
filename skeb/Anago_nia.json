https://www.pixiv.net/artworks/105656212）のような正面からのパイズリ\n・衣装は資料URL１枚目のスタンダード版で袖を通しているジャケットは省略\n・胸のビキニは着けたまま、脱いだ状態どちらにするかはお任せ\n\nシチュエーション\n・担当のボーダー（作品世界のロボット乗り）が好成績をおさめたことに対するご褒美パイズリ\n・既に何度かのご褒美パイズリをしておりレジーナに羞恥心はほぼない感じ\n・パイズリばかりねだられて若干呆れつつも満更でもない様子\n・そのおかげでバストサイズが以前より大きくなっている\n\n内容\n・竿役をからかったりしながらのレジーナ主導のパイズリ\n\nもし可能であれば２回戦の差分（その場合２回目の射精は顔射で）をお願いします。\n台詞については資料URLから繋がってるリプに動画でありますのでイメージの参考にしてください。分かりづらければちょっと色っぽいお姉さん的なキャラな感じでお願いします。\n\n\n題材としてはマイナーな部類に入りますがご検討のほどよろしくお願いします。\n\nhttps://twitter.com/notogoro/status/1318140918554218496", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Anago_nia/works/77", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2e2245eb/uploads/origins/fc036047-fabf-4a99-87df-90238e5db235?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=118a4b1bb3c2e96290eca8c481c58b2c", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 41925, "client_id": 763895, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Anago_nia/works/76", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/142201e7/uploads/origins/2b01b231-de6b-464d-b695-7003c1c53e40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2147319b245308e127ca7146810563d", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 41925, "client_id": 513254, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_accep