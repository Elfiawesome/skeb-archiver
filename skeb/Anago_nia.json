常差分を願いしたいのとおっぱいは樫野（https://skeb.jp/@Anago_nia/works/79）と同じくらいでお願いします。\nどうかどうかよろしくお願いします\n\nhttps://drive.google.com/drive/folders/1sA-fqKas0FvXrF5PkIUcyr5VaaLQBzko?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Anago_nia/works/81", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f5e2c783/uploads/origins/153b8d9e-68cc-495b-adb0-21b253eda76a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b9134f41dbb71a761f912c064975a08", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 41925, "client_id": 579914, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Anago_nia/works/80", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 41925, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63c417a7/uploads/origins/5c74b5a8-a46e-4ab7-9714-f00e41f76c7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec18d0184c13003ae65a2383b9ac1618", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63c417a7/uploads/origins/5c74b5a8-a46e-4ab7-9714-f00e41f76c7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6bf3972571cdb7e6fb1752a3128d9c2", "src_set": ""}, "body": "初めまして。リクエストを送らせていただきます。\nキャラクター：FGOの玉藻の前\n竿役：マスター\n補足・玉藻との絆レベル10\nプレイ内容：膝上パイズリ(服装はトップレス)\nシチュエーション\n・他の女性サーヴァントに見とれていたマスターに自分が一番だとわからせるためにお仕置きとして出なくなるまで搾精されてしまう。\nというもので・・・\nどうぞよろしくお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@