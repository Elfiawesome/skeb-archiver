RKPNhsa\n寄生して心を支配\nhttps://imgur.com/a/CyU6e7o\nhttps://imgur.com/a/3zpoOMJ\n邪心に染めされられ敵の尖兵に\nhttps://imgur.com/a/qjMjvOa\nhttps://imgur.com/a/meBPl5b\nhttps://imgur.com/a/mlFQZtI\nhttps://imgur.com/a/jwB4w4s\nhttps://imgur.com/a/MbB9R5e\nhttps://imgur.com/a/AQj43bV\n\nシチュ的には操られたビーナスが騎乗位で逆レイプしているシーンで御願い致します。\nその際石のビキニの秘所を覆っている部分はオープンクロッチで露出して頂ける様御願いします。\n竿役はお任せ致します。\n負荷が高い場合姿は最悪省略して構いません。\nコストが割に合わないと思ったらSFWの立ち絵の方にシフトして頂くよう御願いします。\n\n長くなりましたが依頼とさせて頂きます。\n不都合があればキャンセルして構いません。\nどうか御検討御願い致します。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@senzo1840/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2001168, "client_id": 1134851, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b33129ab/uploads/origins/66781b50-6314-46a4-8396-3eaa72d4892e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2acbc0307f1dbf153b4738ddfe717759", "srcset": "https://si.imgix.net/b33129ab/uploads/origins/66781b50-6314-46a4-8396-3eaa72d4892e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2acbc0307f1dbf153b4738ddfe717759, https://si.imgix.net/b33129ab/uploads/origins/66781b50-6314-46a4-8396-3eaa72d4892e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98c710a28210fe7e84a78feb3cb4c966 2x, https://si.imgix.net/b33129ab/uploads/origins/66781b50-6314-46a4-8396-3eaa72d4892e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=519905b8d547fd6a26523dd33f188993 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b33129ab/uploads/origins/66781b50-6314-46a4-8396-3eaa72d4892e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2f0056d389db50a35ccb88c0c2af66b", "srcset": "https://si.imgix.net/b33129ab/uploads/origins/66781b50-6314-46a4-8396-3eaa72d4892e?bg=%23fff&auto=form