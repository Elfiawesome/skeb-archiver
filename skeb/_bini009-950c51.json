るように、左にイチョウのピアス、右にスズランのピアスをつけています。マズルガードや首輪をつけていますが、マズルガードは描写してもしなくて結構です。\n \n.\n\nマズルガードと首輪を自ら付けて「犬」を自称する変人の刑事で、所属は鑑識課です。ビーカーでコーヒーを出したり、サルミアッキを平気な顔をして食べたりします。\n染髪やらピアスやらなんでもありの不良じみた男ですが、医学系の大学院を卒業しており、医学系や理系の分野に関してはとても優秀です。\n明るいを通り越してうるさくどこか横暴な印象もありますが、人に対しての優しさがある善良な男で、人を傷つけることを極度に恐れています。いつも明るい表情をしていますが、たまに闇が見え隠れする時があります。\n特殊な世界観で、刑事の所持している武器は拳銃や警棒ではなく日本刀で、真昼の日本刀の種類は大太刀です。 \n\nーーー \n \nお忙しいと思いますので、リクエストの受託はご都合が合いそうであればで構いません。 どうぞよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/15m0nsbUdNzIl5O9sx2XZtEjSfeem7w8T?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1487547, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "なめこ", "screen_name": "nameko_hachikou", "avatar_url": "https://pbs.twimg.com/profile_images/2028514255126089728/vpVEfJxH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1871589942/1765981169/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 176}, {"id": 2574324, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Volkovsky", "screen_name": "Lazyboy_vol22", "avatar_url": "https://pbs.twimg.com/profile_images/1700121972104212480/ztc6Pdbg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/834696325857882113/1693455422/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 16}, {"id": 2812049, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "キネタム-skeb", "screen_name": "kinetamu", "avatar_url": "https://pbs.twimg.c