丈夫です。\nまた、完成品は大画面で存分に堪能したいので、A4サイズの350dpiで制作してくださるとより一層嬉しいです。\n\nもしリクエスト内容に不備等ございましたら、遠慮なく拒否してください。\nこれからも活動を応援しております。\n\nhttps://uchinokomato.me/chara/show/251167", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rehg_2020/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1825361, "client_id": 1825638, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1611724/uploads/origins/69ea0be7-cabc-4344-86f1-ab5d64122adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b6deabffe952d330f6eced3ab4f864d", "srcset": "https://si.imgix.net/e1611724/uploads/origins/69ea0be7-cabc-4344-86f1-ab5d64122adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b6deabffe952d330f6eced3ab4f864d, https://si.imgix.net/e1611724/uploads/origins/69ea0be7-cabc-4344-86f1-ab5d64122adf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc2b43c0134add102cd424092662debc 2x, https://si.imgix.net/e1611724/uploads/origins/69ea0be7-cabc-4344-86f1-ab5d64122adf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3cfcdf88a262e8d97dd1bc29dc222fe6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1611724/uploads/origins/69ea0be7-cabc-4344-86f1-ab5d64122adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16b884d1c5e1191947b019bd65f2fe1b", "srcset": "https://si.imgix.net/e1611724/uploads/origins/69ea0be7-cabc-4344-86f1-ab5d64122adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16b884d1c5e1191947b019bd65f2fe1b, https://si.imgix.net/e1611724/uploads/origins/69ea0be7-cabc-4344-86f1-ab5d64122adf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=565404aa434f633157d0ec3eb54fc7a6 2x, https://si.imgix.net/e1