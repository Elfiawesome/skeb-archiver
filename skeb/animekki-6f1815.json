23e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9b3e2b30af09ab765cf780fcad1edec", "srcset": "https://si.imgix.net/f0a43482/uploads/origins/a758e518-7831-444a-bd39-b4245a2923e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9b3e2b30af09ab765cf780fcad1edec, https://si.imgix.net/f0a43482/uploads/origins/a758e518-7831-444a-bd39-b4245a2923e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e5cd5275069373738ee23087d8b44e7 2x, https://si.imgix.net/f0a43482/uploads/origins/a758e518-7831-444a-bd39-b4245a2923e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8c3ae330d829ab76b8eba44250395718 3x"}, "body": "ポテト様\n\nSkeb再開おめでとうです。えすと申します。\n\n友人のTofuのリクエストによって、ポテトさんが描いたイラスト\nhttps://drive.google.com/file/d/1CnR7ozzt2iyol8NL8Cu_wsWRoq_yHfTE/\n実はすごく気に入ったので、同じ感じなイラストをリクエストさせてください。\nキャラは資料URLにてのうちの娘です。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1pJqnGxZNZL5dPsbkH2fa2s64MCi9bg4U?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@animekki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3702906, "client_id": 1121265, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/348f3074/uploads/origins/95104a16-1b42-4e08-aec3-551989aa1a47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18c96029813cdf21179e28bb586f5e9a", "srcset": "https://si.imgix.net/348f3074/uploads/origins/95104a16-1b42-4e08-aec3-551989aa1a47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18c96029813cdf21179e28bb586f5e9a, https://si.imgix.net/348f3074/uploads/origins/95104a16-1b42-4e08-aec3-551989aa1a47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf49c50e6a98d225fa2059bb17611e40 2x, https://si.imgix.net/348f3074/uploads/origins/95104a16-1b42-4e08-aec3-551989aa1a47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5de9f13c1fc7c81d50f98d3cc4978772 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/348f3074/uploads/origins/95104a16-1b42-4e08-aec3-551989aa1a47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b33488ceedad874689dae330d63816af", "srcset": "https://si.imgix.net/348f3074/uploads/origins/95104a16-1b42-4e08-aec3-551989aa1a47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b33488ceedad874689dae330d63816af, https://si.imgix.net/348f3074/uploads/origins/95104a16-1b42-4e08-aec3-551989aa1a47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=844a1f6ccfe2bb5b7bd7c753919054e0 2x, https://si.imgix.net/348f3074/uploads/origins/95104a16-1b42-4e08-aec3-551989aa1a47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd1c64b75933cd662b359f0255e9e300 3x"}, "body": "こんにちは！\n\nあなたがSkebを開設されたのを見かけました。最近の『スターフォックス』のイラストを大変楽しませていただいたので、私のキャラクターを描いていただけないかと思い、ご連絡させていただきました。\n\nキャラクターの名前はグラウコスとリディアです。両方の参考画像はこちらにあります：\nhttps://imgbox.com/g/GmZX7FMUFl\n\nグラウコスは身長7フィートのフクロウ人間で、吸血鬼やモンスターを狩る王です。主な武器として巨大なビーストカッターとピストルを使います。参考画像からもわかるように、かなり筋肉質な体格をしています。\nリディアは身長6'の人間女性で、彼女もモンスターを狩っていますが、意のままに狼男に変身できるほか、夫と同様に銃の扱いに長けています。参考画像からもわかるように、彼女はアスリートのような体格をしています。\n\n二人は夫婦であり、『ダンジョンズ＆ドラゴンズ』で私が演じたオリジナルキャラクターです。\n\n二人は深く愛し合っていますが、何らかの形で二人を一緒に描いていただけないかと思い、お尋ねしています。 二人が何かと戦っているかのようなアクションポーズで描いていただいても、あるいはカジュアルでリラックスした様子で描いていただいても、どちらでも構いません。武器を構えていなくても問題ありません。あなたの解釈に任せます。この二人を題材に、素晴らしい作品を生み出してくれるのを楽しみにしています！\n\nリンク先の参考資料は自由に活用してください。\n\n追加のアドバイスとしては、二人は通常、冬を基調とした環境、あるいはタイガやツンドラのような環境に身を置いています。ファンタジー世界が舞台ですが、魔法の飛行船も利用可能です。 あるいは、もっと一般市民のような環境で描きたいという場合は、城や街の舞台も大歓迎です。そのような環境で彼らがどう描かれるか、ぜひ見てみたいです。インスピレーションの参考になるリンクも貼っておきます：\nhttps://imgbox.com/g/6y2niVlQI1\n\n重要なのは、画像の中でグラウコスとリディアが一緒に描かれていることです。\n\nぜひ楽しんで描いてみてください！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@animekki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3702906, "client_id": 1515739, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e4314ea/uploads/origins/83d2fcf0-7d8d-41d0-ac6c-93c9b3900cf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=809a008fda894cd648cb7765570261c2", "srcset": "https://si.imgix.net/9e4314ea/uploads/origins/83d2fcf0-7d8d-41d0-ac6c-93c9b3900cf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=809a008fda894cd648cb7765570261c2, https://si.imgix.net/9e4314ea/uploads/origins/83d2fcf0-7d8d-41d0-ac6c-93c9b3900cf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d497084ec40d588c86b33aad8160bf89 2x, https://si.imgix.net/9e4314ea/uploads/origins/83d2fcf0-7d8d-41d0-ac6c-93c9b3900cf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9f5cd1fbbbcc6d9c749894c3a451fff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e4314ea/uploads/origins/83d2fcf0-7d8d-41d0-ac6c-93c9b3900cf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e14ad07f1b2046c5f49c072640d6197", "srcset": "https://si.imgix.net/9e4314ea/uploads/origins/83d2fcf0-7d8d-41d0-ac6c-93c9b3900cf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e14ad07f1b2046c5f49c072640d6197, https://si.imgix.net/9e4314ea/uploads/origins/83d2fcf0-7d8d-41d0-ac6c-93c9b3900cf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=526489131d1f6f5d0f03d7a287558ce9 2x, https://si.imgix.net/9e4314ea/uploads/origins/83d2fcf0-7d8d-41d0-ac6c-93c9b3900cf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cd3920288a51655a8139304ddd7c8397 3x"}, "body": "私の忍者少年キャラクター、ミストとレイヴンの2人を描いていただけませんか？参考画像は以下に添付しています。\nhttps://drive.google.com/drive/folders/1QBrm3u6P2jLlAwK3lKpkJ57MRLH-T4zf?usp=share_link\nオレンジ色のミスト（17歳）は比較的穏やかで無口な性格ですが、青いレイヴン（16歳）は社交的で少しやんちゃな性格です。二人は幼い頃から戦友同士です。\nお二人の間のポーズややり取りは、お好きなように描いてください！すべてはあなた次第です。戦闘の構えを描いてもいいですし、どこかの居心地の良い場所でくつろいだり、寄り添ったりしている姿を描いても構いません。あなたの画風で描かれた二人をぜひ見てみたいです。\n時間をかけて、楽しんで描いてくださいね。ご協力ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1QBrm3u6P2jLlAwK3lKpkJ57MRLH-T4zf?usp=share_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 195323, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "みなべゆうり", "screen_name": "minabe_6711", "avatar_url": "https://pbs.twimg.com/profile_images/2102226772767162369/XUj3jUWm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/808206945848938496/1777117064/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 724021, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "月夜星海@営業垢", "screen_name": "hosi_huru_yoru2", "avatar_url": "https://pbs.twimg.com/profile_images/1925174105722269696/TocqU8ck.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1213468467191377923/1733499922/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 789920, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🥩肉屋 むぎ🍺", "screen_name": "ushinobero", "avatar_url": "htt