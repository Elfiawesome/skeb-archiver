はダイキ、17歳の男子高校生で、身長は189cmです。学校の設定は日本の田舎で、海が近く、青春の雰囲気があります。冷静で口数は少なく、あまり笑わないし、古風なルールは好まない。しかし、全体的にはとても心優しい少年で、他人を思いやり、常に新しいことを探求し、自由を愛する。バスケ部にも所属し、昔話や海が好きで、趣味で小さな木片を彫ることもある。\n\n日焼けした肌で、髪は赤毛で毛先が白く、白い筋が2本入っている。左目の下に2つのビューティーマークがあり、耳にピアスをしている。学生服の上にベストのセーターを着ている。\n\nあなたのスタイルで彼を見るのがとても楽しみです！描写はお好きなようにお願いします！ご検討ありがとうございました！(*^_^*)\n\nhttps://drive.google.com/drive/folders/1qJ0k9vYJQJ79ee5HJnocoeQ2gF8ClHvy", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@stmex_90/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 3541735, "client_id": 2554869, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/233c0730/uploads/outputs/dcdeffa6-2faf-42fb-831e-8b5527638af9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=8f5029a10d7754169ca2aaaaa5afc1ad", "srcset": "https://si.imgix.net/233c0730/uploads/outputs/dcdeffa6-2faf-42fb-831e-8b5527638af9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=8f5029a10d7754169ca2aaaaa5afc1ad, https://si.imgix.net/233c0730/uploads/outputs/dcdeffa6-2faf-42fb-831e-8b5527638af9?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=e26d0ae51497a2aee80e60de4d1ed7c9 2x, https://si.imgix.net/233c0730/uploads/outputs/dcdeffa6-2faf-42fb-831e-8b5527638af9?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=0730ef54224b5a74d394f679a28ce192 3x"}, "duration": 55, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/233c0730/uploads/outputs/dcdeffa6-2faf-42fb-831e-8b5527638af9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=fa36e2a3b0e66313a80ed1904e941e4e", "srcset": "https://si.imgix.net/233c0730/uploads/outputs/dcdeffa6-2faf-42fb-831e-8b5527638af9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=fa36e2a3b0e66313a80ed1904e941e4e, https://si.imgix.net/233c0730/uploads/outputs/dc