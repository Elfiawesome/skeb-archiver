f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cd3d926c49d4a9a8c5d5d92d77a2577", "srcset": "https://si.imgix.net/ea058098/uploads/origins/df562234-64ac-493d-9c36-d5199c6912cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cd3d926c49d4a9a8c5d5d92d77a2577, https://si.imgix.net/ea058098/uploads/origins/df562234-64ac-493d-9c36-d5199c6912cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1319dc3941999ab680b7cb6125e0485f 2x, https://si.imgix.net/ea058098/uploads/origins/df562234-64ac-493d-9c36-d5199c6912cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46b477e82bdfe20d5e373333025aba1e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea058098/uploads/origins/df562234-64ac-493d-9c36-d5199c6912cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f5d6c86507cff37c8aec472eda1d08a", "srcset": "https://si.imgix.net/ea058098/uploads/origins/df562234-64ac-493d-9c36-d5199c6912cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f5d6c86507cff37c8aec472eda1d08a, https://si.imgix.net/ea058098/uploads/origins/df562234-64ac-493d-9c36-d5199c6912cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cfd623f97058b4b5755e0ae3e7adaa3a 2x, https://si.imgix.net/ea058098/uploads/origins/df562234-64ac-493d-9c36-d5199c6912cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6a0928d4cfffca3f0824e469da9b4674 3x"}, "body": "烏有いぴ様\n\nはじめまして、ありのみと申します\n先生に東方projectのチルノさんと大妖精さんを\n普段の彼女達と違う服装でお願いしてもよろしいでしょうか？\n\n依頼用に２人の資料画像を用意しておりますので、もしよろしければ下記URLをご参照下さい。\nhttps://x.com/ARINOMI7/status/1911428499891532196\nあくまで個人的なイメージではありますが\n　チルノさんはツリ目系で、積極的に行動する活発で勝気な性格。\n　大妖精さんはタレ目系ジト目系で、口数少なめで消極的な性格。\n　体格に大きな差はなく２人ともお胸はぺたんこ系\n　身長も同じ位で並んで立って目線が合う感じ\n（強いて差をつけるならチルノさんの方が大きめ）\n　よく一緒にいる仲良しコンビの印象を持っています。\n