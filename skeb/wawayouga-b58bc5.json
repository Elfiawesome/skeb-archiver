@wawayouga/works/2 のようなアップで横長のイラストを希望します。\n\nキャラクターの周りに飾る猫のおもちゃやハートの風船を描いてください！その他、自由にデコレーションしてください。また、遊び心のあるセクシーなムード（ウインクしている、下唇を噛んでいるなど）で描いていただけるとありがたいです。ノースリーブのタートルネックの服と長髪でお願いします。メガネ、額のマーク、猫耳はそのままで！\n\n背景なしのバージョンも入手できるとありがたい。twitch配信で使用するので、サイズは1920x1080でお願いします！\n\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/16bN8RnmZx8lXrv4PbJyljgno4VVRSRKU?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wawayouga/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3635967, "client_id": 3602250, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/384e5395/uploads/origins/0cca810b-f6c3-4888-b069-2e320f981043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b584750911622b588196a4d485437c60", "srcset": "https://si.imgix.net/384e5395/uploads/origins/0cca810b-f6c3-4888-b069-2e320f981043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b584750911622b588196a4d485437c60, https://si.imgix.net/384e5395/uploads/origins/0cca810b-f6c3-4888-b069-2e320f981043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=804debce8d5a6863581dbaed3cea2f76 2x, https://si.imgix.net/384e5395/uploads/origins/0cca810b-f6c3-4888-b069-2e320f981043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8ab3dedab63295a347ef837db8ba1d9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/384e5395/uploads/origins/0cca810b-f6c3-4888-b069-2e320f981043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e4e82037bd73cddc04693173e955749", "srcset": "https://si.imgix.net/384e5395/uploads/origins/0cca810b-f6c3-4888-b069-2e320f981043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e4e82037bd73cddc04693173e955749, https://si.imgix.net/384