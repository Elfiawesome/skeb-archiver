%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc6d5d0558737a019f7714bc99b32516, https://si.imgix.net/b05d3229/uploads/origins/0e3d65f0-85c6-4069-bfee-6ce6bb2614e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dfa765cfb7797c6fb6506fb0f8fafe84 2x, https://si.imgix.net/b05d3229/uploads/origins/0e3d65f0-85c6-4069-bfee-6ce6bb2614e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=46808dbd8a0c6688ce55ff40b368b0af 3x"}, "body": "天井てる様！はじめまして！\n\n天井様のとても素敵な絵柄に惹かれぜひリクエストさせて頂きたいと思いご連絡致しました。\nもしご縁がありましたらよろしくお願いいたします…！\n\n描いていただきたいキャラクターが二人いて、それぞれ資料の方まとめさせて頂きました。お手数をお掛け致しますがご確認いただけますと幸いです。\n\n消防士(背景が紫の方)の男の子と僧侶の男の子になります、また二人ともTRPGというものに参加しているキャラクターになります。\n彼らが楽しそうにしているような一枚絵をお願いしたいと思っております。どちらも明るく元気な性格の持ち主の子達です。バストアップ等サイズや構図などはよろしければお任せとさせて頂きたいと思っています！！\n\nお忙しいところ申し訳ございません、もしよろしければご検討頂けますと幸いです…！\n金額が足りない場合や何か不都合がありましたらキャンセルして頂いて構いません。\nよろしくお願いいたします🙏🏻✨\n\n下記、資料になります。\n\nhttps://www.dropbox.com/scl/fi/aoagp5ft4hnuajwjhgqd1/2024-09-05-20-50-40.png?rlkey=9h18kw8wsnd0m9u1pc6zc7evs&dl=0\n\nhttps://www.dropbox.com/scl/fi/t7mfi9ec4snh5527r5bto/2024-09-01-23-30-15.png?rlkey=ejx2sdnd7a5s6qaj9xh9g13vl&dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_ameiteru/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 986070, "client_id": 1443631, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6377cdd9/uploads/origins/5743015d-073f-42ec-870e-8b83ddb34078?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=651fc7b6f3e21f7a08ab33c896dd5424", "srcset": "https://si.imgix.net/6377cdd9/uploads/origins/5743015d-073f-42ec-870e-8b83ddb34078?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=651fc7b6f3e21f7a08ab33c896dd5424, https://si.imgix.net/6377cdd9/uploads/origins/5743015d-073f-42ec-870e-8b83ddb34078?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8fa6d660dde9b8019d1f2b87947a52c8 2x, https://si.imgix.net/6377cdd9/uploads/origins/5743015d-073f-42ec-870e-8b83ddb34078?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9ac1465bc6c3d27c9966af6363e4377 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6377cdd9/uploads/origins/5743015d-073f-42ec-870e-8b83ddb34078?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=794c741c7230583d3db006184e573afe", "srcset": "https://si.imgix.net/6377cdd9/uploads/origins/5743015d-073f-42ec-870e-8b83ddb34078?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=794c741c7230583d3db006184e573afe, https://si.imgix.net/6377cdd9/uploads/origins/5743015d-073f-42ec-870e-8b83ddb34078?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=204fe1a51a971bcf5d9ea1c7d557a49e 2x, https://si.imgix.net/6377cdd9/uploads/origins/5743015d-073f-42ec-870e-8b83ddb34078?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f556989753b5bf5796822d9a28e5264 3x"}, "body": "いつもお世話になっております。\n天井様のイラストが大好きで、この度ご連絡させて頂きました。\nマルチポスト形式で複数内容を送らせて頂きますので、天井様の方で1つ選んで頂けたらと思っております。\n\nお願いしたいのは当方のオリジナルキャラクターで、オフホワイトの髪色の少年とその兄です。少年は雪豹の獣人、兄は氷を生み出して操る魔法を使えますが、要素として無理に取り入れる必要はありませんので必要に応じて描写して頂けると幸いです。\n雪の上に2人で寝そべった状態で、楽しそうに笑っている構図でお願いしたいです。\n仕事帰りに雪合戦などの雪遊びをして疲れきったあと、雪に倒れ込んだイメージです。\n少年には兄と同じ制服(正装)を着せて頂きたいのですが、帽子はなくて大丈夫です！\n参考までに、兄は子供っぽく大きく口を開けて笑う笑い方で、少年は笑顔が下手で兄より控えめです。\n\n使用用途は個人利用で、iPadなどの壁紙を想定しています。\n\n難しい場合は断って頂いても構いませんので、何卒よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/16eWN5OqiSwFPqG012ye2qN_qrV9mqoYw/view?usp=drivesdk", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_ameiteru/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/67418788/uploads/origin