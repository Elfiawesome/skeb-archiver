press&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c18f6d781e45d42be918c27563d1d5d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/013835fa/uploads/origins/fffcd460-5b6f-41a6-a939-2f998cad45d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=562bbd9d7715fd3309e88190ba2386a2", "srcset": "https://si.imgix.net/013835fa/uploads/origins/fffcd460-5b6f-41a6-a939-2f998cad45d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=562bbd9d7715fd3309e88190ba2386a2, https://si.imgix.net/013835fa/uploads/origins/fffcd460-5b6f-41a6-a939-2f998cad45d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=be2dc429dd2b2688ed5a72f1ff62202d 2x, https://si.imgix.net/013835fa/uploads/origins/fffcd460-5b6f-41a6-a939-2f998cad45d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e1f8384e3b011db8998d2983d9069841 3x"}, "body": "あなたの絵がとても好きなので、私のオリジナルキャラクターを描いてくれませんか？兄弟で、よく似ていて、二人とも羊の悪魔の角を持っている。\n\n姉は13歳くらいで、髪の色は弟より明るく、性格は弟より活発でかわいい。\n\n弟は10歳、茶色がかった赤っぽい目、ヤギのように瞳孔が横長で、そばかすが少しある。彼はより静かで、より大人しく、安定しているように見える。読書好き。\n\n参考のために彼らのイラストを持ってきた。イラストでは年齢が違います。私の描いた年齢通りに描いてほしい。日常を絵にしたような豪邸に住んでほしい。服装や装飾、ポーズなどは自由に選んでください！\n\nhttps://drive.google.com/drive/folders/103nfa5VumAIA8U_h7VnWLGWRb_QAQAip", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hono556/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1782730, "client_id": 3053006, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/843f01f8/uploads/origins/b9c8effd-8086-4cb2-a68a-3cfc4b01bda4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a80774d0edbacd610f1ee6d010ae31c9", "srcset": "https://si.imgix.net/843f01f8/uploads/origins/b9c8effd-8086-4cb2-a68a-3cfc4b01bda4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a80774d0edbacd610f1ee6d010ae31c9, https://si.imgix.net/843f01f8/uploads/origins/b9c8effd-8086-4cb2-a68a-3cfc4b01bda4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a171778b3b67b22c580c93c1707b86a2 2x, https://si.imgix.net/843f01f8/uploads/origins/b9c8effd-8086-4cb2-a68a-3cfc4b01bda4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6517381010b380ce0b2cde2b1711ba4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/843f01f8/uploads/origins/b9c8effd-8086-4cb2-a68a-3cfc4b01bda4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30323d0f274257dcb997080cca58ae57", "srcset": "https://si.imgix.net/843f01f8/uploads/origins/b9c8effd-8086-4cb2-a68a-3cfc4b01bda4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30323d0f274257dcb997080cca58ae57, https://si.imgix.net/843f01f8/uploads/origins/b9c8effd-8086-4cb2-a68a-3cfc4b01bda4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8a0763172a8c3e198de2e6eae20f9138 2x, https://si.imgix.net/843f01f8/uploads/origins/b9c8effd-8086-4cb2-a68a-3cfc4b01bda4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7ffc42dba37a597c0842c06ffd5352d3 3x"}, "body": "こんにちは、北沢きたほ先生！あなたの画風がとても好きなので、私のオークのイラストをお願いしたいです！以下は参考资料です：\n时代背景：中世ヨーロッパ, 二人とも貴族/邪教徒\nA(185cm，攻め)：\n養父\n短い銀髪とスカイブルーの瞳\nかつては穏やかな領主であったが、祖国からの裏切りにより復讐に猜疑心を抱いている。\n性格は冷淡でプライドが高く、貴族のような気品と冷徹さを併せ持つ。しかし、Bが常に彼を唯一の英雄と見なしていたため、心を動かされ、救済された。\n\nB(178cm，受け)：\n養子\n薄銀の三つ編み、バラ色の赤い瞳\n父親はAの部下で、生前Aに預けられた。戦争とホームレス生活で空虚な性格。青春時代のヒーローに出会い、Aの細やかな心遣いに救われ、復讐計画の完遂に協力することを決意する。\n彼らは最終的に邪神を利用して復讐計画を達成したが、代価も払って、養子は精神を蚕食され、最終的に養父の手によって殺された。\n Xに投稿された最新作のように、ヨーロッパ(フランス)の中世の雰囲気が溢れるシーンを見てみたいです！自由にインスピレーションを描けることを願っています。\n\nhttps://drive.google.com/drive/folders/1WSZhqSom99pW1G7WVK6f-gE-9RL5oHvn", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hono556/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1782730, "client_id": 2462364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46e088ad/uploads/origins/a19071e4-ba55-446d-9d92-f8bb6ee55446?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e98112d300efd84df5b5c59941a2d387", "srcset": "https://si.imgix.net/46e088ad/uploads/origins/a19071e4-ba55-446d-9d92-f8bb6ee55446?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e98112d300efd84df5b5c59941a2d387, https://si.imgix.net/46e088ad/uploads/origins/a19071e4-ba55-446d-9d92-f8bb6ee55446?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1242454785713e4c006dcfe994d24371 2x, https://si.imgix.net/46e088ad/uploads/origins/a19071e4-ba55-446d-9d92-f8bb6ee55446?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54c112dd29d3447d3a58a4204aaecad6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46e088ad/uploads/origins/a19071e4-ba55-446d-9d92-f8bb6ee55446?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d74fdd7493ee0fdc5511119ec48d364", "srcset": "https://si.imgix.net/46e088ad/uploads/origins/a19071e4-ba55-446d-9d92-f8bb6ee55446?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d74fdd7493ee0fdc5511119ec48d364, https://si.imgix.net/46e088ad/uploads/origins/a19071e4-ba55-446d-9d92-f8bb6ee55446?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=90b7aafaa2c2074885bbf5eec7e1b294 2x, https://si.imgix.net/46e088ad/uploads/origins/a19071e4-ba55-446d-9d92-f8bb6ee55446?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05fd7bb0661ccd625367345baa702609 3x"}, "body": "老师您好！非常抱歉打扰到您，我无意间看见了您的作品，一下就被吸引了。不知道您是否愿意为我家的一对oc绘制互动插图作品！（如果可以的话，希望能请您考虑图片23,24上的服饰）\n↓以下是他们的简单的性格介绍和要求\n\n两人所处的时代都是20世纪\n（Bottom）康斯坦丁：24岁，金发红瞳，182cm，高瘦，体态纤细，举止优雅。康斯坦丁是贵族，家族十分富有，父母和兄长都很宠爱他。康斯坦丁很聪明优秀，虽然有贵族脾气，高傲且自尊心强，是个待人亲和但却会让人有距离感的人。在提前从大学毕业后从事起了文学专业，在写作和新闻业都有举足轻重的地位，因为聪明的头脑，偶尔会被警察请求帮忙侦查一些案件。他很欣赏维拉卡斯，这种欣赏在日后因为有了共同的秘密后成为了喜爱。\n\n（Top）维拉卡斯：21岁，186cm，棕色微卷发，绿眼，标准的身材，温和有礼。维拉卡斯是家庭比较富裕的平民，是康斯坦丁的助手。因为崇拜康斯坦丁，所以来到了对方的新闻社应聘，并被选中做了助手。会在生活起居上照顾康斯坦丁，很听话，看起来像是忠犬一样的角色，对康斯坦丁很依赖。\n\n当然如果您觉得图片23,24上的服饰绘制起来麻烦的话，您也可以随意地选择任何您想绘制的服饰！倘若不符合金额的情况下，如果能请您再发送再发请求的话就帮大忙了！若您觉得有些麻烦的话直接取消也可以。如果您能接下这次的委托真是万分感谢！\n\nhttps://drive.google.com/drive/folders/1mP_-_aYjvuPUdyoPB12Sek3bUxpMOry1?usp=share_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hono556/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1782730, "client_id": 2459698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6514708f/uploads/origins/bdfbfc49-72c1-40b8-82e9-eb37e094f8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da4c8b5138b981e9fe2451bf736fd72d", "srcset": "https://si.imgix.net/6514708f/uploads/origins/bdfbfc49-72c1-40b8-82e9-eb37e094f8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da4c8b5138b981e9fe2451bf736fd72d, https://si.imgix.net/6514708f/uploads/origins/bdfbfc49-72c1-40b8-82e9-eb37e094f8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc3eb6f74ed087fd6123acfda2ae9012 2x, https://si.imgix.net/6514708f/uploads/origins/bdfbfc49-72c1-40b8-82e9-eb37e094f8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5dd0c5c9753ea9f059cdd1e8f457204b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6514708f/uploads/origins/bdfbfc49-72c1-40b8-82e9-eb37e094f8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34c686a9f8f793b91293f9de8e6d1a73", "srcset": "https://si.imgix.net/6514708f/uploads/origins/bdfbfc49-72c1-40b8-82e9-eb37e094f8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34c686a9f8f793b91293f9de8e6d1a73, https://si.imgix.net/6514708f/uploads/origins/bdfbfc49-72c1-40b8-82e9-eb37e094f8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe7a0a89684f92d43dbab85753251cd6 2x, https://si.imgix.net/6514708f/uploads/origins/bdfbfc49-72c1-40b8-82e9-eb37e094f8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a531c8dab7cb9686add2584e948bc004 3x"}, "body": "こんにちは、先生！先生の美しい画風が本当に大好きで、私のOCのペアのイラストをお願いしたいです^^。  \n「バーボン」：白いカールのキャラクターは、若いヴァンパイアの女の子で、機械工です。赤い目、淡い肌の色、かわいい小さな牙、右足は義足で、おてんば娘と小悪魔のミックスです。\n「アンゴスチュラ」：黒髪のキャラクターはアンデッドの司祭で外科医、黒い目、アイボリーの肌の色、しわがある。親しみやすく温厚そうに見えるが、威圧的で道徳心がまったくない。\n二人は1880年代のアメリカ南部ゴシックの舞台で超自然的な存在を扱うビジネス・パートナーでありエクソシストであり、ちょっと娘と父親のような非ロマンチックな関係にある。少女は男をおもちゃや食料源として扱い、男は少女を人間ではなく貴重な資産として見ている。  \nリクエストに関しては、特にありません。衣装や設定を自由に選んで描いてください！下書きがあればお預かりします。\n\nhttps://drive.google.com/drive/folders/1U7uD9l4i3K2XXExYsZpChwFGQBo9tFei?usp=share_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 672778, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "souma🌴", "screen_name": "log_souma", "avatar_url": "https://pbs.twimg.com/profile_images/1300271157891850240/F5hpI26C.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1299620695417131013/1656774680/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 1}, {"id": 2066457, "creator": true, 