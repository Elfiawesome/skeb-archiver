或いは同じ構図で一向に構いません。\n衣装や装飾品、背景等はおまかせ（変更、省略可）でお願いします。\n\n☆用途\n凄井カプリのFAとして、FAタグ（#凄井アート）を付けてSNS上で公開或いは拡散させていただきます。\n用途としては、「Youtube配信、動画内及びサムネイルへの利用」「SNS上での公開、アイコン、ヘッダー利用」として、本人にお伝えいたします。\n\n☆納品形式\nPSD若しくは透過PNGデータでの納品を希望します。\n\n☆参考\n資料（随時更新）保存先：\nhttps://drive.google.com/drive/folders/1Dp-SmEnOFwDz07QNYASs9IR9xOltMFaY?usp=drive_link\n\n凄井カプリX：\nhttps://x.com/sugoi_capri\n\nご検討のほどよろしくお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ichigotonyu102/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3313446, "client_id": 3303057, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57117173/uploads/origins/04231f47-6338-4819-8e89-936ee158607e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=197e246e2b3a2cdd193810cc0f4b204b", "srcset": "https://si.imgix.net/57117173/uploads/origins/04231f47-6338-4819-8e89-936ee158607e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=197e246e2b3a2cdd193810cc0f4b204b, https://si.imgix.net/57117173/uploads/origins/04231f47-6338-4819-8e89-936ee158607e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2deb4d552835e9e666df25c555fea2f 2x, https://si.imgix.net/57117173/uploads/origins/04231f47-6338-4819-8e89-936ee158607e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcd6da511b1a4fb3e75a30b91ddd3579 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57117173/uploads/origins/04231f47-6338-4819-8e89-936ee158607e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93eb8f689245bf3b112c91ad3928be8b", "srcset": "https://si.imgix.net/57117173/uploads/origins/04231f47-6338-4819-8e89-936ee158607e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93eb8f689245bf3b112c91ad3928be8b, h