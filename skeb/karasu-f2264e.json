1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a18f3fae74f5c86e9a69afa7637eda9", "srcset": "https://si.imgix.net/7af5dbc5/uploads/origins/71cad043-d514-4fc5-aa41-e6c800b53041?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a18f3fae74f5c86e9a69afa7637eda9, https://si.imgix.net/7af5dbc5/uploads/origins/71cad043-d514-4fc5-aa41-e6c800b53041?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3560f6b84849520b9e9591d20c0a1cac 2x, https://si.imgix.net/7af5dbc5/uploads/origins/71cad043-d514-4fc5-aa41-e6c800b53041?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4bbe24732be02be5d0f7c7e16d7c4a9 3x"}, "body": "私のオリジナルキャラクターが走りながら変身するところを描いてください！変身は4段階です。format1やformat2のようなイラストを希望します。\n\n変身前：160cm\n変身後：185cm\n\nhttps://ln5.sync.com/dl/d53751f10#zpp399ye-da48v3bp-62tutx4g-dfyktcdf", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karasu/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1798216, "client_id": 74921, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52872bde/uploads/origins/99d2c29f-eff2-48e2-9caf-14eff63d9d54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9a9f4425db3c9c8ac2fdd815dd4a4a1", "srcset": "https://si.imgix.net/52872bde/uploads/origins/99d2c29f-eff2-48e2-9caf-14eff63d9d54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9a9f4425db3c9c8ac2fdd815dd4a4a1, https://si.imgix.net/52872bde/uploads/origins/99d2c29f-eff2-48e2-9caf-14eff63d9d54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab039482c2153d24bcc1ae5e22a135d3 2x, https://si.imgix.net/52872bde/uploads/origins/99d2c29f-eff2-48e2-9caf-14eff63d9d54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73d7409aa814468244b70681ade04f27 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52872bde/uploads/origins/99d2c29f-eff2-48e2-9caf-14eff63d9d54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8fc054c67aa6a0920cc30557414f5b5", "srcset": "https://si.imgix.net/52872bde/uploads/origins/99d2c29f-eff2-48e2-9caf-14eff63d9d54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8fc054c67aa6a0920cc30557414f5b5, https://si.imgix.net/52872bde/uploads/origins/99d2c29f-eff2-48e2-9caf-14eff63d9d54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d6210f523c3318ebb944b434df71b7c4 2x, https://si.imgix.net/52872bde/uploads/origins/99d2c29f-eff2-48e2-9caf-14eff63d9d54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b137e464b34b48667b4d5af1d87bb572 3x"}, "body": "お久しぶりです\nまたカラス先生のグリズリーさんが見たくなりリクエスト送らせて頂きました\n\n今回も二次創作イラストで、グリズリーに資料画像のチャイナドレスを着せて、潜入任務でルームサービスを装ってターゲットを襲撃しようと扉の前に立つ彼女の姿を描いて頂きたいです\n\nグリズリーの髪型は資料一枚目の星夜の舞踏会スキンの髪型にし、画像四枚目の参考資料イラストのように右手にLARグリズリーを持たせて片手に資料二枚目の青島ビールを2〜3本載せた銀の丸いおぼんを持たせてください、ただ青島ビールはvectorが持っていそうな布を突っ込んだ火炎瓶仕様にしてください\nまた、料金に余裕があれば腰部分にリプライ資料の青龍刀を装備して頂きたいです(アークナイツのチェンのように吊るす形で)\n\n構図は参考資料イラストのように背面とお尻をこちらに向けてください、それ以外の構図やポーズ、細かい部分はお任せいたします(顔は横顔にして頂いても大丈夫です)\n\nhttps://x.com/clone_7777/status/1995665424781062303?s=46&t=gw2fdmP6R4QXQI_Cwo1mBw", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karasu/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1798216, "client_id": 3582058, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb81feac/uploads/origins/bb2f4020-ee63-491e-a571-604cd21e8cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ba89de10feea6a633f6afc95c47fd30", "srcset": "https://si.imgix.net/bb81feac/uploads/origins/bb2f4020-ee63-491e-a571-604cd21e8cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ba89de10feea6a633f6afc95c47fd30, https://si.imgix.net/bb81feac/uploads/origins/bb2f4020-ee63-491e-a571-604cd21e8cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed32aadb4e6e47a83fbbf7422a501f97 2x, https://si.imgix.net/bb81feac/uploads/origins/bb2f4020-ee63-491e-a571-604cd21e8cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85ca3623ac5e8d926c5a85a8109bbcd1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb81feac/uploads/origins/bb2f4020-ee63-491e-a571-604cd21e8cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2cb2e48026c1f19c3237ad7e7c7375d7", "srcset": "https://si.imgix.net/bb81feac/uploads/origins/bb2f4020-ee63-491e-a571-604cd21e8cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2cb2e48026c1f19c3237ad7e7c7375d7, https://si.imgix.net/bb81feac/uploads/origins/bb2f4020-ee63-491e-a571-604cd21e8cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=933cbc429e21f31fa21e7e1ca6c43abf 2x, https://si.imgix.net/bb81feac/uploads/origins/bb2f4020-ee63-491e-a571-604cd21e8cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=58c304932125d1a76a79fd32c3cb4248 3x"}, "body": "あなたの絵がとても好きで、友人へのプレゼントとしてイラストを依頼したいと思っています。\n\n私の友人はアリリアというvtuberです。彼女のvtuberのモデルはこんな感じです：\nhttps://drive.google.com/file/d/1xxn8EKWz9uZsySIyqLBu2XqwMTg0bhU6/view?usp=sharing\n\nアリリアにはbalooというクマのマスコットがいます。バルーはこんな感じ：\nhttps://drive.google.com/drive/folders/1nOVZpYtXDflEAa6VWkZVRas_zJxsEnTF?usp=sharing\n\n夏のビーチで、パラソルの下、椅子に座っているアリリアと、アリリアの膝の上に座っているバルーを描いてください。\nアリリアとバルーがピザを食べているところを描いてください。\nアリリアがホットパンツとビキニを着て、蝶のピンをつけているところを描いてください。\n\nこのイラストの参考とインスピレーションとして、あなたの過去の作品を使用してください：\nhttps://skeb.jp/@karasu/works/6\n\nその他のリクエスト\nバルーがいないバージョンや、イラストに文字（Thank youなど）が入っていないバージョンも納品していただけると嬉しいです。\n\nありがとうございました！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karasu/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1798216, "client_id": 1310454, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93ce9bab/uploads/origins/e84fab3f-6cc3-45f8-807b-ef75a827d7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b896494e37159f6bc30db6b560e7f2af", "srcset": "https://si.imgix.net/93ce9bab/uploads/origins/e84fab3f-6cc3-45f8-807b-ef75a827d7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b896494e37159f6bc30db6b560e7f2af, https://si.imgix.net/93ce9bab/uploads/origins/e84fab3f-6cc3-45f8-807b-ef75a827d7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0680d4ac6c925852da7c06ef4300951c 2x, https://si.imgix.net/93ce9bab/uploads/origins/e84fab3f-6cc3-45f8-807b-ef75a827d7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ec565b37a9dbc1c4bd502a7b71efef5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93ce9bab/uploads/origins/e84fab3f-6cc3-45f8-807b-ef75a827d7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47ccf51e1c1f298e1c7df386982736d6", "srcset": "https://si.imgix.net/93ce9bab/uploads/origins/e84fab3f-6cc3-45f8-807b-ef75a827d7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47ccf51e1c1f298e1c7df386982736d6, https://si.imgix.net/93ce9bab/uploads/origins/e84fab3f-6cc3-45f8-807b-ef75a827d7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=31ba3c32395750feb868c45ab71e6d8e 2x, https://si.imgix.net/93ce9bab/uploads/origins/e84fab3f-6cc3-45f8-807b-ef75a827d7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=06d01b7efbc090d161e718e243ca4dcd 3x"}, "body": "カラス様\n\nはじめまして。個人Vtuberの一ノ瀬エルマと申します。\nskeb巡回していたところ作品をお見掛けしました。\nとても魅力的なイラストの数々に惹かれ、リクエストを送らせて頂きました。\n\n■依頼内容\nラビットホールのバニー衣装の私(一ノ瀬エルマ)を描いて頂きたいです。\nイラストの構図はこちらのベッドに寝そべるイメージで描いて頂きたいです。\nhttps://x.com/K_R_S/status/1465622929509523458/photo/1\n\n・髪はミディアムカールヘアで描いて頂きたいです。\n・両手を頭の上で手錠されて、両腋が見えるポーズでお願いします。\n・表情はこちらの作品のように挑発的で恍惚として感じでお願いします。\n　https://skeb.jp/@karasu/works/3\n・その他は描きやすいようにアレンジして頂いて大丈夫です(盛り大歓迎です！)\n\n■参考資料\nこちらの1枚目のミディアムカール姿でお願いしたいです。\nhttps://twitter.com/1nose_elma/status/1667136250825027584/photo/1\n\n詳細の姿はこちらの動画を参考にして頂けると幸いです。\nhttps://youtu.be/_JDjZTy2Bbg\n\n■使用用途\nYoutube等のVtuber活動内で使用予定です。\n\n■その他希望\n活動内で使用させて頂きたく、透過版も納品して頂けると嬉しいです。\n\n描いて頂きたい姿の3面図がない為、ご不便をおかけします。\nご縁がございましたら、よろしくお願い致します。\n\n一ノ瀬エルマ\n\nhttps://twitter.com/1nose_elma", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karasu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1798216, "client_id": 99166, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a7e079f/uploads/origins/94f42908-b683-4c55-99a7-081b12fdf4a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=215cdf6e880d06ef044ec96c2d3d9ecf", "srcset": "https://si.imgix.net/1a7e079f/uploads/origins/94f42908-b683-4c55-99a7-081b12fdf4a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=215cdf6e880d06ef044ec96c2d3d9ecf, https://si.imgix.net/1a7e079f/uploads/origins/94f42908-b683-4c55-99a7-081b12fdf4a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1677053d54942b219c8c0493c0e6ceec 2x, https://si.imgix.net/1a7e079f/uploads/origins/94f42908-b683-4c55-99a7-081b12fdf4a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86d5c19519da9890eb348ffac90cf51e 3x"}, "duration": null, "nsfw": 