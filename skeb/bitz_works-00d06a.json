origins/4eb077d9-e848-4205-bf21-bde96c9f5bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51b06500b95c7eb5a14bf54eb6d270a3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb1876e3/uploads/origins/4eb077d9-e848-4205-bf21-bde96c9f5bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eae8ef7876d4dd361a429b2f670010f1", "srcset": "https://si.imgix.net/cb1876e3/uploads/origins/4eb077d9-e848-4205-bf21-bde96c9f5bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eae8ef7876d4dd361a429b2f670010f1, https://si.imgix.net/cb1876e3/uploads/origins/4eb077d9-e848-4205-bf21-bde96c9f5bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d35c5b7fe52702626805448b6b822ecf 2x, https://si.imgix.net/cb1876e3/uploads/origins/4eb077d9-e848-4205-bf21-bde96c9f5bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=60ecf4c438633b5bab508194240f3dc7 3x"}, "body": "bitzさんこんにちは、みたまと申します\n今回はbitzさんの絵柄で自キャラを是非見たいと思っていたので、依頼させていただきたいと思い参りました\n\n\n内容\n◾︎クトゥルフ神話より邪神擬人化\n・クトゥルフ https://twitter.com/shiromantou/status/1509056342140792843?s=46&t=avuCtV46YbysmDohpohIKg\n\nbitzさんの描かれるカメンズのルーイがすごく好きで、ぜひ同じくダウナーであるうちのクトゥルフを描いて頂きたいと思っていました！(彼とは違って細ガリではあるんですが)\nポーズや構図はお任せで特に指定はありません、マスクの中身も差分等は無くて大丈夫です！\n全力のダウナーなので全てが万事面倒くさそうな感じでして貰えるとうれしいです\nbitzさんの作風が好きなのでどんなタッチでも構いませんが、ポップさの中になんか不穏さが滲み出てる感じを可能であれば出して頂きたいです(一応邪神なので)\n\nお忙しいところ恐れ入りますが、ご検討いただけますと幸いです\n無理そうな時は遠慮なくキャンセルしていただいて大丈夫ですので、その時は遠慮なく突っぱねちゃってください！\nみたま\n\nhttps://twitter.com/shiromantou/status/1509056342140792843?s=46&t=avuCtV46YbysmDohpohIKg", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bitz_works/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3189339, "client_id": 3223881, "vtt_url": null, "t