\n・サムネ等に使用する可能性がある都合で、人物の頭が見切れない形で描写していただけますと幸いです。\n\n---\n\nリクエスト内容と異なる部分があっても問題ございません。\n藤様の描きやすいように描いていただけると嬉しいです。\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1AowrlJwDkVCqLvNc_oxsVYE89zlSvx44?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_3xens/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2051446, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cdbe63b9/uploads/origins/2a49eac0-98e3-4357-8918-419da9603a03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b784ce79a780d8d2b35cc8c6c5c4d7a2", "srcset": "https://si.imgix.net/cdbe63b9/uploads/origins/2a49eac0-98e3-4357-8918-419da9603a03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b784ce79a780d8d2b35cc8c6c5c4d7a2, https://si.imgix.net/cdbe63b9/uploads/origins/2a49eac0-98e3-4357-8918-419da9603a03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f68d49a3a4e2bdffff3c0b1cb903b19 2x, https://si.imgix.net/cdbe63b9/uploads/origins/2a49eac0-98e3-4357-8918-419da9603a03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=466fa0884bc3633477a49399ce67d485 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cdbe63b9/uploads/origins/2a49eac0-98e3-4357-8918-419da9603a03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=216e742a1c23b573143fc6db5850c26b", "srcset": "https://si.imgix.net/cdbe63b9/uploads/origins/2a49eac0-98e3-4357-8918-419da9603a03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=216e742a1c23b573143fc6db5850c26b, https://si.imgix.net/cdbe63b9/uploads/origins/2a49eac0-98e3-4357-8918-419da9603a03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=86cabbf848a90ad025e41c8fa5