3\u3066\u7acb\u3063\u3066\u3044\u307e\u3059\u3002\n\nMk48\u304c\u512a\u3057\u304f\u5fae\u7b11\u307f\u306a\u304c\u3089LWMMG\u306e\u9996\u306e\u30ea\u30dc\u30f3\u3092\u7d50\u3093\u3067\u304f\u308c\u3066\u3044\u308b\u30b7\u30fc\u30f3\u3067\u3059\u3002\n\n\u819d\u4e0a\u306e\u5168\u8eab\u7d75\u3067\u30d2\u30c3\u30d7\u30e9\u30a4\u30f3\u3068\u80f8\u306e\u30e9\u30a4\u30f3\u304c\u3088\u304f\u51fa\u308b\u3088\u3046\u306b\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\n\u5de6\u5074\u304cMk48\n\u53f3\u5074\u304cLWMMG\n\na) Mk48\n\u6a2a\u9854\u304c\u898b\u3048\u308b\u3088\u3046\u306b\u63cf\u3044\u3066\u304f\u3060\u3055\u3044\u3002\n(F\u5b57\u306e\u9aea\u98fe\u308a\u306f\u5fd8\u308c\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002)\n\n\u8996\u7dda\u306e\u65b9\u5411\u53ca\u3073\u8868\u60c5\u306f\u4e0a\u306e\u4f8b\u793a\u30a4\u30e9\u30b9\u30c8\u3092\u3054\u53c2\u7167\u304f\u3060\u3055\u3044\u3002\n\nb) LWMMG\nLWMMG\u306f\u9854\u3092\u6a2a\u306b\u5411\u3051\u3066\u753b\u9762\u306e\u9685\u306e\u65b9\u5411\u306b\u8996\u7dda\u3092\u5411\u3051\u3066\u3044\u307e\u3059\u3002\n(\u3059\u306d\u305f\u3088\u3046\u306a\u8868\u60c5\u3067\u3059\u3002)\n\n\u9854\u306b\u306f\u7d05\u6f6e\u304c\u898b\u3048\u307e\u3059\u3002\n\n\u4e21\u62f3\u3092\u5f37\u304f\u63e1\u3063\u3066\u3044\u307e\u3059\u3002\n\n3.\u4f53\u578b\nMk48\u306e\u4f53\u683c\u304cLWMMG\u3088\u308a\u5c11\u3057\u5927\u304d\u3044\u3067\u3059\u3002\n\nMk48\u306f\u30b0\u30e9\u30de\u30fc\u306a\u4f53\u578b,\nLWMMG\u306f\u30b9\u30ec\u30f3\u30c0\u30fc\u306a\u4f53\u578b\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\n3.\u8863\u88c5\n2\u4eba\u3068\u3082\u3001\u4ee5\u4e0b\u306e\u3088\u3046\u306a\u6c34\u7740\u30e1\u30a4\u30c9\u670d\u3092\u7740\u3066\u3044\u307e\u3059\u3002\n(https://www.pixiv.net/artworks/80891757)\n\n\u9aea\u306e\u30ab\u30c1\u30e5\u30fc\u30b7\u30e3\u306b\u3042\u308b\u30d5\u30ea\u30eb\u306f\u306a\u3044\u3088\u3046\u306b\u63cf\u3044\u3066\u304f\u3060\u3055\u3044\u3002\n\n\u80cc\u666f\u306f\u81ea\u7531\u306b\u304a\u9858\u3044\u3057\u3