\u304d\u3087\u3046)27\u6b73\u5973\n\u25cf\u5f7c\u65b9\u306b\u541b\u3092\u6367\u3050(HO4/10\u4ee3\u5f8c\u534a\u5973)\n\u2192\u5473\u751f \u30bb\u30fc\u30e9(\u307f\u306e\u3046\u305b\u30fc\u3089)\u5b9d\u77f3\u5546\u5bb6\u306e18\u6b73\n\u25cfOC\u3067A'run\n\n\u25cf\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u63cf\u5199\u7bc4\u56f2\nTRPG\u7acb\u3061\u7d75\u00d71(\u4eba\u306e\u59ff\u3068\u9bab\u5973)\nTRPG\u7acb\u3061\u7d75\u00d71(\u6b66\u5668\u7121\u3057\u3068\u6709)\nOC\u30d0\u30b9\u30c8\u30a2\u30c3\u30d71\u679a\u7d75(\u8868\u60c5\u5dee\u5206)\n\u2192\u30df\u30cb\u30ad\u30e3\u30e9\u30b5\u30a4\u30ba\u3067\u3082\u3044\u3044\u3067\u3059\n\u203b\u8868\u60c5\u5dee\u5206\u3084\u6b66\u5668\u5dee\u5206\u306f\u96e3\u3057\u3044\u3051\u308c\u3070\u30ca\u30b7\u3067\n\n\u25cf\u753b\u50cf\u30b5\u30a4\u30ba\n\u7e26\u578b\u3067\u304a\u4efb\u305b\u3057\u307e\u3059\n\u3044\u3064\u3082\u4f7f\u3063\u3066\u308b\u7acb\u3061\u7d75\u306f(1248\u00d71824)\n\n\u25cf\u80cc\u666f\u306e\u6709\u7121\u30fb\u8863\u88c5\u306e\u5e0c\u671b\n\u7acb\u3061\u7d75\uff1a\u80cc\u666f\u306a\u3057\nOC\uff1a\u304a\u4efb\u305b\n-----------\n\u7acb\u3061\u7d75\uff1a\u8863\u88c5\u30ad\u30e3\u30e9\u30c7\u30b6\u30a4\u30f3\u306f\u304a\u4efb\u305b\u3067\uff01\n\n\u25cf\u63cf\u3044\u3066\u307b\u3057\u3044\u30ad\u30e3\u30e9\u306e\u8cc7\u6599\n\u3010\u7acb\u3061\u7d75\u3011\uff0a\u5bb9\u59ff\u304a\u4efb\u305b\n20\u524d\u534a\u5973\u306e\u5b50\u00d7\u9bab\u00d7\u9aa8(\u5316\u3051\u7269)\n\u2192\u4eba\u9593\u306e\u6642(\u30cf\u30c3\u30ab\u30fc)\n\u2192\u96fb\u8133\u306e\u4e16\u754c\u3067\u9aa8\u3068\u9b5a\u3092\u307e\u3068\u3063\u3066\u308b\u9bab\u5973\u306e\u5b50\n    \uff0a\u4f53\u306e\u30bf\u30c8\u30a5\u30fc\u3068\u30ae\u30b6\u6b6f\u3068\u91d1\u76ee\u3060\u3051\u5e0c\u671b\n--------------------\n\u3010\u7acb\u3061\u7d75\u3011\uff0a\u5bb9\u59ff\u304a\u4efb\u305b\n18\u6b73\u306e\u751f\u610f\u6c17\u30e1\u30b9\u30ac\u30ad\n\u89aa\u304c\u5b9d\u77f3\u5546\u5bb6\u3067\u3082\u88cf\u3067\u306f\u30ae\u30e3\u30f3\u30b0\u306e\u751f\u307