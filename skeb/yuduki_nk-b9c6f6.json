！)\n\n希望する構図は以下です。\n・頭身絵でも、デフォルメでもどちらでも大丈夫です。作成しやすい方におまかせします。\n・左向き希望、ポーズはなくても良いです(バストアップでもOKです、もし手がうつる構図なら、両手とも黒の手袋をしています。)\n・こっちを不機嫌そうに見ている感じ\n・背景は水色系を希望します。柄ありでも、無地でも良いです。おまかせします。\n\nよろしくお願いいたします！", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuduki_nk/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2548577, "client_id": 3717208, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2dd66786/uploads/origins/ecaee1e4-408b-49aa-83ad-a0227cf98953?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=615f25ff76fbcb27304029ef43b99ace", "srcset": "https://si.imgix.net/2dd66786/uploads/origins/ecaee1e4-408b-49aa-83ad-a0227cf98953?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=615f25ff76fbcb27304029ef43b99ace, https://si.imgix.net/2dd66786/uploads/origins/ecaee1e4-408b-49aa-83ad-a0227cf98953?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bc1a074a7b2b76beec71eecd74acbc2 2x, https://si.imgix.net/2dd66786/uploads/origins/ecaee1e4-408b-49aa-83ad-a0227cf98953?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d80644d13e05585b6960e29a27289797 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2dd66786/uploads/origins/ecaee1e4-408b-49aa-83ad-a0227cf98953?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8be7a5d3da4094a6dfc697c613827e8d", "srcset": "https://si.imgix.net/2dd66786/uploads/origins/ecaee1e4-408b-49aa-83ad-a0227cf98953?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8be7a5d3da4094a6dfc697c613827e8d, https://si.imgix.net/2dd66786/uploads/origins/ecaee1e4-408b-49aa-83ad-a0227cf98953?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a2aec48639911bf9ae8ba9b7