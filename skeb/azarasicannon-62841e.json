ましたら申し訳ございません。\n\n以上。ご検討いただければ幸いです。\n\nhttps://x.com/azarasicannon/status/1836059010916634656", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 214024, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🏳", "screen_name": "3hkokki", "avatar_url": "https://pbs.twimg.com/profile_images/1617199424203288576/uEaxWKQM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/309014027/1754371092/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 707127, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🦄さとう鍋♎️", "screen_name": "satouankou0383", "avatar_url": "https://pbs.twimg.com/profile_images/1687117993351032832/rTMDesY4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/772743185390903296/1690429736/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "novel"}], "banned": false, "nc": 161}, {"id": 754517, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "炬善（ごぜん）", "screen_name": "ProjectN_Mly12x", "avatar_url": "https://pbs.twimg.com/profile_images/1700833660210139136/n3Nx940w.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1573989979709005824/1722182374/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 90, "skills": [{"genre": "novel"}], "banned": false, "nc": 128}, {"id": 2173498, "cr