59\u3002\u5927\u5909\u6c17\u306b\u5165\u3063\u3066\u304a\u308a\u3001\u611b\u7528\u3057\u3066\u304a\u308a\u307e\u3059\u3002\n\u518d\u5ea6\u897f\u5712\u5bfa\u69d8\u3078\u518d\u5ea6\u4f9d\u983c\u3092\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u305f\u304f\u53c2\u308a\u307e\u3057\u305f\u3002\n\n\u25c6\u30ea\u30af\u30a8\u30b9\u30c8\u5185\u5bb9\n\u79c1\u306e\u4f5c\u6210\u3057\u3066\u3044\u308bTRPG\u306e\u30b7\u30ca\u30ea\u30aa\u306e\u30c8\u30ec\u30fc\u30e9\u30fc\u3002\n\u8868\u7d19\u306b\u52a0\u3048\u3066\u6982\u8981\u306a\u3069\u304c\u66f8\u304d\u3084\u3059\u3044\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u7684\u306a1\u679a(\u8868\u7d19\u306e\u6587\u5b57\u629c\u304d\u5dee\u5206\u7b49\u306e\u7c21\u6613\u7684\u306a\u3082\u306e\u3084\u4e0b\u5730\u306a\u3069\u3092\u30a4\u30e1\u30fc\u30b8\u3057\u3066\u3044\u307e\u3059)\u306e\u4e8c\u679a\u304c\u3042\u308b\u3068\u5b09\u3057\u3044\u3067\u3059(\u8868\u7d19\u306e\u307f\u3067\u3082\u5168\u304f\u69cb\u3044\u307e\u305b\u3093)\u3002\n\u6982\u8981\u306f\u4e0b\u8a18\u306b\u8a73\u7d30\u3092\u8f09\u305b\u307e\u3059\u304c\u3001\u307e\u3060\u672a\u5b8c\u6210\u3067\u3042\u308a\u4eca\u5f8c\u8ffd\u52a0\u3057\u3066\u3044\u304f\u53ef\u80fd\u6027\u304c\u3042\u308b\u305f\u3081\u3001\u30bf\u30a4\u30c8\u30eb\u4ee5\u5916\u3092\u8f09\u305b\u308b\u5fc5\u8981\u306f\u3054\u3056\u3044\u307e\u305b\u3093\u3002\n\u203b\u30a4\u30e9\u30b9\u30c8\u306e\u4f9d\u983c\u3067\u306f\u306a\u3044\u306e\u3067\u3001\u96e3\u3057\u3044\u5834\u5408\u306f\u30a4\u30e1\u30fc\u30b8\u30a4\u30e9\u30b9\u30c8\u3092\u304a\u9858\u3044\u3067\u304d\u308c\u3070\u3068\u601d\u3044\u307e\u3059(1\u679a)\u3002\n\u30a4\u30e1\u30fc\u30b8\u306e\u5834\u5408\u306f\u4e0b\u8a18\u6587\u7ae0\u7b49\u3092\u53c2\u8003\u306b\u601d\u3046\u307e\u307e\u306b\u66f8\u3044\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u5e78\u3044\u3067\u3059\u3002\n\u307e\u305f\u3001\u30a4\u30e9\u30b9\u30c8\u3067\u3001\u4eba\u7269\u3092\u5165\u308c\u308b\u5834\u5408\u306f\u7537\u6027\u3060\u3068\u5b09\u3057\u3044\u3067\u3059(\u30d6\u30ed\u30de\u30f3\u30b9\u3092\u60f3\u5b9a\u3057\u3066\u3044\u308b\u305f\u3081)\u3002\n\n\u307e\u305f\u3001\u3082\u3057\u8ca9\u58f2\u3059\u308b\u5834\u5408\u306f\u5546\u54c1\u306b\u6dfb\u4ed8\u3057\u307e\u3059\u306e\u3067\u3001\u96e3\u3057\u3044\u5834\u5408\u306f\u304a\u65ad\u308a\u3044\u305f\u3060\u3051\u308b\u3068\u5e78\u3044\u3067\u3059\u3002\n\u203b\u78ba\u5b9f\u306b\u8ca9\u58f2\u3059\u308b\u308f\u3051\u3067\u306f\u3054\u3056\u3044\u307e\u305b\u3093\u3002\n\u4f7f\u7528\u3057\u3066\u3044\u308b\u30b7\u30b9\u30c6\u30e0\u306f\u30af\u30c8\u30a5\u30eb\u30d5\u795e\u8a71TRPG\u3067\u3059\u3002\u305f\u3060\u3001\u5546\u6a19\u7b49\u306e\u554f\u984c\u304c\u3042\u308b\u304b\u3068\u306f\u601d\u3046\u306e\u3067\u3001\u30b7\u30b9\u30c6\u30e0\u540d\u306e\u8a18\u5165\u306f\u3057\u306a\u304f\u3066\u554f\u984c\u3054\u3056\u3044\u307e\u305b\u3093(\u5f8c\u3067\u79c1\u304c\u52a0\u7b46\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059)\u3002\n\n\u25c6\u5e0c\u671b\n\u8d64\u3001\u30ef\u30a4\u30f3\u30ec\u30c3\u30c9(\u8d64\u7d2b)\u3001\u9ed2\u3001\u767d\u306a\u3069\u306e\u8272\u5408\u3044\u3092\u4f7f\u7528\u3057\u305f\u3084\u3084\u683c\u5f0f\u3070\u3063\u305f\u96f0\u56f2\u6c17\u3002\n\u305d\u308c\u4ee5\u5916\u306f\u81ea\u7531\u306b\u4f5c\u6210\u3057\u3066\u3044\u305f\u3060\u304d\u305f\u304f\u5b58\u3058\u307e\u3059\u3002\n\n\u25c6\u30b7\u30ca\u30ea\u30aa\u6982\u7565\u3068\u8a73\u7d30(\u53c2\u8003)\n\u203b\u5168\u3066\u8aad\u3080\u5fc5\u8981\u306f\u5168\u304f\u3054\u3056\u3044\u307e\u305b\u3093\u3002\n\u30bf\u30a4\u30c8\u30eb\uff1aDie G\u00f6ttlichen Saiten\uff08\u30c7\u30a3\u30fb\u30b2\u30c3\u30ea\u30d2\u30a7\u30f3\u30fb\u30b6\u30a4\u30c6\u30f3\uff09\n\u203bDie G\u00f6ttlichen Saiten\u306f\u30c9\u30a4\u30c4\u8a9e\u3067\u300c\u795e\u306e\u5f26\u300d\u306e\u610f\n\u30a4\u30e1\u30fc\u30b8\u6587\uff1a\u300c\u3042\u306a\u305f\u306e\u52dd\u5229\u306f\u7d04\u675f\u3055\u308c\u3066\u3044\u308b\u300d\n\n\u25cf\u6982\u7565\n\u5929\u624d\u30f4\u30a1\u30a4\u30aa\u30ea\u30cb\u30b9\u30c8\u306e\u793e\u4f1a\u4e0d\u9069\u5408\u8005PC\u304c\u552f\u4e00\u53cb\u9054\u3067\u3042\u308a\u540c\u3058\u9053\u3092\u9032\u3080KPC\u306b\u5bfe\u3057\u3066\u304f\u305d\u30c7\u30ab\u611f\u60c5\u3092\u5411\u3051\u3066\u3044\u305f\u3089\u3001\u306a\u3093\u304b\u3044\u3064\u306e\u9593\u306b\u304b\u6ec5\u8336\u82e6\u8336\u30f4\u30a1\u30a4\u30aa\u30ea\u30f3\u304c\u4e0a\u624b\u304f\u306a\u3063\u3066KPC\u304c\u6ce8\u76ee\u3055\u308c\u59cb\u3081\u3061\u3083\u3063\u3066\u3082\u3046\u5927\u5909\uff01\n\u305d\u3093\u306a\u30ad\u30e2\u30a4\u97f3\u3001\u7d76\u5bfe\u541b\u306e\u97f3\u3058\u3083\u306a\u3044\u3088\u306d\uff01\uff1f\u8ab0\u306b\u3082\u3089\u3063\u305f\u306e\uff01\uff1f(\u6012\u308a)\n\u203b\u4e8c\u4eba\u306f\u30bd\u30ea\u30b9\u30c8(\u72ec\u594f)\u306e\u30f4\u30a1\u30a4\u30aa\u30ea\u30cb\u30b9\u30c8\u3067\u3059\u3002\n\n\u25cf\u8a73\u7d30\n\uff3b\u524d\u63d0\uff3d\n\u3042\u306a\u305f\u306f\u30f4\u30a1\u30a4\u30aa\u30ea\u30cb\u30b9\u30c8\u3068\u3057\u3066\u306e\u5929\u8ce6\u306e\u624d\u3092\u6301\u3063\u3066\u3044\u308b\u3002\n\u3044\u3084\u3001\u30f4\u30a1\u30a4\u30aa\u30ea\u30cb\u30b9\u30c8\u3068\u3057\u3066\u3060\u3051\u3067\u306f\u306a\u3044\u3002\u5168\u3066\u306b\u304a\u3044\u3066\u79c0\u3067\u305f\u4eba\u9593\u3060\u3068\u8a00\u3063\u3066\u3044\u3044\u3060\u308d\u3046\u3002\n\u305d\u308c\u6545\u306b\u3042\u306a\u305f\u306f\u50b2\u6162\u3067\u5f37\u6b32\u3067\u5171\u611f\u6027\u304c\u4f4e\u304f\u3001\u3069\u3053\u304b\u8ae6\u89b3\u3057\u3066\u3044\u3066\u4ed6\u8005\u3078\u306e\u8996\u7dda\u306f\u4fef\u77b0\u7136\u3068\u3057\u3066\u3044\u308b\u3002\u305d\u3057\u3066\u4f55\u3088\u308a\u3082\u6c17\u9ad8\u3044\u306e\u3060\u3002\n\n\u3042\u306a\u305f\u306f\u30b9\u30c6\u30fc\u30bf\u30b9\u306e\u3046\u306112\u4ee5\u4e0b\u306e\u3082\u306e\u306f\u4e00\u3064\u3082\u306a\u304f\u3001DEX,APP,POW\u304c\u6700\u5927\u5024\u3067\u3042\u308b(EDU\u306f15\u4ee5\u4e0a\u63a8\u5968)\u3002\n\u3053\u306e\u30b7\u30ca\u30ea\u30aa\u306b\u9650\u308a\u3042\u306a\u305f\u306f\u6226\u95d8\u6280\u80fd\u3068\u3057\u3066\u82b8\u8853[\u30f4\u30a1\u30a4\u30aa\u30ea\u30f3]\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3002\u88dc\u6b63\u306f\u306a\u3044\u306e\u3067\u666e\u901a\u306b\u53d6\u5f97\u3059\u308b\u3053\u3068\u3002\n\nKPC\u3068\u30af\u30bd\u30c7\u30ab\u77e2\u5370\u3092\u76f8\u4e92\u3067\u5411\u3051\u308b\u3053\u3068\u306b\u306a\u308b\u3002\n\u304a\u4e92\u3044\u304c\u304a\u4e92\u3044\u306b\u89e3\u91c8\u5f37\u706b\u30aa\u30bf\u30af\u307f\u305f\u3044\u306b\u306a\u308b\u3002\n\n[\u5c0e\u5165]\n\u552f\u4e00\u3001\u8a8d\u3081\u305f\u4eba\u9593\u304c\u3044\u305f\u3002\n\u30bd\u30ec\u304cKPC\u3067\u3042\u3063\u305f\u3002\n\u540c\u3058\u9053\u3092\u884c\u304f\u611a\u304b\u306a\u51e1\u592b\u3002\n\u5e7e\u5ea6\u3068\u306a\u304f\u632b\u3053\u3046\u304c\u8cb4\u65b9\u3060\u3051\u3092\u898b\u3066\u3044\u305f\u54c0\u308c\u306a\u86d9\u3002\n\u305d\u3093\u306a\u7537\u304c\u3001\u6575\u3067\u3055\u3048\u306a\u304b\u3063\u305f\u30bd\u30ec\u304c\u98db\u8e8d\u7684\u306b\u4e16\u9593\u306b\u8a8d\u3081\u3089\u308c\u59cb\u3081\u305f\u3002\n\u3057\u304b\u3057\u3001\u8cb4\u65b9\u306f\u609f\u308b\u3002\u305d\u308c\u306f\u6c7a\u3057\u3066\u5f7c\u306e\u97f3\u3067\u306f\u306a\u3044\u3068\u3002\n\u8a8d\u3081\u306a\u3044\u3002\u8a8d\u3081\u3089\u308c\u306a\u3044\u3002\u8a8d\u3081\u3089\u308c\u308b\u308f\u3051\u304c\u306a\u3044\u3002\n\u300c\u8ab0\u306e\u8a31\u53ef\u3092\u5f97\u3066\u79c1\u306e\"\u30bd\u30ec\"\u3092\u8a91\u304b\u3057\u305f\u306e\u3060\u300d\u3068\u3002\n\n\u25c6KPC\n\u5f7c\u306f\u51e1\u592b\u3060\u3002\n\u305d\u308c\u6545\u306b\u5f7c\u306e\u594f\u3067\u308b\u97f3\u8272\u306f\u6696\u304b\u304f\u512a\u3057\u304f\u3001\u4eba\u306b\u5bc4\u308a\u6dfb\u3046\u97f3\u3092\u3057\u3066\u3044\u308b\u3002\u6280\u5de7\u7684\u3067\u5b8c\u6210\u3055\u308c\u3001\u4eba\u5916\u7136\u3068\u3057\u3066\u3055\u3048\u3044\u308b\u97f3\u3092\u594f\u3067\u308b\u3042\u306a\u305f\u306b\u306f\u6c7a\u3057\u3066\u6301\u3061\u5f97\u306c\u305f\u3060\u4e00\u3064\u306e\u97f3\u3067\u3042\u308b\u3002\n\u305