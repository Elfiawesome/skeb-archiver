a8-bc46-f0a6a11f0493?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5cb10b61504c4ce1683ea87d953030e, https://si.imgix.net/ef6ae59b/uploads/origins/809e719e-191e-47a8-bc46-f0a6a11f0493?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ca808248fee6bb7dc2064fd86b78f24 2x, https://si.imgix.net/ef6ae59b/uploads/origins/809e719e-191e-47a8-bc46-f0a6a11f0493?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5d37ffbc8016357388fe4c39997c6a8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef6ae59b/uploads/origins/809e719e-191e-47a8-bc46-f0a6a11f0493?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2727729ce8a446bcbca5ebac4d5f9426", "srcset": "https://si.imgix.net/ef6ae59b/uploads/origins/809e719e-191e-47a8-bc46-f0a6a11f0493?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2727729ce8a446bcbca5ebac4d5f9426, https://si.imgix.net/ef6ae59b/uploads/origins/809e719e-191e-47a8-bc46-f0a6a11f0493?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=231c4331d371e26840dd03a5ffc34315 2x, https://si.imgix.net/ef6ae59b/uploads/origins/809e719e-191e-47a8-bc46-f0a6a11f0493?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0303b61f75aae642db6e7db44f5add72 3x"}, "body": "何度もお断りのお返事をいただいているにもかかわらず、繰り返しのお願いとなってしまい大変申し訳ございません。ですが、やはり先生にお願いをしたい気持ちは変わりませんので、再度リクエストさせていただきます。\nウチの子「緋月紗夜(ヒヅキサヤ)」のイラストをお願いいたします。\n何卒、ご検討いただけますと幸いです。\n\nキャラクター、衣装に関しては\nhttps://drive.google.com/drive/folders/1Fb-jRDYr4ylbemGUuTF_PWF14ZwXTwTj\nをご参照ください。\n※キャラクター、衣装共にデザイン依頼時に他作家様に依頼をする事があること、その際に資料として使用することの許可はいただいております。\n\n早速ですが、以下リクエストの指定となります。\n\n\n・【夜桜と紗夜】をテーマに、資料衣装の紗夜のイラストをお願いいたします。\n(細かなシチュエーションはお任せいたします。先生が違ったテーマをお考えでしたら、そちらのテーマを優先してください。)\n\n・スレンダー巨乳なキャラクターではありますが、先生にはそれに縛られずにお描きいただければと思っております。(できればフトモモは盛っていただき、肉感的な身体の持ち主にしていただけると大変嬉しいです。)\n\n・服装は資料の衣装＋三面図のチョーカーとネックレスでお願いいたします。\n(衣装は先生のイメージされるシチュエーションに合う衣装を着せていただいても問題ございませんが、その際は制服以外の衣装をお願いいたします。)\n\n・髪型は衣装資料ではツインテールになっておりますが、違うヘアスタイルにしていただきたいです。\n(ツインテールが先生のイメージに合うようでしたら、ツインテールで問題ございません。あくまでも先生のイメージを最優先でお願いいたします。)\n\n\n上記以外の指定はございません。全て先生にお任せいたします。\n\n先生にお任せしてばかりのリクエストとなってしまい、大変申し訳ございません。\nお忙しいところ大変恐縮ではございますが、何卒、ご検討の程よろしくお願いいたします。\n\n\n\n以下、キャラクター設定となります。ご不用でしたらお読みいただかなくても差し支えございません。\n\n・キレ長の目をした黒髪ロングのクールビューティーで、現役JKグラドル兼モデル\n・普段は髪を下ろしているが、気分や服に合わせてヘアアレンジするのが好き\n・装飾品はつけたがらないが、チョーカーとネックレスは彼氏からのプレゼントのため、仕事等の事情が無い限り外さない\n・性欲が強く、自分の顔と身体を武器として認識していて、ことあるごとに彼氏を誘惑している\n・幼馴染で現在担任教師の彼氏大好きっ子だが、完全に尻に敷いてはいる", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hma_h/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2367531, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/119ab1c1/uploads/origins/4b697296-3cf4-48bd-aee2-752a337faa1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9eaebf7ca64e0c72d759facf0cf4152b", "srcset": "https://si.imgix.net/119ab1c1/uploads/origins/4b697296-3cf4-48bd-aee2-752a337faa1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9eaebf7ca64e0c72d759facf0cf4152b, https://si.imgix.net/119ab1c1/uploads/origins/4b697296-3cf4-48bd-aee2-752a337faa1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc7d826e6118935ffc83c4309e55a806 2x, https://si.imgix.net/119ab1c1/uploads/origins/4b697296-3cf4-48bd-aee2-752a337faa1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6a1f0424120d8815b49eb11979c0eb5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/119ab1c1/uploads/origins/4b697296-3cf4-48bd-aee2-752a337faa1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2107fcdb37dfdc59e663fa69526e7da