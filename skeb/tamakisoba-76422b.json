9-a692-8fdcda1fc584?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84db0c093446325f012c97a47faa5ffc", "srcset": "https://si.imgix.net/6a8335cc/uploads/origins/e6581534-9e50-4329-a692-8fdcda1fc584?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84db0c093446325f012c97a47faa5ffc, https://si.imgix.net/6a8335cc/uploads/origins/e6581534-9e50-4329-a692-8fdcda1fc584?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a6d8dbfaba6e1248b6f6c82d4e51a0ed 2x, https://si.imgix.net/6a8335cc/uploads/origins/e6581534-9e50-4329-a692-8fdcda1fc584?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=06574e749915d88c1724c72648690266 3x"}, "body": "初めまして\n\nオリジナルキャラの全身立ち絵で、昭和初期の農家の30歳代中ごろ、\nむせ返るような大人の女性の魅力たっぷりな感じの\n黒髪女性のイラストをリクエストしたいです。\n顔だち、体型、髪型、ポーズ等はお任せします。\n\n恰好\n野良着に、もんぺ、地下足袋履きで、手には農作業用の紺の手甲をつけています。\n野良着の色は紺、模様は絣模様にしてほしいです。\nもんぺはへその辺りで紐を結ぶ袴式、長さはくるぶしまで、\n色、模様は濃い紫系の縞模様で脇は袴の様にスリットを開けてほしいです。\n地下足袋はくるぶしの上までの長さ、色は黒にしてほしいです。\n服装の大まかなイメージは資料urlをご参照ください。\nもんぺイメージ\nhttps://www.dropbox.com/scl/fi/6vbchf5jfox7oizm9ishf/simam.png?rlkey=f9jko40b8laofmj4ycfsrgqa9&st=kbh2hfv1&dl=0\n地下足袋イメージ\nhttps://www.dropbox.com/scl/fi/0dlq0el8hrwkh15ocjvm7/tb.png?rlkey=id9szwe2vs7xqr6f46enheggn&st=gqb9dkf7&dl=0\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fi/s6470qhlwdftz8kzbg16s/nk.jpg?rlkey=ve4te44hezclvf9gbnn6zsiw2&st=mglg9oaa&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tamakisoba/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2939889, "client_id": 1794155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84c7c4a9/uploads/origins/c2347dd9-6dfb-490a-8ec2-46a3cb7cc7fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cce2390f1b47de1a3210d8427c9c929", "srcset": "https://si.imgix.net/84c7c4a9/