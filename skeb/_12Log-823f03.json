m=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b6850ef57430dc7a52ee33f63416a5c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/60299dfa/uploads/origins/ac1129a0-c7fb-4ac9-9266-c75136f85743?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d39e325d207f7e1c7b587a2524b54ee", "srcset": "https://si.imgix.net/60299dfa/uploads/origins/ac1129a0-c7fb-4ac9-9266-c75136f85743?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d39e325d207f7e1c7b587a2524b54ee, https://si.imgix.net/60299dfa/uploads/origins/ac1129a0-c7fb-4ac9-9266-c75136f85743?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9bdf53e8429858d1f66fc2cf84c1c637 2x, https://si.imgix.net/60299dfa/uploads/origins/ac1129a0-c7fb-4ac9-9266-c75136f85743?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08a50c730282d176a799f0a503fbfa83 3x"}, "body": "こんにちは、あなたの漫画がとても気に入りました。分鏡とラインがとても美しく、できれば私のOC漫画を描いていただきたいと思います。\n描いていただきたいキャラクターが二組いるのですが、もしよろしければ、先生がお気に召した方や、インスピレーションを感じた方のペアを自由に選んで描いていただけないでしょうか。\n詳しい設定資料はこちらになります。\n兄妹：https://drive.google.com/drive/folders/12v-KjSdSgDoiBiKj0FlTxLd24O0Te93W\n牧师术士：https://drive.google.com/drive/folders/1uh1uPFqZBQSSo5wpPfP4j2Sw6rXAu3zY", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_12Log/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3739175, "client_id": 2966169, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9356a920/uploads/origins/172d5b41-bf05-4731-a014-af29cfe03d53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=898e45bf371ba80baffda549bcad70b3", "srcset": "https://si.imgix.net/9356a920/uploads/origins/172d5b41-bf05-4731-a014-af29cfe03d53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=898e45bf371ba80baffda549bcad70b3, https://si.imgix.net/9356a920/uploads/origins/172d5b41-bf05-4731-a014-af29cfe03d53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=579181c1e2530013a3ff470f81ae5540 2x, https://si.imgix.net/9356a920/uploads/origins/172d5b41-bf05-4731-a014-af29cfe03d53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23ba4b63b1737ac353821c90489f388f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9356a920/uploads/origins/172d5b41-bf05-4731-a014-af29cfe03d53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1ed84165c80ac873e8ef30efdfb08c0", "srcset": "https://si.imgix.net/9356a920/uploads/origins/172d5b41-bf05-4731-a014-af29cfe03d53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1ed84165c80ac873e8ef30efdfb08c0, https://si.imgix.net/9356a920/uploads/origins/172d5b41-bf05-4731-a014-af29cfe03d53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=42de0f6d21d4fa7d41e751843e2646ac 2x, https://si.imgix.net/9356a920/uploads/origins/172d5b41-bf05-4731-a014-af29cfe03d53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=450a8e045657376aec34d4c3e3dc944f 3x"}, "body": "こんにちは、よおかちひろさん！新刊コミックで作品を拝見しましたが、本当に素晴らしい漫画ですね！できれば、僕のオリジナルキャラクターを使った漫画を描いてほしいです。\n<キャラクター\n14（15歳）\n運の悪そうな普通の市民。モンスターに襲われるなど、トラブルに巻き込まれることが多い。そのため少々ビビリでエキセントリックな性格だが、本当の危機には冷静に対処し、時には極端な手段で問題を解決する。\nキム（18歳）\nこの世界の \"保安官\"。陽気で正直で、人を導くのが得意な天性のリーダー。自分の義務を果たすだけでなく、純粋に多くの人を助けようとしている。\n<人間関係\n二人が出会ったのは、彼女はいつもトラブルに巻き込まれ、彼の役割は危機に対処することだったからだ。\n\n詳しいことはあなたにお任せします！でも、もっとわかりやすいシナリオがいいというのなら、私の案はこうだ：\n二人は資源シーズン終了の祝賀会に一緒に出席する。14番が小さなゲームで勝った後、キムは彼女にポケベルをさりげなく渡し、もしトラブルに巻き込まれたらすぐに連絡が取れるようにと言う。\nそれを見た14は、勝ったばかりの両面記念コインをキムの手に渡す。\"保安官殿、つまりあなたは、私があなたのためにトラブルを起こし続けることを期待しているということですね？\"と彼女は尋ね、彼の心遣いに温かい気持ちが広がるのを感じながら、柔らかく笑った。\n「このコインを持っていてください。今度意見が食い違ったら、このコインに決めてもらおう\"\nご配慮ありがとうございます^ ^。\n\nhttps://mire-larkspur-87e.notion.site/panopticon", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_12Log/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3739175, "client_id": 3332501, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ae5cccd/uploads/origins/10ca4434-8e9d-4136-8def-27d9c7434c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2cb06883f1b2123cb01d11b2f1e9f51", "srcset": "https://si.imgix.net/3ae5cccd/uploads/origins/10ca4434-8e9d-4136-8def-27d9c7434c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2cb06883f1b2123cb01d11b2f1e9f51, https://si.imgix.net/3ae5cccd/uploads/origins/10ca4434-8e9d-4136-8def-27d9c7434c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44e23db8d304e3c271b95022b6c59d11 2x, https://si.imgix.net/3ae5cccd/uploads/origins/10ca4434-8e9d-4136-8def-27d9c7434c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7030c98363b4e143a70f019af28f7b30 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ae5cccd/uploads/origins/10ca4434-8e9d-4136-8def-27d9c7434c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=967bbf12c8f386d09e5a631f0c5280ba", "srcset": "https://si.imgix.net/3ae5cccd/uploads/origins/10ca4434-8e9d-4136-8def-27d9c7434c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=967bbf12c8f386d09e5a631f0c5280ba, https://si.imgix.net/3ae5cccd/uploads/origins/10ca4434-8e9d-4136-8def-27d9c7434c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=202ece162042deab895d355751494dee 2x, https://si.imgix.net/3ae5cccd/uploads/origins/10ca4434-8e9d-4136-8def-27d9c7434c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05754c2858faeea950e7b5e64a497f62 3x"}, "body": "Hello, I found your art and I was very impressed and I like the style. I was wondering if you would be able to do some pages of my story in your art style. Please feel free to cancel the request. I have attached the pages in a google doc, there are sketches and finished versions in a different style for reference. Please feel free to pick any pages you like or all of them and change any aspect to fit your ideal. Thank you for your consideration.\n\nThe first two pages are in a forest where huge trees are growing in rows. Two soldiers walk through and find one tree with a large bleeding hole in the side. They climb it to find a young boy laying inside. The second two pages are in an estate where a different young boy dressed as a servant steals food and wanders around. He easily evades the cook before going to outside to the barn to feed a horse an apple he stole.\n\nhttps://drive.google.com/drive/folders/1eIqYJtFyNsdx9noNNkEpDy7rRQaOj09D?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_12Log/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3739175, "client_id": 3516337, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2bc5473a/uploads/origins/6d4d5afe-a9b5-4473-9034-bae46f16b2ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d51baa09e74628c54c4488de728379e0", "srcset": "https://si.imgix.net/2bc5473a/uploads/origins/6d4d5afe-a9b5-4473-9034-bae46f16b2ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d51baa09e74628c54c4488de728379e0, https://si.imgix.net/2bc5473a/uploads/origins/6d4d5afe-a9b5-4473-9034-bae46f16b2ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e6742b4cd83e3b6d92b16585253ad2f 2x, htt