な解釈や描写を優先なさってくだされば嬉しく思います！\nまた、彼らは広島弁で喋る人物ですが、細かなニュアンスの差異については特に気になりませんので、どうかお気軽にお願い致します\n\n長々と失礼しました。金額や資料の不備不足がございましたら、御手数ですがキャンセルか再送をして頂ければ助かります\n何卒ご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1MBSaOyBxXJu0aMi8fnWeLdXTrT4LxzNV", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_12Log/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3739175, "client_id": 3496822, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74d3915b/uploads/origins/49a442d8-9907-4506-88ef-ea91f3aa5e6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5766c1ee28d0272771fe52de2af23535", "srcset": "https://si.imgix.net/74d3915b/uploads/origins/49a442d8-9907-4506-88ef-ea91f3aa5e6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5766c1ee28d0272771fe52de2af23535, https://si.imgix.net/74d3915b/uploads/origins/49a442d8-9907-4506-88ef-ea91f3aa5e6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94fdbd3562b429f1176de89beb0b16f8 2x, https://si.imgix.net/74d3915b/uploads/origins/49a442d8-9907-4506-88ef-ea91f3aa5e6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c7f72e8ebcf6cb954c4d455dc2f0da2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74d3915b/uploads/origins/49a442d8-9907-4506-88ef-ea91f3aa5e6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b40f2e7237731316043e358050438d10", "srcset": "https://si.imgix.net/74d3915b/uploads/origins/49a442d8-9907-4506-88ef-ea91f3aa5e6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b40f2e7237731316043e358050438d10, https://si.imgix.net/74d3915b/uploads/origins/49a442d8-9907-4506-88ef-ea91f3aa5e6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200