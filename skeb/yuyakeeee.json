webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c39747946fc2f2af57329b55e16b2b2c 2x, https://si.imgix.net/43fd27ea/uploads/origins/1ec54d7e-b478-4f22-8eb5-2e9ca5baac69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e04ecc8093789df6b7e110a5cf704f8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/43fd27ea/uploads/origins/1ec54d7e-b478-4f22-8eb5-2e9ca5baac69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=096c5085c7d0f0556195c9c85d369013", "srcset": "https://si.imgix.net/43fd27ea/uploads/origins/1ec54d7e-b478-4f22-8eb5-2e9ca5baac69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=096c5085c7d0f0556195c9c85d369013, https://si.imgix.net/43fd27ea/uploads/origins/1ec54d7e-b478-4f22-8eb5-2e9ca5baac69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a076342a9f2783bbb3ec3caa20e702d 2x, https://si.imgix.net/43fd27ea/uploads/origins/1ec54d7e-b478-4f22-8eb5-2e9ca5baac69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=843b034c7fc68feb9d27c6317239c7e6 3x"}, "body": "突然のリクエスト失礼致します。\nこの度、ゆづきよる様に拙宅のOCを描いていただきたく思い、リクエストを投げさせていただきました。\n\n指定キャラクターは魔法少女の姿をしていますが、精神的にはまだ幼い子供です。強がって明るいフリをし理想の自分を演じ続けている…というキャラクターなのですが、彼女が子供らしい柔らかい笑顔を浮かべているイラストを描いていただきたいです。こちらからは表情指定のみで、ポーズや構図、背景の有無などは全てゆづきよる様にお任せします。指定キャラクター含め幸せそうな雰囲気のイラストであると嬉しいです。\n\nOCの立ち絵、デザインなどは資料として用意させていただいていますが、どうしても衣装デザインやステッキのデザインなどが細かいため、分からない部分や描き難い部分などはアレンジ・省略していただいて構いません！好きな様に描いていただければと思います。\n\n端末の壁紙として使用させていただきたいため、可能であれば9:19.5の比率で描いて頂けると嬉しいです。ですがもちろん出来ればの話ですので、難しければゆづきよる様の描きやすいサイズで描いていただいて構いません。\n\n長々と失礼致しました。\nゆづきよる様の絵柄で見てみたいという願望の元のリクエストですので、難しければ蹴っていただいて構いません。もしよろしければご検討頂けると幸いです。よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-BARS5ljpHhD_9xk-43nJu7NjY4E0-oi", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuyakeeee/