りがたいです。その他のことに関してはおまかせします！\n\n使用用途は公開垢鍵垢でのアイコン、ヘッダーなどに使おうかと思っております。\n\n言葉足らずな部分もあると思いますがご検討よろしくお願いします", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dee_erunea/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3623464, "client_id": 3433926, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8731152e/uploads/origins/c5988d1c-b8dc-4288-a89b-d3717c3d392f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=450d832bde6da2deb2ff0cfa6afd7867", "srcset": "https://si.imgix.net/8731152e/uploads/origins/c5988d1c-b8dc-4288-a89b-d3717c3d392f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=450d832bde6da2deb2ff0cfa6afd7867, https://si.imgix.net/8731152e/uploads/origins/c5988d1c-b8dc-4288-a89b-d3717c3d392f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ebe27f2e920dea9d7c405c3d6355549 2x, https://si.imgix.net/8731152e/uploads/origins/c5988d1c-b8dc-4288-a89b-d3717c3d392f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d2ebc56eacc68d8af2e76279419b5c9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8731152e/uploads/origins/c5988d1c-b8dc-4288-a89b-d3717c3d392f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee01a30c7e89ce71f291f353ad13a6d7", "srcset": "https://si.imgix.net/8731152e/uploads/origins/c5988d1c-b8dc-4288-a89b-d3717c3d392f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee01a30c7e89ce71f291f353ad13a6d7, https://si.imgix.net/8731152e/uploads/origins/c5988d1c-b8dc-4288-a89b-d3717c3d392f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e3747a240ce18bd4370b51bded1cc698 2x, https://si.imgix.net/8731152e/uploads/origins/c5988d1c-b8dc-4288-a89b-d3717c3d392f?bg