2643ca-cd33-42c3-bf92-77d3516cee31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=72f7c8cec7e617baaf02351113ca8735 2x, https://si.imgix.net/d1a6f712/uploads/origins/bf2643ca-cd33-42c3-bf92-77d3516cee31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f6440b5c455e6624cf7454585d7749d9 3x"}, "body": "井太刀岬をお願いします！！\n資料は送るわね！\nラッパーなので、なんかそれっぽい服装でラップやってる井太刀が見たい！！\nSIZ9のちっちゃくて可愛い男。\nラップも、ディスはするもののどちらかというと語感とリズムで戦うタイプ。\nダボダボのラッパー服が見たい！！帽子後ろ向きに被ってほしい！！笑顔で（八重歯が見えてくれ）ラップやってほしい！！\n\nよろしくお願いします！！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ume/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1850706, "client_id": 1333156, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8184fed2/uploads/origins/02340c66-a4eb-4647-ac50-6c4b094793c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae1216ad382abe5c81428333bbfc4ce7", "srcset": "https://si.imgix.net/8184fed2/uploads/origins/02340c66-a4eb-4647-ac50-6c4b094793c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae1216ad382abe5c81428333bbfc4ce7, https://si.imgix.net/8184fed2/uploads/origins/02340c66-a4eb-4647-ac50-6c4b094793c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0e4d99ff6911ea3ac7ec232a88cb0a5 2x, https://si.imgix.net/8184fed2/uploads/origins/02340c66-a4eb-4647-ac50-6c4b094793c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31ecd8a52ba10ee1512307cf684a4aa8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8184fed2/uploads/origins/02340c66-a4eb-4647-ac50-6c4b094793c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0be1a1e634ad7ee66363f616b2c84d26", "srcset": "https://si.imgix.net/8184fed2/uploads/origins/02340c66-a4eb-4647-ac50-6c4b094793c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0be1a1e634ad7ee66363f616b2c84d26, https://si.imgix.net/8184fed2/uploads/origins/02340c66-a4eb-4647-ac50-6c4b094793c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81417a3916e0922bd840b377423401f7 2x, https://si.imgix.net/8184fed2/uploads/origins/02340c66-a4eb-4647-ac50-6c4b094793c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=36f4039b2bee78dfe62375e298dc89b5 3x"}, "body": "お世話になっております。せろりすと と申します。\n前回は本当に本当にありがとうございました……。\n\n今回梅野様に描いていただきたく思っているのは、昔あるシナリオに連れて行った私の探索者2人です。\nそれぞれ別のPLとシナリオ（タイマン）に行っているため2人に関りは全くありませんが、思い入れのあるシナリオなので……。\nそのため、2人の絡みというよりは、それぞれが別の人間に向けている表情が見たい……です……。カメラの一人称視点等で構いません。我儘をすみません……。\n\nネタバレになりかねないのでシナリオは伏せておきます。世の中にはタイマンシナリオがいっぱいあるので名前さえ言わなければ大丈夫だと勝手な判断をしていますが、資料の中には表情の話の上で必要だったためシナリオの内容にかかわることがふんわりと書いてあります。この時点で嫌なにおいを感じたら突き返してくださって構いません。お手数をおかけします…。\n\n\n〇掛橋 正記 / かけはし まさのり（34歳）\n職業：刑事\n\n〇八雲 想助 / やくも そうすけ（享年20歳）\n職業：時代作家\n\n\n以下資料URLです。\n掛橋正記の方の画像3枚目のシナリオは最近まわったもので、前述したものとは関係ないのでご安心ください。\n他PLからは立ち絵を載せる許可を取ってあります。\nhttps://twitter.com/Serolist_TRPG/status/1528821508100849664\nhttps://twitter.com/Serolist_TRPG/status/1528821528883654656\n\n私事で申し訳ありませんが、前回のスケブやSKIMAで梅野様に本当に素敵な絵を描いていただきまして、またぜひ頼みたく思い、お金に余裕ができる機会をうかがっていました。\nこの度初任給が出たので参りました……！\n梅野様の絵が本当に好きです……。\n\n急ぎのものではないので、もしお暇な時間があれば……！\nよろしくお願いします🙇‍♀️", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ume/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1850706, "client_id": 1333156, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42549d15/uploads/origins/82255b8a-19b4-467f-a12d-276cc3721b94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e1d4c296629ef4561151d35fa3a7e7f", "srcset": "https://si.imgix.net/42549d15/uploads/origins/82255b8a-19b4-467f-a12d-276cc3721b94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e1d4c296629ef4561151d35fa3a7e7f, https://si.imgix.net/42549d15/uploads/origins/82255b8a-19b4-467f-a12d-276cc3721b94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f02c28782b84c5ea76ccce7a7d809cf1 2x, https://si.imgix.net/42549d15/uploads/origins/82255b8a-19b4-467f-a12d-276cc3721b94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d34925811162bdd5bd3d9fcd93324d0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42549d15/uploads/origins/82255b8a-19b4-467f-a12d-276cc3721b94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f27decb5847f244311742b63e0f4976e", "srcset": "https://si.imgix.net/42549d15/uploads/origins/82255b8a-19b4-467f-a12d-276cc3721b94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f27decb5847f244311742b63e0f4976e, https://si.imgix.net/42549d15/uploads/origins/82255b8a-19b4-467f-a12d-276cc3721b94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d2de5edea40719aae856ed0db2e7b588 2x, https://si.imgix.net/42549d15/uploads/origins/82255b8a-19b4-467f-a12d-276cc3721b94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=591f69632d65f7186a9152b1d4375767 3x"}, "body": "こんにちは、せろりすとと申します。\nこの間は素敵な立ち絵を本当に本当にありがとうございました……！\n\n今回、梅野様に創作の3人組（探索者）を描いていただきたくて参りました。\nアルフレッド（自PC）（日本人）：年齢不詳、177cm、うさんくさい\n古城幸秀（他PC）：32歳、171cm、真面目、苦労人、優しい\n清水蒼一（他PC）：27歳、161cm、大人しめ、最近微笑むようになった\n\n古城と蒼一の親(PL)からは設定やキャラデザを見せる許可をいただいています。\n\nアルフレッドの誕生日が3/16なので、3人が楽しそうなイラストを描いていただけたら嬉しいな……と思っています。（急かせるつもりでは全くないです……！！ギリギリで思いついたことなので、4月でも5月でもいつでももちろん大丈夫です🙇‍♀️ 忘れた頃にもらえる自分へのプレゼントだと思っているので…）\nシチュエーションはお任せします。描きやすい形でお願いします……！\n\n以下、3人の詳細な設定です。\n長くなってしまったので、文字の方は読み飛ばしてキャラデザだけで描いていただいて大丈夫です……！！\n\nhttps://twitter.co