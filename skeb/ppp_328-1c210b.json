に与えられた力の証が浮かび上がる(例:アルシェの目の下のト音記号🎼。カイルの項の♭フラット)\n\n◆OC詳細◆\n名前 カイル\n年齢 16歳\n所属国 💙青の国(奇跡と夢の国)\n楽器 ビオラ\n武器 レイピア\n\n生意気ヤンキー王子\n三兄弟の真ん中。兄に甘やかされ、弟を甘やかし両親と国民に愛されわがまま生意気に育った。\nお忍びで街を歩くのが大好きで、治安を乱す輩によく喧嘩を売ってボコボコにしたあと中指を立てている。\n王族として厳しく育てられているため所作は優雅。\nまた、兄や国を舐められては行けないと公の場では猫を被っている。\n\nご検討どうぞよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/12TZPTWts5AD8akckSR3z70Q0oHHsB-N0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2347253, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "星（5692.）", "screen_name": "_PS4present", "avatar_url": "https://pbs.twimg.com/profile_images/1757034586981437440/ovhS1WE8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1423690312430456838/1767277275/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2978422, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "まよい寝子", "screen_name": "mayoineko0915", "avatar_url": "https://pbs.twimg.com/profile_images/2007335876431622149/iu7qANF6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1690411687709646850/1774015194/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 48}, {"id": 3488945, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "あんず🐰", "screen_name": "babu_2_", "avatar_url": "https://pbs.twimg.com/profile_images/1975019802394812416/iMaPeRBZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1257964419033608193/1724838161/1500x500", "appeal_receivable": false, "popula