200&blur=200&s=7563e76f5fdda76feafb7e9e7182b142 3x"}, "body": "ちゃーい達が\nクリスマスパーティーをしてる様子を\nイラストにしていただきたいですm(*_ _)m\n\n\nいつも家族とちゃーいのイラストや漫画\n楽しませていただいていますm(*_ _)m\nスタンプ全種も集め\n毎日使っています🥹\n\nちゃーい𝑩 𝑰 𝑮 𝑳 𝑶 𝑽 𝑬", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ttt__g_m/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2915395, "client_id": 1441357, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e8cacf2/uploads/origins/5f4550d3-3bd9-4670-8ca7-422f24cd3f84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2aef08e7efb3ef02506533f44ebdf08c", "srcset": "https://si.imgix.net/7e8cacf2/uploads/origins/5f4550d3-3bd9-4670-8ca7-422f24cd3f84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2aef08e7efb3ef02506533f44ebdf08c, https://si.imgix.net/7e8cacf2/uploads/origins/5f4550d3-3bd9-4670-8ca7-422f24cd3f84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba6b8cabe44da402a515896e63bb2570 2x, https://si.imgix.net/7e8cacf2/uploads/origins/5f4550d3-3bd9-4670-8ca7-422f24cd3f84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f4a540549d1997c35d9c2a9488dc695 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e8cacf2/uploads/origins/5f4550d3-3bd9-4670-8ca7-422f24cd3f84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64d697979cc0dea208b720e61a842182", "srcset": "https://si.imgix.net/7e8cacf2/uploads/origins/5f4550d3-3bd9-4670-8ca7-422f24cd3f84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64d697979cc0dea208b720e61a842182, https://si.imgix.net/7e8cacf2/uploads/origins/5f4550d3-3bd9-4670-8ca7-422f24cd3f84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a4811e24fa7935c3b64d39907df6855 2x, https://si.imgix.net/7e8cacf2/uploads/origins/5f4550d3-3bd9-4670-8ca7-422f24cd3f84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ebc0809194826cff6d1bf1fb7b82b759 3x"}, "body": "とやた様、初めましてうりと申します。\n偶々見かけたちゃーいちゃんのもちもち具合が見事に刺さりまだ短い期間ですが更新を見守っています。\n\nとやた様の描かれるもちもち具合をもっと見たいなあと思い今回リクエストを送ります。\n\n１．私のOCのまる～い猪をもちもち具合で好きに描いて欲しい（詰め合わせな感じで）\n２．ちゃーいちゃんの詰め合わせを描いてほしい（今だと冬や雪、年末年始に絡めたテーマでしょうか）\n\nリクエスト内容は悩んでしまったのでお好きな方を選んでいただければ幸いです！\n\n\nOCのまるい猪は、自身の名前からうりぼう（猪の子供）として描き始め今ではうちの子的な存在です。\n\nまた気軽に描けるよう特に細かい設定は決めていません。そのため自由に描いて頂ければと思います（一緒にいる黄色い猫は、blobcatといって私個人のキャラクターでははない為、描かなくても大丈夫です）\nもし猪を描いて頂いた際は、個人観賞用のグッズ制作を行うかもしれません（シールの印刷など）\nもちもちに描いて頂けたら嬉しいです！\nhttps://drive.google.com/drive/folders/1Ujadjc3kpzzCDhSDnIRK58XXXHe6iPzU?usp=sharing\n\nちゃーいちゃんの詰め合わせについてはとやた様の普段通りに書き連ねて貰えればと思ってます！\n\n\nこれからもちゃーいちゃんととやた様の元気なご活動を応援しております。\n\nhttps://drive.google.com/drive/folders/1Ujadjc3kpzzCDhSDnIRK58XXXHe6iPzU?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ttt__g_m/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2915395, "client_id": 717951, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45dc864e/uploads/origins/b62fc48f-6985-4fcb-b443-303e0fc322ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18efbd0a9d34ea28d81de6204a73b958", "srcset": "https://si.imgix.net/45dc864e/uploads/origins/b62fc48f-6985-4fcb-b443-303e0fc322ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18efbd0a9d34ea28d81de6204a73b958, https://si.imgix.net/45dc864e/uploads/origins/b62fc48f-6985-4fcb-b443-303e0fc322ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c1070e24feb1b37d55aba4d08c24888 2x, https://si.imgix.net/45dc864e/uploads/origins/b62fc48f-6985-4fcb-b443-303e0fc322ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a6afb1d08dae170cac128edb769c131 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45dc864e/uploads/origins/b62fc48f-6985-4fcb-b443-303e0fc322ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8b86a26187fd01300134041857b0a84", "srcset": "https://si.imgix.net/45dc864e/uploads/origins/b62fc48f-6985-4fcb-b443-303e0fc322ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8b86a26187fd01300134041857b0a84, https://si.imgix.net/45dc864e/uploads/origins/b62fc48f-6985-4fcb-b443-303e0fc322ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f376fa1fc27cf84d320c6aaa78625897 2x, https://si.imgix.net/45dc864e/uploads/origins/b62fc48f-6985-4fcb-b443-303e0fc322ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=541758071851457b9d3ef3ea6c26c4ed 3x"}, "body": "はじめましてこんにちは。\nいつもとやた様の絵を拝見させていただいているものです。\n\nとやた様の書くちゃーいがとても大好きで、つねにちゃーいのしりを周りに見せ、自認ちゃーいを磨くべく精進しております。\n\nまた、以前はもふちゃーいに脳破壊を受けました。んに太郎も大好きです。\n\n今回ご依頼したいのは、ちゃーいのイラストです。もふちゃーいやんに太郎など沢山いると嬉しいですが、単体でも嬉しいです。その場合はもふちゃーいですと大変ありがたいです。\n\n使用用途は\n各種SNSアイコン、YouTubeでの非営利使用(アイコンなどが乗る場合があるため)\n\n\nちゃーいの依頼受けていないなどサーチ不足があれば申し訳ございません。\nよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ttt__g_m/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2915395, "client_id": 3572079, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8be5c6b6/uploads/origins/bb414e0c-91a1-4868-8258-f3c0e50f9229?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f98e865bb282d6c20eba518339d7354", "srcset": "https://si.imgix.net/8be5c6b6/uploads/origins/bb414e0c-91a1-4868-8258-f3c0e50f9229?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f98e865