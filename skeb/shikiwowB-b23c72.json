ff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36d4d7308cb70100594082cd6eb85b40 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f52f06c/uploads/origins/cf478be5-0418-4be3-b900-8b30cbbead09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73f7e7f19bb5aa795fa2a0078251a052", "srcset": "https://si.imgix.net/2f52f06c/uploads/origins/cf478be5-0418-4be3-b900-8b30cbbead09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73f7e7f19bb5aa795fa2a0078251a052, https://si.imgix.net/2f52f06c/uploads/origins/cf478be5-0418-4be3-b900-8b30cbbead09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6bcc1d142591cca4c4865a6088254aee 2x, https://si.imgix.net/2f52f06c/uploads/origins/cf478be5-0418-4be3-b900-8b30cbbead09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=62db1d63b49a1515227ee3a0079fad01 3x"}, "body": "すいません\n依頼をお願いします\n\n出産、産卵系のイラストでお願いしたいのですが\nクロノ.トリガーというゲームのマールというキャラです\n\nシチュエーションは\nこのエンディング\nhttps://www.youtube.com/watch?v=rItg77rTv1I\n（歴史が変わってしまいマールがカエルの血をひいてしまう）\nの続きで、カエルの血をひいてしまったマールが、\n突然産気づいて、その場で蛙の卵を産卵してしまうというものです\n\nできれば、このコマ割り順で漫画形式で描いてほしいのですがよろしいでしょうか？\nhttps://i.imgur.com/YwObefQ.png\n\n①マール「やだやだ！こんなの！！」\n②産気づいて吐き気を催すマール\n③マール「ひっな、なんかでちゃうっ！」といいながら、その場でズボンを脱ぎだすマール\n④マール「う、うそうそっ！なにこれ！？こんなの嫌あぁっ！お願いクロノ！こんなのみないでぇ！」\nと泣き叫びながら、しゃがんでカエルの卵を産卵しちゃうマール\n（背景は王室で、周りに王様と王妃と兵とクロノとルッカがいる）\n\nそれから、陰毛はなしで、マールのおっぱいは控えめの描写でお願いします\n\nカエル卵の産卵の参考絵\nhttps://i.imgur.com/PJKAvxO.jpg\nhttps://i.imgur.com/5d0h298.jpg\nhttps://i.imgur.com/S8Xo06Q.jpg\n\nマールの絵\nhttps://i.imgur.com/1CdZPKn.png\nhttps://i.imgur.com/WR7sivl.png", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shikiwowB/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1644578, "client_id": 1862634, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d11ba6f5/uploads/origins/f7eda02a-a57b-4d83-b9f6-86b6f8407bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c2292a13183805d7a8a8c87bb48d846", "srcset": "https://si.imgix.net/d11ba6f5/uploads/origins/f7eda02a-a57b-4d83-b9f6-86b6f8407bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c2292a13183805d7a8a8c87bb48d846, https://si.imgix.net/d11ba6f5/uploads/origins/f7eda02a-a57b-4d83-b9f6-86b6f8407bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21c8a8e8de10a8ee42208c8bd1d0df4d 2x, https://si.imgix.net/d11ba6f5/uploads/origins/f7eda02a-a57b-4d83-b9f6-86b6f8407bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f595c821491aac54b8557dc47c5a402 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d11ba6f5/uploads/origins/f7eda02a-a57b-4d83-b9f6-86b6f8407bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b4ff1bcd2e3b609e620706d7ad9333b", "srcset": "https://si.imgix.net/d11ba6f5/uploads/origins/f7eda02a-a57b-4d83-b9f6-86b6f8407bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b4ff1bcd2e3b609e620706d7ad9333b, https://si.imgix.net/d11ba6f5/uploads/origins/f7eda02a-a57b-4d83-b9f6-86b6f8407bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=59a7fb4b66d1bca16947277bf55adcc7 2x, https://si.imgix.net/d11ba6f5/uploads/origins/f7eda02a-a57b-4d83-b9f6-86b6f8407bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=46e3a59d840b38120ec2201a4ce847ae 3x"}, "body": "こんにちは！またSkebの依頼をお願いしたいのですが、どうでしょうか？催眠術が絡むので、大丈夫かな？\n\n私が作ったこのロボットスーツ（https://www.deviantart.com/ameerashourdraws/art/Fembot-Schala-Sketches-937668495）を着たスカラが、ニンテンドースイッチで操作される心ないリモコンだとマインドコントロールされるのを見たい。\n\nこのポーズは、Nintendo Switch（https://sta.sh/07gj10rlv1v）を使って、無表情（何もないところを見つめている）、虚ろな目で操作してほしいです。\n\n大丈夫かな^^」と思いつつ", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shikiwowB/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1644578, "client_id": 1862634, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/992e61b2/uploads/origins/2b4b22be-2925-4f1b-a15a-903e85c1e86f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e713fd5249534dbbbcc5f55cc224f54", "srcset": "https://si.imgix.net/992e61b2/uploads/origins/2b4b22be-2925-4f1b-a15a-903e85c1e86f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e713fd5249534dbbbcc5f55cc224f54, https://si.imgix.net/992e61b2/uploads/origins/2b4b22be-2925-4f1b-a15a-903e85c1e86f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=034e198c5576d39dec49b33b286a4993 2x, https://si.imgix.net/992e61b2/uploads/origins/2b4b22be-2925-4f1b-a15a-903e85c1e86f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aace63b5257cc48902bb37f787204777 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/992e61b2/uploads/origins/2b4b22be-2925-4f1b-a15a-903e85c1e86f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=896c96c8efffccf9b6c83cb7d79f0711", "srcset": "https://si.imgix.net/992e61b2/uploads/origins/2b4b22be-2925-4f1b-a15a-903e85c1e86f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=896c96c8efffccf9b6c83cb7d79f0711, https://si.imgix.net/992e61b2/uploads/origins/2b4b22be-2925-4f1b-a15a-903e85c1e86f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5782b4aef489ec56698b7a9f6ee2ef9a 2x, https://si.imgix.net/992e61b2/uploads/origins/2b4b22be-2925-4f1b-a15a-903e85c1e86f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=41c0f216a237cb50e9c2b15b47c909a6 3x"}, "body": "こんにちは。\nクロノトリガーのシャラがソニック・ザ・ヘッジホッグのルージュ・ザ・バットのスーツを着て、基本的に魅力的なポーズをとって見せてくれるという依頼は可能でしょうかね。スケブの依頼は初めてなのですが、大丈夫でしょうか^^？\n\n(ルージュ・ザ・バットのスーツの参考画像：https://static.wikia.nocookie.net/dbxfanon/images/6/6f/Rouge_the_Bat.png/revision/latest?cb=20160615103632)", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shikiwowB/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1644578, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ea2f9cb/uploads/origins/421dca88-3999-4b43-bd1d-374c5bc64ff2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da4585add63029c6448271e2b1aabd3b", "srcset": "https://si.imgix.net/5ea2f9cb/uploads/origins/421dca88-3999-4b43-bd1d-374c5bc64ff2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da4585add63029c6448271e2b1aabd3b, https://si.imgix.net/5ea2f9cb/uploads/origins/421dca88-3999-4b43-bd1d-374c5bc64ff2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c4859ecc3b9282cae2ca71f72f54b42 2x, https://si.imgix.net/5ea2f9cb/uploads/origins/421dca88-3999-4b43-bd1d-374c5bc64ff2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6bf1d3ea454d9b54d2a8e99ea475f1da 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ea2f9cb/uploads/origins/421dca88-3999-4b43-bd1d-374c5bc64ff2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=610719187e7d1997f362ac549d096c2b", "srcset": "https://si.imgix.net/5ea2f9cb/uploads/origins/421dca88-3999-4b43-bd1d-374c5bc64ff2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=610719187e7d1997f362ac549d096c2b, https://si.imgix.net/5ea2f9cb/uploads/origins/421dca88-3999-4b43-bd1d-374c5bc64ff2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b64042dcbfe5dcffe6901e66e3db9e70 2x, https://si.imgix.net/5ea2f9cb/uploads/origins/421dca88-3999-4b43-bd1d-374c5bc64ff2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7fb00108463625265556f0a26cdfc88c 3x"}, "body": "前の画像がとても可愛かったので、また同じ女の子をお願いしたいです\n\n\n相沢 智\n群堂 みすず\nキャロル・オールストン\n\n\n前回のシナリオの続報\n3人の女の子は都合よく隠されていたが、今回は胸とヴァギナが見えている。\n\n相沢智は恥ずかしさを隠せなくなり、腕で胸とヴァギナを隠そうとするが、 キャロル と みすず が相沢の腕にしがみつき、全てをさらけ出させようとする\n\nみすずは小柄な身体と小さな胸を見せつけながら、下の参考写真のようなエッチでドヤ顔をしている。\n恥ずかしがる様子もなく\nhttps://www.latestanimenews.com/wp-content/uploads/2023/01/Misuzus-smile.png\n何も隠していないにも関わらず、恥ずかしげもなく嬉しそうな表情を浮かべるキャロル。\nhttps://cdn.donmai.us/original/15/61/1561fc59455c433a2a9d473d38d773a5.png", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shikiwowB/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1644578, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ae70d00/uploads/origins/72cd900c-a096-4e14-a3a0-b8e5afb4c05b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63ee444bab1e9c84e21e751e364fc752", "srcset": "https://si.imgix.net/1ae70d00/uploads/origins/72cd900c-a096-4e14-a3a0-b8e5afb4c05b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63ee444bab1e9c84e21e751e364fc752, https://si.imgix.net/1ae70d00/uploads/origins/72cd900c-a096-4e14-a3a0-b8e5afb4c05b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0cdf62bb97214295b61320003f8d9b2 2x, https://si.imgix.net/1ae70d00/uploads/origins/72cd900c-a096-4e14-a3a0-b8e5afb4c05b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97983b035e454c07940f02c657c9cabe 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnai