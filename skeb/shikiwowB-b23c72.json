23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea2c893df8a9c3631900354b2f486b1c 2x, https://si.imgix.net/ac133454/uploads/origins/715864ea-0616-4e99-9e88-067835f51cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a478e0f471b0655f0ac6974e42bc346e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac133454/uploads/origins/715864ea-0616-4e99-9e88-067835f51cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=edeb2159247a759ec4ca92e548c9d65b", "srcset": "https://si.imgix.net/ac133454/uploads/origins/715864ea-0616-4e99-9e88-067835f51cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=edeb2159247a759ec4ca92e548c9d65b, https://si.imgix.net/ac133454/uploads/origins/715864ea-0616-4e99-9e88-067835f51cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f0369ea3e454f817f840ba3046574c4 2x, https://si.imgix.net/ac133454/uploads/origins/715864ea-0616-4e99-9e88-067835f51cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4578f1f9c91014da2da2a365e999e402 3x"}, "body": "前作が素晴らしかったので、また依頼させていただきました。\n\nテイルズ オブ ヴェスペリア\n\nエステル\nリタ・モルディオ\nジュディス\nパティ・フルール\n\n彼女たちは全裸です。\n4人はレズプレイをしているだろう。\n彼らがどのようにセックスをするかは、あなた次第です。\nできれば3人とも胸が見えるようにしたい。\n\n\nエステルには中くらいのおっぱいがある\n無邪気で楽しそうな表情 \n例えば\nhttps://static.wikia.nocookie.net/residentevil/images/f/fa/Pxz-estellise-sidos-heurassein.jpg/revision/latest?cb=20161106175517\n\nジュディスは大きなおっぱい\n恥ずかしがる様子もない\n次の写真のようなちょっとドヤ顔\nhttps://64.media.tumblr.com/6c318eaa33e1408c39f3c5ab47c63f5e/a9d201636c35efc1-5c/s1280x1920/90dc90c0b55966c02465dd42d9b656b095668c4c.png\n自分よりも他の女の子を喜ばせることに興味がある。\n\n\nリタはおっぱいが小さい\n小柄な体型ですが、カーヴィーな体型です。\n悔しさと恥ずかしさをにじませた表情の彼女\nこの写真のように\nhttps://www.zerochan.net/2115894\n\nパティはリタよりおっぱいが小さい\n恥ずかしがる様子もない。\n楽しそうな表情\n小柄な体型で、他の女の子より背が低い", "nc": 56, "word_count": 0, "transcoder"