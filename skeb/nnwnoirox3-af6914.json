nまた、前述の用途のため、キャラクター単体がレイヤー分けされたデータか、キャラクター単体の透過PNGデータを同梱していただけると嬉しいです！\n\nお忙しいところ最後までお目通しありがとうございます。もし要件がそぐわないようならば、当然キャンセルしていただいて大丈夫です。ご検討のほどよろしくおねがいします！\n\nhttps://drive.google.com/drive/folders/17MbVGVyu78WN1pZjaiZN9-VrVw8NtFWZ?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nnwnoirox3/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2174167, "client_id": 2196165, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33d3bf95/uploads/origins/c562a3a5-d9ef-4160-9baf-b0614d0c5625?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31e39d333b2c9249f0400fc192e970ea", "srcset": "https://si.imgix.net/33d3bf95/uploads/origins/c562a3a5-d9ef-4160-9baf-b0614d0c5625?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31e39d333b2c9249f0400fc192e970ea, https://si.imgix.net/33d3bf95/uploads/origins/c562a3a5-d9ef-4160-9baf-b0614d0c5625?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b901f5e13baf34f4c8a8cd06dd2ddf70 2x, https://si.imgix.net/33d3bf95/uploads/origins/c562a3a5-d9ef-4160-9baf-b0614d0c5625?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f498e033c7b8bdcce2ca53f9a7e33e5f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33d3bf95/uploads/origins/c562a3a5-d9ef-4160-9baf-b0614d0c5625?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3861bbba3b5401dd22318eeda1af0172", "srcset": "https://si.imgix.net/33d3bf95/uploads/origins/c562a3a5-d9ef-4160-9baf-b0614d0c5625?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3861bbba3b5401dd22318eeda1af0172, https://si.imgix.net/33d3bf95/uploads/origins/c562a3a5-d9ef-4160-9baf-b0614d0c5625?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=2