これからそのキャラクターをいろいろな場面で使用していきたいと考えています。\n\nご自由に創作していただけると幸いです。そして、これからも応援しております！\n\nどうぞよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 892466, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🥦小宮はむし🥦", "screen_name": "haamuzu86", "avatar_url": "https://pbs.twimg.com/profile_images/1674086811940032512/iEEb6-Wd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1268887364161552384/1724318152/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 3151295, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "糖衣抹茶錠", "screen_name": "tablet_dream", "avatar_url": "https://pbs.twimg.com/profile_images/1742937617421959168/569Z6TfQ.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 3237421, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "げーやん", "screen_name": "tokage_bu", "avatar_url": "https://pbs.twimg.com/profile_images/1907044152321466368/reIdgVXb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1065555584592707585/1713678522/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 3277101, "creator": true, "nsfw_acceptable": false, "