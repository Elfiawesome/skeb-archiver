/view?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Meyu_8888/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3960271, "client_id": 3495323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3aa438b4/uploads/origins/3c23cd22-236f-4a46-9644-a13380d4c1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad2b05af9f46cab40107de9ffe4240eb", "srcset": "https://si.imgix.net/3aa438b4/uploads/origins/3c23cd22-236f-4a46-9644-a13380d4c1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad2b05af9f46cab40107de9ffe4240eb, https://si.imgix.net/3aa438b4/uploads/origins/3c23cd22-236f-4a46-9644-a13380d4c1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69c54f785392e79690712b2241df42b9 2x, https://si.imgix.net/3aa438b4/uploads/origins/3c23cd22-236f-4a46-9644-a13380d4c1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b79bc39d8506804ef0a3461b74a3871b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3aa438b4/uploads/origins/3c23cd22-236f-4a46-9644-a13380d4c1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e726c56a5bf23d317b555bf5ab8634d8", "srcset": "https://si.imgix.net/3aa438b4/uploads/origins/3c23cd22-236f-4a46-9644-a13380d4c1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e726c56a5bf23d317b555bf5ab8634d8, https://si.imgix.net/3aa438b4/uploads/origins/3c23cd22-236f-4a46-9644-a13380d4c1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ffe3cb5f9abb380b02d7765a2036dfb 2x, https://si.imgix.net/3aa438b4/uploads/origins/3c23cd22-236f-4a46-9644-a13380d4c1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7138d4c3643f98cf1674499e3fd11299 3x"}, "body": "個人でVTuber活動をしております、天雲はうと申します。\n柊 めゆサブ様にグッズイラストを描いて頂きたく、リクエストを送信させていただきます。\n\n○主な使用用途○\nYoutube動画内やチャンネルヘッダー、サムネイルなど、天雲はうとしての活動（※収益化済み）\nXなどのSNSでの活動（アイコン、ヘッダーも含みます） \n返礼品(PC壁紙)\nステッカーなどのグッズ化\n\n○キャラクター○\n私（天雲はう）を描いていただきたいです。  \n銀っぽい薄い青白いの髪の毛で、人耳もあります。 \n猫耳は外さないでください。 \n目の色は青灰色とピンクの2色あります。どちらでも構いません。（オッドアイではございません） \n服装、髪型はお任せでお願いいたします。参考資料内にございます和服衣装だと嬉しいです！\nポーズは動きがあるポーズでお願いします！\n\n○天雲はうモチーフ \n猫、リボン、ばってん、絆創膏、雲 \n地雷系、ロリータ系、サブカル系  \n\n○仕様など \n背景を描く場合は、背景とキャラクターを分けたものをそれぞれ頂けますと幸いです（背景使用不可の場合は背景はナシで結構です）。  \n背景透過PNGと、差分がある場合ひとつひとつ書き出すのは大変だと思うのでPSDでいただきたいです。\n\n何卒よろしくお願いいたします.. .ᐟ\n\nhttps://drive.google.com/drive/folders/1lccpE453sQH62WEPi-Y8k3wxBgzGv1cZ?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Meyu_8888/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3960271, "client_id": 3640077, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51f754df/uploads/origins/1e7ac3a2-489b-49a6-9e29-1f8ab7ccd956?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=972d83768213954a26648fce0ce5c879", "srcset": "https://si.imgix.net/51f754df/uploads/origins/1e7ac3a2-489b-49a6-9e29-1f8ab7ccd956?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=972d83768213954a26648fce0ce5c879, https://si.imgix.net/51f754df/uploads/origins/1e7ac3a2-489b-49a6-9e29-1f8ab7ccd956?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d81694affaaa6603786bdb02a463e9cb 2x, https://si.imgix.net/51f754df/uploads/origins/1e7ac3a2-489b-49a6-9e29-1f8ab7ccd956?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00f85facc0a18160dca1df15e4acc465 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51f754df/uploads/origins/1e7ac3a2-489b-49a6-9e29-1f8ab7ccd9