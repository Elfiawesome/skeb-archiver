述のハタチと偽ってる部分がわかるようにお願いします。\n(男「ホントに20歳？」\n小鈴「ハタチですよ♡」)\n(内容は追加したり、ある程度改変しても大丈夫です。可能でしたら男の人が幼い女の子とエッチしているような気分になっている描写や、小鈴が男の人のロリコンを受け入れるような台詞ががあれば嬉しいです)\n他にも描いてみたいものがあれば自由にお願いします。\n\nhttps://www.pixiv.net/artworks/124467415", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@xmu_x1/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 515793, "client_id": 347662, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd5f4ab7/uploads/origins/74b73e2b-4c45-401a-a8cc-e0f7771c4c00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=198d76650f02f72fe3ef19e6e7c435d8", "srcset": "https://si.imgix.net/fd5f4ab7/uploads/origins/74b73e2b-4c45-401a-a8cc-e0f7771c4c00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=198d76650f02f72fe3ef19e6e7c435d8, https://si.imgix.net/fd5f4ab7/uploads/origins/74b73e2b-4c45-401a-a8cc-e0f7771c4c00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc553f7627da273eee4c7414f15f4654 2x, https://si.imgix.net/fd5f4ab7/uploads/origins/74b73e2b-4c45-401a-a8cc-e0f7771c4c00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca735f2429631968bb78dafe5e46bd27 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd5f4ab7/uploads/origins/74b73e2b-4c45-401a-a8cc-e0f7771c4c00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21bed83271a9a47205f15b9dbaaaf3ab", "srcset": "https://si.imgix.net/fd5f4ab7/uploads/origins/74b73e2b-4c45-401a-a8cc-e0f7771c4c00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21bed83271a9a47205f15b9dbaaaf3ab, https://si.imgix.net/fd5f4ab7/uploads/origins/74b73e2b-4c45-401a-a8cc-e0f7771c4c00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=816eaf