0&h=200&blur=200&s=3191a8517efaa553a4530d8faf9266bb 3x"}, "body": "先月はありがとうございました、良ければまた依頼させてください。\n\n作品名：きゃらぶれーしょん！ ～乙女は恋してキャラぶれる～(あかべぇそふとすりぃ)\nキャラクター名：桜木灰&ユキ\n\nシチュエーション：灰が自信満々な表情で目を輝かせながら天に向けて人差し指を刺す、ユキがその斜め後ろで苦笑いしている。\n\n\nユキはこれと同じような表情とポーズをさせて、灰の方に体を向けるようにしてください。\nhttps://imgur.com/4OVI1vn\n\n灰に関しては表情差分をいくつか載せておきますので参考にしてください。\nhttps://imgur.com/a/DhUzQ74\n\n背景はお任せします。\n\n以上です、今回もよろしくお願いします。\n\n資料(リンク先は18禁ゲームです。)\nユキ\nhttp://www.akabeesoft3.com/products/charabration/chara01.html\n桜木灰\nhttp://www.akabeesoft3.com/products/charabration/chara03.html", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cabosu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2679042, "client_id": 469798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7dd3216c/uploads/origins/d6c13fb0-17ed-499b-9a00-a6a61e965f22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b5a55cd83c681a04ced0d8a05652ef5", "srcset": "https://si.imgix.net/7dd3216c/uploads/origins/d6c13fb0-17ed-499b-9a00-a6a61e965f22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b5a55cd83c681a04ced0d8a05652ef5, https://si.imgix.net/7dd3216c/uploads/origins/d6c13fb0-17ed-499b-9a00-a6a61e965f22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0b3e83f4578d814cf71fe8ca3a44dfd 2x, https://si.imgix.net/7dd3216c/uploads/origins/d6c13fb0-17ed-499b-9a00-a6a61e965f22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8eca508d258a866ba74b294e165164f2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7dd3216c/uploads/origins/d6c13fb0-17ed-499b-9a00-a6a61e965f22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7de5d5a106414a88105c129719a614ef", "srcset": "https://si.imgix.net/7dd3216c/uploads/orig