いです！\n\n淫魔化以降の勇者ちゃん姿の場合、淫魔将と肌色と淫紋などが同じで、角や翼の有無、服装、目の色の変化の有無などはおまかせでお願いします。ヘアスタイルと髪の色の場合、人間時代の特徴が維持されると見たいです...！\n\n内容面では、主に敗北後最初は抵抗するような勇者ちゃんが徐々に自発的に、あるいは魅了や洗脳のような要因によって淫魔将の眷属に生まれ変わる展開と考えたので、変化描写と勇者ちゃんの身体的／心理的変化の描写などを見たいです..！\n\nいろいろ複雑なリクエストですが確認していただきありがとうございます、またよろしくお願いします！もしよろしければ、よろしくお願いします！", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ssc_hideiyo/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 38686, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b01764c3/uploads/origins/34e346c7-97f3-48bb-a63d-dad390198d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cafb762b23591312daa74f987c2d2f20", "srcset": "https://si.imgix.net/b01764c3/uploads/origins/34e346c7-97f3-48bb-a63d-dad390198d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cafb762b23591312daa74f987c2d2f20, https://si.imgix.net/b01764c3/uploads/origins/34e346c7-97f3-48bb-a63d-dad390198d84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c25546e9730409eeabc9f42ac95ed819 2x, https://si.imgix.net/b01764c3/uploads/origins/34e346c7-97f3-48bb-a63d-dad390198d84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a53d34159692d84d770b99afba89b9bb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b01764c3/uploads/origins/34e346c7-97f3-48bb-a63d-dad390198d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5192da10cab140d2359892571e250ff9", "srcset": "https://si.imgix.net/b01764c3/uploads/origins/34e346c7-97f3-48bb-a63d-dad390198d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5192da10cab140d2359892571e250ff9, https://si.imgix.net/b01764c3/uploads/origins/34e346c7-97f3-48bb-a63d-dad390198d84?bg=%23fff&auto=format%2Ccompress&fm=we