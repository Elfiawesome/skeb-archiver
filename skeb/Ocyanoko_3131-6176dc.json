で切れないように作画頂けますと大変嬉しいです。\n\n何卒、よろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ocyanoko_3131/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3782659, "client_id": 3014046, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e5b4687b/uploads/origins/13544cbd-c920-4cd4-b9a5-954c09e97d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f57d6ab088c5418c2f164210fac5f811", "srcset": "https://si.imgix.net/e5b4687b/uploads/origins/13544cbd-c920-4cd4-b9a5-954c09e97d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f57d6ab088c5418c2f164210fac5f811, https://si.imgix.net/e5b4687b/uploads/origins/13544cbd-c920-4cd4-b9a5-954c09e97d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f19fcf7639153382b6676c5bfde47758 2x, https://si.imgix.net/e5b4687b/uploads/origins/13544cbd-c920-4cd4-b9a5-954c09e97d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97766337898febb0ad4a10d2c844e029 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e5b4687b/uploads/origins/13544cbd-c920-4cd4-b9a5-954c09e97d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a50d9727df17cdaf5bfa1791368fd67", "srcset": "https://si.imgix.net/e5b4687b/uploads/origins/13544cbd-c920-4cd4-b9a5-954c09e97d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a50d9727df17cdaf5bfa1791368fd67, https://si.imgix.net/e5b4687b/uploads/origins/13544cbd-c920-4cd4-b9a5-954c09e97d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c688dec208cc08ca0cc4edda83c5f84 2x, https://si.imgix.net/e5b4687b/uploads/origins/13544cbd-c920-4cd4-b9a5-954c09e97d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=584b267fad2754020cc68a27f697599e 3x"}, "body": "お世話になっております。\n\n今回、ひるなら自陣をぜひちゃこさんの絵柄で見たいと思いリクエストさせていただきました。\n形式は一枚絵/詰め込みを希望します（どちらでも大丈夫です）\n使用用途は個人観賞・SNSアイコンです。\n\n以下、資料とキャラクター詳細です。\n\n・青い方（HO1）\n大人しく、無口でぶっきらぼう。\nHO2には懐いており、柔らかい表情を見せる。\n172cm、APP14。細身。\n\n・オレンジの方\n底抜けに明るく、元気。HO1が大好きで表情豊か。\n179cm、APP18、STR14\n\nちゃこさんの絵柄やセンスのすべてが大好きなため、構図、衣装、髪型のアレンジなど描きやすいように完全にお任せします。\nとても仲良しの二人なため、強いて言うなら距離が近かったり仲良さげだと嬉しい…！です！\n\n内容、資料、金額などに不備等ございましたら再送・キャンセルしていただいて結構です。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1WX8LNhCCvK6Q9iz5ZUc-LnBSlwpFtKwB?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ocyanoko_3131/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3782659, "client_id": 3819157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0efc406d/uploads/origins/85b7d0c3-f0a4-4b5a-b784-481df63b4d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e56e7d12b2f908f74a0cf06c0524e93", "srcset": "https://si.imgix.net/0efc406d/uploads/origins/85b7d0c3-f0a4-4b5a-b784-481df63b4d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e56e7d12b2f908f74a0cf06c0524e93, https://si.imgix.net/0efc406d/uploads/origins/85b7d0c3-f0a4-4b5a-b784-481df63b4d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfa9e06f5f5fcec9a1f59e3144f130a2 2x, https://si.imgix.net/0efc406d/uploads/origins/85b7d0c3-f0a4-4b5a-b784-481df63b4d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f61348104337120f20e99ee0d9be0ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0efc406d/uploads/origins/85b7d0c3-f0a4-4b5a-b784-481df63b4d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e1ac39d062fdd24b269d1c48c51222c", "srcset":