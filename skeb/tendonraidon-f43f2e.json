ceb75a4d5cbcc64b56f2e 2x, https://si.imgix.net/6b1efcd8/uploads/origins/32d200c9-b096-49d0-88b1-7e93ee806341?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b1d49f12326c94f5e44149643ce6cab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b1efcd8/uploads/origins/32d200c9-b096-49d0-88b1-7e93ee806341?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=986b7848c9dc90083efe501c94abefec", "srcset": "https://si.imgix.net/6b1efcd8/uploads/origins/32d200c9-b096-49d0-88b1-7e93ee806341?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=986b7848c9dc90083efe501c94abefec, https://si.imgix.net/6b1efcd8/uploads/origins/32d200c9-b096-49d0-88b1-7e93ee806341?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c755db3ffc9db85102b787532c20cfed 2x, https://si.imgix.net/6b1efcd8/uploads/origins/32d200c9-b096-49d0-88b1-7e93ee806341?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4561333561763f6406427f218ecb4ce3 3x"}, "body": "雰囲気のある設定でキャラクターを描いた作品がとても好きなので、私のキャラクター、ゴーストとなるひとに絵をお願いしたいです\n\n性格としては、ゴーストは無口で引っ込み思案、感情をあまり表に出さず、無表情なことが多いです。なるひと」はゴーストが所属しているギャングのリーダーで（知らず知らずのうちに）、怒るととても攻撃的で情熱的になりますが、ゴーストのことは友人として大切に思っています。怒っていないときは、穏やかか退屈そうな表情で描かれている。\n\n外見については、ゴーストは非常に軽く、透明に見える。自由に姿を変えることができるので、ゴーストのように本当に透明な姿でも、淡い色彩の肉体の姿でも、自由に描いてください！どちらでも大丈夫です。なるひと》の服装と髪型はどのように描いてもデザインしてもよく、彼のデザインは非常に流動的である！重要なディテールは、長い白髪、褐色の肌、青い目、欠けた歯だけです。身長はゴーストが187cm、なるひとが170cmです。\n\n設定としては、雪が降る中、自販機で二人を描いてみるのもいいかな？なるひとりはホットチョコレートが好きで、ゴーストは紅茶しか飲まない！なるひとがゴーストのために缶を差し出すとか？服装はおそらく暖かいものだと思うので、もしこのアイデアで行くのであれば、なるひととゴーストの両方をもっと暖かい服装に自由に変えてください（ゴーストの色が似ていればOKです！）。\n\n私のtoyhouseのアカウントにもアップロードしたいのですが、その際はあなたのtwitterとskebのアカウントへのリンクをクレジットさせていただきます :D\n\nもしこのアイディアが気に入らなければ、どんなアイディアでもいいので描いてください。あなたが描いたものなら、私はきっと気に入ると思います！もし支払いが不十分な場合は、遠慮なくこのリクエストを再送してください。\n\nhttps://toyhou.se/26443024.ghost#8695