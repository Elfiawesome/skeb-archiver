89751f9/uploads/origins/916c23e4-0bdc-4190-b648-a6258b24b766?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=101be82f7e34fcd47c16d1270537ebfb", "srcset": "https://si.imgix.net/489751f9/uploads/origins/916c23e4-0bdc-4190-b648-a6258b24b766?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=101be82f7e34fcd47c16d1270537ebfb, https://si.imgix.net/489751f9/uploads/origins/916c23e4-0bdc-4190-b648-a6258b24b766?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6908a238e97fa178afc7499d592b9f16 2x, https://si.imgix.net/489751f9/uploads/origins/916c23e4-0bdc-4190-b648-a6258b24b766?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a8a90051d9eaf943299090027cfcd44c 3x"}, "body": "こんにちは、先生\n\n私のフォックスガール二人のエロティックなレズバトル／キャットファイトのアートをお願いしたいです。\n\n「はな」＆「つき」 : https://catbox.moe/c/p4u8ae\n\n「花」（ピンクフォックス）：チャラチャラしていてライバルを馬鹿にするのが好きだが、ライバルに馬鹿にされると攻撃的になる。プライドが高く、負けず嫌い。\n\n「月」（ブルーフォックス）：ライバルをからかったり、侮辱したりするのが好きだが、ライバルに侮辱されると逆上する。傲慢で負けず嫌い。\n\nライバルの巫女であり、相手が反撃できなくなるまで強制的にオーガズムを味わわせることに主眼を置いたライバル関係にある。\n\nバトルはできるだけエロティックに、女の子を辱めたり、ポーズやアクションをラフにするのも自由！お互いの尻尾や耳を引っ張り合うのもOK。\n\n衣装の組み合わせ（全裸もOK）、構図、勝敗についてはお任せします！ダブルKO・同士討ちもOKです！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kajikawhite/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2623967, "client_id": 1209560, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4591a815/uploads/origins/e73aa633-6e63-4879-9e24-885bc64d7c07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68c4b09664d683472403fbc387c09a5f", "srcset": "https://si.imgix.net/4591a815/uploads/origins/e73aa633-6e63-4879-9e24-885bc64d7c07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68c4b09664d683472403fbc387c09a5f, https://si.imgix.net/4591a815/uploads/origins/e73aa633-6e63-4879-9e24-885bc64d7c07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1042996a7276ca89f4ce41435cee4163 2x, https://si.imgix.net/4591a815/uploads/origins/e73aa633-6e63-4879-9e24-885bc64d7c07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d16846532d41b2abd5249d249f17375b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4591a815/uploads/origins/e73aa633-6e63-4879-9e24-885bc64d7c07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=020afdda5a45237ef7c16bb85e339363", "srcset": "https://si.imgix.net/4591a815/uploads/origins/e73aa633-6e63-4879-9e24-885bc64d7c07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=020afdda5a45237ef7c16bb85e339363, https://si.imgix.net/4591a815/uploads/origins/e73aa633-6e63-4879-9e24-885bc64d7c07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23832cabde88fbd0eabf8c0df3b85dac 2x, https://si.imgix.net/4591a815/uploads/origins/e73aa633-6e63-4879-9e24-885bc64d7c07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa32badd9937144c21b862cf693d1c08 3x"}, "body": "こんにちは！また私です。\nフタ×フタのセックスシーンを希望します。最初のフタナリ娘は、アズールレーンのスビレピー。彼女は巨大なペニスを持つロリです。胸は平らで、服は資料1-2の通り。バットを持っています。\n二人目はみねぐも。彼女はミルフで、ペニスはとても小さいです。胸は大きい。参考資料3-4のような牛娘のコスチューム（手袋、ビキニ、角、チョーカー、鈴）を着ています。\n2ポーズ欲しいです。モノクロでも可！\n最初のポーズ：スビレピーとミネグモがお互いの前に立ち、ペニスを比べている。スビレピーはバットを肩に抱えている。スビレピーの方がチンコが大きいので、悪そうな笑みを浮かべている。峰雲のペニスはとても小さく、恥ずかしくて怯えている。参考5.0-5.1.  \n2ポーズ目：スビレピーが峰雲を倒し、スビレピーが峰雲を口で犯し、頭を押す。峰雲の喉には膨らみがある。スビレピーのバットが峰雲の尻の中に入っている。二人とも大量にイク。峰雲の顔にはマスカラの涙。資料6。\n\nhttps://drive.google.com/drive/folders/1-V5YLlv9CQweeaahjrHh2CxqQrpa267O", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kajikawhite/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tippe