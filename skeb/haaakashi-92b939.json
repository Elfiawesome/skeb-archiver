ompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c007e8bc26db52b83c9fd4a4fb4b790b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55b565e0/uploads/origins/01f91b32-c8a7-4236-ae22-2f3b966898ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1de19e173159e8f0c0702136ad93afb4", "srcset": "https://si.imgix.net/55b565e0/uploads/origins/01f91b32-c8a7-4236-ae22-2f3b966898ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1de19e173159e8f0c0702136ad93afb4, https://si.imgix.net/55b565e0/uploads/origins/01f91b32-c8a7-4236-ae22-2f3b966898ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c53ec4500a28ddfc8c2aa918cb1ae743 2x, https://si.imgix.net/55b565e0/uploads/origins/01f91b32-c8a7-4236-ae22-2f3b966898ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f964442f99d8597beed9f01261857180 3x"}, "body": "はじめまして。クマショコラ先生。\n作品に一目惚れしました。\n特にメイド長イラストに心を惹かれました。\n是非私のOCを書いていただけないでしょうか。\n名前は紫苑フブキです。\n儚げな少女で歳は14歳。身長は160cm\n眠ることが好きな少女です。\n紫苑の花と雪の結晶がモチーフです。\nどのように書いてくださっても構いません。\nあなたの好きなように書いて欲しいです。\nどうかよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1azhWdi6MrEBv2KntLmScWJ65mL2pSTBH", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haaakashi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3911341, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f0feeab/uploads/origins/c8f737a0-f034-4c8f-ac66-9e5a7010add3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb474533c7043b12dd258c8a5aa3b0bf", "srcset": "https://si.imgix.net/6f0feeab/uploads/origins/c8f737a0-f034-4c8f-ac66-9e5a7010add3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb474533c7043b12dd258c8a5aa3b0bf, https://si.imgix.net/6f0feeab/uploads/origins/c8f737a0-f034-4c8f-ac66-9e5a7010add3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1348d83d56848275bbe6c848df3ee19b 2x, https://si.imgix.net/6f0feeab/uploads/origins/c8f737a0-f034-4c8f-ac66-9e5a7010add3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eafd76f78badb5d07c09b9e882f82ba4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f0feeab/uploads/origins/c8f737a0-f034-4c8f-ac66-9e5a7010add3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8aba5cf610ecd06a7c1c7eb8f133486e", "srcset": "https://si.imgix.net/6f0feeab/uploads/origins/c8f737a0-f034-4c8f-ac66-9e5a7010add3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8aba5cf610ecd06a7c1c7eb8f133486e, https://si.imgix.net/6f0feeab/uploads/origins/c8f737a0-f034-4c8f-ac66-9e5a7010add3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc64b4e691241bef0d360c6a00599fb0 2x, https://si.imgix.net/6f0feeab/uploads/origins/c8f737a0-f034-4c8f-ac66-9e5a7010add3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05dd418fc87aa2c123d533617a69fa0b 3x"}, "body": "こんにちは！あなたのイラスト、すごく素敵ですね！私のオリジナルキャラクター（OC）を描いていただけたら嬉しいです！\n\n彼女は、クールな女の子を演じることが好きな、ちょっとおっちょこちょいな女の子です！とても不器用ですが、とても陽気で愛らしい子です。仕事帰りに夜空の下でお酒を飲むのが好きで、世界中のスイーツを全部食べ尽くしたいと思っています！ \n\n細かい設定はすべてお任せします！髪の色さえ変えなければ、服装や髪型は自由に変更していただいて構いません！\n\nこのイラストはSNS（Twitch、YouTube、Twitterなど）で使う予定です！もし可能であれば、キャラクターと背景を別ファイルに分けていただけると大変助かります！\nご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/u/4/folders/1GqoQFZw4-0HNxNzeneeluYKpNi7BJLkr", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2053610, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Copi☕️", "screen_name": "Fuji100923", "ava