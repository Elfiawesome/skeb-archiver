fit=crop&crop=top&w=200&h=200&blur=200&s=5e377214beb64dd2fdf4af7a6edd32d2 3x"}, "body": "初めましてこんにちは！Vtuberのライムと申します！\n俺俺俺‼️様に是非私のことを描いて頂きたくリクエストしました！\n\nイメージ:黒いセクシービキニで振り向いておしりが強調されている\n\n構図や表情・ヘアスタイルは自由にアレンジを加えていただいて問題ありませんが、サムネに使用したいので可能でしたら頭や髪が見切れていないと嬉しいです！\n\n＊使用用途\nYoutubeのサムネやSNSでの宣伝活動での使用\n\nご対応いただけましたら、\nサインと人物・背景等のレイヤーを分けた透過データにて納品して頂けますと嬉しいです。\n\n参考資料\n3面図のツイート・ギャルの姿を掲載しました。\n\nご検討頂けましたら幸いです。\nよろしくお願い致します。\n\nhttps://twitter.com/rhymu_promisu/status/1681960617408888834?s=46&t=aOhMmKolmoDoIHqgt4OL0g\n\nhttps://drive.google.com/file/d/1P3gXuM383-yF3FfKja5gfUW2Jr8PaLeh/view?usp=drivesdk", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@urovadtt/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3213072, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a25f591f/uploads/origins/19be5c36-c3e0-409f-8447-5705869bb0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad5256928201083eefe9fe3531465228", "srcset": "https://si.imgix.net/a25f591f/uploads/origins/19be5c36-c3e0-409f-8447-5705869bb0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad5256928201083eefe9fe3531465228, https://si.imgix.net/a25f591f/uploads/origins/19be5c36-c3e0-409f-8447-5705869bb0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=854bf0ef0832104595f15bb0426edb4a 2x, https://si.imgix.net/a25f591f/uploads/origins/19be5c36-c3e0-409f-8447-5705869bb0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a5eadf15492992db5185f83e6231440 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a25f591f/uploads/origins/19be5c36-c3e0-409f-8447-5705869bb0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94a7e7c8784e374fc378f410283cb4ee", "srcset": "https://si.imgi