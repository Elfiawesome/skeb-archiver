=200&blur=200&s=63ab220c349afee8e4db001bce81649e, https://si.imgix.net/8a8f29f5/uploads/origins/74260873-4028-4048-9582-8f0da3afd373?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a2a58c88504ff6ed5fff86a4e57c1312 2x, https://si.imgix.net/8a8f29f5/uploads/origins/74260873-4028-4048-9582-8f0da3afd373?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=996788bb592014bcc86da9119e0737f0 3x"}, "body": "よろしくお願いします！\n\nこの2人のオリジナルキャラクターが登場するシーンを描いていただけませんでしょうか？この二人はCoC（Call of Cthulhu）TRPGの設定で、ヴィクトリア朝時代（1890年代）に登場します。家を持たず、一緒に路上で生活している親友です。カルト教団に所属する怖い子たちです。\n\n茶髪の少年シェイは物静かで、普段は中性的な表情か、小さく謎めいた笑みを浮かべている。アロイスのことをとても大切にしている。\n金髪の少年アロイスは大胆でおしゃべり。表情はいつも満面の笑みを浮かべている。\n\n以下のようなシーンが考えられます（描きたくなければ描く必要はありません）：\n- 廃墟となった教会を一緒に探検する\n- ろうそく、ナイフ、血を使った怖いカルトの儀式を行っている。\n- 怖いモンスターと戦ったり隠れたりしている。\n- お好きなシーン\n\nいずれにせよ、読んでくださって本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1uV4UtcsimuwnNtJvnj3WmLZ-heBRzsN9?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2491475, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "さやえんどうがたUFO", "screen_name": "maumaujanken", "avatar_url": "https://pbs.twimg.com/profile_images/1765352618854170624/OETokxLE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1463893229762269189/1638989948/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 17}, {"id": 2601564, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Kotomi💖Comms→closed", "screen_name": "Hiyokotomi", "avatar_url": "https://pbs.twimg.com/profile_images/1618621206265225216/yh_HhAGo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/16141793616237