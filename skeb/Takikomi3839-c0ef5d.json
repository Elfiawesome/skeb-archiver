b00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1237588b173779b7c2df9f9d90ecd2a9, https://si.imgix.net/cee354ff/uploads/origins/221ea2da-6f13-461e-900b-0582c1023b00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=85448c2264677a8d2ba7d930cfbb6eb6 2x, https://si.imgix.net/cee354ff/uploads/origins/221ea2da-6f13-461e-900b-0582c1023b00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fce77044778ff16eecb2d6be352dc805 3x"}, "body": "こんにちは。以前は素敵なイラストをありがとうございました。\nこちらで描かれていたような全身のイラスト依頼は可能でしょうか。\nhttps://skeb.jp/@Takikomi3839/works/8\n\nオリジナルキャラで、使用用途はTRPGの立ち絵とアイコンです。\n正面（斜めや横でも大丈夫です）の全身立ち絵希望です。\n立ち絵に使用するため背景無しの透過、もしくはレイヤー別にしていただけると嬉しいです。\n表情やポーズはお任せいたします。\n\n-----------キャラ情報-----------\nアングラ系ナイトクライブに出入りしている22歳男。\nあまり感情が表に出ず「うん」「ヤダ」など短い単語で喋り、年上にも物怖じせずに交渉する。\n\n黒マスクの下はスプリットタン＋舌ピアス。\nドMなため耳などにもピアスを開けたがり。\n服装は白の萌え袖ロングTシャツ、Gパンにモッズコート。\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1pHTRlX-QkVJ7J0kmQdM843BzAyuKoecy", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Takikomi3839/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1674023, "client_id": 192290, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f09eea02/uploads/origins/9db13ee7-288c-4617-bb5f-e79a69d3d858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a400c5f516cba79c51e3ce4f85db4d18", "srcset": "https://si.imgix.net/f09eea02/uploads/origins/9db13ee7-288c-4617-bb5f-e79a69d3d858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a400c5f516cba79c51e3ce4f85db4d18, https://si.imgix.net/f09eea02/uploads/origins/9db13ee7-288c-4617-bb5f-e79a69d3d858?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef3068197a22d80be162f0787b50653b 2x, https://si.imgix.net/f09eea02/uploads/origins/9db13ee7-288c-4617-bb5f-e79a69d3d858?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f921332b42197c31cc95099e70a04e88 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f09eea02/uploads/origins/9db13ee7-288c-4617-bb5f-e79a69d3d858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28ec47a7193c96c0de723de91fe6c747", "srcset": "https://si.imgix.net/f09eea02/uploads/origins/9db13ee7-288c-4617-bb5f-e79a69d3d858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28ec47a7193c96c0de723de91fe6c747, https://si.imgix.net/f09eea02/uploads/origins/9db13ee7-288c-4617-bb5f-e79a69d3d858?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=516773705ac7d26d279e752f2c175871 2x, https://si.imgix.net/f09eea02/uploads/origins/9db13ee7-288c-4617-bb5f-e79a69d3d858?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b0581b5f7328d666937fd1c657a637ac 3x"}, "body": "こんにちは、私はあなたのアートでの風景の描き方に憧れています。私のオリジナルキャラクター2人のイラストをお願いしたいと思います。\n\n🌅 キャラクターAの詳細です。男性。身長185cm。32歳。ウェーブのかかった黒髪。ヘーゼルの目。陽気で社交的な人。かなりの筋骨隆々。神父の服を着ている。\n\n🌌キャラクターBの詳細です。見た目は男性。身長180cm。28歳。黒髪。ダークブルーの瞳。ストイックな顔立ちの穏やかな人。肩幅が広く、ウエストが細い。\n\nAは、終わりつつある世界で子供たちを見守る教会を運営する神父である。Bは、Aの世界の終わりを見守るために異世界から送られてきたロボット。二人は友人であり、パートナーでもある。AはBを愛しているが、Bはまだ愛を知らないため、Aへの気持ちに気づいていない。\n\nイラスト1:\nAを後ろから描いてください。Aは一人です。教会の窓から外を見ていて、空は青とオレンジの色できれいです。絵の雰囲気としては、「とても長い間耐えてきた人」であってほしいと思います。物思いに耽っている感じです。\n\n下絵はフォルダの中に「Illustration01」と書かれています。\n\nイラスト2です。\n背景はイラスト1と同じです。ただし、Aはもう一人ではありません。BがAのそばに立ち、AがBを見て微笑んでいる様子を描いてください。このアートの雰囲気は「あなたがそばにいてくれてよかった」です。より希望に満ちた感じになっています。\n\nこのスケッチは、フォルダの中に「Illustration02」と書かれています。\n\nありがとうございました。依頼内容にご納得いただけない場合は、遠慮なくお断りください。\n\nhttps://drive.google.com/drive/folders/1-sh6lUAO3fM5AA6SYGepefuxAqdx5EEC", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Takikomi3839/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1674023, "client_id": 1239623, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f38136f3/uploads/origins/002b4f06-61ae-4efe-8e97-f50da32681d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45d163115d3259cd6eeac310db0d18c3", "srcset": "https://si.imgix.net/f38136f3/uploads/origins/002b4f06-61ae-4efe-8e97-f50da32681d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45d163115d3259cd6eeac310db0d18c3, https://si.imgix.net/f38136f3/uploads/origins/002b4f06-61ae-4efe-8e97-f50da32681d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fcd76cb709ef33457300055cc56264e 2x, https://si.imgix.net/f38136f3/uploads/origins/002b4f06-61ae-4efe-8e97-f50da32681d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e70ac8db15f30b3607f5fbefadfb137b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f38136f3/uploads/origins/002b4f06-61ae-4efe-8e97-f50da32681d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c8fae13d2c574f768552864b3c90f01", "srcset": "https://si.imgix.net/f38136f3/uploads/origins/002b4f06-61ae-4efe-8e97-f50da32681d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c8fae13d2c574f768552864b3c90f01, https://si.imgix.net/f38136f3/uploads/origins/002b4f06-61ae-4efe-8e97-f50da32681d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0714c17e8131caea1f5c385b18df95e2 2x, https://si.imgix.net/f38136f3/uploads/origins/002b4f06-61ae-4efe-8e97-f50da32681d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ebdba836f5781fd315a27b49e35fbbf4 3x"}, "body": "こんにちは、あなたのアートスタイルが気に入ったので、私のキャラクターの絵を依頼したいと思います。彼は時々、遊び好きな猫のように振る舞います。あなたは完全にコント