peals_count": 1, "received_works": [{"path": "/@fuyuki3329i/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 736984, "client_id": 337561, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f812722/uploads/origins/d4edd08e-9aa6-49fb-bf58-c37a933bd376?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66c4c67b0aca642ae48056dfea6aa73e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f812722/uploads/origins/d4edd08e-9aa6-49fb-bf58-c37a933bd376?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=083a303c2e9295df0ae97652243c2a86", "src_set": ""}, "body": "以前ガスマスクを付けた黒ローブの子をリクエストさせていただいた者です\n先日はリクエストの承認ありがとうございました\n先日依頼した子を再度描いていただきたいと思いリクエストを出させていただきました\n\n今回はXのヘッダーで使用させていただきたいと思っておりますのでサイズが3:1の比率に近い物でしたらとても助かります\nポーズは片膝建てて床に座っているものが希望です\n\nもしよろしければお願いいたします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fuyuki3329i/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b78d6f2d/uploads/origins/b23b1495-1b0e-47c0-a014-e694da7a51db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ee72dd9fb598826097b7f67687c6ed7", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 736984, "client_id": 119745, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@fuyuki3329i/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 736984, "client_id": 337561, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d9ce431/uploads/origins/3d17fadb-12a1-4231-9dd2-deef8faecc9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b4ebde4bacde12824c14ecdac2ccc7e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d9ce431/uploads/origins/3d17fadb-12a1-4231-9dd2-deef8faecc9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f210c6b501f828d0a48dcb9703e5f8f0", "src_set": ""}, "body": "初めまして\nフ雪さんの描かれる中二感を前面に押し出したイラストをお願いいたしたいです\n\n\n服装は黒ローブ\nイメージとしましてはキングダムハーツシリーズの13機関のローブです\nフードは被った状態ではなく後ろへ下げた状態\n\nキャラクターは先日投稿された白銀の子\n(https://x.com/fuyuki3329i/status/1838139946936500503)\nこちらの左の子です\nこの子の髪をボブヘアに伸ばしていただけると嬉しいです\n\n装飾として口元を覆うガスマスクを(非フルフェイスでお願いします)\n\nシーンとしては手袋をキュッとはめているところ\nその他の構図や装飾はお任せという形でお願いいたします\n\n\n主な希望は以上です\n総じて曖昧な要望になってしまいましたが、もしよろしければお願いいたします", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fuyuki3329i/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 736984, "client_id": 1250371, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/533c2a19/uploads/origins/57e6fee7-d19d-460a-8e7d-26cf550d40b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9736af6e1c4e19cb78488d4410c844cc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/533c2a19/uploads/origins/57e6fee7-d19d-460a-8e7d-26cf550d40b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1651fa78841919765c31a3873391974", "src_set": ""}, "body": "はじめまして、フ雪様。\nツイッターでお見かけし、とても素敵ですので、フ雪様にうちの子を描いてほしいと思い、今回新規リクエストを送信させていただきました。\n投稿されているイラストで、和装も洋装もとても素敵で、描かれ方がとても好みです。\n\n描いてほしいうちの子の資料は下記のツイートの通りです。:\nhttps://twitter.com/littlenight_sh/status/1414542351125471232\nキャラ詳細\n・黒髪ロングストレート\n・緑かかった黒い瞳\n・胸は薄目\n・中高生くらいのイメージ\n資料からの追加事項\n・銀色の狐耳・尻尾をお願いいたします。\n黒い髪の毛に銀色の狐耳(尻尾)となります。\n\n性格は明るく素直純真元気な甘えたがりな子となります。\n\n服装・シチュエーションのイメージとして\n・髪の毛に細いタイプのリボン、上半身は和装、下は洋装のロングスカートのイメージをお願いいたします。\n・うれしそうに、踊っているようなイメージで楽しそうな姿をお願いいたします。\n・桜の花が散り葉桜となっている昨今ですが、緑芽吹き生命あふれる春のようなイメージ(かなり曖昧なご指定ですのでここはご無理なさらなくても大丈夫です)\n\nその他ポーズ・構図についてはフ雪様にお任せいたします。\nご検討のほどよろしくお願いいたします。\n\nhttps://twitter.com/littlenight_sh/status/1414542351125471232", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fuyuki3329i/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 736984, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86c3a8df/uploads/origins/10c5a51b-ae89-4c72-8b14-ec7e2c719ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=638cdaade328121649eb1a88c0584940", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86c3a8df/uploads/origins/10c5a51b-ae89-4c72-8b14-ec7e2c719ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf2775caf3d865d4cae2a7b45057a03f", "src_set": ""}, "body": "フ雪様\n\n初めまして、突然の依頼失礼いたします。\n投稿されているイラスト、服のデザインに惚れ込み\n是非イラストを描いていただきたいと思い依頼させて頂きました。\n\nイメージとしては、桜吹雪の中、高校生位の女の子、髪の色は銀髪or白髪で髪の長さはミディアム～ロング\n表情や構図、服装等はお任せします。\n\n使用用途としてはPCの壁紙として使用させて頂ければと思っています。\n\nSkebでの依頼が不慣れのため、情報等至らない点があり申し訳りませんが\n宜しくご検討お願いします。", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fuyuki3329i/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 736984, "client_id": 425230, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa5c5c2e/uploads/origins/64e36bb5-cadb-45b0-b234-e0b4f6383b1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1447eca8a1263f45408c42f2c14e34fe", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa5c5c2e/uploads/origins/64e36bb5-cadb-45b0-b234-e0b4f6383b1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=004cde5f8d841b3e49d4778f065c4267", "src_set": ""}, "body": "初めまして。 \n私がゲームで使用しているアバターを描いていただきたく依頼いたしました。\n\n イラストの詳細は、\n・長髪、茶髪、垂れ耳うさぎの女の子(長髪であれば髪型自由)\n・和装＋和装に合うキャスケット\n・露出は少なめ\n・イメージの季節は秋、または冬(イラストに取り入れなくても問題ありません)\n・構図はお任せでお願いします\n\n\nアバウトな内容になりますが、どうか よろしくお願いします。(何かしらの理由で資料が見れない場合、即キャンセルしてください)\n\nhttps://drive.google.com/drive/folders/10zi1fI7-HMBYjtCuG00qdruOGACvt_BF?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 60445, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "夜和-yokazu-　🎨イラストレーター/Live2Dモデラー ⚙️依頼受付中", "screen_name": "yokazuRN_021", "avatar_url": "https://pbs.twimg.com/profile_images/1644966210109603840/QfB-Vkl4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/928932938397319168/1686542081/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "nc": 144}, {"id": 776286, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "伊賀野スシヲ", "screen_name": "ikano_sushio", "avatar_url": "https://pbs.twimg.com/profile_images/1530481684633636864/zMVIhb7x.jpg", "header_url": "https://pbs.twimg.com/profile_banners/761450768914223104/1637918370/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 0}, {"id": 1147822, "creator": true, "nsfw_acceptable": true, "acceptable": true