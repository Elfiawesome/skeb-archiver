3d-49ac-a45d-027b89c45fcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=476b305411202fe203c5cdd52e12588c 2x, https://si.imgix.net/56d3386e/uploads/origins/ac0ab0b8-b73d-49ac-a45d-027b89c45fcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5b13e23af61124e0f37df53fcffedbef 3x"}, "body": "なつのよる様こんばんは、初めまして。\nなつのよる様の淡くて素敵なイラストがとても好きで、この度は自創作のイラストを描いて頂けきたくリクエストを送らせて頂きます。\n①のドライブ内にある天使×悪魔ペアを時系列順（幼少期2人➡️堕天前成長後2人➡️堕天後2人）で落書きやラフのような簡易的なイラストでも構いませんので可能でしたら描いて頂けましたら嬉しいです。 \nもし描いて頂ける場合には、幼少期の2人はルシファーがミカエルを引っ張り2人とも笑顔の構図  堕天前成長後の2人はルシファーが皮肉を言い屈託のない笑みを浮かべミカエルと言い合いをしている構図 ルシファー堕天後の2人はミカエルについてはおまかせにさせて頂きたく、ルシファーについては羽の1枚（黒色）が床に落ちている（姿なし）構図\n⬆️こちらの雰囲気だと嬉しいです。ミカエルは右、ルシファーは左の位置にして頂ければ幸いです。こだわりが強く要望も多く大変申し訳ありません😭所々お好きに雰囲気は変えて頂いて大丈夫です。\n本当に可能であればで構いませんので、難しければ2人の一枚絵、または資料②のペアのイラストを描いて頂けたら嬉しいです。\n\n金額不足や難しい場合にはお手数お掛け致しますが再送、キャンセルして頂ければ幸いです。\nご縁がありまたらよろしくお願いいたします🍀\n\n①https://drive.google.com/drive/folders/1jXCX_XUJU-Xy1Olu8TfkJ6YHjZXDscca\n\n②https://drive.google.com/drive/folders/1PQxbrY-vDAO2KJ9qcQqPpZgUKjlg9N_C", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoru_in_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3944102, "client_id": 4031769, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba8d768e/uploads/origins/92b3130b-e2c4-4b6c-a9b9-9afc0b897a5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35804d068e92c4adcfc5f1f45260d284", "srcset": "https://si.imgix.net/ba8d768e/uploads/origins/92b3130b-e2c4-4b6c-a9b9-9afc0b897a5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35804d068e92c4adcfc5f1f45260d284, https://si.imgix.net/ba8d768e/uploads/origins/92b3130b-e2c4-4b6c-a9b9-9afc0b897a5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1af90ae57866d8f2963db6999b821a9b 2x, https://si.