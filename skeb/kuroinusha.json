mount": 2000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 1, "received_works": [{"path": "/@kuroinusha/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 284146, "client_id": 1431040, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf48a66d/uploads/origins/775d380e-0d88-4ded-8923-1fb511e7ef9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8519a2c52e2f3ecb191c623cadfbea4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf48a66d/uploads/origins/775d380e-0d88-4ded-8923-1fb511e7ef9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1287d898e6c7a3f4890b5953142a517", "src_set": ""}, "body": "こんにちは。劇場版忍たま乱太郎ドクタケ忍者隊最強の軍師の劇中に登場した『ドクタケ忍者隊巻ノ一』内の鬼娘ユキちゃんとトモミちゃん(指は５本で)をお願いしたいのですが宜しいでしょうか?\nhttps://drive.google.com/drive/folders/1O9o5Ez3WjleDhATwvvncX0RHXua4KDAk\n\nhttps://drive.google.com/drive/folders/1MW1EocZNqnu1RN6LQI1-JbEMrB66uC8Q", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuroinusha/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 284146, "client_id": 2065942, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d53f98d/uploads/origins/7a3ca479-9c1f-41f5-9b2d-b9918d5cf465?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecbeaf92aa72a08544de3f0c622f733f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d53f98d/uploads/origins/7a3ca479-9c1f-41f5-9b2d-b9918d5cf465?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=282f6b719000a0119f6e9d2b84c838d6", "src_set": ""}, "body": "こんにちわ。依頼させていただきます。\n\nファンタジア・リビルドのサーリスを描いていただきたいです。\n武器は省略しても大丈夫です。\nオトナのお姉さん的イメージで描いていただきたいです。\nポーズや表情はお任せいたします。\n\nサービス終了したソシャゲのキャラクターで資料が少なく申し訳ございません。\n見えない部分等はご自由に描いていただけるとありがたいです。\n\nご検討いただけたら幸いです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/0/folders/1F4L4tITeacQ7PTeXtAfc8Au6PbDBerlD", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuroinusha/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 284146, "client_id": 2065942, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b782ae5b/uploads/origins/5c43211f-911b-4315-b7e0-04b41863887f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb7abf238cb325b0760049ac62804c2e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b782ae5b/uploads/origins/5c43211f-911b-4315-b7e0-04b41863887f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a84370b816f7dcd99e1977ff89003ae", "src_set": ""}, "body": "こんばんわ。前回は素晴らしい納品ありがとうございました。\nまた依頼させていただきます。\n\nデート・ア・ライブの時崎狂三を描いていただきたいです。\n\n衣装は資料にある「アトラナート」というメカスーツでお願いします。\n\n資料がこのイラストと小説の地の文のみなので見えない部分等はアレンジしていただきたいです。\n面倒であればボディスーツの部分のみで細部のメカは省略していただいても大丈夫です。\n\nカラーリングは資料のドレスを参考にした配色にしていただきたいですが、もし他に似合いそうなカラーリングがあればお任せしたいです。\n\nポーズはお任せいたしますが表情は悪い感じの笑顔でお願いします。\n\n資料が少なく申し訳ありませんがご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/0/folders/1CV9ShS2FQoiJQ7ZA5lEN77kncVvq7Cpi", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuroinusha/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 284146, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4484686/uploads/origins/ab3a58ca-e6bf-44a3-8e95-d74881dbe47d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=077e0e9b33f48bf04cb8445e77fce1a6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4484686/uploads/origins/ab3a58ca-e6bf-44a3-8e95-d74881dbe47d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5379d58f9aeaf837b108ef82d67befae", "src_set": ""}, "body": "ルパン三世の漫画のほうの石川五ェ門をリクエストしたいです　モンキー・パンチ先生の五ェ門はかなり少年ぽいと思ってのリクエストです", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuroinusha/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 284146, "client_id": 3562264, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c918be73/uploads/origins/d705421d-35d2-47ff-ad35-311aca4051d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d5264910fbe82ad1ef9ff8e947b4fd5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c918be73/uploads/origins/d705421d-35d2-47ff-ad35-311aca4051d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a271d5c31e6d6a1684d9c6a2a8499e2", "src_set": ""}, "body": "こんにちは！僕はファイナルファンタジーのキャラクターの一部を手に入れたいと思っているんだ。彼女のスクリーンショットのリンクを貼っておきます。彼女は剣と盾で戦う戦士で、普段は炎を振りまいている！戦っていないときは優雅で、戦っているときは残忍だ。高貴な女性で、裕福な家の後継者です。あなたのデザインを楽しんでください！私は彼女がタンクトップか何かでシャツなしで終わっても気にしません。あなたの芸術的な目を信頼しています！\n\nhttps://imgur.com/a/KJGiRTT", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuroinusha/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 284146, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91438e71/uploads/origins/1805d3e7-9d2d-4d7c-8305-cb2fae7f15ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abd72b13d85397b1c915e4edb043a6f5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91438e71/uploads/origins/1805d3e7-9d2d-4d7c-8305-cb2fae7f15ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fc49452224d67fc5f2558b7c7ba274a", "src_set": ""}, "body": "匿名にて失礼いたします。よろしければ『星獣戦隊ギンガマン』の「操舵士シェリンダ」をお願い出来ればと思います。\n\n構図（画角・ポーズ等）は犬丸様のセンスに勿論お任せいたします。もしお受け下さるのであれば、クールかつ可能な範囲でセクシーに描いていただけますと幸いです。尚、資料中のビキニアーマー姿でも、想像の赴くまま「衣装チェンジ」でも差支えございません。（尚、衣装の変更につきましては、skeb内をキャラクター名で検索されますと例が複数出てまいります。）\n\n以上、大変お手数おかけしますが、ご検討の程何卒宜しくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Afl5NRsMDvNrdsE_8PeCZLEKpEmq3nbn?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuroinusha/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 284146, "client_id": 2065942, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15ef0e92/uploads/origins/447b98d8-5434-4cb1-b8c6-14918229450a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b55bdcca2440a721a2e1adbf6708e0b8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15ef0e92/uploads/origins/447b98d8-5434-4cb1-b8c6-14918229450a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b7b6c488605d854cac56fe557411c5d", "src_set": ""}, "body": "はじめまして。依頼させていただきます。\n\nスレイヤーズのリナ・インバースを描いていただきたいです。\n衣装は資料の「1 」でお願いします。\n元気な感じの表情、ポーズにしてください。\n\n男子でもお姉さんキャラでもなく申し訳ございませんが…ご検討いただけたら幸いです。よろしくお願いします。\n\nhttps://drive.google.com/drive/u/0/folders/1GRQ7nZ3NpJgX6iys2twBuoeCtIY1Glbw", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuroinusha/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 284146, "client_id": 117991, "vt