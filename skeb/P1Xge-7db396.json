r=2&fit=crop&crop=top&w=200&h=200&s=62ab8a685f87da8b9c600985ac8cbc40 2x, https://si.imgix.net/b6a1b9ef/uploads/origins/13041dc9-1ae0-4e38-8292-152a05301f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=571f1fd55cfed4377f42873e5c28abbc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6a1b9ef/uploads/origins/13041dc9-1ae0-4e38-8292-152a05301f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49cf3eedaa7d48d64900fc4c21ded485", "srcset": "https://si.imgix.net/b6a1b9ef/uploads/origins/13041dc9-1ae0-4e38-8292-152a05301f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49cf3eedaa7d48d64900fc4c21ded485, https://si.imgix.net/b6a1b9ef/uploads/origins/13041dc9-1ae0-4e38-8292-152a05301f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4e9a8ec0ec125f01af9912db6fc57c5d 2x, https://si.imgix.net/b6a1b9ef/uploads/origins/13041dc9-1ae0-4e38-8292-152a05301f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eaad19014126c1c1fc09fb44bf62a4c9 3x"}, "body": "いつもお世話になっております。\n今回、桃原のあ様にオリジナルキャラクターを描いて頂きたくリクエストを送らせていただきました。\n\nキャラクターの詳細は以下のリンクから確認して頂けると幸いです。\n\n表情、構図、衣装等は全てお任せ致します。\nできれば仲良しに描いて頂けると嬉しいです。\n\n最近暑くなって参りましたので、体調を崩さないようご自愛ください。\n以上要件のみとなりますが、よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/129Pt1eNVP0kHPCSxjMp4O04B5jdr2BDq", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@P1Xge/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2368686, "client_id": 2598427, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f27b7484/uploads/origins/101e9bdf-5b57-4941-81f7-fea1f3d29dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ff3e1a018b789133398b9dcc7c49f97", "srcset": "https://si.imgix.net/f27b7484/uploads/origins/101e9bdf-5b57-4941-81f7-fea1f3d29dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ff3e1a018b789133398b9dcc7c49f97, https://si.imgix.net/f27b7484/uploads/origins/101e9bdf-5b57-4941-81f7-fea1f3d29dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0641b762c588858eab56ae8d6ce035f6 2x, https://si.imgix.net/f27b7484/uploads/origins/101e9bdf-5b57-4941-81f7-fea1f3d29dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a01e2d4e9f374cfd57c533dea5ee9a2c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f27b7484/uploads/origins/101e9bdf-5b57-4941-81f7-fea1f3d29dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8334125eb71823b9a0fa4076fad9d63", "srcset": "https://si.imgix.net/f27b7484/uploads/origins/101e9bdf-5b57-4941-81f7-fea1f3d29dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8334125eb71823b9a0fa4076fad9d63, https://si.imgix.net/f27b7484/uploads/origins/101e9bdf-5b57-4941-81f7-fea1f3d29dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=82696dac05372283c5ee12449dd57ed7 2x, https://si.imgix.net/f27b7484/uploads/origins/101e9bdf-5b57-4941-81f7-fea1f3d29dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=03d8f69000a3dcfc07f815d2d63275a0 3x"}, "body": "のあさんこんにちは。アミノサンと申します。\n　私は完結企画キャラのコンバートでCoCをしており、今度女体化タイマンシナリオに行くことになりました。そこで、のあさんに2名分の女体化立ち絵を描いて戴けないかと思っております。(せっかく女体化するなら、絵柄からとことん可愛くなりたいので…)\n\n\n<依頼内容>\n　全身立ち絵2名分のお願いです。ポーズ等の指定はありません。\n　また、衣装のデザインもお願いしたいです(詳細は<デザインについて>)。\n　なお、主な参考資料は資料A(普段の立ち絵)と資料B-12(女体化時の顔つき等に関する設定イラスト)です。\n\n<キャラクターの設定>\n　関西出身の幼馴染であり、仲の良い友人。女体化時の身長はA>B(10cm差)。\nA:黒髪のキャラクター(友人宅)\n　人気の芸人。明るく人好きのする性格。イメージカラーは赤。\n　女体化時:癖毛のセミロング。まつ毛が長くギャルっぽい顔つき。バストサイズが大きい。\nB:白髪のキャラクター(自宅)\n　著名な落語家。聡明で少し軟派な性格。イメージカラーは青。\n　女体化時:髪質はストレートで、肩に着く位の長さ。バストサイズはB。\n\n<デザインについて>\n　服装等のデザインもお願いしたいです。\n※資料B-12では男性時の衣装を着ていますが、女体化立ち絵では男性時の衣装と違う服を着てほしいと考えています。\n・現代風、女性らしい雰囲気があるもの、遊びに行くときに着る服、洋服が望ましいです。\n　(イメージと違う服装の例:和服、パンツスーツ、パーティドレス、ロリータ衣装)\n・髪の長さと髪質は固定ですが、髪型・ヘアアレンジ等はそのままでも変えていただいても大丈夫です！\n・年齢イメージは20代前半〜半ばでお願いします。\n\n<使用用途>\n・CoCシナリオの立ち絵\n　(現在の通過予定シナリオ:『Myrtle(ひちころりさん作)』)\n・SNS等への公開(クレジット記載)\n\n<その他留意点>\n・通過予定シナリオを記載しましたが、特にシナリオ内容の把握や立ち絵へのシナリオ要素反映を要求するものではありません。\n・資料はタイマン相手が作成し、使用許可を得ています。\n\n　何か失礼がありましたら申し訳ありません。金額の不足・対応していないリクエスト等ございましたら、金額の再設定やリクエスト不受理でご対応いただきますようお願いします。\n\nhttps://drive.google.com/drive/mobile/folders/1TvArzvK95B-64lX5AGE2cwLCsoldB2Nu?sort=13&direction=a", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@P1Xge/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2368686, "client_id": 2709177, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/593bd295/uploads/origins/34e76192-9cb6-433f-bb65-efe49844c777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e874742277784d93113fe49e187ad3c", "srcset": "https://si.imgix.net/593bd295/uploads/origins/34e76192-9cb6-433f-bb65-efe49844c777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e874742277784d93113fe49e187ad3c, https://si.imgix.net/593bd295/uploads/origins/34e76192-9cb6-433f-bb65-efe49844c777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=555be756ff4acc712860f7c9e8984f3a 2x, https://si.imgix.net/593bd295/uploads/origins/34e76192-9cb6-433f-bb65-efe49844c777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=117583219752947627b99f443b16760c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/593bd295/uploads/origins/34e76192-9cb6-433f-bb65-efe49844c777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blu