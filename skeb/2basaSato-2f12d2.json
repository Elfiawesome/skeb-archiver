=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b4faf6b868e95313eb6c8b81db2daf3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c400cd40/uploads/origins/b6e36a3a-fd6f-483c-85a7-f1c7ec5934a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0366a12c1c2617741771fb1ff55050fe", "srcset": "https://si.imgix.net/c400cd40/uploads/origins/b6e36a3a-fd6f-483c-85a7-f1c7ec5934a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0366a12c1c2617741771fb1ff55050fe, https://si.imgix.net/c400cd40/uploads/origins/b6e36a3a-fd6f-483c-85a7-f1c7ec5934a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d54493717ed8d8dffc5502da8b5652c 2x, https://si.imgix.net/c400cd40/uploads/origins/b6e36a3a-fd6f-483c-85a7-f1c7ec5934a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e3c2776525d38de71265811e6ccbfa4b 3x"}, "body": "こんにちは！度々リクエストお邪魔しております。\nファンアート等お見せしてくださったり、skebでも丁寧に練られた素晴らしいイラストを納品頂きまして毎回本当にありがとうございます。\n助かっております……（命が😇）\n\n今回よろしければ、佐藤さん宅の姫宮恋ちゃんと仰音エノクがお話してるショート漫画を読んでみたいと思いました。\n佐藤さんの独特の切り口が面白くて好きですので、何もかもご自由に描いて頂ければと思っておりますが（仰音に現代の服を着せるなどOK）、もしお題がある方が描きやすければ「眉メイク」をネタにお願いできればと思います。\n\n不都合あればご遠慮なくキャンセルして頂いて構いません。\n気楽にご制作頂ければ幸いです！^_^\n何卒、よろしくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2basaSato/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 998042, "client_id": 1336734, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/156e58c3/uploads/origins/aece61c3-dbc9-4d22-a843-8bfef83ac5d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0501d9a820dce7ee422453979157e29", "srcset": "https://si.imgix.net/156e58c3/uploads/origins/aece61c3-dbc9-4d22-a843-8bfef83ac5d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0501d9a820dce7ee422453979157e29, https://si.imgix.net/156e58c3/uploads/origins/aece61c3-dbc9-4d22-a843-8bfef83ac5d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=567feaf3fd4a4fe7cbdebe01562b920f 2x, https://si.imgix.net/156e58c3/uploads/origins/aece61c3-dbc9-4d22-a843-8bfef83ac5d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22105ffafda12a1ad160a330287f4b8f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/156e58c3/uploads/origins/aece61c3-dbc9-4d22-a843-8bfef83ac5d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=affcf5f92349cbf8958c3d941aabce43", "srcset": "https://si.imgix.net/156e58c3/uploads/origins/aece61c3-dbc9-4d22-a843-8bfef83ac5d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=affcf5f92349cbf8958c3d941aabce43, https://si.imgix.net/156e58c3/uploads/origins/aece61c3-dbc9-4d22-a843-8bfef83ac5d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=159defdd09e280997224a8da4a99e283 2x, https://si.imgix.net/156e58c3/uploads/origins/aece61c3-dbc9-4d22-a843-8bfef83ac5d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8d85d6815673061ca585d73db242c290 3x"}, "body": "お久しぶりです。\n様々な分野の創作を手がけていらっしゃりながら、たゆまぬ研鑽と独自の工夫を凝らされる姿勢、尊敬しております。\n\n（『とな天』をプレイしましたが、ゲームを構成する全てがこだわりぬかれていて、重厚さに驚きました……！かなりの根気を要する作業かと思います。以後の作品にも力を込めているお姿本当に凄いです。とな天では西くんと九十九くんの穏やかコンビが特に好きです……天使化の描写もおぞましい中に美を感じさせますね……）\n\n＊＊＊\n\nお忙しいところにリクエスト恐れ入ります。今回もし気が向けば、拙作のUTAU音源「解鐘ユスト」の成長した姿を描いて頂けないでしょうか？\nというのも佐藤さんがご制作した楽曲「アバン」がたまらなく好きだからです。キャラの少ない情報から、あれほどに深みを生み出してくださったこと、いつまでも嬉しく感謝でいっぱいです。詩・MV・曲の構成いずれも、神秘的な空気感と猛烈な人間味が混ぜ合わせになっている不思議な感覚が癖になります。（最後のイラストのカットすさまじく綺麗です……）\n\nまた、当時13歳の設定だった解鐘ユストも2025年で17歳になる計算なので、その姿を佐藤さんであればどんな風に想像してくださるだろうか？と気になってこのような希望を送りました。\n髪型や服装等、なんでもご自由に描いて頂ければと思います。姫宮恋ちゃんのバリエーション豊かな服装に見られる佐藤さんのファッションセンスに惚れておりますので……！\n\n＊＊＊\n\nなおかつ全くの未定ですが、この度のイラストを「解鐘ユスト青年版」音源立ち絵のデザインとして活用させて頂く可能性が若干あります。（当リクエストにて全身の描写を要してはいませんが、もちろん佐藤さん次第で全身を描いてくださっても嬉しいです）\nつまり納品画の容姿をベースにこちらの方で（衣装を加えたりして）立ち絵を描き起こすケースもあり得るということです。その点、ご留意頂ければ幸いです。\n私の方でその立ち絵＋音源を披露する際には、佐藤さんのお名前や当該skebURLをクレジット致します。\n\nリクエスト内容に差し支えがありましたらご遠慮なくキャンセル頂いて構いません。\n箸休めとしてお気軽に描いて頂ければ幸いに存じます。\n不躾な点があったかもしれませんが、読んで頂きありがとうございました。\n\nhttps://aogine-em.tumblr.com/library", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2basaSato/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 998042, "client_id": 1441297, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/679e2907/uploads/origins/cb07132f-e90f-4afa-92af-3b66ca4d8c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33fe0293443b058b88cc7d6f277e2281", "srcset": "https://si.imgix.net/679e2907/uploads/origins/cb07132f-e90f-4afa-92af-3b66ca4d8c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33fe0293443b058b88cc7d6f277e2281, https://si.imgix.net/679e2907/uploads/origins/cb07132f-e90f-4afa-92af-3b66ca4d8c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94748541a44a3d52d64aa0246fb69f30 2x, https://si.imgix.net/679e2907/uploads/origins/cb07132f-e90f-4afa-92af-3b66ca4d8c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9391223923c93bce075c3b189fbd3d1a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/679e2907/uploads/origins/cb07132f-e90f-4afa-92af-3b66ca4d8c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33bd2ba98410aaa7ee8bc691f6e99444", "srcset": "https://si.imgix.net/679e2907/uploads/origins/cb07132f-e90f-4afa-92af-3b66ca4d8c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33bd2ba98410aaa7ee