拠の大雑把にまとめ上げたようなポニーテール、片目隠れ、アホ毛\n　髪色：朝霜改二準拠の銀髪、裏は青紫\nウマ耳：ツインターボのウマ耳の形状準拠で、色あいは朝霜改二準拠の外側及び内側の一部銀色、内側は青紫色\nリボン：ツインターボのツインテールをまとめるリボンを一つにまとめたようなデザインでポニーテールをまとめる\nポーズ：おまかせ\n　背景：デカデカと「よっしゃー、行ったろー！」\n　\nというようなリクエストをさせていただきます。\nスケブのリクエスト初めてのため、至らないところあると思いますが、ご検討いただければと思います。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@saga_sankaku/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1015912, "client_id": 426896, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5439f9e4/uploads/origins/6acbab8c-4b0f-4d0a-b626-be635dba6252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f898db5625a8a29d3355208e8619d802", "srcset": "https://si.imgix.net/5439f9e4/uploads/origins/6acbab8c-4b0f-4d0a-b626-be635dba6252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f898db5625a8a29d3355208e8619d802, https://si.imgix.net/5439f9e4/uploads/origins/6acbab8c-4b0f-4d0a-b626-be635dba6252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bb63f7e0916c9b4cf27ed21d3bcbfd1 2x, https://si.imgix.net/5439f9e4/uploads/origins/6acbab8c-4b0f-4d0a-b626-be635dba6252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e78572ecfe1f9f7cb6e1f94477609bf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5439f9e4/uploads/origins/6acbab8c-4b0f-4d0a-b626-be635dba6252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64678ed4cbbbd2f287f2957536283690", "srcset": "https://si.imgix.net/5439f9e4/uploads/origins/6acbab8c-4b0f-4d0a-b626-be635dba6252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64678ed4cbbbd2f287f2957536283690, https://si.imgix.net/5439f9e4/uploads/origins/6acbab8c-4b0f-4d0a-b626-be635dba6252?bg=%23fff&auto=format%2Ccompress&fm=webp&d