200&blur=200&s=b4624ad9b03e4275bdc4f60a278571d0", "srcset": "https://si.imgix.net/c3580e2c/uploads/origins/0496a7aa-cb5c-4a80-a3a8-0dc20309c744?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4624ad9b03e4275bdc4f60a278571d0, https://si.imgix.net/c3580e2c/uploads/origins/0496a7aa-cb5c-4a80-a3a8-0dc20309c744?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e300eca43ea58bd291ff1ace35f5a86a 2x, https://si.imgix.net/c3580e2c/uploads/origins/0496a7aa-cb5c-4a80-a3a8-0dc20309c744?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1e0f2a5eca60516697b62c6c0c2e6091 3x"}, "body": "こんにちは、先生\n\n私のキャラクター2人のエロティックなレズバトル／キャットファイトのアートをお願いしたいです。\n\n\"みやこ\"（外向的で淫乱、ちょっと生意気、卑怯な手段も厭わない）：https://catbox.moe/c/0xxsgk\n\n\"ユメ\"（チャラチャラしていて、意外と変態、勝つためなら何でもする）：https://catbox.moe/c/cutv6k\n\n相手が反撃できなくなるまで、強制的にオーガズムを味わわせることに重点を置いたライバル関係。\n\nできるだけエロティックなバトルにして、女の子を辱めたり、ポーズやアクションをラフにしたり、自由に楽しんでください！\n\nお望みなら、バイブやディルド、ストラップオンなど、セックストイをお互いに使って描くこともできます！\n\nさらに楽しむために、好きなタイプの人型生物として描くこともできます。エルフ、猫娘、狐娘、悪魔、天使など。お好きなタイプを描いてください！\n\n服装の組み合わせ（裸でもOK）、構図、勝敗などはお任せします！ダブルKO・相討ちもOKです！", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tinanagoTataki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3343357, "client_id": 71755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c39282ee/uploads/origins/7b5055ae-43b7-4df1-a1de-e24fb7e6ee28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36e112c6d22e2d880a77781038c564df", "srcset": "https://si.imgix.net/c39282ee/uploads/origins/7b5055ae-43b7-4df1-a1de-e24fb7e6ee28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36e112c6d22e2d880a77781038c564df, https://si.imgix.net/c39282ee/uploads/origins/7b5055ae-43b7-4df1-a1de-e24fb7e6ee28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca2d8f96fba15718e30a413662d62ea1 2x, https://si.imgix.net/c39282ee/uploads/origins/7b5055ae-43b7-4df1-a1de-e24fb7e6ee28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=884c3dae95520c1857e1adc6a71c6006 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c39282ee/uploads/origins/7b5055ae-43b7-4df1-a1de-e24fb7e6ee28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff5b8b43695d1fe64cc562df3fa87e2a", "srcset": "https://si.imgix.net/c39282ee/uploads/origins/7b5055ae-43b7-4df1-a1de-e24fb7e6ee28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff5b8b43695d1fe64cc562df3fa87e2a, https://si.imgix.net/c39282ee/uploads/origins/7b5055ae-43b7-4df1-a1de-e24fb7e6ee28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=52c241421c6a05b93531a1e01edb8605 2x, https://si.imgix.net/c39282ee/uploads/origins/7b5055ae-43b7-4df1-a1de-e24fb7e6ee28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0712a6cc3e3cc86ddef90a8e63953791 3x"}, "body": "書くかも程度ですがドM小説の挿絵に利用したいです\nキャラ名/雫(逃げ若)&小杉あかり\nシチュ：\n着衣超乳&着衣ボテ腹姿の二人にゴミを見るような冷めた目(顔の上部や目元まで影がかかる感じでハイライトなし希望)で嫌悪・侮蔑されながらペニスを特濃粘液まみれの長舌でモザイク不要レベルで亀頭以外ぐるぐる巻きにされた上、尿道責めされるドMホイホイシチュ\n着衣超乳や着衣ボテ腹が隠れそうなら搾精対象のM男の身体の直接描写はなしでペニスだけの描写で構いません。\n背景は粘液まみれの触手肉壁、あるいはダーク系にして頂けましたら幸いです\n\n二人とも手が簡単に沈む程柔らかく、片乳だけで両腕で抱え込めない、胴体&顔以上のサイズかつ服越しでもピンク色の透け勃起乳首がわかる着衣超乳&同サイズの特大着衣ボテ腹で、\n着衣ボテ腹内部は粘液まみれの大量の触手を孕んだようなイメージで、下腹部に怪しく光る淫紋の描写を希望します\nまたもし可能であれば二人とも全身が高粘度の粘液でどろどろで服が肌に貼りついており、二人の着衣越しの胸の谷間にどろどろの粘液が出来ている描写も可能であれば希望します\n更に可能なら超乳やボテ腹内部で孕んだ大量の粘液まみれの触手が蠢き外から見ても歪に変形している描写を希望します\n\nM男はペニスや尿道の快感に必死で耐えようとするも抵抗虚しく腰をガクガクさせ、鈴口に潜り込む触手の隙間から粘液と共に精子が溢れさせる情けない射精の様子をお願いします\n\n可能でしたらpsd形式で尿道責めしている長舌の様子がわかるような断面図(もしくは透過)差分と\n粘液まみれの長舌や触手が蠢く水音や射精音の有無(射精の有無も)や各キャラの瞳のハイライトと顔上部に掛かる影の有無差分とON/OFF出来る形で入れて頂ければ幸いです。\n\n更に口調等お任せで、「最低」「変態」「マゾ」「尿道イジメられて絶頂するなんて気持ち悪い」等(前述の台詞は参考程度でお願いします、またなるべく長い方が嬉しいです)と変態マゾ男を嫌悪感MAXで罵倒・侮蔑する台詞有無差分希望\nまたもし可能であれば自力で排出不可能な特濃媚薬唾液を尿道と精巣に流し込んだ挙句、精液の代わりに特濃唾液が尿道を抉じ開けて溢れ出てくる通常の数百倍の時間がかかるマゾ射精をプレゼントしてあげると蔑むようなセリフを希望します\n\n参考：\n\nhttps://drive.google.com/drive/folders/1V3pacDkCNpkEcgcKpKHh2NY0h1htVtrP?usp=sharing", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 8701, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "宍戸沙玖来", "screen_name": "sakura_ssd", "avatar_url": "https://pbs.twimg.com/profile_images/1613788733056380928/h2hzZ2Wq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/710203274436202496/1654655263/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 161}, {"id": 30163, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "瀬戸内：コミティア東P０９ｂ", "screen_name": "blackse", "avatar_url": "https://pbs.twimg.com/profile_images/680573686756192256/k7RaFYVj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/77520730/1357724105/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 177}, {"id": 605197, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "穴見呂 夢恵・Skeb受付中", "screen_name": "mue", "avatar_url": "https://pbs.twimg.com/profile_images/1859077926597386240/cQUM46E9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3160493905/1613386030/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": 