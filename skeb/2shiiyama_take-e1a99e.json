ress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f417157a0637bbea23f74a28aade7bb", "srcset": "https://si.imgix.net/eb0c9adf/uploads/origins/813e5f42-3b2f-4e57-9e08-1c122bfe0cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f417157a0637bbea23f74a28aade7bb, https://si.imgix.net/eb0c9adf/uploads/origins/813e5f42-3b2f-4e57-9e08-1c122bfe0cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c8a71ae8911bc56a592091d83d3312a 2x, https://si.imgix.net/eb0c9adf/uploads/origins/813e5f42-3b2f-4e57-9e08-1c122bfe0cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6c94a77f4f2ca06920c838aea68e17af 3x"}, "body": "魔法カード《洗脳ーブレインコントロール》と《巨大化》で感度3000倍超乳オナペット化変態洗脳され、淫語連発オナサポバイブ咥え込みガニ股腰ヘコデカパイ揺らしで絶頂失神する遊戯王のRAI-MEIをリクエストします。\n\n洗脳+膨乳シーン→バイブ挿入軽イキ→全力腰ヘコ乳揺らし+オナニー促進淫語連発絶叫→白目剥きアへ顔アクメ\n…といった4シーンの差分をお願いします。\n\nRAI-MEI単体の股下までを竿役の一人称視点で正面寄りから見た姿を写して欲しいです。\n\n服装はカードのイラストと同じ物をベースに1枚目のみ完全着衣、2枚目以降は股間と胸部先端がハート型に切り取られ、バイブ挿入及びパフィーニップル気味で大きめサイズの乳首と乳輪が完全に露出している状態でお願いします。\n\n乳のサイズは元から爆乳レベルの物が、顔より大きく上半身が隠れて下腹部がギリギリ見えるような超乳クラスの大きさに変化させて下さい。\n\nまた、各シーンに合わせたRAI-MEIのセリフのテキストを付けて下さい。キャラクター像はお好きなように書いて頂ければ幸いです。\n\n細かい指示が多くて申し訳ありませんがどうかよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 226884, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "糊@skeb", "screen_name": "nori003", "avatar_url": "https://pbs.twimg.com/profile_images/1527287748951801856/fgNGWbgB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/67569567/1441761936/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "ba