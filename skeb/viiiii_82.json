ahb9MeR4EgS-XdC6E9glkr3ksaezXifM/view?usp=drivesdk", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@viiiii_82/works/97", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2480483, "client_id": 2997787, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e72a4ba/uploads/origins/b9e2bfb4-9558-4a00-875a-bd8d12480755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcc42b1240e87ef8c861f3ca8cb4797e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e72a4ba/uploads/origins/b9e2bfb4-9558-4a00-875a-bd8d12480755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10c34d1da7233ea9dc9235520f247d0b", "src_set": ""}, "body": "本文\n自分が作った「メガミデバイス　バスタードール　ナイト」のカスタム機のイラストをお願いします。\n\n【概要】\n・ポーズや構図はお任せします\n・もし余力があれば瞳のハイライトの有無等の差分があると助かります\n\n【使用用途】\n個人的な鑑賞\n\nぜひご検討宜しくお願い致します。\n\n\n資料URL　(Google Drive)\nhttps://drive.google.com/drive/folders/1sHTJaCgoat_CXtI2NmUuhyTBze5H8VvX", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1600674, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "こよせ", "screen_name": "koyose_", "avatar_url": "https://pbs.twimg.com/profile_images/1749789838902276096/4hTHdAoS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1380048358471999488/1710889462/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "skills": [{"genre": "art"}], "nc": 17}, {"id": 1685491, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぷち", "screen_name": "pucchi_dayo", "avatar_url": "https://pbs.twimg.com/profile_images/1501058981137371141/Pgc5RzTI.jpg", "header_