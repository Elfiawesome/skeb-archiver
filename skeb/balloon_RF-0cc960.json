3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a703b34110aa832cceaed8049a0cc37d", "srcset": "https://si.imgix.net/1a411b8d/uploads/origins/18c1b9e8-f193-4557-94c8-0d2e54a00f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a703b34110aa832cceaed8049a0cc37d, https://si.imgix.net/1a411b8d/uploads/origins/18c1b9e8-f193-4557-94c8-0d2e54a00f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=145b6f80fa8cb386fca666b9bff866ba 2x, https://si.imgix.net/1a411b8d/uploads/origins/18c1b9e8-f193-4557-94c8-0d2e54a00f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68c367766e75e048ff9b27ebea32a394 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a411b8d/uploads/origins/18c1b9e8-f193-4557-94c8-0d2e54a00f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bd00393831aea85971d0f591e0a54c0", "srcset": "https://si.imgix.net/1a411b8d/uploads/origins/18c1b9e8-f193-4557-94c8-0d2e54a00f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bd00393831aea85971d0f591e0a54c0, https://si.imgix.net/1a411b8d/uploads/origins/18c1b9e8-f193-4557-94c8-0d2e54a00f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a2ef4b87e45bc9e6b315e2cb2893814f 2x, https://si.imgix.net/1a411b8d/uploads/origins/18c1b9e8-f193-4557-94c8-0d2e54a00f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5ac0fd5c64a7c800958002e3b651f2e 3x"}, "body": "こんにちは、軽井係さん、お忙しいところすみません。私のオリジナルキャラクターに新しい衣装をデザインしていただけませんか？\n\n- 身長は166cmです。\n- 年齢は人間で17歳くらい。\n- 種族は人間とドラゴンのミックス。\n- 角は長いのと短いのがある。\n- 性格は風変わり、電波系、徹夜で研究しているため睡眠不足気味。\n- 宝石を集めるのが好きで（ドラゴンだから）、食いしん坊。\n\n設定はファンタジー要素のある現代で、キャラクターの第一印象で服装のスタイル（SFやファンタジーなど）を決めることができる。彼女の代表的な色は紫で、デザインのカラーパレットにはその色を残すことが望まれ、それ以外はあなたが決めてください。\nできれば、彼女のネクタイは新しいデザインでも残してほしい。\n\n用途個人的なコレクションと