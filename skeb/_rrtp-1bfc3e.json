aori_Hiiragi/status/1924460603005120566\n\n【構図・ポーズ・表情のご要望】\nポーズ・表情： リクルート先生にお任せいたします。私のデザインや雰囲気に合わせて、自由にお書きいただければ幸いです。\n\n構図： YouTubeのサムネイルやSNSの画像で扱いやすいよう、「上半身がすべて（頭の先から腰のあたりまで）綺麗に画面に収まっている構図」にしていただけますと大変助かります。\n\nファイル形式はpsdファイルで作成していただけるとありがたいです。\n 背景はおまかせします。\nサムネイルを作成する際に、人物を透過処理できるよう、PSDファイルで納品いただきたく思います。\n\n以上となります。\nリクエストが不慣れなため、乱筆乱文になってしまいました。\nよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_rrtp/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 483599, "client_id": 1306623, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a19c50f/uploads/origins/d1bf52f4-a1d0-4922-abf1-2ce88d4d6277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dab462a7d9745d47929a4dfbce611fd", "srcset": "https://si.imgix.net/7a19c50f/uploads/origins/d1bf52f4-a1d0-4922-abf1-2ce88d4d6277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dab462a7d9745d47929a4dfbce611fd, https://si.imgix.net/7a19c50f/uploads/origins/d1bf52f4-a1d0-4922-abf1-2ce88d4d6277?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c52c9246077fc088ca37adf12d8eb11 2x, https://si.imgix.net/7a19c50f/uploads/origins/d1bf52f4-a1d0-4922-abf1-2ce88d4d6277?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d78535ed63add121ae927846a5005748 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a19c50f/uploads/origins/d1bf52f4-a1d0-4922-abf1-2ce88d4d6277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=788ae1b53b1742b796ee169569506ccd", "srcset": "https://si.imgix.net/7a19c50f/uploads/origins/d1bf52f4-a1d0-4922-abf1-2ce88d4d6277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=788ae1b53b1742b796ee169569506ccd, https://si.imgix.net/7a19c50f/uplo