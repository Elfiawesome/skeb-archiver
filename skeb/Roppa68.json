iration_days": 10, "skills": [{"genre": "art"}], "nc": 160}, {"id": 2699504, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "【あごますく先輩】skeb募集！", "screen_name": "agomasu_sugoi", "avatar_url": "https://pbs.twimg.com/profile_images/1952533909230788608/lSxrl6vM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1607170221659557888/1757829964/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 49}]}, "price_history": {"art": [{"amount": 8000, "recorded_at": "2025-10-03T16:58:52.896126"}], "comic": [{"amount": 8000, "recorded_at": "2025-10-03T16:58:52.896126"}]}, "works": [{"path": "/@Roppa68/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3184579, "client_id": 2129333, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d541ae7/uploads/origins/d69223b7-7b3d-46ab-aa5e-933c85d73751?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3604b74870d2530afd588a0763ac805f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d541ae7/uploads/origins/d69223b7-7b3d-46ab-aa5e-933c85d73751?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08ba620e60c47c30cdff2c1fe75bdc7f", "src_set": ""}, "body": "Roppaさん、skebでははじめまして！是非私のミスキーでの代理キャラを描いてください！\n\n私の代理キャラは御剣中身ちゃん。キャラクターの設定は私のミスキーのページのヘッダーから、私のミスキーОＣプロフィールのリンクを参照してください。設定は１枚しかありませんが、リンクの一番下にノートされている子です。他の方に描いていただいたイラストのリンクもありますので、参考にしてくださると嬉しいです。\n\n構図やポーズ等はお任せ致しますが、お願いしたいことが２点ございます。\n①中身ちゃんの服はミリタリー調にアレンジして、銃を持たせてください。\n②ミスキーのマスコットキャラである、にゃんぷっぷーを左手に抱いたり、背景に散りばめたりして中身ちゃんと絡めてください。\n\nhttps://misskey.io/@miturugikensuke", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Roppa68/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3184579, "client_id": 475405, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb8b6afa/uploads/origins/b33a8c5c-0572-4910-8b95-873d6289cb84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=853ffa8fb2f45d99e28baead613cffc8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb8b6afa/uploads/origins/b33a8c5c-0572-4910-8b95-873d6289cb84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d42a2427f70d1636573aa0ba6e8ac166", "src_set": ""}, "body": "初めまして、RANDOと申します\nうちの子「鳥飼コーニュ」でコミック作成をお願いいたします\nキャラ・銃参考図：https://media.misskeyusercontent.jp/io/cf2fb666-cb86-4c9f-8174-c32230e6b23e\n\n銃・衣装は参考図通りでお願いします。(指輪有り)\n\nシーン\n・コーニュがシューティングレンジで銃(実銃)を撃つ\n・胸の谷間（下側）に挿した予備マガジンを取りだしリロード\n・穴だらけの的を確認、決めポーズを取ってドヤ顔。\n(ポーズ参考https://www.pixiv.net/artworks/130036675)\n\n納品物の利用\n・グッズ作成（非商用）\n・コミッション資料\n・SNSでの掲示、アイコン\n\n「こっちの方が良い」と思われる部分がありましたら変えて頂いても大丈夫です\nもし受けて頂けるのであればよろしくお願いいたします", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Roppa68/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3184579, "client_id": 341794, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/053f1fff/uploads/origins/ea54514c-d8d1-4012-900f-e6702eae3293?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26fddc03c611b597105f23ff5da18d43", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/053f1fff/uploads/origins/ea54514c-d8d1-4012-900f-e6702eae3293?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00dc824f65e0c3afdfaf5ae105e7236e", "src_set": ""}, "body": "NSFWがOKという事で、イラストをお願いいたします。\n\nキャラは東方プロジェクトの霧雨魔理沙で、立った状態で片手でスカートをめくり、片手で上着をめくって胸をあらわにしている姿をお願いします。\n\n足は肩幅くらいに広げつつ、パンツは太もも辺りまで下げていて陰毛が見えていて、\n表情は笑顔ですが赤面してるイメージです。\n全身を描く必要はなく、膝から上くらいを目安にして頂ければと思います。\n\nまた、帽子を被せて頂きたいのと、陰毛は黒を希望いたします。\n\n以上の内容でご検討をお願いいたします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Roppa68/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3184579, "client_id": 2891147, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aaa768ae/uploads/origins/f9b9142c-392a-4f28-a0ad-908e1698ad11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a950b624dd9103b755ef89644169d628", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aaa768ae/uploads/origins/f9b9142c-392a-4f28-a0ad-908e1698ad11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88c1fe7bd94e644a16287d6369602d88", "src_set": ""}, "body": "こんにちは、\n漫画のリクエストなのですが、荒野のコトブキ飛行隊のキリエカとチカがパラシュートで降下するところを見てみたいです。着地すると、パラシュートにすっぽり覆われてしまう。その後、二人はそんな状況に笑い合う。そして、彼女たちはパラシュートを毛布のように巻いて眠りにつく。\n\nパラシュートの参考文献：\nhttps://1drv.ms/f/s!AvsEDH0kEzsHgeVs8x2BfwZRj-xT2g?e=JWCd2k", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Roppa68/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3184579, "client_id": 1351280, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c3e67a3/uploads/origins/0bcdafbc-46c1-46e1-b359-00d33276a9a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0bc8b68bc474beae91d4d57f8db1959", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c3e67a3/uploads/origins/0bcdafbc-46c1-46e1-b359-00d33276a9