てなのでも気になることがあればお伝えくださると助かります。\nお値段はどのぐらいのものが良いか分からないので初期設定のままにしました。必要でしたら増やすことは全く問題ないです。\n\n描いて欲しいイラストは普段お世話になってますが、クトゥルフ神話TRPGシナリオの「ソープスクール｣のHO1の白神亮真をお願いしたいです。\n描いて欲しい構図は白神が窓際で煙草を吸ってる構図にして欲しいです。服はスーツでがっちり着ているのではなく少しゆったりして欲しくて上着のボタンなどは外している感じがいいです。\n\nhttps://drive.google.com/drive/folders/13_jP5l0j5YXRza4Y9ENwt3rowsu2YAEV?hl=ja", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@5_necoze/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2660080, "client_id": 2607548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7b82c61/uploads/origins/ee07ca2f-883a-4fce-9416-6c20ce688aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=612ff5d6d91c009ecec2935ab7eb0628", "srcset": "https://si.imgix.net/c7b82c61/uploads/origins/ee07ca2f-883a-4fce-9416-6c20ce688aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=612ff5d6d91c009ecec2935ab7eb0628, https://si.imgix.net/c7b82c61/uploads/origins/ee07ca2f-883a-4fce-9416-6c20ce688aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=082d719627f10c363252216e4f826254 2x, https://si.imgix.net/c7b82c61/uploads/origins/ee07ca2f-883a-4fce-9416-6c20ce688aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb5b30f009f63e59cbb8aad4a30818b5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c7b82c61/uploads/origins/ee07ca2f-883a-4fce-9416-6c20ce688aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d454b735921fe26bdead3d9fc80a28ab", "srcset": "https://si.imgix.net/c7b82c61/uploads/origins/ee07ca2f-883a-4fce-9416-6c20ce688aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d454b735921fe26bdead3d9fc80a28ab, https://si.imgix.net/c7b82c61/uploads/origins/ee