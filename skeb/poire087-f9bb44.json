b3686df2f453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=188c2a15d8c190c56b163832422fa903, https://si.imgix.net/682793e1/uploads/origins/1193d618-8cf6-4746-9167-b3686df2f453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc4d3171ab4712deaeb6cd3ef166fa43 2x, https://si.imgix.net/682793e1/uploads/origins/1193d618-8cf6-4746-9167-b3686df2f453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=effbd5f3828b5759df32ed783c09e067 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/682793e1/uploads/origins/1193d618-8cf6-4746-9167-b3686df2f453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de8f5b2f883d36b2f6c926db54a7e1a0", "srcset": "https://si.imgix.net/682793e1/uploads/origins/1193d618-8cf6-4746-9167-b3686df2f453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de8f5b2f883d36b2f6c926db54a7e1a0, https://si.imgix.net/682793e1/uploads/origins/1193d618-8cf6-4746-9167-b3686df2f453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=71375da01b31396e76308be055bf0d39 2x, https://si.imgix.net/682793e1/uploads/origins/1193d618-8cf6-4746-9167-b3686df2f453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ff224141bf1ef8bf14a4efe1a6a71813 3x"}, "body": "優梨花様\n\n初めまして、個人Vtuberの白河ノさくらと申します。\nSkebでたまたまイラストをお見かけし、構図やお顔や透明感ある塗りのイラストがとても素敵でしたので、わたしもご依頼させていただきたく思います…！\nぜひわたしの姿を描いていただきたいです！\n\n◎構図：優梨花様のイメージでおまかせしたいです。（サムネイル等に使用したいので、あまり見切れていないと助かります。）\n◎衣装：実装している衣装（神巫女衣装、制服衣装、袴衣装）のいずれかでお願いします。\n◎形式：背景等が透過可能なレイヤー分けPSDファイル等\n◎用途：今後の活動（主に収益化済Youtubeチャンネルのサムネイルやツイート、グッズ、動画…等）に使用したいです！※禁止の用途等あれば、別レイヤーに記載していただけると助かります。\n\n☆私の姿詳細\n・ゆるーりはんなりまったりな九尾でかみさまで、名を白河ノさくらと申します。\n・髪色：白に近い、薄い桜色です。（毛先には少し赤みがあります。）\n・髪①：髪型はいくつかあるのでお任せします。（資料参照）\n・髪②：髪に桜の花がいくつか付いています。\n・顔①：右目（黄金色の瞳）の斜め下に泣きぼくろがあります。\n・顔②：左目（紅色の瞳）に被さるように赤い紋様が入っています。\n・顔③：両目尻に紅（舞妓さんとかがよくやってるやつ）があります。\n・顔④：上まつ毛は白めです。\n・口元：にゃんこ口ω\n・体格：「グラブル」のナルメアのようなイメージです。\n・装飾：尻尾も描いていただきたいです！（可能であれば尻尾はレイヤー分けして非表示可だと大変助かります…！）\n・雰囲気：今回表情指定は特にありませんが、ぽやっとした表情をしていることが多いです。もし可能でしたら表情差分などがあるととても嬉しいです！\n・性格：落ち着いていてまったり、飄々としています。\n\n※参考Twitter：https://twitter.com/sacura0\n※参考Youtubeチャンネル：https://www.youtube.com/c/sacura0610\n\n不明瞭でしたらすみません。\n可能でしたら、どうぞよろしくお願いいたします…！\n\n白河ノさくら🌸\n\nhttps://drive.google.com/drive/u/2/folders/15PD00ThrE4qlBywngk7HW7og8Je7LSgM", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@poire087/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3397479, "client_id": 1385946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42d33251/uploads/origins/d39c65fd-2743-407e-b5bb-b5dbb0c5339d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b4228569ff76d6b1d0601075a226278", "srcset": "https://si.imgix.net/42d33251/uploads/origins/d39c65fd-2743-407e-b5bb-b5dbb0c5339d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b4228569ff76d6b1d0601075a226278, https://si.imgix.net/42d33251/uploads/origins/d39c65fd-2743-407e-b5bb-b5dbb0c5339d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39595915b844df7dddcbbdfbe5382c1c 2x, https://si.imgix.net/42d33251/uploads/origins/d39c65fd-2743-407e-b5bb-b5dbb0c5339d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=665bc285379249fee6261301b3ca13e5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42d33251/uploads/origins/d39c65fd-2743-407e-b5bb-b5dbb0c5339d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e4a670b793f984a687e06d190ea83d1", "srcset": "https://si.imgix.net/42d33251/uploads/origins/d39c65fd-2743-407e-b5bb-b5dbb0c5339d?bg=%23fff&auto=format%2Ccompre