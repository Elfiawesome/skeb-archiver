utube収益化済)上の動画やサムネイル、X等SNSでの使用を許可していただきたいです。\nまた、納品時、人物のみ透過可能なPSD形式で作成いただけると助かります。\nなお、自分がXに掲載する際は「転載禁止」の記載を追記するようにします。\n\n何卒ご検討のほどよろしくお願い致します。\n\n＊参考＊\n三面図(Xポスト)\nhttps://twitter.com/natsume_mei/status/1746180504192422299\n\n新衣装お披露目配信(Youtube)\nhttps://www.youtube.com/watch?v=1eD3vKhk7DM", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mmmwawa_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2860550, "client_id": 2699964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b8e13ea/uploads/origins/37b0a962-c562-4eaa-95f3-bb7464c2e068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70c8437c6391881ad9f21c04fa38ac55", "srcset": "https://si.imgix.net/1b8e13ea/uploads/origins/37b0a962-c562-4eaa-95f3-bb7464c2e068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70c8437c6391881ad9f21c04fa38ac55, https://si.imgix.net/1b8e13ea/uploads/origins/37b0a962-c562-4eaa-95f3-bb7464c2e068?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f56cf0dc357ed3db5d7086f79b432561 2x, https://si.imgix.net/1b8e13ea/uploads/origins/37b0a962-c562-4eaa-95f3-bb7464c2e068?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c6c268bb26899070d0cbca7ba41c40b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b8e13ea/uploads/origins/37b0a962-c562-4eaa-95f3-bb7464c2e068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db18884e131cce64e5cd593d56a2e159", "srcset": "https://si.imgix.net/1b8e13ea/uploads/origins/37b0a962-c562-4eaa-95f3-bb7464c2e068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db18884e131cce64e5cd593d56a2e159, https://si.imgix.net/1b8e13ea/uploads/origins/37b0a962-c562-4eaa-95f3-bb7464c2e068?bg=%23fff&auto=format%2