ff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b866259ece40776de4dd514a043e8942 2x, https://si.imgix.net/7d7e6512/uploads/origins/3f6791aa-5d67-469f-9a5a-f92b11132613?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7fa19e63c39190398012267b81fc7b0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d7e6512/uploads/origins/3f6791aa-5d67-469f-9a5a-f92b11132613?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c855e32c7af12d3f7444f7824442b7df", "srcset": "https://si.imgix.net/7d7e6512/uploads/origins/3f6791aa-5d67-469f-9a5a-f92b11132613?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c855e32c7af12d3f7444f7824442b7df, https://si.imgix.net/7d7e6512/uploads/origins/3f6791aa-5d67-469f-9a5a-f92b11132613?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0dc046ba9a0c55cb4114a26fdd538b49 2x, https://si.imgix.net/7d7e6512/uploads/origins/3f6791aa-5d67-469f-9a5a-f92b11132613?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bc78baf523fcd7d54c74a337e23ef6e1 3x"}, "body": "肉巻様\nはじめまして！Vtuberの桜葉ねむと申します。\nとてもかわいいイラストを拝見し、ぜひ描いていただきたいと思いリクエストさせていただきました。\n\nポーズ、構図等お任せさせてください！\n背景透過の差分のみ頂けますとたいへん嬉しく思います。\n\n使用用途はX等SNS、配信サムネイルです。\n\nよろしくお願い致します！\n\nhttps://drive.google.com/file/d/1ijQhzNe0Wa_tf-Rv4i47fykkVPeEZ-15/view?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nikumakirichan/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3890288, "client_id": 2636255, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c465d5b/uploads/origins/876a8f42-17de-4838-8eef-37ff509555b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ac1605fac03afcdb519875d8bf3090c"