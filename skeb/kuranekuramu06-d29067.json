杖兼ハンマーです。\n装飾などはお任せします。具体的な形が決まっていないので、是非ともデザインしていただきたいです。\n\nもし武器を描いて頂けるなら、左右どちらかの肩に担いで両手で保持させて下さい。\n\nフレーバーテキストとしてキャラクター設定ページも添付します。ご参考になれば幸いです。\nhttps://w.atwiki.jp/winglessnoko/pages/19.html\n\nhttps://bsky.app/profile/nocanardnoflanker.bsky.social/post/3la4cvnvecl2z", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuranekuramu06/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1370987, "client_id": 1567405, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ad8e6a0/uploads/origins/c257c1ef-39c4-48f0-aea4-d5572db3e5ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76a11d2ad32a4bacd66b4ffffc544745", "srcset": "https://si.imgix.net/9ad8e6a0/uploads/origins/c257c1ef-39c4-48f0-aea4-d5572db3e5ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76a11d2ad32a4bacd66b4ffffc544745, https://si.imgix.net/9ad8e6a0/uploads/origins/c257c1ef-39c4-48f0-aea4-d5572db3e5ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45561646db607a1f3f58a0e5752ce1e7 2x, https://si.imgix.net/9ad8e6a0/uploads/origins/c257c1ef-39c4-48f0-aea4-d5572db3e5ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74ad398d97435e4c40acdcc9d2162bb5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ad8e6a0/uploads/origins/c257c1ef-39c4-48f0-aea4-d5572db3e5ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4300b37c9ffaf96d946c5e57d4478fb", "srcset": "https://si.imgix.net/9ad8e6a0/uploads/origins/c257c1ef-39c4-48f0-aea4-d5572db3e5ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4300b37c9ffaf96d946c5e57d4478fb, https://si.imgix.net/9ad8e6a0/uploads/origins/c257c1ef-39c4-48f0-aea4-d5572db3e5ae?bg=%23fff&auto=format%2Ccompress&fm