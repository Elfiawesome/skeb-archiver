5.html\n\n水着に関してはあくまでもイメージなのでこれに近い感じで書いていただければ！\n\nポーズに関してはもし可能であれば水着のイメージのページの13目みたいな感じでお願いしたいです。\n\n長文失礼しました！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@odiya1101/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3300670, "client_id": 2519117, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66cf4e75/uploads/origins/7d968a5c-afdc-4a4d-a516-c9aff3b80de4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79034cb30b8e677f06086b87aa6e2ecd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66cf4e75/uploads/origins/7d968a5c-afdc-4a4d-a516-c9aff3b80de4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b344686fa49e10bf8583038f8da20492", "src_set": ""}, "body": "はじめまして！\n個人Vtuberの月陽まにです。\n新着クリエイター欄からお見掛けし是非描いていただきたくリクエスト差し上げます。\n描いていただきたいのはもちろん私、月陽まにです。\nポーズや構図、表情に指定ありません。\nシチュエーションなども自由なので衣装の変更などもお任せします。\n使用用途の関係上上半身の一部（耳や髪の毛の端）が枠外にはみ出ないように描いていただきたいです。\n素敵なイラスト楽しみにしております！\n\n【依頼内容】\n・A4サイズ　300dpi\n・月陽まにバストアップ\n【使用用途】\n・Xでの宣伝活動\n・Youtubeサムネイル（収益化済み）", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 64672, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "La lune(ラ・リューン)＠Illustrator_VGen&Skeb", "screen_name": "La_Lune_000", "avatar_url": "https://pbs.twimg.com/profile_images/1941297615502704640/VzxpQ9n4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/142155467/1747974718/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 49}, {"id": 1827121, "creator": true, "nsfw_acceptable": false, "a