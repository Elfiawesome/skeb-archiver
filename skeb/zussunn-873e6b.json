が口を開いて中を見せつけている様子もお願いします。\n\n可能でしたらpsd形式で射精描写と粘液まみれの触手責めの水音や射精音などの効果音、および二人の瞳のハイライトをそれぞれON/OFFできるような感じにして頂ければ幸いです。\n可能な範囲で構いませんので何卒よろしくお願い致します。\n\nキャラ、着衣ボテ腹、触手咥内参考：https://imgur.com/a/UscGzjz\n触手オナホ(内部構造見せつけ)参考：https://i.imgur.com/Vqv4m\n触手オナホ(ペニス丸呑み搾精)参考(４、５枚目参考)：https://www.pixiv.net/artworks/75924277\n添い寝コキ参考：https://www.pixiv.net/artworks/53793108\nhttps://www.pixiv.net/artworks/67690580\nhttps://www.pixiv.net/artworks/71540291", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@zussunn/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 236022, "client_id": 311397, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d8d1bc8/requests/138921_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaa5be8f709366c35d0b0921e9c8f331", "srcset": "https://si.imgix.net/3d8d1bc8/requests/138921_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaa5be8f709366c35d0b0921e9c8f331, https://si.imgix.net/3d8d1bc8/requests/138921_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=feb5aa2c59c92be966bac7612b93ec05 2x, https://si.imgix.net/3d8d1bc8/requests/138921_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a50ac2b919c3fe7dc49c7015363746c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d8d1bc8/requests/138921_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc4d5396b45d7fe72ad21107f180a87b", "srcset": "https://si.imgix.net/3d8d1bc8/requests/138921_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc4d5396b45d7fe72ad21107f180a87b, https://si.imgix.net/3d8d1bc8/requests/138921_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3a16290ab14d6295c848ba321c688b22 2x, 