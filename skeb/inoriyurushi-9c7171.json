&w=200&h=200&s=7c4d511f5f5a8033f66ba68fe7fa4a95, https://si.imgix.net/31906cda/uploads/origins/c5c1d7b0-3f40-4d38-88a6-ba451dd3d3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2f3b46456662a07b419c163a9b4be79 2x, https://si.imgix.net/31906cda/uploads/origins/c5c1d7b0-3f40-4d38-88a6-ba451dd3d3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2a13efe527087007da967700c62df05 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31906cda/uploads/origins/c5c1d7b0-3f40-4d38-88a6-ba451dd3d3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f6d036e9077fc5168da5d4bc496fd7c", "srcset": "https://si.imgix.net/31906cda/uploads/origins/c5c1d7b0-3f40-4d38-88a6-ba451dd3d3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f6d036e9077fc5168da5d4bc496fd7c, https://si.imgix.net/31906cda/uploads/origins/c5c1d7b0-3f40-4d38-88a6-ba451dd3d3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=321f74f2793766d5c7c8d02e8a0481b5 2x, https://si.imgix.net/31906cda/uploads/origins/c5c1d7b0-3f40-4d38-88a6-ba451dd3d3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2d14bf33aedab8cbed9b2ce5e2ebd87b 3x"}, "body": "はじめまして！\n恋々さんの作品がずっと大好きで、pixivで二次創作の漫画をまとめて読んで以来心に残っております。言葉とキャラクターの背景をすごく大事にされていることが伝わってきて、いつも胸がいっぱいになります！\nいつか是非skebを頼みたいと思っておりましたので、開いて下さり本当に嬉しいです！！\n\n今回依頼したいのは、TRPGシナリオ「MAGYY889」に使用した私とフォロワーのキャラクターが登場するコミックです。\n以下に詳細を記載します。\n┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈\n■青髪の方\n女性/27歳/154cm\nモチーフ：大天使ミカエル、エーデルワイス\n天使。何故か⬇️の人に撃たれても死なない。\n\n■赤髪の方\n男性/19歳/186cm\nモチーフ：ジャンヌダルク\n若いけどその道じゃ有名なヒットマン。悪いこと大体全部してきた。\n\n2人は色々あってイタリアのどこかで同居していて、兄妹のような相棒のような不思議な関係です。互いに欠けている部分はあるものの、上手いこと補ったり、普通に喧嘩したりしながらなんとか暮らしています。\n\n▼詳細設定はドライブに突っ込んであるのですが、CoCシナリオ「MAGYY889」のネタバレが含まれているので閲覧できない場合は依頼をキャンセルしていただけますと幸いです。\n\nその他、不明な点は捏造していただいて結構です。\n┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈\n漫画の内容は恋々様にお任せします！\n2人が登場し会話をする……というものを想定していますが、どちらかしか出ずとも、全く見知らぬ誰かが登場して会話するというものでも　何でも大丈夫です！\n\n長々と書いた割に任せ気味な依頼となり恐縮ですが、ご縁があればよろしくお願いいたします。\n今後とも恋々様の創作活動を心より応援しております！\n\nhttps://drive.google.com/drive/folders/1xkJ6UhXwxRy7X0SrTavdEizPKVnw8x0i", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inoriyurushi/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/33fe157f/uploads/origins/8202f3da-ea2b-412a-860a-03da802933e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4203ff996a377e815bc910fe274f025", "srcset": "https://si.imgix.net/33fe157f/uploads/origins/8202f3da-ea2b-412a-860a-03da802933e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4203ff996a377e815bc910fe274f025, https://si.imgix.net/33fe157f/uploads/origins/8202f3da-ea2b-412a-860a-03da802933e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1c7b73c26ba189ab5dfcd971d86a2d2 2x, https://si.imgix.net/33fe157f/uploads/origins/8202f3da-ea2b-412a-860a-03da802933e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed588f48f427f27bdbd9049dde351f44 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 1619388, "client_id": 3208649, "nc": 145}, {"path": "/@inoriyurushi/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b0af5a19/uploads/origins/9e647e7b-decd-4313-817b-495c9851899d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=3