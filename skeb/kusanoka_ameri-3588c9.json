観は、Wikipediaの「https://ja.m.wikipedia.org/wiki/%E3%82%AF%E3%83%88%E3%82%A5%E3%83%AB%E3%83%95%E7%A5%9E%E8%A9%B1」\nやYou Tubeで検索すると概要が分かると思います。\n飴梨様の精神的に受け付けられない歌ではあるかもしれませんが、何卒よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@kusanoka_ameri/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": true, "creator_id": 1127658, "client_id": 507423, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/d8152a6c-0268-4451-a4f4-5faf584927b4?response-content-disposition=inline&Expires=1781177110&Signature=XP~LJC9dH7gw-~Fz8OsfnlDIfVddB8Ly1STii4Mdx2dFRMMY4VoG~0cFLvpAkVX863zH4nfGFBJTuUz1JE0xxWBHJic6HX2-mKA5ksDcx6OKNxlbKHo~o06aJSm~3tJ5TVVvG2x3p2f~--oPncCjVe2cF8AYFaxhaLFK1v~epOg5OQtLzUFov7nVoWgQsutXkDh4KV9hDZyIzVLP8Dyh1gxHtBqp4N1OUl2Jezr~zcKqlNBF-kI4FYizEIXODjwEHRK~ucEqpbF8Ht7LxVKuzcvlTS4KE4GlEH~Jrn0aRerGvAH6e6KPbRBfq30YCNWJx1cofWdYogqGy8W3xKTPVA__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2052728825746980864%2FiFjW10PY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92842a938e40926ef9a573dd376a73ee", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2052728825746980864%2FiFjW10PY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92842a938e40926ef9a573dd376a73ee, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2052728825746980864%2FiFjW10PY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36229b4eb40532aecc7d4a2c39adda63 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2052728825746980864%2FiFjW10PY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4db2a993133eb4c9d7e30108a77c6b3 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/93a1fae2-1af0-4f9e-93cd-df129f4