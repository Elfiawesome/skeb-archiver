\n\nこのたび、私のオリジナルキャラクター（OC）のイラスト制作をお願いしたく存じます。\n\nご依頼内容：\n・女性キャラクター1名＋手に止まっている鷹（イヌワシ）1羽\n・キャラクターは、リンク先の姉妹の中からお好みの一人をお選びください。\n・［03］から始まる番号の設定をご参照ください。\n・世界観は半架空の北方大陸（16～17世紀頃のチベットを参考イメージ）です。\n・衣装について、ご不明点や描きにくい部分がありましたら、世界観に合わせてご自由に変更・再構成していただいて構いません。\n\nもしご依頼内容がご意向に沿わない場合は、遠慮なくお断りいただくか、料金のご調整をご提案ください。\n\n以上、ご検討のほど何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1thflGaEfZabk8i3ktwXfQqW8XuxA0MzM", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@RgogolpPy4/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3638287, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3470743e/uploads/origins/d40f9ce7-eb82-4288-a600-f313b882ab6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fc8a6a698c72ac1b513a168c1f83237", "srcset": "https://si.imgix.net/3470743e/uploads/origins/d40f9ce7-eb82-4288-a600-f313b882ab6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fc8a6a698c72ac1b513a168c1f83237, https://si.imgix.net/3470743e/uploads/origins/d40f9ce7-eb82-4288-a600-f313b882ab6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95e38a3a971038feb872339dcd8f2a11 2x, https://si.imgix.net/3470743e/uploads/origins/d40f9ce7-eb82-4288-a600-f313b882ab6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5863a53512e6dcd1bc0a1e27dc311f3d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3470743e/uploads/origins/d40f9ce7-eb82-4288-a600-f313b882ab6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fb7e30874f60e8636b4e64e02a8f67b", "srcset": "https://si.imgix.net/3470743e/uploads/origins/d40f9ce7-eb82-4288-a600-f313b882ab6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fb7e30874f60e8636b4e64e02a8f67b, https://s