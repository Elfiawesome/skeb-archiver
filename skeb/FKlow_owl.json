 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FKlow_owl/works/18", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/775ff40a/uploads/origins/bfd45445-3088-496d-984e-fe454bb9a278?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7ef82c4992154ff443cfbeda0a2c76a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 157178, "client_id": 2562433, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@FKlow_owl/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 157178, "client_id": 237441, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c064d2e2/uploads/origins/fee3ce33-0980-4f77-a47d-7be87db421d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee184ac2b6728eb3ed6b91930687a011", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c064d2e2/uploads/origins/fee3ce33-0980-4f77-a47d-7be87db421d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4b1a13801d5bd8075eb6897fc8a141d", "src_set": ""}, "body": "こんにちは！\n\n私のぽっちゃりしたティフロシオンのキャラクターを描いてください。彼女は何気なくシェイミを飲み込んでいます。シェイミは気持ちよさそうに丸呑みされています。シェイミは眠っています。唾液をたくさん入れてください。普段は目を閉じています。\nありがとう。\n\nhttps://imgur.com/a/f87yNP7", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FKlow_owl/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 157178, "client_id": 776168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65941395/uploads/origins/833a1108-3a3d-404f-87d1-a41d9b533a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ae64663b9ad7521fe80217af7a8bb42", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65941395/uploads/origins/833a1108-3a3d-404f-87d1-a41d9b533a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f0213f51e15d4f0357a61d3e62de793", "src_set": ""}, "body": "ヲゥルさんこんにちは！\nはじめまして、Replikagamiと申します！\nうちの子のR18禁絵を依頼したいです！\n\nキャラ：Gnim=Repli=Kagami(カガミ)　受けです\nオスの狐獣人お兄さん。青と白が特徴的な体毛。眼鏡と首輪をつけている。\n額の紋章、毛先や指先は感情によって色が変化する。通常時は青、えっちな気分はピンクに。\n＊＊今回はR18なので、ピンク／桃色です！\n性器の形は犬ケモちん（KTQ有り）と人間ちんどっちでもOkです。\nhttps://drive.google.com/drive/folders/1olNb3-xDpU5jbmlw0dgwQn_e8IsYTrV2?usp=sharing\n\n＊＊重要な額の紋章：\nhttps://drive.google.com/file/d/1xdm8Fs8PVLbWAPPSYa25OJ0C8w_NjTvX/view?usp=drive_link\n\n内容：\nー全裸のKagamiが、自分の身体／身長よりも大きくで太いのモブドラゴンキャラの巨大ドラゴンちんにメロメロにしちゃって、淫乱な物欲しいそうな表情している。そのドラゴンちんを自分の身体全身で抱いて、強め（？）でペロペロしながら、全身で擦り付けってマッサージしてあげる（全身を使ってオナニーしてあげる）。Kagamiが自分のちんで　擦り付けっている。\nードラゴンちんがビンビンでびっくびく、全体が淫液まみれてぬるぬる、先端も先走り熱々精液（蒸気（？）も出すくらいのかんじ）漏れてぬるぬるどろどろ、Kagamiの身体にべっとべと。\n\n（差分）\nー巨大ドラゴンちんが大量射精する　と　そのあとKagami全身熱々精液まみれてどろどろの射精後の差分が希望です！（Kagamiも一緒に射精した）\nー精液有り無しの差分が有れは超嬉しいです！\n\nー背景とモブドラゴンキャラのデザインは（モブキャラなので、全身映らないの気がするけど）おまかせと思います！\n\nよろしくお願いします！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FKlow_owl/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/04779097/uploads/origins/27f7f620-4253-4787-9544-579191222022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3b5a6568807c79fe847991fb7c3960b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 157178, "client_id": 1106834, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "ns