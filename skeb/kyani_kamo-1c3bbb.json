ャラクターデザインです。\nhttps://imgur.com/vBOdw0f\n\nポーズ参考： https://imgur.com/a/UPRbnSx", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kyani_kamo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2148655, "client_id": 1694143, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da24e4ea/uploads/origins/e9437035-9e58-4a54-bf92-fef6f2274299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eefec328919ab3835c046e41ecd31919", "srcset": "https://si.imgix.net/da24e4ea/uploads/origins/e9437035-9e58-4a54-bf92-fef6f2274299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eefec328919ab3835c046e41ecd31919, https://si.imgix.net/da24e4ea/uploads/origins/e9437035-9e58-4a54-bf92-fef6f2274299?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c32dc108514affcbad9f57ad14c8661b 2x, https://si.imgix.net/da24e4ea/uploads/origins/e9437035-9e58-4a54-bf92-fef6f2274299?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc8744fe388ac0b010db64b6bc4828b5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da24e4ea/uploads/origins/e9437035-9e58-4a54-bf92-fef6f2274299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ef2a7938ef711f5f4582da0778265c6", "srcset": "https://si.imgix.net/da24e4ea/uploads/origins/e9437035-9e58-4a54-bf92-fef6f2274299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ef2a7938ef711f5f4582da0778265c6, https://si.imgix.net/da24e4ea/uploads/origins/e9437035-9e58-4a54-bf92-fef6f2274299?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=716c8407a8a15699ef8e875141d58759 2x, https://si.imgix.net/da24e4ea/uploads/origins/e9437035-9e58-4a54-bf92-fef6f2274299?bg=%23fff&auto=format%2Cc