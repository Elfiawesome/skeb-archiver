れた刑務所にいた。その後、学校に通い始め、他の人々と交流するようになったが、彼らは彼女を理解するのに苦労していた。\n\nやがて成長した彼女は、自分を救ってくれた人に雇われたメイドとなり、その力でトラブルメーカーを撃退するなど、主人の日々の仕事を手伝っている。彼女の第一印象は、美人で礼儀正しい。\n\nテーマ氷、研究所、結晶\n\n彼女の【ファンタジー・オルタネイト・ユニバース】バージョンも載せました。\n彼女はクラゲの人魚です。胸に石を埋め込んでいて、強い氷の力を使えるようになり、人間にも変身できる。人間として海賊の一味に加わっている。\n\nリクエスト\n今回も描きたいキャラクターを選んでください！ポーズなどはお任せします。\n衣装の解釈も自由です。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1wHToZNcIl5aJVmGjlZcryq65bZLJ2L6c?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jq4_3/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3524742, "client_id": 2330445, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/262c6f2f/uploads/origins/de125240-3ec2-4a84-8621-e8af7f9188de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cac42f9252371e804daad65ebea5b21", "srcset": "https://si.imgix.net/262c6f2f/uploads/origins/de125240-3ec2-4a84-8621-e8af7f9188de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cac42f9252371e804daad65ebea5b21, https://si.imgix.net/262c6f2f/uploads/origins/de125240-3ec2-4a84-8621-e8af7f9188de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=913b7978081709d711d4f6274cfeae1e 2x, https://si.imgix.net/262c6f2f/uploads/origins/de125240-3ec2-4a84-8621-e8af7f9188de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1961afa727399443baca7ccc339d1107 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/262c6f2f/uploads/origins/de125240-3ec2-4a84-8621-e8af7f9188de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b37833296ab38baf30561728380dec9", "srcset": "https://si.imgix.net/262c6f2f/uploads/origins/de125240-3ec2-4a84-8621-e8af7f9188de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=