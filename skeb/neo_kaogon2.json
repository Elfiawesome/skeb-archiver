-1f1a-4cab-8398-1831625b7df8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aee6f80d3131caaa69a10ef7aaaf6633 3x"}, "body": "はじめまして。\n依頼をお願いしたく連絡差し上げました。\n\nVTuberの「リリィ＝クロフォード」さんのイラストをお願いします。\nhttps://twitter.com/Lily__Crawford/status/1491382224104861696\n\nシチュエーション等はおまかせします。\n\nご検討いただけますと幸いです。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neo_kaogon2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2729460, "client_id": 2829683, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c210c15/uploads/origins/2e322196-2f34-40b5-a3da-5246297eaf1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ac3a8725edbbb762b86a8a9baeee692", "srcset": "https://si.imgix.net/0c210c15/uploads/origins/2e322196-2f34-40b5-a3da-5246297eaf1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ac3a8725edbbb762b86a8a9baeee692, https://si.imgix.net/0c210c15/uploads/origins/2e322196-2f34-40b5-a3da-5246297eaf1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4c2253cabb8e8b5736ae0386555f7d8 2x, https://si.imgix.net/0c210c15/uploads/origins/2e322196-2f34-40b5-a3da-5246297eaf1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b5ccabfbf9a0bc291f5ecf16f2af916 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c210c15/uploads/origins/2e322196-2f34-40b5-a3da-5246297eaf1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0d3f943cdb7b43d63f1d1ba271029e6", "srcset": "https://si.imgix.net/0c210c15/uploads/origins/2e322196-2f34-40b5-a3da-5246297eaf1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0d3f943cdb7b43d63f1d1ba271029e6, https://si.imgix.net/0c210c15/uploads/origins/2e322196-2f34-40b5-a3da-5246297eaf1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3286d59021afd940d23102d7d9b51865 2x, https://si.imgix.net/0c210c15/uploads/origins/2e322196-2f34-40b5-a3da-5246297eaf1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1a15641d7ffa64dc81ef966eb1bf176c 3x"}, "body": "お世話になっております\n。\n以下仕様です（顔はこれでもかって言うくらいかわいく）\n・制服女子（リボンは色を水色に変更しておおきく。「パンチラ部分を強調」して、ブレザーは今までに無いようなかわいいデザインを希望します。体育座り）\n・丸眼鏡（はっきりわかるように、下方向に少しずれるとなお可）\n・髪の毛の色（茶髪）\n・髪型（ツインテールで出来れば結び目に黄色リボンのアクセントが欲しいです）\n・スカートは青色でチェック柄で短め\n・靴はローファー\n・サイズは横1920*縦1080ピクセルでお願いします。納品ファイル形式は、psd、jpgでお願いします。\n\nご検討の程、よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neo_kaogon2/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2729460, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19825447/uploads/origins/356b65fc-77b5-4141-8f8c-ebe684df0079?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15936cf7c2d06bdc348dfe781be4441e", "srcset": "https://si.imgix.net/19825447/uploads/origins/356b65fc-77b5-4141-8f8c-ebe684df0079?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15936cf7c2d06bdc348dfe781be4441e, https://si.imgix.net/19825447/uploads/origins/356b65fc-77b5-4141-8f8c-ebe684df0079?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=031aca111f0b4103e08c28a388a6d028 2x, https://si.imgix.net/19825447/uploads/origins/356b65fc-77b5-4141-8f8c-ebe684df0079?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58e3933b21ef88b0bb83e6f335800815 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19825447/uploads/origins/356b65fc-77b5-4141-8f8c-ebe684df0079?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccdb3f4a6f2dbec83c1fbd03e3ab13e6", "srcset": "https://si.imgix.net/19825447/uploads/origins/356b65fc-77b5-4141-8f8c-ebe684df0079?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccdb3f4a6f2dbec83c1fbd03e3ab13e6, https://si.imgix.net/19825447/uploads/origins/356b65fc-77b5-4141-8f8c-ebe684df0079?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b311b511b3bc4ec444c0c8fa50b92e1d 2x, https://si.imgix.net/19825447/uploads/origins/356b65fc-77b5-4141-8f8c-ebe684df0079?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=22bad0a95b4457a60696607b2d463a31 3x"}, "body": "初めまして。pixivで見たマキマさんのイラスト(https://www.pixiv.net/artworks/103769195)がとても好きで、彼女のイラストをリクエストしたく参りました。\n\n描いていただきたいのは、牛柄ビキニを着たマキマさんのイラストです。\n\n1枚のイラストに、セリフ等の差分をつけて描いていただきたく思います。\n\n①普通に牛柄ビキニを着ているマキマさんと、「搾乳しなさい。これは命令です」というセリフ\n\n②ビキニのブラをずらして胸を出し、母乳がピューピュー出ているマキマさんと「一滴残らず飲みなさい。これも命令です」というセリフ\n\n(以下は可能でしたら)\n\n③  ②の差分から、ブラを取り除いたもの\n\n④それぞれセリフなしのイラスト\n\n\n相手の描写は必要ありません。\nマキマさんの胸は母乳がパンパンに詰まってるイメージで描いていただきたいです。\nまた、ビキニ越しでも乳首がわかるように陰影などで描写していただけると嬉しいです。\n表情は、過去イラストのような照れ笑いのような表情と、同じく汗も描いていただきたいです。\n全身を描く必要はありませんが、太ももあたりまでは描いていただけるとありがたいです。\nポーズやビキニのデザインなどはお任せします。\n母乳の量は多めでお願いします。\n\nお忙しいとは思いますが、ご検討のほどよろしくお願い申し上げます。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1125553, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "にんじん", "screen_name": "nin_11", "avatar_url": "https://pbs.twimg.com/profile_images/1670227534649360384/HZiAa-S4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1282955309305061378/1618574051/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 177}, {