ございませんが首から下は足も見えないぐらい隙間なく全身巻き付けて下さい）を描いて頂けるとうれしいです。\n又、できればアーボックは通常色と色違いをお願いします。\n又、さらに大丈夫ならアーボックの尻尾で首を巻き付けているパターンと巻き付けていないパターン(どちらかでしたら巻き付けていないパターン)をお願いします。\n\n時津風の表情ですが、大丈夫でしたら複数（無理なようでしたら①と④を優先でお願いします）又、できればどの表情もアーボックは通常色と色違いをお願いします。\n①締め付けられて涙目で苦しんでいる（目は閉じています）\n②苦しんでいるけど若干感じていて赤面になっている（目は閉じています）\n③苦しいけど若干気持ちよくて恥ずかしがっている（目は開けています）\n④嬉しくて締め付けられているのに笑っている（目は開けています）", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yunagiotu02/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1657644, "client_id": 103982, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dfe724a5/uploads/origins/ebeed1e6-9d35-4621-b5f7-09489d9cd515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21e5710e4c8eb804f31fdfebba601a8a", "srcset": "https://si.imgix.net/dfe724a5/uploads/origins/ebeed1e6-9d35-4621-b5f7-09489d9cd515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21e5710e4c8eb804f31fdfebba601a8a, https://si.imgix.net/dfe724a5/uploads/origins/ebeed1e6-9d35-4621-b5f7-09489d9cd515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa0c7efaf1ed8709832c5f553ed79810 2x, https://si.imgix.net/dfe724a5/uploads/origins/ebeed1e6-9d35-4621-b5f7-09489d9cd515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=180e290b46c7acf859cc778d1930c164 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dfe724a5/uploads/origins/ebeed1e6-9d35-4621-b5f7-09489d9cd515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=695f5cf1124a0ad653d117201d3a457e", "srcset": "https://si.imgix.net/dfe724a5/uploads/origins/ebeed1e6-9d35-4621-b5f7-09489d9cd515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=695f5cf1124a0ad653d117201d3a457e, https://si.imgix.net/dfe724