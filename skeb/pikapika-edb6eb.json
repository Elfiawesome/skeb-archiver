にかあれば\nレイヤー分けや別ファイルにて同梱いただけますとすごい嬉しいですTT\n\n┈┈┈┈┈┈┈┈┈┈\n\n長々と失礼しました…！\n楽しくかいていただけますと嬉しいです❣️\n不備等ありましたらご指定の上再送をお願いいたします！\n\nご縁ありましたらよろしくお願いいたします🙇\n\nhttps://drive.google.com/drive/folders/1vADFIyTDt2XIbloO8M6eFrVLcQjnDrUQ?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pikapika/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2403331, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c516581f/uploads/origins/a6069c5c-f59f-4c12-9955-dd7c5778deb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1326cf7c5ee2f3b986ae33c2637cfe90", "srcset": "https://si.imgix.net/c516581f/uploads/origins/a6069c5c-f59f-4c12-9955-dd7c5778deb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1326cf7c5ee2f3b986ae33c2637cfe90, https://si.imgix.net/c516581f/uploads/origins/a6069c5c-f59f-4c12-9955-dd7c5778deb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a171e87d574c84ecbfbcd0937f5a3c6 2x, https://si.imgix.net/c516581f/uploads/origins/a6069c5c-f59f-4c12-9955-dd7c5778deb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7bd699c15ecd8bd5c063bad787ec117 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c516581f/uploads/origins/a6069c5c-f59f-4c12-9955-dd7c5778deb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4879c5c393141f0b842361b417dd86c0", "srcset": "https://si.imgix.net/c516581f/uploads/origins/a6069c5c-f59f-4c12-9955-dd7c5778deb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4879c5c393141f0b842361b417dd86c0, https://si.imgix.net/c516581f/uploads/origins/a6069c5c-f59f-4c12-9955-dd7c5778deb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3a51108dbb55cf92