0&s=dd6a4c923e2f5418ac91e22cb976fa8c, https://si.imgix.net/f04b9077/uploads/origins/9a5adc3d-8625-43c2-ae52-7e914ce661d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3701c68ca1a1112c15e06229538de43 2x, https://si.imgix.net/f04b9077/uploads/origins/9a5adc3d-8625-43c2-ae52-7e914ce661d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8818ae6447091fe8e807ea6d9fc5caa3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f04b9077/uploads/origins/9a5adc3d-8625-43c2-ae52-7e914ce661d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62df124888a80d98a674709c81a8a4b7", "srcset": "https://si.imgix.net/f04b9077/uploads/origins/9a5adc3d-8625-43c2-ae52-7e914ce661d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62df124888a80d98a674709c81a8a4b7, https://si.imgix.net/f04b9077/uploads/origins/9a5adc3d-8625-43c2-ae52-7e914ce661d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aada369e034cda8a23c9db25e2cc274d 2x, https://si.imgix.net/f04b9077/uploads/origins/9a5adc3d-8625-43c2-ae52-7e914ce661d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cce1f9a43c443aa6797ef6d47291e15c 3x"}, "body": "前回は素晴らしい作品をありがとうございます。1日一回は観る様になりました。\n連続となる上、今回は金額もあまり出せませんが少々申し訳ないのですが依頼させていただきます。\n依頼内容は\n前回お題箱で描いていただいたぽっちゃり熟女僧侶が行為を続けるうちに快感を覚え、更に太ましくデブの域にまで入る程になり、毎晩宿屋で勇者に全身舐めたがられる様になる　です。\nイメージとしては\n\n夜、冒険が終わり宿屋に泊まる2人、僧侶の方から今日も舐めるんでしょう？と腕を上げムレムレの腋を開けてくれる\n\nおもむろに腋にしゃぶりつき、満足するまで堪能した後僧侶の足元にまわり靴を脱がせようとする\n\n太った影響でキツキツで脱がしにくそうにしながらもブーツを脱がせると大きくムレムレな足裏が現れる\n\nすると勇者は僧侶の足に抱きつき(前回と同じ様な体制)両足に顔を埋め匂いを嗅ぎ尽くしたり、そのムレムレで汗をかいた足裏を舐め回したりする、僧侶はくすぐったがりながらもその様子にSっぽい気持ちよさを感じつつも見守る。\n\nそうして、受け入れてくれたと勘違いした勇者は調子に乗ってその両足をこちょこちょとくすぐりはじめ、僧侶も初めてこんな事をされて笑いわされてしまう(前回と同じ流れで申し訳ありません)\n\nその後僧侶はたっぷりくすぐって満足して油断した勇者を後ろから蹴り倒すと重くなった体重とくすぐられて汗をかき更に臭う大きな足裏で顔を踏みつけ、足裏を口に突っ込むお仕置きをする\n\nというイメージです。可能であれば脱がせたブーツもどこかしらに描いていただければ嬉しいです。\n勿論大まかな流れ以外は好きに調整していただいて構いませんし、勇者、背景につきましても重要視しないので端折れる所はバンバン端折っちゃってください。\n今回はお金があまり準備出来ませんでしたがお受けいただけたら幸いです。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 178523, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "アーク", "screen_name": "domperinet", "avatar_url": "https://pbs.twimg.com/profile_images/1489120622122659841/y2wXz6ce.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2316995563/1628247891/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 40, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 260785, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "つむじぃ■夏コミ1日目→東1【ク-46b】2日目→東7【G-35b】■", "screen_name": "tsumugie", "avatar_url": "https://pbs.twimg.com/profile_images/2036061608653594624/xbp1tVFl.jpg", "header_url": "https://pbs.twimg.com/profile_banners/51674273/1782908886/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 1142924, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "朽", "screen_name": "1999_misc", "avatar_url": "https://pbs.twimg.com/profile_images/1517800162546315270/B-q3ILtF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/881697728643776513/1735052414/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days":