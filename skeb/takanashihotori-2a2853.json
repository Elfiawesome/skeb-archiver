ate": false, "genre": "art", "tipped": false, "creator_id": 343984, "client_id": 3317405, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe42181a/uploads/origins/8367ade1-1fc8-44c4-968f-0cf41257c9f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60844e7885814f5c5bf3ec6aa2a79ee6", "srcset": "https://si.imgix.net/fe42181a/uploads/origins/8367ade1-1fc8-44c4-968f-0cf41257c9f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60844e7885814f5c5bf3ec6aa2a79ee6, https://si.imgix.net/fe42181a/uploads/origins/8367ade1-1fc8-44c4-968f-0cf41257c9f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=768ceb0861e452e4d85fd02b59de5441 2x, https://si.imgix.net/fe42181a/uploads/origins/8367ade1-1fc8-44c4-968f-0cf41257c9f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8c95d751dbe6684ae70723fddafd4f5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe42181a/uploads/origins/8367ade1-1fc8-44c4-968f-0cf41257c9f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59aede9a2d66c7dc7ab16b77c6063495", "srcset": "https://si.imgix.net/fe42181a/uploads/origins/8367ade1-1fc8-44c4-968f-0cf41257c9f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59aede9a2d66c7dc7ab16b77c6063495, https://si.imgix.net/fe42181a/uploads/origins/8367ade1-1fc8-44c4-968f-0cf41257c9f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c5accdaa7970c961cd135b58d6f49670 2x, https://si.imgix.net/fe42181a/uploads/origins/8367ade1-1fc8-44c4-968f-0cf41257c9f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ca788149c7dc37ceea99bc86d888e97 3x"}, "body": "初めまして、個人Vtuberの有栖乃トウと申します。\n\n小鳥遊ほとり様の描かれる作品を拝見し、その1つ1つに心惹かれました。\nどれを取っても素敵なのですが、特に背景付き1枚絵の目を惹く光の表現が大好きです…。\nご縁がありましたら、ぜひ私のイラストを描いて頂けますと幸甚です。\n\n\n●ご許可頂きたい使用用途予定\n・各種SNSのアイコン、ヘッダー、宣伝活動への使用\n・各種配信プラットフォームのアイコン、サムネイル、ヘッダー、動画での使用\n（※チャンネル収益化後も使用させて頂く予定です）\n・収益の発生しないネットプリント\n\nもし可能でしたら、以下もご検討頂けますと幸いです。↓\n・有料会員向けの特典(壁紙、カレンダー、チェキ化しての配布。有償販売はおこないません)\n・案件等への使用によるグッズ化\n\n\n※サムネなどへの加工の際、文字入れや色調補正など、多少の加工をして使用させて頂く場合がございます。何卒ご検討頂けますと幸いです。\n※使用の際には、出来るだけお名前やURLを記載いたします。\n※不可の用途がございましたら、別レイヤーにてその旨をお伝え頂けますと幸いです。\n\n\n\n●イラストについて\nもし可能でしたら、満点の星空か青空をバックにしているようなシチュエーションですと嬉しいです。\nその他表情、ポーズなどはお任せさせて頂きます。\n人物は拡大縮小・トリミングして使用できるよう、頭(カチューシャ含む)や顔が切れない構図ですと嬉しいです。\n立ち絵の詳細は以下からご確認ください。\nhttps://frontier.creatia.cc/fanclubs/2097/posts/16653\n\n\n●ご納品形式\n可能であればPSDデータでお願いいたします。\n背景、人物、文字はそれぞれ分かれておりますと大変助かります…！\n難しければ透過済データを含むPNGファイルでお願いいたします。\n\n\n活動への使用が難しい場合は、リクエストを却下頂けますと幸いです。\n以上、お忙しいところ大変恐縮ではございますが、何卒ご検討のほどよろしくお願いいたします！\n\n\nhttps://x.com/Aliceno_Tou\n\nhttps://frontier.creatia.cc/fanclubs/2097/posts/16653", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takanashihotori/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f5e26d53/uploads/origins/e8f6ae2d-aea7-4f7d-977a-25746e4c2353?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1360623b675c7aed3e81b4e68af49344", "srcset": "https://si.imgix.net/f5e26d53/uploads/origins/e8f6ae2d-aea7-4f7d-977a-25746e4c2353?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1360623b675c7aed3e81b4e68af49344, https://si.imgix.net/f5e26d53/uploads/origins/e8f6ae2d-aea7-4f7d-977a-25746e4c2353?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bd8bd6cc1624a0b71a3c150247eff179 2x, https://si.imgix.net/f5e26d53/uploads/origins/e8f6ae2d-aea7-4f7d-977a-25746e4c2353?bg=%23fff&aut