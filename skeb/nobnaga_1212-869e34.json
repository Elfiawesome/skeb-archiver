だき、ぜひイラストをお願いしたく連絡いたしました。\n\n11/7ポストのせんちょー🏴‍☠️イラストの構図や表情が最高です。ぜひ描いていただきたいので、ご検討よろしくお願いいたします。\n\n\n【描いていただきたい内容】\nホロライブ　紫咲シオン様\n先生のおまかせにて描いていただければと思っています。\n\n 【リクエスト】\n可能であれば、11/24ポストの宝鐘マリン様のイラストのようなポーズを要望いたします。\n\n 【使用用途】\nスマホやパソコンの壁紙\n自分の車へのラッピング\n\n【その他】\n先生が描いていただいたもの主体に、文字や背景をデザインしていく予定です。\nもし先生が背景や小物を描いていただけることが可能でしたら、活用していきたいと思っております。\n\nご検討よろしくお願いいたします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nobnaga_1212/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2913698, "client_id": 2956711, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3511a876/uploads/origins/384edd43-549e-495b-b4b3-be13b58fa8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bc8a006823bc7869bc4914105ce2e9c", "srcset": "https://si.imgix.net/3511a876/uploads/origins/384edd43-549e-495b-b4b3-be13b58fa8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bc8a006823bc7869bc4914105ce2e9c, https://si.imgix.net/3511a876/uploads/origins/384edd43-549e-495b-b4b3-be13b58fa8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3b709b54c5ea4242be66fd2e206f4b3 2x, https://si.imgix.net/3511a876/uploads/origins/384edd43-549e-495b-b4b3-be13b58fa8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c762999d095c90eafae028090dfd962 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3511a876/uploads/origins/384edd43-549e-495b-b4b3-be13b58fa8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f8135ab554c3cf15966b18cd5446dc4", "srcset": "https://si.imgix.net/3511a876/uploads/origins/384edd43-549e-495b-b4b3-be13b58fa8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f8135ab554c3cf15966b18cd5446dc4, https://si.imgix.net/3511a876/u