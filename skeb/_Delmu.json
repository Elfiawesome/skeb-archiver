_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@_Delmu/works/101", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2224202, "client_id": 3201561, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1b0d913/uploads/origins/e020b8e3-5eca-40f1-8ae2-d64b1019295e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0394d52f9872964c34329df64d6e2b85", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1b0d913/uploads/origins/e020b8e3-5eca-40f1-8ae2-d64b1019295e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a43aa7aec1dba433ad22e3d5294e4194", "src_set": ""}, "body": "こんにちは、またお会いできて嬉しいです Delmu!!👋\nすべてが順調であることを願っています！😄\n\nまたあなたにコミッションをお願いしたい気分になりました！あなたの美しくて可愛いスタイルが本当に大好きなんです！！🥰🥰\n\n今回はまた怖いテーマのものにしたいです。前回と同じく、ふわふわなドラゴンの男の子を描いてほしいです！\n私が思い描いているのは、普通の姿のキャラの頭の中で、邪悪なバージョンのキャラが悪い声を囁いているような構図です。普通のキャラは、頭がおかしくなりそうな狂気じみた表情をしていて、両手を使って自分の頭を抱え込んで「お願いだから止めて…」と考えている感じです。\n邪悪なバージョンは、普通のバージョンの後ろ側に立っているような感じでもいいかもしれません。\nそれ以外の部分については、全部あなたにお任せします！あなたは素晴らしいアーティストなので、きっと素敵なものを描いてくれると信じています！！😆😌\n\nご検討いただけたら嬉しいです！あらかじめありがとうございます。素敵な一日をお過ごしください！❤️💜\n\nhttps://drive.google.com/drive/folders/175SL7H91hYIrIsWqU6FdTguZo3Bag6aQ", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_Delmu/works/100", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2224202, "client_id": 1866828, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/faedc8ab/uploads/origins/d1b5dec5-6ea5-4f29-ab84-52fbc1293608?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08cf1ee006f433093bb3fad48d2b5210", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/faedc8ab/uploads/origin