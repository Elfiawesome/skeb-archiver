tter.com/paradoxicaltheo/status/1421715295769567233?s=19\n\nhttps://tocca571.parallel.jp/original/arc/", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@VIRGIL_bazi/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/de5a5838/uploads/origins/ef9aea5d-9257-4fcb-a01f-a77d8692b935?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5a88756f961ca3ffd90386c9f29792d", "srcset": "https://si.imgix.net/de5a5838/uploads/origins/ef9aea5d-9257-4fcb-a01f-a77d8692b935?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5a88756f961ca3ffd90386c9f29792d, https://si.imgix.net/de5a5838/uploads/origins/ef9aea5d-9257-4fcb-a01f-a77d8692b935?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff22efed53e325e608533888ac62f780 2x, https://si.imgix.net/de5a5838/uploads/origins/ef9aea5d-9257-4fcb-a01f-a77d8692b935?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=336d8b4c94ddd2a31086e739d1e5011a 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 2784449, "nc": 160}], "sent_works": [], "similar_creators": [{"id": 64824, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あまり", "screen_name": "amarimari1092", "avatar_url": "https://pbs.twimg.com/profile_images/1399315452744986624/dOclk8mG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/805344510666412033/1735659362/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": nu