るとありがたいです。\n\n服装は私服でいいですが、できましたらステージ衣装のようにアレンジしていただけると幸いです。\n\nまた、用途ですが、\n個人鑑賞のほか、SNSや、動画内外の素材として使用したく思っております\nもしそのような使用が許可できないようであればキャンセルお願いします。\n\nご検討よろしくお願いします\n\nhttps://twitter.com/shidahara_shoko/status/1542057123923668992?s=46&t=pTMIm8rffZr4MV868THnGQ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 485314, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "アスカール", "screen_name": "magika_ru", "avatar_url": "https://pbs.twimg.com/profile_images/1770439593546141696/slzrOpWt.jpg", "header_url": "https://pbs.twimg.com/profile_banners/786596151734640645/1764609010/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 128}, {"id": 1477472, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Garan@ご依頼募集中", "screen_name": "Garan0502", "avatar_url": "https://pbs.twimg.com/profile_images/1941121191298969600/MGjjDg1E.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1426119128952180743/1751604987/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 144}, {"id": 2076601, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Sasa", "screen_name": "sasaloglog", "avatar_url": "https://pbs.twimg.com/profile_images/1722603063863910400/RynwcKvU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1401713034687483906/1710901503/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "dele