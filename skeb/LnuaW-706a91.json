c-a6a6-9802c0637c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dfa824a667bbf798069bc5633263664b 3x"}, "body": "NOAHさんこんにちは。\n立ち絵などの色塗り・絵柄や、世界観が好きで、いつも見ています。\n色の使い方、特に白と黒のコントラストや塗り方が大好きです。\n昨日Skeb納品されていた絵もとても素敵でした。\n\n話は変わりますが、私の探索者を描いていただきたくリクエストを送らせていただきます。\n\n男/180cm/31歳/医者/アメリカ人と日本人のハーフ\n表情が乏しく、淡々とした口調だが、内心は割と感情豊か\n好きなもの：美術館・美術品（印象派以前）、医学書、クラシカルな雰囲気、うさぎ、うさぎカフェ、うさぎメイドカフェ、なわとび\nhttps://drive.google.com/drive/folders/1QBimeTHzMyNBTvLKDkNHnF9FCNZTcuNg?usp=drive_link\n\n細かいキャラデザ・装飾はあまり気にせず自由に描いて頂けるととても嬉しいです。\nご検討いただけますと幸いです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@LnuaW/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3145485, "client_id": 660787, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/58955bc4/uploads/origins/7dab1633-abbd-42fa-8297-865165b9e3e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc50b9b9af8810ffba2262470c74e01f", "srcset": "https://si.imgix.net/58955bc4/uploads/origins/7dab1633-abbd-42fa-8297-865165b9e3e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc50b9b9af8810ffba2262470c74e01f, https://si.imgix.net/58955bc4/uploads/origins/7dab1633-abbd-42fa-8297-865165b9e3e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c36184ac5a920b0c460c5ebf335bc8b 2x, https://si.imgix.net/58955bc4/uploads/origins/7dab1633-abbd-42fa-8297-865165b9e3e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebf5f185ada3021f4d97f55ab83bef50 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/58955bc4/uploads/origins/7dab1633-abbd-42fa-8297-865165b9e3e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=484157db031f2fb60f4dffcf175a2616", "srcset": "https://si.imgix.net/58955bc4/uploads/origins/7dab1633-abbd-42fa-8297-865165b9e3e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=484157db031f2fb60f4dffcf175a2616, https://si.imgix.net/58955bc4/uploads/origins/7dab1633-abbd-42fa-8297-865165b9e3e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=67d4837e940f658196ba1dbf8b6f4264 2x, https://si.imgix.net/58955bc4/uploads/origins/7dab1633-abbd-42fa-8297-865165b9e3e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0ad8f6fa7d939ce21baa7ab9c0b8cfc8 3x"}, "body": "はじめまして、えみゅと申します。 \n新着でNOAH様のイラストをお見かけし、繊細な世界観の表現や落ち着いた雰囲気のある色使いに惹かれ、そして何より絵柄が大変好みでリクエストをお送りさせていただきました。\nどうかうちのこ3人組を描いていただけないでしょうか？\n\nツッコミ体質の双子の兄、めんどくさがり屋の双子の妹、トラブルメーカーな2人の幼馴染みの3人組です。 \n3人ともマフィアの子供たちで、昼間は普通の中学生、夜はファミリーの一員として戦ったりしています。 \n見た目や性格、関係性は添付させていただいた資料を参考にしていただけますと幸いです。\n\n服装は黒スーツのような感じでお願いします。資料にある今まで描いていただいたもののように、アレンジなどしていただいても嬉しいです...！\n\n構図につきましてはお任せします。\n3人が均等な大きさでなくてもいいですし、誰かが見切れていたり映り込みのような感じになっても構いません。\n是非お好きなように描いてください！ \n\n何卒ご検討いただけますと幸いです。 \nどうぞよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1-G56onMRATg_YQBDIUfXK6xW3vGiI9nQ", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@LnuaW/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3145485, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe622b0b/uploads/origins/28d28b5e-c613-4443-baa0-f14601285b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=148d3e138ec89be074ab9868a62d7a0a", "srcset": "https://si.imgix.net/fe622b0b/uploads/origins/28d28b5e-c613-4443-baa0-f14601285b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=148d3e138ec89be074ab9868a62d7a0a, https://si.imgix.net/fe622b0b/uploads/origins/28d28b5e-c613-4443-baa0-f14601285b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a546