t/71145455/uploads/origins/e1e1b45b-483f-4022-8a24-c797457ed1b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f60d683e4fe31da687448e45f6024028, https://si.imgix.net/71145455/uploads/origins/e1e1b45b-483f-4022-8a24-c797457ed1b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64a0136fb4bf2f854789ff60781ddcb8 2x, https://si.imgix.net/71145455/uploads/origins/e1e1b45b-483f-4022-8a24-c797457ed1b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62139834f742dc9219d9295ae0e54a52 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71145455/uploads/origins/e1e1b45b-483f-4022-8a24-c797457ed1b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7780b7412a76c7b175a23e5cacc1ad7f", "srcset": "https://si.imgix.net/71145455/uploads/origins/e1e1b45b-483f-4022-8a24-c797457ed1b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7780b7412a76c7b175a23e5cacc1ad7f, https://si.imgix.net/71145455/uploads/origins/e1e1b45b-483f-4022-8a24-c797457ed1b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f5a261e891c0d126afeb9109270bfdb 2x, https://si.imgix.net/71145455/uploads/origins/e1e1b45b-483f-4022-8a24-c797457ed1b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e9c1cd27fe8ed61b7828f940d75d442 3x"}, "body": "お世話になっております。刄紅夜です。ᴺᴼᴬᴴ💧先生のイラストが大好きです。 今回、私のvtuberのキャラクターを描いてほしいです。個人的にデスクトップ壁紙に使用しますので、アスペクト比は16:9くらいだと嬉しいです。\n 名前は『霞蒼（かそう）』、見た目は14歳くらいの中学2年生ですが、実際は121歳です。 メドゥーサの末裔であり、蛇のような縦長の瞳孔を持った真っ赤な瞳と、病的に白い肌、可愛らしい猫口、それから、二重螺旋状にうねった髪の毛が特徴です。 普段は膝丈のセーラー服を着ていますが、性別はなく、たまに学ランを着ることもあります。胸はありません。 髪の毛の毛束は4本に別れており（右2、左2）、4匹の蛇に変化することができます。 髪の毛には痛覚があり、参考資料の病院服姿のものでは髪を雑に切ってしまっています。 また、左腕には🐿🦟の傷跡があり、いつも包帯を巻いています。 主食はヒトで、見境なく人間を食べています。  構図等はお任せしますが、以下のポイントを加味してくださると嬉しいです。\n\n・現代日本のどこか（都会の街並みや学校の教室など）\n・衣装は長袖のセーラー服か病院服\n・血が飛び散っている\n・デスクトップ壁紙に使用しますので、キャラクターは画面の中央〜右半分くらいに位置していると嬉しいです。\n\nよろしくお願いします。 #霞蒼の仮想 がファンアートタグです。見ると雰囲気が少しわかるかもしれませんが、ᴺᴼᴬᴴ💧先生の世界観が好きなので、お好きに描いていただければと存じます。\n\nhttps://twitter.com/kasou_daily/status/1596449612990406656?s=46&t=sQB0IU-IJ5e1Li8HUpyRbg", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@LnuaW/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3145485, "client_id": 3147044, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92283a55/uploads/origins/3878db59-1408-445e-a266-f9ea1425ec8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69f4ac3f4185e6c13dad4db988f01f24", "srcset": "https://si.imgix.net/92283a55/uploads/origins/3878db59-1408-445e-a266-f9ea1425ec8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69f4ac3f4185e6c13dad4db988f01f24, https://si.imgix.net/92283a55/uploads/origins/3878db59-1408-445e-a266-f9ea1425ec8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bd26dd31ca4727a6bc4b9de73bf3c21 2x, https://si.imgix.net/92283a55/uploads/origins/3878db59-1408-445e-a266-f9ea1425ec8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2d501bdbbc79965f145f6eed27554c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92283a55/uploads/origins/3878db59-1408-445e-a266-f9ea1425ec8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ce22f36a7ce4aabe0b654104bb47c0f", "srcset": "https://si.imgix.net/92283a55/uploads/origins/3878db59-1408-445e-a266-f9ea1425ec8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ce22f36a7ce4aabe0b654104bb47c0f, https://si.imgix.net/92283a55/uploads/origins/3878db59-1408-445e-a266-f9ea1425ec8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w