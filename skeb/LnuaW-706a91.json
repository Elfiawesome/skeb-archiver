博愛的です。\n\n４・怜関鏡花(18)\n身長：155cm\n通過シナリオ：水天一碧を朝凪でのぞむ。HO1\nとても落ち着いていて、静かな女の子です。自発的な行動が少なく、常にぼんやりとしていてあまり言葉を発しません。　キラキラしたものが好きです。\n\n以上の4キャラクターを希望するのですが、金額が足りない場合や、何か不都合があれば適宜削って頂いて大丈夫です。\n\n・使用用途\n観賞用\nSNSアイコン\nココフォリア盤面での使用\n個人グッツの制作\n\nくにさんのSDキャラクターが好きなので、可能であればSDでお願いしたいですが、基本的にくにさんの思うように、自由に描いて頂けると嬉しいです。\n\n難しければお気軽にキャンセル、または再送依頼の方してください...！ ご検討の程何卒よろしくお願い致します。\n\nhttps://drive.google.com/drive/u/0/folders/1Hw1qdjXjtTph-8lhMdHWz7FS1J6bWP0-", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MOFUoo00/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3147044, "client_id": 3145485, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d2c6c8d/uploads/origins/df8ef7b1-d400-4cb2-97d5-8750af2dd230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25ddb0b04224ec0b4b7f58f02630ee55", "srcset": "https://si.imgix.net/9d2c6c8d/uploads/origins/df8ef7b1-d400-4cb2-97d5-8750af2dd230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25ddb0b04224ec0b4b7f58f02630ee55, https://si.imgix.net/9d2c6c8d/uploads/origins/df8ef7b1-d400-4cb2-97d5-8750af2dd230?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa1c9c95eec25b8fa2667ce8e1c26de2 2x, https://si.imgix.net/9d2c6c8d/uploads/origins/df8ef7b1-d400-4cb2-97d5-8750af2dd230?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e38281ed96b06d2391d525647737ed09 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d2c6c8d/uploads/origins/df8ef7b1-d400-4cb2-97d5-8750af2dd230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efb131971a06f2e7f2f2760b83688439", "srcset": "https://si.imgix.net/9d2c6c8d/uploads/origins/df8ef7b1-d400-4cb2-97d5-8750af2dd230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200