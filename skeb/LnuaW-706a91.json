5cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4a8c54c605631cda1bd9b10760afed4 2x, https://si.imgix.net/4fad978c/uploads/origins/9d77283b-cac9-4357-ae29-deb9a4b55cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8515efb8e52861abe1ef4085b66b155b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4fad978c/uploads/origins/9d77283b-cac9-4357-ae29-deb9a4b55cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=432310638a93fac8aeefcefcc8c7c0f2", "srcset": "https://si.imgix.net/4fad978c/uploads/origins/9d77283b-cac9-4357-ae29-deb9a4b55cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=432310638a93fac8aeefcefcc8c7c0f2, https://si.imgix.net/4fad978c/uploads/origins/9d77283b-cac9-4357-ae29-deb9a4b55cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a9343a9ea09e2eb4a2b103e3f1961f0f 2x, https://si.imgix.net/4fad978c/uploads/origins/9d77283b-cac9-4357-ae29-deb9a4b55cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2d1d1e781b36bcaeaa80cfb1e9233cdb 3x"}, "body": "こんにちは。\nのあさんの描かれる絵が本当に大好きで、ずっとリクエストの機会を伺っていたのでこの機に……！と思いリクエストさせて頂きました。\nもしよろしければ、私と友人のキャラクターを描いていただければ幸いです。\n\n\n✦ リクエスト内容\n\n両者共に日本に住む成人済みの男性で、一人は刑事、もう一人は記者をやっている兄弟です。両親は幼い頃に殺されてしまい、二人で支え合い生きてきました。\n\n┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈\n\n✦ 兄側(画像左側)\n落ち着いた雰囲気の青年で、物腰が穏やか。\n男女平等に接し、気兼ねなく話せるようなタイプなので割とモテる。\nトラウマがあるため、そのことに触れられたり思い出したりすると酷く取り乱してしまう。\nまた、弟のことを何よりも大事にしているが、たまに独占欲を出してしまうこともしばしば。\n\n┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈\n\n✦ 弟側(画像右側)\n基本的に、外面がいいため愛想も良く友人も多い。\n兄のことが大好きで兄離れができず、常に一緒にいたいと思うほど。\n同担拒否なので、兄が誰かと話しているだけでも嫌がるタイプ。\nそのため、外面が良くても兄のことになると、相手を牽制することもある。\nまた、押しが強く兄が若干渋っていることでも押し切って折られてもらいがち。わがままになる。\n\n┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈\n\n\n資料は下記URLにまとめさせて頂いておりますので、お手数おかけしますが確認頂ければ幸いです。背景込みの一枚絵だと嬉しいです。\n資料にない部分等や分かりにくい部分は、お好きなようにアレンジし描いて頂ければと思います。それと同様、細かい構図や雰囲気等もおまかせしたいと思っております。\n\n使用用途として主には個人用になりますが、Twitterのアカウントでアイコン、またはヘッダーなどに設定させて頂けると幸いです。何卒、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1hyULjV0e0DD8UJcdfQNeyJgXaCeKDvrq?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@LnuaW/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3145485, "client_id": 3369917, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30d88f5a/uploads/origins/00e128da-5914-43f8-b580-3c62e183c4a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afbd6ac6f40a7f4ec755fcc503bc89f6", "srcset": "https://si.imgix.net/30d88f5a/uploads/origins/00e128da-5914-43f8-b580-3c62e183c4a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afbd6ac6f40a7f4ec755fcc503bc89f6, https://si.imgix.net/30d88f5a/uploads/origins/00e128da-5914-43f8-b580-3c62e183c4a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d961750bcb1a7926257f0a171c5772c6 2x, https://si.imgix.net/30d88f5a/uploads/origins/00e128da-5914-43f8-b580-3c62e183c4a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59e2091db622368e88e97f947cbeeebe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30d88f5a/uploads/origins/00e128da-5914-43f8-b580-3c62e183c4a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5c01497e5ba8d1fd4e95f3c0e70c3e6", "srcset": "https://si.imgix.net/30d88f5a/uploads/origins/00e128da-5914-43f8-b580-3c62e183c4a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5c01497e5ba8d1fd4e95f3c0e70c3e6, https://si.imgix.net/30d88f5a/uploads/origins/00e128da-5914-43f8-b580-3c62e183c4a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0230cf625a5545c7695a6a16464b11b8 2x, http