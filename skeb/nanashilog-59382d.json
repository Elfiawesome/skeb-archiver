s/d003b899-80f3-441b-835a-ea36a57c08d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ba64fa30a2367bd6c5960aa9bf4fa41 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ffbf4473/uploads/origins/d003b899-80f3-441b-835a-ea36a57c08d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ceb9f1970dd2429e2e44e2ef58fa7c7d", "srcset": "https://si.imgix.net/ffbf4473/uploads/origins/d003b899-80f3-441b-835a-ea36a57c08d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ceb9f1970dd2429e2e44e2ef58fa7c7d, https://si.imgix.net/ffbf4473/uploads/origins/d003b899-80f3-441b-835a-ea36a57c08d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4631102b0a816945d9c0a7a4b8689506 2x, https://si.imgix.net/ffbf4473/uploads/origins/d003b899-80f3-441b-835a-ea36a57c08d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e642b6679950408f5ea2f258f11e65d1 3x"}, "body": "はじめまして！VTuber魔鏡シロナと申します。\n小紫様のツイートを拝見しまして、是非依頼させていただければと思っております。\n私のサムネなどに使用出来るイラストを描いていただけないでしょうか。\nお試し期間中ということで、どんなイラストかはお任せします！(投げ銭機能付きの配信で使用する予定はありません)\n\n設定 \n・魔境にある森の中に住むしろうさぎの魔女。薬の実験や人間観察が好き。何百年と体を変えて生きている。\nゲームが好きだが友達が自分の造った使い魔しかおらず、VTuberとして活動を始めた。\n\nhttps://twitter.com/s_makagami07/status/1635573947487100930?t=GZBAPKcdV0PDFGDAvh4gJw&s=19\n\nhttps://twitter.com/s_makagami07/status/1635573947487100930?t=GZBAPKcdV0PDFGDAvh4gJw&s=19", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nanashilog/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1830273, "client_id": 1013933, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b62101af/uploads/origins/e74aca21-52ab-4d4e-bb28-256b3d8ef018?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8