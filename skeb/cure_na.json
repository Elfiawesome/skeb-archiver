ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7058d23498b7282d5ed8ce61e9658bb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b5b8c27/uploads/origins/a37a3bd0-2cda-41b5-82b7-34d70ae179c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e19eb985bc4101369117e0d24235fb5", "src_set": ""}, "body": "はじめまして。\nきゅあなし様がツイッターに投稿されているイラストがとてもかわいらしく、絵柄や作風の雰囲気も好きでぜひご依頼させていただきたいと思いました。\n\nリクエストは、個人VTuberの「餅月なこ」ちゃんのイラストです。\nなこちゃんはﾊﾞｰﾁｬﾙｶﾌｪのば～ふぇくと店長を務めており、抽象的で申し訳ないですが、「ﾊﾞｰﾁｬﾙｶﾌｪでの1シーン」というイメージでお願いしたいです。\nskebの依頼に関しては、ご本人様が許可を出しております。\n\nご検討よろしくお願いいたします。\n\n三面図等\nhttps://twitter.com/naco_mochizuki/status/1505194037111758852\n\nカフェのイメージ\nhttps://twitter.com/naco_mochizuki/status/1503021492745175044", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cure_na/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 934199, "client_id": 991042, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f5434b7/uploads/origins/6f65f2e7-f287-4be9-bdd6-5accf40bb510?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=510f0fcef9cbaba8fb548a8f3a493eea", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f5434b7/uploads/origins/6f65f2e7-f287-4be9-bdd6-5accf40bb510?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d8ffdbbef45f4213391f685b7dfb06c", "src_set": ""}, "body": "こんにちは。オリジナルVTuberをリクエストしたいと思いました。うさぎのぬいぐるみを抱きしめて寝ている、というのは可能でしょうか？その他、詳細はお任せします。ご検討の程、よろしくお願いします\n\n※イラストはSNSへの掲載・YouTube&Twitch配信サムネイルでの利用を考えています。\n\nhttps://drive.google.com/file/d/1rGNsYm_rDAJOVLs_hiTD-n7tO6Ato-gA/view?usp=sharing", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_crea