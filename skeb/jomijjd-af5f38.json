s=e0f3e322759d525e2acab8ac4d232b4d 3x"}, "body": "こんにちは、あなたの絵の中の油絵のような質感と優しい光影の雰囲気、特にあなたの絵の中の写真のような感じがとても好きです。\n申し訳ありませんでしたが、申し込みを再送してしまいました。できれば、セラがポプロス姿で池や庭のブドウ棚の下で休んでいる姿を描いてください。その周りには果物皿の装飾や、ブドウの実や花があります。できれば、割れたザクロやザクロの汁で汚れた服があった方が良いでしょう。アクセサリーについては、金の装飾品や、ブドウと花の組み合わせを選ぶことができます。ザクロやブドウを持っているところを描いてください。\n具体的なキャラクター紹介と大まかなシナリオ概要、衣装の参考や果物皿の参考などは以下のリンク内に掲載されていますので、ご確認ください。文章紹介部分は 2 つの言語バージョンがありますので、より読みやすい言語をご自由にご確認ください！読んでいただきありがとうございました！\n可能であれば PSD ファイルを提供していただけますか。この依頼で提供された作品は、個人的な鑑賞、プライベート壁紙、同好者間の無償交換のみを目的としており、商業的な内容は一切含まれていません。\nもしあなたがこの依頼を受け入れてくださるなら、私は非常に感謝します。とにかく、楽しい人生をお送りします。\nhttps://drive.google.com/drive/folders/1HH9E1j5A2EWKJNJM26Ks-VmufSlL5f0_?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jomijjd/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3969969, "client_id": 4022744, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/308e4e46/uploads/origins/6a027b25-20e1-479d-bce6-4aa224e4ba75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b729864e2304986aa6da02b944a7fb44", "srcset": "https://si.imgix.net/308e4e46/uploads/origins/6a027b25-20e1-479d-bce6-4aa224e4ba75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b729864e2304986aa6da02b944a7fb44, https://si.imgix.net/308e4e46/uploads/origins/6a027b25-20e1-479d-bce6-4aa224e4ba75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d58ec93c61805ae89ea9c8330bbb50e1 2x, https://si.imgix.net/308e4e46/uploads/origins/6a027b25-20e1-479d-bce6-4aa224e4ba75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d77f8f84e47fcc03b8a9a1c43f723ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/308e4e46/uploads/origins/6a027b25-20e1-479d-bce6-4aa224e4ba75?bg=%23fff&auto=format%2Ccompress&fm=we