ploads/origins/7e4cd45d-7927-4f36-b501-987f185b6ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18d5e6b36f1326e1f67cbddaab851c3c, https://si.imgix.net/b518617b/uploads/origins/7e4cd45d-7927-4f36-b501-987f185b6ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6bad1ae7ca52e0ddb25db5993ac55df5 2x, https://si.imgix.net/b518617b/uploads/origins/7e4cd45d-7927-4f36-b501-987f185b6ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a45a2e2c4d1a66a5425d41c563aaeeb0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b518617b/uploads/origins/7e4cd45d-7927-4f36-b501-987f185b6ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3801aa3e8ff57543226ec7423642a896", "srcset": "https://si.imgix.net/b518617b/uploads/origins/7e4cd45d-7927-4f36-b501-987f185b6ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3801aa3e8ff57543226ec7423642a896, https://si.imgix.net/b518617b/uploads/origins/7e4cd45d-7927-4f36-b501-987f185b6ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cad35bbbacd76e4c05af5516011a4f48 2x, https://si.imgix.net/b518617b/uploads/origins/7e4cd45d-7927-4f36-b501-987f185b6ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3393466d5b27d655311130735f1ef528 3x"}, "body": "こんにちは、toy先生。\n私はchibiカリちゃんの物語を描いた漫画をお願いしたいです。もし可能であれば。よろしくお願いします。\n\n内容は、カリ伯が作った小型の人形（物品锻造(伪)EX）で、この設定は物語には登場しないかもしれませんが、この人形はマスターにとても気に入られています。食事の時は一緒に連れて行き、マスターは通心粉を食べさせたり、寝る時は枕の横に置いたりします。また、小カリちゃんにいくつかの装飾品を与えたりします。その間、本体のカリ伯は静かに微笑んで見守っています（表情には出さないかもしれませんが、少し不満があるかもしれませんねw）\n\nそして、周回の時にマスターが小カリちゃんを出撃させます。小カリちゃんは自分の体と同じくらいの大きさのフォークを抱えて、突撃するようなポーズを取ります。マスターは後方で「がんばれ！」のポーズを取っています。その時、カリ伯がやって来て、マスターに「戦闘は私に任せてください」と言います。\n\n完成後はご自由に公開していただいて構いません。クレジット表記も不要です。改めて、誠にありがとうございます", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@momo_kuri_kaki8/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3004835, "client_id": 192290, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7961ffd1/uploads/origins/4e4d3438-d27b-451e-a702-4561260629d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91614c26db4be44c5df6035ce07bd52c", "srcset": "https://si.imgix.net/7961ffd1/uploads/origins/4e4d3438-d27b-451e-a702-4561260629d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91614c26db4be44c5df6035ce07bd52c, https://si.imgix.net/7961ffd1/uploads/origins/4e4d3438-d27b-451e-a702-4561260629d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fcd326d3feb72258a460acbf3cde6321 2x, https://si.imgix.net/7961ffd1/uploads/origins/4e4d3438-d27b-451e-a702-4561260629d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1e266a54b3cc9c431378a393e7e74ae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7961ffd1/uploads/origins/4e4d3438-d27b-451e-a702-4561260629d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47554ea1e0e18ff077fc76e975954c61", "srcset": "https://si.imgix.net/7961ffd1/uploads/origins/4e4d3438-d27b-451e-a702-4561260629d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47554ea1e0e18ff077fc76e975954c61, https://si.imgix.net/7961ffd1/uploads/origins/4e4d3438-d27b-451e-a702-4561260629d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a2a5b961d494ab859ff46b0e450f78c 2x, https://si.imgix.net/7961ffd1/uploads/origins/4e4d3438-d27b-451e-a702-4561260629d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2ea8acd29b58a50cce5e70ecd4076c5 3x"}, "body": "こんにちは、はじめまして。あなたの画風がとても好きです！私のオリジナルキャラクターのイラストをお願いしたいです。\n\nɨ キャラクターの詳細。男性。身長198cm。21歳。ハーフオーク。ダークグリーンの髪。水色の瞳。嵐の時は目が灰色になる。大柄で筋肉質。海洋帝国の見栄っ張りでのんきな第二王子。自信家。肌の色と下あごの鋭い歯にご注目。\n\nモチーフは嵐、海、森。\n\nありがとうございました！ご遠慮なくお断りください。\n\nhttps://drive.google.com/drive/folders/132QfVAmhNa1zDVPjctxTSxFpjaLBRo1j", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@momo_kuri_kaki8/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3004835, "client_id": 3206537, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df0cface/uploads/origins/c29b1cb6-e69e-40fe-acd2-c66cf8d42651?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3db3d68a1e38b5b47d9143233beea4cb", "srcset": "https://si.imgix.net/df0cface/uploads/origins/c29b1cb6-e69e-40fe-acd2-c66cf8d42651?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3db3d68a1e38b5b47d9143233beea4cb, https://si.imgix.net/df0cface/uploads/origins/c29b1cb6-e69e-40fe-acd2-c66cf8d42651?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff41304fbb371412a5296b61dc16608a 2x, https://si.imgix.net/df0cface/uploads/origins/c29b1cb6-e69e-40fe-acd2-c66cf8d42651?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=257e8c0ebb99053479cac5297fdac323 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df0cface/uploads/origins/c29b1cb6-e69e-40fe-acd2-c66cf8d42651?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dde6d3d00c32d8c9e8f9272f059ff8e8", "srcset": "https://si.imgix.net/df0cface/uploads/origins/c29b1cb6-e69e-40fe-acd2-c66cf8d42651?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dde6d3d00c32d8c9e8f9272f059ff8e8, https://si.imgix.net/df0cface/uploads/origins/c29b1cb6-e69e-40fe-acd2-c66cf8d42651?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c72ba823c1a52e06e9f77acb35b72cc8 2x, https://si.imgix.net/df0cface/uploads/origins/c29b1cb6-e69e-40fe-acd2-c66cf8d42651?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2b627a4e95d61d110b592464cc29bf9a 3x"}, "body": "Hello Toy,\nI really love your wonderful art!\nI am contacting you because I would like to commission an illustration based on Cagliostro (FGO). I would like Cagliostro to be in the front of the screen in a “shhhh” pose and a giant white python snake coiled around him. The completed work can be published.\nThank you.\n\nこんにちはToyさん、\nいつも素晴らしい作品を拝見しています\nこの度は、私の好きなキャラクターをテーマにしたイラストを依頼したいと思い、ご連絡させていただきました。具体的には、キャラクターはカリオストロで、彼が巨大な白い蟒蛇と一緒に描かれているイメージです。カリオストロは画面の前方で「シッ」というポーズをしてほしいですね。背後には大きな蟒蛇が彼の周囲に巻き付いている様子を表現してください。完成した作品は公開可能です。\nどうぞよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 833375, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "夏野かなせみ", "screen_name": "kanaseminatsuno", "avatar_url": "https://pbs.twimg.com/profile_images/1959565171757895680/6m5iUxZE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1733826102324539392/1702212232/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 128}, {"id": 1673377, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "かなもの", "screen_name": "yayayakan", "avatar_url": "https://pbs.twimg.com/profile_images/1715657627756306432/owxKoTI-.png", "header_url": "https://pbs.twimg.com/profile_banners/120500297/1709443477/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_ran