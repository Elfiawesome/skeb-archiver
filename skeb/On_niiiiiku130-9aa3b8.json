6bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dfb2ccf370679332222c8e471ee4a51", "srcset": "https://si.imgix.net/2116aa8c/uploads/origins/f9b85334-28e6-44ec-8816-102ecb736bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dfb2ccf370679332222c8e471ee4a51, https://si.imgix.net/2116aa8c/uploads/origins/f9b85334-28e6-44ec-8816-102ecb736bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef96fb3cbfe296cf1c8ca1c5ded76cb7 2x, https://si.imgix.net/2116aa8c/uploads/origins/f9b85334-28e6-44ec-8816-102ecb736bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08a9b54a93cbc2edf9b3ea5a01998567 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2116aa8c/uploads/origins/f9b85334-28e6-44ec-8816-102ecb736bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4e5801a86b5459e0d3d650ee65dee38", "srcset": "https://si.imgix.net/2116aa8c/uploads/origins/f9b85334-28e6-44ec-8816-102ecb736bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4e5801a86b5459e0d3d650ee65dee38, https://si.imgix.net/2116aa8c/uploads/origins/f9b85334-28e6-44ec-8816-102ecb736bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a224749768dfd846ca25746cf5278f4 2x, https://si.imgix.net/2116aa8c/uploads/origins/f9b85334-28e6-44ec-8816-102ecb736bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b8049bff7b3c02dbedac3b282811cedc 3x"}, "body": "おにく 様\n\n初めまして、個人で活動をしております冥と申します。\n\nTwitterにておにく様のイラストを拝見し凄く綺麗なイラストでぜひおにく様にイラストを描いていただきたく思いリクエストさせていただいております…！\n\n\n\n【使用用途】\n・歌ってみた動画のイラストとして使用\n・Twitter,YoutubeのアイコンやYoutubeのサムネイルとして使用\n・配信等で画面内に映す等\n（Youtubeで投稿した動画や配信など使用した場合は収益化は致しません。）\n\n上記許可いただけますと幸いです。\n\n【使用楽曲】\n「貴方だけが幸せでありますように。」という曲になります。\n・URL→　https://youtu.b\ne/Q7MY_mV2yto?si=2gT9M-o-voiICrMg\n\n【構図等】\n本家様動画のイラストを参考にする形で正面を真っすぐ見るような構図にしていただきたいです。\n赤目の右側を旧代理に、黄色目の左側を現代理に、混ぜたようなキメラ的な感じで描いていただきたいです。\n現代理が髪を結っているので本家様のイラストで髪靡いているように、結った髪が靡いている感じにしていただきたいです。\n(指定が分かりずらかったり多すぎる場合は大変申し訳ありません…無視して頂いても大丈夫です…！)\n服装はお任せします…！\n\n背景はバグったようなおにく様が他のskebにて描いていたような色がぐにゃぐにゃと混ざったような感じでお願いしたいです。\n(本当におにく様のあの混ざったような感じ大好きです…！！！)\n\n細かい部分やおにく様が描いていくうえでこうしたほうがいいと感じた部分は好きなようにしていただいて大丈夫です…！\n\n【形式】\nサイズは比率が16:9(1920 x 1080pxなど)でお願いしたいです。\n\n宛名については別ファイルにしていただけると嬉しいです。\n\nよろしく願いいたします…！\n\n【キャラクター資料等】\n・　https://drive.google.com/drive\n/folders/15J8YbNqJnPMj2NyUTr9C7OrCD5uIilgF", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@On_niiiiiku130/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2314692, "client_id": 2926920, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa7be3d4/uploads/origins/256cb455-52a8-4cb6-b6c8-41e142510836?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2382c3d0826cf5c25184882cae523b4b", "srcset": "https://si.imgix.net/aa7be3d4/uploads/origins/256cb455-52a8-4cb6-b6c8-41e142510836?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2382c3d0826cf5c25184882cae523b4b, https://si.imgix.net/aa7be3d4/uploads/origins/256cb455-52a8-4cb6-b6c8-41e142510836?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41dbf84caa1c49236febdc0a954ce8e7 2x, https://si.imgix.net/aa7be3d4/uploads/origins/256cb455-52a8-4cb6-b6c8-41e142510836?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08ac9309bd30f239774a70b0a1be779b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa7be3d4/uploads/origins/256cb455-52a8-4cb6-b6c8-41e142510836?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=990740b041687c7bfbe326c4756a1a15", "srcset": "https://si.imgix.net/aa7be3d4/uploads/origins/256cb455-52a8-4cb6-b6c8-41e142510836?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=990740b041687c7bfbe326c4756a1a15, https://si.imgix.net/aa7be3d4/uploads/origins/256cb455-52a8-4cb6-b6c8-41e142510836?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b2aead64d9b3c8e984c90d853442f974 2x, https://si.imgix.net/aa7be3d4/uploads/origins/256cb455-52a8-4cb6-b6c8-41e142510836?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=520249cac047c0e66ec9c2b4d47c10fa 3x"}, "body": "こんにちは！あなたの絵はとてもかわいいと思うので、私のFF14キャラの絵をお願いしたいです！ファイル「in-game」→「blm.PNG」にある衣装が欲しいです。顔の右側の黒いタトゥーと、頭の左側のサイドポニーテールです。URLから彼の他の画像や、\"art/doodles \"フォルダにあるラフスケッチを見ることができる。\n\n彼は不機嫌で、退屈そうな表情を浮かべていることが多いが、遊び心があり、多少サディスティックに見えることさえある。ぜひ描いてほしいので、ポーズやディテールはお任せします。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1eVhKpEwDWI8E94uGS10o4n_DS2s_pddJ?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@On_niiiiiku130/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2314692, "client_id": 2845592, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e79d197e/uploads/origins/c3b0eab0-4ff0-4939-a8bd-e0dbd9014023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=385084dabda07eb3e7ee0b5b00bd06c7", "srcset": "https://si.imgix.net/e79d197e/uploads/origins/c3b0eab0-4ff0-4939-a8bd-e0dbd9014023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=385084dabda07eb3e7ee0b5b00bd06c7, https://si.imgix.net/e79d197e/uploads/origins/c3b0eab0-4ff0-4939-a8bd-e0dbd9014023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b745df55702b066b15bea2f734cadb90 2x, https://si.imgix.net/e79d197e/uploads/origins/c3b0eab0-4ff0-4939-a8bd-e0dbd9014023?bg=%23fff&auto=format%2Ccompress&fm=web