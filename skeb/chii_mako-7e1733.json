てはお好みで調整して構いません。\n依頼内容になにか問題があれば再送要請してください。\n\n参考資料：\nhttps://drive.google.com/drive/folders/124GsYYxoDy6iW0lUwKKV3NmINnnjIHhe?usp=sharing\n\n【使用用途】\n自分用の壁紙とアイコン、サムネイル、個人用な印刷などの使用\n他の方への依頼の際に資料として使用させていただくことがあります。\nSNS、ネットで公開する時には、ちぃまこさんを注記してから投稿します。\nできれば人物の透過やサインなどは別レイヤーに分けていただけると助かります。\n\nここまでお読み、私のリクエストを考慮していただければ幸いです、本当にありがとうございます。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@chii_mako/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/afdc1513/uploads/origins/64e8d4ee-2740-43ea-a59b-d2d399f1a45b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=296207cab4969be6382a10bad475c89f", "srcset": "https://si.imgix.net/afdc1513/uploads/origins/64e8d4ee-2740-43ea-a59b-d2d399f1a45b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=296207cab4969be6382a10bad475c89f, https://si.imgix.net/afdc1513/uploads/origins/64e8d4ee-2740-43ea-a59b-d2d399f1a45b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f67608412d1d06b85c0a62b5bfc8e43 2x, https://si.imgix.net/afdc1513/uploads/origins/64e8d4ee-2740-43ea-a59b-d2d399f1a45b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8d07c5bd007691ff0da9c346e8b2e8fb 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2364122, "nc": 0}, {"path": "/@chii_mako/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2364122, "client_id": 2616901, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b2421b3/