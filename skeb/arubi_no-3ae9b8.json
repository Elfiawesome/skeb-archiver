になっていますがお気になさらず\n\nhttps://drive.google.com/drive/folders/1ncnv1AD51ZLJwchQcgnYzslNFEke0Hoo?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurehalxxx/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1276255, "client_id": 1299707, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/707cc7e8/uploads/origins/392be2e4-f0f7-42ab-9aec-467298f9cb52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e88261484f18f1aa10548c3da5ff7052", "srcset": "https://si.imgix.net/707cc7e8/uploads/origins/392be2e4-f0f7-42ab-9aec-467298f9cb52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e88261484f18f1aa10548c3da5ff7052, https://si.imgix.net/707cc7e8/uploads/origins/392be2e4-f0f7-42ab-9aec-467298f9cb52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f09a431a3a7af15884eb638b5c1ededd 2x, https://si.imgix.net/707cc7e8/uploads/origins/392be2e4-f0f7-42ab-9aec-467298f9cb52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7df751de527c3af9bf03b6684e7d5dc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/707cc7e8/uploads/origins/392be2e4-f0f7-42ab-9aec-467298f9cb52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f28745127301e8e8acf223b813cd1563", "srcset": "https://si.imgix.net/707cc7e8/uploads/origins/392be2e4-f0f7-42ab-9aec-467298f9cb52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f28745127301e8e8acf223b813cd1563, https://si.imgix.net/707cc7e8/uploads/origins/392be2e4-f0f7-42ab-9aec-467298f9cb52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f1f992f0f2e5db2015562c1a38c295bd 2x, https://si.imgix.net/707cc7e8/uploads/origins/392be2e4-f0f7-42ab-9aec-467298f9cb52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd8d2e49250f08b05e129ae5e978ffce 3x"}, "body": "はじめましてvtuberと３Dモデラ―として主に活動しているこめじイリヤといいます\n今回は私のOCではなくvtuberの方のイラストを描いて欲しいと思いリクエストさせていただきました\n\n使用用途：Twitter(X)でのアイコンや観賞用またXでの投稿(描いてもらいました！と自慢ツイートをするかもしれません)\n\n概要：今回、\nkurehaさんのambient的な環境に溶け込んだイラストや目を惹く構図や配色が好きなので\n今回依頼させていただきいました(デザイン的な要素がたくさんちりばめれていて好きです)\n\n私のvtuberとしての姿なのですが少しでも描きやすくなるように\nキャラクター性など書き記しておきます\n\n所属：聖フローライト学園\n\n役職：学園長\n\n性格：資料に載せてある表情集のような普段はお茶らけているのですが\n時にシリアスで妖艶な表情をする　そんなギャップがある存在となっています\n\n小道具：うさぎのぬいぐるみを持っています\n\n場所や風景：アングラ的な薄暗い空気感のある場所にいたり、透明感があり今にも溶けてしまいそうなアンティークなどが並ぶ白く漂白した世界観などの両極端の世界に馴染むような存在です\n\n\n構図について：\nバストアップ～全身だと嬉しいです\nアイコンに使う想定でもあるので顔が映っているとうれしいなと思うのですが\n例え目が瞑っていてもかまいません\n後はお任せしたいと思います\n\nkurehaさんの好きなイラストを参考用として載せておきました\nocキャラがとてもかわよく素敵イラストいつもにこにこでみています\n\nhttps://drive.google.com/drive/folders/1KsLhYncSZSuUjN-Zyg99vsRLidCBMIAk?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cherichuxx/works/108", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 813632, "client_id": 1299707, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8669e2a7/uploads/origins/1a7109f1-7818-431b-98e6-c95012728f05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6db5a1ed67843de265474a84a60acb6", "srcset": "https://si.imgix.net/8669e2a7/uploads/origins/1a7109f1-7818-431b-98e6-c95012728f05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6db5a1ed67843de265474a84a60acb6, https://si.imgix.net/8669e2a7/uploads/origins/1a7109f1-7818-431b-98e6-c95012728f05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d481ec14c8aa7d7d9ca05cf804792395 2x, https://si.imgix.net/8669e2a7/uploads/origins/1a7109f1-7818-431b-98e6-c95012728f05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70342f8660