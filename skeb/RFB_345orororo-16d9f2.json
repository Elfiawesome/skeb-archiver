こしたり、喧嘩を仕掛けたり、厄介な状況に巻き込まれたりする癖があり、そのたびにノックスが介入して彼女を救い出すことになります。 ノックスは苛立った様子を見せつつも、明らかに彼女に弱い一面を持っている。\n\nお時間を割いてご検討いただき、ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1yjeyvg4-4PyTUTMjSF5yP0oEp3GCUtUU?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@RFB_345orororo/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3736436, "client_id": 1417639, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe5c6dca/uploads/origins/c5b7fece-6dc9-49c3-aecd-9ca6b0ec57cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5aa49b988c59ff63f264e9ff4f7a4848", "srcset": "https://si.imgix.net/fe5c6dca/uploads/origins/c5b7fece-6dc9-49c3-aecd-9ca6b0ec57cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5aa49b988c59ff63f264e9ff4f7a4848, https://si.imgix.net/fe5c6dca/uploads/origins/c5b7fece-6dc9-49c3-aecd-9ca6b0ec57cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cde2770ee8db379982b221de127967e1 2x, https://si.imgix.net/fe5c6dca/uploads/origins/c5b7fece-6dc9-49c3-aecd-9ca6b0ec57cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0606b05709fe51334bc950d63685e04f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe5c6dca/uploads/origins/c5b7fece-6dc9-49c3-aecd-9ca6b0ec57cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=548f79ef0951500ee19013196be744ac", "srcset": "https://si.imgix.net/fe5c6dca/uploads/origins/c5b7fece-6dc9-49c3-aecd-9ca6b0ec57cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=548f79ef0951500ee19013196be744ac, https://si.imgix.net/fe5c6dca/uploads/origins/c5b7fece-6dc9-49c3-aecd-9ca6b0ec57cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=