‎‎‎使用用途 \n観賞、個人用グッズ、SNSのアイコン、ヘッダー等、個人の範囲での使用 \nSNSで使用させていただく際はプロフィールにんぱ様のお名前を記載致します。  \n\n服装、シチュエーション等はんぱ様にお任せしますが、片方が関西出身なこともあり、関西弁と標準語での日常のやり取りが見られたらと思っております。その他描きたいと思ったものがあれば好きなものを描いていただければ幸いです。\n\n金額不足、資料の不備などありましたら気兼ねなく再送、キャンセル等していただければと思います。よろしくお願いいたします🌷\n\nhttps://drive.google.com/drive/folders/1vlaI3IKOAK4DXAF-oea8bp0L7rd11ODs", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@npa_aaa_aaa/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3854224, "client_id": 3741172, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/27cbae4d/uploads/origins/a217cbad-036d-489a-9d5b-0c389e0daacc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b3e091c122b666276948ddab085e1ed", "srcset": "https://si.imgix.net/27cbae4d/uploads/origins/a217cbad-036d-489a-9d5b-0c389e0daacc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b3e091c122b666276948ddab085e1ed, https://si.imgix.net/27cbae4d/uploads/origins/a217cbad-036d-489a-9d5b-0c389e0daacc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29b85bef9bd6d0ee1a6403d1ae501190 2x, https://si.imgix.net/27cbae4d/uploads/origins/a217cbad-036d-489a-9d5b-0c389e0daacc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e6eaadd203276778e471a58e1dc928a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27cbae4d/uploads/origins/a217cbad-036d-489a-9d5b-0c389e0daacc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=634f1cee1de880683f034c236a15d738", "srcset": "https://si.imgix.net/27cbae4d/uploads/origins/a217cbad-036d-489a-9d5b-0c389e0daacc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=634f1cee1de880683f034c236a15d738, https://si.imgix.net/27cbae4d/uploads/origins/a217cbad-0