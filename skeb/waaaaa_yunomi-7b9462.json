-3248-4d4b-b91e-9ac4f43b9bc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=569ca6a7da8ec3cb2b4d5c4894445b59, https://si.imgix.net/43250cb8/uploads/origins/b688eb52-3248-4d4b-b91e-9ac4f43b9bc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=066c7d9fc1afc64759e0144858b11d54 2x, https://si.imgix.net/43250cb8/uploads/origins/b688eb52-3248-4d4b-b91e-9ac4f43b9bc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05a03a05eddd78672a325bb2dc39296c 3x"}, "body": "こんにちは、あなたの作品をいくつか拝見し、素晴らしいと思いました！VTuberの一人を描いてほしいんだ。その絵は彼女のサムネイルとスケジュールに使われます。彼女の名前はRinonaで、遊び好きで陽気な性格のダンサーであるオオカミ少女です。ポーズはお任せしますので、バストアップでも構いません！\n\n参考資料のリンクはこちらです、\nhttps://drive.google.com/drive/folders/1z7VJ9Ep5onu16P64UT9-5ly6Pk4frmBy?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@waaaaa_yunomi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2960915, "client_id": 2113028, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d9b4bfa/uploads/origins/497fb310-abdd-4357-8d02-619e0de5ccc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0d15fe757d3a48810ab3fb9e60c73ba", "srcset": "https://si.imgix.net/5d9b4bfa/uploads/origins/497fb310-abdd-4357-8d02-619e0de5ccc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0d15fe757d3a48810ab3fb9e60c73ba, https://si.imgix.net/5d9b4bfa/uploads/origins/497fb310-abdd-4357-8d02-619e0de5ccc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=920d3db337046ba68c88e257e5abbec0 2x, https://si.imgix.net/5d9b4bfa/uploads/origins/497fb310-abdd-4357-8d02-619e0de5ccc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee06a5c839b98a00cc1cee63d2eae22c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d9b4bfa/uploads/origins/497fb310-abdd-4357-8d02-619e0de5ccc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d74bb0e56f5363fa036e064107e48276", "srcset": "https://si.imgix.net/5d9b4bfa/uploads/origins/497fb310-abdd-4357-8d02-619e0de5ccc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d74bb0e56f5363fa036e064107e48276, https://si.imgix.net/5d9b4bfa/uploads/origins/497fb310-abdd-4357-8d02-619e0de5ccc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4097380e542cbde30d1db50723a512b1 2x, https://si.imgix.net/5d9b4bfa/uploads/origins/497fb310-abdd-4357-8d02-619e0de5ccc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=91e0fba8d9a360b33f5571528020ba2f 3x"}, "body": "湯のみ茶🍵様\nはじめまして！Vtuberのしょーとと申します！\n新着から大変素敵で魅力的なイラストを拝見し、是非私も描いて頂きたいと思いリクエストを送信させて頂きました。\n\n【依頼内容】\nVtuberとして活動している私のイラストを描いて頂きたいです。\n表情やポーズやシチュエーション等全てお任せします！\n主に配信内や動画・配信サムネイルに使用させて頂きたいので、衣服の端や髪など、途切れないように描写していただけたら、とてもありがたいです。（全身イラストでなくても大丈夫です）\n\nまた、キャラクターの透過を使用させていただきたい場合があるので、PSDファイルで背景とキャラクターのレイヤーを分けて頂けたらとても嬉しいです・・・！\n\n【使用用途】\n収益化済Youtubeの配信関係・動画サムネやTwitterなど各種SNSの他、現在検討中ですが今後、印刷サービスなどを含むグッズとして使用させて頂きたいです。\n不可な使い道のものがございましたらPSDデータ内でお伝えいただけますと幸いです。\n\nVTuber（OC） へのイラストや使用用途がジャンル外、モデルが気に入らない等で却下して頂いても問題ございません。\n何卒条件等合いましたらご検討の程宜しくお願いします。\n\nhttps://drive.google.com/drive/folders/11dKZv6WOilzkK6q44YHN_fup8mg5q3UG?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@waaaaa_yunomi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2960915, "client_id": 774439, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d24f82b6/uploads/origins/08051c9e-ba3b-4723-8e49-cc044a44d2d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95b1431b635c9b7c0803bdb22b153358",