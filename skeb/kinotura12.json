64631ca-1e1a-41a2-991e-ae71360c614f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b8c7bfd0ffbb7299ca7edad33617256", "srcset": "https://si.imgix.net/e2a90b2d/uploads/origins/b64631ca-1e1a-41a2-991e-ae71360c614f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b8c7bfd0ffbb7299ca7edad33617256, https://si.imgix.net/e2a90b2d/uploads/origins/b64631ca-1e1a-41a2-991e-ae71360c614f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05fe9198dc08d413c74e9934ebcb9ea9 2x, https://si.imgix.net/e2a90b2d/uploads/origins/b64631ca-1e1a-41a2-991e-ae71360c614f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c43115c990978ffaa782ce48f41fbd8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2a90b2d/uploads/origins/b64631ca-1e1a-41a2-991e-ae71360c614f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0dad9e9af08254b0be5877aadee97e5c", "srcset": "https://si.imgix.net/e2a90b2d/uploads/origins/b64631ca-1e1a-41a2-991e-ae71360c614f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0dad9e9af08254b0be5877aadee97e5c, https://si.imgix.net/e2a90b2d/uploads/origins/b64631ca-1e1a-41a2-991e-ae71360c614f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d749338c9d4b4f39b77b6f58da58aebb 2x, https://si.imgix.net/e2a90b2d/uploads/origins/b64631ca-1e1a-41a2-991e-ae71360c614f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=22691cbd928a2991579a6780716edec7 3x"}, "body": "Denim2さん、小学生の頃から絵を見ています！大好きです。\n\n2次創作(3次創作)のキャラクターで、私がデザインした者がいるのですが、イラストをお願いすることはできますでしょうか。\n\n原作はUndertaleというゲームで、2次創作は公式ガイドラインで許可されております。\n今回お願いするのは原作の世界線から派生したif世界線(2次、3次創作世界線)のキャラのため、原作キャラクターからは大きく改変されています。\n\n名前はガーネット\nスケルトンの男性です。\n\nモンスター達が住む地下の世界で暮らしている、殺人鬼スケルトンです。\n表向きはポールダンサーとして生活しており、自身が殺人鬼であることを隠して暮らしています。\nエナメルのニーハイブーツを履いた、女王様のようなSです。性自認は男でバイのドラァグクイーンです。\n殺人(殺モンスター)を行うときには、相手を解体してグロテスクなオブジェのようなものを作ります。\n\n彼が蠱惑的な、猟奇的な表情で、ニッコリとこちらを見ているところをDenim2さんの絵でぜひ見たいです…\n彼の店(ポールダンスのショークラブ)の舞台裏、分厚いカーテンのうしろで、周りには誰も人目が無くて、次の瞬間には襲われて、こちらの命がおわってしまうような感覚だと嬉しいです。\n可能であれば、右手の中指と人差し指が金色の義指になっているので、それが怪しく光っているとうれしいですが、表情を見れるほうが一番嬉しいのでそれ以外はお任せいたします。\n\n正式な立ち絵が無く、ファイルも散らかっていて大変申し訳無いのですが、全身が見えるイラストや、装身具の構造などがわかるイラストをいくつかdropboxで紹介させて頂きます。\n\n▽dropbox共有リンク\nhttps://www.dropbox.com/scl/fo/k27kg6c3488d50pijgxuq/h?rlkey=myplkeved7ig4c9ry8m5x3jhb&dl=0\n\n宜しくお願いします…！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mpu3_3shim/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1299729, "client_id": 440726, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8f21b21/uploads/origins/948e44b2-3b37-4cbb-91d8-fc2150ff56d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f574980e3af02740c988ef2db16dde19", "srcset": "https://si.imgix.net/a8f21b21/uploads/origins/948e44b2-3b37-4cbb-91d8-fc2150ff56d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f574980e3af02740c988ef2db16dde19, https://si.imgix.net/a8f21b21/uploads/origins/948e44b2-3b37-4cbb-91d8-fc2150ff56d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a282798be52643e55cccb3fa1b5c9ec 2x, https://si.imgix.net/a8f21b21/uploads/origins/948e44b2-3b37-4cbb-91d8-fc2150ff56d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bbf826fc32a25642e3e597189f4d9f5b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8f21b21/uploads/origins/948e44b2-3b37-4cbb-91d8-fc2150ff56d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be93c11b4671c45a4b5e5f07de9d6f16", "srcset": "https://si.imgix.net/a8f21b21/uploads/origins/948e44b2-3b