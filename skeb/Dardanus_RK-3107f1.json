p&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b1e13c70a8a77045b29da0d42b4c487 2x, https://si.imgix.net/3659c007/uploads/origins/9d5bb0db-8f4c-418e-b347-dabb28f8c6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c443f6c7cb946af51b9662e4e6b503e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3659c007/uploads/origins/9d5bb0db-8f4c-418e-b347-dabb28f8c6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b11a63d0c82f932c9f7d910317439b4", "srcset": "https://si.imgix.net/3659c007/uploads/origins/9d5bb0db-8f4c-418e-b347-dabb28f8c6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b11a63d0c82f932c9f7d910317439b4, https://si.imgix.net/3659c007/uploads/origins/9d5bb0db-8f4c-418e-b347-dabb28f8c6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=69d1fe6590dd1aaee5ab2e56ade0011a 2x, https://si.imgix.net/3659c007/uploads/origins/9d5bb0db-8f4c-418e-b347-dabb28f8c6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=31d89d8cd586d99d1a97f8854794d464 3x"}, "body": "お世話になっております！！\nTwitter創作企画「終約の方舟」に参加したオリジナルキャラクターを、カラーイラストでお願いしたいです。\n\n・CSと似たようなポーズ・構図\n・夜ではなく昼の青空\n・表情は笑顔\n\nお願いしたいことは以上です。描きやすいよう、好きなように変更して下さい。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dardanus_RK/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2764631, "client_id": 2670845, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7bab4653/uploads/origins/4e5e8746-d238-4d7e-8ff3-03c04380ea94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5f3a9c1007615360800a949ccff1e0d", "srcset": "https://si.imgix.net/7bab4653/uploads/origins/4e5e8746-d238-4d7e-8ff3-03c04380ea94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5f3a9c1007615360800a949ccff1e0d, https://si.imgix.net/7bab4653/uploads/origins/4e5e8746-d238-4d7e-8ff3-03c04380ea94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2876b1817e26b0765423b894f8ddd680 2x, https://si.imgix.net/7bab4653/uploads/origins/4e5e8746-d238-4d7e-8ff3-03c04380ea94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adf8146094133a57da4f85248171e7c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7bab4653/uploads/origins/4e5e8746-d238-4d7e-8ff3-03c04380ea94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d6d3fcd82c32ab2ed19a10f80b50870", "srcset": "https://si.imgix.net/7bab4653/uploads/origins/4e5e8746-d238-4d7e-8ff3-03c04380ea94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d6d3fcd82c32ab2ed19a10f80b50870, https://si.imgix.net/7bab4653/uploads/origins/4e5e8746-d238-4d7e-8ff3-03c04380ea94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=439c49d08a5a0138d65541741182cedb 2x, https://si.imgix.net/7bab4653/uploads/origins/4e5e8746-d238-4d7e-8ff3-03c04380ea94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7659513910030acf226aa5cc501057ec 3x"}, "body": "おけちょさん宅の(@okecho_sosaku)干灰真乃矢くんと、拙宅の日隠小鹿のcp『まのころ』を描いていただきたくて、依頼に参りました！\n\n幼少期に周囲から「目が怖い」「可愛げがない」と暴言や陰口を浴びせられたことで、表情が上手く動かなくなり、仮面で顔を隠すようになった真乃矢くん。\n小鹿と仲を深めていく中で、『僕はずいぶん取るに足らないことを拾い集めて悩んでいたんだな』と考え方が変わっていき、今では仮面を付けずに歩けるようになりました。\n\n幼少期に、通り魔から身を呈して弟を守り、刃物で傷つけられたことで盲目となり、今も顔半分に大きな傷跡がある小鹿。\n誰に対してもあっけらかんと笑う、明朗快活な性格をしていますが、謂れなき中傷や陰口、逆に『理想のお兄ちゃん』として記者に追い回されるなど、その影にある悲しみもを拾い上げた上で、そばにいてくれる真乃矢くんの存在に支えられていました。\n\n真乃矢くんも小鹿も『一人でも息は出来るけど、貴方のそばは息がしやすい』という感覚を互いに抱いており、恋人、仕事の上ではパートナーとして今日も仲良く一緒に暮らしています。\n\n\n描いていただきたいのは\n\n嬉しくても悲しくても、感動しても泣く真乃矢くん。\n最近になって、自分がどうも泣き虫になってしまったように思う真乃矢くんと、そんな真乃矢くんを抱きしめて頭を撫で \n\n「泣いていいんだよ。それは君の心が豊かな証だ」 \n\nと伝えて、愛おしそうに微笑む小鹿。\nそんな小鹿を見て、『嗚呼、泣けるのはそう言ってくれる小鹿さんが居るからだ。小鹿さんが忘れかけてた僕の心を引き出したんだ』と気づいて、小鹿に抱きついたまま安心して泣く真乃矢くん\n\nという内容です。\nまた、個人で楽しむ用(収益が発生しない)のアンソロジーコミックを作る際に、収録させていただけたらと思います。\n大丈夫そうでしたら、ぜひよろしくお願い致します……！\n\nhttps://drive.google.com/drive/folders/11dQo7gcLI1LYwhGQjeDgjMx_OnlBrsVh", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dardanus_RK/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2764631, "client_id": 2670845, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48917a80/uploads/origins/48b425e2-8c93-470b-a340-62b87103bffd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b391d0ea1e9e47553594ea14b7899f8b", "srcset": "https://si.imgix.net/48917a80/uploads/origins/48b425e2-8c93-470b-a340-62b87103bffd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b391d0ea1e9e47553594ea14b7899f8b, https://si.imgix.net/48917a80/uploads/origins/48b425e2-8c93-470b-a340-62b87103bffd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e55452fafcc8d795ef75b66857eb13f 2x, https://si.imgix.net/48917a80/uploads/origins/48b425e2-8c93-470b-a340-62b87103bffd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9d23562945988adadf1584b7dad8272 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48917a80/uploads/origins/48b425e2-8c93-470b-a340-62b87103bffd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3da791046852be0488bf7122826aabbf", "srcset": "https://si.imgix.net/48917a80/uploads/origins/48b425e2-8c93-470b-a340-62b87103bffd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3da791046852be0488bf7122826aabbf, https://si.imgix.net/48917a80/uploads/origins/48b425e2-8c93-470b-a340-62b87103bffd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec917aeb34fb3136364a0e1fb765574b 2x, https://si.imgix.net/48917a80/uploads/origins/48b425e2-8c93-470b-a340-62b87103bffd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a3b9bfcd3b00b8a97be033dadab7a384 3x"}, "body": "いつもお世話になっております！\nそめんさんに、世界観共有企画『きっとその腕に抱きとめて』に、ルクさん(@ RukuSousaku )と抱擁のペアを組んで出したコンビ、エリベルを描いていただきたくて、リクエストの門を叩きました……！\n\n天才肌で基本的になんでもできてしまうエリスくん。\n日常に刺激がないし、他人から妬まれやすく親しい友人と呼べるような存在もいなかったので、1年後に彼を妬んだ同級生の手によって、階段から突き落とされてエリスくんは死んでしまいます。\n\nしかし、死の回避はできないけれど、そこに至るまでを変えることはできると考えた天使、トラベルが言います。\n\n「愛され上手におなり」\n\n「勉強が出来るのも、スポーツが出来るのも、芸術に向き合う心も、全てが君のたゆみない努力の賜物だ。」\n\n「だが、妬みや僻みに犯された人間は、自分の都合のいいところしか見ずに、信じずに、君を攻撃するだろう。そんな時、もし君の味方をしてくれる者がいなかったらと思うと……私はそれがたまらなく悲しいのだよ」\n\n「顔の見えない天使で良ければ、君の一番の友達になろう」\n\nトラベルの言葉を胸に刻み、そうであろうと努めたエリスくん。\n1年後、亡くなる頃には彼の日常は充実しているし、周りに人もいて。\nそんな彼を妬んで突き落とした者は正しく裁かれ、エリスくんの死は在るべき形で悼まれました。\nトラベルもエリスくんの魂を導いて、1年前から計画していた革命と、そして天寿をまっとうしました。\nそうそう、どんなにたくさんの友人に囲まれても、エリスくんにとっての『1番の親友』はトラベルだったそうです。\n\n\nこれがエリベルの物語です。\nそめんさんに描いてほしいシチュエーションは\n\n夕焼けの差し込む部屋で、トラベルがクッションの上ですやすや眠っていて(顔の貼り紙は付けたままでお願いします)エリスくんは、トラベルの小さな手足や羽を見つめながら、こんなに小さな体に僕の運命も魂も背負っていくのか、トラベルは……と静かに考える。\n\nという内容です\n大丈夫そうでしたら、ぜひよろしくお願い致します🙏\n\nhttps://drive.google.com/drive/folders/1-GTjxP1hEzjSOhA82DAO8HDv9Tg1ZRbn", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dardanus_RK/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2764631, "client_id": 300145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42ee8b75/uploads/origins/552fab35-dff5-4b35-8c5a-b0c86e637f0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff6df61fd521381a1725b899cd135eda", "srcset": "https://si.imgix.net/42ee8b75/uploads/origins/552fab35-dff5-4b35-8c5a-b0c86e637f0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff6df61fd521381a