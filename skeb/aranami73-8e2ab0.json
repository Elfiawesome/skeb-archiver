00&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02520d27b48ae6c751b6f39bdcb65ccc 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2519032, "client_id": 577395, "nc": 32}, {"path": "/@aranami73/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2519032, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1fbc1754/uploads/origins/cced114c-4422-413c-9580-cc71483da43b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d6318c3e55687cb8df6c1fa95d0f6e9", "srcset": "https://si.imgix.net/1fbc1754/uploads/origins/cced114c-4422-413c-9580-cc71483da43b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d6318c3e55687cb8df6c1fa95d0f6e9, https://si.imgix.net/1fbc1754/uploads/origins/cced114c-4422-413c-9580-cc71483da43b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b9cfcf9e55491d0e56cf1ea70488252 2x, https://si.imgix.net/1fbc1754/uploads/origins/cced114c-4422-413c-9580-cc71483da43b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb16061563744510784010ca9b9b784a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1fbc1754/uploads/origins/cced114c-4422-413c-9580-cc71483da43b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0cef983507eb535ed7d54c1cc5fdef8", "srcset": "https://si.imgix.net/1fbc1754/uploads/origins/cced114c-4422-413c-9580-cc71483da43b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0cef983507eb535ed7d54c1cc5fdef8, https://si.imgix.net/1fbc1754/uploads/origins/cced114c-4422-413c-9580-cc71483da43b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5670218240bd95a0a396c06ef6c050f8 2x, https://si.imgix.net/1fbc1754/uploads/origins/cced114c-4422-413c-9580-cc71483da43b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a036fabc5bdae413c6af3b5544ef9ca 3x"}, "body": "こんにちは。\n以前リクエストさせて頂いたぐだ子とカドックの漫画が素晴らしかったので、同じく1ページ2コマの白黒の漫画をリクエストさせてください。\n\n【設定】\nぐだ子とカドックがネロ陛下の宝具「招き揺蕩う黄金劇場」の亜種である「麻雀でどちらかが勝たないと出られない部屋(内装の見た目はぐだ子のマイルームのイメージです)」にうっかり閉じ込められてしまい、その部屋では「麻雀を打ち、だれかの点棒を0にすればみんな出られる」という制約があるため二人は部屋を出るために麻雀を打っています(自動卓ではなく手積みの麻雀のイメージです)。ただ、カドックは麻雀のルールを知らないためぐだ子に教わっているのですが、その際に「麻雀というゲームは対戦相手に振り込んだりツモられたら服を脱がなければならない恐ろしいゲーム」という間違ったルールをぐだ子に吹き込まれています(部屋のルールとしては誰かが勝てば二人とも出られるので特に誰かが脱ぐ必要はありません)\n\n【状態】\n(※1コマ目はカドックに複数回振り込んだぐだ子が服を脱ぎ、パンツとブラしか残ってない状態で背中を向けており、恥ずかしそうに首だけ振り向いて「もう絶対負けない」とカドックに宣言しています。\nhttps://www.nicovideo.jp/watch/sm147965\n↑上記動画の1分20秒～のイメージです。)\n(※2コマ目はカドック(1回だけ振り込み上着だけ脱いでいるイメージ)がぐだ子のあられもない姿を見てしまっていることを謝りながらお互い部屋を出るためにやむを得ずゲームを続けようとするカドックをお願いいたします。カドックは内心「本当自力でアガれているのか(ぐだ子がわざと振り込んでいるのではないか)」ということや「そもそもこの麻雀というゲームは負けたら服を脱がなければいけないのは本当なのか」を疑いだしてるイメージです)\n(※また、可能であれば1コマ目か2コマ目に余った麻雀牌で遊ぶコンを入れていただけると幸いです。)\n(※その他の細かい部分は適宜補足して頂いて問題ございません)\n\nご検討の程、よろしくお願いいたします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aranami73/works/19", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b2ab5427/uploads/origins/a8d51ae4-99df-47fe-8f96-608412badf2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d194e0c65175af1fc471320abe3bc4ab", "srcset": "https://si.imgix.net/b2ab5427/uploads/origins/a8d51ae4-99df-47fe-8f96-608412badf2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d194e0c65175af1fc471320abe3bc4ab, https://si.imgix.net/b2ab5427/uploads/origins/a8d51ae4-99df-47fe-8f96-608412badf2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FF