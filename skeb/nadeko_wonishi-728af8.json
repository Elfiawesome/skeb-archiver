n塚本さんにお任せできればと存じますので、自由に制作いただけましたら幸いです。\n塚本さんの作品の世界観、色彩、心を掴まれるような人物たちの表情が\n大好きなので、是非このリクエストにてまた新たな作品が見られたらと存じます！\n\n長文にて失礼いたしました。何卒よろしくお願いいたします。", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 2311924, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "光璃☆", "screen_name": "Hikari__Rp_", "avatar_url": "https://pbs.twimg.com/profile_images/1858533988534784000/4kd6qlWD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1302455119838019585/1648016150/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 2835819, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "桃香", "screen_name": "Touka_dassen", "avatar_url": "https://pbs.twimg.com/profile_images/1284893229406552064/29elNx7Z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1284435846549041152/1601806974/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 1}, {"id": 3175638, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "西荻窪 しおこ🐶🏖️", "screen_name": "nsogkbshioko", "avatar_url": "https://pbs.twimg.com/profile_images/1757372797616377856/v7zBUKwA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1683736725481455617/1722857991/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_day