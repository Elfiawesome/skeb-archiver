でお願いします。最初の依頼ということで服装は魔法少女服としてください。構図はお任せしますが、営業スマイルを取っているものとしてください。\n以上よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kerina_utsurini/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3322979, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/79beda06/uploads/origins/56f9b454-30b1-425b-b4a1-e2b4bed38d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36cdcdc7a0a91f85253a81a8c05c8d92", "srcset": "https://si.imgix.net/79beda06/uploads/origins/56f9b454-30b1-425b-b4a1-e2b4bed38d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36cdcdc7a0a91f85253a81a8c05c8d92, https://si.imgix.net/79beda06/uploads/origins/56f9b454-30b1-425b-b4a1-e2b4bed38d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad6c0c10b4924a2df9ddff1bd663dabf 2x, https://si.imgix.net/79beda06/uploads/origins/56f9b454-30b1-425b-b4a1-e2b4bed38d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7336259477985393075f5f94ba0fad9d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/79beda06/uploads/origins/56f9b454-30b1-425b-b4a1-e2b4bed38d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=419f423652008e5f0265211c63936aac", "srcset": "https://si.imgix.net/79beda06/uploads/origins/56f9b454-30b1-425b-b4a1-e2b4bed38d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=419f423652008e5f0265211c63936aac, https://si.imgix.net/79beda06/uploads/origins/56f9b454-30b1-425b-b4a1-e2b4bed38d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=22f70e8ce60086a0ae275359b022c7ae 2x, https://si.imgix.net/79beda06/uploads/origins/56f9b454-30b1-425b-b4a1-e2b4bed38d0a?bg=%23fff&auto=format%2Ccompress&fm=