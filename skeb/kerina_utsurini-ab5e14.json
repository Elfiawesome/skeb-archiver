//si.imgix.net/971aa7db/uploads/origins/1cc71216-5f2e-4a88-b210-8fd5ff676a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55638280baf98eab632886b12559fbf9, https://si.imgix.net/971aa7db/uploads/origins/1cc71216-5f2e-4a88-b210-8fd5ff676a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6f5f2493359e3b6362660079272d977 2x, https://si.imgix.net/971aa7db/uploads/origins/1cc71216-5f2e-4a88-b210-8fd5ff676a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33aa90e611b57cd1e2da208daa339ef3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/971aa7db/uploads/origins/1cc71216-5f2e-4a88-b210-8fd5ff676a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=860f8eabe8502f1e6b2fd684b4712911", "srcset": "https://si.imgix.net/971aa7db/uploads/origins/1cc71216-5f2e-4a88-b210-8fd5ff676a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=860f8eabe8502f1e6b2fd684b4712911, https://si.imgix.net/971aa7db/uploads/origins/1cc71216-5f2e-4a88-b210-8fd5ff676a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4aec015c7f344137e9e9a85163603043 2x, https://si.imgix.net/971aa7db/uploads/origins/1cc71216-5f2e-4a88-b210-8fd5ff676a0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c039d6b86e0d6b311fb629064baf915d 3x"}, "body": "こんにちは、私の創作漫画のキャラをお願いします。\n男キャラか女キャラどちらか一人を選んでお描きください。\n\n■女キャラの場合\n「桜（サクラ）」を描いてください。\n\n前髪は目が隠れるぐらい長いが頭の上で結んでおでこを出してもどっちでも可です。\n衣装はカスタマイズしてもらってもかまいません。\n\nビジュアルの資料は以下です↓\nhttps://twitter.com/SakumaGinmaru/status/1574735461817659393\n\nこのキャラが出てくる漫画の回は以下です↓\nhttps://manga-no.com/episodes/105b36c1baf95ef6064\n※読まなくてもどちらでもよいですがどんなキャラなのかの参考に必要でしたらどうぞ。\n\n■男キャラの場合\n十七夜（かなぎ）を描いてください。\n\nキャラの特徴↓\nふわふわ金髪ロン毛で後ろで軽く結っている、三白眼、ギザ歯、右頬に傷、右腕がない、やせ型\n\nキャラの三面図資料の載っているページ↓\nhttps://sakuma-ginmaru.fanbox.cc/posts/3600156\n\n悪い表情でかっこよく描いてもらえると嬉しいです。\n細かいシチュエーションは申し訳ないのですが思いつかないのでお任せします。\n羽織や細かい装飾は大変そうなら省略しても大丈夫です。\n\n−−−−−−−−\n\n描いて頂いたイラストは自分のブログ等に掲載させていただく場合があります。\n\nどうぞよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kerina_utsurini/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3322979, "client_id": 328819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a71ba83e/uploads/origins/8e4220d9-1599-4209-97ca-fe7ade188494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c343fe4bdbefd238d28726aeec8cbd40", "srcset": "https://si.imgix.net/a71ba83e/uploads/origins/8e4220d9-1599-4209-97ca-fe7ade188494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c343fe4bdbefd238d28726aeec8cbd40, https://si.imgix.net/a71ba83e/uploads/origins/8e4220d9-1599-4209-97ca-fe7ade188494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46d04d3d1aef674e2126b0ee7beed8af 2x, https://si.imgix.net/a71ba83e/uploads/origins/8e4220d9-1599-4209-97ca-fe7ade188494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b49581877b9ecb4883705523e8ee4642 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a71ba83e/uploads/origins/8e4220d9-1599-4209-97ca-fe7ade188494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85734069e6f8f0726253d527c00f47e7", "srcset": "https://si.imgix.net/a71ba83e/uploads/origins/8e4220d9-1599-4209-97ca-fe7ade188494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85734069e6f8f0726253d527c00f47e7, https://si.imgix.net/a71ba83e/uploads/origins/8e4220d9-1599-4209-97ca-fe7ade188494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=637f8ee914e052bc2d6c966957de3b27 2x, https://si.imgix.net/a71ba83e/uploads/origins/8e4220d9-1599-4209-97ca-fe7ade188494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9875eb7c8a872e3c4ba631e34ed3c6d2 3x"}, "body": "先日はアピール及び素敵な八雲みたまさんのイラストをありがとうございました。背景やラフも合わせた沢山のイラストを1日で手掛けてくださり、非常に感謝すると共にいろんな面で感心しました。他にも多くの方からリクエストを受けている中恐縮ですが、再びリクエストいたします。\n先日はみたまさんのイラストをリクエストしましたので、今回は大東区の魔法少女繋がりかつみたまさんの幼馴染の和泉十七夜のイラストをお願いします。魔法少女姿で鞭を構えながらドヤ顔を決めているという構図が希望です。背景は以前のみたまさんのものほど凝ったものにしなくて構いませんが、星空やスポットライトなどけりな様の思うかっこよさが出せるものであればと思います。勿論上記の「星空やスポットライト」はあくまで例なのでそれ以外のものでも構いません。\n以上よろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kerina_utsurini/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3322979, "client_id": 2431410, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/763785d9/uploads/origins/e5899657-a53e-4ec4-b626-3f1db10faf47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbd1f1882928f414ae0201e003ee8885", "srcset": "https://si.imgix.net/763785d9/uploads/origins/e5899657-a53e-4ec4-b626-3f1db10faf47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbd1f1882928f414ae0201e003ee8885, https://si.imgix.net/763785d9/uploads/origins/e5899657-a53e-4ec4-b626-3f1db10faf47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=616ec2d80611fcea803e6178e9c4955d 2x, https://si.imgix.net/763785d9/uploads/origins/e5899657-a53e-4ec4-b626-3f1db10faf47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98d176e64ebbcbfdbf8e11367ae796bc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/763785d9/uploads/origins/e5899657-a53e-4ec4-b626-3f1db10faf47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a26f2708a5e8cb713339edf47a64dc64", "srcset": "https://si.imgix.net/763785d9/uploads/origins/e5899657-a53e-4ec4-b626-3f1db10faf47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a26f2708a5e8cb713339edf47a64dc64, https://si.imgix.net/763785d9/uploads/origins/e5899657-a53e-4ec4-b626-3f1db10faf47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d4b8f2aaa91939b5341d67887df845f9 2x, https://si.imgix.net/763785d9/uploads/origins/e5899657-a53e-4ec4-b626-3f1db10faf47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=968b74049a7a9da0f2c4654a318918a8 3x"}, "body": "獣三郎です。リヴィアさんの件はありがとうございました。今のうちにもう一度、挿絵の依頼をします。\n佐鳥かごめちゃんの足粘着をお願いします。ただし、今度は不思議の国のアリスのエプロンドレスコスチュームを着た状態でお願いします。魔女が作り出した不思議の国のアリスの世界を模した結界に意識だけを取り込まれ、そこでアリスを演じさせられ、足をネバネバにされるという設定です。ネバネバが絡みつく範囲は靴底までですが、ネバネバの色は茶色でお願いします。それと、エプロンドレスのスカートを短めにお願いします。衣装チェンジという難易度が高いイラストですが、よろしくお願いします。それと、今度は資料をお送りしますので、構図の参考にして下さい。\n\nhttps://x.com/Jyouzabrou/status/1727299809915310567/photo/1", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kerina_utsurini/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3322979, "client_id": 3326153, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/851a99de/uploads/origins/4c10d14e-9213-4b54-aeda-4ad48e7fbb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3adf5fd808af296572946e1f5e9077b6", "srcset": "https://si.imgix.net/851a99de/uploads/origins/4c10d14e-9213-4b54-aeda-4ad48e7fbb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3adf5fd808af296572946e1f5e9077b6, https://si.imgix.net/851a99de/uploads/origins/4c10d14e-9213-4b54-aeda-4ad48e7fbb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b94a8030baa324a35142439346d8f1f 2x, https://si.imgix.net/851a99de/uploads/origins/4c10d14e-9213-4b54-aeda-4ad48e7fbb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e40a5431dae9fbf581d74ac35d3784b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/851a99de/uploads/origins/4c10d14e-9213-4b54-aeda-4ad48e7fbb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82036e37420b4c270910ac98f3c0b6c9", "srcset": "https://si.imgix.net/851a99de/uploads/origins/4c10d14e-9213-4b54-aeda-4ad48e7fbb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82036e37420b4c270910ac98f3c0b6c9, https://si.imgix.net/851a99de/uploads/origins/4c10d14e-9213-4b54-aeda-4ad48e7fbb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d11ef1c301cf7ec1f354257e4bdbd6fc 2x, https://si.imgix.net/851a99de/uploads/origins/4c10d14e-9213-4b54-aeda-4ad48e7fbb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d135b8286714a83e4c52bf0e6d0e687d 3x"}, "body": "凄くふざけた注文ですが、\n背景に気合いの入った筆文字で\n「愛の心にて　悪しき空間を断つ」\nと書かれ、「超獣機神ダンクーガ」に登場する武器「断空剣」を勇者パースで鬼気迫る表情で構える∞いろはを描いて頂きたいです！\n背景は可能ならば鏡の魔女の結界にして頂ければ更によろしいのですが、けりな氏の好きにして構いません。\n自分の趣味がふんだんに入った注文ですが、どうか宜しくお願いします！\n\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRhgaKkYic2N2m_C2Yp8TyzAva_11CZG3CiqPSV6QfKTbILvQtJsoBYhfw&s=10", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kerina_utsurini/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3322979, "client_id": 2431410, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/529b8177/uploads/origins/dfa849fd-9692-4f05-b5ac-56f47314114c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=191876c02801749a1a34a6063e8e4c1b", "srcset": "https://si.imgix.net/529b8177/uploads/origins/dfa849fd-9692-4f05-b5ac-56f47314114c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=191876c02801749a1a34a6063e8e4c1b, https://si.imgix.net/529b8177/uploads/origins/dfa849fd-9692-4f05-b5ac-56f47314114c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09d06690202506d38e8515538bd20039 2x, https://si.imgix.net/529b8177/uploads/origins/dfa849fd-9692-4f05-b5ac-56f47314114c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=464a6ab9dad29b0e9674e1b9b9a51590 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/529b8177/uploads/origins/dfa849fd-9692-4f05-b5ac-56f47314114c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7340d7a8da208a518810f68db0ff475", "srcset": "https://si.imgix.net/529b8177/uploads/origins/dfa849fd-9692-4f05-b5ac-56f47314114c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7340d7a8da208a518810f68db0ff475, https://si.imgix.net/529b8177/uploads/origins/dfa849fd-9692-4f05-b5ac-56f47314114c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4029ef777dcdf8e9e2fa1f436e6bece0 2x, https://si.imgix.net/529b8177/uploads/origins/dfa849fd-9692-4f05-b5ac-56f47314114c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=079a8cd21dca22f39f0a5e10796a0347 3x"}, "body": "初めまして、獣三郎と申します。マギレコのキャラの依頼を受けておられるとの事で、私の小説の挿し絵を描いて頂きたく、参上致しました。\nご依頼するのは、リヴィアさんのイラストです。ピンク色のトリモチを踏んで、その上で足踏みをしているリヴィアさんのイラストをお願いします。調整の技術を悪用し、様々な魔法少女の魔法を改悪して回っている呪い屋と呼ばれる魔法少女に、リヴィアさんが変身の解除が不可能になり、靴底からネバネバが出てくる上に、解除しようとするとその動作が足踏みに変換されるという呪いを掛けられてしまうというシチュエーションです。つまり、リヴィアさんは呪いを解こうとしているのに、それが出来ずに足踏みしてしまっている状況なのです。なので、リヴィアさんは顔を赤くして、悔しがっている表情にして下さい。衣装は変身後で、ネバネバが絡み付いている範囲は靴底までです。それと、完成品を挿し絵として掲載する許可をお願いします。\n長々とリクエストしましたが、よろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kerina_utsurini/works/2", "private_thumbnail_image_urls": null, "private": fal