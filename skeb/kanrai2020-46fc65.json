=114f01271ee45ccc1dd570a119b4fcf7, https://si.imgix.net/a6386643/uploads/origins/baf64981-ebad-4259-84b2-86a57a513a00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bac5f49e36be1cec643f4f0b970a9e7 2x, https://si.imgix.net/a6386643/uploads/origins/baf64981-ebad-4259-84b2-86a57a513a00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13269c96691bc8813694e29052d42fe7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6386643/uploads/origins/baf64981-ebad-4259-84b2-86a57a513a00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7adf45db8699cee1fa610099a0f3c30", "srcset": "https://si.imgix.net/a6386643/uploads/origins/baf64981-ebad-4259-84b2-86a57a513a00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7adf45db8699cee1fa610099a0f3c30, https://si.imgix.net/a6386643/uploads/origins/baf64981-ebad-4259-84b2-86a57a513a00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=20b7b5c2d656a685835cef53100c7144 2x, https://si.imgix.net/a6386643/uploads/origins/baf64981-ebad-4259-84b2-86a57a513a00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f259688409bcf3303d0d402fcc10face 3x"}, "body": "こんにちは、「斗真くん」の3コマグレイスケールコミックをお願いしたいのですが。\n\nシナリオは、彼が田舎の実家に遊びに来ている。母親が近所のヒキコモリのために弁当を作る。母親は忙しくて配達に行けないので、真斗くんに配達を頼む。真斗真くんが家に着くと、玄関には誰もいなかったので、真斗真くんは中に入り、直接ヒキコモリの部屋に配達に行く。ヒキコモリは30歳のぽっちゃりオタク。\n\nコマ目、実家で入浴中。母親がドアをノックし、「近所の家に配達に行ってもいい？彼は承諾する。\n\nコマ目、隣の家のドアをノックする。聞こえるかな？  斗真くんは、お風呂から少し透けて見える白いTシャツ、ジーンズ、サンダルを履いている。\n\nコマ目、オタクの部屋での視点。真斗くんは、母さんが作ってくれたんだよ、と言う。真斗くんは不快な笑みを浮かべながら、ここは臭いと心の中で思っている！\n\n編集はご自由にどうぞ。ありがとうございました。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kanrai2020/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creat