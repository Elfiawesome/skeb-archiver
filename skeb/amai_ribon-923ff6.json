幸いです。\n\n何卒ご検討よろしくお願いします。 \n\nもし条件に合わない場合はキャンセルor再送での差し戻しで願います。\n\nhttps://photos.app.goo.gl/cWqFHqjMPNttcSgc7", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amai_ribon/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d25969d9/uploads/origins/4a9a341c-e69a-40a8-bda9-779a845ba3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aacfb9fd209443e6f2c1f789d550f960", "srcset": "https://si.imgix.net/d25969d9/uploads/origins/4a9a341c-e69a-40a8-bda9-779a845ba3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aacfb9fd209443e6f2c1f789d550f960, https://si.imgix.net/d25969d9/uploads/origins/4a9a341c-e69a-40a8-bda9-779a845ba3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cee7f721cbe22323b49abefe2b59d0ba 2x, https://si.imgix.net/d25969d9/uploads/origins/4a9a341c-e69a-40a8-bda9-779a845ba3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5467721ddef4c3bab43cea5fee5941e 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3612537, "client_id": 3742881, "nc": 145}, {"path": "/@amai_ribon/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3612537, "client_id": 2986862, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23ac2327/uploads/origins/38547acb-9e85-448c-be45-2c60112b1a09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ed696e94139be9cac56943882a1048d", "srcset": "https://si.imgix.net/23ac2327/uploads/origins/38547acb-9e85-448c-be45-2c60112b1a09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ed696e94139be9cac56943882a1048d, https://si.imgix.net/23ac2327/uploads/origins/38547acb-9e85-448c-be45-2c60112b1a09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b12a649091c13e0bdfcf16eddab48780 2x, https://si.imgix.net/23ac2327/uploads/origins/38547acb-9e85-448c-be45-2c60112b1a09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ebeb77582afef768bc9810abcd35fc7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23ac2327/uploads/origins/38547acb-9e85-448c-be45-2c60112b1a09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb2ba22b2ab25a6e41d26ae1c77a439d", "srcset": "https://si.imgix.net/23ac2327/uploads/origins/38547acb-9e85-448c-be45-2c60112b1a09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb2ba22b2ab25a6e41d26ae1c77a439d, https://si.imgix.net/23ac2327/uploads/origins/38547acb-9e85-448c-be45-2c60112b1a09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=42c6db277164f57361fcef141388d637 2x, https://si.imgix.net/23ac2327/uploads/origins/38547acb-9e85-448c-be45-2c60112b1a09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d0856a21d19c743dfe92bab5831f7f67 3x"}, "body": "はじめまして。\n\n以前からXの方で、あまいりぼん様のイラストを拝見させて頂いているのですが、スイーツを絡めた女の子のイラストが、凄くかわいいなと感じておりました。\n\n特に、ウインクをしながら笑顔になっている女の子がかわいいと思っているのですが、もしよければ、私のオリジナルキャラクターである魔女っ子も、そんなふうに描いては頂けないかと思い、この度、リクエストを送った次第です。\n\nまず、こちらが、私のオリジナルキャラクターのプロフィールとなります。\n\n\nプロフィール\n名前︰シクティス\n年齢︰12歳\n性別︰女\n性格︰優しくおとなしい\n備考︰黒髪おかっぱ頭の魔女。\n服装は黒い普段着、白い夏服の2種類があり、黒服の方はわかりにくいですがベルトをしています。\n\n\nシチュエーションとしましては、下記のような感じで描いて頂けると嬉しいです。\n\n・魔法のステッキを振って、お菓子を出している所。\n・この時の表情が、ウインクをした笑顔で。\n・お菓子は、クッキーやキャンディー、チョコレートなど、洋菓子を中心に。\n\n\nあとの細かいイラストの雰囲気などは、作者さまの判断におまかせしたいと思います。\nよければリクエストを受けて下さる形で結構ですので、宜しくお願い致します。\n\n\n※私のオリジナルキャラクターの資料は、URLの方を参照して下さい。\n※服装は、黒服と白服の2種類が存在しますが、どちらで描いて頂いても構いません。\n※魔法のステッキは、先端に☆がついただけの簡単なものを想定していますが、デザインはおまかせ致します。\n\nhttps://auto.hanabie.com/sictes-kettei.html", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amai_ribon/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3612537, "client_id": 3273322, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac7a4023/uploads/origins/ae4bea1c-0791-4d0b-9245-556a0a935da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b96b080c05e18718b3793121fae14e8", "srcset": "https://si.imgix.net/ac7a4023/uploads/origins/ae4bea1c-0791-4d0b-9245-556a0a935da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b96b080c05e18718b3793121fae14e8, https://si.imgix.net/ac7a4023/uploads/origins/ae4bea1c-0791-4d0b-9245-556a0a935da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=747ccdef14c41530f909e3e797b20810 2x, https://si.imgix.net/ac7a4023/uploads/origins/ae4bea1c-0791-4d0b-9245-556a0a935da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e24cc29568a2dcecd2f04e7115143354 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac7a4023/uploads/origins/ae4bea1c-0791-4d0b-9245-556a0a935da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f5398a14e3fbc3acbded3af3fc57c4a", "srcset": "https://si.imgix.net/ac7a4023/uploads/origins/ae4bea1c-0791-4d0b-9245-556a0a935da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f5398a14e3fbc3acbded3af3fc57c4a, https://si.imgix.net/ac7a4023/uploads/origins/ae4bea1c-0791-4d0b-9245-556a0a935da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=