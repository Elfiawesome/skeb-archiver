す。\n◼︎絵を描いたり、手紙を書くのが趣味です。\n◼︎レターセット、インク、コスメ（特にチークブラッシュ）、ボードゲーム、宝石やアクセサリーの収集癖があります。\n\n\n何卒よろしくお願いします！  \nhttps://lit.link/eat_lots_of_ebi\n\nhttps://drive.google.com/drive/folders/1hC2xKLRt58fQTfpTEgJSEY7jvBSnrPf5", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aurivia_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4113887, "client_id": 1040618, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3082651/uploads/origins/6726564d-1e46-4df9-82b9-96139d6f122e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53927a44a6565dd8fad4bacd5eafd062", "srcset": "https://si.imgix.net/b3082651/uploads/origins/6726564d-1e46-4df9-82b9-96139d6f122e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53927a44a6565dd8fad4bacd5eafd062, https://si.imgix.net/b3082651/uploads/origins/6726564d-1e46-4df9-82b9-96139d6f122e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1e13cb2e0d235b387c7cad489d60c53 2x, https://si.imgix.net/b3082651/uploads/origins/6726564d-1e46-4df9-82b9-96139d6f122e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88b527eea357f12f65eaced1fc84d30e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3082651/uploads/origins/6726564d-1e46-4df9-82b9-96139d6f122e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b5521fdd42a6f14e79f04e76dce2b6", "srcset": "https://si.imgix.net/b3082651/uploads/origins/6726564d-1e46-4df9-82b9-96139d6f122e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b5521fdd42a6f14e79f04e76dce2b6, https://si.imgix.net/b3082651/uploads/origins/6726564d-1e46-4df9-82b9-96139d6f122e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a22bd78b641