fm=webp&fit=crop&crop=top&w=200&h=200&s=aa6c295f27ecc68886618d40cdc84dd4, https://si.imgix.net/48f39ba2/uploads/origins/ecc66d12-dc21-4452-a80b-82b06318fb57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0af18f85f0201a01d36b3bbddc7087f1 2x, https://si.imgix.net/48f39ba2/uploads/origins/ecc66d12-dc21-4452-a80b-82b06318fb57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=741617e16cca077c9588d54ac8950528 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48f39ba2/uploads/origins/ecc66d12-dc21-4452-a80b-82b06318fb57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be2927947341b13f55ea50e3829b6ce2", "srcset": "https://si.imgix.net/48f39ba2/uploads/origins/ecc66d12-dc21-4452-a80b-82b06318fb57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be2927947341b13f55ea50e3829b6ce2, https://si.imgix.net/48f39ba2/uploads/origins/ecc66d12-dc21-4452-a80b-82b06318fb57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=030f0f784eb16deaf268b305724b611c 2x, https://si.imgix.net/48f39ba2/uploads/origins/ecc66d12-dc21-4452-a80b-82b06318fb57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dce7c54ee73de3239f9a9340920dcea9 3x"}, "body": "ねむ先生初めまして❕krk(くるく）と申します。\nねむ先生の描かれる造形美の象徴のような、ステントグラスのような美しい色使いとお顔立ちのイラストが大好きで…❕（特にネプリ③の🐙さんとっても好きです🥲🤍🤍）もし可能であればうちの子を描いていただきたく、リクエスト失礼致します。\n\n【キャラクター詳細】\n性別▷女性\n年齢▷本人も覚えていない(600〜700歳程度)\n身長▷160〜165cm\n外見▷淡い水色の髪、ピンク色の目（上部分の灰色はお好みで）、水色まつ毛（忘れないようご注意ください）、緩い天然パーマの三つ編み、毛先が魚の尾ひれのようになっています。\nこちらからみて左側の横髪は巻き髪\nMBTI▷INFP\n\n長い歳月を生きる魔女で、感情表現に乏しいです。（無表情が多い）」\n基本的にどんな魔法でも使えます❕時空を超えることも瞬間移動だってできるのが魔女です❕\n蝶と雨が好きで、よく水でてきた蝶を魔法で作って遊んでいます。\n\n花、蝶、水、海、珊瑚、water core、mermaid coreなどが似合います❕(無視していただいて大丈夫です)\nイメージソングをまとめたプレイリストを添付させていたきます。よろしければご活用ください。\nhttps://youtube.com/playlist?list=PLSVCShTbzebs7SARuwU-4Mt2Xl9YKFfx2&si=smkBLvgJJ4mMTRNL\n\n【リクエスト内容】\n構図、表情、衣装等全ておまかせいたします❕ねむ先生の好きなように描いていただけたら嬉しいです。衣装はフォルダ内の衣装でも、好きな服を着せていただいても大丈夫です。\nNG▷血の描写\n\n【ファイル形式】\nサインや人物、背景などをレイヤー分けしたPSDファイルで頂けますと嬉しです。\n\n【使用用途】\n・アイコン、ヘッダー等SNSでの利用\n・グッズ化(商用利用、譲渡等一切無しの個人鑑賞用)\n不可の場合はお手数ですが別レイヤーに記載していただけますと幸いです。\n\nどうぞよろしくお願いします❕\n\nhttps://drive.google.com/drive/folders/1-OpOdEaRlO_ToamWMXj8-ZRF2Jt9J_f2", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@haya0205_0/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3536333, "client_id": 2610173, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b3dcca3/uploads/origins/29cbe078-ae88-412d-aaac-15f376e9ab4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=971c2979cb2b6b3d43505ef24fc31238", "srcset": "https://si.imgix.net/8b3dcca3/uploads/origins/29cbe078-ae88-412d-aaac-15f376e9ab4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=971c2979cb2b6b3d43505ef24fc31238, https://si.imgix.net/8b3dcca3/uploads/origins/29cbe078-ae88-412d-aaac-15f376e9ab4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e983626d4bd4da0e3047a250042eddc4 2x, https://si.imgix.net/8b3dcca3/uploads/origins/29cbe078-ae88-412d-aaac-15f376e9ab4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c29d060a14708ee4e6ddbf6df7b8f5a6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b3dcca3/uploads/origins/29cbe078-ae88-412d-aaac-15f376e9ab4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02c2ede6e0f1fd0dc0a1590f8a0e175c", "srcset": "https://si.imgix.net/8b3dcca3/uploads/origins/29cbe078-ae88-412d-aaac-15f376e9ab4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02c2ede6e0f1fd0dc0a1590f8a0e175c, https://si.imgix.net/