ります。\nまた、もし可能であれば、自身のSNSやブログ等の発信活動での使用の許可を頂けると幸いです（クレジット表記は必ず行います）。\n\nhttps://drive.google.com/drive/folders/17v1Uo2yRQFcr6muLsuues8I06IWonPuJ?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@migiwa312/works/67", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2172456, "client_id": 2856859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6482a25/uploads/origins/a27b1e68-f1a1-401d-8657-59f0df14a0da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b77f4d0aaf763fc163e4061888794b91", "srcset": "https://si.imgix.net/c6482a25/uploads/origins/a27b1e68-f1a1-401d-8657-59f0df14a0da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b77f4d0aaf763fc163e4061888794b91, https://si.imgix.net/c6482a25/uploads/origins/a27b1e68-f1a1-401d-8657-59f0df14a0da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dee35145714d5abf00fa38ace68a29d0 2x, https://si.imgix.net/c6482a25/uploads/origins/a27b1e68-f1a1-401d-8657-59f0df14a0da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bccfb447c665bd02e613223e0b621939 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6482a25/uploads/origins/a27b1e68-f1a1-401d-8657-59f0df14a0da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a572329cb9e0e25ae221631d0da33b0f", "srcset": "https://si.imgix.net/c6482a25/uploads/origins/a27b1e68-f1a1-401d-8657-59f0df14a0da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a572329cb9e0e25ae221631d0da33b0f, https://si.imgix.net/c6482a25/uploads/origins/a27b1e68-f1a1-401d-8657-59f0df14a0da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b763ffc22a339ce3a43461fa48ff8db9 2x, https://si.