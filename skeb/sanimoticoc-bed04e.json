ipped": true, "creator_id": 592579, "client_id": 2434383, "nc": 128}, {"path": "/@sanimoticoc/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 592579, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/986d1fb6/uploads/origins/ca83122d-e894-4821-a3ac-da51dd3dda92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d155bb8b11593108264328a1c5aecf1", "srcset": "https://si.imgix.net/986d1fb6/uploads/origins/ca83122d-e894-4821-a3ac-da51dd3dda92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d155bb8b11593108264328a1c5aecf1, https://si.imgix.net/986d1fb6/uploads/origins/ca83122d-e894-4821-a3ac-da51dd3dda92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b4d140b7631255a132e83a16e929074 2x, https://si.imgix.net/986d1fb6/uploads/origins/ca83122d-e894-4821-a3ac-da51dd3dda92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b17592543d6d03a136c924d05f09adf4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/986d1fb6/uploads/origins/ca83122d-e894-4821-a3ac-da51dd3dda92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92eeaa7181c965c61d68ed3dfb6099b1", "srcset": "https://si.imgix.net/986d1fb6/uploads/origins/ca83122d-e894-4821-a3ac-da51dd3dda92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92eeaa7181c965c61d68ed3dfb6099b1, https://si.imgix.net/986d1fb6/uploads/origins/ca83122d-e894-4821-a3ac-da51dd3dda92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d12a2adfad90428a15880d30077915d4 2x, https://si.imgix.net/986d1fb6/uploads/origins/ca83122d-e894-4821-a3ac-da51dd3dda92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7ee12cce74814213411fffbf3ddfef37 3x"}, "body": "こんにちは、あなたの絵がとても好きなので、イラストをお願いしたいです。キャラクターの詳細はDriveのフォルダにまとめておきました。落ち着いた雰囲気でお願いしたいので、具体的な内容は工夫していただいて構いません！キャラの服装は自由に変えてもらって構いません。\n\nhttps://drive.google.com/drive/folders/19krcYkA0_urYQkEfdPWsxeRf7f9GGYCL?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sanimoticoc/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 592579, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28ba6a5a/uploads/origins/8d32fd77-e81b-426c-b771-d9b692705864?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=053b8d20c37db6455af78be51aba1799", "srcset": "https://si.imgix.net/28ba6a5a/uploads/origins/8d32fd77-e81b-426c-b771-d9b692705864?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=053b8d20c37db6455af78be51aba1799, https://si.imgix.net/28ba6a5a/uploads/origins/8d32fd77-e81b-426c-b771-d9b692705864?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aefae6df70420e15ed7a6cfbf1bd56b7 2x, https://si.imgix.net/28ba6a5a/uploads/origins/8d32fd77-e81b-426c-b771-d9b692705864?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=922fc07083d0faddc227a879254365c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28ba6a5a/uploads/origins/8d32fd77-e81b-426c-b771-d9b692705864?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1a8cf2d80c2f0601080848f9c17b989", "srcset": "https://si.imgix.net/28ba6a5a/uploads/origins/8d32fd77-e81b-426c-b771-d9b692705864?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1a8cf2d80c2f0601080848f9c17b989, https://si.imgix.net/28ba6a5a/uploads/origins/8d32fd77-e81b-426c-b771-d9b692705864?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ec17b0b58aea3e46e6e86c1178f427e 2x, https://si.imgix.net/28ba6a5a/uploads/origins/8d32fd77-e81b-426c-b771-d9b692705864?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b162bbf13be1cc2b25160db19480a0be 3x"}, "body": "初めまして。CP絵を描いてくださる絵師様を探していたら、這い寄るひよこもち🐥様の素敵なイラストが目に入り、是非描いていただけたらと思いリクエストいたしました。\n\nオリジナルキャラクター2人の1枚絵をリクエストしたいです。\nキャラクター画像は資料URLをご確認ください。服装は簡略化やアレンジなどしていただいて構いません。小物が増えたり髪型がアレンジされてても問題ありません。\n緑髪の方は身長が190cmで筋肉量が多め、赤髪の方は168cmで華奢です。\n構図は特に指定がありませんが、緑髪が赤髪を囲い込んでいたり押せ押せな構図だと嬉しいです。\n二人の関係性として、普段はドライですが互いの根底に執着心があります。緑髪の方が支配欲強め、赤髪は押しに弱めです。\n\n使用用途としては観賞用です。\n文中で何か不快な思いをさせてしまったら申し訳ありません。記憶から消していただければと思います。\n難しいとは思いますがお受けしていただければ幸いです。\n\nhttps://drive.google.com/drive/folders/1-QLbhNlPwQXLSVFtBeE9_kRsMa_yf6mC", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sanimoticoc/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 592579, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38ae0121/uploads/origins/56307f5e-1169-4259-be25-9df987f53cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01e8c652e464611e07c492711643cb39", "srcset": "https://si.imgix.net/38ae0121/uploads/origins/56307f5e-1169-4259-be25-9df987f53cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01e8c652e464611e07c492711643cb39, https://si.imgix.net/38ae0121/uploads/origins/56307f5e-1169-4259-be25-9df987f53cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b84c096052e002d74d807b370b278699 2x, https://si.imgix.net/38ae0121/uploads/origins/56307f5e-1169-4259-be25-9df987f53cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=734b31017cdd6d13f25d529c69f2a318 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38ae0121/uploads/origins/56307f5e-1169-4259-be25-9df987f53cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae6def7b3fe7bf18010db09577571e5a", "srcset": "https://si.imgix.net/38ae0121/uploads/origins/56307f5e-1169-4259-be25-9df987f53cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae6def7b3fe7bf18010db09577571e5a, https://si.imgix.net/38ae0121/uploads/origins/56307f5e-1169-4259-be25-9df987f53cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=21d3b592f145e5bac48da9046b893cb8 2x, https://si.imgix.net/38ae0121/uploads/origins/56307f5e-1169-4259-be25-9df987f53cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed3fb5702c5cfb40563fad95e7708ddb 3x"}, "body": "こんにちは！前回私のオリジナルキャラクターのリカルドとノクスのイラストをリクエストさせていただいたものです！\nその節は素晴らしい作品を本当にありがとうございました！大のお気に入りで、ことあるごとに眺めてはニヤニヤさせていただいております！Twitterを拝見してうちの子を気に入ってくださったようで、すごく嬉しかったです！ありがとうございます！\nあまりに素晴らしかったので、続けてのリクエストで恐縮なのですが、もしよろしければおかわりをお願いできないかと思いリクエストさせていただきました！\nお忙しかったり、もう描き飽きたよって場合はキャンセルしていただいて大丈夫です！\n\n今回お願いしたい内容ですが、キャラクターは前回と同じリカルドとノクスで、おもち様の描かれるセクシーな表情が大好きなので、「酔っぱらった色っぽいノクスに絡まれるリカルド」を見てみたいです！\n\n服装は前回と同じ普段着っぽいものでお願いしたいですが、もし可能でしたら新しい衣装も見てみたいので、ちょっと変わってると嬉しいです！おもち様にお任せいたします！\n\n是非おもち様の描かれるうちの子をもっと見てみたいので、何卒ご検討のほど、宜しくお願い致します！\n\nhttps://www.dropbox.com/sh/bpebi0kulrjnlg2/AADPntzBon8zceO4N_U9d3dea?dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sanimoticoc/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 592579, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/beb5eaaf/uploads/origins/8a8aaba1-2271-4bd8-bb79-d805aae57369?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8359818802f796c1322cf62994073221", "srcset": "https://si.imgix.net/beb5eaaf/uploads/origins/8a8aaba1-2271-4bd8-bb79-d805aae57369?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8359818802f796c1322cf62994073221, https://si.imgix.net/beb5eaaf/uploads/origins/8a8aaba1-2271-4bd8-bb79-d805aae57369?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68124e3d9bec3910c787ff40daebb32c 2x, https://si.imgix.net/beb5eaaf/uploads/origins/8a8aaba1-2271-4bd8-bb79-d805aae57369?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42ac19b7656fe645b797fb5eac225384 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/beb5eaaf/uploads/origins/8a8aaba1-2271-4bd8-bb79-d805aae57369?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23210f3c9d7d3d407fa3fa38b8fc6dfe", "srcset": "https://si.imgix.net/beb5eaaf/uploads/origins/8a8aaba1-2271-4bd8-bb79-d805aae57369?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23210f3c9d7d3d407fa3fa38b8fc6dfe, https://si.imgix.net/beb5eaaf/uploads/origins/8a8aaba1-2271-4bd8-bb79-d805aae57369?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c87e49ae871ffc5bd4a176cbe8768176 2x, https://si.imgix.net/beb5eaaf/uploads/origins/8a8aaba1-2271-4bd8-bb79-d805aae57369?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2f4cdbe123805aa7f2e99b37ad92d916 3x"}, "body": "初めまして！おもち様の描かれたイラストをTwitterで拝見して、とても美しくてカッコよく、特にレオナさんと金髪のOCさんがめちゃくちゃどストライクでして、是非私のオリジナルキャラクターのBLカップルを描いていただけないかと思いリクエストさせていただきました！\n\n世界観　中世ヨーロッパ風ファンタジー\n\nキャラクター\n・名前　リカルド（攻）\n・32歳くらい\n・男\n・茶髪・くせ毛・少し褐色の肌、緑の眼・隻眼\n・189Cmくらいで筋肉質\n・某国の将軍。貴族父と奴隷の母の間に生まれる。体格を生かした格闘や剣術が得意。性格は誰にでも優しくおおらかで天然人たらし、恋愛事にはちょっと鈍い。お酒好き\n\n・名前　ノクス（受）\n・32歳くらい\n・男・金髪・碧眼・切れ長の目\n・178ｃｍくらい\n・あまり筋肉はない\n・某国の将軍。貴族の次男。頭が切れ、士官学校を首席で卒業。性格は計算高く野心家で口も悪い。プライドが高く素直になれないツンデレ。リカルドに対して激重感情を持っている。お酒には弱く酔うと素直になる。\n\n\n二人は士官学校からの同級生でライバルであり、親友であり、恋人同士という関係です。\n基本的にはノクス(受）の方が激重感情を持っていて、プライドの高さからなかなか素直になれなくて冷たくあたってしまいますが、そんなところもリカルド(攻）は可愛いなと思っていて、二人は付き合って10年くらいの熟年カップルのようです。\n\nポーズやシチュエーションですが、後ろからリカルドがノクスを座って抱っこしてる感じで（人間座椅子）お願いしたいです。衣装ですが、リラックスしているシーンだと思うので服装は設定の物ではなく参考のような普段着（リカルドは海賊っぽい恰好、ノクスは貴族っぽい恰好）でお願いしたいです。\n\n下記にキャラクターのメモと参考画像をＵPしておりますが、おもち様のほうで衣装や髪形など自由にアレンジしていただいて大丈夫です！\n\n好みに合わなかったり、料金に見合わない場合はキャンセルしていただいて大丈夫です。\n\n注文が細かくて申し訳ありません…！\n是非おもち様に私うちの子を描いていただけるととっても嬉しいので、ご検討のほど、何卒宜しくお願い致します。\n\nhttps://www.dropbox.com/sh/dl2y017mvou1rao/AAB_t3P7i9gzdTVfA9FC7TTWa?dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 911569, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "すち猫︎︎︎", "screen_name": "neru5__", "avatar_url": "https://pbs.twimg.com/profile_images/1697519329431175168/xvC0y24n.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1003614187048726533/1756886753/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 49}, {"id": 1337647, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "スイ🐰", "screen_name": "suimizG", "avatar_url": "https://pbs.twimg.com/profile_images/1609070287097847808/s-Xb3axG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/235435478/1669351776/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 2298173, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "水梦", "screen_name": "krmcelma", "avatar_url": "https://pbs.twimg.com/profile_images/2049049869600591872/BIsIzFUb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1261799482494119937/1709102454/1500x500", "