f632c4-ca27-4c70-aa10-df6f829ec70f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=519cbb96f06df593de37914654253bdd 3x"}, "body": "こんにちは！リクエストの受付が始まったと聞いて、とてもワクワクしています！私のスライムボーイ（♂）キャラクター「スライ」のリクエストをさせていただきたいです。以前の『ブレイブ・レッド』の作品と同様に、スライを氷の塊の中に閉じ込めてほしいです。スライは氷の中に閉じ込められ、無力そうな表情を浮かべ、身を守ろうと両手を上げている姿にしてください。 彼が「なんて恥ずかしい、丸見えだ」「飾り物になりたくない」と心の中で思っている間、氷はキラキラと輝いていてほしいです。\n\n彼の参考画像と、氷の参考画像を添付しました。\n\nhttps://drive.google.com/drive/u/0/folders/1-AiWUY3C8yi6-k3nVJjN1DEywbEQzeDi", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@makuhasi098ero/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2307571, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53201150/uploads/origins/944dada8-64e0-4f63-a4e5-ce05d06bba1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f845e61ee9b153e7c6743e7da33fb03", "srcset": "https://si.imgix.net/53201150/uploads/origins/944dada8-64e0-4f63-a4e5-ce05d06bba1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f845e61ee9b153e7c6743e7da33fb03, https://si.imgix.net/53201150/uploads/origins/944dada8-64e0-4f63-a4e5-ce05d06bba1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2517c0dfa03e485e06f4d2c6950bfe9 2x, https://si.imgix.net/53201150/uploads/origins/944dada8-64e0-4f63-a4e5-ce05d06bba1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77d9ddccb251865e4ced019c369a88e2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53201150/uploads/origins/944dada8-64e0-4f63-a4e5-ce05d06bba1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be16e082b5afe8d87728a1db82dfa3e1", "srcset": "https://si.imgix.net/53201150/uploads/origins/944dada8-64e0-4f63-a4e5-ce05d06bba1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be16e082b5afe8d87728a1db82dfa3e1, https://si.imgix.net/53201150/uploads/origins/944dada8-64e0-4f63-a4e5-ce05d06bba1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b7ac54164d9ff8c5144920906aafc093 2x, https://si.imgix.net/53201150/uploads/origins/944dada8-64e0-4f63-a4e5-ce05d06bba1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f40f6130ae3fa93918594a04a141e8c1 3x"}, "body": "まくはしおくや様の描かれる固まった小さな子が大好物なので依頼させていただきます！\nブルーアーカイブよりアロナとプラナを石化していただけないでしょうか。\n彼女たちはタブレット端末『シッテムの箱』のOS です。\nある日、シッテムの箱に侵入してきたウイルスに対抗するも負けてしまい。素っ裸にされた状態で光の輪でポーズを強制されて、そのまま順番に石化攻撃で石像に変えられてしまったシチュエーションでお願いします！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@makuhasi098ero/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2307571, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a5138e1/uploads/origins/4dc7c7be-87db-4cbb-bb1a-b4031384df2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bed5d025ac48a4c752c244c306226da1", "srcset": "https://si.imgix.net/7a5138e1/uploads/origins/4dc7c7be-87db-4cbb-bb1a-b4031384df2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bed5d025ac48a4c752c244c306226da1, https://si.imgix.net/7a5138e1/uploads/origins/4dc7c7be-87db-4cbb-bb1a-b4031384df2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f91de07b9c19d70d31e59a5ea5f8ab6 2x, https://si.imgix.net/7a5138e1/uploads/origins/4dc7c7be-87db-4cbb-bb1a-b4031384df2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2266ced3d146065bc0d70e63c1f80e7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a5138e1/uploads/origins/4dc7c7be-87db-4cbb-bb1a-b4031384df2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57ab6407a8e6083ca8a73f1999b391c8", "srcset": "https://si.imgix.net/7a5138e1/uploads/origins/4dc7c7be-87db-4cbb-bb1a-b4031384df2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57ab6407a8e6083ca8a73f1999b391c8, https://si.imgix.net/7a5138e1/uploads/origins/4dc7c7be-87db-4cbb-bb1a-b4031384df2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=588adfb745aa017dba78376e0799354b 2x, https://si.imgix.net/7a5138e1/uploads/origins/4dc7c7be-87db-4cbb-bb1a-b4031384df2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2da10798ad2cd3b492ee6f8de7e9498e 3x"}, "body": "はじめまして。\n『回転むてん丸』という作品のキャラクター、くららの石化絵をお願いいたします。\n彼女は戦える10歳の少女キャラです。この作品はまくはしさんの好みに刺さるものであると思いましたので、もし未読でございましたら下のリンク先にて無料公開されているため、読んでいただいたけると嬉しいです。\nhttps://www.kurasushi.co.jp/mutenmaru/comic/index.html\n\nシチュエーション\n調査のために仲間たちと離れて単独行動中、突然現れた怪物(姿は描かなくても、オリジナルのものを描いて下さってもよいです)から石化光線を浴びせられてしまう。\n当初は何が起こったか分からず、くららは戦闘のためにかんざしを抜こうとするが、髪と接する部分が既に固まっていて抜くことができない。\n直後に首から下の石になった部分を見て、自分の身に起こった異常を把握するが、その時には既に筋肉や関節などが固まり、ほとんど動けなくなっている。\nくららは敵の方を睨みつけるも、涙を浮かべた苦悶と恐怖を隠せない表情で完全に石像と化してしまう。\n\n石化の進行はまくはしさんの過去作https://www.pixiv.net/artworks/125350153のように、体全体の各所から広がるような形でお願いします。\n\nビジュアルの注意点\n・服装は平常時の和服でお願いします。\n・服の花柄は、花弁が米粒の形となっております。\n・絵柄は原作に寄せても、まくはしさんのものに寄せても構いません。\n\n↓非公式百科事典\nhttps://dic.pixiv.net/a/%E3%81%8F%E3%82%89%E3%82%89%28%E5%9B%9E%E8%BB%A2%E3%82%80%E3%81%A6%E3%82%93%E4%B8%B8%29\n\nhttps://www.kurasushi.co.jp/mutenmaru/about/index.html", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@makuhasi098ero/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3ea4f97b/uploads/origins/794e0c30-3d21-4af2-a247-f3658b06aba0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=P