=crop&crop=top&w=200&h=200&s=517c45ef4019b22e431b483af0412cf7 2x, https://si.imgix.net/dbe6ff06/uploads/origins/ce1c5242-7cd3-4a98-9a43-1aa5b1d5d0c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8beef502db37558a227474dd64e66bb3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dbe6ff06/uploads/origins/ce1c5242-7cd3-4a98-9a43-1aa5b1d5d0c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57a15a33e746c5ff3412eb0d589281f5", "srcset": "https://si.imgix.net/dbe6ff06/uploads/origins/ce1c5242-7cd3-4a98-9a43-1aa5b1d5d0c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57a15a33e746c5ff3412eb0d589281f5, https://si.imgix.net/dbe6ff06/uploads/origins/ce1c5242-7cd3-4a98-9a43-1aa5b1d5d0c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a86252f39c052da80f090af2f3e1bb1 2x, https://si.imgix.net/dbe6ff06/uploads/origins/ce1c5242-7cd3-4a98-9a43-1aa5b1d5d0c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e5f9def5e37189e658a0f4b05e15762 3x"}, "body": "初めまして、突然のご依頼失礼致します。\nイラスト拝見しとても可愛らしい絵柄に惹かれました！\n\nお相手につきましてはテニスの王子様の仁王雅治さんなのですが、依頼することは可能でしょうか？もし難しい場合はお断り頂いて構いません！\n\n\n＊オーダー詳細\n【彼について】\n仁王雅治さん(テニスの王子様)\n瞳：黄色に近い金色、吊り目、目つきは結構悪い\n髪の色：銀髪\n髪型：無造作に髪が跳ねている、襟足は濃いピンク色のヘアゴムで括っている(肩から少し下くらいまで垂れる程度の長さ)\n【夢主について】\n瞳：黒に近い焦げ茶色、仁王くんよりかはナチュラルなツリ目\n髪の色：ブルーグレー\n髪型：前髪はセンター分け、両サイドを編み込みでハーフアップ\n【描写範囲】\nおまかせ\n【服装】\nおまかせ(衣装等複雑なものを描いて頂ける場合、装飾は簡略化して頂いて大丈夫です！)\n【構図】\nおまかせ\n【表情】\nおまかせ\n【身長差】\n18cm\n\nご検討頂けますと幸いです。よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1xbrlITQ0hVpUYACG1pFJpY6ESfNxObeR?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@3_3_san/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1595774, "vtt_url": null, "thumb