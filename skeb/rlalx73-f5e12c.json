と共に緩く微笑んで挨拶してくれるようなそんなお兄さんを描いて頂けましたらと思います。\nこれは半分妄言なので気にしないで頂いて構いません。モ様の描かれる側頭部がツルツルの男性が拝めたらそれだけで幸せです。\n\nポーズや構図は全てお任せいたします。\n\n勿論内容が合わなければキャンセルしていただいて大丈夫です。\nご多用のところ奇怪なリクエストをお送りして恐れ入りますが、ご検討頂けたら幸いです。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 387058, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "壺一郎", "screen_name": "tsubo_ichiro", "avatar_url": "https://pbs.twimg.com/profile_images/2088650219936493568/svBYCd38.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1090300235518160897/1733499333/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 80, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id": 904108, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ITOHAKU🧵", "screen_name": "ITHK0219", "avatar_url": "https://pbs.twimg.com/profile_images/1487082793163100165/LOZ9cVyv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1304053960269946881/1653865845/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 80, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "banned": false, "nc": 176}, {"id": 1342401, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ﾒﾙﾘｺﾘｽ@お取引用", "screen_name": "1204Ryuu", "avatar_url": "https://pbs.twimg.com/profile_images/2079601604261818370/1IB2wHvo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/806490481475526656/1784904784/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": 42, "first_requester_rank