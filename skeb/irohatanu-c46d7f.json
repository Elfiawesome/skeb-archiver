っぽいものをお願いします。記念イベントなどで使いたいとも考えていますので。\n５　ファイル形式について\n　PNG形式のファイルでお願いしますがPSD形式のファイルも付けていただくと有り難いです。\n　背景があるヴァージョンと無いバージョンの２種類をお願いします。\n　当方、絵が描けないもので、色々と抽象的にお願いするところが多く大変お手数をかけますが、依頼を宜しくお願いします。\n\nhttps://akasatanu3.booth.pm/items/4657374", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@irohatanu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4017928, "client_id": 1735363, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aab3be40/uploads/origins/e4b22f6c-86fa-4165-b34d-e481d6b84dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cca168e2f3e6830aa4984ba871d0b92", "srcset": "https://si.imgix.net/aab3be40/uploads/origins/e4b22f6c-86fa-4165-b34d-e481d6b84dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cca168e2f3e6830aa4984ba871d0b92, https://si.imgix.net/aab3be40/uploads/origins/e4b22f6c-86fa-4165-b34d-e481d6b84dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31e2836d7a9f51a012fc9bcbece3c8d4 2x, https://si.imgix.net/aab3be40/uploads/origins/e4b22f6c-86fa-4165-b34d-e481d6b84dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=892b7901e8d00870f55cb1bf59e8d04d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aab3be40/uploads/origins/e4b22f6c-86fa-4165-b34d-e481d6b84dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84bee1b5439b6b33c495068b57f5eba5", "srcset": "https://si.imgix.net/aab3be40/uploads/origins/e4b22f6c-86fa-4165-b34d-e481d6b84dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84bee1b5439b6b33c495068b57f5eba5, https://si.imgix.net/aab3be40/uploads/origins/e4b22f6c-86fa-4165-b34d-e481d6b84dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200