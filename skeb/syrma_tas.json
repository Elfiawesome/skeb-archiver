ur=200&s=7fe2613eef4702ba2a2e6540776e1dd0 3x"}, "body": "募集中との事でしたのでまたイラストの依頼をさせてください。\n\n【リクエスト内容】\nうちの子のエレスチャル(銀髪の女性)とsyrmaさん宅のエリオットくんをセットで描いていただきたいです。\n構図としてはエリオットくんがエレスチャルをお姫様抱っこしていて、\nエリオットくんが照れてる感じでお願いしたいです。\n(資料URLのプライベッターにキャラを載せてありますのでそちらで確認をお願いします)\n\n【使用用途】\n個人用グッズの作製\nグッズ制作を頼む業者　栄光様\nサイズ→トレーディングカード(サイトからサイズの確認お願いします)\n\n自分で白版を作る予定なので、可能であれば人物と背景は別レイヤーにしていただきたいです。\nお手数をおかけしますが、よろしくお願いします。\n\nhttps://x.com/Htsu_eil5", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@syrma_tas/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2555069, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc800360/uploads/origins/07a05126-2f26-444f-a261-525b50a3f642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1b4a9ed404bc41674ab4a3f5ce1ac1c", "srcset": "https://si.imgix.net/fc800360/uploads/origins/07a05126-2f26-444f-a261-525b50a3f642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1b4a9ed404bc41674ab4a3f5ce1ac1c, https://si.imgix.net/fc800360/uploads/origins/07a05126-2f26-444f-a261-525b50a3f642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=54fcaf015dc83c9b734bbc0cd578e950 2x, https://si.imgix.net/fc800360/uploads/origins/07a05126-2f26-444f-a261-525b50a3f642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=878ababd2e173696f49c995ad85bda5c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc800360/uploads/origins/07a05126-2f26-444f-a261-525b50a3f642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=125a094abd51f710a7274a8bd757171b", "srcset": "https://si.imgix.net/fc800360/uploads/origins/07a05126-2f26-444f-a261-525b50a3f642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=125a094abd51f710a7274a8bd757171b, https://si.imgix.net/fc800360/uploads/origins/07a05126-2f26-444f-a261-525b50a3f642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e1997059e5fa5e39b05011c506d2fcdb 2x, https://si.imgix.net/fc800360/uploads/origins/07a05126-2f26-444f-a261-525b50a3f642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0e1793f1ef1a2d74fa60b16c8303aef1 3x"}, "body": "こんばんわ。\nXで募集されているのを拝見しまして、リクエストをさせていただきます！\nしるまさんの創作キャラがとても好きです。\n描いていただきたいと想っています。\nヒロインキャラを是非描いていただきたいです！\nよろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@syrma_tas/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2555069, "client_id": 330352, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97548382/uploads/origins/51ed3327-73cb-4565-92a8-054a860ec18b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b753f6be6d7634b893db9379fb1e0fcb", "srcset": "https://si.imgix.net/97548382/uploads/origins/51ed3327-73cb-4565-92a8-054a860ec18b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b753f6be6d7634b893db9379fb1e0fcb, https://si.imgix.net/97548382/uploads/origins/51ed3327-73cb-4565-92a8-054a860ec18b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9b10d5735cc6a32a130f3e465084182 2x, https://si.imgix.net/97548382/uploads/origins/51ed3327-73cb-4565-92a8-054a860ec18b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07d24ec33813c3708bf6ddcb0042df18 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97548382/uploads/origins/51ed3327-73cb-4565-92a8-054a860ec18b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f4000e39d20569279caca037d20bdd5", "srcset": "https://si.imgix.net/97548382/uploads/origins/51ed3327-73cb-4565-92a8-054a860ec18b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f4000e39d20569279caca037d20bdd5, https://si.imgix.net/97548382/uploads/origins/51ed3327-73cb-4565-92a8-054a860ec18b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd7f37368b81cafd108866f8ffbda494 2x, https://si.imgix.net/97548382/uploads/origins/51ed3327-73cb-4565-92a8-054a860ec18b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9173766f0b4a39b06952a196e2dc2737 3x"}, "body": "syrma様\n\nXで募集しているのをお見掛けして、１件依頼を送らせてもらいます。\n\n\n内容として、個人Vtuberのりんりんちゃんがニーリング・ポジションでスナイパーライフルを構えるイラストでお願いしたいです。\n\n参考：りんりんちゃん\nhttp://ringringroom.stars.ne.jp/\n\n参考：ニーリング・ポジション（スナイパーライフル）\nhttps://hb-plaza.com/rifle_shooting_tips_kneeling20140228/\n\n\nちなみに、格好ついてはデフォルト衣装で構わないのですが、何か似合いそうな衣装等ありましたら、自由にアレンジ・変更いただいて大丈夫です。（黒スーツ、迷彩服等）\n\n\n一度、狙撃手役のりんりんちゃんを見たいと思いましたので、ご検討のほどよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@syrma_tas/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2555069, "client_id": 2611458, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13869503/uploads/origins/0fefa424-4514-4684-94f6-50464fa4e865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ea91786693f95ad4702c5c0859f54e3", "srcset": "https://si.imgix.net/13869503/uploads/origins/0fefa424-4514-4684-94f6-50464fa4e865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ea91786693f95ad4702c5c0859f54e3, https://si.imgix.net/13869503/uploads/origins/0fefa424-4514-4684-94f6-50464fa4e865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb79702db0bf0433d44e10d2fd970456 2x, https://si.imgix.net/13869503/uploads/origins/0fefa424-4514-4684-94f6-50464fa4e865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=364371e916a65aaf0c33c687691b387c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/13869503/uploads/origins/0fefa424-4514-4684-94f6-50464fa4e865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b1bd5428f9e4cf5f041a1712dc8c1b1", "srcset": "https://si.imgix.net/13869503/uploads/origins/0fefa424-4514-4684-94f6-50464fa4e865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b1bd5428f9e4cf5f041a1712dc8c1b1, https://si.imgix.net/13869503/uploads/origins/0fefa424-4514-4684-94f6-50464fa4e865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=21d59cadf8cbf0447466640cd602e575 2x, https://si.imgix.net/13869503/uploads/origins/0fefa424-4514-4684-94f6-50464fa4e865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=09609d757d65ab07f02205aa5bc4cd4d 3x"}, "body": "こんばんは、syrmaさんの絵柄が好きなので\nぜひうちの子を描いてもらいたくてリクエストさせてください。\n\n描いていただきたい子はこちらの和也(獣化Ver. )\nhttps://www.pixiv.net/artworks/105291940\nです。\nできれば首の毛をもふもふに描いてくださると嬉しいです…。\nその他の構図や背景(なしでも大丈夫です)はおまかせでお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@syrma_tas/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2555069, "client_id": 330352, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/caa30656/uploads/origins/14887fc0-afa9-4f02-b149-1265e7d2e261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a410fe9784883121fc508bbc63cc17aa", "srcset": "https://si.imgix.net/caa30656/uploads/origins/14887fc0-afa9-4f02-b149-1265e7d2e261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a410fe9784883121fc508bbc63cc17aa, https://si.imgix.net/caa30656/uploads/origins/14887fc0-afa9-4f02-b149-1265e7d2e261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc9e5a2895a67b6b1230ecb5fa22316f 2x, https://si.imgix.net/caa30656/uploads/origins/14887fc0-afa9-4f02-b149-1265e7d2e261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f337160814f879d929b1acdc79bbf18 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/caa30656/uploads/origins/14887fc0-afa9-4f02-b149-1265e7d2e261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6b6f815880ed59871788d194666c357", "srcset": "https://si.imgix.net/caa30656/uploads/origins/14887fc0-afa9-4f02-b149-1265e7d2e261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6b6f815880ed59871788d194666c357, https://si.imgix.net/caa30656/uploads/origins/14887fc0-afa9-4f02-b149-1265e7d2e261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a1a4109041c75766fb8909c33c7366b2 2x, https://si.imgix.net/caa30656/uploads/origins/14887fc0-afa9-4f02-b149-1265e7d2e261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f48fdfe6772665f8ab40012b54a4c998 3x"}, "body": "syrma様\n\n\nコミッションを募集されておりましたので、依頼を１つお送りさせていただいた次第です。\n\n依頼内容を次のとおり書き残しますので、syrma様の意向に沿えば幸いです。\n\n\n本題の依頼内容についてですが、「個人Vtuberの御掬この子さんがスリットシスター服・レースベールでスコップを構えた姿」をお願いしたいです。\n\n御掬この子：\nhttps://www.twitter.com/konoko_okome\n\nスリットシスター服：\nhttps://hareame.shop/items/5fdca707df51596591057df8\n\nレースベール：\nhttps://hareame.shop/items/622d99c22cf73d6c6dbed13f\n\nスコップ：\nhttps://item.rakuten.co.jp/lifestylish/wss201501b07cvcfp51/\n\n\n古びた教会or外国人墓地に「葬儀屋」として居座り、ダークファンタジー系のストーリーで中盤に敵対するキャラ、というのが個人的なイメージです。\n\nあと、スコップを持ったファンアートをご本人が望まれていたのもありましたので…。\nhttps://mobile.twitter.com/konoko_okome/status/1225281576809816064\n\n\n依頼内容としては以上となります。\n説明が長くなり申し訳ありませんが、ご検討のほどよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@