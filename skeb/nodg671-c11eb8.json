32f9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96708722ce33d13aeeea87ec31a11972 2x, https://si.imgix.net/99774c16/uploads/origins/3661a428-7a94-438e-8c0d-4a25eba32f9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=446a1f2d89fcb3c6c18895454814cff4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99774c16/uploads/origins/3661a428-7a94-438e-8c0d-4a25eba32f9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aca05564cd9040d6d5a21f9c7ae9d2f6", "srcset": "https://si.imgix.net/99774c16/uploads/origins/3661a428-7a94-438e-8c0d-4a25eba32f9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aca05564cd9040d6d5a21f9c7ae9d2f6, https://si.imgix.net/99774c16/uploads/origins/3661a428-7a94-438e-8c0d-4a25eba32f9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3cc861376651e4d886eba28bfcc94723 2x, https://si.imgix.net/99774c16/uploads/origins/3661a428-7a94-438e-8c0d-4a25eba32f9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=13fca7ef0a03c7ccfed92983af450e60 3x"}, "body": "お久しぶりです。体調の方は大丈夫でしょうか？\n前にキャンセルされたものと同じ依頼となります。依頼金額も同じです。(こちらを断って、キャンセルした方を再送でも可能です)\nまだ体調が優れないようでしたら、こちらの依頼はお断りして頂いても構いません。\n\n[依頼内容(概要)]\nある異変解決中に魔理沙を庇って全盲になってしまった霊夢を世話する魔理沙ちゃんの漫画をお願いします！\n[設定]\n霊夢：とある呪いをかけられてしまい全盲\n目を保護する為に包帯が巻かれてる\n呪いが強く紫でも解呪できない\n無論、病気では無いので永琳にも治療不可\n呪いをかけた当人も解き方は分からんと...\n\n魔理沙：霊夢の身の回りの世話をする\n霊夢に対してかなりの罪悪感がある\n\nオチはハッピーエンドでもバットエンドでも何でも良いです！！先生が描きたいようにお願いします！！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nodg671/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2075226, "client_id": 996512, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8d051d9/uploads/origins/1cafe714-3acb-4d71-96e3-5bb68ff47356?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2e8697094a75f2ceacf9fc6f9e12802", "srcset": "https://si.imgix.net/b8d051d9/uploads/origins/1cafe714-3acb-4d71-96e3-5bb68ff47356?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2e8697094a75f2ceacf9fc6f9e12802, https://si.imgix.net/b8d051d9/uploads/origins/1cafe714-3acb-4d71-96e3-5bb68ff47356?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cab22764fcdb4d19365c289669a554c3 2x, https://si.imgix.net/b8d051d9/uploads/origins/1cafe714-3acb-4d71-96e3-5bb68ff47356?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=706916358846d0e09d3ba0119059a246 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8d051d9/uploads/origins/1cafe714-3acb-4d71-96e3-5bb68ff47356?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92009ba691636994ca9c74b347c010b9", "srcset": "https://si.imgix.net/b8d051d9/uploads/origins/1cafe714-3acb-4d71-96e3-5bb68ff47356?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92009ba691636994ca9c74b347c010b9, https://si.imgix.net/b8d051d9/uploads/origins/1cafe714-3acb-4d71-96e3-5bb68ff47356?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7e297329eb452be6275774d824324a14 2x, https://si.imgix.net/b8d051d9/uploads/origins/1cafe714-3acb-4d71-96e3-5bb68ff47356?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2f6bec2b0a8770375a0bc18636b2cf56 3x"}, "body": "はじめまして。\n東方Projectの朱鷺子（名無しの本読み妖怪）のコスプレをするコミックをお願いします。\n\n\n■概要\nノドグロ様のこちらのイラスト↓\nhttps://x.com/nodg671/status/1946786723826201003\nの展開の別衣装パターンで、男の子が朱鷺子（名無しの本読み妖怪）のコスプレをさせられるシーン。\n\n・参考：朱鷺子の衣装デザイン\nhttps://twitter.com/ehokun/status/1038098685979021312\n\n\n■導入\n新しく朱鷺子のコスプレ衣装が手に入ったので、一緒に宅コスしようと誘う女子。\n書籍『東方香霖堂』の「霊夢に奪われた本を取り返すため、香霖堂のドアを蹴破って入ってくる朱鷺子」を再現しようと持ち掛ける。\n\n・参考：朱鷺子が扉を蹴破るシーン\nhttps://www.pixiv.net/artworks/88743763\n\n\n■メイン\n朱鷺子コス男子「こ…こんな感じでいい…？（どうしよう思ったよりスカート短い見えてないよね見えてないよね）」\nいつものぐるぐる涙目で恥ずかしそうな表情をしながら正面に向かってキックしているポーズ。\nキックでスカートがめくれ、ふとももが股関節ギリギリまで見えている。\n下着をはいていないようにも見えるが、見えそうで見えない。\n\n霊夢コス女子「もうちょっと脚上げて！あー、それいいわー！かわいいわー！（えっ…ちょっ…み…見え…見え…）」\nよだれを垂らして興奮した表情で、スマホで撮影している。\n\n\n■オチ\n朱鷺子コス男子のスカートの中が、霊夢コス女子目線では実は見えていた。\n男子「本当にスカートの中見えてない？（不安）」\n女子「大丈夫大丈夫！意外と見えないもんだから安心して！（嘘）（どうしよう思いっきり見えてる待って心臓もたないこんなん見せられたら私もう無理無理！見ちゃいけないのに最高すぎて幸せ…！）（早口）」\n見えてはいけない部分を思わぬ形で撮影してしまい、背徳さに情緒ぐちゃぐちゃになりながら興奮する霊夢コス女子のセリフと表情のアップ。\n\n\nオチの部分は、ノドグロ様の「擬似レズコスプレイマリ」ジャンルの今後に悪影響が出ると判断された場合はカットまたは改変していただいて構いません。\nまた、セリフはアレンジ自由です。\n\nどうかよろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nodg671/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2075226, "client_id": 113370, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ddf1e8c/uploads/origins/9b9e6b24-00e5-4581-a86a-e3febe6dccbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78937df0e9f59eb6195f4a04c05ded36", "srcset": "https://si.imgix.net/8ddf1e8c/uploads/origins/9b9e6b24-00e5-4581-a86a-e3febe6dccbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78937df0e9f59eb6195f4a04c05ded36, https://si.imgix.net/8ddf1e8c/uploads/origins/9b9e6b24-00e5-4581-a86a-e3febe6dccbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a49c08e2d799865136b9b05c72c52b17 2x, https://si.imgix.net/8ddf1e8c/uploads/origins/9b9e6b24-00e5-4581-a86a-e3febe6dccbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2fc0953c1c27e5574250b14af23e5a1 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ddf1e8c/uploads/origins/9b9e6b24-00e5-4581-a86a-e3febe6dccbc?bg=%23fff&auto=format%2Ccompress