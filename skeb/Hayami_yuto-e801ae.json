://si.imgix.net/e8ccd224/uploads/origins/338c1a02-2006-4c51-b8db-00b7ff0bf530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb421ebf9a156a00a2da6a7153808ae3, https://si.imgix.net/e8ccd224/uploads/origins/338c1a02-2006-4c51-b8db-00b7ff0bf530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b8462e7cdf64107bb3f40974facd777b 2x, https://si.imgix.net/e8ccd224/uploads/origins/338c1a02-2006-4c51-b8db-00b7ff0bf530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b20e23a7fe7541d12247014ac0f68b1 3x"}, "body": "耳かきしてくれるキャトル・アマリリスさんをお願いします。\n膝枕で上を見上げてるアングルで。\n豊かな胸を思いっきり強調して、耳かきを構えてるアングルでお願いします。\n\nhttps://www.dlsite.com/home/work/=/product_id/RJ237005.html", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hayami_yuto/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 819558, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1cd96be2/uploads/origins/7b0dc7bc-108a-47e1-858e-3d77da4bf49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76423f438e71842a3e42f4d3a40e59f5", "srcset": "https://si.imgix.net/1cd96be2/uploads/origins/7b0dc7bc-108a-47e1-858e-3d77da4bf49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76423f438e71842a3e42f4d3a40e59f5, https://si.imgix.net/1cd96be2/uploads/origins/7b0dc7bc-108a-47e1-858e-3d77da4bf49f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0cfcbec7577c6f7713caa4dc2712752 2x, https://si.imgix.net/1cd96be2/uploads/origins/7b0dc7bc-108a-47e1-858e-3d77da4bf49f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5fa46974aadd5ee9f7db79369283a0d7 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1cd96be2/uploads/origins/7b0dc7bc-108a-47e1-858e-3d77da4bf49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=980d4aeee0fbf9906d2908873c0f76b9", "srcset": "https://si.imgix.net/1cd96be2/uploads/origins/7b0dc7bc-108a-47e1-858e-3d77da4bf49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=980d4aeee0fbf9906d2908873c0f76b9, https://si.imgix.net/1cd96be2/uploads/origins/7b0dc7bc-108a-47e1-858e-3d77da4bf49f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c8cb84082826e15713a803359bc34b1 2x, https://si.imgix.net/1cd96be2/uploads/origins/7b0dc7bc-108a-47e1-858e-3d77da4bf49f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ec25bcff734e07f374bf57ed37cb9e06 3x"}, "body": "初めまして\n\n内容が特殊ですので気のりしなければキャンセルしていただいて構いません。\n\nオリジナルキャラで、昔の農家の20歳前後の\n純朴そうな黒髪女性の拘束イラストをリクエストしたいです。\n顔だち、体型、髪型等はお任せします。\n全体的に悲壮感が漂う雰囲気のイラストをお願いします。\n\n恰好\n野良着、もんぺ、地下足袋履きで、\n胸をだしてX字に拘束されています。\n表情は羞恥のため泣いている感じにしてほしいです。\n頭から爪先までを描いてほしいです。\n\n服装\n野良着の色、模様は適当に、\nもんぺはへその辺りで紐を結ぶ袴式、\n全体の長さはくるぶしまでで、色、模様は濃い紫系の縞、\n脇は袴の様にスリットを開けてほしいです。\n地下足袋はくるぶしの上までの長さ、色は黒にしてほしいです。\nもんぺイメージ\nhttps://www.dropbox.com/s/27dregu6fv4xgh3/ms.jpg?dl=0\n地下足袋イメージ\nhttps://www.dropbox.com/scl/fi/0dlq0el8hrwkh15ocjvm7/tb.png?rlkey=id9szwe2vs7xqr6f46enheggn&dl=0\n\nまた\nもんぺの股間部分を破られ、陰部に張型が挿入され\n表情も痛さで苦しそうに目をつぶり涙を流して絶叫している状態もお願いします。\n\n構図は資料urlのような斜め横からの構図でお願いします。\n\nつたない説明で恐縮ですが説明不足な点など自由に\n変更、アレンジしていただいて構いませんが、\nもんぺと地下足袋の描写はできるだけ細部まで、また\n必ずもんぺが破れていない状態と破れた状態の2種を描いていただきたいです。\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fi/obnrrwlde7y6hyf4etijl/x2.png?rlkey=q67zqh19q9f8z3cg11nmd20ws&st=xi6k2hvb&dl=0", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hayami_yuto/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 819558, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b9853dc/uploads/origins/356792c8-74fb-491d-b314-78019c4dab46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61a191de526fadab70d4cfc1ad6630cd", "srcset": "https://si.imgix.net/8b9853dc/uploads/origins/356792c8-74fb-491d-b314-78019c4dab46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61a191de526fadab70d4cfc1ad6630cd, https://si.imgix.net/8b9853dc/uploads/origins/356792c8-74fb-491d-b314-78019c4dab46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7ebb3d6028e16a27b582c50e0277d20 2x, https://si.imgix.net/8b9853dc/uploads/origins/356792c8-74fb-491d-b314-78019c4dab46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9cb121d5dbda1e14972c4e006ef4eba4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b9853dc/uploads/origins/356792c8-74fb-491d-b314-78019c4dab46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c02581f3522b48137167d5c1c2a22d48", "srcset": "https://si.imgix.net/8b9853dc/uploads/origins/356792c8-74fb-491d-b314-78019c4dab46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c02581f3522b48137167d5c1c2a22d48, https://si.imgix.net/8b9853dc/uploads/origins/356792c8-74fb-491d-b314-78019c4dab46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f800381f44d309f9b6d0be1ccdf3e26 2x, https://si.imgix.net/8b9853dc/uploads/origins/356792c8-74fb-491d-b314-78019c4dab46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05fe3eb67fc3335ae3221008b5862e50 3x"}, "body": "際どい裸エプロンで後ろから俺くんに迫られる\n柚木つばめさんをお願いします。\n\nアングルは前から。\n後ろにいる俺くんが腕や腰を掴む感じで、\n極力俺くんは顔を画面から切ったり、つばめさんの身体で隠して\n描かないようお願いします。\n\n余白に「り、料理中だからダメだよ俺くん…♥」\nみたいな台詞を入れて、表情は少し恥ずかしがってるけど\nまんざらじゃなさそうな感じでお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hayami_yuto/works/3", "private_t