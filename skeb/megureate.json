op&w=200&h=200&s=d6aae8b88008afb55b1359d2985698b0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4836c7a5/uploads/origins/6c87ee60-a336-4555-99a6-d21ae869a3b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bb83b505eab12f0f4288e346f86c2f2", "src_set": ""}, "body": "最高な触手H作品を拝見しましたのでぜひコミッションをお願いさせていただきたいです。\nお願いしたい作品の内容は、複数人の巫女服姿の女性が大量の触手に蹂躙されている作品。巫女さんたちは退魔師的な存在で、大量の触手に健闘むなしく敗北後拘束され、全身を様々ないやらしい形状の触手に責められているといった感じでお願いします。巫女さんたちの衣装は通常の巫女服(襟元が緩んでいたり触手に破かれていたりして乳房や陰部が露わ)、背景を描いていただけるようでしたら以前先生が描かれていたこちらの作品https://www.pixiv.net/artworks/116231550のような感じで触手に覆いつくされた神社の境内でお願いします(こちらは簡便なもの、もしくは省力していただいても問題はないです)。\nご検討いただけましたら幸いです。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@megureate/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1ae416a4/uploads/origins/da892d03-6ba4-4768-ba82-872c34b0cf80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=065b1bd730667be56ddf2c0c87c51ca4", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 55906, "client_id": 2717184, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 41, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@megureate/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4222b207/uploads/origins/5028538c-88a4-4299-acbf-8a8d6251341c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a50e957bf6ee7b66db705250063e52a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 55906, "client_id": 434421, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@megureate/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 55906, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/193f3590/uploads/origins/ffc7e48b-2b48-4e78-87dd-aa5b4fd7c5b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b831a489faaf2be2f8ee231dcfbcfe6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/193f3590/uploads/origins/ffc7e48b-2b48-4e78-87dd-aa5b4fd7c5b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d772c1738647ecea6cb270428a22e824", "src_set": ""}, "body": "触手がでてくるRPGを手掛けている月の水企画さんというサークルをご存じでしょうか？\n同サークルさんのRPGのキャラクターと触手が出てくるイラストをお願いしたいのですが…。（同サークルさん、二次創作はOKだったと思います）\n\n良ければ、次の条件でお願いします。\n・メインの女の子は同サークルさんのRPGから、現代編ではないキャラで\n・触手は肉色の魔触か、触手系女の子モンスターで\n・サークルさんの作風のように、触手がいて普通といった世界観で\n・女の子はいろいろな部分を触手に責められて気持ちいい思いをさせられていて、表情はお任せしますが、少なくとも苦痛の表情ではない感じで\n\n条件合わなければキャンセルしていただいて構いません！", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@megureate/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 55906, "client_id": 2493089, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f5604ea4/uploads/origins/19947f98-f34d-487f-82d0-19f6cce4544b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e5cf76813a85e256e570c64650344c7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5604ea4/uploads/origins/19947f98-f34d-487f-82d0-19f6cce4544b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02e5ec159b3dd7b52197b97a73173da2", "src_set": ""}, "body": "こんにちは。触手が好きな者です。\n最近描かれているスパイ少女の触手絵が好みでしたので、リクエストしてみます。\n\n触手で満ちている架空の世界と、そこで暮らす女の子を自由な発想でお願いします。\n\n女の子は触手に責められていても共存していてもよいです。複数でもよいです。\n空と地平線が見えて、地面は肉色で触手に満ちているイメージでお願いします。\n\nよろしければご検討ください！", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@megureate/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/71670eab/uploads/origins/8d879a40-3fe2-42c5-8fe8-a756555459c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b1c4e800f41d60fd18ae75f706eec12", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 55906, "client_id": 628237, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@megureate/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 55906, "client_id": 628237, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/049b055b/uploads/origins/78c53361-cab2-4ca1-9c6b-741da4a2ba99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89bd437d99cd65112618be2179d78d61", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/049b055b/uploads/origins/78c53361-cab2-4ca1-9c6b-741da4a2ba99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8e4b8a6700419ba2b6d23dd4bd20061", "src_set": ""}, "body": "はじめまして、ふわふわと申す者です。\n今回ご依頼させて頂きたいのがウエディングランジェリー姿のペポ(花騎士)です。結婚初夜で団長のために恥ずかしがりながらも着てきたと考えるとご飯が3000杯行けそうです(過剰)。どうかよろしくお願いします。", "nc": 33, "word_count": 0, 