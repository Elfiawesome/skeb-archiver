bp&fit=crop&crop=top&w=200&h=200&s=7276153f3343db2971581ab58c8ad08f", "srcset": "https://si.imgix.net/72721ffc/uploads/origins/74d4aa35-6d5f-47e2-bd07-0f97f18eeb47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7276153f3343db2971581ab58c8ad08f, https://si.imgix.net/72721ffc/uploads/origins/74d4aa35-6d5f-47e2-bd07-0f97f18eeb47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f74a1655bf5f02e6d8852db6072a6aa 2x, https://si.imgix.net/72721ffc/uploads/origins/74d4aa35-6d5f-47e2-bd07-0f97f18eeb47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23b21529c1baa08584a9c0769086e0ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72721ffc/uploads/origins/74d4aa35-6d5f-47e2-bd07-0f97f18eeb47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e4e8ae26be4bf9ecc7cb68101cfd147", "srcset": "https://si.imgix.net/72721ffc/uploads/origins/74d4aa35-6d5f-47e2-bd07-0f97f18eeb47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e4e8ae26be4bf9ecc7cb68101cfd147, https://si.imgix.net/72721ffc/uploads/origins/74d4aa35-6d5f-47e2-bd07-0f97f18eeb47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dfdd3941baec49e35a2c37898a85e007 2x, https://si.imgix.net/72721ffc/uploads/origins/74d4aa35-6d5f-47e2-bd07-0f97f18eeb47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=22f9baf16bf86251d02e65f09f35253b 3x"}, "body": "初めまして。\nVtuber活動をしているMaster雨音と申します。\n\nskebで素敵なイラストを拝見し、\nぜひ私の姿を描いていただきたく依頼致しました。\n\n■用途\n主に活動で使用します。\nサムネ、SNSやグッズ等の利用を想定しています。\n\n■キャラクター\n変身により、4つ(SD含め6つ)の形態になれるのですが、\n姿は添付資料から、ブラウン髪耳尻尾有りの状態をお願いできればと思います。\n無しの状態にもできると大変嬉しく思います。\n\n■服装・ポーズ\n私のクラシカルメイド姿をお願いしたいです。\n大まかなイメージは、気モリ様にお任せいたします。\n\n何かを持ったポーズで、ONOFFした際に違和感がないと幸いです。\n下記参考イラストになります。\nhttps://skeb.jp/@kazuneko_jp/works/20\n\nポーズ自体はお任せ致します。\n\n■納品物\n人物と背景が別レイヤーで、上左右の見切れがないと使用しやすい為、ありがたいです。\n\nお受けていただけるのであれば、ぜひ宜しくお願い致します。\n\nhttps://drive.google.com/file/d/13cMjgJxfY-RA-IadzyRPvrh_qv9N-5K1/view?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@PeroPero_nico/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3902570, "client_id": 1541021, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb54551b/uploads/origins/c4eca27a-97f1-4bed-b5e2-7b7115b5320f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5e6986ddbe635e01116f8e6b3e3bc7e", "srcset": "https://si.imgix.net/eb54551b/uploads/origins/c4eca27a-97f1-4bed-b5e2-7b7115b5320f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5e6986ddbe635e01116f8e6b3e3bc7e, https://si.imgix.net/eb54551b/uploads/origins/c4eca27a-97f1-4bed-b5e2-7b7115b5320f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86a63cbf5c560966946a846533c08a8a 2x, https://si.imgix.net/eb54551b/uploads/origins/c4eca27a-97f1-4bed-b5e2-7b7115b5320f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c07c786e1889060e91da95ce7dc2df4c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb54551b/uploads/origins/c4eca27a-97f1-4bed-b5e2-7b7115b5320f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b02eff00caff0706f57c82c2880336db", "srcset": "https://si.imgix.net/eb54551b/uploads/origins/c4eca27a-97f1-4bed-b5e2-7b7115b5320f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b02eff00caff0706f57c82c2880336db, https://si.imgix.net/eb54551b/uploads/origins/c4eca27a-97f1-4bed-b5e2-7b7115b5320f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d74f7b5453a298c08279690579bbdeee 2x, https://si.img