いです。\n\nhttps://img.cdn.nimg.jp/s/nicovideo/thumbnails/25874646/25874646.original/r1280x720l?key=aa713985376ae5f887497ec06c6e1d9ac7e6221176e15a90c468e1e1a7dda96b\n\nhttps://www.pixiv.net/artworks/107066526#manga", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mjrnk2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3138642, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/02231ac7/uploads/origins/37cac28b-b11a-4261-b1ef-b91569870cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0aa0775ca875283e40423785f4d84727", "srcset": "https://si.imgix.net/02231ac7/uploads/origins/37cac28b-b11a-4261-b1ef-b91569870cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0aa0775ca875283e40423785f4d84727, https://si.imgix.net/02231ac7/uploads/origins/37cac28b-b11a-4261-b1ef-b91569870cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a72b51e2427e0a6b9d5c8bbd3b8f0f7a 2x, https://si.imgix.net/02231ac7/uploads/origins/37cac28b-b11a-4261-b1ef-b91569870cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1357bfc2dbede5e635d85f5e2ad0420 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/02231ac7/uploads/origins/37cac28b-b11a-4261-b1ef-b91569870cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60ef3a607c3f444076123e07ab6c8ee0", "srcset": "https://si.imgix.net/02231ac7/uploads/origins/37cac28b-b11a-4261-b1ef-b91569870cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60ef3a607c3f444076123e07ab6c8ee0, https://si.imgix.net/02231ac7/uploads/origins/37cac28b-b11a-4261-b1ef-b91569870cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a040c0b629c3deb283e1b956cd329df3 2x, h