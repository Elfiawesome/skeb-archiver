: false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@matumine_mix/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3381559, "client_id": 2656832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e7a1cd8b/uploads/origins/e3128539-f133-488c-a8f9-983507e24a63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=889353ff125d83bb2e9f3dbc3549d85b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e7a1cd8b/uploads/origins/e3128539-f133-488c-a8f9-983507e24a63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fef1f0dd72f41106a380e91839540e2a", "src_set": ""}, "body": "松峰さん、お久しぶりです。\n少し余裕ができたのでリクエストさせていただきます。\n何度も申し訳ないのですが、また桜木ひかりさんのイラストとこの絵解剖をお願いしたいです。\n「おつかれ元気チャージ！」のように、一週間頑張った自分へのご褒美に寝る前に好きな物を食べているイラストをお願いしたいです。\n「きらめくひととき」の女の子の表情がとても幸せそうで、見ている私もなんだか幸せな気分になったので、「きらめくひととき」のような、幸せな表情にしていただけると嬉しいです。\n羊のぬいぐるみの表情がいつも可愛いので、今回もよろしかったらお願いしたいです。\n\nお仕事でお忙しいと思いますので、キャンセルしていただいても大丈夫です。\nご検討よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matumine_mix/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3381559, "client_id": 2656832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7a643df/uploads/origins/e5cc4619-e4cb-43cf-bd65-77eff9b2ad75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dac0e47bef0b4427896b72cdef6cd094", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c7a643df/uploads/origins/e5cc4619-e4cb-43cf-bd65-77eff9b2ad75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a84809cbdc6f968e97a023e4788e56c0", "src_set": ""}, "body": "こんにちは。\nこの前は素敵なイラストをありがとうございました。\nクッションやブランケットが「おやすみに向かう」の女の子のイメージにぴったりでとても可愛かったです。優しい表情から、ふわっとした柔らかい感じが伝わってきて何度見ても素晴らしいキャラクターデザインだと思います。\n松峯さんのイラストはいつも違う女の子が登場されていますが、キャラクターの名前や設定などがあるのかなと思って今回リクエストさせていただきました。\nもしよろしければ「おやすみに向かう」の女の子のキャラクター設定画をお願いしたいのです。松峯さんのこだわりポイントなどあれば「この絵解剖」のように解説していただきたいです。\nお仕事でお忙しかったり、体調不良でしたらキャンセルしていただいて大丈夫です！\n\n毎回変なリクエストで申し訳ありませんがご検討いただけますと嬉しいです。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matumine_mix/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3381559, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fbdf069/uploads/origins/bf6ec4e7-ab6c-4e49-a709-972d6d204fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87a4303ad4500bf1cd950dd7241b4b7e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6fbdf069/uploads/origins/bf6ec4e7-ab6c-4e49-a709-972d6d204fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8cbb9ce1ad583a3993258765c724da7", "src_set": ""}, "body": "こんにちは。\n先日は素敵なイラストをありがとうございました。\n松峰さんのイラストのテーマではあまり拝見しないので、リクエストとしてどうかなと思ったのですが、「ふわふわな朝」と「おやすみに向かう」の2人の女の子のイラストをお願いしたいです。ベッドの上でお気に入りのパジャマ姿で楽しそうに過ごしている感じが見てみたいです。\nご検討よろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matumine_mix/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3381559, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/182bb1c0/uploads/origins/2edfe696-f28e-453d-b71e-818a7a0634fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1013d74ac76369b43fdd71a7453a671e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/182bb1c0/uploads/origins/2edfe696-f28e-453d-b71e-818a7a0634fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96e02f4f28380684d58f25a25405d4ed", "src_set": ""}, "body": "はじめまして。\nローソンプリントの第二弾も素晴らしかったです！シークレットのイラストが、あなたの絵の中で一番好きな「おやすみに向かう」だったのも嬉しかったです。\n寝る前の時間が、優しい色合いと、ゆったりした可愛いパジャマからイメージできて、心が休まる感じがしてとても癒されます。\nもしよろしければ、「おやすみに向かう」の青いパジャマの女の子を描いていただけないでしょうか。休日にパジャマ姿のままソファでゆっくり座っていたり、寝る前にベッドに腰掛けているような、リラックスしている様子だと嬉しいです。\nぜひご検討をよろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matumine_mix/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b3128ce1/uploads/origins/a06e7379-3fdd-447b-b224-d75205814b5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b2399d42016b54640819697ba22a09e", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3381559, "client_id": 3419109, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@matumine_mix/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3381559, "client_id": 1236233, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9de507e/uploads/origins/3b543111-1850-481d-aa37-9d5dad11df1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62eecbb6a92ab1cffbfb8cf11586f170", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9de507e/uploads/origins/3b543111-1850-481d-aa37-9d5dad11df1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1