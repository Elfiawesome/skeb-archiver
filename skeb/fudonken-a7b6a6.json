?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=495ea6eddf7a880c9883c4843d42639d", "srcset": "https://si.imgix.net/a1a41765/uploads/origins/1b720051-183f-4ccd-be3f-c99cb1c1f7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=495ea6eddf7a880c9883c4843d42639d, https://si.imgix.net/a1a41765/uploads/origins/1b720051-183f-4ccd-be3f-c99cb1c1f7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6fa699038e61862b0df4fc43000bdd24 2x, https://si.imgix.net/a1a41765/uploads/origins/1b720051-183f-4ccd-be3f-c99cb1c1f7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1e3d2cc5c5e6bc425e5618adc2272bf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1a41765/uploads/origins/1b720051-183f-4ccd-be3f-c99cb1c1f7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2c8d612a1a92677a0cd45841f3e1cd5", "srcset": "https://si.imgix.net/a1a41765/uploads/origins/1b720051-183f-4ccd-be3f-c99cb1c1f7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2c8d612a1a92677a0cd45841f3e1cd5, https://si.imgix.net/a1a41765/uploads/origins/1b720051-183f-4ccd-be3f-c99cb1c1f7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a5d4058f48a02571f09c09a69d3a1ea 2x, https://si.imgix.net/a1a41765/uploads/origins/1b720051-183f-4ccd-be3f-c99cb1c1f7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab1310e23c66e8aaee90e13ad04618fb 3x"}, "body": "こんにちは！\nXでお見かけして絵柄がとても健康的で素敵だと思ったので、ぜひうちの子「浜風ふたば」のイラストをお願いしたいです！\n\n■うちの子\n肉感が魅力的なキャラなので、胸や尻などを無理のない範囲で全体的に盛ってむちむちな感じにしていただけると嬉しいです\n衣装は競泳水着（資料参照）でお願いします\n\n■シチュ、構図など\n健康のために屋内プールに行くうちの子\n泳ぐ前に念入りに準備運動をする\nしかし、胸の前で腕をクロスすると胸が押しのけられたり潰れたり、今度は少しかがむとお尻に水着が食い込み…とむちむち具合をいかんなく発揮\n彼女自身は全く気にしておらず「今日も頑張るぞ～」という雰囲気だが、周りは気が気じゃない\nといった雰囲気のイラストをお願いしたいです\n構成などはお任せします\n\n彼女の健康的でむちむちな肉感を感じれる作品だと嬉しいです\nご検討のほど、よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1AxFMEKn8aRjNLjaiQOxFJgE6m5z2sxyx?usp=sharing", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fudonken/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3987167, "client_id": 1282251, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9cc46b3/uploads/origins/949dc109-7d09-44ff-ab21-813d3e07e539?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=198f0d8217dae8813fd452c51bfbbee6", "srcset": "https://si.imgix.net/a9cc46b3/uploads/origins/949dc109-7d09-44ff-ab21-813d3e07e539?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=198f0d8217dae8813fd452c51bfbbee6, https://si.imgix.net/a9cc46b3/uploads/origins/949dc109-7d09-44ff-ab21-813d3e07e539?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=430605a3a4c7bf9ddd3844bd747d8616 2x, https://si.imgix.net/a9cc46b3/uploads/origins/949dc109-7d09-44ff-ab21-813d3e07e539?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a9150219d4bfea44433ad12dbfceb19 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9cc46b3/uploads/origins/949dc109-7d09-44ff-ab21-813d3e07e539?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8287e960401f6d180746b4c5a66fa79a", "srcset": "https://si.imgix.net/a9cc46b3/uploads/origins/949dc109-7d09-44ff-ab21-813d3e07e539?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8287e960401f6d180746b4c5a66fa79a, https://si.imgix.net/a9cc46b3/uploads/origins/949dc109-7d09-44ff-ab21-813d3e07e539?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=91b63231d8c1cdd88bad6e11baaa87d3 2x, https://si.imgix.net/a9cc46b3/uploads/origins/949dc109-