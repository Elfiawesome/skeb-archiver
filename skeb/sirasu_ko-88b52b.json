n\nもし依頼内容に難しい点か問題点があれば、是非断ってください。\nご検討のほど、宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1qfI9btETSqer4D3GMUatUftJrYDAlWxQ?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirasu_ko/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 830411, "client_id": 1776258, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75b9d5a7/uploads/origins/34d7800e-74a0-4f50-bf5d-7ac846c81367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e3eb7d4e6c74a9f4161574fe5ffada9", "srcset": "https://si.imgix.net/75b9d5a7/uploads/origins/34d7800e-74a0-4f50-bf5d-7ac846c81367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e3eb7d4e6c74a9f4161574fe5ffada9, https://si.imgix.net/75b9d5a7/uploads/origins/34d7800e-74a0-4f50-bf5d-7ac846c81367?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=731b4a60c9c97b68dd8db4a90175ef71 2x, https://si.imgix.net/75b9d5a7/uploads/origins/34d7800e-74a0-4f50-bf5d-7ac846c81367?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46b4097f58e2b5a86d37cf6726623c57 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75b9d5a7/uploads/origins/34d7800e-74a0-4f50-bf5d-7ac846c81367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cac41dc9da0773386e849e31532d4dec", "srcset": "https://si.imgix.net/75b9d5a7/uploads/origins/34d7800e-74a0-4f50-bf5d-7ac846c81367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cac41dc9da0773386e849e31532d4dec, https://si.imgix.net/75b9d5a7/uploads/origins/34d7800e-74a0-4f50-bf5d-7ac846c81367?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=04c689d17c30ae19791081a0547e2eb6 2x, https://si.imgix.net/75b9d5a7/uploads/origins/34d7800e-74a0-4f50-bf5d-7ac846c81367?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=92d390de05b4377d399780c45c091370 3x"}, "body": "白砂子 様\n\nはじめまして、もこと申します。\n白砂子様の絵の雰囲気に一目惚れしまして、この度リクエストを送らせて頂きました。\n\n描いて頂きたいのが、TRPGというゲームで使用しているオリジナルの子達です。\n2人は付き合っていたのですが、片方が事故で恋人の目の前で亡くなり、残された子が悲しみに暮れていたのですが、夢のような所で再開することが出来、話をして少しずつですが前を向けるようになりました。\n\n描いていただきたいのは、その夢で再会できたところです。\n夢の世界では｢宇宙を走る電車の中｣｢泡が踊る海の中｣｢ガラス細工のひまわり畑｣｢星空の綺麗な海辺｣を巡っていく中で、自分達の指輪を作りながら話をするというものなのですが、\nふたりが以前海辺に住んでいたこともあるので、出来れば海辺をお願いしたいです。\n(あくまでイメージです、無視していただいても全然構いません。)\n\n向かい合って話している、横並びに座って話す、顔アップ、引き絵、などお任せ致します。\n\n参考資料を添付致しますので、ご検討の程よろしくお願い致します。\n\n\nhttps://drive.google.com/drive/folders/1-Dihca-89zy1bd0vk3KlUSDfe2mXFlTC", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirasu_ko/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1c9cec18/uploads/origins/8b30ec85-e6a3-4ce6-8e6c-e13bed7f7906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e41417ed2a5a248ce7ceed71e981910", "srcset": "https://si.imgix.net/1c9cec18/uploads/origins/8b30ec85-e6a3-4ce6-8e6c-e13bed7f7906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e41417ed2a5a248ce7ceed71e981910, https://si.imgix.net/1c9cec18/uploads/origins/8b30ec85-e6a3-4ce6-8e6c-e13bed7f7906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=549e2857de08554617fcf2a1e20aa644 2x, https://si.imgix.net/1c9cec18/uploads/origins/8b30ec85-e6a3-4ce6-8e6c-e13bed7f7906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=3