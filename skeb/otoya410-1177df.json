-a91b-25cec9ea8f23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=302fa2e0ed96a56cc7348dcdc3e1c40d, https://si.imgix.net/71dde043/uploads/origins/c26f032d-fc2c-4b7d-a91b-25cec9ea8f23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=db7fc92a442805a8e169424b1a9f08ee 2x, https://si.imgix.net/71dde043/uploads/origins/c26f032d-fc2c-4b7d-a91b-25cec9ea8f23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=78c28c181b6c5ccff147b0515bb9e093 3x"}, "body": "はじめまして。乙矢さんの絵柄が好きで、リクエストさせていただけたらと思いご連絡させて頂きました。特に美しいお顔の作画が大好きです。\n\nクトゥルフ神話TRPG『鰯と柊』のPC(OC)である2名を描いていただきたいです。片方はフォロワーさんのキャラクターですが許可を得ています。\n\n二人の性格・関係性\nとある教団の教祖とその側近の信者ですが恋愛関係にありお互いに愛し合っていました。おっとりしつつも天真爛漫な教祖（身長177㎝）とクールでしっかりものですが教祖には甘いところがある信者（身長189ｃｍ）です。お姫様と王子様、お嬢様と執事のように振舞っていました。\n詳しい容姿は資料をご参照下さい。https://drive.google.com/drive/folders/1ljjTV-5SXnDZF1faSJZOBSA1Ph-8iYdQ?usp=drive_link\n\n雰囲気などはすべてお任せしますが結婚式、人魚姫のような雰囲気だと嬉しいです。\n\n金額が足りなければ再送していただけると嬉しいです。ご縁がありましたら幸いです。\n\nhttps://drive.google.com/drive/folders/1ljjTV-5SXnDZF1faSJZOBSA1Ph-8iYdQ?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@otoya410/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 635986, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3b47cb2a/uploads/origins/83e27f25-a3f3-469a-94a0-cad31d1775a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69d068effe817e177ff8eda66d18ccf1", "srcset": "https://si.imgix.net/3b47cb2a/uploads/origins/83e27f25-a3f3-469a-94a0-cad31d1775a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69d068effe817e177ff8eda66d18ccf1, https://si.imgix.net/3b47cb2a/uploads/origins/83e27f25-a3f3-469a-94a0-cad31d1775a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a11a8ce49fbb2593ce90c42a3c1f2ab 2x, https://si.imgix.net/3b47cb2a/uploads/origins/83e27f25-a3f3-469a-94a0-cad31d1775a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=932fef3f0cea87593cf6e4f777ccb3a0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b47cb2a/uploads/origins/83e27f25-a3f3-469a-94a0-cad31d1775a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e379b7e63ce3cf71f241f0a2e45c4ef", "srcset": "https://si.imgix.net/3b47cb2a/uploads/origins/83e27f25-a3f3-469a-94a0-cad31d1775a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e379b7e63ce3cf71f241f0a2e45c4ef, https://si.imgix.net/3b47cb2a/uploads/origins/83e27f25-a3f3-469a-94a0-cad31d1775a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a947862f8c0010dba1801ced6782f77a 2x, https://si.imgix.net/3b47cb2a/uploads/origins/83e27f25-a3f3-469a-94a0-cad31d1775a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=350a64a87ab394e056834bb5c362539b 3x"}, "body": "夜分遅くに失礼致します。\nいつもお世話になっております。\n乙矢さんの絵柄がずっと大好きで、この度またリクエストさせていただけたらと思いご連絡させて頂きました。\n\nもし可能であればクトゥルフ神話TRPG『鰯と柊』PC(OC)である2名を描いていただけないでしょうか。\n資料は別アカウントになりますが、CSを添付させていただきます。\n\n簡易説明と致しますと、2人はとある宗教団体の教祖と信者の関係です。白髪の方が教祖であり明るい兄貴肌。黒髪の方が信者であり寡黙で冷酷。\n教祖は信者に好かれているとは思わないけれど、嫌われているとも思っていない。信者は教祖に対して形はどうであれ信じている。\n二人の関係は言葉で言い表すのは難しいのですが、お互い信じ合い共に過ごしてきた時間は他の誰よりも多いかけがえのない存在です。\n参考までに身長の記載をさせていただきます。\n身長185cm(教祖)\n        170cm(信者)\n\n構図や雰囲気などは乙矢さんの描きやすいもので構いません。可能であれば服装は教団服(キービジュアルである黒い服装)であると嬉しいです。\nですが是非乙矢さんの感じたこの2人を見てみたいと思っておりますので、描きやすいものでお願いします。\n\nなかなか難しいリクエストというのは重々承知ですので、懸念点やスケジュールの関係上難しいものがございましたらキャンセルして頂いて問題ないです！ご無理のない範囲でお願いしたく思います。\n今後もお体に気をつけて素敵な作品を描いてください！\n\n逢摩四葩(白髪教祖の方)\nhttps://x.com/hagaki0220/status/1905214757650813153?s=46&t=XdODKT0XBcXPpok5Ifd6Fg\n\n櫟羅刹(黒髪信者の方)\nhttps://x.com/k_min115/status/1913241276323156233?s=46&t=XdODKT0XBcXPpok5Ifd6Fg\n\n羽咲羽深", 