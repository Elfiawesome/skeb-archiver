-d88f-423f-b6b0-9b736daf79a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07b9fc240ed20ac55df29375b21abc00 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e6c58d6/uploads/origins/bd9b2f93-d88f-423f-b6b0-9b736daf79a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae0e69215257db5939a3cd459fe1fb09", "srcset": "https://si.imgix.net/1e6c58d6/uploads/origins/bd9b2f93-d88f-423f-b6b0-9b736daf79a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae0e69215257db5939a3cd459fe1fb09, https://si.imgix.net/1e6c58d6/uploads/origins/bd9b2f93-d88f-423f-b6b0-9b736daf79a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d75ff2cd991adbc9a48b4487e097d1a0 2x, https://si.imgix.net/1e6c58d6/uploads/origins/bd9b2f93-d88f-423f-b6b0-9b736daf79a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0997d0a9f792de2a4036b70833619b4a 3x"}, "body": "セミしんでる様はじめまして、ふぃらむと申します！TLで貴方様のツイを見、是非うちの子二人の漫画風イラストを描いて頂きたいと思いリクエストをしました！\n\n\n▽世界観\n世界観は冒険者が樹海のダンジョンの最奥を目指し探索するファンタジー。\n\n▽キャラクター詳細\nアヴェル\n性別:女\n年齢:17\n物語の主人公かつ、ギルド『アウローラ』のリーダー。一見クールだがかなり気が強く情に熱い性格。父に憧れて冒険者になったものの、その父は探索の序盤に亡くなっていることが判明し、父の遺品である指輪をペンダントにし、常に持ち歩いている。仲間とはどうあるべきかをよく考えており、誰か一人に無理をさせるという行為は絶対にさせないようにしている。得意なことは喧嘩。苦手なことは料理(味は悪くないけど見た目がとにかく悪い。)\n\nディケ\n性別:男\n年齢:16\n明るく好奇心旺盛な良くも悪くも子供っぽい性格。特殊な獣人と人間のハーフで、かなりの身体能力を持っている。一見ただの少年のような印象を抱くが、何よりも理性的であることを大事にしているため、危機的状況でも適切な判断ができる。街中で知り合いを見かけたら後ろからドーンと抱きつきに来たり、肩を組みに行ったりかなり人に接する時の距離は近め。得意なことは戦うことと観察眼。苦手なことは字を書くこと(解読不可の汚さ)\n\n\n▽関係性\n二人は相棒関係。相棒だが、ディケは自覚ありの恋愛感情を抱いており、一方アヴェルは無自覚な恋愛感情を抱いている。ただし普段の感情は相棒関係が優先されているため意識しなければ距離が近くとも気にしていない。\n一見すれば子供っぽいディケがアヴェルを振りまわしているように見えるが、実際は気の強いアヴェルが振りまわしていることが多い(基本的にアヴェルが優位にいる)\nまた、戦闘力で言うと圧倒的にディケの方が上だが、それに対してアヴェルは劣等感を抱くことはなく、モンスターからの攻撃をディケが刀で弾いてくれる度に「絶対に同じくらい強くなるんだから」と目を燃やす。\nまた、アヴェルはディケのことを「太陽」だと例えており、ディケはアヴェルのことを「焔」だと例えている。\n\nシチュなんですけど、暗くて救いがなくても良いならドライブに入っている「深い設定」のどこか1シーンを描いて頂けると嬉しいです\n\n\n\n○使用用途\n鑑賞、自慢\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1jqyJCfYpuv5j4KitSGsILQ1LRV9IdcdP?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@0655minQ/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3597005, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/56841b3d/uploads/origins/a5d17f85-95d5-4b6f-bcbc-2461135d8322?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f7d8badb35dc924a7895eac6b988d84", "srcset": "https://si.imgix.net/56841b3d/uploads/origins/a5d17f85-95d5-4b6f-bcbc-2461135d8322?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f7d8badb35dc924a7895eac6b988d84, https://si.imgix.net/56841b3d/uploads/origins/a5d17f85-95d5-4b6f-bcbc-2461135d8322?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3627ab9f415809290cfb5f6952a1244 2x, https://si.imgix.net/56841b3d/uploads/origins/a5d17f85-95d5-4b6f-bcbc-2461135d8322?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3209d97230e4cce1cdf72583c96a4a4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56841b3d/uploads/origins/a5d17f85-95d5-4b6f-bcbc-2461135d8322?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e03855eb8ae5112e6da23a76f830af98", "srcset": "https://si.imgix.net/56841b3d/uploads/origins/a5d17f85-95d5-4b6f-bcbc-2461135d8322?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e03855eb8ae5112e6da23a76f830af98, https://si.imgix.net/56841b3d/uploads/origins/a5d17f85-95d5-4b6f-bcbc-2461135d8322?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e57f0d8d42a96fcde743a7882e68d5db 2x, https://si.imgix.