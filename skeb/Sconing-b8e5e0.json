2人を描いて頂く形でも問題ありません○\n\n➤全体の雰囲気として比較的暗めの物であれば嬉しいですが、描きやすい、合いそうなものを選んで描いて頂けますと幸いです。\n\n・服装は特に指定がございません。\n資料内にある立ち絵の物でも、その他似合いそうな物があれば着せて頂ければと考えております。\n\n分かりにくい部分は適宜改変していただいて問題ございません〇\n\n\nもし金額が不足している、または内容に問題等ございましたら、お手数ですが、再送をしていただけますと幸いです。\n\nご検討いただけましたら大変嬉しいです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ZVFIiNb6nMPnAH_32t6jgn6dbJZg2sxK?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sconing/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3334778, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a91aa57/uploads/origins/47c4e69a-acce-498b-885d-292fc061c67a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6440fa86e71830065cc897068b894806", "srcset": "https://si.imgix.net/6a91aa57/uploads/origins/47c4e69a-acce-498b-885d-292fc061c67a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6440fa86e71830065cc897068b894806, https://si.imgix.net/6a91aa57/uploads/origins/47c4e69a-acce-498b-885d-292fc061c67a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=175621ffafbe299b70f4c4a0c97befe6 2x, https://si.imgix.net/6a91aa57/uploads/origins/47c4e69a-acce-498b-885d-292fc061c67a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6fa39fb84043ac10e822aebb60e1bbc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a91aa57/uploads/origins/47c4e69a-acce-498b-885d-292fc061c67a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8276b36fa2611e6f0c147fb29617cb47", "srcset": "https://si.imgix.net/6a91aa57/uploads/origins/47c4e69a-acce-498b-885d-292fc061c67a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8276b36fa2611e6f0c147fb29617cb47, https://si.imgix.net/6a91aa57/uploads/origins/47c