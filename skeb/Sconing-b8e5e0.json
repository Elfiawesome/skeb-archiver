dc-768f-4f1c-8800-73df100c21f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef5f629439a36ec8722251c960dee56a, https://si.imgix.net/110ab169/uploads/origins/7a1570dc-768f-4f1c-8800-73df100c21f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=756030bb25ea1d2e740654f3a7997652 2x, https://si.imgix.net/110ab169/uploads/origins/7a1570dc-768f-4f1c-8800-73df100c21f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7edb64b5c98a6155190a54f7cb64b8e6 3x"}, "body": "酢昆布様こんばんは！みゅーと申します。\nYouTubeでVTuberとして活動しております。\n\nかわいらしいイラストを拝見させていただき、絵柄がとっても好みだったので\nもし良ければ描いていただければと思い連絡させて頂きました。\n\n\n当方、みゅー・あうろーらのイラストを依頼させていただければと思います。\n\n\n衣装や構図、ポーズに関してはお任せします。当方の衣装でもよいですし何かしらのコスプレでも構いません。座っていても寝ていてもどのような角度でもかまいません。ゲームのキャラ風でも何かのボカロ曲モチーフでもOKです。セクシーなものでも問題ありません！\n酢昆布様の趣味やフェチ、性癖などを全開で盛り込んでいただければと思います。\n（前髪は片目隠れでお願いします。表情豊かだとうれしいです。）\n\n\n\n人物の透過PNGかPSDを合わせて頂ければ嬉しいです。\n\n\n用途はXでの投稿や収益化したライブ配信や動画、アイコンやヘッダー使用、ネットプリント、グッズ、ファンボックスなどのVTuberとしての活動で使用させていただければと思っております。\n\n資料は下記URLから確認していただければと思います。\n\n\n\nスケブでの依頼は慣れていないので至らない点があると思いますが、よろしくお願いします。\n\n\n\n\n\n\nhttps://lit.link/mewaurora\n\nhttps://lit.link/mewaurora", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sconing/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3334778, "client_id": 3802365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e20f5db/uploads/origins/69e4259e-624c-4ce7-a2a6-d91f35cf3bb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5c249fca465597819bdc44291cc813b", "srcset": "https://si.imgix.net/8e20f5db/uploads/origins/69e4259e-624c-4ce7-a2a6-d91f35cf3bb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5c249fca465597819bdc44291cc813b, https://si.imgix.net/8e20f5db/uploads/origins/69e4259e-624c-4ce7-a2a6-d91f35cf3bb1?bg=%23