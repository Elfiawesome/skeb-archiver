oads/origins/13368970-22ea-493a-bd26-4b277dd4eb66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=189ab55473cb4f806c8bc41bb1a1a2c2 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3510263, "client_id": 231344, "nc": 161}, {"path": "/@karutosu_se/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3510263, "client_id": 71755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dec58c7a/uploads/origins/8b094eaf-8023-4493-8a86-0f120c58093e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ee4c4d1630f9ec029b0838fba0d834a", "srcset": "https://si.imgix.net/dec58c7a/uploads/origins/8b094eaf-8023-4493-8a86-0f120c58093e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ee4c4d1630f9ec029b0838fba0d834a, https://si.imgix.net/dec58c7a/uploads/origins/8b094eaf-8023-4493-8a86-0f120c58093e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78128eeadec71ced89abf12cbb507e71 2x, https://si.imgix.net/dec58c7a/uploads/origins/8b094eaf-8023-4493-8a86-0f120c58093e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cabd23c2c6c0987f3c4f02385040f633 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dec58c7a/uploads/origins/8b094eaf-8023-4493-8a86-0f120c58093e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ca32121ba88c4fa31986dab402ba059", "srcset": "https://si.imgix.net/dec58c7a/uploads/origins/8b094eaf-8023-4493-8a86-0f120c58093e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ca32121ba88c4fa31986dab402ba059, https://si.imgix.net/dec58c7a/uploads/origins/8b094eaf-8023-4493-8a86-0f120c58093e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bfdc29442c3ca68b651f9a35ca67a112 2x, https://si.imgix.net/dec58c7a/uploads/origins/8b094eaf-8023-4493-8a86-0f120c58093e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7c4bdd94a53a5c3178442d09d890ade4 3x"}, "body": "書くかも程度ですがドM小説の挿絵に使いたいです\nシチュ：\n着衣超魔乳&着衣ボテ腹姿の陽鞠&糸青(身長は陽鞠>糸青希望)にゴミを見るような冷めた目で嫌悪・侮蔑されながら、添い寝されている男が両サイドから二人の触手満載の咥内で乳首を嫐られ、えぐい構造の粘液たっぷりの触手オナホコキで大量搾精させられるMシチュ\n二人ともゴミを見る冷めた目(顔の上部や目元まで影がかかる感じでハイライトなし)で、変態マゾへの嫌悪を一切隠すことない侮蔑の表情を希望します\n\n触手咥内は花のように開くブラシ状触手、吸盤触手に加えて咥内壁や本来の舌自体も粘液まみれの襞や繊毛などが密集した触手地獄で、\n乳首を引っ張ったり吸引したり、乳腺をイジメる構造の触手を希望します\n\n二人とも全身粘度の高い粘液まみれで全身がどろどろ&べとべとで超魔乳やボテ腹に服がべっとりと張り付き、\n両手が簡単に沈む程柔らかく、片乳だけで両腕でも抱え込むことができず頭&胴体以上サイズかつ服越しでもピンク色の透け勃起乳首がわかる着衣超魔乳と、\nそれと同サイズでの特大着衣ボテ腹(妊娠淫紋付き)が衣装の中にギチギチに押し込まれ強調され、\n上記より優先度低で超魔乳やボテ腹内部に孕んだ、粘液まみれの大量の触手が蠢き外から見ても歪に変形している描写希望です\n\nペニスは肉々しいえぐい構造の触手オナホにモザイク不要レベルで完全に呑み込まれており結合部から粘液と共に内部のブラシ触手や精子が溢れている描写をお願いします\nまた可能でしたら背景に同様の構造の粘液まみれの触手オナホが口を開いて中を見せつけている様子もお願いします\n\n触手肉壁やダーク系の背景で、可能でしたらpsd形式で射精差分、粘液まみれの触手が蠢く水音やM男の情けなさすぎる懇願や喘ぎ声等の効果音の有無、二人の顔上部の影と瞳のハイライトの有無をON/OFF切替表示希望です\n優先度最低で異形の触手に悦んで射精する変態マゾへの罵倒・侮蔑台詞有無(口調お任せ)と\n更に低で、老いも死も赦されず、尿道を常時解放して永遠に精液を垂れ流し精巣で触手まで孕むザーメンタンクに改造してあげる、的な台詞の有無希望です\n\nシチュ参考：\nhttps://drive.google.com/drive/folders/11dqU7KZkq7ilGJdrVFXEl3PyIuckk8EB?usp=sharing\nキャラ参考\n\nhttps://drive.google.com/drive/folders/1Mhyo3P-YVjBW16vbBxRl7-391lBzY2gn?usp=sharing", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 64761, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゴリオ🔞Skeb募集中", "screen_name": "Gorio4288", "avatar_url": "https://pbs.twimg.com/profile_images/1878092536478412801/3X780hnH.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days"