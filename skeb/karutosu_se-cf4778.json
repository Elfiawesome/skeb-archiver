200&h=200&s=6f43745f06739ccae00540ef083b2045, https://si.imgix.net/55a2ba7b/uploads/origins/b4dad026-ffe4-4007-8ee9-fd26fac7ec30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d40462f6ab0ac7294b56e9b72c77977 2x, https://si.imgix.net/55a2ba7b/uploads/origins/b4dad026-ffe4-4007-8ee9-fd26fac7ec30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15a129b7e3b4352a9fcdeb711d702c54 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55a2ba7b/uploads/origins/b4dad026-ffe4-4007-8ee9-fd26fac7ec30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ae219846671dc8d540907226e87debe", "srcset": "https://si.imgix.net/55a2ba7b/uploads/origins/b4dad026-ffe4-4007-8ee9-fd26fac7ec30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ae219846671dc8d540907226e87debe, https://si.imgix.net/55a2ba7b/uploads/origins/b4dad026-ffe4-4007-8ee9-fd26fac7ec30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f57df2a3421f333c18224c31fcedc118 2x, https://si.imgix.net/55a2ba7b/uploads/origins/b4dad026-ffe4-4007-8ee9-fd26fac7ec30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2f62093a736da6fa040488622f160ec4 3x"}, "body": "初依頼失礼します\n知り合いのOCの白い狐な女の子とうちのOCの男の組み合わせで描いてもらいたいです\n作者側から諸々の許諾は得ておりますのでご心配なく\n参考資料をドライブに用意しておきました\n\n\n【描いてほしい内容・重要な要素】\n・水色系のマイクロビキニ(デザインの詳細はお任せします)着用でパイズリまたはパイズリフェラ\n・結婚しているので指輪付き(重要/男性側と相互/片方は見えて欲しい)\n・サインや台詞がある場合はレイヤー等でオンオフ切り替えができると幸いです\n\n女性側の要点\n・身長は170cm\n・顔は見えてほしい\n・エッチな事は好き(快楽には素直　というか弱い)\n・受けか攻めかで言うと受け寄り\n・若干こっちの方がお姉さんなのでご奉仕などでリードできる時はしたい感じ\n・着痩せする方なので胸はかなり大きめ\n・普段はクールな性格だが婚約者の前ではやや恥じらいが出る\n・アヘ顔とかひょっとこ顔みたいな下品寄りなのは避けてほしい\n\n男性側の要点\n・身長は189cm\n・筋肉の引き締まった細身、所謂細マッチョ(青年想定)\n・男側の描写量は肌色があまり濃すぎない事以外は必要最低限でお願いします(他のリク絵のように手や身体の一部が映る程度、極論体色や体格がよほど乖離してなければそこまで問題ありません)\n\n\nあると嬉しい要素(可能な限りで構いません)\n・耳や尻尾の感情表現(耳や尾を動かしたりとか)\n\nよろしければご検討頂けると幸いです\nまた、完成品は他に依頼を行う時に参考資料として引用する事をご了承ください\n\nhttps://drive.google.com/drive/folders/1kqC3Vi0yw4Hk0MvLAhSg0hDqMoRizCdl?usp=sharing", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karutosu_se/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3510263, "client_id": 826500, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/49149514/uploads/origins/16ff80a8-5b7e-46c0-a368-c74357b98087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b70ee10b56c49d495f8f9f08284a0be", "srcset": "https://si.imgix.net/49149514/uploads/origins/16ff80a8-5b7e-46c0-a368-c74357b98087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b70ee10b56c49d495f8f9f08284a0be, https://si.imgix.net/49149514/uploads/origins/16ff80a8-5b7e-46c0-a368-c74357b98087?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5af4a4db372b0232acb9ebdee4fadf7b 2x, https://si.imgix.net/49149514/uploads/origins/16ff80a8-5b7e-46c0-a368-c74357b98087?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbb2952fc848deacfc478ee9d505fbc3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/49149514/uploads/origins/16ff80a8-5b7e-46c0-a368-c74357b98087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4852dd0e762c737b5256fdc16dc752fc", "srcset": "https://si.imgix.net/49149514/uploads/origins/16ff80a8-5b7e-46c0-a368-c74357b98087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4852dd0e762c737b5256fdc16dc752fc, https://si.imgix.net/49149514/uploads/origins/16ff80a8-5b7e-46c0-a368-c74357b98087?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a4436564ea2f649dfa6a56c5df519689 2x, https://si.imgix.net/49149514/uploads/