ET等）に関連する公式の意匠を用いることだけ避けるようにお願いします。\n\nまた、私のSNS等で利用させていただきます。\n\n参考画像のURL\nhttps://00m.in/XhoRQ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MOOTION_moon/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4083535, "client_id": 3865775, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cda8200a/uploads/origins/46531ec0-34c2-4017-8963-e6974c970024?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=939d08313444ce9869bae998b30e3e43", "srcset": "https://si.imgix.net/cda8200a/uploads/origins/46531ec0-34c2-4017-8963-e6974c970024?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=939d08313444ce9869bae998b30e3e43, https://si.imgix.net/cda8200a/uploads/origins/46531ec0-34c2-4017-8963-e6974c970024?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba21e45a35d9a5c5ad3a376bd0dac583 2x, https://si.imgix.net/cda8200a/uploads/origins/46531ec0-34c2-4017-8963-e6974c970024?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb3e0f3270838790868f24035199c687 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cda8200a/uploads/origins/46531ec0-34c2-4017-8963-e6974c970024?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ced67582c07f17313fde77707f478979", "srcset": "https://si.imgix.net/cda8200a/uploads/origins/46531ec0-34c2-4017-8963-e6974c970024?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ced67582c07f17313fde77707f478979, https://si.imgix.net/cda8200a/uploads/origins/46531ec0-34c2-4017-8963-e6974c970024?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=837a20930a2dee42f0be28c9a0875100 2x, https://si.imgix.net/cda8200a/uploads/origins/46531ec0-34c2-4017-8963-e6974c970024?bg=%