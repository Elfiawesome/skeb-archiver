しくお願いします！", "nc": 35, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@goutumipenguin/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2630783, "client_id": 3141611, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/887cec35/uploads/origins/9bb23ae7-05d4-4de9-b5f9-dfe8032d0894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=558db430b05143e706a0cc18a1cfbaa6", "srcset": "https://si.imgix.net/887cec35/uploads/origins/9bb23ae7-05d4-4de9-b5f9-dfe8032d0894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=558db430b05143e706a0cc18a1cfbaa6, https://si.imgix.net/887cec35/uploads/origins/9bb23ae7-05d4-4de9-b5f9-dfe8032d0894?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4500abc73173a6f3de1e45e6473d0ca 2x, https://si.imgix.net/887cec35/uploads/origins/9bb23ae7-05d4-4de9-b5f9-dfe8032d0894?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=270e4d4759e83d4efd97a8b41ecb4438 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/887cec35/uploads/origins/9bb23ae7-05d4-4de9-b5f9-dfe8032d0894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e98c1a34a9005be17ef837977ee7859", "srcset": "https://si.imgix.net/887cec35/uploads/origins/9bb23ae7-05d4-4de9-b5f9-dfe8032d0894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e98c1a34a9005be17ef837977ee7859, https://si.imgix.net/887cec35/uploads/origins/9bb23ae7-05d4-4de9-b5f9-dfe8032d0894?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=92b9885d013dd8a30326172001dc15d2 2x, https://si.imgix.net/887cec35/uploads/origins/9bb23ae7-05d4-4de9-b5f9-dfe8032d0894?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=300c