スを指してるところを描いてほしいです。\nいつぞやの公式Q＆Aで交友関係が明かされてからずっと見たかった場面なのでお願いします。\n\n場所はエヴァ様の部屋でもいいですが、屋外の爽やかな日差しが差し込む木陰にテーブルと椅子を置いて優雅に指してる感じでお願いします。イメージとしては昼の陰陽寮の庭みたいな雰囲気の場所です。\n参考↓\nhttps://www.pixiv.net/artworks/77980090\nhttps://www.pixiv.net/artworks/96704192\n\nチェス以外の小道具は適当に追加してもらって大丈夫です。置けそうだったらティーカップとか置いちゃいましょう。\n\n構図、ポーズともに指定無しです。彼女達っぽい感じでお願いします。\n\nhttps://pc-play.games.dmm.co.jp/play/ayarabux/", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@moritensecond/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1527042, "client_id": 2177561, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30d31316/uploads/origins/3369e96a-9d3a-4ce2-92f2-61ca52119cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=095c21691f4f112b27a0c1230395c87f", "srcset": "https://si.imgix.net/30d31316/uploads/origins/3369e96a-9d3a-4ce2-92f2-61ca52119cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=095c21691f4f112b27a0c1230395c87f, https://si.imgix.net/30d31316/uploads/origins/3369e96a-9d3a-4ce2-92f2-61ca52119cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad333b579aa9e61f81cfe2a99732ff0c 2x, https://si.imgix.net/30d31316/uploads/origins/3369e96a-9d3a-4ce2-92f2-61ca52119cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ec4e539d3313545bc431acdf7b25184 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30d31316/uploads/origins/3369e96a-9d3a-4ce2-92f2-61ca52119cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca0f6d8490e02a305ad80866c0823c80", "srcset": "https://si.imgix.net/30d31316/uploads/origins/3369e96a-9d3a-4ce2-92f2-61ca52119cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca0f6d8490e02a305ad80866c0823c80, ht