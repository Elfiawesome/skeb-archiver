ur=200&s=d54294719db58c6425bdba48b187159c 2x, https://si.imgix.net/30f19fd5/uploads/origins/46188fd8-205a-401a-8b8f-33a1d8a8b659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a369cf83a64fcfd71089a005c7aae3d 3x"}, "body": "こんにちは！\nうちの子の笠鬼　聖(かさぎ　ひじり)とよその子の神沢　愛熱火(かみざわ　あつか)ちゃんをお願いしたいです。\n許可はいただいています！\n\n●笠鬼聖の設定\n性別　女性\n種族　鬼人族\n職業　侍\n年齢　20歳\n身長　162cm\n性格　素直で嘘をつけない。人命と縁を何より大事にする。\nその他特徴と設定　科学の代わりに魔術が栄える異世界日本の京都に位置する鬼の国で生まれ育った王女。お家騒動で実家から追い出されて人族の旅人さんと異世界出雲に向けて旅をしている。\n口調　一人称は親しい相手には聖、それ以外には私。害のない相手には人懐っこく物腰丁寧。ですます調多め。\nhttps://twitter.com/party_room/status/1734289774834524397\n\n愛熱火ちゃんには固有の設定がないので描きやすいように描いてください！\nhttps://imgchest.com/p/xny8zjzwwyb\n★\nお風呂セットを持った2人。聖が愛熱火ちゃんの手を引き、どの温泉に入るか悩みながら温泉街を歩く姿を描いていただけたら嬉しいです！\n\n使用用途はコミッションで依頼する際の資料です。\nご検討いただけますと幸いです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Asahi_Illustrator/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3344993, "client_id": 2011192, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6620cfa/uploads/origins/f567de35-1030-406d-a4bf-38ff1562dbb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c76541d1415e8ffc7f36e525ca681a72", "srcset": "https://si.imgix.net/d6620cfa/uploads/origins/f567de35-1030-406d-a4bf-38ff1562dbb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c76541d1415e8ffc7f36e525ca681a72, https://si.imgix.net/d6620cfa/uploads/origins/f567de35-1030-406d-a4bf-38ff1562dbb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6cf8a3de29e5c0561025556716e53d0 2x, https://si.imgix.net/d6620cfa/uploads/origins/f567de35-1030-406d-a4bf-38ff1562dbb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16c3140f1a641ac9ec56a115fead1d8b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": 