股中腰で腰を突き出し、片手でくぱぁ、もう片方の手でピースしているというポーズでお願いします。\n表情は困り眉の笑顔で、恥ずかしさを頑張ってごまかしている感じでお願いします。\n可能でありましたら大きく水溜りが出来てしまっているのにまだまだ勢いよくおしっこが出続けて（止まんないよぉ……）と半べそになっている差分がありますと嬉しいです。\nご検討のほどよろしくお願いします\n\nhttps://pbs.twimg.com/media/FnKFlKTakAAtr95.jpg", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mizumori_ri/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2661431, "client_id": 1887057, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b5892cc/uploads/origins/13b642c4-5f92-4587-bf11-446df89774b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1919cb9946ede6d299e68303bc8f6345", "srcset": "https://si.imgix.net/8b5892cc/uploads/origins/13b642c4-5f92-4587-bf11-446df89774b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1919cb9946ede6d299e68303bc8f6345, https://si.imgix.net/8b5892cc/uploads/origins/13b642c4-5f92-4587-bf11-446df89774b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a3e1bce7886787642768277fbfabc63 2x, https://si.imgix.net/8b5892cc/uploads/origins/13b642c4-5f92-4587-bf11-446df89774b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f26b2fa8621626095b439b26893b4ba 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b5892cc/uploads/origins/13b642c4-5f92-4587-bf11-446df89774b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5641955218d1cd94f3db4f02208dd90f", "srcset": "https://si.imgix.net/8b5892cc/uploads/origins/13b642c4-5f92-4587-bf11-446df89774b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5641955218d1cd94f3db4f02208dd90f, https://si.imgix.net/8b5892cc/uploads/origins/13b642c4-5f92-4587-bf11-446df89774b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200