せ\nファイル形式：カラー、png（可能であればpsdも）\n\n■使用用途\n友人との共有観賞用（スマホやPCの壁紙、SNSのアイコン等）\n\n初心者故不手際ございましたら申し訳ありません。金額が合わないなどあれば再送いただけると幸いです。\nご検討の程よろしくお願いいたします︎！\n\nhttps://drive.google.com/drive/folders/1p3NJ1aT5GM6GrLKiVYNww52-ihsQwmC4", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SakoMdms/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d4576bbd/uploads/origins/4184da99-2b60-4f0d-85e9-577a57fe2390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=97317632fa24298e5381539b580e23a8", "srcset": "https://si.imgix.net/d4576bbd/uploads/origins/4184da99-2b60-4f0d-85e9-577a57fe2390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=97317632fa24298e5381539b580e23a8, https://si.imgix.net/d4576bbd/uploads/origins/4184da99-2b60-4f0d-85e9-577a57fe2390?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8196833dd458972df518b74495f6811c 2x, https://si.imgix.net/d4576bbd/uploads/origins/4184da99-2b60-4f0d-85e9-577a57fe2390?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a1829ef162743ba83ed6f7171966abc 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1181058, "nc": 145}, {"path": "/@SakoMdms/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1181058, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f055e60/uploads/origins/b4dd0fab-f341-4ea3-9ece-1f79e9d2ee79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1167c8290ddd151122