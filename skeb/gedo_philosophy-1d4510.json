68b4c9c-4a03-49bd-b7c5-b23fdecd9133?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a68e985e3269c7a5ee279fdd882b894f", "srcset": "https://si.imgix.net/c56a9c5d/uploads/origins/d68b4c9c-4a03-49bd-b7c5-b23fdecd9133?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a68e985e3269c7a5ee279fdd882b894f, https://si.imgix.net/c56a9c5d/uploads/origins/d68b4c9c-4a03-49bd-b7c5-b23fdecd9133?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=80fde667cb6f6c2dd6bd2864995db1b1 2x, https://si.imgix.net/c56a9c5d/uploads/origins/d68b4c9c-4a03-49bd-b7c5-b23fdecd9133?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=968869eb90fbd43d633281b45b987115 3x"}, "body": "同級生と対峙した桜坂しずくの続きのストーリーをお願いします\n\n内容\n桜坂しずくのトドメのヒップアタック→金網際にもたれかかりKOされた男にスティンクフェイス\n\nヒップアタックのアングルは、しずくのお尻を斜めから見た角度からで、台詞もお願いします\nスティンクフェイスのアングルはしずくのお尻側からで、セリフもお願いします\nこちらのセリフの内容は\n・お尻丸出しの女の子にボコボコにされて負けるなんて恥ずかしくないのかと煽る\n・ヒップアタックの威力はどうだったか聞いて、女の子のお尻にトドメを刺されて負けたことを煽る\n・運動が出来ないあなたじゃ私には勝てないよねと煽る\n・付き合うことは出来ないからせめてこのお尻の形と感触を脳裏に焼き付けてあげる、せいぜい自慰に励めと言い放つ\nこのようなものでお願いします\nどちらも今まで通り男無し差分をお願いします\nしずくの衣装は前回に引き続き下半身裸の上ビキニで、それにリングブーツを履かせてください(https://images.app.goo.gl/FwZZe ←みたいなもの。シワシワのあるブーツではなくてリンク先にあるもののような表面がツルツルしたものでお願いします。色は水色で、細かなデザインは任せます)\n\n男は普通に下半身に何か履かせてください。ボクサーが履いてるような半ズボンだと好ましいです。男は素足で大丈夫です", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gedo_philosophy/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 876002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/494cbc4a/uploads/origins/9e50d132-b9e3-4f21-a07d-3571413009bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39739147eba2c42d670f7c1e7803598c", "srcset": "https://si.imgix.net/494cbc4a/uploads/origins/9e50d132-b9e3-4f21-a07d-3571413009bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39739147eba2c42d670f7c1e7803598c, https://si.imgix.net/494cbc4a/uploads/origins/9e50d132-b9e3-4f21-a07d-3571413009bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69d8b89cc64a8695600ea7582c755b11 2x, https://si.imgix.net/494cbc4a/uploads/origins/9e50d132-b9e3-4f21-a07d-3571413009bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f314a0d462e093ecc214ff22c8069d4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/494cbc4a/uploads/origins/9e50d132-b9e3-4f21-a07d-3571413009bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=195c2af2ed0084a46679445746a33fe6", "srcset": "https://si.imgix.net/494cbc4a/uploads/origins/9e50d132-b9e3-4f21-a07d-3571413009bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=195c2af2ed0084a46679445746a33fe6, https://si.imgix.net/494cbc4a/uploads/origins/9e50d132-b9e3-4f21-a07d-3571413009bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e1c32ba5e6a0709f450eb607163f055 2x, https://si.imgix.net/494cbc4a/uploads/origins/9e50d132-b9e3-4f21-a07d-3571413009bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0ca931d90dac5a854fdffc44ff36ffa8 3x"}, "body": "桜坂しずくが中学時代の同級生(男)と金網内のリングで対峙するイラストをお願いします\n構図は、男視点で見たしずくの姿で、しずくは男に尻を向けて立っていて、男に対して話しかけている、といったものでお願いします\n話しかける台詞の内容は、以下のものでお願いします\n・中学時代の同級生だということを覚えていて、久しぶりだと話す\n・こんな場所で会うなんて偶然だね\n・知ってる男の子に裸のお尻見られちゃうの恥ずかしい\n・男が自分に片思いしてたことを知っていた\n・勝てたらお付き合いしてあげる\n・しずくの衣装はえいがさきの時の水着衣装で、下ビキニを脱いだ下裸でお願いします", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gedo_philosophy/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 876002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89d1c6a2/uploads/origins/b780fd4c-f8dd-40ef-a93a-9be40f81bad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddb8bea0bba16503ad62c83b8a2189d7", "srcset": "https://si.imgix.net/89d1c6a2/uploads/origins/b780fd4c-f8dd-40ef-a93a-9be40f81bad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddb8bea0bba16503ad62c83b8a2189d7, https://si.imgix.net/89d1c6a2/uploads/origins/b780fd4c-f8dd-40ef-a93a-9be40f81bad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fbc7afdf038ba9179839d29e82ec141 2x, https://si.imgix.net/89d1c6a2/uploads/origins/b780fd4c-f8dd-40ef-a93a-9be40f81bad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5113873dcdd5a20f3495a42fc194f82b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89d1c6a2/uploads/origins/b780fd4c-f8dd-40ef-a93a-9be40f81bad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7092f35923fcd3ab435a873503f8f4bd", "srcset": "https://si.imgix.net/89d1c6a2/uploads/origins/b780fd4c-f8dd-40ef-a93a-9be40f81bad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7092f35923fcd3ab435a873503f8f4bd, https://si.imgix.net/89d1c6a2/uploads/origins/b780fd4c-f8dd-40ef-a93a-9be40f81bad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a872a7682cdcd7e9f4563fe99dbcf66b 2x, https://si.imgix.net/89d1c6a2/uploads/origins/b780fd4c-f8dd-40ef-a93a-9be40f81bad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b71acdb64d1fdd565e03027b5182a0b1 3x"}, "body": "虹ヶ咲の桜坂しずくちゃんが男に金網リング上でハイキックしてるイラストをお願いしたいです\n\n 衣装はえいがさきの時の水着で、下半身は裸でお願いします \n\nまた、以前の栞子の時と同様、しずくのお尻がほぼ丸々見えるアングルからでお願いします\n\nしずくもまたお尻の谷間をくっきりと描いて頂きますよう、お願いいたします\n栞子の時のように差分を頂けますと幸いです。また、男の衣装はボクサーがよく履いている半ズボンでお願いします(ズボンが見切れる場合は描かなくても大丈夫です)\n\nセリフもいただきたいです", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gedo_philosophy/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 876002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/43cb2e27/uploads/origins/b185b6e8-7a4a-41db-b129-c9b31fb2a190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=624ac95d495e491a6f33198d906bcf2b", "srcset": "https://si.imgix.net/43cb2e27/uploads/origins/b185b6e8-7a4a-41db-b129-c9b31fb2a190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=624ac95d495e491a6f33198d906bcf2b, https://si.imgix.net/43cb2e27/uploads/origins/b185b6e8-7a4a-41db-b129-c9b31fb2a190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a608574a2e09046c1c68872745148c7 2x, https://si.imgix.net/43cb2e27/uploads/origins/b185b6e8-7a4a-41db-b129-c9b31fb2a190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3020cd077a3037ccbc2a2b50e334209 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/43cb2e27/uploads/origins/b185b6e8-7a4a-41db-b129-c9b31fb2a190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86f4542aba748cf2a0e413c725b2e427", "srcset": "https://si.imgix.net/43cb2e27/uploads/origins/b185b6e8-7a4a-41db-b129-c9b31fb2a190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86f4542aba748cf2a0e413c725b2e427, https://si.imgix.net/43cb2e27/uploads/origins/b185b6e8-7a4a-41db-b129-c9b31fb2a190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3d86dadc8df3d0d894ff09feb3c7509f 2x, https://si.imgix.net/43cb2e27/uploads/origins/b185b6e8-7a4a-41db-b129-c9b31fb2a190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05ef816dee2ab2e40a201fe6878e1947 3x"}, "body": "虹ヶ咲のランジュに負けた男がランジュに顔面騎乗され辱められるイラストをおねがいします\n\nランジュの座り方はヤンキー座り(開脚してどかっと座り込む)で、ランジュの体の向きは男の足元側に向いていて、アングルはランジュの背中側からで、ランジュが男の顔を振り返りながら見下してるといった構図でお願いします\nお尻の谷間はくっきりと描いてくださると嬉しいです。\n\nランジュの衣装は前回に引き続き上ビキニの下裸で、リングブーツ(黒)を履かせてください。\n\nまた、ランジュが男を嘲笑するセリフもお願いいたします。年下の女にボコボコにされて、尻に敷かれていることを煽るセリフでお願いいたします", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gedo_philosophy/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 876002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4fedd76/uploads/origins/0cd3aff4-e6f0-46f2-be81-f1d5407b7d66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43af3d96a4dbf1d6a3d76661fcdca122", "srcset": "https://si.imgix.net/c4fedd76/uploads/origins/0cd3aff4-e6f0-46f2-be81-f1d5407b7d66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43af3d96a4dbf1d6a3d76661fcdca122, https://si.imgix.net/c4fedd76/uploads/origins/0cd3aff4-e6f0-46f2-be81-f1d5407b7d66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76c6f1c914944c52be9cadf41f54a3ac 2x, https://si.imgix.net/c4fedd76/uploads/origins/0cd3aff4-e6f0-46f2-be81-f1d5407b7d66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19015cf18e2c3d3e2b7d847581089407 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4fedd76/uploads/origins/0cd3aff4-e6f0-46f2-be81-f1d5407b7d66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2aea0b40278476a8421f6dc50b7a8acf", "srcset": "https://si.imgix.net/c4fedd76/uploads/origins/0cd3aff4-e6f0-46f2-be81-f1d5407b7d66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2aea0b40278476a8421f6dc50b7a8acf, https://si.imgix.net/c4fedd76/uploads/origins/0cd3aff4-e6f0-46f2-be81-f1d5407b7d66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3400a336bca697cfcf4e741d67061281 2x, https://si.imgix.net/c4fedd76/uploads/origins/0cd3aff4-e6f0-46f2-be81-f1d5407b7d66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e47f565275c85875b13058a509661e1 3x"}, "body": "虹ヶ咲のショウ・ランジュちゃんが男に金網リング上でハイキックしてるイラストをお願いしたいです\n\n 衣装は上半身は赤ビキニ、下半身は裸でお願いします \n\nまた、以前の栞子の時と同様、ランジュのお尻が見えるアングルでお願いします。\n\nランジュもまたお尻の谷間をくっきりと描いて頂きますよう、お願いいたします\n栞子の時のように差分を頂けますと幸いです。また、男の衣装はボクサーがよく履いている半ズボンでお願いします(ズボンが見切れる場合は描かなくても大丈夫です)\n\nセリフもいただきたいです", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gedo_philosophy/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 876002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e89572d/uploads/origins/a1bc0905-d217-404f-9318-3a59f771107a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe7894fd3529a9b327df0f655c4f3fdc", "srcset": "https://si.imgix.net/6e89572d/uploads/origins/a1bc0905-d217-404f-9318-3a59f771107a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe7894fd3529a9b327df0f655c4f3fdc, https://si.imgix.net/6e89572d/uploads/origins/a1bc0905-d217-404f-9318-3a59f771107a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e06c018efe8c2986d5cda4f1cf5c0a6d 2x, https://si.imgix.net/6e89572d/uploads/origins/a1bc0905-d217-404f-9318-3a59f771107a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb4fc720bac68ee98762978e041fd5b0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e89572d/uploads/origins/a1bc0905-d217-404f-9318-3a59f771107a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=159fb37c7a28462d46e202ffe630aa4b", "srcset": "https://si.imgix.net/6e89572d/uploads/origins/a1bc0905-d217-404f-9318-3a59f7711