e-499b-8867-90d2df8d2f7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbedabc28c8d829fa1d838c11569b7fb, https://si.imgix.net/46f31197/uploads/origins/eecb9e5f-5ede-499b-8867-90d2df8d2f7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45d2fa16c5a43618aa96ace97e103b42 2x, https://si.imgix.net/46f31197/uploads/origins/eecb9e5f-5ede-499b-8867-90d2df8d2f7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1df7a2bb29e7279777b05faae905409e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46f31197/uploads/origins/eecb9e5f-5ede-499b-8867-90d2df8d2f7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86721a1a03551b5fc02747c347d68b93", "srcset": "https://si.imgix.net/46f31197/uploads/origins/eecb9e5f-5ede-499b-8867-90d2df8d2f7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86721a1a03551b5fc02747c347d68b93, https://si.imgix.net/46f31197/uploads/origins/eecb9e5f-5ede-499b-8867-90d2df8d2f7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=926a39e994f73da79ec43538ac821546 2x, https://si.imgix.net/46f31197/uploads/origins/eecb9e5f-5ede-499b-8867-90d2df8d2f7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6953ede5f469da808263316e68ca660d 3x"}, "body": "こんにちは、はじめまして！私は「タイガ」という名のVTuberです。アイスクリームをモチーフにした、ちょっと「萌え」な魅力も兼ね備えたトラのキャラクターです。私のコンセプトは、ジグザグ模様と、80年代風のレトロでファンシーな雰囲気です。 この依頼をご検討いただき、本当にありがとうございます！可能であれば、依頼したイラストをSNSで使用させていただきたいと思っています。なお、グッズや商業目的での使用はいたしませんので、ご了承ください。\n\n私の性格は、エネルギッシュで遊び心があり、ちょっとおっちょこちょいで、いたずら好きです。 オタクやフジョシのような感性を持つ「子トラ」として、私を想像していただけると嬉しいです。\n\nポーズや構図に特別な指定はありませんので、お好きなように描いてください！猫のようなポーズもかわいいかもしれません。 あなたの作品が大好きなので、この依頼をお引き受けいただけたら本当に嬉しいです！\n\n参考画像はこちらでご覧いただけます：\nhttps://drive.google.com/drive/folders/1i7g0nDW_06Ej-XdOKwsbn-lHrHyYySFq?usp=sharing\n\nもしよろしければ、別の衣装（「ジョジフク」）もご用意していますので、そちらを描いていただいても構いません。この衣装がお好きでしたら、デザインをアレンジしたり、ご自身の独創的なアイデアを加えていただくのも大歓迎です！\n\n本当にありがとうございます！ ところで、あなたのキャラクターである笹原ちゃん、すごくかわいいですね！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SASAHARA_kurage/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3951632, "client_id": 2277902, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c00843af/uploads/origins/5bb7bf5c-d8d7-4a1c-95d2-41da1fb30065?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46f0abf580cf8be258e32b1173ded0b2", "srcset": "https://si.imgix.net/c00843af/uploads/origins/5bb7bf5c-d8d7-4a1c-95d2-41da1fb30065?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46f0abf580cf8be258e32b1173ded0b2, https://si.imgix.net/c00843af/uploads/origins/5bb7bf5c-d8d7-4a1c-95d2-41da1fb30065?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d0f031c51d26d262b9721eccf5c147f 2x, https://si.imgix.net/c00843af/uploads/origins/5bb7bf5c-d8d7-4a1c-95d2-41da1fb30065?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f16eb44204b34b669b709ec39abb3531 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c00843af/uploads/origins/5bb7bf5c-d8d7-4a1c-95d2-41da1fb30065?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28b87af969b49ba77d7c8c3f3dbb36a2", "srcset": "https://si.imgix.net/c00843af/uploads/origins/5bb7bf5c-d8d7-4a1c-95d2-41da1fb30065?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28b87af969b49ba77d7c8c3f3dbb36a2, https://si.imgix.net/c00843af/uploads/origins/5bb7bf5c-d8d7-4a1c-95d2-41da1fb30065?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3f547c54ecf7e8ca4ba7f446feec5ec0 2x, https://si.imgix.net/c00843af/uploads/origins/5bb7bf5c-d8d7-4a1c-95d2-41da1fb30065?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b136d1a8ffaebea531bbc51932927c5a 3x"}, "body": "こんにちは！私のVTuber、Sailor Synthを描いていただけませんか？ 彼女は船乗りのワニの女の子で、船、灯台、釣り、そしてリミナルスペースの**POOLS**が大好きです。大きなワニの尻尾があり、牙はまるでヴァンパイアのようです。\n\n私はあなたがTwitterに投稿していたPOOLSのイラストが本当に、本当に大好きでした。色使いが完璧で、水のほとんど輝いているような美しい表現が本当に素晴らしかったです。ぜひあのような雰囲気の場所で私のキャラクターを描いていただけたら嬉しいです。\n\n屋内ウォーターパークのような場所で、カラフルなキノコ型の噴水や「流れるプール」があり、彼女が浮き輪に寝転がっているようなシーンをイメージしています。照明のほとんどは消えていて、全体的に寒色系のカラーパレットにしていただけたらと思っています。\n\nあと、かわいいアヒルのおもちゃ（ラバーダック）も入れていただけると嬉しいです。\n\n\nCharacter Reference materials: https://imgur.com/BpyNgx4\n\nこちらは、私が本当に大好きだったあなたの以前のイラストです。\n: https://x.com/SASAHARA_kurage/status/2084273508255944912", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SASAHARA_kurage/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3951632, "client_id": 4062738, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e91421a4/uploads/origins/b21fa5bb-8ae5-4e04-8039-b4bb36556fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4e203d646ad42211c85a7cc4c2fd459", "srcset": "https://si.imgix.net/e91421a4/uploads/origins/b21fa5bb-8ae5-4e04-8039-b4bb36556fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4e203d646ad42211c85a7cc4c2fd459, https://si.imgix.net/e91421a4/uploads/origins/b21fa5bb-8ae5-4e04-8039-b4bb36556fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9984f2e5478581075b7a4688dd8cd8a 2x, https://si.imgix.net/e91421a4/uploads/origins/b21fa5bb-8ae5-4e04-8039-b4bb36556fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=791c11354815dd8be2cfa07d803e9141 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e91421a4/uploads/origi