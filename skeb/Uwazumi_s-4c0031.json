4b6e-d154-44f5-b1a7-9eb926b924c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f26b3693a1cab6a6ce25fe339c1b1e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0693b87/uploads/origins/d5d14b6e-d154-44f5-b1a7-9eb926b924c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=577f80277f4fae3814a0d1ae1e995035", "srcset": "https://si.imgix.net/f0693b87/uploads/origins/d5d14b6e-d154-44f5-b1a7-9eb926b924c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=577f80277f4fae3814a0d1ae1e995035, https://si.imgix.net/f0693b87/uploads/origins/d5d14b6e-d154-44f5-b1a7-9eb926b924c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f0948a91b5ba1d40d3bf25dd6e429fe 2x, https://si.imgix.net/f0693b87/uploads/origins/d5d14b6e-d154-44f5-b1a7-9eb926b924c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bbe29d9299d2079e4e9b486c0a2ce1fa 3x"}, "body": "こんにちは！\n\nあなたの絵のスタイルや、服の描き方がとても気に入っています。\n\n私のキャラクター「キウイ」を描いていただけないでしょうか。彼女は三毛猫ケモノです。耳はとてもふわふわしていて、半分に切ったキウイのように見えます。長い猫のしっぽも持っています。\n20代で、花柄の服を着るのが好きです。\n\nもし可能であれば、あなたの服の描き方がとても気に入っているので、スカートやワンピースを着せた姿を描いていただけると嬉しいです。\n私はお花が大好き（キウイも大好きです！）なので、それに加えて、例えば服の上に花をあしらったり、花束を持った姿を描いたり、背景にシンプルな花を加えたりして、絵の中に花をいくつか入れていただけると嬉しいです。\n絵の雰囲気は、明るい感じが良いです。\n\nどのような絵になるか分かりませんが、描くのが楽しい作品になることを願っています！あなたが絵に満足していただければ、私も嬉しいです！\n\nhttps://kissa.moe/2026/2026-01-19.png", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Uwazumi_s/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3699988, "client_id": 515379, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b206cd87/uploads/origins/7d102b6b-551e-4d1a-9359-b6ca770aa370?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d