si.imgix.net/97c93837/uploads/origins/1bb530f5-5b0a-4e7f-8c87-ce197a289ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f9c089d1bf9ef19cb91e2dbcf05a084a 3x"}, "body": "はじめまして、Twitterで素敵なイラストを拝ませて頂いています！\nコミカルながらむっちりした質感の塗りのカラーイラスト、テンポ良くつい笑ってしまう漫画がとても好きです。\nこの機会にぜひ一枚お願いしたいと思い依頼させていただきます。\n\nリクエストですが、ウマ娘シンデレラグレイの奈瀬文乃トレーナーが以下の娘たちに取り合いされている絵をお願いします。（全員でなくて構いませんが、クリークは必ず入れてください。）\n◎スーパークリーク\n・エアグルーヴ\n・サイレンススズカ\n・キタサンブラック\n・コパノリッキー\n・エアシャカール\n・メジロマックイーン\n\nシングレでは奈瀬トレーナーがとても好きで、推定モデルとされる武豊騎手が主戦だった娘たちとも\n絡みがあったりしないかな～という願いからこのテーマにしました。\nぜひご承認のほどよろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oekaki_enpitu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 62037, "client_id": 1884261, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/344e689b/uploads/origins/c9782138-ccbf-4103-88d2-2bb4add64352?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50621fd340d0fd018f738bb2369b03d3", "srcset": "https://si.imgix.net/344e689b/uploads/origins/c9782138-ccbf-4103-88d2-2bb4add64352?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50621fd340d0fd018f738bb2369b03d3, https://si.imgix.net/344e689b/uploads/origins/c9782138-ccbf-4103-88d2-2bb4add64352?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5437dcb372456726455e9fd40d03e0ea 2x, https://si.imgix.net/344e689b/uploads/origins/c9782138-ccbf-4103-88d2-2bb4add64352?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c98713162e5ccce34a73a134c7150e2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/344e689b/uploads/origins/c9782138-ccbf-4103-88d2-2bb4add64352?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=871cffb57baffa562113846aaac72d89", "srcset": "https://si.imgix.net/344e689b/uploads/origins/c9782138-ccbf-4103-88d2-2bb4add64352?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=871cffb57baffa562113846aaac72d89, https://si.imgix.net/344e689b/uploads/origins/c9782138-ccbf-4103-88d2-2bb4add64352?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e373a4ff6ffd12f0cf5bbe05e07b210 2x, https://si.imgix.net/344e689b/uploads/origins/c9782138-ccbf-4103-88d2-2bb4add64352?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4780ce303bf9b15a53d0f44e1e677e45 3x"}, "body": "おえかきえんぴつ様\nリクエスト失礼いたします!\n人生で初めて買った同人誌がおえかきえんぴつ様の発行されていたRFのEFシリーズでして、skebでの募集開始を心待ちにしておりました…！\nリネット本が本当に大好きで今でも読み返しています\nご検討いただけましたらとても嬉しいです！よろしくお願いします！\n\n\nリクエスト内容ですが、\n版権キャラクターのリクエストも可能であればなのですが、\nファイアーエムブレム、蒼炎の軌跡・暁の女神に登場する「レテ」のイラストをえがいていただけないでしょうか？\nその他の、キャラクターのポーズ・表情・イラストの構図等々は、すべておえかきえんぴつ様におまかせできればと思っています！\nおえかきえんぴつ様の表現で自由にえがいていただけたら嬉しいです！\n\n\nどうかよろしくお願いいたします！\n\n下記URLはレテの参考資料です↓\nhttps://imgur.com/gallery/bmtwWmD", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oekaki_enpitu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 62037, "client_id": 140313, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78e7c5fe/uploads/origins/35d528aa-3d44-4c15-87a2-99b5c6102f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44be3dcffbbf3f65c5ddb0eb97d4fd53", "srcset": "https://si.imgix.net/78e7c5fe/uploads/origins/35d528aa-3d44-4c15-87a2-99b5c6102f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44be3dcffbbf3f65c5ddb0eb97d4fd53, https://si.imgix.net/78e7c5fe/uploads/origins/35d528aa-3d44-4c15-87a2-99b5c6102f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d0e2be0b3fb62c5f34692bf7de1c937 2x, https://si.imgix.net/78e7c5fe/uploads/origins