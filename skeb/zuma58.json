d515c87-422e-4a38-8ac1-07b846fe0c92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=429bbbdcab6edfac7f55a3d836e02670", "src_set": ""}, "body": "こんにちは! zumaさんのアートワークが大好きです!\n私のキャラクターのイラストをお願いしたいです。\nオレンジ色の髪キャラクターは渚です。渚さんは神秘的なて優しくて静かなです。\n緑色の髪のキャラクターの名前は菜奈です。菜奈ちゃんは不器用て恥ずかしがり屋て不運て、でも渚さん近くに菜奈ちゃんが興奮するです。彼らの関係は甘美だが、お互いに心を開くことができないため悲しい。菜奈ちゃんと渚さんはお互いに重要な秘密を隠しています。\n2人とも魚をテーマにしたキャラクターなので、水のあるものがいいかもしれない。でも何でもいいだ！\n自由に楽しく描いてください！\nよろしくお願いします、ありがとうございます!\n\nhttps://drive.google.com/drive/folders/1Y97sbuxxr8fDIFZDV_kYTuc44dkqYAy9?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zuma58/works/74", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 463051, "client_id": 3123425, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8692865c/uploads/origins/39e28635-487e-4da0-b6f3-970675508718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34b293b8dc4ff949dd9c7be4fd23971f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8692865c/uploads/origins/39e28635-487e-4da0-b6f3-970675508718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbb4ba05b6032867138e430fedbbaf65", "src_set": ""}, "body": "こんにちは、Zuma！  あなたのアートスタイルがとても好きなので、VtuberのCoxibとSilviaのカバービデオのために絵を描いていただきたいと思います。リクエストとしては、ファイルの絵を参考に1280x720の背景構造を作り、2人のキャラクターを周りに配置させていただければと思います。あなたの美しい色彩スキル、トーン、自由なドローイングで塗りつぶしてください。\n\nhttps://drive.google.com/drive/folders/12-OjPe9-AaRLMFOgalLvZuDlIGLgdx7e", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zuma58/works/73", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ffc85da9/uploads/origins/ead7d005-d2bc-497f-b6a4-aced44c0cf7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=38c6f17ed950c41a978195b0fddd68c9", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 463051, "client_id": 1643963, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@zuma58/works/72", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 463051, "client_id": 2735346, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd60157a/uploads/origins/8dc1fdf8-2c0d-4b17-85e0-d302cbe23bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7163d28483dd618cf30099c5640766cb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd60157a/uploads/origins/8dc1fdf8-2c0d-4b17-85e0-d302cbe23bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=724e3ecbc7f40292507abe6ef774d42c", "src_set": ""}, "body": "Hello Zuma sensei! I'm a big fan of your illustrations, you draw backgrounds so beautifully! May I request you to draw my character here? The character is a traveling musician, and I'd like you to draw them visiting somewhere.\n\n-Please draw the outfit from either 1st or 2nd image\n-For the background, you can draw wherever you like! But if you're unsure, the last image in the references provides a few ideas.\n\nThank you for considering my request!\n\nhttps://drive.google.com/drive/folders/1-DLLyESE65VAHdbeZPWe6sZzSEOIztZt?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zuma58/works/71", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 463051, "client_id": 3319378, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5efed22e/uploads/origins/99173a85-cf40-4703-a6ee-777e2a6ff20c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6030aeac7df835e63497f464912b6c1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5efed22e/uploads/origins/99173a85-cf40-4703-a6ee-777e2a6ff20c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cfea354c8466d7255812209af073915c", "src_set": ""}, "body": "Hello zuma, it’s great to meet you!\n\nI really like your art style and would like to invite you to draw my OCs, Wood and Vasi . As for the request, I hope you can create a background with blue tones. And I have no other specific requirements—I leave the atmosphere and the action up to you!\n\nPlease draw freely．\n\nhttps://drive.google.com/drive/folders/10dOJiXq9PxzcIFu3TrQkwVSzXXJ8UvXo", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zuma58/works/70", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 463051, "client_id": 3195064, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72abcf96/uploads/origins/f2d3014a-51f6-4400-979e-f8d3e46f6840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65f8ecf9d6dcd987464aba303f6d8926", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72abcf96/uploads/origins/f2d3014a-51f6-4400-979e-f8d3e46f6840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1bb2d3e07ee9b14136cd5353f186ad8b", "src_set": ""}, "body": "初めまして、南無三無念と申します。\n\nzuma様の絵描かれるとても柔らかく鮮やかなイラストに心奪われ、ぜひ私のキャラクターの配信待機画面で使用するイラストを描いていただきたいです。\n\nskebでの依頼が初めてなため、何かご不備がありましたら申し訳ございません。\n\n【キャラクター】\n白ネズミの耳が生えたキョンシーです、見落としやすい点としましては、ギザ歯、左目尻にある二つの泣きぼくろなどがあります！\n\n【希望構図】\n背景は青白い火の玉が複数浮いている墓場で、棺桶の上に私のキャラクターが片膝を乗せ座っていて眠そうにあくびをしている構図を希望したいです。\nあくまで希望ですのでzuma様のご無理のない範囲でお願い致します。\n\n【希望サイズ】\n16:9/1920x1080px\n\nこちらキャラクターのデータになっております、可能でしたら是非よろしくお願い致します\n\nhttps://drive.google.com/file/d/1NPnjm_tYRanUjVy2UoaJEZGe2NzvVUGF/view?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zuma58/works/69", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 463051, "client_id": 2544199, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4fd313af/uploads/origins/face7f0b-6b44-4905-b22b-22dbde4f4e27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c16303d26872150dba6e77f9a3cc3e1f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4fd313af/uploads/origins/face7f0b-6b44-4905-b22b-22dbde4f4e27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e26bbc41cbe8c9d6b684b06dcc0b313d", "src_set": ""}, "body": "初めまして！\nzumaさんの描かれる、まるで舞台を切り取ったCDジャケットのような色合いと世界観のイラストに一目惚れし、この度は是非ともzumaさんの作風で男女OCを描いて頂きたくリクエストに参りました。\n\nhttps://drive.google.com/drive/folders/1OXNYIyLF2V0HkA5B1lWOX9g7qKNQm2jk?usp=drive_link\n上記資料内3組のカップリングが入っておりますので、\nzumaさんの好きな2人組を描いていただければと思います。\n\n服装やポーズ、シチュエーション等の指定はありません。細かな装飾なども省いていただいて構いません！\nzumaさんのイラストと世界観が大好きなので、どうか好きなように描いて頂けたらと思います！\n＿＿＿＿＿＿＿＿＿\n\n使用用途としては個人的な鑑賞に使用したいと考えています。\n何か失礼がありましたら申し訳ありません、もし難しいようでしたら断わって頂いて構いません！\nご検討の程、何卒宜しくお願いします…！\n\nhttps://drive.google.com/drive/folders/1OXNYIyLF2V0HkA5B1lWOX9g7qKNQm2jk?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zuma58/works/68", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 463051, "client_id": 3190661, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/82b823c5