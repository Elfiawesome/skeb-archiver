尾、青みがかった黒髪、瞳の三日月形のハイライトが特徴です。\n・上記の特徴以外の服装や装飾はだて様におまかせいたします。ヘアアレンジやメイク等も大丈夫です。\n\n淡井月の基本ビジュアル詳細は下記URLからご確認よろしくお願いいたします↓ \n\n寒さが厳しい季節ですので、 ご自愛くださいませ🌙\n\nhttps://drive.google.com/drive/folders/1HbQw96DT6fEdx1bSD6lK7w7JBSfhhj6k", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaw4ass__/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7c4630dc/uploads/origins/a23785cc-f871-481d-b1a7-dfd139abc3f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66dfbb33130d1dc2dcdab6d012fcac22", "srcset": "https://si.imgix.net/7c4630dc/uploads/origins/a23785cc-f871-481d-b1a7-dfd139abc3f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66dfbb33130d1dc2dcdab6d012fcac22, https://si.imgix.net/7c4630dc/uploads/origins/a23785cc-f871-481d-b1a7-dfd139abc3f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8bdf9801e2d7289b8d49febd6927ca0 2x, https://si.imgix.net/7c4630dc/uploads/origins/a23785cc-f871-481d-b1a7-dfd139abc3f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=899d10d39689b3ab89a66e72af08fe0b 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3465799, "client_id": 2533284, "nc": 17}, {"path": "/@kaw4ass__/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e74e57dc/uploads/origins/c3917377-143a-423b-9b6d-0b5b0eecb665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f43ee064e54873db23