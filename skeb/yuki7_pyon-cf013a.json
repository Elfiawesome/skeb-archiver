はあって大丈夫です！）や瞳の瞳孔やハイライト指定など大変とは思いますが、よければお受けしていただけると嬉しいです。\n\n金額の問題でお受けが難しいようでしたら再送お願いします…！\n\nhttps://drive.google.com/drive/folders/1gttJr1m6AbLwFto5jcjiNX36rSfsnkJa", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuki7_pyon/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2028766, "client_id": 877019, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f2d76ee/uploads/origins/4a5635fa-4c7c-47a2-acda-c8bf0fc3d5b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d251a34348983f6532e00ac41ba0cc1", "srcset": "https://si.imgix.net/9f2d76ee/uploads/origins/4a5635fa-4c7c-47a2-acda-c8bf0fc3d5b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d251a34348983f6532e00ac41ba0cc1, https://si.imgix.net/9f2d76ee/uploads/origins/4a5635fa-4c7c-47a2-acda-c8bf0fc3d5b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b61fe8d9e3b2466b972b0ab69fb81c1 2x, https://si.imgix.net/9f2d76ee/uploads/origins/4a5635fa-4c7c-47a2-acda-c8bf0fc3d5b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=373aa04325a727a0a33b55f590d7984b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f2d76ee/uploads/origins/4a5635fa-4c7c-47a2-acda-c8bf0fc3d5b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cc0337bdab3806f68e545af3db95d62", "srcset": "https://si.imgix.net/9f2d76ee/uploads/origins/4a5635fa-4c7c-47a2-acda-c8bf0fc3d5b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cc0337bdab3806f68e545af3db95d62, https://si.imgix.net/9f2d76ee/uploads/origins/4a5635fa-4c7c-47a2-acda-c8bf0fc3d5b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc5f0bf07b7f215fca57cff79b04823a 2x, https://si.imgix.net