てほしい」\nヒロはそう言って、また笑った。\n\n「じゃあ、また明日」\n「うん。また明日」\nヒロが手を振って、\n雨の中を走って家の方へ消えていく。\nやっすんは閉じたビニ傘を握ったまま、\nしばらくその背中を見送っていた。\n\nヒロは曲がり角でやっすんが見えなくなると、鞄から折り畳み傘を広げる。\n微笑みが見え、足取りは軽く生き生きとしていた。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kidatokotarou/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2871694, "client_id": 75041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42297ba3/uploads/origins/f9796263-924b-479a-be29-6e3fdfb48699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2281229ab420a97061c345028b1b5391", "srcset": "https://si.imgix.net/42297ba3/uploads/origins/f9796263-924b-479a-be29-6e3fdfb48699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2281229ab420a97061c345028b1b5391, https://si.imgix.net/42297ba3/uploads/origins/f9796263-924b-479a-be29-6e3fdfb48699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8cebd1f5e12212f46f14f180aa97b36c 2x, https://si.imgix.net/42297ba3/uploads/origins/f9796263-924b-479a-be29-6e3fdfb48699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84bb5e9acd4d0dabd99d9806beb8cde6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42297ba3/uploads/origins/f9796263-924b-479a-be29-6e3fdfb48699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c125ef8041e97d94ceb1c9fc76cebed7", "srcset": "https://si.imgix.net/42297ba3/uploads/origins/f9796263-924b-479a-be29-6e3fdfb48699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c125ef8041e97d94ceb1c9fc76cebed7, https://si.imgix.net/42297ba3/uploads/origins/f9796263-924b-479a-be29-6e3fdfb48699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d9e60a2695f029645a5060dbbea4605d 2x, http