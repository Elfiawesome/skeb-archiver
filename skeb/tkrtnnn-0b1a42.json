まして】\n\n納品データはレイヤー分けしてる PSDかPNGで頂けますと幸いです。\n\n 【使用範囲】  \n\nTwitter等のSNSでの使用（アイコン・ヘッダー、おはようVtuber画像など）   \n\n収益化を含むYouTubeでのサムネイル、配信内での画面配置、歌ってみた動画など\n\n  【その他】  \n\n個人で依頼する形になりますが、私は所属する団体があり、個人勢Vtuberではありません。\n\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/file/d/1JdGZdbsXWa3YzfzQ2yvHHHKOUOqOh49x/view?usp=drivesdk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 249319, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ちみどろ🌹skeb募集中", "screen_name": "Futa__TIMAMIRE", "avatar_url": "https://pbs.twimg.com/profile_images/1483007603332751368/ZrorIvZP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1147718598447648768/1690368994/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 129}, {"id": 1166238, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "瀬戸", "screen_name": "ebi_oishiiii", "avatar_url": "https://pbs.twimg.com/profile_images/1680886966345412608/8RWeXDJG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1382099772966805507/1771244744/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 2620286, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "いかわさ🦑(チゲ味)", "screen_name": "Midori_annte23", "avatar_url": "https://pbs.twimg.com/profile_images/1772462509385269248/3WO5dS3i.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1288136668696809473/1711452276/1500x500", "appeal_receivabl