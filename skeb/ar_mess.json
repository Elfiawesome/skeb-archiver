d2cb3fce-a66a-4896-98f0-c04a6a2583d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90cfc470275ecd4aee1fda75eca67c55", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 31847, "client_id": 2549593, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ar_mess/works/391", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 31847, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc9e68a3/uploads/origins/130199b3-53ef-40f6-80b8-7954bfa3c1d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e8b4470492cd375c84f4f7898d1f8dd", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc9e68a3/uploads/origins/130199b3-53ef-40f6-80b8-7954bfa3c1d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e511e4aeac216f189291e6492db0cdb", "src_set": ""}, "body": "めがあれ先生、こんばんわ。\n初めて依頼致します。\n\nキャラクター：女戦士(オリジナル)\n\nキャラクターイメージ：(爆乳)おっぱいのついたイケメン\n\n構図：全身立ち絵 正面向きのカラーイラスト\n\n背景：無し(可能なら背景透過)\n\n容姿：トランジスタグラマーで爆乳 肌は普通\n　　　\n髪型：短髪(オールバック気味の恰好良い感じでお願いします。) 色は黒\n\n衣装：ビキニアーマー 色は青系統\n　　　資料URLを参照願います。\n　　　可能なら全裸状態もお願いします。\n　　　無理ならば要りません。\n\n小物：首輪とマントと剣もしくは刀\n\n表情：笑顔と照れ顔\n\n詳細\n構図は、ゲーム等で良く見かけます全身立ち絵 正面向きのものをお願いします。\n\nキャラクターイメージや容姿に有る通り、おっぱいは爆乳でお願いします。\n\n背景は無しで透過状態だと有難いです。\n\n衣装は青系統のビキニアーマーでお願いします。\n資料URLを参考にして下さい。\n乳輪はギリ隠れるくらいでお願いします。\n可能でしたら全裸の状態もお願いします。\n無理なら全裸は無くて構いません。\n\nアレンジは好きにして頂いて構いませんが、胸部衣装面積は少な目でお願いします。\n横乳・下乳・胸の谷間がはっきりと見え、紐部分等が乳肉に食い込み胸の大きさが\n良く分かる様にお願いします。\n\n立ち絵のポーズもお任せしますが、特に胸の大きさと柔らかさを強調する様にして下さい。\n\n小物として、首輪とマントと剣もしくは刀をお願いします。刀剣は背中に背負わせて