6f-438a-bdcc-08a19c9e3f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37f9dc2381c334d8ee7dd260a040b4d9 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/443245e5/uploads/origins/237d78f5-9b6f-438a-bdcc-08a19c9e3f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f919d8e6c6c150435e85f40a221cec72", "srcset": "https://si.imgix.net/443245e5/uploads/origins/237d78f5-9b6f-438a-bdcc-08a19c9e3f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f919d8e6c6c150435e85f40a221cec72, https://si.imgix.net/443245e5/uploads/origins/237d78f5-9b6f-438a-bdcc-08a19c9e3f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f4081567cfb0b156c88a1ddab24da9aa 2x, https://si.imgix.net/443245e5/uploads/origins/237d78f5-9b6f-438a-bdcc-08a19c9e3f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0084fe7b07e52daa69b9e707bcb82224 3x"}, "body": "初めまして、いつも素晴らしいイラスト楽しみにしています。\nマエリベリー・ハーンのモノクロ漫画をお願いします。\n以下シチュエーション詳細\n秘封倶楽部活動資金の為にパパ活でするメリー。\n指定されたマンションに着くなりパパ活相手に抱き着いてキスを迫る、それに応じる男性はメリーと熱いキスをする。\nキスをしながらメリーの服に手をかけ、ブラの上から胸を揉み始める。\nメリーはキスをしながら彼の下半身に手をやり、ズボンの上からでもわかるくらい大きくなった男性器を愛おしくなでる。\nどれほど時間が経ったかどちらかとなくキスを止め、熱いまなざしでお互いを見つめる。\n男性器をさすりつつ「これを入れてほしい」とスカートを脱ぎ、パンツ姿で懇願するメリーに男性も我慢の限界。\nチャックを下ろし、大きくなった男性器をメリーのお尻にこすりつける。ドクンドクンと脈打つ男性器を淫靡な表情で見つめるメリー。\n男性はたまらずメリーの膣内に男性器を挿入する。\n激しく交わる二人、男性も射精を我慢していたがとうとう限界に達してしまう。\nするとメリーがそれに気づき、「中に出していいよ♡」と耳元でささやく。\n男性は理性を失いメリーの膣に精液を流し込む。\n行為が終わり、男性が寝ている隣で静かにお札を数えるメリー。\n「活動資金にしては丁度いい金額ね」と蓮子に電話する。\nと言った感じでお願いします！。\n難しいまたは忙しい場合は遠慮なくキャンセルしてもらっても構わないので\n何卒ご検討の方よろしくお願いします。", "nc": 162, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tyesutolo1/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 893046, "client_id": 94942, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a2bf47f/uploads/origins/1fd7ab64-1830-42f4-bf5a-7e17b47c463f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec75fcc2701cf04c69cdda50fc3bb662", "srcset": "https://si.imgix.net/7a2bf47f/uploads/origins/1fd7ab64-1830-42f4-bf5a-7e17b47c463f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec75fcc2701cf04c69cdda50fc3bb662, https://si.imgix.net/7a2bf47f/uploads/origins/1fd7ab64-1830-42f4-bf5a-7e17b47c463f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab3a82189b54738e9466371ee189995a 2x, https://si.imgix.net/7a2bf47f/uploads/origins/1fd7ab64-1830-42f4-bf5a-7e17b47c463f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a406eb470f37d3776f59fe4fb47f6ff 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a2bf47f/uploads/origins/1fd7ab64-1830-42f4-bf5a-7e17b47c463f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd9421d4660e289d01e0f10be545a2f0", "srcset": "https://si.imgix.net/7a2bf47f/uploads/origins/1fd7ab64-1830-42f4-bf5a-7e17b47c463f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd9421d4660e289d01e0f10be545a2f0, https://si.imgix.net/7a2bf47f/uploads/origins/1fd7ab64-1830-42f4-bf5a-7e17b47c463f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cf3dc6b3ef4d566c5efaa8fd252966ca 2x, https://si.imgix.net/7a2bf47f/uploads/origins/1fd7ab64-1830-42f4-bf5a-7e17b47c463f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28fa574f7a9bd8ad57a381a520325e88 3x"}, "body": "はじめまして。以前の諏訪子様や鈴仙のおねショタ漫画が良かったので、天子ちゃんのおねショタモノクロ漫画をリクエストさせていただきます。\n内容\n比那名居天子ちゃんが使用人のショタのオナニー現場を見てしまい、見られてしまったことで泣いてしまったショタと勃起したおちんちんを慰めるために仕方なくやおっぱいを触らせたり授乳手コキで処理。最初は手コキだけで終わりにしようとしたが、濃い精液に興奮してしまい、中出しセックスまでもつれ込む。\n服と胸\n服は半脱ぎで胸の大きさは以前の諏訪子様ぐらいで大丈夫です。\nその他\n 漫画の内容はおっぱいいじりメインでお願いします。また、背景や仕上がり等は以前の鈴仙のおねショタ漫画と同様な感じで構いません。\nお忙しいかもしれませんが、どうぞご検討のほどよろしくお願いいたします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tyesutolo1/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 893046, "client_id": 28758, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d12c1b3/uploads/origins/c3926cbe-b68d-43cd-b9fe-e8267ccce5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=098f0fa1603befbd6b78cba0f3fbe252", "srcset": "https://si.imgix.net/6d12c1b3/uploads/origins/c3926cbe-b68d-43cd-b9fe-e8267ccce5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=098f0fa1603befbd6b78cba0f3fbe252, https://si.imgix.net/6d12c1b3/uploads/origins/c3926cbe-b68d-43cd-b9fe-e8267ccce5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=110f3035f4f5e767c1ff8c9b5c6253f7 2x, https://si.imgix.net/6d12c1b3/uploads/origins/c3926cbe-b68d-43cd-b9fe-e8267ccce5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d04be1551b7a29ff5bcaafb5e224bc1f 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d12c1b3/uploads/origins/c3926cbe-b68d-43cd-b9fe-e8267ccce5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9eef97b6aa329f5446a2b50629aa1206", "srcset": "https://si.imgix.net/6d12c1b3/uploads/origins/c3926cbe-b68d-43cd-b9fe-e8267ccce5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9eef97b6aa329f5446a2b50629aa1206, https://si.imgix.net/6d12c1b3/uploads/origins/c3926cbe-b68d-43cd-b9fe-e8267ccce5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd922666c34d0f1462740863c77fa949 2x, https://si.imgix.net/6d12c1b3/uploads/origins/c3926cbe-b68d-43cd-b9fe-e8267ccce5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=886fd06708d5548b3bef6af369e67532 3x"}, "body": "お疲れ様です。咲夜さんマンガ作業中の所を恐れ入ります。\n成人向けモノクロ漫画のリクエストが可能でしたら、下記内容にてお願いします。\n・鈴仙・優曇華院・イナバ\n・巨乳、できれば顔より大きい爆乳、親指大に勃起した乳首、陰毛無し\n・好きなだけおっぱい吸わせてくれて、好きなだけ生中出しさせてくれる、という内容。\n\n和姦系のシチュで、どのような話にするかはお好みで。\nそれでは悩むという場合は、以下のような流れでご検討ください。\n・早苗さんにたくさん射精（後略）漫画と同様のおねショタシチュ\n処方間違えにより勃起と精液増産が止まらなくなってしまったショタ患者を、鈴仙が個室で（ノリノリで）面倒を見ることに。最初は治療ということで、おっぱい好きなショタに自身のおっぱいと乳首を好きなようにさせてあげてのオカズ提供で、射精自体は自慰で処理させていたものの、何時間も止まらずおっぱいを揉まれたり吸われた上に充満する精液の匂いで鈴仙のほうがムラムラし、ついに膣で搾り取ることに。その後、射精を促すためおっぱいは変わらず好きにさせつつ、何発何十発もの生中出しで子宮が一杯になりお腹が膨れるまで一日中搾精し続ける。最後はようやく抜いて堰を切ったように膣から精液が溢れる事後場面。\n\n今描かれている咲夜さん漫画優先で問題ありません。\nまた、通常の仕上げが望ましくはありますが、背景は簡略または無し、下書き＋乳首等要所のみトーン貼り、ぐらいに仕上がりを抑えていただいても構いません。\n\n厳しいようでしたら出直してまいりますので、どうぞ気兼ねなくキャンセルしてやってください。\nご検討のほど、よろしくお願い致します。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tyesutolo1/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 893046, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb7b9231/uploads/origins/1b552253-fb56-4daf-94ab-0d508916db11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d56a5faf79a4ce6d8cad39ac2080b3a", "srcset": "https://si.imgix.net/eb7b9231/uploads/origins/1b552253-fb56-4daf-94ab-0d508916db11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d56a5faf79a4ce6d8cad39ac2080b3a, https://si.imgix.net/eb7b9231/uploads/origins/1b552253-fb56-4daf-94ab-0d508916db11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb471f8160e30e180822cff60d1e878c 2x, https://si.imgix.net/eb7b9231/uploads/origins/1b552253-fb56-4daf-94ab-0d508916db11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e31593ed5f92b1cf64243974ded566d5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb7b9231/uploads/origins/1b552253-fb56-4daf-94ab-0d508916db11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d85df14f581463ef2783c63fa2cda507", "srcset": "https://si.imgix.net/eb7b9231/uploads/origins/1b552253-fb56-4daf-94ab-0d508916db11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d85df14f581463ef2783c63fa2cda507, https://si.imgix.net/eb7b9231/uploads/origins/1b552253-fb56-4daf-94ab-0d508916db11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a4136a2018d59fcfe768c0adadff9e45 2x, https://si.imgix.net/eb7b9231/uploads/origins/1b552253-fb56-4daf-94ab-0d508916db11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8bd7bc92cad7f1997dd1d555200b6016 3x"}, "body": "八雲紫が恋人とエッチするマンガをお願いします。\n・導師服で着崩れ着衣エッチ\n・大人っぽい方の紫様\n・普段は不敵で余裕そうな反面恋人エッチの時は受けになる紫様\n・前掛けをわざとらしく谷間に寄せたり押し付けたりして揶揄っていたら興奮した恋人にそのまま襲われるシチュ\n・涙目で危険日を示唆して外出しを懇願するものの、恥ずかしそうに種付け受精を受け入れてしまう\n・腹いせのように胸の白い生地が乳首を吸われてスケスケになっている\n\n検討の程よろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tyesutolo1/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 893046, "client_id": 462930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e20a08c0/uploads/origins/9d229f58-cd00-47a2-9227-fed98fcf56e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=317bf44633e4cfce267b161be0d26032", "srcset": "https://si.imgix.net/e20a08c0/uploads/origins/9d229f58-cd00-47a2-9227-fed98fcf56e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=317bf44633e4cfce267b161be0d26032, https://si.imgix.net/e20a08c0/uploads/origins/9d229f58-cd00-47a2-9227-fed98fcf56e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b7ff0d5328b041b99a3da206e8bac76 2x, https://si.imgix.net/e20a08c0/uploads/origins/9d229f58-cd00-47a2-9227-fed98fcf56e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10c91319e3207541e2bd4990e24047ca 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e20a08c0/uploads/origins/9d229f58-cd00-47a2-9227-fed98fcf56e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b8c16a8bb10d50c31c253a37855a85", "srcset": "https://si.imgix.net/e20a08c0/uploads/origins/9d229f58-cd00-47a2-9227-fed98fcf56e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b8c16a8bb10d50c31c253a37855a85, https://si.imgix.net/e20a08c0/uploads/origins/9d229f58-cd00-47a2-9227-fed98fcf56e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5d204685a1e59e8b8afe1b6be137b0d1 2x, https://si.imgix.net/e20a08c0/uploads/origins/9d229f58-cd00-47a2-9227-fed98fcf56e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93ceeda76fd17e20fa3f2741b6ffa870 3x"}, "body": "はじめまして。\n東方の今泉影狼とのイチャラブエッチ絵を依頼します。\n\n恋人の家にお泊りした影狼が寝室の布団で\n恋人と正常位か騎乗位でエッチしています。\n構図としては男性主観で男性は下半身が見えるぐらいで。\n\n既成事実が欲しい影狼は発情期を迎えていることもあり\n全身からむわぁと雌の匂いを漂わせている状態で\nあなたと子作りしたいのと恋人を誘惑しています。\n\nその後、誘惑に興奮した恋人との子作りが始まり\n恋人が自分の匂いに興奮している事にゾクゾクしながら\n迫る中出しを期待しています。\nその後、中出しの余韻に浸りながら\n恋人とつがいになれたと嬉しそうです。\n\n台詞や擬音ありで、挿入中の絵を基本として\n挿入前や中出し、繋がったまま余韻中等の差分をお願いします。\n　\n服は二次創作でよく見るオフショルダーではだけており\n大きな胸は露出し結合部も見える状態でお願いします。\n\n以上、ご検討ください。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tyesutolo1/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5352228c/uploads/origins/f3ab47a3-121d-4a13-afac-9df6b6cbacb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1ee56f2dfaec894511b84e95690101a4", "s