ee-b729-4677-87ef-95fb9f0db100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=771810a6989282d8a321e5202a835f76", "srcset": "https://si.imgix.net/ef817729/uploads/origins/3a4794ee-b729-4677-87ef-95fb9f0db100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=771810a6989282d8a321e5202a835f76, https://si.imgix.net/ef817729/uploads/origins/3a4794ee-b729-4677-87ef-95fb9f0db100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c0a56aa5ae60d28e3d75d0900bbf87b 2x, https://si.imgix.net/ef817729/uploads/origins/3a4794ee-b729-4677-87ef-95fb9f0db100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=662e3aa527ca8793e799c4e29f9a8cd4 3x"}, "body": "はじめまして、Twitterで素敵な作品の数々を拝ませて頂きました！\nシュールながらも微笑ましいシチュエーションの数々と、それに翻弄されるコミカルで豊かな表情、カラーイラストの目に焼き付くような鮮やかな色使いに惹かれました。\nぜひ私にも一枚と思い依頼させて頂きます。\n\nリクエストですが、以下のシチュエーションでお願いします。\n・ホストクラブ風の一室にある大きな椅子に、地雷系ファッションのマルシュロレーヌが座っている\n・そこにエピファネイアとキタサンブラック、フォーエバーヤングがホスト姿で口説きにかかっている\n・左右からエピファ＆キタサン、背もたれの向こうからヤン子が絡む構図を想定していますが、より良いものがあればそちらにしてください。(ボディタッチ強めだと嬉しいです。全体的にハート×デジたん絵の雰囲気をイメージしています)\n\nモデルのマルシュロレーヌ号は現在繁殖牝馬生活をしていますが、23年にキタサンブラック、25年にエピファネイアとの交配をしています。\nウマ娘に置き換えると面白い構図になるのでは！？という思いつきと、来年以降ヤン子とマルシュの仔が産まれたらアツい…！という思いで依頼させて頂きました。\nぜひご承認のほどよろしくお願いします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Fluid_whim/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3508888, "client_id": 2263183, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/656be40b/uploads/origins/02981097-60a2-4839-90bf-a97067ffc94d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab441d0d762771073648403534789afc", "srcset": "https://si.imgix.net/656be40b/uploads/origins/02981097-60a2-4839-90bf-a97067ffc94d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab441d0d76