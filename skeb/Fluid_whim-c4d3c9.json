n①奈瀬文乃/1「原寸大宛名入png」/2「原寸大宛名無png」/3「原寸大PSD」\n②奈瀬文乃【全身金色差分】/1「原寸大宛名入png」/2「原寸大宛名無png」\n③奈瀬文乃【王冠マント無し金ビキニ差分】//1「原寸大宛名入png」/2「原寸大宛名無png」\n④奈瀬文乃【星条旗ビキニ差分】//1「原寸大宛名入png」/2「原寸大宛名無png」\n⑤奈瀬文乃【王冠マント無し星条旗ビキニ差分】//1「原寸大宛名入png」/2「原寸大宛名無png」\n★計11ファイル\n他の組み合わせの表情肌色差分pngもいくつか納品していただきたいです。\n\n★♦PSDはレイヤー統合前でファイル内で差分・宛名が個別に切り替えられる形式でお願いいたします。\n\nご検討の程何卒宜しくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Fluid_whim/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3508888, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb8b1b31/uploads/origins/4b09473d-e620-4823-9aa1-78e6d74f77f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e6986dd24b05f279499278486cdfbaf", "srcset": "https://si.imgix.net/bb8b1b31/uploads/origins/4b09473d-e620-4823-9aa1-78e6d74f77f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e6986dd24b05f279499278486cdfbaf, https://si.imgix.net/bb8b1b31/uploads/origins/4b09473d-e620-4823-9aa1-78e6d74f77f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c061a6a65cbe7463ef379eb8f412ff8e 2x, https://si.imgix.net/bb8b1b31/uploads/origins/4b09473d-e620-4823-9aa1-78e6d74f77f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f94f38f5afa5b88caa89f445440a6f41 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb8b1b31/uploads/origins/4b09473d-e620-4823-9aa1-78e6d74f77f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ae64d50ceaccd816d25fb3b6915110e", "srcset": "https://si.imgix.net/bb8b1b31/uploads/origins/4b09473d-e620-4823-9aa1-78e6d74f77f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ae64d50ceaccd816d25fb3b6915110e, https://si.imgix.net/bb8b1b31/uploads/origins/4b09473d-e620-4823-9aa1-