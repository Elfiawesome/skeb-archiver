webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a910d4d083fd11b1b17f67718a90af4", "src_set": ""}, "body": "初めまして！\nパワ体イラストを拝見して可愛いと思ったのでリクエストします。\n甘えかたは彼女なりに。というゲームの栗沢みゆきちゃんのパワ体イラストをお願いしたいです。\nポーズとか背景は一任します。\nご検討の程宜しくお願いします！\n\nhttps://www.entergram.co.jp/amanari/", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oekakisurude12/works/84", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1788526, "client_id": 2913760, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dff9cc5a/uploads/origins/2ecd259a-6141-4e57-954f-c7cc5c1ade1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e861aac76759fbf0a91f8b8aa0b1399", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dff9cc5a/uploads/origins/2ecd259a-6141-4e57-954f-c7cc5c1ade1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d7cb1a3c25bd49a970a5e29b3a065f8", "src_set": ""}, "body": "突然のご連絡失礼致します。VTuberとして活動している朝雨 水葉（あさめ みずは）と申します。\nパワ体イラストを探していた時に、白い箪笥様のクオリティの高さに目を引かれ依頼をさせていただいた次第です。\n朝雨水葉（https://twitter.com/asame328 固定ツイートご参照ください）が野球している姿を、透過で3カットほどお願いしたいです。攻撃・守備（この二つはユニフォーム姿で、オリジナルの雰囲気を出していただけると嬉しいです、道具や構図などはお任せします）・立ち絵（ポーズはお任せしますがジャージ姿で、このイラストのみ かえるのトロちゃんをどこかに入れてほしいです...!）\nを描いていただけませんでしょうか。\n\n使用用途としては配信用サムネイル、配信内画像、ツイート画像（いわゆる「おはV」など）の素材、など良識の範囲内で使用させていただきます。\n\n上記承諾いただけるようでしたらぜひ白い箪笥様に描いていただけますと幸いです。\nご検討のほど何卒よろしくお願い申し上げます。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oekakisurude12/works/83", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1788526, "client_id": 207733, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/256e5070/uploads/origins/e277a10c-6550-4a29-bf81-083dab5ba323?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06a947a960e29573973a6193b522083e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/256e5070/uploads/origins/e277a10c-6550-4a29-bf81-083dab5ba323?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=caa7e7302a2cd9304d1effeb7f425825", "src_set": ""}, "body": "二回も素晴らしいイラストをありがとうございました。\nぜひ、またイラストを以下の内容でリクエストしたくご連絡させていただきました。\n\n〇キャラクター\n青葉のぞみ（パワポタ４、パワプロ2010）\n〇服装\n水着。デザインはお任せいたします。\n〇内容\n参考のskebのように水着を披露するシーンをお願いします。\n可能であれば、参考の日和ミヨのようにキャラを分けて表示できるようにお願いいたします。\n〇要望\nスタイルは白い箪笥様が描かれる日和ミヨやめぐる先生のようにお願いします。\n好みに合わない場合はキャンセルしていただいて大丈夫です。\n\nご検討宜しくお願い致します。\n\nhttps://skeb.jp/@oekakisurude12/works/81", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oekakisurude12/works/82", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1788526, "client_id": 128546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e90389a/uploads/origins/aef923b9-c50d-4751-af5a-a2a77e5fe0bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2cb64ba26f2b3f50d675e1be51ef1e9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e90389a/uploads/origins/aef923b9-c50d-4751-af5a-a2a77e5fe0bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26fda9fee4af8471dc16494cafd90424", "src_set": ""}, "body": "こんにちは、白い箪笥さん\n前々回のパトレンジャーの三人、前回のルパンレンジャーの三人に引き続き、今回は両戦隊の追加戦士であるルパンX/パトレンXのパワ体絵を所望します\n・ルパンXとパトレンXが背中合わせに立っている。右手前がパトレンX、左奥がルパンX\n・ルパンXは頭部が真横を向く位まで振り返り、左腕を斜め下45度位の角度で軽く伸ばし、右手は腰に当てている。伸ばした左手には「おとうさんといっしょ」のシュッシュの人形(無論これもパワ体)を持っている\n・パトレンXはこの前のパトレンジャーの三人と同様に身体全体を真正面に向け、カカトを揃え爪先は外側に開いて敬礼。但し、今回はパトレンジャーの三人とは逆に左手で敬礼している。右手には「おとうさんといっしょ」のポッポの人形(無論これもパワ体)を持っている\n今回もマスクオン状態とマスクオフ状態の2パターンを描いて頂きたく存じます。マスクオン状態の頭部は今回もパワポケ7のポケレンジャーの皆さんの様なデフォルメ具合にして下さい。マスクオフ状態に関しては、輪郭はルパンXとパトレンXの双方共パワプロ君などと同じ最もオーソドックスな奴で、ルパンXのみ銀色のシルクハットを被せて下さい。また、ルパンXは目線をこちら側に向けている様にして下さい\n背景は左側が前回のルパンレンジャーと同じ黒に近い濃紺、右側が白のグラデーションにして頂きたく存じます\n\nhttps://twitter.com/sedaoseda/status/1765662110065856697", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oekakisurude12/works/81", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1788526, "client_id": 1652749, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4184702/uploads/origins/881d1c84-11b2-4611-9f2c-07cc8d2418a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32335dc384db821bae416b9bde007b38", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4184702/uploads/origins/881d1c84-11b2-4611-9f2c-07cc8d2418a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1919b5785c1e175aeebe755959d3cc1", "src_set": ""}, "body": "こんにちは！\n白い箪笥さんのパワプロ絵がすごく好きで、リクエストさせて頂きました。\n\n早速ではありますが、描いて頂きたいのは\n\n「パワプロ15 日和ミヨ」です。\n通常のスーツ姿も良いのですが、水着も見てみたいとも思い、迷っています。\n\n受けて頂いた時に、白い箪笥さんの描く側のご意見も聞きたいです！\n\nご検討の程、よろしくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oekakisurude12/works/80", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1788526, "client_id": 1460787, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/49216e31/uploads/origins/ce392210-20a9-447e-bafd-0ceabf080d24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b141793260d5993809da744bcc89a62", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/49216e31/uploads/origins/ce392210-20a9-447e-bafd-0ceabf080d24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cro