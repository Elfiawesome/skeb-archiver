きだと思うので、無理でも構いません。\nご検討いただける幸運が得れることを祈っております。\n\nしゃけ沢さんの今後のご活躍を応援しております。いつも素敵なイラストやマンガをありがとうございます。\nまだ落ち着かない情勢ではございますが、しゃけ沢さんの心身の健康を心より祈っております。\n\n以上、よろしくお願いいたします。\n\n玉露\n\nhttps://twitter.com/gyok66/status/1264449269747998721?t=EdClZ-tkiLio4UmePXmeBA&s=19", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shakerizero/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 852780, "client_id": 759882, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90271658/uploads/origins/7b7e02e0-562e-428a-9a5f-2e23489fc7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5fb46e7c2bb0ff2165f37b8b7441a66", "srcset": "https://si.imgix.net/90271658/uploads/origins/7b7e02e0-562e-428a-9a5f-2e23489fc7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5fb46e7c2bb0ff2165f37b8b7441a66, https://si.imgix.net/90271658/uploads/origins/7b7e02e0-562e-428a-9a5f-2e23489fc7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ac43761accf006cf6ee4ba7836615b2 2x, https://si.imgix.net/90271658/uploads/origins/7b7e02e0-562e-428a-9a5f-2e23489fc7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4755ff3f7658a16bc1f37ff74e4a418 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90271658/uploads/origins/7b7e02e0-562e-428a-9a5f-2e23489fc7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7c72fdd87297a661efd062f5d6bbeec", "srcset": "https://si.imgix.net/90271658/uploads/origins/7b7e02e0-562e-428a-9a5f-2e23489fc7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7c72fdd87297a661efd062f5d6bbeec, https://si.imgix.net/90271658/uploads/origins/7b7e02e0-562e-428a-9a5f-2e23489fc7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop