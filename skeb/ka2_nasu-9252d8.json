_nasu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4109432, "client_id": 3845336, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d6a8918/uploads/origins/0ce9ffda-ffac-4acd-bbbd-ed6556951513?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a5f044a9702724c80ef907330306b7b", "srcset": "https://si.imgix.net/5d6a8918/uploads/origins/0ce9ffda-ffac-4acd-bbbd-ed6556951513?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a5f044a9702724c80ef907330306b7b, https://si.imgix.net/5d6a8918/uploads/origins/0ce9ffda-ffac-4acd-bbbd-ed6556951513?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8ed6d37a327eb92ba84746f5e3bb735 2x, https://si.imgix.net/5d6a8918/uploads/origins/0ce9ffda-ffac-4acd-bbbd-ed6556951513?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9cf99083b86d7d263d3036d62f1413e7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d6a8918/uploads/origins/0ce9ffda-ffac-4acd-bbbd-ed6556951513?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0fe3add7e3b2b6dbfabbe82253ad61df", "srcset": "https://si.imgix.net/5d6a8918/uploads/origins/0ce9ffda-ffac-4acd-bbbd-ed6556951513?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0fe3add7e3b2b6dbfabbe82253ad61df, https://si.imgix.net/5d6a8918/uploads/origins/0ce9ffda-ffac-4acd-bbbd-ed6556951513?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0aed7d738022bac3172c41bbbb2e813a 2x, https://si.imgix.net/5d6a8918/uploads/origins/0ce9ffda-ffac-4acd-bbbd-ed6556951513?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=554596c899b912b7134d98931c3efe63 3x"}, "body": "先生、こんにちは！先生のイラスト、本当に素敵ですね！！2人のキャラクターを描いていただけないでしょうか：\n\nハーヴィー | 26歳 | 188cm\n