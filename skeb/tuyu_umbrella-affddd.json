67/uploads/origins/0d0e6169-5d5f-4ef5-b1b0-b279563624e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=148c43afa1d9bd488f32bb48b00949e4, https://si.imgix.net/70449c67/uploads/origins/0d0e6169-5d5f-4ef5-b1b0-b279563624e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe033a88e61a0c08f28f51065d52372e 2x, https://si.imgix.net/70449c67/uploads/origins/0d0e6169-5d5f-4ef5-b1b0-b279563624e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=792cec675e149e266e470d9d28aff859 3x"}, "body": "Hello, your art style is gorgeous! I especially liked your work here (https://skeb.jp/@tuyu_umbrella/works/2) and would like to request something similar.\n\nI would like to request an illustration of my Vtuber from you! Please change the outfit to something more streetwear/techware, and include a Yu-Gi-Oh duel disk on her arm (https://imgur.com/a/rMf3CTb) if possible! Also please draw her in a fierce pose and have her holding a Yu-Gi-Oh card in one of her hands.\n\nI would like to use this for a music video as well as on Youtube/Twitter/Twitch.\nPlease separate the character and background layer!\nThank you for your consideration!\n\nhttps://imgur.com/a/kqYVSwd", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tuyu_umbrella/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2096410, "client_id": 2107178, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a39ef43/uploads/origins/5b0eba1f-4db2-4ea5-8a3f-6de2d2bebd3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da7d0785ce5f184856c4bbcbf4ca02f3", "srcset": "https://si.imgix.net/0a39ef43/uploads/origins/5b0eba1f-4db2-4ea5-8a3f-6de2d2bebd3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da7d0785ce5f184856c4bbcbf4ca02f3, https://si.imgix.net/0a39ef43/uploads/origins/5b0eba1f-4db2-4ea5-8a3f-6de2d2bebd3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7426bce2288d307b45a9da63763c7ec 2x, https://si.imgix.net/0a39ef43/uploads/origins/5b0eba1f-4db2-4ea5-8a3f-6de2d2bebd3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fa2f83a20f7848d5f79ed8cb851ba93 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a39ef43/uploads/origins/5b0eba1f-4db2-4ea5-8a3f-6de2d2bebd3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21c9c2e643408893e48109b141b8adc5", "srcset": "https://si.imgix.net/0a39ef43/uploads/origins/5b0eba1f-4db2-4ea5-8a3f-6de2d2bebd3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21c9c2e643408893e48109b141b8adc5, https://si.imgix.net/0a39ef43/uploads/origins/5b0eba1f-4db2-4ea5-8a3f-6de2d2bebd3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=86ee14dcceca116d04bc9d2a1db89122 2x, https://si.imgix.net/0a39ef43/uploads/origins/5b0eba1f-4db2-4ea5-8a3f-6de2d2bebd3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=517088cbd15704309db538d32b16fbaf 3x"}, "body": "初めまして。\n素敵なイラストを拝見させていただきました。\n個人Vtuberのよりせなつと申します。\n\n絵柄が大変好みでリクエストさせていただきました。\n私自身のイラストを描いていただけないでしょうか？\n麻雀をしている、もしくは麻雀の牌を指で持っているイラストをお願い出来ればと思います。\n表情としては、強気、もしくは挑戦的な感じにしていただけると嬉しいです。\n\n【使用用途】\n・YouTubeのサムネイルへの使用\n・Twitter等のSNSへの投稿\n（使用の際にはTwitterのアカウント名を記載させていただきます）\n\n【要望】\n・構図、ポージング等はお任せいたします。\n・PSDデータで納品いただけると幸いです。\n　また背景がある場合は、別レイヤーにしていただけますと大変嬉しいです。\n\n【キャラクター】\n3面図を固定ツイートに載せておりますので参考にしていただければ幸いです。\n多少アレンジを加えていただいても問題ありません。\n描きやすいように描いていただければ嬉しいです。\nhttps://twitter.com/N_yorise_V\n\n何卒よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tuyu_umbrella/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2096410, "client_id": 2119358, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0d33edf/uploads/origins/db20d23b-79cf-4795-8b25-bcf44fe3eaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=698724b779bfb5e379bd71b24b527403", "srcset": "https://si.imgix.net/e0d33edf/uploads/origins/db20d23b-79cf-4795-8b25-bcf44fe3eaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=698724b779bfb5e379bd71b24b527403, https://si.imgix.net/e0d33edf/uploads/origins/db20d23b-79cf-4795-8b25-bcf44fe3eaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25563144c2b3453d8c7014fa7f203690 2x, https://si.imgix.net/e0d33edf/uploads/origins/db20d23b-79cf-4795-8b25-bcf44fe3eaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3281fbbb7321a12774004fcbd87ba952 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0d33edf/uploads/origins/db20d23b-79cf-4795-8b25-bcf44fe3eaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d8d15a1df2f56c912b0facfbb58b749", "srcset": "https://si.imgix.net/e0d33edf/uploads/origins/db20d23b-79cf-4795-8b25-bcf44fe3eaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d8d15a1df2f56c912b0facfbb58b749, https://si.imgix.net/e0d33edf/uploads/origins/db20d23b-79cf-4795-8b25-bcf44fe3eaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9fdaaf7d608173e0d257cecbaaa1594f 2x, https://si.imgix.net/e0d33edf/uploads/origins/db20d23b-79cf-4795-8b25-bcf44fe3eaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cd11d91df01f9bff2e77d6ce31512c5d 3x"}, "body": "個人での依頼、失礼します。\nここでは初めまして。なつれ🌸と申します。\n以前からイラスト可愛い～！とTwitter上で拝見させていただいております。(代理ちゃん可愛いです。🐸✨)\n読んでいただければ幸いです。よろしくお願いします。\nさて、\nはじめてイラストのご依頼をさせていただきます。\n私の推しの一人である、日々Youtubeで活動なさってる配信者の「卯ノ花しうね」ちゃんを描いてほしいです。\n使用用途は個人使用に留め、@nature097yのヘッダー等させていただきたいと思っております。\n―――――――――――\n◾️依頼したい内容\n◎『卯ノ花しうね』一体。一枚絵\n　作画：塗りまで。梅雨さんらしく可愛くポップでお願いいたします。(フルカラー。RBG)\n　構図：ウエストアップ(手袋見えると◎)\n\t※基本的にはお任せです。梅雨さんが描ける範囲のものを描くスタンスで構いません。\n・その他要望\n　衣服が普段のお衣装・水着・猫耳フードの三種ありますが、\n　水着でもフードもつけてない、角が見えショートパンツが可愛らしい「普段のお衣装」でお願いしたいです。\n　お名前入れると思うのですが、可能であれば文字無しの差分も納品していただけるとありがたいです。\n　\n◾️依頼したいイラストの希望サイズ\n　『横1500×縦500px（ピクセル）』\n　こちらに関しては合っていると助かりますが、あくまで目安で描きやすいように変更しても構いません。\n◾️納期の希望\n　なし。\n\n【参考資料】\n○卯ノ花しうね　立ち絵の資料(他の人へのリプになってますが、左側が普段の衣装になっております。)\n→資料URLに記載\n〇Twitterで、「#卯ノ花しうねち」で検索するとファンアートが出ますので参考までに。\n\n▸卯ノ花しうねについて\n趣味でAmong Usなど中心に配信。本業は漫画家さん（PN紺野賢護）緑茶、角好き。言葉遣いが優しく、謙虚。持て囃されたり目立ったりするのが、苦手な方。\n――――――――――――\n\n半分梅雨さんの描かれる推しを見てみたいのと、半分応援したいお気持ちでお送りしました。\n難しいご依頼かもしれませんが、受ける、受けないかはお任せします。\nお忙しい中であるかとは思いますがご検討よろしくお願いします。\n\nhttps://twitter.com/konken5/status/1431710885089665025", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 244143, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "1CH10🥩", "screen_name": "tetetetetetet_a", "avatar_url": "https://pbs.twimg.com/profile_images/1868995777995149312/bZHGq3DT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/978797272354861056/1775923772/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 161}, {"id": 619383, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ねむぎこ🐈🌾", "screen_name": "nemugiko", "avatar_url": "https://pbs.twimg.com/profile_images/1223547550763900928/EvioYAns.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3456734966/1766322664/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "firs