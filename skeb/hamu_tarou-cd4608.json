rop=top&w=200&h=200&s=52c09752b62c2f0eeda4247b326f63c1, https://si.imgix.net/a1f1bf3f/uploads/origins/12e1892b-2a25-4cd4-a338-2cf295ccd59b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ed684d8b763a80d8db07ab6185c8a14 2x, https://si.imgix.net/a1f1bf3f/uploads/origins/12e1892b-2a25-4cd4-a338-2cf295ccd59b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be7b9ecca80f893b3afc82d554269f8c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1f1bf3f/uploads/origins/12e1892b-2a25-4cd4-a338-2cf295ccd59b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20c2c04618ba95d80061125dae5aed2f", "srcset": "https://si.imgix.net/a1f1bf3f/uploads/origins/12e1892b-2a25-4cd4-a338-2cf295ccd59b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20c2c04618ba95d80061125dae5aed2f, https://si.imgix.net/a1f1bf3f/uploads/origins/12e1892b-2a25-4cd4-a338-2cf295ccd59b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=550582423816ffa98382c9f9691ea470 2x, https://si.imgix.net/a1f1bf3f/uploads/origins/12e1892b-2a25-4cd4-a338-2cf295ccd59b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a65a0bdb1dd7e71dded8700922cdecb6 3x"}, "body": "私のオリキャラのガザ美を描いていただきたいです。\nシチュエーションとしては抱き枕カバーっぽいベッドに寝転んでいるものを俯瞰した構図でお願いします。\n抱き枕カバーの絵によくあるポーズ(体を少し傾けて仰向けになっている奴)でお願いします。\nまた、もしよろしければカバーの裏表みたいに事前(着衣)と事後(全裸)を両方をいていただけると嬉しいです。\n事前はオリキャラの設定画のいつものキョンシー服でお願いします。\n事後の方は精液が胸の谷間と股間から溢れている様にしてください。(ただあまり大げさではない感じで)\n以上です。よろしくお願いします。\n\nhttps://www.pixiv.net/artworks/100831664", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamu_tarou/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 906190, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/460bdc70/uploads/origins/42ad69ac-73ff-46de-8d3c-32c8e67a6101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e21358ffd7230981465f127307f0842", "srcset": "https://si.imgix.net/460bdc70/uploads/origins/42ad69ac-73ff-46de-8d3c-32c8e67a6101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e21358ffd7230981465f127307f0842, https://si.imgix.net/460bdc70/uploads/origins/42ad69ac-73ff-46de-8d3c-32c8e67a6101?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e06d58d8dd62b5257ad7d3e7a3acf770 2x, https://si.imgix.net/460bdc70/uploads/origins/42ad69ac-73ff-46de-8d3c-32c8e67a6101?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a1ed448bcbd5f0cbb7cae6181bbe2f9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/460bdc70/uploads/origins/42ad69ac-73ff-46de-8d3c-32c8e67a6101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e488e9169702c1f70c2c2a4aa1a13d31", "srcset": "https://si.imgix.net/460bdc70/uploads/origins/42ad69ac-73ff-46de-8d3c-32c8e67a6101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e488e9169702c1f70c2c2a4aa1a13d31, https://si.imgix.net/460bdc70/uploads/origins/42ad69ac-73ff-46de-8d3c-32c8e67a6101?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=76a177997b6ecf8438d674dd525b008c 2x, https://si.imgix.net/460bdc70/uploads/origins/42ad69ac-73ff-46de-8d3c-32c8e67a6101?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=583c9352ea8c42e2bd5ae2ec74cb5ac4 3x"}, "body": "サムライスピリッツのいろはのイラストをお願いします。\n\nいろはがショタの手を引き別部屋に連れていく様子と出てきた様子(簡単に言えば事前と事後)のイラストをお願いします。\n\n連れていく際はショタはガチガチに勃起しており、いろはは衣服の上からそれを弄っている。同時にいろはは舌なめずりとかしてると良いですね。\n\n出てくる際にはどちらも衣類が乱れており、汗だくの状態。できればで良いのですがいろはの口周りやその他身体の部分にところどころ陰毛がついているとありがたいです。\n二人とも気持ち良さそうで満足している様子(ショタの方はよだれとか垂らしてかなり惚けている)で描いて頂きたいです。\n\nいろはは普段描かれているようにムチムチ爆乳でお願いします。\n\nその他細かい点はお任せします。\n\nご検討の程宜しくお願いします。\n\nhttps://www.snk-corp.co.jp/official/samuraispirits/characters/iroha.php", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamu_tarou/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 906190, "client_id": 2158210, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8c53340/uploads/origins/5f3b8cad-4a10-41cc-9c60-0351f544bed0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d21300bc4f6734bc446a2b678eaafa76", "srcset": "https://si.imgix.net/a8c53340/uploads/origins/5f3b8cad-4a10-41cc-9c60-0351f544bed0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d21300bc4f6734bc446a2b678eaafa76, https://si.imgix.net/a8c53340/uploads/origins/5f3b8cad-4a10-41cc-9c60-0351f544bed0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bfeed6de68a6ac813395cc278a70f7c 2x, https://si.imgix.net/a8c53340/uploads/origins/5f3b8cad-4a10-41cc-9c60-0351f544bed0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=508a4b710da426a252ed57e49cbcdd55 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8c53340/uploads/origins/5f3b8cad-4a10-41cc-9c60-0351f544bed0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45deb9148bb28696a082c524b2633089", "srcset": "https://si.imgix.net/a8c53340/uploads/origins/5f3b8cad-4a10-41cc-9c60-0351f544bed0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45deb9148bb28696a082c524b2633089, https://si.imgix.net/a8c53340/uploads/origins/5f3b8cad-4a10-41cc-9c60-0351f544bed0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dce4536669ab4584151727b9df9dc875 2x, https://si.imgix.net/a8c53340/uploads/origins/5f3b8cad-4a10-41cc-9c60-0351f544bed0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3c58347c32caefbfdd624fd2025645e9 3x"}, "body": "こんにちは。あなたの絵がとても好きです!ブリジットの双子の兄のコンセプトを描いていただけませんか？双子なので、ブリジットに似ているのですが、顔は少し男性的で、とても疲れていて、疲れているように見えると想像しています。\n\n\n服装はこんな感じかな。https://i.etsystatic.com/11168493/r/il/c02dd6/776635524/il_fullxfull.776635524_em8i.jpg\n\nまた、このように、裾の部分が多少ボロボロで擦り切れているような感じをイメージしています。\nhttps://static.wikia.nocookie.net/characterprofile/images/5/5e/Alucard_Hellsing.png/revision/latest?cb=20160613171956\n\n最後に、このようなクロススタイルのネックレスを考えています。\nhttps://cdn.cokesbury.com/images/products/ExtraLarge/047/538047.jpg\n\n彼はファイターなので、クールなディテールは、ガンソードタイプの武器かもしれません。\nhttps://i.pinimg.com/originals/17/65/e2/1765e2f6795f52875d68fd34d15ede0a.jpg\n(このディテールはちょっとやりすぎかもしれないので、もし描きたくないのであれば、私は理解していますwww )\n\nこのキャラは話題になるだけで出てこないので、あまり参考にならないかもしれませんが、よろしくお願いします。\n\nご検討のほど、よろしくお願いいたします", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamu_tarou/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 906190, "client_id": 659589, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71c2c860/uploads/origins/1a4efd63-3336-4dec-88c0-8593772ebbac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0c5ad72e55906c8a09e98a451d0d184", "srcset": "https://si.imgix.net/71c2c860/uploads/origins/1a4efd63-3336-4dec-88c0-8593772ebbac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0c5ad72e55906c8a09e98a451d0d184, https://si.imgix.net/71c2c860/uploads/origins/1a4efd63-3336-4dec-88c0-8593772ebbac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18bc76874c844b4beab4dd00696a3ad1 2x, https://si.imgix.net/71c2c860/uploads/origins/1a4efd63-3336-4dec-88c0-8593772ebbac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9c9755c00609243271a532c7c49fc0d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71c2c860/uploads/origins/1a4efd63-3336-4dec-88c0-8593772ebbac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7c560800364524417f10e9e79d20fff", "srcset": "https://si.imgix.net/71c2c860/uploads/origins/1a4efd63-3336-4dec-88c0-8593772ebbac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7c560800364524417f10e9e79d20fff, https://si.imgix.net/71c2c860/uploads/origins/1a4efd63-3336-4dec-88c0-8593772ebbac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8e4603d9028c806918a83d48abcabbc5 2x, https://si.imgix.net/71c2c860/uploads/origins/1a4efd63-3336-4dec-88c0-8593772ebbac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dc50fb4fd9da8663bafc0fdffadb1bda 3x"}, "body": "ハム太郎さん、こんにちは！お元気ですか？ハム太郎さんの作品は本当に大好きです！エステラへの愛に感謝します。エステラのアートは超レアで、彼女のデザインに興味を持つ人がいるのは嬉しいことです。ノエルとエステラが3ポーズでセックスしている絵をリクエストしたいのですが、以下のリファレンスを参考にしてください→https://imgur.com/a/XMA1n9c\n\n設定はこれに近いと思います→https://skeb.jp/@hamu_tarou/works/4\n\n\n最初のポーズでは、エステラがノエルの腰を抱きながらディープスロートし、口の横に精液を垂らしています。ノエルはスカートをたくし上げ、変なオーガズム顔をする。エステラはオリジナルの衣装で、ノエルは修道服を着ています。\n\nポーズ2は、両者とも正面を向いた後背位です。ノエルがエステラの両足を持ち上げて、エステラは両手を地面につけてバランスをとります。エステラはスリングビキニ、ノエルはクロノファンタズマの水着を着用している。ノエルはにっこり、エステラはアヘ顔。\n\n\nポーズ3は、エステラがノエルの膝の上でセックスした後、両キャラクターがヌードになっているものです。ノエルは目を閉じて、満足そうにため息をついています。エステラはノエルを愛おしそうに見つめながら、にっこり笑っている。最後にノエルのペニスは柔らかくなり、エステラのマンコからは精液が漏れている。\n\n\nこのリクエストにはどんな自由があっても全く問題ありません。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamu_tarou/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 906190, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0dd25c13/uploads/origins/214ad842-6408-45e2-96c7-ed72b46a4332?bg=%23fff&auto=format