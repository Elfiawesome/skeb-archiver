参考にしてください。）\n\n内容 & 参考資料\nhttps://drive.google.com/drive/folders/143d6CYL77RoG1-av1fibwntuBU3XwoMw\n\nもしプロットの配置に誤りがあれば、自由に修正してください。また、料金が不足している場合は、お手数ですが、再度料金をご案内いただければ幸いです。\n最後に、リクエストをお受けいただけることを願っております。どうぞよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Faugnsama/works/216", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2a4a9fd2/uploads/origins/e5683334-cae1-4e05-a9f3-aa113389f9f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ba9246c211310853f5fd90f34302b93", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 584888, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Faugnsama/works/215", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3e05a319/uploads/origins/1a99833e-2988-4536-9e37-b704e0c58bed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2975fbf5c83b832372d6c884bba6ecd3", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 584888, "client_id": 1534616, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 179, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Faugnsama/works/214", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b6f657d8/uploads/origins/f261b654-3cbe-4e9b-9c43-3526465da9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalig