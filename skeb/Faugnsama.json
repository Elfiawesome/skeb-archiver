d-4751-87c1-5aa480812f7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfa68840e88dbca15b98c60561d926b4", "src_set": ""}, "body": "いつも素晴らしいイラスト・漫画をありがとうございます。\nお忙しいところ募集再開とのことで良ければリクエストさせてください。\n\n前回リクエストさせていただいた、パイズリ次やったらコレだからなリクエストで後ろ姿が出ていた三つ編み長乳モブ女性が最高でした。良ければ彼女でリクエストさせてください。\n\nいつもの男性ケンがバニーのお姉さんたちがいるお店に行くと、三つ編み長乳モブ女性が働いていてケンに気が付く。\n他の女性店員が話しかけにこうとするのを止め、長乳モブ女性がケンに話しかけてお酒を渡す。ケンがチップを渡そうとすると、胸部分の服をめくって乳首を見せながら挟んで受け取り耳元で何分後に奥のトイレで待ってると囁いてくる。\n\n三つ編み長乳モブ女性は他女性店員さんと比べて胸が垂れた感じですと嬉しいです。\n問題がありましたらキャンセルしていただいて構いません。\nご検討よろしくお願いいたします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Faugnsama/works/226", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/13b047d4/uploads/origins/f102b124-c199-4658-a26a-ec9ae8717201?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=278e8f9be57582631b81c7d242f34f53", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 584888, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Faugnsama/works/225", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e16b2b30/uploads/origins/298574b9-8e57-4a8a-b825-5476225dc9a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e58456428b50444edd57025b338b99f3", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 584888, "client_id": 1534616, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_coun