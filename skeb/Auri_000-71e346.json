core": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1907191008410120192%2F2uzb0xyx.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5e01038db2daaeafc414f0ebade2569", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1907191008410120192%2F2uzb0xyx.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5e01038db2daaeafc414f0ebade2569, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1907191008410120192%2F2uzb0xyx.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dcac913603245544760023104aae5237 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1907191008410120192%2F2uzb0xyx.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69ffd3ac847835d2e223a4aaf0515998 3x"}, "body": "罵倒ボイスが聞きたい!\n\n見下したニヤッとしてる感じ\n後半は引いてる感じでお願いします。\n\n以下依頼ボイス\n\nへぇ、人間ごときが悪魔の僕を呼び出すなんて、いったいどんな願いをがあるんだい?\n\n……はぁ?罵って欲しい?\nハハハハハハ、本当に人間って馬鹿だよねぇ?\n気持ち悪い。\nじゃあ頼み方って知ってるよね?\nほら、頭が高いよ?土下座だよ土下座。\nもっと地面にその顔を擦り付けてさ。\n\nうわぁ、本当にするんだ。\nハハハハハハ、その頭ちょうどいい足置きじゃないか。\n痛い?ほら、もっといい声で鳴きなよ?\n踏みにじられてどんな気持ち?\nどんな生き方してたらそんなみじめになれるの?\nねぇ?教えてよ?ねぇねぇ?\nミジンコの方がまだ有益な生き方してるよ?\n生きてるだけで二酸化炭素を増やすだけの、くだらない生き物。\n今までなにか有益なことなんてしたことないでしょ?\nきっと君は、人間の中でも特に1番愚かで、ゴミ以下の存在だね?\n\n……こんな感じでいいかい?\nあ、いいんだ。\nお、おう、すっごい満足そうな顔だね。\nじ、じゃあ代金の魂貰っていくね?\n\nうわぁ、魂状態でもわかるくらい喜んでるぅ……\n最近多いんだよなぁ……\nホントに人間ってよく分からないなぁ", "nc": 145, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@Auri_000/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 262062, "client_id": 3425472, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c18dfd3/uploads/origins/2d400988-2862-436a-845d-f3709827cd50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=c