などいるまさんにお任せさせていただきます！\n一応、デフォルトの立ち絵は、制服になっております🎀\n\nまた、資料内で衣服が何種類かありますが、いるまさんの書きやすい服装を採用いただけると幸いです👍🏻\n\n金額に関して、足りない等あれば再送またはキャンセルでのご対応をお願いいたします\n\n\n\nまた、いるまさんのイラストでの自陣が見られることを非常に楽しみにしております🤍\n\nhttps://drive.google.com/drive/folders/1ET25LgdYqbf5Al918Vz1JTW-42ArCZk5?usp=share_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@iruma_el/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3802862, "client_id": 3338713, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b559363b/uploads/origins/e2e3d9ca-f35a-4839-b9bb-aa4b1698faf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2d01ed3ed6dc0dcc5d6deb3bf25c732", "srcset": "https://si.imgix.net/b559363b/uploads/origins/e2e3d9ca-f35a-4839-b9bb-aa4b1698faf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2d01ed3ed6dc0dcc5d6deb3bf25c732, https://si.imgix.net/b559363b/uploads/origins/e2e3d9ca-f35a-4839-b9bb-aa4b1698faf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c8cc1a9cc9c741c03d43ed3b9e94515 2x, https://si.imgix.net/b559363b/uploads/origins/e2e3d9ca-f35a-4839-b9bb-aa4b1698faf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac025bc6965a217e0cb8dfe256814342 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b559363b/uploads/origins/e2e3d9ca-f35a-4839-b9bb-aa4b1698faf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6c56b97893f524d5e14d1870da629e9", "srcset": "https://si.imgix.net/b559363b/uploads/origins/e2e3d9ca-f35a-4839-b9bb-aa4b1698faf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6c56b97893f524d5e14d1870da629e9, https://si.imgix.net/b559363b/uploads/origins/e2e3d9ca-f35a-4839-b9bb-aa4b1698faf6?bg=%23fff&auto=format%2Ccompr