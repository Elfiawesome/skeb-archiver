47bbaba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06c489e09f20f4d92df711ad72ae23df", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b42daac5/uploads/origins/e29fc26d-861f-4a90-aa48-99c647bbaba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53f9a4a0867926f039d3bae453b3fa54", "src_set": ""}, "body": "アピールをありがとう！\n\nOCのモカを描いていただけませんか？  モカは28歳。カウガールで、性格はとても温厚で優しい。彼女はまた、不器用でかなり空気が読めない傾向があります。コーヒーやアイスクリームなど、乳製品に関するものに夢中。ポーズなどの詳細はお任せします！\n\nありがとうございました！素敵な一日をお過ごしください！\n\nhttps://drive.google.com/drive/folders/1OmgXf3gJVkk886XqTTI5W_3F5oOHxHsH?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ran10295/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3137287, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/492f2960/uploads/origins/698712a9-c097-49ed-82db-d60e9b6775e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1bf620d624560cf79922774891c1d3b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/492f2960/uploads/origins/698712a9-c097-49ed-82db-d60e9b6775e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46c6b54b22021888f8aadc230f46d3ee", "src_set": ""}, "body": "アピールありがとうございます。\nキャラクターに興味をもっていただきありがとうございます。\n\nアピール元と同様の女の子のイラストをお願いできればと思います。\nこちらは参考画像ですが、セーラー服のデザイン・表情・ポーズ・構図は自由です。\nhttps://drive.google.com/drive/folders/1RIJ2bUUoPHZDhYmSZ5NlFco0yYrqRyDg?usp=sharing\n\n以下、リクエスト内容です。\n\n■女の子\n・艶やかな黒髪の前髪ぱっつん、少し内巻きのショートボブ、横髪・後ろ髪は口のラインくらいで切り揃えている、襟足はソフトに刈り上げ(構図次第で見えなくてもOK)\n・半袖のセーラー服\n・元気な感じ\n■シチュエーション\n・右腕にケガでギプスをしていて、三角巾で首から吊っている\n　‐首と肘のところの三角巾の結び目を見える位置にお願いします(資料URLご参照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ran10295/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3137287, "client_id": 3007284, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e183524/uploads/origins/b7e299b6-7b83-4af0-9ad8-748c6c5ace41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d500f76a1c836f538d288f951b1c743", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e183524/uploads/origins/b7e299b6-7b83-4af0-9ad8-748c6c5ace41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f1647cbb113251132e5533084abe100", "src_set": ""}, "body": "こんにちは！アピールありがとうございます！私のキャラクターを描いてほしいです！動画コンテンツでも使わせてもらうと思います！あなたが一番似合うと思うものを自由に描いてください！もしもっと僕のことを知りたいなら、参考URLに僕のチャンネルをリンクしておくよ！\n\nhttps://www.youtube.com/@YuYuBunBunVTuber", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1093518, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "くつだみる@Skeb募集中", "screen_name": "m_i_r_m_i_r_", "avatar_url": "https://pbs.twimg.com/profile_images/1607055649346850816/ulL8Yf2c.jpg", "header_url": "https://pbs.twimg.com/profile_banners/864180687452094465/1707737695/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "skills": [{"genre": "art"}], "nc": 160}, {"id": 2463972, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "まり@オルエンに全振り", "screen_name": "ursla99"