ど、細かいところは任せるよ。\n\n出来上がったらSNSにアップしたいです。よろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kagura0savant/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2959719, "client_id": 1280473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c341463/uploads/origins/60a56db2-e3a8-4a66-bf18-4a7ec313af43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9c12651ebc5a84cdc3fc6893cd881dd", "srcset": "https://si.imgix.net/9c341463/uploads/origins/60a56db2-e3a8-4a66-bf18-4a7ec313af43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9c12651ebc5a84cdc3fc6893cd881dd, https://si.imgix.net/9c341463/uploads/origins/60a56db2-e3a8-4a66-bf18-4a7ec313af43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07418b5d31f08c1aa484c93127f852b5 2x, https://si.imgix.net/9c341463/uploads/origins/60a56db2-e3a8-4a66-bf18-4a7ec313af43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97389a58f492b7d7bdf3b0698f8777d3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c341463/uploads/origins/60a56db2-e3a8-4a66-bf18-4a7ec313af43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2af9980632d001b845107f81da8c81f6", "srcset": "https://si.imgix.net/9c341463/uploads/origins/60a56db2-e3a8-4a66-bf18-4a7ec313af43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2af9980632d001b845107f81da8c81f6, https://si.imgix.net/9c341463/uploads/origins/60a56db2-e3a8-4a66-bf18-4a7ec313af43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=219a89a41ef54b5210f46dc6457fc3a9 2x, https://si.imgix.net/9c341463/uploads/origins/60a56db2-e3a8-4a66-bf18-4a7ec313af43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=