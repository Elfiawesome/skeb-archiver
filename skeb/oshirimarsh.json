acceptable_same_genre": true}, {"path": "/@oshirimarsh/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2998122, "client_id": 1282666, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b65c520f/uploads/origins/e8606a3a-c1df-4b6c-aa36-429baa583062?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d8a4a325d50387eb031b480e26ff89b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b65c520f/uploads/origins/e8606a3a-c1df-4b6c-aa36-429baa583062?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83519218000f6a8ab1883d51c908d567", "src_set": ""}, "body": "こんにちは！\n\n今回は、セレーネとコウタロウが一緒に庭仕事をした後、外でセックスをしてほしいというリクエストです。セレーネとコウタロウが庭仕事を終えて、コウタロウがシャツを脱ぐと、セレーネは彼が最近少し筋肉質になっていることに気づき、彼の胸に手を置いてキスをするところからシナリオは始まる。セレーネがクイック・セックスをする時間はあるかと尋ねると、幸太郎は笑いながら自分もしたかったと言う。\n\n2人が庭の木を背に後背位でセックスしているシーンに切り替わり、鼓太郎が彼女の中でクンニする。そして2人が木の下で水を飲み、微笑みながら他愛もない話をしているシーンに切り替わる。\n\nセレーネは195cm、鼓太郎は177cm。セレーネの脇の下とアソコは毛深く、鼓太郎のペニスは大きい。登場人物、衣装、体位など参考にさせていただきました。よろしくお願いします！\n\nhttps://imgchest.com/p/m9yxjlne34q", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oshirimarsh/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2998122, "client_id": 3323736, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03ad9422/uploads/origins/c5ce43d2-3233-4505-8cc2-b5f3a6922633?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a97b28092c774b8e8da69d1febed7082", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03ad9422/uploads/origins/c5ce43d2-3233-4505-8cc2-b5f3a6922633?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=067d0c58960e540cea301f73b36f3eee", "src_set": ""}, "body": "こんにちは、志位志位先生！初めてお目にかかります！先生の作品の雰囲気や質感が特に好きです！私のオリジナルキャラクターの漫画を描いていただけませんか？\n\n参考にさせていただきます。\nhttps://x.com/oshirimarsh/status/1886865666252399006/photo/1\nhttps://x.com/oshirimarsh/status/1887199131959205988/photo/1\n\nキャラクター紹介はこちら\nhttps://skeb.jp/@Pzapanonigiri/works/25。\nhttps://skeb.jp/@kusakado_w/works/7\n\nアイデアは先生にお任せします！ナレーションや台詞の追加は自由です。\nキャラクターの服装や装飾、性別の変更も自由です。\n先生の解釈を楽しみにしています。\n\nもし先生がスケッチや初稿を残していたら、ぜひ見せてください。\n\n 量が足りない場合は、再送を申し出ていただければ、喜んで再送いたします。\n\nhttps://drive.google.com/drive/folders/1yloGC6DOqXy26_MFC8P_fIaxZ03ROEm5?usp=sharing", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oshirimarsh/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b859cc44/uploads/origins/af580d6a-54f0-4db9-b9ed-39838626e95a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f23fcc1745ea104efcf1f98865a7b65f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2998122, "client_id": 210981, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@oshirimarsh/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2998122, "client_id": 1282666, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae8141bf/uploads/origins/f181cc2c-6ede-42d1-99d8-20f4eb961415?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b8143c8dd729cf3b1202d7997a811e4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae8141bf/uploads/origins/f181cc2c-6ede-42d1-99d8-20f4eb961415?bg=%23fff