table_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@oshirimarsh/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2998122, "client_id": 1040855, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e63f187d/uploads/origins/7f6f7b4f-f5b6-4f93-b108-3bf3437c5e64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=708474e8e5db04e1cc5b442b245392e7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e63f187d/uploads/origins/7f6f7b4f-f5b6-4f93-b108-3bf3437c5e64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9b7438821c7c6faa3d453b185d383ef", "src_set": ""}, "body": "尻敷さん\nお疲れ様です。\nきらきーと申します。\n\nアイコンにも使えるイラストが欲しく依頼させていただきました。\n※依頼にあたって、当オリジナルキャラは画像生成aiを用いて作っている事をご了承ください。\n\n\n①依頼するイラストの内容\nご共有しました画像のキャラクターの斜め上からの俯瞰気味の構図で、カメラ目線で指ハート（親指と人差し指をクロスするやつ）しているイラストを頂きたく存じます。\n\n※設定的には14〜15歳ぐらいの少女です\n※大変贅沢なおねがいですが、顔～バストアップぐらいを丸く切り抜いてアイコンにする予定のため、その際に際立つイラストだと助かります。\n\n背景は無地ないし透過で構いません。\n\nサインを書いていただける際、わたしの名前は英語表記の際は「To Kiraki」でお願いします。\nひらがなの場合は「きらきー」で構いません。\n\n②細部指定\n・髪色はブロンド～アイボリーの間で、尻敷さんが素敵と思われる色合いにしてください。\n・目の色は鮮やかな紫にして、ラメのような細かい光が沢山入っているデザインにしてください。\n・薔薇の髪飾りがどうやってついているかに特に設定はありません。\n\nそれ以外はおまかせします。\n\n③バリエーションの希望\n背景ありと透過verの2種類がありますと助かります。\n\nhttps://drive.google.com/drive/folders/1SvffMdWhBbaUuiU3WaQxEB1_HCU75kel", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oshirimarsh/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2998122, "client_id": 1282666, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2f8fcbe/uploads/origins/a20ba471-68f9-4ea0-b82d-c04915128261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28cb64105947c6b4baff645e0b254bda", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2f8fcbe/uploads/origins/a20ba471-68f9-4ea0-b82d-c04915128261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=414e9795ae0f9c03a93c79a621f80739", "src_set": ""}, "body": "こんにちは、\n\n今回は光太郎がセレーネ、弟の千夜、母親のセリカとセックスしている漫画のリクエストです。セレーネ、セーニャ、セリカの3人がランジェリーを身につけ、それぞれ違う方法で光太郎とセックスする。\n\nコウタロウはセーニャとアナルセックスをして中出しする。\n\n光太郎はセリカから深いフェラチオを受け、セリーンは彼のお尻の穴を舐める。\n\nコウタロウはセリーンとミッション・セックスをし、彼女を孕ませる。\n\n最後のページでは、光太郎が疲れ果てた顔をしている間、全員がベッドで光太郎に抱きついているかもしれない。\n\n光太郎は177センチ\n千矢は180cm\nセリーンは199cm\nセリカは208cm\n\nセレーネとセリカはワキ毛とアソコ毛が濃い。セーニャのお尻は大きく、陰毛も少ない。\n\n登場人物の参考資料も載せましたので、あとは全てお任せします。お疲れ様でした！\n\nhttps://imgchest.com/p/dl7pelen6yo", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oshirimarsh/works/20", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3361ce70/uploads/origins/2385a0f2-4747-4d65-8910-55e31d14cefc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91a0f7a4fb1650c43c95ee8914c2e90f", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 2998122, "client_id": 1079150, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@oshirimarsh/works/19", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0f6c33da/uploads/origins/59aac510-4a46-4da8-8044-dced88152fcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f94054bcdabbcfd87b779aab5eb231d3", "src_set": ""}, "private": tru