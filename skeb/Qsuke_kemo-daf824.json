a30-8eb2-4bfd-8b7e-4eb9f64450fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=014f71abc1bcf5eee2e325aba410a5ec", "srcset": "https://si.imgix.net/dc614a79/uploads/origins/28cfda30-8eb2-4bfd-8b7e-4eb9f64450fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=014f71abc1bcf5eee2e325aba410a5ec, https://si.imgix.net/dc614a79/uploads/origins/28cfda30-8eb2-4bfd-8b7e-4eb9f64450fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cd40a2a2ec544f4eb06f9f815432ca22 2x, https://si.imgix.net/dc614a79/uploads/origins/28cfda30-8eb2-4bfd-8b7e-4eb9f64450fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=269c911b2ecd9476899feff5bf898bbe 3x"}, "body": "Q助さま。初めまして。\n初めてのリクエストで上手く伝えられるか不安ですが、\n下に要望を羅列いたします。\n\n・ドリームメーカー様より作成していただいたOCがメイン。\n黄色帽子はあってもなくても良いのでおまかせします。\n\n・シチュエーションは鬼畜なモブケモおじ(筋肉)×性奴隷OCです。\n(過去にQ助さまが描いたこちら[https://x.com/qsuke_kemo/status/1681313913516990470?s=61&t=r2KUVpelirNUdwyFqyM1kA]のイラストと似たシチュを希望しています)\n\n・OCには鈴付きリード付きの赤首輪と右足に拘束具的が装着されており、\nケモおじがOCの左足を持ち上げつつ、\n後ろから右手のリードを引っ張りながら無慈悲セックスをしているシチュです。\n\n・OCの性器は半剥けで呼吸の為に口を開閉させながらも暴力的なセックスにより射精している感じです。\nまた、ケモおじは絶頂しているOCに口を開き歯形をニヤつかせている感じを出して欲しいです。\n\n・腹ボコや腸内透け差分もお願いします。\n上記の参考イラストと同様に2枚ほどくださると幸いです。\n\n・背景は監獄要素がある壁際もしくは廊下を希望しています。\n\n以上です。\nもし金額的に見合わない箇所があれば再送をお願いいたします。(＞人＜;)\n\nhttps://drive.google.com/file/d/1NAtJt1YjxsncChGb7GalK29OtQTdpLdG/view?usp=drivesdk", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Qsuke_kemo/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a7fa0a57/uploads/origins/7eef3050-883d-4071-a828-d764813f5da4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff77809ae37f055758aa1856dc7b77ad", "srcset": "https://si.imgix.net/a7fa0a57/uploads/origins/7eef3050-883d-4071-a828-d76