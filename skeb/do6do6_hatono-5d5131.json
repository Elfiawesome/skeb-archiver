=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69faac889ca281381d413afde7899bc7, https://si.imgix.net/5389bff2/uploads/origins/0bb66c17-f895-4373-898f-591852be794f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5119cd892d901f4d4880ceb942bcc7ac 2x, https://si.imgix.net/5389bff2/uploads/origins/0bb66c17-f895-4373-898f-591852be794f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c838bf3400ea94d351c181b69d155f1a 3x"}, "body": "はとの🕯さん、こんにちは！\nXにて素敵な作品を拝見しており、ぜひ私もリクエストさせていただきたいと思いご連絡申し上げました。\n\nこの度は私のOCを描いていただけないでしょうか！\n資料には2人のOCが載っておりますので、気になる子を選んで描いてもらえれば！と思います。\n(もちろん、2人まとめて描いていただいても構いません！金額とお時間の兼ね合いをみてご判断くださればと思います)\n\n描いていただいたイラストはわたしの個人鑑賞用としてSNSアイコン等への使用、非営利のグッズ制作などさせていただきたいと考えております。\nそのため、PSD形式での納品ですと助かります！\n\n金額不足など何かしら不備がございましたら再送要請をしていただければ幸いです。また、その他不都合な点があれば遠慮無くキャンセルしてください。\n何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1lIxPW1eysvBlJB8VF4_PTV1e-0MWbXjM", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@do6do6_hatono/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3043284, "client_id": 3332637, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4064a2aa/uploads/origins/2d119ead-db39-4a82-9361-23c10f3bffb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9575fbc6c621327753e9e4e0b62c8311", "srcset": "https://si.imgix.net/4064a2aa/uploads/origins/2d119ead-db39-4a82-9361-23c10f3bffb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9575fbc6c621327753e9e4e0b62c8311, https://si.imgix.net/4064a2aa/uploads/origins/2d119ead-db39-4a82-9361-23c10f3bffb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0353728c139096a130fdf6134e24337 2x, https://si.imgix.net/4064a2aa/uploads/origins/2d119ead-db39-4a82-9361-23c10f3bffb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=acd13a55567339228c191a38efdd0b30 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4064a2aa/uploads/origins/2d119ead-db39-4a82-9361-23c10f3bffb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2abf338d1e5373325ff98a4804aa3bf4", "srcset": "https://si.imgix.net/4064a2aa/uploads/origins/2d119ead-db39-4a82-9361-23c10f3bffb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2abf338d1e5373325ff98a4804aa3bf4, https://si.imgix.net/4064a2aa/uploads/origins/2d119ead-db39-4a82-9361-23c10f3bffb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0985fd3175a551f66bf3bac7c558075e 2x, https://si.imgix.net/4064a2aa/uploads/origins/2d119ead-db39-4a82-9361-23c10f3bffb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9bebefe336e9811348c67108edc910c4 3x"}, "body": "はとの様\n\nこんにちは。ご依頼失礼いたします。\nはとのさんの柔らかくも冷たさを兼ね備えた絵柄が大好きです！\nよろしければ、自創作の二人を描いていただきたいと思い、依頼させていただきました！\n\n【依頼内容】\n⬛︎内容:二人が一画面に収まっている一枚絵、もしくは二人のSD(ミニキャラ)イラスト\n(便宜上内容を指定しましたが、イラストの内容、雰囲気などははとの様に自由に設定し、描いていただきたいです)\n⬛︎人数:2人(バベル、カナン)\n⬛︎服装:自由(立ち絵は普段の服装です。髪型や衣装のアレンジもしていただいて構いません)\n⬛︎用途:個人利用(スマホ、パソコンの壁紙など/SNSのアイコンやヘッダー/個人での観賞)\n\nその他、特に指定はありません。\n\n【世界観/キャラクターについて】\n⬛︎あらすじ\n　記憶をなくした男バベルは、荒野のただ中で目を覚ます。気が付いた時、彼は自分の名前以外の一切を忘却していた。\n　そして、目を覚ました彼の顔を一人の女性が覗き込んでいた。その女性、カナンは自らが研究者であることを明かし、彼を連れてある場所を目指す。そこに待っていたのは巨大な飛行船「ノア」だった。\n　ノアには、カナンを含め六人の船員たちが乗船していた。カナン曰く、彼らはノアに積み込まれた匣──「アーク」によって記憶をなくしており、バベルもその一人であるという。彼らのなくした記憶を辿るため、七人は匣の中の記憶を尋ねる。\n\n⬛︎バベル(Babel)\n記憶喪失で、自分の名前すらも覚えていない。\n飛行船ノアでの旅を通じて、自分の記憶を取り戻すことを目的としている。\n普段から仏頂面で表情があまり変わらない。冷静で理性的な判断をするが、仲間に危機が訪れた時などは感情的になることもある。\n甘いものが好き。好物はドーナツ。珈琲は少し苦手。\n\n⬛︎カナン(Kanaan)\n不思議な雰囲気を纏った白衣の女性。\nノアやアークを作った張本人で、本人曰く「何でもわかる」才女。\nアークによって記憶を無くした人に対して記憶を返すことを目的としている。\n基本的になんでも卒なくこなすが、ほんの少しだけ抜けているところも。\n珈琲が好き。特に作業中はよく飲んでいる。\n\n二人の設定については、Googleドライブ上の資料画像にも記載しております。\nまた、設定で分かりづらい箇所などは適宜補完して、ある程度自由に描いていただければと思います。\n\nもしご依頼が難しい場合はご放念ください……！！\n長文失礼いたしました。お手数ですが、ご確認のほどよろしくお願いいたします。\n\n【Googleドライブ】\nhttps://drive.google.com/drive/folders/1otK5GiP1CSunw4m74K-LIAmziX3KfkRn\n\nhttps://drive.google.com/drive/folders/1otK5GiP1CSunw4m74K-LIAmziX3KfkRn", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@do6do6_hatono/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3043284, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81bf9f9e/uploads/origins/7388f36e-9f32-4092-a427-134aa6d22ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe74d13ff7cc2eed55b527be5d4cb300", "srcset": "https://si.imgix.net/81bf9f9e/uploads/origins/7388f36e-9f32-4092-a427-134aa6d22ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe74d13ff7cc2eed55b527be5d4cb300, https://si.imgix.net/81bf9f9e/uploads/origins/7388f36e-9f32-4092-a427-134aa6d22ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0e378ea04aed05ff5d1639dbe2c73d8 2x, https://si.imgix.net/81bf9f9e/uploads/origins/7388f36e-9f32-4092-a427-134aa6d22ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1453826ff700ea3be5b54e5167c9715e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81bf9f9e/uploads/origins/7388f36e-9f32-4092-a427-134aa6d22ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e062f859ad79cfeed556a6b6bc9854c", "srcset": "https://si.imgix.net/81bf9f9e/uploads/origins/7388f36e-9f32-4092-a427-134aa6d22ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e062f859ad79cfeed556a6b6bc9854c, https://si.imgix.net/81bf9f9e/uploads/origins/7388f36e-9f32-4092-a427-134aa6d22ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2b33c35d740ff25f64ae7c06b2c9b609 2x, https://si.imgix.net/81bf9f9e/uploads/origins/7388f36e-9f32-4092-a427-134aa6d22ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=295f9c5ce3415ded7c4c098a8580733a 3x"}, "body": "はとの様、初めまして。\n検索よりお声掛け失礼します。TLを眺めていたところ、素敵なイラストが目に入り、是非主様の絵柄で私のコテキャを見たいと思いリクエストさせていただきました。ダークめな塗りやイラストの雰囲気、人間の表情全てがとても素敵で大好きです。\n\n以下詳細の方失礼します。\n\n《構図》\n薄暗い部屋の床もしくはベッドに仰向けで倒れていている。腕の位置、姿勢などはお任せします。(可能であれば大の字以外でお願いします)\n\n《表情》\n口はで閉じ気味半開き、ハイライトのない虚ろな瞳でぼーっとしている。泣き跡があると嬉しいです\n\n《シチュエーション》\n辛い事が積もりに積もって限界を迎え久しぶりにODをしたらやりすぎてしまい訳がわからないまま放心する図。描写範囲はおまかせします。\n\n《希望》\n・床に錠剤の空き箱もしくはシートを散りばめて下さると嬉しいです。スマホも置いてあると助かります。\n\n・コテの身体は胸は大きめ、それ以外は華奢。足や腕は胸の割に細めです。\n\n・髪型はウルフカット(資料参考までに)\n\n《服装》\n黒いブラ(肩紐細め)に黒パーカーをきている。(前チャックは開ける)\n下は太もも上丈の半ズボン\n\n内容が内容ですので不快でしたらキャンセルしていただいて構いません。skeb依頼が初めてな為失礼を働いていたら申し訳ないです。金額,詳細が足りなければ再送申請をしていただけると幸いです。ご検討よろしくお願いします。\n\nhttps://lit.link/XXllyt", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@mido_mads/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2720616, "client_id": 3043284, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0447894c/uploads/origins/13d8fbb9-1217-4ee5-9217-3ba43cf50f3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6058daf8a4165a948ff66a9e64601f63", "srcset": "https://si.imgix.net/0447894c/uploads/origins/13d8fbb9-1217-4ee5-9217-3ba43cf50f3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6058daf8a4165a948ff66a9e64601f63, https://si.imgix.net/0447894c/uploads/origins/13d8fbb9-1217-4ee5-9217-3ba43cf50f3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1edc9d5d9bcc309dd49dd2ea1d60f4f1 2x, https://si.imgix.net/0447894c/uploads/origins/13d8fbb9-1217-4ee5-9217-3ba43cf50f3f?bg=%23fff&auto=