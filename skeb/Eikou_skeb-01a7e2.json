%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c80ac0ef8baaecb8770c93cd3ab2900e", "srcset": "https://si.imgix.net/30bc6c4f/uploads/origins/7b777f5f-a830-4248-b8e1-e445986b6ef3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c80ac0ef8baaecb8770c93cd3ab2900e, https://si.imgix.net/30bc6c4f/uploads/origins/7b777f5f-a830-4248-b8e1-e445986b6ef3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=095d3f816ce80bd394693a775a814e1c 2x, https://si.imgix.net/30bc6c4f/uploads/origins/7b777f5f-a830-4248-b8e1-e445986b6ef3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed8783f28a4a1ff31ec2eead3ec937bb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30bc6c4f/uploads/origins/7b777f5f-a830-4248-b8e1-e445986b6ef3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58e9b0d53bde99e1acae9689ae29fd1e", "srcset": "https://si.imgix.net/30bc6c4f/uploads/origins/7b777f5f-a830-4248-b8e1-e445986b6ef3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58e9b0d53bde99e1acae9689ae29fd1e, https://si.imgix.net/30bc6c4f/uploads/origins/7b777f5f-a830-4248-b8e1-e445986b6ef3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=86bb3199b5f0211ac8ff4e0c59cfa636 2x, https://si.imgix.net/30bc6c4f/uploads/origins/7b777f5f-a830-4248-b8e1-e445986b6ef3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b1c51074b9c9cf40dd2c07b9641572e6 3x"}, "body": "巣鴨様はじめまして、いつもXにてイラストを拝見させていただいています！\n巣鴨様の絵柄と色使いがとても大好きで、リクエストしたいと思いメッセージ失礼します。\n\n【依頼内容】\nTRPGの探索者をお願いしたく思います。\n﻿(※ネタバレは含みません)\n構図はキャラクター設定のイメージから好きに描いていただければと思いますが、基本的に仄暗い雰囲気が似合います。\n\n\n以下キャラクター設定になります\n\n▼設定等\n出身シナリオ：ホテルアンデルセンへようこそ - HO1 オーナー\n名前：Loa Sodeo Andersen（ロア・ソデオ・アンデルセン）\n性別：男性\n年齢：29歳\n身長：185cm+9cmヒール\n職業：ホテルオーナー\n\n常に微笑みを浮かべているオーナー。\n身長が高くスラッとしており、筋肉とは無縁の見た目をしている。どこか妖艶な雰囲気を携えている。\n仮面をつけているのが特徴的。\n\n「ようこそ、我がホテル・アンデルセンへ」\n「私がオーナーのロア・ソデオ・アンデルセンです。どうぞよろしくお願いいたします。」\n\n\n【使用用途】\n・画像の保存\n・SNSでの使用(絵師様のお名前記載)\n・ネットプリントやグッズなどの利用(非商用)\n・他個人での利用\n\n\n【資料】\n細かい装飾、不明瞭な点等は簡略化していただいて構いません。\n後ろ髪は大体肩甲骨くらいまでの長さになります。\nドライブ：https://drive.google.com/drive/folders/10wJjs1Sm14pnh4EH45W06KffMCfko0C9?usp=sharing\n\n\n長くなってしまいましたが、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10wJjs1Sm14pnh4EH45W06KffMCfko0C9?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MoguriGegg/works/65", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 833380, "client_id": 2596518, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7aa2867/uploads/origins/1f13166f-49e1-4f2a-8aed-2b41cda6cfb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a323de03e3eeddaf7b7fa72726de7354", "srcset": "https://si.imgix.net/a7aa2867/uploads/origins/1f13166f-49e1-4f2a-8aed-2b41cda6cfb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a323de03e3eeddaf7b7fa72726de7354, https://si.imgix.net/a7aa2867/uploads/origins/1f13166f-49e1-4f2a-8aed-2b41cda6cfb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7db8ebff8e64b06565337a52a2fc6be5 2x, https://si.imgix.net/a7aa2867/uploads/origins/1f13166f-49e1-4f2a-8aed-2b41cda6cfb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea355e0dba933e335cb0ed6dcb8d0bb8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7aa2867/uploads/origins/1f13166f-49e1-4f2a-8aed-2b41cda6cfb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09f1edc4ba12ed5ae072ed3e2fc504ba", "srcset": "https://si.imgix.net/a7aa2867/uploads/origins/1f13166f-49e1-4f2a-8aed-2b41cda6cfb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09f1edc4ba12ed5ae072ed3e2fc504ba, https://si.imgix.net/a7aa2867/uploads/origins/1f13166f-49e1-4f2a-8aed-2b41cda6cfb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cdcc5dba606c4d3f56099194776cb6f2 2x, https://si.imgix.net/a7aa2867/uploads/origins/1f13166f-49e1-4f2a-8aed-2b41cda6cfb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5e241f367178a7922c687afa02e4faa6 3x"}, "body": "モバゲ〜様、初めまして。\n\n7月にホテルアンデルセンを通過させていただき、未だに思いを馳せています。\n最高のスチルをありがとうございます…！モバゲ〜様の描かれるイラスト、大好きです。\nそこで、モバゲ〜様の描かれるイラストの自探索者を見たいと思い依頼させていただきました。ご縁がありましたらどうぞよろしくお願い致します！\n\n\n▼下記依頼内容\nホテルアンデルセンHO1とNPCであるハオン=ドルとの2人のイラストをお願いしたく思います。私のHO1は最後の局面にてハオン=ドルの手を取るか否かで手を取り、植物化をしてロストしました。なので、HO1に植物が巻きついているようなそんなイラストをお願いしたく存じます。構図等はおまかせしたいと思いますので、モバゲ〜様の解釈で描いていただけると幸いです！\n\n\n▼キャラクター詳細\nHO1：オーナー\n名前：Loa Sodeo Andersen(ロア・ソデオ・アンデルセン)\n身長：185cm(+9cmヒール)\n年齢：29歳\n常に微笑みを浮かべており、身長が高くスラッとしたオーナー。片目部分がひび割れてしまっているため、仮面で隠している。\nハオン=ドルのことを絶対的な存在であると思っている。\n時々様子を見に来るハオン=ドルにだけ素直な自分の姿を見せており、ハオン=ドルのことはハオン様と呼んで慕っている。\n\n普段の一人称が私なのに対して、ハオン=ドルの前では僕になるようなそんなHO1です。\n\n\n\n長々と書いてしまいましたが、自由に解釈していただいて構いません！\n\n探索者の資料は以下のリンクになります。\n仮面と帽子をつけているのがデフォルトですが、お好きに着脱していただいで構いません。\nまた、細かい装飾、不明瞭な点等は簡略化していただいて構いません。\n\n▼探索者の見た目(ドライブ)\nhttps://drive.google.com/drive/folders/1ZFEtpL7KZ8HGgveEJCOSz2dAb_hl0V4H?usp=drive_link\n\n\nご検討の程よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1ZFEtpL7KZ8HGgveEJCOSz2dAb_hl0V4H?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rarirureroppai/works/95", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 832718, "client_id": 2596518, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/02bd3b08/uploads/origins/ad8ede29-20e7-4187-a4fd-d22d80d7d9aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe51fc63c3dd91f9c066061f486c263f", "srcset":