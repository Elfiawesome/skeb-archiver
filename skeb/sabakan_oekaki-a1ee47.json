it=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d45fc3f05ea98174b6e7c3502d9eb3f4, https://si.imgix.net/007629f1/uploads/origins/5db80c4c-5606-4cdd-b877-6d12708b2ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f0c628e68e8f617dd5bc17e458f17c4 2x, https://si.imgix.net/007629f1/uploads/origins/5db80c4c-5606-4cdd-b877-6d12708b2ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e81a15be1bb853f8d94ba8c27b902946 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1047196, "client_id": 73101, "nc": 33}, {"path": "/@sabakan_oekaki/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1047196, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd09a2aa/uploads/origins/3129ea0f-bcca-433c-aca7-1988a735d81c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0047deb9df6c97fb93225321a92eb386", "srcset": "https://si.imgix.net/dd09a2aa/uploads/origins/3129ea0f-bcca-433c-aca7-1988a735d81c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0047deb9df6c97fb93225321a92eb386, https://si.imgix.net/dd09a2aa/uploads/origins/3129ea0f-bcca-433c-aca7-1988a735d81c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c884be8ab34c0d9218d9db0756139c6c 2x, https://si.imgix.net/dd09a2aa/uploads/origins/3129ea0f-bcca-433c-aca7-1988a735d81c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c15ff258ca4d5cf0d2152d66f7f173ce 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd09a2aa/uploads/origins/3129ea0f-bcca-433c-aca7-1988a735d81c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d37381301da6a271071b1311c266f08", "srcset": "https://si.imgix.net/dd09a2aa/uploads/origins/3129ea0f-bcca-433c-aca7-1988a735d81c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d37381301da6a271071b1311c266f08, https://si.imgix.net/dd09a2aa/uploads/origins/3129ea0f-bcca-433c-aca7-1988a735d81c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f15d108dbf9e2bbabfbae4c8a5346a74 2x, https://si.imgix.net/dd09a2aa/uploads/origins/3129ea0f-bcca-433c-aca7-1988a735d81c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=17d012c40b017ca7b6014075a7012f5b 3x"}, "body": "先程は大変素晴らしい馬チンポの作品をありがとうございました。\n\nあまりにツボってしまった為に、もう一件馬チンポの作品をお願い致します。\n\nキャラはアズールレーンのニュージャージーとクロンシュタットで、参考画像は前回同様下記にサンプルを用意致しましたので、ご確認をお願い致します。\n二人共肩に掛ける形で上着を羽織っておりますが、描写コストが上がると思われるので省いて頂いて構いません。\n\n構図は前回と似た様な感じに、着衣でにお互い斜めか横に座りつつシコシコと手コキをしている物、今回は二人共M字開脚をしている状態でお願い致します。\n\nチンポも前回同様馬チンポで特大サイズの血管がボコボコに浮き上がっている物、射精前後とチンカスのありなしもお願い致します。\nまた、謎のこだわりですが戦艦である為長さをもう少し長く、太さをもう少し太く、金玉をもう少し小さく。包皮の部分を前回の6割くらいに減らす(前回の半分より少し多い程度。＝前回よりムケてる部分が長くなる)\n色も前回と同様、包皮の部分はキャラの肌色に合った感じの色合いでムケた部分は生々しい色合いでお願い致します。\n精液も前回同様薄っすら黄ばんでいるくらいに特濃な物を大量に射精させてあげてください。\n今回は両キャラ共タイツ？ストッキング？の為、勃起したチンポでストッキングがテントの様な状態になっている物とチンポの部分だけストッキングなしの差分もお願い致します。\n\nサンプル\nhttps://imgur.com/a/zAiie7r\n左の謎レオタードの様な娘がニュージャージーで右の肩周りにでっかいファー巻いてるのがクロンシュタットです\nパンストでテント張ってるサンプルはスケスケパンツでテントになっている物の様な感じでお願い致します。\n\n\n前回よりも更に悪化した性癖での依頼ですが、どうぞよろしくお願い致します。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sabakan_oekaki/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1047196, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7cb13d8/uploads/origins/91fe5be8-a725-4ba3-8713-adc129b4bb96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc233f1e1d2f50a7691ae61a202a3623", "srcset": "https://si.imgix.net/d7cb13d8/uploads/origins/91fe5be8-a725-4ba3-8713-adc129b4bb96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc233f1e1d2f50a7691ae61a202a3623, https://si.imgix.net/d7cb13d8/uploads/origins/91fe5be8-a725-4ba3-8713-adc129b4bb96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=678f3f26a6f9c306048cce736c73fc88 2x, https://si.imgix.net/d7cb13d8/uploads/origins/91fe5be8-a725-4ba3-8713-adc129b4bb96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75d019ac533ccab93788af2fd61215d8 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7cb13d8/uploads/origins/91fe5be8-a725-4ba3-8713-adc129b4bb96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=749c9acd786f99931542f9cf6a38ad2f", "srcset": "https://si.imgix.net/d7cb13d8/uploads/origins/91fe5be8-a725-4ba3-8713-adc129b4bb96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=749c9acd786f99931542f9cf6a38ad2f, https://si.imgix.net/d7cb13d8/uploads/origins/91fe5be8-a725-4ba3-8713-adc129b4bb96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e4ed718d857bd804a845dccfe7684310 2x, https://si.imgix.net/d7cb13d8/uploads/origins/91fe5be8-a725-4ba3-8713-adc129b4bb96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c08c37c43f52eeaac27b5c4e42e66d43 3x"}, "body": "初めまして、Twitterで素晴らしいチンポを描いているのを拝見して依頼させて頂きたく思いました。\n\nプリンセスコネクトRediveのペコリーヌとサレンを描いて頂けませんでしょうか。\nキャラの参考画像、構図、チンポの形状等のサンプルを後述のリンク先に用意致しましたので、ご確認お願い致します。\n\nペコリーヌは通常コス、サレンはプリンセスフォームで。\n構図は着衣でお互いに何かに斜めに腰掛けているような状況で、お互いのチンポを扱き合っている物と差分で射精している物。\nチンポは馬のチンポで特大サイズの血管がバキバキに走っている物、チンカスありとなしの差分を。\n色のサンプルも一緒に記載してありますので、参考にして下さい。\n精液は薄っすら黄ばんでいるくらいの特濃な物を大量射精させて下さい。\n納品時はpsdかclip形式でお願い致します。\n\n参考画像リンク先\nキャラ\nhttps://imgur.com/a/CALGCRw\n構図、チンポ等\nhttps://imgur.com/a/LBUp721\n\nかなり尖った性癖の依頼ですが、どうぞよろしくお願い致します。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sabakan_oekaki/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1047196, "client_id": 556384, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12eaaa26/uploads/origins/63446345-367a-4c2f-93f2-298d6d01558c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b5478a935750eb8192341ae54fefa34", "srcset": "https://si.imgix.net/12eaaa26/uploads/origins/63446345-367a-4c2f-93f2-298d6d01558c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b5478a935750eb8192341ae54fefa34, https://si.imgix.net/12eaaa26/uploads/origins/63446345-367a-4c2f-93f2-298d6d01558c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=010bc141518a1386dfd39fa45d518559 2x, https://si.imgix.net/12eaaa26/uploads/origins/63446345-367a-4c2f-93f2-298d6d01558c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f27891b837607cb3e06317082c7202e3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12eaaa26/uploads/origins/63446345-367a-4c2f-93f2-298d6d01558c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=651b29b02db17bb6254cdaa0253cee17", "srcset": "https://si.imgix.net/12eaaa26/uploads/origins/63446345-367a-4c2f-93f2-298d6d01558c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=651b29b02db17bb6254cdaa0253cee17, https://si.imgix.net/12eaaa26/uploads/origins/63446345-367a-4c2f-93f2-298d6d01558c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=262a8ddfb07e74ade7b568d625a60180 2x, https://si.imgix.net/12eaaa26/uploads/origins/63446345-367a-4c2f-93f2-298d6d01558c?bg=%23fff&auto=format