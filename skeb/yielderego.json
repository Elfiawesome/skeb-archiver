Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3be3ddddc81e1924780de9b8112b6c52", "srcset": "https://si.imgix.net/a5fe2d60/uploads/origins/e672be9e-c29d-4091-8cfc-90d8f73db4d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3be3ddddc81e1924780de9b8112b6c52, https://si.imgix.net/a5fe2d60/uploads/origins/e672be9e-c29d-4091-8cfc-90d8f73db4d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d6fddab277924d9f8c91f1d6d7aaeb1 2x, https://si.imgix.net/a5fe2d60/uploads/origins/e672be9e-c29d-4091-8cfc-90d8f73db4d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e62eb2c3078c7b54d3148df832934d1e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5fe2d60/uploads/origins/e672be9e-c29d-4091-8cfc-90d8f73db4d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14fdffa8cbb41d4008dd97d5a7c00bcf", "srcset": "https://si.imgix.net/a5fe2d60/uploads/origins/e672be9e-c29d-4091-8cfc-90d8f73db4d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14fdffa8cbb41d4008dd97d5a7c00bcf, https://si.imgix.net/a5fe2d60/uploads/origins/e672be9e-c29d-4091-8cfc-90d8f73db4d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f476ab0eb30a42d5659d320ecc0d44c 2x, https://si.imgix.net/a5fe2d60/uploads/origins/e672be9e-c29d-4091-8cfc-90d8f73db4d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b2fdc7195900b2795ec3df552e181c6c 3x"}, "body": "鈴原るるちゃんの切り抜き動画のサムネイルに使うイラストをお願いしたいです。\n\n切り抜き動画の内容はフロムゲーなどで、\n鈴原るると犬が戯れるクリップ集となります。\n\n\nお願いしたいイラストは一般的なサムネサイズ（横1920x縦1080ピクセル）で、\n鈴原るるが犬に噛みつかれていたり、犬に囲まれて翻弄されている感じを考えています。\nただし、流血は絶対に表現しないでください。過度な暴力もNGです。\n\n具体的には鈴原るるの服の裾や袖口、靴紐などを犬が噛んでいて遊ぶように引っ張っていたり、\nほかの犬が鈴原るるの帽子を咥えて画面端に持っていってるようなイメージです。\n遠くから走ってきている犬も何匹かいれば嬉しいです。\n\n\n鈴原るるの表情はお任せしますが、「なんてこったい」って言ってる感じで、\nすこし泣き目だったり、困り顔でも良いかもしれません。\nそのときの姿勢や体勢なども基本的にお任せしますが、\n複数の犬に翻弄されてる感じを表現できればと思います。\n\nまた犬のデザインはゾンビ犬ではなく普通の犬で大丈夫です。犬種や色もお任せします。\n『犬は一緒に遊べる相手ができて噛みついたり嬉しい気持ちなんだけど、\n鈴原るるはそんな犬たちに囲まれて困ってる、あるいは途方に暮れてる、あるいは慌ててる』\nというような犬と鈴原るるの感情の対比が伝わるようなイラストをお願いしたいです。\nイラストの背景はあってもなくても構いませんが、ある場合はレイヤー分けしたPSDで頂ければありがたいです。\n\n\n動画は5月中頃までに完成予定となります。\n\n\nそれと、モンスターハンターすずはライズ！のイラストかっこよくて好きです。\nご検討よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1187552, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🐟2bosi", "screen_name": "2bosi2", "avatar_url": "https://pbs.twimg.com/profile_images/1891123327886106624/xj3TFsNy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1301319560998432768/1735873414/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 161}, {"id": 1683535, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "千慧", "screen_name": "Chisato_Charme", "avatar_url": "https://pbs.twimg.com/profile_images/1522199378886242304/OsHXhhUg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1020979498932625408/1657510771/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 144}, {"id": 2203024, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "天月 閃光@通販開始", "screen_name": "FlashVangerd", "avatar_url": "https://pbs.twimg.com/profile_images/1713250755707383809/xX0US-07.jpg", "header_url": "https://pbs.twimg.com/profile_banners/894739034/1771730016/1500x500", "appeal_receivable": false, "po