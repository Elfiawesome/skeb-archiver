の解釈で自由に描いていただけましたら嬉しいです！\n\n■使用用途\n・個人観賞\n・グッズ作成\n・自陣PL間での画像共有\n・SNSへの掲載、アイコン・ヘッダー等への使用\n\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/16aMJOo3SgUjMIPrQ48GOkmuiGqHCiJwV?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@p09_si2/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4077172, "client_id": 2545020, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4de02d19/uploads/origins/6dc7992e-2372-4424-926d-bef4973b2334?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7f8586bb46afca2ed23a89717f9d710", "srcset": "https://si.imgix.net/4de02d19/uploads/origins/6dc7992e-2372-4424-926d-bef4973b2334?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7f8586bb46afca2ed23a89717f9d710, https://si.imgix.net/4de02d19/uploads/origins/6dc7992e-2372-4424-926d-bef4973b2334?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a781bbb057881644708e2be3cbd6d81 2x, https://si.imgix.net/4de02d19/uploads/origins/6dc7992e-2372-4424-926d-bef4973b2334?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb6e44f4cce1d20839b7c9f7e5416fe8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4de02d19/uploads/origins/6dc7992e-2372-4424-926d-bef4973b2334?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7ed1c9fdcd2c67f154578b9b003659c", "srcset": "https://si.imgix.net/4de02d19/uploads/origins/6dc7992e-2372-4424-926d-bef4973b2334?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7ed1c9fdcd2c67f154578b9b003659c, https://si.imgix.net/4de02d19/uploads/origins/6dc7992e-2372-4424-926d-bef4973b2334?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0853aaf8ac3918dfab34bd0b3124