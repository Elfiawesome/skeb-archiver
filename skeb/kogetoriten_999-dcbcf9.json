男だが、どこか不気味なオーラを持っている。普段は穏やかで無表情。下向きのまつげ、顔のほくろ、ひび割れた唇にご注目！特にウォンオクは呪いによって不運に見舞われているため、彼の周りで事件が頻発する。ポーズや構図はお任せしますが、参考のためにフォルダを用意しました！^^\n\n参考：https://drive.google.com/drive/folders/1Ykz3wDGWzT6V5nGkBaOCEAXb062NYZpl?usp=sharing\n\nいつもお忙しい中、本当にありがとうございます💕💕 今日も素敵な1日をお過ごしください\n\nhttps://drive.google.com/drive/folders/1lbohFg_kQ86bwaE7sF7WqXcnfepFzYYv?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kogetoriten_999/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3073159, "client_id": 1622498, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/302401e8/uploads/origins/ad4b6ce3-8b32-4902-af87-ee6167707d33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b796664c0c6a4457d445783ea10885b4", "srcset": "https://si.imgix.net/302401e8/uploads/origins/ad4b6ce3-8b32-4902-af87-ee6167707d33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b796664c0c6a4457d445783ea10885b4, https://si.imgix.net/302401e8/uploads/origins/ad4b6ce3-8b32-4902-af87-ee6167707d33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c6e8a6331625e8d83629ea656583685 2x, https://si.imgix.net/302401e8/uploads/origins/ad4b6ce3-8b32-4902-af87-ee6167707d33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0753ae6d92e6dbf93f565238a85256bf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/302401e8/uploads/origins/ad4b6ce3-8b32-4902-af87-ee6167707d33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1552e6c64203f65f3e10f93412f3051", "srcset": "https://si.imgix.net/302401e8/uploads/origins/ad4b6ce3-8b32-4902-af87-ee6167707d33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1552e6c64203f65f3e10f93412f3051, https://si.imgix.net/302401e8/up