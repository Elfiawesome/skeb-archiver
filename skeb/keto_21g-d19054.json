 color pallet similar to the photo you drew provided, if that’s alright!\n\nHer motifs are: jellyfish, bubbles, and lily of the valley flower.\nIf you could include any of these motifs in the illustration, I would be so happy!\n\nThank you so much for your consideration!\n\nhttps://drive.google.com/drive/folders/1oyX-90ctaq90dVIdV2wUnIVwP5RgxotY", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@keto_21g/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1266969, "client_id": 1103855, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3194ca57/uploads/origins/16664d97-b724-4925-83e6-6a8d5369c2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=751e11dfc9b35b4d80db39c5f462eb43", "srcset": "https://si.imgix.net/3194ca57/uploads/origins/16664d97-b724-4925-83e6-6a8d5369c2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=751e11dfc9b35b4d80db39c5f462eb43, https://si.imgix.net/3194ca57/uploads/origins/16664d97-b724-4925-83e6-6a8d5369c2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f6cbcf3aae00f8fc3494b1c995fe9c6 2x, https://si.imgix.net/3194ca57/uploads/origins/16664d97-b724-4925-83e6-6a8d5369c2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fc09060cd7d459a6940a705b7a0cdb0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3194ca57/uploads/origins/16664d97-b724-4925-83e6-6a8d5369c2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ca1f47e50aca58372e5f57ed72f9c67", "srcset": "https://si.imgix.net/3194ca57/uploads/origins/16664d97-b724-4925-83e6-6a8d5369c2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ca1f47e50aca58372e5f57ed72f9c67, https://si.imgix.net/3194ca57/uploads/origins/16664d97-b724-4925-83e6-6a8d5369c2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eeea9d9b2d110f7ffbd19b0d1fe05bea 2x, https://si.imgix.net/3194ca57/uploads/origins/16664d97-b724-4925-83e6-6a8d5369c2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dcf1958a5f9cb2f2f44b5f0a87431572 3x"}, "body": "Good Afternoon, my name is Mikan and I am a mink girl who loves to sail!\n\nI have been following your art on twitter for quite some time. Your illustrations are so beautiful and whimsical!\n\nPlease draw my character in any way you’d like.\n\nIf you could include an oceanic theme or blue fish somewhere, I would be delighted.\n\nThank you for your time!\n\nhttps://drive.google.com/drive/folders/1Cfl255IfC2B5AQ9gXasvyoZpMcS8pUB8", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@keto_21g/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1266969, "client_id": 3302680, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b4b17b2/uploads/origins/abe62e32-4374-4f15-8f7a-2601d7ea4526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0949c4513ab50287f261314db0eb3bb8", "srcset": "https://si.imgix.net/2b4b17b2/uploads/origins/abe62e32-4374-4f15-8f7a-2601d7ea4526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0949c4513ab50287f261314db0eb3bb8, https://si.imgix.net/2b4b17b2/uploads/origins/abe62e32-4374-4f15-8f7a-2601d7ea4526?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f120f671f4e17f55272ea2fbe63c8fdd 2x, https://si.imgix.net/2b4b17b2/uploads/origins/abe62e32-4374-4f15-8f7a-2601d7ea4526?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0dc0601cc187228e6a318c8bab06892 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src"