前半くらいの包容力のある聖母的な美女、と考えております。\nなお、サンダル履きとして頂き、足の指が見えるようなデザインだと嬉しいです。\n\n以下、資料になります。\nお手数をおかけいたしますが、ご検討の程よろしくお願いいたします。\n\n・王妃マイリア（裏面）\nhttps://img.mandarake.co.jp/webshopimg/03/00/028/0300590028/03005900283.jpg\n・アイララ姫\nhttps://img.aucfree.com/j586165339.1.jpg\n\nhttps://img.mandarake.co.jp/webshopimg/03/00/028/0300590028/03005900282.jpg", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hamu_mu0/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2320864, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2681da10/uploads/origins/6c44ff2a-5442-401c-a929-e9d207d8c3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2e6e9f15f853f95f85ea792741fb272", "srcset": "https://si.imgix.net/2681da10/uploads/origins/6c44ff2a-5442-401c-a929-e9d207d8c3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2e6e9f15f853f95f85ea792741fb272, https://si.imgix.net/2681da10/uploads/origins/6c44ff2a-5442-401c-a929-e9d207d8c3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87a368cf55f828c5526905de42a6f8fa 2x, https://si.imgix.net/2681da10/uploads/origins/6c44ff2a-5442-401c-a929-e9d207d8c3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e1b9ef42db096bb34bc8abed2511ef1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2681da10/uploads/origins/6c44ff2a-5442-401c-a929-e9d207d8c3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34e37cd3a26c6134ba973382cad30d62", "srcset": "https://si.imgix.net/2681da10/uploads/origins/6c44ff2a-5442-401c-a929-e9d207d8c3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34e37cd3a26c6134ba973382cad30d62, https://si.imgix.net/2681da10/uploads/origins/6c44ff2a-5442-401c-a929-e9d207d8c3