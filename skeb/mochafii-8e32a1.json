lse, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92caee50/uploads/origins/f266ab94-d6a2-4e20-ac08-5c60c40b2a00?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=7443d053d8e6ab03ee2ac96f44a12057", "srcset": "https://si.imgix.net/92caee50/uploads/origins/f266ab94-d6a2-4e20-ac08-5c60c40b2a00?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=7443d053d8e6ab03ee2ac96f44a12057, https://si.imgix.net/92caee50/uploads/origins/f266ab94-d6a2-4e20-ac08-5c60c40b2a00?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e15fc0b1b40df062c2c95749f7145cdc 2x, https://si.imgix.net/92caee50/uploads/origins/f266ab94-d6a2-4e20-ac08-5c60c40b2a00?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=17673f23b07776925dc2ecfb4c7a142c 3x"}, "body": "はじめまして。もかふぃーと申します。\nぷにぷにアバターで使用するうちのこ2を描いていただきたくリクエストを送らせていただきました。\n\n○使用用途について\nVRC内でぷにぷにアバターとしての使用、SNSでの個人使用\n\n○キャラクターについて\n基本は資料内の立ち絵を参考に描いていただけると助かります。白シャツに黒パーカーで大丈夫です。\n基本クールで、よくポッキーを咥えているクトゥルフ神話TRPGで使っている子です。\n\n問題がなければご検討のほどよろしくお願いします……！\n\nhttps://drive.google.com/drive/folders/1uy2lE8lIljhucmxyQ01I1naqSJN7FUfK?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@soreyueny/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3527283, "client_id": 2765192, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40f3533d/uploads/origins/7b20d19c-0944-4565-8b27-b1c43c028151?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4f7e8ea622db45da1565ba9358922d5", "srcset": "https://si.imgix.net/40f3533d/uploads/origins/7b20d19c-0944-4565-8b27-b1c43c028151?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4f7e8ea622db45da1565ba9358922d5, https://si.imgix.net/40f3533d/uploads/origins/7b20d19c-0944-4565-8b27-b1c43c028151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97d96f6dba120246b4a52d377d6698f2 2x, https://si.imgix.net/40f3533d/uploads/origins/7b20d19c-0944-4565-8b27-b1c43c028151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f724481c80542bbbaf6d0e2f2a9753c4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40f3533d/uploads/origins/7b20d19c-0944-4565-8b27-b1c43c028151?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d31228d360cd42ede61396f3a6ba75c", "srcset": "https://si.imgix.net/40f3533d/uploads/origins/7b20d19c-0944-4565-8b27-b1c43c028151?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d31228d360cd42ede61396f3a6ba75c, https://si.imgix.net/40f3533d/uploads/origins/7b20d19c-0944-4565-8b27-b1c43c028151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07e3e2903755ff57d3a65912f5696f76 2x, https://si.imgix.net/40f3533d/uploads/origins/7b20d19c-0944-4565-8b27-b1c43c028151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=65388bbd7dcc06545b6c0ffc8e0c364f 3x"}, "body": "それゆえ様、こんばんは。もかふぃーと申します。\n以前別アカウントの方にリクエストさせていただいたOC2人のSDイラストを描いていただきたく、リクエストを送らせていただきました。\n\n帯刀してる子:\n戦闘シーンで使用したいため、抜刀状態のSDイラストを描いていただきたいです。\n「猟犬」という忍法を使用する子です。恐らくCoCのティンダロスの猟犬モチーフの忍法で「時空間の狭間を抜けて攻撃できる」といったフレーバーが書かれているのですが、もし可能でしたらそれっぽい要素があればとても嬉しいです。\nですが「猟犬」に関しては情報も少なく無茶なお願いですので無視して頂いても問題ありません。\n\nトランクの子:\n可愛くSDイラストを描いていただければ……可能でしたら微笑した表情だと助かります。\n\n使用用途:\n各種SNSのアイコン、個人観賞用グッズへの使用、TRPGでの使用\n\n両キャラに友好関係はないため、それぞれ別で描いてほしいです。\n問題がなければご検討していただけますと幸いです。何卒よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1cWtmCpv4Mo1_RVu3yN8NR2KLnRYiKqyh?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Zr6Ov/works/147", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false,