ッションを受け付けてくださるようになって、本当に嬉しいです💜 私のオリジナルキャラクター「リン」を描いていただけないでしょうか。\n\n- 年齢：18歳\n- 性格：内気、優しい、無邪気で子供っぽい\n- 好きなもの：甘いもの、紫やパステルカラー、寝ること、可愛いもの、ぬいぐるみ、ファッション\n- デザインメモ：小柄で胸は小さい、紫色の瞳、黒くウェーブのかかった髪\n\nポーズや表情はお好きなように描いてください。よろしくお願いします！！ ✨\n\nhttps://www.deviantart.com/stash/210h50uvevkj", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koge_masaki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3958220, "client_id": 893479, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48889cfa/uploads/origins/720a7c99-58f9-4e41-a30e-e0c99765994d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e6ffe42d22b51199630976fb7ed0ffe", "srcset": "https://si.imgix.net/48889cfa/uploads/origins/720a7c99-58f9-4e41-a30e-e0c99765994d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e6ffe42d22b51199630976fb7ed0ffe, https://si.imgix.net/48889cfa/uploads/origins/720a7c99-58f9-4e41-a30e-e0c99765994d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34d0d7e9d10aaeb86e8e6a9063c2baf1 2x, https://si.imgix.net/48889cfa/uploads/origins/720a7c99-58f9-4e41-a30e-e0c99765994d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f688791bccee304222cbe7c44cbce602 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48889cfa/uploads/origins/720a7c99-58f9-4e41-a30e-e0c99765994d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a42e59a5cbb2bf29ba3b92334547391", "srcset": "https://si.imgix.net/48889cfa/uploads/origins/720a7c99-58f9-4e41-a30e-e0c99765994d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a42e59a5cbb2bf29ba3b92334547391, https://si.imgix.net/48889cfa/uploads/origins/720a7c99-58f9-4e41-a30e-e0c99765994d?bg=%23fff&auto=format%2Ccompress&fm=we