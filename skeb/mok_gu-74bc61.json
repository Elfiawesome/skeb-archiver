ンデレではない\n\n資料に三面図がありますのでご確認ください。\n\nこの子の魔法少女姿、もしくは制服を着た姿をお願いしたいと考えております。\n\n使用目的はSNS用のアイコン、個人用端末（スマホPC等）の壁紙、他イラストレーター様への作画資料としての一時的な提供であり、商業目的の使用はいたしません。\n\n全体的に装飾が細かくなっておりますので、先生のさじ加減で省略したりアレンジを加えていただいて構いません。\n\nどのような作品になるか楽しみにしております。\nご検討の程よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1E_aoif0cfWWqCvsqfXBF-__EH8fW2dUD", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mok_gu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4141865, "client_id": 655268, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce444bce/uploads/origins/ebf44f8f-760d-451c-91a8-9035832bf883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54859b002b52d8c388b25d38d56454e0", "srcset": "https://si.imgix.net/ce444bce/uploads/origins/ebf44f8f-760d-451c-91a8-9035832bf883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54859b002b52d8c388b25d38d56454e0, https://si.imgix.net/ce444bce/uploads/origins/ebf44f8f-760d-451c-91a8-9035832bf883?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e819f569f7399a5e470b5b7a8d80efc5 2x, https://si.imgix.net/ce444bce/uploads/origins/ebf44f8f-760d-451c-91a8-9035832bf883?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c97e5b5315d5f2e3cc935f5967f627e7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce444bce/uploads/origins/ebf44f8f-760d-451c-91a8-9035832bf883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45da7af2da0d4c658c2c7af1f34196ff", "srcset": "https://si.imgix.net/ce444bce/uploads/origins/ebf44f8f-760d-451c-91a8-9035832bf883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45da7af2da0d4c658c2c7af1f34196ff, https://si.imgix.net/ce444bce/uploads/origins/ebf44f8f-760d-451c-9