したらご活用ください\n光の面と闇の面、どちらを選ぶかはお任せします\n\n長文失礼しました\nよろしくお願いします\n\nhttps://www.dropbox.com/scl/fi/jc9dzc2mpb0hn6oosinxf/neito.zip?rlkey=sts4xma2hvjq3uotwoov0e515&st=j4it47yc&dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karinoya2/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3642195, "client_id": 1224663, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/00e788c1/uploads/origins/d1964d2a-3019-4b4d-8b82-ee34589265a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4582f4eca0f255de50e25c2e72dd60dd", "srcset": "https://si.imgix.net/00e788c1/uploads/origins/d1964d2a-3019-4b4d-8b82-ee34589265a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4582f4eca0f255de50e25c2e72dd60dd, https://si.imgix.net/00e788c1/uploads/origins/d1964d2a-3019-4b4d-8b82-ee34589265a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3fd1f208d525c66d62aa78af2e7c5bd7 2x, https://si.imgix.net/00e788c1/uploads/origins/d1964d2a-3019-4b4d-8b82-ee34589265a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb2208309474dd10b8201f9e96593793 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00e788c1/uploads/origins/d1964d2a-3019-4b4d-8b82-ee34589265a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24936bcfb6c9549decdbba0bd9c2999f", "srcset": "https://si.imgix.net/00e788c1/uploads/origins/d1964d2a-3019-4b4d-8b82-ee34589265a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24936bcfb6c9549decdbba0bd9c2999f, https://si.imgix.net/00e788c1/uploads/origins/d1964d2a-3019-4b4d-8b82-ee34589265a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6be4625c151ebcbda239b88df962869e 2x, https://si.img