ds/origins/b7db5b89-8056-41b4-b886-50263a610186?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e7ecdcd77b8696012b95f282a761385 2x, https://si.imgix.net/73f1792c/uploads/origins/b7db5b89-8056-41b4-b886-50263a610186?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad07d56314f740ff70dd5b67e1409f07 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73f1792c/uploads/origins/b7db5b89-8056-41b4-b886-50263a610186?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ac89c8a35a228e12361e3f51d6aa3c9", "srcset": "https://si.imgix.net/73f1792c/uploads/origins/b7db5b89-8056-41b4-b886-50263a610186?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ac89c8a35a228e12361e3f51d6aa3c9, https://si.imgix.net/73f1792c/uploads/origins/b7db5b89-8056-41b4-b886-50263a610186?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f33f30ac95a9aa2f0ae761d3da9f9040 2x, https://si.imgix.net/73f1792c/uploads/origins/b7db5b89-8056-41b4-b886-50263a610186?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df75892bbcfbc5800cec1fd1cbb1cdf9 3x"}, "body": "いつもお世話になっております、たわしです。\nskebをはじめたと伺いリクエストを送らせていただきました。リクエストを送るのは初めてですので不手際がありましたら申し訳ございません。\n\n私の代理キャラ兼配信姿の束田(たわた)を描いていただきたいです。\n\nhttps://drive.google.com/drive/folders/1-Cu5rbZpwfymmsY1h-Wzpi5e-ayDGfmW\n\n・身長:155cm\n・衣装:天使界隈(3面図、緑のジャージの方です)\n・使用用途:個人鑑賞、ファンアートとしてSNSに掲載\n構図や背景などは全てお任せいたします。\n\nご検討くださると幸いです。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-Cu5rbZpwfymmsY1h-Wzpi5e-ayDGfmW", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Deathblood2/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3019932, "client_id": 2959577, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5117c6c3/uploads/origins/cfc8cdf2-e713-4f97-bdfb-ef712e7cf8a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d858c163e880e1a2d5719b0e5bb9e555", "srcset": "https://si.imgix.net/5117c6c3/uploads/origins/cfc8cdf2-e713-4f97-bdfb-ef712e7cf8a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d858c163e880e1a2d5719b0e5bb9e555, https://si.imgix.net/5117c6c3/uploads/origins/cfc8cdf2-e713-4f97-bdfb-ef712e7cf8a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43e30651cfe2757ba740d0fc8e70b494 2x, https://si.imgix.net/5117c6c3/uploads/origins/cfc8cdf2-e713-4f97-bdfb-ef712e7cf8a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17dec34896f03ebd1de74e24b5f305a6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5117c6c3/uploads/origins/cfc8cdf2-e713-4f97-bdfb-ef712e7cf8a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=446c76f835af31e0868cf24061b0a092", "srcset": "https://si.imgix.net/5117c6c3/uploads/origins/cfc8cdf2-e713-4f97-bdfb-ef712e7cf8a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=446c76f835af31e0868cf24061b0a092, https://si.imgix.net/5117c6c3/uploads/origins/cfc8cdf2-e713-4f97-bdfb-ef712e7cf8a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e98d803f19212aa66f5fcde6dbd82a1 2x, https://si.imgix.net/5117c6c3/uploads/origins/cfc8cdf2-e713-4f97-bdfb-ef712e7cf8a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=db2aed76055caf9d6891c9ec1a376b11 3x"}, "body": "こんにちは！\nvtuberの悠木ちはやと申します！ \n今回、Skebを始められたとの通知を受け取りましたので急いで依頼しに来ました。\n\n死神さん様の描かれるイラストの繊細なのに艶やかな質感、肌塗の妖艶さ。瞳の美しさなどに非常に惹かれ、是非依頼したいと思い、今回お願いさせていただきます。\n\n特に以下の作品が好きです。\nhttps://twitter.com/Deathblood2/status/1658060348665237505 の肩\nhttps://twitter.com/Deathblood2/status/1706645486026019144 の腰回り\nが非常に癖です。\n直近のサキュバスちゃんも非常に素敵でした。お腹が非常に感じるものがありました。\n\n■使用用途\nTwitterなどのSNSの広報活動\nTwitchやyoutubeなどの動画プラットフォーム上での使用\n\n■キャラクター設定\n洋館に勤める和装メイド。武器（ハンマー）を持っており、有事の際には戦闘を行う。\n普段はメイド業に勤しみながら、ゲームをして遊んでいる。よく食べる。\n\n■イラスト概要\n今回のイラスト依頼について、下記でお願いしたく思います。細部はお任せいたします\n　・膝立ちでひざ下を外側に開いている（女の子座りから膝立した感じ）\n　・前かがみで腰を反っており、片腕を伸ばして体重を支えている（女豹のポーズ？のような感じ）\n　・逆の腕で顔の横で猫の手でニヤーっとした煽りっぽい表情\n　・肌塗の質感が好きなので上着は脱いだ状態で、首元は多少はだけさせてください。鎖骨が見えると嬉しいです。（その他の部分もはだけても大丈夫です）\n　・迫ってきているようなカメラ感だと嬉しいです。\n\n通しのイメージとしては、勤めている洋館の一室で何故か撮影会をしておりちょっと盛り上がってきて若干過激っぽくなっちゃった感じです。キャラクターは単体で描いてください。\n\n■参考\n三面図、ビジュアルなどは下記URLからご参照ください。\nhttps://drive.google.com/drive/folders/1irDEf0XRrJyK95-9XZiVDKWfOf7Pm8Xh?usp=sharing\n\n■備考\nよろしければキャラクターとそれ以外をわけたレイヤーをご用意いただいたPSD、もしくはPNGでいただけますと嬉しいです。\n\nご縁ありましたら是非よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1irDEf0XRrJyK95-9XZiVDKWfOf7Pm8Xh?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 5374, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "いーたん＆mikokoたん", "screen_name": "mikoko1", "avatar_url": "https://pbs.twimg.com/profile_images/1610031912646750209/1qqEk7cE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/106337453/1782153819/1500x500", "appeal_receivable": false, "popular_creator_rank": 70, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 367187, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぺろっぱふ🎨", "screen_name": "Meowstic__", "avatar_url": "https://pbs.twimg.com/profile_images/1735875448226373632/LqAcfnUM.png", "header_url": null, "appeal_receivable": true, "popular_creator_rank": 83, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_