てを強調するように腰はちょっと沿っている感じでお願いします。\n　・指でガラスに♡を描いている。\n　・舌を舐めずって誘っているような悪戯っぽい表情（眉は困りでお願いいたします）\n　・裸ですが、手袋は癖なのでつけっぱなしでお願いいたします。\n\n■備考\nよろしければキャラクターとそれ以外をわけたレイヤーをご用意いただいたPSD、もしくはPNGでいただけますと嬉しいです。\n\nhttps://drive.google.com/drive/folders/1irDEf0XRrJyK95-9XZiVDKWfOf7Pm8Xh?usp=sharing", "nc": 50, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Deathblood2/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3019932, "client_id": 2869993, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/880d7cdb/uploads/origins/ada1bb4e-3171-4fd8-b153-352725d49a6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0aa7c71bd5e7f5ccbd2681605d73ef4", "srcset": "https://si.imgix.net/880d7cdb/uploads/origins/ada1bb4e-3171-4fd8-b153-352725d49a6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0aa7c71bd5e7f5ccbd2681605d73ef4, https://si.imgix.net/880d7cdb/uploads/origins/ada1bb4e-3171-4fd8-b153-352725d49a6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b95c09d4484240872e2e1f1628dbe52b 2x, https://si.imgix.net/880d7cdb/uploads/origins/ada1bb4e-3171-4fd8-b153-352725d49a6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20c973940e543ddb5dd5fff14b795128 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/880d7cdb/uploads/origins/ada1bb4e-3171-4fd8-b153-352725d49a6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d846bd2e0c5a8ecd3c92747c3372c88d", "srcset": "https://si.imgix.net/880d7cdb/uploads/origins/ada1bb4e-3171-4fd8-b153-352725d49a6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d846bd2e0c5a8ecd3c92747c3372c88d, https://si.imgix.net/880d7cdb/uploads/origins/ada1bb4e-3171-4fd8-b153-352725d49a6b?bg=%23fff&auto=format%2Ccompress