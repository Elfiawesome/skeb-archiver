wbmcmdz0xMjAw&marky=415&txt64=44KN44GP44Gf44KT44GP44KT&txtclr=fff&txtfont64=QXZlbmlyLUJsYWNr&txtfit=max&txtalign=middle%2Ccenter&txtsize=60&txtshad=10&auto=format%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=e0ce7475ed28387f611eca01dd6c9714", "skills": [{"genre": "art", "default_amount": 13000}, {"genre": "correction", "default_amount": 13000}], "payment_methods": {"credit_cards": {"jcb": {"nsfw": true}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@6roid_06/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2146658, "client_id": 219112, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3336630a/uploads/origins/9b17eb92-4b5e-4a9f-98a8-9da1aced0ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f490ef21d1b25bb116b66d21c6958ce8", "srcset": "https://si.imgix.net/3336630a/uploads/origins/9b17eb92-4b5e-4a9f-98a8-9da1aced0ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f490ef21d1b25bb116b66d21c6958ce8, https://si.imgix.net/3336630a/uploads/origins/9b17eb92-4b5e-4a9f-98a8-9da1aced0ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41cee26eb7fda87eb8ce1039c30da91b 2x, https://si.imgix.net/3336630a/uploads/origins/9b17eb92-4b5e-4a9f-98a8-9da1aced0ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7deba4a66f70a763ad667f1ae700b3e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3336630a/uploads/origins/9b17eb92-4b5e-4a9f-98a8-9da1aced0ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a573c1f513ae411c5e88f726feeff68", "srcset": "https://si.imgix.net/3336630a/uploads/origins/9b17eb92-4b5e-4a9f-98a8-9da1aced0ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a573c1f513ae411c5e88f726feeff68, https://si.imgix.net/3336630a/uploads/origins/9b17eb92-4b5e-4a9f-98a8-9da1aced0ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a866e4aa3f39ab730e560882787fadf 2x, https://si.imgix.net/3336630a/uploads/origins/9b17eb92-4b5e-4a9f-98a8-9da1aced0ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=abeb4f99da6e7215ea471f4ba6126880 3x"}, "body": "タイトル「T-100A 綾鎵詩機(あやかしき)」\n私のオリジナルキャラクター：綾鎵 詩機(あやか しき)「以下、\"詩機\"」が活躍するシーンのイラスト(カラー)をリクエストいたします。\n１枚絵(＋差分１枚)でお願いします（他の追加差分は任意）。\n\n＜構図　横長(16:9)＞\n・詩機の特徴：\n潜入／抹殺の役割を持つ液体金属で出来たOL姿のターミネーター(型番：T-100A)。武器はライフルと銃がメイン。\n黒髪ショートカット、眼鏡着用、黒スーツ／白ブラウス／黒の短いタイトスカート／黒ハイヒール（ストッキングは履いていない）\nスリーサイズはB89(Gカップ),W60,H84。見た目年齢は20歳。\n\n・１枚絵（ベース）：\n深夜の社内の廊下で、詩機が、両目が見えるくらいの前斜めに歩行しながら、ライフル片手にターゲットを狙撃している。\n全体像は頭から太ももまでが見えるくらい（パンチラは不要）。監視カメラから詩機を写している想定にしてください。\n胸は谷間が見え、白ブラウスがはち切れそうなくらい、巨乳。表情はT-X娘のように無表情かつ人間味のない感じでお願いします。\n\n・１枚絵（差分）：\n詩機が狙撃されて、T-1000のように液体金属特有の損傷を受けている差分をお願いします。\n頭部と胸に大きな抉れがそれぞれ１ヶ所。効果音も付けてもらえると嬉しいです。\n他に弾痕を３～４ヶ所ほどお願いします。\nこの時の詩機の目線は、彼女を写している監視カメラへと切り替えてください。監視カメラに向かって「次はお前だ」と言っているかのような目線で。\n\n・１枚絵（任意）：\n液体金属ではなくT-X娘のような内部構造が透過された詩機のメカバレ差分をお願いします。\n透過箇所は瞳と腕手指と胸部分。詩機がHUD風の青白いモニターでスキャン中。腕手指の内部はターミネーターのような骨組み。\n胸の内部は、胴体の金属骨格に装着された銀色の球体が２玉あり、その表面には電子回路の線が無数に蔓延っている感じでお願いします。\n\n綾鎵詩機の全容は私が投稿した以下のpixiv作品に掲載しておりますので、詳細は以下をご覧ください。\nシリーズ：https://www.pixiv.net/user/112124511/series/266393\nプロフィール：https://www.pixiv.net/artworks/125457698\n\nhttps://www.pixiv.net/user/112124511/series/266393", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@6roid_06/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2146658, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37ca2c59/uploads/origins/519664d7-c5f3-4feb-80fa-285ccd92a12b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb43270d78aeb75e460636f3dfab18a1", "srcset": "https://si.imgix.net/37ca2c59/uploads/origins/519664d7-c5f3-4feb-80fa-285ccd92a12b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb43270d78aeb75e460636f3dfab18a1, https://si.imgix.net/37ca2c59/uploads/origins/519664d7-c5f3-4feb-80fa-285ccd92a12b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71a7d5fe159d243253113e43e7b4e154 2x, https://si.imgix.net/37ca2c59/uploads/origins/519664d7-c5f3-4feb-80fa-285ccd92a12b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ff10686a67aee7989dd9acb7350cf98 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37ca2c59/uploads/origins/519664d7-c5f3-4feb-80fa-285ccd92a12b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f1e1a0b493a18eff936c26b59bea3ec", "srcset": "https://si.imgix.net/37ca2c59/uploads/origins/519664d7-c5f3-4feb-80fa-285ccd92a12b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f1e1a0b493a18eff936c26b59bea3ec, https://si.imgix.net/37ca2c59/uploads/origins/519664d7-c5f3-4feb-80fa-285ccd92a12b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=77cf5bc1b0593df7548ecefd21f173e2 2x, https://si.imgix.net/37ca2c59/uploads/origins/519664d7-c5f3-4feb-80fa-285ccd92a12b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05d009f146591d50fdcb3094c1747bf3 3x"}, "body": "こんにちは〜T-X娘のイラストを依頼したいと思います\n\nコミッションの内容:\nPOV／＜男性警察官視点＝読者視点＞\nT-X娘は首を傾げて黒いキャットスーツのジッパーを下ろすと、大きな胸と深い胸の谷間が露わになった。\nT-X娘のもう片方の手は背中に隠れている（かすかな青い光を放つ電動丸鋸に変形している）\nhttps://drive.google.com/file/d/1EEKTBdRdRDSRUsE_YwZbV9nl2Fe1mwZ1/view?usp=drivesdk\n\nストーリーの詳細な説明:\n男性警察官はT-X娘に誘われて人気のない隅に行き、T-X娘は首を傾げて男性警察官を見つめながら、片手で服のジッパーを下げ（ジッパーはへその下、ほぼ膣まで下げられていた）、男性警察官を誘惑するように大きくなった胸を露出させた。\n[T-X娘のもう片方の手は背中に隠され、微かな青い光を発する電動丸鋸に変化し、警察官を殺害する機会をうかがっている]\n\nキャラクターの要件:\n服装：黒のキャットスーツ（ラテックス素材なので光沢感があります）\n巨乳\n表現なし\n頭を傾ける\n乳首は露出していない\n片目の瞳孔が淡い青色の光を放つ", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@6roid_06/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2146658, "client_id": 219112, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd31eb1c/uploads/origins/b10abf93-ccbc-41cd-92bf-e8abe6681c87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2db3adf54d92b318778832343846595d", "srcset": "https://si.imgix.net/fd31eb1c/uploads/origins/b10abf93-ccbc-41cd-92bf-e8abe6681c87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2db3adf54d92b318778832343846595d, https://si.imgix.net/fd31eb1c/uploads/origins/b10abf93-ccbc-41cd-92bf-e8abe6681c87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c075de9039b54e7af305eca19cd79ca 2x, https://si.imgix.net/fd31eb1c/uploads/origins/b10abf93-ccbc-41cd-92bf-e8abe6681c87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e315aec8e3e11ae5af261ac27b67c85c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd31eb1c/uploads/origins/b10abf93-ccbc-41cd-92bf-e8abe6681c87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00884ddb1eb518ced9d8e80b0dd30d1c", "srcset": "https://si.imgix.net/fd31eb1c/uploads/origins/b10abf93-ccbc-41cd-92bf-e8abe6681c87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00884ddb1eb518ced9d8e80b0dd30d1c, https://si.imgix.net/fd31eb1c/uploads/origins/b10abf93-ccbc-41cd-92bf-e8abe6681c87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f3cb6eb82a31d930e21527f0eefdf7e 2x, https://si.imgix.net/fd31eb1c/uploads/origins/b10abf93-ccbc-41cd-92bf-e8abe6681c87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=63fcdcac27114ecc65be63e95b4492ac 3x"}, "body": "タイトル「T-1000娘 VS T-X娘」\nT-1000娘とT-X娘が対峙しており、お互い臨戦態勢となっているイラスト(カラー)をリクエストいたします。１枚絵(＋差分１枚)でお願いします（他の追加差分は任意）。効果音も付けてもらえると嬉しいです。\n\n＜構図　横長(16:9)＞\n・１枚絵（ベース）：\nT-1000娘が左側、T-X娘が右側。お互い無表情で見つめ合っている。ただし、真横ではなく、両目が見えるくらいの前斜めで、少し横目で見つめ合っている状態。全体像は頭から膝までが見えるくらい（パンチラは不要）。背丈はT-X娘の方が高く、胸はT-X娘の方が大きい。\n\nT-1000娘：黒髪ストレートのセミロング。女子学生服。Yシャツの上にセーターを着て、プリーツのミニスカートを履いている。セーターからもくっきり見えるくらいの巨乳。左腕を刃物へと変形している。\n\nT-X娘：暗めの茶髪ストレートのショートカット。黒いOLスーツと黒いタイトスカート。中のYシャツとブラジャーは無し。胸部がミチミチと今にも張り裂けそうなくらいの巨乳。右腕をレーザー銃へと変形している。\n\n・１枚絵（差分）：\n戦闘により、お互い損傷を受けている差分をお願いします。胸部の損傷は必須です。T-X娘がやや優勢。\n\nT-1000娘：\n大きな弾痕を5ヶ所受けており、中の液体金属が見えるくらいの抉れが2ヶ所ある。T-1000娘は無表情を保っているが、口を半開きしながら自身の胸元に出来た損傷を見つめている。左腕の刃物は所々欠けている。\n\nT-X娘：\n中の機械が見えるくらいの弾痕を3ヶ所受けている。T-1000娘より上位の機種であると理解したT-X娘は、T-1000娘に向けて微かに不敵な笑みを浮かべている。右腕のレーザー銃を止めて、右人差し指を、青い光を放つナノ注射器に変形。今まさにT-1000娘のプログラムを書き換えようとしている。\n\n・追加(任意)：\nT-X娘の胸部腕部のメカバレ透過差分。\n\n＜参考画像＞\nカメラアングル＋T-X娘(2枚目)の笑み：https://www.pixiv.net/artworks/105641858\nT-1000娘：https://www.pixiv.net/artworks/110152595\nT-X娘：https://www.pixiv.net/artworks/109503587", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@6roid_06/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2146658, "client_id": 219112, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/524416d4/uploads/origins/a8f26114-0089-426a-8c27-9d7eaedd8c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90b670bf999f2f6558ff3afda36f8732", "srcset": "https://si.imgix.net/524416d4/uploads/origins/a8f26114-0089-426a-8c27-9d7eaedd8c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90b670bf999f2f6558ff3afda36f8732, https://si.imgix.net/524416d4/uploads/origins/a8f26114-0089-426a-8c27-9d7eaedd8c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae1421113541db74089b846e165e6a22 2x, https://si.imgix.net/524416d4/uploads/origins/a8f26114-0089-426a-8c27-9d7eaedd8c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=882a0bb4ae3cb1da820778a86bdbe5e9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/524416d4/uploads/origins/a8f26114-0089-426a-8c27-9d7eaedd8c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f100512fb0b41410a20562df3360697", "srcset": "https://si.imgix.net/524416d4/uploads/origins/a8f26114-0089-426a-8c27-9d7eaedd8c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f100512fb0b41410a20562df3360697, https://si.imgix.net/524416d4/uploads/origins/a8f26114-0089-426a-8c27-9d7eaedd8c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fda8800e34e6e3e5c042ac5d661da564 2x, https://si.imgix.net/524416d4/uploads/origins/a8f26114-0089-426a-8c27-9d7eaedd8c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2ee3285e18935cd1a75672dbe01b9f25 3x"}, "body": "T-X娘達が量産工場で一斉に起動され、レジスタンス達を返り討ちにするイラスト(カラー)をリクエストいたします。１枚絵(＋差分１枚)でお願いします（他の追加差分は任意）。\n\n＜シチュエーション＞\n自我に目覚めた機械の支配下で、人間が抗戦する未来。機械軍による新型兵器が開発されていた。\nその名もT-X娘。過去の戦闘データが集約された究極の女性型ターミネーター。\n超高性能AIと強靭で美しいボディを持つ彼女は、人間はおろか歴代ターミネーターすら凌駕する戦闘能力を持つ。\n人間軍のレジスタンス一向はT-X娘の起動を阻止するべく、量産工場を襲撃しようとした。\nしかし、遅かった。T-X娘達は既に起動され、脳内のチップには「人類抹殺」の本能が埋め込まれていた。\n「起動完了……全人類の抹殺を開始……」\n\n＜構図＞\n横長(16:9)でお願いします。\n・１枚絵（ベース）：\nレジスタンス視点で、裸(陰毛無し)の3体以上の爆乳のT-X娘が人間を襲撃するシーンをお願いします。\n- 中心で正面を向いている。目の前のレジスタンスを抹殺しようする。 右胸と左頬に弾痕がある。右手で自分の右乳を揉んでおり、左腕は刃物へと変形している。レジスタンスの銃はカタカタと震えている。\n- 右側にいて右斜め前を向いている。返り血を浴びており、左腕はレーザー銃へと変形している。お腹に大きな弾痕があるが、不敵な笑みを浮かべている。上げた右腕の人差し指には、プログラム改ざんの機械針が出ている。参考：https://www.pixiv.net/artworks/105641858\n- 左側(やや後ろ)にいて、お尻を突き出して、四つん這いになり蜘蛛のように移動する。周りをギロッと見つめ、次なるターゲットを探している。弾丸を何発も受けているが、正常に動いている。彼女の爆乳は床にムニュリと付いている。参考：https://www.pixiv.net/artworks/85319350\n\n・１枚絵（差分）：\nレジスタンスのHUDを通して、T-X娘の内部構造が透過されたメカバレ差分をお願いします。\n透過は赤、T-X娘の内部構造は青にして、以下の部位に分析結果が表示される。\n「頭部／瞳／表情／胸／腕／腹／尻／足／表皮」\n\n＜参考画像＞\nAIで作成した参考画像を資料URLに記載します。R-18女性の裸のためご注意ください。\n\nhttps://drive.google.com/drive/folders/19r-4jNwpOQqIFid-n4L8ie3vW5kgu4lx?usp=sharing", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@6roid_06/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2146658, "client_id": 131031, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b289279/uploads/origins/7c794284-0f97-48ea-b805-9321f4fa9f03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c07af38337bd147986a3068493c22d69", "srcset": "https://si.imgix.net/1b289279/uploads/origins/7c794284-0f97-48ea-b805-9321f4fa9f03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c07af38337bd147986a3068493c22d69, https://si.imgix.net/1b289279/uploads/origins/7c794284-0f97-48ea-b805-9321f4fa9f03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ecb7940e5497e50fe98f1e79fbdbc126 2x, https://si.imgix.net/1b289279/uploads/origins/7c794284-0f97-48ea-b805-9321f4fa9f03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f4dd6fc74e3e14de32adbcff8a82cfa 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b289279/uploads/origins/7c794284-0f97-48ea-b805-9321f4fa9f03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d55507315e0dc74945c1e2a88d8d40eb", "srcset": "https://si.imgix.net/1b289279/uploads/origins/7c794284-0f97-48ea-b805-9321f4fa9f03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d55507315e0dc74945c1e2a88d8d40eb, https://si.imgix.net/1b289279/uploads/origins/7c794284-0f97-48ea-b805-9321f4fa9f03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c88c98d2671b8d5f51c095a3d9f6d3a 2x, https://si.imgix.net/1b289279/uploads/origins/7c794284-0f97-48ea-b805-9321f4fa9f03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=948d0172c026268a43499efd93b117dd 3x"}, "body": "いつもリクエストに応えていただき、ありがとうございます。今回は、以前描いていた女児ヘッド大人ボディのロボ娘をお願いしてもよろしいでしょうか？\n構図などの細部は\n・体位はスパイダー騎乗位をしながら指で乳首責めをしている構図を竿役視点。\n・頭部の外見年齢相応の幼い口調で「きもちいいですか？」や「えへへ♪」などのセリフで竿役に対して、自身の行動を理解していないかのような純粋な微笑みを浮かべている\nまた、差分として\n1.無表情で駆動音と腰を打ち付ける音のみが響いている\n2.無理な改造のせいで、不具合が続出して、首から異音がして、幼い言葉遣いに淫語が混ざった支離滅裂な音声を吐きながら、舌を出したバグった表情で異常な速度で乳首責めとピストン運動を行っている。\n3. 2.の派生で、射精されて過負荷で壊れて停止した状態\n\n以上でよろしくお願いいたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@6roid_06/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2146658, "client_id": 465956, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90e90b06/uploads/origins/1040a8b8-26be-40ae-9c29-f560c57bfc39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d1b430a6f2e9730e7b948b116fd97b8", "srcset": "https://si.imgix.net/90e90b06/uploads/origins/1040a8b8-26be-40ae-9c29-f560c57bfc39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d1b430a6f2e9730e7b948b116fd97b8, https://si.imgix.net/90e90b06/uploads/origins/1040a8b8-26be-40ae-9c29-f560c57bfc39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35e66b0c4792285c2e2f7630aba84d11 2x, https://si.imgix.net/90e90b06/uploads/origins/1040a8b8-26be-40ae-9c29-f560c57bfc39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a19fd5ba10fb0dbb88fd7bcb18cc053 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"