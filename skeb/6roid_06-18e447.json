=200&h=200&s=64f7a7a6656d84374b0d8a41dcb2e30d", "srcset": "https://si.imgix.net/dd7f2fcd/uploads/origins/bf68c524-589e-4a35-865b-6a50f1495b68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64f7a7a6656d84374b0d8a41dcb2e30d, https://si.imgix.net/dd7f2fcd/uploads/origins/bf68c524-589e-4a35-865b-6a50f1495b68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1e3d9c187a962d93f39d0ccc648f057 2x, https://si.imgix.net/dd7f2fcd/uploads/origins/bf68c524-589e-4a35-865b-6a50f1495b68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ffcfdfbb03489b6bd9e1cec02c1551eb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd7f2fcd/uploads/origins/bf68c524-589e-4a35-865b-6a50f1495b68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40eb90f4f93d291ad54c753b84781db1", "srcset": "https://si.imgix.net/dd7f2fcd/uploads/origins/bf68c524-589e-4a35-865b-6a50f1495b68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40eb90f4f93d291ad54c753b84781db1, https://si.imgix.net/dd7f2fcd/uploads/origins/bf68c524-589e-4a35-865b-6a50f1495b68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=80d36c91dceacacf804b5cf417f4cc1f 2x, https://si.imgix.net/dd7f2fcd/uploads/origins/bf68c524-589e-4a35-865b-6a50f1495b68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7f0f908dade76a4de30e712dea93f2bf 3x"}, "body": "T-X娘が自身の巨乳を下から持ち上げて、無表情で胸の膨張の経過と内部構造をスキャンするイラスト(カラー)をリクエストいたします。１枚絵(＋１枚絵に対する差分１枚)でお願いします（他の追加差分は任意）\n\n＜シチュエーション＞\nターゲットを色仕掛けで抹殺するためには、自分の胸を改造する必要があると学習したT-X娘。\nT-X娘は自分の胸を持ち上げて、無表情で胸の中に組み込まれた２つの銀色の球体を青白い瞳でスキャンする。\nその結果、ある思考が生まれた。\n「もっと大きくしないと……」\nT-X娘は己の思考をもとにプログラムを実行した。\nすると銀色の球体を取り囲む電子回路が光り出し、ただでさえ大きい胸が更に膨れ上がる。\n「胸部膨張プログラム実行中……適合率94%……20.3秒後に武器が完成……製造終了後任務再開……」\nT-X娘の胸は液体金属で出来ている。大きさ／形／柔らかさなどT-X娘の命令一つで自在に変形することが可能なのだ。\n\n＜構図＞\n・１枚絵（ベース）：\nコンクリートに座ったT-X娘が自身の巨乳を下から持ち上げ胸部膨張プログラムが94%ほど完了したことを告げるシーンをお願いします。\n胸のふくらみが大体終わり、あとは形を整えるために少しプルプルと震えている状態がベストです。\nT-X娘の顔は無表情、死んだ目で自分の胸を見下ろす。指が少し胸に食い込むくらい胸の感触を味わいながら下から乳揉みし、システムメッセージを口走る仕草であればOKです。\n服装は黒いOLスーツと黒いタイトスカート。中のYシャツとブラジャーは無し。胸部が今にも張り裂けそうなくらいミチミチしており、ただでさえ目立つ谷間がさらに強調されればOKです。\nカメラアングルは胸が強調されるようなローアングルで、構図は頭のてっぺんからスカートの裾が見えるくらい。\n\n・１枚絵（差分）：\nベースに対して、T-X娘の瞳と腕手指と胸の内部構造が透過されたメカバレ差分をお願いします。\n瞳の内部はHUD風の青白いモニターでスキャン中。腕手指の内部はターミネーターのような骨組み。\n胸の内部は、胴体の金属骨格に装着された銀色の球体が２玉あり、その表面には電子回路の線が無数に蔓延っている。\n\n＜参考画像＞\nAIで作成した参考画像を資料URLに記載します。\n「01a_仕草.png」と「02a_服装／カメラアングル.png」が主なイメージです。\n\nhttps://drive.google.com/drive/folders/1q_eZxdwjrbgz3AZIN2fA5NtrJN7U1tEH?usp=share_link", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@6roid_06/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2146658, "client_id": 131031, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca89f9c3/uploads/origins/483f195d-e720-47dd-b1df-83ba69957004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61a2dae43ca0a09001ad323de091ad5d", "srcset": "https://si.imgix.net/ca89f9c3/uploads/origins/483f195d-e720-47dd-b1df-83ba69957004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61a2dae43ca0a09001ad323de091ad5d, https://si.imgix.net/ca89f9c3/uploads/origins/483f195d-e720-47dd-b1df-83ba69957004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2aaa74d61a885d7df1b35a1a6bbc3cee 2x, https://si.imgix.net/ca89f9c3/uploads/origins/483f195d-e720-47dd-b1df-83ba69957004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04b103b27d68430eb9dbb5ab03a44185 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca89f9c3/uploads/origins/483f195d-e720-47dd-b1df-83ba69957004?bg=%23fff&auto=format%2Ccompr