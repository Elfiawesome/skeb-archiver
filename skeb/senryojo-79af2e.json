イズで納品いただければ幸いです。\n・サムネイルや動画で使用するにあたり、頭頂部や体の左右が見切れていないと助かります。(下は見切れてしまっても大丈夫です。)\n\n\n------------------------\n\nお忙しいところ恐れ入りますが、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1mAn80PjAM11KqUGLUOdcVKTVwUNvdJO4?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@senryojo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1850691, "client_id": 620658, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89afb968/uploads/origins/1f13afed-f977-47a9-a01e-0a0886ddf052?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=187b87b7adce634f10bf363ae58a93f9", "srcset": "https://si.imgix.net/89afb968/uploads/origins/1f13afed-f977-47a9-a01e-0a0886ddf052?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=187b87b7adce634f10bf363ae58a93f9, https://si.imgix.net/89afb968/uploads/origins/1f13afed-f977-47a9-a01e-0a0886ddf052?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e393a0c492c524012145ad695087ad6 2x, https://si.imgix.net/89afb968/uploads/origins/1f13afed-f977-47a9-a01e-0a0886ddf052?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b98704fe19fa50d640597e9364bdbe24 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89afb968/uploads/origins/1f13afed-f977-47a9-a01e-0a0886ddf052?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dde4300a5519e946607096e35b05fc9", "srcset": "https://si.imgix.net/89afb968/uploads/origins/1f13afed-f977-47a9-a01e-0a0886ddf052?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dde4300a5519e946607096e35b05fc9, https://si.imgix.net/89afb968/uploads/origins/1f13afed-f977-47a9-a01e-0a0886ddf052?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&