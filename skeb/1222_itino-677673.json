, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1222_itino/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2565794, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f48534d4/uploads/origins/fa6e16d2-38d9-41c5-ab65-70bc8980dd9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55305e3faaf826fb88829bcb73744c53", "srcset": "https://si.imgix.net/f48534d4/uploads/origins/fa6e16d2-38d9-41c5-ab65-70bc8980dd9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55305e3faaf826fb88829bcb73744c53, https://si.imgix.net/f48534d4/uploads/origins/fa6e16d2-38d9-41c5-ab65-70bc8980dd9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af895bb4f502e4b9374c51cb6f98e048 2x, https://si.imgix.net/f48534d4/uploads/origins/fa6e16d2-38d9-41c5-ab65-70bc8980dd9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28136d954a846b19a6154a6cc4c04608 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f48534d4/uploads/origins/fa6e16d2-38d9-41c5-ab65-70bc8980dd9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52d32d1f767ef16fdeab2b4a35770e43", "srcset": "https://si.imgix.net/f48534d4/uploads/origins/fa6e16d2-38d9-41c5-ab65-70bc8980dd9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52d32d1f767ef16fdeab2b4a35770e43, https://si.imgix.net/f48534d4/uploads/origins/fa6e16d2-38d9-41c5-ab65-70bc8980dd9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49599f25af9d2677fc62b29b0e1d3e83 2x, https://si.imgix.net/f48534d4/uploads/origins/fa6e16d2-38d9-41c5-ab65-70bc8980dd9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9104df683adfc7ee75cd2786b44355a4 3x"}, "body": "初めまして、宙星 䋖乃様の素敵なイラストいつもTwitterで拝見しております！\n今回は私のコテキャ(OC)を描いて頂きたいと思いリクエストを送らせて頂きました！！\n\n▼服装について\n資料内のものでも、宙星 䋖乃様の好きなように洋服をデザインして頂いてもどちらでも大丈夫ですので好きに描いてください！\n\n▼ コテキャのビジュアルについて\n年齢：15〜20歳くらい\n身長：168cm\nほくろ：こちらから見て口の左下\n瞳の色：明るい灰色\n髪色：淡いピンク色\n髪型：パッツンM字前髪にクラゲカット、こちらから見て右側に編み込みをしています！\n\n※前髪のところにある✕‬の髪飾りがポイントなので出来るだけ忘れずに描いて頂きたいです。\n\n▼イメージ&モチーフ\nイメージカラー：淡いピンク色、グレー、青\nモチーフ：リボン🎀、シャボン玉🫧、蝶🦋\nスイーツ：マカロン/フルーツ：桃\nフラワー：桜、百合、青色の薔薇\n上品で可愛いらしい雰囲気が好きです。(プリンセスコア、バレエコアetc.....)\n\n▼性格\n･マイペース\n･好奇心旺盛\n･可愛いものが大好き！\n\n表情はくるくると変わり感情豊かに見えるものの内面は静かで理知的。\n物事を一歩引いた視点から捉える癖があり\n周囲からは「落ち着いてる」「大人っぽい」\n「何を考えてるかわからない」と思われている。\n\n▼使用用途\n･各種SNSのアイコンやヘッダー\n･キャラ資料への記載(コテシ使用)\n･個人鑑賞、個人利用の範囲内でのグッズ化\n\n▼備考\n･もし可能であれば背景透過バージョンが欲しいです！\n\nご縁がありましたらよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/17-5qwUo9V5USSj1f2CVrdy2fJ8oobhSO", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1222_itino/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6539ba86/uploads/origins/2afdbd30-f8fe-4122-b962-681a469d955e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8cd07c03d2a866afcf843eb0188308ed", "srcset": "https://si.imgix.net/6539ba86/uploads/origins/2afdbd30-f8fe-4122-b962-681a469d955e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8cd07c03d2a866afcf843eb0188308ed, https://si.imgix.net/6539ba86/uploads/origins/2afdbd30-f8fe-4122-b962-681a469d955e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f72b3f058b02c3ca7629cdd35364cdc5 2x, https://si.imgix.net/6539ba86/uploads/origins/2afdbd30-f8fe-4122-b962-681a469d955e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont