rop&crop=top&w=200&h=200&s=a202d63174002a7b7872c6b21bfba098 2x, https://si.imgix.net/54b9643b/uploads/origins/769b258e-6f36-46e2-8fe7-38a0cefd57a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8557f3a437dd31b43c401c53e236af4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54b9643b/uploads/origins/769b258e-6f36-46e2-8fe7-38a0cefd57a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfae42e04c3eb2c330e81ed544b8634c", "srcset": "https://si.imgix.net/54b9643b/uploads/origins/769b258e-6f36-46e2-8fe7-38a0cefd57a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfae42e04c3eb2c330e81ed544b8634c, https://si.imgix.net/54b9643b/uploads/origins/769b258e-6f36-46e2-8fe7-38a0cefd57a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1bcbd8872c33c6a94450cf190e0b06f4 2x, https://si.imgix.net/54b9643b/uploads/origins/769b258e-6f36-46e2-8fe7-38a0cefd57a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=066fff5912683d1855be98e7021a6fa8 3x"}, "body": "こんにちは！僕のメカとパイロットを描いてくれないかな。ヘビーレールガンを構えているようなアクションポーズで。また、パイロットが微笑んでいるコックピットの中のショットも欲しいです。\n\nパイロット参照：https://imgur.com/a/june-galain-iDgZZL5\nメック参照：https://imgur.com/a/thalia-havel-mrFXLOd", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sizimi_draw/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3403529, "client_id": 3679516, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b8c67f4/uploads/origins/27da1d62-4225-401d-98e3-76a2a4b40e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19b1456c86bd89bbbd817e7c56e84b65", "srcset": "https://si.imgix.net/9b8c67f4/uploads/origins/27da1d62-4225-401d-98e3-76a2a4b40e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19b1456c86bd89bbbd817e7c56e84b65, https://si.imgix.net/9b8c67f4/uploads/origins/27da1d62-4225-401d-98e3-76a2a4b40e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9666d285863b4ed5ab0aea1d7d96242 2x, https://si.imgix.net/9b8c67f4/uploads/origins/27da1d62-4225-401d-98e3-76a2a4b40e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52068e800233c34c0f6c8f19504f0718 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b8c67f4/uploads/origins/27da1d62-4225-401d-98e3-76a2a4b40e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b48c4daaa64507f7339c8d7678c6f206", "srcset": "https://si.imgix.net/9b8c67f4/uploads/origins/27da1d62-4225-401d-98e3-76a2a4b40e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b48c4daaa64507f7339c8d7678c6f206, https://si.imgix.net/9b8c67f4/uploads/origins/27da1d62-4225-401d-98e3-76a2a4b40e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=76ae56fa8cbc9ae3803e765624382cd7 2x, https://si.imgix.net/9b8c67f4/uploads/origins/27da1d62-4225-401d-98e3-76a2a4b40e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=814672265918a2a3a2e17bed13e55064 3x"}, "body": "こんにちは！あなたのアートスタイルがとても好きで、カスタムメカのアートを依頼したいと思っています。デザインは、頭部はアーマード・コア4のサプリスに似た細いスタイルで、胴体はF91のヘビーガンとサプリスのものをミックスし、脚はGMカスタムのものに似ています。バックパックはAileのストライクパックとGMカスタムのバックパックをミックスしたもの。武装は、腰部にビームサーベル×2、頭部にバルカン×2、EM-2に似たビームライフル、展開可能なビームブレードを持つシールド、バックパック左手上部にマウントされたビームキャノンに加え、6つのウイングハードポイントを持つ。また、カラースキームはGMカスタムに似たものをお願いしたい。\n\nこの情報があなたのお役に立てれば幸いです。\n\nありがとう！\n\nhttps://imgur.com/a/2ZL9uIK", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sizimi_draw/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped"