に装着された武器が必要である。アーマーの色はガンメタルグレーで、ヘルメットの顔には金色のバイザーがあり、その下にはカメラが隠されているはずだ。  アーマーのメインウェポンは、古いトラップドア機構のブリーチローディングライフル（参考画像#9と#10）を未来的なビームウェポンにしたもので、多少かさばり、使うのが面倒で、未来的な光るカートリッジを弾薬として利用し、パワーケーブルでアーマーに接続する。ポージングはお任せする。\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1PP1Yt7cZnw3gi2iKSOX2Pw070fyXsmFc?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sizimi_draw/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3403529, "client_id": 121069, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2862f9cd/uploads/origins/f241d516-0593-4c01-b9ca-d8413e61e65d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e233907316fa9b9638c301ee63524c89", "srcset": "https://si.imgix.net/2862f9cd/uploads/origins/f241d516-0593-4c01-b9ca-d8413e61e65d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e233907316fa9b9638c301ee63524c89, https://si.imgix.net/2862f9cd/uploads/origins/f241d516-0593-4c01-b9ca-d8413e61e65d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03dabd09b54dc63fc531045121176d6c 2x, https://si.imgix.net/2862f9cd/uploads/origins/f241d516-0593-4c01-b9ca-d8413e61e65d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39745f3ef6475d1528579e7eb94764ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2862f9cd/uploads/origins/f241d516-0593-4c01-b9ca-d8413e61e65d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ed73aed00802bdf1dac66e7570c82b7", "srcset": "https://si.imgix.net/2862f9cd/uploads/origins/f241d516-0593-4c01-b9ca-d8413e61e65d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ed73aed00802bdf1dac66e7570c82b7, https://si.imgix.net/2862f9cd/uploads/origins/f241d516-0593-4c01-b9ca-d8413e61e