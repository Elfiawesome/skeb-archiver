-ba73-068d00ed5496?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b04b6fbceba8f8410c16fee501d0bf6d 2x, https://si.imgix.net/197e1f81/uploads/origins/3dc7ed3e-a69b-4cbe-ba73-068d00ed5496?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e855e0b1dee7f419e2c231e90809103 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/197e1f81/uploads/origins/3dc7ed3e-a69b-4cbe-ba73-068d00ed5496?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4e219e1c9658c9f7530de15ab805b80", "srcset": "https://si.imgix.net/197e1f81/uploads/origins/3dc7ed3e-a69b-4cbe-ba73-068d00ed5496?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4e219e1c9658c9f7530de15ab805b80, https://si.imgix.net/197e1f81/uploads/origins/3dc7ed3e-a69b-4cbe-ba73-068d00ed5496?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=88128e1dc8bc2a3e0549d029293ab5bf 2x, https://si.imgix.net/197e1f81/uploads/origins/3dc7ed3e-a69b-4cbe-ba73-068d00ed5496?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ac756aa21ebeb33d61871a8c373941aa 3x"}, "body": "名前：加賀見 メイ（銘）\nケモVの立ち絵デザインをお願いします。\n世界の設定は以下のような感じです\n・獣人は普通にいる世界\n・猫獣人で、種類はメインクーン\n　リアルのメインクーンは馬鹿でかい猫です\n　尻尾は結構太くてモフモフです\n　胸毛もモフモフです。髭はありません\n　アメリカのメイン州の州猫\n　名前の言われは色々ありますが、「メイン」+「(rac)coon」、「メイン州のアライグマ＝悪戯っ子」ってのが好きです\n・メインクーンなので、「メイ君」って呼ばれてる\n　漢字としては「銘」が当てられてる\n・髪型は腰まで伸びる髪をご主人に三つ編みにしてもらってる\n・ご主人も髪は伸ばしているが、三つ編みを編むのが下手くそで申し訳なく思ってる\n・子供が10歳になるとお供の獣人を家族としてお迎えするお家の風習\n・10歳になると家族がもう1人増えるわけで、良いとこの坊ちゃんかも？\n・最近関西から関東に引っ越して友達と会えなくなってしまった\n・ご主人はリモートワークなのでお仕事をたまに手伝う\n　何となく開発も覚えてしまった。簡単なツールなら作れる\n・悪戯っ子\n・ご主人は「茂(しげる)」さん。皆んなには「しげさん」と呼ばれてる\n・口癖は「◯◯なのです」\n・茂は55なのでメイは45\n・ゲーミングヘッドホンが気に入っていつも首にかけている\n　コードは取り外し式なので付いてない\n　カップ部は赤。頭の上の接続部は両端が赤く塗られてるこの部分がレインボーに光る\n・コミュ障なりに友達はいたが、引っ越しで没交渉に。ご主人が遊びに出かけると寂しいので自分も友達を作りたくなった\n・通信設備をおねだりして買ってもらった\n・仕事には就いていない\n・特技は特に無いがゲームが好き\n・あまり上手く無いけど歌も好き\n・身長140cm、体重：75kg\n・45歳\n・殿方\n・色は黒と赤が好き\n・服装\n　黒いダウンジャケット（裏地はワインレッド）\n　シャツは長袖（ワインレッド）胸にでっかい足跡マーク\n　パンツはGパン濃いい青\n　裸足\n・猫だけど寒いのは得意（メーン州は冬は厳寒地）\n・その代わり、夏はメチャメチャ苦手\n・猫だけど泳げる（犬かき）\n・猫だけど猫獣人だから食えるもの\n　チョコ、牛乳、乳製品、ブドウ、レーズン、アルコール\n・アルコールは猫獣人的にはOKだけどメイ君は飲めない（ご主人も）", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tanutronik753_k/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 136260, "client_id": 1215628, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8c0e6e5/uploads/origins/3373fb4f-9b97-493d-8fd6-52b7fcfe9ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e7933c48f50e6ce4ed034c2146bef1e", "srcset": "https://si.imgix.net/e8c0e6e5/uploads/origins/3373fb4f-9b97-493d-8fd6-52b7fcfe9ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e7933c48f50e6ce4ed034c2146bef1e, https://si.imgix.net/e8c0e6e5/uploads/origins/3373fb4f-9b97-493d-8fd6-52b7fcfe9ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7d9a03ba7f54d7beaf4555239cfa6f3 2x, https://si.imgix.net/e8c0e6e5/uploads/origins/3373fb4f-9b97-493d-8fd6-52b7fcfe9ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6672b20c73dd02c1deae149e7d28b13 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8c0e6e5/uploads/origins/3373fb4f-9b97-493d-8fd6-52b7fcfe9ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5b1a4377d55f26cd4795be811764a42", "srcset": "https://si.imgix.net/e8c0e6e5/uploads/origins/3373fb4f-9b97-493d-8fd6-52b7fcfe9ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5b1a4377d55f26cd4795be811764a42, https://si.imgix.net/e8c0e6e5/uploads/origins/3373fb4f-9b97-493d-8fd6-52b7fcfe9ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5ad627c00d4726aa6444d19102c8423e 2x, https://si.imgix.net/e8c0e6e5/uploads/origins/3373fb4f-9b97-493d-8fd6-52b7fcfe9ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6a3459eb7f9b3fdbcc7d99a6a50f04a9 3x"}, "body": "お久しぶりです。\nまたも、お願いします。\n今回はシリーズものということで春の福禄をお願いできますか？\n花見の場所取りをしている福禄と言う事で、\nブルーシートを広げ、まだ時間が有るのでその上で座っても寝てても良いので主の到着を待っている。\n傍らには飲み物や食材、器材と言った物が置かれている。\n皆の到着後に広げる予定。\n服装も上着を脱いできちんと畳んで置いてある。\n周りは桜の絨毯で木々も満開、最高の場所取りで。\nと言った様子の場面をお願いできますか？\nこの後夏秋冬のワンシーンをお願いします。\nどうぞよろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tanutronik753_k/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1bd1c2a0/uploads/origins/e0519053-b761-41b2-8745-5026fb664c6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=38c7dc193a8b71885e623dfdea2b1a9a", "srcset": "https://si.imgix.net/1bd1c2a0/uploads/origins/e0519053-b761-41b2-8745-5026fb664c6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=38c7dc193a8b71885e623dfdea2b1a9a, https://si.imgix.net/1bd1c2a0/uploads/origins/e0519053-b761-41b2-8745-5026fb664c6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe4a8e702158f7551671fcc37f027d27 2x, https://si.imgix.net/1bd1c2a0/uploads/origins/e0519053-b761-41b2-8745-5026fb664c6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b48cb8a72bdd6a46870c7ce419c894fc 3x"}, "private": true, "genre": "art", "tipped": true, "creator_