jn/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4130736, "client_id": 2618136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c36d1a30/uploads/origins/8c5c2359-22d9-4b8d-85d1-43151e8ba3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91031c9b5b4c37206e320d43ed9f704b", "srcset": "https://si.imgix.net/c36d1a30/uploads/origins/8c5c2359-22d9-4b8d-85d1-43151e8ba3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91031c9b5b4c37206e320d43ed9f704b, https://si.imgix.net/c36d1a30/uploads/origins/8c5c2359-22d9-4b8d-85d1-43151e8ba3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d864e078f654c23bb94e4591ffefe4a 2x, https://si.imgix.net/c36d1a30/uploads/origins/8c5c2359-22d9-4b8d-85d1-43151e8ba3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1debd6b69655bb5584bee08da1858a60 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c36d1a30/uploads/origins/8c5c2359-22d9-4b8d-85d1-43151e8ba3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e40ea95e2b9fcc11d3db48a48577b88e", "srcset": "https://si.imgix.net/c36d1a30/uploads/origins/8c5c2359-22d9-4b8d-85d1-43151e8ba3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e40ea95e2b9fcc11d3db48a48577b88e, https://si.imgix.net/c36d1a30/uploads/origins/8c5c2359-22d9-4b8d-85d1-43151e8ba3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c03c26da301ddede7b655ee0eb2d9e5 2x, https://si.imgix.net/c36d1a30/uploads/origins/8c5c2359-22d9-4b8d-85d1-43151e8ba3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df8aaecbf8b172773f49acf3151f5bcc 3x"}, "body": "yuzu様\n\nいつも素敵な絵を楽しく拝見しております。\n以前yuzu様に描いていただいたうちの子たちのイラストがとても素晴らしくて、ずっと忘れられませんでした💖\n先生の描かれるOCたちの絡みが可愛くて尊すぎて、本当に大好きです🫶🏻リクエストの募集開始を心待ちにしておりました。\n\nぜひオリキャラ2人を描いていただきたいと思います。前世でも現世でも大丈夫です！\n金額が足りない場合は、遠慮なく再送依頼をいただければと思います。\n\nOCの2人は、中華風ファンタジー世界の前世からの宿縁で結ばれた、敵対する殺し愛関係を持つ天帝（銀白髪）と魔尊（黒髪）です。\n\n【キャラ紹介】\n\n​◆魔尊（受け/黒髪）\n元人間の修真者、現在は闇落ちした魔界の主。\n前世は鳳凰族の長。黒幕の陰謀により「攻めに一族を滅ぼされた」と誤解したまま絶望して死んだため、今世でも彼に対し愛憎入り混じる複雑な感情を抱く。\n\n​◆天帝（攻め/銀白髪）\n天界の支配者。前世は龍族の少主。\n前世からの執着を引き継いでおり、魔尊を何が何でも手に入れるという異常なほどの独占欲を持つ。\n\n​◆経緯（前世→現世）\n前世は種族を越えた親友・両片思いだったが、陰謀により悲恋に終わる。\n今世、記憶がないまま人間界で再会し再び親友となるも、受けの闇落ちと攻めの記憶回復を経て、現在は「敵対しつつも互いに執着する関係」へと変貌した。\n\n具体的なキャラ設定、関係性、メインストーリーなどは下記の資料URLにございます。\nhttps://drive.google.com/drive/folders/17rdnoHcni5EX_RWdvFYVBJjY3zj0c7oT\n※服飾の簡略化やアレンジなど自由にしていただいて大丈夫です。新衣装のデザインも大歓迎です。髪型もアレンジして構いません！\n\nご依頼内容が難しいと感じられた場合は、キャンセルしていただいて構いません。\n\n▼【使用用途】\n・個人利用です。\n・SNSのアイコン、ヘッダーへの使用や投稿\n・個人鑑賞目的での印刷や非商用グッズ化等、営利利用は一切いたしません。\n\nお忙しいところ恐縮ですが、ご検討いただけますと幸いです。\n何卒よろしくお願い申し上げます。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 2787667, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "収穫されたみんと💫☁️", "screen_name": "9BMINT1016", "avatar_url": "https://pbs.twimg.com/profile_images/2039357247399313408/qn3tbZrG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1110549448399032322/1708521383/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 144}, {"id": 2845318, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "嗚呼たま@依頼受付停止中", "screen_name": "nitama_tama5", "avatar_url": "https://pbs.twimg.com/profile_images/1633294992063201281/f1c62Hde.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1633294352259878918/1687506993/1500x500", "appeal_receivable": false, "popular_creator_