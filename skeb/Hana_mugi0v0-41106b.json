0.jp/archives/zoo/005/", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hana_mugi0v0/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3152260, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa879cbf/uploads/origins/fb88bbf6-b63a-4bcd-b6d5-12e070bca81f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa1072fa26015e3c67138088ed6a1e3d", "srcset": "https://si.imgix.net/fa879cbf/uploads/origins/fb88bbf6-b63a-4bcd-b6d5-12e070bca81f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa1072fa26015e3c67138088ed6a1e3d, https://si.imgix.net/fa879cbf/uploads/origins/fb88bbf6-b63a-4bcd-b6d5-12e070bca81f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67adf5eb820cbacc4ba4ef3217c1b58b 2x, https://si.imgix.net/fa879cbf/uploads/origins/fb88bbf6-b63a-4bcd-b6d5-12e070bca81f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ca397f7364d53316542727e93f7b8ee 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa879cbf/uploads/origins/fb88bbf6-b63a-4bcd-b6d5-12e070bca81f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcc095c19a5872d1d193691c8ad0809a", "srcset": "https://si.imgix.net/fa879cbf/uploads/origins/fb88bbf6-b63a-4bcd-b6d5-12e070bca81f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcc095c19a5872d1d193691c8ad0809a, https://si.imgix.net/fa879cbf/uploads/origins/fb88bbf6-b63a-4bcd-b6d5-12e070bca81f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2cd9e93ff7cd63b8dadd546247fc0de5 2x, https://si.imgix.net/fa879cbf/uploads/origins/fb88bbf6-b63a-4bcd-b6d5-12e070bca81f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f542cc91c80cc6e473a175f72e488e0 3x"}, "body": "こんばんは、はなむぎ先生。\n以前キャンセルになった漫画の再送になりますがよろしいでしょうか。\n\n学園で一番の美少女が男子とお話してる時に、可愛いおならが「ぷぅ❤」っと出てしまうショート漫画をお願いします。\n\n流れとしては可憐な姿を見せる美少女、片思いをしてる男子がその子に気付く。\n片思いの男子が初めて美少女とお話をしているとき、美少女がうっかりおならをしてしまう。\n美少女は恥ずかしがりながらおならのことを秘密にするように言う。\n片思いの男子はあまり気にしない素振りをするが、心の中ではおならしてる姿がとても可愛いかったと呟く。\n\nという流れになります。\nこちらに資料となる漫画の一例を載せておきますので、\nよろしくお願いします。\n（あくまで目安なので、会話内容等は変更してもOKです）\n\nhttps://drive.google.com/file/d/1tmgvzyOmU50lQRxEAR_9jeNLK1Sd5LxY/view?usp=sharing", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hana_mugi0v0/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3152260, "client_id": 1309040, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74df5dd0/uploads/origins/9e64b418-c4d7-47a3-ba6e-f379f400854c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3afc4bea999f0ca5b1eecd9021bc425a", "srcset": "https://si.imgix.net/74df5dd0/uploads/origins/9e64b418-c4d7-47a3-ba6e-f379f400854c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3afc4bea999f0ca5b1eecd9021bc425a, https://si.imgix.net/74df5dd0/uploads/origins/9e64b418-c4d7-47a3-ba6e-f379f400854c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5b32d58e11574766abee6346c23cfa3 2x, https://si.imgix.net/74df5dd0/uploads/origins/9e64b418-c4d7-47a3-ba6e-f379f400854c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3aaaaaff2eb21bbb131291f8194092b3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74df5dd0/uploads/origins/9e64b418-c4d7-47a3-ba6e-f379f400854c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7bcd6ab3b7a1ee4da1b1a91beab279d", "srcset": "https://si.imgix.net/74df5dd0/uploads/origins/9e64b418-c4d7-47a3-ba6e-f379f400854c?bg=%23f