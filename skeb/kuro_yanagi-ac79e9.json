ve/folders/19_zo9HFwtI_E9Ew6ID3ziu95biPTWZ9d?usp=sharing\n\nもしもご縁がありましたら、どうぞよろしくお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2402213, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "はるあきら", "screen_name": "8ruakira", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-9031c83f-ded7-4532-b13f-2be145d0e29c.png%3Fsensitive%3Dtrue&avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 2647869, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ちしやな@skeb募集中", "screen_name": "cheshirena3", "avatar_url": "https://pbs.twimg.com/profile_images/1939663349748543488/lEoUzNIl.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1579493635195777033/1717033983/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 20, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 2948152, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "いくらおにぎり🍙スケブ始めました", "screen_name": "ikuraonigiri", "avatar_url": "https://pbs.twimg.com/profile_images/1714952165763235840/9YrexAey.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1352887752539291648/1729298283/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 40, "skil