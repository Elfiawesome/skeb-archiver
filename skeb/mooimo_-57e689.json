す。\n\nhttps://sta.sh/2fyugi847h4", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 87027, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ろぴ/ふろっぴ🐎", "screen_name": "ropi_eru", "avatar_url": "https://pbs.twimg.com/profile_images/1917541911352729604/VlsX_DTn.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1527340454873747465/1767482131/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 105538, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "蟹江", "screen_name": "metyayurusu", "avatar_url": "https://pbs.twimg.com/profile_images/1607625673048477697/N-HO6Aj3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1027539084074307584/1751106210/1500x500", "appeal_receivable": false, "popular_creator_rank": 87, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1184160, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "春壱　Haruichi", "screen_name": "haruichithm", "avatar_url": "https://pbs.twimg.com/profile_images/1312986851548905474/k3jKbz1P.jpg", "header_url": "https://pbs.twimg.com/profile_banners/793075324162416640/1717484376/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 153}, {"id": 1564498, "creator": true, "nsfw_acceptable": f