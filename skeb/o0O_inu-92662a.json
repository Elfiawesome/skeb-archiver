set": "https://si.imgix.net/2c530fdb/uploads/origins/397e9358-2e32-4846-b973-071c9b3289f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=506a68ff5245d1e5f8242d02c5084be3, https://si.imgix.net/2c530fdb/uploads/origins/397e9358-2e32-4846-b973-071c9b3289f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9bed154b15fa4d1b57df93fb8f7328e6 2x, https://si.imgix.net/2c530fdb/uploads/origins/397e9358-2e32-4846-b973-071c9b3289f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=699513d16aa56d669f2fd56637224943 3x"}, "body": "初めまして、ユウリさん!アピールありがとうございました!\nアオイとセキを一緒に描いてくれたら嬉しいです!お願いします。\nアオイ（160cm）は現代のパルデア地方出身で、ギンガ団のもとでポケモンずかんを完成させるために働いている若い女性。明るく、活発で、おしゃべりで、遊び好きで、無鉄砲。実際よりも自信たっぷりに振る舞っている。\nセキ（175cm）はいつも彼女を気遣っている。アオイがヒスイでの生活に適応できるように手助けをしてくれた。アオイの偽りの自信を見抜いている。\n二人は異なる時代に属していたから、互いのことがとても気になっていた。その違いが二人の距離を縮めた。二人はお互いを賞賛し、いつかまた時が二人を引き裂くとわかっていながらも、恋に落ちた。\nお好きなように描いてください\nお時間とご配慮に感謝いたします! https://drive.google.com/drive/folders/1bjP0RYR3QoUDloIYtdGs0ejHvrRuO3oN", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@o0O_inu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3708055, "client_id": 474849, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3377f2ce/uploads/origins/935a0248-194c-4fd3-b946-f996d15addfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24ed7bbccb091855db95bd19097b322e", "srcset": "https://si.imgix.net/3377f2ce/uploads/origins/935a0248-194c-4fd3-b946-f996d15addfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24ed7bbccb091855db95bd19097b322e, https://si.imgix.net/3377f2ce/uploads/origins/935a0248-194c-4fd3-b946-f996d15addfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29e7a5b85e47a62bc12cee50e9dad07b 2x, https://si.imgix.net/3377f2ce/uplo