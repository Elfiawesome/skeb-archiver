op&w=200&h=200&s=33f18dba33759f2855c0fd2a984ba67c", "srcset": "https://si.imgix.net/82ec1091/uploads/origins/7751367b-a020-4798-8639-3a2514b8e89a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33f18dba33759f2855c0fd2a984ba67c, https://si.imgix.net/82ec1091/uploads/origins/7751367b-a020-4798-8639-3a2514b8e89a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92d1504df80ff7aeb73135b94ad8e815 2x, https://si.imgix.net/82ec1091/uploads/origins/7751367b-a020-4798-8639-3a2514b8e89a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8128fc8cc93043ec73e09856f4e3248 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82ec1091/uploads/origins/7751367b-a020-4798-8639-3a2514b8e89a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3db29c3e9db9837b5a4680de7f280d1", "srcset": "https://si.imgix.net/82ec1091/uploads/origins/7751367b-a020-4798-8639-3a2514b8e89a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3db29c3e9db9837b5a4680de7f280d1, https://si.imgix.net/82ec1091/uploads/origins/7751367b-a020-4798-8639-3a2514b8e89a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=50451d922434871cc551127712997d8d 2x, https://si.imgix.net/82ec1091/uploads/origins/7751367b-a020-4798-8639-3a2514b8e89a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9564c2195e82f2e5090d167fb1b26500 3x"}, "body": "こんにちは！\n429さんのイラストがとても好きです！もし宜ければ、私のオリジナルキャラクターを描いて頂きたいと思いご依頼させて頂きました。\n\n【设定】\n彼の名前はクルルイン，現代社会の中に生きる先住民です。身長183cm、野獣のような目を持ち、服装や身なりはインディアンスタイルの22歳前後の青年だ。少し鈍いでクールな人です、空気が読めない感じがする。弓狩りや短刀を使う狩猟者である、現代で生き残る術をよく分かっていなかった。魔法は使えるが、獣のような戦い方をする、身体能力が高い。\n彼はかつて、どこかの原始部族の守り神で、長い間、現代文明に侵食されて去った部族の帰還を待っていたのだ。部族には、他の神を飲み込むことで勝利を宣言する伝統がある。だから彼は博物館の中で部族からの品物を見たとき、自分に憑いていた神がもっと巨大な「文明」という神に飲み込まれたと信じていた。部族が戻ってきそうにないことを知り、道に迷った彼は旅に出る。\n\n構図を指定せず、自由に描いてください。キャラの服装などは変更・アレンジしていただいて構いません。\n\n宜しければご検討よろしくお願いいたします。\n\nOC Reference：\nhttps://drive.google.com/drive/folders/1AP5wCGJfV1DfQrDjH0pNdF0bouwvAnKN?usp=sharing\n\nhttps://drive.google.com/drive/folders/1AP5wCGJfV1DfQrDjH0pNdF0bouwvAnKN?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@CowVill/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2663891, "client_id": 2729789, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e1ea275/uploads/origins/06961b92-b2f1-4a3f-8d2b-9ae058ef7576?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7c1fa4a8401706f84ed31b988811b02", "srcset": "https://si.imgix.net/0e1ea275/uploads/origins/06961b92-b2f1-4a3f-8d2b-9ae058ef7576?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7c1fa4a8401706f84ed31b988811b02, https://si.imgix.net/0e1ea275/uploads/origins/06961b92-b2f1-4a3f-8d2b-9ae058ef7576?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=070550b8e78b22af6b54c536fc265c40 2x, https://si.imgix.net/0e1ea275/uploads/origins/06961b92-b2f1-4a3f-8d2b-9ae058ef7576?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b13d89c1c65d115a9bff26cea80fd0b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e1ea275/uploads/origins/06961b92-b2f1-4a3f-8d2b-9ae058ef7576?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2ba6fd04f690087d7ca0f75dfeb22bf", "srcset": "https://si.imgix.net/0e1ea275/uploads/origins/06961b92-b2f1-4a3f-8d2b-9ae058ef7576?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2ba6fd04f690087d7ca0f75dfeb22bf, https://si.imgix.net/0e1ea275/uploads/origins/06961b92-b2f1-4a3f-8d2b-9ae058ef7576?bg=%23fff&auto=format%2Ccompress&fm=webp&d