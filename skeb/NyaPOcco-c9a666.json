imgix.net/51884d0a/uploads/origins/0d769659-f222-41a6-98f3-fc0b1dbfa152?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8c167f14c4a7bf6effbba23da3b15bf2 3x"}, "body": "にゃぽ寿司様はじめまして。\nいつもにゃぽ寿司様のかわいいにゃんぷっぷーのイラストに癒されてます！\n今回Skeb募集されているのを知り、リクエストを送らせていただきました。\n\nリクエスト内容としては、にゃぽ寿司様の絵柄で私のオリジナルキャラクターとにゃんぷっぷーを一緒に描いていただきたいです。\n\nキャラについて\n・灰色のポメラニアン\n・アホ毛と大きなオレンジ色のリボンが特徴\n・素直で元気な子\n\nうちの子の大きさはにゃんぷっぷーと同じくらいの大きさでお願いしたいです。\nまた、にゃぽ寿司様の描くにゃんぷっぷーと食べ物が一緒のイラストが特に好きなので、食べ物と一緒のイラストだと嬉しいですが、にゃぽ寿司様の描きやすい雰囲気、構図のイラストで構いません。\n\nよろしければご検討よろしくお願い致します。\n\nhttps://www.dropbox.com/scl/fo/03cktl1uaaak5eyifyfcp/AEKM4vuok_DChdXpTqn7IG0?rlkey=si78qp3p1dj19rccsz1ee32l2&st=8lkoinot&dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@NyaPOcco/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1931983, "client_id": 3185039, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d86c74fa/uploads/origins/b9784397-4826-41fa-b447-8c6aa8f0a72f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08019ecf19bd904637083dc20c186ad6", "srcset": "https://si.imgix.net/d86c74fa/uploads/origins/b9784397-4826-41fa-b447-8c6aa8f0a72f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08019ecf19bd904637083dc20c186ad6, https://si.imgix.net/d86c74fa/uploads/origins/b9784397-4826-41fa-b447-8c6aa8f0a72f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4dcee3517ce03e971d0ce6c5464bfe84 2x, https://si.imgix.net/d86c74fa/uploads/origins/b9784397-4826-41fa-b447-8c6aa8f0a72f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3bb47b92e41bf03918477895620459a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d86c74fa/uploads/origins/b9784397-4826-41fa-b447-8c6aa8f0a72f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cb42f82cd44c46095ec45f83e8d6447", "srcset": "https://si.imgix.net/d86c74fa/uploads/origins/b9784397-4826-41fa-b447-8c6aa8f0a72f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cb42f82cd44c46095ec45f83e8d6447, https://si.imgix.net/d86c74fa/uploads/origins/b9784397-4826-41fa-b447-8c6aa8f0a72f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=53161c5ba1a35a3199e2aae605e3f9b9 2x, https://si.imgix.net/d86c74fa/uploads/origins/b9784397-4826-41fa-b447-8c6aa8f0a72f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28ce12e4cf373cc41b7acf515760be70 3x"}, "body": "はじめまして。いつもMisskeyでかわいいにゃんぷっぷーを拝見して癒されております。\n……が、ポートフォリオに掲載されている男性のイラストがとても好みだったのでそちら方面でのリクエスト失礼いたします。\n\nリクエスト内容\n当方オリジナルキャラのダナスにノワが絡む退廃的雰囲気で可能ならBLっぽいえっちめな構図のイラストをお願いいたします。\nシチュエーションはお任せいたします。\n衣装設定は2パターンありますがどちらでも結構です。剥いてくださっても結構です。\n\nふたりの関係性(CP的にはノワ攻め、ダナス受けです)\nダナス：ノワに対して存在を認めたくない、直視したくないと思っている。拒否的感情が先に立つ。\nノワ：ダナスの無意識下のインモラルな部分の具現。ダナスに一方的に執着的(加虐的)好意を寄せていて、ダナスを取り込みたいと思っている。\n\n利用目的\n個人的な鑑賞およびSNS(ioまたはdesignの当方アカウント)への掲載\n\n2人分のイラスト依頼になりますので、もし金額が見合わないようでしたら再送依頼いただけると助かります。\nふんわりとした依頼で申し訳ございませんが、ご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://misskey.design/notes/a1fbks16p0v22hpn", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@NyaPOcco/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1931983, "client_id": 644350, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/916c24de/uploads/origins/82e37687-ea75-4cfc-b4e6-2d440a69b7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17d9469c3909fb55bf407acb5ff50cbb", "srcset": "https://si.imgix.net/916c24de/uploads/origins/82e37687-ea75-4cfc-b4e6-2d440a69b7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17d9469c3909fb55bf407acb5ff50cbb, https://si.imgix.net/916c24de/uploads/origins/82e37687-ea75-4cfc-b4e6-2d440a69b7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e5e8ba3e95d9fc6446e5a7aca02ead0 2x, https://si.imgix.net/916c24de/uploads/origins/82e37687-ea75-4cfc-b4e6-2d440a69b7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08df16ff40e737f26e15439bd40a3214 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/916c24de/uploads/origins/82e37687-ea75-4cfc-b4e6-2d440a69b7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=346ba2f756708aa75db16899edf7a36e", "srcset": "https://si.imgix.net/916c24de/uploads/origins/82e37687-ea75-4cfc-b4e6-2d440a69b7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=346ba2f756708aa75db16899edf7a36e, https://si.imgix.net/916c24de/uploads/origins/82e37687-ea75-4cfc-b4e6-2d440a69b7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2f47e5610247ac62f67943a2eb851e62 2x, https://si.imgix.net/916c24de/uploads/origins/82e37687-ea75-4cfc-b4e6-2d440a69b7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4c958e771f09988ac88b2a393d4f60a5 3x"}, "body": "こんにちは！\nあなたの絵が好きです！\nストリートファイターのキャラクターの描き方がとても好きです！\n私のオリジナルキャラクターをリクエストしたいです。\nhttps://www.deviantart.com/stash/2kwfl6tx8tr\n\n僕のキャラクターは格闘家です。強くて筋肉質な体をしています。\n日焼けした肌、明るいブロンドの髪、マゼンタの目（赤ではない）。\n陽気でエネルギッシュ。\n大柄で筋肉質。\n胸と腕に茶色のタトゥーがある。\n彼のタトゥーの透明コピーを参考文献に掲載した。\n\n性格はルークに似ている。\n彼の胸や腕などの筋肉をきれいに見せてほしい。\n彼のシャツはタイトなので、大胸筋と腹筋が見えます。\nポーズは自由です！\n\n可能であれば、背景透過バージョンもお願いします。\nありがとうございました！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@NyaPOcco/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1931983, "client_id": 702072, "vtt_url": null, "thumbnai