gix.net/86567507/uploads/origins/13cf3da8-88f1-487c-baf7-4115a47509b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b8395ea73c48c1e62112d6a5efef9ea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86567507/uploads/origins/13cf3da8-88f1-487c-baf7-4115a47509b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4832f0bc59258ae0bd0d3c92f438b076", "srcset": "https://si.imgix.net/86567507/uploads/origins/13cf3da8-88f1-487c-baf7-4115a47509b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4832f0bc59258ae0bd0d3c92f438b076, https://si.imgix.net/86567507/uploads/origins/13cf3da8-88f1-487c-baf7-4115a47509b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=69f73c77b7899c206b4761c1b86ecb52 2x, https://si.imgix.net/86567507/uploads/origins/13cf3da8-88f1-487c-baf7-4115a47509b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0f9aef167ded73a90a908e9a0169d650 3x"}, "body": "こんにちは！\nあなたの「けものフレンド」の作品が大好きです。\n\nオーバーサイズのセーターを着てベッドの上でくつろいでいるジャパニーズ・ウルフのアートワークをお願いしたいです。\nジャパニーズ・ウルフは最初、ベッドの布団の中で丸くなって安らかに眠っているはずです。\nジャパニーズ・ウルフは、見る人が入ってくるのを聞き、興奮して目を覚まし、寄り添いたがります。\nジャパニーズ・ウルフの髪は寝ていたせいで少し乱れているが、視聴者に会えて嬉しいだけなので気にしない。\nジャパニーズ・ウルフの体型は、セーターが背中をきれいに包み込み、尻尾が背中を持ち上げているようなボリュームのある体型がいい。\n全体的に、ジャパニーズ・ウルフはキュートでハッピーで、見る人に寄り添ってフレンドリーであるべきです。\nそれ以外はお任せします！\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1eu9pXkxx1eYQgpN_yBmZmIE6bxGyYW8b?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@930tanaka/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2045168, "client_id": 103242, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7966f16d/uploads/origins/f25cd0a2-f1e1-4a2a-84be-404f19212710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbb4afcda6bcae35d6e207e2d41cb634", "srcset": "https://si.imgix.net/7966f16d/uploads/origins/f25cd0a2-f1e1-4a2a-84be-404f19212710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbb4afcda6bcae35d6e207e2d41cb634, https://si.imgix.net/7966f16d/uploads/origins/f25cd0a2-f1e1-4a2a-84be-404f19212710?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=767d239510105ce9bbfb137157a226e0 2x, https://si.imgix.net/7966f16d/uploads/origins/f25cd0a2-f1e1-4a2a-84be-404f19212710?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb2bc98d37c603ff6d1ce5e102ad6900 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7966f16d/uploads/origins/f25cd0a2-f1e1-4a2a-84be-404f19212710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c79056b280aa7a7474696c260743996d", "srcset": "https://si.imgix.net/7966f16d/uploads/origins/f25cd0a2-f1e1-4a2a-84be-404f19212710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c79056b280aa7a7474696c260743996d, https://si.imgix.net/7966f16d/uploads/origins/f25cd0a2-f1e1-4a2a-84be-404f19212710?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=770f36d9892b2b4f121a2fb9aba79fd1 2x, https://si.imgix.net/7966f16d/uploads/origins/f25cd0a2-f1e1-4a2a-84be-404f19212710?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=50b17892cc46004e1235cd933735d7e9 3x"}, "body": "Hello!\nI would like to see a cute image of ヘラジカ from けものフレンズ.\nIn this image, I would like to see a version of her that looks more like a disheveled NEET (引きこもり) instead of her usual tough and confident self. As moose build up fat and reduce their activity to survive during the winter. Because of that behavioral trait in her species, think it would be fitting to see a version of ヘラジカ depicted in this way.\nDue to her altered behavior and extra body fat, ヘラジカ should be depicted with a slightly bigger chest, soft tummy and plumper thighs. \nhttps://x.com/nia4294/status/1527333000748617728\nhttps://x.com/Victim_Girls/status/1764233329912791043\nIn addition, her hair should look messy and disheveled, as though she hasn't cared for it in some time. Something similar to a character such as Pokemon's Hex Maniac (オカルトマニア) or the vtuber Menace Mamaki (https://x.com/menmakii/status/1782993242381799906) would feel fitting, although you are free to change this however you think would fit best.\nFor the situation, I would like to see something cute that matches how she has changed, making it seem as though she has been relying on the viewer for care for the winter. \nA background with a comfortable looking house or cabin with a fireplace would be fitting, similar to the following references.\nhttps://x.com/past_desiderium/status/1866212838592618640\nhttps://www.pixiv.net/en/artworks/125524262\nThe specifics of this situation are up to you.\nAdditionally, as moose lose their antlers during the late winter I would love to see a variant where she has no antlers.\nAny other details such as her outfit and expression are up to you.\nThank you!", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@930tanaka/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2045168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/880a0de8/uploads/origins/e10d69eb-a5ba-461d-a307-eed1cca3b8f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=247f13941af1612f56ea487d8ac587e8", "srcset": "https://si.imgix.net/880a0de8/uploads/origins/e10d69eb-a5ba-461d-a307-eed1cca3b8f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=247f13941af1612f56ea487d8ac587e8, https://si.imgix.net/880a0de8/uploads/origins/e1