す。もし予算内であれば表情差分いただけると嬉しいです！\n\n資料としてHPとYouTubeCHのURLを添付します。\nHPには三面図や詳細が記載してあります。\nHP：https://lit.link/misorasora\nCH：https://youtube.com/@misorasoraCH\n\n受けて頂けるとありがたいです。\nよろしくお願いします。\n(イラスト内に私の名前の記載は一切必要ありません)", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 5374, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "いーたん＆mikokoたん", "screen_name": "mikoko1", "avatar_url": "https://pbs.twimg.com/profile_images/1610031912646750209/1qqEk7cE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/106337453/1782415977/1500x500", "appeal_receivable": false, "popular_creator_rank": 76, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 285802, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Darjeeling@Skeb募集中", "screen_name": "xdarjeelingxtea", "avatar_url": "https://pbs.twimg.com/profile_images/1587012861372473344/ZNVDbJWg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3151075550/1606468000/1500x500", "appeal_receivable": false, "popular_creator_rank": 61, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 1946876, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "たじまも🦎", "screen_name": "art_Tajimamo", "avatar_url": "https://pbs.twimg.com/profile_images/1470357612793266177/uL6JerVq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1174515218182836224/1675943926/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "ac