t%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=06b93bdb45c3953516fa12cf088fc9bc 2x, https://si.imgix.net/dbb4e948/uploads/origins/6bbe3acf-7605-4423-a7df-8059ac0e367e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d8a9964705d8bd5bbe5ecd93578e289 3x"}, "body": "こんにちは。\nいつも素敵な絵とツイートを楽しんで拝見しております。\n\n☁️人物☁️\n黒髪細身の男の子\nおとなしい感じでお願いしたいです。\n\n☁️服装☁️\nたくさんのフリルのある甘ロリィタフル装備\n色はピンクか水色か白を希望したいです…\n肌の露出は少ない方が良いです。\n\n☁️表情☁️ \n男の子は自ら着たわけではない、無表情やムスッとした顔、照れている顔などなんでもいいのですが、にっこり笑っていないでほしいです。\n\nかまぼこビール園さんの絵柄も塗りも世界観もだいすきなので、この絵にこれは違うやろと思ったらリクエスト無視してくださっても大丈夫です。(黒髪男の子ロリィタというところだけ残していただければ………)\nその他ポーズ、構図などはお任せします。フル装備と書きましたが頭のてっぺんから足の先まで見えてなくて構いません。\n\nおおまかなリクエストで申し訳ないのですが、かまぼこビール園さんの大大大ふぁんですので正直なにがきても嬉しいです。気長に待てますので、お体にはお気をつけてご自分のペースでゆっくりで大丈夫です。\nよろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 374052, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "呉晴", "screen_name": "kureha___", "avatar_url": "https://pbs.twimg.com/profile_images/1313129577477152768/zrWc3OVM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2992207080/1708715702/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 17}, {"id": 635929, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "よな@(ง˙∇˙)ว", "screen_name": "Yonah0310", "avatar_url": "https://pbs.twimg.com/profile_images/1972306772246573056/T_JwOC4x.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2514841440/1773308777/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3