ネイルに使用することがあるため、頭部が切れていないキャラクターのみの透過データ(もしくはPSD)をいただけますと幸いです。  \n\n参考資料  \n＊髪は寒色の銀髪というより、あたたかみのある白髪寄りです。 \n＊ハイライトがオーロラになっており、前髪の毛先のみ、ほんのり桃色です。 \n＊左目下に泣きぼくろがあります。\n 資料URL https://x.com/naginomashiro/status/1637021974051553280?s=46&t=mWnS0E4C7RIzyxqDj7eHuA  \n\nご検討いただけますと幸いです。 よろしくお願いいたします。\n\nhttps://x.com/nagino_mashiro/status/1822922882663735808?s=46&t=mWnS0E4C7RIzyxqDj7eHuA", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@chitosemoon/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 890508, "client_id": 2918397, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21e04165/uploads/origins/947fa26b-69c0-41d2-b341-de458e52d7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90e5017a9947564d6a4a439681fb99b3", "srcset": "https://si.imgix.net/21e04165/uploads/origins/947fa26b-69c0-41d2-b341-de458e52d7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90e5017a9947564d6a4a439681fb99b3, https://si.imgix.net/21e04165/uploads/origins/947fa26b-69c0-41d2-b341-de458e52d7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fa70dcc8d07f89bc34e8559d245a277 2x, https://si.imgix.net/21e04165/uploads/origins/947fa26b-69c0-41d2-b341-de458e52d7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39aec0c61b0310a58242acd14549c696 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21e04165/uploads/origins/947fa26b-69c0-41d2-b341-de458e52d7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c503cc19f3e983b148d86c3c643e4406", "srcset": "https://si.imgix.net/21e04165/uploads/origins/947fa26b-69c0-41d2-b341-de458e52d7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c503cc19f3e983b148d86c3c643e4406, https://si.imgi