ab8-88fd-5e0abdfb8f12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4f784422f1ee5647e6fccc71fe91e90 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed5ee769/uploads/origins/1a0ac046-7e47-4ab8-88fd-5e0abdfb8f12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ea4789eda7c4b798f4c7d222e4a4a1e", "srcset": "https://si.imgix.net/ed5ee769/uploads/origins/1a0ac046-7e47-4ab8-88fd-5e0abdfb8f12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ea4789eda7c4b798f4c7d222e4a4a1e, https://si.imgix.net/ed5ee769/uploads/origins/1a0ac046-7e47-4ab8-88fd-5e0abdfb8f12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3df38aec57491c044e59b39788093da4 2x, https://si.imgix.net/ed5ee769/uploads/origins/1a0ac046-7e47-4ab8-88fd-5e0abdfb8f12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=83ffa01d0133baaba262c38f11a40366 3x"}, "body": "こんにちは、ツイートを拝見しました。\nご迷惑をおかけして本当に申し訳ありません。\n登場人物を私のオリジナルキャラに置き換えてもよろしいでしょうか？\nたぶん、黒髪で瞳孔が黒くて、かわいい体型の大人の女の子です（耳と尻尾も黒です）。\nただ、今はこのキャラクターについてのスケッチが一枚しかないので、もしよければ参考にしてください。https://ibb.co/HzjzN94 (R18)\nありがとうございました。\n\n\n元のリクエストはこちら\n--------------------------------------------------\n\nはじめまして！あなたの作品がとても好きです！誘拐犯と一緒に暮らすというアイデアは本当に素晴らしいです！\n\nもしよろしければ、以下のシーンをあなたの絵で表現していただけませんか？\n\n\n\"一杯の時間だ\"、私はそっとドアを押し開け、彼女のところへ歩み寄り、屈んだ。\n私が誘拐した少女は床にきれいに座っている。\n彼女を家に拉致してからすでに2日目、彼女の服は昨夜の風呂で便宜上すべて脱がされている。ガーゼをゆるく巻いたものを胸に数枚巻いて隠しているほかは、彼女はもうほとんど裸だった。\n彼女の裸体は、上半身から脚、つま先まで麻ひもできつく縛られていた。少女の両腕も背中の後ろで「X」字型に縛られ、私は彼女の繊細な両手をガムテープできつく巻いていた。\n首に巻かれた首輪と背後の壁に縛られた鎖は少女の可動域をしっかりと制限し、大腿骨の間もロープで絞められ、おもちゃが詰め込まれていた。\n\"うっ......\"この時点で少女は、玩具によってもたらされる絶え間ないオーガズムに苦しめられていたが、体を少し動かすだけで、ヒモからの刺激が続き、後ろ手にきつく縛られた手で玩具のスイッチを切るまでもなかった。口を塞ぐ布とテープは、少女が外界に助けを求める可能性を断ち切った。\n\"おぉーーーー！！\"私がドアを押し込むのを見たとき、彼女は実際にわずかな期待の表情を見せ、縛られた両足は私の方に傾き、目は一瞬私を見て、次に彼女の太ももに固定されたおもちゃのスイッチを見、彼女の小さな口は常にぼんやりとかわいい音を発していた。おそらく、おもちゃのスイッチを切ってほしいという意味だろう。\n「いい子ね」私は彼女の頭を撫でると、彼女は従順に座って動きを止めた。「後で水を飲ませるから、大声を出しても責任は取らないよ」首に巻かれた鎖がガチャガチャと音を立てながら、彼女は力なく頷くしかなかった。\n彼女の確認を取った後、私は彼女の顔を包み、口から箝口テープを慎重に引き剥がした。彼女は従順に舌を轡の布に対して前に出し、私は優しく引っ張って少女の口を自由に戻した。\"エヘン......\"彼女は乾いた咳を2、3回した。弄ばれた紐の間から、まだ喘いでいる玩具の一部で新鮮な空気を吸おうとする、ちょっとエロティックな努力だった。私は飲み水のボトルのキャップを外し、彼女の口に飲ませる準備をしながら、少しエロティックな光を目にたたえた。\n\"やめて......\"さっきまで私に従順だった少女は、今では私の手から小さな顔を離そうと必死だった。オモチャに苦しめられながら、彼女は息を吹き返そうと必死だった。「オモチャを......。おもちゃを....しばらくの間、スイッチを切って......」。飲み物をのどに詰まらせるのが心配だから、飲み終えてから開けてもいいんだよ」。\n私はうなずき、ボトルを彼女の口に運び続け、もう片方の手は彼女の太ももの付け根に移動し、おもちゃのスイッチを切った。\nあまりに長い間連続して発情していたため、よほど喉が渇いていたのだろう、私がとりあえず玩具のスイッチを切ると、少女はしゃべるのをやめ、ただ頭を上げてボトルの口を持ち、水を大きく一気飲みした。\n\"はあ......\"少女は十分に水分を補給したのだろう、小さな口でボトルの口を離した。私が咄嗟に反応したにもかかわらず、水の一部は少女の胸に巻かれたガーゼの上にこぼれてしまった。彼女はほとんど裸だったが、それでも少し濡れたガーゼに包まれた胸はより魅力的に見えた。\n「水筒を片付けると、もう一枚のきれいな白い布を手に取り、クシャクシャに丸めて、少女の頬をつまんで口に詰め込む準備をした。「声を出さないよ．お願い．うっ......\"慈悲を求める彼女の嘆願を無視し、私は彼女の声を出す権利を一切剥奪してから、新しいガムテープを裂き、彼女の唇に2、3本の線をきれいにつけた。\n「ああ、ああ......」。私はロープで縛られた彼女の胸を愛撫し、彼女の素晴らしい呻き声を再認識した。猿ぐつわがきちんとできたのを確認したあと、私は彼女の太ももの付け根に固定されたおもちゃのスイッチに手を移した。\"うー！うーーーーーん！\"私の動きが何を伝えているのかよくわかっているのか、彼女は恐怖におののきながら私を見つめ、否定の意を伝えようと髪を頭で前後に揺らしながら懇願した。「楽しみにしているようだね」私は彼女の頭を撫でながら邪悪な笑みを浮かべ、おもちゃのスイッチを入れ直すと、部屋を出ようとした。\n少女を一人部屋に残し、彼女の無力で絶望的な闘いを続けた。\n\n\n\nすべての部分を見せる必要はない。あなたがより興味深いと思うショットを描くだけでいい。\n\n最後に、もし可能なら、より強い緊縛を実現するためにロープをもっと使ってください。\n\n翻訳によって、私の考えがあなたに伝わることを願っています。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yamashitatokase/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2809794, "client_id": 43201, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/467b66a2/uploads/origins/a3ee850b-de80-4ecc-a99c-8704358529c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62a838df875ec875685b44eee41230d8", "srcset": "https://si.imgix.net/467b66a2/uploads/origins/a3ee850b-de80-4ecc-a99c-8704358529c8?bg=%23fff