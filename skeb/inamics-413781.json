client_id": 1182625, "nc": 185}, {"path": "/@inamics/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2601049, "client_id": 55564, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c62321c2/uploads/origins/50c9b2b2-cc40-4a19-b2a1-100c19553881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b85a4011811a2af36b9c03d7c7db8e6", "srcset": "https://si.imgix.net/c62321c2/uploads/origins/50c9b2b2-cc40-4a19-b2a1-100c19553881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b85a4011811a2af36b9c03d7c7db8e6, https://si.imgix.net/c62321c2/uploads/origins/50c9b2b2-cc40-4a19-b2a1-100c19553881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b38fb0835114f6bddfb4c0048aef603 2x, https://si.imgix.net/c62321c2/uploads/origins/50c9b2b2-cc40-4a19-b2a1-100c19553881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f1525ec354fa89a4af134035f3747d6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c62321c2/uploads/origins/50c9b2b2-cc40-4a19-b2a1-100c19553881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b16cdcc8d408a6a430c55c862e127857", "srcset": "https://si.imgix.net/c62321c2/uploads/origins/50c9b2b2-cc40-4a19-b2a1-100c19553881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b16cdcc8d408a6a430c55c862e127857, https://si.imgix.net/c62321c2/uploads/origins/50c9b2b2-cc40-4a19-b2a1-100c19553881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=87ad39c51a9a656e47e8cdfaa832bc2a 2x, https://si.imgix.net/c62321c2/uploads/origins/50c9b2b2-cc40-4a19-b2a1-100c19553881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d4d1cde2026fefd50528f640da24f6ce 3x"}, "body": "リクエストの再会お待ちしておりました！\n今回も、以前描いていただいたOC「鳥羽そら」くんのイラストをお願いします！\n\n\n⬛︎リクエスト内容\n・大人になり初夜を迎えたそらくんとさなちゃんの夫婦の営みを描いて頂きたいです\n・2人とも元のキャラデザよりも大人っぽく成長させてください\n\n・可能であれば、初夜前後の結婚式や出産後の描写もお願いしたいです\n文字によるモノローグでも大丈夫です\n\n\n⬛︎シチュエーション\n・現在の時間軸（そらくん 高2）から10年後…。\nそらくんと彼女のさなちゃんが結婚することになり、2人の結婚式に呼ばれることになった俺くん。\n誓いのキスをしたり現在の夫婦生活について楽しそうに話す仲睦まじそうな2人の様子を見て、そらにホモ片思いをしていた俺くんは激しい嫉妬と絶望を感じるも、そらの幸せを願って御祝儀を渡し式場を後にする…。\n\n結婚式の後…。\n二人で暮らす新居に戻ったそらくんとさなちゃんは「夫婦としての子作りの気分を盛り上げる」という名目のもと、たまたま手に取った俺くんの御祝儀を使ってエログッズを買い、子供を作るべく夫婦の営みに勤しむ…。\n\n※たまたま手に取った御祝儀が俺くんの物だっただけで悪意などは一切無い。\n\nエログッズのおかげか、仕事終わりに毎晩子作りすることになりすぐに懐妊。\nしばらくして、そらくんそっくりの第1子「鳥羽あお」が産まれる。\n\n結婚式から数年後、相変わらず実家の子供部屋でそらシコに励む俺くんの元に、子供を連れたそらくん夫婦が訪れる…。\n\n\n\n⬛︎キャラデザ\n2人とも少し背を伸ばし、大人っぽい雰囲気にして欲しいです\n\n○鳥羽そら\n・多少大人っぽくはなったものの顔は可愛い女顔\n・身長が少し伸びた（160cm後半〜170前半程度）\n・体つきはより大人の男性らしくガタイが良くなり筋肉質に\n・陰毛も大人らしく濃いめ\n・胸毛は無し（脇毛 すね毛はお好みで）\n\n○山田さな→鳥羽さな\n・髪型…大人っぽいものに変更をお願いします 髪を染めるかどうかはおまかせします\n・体つき…今のまま成長したスレンダー体型 or 大人っぽいややグラマラスな体型\n・大人らしく化粧をしている\n\n\n⬛︎衣装\n子作りの気分を盛り上げる為に買ったグッズとして、エロ衣装を着せてください\n・さなちゃんには花嫁らしく「生き恥ウエディング」を着せてあげてください\n大人になったそらくんにも似合いそうなエロ衣装があれば着せてあげてください\n\nhttps://www.dropbox.com/scl/fo/cg4bsfzpoo2bia5zc4hl2/AILNPXFJ9Q9U-GSc4hGiOVc?rlkey=qm1r9m10b0bu1cl7v10s12tbp&st=fxn7a1jz&dl=0", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inamics/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2601049, "client_id": 570593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3d79ce2/uploads/origins/9eb46a02-0c55-4f4a-b9e5-0d012cf45313?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e62baf9b144bf58fc53adf870c54454", "srcset": "https://si.imgix.net/e3d79ce2/uploads/origins/9eb46a02-0c55-4f4a-b9e5-0d012cf45313?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e62baf9b144bf58fc53adf870c54454, https://si.imgix.net/e3d79ce2/uploads/origins/9eb46a02-0c55-4f4a-b9e5-0d012cf45313?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=