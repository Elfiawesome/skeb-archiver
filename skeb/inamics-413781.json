mat%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9f65331885d667879dc28725edc1711 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f24b57f/uploads/origins/1116d3ae-51c3-4a99-a0e4-4e730c5cd78f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fbb10f6082232444185dd2b2ce93988", "srcset": "https://si.imgix.net/4f24b57f/uploads/origins/1116d3ae-51c3-4a99-a0e4-4e730c5cd78f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fbb10f6082232444185dd2b2ce93988, https://si.imgix.net/4f24b57f/uploads/origins/1116d3ae-51c3-4a99-a0e4-4e730c5cd78f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eca1ee4f4cc53b0790b152fcf59a0272 2x, https://si.imgix.net/4f24b57f/uploads/origins/1116d3ae-51c3-4a99-a0e4-4e730c5cd78f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69dd511634ec3731aec37ed9d44fada3 3x"}, "body": "伊奈見先生、こんにちは！\nXで先生が最近Skebのリクエスト募集をされているポストを拝見しました！まだ間に合うかどうか分かりませんが、もし可能でしたらぜひ私のリクエストをお受けいただけないでしょうか😭\n\n以前先生がパーミャチ・メルクーリヤのイラストを投稿されていたのを拝見し、ぜひもう一度彼女を描いていただけないかと思い、依頼させていただきました💦\n\nこちらのイラストでクーちゃんに着せたい衣装は以下の通りです：\nhttps://x.com/SQEX_GAMEGUIDE/status/1450733991875670017?s=20\nhttps://x.com/Byul_zzi/status/1254811687049297924?s=20\nhttps://www.pixiv.net/artworks/96286790\n\n背景についてですが、こちらの（https://cdn.donmai.us/sample/17/53/__manjuu_and_pamiat_merkuria_azur_lane_drawn_by_byulzzi__sample-1753a6e75dbda72d0d9cde5dc22105e8.jpg）背景にクーちゃんを配置していただき、可愛らしい表情で画面中央を見つめるようなイメージにしていただければと思います。具体的なポーズは先生のお好きなように自由に描いていただいて大丈夫です！\n\nセリフや表情の差分など、先生のご判断で自由にアレンジしていただいても全く問題ありません。すべて先生のお気持ちの赴くままにお任せします！\n\nよろしくお願いいたします！\n…………………………\n伊奈見老师您好，我看到了老师您最近在x上的skeb委托招募的贴文！不知道还来不来得及赶上，总而言之如果可以的话希望您能接下我的委托😭\n\n我看见老师以前有投稿过水星纪念的插图，所以想着您是否能再一次画一画她呢💦\n\n这是我希望插画中水星纪念穿着的服装：https://x.com/SQEX_GAMEGUIDE/status/1450733991875670017?s=20\nhttps://x.com/Byul_zzi/status/1254811687049297924?s=20\nhttps://www.pixiv.net/artworks/96286790\n\n背景上，我希望水星纪念置身于（https://cdn.donmai.us/sample/17/53/__manjuu_and_pamiat_merkuria_azur_lane_drawn_by_byulzzi__sample-1753a6e75dbda72d0d9cde5dc22105e8.jpg）这件服装的背景中，用可爱的眼神看向画面中心，具体是什么姿势由您自身心情发挥即可！\n您也可以自由发挥加上台词和表情差分什么的，一切都取决于您！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inamics/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2601049, "client_id": 1806115, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b19b7b9/uploads/origins/d5e1feb6-4df7-4887-93ea-97beea65374f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0dd51e3f9b64387368f5ba688bd725a", "srcset": "https://si.imgix.net/7b19b7b9/uploads/origins/d5e1feb6-4df7-4887-93ea-97beea65374f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0dd51e3f9b64387368f5ba688bd725a, https://si.imgix.net/7b19b7b9/uploads/origins/d5e1feb6-4df7-4887-93ea-97beea65374f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc3e53eff2ed929a4a959ac8a41bbbfe 2x, https://si.imgix.net/7b19b7b9/uploads/origins/d5e1feb6-4df7-4887-93ea-97beea65374f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16814fc052d9f0ad2567218ea8b9e5a9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b19b7b9/uploads/origins/d5e1feb6-4df7-4887-93ea-97beea65374f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c558283dd828b21e7a7a7dcf265699e", "srcset": "https://si.imgix.net/7b19b7b9/uploads/origins/d5e1feb6-4df7-4887-93ea-97beea65374f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c558283dd828b21e7a7a7dcf265699e, https://si.imgix.net/7b19b7b9/uploads/origins/d5e1feb6-4df7-4887-93ea-97beea65374f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=cr