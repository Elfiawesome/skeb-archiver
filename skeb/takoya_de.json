a74e-fcf7812f795e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c776f9798fbfaceddac91bd0587bce6d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c90c7106/uploads/origins/f6cac1e8-70c1-46d9-a74e-fcf7812f795e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f230b631b5149d41df5b7de63efdf6f", "src_set": ""}, "body": "前回（https://skeb.jp/@takoya_de/works/76）はありがとうございました。今回は、前回の作品をベースにして、また違った作品をみたいと思い依頼させて頂きます。\n\n前回描いて頂いた作品の、人間の女の子verがみたいです。神話感や艶っぽさを抑えた感じで、普通の（？）女の子って感じが希望です。イメージとしては、下記リンク先が近いです。\n\nhttps://skeb.jp/@takoya_de/works/77　←星のマーク入りで大きな目がかわいい。\nhttps://x.com/takoya_de/status/1768302630793851261　←かわいい。（エラーくんとビスキちゃん…）\n\n直接的な要素でなくて構いませんので、星・海・愛のモチーフはどこかに入れてもらえるとありがたいです（難しければ大丈夫です）。\n添付したURL先の作品のように、目の中にマーク（？）を入れてもらえると嬉しいです。\n髪型はツインテールでお願いします。\n色は前回描いて頂いた作品のものと同じでも、作品に合わせて変更していただいても構いません。構図・ポーズ・服装などもお任せします。\n\n使用用途は、各SNSや個人サイトのアイコン・ヘッダー・ほかの絵師様への参考資料などです。ご検討よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takoya_de/works/80", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1260954, "client_id": 326249, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44e2e6d9/uploads/origins/051259e8-83ba-46d8-8b7d-ebf4c4c287c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af985aeb8ee3905971767f5a2ee39ad9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44e2e6d9/uploads/origins/051259e8-83ba-46d8-8b7d-ebf4c4c287c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e37f6ae1a72a0db5026ae250285f5e77", "src_set": ""}, "body": "ω・)こんばんは先生！リクエスト受付開始してたんですね！今見ました！\n\nまた新しい衣装のイヌホウズキをリクエストしてもいいですか？\n\n舞台はファンタジーの世界です。   \n\nイヌホウズキ：黒髪で猫のような目をした17歳の美少年。身長175cm。幻術を使う若き魔道士。性格は皮肉屋で皮肉屋、他人の愚かさをからかう。人を信用しない。   \n\n*爪も黒く塗られている。目の下は金色（顔もURLの中にあります）。URLの「衣装1」を着て描いてください。\n\nお好きなように描いてください！\nいつもありがとうございます＞＜❤️。\n\nhttps://drive.google.com/drive/folders/1-6lVJkRs96dLhm03JckDYuwBsyCVMvlx", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takoya_de/works/79", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1260954, "client_id": 326249, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6fff0d1/uploads/origins/34ada6ae-d7c8-46f8-8f38-ddc4b303e8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecdf6b8133ea8ecd1d93c8c22d8c81d4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6fff0d1/uploads/origins/34ada6ae-d7c8-46f8-8f38-ddc4b303e8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e93514c2406f8fcd8c07643b81247ca1", "src_set": ""}, "body": "先生、こんにちは！\n\n一度に2つもリクエストを送ってしまって申し訳ないのですが、エトワールも新しい服を着ているので、ぜひ描いてほしいです！（笑）！\n\n<エトワール>です：エレガントで高慢な妖精。性別は男：男性。翼の生えた耳、猫のような目、鋭い歯を持つ16、17歳の美少年のような外見。身長は175cm。自由に旅ができる破滅の妖精とは異なり、彼のような普通の妖精は生まれてから死ぬまで妖精界に留まることになっている。しかしエトワールは、傲慢なオーラをまといながらも、外の世界への好奇心を抑えられない。実は赤面しやすいツンデレで、根は純粋。自然との対話が得意で、金糸で縫う癒しの魔法を使う。\n\n*エトワールのまつげは髪と同じ色。瞳はアパタイトの石の色（URLにアパタイトの画像があります）。鼻に薄いそばかすがある。  URLにある「衣装1」と書かれた衣装を着て描いてください。\n\n\n自由に描いてください！\n先生、この妖精もよろしくお願いします🧚✨。\n\nhttps://drive.google.com/drive/folders/10fAVDbONrBSKUdR2S0-vwjwIprQEkmbd", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takoya_de/works/78", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1260954, "client_id": 2379428, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9322e97b/uploads/origins/de93817a-bc57-4d4c-a605-cff759dc6175?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71783d2792c5d253debeff609baef815", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9322e97b/uploads/origins/de93817a-bc57-4d4c-a605-cff759dc6175?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01cbc78f96c26f0c4432b20751ba4776", "src_set": ""}, "body": "初めまして！蛸屋様の描く動物のイラストがかわいくて大好きなので、私と友人のTRPGのキャラクターを擬獣化して描いていただくことはできませんでしょうか？\n\n①男性 \n26歳 182cm ピンク髪、褐色、たれ目\n飄々としていてノリが軽い。\n②の反応が面白くてよくからかっているが本心ではとても大切な存在で離れがたく思っている。\n最近恋心だと気づいた。激重感情。\n(肩のタトゥーはハートであれば簡略可)\n\n②女性 \n22歳 142cm\n緑髪縦ロール、釣り目、ロリータ服のお嬢様\n気が強くてプライドが高いけど意外と素直。子供扱いされると怒る。やきもち焼き。\n①のことは大切な存在で、いなくならないてほしい。\n\n些細なことでよく喧嘩（①が②をからかって②が怒る）をしているが互いに様々な理由から離れがたく、大切に想い合う、車で旅を続けている共依存無自覚片思い凸凹いちゃいちゃ喫煙者コンビです。どちらもネコ科のイメージですか、②はふわふわくるくるの猫、①は大きめのネコ科の動物(ライオン、サーバル、ヒョウなど。お任せします。)\n\n使用用途としては、基本的に鑑賞、SNSでのアイコンやヘッダーでの利用等を目的としていますが、可能であれば非営利目的でネップリ、アクキーやアクスタ等のグッズ作成も検討しております。\nぜひよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1vtVjrMQk-zC70GrWd2Wq58gUAmBzR7sA?usp=sharing", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takoya_de/works/77", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1260954, "client_id": 3171702, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31f741b3/uploads/origins/3e0aaaf6-d513-45ba-843d-a55c4a8e917a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3757a425caf59da0a7baf29aaef9f70e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31f741b3/uploads/origins/3e0aaaf6-d513-45ba-843d-a55c4a8e917a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=364d193cb961d54e51fdc1c2dd19f4f0", "src_set": ""}, "body": "こんにちは、TAKOYA_DEさん、\n\nあなたのイラストが大好きです。私のOCに新しい服を着せて描いていただけるとありがたいです。\n\nポーズやシーンは自由に遊べます。\n髪型は3種類あるので、好きなのを選