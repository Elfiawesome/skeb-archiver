ん）\n恐れ入りますが背景透過バージョンのファイルも頂けたら嬉しいです。\n\nご検討いただけますと幸いです。\nどうぞ宜しくお願いいたします！", "nc": 145, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@akahara_mory/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2807963, "client_id": 1316738, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e3b985c/uploads/origins/1a74c4d5-471b-4bf8-ae31-fbcc3e61b563?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7c4a45b4780e1556b717720fc93f361a", "srcset": "https://si.imgix.net/3e3b985c/uploads/origins/1a74c4d5-471b-4bf8-ae31-fbcc3e61b563?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7c4a45b4780e1556b717720fc93f361a, https://si.imgix.net/3e3b985c/uploads/origins/1a74c4d5-471b-4bf8-ae31-fbcc3e61b563?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=4935b6caeb1b6e83a221a3bcdff30412 2x, https://si.imgix.net/3e3b985c/uploads/origins/1a74c4d5-471b-4bf8-ae31-fbcc3e61b563?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bfa608c117b8c842ee967ee74300dfb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e3b985c/uploads/origins/1a74c4d5-471b-4bf8-ae31-fbcc3e61b563?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=af8274c5e3d37b450b722da2c045d4c7", "srcset": "https://si.imgix.net/3e3b985c/uploads/origins/1a74c4d5-471b-4bf8-ae31-fbcc3e61b563?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=af8274c5e3d37b450b722da2c045d4c7, https://si.imgix.net/3e3b985c/uploads/origins/1a74c4d5-471b-4bf8-ae31-fbcc3e61b563?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=361f4081de28f928964893f8918ebb59 2x, https://si.imgix.net/3e3b985c/uploads/origins/1a74c4d5-471b-4bf8-ae31-fbcc3e61b563?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d8cd036998