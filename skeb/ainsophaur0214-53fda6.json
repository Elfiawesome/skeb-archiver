52666-8eac-4686-978d-d3da8c8673fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=017f92b6de4f219a3d351dd8df3cbba6", "srcset": "https://si.imgix.net/c72bb79e/uploads/origins/f6752666-8eac-4686-978d-d3da8c8673fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=017f92b6de4f219a3d351dd8df3cbba6, https://si.imgix.net/c72bb79e/uploads/origins/f6752666-8eac-4686-978d-d3da8c8673fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=904dacd4bcf9d14a1ab319846387408e 2x, https://si.imgix.net/c72bb79e/uploads/origins/f6752666-8eac-4686-978d-d3da8c8673fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ce2a1b1388d8503a6895937f343fa40 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c72bb79e/uploads/origins/f6752666-8eac-4686-978d-d3da8c8673fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e41273d7f87ff59810cbcfed92c2bd46", "srcset": "https://si.imgix.net/c72bb79e/uploads/origins/f6752666-8eac-4686-978d-d3da8c8673fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e41273d7f87ff59810cbcfed92c2bd46, https://si.imgix.net/c72bb79e/uploads/origins/f6752666-8eac-4686-978d-d3da8c8673fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b61df86341ca8f9cf3c9de7d7bb1cfcc 2x, https://si.imgix.net/c72bb79e/uploads/origins/f6752666-8eac-4686-978d-d3da8c8673fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93d2ac021e64cd0eef53667c0ce36d19 3x"}, "body": "こんにちは、アピール募集見ていただき、ありがとうございました！\n\nmaronさまのイラスト拝見しました、色々なキャラクターやポーズで描かれていて，オリジナル衣装も、色味をキャラに合わせて、キャラクターのモチーフも取り入れている感じもとても可愛らしくて素敵だと思いました，\nぜひリクエストさせてください！\n\n⚪︎使用用途は規約内での利用，デザインの創作活動への利用、また許可いただけたら他依頼で衣装デザインを使用させていただきたいです\n\n⚪︎構図や、画角、デザイン設定の範疇（アクセサリーの有無や全身のどこまで描くか）など全て自由に書いていただいて構いませんが、\n創作活動する際に、見えない範囲のデザインは独自で考えて描かせて頂くかもしれません、ご理解ください。\n\n⚪︎衣装に特別希望はないので、maronさまの好きな様に描いていただいて構いませんが、アバウトでやりにくい場合はイラストなど参考に、キャラのモチーフなど取り入れていただけたらと思います。\nモチーフは取り入れてもいいし，取り入れなくても良いです。\nボリュームのあるスカートや、姫袖のような膨らんだ袖、リボンやフリルは大好きです。\n\n\nOC→リリウム、歌って踊るタイプの世界線。\nモチーフは百合，ミルククラウン、羽根など、カラーは淡めの水色〜青緑系。\n水色髪，赤目、褐色肌、\n相手キャラが太陽の様な赤色キャラのため赤いワンポイントなどをつけることも多いです。\n\nこの度は良いご縁に恵まれて、感謝いたします、内容などご不明点・問題なければ，是非よろしくお願い致します。\n\nhttps://x.com/himahimakonkon/status/1926617379988984294?s=46", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ainsophaur0214/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1894865, "client_id": 5297, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a4a8691/uploads/origins/4f5f06c2-a29d-4bd0-b29a-a552ff5eaa7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60014c672950874c6f1632752762dfcf", "srcset": "https://si.imgix.net/2a4a8691/uploads/origins/4f5f06c2-a29d-4bd0-b29a-a552ff5eaa7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60014c672950874c6f1632752762dfcf, https://si.imgix.net/2a4a8691/uploads/origins/4f5f06c2-a29d-4bd0-b29a-a552ff5eaa7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea80cfc79f31b40a241613154b45eb43 2x, https://si.imgix.net/2a4a8691/uploads/origins/4f5f06c2-a29d-4bd0-b29a-a552ff5eaa7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7afb632f5f47342bdb27a084baf8847c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a4a8691/uploads/origins/4f5f06c2-a29d-4bd0-b29a-a552ff5eaa7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c55bbed18de8edca14dd7ea63c11418", "srcset": "https://si.imgix.net/2a4a8691/uploads/origins/4f5f06c2-a29d-4bd0-b29a-a552ff5eaa7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c55bbe