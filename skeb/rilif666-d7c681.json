sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rilif666/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1940938, "client_id": 270203, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93129231/uploads/origins/5991ab5b-faa5-4da1-8289-38c2b362b504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d51d77f65218aa8a6a2e1bce6e640f6f", "srcset": "https://si.imgix.net/93129231/uploads/origins/5991ab5b-faa5-4da1-8289-38c2b362b504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d51d77f65218aa8a6a2e1bce6e640f6f, https://si.imgix.net/93129231/uploads/origins/5991ab5b-faa5-4da1-8289-38c2b362b504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c498cb0b84278de25647fd1afc7187bf 2x, https://si.imgix.net/93129231/uploads/origins/5991ab5b-faa5-4da1-8289-38c2b362b504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf9c9488d44cee5f2fb218602f633135 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93129231/uploads/origins/5991ab5b-faa5-4da1-8289-38c2b362b504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ad9849228031057cc4c477ce5ed0f15", "srcset": "https://si.imgix.net/93129231/uploads/origins/5991ab5b-faa5-4da1-8289-38c2b362b504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ad9849228031057cc4c477ce5ed0f15, https://si.imgix.net/93129231/uploads/origins/5991ab5b-faa5-4da1-8289-38c2b362b504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=75a7c148052a9bbf4703712b1cdd7a7f 2x, https://si.imgix.net/93129231/uploads/origins/5991ab5b-faa5-4da1-8289-38c2b362b504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cdfb8ff50b0d8daaef768a9f48123ae9 3x"}, "body": "お世話になっております！\n今回も自分のイメージキャラのイラストを描いて頂きたいと思いリクエスト送りました。\nhttp://disfact.com/tmp/itigo.png\n\n今回は夏へ向けて水着の姿で描いて欲しいです。\n水着は黒のビキニタイプでフリルがついているイメージ。\n（参考：https://www.pixiv.net/artworks/99351283、https://www.pixiv.net/artworks/75837333）\n細かなデザインはおまかせしますが、布面積は割と少なめのセクシーな感じでも大丈夫です！\n表情やポーズはサムネイルなどで使いやすいよう、こちらに微笑みかけているようなイメージでお願いします。\n\nメガネはつけたままで。\n通常のものと、もし可能であれば海っぽいカラーレンズのサングラス的な差分もあると嬉しいです！\n\n背景は簡易的なもので海に居る様子か、もしくは難しければ無しでも構いません。\nまた、Momental.さんの描かれる水滴の表現が好きなので、汗や水しぶき的な水滴が付着していると良いなと思います。\nそれ以外はおまかせで問題ありません！\n\nSNSへの掲載やアイコンでの使用、Youtubeのサムネイルなどでの使用を想定しています（演出上の加工を加えて使用することがあります）\nそのため背景を透過したものか、キャラと背景のレイヤーが分かれているPSDかを納品して頂ければと思います。\n基本的に背景透過の状態で使うことが多いと思うので、イラスト自体の背景の描き込みは軽めで構いません。\n\nお忙しいところ恐れ入りますが、ご検討よろしくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rilif666/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1940938, "client_id": 2884226, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/370dae6c/uploads/origins/ad0db1f3-e99e-4f7e-b781-f693a691ccd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a9129d2a03f4b3fdc5277a39638b25a", "srcset": "https://si.imgix.net/370dae6c/uploads/origins/ad0db1f3-e99e-4f7e-b781-f693a691ccd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a9129d2a03f4b3fdc5277a39638b25a, https://si.imgix.net/370dae6c/uploads/origins/ad0db1f3-e99e-4f7e-b781-f693a691ccd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbdf4fc4e512f0efb0b650a7b3b9f380 2x, https://si.imgix.net/370dae6c/uploads/origins/ad0db1f3-e99e-4f7e-b781-f693a691ccd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5896545fa2f84c88c11b93496e45393 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/370dae6c/uploads/origins/ad0db1f3-