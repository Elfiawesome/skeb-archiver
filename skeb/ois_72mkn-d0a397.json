n\n\nご縁がありましたらよろしくお願いします🙌100日チャレンジ、応援しております！！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ois_72mkn/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1794907, "client_id": 3673625, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ef207f4/uploads/origins/360ae60a-9173-48a4-8dd3-d288beb7db02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64d504ed5c1c62eb7a3766039b5556c6", "srcset": "https://si.imgix.net/6ef207f4/uploads/origins/360ae60a-9173-48a4-8dd3-d288beb7db02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64d504ed5c1c62eb7a3766039b5556c6, https://si.imgix.net/6ef207f4/uploads/origins/360ae60a-9173-48a4-8dd3-d288beb7db02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3afc60c630e39c50796293deff318c1a 2x, https://si.imgix.net/6ef207f4/uploads/origins/360ae60a-9173-48a4-8dd3-d288beb7db02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8189e5c4540b434cb1c83eacc7d5c69a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ef207f4/uploads/origins/360ae60a-9173-48a4-8dd3-d288beb7db02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54515a52aac2174aeef5fbbe32e46299", "srcset": "https://si.imgix.net/6ef207f4/uploads/origins/360ae60a-9173-48a4-8dd3-d288beb7db02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54515a52aac2174aeef5fbbe32e46299, https://si.imgix.net/6ef207f4/uploads/origins/360ae60a-9173-48a4-8dd3-d288beb7db02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa7e8302cd044738a8c92683bc730f22 2x, https://si.imgix.net/6ef207f4/uploads/origins/360ae60a-9173-48a4-8dd3-d288beb7db02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb41dcf604190759797eba4be538d6b8 3x"}, "body": "はじめまして、いつもTwitterを拝見しております。\nこの度私と友人のうちよそ創作キャラをご依頼したくリクエスト送らせていただきました。(友人から許可を得ています)\n\n\n・花王　透里(はなおう　とおり) 24歳　177cm  男　攻\n\n・黄色の雨合羽の下には黒Tシャツを着て、白髪の髪を一つ結びにしている。\n・ゆるふわ関西弁で喋るが、四桐以外はどうでもいいと思っている全くゆるふわではない性格。四桐にだけは甘く、優しく、笑顔を見せる。\n・愛が重く、四桐のためなら本当になんだってする(人を殺めたことがある)\n・自分が人を殺したことが四桐に迷惑をかけたと知ってから一変、しおらしく、自分は四桐の隣に立つべきではないと考えるように。\n\n\n・双希草　四桐(ふたきぐさ　よぎり)高校2年生　17歳　170cm  男　受\n\n・長めのカーディガンを羽織っており、ぱっつん前髪がトレードマーク。\n・家庭環境も学校での居心地も良いものでは無かったことから、自分に優しくしてくれる透里だけが光であり、心を開いている。\n・精神的にかなり依存しており、透里がいないと何もできない。\n・透里が人を殺したことで迷惑がかかったとは思っていない。透里がいてくれるなら別にどうでもいい。\n\nお互いにお互いを好きということは知っているけれど、恋人と言うには歪で、友達というには行き過ぎた関係の2人です。\n\n\nお手数おかけしますが、資料URLに入っている関係性1、2から描きやすい方を選んでいただければ幸いです。また、丸投げになってしまい申し訳ないのですが、構図など全ておまかせでお願いしたいです。\n\n長々と描いてしまいましたが、ここまで読んでいただきありがとうございます。これからも応援しております！\n\nhttps://drive.google.com/drive/folders/1--LdhqUpyjmele6FhFvWKTE6LLTRS42F", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ois_72mkn/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d0565642/uploads/origins/24a7fa63-f72c-42e9-a606-f09e87fc8b78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3f00f56cc6cd8647f6c0cda680a8cd7", "srcset": "https://si.imgix.net/d0565642/uploads/origins/24a7fa63-f72c-42e9-a606-f09e87fc8b78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3f00f56cc6cd8647f6c0cda680a8cd7, https://si.imgix.net/d0565642/uploads/origins/24a7fa63-f72c-42e9-a606-f09e87fc8b78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72a0df1a1063767f0f0356afecec5a04 2x, https://si.imgix.net/d0565642/uploads/origins/24a7fa63