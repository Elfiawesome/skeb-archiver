8de-fe09a9a330c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ab91ffc69713df1ad80be60244ffc88", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac7bdf3d/uploads/origins/f0c9ec31-78d2-4e6d-b8de-fe09a9a330c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efe7f362efe271f46736fb4fb104fde2", "src_set": ""}, "body": "先生、こんにちは、\nイリヤスフィール・フォン・アインツベルンを描いてください！\n\nこのイラストの表紙を再現してください。https://www.dlsite.com/maniax/work/=/product_id/RJ226361.html 代わりにイリヤで。\n\nhttps://skeb.jp/@haruba_rayden2/works/179 > イリヤはこんなスクール水着を着ている。\n> 男の顔にイリヤの足は不要です。小柄な男の顔がフレームアウトしていても構いません。ただ、イリヤのお尻がイラストに写るようにしてください。\n> 手コキをしているが、手だけでなく、肉棒やオナホールを描いて、ペニスが見えないようにする。\n> 水着の谷間はあるが、乳首は見えないようにする。\n> イリヤは原作イラストと同じようにカメラ目線、同じような表情にする。\n> https://skeb.jp/@haruba_rayden2/works/306 にあるようなイリヤオリジナルの髪型にする。\n> 登場するのはイリヤスヴィエルと小柄な男だけ。\n> アニメーションはありません。\n\nありがとう！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haruba_rayden2/works/318", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 599335, "client_id": 1787683, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88d99b49/uploads/origins/59b05b96-23d7-4bad-8f07-1111218a46aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a96fdc54c9d3baf3f72cc8574f0c88c7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88d99b49/uploads/origins/59b05b96-23d7-4bad-8f07-1111218a46aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=668a3ce3fe025b26aabe5a1af1888ca3", "src_set": ""}, "body": "先日はどうもありがとうございました\n続けてで申し訳ありませんが、Wパチュリーの続きが早速見たくなったのでもう一度だけリクエストさせていただきます\nまたしても長文失礼します\n\n\n勢い任せで関係をもってしまった二人だが、元より相性良好だったので飽きもせずヤりまくる日々を送っていた・・・が、今度は逆に二人してらいでんパチュリーに召喚されてしまう\nしかも初心パチュリーが彼氏にバックでひいひい言わされている最中にだ（多分わざと）\nらいでんパチュリーは初心パチュリーの自身に持ち合わせていない性癖に興味をもったらしく、彼氏に初心パチュリーを開発させるべくちょっとした場所と知識を提供してあげるのだという\n\n彼氏はまず初心パチュリーを縛り上げて三角木馬にまたがらせ鞭で責める\n次に初心パチュリー縛り上げたままを跪かせ仁王立ちパイズリをする\nまた後ろ手の拘束されているので彼氏が胸をもてあそぶ形になる\n（この際、暇したらいでんパチュリーが初心パチュリーの２穴をおもちゃでいじる）\n最後に背面駅弁体勢で後穴を責められる\nこの際拘束は解けているか維持かはお任せします\n\nこんな流れでお願いします\n\nキャラ設定\n体型は全員前回通りですが、全員分の衣装の方はお好みでお願いします\n（初心パチュリーのみ首輪常時を装備させて下さい）\n\n彼氏は相変わらずの体力も精力も絶倫で精液量多し、パチュリーを軽々抱え上げられるようになった\n初心パチュリーは相変わらず性欲に体力が追いつかずすぐへばるがむしろ抵抗できなくなる状況を楽しんでいる気がある。また感じれば感じるほど涙を流すようになった\n\n初心パチュリーはM気味で彼氏はS気味なのだが、お互い肩書や属性には無自覚かつ無頓着で単純に相手が喜ぶ方に流れているだけだったりする\n\n\n以上です。どうかよろしくお願いします", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haruba_rayden2/works/317", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 599335, "client_id": 1787683, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4057e4e3/uploads/origins/a34f25bb-7470-41a1-b4b2-099a849bb524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4ecce0ba1fba2492a3e6b1f1689acc1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4057e4e3/uploads/origins/a34f25bb-7470-41a1-b4b2-099a849bb524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1baf3a72a0a713780a75a70d466d61b3", "src_set": ""}, "body": "以前はリクエストに応えて頂きありがとうございました\n\n\nでは今回のリクエストはまたも長文になりますが\n\n性欲はお互い強いもののキスのみですら舞い上がったり過剰に相手に配慮したりする程の初心なパチュリーとその彼氏の初体験・・・\nをしたいが踏み切れないので平行世界の自分（パチュリー）に助力を乞うたところ\n価値観のかけ離れたらいでんさんの描くおなじみのパチュリーが快く召喚に応じやってきた！\n\nうだうだせずに一回ヤれば解決と瞬時に見抜いたらいでんパチュリーはもう一人の自分を物理的に背中を押し\n初心パチュリーが彼氏を押し倒し、彼氏は反射的に初心パチュリーの体を受け止める（胸をわしづかみにする）構図をつくる\nあとは要所要所でアドバイス（そそのかし）をすればあとはお互いを貪り食うのみ\n最終的には疲労困憊で動けなくなった初心パチュリーにも容赦なく腰を振り続ける彼氏と、それを喜ぶ初心パチュリー\nこんな感じの内容でお願いします\n\n\n体型\n両パチュリー、だらしない体型で胸が非常に大きい\nらいでんパチュリーの方がやや大人びて背が高く、\n初心の方が背が低く童顔で髪が床につく程非常に長い\n彼氏は両パチュリーの中間程度の少年（青年？）でお願いします\n初心パチュリーの服装はノーマルで、らいでんパチュリーの服装はノーマルでもアレンジでも特殊でもお任せします\nまた、可能であれば初めての際は痛がりと出血もお願いします", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haruba_rayden2/works/316", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 599335, "client_id": 156378, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d2ded533/uploads/origins/6d231115-e9e8-4480-8b80-1242dbca5a39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cd0a3f3fb000de6cadb4afb5971c6b5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2ded533/uploads/origins/6d231115-e9e8-4480-8b80-1242dbca5a39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13ab335bcaaceb223cb71d9d1a4e7d1a", "src_set": ""}, "body": "フェアリーテイルからふたなりウェンディ・マーベルとデカパイ魔道士のイラストをお願いしたいです。\n\nウェンディ \n・胸の位置を越える巨根(もっと大きくても良い)で太さも腕より太い、玉があるなら大きめ。\n・服は下記の資料(猫、帽子、手に持ったパフェは描かなくて良いです)\nhttps://games.app-liv.jp/images/articles/2017/08/gd299745_-10.jpg\n\nルーシィ\n・メートル越え爆乳(もっと大きくても良い)で非ふたなり\n・服は下記(鍵や飾り等の小物と小動物は描かなくて良いです)\nhttps://games.app-liv.jp/images/articles/2017/08/gd299745_-3.jpg\n\nバックの体勢のルーシィのお尻及び腰、背中にウェンディが勃起した巨根を置いて挿入の準備。そのまま挿入してルーシィが即アクメ堕ちしながら、ウェンディの高速ピストンからの膣に大量射精。何回か射精したので引き抜くがルーシィにぶっかけながらまだまだ元気に勃起してる。\nというイラストをお願いします。\n\n構図としては前回のような横向き～斜め前あたりからの視点。\n射精の度にお腹を精液で大きくして、最後の引き抜いたときには妊娠したくらいの大きさにして下さい。\n\nリクエストは以上です。\n服はなるべく脱がさないように、2人とも全身を描くようにお願いします。 \n可能なら前回の様な台詞をお願いします、効果音は入れて下さい。\nご検討よろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haruba_rayden2/works/315", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6d66b1f4/uploads/origins/38506d49-ec59-44c1-8371-eb7a03279b48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=775f6f45660e