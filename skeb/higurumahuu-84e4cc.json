oads/origins/101d1b5d-f1f4-45cc-bedc-f9ea6d5feb6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46f9d3475376f3f1df69391690ee5860", "srcset": "https://si.imgix.net/be513643/uploads/origins/101d1b5d-f1f4-45cc-bedc-f9ea6d5feb6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46f9d3475376f3f1df69391690ee5860, https://si.imgix.net/be513643/uploads/origins/101d1b5d-f1f4-45cc-bedc-f9ea6d5feb6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b8ccf251cf6307ea47a29d8428a81f44 2x, https://si.imgix.net/be513643/uploads/origins/101d1b5d-f1f4-45cc-bedc-f9ea6d5feb6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6607878c339544ce4b0868c69825415f 3x"}, "body": "こちら[https://drive.google.com/drive/folders/19whO5CdZywZdmai_D5lCztlRIJULFMJF?usp=sharing]のテントにうちの子風[https://www.pixiv.net/artworks/132788363]と、同じ種族のモブ4～5人(モブは三枚目のように裸)が入り込み、テントの中で楽しそうに大騒ぎして破いていく絵をお願いできればと思います。\nテントの入口の高さは2mほど、全体の高さは3.5mほど、うちの子達の身長は1.75mほどになります。\nテントは資料の角度で描写し、テント全体が絵の中に入るようにしつつ\n・風やモブ達の手足や頭、しっぽがテントの屋根や壁、閉じた入口を突き破ったり、突き破った体の部分に、大きめの破けたインナーテントの破片をかぶっている(参考資料のオレンジ丸部分)[https://drive.google.com/drive/folders/18LqAjZV15BgCXLSp_d0YUInX7fAiWWmv?usp=sharing]ようにする(モブ達は体の一部を描写するだけで大丈夫です)\n・中で暴れることで、テントの屋根や壁が膨らんだりへこんだりして変形し、入口の上部で丸められている布が広がり、はためきながら引き裂ける\n・引っかいたり手足で突き破って裂けた布が外側に垂れさがる(垂れ下がった布は大きめに描写し、この部分を多めで\n・屋根や壁のつなぎ目、屋根と壁の布同士のつなぎ目が引っ張られて、ほつれたり引き裂けたりする\n・杭を打ってある部分の布と、ロープがつながっている部分の周囲が引っ張られて引きちぎれる\n・真っ二つに折れた柱が屋根や壁を突き破る(3～4か所\n部分を入れていただければと思います。背景はなしで大丈夫です。\n\n参考イメージはこちらにまとめている画像になります。\n\nhttps://drive.google.com/drive/folders/13sxwHLuYRfZ5Ec9JjfHxc5CdLrzkuhm3?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@em_ivy_akippoi/works/50", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1164302, "client_id": 850957, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/385e032c/uploads/origins/81f023a5-2290-4b7b-a0b6-7f09c009bd4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49abed8cba02b00a09f1a9a4111fb72f", "srcset": "https://si.imgix.net/385e032c/uploads/origins/81f023a5-2290-4b7b-a0b6-7f09c009bd4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49abed8cba02b00a09f1a9a4111fb72f, https://si.imgix.net/385e032c/uploads/origins/81f023a5-2290-4b7b-a0b6-7f09c009bd4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f63ca78f07fe370f856f68c6b1738aae 2x, https://si.imgix.net/385e032c/uploads/origins/81f023a5-2290-4b7b-a0b6-7f09c009bd4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dfc2e5ea5f24e813eb99a9791c092153 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/385e032c/uploads/origins/81f023a5-2290-4b7b-a0b6-7f09c009bd4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e03f3f7aae20b221973c53129ebdf24f", "srcset": "https://si.imgix.net/385e032c/uploads/origins/81f023a5-2290-4b7b-a0b6-7f09c009bd4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e03f3f7aae20b221973c53129ebdf24f, https://si.imgix.net/385e032c/uploads/origins/81f023a5-2290-4b7b-a0b6-7f09c009bd4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e8f0387261914e2fa0dcb1fdbe19b28 2x, https://si.imgix.net/385e032c/uploads/origins/81f023a5-2290-4b7b-a0b6-7f09c009bd4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8c851a29a3094c519804be466f941e2a 3x"}, "body": "こちら[https://drive.google.com/drive/folders/14NbpWxnCRhFHjPsSB-w4_BDvNVydgmDU?usp=sharing]のテントにうちの子風[https://www.pixiv.net/artworks/132788363]と、同じ種族のモブ4～5人(モブは三枚目のように裸)が入り込み、テントの中で楽しそうに大騒ぎして破いていく絵をお願いできればと思います。\nテントの入口の高さは2mほど、全体の高さは3.5mほど、うちの子達の身長は1.75mほどになります。\nテントはインナーテント(側面が黄色い画像)とフライシート(側面が茶色い画像)の入口を閉じた状態にし、テント全体が絵の中に入るようにしつつ\n・風やモブ達の手足や頭、しっぽがインナーテントとフライシートの屋根や壁、入口を突き破ったり、突き破った体の部分に、大きめの破けたインナーテントの破片をかぶっているようにする(モブ達は体の一部を描写するだけで大丈夫です)\n・中で暴れることで、テントの屋根や壁が膨らんだりへこんだりして変形し、フライシートの入口ははためきながら破ける\n・インナーテントがフライシートを突き破り、インナーテントの破けた部分が外に垂れ下がる\n・引っかいたり手足で突き破って裂けた布が外側に垂れさがる(垂れ下がった布は大きめに描写し、この部分を多めで\n・屋根や壁のつなぎ目が引っ張られて、ほつれたり引き裂けたりする\n・杭を打ってある部分の布と、インナーテントにつながっている部分の周囲が引っ張られて引きちぎれる\n・折れた柱が屋根や壁を突き破る(3～4か所\n部分を入れていただければと思います。背景はなしで大丈夫です。\n\n参考イメージはこちらにまとめている画像になります。\n\nhttps://drive.google.com/drive/folders/13sxwHLuYRfZ5Ec9JjfHxc5CdLrzkuhm3?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@doragon_summer/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 934678, "client_id": 850957, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/50722273/uploads/origins/25e0e540-6ba3-41b2-983a-250e56ff7234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f417c4d1df81d0c4a97be45016be15f", "srcset": "https://si.imgix.net/50722273/uploads/origins/25e0e540-6ba3-41b2-983a-250e56ff7234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f417c4d1df81d0c4a97be45016be15f, https://si.imgix.net/50722273/uploads/origins/25e0e540-6ba3-41b2-983a-250e56ff7234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0df016e2af1efe81e7d60d8bd83f7eb2 2x, https://si.imgix.net/50722273/uploads/origins/25e0e540-6ba3-41b2-983a-250e56ff7234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f3af37bc3522f2cc9fab182f4f23a7a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/50722273/uploads/origins/25e0e540-6ba3-41b2-983a-250e56ff7234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93a86de2b1c68ac376fb24e884721a7d", "srcset": "https://si.imgix.net/50722273/uploads/origins/25e0e540-6ba3-41b2-983a-250e56ff7234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93a86de2b1c68ac376fb24e884721a7d, https://si.imgix.net/50722273/uploads/origins/25e0e540-6ba3-41b2-983a-250e56ff7234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=450570fd80b117270ed59e78440740fd 2x, https://si.imgix.net/50722273/uploads/origins/25e0e540-6ba3-41b2-983a-250e56ff7234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd3875e36e7ba57f362931dbeb5d5d91 3x"}, "body": "こんにちは。突然のリクエスト失礼します。こちら[https://drive.google.com/drive/u/0/folders/1dG5RgZskuyioIDx6B6Oi3u-0dg3sJkSo]のテントにうちの子風[https://www.pixiv.net/artworks/132788363]と、同じ種族のモブ4～5人(モブは三枚目のように裸)が入り込み、テントの中で楽しそうに大騒ぎして破いていく絵をお願いできればと思います。\nテントの入口の高さは2mほど、全体の高さは3.5mほど、うちの子達の身長は1.75mほどになります。\nテントは入口を閉めて留め具で固定(入口の布にある茶色とねずみ色の部分)し、入口下側の両端を金属製の杭で固定した状態にし、テント全体が絵の中に入るようにしつつ\n・風やモブ達の手足や頭、しっぽが屋根や壁、入口を突き破ったり、突き破った状態に、大きめの破けたテントの破片をかぶっているようにする(モブ達は体の一部を描写するだけで大丈夫です)\n・中で暴れることで、テントの屋根や壁が膨らんだりへこんだりして変形する\n・引っかいたり手足で突き破って裂けた布が外側に垂れさがる(垂れ下がった布は大きめに描写し、この部分を多めで\n・屋根や壁のつなぎ目が引っ張られて、ほつれたり引き裂けたりする\n・杭を打ってある部分の布と、テントにつながっている部分の周囲が引っ張られて引きちぎれる\n・折れた柱が屋根や壁を突き破る(3～4か所\n部分を入れていただければと思います。背景はなしで大丈夫です。\n\n参考イメージはこちらにまとめている画像を確認いただければと思います。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/13sxwHLuYRfZ5Ec9JjfHxc5CdLrzkuhm3?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kouken527/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3652174, "client_id": 850957, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5c6add5/uploads/origins/644694b2-8dd3-4075-8bf7-4b689d084fe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06d467ab4b147e6c67c223b9e98cd4aa", "srcset": "https://si.imgix.net/a5c6add5/uploads/origins/644694b2-8dd3-4075-8bf