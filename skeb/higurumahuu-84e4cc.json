-4613-9513-f8ca3d190be0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=372e1b6f655b2fba5f5122bbe8a97667 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c2c5205/uploads/origins/53a8a49e-fb40-4613-9513-f8ca3d190be0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd0455af9ca1212a3a543e5d327be06c", "srcset": "https://si.imgix.net/9c2c5205/uploads/origins/53a8a49e-fb40-4613-9513-f8ca3d190be0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd0455af9ca1212a3a543e5d327be06c, https://si.imgix.net/9c2c5205/uploads/origins/53a8a49e-fb40-4613-9513-f8ca3d190be0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=629fdfebd194a2870be6ebd4802a4a96 2x, https://si.imgix.net/9c2c5205/uploads/origins/53a8a49e-fb40-4613-9513-f8ca3d190be0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=09f42aa069dc81da47dde2af6b7faf33 3x"}, "body": "リクエスト失礼します。こちら[https://www.pixiv.net/artworks/106740853]のテントに体格が大きめ(通常の1.5倍サイズ)のバクフーンやザングース(6体ほど)が入り込み、テントの中で暴れてびりびりする絵をお願いしたいと思います。\nテントは入口の茶色い仕切り布を閉じた状態にして、視点をやや俯瞰気味にし、テント全体が絵の中に入るようにしつつ\n・バクフーン達の手足や頭が屋根や壁、入口を突き破ったり、突き破りかけて布をかぶった状態になる\n・引っかいたり手足で突き破って裂けた布が外側に大きく垂れさがる\n・屋根や壁のつなぎ目が引っ張られて引き裂かれる\n・破れたところを縫い合わせた部分やつぎを当てている部分がほつれて引き裂ける\n・杭を打ってある部分の布が引っ張られて引きちぎれる\n・折れた柱が屋根や壁を突き破る(3～4か所\n部分を入れていただければと思います。\n資料ULRにGドライブに保存した資料を載せておくので、よければ参考にしていただけるとありがたいです。\n\nhttps://drive.google.com/drive/folders/1B6RbPuOG-_wuN-pNTjs2CjOgnYd-4yZJ?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@em_ivy_akippoi/works/31", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1164302, "client_id": 850957, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e37cfc02/uploads/origins/7555be9a-ef5d-4bbd-bb74-c3665f06deaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4659fd1532ae0e07e00b8d0c64e7e8a", "srcset": "https://si.imgix.net/e37cfc02/uploads/origins/7555be9a-ef5d-4bbd-bb74-c3665f06deaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4659fd1532ae0e07e00b8d0c64e7e8a, https://si.imgix.net/e37cfc02/uploads/origins/7555be9a-ef5d-4bbd-bb74-c3665f06deaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35e746b96b564ec1980fb8190a5fe400 2x, https://si.imgix.net/e37cfc02/uploads/origins/7555be9a-ef5d-4bbd-bb74-c3665f06deaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b195f7b2d28a8d5c4d821a997b704ee9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e37cfc02/uploads/origins/7555be9a-ef5d-4bbd-bb74-c3665f06deaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4963e0f25a60a70297a502d82f79ed64", "srcset": "https://si.imgix.net/e37cfc02/uploads/origins/7555be9a-ef5d-4bbd-bb74-c3665f06deaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4963e0f25a60a70297a502d82f79ed64, https://si.imgix.net/e37cfc02/uploads/origins/7555be9a-ef5d-4bbd-bb74-c3665f06deaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=828aa364a8ecc8fd45a41445adeca2ae 2x, https://si.imgix.net/e37cfc02/uploads/origins/7555be9a-ef5d-4bbd-bb74-c3665f06deaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1cd729a81d3c9a05b80888a74ce56b00 3x"}, "body": "リクエスト失礼します。こちらのテントhttps://x.com/higurumahuu/status/1727183517573173665?s=20にザングースやバクフーン、ウインディなど(それぞれ2～3体ずつ)が詰め込まれて、外に出ようと暴れている絵をお願いできればと思います。\nテントは入口の仕切り布を閉じた状態にして、テント全体が絵の中に入るようにしつつサイズを大きめに描いて\n・詰め込まれた面々の手足やしっぽが屋根や壁、入口を突き破るり、テントが膨らむ\n・詰め込まれた面々の頭が突き破りかけて、周囲の布が引き裂ける\n・引っかいたり手足で突き破って裂けた布が、外側に大きく垂れさがる部分を複数入れる\n・屋根や壁のつなぎ目、つぎはぎが引っ張られて引き裂かれたり、縫い目がほつれ