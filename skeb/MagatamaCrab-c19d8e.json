rop=top&w=200&h=200&s=3de96c0823b784ffce40d853f93576a5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca229075/uploads/origins/be9f60e4-9077-4bc5-9393-c4729e54fc38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34345b4034ac4dbaae04e1c6f06cdc33", "srcset": "https://si.imgix.net/ca229075/uploads/origins/be9f60e4-9077-4bc5-9393-c4729e54fc38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34345b4034ac4dbaae04e1c6f06cdc33, https://si.imgix.net/ca229075/uploads/origins/be9f60e4-9077-4bc5-9393-c4729e54fc38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=69e5ef94d452c4cef93471aee77d5273 2x, https://si.imgix.net/ca229075/uploads/origins/be9f60e4-9077-4bc5-9393-c4729e54fc38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6aa43fc0a474fe3535319ba65f4e7a35 3x"}, "body": "初めまして、宜しければリクエストさせて下さい\n\nBanGDream！より「豊川祥子」の足裏くすぐりをお願い致します。\n\n◾️服装\n「https://imgur.com/M8i3xDG」の制服でお願い致します。\n\n◾️構図\n「https://www.pixiv.net/artworks/115541992」と同じ様な拘束方法、構図で足裏のくすぐり。(画像の様に足裏はデカめ)\n\n\n◾️シチュエーション\n①ローファーだけを脱がされた状態で、ハイソックスの上から足裏をくすぐり\n\n②左足のハイソックスが半分ぐらい脱がされかけている状態で、裸足部分をくすぐり\n\n上記の流れで、ご検討宜しくお願い致します。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MagatamaCrab/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3458897, "client_id": 44251, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6b66363/uploads/origins/7d2b6b97-e1d0-4555-9d17-7031af3d7819?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e647856455428f301504ce5ccc94f9d", "srcset": "https://si.imgix.net/f6b66363/uploads/origins/7d2b6b97-e1d0-4555-9d17-7031af3d7819?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e647856455428f301504ce5c