te_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 511383, "client_id": 3067107, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eaae4e3f/uploads/origins/49b35f84-4b36-415b-bc49-47de6e184b18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e519b6ada3b7736e46db4ce2275de1db", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eaae4e3f/uploads/origins/49b35f84-4b36-415b-bc49-47de6e184b18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87897bb3b97cfe683428ee1125e96404", "src_set": ""}, "body": "新年あけましておめでとうございます。\n前年は大変お世話になりました。今年も変わらず仲良くしていただけますと幸いです。\n\nさてこの度は自身の代理キャラクターである「ろくろ」のSNS用アイコン（主にX、Bluesky）の制作をご依頼させていただけたらと思いご連絡いたしました。\n資料URLにBlueskyのリンクを記載させていただきましたが、こちらに文言でも記載させていただければと存じます。\n・年齢→不明、20歳以下イメージ\n・肌色→色白、目の下にクマ\n・髪　→黒基調で、襟足が赤のウルフヘア。長い場所で鎖骨ほど。前髪が重め\n・目　→　濃灰→灰かかった赤のグラデーション。縦瞳孔でツリ目\n・服　→白基調のオーバーサイズパーカーであれば、インナー含め詳細はお任せできればと思います\n・他　→爪に黒のネイル、左耳にピアスが5個+インダスが空いています。場所はどこでも大丈夫です\n　　　　口の左端にカフス系のボディピアスがありますが有無はおまかせします\n\n何卒ご検討のほど、よろしくお願いいたします。\n\nhttps://bsky.app/profile/421069.bsky.social/post/3kim3b6zdh32q", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fccccc_43/works/57", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9eebf46b/uploads/origins/3808e287-31d8-4292-bd49-a0e641f96fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4150b1c1349d55472adb26d68d96f1c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 511383, "client_id": 2986971, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptab