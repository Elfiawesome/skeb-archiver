「いろとりどりのセカイ」の「観波 加奈」を1文字描いていただけないでしょうか。\n\n具体的な要望としては\n\n加奈に写真1,2,3,4の服を着てほしい。\n加奈に写真5のメガネをかけてほしい\n加奈には写真5、6、7のロングヘア（三つ編みはしない）にしてほしい。\n加奈には帽子やメイド帽・モブキャップをかぶってほしくない。プレーンなロングヘアで。\n加奈は微笑んでいて、目を開いていてほしい。\n\nその他、背景やその他はお任せします！よろしくお願いします！\n\nImgurアルバム画像参照：\nhttps://imgur.com/a/SsqilrX", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Codama369/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1306038, "client_id": 1416519, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89644d33/uploads/origins/7d8b3f36-8567-434b-8397-7037fcf09e33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e71e4456ee9fe55ecbc5663b57069aab", "srcset": "https://si.imgix.net/89644d33/uploads/origins/7d8b3f36-8567-434b-8397-7037fcf09e33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e71e4456ee9fe55ecbc5663b57069aab, https://si.imgix.net/89644d33/uploads/origins/7d8b3f36-8567-434b-8397-7037fcf09e33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9298516764469bdf2dfdbd9625596ab6 2x, https://si.imgix.net/89644d33/uploads/origins/7d8b3f36-8567-434b-8397-7037fcf09e33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=424d4513e195c65f9a641181a97b125f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89644d33/uploads/origins/7d8b3f36-8567-434b-8397-7037fcf09e33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd8cdc34aedaa554ab2e2216963d8529", "srcset": "https://si.imgix.net/89644d33/uploads/origins/7d8b3f36-8567-434b-8397-7037fcf09e33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd8cdc34aedaa554ab2e2216963d8529, https://si.imgix.net/89644d33/uploads/origins/7d8b3f36-8567-434b-8397-7037fcf09e33?bg=%23fff&auto=format%2Ccompress