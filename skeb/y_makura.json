見えるようにしてもらいたいと思います。\nポーズやシチュエーションについては特に指定はありませんが、冬にこの格好は寒いので、暖かい場所を用意してあげてください。\nどうぞよろしくお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@y_makura/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4283, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7beb908b/uploads/origins/27866239-d0ad-432f-905c-daee983e8eae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=341e7696f6b70de4c083fa3c4835ad1c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7beb908b/uploads/origins/27866239-d0ad-432f-905c-daee983e8eae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e1a51b133ff8e9599a73eb7c65eb3a5", "src_set": ""}, "body": "以前、山雲の添い寝イラストをリクエストした者です。またぜひお願いできればと思い、リクエストいたします。\n艦これの山雲が、体操服とブルマを着て、セクシーなポーズを取っているイラストをリクエストしたいです。\n運動中の一コマという感じ・グラビアのポーズのような感じなど、ポーズの詳細はお任せいたします。\n体操服とブルマは、艦これのアニメで駆逐艦娘たちが着ていたものと同じデザインでお願いできればと思います。（一応参考URLに、体操服を着たキャラが確認できるアニメの公式PVを貼ります）\nもしよろしければ、ご検討いただけますと幸いです。よろしくお願いいたします。\n\nhttps://youtu.be/3u-WE85ExIU?t=48", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@y_makura/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4283, "client_id": 67057, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb812a48/uploads/origins/fcbbb826-68b9-4a4d-a6bf-c966db0c7f24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=081769c3aa67263cbc53d9f9c4e31c5e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb812a48/uploads/origins/fcbbb826-68b9-4a4d-a6bf-c966db0c7f24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&b