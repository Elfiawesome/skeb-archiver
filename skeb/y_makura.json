85-b736-100f3d9354a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdd8a7d01ae14ea4e57db705ea818a0c", "src_set": ""}, "body": "はじめまして。\n艦これの山雲が、ベッドの上で横になっている姿を\n山雲と添い寝している人からみた視点でのイラストをリクエストしたいです。\n山雲は寝ているところなので髪をほどき、服装も普段の制服ではなく\nネグリジェ・パジャマ等でお願いします。\n山雲の表情は、添い寝している人の方を見て穏やかな笑顔でお願いします。\n\npixivで山雲のメイド服姿のイラストを拝見し、とても素敵に感じましてリクエストいたしました。\nもしよろしければ、ご検討いただけますと幸いです。よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@y_makura/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4283, "client_id": 67057, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee837950/uploads/origins/d64be289-6d4a-4521-ba31-f2673ab70a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=187e286baf9963f7d5c8e578ef119bd6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee837950/uploads/origins/d64be289-6d4a-4521-ba31-f2673ab70a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea600c979879c211c233fb81abfcbd76", "src_set": ""}, "body": "グレカーレ水着modeの水着を着た艦これ荒潮をお願い致します。\nポーズなど関してはおまかせでお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@y_makura/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4283, "client_id": 422964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e5b8f1e/uploads/origins/d3d7821b-cbad-41cd-afcb-3eb7a176a8c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29363e344920936971da9bd62ad465bc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e5b8f1e/uploads/origins/d3d7821b-cbad-41cd-afcb-3eb7a176a8c8?bg=%23fff&auto=form