=a255f850f41b88cb828d252dba25d785 2x, https://si.imgix.net/71a7f50a/uploads/origins/9ab528a4-76c1-4539-81bb-bb9e21c39202?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd88d3df9426b58dff6eb952de34eae3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71a7f50a/uploads/origins/9ab528a4-76c1-4539-81bb-bb9e21c39202?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d501a353404a2510a79adfd24e5f2ff", "srcset": "https://si.imgix.net/71a7f50a/uploads/origins/9ab528a4-76c1-4539-81bb-bb9e21c39202?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d501a353404a2510a79adfd24e5f2ff, https://si.imgix.net/71a7f50a/uploads/origins/9ab528a4-76c1-4539-81bb-bb9e21c39202?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9ff9ac62186dccea05e13e4c8aa8c8b 2x, https://si.imgix.net/71a7f50a/uploads/origins/9ab528a4-76c1-4539-81bb-bb9e21c39202?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=897232bd7f08b399069a5192fb7f3449 3x"}, "body": "はじめまして！\n新着クリエイターから素敵なイラストを拝見し、是非オリキャラを描いて欲しい！と、リクエストに参りました。\n設定、見た目共に癖のあるキャラクターですが、ご検討下さい。\n使用用途は、Twitterや Discordその他SNSでの使用、紹介、TRPG、その他アイコン、グッズ等の個人利用です。\n\n・キャラクター\n\n睦村 奏衛(むつむら かなえ)\n\n25歳 女性\n身長216センチ\n体重84キロ(痩せ型)\n一人称 私\n二人称 〇〇さん\n\n真っ白な肌や髪(アルビノ)\n傷だらけ。口唇口蓋裂。\n大きな口にギザギザの歯。\n大型肉食獣を思わせる顔立ち。\n左右で色構成が違うやや菱形の瞳。\n眉毛は無く、長い睫毛。欠けた耳。\n左右非対称で羽毛質感の髪の毛。\n長く大きな手。左利き寄り両利き。\n胸は無く、骨格はかなりガッシリと男性的。\n\n表向きはボディガードで、本業は殺し屋。\n卓越した医療技術とナイフ捌きで、ターゲットを苦しませずに一撃で仕留める。\n幼少期の頭部外傷が起因のホルモン分泌異常で背が異常に高く、見た目で女性と見られる(バレる)事はまず無い。\n母親が日本人娼婦、父親が母の客の北欧系(ロシア等)人種。\n頭が弱く騙され易いが、真面目で大人しく、仕事以外で誰かを害する事を嫌う。\n手先が器用で、料理が唯一の趣味。\n動物好き。寒さに強く暑さに弱い。\n夢は子供を産んでお母さんになる事と、小さくて良いので自分の料理の店を持つ事。\n白いネリネ(ダイヤモンドリリー/白彼岸花)が誕生花。\n\n・イメージ\n\n顔付きは資料URL内01.05と顔の詳細、文章、衣装は00(仕事着)を参考にして下さい。\nシャープな雰囲気や絵柄が良かったので、資料や設定を元に自由に描いて頂けたら嬉しいです。ナイフを持たせる場合は左手に。\nその他、フードのオンオフ含めお任せします！\n\n※顔の詳細、色\nhttps://www.dropbox.com/s/fxhjix3lli24eeg/7E7744C5.png?dl=0\n※サインやラフ、線画、色等が別のレイヤーになっているPSDを可能であればお願いします。\n※納品されているギャラリーの作品もご参考頂けると嬉しいです。\n\n以上、ご検討ヨロシクお願いします！\n\nhttps://www.dropbox.com/sh/wutrpijgh0twmhq/AADnwxxZsN7UGGtt0soY7hLia?dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2017469, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "potato/skeb専用", "screen_name": "popopopopo623sk", "avatar_url": "https://pbs.twimg.com/profile_images/1521147184636317697/_JLhHJyE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1521141599979249665/1658074820/1500x500", "appeal_receivable": false, "popular_creator_rank": 46, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 129}, {"id": 2438340, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "鵺", "screen_name": "nnnnuuuueeeenue", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:dwljrz56oboeq24simukcmg5/bafkreieoxg77teb7xewmja4wruuqdqcrgu6vxfxjpx43nqsd6qqqnxbhpe", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2520412, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🟡ﾄﾄﾘ🟡", "screen_name": "IGISUBOX", "avatar_url": "https://pbs.twimg.com/profile_images/2042960155986530306/uhqKcMW9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1266998472802054148/1753093456/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expirati