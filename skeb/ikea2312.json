bnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1578912, "client_id": 1371313, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba860fe9/uploads/origins/6c2f64f3-7dcd-46e9-988d-31d5d4727826?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bf38401915ab5218ac7f7e135243e36", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba860fe9/uploads/origins/6c2f64f3-7dcd-46e9-988d-31d5d4727826?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bedcc4d2d9272911a903f9902cd5d02c", "src_set": ""}, "body": "「キツめの看護師主任口リ嫁」さんの別日譚をお願いできないでしょうか。\nいつもより趣味悪特盛りで申し訳ありませんが、気が向いたら受けていただけると幸いです。\n・婚約指輪を紛失した結果、木に竹を接ぐように、JSファッションでお詫びをする口リ嫁さんだけど、ここぞとばかりに、囚人服での女囚プレイを要求され、100万円ぐらいの指輪だったのでしぶしぶ受諾する\n・海外通販で取り寄せた、刑務所の放出品の本物囚人服＆本物囚人下着（添付URL）が準備される。\n・犯罪者のお下がりとドン引きしながら、非常にしぶしぶ着る\n・吹っ切れたように、囚人番号＋氏名で点呼ごっこする。\n・娘に見られて恥ずかしくて仕方が無い。娘は気づかず「わー、ママ、ミニ○ンみたいー」とはしゃいでいる。\n・コスプレという体で、ちょっと無理なニコニコ囚人服で記念撮影。\n\nhttps://drive.google.com/drive/folders/12FINmPqvHBjodxu3-lgm5XQqTOVCjnaU?usp=sharing", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikea2312/works/46", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/edfed52c/uploads/origins/a9776d1d-b765-49f1-9b94-68cf3f63281b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a4909f28ddac6c636d5dbd17993ab98", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1578912, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 179, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ikea2312/works/45", "private_thumbnail_image_url