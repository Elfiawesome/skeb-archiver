\n\n・文字・小物・エフェクト・背景をレイヤー分けしたPSD形式でご提出いただけますと幸いです。\n・可能であれば、頭部や髪、上半身が見切れない構図ですと大変助かります。\n\n〈使用用途〉\n\n・YouTubeなどの動画配信サイト（サムネイル、動画／配信内素材）\n・SNSでの告知・ヘッダー・アイコン\n・グッズ制作\n・支援サイトでの使用 など\n\n以上、長文失礼いたしました。\nリクエスト内容に問題がある場合は、どうぞご遠慮なく再送やキャンセルをお願いいたします。\nご検討のほど、何卒よろしくお願いします…！\n\nhttps://drive.google.com/drive/u/0/folders/1axGPNLrkC5uMSaazCvS268KFwY3oKHch", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kurihara_Harari/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4048087, "client_id": 4123585, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/334a016a/uploads/origins/4a19cbd3-d268-472c-a9d4-82eec043e1ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9d553ad355ccb2c0b37fe8d999a98d9", "srcset": "https://si.imgix.net/334a016a/uploads/origins/4a19cbd3-d268-472c-a9d4-82eec043e1ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9d553ad355ccb2c0b37fe8d999a98d9, https://si.imgix.net/334a016a/uploads/origins/4a19cbd3-d268-472c-a9d4-82eec043e1ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19a3c7f81a2bbf355433f3e6478b1d1d 2x, https://si.imgix.net/334a016a/uploads/origins/4a19cbd3-d268-472c-a9d4-82eec043e1ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a724ff4dd2e880938b3c4a7a86dcd70 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/334a016a/uploads/origins/4a19cbd3-d268-472c-a9d4-82eec043e1ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bd79f8d5f06a4c516b75edcdad9e495", "srcset": "https://si.imgix.net/334a016a/uploads/origins/4a19cbd3-d268-472c-a9d4-82eec043e1ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bd79f8d5f06a4c516b75edcdad9e495, https://si.imgix.net/334a016a/uploads/origins/4