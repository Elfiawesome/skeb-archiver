ive.google.com/drive/folders/1VfT4qXtuyZsN-m-vZsdHsWZSScXrTXBO", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kurihara_Harari/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4048087, "client_id": 3416124, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/924ad5f4/uploads/origins/40095bf5-bf1a-4716-8fd3-da039e66eead?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f37677631db8c00bcd98310f96c3817", "srcset": "https://si.imgix.net/924ad5f4/uploads/origins/40095bf5-bf1a-4716-8fd3-da039e66eead?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f37677631db8c00bcd98310f96c3817, https://si.imgix.net/924ad5f4/uploads/origins/40095bf5-bf1a-4716-8fd3-da039e66eead?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85cd345c6cd13bb5051af74cd316dba8 2x, https://si.imgix.net/924ad5f4/uploads/origins/40095bf5-bf1a-4716-8fd3-da039e66eead?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44106ca4f03fb57a2ff6ab96bd8c6dd1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/924ad5f4/uploads/origins/40095bf5-bf1a-4716-8fd3-da039e66eead?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7b29b2d66b98ad1040ca7cfae546f4f", "srcset": "https://si.imgix.net/924ad5f4/uploads/origins/40095bf5-bf1a-4716-8fd3-da039e66eead?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7b29b2d66b98ad1040ca7cfae546f4f, https://si.imgix.net/924ad5f4/uploads/origins/40095bf5-bf1a-4716-8fd3-da039e66eead?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a978bc2779ac42415ce68d3c8f53a947 2x, https://si.imgix.net/924ad5f4/uploads/origins/40095bf5-bf1a-4716-8fd3-da039e66eead?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c3e3b7a69b09f0cd478355920ce32cc7 3x"}, "body": "こんにちは。\nあなたの作品がとても気に入ったので、この2人のオリジナルキャラクターを基にイラストを描いていただけないでしょうか。完成した作品は、個人的な用途（壁紙として）で使用する予定です。\n\n【黒髪の女の子】\n無口で内向的、少しツンデレな猫のような性格。感情表現が苦手で素直になれませんが、実は茶髪の女の子をとても大切に思い、つい視線で追ってしまいます。文学専攻で読書と甘いものが好き。普段は無表情気味ですが、彼女の前では照れたり微笑んだりすることも。\n\n【茶髪の女の子】\n積極的で優しく、少し腹黒い狐のような性格。自分から黒髪の子に話しかけ、にこにこと接します。素っ気ない態度も気にせず、好意を理解している余裕があります。音楽専攻でヴァイオリンを学び、音楽鑑賞と苦味のある食べ物が好き。\n\n【世界観（お好きな設定で制作可）】\n①現代：高校の同級生。勉強や買い物、お弁当など日常の一コマ。\n②魔女AU：不老の黒髪の魔女と、人間の魔法見習い。前世で恋人同士だったが、茶髪は記憶を失って転生。森の小屋で共に暮らす。\n③天使×悪魔AU：厭世的な悪魔（黒髪）と軽薄そうな天使（茶髪）。現代が舞台。\n\n服装や画面はご自由にお任せします。性別変更などのアレンジも問題ありません！\nお読みいただきありがとうございます。\n\nhttps://drive.google.com/drive/folders/1xQjcmjs_CRdRkRbmmuYPqteQfTZI2bZn?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kurihara_Harari/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4048087, "client_id": 4051862, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9180792/uploads/origins/fd52c2f5-2df2-4e9f-9bd0-95bb5920f5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91eb602bbe06e79f944ecb663ebc50ff", "srcset": "https://si.imgix.net/f9180792/uploads/origins/fd52c2f5-2df2-4e9f-9bd0-95bb5920f5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91eb602bbe06e79f944ecb663ebc50ff, https://si.imgix.net/f9180792/uploads/origins/fd52c2f5-2df2-4e9f-9bd0-95bb5920f5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7636a79226945cd4f6de878a07358718 2x, https://si.imgix.net/f9180792/uploads/origins/fd52c2f5-2df2-4e9f-9bd0-95bb5920f5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cacb25c9df5d709674758649553280d4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9180792/uploads/o