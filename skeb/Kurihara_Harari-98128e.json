ce8-b880-c89e8d914cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e2de5d57c98c0c5154d63ec444b4719", "srcset": "https://si.imgix.net/9eadffde/uploads/origins/725d34dd-48e3-4ce8-b880-c89e8d914cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e2de5d57c98c0c5154d63ec444b4719, https://si.imgix.net/9eadffde/uploads/origins/725d34dd-48e3-4ce8-b880-c89e8d914cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c3c83550552c6a0dec5f47ff094a66a 2x, https://si.imgix.net/9eadffde/uploads/origins/725d34dd-48e3-4ce8-b880-c89e8d914cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c22f28119a00d3a3c0151e4b22f1a6f7 3x"}, "body": "栗原はらり様、はじめまして。とてもイラストに惹かれこの度はご依頼に参りました。私のOCを描いていただけないでしょうか。\n\n※お顔立ちについて：まだ「これ」という参考がないため、先生が思う「一番綺麗な女の子」として自由に描いていただけたら嬉しいです！以下の目元・瞳の記載は、雰囲気の方向性として参考にしていただければ十分です。\n\n■ キャラクターの核 \n・普段はどこか「締まった」雰囲気のある子です。顔立ちは整っていて、真顔では凛として少し近寄りがたい印象がありますが、冷たかったり、不機嫌そうだったりするわけではありません。 \n・頬や目元にはほんの少しだけ柔らかさが残っていて、音楽や好きなものに触れた瞬間、その表情がふっとほどける。この温度差がこの子の一番の魅力だと思います（本人は全く無自覚です）。 \n・可愛らしさを前面に出すというより、静かで凛とした雰囲気の中に自然な可愛さが感じられるようなイメージです。目元の透明感で魅力が出ると嬉しいです。\n\n■ 性格\n・素直で芯が強い、普段は落ち着いていて、少しマイペース。\n・とても聡明ですが、意外と一般常識には少し疎く、時々思いがけないところで天然な一面を見せることもあります。\n・水族館ではペンギンに夢中になり、気づけば一時間もその場から動かないことがあります。また、すらりとした見た目に反して意外とよく食べる子です。本人はどちらもごく普通のことだと思っていて、周りに驚かれてもきょとんとしています。\n・実はぬいぐるみなどのふわふわした可愛いものに目がないのですが、本人はそれを少し子供っぽいと思っていて、周りには必死に隠しています。\n\n■ 好きなもの\n・音楽、お料理、おいしいもの全般、鳥（特にペンギン）、水族館めぐり、もふもふ\n\n■ 外見 \n・髪色：透明感のある低彩度のグレージュ \n・髪型：（資料をご確認いただけると幸いです） \n・体型：手足が長く、姿勢がよい。自然と背筋が伸びています。\n・目：凛として少しクールな印象がありつつも、きつくはならず、澄んだ瞳にどこか柔らかさが感じられるイメージです。（※萌え系というより、凛とした雰囲気の中に透明感とやわらかさがある方向を希望しています。） \n・瞳：空が静かに映っているような澄んだ青。ハイライトはやや大きめで、みずみずしく透明感のある印象だと嬉しいです。\n\n■ ポーズ\n誰にも見られていないところで、ペンギンのぬいぐるみをぎゅっと抱きしめている夜空が見てみたいです。\nそのときだけ少し気が緩んだような、静かに嬉しそうな表情だととても嬉しいです。\n\n■ 旧設定画について \n参考URLに以前の設定画があります。同じキャラクターですが、別の世界観から現在の作品へ移った設定です。 「同じ人物が成長し、別の世界へ移った」という位置づけでお願いできればと思います。\n\n■ その他\n衣装などはお任せいたします！ 可能であれば、宛名とサインをPSDレイヤーでオン/オフできるようにしていただけると幸いです。どうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1_j_bCSioPXIAtg_uJ8Vxnnus75CimlW4?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kurihara_Harari/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b4def3af/uploads/origins/df107073-7722-49be-9168-8a0435f4cd5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32cf3f894eaf4c6e5d07574d1ff69d35", "srcset": "https://si.imgix.net/b4def3af/uploads/origins/df107073-7722-49be-9168-8a0435f4cd5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32cf3f894eaf4c6e5d07574d1ff69d35, https://si.imgix.net/b4def3af/uploads/origins/df107073-7722-49be-9168-8a0435f4cd5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=454280e55a8190613f92680551f16cdd 2x, https://si.imgix.net/b4def3af/uploads/origins/df107073-7722-49be-9168-8a0435f4cd5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98805d66d1bcf07be7ef1c1e7c88ed92 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 4048087, "client_id": 3362556, "nc": 0}, {"path": "/@Kurihara_Harari/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4048087, "client_id": 4124184, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af936963/uploads/origins/e773a2d2-5a34-409a-8f36-053c94bc1ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=697fa2cb31b1e