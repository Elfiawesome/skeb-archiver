mpress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfcf5f5f0bfefde7a12e68f05c768c23 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8655c9d7/uploads/origins/d2d93913-8b94-4cf0-b86c-4d3b14f0e1cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79c7726b8d8d74f46af4ad607bf9c0cf", "srcset": "https://si.imgix.net/8655c9d7/uploads/origins/d2d93913-8b94-4cf0-b86c-4d3b14f0e1cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79c7726b8d8d74f46af4ad607bf9c0cf, https://si.imgix.net/8655c9d7/uploads/origins/d2d93913-8b94-4cf0-b86c-4d3b14f0e1cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2e976f69ecd2c6499d4dd13143bd192e 2x, https://si.imgix.net/8655c9d7/uploads/origins/d2d93913-8b94-4cf0-b86c-4d3b14f0e1cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=142dec09bccf08a3a670b091aa7fff04 3x"}, "body": "初めまして。紬の入れ替わりイラストが目に止まり、是非描いていただきたいと思いました。特殊ですが、よろしければお願いします。\n※服はなくても大丈夫です。裸でも服有りでも描きやすい方でおまかせします。\n\nライブ終わりの我那覇響とPと身体入れ替わり勢いで性行為を始める\n汗をかいている響(P)のおっぱいの谷間に顔を埋めながら正常位をするP(響)\nP(響)「自分の胸…汗臭いのに…癖になる…Pのおちんちんも気持ちいい」\n響(P)「やめ…んっ♡…これ以上は…あん！♡（ライブ終わりの響の蒸れた体の臭いとエッチな臭いが混じってクラクラする）んんっ♡中に…出されている…」\nみたいな台詞を入れてもらいたいです。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@erosagillust/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2264055, "client_id": 86180, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26f4a3e5/uploads/origins/24fd0677-76cc-4aae-8789-76942c81fa05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f608b8ab92ca4bec0af9f49d46e8faa5", "srcset": "https://si.imgix.net/26f4a3e5/uploads/origins/24fd0677-76cc-4aae-8789-76942c81fa05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f608b8ab92ca4bec0af9f49d46e8faa5, https://si.imgix.net/26f4a3e5/uploads/origins/24fd0677-76cc-4aae-8789-76942c81fa05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47920ae6d096767f2df56fe0cffb739b 2x, https://si.imgix.net/26f4a3e5/uploads/origins/24fd0677-76cc-4aae-8789-76942c81fa05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d840652280e48786a3cb794af94a5d0b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26f4a3e5/uploads/origins/24fd0677-76cc-4aae-8789-76942c81fa05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f67b48f21207840320b8364f400c92e", "srcset": "https://si.imgix.net/26f4a3e5/uploads/origins/24fd0677-76cc-4aae-8789-76942c81fa05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f67b48f21207840320b8364f400c92e, https://si.imgix.net/26f4a3e5/uploads/origins/24fd0677-76cc-4aae-8789-76942c81fa05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=745d76156ea33396a32245632b496dee 2x, https://si.imgix.net/26f4a3e5/uploads/origins/24fd0677-76cc-4aae-8789-76942c81fa05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1bc8467c17ee78e34186b78341ff5623 3x"}, "body": "先日は自らをロコナイズしてPに飼い主になってもらうロコを描いていただき、ありがとうございます。\n先頃、ロコに続いて杏奈も犬枠で実装されたので、同様にロコナイズされてPのところへ連れて行かれる杏奈を2シーン以上の構成で依頼します。\n\n①\n犬杏奈から衣装を剥いているところ。\n台詞として、困惑もしくは抵抗している杏奈に対してロコが『一緒にPに飼ってもらおう』と誘い、杏奈はそれ以前とは違う意味での困惑しながらも抵抗する力を失う。\n構図として、杏奈は正面を向いて剥かれているのに対して、ロコは斜め後ろ向き（難しければ横向き）になってロコナイズしている。\nロコの尻尾がお尻の穴から生えているのが判る形であれば構いませんが、それが強調される構図だとなお良いです。\n杏奈の服は『耳としっぽシリーズ』で、どの程度剥かれているかはお任せします。\nロコの服については上下揃いの下着姿で、ショーツは尻尾のためにアナルが見えるOバック、セクシーショーツ、もしくは前貼りでお願いします。\n\n②\n前回同様、Pに迫るところ。\nPに首輪から伸びるリードの持ち手を渡そうとするところ、もしくは前回のようにPを押し倒しているところ。\n主体は杏奈で、ロコは横もしくは斜め後ろにドヤ顔もしくは笑顔で控えている形でお願いします。\nまた、二人は裸に犬耳尻尾と首輪にリード姿でお願いします。\nまた、可能であれば、ロコはそれに加えて乳首にピアスを通してそこから平仮名で名札を下げてあると嬉しいです。\n名札に書かれてあるのは名前でも扱い（『ペット』等）でも構いません。\n\nいずれも、細かい描写や台詞はお任せします。\nまた、可能であれば、①はロコで杏奈の体が隠れてしまうと思うので、ロコなしの差分があると嬉しいです。\n\nこれまでより少しハードめの内容ですが、よろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@erosagillust/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2264055, "client_id": 345937, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/649a8586/uploads/origins/7c6ee6fb-cd07-4ba3-9a2e-2b551b0be715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40ea21bcf0949e07a57333c03c70812e", "srcset": "https://si.imgix.net/649a8586/uploads/origins/7c6ee6fb-cd07-4ba3-9a2e-2b551b0be715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40ea21bcf0949e07a57333c03c70812e, https://si.imgix.net/649a8586/uploads/origins/7c6ee6fb-cd07-4ba3-9a2e-2b551b0be715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3dc20a6277bb8292995b4b7087c6e566 2x, https://si.imgix.net/649a8586/uploads/origins/7c6ee6fb-cd07-4ba3-9a2e-2b551b0be715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fd5b86b157b0d9193b7dc0963b72a30 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/649a8586/uploads/origins/7c6ee6fb-cd07-4ba3-9a2e-2b551b0be715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ca461c53229585dc06c53b492f6d860", "srcset": "https://si.imgix.net/649a8586/uploads/origins/7c6ee6fb-cd07-4ba3-9a2e-2b551b0be715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ca461c53229585dc06c53b492f6d860, https://si.imgix.net/649a8586/uploads/origins/7c6ee6fb-cd07-4ba3-9a2e-2b551b0be715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad4a607b0c6caf6f41b36eca06ba1489 2x, https://si.imgix.net/649a8586/uploads/or