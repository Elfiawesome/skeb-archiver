外の色の差分もあると嬉しいです。\n\n　Ｂ.差分は厳しい場合は、⑦は気にしないでください。\n\n⑧その他、表情や女の子の向き等については、お任せをさせていただければと思います。\n\n差し支えなければ、ご検討いただけると幸いです。何卒よろしくお願い致します。\n\nhttps://www.pixiv.net/artworks/111389740", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AoyagiLila/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2723563, "client_id": 3102839, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/008134d1/uploads/origins/128a629a-c07b-4ab5-9c52-c0dcdb07ee4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbc7809e228870dc35ade1896fe5a03e", "srcset": "https://si.imgix.net/008134d1/uploads/origins/128a629a-c07b-4ab5-9c52-c0dcdb07ee4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbc7809e228870dc35ade1896fe5a03e, https://si.imgix.net/008134d1/uploads/origins/128a629a-c07b-4ab5-9c52-c0dcdb07ee4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9195cec0836b346ee3ace2a847f0368 2x, https://si.imgix.net/008134d1/uploads/origins/128a629a-c07b-4ab5-9c52-c0dcdb07ee4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4559d61e6ded9be3ca18b18e4b1478ab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/008134d1/uploads/origins/128a629a-c07b-4ab5-9c52-c0dcdb07ee4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6dcbe1dbe79380fb31ff816a2528bf75", "srcset": "https://si.imgix.net/008134d1/uploads/origins/128a629a-c07b-4ab5-9c52-c0dcdb07ee4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6dcbe1dbe79380fb31ff816a2528bf75, https://si.imgix.net/008134d1/uploads/origins/128a629a-c07b-4ab5-9c52-c0dcdb07ee4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cebab5ef0ae3845726bced08f6a3e88c 2x, https://si