press&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9dfc97abab432e1a86e81bf0f5965e0b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/632670ae/uploads/origins/a856c6f0-f6e2-4a97-beb8-0add7abf0c36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31bbce92042deb0886409adf084620db", "srcset": "https://si.imgix.net/632670ae/uploads/origins/a856c6f0-f6e2-4a97-beb8-0add7abf0c36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31bbce92042deb0886409adf084620db, https://si.imgix.net/632670ae/uploads/origins/a856c6f0-f6e2-4a97-beb8-0add7abf0c36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c01e0cd86329c4bfe71e05d2d8abbd86 2x, https://si.imgix.net/632670ae/uploads/origins/a856c6f0-f6e2-4a97-beb8-0add7abf0c36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cfd6bb61dd24fadce3be66d4aa8f89d9 3x"}, "body": "Nice to meet you. I fell in love at first sight with your fluid lines and the way you bring characters to life. If you’d be willing, could you please draw one of the original characters from the link? (You can choose whichever one you like.)\nI’ll leave everything up to you, so if your schedule allows, I’d really appreciate it. 🤲\n\nhttps://www.pixiv.net/artworks/122714346", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@komagoma/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2640563, "client_id": 3195820, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9179cbc/uploads/origins/2b7c59af-6c13-4644-930a-c0541f0d8fbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c893a2b9fb4449a451ab3ecf0321054", "srcset": "https://si.imgix.net/b9179cbc/uploads/origins/2b7c59af-6c13-4644-930a-c0541f0d8fbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c893a2b9fb4449a451ab3ecf0321054, https://si.imgix.net/b9179cbc/uploads/origins/2b7c59af-6c13-4644-930a-c0541f0d8fbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dac625f634e18f4edfa96bf42c5e40f9 2x, https://si.imgix.net/b9179cbc/uploads/origins/2b7c59af-6c13-4644-930a-c0541f0d8fbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84ed4d92530b3df271247fa88c95ece7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9179cbc/uploads/origins/2b7c59af-6c13-4644-930a-c0541f0d8fbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7762a2d651a96aa191a787e3a5dd605", "srcset": "https://si.imgix.net/b9179cbc/uploads/origins/2b7c59af-6c13-4644-930a-c0541f0d8fbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7762a2d651a96aa191a787e3a5dd605, https://si.imgix.net/b9179cbc/uploads/origins/2b7c59af-6c13-4644-930a-c0541f0d8fbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=877a336fde84039753f1cfd9e23caa35 2x, https://si.imgix.net/b9179cbc/uploads/origins/2b7c59af-6c13-4644-930a-c0541f0d8fbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69571d27eb1e32fafc488d877fc8f02f 3x"}, "body": "Hello, Mr. Goma!\nI absolutely love all the fan art you draw! The lively interactions between the characters and their adorable expressions…\nYour understanding of the characters (or actors?) is also really interesting, and I’m completely captivated by it! I think both your colors and lines are beautiful—they feel so free and expressive!\nWould you be willing to draw my two original characters?\n\n▶ Reference/Details\nA handsome detective in men’s clothing and his all-powerful older assistant.\nA villainous duo, a middle-aged married couple. An older man × a beautiful cross-dresser. A good guy and a bad girl. A loud, outgoing partner. A yakuza-turned-detective who loves pranks and his assistant. Friends! Cheers!\n\nTwo wolves. A dog-themed couple. (BG with a BL vibe (?)) A partner-style couple.\n\n△ One-Eyed: Detective. Domineering, polite, and sarcastic. He always uses honorifics. He loves acting and talking. He’s always smiling. He has OCD and prefers things that feel nice to the touch (including ↓), which is why he collects so many stuffed animals.\n\n△ Tanned Skin: The all-powerful assistant who’s great at fighting. He has a Showa-era uncle vibe—ferocious, intimidating, and a bit of a delinquent. But with his wife, he’s just a clumsy, straightforward guy who’s totally trustworthy. He can transform into a werewolf. (Sometimes he can’t control it.) He can transform a little for his partner (fluffy ears and a tail).\n\n▶ (Detailed profile available) URL: https://drive.google.com/drive/folders/1-5yiCmVf35jIV3kuUhgx1Pci7f-809Ih?usp=drive_link\n\n\n▶ Content\n▶ An atmosphere where ordinary people work is fine; a cool villain vibe is fine; a lovey-dovey, goofy couple vibe is fine; a mature atmosphere is fine; a vibe where they’re so close that it feels like they’re not close at all is fine; a comedy manga vibe is fine… and so on.\nPlease feel free to draw whatever interests you. Feel free to choose their outfits and parodies; it’s okay to change them however you like. You can also choose ages other than the parody ones.\nEven something as simple as a doodle page is perfectly fine. I’m really looking forward to seeing the interactions between the characters you draw, your interpretation of them, and more.\n\nBasically, after reviewing the settings, anything goes!\n\nIf you have any rejected roughs or sketches, I’d love to see them.\n\n▶If the budget is insufficient, please let me know so I can adjust it. If that’s difficult, feel free to cancel the order directly.\nThank you very much.", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@komagoma/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2640563, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b859087f/uploads/origins/2631700d-5e51-45e4-8464-2b3f2b99fcda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2195bfb2e89643f71d0c595e96b2e64", "srcset": "https://si.imgix.net/b859087f/uploads/origins/2631700d-5e51-45e4-8464-2b3f2b99fcda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2195bfb2e89643f71d0c595e96b2e64, https://si.imgix.net/b859087f/uploads/origins/2631700d-5e51-45e4-8464-2b3f2b99fcda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18cbebb225c1672ab96a35a8425c59ad 2x, https://si.imgix.net/b859087f/uploads/origins/2631700d-5e51-45e4-8464-2b3f2b99fcda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86e11586d38ec2bd46ba3dcd0be7be11 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b859087f/uploads/origins/2631700d-5e51-45e4-8464-2b3f2b99fcda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed75ff90d515c7f9e39919e94ce06e13", "srcset": "https://si.imgix.net/b859087f/uploads/origins/2631700d-5e51-45e4-8464-2b3f2b99fcda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed75ff90d515c7f9e39919e94ce06e13, https://si.imgix.net/b859087f/uploads/origins/2631700d-5e51-45e4-8464-2b3f2b99fcda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dd0873f3a1b127a45e50d8ee1f4f291c 2x, https://si.imgix.net/b859087f/uploads/origins/2631700d-5e51-45e4-8464-2b3f2b99fcda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7ffbac6ce7b42b2c049219b7a16cb90a 3x"}, "body": "𝗚𝗼𝗺𝗮さまはじめまして😺\nイラストのタッチや雰囲気がすごくて、やりと