top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85003d0b3a395f1ca9f927ea783c9c18 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2640563, "client_id": 3018199, "nc": 144}, {"path": "/@komagoma/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2640563, "client_id": 1622191, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ecdec17/uploads/origins/449b10b6-6d95-409c-bac2-e388a7bcd972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcae80b23162f465e02493491f8f88e6", "srcset": "https://si.imgix.net/6ecdec17/uploads/origins/449b10b6-6d95-409c-bac2-e388a7bcd972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcae80b23162f465e02493491f8f88e6, https://si.imgix.net/6ecdec17/uploads/origins/449b10b6-6d95-409c-bac2-e388a7bcd972?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69d0ae473aba6f5a76530e7e26c5db8a 2x, https://si.imgix.net/6ecdec17/uploads/origins/449b10b6-6d95-409c-bac2-e388a7bcd972?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8527b00388c22f25b1297b27a1e96bb8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ecdec17/uploads/origins/449b10b6-6d95-409c-bac2-e388a7bcd972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f968f551361c94cd74ee5e94e95d762", "srcset": "https://si.imgix.net/6ecdec17/uploads/origins/449b10b6-6d95-409c-bac2-e388a7bcd972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f968f551361c94cd74ee5e94e95d762, https://si.imgix.net/6ecdec17/uploads/origins/449b10b6-6d95-409c-bac2-e388a7bcd972?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=981241e6c1485b557dd048ace07f7678 2x, https://si.imgix.net/6ecdec17/uploads/origins/449b10b6-6d95-409c-bac2-e388a7bcd972?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4993be778d66b173e98de37f68865295 3x"}, "body": "Nice to meet you. I’ve been following your work for a while, and I absolutely love the atmosphere and character designs—they’re wonderful. I would be thrilled if you could illustrate an interaction between my original characters (OCs).\nBelow is a brief summary of the characters’ backstories.\n\n⸻\nKyū (                                                                                                                                                     � The flowers only bloom in an environment where she feels completely at ease.\nShe has a bony wing on one side of her back, from which moss and thin vines hang.\nWhen these spread across her body, it indicates she is in a deep state of hibernation.\n\nCharacter Details\n  •  Two-tone black and white hair, with two stray strands sticking up on top of her head\n  •  Her tail has a cover knitted from yarn\n  •  Her dog ears are decorative (accessories)\n  •  Clothing is patchwork-style with many nature motifs\n  •  I’d love to see fabric with repair marks or visible stitching\n\n———\nShichi (Male): Height 198 cm, appears to be about 40 years old, with a gloomy yet calm demeanor. He is a character who exudes both danger and stability. He is highly possessive and does not like others touching Kyu. In daily life, he often goes about his activities while holding Kyu (changing clothes, eating, resting, etc.). When Kyu is by Shichi’s side, he sleeps more soundly and blooms. Kyu’s moss and vines may touch Shichi’s body, but they do not invade him.\n\nCharacter Details\n  •  Wears gloves at all times due to a condition that petrifies anything he touches\n  •  Scars of various sizes all over his body\n  •  Wears an earring in only one ear\n  •  Long hair, braided down to his waist\n  •  An adult male with a sturdy build\n  •  However, please avoid overly exaggerated musculature\n\n———\nHeight Difference: 156 cm × 198 cm\nNanami cherishes Kyu deeply, but at the same time, he harbors a strong anxiety that Kyu might one day vanish. This fear sometimes causes his emotions to become unstable, leading him to extreme thoughts such as, “If I were to kill him myself, perhaps he could stay by my side forever.”\nHowever, this is not an actual plan; it is a twisted possessiveness stemming from his fear of loss. Kyu’s body temperature is very warm.\n\n\nThank you for taking the time to read this despite your busy schedule. I look forward to your continued support.\n\nhttps://x.com/xijiujiujiu99/status/2029529836205867434?s=61&t=80IbM0OiZOITAB1QOpqmFQ", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@komagoma/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2640563, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d054e395/uploads/origins/0624a8a4-23ce-43ab-8158-94260650f61c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f97aa6009e40f9d1d7fa80952476ca5e", "srcset": "https://si.imgix.net/d054e395/uploads/origins/0624a8a4-23ce-43ab-8158-94260650f61c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f97aa6009e40f9d1d7fa80952476ca5e, https://si.imgix.net/d054e395/uploads/origins/0624a8a4-23ce-43ab-8158-94260650f61c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e827d10bbecd36aeeec193fd2048695c 2x, https://si.imgix.net/d054e395/uploads/origins/0624a8a4-23ce-43ab-8158-94260650f61c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5aac708f0e120947b4c559ec32e44302 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d054e395/uploads/origins/0624a8a4-23ce-43ab-8158-94260650f61c?bg=%23fff&auto=format%2Ccompress&f