1ba55e5bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a6d63f41220bccce568d9d552d3d718 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11da5ba4/uploads/origins/288a3fa9-b9e9-4312-abc5-e91ba55e5bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=008d6d4a36f703043013c1601bca6bd2", "srcset": "https://si.imgix.net/11da5ba4/uploads/origins/288a3fa9-b9e9-4312-abc5-e91ba55e5bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=008d6d4a36f703043013c1601bca6bd2, https://si.imgix.net/11da5ba4/uploads/origins/288a3fa9-b9e9-4312-abc5-e91ba55e5bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bbdb812b395d0b8d4c48f8dadbc41406 2x, https://si.imgix.net/11da5ba4/uploads/origins/288a3fa9-b9e9-4312-abc5-e91ba55e5bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=62e155d2f711ce0c5b744d7345da94ff 3x"}, "body": "あなたの作品が本当に大好きです。私のNLオリジナルキャラクター（OC）たちのイラスト集（マルチインタラクティブイラスト）を描いていただけないでしょうか。\n参考資料はすべて以下のリンクにまとめてあります。どうぞご自身のスタイルで私のOCたちを描いてください。\n\nOCたちの服装は、お好きなものを描いていただいて構いません。もしよろしければ、新しい衣装をデザインしていただいても結構です。\nハーマンの顔の傷については、簡略化しないでください。彼の戦術装備を描く場合：ヘルメットに関しては、暗視ゴーグルを描いても描かなくても構いません。ボディアーマーの空いている部分については、弾倉で埋めてください。描く際は「Herman-other」のイラストを参考にしてください。彼にはタトゥーがありますが、描く場合は簡略化しても構いません。\nアナは小柄でスレンダー、肌色は明るいブロンズ色です。衣装を描く際は「Ana-衣装」を参考にしてください。\n\n依頼内容に不適切な点があれば、遠慮なく再送してください。私のオリジナルキャラクターに興味がない場合は、直接キャンセルしていただいて構いません。ありがとうございます。\n\nhttps://drive.google.com/drive/folders/1XpYZZPdCZ9Mp0bEUbDd3sty8qx-WXG_M", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@komagoma/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2640563, "client_id": 2595508, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60542422/uploads/origins/588