PNG または PSD（レイヤー分け） ）\n • 表情差分： 　もし可能であれば、表情差分があるととても嬉しいです。\n • 小物： 　自由に追加していただいて構いません \n• その他： 　髪・手足が切れず、全身がしっかり入る構図を希望します 　\n将来的に商用利用の可能性があります  \n金額に不足がある場合は再送可能です。 \nご検討のほど、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Ram93AVaeFgK6C06UJVSX0QFJdHkqA3a", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crown_clock/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3035671, "client_id": 3491331, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a979d56/uploads/origins/d3c722fc-0cc5-4b18-8395-07cea87cf654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=218eb58d25a198f52652b16d953b9d89", "srcset": "https://si.imgix.net/5a979d56/uploads/origins/d3c722fc-0cc5-4b18-8395-07cea87cf654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=218eb58d25a198f52652b16d953b9d89, https://si.imgix.net/5a979d56/uploads/origins/d3c722fc-0cc5-4b18-8395-07cea87cf654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d31ce9cfbc4df4c02c32aefde500102b 2x, https://si.imgix.net/5a979d56/uploads/origins/d3c722fc-0cc5-4b18-8395-07cea87cf654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a928fadf9c7dad7b10a812f6ff89008d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a979d56/uploads/origins/d3c722fc-0cc5-4b18-8395-07cea87cf654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e02de04e1866b990fff20c064c55322", "srcset": "https://si.imgix.net/5a979d56/uploads/origins/d3c722fc-0cc5-4b18-8395-07cea87cf654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e02de04e1866b990fff20c064c55322, https://si.imgix.net/5a979d56/uploads/origins/d3c722fc-0cc5-4b18-8395-07cea87cf654?bg=%23fff&auto=format%2Ccompress&fm=webp&dp