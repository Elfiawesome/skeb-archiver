imgix.net/679fda22/uploads/origins/46f98a3d-f5b4-49e8-8eb9-5d73c1f6a97a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=77f6bf2e5960a9e43520c7d42dc5d7fb 3x"}, "body": "しぷあさん、初めまして。\n納品されてた過去のデカ乳イラスト見ました。\nリクエスト送るのでご検討ください。\n\n【キャラクター】\n遊戯王OCGから「EMユニ」、「EMコン」を爆乳で。\n\n【シチュエーション】\nユニとコンがデカチン竿役のマスターと3Pしていて、好き勝手犯されてデカ乳揺らしながらアヘりまくっているシチュ。\n\n【要望】\nユニとコンの乳サイズは片乳が最低でも頭より大きいサイズの爆乳でお願いします。\n乳はどれだけデカくなっても良いです。\n乳輪と乳首も大きめのパフィーニップル気味だとなお良いです。\nデカい乳が映えるものをお願いします。ユニとコンが色んな体位で犯されてる姿が見たいです。\n竿役は顔なしの特徴のないもので良いです。汚い竿役、デブの竿役などはやめてください。\n\n【備考】\n 納品ファイルはPSDとPNGどちらもあると嬉しいです。 \n\n以上になります。 \n\n金額の不足等、ほか不都合などありましたら遠慮なくキャンセルや再送をお願い致します。\nぜひ、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1MCIIarDFXem93pfWJCVg_buUJ5wcym2Z", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@zyarame/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3679016, "client_id": 1186917, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c03cea75/uploads/origins/3dbb3ca2-c293-4336-9107-19dd3e1586e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e84d8c068527697875c7baab23fa8e77", "srcset": "https://si.imgix.net/c03cea75/uploads/origins/3dbb3ca2-c293-4336-9107-19dd3e1586e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e84d8c068527697875c7baab23fa8e77, https://si.imgix.net/c03cea75/uploads/origins/3dbb3ca2-c293-4336-9107-19dd3e1586e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ade1770519a086f7f5c57a6afc25063 2x, https://si.imgix.net/c03cea75/uploads/origins/3dbb3ca2-c293-4336-9107-19dd3e1586e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c56d461475da1c676c6f414434e9adbf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c03cea75/uploads/origins/3dbb3ca2-c293-4336-9107-19dd3e1586e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95df05390f678ea89052009966efdeae", "srcset": "https://si.imgix.net/c03cea75/uploads/origins/3dbb3ca2-c293-4336-9107-19dd3e1586e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95df05390f678ea89052009966efdeae, https://si.imgix.net/c03cea75/uploads/origins/3dbb3ca2-c293-4336-9107-19dd3e1586e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0c5d524d7f59c3e4587210568682b21 2x, https://si.imgix.net/c03cea75/uploads/origins/3dbb3ca2-c293-4336-9107-19dd3e1586e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=713fdc4ac15448a821e94e471b54d92a 3x"}, "body": "素敵なマリアをありがとう！\nこのキャラクターをご存知ないかもしれませんが、興味を持っていただければ幸いです\n『中二病でも恋がしたい！』のニブタニ・シンカを描いてください！\n彼女は、露出度の高いブラジャーとパンティを合わせたチアリーダーの衣装を着ている\nあるいは、ブラジャーもパンティも着けていない\n彼女は完璧なプロポーションの持ち主で、自信に満ちた様子でそれを披露しています。\n彼女の体を際立たせるような、立ったままの開脚ポーズを希望します。\nその後、彼女が犯される姿や、デカチンにパイズリをする姿を見てみたいです。\nセックス、パイズリ、フェラチオなど、お好きなものをお選びください。\nご検討いただき\n\nhttps://drive.google.com/drive/folders/1Khch1MjvMJ3b2lTEjYs92lAcichmlUHo?usp=drive_link", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@zyarame/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3679016, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6303472f/uploads/origins/3bcef97d-530a-488b-91dc-1cc46d59769d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce93f3ad6ffc8fc9d7cf267086f3448f", "srcset": "https://si.imgix.net/6303472f/uploads/origins/3bcef97d-530a-488b-91dc-1cc46d59769d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce93f3ad6ffc8fc9d7cf267086f3448f, https://si.imgix.net/6303472f/uploads/origins/3bcef97d-530a-488b-91dc-1cc46d59769d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cro