only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@P2mQHhNz3LTcXVJ/works/69", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2203659, "client_id": 150510, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/532e2638/uploads/origins/10bf4c66-d0b7-4b76-a11e-1b2cda27b373?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3c304f3663f8d985bfa9c48f9ac1beb", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/532e2638/uploads/origins/10bf4c66-d0b7-4b76-a11e-1b2cda27b373?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac50ec141504b7c95838ae939da39550", "src_set": ""}, "body": "今回のリクエストは超人学園ゴウカイザーから孫華鈴のイラストをお願いしたいと思います。\n以前から書かれてるかりんのイラストが凄くお気に入りなので私も描いて貰いたいとなりましたので。\n\nかりんはOVA版の髪の長めの方で\nシチュエーションとして必殺技の飛燕烈脚を繰り出してる姿をガッツリエロエロ手加減なしに描いて貰いたいです。（乳首浮き、開脚からのマンスジ等）\n戦闘中なので表情は真剣に攻撃してる感じでお願いします。\n\nその他分かりづらい点、細かい点は全ておまかせしたいと思います。好きなように描いて貰って構いません、どうかよろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@P2mQHhNz3LTcXVJ/works/68", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2203659, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0e4afbf/uploads/origins/4fd32eb9-0702-4ff5-a18e-43a7a12db5ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a5b4372d87f6a9e3cdf4fc423848bd3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c0e4afbf/uploads/origins/4fd32eb9-0702-4ff5-a18e-43a7a12db5ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e8587755a131c662462691e0452e724", "src_set": ""}, "body": "葦賀 弦様\n初めまして過去作品を拝見いたしまして\n１件リクエストしたいです。\nVIRUS ウイルスバスター・サージの\nエリカ・チネンをお願いします。\n描いていただきたいシーンは、\n映像のhttps://www.youtube.com/watch?v=ZLar9rdD8hI\n第２話のパワードスーツ装着です。\n表情は頬を赤くして絶頂しているで、\n乳首陰核がたったまま、\n全裸→徐々にメタル・スキンが覆い→インナーが全身に密着\nの一連の流れを描いていただきたいです。\n背景等、細かい描写はお任せします。\n\nリクエスト内容、料金に不備がございましたら、\nキャンセルしていただいてかまいません。\n\nなにとぞまたご検討をお願いします", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@P2mQHhNz3LTcXVJ/works/67", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c4169df3/uploads/origins/8b96c7dc-ee27-497b-b388-c932ea9f4604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89bd0bb57005f10b08efc1b266118351", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2203659, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@P2mQHhNz3LTcXVJ/works/66", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2203659, "client_id": 62475, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/085ac6cf/uploads/origins/5a906ac5-7855-4e4c-b61e-c6c62ffc3da9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99200fcbc109a7e2cfc7c868d01b71f6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/085ac6cf/uploads/origins/5a906ac5-7855-4e4c-b61e-c6c62ffc3da9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=013f6935413a8cacca4c4bb1997e986a", "src_set": ""}, "body": "初めまして、早速依頼させていただきます\n\nエンジェルブレイドシリーズの響香が同作品に出てくるクローエ将軍とイレーナ大佐に響香の爆乳を左右同時に吸われるシチュをお願いします\n\n3人とも全裸で、構図は中央に響香、それぞれ左右にクローエ将軍とイレーナ大佐が響香の乳首を吸い上げている構図でお願いします", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@P2mQHhNz3LTcXVJ/works/65", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2203659, "client_id": 1832132, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38ee8935/uploads/origins/519a810e-70b1-4ecf-a33e-eb1f22f27348?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dcb40b00cde47308931dc2c8c49f46e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38ee8935/uploads/origins/519a810e-70b1-4ecf-a33e-eb1f22f27348?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39b3ba8968e9832da606ede82e4e0116", "src_set": ""}, "body": "シーン5(露出調教)\n※ 参考画像\n：https://booth.pximg.net/c/620x620/1e848309-f42d-4c2e-b6e1-a45463d8b007/i/4728932/074bcc4f-8c51-428e-a118-24a0b1ec095e_base_resized.jpg\n\n1.公園のベンチに並んで座り舞を露出調教\n2.ダーリンは舞の肩に腕を回し乳揉み\n3.舞はダーリンにしなだれかかり片手は手コキ・片手でスカートを捲る\n\n各種落書き\n1.ブラをオープンブラにして乳首に♡のチェーンピアス\n2.下着が半分見えるようにスカートをマイクロミニにする\n3.ヘソに乳首ピアス同様のチェーンピアス\n4.おっぱいに「89cm(G)」と落書き\n5.左目の下に「●と▼」で男子トイレマーク\n6.ガーターベルトでストッキングにローターのスイッチを挟ませる\n7.おまんこにローター挿入中\n8.ハイヒール着用\n\nシーン6(対面座位)\n1.ベンチの上で対面材\n2.構図は舞のおっぱいや結合部が見える様にベンチの斜め裏\n3.「舞の開花された性癖③ 羞恥露出癖」\n\n台詞はお任せします", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@P2mQHhNz3LTcXVJ/works/64", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2203659, "client_id": 494513, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96c4f53d/uploads/origins/5edacb77-4330-45e7-9e9c-4023be6f4c38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e9fc1d6630ba59ffe433beb3105f7a6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96c4f53d/uploads/origins/5edacb77-4330-45e7-9e9c-4023be6f4c38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ca4c2d8723b9d2cea64dc95c323d010", "src_set": ""}, "body": "どうも、葦賀さん。\n以前描いて頂いた股裂きリョナのイラストを今回は闘神伝のエリスでお願いします。\n\nエリス:闘神伝2のレオタード衣装。差分でOVAのレオタード衣装もお願いします。\n\n1.ルカに股裂きで責められるエリス。\n前回のソフィア同様ルカに股裂きされている舞をエリスに差し替えた形で描いて下さい。↓\nhttps://www.pixiv.net/artworks/124560081\n･この時股裂きによる痛みで、\n「痛い！痛ぁい‼」「助けて！ソフィアお姉さま‼」\n等のセリフを入れて下さい。\n\n2.失禁しながら気絶するエリス。\n･この時のエリスは泣きながら涎を垂らした表情で。\n･またこのエリスを見たルカは興奮して、\n「この娘（こ）、イジメがいがあってかわいい。♥」\n等のセリフを入れて下さい。\n\n以上でよろしくお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@P2mQHhNz3LTcXVJ/works/63", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2203659, "client_id": 455002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/25bda2a6/uploads/origins/4ac232f8-769b-4464-aff1-96961c152e01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cca101899e786176f97b80be6df80672", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25bda2a6/uploads/origins/4ac232f8-769b-4464-aff1-96961c152e01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=985f8f2a2ecbd010b044ae0df362a2f2", "src_set": ""}, "body": "お久しぶりです\n『超人学園ゴウカイザー』の『かりん（孫華鈴）』のイラストをお願いします。\n\n細かなシチュとしましては\nかりんは以前描かれていた\nhttps://skeb.jp/@P2mQHhNz3LTcXVJ/works/26\nの様な感じで乳首、マンスジがくっきりと浮き出ている感じで。\nポーズは資料画像の様にまんぐり返しをしながらダブルピース。\n表情はノリノリの笑顔でやっている感じでお願いします。\n他、不明瞭な点はおまかせいたします。\n\n以上になります。\nよろしければご検討の程よろしくお願いします。\n\nhttps://skeb.jp/@Hagfish21/works/164", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@P2mQHhNz3LTcXVJ/works/62", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2203659, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/77ef2a47/uploads/origins/eee488b5-8db8-4439-bbb5-bb89cf595925?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73ad3fa06e6b0f69928f6a97a3e2c2f7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/77ef2a47/uploads/origins/eee488b5-8db8-4439-bbb5-bb89cf595925?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95b0bb75655135e8aa302a10cd9f99d9", "src_set": ""}, "body": "こんにちは。ご依頼させて頂きます。よろしくお願いいたします。\n\n春麗無残！背後からの強襲！\npixivの上記のタイトルのイラストの続きを描いて欲しくてご依頼させて頂く事になりました。\nこの春麗は涙まで溜めてて弱々しくてそそりますね！これだけズタズタにしてるなら、バルログの勝利場面が見たくなりました。\nつきましては、トドメで春麗のみぞおちに爪をぶっ刺してる場面をお願い致します。\n\n爪による傷は上記のタイトルのを踏襲しつつ、さらに切り刻まれて両方の乳房の下乳部分・左乳房の上乳部分に3本筋の裂傷を、肩の辺りや腕やお腹にも裂傷を加えて欲しいです。（お腹も指定してますが内臓描写は不要です）\nとにかくズッタズタにされた後にトドメという感じで、他にも傷を加えて下さってかまいません。\nパンツにはさらに血が滲み込んでる感じで。あと、ブラジャーはギリギリ残して頂き、部屋着も残せるだけ残して欲しいです！（裸にさえならなければと思います）\n春麗の表情は血を吐いて「ガハッ…！」という感じが希望で、涙も散ってる感じにして頂ければと。\nこんな過激な内容となりますが、可能でございましたらよろしくお願いいたします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@P2mQHhNz3LTcXVJ/works/61", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/16a63ccd/uploads/origins/d16c5623-2f77-4adb-a017-852ce1212bc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=24c2c13a9c835aaf1ad2df0d547dd36f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2203659, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@P2mQHhNz3LTcXVJ/works/60", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3a539805/uploads/origins/058