ライスのトレーナーと｢何この人怖｣という反応をする他のトレーナー\n\n以上になります\n\nその他指定してない箇所はお任せします\n\n幼馴染とトレーナーの外見や設定資料のURLを載せておきますのでご確認ください\n\nライス幼馴染くんの髪型は資料内の｢イメチェン後｣の方でお願いしたいです\n\nhttps://drive.google.com/drive/folders/1SeaZ31YufgCeU6B6aGas88afdw_JbqHR?usp=sharing\n\n金額不足や描くのが難しい場合は再送またはキャンセルをお願いします\n\n変わったご依頼になりまして恐縮ですが、ご検討いただけますと幸いに存じます", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1125675, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "新星‼️ゴガゴちゃん", "screen_name": "go_ga_go", "avatar_url": "https://pbs.twimg.com/profile_images/1785715651266686978/-oi8Zuym.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1315849873808265216/1758116921/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 1516066, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "🕊BlandocoPaloma", "screen_name": "BlandocoPalomaW", "avatar_url": "https://www.gravatar.com/avatar/?d=identicon", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "novel"}], "banned": false, "nc": 145}, {"id": 1929346, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ふせんりょ", "screen_name": "fusenryo2", "avatar_url": "https://pbs.twimg.com/profile_images/1570380827116343297/3nAQlmbS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1429384473171283969/1629629288/1500x500", "appeal_receivable": false, "popular_creator_rank": 45, "request_master_rank": null, "first_requester_rank": null, "deleted_at":