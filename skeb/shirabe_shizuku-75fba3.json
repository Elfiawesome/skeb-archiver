育員の手に負えなくなって、みんなで逃げろ～って。\nふふ、それで目が覚めちゃった。\nえ、いつも変な夢見てるねって？\n想像力が豊かだって言ってほしいなぁ～。\n\nあ、あくびしてる。眠くなってきた？\nふあぁ。俺も落ち着いたら眠くなってきた。\nそろそろ横になろっかな。\nあ、でもその前に。\nちゅ。\nはい、ぐっすり眠れるおまじない。\nふふ、おやすみ。", "nc": 1, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@A_shidare/works/84", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 456489, "client_id": 3091795, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97a15854/uploads/origins/830b5c36-ca39-43dc-8ac1-1af11b35b1c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40b9eac5b5b927a6efa6baf796903bdb", "srcset": "https://si.imgix.net/97a15854/uploads/origins/830b5c36-ca39-43dc-8ac1-1af11b35b1c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40b9eac5b5b927a6efa6baf796903bdb, https://si.imgix.net/97a15854/uploads/origins/830b5c36-ca39-43dc-8ac1-1af11b35b1c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24bb4b78c96df934a7f8cba54be8097c 2x, https://si.imgix.net/97a15854/uploads/origins/830b5c36-ca39-43dc-8ac1-1af11b35b1c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=785d19952cc16717d38418e58a268c85 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97a15854/uploads/origins/830b5c36-ca39-43dc-8ac1-1af11b35b1c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f696f3f01be1e5b352af5f3577dcf8d", "srcset": "https://si.imgix.net/97a15854/uploads/origins/830b5c36-ca39-43dc-8ac1-1af11b35b1c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f696f3f01be1e5b352af5f3577dcf8d, https://si.imgix.net/97a15854/uploads/origins/830b5c36-ca39-43dc-8ac1-1af11b35b1c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ade2b01b1453085ed50ea1af323ba