top&w=200&h=200&s=b582ec3a4034e942a55d72cbdd37c1ca 2x, https://si.imgix.net/a626801d/uploads/origins/ccdd51cb-8108-40ce-a5a1-eb1f2e7cd50f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bd81e4401936543dc1ce876b761fd42 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a626801d/uploads/origins/ccdd51cb-8108-40ce-a5a1-eb1f2e7cd50f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20e77243dbac081bc1484e0c2ec225ae", "srcset": "https://si.imgix.net/a626801d/uploads/origins/ccdd51cb-8108-40ce-a5a1-eb1f2e7cd50f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20e77243dbac081bc1484e0c2ec225ae, https://si.imgix.net/a626801d/uploads/origins/ccdd51cb-8108-40ce-a5a1-eb1f2e7cd50f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac7fc236a6a4769cc530f3c5451339d4 2x, https://si.imgix.net/a626801d/uploads/origins/ccdd51cb-8108-40ce-a5a1-eb1f2e7cd50f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2f3a82dcf0255d3f2214b268f9e53e1 3x"}, "body": "こんにちは！前回の銀狼ちゃんがすごく気に入ってるので、今度は崩壊スターレイルのキャラクター、停雲のイラストを依頼させてください。\n\nアイコンで既にお描きになっているので改めて説明する必要はないと思いますが、停雲はちょっとお姉さんチックな色気のあるおっとりしたキャラクターですよね。うーん癒し系！いつもお世話になってます。\n以下がリクエストとなります。\n前回の構図が気に入ってるので、今回も似たような構図で別のキャラ、という趣旨の依頼です。\n\nイラストの構図：サイズの指定はありませんが、ある程度解像度が大きいと嬉しいです。\n（お受け頂けた場合、Skebの印刷サービスを検討してます。）\n\nシチュエーション：停雲とお家デート\nバックハグの構図でお願いします！\nこれ以外の細かい指定はこちらからはないので、お任せします！\n前回の銀狼みたいに表情差分があれば素敵かなぁ、程度です。\n\nお願い：\n・依頼キャラ以外の人物の身体の描写が入る場合は、「開拓者（星or穹）」か、「不明の人物（服飾に特徴がない、透過されている、黒塗り等）」でお願いします。\n・停雲の衣類は基本デフォルトのものを参照してください。\nとはいえ元の服の装飾が細かかったりとかあるのを全力で描きこんで欲しいわけではないので、服飾等々捏造OKです。\n他にも代わりに良い感じの服が思いつけばそれでも！\n脚は太もものあたりはむっちりだとおもいます。そうに違いないです。\n\n\nうまく言語化しきれていない部分もありますが、以上の内容で良ければお受けください。\n以上、よろしくお願いします！\n\nhttps://assets.clip-studio.com/ja-jp/detail?id=1884440", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amamitsutsuki12/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2803331, "client_id": 3307218, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95055217/uploads/origins/0982c48b-e4b7-4966-a8fd-970a1b4c3601?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6fc4f801200df52fefe08b3c4d82d30", "srcset": "https://si.imgix.net/95055217/uploads/origins/0982c48b-e4b7-4966-a8fd-970a1b4c3601?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6fc4f801200df52fefe08b3c4d82d30, https://si.imgix.net/95055217/uploads/origins/0982c48b-e4b7-4966-a8fd-970a1b4c3601?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01082400e5d22470fc719cc8eb741fe8 2x, https://si.imgix.net/95055217/uploads/origins/0982c48b-e4b7-4966-a8fd-970a1b4c3601?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91fc399205dd6ac405710c4203715570 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95055217/uploads/origins/0982c48b-e4b7-4966-a8fd-970a1b4c3601?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb4d585175b77bea253435996b504a77", "srcset": "https://si.imgix.net/95055217/uploads/origins/0982c48b-e4b7-4966-a8fd-970a1b4c3601?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb4d585175b77bea253435996b504a77, https://si.imgix.net/95055217/uploads/origins/0982c48b-e4b7-4966-a8fd-970a1b4c3601?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa10600a6f9f743c4cab85538fb57ee6 2x, https://si.imgix.net/95055217/uploads/origins/0982c48b-e4b7-4966-a8fd-970a1b4c3601?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=67bc7c315e4e32198a91fce2a8fea8cf 3x"}, "body": "こんにちは、私はあなたのスシャンとルオシャンのイラストのファンです。スシャンの描き方が好きです。\n\n本海スターレールのスシャンのイラストをお願いしたいです。スシャンは伝統的なメイド服を着ています（服は長袖でなければなりません）。\n表情は、スシャンが前を向いているので、それにふさわしい笑顔を描いてください。\nアクションは、ハートのジェスチャーを描いてください。ハートのジェスチャーはどんなものでもかまいませんので、都合のいいほうを描いてください。\n そのほかにも、ルオチャが満足そうに微笑んでくれることを願っています。要するに、イラストの中心はスシャンなのだ。\n\n スシャンの伝統的なメイド服は、私が描いたファンアートを参考にしてほしい。ヘアアクセサリーは好みで変えてもいいが、髪型はダブルポニーテールのまま。メイド服の設定は少し変えても大丈夫です。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1CWb5Qn5X1CUQLAofbb0Ctcfnds4eAUkB\n\nhttps://drive.google.com/drive/folders/1CWb5Qn5X1CUQLAofbb0Ctcfnds4eAUkB", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amamitsutsuki12/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2803331, "client_id": 1627681, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9a6f086/uploads/origins/f739cf10-8cf9-480b-9745-0fea1a9c10a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe3ac6ea7ff524c8b168ac929bc44408", "srcset": "https://si.imgix.net/e9a6f086/uploads/origins/f739cf10-8cf9-480b-9745-0fea1a9c10a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe3ac6ea7ff524c8b168ac929bc44408, https://si.imgix.net/e9a6f086/uploads/origins/f739cf10-8cf9-480b-9745-0fea1a9c10a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cdade5d869b5f5b56adc3450aefd20e0 2x, https://si.imgix.net/e9a6f086/uploads/origins/f739cf10-8cf9-480b-9745-0fea1a9c10a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5375151831fd7ea02e9686444fd5ed4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9a6f086/uploads/origins/f739cf10-8cf9-480b-9745-0fea1a9c10a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81ca327f374582afde7cd1441e19fdb7", "srcset": "https://si.imgix.net/e9a6f086/uploads/origins/f739cf10-8cf9-480b-9745-0fea1a9c10a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81ca327f374582afde7cd1441e19fdb7, https://si.imgix.net/e9a6f086/uploads/origins/f739cf10-8cf9-480b-9745-0fea1a9c10a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8692ccd622021b798ef1323bc268d047 2x, https://si.imgix.net/e9a6f086/uploads/origins/f739cf10-8cf9-480b-9745-0fea1a9c10a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=58d1e09abab587cb911f46d5654ec8b1 3x"}, "body": "こんにちは！\nアピールありがとうございます。\n友人のOC（カエデ）をスタレレの刃（ブレード）で可愛く描いてください。\n必要であれば、正しい金額でアピールしてください。\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1W2SZJvHZDYC0O7vNDgl6NrFYz1kCXuQ7?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amamitsutsuki12/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2803331, "client_id": 2597785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ac18f17/uploads/origins/39359bdc-3eb9-4ec6-b68b-dbf22a07cd75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=375e8a1724a1179ff55b238de987ee52", "srcset": "https://si.imgix.net/2ac18f17/uploads/origins/39359bdc-3eb9-4ec6-b68b-dbf22a07cd75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=375e8a1724a1179ff55b238de987ee52, https://si.imgix.net/2ac18f17/uploads/origins/39359bdc-3eb9-4ec6-b68b-dbf22a07cd75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ba32a3741bd37bd6187271056980668 2x, https://si.imgix.net/2ac18f17/uploads/origins/39359bdc-3eb9-4ec6-b68b-dbf22a07cd75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7135c65daa5f3b5b68854997cacce8c2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ac18f17/uploads/origins/39359bdc-3eb9-4ec6-b68b-dbf22a07cd75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a905dbe9b0cfb6c7b14fc713d9ec1999", "srcset": "https://si.imgix.net/2ac18f17/uploads/origins/39359bdc-3eb9-4ec6-b68b-dbf22a07cd75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a905dbe9b0cfb6c7b14fc713d9ec1999, https://si.imgix.net/2ac18f17/uploads/origins/39359bdc-3eb9-4ec6-b68b-dbf22a07cd75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1505b3d2200b5189e1e2a8a52e3974aa 2x, https://si.imgix.net/2ac18f17/uploads/origins/39359bdc-3eb9-4ec6-b68b-dbf22a07cd75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eacb151608008397593c1bc485fc76bb 3x"}, "body": "初めまして、Xでイラストを拝見して、心惹かれるような表情と色遣いだなと感じて、是非とも依頼をさせていただきたいと思いました。\n\n私の推しの個人で活動しているVtuberの桃奈みゆい(https://twitter.com/MomonyaMiyui)さんのファンアートを依頼させていただきたいです(背景透過もあると使用しやすいかなと思います)。\nそしてそのファンアートに関して、桃奈さんが配信やCi-enなどのサムネイルなどの桃奈さんが活動で使用する旨の許可を頂ければと思います。\n\n桃奈さんは、定期的に歌枠を配信していて昭和歌謡曲も配信で披露することもあります。そこで和服を着ている桃奈さんを描いていただければと思います。和服の柄やポーズはお任せでお願いします。\n桃奈さんは髪型もいくつかあるのですが、和装によく似合うストレートロングで、サイドはゆる巻きしているものでお願いします。\n参考資料として、桃奈さんの三面図のストレートロングのゆる巻きを乗せさせていただきます。\n\n桃奈さん三面図(ストレートロングのゆる巻き):\nhttps://twitter.com/MomonyaMiyui/status/1706192545230020744/photo/2\n\n桃奈さんの髪型と新衣装披露の配信\nhttps://www.youtube.com/live/x1ti3hPxYGo?si=xkLosrDbLvsM-OlU&t=1860\n\nhttps://www.youtube.com/@MomonyaMiyui", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amamitsutsuki12/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2803331, "client_id": 1250821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1302de29/uploads/origins/9c938075-74b7-49bc-99d5-890564935281?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16c2863d01216403103bda223df6ec39", "srcset": "https://si.imgix.net/1302de29/uploads/origins/9c938075-74b7-49bc-99d5-890564935281?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16c2863d01216403103bda223df6ec39, https://si.imgix.net/1302de29/uploads/origins/9c938075-74b7-49bc-99d5-890564935281?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b3ea76dbcf0eb38d63e2fe84f8c0de6 2x, https://si.imgix.net/1302de29/uploads/origins/9c938075-74b7-49bc-99d5-890564935281?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84805d91b7716ded07b33ea9aa101329 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1302de29/uploads/origins/9c938075-74b7-49bc-99d5-890564935281?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39e597040645dd1432675198bce4b11b", "srcset": "https://si.imgix.net/1302de29/uploads/origins/9c938075-74b7-49bc-99d5-890564935281?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39e597040645dd1432675198bce4b11b, https://si.imgix.net/1302de29/uploads/origins/9c938075-74b7-49bc-99d5-890564935281?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ba5188ef5421a17cfc22fb66e33e8163 2x, https://si.imgix.net/1302de29/uploads/origins/9c938075-74b7-49bc-99d5-890564935281?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3f4c6e2c755c36802402855a3ae1e2b 3x"}, "body": "はじめまして！\n創作活動で他デザイナー様に作成してもらったオリキャラの\nイメージを広げるため二次創作を御願いしたいです。\n\n未来世界で活躍するキャラです。\n頼れる酒豪の姐さんです。（25歳ぐらい）\n衣装はそのまま系でも日常系の別衣装でも良いです。\n武器は無くても良いです。\n\n使用したい範囲は\n自前の紹介サイトでの掲載や、ＳＮＳでの掲載となります。\nまたトリミング使用もしたいので\n問題ないか御確認ください。\n\n御面倒かけますが\nよろしく御検討ください！\n\nhttps://twitter.com/oniyatsuhashi/status/1573698377967013888?s=20", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amamitsutsuki12/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/368