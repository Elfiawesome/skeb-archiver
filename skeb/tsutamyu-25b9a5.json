3429326-5be0-4479-b3d2-e2c7ff170e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a407454cd53e3fc0c9f6063434253588, https://si.imgix.net/ef96b495/uploads/origins/53429326-5be0-4479-b3d2-e2c7ff170e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05bcdcc955290d6769d908963c1f1ec7 2x, https://si.imgix.net/ef96b495/uploads/origins/53429326-5be0-4479-b3d2-e2c7ff170e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=022af4a51a1fc6502f187876239cff70 3x"}, "body": "蔦μ様、\n\n初めまして、きのと申します。\n蔦μ様の作品がとても素敵で、ぜひ依頼させていただきたくメッセージを送りました！\n\n全身の立ち絵を描いてくださると嬉しいです！\n使用用途：TRPG、その他個人の利用範囲\n\nリンク先に設定やイメージを載せております。\nポーズなど詳細はお任せいたします！\nhttps://drive.google.com/drive/folders/17s3zYI8GcNTa90lc0ISwUvT3jTZM9ER8?usp=drive_link\n\n\n金額の不備等ございましたら遠慮なくキャンセルや再送申請していただければと思います。\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/17s3zYI8GcNTa90lc0ISwUvT3jTZM9ER8?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsutamyu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4048106, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b3d6360/uploads/origins/d01457ea-1dca-4f0e-99ba-24bc611d9fc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0704676c8e5e6e24bc49ca4e2b82137", "srcset": "https://si.imgix.net/5b3d6360/uploads/origins/d01457ea-1dca-4f0e-99ba-24bc611d9fc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0704676c8e5e6e24bc49ca4e2b82137, https://si.imgix.net/5b3d6360/uploads/origins/d01457ea-1dca-4f0e-99ba-24bc611d9fc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39ba1975e3754e96754edc006a9de0bd 2x, https://si.imgix.net/5b3d6360/uploads/origins/d01457ea-1dca-4f0e-99ba-24bc611d9fc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=474e41a1acd4effa0c19b68d5e219ba7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b3d6360/uploads/origins/d01457ea-1dca-4f0e-99ba-24bc611d9fc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=467625285c298872baec9dc725c76b53", "srcset": "https://si.imgix.net/5b3d6360/uploads/origins/d01457ea-1dca-4f0e-99ba-24bc611d9fc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=467625285c298872baec9dc725c76b53, https://si.imgix.net/5b3d6360/uploads/origins/d01457ea-1dca-4f0e-99ba-24bc611d9fc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8a812e82d044ba0a09d3d273c42bf7df 2x, https://si.imgix.net/5b3d6360/uploads/origins/d01457ea-1dca-4f0e-99ba-24bc611d9fc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4f8416aebafbfe9a5378fe98d3310e17 3x"}, "body": "先生の描かれる人物表現がとても美しく、キャラクターの表情や雰囲気の描写、画面全体の華やかさが本当に好きです。\n今回はOC「Uta」と「Uchuu」の2人イラストをご依頼したいです。\n参考はこちらです：\nhttps://x.com/tsutamyu/status/1994245821131575674/photo/1\n参考画像のような、雑誌の表紙のように印象的でおしゃれなイラストを希望しております。\n構図は縦長・横長どちらでも大丈夫ですので、先生が一番魅力的に見える形で自由に描いていただけますと嬉しいです。\nUtaは、獣医・医療に関わるキャラクターです。\n少し真面目で丁寧な性格で、仕事に対して責任感があり、動物の小さな変化にもよく気づく子です。可愛らしさもありますが、仕事中は落ち着いていて、周りをよく見て行動するタイプです。\nUchuuも獣医として働くキャラクターです。\n穏やかでやさしく、動物や周りの人を安心させるような雰囲気を持っています。忙しい現場でも落ち着いて対応できる、やわらかく温かい印象の子です。\n今回は原本の衣装ではなく、2人に似合う現代風・ファッション感のある服装、または日常的でおしゃれな服装を新しくデザインしていただきたいです。\n2人とも獣医の背景があるため、可能でしたら小動物や猫・犬など、動物に関係する要素も少し入れていただけますと嬉しいです。\n服装、表情、ポーズ、色味、雑誌表紙のようなデザイン感など、細かい部分は先生のご感性にお任せしたいです。\n使用用途：本人のVTuber活動全般（配信サムネイル、SNSアイコンやヘッダー・告知、ファンクラブ特典など）\n可能でしたらPSD形式での納品を希望しております。\nもし現在の金額では難しい場合は、再送や金額調整も可能ですので、ご無理のない範囲でご検討いただけますと幸いです。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1RYB38jhRjgVud-DhdcJQTd8BMqvju9l1?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsuta