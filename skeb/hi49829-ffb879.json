bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2605a422d667d4d58f938ad1979c6593 2x, https://si.imgix.net/e678adb6/uploads/origins/78f9bdd4-0e2a-490c-9093-7aae25490fc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=19787579781d70c0173b6c2d790f8b57 3x"}, "body": "こんばんは、以前は大変お世話になりました。\nyokozawaさんに描いていただいたチャイナのocがあまりにも素敵だったため、またご依頼したく思いリクエスト失礼します。\n\nocの服デザインをお願いしたく思っております。ocの資料はリンク内に入っています。\n\nご留意いただきたいこと⬇️\n・ocの髪は黒髪前髪重めパッツン、腰あたりまでの黒髪ストレート(ヘアアレンジ◎)\n・瞳は黒に限りなく近い紫色\n・こちらから見て頬の右側真ん中辺りに三角形のほくろ(資料あります)\n\n服の系統の希望⬇️\n・シースルー素材が扱われていると嬉しいです。\n・量産、地雷系というよりどちらかというとスナ系の方が着ることは多いです。\n・靴は太いヒールのものなら履きます。ピンヒールは履きません。ぺたんこでももちろん構いません🍒◎\n・成人女性のデート服、というイメージでお願いしたいですт тどちらかというと落ち着いた色味のお洋服の方が嬉しいです。\n・どこでもいいので、白百合もしくは青い薔薇のモチーフを入れていただけるととても嬉しいです(これはなくても大丈夫です🍒◎)\n\n他、お好きなように描いていただけると嬉しいです。金額不足、資料不足などありましたら再送、またはキャンセルをお願いします。\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1GnKbgfv-FibhsJLlBUi0T3cpKDwuAM6m", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chce_a/works/198", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3118783, "client_id": 3163043, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28cefa4b/uploads/origins/74d8c5bd-0903-4e38-a440-e874245ee057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9423e3a9a8cd70f0b973d638708efec", "srcset": "https://si.imgix.net/28cefa4b/uploads/origins/74d8c5bd-0903-4e38-a440-e874245ee057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9423e3a9a8cd70f0b973d638708efec, https://si.imgix.net/28cefa4b/uploads/origins/74d8c5bd-0903-4e38-a440-e874245ee057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c84802348a65747b0b1df723dfb3b07a 2x, https://si.imgix.net/28cefa4b/uploads/origins/74d8c5bd-0903-4e38-a440-e874245ee057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=580ad9cb069642a61b793e1848698f04 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28cefa4b/uploads/origins/74d8c5bd-0903-4e38-a440-e874245ee057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb25c12df8bcd79609907345e59fdfaf", "srcset": "https://si.imgix.net/28cefa4b/uploads/origins/74d8c5bd-0903-4e38-a440-e874245ee057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb25c12df8bcd79609907345e59fdfaf, https://si.imgix.net/28cefa4b/uploads/origins/74d8c5bd-0903-4e38-a440-e874245ee057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f1401dff75fbc01bd6bf14105fa16036 2x, https://si.imgix.net/28cefa4b/uploads/origins/74d8c5bd-0903-4e38-a440-e874245ee057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=353079dfe9a92cac6b7db8ab403ea139 3x"}, "body": "chanceさんの絵柄でocを見たく思い、リクエスト失礼します。\n\n服装などの資料はリンク内にありますが、資料とは別にお好きに描いていただきたく思っております。難しいようでしたら資料を参考にしていただけたらと思います。\n\n希望の構図など\n特にありません。お好きに描かれてください。\n色々な服装、表情のocを1枚に詰めていただけると嬉しいです。\n参考までに、よくする表情は「照れ顔」「真っ赤な顔」「涙目」などがあります。\n\nご留意いただきたいこと\n目の色は明るい紫でも黒でもなく、黒に近い暗い紫となっています。\n眉は困り眉です。\n大きなインテークは避けていただけると有難いです。基本インテークはありません。\n口が小さく、所謂うさぎ口のような口をよくします。\n\n内容に不備があったりした場合は再送やキャンセルをお願いいたします。\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Sb9TPp5pDQX-DTrsYUr4dgtYnFulux9I\n\nhttps://drive.google.com/drive/folders/1Sb9TPp5pDQX-DTrsYUr4dgtYnFulux9I", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@000000yoko/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3884163, "client_id": 3163043, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c021c54b81d57497736b4c9c2cc01a8d", "srcset": "https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c021c54b81d57497736b4c9c2cc01a8d, https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e146a2d5fff85f8111a14d579db1546 2x, https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb05ad798e4dfe45fa2cc10bdd2858d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c09eb3f6d74e7c5f241ab7017ec674b", "srcset": "https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c09eb3f6d74e7c5f241ab7017ec674b, https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e47209fd5b0e4a223d24e048fb8f4696 2x, https://si.imgix.net/76cd005d/uploads/origins/3f7cb81e-0727-4e31-a0fa-c37b26abaf56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=39a07aaaf0b3aa04462f68a0182f066d 3x"}, "body": "はじめまして、チャイナ服のocを描いていただきたく思い、リクエスト失礼します。\n\nチャイナ服の全体のイメージは資料の中にあるロングのスリットが入っているもので、胸元、腕周り、色味をもうひとつのチャイナ服のように描いていただきたいです。靴は資料のようなものでお願いいたします。\n\n・全体の色味➡️白\n・胸元➡️谷間が見えるくらいの深さに開いている\n・腕周り➡️シアー素材の布多めのイメージ\n・立ち絵構図➡️特に希望なし\n\n髪型差分で描いていただきたいものも資料に入れていますが、金額不足などありましたら髪型はoc資料のものと同じ、黒髪前髪ぱっつんのストレートロングでお願いしたいです。もし差分で描いていただける際にも、前髪だけはoc資料と同じものでお願いいたします。\n\nまた、資料の中に服装イメージ図を添付しておりますので、そちらを参考にしていただけるとありがたいです。\n\nocの容姿についてなのですが、眉は困り眉(八の字眉でも可)、瞳の色は黒でも明るい紫でもなく、黒に近い暗い紫でお願いいたします。\n\n金額不足や資料不足などありましたら、再送またはキャンセルをしていただけるとありがたいです。ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1wDBgAmedd4-vVhv4YDMeFePpzCzKehEn", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 106346, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "稲荷屋", "screen_name": "inariyan", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F2e82494f-0bb9-4af5-ba4a-61c41465b01d.webp&avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 537021, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "JESSICA_NINA@Chrono Re:birth", "screen_name": "JESICA_NINA1124", "avatar_url": "https://pbs.twimg.com/profile_images/1954477587818033152/x4tCF7Gy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/627514246/1754818745/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 544137, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "山下くん", "screen_name": "9006tsmy", "avatar_url": "https://pbs.twimg.com/profile_images/1709084925704695808/uwUEZD-n.jpg", "header_url": "https://pbs.twimg.com/profile_banners/469938042/1667927703/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all