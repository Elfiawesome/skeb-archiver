シナリオ出身者なので皆帯刀or抜刀しているととても嬉しいです！\n\n・希望等身\n2等身でお願いします。\n\n以上です。\n依頼人数が５人のため心ばかりではありますが依頼金額を上げさせていただいております。\n\nskebに不慣れなため、至らない点がありましたら申し訳ございません。\nご検討のほどよろしくお願いいたします。\n暑い日が続きます。どうぞご自愛くださいませ。\n\nhttps://drive.google.com/file/d/1hYDSSuexXpLuxkWX-1iMBUyLwTDknhZl/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kikori_kiri/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bcc1449a/uploads/origins/d8f1be4d-0750-4f19-8983-e708e21a37dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66b38d29a0ee641714b6af07b32eb15b", "srcset": "https://si.imgix.net/bcc1449a/uploads/origins/d8f1be4d-0750-4f19-8983-e708e21a37dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66b38d29a0ee641714b6af07b32eb15b, https://si.imgix.net/bcc1449a/uploads/origins/d8f1be4d-0750-4f19-8983-e708e21a37dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ebd67e711122b5b63505fd984c7890f 2x, https://si.imgix.net/bcc1449a/uploads/origins/d8f1be4d-0750-4f19-8983-e708e21a37dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75b186e6f63033e42852eb265710196c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3472343, "client_id": 1677022, "nc": 145}, {"path": "/@kikori_kiri/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3472343, "client_id": 1774054, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8610480/uploads/origins/5c2f1a1a-e72d-49f0-a783