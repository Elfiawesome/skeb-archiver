f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d636a313dc9ea9d6cb4164eb45251447", "srcset": "https://si.imgix.net/efe93ffd/uploads/origins/7281c078-7b71-46af-bfa4-5e015d2b77e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d636a313dc9ea9d6cb4164eb45251447, https://si.imgix.net/efe93ffd/uploads/origins/7281c078-7b71-46af-bfa4-5e015d2b77e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd1f3e9ab263042c4be08cc650260a2e 2x, https://si.imgix.net/efe93ffd/uploads/origins/7281c078-7b71-46af-bfa4-5e015d2b77e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=428832e3c4229656ccc9dec1c36b481b 3x"}, "body": "らっこフォーエバーうにちゃんへ依頼お願いします。\n\n▼依頼内容\nグッズ用のイラスト\n2人\n2頭身\nSDキャラ\n\n▼使用用途\n画像を自分と相手のみ共有/継続卓での部屋に使用\n相手にプレゼントするためのグッズを自作するため\n（完成した場合イラストを使用したグッズの画像をSNSで共有します）\n\n▼　グッズについて\nこちらの動画を参考に作成したいと思ってます\nhttps://www.youtube.com/watch?v=_lUEa2axYT8\nhttps://www.youtube.com/watch?v=GX0KdHIBeG8\n\nもこもこなたろうちゃんのSD絵絶対可愛いので作ります。\n\n▼　キャラクター\n1人目：枷景・ニードベッグ\nキャラシ(ネタバレなし)→https://iachara.com/view/8952312\n\n2人目：スティーブン・ハリー・ローランド\nキャラシ(ネタバレなし)→https://iachara.com/view/8929217\n\n▼　2人の詳細と略歴\n・IF未来エンドで2人とも付き合うことになった\n・愛の大きさはソウさん＞＞＞＞＞＞＞＞＞超えられない壁＞＞＞＞＞＞＞巨大隕石＞＞＞＞＞＞枷景さんくらいです\n・枷景さんは素直じゃないし天邪鬼でツンツンデレしてるしソウさんは素直でストレートに愛を伝えてデレデレしてる\n・相手への表情はいつも枷景さんはツーンとしてるけど顔赤いです。ソウさんはにっこにこしてるか甘いマスク顔してる\n・ハート飛ばしてるのはソウさん\n・コインランドリーで出会う→枷景さんに興味持つソウさん→ちょくちょく家に訪れる→一緒に旅行行く→ソウさんから告白し付き合う→一緒に住む←今ここ\n\nサプライズでプレゼントしたいです。\nよろしくお願いします。\n\nhttps://media.discordapp.net/attachments/1246453980285108245/1266984906995793972/image.png?ex=68bfb5a5&is=68be6425&hm=8291e9a94188ef7b136ab163d4d70d63dd6d8053c37d943b3967c62253e3cc8a&=&format=webp&quality=lossless", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kikori_kiri/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3472343, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a03269b1/uploads/origins/d5ff8cba-628e-4504-955e-d6fe7c91fb03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7b93e148e9b15cd43a7fc3a055af693", "srcset": "https://si.imgix.net/a03269b1/uploads/origins/d5ff8cba-628e-4504-955e-d6fe7c91fb03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7b93e148e9b15cd43a7fc3a055af693, https://si.imgix.net/a03269b1/uploads/origins/d5ff8cba-628e-4504-955e-d6fe7c91fb03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c60da0f6f7d0177f613dc40b2696858 2x, https://si.imgix.net/a03269b1/uploads/origins/d5ff8cba-628e-4504-955e-d6fe7c91fb03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66f4c90fd21d3e2e0ff20a323f84ec78 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a03269b1/uploads/origins/d5ff8cba-628e-4504-955e-d6fe7c91fb03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27fb0f4a9d87efce2fa9bc0f71dc48eb", "srcset": "https://si.imgix.net/a03269b1/uploads/origins/d5ff8cba-628e-4504-955e-d6fe7c91fb03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27fb0f4a9d87efce2fa9bc0f71dc48eb, https://si.imgix.net/a03269b1/uploads/origins/d5ff8cba-628e-4504-955e-d6fe7c91fb03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6501a1f9e31906215944b70a9fdd60c3 2x, https://si.imgix.net/a03269b1/uploads/origins/d5ff8cba-628e-4504-955e-d6fe7c91fb03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=791b55d17f286c364df3cd6b54aee84c 3x"}, "body": "ｳﾆたろう様、はじめまして！\n7月下旬のskeb宣伝にてとても素敵なSDさんを拝見し、リクエストを送らせていただきました。\n\n⚪︎依頼内容\n・等身は2頭身をお願いいたします。\n・『プルガトリウムの夜』『四季送り』『VOID』の自探索者3名を依頼させていただきたいです。\n・3人に面識などはなく、自探索者詰めとして依頼させていただければと思います。\n・デザインや表情など、画像ではわかりにくい箇所は自由に改変･省略いただいて構いません。\n(参考画像はページ下記URLにて掲載)\n\n⚪︎用途\n・個人鑑賞\n・可能であれば、個人で使用するシャカシャカスマホケースを作成する際、アクリルグッズ化をさせていただきたいです(完全個人用/非商用)\n\n⚪︎キャラクター詳細\n※各シナリオのネタバレや秘匿内容は含んでおりません\n①プルガトリウムの夜(HO1 正義の代行者)\n⚫︎男性/38歳/184cm\n⚫︎性格\n　猪突猛進で浅慮な刑事。足がとても早いが致命的に頭が悪い。\n　細かいことを気にせずガハハと笑う陽気なおっちゃんだが、正義執行の為なら犠牲を厭わない冷酷で安直な考え方を持つ。\n\n②四季送り(HO肆 冬)\n⚫︎女性/24歳/160cm\n⚫︎性格：\n　底抜けに明るく能天気な若おばあちゃん。老人風の喋り方で常にわははとご機嫌にしている。\n　大変な読書家であり、積読消化の為ならば平気で仕事をサボる。超マイペースかつ個人主義的。\n\n③VOID(HO4 旧型アンドロイド)\n⚫︎アンドロイド/男性/23歳/181cm/\n⚫︎性格\n　ぶっきらぼうでツンツンしているが根は素直なアンドロイド。あまり笑わず、普段は仏頂面。\n　ファンブルを連発する不運体質で、相棒からはただのガキと認定されている。\n\n以上となります。\n至らない点がありましたら申し訳ございません。金額不足等の不備がございましたら、遠慮なくキャンセルいただければと思います。\nご検討いただけますと幸いです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/11rbPUzPu-1Y4F8IUzYcZF_ETaThkNxD7", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kikori_kiri/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3472343, "client_id": 3193805, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9e95d22/uploads/origins/01ebb134-4551-46b0-9e0d-fcad0c7c548b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=631bd33532bcad9a03146882b341cf6a", "srcset": "https://si.imgix.net/a9e95d22/uploads/origins/01ebb134-4551-46b0-9e0d-fcad0c7c548b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=631bd33532bcad9a03146882b341cf6a, https://si.imgix.net/a9e95d22/uploads/origins/01ebb134-4551-46b0-9e0d-fcad0c7c548b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c16d1bc7498cc62fa4c873bb0fa0d2c 2x, https://si.imgix.net/a9e95d22/uploads/origins/01ebb134-4551-46b0-9e0d-fcad0c7c548b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ac7c460786f8f8d200efcec8c0d7233 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9e95d22/uploads/origins/01ebb134-4551-46b0-9e0d-fcad0c7c548b?bg=%23fff&