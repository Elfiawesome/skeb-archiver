0&h=200&s=2dfb85979308b9b9d4c5cc86850a0fe0, https://si.imgix.net/4c7d8899/uploads/origins/ef5518a2-80ef-476e-971f-e10b85c87968?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=260da17078527e969ae4cb7906be9efd 2x, https://si.imgix.net/4c7d8899/uploads/origins/ef5518a2-80ef-476e-971f-e10b85c87968?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d051219d8af7f638b9b74f3140ac686 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c7d8899/uploads/origins/ef5518a2-80ef-476e-971f-e10b85c87968?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=043f7e2b063b5c9ccd61aa09739ed142", "srcset": "https://si.imgix.net/4c7d8899/uploads/origins/ef5518a2-80ef-476e-971f-e10b85c87968?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=043f7e2b063b5c9ccd61aa09739ed142, https://si.imgix.net/4c7d8899/uploads/origins/ef5518a2-80ef-476e-971f-e10b85c87968?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=75fde0b8b26d9730ea111ea8cfba3dcb 2x, https://si.imgix.net/4c7d8899/uploads/origins/ef5518a2-80ef-476e-971f-e10b85c87968?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d27dc6ee61ebb3ceabcebbb713c471ca 3x"}, "body": "こんにちは\nアニメ化が進んだ作品のヒロイン三人のバニーガール絵をお願いします。\nロシデレのアリサちゃん\n青ブタの桜島麻衣ちゃん\nお隣の天使様の椎名真昼ちゃん\nhttps://imgur.com/a/UI2z4Uf\n⬆4枚目の絵のようにアリサちゃんはリボンを両側に着けて最後の絵のように椎名真昼ちゃんのヘアスタイルはお嬢様結びヘアスタイルにリボンを追加したヘアスタイルに変更してください\n\n衣装デザインは⬇URLのようにお願いします\nhttps://imgur.com/a/fSxDNCb\n\n三人の体格は同じようにしてください\nそして三人とも眉毛メイクをした設定でお願いします\nhttps://imgur.com/a/9CFwRiI\n\n設定は三人は仲の良い姿でお互い近くくっついていて\n3人とも正面が見える構図または\nhttps://imgur.com/a/A2uJTxd\n二人は正面が一人はこちらを見ながら後ろ姿が見える構図でお願いします。\nhttps://imgur.com/a/aIp6otP\n\n3人の姿は⬇URLのようにシンプルなポーズまたは先生が希望するポーズに設定しても構いません。\nhttps://imgur.com/a/aq2QOfD\n(3人とも腰を曲げずにまっすぐな姿勢でお願いします)\n\nできれば3人とも笑顔の表情と衣装のせいで恥ずかしがっている表情の2つのバージョンでお願いします\nhttps://imgur.com/a/OHByZSp\nhttps://imgur.com/a/4xuzFQO\n(これはしなくてもいいです。)\n\n両側にいる二人の体の方向は中間にいる人を向くようにしてください\n絵の視点は三人を正面から眺めている視点でお願いします。\nhttps://imgur.com/a/A2uJTxd\n\n三人の体形はにむちむち体型にしてください。\nhttps://imgur.com/a/4Qu7mmj\n\n背景はなくてもいいです。\n先生の絵が素敵で膝の上とかお尻までは見たいです!", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moppuneko_ta/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4086762, "client_id": 727284, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd7284ee/uploads/origins/54e095ec-e446-4b7c-ba96-ad16b83b3230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f79c720a6de3539b87cd38513354932", "srcset": "https://si.imgix.net/dd7284ee/uploads/origins/54e095ec-e446-4b7c-ba96-ad16b83b3230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f79c720a6de3539b87cd38513354932, https://si.imgix.net/dd7284ee/uploads/origins/54e095ec-e446-4b7c-ba96-ad16b83b3230?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e82178c1bc1e44b09b966a2eb64f5ac 2x, https://si.imgix.net/dd7284ee/uploads/origins/54e095ec-e446-4b7c-ba96-ad16b83b3230?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=683b1e7fdb61a4d7465707ec30e5d011 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd7284ee/uploads/origins/54e095ec-e446-4b7c-ba96-ad16b83b3230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f3ce209c396d078f48732712b8cc3ab", "srcset": "https://si.imgix.net/dd7284ee/uploads/origins/54e095ec-e446-4b7c-ba96-ad16b83b3230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f3ce209c396d078f48732712b8cc3ab, https://si.imgix.net/dd7284ee/uploads/origins/54e095ec-e446-4b7c-ba96-ad16b83b3230?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2