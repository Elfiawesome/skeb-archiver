/AADnje1N7gvgyYIbixQwgYC2a?dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wawon_wwn/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 965994, "client_id": 506844, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9148a08/requests/242660_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be92ef5f83029655dfd6656564cbf5aa", "srcset": "https://si.imgix.net/e9148a08/requests/242660_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be92ef5f83029655dfd6656564cbf5aa, https://si.imgix.net/e9148a08/requests/242660_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27506b0c1a1ae8e252cb61fad5930a79 2x, https://si.imgix.net/e9148a08/requests/242660_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da8398661defbaa1535782c5c671c018 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9148a08/requests/242660_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=750ae1280c8e07ea29fa3cc9249c45bf", "srcset": "https://si.imgix.net/e9148a08/requests/242660_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=750ae1280c8e07ea29fa3cc9249c45bf, https://si.imgix.net/e9148a08/requests/242660_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=832e129f7b5c29864f7d46efb83f40a0 2x, https://si.imgix.net/e9148a08/requests/242660_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6fe3c86e0201db53f869c549108e6643 3x"}, "body": "I would love for you to write my personal Vtuber, Azumi Utagoromo!\n\nIt's a situation that actually happened, but I was in a room during a power outage, and the light from the cigarette in my mouth was like the only light. ......\n\nThe expression on her face is ennui, but she doesn't seem to be thinking about anything important. ......\n\nBy the way, her room is covered with garbage, so if you can take it into consideration to some extent ......\n\nWhen you upload it to Twitter, it would be helpful if you could add the tag \"#Art_as_me\".\n\nThank you very much. m(_ _)m\n\nhttps://twitter.com/As_me_V/status/1151786387760275456?s=19", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wawon_wwn/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 965994, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71036b51/requests/234608_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9aef08947c0142e139eddb8a03a1c94", "srcset": "https://si.imgix.net/71036b51/requests/234608_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9aef08947c0142e139eddb8a03a1c94, https://si.imgix.net/71036b51/requests/234608_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9ba8638ec52665d43845892f8824016 2x, https://si.imgix.net/71036b51/requests/234608_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e25dbbb827d8bee342b6fa440bfca7b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71036b51/requests/234608_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a056e063402822690281bc7bffcb7c5", "srcset": "https://si.imgix.net/71036b51/requests/234608_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a056e063402822690281bc7bffcb7c5, https://si.imgix.net/71036b51/requests/234608_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b25a43e8da556e36e0c73cc4dbc7f539 2x, https://si.imgix.net/71036b51/requests/234608_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba826cb1ba79fb464ad61c0127b79fea 3x"}, "body": "Nice to meet you!\nI've been curious about you since I saw your Hyakki Yakou!\nI'd like to ask you to make an illustration of me to use as a thumbnail.\nI'm also wearing a kimono, but I'd like to use a different outfit with a Taisho-roman, high-collar look...!\nI'll leave the pose to you!\nYou can find my standing drawing at the URL...!\n\nI'm looking forward to working with you...!\n\nhttps://drive.google.com/drive/folders/1p-Kzjjl0MXe5KvyRINuHxWQDL99Esi2X?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wawon_wwn/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 965994, "client_id": 735472, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a799c0d/requests/227435_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c0cbecc6206e1aa9476e1e0e5bb2908", "srcset": "https://si.imgix.net/4a799c0d/requests/227435_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c0cbecc6206e1aa9476e1e0e5bb2908, https://si.imgix.net/4a799c0d/requests/227435_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0420a50484d78688db7d3f4e37cf3a4 2x, https://si.imgix.net/4a799c0d/requests/227435_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=625cfa32fd885d12c66083538d67d96d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a799c0d/requests/227435_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0cb740faba9ad8079e5c6040f47346d", "srcset": "https://si.imgix.net/4a799c0d/requests/227435_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0cb740faba9ad8079e5c