になってやっとハルちゃんに依頼できそうなのでリクエスト送らせていただきました✨\n\n\n  【使用用途】 \n 各種SNSでのアイコン、ヘッダー、配信背景、サムネイルで使用予定の為、頭部の見切れがないイラストだと嬉しいです！\nまた、サムネイルで使用する際はイラストの拡大や切り取り、縁取り、ドロップシャドウなどを行う可能性があります！\n\n 【希望の構図】 \nハルちゃんに全ておまかせしたいです。\n\n  【希望形式】 \n人物のみ、背景のみ、あればフレーム、文字等を分けた 透過PNGまたはPSD形式で頂けると嬉しいです！\n\n  【OC詳細】\n・女神で蝶々モチーフ \n・弓矢を弾けます\n・身長160cm 、年齢20歳ぐらいの見た目\n・胸はCカップもないくらい \n・碧眼でハイライトが蝶模様、左目に泣きぼくろ  ・髪は薄紫色の胸が隠れるくらいのロング  \n\nご検討お願いします！\n\nhttps://www.dropbox.com/scl/fo/bu7h39nq0nxbz1ufhrext/AOVtzuDWcMUDhnuRLu2SCJo?rlkey=4xzcbvocw4objl5upn3fa3zmc&st=yee3cupl&dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koganen_o_o_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3244308, "client_id": 1749550, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de13de13/uploads/origins/7fde08c9-44ab-46cf-b840-c183a0a592f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74fd4765a92b07357729006c7c5275e4", "srcset": "https://si.imgix.net/de13de13/uploads/origins/7fde08c9-44ab-46cf-b840-c183a0a592f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74fd4765a92b07357729006c7c5275e4, https://si.imgix.net/de13de13/uploads/origins/7fde08c9-44ab-46cf-b840-c183a0a592f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e51e7c8626abc0564f54f48d3a0af5b3 2x, https://si.imgix.net/de13de13/uploads/origins/7fde08c9-44ab-46cf-b840-c183a0a592f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae37a1e8f64352e24f9635eeff0eeec4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de13de13/uploads/origins/7fde08c9-44ab-46cf-b840-c183a0a592f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4763824b02aee4241829502b7e25937", "srcset": "https://si.imgix.net/de13de13/uploads/origins/7fde08c9-44ab-