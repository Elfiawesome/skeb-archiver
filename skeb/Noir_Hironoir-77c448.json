format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e71713f2d31ec3aa2a8938e16fad867f 3x"}, "body": "のあーる様初めまして❕\nVtuberのリア・フェイと申します。\n\nお顔の描き方がとても好みで\n是非私も描いていただきたいと思い\nリクエストさせていただきます❕\n\n以下が依頼したい内容となっております。\n\n［希望］\n○VTuber「リア・フェイ」のイラストを描いていただきたいです。\n○キャラクターイメージ\n無邪気で子供っぽい\n天真爛漫なイメージ\n\n［構図］\nお任せします\n\n［服装・髪型］\n好きな服や髪形にしていただきたいです❕\n\n[表情]\nお任せ致します。\n\n［使用用途］\n○各種snsアイコン、ヘッダー\n○YouTubeサムネイル\n○個人観賞\n\n［その他］\n○人物のみ・背景のみのデータを頂けると助かります❕\n○イラストを使用する際に髪の毛や服が切れてないと大変助かります❕\n\n[納品形式希望]\npngで納品いただけると助かります❕\n\nご縁がありましたらよろしくお願いいたします❕", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Noir_Hironoir/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2879092, "client_id": 2865569, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a78aea8/uploads/origins/027622d1-a8e0-4705-b09e-bbbe27174c37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0f1ea0b49effaa2459a86a9ada4e0ff", "srcset": "https://si.imgix.net/6a78aea8/uploads/origins/027622d1-a8e0-4705-b09e-bbbe27174c37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0f1ea0b49effaa2459a86a9ada4e0ff, https://si.imgix.net/6a78aea8/uploads/origins/027622d1-a8e0-4705-b09e-bbbe27174c37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac499e2a2f1215193541fad6b5c54d8c 2x, https://si.imgix.net/6a78aea8/uploads/origins/027622d1-a8e0-4705-b09e-bbbe27174c37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=368b2f75575df9e542cee19a549315e1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a78aea8/uploads/origins/027622d1-a8e0-4705-b09e-bbbe27174c37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a729ff0a94a5fc0c916e3d98396b8c67", "srcset": "https://si.imgix.net/6a78aea8/uploads/o