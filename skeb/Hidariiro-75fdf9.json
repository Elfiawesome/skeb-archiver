2-44b5-abfe-9154148467fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90d294637c5c62ed5ee9c8d0cf3d015a, https://si.imgix.net/785f5339/uploads/origins/2280e221-20b2-44b5-abfe-9154148467fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7cd7a63f44f62e829799eaa3fa2c6469 2x, https://si.imgix.net/785f5339/uploads/origins/2280e221-20b2-44b5-abfe-9154148467fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c7b0b384d888d3858d9df4f0430c7f9e 3x"}, "body": "左色様、こんにちは。\n前回は素敵なエルフ娘を描いて下さり、ありがとうございました！\n前回の続きの流れで、２枚リクエストをお願いさせて頂けないでしょうか。\n\n１枚目\n「構図・ポーズ」\n・主人の男視点で、真正面。\n・両手でスカートをたくし上げて立っている。\n\n「ピアス」\n・耳ピアスと乳首ピアスを糸で結ばれ、オーク耳でオッパイが吊り上がっている。\n・鼻輪と首輪の後ろ側を糸で結ばれ、オーク鼻。\n・新しく舌ピアス（リング状）を装着され、チェーンで舌ピアスとクリトリスピアスを結ばれている。\n　チェーンは長めで、ゆとりがある。\n\n「服装」\n・エロメイド服。\n　元々は谷間が見えるよう胸元に穴が開いている。\n　乳首ピアスで吊り上げられて、胸元の穴からオッパイがハミ出ている。\n　スカートの丈が短い。\n　ノーパン。\n　ニーソ（サイズが小さく、太ももに食い込んでいる）\n・腰に剣を装備している。\n\n「台詞」\n男「似合ってるなｗ仕事中はこの格好でメイド兼護衛で働けよ」\nエルフ「承知しました、、、」\n男「おいおい、御礼の言葉をちゃんと言えよ。オークっぽく語尾にブヒブヒつけるのも忘れるなｗ」\nエルフ「くっ、申し訳ございませんブヒ」\n男「おう。オーク耳とオーク鼻に合ってて良いぞｗ」\nエルフ「あ、ありがとうございますブヒ」\n\n「表情」\n・羞恥心と屈辱で頬を赤らめながら睨んでいる。\n・舌を伸ばして、チェーンを垂らしている。\n\n２枚目\n「構図・ポーズ」\n・1枚目と同じ。\n\n「服装」\n・チューブトップ\n　肩紐無し。\n　吊り上げられたオッパイがチューブトップから出ている。\n　長さが短くて腹が出る。\n・短パン\n　サイズが小さい。\n　閉まらなくてチャック全開。\n　陰毛が見えている。\n　キツクて太ももが食い込んでいる。\n・ニーソ\n　サイズが小さくて、太ももに食い込んでいる。\n・腰に剣を装備している。\n\n「表情」\n・最後の謝罪の台詞の時で、怯えた感じ。\n「台詞」\n男「私服の時はこの服な。こっちも似合ってんなｗ」。\nエルフ「あ、ありがとうございますブー」。\n男「にしても、流石オークだからデブだなー。キツキツじゃんｗ」\nエルフ「なっ、貴様の寄越した服のサイズが小さいからだろう！」\n男「あ？また一晩中犯し潰されたいのか？」\nエルフ「ヒッ、す、すいませんブヒ。デブで申し訳ございませんブヒ」\n\n\n内容等、左色様のやり易いよう変更・省略して頂いて構いません。\nどうかご一考の程を宜しくお願い致します。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hidariiro/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3747234, "client_id": 1374293, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e625841/uploads/origins/3f2f70bc-0ac8-46a3-8c39-bab194a670b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e9498a3e69bee55a90f00484d2e7bbd", "srcset": "https://si.imgix.net/3e625841/uploads/origins/3f2f70bc-0ac8-46a3-8c39-bab194a670b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e9498a3e69bee55a90f00484d2e7bbd, https://si.imgix.net/3e625841/uploads/origins/3f2f70bc-0ac8-46a3-8c39-bab194a670b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76433965b3a0101fd81c66b506623ac9 2x, https://si.imgix.net/3e625841/uploads/origins/3f2f70bc-0ac8-46a3-8c39-bab194a670b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf2fd638982db59e64852c80a1b44b08 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e625841/uploads/origins/3f2f70bc-0ac8-46a3-8c39-bab194a670b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=650daeac9b2b62903237e0ee898c0dce", "srcset": "https://si.imgix.net/3e625841/uploads/origins/3f2f70bc-0ac8-46a3-8c39-bab194a670b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=650daeac9b2b62903237e0ee898c0dce, https://si.imgix.net/3e625841/uploads/origins/3f2f70bc-0ac8-46a3-8c39-bab194a670b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6348b5067832f93dc2ac107f5f2dae70 2x, https://si.imgix.net/3e625841/uploads/origins/3f2f70bc-0ac8-46a3-8c39-bab194a670b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3813f52307c3668c1b2a2cb1acf3a61 3x"}, "body": "左色様、こんにちは。\n前回は素敵なエルフ娘を描いて下さり、ありがとうございました！\n前回の流れの続きで、４枚リクエストをお願いさせて頂けないでしょうか。\n\n１枚目\n「内容」\n・エルフがピアスを装着させられた。\n【ピアス】\n形：リング状。\nピアスの大きさ：親指と人差し指で作る輪と同じぐらい。\n装着場所：鼻（牛みたいな鼻輪）、両乳首の根本、両耳の先端、クリトリス\n\n「構図」\n・主人の男視点で、エルフが立っている。\n・主人の男は映らず台詞のみ。\n「服装」\n・全裸。\n・首輪。\n「台詞」\n・エルフが「フン。悪趣味な」という感じの台詞。\n・主人の男が「おし、出来た出来た（笑）」という感じの台詞。\n\n「表情」\n・冷たく見下す感じ。\n・まだ余裕がある。\n\n２枚目\n「構図」\n・１枚目と同じ。\n\n「変化」\n・糸で鼻と右乳首のピアスを結ばれる。\n　糸で引っ張られて、右のオッパイが鼻ピアスに向かって伸びている。\n・糸でクリトリスのピアスと左乳首のピアスを結ばれる。\n　糸で引っ張られて、左のオッパイがクリピアスに向かって伸びている。\n\n「表情」\n・流石に羞恥心を感じて赤面。\n「台詞」\n・エルフが「殺すっ・・・！」という感じ。\n・主人が「ぶははは！イイね！」という感じ。\n\n3枚目\n「構図」\n・１、２枚目と同じ。\n\n「変化」\n・糸で右耳ピアスと右乳首ピアスを結び、左耳ピアスと左乳首ピアスを結ぶ。\n　オッパイがエルフ耳に向かって伸びている。\n　エルフ耳はオッパイに向かって下向きに折れている。\n・鼻輪と首輪の後ろ側を糸で結ぶ。\n　糸は鼻輪から頭の上を通って首輪の後ろ側に繋がって、エルフの鼻がオークのブタ鼻になってしまう。\n\n「表情」\n・羞恥心と屈辱と怒りで、赤面と涙目で睨んでいる。\n・オーク鼻にされてエルフ耳を弄られ、エルフのプライドを傷つけられたから。\n\n「台詞」\n・エルフは余裕をなくして激しく罵倒してくる感じ。\n・主人の男が嘲笑しながら、「おお、元気だな（笑）上下関係をワカラせてやるか」という感じ。\n\n4枚目\n「構図」\n・主人の視点で、床に倒れるエルフを見下ろしている。\n\n「ポーズ」\n・床にガニ股で仰向けに倒れている。\n「内容」\n・主人の男に犯されまくって失神しているエルフ。\n・ピアスと糸はそのまま。\n・中出しされまくり、マンコから精液が溢れ出ている。\n・激しく犯され、髪が乱れて身体が汗だく。\n・無意識で小便（駄目でしたら潮）を漏らしている。\n\n「表情」\n・オーク鼻のまま、アへ顔で舌が出ている。\n「台詞」\n・エルフは「ブ、ブヒ。ブヒ。ブヒヒィ、、、」と息絶え絶えでブタの鳴き声をしている。\n　主人に犯されてる最中に「オークらしくブヒブヒ言ってろ」と命令され、意識が無くなっても無意識で言いつけを守っている。\n・主人は「結構気持ち良かったわ（笑）」という感じ。\n\n\n内容等、左色様のやり易いよう変更・省略して頂いて構いません。\nお気に召しませんでしたら、キャンセルして頂いて全然構いません。\nどうかご一考の程を宜しくお願い致します。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hidariiro/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3747234, "client_id": 1374293, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b164c26/uploads/origins/a5eedb5e-543d-49df-b4bd-bbfb5bb1bbe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ab734e27c3dbeaf7fb3a554b8801abe", "srcset": "https://si.imgix.net/9b164c26/uploads/origins/a5eedb5e-543d-49df-b4bd-bbfb5bb1bbe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ab734e27c3dbeaf7fb3a554b8801abe, https://si.imgix.net/9b164c26/uploads/origins/a5eedb5e-543d-49df-b4bd-bbfb5bb1bbe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3430989e661f3f9de6f6948eff8c743f 2x, https://si.imgix.net/9b164c26/uploads/origins/