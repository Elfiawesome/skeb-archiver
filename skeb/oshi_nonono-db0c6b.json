 3837915, "client_id": 3930310, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e62f6e62/uploads/origins/3bfdc40d-6368-45b7-910a-6c1f5197495c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3dde39192f529bb8f8144e9211169e5", "srcset": "https://si.imgix.net/e62f6e62/uploads/origins/3bfdc40d-6368-45b7-910a-6c1f5197495c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3dde39192f529bb8f8144e9211169e5, https://si.imgix.net/e62f6e62/uploads/origins/3bfdc40d-6368-45b7-910a-6c1f5197495c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5dfd92de09b6a172954dd1b28b53cd4a 2x, https://si.imgix.net/e62f6e62/uploads/origins/3bfdc40d-6368-45b7-910a-6c1f5197495c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35b0c7c5dadc5afc2286c98ef56b3e25 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e62f6e62/uploads/origins/3bfdc40d-6368-45b7-910a-6c1f5197495c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59def7c78df90c5087201ca58df8da4a", "srcset": "https://si.imgix.net/e62f6e62/uploads/origins/3bfdc40d-6368-45b7-910a-6c1f5197495c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59def7c78df90c5087201ca58df8da4a, https://si.imgix.net/e62f6e62/uploads/origins/3bfdc40d-6368-45b7-910a-6c1f5197495c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9d3dda26d348a57165405c18fe266ffc 2x, https://si.imgix.net/e62f6e62/uploads/origins/3bfdc40d-6368-45b7-910a-6c1f5197495c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=434e280061114a0145044c7acd92c6e4 3x"}, "body": "徒野ときはさん、こんにちは。\nいつもXで素敵なイラスト見させていただいております。\n私の一次創作キャラクターを描いて頂きたいと思い、skeb依頼をさせて頂きました。\n\n【要望】\n・明るい雰囲気の絵でお願いします。\n・徒野ときはさんの描かれるキャラクターの表情が好きですので無表情以外でお願いします。目を細めた笑顔だと嬉しいです。\n・顔アップでなく腰辺りまで描いてほしいです。構図の関係上見切れているのは全然大丈夫です。また、手が好きなので手が見えるポーズでお願いします。細かい仕草や構図はお任せします。\n・キャラクターのデザインは資料URLを確認してください。2枚目は向かって左側の銀髪のキャラクター。\n\n\n【キャラクター設定について】\n描く上で参考になるかもしれないので書かせて頂きます。不要なら読み飛ばしてください。\n\n・オメガバース設定＆ファンタジー世界観のキャラクター。公爵家の1人息子のα\n・人当たりがよく紳士的。基本的に贔屓はしないが好きな子には激重愛情を抱いている。Ωである好きな子に害を成す者には容赦ない。\n・趣味は写真撮影（モノクロのフィルムカメラ）、好きな子と中庭でお茶会（コーヒーとアップルパイ）\n・送らせていただいた2枚目の資料の右側に居る黒い青年が好きな子（後の伴侶）\n・自作小説のキャラクターです。台詞等参考になれば……（https://www.alphapolis.co.jp/novel/95651901/708020500）\n\nhttps://x.com/oshi_nonono/status/2037732679085666432?s=20", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 11106, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "うみぼうず", "screen_name": "bouzumi_", "avatar_url": "https://pbs.twimg.com/profile_images/1883851397558636544/NWWv0vZV.jpg", "header_url": "https://pbs.twimg.com/profile_banners/721233429862359040/1715582381/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 599422, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "96sabi", "screen_name": "kinakoyamamori", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:6jorysndiusj7xaiecoaghbg/bafkreifatkz7bpylcb5i7nq5f47apcfcbbtijfqxhw4brig6orup7soura", "header_url": "https://cdn.bsky.app/img/banner/plain/did:plc:6jorysndiusj7xaiecoaghbg/bafkreia2ugjhr7webhfbhe3ajydqgnjygxlgwu7fyunptxeith75ntqiwe", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 48}, {"id": 2411317, "creator": tru