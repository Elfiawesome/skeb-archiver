ード。わりと善良寄り。\nシャドウハートとは恋人関係。\n\n・シャドウハート\nハーフエルフ・女性・クレリック。\n白と黒がありますが白の方です。\n落ち着いた大人の女性だが毒舌家。右頬から鼻筋にかけて傷あり。\n\n「ハッピーエンド。それから２人は末永く幸せに暮らしました」というイメージでお願いします。\n軽く抱き合ってる、楽しそうにお喋りしている、キスしているなどが候補ですが、詳細はお任せします。\n\nhttps://drive.google.com/drive/folders/1BIHBvauYSe2tYSZseNs-i7JSIhCf-cxX", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@je_ngu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3271863, "client_id": 2949454, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b050432/uploads/origins/f1db4e76-8db0-4879-b53e-8bf7ffd675b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f230383ae378715fe8b83990e710aab4", "srcset": "https://si.imgix.net/6b050432/uploads/origins/f1db4e76-8db0-4879-b53e-8bf7ffd675b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f230383ae378715fe8b83990e710aab4, https://si.imgix.net/6b050432/uploads/origins/f1db4e76-8db0-4879-b53e-8bf7ffd675b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e1227ef1400b258984f9891486d8a6d 2x, https://si.imgix.net/6b050432/uploads/origins/f1db4e76-8db0-4879-b53e-8bf7ffd675b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d4b905c85151fe5dcfb9d648b5df0f4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b050432/uploads/origins/f1db4e76-8db0-4879-b53e-8bf7ffd675b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68b07144a103eb0f89c602b03e51ae4a", "srcset": "https://si.imgix.net/6b050432/uploads/origins/f1db4e76-8db0-4879-b53e-8bf7ffd675b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68b07144a103eb0f89c602b03e51ae4a, https://si.imgix.net/6b050432/uploads/origins/f1db4e76-8db0-4879-b53e-8bf7ffd675b3?bg=%23fff&auto=format%2Ccompress&fm=