2a8-ab4f-4761-a076-0478d198688a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e7bcd9a3d95c0dc6dcf947e0e4fb5e2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/794e963c/uploads/origins/c4d322a8-ab4f-4761-a076-0478d198688a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac1df718e7761ea09ccd321a4fc63c60", "srcset": "https://si.imgix.net/794e963c/uploads/origins/c4d322a8-ab4f-4761-a076-0478d198688a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac1df718e7761ea09ccd321a4fc63c60, https://si.imgix.net/794e963c/uploads/origins/c4d322a8-ab4f-4761-a076-0478d198688a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=79c6ea0b47d78c334a6e23a95fb62f19 2x, https://si.imgix.net/794e963c/uploads/origins/c4d322a8-ab4f-4761-a076-0478d198688a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0558dbd04f416e16ed72e5bfc81bd0bb 3x"}, "body": "どうもお疲れ様です。バカルディです。\n\nTwitterのアイコンを新調したいと思っていまして、そのアイコンを描いて頂ければなと思います。具体的なオーダーは下に書きます。\n\n欲しい要素\n① 私の代理のバカルディが描かれている。\n② 画像のサイズが1：1である。\n③ 代理バカルディの服はスーツ、帽子と耳については指定はなし。\n\n出来れば欲しい要素\n① まりもみさだきさんのバカルディが一緒に写る。（詳細な指定はありません。）\n② アイコンの枠の範囲内でのまりもみさだきさんのサインと宛名、ウォータマークがある。(転載無断使用等への対策ですが、別案等があればお任せします。)\n③代理バカルディのスーツの種類はスリーピース。\n④ ＠BAKARUDY0912の表記\n\n困った場合に参考にしてください\n① 代理のスーツの色は青と赤で描く場合が多い。現実のスーツとは異なり、ベストの色とスーツの色を同色で合わせることは少ない。\n② 実は髪型に決まった形はない。手癖で描くので5：5で分かれることが多いが決まりはない。\n\n\nまたアイコンとは別件ですので不都合であれば無視して頂いて結構なのですが、まりもみさだきさんの一次創作シリーズ「彷徨う花の手お貸しします」が大好きなので、よろしければその関連の絵を描いて頂けると大変嬉しいです。\n\n\n納期等には特にこだわりませんので、リクエスト内容の変更等は気軽にお申しつけください。三寒四温の候、気温の変化と共に生活のリズムの崩れやすい中での依頼と思いますので、どうかお身体に気をつけて自由にお描きください。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marimomisadaki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_