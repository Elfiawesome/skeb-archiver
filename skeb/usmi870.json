ogle.com/drive/folders/16jJBb_zGRU6PT-W05gvlNHgp1PcMHwtc?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usmi870/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3493760, "client_id": 3217180, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0f3cc56/uploads/origins/92eb228c-65c6-4375-872f-c42d9d122598?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c250f789d5dd8b050ab8a5b7b52b921", "srcset": "https://si.imgix.net/c0f3cc56/uploads/origins/92eb228c-65c6-4375-872f-c42d9d122598?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c250f789d5dd8b050ab8a5b7b52b921, https://si.imgix.net/c0f3cc56/uploads/origins/92eb228c-65c6-4375-872f-c42d9d122598?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e052ef3676fba63491af4c76baae3a26 2x, https://si.imgix.net/c0f3cc56/uploads/origins/92eb228c-65c6-4375-872f-c42d9d122598?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69cf2cd1872cfadea79090b5c261298f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c0f3cc56/uploads/origins/92eb228c-65c6-4375-872f-c42d9d122598?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3c51e20bb058267ef023f5b56ff4d9c", "srcset": "https://si.imgix.net/c0f3cc56/uploads/origins/92eb228c-65c6-4375-872f-c42d9d122598?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3c51e20bb058267ef023f5b56ff4d9c, https://si.imgix.net/c0f3cc56/uploads/origins/92eb228c-65c6-4375-872f-c42d9d122598?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f196505d2a35726d75094a2f20455f72 2x, https://si.imgix.net/c0f3cc56/uploads/origins/92eb228c-65c6-4375-872f-c42d9d122598?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=66d4a99249447f904fda32ef0bec6528 3x"}, "body": "うさみ様、初めまして。\n\n新人Vtuberのリピ・ライキットと申します。\n\n活動に使用する画像が欲しくてイラストレーター様を探していたところ明るく柔らかな優しさのうさみ様のイラストを拝見し、どうしてもお願いしたいと思い依頼させていただきました。\n\n■使用場所\nYoutube（サムネイルや配信画面など）\nX（ヘッダー、アイコン、ポストなど）\n商用利用（リアルグッズ（クリアカード、缶バッジ、ポストカード、ネップリなど））\n\n■キャラクター\nリピ・ライキット（個人Vtuber本人）\nボクっ子。明るく元気なタイプ女子です。猫好き。可愛いものがあると暴走します。\n\n■ビジュアル資料（3面図がございませんので、自由にアレンジいただいて構いません）\nhttps://twitter.com/Lipi_Likeit\nhttps://nizima.com/Item/DetailItem/78657\nhttps://nizima.com/Item/DetailItem/85380\n\n■デフォルト服装について\nイメージとしては白衣は少しサイバーファッション要素入り。\nトップスやスカートは革のヘソ出しセットアップです。\n※見た目が研究員ぽいですが、フラスコなどは使いません。\n\n■ご依頼イメージ\n・テーマ「バレンタイン」でお願いいたします。\n　2026年お正月イラストのキラキラおめめが可愛かったのでイメージが崩れないのであれば取り入れて頂けると嬉しいです！\n・サムネイルに使用する可能性があるため、頭や髪・腕が見切れない構図にしていただきたいです。\n・ポーズ・表情おまかせいたします。\n・髪形ショートorロングどちらでも可。お好きにアレンジ等いただいて構いません。\n・うさみ様がよく描かれている制服絵（Yシャツネクタイ＋パーカー）がとても好きなので、是非その系統の衣装を着てみたいです！\n・可能でしたら表情差分をいただけたら助かります。（金額内で難しかったら大丈夫です）\n\n■納品形式について\n背景等をつけていただける場合は透過データも含めてPSD形式で納品頂けると大変助かります\n\nお忙しいところ恐れ入りますが、ご検討の程何卒よろしくお願い申し上げます。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usmi870/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3493760, "client_id": 3791103, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60335c98/uploads/origins/0d25672c-ae31-4bc7-8fb1-d14ee9f38bee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=116032e9e5e6af2af005fcff08545999", "srcset": "https://si.imgix.net/60335c98/uploads/origins/0d25672c-ae31-4bc7-8fb1-d14ee9f38bee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=116032e9e5e6af2af005fcff08545999, https://si.imgix.net/60335c98/uploads/origins/0d25672c-ae31-4bc7-8fb1-d14ee9f38bee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db418101608af7d67d5146bc050ec252 2x, https://si.imgix.net/60335c98/uploads/origins