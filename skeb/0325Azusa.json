bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=378622a5477e53f8f5c6dc9a97d0f7c4, https://si.imgix.net/7b4242a2/uploads/origins/35ac27d7-a4a2-4da1-b0fa-4c98b0fda413?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6a5561d2e624c43051acbd7038248aa 2x, https://si.imgix.net/7b4242a2/uploads/origins/35ac27d7-a4a2-4da1-b0fa-4c98b0fda413?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=884d1ed00144e796e449a455b8da1cd7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b4242a2/uploads/origins/35ac27d7-a4a2-4da1-b0fa-4c98b0fda413?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b15688cfff25209b1659edd3041fc598", "srcset": "https://si.imgix.net/7b4242a2/uploads/origins/35ac27d7-a4a2-4da1-b0fa-4c98b0fda413?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b15688cfff25209b1659edd3041fc598, https://si.imgix.net/7b4242a2/uploads/origins/35ac27d7-a4a2-4da1-b0fa-4c98b0fda413?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=680b85ba4454ea490daf4cea8acd51b1 2x, https://si.imgix.net/7b4242a2/uploads/origins/35ac27d7-a4a2-4da1-b0fa-4c98b0fda413?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a490391f88f9806ecf1fe6c066c42358 3x"}, "body": "はじめまして。\n私の配信キャラを描いてもらえませんか？\n#秀にゃんアート　にて様々な絵師のアートやはーみるままの作品が見れます。\n先生の作品をぜひとも私のアートに加えたく思い依頼を出しました。\n\nIRIAMやＳＨＯＷＲＯＯＭにて配信してます。色んな配信媒体に手を出して行く予定です。\n配信にて使いたい為商用利用となります。\nまた、グッズ化する可能性があります。\nおはぶいやツイッター（x）にて使いたいと思います。配信活動全般にて使いたいと思います。\n。\n立ち絵のイメージ相互さんにアンケート取りましたらミジンコＶチューバーになってとの意見が多くできればミジンコ要素を含んだ立ち絵を描いてもらいたいです。\n口ではうまく説明できませんが先生の今までの作品が素晴らしく先生にぜひとも描いて貰いたいと思い注文しました。\nアンケートのツイです。https://x.com/lgHJMH4o7MnEFrG/status/1958855911403036698?t=Ez10XU7ya7X1qUYW1V7EjA&s=19\n\nまた、配信で使いたい為背景透過素材1点必ずください。\nできれば頭から足まで全身描いてもらいたいです。\nまた、NSFw指定してます。際どい作品でも大丈夫ですが配信にて使えないため黒塗りや何かしら加工する許可をください。\n長文読んでくださりありがとうございます。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0325Azusa/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3239910, "client_id": 630801, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bffe2264/uploads/origins/8b99d87c-3a80-40a1-bb07-73ec48ce5e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9183636bf922a3013068f76b755482e", "srcset": "https://si.imgix.net/bffe2264/uploads/origins/8b99d87c-3a80-40a1-bb07-73ec48ce5e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9183636bf922a3013068f76b755482e, https://si.imgix.net/bffe2264/uploads/origins/8b99d87c-3a80-40a1-bb07-73ec48ce5e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ccd5f425538056259092a0d82b8243d 2x, https://si.imgix.net/bffe2264/uploads/origins/8b99d87c-3a80-40a1-bb07-73ec48ce5e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3386696f3e70e7f77adcbd8691b25412 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bffe2264/uploads/origins/8b99d87c-3a80-40a1-bb07-73ec48ce5e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=656aa7dca7d4537bef63a7dec01c2bee", "srcset": "https://si.imgix.net/bffe2264/uploads/origins/8b99d87c-3a80-40a1-bb07-73ec48ce5e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=656aa7dca7d4537bef63a7dec01c2bee, https://si.imgix.net/bffe2264/uploads/origins/8b99d87c-3a80-40a1-bb07-73ec48ce5e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=031d7968360b6c8a42e6b17a0f604b0c 2x, https://si.imgix.net/bffe2264/uploads/origins/8b99d87c-3a80-40a1-bb07-73ec48ce5e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bd9e945ed37ce7d11e55efe6c3215f0b 3x"}, "body": "お世話になっております。痛車イラスト使用OKとのことなので依頼させていただきます。\n以下依頼文内容です。\n・キャラは「ウマ娘プリティーダービー」よりステイゴールドです。\n・ポーズはアズサさんが決めてください。Miyaさんのドリジャとベストマッチなステゴを期待してます！\n・イラストですが、ステイゴールドの文字（Stay Gold）は入れてほしいです。\n・背景は透過と任意の背景の二種類あったら大丈夫です。透過は必須でお願いいたします。\n・貼る車の参考図を下記(資料URL)に表示しておきます。\n・貼るスペースの都合上、全体的に逆台形になるような外郭でお願いします。\n以上が依頼イラストの内容になります。\nここからは画質（解像度等）の条件（参考値）になります。\nこの設定はアプリケーションや、作業環境（PCスペック）によるので参考程度で構いません。\n以下条件（参考値）内容です。\n・解像度350dpi以上、できたら600dpi以上が望ましいです。\n・色設定はCMYKができたらそれでお願いします。\n依頼内容は以上となります。\nいろいろと細かい注文をかけてしまい申し訳ございません。\n設定等は痛車絵師の方を参考させて頂いたので、かなり細かいかもしれませんが、できる限りの範囲でお願いいたします。\nよろしくお願いいたします。\n\nhttps://x.com/AliceSgw/status/1928032576121262122", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0325Azusa/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bbe4905f/uploads/origins/97340e16-cf6d-4ea4-8d6a-0426d096815a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=abf5fb5b7e3469265bbd49dc22cd4d0d", "srcset": "https://si.imgix.net/bbe4905f/uploads/origins/97340e16-cf6d-4ea4-8d6a-0426d096815a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=abf5fb5b7e3469265bbd49dc22cd4d0d, https://si.imgix.net/bbe4905f/uploads/origins/97340e16-cf6d-4ea4-8d6a-0426d096815a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e14645b9dec77fbc27a62d7c5f220ccc 2x, https://si.imgix.net/bbe4905f/uploads/origins/97340e16-cf6d-4ea4-8d6a-0426d096815a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=56efeed4