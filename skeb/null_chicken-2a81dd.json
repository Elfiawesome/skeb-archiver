mat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d932a5570b12ec745f23dd6d630ca58c 2x, https://si.imgix.net/8042bb0e/uploads/origins/be1d06b4-2021-4a84-a68e-528c73735388?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b591fc4be5792c2a4403c9a91f966f1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8042bb0e/uploads/origins/be1d06b4-2021-4a84-a68e-528c73735388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2e757b0edb5fd466e47e7072e77d1d2", "srcset": "https://si.imgix.net/8042bb0e/uploads/origins/be1d06b4-2021-4a84-a68e-528c73735388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2e757b0edb5fd466e47e7072e77d1d2, https://si.imgix.net/8042bb0e/uploads/origins/be1d06b4-2021-4a84-a68e-528c73735388?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a6a22a5858a70084f8364a24de574fb 2x, https://si.imgix.net/8042bb0e/uploads/origins/be1d06b4-2021-4a84-a68e-528c73735388?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=88e2738cb2bbf4393b4a669a44681096 3x"}, "body": "こんにちは。\nおのちきんさんの作品をいつも拝見させていただいております！\nとても好みの絵柄なので、今後トリッカル関連曲の演奏活動を行うにあたって、Xアカウントのアイコン・ヘッダーを新調したくご依頼を差し上げました。\n\n【依頼内容】\nバターとコミーが楽しく楽器を演奏しているイラストを希望します。\n\n【詳細】\n①おのちきんさんのいつも通りの絵柄\n②キャラクターはいつも通りの衣装\n③キャラクターの配置はコミー（向かって右、ギター）・バター（向かって左・ベース）\n④ポーズは資料URLを参考にしていただき、コミーとバターのポーズが左右対称になるようお願いします。\n※コミーは右手でギターネックを押さえ、左手でピックを持つ形となり、バターはその逆となります。\n⑤完成品のアスペクト比は3（横）:1（縦）\n\n【納品形式】\n.png及び.psd\n完成品（1枚）\n各キャラクター(各1枚)\n※表情差分があったら嬉しいです！\n\n【納期】\nお忙しいかと存じますので特に急ぎません。\nお手隙の際にお願い致します。\n\nご検討をいただけますと幸いです。\n宜しくお願い致します！\n\nhttps://i.namu.wiki/i/jY79OeJHC5-p2-H_qvaE40BIEULT0-hpYpQYht7qbA5yAfFocYcR1jqlEQdQzbdkJDb5uA28vx_kYLURrVIOjNhnjjFi0BBsOewuTe5Ln4XgSoLtrTB2toOWIj0We2_RDb7_LtmLS1m_u3mswMjuXg.webp", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@null_chicken/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1562161, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8b6014e/uploads/origins/8fa8f2da-1696-4936-ae4f-99fb39a786be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f40ca2b4cf5d13364d2e8e54db0c010", "srcset": "https://si.imgix.net/b8b6014e/uploads/origins/8fa8f2da-1696-4936-ae4f-99fb39a786be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f40ca2b4cf5d13364d2e8e54db0c010, https://si.imgix.net/b8b6014e/uploads/origins/8fa8f2da-1696-4936-ae4f-99fb39a786be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8aad3e96640cbc52080c75af83fe5d27 2x, https://si.imgix.net/b8b6014e/uploads/origins/8fa8f2da-1696-4936-ae4f-99fb39a786be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ff6498bcaa3e62b27d95f439d46d8c1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8b6014e/uploads/origins/8fa8f2da-1696-4936-ae4f-99fb39a786be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b822b5ef0d132b2c87b21d430a48e5fc", "srcset": "https://si.imgix.net/b8b6014e/uploads/origins/8fa8f2da-1696-4936-ae4f-99fb39a786be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b822b5ef0d132b2c87b21d430a48e5fc, https://si.imgix.net/b8b6014e/uploads/origins/8fa8f2da-1696-4936-ae4f-99fb39a786be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dac143695e4e4fcdf7fcaac4cc994395 2x, https://si.imgix.net/b8b6014e/uploads/origins/8fa8f2da-1696-4936-ae4f-99fb39a786be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=63f300af975fcf0d2bcf97c16b03396a 3x"}, "body": "イキヅライブ!の山田真緑の童話の表紙風のイラストをお願いします。\n\nタイトルは「パンツ売りの少女」で真緑がパンツを売っているのが一目で分かるように旗やスケッチブック等で「ぱんつ　うります」と掲示している様子を描いてくだされば嬉しいです。\n\nパンツを売っている理由は資源の有効活用(捨てたら燃えるゴミになるので、それなら欲しい人に売る)や活動資金の確保などが目的でパンツ(やブラ、スク水、靴下など)を街ゆく人に売っている(買ってくれた人には追加料金でオプションも付ける)感じでお願いします。\n\nその他にも描いてみたいものがあれば自由にお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@null_chicken/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1562161, "client_id": 1312005, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ccb5289f/uploads/origins/6e578e5b-af68-4c69-8ab2-ccfa3d70c58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22133d1b1e9ab956e41a3c42cf70a76e", "srcset": "https://si.imgix.net/ccb5289f/uploads/origins/6e578e5b-af68-4c69-8ab2-ccfa3d70c58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22133d1b1e9ab956e41a3c42cf70a76e, https://si.imgix.net/ccb5289f/uploads/origins/6e578e5b-af68-4c69-8ab2-ccfa3d70c58b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d11a9eb27593eb8e3f1771e3e45f01de 2x, https://si.imgix.net/ccb5289f/uploads/origins/6e578e5b-af68-4c69-8ab2-ccfa3d70c58b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9155a3627f93d0ab49b6e1dc27741c0b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ccb5289f/uploads/origins/6e578e5b-af68-4c69-8ab2-ccfa3d70c58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e0e2518efe8f9af2dc0313ab78362f5", "srcset": "https://si.imgix.net/ccb5289f/uploads/origins/6e578e5b-af68-4c69-8ab2-ccfa3d70c58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e0e2518efe8f9af2dc0313ab78362f5, https://si.imgix.net/ccb5289f/uploads/origins/6e578e5b-af68-4c69-8ab2-ccfa3d70c58b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=769cf383639976cb3e