7b-4dce-bed2-790d97f4b12c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7d041b6741e7d53f1efdd294c75857a", "srcset": "https://si.imgix.net/2468fc9b/uploads/origins/6542266d-9d7b-4dce-bed2-790d97f4b12c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7d041b6741e7d53f1efdd294c75857a, https://si.imgix.net/2468fc9b/uploads/origins/6542266d-9d7b-4dce-bed2-790d97f4b12c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b6d93225e4e7cade69d2de498aff911 2x, https://si.imgix.net/2468fc9b/uploads/origins/6542266d-9d7b-4dce-bed2-790d97f4b12c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=751c093161b0b8fdca4b2f4ba7fec302 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2468fc9b/uploads/origins/6542266d-9d7b-4dce-bed2-790d97f4b12c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c17b81b4e0560ebd1e49858dea3f52c", "srcset": "https://si.imgix.net/2468fc9b/uploads/origins/6542266d-9d7b-4dce-bed2-790d97f4b12c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c17b81b4e0560ebd1e49858dea3f52c, https://si.imgix.net/2468fc9b/uploads/origins/6542266d-9d7b-4dce-bed2-790d97f4b12c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2baceb3d39f99e91a6d745fd42bae1fe 2x, https://si.imgix.net/2468fc9b/uploads/origins/6542266d-9d7b-4dce-bed2-790d97f4b12c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=adbdfdd385045211eca46fd0a25567c5 3x"}, "body": "こんにちは、お世話になっております。\nろねうです。\n\n・嗤う人間師  PC2  ノア・アラン（ロスト済）\n\nの立ち絵を依頼したくメッセージを送らせていただきました！  \n\n\n\n\n\n\n\n以下参考資料です！\n\n\n\n・嗤う人間師\nhttps://iachara.com/view/7590664\n（ノアキャラシ）\nhttps://twitter.com/ronerone_trpg/status/1729160261255462919?t=vhyKzW4fpvUpU2zV0oSZZw&s=19\n（全身立ち絵）\n\n・イメージソング\n脱法ロック/Neru\nhttps://youtu.be/u5mHVUwDf_0?si=_XFfbIHbcIGEGlNS\nオーバーライド\nhttps://youtu.be/LLjfal8jCYI?si=sVfbgNKcqXuNkvHC\n\n\n\n\n簡単に、ノアってこんな男だよ〜みたいなアレです。\n\n過去の出来事が原因で警察に対して不信感を持ったのと、自分が動くことへの無意味さを痛感してしまいサボり魔になった。\n以降は女の人ナンパしたりタバコ休憩と言って数時間離脱するタイプのクソ野郎になった。\nでも市民に「ノア・アラン」に対して助けを求められたら素直に応じるし、仲間内の空気感をよく見ながら動こうとする。根は優しい人間。\n\n\n\nネタバレのない範囲でのノアの独白的なあれ\nを貼っておきます！\n\n\nPC3に関しては本当に申し訳ないと思っている。この俺が。珍しく。\nあいつただ単純に巻き込まれてるだけだからな。それに俺があの子を守れなかったせいで、あいつは気に病んでるんだろ。\n完全に俺の采配ミスなんだよ。\n\nあー、でも心残りがまだあった。\nもう少しPC1（同僚）に言葉を遺していけば良かった。\nそうしたら、PC1の心境も少しは楽になったんかな。わかんね。もしもの話をしたって仕方ないんだけどな。それにしてもあまりにも突然だったからさ……天涯孤独でも心残りはあるわけだよ。あいつやっていけんのかな。マジで不安なんだけど。\n\n……いろいろ並べ立てたけどさ。\n叶うことなら、アイツらともう少し並んで立っていたかった、な。\n\nなんて、死んだヤツの戯言。\n死んだヤツの言葉なんか忘れて生きてるお前らはそっちでよろしくやってくれよ。\n\nだから言っただろ？\n『見なくていい』ってさ。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@seskhr_0408/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1466444, "client_id": 2847428, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9110f13c/uploads/origins/7503ffaa-ce2a-4e1c-8714-c1b33a7a7062?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8001fd138ff809542aeb0db7f8436c95", "srcset": "https://si.imgix.net/9110f13c/uploads/origins/7503ffaa-ce2a-4e1c-8714-c1b33a7a7062?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8001fd138ff809542aeb0db7f8436c95, https://si.imgix.net/9110f13c/uploads/origins/7503ffaa-ce2a-4e1c-8714-c1b33a7a7062?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d31fc6d9ff71740f107a4c3e0eba2827 2x, https://si.imgix.net/9110f13c/uploads/origins/7503ffaa-ce2a-4e1c-8714-c1b33a7a7062?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4a714ac6d68ca501a94042f014cf04c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9110f13c/uploads/origins/7503ffaa-ce2a-4e1c-8714-c1b33a7a7062?bg=