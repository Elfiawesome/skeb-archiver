。\n\n現在天体のメソッド公式サイトは閉鎖なのか不具合なのかわかりませんが閲覧できない状態です。資料URLにノエルちゃんの画像を載せておきますので、参考になさってください。\n\nノエルちゃんが笑顔ではしゃいでいる様子を描いてください。何かで遊んでいたり、何かを食べていたり、具体的な構図はどんな感じでもいいのでお任せしますが、笑顔重視でお願いします。\n\n引き受けてくださると幸いです。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1L_hb3fBgNPSRQJ7uekVEsRiGNcq_ok1_?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kina_x_Kina/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2861137, "client_id": 1113389, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/301ac8db/uploads/origins/6bab2daa-caf7-4ca1-b620-65f14d9d7a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aef04cb6a7b2e1776d25db614aec188b", "srcset": "https://si.imgix.net/301ac8db/uploads/origins/6bab2daa-caf7-4ca1-b620-65f14d9d7a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aef04cb6a7b2e1776d25db614aec188b, https://si.imgix.net/301ac8db/uploads/origins/6bab2daa-caf7-4ca1-b620-65f14d9d7a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db89cdf03383a27acf23482241898650 2x, https://si.imgix.net/301ac8db/uploads/origins/6bab2daa-caf7-4ca1-b620-65f14d9d7a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a88e712623d513db28741f4f544e16f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/301ac8db/uploads/origins/6bab2daa-caf7-4ca1-b620-65f14d9d7a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=124edca447e658852c529340933efc4d", "srcset": "https://si.imgix.net/301ac8db/uploads/origins/6bab2daa-caf7-4ca1-b620-65f14d9d7a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=124edca447e658852c529340933efc4d, https://si.imgix.net/301ac8db/uploads/origins/6bab2daa-caf7-4ca1-b620-65f14d9d7a07?bg=%23fff&aut