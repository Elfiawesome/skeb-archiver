用。\n他者へのskeb依頼時の資料記載。\n\n\n依頼内容に対し金額が見合っていない場合再送いたしますので、ご提案いただけますと助かります。\nご縁がありましたら、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1N9XLlW9C-OoNc07tWEU8n1TdpPuVh3JP?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tesshin521/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 970556, "client_id": 3940283, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8671099e/uploads/origins/94ca9669-6359-45f0-a624-19ad3a86af22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=612b9c9010d0ad6cd1d50bf89b603831", "srcset": "https://si.imgix.net/8671099e/uploads/origins/94ca9669-6359-45f0-a624-19ad3a86af22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=612b9c9010d0ad6cd1d50bf89b603831, https://si.imgix.net/8671099e/uploads/origins/94ca9669-6359-45f0-a624-19ad3a86af22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be43ebaeffaf4f6dc8ddf37f7ce2839f 2x, https://si.imgix.net/8671099e/uploads/origins/94ca9669-6359-45f0-a624-19ad3a86af22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b261922df7415b61896ab1a030cae16 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8671099e/uploads/origins/94ca9669-6359-45f0-a624-19ad3a86af22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e860ef1f249fc0d1516aaaa6f1c0480", "srcset": "https://si.imgix.net/8671099e/uploads/origins/94ca9669-6359-45f0-a624-19ad3a86af22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e860ef1f249fc0d1516aaaa6f1c0480, https://si.imgix.net/8671099e/uploads/origins/94ca9669-6359-45f0-a624-19ad3a86af22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e8d14bbd8448e6a03d59d7a9fd14124 2x,