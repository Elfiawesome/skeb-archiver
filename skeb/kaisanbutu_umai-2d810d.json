-1d944a957b09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=205452189a6c30572430d20b40271c0f", "srcset": "https://si.imgix.net/903c60ba/uploads/origins/8541942f-1784-4f6c-81f1-1d944a957b09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=205452189a6c30572430d20b40271c0f, https://si.imgix.net/903c60ba/uploads/origins/8541942f-1784-4f6c-81f1-1d944a957b09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d93c63e9a5b59bc4048f14af6393036 2x, https://si.imgix.net/903c60ba/uploads/origins/8541942f-1784-4f6c-81f1-1d944a957b09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6bf95400f935bce29ee64ee68a25cc10 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/903c60ba/uploads/origins/8541942f-1784-4f6c-81f1-1d944a957b09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6a013c9bec02aa8a5606098df86fcbd", "srcset": "https://si.imgix.net/903c60ba/uploads/origins/8541942f-1784-4f6c-81f1-1d944a957b09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6a013c9bec02aa8a5606098df86fcbd, https://si.imgix.net/903c60ba/uploads/origins/8541942f-1784-4f6c-81f1-1d944a957b09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0137032d34e62b08437d9909bd4eaa16 2x, https://si.imgix.net/903c60ba/uploads/origins/8541942f-1784-4f6c-81f1-1d944a957b09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b44528eeeb5f7b0f54b60553fae9b711 3x"}, "body": "こんばんは。反応ありがとうございます。\nCoCTRPGシナリオ「VOID」の探索者二名（HO1/HO2）を描いて頂きたいです。\n片方は私の探索者ではありませんが、リクエストへの使用許可を頂いています。\n\n構図などすべておまかせします。\n衣装は二人とも　制服　でお願いします。\n\n＊須炭大和（すた やまと）\n職業：刑事\n年齢/性別：22歳/男性\n身長/体重：176cm/70kg\n\n真面目で真っ直ぐ、ドが付くほどの負けず嫌いの新人刑事。\n溌剌としている。短気で時々頑固。\n\n発想は大変柔軟だがそれゆえに飛び出しがち。\n対岸に怪しい人影がいたら川に飛び込むとか。\n証拠が揃っていないのに犯人を尾行するとか。\n\n＊蒼月（そうげつ）\n職業：刑事\n年齢/性別：外見20代前半/男性型\n身長/体重：175cm/85kg\n\n落ち着いていて穏やか、誰にでも丁寧な態度で接する新型アンドロイド。\n人とほとんど変わらない見た目で、飲食や呼吸などを擬似的に行う事も出来る。\n\n周囲が引くほどのチョコミント好きで、\nその狂信具合は共に行動しているバディに限らず、\n先輩や先輩アンドロイドすらも恐怖させた。\n\n外見などは資料URLを参照ください。\n問題があれば再送/キャンセル下さって構いません。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1oT0yhmP1GJtzOHxkbMjPqNjx3EVc-Cua?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaisanbutu_umai/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2924003, "client_id": 2874817, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd6f049c/uploads/origins/209d9bfa-9e07-4d94-8170-6dd67d7cd88a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9ff6cc5f916564ca00497c87876e9dd", "srcset": "https://si.imgix.net/cd6f049c/uploads/origins/209d9bfa-9e07-4d94-8170-6dd67d7cd88a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9ff6cc5f916564ca00497c87876e9dd, https://si.imgix.net/cd6f049c/uploads/origins/209d9bfa-9e07-4d94-8170-6dd67d7cd88a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6aa59c349fb70777b141952fad09c8d1 2x, https://si.imgix.net/cd6f049c/uploads/origins/209d9bfa-9e07-4d94-8170-6dd67d7cd88a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c2ce64e946fde64304775f987a7ce99 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd6f049c/uploads/origins/209d9bfa-9e07-4d94-8170-6dd67d7cd88a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a8a82cab850b39ede0db3e7a558defa", "srcset": "https://si.imgix.net/cd6f049c/uploads/origins/209d9bfa-9e07-4d94-8170-6dd67d7cd88a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a8a82cab850b39ede0db3e7a558defa, https://si.imgix.net/cd6f049c/uploads/origins/209d9bfa-9e07-4d94-8170-6dd67d7cd88a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a06ab2c3b7a162f520decef88ba85f74 2x, https://si.imgix.net/cd6f049c/uploads/origins/209d9bfa-9e07-4d94-8170-6dd67d7cd88a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ddd05cef05c6633cf4af159b43a89e58 3x"}, "body": "こんにちは、お世話になっております。\nろねうです。\n\n・嗤う人間師  PC2  ノア・アラン（ロスト済）\n\nのイラストを依頼したくメッセージを送らせていただきました！  内容は完全におまかせしたいのですがよろしいでしょうか……御検討よろしくお願いします🙏\n\n\n\n\n\n\n以下参考資料です！\n\n\n\n・嗤う人間師\nhttps://iachara.com/view/7590664\n（ノアキャラシ）\nhttps://twitter.com/ronerone_trpg/status/1729160261255462919?t=vhyKzW4fpvUpU2zV0oSZZw&s=19\n（全身立ち絵）\n\n・イメージソング\n脱法ロック/Neru\nhttps://youtu.be/u5mHVUwDf_0?si=_XFfbIHbcIGEGlNS\n\n\n\n\n\n簡単に、ノアってこんな男だよ〜みたいなアレです。\n\n過去の出来事が原因で警察に対して不信感を持ったのと、自分が動くことへの無意味さを痛感してしまいサボり魔になった。\n以降は女の人ナンパしたりタバコ休憩と言って数時間離脱するタイプのクソ野郎になった。\nでも市民に「ノア・アラン」に対して助けを求められたら素直に応じるし、仲間内の空気感をよく見ながら動こうとする。根は優しい人間。\n\n\n\nネタバレのない範囲でのノアの独白的なあれ\nを貼っておきます！\n\n\nPC3に関しては本当に申し訳ないと思っている。この俺が。珍しく。\nあいつただ単純に巻き込まれてるだけだからな。それに俺があの子を守れなかったせいで、あいつは気に病んでるんだろ。\n完全に俺の采配ミスなんだよ。\n\nあー、でも心残りがまだあった。\nもう少しPC1（同僚）に言葉を遺していけば良かった。\nそうしたら、PC1の心境も少しは楽になったんかな。わかんね。もしもの話をしたって仕方ないんだけどな。それにしてもあまりにも突然だったからさ……天涯孤独でも心残りはあるわけだよ。あいつやっていけんのかな。マジで不安なんだけど。\n\n……いろいろ並べ立てたけどさ。\n叶うことなら、アイツらともう少し並んで立っていたかった、な。\n\nなんて、死んだヤツの戯言。\n死んだヤツの言葉なんか忘れて生きてるお前らはそっちでよろしくやってくれよ。\n\nだから言っただろ？\n『見なくていい』ってさ。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaisanbutu_umai/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2924003, "client_id": 2874817, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1482278/uploads/origins/6283831b-e872-4ee3-824d-9e3d3eeab60c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cbdc4f1205115d369efb2bcc9cedf8e", "srcset": "https://si.imgix.net/d1482278/uploads/origins/6283831b-e872-4ee3-824d-9e3d3eeab60c