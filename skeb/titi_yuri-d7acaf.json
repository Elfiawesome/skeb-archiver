ttps%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1306434975659487232%2F6mNj_y0F.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8cc5c6d1a33b60215892e7665de7455 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1306434975659487232%2F6mNj_y0F.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b08f9f1c42caa9da6789063684854fda", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1306434975659487232%2F6mNj_y0F.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b08f9f1c42caa9da6789063684854fda, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1306434975659487232%2F6mNj_y0F.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fba2e652032db3eb59a24a59a48800d1 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1306434975659487232%2F6mNj_y0F.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=245faf658d10953bc735f180abae6705 3x"}, "body": "はじめまして、リクエスト失礼します。\n【作品・キャラクター】\nFGO\nランサーアルトリア（☆５）\n源頼光　\nブーディカ　\n【シチュエーション】\n微小特異点の修正任務。マスターが先行しているから増援で来てほしいと選ばれた巨乳サーヴァント三人。\n三人はレイシフト後に意識を取り戻すと三人は狭いロッカーに一人ずつ閉じ込められている状態だった。\n目隠しをされて腕は後ろ手に足は足首で縛られ、衣服もパンツだけで胸は曝け出されたトップレスの状態。\nなんとか状況を把握した三人はロッカーから脱出しようとする。\n三人はそれぞれ閉じ込められているロッカーを開けようと扉に必死になって胸を押し付ける。\n冷たい金属製の扉に乳首をこすりつける形となってしまい感じてしまう三人。\nなんとか脱出に成功するが拘束のせいで立つことができない。\n更に脱出のために胸を扉に擦り付けたせいで昂った胸への刺激の欲求を解消することもできない。\n三人は目隠しと拘束をされ床に転がったままの状態で互いの胸を押し付け合ったり乳首をしゃぶりあう。\n母乳を噴いて絶頂する三人。\n\nその痴態を監視カメラで覗き自分もチクニーするぐだ子。\n特異点はとっくに解決したけど趣味でえっちな事をしたくなったので増援を呼んだおっぱい星人なぐだ子というオチ。\n\nご一考のほど何卒よろしくお願い致します。", "nc": 48, "word_count": 4761, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@titi_yuri/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 437765, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1306434975659487232%2F6mNj_y0F.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4772a6239876fcaa30bc15778621494", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1306434975659487232%2F6mNj_y0F.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4772a6239876fcaa30bc15778621494, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1306434975659487232%2F6mNj_y0F.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1aace37dbba4033aa86653aa098f1f1 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1306434975659487232%2F6mNj_y0F.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=cent