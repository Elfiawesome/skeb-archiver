-7446-4a13-85ea-5594a7d7e67b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7fdbeb1ed8f1565eab3ecadac2ed53f", "srcset": "https://si.imgix.net/96e60db2/uploads/origins/9b47db46-7446-4a13-85ea-5594a7d7e67b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7fdbeb1ed8f1565eab3ecadac2ed53f, https://si.imgix.net/96e60db2/uploads/origins/9b47db46-7446-4a13-85ea-5594a7d7e67b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a82617157255b2f3ff084923f99af103 2x, https://si.imgix.net/96e60db2/uploads/origins/9b47db46-7446-4a13-85ea-5594a7d7e67b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b7a83958e18df23057220647affe19b9 3x"}, "body": "お疲れ様です！\n前回の募集時に応募したリトルリリカルのご依頼なのですが、もし構図が浮かびそうでしたら、改めて再度ご依頼させていただいてもよろしいでしょうか。\nミミちゃんの耳は、厳密に考えると、フードを脱いでもあるのだと思いますが、個人的にはそこまで設定の厳密さを求めていませんので、無くても全然大丈夫です！\n先生が、可愛いと感じる方で自由にお描きになってください！\n以下、前回のリクエスト文です。\n\n\nリクエスト再開を待っていました✨\nプリコネの、リトルリリカルのおヌードを描いていただけませんか！？\n冒険の途中で見つけた綺麗な湖で水遊び！\nみたいなイメージで。\n水着は持ってきていなかったので、誰も見てないしはだかんぼになっちゃった！みたいな感じでお願いします！\nもし可能ならおパンツ一枚姿の差分があると嬉しいですが、作業大変でしたら、無くても大丈夫です。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@liku_0495/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 52077, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f6a33f4/uploads/origins/e0b67e23-5382-4202-b5d1-669189704633?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbeacc25d333cee70faec1fb1c036c75", "srcset": "https://si.imgix.net/1f6a33f4/uploads/origins/e0b67e23-5382-4202-b5d1-669189704633?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbeacc25d333cee70faec1fb1c036c75, https://si.imgix.net/1f6a33f4/uploads/origins/e0b67e23-5382-4202-b5d1-669189704633?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&