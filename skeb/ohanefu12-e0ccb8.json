じまくる女の子\n中出しで妊娠させられる恐怖・嫌悪感に目を見開きながら号泣絶叫\n特濃熱々精子で子宮を満たされて絶頂\nその後受精したことを魔力的なやつで感じてレイプ目でボロ泣き\n\nhttps://imgur.com/2973uNJ", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@sui_hope/works/31", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1580768, "client_id": 2918153, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44a817ae/uploads/origins/8c9cac94-af98-4736-9e68-ab2a4a11d9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36e466aa0dc4519c3a67cdd5bee9a142", "srcset": "https://si.imgix.net/44a817ae/uploads/origins/8c9cac94-af98-4736-9e68-ab2a4a11d9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36e466aa0dc4519c3a67cdd5bee9a142, https://si.imgix.net/44a817ae/uploads/origins/8c9cac94-af98-4736-9e68-ab2a4a11d9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=216c779b72884a38b0934ec3165a02d8 2x, https://si.imgix.net/44a817ae/uploads/origins/8c9cac94-af98-4736-9e68-ab2a4a11d9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9e1a7fe6155e69aeebf4b5b3bacca0e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44a817ae/uploads/origins/8c9cac94-af98-4736-9e68-ab2a4a11d9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7669696f6ba41a50879a3c975e47b495", "srcset": "https://si.imgix.net/44a817ae/uploads/origins/8c9cac94-af98-4736-9e68-ab2a4a11d9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7669696f6ba41a50879a3c975e47b495, https://si.imgix.net/44a817ae/uploads/origins/8c9cac94-af98-4736-9e68-ab2a4a11d9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e5c03222ce98ed6c86cecf65d7068977 2x, https://si.imgix.net/44a817ae/uploads/origins/8c9cac94-af98-4736-9e68-ab2a4a11d9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2fbd4f6cccdc1fcac260051ef8035cb6 3x"}, "body": "前回は素敵なラビアンのイラストありがとうございました！\n今回は白服を着ているラビアンをお願いしたいです。\n構図はおまかせしますが、太ももまで見えていると嬉しいです。\n\n【作画上の注意点】\n・白服の公式イラストがないため、ドット絵から想像してイラスト化して下さい。私がかつて描いた数枚のイラストを資料URLに添付しますので、よければ参考にして下さい。\n・ラビアンの髪型は前回と違い、右サイドの髪が短くてピアスをした耳が露出しており、後ろ髪の三つ編みが1本になっています。\n・ロザリオは前回と同じくケルト十字でお願いします。\n\nセクシーな衣装なので、ご自身の作風に合わなければ辞退して頂いて結構です。\n\nhttps://drive.google.com/drive/u/0/folders/1_gE7Lat3Zi7S8FFxO63TjcY1eB0NUN9H", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@8931ponzu/works/60", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 42736, "client_id": 2918153, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20b3bcd4/uploads/origins/1e26e8a8-27da-42f0-a0c4-748fa4e22638?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53df8219e86c58423e48aebe13b65338", "srcset": "https://si.imgix.net/20b3bcd4/uploads/origins/1e26e8a8-27da-42f0-a0c4-748fa4e22638?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53df8219e86c58423e48aebe13b65338, https://si.imgix.net/20b3bcd4/uploads/origins/1e26e8a8-27da-42f0-a0c4-748fa4e22638?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1876e03d8ebeee03bb9a88370c916fc5 2x, https://si.imgix.net/20b3bcd4/uploads/origins/1e26e8a8-27da-42f0-a0c4-748fa4e22638?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c4ec5a2e92e5680ce1242d66ca9d52e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20b3bcd4/uploads/origins/1e26e8a8-27da-42f0-a0c4-748fa4e22638?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=536b683daf4dbece652762ba2b762f37", "srcset": "https://si.imgix.net/20b3bcd4/uploads/origins/1e26e8a8-27da-42f0-a0c4-748fa4e22638?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=536b683daf4dbece652762ba2b762f37, https://si.imgix.net/20b3bcd4/uploads/origins/1e26e8a8-27da-42f0-a0c4-748fa4e22638?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ea3c9b6541bad4b942d0f74532c4d83 2x, https://si.imgix.net/20b3bcd4/uploads/origins/1e26e8a8-27da-42f0-a0c4-748fa4e22638?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d58e34d4185d894e598b196ebc7c7016 3x"}, "body": "いつもお世話になってますohaneです。初めてSkeb依頼させて頂きます。\n\n【キャラクター】\nSiNiSistar（シニシスタ）のラビアン\nhttps://www.dlsite.com/maniax/work/=/product_id/RJ247641.html\nhttps://www.a1c.jp/~majin/product_list/product_sinisistar.html\n\n【構図】\nポンズさんがいつも描かれているように、大きなバストアップ絵、中くらいの全身絵、小さなSDキャラの3体でお願いします。ポージングはおまかせします。\n全身絵では剣を持たせて下さい。剣は両刃の片手剣で、色は水色あるいは金色です（資料URLを参照）。\nキャラ配置はこちらの絵のように、バストアップ絵の胸が隠れないようにお願いします→https://skeb.jp/@8931ponzu/works/42 https://skeb.jp/@8931ponzu/works/52\n\n【背景】\nラビアンはシスターなので光輪（光背）を描いて頂きたいのと、彼女の衣装モチーフであるアゲハチョウと百合の花を描いて欲しいです。背景色についてはおまかせします。\nまた、ポンズさんは文字入れもお上手ですので、「SiNiSistar」「Rabiane」の文字を入れて下さい。難しい場合は文字無しでも大丈夫です。\n→こちらの絵のイメージに近いですhttps://skeb.jp/@8931ponzu/works/46 https://skeb.jp/@8931ponzu/works/50 https://skeb.jp/@8931ponzu/works/52 https://skeb.jp/@8931ponzu/works/53\n資料URLにも背景参考資料.jpgを添付しますので、よければ参考にして下さい。\n\n【その他】\nラビアンのロザリオはケルト十字です。\nベール（ウィンプル）の左右には、百合の花を模したと思われる白い装飾品、その根本にはアゲハチョウの翅の装飾品と、白リボンが下向きに2本付いています。\n表情は、憂いを含んだタレ目気味。あまり笑いません。\n\n以上となります。注文が多くて申し訳ありませんが、何卒よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/130FPt-92yQ2iwcXofu99WOSd6TzlXjdj", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sui_hope/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1580768, "client_id": 2918153, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a937825/uploads/origins/00