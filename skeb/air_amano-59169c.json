ano/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 738661, "client_id": 2417102, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/790c156a/uploads/origins/76484599-64c7-4c2d-af95-729623873c28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dad3c69815d4eecbb7a5ed44791e2170", "srcset": "https://si.imgix.net/790c156a/uploads/origins/76484599-64c7-4c2d-af95-729623873c28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dad3c69815d4eecbb7a5ed44791e2170, https://si.imgix.net/790c156a/uploads/origins/76484599-64c7-4c2d-af95-729623873c28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37e48cd931b8f88f68a70c07cfc7a9c6 2x, https://si.imgix.net/790c156a/uploads/origins/76484599-64c7-4c2d-af95-729623873c28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38dde7c7e77da29e669619fd4215df78 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/790c156a/uploads/origins/76484599-64c7-4c2d-af95-729623873c28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2763928ab827123813aebaed61a82b7", "srcset": "https://si.imgix.net/790c156a/uploads/origins/76484599-64c7-4c2d-af95-729623873c28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2763928ab827123813aebaed61a82b7, https://si.imgix.net/790c156a/uploads/origins/76484599-64c7-4c2d-af95-729623873c28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9b3ec730c5c885d39490d672af8203c1 2x, https://si.imgix.net/790c156a/uploads/origins/76484599-64c7-4c2d-af95-729623873c28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c88053d0f680f14f65c486cc8bbc2b4f 3x"}, "body": "一梨透というVtuberのイラストを描いていただきたいです。\n参考資料として2件のツイートのURLを添付します。\n\n彼は外見が20歳前後の青年です。\n中華