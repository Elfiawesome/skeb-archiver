4-c950adaf0565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ed9d737fe866e8d04a8685bb3f25ddc, https://si.imgix.net/243d83ae/uploads/origins/9b714033-78f1-443c-b404-c950adaf0565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8d4a5139eb94365eda3f239936afd25a 2x, https://si.imgix.net/243d83ae/uploads/origins/9b714033-78f1-443c-b404-c950adaf0565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5fb09f5f8883ae80a78a3c6b5d875419 3x"}, "body": "はじめまして！\n\n千年戦争アイギスに登場するエフネがなっがい竿で犯されている姿をお願いいたします。\n\nいくつか差分を頂きたいのですが、\n1.挿入前、お腹の上に竿を置いて犯す宣言\n2.挿入、お腹がボコっとなっていると嬉しい\n3.ピストン\n4.エフネ絶頂、ピストン止めず\n5.射精直前、さらに激しくなる\n6.射精\n7.勢いよく竿を引き抜く、エフネ潮ふいて絶頂\n\n構図はお任せいたしますが、表情が見えるものがいいです。\nまた、お任せでセリフもお願いいたします。\nエフネは敬語口調のメスガキ、竿役は乱暴な口調です。\n1の時、エフネは表面上は余裕そうにしていますが、竿の大きさにビビっている感じです。\n\n差分が多くなってしまうので、金額不足の場合は再送お願いいたします。\n\nよろしくお願いいたします。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@same_so_lovely/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 71793, "client_id": 166065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/382e7967/uploads/origins/7a771203-1a15-4dbb-98cd-2b7b8d389809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bcccf377f45b5df2987e9bef0341481", "srcset": "https://si.imgix.net/382e7967/uploads/origins/7a771203-1a15-4dbb-98cd-2b7b8d389809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bcccf377f45b5df2987e9bef0341481, https://si.imgix.net/382e7967/uploads/origins/7a771203-1a15-4dbb-98cd-2b7b8d389809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0dc446b0de8691c02f128f44f8ac619 2x, https://si.imgix.net/382e7967/uploads/origins/7a771203-1a15-4dbb-98cd-2b7b8d389809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8456068fb696fca6e170611a90c5da2a 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/382e7967/uploads/origins/7a771203-1a15-4dbb-98cd-2b7b8d389809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5071c9b489c212e8769f890cb8ebd2df", "srcset": "https://si.imgix.net/382e7967/uploads/origins/7a771203-1a15-4dbb-98cd-2b7b8d389809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5071c9b489c212e8769f890cb8ebd2df, https://si.imgix.net/382e7967/uploads/origins/7a771203-1a15-4dbb-98cd-2b7b8d389809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63253e82f2a48991214e632bc94499c9 2x, https://si.imgix.net/382e7967/uploads/origins/7a771203-1a15-4dbb-98cd-2b7b8d389809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4847119b9984fcd3a290298cc2957e8b 3x"}, "body": "はじめまして、リクエストお願いします\n\nキャラクター\n栗村アイリ(バンド)\n\nディルドオナニーを筆頭に自身で開発しまくって、肥大化しまくった乳首やヘソ、おまんこに自分でピアスまで開けちゃったドスケベオナ狂いJKになっちゃったアイリが、とうとう男を、本物のオチンポ様を知る為にパパ活に手を出してしまった。\n\nといった導入から始まるシチュのパパ活ハメ撮り録ベスト集的イラストを、エロ自撮り風落書きと「マゾオス先生とのアイリ直々のドスケベ解説付き同時視聴シチュ」のセリフ付きでお願いします。\n\n竿役は先生以外でお願いします。\n太ったデカチン種付けおじさま系だと尚良いです。\n\nアイリの体型\n・オナ狂いで使い込まれた後の変形が目立つ、垂れ気味普通サイズおっぱい。\n・乳首、乳輪は過酷なオナニーで肥大化\n・肋の浮いたドスケベなスレンダーボディ\n・陰毛は有り。さめさんがアイリに抱くイメージにあった濃さと整え具合で。\n\n以下、全てが難しい場合、チンポにキタ内容を抜粋してお願いします。\n⑦は必ず採用して欲しいです\n\n欲しい内容\n各シーンの時系列はバラバラで、連続したプレイではない物をランダムに視聴している設定でお願いします。\n\n①処女喪失前(膜は無いけど)のパパ活お誘い様の自撮り写真\n卑猥なパパ活お誘い落書きデコ付き\nこれが先生に見つかった所から開始\n\n②今から生ハメSEXしまーす♡な感じのおじさまとの2ショット\n立ち絵でおじさまに密着して、カウパードバドバな勃起チンポをフェザータッチ手コキしながら、自身はおじさまに尻を掴まれマンホジされている。\n\n③仁王立ちしたおじさまのチンポに媚びるような亀頭キスからのねっとりとしたフェラチオ\n射精後のザーメンブリッジが出来ている様子でもOK\n\n④全身大人のオモチャフル装備寸止め稼働中のアクメ我慢→フルパワー稼働からのヘイロー半壊連続デスアクメ\n\n⑤構図お任せの生本番SEX\n開発、調教やガチ種付けの男性優位でも、アイリがチンポを貪る形のビッチ全開女性上位でもOK\n\n⑥ベッドに仰向けで打ち捨てられた精液塗れのアイリが、アヘ顔かいやらしい笑みでマンコからザーメン噴水しながらオホ声で余韻アクメ決めている様子\n\n⑦父親のわからない子を孕んだ母乳たっぷりデカ黒乳首ボテ腹妊婦アイリが全裸でAVデビューしている様子(出来れば局部ピアスマシマシ)\nこちらはAVパッケージ風立ち絵か、全裸で後ろから愛撫されながらインタビューを受けている様な感じで。\n\n上記内容で何卒よろしくお願いします。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@same_so_lovely/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 71793, "client_id": 1047, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef2264a7/uploads/origins/4ec2b897-2eef-4f3c-a2a1-b3de49ee70eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a83d9a6550c7636755d8b022dd0743c0", "srcset": "https://si.imgix.net/ef2264a7/uploads/origins/4ec2b897-2eef-4f3c-a2a1-b3de49ee70eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a83d9a6550c7636755d8b022dd0743c0, https://si.imgix.net/ef2264a7/uploads/origins/4ec2b897-2eef-4f3c-a2a1-b3de49ee70eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e17a6ef8016c8c75d2ffe41536373e4 2x, https://si.imgix.net/ef2264a7/uploads/origins/4ec2b897-2eef-4f3c-a2a1-b3de49ee70eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe6af4900064270d73bf0e8f29cba866 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef2264a7/uploads/origins/4ec2b897-2eef-4f3c-a2a1-b3de49ee70eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d52d12fe27099a3e2551dacf7422d6b", "srcset": "https://si.imgix.net/ef2264a7/uploads/origins/4ec2b897-2eef-4f3c-a2a1-b3de49ee70eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d52d12fe27099a3e2551dacf7422d6b, https://si.imgix.net/ef2264a7/uploads/origins/4ec2b897-2eef-4f3c-a2a1-b3de49ee70eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb71e47025ef9f84febf8f5e14c3e23f 2x, https://si.imgix.net/ef2264a7/uploads/origins/4ec2b897-2eef-4f3c-a2a1-b3de49ee70eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&f