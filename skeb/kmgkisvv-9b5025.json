op&crop=top&w=200&h=200&blur=200&s=f8f98cbbb0d4412f401f7bdd85638b42, https://si.imgix.net/03a27400/uploads/origins/aa4b5641-b03c-447f-831e-db1bde234375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=088c421914433e273f50a34aa1f97f85 2x, https://si.imgix.net/03a27400/uploads/origins/aa4b5641-b03c-447f-831e-db1bde234375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3de8e7eb3f9f2ec03c8452bbd4db128a 3x"}, "body": "こんにちは！あなたの画風が本当に大好きです。もし私のオリジナルキャラクターを描いていただけたら、とても嬉しいです！\n\nポーズや構図、雰囲気について特に指定はありませんので、どうぞお好きなように彼女のキャラクターを表現してください！彼女のキャラクターに合いそうだとお考えのものを、何でも描いていただいて構いません。\n\n彼女のキャラクターリファレンスシートとプロフィールは、リンク先からご覧いただけます。\n\nお時間を割いてご検討いただき、本当にありがとうございます！あなたの解釈で描かれた彼女を拝見できるのを楽しみにしています！\n\nhttps://drive.google.com/drive/folders/1q87xphGfPNvayRLfqMg_adrXDWw-giJ-", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kmgkisvv/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4149837, "client_id": 3135294, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4edeb417/uploads/origins/4c5daea1-f7c0-4043-a144-1f038a1c5d65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=674b7c9e6faa0e4e309f9a8b37e6ee93", "srcset": "https://si.imgix.net/4edeb417/uploads/origins/4c5daea1-f7c0-4043-a144-1f038a1c5d65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=674b7c9e6faa0e4e309f9a8b37e6ee93, https://si.imgix.net/4edeb417/uploads/origins/4c5daea1-f7c0-4043-a144-1f038a1c5d65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4e824050bf92edfa127695036acbd24 2x, https://si.imgix.net/4edeb417/uploads/origins/4c5daea1-f7c0-4043-a144-1f038a1c5d65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c15b56f1e0f96018ed66794985d353a1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored