いて\n下記について可能な範囲までを設定していただき、イラスト内に記していただきたいです。\n（可能であれば彼女自身が自筆でアンケートに答えたかのような演出をいただけないでしょうか）\n①名前・年齢\n②スリーサイズ（カップサイズ含む）\n③週ごとのオナニー回数、主な使用器具\n④経験人数\n⑤今日の絶頂回数\n⑥好きなプレイ\n⑦好きな体位\n⑧今までで一番気持ち良かったシチュエーション\n\n\n指定していない部分につきましては、藤狐様のフィーリングにお任せできないでしょうか。\nありえないくらい雑多かと思いますが、可能であればお願いいたします。\n\nhttps://drive.google.com/drive/folders/19_eCh-IEcRncwrfdJU3XUylp1SaheBaD", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fujikitsune_r18/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2922475, "client_id": 1416911, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9df7ceca/uploads/origins/f6f424bf-fa3d-49e5-b623-b2033a23a964?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4016477f4ffb1e97ed9b0e6789c4fa13", "srcset": "https://si.imgix.net/9df7ceca/uploads/origins/f6f424bf-fa3d-49e5-b623-b2033a23a964?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4016477f4ffb1e97ed9b0e6789c4fa13, https://si.imgix.net/9df7ceca/uploads/origins/f6f424bf-fa3d-49e5-b623-b2033a23a964?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbad690fdb70087a5fd14c4f1d626dfd 2x, https://si.imgix.net/9df7ceca/uploads/origins/f6f424bf-fa3d-49e5-b623-b2033a23a964?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab89fec95419aad1d6c48c7434b8c041 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9df7ceca/uploads/origins/f6f424bf-fa3d-49e5-b623-b2033a23a964?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47063c0821c948233f90420c0ef0f774", "srcset": "https://si.imgix.net/9df7ceca/uploads/origins/f6f424bf-fa3d-49e5-b623-b2033a23a964?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47063c0821c948233f90420c0ef0f774, https://si.imgix.net/9df7ceca/upload