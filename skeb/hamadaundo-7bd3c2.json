fa1779c9a69e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97f2dab29708373ee2c3ebb47e20c92c, https://si.imgix.net/c0fae8d1/uploads/origins/939b32a8-72ae-4610-b86b-fa1779c9a69e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=04fad7df953e2b5eb7e41e7cdbede75b 2x, https://si.imgix.net/c0fae8d1/uploads/origins/939b32a8-72ae-4610-b86b-fa1779c9a69e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb4d0f7a7263497c31b24845d4998ec6 3x"}, "body": "なつのりさん、こんにちは！あなたの『ウマ娘』のアートが大好きです。私のオリジナルキャラクター（OC）のイラストをお願いしたいのですが！\n\nクォンタム・リープ (165cm) \n彼女は冷静沈着で気さくな性格ですが、学業の成績はひどく悪いことで有名です。 \n私のオリジナルキャラクターをシリウスシンボリと一緒に描いていただけませんか？構図はあなたにお任せしたいのですが、例えば一緒にトレーニングしているところや、食事をしているところなどがいいかなと思っています。自由に描いて、楽しんでください！参考画像が不明確な場合は、詳細を変更したり調整したりしていただいて構いません。\n\n変なリクエストで申し訳ありません。もし気が進まない場合は遠慮なくお断りしてください。ご検討いただき、本当にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1y-Jo4s_HfsOOwLZiHK7WsVRA9uPOml8q?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamadaundo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2860280, "client_id": 405731, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/732397a6/uploads/origins/7c9280bb-741b-4ac1-8b9b-3f4a8e375156?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f93a5cde0d881da77dbaf6fd1ac87d44", "srcset": "https://si.imgix.net/732397a6/uploads/origins/7c9280bb-741b-4ac1-8b9b-3f4a8e375156?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f93a5cde0d881da77dbaf6fd1ac87d44, https://si.imgix.net/732397a6/uploads/origins/7c9280bb-741b-4ac1-8b9b-3f4a8e375156?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20c0fcda5f905a17dc27e49acab19b8c 2x, https://si.imgix.net/732397a6/uploads/origins/7c9280bb-741b-4ac1-8b9b-3f4a8e375156?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d4a9541668ee48f4925b57611bbf843 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/732397a6/uploads/origins/7c9280bb-741b-4ac1-8b9b-3f4a8e375156?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9471037eaad6bed9eab1d3b30217c255", "srcset": "https://si.imgix.net/732397a6/uploads/origins/7c9280bb-741b-4ac1-8b9b-3f4a8e375156?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9471037eaad6bed9eab1d3b30217c255, https://si.imgix.net/732397a6/uploads/origins/7c9280bb-741b-4ac1-8b9b-3f4a8e375156?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3995a29728ce4da98899a1df37985e4d 2x, https://si.imgix.net/732397a6/uploads/origins/7c9280bb-741b-4ac1-8b9b-3f4a8e375156?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df496c8e097963290eaa1eb8f69c9702 3x"}, "body": "はじめまして、Twitterで素敵な作品を拝ませて頂いています！\n重層的で立体感のある塗りや、キャラの個性を感じる豊かな表情に惹かれています。\n私もぜひ一枚お願いしたいと思い依頼させていただきます。\n\nリクエストですが、以下の内容でお願いします。\n・フサイチパンドラがシンボリクリスエスと水族館デートをしているシーン\n・パンドラが大きな水槽を背にして、振り向きながら満開の笑顔を向けている構図\n・服装は可能であればお任せの私服で、困難であればクルクルの衣装でお願いします\n\nパンドラはまだ出番が少なくキャラ像が掴みにくい面もあるかと思いますが、とても可愛らしくて推していきたい娘のひとりです。\nそして史実夫婦であるクリスエスとの関わりがあったら嬉しいな…という思いからこのペアにしました。\nまたなつのりさんの作品の中でも特に青色の使い方が好きで、水族館というシチュエーションが合うのでは？と感じてこの内容で依頼することにしました。\nぜひご承認のほどよろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamadaundo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2860280, "client_id": 3663811, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f9ddd64/uploads/origins/e73501b9-ce57-4034-ae7b-a9e2e0c83e32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b57243a2e097b227540f1bbe14450008", "srcset": "https://si