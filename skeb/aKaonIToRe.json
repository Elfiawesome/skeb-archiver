4f91-9021-c77e77ba2a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e4fce40e244edd36936f2001d3946dc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df66aa73/uploads/origins/43fed7e3-6616-4f91-9021-c77e77ba2a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=475a29b8b7587d4c85c979f7740ac1b6", "src_set": ""}, "body": "こんにちは！うるたです〜\nにとれくんにキャラデザしてもらえないかなと思ってきました🤙\nおっきいおっぱいで穏やかor弱気な女の子をデザインしていただけないでしょうか？！\n少し人とは違う要素(悪魔とか天使とか)を入れてくれたら嬉しいです\n色味とか衣装とかは好みにお任せします！🤪\n\nラフで構いませんので是非…！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aKaonIToRe/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 696755, "client_id": 1832119, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71d4dfb1/uploads/origins/e4a72f18-37d5-4c3e-b7c6-7d7eb188fba7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=683faff1adf78cd7451239cbde2f8926", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71d4dfb1/uploads/origins/e4a72f18-37d5-4c3e-b7c6-7d7eb188fba7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd0e0e3b18c40fee0532658e67f998e2", "src_set": ""}, "body": "こんにちは！！！！！！！！！！！！！！！！！！！！（笑\n私のコードヴェインのキャラクターの絵を依頼したいのですが、可能でしょうか？\n\n少し前かがみになってピースサインをして、ドヤ顔をしているようなイメージです。\n\nサイズは通常のものとは違います。参考資料は以下の通りです。\n\n普段とは違う服を着ていると思います。着用して欲しい服は、服の参照先にリンクしておきます。もしよろしければ、彼女の胸を十字型の胸カバーで覆っていただけませんか？  もし、もっとカバーする必要がある場合は、非常にぴったりしたブラジャーを自由に与えてください。\n\nリフェレンスキャラクター - https://drive.google.com/file/d/1O1BwRdwGfRzayVaDWogcs3cVGfwGCwSK/view?usp=sharing\n\n参考サイズ - https://twitter.com/usukeninja/status/1483529630250409988\n\nリファレンス・アウトフィット - https://twitter.com/city_vale/status/1429730130826604546\n\nReference Breast Covers - https://i.ebayimg.com/images/g/UZwAAOSw~BtdN~zm/s-l400.jpg\n\nご協力ありがとうございました。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aKaonIToRe/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 696755, "client_id": 946478, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24b6fd86/uploads/origins/adf6b842-e53c-43c5-9494-32f855d79f00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88ee7d86ccb8b5ee2b24dd6467a135e1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24b6fd86/uploads/origins/adf6b842-e53c-43c5-9494-32f855d79f00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71bd8b6bdacd1278d1090b25f6e14c9b", "src_set": ""}, "body": "こんにちは。  欲望に満ちた表情で、片手をお腹に当てて、しゃがんだポーズのOCをお願いします。\n ストッキングとタイトなショーツによる太もものくびれと、シャツピースによる胸のこぼれを追加してください。\nどうもありがとうございました!(^-^)/\n\nOCリファレンス： https://imgur.com/a/maDNzv9\nポーズのリファレンス： https://imgur.com/a/YAgtJRb", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aKaonIToRe/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 696755, "client_id": 951125, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/56904230/uploads/origins/77babfeb-cd6d-49a5-8281-3df61a469991?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac8b62d181a9d90debb69d87e8b70531", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56904230/uploads/origins/77babfeb-cd6d-49a5-8281-3df61a469991?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f14c8352106ae47dd95464729062712", "src_set": ""}, "body": "またまたこんにちは。\n前回の作品がとても良かったので、今回もまたお願いします。FF14のOCにタイトなバニースーツを着せて、リファレンスのようなポーズを取らせたいです。バニースーツと太ももが彼女にぴったりフィットして、素敵なスキッシュができるようにしてください。あなたが思うところのタンラインを加えて、彼女のプロポーションを太く、しかし少しフィットしたものにしてください。そして、可能であれば、彼女のボディと顔のタトゥも入れてください。\n宜しくお願いします。\n\nOC: https://imgur.com/a/2P9rCo2\nアウトフィット： https://imgur.com/GTd9LTQ\nポーズ： https://imgur.com/QdGfGvn", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aKaonIToRe/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 696755, "client_id": 846137, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb4d1326/uploads/origins/291e3efc-41e5-42ea-8cb6-ec5d3a2bfb1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=965a73718b344abb8f04650360f62f5c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb4d1326/uploads/origins/291e3efc-41e5-42ea-8cb6-ec5d3a2bfb1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e96514ce8ffb1929ba71f44af9da026d", "src_set": ""}, "body": "こんにちは！！！！！！！！！！！！！！！！！！（笑私はあなたから依頼を受けることができると思っていました。\n私のキャラクターであるDahutが牛柄のランジェリーを着ているイメージを希望します。あなたの他の作品と同じように、胸とお尻が大きくなっているはずです。彼女のお尻は見る人の方に向いているようにしたいです。お尻には赤いハートのタトゥーがあり、その中には \"Q \"の文字が入っているはずです。\n最後に、Dahutは首輪をつけられていて、その鎖をずっと小さくて若いショタが握っていてほしいです。\nご検討いただき、ありがとうございました。\n\nhttps://cdn.discordapp.com/attachments/839741619183026179/844111533570785301/BisonAdopt1.png", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aKaonIToRe/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 696755, "client_id": 951125, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/375452af/uploads/origins/fcea4895-08b8-4f31-aa8d-88257606656e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a4af7cfc8777c5167ddfc405baaf506", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/375452af/uploads/origins/fcea4895-08b8-4f31-aa8d-88257606656e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23846d537a41d8590f862cd8e0bec270", "src_set": ""}, "body": "こんにちは。\nFF14に登場する私のOCに、参考資料と同じような衣装をリクエストしたいのですが、赤を緑に変えてください。ポーズは同じリファレンスに似ていますが、下のストラップを引っ張るのではなく、右手で上のストラップを引っ張り、胸が少し上に押し込まれるようにします。可能であれば、彼女が引っ張っているストラップの下や他の部分にタンラインが見えるようにしてください。彼女のプロポーションは、太くても少しフィットしているように、衣装の参考と同様に、自由に大きくしてください。可能であれば、彼女の体と顔のタトゥーも入れてください。\n宜しくお願いします。\n\nOC: https://imgur.com/a/2P9rCo2\n衣装・ポーズ・プロポーション： https://twitter.com/ClickAgain/status/1457876632438329348\nストラッププル： https://twitter.com/ClickAgain/status/1121344781739675649", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 337967, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ub1mo", "screen_name": "ub1mo", "avatar_url": "https://pbs.twimg.com/profile_images/1935594676133699584/p7m1B8Ag.jpg", "header_url": "https://pbs.twimg.com/profile_banners/386081725/1731241553/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 160}, {"id": 414863, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぜろご", "screen_name": "0_5zero", "avatar_url": "https://pbs.twimg.com/profile_images/1435665130398760960/QiuQ0llK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1331706673/1613957961/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "skills": [{"genre": "art"}], "nc": 48}, {"id": 1200751, "creator": true, "nsfw_acc