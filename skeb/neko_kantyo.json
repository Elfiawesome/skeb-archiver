_visible": false, "total_appeals_count": 2, "received_works": [{"path": "/@neko_kantyo/works/32", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 116413, "client_id": 3098318, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7cb6c7e5/uploads/origins/0c5bc827-4791-4b98-b2d6-5f64fe37b656?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3a9b8e2de6b793e3f38c40cda1c6ccd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7cb6c7e5/uploads/origins/0c5bc827-4791-4b98-b2d6-5f64fe37b656?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bcddc2c563357bcdd7bf90b70c073af", "src_set": ""}, "body": "こんにちは！\nリクエストなのですが、メスガキナズリンを描いていただけませんか？\nよろしくお願いします！", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neko_kantyo/works/31", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 116413, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd5d82cd/uploads/origins/abf11f6e-61d0-4abc-bfa4-be26614b60b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6acc8d76b2431c093ba392dd4991964", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd5d82cd/uploads/origins/abf11f6e-61d0-4abc-bfa4-be26614b60b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94d2303631390e01b87fc6707b9c5c90", "src_set": ""}, "body": "こんにちは！ ナズーリンのかわいいイラストをありがとうございました！ 次のリクエストなのですが、またナズーリンを描いていただけないでしょうか？ またエキゾチックなダンサーの衣装を着ているナズーリンが見たいです！ デザインと構図はお任せします！ ありがとうございました！  \n\nHello! Thank you for the wonderful cute illustration of Nazrin! For my next request, can you please draw Nazrin again? I would love to see Nazrin wearing another exotic dancer outfit! I'll leave the design and composition up to you! Thank you very much!", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neko_kantyo/works/30", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 116413, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/49de473b/uploads/origins/a6fc200c-3ef3-4d93-a1be-d2914eaeb876?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cee3cba339583b2c038146d99a3bf7e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/49de473b/uploads/origins/a6fc200c-3ef3-4d93-a1be-d2914eaeb876?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b306e54f0a1a7fa8f459a5f5a980161", "src_set": ""}, "body": "いつもイラスト楽しく拝見させていただいています……！\n\n可能であれば、私のオリキャラで3人で絵を描いていただきたいです。\nキャラクターの資料は、資料URLの方に記載しています。\nシチュエーションはおまかせしますが、みんなで仲よさそうな雰囲気のものであると嬉しいです。\nその他の点はおまかせいたします！\n\nよろしくお願いいたします……！\n\nhttps://x.com/NDliner41/status/1625520852849807361", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neko_kantyo/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 116413, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c3782b91/uploads/origins/38a0bba7-5dc9-464f-a1e5-e99359a3ecde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ffab79a58146c09ee47dec898fdcc52", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c3782b91/uploads/origins/38a0bba7-5dc9-464f-a1e5-e99359a3ecde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cc9b2eb314a38bf263fafce91a4f0e5", "src_set": ""}, "body": "こんにちは！ ぐるぐる目をテーマにナズーリンを可愛く描いてくれませんか？ お任せします！ ありがとうございました！   \n\nHello! Would you be able to draw Nazrin cutely with ぐるぐる目 as a theme? I'll leave everything up to you! Thank you very much!", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neko_kantyo/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 116413, "client_id": 3404007, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0689766f/uploads/origins/107a7d3c-ef69-447c-9efb-a3707ab5d67b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df61212f4470f8c53667c9b858915a05", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0689766f/uploads/origins/107a7d3c-ef69-447c-9efb-a3707ab5d67b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98e6d372bb77c89426232ee4fa41f8e8", "src_set": ""}, "body": "VtuberのFerumi Kaipaのアートが欲しい。彼女は生意気な虫エイリアンだ。東方の蠢く夜虫のコスプレをしてほしい。ポストやその他の詳細はお好みで。\n\nFerumi Kaipa参考：https://imgur.com/a/pQC7Kr9\nWriggle衣装のコスプレ参考：https://imgur.com/a/ZQzbKrt", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neko_kantyo/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 116413, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb72f575/uploads/origins/24ae88e5-de4b-4e00-9285-329c28561bfa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cfd60d1bab4e9fd03c6c12e8395d69f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb72f575/uploads/origins/24ae88e5-de4b-4e00-9285-329c28561bfa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc7bd877c313dd829c27efd7dcf12fec", "src_set": ""}, "body": "こんにちは！\nお元気ですか？\nリクエストなのですが、またナズーリンを描いていただけないでしょうか？\nできれば、かわいい服を何着か着てほしいです！\nでは、よろしくお願いします。\nありがとうございました！\n\nHello!\nI hope you are doing well!\nFor my request, would you be able to draw Nazrin again?\nI would like to see her wearing a few cute outfits, if that is possible!\nI'll leave everything up to you.\nThank you very much!", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neko_kantyo/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 116413, "client_id": 2475289, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2878f490/uploads/origins/fc1722d7-7ff4-4b22-a580-27ae38cb1257?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6be018480e9c0cfba5400786694145db", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2878f490/uploads/origins/fc1722d7-7ff4-4b22-a580-27ae38cb1257?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6d3819e914dc84a4a97909a9310455f", "src_set": ""}, "body": "はじめまして。描かれている可愛いイラスト、とても好きです。\n本居小鈴のイラストをリクエストしたいのですが。\n構図は「白ソックスを履いた可愛らしい足」をメインにしたいと考えていて、具体的には：\n・小鈴が布団の上でうつ伏せになり、本を読みながら足をぷかぷか浮かせている姿\nもしくは\n・布団に半身を預けて背中を枕に靠れ、本を膝の上に置いて読んでいる姿\nのどちらかをイメージしています。\n\nもし他に良いアイデアがあれば、先生の好きなように描いていただいて大丈夫です！\nよろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neko_kantyo/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 116413, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e53403d/uploads/origins/b860d248-33a0-4fad-bef3-e1e7150dc9be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcbfbbcf3242064b70a30ad685824fff", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e53403d/uploads/origins/b860d248-33a0-4fad-bef3-e1e7150dc9be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc150f60a9810c87996209ed2205c5ee", "src_set": ""}, "body": "こんにちは、お元気ですか？\nあなたが描いてくれた素敵なナズーリンのイラスト、本当に大好きです！\n何をお願いしようか悩んでいるのですが、ナズーリンにまたエキゾチックダンサーの服を着せるか、チアリーダーの服を着せるか、決めていただけませんか？\nすべてお任せします！\nいつもありがとうございます！\n\nHello, I hope you are doing well!\nI really loved all the wonderful Nazrin illustrations you made for me!\nI'm having a hard time deciding what to ask for, so would you be able to decide whether to draw Nazrin in another exotic dancer outfit or cheerleader outfit?\nI'll leave everything up to you!\nThank you very much always!", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neko_kantyo/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 116413, "client_id": 626297, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b90b2e6e/uploads/origins/7557f6e1-7067-4f9b-a369-16fa30ebf311?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3240f469b47c08dd2b0d677fd8dd1eac", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b90b2e6e/uploads/origins/7557f6e1-7067-4f9b-a369-16fa30ebf311?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2972a26d3e8258dca6d206b8dd7db5d", "src_set": ""}, "body": "ねこぐさ艦長様\n\nはじめまして、ありのみと申します。\n先生に東方projectのチルノさんと大妖精さんを\n踊り子衣装でお願いしてもよろしいでしょうか？\n\n念のため２人の資料画像を用意していますので、もしよろしければ下記URLをご参照下さい。\nhttps://twitter.com/ARINOMI7/status/1549022259926695938\n個人的な印象ではありますが\n　身長体型は似たり寄ったりでお胸も２人ともぺたんこ\n　（強いて言えば チルノさん≧大妖精さん）\n　チルノさんはちょっとクセ毛のツリ目系で、裏表の無い勝気で活発なタイプ\n　大妖精さんはタレ目系で、口数が少なくどちらかと言えば内気なタイプ\n　よく一緒にいる仲良しコンビの印象があります。\n\n　羽のデザインは媒体によってよく変わりますので、それっぽい雰囲気であれば\n　大きさや形、枚数や付いている場所(浮いているかどうか)など自由です\n　　大妖精さんはドット絵の様子から\n　　ミスティアさんやリリーさんのような鳥感のある造形かなと思っておりますが\n　　ピンとこない場合は無視して頂いて、先生の描きやすい方向でお願いします\n\n２人をファンタジー作品等に見られるセクシーなダンサー衣装でリクエストいたします。\n服のデザイン、構図、シチュエーション等は先生にお任せでお願いいたします。\n２人１枚の構図でも、１人ずつ２枚のものでも問題ございません。\n\nもしよろしければご検討下さいますよう、何卒お願い申し上げます。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neko_kantyo/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 116413, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b915b2d1/uploads/origins/40167bf1-951c-430a-9c50-27493e555f5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3e79085f16e61526d231f1ad01ae761", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b915b2d1/uploads/origins/40167bf1-951c-430a-9c50-27493e555f5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7dff06a23375e32bdd40dbb0e2b7ac80", "src_set": ""}, "body": "Hello,\nThank you very much for your wonderful Nazrin illustrations!\nI can't decide what to request next, so I'll provide some ideas, but I'll leave everything up to you!\nI want to see Nazrin wearing something cute, like a dancer outfit, or cheerleader outfit, or anything cute!\nI'll leave everything up to you!\nThank you very much!\n\nこんにちは、\n素晴らしいナズーリンのイラストをどうもありがとう！\n次は何をお願いしようか迷っているので、いくつかアイデアを出しますが、全てお任せします！\nナズリンにかわいいものを着せてほしいです！ダンサーの服とか、チアリーダーの服とか、ビキニとか、小さくてかわいいものがいいです！\nすべてお任せします！\nありがとうございました！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neko_kantyo/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 116413, "client_id": 578438, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be4a114b/uploads/origins/fd521c2f-7752-4b3d-a4aa-58bfb176f118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d91f648e678f870dc8fe841c00d18c61", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be4a114b/uploads/origins/fd521c2f-7752-4b3d-a4aa-58bfb176f118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96a1c8710ec7a9e0cb55f9b8a704e647", "src_set": ""}, "body": "前回の足ナズーリン、大変素晴らしかったです！もう一度ナズーリンのイラストをお願いしたく思います。\nシチュエーションは下記でお願いいたします。\n　①ナズーリンのタイツ脚がメインの構図\n　②足先まで見えているとありがたいです。\n　③靴下、裸足等の差分があるとありがたいです。\n\n③はできればで大丈夫です。\nポーズ等はお任せいたします。\nよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neko_kantyo/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 116413, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9bea29e/uploads/origins/c36116ea-668e-48d0-b931-8cde4760f34b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76ff3db0ad592f45a092af70ce8d875a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9bea29e/uploads/origins/c36116ea-668e-48d0-b931-8cde4760f34b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f587371c71ce59ad0d63c71293f09c8", "src_set": ""}, "body": "Hello,\nI hope you are doing well!\nThank you very much for your previous cute Nazrin illustration!\nFor my next request, can you please draw Nazrin who is trying on cute clothing?\nAn atmosphere like this would be great!\nhttps://skeb.jp/@wheat_retzel/works/4\nThank you very much as always!\n\nこんにちは、\nお元気でお過ごしでしょうか！\n前回のかわいいナズーリンイラストありがとうございました！\n次のリクエストですが、かわいい服を試着しているナズーリンを描いていただけませんか？\nこんな雰囲気だと嬉しいです！\nhttps://skeb.jp/@wheat_retzel/works/4\nいつもありがとうございます！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true