でも狼と暮らすことは享受していて、どこかへ行く理由もありません。\n\n狼は羊という存在そのものに救われたいと願っていますがそれ以上の求め方を知りません。一方で空っぽの羊はどれほど縋られても何かを与えることはできず、誰かから与えられることさえ受け取れません。\n\n空っぽの2人がただ同じ場所で暮らし、役目を演じる続ける。そんな箱庭の中のふたりごっこです。\n\n▶どちらか片方のみでも、二人一緒でも大変嬉しいです！\n資料が少なくて本当にすみません.....😭💦💦\n服装はそれぞれ白・黒基調であれば自由にアレンジしていただいて問題ございません。描きやすいようにデザインや構図なども含め、全てふえきち先生のお好きなように描いていただけましたら嬉しいです！\n\nもし金額が不足しておりましたら、お手数ですが再送要請をいただけますと幸いです。\nご検討のほど、よろしくお願いいたします……！！！\n\nhttps://drive.google.com/drive/folders/1qrd7bt0OY7KyO8aEnEJhDXWhS8J_p_pl", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1589464, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "tmtmm", "screen_name": "TAMITOMEMO", "avatar_url": "https://pbs.twimg.com/profile_images/2018996551889424384/-yGIS537.jpg", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 2257463, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "米粒くん", "screen_name": "asoi002", "avatar_url": "https://pbs.twimg.com/profile_images/1556956455051599872/WgL49TSM.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 3225341, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "fy_fp7", "screen_name": "fy_fp7", "avatar_url": "https://pbs.twimg.com/profile_images/1964226856087146499/IjTD8lar.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1885511593070649344/1746858486/1500x500", "appeal_receivable": true, "popular_creator_rank": null, 