&s=2d7dc061b23d58510c4fc7dacae583b0", "srcset": "https://si.imgix.net/6f0155a1/uploads/origins/04b079e0-46fb-4752-92a5-4fabf1c95e7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d7dc061b23d58510c4fc7dacae583b0, https://si.imgix.net/6f0155a1/uploads/origins/04b079e0-46fb-4752-92a5-4fabf1c95e7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4dfa878c31e36fa7c084a2c9d765b4b8 2x, https://si.imgix.net/6f0155a1/uploads/origins/04b079e0-46fb-4752-92a5-4fabf1c95e7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6eaafcf39684c99b8970d30f46ed2d9d 3x"}, "body": "おいもち様\n\nこんばんは、おいもち様。\nツイッターからイラストを拝見させて頂いてファンになったものです。\n実際存在してる人物の日常がデフォルメで表現されたような感じがとても好きです！女の子たちも可愛くて！\nそんなおいもち様がスケブを開いていらっしゃることを知り、もしよろしければこちらのオリキャラのことを依頼したいです。\n\nお願い申し上げたいのはこちらのオリキャラ狐娘の万里香（まりか）という子です。\n狐耳と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の子です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。一人の時や知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘でおいもち様の絵柄でのイラストをどうかお願いしたいです。\n衣装は設定画のうちの一つで、夏を堪能してる感じはどうでしょうか？\nご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1757350, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "zooon✴︎ｺﾐﾃｨｱ156 う08a", "screen_name": "zooonzoonzon", "avatar_url": "https://pbs.twimg.com/profile_images/1760592083587620864/yhtHgpjB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1071430771/1689827159/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_d