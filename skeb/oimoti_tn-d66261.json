どちらも和風の雰囲気を持ったキャラクターです。\n\n衣装は、詳細ページの制作ファイル内にある「二人関係-二人服」の中から、お好きなものをお選びいただいて構いません。\n\n【二人の関係性のイメージ】\n・普段は飄々と皮肉っぽく人をからかう巫女と、基本は無関心ながらも、なんだかんだ相手の冗談に付き合ってあげる武士。\n・巫女の悪ふざけに呆れつつも、「まあいいか」と受け流してしまう武士。\n\n二人の関係は「相性は悪くないけれど、どこか他人のような距離感」です。\n長く一緒にいるものの、離れてもそれぞれ一人で淡々とやっていけるタイプで、「輝いている」というより「一人に慣れている」といった印象です。\n\nまた、本来あまり責任感があるタイプではないのに、なぜか自分とは無関係だったはずの罪や運命を背負うことになっている、という共通点もあります。\n出会いには、「同じ地に堕ちた者同士」のような、静かな共鳴があるイメージです。\n\n雰囲気やシーンなどは、先生のご解釈で自由に描いていただけましたら嬉しいです。\n\nもし金額が不足している場合は、再度ご連絡いただけますと幸いです。\nご検討のほど、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1U6j6GPL0lF03rcI3Wv7yjyAO1kY18oF_", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oimoti_tn/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 360653, "client_id": 27685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f0155a1/uploads/origins/04b079e0-46fb-4752-92a5-4fabf1c95e7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9cf9c85f6cb442fe14666d4fb2e2560", "srcset": "https://si.imgix.net/6f0155a1/uploads/origins/04b079e0-46fb-4752-92a5-4fabf1c95e7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9cf9c85f6cb442fe14666d4fb2e2560, https://si.imgix.net/6f0155a1/uploads/origins/04b079e0-46fb-4752-92a5-4fabf1c95e7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ebd2e6d085229b99e2a662aba5c474a 2x, https://si.imgix.net/6f0155a1/uploads/origins/04b079e0-46fb-4752-92a5-4fabf1c95e7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e71d5d3669ffffc3db6a8fb3b29cd2a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f0155a1/uploads/origins/04b079e0-46fb-4752-92a5-4fabf1c95e7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d7dc061b23d58510c4fc7dacae583b0", "srcset": "https