6c0813/uploads/origins/9aad42aa-90b3-4199-9f43-c21d0eeaf139?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bac86d45f8bac3ef51517264620e185d, https://si.imgix.net/836c0813/uploads/origins/9aad42aa-90b3-4199-9f43-c21d0eeaf139?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c9282f320837050749bc6b822b36c273 2x, https://si.imgix.net/836c0813/uploads/origins/9aad42aa-90b3-4199-9f43-c21d0eeaf139?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f3ec4d7e4d839ab9b66975ecb2e4986a 3x"}, "body": "げっしーさんこんにちは、いつも素敵なイラスト楽しみにしてます〜！\n\n今回は4月16日の私の誕生日イラストをお願いしたくリクエストさせて頂きました！\n\nシチュエーションは「シェフィちゃんが不慣れながらも初めてケーキを作って、少し恥ずかしがりながらケーキをこちらに手渡そうとしている」シーンをお願いします。\nまた、もし可能でしたらシェフィちゃんに漫画のように吹き出しを付けてげっしーさんのお好きなセリフを入れたり、空いているスペースにげっしーさんからの誕生日コメントも書いて下さると嬉しいです…！\n\nそれ以外はげっしーさんのお任せでお願いします！\n要望が細かくなってしまいましたが、何とぞよろしくお願いします〜！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gessyturn/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2113213, "client_id": 668047, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/124ca9f7/uploads/origins/271825fb-390b-414d-9240-dcaf8ed51e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c2c5bbe068030cba19b32a3d154edb3", "srcset": "https://si.imgix.net/124ca9f7/uploads/origins/271825fb-390b-414d-9240-dcaf8ed51e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c2c5bbe068030cba19b32a3d154edb3, https://si.imgix.net/124ca9f7/uploads/origins/271825fb-390b-414d-9240-dcaf8ed51e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd59d33a665f3f8e06021546fa78eaf5 2x, https://si.imgix.net/124ca9f7/uploads/origins/271825fb-390b-414d-9240-dcaf8ed51e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4bb01d20bf472c787f3f60fe