簡単な背景が欲しいです。\n【職業武器】天ノ宮せん（ピクトマンサー）\n　　　　　　夜夢ムース（竜騎士）\n　　　　　　山森ききょう（学者）\n　　　　　　JajaKun（ナイト）\n　　　　　　真白瑠璃（黒魔道士）\n　　　　　　荒木今泉（侍）\n　　　　　　天宮むすび（踊り子）\n【納品形式】PSDデータ（それぞれ人物だけのレイヤーを分けて頂きたいです。）\n【他】前回のようにしっぽと天ノ宮せんのレイヤーを分けて頂きたいです。\n\nお手数ですが、ご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。\n\n天ノ宮せん\n\nhttps://drive.google.com/drive/folders/1PvATTBF9Mxq6DLLoz2I8hQ1GqiQBl_ql?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@asagihisui_/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/31312a89/uploads/origins/490d6aba-02f5-44df-9e24-69c38d419f19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c3325b7d480e8d2138f7ce732846e20", "srcset": "https://si.imgix.net/31312a89/uploads/origins/490d6aba-02f5-44df-9e24-69c38d419f19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c3325b7d480e8d2138f7ce732846e20, https://si.imgix.net/31312a89/uploads/origins/490d6aba-02f5-44df-9e24-69c38d419f19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6af5b0e7f0f5f644ff8eb31594cb16c 2x, https://si.imgix.net/31312a89/uploads/origins/490d6aba-02f5-44df-9e24-69c38d419f19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e5bb99ff819f442ec22fe667888f739 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3110452, "client_id": 1875207, "nc": 0}, {"path": "/@asagihisui_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3110452, "vtt_url": null, "thumbnail_image_urls": {"src": "https://