d47a2985d5e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6949227843480ff75e68e2fba90e5f9", "srcset": "https://si.imgix.net/07f13808/uploads/origins/425b2981-ba71-498f-9d2b-d47a2985d5e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6949227843480ff75e68e2fba90e5f9, https://si.imgix.net/07f13808/uploads/origins/425b2981-ba71-498f-9d2b-d47a2985d5e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4d3824d7897ba838a3176fe64522096c 2x, https://si.imgix.net/07f13808/uploads/origins/425b2981-ba71-498f-9d2b-d47a2985d5e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f27c165058b9ae570936a1d5b22b1bda 3x"}, "body": "おおかみほし 様\n\n先ほどのポストを拝見しまして、リクエストを送らせていただきます。\nSkebを利用するのが初めてのため、何か不手際がありましたら申し訳ありません。\n\n自分の夢に度々出て来る、黒い狼を描いていただきたいです。\n\n狼はいつも必ず、上から蔓植物がたくさん垂れ下がっている温室のようなガラス張りの建物の中にいます。\n身体は黒いのですが、目と尾の先は弱く銀色に光っていて、そこだけが光源になっています。\n建物の外は霧の時のようにぼんやりしていて、太陽もあるか分からない状態です。\n\n狼には特に装飾はなく、先述した銀色の部分だけが目立っているような感じでした。\n夢を見た時によって姿勢は変わりますが、大抵の場合床に座っているか寝そべっています。\n\n大体このような感じとなります。\nお受けしていただければ嬉しいです。よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ookamihosi/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1485256, "client_id": 3818092, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0bede858/uploads/origins/66e10615-d646-4fab-a9fd-3c845c06a862?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14c34c966012a9488edcb6e6979a9271", "srcset": "https://si.imgix.net/0bede858/uploads/origins/66e10615-d646-4fab-a9fd-3c845c06a862?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14c34c966012a9488edcb6e6979a9271, https://si.imgix.net/0bede858/uploads/origins/66e10615-d646-4fab-a9fd-3c845c06a862?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f145e5e7b76a470186c7cc956127c959 2x, https://si.imgix.net/0bede858/uploads/origins/66e10615-d646-4fab-a9fd-3c845c06a862?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07d2d603ef5b514c1ff38e0440808494 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0bede858/uploads/origins/66e10615-d646-4fab-a9fd-3c845c06a862?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d2e015e0e0c54fafeaaabd25c3ff0f1", "srcset": "https://si.imgix.net/0bede858/uploads/origins/66e10615-d646-4fab-a9fd-3c845c06a862?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d2e015e0e0c54fafeaaabd25c3ff0f1, https://si.imgix.net/0bede858/uploads/origins/66e10615-d646-4fab-a9fd-3c845c06a862?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9424f7264e8c699d9faaa1a8de9d6b55 2x, https://si.imgix.net/0bede858/uploads/origins/66e10615-d646-4fab-a9fd-3c845c06a862?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a0703886ce214f24ad3bb5a4bc3dbfc7 3x"}, "body": "おおかみほし様、はじめまして。風早(＠kazehaya_enne66)と申します。\nおおかみほし様の幻想的なイラストを拝見しまして、怪しげでありながらノスタルジーを感じさせる作風に、私のXアカウントのヘッダーイラストを書いていただきたいと思いましてこの度ご依頼申し上げます。\n\n私は羊のヘッドを被り、ケモノ着ぐるみイベントなどに参加したいと考えており、その羊人を描いていただきたいと考えております。\n\nおおかみほし様の世界観で描いていただきたいと思っており、こちらからの希望を申し上げますと、羊人のキャラクター(エンネと申します。)は笑みを浮かべている表情にしていただけますと幸いです。(笑みは微笑みでも不敵な笑みでも、お任せしたいです。)\n\n当方、今回が初めてのskeb利用のため、どのようなご依頼の出し方をすれば良いのか分からず、またご無礼な文章などでご不快な思いをさせてしまっているかもしれませんが、どうかよろしくお願いします。\n\nhttps://x.com/kazehaya_enne66/status/1985269533779870099?s=46", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ookamihosi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1485256, "client_id": 2850907, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d43d78c/uploads/origins/4ad243c5-0050-42c5-a8b4-4502a17f6adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28aaf4c924902f6fee65d78422ba7479", "srcset": "https://si.imgix.net/3d43d78c/uploads/origins/4ad243c5-0050-42c5-a8b4-4502a17f6adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28aaf4c924902f6fee65d78422ba7479, https://si.imgix.net/3d43d78c/uploads/origins/4ad243c5-0050-42c5-a8b4-4502a17f6adf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c5d004ed75e6f5d8449bfec657db26a 2x, https://si.imgix.net/3d43d78c/uploads/origins/4ad243c5-0050-42c5-a8b4-4502a17f6adf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51f3933eedc94456c20b46cbe0041bde 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d43d78c/uploads/origins/4ad243c5-0050-42c5-a8b4-4502a17f6adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4784478b14cec0c95e880e05ab4c89ed", "srcset": "https://si.imgix.net/3d43d78c/uploads/origins/4ad243c5-0050-42c5-a8b4-4502a17f6adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4784478b14cec0c95e880e05ab4c89ed, https://si.imgix.net/3d43d78c/uploads/origins/4ad243c5-0050-42c5-a8b4-4502a17f6adf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0dc2ac4612e7fa8d032211230a6b54c7 2x, https://si.imgix.net/3d43d78c/uploads/origins/4ad243c5-0050-42c5-a8b4-4502a17f6adf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4337e59113feb3302a21f7d8bd78b3c7 3x"}, "body": "こんにちは！\nいつもお世話になってます。おりべと申します！\nいつも描かれている幻想的な獣もすごく魅力的ですが、人体もすっっごく好きなので…！\n私の創作キャラを描いていただきたいです！\n\n以下説明になります。\n\nシャクヤク\nフリーターを経て裏社会に転がり込んできた明るい性格の男性。\n黒のロングコートを着ていて、ふわっとしたくせっ毛をリボンでひとつに結んでいる。\n武器は銃やナイフ。\n夜に活動することが多い。\n\n高層ビルの屋上、夜空を背に笑みを浮かべている構図が良いです。\n\nあと、もし良かったらシャクヤクくんの近くに幻想的な獣を描いていただけると嬉しいです！\n龍が好きなので龍モチーフだと嬉しいです。曖昧でごめんなさい！\n大きくてもデフォルメされた小さい子でも大丈夫です。(勿論、作画コストの問題もあるのでここは全てお任せします！)\n\n長くなってしまいましたが、検討していただけますと幸いです。\nよろしくお願いします。\n\nhttps://drive.google.com/file/d/1GP0QifR5ZaXtygZfROMA-DGDbAuH8uIe/view?usp=drivesdk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ookamihosi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1485256, "client_id": 71536, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/58e097c9/uploads/origins/96fa1728-245f-4a7c-89f4-23744700edbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbeada95dce153ec2ae47d098919d12e", "srcset": "https://si.imgix.net/58e097c9/uploads/origins/96fa1728-245f-4a7c-89f4-23744700edbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbeada95dce153ec2ae47d098919d12e, https://si.imgix.net/58e097c9/uploads/origins/96fa1728-245f-4a7c-89f4-23744700edbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b962e734e8638c17a51a79a54bd4d31a 2x, https://si.imgix.net/58e097c9/uploads/origins/96fa1728-245f-4a7c-89f4-23744700edbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12e72ed6affdcab44244828335bc4fb0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/58e097c9/uploads/origins/96fa1728-245f-4a7c-89f4-23744700edbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cc4b645184c5f5337605c998bb0eab7", "srcset": "https://si.imgix.net/58e097c9/uploads/origins/96fa1728-245f-4a7c-89f4-23744700edbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cc4b645184c5f5337605c998bb0eab7, https://si.imgix.net/58e097c9/uploads/origins/96fa1728-245f-4a7c-89f4-23744700edbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2db0f93614111166457b6a660c2717de 2x, https://si.imgix.net/58e097c9/uploads/origins/96fa1728-245f-4a7c-89f4-23744700edbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ddeac4072179ed60b0b570ce798a76a5 3x"}, "body": "こんにちは、おおかみほし様、\n\nあなたのアートスタイルとスタイリッシュなマーキングに本当に感銘を受けました。なんとなく、それは「大神」の「常闇ノ皇」を思い出させてくれて、美しいです!!\n\nもしよろしければ、私のドラゴンを描いていただけませんか？あなたのスタイルで自由に描いていただき、ポーズも背景がしっかりしていれば何でも構いません。よろしくお願いします!!\n\n参考資料：\nhttps://drive.google.com/drive/folders/1gkLVRi8AsL3vgrmwEMwFGW8TkzQB-RO2?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ookamihosi/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1485256, "client_id": 1052806, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4353b2d/uploads/origins/d63842f8-2ab9-4c7b-ab3b-0d0b543170ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55a88820fad01d664a2f33b4b0745f68", "srcset": "https://si.imgix.net/b4353b2d/uploads/origins/d63842f8-2ab9-4c7b-ab3b-0d0b543170ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55a88820fad01d664a2f33b4b0745f68, https://si.imgix.net/b4353b2d/uploads/origins/d63842f8-2ab9-4c7b-ab3b-0d0b543170ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da4e780ec4801661756210371b16f44e 2x, https://si.imgix.net/b4353b2d/uploads/origins/d63842f8-2ab9-4c7b-ab3b-0d0b543170ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97d1f7658a5bd7c743f1a6c157aa836a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4353b2d/uploads/origins/d63842f8-2ab9-4c7b-ab3b-0d0b543170ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2eccad40835c32496f929e1ba3fe316", "srcset": "https://si.imgix.net/b4353b2d/uploads/origins/d63842f8-2ab9-4c7b-ab3b-0d0b543170ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2eccad40835c32496f929e1ba3fe316, https://si.imgix.net/b4353b2d/uploads/origins/d63842f8-2ab9-4c7b-ab3b-0d0b543170ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1d04934a931e20e69f2a101e6f448ac0 2x, https://si.imgix.net/b4353b2d/uploads/origins/d63842f8-2ab9-4c7b-ab3b-0d0b543170ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8149caca3b209b623c0bdecc3ddc2454 3x"}, "body": "おおかみほしさんはじめまして、伝承の動物図やスクラッチアートのようにも見え、素敵な作風ですね。\nすきまの作品テーマを拝読し、また昔読んだ絵本のような画風や世界観に惹かれ、ぜひうちのキャラクターを描いていただきたく思いました。\n\nこの子は「蝮の根性、鼬の執念」で、タマミツネやオドミドロのような「イタチや狐っぽい龍」です。\n設定画＆色案参考図（光の加減や作風もあるので色はこの通りでなくていいです。）\nhttps://twitter.com/F11_L23/status/1675517369186418689\n\n・モチーフはマムシとイタチがベース、サブモチーフに人魂（鬼火）、蛟龍、管狐、刺毒魚、ウンピョウ、蛇身の清姫など\n　テーマとしては執着とか妄執、嫉妬、恨み、妖怪などの執念深さ…というイメージの性質\n人間の弱って攻撃的になった心に寄り添い、ネガティブな感情を貪り喰らい強くなる……みたいな解釈も正しいかも。\n・マムシのような顔の模様と銭形紋、イタチを思わせるような顔、両者を合わせたような体型、玄武や東洋龍のような耳、\n　アライグマのような器用そうな手、藻に紛れるようなタテガミ、不揃いな鱗、刺毒魚ぽい棘や鰭…など\n\n・音楽でいうとVOCALOID曲のMONSTER（KIRA）イメージ\n・妖狐や虎、狼や竜のような大層なものではない、もっと卑近な泥臭い雰囲気\n　神秘的な幻獣や強そうな猛獣、小動物っぽい可愛さ…よりも、小狡いような小物っぽい感じ。\n\n・目は緑系、口の中は青っぽい\n・銭形紋様はヒョウモンダコ・オオマルモンダコやソウシハギ（魚）のように青く光るかもしれない\n（この青い部分解釈は設定画の黒いʘ部分でもグレーの丸部分でも、どちらでもorもしくは両方が青系でもいいです）\n\n・普段は薄暗い沼とか湿地に棲んでそう、もしくは飯綱や管狐のように筒状のものに身を潜めることもできる\n（but、背景は凝ったものでなくて大丈夫です）\nそれ以外はおおかみほしさんの世界観に合わせてアレンジしていただいて大丈夫です。\n\nhttps://twitter.com/F11_L23/status/1675517369186418689", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ookamihosi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1485256, "client_id": 1727031, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e7e284d6/uploads/origins/f3618621-e97f-43b1-8eda-2cd412e62a19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9901a47046f7564173d