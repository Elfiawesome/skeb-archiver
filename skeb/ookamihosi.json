n\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1AqFfGM7OazqGz6C-wOGsk4xDq8nYZxSW?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ookamihosi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1485256, "client_id": 1408730, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ac4b335/uploads/origins/ec1526a3-1a28-4866-aeb1-ba4d57a8bd4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e3399514904fb4d2da039d9a7eda373", "srcset": "https://si.imgix.net/5ac4b335/uploads/origins/ec1526a3-1a28-4866-aeb1-ba4d57a8bd4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e3399514904fb4d2da039d9a7eda373, https://si.imgix.net/5ac4b335/uploads/origins/ec1526a3-1a28-4866-aeb1-ba4d57a8bd4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2b1b5a8612258aee0a8f0012a1ab452 2x, https://si.imgix.net/5ac4b335/uploads/origins/ec1526a3-1a28-4866-aeb1-ba4d57a8bd4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5d9b8efefc1b0630df5e954385da599 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ac4b335/uploads/origins/ec1526a3-1a28-4866-aeb1-ba4d57a8bd4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28bc6fe6231923944033272a3bd9a1d0", "srcset": "https://si.imgix.net/5ac4b335/uploads/origins/ec1526a3-1a28-4866-aeb1-ba4d57a8bd4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28bc6fe6231923944033272a3bd9a1d0, https://si.imgix.net/5ac4b335/uploads/origins/ec1526a3-1a28-4866-aeb1-ba4d57a8bd4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f56f51c11211701ff5d3ff8fa5f7fafb 2x, https://si.imgix.net/5ac4b335/uploads/origins/ec1526a3-1a28-4866-aeb1-ba4d