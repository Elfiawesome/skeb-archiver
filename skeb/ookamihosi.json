を描いていただきたいです。\n\n深山　律(みやま　りつ)\n心優しいがとあるジレンマを抱えており、悩みと責任、苦労が絶えない日々。\n妻無き今は息子の存在を支えに沢山の患者の命を救っているお医者さんです。\n大柄で怪しい風貌のため、第一印象で誤解される事が多いけれど脳外科の名医です。\n\nほぼ全てきよいちさんのセンスにおまかせしますが、可能でしたらネクタイピンを資料のデザインで描いていただけると嬉しいです…！(隠れる場合は大丈夫です)\n\n宛名とサイン、背景の有無はお手数ですが差分を頂けると助かります。\nお忙しい中恐縮ですが、ご検討よろしくお願いいたします🙇\n\nhttps://drive.google.com/drive/folders/1h6oSS7qu2h0up8OMGieUXTMthlH1Jz4R?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@modaesinisou/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1181192, "client_id": 1485256, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84af0fa4/uploads/origins/27431dea-3069-4649-85a0-1c1063dfaf98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28b81e6be048baaaab8474f27a2f0ae8", "srcset": "https://si.imgix.net/84af0fa4/uploads/origins/27431dea-3069-4649-85a0-1c1063dfaf98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28b81e6be048baaaab8474f27a2f0ae8, https://si.imgix.net/84af0fa4/uploads/origins/27431dea-3069-4649-85a0-1c1063dfaf98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=272adbf8e5299fb2cde311f5f40d73c1 2x, https://si.imgix.net/84af0fa4/uploads/origins/27431dea-3069-4649-85a0-1c1063dfaf98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18305a4f40ed5de784fd1a81332b04e7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84af0fa4/uploads/origins/27431dea-3069-4649-85a0-1c1063dfaf98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1facc991d84b06cf8740fdbf238b79b7", "srcset": "https://si.imgix.net/84af0fa4/uploads/origins/27431dea-3069-4649-85a0-1c1063dfaf98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1facc991d84b06cf8740fdbf238b79b7, https://si.img