に大好きで、オリキャラのシャルエちゃんもマジで刺さってます。本当に。\n\nそんなﾗﾙﾗﾙ先生に私の推しを描いていただきたく、今回ご連絡させて頂きました。\nゲーム「艦隊これくしょん」に登場する「浜風」というキャラが私の推しなのですが、いくつか形態があるうちの「浜風乙改」を描いていただければ幸いです。\n特にポーズ指定等はありませんが、可能であれば清楚系の私服に丸眼鏡を着けた状態の浜風を描いていただけると泣いて喜びます。\n浜風はクールなタイプのキャラですので、表情等はそこも加味していただけると大変助かります。\n\n細かい指定ばかりになってしまって大変申し訳ないのですが、どうしてもﾗﾙﾗﾙ先生に描いていただきたく、リクエストを送らせて頂きました。\nどうかよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@raruuuuu534/works/21", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9f71b10e/uploads/origins/debeb55b-9324-45ce-ae3e-d772bfa04b84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=175dc36e89e92ffb6632a561c09103a5", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2987660, "client_id": 363128, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@raruuuuu534/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2987660, "client_id": 2144454, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19d0e524/uploads/origins/f25be9a6-689a-4229-abe5-f9520db9420a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5efc373ca5d0e7a67e3301ea530f3b78", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19d0e524/uploads/origins/f25be9a6-689a-4229-abe5-f9520db9420a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=784678a567b70f07a8792611323ca18e", "src_set": ""}, "body": "真に成りたいセックスを表現してください\n\nhttps://x.com/raruuuuu534/status/1888605303127880185", "nc": 32, "word_count": 0, "trans