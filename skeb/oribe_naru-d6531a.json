セササリの立ち絵イラストの表情についてですが、\n　　　①：目を開いた笑顔の表情のパターン\n　　に加え、以下のどちらかのパターンを作成いただけると幸いです。\n　　　②a：目を閉じた笑顔の表情のパターン（いわゆる「(∩∩)」のような目）\n　　　②b：ウインクをしている表情のパターン\n　〇上記が難しい場合は目を開いた笑顔の表情のパターンのみで構いません。\n\n\n以上、ご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/16ZXFmP8JaRwmPUEtkCbT24Gdo2oimMzQ?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oribe_naru/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 361001, "client_id": 2764142, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b7f608e/uploads/origins/540c46d6-ce2d-4d57-9c62-e6e34000363c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3bbed3ad7ec132078a149ea162e7f837", "srcset": "https://si.imgix.net/5b7f608e/uploads/origins/540c46d6-ce2d-4d57-9c62-e6e34000363c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3bbed3ad7ec132078a149ea162e7f837, https://si.imgix.net/5b7f608e/uploads/origins/540c46d6-ce2d-4d57-9c62-e6e34000363c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d6f95c4fd56c0e45fb15aec3d66e4d2 2x, https://si.imgix.net/5b7f608e/uploads/origins/540c46d6-ce2d-4d57-9c62-e6e34000363c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=441d372f020b8bcba42b7cc6b821684a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b7f608e/uploads/origins/540c46d6-ce2d-4d57-9c62-e6e34000363c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f18e9393e72d7b82cc2683b3d9c63f65", "srcset": "https://si.imgix.net/5b7f608e/uploads/origins/540c46d6-ce2d-4d57-9c62-e6e34000363c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f18e9393e72d7b82cc2683b3d9c63f65, https://si.imgix.net/5b7f608e/uploads/origins/540c46d6-ce2d-4d57-9c62-e6e34000363c?bg=%23fff&auto=fo