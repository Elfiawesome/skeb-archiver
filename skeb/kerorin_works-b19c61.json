れ、ほろ苦さ！です。参考リンクの衣装の中から、自由に選んでください:)\n\n可能であれば、レイヤーを分離したアートワークのpsdファイルコピーと、寸法が16:9（または1920×1080ピクセル）であることを希望します。\n\nまた、提供されたリファレンスではかなり小さいですが、キャラクターは左目の下に小さなほくろがあり、非常に太い緩い編み込みのヘアスタイルをしていることに注意してください :>。\n\n本当にありがとうございました!\n\nhttps://drive.google.com/drive/folders/1fWRqdZFkUAIFkCda_Gp2etcsWCfx6UxY?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 623294, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ｸﾛｽﾐ ∥𝗰𝗼𝗺𝗶𝘁𝗶𝗮𝟭𝟱𝟲東𝟳𝗥𝟭𝟭𝗮", "screen_name": "kuroegg", "avatar_url": "https://pbs.twimg.com/profile_images/1774828152742912000/oSq6lymr.jpg", "header_url": "https://pbs.twimg.com/profile_banners/52058894/1583865180/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 15, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 1207844, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Touva@sketch", "screen_name": "Touvasketch", "avatar_url": "https://pbs.twimg.com/profile_images/2032874653430198276/0lV0TgTf.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 35, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 1}, {"id": 1222028, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "kitaru@C108(土)東1 “シ”41a", "screen_name": "akidania", "avatar_url": "https://pbs.twimg.com/profile_images/1707942174187540480/Dr5VgEn2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3282469753/1773215865/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester