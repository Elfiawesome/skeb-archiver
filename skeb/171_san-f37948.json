isible": false, "total_appeals_count": 0, "received_works": [{"path": "/@171_san/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3327526, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9226428/uploads/origins/ae994477-7f8a-4347-bcb6-449ae536e8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ade1c9cd27019c754a4f13124eb59ab4", "srcset": "https://si.imgix.net/d9226428/uploads/origins/ae994477-7f8a-4347-bcb6-449ae536e8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ade1c9cd27019c754a4f13124eb59ab4, https://si.imgix.net/d9226428/uploads/origins/ae994477-7f8a-4347-bcb6-449ae536e8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47704feaa42345720c31037dbd09d0f0 2x, https://si.imgix.net/d9226428/uploads/origins/ae994477-7f8a-4347-bcb6-449ae536e8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0d1dcc50ad87e19ed4c6d63d8856b46 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9226428/uploads/origins/ae994477-7f8a-4347-bcb6-449ae536e8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4997d1c7d056051266e904d3d15826b7", "srcset": "https://si.imgix.net/d9226428/uploads/origins/ae994477-7f8a-4347-bcb6-449ae536e8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4997d1c7d056051266e904d3d15826b7, https://si.imgix.net/d9226428/uploads/origins/ae994477-7f8a-4347-bcb6-449ae536e8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a0ef1fd7a351b95a77084fced461ad20 2x, https://si.imgix.net/d9226428/uploads/origins/ae994477-7f8a-4347-bcb6-449ae536e8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d45bcf8127ac2370eb29840dc30b305b 3x"}, "body": "お世話になっております。以前はとても素敵なイラストを描いてくださり、ありがとうございました！今回も自分と友人のTRPGのキャラクターを描いて頂きたく、リクエストを送信させて頂きました。\n\n○キャラクター詳細\n●紫電 天鼓 （しでん てんこ）\n20歳／165cm／女性\n教育学部の大学二年生。\n自分にも他人にも厳しくストイックで礼儀正しいが、親しい人にはツンデレ。\n交友関係は非常に狭く、命花以外の友達はほとんどいない。\n頑固な部分があり自分を含む人の気持ちを汲み取るのが下手。自分の感情を伝えるのも不器用な為、衝突が起こる事もしばしば…。趣味は読書とお菓子作り。本棚には大量の教本や小説に混じりレシピ本が入っている。\n裕福な家庭出身だが厳しく育てられた訳ではなく、恵まれた環境に応える為ノブレス・オブリージュに自ら囚われている。\n\n●霧羽 命花（きりは めいか）\n20歳／157cm／女性\n保育児童学部の大学二年生。\n天鼓と同じく裕福な家庭の出身だが、天鼓とは正反対に大雑把な性格。天鼓と比べると所作に雑な面が見られるが、行き過ぎた無作法な行動はしない。昔はお淑やかな行動を心掛けていたが、中学生で反抗期に突入し一度グレる。高校生になって落ち着き、今の性格に帰着した。\n子供が好きで面倒見がよく、いわゆる姉御肌。趣味は映画鑑賞とハンドメイド。特技はピアノ演奏。\n甘いものはそれほど食べないが天鼓の作ったものは気に入っている。\n〇関係性\n幼稚園からの幼馴染で、大学生から同居している。\n幼い頃は命花が天鼓に礼儀やその他にも色々なことを教えるような関係で、純粋に仲が良かった。しかし、命花の変化によって天鼓がひとり置いて行かれた、という印象を持つようになり、愛憎を持ち合わせるようになる。命花にとって天鼓はずっと変わらず大切な存在であったが、価値観の相違が生まれてからは苛立ち口論になることもあった。\nしかしお互いに離れがたい存在であり、同居を始めてからしばらくして話し合い和解した。現在の2人の雰囲気は穏やかであり、共に生きていくことを決めている。\n\n●構図など\n2人で同じ食卓を囲んでいるなど、生活感のある構図だと嬉しいです。\n表情はお任せしますが、できれば双方柔らかめの表情で描いてもらえたらと思います。\n●使用用途\n個人観賞（友人にのみ共有）\n\nご検討の程、宜しくお願いします。\n\nhttps://drive.google.com/drive/folders/1x3LzJTZal4_FTXBH95RFe7-Z8xXmlUYo?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@171_san/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0e8f96d1/uploads/origins/2af7aac9-c2bc-41e0-b7e3-8e1f77d2797a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78632a515d2552cd85c29d0d311c998a", "srcset": "https://si.imgix.net/0e8f96d1/uploads/origins/2af7aac9-c2bc-41e0-b7e3-8e1f77d2797a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78632a515d2552cd85c29d0d311c998a, https://si.imgix.net/0e8f96d1/uploads/origins/2af7aac9-c2bc-41e0-b7e3-8e1f77d2797a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfon