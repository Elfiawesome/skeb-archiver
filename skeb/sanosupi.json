のある衣装(先生が描かれた フリーナ や シトラリ のような雰囲気を参考にしてください)\nOR\n元の衣装を使用\n肩と腕の衣装は外す（中央部分のみ残す）\nショールと袖は付けない\n特徴的なお団子のような帽子は残す\nまたは原作衣装を改造したものでも構いません\n--------------------------------\n胸のサイズは先生のお好みで増量していただいて構いません！！\n--------------------------------\nポーズ\nストレッチ運動、または伸びをしている動作\n腋がしっかり見えるようにしていただきたいです\nとにかく「腋見せ」のポーズを希望\n--------------------------------\n表情\n表情は先生にお任せします\n--------------------------------\n演出効果\n訓練後の汗を腋の下に加えて表現\n\nhttps://x.com/sasunopi/status/1971614712405324068?t=FWwDoO7Iuyqpl1luSeNhEQ&s=19\nhttps://x.com/sasunopi/status/1972653100013158518t=FWwDoO7Iuyqpl1luSeNhEQ&s=19\nhttps://x.com/sasunopi/status/1972546874508018059?t=FWwDoO7Iuyqpl1luSeNhEQ&s=19", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sanosupi/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3632635, "client_id": 566527, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/100dab33/uploads/origins/6d590732-8776-4e9f-bc29-f7899e45bfed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b99a30770ded29246e30e71a9c5ba388", "srcset": "https://si.imgix.net/100dab33/uploads/origins/6d590732-8776-4e9f-bc29-f7899e45bfed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b99a30770ded29246e30e71a9c5ba388, https://si.imgix.net/100dab33/uploads/origins/6d590732-8776-4e9f-bc29-f7899e45bfed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7989bcd184abc07093802eb9a414b82a 2x, https://si.imgix.net/100dab33/uploads/origins/6d590732-8776-4e9f-bc29-f7899e45bfed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69566c58aa25cc1321cc22a13fc3095e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/100dab33/uploads/origins/6d590732-8776-4e9f-bc29-f7899e45bfed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200