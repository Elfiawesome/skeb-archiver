157790130602?s=46&t=XarozWFLQpOT6cRmIQtU5g)\n\n\n【設定】\n紫陽花の妖怪や妖精みたいな存在で最後の時を待つ花たちがいる農園でお手伝いをしています\n本体は紫陽花の化け物みたいな見た目で分体と人の見た目と犬の形態があります\n\n見た目がおとなしめですが、元気な感じで配信を行なっていますので茶目っ気ある元気な雰囲気ですが、不穏なことを話したり、ホラーチックな様子もあります。\nまた推理や考察が好きですが、かなり逸脱したサイコな考えを出したりします(メギド配信で頭メギドラル判定されております)\n喜怒哀楽が激しく、漫画やアニメ小説・メイクやコスメがなどが好きなタイプです　\n\n【構図やポーズ希望など】\nメインとしてメギド配信時のサムネなどの活用を考えいますので、メギドっぽいシリアスな感じや絶望してる感じなどメギド公式が出しているキービジュアルなどに合わせやすい感じのシリアスや泣いているなどだと嬉しいです　\nもしくはにっこりと友人などに向けて笑っている感じのイラストでお願いします。\n\n全身や上半身・バストアップなどの指定などありませんがサムネなどに利用したいと思っていますので、できるだけ途切れがないイラストでお願いします。\n\n【活用内容】\n描いていただいたイラストは、Twitterのアイコンや活動ツイート、YouTubeのサムネイル等・非収益(ネットプリントなど)の各種活動に使用したいと考えております。\nそのため、可能でしたらキャラのみ使用できるよう透過したものやPSDファイルもいただけますと幸いです。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://mobile.twitter.com/hydrangea2015_8", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unoned/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 891863, "client_id": 736004, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7004583/uploads/origins/fe83f5b1-8eff-42d4-b94e-3b8ca746306f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8f26c9a0ae470eef2c27416fe3ecb43", "srcset": "https://si.imgix.net/b7004583/uploads/origins/fe83f5b1-8eff-42d4-b94e-3b8ca746306f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8f26c9a0ae470eef2c27416fe3ecb43, https://si.imgix.net/b7004583/uploads/origins/fe83f5b1-8eff-42d4-b94e-3b8ca746306f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f0b9143700d27baea38ce713541053a 2x, https://si.imgix.net/b7004583/uploads/origins/fe83f5b1-8eff-42d4-b94e-3b8ca746306f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d55b44049427e53dcb86b382801bc09 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7004583/uploads/origins/fe