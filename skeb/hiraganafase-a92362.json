クエストします。\n\n特にこの作品は、女の子のお尻や太ももをうまく描けていると思うので、以下のイラストのようなポーズでサタンを登場させたいです。\n*** ただし、サタンの脚は開いて縛られ、上げポーズになる。\n*** ルシファーはサタンの後ろにひざまずき、サタンの頭を支えている。\n\n両キャラクターの胸は露出させ、サタンのレオタードは横に引っ張って性器を露出させる。\n*** ルシファーはサタンの耳を優しくかじり、サタンの片方の胸を包み、サタンの膣を刺激すること。\n*** サタンは短気な性格なので、楽しんでいても多少反抗的に見えるはずだ。\n\nhttps://drive.google.com/file/d/1i99pCQ7qjzApDIfHdqbWEYEiQ7jUP5dc/view?usp=sharing", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hiraganafase/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1094009, "client_id": 260200, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2404b6de/uploads/origins/e1d5fd4d-2c36-4852-b9bf-cefbfc78dd78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcff4962ede2cf262a0cf3af001ca787", "srcset": "https://si.imgix.net/2404b6de/uploads/origins/e1d5fd4d-2c36-4852-b9bf-cefbfc78dd78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcff4962ede2cf262a0cf3af001ca787, https://si.imgix.net/2404b6de/uploads/origins/e1d5fd4d-2c36-4852-b9bf-cefbfc78dd78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9c7ce78d89dfd3dfcff5a0e7ba672fd 2x, https://si.imgix.net/2404b6de/uploads/origins/e1d5fd4d-2c36-4852-b9bf-cefbfc78dd78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbe41e7f57deb2a563d7a0f980b465a2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2404b6de/uploads/origins/e1d5fd4d-2c36-4852-b9bf-cefbfc78dd78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d17a2b558ec92b0795adc2af2f89eab2", "srcset": "https://si.imgix.net/2404b6de/uploads/origins/e1d5fd4d-2c36-4852-b9bf-cefbfc78dd78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d17a2b558ec92b0795adc2af2f89eab2, https://si.imgix.net/2404b6de/u