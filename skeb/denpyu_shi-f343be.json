ea7/uploads/origins/462d7ed7-9641-4e2b-8905-31b80bed9603?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4c244c480d30c282ec27ddc437c95a3, https://si.imgix.net/af137ea7/uploads/origins/462d7ed7-9641-4e2b-8905-31b80bed9603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=756c2a965add4b91f0c0efd06b4c0f7d 2x, https://si.imgix.net/af137ea7/uploads/origins/462d7ed7-9641-4e2b-8905-31b80bed9603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=33dac9962610116dea2e81547d74fee0 3x"}, "body": "先生、こんにちは！\n先生の鎧のイラスト、本当にカッコいいです！質感もすごく際立っていますね！お聞きしてもよろしいでしょうか？私のオリジナルキャラクター（OC）を描いていただけないでしょうか。\n設定は、白髪で赤い目をした、西洋風ファンタジーのドラゴンナイトです。どんなシーンでも、お好きなように描いてください！よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1UgrPTiaMpLsOEPU6AORB5SU6Wt6jKMQp", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@denpyu_shi/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3600464, "client_id": 3668330, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e11d4f5e/uploads/origins/c9c71389-712b-4cea-a48d-ff0967769bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97402593e04aed85d78bf487a7b31ead", "srcset": "https://si.imgix.net/e11d4f5e/uploads/origins/c9c71389-712b-4cea-a48d-ff0967769bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97402593e04aed85d78bf487a7b31ead, https://si.imgix.net/e11d4f5e/uploads/origins/c9c71389-712b-4cea-a48d-ff0967769bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cba5990f8445ba7fd497fb7067baa18d 2x, https://si.imgix.net/e11d4f5e/uploads/origins/c9c71389-712b-4cea-a48d-ff0967769bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa918dd5a38d624787862aeaeefba67b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e11d4f5e/uploads/origins/c9c71389-712b-4cea-a48d-ff0967769bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6485546929e00124a4e8a5ee48ac1631", "srcset": "https://si.imgix.net/e11d4f5e/uploads/origins/c9c71389-712b-4cea-a48d-ff0967769bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6485546929e00124a4e8a5ee48ac1631, https://si.imgix.net/e11d4f5e/uploads/origins/c9c71389-712b-4cea-a48d-ff0967769bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2997a83da51e7082540826460c1625eb 2x, https://si.imgix.net/e11d4f5e/uploads/origins/c9c71389-712b-4cea-a48d-ff0967769bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9b14d192c9316198b07f664fbc4b18f7 3x"}, "body": "こんにちは。ちょっと変わったお願いがあるのですが、ケモノキャラのイラストを描いていただけませんか？ 私のオリジナルキャラクターであるアメジストさんです。\n\nあなたのイラストは本当に美しく、ユニークだと思います。もしアメジストさんを題材に、新しい試みをしてくださるなら、大変ありがたく思います。 名前が宝石に由来しているので、あなたの才能で何か特別なものを生み出していただけるのではないかと感じました。クリスタルをモチーフにしたイメージや衣装のデザインは、きっとすごくクールになると思います！  \n\nアメジストさんを、あなたが感じたままに自由に描いていただいて構いません。 背景、行動、ポーズなど、何でも構いません。衣装も、お好きなスタイルでデザインしてください。どんな形でも、ぜひ自由に試してみてください！  \n\n注：内耳の毛は紫色です。うっかり白にしてしまう方がいらっしゃるので。  \n\nお時間を割いてご検討いただき、ありがとうございます。 もしこのリクエストを受け入れてくださるなら、皆さんがどんな作品を描いてくれるのか、心から楽しみにしています。どんな結果になっても嬉しく思います。^^\n\nhttps://drive.google.com/drive/folders/13DlT8FMbf9FT_YGderyM3FMoGYCXemtR?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@denpyu_shi/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3600464, "client_id": 3323256, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbd8ab66/uploads/origins/f18a047c-c3ee-41ca-a238-bc3c48c2ccf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d9bc0f6eedc5e46be62fe0647e940e5", "srcset": "https://si.imgix.net/cbd8ab66/uploads/origins/f18a047c-c3ee-41ca-a238-bc3c48c2ccf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d9bc0f6eedc5e46be62fe0647e940e5, https://si.imgix.net/cbd8ab66/uploads/origins/f18a047c-c3ee-41ca-a238-bc3c48c2ccf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eeab96876813185b55aeba18d2709602 2x, https://si.imgix.net/cbd8ab66/uploads/origins/f18a047c-c3ee-41ca-a238-bc3c48c2ccf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e3619ee2f511d89d3eb80ae40f952df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbd8ab66/uploads/origins/f18a047c-c3ee-41ca-a238-bc3c48c2ccf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c936b046aecf89989e000d7ab8650330", "srcset": "https://si.imgix.net/cbd8ab66/uploads/origins/f18a047c-c3ee-41ca-a238-bc3c48c2ccf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c936b046aecf89989e000d7ab8650330, https://si.imgix.net/cbd8ab66/uploads/origins/f18a047c-c3ee-41ca-a238-bc3c48c2ccf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1fe1941eab35394408ac3cee6f7d9749 2x, https://si.imgix.net/cbd8ab66/uploads/origins/f18a047c-c3ee-41ca-a238-bc3c48c2ccf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f53eb0f2529e7506865b3ac3351858a8 3x"}, "body": "先生、はじめまして。先生のイラストがとても大好きです！\nTRPGのOCイラストをご依頼したいです。\n\n時代：1920年代\n場所：全員がカトリックを信仰する孤立した島\n社会：領主制が残る伝統的な島。貧富の差が大きく、スラム街と普通の街に分かれる。宗教勢力と貴族は密かに対立。最下層の民衆は苦しい生活を強いられている。\n\n[A]\n黒髪・赤目・女性（口角の下にほくろ／前髪の中央部が長め）\n体型：身長168cm、細身、胸は小さい\n経歴：スラムで孤児に。神父に引き取られ神学校へ\n性格：外見は品が良く信仰深い優等生風だが、実際は腹黒く、論理的な詰問を得意とする。仲間を何より大切にする頑固で意志の強い性格。\n\n衣装やポーズ、構図などは自由に調整してください。お好きなスタイルで自由に描いていただいて構いません。服装や髪型の変更、簡略化もOKです。\n個人利用です。\n料金や依頼内容に問題があれば、キャンセルして再送してください。\n文法や表現で不自然な部分がありましたらどうかご容赦ください。読んでいただきありがとうございます！\n\nhttps://drive.goog