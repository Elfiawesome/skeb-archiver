b94-bc58-4eda-848f-ea14cf9d0a55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbf67a2b36ac27899c2fb36674248e7b", "srcset": "https://si.imgix.net/27cd2f2c/uploads/origins/eef82b94-bc58-4eda-848f-ea14cf9d0a55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbf67a2b36ac27899c2fb36674248e7b, https://si.imgix.net/27cd2f2c/uploads/origins/eef82b94-bc58-4eda-848f-ea14cf9d0a55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60048c4dd9c8b902d0217c67ad52ee48 2x, https://si.imgix.net/27cd2f2c/uploads/origins/eef82b94-bc58-4eda-848f-ea14cf9d0a55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=39d6e810a55997bf8b37f3ece70f6016 3x"}, "body": "こんにちは！ 最新のページを見ていたところ、あなたの素晴らしい作品に出会いました。特にこちらの依頼作品（https://skeb.jp/@denpyu_shi/works/4）の雰囲気がとても気に入りました。私のキャラクターでも、同じような感じのイラストを描いていただけませんか？ https://toyhou.se/39102755.seralune#119234366 手前に青とオレンジの蝶が舞うような構図で、背景はモノトーン調にして、彼女の青とオレンジのデザイン要素が際立つようにしていただけると嬉しいです。衣装の解釈や価格については、ご自由に調整していただければと思います。ご検討いただき、本当にありがとうございます！♥", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@denpyu_shi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3600464, "client_id": 2103927, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c3c367e/uploads/origins/1a4f1589-10bf-44fa-a653-d16a444c3b83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e87e611b1669aac48c9bd541e717451", "srcset": "https://si.imgix.net/7c3c367e/uploads/origins/1a4f1589-10bf-44fa-a653-d16a444c3b83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e87e611b1669aac48c9bd541e717451, https://si.imgix.net/7c3c367e/uploads/origins/1a4f1589-10bf-44fa-a653-d16a444c3b83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa28f0b8d76a09bb6bd6be046cf7a22d 2x, https://si.imgix.net/7c3c367e/uploads/origins/1a4f1589-10bf-44fa-a653-d16a444c3b83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8a37afcaf32c45a32946c931441f75d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c3c367e/uploads/origins/1a4f1589-10bf-44fa-a653-d16a444c3b83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9c3dcad5cae3265720918d76a4f2969", "srcset": "https://si.imgix.net/7c3c367e/uploads/origins/1a4f1589-10bf-44fa-a653-d16a444c3b83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9c3dcad5cae3265720918d76a4f2969, https://si.imgix.net/7c3c367e/uploads/origins/1a4f1589-10bf-44fa-a653-d16a444c3b83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ddd18294d73f5673e871904826852ec3 2x, https://si.imgix.net/7c3c367e/uploads/origins/1a4f1589-10bf-44fa-a653-d16a444c3b83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=18f859767cdfbe1454d40bb1eb60baf4 3x"}, "body": "no_wareさん、こんにちは。\n\n「Il Dottore」のイラストが目に留まりました。細部へのこだわりと色彩の使い方に、本当に感銘を受けました。私のオリジナルキャラクター（OC）のイラストを依頼させていただきたいのですが。\n\n彼女は、神道の要素が織り交ぜられたサイバーパンクの世界で活躍する探偵です。人間ですが、両手にロボットの義手を装着しており、捜査の際にはロボットの眼帯を使用しています。\n\n描いていただきたいメインの衣装の参考画像を添付しました。ロボットの義手は少なくとも片方を入れてください。衣装や義手のデザインは、ご自由にアレンジしていただいて構いません。あなたの細部へのこだわりが大好きなので、私のキャラクターをどのように解釈し、描いてくださるのかとても楽しみにしています。\n\n構図やポーズはご自由に決めてください。鯉や日本庭園は私のキャラクターにとって重要なモチーフですので、イラストに取り入れていただけると嬉しいです。ただし、ご希望であれば、ご自身のアイデアを加えていただいても構いません。\n\nお読みいただき、ありがとうございます。\n\nhttps://drive.google.com/drive/folders/1lHDy3YSJmvoRTaoBqaEkAo9kE5QR25F4?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@denpyu_shi/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/433c707d/uploads/origins/6cd1b1ee-ae37-47fb-a97b-4fed569428d8?bg=%23fff&auto=format%2Ccompress&fm=we