gins/460cd56b-e3ec-4fcd-9c00-f1db1e42102a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3eaede6796e9f52933d10528efebd14, https://si.imgix.net/0d33237d/uploads/origins/460cd56b-e3ec-4fcd-9c00-f1db1e42102a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be7963691eac75647ccaae3048b7c7b9 2x, https://si.imgix.net/0d33237d/uploads/origins/460cd56b-e3ec-4fcd-9c00-f1db1e42102a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=791b6d3f1f043d68b6b21080a2a8e9ec 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d33237d/uploads/origins/460cd56b-e3ec-4fcd-9c00-f1db1e42102a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fff1022771702718ae8f97c56bd50e5", "srcset": "https://si.imgix.net/0d33237d/uploads/origins/460cd56b-e3ec-4fcd-9c00-f1db1e42102a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fff1022771702718ae8f97c56bd50e5, https://si.imgix.net/0d33237d/uploads/origins/460cd56b-e3ec-4fcd-9c00-f1db1e42102a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d8dbff463fdc58dde927d899be9878f2 2x, https://si.imgix.net/0d33237d/uploads/origins/460cd56b-e3ec-4fcd-9c00-f1db1e42102a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3edb910f1ba4a14d3aa9fcf529dcc7f 3x"}, "body": "こんにちは！あなたの精緻なイラストが大好きです！どうか私のキャラクターを大切にお願いします！こちらは私のサイバーパンクオリジナルキャラクターで、名前は「ラム」。アラサカ社のネットランナーです。普段は極めて中立的で無表情――時に感情がないように映ることもあります。彼の身体は美しい磁器の人形のように作られており、その性格もまた、従順な操り人形のように見えることを反映しています。\n\nこのイラストの構図については具体的なイメージはありません。ただ、彼の美しい顔立ちと磁器のような身体、そして無表情な態度を捉えてほしいという思いだけです。彼は身体の自律性を一切持たないため、可能であればその表情も表現していただけると嬉しいです。本当にありがとうございます！あなたの作品は完璧です！\n\nhttps://drive.google.com/drive/folders/17V0ibeG4-oVQLxJvCFWYjXFMCa9k5cdg?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@denpyu_shi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3600464, "client_id": 3404955, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ece8979f/uploads/origins/ff369925-ade7-491e-b9a3-d8ba2d30549c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a1d49cf55a511a92fd6d77cb615de43", "srcset": "https://si.imgix.net/ece8979f/uploads/origins/ff369925-ade7-491e-b9a3-d8ba2d30549c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a1d49cf55a511a92fd6d77cb615de43, https://si.imgix.net/ece8979f/uploads/origins/ff369925-ade7-491e-b9a3-d8ba2d30549c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ce6c89e0fb487fa25c1ed3881fdd89c 2x, https://si.imgix.net/ece8979f/uploads/origins/ff369925-ade7-491e-b9a3-d8ba2d30549c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dad62f27a7132ade123c17c39df31391 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ece8979f/uploads/origins/ff369925-ade7-491e-b9a3-d8ba2d30549c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bc0fb0cfb6976c8a1264dce88118480", "srcset": "https://si.imgix.net/ece8979f/uploads/origins/ff369925-ade7-491e-b9a3-d8ba2d30549c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bc0fb0cfb6976c8a1264dce88118480, https://si.imgix.net/ece8979f/uploads/origins/ff369925-ade7-491e-b9a3-d8ba2d30549c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fb6c73c394b1158ac06afc8099f05872 2x, https://si.imgix.net/ece8979f/uploads/origins/ff369925-ade7-491e-b9a3-d8ba2d30549c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=742ceab8904d76f205f17af754bbaff1 3x"}, "body": "イリポコ様\nはじめまして、こんばんは。いつも素敵なイラストを拝見しております。この度イリポコ様に私のOCを描いて頂きたくリクエストさせて頂きました。\n\nhttps://drive.google.com/drive/folders/1EZN27YnGxs9QPHKPaYW904KocU7WINKm\n\n【詳細】\nセラフィーヌ・ウィドウレース\n185cm 231歳の魔女\n\n《容姿情報》\n・セクシーで魔性的、妖艶だけど品がある美しい容姿（見た目の雰囲気や美しさはdita von teeseを見るとイメージしやすいと思います。）\n・ハイライトの無い黒目、メイクはカットクリース\n・口元にほくろがあり、リップの色は紫色\n・片目に蜘蛛の巣型のアイパッチのようなもの\n\n《キャラクター情報》\n大人で余裕ある印象、常に落ち着いていて優雅でセクシー。人間とも親しみやすく関わることが出来るが、彼女は人喰い魔女なので人間のことは捕食対象としか見ていない。常に気品を保っているため、感情的に表情が崩れることは無い。\n元々は人間だったが、以前からその美貌を持っていた為に本人の意図してない場合でも多くの男性たちを虜にしてしまった。それにより｢悪魔と契約し魔術を使用し男を取り込む魔女｣だという冤罪から魔女狩りによって火あぶりの刑を受けてしまう。彼女の目元のアイシャドウが流れ落ちたような跡は、その際に泣いた痕跡です。\n本物の魔女になってからはその美貌を使い、人間を捕食しています。\n\n《使用用途》\nアイコン、ヘッダー、壁紙使用、資料使用及び｢印刷してお届け｣機能を使用する場合がございます。完全個人鑑賞目的であり、自室に飾り楽しみたいと考えています。その為宛名有りと無しの差分両方をPNGまたはJPEGで納品していただきたいです。\n\n☆構図など希望はございません！自由に制作してください。\n\nイリポコ様の写実的で美しい作品の数々にいつも心奪われております。私はリアルな絵柄を最も好んでおり、私では表現しきれない美しさや写実的な作画、イリポコ様の細かい描写表現でOCを是非とも描いて頂けないかと考えておりました。\n\n長くなりましたがご検討いただけますと幸いです。\nよろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@denpyu_shi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3600464, "client_id": 2844109, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9163ce40/uploads/origins/f9587abf-79b6-45c7-8451-6df738a487c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1be3f2dcd8766b7cd29c699c8b535e3", "srcset": "https://si.imgix.net/9163ce40/uploads/origins/f9587abf-79b6-45c7-8451-6df738a487c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1be3f2dcd8766b7cd29c699c8b535e3, https://si.imgix.net/9163ce40/uploads/origins/f9587abf-79b6-45c7-8451-6df738a487c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a47f6ca83d339a012fa39b54fee48fa 2x, https://si.imgix.net/9163ce40/uploads/origins/f9587abf-79b6-45c7-8451-6df738a487c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47a8614e6cbeb22617ca3377e1a6ac94 3x