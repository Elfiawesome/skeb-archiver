d&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b17c0ed3d751b7a7209aa7b83366dee6", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 193284, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@arrow__su/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 193284, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23741bac/uploads/origins/81b7fe4c-80ff-417e-abe7-d97e513d1ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fd77cc5fc93ca45e3fad24967f62279", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23741bac/uploads/origins/81b7fe4c-80ff-417e-abe7-d97e513d1ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34b3684d5bb56a34abdb1ad2ca1ae7fb", "src_set": ""}, "body": "以前沙理奈さんのリクエストをお送りさせていただいたものです。\nその節はお応えくださりありがとうございました！\n今回は沙理奈さんの一枚絵イラスト+複数差分をリクエストさせていただければと思います。\n\n衣装:こちらのリンクに近いデザインの黒ビキニ+黒ハイヒール\nhttps://imgur.com/1zTKVM7\n\nポーズ・構図:こちらの方のイラストのような態勢でお尻を強調し、アナルが見えた状態(パンティは左足に脱いである状態で)\nhttps://twitter.com/water_noodle/status/1621329076001837056\n\n背景:ジャングル(背景なしでも可)\n\nシチュエーション:ジャングルでの撮影のお仕事の休憩中に周りにトイレがなくてやむを得ず野糞で極太うんちを排泄するといった感じです。\n\n差分:以下可能な範囲で描いていただければと思います。\n優先度高め:パンティを履いた状態の差分とおならする差分\n優先度低め:蚊にアナルのシワを刺される差分とうんちを出した後の差分\n\nお忙しいところ恐縮ですが、ご検討のほどよろしくお願いいたします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arrow__su/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a777e23e/uploads/origins/b9d4266d-1dd0-4ca5-a2f9-0651afcefa63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18da1c132365070fe732f3b19548100a", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 193284, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@arrow__su/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 193284, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f5807ca5/uploads/origins/6259ce91-6269-4bb4-a79f-5769b184f5f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b43043606debc0caa5c29a4cce1f68c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5807ca5/uploads/origins/6259ce91-6269-4bb4-a79f-5769b184f5f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5858c8274839ae1cc450c7bdaf22bae1", "src_set": ""}, "body": "いつも素晴らしいイラストを拝見させていただいております。\n僭越ながらこの度リクエストさせていただく思いますので、ご検討のほどよろしくお願いいたします。\n\n【キャラ】\nデレマスの松本沙理奈さん\n\n【衣装】\n下記リンクのトップイラストのような金色ビキニ+金色ハイヒール\nhttps://dic.pixiv.net/a/%E9%87%91%E8%89%B2%E3%83%93%E3%82%AD%E3%83%8B\n\n【シチュエーション】\n①ビーチでのグラビア撮影中におならが出るほどにお腹を下して、休憩時間にボロめなボットン便所に駆け込む。\n②なんとか間に合って便器にしゃがみ込み、おならを出しながらうんちを出そうとしたら便器内に潜んでいた何者かにお尻をギュッと握られる。\n③更にアナルを舐められながらお腹に溜まってた大量のうんちをアナルローズ(脱肛)が咲くくらい便器に溜まるまで排泄する。\n④最後はアナルローズからおならを出しながら体をピクピクとさせながら悶絶する。\n\n以上が概ねの内容になります。\n\n少し理解に苦しむリクエストかと思いますが、是非ご確認頂けますと幸いです。\n\n何卒、よろしくお願いいたいします。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 3738, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ダンナ　Skebやっています", "screen_name": "karatekikku", "avatar_url": "https://pb