tofu_tea/status/1935264165024944499\nLunaberylはもっと得意げな表情にしてもいいし、恥ずかしそうな表情にしてもいいです。\n※必須ではありませんが、クリエイティブな作品を見たいです！\n\nGoogleリンク／オリジナルキャラクターの参考画像：\nhttps://drive.google.com/drive/folders/1Qd5kNsuKPt2GWHE13cX1Izg80ILsxmA6\n\nテーマが難しすぎる場合は、簡単だと感じるものに変更しても構いません。\nもふられねっこ様にお任せします。\n\n使用目的：\n個人利用。\nSNSでの共有はOKです。\n\n今後の依頼の参考にさせていただく場合があります。\n\nよろしくお願いします！🙏", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mohu_4783/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3720286, "client_id": 1102914, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5418191f/uploads/origins/83a401ad-7c5c-471a-9cd2-203e851cf64d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25af4a6b8ccad1e03c3b9d0f3ce65925", "srcset": "https://si.imgix.net/5418191f/uploads/origins/83a401ad-7c5c-471a-9cd2-203e851cf64d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25af4a6b8ccad1e03c3b9d0f3ce65925, https://si.imgix.net/5418191f/uploads/origins/83a401ad-7c5c-471a-9cd2-203e851cf64d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0398b7f214e7f0b19688d855a74c9759 2x, https://si.imgix.net/5418191f/uploads/origins/83a401ad-7c5c-471a-9cd2-203e851cf64d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09980cd386778e8ad278ba2e6c4d7bba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5418191f/uploads/origins/83a401ad-7c5c-471a-9cd2-203e851cf64d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d26f9f355dc7eacdb80109704091cfeb", "srcset": "https://si.imgix.net/5418191f/uploads/origins/83a401ad-7c5c-471a-9cd2-203e851cf64d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d26f9f355dc7eacdb80109704091cfeb, https://si.imgix.net/5418191f/uploads/origins/8