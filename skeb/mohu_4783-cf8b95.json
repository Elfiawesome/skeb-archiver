、画面全体からキャラクターの魅力がたくさん伝わってくるところに惹かれています✨\n律ちゃんをどのように描いていただけるのか、とても楽しみにしています！\n\nもし金額や資料等に不足・不備がございましたら、お手数ですが再送申請を行っていただけますと幸いです。\n\nもしご縁がありましたら、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/12NrswPyOPdVB-eE1dqylLJAHXWWWSB1K?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ayoyoyoyo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3883260, "client_id": 3720286, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f18e9328/uploads/origins/a8e3b498-7c95-4a54-96de-ef3b4504816e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=549a58c0b4a62a1f19eda5bd31d83e47", "srcset": "https://si.imgix.net/f18e9328/uploads/origins/a8e3b498-7c95-4a54-96de-ef3b4504816e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=549a58c0b4a62a1f19eda5bd31d83e47, https://si.imgix.net/f18e9328/uploads/origins/a8e3b498-7c95-4a54-96de-ef3b4504816e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28af1e2d7536febbc9f1f0ad99bab3a9 2x, https://si.imgix.net/f18e9328/uploads/origins/a8e3b498-7c95-4a54-96de-ef3b4504816e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1dd49f6f73bd310f395f9774427ddaac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f18e9328/uploads/origins/a8e3b498-7c95-4a54-96de-ef3b4504816e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42a127b4e6ae234e07082a39f6a8fb43", "srcset": "https://si.imgix.net/f18e9328/uploads/origins/a8e3b498-7c95-4a54-96de-ef3b4504816e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42a127b4e6ae234e07082a39f6a8fb43, https://si.imgix.net/f18e9328/uploads/origins/a8e3b498-7c95-4a54-96de-ef3b4504816e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top