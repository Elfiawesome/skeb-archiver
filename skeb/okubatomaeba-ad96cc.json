n🩵:\n前髪横毛は長めの姫カット\n後ろ髪は巻き髪、太ももあたりまでの長さ\n人耳なし\n胸は🩷より大きめの設定\n\n【構図】\nポンピドゥーさんの実力を超信頼しているので、全ておまかせします！\n可愛ければOKです💘\nふたりの絡みの有無も問いません✊\n(別々で描いても、ふたり一緒に描いてもOKです！)\nポンピドゥーさんの思うふたりをお願いいたします♡♡\n\n\n【その他】\n可能であれば、線画のみのデータ、ラフ、没ラフ、各イラストの背景透過のデータを頂きたいです🙏🏻\n印刷時に耐えさせるために、画像サイズは大きめだと助かります。\n\nぜひご縁があればと思います🍀\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/171rec9znbAYUUCEkSXWQWAGiCZXCOBMM", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@okubatomaeba/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3593802, "client_id": 2604953, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be4c73af/uploads/origins/6948d86c-0cba-4de7-8aa2-d36c0cd6f052?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88bfbf70af4661081f39420ab9469261", "srcset": "https://si.imgix.net/be4c73af/uploads/origins/6948d86c-0cba-4de7-8aa2-d36c0cd6f052?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88bfbf70af4661081f39420ab9469261, https://si.imgix.net/be4c73af/uploads/origins/6948d86c-0cba-4de7-8aa2-d36c0cd6f052?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2715781c7b46624e4ac25d9f34b9fa1f 2x, https://si.imgix.net/be4c73af/uploads/origins/6948d86c-0cba-4de7-8aa2-d36c0cd6f052?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74484327d4e02c425ce7ceabd37214c9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be4c73af/uploads/origins/6948d86c-0cba-4de7-8aa2-d36c0cd6f052?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65ca96d9ee979df9fdc4af205c1ba7b5", "srcset": "https://si.imgix.net/be4c73af/uploads/origins/6948d86c-0cba-4de7-8aa2-d36c0cd6f052?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65ca96d9ee979df9fdc4af205c1ba7b5, https://