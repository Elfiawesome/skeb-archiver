ipped": true, "creator_id": 3665839, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1bd66ce5/uploads/origins/7b8f1e2b-ec0e-4341-8b05-621e51f858b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39f4eae6006e678588323113a1bf7218", "srcset": "https://si.imgix.net/1bd66ce5/uploads/origins/7b8f1e2b-ec0e-4341-8b05-621e51f858b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39f4eae6006e678588323113a1bf7218, https://si.imgix.net/1bd66ce5/uploads/origins/7b8f1e2b-ec0e-4341-8b05-621e51f858b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c52c4858bfc920801a60158754ef6d6 2x, https://si.imgix.net/1bd66ce5/uploads/origins/7b8f1e2b-ec0e-4341-8b05-621e51f858b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9cdab5e7f36fa3003d8939f94c2759b0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1bd66ce5/uploads/origins/7b8f1e2b-ec0e-4341-8b05-621e51f858b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9427c8fd2f0baa5d7bcb894d18d4790e", "srcset": "https://si.imgix.net/1bd66ce5/uploads/origins/7b8f1e2b-ec0e-4341-8b05-621e51f858b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9427c8fd2f0baa5d7bcb894d18d4790e, https://si.imgix.net/1bd66ce5/uploads/origins/7b8f1e2b-ec0e-4341-8b05-621e51f858b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f1ba8003fc9334247b2e38b18005218 2x, https://si.imgix.net/1bd66ce5/uploads/origins/7b8f1e2b-ec0e-4341-8b05-621e51f858b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ef868c93809d2a487cde0d849c32a8f2 3x"}, "body": "先日、リクエストさせていただきました、れいと申します。\n先ほど、Xでの追記事項を拝見いたしました。\n\nご案内にありました通り、楽曲に直接関連する二次創作はお引き受けが難しいとのこと、承知いたしました。\n私のリクエストも、意図せずその範囲に含まれていた可能性があると感じ、改めてご連絡させていただきました。\n\nこれまでSNSで「歌ってみた」の投稿経験はありませんが、以前からずっと挑戦したいという思いがあり、今回を機に一歩踏み出すことを決めました。その動画に添えるイラストとしてぜひM.Bさんの描く世界をお借りできたらと思っております。\n\nもし可能でしたら、「空想列車のような雰囲気」や「空想列車を彷彿とさせる色味・空気感」といった形で、M.Bさんの解釈によるオリジナルイラストとしてご対応いただくことは可能でしょうか。\n\nお忙しい中恐縮ですが、何卒よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yo_draw/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3665839, "client_id": 3082742, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d911d5b/uploads/origins/49aedcc9-c4ae-439d-8690-5d505b173362?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cd384859d3fe65929b083f505820baa", "srcset": "https://si.imgix.net/3d911d5b/uploads/origins/49aedcc9-c4ae-439d-8690-5d505b173362?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cd384859d3fe65929b083f505820baa, https://si.imgix.net/3d911d5b/uploads/origins/49aedcc9-c4ae-439d-8690-5d505b173362?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8007ea693939342632279d39f565b5f6 2x, https://si.imgix.net/3d911d5b/uploads/origins/49aedcc9-c4ae-439d-8690-5d505b173362?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e12f41e0e9d3dde7a8d27c0c9433535d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d911d5b/uploads/origins/49aedcc9-c4ae-439d-8690-5d505b173362?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11ada2d8b16c2a411a24f9571f6baa18", "srcset": "https://si.imgix.net/3d911d5b/uploads/origins/49aedcc9-c4ae-439d-8690-5d505b173362?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11ada2d8b16c2a411a24f9571f6baa18, https://si.imgix.net/3d911d5b/uploads/origins/49aedcc9-c4ae-439d-8690-5d505b173362?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7d60b122b8cbea0fa0ee