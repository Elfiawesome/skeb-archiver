らない性質があります。大きさは人の頭ほどの大きさがあります。オカルト雑貨屋のアグリさんから仕入れました。）\n　・資料に詳細情報の記載がありますが、いいように解釈して頂いて問題ありません。\n　・作品内に私のHNを記載いただけるとありがたいです。\n　・おまけOKです。描くも描かないも、煮るも焼くもお好きになさってくだされば。\n\n　以上になります。よろしくおねがいします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yumurama/works/30", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 16744, "client_id": 32106, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3252ca32/uploads/origins/bf003620-14c5-4dc0-b290-40e609c39d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09179c50107a27addd7c1b1985bfcd03", "srcset": "https://si.imgix.net/3252ca32/uploads/origins/bf003620-14c5-4dc0-b290-40e609c39d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09179c50107a27addd7c1b1985bfcd03, https://si.imgix.net/3252ca32/uploads/origins/bf003620-14c5-4dc0-b290-40e609c39d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d58ea84ed6bde1d60f75bd6bca74c956 2x, https://si.imgix.net/3252ca32/uploads/origins/bf003620-14c5-4dc0-b290-40e609c39d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d131390a2b090b8ae181d1e9a9add663 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3252ca32/uploads/origins/bf003620-14c5-4dc0-b290-40e609c39d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc2c17298cf1f6e964749f57fe2286bd", "srcset": "https://si.imgix.net/3252ca32/uploads/origins/bf003620-14c5-4dc0-b290-40e609c39d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc2c17298cf1f6e964749f57fe2286bd, https://si.imgix.net/3252ca32/uploads/origins/bf003620-14c5-4dc0-b290-40e609c39d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f977fcc0d2b2dcaef634367bac157f9 2x, ht