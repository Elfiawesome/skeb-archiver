ば胸出し差分もお願いします。\n・背景・小道具の有無はお任せいたします。\n・全身が写っておっぱいが見えているのであれば、構図、ポーズはおまかせいたします。\n・一人でコスプレをしてニヤける趣味を持っている子なので、できればふやけてニヤついている感じの感情が見える表情が良いです。\n・資料に体型体色体格等の記載がありますが、必ずしも設定を細かく反映させる必要はございません。ももやまかねちちさんのいいように解釈して描いてください。\n・作品内に私のHNを記載いただけるとありがたいです（メビウスノカケラ）。\n\nメビウスノカケラと申します。\nももやまかねちちさんの絵でうちの子がどう描かれるのか見たいと思ったのでリクエストさせていただきます。\n\nhttps://drive.google.com/drive/folders/1aDKiaBTouuwZhMFmZu5zcrjkj4siJFFU?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hayato_il/works/113", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 472572, "client_id": 32106, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03cbbe7f/uploads/origins/7565c354-efe8-4341-9e64-7eea582f3173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70be6905f301e24c7cb0fa02ce1ebd7c", "srcset": "https://si.imgix.net/03cbbe7f/uploads/origins/7565c354-efe8-4341-9e64-7eea582f3173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70be6905f301e24c7cb0fa02ce1ebd7c, https://si.imgix.net/03cbbe7f/uploads/origins/7565c354-efe8-4341-9e64-7eea582f3173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8298d999030d31dfc181d8301300ec7a 2x, https://si.imgix.net/03cbbe7f/uploads/origins/7565c354-efe8-4341-9e64-7eea582f3173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec58d2afa5c662a98c364687704af26d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03cbbe7f/uploads/origins/7565c354-efe8-4341-9e64-7eea582f3173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19d1b01e7a8f35880a514dd9f31d0fb2", "srcset": "https://si.imgix.net/03cbbe7f/uploads/origins/7565c354-efe8-4341-9e64-7eea582f3173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19d1b01e7a8f35880a5