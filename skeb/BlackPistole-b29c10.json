dcd2239f0da8ef9c7eeb7d 2x, https://si.imgix.net/713759ba/uploads/origins/f315ac65-955a-468b-9d70-fdf6862eac16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6604273d916c1bcbc5475d529a91b2ea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/713759ba/uploads/origins/f315ac65-955a-468b-9d70-fdf6862eac16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3792c0df5faefada79f7c2ce27f5a38", "srcset": "https://si.imgix.net/713759ba/uploads/origins/f315ac65-955a-468b-9d70-fdf6862eac16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3792c0df5faefada79f7c2ce27f5a38, https://si.imgix.net/713759ba/uploads/origins/f315ac65-955a-468b-9d70-fdf6862eac16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0a656ddb3fbbaba32011332e955541e 2x, https://si.imgix.net/713759ba/uploads/origins/f315ac65-955a-468b-9d70-fdf6862eac16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8b0fd7a7c50cd09cd3d5ef30f9ee2b37 3x"}, "body": "はじめまして。Skebの新着にて素敵な作品をお見掛けし、是非あなた様のイラストで自身とフォロワーのTRPGキャラクター(以降は探索者と呼称)を見てみたいと思いこの度依頼させていただきました。フォロワーからは許可をいただいております。\n\n以下は世界観、及びキャラクター設定となります。\n\n◆世界観、あるいは舞台（クトゥルフ神話TRPG非公式シナリオ『禍福街』より一部引用）\n『禍福街』──法律の緩い地域で警察が巡回しても汚職まみれなまずい場所、イメージとしてはアングラなチャイナタウン。そこで探索者たちは怪異を祓う「厄祓い屋」として暮らしている。\n\n◆探索者その１：堺 梅雪\n四十路手前になっても若者感が抜けないチャラチャラした男。顔や肌艶がいいので通常よりも二回りくらい若く見られる。身長166cm。厄祓い屋の商売人。よく口も頭も回る交渉担当。\n怪異退治をすることを生業にしていることもあり、まじないや呪いの類の多くに精通している。頭から伸びてるように見える角も、弱い怪異を牽制するためのまじない飾りであり実際には生えていない。\n女好きなので『用心棒にするなら可愛い女の子が良かった』と文句を垂れているが、榕榕のことを信頼しているし本人なりに可愛がっている（主に餌付け）\n\n◆探索者その２：榕榕\n厄祓い屋の用心棒。凡人を凌駕する圧倒的な力をもつ、戦闘担当。\nごつい＆高身長(2m越え)の23歳男性。見た目で誤解されやすいが忠犬属性。\n昔から奇妙な現象に好かれており、それを解決してくれた梅雪に恩義を感じ懐いているらしい。梅雪と会う前はアングラめな地下闘技場で生活をしていた。\n\n上記設定を見て、どのようなイラストを描かれるかはクリエイター様にお任せ致します。\n依頼受諾していただけましたら幸いでございます。\n\nhttps://drive.google.com/drive/folders/1ECafnR_FWbIJW7ARAZjBsQG-A0CIxDFJ?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@den_tbn/works/130", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 29762, "client_id": 2570246, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d837655/uploads/origins/c759ecd7-07f3-4786-9dc1-17137d2d5fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b86733cb978d90ca357a56c4299ff20", "srcset": "https://si.imgix.net/3d837655/uploads/origins/c759ecd7-07f3-4786-9dc1-17137d2d5fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b86733cb978d90ca357a56c4299ff20, https://si.imgix.net/3d837655/uploads/origins/c759ecd7-07f3-4786-9dc1-17137d2d5fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6767ba2cfb26a7ff1f30fb5a9e0e7f31 2x, https://si.imgix.net/3d837655/uploads/origins/c759ecd7-07f3-4786-9dc1-17137d2d5fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6dee7abbb385d1b677d7a9627daef9fc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d837655/uploads/origins/c759ecd7-07f3-4786-9dc1-17137d2d5fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c79c3b9b278022b59b07e0b78371c873", "srcset": "https://si.imgix.net/3d837655/uploads/origins/c759ecd7-07f3-4786-9dc1-17137d2d5fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c79c3b9b278022b59b07e0b78371c873, https://si.imgix.net/3d837655/uploads/origins/c759ecd7-07f3-4786-9dc1-17137d2d5fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=372daaeda4cb6d4981794fe462293301 2x, https://si.imgix.net/3d837655/uploads/origins/c759ecd7-07f3-4786-9dc1-17137d2d5fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd