.imgix.net/928f8a46/uploads/origins/7113e07f-a3b2-4a33-b93d-8c5f9e045fd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db64c79f08adfe24799814a236a19159, https://si.imgix.net/928f8a46/uploads/origins/7113e07f-a3b2-4a33-b93d-8c5f9e045fd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=78722abe040ea13b7683af3368e983c6 2x, https://si.imgix.net/928f8a46/uploads/origins/7113e07f-a3b2-4a33-b93d-8c5f9e045fd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3277d9b722c60ba1aea8f0dd62889f09 3x"}, "body": "いつもお世話になっております。\n別垢のアイコンの制作お願いいたします。\n以前、描いて頂いたラフを仕上げて頂く形で目の色とアクセサリーにだけ指定を入れたいと思います。\n・目の色:緑(明るめの、出来れば翡翠に近いと有難いです)\n・アクセサリー：いずれもブランドの指定、薬指以外の石の有無などはお任せします。\n左手→親指にリング、手首にシルバーのブレスレット\n右手→人差し指、薬指にリング(薬指のリングは琥珀っぽい石付けて見える様にして頂けると有難いです)\nもし可能でしたら、欧風っぽい椅子に足組んで座っている所だと嬉しいです。\n問題なければ、ご承認お願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gotosey/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 14245, "client_id": 1251352, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbf8e370/uploads/origins/195ec783-ff1a-4ac5-a287-4e0b6e8fa984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd830caa8f16d14bd51d40789842afdc", "srcset": "https://si.imgix.net/cbf8e370/uploads/origins/195ec783-ff1a-4ac5-a287-4e0b6e8fa984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd830caa8f16d14bd51d40789842afdc, https://si.imgix.net/cbf8e370/uploads/origins/195ec783-ff1a-4ac5-a287-4e0b6e8fa984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67d10b7e7e17c0b0b005b3e5aa148502 2x, https://si.imgix.net/cbf8e370/uploads/origins/195ec783-ff1a-4ac5-a287-4e0b6e8fa984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2255eba0ca32d08ac0b9cbf2079455dd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbf8e370/uploads/origins/195ec783-ff1a-4ac5-a287-4e0b6e8fa984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ec8384e824e8bb58519571487a0f4fd", "srcset": "https://si.imgix.net/cbf8e370/uploads/origins/195ec783-ff1a-4ac5-a287-4e0b6e8fa984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ec8384e824e8bb58519571487a0f4fd, https://si.imgix.net/cbf8e370/uploads/origins/195ec783-ff1a-4ac5-a287-4e0b6e8fa984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=95ca21b2743ebde6df8de3ad22e39c49 2x, https://si.imgix.net/cbf8e370/uploads/origins/195ec783-ff1a-4ac5-a287-4e0b6e8fa984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3191c32065fb11a94e3f44cf2c6955f 3x"}, "body": "初めまして。\n後藤先生の絵を拝見したのは、龍と魔法使いの絵が初めてでした。\n物語を彩るイラストをドキドキしながら眺めていました。\nこうして直接依頼できる機会があるのが夢みたいです。\n今回、私が今書いている小説のイメージイラストをお願いさせて下さい。\n表紙が設定できるようなら、表紙としても使用させて頂きたいです。\n\n詳細です：\n主人公）\n外見１６，７歳\nロングストレートの黒髪、二重の黒い瞳の大和なでしこ風、束髪（イギリス結び）、色白、小柄\n見た目はお淑やかで楚々とした美少女、ただし中身は筋金と気合の入ったオタク気質\n着物\n手には筆と帳面を持っている、または原稿用紙は両手で持っている\n\nお相手）\n外見２５、６歳ぐらい\n光を透かせば銀にも見えそうな淡い金色の髪、真っ直ぐで短い、切れ長の満月色の瞳、色白、長身\n怜悧な感じで、少し気難しそう、実は苦労人でもある\n洋装、少しラフな感じ、\n狐の耳、尻尾が三本（本来四本が訳あり）\n\n時代は明治時代\n二人の関係性は訳ありですが一応夫婦\nワクワクドキドキ、いいネタ思いついちゃった！という感じにウキウキの主人公\nやれやれと肩を竦めて溜息つきながらも、見守る視線は優しいお相手\n\n以上です。\n細かい構図や着物の柄や色、小物などはお任せさせて下さい。\n\nちょっと、と思うようでしたら流して頂いて構いません。\nご縁がありますようにと祈っております。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gotosey/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 14245, "client_id": 1587868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3da5c7b2/uploads/origins/a98404b4-5a28-4bc8-aaea-4145055ef2af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fc8e6c230204d5787850845c96f21e2", "srcset": "https://si.imgix.net/3da5c7b2/uploads/origins/a98404b4-5a28-4bc8-aaea-4145055ef2af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fc8e6c230204d5787850845c96f21e2, https://si.imgix.net/3da5c7b2/uploads/origins/a98404b4-5a28-4bc8-aaea-4145055ef2af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24616fc61cbc518b0c29ab0ca2807949 2x, https://si.imgix.net/3da5c7b2/uploads/origins/a98404b4-5a28-4bc8-aaea-4145055ef2af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71cba65f130889d1e8baf9f94c8e9227 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3da5c7b2/uploads/origins/a98404b4-5a28-4bc8-aaea-4145055ef2af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=608ecb7b208d50a21c382a4ecea8930a", "srcset": "https://si.imgix.net/3da5c7b2/uploads/origins/a98404b4-5a28-4bc8-aaea-4145055ef2af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=608ecb7b208d50a21c382a4ecea8930a, https://si.imgix.net/3da5c7b2/uploads/origins/a98404b4-5a28-4bc8-aaea-4145055ef2af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81c42ce98c7f437b3ad5ef4d9f35f1a9 2x, https://si.imgix.net/3da5c7b2/uploads/origins/a98404b4-5a28-4bc8-aaea-4145055ef2af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=53c82f45f5927ae2077e2ff401580f41 3x"}, "body": "前回は素敵なイラストをありがとうございました！\n\n実は、現紅と緑夢の正装は着物風の和装なのです♪\nイメージカラーは名前の通り紅と緑です。\n\n正装の時は普段の静と動が逆転するかのように、\n炎(動)の現紅、風(静)の緑夢となります。\n\n少しシリアスな彼らをみたい💖と言う私の暴走(笑)に御付き合い頂けたら幸いですm(*_ _)m\n\n着物風、という表現が伝わりにくいかもしれませんが、紋付袴(笑)のイメージではなく、巫女さんとか羽衣天女(笑)のイメージが近いです。\n\n彼らの炎や風を受け、なびく髪や衣装、といったイメージです。\n\n先生が想像を膨らませて描いて下さる事がとても楽しみなのでリクエストはこの辺で♪\n\nもしワガママをお願い出来るのであれば、\nイラストの風合い？はカラーを沢山のせるのではなく、ラフ画に近いカラーイラスト？クレヨンではなく、色鉛筆で塗ったようなイメージ？が嬉しいです。\n\n前回