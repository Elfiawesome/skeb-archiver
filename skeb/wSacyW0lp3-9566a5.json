冬弥（兄🐶）\n・外見：16歳 / 175cm / 黒い瞳 / 細マッチョ\n・設定：表向きは優秀な跡取りだが、内心はツッコミと愚痴だらけ。計算高いが根性はある。\n　妹に一目惚れしており、連れて逃げ出す方法を探し続けていた。\n　妹には心の声が筒抜けなため、彼女の前でだけ猫を被るのをやめ、子犬のように素の自分をさらけ出す。衝動的で我を忘れたり、泣きべそをかいたりと未熟な一面も。\n\n【衣装デザインについて】\n兄：大正ロマンを感じさせる、洋装寄りのスーツスタイル\n妹：秋冬向けの、家着っぽい重ね着スカート。全体的に柔らかい印象にしていただけますと嬉しいです。髪型はロングヘアに加え、片側だけ三つ編みを施したスタイルを希望します。\n\n【使用用途】\n・創作活動の資料として\n\n金額不足の場合、再送要請をいただけますと幸いです。\nお忙しいところ恐縮ですが、ご検討のほどよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/17tQDBF69RE3fHJNug9cT_Bm_JvAlnCzD?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wSacyW0lp3/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3926504, "client_id": 3979550, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6cf7bacb/uploads/origins/f7dcbf53-6833-4a4e-8356-53fe1fb3cba5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc06c40cef1d11afa0fcec02634d7a9f", "srcset": "https://si.imgix.net/6cf7bacb/uploads/origins/f7dcbf53-6833-4a4e-8356-53fe1fb3cba5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc06c40cef1d11afa0fcec02634d7a9f, https://si.imgix.net/6cf7bacb/uploads/origins/f7dcbf53-6833-4a4e-8356-53fe1fb3cba5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=143dc93400b0ba132adfa76b985899b8 2x, https://si.imgix.net/6cf7bacb/uploads/origins/f7dcbf53-6833-4a4e-8356-53fe1fb3cba5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=405906ee53a7d1a5332aa420ed86fb55 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6cf7bacb/uploads/origins/f7dcbf53-6833-4a4e-8356-53fe1fb3cba5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92a7356ed61febc76fc6c9c7ae39d751", "srcset": "https://si.imgix.net/6cf7bacb/uploads/origins/f7dcbf53-6833-4a4e-8356-53fe1fb3cba5?bg=%23fff&au