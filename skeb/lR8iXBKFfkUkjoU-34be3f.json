/uploads/origins/148e9e56-5068-4c50-9f79-6e05a9199bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=83e4c7f88256f610eb22c66dd3edd615 2x, https://si.imgix.net/3207ac19/uploads/origins/148e9e56-5068-4c50-9f79-6e05a9199bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d69f23626716f9e39c17993ca438602d 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 106943, "nc": 171}, {"path": "/@lR8iXBKFfkUkjoU/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 106943, "client_id": 3458322, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0add8357/uploads/origins/b9e4a6b9-60d1-4eaf-b393-e73f968d1bea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bec86d9e37c5b7403502fa702f667eb4", "srcset": "https://si.imgix.net/0add8357/uploads/origins/b9e4a6b9-60d1-4eaf-b393-e73f968d1bea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bec86d9e37c5b7403502fa702f667eb4, https://si.imgix.net/0add8357/uploads/origins/b9e4a6b9-60d1-4eaf-b393-e73f968d1bea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17eca5e963d121855eec32e77255df7a 2x, https://si.imgix.net/0add8357/uploads/origins/b9e4a6b9-60d1-4eaf-b393-e73f968d1bea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d29dfc32bf457cb443cd759ff4705a61 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0add8357/uploads/origins/b9e4a6b9-60d1-4eaf-b393-e73f968d1bea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0e1d1c97bf03bbe86690993b818dbc7", "srcset": "https://si.imgix.net/0add8357/uploads/origins/b9e4a6b9-60d1-4eaf-b393-e73f968d1bea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0e1d1c97bf03bbe86690993b818dbc7, https://si.imgix.net/0add8357/uploads/origins/b9e4a6b9-60d1-4eaf-b393-e73f968d1bea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=72f4f54e271388b91c9edc44758f7c50 2x, https://si.imgix.net/0add8357/uploads/origins/b9e4a6b9-60d1-4eaf-b393-e73f968d1bea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=10fb3254bfd36055c320d9a9add7f5be 3x"}, "body": "追っかけチューバー事実上引退で今月予算に空きができたのでゲーム開発支援に。\nリクエスト受けていただけるといいな～\n\n現状で凌辱ルートオミット残念無念、是非とも凌辱DLC実現できるくらい売れてほしいところ。\n過去の話題みると広輪さま、Blackconyさまともボテ腹は大丈夫そうなので（さすがに出産だと声優さんの可否もあり未知数ですが）、期待が膨らみます。四人の妊娠線バリバリの大きな妊婦腹素晴らしい！\n\nさて、リクエストになりますが\n\nキャラ\n遠蛮さんのキャラで、DLCでもエッチはだいぶ先になりそうな磐座穣ちゃん\n某はわわ軍師ちゃんみたく、ちっちゃい娘かと思ったら身長は平均なのですね。腕が手前なので勘違いしてましたが結構お胸も大きいし。\n\n衣装\n着崩れした巫女服or裸\n\n体型\n長期監禁と扱いの酷さが分かるように髪が種付けはショートカット、臨月時はセミロング\n多胎妊娠で一般生活の難しい臨月ボテ\n長期輪姦で乳首や性器のグロ化\n\nシチュ\n完勝試合の神楽坂派残党掃討に出た五十六と穣ちゃんが、たまたまトラップや伏兵が上手く組み合ってしまい囚われの身になってしまう。\n\n重症で意識不明の五十六を助けるために、甘んじて残党に輪姦される穣ちゃん。ただ殺したり、犯すだけで自分達が受けた屈辱が晴れない残党達は、穣ちゃんがハーフなのに目をつけ、薬物又は魔法で過剰排卵させて、五十六の前で孕ませることにする。\n\n10ヵ月後、五十六不在による内部分裂を避けるためや瑞穂さんへの対処で神月派が二人の十分な捜索ができない中、臨月を迎えた穣ちゃん。普通ではありえない多重妊娠の絶えない苦痛と身重でも容赦ないレイプに、ただ五十六を生かすために耐え続けるが遂にそのときが・・・みたいな内容のイラストでお願いしたいです。\n\n欲しい差分\n①穣ちゃんに輪姦種付け\n②多胎臨月凌辱\n③多胎児出産（大体こんな感じ　https://www.pixiv.net/artworks/89718531）\n\n穣ちゃんの態度は一人ならいくらでも逃げられるけど、五十六ために嫌々本番セックスを受け入れる感じで。妊娠・お腹の子供達に対する思いは穣ちゃんの生まれや境遇的に複雑そうなので肯定的・否定的お任せします。\n\n設定斜め読みなので、ifとしてもお怒りになられる内容になっていたら、すみませんです。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lR8iXBKFfkUkjoU/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 106943, "client_id": 3415598, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44e49106/uploads/origins/568fc2e2-4918-4241-bff1-67851d40924a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=568a39245e284c4d85a6cd223ed9594d", "srcset": "https://si.imgix.net/44e49106/uploads/origins/568fc2e2-4918-4241-bff1-67851d40924a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=568a39245e284c4d85a6cd223ed9594d, https://si.imgix.net/44e49106/uploads/origins/568fc2e2-4918-4241-bff1-67851d40924a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1caa8ed6d276344b52894e1e45a15ed 2x, https://si.imgix.net/44e49106/uploads/origins/568fc2e2-4918-4241-bff1-67851d40924a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b19e41f3e0a015994c2a3b5160e1406 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44e49106/uploads/origins/568fc2e2-4918-4241-bff1-67851d40924a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7433a03a27bd238b781e115e3fa2c999", "srcset": "https://si.imgix.net/44e49106/uploads/origins/568fc2e2-4918-4241-bff1-67851d40924a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7433a03a27bd238b781e115e3fa2c999, https://si.imgix.net/44e49106/uploads/origins/568fc2e2-4918-4241-bff1-67851d40924a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4e1769985a87f2bc841668466cb366fa 2x, https://si.imgix.net/44e49106/uploads/origins/568fc2e2-4918-4241-bff1-67851d40924a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a901d0d859388510fa966f7e0ca007f7 3x"}, "body": "こんにちは\n\n【キャラ】\nくろてん ラケシス\n\n【概要】\n敗北エンドの孕みレイプ・出産\n\n【イメージ】\n・ラスボス敗北、主人公達を逃がすために足止めして囚われの身に、それから数か月後みたいな感じ\n切り貼りした添付資料のイメージで、臨月ボテで口とアナルをサティアにロックされて、竿役に立ちバックで犯される構図\n「薄汚い乞食の種にしては順調ね」、「可愛いのが生まれたら私の神使にしてあげる」、「ほら、パパはまだ満足してないみたい・・・しっかり相手してあげないと」みたいな台詞\n精神崩壊や快楽堕ちしてない状態で、可能なら断面図で子宮内の胎児を描いてもほしい\n\n・しばらく時間が経過した感じで\n完全娩出後、パックリ開いた産道から垂れた臍の緒で繋がっている赤ん坊、開いた穴から残留羊水が垂れて、赤ん坊は羊水の水たまりの中でもがいている\n「あらあら、残念父親に似ちゃったわね」、「仕方がない・・・第2子にかかりましょうか？」みたいな台詞\n\n金額に対する作業量で2枚目になるか、差分になるかはお任せします\n純愛ゲームに凌辱絵リクエストなので広報には役立たないでしょうけど、少ないですがゲーム制作支援もかねまして\nくろてん、うまくいくとよいですね\n\nhttps://drive.google.com/file/d/1IoLDepVhreofPxVTO_ZgoaiqeH98xTHC/", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": []}, "price_history": {"art": [{"amount": 5000, "recorded_at": 1779886948.292452}]}, "custom": {}}