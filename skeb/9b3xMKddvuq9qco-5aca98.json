origins/0dd360df-ff54-4d75-bf04-341ece86ab45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f6bc0adc8fb36034cb6a418f21734721 2x, https://si.imgix.net/d45ceb24/uploads/origins/0dd360df-ff54-4d75-bf04-341ece86ab45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b005e23801b48b61a9b5b818eafa5d01 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2285289, "nc": 144}, {"path": "/@9b3xMKddvuq9qco/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2285289, "client_id": 2044265, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9dbad75b/uploads/origins/c7559f91-3523-49c4-afb6-d0a38809bf04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb861239ccd9c15342b6b8695c62370a", "srcset": "https://si.imgix.net/9dbad75b/uploads/origins/c7559f91-3523-49c4-afb6-d0a38809bf04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb861239ccd9c15342b6b8695c62370a, https://si.imgix.net/9dbad75b/uploads/origins/c7559f91-3523-49c4-afb6-d0a38809bf04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2fb7fd88eb44f5d218d884a91aeefc6f 2x, https://si.imgix.net/9dbad75b/uploads/origins/c7559f91-3523-49c4-afb6-d0a38809bf04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba32a6ad58cfd26f98a8b0e65e9377db 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9dbad75b/uploads/origins/c7559f91-3523-49c4-afb6-d0a38809bf04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64cb3838fdec85e7c1d29e812bd09589", "srcset": "https://si.imgix.net/9dbad75b/uploads/origins/c7559f91-3523-49c4-afb6-d0a38809bf04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64cb3838fdec85e7c1d29e812bd09589, https://si.imgix.net/9dbad75b/uploads/origins/c7559f91-3523-49c4-afb6-d0a38809bf04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8d4366ca864aaa79f424a269a0ffcfbf 2x, https://si.imgix.net/9dbad75b/uploads/origins/c7559f91-3523-49c4-afb6-d0a38809bf04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4fded06f318b73b3b81bf253c6fa0866 3x"}, "body": "洸さん、こんにちは。そして初めまして。\n台湾でアルファウルフと申します。\n\n洸さんの作品を以前から拝見しており、その色彩感覚や創造力の豊かさに深く感銘を受けています。特にデジモンを描かれる際の表現力や迫力は、まさに達人といった印象で、いつも楽しみにしております。このたび、洸さんの素晴らしいスキルで、私のオリジナルキャラクターをデジモン風に仕上げていただければと思い、リクエストさせていただきました。\n\nまず、私のキャラクターについて簡単に説明させていただきます。このキャラクターは金色の瞳を持つ白い狼で、胸毛や頸毛がふわふわしているという、とてもシンプルなデザインです。しかしながら、洸さんの力をお借りし、デジモンの世界観を取り入れていただければ、より魅力的で印象的な作品になるのではないかと期待しております。\n\nまた、このキャラクターには特殊な能力を持たせたいと考えています。イメージとしては、デジモンの究極体のような威厳や力強さが理想です。たとえば「ケルヌモン」のように動物的な外観を持つデジモンに近い部分もあるかもしれませんが、装飾が多すぎるデザインは避けたいと思っております。\n\n参考資料として、過去数年間、私が最もよく使用している2枚のデスクトップ画像をリンクにて添付いたしました。この画像を参考にしていただきつつ、私のキャラクターを「戦闘時の威風堂々とした姿」で描いていただければと思います。このような戦闘中の迫力ある描写が、ぜひ描いて頂けたら嬉しいです…！\n\nまた、リクエストのポイントとして、以下のような雰囲気を目指していただけると嬉しいです。\n\n「私の狼群は戦いの用意を整え、いつでも戦える状態だ！」\n\nこのような戦闘への意気込みや緊張感を表現いただけると理想的です。なお、戦闘相手については描いていただいても、描かなくても構いません。\n\n特殊な能力や細かな描写については、洸さんの自由な発想で表現していただければと思います。洸さんの感性や解釈にお任せできれば幸いです。\n\n箱舟先生が描いの設定：\n● https://skeb.jp/@fox_road/works/2\n● https://journal.alphawolf.asia/#commissioned\n\n私のキャラ設定は、金色の目をした真っ白なオオカミです。元々の設定では瞳は白色でしたが、後に完全な金色の瞳に変更しました。\n\n● https://journal.alphawolf.asia/#ideas\n● https://x.com/Wolves_Paradise/status/185994965728541508\n\n👆 参考資料（最もよく使用している2枚のデスクトップ画像）\n\nP.S.\n我々は、なぜ多くの方々に認識されているのか分からない部分があります。また、最近多くの絵師様が「片目を閉じた」を描かれること、もし何か私に伝えたいことがある場合は、作品中に反映させないようお願い申し上げます。\n\nご多忙のところお手数をおかけしますが、どうぞよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": 