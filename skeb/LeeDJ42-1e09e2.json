wFPvdpM3dSyHTKMwuRh_Xq4Fj8j2hfaI/view?usp=drivesdk", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@LeeDJ42/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2697743, "client_id": 3534181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d673bb89/uploads/origins/82f96468-de80-414a-bbcb-8e2edbb5f679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6717291ff11745825e62a485ccb67b5d", "srcset": "https://si.imgix.net/d673bb89/uploads/origins/82f96468-de80-414a-bbcb-8e2edbb5f679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6717291ff11745825e62a485ccb67b5d, https://si.imgix.net/d673bb89/uploads/origins/82f96468-de80-414a-bbcb-8e2edbb5f679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa4dd359a3d6947263bbfb0257a98b7d 2x, https://si.imgix.net/d673bb89/uploads/origins/82f96468-de80-414a-bbcb-8e2edbb5f679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c33b8816ea66e333d2cde76631ffd31 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d673bb89/uploads/origins/82f96468-de80-414a-bbcb-8e2edbb5f679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=432119f1998cc83e444d23591261bf2b", "srcset": "https://si.imgix.net/d673bb89/uploads/origins/82f96468-de80-414a-bbcb-8e2edbb5f679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=432119f1998cc83e444d23591261bf2b, https://si.imgix.net/d673bb89/uploads/origins/82f96468-de80-414a-bbcb-8e2edbb5f679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=52bb89ed570a63e4a8054125408437b7 2x, https://si.imgix.net/d673bb89/uploads/origins/82f96468-de80-414a-bbcb-8e2edbb5f679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a1e2dd32e7abfbfa842baad53bbdcb85 3x"}, "body": "はじめまして！りーしぶ様の背景の描き込みや生活感のある一枚絵に惹かれリクエストさせていただきました。\n今回お願いしたいのはTRPGで使用したキャラクター2人の一枚絵です。\n\n\n■キャラクター資料\n・1人目\n名前：ハトヤ\n性別：男\n年齢：25\n身長：183cm\n職業：バリスタ\n雰囲気：明るい、へらへら、素直、犬系\n\n・2人目\n名前：灰蛇（はいだ）\n性別：男\n年齢：30代前半\n身長：179cm\n職業：バーテンダー\n雰囲気：クール、ストイック、客には人当たりがいい\n\nビジュアルは資料をご参照ください。\n\n\n■2人の関係性\n同じアングラカフェバーで働くバリスタとバーテンダー。従業員は2人のみ。ハトヤの方が後から入ったので後輩にあたる。灰蛇に認められたくて頑張っている。\n\n\n■リクエスト内容\n2人がカフェバー『Viperosa』（ヴィペローザ）で仕事をしている日常風景の場面をお願いします。\n\n■店について\nアングラカフェバー『Viperosa』（ヴィペローザ）\n営業時間は深夜のみで、客層は主に裏社会の人間たち。裏社会の人間たちの情報収集や交流の場として使われている。\nお店のモチーフは蛇と薔薇。立ち絵のエプロンの下の方にロゴが入っています。\n酒だけでなくコーヒーや軽食、クリームソーダやパフェなどのデザートも出す。\n内装のイメージはクラシックな純喫茶が近いかもしれません。　\n\n以上になります。\nご検討のほど、よろしくお願いいたします。\n\n\n▼ビジュアル資料\nhttps://drive.google.com/drive/folders/1ssxz0V4WPzQWMhHdBGYxz3lLAkzqNH3A", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@LeeDJ42/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/40884d67/uploads/origins/5709e75d-4c15-4f27-80fc-ffe2d9f6f82f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3bcaaa53e4397d67c38461d51416284a", "srcset": "https://si.imgix.net/40884d67/uploads/origins/5709e75d-4c15-4f27-80fc-ffe2d9f6f82f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3bcaaa53e4397d67c38461d51416284a, https://si.imgix.net/40884d67/uploads/origins/5709e75d-4c15-4f27-80fc-ffe2d9f6f82f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b3149a3961954025471e5b1de0b5676 2x, https://si.imgix.net/40884d67/uploads/origins/5709e75d-4c15-4f27-80fc-ffe2d9f6f82f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop