/54ac2604/uploads/origins/e9929dd6-deb2-45f5-8d59-0f6999d41955?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cfbc6275d34615c990fcbaa484aabc72 3x"}, "body": "りーしぶ先生の作品の絵柄がとても好きです！もしよろしければ僕のオリジナルキャラを描いていただけませんか？  \n\n描いていただきたいキャラクターは僕が今アイコンにしている自分で描いたキャラなのですが、pdfのURLを張っても見れるかわからなかったのでskebでアイコンが見えなかったりしたらtwitterのURLを張っておくので見に来ていただくようお願いいたします。  \n\nピアノを演奏している絵を描いていただきたいです。\n配信でのピアノ演奏中の画像として使用させていただきたいです。\n服はシンプルな黒または白のパーカーで描いていただきたいです。\nピアノはRolandのFANTOM-08というシンセサイザーを使用していますが、描きやすければグランドピアノでもイラストで描いていただくのはどちらでも大丈夫です！\n\n演奏している場所は普通のお家で特にこだわりはありませんのでイラストの雰囲気に合うようにお任せします。可能であればスタジオのように暗い部屋にオレンジの照明で少しだけ明るくなっているようにしていただきたいです。\nキャラの左斜め後ろから演奏しているのを見ている視点にしていただきたいです。\n\n\n特徴は髪の色が暗めの茶色にキャラクターの一人称から見てメッシュ的なのが右側に暗いオレンジが3か所、左側に青いのが2か所ある感じです。目は灰色っぽくしています。性別は男です。  \n\n描いていただけたらうれしいです！よろしくお願いいたします！！  \n\nhttps://twitter.com/@a_kemu426\n\nhttps://drive.google.com/drive/folders/1DSE7X2M1TKAHYVJL2Tx_77aTwjj-KuUl?usp=sharing\n\nhttps://drive.google.com/drive/folders/1DSE7X2M1TKAHYVJL2Tx_77aTwjj-KuUl?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@LeeDJ42/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a17dd5d3/uploads/origins/8c377ff1-01c4-4799-b576-1f2a2b7e111c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78a3d68ed069940c0df118a3a9f5e062", "srcset": "https://si.imgix.net/a17dd5d3/uploads/origins/8c377ff1-01c4-4799-b576-1f2a2b7e111c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78a3d68ed069940c0df118a3a9f5e062, https://si.imgix.net/a17dd5d3/uploads/origins/8c377ff1-01c4-4799-b576-1f2a2b7e111c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f37f9bbbe81d50f53c71058cda625e3 2x, https://si.imgix.net/a17dd5d3/uploads/origins/8c377ff1-01c4-4799-b576-1f2a2b7e111c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7e8810b6b600cc5f35e7ed4d3455f40 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2697743, "client_id": 3541505, "nc": 144}, {"path": "/@LeeDJ42/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2697743, "client_id": 2811101, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4fcef95/uploads/origins/3f120e4a-2de1-4227-afaa-5593e3b7043b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1543ae0eee076bdbf048d1154a6788f", "srcset": "https://si.imgix.net/d4fcef95/uploads/origins/3f120e4a-2de1-4227-afaa-5593e3b7043b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1543ae0eee076bdbf048d1154a6788f, https://si.imgix.net/d4fcef95/uploads/origins/3f120e4a-2de1-4227-afaa-5593e3b7043b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7255966fd947370885cc71bd5f996bb4 2x, https://si.imgix.net/d4fcef95/uploads/origins/3f120e4a-2de1-4227-afaa-5593e3b7043b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7843c0d6928c6676b89659ddfa924caa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4fcef95/uploads/origins/3f120e4a-2de1-4227-afaa-5593e3b7043b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=303a1e6bdf10a7c9c505035437495b39", "srcset": "https://si.imgix.net/d4fcef95/uploads/origins/3f120e4a-2de1-4227-afaa-5593e3b7043b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=303a1e6bdf10a7c9c505035437495b39, https://si.imgix.net/d4fcef95/uploads/origins/3f120e4a-2de1-4227-afaa-5593e3b7043b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9cfb0e72e8d135e65d42da9c23a97be 2x, https://si.imgix.net/d4fcef95/uploads/origins/3f120e4a-2de1-4227-afaa-5593e3b7043b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9c898276ae5731784087ad9c7a56b47d 3x"}, "body": "りーしぶ様\nお世話になっております。りーしぶ様の暖かく生活感を感じるイラストがとても好きで、ぜひまたりーしぶ様にイラストを描いていただきたくリクエストを送らせて頂きました。\n\nこの度は私と友人のキャラクターたちを描いていただけたらと思います。（相手様方に許可は頂いています)\n\n\n▽使用用途\n個人の観賞用です。SNSのアイコンに使用させていただく場合は作者名を記載致します。\n\n▽キャラクターと世界観\n\n○非公式CoCシナリオ『四季送り』の探索者達です。依頼内容にシナリオのネタバレはありません。\n●共通設定 \n甘味処「あび」 は裏社会の人間なら誰もが知る、異端な殺し屋を抱える何でも屋だ。（概要より） \n依頼するキャラ達は皆甘味処で働いている殺し屋になります。\n\n①春 女性/身長164cm(本来は154cmですがヒールのある靴を履いているため)\nピンク髪の女性。明るく天真爛漫で人との距離が近く、周囲を巻き込むタイプのキャラクター。花と可愛らしいものと、このメンバーのことが好きです。\n\n②夏 男性/身長175cmくらい\n黒髪の眼鏡をかけた男性。ツンとしていて彼らと距離を取ろうとしますが、なんだかんだ集まりに参加してくれるタイプ。この4人の中で最年少です。\n\n③秋 男性/身長 175cmより大きいくらい\n金髪の男性。元気でノリがいい。〜っす！口調で身振り手振りが大きい。常にへらへらにこにこしている。彼が楽しいことや企画を持ち込む。\n\n④冬 男性/身長186.3cm\n白髪でそばかすがある男性。落ち着いているがどこかぼーっとしているような印象がある。\n寒がり。この4人の中で最年長です。\n\n▽関係性\n春→全員に対して距離が近い。\n夏→春・秋にはツンとした態度ですが、冬に対しては従順で素直です。憧れを抱いている様子。\n秋→全員に対して距離が近い。\n冬→周りの意見をわりとなんでも肯定しがち。\n\n▽資料\n外見に関してはGoogleドライブ内の資料をご確認ください。\n\n▽構図等\n和風な喫茶店店内で4人が楽しげにしている日常風景のイラストをお願いしたいです。りーしぶ様の食べ物のイラスト、食事風景のイラストがとても好きなので、可能であれば描写していただけたら幸いです。\n\n\n資料が不足していたり金額や内容に見合わない点がありましたら再送請求やキャンセルいただけたらと思います。\n人数が多く大変なリクエストとなりますが、ご検討いただけますと幸いです。よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-TWDQYAqsPweMeaeadlBiKtGRMWEk_Ft", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@LeeDJ42/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2697743, "client_id": 1433185, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/154fbe32/uploads/origins/eb5c2adf-0531-47f0-9bc1-05eb51cdc86c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26e53140a50d01cfd565605a8a023991", "srcset": "https://si.imgix.net/154fbe32/uploads/origins/eb5c2adf-0531-47f0-9bc1-05eb51cdc86c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26e53140a50d01cfd565605a8a023991, https://si.imgix.net/154fbe32/uploads/origins/eb5c2adf-0531-47f0-9bc1-05eb51cdc86c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a08cf28158567c0f4b571081ec0e0a0 2x, https://si.imgix.net/154fbe32/uploads/origins/eb5c2adf-0531-47f0-9bc1-05eb51cdc86c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=365d05a5e8ea5f71bc8c403db910133a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/154fbe32/uploads/origins/eb5c2adf-0531-47f0-9bc1-05eb51cdc86c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46db1c6c2dc45a1b07a2e9e37093daf4", "srcset": "https://si.imgix.net/154fbe32/uploads/origins/eb5c2adf-0531-47f0-9bc1-05eb51cdc86c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46db1c6c2dc45a1b07a2e9e37093daf4, https://si.imgix.net/154fbe32/uploads/origins/eb5c2adf-0531-47f0-9bc1-05eb51cdc86c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ea7cf70931181269f8dbf5b13416b1b 2x, https://si.imgix.net/154fbe32/uploads/origins/eb5c2adf-0531-47f0-9bc1-05eb51cdc86c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c50248b1fee421de5a9d9d8ead885417 3x"}, "body": "りーしぶ先生、こんにちは！\nはじめまして！先生の素敵な絵が大好きです！私のVTuberのキャラクターを先生のスタイルで描いていただきたいです。\n私のキャラクターが料理をしているシーンを可愛くコミカルに描いていただけませんか？私のキャラクターは料理の仕方を知っていますが、料理をすることを拒否しているので、非現実的です。でもいつかは...！\n\n私のキャラクターは数千年後の未来から来たポスト黙示録的な世界で、人類は多くの素晴らしい技術を達成したが、資源が尽きてしまった。世界観は『ニーア オートマタ』に似ていて、自然が多く、廃墟と化した建物が多い。私のキャラクターは、目的を探しているアンドロイドです。\n\nこれが僕の衣装！\nhttps://drive.google.com/file/d/1DdteMELp5PsHrRQT2j8lIcMZUk15i1vE/view?usp=sharing\nオプションの剣：\nhttps://drive.google.com/file/d/1Nn98Qj_B_2FgXDwFqO_mQrVtJwlrRWMm/view?usp=sharing\nhttps://drive.google.com/file/d/1h-Q96otztLGnrCtIceAeSMNe7-y52-YT/view?usp=sharing\n\nハートの勾玉\nhttps://drive.google.com/file/d/1pygGwXClpe-JoI2z2-Juc7mhm1c9Hnei/view?usp=sharing\n\n今後、VTuberのスケジュールやYouTubeのサムネイルにあなたのアートを装飾として使用させていただくかもしれません！\n\nよろしくお願いします！\n\nhttps://drive.google.com/file/d/1haJdfDmJdeT--mICCOL803UjFWggLtSd/view?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@LeeDJ42/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2697743, "client_id": 1582125, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eaf5b60f/uploads/origins/7a8e6452-734a-4cf7-9d9c-f5563016bfe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc5d484f39dece2690aa8db0b5a55879", "srcset": "https://si.imgix.net/eaf5b60f/uploads/origins/7a8e6452-734a-4cf7-9d9c-f5563016bfe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc5d484f39dece2690aa8db0b5a55879, https://si.imgix.net/eaf5b60f/uploads/origins/7a8e6452-734a-4cf7-9d9c-f5563016bfe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96dc99ac057b5e086fdd81f5a590c791 2x, https://si.imgix.net/eaf5b60f/uploads/origins/7a8e6452-734a-4cf7-9d9c-f5563016bfe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0ed7508679e5f3d1dd9af7e58c6f49d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eaf5b60f/uploads/origins/7a8e6452-734a-4cf7-9d9c-f5563016bfe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7daf61cd7ffc7fc844dab0140851861", "srcset": "https://si.imgix.net/eaf5b60f/uploads/origins/7a8e6452-734a-4cf7-9d9c-f5563016bfe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7daf61cd7ffc7fc844dab0140851861, https://si.imgix.net/eaf5b60f/uploads/origins/7a8e6452-734a-4cf7-9d9c-f5563016bfe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bf838dfacdfbe80982af2db8422eff3f 2x, https://si.imgix.net/eaf5b60f/uploads/origins/7a8e6452-734a-4cf7-9d9c-f5563016bfe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=54c1b4e33bf6887570f915ebb99e47a5 3x"}, "body": "ポートフォリオの1枚目のダイニングテーブルを囲んでいる感じのイラストがいいなと思って依頼しました。\nあたたかみのあるイラストをお願いしたく、りーしぶさんに依頼しました。\n\n自分のオリジナル曲のMVに使うイラストです。\nYoutubeのサムネ用に1280px✖️720pxでJPGもしくはPNGで納品お願いします。\nCMYKはNGです。\n同じイラストに曲名のタイトルを入れて楽曲配信のアートワークにも使いたいです。\nまた、歌詞を入れてリリックビデオ的にしたいので歌詞が入れられるスペースをどこかに残してもらいたいです。\n\nイラストの下書きと、実際にMVを作る楽曲を参考資料で送らせて頂きます。\n下書きは白黒ですが、色を使って欲しいです。\nカラフルすぎる必要はないですが、オーガニックなイメージのカラーにしていただけると嬉しいです。\n料理をしている頭上にスパイスが浮かんでいるイメージの下書きとなっています。\n\n色々指定してすみません。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1jH2HpRKav11bFMAz9cLhoAF4saq1YxNN?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@LeeDJ42/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2697743, "client_id": 2548461, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd0a553d/uploads/origins/c51e4a00-1ca1-4862-9662-5ee1e5911975?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfc1c0ab8dfddce39023a05b8a205e66", "srcset": "https://si.imgix.net/fd0a553d/uploads/origins/c51e4a00-1ca1-4862-9662-5ee1e5911975?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfc1c0ab8dfddce39023a05b8a205e66, https://si.imgix.net/fd0a553d/uploads/origins/c51e4a00-1ca1-4862-9662-5ee1e5911975?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=460ebf7b645713be5dc3330b1b167d95 2x, https://si.imgix.net/fd0a553d/uploads/origins/c51e4a00-1ca1-4862-9662-5ee1e5911975?bg=%23fff