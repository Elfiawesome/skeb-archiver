.com/YamadaChimi/status/1630144747896700928?s=20\n食べる事が好きなのでホークとスプーンもって口or鼻に食べ物ついちゃってたりとか\nそういうのもあうかなっておもいました！\nでもライブしているところや、配信（ゲーム）しているところなど\nそういったものもとても魅力的なので、基本的には山田ちみ様が思い描く\n珀世イフを描いてもらえたらうれしいです！\n\nまた、構図は、特に指定はないのですが、少し動きのある構図にしていただけるととても嬉しいです！！！\n※基本は山田ちみ様が楽しく描けるのが一番なので、\nもし要望が多いまたは難しいなどあれば見合うものに起こしていただければと思います\n\n▼使用用途\nSNSでの広報活動、YouTubeサムネイルや動画内での使用、FANBOX特典への使用等\n\n▼データ\n（1920×1080px以上）で作成いただきたいです。\n※サムネで使う時人物のみでを使うので拡大しても問題ないようにしたいです！\n問題ないようでしたら、人物と背景のレイヤーを分けた\nPSDファイルをいただけると嬉しいです。\n\nもしよければお受けいただけたら嬉しいです。\n長文失礼しました、ご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1JKsps8xTRyr_zBemPMoYwRHSvaNpM5om?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 3707, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "蒼乃ぐら", "screen_name": "aonogura39", "avatar_url": "https://pbs.twimg.com/profile_images/1344953173119680514/K-13eCjo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/742997246/1686045698/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 32}, {"id": 676241, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "さくらば🔥💧ご依頼受付中", "screen_name": "sakuraba_01", "avatar_url": "https://pbs.twimg.com/profile_images/1345019635322638337/KkPOLop2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2900334320/1632979269/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "voice"}, {"genre": "correction"}], "nc": 177}, {"id": 2375139, "creator": 