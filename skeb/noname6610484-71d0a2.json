webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6654fa822c5e8e93bcb81ab88f6457d 2x, https://si.imgix.net/356293b3/uploads/origins/a285616a-9a17-42a0-9e56-f462f5df9ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75184aaf0b7fafb032e0ff4c979fb964 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/356293b3/uploads/origins/a285616a-9a17-42a0-9e56-f462f5df9ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f9a5b194d96f03657227e08c0288262", "srcset": "https://si.imgix.net/356293b3/uploads/origins/a285616a-9a17-42a0-9e56-f462f5df9ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f9a5b194d96f03657227e08c0288262, https://si.imgix.net/356293b3/uploads/origins/a285616a-9a17-42a0-9e56-f462f5df9ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a8674d48e09801d7f5718293435a62f4 2x, https://si.imgix.net/356293b3/uploads/origins/a285616a-9a17-42a0-9e56-f462f5df9ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=67d7eaa068f6860c4d4c2b92f9741a58 3x"}, "body": "こんにちは！私が計画しているファンタジー小説のために、新しい邪悪な女吸血鬼を作ってほしいのです。舞台はルネッサンス／中世。彼女の名前はエデン・ロウで、褐色の肌をしていて、カーブを保ちながらとても鍛えられた引き締まった体つきをしています。ルビーレッドの瞳孔を持つ鋭い黒い瞳を持ち、眉毛はわずかに太い。身長は180センチほどで、足首に太いロープを巻きつけ、つま先とかかとを露出させたレッグウォーマー付きの非常にゆったりとしたズボンを履いている。上半身は主に鎧の下を着たようなデザインで、高い襟があり、みぞおちが露出している。腕輪をつけ、腰にホルスターをつけた2本の短剣を振り回している。ポーズはお任せする。しかし、彼女はダガーを振り回しているはずだ。ダガーと彼女の腕からは、わずかに暗い黒いオーラが漂っている。また、非常にサディスティックな笑みを浮かべているはずだ。もし改善すべき点があれば、遠慮なく言ってほしい！\n\nhttps://imgur.com/a/VKpxISV", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noname6610484/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3043161, "client_id": 2248529, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ea081b8/uploads/o