7a8b-4a97-8d42-3f9a6e428e91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a01450859153c32950ce4294f03cc5c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/608313e5/uploads/origins/42490732-7a8b-4a97-8d42-3f9a6e428e91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c0c5d8dd9e73142c83d280be4cf53cd", "srcset": "https://si.imgix.net/608313e5/uploads/origins/42490732-7a8b-4a97-8d42-3f9a6e428e91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c0c5d8dd9e73142c83d280be4cf53cd, https://si.imgix.net/608313e5/uploads/origins/42490732-7a8b-4a97-8d42-3f9a6e428e91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c12544d2ce0b9a32e38fb113fc789d7f 2x, https://si.imgix.net/608313e5/uploads/origins/42490732-7a8b-4a97-8d42-3f9a6e428e91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6ee682d4d1cc128b770323f552525fdf 3x"}, "body": "はじめまして\n好みな絵柄でしたのでリクエストさせてください\n\nキャラ\n「ダメなギャルは地味眼鏡教師に恋してる」に登場する中村琉夏ちゃん\n\n服装\n･作中で着用している制服。ただしソックスは 紺色のハイソックス(ひざ下あたりまでの丈のもの)に変更する\n･飾りのないフルバックの純白パンツ(クロッチは省略せず描いてください)\n\nシチュエーション等\n立ち絵と背景のパンツの組み合わせ(いわゆるMtUウィルスと呼ばれるものです)のカラーイラストをお願いします\n\n･立ち絵のポーズと表情はhttps://www.pixiv.net/artworks/128728848#big_0の3コマ目と同じもので、ハイソックスを履いているのがわかるようにひざ下かふくらはぎあたりまで描く\n･背景はお尻側から見たパンツ\n･差分として\n　･パンツがお尻に食い込んでいるもの\n　･白地に水色の星柄の入ったパンツを着用したもの\n　･お尻の穴に入れられたバイブでパンツが膨らんでいるもの\nを作っていただきたいです\n･psd形式での納品を希望します\n\nもしも内容に問題があると判断されましたら即キャンセルしていただいて構いませんので、改めてよろしくお願いします", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sasamichot/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3574664, "client_id": 806358, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b647c94b/uploads/origins/35ff9c7a-5529-4fa5-97a0-f0eb8c41b