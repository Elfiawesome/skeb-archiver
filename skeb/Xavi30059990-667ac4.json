5-31c0-4cde-9cc8-822976436237?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df603d499e8e51da41fc7f5db30731fa 2x, https://si.imgix.net/25019599/uploads/origins/e507ef85-31c0-4cde-9cc8-822976436237?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c19bab102548daf181a039d50377cec7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25019599/uploads/origins/e507ef85-31c0-4cde-9cc8-822976436237?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=567996c3093477201ae3e135c4f672f5", "srcset": "https://si.imgix.net/25019599/uploads/origins/e507ef85-31c0-4cde-9cc8-822976436237?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=567996c3093477201ae3e135c4f672f5, https://si.imgix.net/25019599/uploads/origins/e507ef85-31c0-4cde-9cc8-822976436237?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fab97f5511d7821e79cec4bc44546bac 2x, https://si.imgix.net/25019599/uploads/origins/e507ef85-31c0-4cde-9cc8-822976436237?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3fc9b27614cd8a894d5817766b51b1b9 3x"}, "body": "はじめまして、Xavi(しゃび)と申します。\nMisskey.ioにて、Skeb募集中のノートをお見かけしました。\n絵柄が自分の好みと合致しており、ケモもOKという事でしたので、ぜひ私のOCのイラストをお願いしたく、リクエストを送らせていただきました。\n\n描いていただきたいのは、「私のOCの狐ケモお姉さんが、腕を上にして手を縛られた状態で、こちらを睨んでいる様子」になります。\n・背景は単色か、石壁状のテクスチャ(牢の中イメージ)\n・足側はキャンパス外でもOKです。\n・資料だと分かりづらいですが、前髪に何箇所か緑色のメッシュが入っています。\n・資料で不明瞭だったり、描写していない箇所がありましたら、想像で描いていただいてOKです。\n\n以上、ご検討のほどよろしくお願いいたします。\n\nhttps://misskey.io/notes/9utxsl6y3qcq06t3", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osya_ki/works/138", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 345341, "client_id": 1853313, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2bdbcfc0/uploads/origins/e0c98fb7-5758-4cbb-a955-9a9d56fc2715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb5d526445d54621a848348b384ec8f2", "srcset": "https://si.imgix.net/2bdbcfc0/uploads/origins/e0c98fb7-5758-4cbb-a955-9a9d56fc2715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb5d526445d54621a848348b384ec8f2, https://si.imgix.net/2bdbcfc0/uploads/origins/e0c98fb7-5758-4cbb-a955-9a9d56fc2715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dedcb5e8b797e6a94bd6f69aafdf0252 2x, https://si.imgix.net/2bdbcfc0/uploads/origins/e0c98fb7-5758-4cbb-a955-9a9d56fc2715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4de5135af64df2df70015ab833d5c8df 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2bdbcfc0/uploads/origins/e0c98fb7-5758-4cbb-a955-9a9d56fc2715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e97c0a87f3e4842de0868a416ae7d43f", "srcset": "https://si.imgix.net/2bdbcfc0/uploads/origins/e0c98fb7-5758-4cbb-a955-9a9d56fc2715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e97c0a87f3e4842de0868a416ae7d43f, https://si.imgix.net/2bdbcfc0/uploads/origins/e0c98fb7-5758-4cbb-a955-9a9d56fc2715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9d6eee654128a53e3c5cffb377628c7c 2x, https://si.imgix.net/2bdbcfc0/uploads/origins/e0c98fb7-5758-4cbb-a955-9a9d56fc2715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e2616c43ebea5f232d63c4d76be3a0f 3x"}, "body": "いつも癖に刺さるイラストありがとうございます。\nリピートでリクエストさせていただきます。\n\n今回のリクエストは、おしゃきさんのキャラでの世界観クロスオーバー的なものになりますので、解釈違いでしたら遠慮なくキャンセルしてください。\n以前おしゃきさんが描かれた、ハゲタカちゃん非倫理研究所爆破脱出IFのイラスト↓\nhttps://x.com/osya_ki/status/1880937099500953700\nと同じ構図で、ケツァルコアトルスお兄さんのアズくんが、爆発を背景にこっちに飛び込んでくるイラストをお願いしたいです。\n\n・想定しているシチュエーションは「油断して、非倫理研究所に拉致されたアズくん。しかし、アズくんの凶暴性を過小評価していたために拘束が甘く、あっさりと脱走。散々暴れて研究所を破壊し、最後は設備の爆発と同時に脱出」になります。\n・アズくんの嘴から人の腕がはみ出していたりすると、より私の癖に刺さります。\n・リクエスト時に注意が出たため、NSFW有りにしていますが、特にそういった描写は不要です。\n\n以下はおしゃきさんの任意で、描写しないor変更してOKです。\n・元絵の背景に居た、元人間人外ちゃんの位置に、ハゲタカちゃんと、被験体になる前の研究員ママを配置してください(IFシチュの更にIF的な描写の想定)\n・細かいですが、上記の研究員ママを描写する際は「騒動に巻き込まれて衣服がボロボロの煤まみれ」になっていると、私の癖に刺さります。\n・ハゲタカちゃんと反対側に、元人間人外ちゃんと、つがいの元人間さんが吹っ飛んでいても良いです。\n\n以上、ご検討いただけると嬉しいです、よろしくお願いいたします。\n\nP.S.\nアズくん含め、最近おしゃきさんが描かれた恐竜キャラが、ことごとく私に刺さっております。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cross_ternari/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1217305, "client_id": 1853313, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a28d056/uploads/origins/8e5dc3d3-a225-4cc6-976b-1772317ae4d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbb45594376beb9b32f26a0fe1febf5c", "srcset": "https://si.imgix.net/9a28d056/uploads/origins/8e5dc3d3-a225-4cc6-976b-1772317ae4d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbb45594376beb9b32f26a0fe1febf5c, https://si.imgix.net/9a28d056/uploads/origins/8e5dc3d3-a225-4cc6-976b-1772317ae4d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37b5ec7dd4b7e7ee673c43f916f10c13 2x, https://si.imgix.net/9a28d056/uploads/origins/8e5dc3d3-a225-4cc6-976b-1772317ae4d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11271c566efd7027c701cc8028347888 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a28d056/uploads/origins/8e5dc3d3-a225-4cc6-976b-1772317ae4d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e1ffa0d7a94fa631ff070bb8cae6c78", "srcset": "https://si.imgix.net/9a28d056/uploads/origins/8e5dc3d3-a225-4cc6-976b-1772317ae4d6?bg=%23fff&auto=format%2