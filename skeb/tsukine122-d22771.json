c34bda642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=720f626030587f89b3ceee49109dfd77 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4964f0d/uploads/origins/b355aaf8-7db5-4424-b4f3-041c34bda642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=843ff132903c85ed7219bc4a5b30b753", "srcset": "https://si.imgix.net/b4964f0d/uploads/origins/b355aaf8-7db5-4424-b4f3-041c34bda642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=843ff132903c85ed7219bc4a5b30b753, https://si.imgix.net/b4964f0d/uploads/origins/b355aaf8-7db5-4424-b4f3-041c34bda642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=840971030de737d9da73931c1f4524d5 2x, https://si.imgix.net/b4964f0d/uploads/origins/b355aaf8-7db5-4424-b4f3-041c34bda642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=22423ecb30f5fe6ab4a6cd027f10bd9c 3x"}, "body": "お世話になります。\n初めて依頼をさせていただきます、こぐまきのと申します。\n普段はセルフ受肉Vtuberとして全てのイラストを自分で描いているのですが、生誕1周年の誕生日を機に沢山のクリエイター様に私の絵を描いてほしいと思い、連絡をさせていただきました。\n\n【依頼内容】\n・イラスト1点\nサイズ問いませんがXにアップするのでX映えするサイズがいいかもです\nカラー白黒問いません\nデフォルメ等身問いません\n背景有り無し問いません\nイラスト内にコメントを書き込んでいただくのも大歓迎です！\n⭐️以上のことを踏まえたイラストを、金額の範囲内でできる限り全体の印象が賑やかで明るい感じになるように制作いただきたいです。\n\n【用途】\nXとYouTubeの配信内での紹介、自慢。\n商用利用はいたしません。\n\n【要望】\n構図等指定はありませんが、明るく元気な感じでお願いします。\n全体のイメージの賑やかさを優先していただけると嬉しいです。その際金額の都合上線画や塗りがシンプルになってしまっても構いません。(寧ろ少ない金額での依頼で申し訳ないです)\n\n添付には活動がまとめてあるリンクと絵描きさんにお送りする詳細画像があります。\nご参考になればしていただくという程度で、基本的にクリエイター様の自由な発想を楽しんでおりますので、気楽な気持ちで描いて頂けたらと思います。\n以上のことを踏まえまして、もし可能であれば制作をお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Td0M1j9FvaZE8fkr5rpoUNWmI3OPex3h", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsukine122/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 36