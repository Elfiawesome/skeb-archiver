/uploads/origins/cdac130f-e825-4574-8fcc-949449cd5c67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca171a79298328893e616755d59e0e7b", "srcset": "https://si.imgix.net/42433e72/uploads/origins/cdac130f-e825-4574-8fcc-949449cd5c67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca171a79298328893e616755d59e0e7b, https://si.imgix.net/42433e72/uploads/origins/cdac130f-e825-4574-8fcc-949449cd5c67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc017dc2453b4ab4dd7f27951d25920b 2x, https://si.imgix.net/42433e72/uploads/origins/cdac130f-e825-4574-8fcc-949449cd5c67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a53378828dedf6bd0fd0265a6797c4a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42433e72/uploads/origins/cdac130f-e825-4574-8fcc-949449cd5c67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e94cc969ec50e173decff3df48bb7454", "srcset": "https://si.imgix.net/42433e72/uploads/origins/cdac130f-e825-4574-8fcc-949449cd5c67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e94cc969ec50e173decff3df48bb7454, https://si.imgix.net/42433e72/uploads/origins/cdac130f-e825-4574-8fcc-949449cd5c67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=01f49c1918be2e61d2b7ee27427efd7d 2x, https://si.imgix.net/42433e72/uploads/origins/cdac130f-e825-4574-8fcc-949449cd5c67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b5b154905b3c9d5432eec04476ed5bf5 3x"}, "body": "はじめまして！\n\nシチュエーション：\nサムライメイデンの玉織紬と伊夜がレズ集団に掴まれて下着の姿にされて足裏が見えるように拘束されてくすぐられて真っ赤顔して大爆笑している。\n\n玉織紬と伊夜の下着はセクシーな現代風でいいです。\n\n複数のモブ女の子たちが二人の全身をくすぐります。特に足裏、脇、乳房を重点的に。\n\n【差分希望】\n1. くすぐりの差分：羽根メインと手メインの2パターン\n2. 笑うの差分：我慢している表情と大爆笑している表情の２つの差分\n\n合計4パターン（羽根×我慢／大爆笑、手×我慢／大爆笑）でお願いします！\n\nセリフは自由に書いてください\n\nキャラ参考資料：\n玉織