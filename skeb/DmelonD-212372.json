e}, {"path": "/@DmelonD/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3804379, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4405f5ca/uploads/origins/f825a7a8-b2a2-49f4-b210-f29e0121a585?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeb19448a2f6f5803fc7159362fb6a55", "srcset": "https://si.imgix.net/4405f5ca/uploads/origins/f825a7a8-b2a2-49f4-b210-f29e0121a585?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeb19448a2f6f5803fc7159362fb6a55, https://si.imgix.net/4405f5ca/uploads/origins/f825a7a8-b2a2-49f4-b210-f29e0121a585?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41ab7228f214348bf51c83072ab5df4d 2x, https://si.imgix.net/4405f5ca/uploads/origins/f825a7a8-b2a2-49f4-b210-f29e0121a585?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6bcd4d2295953aa7d0f881c08727568b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4405f5ca/uploads/origins/f825a7a8-b2a2-49f4-b210-f29e0121a585?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac8b29ca80a784ed68e5f676900e1bfd", "srcset": "https://si.imgix.net/4405f5ca/uploads/origins/f825a7a8-b2a2-49f4-b210-f29e0121a585?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac8b29ca80a784ed68e5f676900e1bfd, https://si.imgix.net/4405f5ca/uploads/origins/f825a7a8-b2a2-49f4-b210-f29e0121a585?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e397f77bba36e878e5f338001f0c5c3a 2x, https://si.imgix.net/4405f5ca/uploads/origins/f825a7a8-b2a2-49f4-b210-f29e0121a585?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=60cd24d4d82f226f892af132ce25a9a5 3x"}, "body": "リクエスト失礼します！\n我が家の創作キャラである、チャイニーズマフィアのボス、白虎(バイフー)をお願いしたいのですが、可能でしょうか！\nルックスと性格を以下に……\n\n\n白虎/本名:梁 暗刻\n\n・チャイニーズマフィアのボス\n・身長169cm\n・絶世の美男で、中性的な妖艶さをもつ\n・頭脳派。感情を荒げることは少なく、常に余裕のある雰囲気\n・極度の甘党\n・バリネコで華奢な身体つき\n\n外見的特徴\n・赤い艶やかなロングヘア\n・前髪はセンター分けで外ハネ\n・切れ長の金色の瞳\n・陶器のようにきめ細かい白い肌\n・花弁のようなまろ眉\n・唇は薄めで自然な血色\n・左の頬に蛇のようなペイント\n・背中に刺青があるが、この刺青は暗号なので基本的に隠している\n\n装飾品\n・右耳に「西」の麻雀牌のピアス\n(※ここのマフィアの幹部は麻雀牌のアクセサリーを身に付けている)\n・ゆったりとした服を好む\n・アオザイ風の服をよく着ている\n\n口調\n・語尾に余韻を持たせた断定系\n・「〜だ」「〜だろう？」「〜じゃないか」\n・よく言うセリフ:「いいことを教えてやろう」\n\nこのキャラを作った当時はあまり意識してなかったのですが、今思うと結構マリクsのフレーバーが入っていた子です。(親に彫られた背中の刺青、特徴的な前髪、相手の煽り方etc)\n\n\n勿論無理のない範囲で！！お願いしたいです！！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 43569, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "りよ☕️", "screen_name": "Liyocafe", "avatar_url": "https://pbs.twimg.com/profile_images/2107868928580169728/Wu6U_VC_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/969535290636361728/1791357881/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 100191, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あおいまなぶ＠81パレ2_トリもち2参加", "screen_name": "aoimanabu", "avatar_url": "https://pbs.twimg.com/profile_images/892369513882058752/QFvUI5_9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/73653188/1586136206/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 605197, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "穴見呂 夢恵・Skeb受付中", "scre