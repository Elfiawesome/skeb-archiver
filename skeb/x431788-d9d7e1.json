ders/1k_8tCwPq5vkJZh9nfhS7m0Vxqgsqsnm8\n※服飾は資料に添付しましたが、特に指定は無いので、服飾の簡略化やアレンジ、 変更など自由にしていただいて大丈夫です。\n\n表情、ポーズなどの解釈、イラストの構図、背景、不明点も全てお任せ致します。\n\n▼【使用用途】\n・本イラストは個人利用に限定させていただきます。\n・SNSのアイコンへの使用や、個人鑑賞目的でのみ印刷させていただく場合があります。\n\n金額が足りない場合は、遠慮なく再送依頼をいただければと思います。\nまた、ご依頼内容が難しいと感じられた場合は、キャンセルしていただいても構いません。\n\nお忙しいところ恐縮ですが、ご検討いただけますと幸いです。\n何卒よろしくお願い申し上げます。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@x431788/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3574882, "client_id": 3316620, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c69e13a9/uploads/origins/fb4a5a04-11ef-43a4-b9b1-d7c5afa0bd0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=267d454ade9d941ec66087f16b00ba9f", "srcset": "https://si.imgix.net/c69e13a9/uploads/origins/fb4a5a04-11ef-43a4-b9b1-d7c5afa0bd0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=267d454ade9d941ec66087f16b00ba9f, https://si.imgix.net/c69e13a9/uploads/origins/fb4a5a04-11ef-43a4-b9b1-d7c5afa0bd0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9bb8b5cc0c8269f5df2ceae65c63d503 2x, https://si.imgix.net/c69e13a9/uploads/origins/fb4a5a04-11ef-43a4-b9b1-d7c5afa0bd0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2234a2f1783cf45976f5088533e0aa9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c69e13a9/uploads/origins/fb4a5a04-11ef-43a4-b9b1-d7c5afa0bd0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c88c2819e50ec06d145fba2b8ad1fcb", "srcset": "https://si.imgix.net/c69e13a9/uploads/origins/fb4a5a04-11ef-43a4-b9b1-d7c5afa0bd0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c88c2819e50ec06d145fba2b8ad1fcb, https://si.imgix.net/c69e13a9/uploads/origins/fb4