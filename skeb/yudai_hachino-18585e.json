せん。努力家ですがからかわれるとすぐに反応してしまうところもあり、他人や周囲の人たちをとても大切に思っています。\n\n植物や自然を成長させたり操ったりする魔法の力を持っています。趣味で花や果物を育てるのが大好きで、モンスターを攻撃するためにツタや棘を育てたりもします！ガーデニングも大好きで、ほとんどの時間を屋外で過ごしています！\n\n青い目の上に傷跡が一つあり、体中そばかすだらけです。 参考画像にあるどんな服装でもOKです！ 制服もありますが、普段着も着ています。\n\nテーマ：自然、エデンの園、リンゴ、蛇、愛、花、水仙、太陽／日差し、ウサギ、根\n\nどんな理由であれ、お断りいただいても全く構いません！ どうもありがとうございます！\n\nhttps://drive.google.com/drive/folders/1PbYdYWM-RgxtuFLOLTqWiE5Bhr0Rxr9f?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yudai_hachino/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1290570, "client_id": 352552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/27debc81/uploads/origins/8d8f9d84-adc0-4913-ad9a-801e1a8a52ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8194d757aa38cc843f196c066b546633", "srcset": "https://si.imgix.net/27debc81/uploads/origins/8d8f9d84-adc0-4913-ad9a-801e1a8a52ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8194d757aa38cc843f196c066b546633, https://si.imgix.net/27debc81/uploads/origins/8d8f9d84-adc0-4913-ad9a-801e1a8a52ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=125141817652679276d81fb28f091d08 2x, https://si.imgix.net/27debc81/uploads/origins/8d8f9d84-adc0-4913-ad9a-801e1a8a52ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=441cb70f0ca0feebf6ee82f183f8a1e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27debc81/uploads/origins/8d8f9d84-adc0-4913-ad9a-801e1a8a52ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f359446b86f3ff2e3ff3debbb9c3817d", "srcset": "https://si.imgix.net/27debc81/uploads/origins/8d8f9d84-adc0-4913-ad9a-801e1a8a52ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f359446b86f3