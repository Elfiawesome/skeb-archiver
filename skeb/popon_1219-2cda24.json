667c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9db6d56eda620cbcdf039635bd8662c1 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/056b3aad/uploads/origins/4d5aafc6-cc2c-4ecd-b98d-0163f614667c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a4b8b416b4c60a73a3200a037aa2809", "srcset": "https://si.imgix.net/056b3aad/uploads/origins/4d5aafc6-cc2c-4ecd-b98d-0163f614667c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a4b8b416b4c60a73a3200a037aa2809, https://si.imgix.net/056b3aad/uploads/origins/4d5aafc6-cc2c-4ecd-b98d-0163f614667c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0be6bd79e7c3430f743a65e5b9921b08 2x, https://si.imgix.net/056b3aad/uploads/origins/4d5aafc6-cc2c-4ecd-b98d-0163f614667c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ddea6700c5b602f28a3ce069ac5b5d2 3x"}, "body": "ピンクの虎です\n 茶色い柄のがっしりした体にお腹があります\n胸毛とひげ乳輪がたくさんあります\nソファーに座って眠る 気持ちよさそうに笑っています 口の端からよだれを垂らしています\n 汗びっしょりのベストを着て、下半身は着ていない\n片手でソファーに腰をかけている，もう一方の手は小動物を押さえている\nもう一匹の小さな動物は半勃起した肉棒と睾丸の間に押し込まれた\n太ももに脱ぎたての臭い靴下を並べている\n\nピンクのタイガー参考図1,2\n姿勢は図3を参照\nあとは自由に、匂いが強いほどいい\n\nhttps://drive.google.com/drive/folders/1XaLCHgKVmCut04xXhWJvPVhHU32kMHYQ?usp=sharing", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@popon_1219/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 494153, "client_id": 25394, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d2c9d546/uploads/origins/38f8d4dc-fd1e-4c97-b604-8b6caabea57d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3465295f7c933411573dc0e944671d6", "srcset": "https://si.imgix.net/d2c9d546/uploads/origins/38f8d4dc-fd1e-4c97-b604-8b6caabea57d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3465295f7c933411573dc0e944671d6, https://si.imgix.net/d2c9d546/uploads/origins/38f8d4dc-fd1e-4c97-b604-8b6caabea57d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d9e4e4ce99c2a60de062eb0b9500277 2x, https://si.imgix.net/d2c9d546/uploads/origins/38f8d4dc-fd1e-4c97-b604-8b6caabea57d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e412b9d6734ef536e9ed51c0fdbc703 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2c9d546/uploads/origins/38f8d4dc-fd1e-4c97-b604-8b6caabea57d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=901b498e4c24ac4bfe10acccd3764e35", "srcset": "https://si.imgix.net/d2c9d546/uploads/origins/38f8d4dc-fd1e-4c97-b604-8b6caabea57d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=901b498e4c24ac4bfe10acccd3764e35, https://si.imgix.net/d2c9d546/uploads/origins/38f8d4dc-fd1e-4c97-b604-8b6caabea57d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=485097a16f87d77c6b38e48ce3bab38f 2x, https://si.imgix.net/d2c9d546/uploads/origins/38f8d4dc-fd1e-4c97-b604-8b6caabea57d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=02ad1ce58cbe87b0a3f20ce922364bd0 3x"}, "body": "こんにちは。ﾇッポさんの作品いつも楽しく拝見させて頂いております。\n\nﾇッポさんの直近のサイズフェチイラスト達に大変感動したのでよければリクエストさせて下さい。\n『ワンコの躾方』のぽっちゃり虎おっさんが小人犬獣人をイジメる様子をお願いします。\n躾のためorお仕置きのため、ワンコを縮めて靴下に閉じ込めてニオイでわからせてやろうというイメージです。\n虎おっさんは何日も連履きした汚れて湿ったよれよれの黒靴下を汚いものを扱うように親指と人差し指の先でつまんで差し出し、あまりの激臭の為もう片方の手で自身の鼻を摘んでいます。鼻は摘んでいても、楽しそうに口角上げたニヤけた悪い笑顔は崩さずに見下ろしています。画面外から入り込んだ別のケモおっさんの手が補助役として小人犬を掴んでいて、差し出された黒靴下の中へ落とそうとしています。小人犬は涙を流しながら両手で自身の鼻を覆い靴下から立ち昇ってくる激臭に耐えています。喜んだり気を失ったりせず嫌がって抵抗の意思を見せている状態でお願いします。\n虎おっさんは元のデザインのまま作業着も黒インナーシャツも汗や汚れたっぷりで臭そうな雰囲気でお願いします。ソファにくつろぐように大股開きで座りつつ、靴下を脱いだ片方の素足は反対側の膝の上に乗せて足の裏が見える構図が好ましいです。\n足が普段からすこぶる蒸れる環境である事が伝わる愛用の汚れ地下足袋が付近に脱ぎ捨てられている、縮めたことで外れた首輪が付近に転がっている、等のにおわせ要素も可能であればお願いします。\nまた、NSFW指定で送信しますが陰茎は露出せず、汚れた下着に包まれているor作業着ズボンの中に窮屈そうに収まっている状態でお願いします。\n\nﾇッポさんの普段のかっこよさと臭さが両立した作風にいつもお世話になっておりますので安心して期待しお任せできます。\n負担にならぬよう可能な範囲で拾ってもらってのびのび描いて頂ければ幸いです。", "nc": 51, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@popon_1219/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 494153, "client_id": 30786, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/187204ba/uploads/origins/f8e37295-cae9-45ad-afb6-478a08b2716c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00ea0d0574eb95e5823cb8ae284b6e78", "srcset": "https://si.imgix.net/187204ba/uploads/origins/f8e37295-cae9-45ad-afb6-478a08b2716c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00ea0d0574eb95e5823cb8ae284b6e78, https://si.imgix.net/187204ba/uploads/origins/f8e37295-cae9-45ad-afb6-478a08b2716c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bdfe2d5446c2b48a37e90b90eeed5f08 2x, https://si.imgix.net/187204ba/uploads/origins/f8e37295-cae9-45ad-afb6-478a08b2716c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25522d352b913fd2588c6bffdb8d137a 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/187204ba/uploads/origins/f8e37295-cae9-45ad-afb6-478a08b2716c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfa5c6fcab1a6ce3acffbea7f4c92e27", "srcset": "https://si.imgix.net/187204ba/uploads/origins/f8e37295-cae9-45ad-afb6-478a08b2716c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfa5c6fcab1a6ce3acffbea7f4c92e27, https://si.imgix.net/187204ba/uploads/origins/f8e37295-cae9-45ad-afb6-478a08b2716c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=931b41c84102f872bacac38e1c53e8e9 2x, https://si.imgix.net/187204ba/uploads/origins/f8e37295-cae9-45ad-afb6-478a08b2716c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0614d7fcae1a14f3de88043b9e0c7894 3x"}, "body": "こんにちは、いつもいつもエッチな絵には大変お世話になっております。この前Skebで描かれていた絵が相当良すぎて、私も依頼したくなりました故……送信させていただきます🐼ちょうど手数料無料期間ですしね！\n\n◆依頼内容\n現場仕事をしている獣人のおっちゃんが休憩中に地下足袋ないしは安全靴を脱ぎ、汗で湿った靴下を外気に晒して乾かしながら一服している所の絵をお願いしたいです。あと私は足裏が見たいです。\n\n◆細かい状況や条件\n・種族は熊、猪、辺りだと嬉しいです。ちょっと描けないな……となったら狼で。それもなんかうまくいかなそうだな……となったら雄臭そうな獣人種で。\n\n・蒸らしたいので季節は夏とします。獣人にとって夏は地獄のような暑さでしょうから、そりゃもう滝のような汗を流しながら肉体労働をしているでしょうね。ええ。\n\n・靴下の色は白、黒、どちらでも良いです。どっちも好きです。かなり汚れていた方がありがたいです。……ってなると汚れが目立つ白……なのか……？？任せます(ニ回目)。先っちょが二つに分かれてるタイプが好きです。ちなみに家の洗濯機が壊れており、近くのコインランドリーで洗濯しないといけないので基本テロにならない程度に何日か使い回しています。本人は一週間(出勤日を考えたら5日)ぐらいなら大丈夫だと思っているらしい。\n\n・インナーシャツも白、黒、お任せします。つゆだくで。\n\n・獣人のおっちゃんが座って休憩しているその近くには、若現場作業員くんが隠れて見ているような状況です。なので今回は若現場作業員くんの視点で描いていただけたらと思います(私が獣人のおっちゃんを観察したいので)。ちなみにその若現場作業員は以前現場の飲み会でベロベロに酔っ払った獣人おっちゃんにお持ち帰りされて万年床に組み敷かれながら臭い責め交尾をされた経験があり、交尾の味と雄の濃厚なニオイを忘れられなくなって影で獣人おっちゃんをコッソリと見ています。\n\nつまるところ絵に映っているのは獣人のおっちゃんだけで、気配を察知したおっちゃんがこちらを見ながら靴下裏の汚れを見せて「……おら、なにコソコソ見てんだよ。そんな空気に漂ったオレのニオイなんて薄くて物足りねぇんだろ？この前みたくパンチの効いた雄のニオイが直に嗅ぎてぇんならこっちに来いや」と心の中で言いながらニヤついているのが良きです。\n\n・この設定はいるのかわかりませんが、細かく指示していただきたいとのことで……。獣人おっちゃんは現場作業員の中でもとりわけ体臭がキツめなので、他の現場作業員はみんな彼から離れた場所で休憩しているようです。体臭がキツいだけで仕事はかなりできる方なので、周りの獣人たちからは慕われています。みんな当たり前のように休憩時間になったら臭気テロから避難している中、若現場作業員くんがかなり近くで見ているわけですから当然すぐわかっちゃいますね……ふぅん……このあとどうなるんですかねぇ……。\n\n・髭ありで！！\n\n・とちらかというと肥満体型めが好きです。当然現場仕事なので筋肉はついているけど、腹はビール飲みまくった影響とかで若干出ている方が嬉しい。\n\n・汗による汚れも土による汚れも皮脂による汚れも全部大好物なので、好きなだけ汚してください。ニンニクマシマシアブラオオメカラメみたいなヤツで。食べたことないんですけど。というかこの呪文が正しいのかもよくわからないです。\n\n・汗拭きタオルも描いていただけたら私は嬉しくて発狂します。\n\n・めっちゃ細かいんですが、ヤカンにマズルを引っ付けて直飲みするタイプのおっちゃんが良いので、休憩して座ってるおっちゃんの近くにヤカンが欲しいです。……めっちゃマニアック！！でもヤカンを置くスペースがなかったりヤカン描くの苦手だったらなくてもいいです。使い古したヤツだと尚グッド……。\n\n・休憩時間なので、時刻は昼……かな。\n\n\n以上、もし気分が乗るようでしたらお受けしていただけますと幸いです。", "nc": 162, "word_count": 0, "transcoder": "image", "crea