crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40a5edcd176613962caea94b496b734c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1379302, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gamarenji/works/103", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1379302, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df05cb90/uploads/origins/e4db9019-f3a6-405e-a888-3fccf12660b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=809f3cbadbdbb08504cac470e25889bf", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df05cb90/uploads/origins/e4db9019-f3a6-405e-a888-3fccf12660b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e804462eda0e5a47ef4995dae7258d32", "src_set": ""}, "body": "がまれんじさんの描く、エロさ下品さ可愛さを兼ね備えたリゼ様が本当に大好きで、ちょうどリクエスト再開のタイミングに出会えたのでリクエストを送らせていただきました。\n　金額的にどこまで描いていただけるかわからないので、とりあえず希望を書くだけ書くので可能な範囲で拾っていただけると幸いです。\n\n・人物\nにじさんじ リゼ・ヘルエスタ\n\n・衣装\n公式の基本衣装からスカートだけを脱がされてパンツ丸出し(参考資料あり)\nボールギャグ(口を大きく開けさせる)と鼻フックをお願いしたいです\n\n・シチュ\nクーデターで政権を乗っ取られ、家族を人質に取られて逆賊の命令に従っている\n中腰ガニ股チン媚びヘコヘコダンスをさせられており、その一部始終が撮影されている\n\n・流れ\n①中腰ガニ股停止状態\n②ヘコヘコ開始\n③チン媚びセリフを言わされる(ボールギャグ着けたまま、ギャグ越しで上手く発音できないまま言わされる)\n④『何言ってるかわかんねえよ』などと難癖をつけられ尻を平手打ちで思いっきり叩かれる\n⑤『誰が休んでいいなんて言った？』『家族がどうなってもいいのかな？』などと脅され、涙と鼻水とよだれで顔をぐちゃぐちゃにしながら悔しさと恥ずかしさいっぱいの顔で再びチン媚びを繰り返す\n\n・表情\n心底悔しそう＆恥ずかしそう\n目に涙をためている\n\n・体型\n全体的に肉感強めのムチムチ\n胸を頭より少し小さいくらいのサイズに盛っていただけると幸いです\n\n・その他\nリゼ様以外のモブは画面内に写さなくて大丈夫です\n\n\n　以上です。ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1E0INHn-DX6GyvtOBkNPzx4Echw3kfQEN?usp=drive_link", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gamarenji/works/102", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/060cff73/uploads/origins/0dbfbae1-c69d-455f-98f1-70d0efb4a5d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4fb82e7c6482ca74c2f089c1868989e5", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1379302, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gamarenji/works/101", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1379302, "client_id": 165205, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c3404e6d/uploads/origins/cd28c997-bcba-459b-8f89-bf56ad414868?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=844986af5767a8a7ebec875a24558c51", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c3404e6d/uploads/origins/cd28c997-bcba-459b-8f89-bf56ad414868?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef9888247cd0bebef76875fb734baa23", "src_set": ""}, "body": "いつもお世話になっております。\n早速ですが、下記にリクエストを記載させていただきます。\n\n【キャラクター】\n・にじさんじ：西園チグサorフレン・E・ルスタリオorシスタークレア\n　-上記から一名選んでお描きください。\n\n【シチュエーション】\n・抵抗できないように腕と足を拘束され、ネチネチとクリと乳首を責められるシチュをお願いします。\n\n【要望】\n・責め役の性別は問いません。男女人外何でもOKです。\n・体位は責め役の膝の上に女の子が座っている体位でお願いします。\n　-女の子が足を閉じれないように、責め役の足と女の子の足を一緒に拘束して股を開かせてください。\n・服装は局部が露出していれば、他は先生の描きたい服装でOKです。全裸も可。\n・乳首はニップルドーム(URL参照)で責めてください。\n・クリは責め役の指で愛液を塗りたくるようなイメージで責めてください。\n　-クリはワイプなどでクローズアップしていただけると嬉しいです。\n・その他先生が追加したい要素などあ