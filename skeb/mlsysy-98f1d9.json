る。医療専門家で、他の人々の世話をしている。クラシック音楽と芸術が好き。\n[参考画像】：https://toyhou.se/6852579.larkin/gallery\n\nフレッチャー（175cm）：フレッチャーは \"黄金泥棒 \"として知られる悪名高い引退した泥棒。とてもチャーミングでカリスマ性がある！目立ちたがり屋。とても子供っぽいところもある。自然をモチーフにした黄金の魔法を持っている。バイオリンを弾く。\n[参考画像】：https://toyhou.se/6853539.fletcher/gallery\n\nお好きなように描いていただいて結構です！キャラの追加もお気軽にどうぞ。ご検討よろしくお願いします😊。\n\nhttps://toyhou.se/MelodyElodie/characters/folder:1323060", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mlsysy/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3122627, "client_id": 2809668, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c83ed238/uploads/origins/dc610a97-693c-49ef-bf52-4424e00f0fd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64b029e40b5eccf14e549b7a4e492eee", "srcset": "https://si.imgix.net/c83ed238/uploads/origins/dc610a97-693c-49ef-bf52-4424e00f0fd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64b029e40b5eccf14e549b7a4e492eee, https://si.imgix.net/c83ed238/uploads/origins/dc610a97-693c-49ef-bf52-4424e00f0fd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93502c942779bf7791ddd51240c7405c 2x, https://si.imgix.net/c83ed238/uploads/origins/dc610a97-693c-49ef-bf52-4424e00f0fd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=547b23e6d00036a03d3a68940d1ab8ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c83ed238/uploads/origins/dc610a97-693c-49ef-bf52-4424e00f0fd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2488b70c58ed8a5770ea7de67f857fbc", "srcset": "https://si.imgix.net/c83ed238/uploads/origins/dc610a97-693c-49ef-bf52-4424e00f0fd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2488b70c58ed8a5770ea7de67f857fbc, https://si.imgix.net/