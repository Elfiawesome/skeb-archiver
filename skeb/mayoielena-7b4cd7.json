フォルメキャラも見てみたいです。\n\n・納品形式はお任せいたします\nサイズは16:9の比率だと嬉しいです\n\n長くなってしまいましたが、お目通しいただきありがとうございます。\nご検討のほどよろしくお願いいたします。\n\n未宵エレナTwitter：https://twitter.com/mayoielena\n\nhttps://drive.google.com/drive/folders/1-24eKDJ8oLHMCOI9gx6pP2VhPFhAA20U", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amaguri_ya88/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1931863, "client_id": 446602, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8048f8d5/uploads/origins/27f9e378-ea21-44fb-b3c5-97fc6cdbf8df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=034705f8ab3b390887b04462b7971bcb", "srcset": "https://si.imgix.net/8048f8d5/uploads/origins/27f9e378-ea21-44fb-b3c5-97fc6cdbf8df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=034705f8ab3b390887b04462b7971bcb, https://si.imgix.net/8048f8d5/uploads/origins/27f9e378-ea21-44fb-b3c5-97fc6cdbf8df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=163ddbbed59a3b7ae758b6e3d37bb38a 2x, https://si.imgix.net/8048f8d5/uploads/origins/27f9e378-ea21-44fb-b3c5-97fc6cdbf8df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc83568d436e45b479187e6473ac682a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8048f8d5/uploads/origins/27f9e378-ea21-44fb-b3c5-97fc6cdbf8df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af119376ccb4c78edce6948e54fe3328", "srcset": "https://si.imgix.net/8048f8d5/uploads/origins/27f9e378-ea21-44fb-b3c5-97fc6cdbf8df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af119376ccb4c78edce6948e54fe3328, https://si.imgix.net/8048f8d5/uploads/origins/27f9e378-ea21-44fb-b3c5-97fc6cdbf8df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=20