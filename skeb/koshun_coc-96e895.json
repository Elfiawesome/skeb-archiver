-b3ca-a4192451b81b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3dac89225c85e7af416f28599c7bdd1, https://si.imgix.net/8d0815cc/uploads/origins/0c19bd95-4373-43c5-b3ca-a4192451b81b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9a20c7b08afc84d2f713cad6e872ec72 2x, https://si.imgix.net/8d0815cc/uploads/origins/0c19bd95-4373-43c5-b3ca-a4192451b81b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aba03f30612db9e43297ac9f530ea7b1 3x"}, "body": "あんどう様\n\n\nはじめまして、楽しくシナリオを遊ばせて頂いております！\n楽しい作品をありがとうございます！\n\n【自探索者の概念ミニキャラ】を描いて頂きたくリクエストを送らせて頂きました。\nそれぞれ重継続している双子の兄弟になります。\n\n・兄の方\n首が隠れるくらいの短髪、少し濃いめの銀色（藍色寄り）\nゴーグルをかけてる　好奇心旺盛な冒険少年気質\n\n・弟の方\n長髪ポニテ、兄より薄めの銀色（空色寄り）\n医者　諦念がち冷静寄りで人を尊重する気質\n\n目の色はイラストはぶれがちなのですが、兄弟共にピンク～赤～紫の辺りのカラーです。\n資料URLに各差分を配置しましたが、「01_~」なファイル名のものが基本的な見た目と思って頂ければです。\nイメージ動物などは特にないので、あんどうさんのイメージで描いていただければ幸いです！ご検討宜しくお願い致します。\n\nまた、個人観賞、ココフォリアのコマやSNS・Discordのアイコンなどに使用の用途で考えております。\n\n\n今後もあんどうさんの作品を遊ぶ予定があるのでとても楽しみにしています。\n体調崩しやすい天気が続いていますがどうぞご自愛ください！あんどうさんの創作活動を応援しております！\n\nhttps://drive.google.com/drive/folders/1B3BfXnnF9tFvvwwUSolBH5mNGLPyXjBD", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akuta_ku/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1225761, "client_id": 1344100, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53b701de/uploads/origins/a8d30812-d937-4de3-9276-fc73b05946c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af5a70b8e024c4a3a129702cc4ddb709", "srcset": "https://si.imgix.net/53b701de/uploads/origins/a8d30812-d937-4de3-9276-fc73b05946c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af5a70b8e024c4a3a129702cc4ddb709, https://si.imgix.net/53b701de/uploads/origins/a8d30812-d937-4de3-9276-fc73b05946c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bda8a1096bcf6240b21d7bd0449c6401 2x, https://si.imgix.net/53b701de/uploads/origins/a8d30812-d937-4de3-9276-fc73b05946c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92eb7dc9c85bd5e76ddf0b8062537527 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53b701de/uploads/origins/a8d30812-d937-4de3-9276-fc73b05946c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34342403280916cb2203e021488a06b3", "srcset": "https://si.imgix.net/53b701de/uploads/origins/a8d30812-d937-4de3-9276-fc73b05946c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34342403280916cb2203e021488a06b3, https://si.imgix.net/53b701de/uploads/origins/a8d30812-d937-4de3-9276-fc73b05946c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d06cf230fe63eb5c3b8f075c344b9e60 2x, https://si.imgix.net/53b701de/uploads/origins/a8d30812-d937-4de3-9276-fc73b05946c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa8abd117f77d4396e6af5334967c4bd 3x"}, "body": "はじめまして！\nジャンル問わずあくたさんのイラストのファンです。TRPGでもたくさん見ることが出来て日頃嬉しく思っています…！！\n\n\n以下、Skeb依頼内容となります。\n\n◆自探索者のイラスト\n・名：綾瀬月灯\n青みがかった銀髪、赤紫色の目\n26歳　167cm　APP13　医者　双子の弟\n\n・参考資料：https://drive.google.com/drive/folders/1ldxrQ0TPIlWgDCoCvXFjEIqQCpThVUtZ?usp=drive_link\n・通過シナリオツリー：https://twitter.com/koshun_coc/status/1724793827066851383\n（新立ち絵はディスプレイの黒パーカーver、卓報告の青パーカーverありますがどちら採用でもかまいません）\n\n\n『人類讃歌』出身、『ジュンカントレンサ』『カプラの灯明』『無敵の瞳』『戯曲グラスバレヱ』『deEpy*』、そして先日『阿頼耶識の彼方より』でHO賢者としてエンドEXに行った探索者です。\n\n構図等お任せ致しますが、特に『人類讃歌』『戯曲グラスバレヱ』を越えてきた探索者…といった辺りを仄かに感じられるイラストだと嬉しいです。\nあまりにもニュアンス過ぎる希望で申し訳ないのですが、阿頼耶識通過を見守ってくださっていた気配がしたあくたさんに是非…と思った次第です。\nご無理のない範囲でお願いできればと思います…！\n\n\nご検討頂けますと幸いです。よろしくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_kari_ume/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1230904, "client_id": 1344100, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76464347/uploads/origins/7b5b1bbf-b280-4bdf-bc70-adc221636932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ebd6aba5ceaf4ec48f489cf7d443ce5", "srcset": "https://si.imgix.net/76464347/uploads/origins/7b5b1bbf-b280-4bdf-bc70-adc221636932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ebd6aba5ceaf4ec48f489cf7d443ce5, https://si.imgix.net/76464347/uploads/origins/7b5b1bbf-b280-4bdf-bc70-adc221636932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a5b73b5cf8517368c2cc12c8bcb1211 2x, https://si.imgix.net/76464347/uploads/origins/7b5b1bbf-b280-4bdf-bc70-adc221636932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6e7051ac479421ddae83bec88d28b33 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76464347/uploads/origins/7b5b1bbf-b280-4bdf-bc70-adc221636932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=798fc7a1963707b6d821d25c21f478ec", "srcset": "https://si.imgix.net/76464347/uploads/origins/7b5b1bbf-b280-4bdf-bc70-adc221636932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=798fc7a1963707b6d821d25c21f478ec, https://si.imgix.net/76464347/uploads/origins/7b5b1bbf-b280-4bdf-bc70-adc221636932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d879579c0730461ba17f97aa331770b4 2x, https://si.imgix.net/76464347/uploads/origins/7b5b1bbf-b280-4bdf-bc70-adc221636932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c212175d84cc963b0a763888c649e459 3x"}, "body": "こんにちは！とっっっっっっってもお世話になっております！！！\n\nKPして頂いた阿頼耶識の彼方よりの探索者2人をお願いしたいです、構図(ネタバレシチュなども)等すべてお任せします。\n