大丈夫です\n・胸中央と左胸部分にある2XUの文字、右腰部分の大きなスーツ名(P:2 PROPEL)の記載をお願いします\n\n【体位やその他】\n・男達はペニスだけの様な最小限の表現で大丈夫です。\n・着ているスーツの乳首と股間部分をハート穴型にカットされ、乳首とペニスを露出。\n・アナル部分のスーツも破かれ、男のペニスが挿入されている。\n・表情は情けないアヘトロ顔。\n・体やスーツ上に卑猥なマークや言葉の落書きをされ肉便器化。\n・スーツの胸の部分から乳首上にかけ、四角枠落書きの中に「平野真澄」と名前が書かれた\n（ゼッケンのような）落書きをお願いします。\n・落書きのオンオブが出来る様、レイヤー分けして頂けますと幸いです\n\n長々と設定を書かせて頂きましたが、やり易いようにアレンジして頂いて大丈夫です\n何卒ご検討のほど宜しくお願いします。\n\n他絵師様にご依頼させて頂いた参考イラストです\nhttps://x.com/ail_leotard/status/1842722788156817570\n\nhttps://www.pixiv.net/tags/%E3%83%88%E3%83%A9%E3%82%A4%E3%82%A2%E3%82%B9%E3%83%AD%E3%83%B3%E3%82%B9%E3%83%BC%E3%83%84/artworks", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nabetabetaiz/works/61", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2953544, "client_id": 46499, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81c88ada/uploads/origins/0740cb67-c69a-415c-92fe-480db171e4b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ac75128d4108caa06684f70a7d4b074", "srcset": "https://si.imgix.net/81c88ada/uploads/origins/0740cb67-c69a-415c-92fe-480db171e4b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ac75128d4108caa06684f70a7d4b074, https://si.imgix.net/81c88ada/uploads/origins/0740cb67-c69a-415c-92fe-480db171e4b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f610c81999571377eb9f70df3cc4c66 2x, https://si.imgix.net/81c88ada/uploads/origins/0740cb67-c69a-415c-92fe-480db171e4b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff59562ee98c43fb92c11dc6b4149b75 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81c88ada/uploads/origins/0740cb67-c69a-415c-92fe-480db171e4b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a023292cf985d800d2c47cafc2d6fa09", "srcset": "http