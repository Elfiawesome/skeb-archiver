す。詳しくは写真集をご覧ください。\n\nキーワード\n早朝の地下鉄・路面電車\nキーワードに沿って自由に描いてください。\n\nちつこさんが私のリクエストを受け入れてくれることを願っています。不適切だと感じた場合は、この依頼をキャンセルしても構いません。ありがとうございました。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@chiduk0/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/62d0e568/uploads/origins/4a48f2c6-c563-4d44-b52f-11be95ae6482?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a69e4cff2f05c60bfba6d9d0636ee23", "srcset": "https://si.imgix.net/62d0e568/uploads/origins/4a48f2c6-c563-4d44-b52f-11be95ae6482?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a69e4cff2f05c60bfba6d9d0636ee23, https://si.imgix.net/62d0e568/uploads/origins/4a48f2c6-c563-4d44-b52f-11be95ae6482?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99a64d1bbae1cb84b27e3fbddfb9c223 2x, https://si.imgix.net/62d0e568/uploads/origins/4a48f2c6-c563-4d44-b52f-11be95ae6482?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05ba845056d219166b235f4638adaf92 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 789047, "nc": 129}, {"path": "/@chiduk0/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4da1f578/uploads/origins/5097b5a0-a4a3-4b74-8271-8b4dc784111b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7909997b25abf33ea8d3e2907847a3e3", "srcset": "https://si.imgix.net/4da1f578/uploads/origins/5097b5a0-a4a3-4b74-8271-8b4dc784