.net/5192a248/uploads/origins/6819f8e7-5c01-4468-823b-a6051f2c5eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=946bd4fffb62557dcb9b3279abe27cef 2x, https://si.imgix.net/5192a248/uploads/origins/6819f8e7-5c01-4468-823b-a6051f2c5eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13cf9473dad8b818cd9151d3d981686b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5192a248/uploads/origins/6819f8e7-5c01-4468-823b-a6051f2c5eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbb43681da31b52cc6d7a7a3aa47c115", "srcset": "https://si.imgix.net/5192a248/uploads/origins/6819f8e7-5c01-4468-823b-a6051f2c5eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbb43681da31b52cc6d7a7a3aa47c115, https://si.imgix.net/5192a248/uploads/origins/6819f8e7-5c01-4468-823b-a6051f2c5eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b379857e114c9f93c70c4c996a7edc50 2x, https://si.imgix.net/5192a248/uploads/origins/6819f8e7-5c01-4468-823b-a6051f2c5eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2ec374c916063ea1c03f52795c6f7660 3x"}, "body": "はじめましてこんにちは！\n以前より豊かなキャラの表情や光の当たり方、写真のようにワンシーンを切り取ったイラストが素敵でいつも拝見しております。そのためぜひちづこ様にTRPGキャラクターを描いて頂けたらと思い、今回リクエストさせて頂きました！\n\n【詳細】\n警察のような特殊な部署の同僚です。仕事内容的に夜に活動することが多いです。また戦闘などの荒事も多い部署になっています。\n男性1と2、女性と少女がバディを組んでいます。男性1が後輩で女性が先輩、また少女が後輩で男性2が先輩であり、それぞれ教育係でもあります。\n夜のビル街を仕事終わりな4人がわいわい歩いているようなワンシーンを描いて頂けると嬉しく思います。細かい構図についてはお任せとさせて頂きたいです。\n４人という大人数ではありますが、何卒ご検討お願いいたします。\n\n・男性1\n178cm 31歳\n物静かで苦労人。周りのわがままに振り回される側ですが本人もなかなかいい性格をしている。\n・男性2\n202cm+10cmヒール 27歳\nノリが良くおちゃらけているが意外と人の機微を気づく気遣い屋さん。距離感が近い。\n・女性\n157cm 28歳\nあらあらうふふな世話焼きお姉さん。たまにドジっ子。注意はするけど暴走は止めない。\n・少女\n149cm 年齢不詳\n幼稚園児並に元気で好奇心旺盛に走り回る。自分はかわいいからみんな自分を大好きだと思ってる。\n\nhttps://drive.google.com/drive/folders/1cHLk_9jP0IgI8raKivasfmlTiUgh74Fz?usp=sharing", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@chiduk0/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 789047, "client_id": 1312229, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1337ced6/uploads/origins/aa2d5533-853f-4d79-8da6-dffcd03a5c88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e87d1a63259f07d6dc286eee7f0f732", "srcset": "https://si.imgix.net/1337ced6/uploads/origins/aa2d5533-853f-4d79-8da6-dffcd03a5c88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e87d1a63259f07d6dc286eee7f0f732, https://si.imgix.net/1337ced6/uploads/origins/aa2d5533-853f-4d79-8da6-dffcd03a5c88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a325b82dcf3e5fed8ba91f43c43c55fe 2x, https://si.imgix.net/1337ced6/uploads/origins/aa2d5533-853f-4d79-8da6-dffcd03a5c88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7577891a1fbe7c8586799a9345a1b0b1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1337ced6/uploads/origins/aa2d5533-853f-4d79-8da6-dffcd03a5c88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6e30ea2656a6f0db63f3b88f5cec97a", "srcset": "https://si.imgix.net/1337ced6/uploads/origins/aa2d5533-853f-4d79-8da6-dffcd03a5c88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6e30ea2656a6f0db63f3b88f5cec97a, https://si.imgix.net/1337ced6/uploads/origins/aa2d5533-853f-4d79-8da6-dffcd03a5c88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dfeb00ba084f9137d3f95ff98282e189 2x, https://si.imgix.net/1337ced6/uploads/origins/aa2d5533-853f-4d79-8da6-dffcd03a5c88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ce6520976f5244113cc01a8212adc5e3 3x"}, "body": "先生初めまして！先生の作品が大好きです。よろしければオリキャラたちのイラストを頼みたいです。具体的にはURL参照してください。 \n\n彼ら6人は犯罪者、そして同じ組織に属する仲間です（COCシナリオ かいぶつたちとマホラカルト の PCとNPCです）。 \n\n狼︰リーダー、事を荒立てない潜入･隠密行動役（創設当時のメンバー） \n悪魔︰人脈が広い、戦闘役（創設当時のメンバー） \n幽霊︰情報管理などの参謀（創設当時のメンバー） \n魔女︰ハッキング等の電子機器を用いた諜報活動（創設当時のメンバー） \n鬼︰荒事への対応、戦闘役 \n天使︰怪我の治療役 \n\nみんなが一緒に基地てのんびりの日常生活シーンがみたいです！\n\n服のデザイン、アレンジ等は全てお任せしたいです。\n私の依頼を読んでいただき、ありがとうございました。\n\nhttps://drive.google.com/folderview?id=1OebL5AqN1ZNnZyTZQjcOO7nqeXVomw8U", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@chiduk0/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/650a1195/uploads/origins/50a55e0c-1ca2-4336-9793-b43e4a736228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8869fda87886356ddea78eda178fa96b", "srcset": "https://si.imgix.net/650a1195/uploads/origins/50a55e0c-1ca2-4336-9793-b43e4a736228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8869fda87886356ddea78eda178fa96b, https://si.imgix.net/650a1195/uploads/origins/50a55e0c-1ca2-4336-9793-b43e4a736228?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e90f27f643eec4c65c916520eacbe03b 2x, https://si.imgix.net/650a1195/uploads/origins/50a55e0c-1ca2-4336-9793-b43e4a736228?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d88b91239df22f550ceaf7c6e07a6510 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 789047, "client_id": 225716, "nc": 0}, {"path": "/@chiduk0/works/12", "private_thumbnail_image_urls": null, 