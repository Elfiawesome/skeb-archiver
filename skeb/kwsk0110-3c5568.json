薬研くんと厚くんが布団の上で四つん這いになり、審神者が片手を厚くんの尻を掴み、バックから厚くんに挿入して腰を振りつつ、もう一方の手で、薬研くんの尻尾型極太アナルビーズを掴んで引っぱり出そうとしている\n薬研くんはなんとか両手で身体を支えて踏ん張っているが、厚くんは快楽に腰砕けになり、両手から力が抜け、頭が下がり顎を布団に付けている\n\n今回も指定が細かく申し訳ございません。ぜひよろしくお願いいたします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kwsk0110/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 537283, "client_id": 52320, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47dc6b41/uploads/origins/fa01a432-d884-4629-9af8-dfa4bc04bcc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e44f75d01b347f5647d69ebdce9e1dfc", "srcset": "https://si.imgix.net/47dc6b41/uploads/origins/fa01a432-d884-4629-9af8-dfa4bc04bcc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e44f75d01b347f5647d69ebdce9e1dfc, https://si.imgix.net/47dc6b41/uploads/origins/fa01a432-d884-4629-9af8-dfa4bc04bcc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fab7d9e57574edea6055f0e4b69d841e 2x, https://si.imgix.net/47dc6b41/uploads/origins/fa01a432-d884-4629-9af8-dfa4bc04bcc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d046e3d15dfd4cdc16e95edd8aa97d58 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47dc6b41/uploads/origins/fa01a432-d884-4629-9af8-dfa4bc04bcc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e63b91680ab3cda2cd864e018839242", "srcset": "https://si.imgix.net/47dc6b41/uploads/origins/fa01a432-d884-4629-9af8-dfa4bc04bcc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e63b91680ab3cda2cd864e018839242, https://si.imgix.net/47dc6b41/uploads/origins/fa01a432-d884-4629-9af8-dfa4bc04bcc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dcc2ebd54887fb829f744ea60