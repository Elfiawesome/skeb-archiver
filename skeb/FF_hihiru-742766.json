ads/origins/77266efe-ddec-4232-8a39-e4fc60815654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b56f0b7dd2f684d6a86117f838a7cabe", "srcset": "https://si.imgix.net/5ab27063/uploads/origins/77266efe-ddec-4232-8a39-e4fc60815654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b56f0b7dd2f684d6a86117f838a7cabe, https://si.imgix.net/5ab27063/uploads/origins/77266efe-ddec-4232-8a39-e4fc60815654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e75219972f370da38beeb3118155581e 2x, https://si.imgix.net/5ab27063/uploads/origins/77266efe-ddec-4232-8a39-e4fc60815654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eada6ff8e24c3d8d147ce5936dcce0f7 3x"}, "body": "ぶっかけ戦隊いつも楽しく拝見しております。\n\nまだ物語には登場していないキャラクターなのですが、タイニーのイラストをお願いします。\n\nシチュエーションはレッドを束縛してイジメてるのを希望です。タイニーちゃんのキャラクターがわかるようなイラストだと嬉しいです。\n\nよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FF_hihiru/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1451079, "client_id": 2799246, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/030d7dc6/uploads/origins/8887c82d-8444-482e-8aff-27088847ac06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e2617be8bbe6b8d765b299a97bd0479", "srcset": "https://si.imgix.net/030d7dc6/uploads/origins/8887c82d-8444-482e-8aff-27088847ac06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e2617be8bbe6b8d765b299a97bd0479, https://si.imgix.net/030d7dc6/uploads/origins/8887c82d-8444-482e-8aff-27088847ac06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5baa3d2fc55845822454b12dd0b1636d 2x, https://si.imgix.net/030d7dc6/uploads/origins/8887c82d-8444-482e-8aff-27088847ac06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32b57b0f9ce4ad65f62225dbb505a80f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/030d7dc6/uploads/origins/8887c82d-8444-482e-8aff-27088847ac06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fff03aaad997b9f67be5e51f83f903e3", "srcset": "https://si.imgix.net/030d7dc6/uploads/origins/8887c82d-8444-482e-8aff-27088847ac06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fff03aaad997b9f67be5e51f83f903e3, https://si.imgix.net/030d7dc6/uploads/origins/8887c82d-8444-482e-8aff-27088847ac06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=15f8ba9901402d43c17b51ef5391078f 2x, https://si.imgix.net/030d7dc6/uploads/origins/8887c82d-8444-482e-8aff-27088847ac06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=12803322c31bacf3d1a54cd5b474e890 3x"}, "body": "ぶっかけ戦隊サブキャラのエミとトモ子が同級生の男子をいじめる話を描いてほしいです。\n同級生の男子のキャラデザは可愛い系の男の子。\n服装は3人共体操着でエミとトモ子はスパッツ、同級生の男子はショートパンツ。\n\n男子が倉庫でエミとトモ子に壁に追い詰められて、手で股間を隠しながらモジモジしてる。\nエミは男子と幼馴染で男子がスパッツフェチなのを知っている。\nエミは男子が自分たちのスパッツ姿で勃起してしまっているのをわかっていて、笑い物にしてる。\n男子はショートパンツで勃起が隠しきれず、恥ずかしさで涙目になる。\nエミとトモ子は勃起してる男子をいじめ始める。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FF_hihiru/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1451079, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ccbd2e6c/uploads/origins/553370ab-170f-48ad-ab25-9146a534a49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe29d96ac91bbb8eb3941c33a7fc8691", "srcset": "https://si.imgix.net/ccbd2e6c/uploads/origins/553370ab-170f-48ad-ab25-9146a534a49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe29d96ac91bbb8eb3941c33a7fc8691, https://si.imgix.net/ccbd2e6c/uploads/origins/553370ab-170f-48ad-ab25-9146a534a49f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1690a3483eae566d3b9015133d7354b 2x, https://si.imgix.net/ccbd2e6c/uploads/origins/553370ab-170f-48ad-ab25-9146a534a49f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=124d6ee133f3ea12a6140f95087c86a3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ccbd2e6c/uploads/origins/553370ab-170f-48ad-ab25-9146a534a49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d168022ef7f245c2983f68d292885fb", "srcset": "https://si.imgix.net/ccbd2e6c/uploads/origins/553370ab-170f-48ad-ab25-9146a534a49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d168022ef7f245c2983f68d292885fb, https://si.imgix.net/ccbd2e6c/uploads/origins/553370ab-170f-48ad-ab25-9146a534a49f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=710a3c915890b3a9386e5c963bdf2e38 2x, https://si.imgix.net/ccbd2e6c/uploads/origins/553370ab-170f-48ad-ab25-9146a534a49f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=06407da569617cd6691687728e6cc958 3x"}, "body": "パジャマ姿の小学生の男の子が、親戚の前でフルチンにされる絵をお願いします。\n\n親戚に他に男の子が居ないから、母親がサービスでおばさん達や女の子に見せてあげるという物語です。\n\n男の子が正面に立っており、母親が側に座っている。\n親戚は手前に座って見ている。（フキダシのみの登場でも構いません）\n\n以下を差分でお願いします。\n\n①服を脱ぐ前。\n恥ずかしいけれど母親が脱ぐ様に言ってくるし、親戚が楽しみに待っている。\n\n②ズボンとパンツを脱いでいる。\n親戚が口々に感想を語り合う。\n\n③勃起してしまう。\n女の子は驚き、おばさん達は笑って、母親も笑いながら男の子にエッチだと叱る。（自分らの行いは棚に上げて）", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FF_hihiru/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1451079, "client_id": 45397, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f5ee483/uploads/origins/d73bc44d-b1cb-4197-9fa1-b3920c9d4a69?bg=%23fff&auto=fo