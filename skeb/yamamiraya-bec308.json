少し圧倒されている。\n典型的な犬（F）と猫（L)の関係だ（？）\n体格や肌色差がある。\n\n(Lにはロングヘアとショートヘアの両方がある。 ここに描かれている時代は長髪の方なので、長髪の方を描いてください！この頃、2人はまだとても仲が良かった。)\n\n▼内容など：\n日常的なシーンが見たい。 例えば、最初はダンスが上手くないFとLが、ステップを覚えるために社交ダンスをする。あるいは、気にしないのであれば、浴衣を着せて現代の日本で花火大会を見ることもできる。（？）\n服のデザインは自由に変えることができます。ポーズや表情も自由です。\n\n没ラフや下描きなどがあれば残したままにしていただけると嬉しいです。\n私の依頼を考慮していただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1-AfHj70g0tkUTp9DwRLiRT2QZLNz5Tcc?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamamiraya/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2800807, "client_id": 2563390, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f10d61f/uploads/origins/140a8773-5ee3-4f7d-9c75-df7c3d122d8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27a40c9b6bc3495b1016c0e1b47b1616", "srcset": "https://si.imgix.net/1f10d61f/uploads/origins/140a8773-5ee3-4f7d-9c75-df7c3d122d8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27a40c9b6bc3495b1016c0e1b47b1616, https://si.imgix.net/1f10d61f/uploads/origins/140a8773-5ee3-4f7d-9c75-df7c3d122d8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36c98a207ef732e1f4db3b051914634d 2x, https://si.imgix.net/1f10d61f/uploads/origins/140a8773-5ee3-4f7d-9c75-df7c3d122d8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=825ce4b971793037a5fad986c5d4fef5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f10d61f/uploads/origins/140a8773-5ee3-4f7d-9c75-df7c3d122d8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e1356fa36cd95e1b2a3ef04feb51ca2", "srcset": "https://si.imgix.net/1f10d61f/uploads/origins/140a8773-5ee3-4f7d-9c75-df7c3d122d8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e135