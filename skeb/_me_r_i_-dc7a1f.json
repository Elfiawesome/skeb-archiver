9b2-f6c8-4a42-8f8d-6801d60606ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8b053dd501fc401fb74ec126bd29195, https://si.imgix.net/16d0328c/uploads/origins/fe15c9b2-f6c8-4a42-8f8d-6801d60606ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=43ecd8f40fbe4ef8a46be7277b0f6847 2x, https://si.imgix.net/16d0328c/uploads/origins/fe15c9b2-f6c8-4a42-8f8d-6801d60606ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=677d7bc0aec59f59008572b3499d0207 3x"}, "body": "richi様\n\n初めまして、個人Vtuberの青藍めいと申します。\n過去イラストの可愛らしくふんわり柔らかい女の子たちが素敵でしたので、是非私も描いていただければと思いリクエスト失礼します。\n\nリクエスト内容：青藍めい のイラスト\n\n使用用途：収益済みチャンネルでの配信活動(サムネイル、歌みた含む動画コンテンツ内での利用)、SNS利用(アイコンや投稿)、グッズなどを予定しています。\n\n詳細：髪は薄紫～毛先に掛けて青み掛かっています。虹彩が4角の星型(?)と特徴的です。\n\n表情、ポーズ、構図などお任せします。\n\n帽子の有無や、衣装・髪型のアレンジなど自由に描いて頂いて問題ありません。\n(enel様リクエストのツンデレっぽい表情でお願いしようか悩みましたが、どのイラストも可愛く決められなかったのでrichi様の解釈で描いて頂けましたら嬉しいです。)\n\nまた、人物や髪が見切れないようにしていただけますと嬉しいです。\n\n性格：森の奥で引きこもっている見習い魔女(2000歳超え↑)です。\n快活で明るくおしゃべりが好きですが、うっかりしている事ややる気が空回りすることが多くPON(魔法薬の爆破)が多いです。本人はインテリジェンスでミステリアスクールビューティーなお姉さんを自称しています。\n\n内容や金額に不備がございましたらお手数ですが再送頂けますと幸いです。\nご多忙の中、恐縮ですがご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1FpacYCGAeak85q1XyS0_wvbwtABES_Cp?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_me_r_i_/works/20", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ad3e7a00/uploads/origins/1648e447-f8ea-41e7-917a-641e68765e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3373b4efc8bd5bc1ab62696f1e1e0efb", "srcset": "https://si.imgix.net/ad3e7a00/uploads/origins/1648e447-f8ea-41e7-917a-641e68765e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=P