庭だ、そこにはガラスの棺が置かれている。イメージソング：she’s purity/凋叶棕 \n\n市長は忠実な助手を道具のように扱い、人形のように弄びながらも、👓がも目を覚ますまで常にその傍らに寄り添い、二人だけの空間（ガラスの棺の部屋）で優しく世話を焼く。もしも最愛の👓に危害が及んだなら、翌日までにその原因を確実に始末するだろう。 \n\n内容不備や金額が不足している場合は、アピールをお送りください。没ラフや下描きなどがあればPSDに残したままにしていただけると嬉しいです。長いお願いをお読みいただき、またご検討いただきありがとうございます。\n\nhttps://drive.google.com/drive/folders/1Vz9VJgbr_KRfxzL-UUaPkFHFz-kA_p9j?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mgr_palelight/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3185046, "client_id": 2555291, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0cba67b8/uploads/origins/cc6675db-4e5f-406e-885a-2af6e63d0835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51ee1281bc5414662e7b8426c9e7bed7", "srcset": "https://si.imgix.net/0cba67b8/uploads/origins/cc6675db-4e5f-406e-885a-2af6e63d0835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51ee1281bc5414662e7b8426c9e7bed7, https://si.imgix.net/0cba67b8/uploads/origins/cc6675db-4e5f-406e-885a-2af6e63d0835?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d83a3a4a69b4c233a48dbecb507c4308 2x, https://si.imgix.net/0cba67b8/uploads/origins/cc6675db-4e5f-406e-885a-2af6e63d0835?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a049e5e598420d2658e9ca3303e0038 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0cba67b8/uploads/origins/cc6675db-4e5f-406e-885a-2af6e63d0835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e26042db3979b0af2fc65254dd56e73f", "srcset": "https://si.imgix.net/0cba67b8/uploads/origins/cc6675db-4e5f-406e-885a-2af6e63d0835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e26042db3979b0af2fc65254dd56e73f, https://si.imgix.net/0cba67b8/