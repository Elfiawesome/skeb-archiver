ral-village.info/up/1747457140.png\nhttp://www.floral-village.info/up/1775568881.jpg\n\n〇シチュ\nジェットバスで失禁絶頂\n〇参考\nhttp://www.floral-village.info/up/1775565492.jpg\n〇詳細\n参考資料のように、バスの中で足を開かされている姿勢。\n睨みつけている表情。\n水着の下から乳首を勃起。\n\n次に、ジェットバスを受けている状態。\n食いしばった表情。\n\n次に、失禁。\n白目を剥きそうに舌を出した表情。\n\n最後に白目を剥いて、顔中を涙や鼻水、涎だらけに。\n\n〇補足\n水着の破損やずらしは無し。\n責め役の顔や、本体の有無はお任せします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sama_samasa/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/714c1567/uploads/origins/ddbc809e-40e7-45d8-98e3-8b660952b416?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce02c3b72f0ae19e161ab72c23652ba3", "srcset": "https://si.imgix.net/714c1567/uploads/origins/ddbc809e-40e7-45d8-98e3-8b660952b416?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce02c3b72f0ae19e161ab72c23652ba3, https://si.imgix.net/714c1567/uploads/origins/ddbc809e-40e7-45d8-98e3-8b660952b416?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67b6e1775d66c7342ce7144cfda3e9e9 2x, https://si.imgix.net/714c1567/uploads/origins/ddbc809e-40e7-45d8-98e3-8b660952b416?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4087a7648ae56b29df74a26faa995e13 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3921189, "nc": 17}, {"path": "/@sama_samasa/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3921189, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60a11de8/uploads/origins/e00b0423-467f-43ad-a1c6-8f27db965e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e89303b3a384a0551b2149e10e5be7a", "srcset": "https://si.imgix.net/60a11de8/uploads/origins/e00b0423-467f-43ad-a1c6-8f27db965e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e89303b3a384a0551b2149e10e5be7a, https://si.imgix.net/60a11de8/uploads/origins/e00b0423-467f-43ad-a1c6-8f27db965e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da1662fe30fd250092ec67eff4cdcbdd 2x, https://si.imgix.net/60a11de8/uploads/origins/e00b0423-467f-43ad-a1c6-8f27db965e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a46fd7cf15df4a24b4ca940316e2ccf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/60a11de8/uploads/origins/e00b0423-467f-43ad-a1c6-8f27db965e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9efce7bbb9bd78908253db051f70098", "srcset": "https://si.imgix.net/60a11de8/uploads/origins/e00b0423-467f-43ad-a1c6-8f27db965e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9efce7bbb9bd78908253db051f70098, https://si.imgix.net/60a11de8/uploads/origins/e00b0423-467f-43ad-a1c6-8f27db965e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d4ea53f2a6b450b28b69da8fadb6f478 2x, https://si.imgix.net/60a11de8/uploads/origins/e00b0423-467f-43ad-a1c6-8f27db965e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3b39b3450b6e8c4363260ec36aa914ed 3x"}, "body": "タイホウがバニー服を着た状態で、騎乗位パイズリをしてほしい。タイホウは荒い息遣いをしている。タイホウの胸には血管が浮き出ている。胸は巨大で、ペニスをすべて覆っている（ペニスは胸の間に完全に隠れている）。司令官は褐色の肌で、胸を掴んでいる。 パイズリは司令官が主導する。動き、射精、2回目の動き、2回目の射精、3回目の射精、そしてパイズリ後の展開で計7つの違いがある。セリフも入れてください。1回目の射精は、タイホウの顔に飛沫が飛ぶような射精だ。タイホウは早すぎる1回目の射精に驚いている。タイホウは、早漏でパイズリに弱い司令官をからかう。また、タイホウは自分の胸のサイズを明かす。 2回目の射精シーンでは、タイホウが司令官に「もっと射精しなさい」と促す。2回目と3回目の射精は中出し。3回目の射精は勢いが弱く、泡立っている。タイホウは驚いて、その3回目の射精をじっと見つめる。タイホウは司令官がこれほど大量に射精したことを称賛する。「ありがとう🙇‍♂️」\n\nhttps://x.com/azurlane_staff/status/1923370350613606468", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sama_samasa/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3921189, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6969a072/uploads/origins/8d3fd75d-33c5-4145-ac04-71351cf9e023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=357bdab7212619eefb8d528422123f60", "srcset": "https://si.imgix.net/6969a072/uploads/origins/8d3fd75d-33c5-4145-ac04-71351cf9e023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=357bdab7212619eefb8d528422123f60, https://si.imgix.net/6969a072/uploads/origins/8d3fd75d-33c5-4145-ac04-71351cf9e023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a4067d0384b67af4d0c114c6ea06de1 2x, https://si.imgix.net/6969a072/uploads/origins/8d3fd75d-33c5-4145-ac04-71351cf9e023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a15dba2c98aae861f9afa68476a0eea 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6969a072/uploads/origins/8d3fd75d-33c5-4145-ac04-71351cf9e023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b6d02f419f1c7f8f3b8f958b81c27e4", "srcset": "https://si.imgix.net/6969a072/uploads/origins/8d3fd75d-33c5-4145-ac04-71351cf9e023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b6d02f419f1c7f8f3b8f958b81c27e4, https://si.imgix.net/6969a072/uploads/origins/8d3fd75d-33c5-4145-ac04-71351cf9e023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05d3b18ebd3a4bac74048355a66160d5 2x, https://si.imgix.net/6969a072/uploa