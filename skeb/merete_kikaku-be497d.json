2df/uploads/origins/47c67629-e3b6-4429-b9a0-af7d87fa260f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe6aae44d138e50bf9a871edf98b8770 3x"}, "body": "めれてさんこんにちは！\n警備隊ヤルララのアクスタのミニキャラバランスが綺麗でかわいくて。とてもとても羨ましすぎてですね、私も推しカップルのアクスタ欲しい！ということで、警備隊ヤルララアクスタと同じバランス絵柄で「イザベル・マリコワ様とその従者レクター」（嬢レク）をお願いできないでしょうか？！\n\n資料はこちらです。\nhttps://www.notion.so/skeb-311f6f326c5a807cbe0ce01042d62c3e?source=copy_link\n\n納品された絵で個人的にアクスタやシールを作らせていただきたいです。\nヤルララと並べて飾れたら良いなあという思いからリクエストさせていただきます。\nどうぞよろしくおねがいいたします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@tsubo_ichiro/works/120", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 387058, "client_id": 3798160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38a85565/uploads/origins/c18ccf8e-86dd-4a6f-bb33-e87d11ab175b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d089fe66bf257c1d79a02651dced1475", "srcset": "https://si.imgix.net/38a85565/uploads/origins/c18ccf8e-86dd-4a6f-bb33-e87d11ab175b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d089fe66bf257c1d79a02651dced1475, https://si.imgix.net/38a85565/uploads/origins/c18ccf8e-86dd-4a6f-bb33-e87d11ab175b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b09e348d2562c743a5985424d76e626d 2x, https://si.imgix.net/38a85565/uploads/origins/c18ccf8e-86dd-4a6f-bb33-e87d11ab175b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9383a6090aaa984c350cc3ffe18eaffe 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38a85565/uploads/origins/c18ccf8e-86dd-4a6f-bb33-e87d11ab175b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed70d5bf5f99f0bac091c714fa64450e", "srcset": "https://si.imgix.net/38a85565/uploads/origins/c18ccf8e-86dd-4a6f-bb33-e87d11ab175b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed70d5bf5f99f0bac091c714fa64450e, https://si.imgix.net/38a85565/uploads/origins/c18ccf8e-86dd-4a6f-bb33-e87d11ab175b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a675cef29497b9bffdaa2ad7975c925 2x, https://si.imgix.net/38a85565/uploads/origins/c18ccf8e-86dd-4a6f-bb33-e87d11ab175b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f207a514e0e4ca29a31df26570afc386 3x"}, "body": "いつも大変お世話になっております、めれてです。\n\n早速ではございますが、壺一郎さんの得意とする雰囲気やシチュエーションでのえっちなヤルララを読ませていただきたいです。\n初夜でも数回目でも、数えきれないほど重ねた二人でもいいと思いますし、初々しくてもただひたすら貪るように肉欲のまま体を重ねる二人でもいいと思っております。……が、ヤルララに限りましては愛を感じられるものだとありがたいです。\n\n抽象的な依頼内容になってしまい申し訳ございませんが、とにかく何よりエロ＝アクションの壺一郎さん'sパッションを詰めていただきたく存じます。\n何卒ご検討のほどよろしくお願いいたします。\n\n\n※ 個人利用の一環で、いただいた作品からインスピレーションを受けての創作をさせていただく可能性がございます。\n※上記の理由からどこかにサインをいれていただけると助かります。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@edamameshinato/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1815954, "client_id": 3798160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/971a932d/uploads/origins/85f79676-70ce-4c2d-81e2-9e22e3adc12d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ac307affe2deb49402ff49c088ddd27", "srcset": "https://si.imgix.net/971a932d/uploads/origins/85f79676-70ce-4c2d-81e2-9e22e3adc12d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ac307affe2deb49402ff49c088ddd27, https://si.imgix.net/971a932d/uploads/origins/85f79676-70ce-4c2d-81e2-9e22e3adc12d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=712eeade5a01831dfcef81e6e15dfb49 2x, https://si.imgix.net/971a932d/uploads/origins/85f79676-70ce-4c2d-81e2-9e22e3adc12d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3