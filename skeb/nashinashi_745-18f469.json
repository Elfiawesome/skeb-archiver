い\n\n構図や体制はお任せします。 \nファイル形式については、もしよろしければpsdでお願いします。 宛名については別レイヤー、もしくは有り無しの差分画像でいただきたいです。\n\nhttps://drive.google.com/drive/folders/1X8KzzfpNskdya0oBZ3e4hmBBiafcOB95?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 4436, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "餡虎/Anco🐯", "screen_name": "azu_ankoowl", "avatar_url": "https://pbs.twimg.com/profile_images/2029464279355932672/5KMndCja.jpg", "header_url": "https://pbs.twimg.com/profile_banners/843036830102507520/1764559065/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1178755, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ドスコイ人類", "screen_name": "ooo_____1i", "avatar_url": "https://pbs.twimg.com/profile_images/1370141229183164419/eET7Yot6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1279074363157798914/1619256799/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "banned": false, "nc": 16}, {"id": 1657798, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "くろやん◎", "screen_name": "kuroyan_mgs", "avatar_url": "https://pbs.twimg.com/profile_images/1981029568057069568/qRZny6Zc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1217885232/1776665089/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "