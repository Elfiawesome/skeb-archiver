d62d77131?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=deaa348cf037ec58d0852f3c1631341b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed6da14b/uploads/origins/ff7759c5-a6ae-4a89-b344-076d62d77131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=421bc17cd9e4502dc4b8ac46461c634f", "srcset": "https://si.imgix.net/ed6da14b/uploads/origins/ff7759c5-a6ae-4a89-b344-076d62d77131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=421bc17cd9e4502dc4b8ac46461c634f, https://si.imgix.net/ed6da14b/uploads/origins/ff7759c5-a6ae-4a89-b344-076d62d77131?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e5167d3b64a8beb411f08c1badd9e317 2x, https://si.imgix.net/ed6da14b/uploads/origins/ff7759c5-a6ae-4a89-b344-076d62d77131?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d28e6c55e9e6346b9df95a819fb94917 3x"}, "body": "はるの様\n\n初めまして！突然のご連絡失礼いたします。\n\nYoutubeにて活動している澄（すみ）と申します。\n普段は歌配信や雑談配信を中心に活動しております！\n\nTwitter：https://twitter.com/sumisuya\nYoutube：https://www.youtube.com/@sumisuya\n\nはるの様の描く素敵なイラストを拝見しぜひ私自身を描いていただきたく、リクエストを送らせていただきました。\n以下の依頼内容をご確認いただきご検討いただければ幸いです。\n\n---\n\n✦使用用途\n・自家販売チェキでの使用（検討中）\n・SNSや普段の配信活動での使用\n\n✦構図\n・ポーズや表情はお任せ致します。歌枠でのサムネに使用できるものだと嬉しいです！\n・頭の先や髪の毛などは先が切れないように描いていただきたいです。\n・表情差分があればとっても嬉しいですが、難しければ大丈夫です…！\n\n✦サイズや解像度\n・全てお任せ致します。\n・大きめのサイズであればあるほど嬉しいです！\n\n✦納品形式\n・PSD形式\n\n✦人物像\n・資料用URLにGoogleドライブでの参考画像添付させていただきます。\n・キャラクターイメージは『癒し／朗らか／清楚』です。\n・糸目キャラですので開眼だけはさせませんようお願いします。\n・イメージカラーは白と緑です。\n・糸目は糸目でも、吊り上がった猫のような糸目ではなく、ほんわかした目であると嬉しいです。\n\n---\n\n以上よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1egZHqvqTLH7fsa2obGss7DNoSt6HIdhx?usp=share_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@harupico_lemon/works/4", "private_thumbnail_image_urls": null