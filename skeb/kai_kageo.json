_acceptable_same_genre": true}, {"path": "/@kai_kageo/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 325087, "client_id": 597760, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03abcd1b/uploads/origins/dd78250f-5324-452a-b966-e4b621e5a105?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a74e384bec80a70daf61944a02fc544", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03abcd1b/uploads/origins/dd78250f-5324-452a-b966-e4b621e5a105?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b494a210aa8ad7aed13143f5d307bb49", "src_set": ""}, "body": "こんにちは、私はあなたのドラフトガールが大好きで、同じようなものが欲しいと思っています。希望するキャラクターは「ファイアーエムブレム 覚醒」の「マリベル」です。あずささんの写真のように、裸で手コキをしているのもいいですね。\n\nhttps://skeb.imgix.net/uploads/origins/c7acf6d1-07ad-4361-8b48-419825560ee4?bg=%23fff&auto=format&w=800&s=91ab064121ca6c77dd3cc2c2566dfbc1", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kai_kageo/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 325087, "client_id": 1559976, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30c63df1/uploads/origins/ea24f232-2ce0-470f-8217-922b51892308?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c5a082d2d7bc539f5d70683f0171250", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30c63df1/uploads/origins/ea24f232-2ce0-470f-8217-922b51892308?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a93d21741fc36b2cade2411dbc7c8fb", "src_set": ""}, "body": "こんにちは。\nオーガスタの作品が素晴らしかったので、同じような作品を今度はフェディールにお願いしたいと思います。\n彼女はとても背が高いので、見る人が彼女を見上げるような形でお願いします。彼女は片手を肩の方に伸ばしています。普段のドレスと同じデザインのビキニを着て、胸を大きくしています。\nできればもう少しバリエーションが欲しいところです。一人目はいつもの愛くるしい表情で、二人目はサキュバスのような輝く目をしています。\n\n視聴者とFedielとの身長差の参考として、私が希望していた写真を追加しました。\nhttps://www.pixiv.net/en/artworks/92378423", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kai_kageo/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 325087, "client_id": 1559976, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03d2f14f/uploads/origins/dda627ad-921c-4a22-8a61-f6d0adde6372?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b113d366a5f3874478a17bebe6ec5a03", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03d2f14f/uploads/origins/dda627ad-921c-4a22-8a61-f6d0adde6372?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07bf1a8e95743b40acf6e42fdbe5bde3", "src_set": ""}, "body": "こんにちは\n\n私はあなたのDraph作品がとても好きで、Augustaのためにこのような作品をリクエストしたかったのですが、彼女のドレスをベースにしたビキニを着て、魅惑的に微笑んでいます。\nhttps://www.pixiv.net/en/artworks/92009199\nhttps://www.pixiv.net/en/artworks/85907114", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kai_kageo/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 325087, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac18ef68/uploads/origins/c7acf6d1-07ad-4361-8b48-419825560ee4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70c524ea16fec74186a45f3de0339171", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac18ef68/uploads/origins/c7acf6d1-07ad-4361-8b48-419825560ee4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44253618c84477eef9349a440dc7cbf3", "src_set": ""}, "b