の雰囲気が本当に大好きで、pixivでたまたま出会ったときは読み耽りました。しかし普段BLを読まないのもあって何のリアクションも残さず、舞子様のお名前なども控えておらず……。（自分から見ないだけでBLは苦手ではないです！耽美なものならむしろ好きです）\nしばらく年月が開いて今日、普段は使わないSkebで何気なくクリエイター様を眺めていて、すごく素敵！とっても好み！と思いながらプロフィールを検め、偶然再会できたことに勝手に感動しております。\n\nよろしければ創作NLの2名を描いていただきたいです。\n舞子様のセンスがとにかく好きなので、服装やモチーフなどはおまかせします。舞子様の絵で自カプを見てみたい気持ちが強いです。\n\nあまりSkeb慣れしていない上に、勢いのまま送信しているため、拙い部分がございましたら申し訳ありません。\nぜひご検討くださいますと幸いです。\n\nhttps://www.dropbox.com/sh/hshicyypsrmxxlm/AADj9c6aewKuQHDaFRptIWsma?dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@q1q_artwork_m/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 695837, "client_id": 1564156, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95cf0f53/uploads/origins/a460aebc-664c-4ba4-a870-fe71353b074b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af57fd18c352757110390a8a59c5b7aa", "srcset": "https://si.imgix.net/95cf0f53/uploads/origins/a460aebc-664c-4ba4-a870-fe71353b074b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af57fd18c352757110390a8a59c5b7aa, https://si.imgix.net/95cf0f53/uploads/origins/a460aebc-664c-4ba4-a870-fe71353b074b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a0e0138e22c3f5e871f21203a30d769 2x, https://si.imgix.net/95cf0f53/uploads/origins/a460aebc-664c-4ba4-a870-fe71353b074b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8be5435081978f33f900f6c7a5bf6402 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95cf0f53/uploads/origins/a460aebc-664c-4ba4-a870-fe71353b074b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9633ce1e4ac11ebf9e55c6a9f19b5378", "srcset": "https://si.imgix.net/95cf0f53/uploads/origins/a460aebc-664c-4ba4-a870-fe71353b074b?bg=%23fff&auto=format%2Ccompress&fm=webp&fi