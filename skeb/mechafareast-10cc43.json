下品な淫語やマークの落書きがされている。\n\n・(写真というシチュエーションとは矛盾しますが)汚い喘ぎ声や淫語を連発してマスターに媚び射精を促すような二人の台詞のテキスト付き。\n\n・性格のイメージはそれぞれお好きなようにお願いします。\n\nとにかく下品で無様なワードで画面を埋め尽くして欲しいです。\n\nよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/12V-PO93JV_RM9vIyteXgNtFoTj_k4CRb", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mechafareast/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3623971, "client_id": 19252, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa70fc69/uploads/origins/c6ebf13f-ed40-43e6-90e9-d30055e25e7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f36ac5fabe6ef2ec3c5982255a52d1c", "srcset": "https://si.imgix.net/aa70fc69/uploads/origins/c6ebf13f-ed40-43e6-90e9-d30055e25e7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f36ac5fabe6ef2ec3c5982255a52d1c, https://si.imgix.net/aa70fc69/uploads/origins/c6ebf13f-ed40-43e6-90e9-d30055e25e7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10f1cafd467537641496b361f5412c2e 2x, https://si.imgix.net/aa70fc69/uploads/origins/c6ebf13f-ed40-43e6-90e9-d30055e25e7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=debef0b587a6ed755171879799339358 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa70fc69/uploads/origins/c6ebf13f-ed40-43e6-90e9-d30055e25e7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbd0f88417c843fb8c32aaefd533883a", "srcset": "https://si.imgix.net/aa70fc69/uploads/origins/c6ebf13f-ed40-43e6-90e9-d30055e25e7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbd0f88417c843fb8c32aaefd533883a, https://si.imgix.net/aa70fc69/uploads/origins/c6ebf13f-ed40-43e6-90e9-d30055e25e7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=