4d36-bb67-2175655dda30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6519e657a4cb6ac51b720c8a24540496, https://si.imgix.net/33fe9aa2/uploads/origins/bba2a3e3-e8e0-4d36-bb67-2175655dda30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=811a6860e22835892be2f1d68b4443cb 2x, https://si.imgix.net/33fe9aa2/uploads/origins/bba2a3e3-e8e0-4d36-bb67-2175655dda30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8910487f51f6bb8c8364c50801f08d6 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33fe9aa2/uploads/origins/bba2a3e3-e8e0-4d36-bb67-2175655dda30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34575fc8b9ff50d42144b80d092e5113", "srcset": "https://si.imgix.net/33fe9aa2/uploads/origins/bba2a3e3-e8e0-4d36-bb67-2175655dda30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34575fc8b9ff50d42144b80d092e5113, https://si.imgix.net/33fe9aa2/uploads/origins/bba2a3e3-e8e0-4d36-bb67-2175655dda30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=61fdf5041d7da51f144268e60e99eee7 2x, https://si.imgix.net/33fe9aa2/uploads/origins/bba2a3e3-e8e0-4d36-bb67-2175655dda30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bf388f1482e856a27ca00f59732891f9 3x"}, "body": "爆乳&超乳が最高だったので予算的に可能な範囲でお願いします！\n\n作品名/キャラ名\n俺だけ入れるダンジョン/エマ・ブライトネス(ロリ)&ドリアード\n\nシチュ：\n超乳&(可能であれば着衣ボテ腹)姿のエマにゴミを見るような冷めた目で嫌悪・侮蔑され、同じく超乳&(可能であれば着衣ボテ腹)姿のドリアードに無邪気な笑顔で嘲笑されながら、ローションまみれでえげつない構造の(可能であれば触手生物系)オナホの中身を見せつけられるドMホイホイシチュ。\n\n二人とも服の上からでもわかる勃起乳首(もし透け描写有りならピンク色希望)+胸は手が簡単に沈み込みそうな顔以上のサイズの着衣超乳&もし可能であれば特大着衣ボテ腹で、服の中に押し込められて服がパツパツに張り詰めている様子が強調されている感じでお願いします。\nまた服に関しては超乳&ボテ腹用に調整して頂いて構いませんので、肌は服で隠れてしまっている様子を希望です。\nまた下腹部に怪しく光る淫紋の描写を希望します。\n\nオナホは通常のオナホの場合は肉厚非貫通のピンク色で内部の大量の襞が敷き詰められていて、大量のローションが溢れている感じを希望します。\n触手オナホの場合は花のように開くブラシ状触手、吸盤触手に加えて咥内壁や本来の舌自体も粘液まみれの襞や繊毛などが密集している、挿入したらひたすら搾り取られそうな感じの触手地獄にしてください。\nまたシチュや予算的に可能であれば触手花の中央部に尿道責め用の精巣まで届きそうな長さで表面に尿道をゴリゴリ責めるようなイメージの肉の“かえし”がびっしり生えているような尿道責め触手を希望します。\n\nこちらも可能でしたらpsd形式でオナホのローション音or粘液塗れの触手が蠢く効果音と瞳のハイライトをON/OFF出来るような感じで差分を作成して頂ければ幸いです。\n背景は単色やグラデーション系で構いませんのでダークな感じにして頂ければ幸いです。\n\n予算的に可能な範囲で構いませんので何卒宜しくお願いします！\n\nエマ・ブライトネス(ロリ)参考：https://imgur.com/a/B3cFt6R\nドリアード参考：https://imgur.com/a/RC8NlfX\n各種触手参考：https://imgur.com/a/I02AVSy", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@3141592ppp/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1092366, "client_id": 503123, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be6a5ad1/uploads/origins/8f4f199f-e8a0-4229-b248-eeb713d7c1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=227cabe8ae012cd31b0283b776ff6820", "srcset": "https://si.imgix.net/be6a5ad1/uploads/origins/8f4f199f-e8a0-4229-b248-eeb713d7c1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=227cabe8ae012cd31b0283b776ff6820, https://si.imgix.net/be6a5ad1/uploads/origins/8f4f199f-e8a0-4229-b248-eeb713d7c1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=befaa449fcb495877bd7dbd973d76cb7 2x, https://si.imgix.net/be6a5ad1/uploads/origins/8f4f199f-e8a0-4229-b248-eeb713d7c1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a3aebd57d6a56e7951f8feac8098922 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be6a5ad1/uploads/origins/8f4f199f-e8a0-4229-b248-eeb713d7c1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0c1bca28aad361f93be9d5bc5ea4bd7", "srcset": "https://si.imgix.net/be6a5ad1/uploads/origins/8f4f199f-e8a0-4229-b248-eeb713d7c1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0c1bca28aad361f93be9d5bc5ea4bd7, https://si.imgix.net/be6a5ad1/uploads/origins/8f4f199f-e8a0-4229-b248-eeb713d7c1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ae4c9a7e983d51015bf14e83faaf0e1b 2x, https://si.imgix.net/be6a5ad1/uploads/origins/8f4f199f-e8a0-4229-b248-eeb713d7c1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d7ee4aebefd3f5b680576ed3441a4416 3x"}, "body": "はじめまして\nVtuberの小蜂めるさんという方のエッチなイラストお願いしたいです\nいつものようにASMRの配信をしている裏で実は気づかれないようにこっそり男の人とエッチしている音を流しているというシチュエーションで\n最初にお耳のマッサージをしますと言ってマッサージと称して男のちんこをシコシコしていて\n途中で射精した音をオイルこぼしてしまったとごまかして\n次にお耳はむはむしてあげますねと言ってフェラを開始します\nフェラで気持ちよくなり射精したときに変な音を出してしまったとごまかします\n最後にタッピングをすると言ってセックスのパンパン音を流して自分も気持ちよさに耐えられず声を出して喘いでしまい中出しと同時に絶頂してリスナーに感づかれながら配信を終わるというシチュでお願いします\n\n射精されるごとに精液でベトベトになっていく感じでお願いします\n\n彼女は自称Zカップなのでもし可能であれば胸を盛った差分もお願いしたいです\n\nhttps://twitter.com/mel_kohachi/status/1181903846253088769?s=20\nhttps://www.youtube.com/watch?v=bVaLWraBH4E", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@3141592ppp/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1092366, "client_id": 53985, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cdc621cd/uploads/origins/e258f17a-5dd8-4129-90de-38eaacb6ce3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12b6a35c788630b1e87d9baafa492bb8", "srcset": "https://si.imgix.net/cdc621cd/uploads/origins/e258f17a-5dd8-4129-90de-38eaacb6ce3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12b6a35c788630b1e87d9baafa492bb8, https://si.imgix.net/cdc621cd/uploads/origins/e258f17a-5dd8-4129-90de-38eaacb6ce3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0305e4e0865dd9b71ed3637fb46ad006 2x, https://si.imgix.net/cdc621cd/uploads/origins/e258f17a-5dd8-4129-90de-38eaacb6ce3d?bg=%23fff&auto=f