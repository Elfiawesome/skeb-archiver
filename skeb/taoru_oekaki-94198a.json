幸いです。\n・胸は完全なぺたんこで描いていただきたいです。\n\nたおやか様の世界観で、自由に描いていただけるととても嬉しいです。\n\n【使用用途】\n完成したイラストは、SNSやYouTubeのサムネイル等にて、大切に使用させていただく予定です。\n\n【納品形態】\n背景等もしありましたら、レイヤー分けされたPSDファイルでお願い致します。\n\nぜひ、ご検討の程よろしくお願い申し上げます。\n\n【参考資料1】\n\nhttps://www.dropbox.com/scl/fo/760ifnguh6b45qnlzdfsu/AE52n8u4g1s1Xa_Qr4zGFsg?rlkey=3knjnhfducmiq3dsgylbxhzeo&st=hgbdh7v5&dl=0\n\nhttps://x.com/nemumiruth/status/1952345867358519640?s=46&t=7ykyySVoFi2pMNLtBeE3jQ", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@taoru_oekaki/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2f28b5b3/uploads/origins/ee3c3f9a-43ad-4e41-bb54-e42803d468a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2369518d8361d98a5ded6cf0642f44fa", "srcset": "https://si.imgix.net/2f28b5b3/uploads/origins/ee3c3f9a-43ad-4e41-bb54-e42803d468a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2369518d8361d98a5ded6cf0642f44fa, https://si.imgix.net/2f28b5b3/uploads/origins/ee3c3f9a-43ad-4e41-bb54-e42803d468a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c83962aa7fd02155a4e22967cbf6027 2x, https://si.imgix.net/2f28b5b3/uploads/origins/ee3c3f9a-43ad-4e41-bb54-e42803d468a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f6a36a3992dc35b2d6db3a8ab10d3826 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2608255, "client_id": 3542075, "nc": 144}], "sent_works": [], "similar_creators": [{"id": 346884, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "🌱べべ/B