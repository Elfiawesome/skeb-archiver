%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d2ed78b7e48d7f934c496dd206aab3c, https://si.imgix.net/e68d9a66/uploads/origins/acd1c415-9132-4df4-9165-9b46a8d60b46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=347bcc4ebe716c3d26ff043a07f22344 2x, https://si.imgix.net/e68d9a66/uploads/origins/acd1c415-9132-4df4-9165-9b46a8d60b46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18f0349dc5f3bee032cee4ca04cdc71c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e68d9a66/uploads/origins/acd1c415-9132-4df4-9165-9b46a8d60b46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c647e24390edc55ea9a91d43d9984316", "srcset": "https://si.imgix.net/e68d9a66/uploads/origins/acd1c415-9132-4df4-9165-9b46a8d60b46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c647e24390edc55ea9a91d43d9984316, https://si.imgix.net/e68d9a66/uploads/origins/acd1c415-9132-4df4-9165-9b46a8d60b46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97d33b95568310ad87c357adc01219ae 2x, https://si.imgix.net/e68d9a66/uploads/origins/acd1c415-9132-4df4-9165-9b46a8d60b46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8953511ffdfe6269d31a967516ba256a 3x"}, "body": "いつもお世話になっています。\n篠原です。\n\n前回納品していただいたイラストが素晴らしかったのでまた依頼を送らせていただいています。\n\n今回の依頼内容としましては、またリアン・アニマリア・椿さんを描いて頂きたいと考えていまして、ギャルゲーの本編の冒頭説明PV風の動画を作りたいので、それに使う立ち絵をお願いしたいです。\n\n①６～７頭身でギャルゲー風に正面立ちではなくやや斜めからの立ち絵。\n\n②差分を作って頂きたくて基本表情は笑顔。\n　差分は笑顔のままで肩にジャンガリアンハムスターのジローが乗っている状態のものをお願いします。（ハムスターの大きさは現実のサイズと同じもの７～１２cm　色は腹側クリーム色　背中は灰色　頭から背中にかけてヒレのように茶色の模様がある）\n\n③ポーズは緩く腕を組んでいる感じでも大丈夫ですし、描きやすいように描いてください。（出来れば棒立ちはやめてください。）\n\nよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FlightChicken/works/2", "private_thumbnail_image_urls": n