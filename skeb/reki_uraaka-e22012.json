nt": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reki_uraaka/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 406369, "client_id": 37095, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d75fe03/uploads/origins/d6c9d018-7899-479f-846c-205050285893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b71707c2e9d4cd56f597b7c1e916b32", "srcset": "https://si.imgix.net/8d75fe03/uploads/origins/d6c9d018-7899-479f-846c-205050285893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b71707c2e9d4cd56f597b7c1e916b32, https://si.imgix.net/8d75fe03/uploads/origins/d6c9d018-7899-479f-846c-205050285893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2fcf91257df43a58cc30cad284c79d4d 2x, https://si.imgix.net/8d75fe03/uploads/origins/d6c9d018-7899-479f-846c-205050285893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60b99f6936b6da583fa3c5aa72a59fc9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d75fe03/uploads/origins/d6c9d018-7899-479f-846c-205050285893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d5b8887df9eeb69323fc760c1b4d986", "srcset": "https://si.imgix.net/8d75fe03/uploads/origins/d6c9d018-7899-479f-846c-205050285893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d5b8887df9eeb69323fc760c1b4d986, https://si.imgix.net/8d75fe03/uploads/origins/d6c9d018-7899-479f-846c-205050285893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ce422efc4c1c5ae20e05b1a1516f5350 2x, https://si.imgix.net/8d75fe03/uploads/origins/d6c9d018-7899-479f-846c-205050285893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=46df9c70a9d5217527f3ff1ad37039af 3x"}, "body": "久方ぶりに依頼お願いしたいと思います…！\n頭に鉢巻きをした４０代ほどのマッチョ男が超巨根化巨玉化され神輿台に乗せられ大の字になるように両腕脚を縛られているという。\n表情は羞恥と興奮とで顔真っ赤になっているが周りの視線や射精を堪えているというのを。神輿祭りということで観衆の視線や指さし大笑いやスマホを向けられていて、勃起して奮い立つ巨根の根本に注連縄や鈴やミカンといったオメデタイ飾り付けがされて、裏筋に「天晴！！」と筆文字が書かれているというのをお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reki_uraaka/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 406369, "client_id": 68157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba506ab9/uploads/origins/a98d7c26-2043-49ae-82d0-155849673b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7424233db16042a69d4c6f18a9e214c8", "srcset": "https://si.imgix.net/ba506ab9/uploads/origins/a98d7c26-2043-49ae-82d0-155849673b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7424233db16042a69d4c6f18a9e214c8, https://si.imgix.net/ba506ab9/uploads/origins/a98d7c26-2043-49ae-82d0-155849673b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6acb50ce4ac2a323525e9de06c082fa3 2x, https://si.imgix.net/ba506ab9/uploads/origins/a98d7c26-2043-49ae-82d0-155849673b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a6712cd655f73b8c68c75a5e7e9ee28 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba506ab9/uploads/origins/a98d7c26-2043-49ae-82d0-155849673b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26ecabf09d010a3f4ed1d0c3500fb869", "srcset": "https://si.imgix.net/ba506ab9/uploads/origins/a98d7c26-2043-49ae-82d0-155849673b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26ecabf09d010a3f4ed1d0c3500fb869, https://si.imgix.net/ba506ab9/uploads/origins/a98d7c26-2043-49ae-82d0-155849673b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=206e0f2b8a2418e9efa6865115f74877 2x, https://si.imgix.net/ba506ab9/uploads/origins/a98d7c26-2043-49ae-82d0-155849673b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=22b35470c6a6d9e26eac58b11f9ee97b 3x"}, "body": "こんにちは、イケメンノンケ教師が大学生の教え子に犯されるタイムストップイラストをお願いしたいです。\n\n先生は40代くらいの毛むくじゃらで筋肉質な男性で、強い逞しさを持ち、端正な茶髪の短髪、青い目、ふさふさの髭を生やしていると想像しています。タイトなシャツとズボンを着て、指には結婚指輪をしています。\n\n生徒が先生のシャツのボタンを外し、毛むくじゃらの筋肉質の胸を露出させ、ズボンと下着を下ろして大きなチンコを露出させるところを見てみたいと思います。生徒が先生を教室の前で地面にひざまずかせ、先生の口を犯し、その中で精液を出す。顔やヒゲを覆い尽くし、開いた口から体や床に溢れる大量のザーメンを見てみたいものです。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reki_uraaka/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 406369, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7ec224c/uploads/origins/08732ddf-3a6c-45b7-971b-2eb4241cb70f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34d4a9b2264ca111bf805c777ca3f7ab", "srcset": "https://si.imgix.net/c7ec224c/uploads/origins/08732ddf-3a6c-45b7-971b-2eb4241cb70f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34d4a9b2264ca111bf805c777ca3f7ab, https://si.imgix.net/c7ec224c/uploads/origins/08732ddf-3a6c-45b7-971b-2eb4241cb70f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=475def92326dbb5b610961f2ddb8b217 2x, https://si.imgix.net/c7ec224c/uploads/origins/08732ddf-3a6c-45b7-971b-2eb4241cb70f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5482762df4e362b77a3fd86e84dddc8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c7ec224c/uploads/origins/08732ddf-3a6c-45b7-971b-2eb4241cb70f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=830c9a699094c455ff6303c5cf4b71e4", "srcset": "https://si.imgix.net/c7ec224c/uploads/origins/08732ddf-3a6c-45b7-971b-2eb4241cb70f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=830c9a699094c455ff6303c5cf4b71e4, https://si.imgix.net/c7ec224c/uploads/origins/08732ddf-3a6c-45b7-971b-2eb4241cb70f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7bffcbe222aad480400b7dba243a417b 2x, https://si.imgix.net/c7ec224c/uploads/origins/08732ddf-3a6c-45b7-971b-2eb4241cb70f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=821b340dccb51d54563d35b8de10ce0c 3x"}, "body": "はじめまして。\nレキさんが描かれた「シャワー中のおじさん」が大好きです！雄臭い毛深くて筋肉質なカラダも、おじさんで強面なのに、鼻バンだったりするところもギャップも最高です。\n勝手な妄想で恐縮ですが、もしレキさんの都合があえば（設定とずれていなければ）こんなシチュエーションで、もう一度晃彦おじさんをイかせて欲しいです。\n\n仕事終わりに駅前のマッサージ店に立ち寄った晃彦おじさん。ペラッペラの薄水色のサウナパンツ１枚に着替えて身体をほぐしてもらっていると、程なく仕事疲れでそのまま寝落ち。\n数十分後、口をぽかーんと開けてだらしなく大いびきをかく姿を見て、暫く起きないと確信した店員は、パンツの上から膨らみを撫で始める。\n日頃溜まっていた晃彦おじさんのチンコは、徐々に反応して、下半身に立派テントを張り、水色だったパンツには、至るところに暴れたあとである染みができていた。\n遂には店員の手によってパンツを金玉の下までずり降ろされ、我慢汁まみれの直立した大人のチンコをあらわにされてしまう。しかし晃彦おじさんは起きるどころか気持ちよさそうにいびきをかいて爆睡。\n時間になり店員に起こされると、恥ずかしそうに枕に垂れていたヨダレを拭って帰っていった。\n\n厳ついいかにも漢な晃彦おじさんの無防備な爆睡姿や、そして寝ているのにチンコだけは正直に反応してしまうところが是非見たいです（店員の姿は省略で構いません）。\nもし差分をいただけるなら、パンツを下ろされる前と後の２パターンがあると嬉しいです。\nよろしくお願いいたします！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reki_uraaka/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/31898154/uploads/origins/00f0def5-c8a4-4320-8f63-8c201f404aa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6fc2aaa768a26d26c8f0e264f35eda55", "srcset": "https://si.imgix.net/31898154/uploads/origins/00f0def5-c8a4-4320-8f63-8c201f404aa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6fc2aaa768a26d26c8f0e264f3