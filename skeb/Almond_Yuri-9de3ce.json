に置き、桜の木に片手を付き、もう片方の手でびしょびしょになった靴下を脱いでおり、その際にスカートの下に履いていたハーフパンツが少し見え、足先からおしっこが滴っていると嬉しいです。\n\n女の子について\n入学したばかりの地味目な女の子という雰囲気で、青いスカーフを付けた冬服のセーラー服で、スカートは膝の下あたりまで、学校指定の通学カバンを背負っており、靴下は白、靴は下記のような白基調のマジックテープでとめるタイプのスニーカーでお願いします。\nhttps://item.rakuten.co.jp/hakozume/10005412/\n\n細かくて恐縮ですがご検討よろしくお願いします！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Almond_Yuri/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3167933, "client_id": 40971, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/731533b9/uploads/origins/7fdb7f40-417e-430c-a658-12199f1de039?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3394892b84df8fdcf4e7516d8f56c480", "srcset": "https://si.imgix.net/731533b9/uploads/origins/7fdb7f40-417e-430c-a658-12199f1de039?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3394892b84df8fdcf4e7516d8f56c480, https://si.imgix.net/731533b9/uploads/origins/7fdb7f40-417e-430c-a658-12199f1de039?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c9b33eb3bea7777bc128e1812b1c563 2x, https://si.imgix.net/731533b9/uploads/origins/7fdb7f40-417e-430c-a658-12199f1de039?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65112636a3a56e6f895d13754716bc91 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/731533b9/uploads/origins/7fdb7f40-417e-430c-a658-12199f1de039?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41461bbe96de2f0053fc86878bc6a6fb", "srcset": "https://si.imgix.net/731533b9/uploads/origins/7fdb7f40-417e-430c-a658-12199f1de039?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41461bbe96de2f0053fc86878bc6a6fb, https://si.imgix.net/731533b9/uploads/origins/7fdb7f40-417e-430c-a658-12199f1de039?bg=%23fff&auto=fo