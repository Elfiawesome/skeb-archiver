4830-96fc-f8b4258374aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c5dd643a5a5ddb7f78573020c9eb3f4", "srcset": "https://si.imgix.net/727cc3fe/uploads/origins/03a1b700-33c2-4830-96fc-f8b4258374aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c5dd643a5a5ddb7f78573020c9eb3f4, https://si.imgix.net/727cc3fe/uploads/origins/03a1b700-33c2-4830-96fc-f8b4258374aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2fb6daf9ffa7dae3e9b67e1c9227a85 2x, https://si.imgix.net/727cc3fe/uploads/origins/03a1b700-33c2-4830-96fc-f8b4258374aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca88211f4f79c8409b94e2a9d478343e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/727cc3fe/uploads/origins/03a1b700-33c2-4830-96fc-f8b4258374aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ab06024f2b259acb29595d784cb7fa3", "srcset": "https://si.imgix.net/727cc3fe/uploads/origins/03a1b700-33c2-4830-96fc-f8b4258374aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ab06024f2b259acb29595d784cb7fa3, https://si.imgix.net/727cc3fe/uploads/origins/03a1b700-33c2-4830-96fc-f8b4258374aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d4db0b29a65fb91d960dc3a3c1d2f895 2x, https://si.imgix.net/727cc3fe/uploads/origins/03a1b700-33c2-4830-96fc-f8b4258374aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2f86c262ebacf2a30c4ef0405758345a 3x"}, "body": "「参ったな」\n男は足元に溜息を落とした。これは予定外だ。こんなことになるなら買い物は後にするべきだったと思ったところで、どうにもならない。\n明るいうちに外に出たのは随分久しぶりだった。季節がいつの間にか春になっていた。シャツ一枚ではちょっと肌寒いくらいで、でもほんのりとした日差しの暖かさが際立ち心地よかった。\n知らない店がたくさんあった。いや、知らなかったのはきっと自分だけだろう。小さい本屋にふらりと入れば、思いの外掘り出し物があり、大層買ってしまった。その後、ケーキ屋にも寄った。甘いものが好きだった。でも最近はコンビニの甘いパンやお菓子ばかりで、ちゃんとしたケーキを買ったのはついぞ久しぶりだった。\nそれなら駅前まで出て、夜通る時にはとっくに閉店しているコーヒー屋で豆を買うか、なんて考えたところだった。足元にいる小さな生き物はもう無理とばかりにまとわりつき、抱っこをせがんでいる。\n「仕方ないな」\nひょいと抱き上げると嬉しそうに尻尾を振り、ワンと吠えた。途端に元気いっぱいだ。肩に前足でしがみつき、身を乗り出してはしゃぐのはいいが、胴が長いので巻きついてくる感じがする。濡れた鼻先を首筋に擦り付けてくるのでくすぐったい。\n生き物を飼うのは初めてだった。勝手に歩いてくれるからと思っていたのは甘い考えだった。でも、今日見つけた店は全部、犬の思うままに歩かせて知ったものだった。予定外というのも、たまにはいい。\n「まあ、おまえが一番の予定外だよ」", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 587924, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "墓場", "screen_name": "RIP404", "avatar_url": "https://pbs.twimg.com/profile_images/2075538737480818688/3YrXMCK8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/961659103301984256/1783621773/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 837189, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "真秀明", "screen_name": "sinsin12121", "avatar_url": "https://pbs.twimg.com/profile_images/1686405306019180544/zkA3jL60.jpg", "header_url": "https://pbs.twimg.com/profile_banners/948584895466545152/1640477256/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 137}, {"id": 2106472, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ムシ", "screen_name": "Inu_muchamucha", "avatar_url": "https://pbs.twimg.com/profile_images/1624344967887097856/RcUIOtzR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1183668966184456192/1730112834/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "