けられています。\n\n【背景など】\n背景は無くても大丈夫です。\nキャラクターの足元には広めのジオラマのような、草原のヴィネット風舞台があると嬉しいです！\n\n差分などは特になく、シンプルに1枚のイラストです！\n小物の描写が多めになるかと思いますが、何卒よろしくお願い申し上げます！\n\nhttps://ibb.co/album/d4Vv56?sort=name_asc", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1439302, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "肉厚マジシャンしんぼ", "screen_name": "coffeelove68", "avatar_url": "https://pbs.twimg.com/profile_images/1928357618508255233/Jt1mMcrW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1269277048800829440/1637262500/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 2496364, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Enchel🐾お仕事募集中", "screen_name": "Enchel", "avatar_url": "https://pbs.twimg.com/profile_images/2014153220793458688/m88EMZAR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/15274865/1755776841/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 49}, {"id": 2563927, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "dia②", "screen_name": "68ta_2", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F5b91bae7-d0a5-4330-8a2e-3ff84a210bc9.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/90bccb71-24d4-48fb-a5bb-63e6e1dfa5aa.png?sensitive=true", "appeal_receivable": false, "popular_creator_rank": null, "request_mas