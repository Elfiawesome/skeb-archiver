gle.com/file/d/1o7CZ9fKSe2NJ7Tm8cNXMkP81dhFLG-Y1/view?usp=drivesdk\n\n〈2人目〉\nhttps://drive.google.com/file/d/1XY1pvOvpwPfPG0OEsbUhVn77V1NaaFrR/view?usp=drivesdk\n\n\n▪︎構図\n可能であれば、一緒に歩いている構図でお願いしたいです。\n\n▪︎その他\nskebに慣れておらず金額や参考資料の不備ございましたら再送またはキャンセルしていただけますと幸いです。\n\nご検討よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kotarou83/works/215", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3544646, "client_id": 2779377, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d86a314/uploads/origins/ae2c875d-085a-478c-a881-1770b76f81e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=922aacce4f245b055d10230f98d62b6e", "srcset": "https://si.imgix.net/3d86a314/uploads/origins/ae2c875d-085a-478c-a881-1770b76f81e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=922aacce4f245b055d10230f98d62b6e, https://si.imgix.net/3d86a314/uploads/origins/ae2c875d-085a-478c-a881-1770b76f81e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79167efdd2567654cb53f9d386798bd6 2x, https://si.imgix.net/3d86a314/uploads/origins/ae2c875d-085a-478c-a881-1770b76f81e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05dac98ba81550aa8208335b786ae83a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d86a314/uploads/origins/ae2c875d-085a-478c-a881-1770b76f81e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc73d4819b3905ec46d0c495082d6601", "srcset": "https://si.imgix.net/3d86a314/uploads/origins/ae2c875d-085a-478c-a881-1770b76f81e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc73d4819b3905ec46d0c495082d6601, https://si.imgix.net/3d86a314/uploads/origins/ae2c875d-085a-478c-a881-1770b76f81e2?bg=%23fff&auto=format%2Ccompr