分\n\n通常/\nヘタレ顔/涙目\nキリッ/真面目な顔\n\n\nその他備考欄\n\n・原型 アラート号+幻夢境の白亜の船\n\nラブクラフトの小説、「クトゥルフの呼び声」に内に語られる“アラート号事件”、その船である。\n事件では乗組員こそは最終的に全滅した。\nしかし、元々はクトゥルフの信奉者が搭乗しており(恐らく覚醒していない深きものと思われる)、その後クトゥルフに突撃したことによってルルイエの浮上を阻害したというのが通説である。\nすなわち、邪悪より出でながらも邪悪を阻んだものと解釈が出来る。\n\nミームでよく漁船と勘違いされるが原作では武装快速船である。\n\n白亜の船。イレク＝ヴァドの王となった者を乗せた夢を渡る船。\n\n夢の世界を救世主と共に渡った白亜の船は、彼の望む通り大好きな人たちと共に戦う力を得た。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@awayuki7777/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2003778, "client_id": 69030, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c691ced/uploads/origins/1960c8e5-df99-4d9b-9c91-82bc2d44a204?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6df010830dad936f7fde59781089e13d", "srcset": "https://si.imgix.net/8c691ced/uploads/origins/1960c8e5-df99-4d9b-9c91-82bc2d44a204?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6df010830dad936f7fde59781089e13d, https://si.imgix.net/8c691ced/uploads/origins/1960c8e5-df99-4d9b-9c91-82bc2d44a204?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfb71e757bdb5e91fdbaa711ed561f7b 2x, https://si.imgix.net/8c691ced/uploads/origins/1960c8e5-df99-4d9b-9c91-82bc2d44a204?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b21688cdbca2478a0329ac0ae3714977 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c691ced/uploads/origins/1960c8e5-df99-4d9b-9c91-82bc2d44a204?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=252f37d20d59a520fbce7ee960a5623c", "srcset": "https://si.imgix.net/8c691ced/uploads/origins/1960c8e5-df99-4d9b-9c91-82bc2d44a204?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=252f37d20d59a520fbce7ee960a5623c, https://si.imgix.net/8c691ced