もので結構です、ヒト型、怪獣、触手等、描きやすいものでオーケーです。\n背景はもし面倒であれば省略していただいてもかまいませんが１枚は巨大感の感じられるイラストがあるとうれしいです。\n\n長くなりましたが、お支払いした金額でお描きいただけるものを描いていただけると幸いです。\n描いた時期がバラバラで恐縮ですが、うちの子の資料を送付いたします。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Vopp79PnaKliDdE9MKqzApNk4eCIfkJd?usp=sharing", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1573, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "沼黒 @お仕事募集中", "screen_name": "BlackSwamp0808", "avatar_url": "https://pbs.twimg.com/profile_images/1285482035822227457/aYNMwyzU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3854872758/1721776185/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 72683, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "助監督@夏コミ(日)東1ｼ54b", "screen_name": "SF_Clockman", "avatar_url": "https://pbs.twimg.com/profile_images/1918593920747085824/45X1T3OA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/887658320986750978/1766930062/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 80953, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "南雲あゆゅ🪽Illustrator🫧", "screen_name": "ayuyu_lament", "avatar_url": "https://pbs.twimg.com/profile_images/2021790029648175104/JAxwGG99.jpg", "header_url": "https://pbs.twimg.com/profile_banners/809738253930610688/1772676565/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_req