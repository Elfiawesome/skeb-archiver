ージURLのみ投稿いたします。\n\nご多忙の事と存じますがご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1u5SIEfwOJHu602xyePdtAmh1jO3m9u4E?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@setugetuka1018/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f47f0d67/uploads/origins/724f2f0b-3c5e-4f3e-a03a-d8d74328d140?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4fa8420cbbb7a165e4e39d7f29818a49", "srcset": "https://si.imgix.net/f47f0d67/uploads/origins/724f2f0b-3c5e-4f3e-a03a-d8d74328d140?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4fa8420cbbb7a165e4e39d7f29818a49, https://si.imgix.net/f47f0d67/uploads/origins/724f2f0b-3c5e-4f3e-a03a-d8d74328d140?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e355cd3ccd625e52c4aeae012547c527 2x, https://si.imgix.net/f47f0d67/uploads/origins/724f2f0b-3c5e-4f3e-a03a-d8d74328d140?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=584d94604a24b0e2975746282694356f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2499127, "client_id": 3356305, "nc": 16}, {"path": "/@setugetuka1018/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2499127, "client_id": 2792857, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f12e68d3/uploads/origins/f01e71bb-32a5-4f49-8f4a-bdb35fcb55f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e224935cdc184fa67ed43859851d13c8", "srcset": "ht