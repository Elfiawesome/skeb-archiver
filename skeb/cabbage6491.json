これらの用途において、無断使用防止のためにウォーターマークを適宜付けて、イラストを使用させていただく場合があるので、ウォーターマークについてもご提供いただけますと幸いです。\nなお、商業利用や第三者への再配布は行いません。\n\nご確認のほど、よろしくお願いいたします。\nもしもご縁がありましたら、どうかよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1RnRks6JaodiN9ZqGEVaQb3GdVrx6mOEy", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 108500, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "まめすず", "screen_name": "kaisouafuro", "avatar_url": "https://pbs.twimg.com/profile_images/1622744713194508289/IBNfRnRm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/876410300257288192/1757045759/1500x500", "appeal_receivable": true, "popular_creator_rank": 8, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "nc": 177}, {"id": 372306, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "柏瀬かるね🐾お仕事募集中", "screen_name": "jsrr_k04", "avatar_url": "https://pbs.twimg.com/profile_images/1987709574053588992/V65hiqH2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1701730758/1770716586/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 35, "skills": [{"genre": "art"}], "nc": 1}, {"id": 398838, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ヒヨヨ@skeb募集中", "screen_name": "kou_hiyoyo", "avatar_url": "https://pbs.twimg.com/profile_images/1820725109768003584/nFqwhAAN.png", "header_url": "https://pbs.twimg.com/profile_banners/105523086/1725285923/1500x500", "appeal_receivable": false, "popular_creator_rank": 6, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_ac