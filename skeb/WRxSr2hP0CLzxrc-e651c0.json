mgix.net/519fd643/uploads/origins/c7c65b6c-0dd3-428f-a22b-f04a1c143927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1e11d3233ce21b95222a61918f104d9e 3x"}, "body": "お世話になってます！\nまたリクエストを送るのでご検討ください。\n\n【キャラクター】\nウィンドチャイム（アークナイツ）\n\n【シチュエーション】\nウィンドチャイムをドクター（竿役）が犯し続けてイかせまくった様子。\n\n構図としては竿役主観の正常位が良いです。\nhttps://x.com/wrxsr2hp0clzxrc/status/1941894051726512165?s=46&t=uw-bFdyBpb-LAgZmthu90w\n↑過去に描かれていたこれが比較的近いです。正常位でかつ、腰を掴まれて犯されてるものが良いです。\n\n【備考】\nウィンドチャイムの乳のサイズは爆乳で、片乳が頭部の2倍以上程度。乳輪と乳首も大きめのパフィーニップル気味。以前描かれていたものよりも乳盛る感じでお願いします。\n陰毛などの毛は無し。\n服装は無しでも有りでも良いですが、乳は出してください。\n竿役のドクターは中背で体細め、チンコは長め巨根。\n想定の竿役がドクターというだけなので、竿役の姿は映らなくても問題ありません。\n\nまた、ファイルは可能ならPNGとPSDが両方欲しいです。\n\n以上になります。\n是非よろしくお願いします！", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@WRxSr2hP0CLzxrc/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2645404, "client_id": 262111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af18d763/uploads/origins/3be684ec-164b-48a5-8ff3-c65e43ffa71e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d4b782fcb333a2debd5ef9dfa40bb10", "srcset": "https://si.imgix.net/af18d763/uploads/origins/3be684ec-164b-48a5-8ff3-c65e43ffa71e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d4b782fcb333a2debd5ef9dfa40bb10, https://si.imgix.net/af18d763/uploads/origins/3be684ec-164b-48a5-8ff3-c65e43ffa71e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b002a48ce2ecb930401e5682babc53e 2x, https://si.imgix.net/af18d763/uploads/origins/3be684ec-164b-48a5-8ff3-c65e43ffa71e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab2cb649cee934ff891e7f24b2f0d0a8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af18d763/uploads/origins/3be684ec-164b-48a5-8f