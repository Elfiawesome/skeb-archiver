か、無しで大丈夫です◎\n（透過にて頂戴できましたら嬉しいです。）\n\n以上ぜひお引き受けいただけた際はよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1JnH9FLXz4bZ7WUgyRl0qLYuQHW5BGWQY?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yhoney_pink/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2181932, "client_id": 2983692, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ddaea9ef/uploads/origins/7d0fbab4-e717-432a-ab54-557e8055709a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0033632ea4e1b51e7eb73f8819744579", "srcset": "https://si.imgix.net/ddaea9ef/uploads/origins/7d0fbab4-e717-432a-ab54-557e8055709a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0033632ea4e1b51e7eb73f8819744579, https://si.imgix.net/ddaea9ef/uploads/origins/7d0fbab4-e717-432a-ab54-557e8055709a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74c0ef8754a0098821de7e32ff5b8db5 2x, https://si.imgix.net/ddaea9ef/uploads/origins/7d0fbab4-e717-432a-ab54-557e8055709a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5301a8f96c069eda5fc06be528f26395 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ddaea9ef/uploads/origins/7d0fbab4-e717-432a-ab54-557e8055709a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5661ee6a2bbd2c273cb8c3e1fc4132d0", "srcset": "https://si.imgix.net/ddaea9ef/uploads/origins/7d0fbab4-e717-432a-ab54-557e8055709a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5661ee6a2bbd2c273cb8c3e1fc4132d0, https://si.imgix.net/ddaea9ef/uploads/origins/7d0fbab4-e717-432a-ab54-557e8055709a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f86d25ae32204fb2377301c98ea378b 2x, https://si.imgix.net/ddaea9e