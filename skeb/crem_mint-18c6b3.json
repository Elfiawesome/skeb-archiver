髪が銀髪の手を引いて連れ出す・\n宝石・嫉妬・傲慢・額縁・アンティーク・見つめ合う\n\nこちらの作品がとても好きだったので、可能であればアンティーク・額縁などを採用した１枚を自由に描いていただけると嬉しいです！\nhttps://skeb.jp/@crem_mint/works/6\n\n金額不足しているようであればお手数おかけしますが再送頂けますと幸いです。\nご検討の程よろしくお願いいたします。\n\n◆イラスト資料：https://drive.google.com/drive/folders/1ppX91xkr5r8IdSycHpGuz7bF6SETxys1?usp=drive_link\n◆設定資料：https://www.notion.so/291886ab6bf680f9b320c4f6f7d6e570?source=copy_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crem_mint/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ce5d14b2/uploads/origins/878a459d-8fd2-466f-8c6d-dbc88d73f65f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=974824a06fe4b0b75405c7276d3ac338", "srcset": "https://si.imgix.net/ce5d14b2/uploads/origins/878a459d-8fd2-466f-8c6d-dbc88d73f65f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=974824a06fe4b0b75405c7276d3ac338, https://si.imgix.net/ce5d14b2/uploads/origins/878a459d-8fd2-466f-8c6d-dbc88d73f65f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33238800039541c37ff1f1f685131f21 2x, https://si.imgix.net/ce5d14b2/uploads/origins/878a459d-8fd2-466f-8c6d-dbc88d73f65f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7868d483681e0d8e42f33ee44670bdfc 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3754988, "client_id": 3163330, "nc": 17}, {"path": "/@crem_mint/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3754988, "client_id": 3769983, "vtt_url": null,