.imgix.net/998ed44c/uploads/origins/3f81a7b2-f7c2-4925-9b77-3da8c9efddd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=720e16361f0e72925d4f440a340fe411 2x, https://si.imgix.net/998ed44c/uploads/origins/3f81a7b2-f7c2-4925-9b77-3da8c9efddd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=494c9574b19c55751f177a3c2228efbe 3x"}, "body": "初めまして！絵がとても気に入っていますので、リクエストさせていただきたいと思います！\nもしよろしければ下記URLのうちの子２人を描いていただけますでしょうか。\n\n二人は友達で、よく一緒に授業をサボっている。互いが好きな戦略ゲームで競争し、好きなもの話している。\n表面で共通点が多くとても仲がいいが、裏で二人とも相手のこと「何かがおかしい」と疑いながら互いの隠し事に近づけようとしている。表の言葉や行動で、互いの裏を暴き出そうとしている関係で、どちらも自分の本意のこと猫かぶりしている。いずれ二人ともの目的に互いへの恋の気持ちが邪魔し、この関係から離れたい、または形を変えたいが、曖昧のままでいきなり終わってしまう。\n咲苗は自分に彼への気持ちを自分に許せないし、彼の気持ちのこと知らないふりしながら否定している。冬夜はずっと彼女に告白しよいとしているが、彼女はそれを毎回うまく避けている。2人ともは嘘つきで、冬夜だけはいずれ素直になりたい。咲苗はどんどんウソを重ね、もう彼に、彼女自身にも彼女の本音はどこにあるか分からなくなってしまう。\n\nご自由に描いていただければ幸いです。特徴は、二人の肉体的な親しさと感情的な距離の差です。この関係もかなりメランコリック的で、今しかないみたいな切ない・甘酸っぱい気持ちがどこかにあるのではないかと思いますが、普通に二人でいると楽しいや安心できるとも言える。ちょっと不健康...とも言える。\n一緒にふざけているところ、互いを疑っているところ、のんびりゲームするところなど、なんでもいいです！\n内容はお好みではない、都合が合わない場合など、なるべくキャンセルでお願いします。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/159Tz-4uFx9DAFXof3RrSOLlzpY5RRD2x?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crem_mint/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3754988, "client_id": 681099, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e34c62b/uploads/origins/66767264-b34e-45bb-9129-089feef16f12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c599d98952602fee767b7b76e1baf4d", "srcset": "https://si.imgix.net/0e34c62b/uploads/origins/66767264-b34e-45bb-9129-089feef16f12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c599d98952602fee767b7b76e1baf4d, https://si.imgix.net/0e34c62b/uploads/origins/66767264-b34e-45bb-9129-089feef16f12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76bf1ada3646e65b5e166343552e6df1 2x, https://si.imgix.net/0e34c62b/uploads/origins/66767264-b34e-45bb-9129-089feef16f12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39086b6d1e4e40b6f8c197f8b0c8db9b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e34c62b/uploads/origins/66767264-b34e-45bb-9129-089feef16f12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df045be90598924cd281111eddf19f80", "srcset": "https://si.imgix.net/0e34c62b/uploads/origins/66767264-b34e-45bb-9129-089feef16f12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df045be90598924cd281111eddf19f80, https://si.imgix.net/0e34c62b/uploads/origins/66767264-b34e-45bb-9129-089feef16f12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b4d068560d0824bf080217107b0d87d 2x, https://si.imgix.net/0e34c62b/uploads/origins/66767264-b34e-45bb-9129-089feef16f12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd1a92c6c55a3b02abda2cdd15b8f742 3x"}, "body": "こんにちは！CREMさんの絵が好きです！オリジナルキャラクターのペアをリクエストしてもいいですか？\n\n達也（たつや）： 179cm、高3。どうしようもないロマンチストだが、恋愛関係についていない。とても切実で楽天的、非常に感情的で、感情が透けて見える。少女漫画が大好きで、そのため恋愛に対して理想主義的すぎる考え方でいる。美術部の部長。面倒見がよく、後輩からは頼もしいと言われている。料理や掃除などの家事が得意。甘いもの（バレンタインデー生まれにもかかわらず）、ホラーなど苦手。左利きで耳に穴あきをしている（ただしピアスはつけていない）。制服の時はセーターの外側にネクタイを着用していることが注目点。夏美からは「たっちゃん」と呼ばれている。一人称は「俺」。\n \n夏美（なつみ）： 169cm、高3。のんびり屋でぶっきらぼう。のほほんとしているが、クールなイメージで、男女問わずモテモテ。幼い頃に両親が離婚したため、恋愛に対してかなり悲観的な考え方を持っている。ストイックに見えるが、結構遊び心持ち。自立心が強く、自分の問題で他人に負担をかけることを嫌い。弓道部主将。食べることが大好きで、食べ物を分け合うことが嫌いで、食べ物さえもらえばどんな話でも乗ってくる。達也の以外、手料理は嫌い。好きな食べ物はドーナツ。達也からは「なっちゃん」と呼ばれている。一人称は「私」。 \n\n二人は幼なじみの上、隣人。恋愛観は正反対にもかかわらず、二人はとても仲良し。ボケとツッコミのやり取りが多い。二人はお互いに惹かれ合っている。夏美は達也をからかうのが好きだが、実は密かに彼に恋をしている。一方、達也は夏美にとても忠なり、彼女を守っているが、当初は彼女への気持ちの大きさに気づいていない。そのため、二人は親しい間柄であるにもかかわらず、ある程度の距離感がある。 \n※2人はクラスメイトではない。達也はA組、夏美はB組。\n\nもしよろしければ、このような複数やり取り・コラージュ／スケッチページのイラストをお願いしたいと思います：\nhttps://skeb.jp/@crem_mint/works/1\nhttps://skeb.jp/@crem_mint/works/2\n2人のやり取りをどのように描いていただけるか見てみたいので、お任せします！\n\n参考資料、作品、漫画（英・日あり),　その他の依頼はすべて下のリンクにあります。その他、、英語での情報もありますので、よかったら参考にしてください！\nhttps://toyhou.se/5622354.tatsuya-sato\nhttps://toyhou.se/5622356.natsumi-uehara\n\nご検討いただき、ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1kOYMGm7Sl2A57cnJNNwpalCvxogtDih5?usp=sharing", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crem_mint/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1563268e/uploads/origins/67c94d3e-43a0-4225-9b8b-d6304aacec14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8cd44d4205b8dabfab7db219e86bdd1a", "srcset": "https://si.imgix.net/1563268e/uploads/origins/67c94d3e-43a0-4225-9b8b-d6304aacec14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8cd44d4205b8dabfab7db219e86bdd1a, https://si.imgix.net/1563268e/uploads/origins/67c94d3e-43a0-4225-9b8b-d6304aacec14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a619ea1e9ff9226a29308cea372e5b7 2x, https://si.imgix.net/1563268e/uploads/origins/67c94d3e-43a0-4225-9b8b-d6304aacec14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13e607766d72393489dfdd4dd8bae793 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3754988, "client_id": 3163330, "nc": 17}, {"path": "/@crem_mint/works/3", "private_thumbnail_imag