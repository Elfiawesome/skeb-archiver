さん！前回のリクエスト、本当にありがとうございました！もしよろしければ、またオリジナルキャラクターのペアをお願いしてもよろしいでしょうか？\n\n二人は前回のリクエストの達也と夏美の妹弟です！二人に関するすべての参考資料、作品、漫画（英・日あり),　その他の依頼はすべて下のリンクにあります。その他、英語での情報もありますので、よかったら参考にしてください！\nhttps://toyhou.se/5622377.mamoru-uehara\nhttps://toyhou.se/5622375.ayase-sato\n\nポーズややり取りはお任せしますが、二人の興味(ゲームや甲虫)を組み込んだり含めたりしていただければ嬉しいです！\n\nご検討いただき、ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1su1pdkTsDJ7I39wQlbdgacTeB4Qyybm0?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crem_mint/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c92fed63/uploads/origins/e34a15f6-c05a-454c-b743-a4af98282647?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=853b5009f3816aeef052b5ba4cfd78e4", "srcset": "https://si.imgix.net/c92fed63/uploads/origins/e34a15f6-c05a-454c-b743-a4af98282647?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=853b5009f3816aeef052b5ba4cfd78e4, https://si.imgix.net/c92fed63/uploads/origins/e34a15f6-c05a-454c-b743-a4af98282647?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99f0dcf5aa37f8cf425e889b0f625255 2x, https://si.imgix.net/c92fed63/uploads/origins/e34a15f6-c05a-454c-b743-a4af98282647?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b48882ea899845e5d748dd2d6febd4d 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3754988, "nc": 0}, {"path": "/@crem_mint/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3754988, "client_id": 