とでおまじないをする世界観なので、制服には紐の要素があると良いです。おとなしめの服が多いですが色気みたいなものがちょっとあると嬉しいです（華奢な感じに見えるようなオーバーサイズを着る、制服だと露出を抑えて可愛らしい印象になるニットを着るなど）\n\n・参考画像\nURL\n\n・使用用途\n観賞用や個人的に友人と共有して楽しみます。CREM様のIDを明記した上でSNSで紹介することがあります。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1-9npU9P9GNl22j1WNvQeKuA0x5VZXKrc", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 923199, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "メリー", "screen_name": "meri", "avatar_url": "https://pbs.twimg.com/profile_images/1317867458535907333/XnBI2FOr.jpg", "header_url": "https://pbs.twimg.com/profile_banners/74644208/1472387895/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1151334, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "🍂", "screen_name": "X10Dareda", "avatar_url": "https://pbs.twimg.com/profile_images/1030907337727344640/-NcsjNUD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1030516734908715008/1702572930/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "banned": false, "nc": 0}, {"id": 1278097, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "SHN", "screen_name": "shihan_seroom", "avatar_url": "https://pbs.twimg.com/profile_images/1616458486120075264/67FHBp5g.jpg", "header_url": "https://pbs.twimg.com/profile_banners/947087294414045185/1667486935/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_mast