dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=48efccd3776b7953f4b2a45a8c64b822 3x"}, "body": "こんにちは！あなたのコンポジションがとても好きです！私のオリジナルキャラクターをリクエストすることは可能でしょうか？彼は祖父のノートに隠された暗い秘密を知らずに、その意味を求めて世界中を旅する青年です。彼には2つのモードがあり、イヤリングが太陽や月の光に当たるかどうかでモードを切り替えることができます。彼の外見は、どちらのモードにあるかを反映している。黒髪で描かれる彼の主な性格は、穏やかで一見ナイーブだが、かなり鋭い。モードが切り替わると正反対の行動をとり、通常は悪役を演じる。どちらの人格も相手を高く評価しているが、根は同じ人間だ。普段は傘を差して日差しを遮っている。何でも嬉しいです。無理そうなら遠慮なく断ってください。私のリクエストを見てくれてありがとう！\n\nhttps://drive.google.com/drive/folders/1SgevO79SAWSi1XTvkjORj5xhaIe4Jti-?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Otani3710/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1708453, "client_id": 667554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9016969a/uploads/origins/528fcb39-8987-4f6f-b806-f3a457450ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7432878c2379ae9e96f92d0dbb21b06b", "srcset": "https://si.imgix.net/9016969a/uploads/origins/528fcb39-8987-4f6f-b806-f3a457450ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7432878c2379ae9e96f92d0dbb21b06b, https://si.imgix.net/9016969a/uploads/origins/528fcb39-8987-4f6f-b806-f3a457450ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9da70d0628f1377b00be8f516e1cf72 2x, https://si.imgix.net/9016969a/uploads/origins/528fcb39-8987-4f6f-b806-f3a457450ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1edf89eef16fe86df00457434d48b34 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9016969a/uploads/origins/528fcb39-8987-4f6f-b806-f3a457450ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73c3fe43caf264eab417bdb26207ae17", "srcset": "https://si.imgix.net/9016969a/uploads/origins/528fcb39-8987-4f6f-b806-f3a