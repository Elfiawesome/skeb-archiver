◎セリフ等はニュアンスがあってればいいので改変OKです！\n\n以上、ご検討お願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koukoutatetate/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0b4fcc96/uploads/origins/d4ae1181-51c5-4528-b16b-2c4c4c2e8d58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5723a5c707fe4cf4c5d08b2518f09e75", "srcset": "https://si.imgix.net/0b4fcc96/uploads/origins/d4ae1181-51c5-4528-b16b-2c4c4c2e8d58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5723a5c707fe4cf4c5d08b2518f09e75, https://si.imgix.net/0b4fcc96/uploads/origins/d4ae1181-51c5-4528-b16b-2c4c4c2e8d58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=96b5d59e38a8a966d872dd9e2ee32444 2x, https://si.imgix.net/0b4fcc96/uploads/origins/d4ae1181-51c5-4528-b16b-2c4c4c2e8d58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db2c7f2f8d75b7b307ddb6faa3d6515a 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 734187, "nc": 161}, {"path": "/@koukoutatetate/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 734187, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/79b7f173/uploads/origins/f9b577ab-97e2-4aa5-ab11-484a1183d153?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82162fa260f675623832f7292b178412", "srcset": "https://si.imgix.net/79b7f173/uploads/origins/f9b577ab-97e2-4aa5-ab11-484a1183d153?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cr