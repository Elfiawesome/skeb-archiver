ins/1207f112-862b-4876-a8f5-aeb9d0a942e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd0ba4f3c84c96730e6be63b1f7015f7", "srcset": "https://si.imgix.net/0756c5da/uploads/origins/1207f112-862b-4876-a8f5-aeb9d0a942e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd0ba4f3c84c96730e6be63b1f7015f7, https://si.imgix.net/0756c5da/uploads/origins/1207f112-862b-4876-a8f5-aeb9d0a942e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d3a03681ccb069088c910275a91122f 2x, https://si.imgix.net/0756c5da/uploads/origins/1207f112-862b-4876-a8f5-aeb9d0a942e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c0ff37f3af3153263ff5973f812f0930 3x"}, "body": "初めまして。\n絵の依頼をさせていたただいてもよろしいでしょうか？\n\nhttps://www.pixiv.net/artworks/101452917\n\nこちらの女王様が大変好みなので、お願いします。\n\n服装：参考の通り\n\nほしいシーンは\n股布をずらしてモブ男と騎乗位セックス。\n射精せずに頑張ったご褒美としてボンテージのフロントのジッパーを下ろして胸を露出、乳首を見せます。\n男が大量射精。女王様は余裕の笑み。\n女王様は陰毛ありでお願いします。\n\nご検討お願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ahugan_sugita/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 103252, "client_id": 43628, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ea9e757/uploads/origins/966a2678-537c-4360-bc09-36cee79ebd8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45cea2c8cefe406109c342519eeb103e", "srcset": "https://si.imgix.net/1ea9e757/uploads/origins/966a2678-537c-4360-bc09-36cee79ebd8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45cea2c8cefe406109c342519eeb103e, https://si.imgix.net/1ea9e757/uploads/origins/966a2678-537c-4360-bc09-36cee79ebd8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78266eb35897667a2dc3ff622d99ef12 2x, https://si.imgix.net/1ea9e757/uploads/origins/966a2678-537c-4360-bc09-36cee79ebd8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23598f3a4abedf1bd1886b58427bd519 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ea9e757/uploads/origins/966a2678-537c-4360-bc09-36cee79ebd8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8949620e1e7cf2d2f79974289651b810", "srcset": "https://si.imgix.net/1ea9e757/uploads/origins/966a2678-537c-4360-bc09-36cee79ebd8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8949620e1e7cf2d2f79974289651b810, https://si.imgix.net/1ea9e757/uploads/origins/966a2678-537c-4360-bc09-36cee79ebd8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=692df3634282a81672ead7885762364d 2x, https://si.imgix.net/1ea9e757/uploads/origins/966a2678-537c-4360-bc09-36cee79ebd8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16231f6da00d4d0416ea5798fe54b5a1 3x"}, "body": "先日は素敵なカカオをありがとうございました！！\nイラストの質感や雰囲気がとても良かったので、お代わりをお願いしたいです！！\n\n具体的には、同じ衣装のカカオを別アングルで、エッチなところの切り取りをお願いします。\nシチュエーションとしては、前回の衣装を着たカカオが、ポールダンスポールの付いた小円のステージ上で、煽情的なポーズを取ってアピールしているような状況を想定してください。\nそのアピールポーズを3パターンほど部分部分で切り取ったスクラップ写真のような構図でお願いします。\n・パターン１\n前垂れのみでお尻側が丸出し状態のそれで、お尻をぐっと突き出して、尻肉を両側に広げて菊座をはっきりとアピールしているところをお尻中心に切り取り（秘部は極小前張りなので、それがちょっと見えるか見えないかくらい）\n・パターン２\nトップスのブラをはぎ取って、片方の乳房を持ち上げ、乳首に舌を伸ばして舌先で弄る場面の、胸元のピックアップ（顔全体は入らなくてOKです、乳房をがっつりと描写して欲しいです）\n・パターン３\n過激な露出ダンスに興奮して、恍惚となるカカオの顔のピックアップ（顔のみ、首上くらいの描写でOKです）\n\n上記の３つをお願いしたいです。\n前回のイラストと合わせて、えちちなパーツを補完したい、というわがままなお願いです。\nそちら様のガッツリえろすなカカオを是非拝見したく！！\nご検討いただけますと幸いです。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ahugan_sugita/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 103252, "client_id": 43628, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c9b5a24/uploads/origins/32db9283-680a-4f4f-8a18-e118c97cc1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75302a3c9560d5fd64381bdaae54972a", "srcset": "https://si.imgix.net/1c9b5a24/uploads/origins/32db9283-680a-4f4f-8a18-e118c97cc1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75302a3c9560d5fd64381bdaae54972a, https://si.imgix.net/1c9b5a24/uploads/origins/32db9283-680a-4f4f-8a18-e118c97cc1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1728fd0cbe018ebf251a1c455a2eddf 2x, https://si.imgix.net/1c9b5a24/uploads/origins/32db9283-680a-4f4f-8a18-e118c97cc1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6112009959cca6dbc7c5a264c3ee16ac 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c9b5a24/uploads/origins/32db9283-680a-4f4f-8a18-e118c97cc1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f393eebdef32836cc794754b2dbe62b", "srcset": "https://si.imgix.net/1c9b5a24/uploads/origins/32db9283-680a-4f4f-8a18-e118c97cc1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f393eebdef32836cc794754b2dbe62b, https://si.imgix.net/1c9b5a24/uploads/origins/32db9283-680a-4f4f-8a18-e118c97cc1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=80f58c25395d7b2f45d31d55c74619d9 2x, https://si.imgix.net/1c9b5a24/uploads/origins/32db9283-680a-4f4f-8a18-e118c97cc1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9eb542190ac4356b7c5bdb7c8cb47b16 3x"}, "body": "こんばんは、初めまして。レヴェンと申します。\nエルマさんやマーニャのイラストをpixivでお見掛けして以来、フォローさせていただいています。\n素敵な褐色を描かれる方に、是非お願いしたく依頼を送ります。\n\n描いていただきたいのは、VS騎士ラムネ&40FRESHのカカオというキャラです。\n褐色爆乳メカクレという要素盛り盛りで、自分を褐色沼に落とした根源のキャラで、今でも最推しだったりしますｗ\nそんなカカオの、マーニャライクなダンサー衣装のイラストをお願いします。\nなお、VSラムネにはラムネ&40炎というTVシリーズがあり、そっちの方がメジャーですが、お願いしたいのは3年後の、VS騎士ラムネ&40FRESHという作品での18歳版のカカオをお願いしたいです。\nお間違えないようお気を付けください。\n\n絶対に入れて欲しい要素が、ふんどしライクな前垂れです。前垂れ下は極小前張りのみのノーパン、という設定は頭の片隅に入れておいていただきたいですが、描写は無しで構いません。\nお尻側は前垂れどころか紐すらも無しのノーガードで丸出しという感じです。前垂れは腰巻きに紐を巻いて留めてる感じで。\nビキニは眼帯ビキニ（面積極小）の形状で、乳肉が紐に食い込む感じのキツさでお願いします。\n乳首浮きがあると嬉しいです。\n\n全体の構図的には、22年9月24日にそちら様がアップされたマーニャ（101453160）のイメージでおります。\n\n褐色度合いは原作よりもしっかり濃い目で、エルマさんくらいはしっかり褐色でお願いします。\n乳も令和仕様のガッツリ盛りで、バランス取れる限界値までデカくしていただきたいです。\n（爆乳、の中でも一番デカい、くらいの感じ、not超乳、ってニュアンスで伝わりますでしょうか……！！）\n（そちら様のイラストで言うと、20年5月17日アップのエルマさんをベースにそれ以上いけるところまで、という感じです）\n\nアクセサリや装飾品など、細かい部分はお任せします。邪魔しない程度に飾り付けてくださったら嬉しいです。\n褐色肌はウェット＆メッシ―なしっとりテカテカ路線だとなおありがたいです。\n\n原作イラストに過度に寄せるなどはしていただかなくて大丈夫なので、そちら様の料理したFRESHのカカオがエッチなイラストで見られたら、この上ない喜びです。\nどうかよろしくお願いいたします！！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ahugan_sugita/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f97319ca/uploads/origins/bc050365-5a9d-4ceb-8dca-5a54c7be1e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cda30946494e7575f4d58a5f8e96baa1", "srcset": "https://si.imgix.net/f97319ca/uploads/origins/bc050365-5a9d-4ceb-8dca-5a54c7be1e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cda30946494e7575f4d58a5f8e96baa1, https://si.imgix.net/f97319ca/uploads/origins/bc050365-5a9d-4ceb-8dca-5a54c7be1e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6791cf031d6973ffd101de52f2f8583e 2x, https://si.imgix.net/f97319ca/uploads/origins/bc050365-5a9d-4ceb-8dca-5a54c7be1e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=mid