縮ですが、お引き受けいただける場合、ご検討のほど宜しくお願い申し上げます。\n\n詳細な描写はリンクの中に。\nhttps://drive.google.com/drive/folders/1x9Ii0R17yjn8vvk0uHERIRNaPl9fdqO6", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gon_368/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2392540, "client_id": 2048281, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1957c3c5/uploads/origins/b14c29a1-dde0-4028-928d-93dd1eb00c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83acfca46f43666dd4d5c1658a4cc097", "srcset": "https://si.imgix.net/1957c3c5/uploads/origins/b14c29a1-dde0-4028-928d-93dd1eb00c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83acfca46f43666dd4d5c1658a4cc097, https://si.imgix.net/1957c3c5/uploads/origins/b14c29a1-dde0-4028-928d-93dd1eb00c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97fa2574bebd6fcd84991b1685164b9b 2x, https://si.imgix.net/1957c3c5/uploads/origins/b14c29a1-dde0-4028-928d-93dd1eb00c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b48a5aff117ef7f7d2264efc10c58f27 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1957c3c5/uploads/origins/b14c29a1-dde0-4028-928d-93dd1eb00c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90bcb6d079d94548cfbfbd125b3c8d92", "srcset": "https://si.imgix.net/1957c3c5/uploads/origins/b14c29a1-dde0-4028-928d-93dd1eb00c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90bcb6d079d94548cfbfbd125b3c8d92, https://si.imgix.net/1957c3c5/uploads/origins/b14c29a1-dde0-4028-928d-93dd1eb00c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e8d31a3eb4b9d8955f081c07800f8f8d 2x, https://si.imgix.net/1957c3c5/uploads/origins/b14c29a1-dde0-40