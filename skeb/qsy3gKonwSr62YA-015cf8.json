s/2ca43c85-35cb-40e5-a7ea-fac07bc90c54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8003240dcf4bc84bac9ddd1a86ccb12b", "srcset": "https://si.imgix.net/61b0cba5/uploads/origins/2ca43c85-35cb-40e5-a7ea-fac07bc90c54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8003240dcf4bc84bac9ddd1a86ccb12b, https://si.imgix.net/61b0cba5/uploads/origins/2ca43c85-35cb-40e5-a7ea-fac07bc90c54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b2e96447d23018cecb654c0e576d21e 2x, https://si.imgix.net/61b0cba5/uploads/origins/2ca43c85-35cb-40e5-a7ea-fac07bc90c54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=458afe2bbdfa250aead77a6af9296e49 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61b0cba5/uploads/origins/2ca43c85-35cb-40e5-a7ea-fac07bc90c54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe1d9ca6c95813b1744f390c56ae6e87", "srcset": "https://si.imgix.net/61b0cba5/uploads/origins/2ca43c85-35cb-40e5-a7ea-fac07bc90c54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe1d9ca6c95813b1744f390c56ae6e87, https://si.imgix.net/61b0cba5/uploads/origins/2ca43c85-35cb-40e5-a7ea-fac07bc90c54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=37d1be66d5eb73a492957f0846cc66ee 2x, https://si.imgix.net/61b0cba5/uploads/origins/2ca43c85-35cb-40e5-a7ea-fac07bc90c54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=01f775e3490b37dda5e10652cf22cf0b 3x"}, "body": "遊戯王OCGのVSパンテラと一対一のボテ腹中出しエッチ\nhttps://www.pixiv.net/artworks/107624963\n飲尿差分あり\n\nイメージ\nL字開脚で脚を上げるか立位のY字バランスなど脚を上げた状態でエッチ\nL字の場合\nこのように斜めな感じ\nhttps://www.pixiv.net/artworks/99000368\nhttps://www.pixiv.net/artworks/79292797\n\nY字,I字バランスの場合\nhttps://www.pixiv.net/artworks/110265627\nhttps://www.pixiv.net/artworks/109292553\n\n臨月のお腹、母乳も出る\n雰囲気は少し凌辱っぽく\n\n中出し\nびゅーっと射精の瞬間、結合部から精液溢れる\n\n・飲尿\n中出しの後、チンポを抜いてパンテラの口に放尿\n立位の場合も難しい事は考えないでください\nイカされ放心状態\n飲むために口を開けているじゃなく開いた口に注ぐ\nパンテラも一緒に放尿する\n\n一対一なので飲尿と中出しは同時に起こらない、またおしっこのアーチは1本だけ\n\nVSパンテラ\n鼻など人間とは少し異なるので注意\n手足の爪の色は黒\n\n服装\n挿入する部分だけ破れたように穴を開ける\n\n表情\nイカされて痙攣するか反応を無くすかはおまかせします\nhttps://www.pixiv.net/artworks/87287426\nhttps://www.pixiv.net/artworks/1502374\n\nセリフは息遣いなど\n無しの物もあり\n\n：一応ラブな感じ\n：男の顔など相手は分からない、チンポのみでOK\n：真っ白以外の背景\n：修正は黒線や精液などモザイク以外\n：紐づけ以外のツイッターアカウントでの投稿許可願います\n：難しい場合はキャンセル願います\n\nhttps://www.pixiv.net/artworks/108226106", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@qsy3gKonwSr62YA/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2301640, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0db3d4b8/uploads/origins/eb03fec3-69a3-4989-89ea-bc5d99b3dc86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e44b19a4d46c11f1c34686375e76032", "srcset": "https://si.imgix.net/0db3d4b8/uploads/origins/eb03fec3-69a3-4989-89ea-bc5d99b3dc86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e44b19a4d46c11f1c34686375e76032, https://si.imgix.net/0db3d4b8/uploads/origins/eb03fec3-69a3-4989-89ea-bc5d99b3dc86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2289311609403df7bf8c8ba106be732c 2x, https://si.imgix.net/0db3d4b8/uploads/origins/eb03fec3-69a3-4989-89ea-bc5d99b3dc86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a01b81a0a25ae13fe856ef4ad136fdf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0db3d4b8/uploads/origins/eb03fec3-69a3-4989-89ea-bc5d99b3dc86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69c3f48c79d03a7ee6aae02846916c13", "srcset": "https://si.imgix.net/0db3d4b8/uploads/origins/eb03fec3-69a3-4989-89ea-bc5d99b3dc86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69c3f48c79d03a7ee6aae02846916c13, https://si.imgix.net/0db3d4b8/uploads/origins/eb03fec3-69a3-4989-89ea-bc5d99b3dc86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c3adcc59d7e343faa1f1ab3f890f4136 2x, https://si.imgix.net/0db3d4b8/uploads/origins/eb03fec3-69a3-4989-89ea-bc5d99b3dc86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=716b7878d634cdf4cb227c5df4870b8a 3x"}, "body": "五等分の花嫁のイラストをお願いします。\n\nキャラ：中野五月\n\nシチュ：\n・以前のイラスト（https://skeb.jp/@qsy3gKonwSr62YA/works/9）\n　のような着衣乳内放尿イラストをお願いします。\n・ニットベストをたくしあげ、シャツのボタンをはずしてできた谷間ホールに挿入し、放尿させてください。\n・以前のイラストのように、服の下に小便が満たされていき温かくて気持ちいいと感じる描写が欲しいです。\n・可能ならば、小便でびしょびしょになったニットベストとシャツから湯気を立てながら、恍惚とした表情をしている描写もほしいです。\n・細かいところはおまかせします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@qsy3gKonwSr62YA/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2301640, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5afb33ae/uploads/origins/53d8ceda-c32c-4a40-a764-07dc39528162?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=192d9e1d06d32fdd9c1868ea87ae417c", "srcset": "https://si.imgix.net/5afb33ae/uploads/origins/53d8ceda-c32c-4a40-a764-07dc39528162?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=192d9e1d06d32fdd9c1868ea87ae417c, https://si.imgix.net/5afb33ae/uploads/origins/53d8ceda-c32c-4a40-a764-07dc39528162?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2ca9c1d90538e28f523f7d8196d880e 2x, https://si.imgix.net/5afb33ae/uploads/origins/53d8ceda-c32c-4a40-a764-07dc39528162?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ba66903274e9fca2acdc5a27d979d0d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5afb33ae/uploads/origins/53d8ceda-c32c-4a40-a764-07dc39528162?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79e47e8374b63b7647522f97def75f26", "srcset": "https://si.imgix.net/5afb33ae/uploads/origins/53d8ceda-c32c-4a40-a764-07dc39528162?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79e47e8374b63b7647522f97def75f26, https://si.imgix.net/5afb33ae/uploads/origins/53d8ceda-c32c-4a40-a764-07dc39528162?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6f897321e36b0c920f78ae3976911abd 2x, https://si.imgix.net/5afb33ae/uploads/origins/53d8ceda-c32c-4a40-a764-07dc39528162?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=77aec701d80db7f3317b2eaaff8c2dc5 3x"}, "body": "五等分の花嫁の中野三久の着衣浴尿イラストをお願いします。可能性があれば、二枚のイラストをお願いしたいです。（差分なのか、別のイラストなのかはわからない。）\n\n男性視点です。三久は前に座っている。シャツとカーディガンのボタンを外して、穴を作った。彼はこの穴にペニスを挿入して、服の中に小便している。Pixivの「縦パイズリ」タグのような体位です。三久の反応は、温かくて意外と気持ちいいかもというものだ。\n\n二枚目のイラストで、三久はカーディガンを開けて、濡れ透けシャツを見せている。ノーブラなので乳首が見える。気持ちよさそうな顔をしている。\n\nシャツはすっかり濡れてしまったが、カーディガンとブレザーは厚手で水分は染み出れない。中はびしょ濡れで蒸れる。このイメージを可能な限り描写していただけると、とても嬉しいです。\n\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1RqAV_HuFSlHWZjFx_1XfwQxT_m9Qq_Nf", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@qsy3gKonwSr62YA/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2301640, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca59ef7d/uploads/origins/635491ab-6713-4dbd-bbcc-86b9f001c992?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66f275980dfaf1fae95bc5186d677fe4", "srcset": "https://si.imgix.net/ca59ef7d/uploads/origins/635491ab-6713-4dbd-bbcc-86b9f001c992?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66f275980dfaf1fae95bc5186d677fe4, https://si.imgix.net/ca59ef7d/uploads/origins/635491ab-6713-4dbd-bbcc-86b9f001c992?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d602e1c7594af54b2ecfbe95e343777 2x, https://si.imgix.net/ca59ef7d/uploads/origins/635491ab-6713-4dbd-bbcc-86b9f001c992?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df4846e6d9384480dc249957f97579fe 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca59ef7d/uploads/origins/635491ab-6713-4dbd-bbcc-86b9f001c992?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd89b7144ce13171842dba1e81aab63b", "srcset": "https://si.imgix.net/ca59ef7d/uploads/origins/635491ab-6713-4dbd-bbcc-86b9f001c992?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd89b7144ce13171842dba1e81aab63b, https://si.imgix.net/ca59ef7d/uploads/origins/635491ab-6713-4dbd-bbcc-86b9f001c992?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c9c29bb9d5dfcb4621af9fe8e0f01f34 2x, https://si.imgix.net/ca59ef7d/uploads/origins/635491ab-6713-4dbd-bbcc-86b9f001c992?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b52520fa7ffae2c03fa97c41c3e59790 3x"}, "body": "新規と過去作品の差分の2つをリクエストします\n\n＊過去差分\nこの作品の差分です\nhttps://www.pixiv.net/artworks/109131555\n-内容\n射精シーンでのお漏らし、浴尿シーンでのお漏らし\nこの作品の2,3番目のシーンと同様に\nhttps://skeb.jp/@qsy3gKonwSr62YA/works/5\n\n＊新規\n遊戯王OCGの禁じられたシリーズに登場するお姉さんと一対一のボテ腹エッチ\nhttps://www.pixiv.net/artworks/86914497\n\n同じ人物の内容では最後のリクエストになります\n\n-内容\nこの内容でキャラを変えたものです\nhttps://skeb.jp/@qsy3gKonwSr62YA/works/6\n注意点も同じです\n\n背景ストーリー\n堕天使になって力が付いたのならば昔の姿にも変身出来ると男に言われ姿を変えてみた\nその姿でエッチしたいと懇願されする事に\n出会った時のようなエッチをしてくる男に複雑な気持ち\n\n表情\nバツが悪い顔、目を男から逸らしてる\nhttps://www.pixiv.net/artworks/34376979\n目は閉じない\n\n禁じられたシリーズのお姉さん\n失楽の堕天使が天界を追放される前の姿\nhttps://www.pixiv.net/artworks/15782104\nhttps://www.pixiv.net/artworks/49424914\n頭に付ける飾りだけ着用\nhttps://www.pixiv.net/artworks/44310501\n昔の姿なので乳首の色はピンク\n\n嫁なので結婚指輪をしている\n\n男\n清い時代の姿に興奮して昔のような凌辱攻めをしている\n\n背景\n失楽の堕天使の時と同じ\n\n：カラーイラスト\n：一応ラブな感じ\n：妊娠しているので母乳出る、黒乳首(苦手なら大丈夫)\n：修正は黒線などモザイク以外\n：色々な場所で色々な人に見てもらいたいです\n：同じ内容で間を開けたい場合キャンセルでOK", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@qsy3gKonwSr62YA/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/03d84457/uploads/origins/dffcdfa5-cd15-4481-a544-921fcb028ba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6806101747bdc7d83c42aeb665dcea83", "srcset": "https://si.imgix.net/03d84457/uploads/origins/dffcdfa5-cd15-4481-a544-921fcb028ba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6806101747bdc7d83c42aeb665dcea83, https://si.imgix.net/03d84457/uploads/origins/dffcdfa5-cd15-4481-a544-921fcb028ba8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a0fc1b5e44bf717f9adc7e42577a03e1 2x, https://si.imgix.net/03d84457/uploads/origins/dffcdfa5-cd15-4481-a544-921fcb028ba8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=030575b759b9a530e918f778f3391415 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2301640, "nc": 49}, {"path": "/@qsy3gKonwSr62YA/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2301640, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32858059/uploads/origins/dfdafae9-47a1-4592-9350-0441081438a8?bg=%23fff&auto=forma