とかも大好きだし\n教師相手とか裏設定はお任せします…！！！！\n\n乱れてたらめちゃくちゃ嬉しいですー！！！！\nよろしくお願いします🤍", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@VmZ0i/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3393273, "client_id": 3295863, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23b3217b/uploads/origins/bbcd227c-3b33-4699-baeb-6753c727f2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=010cfad749641b253401134a6f2b51d8", "srcset": "https://si.imgix.net/23b3217b/uploads/origins/bbcd227c-3b33-4699-baeb-6753c727f2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=010cfad749641b253401134a6f2b51d8, https://si.imgix.net/23b3217b/uploads/origins/bbcd227c-3b33-4699-baeb-6753c727f2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85ed4c3b298be7080b8c1d886176dbf1 2x, https://si.imgix.net/23b3217b/uploads/origins/bbcd227c-3b33-4699-baeb-6753c727f2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d4203f80acc06e05708593bae846105 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23b3217b/uploads/origins/bbcd227c-3b33-4699-baeb-6753c727f2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3271e84eca9819766f495bda3316c467", "srcset": "https://si.imgix.net/23b3217b/uploads/origins/bbcd227c-3b33-4699-baeb-6753c727f2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3271e84eca9819766f495bda3316c467, https://si.imgix.net/23b3217b/uploads/origins/bbcd227c-3b33-4699-baeb-6753c727f2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0603412c0645847faefd5842fc10c536 2x, https://si.imgix.net/23b3217b/uploads/origins/bbcd227c-3b33-4699-baeb-6753c727f2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=545a10b9933525226a928e801432ba79 3x"}, "body": "錆白です！お世話になっております🙇‍♂️\n\n家畜様のイラストが本当に大好きですので、ぜひ自キャラを描いていただければなと思いskebの方リクエスト送らせていただきました✨\n\n金額不足や、知り合いからのskebを受け付けていない場合遠慮なく断っていただいて大丈夫です\n\n❶使用用途\nsnsのアイコンや、PCのデスクトップ画面に使用予定\n可能であれば今回家畜様に描いていただいたイラストを使用したデスクマットを作成予定（二次配布なし❌ 完全個人用）\n\n❷イラストの指定内容\n家畜様の絵が好きなので、どのようなものでも不満はありませんが、使用用途から横長のイラストだと嬉しいです🙇‍♂️\nもし作業の負担にならないのであれば気持ち大きめのイラストサイズですと嬉しいです☺️\n\n❸描画いただく自キャラについて\nフォルダ内にまとめてあります私の代理キャラクターを描いていただければと思っております\n固定要素としまして、髪色/目の色/髪型（主に顔周りの毛）/猫耳の帽子 が固定要素となります\n\n性別の方は特に決めてないのですが、男の子を描く時の手癖で描いておりますので一応男性かな？とおもいますが、だいぶ中性的な方ではあると思います🙇‍♂️🥲\n\n耳が見える場合ピアスを、爪が見える場合はネイルを描いていただければとても嬉しいです✨\n\nそこ以外は家畜様のオリジナルのお洋服や、デザイン改変等していただいて問題ございません🙇‍♂️\n\n自キャラを描いた時のモチーフとしましては、サブカル中華な天使/猫で錆白の白と水色イメージですが、こちらも描きにくければ要素を減らしていただいても、色味を変更していただいても特段問題ございません☺️\n\n❹納品形式\nPSD又はPNGでデータの方いただけると非常に助かります、背景透過等は不要です⭕️\n\n上記内容でリクエスト内容以上になります🙇‍♂️\n家畜様に描いていただきたいと思い立ち、すぐにキャラデザを用意しましたので、参考資料の方拙い部分が多く分かりにくいところ等沢山あると思いますので、そういった場合はオリジナル要素を付け加えていただければ嬉しいです☺️\n\n初めてのskebリクエストということもあり、長文乱文失礼いたしました🙇‍♂️\nとても寒い日が続きますので、ご自愛ください‪✨️\nご縁がありますように🍀\n\nhttps://drive.google.com/drive/folders/1NYlsqrfdBxdizklU1I26JGQvJ9OsLIf4", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1027053, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "セーカ", "screen_name": "seka_sea", "avatar_url": "https://pbs.twimg.com/profile_images/1676125102050799616/IxMYorRY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3238642394/1699186503/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 144}, {"id": 1221576, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "mtn", "screen_name": "mtnmy_", "avatar_url": "htt