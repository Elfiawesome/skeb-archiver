3-b72e-7cfd8de19b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3777acb01655ebb83515b7d15ecd40ca, https://si.imgix.net/22dc7905/uploads/origins/22e909d0-8631-4f13-b72e-7cfd8de19b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd13b439ca1a889fcbf73dc47c179fc4 2x, https://si.imgix.net/22dc7905/uploads/origins/22e909d0-8631-4f13-b72e-7cfd8de19b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ac8a27f84060bcad813a57728de3eda4 3x"}, "body": "ふたなりの錠前サオリさんが女先生を乱暴に犯しているところをお願いします。\nサオリさんは我慢しきれず女先生を身体目当てで襲ってひたすら性欲をぶつけていて、\n女先生もサオリさんの顔がいいのであまり抵抗しておらず嫌がっていない様子だととても嬉しいです。\nふたなりはあくまでサオリさんと女先生をどうしてもどろどろに爛れた肉体関係にしたいがために分かりやすい記号として設定しているに過ぎず、\nふたなりであることを強調するような構図にしていただく必要はなく、ふたなりであることが分からなくても結構です。\n女先生のキャラデザは任意で細かな指定はありませんが、件のアロナちゃんの似顔絵やアニメ先生に引っ張られないよう、TSやボーイッシュではなく女性っぽくお願いしたいです。\n\nこれまで他の方にも同様のシチュを描いていただいており、\nあかりう先生に今回描いていただく作品の内容を問わず、これから他の方にも同様のシチュを描いていただく可能性がありますが、\n他の方のこれまで描いていただいた作品に満足していないということや、\nあかりう先生に今回描いていただく作品に満足しないということでは決してないということを予め明記します。\nこのような背景を隠すのは公平ではないと考えているため明記しましたが、お気に障るようでしたら蹴っていただければと思います。\n\nよろしくお願いします", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kami_Ninoooburu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3860562, "client_id": 3966308, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba7f5877/uploads/origins/c62ead09-c6c8-4a71-9223-40e0adcf7d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=999d44922840dc36895fd18830d993c0", "srcset": "https://si.imgix.net/ba7f5877/uploads/origins/c62ead09-c6c8-4a71-9223-40e0adcf7d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=999d44922840dc36895fd18830d993c0, https://si.imgix.net/ba7f5877/uploads/origins/c62ead09-c6c8-4a71-9223-40e0adcf7d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80960b86c7d9f6e73641cb35aa51305e 2x, https://si.imgix.net/ba7f5877/uploads/origins/c62ead09-c6c8-4a71-9223-40e0adcf7d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35fd4430efd48d7cdb97ba1b3d885538 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba7f5877/uploads/origins/c62ead09-c6c8-4a71-9223-40e0adcf7d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66443a3a8d1af35406a15830efe3e899", "srcset": "https://si.imgix.net/ba7f5877/uploads/origins/c62ead09-c6c8-4a71-9223-40e0adcf7d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66443a3a8d1af35406a15830efe3e899, https://si.imgix.net/ba7f5877/uploads/origins/c62ead09-c6c8-4a71-9223-40e0adcf7d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d2e7abecff30649fde252dd02e037637 2x, https://si.imgix.net/ba7f5877/uploads/origins/c62ead09-c6c8-4a71-9223-40e0adcf7d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=864b4d9f61c156a839fa6629e7b490e0 3x"}, "body": "あかりう様初めましてこんにちは。\nリクエストの希望ジャンルはイラストとしましたが短編漫画を希望します。そのため金額に都合があれば変更お願いします。\n以前pixiv上で拝見させていただいた男の娘床オナ漫画を見させていただきました。大変素晴らしい作品でしたのでこのリクエストではその続きを描いていただきたく思います。構図の希望はありませんが「床オナ射精からのオナバレ」というシチュエーションを添えていただきたいです。\nリクエストは以上になりますが最後に一点、男の娘床オナバレ漫画を是非再投稿されるように願っております。大変おこがましいリクエストになりますが是非ご検討の程よろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kami_Ninoooburu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3860562, "client_id": 426292, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b92730d6/uploads/origins/1bb1341e-cc27-459f-801a-92ce938d7dec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e444afa524844d19881d3a7e4ae7c58", "srcset": "https://si.imgix.net/b92730d6/uploads/origins/1bb1341e-cc27-459f-801a-92ce938d7dec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e444afa524844d19881d3a7e4ae7c58, https://si.imgix.net/b92730d6/uploads/origins/1bb1341e-cc27-459f-801a-92ce938d7dec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ffbd1c54978f6add9133f7c418f7d499 2x, https://si.imgix.net/b92730d6/uploads/origins/1bb1341e-cc27-459f-801a-92ce938d7dec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2c475e0b10f3f68cb82ca9199eb8750 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b92730d6/uploads/origins/1bb1341e-cc27-459f-801a-92ce938d7dec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58ced3c40a2ee2e57bdd6247847f8550", "srcset": "https://si.imgix.net/b92730d6/uploads/origins/1bb1341e-cc27-459f-801a-92ce938d7dec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58ced3c40a2ee2e57bdd6247847f8550, https://si.imgix.net/b92730d6/uploads/origins/1bb1341e-cc27-459f-801a-92ce938d7dec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c1dbc59115dff8b902da0dd79cf678d2 2x, https://si.imgix.net/b92730d6/uploads/origins/1bb1341e-cc27-459f-801a-92ce938d7dec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=47c7b4fd5118b5d05b66c91704c28b80 3x"}, "body": "はじめまして、リクエスト失礼します\n［ブルアカ､ふた×男､逆アナル］\nシチュ\n・玉付きふたなり巨根の桜井ミヨが愛しの男先生をバックで犯しながら濃厚精液を大量に中出ししてボテ腹にする\n・彼女は着衣姿でドSな表情をしながら巨乳の生乳を揺らし、彼の尻を揉みしだきながら首輪を引っ張っている\n・男先生はドMで短小チンポ、勃起乳首のメス堕ち状態", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kami_Ninoooburu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3860562, "client_id": 1763248, "vtt_url": null, "thumbnail_image_urls": {