強は苦手であり授業も退屈そうに寝ている\n・オカルト部にいるが怖いものが苦手\n・デリカシーがないときがある\n\n【関係性】\n同じオカルト部の部員。\n隣の席になった芒崎を、白菊が部活に誘った。\n背が大きい芒崎の後ろで小さく縮こまっている。\n\n恋人…？将来そうなるかもしれない。\nまだ芒崎に恋心が分からないのでふんわり一緒に住んでいる。\n表でスキンシップをするのは恥ずかしいので家の中でひっついている。\n周りの誰にも関係のことを明かしていない。\n\n【使用用途】\n使用用途は個人鑑賞と商用ではないグッズへの利用、もう1人のオリジナルキャラクターをデザインしている相方への共有、SNSでのアイコンやヘッダー等で使用させていただければと思います。\n\n構図シチュエーションは全ておまかせ致します。\n髪型衣装共に変えていただいても大丈夫です。\n🔰慣性🔰様の透明感のあり、かわいらしいイラストが大好きなので、二人とも男の子ですが自由に描いていただけると嬉しいです。\n\n内容と金額が釣り合ってない場合は再送下さい。\nご縁があると嬉しいです！\n\nご検討何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1aGwY6-FX1diGleZRkHI07v2LfyVtygTq?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dsienk0505/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3646369, "client_id": 3655545, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8979895d/uploads/origins/95f7cd73-5082-4c19-a4a9-349991c42583?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ae702546d8b7a097be90f54d377e4da", "srcset": "https://si.imgix.net/8979895d/uploads/origins/95f7cd73-5082-4c19-a4a9-349991c42583?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ae702546d8b7a097be90f54d377e4da, https://si.imgix.net/8979895d/uploads/origins/95f7cd73-5082-4c19-a4a9-349991c42583?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ca7e445fca086a5c2e5c2f39d8e454d 2x, https://si.imgix.net/8979895d/uploads/origins/95f7cd73-5082-4c19-a4a9-349991c42583?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a18ac7850d3a860a19081c0d9075be33 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8979895d/uploads/origins/95f7cd73-5082-4c19-a4a9-349991c42583?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=661ee3eacbd1674ffa3b9bfe5addf0b5", "srcset":