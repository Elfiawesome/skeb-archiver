bd30-935c43e58841?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e69c0c6efbb7286a99832023e298f4c, https://si.imgix.net/a3f43557/uploads/origins/238ae8ae-20cb-4405-bd30-935c43e58841?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acc055b72f4cea96d974936aaf58df37 2x, https://si.imgix.net/a3f43557/uploads/origins/238ae8ae-20cb-4405-bd30-935c43e58841?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff29e1f74b260327c028ae926f342fe5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a3f43557/uploads/origins/238ae8ae-20cb-4405-bd30-935c43e58841?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62db27ae7766a0503c1b1c9e00d80641", "srcset": "https://si.imgix.net/a3f43557/uploads/origins/238ae8ae-20cb-4405-bd30-935c43e58841?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62db27ae7766a0503c1b1c9e00d80641, https://si.imgix.net/a3f43557/uploads/origins/238ae8ae-20cb-4405-bd30-935c43e58841?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=68a103ca414ba02e2d036accec930592 2x, https://si.imgix.net/a3f43557/uploads/origins/238ae8ae-20cb-4405-bd30-935c43e58841?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=388f096ab7f2b5e141c3ac5798ef0ff7 3x"}, "body": "絵柄が素敵だったのでご依頼しました。\nうちのOCの「鮫氷しゃち」をお願いすることは可能でしょうか？ \n参考までに設定は以下のとおりですが、テーマや構図等は自由に決めていただいて構いません。\n███\n鮫氷 しゃち（さめすが しゃち）\n細身かつ色白の黒髪ロングストレート。\n白と黒を基調にしたセーラー服にセーラーキャップを着こなす。\nアイドル的な元気さと明るさに加え、清楚で可憐な容姿をしている。 \n好奇心旺盛で趣味はテーマパーク巡りと人間観察。\nかなりの偏食家で、気に入ったものはヘビロテする。その一方で飽きるのも早い。  \n親しい間柄の相手でさえ巧みに感情を操って都合よく利用する。\nその言動はどこか演技的で大げさ。\n先天的に共感性が欠落しており、一見感情のように見えるものは人間観察の結果身に着けたものでしかない。\n███\n宛名・背景はpsdでon/offできると幸いです。\n使用用途は個人活動全般（動画配信の待機画面等、個人サイトやSNSでの小説の挿絵、キャラ紹介、個人活動の告知、トリミング加工を伴うアイコン・ヘッダー・バナーとしての使用等、コミッションサイトでのイラスト等依頼時に参考資料等）を考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/15QcfblJ6ABjLUrKZ3ijKi-ncxD6c6GKd", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1635759, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Rayn", "screen_name": "Rayn87250715", "avatar_url": "https://pbs.twimg.com/profile_images/1989723864847544320/kkiYvFLK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1105708934864691200/1639706162/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 40, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 1}, {"id": 1988723, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ひなちひら", "screen_name": "hinachihira", "avatar_url": "https://pbs.twimg.com/profile_images/1993596269017939971/v-modSyM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1066653961078288386/1734970007/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 145}, {"id": 2523300, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "擬吉", "screen_name": "modo_kittan", "avatar_url": "https://pbs.twimg.com/profile_images/1702652685105897472/u6CY58tA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1550666633483816960/1715438060/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art