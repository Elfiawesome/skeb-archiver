client_id": 2236192, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@period_periodot/works/53", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": true, "creator_id": 228011, "client_id": 219490, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7feb139/uploads/outputs/4c71f7cf-5b94-41c5-9804-26c48301c045?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=dcb51f69916793259be1a08130033ce1", "src_set": ""}, "duration": 1, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7feb139/uploads/outputs/4c71f7cf-5b94-41c5-9804-26c48301c045?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=8e5b64088cc2053e2a221503775a3aba", "src_set": ""}, "body": "こんにちは！あなたの作品のファンです！\n\nラグナロクオンラインのオリジナルキャラクターとNPCの映像をお願いしたいです。NPCの名前はミリアムで、オリジナルキャラクターは「エイリアスダーク」というシャドウチェイサーです。\n\nシチュエーションは、2人が路地で秘密のハードなドギースタイルセックスをするというもの。舞台はこの街：\n\nhttps://ragnarokonline.gungho.jp/special/fankit/assets/img/background/city-background/map_rachel.png\nhttps://ragnarokonline.gungho.jp/special/fankit/assets/img/background/city-background/map_rachel_2.png\n\n既存の作品をベースにしたポーズが欲しい：\n\nhttps://www.pixiv.net/en/artworks/109702780\n\n元のキャラクターは大体200.66cmなので、サイズ差があるはずです。彼女の髪を引っ張りながら容赦なく叩いて、もう片方の手には彼女の青いパンティを持ってほしい。両者とも部分的に服を着ていて、彼女の胸は激しさのあまり外に出て跳ねているはずだ。\n\nhttps://x.com/ChaserNsfw/status/1937345850390298657", "nc": 176, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@period_periodot/works/52", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": true, "creator_id": 228011, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e8534fd/uploads/outputs/70fc668b-3f9c-488e-9a64-665233b18306?