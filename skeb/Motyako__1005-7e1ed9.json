t%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c1c3df38b9f4a4119439d342f7a2bfb5 3x"}, "body": "私のオリジナルキャラクターであるドラゴンの「ルナ」を描いていただけないでしょうか。彼女は、おちゃめで優しいドラゴンの女性です。たくさんの衣装を所有しています。心は優しく、穏やかです。瞳の奥には炎が宿っています。普段は肌をあまり見せたくないため、服装は控えめです。  今回のスケッチでは、頭にドラゴンの角をつけて描いていただけると嬉しいです。 \nhttps://i.imgur.com/8BK17d0.png https://i.imgur.com/uykAoJK.png https://i.imgur.com/4Zr8cBs.png https://i.imgur.com/aqwblG4.png https://i.imgur.com/rHV2uMX.jpg https://i.imgur.com/c5TcMGB.jpg https://i.imgur.com/fOAQeXb.png https://i.imgur.com/jVq9DiN.png https://i.imgur.com/z9SFe2k.png https://i.imgur.com/ieeyKif.png", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Motyako__1005/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4042637, "client_id": 3032600, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b53212f9/uploads/origins/51bea233-18d3-4c35-8fb3-24f477225a99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f6bd94b7ea571063c65d5990c55c746", "srcset": "https://si.imgix.net/b53212f9/uploads/origins/51bea233-18d3-4c35-8fb3-24f477225a99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f6bd94b7ea571063c65d5990c55c746, https://si.imgix.net/b53212f9/uploads/origins/51bea233-18d3-4c35-8fb3-24f477225a99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a2912d7d741893033bd8d68dae49126 2x, https://si.imgix.net/b53212f9/uploads/origins/51bea233-18d3-4c35-8fb3-24f477225a99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ef687c0a91768f0c47d3c451fe536d5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b53212f9/uploads/origins/51bea233-18d3-4c35-8fb3-24f477225a99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca357089ebde96a05148aaac05d5e60d", "srcset": "https://si.imgix.net/b53212f9/uploads/origins/51bea233-18d3-4c35-8fb3-24f477225a99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca357089ebde96a05148aaac05d5e60d, https://si.imgix.net/b53212f9/uploads/origins/51bea233-18d3-4c35-8fb3-24f477225a99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ea8d2cf857bdb72c1c09bfbf1f77d59 2x, https://si.imgix.net/b53212f9/uploads/origins/51bea233-18d3-4c35-8fb3-24f477225a99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0325155d4a7f5bd813c8b6215fa2f763 3x"}, "body": "もちゃこ先生、こんにちは。先生のイラストが大好きです！本当にとても可愛いです！！\n特に、先生が描かれる女の子と人外の組み合わせが大好きです。とても仲が良く、優しく、調和の取れた雰囲気があって、その空気感にとても惹かれます！\n\n今回は、私のOCと青い幽霊の動物を描いていただけたら嬉しいです。\nどうぞ先生のご自由に描いてください！\n\nOC設定\n身分：\n人間によって作られた小さな使い魔です。\n外見：\n身長155cm\n見た目は12歳くらい\n実際は生まれてまだ7か月です。\n性格：\n表向きは静かで素直な子です。\nでも本当は世界にとても興味があり、内面はとても活発で、楽しそうに世界を探検することが大好きです。\n特徴：\n額につけた緑色のリボン（とても重要な固定デザインです）\n宝石のような緑色の瞳\nきれいに揃った前髪\n狐のような大きくふさふさした耳と尻尾\n\n彼女のそばには、青い幽霊の友達が現れます。\n\nその幽霊は少し意地悪な性格で、いつも彼女を人類から裏切るよう誘惑しています。\n\n幽霊には3種類の異なる姿がありますので、お好きなデザインを1つ選んで描いていただけたら嬉しいです。\n\nhttps://drive.google.com/drive/folders/1w4Hr_7vVZFYaDQEo_VYsayz-GhUFSsiN?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Motyako__1005/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4042637, "client_id": 2462364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98b55961/uploads/origins/7c4f2ace-5262-4d39-8e1a-e2fb6378a726?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a26c059a7c7e7e4512b0619553d0908e", "srcset": "https://si.imgix.net/98b55961/uploads/origins/7c4f2ace-5262-4d39-8e1a-e2fb6378a726?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a26c059a7c7e7e4512b0619553d0908e, https://si.imgix.net/98b55961/uploads/origins/7c4f2ace-5262-4d39-8e1a-e2fb6378a726?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12b477ffcabd9578a01c56881ac478bc 2x, https://si.imgix.net/98b55961/uploads/origins/7c4f2ace-5262-4d39-8e1a-e2fb6378a726?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=edb1c87b76393482f6a52eb81aa309eb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98b55961/uploads/origins/7c4f2ace-5262-4d39-8e1a-e2fb6378a726?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df91aaebf23e43bc3db9cbd2ce9b15a0", "srcset": "https://si.imgix.net/98b55961/uploads/origins/7c4f2ace-5262-4d39-8e1a-e2fb6378a726?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df91aaebf23e43bc3db9cbd2ce9b15a0, https://si.imgix.net/98b55961/uploads/origins/7c4f2ace-5262-4d39-8e1a-e2fb6378a726?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e345eecb7d3f1f86be3c65577a0b0ca1 2x, https://si.imgix.net/98b55961/uploads/origins/7c4f2ace-5262-4d39-8e1a-e2fb6378a726?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c7285eb8e3fe5c0aac1eb899da72856f 3x"}, "body": "先生、こんにちは！またお邪魔して申し訳ありません。もしよろしければ、今回は私のオリジナルキャラクター（OC）の姉妹に関する作品を作成していただけないでしょうか。以下に彼女たちの簡単な紹介を記載します↓  \n\nヒルダ：栗色の長い髪で、静かで大人しく、お利口で美しい。少し変わり者なところがあり、リリアナの姉。作り出された魔女（画像17-18） \n\nリリアナ：金色の長い髪。可愛らしく活発な「アメリカン・スウィートハート」。想像を超える無邪気さと明るい性格の持ち主。創造された魔女であり、豊かな人間の感情を持ち、家族をとても大切にしている（画像19-21）\n\n衣装は自由に描いていただいて構いません！（別々に描いていただいても全く問題ありません！）リンク先に詳細な設定や資料を掲載しています。もし報酬額に合わない場合は、再度リクエストを送っていただけると大変助かります！もし今回の依頼をお引き受けいただけましたら、心より感謝いたします！  \n\n https://drive.google.com/drive/folders/13qC9JytxXwQ2G-X7q6VxWOe2oXlCbqke?usp=share_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Motyako__1005/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4042637, "client_id": 569053, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fcc290bb/uploads/origins/01e9554b-c62f-4abe-ae46-1b207350a5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aad310d62e696699e7831124d6f1e8da", "srcset": "https://si.imgix.net/fcc290bb/uploads/origins/01e9554b-c62f-4abe-ae46-1b207350a5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aad310d62e696699e7831124d6f1e8da, https://si.imgix.net/fcc290bb/uploads/origins/01e9554b-c62f-4abe-ae46-1b207350a5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2793903f197362b193dca274c8efabe4 2x, https://si.imgix.net/fcc290bb/uploads/origins/01e9554b-c62f-4abe-ae46-1b207350a5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb0226bb9bfe8a464e12eae655a5865e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fcc290bb/uploads/origins/01e9554b-c62f-4abe-ae46-1b207350a5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c76edbd3c9e0f94505e1baf6ec7bf02", "srcset": "https://si.imgix.net/fcc290bb/uploads/origins/01e9554b-c62f-4abe-ae46-1b207350a5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c76edbd3c9e0f94505e1baf6ec7bf02, https://si.imgix.net/fcc290bb/uploads/origins/01e9554b-c62f-4abe-ae46-1b207350a5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a37235bd6c127cbbd7838ce3ef2c545a 2x, https://si.imgix.net/fcc290bb/uploads/origins/01e9554b-c62f-4abe-ae46-1b207350a5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fac95fcb9468b68a738a071e538a3f84 3x"}, "body": "もちゃこ先生、はじめまして！\nぜひこちらのキャラクターを描いていただきたく、リクエストさせていただきました。\n簡単にキャラクターの設定をご紹介します。\n16歳の女子高校生で、青いセンター分けのショートヘアに赤い瞳、身長は162cmほどです。\n人当たりがよく、周囲からは真面目で頼りになる優等生として見られていますが、内面にはちょっと中二病めいた独特の感性があり、普段の印象からは想像しにくい、意外とダークな一面もあります。\n実家は医療関係の会社を経営しており、比較的裕福な家庭で育ちました。\nオカルトや神秘学が大好きで、同じ趣味を持つ幼馴染との関わりをきっかけに、どうやら本物の超常的な力にも触れてしまったようです。\nまた、幼い頃の事故で脚に傷跡が残っているため、普段は脚を隠すような服装をしています。\n衣装は、リンク先にあるものの中から、もちゃこ先生のお好きなものを自由に選んでいただいて大丈夫です！\n等身で描いていただけたら嬉しいです。\nポーズや構図、シチュエーションなども、ぜひお好きなように自由に描いていただけたらと思います！\n資料や金額等に不備がございましたら、ご指摘いただけますと幸いです。必要でしたら再送いたします。\nもし難しいようでしたら、どうかご無理なさらずキャンセルしていただいて構いません。\nご検討いただけましたら嬉しいです。\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/file/d/1L-nLGjS52EMquOzZ3YHMoxXFhuOXIgOJ/view?usp=sharing", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Motyako__1005/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4042637, "client_id": 1235038, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc6f99af/uploads/origins/cc4be881-72f8-438f-848e-e9019998da9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ad763be5166b909d423b66ecbf2cc46", "srcset": "https://si.imgix.net/cc6f99af/uploads/origins/cc4be881-72f8-438f-848e-e9019998da9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ad763be5166b909d423b66ecbf2cc46, https://si.imgix.net/cc6f99af/uploads/origins/cc4be881-72f8-438f-848e-e9019998da9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe846c678784b766103eb6edca5b0e8d 2x, https://si.imgix.net/cc6f99af/uploads/origins/cc4be881-72f8-438f-848e-e9019998da9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fca8b9887b9032c4b4de2323ea0f3657 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc6f99af/uploads/origins/cc4be881-72f8-438f-848e-e9019998da9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d25b15d02f506a8c8a53d7607e543f69", "srcset": "https://si.imgix.net/cc6f99af/uploads/origins/cc4be881-72f8-4