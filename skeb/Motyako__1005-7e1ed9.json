t%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd2e8ad197c2ba4a6b0f21dd51c30ce8 3x"}, "body": "こんにちは、もちゃこ様！\n私をあなたの絵のスタイルがとても好きです。私のOCを描いてもらえますか？\n可能であれば、それぞれに適したポケモンを選んでいただけると嬉しいです！追加しなくても大丈夫です。\n\n三夕：水色髪と金色の目をした大正時代のメイドです。陽気で活発、古霊精怪いたずら好き。リボンは赤と白の四角の模様で、赤の四角には縦線が入っている。服装はエプロンと着物。\n\n三沢:水色髪と金色の目、大正時代の男子学生で、楕円形の眼鏡をかけている。あの娘の相手は苦手だ。喫茶店にはよく来ていて、よくミルクを注文する。なぜあの子がいつも自分に悪戯をするのかよく理解できず、少し気にしている。趣味は読書、特技はツッコミ。\n\n三夕はからかうのが好きで、三沢をからかっています。三沢は彼女の行動を理解しておらず、顔を赤くして相手に突っ込みますが、彼女の行動を拒否することは全くありません。\n\n関係する小物はオブジェでもいいし、明治や大正時代の食べ物でもいい（情景を描く必要がある状況：上記の時代の茶店や場所でもいい）\n\nキャラクターの絵の参考は下のURLにあります！\n\nよろしければ、最後にpsdファイルを渡してください！\n下書きや作業中のスケッチがあれば、一緒に入れてもらえると嬉しいです。とても気に入っています。ありがとうございます。この納品を快く引き受けてくださるなら、とてもありがたく、嬉しいです。字が多くてごめんなさい！読んでいただきありがとうございました！\n\n金額が足りない場合は、安心してキャンセルするか、再送を提出することができます ！私はできる限りのことをします！ ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1Qhy_QO50FZEileNqGOUKNCHhVTH6i3QB?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 915491, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "水野®︎", "screen_name": "mznr_52", "avatar_url": "https://pbs.twimg.com/profile_images/1337381583871901700/IBolzj9l.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1043825302734921728/1609699359/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 65, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 2625281, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "uaaan", "screen_name": "uaaannn", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fwebpublic-0490125e-d198-488d-90ae-3622da931e06.webp?avatar=1", "header_url": null, "appeal_receivable": false, "popul