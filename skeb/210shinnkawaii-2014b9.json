の投稿や収益化したライブ配信や動画、アイコンやヘッダー使用、ネットプリント、グッズ、ファンボックスなどのVTuberとしての活動で使用させていただければと思っております。\n\n立ち絵などの資料は下記URLから確認していただければと思います。\n\n\n\nスケブでの依頼は慣れていないので至らない点があると思いますが、よろしくお願いします。\n\nhttps://lit.link/mewaurora\n\nhttps://lit.link/mewaurora", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@210shinnkawaii/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3526718, "client_id": 3934102, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc36ad89/uploads/origins/3d0f21e8-8743-4e78-93bc-add2065f9f45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=869cbc24eb776460026267c62f460f6f", "srcset": "https://si.imgix.net/cc36ad89/uploads/origins/3d0f21e8-8743-4e78-93bc-add2065f9f45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=869cbc24eb776460026267c62f460f6f, https://si.imgix.net/cc36ad89/uploads/origins/3d0f21e8-8743-4e78-93bc-add2065f9f45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14e673aa436814fc680fb2d4659cf463 2x, https://si.imgix.net/cc36ad89/uploads/origins/3d0f21e8-8743-4e78-93bc-add2065f9f45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=636d7864c407947b2b31f0abf99ef983 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc36ad89/uploads/origins/3d0f21e8-8743-4e78-93bc-add2065f9f45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7833df0b271a357e11c86a470750ff48", "srcset": "https://si.imgix.net/cc36ad89/uploads/origins/3d0f21e8-8743-4e78-93bc-add2065f9f45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7833df0b271a357e11c86a470750ff48, https://si.imgix.net/cc36ad89/uploads/origins/3d0f21e8-8743-4e78-93bc-add2065f9f45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c9469f74924b1fa76e06a77a4e76c5bd 2x, https://si.imgix.net/cc36ad89/uploads/origins/3d0f21e8-8743-4e78-93bc-add2065f9f45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=826a7321a7b9bb6fb0f04b22fb53a79f 3x"}, "body": "ｶｴﾁ様\n\n初めまして。うづき桜歌と申します。\n先日見かけた四季送りNPCのイラストが素敵でぜひ自PCとNPCが一緒にいるイラストをおねがしたいと思いリクエストを送らせていただきました。\n可能でしたら香華さん、14番と一緒にいる一枚絵をお願いできればと思います。\n\n使用用途\n個人観賞用でスマホやパソコンのホーム画面に使用\n\n以下詳細になります。\n名前　望桜（はるの）\n四季送り　HO春\n年齢　21歳\n身長165㎝\n髪色　黄緑にピンクのメッシュ\n目の色　ピンクと黄緑\n\n以下参考資料になります。\nhttps://drive.google.com/drive/folders/1hIjFl1m25maa8CcpnKArHZy13HQTLqkp?usp=sharing\n\n構図はお任せしますができれば家族仲良くしている感じのイラストですと嬉しいでです。\n\n以上になります。\nぜひご検討いただけますと幸いです。\nよろしくお願いします\n\nhttps://drive.google.com/drive/folders/1hIjFl1m25maa8CcpnKArHZy13HQTLqkp?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@210shinnkawaii/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3526718, "client_id": 3561007, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a51a3b7/uploads/origins/f05c34c2-fd23-49f4-8e09-6968f3f37b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5278242c657342ecb19f4e5ca8f13bc2", "srcset": "https://si.imgix.net/2a51a3b7/uploads/origins/f05c34c2-fd23-49f4-8e09-6968f3f37b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5278242c657342ecb19f4e5ca8f13bc2, https://si.imgix.net/2a51a3b7/uploads/origins/f05c34c2-fd23-49f4-8e09-6968f3f37b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0138c5de4f5a2d785363051ec6ba66dc 2x, https://si.imgix.net/2a51a3b7/uploads/origins/f05c34c2-fd23-49f4-8e09-6968f3f37b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5e9c32fac7f3d3ddbba03cd37136117 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://