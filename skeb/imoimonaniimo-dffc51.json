: false}, {"path": "/@supamon_NK/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2292416, "client_id": 1596020, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/839b8548/uploads/origins/387cd940-b57d-43f1-a3bc-4d190da71b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=060deb0b14b9c3eabf92a1c1355110b5", "srcset": "https://si.imgix.net/839b8548/uploads/origins/387cd940-b57d-43f1-a3bc-4d190da71b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=060deb0b14b9c3eabf92a1c1355110b5, https://si.imgix.net/839b8548/uploads/origins/387cd940-b57d-43f1-a3bc-4d190da71b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6bd88c23f9a83ec9b132e83eb450a8f9 2x, https://si.imgix.net/839b8548/uploads/origins/387cd940-b57d-43f1-a3bc-4d190da71b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ecc192853ca38d54d7709fb9b036ebd1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/839b8548/uploads/origins/387cd940-b57d-43f1-a3bc-4d190da71b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=140b0078a77155146f6959fe17d3c9c1", "srcset": "https://si.imgix.net/839b8548/uploads/origins/387cd940-b57d-43f1-a3bc-4d190da71b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=140b0078a77155146f6959fe17d3c9c1, https://si.imgix.net/839b8548/uploads/origins/387cd940-b57d-43f1-a3bc-4d190da71b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b9b877a7b2abc1a981f268f1fdaa5123 2x, https://si.imgix.net/839b8548/uploads/origins/387cd940-b57d-43f1-a3bc-4d190da71b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b08aa3c0efc70503c327151bf8048525 3x"}, "body": "いつも素敵なイラストを拝見しております！\nオリキャラの女の子をリクエストさせて頂きたいです。\n\n衣装や髪型に関しては設定通りでも、スパ狂さんが考えて下さっても嬉しいのでお任せ致します。衣装の簡略化等して下さっても構いません。\n以下キャラクター詳細になります。\n\n・髪型\n黒髪の長髪を赤いリボンでポニーテールにしている。前髪はセンター分けで、肩上まで横髪を垂らしている。\n先述の通り衣装改変等はお任せしますが、赤いリボンは描写して頂きたいです。\n\n・目元\n猫目でぱっちりとしたつり目をしています。瞳は金色で瞳孔付近に赤のハイライトが入っています。スパ狂さんのまつ毛の描写が大好きなので、是非まつ毛ぱっちりで描いて頂きたいです。\n\n・衣装\n白のブラウスに黒のタイトスカート、足元は黄色のタイツと黒の厚底ヒールを着用しています。首元でジャボをブローチで留めています。\n\n・性格、表情\n気の強く一匹狼な性格で、引き締まった顔をしている事が多いです。笑顔で描いて下さる場合はどちらかと言うと強気な微笑みといった雰囲気で書いて頂けると嬉しいです。\n\n以下に資料のリンクを示させて頂きます。\nhttps://twitter.com/imoimonaniimo/status/1562981095012188160?s=21&t=rQvvjvIbqYZFRyJ5OmXK7w\n1枚目の画像が設定資料です。2枚目と3枚目は見辛いものではありますが、衣装の改変をして下さる場合の許容範囲や、表情の雰囲気の参考になればと添えさせて頂きます。\n\n長々と失礼致しました。ご縁がありましたらどうぞよろしくお願いします。\nこれからも活動を心から応援しています！！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oyasumi0419/works/39", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1624123, "client_id": 1596020, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1386a9f0/uploads/origins/dbd9258d-4dbd-4515-a0b5-55b4eb2f585d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85f5cacaf4ce7dd4d5b422ab9d059b46", "srcset": "https://si.imgix.net/1386a9f0/uploads/origins/dbd9258d-4dbd-4515-a0b5-55b4eb2f585d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85f5cacaf4ce7dd4d5b422ab9d059b46, https://si.imgix.net/1386a9f0/uploads/origins/dbd9258d-4dbd-4515-a0b5-55b4eb2f585d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=002ec1522d749be8fe1c73216a7c402d 2x, https://si.imgix.net/1386a9f0/uploads/origins/dbd9258d-4dbd-4515-a0b5-55b4eb2f585d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5d8f41b8576b833d3fe4ab062e269e2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1386a9f0/uploads/origins/dbd9258d-4dbd-4515-a0b5-55b4eb2f585d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20ff216cf15ae42c4e633e84457d1c20", "srcset": "https://si.imgix.net/1386a9f0/uploads/origins/dbd9258d-4dbd-4515-a0b5-55b4eb2f585d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20ff216cf15ae42c4e633e84457d1c20, https://si.imgix.net/1386a9f0/uploads/origins/dbd9258d-4dbd-4515-a0b5-55b4eb2f585d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=43a0480cb07a840237cdcc19268a7e09 2x, https://si.imgix.net/1386a9f0/uploads/origins/dbd9258d-4dbd-4515-a0b5-55b4eb2f585d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eb63607f44b378c7936c2e51956b8069 3x"}, "body": "つるはさんの素敵なイラストいつも拝見しております！\nこの度はオリキャラの双子の姉弟をリクエストさせて頂きたいです。\n以下キャラクター詳細になります。\n\n・双子の姉\n(容姿)\n金髪ボブ。左の横髪を耳にかけており癖がついている。青い瞳。丸めの目。少し太めな眉。胸のサイズは中くらいです。ブラウスとスカートにコルセット、青いタイツを着用しています。\n(性格)\nお姉さん気質で聡明、おっとりした女性です。弟のことを一番大切に思っています。\n\n・双子の弟\n(容姿)\n金髪ショート。青い瞳。丸めの目(丸めの目ですが、つるはさんのシュッとした男性の目がかっこよくて大好きなので手癖で描いていただいて大丈夫です。)。少し太めな眉。\n(性格)\n穏やかな性格でお兄さんらしい振る舞い。姉同様、姉のことを一番大切に思っていますが姉よりも相手に対する依存度が高いです。\n(その他)\n衣装の簡略化や改変等はおまかせしますが、潔癖症設定なので手袋は描写して頂けると嬉しいです。\n\n・関係性、雰囲気\n双子で教会を営んでおり、周囲の人間から保護者として慕われていますが、二人の世界を持っている雰囲気があります。\n二人の世界、共依存的な雰囲気で描いてくださっても、穏やかなお兄さんお姉さんという雰囲気で描いてくださっても大丈夫です。おまかせ致します。\n\n特にアイコン用、ヘッダー用といった用途は考えていないので、縦横比などはおまかせ致します。\n\n参考資料としてこちらを添付致します。衣装で分かりにくい部分等ありましたら簡略化や改変して頂いて大丈夫です。\nhttps://twitter.com/imoimonaniimo/status/1542761175389450240?s=21&t=PbBhFxEdwoUzIKMo6fl5-w\n\n長々と失礼致しました。ご縁がありましたらどうぞよろしくお願いします。\nこれからも活動を心から応援しております！！\n\nhttps://twitter.com/imoimonaniimo/status/1542761175389450240?s=21&t=5RBOYRS5cJNGDkMRvq1ONA", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 574999, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "イマ茸🍄めづお", "screen_name": "Im0_kinoko", "avatar_url": "https://pbs.twimg.com/profile_images/1743510442872651776/I_WMfyTA.png", "header_url": "ht