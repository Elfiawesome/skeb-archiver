 https://si.imgix.net/20538549/uploads/origins/abf8e75c-3c74-409b-80d5-dccb357e6115?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a6d7c7a27ec659c08ce258d7b29d776a 3x"}, "body": "Xでとても可愛い美少年のイラスト拝見させてもらっています。\nぜひ先生に僕のお姿を描いていただきたいと思い依頼のお願いです。\n先生から見る僕の魅力を引き出してもらえたらと思い、服装含めて自由に描いてもらえたらと思います。\n使用範囲は、自分のSNS（主としてX）のアイコンやツイート時の画像、配信中の画像やサムネイルを想定しています。\nどうかよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1CDp1BBH-vnAr3FRXPnVz_UK5kaskRsex/view?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nagaredeta/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3236897, "client_id": 3062108, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/768e6253/uploads/origins/5c6a7a3d-9448-4ed6-bc74-e13839e295fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b3f0bce2bf77375ea0ed114ca0aba82", "srcset": "https://si.imgix.net/768e6253/uploads/origins/5c6a7a3d-9448-4ed6-bc74-e13839e295fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b3f0bce2bf77375ea0ed114ca0aba82, https://si.imgix.net/768e6253/uploads/origins/5c6a7a3d-9448-4ed6-bc74-e13839e295fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=960ead109ccfa9d416bd4583b01108ca 2x, https://si.imgix.net/768e6253/uploads/origins/5c6a7a3d-9448-4ed6-bc74-e13839e295fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5b5f8186975fce6968cf5e471e3b47e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/768e6253/uploads/origins/5c6a7a3d-9448-4ed6-bc74-e13839e295fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42bb6e715b089f3f36c463b7456fddea", "srcset": "https://si.imgix.net/768e6253/uploads/origins/5c6a7a3d-9448-4ed6-bc74-e13839e295fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42bb6e715b089f3f36c463b7456fddea, https://si.imgix.net/768e6253/uploads/origins/5c6a7a3d-9448-4ed6-bc74-e13839e295fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bcb8d5d902ae060de637ca1c83201842 2x, https://si.imgix.net/768e6253/uploads/origins/5c6a7a3d-9448-4ed6-bc74-e13839e295fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f94eb83db0f6a7bc23498064d02735b 3x"}, "body": "川下あめさん、初めまして。\nペスチと申します！\n\nskebで川下あめさんの作品を拝見しており、\n人物の表情や雰囲気の描写がとても魅力的で、\nぜひお願いしたいと思いリクエストを送らせていただきました。\n\nもし可能であれば、私のオリジナルキャラクターのイラストをお願いしたいです。\n外見や設定、参考衣装などはすべてこちらのGoogle Driveにまとめておりますので、\nご確認いただけますと幸いです。\n\n【依頼内容】\n・ポーズ・表情・構図・背景など、すべて川下あめさんの自由な発想にお任せしたいです。\n・複数の衣装参考がありますが、描きたいものを自由に選んでいただいて大丈夫です。\n・見えない部分の補完やアレンジも自由にしていただいて問題ありません。\n\n【用途】\n・個人使用\n・他のリクエストやコミッションの参考資料としての使用\n・SNSでの投稿、アイコン、ヘッダー\n※収益目的では使用いたしません\n\nもし内容が難しい場合やイメージが湧きにくい場合は、\nキャンセルしていただいてもまったく問題ありません。\nお引き受けいただけましたらとても嬉しいです。\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1yNx51RJirMQ-TRol30rD0HD8AEnMr3QJ?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nagaredeta/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3236897, "client_id": 2803371, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b1fafcb/uploads/origins/27b2620f-56ab-4f24-adff-0d2b08209f35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f072950026e5ddf56e0829ef38cc653", "srcset": "https://si.imgix.net/9b1fafcb/uploads/origins/27b2620f-56ab-4f24-adff-0d2b08209f35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f072950026e5ddf56e0829ef38cc653, https://si.imgix.net/9b1fafcb/uploads/origins/27b2620f-56ab-4f24-adff-0d2b08209f35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b947cfe78ee78f6195d9f50a4c33969 2x, https://si.imgix.net/9b1fafcb/uploads/origins/27b2620f-56ab-4f24-adff-0d2b08209f35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3667ca7b238e6ed233599fc346eef4b7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b1fafcb/uploads/origins/27b2620f-56ab-4f24-adff-0d2b08209f35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fb512f8518e699166b6664e66573eb9", "srcset": "https://si.imgix.net/9b1fafcb/uploads/origins/27b2620f-56ab-4f24-adff-0d2b08209f35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fb512f8518e699166b6664e66573eb9, https://si.imgix.net/9b1fafcb/uploads/origins/27b2620f-56ab-4f24-adff-0d2b08209f35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a5abf1fe948a08f5b4d7917273ce6f7 2x, https://si.imgix.net/9b1fafcb/uploads/origins/27b2620f-56ab-4f24-adff-0d2b08209f35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cae3e7149686b546ec9a46c93c95530d 3x"}, "body": "初めまして。Twitterで見かけたイラストがとても素敵だったので依頼させていただきました。\n【依頼内容】\n私のアバターであるオスキワのイラストをお願いします。特徴は青メッシュと右耳のイヤリングです。\nキャラ参考資料↓\nhttps://drive.google.com/drive/folders/1NOkcMD6ekGGJKzJzKR2fB1z2RULVnEK3\n【シチュエーション】\nおまかせでお願いします。\n【ポーズ】\nおまかせでお願いします。\n【その他】\nもし背景がある場合、立ち絵を透過できるようにしていただけると嬉しいです。\n\nもし御縁があればよろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nagaredeta/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3236897, "client_id": 3278290, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3b5b004/uploads/origins/d0ce092a-6fd3-4375-a3b8-5aa1d320515f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2e5f83d88f4037a3cef2d4c2f0ed15f", "srcset": "https://si.imgix.net/d3b5b004/uploads/origins/d0ce092a-6fd3-4375-a3b8-5aa1d320515f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2e5f83d88f4037a3cef2d4c2f0ed15f, https://si.imgix.net/d3b5b004/uploads/origins/d0ce092a-6fd3-4375-a3b8-5aa1d320515f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ee24f516ab1a268132331c63a2b804a 2x, https://si.imgix.net/d3b5b004/uploads/origins/d0ce092a-6fd3-4375-a3b8-5aa1d320515f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f52ae89437db9487f323efd8445a0171 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3b5b004/uploads/origins/d0ce092a-6fd3-4375-a3b8-5aa1d320515f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=514e502e55076ce6fd7fb283bb8e7683", "srcset": "https://si.imgix.net/d3b5b004/uploads/origins/d0ce092a-6fd3-4375-a3b8-5aa1d320515f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=514e502e55076ce6fd7fb283bb8e7683, https://si.imgix.net/d3b5b004/uploads/origins/d0ce092a-6fd3-4375-a3b8-5aa1d320515f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4a43c20dfecb05e1ad57678fed6281fc 2x, https://si.imgix.net/d3b5b004/uploads/origins/d0ce092a-6fd3-4375-a3b8-5aa1d320515f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f4007d933c51e60193ed5b884b6aa64 3x"}, "body": "こんばんは、VTuberとして活動している閻魔ノマ（えんまのま）です。\nかわいらしい絵柄に一目惚れし、Ｘもつながらせていただけて嬉しいです。\nもしご縁がありましたらよろしくお願いいたします。\n\n相場がわからないので、『一枚絵』『全身絵』『腰上』『胸上』どれでも大丈夫です。\n\n【キャラクターについて】\n・鬼のお面から生まれたつくもがみです。\n・閻魔ノマは男の子に近いデザインですが、かわいく描いてもらえると嬉しいです。\n・着物を着た和風なキャラクターですが、パステルカラーがモチーフです。ドライブ内に配信背景やＢＧＭの雰囲気がわかる資料が入っているのでご確認ください。\n・構図はすべてお任せいたします。\n・モデルデザインの色味は薄いですが、描きやすい雰囲気に塗っていただいて大丈夫です。\n\n【服装について】\n・鬼のお面はマストでお願いいたします。\n・妖怪なので着物はあえて左前になっています。\n・小さめの黒い着物の上に「狩衣」という古典の衣装を羽織っています。\n・ピンクの服と赤い袖はつながっており、袖は長く垂れています（わかりにくくてすみません）。\n・衣装が描きにくい場合は、イラストレーター様が描きやすいようにアレンジしたり、想像で描いていただいたりして問題ございません。\n\n【使用用途】\n・各種SNSでの使用\n・動画のサムネイル（背景も描いていただける場合は、キャラクターと背景とを分けたPSDファイルかPNGファイルの形式のものをご用意していただけると助かります）\n・YouTube shortsでの使用\n\nぜひお時間ある際にお受けいただけると嬉しいです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1gVhEo_65dg40qxBsmWD6r4l76Lk3qLkU?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nagaredeta/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3236897, "client_id": 2946111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e4f0863/uploads/origins/ac6c02d2-d6bd-42b4-abca-e75f342158a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d1f36d0d05163474d2cee5f6da6c07a", "srcset": "https://si.imgix.net/4e4f0863/uploads/origins/ac6c02d2-d6bd-42b4-abca-e75f342158a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d1f36d0d05163474d2cee5f6da6c07a, https://si.imgix.net/4e4f0863/uploads/origins/ac6c02d2-d6bd-42b4-abca-e75f342158a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc7be7ec867d9ac85b515baf0e483e56 2x, https://si.imgix.net/4e4f0863/uploads/origins/ac6c02d2-d6bd-42b4-abca-e75f342158a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0ab7b757f02b4c86613b3c39e0dc4d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e4f0863/uploads/origins/ac6c02d2-d6bd-42b4-abca-e75f342158a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=564c46228826b35e26835cd25e9e20bb", "srcset": "https://si.imgix.net/4e4f0863/uploads/origins/ac6c02d2-d6bd-42b4-abca-e75f342158a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=564c46228826b35e26835cd25e9e20bb, https://si.imgix.net/4e4f0863/uploads/origins/ac6c02d2-d6bd-42b4-abca-e75f342158a3?bg=%