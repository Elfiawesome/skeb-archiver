200&s=d7747087b2e136b0f3ae9d2a8018f1ba", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6616de95/uploads/origins/82b15258-191d-4951-8009-68c093213ab4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e1fc6da6ac5345137a121653d55a643", "src_set": ""}, "body": "私のもう一人のVTuber Pumpkin Nunessaのために黒いラテックスのラバースーツをデザインしていただけませんか？\n\n彼女はとても背が高いのに胸が小さい。(Aカップくらい）\n髪は肩より少し上の長さで、耳の後ろにまとめている。少しカーブしている。\n\n彼女もゴーストですが、彼女のテーマは宗教的な修道女とラブクラフトに重点を置いています。彼女は怖くて邪悪な女の子です。\n\nreference materials: https://imgur.com/8fmtwL9\n\n(また、あなたがデザインしてくれたコスチュームを着た私のキャラクターを他のアーティストが描くことを許可してほしい。もちろん、デザイナーであるあなたのクレジットを明記した上で。PumpkinSynth（オレンジのコスチューム）を含む)", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukimaru_0721/works/18", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9b356a93/uploads/origins/14477c78-91b3-4f6c-b75f-02c20d7f7487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=420b552a0df13a713b9c447c4ce77fb4", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 53851, "client_id": 22182, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yukimaru_0721/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 53851, "client_id": 2277902, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe9e28b2/uploads/origins/5f44a533-2f38-453f-9f4e-faf73cfe4b5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5dcab3154f694d9d6c891468eaa1319", "src_set": ""}, "duration": null, "nsfw": false, "hardco