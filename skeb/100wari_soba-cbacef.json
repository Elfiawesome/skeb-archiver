op&crop=top&w=200&h=200&s=57498d74f152b717536b4b5cf3f8f9ff, https://si.imgix.net/10d9b7e3/uploads/origins/42d788ee-7c8d-4f96-9d00-d6101e060673?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=baafd67d0d24c163ee8a62a583f04b2a 2x, https://si.imgix.net/10d9b7e3/uploads/origins/42d788ee-7c8d-4f96-9d00-d6101e060673?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d19315f7da5138d98a5fe1bc6ba5e2ee 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10d9b7e3/uploads/origins/42d788ee-7c8d-4f96-9d00-d6101e060673?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d71b9887904d5ccd7cb49d0bd16f9564", "srcset": "https://si.imgix.net/10d9b7e3/uploads/origins/42d788ee-7c8d-4f96-9d00-d6101e060673?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d71b9887904d5ccd7cb49d0bd16f9564, https://si.imgix.net/10d9b7e3/uploads/origins/42d788ee-7c8d-4f96-9d00-d6101e060673?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c53c5273ca6d9c9ea28c106c22524138 2x, https://si.imgix.net/10d9b7e3/uploads/origins/42d788ee-7c8d-4f96-9d00-d6101e060673?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d41c89929bbc9384421909d278790a4 3x"}, "body": "こんばんは！いつもXでイラスト拝見しています。\n同人誌も買わせていただいてます。\n\n今回依頼したいのはうちの子の「ネムリン」です。\n参考ポストの赤髪猫耳の子がネムで、服装はポストの学生服でお願いします。\n\nこの子が、猫みたいにあくびをしたり、目をコシコシしてる様子を描いて欲しいです。\n\nキャラ設定としては、小学生女子並みの距離の詰めかたをしてきて男子とよくじゃれてる猫っ子です。\nよく撫でられたりゴロゴロしてすぐ違うところに行っちゃいます。\n\n描く範囲は顔周辺だけでも良いし、あだしのさんがよく描いてるキャラ紹介画像っぽく仕上げていただいても構いません。\n\n完成イラストサイズは特に指定しません。\n小さすぎなければいくつでもOKです。\n\nよろしくお願いします！\n\nhttps://misskey.io/notes/an01xjth3eba00is", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@100wari_soba/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "