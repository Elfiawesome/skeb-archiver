rop=top&w=200&h=200&blur=200&s=79aec59f3e956249c283aeceb4b42bda 3x"}, "body": "こんにちは。お願いがあります。\n\nキャラクター\n霧間 紗路（きりま しゃろ）\n\n服装\nhttps://drive.google.com/file/d/1gZ1rCG0428zxPRcyX5h5Ki_D1sVOPBjj/view?usp=sharing\n\n背景\nマスカラを塗り、チークを塗り、ピンクの口紅を塗る。洗面台の鏡で自分の姿を見ている。\n\n構図\n洗面台の鏡の前でキュートな表情を浮かべるSyaro。\n\n表情\n赤ら顔と照れ笑い", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Sakaki333/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1642609, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7393760e/uploads/origins/b62c9103-98f3-41b1-a1c4-2b3d4e6aa595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30c3190dbae77a495be70dec0c079486", "srcset": "https://si.imgix.net/7393760e/uploads/origins/b62c9103-98f3-41b1-a1c4-2b3d4e6aa595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30c3190dbae77a495be70dec0c079486, https://si.imgix.net/7393760e/uploads/origins/b62c9103-98f3-41b1-a1c4-2b3d4e6aa595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d1706cbffe5bdd6f8490e4cf68fbd72 2x, https://si.imgix.net/7393760e/uploads/origins/b62c9103-98f3-41b1-a1c4-2b3d4e6aa595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d28c1983c7afa3479b5794351d049642 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7393760e/uploads/origins/b62c9103-98f3-41b1-a1c4-2b3d4e6aa595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f5b90b101be97a1d54bb06f0901f22b", "srcset": "https://si.imgix.net/7393760e/uploads/origins/b62c9103-98f3-41b1-a1c4-2b3d4e6aa595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f5b90b101be97a1d54bb06f0901f22b, https://si.imgix.net/7393760e/uploads/origins/b62c9103-98f3-41b1-a1c4-2b3d4e6aa595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05c3b55d3277b29d627050e12e447d3c 2x, https://si.imgix.net/7393760e/uploads/origins/b62c9103-98f3-41b1-a1c4-2b3d4e6aa595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed79a2e831413f38b2e8b4da5044a6b0 3x"}, "body": "サカキ先生はじめまして\n\n絵柄が素敵で依頼したいと思います\n\n内容\n緑色の来客用スリッパを履いているチノちゃんをお願いします\n\nキャラ\nご注文はうさぎですか？\nチノちゃん\n\n服装\n学校の制服、ラビットハウスの制服\n足元ですが、学校や病院にある緑色の来客用スリッパを履いている状態でお願いします\n\nポーズ、シチュエーション、背景はおまかせします\n(背景は無しでも構いません)\n\n以上になりますが、スリッパを履いている女の子が好きで描いて貰えると嬉しいです", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Sakaki333/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1642609, "client_id": 3235528, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f02c7e9/uploads/origins/a2e63784-03a0-4781-b81f-a984268eb234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0aebe91df5daf9947ff9150b6fd6f2b", "srcset": "https://si.imgix.net/2f02c7e9/uploads/origins/a2e63784-03a0-4781-b81f-a984268eb234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0aebe91df5daf9947ff9150b6fd6f2b, https://si.imgix.net/2f02c7e9/uploads/origins/a2e63784-03a0-4781-b81f-a984268eb234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f30b934c91b96081cfc9792b6194aee6 2x, https://si.imgix.net/2f02c7e9/uploads/origins/a2e63784-03a0-4781-b81f-a984268eb234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9e0908fc3a552cabe65482aa488037a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f02c7e9/uploads/origins/a2e63784-03a0-4781-b81f-a984268eb234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f10fb30a17bc82837fbcdaa5dc6023bc", "srcset": "https://si.imgix.net/2f02c7e9