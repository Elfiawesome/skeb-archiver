てはあまり前向きすぎない感じ。\n暗闇の中でお互いの手を取り合って体温を確かめるような、安心感\n\n楽曲の依頼をするのが不慣れで、不備や失礼がありましたら申し訳ありません。\n燐怪様の解釈でご自由にして頂けたらと制作して頂けたらと思います。\nよろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@rinkai_fireash/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": false, "creator_id": 1431713, "client_id": 2959691, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774671075080806400%2F7s_wQRBP.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75a08e2834644f1ad046824634e9e4f4", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774671075080806400%2F7s_wQRBP.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75a08e2834644f1ad046824634e9e4f4, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774671075080806400%2F7s_wQRBP.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=731c8e6ba6cdcb0a6bc409af3d30f403 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774671075080806400%2F7s_wQRBP.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=093c7c986400d17bba3dabf6acb190a5 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/1950509a-57b1-4694-8864-64602396ca26?response-content-disposition=inline&Expires=1786432305&Signature=CdmwNWxRH7OekVe1HFRKnBOt8D2oexvZnrif3a99OghJ31qogKdq6hIRcxJgCdf~dscxQ7jLVG49F1PHVT1KQzIsLmxO7YRAzsqMY8LQP7-nkOq2H2G1GCIXgMbTCRRwb1dFVW-Ks4NxNcc92xI3H6osA52Lqz2rDgctSLmRBvHd8GFoO-1fF5KFh2MdazResj69y7t2pTus11F7Wuj5pwvSRoOzbD-MbyNyHialniCgjJd-66GBey4ZkItPAAEJT7e3J-RwL8YBpYLY8LfP6a7h3Bs5kn9APogbg-lp5mrAycIuuufOP4oBULGjCS1jeH6B~IaahZ2eOKuI3KQjmg__&Key-Pair-Id=K1GS3H53SEO647", "duration": 252, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avata