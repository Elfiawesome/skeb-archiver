ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=636d98ad7324b783635fc9012dded41a, https://si.imgix.net/38575e27/uploads/origins/f4732fa3-5eba-4cfa-95c5-fcee7e37c57f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c9bfe274c19a7ab69b85b647240f03c 2x, https://si.imgix.net/38575e27/uploads/origins/f4732fa3-5eba-4cfa-95c5-fcee7e37c57f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a15525f76c31bf89706c328f6107f69 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38575e27/uploads/origins/f4732fa3-5eba-4cfa-95c5-fcee7e37c57f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c73d42ccfb1585c48de665537ce5544", "srcset": "https://si.imgix.net/38575e27/uploads/origins/f4732fa3-5eba-4cfa-95c5-fcee7e37c57f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c73d42ccfb1585c48de665537ce5544, https://si.imgix.net/38575e27/uploads/origins/f4732fa3-5eba-4cfa-95c5-fcee7e37c57f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=34b75c265ce0b5a9a565ff797b505556 2x, https://si.imgix.net/38575e27/uploads/origins/f4732fa3-5eba-4cfa-95c5-fcee7e37c57f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0174d7e9771a8a0fc04c9f124e73e21d 3x"}, "body": "お忙しいところ失礼します。\n先日は素晴らしいイラストをお描き頂き、本当にありがとうございました。\n今回は普段の作品でお描きになられているジャンルではないため、無理なお願いなのは承知の上ですが、\n前回の作品、特に質感や光の使い方があまりに良かったので、どうにかお願い出来ればと思いリクエストさせて頂きます。\n\n私事ですが、「Fallout: New Vegas」というビデオゲームがとても好きで、\nそのシリーズに出てくるT-51b Power Armorという防具(資料1枚目)を着た私のアバターをお描き頂ければと思っております。\nヘルメット部分だけを外して手に持った状態で、アバターは眼鏡を外した状態(資料2枚目)にしていただければと思います。\nしばらく歩いていたところ、息苦しいヘルメットを外して外の空気を吸って一呼吸、みたいな場面を想定しています。\nイヤリングはそのまま残してください。(前回のような描き方だと嬉しいです)\n(外した状態の首まわりの参考に、海外のコスプレイヤーの方がヘルメット無しで着用している状態の写真(資料3枚目)を入れてあります。)\n\n出来れば、背景は地平線まで続いているような長い道(資料4枚目を参考程度に)だと嬉しいです。\nゲーム内の世界観にする必要はないですし、武器等も持たせなくて結構です。\n\n上記以上の細かい構図や、アングルなどは全てお任せします。\n\n普段お描きになっているジャンルと外れており、大変なお願いであることは重々承知しているのですが、\n可能であればご一考頂ければ非常に嬉しいです。\n\n資料URL(Twitter): https://twitter.com/Nanastaxia/status/1545437615851438080", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@siyo0216/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1184206, "client_id": 1989086, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3008cc5/uploads/origins/5ba4b9dc-c32b-4fed-b7c6-f1d59d07df08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fe05bc89de2e49bf9045a4caca9e2df", "srcset": "https://si.imgix.net/a3008cc5/uploads/origins/5ba4b9dc-c32b-4fed-b7c6-f1d59d07df08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fe05bc89de2e49bf9045a4caca9e2df, https://si.imgix.net/a3008cc5/uploads/origins/5ba4b9dc-c32b-4fed-b7c6-f1d59d07df08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ec634540e5651b84db290b12bfd55df 2x, https://si.imgix.net/a3008cc5/uploads/origins/5ba4b9dc-c32b-4fed-b7c6-f1d59d07df08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=634c47eed91aa124efa633c5850e60c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a3008cc5/uploads/origins/5ba4b9dc-c32b-4fed-b7c6-f1d59d07df08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4e7553d91a75b23ca9684a00732a742", "srcset": "https://si.imgix.net/a3008cc5/uploads/origins/5ba4b9dc-c32b-4fed-b7c6-f1d59d07df08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4e7553d91a75b23ca9684a00732a742, https://si.imgix.net/a3008cc5/uploads/origins/5ba4b9dc-c32b-4fed-b7c6-f1d59d07df08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=51d4c03461dc57cd4c84b4cea4a0f3f4 2x