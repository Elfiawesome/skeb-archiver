-91cd-4bfe53d3db24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36083035a2acbbd8940e11faca6ff8bf", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71baa9aa/uploads/origins/c89d7b34-434f-4e84-91cd-4bfe53d3db24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f468e6a3146364c769db581b0d240890", "src_set": ""}, "body": "VTuberとして活動しておりますあや姉と申します。\n\n以前もリクエストさせていただきとても可愛くもう一度リクエストさせて頂きます。\nリクエストは私自身、あや姉のイラストを描いて頂きたいです。\n\n〇詳細\n・お酒で少し酔った感じの表情\n・ポーズなどお任せいたします\n\n〇用途\n・YouTube（収益化済み）やX等のSNSでの使用\n\n〇納品形式\n・PSDファイルを希望\n・背景と人物が分かれたものだとありがたいです\n・髪の毛などが見切れないように全体が映るようにしてくださると助かります\n\n〇参考資料\nhttps://drive.google.com/drive/folders/1KIT2CAzCFYFDWDLaRDGwuUNGQjIi5X4d?usp=sharing\n\nご検討の程よろしくお願いいたします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nerorigogo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3533622, "client_id": 3490033, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72e59df3/uploads/origins/5658fda1-bf55-4c24-9f45-ecbb73f6110c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e42108f61ee3e9cd0ec1e42954716aaf", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72e59df3/uploads/origins/5658fda1-bf55-4c24-9f45-ecbb73f6110c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa18274fc270ff3a8d151f624d717320", "src_set": ""}, "body": "狭間様\n\nはじめまして\nVtuber準備中の白雨ねねと申します。\n\n狭間様のイラストを拝見させていただき、とっても素敵でわたしのイラストも描いていただきたいと思い今回リクエストさせていただきました。条件が合いましたらぜひよろしくお願いいたします。\n\n以下依頼内容となります。\n\n▫️白雨ねねの一枚絵（縦）\n\nhttps://skeb.jp/@nerorigogo/works/3\nこちらと同じような構図で書いていただけないでしょうか。\n髪型髪色は資料にあるものの中からお任せいたします。\n\n▫️できましたら背景と表情差分がありますと嬉しいです。\n\nGoogleドライブに三面図等の資料を添付しております。\n\n\n―\n\n▫️サムネイル等に使用させていただきたいため､耳などが見切れない構図でお願いいたします。\n\n▫️PSDでの納品希望でございます。\n背景、サイン、人物のレイヤーを分けてくださると大変助かります。\n\n《使用用途》\n\n▫️Vtuber活動に伴うSNSでの使用\n▫️収益化予定のYoutubeでのサムネイルの使用\n▫️FANBOX内での配布やFANBOX特典でのネットプリント配布\n▫️グッズ化などの商用利用(企業コラボの可能性あり)\n（難しい場合は別途レイヤーにて記載をお願いいたします。）\n\n―\n\n以下資料が載っているGoogleドライブのURLとなります。\n\nhttps://drive.google.com/drive/folders/1dqFQphjgZYRWQN8fgkYAoh7RxTfXjhh0?usp=drive_link\n\nお忙しい中恐縮ですが、ご検討のほどどうぞよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nerorigogo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3533622, "client_id": 2497243, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/202b62f3/uploads/origins/04928a5d-a4d0-4464-b82d-748dd303f6e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0df2811f5ebd311a9a994b7b0f9243ee", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/202b62f3/uploads/origins/04928a5d-a4d0-4464-b82d-748dd303f6e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fd5687772fe2a0cf8beb19ee4b8ba02", "src_set": ""}, "body": "いつもお世話になってるあります。\n前回もとても素敵な作品をありがとうございました！\n\n今回ですが、りんりんりんかちゃんの水着姿をお願いします。\n可能でしたらFAとしてプレゼントして頂きたいです、よろしくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nerorigogo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3533622, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d74a784/uploads/origins/f2fe6a79-b545-4ee5-9532-d07e9390e3d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=065c1f097ab075e2d49664caddb319dc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4