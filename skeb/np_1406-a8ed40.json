を想定していますが、お任せします。\nメモ帳などのtext形式で納入ください（任意）。\n\nいただいたシナリオ案をもとに、駒碧さんがゲームシステムに合わせてアレンジ・変更をして、ちよふじ１〜２章のように公開する予定です。\nよろしくおねがいします。", "nc": 1, "word_count": 7672, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@np_1406/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1518005, "client_id": 171276, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/82d8f962/uploads/origins/f8a69dcf-2b0a-4223-8df6-42266449e3dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cd4d287a7b19cd830eb3f91a5db805c", "srcset": "https://si.imgix.net/82d8f962/uploads/origins/f8a69dcf-2b0a-4223-8df6-42266449e3dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cd4d287a7b19cd830eb3f91a5db805c, https://si.imgix.net/82d8f962/uploads/origins/f8a69dcf-2b0a-4223-8df6-42266449e3dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e74fe2bb5b46a541dda047bb6a896c8 2x, https://si.imgix.net/82d8f962/uploads/origins/f8a69dcf-2b0a-4223-8df6-42266449e3dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bbb22eeec6c75e17260a7099e4489a53 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82d8f962/uploads/origins/f8a69dcf-2b0a-4223-8df6-42266449e3dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aae68b54ee747d57491a5b7edfb45840", "srcset": "https://si.imgix.net/82d8f962/uploads/origins/f8a69dcf-2b0a-4223-8df6-42266449e3dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aae68b54ee747d57491a5b7edfb45840, https://si.imgix.net/82d8f962/uploads/origins/f8a69dcf-2b0a-4223-8df6-42266449e3dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c41c3a51f9b6bbe813ae9a1bb29dfd94 2x, https://si.imgix.net/82d8f962/uploads/origins/f8a69dcf-2b0a-4223