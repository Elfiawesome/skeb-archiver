&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d521d6dd559ae88e965bb4bae9e649d4 3x"}, "body": "こんにちは。先日はお世話になりました。\n\nXのコメント欄を拝見し、こんなリクエストを送りました。\n\n参考画像\n①https://www.pixiv.net/artworks/117948653\n②https://www.pixiv.net/artworks/96941363\n↑\nのように、鈴音さんが優子さんをお◯んこサンドイッチの体勢で覆い被さる or 押し倒すイラストをお願いします。\n\n一応シチュエーションです。\nXの反応から、優子さんをお求めになってるフォロワー様が多い様なので。\n\n鈴音さんがフォロワー様に優子さんを渡さないため覆い被さり(押し倒し)お◯んこサンドイッチ。\n\n衣装は前回と変わりません。\n\n鈴音さんのレーシングブルマはお尻にこんな感じに食い込んではみパンをお願いします⤵︎\n(https://www.pixiv.net/artworks/114469187)\n※食い込み具合いはお任せします。　\n\n優子さんは変わらずはみパンのままです。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@peanut_doujin/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3419280, "client_id": 56414, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9575a19c/uploads/origins/4e40d11d-1d5c-4884-bb30-e2a83c8e3759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=747452ac635f7f37b0d639e3f12a12f9", "srcset": "https://si.imgix.net/9575a19c/uploads/origins/4e40d11d-1d5c-4884-bb30-e2a83c8e3759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=747452ac635f7f37b0d639e3f12a12f9, https://si.imgix.net/9575a19c/uploads/origins/4e40d11d-1d5c-4884-bb30-e2a83c8e3759?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f19227ebad378fffea0d3f395d637727 2x, https://si.imgix.net/9575a19c/uploads/origins/4e40d11d-1d5c-4884-bb30-e2a83c8e3759?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84932e29b4d1ed63d2c20096171c48cd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9575a19c/uploads/origins/4e40d11d-1d5c-4884-bb30-e2a83c8e3759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=abc1a5687bd559c9348a6e7031a763be", "srcset": "https://si.imgix.net/9575a19c/uploads/origins/4e40d11d-1d5c-4884-bb30-e2a83c8e3759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=abc1a5687bd559c9348a6e7031a763be, https://si.imgix.net/9575a19c/uploads/origins/4e40d11d-1d5c-4884-bb30-e2a83c8e3759?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d45c4d96c724afce69cecaab9a152fd3 2x, https://si.imgix.net/9575a19c/uploads/origins/4e40d11d-1d5c-4884-bb30-e2a83c8e3759?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=769a3954e24a55fd467f89f301681dec 3x"}, "body": "こんばんは。\n\n『とびっきりじぇいしぃ』の表紙の左の女の子と、その子の母親の2人のブルマ姿をリクエストします。\n\n女の子はレーシングブルマ姿。胸ポチをお願いします。\n\n母親は(現役の頃に使っていたのでピチピチの)ブルマと体操着です。ノーブラで胸ポチをお願いします。\n\nシチュエーションはこちらをご参照ください⤵︎\n(https://www.pixiv.net/artworks/79834844)\n女の子が母親のブルマを掴んで引っ張り上げて食い込ませるイタズラをします。\n※ブルマのみ引っ張り上げるので、パンチラをお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@peanut_doujin/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3419280, "client_id": 469905, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ddf84d52/uploads/origins/c6b9f4a9-eab5-48d7-a9b2-a3ac5db3c4f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1095bdbbb3b713a72a7c0df103ee8b1d", "srcset": "https://si.imgix.net/ddf84d52/uploads/origins/c6b9f4a9-eab5-48d7-a9b2-a3ac5db3c4f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1095bdbbb3b713a72a7c0df103ee8b1d, https://si.imgix.net/ddf84d52/uploads/origins/c6b9f4a9-eab5-48d7-a9b2-a3ac5db3c4f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39785e365f4052054fcfba2c34cc525c 2x, https://si.imgix.net/ddf84d52/uploads/origins/c6b9f4a9-eab5-48d7-a9b2-a3ac5db3c4f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c2983bb7258821979bca428e1367877 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ddf84d52/uploads/origins/c6b9f4a9-eab5-48d7-a9b2-a3ac5db3c4f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee18431a7387aaa58678b4ae5e0e02ea", "srcset": "https://si.imgix.net/ddf84d52/uploads/origins/c6b9f4a9-eab5-48d7-a9b2-a3ac5db3c4f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee18431a7387aaa58678b4ae5e0e02ea, https://si.imgix.net/ddf84d52/uploads/origins/c6b9f4a9-eab5-48d7-a9b2-a3ac5db3c4f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0fa8be23a6dfc567e37dcfdaf8cdb2ad 2x, https://si.imgix.net/ddf84d52/uploads/origins/c6b9f4a9-eab5-48d7-a9b2-a3ac5db3c4f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3335a7b5eedb8c28f7526408d79e45a6 3x"}, "body": "はじめまして。\n水着姿の艦娘イラストをいつも楽しみに拝見させて頂いております。\n\n普段お描きにならない艦娘でのお題になり恐縮ではありますが\nリクエスト申し上げます。\n\n【キャラクター】艦これの神風。\n【衣装】ビキニタイプの水着。\n　胸部装甲の大きさが明確に分かる公式絵が無いため、人によって解釈が別れますが\n　私は時雨改三くらいの大きさはある、と思っております。\n\n　もし、ぴーなっと先生的に胸部装甲慎ましめの艦娘と判断されたのであれば\n　その解釈で描いて頂いても構いません。（この場合は競泳水着に変更して頂けると助かります）\n\n表情や構図などはお任せ致します。\n何卒、宜しくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@peanut_doujin/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3419280, "client_id": 496307, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28a3ca7b/uploads/origins/87e47f2c-626a-4825-bc3e-adf34134ef9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9088436bbcf90c8e42f426992a0eec64", "srcset": "https://si.imgix.net/28a3ca7b/uploads/origins/87e47f2c-626a-4825-bc3e-adf34134ef9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9088436bbcf90c8e42f426992a0eec64, https://si.imgix.net/28a3ca7b/uploads/origins/87e47f2c-626a-4825-bc3e-adf34134ef9a?bg=%23fff