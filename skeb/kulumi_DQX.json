humbnail_image_urls": null, "body": "", "nc": 163, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kulumi_DQX/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3416700, "client_id": 3435978, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42aeaec9/uploads/origins/7ce7c291-0b42-45ca-9f29-ad20bedade2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45a64fbde462904a7f250282b431b7b4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42aeaec9/uploads/origins/7ce7c291-0b42-45ca-9f29-ad20bedade2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3eb89378db2dfe956d3b278404e02d81", "src_set": ""}, "body": "たばこたゃと申します。\n\nこの度はクルミさんにドラゴンクエスト10の自キャラ絵を描いて頂きたく、要望を送った次第でございます。\n\n【具体的な内容】\n自キャラのバストアップ、そのキャラの手前にドラゴンクエストのモンスターであるワルぼうを描いて頂きたいです。\n\nポーズは、自キャラが手のひら側を上に向け、人差し指を両頬に当てている姿\nワルぼうは両手を広げながら口元に手を当て、ふわふわと斜めに浮いているポーズでお願いします。\n\n表情は2人ともいたずらっぽい笑顔を浮かべている様子\n\n自キャラの服装、カラーリング等の細かい部分は画像にて資料URLの方に共有させて頂きます。\n\n【使用用途】\n基本的にTwitter、discord等のSNSでのアイコンに使用したいと考えております。\n\nさらに細かい構図、キャラ配置等は、要望から大きく崩れなければ描いていく上でクルミさんの納得がいくような形で仕上げて頂いて構いません。\n\n\n何卒よろしくお願いいたします。\n\nhttps://x.com/green_iights/status/1856723598435885352?s=46&t=i4ZVVlnNfo7VxOR85RZjQA", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kulumi_DQX/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3416700, "client_id": 11129, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/412e45e2/uploads/origins/40ea963f-f259-42dc-b336-816aa1ae8489?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2f720ad7ab1938c5398799b341c0753", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {