tt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca1cb4d7/uploads/origins/c8e16ce1-d877-4048-9693-0bf4d6e0ba09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e3973f7435123adf83cf6cfe97f1fd3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca1cb4d7/uploads/origins/c8e16ce1-d877-4048-9693-0bf4d6e0ba09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5dce2bd632a85f85c3310a95f83974eb", "src_set": ""}, "body": "初めまして。\n描いていただきたいイラストと、skeb内で絵柄が一致する方を探していて心を惹かれたので依頼させていただきます。\n\nDQ10の自キャラなんですが、シチュエーションは「しゃがんでいて頬杖をつきながら微笑むエルフ」です。\n以下、細かいポージングについて箇条書きしていきます。\n\n・表情はにこっと微笑んでいる様子\n(歯を見せるような笑い方じゃなくて、口角が上がっているだけのほほえみ方)\n\n・目線はこちら向き\n(目は少し細めている状態)\n\n・頭は少し小首を傾げた状態\n\n・両手は膝(またはその近辺)に肘を乗せいてる状態\n(もし膝の上に肘を置くと無理な体勢になってしまうのであれば、ずらして頂いて大丈夫です)\n\n・そのため、上体は少しだけ前かがみ状態\n\n・頬杖をついているので、両手の平の影響でほっぺたがすこしだけムニっとなっている状態\n\n・体勢的にかかとは少し浮いていると思います\n\n・年齢の設定は11才です\n\n・衣装の関係であまり見えないと思いますが、もし見えたらふとももが少し盛られていると嬉しいです\n\n・背景はおまかせします(無しでも大丈夫です)\n\n説明が下手で申し訳ありませんが、以上のシチュエーションでよろしくお願いします。\n\nキャラの髪型や服装等の詳細及びデッサンアプリによるざっくりとしたポージングのイメージ図(画角含む)は以下のURLに添付しています。\nご査収ください。\nアプリの仕様上、体勢に無理があったり依頼文と齟齬があると思いますが、依頼文のシチュエーションの方を優先でお願いします。\n\nイラスト資料\nhttps://ibb.co/hR84wf8p\nhttps://ibb.co/B89GzgZ\nhttps://ibb.co/zTTP9dck\nhttps://ibb.co/Q3zHhMxK\nhttps://ibb.co/hFc0GqGG", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kulumi_DQX/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3416700, "client_id": 134438, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ccf0baf/uploads/origins/db896e87-33f3-4fa7-bfaa-e6b9db6bdece?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b1c9b397db9dd5bcb0f8dca62a94887", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ccf0baf/uploads/origins/db896e87-33f3-4fa7-bfaa-e6b9db6bdece?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af4e6183a937fac31d6ac2ade209145d", "src_set": ""}, "body": "こんにちは！私はあなたのアートスタイルが大好きで、トリミングなしで全身を使ったこの作品を見てやる気が出ました。https://skeb.jp/@kulumi_DQX/works/9\n\nこのリクエストは私のVTuber、ルイーズをフィーチャーするものです。彼女は \"ニート \"または \"ひきこもり \"です。普段はとても怠惰で眠い。さらに、裸足でいるのが大好きで（外でも）、足の爪が長いので靴を履いていないことが多い。好きな色は青で、海が大好き。趣味はアニメ、漫画、ゲーム、ライブ配信、インターネット！\n\n彼女は人間とドラゴン・シャークの2つの姿を持っています。両方描いてほしいです。送信量は十分だと思いますが、再送はご自由にどうぞ。\n\nポーズは自由ですが、横向き（横長、16：9）でお願いします。また、足の裏が強調されていると最高です。\n\n背景はあまり重要ではないので、お任せします！ただ、SNSで使用するため、2枚とも別途透過PNGをお願いしたいです。\n\nありがとうございます。\n\nhttps://drive.google.com/drive/folders/1KdE8lCkCzHt8qTmPYhecGsW5PNPUEyxP?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kulumi_DQX/works/21", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ccc002a0/uploads/origins/cec495df-2480-4686-986a-290ba35e93bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8a503737ab89e589f20a87d685a9aaf", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3416700, "client_id": 3617422, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kulumi_DQX/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3416700, "client_id": 3607434, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e167e75/uploads/origins/60939c4e-6449-47b6-a8ea-d29ca9a10ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcb9adfe92a5679ae95df24c766299dd", "src_set": ""}, "dur