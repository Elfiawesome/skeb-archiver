傘(全然なくていいです)に白ロリと一見お嬢様ちっくに見えますが、高飛車なキャラではないのでそのように見えるようなポーズは避けて頂けるととても嬉しいです。\n儚げ、あるいは陰のある(病んでる)ように見えるとさらに嬉しいです。\n\n◆もし依頼をお受けいただける場合、完成した絵をTwitterのヘッダやアイコンに使用させて頂いたり、Twitterで紹介させて頂きたいなと考えております。\n\nご縁がありましたらうれしいです。どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1uoOcaZ_JNBXL7Qwaprhsb6G4L9CLhnAI?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kasiwamomomo/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2860373, "client_id": 2398863, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f960a7b4/uploads/origins/fd5b7e5d-819d-4ea9-8212-2a1b2b5eea54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8c9aaae886f096cb85a559399f945a3", "srcset": "https://si.imgix.net/f960a7b4/uploads/origins/fd5b7e5d-819d-4ea9-8212-2a1b2b5eea54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8c9aaae886f096cb85a559399f945a3, https://si.imgix.net/f960a7b4/uploads/origins/fd5b7e5d-819d-4ea9-8212-2a1b2b5eea54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc68369e2519056d4c590ff6943aa588 2x, https://si.imgix.net/f960a7b4/uploads/origins/fd5b7e5d-819d-4ea9-8212-2a1b2b5eea54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0600269d6378bb762acd66f844237534 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f960a7b4/uploads/origins/fd5b7e5d-819d-4ea9-8212-2a1b2b5eea54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bff704d23b982df4eb17816796f9a87e", "srcset": "https://si.imgix.net/f960a7b4/uploads/origins/fd5b7e5d-819d-4ea9-8212-2a1b2b5eea54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bff704d23b982df4eb17816796f9a87e, https://si.imgix.net/f960a7b4/uploads/origins/fd5b7e5d-819d-4ea9-8212-2a1