0\u306a\u308b\u8907\u6570\u306e\u77ed\u3044\u6bdb\u675f\u304c\u629c\u3051\u3066\u3044\u307e\u3059.\u984e\u307e\u3067\u306e\u9577\u3055\u3067\u3001\u5b8c\u5168\u306b\u81ea\u7531\u306b\u306a\u3063\u3066\u3044\u308b\u3082\u306e\u3082\u3042\u308c\u3070\u3001\u304a\u56e3\u5b50\u304b\u3089\u307b\u3050\u308c\u305f\u3060\u3051\u306e\u3082\u306e\u3082\u3042\u308a\u307e\u3059.\n\n\u53c2\u8003\u30ea\u30f3\u30af\u306b\u30e1\u30ac\u30cd\u306e\u4f8b\u304c\u3042\u308a\u307e\u3059.\u30c7\u30b6\u30a4\u30f3\u306f\u81ea\u7531\u3067\u3059\u304c\u3001\u4ee5\u4e0b\u306e\u3088\u3046\u306a\u7279\u5fb4\u3092\u6301\u3064\u3053\u3068\u304c\u671b\u307e\u3057\u3044\u3067\u3059\uff1a\n-\u30c0\u30fc\u30af\u30d6\u30ed\u30f3\u30ba\u307e\u305f\u306f\u30d6\u30e9\u30a6\u30f3\u30ab\u30e9\u30fc\n-\u4e38\u307f\u3092\u5e2f\u3073\u305f\u9577\u65b9\u5f62\u306e\u5f62\u72b6\n-\u8eab\u9577\u304c\u5c0f\u3055\u304f\u3001\u76ee\u3088\u308a\u5c11\u3057\u5927\u304d\u3044.\n-\u30ec\u30f3\u30ba\u4e0a\u90e8\u3068\u5074\u9762\u306f\u30d5\u30ec\u30fc\u30e0\u3001\u30ec\u30f3\u30ba\u4e0b\u90e8\u306f\u30ef\u30a4\u30e4\u30fc/\u30aa\u30fc\u30d7\u30f3.\n\n\u53c2\u8003\u30ea\u30f3\u30af\u306b\u670d\u306e\u30a2\u30a4\u30c7\u30a2\u304c\u3042\u308a\u307e\u3059\u3002\u53c2\u8003\u30ea\u30f3\u30af\u306e\u670d\u88c5\u306f\u3042\u304f\u307e\u3067\u76ee\u5b89\u3068\u3057\u3066\u3001\u30c7\u30b6\u30a4\u30f3\u306f\u81ea\u7531\u306b\u5de5\u592b\u3057\u3066\u304f\u3060\u3055\u3044.\n\u670d\u88c5\n-\u9ed2\u306e\u6a5f\u80fd\u7684\u306a\u6226\u95d8\u7528\u30a2\u30a6\u30bf\u30fc\uff08\u4f8b\uff1a\u9577\u8896\u306e\u8170\u4e08\u30b8\u30e3\u30b1\u30c3\u30c8\u3001\u30cb\u30fc\u30cf\u30a4\u30d6\u30fc\u30c4\u3001\u30d9\u30eb\u30c8\n-\u30d3\u30b8\u30cd\u30b9\u30a6\u30a7\u30a2\u306e\u4e0b\u306f\u3001\u30cb\u30e5\u30fc\u30c8\u30e9\u30eb\u30ab\u30e9\u30fc\uff08\u30b0\u30ec\u30fc\u3001\u30b7\u30eb\u30d0\u30fc\u3001\u30d6\u30e9\u30c3\u30af\u3001\u30d6\u30e9\u30a6\u30f3\uff09\u3067\uff08\u9577\u30ba\u30dc\u30f3\u3001\u30bf\u30c3\u30af\u306e\u306a\u3044\u9577\u8896\u30b7\u30e3\u30c4\u3001\u30dc\u30bf\u30f3\u30a2\u30c3\u30d7\u306e\u3082\u306e\uff09.\n-\u30cf\u30a4\u30cd\u30c3\u30af\u307e\u305f\u306f\u30e2\u30c3\u30af\u30cd\u30c3\u30af\u306e\u895f\u4ed8\u304d\u30a2\u30f3\u30c0\u30fc\u30b7\u30e3\u30c4\uff08\u4e2d\u9593\u8272\n\n\u305d\u306e\u4ed6\u306e\u8a73\u7d30\n-\u4e21\u8033\u306b\u8907\u6570\u306e\u30d4\u30a2\u30b9\uff083\uff5e5\u500b\uff09\u3001\u30b7\u30eb\u30d0\u30fc\u306e\u30a4\u30e4\u30ea\u30f3\u30b0\uff08\u30b9\u30bf\u30c3\u30c9\u307e\u305f\u306f\u30c9\u30ed\u30c3\u30d7\uff09\u3002\u3082\u3057\u6c17\u306b\u5165\u3063\u305f\u3089\u3001\u30a8\u30ec\u30ac\u30f3\u30c8\u306a\u30c0\u30f3\u30b0\u30eb\u30a4\u30e4\u30ea\u30f3\u30b0\u3092\u30c7\u30b6\u30a4\u30f3\u3057\u3066\u898b\u305b\u3066\u304f\u3060\u3055\u3044\uff01\n-\u5de6\u624b\u7b2c4\u6307\u306b\u30b7\u30eb\u30d0\u30fc\u306e\u7d50\u5a5a\u6307\u8f2a.\n-\u7709\u6bdb\u304c\u901a\u5e38\u3088\u308a\u3084\u3084\u592a\u3044\n-\u3059\u3079\u3066\u306e\u8863\u670d\u306e\u7e01\u3084\u30c8\u30ea\u30e0\u306b\u30b7\u30eb\u30d0\u30fc\u3084\u30b0\u30ec\u30fc\u306e\u30c7\u30a3\u30c6\u30fc\u30eb\u3092\u5165\u308c\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059.\u597d\u304d\u306a\u3088\u3046\u306b\u7d30\u304b\u304f\u30c7\u30b6\u30a4\u30f3\u3057\u3066\u304f\u3060\u3055\u3044\uff01\n\n\n\u6027\u683c\uff1a\u666e\u6bb5\u306f\u7121\u611f\u60c5\u306a\u307b\u3069\u51b7\u9759\u3067\u3001\u76ae\u8089\u5c4b\u3067\u3042\u308b.\u4eba\u751f\u306e\u51fa\u6765\u4e8b\u304b\u3089\u3001\u4e0d\u4fe1\u611f\u3092\u62b1\u304d\u3001\u4eba\u9593\u5acc\u3044\u306b\u306a\u308a\u3001\u51b7\u305f\u304f\u306a\u3063\u305f.\u3057\u304b\u3057\u3001\u6b63\u7fa9\u3092\u91cd\u3093\u3058\u3001\u71b1\u72c2\u7684\u306a\u5fe0\u8aa0\u5fc3\u3092\u6301\u3061\u3001\u5c11\u3057\u3067\u3082\u6311\u767a\u3055\u308c\u308c\u3070\u3001\u81ea\u5206\u306e\u4fe1\u3058\u308b\u3082\u306e\u306e\u305f\u3081\u306b\u6fc0\u3057\u304f\u6226\u3046\u3053\u3068\u3092\u3044\u3068\u308f\u306a\u3044.\u307e\u305f\u3001\u51b7\u5fb9\u306a\u6012