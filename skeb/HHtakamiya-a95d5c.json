91a98693/uploads/origins/750ae924-5e38-44be-b289-76e7972a95c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=53449a6fd4b2e7a0c8ad41d68747bf25 3x"}, "body": "リクエストさせていただきます\nキャラは、優祐くんで、へそフェチなので\nへそに関連したお話がみたいです\n\nえむけんが好きなので、それのへそバージョンといった形で\nへそをあの手この手で調べられる優祐くんがみたいです\n\n彼は出べそ気味で、検査の１つでへそを吸引して強制出べそになる描写がほしいです\n彼のセリフにへそやでべそといったセリフをなるべく多くいってもらいたいです\n以下のセリフを優祐くんのセリフとして入れてほしいです\n・自分のへその形について\n・へそ見られて恥ずかしいか\n・へそは誰と元々つながっているか\n・へその中身はどんな感じか　豆やしわはどのくらい\n・へそに関する経験したエピソードを教えてください\n・お母さんからは自分のへその形　どんなか言われたことあるか\n・でべそになってみた今の気持ち\n\nマニアックなリクエストですが、優祐くんがへそについて語ってる姿がぜひ見たいです！\n彼のセリフにへそやでべその発言多めだと嬉しいです\nよろしくお願いいたします", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@HHtakamiya/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 46198, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51ff6e37/uploads/origins/51bcacea-469a-4e2b-9694-7937423b9d42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=218658759287244032606da5270da0e1", "srcset": "https://si.imgix.net/51ff6e37/uploads/origins/51bcacea-469a-4e2b-9694-7937423b9d42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=218658759287244032606da5270da0e1, https://si.imgix.net/51ff6e37/uploads/origins/51bcacea-469a-4e2b-9694-7937423b9d42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6476cc5523ed932fab439b07f649ccd 2x, https://si.imgix.net/51ff6e37/uploads/origins/51bcacea-469a-4e2b-9694-7937423b9d42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ee239c45757a39e6deb1d585213625a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51ff6e37/uploads/origins/51bcacea-469a-4e2b-9694-7937423b9d42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6694f2537b9ca0db