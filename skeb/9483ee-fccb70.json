iuCSMtOalvh3piuRaw3Nn-Ga\n\nシチュエーション等の指定はありませんので、卯月さんの描きやすいように描いていただければ問題ありません！\n\nまた、もし可能であればなのですが、卯月さんの描かれる背景もとっても好きなので人物と背景分けたデータもいただけたら幸いです…！\n使用用途は鑑賞と、個人での利用（待受やSNSのアイコン、ヘッダーなど）を考えております。\n\n金額等不備がありましたらお気軽に再送、キャンセルお願いします。\n何卒ご検討のほどよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 105149, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "おかの🦍", "screen_name": "okn_25", "avatar_url": "https://pbs.twimg.com/profile_images/2024766368403664896/FcbNiALo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/839854264918790146/1715167928/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 2880276, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "exec。", "screen_name": "Exec0Exec", "avatar_url": "https://pbs.twimg.com/profile_images/1692701324453056512/Vs2QK-aR.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 95, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 3448413, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "電波障害さん", "screen_name": "denpawarukunai4", "avatar_url": "https://pbs.twimg.com/profile_images/1860612615376150528/gkBA9boF.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false