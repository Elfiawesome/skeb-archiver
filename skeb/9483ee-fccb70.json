0f0-e4540fad7777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea0481642f2dad44e9412bce9a5c261d, https://si.imgix.net/3aa103fa/uploads/origins/700746f0-a65c-4836-b0f0-e4540fad7777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7e64bebdad886e6dbd45c533b67f30ed 2x, https://si.imgix.net/3aa103fa/uploads/origins/700746f0-a65c-4836-b0f0-e4540fad7777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a0455f4e801379aa9752b755662def06 3x"}, "body": "こんにちは！続けざまにすみません、はるひこです。\n前回と同じくTRPG探索者のお願いになります。\n自探索者　澱巳 瑠音　https://dropbox.com/s/vb64nv6v9ffcdqk/yodomi.png?dl=0\n他探索者　辻本 楓馬　https://dropbox.com/s/q751b9r1gxx0nuo/16289891748066759.png?dl=0\n※他探索者はskebで依頼してもよいか、PLさんの許可を得ています。\n澱巳は身長165で年齢26歳、辻本は身長180で年齢36歳です。\n\n二人が遊園地でデートしてるイラストを描いていただけないでしょうか…！\n手をつないでいてもらえると凄く…嬉しいです…恋人同士です…\n何か食べ歩きしてる姿でも、観覧車乗ってるとかでも、シチュエーションはお任せします！\n紙吹雪とか舞ってるとご機嫌です…\nどうぞよろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@9483ee/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1471081, "client_id": 235151, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a1bc713/uploads/origins/172f3744-32bb-4d41-8f42-4181dd12c3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00711cf6e8c41b16fd798023710085d7", "srcset": "https://si.imgix.net/6a1bc713/uploads/origins/172f3744-32bb-4d41-8f42-4181dd12c3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00711cf6e8c41b16fd798023710085d7, https://si.imgix.net/6a1bc713/uploads/origins/172f3744-32bb-4d41-8f42-4181dd12c3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07ca7dd1b13c3a1e0100821e43ff62dc 2x, https://si.imgix.net/6a1bc713/uploads/origins/172f3744-32bb-4d41-8f42-4181dd12c3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eeefe5d5b41782689275497fe42560ea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a1bc713/uploads/origins/172f3744-32bb-4d41-8f42-4181dd12c3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=090223e14caa226168dd5f00fb4d6b6f", "srcset": "https://si.imgix.net/6a1bc713/uploads/origins/172f3744-32bb-4d41-8f42-4181dd12c3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=090223e14caa226168dd5f00fb4d6b6f, https://si.imgix.net/6a1bc713/uploads/origins/172f3744-32bb-4d41-8f42-4181dd12c3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c5b8b420d721c7d0d00e2f09d9db1f96 2x, https://si.imgix.net/6a1bc713/uploads/origins/172f3744-32bb-4d41-8f42-4181dd12c3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=690979731efec3128d7df201ffd142bf 3x"}, "body": "skeb新着で素敵なイラストに惹かれたので依頼したいと思いました。\n私のオリジナルキャラを描いていただけますか。\nキャラA：誰とでも仲良くなれる、いつも気まぐれで、実は腹黒い。\nキャラB：臆病で、被害者意識が強く、すぐに驚いて怯えてしまう。\n二人の関係：\n二人は同じ会社で働いている。BはAの先輩で、AはBの反応が面白いので、Bにいたずらするのが好き。BがAに怒ろうとすると、Aは無邪気な顔をして、前の出来事は自分の考えすぎだったのではないかとBに思わせる。Bは残業続きでいつも疲れた顔をしています。 でも、Aは残業しても元気そうで、いつもニコニコしています。\n\n二人が会社で働いているシーンを見たいです。Aが他の部門に移動したため、彼らは今同じ部門ではありません。だから、AはBの部門に話をしに来るかもしれません。ちなみに、Aはこの部門のメンバーと仲が良いので、みんなに歓迎されているのですが、Bは「なんでまた来るんだよ！！」という感じです。\nご検討ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1B8P5iT-vT9hRfTUBQhyw93x9i-dSLdQS?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@9483ee/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2903e8a5/uploads/origins/3716d72a-4067-4c6e-8997-1f5b6ecd29ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27b8830d2e1a5f87dadb0932ff7298a5", "srcset": "https: