下まで画面に入るようなイメージで、斜め下から見上げた視点でお願いします。マントは首元がたるんで少し胸が見えていて、マント越しにおっぱいや体の輪郭がわかるような密着具合です。\n表情は好きでもない男を誘惑するのですこし気乗りしない、もしくは努めて意識しないようにしている感じです\n\n以上になります。前回のリクエストから自重していたのですがまたみゆき先生の書くお姉さんキャラが見られたら幸いです。ご検討のほどよろしくお願いします\n\nhttps://imgur.com/a/72o7uan", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyukihaoekaki/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6cd2d374/uploads/origins/ec65d07f-abf6-4550-95d8-2880a72ff329?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=988d5ef668b742e4fec4f8579b90ed94", "srcset": "https://si.imgix.net/6cd2d374/uploads/origins/ec65d07f-abf6-4550-95d8-2880a72ff329?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=988d5ef668b742e4fec4f8579b90ed94, https://si.imgix.net/6cd2d374/uploads/origins/ec65d07f-abf6-4550-95d8-2880a72ff329?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e91f2077a22e97ae1f5e13f13e3e123 2x, https://si.imgix.net/6cd2d374/uploads/origins/ec65d07f-abf6-4550-95d8-2880a72ff329?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5480cbf166ef79a0dd6b84e6ce199084 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1789538, "client_id": 900642, "nc": 179}, {"path": "/@miyukihaoekaki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1789538, "client_id": 900642, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9df8f700/uploads/origins/78cc8a49-5c7c-465f-845d-713f8f5c83b5?bg=%23fff&aut