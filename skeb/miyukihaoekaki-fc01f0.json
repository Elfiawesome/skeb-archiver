media/Fkkgt8wVsAAzpFX?format=jpg&name=large\n\nシチュ:以前skebで描かれていたジンのイラストのような構図で、布越しにクリを指でカリカリと責められている様子を描いて頂きたいです。\nポーズは、ジンのイラストのものをベースに、両手を頭の後ろで組んで腋を見せるような感じでお願いします。\n責めている側は手だけで、身体等は描かなくて大丈夫です。\n\n表情は、恥ずかしがりながら快楽を我慢しているような感じでお願いします。\nまた、口元や腋に吐息や蒸れているような感じの湯気と汗も描いて頂けると非常に助かります。\n\n可能であれば、目隠しを付けられているものとこちらを睨みつけるような表情の差分を描いて頂けると嬉しいです。\n難しければ無視して頂いて問題ありません。\n\nおそらくご存じの無いキャラに加え、指定も細かくなってしまい申し訳ないのですが、よろしければご検討頂けますと幸いです。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyukihaoekaki/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1789538, "client_id": 1459964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d68ebdde/uploads/origins/58114958-f13d-494e-92c4-5564f3857d00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e77daef44618144a820041bab6c73c14", "srcset": "https://si.imgix.net/d68ebdde/uploads/origins/58114958-f13d-494e-92c4-5564f3857d00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e77daef44618144a820041bab6c73c14, https://si.imgix.net/d68ebdde/uploads/origins/58114958-f13d-494e-92c4-5564f3857d00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba1f75eb065c2747f2dbd43b63cd0638 2x, https://si.imgix.net/d68ebdde/uploads/origins/58114958-f13d-494e-92c4-5564f3857d00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dadba13ff350a068d86fc2d1c39a505c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d68ebdde/uploads/origins/58114958-f13d-494e-92c4-5564f3857d00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=417368ea4a93e94899fcec8d3b928154", "srcset": "https://si.imgix.net/d68ebdde/uploads/origins/58114958-f13d-494e-92c4-5564f3857d00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41736