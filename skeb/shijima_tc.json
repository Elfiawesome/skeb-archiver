r=200&s=b9fb3a47f838fadf0fc7fe521cd6d5fd", "src_set": ""}, "body": "はじめまして。\nシジマ様のイラストがとても素敵で、twitterなどのアイコンを描いていただきたいと思い依頼しました。\n\nジト目でちょっと不満そうな感じの才羽ミドリの絵を描いてほしいです。\n表情は控えめな感じ。\nバストアップサイズでお願いします。\n服装は公式準拠でお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shijima_tc/works/67", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3526219, "client_id": 58465, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f270140f/uploads/origins/98621754-80e9-4f61-bd3c-03994564f34b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41272fb8ee54389012bc2dfe454d14c2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f270140f/uploads/origins/98621754-80e9-4f61-bd3c-03994564f34b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a289b599de1645f2a72958a87350521e", "src_set": ""}, "body": "リクエストお願いします\nブルアカの黒見セリカ\n内容は先生のイタズラで気配消しながらセリカのスカートをめくってセリカに睨まれるシーンをお願いします\nセリカはスパッツはいてますが、スパッツ無しで白のレースのパンツでお願いします\n可能であれば表情差分をお願いします", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shijima_tc/works/66", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3526219, "client_id": 2066431, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35fd4d93/uploads/origins/b7fb032c-a0e3-4a97-bc33-6f86272ddc54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce14b8f93aa3222b1427d02d6d809a8c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35fd4d93/uploads/origins/b7fb032c-a0e3-4a97-bc33-6f86272ddc54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be6b7356f1a0a84e90f36e3e07381bdb", "src_set": ""}, "body": "シジマ様\n肌の塗の立体感やグルグル目で慌てる顔の可愛らしさが非常に魅力的でした\nうちの子になりますがリクエストしてよろしいでしょうか？\n\n・キャラクター(資料URL記載)\n資料内で読み取れない箇所は銀髪ロングでブレザー系の制服として解釈していただければ\n身長１６０センチ強でバストAカップの大人貧乳です\n\nくっころが似合いそうなクールで凛々しい感じですが、\n不運や意表を突かれてボロを出すギャップ萌えを表現していただけると嬉しいです\n\n\n・シチュエーション\nエロガキのスカートめくりか風の悪戯かで白パンツを丸見えにさせられたところ\n（構図はシジマ様の下記過去絵に近いお尻側＆振り向き\n　https://x.com/shijima_tc/status/1943627426426233200）\nスカートをお腹側だけ押さえててお尻ノーガードなポーズ\n（武器類はパトロール中という事で省略可）\n\n表情はぐるぐる目＋口を閉じてぐにゃぐにゃ・・・なもので\n可能であれば「こらー！（見るな！）」とジト目半泣きで怒ってる差分も頂ければ嬉しいです\n\n\n以上、ご検討よろしくお願いします\n\nhttps://downloads.fanbox.cc/images/post/9624632/YwlVVYICSP6ixGggnm4ho5SA.png", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shijima_tc/works/65", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3526219, "client_id": 2616430, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/233453da/uploads/origins/430325c8-6bd9-4dbb-9cfd-9ea986c7de18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24193888959ce5065e705d8ab44bef96", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/233453da/uploads/origins/430325c8-6bd9-4dbb-9cfd-9ea986c7de18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f9d5d3902256a3bb9842b592a1f4855", "src_set": ""}, "body": "こんにちは。\n前回、前々回と描いて頂いたイラストがとても素晴らしく、絵柄やテイストがとても好きなのでまた描いて頂けると嬉しいです。\n\n度々のご依頼となり恐縮ですが、よろしければ是非お願いします。\n\n◆キャラ\n医者アクリャ（原神）\nhttps://x.com/kuon_0123/status/1948718336113611179?t=HVbE7C_09FPpJqQT9oTZwA&s=19\n\n※参考画像が少なくてすみません。\n詳細分かりにくい部分はご自由にアレンジください。\n\n◆シチュエーション\n患者からの特殊な要求に戸惑う医者アクリャ\n\n◆構図\nソファや椅子に座った姿勢で、両足（素足）を患者（男性）の顔にのせています。\n男性の映り込みは最低限（シルエット等でもOKです）にして頂き、女の子を画面に大きく収めてください。\n両足のほぼ全ての爪（マニキュア等は無し）が見えるような構図でお願いします。\n\n◆服装\n参考画像の衣装でお願いします（サンダルは脱いだ状態）。\nまた、脱いだサンダルを構図の中に入れてもらえると有難いです。\n\n◆表情\n患者の求めに応じて足をのせるも、どんな効能があるのか理解できず困惑顔で。\nイメージとしては、こんな「！？」な感じです（表情差分があると嬉しいです）。\nhttps://skeb.jp/@shijima_tc/works/64\n\n◆納品\nPSDとPNG形式\n（PSDを扱うソフトがないため、PNG形式も併せて納品頂けると助かります）\n\n◆宛名\n宛名は「Quon」でお願いします。\n\nかなりマニアックな内容ですので、お好みでなければご遠慮なくキャンセルください。\nご検討いただけますと幸いです。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shijima_tc/works/64", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3526219, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4570bd0/uploads/origins/0ba2aa61-635d-4a11-9a00-20b9113b3038?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=295868be03b1e460c46c18c1ce5b59eb", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4570bd0/uploads/origins/0ba2aa61-635d-4a11-9a00-20b9113b3038?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5840c3c633e9a07aa9659892dbd948bf", "src_set": ""}, "body": "こんにちは、シジママ先生！先生の画風とブルーアーカイブイラストがとても好きなので、リクエストを送らせていただきました。\n\n私のOCを描いてほしいです。服装は私服でお願いします。\"リア カジュアル \"を参考にしてください。\n\nシナリオ\n寝室で服を脱いでいるところを描いてほしい。以前のリクエストと同じような感じでお願いします：\nhttps://skeb.jp/@shijima_tc/works/3\n\n背景は彼女の寝室で、部屋のどこかに彼女の上着があります。または、もっとシンプルな背景でも構いません。\n\nキャラクターの詳細\n- 銀白色の髪、水色の目\n- 中くらいのおっぱい（Dカップ）\n- ブルー・アーカイブのマリに似た性格\n\n表情が違うバージョンを入れても構いません。\n\nまた、もしよろしければヌードバージョンもお願いします（トップレスバージョンでも十分です）\n\n\n以上、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1C-LT3vcZaDH86lOmcygIIUpitmyxsVL2", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shijima_tc/works/63", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3526219, "client_id": 1822389, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/77079da6/uploads/origins/a4fcbd30-80f1-43ba-97a8-160caab1c559?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=462adce93e5c9bd133f0ffae7b798eda", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/77079da6/uploads/origins/a4fcbd30-80f1-43ba-97a8-160caab1c559?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1c4cd2e20a7f09d84cd24c5f0deb17a", "src_set": ""}, "body": "前回はカスピテルのパンチライラスト、本当にありがとうございます。まさにかっこいいパンチラそのものでした。今回も同キャラの別シチュで触手を描いてほしい…と思ってリクエストをしましたが、過去に触手絵を描いているのは見たことありませんし、最近凄い勢いでリクエストが入っていて忙しいのは分かっているので気が向かなければ遠慮なくキャンセルしてください。\nhttps://img.moegirl.org.cn/common/0/05/%E6%B8%B8%E6%88%8F%E7%8E%8B25%E5%91%A8%E5%B9%B4%E8%AE%BE%E5%AE%9A%E9%9B%86_%E9%A9%B1%E9%AD%94%E5%A7%90%E5%A6%B9%E5%8D%A1%E6%96%AF%E7%9A%AE%E7%89%B9%E5%B0%94.jpg\n「触手に絡まれるイラスト」をお願いします。\n触手は暗い赤系の色で、シンプルな肉系の触手です。植物やスライム、吸盤やイボ付きではありません。表面は白い粘液まみれで、糸を引いたり垂れたりしています。触手の太さは人の腕と同程度です。あまりぐるぐる巻きにはせず、緩く斜めに纏わりつく感じが良いです(半周から1周ぐらいの絡み方)。絡んでくる触手の数は何本でもいいのですが、キャラが見えなくなると勿体ないので3〜4ぐらいを想定しています。顔を舐めるように粘液を擦り付けたり、スカートや服に入ろうとしたりなどのフェチ要素があると嬉しいです。\n今回は武器なしですが、ヘアリボンと肩以外の水エフェクト、土星の輪の省略、履いているものはタイツとして描くなどキャラクター側は変わりません。\n具体的な構図、ポーズなどはお任せします。背景もシンプル、もしくは無くても構いません。\n表情差分があると嬉しいです。\n上記の要素を全て満たす必要はありません。必要なアレンジや要素の取捨選択は自由に行ってください。\nアブノーマルなテーマであることも忙しいことも承知の上でのリクエストです。それでも問題ない、ということであれば是非お願いします。あと四連続同キャラで飽きてたらすみません…", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shijima_tc/works/62", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f91cda84/uploads/origins/9601a544-c962-4901-8f51-805ba4f96378?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1380e723b3c0a4e6eed81b8571884b9d", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3526219, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder