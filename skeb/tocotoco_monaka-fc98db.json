https://si.imgix.net/b99057b3/uploads/origins/33c5b255-3d17-4295-821b-3015ed16df6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c81fa11516c4fd2ecacdb197f757f253 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b99057b3/uploads/origins/33c5b255-3d17-4295-821b-3015ed16df6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71aa66ad7af8db07ecd75acefc22de4a", "srcset": "https://si.imgix.net/b99057b3/uploads/origins/33c5b255-3d17-4295-821b-3015ed16df6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71aa66ad7af8db07ecd75acefc22de4a, https://si.imgix.net/b99057b3/uploads/origins/33c5b255-3d17-4295-821b-3015ed16df6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=efc070de4d37ea4c1a1d0b3accb264aa 2x, https://si.imgix.net/b99057b3/uploads/origins/33c5b255-3d17-4295-821b-3015ed16df6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=94a86612fdf8a32da333c4f97d769050 3x"}, "body": "ねとこも様\nお世話になっております。\nカードゲーマーVtuberの猫本にゃこです。\n\n以前、リクエストして描いていただいたイラストがとっても可愛らしく、\nすっごくお気に入りなのでまた描いていただきたくリクエストさせていただきます。\n\n構図やポーズなどはお任せいたしますが\n主にカードゲームのプレイマット用に使いたく、\n横長のサイズでイラストが大きく見える構図だととても嬉しいです。\n\n〇使用用途\n・グッズ販売やノベルティへの使用\n・収益化済YouTube用サムネイル\n・SNSでの告知 、アイコン、ヘッダー\n・VRChat内の自宅ワールドへの掲示\n\n〇ご要望:\n・モデル、服装は資料URL先の三面図を参考に、ポーズや構図などはお任せします。\n・サムネイルに使用する場合もあるので背景・宛名がある場合はon/offできる形式で納品いただけますと幸いです。\n・耳や髪など上半身は一部が切れないように描いて頂けると幸いです。\n\n以上、ご検討のほど宜しくお願い致します。\n\n以下三面図です\nhttps://drive.google.com/drive/folders/15Lqpb-_zCoDpEmVrSINXyXOid1KlpAKP?usp=sharing\n\nhttps://drive.google.com/drive/folders/15Lqpb-_zCoDpEmVrSINXyXOid1KlpAKP?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tocotoco_monaka/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_i