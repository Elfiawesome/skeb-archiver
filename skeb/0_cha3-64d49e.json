d": true, "creator_id": 1843555, "client_id": 187493, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0000ed71/uploads/origins/9f161553-bcf8-4741-acbe-59bb4ce2e465?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e477a510e4b49d5e02c0610fc778916", "srcset": "https://si.imgix.net/0000ed71/uploads/origins/9f161553-bcf8-4741-acbe-59bb4ce2e465?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e477a510e4b49d5e02c0610fc778916, https://si.imgix.net/0000ed71/uploads/origins/9f161553-bcf8-4741-acbe-59bb4ce2e465?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f60b988eaa4a4520503655a260aa9145 2x, https://si.imgix.net/0000ed71/uploads/origins/9f161553-bcf8-4741-acbe-59bb4ce2e465?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f88e6f7a23f3203e589d59401d87ca3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0000ed71/uploads/origins/9f161553-bcf8-4741-acbe-59bb4ce2e465?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e633e64627a4ca20091474170da8bde", "srcset": "https://si.imgix.net/0000ed71/uploads/origins/9f161553-bcf8-4741-acbe-59bb4ce2e465?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e633e64627a4ca20091474170da8bde, https://si.imgix.net/0000ed71/uploads/origins/9f161553-bcf8-4741-acbe-59bb4ce2e465?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3abc879a2cf0f133eece96805b1e9499 2x, https://si.imgix.net/0000ed71/uploads/origins/9f161553-bcf8-4741-acbe-59bb4ce2e465?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9b9994b5d3427fd3af66c9a082be792a 3x"}, "body": "こんにちは、はじめまして！\n\nこの2人のオリキャラのモノクロ漫画をお願いできませんでしょうか？\n参考資料の衣装はどれでもOKです。\n\nルーファス\n178cm。魔法使い。自己中心的で飄々としていてお茶目だが、内心とても優しいツンデレタイプ。ルーファスはローハンを愛しているが、それを表に出すのは恥ずかしい。\n\nローハン\n188cm。ルーファスに仕える黒豹の悪魔にして騎士。威厳があり、礼儀正しく、冷静。ルーファスのことが大好きで、密かにその愛情を渇望しているが、主人に自分の欲望を打ち明けるのはいけないことだと思っている。\n\n(シナリオ）\nローハンは来る侵略から街を守るため、出陣の準備をしている。ルーファスはローハンのことを心配しているが、それを表には出さず、飄々と振る舞っている。ローハンは去ろうとするが、ルーファスは彼をつかみ、ロマンチックに別れのキスをする。\n\nこのシーンは好みに応じて自由に変更できる。\n*台詞がある場合は日本語でも英語でもOK。\nもし間違っていたら、遠慮なくアピールを送ってください。\n\nいずれにせよ、このリクエストを読んでいただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/10so0210HuBS5IqrhSjyVNqh3rSmabcUy?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@0_cha3/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1843555, "client_id": 2872173, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a40d1de7/uploads/origins/8ba39d0f-5a82-4c0c-a5f4-9e13e07eb117?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ad84aa28d3ab7d7ac86bfb5dec74a8a", "srcset": "https://si.imgix.net/a40d1de7/uploads/origins/8ba39d0f-5a82-4c0c-a5f4-9e13e07eb117?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ad84aa28d3ab7d7ac86bfb5dec74a8a, https://si.imgix.net/a40d1de7/uploads/origins/8ba39d0f-5a82-4c0c-a5f4-9e13e07eb117?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b78c8ee498566766e1bedc136bdd54d 2x, https://si.imgix.net/a40d1de7/uploads/origins/8ba39d0f-5a82-4c0c-a5f4-9e13e07eb117?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f1a06a0f65aad401a8601348554a9d3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a40d1de7/uploads/origins/8ba39d0f-5a82-4c0c-a5f4-9e13e07eb117?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25ed4ca2beee13dc5b0a32ca8202fb2e", "srcset": "https://si.imgix.net/a40d1de7/uploads/origins/8ba39d0f-5a82-4c0c-a5f4-9e13e07eb117?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25ed4ca2beee13dc5b0a32ca8202fb2e, https://si.imgix.net/a40d1de7/uploads/origins/8ba39d0f-5a82-4c0c-a5f4-9e13e07eb117?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ee3ec092c5792ef4438cc37f4f2ee1ef 2x, https://si.imgix.net/a40d1de7/uploads/origins/8ba39d0f-5a82-4c0c-a5f4-9e13e07eb117?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=213c0b2203b654688d2b06cd5b3e3b83 3x"}, "body": "依頼内容\nオリジナル小説同人誌「エロゲ世界のモブに転生したオレの一生のお願い！・上」「同・下」の表紙イラスト\n\nhttps://www.alphapolis.co.jp/novel/543220625/279684773\n↑の「4-3.南への旅.3」の途中までが上巻に収録されます\n下巻には「4-3.南への旅.3」の途中から本編ラストまでが収録されます。番外編は収録されません。\n\n希望するテイスト\n上巻：主役二人をおまかせで。上巻収録分はBL味が薄いので、冒険ものっぽい感じだと嬉しいです。\n下巻：主役二人おまかせで。ハッピーBLっぽい感じだと嬉しいです。上巻と色味や構図が違うと見分けやすくて助かります。\n\n色指定\nアキオ：肌色薄め、髪眉目は茶〜黒\nカレル：肌色浅黒、髪眉ひげ暗めの茶〜黒、目は黄緑\nカレルの目の黄緑以外は、適当に変えていただいて大丈夫です！\n\n印刷所：おたクラブ\n本文仕様：A6文庫カバー付き、オンデマンド印刷\nカバー印刷仕様：アートポスト紙PP加工あり、デジタルオフセット印刷\n背幅：15ミリ(多少変更あり)\n\n画像データ使用目的\n・同人誌カバー印刷\n・Kindle direct publishing表紙(表1の画像のみ使用)\n・電子書籍(epub,pdf)販売時の表紙\n・web小説投稿サイト表紙(表1の画像のみ使用)\n・webでの宣伝\n・イベント時のポスター掲示\n・宣伝ペーパー\n\n上記以外の目的でイラストを使用させていただくことはありません。\nトリミング、グレースケール化、縮小、透かし、ロゴ入れ等の加工を行う可能性があります。　\n\n───────\nオチャさんのイラストが表紙になると思うと嬉しすぎて本文手直しする面倒くささもふっ飛びます！\n\nお忙しい中お手数おかけして恐縮ですが、どうぞ宜しくお願いします🙇\n\nhttps://www.alphapolis.co.jp/novel/543220625/279684773", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@0_cha3/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1843555, "client_id": 447125, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92496f12/uploads/origins/2d4e2a6f-2f2e-4adf-83af-d35f2e308779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06dff54f214d814d56adaf98f41c813c", "srcset": "https://si.imgix.net/92496f12/uploads/origins/2d4e2a6f-2f2e-4adf-83af-d35f2e308779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06dff54f214d814d56adaf98f41c813c, https://si.imgix.net/92496f12/uploads/origins/2d4e2a6f-2f2e-4adf-83af-d35f2e308779?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75d12d813b563f487328c919a24db526 2x, https://si.imgix.net/92496f12/uploads/origins/2d4e2a6f-2f2e-4adf-83af-d35f2e308779?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c17c6dd37a734ea8719c65cd928b795 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92496f12/uploads/origins/2d4e2a6f-2f2e-4adf-83af-d35f2e308779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ca585e2a36b6a49e1252edb6ed21873", "srcset": "https://si.imgix.net/92496f12/uploads/origins/2d4e2a6f-2f2e-4adf-83af-d35f2e308779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ca585e2a36b6a49e1252edb6ed21873, https://si.imgix.net/92496f12/uploads/origins/2d4e2a6f-2f2e-4adf-83af-d35f2e308779?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d362b9935783f37b350ae92705cf73d1 2x, https://si.imgix.net/92496f12/uploads/origins/2d4e2a6f-2f2e-4adf-83af-d35f2e308779?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b26b75aa24d9151c1d564e65ca53d150 3x"}, "body": "Hello ocha-san! I'm a big fan of your work.\n\nI'd like to request an illustration of my characters. \n\nOlder brother:\n-193cm, paladin. He fights with swords.\n- Tall and very muscular.\n- A stoic man who has a scary face. He's bad at smiling and talking, but he's kind, gentle, and patient, and greatly cares for his younger brother. He takes his younger brother's criticisms with a silent nod, never talking back.\n\nYounger brother:\n-178cm, mage. He summons snakes with his magic.\n- Dresses in heavy robes to hide his very thin figure, as well as the fact he's missing his right arm.\n- A beautiful man who is polite and charming to strangers, but becomes sarcastic and impatient around his older brother. He keeps his older brother out of trouble and often yells at him, but it's clear he does it out of love.\n\nPlease draw them working or travelling together, or maybe in battle. Please feel free to change their clothes, and I leave all other details to you.\n\nThank you for your consideration!\n\nhttps://drive.google.com/drive/folders/1c5aO9ZDYDb3BPUGuV7uMa8VJFJKfAhVz?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@0_cha3/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1843555, "client_id": 991142, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ea2c940/uploads/origins/2158e439-b466-4d95-9daf-878e3fa270fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43c8df31dfafb1694714e3b7ab2448f0", "srcset": "https://si.imgix.net/2ea2c940/uploads/origins/2158e439-b466-4d95-9daf-878e3fa270fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43c8df31dfafb1694714e3b7ab2448f0, https://si.imgix.net/2ea2c940/uploads/origins/2158e439-b466-4d95-9daf-878e3fa270fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59394802f3408f3df87aa6262ec94a24 2x, https://si.imgix.net/2ea2c940/uploads/origins/2158e439-b466-4d95-9daf-878e3fa270fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9aef4181646f02627323589b4ea99495 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ea2c940/uploads/origins/2158e439-b466-4d95-9daf-878e3fa270fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a561f3c98c91ce2fd76f3046bb30737b", "srcset": "https://si.imgix.net/2ea2c940/uploads/origins/2158e439-b466-4d95-9daf-878e3fa270fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a561f3c98c91ce2fd76f3046bb30737b, https://si.imgix.net/2ea2c940/uploads/origins/2158e439-b466-4d95-9daf-878e3fa270fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=161532ec78e6ec0f6bd99af51a7aebff 2x, https://si.imgix.net/2ea2c940/uploads/origins/2158e439-b466-4d95-9daf-878e3fa270fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=13696d03e7d4189cf971f9faafbb02d5 3x"}, "body": "おちゃさん、こんにちは！あなたの絵がとても好きなので、skebを開設したのを見て興奮しました！私のOCを描いてくれませんか？\n\n彼は記憶喪失の精霊で、自分の本当の名前とアイデンティティを思い出す旅をしています。元の性格や自分をほとんど覚えていないため、かなり無口で陰気な人物に見える。言葉を覚えるのが苦手なので、めったに声を出さない。パニックを起こしたり、泣き出したりしやすく、扱いにくい。顔や手に多くの傷跡があるが、なぜそうなったのかは覚えていない。\n\n昔は作曲や演奏が好きな美しい貴族だった。もちろんもうその記憶はないが、今でもどことなく高貴で堂々としたオーラを放っている。\n\nイラストはお茶さんにお任せしたいと思います。私のOCを自由に描いてください。出来れば着色して欲しいのですが、もし送った金額で足りなければ再リクエストをお願いします！本当にありがとうございました！❤\n\nhttps://drive.google.com/drive/folders/1MWRpJ2TWcjIjG26hnJljpa15lry4quMb", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@0_cha3/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1843555, "client_id": 2577424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4622542/uploads/origins/eae8e536-e27f-42c3-8992-a4c4d3898e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a91bd6322250b185eee21e81dcaf1bf8", "srcset": "https://si.imgix.net/c4622542/uploads/origins/eae8e536-e27f-42c3-8992-a4c4d3898e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a91bd6322250b185eee21e81dcaf1bf8, https://si.imgix.net/c4622542/uploads/origins/eae8e536-e27f-42c3-8992-a4c4d3898e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fca311fbf1b46ff0aba28f678a8e3ed6 2x, https://si.imgix.net/c4622542/uploads/origins/eae8e536-e27f-42c3-8992-a4c4d3898e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=455ffed2d862d1704066b580c0150ea3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4622542/uploads/origins/eae8e536-e27f-42c3-8992-a4c4d3898e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b1026f06497d3edfb76a06ef66ea835", "srcset": "https://si.imgix.net/c4622542/uploads/origins/eae8e536-e27f-42c3-8992-a4c4d3898e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b1026f06497d3edfb76a06ef66ea835, https://si.imgix.net/c4622542/uploads/origins/eae8e536-e27f-42c3-8992-a4c4d3898e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=09ff880fe38174b3424ea2d3c04196a2 2x, https://si.imgix.net/c4622542/uploads/origins/eae8e536-e27f-42c3-8992-a4c4d3898e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=302928084b09eb7b64fcaa49350281c4 3x"}, "body": "こんにちわ！skebの開設ありがとうございます！\n以前ピクシブリクエストの方でオリジナルの騎士カップルのリクエストさせていただいた者です。その節はその節は素敵な作品を本当にありがとうございました！ことあるごとに眺めては目の保養にさせていただいております！\nocha様の素敵なイラストのおかげもあり、創作意欲がわいてあれからド素人ながら彼らの小説を書き始めまして、よろしければ是非そのワンシーンのイラストをお願いできないかと思いましてリクエストさせていただきました！\nもしお忙しかったり、もう描き飽きたよって場合は遠慮なくキャンセルしていただいて大丈夫です！是非ご検討いただければ幸いです。\n\nキャラクターはピクシブリクエストと同じリカルドとノクスです。\n(詳細は資料をご確認いただければと思います）\nシチュエーションですがこちらの小説のラストの夕方のお城の中庭(背景なくても大丈夫です）でリカルド（訓練後なので多分ラフな私服）がノクス（お仕事後なので多分騎士服(マントはなくてOKです））マーガレットの花の婚約指輪を送るシーンをお願いできればと思います！\n(長いので全部読まなくても大丈夫です！資料の中に抜粋入れております）\n\nhttps://www.pixiv.net/novel/show.php?id=19737694\n\n形式はもし可能であれば１Pほどの漫画形式(セリフはあってもなくても大丈夫です）で見てみたいなあと思いつつ、難しければイメージの一枚絵でも良いですし、数カットの絵にしていただいても大丈夫です！ocha様の\n描きたい形式でお任せいたします！\n\n何度も同じキャラのリクエストで大変恐縮ですが、是非またocha様の描くうちの子たちが見たいので、ご多忙かと思いますが何卒ご検討のほどよろしくお願い致します！\n\n\n暑い日が続いておりますので、どうぞ熱中症などにはお気を付けくださいませ！お読みいただきありがとうございました。\n\nhttps://www.dropbox.com/scl/fo/3k9g0yygxffbwssh3vvbx/h?rlkey=woav5zhn5ss6hohnpgrxyxi2l&dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@0_cha3/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1843555, "client_id": 1068142, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6303676/uploads/origins/cb7ecba8-766a-4f46-b3de-91ec8241035d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce5aff03fa2059cf2989bbbc5a18aae2", "srcset": "https://si.imgix.net/c6303676/uploads/origins/cb7ecba8-766a-4f46-b3de-91ec8241035d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce5aff03fa2059cf2989bbbc5a18aae2, https://si.imgix.net/c6303676/uploads/origins/cb7ecba8-766a-4f46-b3de-91ec8241035d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5994d9801a92aec79c5344aa18cd1b9 2x, https://si.imgix.net/c6303676/uploads/origins/cb7ecba8-766a-4f46-b3de-91ec8241035d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22d27d4813043eea60afb0626b39ff95 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6303676/uploads/origins/cb7ecba8-766a-4f46-b3de-91ec8241035d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0840bbd59f6dbb9f4f9a48aa42c7d098", "srcset": "https://si.imgix.net/c6303676/uploads/origins/cb7ecba8-766a-4f46-b3de-91ec8241035d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0840bbd59f6dbb9f4f9a48aa42c7d098, https://si.imgix.net/c6303676/uploads/origins/cb7ecba8-766a-4f46-b3de-91ec8241035d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=faed2b0ae5cabf8466f157f28cb55567 2x, https://si.imgix.net/c6303676/uploads/origins/cb7ecba8-766a-4f46-b3de-91ec8241035d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=58aae4090b550587d6def3f5dee44df4 3x"}, "body": "先生、こんにちは！私の友人とOCが一緒に写っている写真をリクエストしてもいいですか？二人は親友で恋人同士。夫婦のようにいがみ合ったり、言い争ったりすることもありますが、お互いにとても遊び好きで、愛情深いです。\n\n金髪の少年（ビョルン）は195cm、青い髪の少年（海斗）は177cm。ふたりとも筋肉質だが、背の高いほうがより筋肉質だ。ビヨルンは気楽で自信に満ちた性格で、海斗は真面目だが友達の前ではおどけがちだ。ビーチや水着がテーマだと楽しいと思うけど、どんな衣装や構図でも構わないよ！やりたいことを自由にやってください！足りなければ再送してください！\n\nご検討ありがとうございました！\n\nhttps://imgur.com/a/tTDbHfa", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@0_cha3/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1843555, "client_id": 2482875, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2f4ad29/uploads/origins/a9a77353-da80-4f3e-8f99-9b8deee27016?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56085540d2236c8b588421b64f95b204", "srcset": "https://si.imgix.net/a2f4ad29/uploads/origins/a9a77353-da80-4f3e-8f99-9b8deee27016?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56085540d2236c8b588421b64f95b204, https://si.imgix.net/a2f4ad29/uploads/origins/a9a77353-da80-4f3e-8f99-9b8deee27016?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d516efca9917c0133c9c2ddb375deb65 2x, https://si.imgix.net/a2f4ad29/uploads/origins/a9a77353-da80-4f3e-8f99-9b8deee27016?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b31269b9b46acac146461eaa7062cbf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2f4ad29/uploads/origins/a9a77353-da80-4f3e-8f99-9b8deee27016?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00f7824ce4a3ade2ec8b48ddb24d383a", "srcset": "https://si.imgix.net/a2f4ad29/uploads/origins/a9a77353-da80-4f3e-8f99-9b8deee27016?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00f7824ce4a3ade2ec8b48ddb24d383a, https://si.imgix.net/a2f4ad29/uploads/origins/a9a77353-da80-4f3e-8f99-9b8deee27016?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c53a5b0dae7fade4e8f4c6c10b139042 2x, https://si.imgix.net/a2f4ad29/uploads/origins/a9a77353-da80-4f3e-8f99-9b8deee27016?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a77a636498e840f8f9d39c86e2cbe1d 3x"}, "body": "こんにちは！あなたの絵が大好きです。私のキャラクター、Mono Chromeを考えてもらえますか？\n\n彼はカラフルな世界設定のモノクロームの少年です。彼の周りは何があってもカラフル。自分の色を探している少年。\n\n- 白い髪\n- モノクロのスカーフで顔の半分を覆っているため、表情は謎のまま。\n- スカーフは伸ばそうと思えばいくらでも伸ばせる。\n- どの色と関わるかによって性格や雰囲気が変わる（例：例：黄色い環境にいれば、彼は幸せである。青い環境では悲しげになる。）\n\n背景、ポーズ、表情はお好みで。リクエストにお答えいただきありがとうございました！\n\nhttps://photos.app.goo.gl/KTMVSAruobxnUnaV6 (キャラクターシート)\nhttps://toyhou.se/3439102.mono-chrome（彼の芸術）", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1288272, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "moto", "screen_name": "ityohii_", "avatar_url": "https://pbs.twimg.com/profile_images/1644665960635445248/HlKxgQkw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1304089475677523969/1694215159/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 16}, {"id": 1797217, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "LOHAS／ロハス", "screen_name": "vvvvmom", "avatar_url": "https://pbs.twimg.com/profile_images/1487790383723855872/CAhrmLoB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/775656365838610432/1480247639/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}, {"genre": "c