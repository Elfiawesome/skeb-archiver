oogle.com/drive/folders/1yS4VgtvZnZGZl8Q6CTbOO37rCCimRi1j", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@0_cha3/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1843555, "client_id": 710805, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c609f63/uploads/origins/2dbd761e-45d3-4b7a-b28e-98d2e3304d89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da71c14f875670e5bbbe136eb1179146", "srcset": "https://si.imgix.net/9c609f63/uploads/origins/2dbd761e-45d3-4b7a-b28e-98d2e3304d89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da71c14f875670e5bbbe136eb1179146, https://si.imgix.net/9c609f63/uploads/origins/2dbd761e-45d3-4b7a-b28e-98d2e3304d89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0d2258e94b6ede02843baf7f3d25fd7 2x, https://si.imgix.net/9c609f63/uploads/origins/2dbd761e-45d3-4b7a-b28e-98d2e3304d89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d36eeb77a57d24b073b38f58ce6615f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c609f63/uploads/origins/2dbd761e-45d3-4b7a-b28e-98d2e3304d89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26d3ae36e4c34d75de3803e6a455c82a", "srcset": "https://si.imgix.net/9c609f63/uploads/origins/2dbd761e-45d3-4b7a-b28e-98d2e3304d89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26d3ae36e4c34d75de3803e6a455c82a, https://si.imgix.net/9c609f63/uploads/origins/2dbd761e-45d3-4b7a-b28e-98d2e3304d89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3dc2e50d7c354bc4da0b0142a40263ae 2x, https://si.imgix.net/9c609f63/uploads/origins/2dbd761e-45d3-4b7a-b28e-98d2e3304d89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3a9a50431626014d6095c28ef09b9f3d 3x"}, "body": "お茶先生！はじめまして！あなたの作品の表現力、エモーショナルさが大好きです。\n\n女性の描き方も好きです：\nhttps://x.com/0_cha3/status/1695996284493242803\n男性の描き方も好きです：\nhttps://www.pixiv.net/en/artworks/105048584\n\nこの2人のキャラクターのモノクロコミックを注文できますか？ジェシー（男）とアン（女）です。情報はURLにあります。\n\nジェシーがリーダーで、アンがアシスタント。彼らはまだ恋人同士ではないが、特別な絆で結ばれている。ジェシーは仲間の死に責任を感じている。アンは自分の手を汚して彼の手を清潔に保つことで、その重荷を軽減しようとする。\n\n描いていただけますか？\n1.ジェシーは廊下を歩きながら、自分の命を犠牲にしてでも政治家に復讐するつもりでいる。\n2.アンが彼を止める。\n3.ジェシーは彼女を脅す（壁ドン）。\n4.アンは彼のハッタリに挑戦し、彼女に怪我をさせろと言う。\n5.アンは彼にキスする。彼はキスを返す。\n6.復讐の時期は過ぎた。\n\nご配慮ありがとうございました。\n\nhttps://queencamellia.notion.site/Jesse-Anne-JPN-63156101117e4f939c39a9ed394cf0d6", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@0_cha3/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1843555, "client_id": 2205878, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc048840/uploads/origins/6cbf0c69-ef30-44b3-a1f9-7a233c91aaa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1311626fc4203303a52eaa206916f8b4", "srcset": "https://si.imgix.net/fc048840/uploads/origins/6cbf0c69-ef30-44b3-a1f9-7a233c91aaa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1311626fc4203303a52eaa206916f8b4, https://si.imgix.net/fc048840/uploads/origins/6cbf0c69-ef30-44b3-a1f9-7a233c91aaa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc9d83bfc9a0fcae8654fd0515693978 2x, https://si.imgix.net/fc048840/uploads/origins/6cbf0c69-ef30-44b3-a1f9-7a233c91aaa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=320fe7ba44e828498db328a1e5ec87db 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc048840/uploads/origins/6cbf0c69-ef30-44b3-a1f9-7a233c91aaa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e1e7a4c6b27440f708b34234078d53e", "srcset": "https://si.imgix.net/fc048840/uploads/origins/6cbf0c69-ef30-44b3-a1f9-7a233c91aaa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e1e7a4c6b27440f708b34234078d53e, https://si.imgix.net/fc048840/uploads/origins/6cbf0c69-ef30-44b3-a1f9-7a233c91aaa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a65a2b5aa2b226333826edf5b411db8 2x, https://si.imgix.net/fc048840/uploads/origins/6cbf0c69-ef30-44b3-a1f9-7a233c91aaa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7cc7bee8caa26e6b8f9e94f174cf5d40 3x"}, "body": "こんにちは、おちゃさん！\n私はあなたの作品の大ファンで、私のキャラクターのイラスト・漫画をお願いしたいのですが！\n\nカリックス：\n- 173cm、がっしりした体格。牙が目立ち、左目は魔法のグラスアイ。\n- 優しくてチャーミングな冒険者。戦闘では近距離戦が得意。\n- 料理が好きで、魔道士の友人に甘える。\n- 笑顔が多く、温厚な性格。\n\nロリン\n-身長165cm、威圧的だが可愛らしい顔、小柄で細い体。目袋が目立つ。\n- ローブを着ていることもある。ローブを着ているときもあれば、着ていないときもある！\n- 魔力は赤い蝶の形で現れ、力は弱いがとても強い魔道士。\n- あまり笑わず、冷たく見えるが、心の底では友人を大切に思っており、戦場では彼の面倒を見る。まるで猫のようだ。\n\n服装の改造はご自由にどうぞ。設定は中世ファンタジーです。どうぞ楽しんでください！\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1mG6707NG9AcuSrIU12siVGuYGejHBx42?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@0_cha3/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1843555, "client_id": 1361674, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/337b62e6/uploads/origins/a0f1fa51-9573-40e4-a14b-68af022f16fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cbeaa3459a1f95a36a62bcfe0725a46", "srcset": "https://si.imgix.net/337b62e6/uploads/origins/a0f1fa51-9573-40e4-a14b-68af022f16fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cbeaa3459a1f95a36a62bcfe0725a46, https://si.imgix.net/337b62e6/uploads/origins/a0f1fa51-9573-40e4-a14b-68af022f16fc?bg=%23fff&au