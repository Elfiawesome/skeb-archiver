ディテールは、乱れた茶色の髪、二本の角、茶色の目です。彼女はドラゴンですが、一部だけ鱗があります。ウエストアップの写真が欲しい。尻尾や鱗はなくてもいい。彼女の表情は:3の顔のようだ。嬉しそう。\n\nこの写真に背景は必要ない。\n\n衣装 https://imgur.com/a/GLdUF94\n\nこれは私が考えている衣装です。メイド服！\n\nhttps://imgur.com/a/eF7bFMM", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoshigamirai/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 622318, "client_id": 177871, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef6c7b39/uploads/origins/48f90680-45a3-46da-aa31-27130dfe8e4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9222ad5164b51fc6d5d072358e1288cc", "srcset": "https://si.imgix.net/ef6c7b39/uploads/origins/48f90680-45a3-46da-aa31-27130dfe8e4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9222ad5164b51fc6d5d072358e1288cc, https://si.imgix.net/ef6c7b39/uploads/origins/48f90680-45a3-46da-aa31-27130dfe8e4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eae571b01c4a8ac9aff4b391b792b690 2x, https://si.imgix.net/ef6c7b39/uploads/origins/48f90680-45a3-46da-aa31-27130dfe8e4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b29b55929b4d12d24a709bdcf944901f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef6c7b39/uploads/origins/48f90680-45a3-46da-aa31-27130dfe8e4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4342cad52f970aea6b8a4d79bfa84fc", "srcset": "https://si.imgix.net/ef6c7b39/uploads/origins/48f90680-45a3-46da-aa31-27130dfe8e4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4342cad52f970aea6b8a4d79bfa84fc, https://si.imgix.net/ef6c7b39/uploads/origins/48f90680-45a3-46da-aa31-27130dfe8e4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=99c40057613222d5d8a05