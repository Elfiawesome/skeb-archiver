ともほんわかニコニコ楽しそうな具合で！\n・衣装の細部等は自由に簡略化して構いません\n・背景は何だかあったかな感じの単色塗り等簡易なもので大丈夫です！\n・ドクターの顔は原作同様黒く影になっていて見えないように\n\n【留意して頂けると嬉しい点】\n・あったかほわほわな雰囲気で2人が楽しそう!!!(←一番見たいポイント)\n・グラベルちゃんが可愛い！\n\n【参考画像】\n・グラベル(スタイリッシュナイト衣装)立ち絵\nhttps://static.wikia.nocookie.net/mrfz/images/a/a4/Gravel_Skin_1.png/revision/latest?cb=20210406095949\n\n・ドクター立ち絵\nhttps://static.wikia.nocookie.net/mrfz/images/6/6c/Doctor.png/revision/latest?cb=20190823210844", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 462489, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "やぎ🐾", "screen_name": "__8gi", "avatar_url": "https://pbs.twimg.com/profile_images/1520400265915994113/Y-OYlvxX.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1158824775940112384/1779438988/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 875893, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "jino", "screen_name": "jino_engine", "avatar_url": "https://pbs.twimg.com/profile_images/2059482779843477504/oGjqQ-jL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1479429480213250049/1781367098/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "none", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 893953, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぷかぁく👾", "screen_name": "game_pklk", "avatar_url": "https://pbs.twimg.com/profile_images/1923158259265044481/MJcyqmgA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/88