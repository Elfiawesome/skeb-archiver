、細かな点はお任せします。\n・シチュエーション\n　ベッドの上でラブラブな感じでキスやえっち、最後に気持ちよさそうにイッている様子が見られると嬉しいです。\n・その他\n　ページ数やその他詳細はお任せしますので、描きやすいようにご調整いただければと思います。\n\n是非ご検討をよろしくお願いします。\nhttps://drive.google.com/drive/folders/1hlEBZtqAH0sv1IalqRJJkX_lO7xQUlK-?usp=drive_link", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurinemg/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/472f1dcc/uploads/origins/e504bc96-b0eb-4542-b2de-3dfe7be25b76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa60db5a7126d2ca45bae18bea5ebb20", "srcset": "https://si.imgix.net/472f1dcc/uploads/origins/e504bc96-b0eb-4542-b2de-3dfe7be25b76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa60db5a7126d2ca45bae18bea5ebb20, https://si.imgix.net/472f1dcc/uploads/origins/e504bc96-b0eb-4542-b2de-3dfe7be25b76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a3137702a5d91b7c1b6b37d015de299 2x, https://si.imgix.net/472f1dcc/uploads/origins/e504bc96-b0eb-4542-b2de-3dfe7be25b76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36f3883c725d441c427e79bf5e2f4d0f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2791014, "client_id": 283045, "nc": 160}, {"path": "/@kurinemg/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2791014, "client_id": 136776, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/264472ef/uploads/origins/8ec51383-86cc-4e29-8198-a12fe69c90ea?bg=%23fff&auto=format%2Cc