f4-6adaed311fd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6fe0f6924ed5e9c6af488fb15d0306df", "srcset": "https://si.imgix.net/ecda13f9/uploads/origins/f2a947b1-8390-4223-b3f4-6adaed311fd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6fe0f6924ed5e9c6af488fb15d0306df, https://si.imgix.net/ecda13f9/uploads/origins/f2a947b1-8390-4223-b3f4-6adaed311fd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=577a5867f0815b33bdb7bfa59e9a89b6 2x, https://si.imgix.net/ecda13f9/uploads/origins/f2a947b1-8390-4223-b3f4-6adaed311fd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cd49654184a9bc1ec408ace86020811e 3x"}, "body": "こんにちは、初めまして。\nスケブ上で先生の綺麗なイラストが目に止まりリクエストさせて頂きたいです。\n今回、自分が応援しているVTuberの「ねむね むぅ」さんに2周年記念イラスト送りたく、依頼をお願いしたいと思っています。\n\n詳細\n髪型　ツインテール\n髪色　薄い灰色、下の方が桜色のグラデーション　水色のメッシュ\n瞳　対面で左がピンク、右が水色\n\nhttps://lit.link/muu0222\n\n衣装は下記の資料にて\n構図に関しましては2周年が分かるようなポーズ(ピース等)を入れて欲しく、他は基本お任せでお願いしたいと思っています。\nイラストの上と左右が見切れないようにお願いします。\n\n御本人様のみYouTubeやX、FAN BOX等の活動上での使用許可を頂けますでしょうか、許可頂けるのならば、人物のみの背景透過PSDを頂けますと幸いです。\n\nリクエストのご検討のほどお願い致します。\n\nhttps://drive.google.com/drive/folders/1QpH6BXSv2bODfUMBDtCgiij1vy_HP7Lh?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pafe_yuzuran/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 312814, "client_id": 551497, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/559bbc5e/uploads/origins/638764d9-75d8-4249-ab85-2acc58a2d30c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fb8a29e6e9827380c8f1a305d4b7b2e", "srcset": "https://si.imgix.net/559bbc5e/uploads/origins/638764d9-75d8-4249-ab85-2acc58a2d30c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fb8a29e6e9827380c8f1a305d4b7b2e, https://si.imgix.net/559bbc5e/uploads/origins/638764d9-75d8-4249-ab85-2acc58a2d30c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cea417a9a42e00577d8ffb9e0bf46ecb 2x, https://si.imgix.net/559bbc5e/uploads/origins/638764d9-75d8-4249-ab85-2acc58a2d30c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=901c1fba7a6f3b6912e0b4c0ad8dbbce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/559bbc5e/uploads/origins/638764d9-75d8-4249-ab85-2acc58a2d30c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8be60dc8ca42bf9440d620f45352e51b", "srcset": "https://si.imgix.net/559bbc5e/uploads/origins/638764d9-75d8-4249-ab85-2acc58a2d30c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8be60dc8ca42bf9440d620f45352e51b, https://si.imgix.net/559bbc5e/uploads/origins/638764d9-75d8-4249-ab85-2acc58a2d30c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=47b18168c1b929cf8c20d6e9b52b2970 2x, https://si.imgix.net/559bbc5e/uploads/origins/638764d9-75d8-4249-ab85-2acc58a2d30c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e9950fbc80536539f2b1ab9419a841df 3x"}, "body": "ゆずらん先生初めまして！\nとてもかわいらしいイラストをPixivで拝見させていただき、リクエストさせていただきました。\n私の推しの VTuberの白瀬あおいちゃんのお誕生日イラストを描いていただけないでしょうか？ \n\n本人の情報\nお歌とアイスが大好きなしろくまVTuber\n髪、眉、まつ毛、肌の色は白\nお誕生日 12/3\n\n細かい構図等はお任せします。\nどこかにマスコットキャラのあおくまちゃんがいるお誕生日らしいイラストにしていただければありがたいです。\n\n用途としては本人にプレゼントしたく思いますので、本人のYouTubeのサムネやTwitterなどの使用に許可を頂きたいです。\nまた可能でしたらデータはpsdで、キャラと背景のレイヤーを分けていただけると嬉しいです。\n 何卒ご検討よろしくお願いいたします。\n \nYouTube\nhttps://youtube.com/channel/UC4SUl-nTftCcl3t7NKPd0_Q\nTwitter\nhttps://twitter.com/shiroseaoi?t=YLkcYOdmkOQX4_GczrdyDQ&s=09\n画像まとめ\nhttps://drive.google.com/drive/folders/17ZI4kstsoHE5je7LxAz9PYxYw-ycVpLW?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, 