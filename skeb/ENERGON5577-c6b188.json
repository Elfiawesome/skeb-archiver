あたりまでは描いていただけると助かります。\n\n衣装はデフォルトのものでOKです。\nまた、可能でしたら出来る範囲で服越しでの胸ポチ描写もお願いしたいのですが、こちらはアビビさんのご判断にお任せします。\n\n表情は、キリッとしたもの(口は笑っていてほしいです)と、こちらを挑発するような笑顔(こちらも、出来る範囲で構いません)と、二通り描いていただきたいです。ポーズはそのままで良いです。\n\nお忙しいところ恐縮ですが、ご検討いただきますようよろしくお願い申し上げます。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 657709, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "血洗島", "screen_name": "shinzouodorigui", "avatar_url": "https://pbs.twimg.com/profile_images/2055236185157726208/4emKDBh4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3096081816/1766880357/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 997377, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "りゅうし🐇しばらく低浮上", "screen_name": "Ryushi_RL", "avatar_url": "https://pbs.twimg.com/profile_images/1381990814365016068/7mdW-Qz1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1040623343211147264/1623683907/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 136}, {"id": 1194663, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "Bitmart 摸鱼大队（反92）", "screen_name": "Hi_Gero", "avatar_url": "https://pbs.twimg.com/profile_images/2036723050201358337/QvcHs9av.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2754699914/1774427593/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null