llustrations, so there is no problem at all if you ignore everything I've said so far and draw whatever you want.\n\nI would appreciate it if you could respond to my request when you are free.\n\nI love Yonha's drawings. ！！！！！！！！！！！！！！！！\n\nhttps://iachara.com/view/2611507", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 45900, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "とりのめ", "screen_name": "dobunomeme", "avatar_url": "https://pbs.twimg.com/profile_images/1350165304526004226/8pROvp8S.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3064651358/1672823766/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 529427, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🦔おてん🦔", "screen_name": "if959u", "avatar_url": "https://pbs.twimg.com/profile_images/1406272195551055876/lM_zqnxg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/790832008561692672/1687880086/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 2559387, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "涬(kei)", "screen_name": "kei0x0k", "avatar_url": "https://pbs.twimg.com/profile_images/1610974867133980672/QS4spg7p.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1596542351895592960/1678104035/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip