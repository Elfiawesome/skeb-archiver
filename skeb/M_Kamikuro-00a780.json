.com/5pqofrdxzmgcn2p?s=21", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@M_Kamikuro/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "correction", "tipped": true, "creator_id": 3582232, "client_id": 3540536, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e9af8eb/uploads/origins/249b09c5-4be2-4e2d-b3a3-976969ff90b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78b9d251be27b7abaf63d08e75c880c3", "srcset": "https://si.imgix.net/1e9af8eb/uploads/origins/249b09c5-4be2-4e2d-b3a3-976969ff90b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78b9d251be27b7abaf63d08e75c880c3, https://si.imgix.net/1e9af8eb/uploads/origins/249b09c5-4be2-4e2d-b3a3-976969ff90b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9497b7778e0a7c4ecefc71562cec0aef 2x, https://si.imgix.net/1e9af8eb/uploads/origins/249b09c5-4be2-4e2d-b3a3-976969ff90b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0f2b662538d0d5b145d651904b0eba1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e9af8eb/uploads/origins/249b09c5-4be2-4e2d-b3a3-976969ff90b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce55f0e69ea5066cec4a6dc9f40bbefd", "srcset": "https://si.imgix.net/1e9af8eb/uploads/origins/249b09c5-4be2-4e2d-b3a3-976969ff90b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce55f0e69ea5066cec4a6dc9f40bbefd, https://si.imgix.net/1e9af8eb/uploads/origins/249b09c5-4be2-4e2d-b3a3-976969ff90b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5cadb646d4549003c8cb91f02cc2413b 2x, https://si.imgix.net/1e9af8eb/uploads/origins/249b09c5-4be2-4e2d-b3a3-976969ff90b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=26efa40ce5d78924ec6848a349899e39 3x"}, "body": "初めまして。\nキャラへの影の入れ方について、アドバイスをいただきたいと思いリクエスト送りました。\n\nキャラの顔全体や広い範囲に影が落ちるとき、カラーイラストだとそのまま影になる部分を入れてあげればいいかと思いますが、ペン画だと顔にそれをやると、線の入れ方が悪いと思いますが汚くなってしまう感覚があります。\n\nいま描こうとしているのが、奥に祭りの灯りがあって、目の前にいるキャラの大部分(広い範囲)が影が落ちるようなもの感じです。\n他の方のイラストを見てると、そもそも影の有無の考え方もあるかと思います。\n\nざっくりとしているかと思いますが、松村さんなりの考え方や入れ方を聞けたら幸いと思います。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@M_Kamikuro/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3582232, "client_id": 3583281, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b105316a/uploads/origins/89aa983c-679e-4c99-aa45-05f7a893b316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6b1bbe0baefa6052b72a08fb5da0cfe", "srcset": "https://si.imgix.net/b105316a/uploads/origins/89aa983c-679e-4c99-aa45-05f7a893b316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6b1bbe0baefa6052b72a08fb5da0cfe, https://si.imgix.net/b105316a/uploads/origins/89aa983c-679e-4c99-aa45-05f7a893b316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac7284b5255077e9b04f4eb515812c5e 2x, https://si.imgix.net/b105316a/uploads/origins/89aa983c-679e-4c99-aa45-05f7a893b316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c7b7e89c5fad0d7c725903aee44deeb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b105316a/uploads/origins/89aa983c-679e-4c99-aa45-05f7a893b316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14e9d35695b57387d66a4903af5e0190", "srcset": "https://si.imgix.net/b105316a/uploads/origins/89aa983c-679e-4c99-aa45-05f7a893b316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14e9d35695b57387d66a4903af5e0190, https://si.imgix.net/b105