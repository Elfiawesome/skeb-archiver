nn0510/status/1913109721189663061\n\n初めまして。うちのライトノベルヒロインの集合絵（横長）を描いてください。\nシチュエーション：楽しそうに同じ方向を向いて歩いている絵でお願いします。通学中というシチュエーションです。\n\n服装：全員春物の学生服ですが、小学生の金髪ツインテの子とおさげの子はランドセルを背負わせて、春物の私服を着せてください。デザインはおまかせします。\n\n細かな部分\n丸眼鏡の子と半分ピンクのギャルと茶髪のリボンの女の子は三人で組んでいます。\n眼鏡の子以外はそれぞれカップルです。\n\n身長は狐の子が１７０弱、半分ピンクギャルが１６５、リボンの子が１６０、狸の子１５４、眼鏡の子１５２、金髪の子とおさげの子が１４０センチくらいです。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uynuynu/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f36bb387/uploads/origins/f0d28d75-1629-42b9-a2b6-81e1177352bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=268661d32f6bd82001104d0bf492b528", "srcset": "https://si.imgix.net/f36bb387/uploads/origins/f0d28d75-1629-42b9-a2b6-81e1177352bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=268661d32f6bd82001104d0bf492b528, https://si.imgix.net/f36bb387/uploads/origins/f0d28d75-1629-42b9-a2b6-81e1177352bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01a524d0a15c3d90732c7fcd1f80e7ff 2x, https://si.imgix.net/f36bb387/uploads/origins/f0d28d75-1629-42b9-a2b6-81e1177352bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e01776943e4eaece5649b4326415fd3 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1393297, "client_id": 1803770, "nc": 145}, {"path": "/@uynuynu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1393297, "client_id": 3612850, "vtt_url": null, "thumbnail_image_urls": {"src": "