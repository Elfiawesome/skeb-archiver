mage", "creator_acceptable_same_genre": true}, {"path": "/@Kotobuki_HAKU/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1506547, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/270f6af8/uploads/origins/7da4d07f-198e-405e-bb2b-f8e566c9b270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=542043ad83f7185bdeed21df4f0f986c", "srcset": "https://si.imgix.net/270f6af8/uploads/origins/7da4d07f-198e-405e-bb2b-f8e566c9b270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=542043ad83f7185bdeed21df4f0f986c, https://si.imgix.net/270f6af8/uploads/origins/7da4d07f-198e-405e-bb2b-f8e566c9b270?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b323faba5277910f0107fc688155b568 2x, https://si.imgix.net/270f6af8/uploads/origins/7da4d07f-198e-405e-bb2b-f8e566c9b270?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce40a36377dfb298af8f38932934a960 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/270f6af8/uploads/origins/7da4d07f-198e-405e-bb2b-f8e566c9b270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48b68570f003bbef69529669486e9fb0", "srcset": "https://si.imgix.net/270f6af8/uploads/origins/7da4d07f-198e-405e-bb2b-f8e566c9b270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48b68570f003bbef69529669486e9fb0, https://si.imgix.net/270f6af8/uploads/origins/7da4d07f-198e-405e-bb2b-f8e566c9b270?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ba23e272caf94ddfc838ba4efb60c5eb 2x, https://si.imgix.net/270f6af8/uploads/origins/7da4d07f-198e-405e-bb2b-f8e566c9b270?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8fc83d74255680903efa882f4c2a6d2d 3x"}, "body": "琴吹さんはじめまして！ \n琴吹さんのイラストがとても気に入ったので、リクエストをお願いすることにしました。 \n今回描いていただきたいのは、 私立花ケ丘秘密倶楽部HO8をお願いします。\nイラストがとても素敵でをお願いしたいです   \n\nHO8：芒に月\n\n水鏡 烟月（すいきょう えんげつ）\n男/17歳/190㎝\n\n□一人称/二人称/三人称\n俺/あんた・お前・呼び捨て/あんた達・お前たち\n\n□性格\n明るく社交的、素直で感情表現が豊か。負けず嫌い。人懐っこくて明るいムードメーカー。でも、内面は誰よりも熱く、努力を惜しまない負けず嫌い。\n\n□趣味・特技\n趣味：ランニング\n特技：なんかあるかな\n\n□好き/嫌い\n好き：甘いもの。特に和菓子\n嫌い：特にないっすね\n\n□カラーコード\nダフォディル　#FFC752\n\n\n「四方谷高校オカルト部兼空手の水鏡 烟月」\n「俺のことは水鏡でも烟月でもえんでもげっちゅーでもなんでも読んでください」\n「オカルトは別にそこまで興味ないですが…なんとなく入りました」\n「知っているオカルトは、こっくりさんとかの学校七不思議っすねえ」\n\n□概要\n水鏡家はボディーガードや護衛を仕事としており、幼い頃から武道をやらされており、空手部に入る予定だったのが先輩たちに誘われてオカルト部に兼部している。あまり、オカルトを信じていない。幽霊なんて迷信であると思っている。\n\n\n□その他\n空手部に所属している\n両利き\nちゃらい分類\n\n水鏡 烟月(すいきょう えんげつ) - いあきゃら\nhttps://iachara.com/view/12004688\n\n【シチュエーション】\nメル画でお世話になりました。その際にげっちゅーの名シーンだなって思うところを描いて欲しいです。\n\n【使用用途】  \n・オンラインセッションでの個人使用 （配信などは行いません）  \n・個人使用範囲内でSNSのヘッダー、アイコン使用  \n・文字無しをいただけると助かります  \n\n金額不足や資料不足等ありましたらお気軽に再送して頂けますと幸いです！お読み頂きましてありがとうございます。よろしくお願いします！ \n\nhttps://www.dropbox.com/scl/fo/kmwubalfx40fq8y65n830/AENnXNWF4AmiesmyrxFr95U?rlkey=3h0v4g1uj8xeyhsjkbcsp6zml&st=h84bwpyl&dl=0\n\nhttps://www.dropbox.com/scl/fo/kmwubalfx40fq8y65n830/AENnXNWF4AmiesmyrxFr95U?rlkey=3h0v4g1uj8xeyhsjkbcsp6zml&st=h84bwpyl&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kotobuki_HAKU/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1506547, "client_id": 90411, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0fedc44/uploads/origins/67f390ed-4bb6-4f1c-92e5-be620951bc6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1ca17e7c7e8b69c8b85915bbf818d3c", "srcset": "https://si.imgix.net/c0fedc44/uploads/origins/67f390ed-4bb6-4f1c-92e5-be620951bc6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1ca17e7c7e8b69c8b85915bbf818d3c, https://si.imgix.net/c0fedc44/uploads/origins/67f390ed-4bb6-4f1c-92e5-be620951bc6b?bg=%23fff&auto=format%2Ccompress&f