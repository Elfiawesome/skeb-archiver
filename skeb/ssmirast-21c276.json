f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=388e88bdb1de0afc16ca55838e8cef15, https://si.imgix.net/a2c14cd7/uploads/origins/244d79f0-3a10-4f21-a69e-ccf253aee962?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8acf1f724b783a4ef3c21dddab57bc83 2x, https://si.imgix.net/a2c14cd7/uploads/origins/244d79f0-3a10-4f21-a69e-ccf253aee962?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d87cb17cf90c98418e7db92f44acee53 3x"}, "body": "こんにちは！あなたのアートが大好きです！\nあなたのレンダリングスタイルが大好きです。\nhttps://x.com/ssmirast/status/1665334476933611520\nhttps://x.com/ssmirast/status/1738894062848262634\n\nBNHAのBKと私のOCのどちらかを描いてください。\n彼女はBKの友達の一人です！\nOCはBKのうるさい性格を気にしていません。\n\n私のOCは自然をコントロールできる蝶の妖精です。\n彼女のユニークな外見に注目してください。\nもしOC2が選ばれたら、彼女の羽もお願いします。\nヴェラは穏やかで明るく、とても冒険好きです。\nアレフはヴェラの分身です。\n彼女はもっと大胆不敵で自信家です。\n衣装は、フォルダFにある衣装のどれかを使ってください。\nそうでない場合は、オリジナルの衣装やUAのユニフォームを自由に着せてください。\n\n好きなように描いてください！\n交流しているところを描いてください。\n目を開けた状態で描いてください。\n背景はあった方がいいですが、なければシンプルなものでも構いません！\n\n念のため、先生のアイデアもご紹介しておきます：\n- BKがレアなサイン入り \"オールマイト \"カードを手に入れ、OCが喜んでいる。\n- タッグバトル\n\n非表示にしたい場合は、自由にアピールしてください！\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/19gE7z0E6LgRgFGIFo8Q2wjKhDN2q1Cxj?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ssmirast/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2597696, "client_id": 2449461, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1cf9811/uploads/origins/a28921c7-e027-4e22-ba5b-02b18843114d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0aa9450821a9736e6f5ca65308f88c9f", "srcset": "https://si.imgix.net/a1cf9811/uploads/origins/a28921c7-e027-4e22-ba5b-02b18843114d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0aa9450821a9736e6f5ca65308f88c9f, https://si.imgix.net/a1cf9811/uploads/origins/a28921c7-e027-4e22-ba5b-02b18843114d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1249631af0167ac38610f6e5034db797 2x, https://si.imgix.net/a1cf9811/uploads/origins/a28921c7-e027-4e22-ba5b-02b18843114d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f88f438c078e257f5a540ce838893d42 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1cf9811/uploads/origins/a28921c7-e027-4e22-ba5b-02b18843114d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d1a6094acb82fa498dc2fda1a7d407e", "srcset": "https://si.imgix.net/a1cf9811/uploads/origins/a28921c7-e027-4e22-ba5b-02b18843114d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d1a6094acb82fa498dc2fda1a7d407e, https://si.imgix.net/a1cf9811/uploads/origins/a28921c7-e027-4e22-ba5b-02b18843114d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a1f224fdcad3b4460a6efad1516c88cf 2x, https://si.imgix.net/a1cf9811/uploads/origins/a28921c7-e027-4e22-ba5b-02b18843114d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=905d88764b6ec410859cffc79753284b 3x"}, "body": "初めまして。\nShin先生のSkebを拝見させていただきました。\n背景も人物も綺麗で美しく、とても好きなイラストが多くて大好きです。\n\n今回は私のOCである個人VTuberの忍野クシナちゃんのイラストを作成をお願いしたく依頼させていただきました。\n\n{デザインにつきまして}\n・クシナちゃんはヒロアカの爆豪勝己がとても大好きで、2人で戦っている、もしくはクシナちゃんがヒーローコスの爆豪にデレデレで抱きついているツーショットを描いていただきたいです。\n彼女は忍者なので忍者っぽい武器(クナイや手裏剣など)であれば幸いです。可能な範囲で問題ございません！\n\n・クシナちゃんは、ふくらはぎもしくは太ももまでフルカラーで描画していただければ幸いです。\n\n・クシナちゃんの表情はお任せしますが、目が開いてると幸いです。\n\n・背景は外で戦闘している、もしくはデザイン風でも構いません、その際忍者っぽい小物(クナイや巻物など)また、彼女が好きなカボチャの天ぷらや玉ねぎなどどこかにあれば喜んでくれると思います。\n可能な範囲で問題ございません。\n\n・頭の大きいリボンは固定でお願いいたします。また、リボン両側に黒いライン模様があります。\n\n・納品サイズは本人のサムネの作成の際にトリミングする可能性もあります。イラストサイズは縦横お任せしますが350dpi以上でお願い致します。\n\n｛使用用途につきまして｝\n・ツイキャスなどサムネ等、動画のイラスト使用、グッズの販売、YouTubeの動画などに使用したいイラストの許可をいただきたいです。\n\n（グッズ販売の際はShin先生のお名前を記載して販売する様お伝えします。私ではなくプレゼント相手ご本人の販売となります。その際、爆豪のイラストは使用しないようにお伝え致します。)\n（例:YouTubeメンバー会員向け壁紙配布、サムネ、X等の画像に使用、YouTubeの動画の使用、歌ってみたのイラスト使用、背景や人物を配信への使用、BOOTHでのグッズ販売(缶バッジetc)\n\n｛備考です｝\nレイヤーを人物・背景が別れた透過版のPSDファイルでいただきたいです。\n先生のサイン有り・サイン無しの差分をいただけると嬉しいです。\n\nご注文が多くなってしまい大変申し訳ございませんが楽しみにしております！\nよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fi/ctlw35dm1kxfhj7mex0fz/Shin.jpeg?rlkey=l5ja7t4icpsmr0fqscm2h8e2v&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2610607, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "蓮/はす", "screen_name": "hasunohato_", "avatar_url": "https://pbs.twimg.com/profile_images/1799474768032444416/Pu61EYxF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1418359247708901376/1777554569/1500x500", "appeal_receivable": false, "popular_creator_rank": 71, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 50, "skills": [{"genre": "art"}, {"genre": "music"}], "nc": 16}, {"id": 3024076, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "お花", "screen_name": "_Ohana_0606", "avatar_url": "https://pbs.twimg.com/profile_images/1842946063122231296/5ODHsLgZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1710611973048860672/1707407380/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 145}, {"id": 3069112, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "うすしお", "screen_name": "usu_poke", "avatar_url": "https://pbs.twimg.com/profile_images/1816814406698942464/lWZui4TH.jpg", "header_url": "https://pbs.twimg.com/profile_ba