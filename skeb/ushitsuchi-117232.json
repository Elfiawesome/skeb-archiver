323/uploads/origins/ad32fda8-2435-423a-b358-cc4e41d8d791?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ac48713490db8f74c8703643095255d2 3x"}, "body": "はじめまして。東方イラストのキャラクターと背景の調和された美しさに一目惚れし、ご連絡させていただきました。\n\n準備中のVアバターがあるのですが、可能であればそのオリジナルキャラクターのイラストを描いていただきたく思っております。\n\n・キャラクター詳細\n年齢不詳のオオカミの女の子です（数百歳）。\n好奇心が強く、天真爛漫な明るい性格です。\n旅が好きで、ひとりで自然を感じるのが好きです。\n様々な場所を渡り歩きつつ、人間に紛れてひっそりと暮らしています。\nイメージカラーは黄色、イメージ花はミモザや金木犀です。\n眉を下げて優しく笑います。\n（画像は資料URLに添付させていただきます）\n\n・使用用途\n基本的には個人観賞用として考えております。\n今後、キャラクターを使用した旅動画の投稿を考えており\nYoutube動画での使用（サムネイル等）\nSNSへの掲載（ヘッダー等）\nの可能性がございます。\nその際はお名前やリンクを掲載させていただきます。\n\n構図やシチュエーションはお任せいたします。\n衣装が現代的ですので、アレンジいただいても構いません。\n\nご縁がありましたら、何卒よろしくお願いいたします。\n\nhttps://1drv.ms/i/s!Aj15RjhRYMTx1WwO9348dj9AtUHJ?e=uHcO7g%0A", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ushitsuchi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2734193, "client_id": 988807, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c228f71/uploads/origins/943ce59f-94c6-4411-aea1-f046ad6d4945?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99e2458fc924b87dbf386990f7fdbda7", "srcset": "https://si.imgix.net/6c228f71/uploads/origins/943ce59f-94c6-4411-aea1-f046ad6d4945?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99e2458fc924b87dbf386990f7fdbda7, https://si.imgix.net/6c228f71/uploads/origins/943ce59f-94c6-4411-aea1-f046ad6d4945?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20aaf85acd30518974584dc90d3f3cdf 2x, https://si.imgix.net/6c228f71/uploads/origins/943ce59f-94c6-4411-aea1-f046ad6d4945?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6678049d2ba65f3111495b518504fe3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c228f71/uploads/origins/943ce59f-94c6-4411-aea1-f046ad6d4945?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6474b733fb5285c36e9b95d9a807befb", "srcset": "https://si.imgix.net/6c228f71/uploads/origins/943ce59f-94c6-4411-aea1-f046ad6d4945?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6474b733fb5285c36e9b95d9a807befb, https://si.imgix.net/6c228f71/uploads/origins/943ce59f-94c6-4411-aea1-f046ad6d4945?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ddc587c0200669ec09886d5f7a333656 2x, https://si.imgix.net/6c228f71/uploads/origins/943ce59f-94c6-4411-aea1-f046ad6d4945?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dc8a29fc10c9bdb4c27ae77806d374d2 3x"}, "body": "こんにちは！私はあなたの絵がとても好きです。色使いと照明がとてもきれいです。私はあなたの作品の風景や筆のストロークが好きです。画風はとても天才的だと思う！私の好きなイラストは、水と青空と強い光のあるものです。とても美しい私のキャラクター、Yoyoがビーチを飛び回っているイラストが欲しいです。たぶん彼女は海の岩の近くにいて、そこから青い空と水が見えると思う。ヨーヨーはセミで、羽が透明なので、あなたの画風だときれいに見えると思います。東方Projectの作品が好きなんですが、スカートをはいたキャラクターが多くて、それをきれいに描いていますよね。ヨヨもスカートで描いてほしいです。長くても短くても、風になびけば何でもいいです！\n\nとにかく何でも自由に描いてください。きっと素敵に仕上がると思います。このリクエストを楽しんでください！\nhttps://ockimberkcally.carrd.co/#yoyo", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ushitsuchi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2734193, "client_id": 375679, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f68771a/uploads/origins/b3d65e32-069b-452d-a827-be904f87fa6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17cee3997814276ed388d3de1a562053", "srcset": "https://si.imgix.net/6f68771a/uploads/origins/b3d65e32-069b-452d-a827-be904f87fa6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17cee3997814276ed388d3de1a562053, https://si.imgix.net/6f68771a/uploads/origins/b3d65e32-069b-452d-a827-be904f87fa6