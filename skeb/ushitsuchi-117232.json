2&fit=crop&crop=top&w=200&h=200&s=3f913667d26b28be4fda8efa6409c005 2x, https://si.imgix.net/4d26aa66/uploads/origins/d8e9c906-1b62-460f-bb24-c4b24cc63ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9269bcccba928bdac436aabfdc34d0ae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d26aa66/uploads/origins/d8e9c906-1b62-460f-bb24-c4b24cc63ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28f5e06d3b9d202950464c6e7888168f", "srcset": "https://si.imgix.net/4d26aa66/uploads/origins/d8e9c906-1b62-460f-bb24-c4b24cc63ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28f5e06d3b9d202950464c6e7888168f, https://si.imgix.net/4d26aa66/uploads/origins/d8e9c906-1b62-460f-bb24-c4b24cc63ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bad64c2dd7638aaee46160b7e9dbaccb 2x, https://si.imgix.net/4d26aa66/uploads/origins/d8e9c906-1b62-460f-bb24-c4b24cc63ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f3b2c35d011ff637b8eda452a943feef 3x"}, "body": "お疲れさまです。\n以下の内容でリクエストをさせていただきます。\n\n■要望\n・作品：東方Project\n・キャラ：吉弔八千慧、射命丸文\n・シチュエーション：要望なし\n・キャラ個性や関係性：要望なし\n\n■依頼目的\n・私事ながら上記二人をメインに据えた同人誌を描いているのですが、\n　「この二人がでている絵がもっとみたいな～」という欲に駆られたので依頼させていただきます\n\n■補足\n・ご自身が「良い！」と思えるようご自由に表現いただければと思います\n・金額面での不足の場合や懸念事項がある場合はお手数ですが再送要請をお願いいたします\n\nご検討いただき、承諾いただければ幸いです。\nよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ushitsuchi/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2734193, "client_id": 64235, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/074e9177/uploads/origins/ee53e7f5-d338-4435-b981-ef878c66575b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d58b7c7fd34c1a266014d246245975ff", "srcset": "https://si.imgix.net/074e9177/uploads/origins/ee53e7f5-d338-4435-b981-ef878c66575b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d58b7c7fd34c1a266014d246245975ff, https://si.imgix.net/074e9177/uploads/origins/ee53e7f5-d338-4435-b981-ef878c66575b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8bc4cb2edda45d45743443d4738e80bc 2x, https://si.imgix.net/074e9177/uploads/origins/ee53e7f5-d338-4435-b981-ef878c66575b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22078da5a089883a01c041534f1e985f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/074e9177/uploads/origins/ee53e7f5-d338-4435-b981-ef878c66575b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19ee9eba52ff2c968aa76635bd51070a", "srcset": "https://si.imgix.net/074e9177/uploads/origins/ee53e7f5-d338-4435-b981-ef878c66575b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19ee9eba52ff2c968aa76635bd51070a, https://si.imgix.net/074e9177/uploads/origins/ee53e7f5-d338-4435-b981-ef878c66575b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=19de529ea3c00bd960b2f6f46e9cfac8 2x, https://si.imgix.net/074e9177/uploads/origins/ee53e7f5-d338-4435-b981-ef878c66575b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c8b93d9c80613cea4700f34627b88552 3x"}, "body": "はじめまして。\n以前より牛土様のとても素敵なイラストを拝見しており、是非私の好きなキャラクターを描いていただけないかと思い、リクエストを送らせていただきました。\n共同創作のキャラクターであり、お相手のキャラクターの作者様にも許可を頂いております。\n\n終末系の世界観を旅する二人組です。生物兵器兼護衛兼犬の灰髪の男と、世界の救済を命じられた黒髪の男です。\n世界観としては、現代＋数百年の時が経っていますが、現代のような文明社会はほぼ衰退しており人口数も激減しています。そんな中人類は、溢れる自然の中で、穏やかに、それでいて精一杯に暮らしています。\n\n▧　灰髪の男\n　黒髪の男についている護衛のような人です。無表情ですが、無感情・無感動というわけではまったくなく、様々なものに前向きな好奇心や興味を抱いています。学問の知識が殆どないため無自覚なことも多いですが、根本的には非常に豊かな感性の持ち主です。\n　凄まじい戦闘力を有しており、ワンマンアーミーな感じの強さです。近接戦闘を主としています。\n\n▧　黒髪の男\n　医者のような薬剤師のような、そんな感じの職業の人です。誰に対しても情け容赦のない態度で接し、良くも悪くも素直で恬淡としています。無神経・無遠慮に見えてどこか物堅く、責務は義理堅く遂行します。言動はがさつで、物凄く口が悪いです。\n　決して優しいわけではないが、根が善良で、困っている人を見るとなんの感情もなく助けます。\n\n牛土様の描かれる背景が本当に素敵で大好きなので、是非背景メインのイラストを描いていただきたいです。山や水、空の空気感が特に好きなのに加え、自然の中を旅するキャラクターたちなので、そういった風景を描いていただけると本当にうれしいです。\n\n送信した金額的に問題があるようでしたら、お手数ですが再送をお願いします！\n待ち受け画像や個人観賞用に使用をしたいため、差し支えなければサインを別レイヤに分けて頂けると嬉しいです。よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1zY8mXZAkAmSm3197_PUY2mldrwauI5Ms?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ushitsuchi/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9c9d5ed1/uploads/origins/f0b21642-9927-444b-a909-57548e8dcacb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd51586841f81a08d785f6fee7900d96", "srcset": "https://si.imgix.net/9c9d5ed1/uploads/origins/f0b21642-9927-444b-a909-57548e8dcacb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd51586841f81a08d785f6fee7900d96, https://si.imgix.net/9c9d5ed1/uploads/origins/f0b21642-9927-444b-a909-57548e8dcacb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d4e2088b519cfa152b1155e37b1cda0 2x, https://si.imgix.net/9c9d5ed1/uploads/origins/f0b21642-9927-444b-a909-57548e8dcacb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7762daa79d5c506012a8887081da4fe8 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2734193, "client_id": 3146457, "nc": 17}, {"path": "/@ushitsuchi/works/6", "private_thumbnail_image_urls": null,