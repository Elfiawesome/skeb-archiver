ていただきます。\n\nアズールレーンより、「信濃」のイラストをリクエストさせていただきます\n今回は「女子高生風の信濃」をテーマに、ギャルピースをしている姿を描いていただきたいです\n衣装や髪型のアレンジ、表情、ポーズ、構図、背景などはすべてお任せいたします。\n普段の信濃とは少し違った、明るく今風な雰囲気の彼女を見てみたいと思っています(できれば少し恥ずかしそうな感じで)\n眼鏡などの小物の有無もおまかせします。\n\n先生の自由な発想で描いていただければ嬉しいです！\n\nどうぞよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@super_aaa6/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4137843, "client_id": 431262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/967a58ff/uploads/origins/d1cb42ee-2581-48aa-b334-397a13eaf18c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3339985c6a5e963ffe68fc8b9963af09", "srcset": "https://si.imgix.net/967a58ff/uploads/origins/d1cb42ee-2581-48aa-b334-397a13eaf18c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3339985c6a5e963ffe68fc8b9963af09, https://si.imgix.net/967a58ff/uploads/origins/d1cb42ee-2581-48aa-b334-397a13eaf18c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c439080cc4f21382e2eb401e4897480 2x, https://si.imgix.net/967a58ff/uploads/origins/d1cb42ee-2581-48aa-b334-397a13eaf18c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=501602e52f1f411c153ac482a99efb04 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/967a58ff/uploads/origins/d1cb42ee-2581-48aa-b334-397a13eaf18c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebb5496967fba7997170d5edad2cd824", "srcset": "https://si.imgix.net/967a58ff/uploads/origins/d1cb42ee-2581-48aa-b334-397a13eaf18c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebb5496967fba7997170d5edad2cd824, https://si.imgix.net/967a58ff/uploads/origins/d1cb42ee-2581-48aa-b334-397a13eaf18c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c3dcba001ace2a9a4145b5f1a993ec14 2x, https://si.imgix.net/967a58ff/uploads/origins/d1cb42ee-2581-48aa-b334-397a13eaf18c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a89cb86135d65a8d349d262c4d653c14 3x"}, "body": "初めまして。\n\nお見かけしたイラストに惹かれましたのでよろしければリクエストさせて下さい。\n \nうちの子イラストをお願いしたいです。\n\n  キャラの容姿、服装等は下記資料用URLから確認お願いします。   \n\n服装について、以下の点をお願いしたいです。  \n\n・左胸にほくろがありますので注意お願いします。\n ・スーツやソックスの黒い部分は光沢強めにお願いします。\n・局部描写は不要です。\n・体型等、資料の様にむっちりとさせて下さい。\n\n表情は過去リクエストの様な微笑でお願いします。\n\nポーズ、構図については、ポーズイメージの資料のポーズで、口に電子タバコを咥えてる構図でお願いしたいです。 \n\nその他資料で分からない部分に関してはお任せします。\n\n以上、よろしければ検討お願いします。\n\nhttps://drive.google.com/drive/folders/1v1PUKVrQSasFUIZRMPJ0zeZAEs-mlpWx", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@super_aaa6/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4137843, "client_id": 4112639, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/141ec19a/uploads/origins/583b9c00-0b60-4c46-af6c-717fd0ba26fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8771e9d92967d1ef6346aa8a4a402aaf", "srcset": "https://si.imgix.net/141ec19a/uploads/origins/583b9c00-0b60-4c46-af6c-717fd0ba26fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8771e9d92967d1ef6346aa8a4a402aaf, https://si.imgix.net/141ec19a/uploads/origins/583b9c00-0b60-4c46-af6c-717fd0ba26fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b998b75640f01b29f1c6369fed40f462 2x, https://si.imgix.net/141ec19a/uploads/origins/583b9c00-0b60-4c46-af6c-717fd0ba26fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=472b9489af59a860a0cf42c4f8de892b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/141ec19a/uploads/origins/583b9c00-0b60-4c46-af6c