n・年齢の設定は18才です\n\n・トレーニング後という設定なので汗びっしょりだと嬉しいです\n\n説明が下手で申し訳ありませんが、以上のシチュエーションでよろしくお願いします。\n\nキャラの髪型や服装等の詳細及びデッサンアプリによるざっくりとしたポージングのイメージ図(画角含む)は以下のURLに添付しています。\nご査収ください。\nアプリの仕様上、体勢に無理があったり依頼文と齟齬があると思いますが、依頼文のシチュエーションの方を優先でお願いします。\n\nイラスト資料\nhttps://ibb.co/bjjNSMMY\nhttps://ibb.co/fd3XX0QZ\nhttps://ibb.co/dsgSg03H\nhttps://ibb.co/hRV3BFWF\nhttps://ibb.co/Y4Q43RYF", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 484299, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "たかむら", "screen_name": "ramuneman", "avatar_url": "https://pbs.twimg.com/profile_images/1609531865073090563/CeMbpr9e.jpg", "header_url": "https://pbs.twimg.com/profile_banners/543975420/1767868862/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 49}, {"id": 3365183, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "焼きもろこし", "screen_name": "yakimoro555", "avatar_url": "https://pbs.twimg.com/profile_images/1996916016576901120/UuEqas6i.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1766417969595514880/1724940741/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 16}, {"id": 3535216, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "梨の", "screen_name": "NonoPear_", "avatar_url": "https://pbs.twimg.com/profile_images/1713398359439106048/1w62tP4E.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1661331290359238658/1774627879/15