9f-70938e256dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d173564dc00ecb721abd5a4cf1ffa67", "src_set": ""}, "body": "お世話になっております！\n前回のリクエストでは素敵なイラストをありがとうございました。\n\n今回はむちむち全身のイラストのリクエストです！\n\n髪型、装飾等も全ておまかせでお願い致します。\n\n【納品形式】\n\n･PNGまたはPSD形式でお願い致します。\n\n【使用用途】\n\n･SNSの投稿\n･サムネイル\n･デジタル･リアルグッズの返礼品\n･アイコン(IRIAM、Discord)\n･YouTubeでの動画内での使用\n\nご検討のほどよろしくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mii_nyanko96/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3587433, "client_id": 2098855, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5dd784c5/uploads/origins/2a1b9795-3f0c-47ed-924f-6c8091b779c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbd7e8153baa630eb7a5c734def8eea9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5dd784c5/uploads/origins/2a1b9795-3f0c-47ed-924f-6c8091b779c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3404b19211afbdffd12fc37fe6e2198a", "src_set": ""}, "body": "meal様\nお世話になっております、個人Vtuberのねこ もみじです。\n前回はとても素敵で可愛いイラストを描いていただきありがとうございました！\nXにてむちむちイラストの受付をお見掛けしたのでリクエストを送らせていただきました。\n\n【依頼内容】\n可能ならでいいのですが魔女の帽子を被せていただけると嬉しいです。\n表情は下記URLの２枚目の女の子のようにお茶目なウィンクをした感じにして頂けると嬉しいですが予算内で難しければお好きなように描いていただいて大丈夫です！\nhttps://x.com/Meal_illust/status/1967505422040150333\n\n【使用用途】\n・YouTube等のサムネイル使用\n・各SNS等での宣伝使用\n\n【納品形式】\nサムネイルで使うため頭部や髪の毛等は切れないようお願いいたします。\n背景や宛名を描いて頂けるのでしたら人物レイヤーを分けたPSDまたはPNGで納品して頂ければ幸いです。\n背景透過があるととてもありがたいです。\n\n【参考】\n・https://twitter.com/aneko_nekoneko/status/1682998951581196288\n・https://drive.google.com/drive/folders/1H-bn-5T9YhDHlyL3e2QSB617XHW2yCxU?usp=sharing\n\n【特徴】\n・口元左下にホクロ\n・紫がかった銀髪\n\nお忙しいところ恐れ入りますがご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1H-bn-5T9YhDHlyL3e2QSB617XHW2yCxU?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mii_nyanko96/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3587433, "client_id": 3318910, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f480b6b/uploads/origins/54f62166-59d7-4646-b701-11d119e97829?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6af69b7a02aeb8bb9607e419df4eec77", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f480b6b/uploads/origins/54f62166-59d7-4646-b701-11d119e97829?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32c015bb6a6878c2cab704263bc33802", "src_set": ""}, "body": "はじめまして、IRIAMという配信アプリで活動しております。子乃星こぼね(ねのほしこぼね)と申します。\n\n𝒎𝒆𝒂𝒍🎀様のポップなカラーで可愛いお洋服を着たイラストを拝見し、𝒎𝒆𝒂𝒍🎀様に描いていただきたくリクエストさせていただきました。\n\n【イラスト詳細】\n\n･夏のファッションコーデを着た姿。\n髪型はコーデに合わせて変更していただいて問題ございません！\n\n･ポーズ、背景はおまかせでお願いしたく存じます。\n\n【納品形式】\n\n･PNGまたはPSD形式でお願い致します。\n\n【使用用途】\n\n･SNSの投稿\n･サムネイル\n･デジタル返礼品\n･アイコン(IRIAM、Discord)\n\nご検討のほどよろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mii_nyanko96/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3587433, "client_id": 2098855, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c609ecf3/uploads/origins/7a1c6d8d-9897-47ba-abd0-2b384e5e4f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6b4944b4fe441453dc0229ad4497e55", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c609ecf3/uploads/origins/7a1c6d8d-9897-47ba-abd0-2b384e5e4f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd2cf5e566deee986d0b96c7f4f6dae5", "src_set": ""}, "body": "𝒎𝒆𝒂𝒍様\n\n初めまして、YouTubeで活動している個人Vtuberのねこ もみじと申します。\nTwitterにてmeal様のとても可愛いイラストを拝見し、ぜひ私ねこもみじを描いていただきたいと思いリクエストを送らせていただきました！\n\n【依頼内容】\n構図などはお任せいたします。\n予算内で可能でしたら夏っぽい雰囲気で描いていただければ幸いです。\n衣装などは簡略化またはアレンジしていただいて大丈夫です。\n\n【使用用途】\n・YouTube等の動画配信のサムネイル\n・各SNS等での宣伝\n\n【納品形式】\nサムネイルで使うため頭部や髪の毛等は切れないようお願いいたします。\n背景や宛名を描いて頂けるのでしたら人物レイヤーを分けたPSDまたはPNGで納品頂ければ幸いです。\n背景透過があるととてもありがたいです。\n\n【参考資料】\nお手数ですが下記のURLから確認をお願いいたします。\n・https://twitter.com/aneko_nekoneko/status/1682998951581196288\n・https://drive.google.com/drive/folders/1H-bn-5T9YhDHlyL3e2QSB617XHW2yCxU?usp=sharing\n\n【特徴】\n・口元左下にホクロ\n・紫がかった銀髪\nねこもみじは3匹の猫と暮らす映画が大好きな魔女で皆と楽しく映画を観るのが何よりも好きなVtuberです。\n\nお忙しいとは存じますがご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1H-bn-5T9YhDHlyL3e2QSB617XHW2yCxU?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mii_nyanko96/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3587433, "client_id": 3529393, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/05023893/uploads/origins/c9e4095a-14e5-497e-b4bc-23c7ebf3bae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ccedcc4112c369cbc34343dee10da3f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/05023893/uploads/origins/c9e4095a-14e5-497e-b4bc-23c7ebf3bae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ad8d8462d8bcd2ee3990925e9a3d2a2", "src_set": ""}, "body": "はじめまして！アピールありがとうございます！\n私のオリジナルキャラクターのレモンちゃんを描いていただきたいです。\nレモンちゃんは食べることが大好きな子です！\n苦手な食べ物は無く、なんでも食べます！\n\nポーズや構図はお任せします。\nまた、服装も似合うものであればアレンジしていただいても大丈夫です。(もちろんそのままでも大丈夫です！)\n\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1yu2TDl1Euxs3frIHLRnr_72IJSU9JpDe", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mii_nyanko96/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3587433, "client_id": 977190, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f5839eda/uploads/origins/5c9731e5-dca8-4393-959e-cf71a12a45ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=554572067d97cafcb28bbea2eb21c548", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5839eda/uploads/origins/5c9731e5-dca8-4393-959e-cf71a12a45ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a78f6901d97b5c4629d37cda42795f1", "src_set": ""}, "body": "𝒎𝒆𝒂𝒍🎀様 初めまして。\nあなたの描くイラストの可愛さに惹かれこの度依頼させていただきました  \n\n描いていただきたいのは、Vtuber活動を行っているぴーこ🐹☁️さんをお願いしたく思います。  \n\n構図・内容は全てお任せいたします。\n\n髪型は三つ編またはショートのどちらでも構いません。ですが帽子は三つ編みなら有り、ショートなら無しでお願いします。   \n\n①ぴーこさんの活動で使用する可能性があります （Twitterの投稿やYoutubeのサムネ、その他非営利目的で使用します）\n ②PSD形式で、背景・キャラ・サインの3点を分けていただけると嬉しいです。\n\n【資料】\n\nhttps://x.com/pikochaso_suko/status/1864274106960760837?s=46&t=r0PoIBfSbWrH5qyD9ay_Pg\n\nご検討頂けますと幸いです。よろしくお願いします\n\nhttps://x.com/pikochaso_suko/status/1864274106960760837?s=46&t=r0PoIBfSbWrH5qyD9ay_Pg", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 1184415, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あざらし太郎", "screen_name": "azatarou_h", "avatar_url": "https://pbs.twimg.com/profile_images/1717793820426039296/g5TWM8Ph.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1278682253166391299/1651937046/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 49}, {"id": 2591391, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "カゴヤマ：5頭身以下の依頼専用", "scr