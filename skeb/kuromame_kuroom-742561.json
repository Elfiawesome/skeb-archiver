\n\n【依頼構図】\n▼参考資料添付\nこちらの子のバレンタインイラストを依頼したく思います。\nイメージしているものを３つ資料として添付します\n「バレンタインってこれでいいんだよね？あってるよね？」という疑心暗鬼な部分と、\n「別に照れてなんてないようなふりをしてるけど、内心はドキドキ」みたいな強がりな部分がうちの子の心情といった感じです。\n\n【依頼詳細】\n・時間帯は居室から人がいなくなる夕～夜\n・服装は「うちの子①」のような服装。仕事終わりのイメージ。\n・場所は刑事の居室。こちらも参考資料を２つほど添付しますが、背景はそこまで細かくなくて大丈夫です。\n\n使用用途は観賞用です、サイズ等もおまかせします！\nよろしくお願いします！！\n\nhttps://drive.google.com/drive/folders/16Er05H0P2hUPOwAPUdPqKxyNHSSjkj-_?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kuromame_kuroom/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3417257, "client_id": 3231932, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d5601da/uploads/origins/a34fd035-ef9f-418b-8c71-b77ecd904b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef2333982d5057dd57f06873b0f37e9d", "srcset": "https://si.imgix.net/4d5601da/uploads/origins/a34fd035-ef9f-418b-8c71-b77ecd904b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef2333982d5057dd57f06873b0f37e9d, https://si.imgix.net/4d5601da/uploads/origins/a34fd035-ef9f-418b-8c71-b77ecd904b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bc767795b92b3805c4d9b789feb7d34 2x, https://si.imgix.net/4d5601da/uploads/origins/a34fd035-ef9f-418b-8c71-b77ecd904b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44d649544ae5f0609ae2c6b39a631cd9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d5601da/uploads/origins/a34fd035-ef9f-418b-8c71-b77ecd904b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59a57ac5edbb1bdf385972b622195c4b", "srcset": "https://si.imgix.net/4d5601da/uploads/origins/a34fd035-ef9f-418b-8c71-b77ecd904b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59a5