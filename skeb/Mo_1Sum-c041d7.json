ompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f3a400e517d73ff5081e3cd697c47e4, https://si.imgix.net/c41f8a12/uploads/origins/79b2f1cc-5ac8-4f63-9b71-3d7e3857288c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11f2e2f476169adf734671688f22504d 2x, https://si.imgix.net/c41f8a12/uploads/origins/79b2f1cc-5ac8-4f63-9b71-3d7e3857288c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63687ced40570f16fa67f90bbae79503 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c41f8a12/uploads/origins/79b2f1cc-5ac8-4f63-9b71-3d7e3857288c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e84ba6c09d6acdb3991787f00e50247c", "srcset": "https://si.imgix.net/c41f8a12/uploads/origins/79b2f1cc-5ac8-4f63-9b71-3d7e3857288c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e84ba6c09d6acdb3991787f00e50247c, https://si.imgix.net/c41f8a12/uploads/origins/79b2f1cc-5ac8-4f63-9b71-3d7e3857288c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1378937c3a725dec37553c28d8b0b429 2x, https://si.imgix.net/c41f8a12/uploads/origins/79b2f1cc-5ac8-4f63-9b71-3d7e3857288c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7b2f2a0ade158868728decf8bd21f108 3x"}, "body": "レンゾクです！\nもうすぐ秋に突入します。\n秋のシーズンは9月1日〜11月30日、秋といえば紅葉！紅葉といえば手形！\n私の性癖の本領発揮のシーズンとも言えるでしょう！\nそこで！\n今回は秋を感じる秋手形リクエストを送らせていただきます！\n今回のリクエストに関しては、こちらの方で手形に対する様々な指定をさせていただきます。\n今回描いていただきたい手形は、いつもの両頬モミジとは違う、顔面の真正面に真っ赤で大きい紅葉(手形)が一つ付いているといった感じです。\n(イメージ的には、往復ビンタではなく、相撲で言う張り手を食らわしたと言った方がいいでしょう)\n手のひらの中心が鼻の先に来る感じの張り手ビンタです。\n跡が付くと、親指と小指はほっぺたの上部分、人差し指から薬指の先端は眉毛orおでこ、手のひらの下の部分は口を覆う形になります。\n手形の感じは漫画やアニメ調のべったりな感じで、色は紅葉が一番熟した状態の色、紅葉シーズン終盤近くに見られる、ザ・赤と言ったような濃い赤色の紅葉になります。\nリアルな手形の感じは意識せず、頬に付いた時と同様の赤いべったり手形が一枚顔の真ん中に鎮座している感じでお願いします。\n本物の紅葉にも負けない、存在感のある一枚の紅葉(手形)をビターンと張り付けてください！！\n張り手形の参考イラストは、私のリクエスト作品欄にもたくさんありますので、そちらも是非参考にしてください！\n\nさて、内容ですが\n\n顔面に真っ赤な張り手形の付いた、私が使用しているVRChatアバターのシオンくんをお願いします！\n\n(秋らしく、秋を感じる背景等でお願いします)\n\n(両頬手形バージョンもお願いします)\n\nhttps://pbs.twimg.com/media/GOUzbV5agAAgCP8.jpg", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mo_1Sum/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2570148, "client_id": 422626, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41b47c9c/uploads/origins/74fce073-7452-4916-9b02-420046961da0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3ddb57dac70c0a5f4f59adc3e49e626", "srcset": "https://si.imgix.net/41b47c9c/uploads/origins/74fce073-7452-4916-9b02-420046961da0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3ddb57dac70c0a5f4f59adc3e49e626, https://si.imgix.net/41b47c9c/uploads/origins/74fce073-7452-4916-9b02-420046961da0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b81facf9fac4a96de7dec11e7191d1e6 2x, https://si.imgix.net/41b47c9c/uploads/origins/74fce073-7452-4916-9b02-420046961da0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88a2353e8255fdf7174e7f7fd45606a4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41b47c9c/uploads/origins/74fce073-7452-4916-9b02-420046961da0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcbeefde8664b26313d8163a11423a1a", "srcset": "https://si.imgix.net/41b47c9c/uploads/origins/74fce073-7452-4916-9b02-420046961da0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcbeefde8664b26313d8163a11423a1a, https://si.imgix.net/41b47c9c/uploads/origins/74fce073-7452-4916-9b02-420046961da0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e6efa6b12f08a23a6a7cdc1bce86d6d4 2x, ht