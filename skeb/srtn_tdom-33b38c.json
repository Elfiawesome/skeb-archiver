fit=crop&crop=top&w=200&h=200&s=4c5be74397c4e7209c7ccc518a0a4cb6 2x, https://si.imgix.net/d1473b2a/uploads/origins/65d584cb-8050-470e-811f-cb80b67d054c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6647ad81afdebf36742bbc81a2a168bb 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1473b2a/uploads/origins/65d584cb-8050-470e-811f-cb80b67d054c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28811231c772a039e64cb4f1dea5b4f5", "srcset": "https://si.imgix.net/d1473b2a/uploads/origins/65d584cb-8050-470e-811f-cb80b67d054c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28811231c772a039e64cb4f1dea5b4f5, https://si.imgix.net/d1473b2a/uploads/origins/65d584cb-8050-470e-811f-cb80b67d054c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d448e1770de779645aae15a0808ef825 2x, https://si.imgix.net/d1473b2a/uploads/origins/65d584cb-8050-470e-811f-cb80b67d054c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=83630443d9d0306d24f6d89ce02fa42f 3x"}, "body": "初めまして！　リクエストさせていただきます！\n学園アイドルマスターの紫雲清夏ちゃんが、お腹を壊して和式トイレで下痢ウンチをブリブリ排泄しているシーンを描いていただきたいです！\n\n・服装\n通常の制服（参考URL→https://idolmaster-official.jp/assets/img/gakuen/campaign/card/sumika/r/card.jpg）\n太ももをまたぐ下着→白のショーツ\n靴下→黒のハイソックス\n靴→こげ茶色のローファー\n※アクセサリーなどが作画のご負担になる場合は、省略してもらって構いません。\n\n・排泄時の構図\n他者様の作品で申し訳ありませんが、排泄シーンの構図はこちらの作品（https://www.pixiv.net/artworks/117980444）に似せてください。\n\n・シチュエーションや台詞、効果音のイメージ\n※描く際の参考、もしくは引用していただき、厳しい場合はスルーしていただいて構いません。そちらにお任せします。\n\n1、下校中にお腹を壊してしまった清夏ちゃん、あわてた様子で帰りを急ぐ。\n腹痛がそろそろ限界になってきたところ、通りががった公園にある公衆和式トイレを発見、オナラを漏らしながら駆け込む。\n清夏「やばいやばいやばい……！」（プリプリブッ！　プウッ！　プスプスッ）\n\n2、少しボロい和式トイレのドアを開け、パンツを下ろしてしゃがみ込み、安心した表情で我慢していた下痢ウンチをオナラと一緒に盛大に放つ。\n清夏「はぁ……まにあった……」（ブボビチチチリリリリッ！　ブリリリッ！　ブゥッブウゥーーッ！）\n\n以上です。\n金額が足りない場合、キャラクターが難しい場合は、それぞれ適正な金額、オリジナルのキャラクターに変更して再送させていただきます。\n是非、ご検討の程、よろしくお願いします。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@srtn_tdom/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3322059, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18aa7de2/uploads/origins/0783c336-6144-4f57-906c-b3e0f9e2e3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22e0d31eea7146309ea53ad97877bf02", "srcset": "https://si.imgix.net/18aa7de2/uploads/origins/0783c336-6144-4f57-906c-b3e0f9e2e3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22e0d31eea7146309ea53ad97877bf02, https://si.imgix.net/18aa7de2/uploads/origins/0783c336-6144-4f57-906c-b3e0f9e2e3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f38a029848f22e68e4e8715eb01d05b7 2x, https://si.imgix.net/18aa7de2/uploads/origins/0783c336-6144-4f57-906c-b3e0f9e2e3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa99c7e69f9b923a369c19b972a97364 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/18aa7de2/uploads/origins/0783c336-6144-4f57-906c-b3e0f9e2e3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b570df31cd2b881b99bbf88793bc587", "srcset": "https://si.imgix.net/18aa7de2/uploads/origins/0783c336-6144-4f57-906c-b3e0f9e2e3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b570df31cd2b881b99bbf88793bc587, https://si.imgix.net/18aa7de2/uploads/origins/0783c336-6144-4f57-906c-b3e0f9e2e3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=30cdd8609cdd817ddfcd9c72efc6c65c 2x, https://si.imgix.net/18aa7de2/uploads/origins/0783c336-6144-4f57-906c-b3e0f9e2e3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7cd395fc45ae99a1a9fd83c589b40e99 3x"}, "body": "初めまして、リクエストさせていただきます。\nデレマスの桐生つかさちゃんが、腹痛になってしまって和式トイレで下痢便を排泄するシーンを描いて頂きたいです。\n\n服装は制服（資料URL参照）\n下着は白のパンツでお願いします。\n\n・シチュエーション\n登校中のつかさちゃんが途中で腹痛になってしまい、オナラをプスプス出しながら急いで学校へ向かっていると、痛みがかなり強くなり我慢が出来なくなってしまう。\n通学路の途中にある公衆和式トイレを発見して、たまらず駆け込み、パンツを下ろして、下痢便とおしっこを一気にブリブリジョボジョボと排泄。\n安堵の表情で排泄の気持ちよさを感じる。\n\n以上です。\n是非ご検討のほど、お願いいたします。\n\nhttps://imas.gamedbs.jp/cgss/images/dtoKrBc243-VogpRX0CenTeULAL3SK05fK53Gqyt3a0.jpg", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@srtn_tdom/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3322059, "client_id": 1046302, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a6fe026/uploads/origins/a617efe4-56bd-4023-8fc9-03aa7bc6d887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e36de608603d93df1f442b884e5535b4", "srcset": "https://si.imgix.net/2a6fe026/uploads/origins/a617efe4-56bd-4023-8fc9-03aa7bc6d887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e36de608603d93df1f442b884e5535b4, https://si.imgix.net/2a6fe026/uploads/origins/a617efe4-56bd-4023-8fc9-03aa7bc6d887?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c0e6a44822bf388e57e5e726b48754b 2x, https://si.imgix.net/2a6fe026/uploads/origins/a617efe4-56bd-4023-8fc9-03aa7bc6d887?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99067d1cda29bfc9717ee64df5152af8 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a6fe026/uploads/origins/a617efe4-56bd-4023-8fc9-03aa7bc6d887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1854395808d46a11f178ae8cc3430e7", "srcset": "https://si.imgix.net/2a6fe026/uploads/origins/a617efe4-56bd-4023-8fc9-03aa7bc6d887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1854395808d46a11f178ae8cc3430e7, https://si.imgix.net/2a6fe026/uploads/origins/a617efe4-56bd-4023-8fc9-03aa7bc6d887?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=133567ba1627373288326f230a9629e9 2x, https://si.imgix.net/2a6fe026/uploads/origins/a617efe4-56bd-4023-8fc9-03aa7bc6d887?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=131b6ce51645103987e29aaf7d3e05a9 3x"}, "body": "いつもイラスト拝見させていただいております。\n今回お願いしたいのが、パズドラのハクというキャラクターです。(腰周りの装飾は省略してもらって大丈夫です。)\nシチュエーションとしては夏に海に遊びに来たものの、海の冷たさやかき氷などでお腹が冷えて腹痛に襲われてしまい、我慢出来ずに人気の無い岩陰でうんちとおしっこを排泄してしまうという感じでお願いします。構図やアングルはおまかせします。\nどうかよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-oocDGDS5IKTQdhrZkLRR4bMsWqCdkvf", "nc": 178, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@srtn_tdom/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e62e52e9/uploads/origins/eb657efd-74c7-45b6-8373-9cb085c1a63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a73b37e29953a18242e123b09dcee93c", "srcset": "https://si.imgix.net/e62e52e9/uploads/origins/eb657efd-74c7-45b6-8373-9cb085c1a63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a73b37e29953a18242e123b09dcee93c, https://si.imgix.net/e62e52e9/uploads/origins/eb657efd-74c7-45b6-8373-9cb085c1a63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dcfd17ed99a15aa97a71a3ab488ef0b4 2x, https://si.imgix.net/e62e52e9/uploads/origins/eb657efd-74c7-45b6-8373-9cb085c1a63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txts