見た目が不吉なので、人前では滅多にやらない。\nいわゆる魔物のような存在もいる世界観なので、人目につかぬようそれを排除したりする。\n\nhttps://drive.google.com/drive/folders/1pZrUF6Gb6Lprf76smijYlfnqBMMGRgB5?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumausagi_r18/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1204531, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cac2112a/uploads/origins/7fda9ca3-ccfe-4666-9b1f-91378c0693e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41052bae246a3295a2cb1f39e7c44e69", "srcset": "https://si.imgix.net/cac2112a/uploads/origins/7fda9ca3-ccfe-4666-9b1f-91378c0693e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41052bae246a3295a2cb1f39e7c44e69, https://si.imgix.net/cac2112a/uploads/origins/7fda9ca3-ccfe-4666-9b1f-91378c0693e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a54ea71f2a33d60ec392e927a398034e 2x, https://si.imgix.net/cac2112a/uploads/origins/7fda9ca3-ccfe-4666-9b1f-91378c0693e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cdfb36269ae4199f9657e2790b21f0fd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cac2112a/uploads/origins/7fda9ca3-ccfe-4666-9b1f-91378c0693e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0c20c5b68f09a833a2b89c796262a16", "srcset": "https://si.imgix.net/cac2112a/uploads/origins/7fda9ca3-ccfe-4666-9b1f-91378c0693e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0c20c5b68f09a833a2b89c796262a16, https://si.imgix.net/cac2112a/uploads/origins/7fda9ca3-ccfe-4666-9b1f-91378c0693e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ff97d2d871ee63b9a1e39f6e56d76748 2x, https://si.imgix.net/cac2112a/uploads/origins/7fda9ca3