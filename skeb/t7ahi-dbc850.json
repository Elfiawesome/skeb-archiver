容】\n水着のOCを描いていただいたです。\n\n水着はURL内のものでお願いします。色味やデザインはそのままでも、アレンジしてくださっても構いません。\n\n髪型もURLをご確認お願いします。顔周りの髪はデフォのままでお願いします。\n\n構図は両手で海水をこちらにかけてくる\n表情はとても楽しそうにニコニコ\n\n（NG）\nオッドアイではない、タトゥーなし（簡略化️⭕️）\n\n【使用用途】\nアイコン、ヘッダー、SNSで投稿\n\n【その他】\nもし可能でしたら背景透過も納品してくださると幸いです\n\nhttps://drive.google.com/drive/folders/1_sUK9v38Ckhj9UdVYxA31A5jgn2exUh5", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@t7ahi/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3335808, "client_id": 2513697, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1bb1394/uploads/origins/99eb6032-1bc4-4444-ba74-20e20eae82d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76d23de6791f4d0b1c44e755675c83a5", "srcset": "https://si.imgix.net/a1bb1394/uploads/origins/99eb6032-1bc4-4444-ba74-20e20eae82d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76d23de6791f4d0b1c44e755675c83a5, https://si.imgix.net/a1bb1394/uploads/origins/99eb6032-1bc4-4444-ba74-20e20eae82d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfab2ee6f3aa95cf3805c51b149302a5 2x, https://si.imgix.net/a1bb1394/uploads/origins/99eb6032-1bc4-4444-ba74-20e20eae82d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ca55db50c315098ef54410585808dc1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1bb1394/uploads/origins/99eb6032-1bc4-4444-ba74-20e20eae82d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb8d6d72b5d2f3f3d0fabc11be5122f7", "srcset": "https://si.imgix.net/a1bb1394/uploads/origins/99eb6032-1bc4-4444-ba74-20e20eae82d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb8d6d72b5d2f3f3d0fabc11be5122f7, https://si.imgix.net/a1bb1394/uploads/origins/99eb6032-1bc4-4444-ba