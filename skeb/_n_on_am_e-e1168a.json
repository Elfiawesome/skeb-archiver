混ざった色のポニーテールで、小さな緑の角が生えています。\n\n彼女がカラムビットナイフを構えて攻撃しようとしている様子で、あなたの襟首をつかんでいるようなポーズで描いていただけませんか？\n\n怒った表情で、疲れた目つきを際立たせ、顔中に血が飛び散っている感じにしてください。よろしくお願いします :)\n\nhttps://drive.google.com/file/d/1BdviISY0iEWIV1Jkb7OBeEQDXqHUr84R/view?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_n_on_am_e/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3740295, "client_id": 2424897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5434ce61/uploads/origins/0d6b22ea-e77a-4358-9315-0710e738d70a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cfb606527b4f69ea176ed2669774ba4", "srcset": "https://si.imgix.net/5434ce61/uploads/origins/0d6b22ea-e77a-4358-9315-0710e738d70a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cfb606527b4f69ea176ed2669774ba4, https://si.imgix.net/5434ce61/uploads/origins/0d6b22ea-e77a-4358-9315-0710e738d70a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=532078cda36ee128873cf3e7133c6590 2x, https://si.imgix.net/5434ce61/uploads/origins/0d6b22ea-e77a-4358-9315-0710e738d70a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d5398106019724db512909323ffe0db 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5434ce61/uploads/origins/0d6b22ea-e77a-4358-9315-0710e738d70a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7ee24e1c18d250609d14ae1308ea0a3", "srcset": "https://si.imgix.net/5434ce61/uploads/origins/0d6b22ea-e77a-4358-9315-0710e738d70a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7ee24e1c18d250609d14ae1308ea0a3, https://si.imgix.net/5434ce61/uploads/origins/0d6b22ea-e77a-4358-9315-0710e738d70a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=20