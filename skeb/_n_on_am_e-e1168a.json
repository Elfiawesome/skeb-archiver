s/ee57344e-dcfb-41c4-bb0c-e14c87c91dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed93b537aad3b69c0f276fb0bf0cd9b5, https://si.imgix.net/f5bea3be/uploads/origins/ee57344e-dcfb-41c4-bb0c-e14c87c91dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4cd4f8ef0abaa7351d72ae968704f244 2x, https://si.imgix.net/f5bea3be/uploads/origins/ee57344e-dcfb-41c4-bb0c-e14c87c91dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81f5adb559a35cd5a7c094cbfd40ec02 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5bea3be/uploads/origins/ee57344e-dcfb-41c4-bb0c-e14c87c91dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ab3756facf227ac39740d4ca556c94f", "srcset": "https://si.imgix.net/f5bea3be/uploads/origins/ee57344e-dcfb-41c4-bb0c-e14c87c91dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ab3756facf227ac39740d4ca556c94f, https://si.imgix.net/f5bea3be/uploads/origins/ee57344e-dcfb-41c4-bb0c-e14c87c91dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32ea7e40e91a4565cbb337c3510d3f7d 2x, https://si.imgix.net/f5bea3be/uploads/origins/ee57344e-dcfb-41c4-bb0c-e14c87c91dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=511750495c9635e1dc453fe7d3536d19 3x"}, "body": "こんにちは！はじめまして。\n𝕏のポストならびにSkebにてお描きになったイラストを拝見し、とても素敵だと思いまして、ぜひ一度私のFF14自キャラをお願いしたく思い、リクエストさせていただきました。\n\n【キャラのイメージ】\n- 白髪と薄紫の目\n- クールで知的な大人のお姉さんの雰囲気\n\n服装は複数用意しておりますので、お好きなものをお選びいただければ幸いです。\n【希望要素】\n服装1 (Outfit 1)：\n・この服装を採用する場合は、武器も一緒に描いてください。\n・全体のイメージは高冷でクールな雰囲気を重視してください。\n服装2 (Outfit 2)：\n・この服装を採用する場合は、武器の有無も完全にお任せします。\n・イメージは先生の自由に描いていただければ大丈夫です。唯美寄りでも高冷寄りでも、どんな雰囲気でも嬉しいです！\n武器の補足：\n・ゲーム内エフェクトの有無はお任せいたします。\n・エフェクトを描いていただける場合は、白色や紫色などお好きなもので大丈夫です！\n・鞘は省略していただければ幸いです。\n\nPCの壁紙やSNSのヘッダーとして使いたいので、横長の構図だと大変ありがたいです。\n構図・ポーズ・表情などはすべてお任せでお願いいたします！\n\nご検討いただけましたら嬉しいです！よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/19acYsqfd2HiAZTQ5pmml64uDnFJCXp_m?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_n_on_am_e/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3740295, "client_id": 1493847, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72d65bcd/uploads/origins/0b1bfb6f-2aa3-47b6-81e4-cfab595107b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ad8312afd311c1d4a7b39f2414a7efd", "srcset": "https://si.imgix.net/72d65bcd/uploads/origins/0b1bfb6f-2aa3-47b6-81e4-cfab595107b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ad8312afd311c1d4a7b39f2414a7efd, https://si.imgix.net/72d65bcd/uploads/origins/0b1bfb6f-2aa3-47b6-81e4-cfab595107b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ca91d67f506415950d5fe840283f7bf 2x, https://si.imgix.net/72d65bcd/uploads/origins/0b1bfb6f-2aa3-47b6-81e4-cfab595107b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe5f68faaae8b962553b809267002ee2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72d65bcd/uploads/origins/0b1bfb6f-2aa3-47b6-81e4-cfab595107b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a739766eab6e7f6d0ba849c3ba60e73d", "srcset": "https://si.imgix.net/72d65bcd/uploads/origins/0b1bfb6f-2aa3-47b6-81e4-cfab595107b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a739766eab6e7f6d0ba849c3ba60e73d, https://si.imgix.net/72d65bcd/uploads/origins/0b1bfb6f-2aa3-47b6-81e4-cfab595107b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5c9b076806c0546157b1810235e59c5d 2x, https://si.imgix.net/72d65bcd/uploads/o