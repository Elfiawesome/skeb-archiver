h=200&blur=200&s=d746f44b89ace89e634c467a18a98b76", "src_set": ""}, "body": "初めまして。リクエスト失礼致します\nMELTY BLOODのシオンエルトナムアトラシアが不潔な肥満オタクのアパートに連れ込まれ、輪姦されているイラストをお願いします。\n衣服は着衣状態で捲り上げられ、豊満な胸を露出\n顔のアップでザーゲロかディープキスなど頂けると幸いです。\n　\nご一考よろしくお願い致します", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurainao_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 162952, "client_id": 30228, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d95b7de1/requests/129891_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45fa510265e08bd62f9ae6274ebc2625", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d95b7de1/requests/129891_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=398f61e8b20e06d892e30c12c0ed07c6", "src_set": ""}, "body": "素晴らしい作品をありがとうございました。\n前回依頼品（D.Gray-manのリナリー (初期)がおっさん達に輪姦されている作品）の続きをお願いいたします。\n可能な限りもっと色々なシーン、表情をお願いいたします。\n望まない快楽をすりこまれ、少しずつ雌へと落ちていく姿が見たいです。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurainao_/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/662f0f76/requests/123206_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28c96d8cfff7a99b5bc0cc77b18c4a00", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 162952, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kurainao_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tippe