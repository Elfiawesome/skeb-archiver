ーです）\n光司一誠の恋差分で殴られました。ありがとうございます。\n何……なに！？あの笑い方なに！？？！？あんなへにゃ……って笑ったらそんなん絆されちゃうだろが！！！！\nツラが既に〝主人公〟なんですよね。人狼差分の闇落ちした感じで相乗効果出てます。出てるんですよ。\nこのフェイスで世話焼き苦労人みたいなRPされたらねえ、そんなん惚れるに決まってるんです。\n描いて頂いた武器≪イラスト≫は、光司PLを殴るのにも使用させて頂きます。私に力をください。", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@11ha_sh1ra/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1516591, "client_id": 313813, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8f84dd5/uploads/origins/834cc344-2f34-4366-9812-6de172d0f920?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbadd4a659cebe0d5c832b89b768680f", "srcset": "https://si.imgix.net/b8f84dd5/uploads/origins/834cc344-2f34-4366-9812-6de172d0f920?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbadd4a659cebe0d5c832b89b768680f, https://si.imgix.net/b8f84dd5/uploads/origins/834cc344-2f34-4366-9812-6de172d0f920?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0564bbd897f35d52ee50087b15b4f4b 2x, https://si.imgix.net/b8f84dd5/uploads/origins/834cc344-2f34-4366-9812-6de172d0f920?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0f8e9cc1cd7bffbeed296e2810efc78 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8f84dd5/uploads/origins/834cc344-2f34-4366-9812-6de172d0f920?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=788d496e05d4fd069e091311f7188162", "srcset": "https://si.imgix.net/b8f84dd5/uploads/origins/834cc344-2f34-4366-9812-6de172d0f920?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=788d496e05d4fd069e091311f7188162, https://si.imgix.net/b8f84dd5/uploads/origins/834cc344-2f34-4366-9812-6de172d0f920?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200