99ada741/uploads/origins/010843b6-4d83-45cf-bae5-2434d6befb7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0f6cf60bd3c98ea2916832c6411f7fa, https://si.imgix.net/99ada741/uploads/origins/010843b6-4d83-45cf-bae5-2434d6befb7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dfed023b8829bd41b8f6408c053379b8 2x, https://si.imgix.net/99ada741/uploads/origins/010843b6-4d83-45cf-bae5-2434d6befb7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=94a488a87d16a8972351f02f0d18ff86 3x"}, "body": "ゲーム制作お疲れ様です！\n昨年は大変お世話になりました！\n今年も宜しくお願いします！\n\nサクツキ、カグハに続き霧賊イルフィアの船員ナカメのイラストを何卒お願いします！\n\nナカメが船の帆網に捕まりながら足を掛け、片手に持った剣（本人がよく扱う武器）を掲げているような場面をナカメの全身が見える構図で描いてほしいです。\n戦闘前に仲間の士気を高揚させている、勝利して勝鬨を上げている、宴で酔ってご機嫌になったから調子の良さそうなポーズをしている、などのシチュエーションをイメージしています。個人的にナカメは宴や戦闘でそうした盛り上げ役をしていそうなイメージがあったのでリクエストしました！\n\nもし可能でしたら酒屋を営んでいた過去の姿と盗賊団の一員になった今の姿を同じイラストに描写してほしいです。無理を言うつもりはありません！\n\nナカメも格好良くて好きですのでぜひよろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sabakisaki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3771692, "client_id": 2437718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b91a72dc/uploads/origins/abddcf17-7f13-444a-9a83-31ca15f2a903?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82e7dae62fcfb74c0230d1d4115e6c71", "srcset": "https://si.imgix.net/b91a72dc/uploads/origins/abddcf17-7f13-444a-9a83-31ca15f2a903?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82e7dae62fcfb74c0230d1d4115e6c71, https://si.imgix.net/b91a72dc/uploads/origins/abddcf17-7f13-444a-9a83-31ca15f2a903?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66a359398ff1bd75ce2912978fccf7a8 2x, https://si.imgix.net/b91a72dc/uploads/origins/abddcf17-7f13-444a-9a83-31ca15f2a903?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3321fa1ff24f827de0e3bba1344362a8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b91a72dc/uploads/origins/abddcf17-7f13-444a-9a83-31ca15f2a903?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4278866893d0a29881249c88df912f23", "srcset": "https://si.imgix.net/b91a72dc/uploads/origins/abddcf17-7f13-444a-9a83-31ca15f2a903?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4278866893d0a29881249c88df912f23, https://si.imgix.net/b91a72dc/uploads/origins/abddcf17-7f13-444a-9a83-31ca15f2a903?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bcb20674007fe5b0878a51604739efaf 2x, https://si.imgix.net/b91a72dc/uploads/origins/abddcf17-7f13-444a-9a83-31ca15f2a903?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dbd88b4234448f58b197a68b445ebf34 3x"}, "body": "お疲れ様です！サクツキのイラストでは大変お世話になりました！\n\n他のキャラクターも魅力的ですので、よろしければ霧賊イルフィアの船員カグハのイラストをお願いします！\n\nシチュエーションとしては、イルフィアの船上で敵勢力との戦闘中。\n普段は前髪で隠れているカグハの目が見えるような描写。\n月夜を背景に、カグハが敵を挑発するような悪い笑みを浮かべている。\n火炎瓶か剣などの武器を片手に持っている。\nできるだけ全身が見えるような構図にしてほしいです。\n\n個人的なイメージに過ぎませんが、カグハは愉快犯やいたずら好きの悪ガキみたいな印象があるので、上記の「悪い笑み」については、さばきさんのカグハのイメージにピッタリは当てまるような表情にしていただければ嬉しいです！\nまた、さばきさんにとっての描きやすさを考慮して必要であればアレンジを加えても大丈夫です。\n\n年末も近づきお忙しいかと思いますが、無理にならない程度で構いませんので、お気軽にご検討ください！\nぜひよろしくお願いします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sabakisaki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3771692, "client_id": 2437718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29e309ff/uploads/origins/5af8c8da-9f01-4c84-9b4f-877b86e54638?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc5293df4d7e8ea3ccbf753f8c909e9a", "srcset":