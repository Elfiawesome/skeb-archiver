！青天の霹靂！塞翁が馬！！\n早速リクエストなのですが、「この出来損ないめ…」でお願いします！\nこれからも草葉の陰から見守っていきます！よろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@Yuudutsu_Tear/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": true, "creator_id": 152020, "client_id": 155848, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/539ba02d-ae18-4a99-b3b5-00ee08761ae4?response-content-disposition=inline&Expires=1782458573&Signature=Y4CLSqBxmVe-vj4O5Wd2dj3pRLy~PC5bqmULxHkogseaBEU6ZONhPqncurhTa6j7eeQMlcMEwCAzbP02ZYWBxCuejLwxD3aj-v6UXQLgd3SblHKEYQwdwTF3qSClXraUbxGL5lYNpZjqUXPaG3Xq0ZIPpNr8tXLhkuhyLhSIqDEinhs1NT84wbYAENf5Xs-FwCkg6bOhDNtkLejILplTyr5FEbpncgi5I0Zegpvz73pN1vF3N9t66baGRxGp7Iy1pwrMRnuU8v56sJu8JVxyukvDh7Z7xyKQQb0SWIVvzUXjnsuxnLY9ViedBeZq-WN~BcUxg~WsYO4ENdsZ0mwMQQ__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2039181650350002176%2FKB-MlpuO.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=380edd23c2697f1af3f0ed9028df6df8", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2039181650350002176%2FKB-MlpuO.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=380edd23c2697f1af3f0ed9028df6df8, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2039181650350002176%2FKB-MlpuO.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=361fe3183065d463bdeda23e92af2474 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2039181650350002176%2FKB-MlpuO.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6a4f52425abab51cc1a417375accba2 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/d576d431-4b1f-4be9-8f2b-f75f94e6c340?response-content-disposition=inline&Expires=1782458573&Signature=iXSj4X-2dLpZTnsz7Erap908Xyr5A5trPab