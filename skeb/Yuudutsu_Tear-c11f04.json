しいです。", "nc": 16, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@Yuudutsu_Tear/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": true, "creator_id": 152020, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/6c7f0878-3b43-4427-93b1-c6b14aea8117?response-content-disposition=inline&Expires=1782458573&Signature=n3AVkB5GPbq4rvGY~mCIS7FXTi~-trF-Fqw-pQc0EJO-0sqLZyXGIKi3T1~j3CcPP4iPKgFu8lRV19BGZEIp7TjiDFoSHI2IlavvBYxUwyX6z5c24AuVXJuwX6EDuaKjOTsHYoe4C5lkF60UsMxsLYHheHAjiIZuu4DTYp2P9ue1CqtbLtRNYIcHy228rS3Aw7GDsagij3vfekMy0Nrw5-NKCNGPrDXvKNIY0ToAZDjn4NEGSOu5nnZrOM0rkIgWxnHlnYc03nfgGuKNIJ1Ao9kC9SuMxcLbzl4BxawLmYw3a-kj40trTVUQSLDVKghkVbxla6jIAGWYea-4YJv~Ew__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2039181650350002176%2FKB-MlpuO.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=380edd23c2697f1af3f0ed9028df6df8", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2039181650350002176%2FKB-MlpuO.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=380edd23c2697f1af3f0ed9028df6df8, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2039181650350002176%2FKB-MlpuO.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=361fe3183065d463bdeda23e92af2474 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2039181650350002176%2FKB-MlpuO.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6a4f52425abab51cc1a417375accba2 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/d5ad31c5-8633-40c3-a875-32258c1083e7?response-content-disposition=inline&Expires=1782458573&Signature=qE9nKtB0W0I0hAyGqSBU5vAqObuzjdJab3dUULyBpYovbeqY6Bgr7YeynSsegw2ZPOu98MeokRDL65jjAooJ~-ZmFGar0UZshkbgKrGAsWXHnD5Vo5FgXC8Bt~AT8ncO~X8H