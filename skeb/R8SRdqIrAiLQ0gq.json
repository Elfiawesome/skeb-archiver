ivate_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2159172, "client_id": 2976519, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c70cf07/uploads/origins/c88d0acb-ad8b-4a75-8561-1f2b847e2031?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a0ad508ed78aa2f3a47796c97f84859", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c70cf07/uploads/origins/c88d0acb-ad8b-4a75-8561-1f2b847e2031?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=591ed7ae1122b329d6b610dc5e09a723", "src_set": ""}, "body": "https://drive.google.com/drive/folders/1utqD_-Bp4Crper0SQBz0a-74LUlMMRaI?usp=drive_link\n\nこんにちは！\n身長139.7cmで小柄です。\n彼の髪は本当に長くて、ブロンドで、柔らかいです。あなたが望むなら、三つ編みか他のスタイルで描くことができます。\n\n彼のカーディガンはオーバーサイズで、よく肩から落ちるんだ。\n\n体格はフェミニンで小柄。小さな男の子で、手も繊細だ（服に合わせてネイルを塗るのが好き）。\n\n性格はまだ未完成だが、いい子だ。唖なので話すことができず、手話とノートでコミュニケーションをとる！\n\n彼のモチーフはイチゴと鳥です！全く必要ないのですが、もしそういったものを取り入れていただけたらとてもありがたいです。\n\nジェーンを考えてくれたら嬉しいです！ありがとうございます！🙇", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@R8SRdqIrAiLQ0gq/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2159172, "client_id": 2066138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/202571e3/uploads/origins/3041fa75-008e-4422-a31b-bd51014e8f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=290151cf0e3e6b377262a73a01a5b1a8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/202571e3/uploads/origins/3041fa75-008e-4422-a31b-bd51014e8f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d3c6a687f1ab1c14c4e95ce83514578", "src_set": ""}, "body": "再びこんにちは！\n\nまたベリル・ルルーをあなたのスタイルで描いていただけませんか？\n\n服装はお好みで、もっとカジュアルなものを着せてもいいかもしれません\n\n今度はカメラに中指を立てるポーズをお願いします。これに似ていますね：\n\nhttps://twitter.com/k0k0midess/status/1645193840607756289\n\nありがとうございます！\n\nhttps://twitter.com/BerylLeRou/status/1603718007934459905", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@R8SRdqIrAiLQ0gq/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2159172, "client_id": 1559098, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fec7f9e9/uploads/origins/25688709-3e25-48bc-8165-7d26c944a994?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2213c174e6dd6ac895f0c1c8cd043688", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fec7f9e9/uploads/origins/25688709-3e25-48bc-8165-7d26c944a994?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a98c02cb8bf6fe78bf939230202f6d0a", "src_set": ""}, "body": "Hello! Your art is lovely and I was hoping you could draw my cat girl. \n(https://imgur.com/a/j4ZwRqA)\n\nPlease keep in mind that her flowers are not cherry blossoms, but they're 'hyacinths'! (https://imgur.com/a/R6d6oRc)\n\nYou can choose whichever outfit you'd like to draw. I'll leave the pose and expression up to you, I hope you have fun drawing her!\n\nThank you so much!", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@R8SRdqIrAiLQ0gq/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2159172, "client_id": 2066138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07ee4980/uploads/origins/82b52e2c-d467-482c-a60c-c1ad192ae364?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3db017f91bffd33148781f0ba32d4c40", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "conso