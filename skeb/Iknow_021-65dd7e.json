XU?usp=drive_link\n\nイメージはチルタイ/サマサンのコミックページが元で、大きな悪魔がティアを一対のチンコの上に抱いている。ティアとレナがそれぞれ片方のチンコで犯され、2人が一緒に騎乗するのを強制されているところを描いてほしい。二人の胸は互いに押し付け合い、キスを強要する。レナの胸はティアよりずっと大きいはずだ。ティアの胸はかなり小さい。二人の腹は悪魔の精液で膨らんでいるはずだ。\n\nありがとう！\n\nhttps://drive.google.com/drive/folders/1yhvrmz0JFM72BV7wmxUaAYzJmazVBpXU?usp=drive_link", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Iknow_021/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2952719, "client_id": 2521861, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f082ce98/uploads/origins/94fdf245-31c9-4506-aec6-8b4b594d1a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfb3ff24f9a0e00c458467e6c159a22b", "srcset": "https://si.imgix.net/f082ce98/uploads/origins/94fdf245-31c9-4506-aec6-8b4b594d1a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfb3ff24f9a0e00c458467e6c159a22b, https://si.imgix.net/f082ce98/uploads/origins/94fdf245-31c9-4506-aec6-8b4b594d1a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c94b97cd05707305e6aa09e50221c493 2x, https://si.imgix.net/f082ce98/uploads/origins/94fdf245-31c9-4506-aec6-8b4b594d1a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59d7a9ac3e52db043959f09f4550f33f 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f082ce98/uploads/origins/94fdf245-31c9-4506-aec6-8b4b594d1a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b10041b1afd43832102a99737c658f4", "srcset": "https://si.imgix.net/f082ce98/uploads/origins/94fdf245-31c9-4506-aec6-8b4b594d1a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b10041b1afd43832102a99737c658f4, https://si.imgix.net/f082ce98/uploads/origins/94fdf245-31c9-4506-aec6-8b4b594d1a6d?bg=%23fff