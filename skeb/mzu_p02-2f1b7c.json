fm=webp&fit=crop&crop=top&w=200&h=200&s=0335dce1452a97bdddbf5ac2f4c149e3, https://si.imgix.net/2d4af717/uploads/origins/349f425c-0da5-4d86-9985-d69b821e761e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3c28a265b68109d3d0c47cab2935055 2x, https://si.imgix.net/2d4af717/uploads/origins/349f425c-0da5-4d86-9985-d69b821e761e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9bf4909c29ef6a044e18dfaa4fcdd54 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d4af717/uploads/origins/349f425c-0da5-4d86-9985-d69b821e761e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36975c56afcda5845dbcea6e594c1e7f", "srcset": "https://si.imgix.net/2d4af717/uploads/origins/349f425c-0da5-4d86-9985-d69b821e761e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36975c56afcda5845dbcea6e594c1e7f, https://si.imgix.net/2d4af717/uploads/origins/349f425c-0da5-4d86-9985-d69b821e761e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=196c8fd7b271bb5968e42c23268850aa 2x, https://si.imgix.net/2d4af717/uploads/origins/349f425c-0da5-4d86-9985-d69b821e761e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=15ca5a3f9881141153386db8f5569cd4 3x"}, "body": "ハロー！！！（笑）。\n\n私はあなたの柔らかい画風がとても好きで、私のVtuberのキャラクターを描くことをお願いしたいです。\n\n彼女の名前はAuraで、スターゲイザー/ギャラクシーをテーマにしたキャラクターで、外の世界にいつも好奇心旺盛で、いつも笑顔でいます。\n\n彼女の顔で注目すべき点は、左目の下にある月と星の顔のタトゥーと右目の下にあるビューティマークです!また、両目には柔らかな赤のアイラインが入っています。\n\nポーズや表情はお任せします。お忙しい中、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1-0ZVkhSAN0rdYlOXU0sAj-weM3JzFalr", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mzu_p02/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 995127, "client_id": 1869278, "vtt_url": null,