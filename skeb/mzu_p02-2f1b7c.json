聞録で大好きなシャオ（https://pbs.twimg.com/media/EzG2pXXVoAAcdGt?format=jpg&name=4096x4096）の隣に私を描いていただけたらと思います。\nシャオは可愛いリボンのカチューシャ(色は問いません)と、こじゃれた服装(パーカーとか？)で、はにかんだり照れたりしているような表情が希望です。私自身は、参考リンクの「Outfit 2」/「Hood_Sketch」の服を着て、綿あめを持ちながら、はしゃいだり遊んだりしているところを描いていただければと思います。\n\n[使用方法］\nSNSに投稿したり、パソコンの壁紙として使用したいので、できれば壁紙サイズ（16:9）で作品を提供していただけるとありがたいです。\n\n本当にありがとうございます。私のお願いがあまり複雑でないことを願っています\n\nhttps://drive.google.com/drive/folders/1fWRqdZFkUAIFkCda_Gp2etcsWCfx6UxY?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mzu_p02/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 995127, "client_id": 913245, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8e0e158/uploads/origins/0902ae61-720b-4981-acac-4659b43aad20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10062c07b02045e0c17ecc5ae10fa54f", "srcset": "https://si.imgix.net/a8e0e158/uploads/origins/0902ae61-720b-4981-acac-4659b43aad20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10062c07b02045e0c17ecc5ae10fa54f, https://si.imgix.net/a8e0e158/uploads/origins/0902ae61-720b-4981-acac-4659b43aad20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9cf2ee2d7ded63f65eaed826c50d46d8 2x, https://si.imgix.net/a8e0e158/uploads/origins/0902ae61-720b-4981-acac-4659b43aad20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7910cf9c013c47ba81f4ade4cd48b684 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8e0e158/uploads/origins/0902ae61-720b-4981-acac-4659b43aad20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d0fde20f6e488d97bf99399a65d9536", "srcset": "https://si.imgix.net/a8e0e158/uploads/origins/0902ae61-720b-4981-acac-4659b43aad20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&