うな感覚です。タケルは所有欲と執着心を持って賢 にしがみついています。しかし、賢 は絶望に満ち、弱々しく自分を解放しようともがきますが、無駄です。\n\nポーズと構図はこんな感じです：https://drive.google.com/file/d/1yeVxOKzCNFRn8KBDChHftOoejR4Q7i2E/view?usp=drive_link\n*これは基本的な近似値です。正確に従う必要はありません。詳細はご自由にご変更ください。\nこれらの仕様以外は、残りはお任せします！😺\n\nhttps://drive.google.com/drive/folders/1btgtIKAma5-12ZasjSfOmF_JFUTD8Hrq?usp=drive_link", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Zuui_mofu/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2369610, "client_id": 697967, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1935047/uploads/origins/b1f6c095-e64a-4916-bbf8-fc9da79479d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=365b4bc08aab6231269ba25bc41d1270", "srcset": "https://si.imgix.net/c1935047/uploads/origins/b1f6c095-e64a-4916-bbf8-fc9da79479d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=365b4bc08aab6231269ba25bc41d1270, https://si.imgix.net/c1935047/uploads/origins/b1f6c095-e64a-4916-bbf8-fc9da79479d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6926386893e7ffcc268ef316ddf8cd5 2x, https://si.imgix.net/c1935047/uploads/origins/b1f6c095-e64a-4916-bbf8-fc9da79479d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3547baa0c13bbde1b42d487b2863485 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1935047/uploads/origins/b1f6c095-e64a-4916-bbf8-fc9da79479d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa873d783dfecf4274185aa70d9e1720", "srcset": "https://si.imgix.net/c1935047/uploads/origins/b1f6c095-e64a-4916-bbf8-fc9da79479d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa873d783dfecf4274185aa70d9e1720, https://si.imgix.net/c1935047/uploads/origins/b1f6c095-e64a