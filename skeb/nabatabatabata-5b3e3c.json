o=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=522b336e40cef10da2dc7c0d298778cc 3x"}, "body": "はじめまして。オリジナルキャラクターのイラストをお願いしたいです。\n\nキャラクターは自然が大好きな狼の擬人化です。趣味はジャングル探検と滝浴び。冒険好きな性格です。\n\n主な特徴は、銀の弾丸のついたネックレスをいつも身につけていることと、右腕に「1」のマークがあること。また、コーヒーと木陰での休息が大好き。\n\nデザイン、服装、ポーズについては、あなたのアートスタイルと創造性に任せたいと思います。\n\nもし背景を入れられるのであれば、ジャングルや滝の近くなど、自然を舞台にしたものが素敵です。\n\nでも、背景なしのシンプルなポーズや、小さな小道具と無地の背景も大歓迎です。どのようなスタイルでも構いません。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1roduaM7zOAj-TpR_QQap4uNw9FJcn7QF?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nabatabatabata/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2415864, "client_id": 3533840, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74bdb770/uploads/origins/2f9949e9-d3df-4794-b87d-b39becfd7a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6b6eef94ad6dd59f83612f1d6ef1e31", "srcset": "https://si.imgix.net/74bdb770/uploads/origins/2f9949e9-d3df-4794-b87d-b39becfd7a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6b6eef94ad6dd59f83612f1d6ef1e31, https://si.imgix.net/74bdb770/uploads/origins/2f9949e9-d3df-4794-b87d-b39becfd7a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c78191318ed8af72718cf50521e1b95f 2x, https://si.imgix.net/74bdb770/uploads/origins/2f9949e9-d3df-4794-b87d-b39becfd7a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e333b5278ede442b6010595c4c043b65 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74bdb770/uploads/origins/2f9949e9-d3df-4794-b87d-b39becfd7a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9747782e9eaf71ce3e46f55dbb098cc", "srcset": "https://si.imgix.net/74bdb770/uploads/origins/2f9949e9-d3df-4794-b87d-b39becfd7a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9747782e9eaf71ce3e46f55dbb098cc, https://si.imgix.net/74bdb770/uploads/origins/2f9949e9-d3df-4794-b87d-b39becfd7a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5c10fc44895d0e57c40bb57794bcb5c9 2x, https://si.imgix.net/74bdb770/uploads/origins/2f9949e9-d3df-4794-b87d-b39becfd7a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5e829053a887c42975350cffe8a117f0 3x"}, "body": "こんにちは、初めまして！PICKLEZと申します。 好きな作家さんのSkebを申請させていただくことになりました...！ PICKLEZはピザ配達員のサーベルキャラクターです。 明るく陽気な性格で、配達員なのに道に迷うことが多いのが特徴です。ペペロンチーノとタバスコホットソースをかけたスパイシーなピザが好きです。\n\n先生の画風や光、建物の絵などがとても好きなので、都心のどこかに立っている姿を見たいです。 昼でも夜でも構いません。 マンションのベルを押して待っている姿も、路地を回っている姿も、ちょっと日陰を見つけて休んでいる姿も好きです！\n\n先生の好みに合わせて、好きな姿や構図で描いてください。 服・帽子・小物のディテールが正確でなくても大丈夫です！服や帽子は着用した状態で描いてください。\n\nhttps://drive.google.com/drive/folders/1chGyc6lThzoqKsb1MfkvMfVTdy_Nz9El?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nabatabatabata/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/533a6bad/uploads/origins/2c356024-82f4-4b95-830f-51e860584de6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fce54e21e8fa7d62f4a21245799f1b59", "srcset": "https://si.imgix.net/533a6bad/uploads/origins/2c356024-82f4-4b95-830f-51e860584de6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fce54e21e8fa7d62f4a21245799f1b59, https://si.imgix.net/533a6bad/uploads/origins/2c356024-82f4-4b95-830f-51e860584de6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&tx