れていましたが、今では時間を操る能力を自分の強みとして活用しています。 \n\nかつては内気で優しい少女でしたが、今では人間たちが崇拝する、威厳ある預言者のような存在へと変わりました。そのため、人々の尊敬を得るために、冷たく距離を置いた態度をとっています。\n\n顔の傷跡とそばかすには特にご注意ください！ビジュアルのテーマは、時計、コンパス、夜、星、月、黒いレース、金色の糸などです。\n\nありがとうございます！金額が不足している場合は、再送してください！\n\nhttps://drive.google.com/drive/folders/1jGYIAJ-kVmsef7em2EcDefa30SOpyGIH?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_spriiiiiiing_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3892053, "client_id": 2321854, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/517aca5b/uploads/origins/bd5dc9d9-4fd2-4014-be2b-2d7213a61a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3803255d280f173b3af15e730c4343d3", "srcset": "https://si.imgix.net/517aca5b/uploads/origins/bd5dc9d9-4fd2-4014-be2b-2d7213a61a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3803255d280f173b3af15e730c4343d3, https://si.imgix.net/517aca5b/uploads/origins/bd5dc9d9-4fd2-4014-be2b-2d7213a61a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=248bf7771d18b899e4fc80d9d0efc781 2x, https://si.imgix.net/517aca5b/uploads/origins/bd5dc9d9-4fd2-4014-be2b-2d7213a61a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d427c30ca0ccb7186c2fbc0eea695545 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/517aca5b/uploads/origins/bd5dc9d9-4fd2-4014-be2b-2d7213a61a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1dfe6b354ead3c4d2498b6c5b91ac7e0", "srcset": "https://si.imgix.net/517aca5b/uploads/origins/bd5dc9d9-4fd2-4014-be2b-2d7213a61a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1dfe6b354ead3c4d2498b6c5b91ac7e0, https://si.imgix.net/517aca5b/uploads/origins/bd5dc9d9-4fd2-4014-be2b-2d7