しいが愉快な発言をする。\n家庭的。\n\n2人はCoCTRPG、ホラーシナリオの探索者です。\n\n\n■使用用途\n・友人との共有\n・個人範囲内でのグッズ制作、友人へ送るなど\n・SNSなどでの公開・使用(鮭田様のお名前・IDを必ず記載いたします。)\n\n\n内容に不備がある場合は遠慮なく再送要請、またはお断りください！\nご縁がありますよう、何卒よろしくお願いいたします...！\n\nキャラクター資料↓\nhttps://drive.google.com/drive/folders/1PBJ0JoRUiPtTxC25z-_LjMzdRD29jI0k?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@godsalmonsyaket/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2026353, "client_id": 3704384, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d15dd30/uploads/origins/3820dbbe-7393-41ec-a073-49d2b0720637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cea891df020070a3110c9e20f96bb2f8", "srcset": "https://si.imgix.net/4d15dd30/uploads/origins/3820dbbe-7393-41ec-a073-49d2b0720637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cea891df020070a3110c9e20f96bb2f8, https://si.imgix.net/4d15dd30/uploads/origins/3820dbbe-7393-41ec-a073-49d2b0720637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78f7f0929d89185b4c7d638318aafd81 2x, https://si.imgix.net/4d15dd30/uploads/origins/3820dbbe-7393-41ec-a073-49d2b0720637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b3752241d0765213049a09b0709a001 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d15dd30/uploads/origins/3820dbbe-7393-41ec-a073-49d2b0720637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f85d54817b5ed1048c04d150d2cd6189", "srcset": "https://si.imgix.net/4d15dd30/uploads/origins/3820dbbe-7393-41ec-a073-49d2b0720637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f85d54817b5ed1048c04d150d2cd6189, https://si.imgix.net/4d15dd30/uploads/origins/3820dbbe-7393-41ec-a073-49d2b0720637?bg=%23fff&aut