p=top&w=200&h=200&s=35c25f3c84ebf0a261a4aaca64e8a32b 2x, https://si.imgix.net/0093bf14/uploads/origins/db76305a-d18f-4b82-8bb2-6871b254014e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3dc5106698b03819238259cf6fb9eab7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0093bf14/uploads/origins/db76305a-d18f-4b82-8bb2-6871b254014e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10b8442d9d9e6d717aca6d5f8e90f64e", "srcset": "https://si.imgix.net/0093bf14/uploads/origins/db76305a-d18f-4b82-8bb2-6871b254014e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10b8442d9d9e6d717aca6d5f8e90f64e, https://si.imgix.net/0093bf14/uploads/origins/db76305a-d18f-4b82-8bb2-6871b254014e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e6532f7ea375cf597c4e5f09ac2d748e 2x, https://si.imgix.net/0093bf14/uploads/origins/db76305a-d18f-4b82-8bb2-6871b254014e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e0db0ef193745d20f40e3ccb1267283f 3x"}, "body": "初めまして\n可愛すぎるぬい風イラストに惹かれまして、ぜひ私たちのOCをお願いしたく…スケブ依頼失礼いたします…！\n私と友人のOCとなります。（お相手様より依頼の許可はいただいております）\n\n金額が不足している場合、再送いただけますと幸いです。スケジュールが厳しい場合も、遠慮なくキャンセルくださいませ。\n\n｜赤髪の女（稟珠）\nわがままなツンデレの女性。かわいいものがすき。\n\n｜白髪の男（白亜 皓衣）\n真面目で稟珠のわがままに振り回されている。なんだかんだ世話を焼いてしまう。\n\n｜使用用途\n鑑賞　SNS等のアイコン・ヘッダー（使用の際は明記いたします）\n個人用のグッズ作成\n\nhttps://drive.google.com/drive/folders/1ZmTKfvv07tRgRGDt8FqVGNqohbDuFmx8?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@godsalmonsyaket/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2026353, "client_id": 1515191, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3e97c05/uploads/origins/e62e32cf-8431-4c2d-be02-cb66d1353a73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea5428912f28d00f510a39c00224647d", "srcset": "https://si.imgix.net/b3e97c05/uploads/origins/e62e32cf-8431-4c2d-be02-cb66d1353a73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea5428912f28d00f510a39c00224647d, https://si.imgix.net/b3e97c05/uploads/origins/e62e32cf-8431-4c2d-be02-cb66d1353a73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59dcf2c60b75c04beb688e34d981a1ef 2x, https://si.imgix.net/b3e97c05/uploads/origins/e62e32cf-8431-4c2d-be02-cb66d1353a73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f774a833b2e0f73623211f80540ef410 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3e97c05/uploads/origins/e62e32cf-8431-4c2d-be02-cb66d1353a73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bbef5196635557af2568a11bcf42ab5", "srcset": "https://si.imgix.net/b3e97c05/uploads/origins/e62e32cf-8431-4c2d-be02-cb66d1353a73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bbef5196635557af2568a11bcf42ab5, https://si.imgix.net/b3e97c05/uploads/origins/e62e32cf-8431-4c2d-be02-cb66d1353a73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd32ac661c8b6bd7d5b38789eff78620 2x, https://si.imgix.net/b3e97c05/uploads/origins/e62e32cf-8431-4c2d-be02-cb66d1353a73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ba7eb2473c78f9e34650d971d779911 3x"}, "body": "鮭田様  \n\n初めまして、ルイと申します。\nXにて、ぬい風のイラストがとても可愛らしく、是非私と友人のOCを描いて頂きたく、メッセージをお送りしました。  \n\n【キャラクター詳細】\n◾︎御門 壱月/みかど いつき(29) \n176cm/A型\n黒髪/そばかす/喫煙者\n\n白栖朔の担当編集者。 几帳面で真面目な性格。無表情で感情が表情に乗らない。無自覚だが、白栖朔に独占欲/執着など激重感情がある。ストレートに物事を伝える。 最近はかなり表情が柔らかくなった。朔の前だと甘える態度を見せたりもする。\n\n◾︎白栖 朔/しらす さく(29) \n176cm/AB型\n白髪/綺麗な顔立ち/喫煙者\n\n作家。猫のように気まぐれで、意地っ張りな性格。愛嬌はあるが、デリカシーがない。こいつなら許してくれるという甘えが壱月にあり、大事にされている自覚もある。素直に想いを伝えるのが得意ではない。壱月を弟のように可愛がり、甘やかすときもある。\n\n◾︎関係性 \n作家と担当編集者。幼馴染から恋人へ。お互い独占欲があり、相手を大事に想っている。 2人きりのときは距離が近め。ほぼ半同棲のような形で一緒に過ごしており、婚約している。\n \n\n【使用用途】 \n・個人観賞\n・SNSのアイコン \n・個人グッズ作成\n・友人への共有\n\nぬい風の2人を描いて頂きたいです。服装はGoogleドライブ内に資料がありますので、お好きなものを選んで頂ければと思います。\n\n資料や金額など、不備がありましたら差し戻して頂いて構いません。ご検討宜しくお願致します。\n\nhttps://drive.google.com/drive/folders/1-0K_FdLYssd-J4J2pLEIBIYKvn_w3wK2", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@godsalmonsyaket/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/caae84cb/uploads/origins/ea1ac908-05b2-4b1a-a66e-702ba082d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba28e872b2b4971fb2b032a684508a82", "srcset": "https://si.imgix.net/caae84cb/uploads/origins/ea1ac908-05b2-4b1a-a66e-702ba082d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba28e872b2b4971fb2b032a684508a82, https://si.imgix.net/caae84cb/uploads/origins/ea1ac908-05b2-4b1a-a66e-702ba082d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e8f934e731c6e93c7a5ab7c570c6d28 2x, https://si.imgix.net/caae84cb/uploads/origins/ea1ac908-05b2-4b1a-a66e-702ba082d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed863c07c70366e81918db827bf46089 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2026353, "client_id": 70702, "nc": 0}, {"path": "/@godsalmonsyaket/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2026353, "client_id": 3967159, "vtt_url":