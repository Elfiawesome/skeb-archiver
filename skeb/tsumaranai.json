age_urls": {"src": "https://si.imgix.net/f902a1d5/uploads/origins/1c209f3d-a102-4fe1-bcf6-1edd030ea5d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0eecd66f9db5c51c314d5a6fc365a127", "src_set": ""}, "body": "夏彦先生、こんにちは！skebを始めて本当に嬉しいです…！できれば、うちの子達をまたリクエスト致します…！ \n\n キャラ：\n• パーシヴァル (Percival) = この物語の主人公。空気の読めないだがいい子だ。優しい人。騎士です。本気になるとちょっと怖いです。 武器は槍。\n\n • アトラス（Atlas）= 怠惰な図書館員。眠そうな性格。面倒なことをするのが嫌いなようです。髪がボサボサ。目袋。NEET 。青い蝶、古本、金糸をモチーフです。\n\nこちらは参考の図像です：\nパーシ: https://drive.google.com/drive/folders/1joVSPLZsLKsRb5l4WTwLS3WyrFuuOYI8?usp=sharing  \n\nアト: https://drive.google.com/drive/folders/181GOzrLXjqMOiwHt83bN85tLsRfbzDXa?usp=sharing\n\n二人は同じ図書館で働く同僚である。同じ王国に住んでいる。アトラスはパーシヴァルの先輩です。\n\n関係は\n アト：「近いすぎ、、お前は…ほんとにうざい…」\n パシ：「あ、そうなんですか？でもね、僕は君のことが好きなんだよ。 (〃⌒∇⌒)」かも  \n\nポーズなどはお任せでお願いします、何でもOKです。できれば、かっこいいや綺麗なシーンが見たいです…アニメのメインビジュアルと同じような感じ。 デザインは少しラフなので、ぜひ自由に描いてくださいね。 デザインの変更、追加もOK!\n\n可能でしたら宛名とサインはpsdレイヤーでon/offできると嬉しいです。 \n\nご検討よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsumaranai/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/781c52c6/uploads/origins/07c2c9a8-d953-42a1-8d96-be876e0adca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=029cb676c987d547db767f90c9c11bce", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 278935, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 214850, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "𝖱𝖮𝖶𝖠", "screen_name": "maro_kyrw", "avatar_url": "https://pbs.twimg.com/profile_images/1960907952321388547/Lw3cX7h4.jpg", "