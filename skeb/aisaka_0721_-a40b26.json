フちゃんありがとうございました。\n非常によかったです。\n今回依頼したいのは前回の太陽系規模の肉塊スノウエルフちゃんの差分みたいなのをお願いしたいです。\n前回のが全体絵だったので今回はその顔周辺のアップ(バストアップ)絵でお願いします。\nスノウエルフちゃんの顔にたっぷりと顔肉をつけた感じでお願いしたいです。\n胸あたりまでは写ってると嬉しいです。\n顔周辺だけでも何兆、何京㌧あるんだなって想像できると嬉しいです。\n例のごとくイラスト内に推定体重を入れてください。\n\n可能でしたら一言、二言でいいのでスノウエルフちゃんのセリフがあると尚嬉しいです。\nよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Acid_Snake_YoG/works/55", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 483517, "client_id": 1518188, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df5715b7/uploads/origins/0dee1672-8f52-434f-b48c-891adb43ff3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34ee9e78d3a3d969143a1da618a5aded", "srcset": "https://si.imgix.net/df5715b7/uploads/origins/0dee1672-8f52-434f-b48c-891adb43ff3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34ee9e78d3a3d969143a1da618a5aded, https://si.imgix.net/df5715b7/uploads/origins/0dee1672-8f52-434f-b48c-891adb43ff3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9f86ac67d4c22646cbd2065bc994dd8 2x, https://si.imgix.net/df5715b7/uploads/origins/0dee1672-8f52-434f-b48c-891adb43ff3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e95565c634e7182084b11a0a553a5638 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df5715b7/uploads/origins/0dee1672-8f52-434f-b48c-891adb43ff3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8d3b5acdcf34b2d95bf14961fdbf4df", "srcset": "https://si.imgix.net/df5715b7/uploads/origins/0dee1672-8f52-434f-b48c-891adb43ff3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8d3b5acdcf34b2d95bf14961fdbf4df, https://si.imgix.net/df5715b7/uploads/origins/0dee1672-8f52-434f-b48c-891adb43ff3d?bg=%23fff&aut