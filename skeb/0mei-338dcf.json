=crop&crop=top&w=200&h=200&s=3d9e0909534820de540f0ed65c958255 2x, https://si.imgix.net/9f2027b5/uploads/origins/b8256e65-99f4-45ec-ad0a-0d69ca2bd5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44b93608ef573eb0c759b87e9bcd8b7c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f2027b5/uploads/origins/b8256e65-99f4-45ec-ad0a-0d69ca2bd5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56037e1b077e7f3015c3978779e4e3ac", "srcset": "https://si.imgix.net/9f2027b5/uploads/origins/b8256e65-99f4-45ec-ad0a-0d69ca2bd5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56037e1b077e7f3015c3978779e4e3ac, https://si.imgix.net/9f2027b5/uploads/origins/b8256e65-99f4-45ec-ad0a-0d69ca2bd5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=146bdec2d14738dc1c351aa6f3ee9526 2x, https://si.imgix.net/9f2027b5/uploads/origins/b8256e65-99f4-45ec-ad0a-0d69ca2bd5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a46bfa845c3c4febcf72e7e7aaf46f0b 3x"}, "body": "お世話になっております、mieと申します。\nカオルくんたちやうぞむぞをはじめとしたヤンデレ創作をいつも楽しく拝見しています！\nほーじちゃさんに是非描いていただきたいOCがいますので、依頼させていただきます。\n\n■要望\n資料内の男性の夢絵を描いていただきたいです。\n女性夢主/男性の幼馴染設定だと嬉しいです。\nそれ以外の構図やシチュエーション等はおまかせいたします。\n\n■設定\n緑色の髪と目。スクエア型の眼鏡を身につけている二十歳の大学生。\n全体的にゆったりした服装で、セーターは萌え袖気味です。\nデスゲームの舞台となる仮想空間では緑髪緑目になっていますが、現実世界では黒髪黒目です。\n\nデスゲームに強制参加させられた人たちに紛れこむ黒幕で、ゲーム中は別人を名乗っています。\n幼いころに母親が病に苦しみ、それを善意で隠そうとする父親を兄と幼馴染の夢主と一緒にどうにかしようとしますが、二人とも約束した集合場所にきませんでした。\nそれから母親が亡くなってしまったと勘違いし、約束を破った二人に憎しみを抱き、復讐するためにデスゲームを開きました。\n仮想空間が舞台となっているためループ可能で、何度も二人の絶望する顔を見ています。\n憎しみが強いですが、別人としての自分に優しくする二人やかつての思い出に苦い感情も抱いています。愛憎型ヤンデレ。\n\n夢主のことを、別人のふりをしているときは「ナマエさん(さん付け)」、本性を見せているときは「ナマエ(呼び捨て)」で呼びます。\n\n■用途\n個人的な鑑賞、自サイトやSNS等自創作を載せている場所での共有、個人的な印刷です。\n商用利用はいたしません。\n\nわからないところがありましたら偽造等していただいて構いません。\nご検討いただければ幸いです。\n\nhttps://drive.google.com/drive/folders/1JjBsMWiu0Qn_FANMJY6Lqafgkih1hNLf?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fu2noko_mrm/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2913332, "client_id": 3332065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed1850fe/uploads/origins/b44ceb3c-1ee2-4c25-a66d-b18f2391a3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92fdad7263cd8bfb54f92d54d8ed36bf", "srcset": "https://si.imgix.net/ed1850fe/uploads/origins/b44ceb3c-1ee2-4c25-a66d-b18f2391a3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92fdad7263cd8bfb54f92d54d8ed36bf, https://si.imgix.net/ed1850fe/uploads/origins/b44ceb3c-1ee2-4c25-a66d-b18f2391a3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0001c930fbcb8ce75a38f492be85d3cd 2x, https://si.imgix.net/ed1850fe/uploads/origins/b44ceb3c-1ee2-4c25-a66d-b18f2391a3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12b94428712ac07c45c414f5696f3144 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed1850fe/uploads/origins/b44ceb3c-1ee2-4c25-a66d-b18f2391a3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e01dc08e517aeb2652ecbc198022286", "srcset": "https://si.imgix.net/ed1850fe/uploads/origins/b44ceb3c-1ee2-4c25-a66d-b18f2391a3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e01dc08e517aeb2652ecbc198022286, https://si.imgix.net/ed1850fe/uploads/origins/b44ceb3c-1ee2-4c25-a66d-b18f2391a3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f952951570436aab88dddd827d70af13 2x, https://si.imgix.net/ed1850fe/uploads/origins/b44ceb3c-1ee2-4c25-a66d-b18f2391a3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fi