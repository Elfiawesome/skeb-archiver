わせて声を漏らし口の端からよだれを垂らす。\n足マンをされながら左右にいる男にそれぞれパンコキをしている。\n・パンツを横にずらし後背位でショタに激しくビストンされ喘ぎ声を上げる。（ショタ視点でオルタの全身を見下ろすアングルで）\nオルタの視線の先の壁には何枚もパンツが掲示されている。\n・黒色（レースがあしらわれている）\n・白色（白のレース有）\n・白色（青いリボン有）\n・水色\nモブはその中の一枚の手触りを楽しみながら勃起したペニスにオルタのパンツを被せている。\nショタは更に速度を上げオルタ共々絶頂を迎え中に出されてしまう。\n・後日短パンのみ脱がされショタにパンツの中に手を入れられ手マンをされながら街を歩かされる羞恥プレイをさせられる（モブの一人に胸を揉まれながら耳舐めをする）\nといった内容を漫画形式でお願いしたいです\n\nhttps://www.pixiv.net/artworks/97496550", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zonebell_market/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 865307, "client_id": 1089297, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a49fdf04/uploads/origins/8327799c-6759-49a0-aae0-a33cd9edd8f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21b8819b03f3492f39629d4f9c821bbf", "srcset": "https://si.imgix.net/a49fdf04/uploads/origins/8327799c-6759-49a0-aae0-a33cd9edd8f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21b8819b03f3492f39629d4f9c821bbf, https://si.imgix.net/a49fdf04/uploads/origins/8327799c-6759-49a0-aae0-a33cd9edd8f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=940070e45020cde54c07703d0de8b3e1 2x, https://si.imgix.net/a49fdf04/uploads/origins/8327799c-6759-49a0-aae0-a33cd9edd8f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2185af3b8903e093d6f75ae00fb30581 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a49fdf04/uploads/origins/8327799c-6759-49a0-aae0-a33cd9edd8f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b280c1a8b78cafcab690f8b14f005da", "srcset": "https://si.imgix.net/a49fdf04/uploads/origins/8327799c-6759-49a0-aae0-a33cd9edd8f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b280c1a8b