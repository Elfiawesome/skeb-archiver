弟のイメージは、なかなか可愛いですね。）\n\nもし先生がこの依頼を不適切だとお考えでしたら、遠慮なくキャンセルまたは再送をお願いしてください。私の依頼をご検討いただき、本当にありがとうございます。🙇❣️ ぜひご一緒にお仕事できれば嬉しいです！\n\n【画像の参考】\nhttps://drive.google.com/drive/folders/1q5OSO_gBjlBJzrZeo95juafO-nVfY6zB?usp=drive_link", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@556krddtcom/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3923912, "client_id": 1541063, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8bf6898/uploads/origins/7e6f0b69-c6b2-4789-af09-a40fd51fbc4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8202c3efe109509bc3ff3bbb486dc282", "srcset": "https://si.imgix.net/c8bf6898/uploads/origins/7e6f0b69-c6b2-4789-af09-a40fd51fbc4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8202c3efe109509bc3ff3bbb486dc282, https://si.imgix.net/c8bf6898/uploads/origins/7e6f0b69-c6b2-4789-af09-a40fd51fbc4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=173258747bdf5b7a94d9269afd048882 2x, https://si.imgix.net/c8bf6898/uploads/origins/7e6f0b69-c6b2-4789-af09-a40fd51fbc4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65fedca198a37b8d91f2735bdecba89e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8bf6898/uploads/origins/7e6f0b69-c6b2-4789-af09-a40fd51fbc4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5352b3028f7c54a251bfed72fce3c72", "srcset": "https://si.imgix.net/c8bf6898/uploads/origins/7e6f0b69-c6b2-4789-af09-a40fd51fbc4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5352b3028f7c54a251bfed72fce3c72, https://si.imgix.net/c8bf6898/uploads/origins/7e6f0b69-c6b2-4789-af09-a40fd51fbc4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s