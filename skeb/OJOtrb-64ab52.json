\n・首絞め中、鈍く重量のある締め付け効果音あり。\n・首絞め中、苦しみながらもまだ諦めない等の心の声あり。\n・汗、涙、涎、吐息をできればお願いします。\n・筋肉と表情はお任せします。\n\n\n（以下は文章にしにくい為、他者様の作品を参照します。申し訳ありません。）\n\n・首絞めは↓の２枚目に近い感じでお願いします。アングルはお任せします。\nhttps://www.pixiv.net/artworks/55667404", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OJOtrb/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 82486, "client_id": 187209, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f36f625/uploads/origins/425b7118-c963-41c0-bb4e-8b74eb49f408?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=655f6549e0ac1ceaa44722520295494e", "srcset": "https://si.imgix.net/5f36f625/uploads/origins/425b7118-c963-41c0-bb4e-8b74eb49f408?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=655f6549e0ac1ceaa44722520295494e, https://si.imgix.net/5f36f625/uploads/origins/425b7118-c963-41c0-bb4e-8b74eb49f408?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adfbd2cbaa0fc72ad0d9dbe04b3f05ac 2x, https://si.imgix.net/5f36f625/uploads/origins/425b7118-c963-41c0-bb4e-8b74eb49f408?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76ecaa27b6ede4dd0d779a6d74b196a5 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5f36f625/uploads/origins/425b7118-c963-41c0-bb4e-8b74eb49f408?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbcb2d6bfe2205142d2c9fd898d65734", "srcset": "https://si.imgix.net/5f36f625/uploads/origins/425b7118-c963-41c0-bb4e-8b74eb49f408?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbcb2d6bfe2205142d2c9fd898d65734, https://si.imgix.net/5f36f625/uploads/origins/425b7118-c963-41c0-bb4e-8b74eb49f408?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8268bdd79d6e6496a