t/1dfc288b/uploads/origins/f5279ba8-35db-41b4-ad1f-af96ec6e15fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bfa6799ccc636d3fc048e2cc0dec6b1", "srcset": "https://si.imgix.net/1dfc288b/uploads/origins/f5279ba8-35db-41b4-ad1f-af96ec6e15fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bfa6799ccc636d3fc048e2cc0dec6b1, https://si.imgix.net/1dfc288b/uploads/origins/f5279ba8-35db-41b4-ad1f-af96ec6e15fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a8172625834e2ecd32a8e55bbe490d4 2x, https://si.imgix.net/1dfc288b/uploads/origins/f5279ba8-35db-41b4-ad1f-af96ec6e15fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=522a056496c798d2697116ad9bd4f4a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1dfc288b/uploads/origins/f5279ba8-35db-41b4-ad1f-af96ec6e15fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb7f897591cfc23902ec38a418fb45de", "srcset": "https://si.imgix.net/1dfc288b/uploads/origins/f5279ba8-35db-41b4-ad1f-af96ec6e15fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb7f897591cfc23902ec38a418fb45de, https://si.imgix.net/1dfc288b/uploads/origins/f5279ba8-35db-41b4-ad1f-af96ec6e15fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c95ae7d5c1eeb1332e4510ed503dac80 2x, https://si.imgix.net/1dfc288b/uploads/origins/f5279ba8-35db-41b4-ad1f-af96ec6e15fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bce57d78382c632106c1020e29220c4c 3x"}, "body": "今回の依頼ですけど、\n前回は【僕が仮面ライダーシリーズの中で一番好きなラスボス】という流れで\n石動惣一（エボルト）/仮面ライダーエボル\nを描いていただきましたが、\n\n今回は以下の内容でお願いします\n⚫️概要\nあれ以降BLACK SUN &シンも見終えて、仮面ライダーシリーズは一通り全部見終わってるんですが、\n僕がライダーシリーズの最終回で特に気に入ってるのは\n『ブレイド、オーズ、アマゾンズseason2』\nの3つです。\nなのでこの絵を描いて下さい↓\n⚫️内容\n仮面ライダーアマゾンズseason2の最終回で、\n劇中最後の変身をした千翼が、変身した悠＆仁に飛びかかるシーンがありますよね？（最終回次回予告にも使われてるシーンです）\nあの場面の千翼を描いて下さい\n⚫️詳細\n・そのまま飛びかかってるポーズで\n・前回のエボルトのイラストと同様\n【変身前後の姿が混じった状態】で描いて下さい\n・千翼は全身血まみれでボロボロの姿で\n・変身前後の混ざり具合は今回は特に考えてないので任せます。\n・千翼の表情は気迫のこもった顔にして下さい", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kageshuu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1172271, "client_id": 458845, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5482a892/uploads/origins/39feec26-cc36-4e77-aac6-401b878152e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1083bb775a7003d26a9663aaa3ea76f0", "srcset": "https://si.imgix.net/5482a892/uploads/origins/39feec26-cc36-4e77-aac6-401b878152e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1083bb775a7003d26a9663aaa3ea76f0, https://si.imgix.net/5482a892/uploads/origins/39feec26-cc36-4e77-aac6-401b878152e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f1e68bb632b3482660e113f3d6d4d28 2x, https://si.imgix.net/5482a892/uploads/origins/39feec26-cc36-4e77-aac6-401b878152e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61d37bcb06c01798f52e80d2c7888bbd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5482a892/uploads/origins/39feec26-cc36-4e77-aac6-401b878152e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a06f057a62d38eea4dfcc1d5faad1c39", "srcset": "https://si.imgix.net/5482a892/uploads/origins/39feec26-cc36-4e77-aac6-401b878152e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a06f057a62d38eea4dfcc1d5faad1c39, https://si.imgix.net/5482a892/uploads/origins/39feec26-cc36-4e77-aac6-401b878152e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e7d2101f7d2233cea1233b92c613ffc 2x, https://si.imgix.net/5482a892/uploads/origins/39feec26-cc36-4e77-aac6-401b878152e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=80e3d8128868476f75ef7caa7300c249 3x"}, "body": "依頼ですけど僕は現時点で仮面ライダーシリーズは、BLACK SUN以外一通り見てるんですけど、個人的に一番好きなライダーシリーズのラスボスは\n「エボルト」\nなので、以下の内容をお願いします。\n●内容\n仮面ライダーエボルの変身ポーズである\n「腕を広げたポーズ」をとる\n「腰にエボルドライバー（ブラックホールフォームの組み合わせ）」を巻いた\n石動惣一を描いて下さい\n\n●絵の詳細\n変身前後の姿があるキャラの絵を描く際の演出でよくある\n【変身前後の姿がところどころ混ざった姿】\nで描いて下さい\n\nビルドのライダーなので\n①左頭部・右上半身・左下半身が石動惣一\n②右頭部・左上半身・右下半身が仮面ライダーエボル ブラックホールフォーム\n\nの状態で描いて下さい", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kageshuu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1172271, "client_id": 470295, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8de37d99/uploads/origins/c9501e7e-8b51-481a-8d62-f1d350c8101e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10fb2e84fbd26281da9f110396998e25", "srcset": "https://si.imgix.net/8de37d99/uploads/origins/c9501e7e-8b51-481a-8d62-f1d350c8101e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10fb2e84fbd26281da9f110396998e25, https://si.imgix.net/8de37d99/uploads/origins/c9501e7e-8b51-481a-8d62-f1d350c8101e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d724f023c4d5aa2be10fa9e8e25bcf19 2x, https://si.imgix.net/8de37d99/uploads/origins/c9501e7e-8b51-481a-8d62-f1d350c8101e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a53b4c521fdb2175093d798ee108d06 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8de37d99/uploads/origins/c9501e7e-8b51-481a-8d62-f1d350c8101e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d87b5a694ef7647b0fc7d09aee1d39a", "srcset": "https://si.imgix.net/8de37d99/uploads/origins/c9501e7e-8b51-481a-8d62-f1d350c8101e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d87b5a694ef7647b0fc7d09aee1d39a, https://si.imgix.net/8de37d99/uploads/origins/c9501e7e-8b51-481a-8d62-f1d350c8101e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=34644f8d8bf85cb9c8fcfb01b9dbd268 2x, https://si.imgix.net/8de37d99/uploads/origins/c9501e7e-8b51-481a-8d62-f1d350c8101e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8eb248ad8ae685a9b83e1664352b21dd 3x"}, "body": "リクエスト失礼致します。\n\n『サイコアゲンスト』より「黒崎レオン」と「ブラドミア・ペトロフ」のコンビ絵を描いていただきたいです。\n\n◆シチュエーション\n冬の昼頃の街角。エリスちゃん、メアさん、リーシャちゃん、マヤちゃんとお出かけしてて、お会計中の皆を店の外で(多分店の中身がめっちゃガーリーでいたたまれなくなったブラッドがレオンを伴って外に出た感じ)待ってる間の他愛ないけど愉快な立ち話中。大声で会話している訳ではなく小さめの声で喋ってる感じなのでブラッドがレオンの肩に腕を置いて寄りかかりながら、「その時エリスが…」「マジかよww」みたいな緩い会話をしている、和やかな雰囲気。\n差分が可能でしたら「①雑談中」「②こちら側に気づく」「③こちら側に笑いかける」という流れの三枚をお願い致します。\n\n◆服装\n冬なので、二人とも服装はラフだけど厚着気味で。小物の指定が可能でしたらブラッドにはタバコを持っていて欲しいです。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kageshuu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1172271, "client_id": 458845, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b955e5f0/uploads/origins/c094cf91-b3b6-4b9c-b381-85465e4a59be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8502a2231c2412122772516ee0cb5a86", "srcset": "https://si.imgix.net/b955e5f0/uploads/origins/c094cf91-b3b6-4b9c-b381-85465e4a59be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8502a2231c2412122772516ee0cb5a86, https://si.imgix.net/b955e5f0/uploads/origins/c094cf91-b3b6-4b9c-b381-85465e4a59be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98596b4d13dc0d5abb163133de1619b0 2x, https://si.imgix.net/b955e5f0/uploads/origins/c094cf91-b3b6-4b9c-b381-85465e4a59be?bg=%23ff