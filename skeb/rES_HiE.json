.imgix.net/0a18a021/uploads/origins/0b1c2132-321a-4401-9d4f-e350fefede80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=393bfe867c2ba6752797f81e42b28451", "src_set": ""}, "body": "れすひさんのイラストが千円…？千円…！！！？？？\nと、滅茶苦茶吃驚しながら、お久しぶりです。帽子猫と申します\nもしも枠が空いていて、都合が合いましたら受けてくださると嬉しいです\n\n■使用用途とざっくりとしたイメージ\nTRPGで使うので、全身立ち絵をお願いいたします。\nAIで作成した大まかなイメージを添付いたしますので参考にしていただければ幸いです\n\n■依頼内容\nミディアムヘアーで金髪金眼、それに帽子をかぶっていて表情は明るい感でお願いします。\n服装に関しては大体の色味があってれば細かい装飾は書かなくても大丈夫です。\nただ、以前の依頼でも申しましたように、れすひさんの描く、肌の質感がほんっとうに性癖なので\nシャツがちょっとあいてて、ブラジャーと谷間が見えている部分、\n太ももにあるガーターベルト（右にある何か謎に垂れてるのは無視してください）\nあと、おへそも見えている部分も書いてくれるととても嬉しいです。\n\nお忙しいかと思いますが、もしよろしければご検討いただければ嬉しく思います。\n\nhttps://www.dropbox.com/scl/fi/g7qnx0pvej1nqt4we5ln8/c523c7d8-f398-4b1d-af48-48cf5874c929.png?rlkey=d7n60kw90rm6wvp7vptrxqweg&st=re4ej9n4&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rES_HiE/works/31", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/34f388b2/uploads/origins/6e604ccf-68ff-4c84-a379-2aa4398d7663?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b00a1705a6cb2df63ded65608ad37331", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1979720, "client_id": 466509, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@rES_HiE/works/30", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/81410306/uploads/origins/591caaf8-cda0-43f7-8aa3-7430811613c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=87b0d6cf1b810ab9e693534694054e9b", "src_set": ""}, "private": t