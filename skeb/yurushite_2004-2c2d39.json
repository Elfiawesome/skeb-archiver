現が大好きです。特に赤い瞳が好きなので、もし可能であれば「赤い瞳の差分」をいただけると非常に嬉しいです。\n\n資料としてイメージに近い画像を添付いたしますが、あくまで参考ですので、先生の自由な解釈で描いていただければ幸いです。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://imgur.com/a/V3RxBDR", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yurushite_2004/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3776071, "client_id": 2679960, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e47ce6ef/uploads/origins/c2d6e9a2-5f10-4c86-bd16-80301d94448c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81372f83308100b8e1b9ed4f96241b90", "srcset": "https://si.imgix.net/e47ce6ef/uploads/origins/c2d6e9a2-5f10-4c86-bd16-80301d94448c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81372f83308100b8e1b9ed4f96241b90, https://si.imgix.net/e47ce6ef/uploads/origins/c2d6e9a2-5f10-4c86-bd16-80301d94448c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=822ffc4e81b1b66de3c3ac5b3d4d3f81 2x, https://si.imgix.net/e47ce6ef/uploads/origins/c2d6e9a2-5f10-4c86-bd16-80301d94448c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c41eaf4cb21886514b9566394986a53 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e47ce6ef/uploads/origins/c2d6e9a2-5f10-4c86-bd16-80301d94448c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e051086074ffc8fdfa8d813bef7d57cd", "srcset": "https://si.imgix.net/e47ce6ef/uploads/origins/c2d6e9a2-5f10-4c86-bd16-80301d94448c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e051086074ffc8fdfa8d813bef7d57cd, https://si.imgix.net/e47ce6ef/uploads/origins/c2d6e9a2-5f10-4c86-bd16-80301d94448c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5d8bbcf6cc442c4eb5e2adaff3e6b267 2x, https://si.im