54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4842f2ccfb5652214f73a022d4d6b571, https://si.imgix.net/d0db5b24/uploads/origins/f1b742e3-6c8f-409e-8a26-173b3b48cc54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=692d6b093124f13742862203d2ba5024 2x, https://si.imgix.net/d0db5b24/uploads/origins/f1b742e3-6c8f-409e-8a26-173b3b48cc54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4cd61319aa9860d57d2780cc10160789 3x"}, "body": "ほずみや様\nはじめまして、サニーと申します。\n\nほずみや様へのリクエストのお願いになります。\n以下リクエストの詳細を記載させていただきます。\n\n【内容】\nVTuber葉竜 らぷるさんの1枚絵\n過去に描かれていた体操服（ブルマ）のイラストが素晴らしかったので今回もぜひお願いしたいです\n構図等お任せしますが雰囲気は元気な感じが良いです\n\n\n【使用用途】\nSNSでの利用(アイコン、ヘッダー等)、YouTube動画内及びサムネイルでの利用。\n※ご本人がイラストを上記目的で利用することもあります。\n\n【お願い】\n頭部が切れていないキャラクターのみの透過データ(もしくはPSD)を合わせていただけますでしょうか。\n合わせて字幕などついていないイラストのみのデータもいただけると大変助かります。\n\nhttps://twitter.com/YouryuRapuru33/status/1693215803058049078", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hozumi8_1/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 146516, "client_id": 2157708, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66506573/uploads/origins/707577e1-9247-4319-a078-8efe06bb6d02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df706ee4e4b4817b8b901f117a0b2faf", "srcset": "https://si.imgix.net/66506573/uploads/origins/707577e1-9247-4319-a078-8efe06bb6d02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df706ee4e4b4817b8b901f117a0b2faf, https://si.imgix.net/66506573/uploads/origins/707577e1-9247-4319-a078-8efe06bb6d02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60a10658e2ee75965e6225cbedb47846 2x, https://si.imgix.net/66506573/uploads/origins/707577e1-9247-4319-a078-8efe06bb6d02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35937f38981ad0aa5a197de0f31c436e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66506573/uploads/origins/707577e1-9247-4319-a078-8efe06bb6d02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d794b247ce6f7d8cf39cdc8464cb2eed", "srcset": "https://si.imgix.net/66506573/uploads/origins/707577e1-9247-4319-a078-8efe06bb6d02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d794b247ce6f7d8cf39cdc8464cb2eed, https://si.imgix.net/66506573/uploads/origins/707577e1-9247-4319-a078-8efe06bb6d02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b3a65e8f751e68eaf3eb505ff1775906 2x, https://si.imgix.net/66506573/uploads/origins/707577e1-9247-4319-a078-8efe06bb6d02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=22fa9c4845f2943e7c577e2b8963b025 3x"}, "body": "リクエスト失礼いたします。\n先日ぽっちゃりエルフを描いていただいた者です。\nその節は素敵なイラストを描いてくださり、本当にありがとうございました！\nよろしければまたイラストを描いていただきたく思い、リクエストさせていただきます。\n\nお願いしたい内容は別のクライアントさんとのコラボイラストで、バレンタインをイメージした作品になります。(クライアントさんの許可は取っています)\nKi72ki33さん(@shixivsawa)のオリジナルキャラクターの酒エルフことトーコさんと、以前描いていただいたぽっちゃりエルフことうちのマルレーヌがバレンタイン用にウイスキーボンボンを作っているシチュエーションをお願いします。\nウイスキーボンボンを作っている最中なのですが、マルレーヌは材料のチョコレートのつまみ食いが止まらない様子だし、トーコさんも材料のウイスキーを飲んでいてほろ酔いのいい気分になってしまっているしで、「本当にチョコレートは完成するのか？」と思ってしまうような、ちょっぴりコミカルなイメージにしていただきたいです。\n不明な点などございましたら、その箇所はお任せいたします。\nまた、それぞれのキャラクターの資料は末尾に記載しています。\n\nご確認いただく内容が多くてお手数おかけします。\nご多忙の場合はお気軽にキャンセルいただいても大丈夫ですので、ご検討いただけると幸いです。\nそれでは、どうか何卒よろしくお願い致します。\n\n・トーコ＝ティアーロウさん\nhttps://skeb.jp/@tsukimori_koto/works/19\nhttps://skeb.jp/@kfssrnikyr/works/3\n\n・マルレーヌ\n三面図：https://i.imgur.com/XIearkT.jpg\nバストアップ：https://i.imgur.com/yg4ThoQ.jpg\n3Dモデル：https://hub.vroid.com/characters/6436749062066804628/models/1540537871771610634", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": 