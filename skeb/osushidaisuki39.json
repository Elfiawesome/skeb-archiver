yearly_report_client_visible": false, "total_appeals_count": 5, "received_works": [{"path": "/@osushidaisuki39/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f796c75/uploads/origins/dd6d8515-1690-498c-958b-249df90435a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8b81a23448bade600fe09cdcd0f8162", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f796c75/uploads/origins/dd6d8515-1690-498c-958b-249df90435a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a17ac0d72b13cf3f7d11d69d246a61e6", "src_set": ""}, "body": "猫宮さえか先生！\n特別繋がりということで一つリクエストします！\n\n男の子が無数の超乳妖精さんに全身をおっぱいで癒してもらうシチュをお願いします。\n超乳妖精さんは非常に小柄で、男の子は一人のみで全身くまなくおっぱいまみれで押し付けられる構図を希望です。\n（過去に出した体格差シチュを基準にしていただけると幸いです）\n\nよろしければ2人の妖精さんが小柄ながらでっかい超乳で、男の子の顔を左右からぱふぱふしてあげるシチュがあるともっと嬉しいです。\nこちらが参考となる構図となりますので、よろしくお願いします。\n\n超乳妖精さんベース\nhttps://skeb.jp/@osushidaisuki39/works/7\n\n男の子ハーレムシチュ参考例\nhttps://skeb.jp/@osushidaisuki39/works/12\n\n体格差イメージ\nhttps://skeb.jp/@osushidaisuki39/works/4", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osushidaisuki39/works/27", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/36062d03/uploads/origins/ff8720ba-0e0e-40b3-9ad5-3ccf89ad257b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f908006d267505b8d47c28a2df0dee33", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 4497, "client_id": 92768, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@osushidaisuki39/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8baf47a6/uploads/origins/ed530a07-6e24-4037-a419-580f212b5c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c32dff0cdcdff4b7635aa33a477e7d67", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8baf47a6/uploads/origins/ed530a07-6e24-4037-a419-580f212b5c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5afe1f209c550e12b8930f9c4617e1a", "src_set": ""}, "body": "こんばんは。\n手数料無料期間と聞いて一つリクエストさせていただきます。\n\nプールと一体化した巨大スライム娘が男の子達を自身の身体を使って戯れてるシチュをお願いします。\n\nイメージとしては、男の子達が高い飛び込み台からスライム娘の豊満なおっぱい目掛けてダイブし、体内で気持ちよさそうに泳いだり浮かんだりしてる内容となります。\nよろしければ、スライム娘はおっぱいを差し出すように持ち上げ、一人の男の子はおっぱいの谷間に挟まってむにゅむにゅぱふぱふっと感触を味わいながら体内に入り込もうとしてるシチュもあると嬉しいです。\n\n昔受けたこちらを参考に https://skeb.jp/@osushidaisuki39/works/4\n\n全体イメージ資料はこちらになりますので、よろしくお願いします。\n\nhttps://www.pixiv.net/artworks/127139572", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osushidaisuki39/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e0cecf1/uploads/origins/9176c0af-554d-4826-8322-c20b63fd32ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b2dc3823137d0324a6ee45e6c57df35", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e0cecf1/uploads/origins/9176c0af-554d-4826-8322-c20b63fd32ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ba45984046736beef2c72fcdcf040b0", "src_set": ""}, "body": "猫宮さえか様、本格復帰＆自分も誕生日月ということでリクエストさせていただきます。\n\n真っ白のミルククリームでできた爆乳スライム娘の極上ぱふぱふをお願いします。\n一人称視点でスライム娘がトロトロの爆乳を押し付けてぱふぱふしてるシチュとなります。\nよろしければ爆乳が画面いっぱいになるくらい押し付けて、爆乳がドアップで映るシーンもあると嬉しいです。\n\nこちらに参考資料を載せておきますので、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1jZKFiNmwREUHj2cwgVTVYioShMYt8B-z?usp=sharing", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osushidaisuki39/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31def8b4/uploads/origins/62b4716a-8bd6-45ce-852a-eb77742d8bac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f18b7ea909dd8e6ab3c9d035a2faa51a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31def8b4/uploads/origins/62b4716a-8bd6-45ce-852a-eb77742d8bac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=987ccd5cb4033636a9c2861c9f3fbcee", "src_set": ""}, "body": "こんにちは。\nスライム娘ちゃんのひんやりシチュが恋しくなってきたのでリクエストさせていただきます。\nスライム娘ちゃん達と一緒に戯れる男の子達をお願いします。\n\nイメージとしては水っぽいスライム空間の中であらゆる場所からスライム娘ちゃん達が出てきて、男の子達とスキンシップしてるシーンを希望です。\n\nよろしければ、メインスライム娘はご案内役、壁側スライムはぱふぱふ、天井スライムは垂れ乳揉み揉み、床スライムは乳枕でスキンシップしてるシーンにしていただけると嬉しいです。\n\nこちらに資料を載せておきますので、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1NRzgq5ERezAtI9KXZykiMa2PyHcYkMLw?usp=sharing", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osushidaisuki39/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1dfd1b00/uploads/origins/7a1f04b8-e7ca-4884-b712-ef50f8ce5f79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14125568e81687df56c9ceb306c5bcde", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1dfd1b00/uploads/origins/7a1f04b8-e7ca-4884-b712-ef50f8ce5f79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62003450a83db312e4483ada14aa34d8", "src_set": ""}, "body": "お久しぶりです！\nまたまた超特殊なシチュになりますがよろしいでしょうか。\n\nフェロモンガスが出る体質を持つ巨尻の女の子が、\n好きな男の子に魅惑のガスを嗅がせてあげる\nシチュをお願いします。\n\n女の子はむっちりした生のお尻を男の子に差し出して、\n至近距離でフェロモンガスを「ぷぅ～」っと放出。\n男の子はお尻から至近距離でフェロモンガスを吸って、\n興奮しながらその匂いを嗅いでいる。\nといった流れを希望です。\n\nこちらに資料を用意していますので、\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1qJ1sfGUjr9WOUSWPeWmOazt1zFkNkJvD?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osushidaisuki39/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 3110377, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/496755dc/uploads/origins/3a068e38-cd3d-4e02-a3a5-c5a4edc6c806?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa95ce62a709579abaa01837c6117d76", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/496755dc/uploads/origins/3a068e38-cd3d-4e02-a3a5-c5a4edc6c806?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c8eb293ed69be6cdea8d31409805fc1", "src_set": ""}, "body": "自キャラを書いて下さい！\n\nhttps://x.com/panchancafe/status/1755541420201615521?s=46&t=CaKy7cZDJDJq5dO8wpaY6g", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osushidaisuki39/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/99005dc1/uploads/origins/5db531c6-a5dd-4385-8007-94aa6a232d20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dd3293632eedb88795f1ff21a69da64", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99005dc1/uploads/origins/5db531c6-a5dd-4385-8007-94aa6a232d20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15cfa0bf6c3c9d38eb7397d4af67bff0", "src_set": ""}, "body": "こんばんは。\n無料期間ということで、一つリクエストさせていただきます。\n\nショタっ子が双子の超乳スライム娘に挟まれてるシチュをお願いします。\nスライム娘の体色はどちらも肌色で、ショタっ子を左右から超乳を押し付けて全身を包み込んでいる状態を希望です。\nショタっ子は顔だけが谷間から出ていて、正面向きで幸せそうな顔をしている表情でお願いします。\n\nこちらにいくつか資料を載せておきますので、よろしくお願いします。\n\nスライム娘・肌色サンプル＆ショタっ子表情\nhttps://skeb.jp/@Chemi_Camb/works/1\n\n双子スライム娘・ショタっ子挟み例その1\nhttps://www.pixiv.net/artworks/59778947\n\n双子スライム娘・ショタっ子挟み例その2\nhttps://www.pixiv.net/artworks/82977145", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osushidaisuki39/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/371da91a/uploads/origins/643eced5-abf1-4d29-bef4-52ec3144cff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4713c1c649c14c1e6ed7ab0e5818d98", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/371da91a/uploads/origins/643eced5-abf1-4d29-bef4-52ec3144cff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9913aa01a3561de61ba42f0aba42d87", "src_set": ""}, "body": "こんばんは。\n今回は特殊交じりの違った内容になりますがよろしいでしょうか。\n\nショタ勇者が今度は凄く大きい巨尻を持つ妖精さんにむっちりお尻を揉んで癒してもらうシチュをお願いします。\n構図は以前の妖精さんに癒してもらうシチュをベースに、巨尻妖精さんがお尻を突き出して揉ませてあげてるシーンを希望です。\nPSD差分としてお尻の谷間に顔を埋めてお尻ぱふぱふしてるシーンと、顔を埋めてるショタ勇者に悪戯でおならを「ぷぅ～♡」っと浴びせてるシーンも希望です。\n\nこちらに一通り入った資料を載せておきますので、よろしくお願いします。\n\nベース・妖精さんに癒してもらうショタ勇者\nhttps://skeb.jp/@osushidaisuki39/works/7\n\nお尻ぱふぱふイメージ＆巨尻妖精さん資料\n（妖精さんは右側希望）\nhttps://drive.google.com/drive/folders/1QruM3PEA5MZIrDtrv-fODZ5P0z0wnSHD?usp=sharing", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osushidaisuki39/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4cac79e1/uploads/origins/69013fe4-9b1a-4665-8644-0d9648485d18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44529793e34e9ac226e28bc474246c5d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4cac79e1/uploads/origins/69013fe4-9b1a-4665-8644-0d9648485d18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b54655aaade802e8e906866a356f86f", "src_set": ""}, "body": "こんにちは。\n特別な月ということで、自分もお願いしてもよろしいでしょうか。\n\n以下の資料にあるホイップクリームでできたスライム娘ちゃんが巨大化して、ショタっ子達においしくいただいてもらうシチュをお願いします。\n\n構図は以前依頼した巨大スライム娘がうつ伏せになって生の爆乳を差し出すように強調してるポーズで、ショタっ子達が周りでペロペロと舐めたりしてるシチュを希望です。\nよろしければショタっ子達の中に巨大爆乳に興味津々で、おいしそうに爆乳へチュっと吸い付いたり、谷間に埋もれてぱふぱふしたりしてる子達を入れていただけると嬉しいです。\n\nこちらに資料を載せておきますので、よろしくお願いします。\n\nホイップクリーム娘ちゃん\nhttps://drive.google.com/drive/folders/1gawpihoydKJ-IErkzRHW1M1tRiQirZxb?usp=sharing\n\nベースとなる構図（以前依頼した巨大スライム娘ちゃんその1）\nhttps://skeb.jp/@osushidaisuki39/works/4", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osushidaisuki39/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9932d467/uploads/origins/045d03a8-7bb2-4bea-96d9-3c08c153d1ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5812145d108085833a1dce6f156ea7fc", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9932d467/uploads/origins/045d03a8-7bb2-4bea-96d9-3c08c153d1ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69cb724d6c6e0a55fc457fa0a6c3c8c1", "src_set": ""}, "body": "復帰したと聞きましたので、リハビリがてら一つリクエストさせていただきます。\n\nロリ巨乳スライム娘達がいっぱいいるプールでおっぱいを堪能しているショタっ子達をお願いします。\n以前依頼しましたスライム娘プールのアレンジしたものを希望です。\n\nよろしければ以前より視点をやや遠目で、ショタっ子が嬉しそうに巨乳を揉み揉みしたり、両方の人差し指で巨乳をぷにゅっと突いてスライム娘がいやんと恥ずかしがったり、うっとりしながら巨乳に顔を埋めてぱふぱふしてるシチュがあると嬉しいです。\n\nこちらに資料を載せておきますので、よろしくお願いします。\n\nスライム娘プール（ベースとなる以前の依頼分）\nhttps://skeb.jp/@osushidaisuki39/works/8\n\nおっぱい指突き資料\nhttps://drive.google.com/drive/folders/1lEauHft1AWL3hx3ZELEeaXrZt8oJ4W51?usp=sharing", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osushidaisuki39/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d53a01a0/uploads/origins/b5bd7b50-b22a-46cd-a316-581e13fc2a38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26cb1317ebe2b7251f15b0c70f374e99", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d53a01a0/uploads/origins/b5bd7b50-b22a-46cd-a316-581e13fc2a38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c833dcb29b99475593afdb40c20508e3", "src_set": ""}, "body": "こんばんは。\nお忙しい中ではありますが、リクエストしてもよろしいでしょうか。\n\n以前依頼した巨大スライム娘とショタっ子達の別バージョンをお願いします。\n今回は巨大スライム娘が上向き状態で、爆乳をむぎゅっとしながらショタっ子達を優しく包み込んであげる感じのシチュを希望です。\nショタっ子達は豊満な爆乳の上で遊んだり、おっぱいの感触にうっとりしたり、谷間に埋もれてぱふぱふしたりして楽しく堪能してる子達を入れていただけると嬉しいです。\n\nこちらにいくつか資料を載せておきますので、よろしくお願いします。\n\n前回の依頼分\nhttps://skeb.jp/@osushidaisuki39/works/4\n\n巨大スライム娘・全体図参考資料\nhttps://www.pixiv.net/artworks/95633552\n\n巨大娘＆小人達・体格差比較参考資料\nhttps://www.pixiv.net/artworks/105402098", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osushidaisuki39/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c4bcaea/uploads/origins/8417a9a0-f26a-4ca0-99df-a0f0f9448dac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76b4cd3a8741d5a91b1a3b554474551b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c4bcaea/uploads/origins/8417a9a0-f26a-4ca0-99df-a0f0f9448dac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95ae6c934fefe0fcc5191163174a99a4", "src_set": ""}, "body": "こんばんは。\n無料期間ということで一つお願いしてもよろしいでしょうか。\n\nチョコレートでできたスライム娘2人がショタっ子達に\nトロトロボディをおいしく頂かれてるシチュをお願いします。\n\nスライム娘は茶色と白色のチョコレートでロリ巨乳、\n全体的にトロトロとした甘い身体を希望です。\nシチュはショタっ子2人がそれぞれおっぱいの谷間に埋もれて\nぱふぱふしながらチョコおっぱいをなめてるシーンを希望です。\n\n構図としては以前依頼したスライムちゃんぎゅうぎゅう詰めの\n左右にいるぱふぱふしてるショタっ子を基準に\nおいしそうにぺろぺろしてるシーンにしていただけると嬉しいです。\n\nこちらにいくつか資料を載せておきますので、よろしくお願いします。\n\nチョコレートのスライム娘・茶色＆白色\nhttps://www.pixiv.net/artworks/87830331\n\n過去のスラ娘ぎゅうぎゅう詰め（ショタっ子ぱふぱふ資料）\nhttps://skeb.jp/@osushidaisuki39/works/8\n\nショタっ子谷間ぺろぺろ資料\nhttps://skeb.jp/@__mitsukami/works/24\n\nhttps://skeb.jp/@hakua_hanging/works/12", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osushidaisuki39/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b033545/uploads/origins/4b9a08d7-b7ef-4a73-9ee0-743b2baffa85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4263945eb2d4908c5300c12f8a956b07", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b033545/uploads/origins/4b9a08d7-b7ef-4a73-9ee0-743b2baffa85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fedf946d140a707329c0b9863082587", "src_set": ""}, "body": "こんばんは。\n今回は版権もので一番のお気に入りキャラをお願いしてよいでしょうか。\n\nモンスター娘TDに登場するスライム娘のリンちゃんをお願いします。\n容姿はロリ巨乳のスライム娘で、ツインテール風の髪型に丸い円形の髪留め、その周りには土星の輪のような模様と妖精の羽っぽいものが左右に付いています。\n\nシチュは超乳に変化した生おっぱいで誘うような感じを希望です。（資料3枚目の超乳版みたいな感じ）\n差分として興奮状態で目がハートになってるバージョンもあるともっと嬉しいです。\n（資料5枚目参照）\n\n版権ものが無理そうでしたらキャンセルでも結構です。\nこちらに資料を載せておきますので、よろしくお願いします。\n\nスライム娘リン・公式立ち絵\nhttps://www.pixiv.net/artworks/102439017\n\nスライム娘リン・各種資料\nhttps://drive.google.com/drive/folders/1Kv4JIUdeZk9P0LQ_2Oltj6eTPdZXcda4?usp=sharing", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osushidaisuki39/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad602a20/uploads/origins/532fce6c-877d-46c3-9006-b0f86a77cfa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32c38177448ef41961d89bab83f945da", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad602a20/uploads/origins/532fce6c-877d-46c3-9006-b0f86a77cfa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbb6b4f9175b33741729532c0e5f951f", "src_set": ""}, "body": "こんばんは、いつもお世話になってます。\n今回はかなり特殊になりますがよろしいでしょうか。\n\n某エイプリルフール企画・にぎりっぺ！恋のカップケーキに登場するおなら娘達をお願いしてもよろしいでしょうか。\n\nシチュはそれぞれ可愛いおならをして個性的な香りが漂う構図で、\n香りのイメージはストロベリー・レモン・ミントといった感じのおなら表現を希望です。（公式資料と香りイメージ画像参照）\n背景はおおまかにお花をイメージしたものにしていただけると嬉しいです。（図解漫画1密ラストコマ参照）\n可能でしたらおならなし・おならあり（香りのみ）・おならあり（香り＆擬音あり）のレイヤー差分があると嬉しいです。\n\nもし抵抗があるようでしたらキャンセルでもOKです。\n下記に資料を載せておきますので、よろしくお願いします。\n\nにぎりっぺ！公式\nhttp://www.maybesoft.jp/cupcake/\n\nにぎりっぺ！イメージ資料\nhttps://drive.google.com/drive/folders/1-1stZX0_fkj-qv3yGSCKj1GiR9Wy4Ysu", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osushidaisuki39/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bda6a3b0/uploads/origins/a98a84c0-9838-460d-97b1-125a65469fff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35aea2f73165c76eba0f8e50055b9431", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bda6a3b0/uploads/origins/a98a84c0-9838-460d-97b1-125a65469fff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fb412efe909e50b67396310e235f2f7", "src_set": ""}, "body": "こんばんは。\n凄く今更感になりますがうちの子達を\nお願いしてもよろしいでしょうか。\n\nうちの子のファローラとシャイナをお願いします。\nファローラは悪戯っ子な感じのロリ巨乳の妖精で、\nシャイナはちょっと奥手な爆乳の幽霊娘です。\n（ファローラの翼は省略してもOKです）\n\n構図は乳合わせをしながらカメラ目線で\nアピールしてる感じでお願いします。\nよろしければツイッターのアイコンなどに使えるような\nちびキャラ差分も描いていただけると嬉しいです。\n（アクキーのようなむちむちぷにぷにな感じ）\nこちらに資料も載せておきますのでよろしくお願いします。\n\nファローラ（元イラスト）\nhttps://www.pixiv.net/artworks/53257423\n\nファローラ（ゲーム用デザイン）\nhttps://www.deviantart.com/fenet105/art/Farora-930301278\n\nシャイナ（元イラスト）\nhttps://www.pixiv.net/artworks/51838260\n\nシャイナ（ゲーム用デザイン）\nhttps://www.deviantart.com/fenet105/art/Shyna-930301276\n\n構図例\nhttps://skeb.jp/@crescent_D/works/15", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osushidaisuki39/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ce30e78/uploads/origins/03232912-498c-4b68-a41f-2bba9ea5db9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebbc3d23e83ee0a6f26d713046a81acb", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ce30e78/uploads/origins/03232912-498c-4b68-a41f-2bba9ea5db9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59bbb0451e15483e2b41d11c9caa4c5c", "src_set": ""}, "body": "こんばんは。\n暑い夏にぴったりなスライム娘ちゃんの甘いプレイを\nリクエストさせていただきます。\n\nショタっ子がスライム娘達におっぱいで全身を\n綺麗に洗ってもらうシチュをお願いします。\nイメージとしては爆乳のお姉さんスライムが後ろから顔を挟んでぱふぱふしてあげて、無数のロリ巨乳スライム娘がおっぱいをスポンジのようにぐにゅぐにゅっと全身を洗ってあげてるシチュを希望です。\nできればショタっ子の両手は広げていて、手先はロリ巨乳スライム娘のおっぱいを揉んでいる感じにしていただけると嬉しいです。\n（以前依頼したロリ巨乳スライム娘風呂みたいなイメージです）\n\nこちらに資料となるシチュ例を載せておきますので、\nよろしくお願いします。\n\nhttps://mega.nz/file/1J5iSIba#-taDJaswZnXzDbNvALe5lQosOjWcFg1EYYP7KlR0eOI", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osushidaisuki39/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/10a3b4e9/uploads/origins/b4cc10c0-8752-4c0c-bb0d-f9d9d3873b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36bb4c6161031bc7c4216d88d5011bf7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10a3b4e9/uploads/origins/b4cc10c0-8752-4c0c-bb0d-f9d9d3873b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ea2afc102faca803dfe4accac00086f", "src_set": ""}, "body": "お久しぶりです！\n無料期間ということで一つリクエストさせて頂きます。\n少し特殊よりになるので無理でしたらキャンセルでも結構です。\n\n小さくなったショタっ子がでっかいお尻のサキュバス達に\n巨尻サンドイッチをされつつ、お尻からフェロモンガスを放出して\nショタっ子に浴びせているシチュをお願いします。\nレイヤー差分でフェロモンガスはピンク色で、\nできれば放出してる擬音もいれていただけると嬉しいです。\n\nこちらに巨尻サンドイッチの資料を載せておきますので\nよろしくお願いします。\n\nサキュバス・巨尻サンドイッチ\nhttps://www.pixiv.net/artworks/13810186\n\n巨尻サンドイッチ・アップ\nhttps://www.pixiv.net/artworks/22204377", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osushidaisuki39/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/00041b88/uploads/origins/c8a4a9c4-d15c-485e-9597-990d3a4a0e9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97168512fb04665a221b8dc3edf11d4e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00041b88/uploads/origins/c8a4a9c4-d15c-485e-9597-990d3a4a0e9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40d126ec0de46d03abe5db51456df167", "src_set": ""}, "body": "お久しぶりです！\n手数料無料期間ということでまたまたリクエストさせて頂きます。\n\n超乳クラスのスライム娘とお尻が凄く大きいスライム娘が\n体を寄せ合ってショタっ子に温泉みたいにつかっている\n擬似スライム風呂をお願いします。\n\n超乳スライム娘は上半身を起こした状態で胸から下を\nショタっ子につからせている。\n超尻スライム娘は寝そべった状態でお尻を巨大化させて\n下半身をショタっ子につからせている。\nショタっ子はその中央で恥ずかしそうにして\nスライム娘風呂に入っている。\nスライム娘風呂のおっぱいとお尻の境目部分はなく\n一つに融合した状態になっている。\n以上の形で出来る範囲で描いていただけると幸いです。\n\nよろしければ差分として、超乳スライム娘が\n豊かな膨らみのあるおっぱい部分を触らせてあげる\nシチュを入れていただけると嬉しいです。\n（構図的に無理そうでしたらカットでもOKです）\n\nこちらに資料となる一例を載せておきますので\nよろしくお願いします。\n\nhttps://twitter.com/zzinzinz/status/460384669897216000", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osushidaisuki39/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4497, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e57de30d/uploads/origins/9a469b17-23c9-4a1c-b102-fd0239cc7cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc84c4f62b5badb4124cf4f460e5d75d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e57de30d/uploads/origins/9a469b17-23c9-4a1c-b102-fd0239cc7cdf?bg=%23fff&auto=format%2Ccompress