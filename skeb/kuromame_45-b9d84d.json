=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9bf049dc5d286aea3fea4d6740888b6, https://si.imgix.net/61a280ff/uploads/origins/906a1795-7a42-4845-8396-e7ec81a6a6aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43b0c0f732a30ceef51a88e837e85b98 2x, https://si.imgix.net/61a280ff/uploads/origins/906a1795-7a42-4845-8396-e7ec81a6a6aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c7a8b5968d54ae9d3e96029f69a1d67 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61a280ff/uploads/origins/906a1795-7a42-4845-8396-e7ec81a6a6aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f74a1e08aabd1cd22abbc75f534312de", "srcset": "https://si.imgix.net/61a280ff/uploads/origins/906a1795-7a42-4845-8396-e7ec81a6a6aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f74a1e08aabd1cd22abbc75f534312de, https://si.imgix.net/61a280ff/uploads/origins/906a1795-7a42-4845-8396-e7ec81a6a6aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a07089e65f477e4bdf4bc6f82d3f8c7 2x, https://si.imgix.net/61a280ff/uploads/origins/906a1795-7a42-4845-8396-e7ec81a6a6aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3219d2f50048bd2c10d7778b8bd4fcb 3x"}, "body": "ソナ様\n\n初めまして。\nYouTubeで活動をしております花芽(はなめ)と申します。ソナ様のタッチや人物の表情がとても好きで依頼させていただきたくリクエストさせていただきました。詳細をお伝えします。\n\n●内容  お正月に正月料理をおいしそうに食べている私自身のイラスト。 (小物や衣装などは私をイメージさせるものをお任せでお願いしたいです！また可能であればファンキャラクターの花ミンと2匹のフレンチブルドッグを入れていただけますと大変嬉しいです。難しい場合は大丈夫ですのでよろしくお願いします。)\n\n・好きな色 /イメージカラー➡︎オレンジ・緑・黄色・茶色\n・好きなもの/こと➡︎花、植物、動物、写真、睡眠、笑顔、旅行、おいしいもの、お餅\n\n●使用用途\nTwitterでの宣伝\nYouTube動画(収益化済み)\n配信サイトのサムネイル\nファンクラブサイトでの公開\n各SNSでの公開\nネットプリント\n\n●サイズ/描写範囲\n頭部が見切れないように描いていただけますと幸いです。縦構図だと大変ありがたいです。 サイズはお任せいたします。\n\n●納品ファイル形式\n・背景 png\n・人物 png\n・背景＋人物\n\n上記3点をいただけますと幸いです。 PSD形式で納品いただけますと大変助かります。\n\n●参考画像 活動の様子▶︎https://www.youtube.com/channel/UCE5XxgqssMe5NBWDPoqImCg\n\n自身のイメージイラスト\n➡︎https://drive.google.com/drive/folders/1p5uFRUXAjNz_LrZ9iALQRQ20bCMxJ500?usp=sharing\n\nぜひ私のイラストを描いていただきたいです。どうぞ、よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuromame_45/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3457866, "client_id": 1810528, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/891a6fd5/uploads/origins/1f7f7360-1015-4035-bbe9-13397ecfb82d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd9a04f64e4e5f22d7e1614e19de2d26", "srcset": "https://si.imgix.net/891a6fd5/uploads/origins/1f7f7360-1015-4035-bbe9-13397ecfb82d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd9a04f64e4e5f22d7e1614e19de2d26, https://si.imgix.net/891a6fd5/uploads/origins/1f7f7360-1015-4035-bbe9-13397ecfb82d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bebb729289dae174b6007ee8f20cfd37 2x, https://si.imgix.net/891a6fd5/uploads/origins/1f7f7360-1015-4035-bbe9-13397ecfb82d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4ca65ae0097ec4183b26c3c03c14d79 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/891a6fd5/uploads/origins/1f7f7360-1015-4035-bbe9-13397ecfb82d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8a7e36c7811665e27c2e1d2a6c4c737", "srcset": "https://si.imgix.net/891a6fd5/uploads/origins/1f7f7360-1015-4035-bbe9-13397ecfb82d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8a7e36c7811665e27c2e1d2a6c4c737, https://si.imgix.net/891a6fd5/uploads/origins/1f7f7360-1015-4035-bbe9-13397ecfb82d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=