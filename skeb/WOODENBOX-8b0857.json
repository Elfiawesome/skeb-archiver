s.app.goo.gl/oBnR659nDXfv3AtR9\n傷跡について場所の指定があるのは左肩にある切り傷の縫い跡のみで、他は痣や切り傷なんでもありです。\nhttps://photos.app.goo.gl/SHjLopJmKxftKPa47\n\nポーズやシチュエーションについては、仕事帰りにコンビニで買ったばかりの缶チューハイを開けている感じ(？)でお願い出来ますでしょうか……\n\nカラーの資料が少ないため、着彩や画風についてはお任せしますが、補足として色の情報も記載しておきます。\n髪:黒に近いが、青みがかった紫が入っている\n瞳:ヘーゼル\n肌:黄色味がある肌で、顔や腕は日焼けしている。\n\nhttps://photos.app.goo.gl/qUptuKYaiqofwtfN8", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 766695, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "IZ（あいぜっと）@『Witch's Heart』の中の人。", "screen_name": "blueiziz", "avatar_url": "https://pbs.twimg.com/profile_images/1704769743725666304/1Cf7deKu.png", "header_url": "https://pbs.twimg.com/profile_banners/962013116765675521/1734268894/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 2044272, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ねぎ", "screen_name": "genakiryo", "avatar_url": "https://pbs.twimg.com/profile_images/1490972991379087373/d4XNfbcw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1051063694333886465/1730847037/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "none", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 16}, {"id": 2594979, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "意識🍊", "screen_name": "genkaimemo", "avatar_url": "https://pbs.twimg.com/profile_images/1790737694450188288/NhAviyM0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1168869244123013121/16805