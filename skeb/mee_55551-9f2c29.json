asing but I would love if the pose is dynamic and upbeat! \n\nThank you very much for your consideration!\n\nRef Sheet: https://www.dropbox.com/s/xxdv9pq0h6l0br0/stellia_sheet_full.jpg?dl=0\nMore references: https://imgur.com/a/2lGhsc2", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mee_55551/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2639176, "client_id": 1376011, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8f24261/uploads/origins/7d219dbc-1603-4da4-ade4-48f1079cf864?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85e56ea07da4b5e5aa3a44bc27113a39", "srcset": "https://si.imgix.net/e8f24261/uploads/origins/7d219dbc-1603-4da4-ade4-48f1079cf864?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85e56ea07da4b5e5aa3a44bc27113a39, https://si.imgix.net/e8f24261/uploads/origins/7d219dbc-1603-4da4-ade4-48f1079cf864?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebfa8799641ade76e993254a0e5aa4f8 2x, https://si.imgix.net/e8f24261/uploads/origins/7d219dbc-1603-4da4-ade4-48f1079cf864?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5e42d62b63325ca2798b012c54e1772 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8f24261/uploads/origins/7d219dbc-1603-4da4-ade4-48f1079cf864?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05472c3b8ebccef0b47d785590b6ac58", "srcset": "https://si.imgix.net/e8f24261/uploads/origins/7d219dbc-1603-4da4-ade4-48f1079cf864?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05472c3b8ebccef0b47d785590b6ac58, https://si.imgix.net/e8f24261/uploads/origins/7d219dbc-1603-4da4-ade4-48f1079cf864?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200