_acceptable_same_genre": true}, {"path": "/@mee_55551/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2639176, "client_id": 2196041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/775c3903/uploads/origins/26895e59-553f-42f9-9bfa-d191f1acb151?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d87ca9b5e8e0b7f8c5930e1bc57003f", "srcset": "https://si.imgix.net/775c3903/uploads/origins/26895e59-553f-42f9-9bfa-d191f1acb151?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d87ca9b5e8e0b7f8c5930e1bc57003f, https://si.imgix.net/775c3903/uploads/origins/26895e59-553f-42f9-9bfa-d191f1acb151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=331f1020c6d1b9fdb3efd077cec94ec2 2x, https://si.imgix.net/775c3903/uploads/origins/26895e59-553f-42f9-9bfa-d191f1acb151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5d6417e277c6a5bf30aec6fd7b07e3b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/775c3903/uploads/origins/26895e59-553f-42f9-9bfa-d191f1acb151?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b5d49a17e544c595bf920e1bfda9c00", "srcset": "https://si.imgix.net/775c3903/uploads/origins/26895e59-553f-42f9-9bfa-d191f1acb151?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b5d49a17e544c595bf920e1bfda9c00, https://si.imgix.net/775c3903/uploads/origins/26895e59-553f-42f9-9bfa-d191f1acb151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c92f93a84d96a14624bed943987f3fe7 2x, https://si.imgix.net/775c3903/uploads/origins/26895e59-553f-42f9-9bfa-d191f1acb151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cac08425dd8b4637b95e462e059f86de 3x"}, "body": "Your art is amazing! I coming from tweeter hahaha\nI would love to see Nyacho and Nicha in a pose like the one I send you the reference of.\nI would like Nicha to grab Nyacho's face with a smug smile and Nyacho and blushing with a cheeky smile.\nIn that case, looking at the reference pose Nyacho would be in the pose of the character with pink hair and Nicha as the character with blue hair.\nFeel free to change the pose a bit! I would love a mischievous flirty duo pose!\nNyacho irises are paw shaped and one of the ears is with a dark tip, a piece of hair on is longer (you can see in the face closeup). Nicha has red tip of the hands and i would also love if the horns were visible in the picture since I find them extremely cute haha.\nFeel free to do any kind of background you like!\nThank you so much for your time and again, your art is amazing! <3\n\nhttps://drive.google.com/drive/folders/14ocquZ3XKDPUEduTARCVLDj0wjvKHMAS?usp=share_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mee_55551/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4ef4862f/uploads/origins/2dcf6e63-fb7b-4287-8fdf-6a60cf7eece3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b083dd89b9f866064e151364a30e9cb0", "srcset": "https://si.imgix.net/4ef4862f/uploads/origins/2dcf6e63-fb7b-4287-8fdf-6a60cf7eece3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b083dd89b9f866064e151364a30e9cb0, https://si.imgix.net/4ef4862f/uploads/origins/2dcf6e63-fb7b-4287-8fdf-6a60cf7eece3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98286c76951f98b5ebabfe2b0bc19f7f 2x, https://si.imgix.net/4ef4862f/uploads/origi