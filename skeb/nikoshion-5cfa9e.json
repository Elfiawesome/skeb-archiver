://si.imgix.net/a66573a9/uploads/origins/bf01bce2-24bd-4772-bbb9-8ee29898dbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d4c31df2b72a941998aa022f134e532, https://si.imgix.net/a66573a9/uploads/origins/bf01bce2-24bd-4772-bbb9-8ee29898dbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c03f6aceb4e2d0e7ea1e8e2bb13cef6e 2x, https://si.imgix.net/a66573a9/uploads/origins/bf01bce2-24bd-4772-bbb9-8ee29898dbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d975c56f6492ed3f8ecd0321b953a9bb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a66573a9/uploads/origins/bf01bce2-24bd-4772-bbb9-8ee29898dbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=022e9d13fb8ee3def9404a0ba8ac6195", "srcset": "https://si.imgix.net/a66573a9/uploads/origins/bf01bce2-24bd-4772-bbb9-8ee29898dbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=022e9d13fb8ee3def9404a0ba8ac6195, https://si.imgix.net/a66573a9/uploads/origins/bf01bce2-24bd-4772-bbb9-8ee29898dbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=58e657e6ebcb79518e3feaee4e3cbf18 2x, https://si.imgix.net/a66573a9/uploads/origins/bf01bce2-24bd-4772-bbb9-8ee29898dbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=408ce51aefdd7523e9d0ef0ed1e72d1d 3x"}, "body": "はじめまして、久しぶりにまたリクエストを受けるとのことで、このように依頼します。\n\n東方projectから登場する稀神サグメが おしっこが我慢できないとパンツにちびる姿をお願いします。\n\n描くのに役立つように資料を残します、このようにお願いします。-> https://ibb.co/sqq72hz\n稀神サグメの下着色は平凡な白でお願いします。\n\n複数枚差分ごとにパンツの状態が現れるといいですね, \nそして複数枚差分をお願いしたく、それぞれの希望差分を書かせて頂きます。\n\n1. お茶をたくさん飲んだのでちょっとした尿意を感じ始めた, まだ我慢できるのか、もじもじしています\n\n2. 尿意が限界間近に迫り、大事なところをぎゅっと押さえ息を荒くしながら、\nがくがくと身体を震わせながら必死に我慢しています。\n\n3. ついに我慢しきれなくなったおしっこが、ショーツに少しずつ滲んでいきます。(服の表面にまではまだ濡れてない感じ）\n\n4. もう少しやらかしてしまい、下着の濡れた面がより広がります。\n今度はスカートまで濡れてしまいます。\n\n5. ついに気力が尽きてしまい、おもらしをしてしまいます。\n下着が6割ほど濡れてしまって, 下着や服の股の中心部分を濡らしながら、\n我慢しきれなかったおしっこがあふれ出ています。\n\n加えて、ちょっとしたセリフもあったらいいなと思います。 \nどんなセリフを入れるかはお任せします。ありがとうございます！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nikoshion/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f6f49773/uploads/origins/4c870060-74b9-4e44-b45a-56565a1cf2db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59a032abcd757f97d4873331a462015d", "srcset": "https://si.imgix.net/f6f49773/uploads/origins/4c870060-74b9-4e44-b45a-56565a1cf2db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59a032abcd757f97d4873331a462015d, https://si.imgix.net/f6f49773/uploads/origins/4c870060-74b9-4e44-b45a-56565a1cf2db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b8a52857c4760d7e06221cf20287ce51 2x, https://si.imgix.net/f6f49773/uploads/origins/4c870060-74b9-4e44-b45a-56565a1cf2db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ddabc693d728ddb63396eaeacf30fa32 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2248970, "client_id": 2115973, "nc": 1}, {"path": "/@nikoshion/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2248970, "client_id": 2018384, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ffd7c50/uploads/origins/db0b4c18-2224-4a0b-9705-b6cc05be926b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c87601b335cd48bfbde573314e057b88