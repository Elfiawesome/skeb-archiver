548-44bf-9f8d-53eeaf64aa10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9aa3a6e16c81cdcd0742c7320ce63189 3x"}, "body": "はじめてリクエストさせて頂きます。\nいつも素敵なイラストをありがとうございます。\n\nサグメさんのイラスト、いつもとても可愛いのですが、\nニコくさ様が過去に投稿したオリキャラさんをぜひまた描いて頂きたいです。\n\nhttps://www.pixiv.net/artworks/103601320\n\n清楚系の女の子で一番遭遇したいシーンといえば、着替えシーンです。\n教室でお着替えしているところを描いて頂けないでしょうか。\n\n扉をガラッと開けられ、えっ、という照れ困惑みたいな表情をお願いします。\n下着姿が好きなので、上下ともに下着はある程度見えていると嬉しいです。\nセクシーすぎる下着と、黒色の下着は好みでないので、可愛い感じのものを描いて頂けるとありがたいです。\nもしおねだりして良ければ、下着の色や柄などの差分があれば非常に嬉しいです。\n\nこの子本当に可愛いのでぜひお願いしたいのですが、\n脱がしたく無いなどあれば遠慮なく却下して下さいませ。\n使用範囲は個人で楽しむだけです。\nリクエスト多く申し訳ございませんが、どうぞよろしくお願いします。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nikoshion/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2248970, "client_id": 2961229, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94dde37d/uploads/origins/63b12476-190d-4269-8435-e2b23c828c18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=370f5599b661e8530087296a114988f4", "srcset": "https://si.imgix.net/94dde37d/uploads/origins/63b12476-190d-4269-8435-e2b23c828c18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=370f5599b661e8530087296a114988f4, https://si.imgix.net/94dde37d/uploads/origins/63b12476-190d-4269-8435-e2b23c828c18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a6075d285eac6e16a84d84a75a70c66 2x, https://si.imgix.net/94dde37d/uploads/origins/63b12476-190d-4269-8435-e2b23c828c18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80c1ed54d0274dfb58c6a33a11511e60 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94dde37d/uploads/origins/63b12476-190d-4269-8435-e2b23c828c18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95a5e7cb649c905263972536c226da49", "srcset": "https://si.imgix.net/94dde37d/uploads/origins/63b12476-190d-4269-8435-e2b23c828c18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95a5e7cb649c905263972536c226da49, https://si.imgix.net/94dde37d/uploads/origins/63b12476-190d-4269-8435-e2b23c828c18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6acab1829b41cfbafc25b7316392f213 2x, https://si.imgix.net/94dde37d/uploads/origins/63b12476-190d-4269-8435-e2b23c828c18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=71429764af05e45d3f890db4dfa9b99b 3x"}, "body": "ニコくさんへ、\n\nはじめまして！私はあなたの熱烈なファンであり、あなたが創作された鷺沼紀信、特に彼女のユニークなエッセンスを見事に把握されたことに特別な賞賛を抱いています！\n\nこの度、私の痛車デザインのために、さぐめきしんのイラストをお願いすることになりました。私のビジョンは、彼女の「クール」と「キュート」という2つの魅力を1枚の絵にすることです。月の賢者としての神秘性と凛としたオーラを強調しつつ、クールな美しさの中にほのかな甘さを織り交ぜることです。彼女の唇の端がかろうじて持ち上がっているとか、ほのかに頬が赤らんでいるといったディテールがあれば素晴らしい。もちろん、さらに魅力的な解釈を思い描くのであれば、私はあなたの芸術的な創意工夫を目の当たりにするのが楽しみだ！\n\n私は日本語を話すことができず、機械翻訳に頼っているため、このメッセージに言語的な不備があることを心からお詫び申し上げます。\n\n創作には時間とインスピレーションの両方が必要であることを深く尊重します。あなたとのコラボレーションは、私にとってこの上ない名誉です。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nikoshion/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2248970, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/25fb2ab8/uploads/origins/7b72fec5-cbd2-4c36-9762-6698dc409642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c595c5fce41ad344eb38c225b04ebb4", "srcset": "https://si.imgix.net/25fb2ab8/uploads/origins/7b72fec5-cbd2-4c36-9762-6698dc409642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c595c5fce41ad344eb38c225b04ebb4, https://si.imgix.net/25fb2ab8/uploads/origins/7b72fec5-cbd2-4c36-9762-6698dc409642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=2