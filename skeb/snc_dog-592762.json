先生のご自由なアレンジで描いていただけると嬉しいです！先生が描く女の子は本当に可愛いので…！><\n\n\nまた、価格が合わない場合は、改めて送らせていただいてもよろしいでしょうか。\n\n参考になるリンクを添付いたします。お役に立てれば幸いです。\nhttps://drive.google.com/drive/folders/1WEKnSLpFzCkC49fVumpwQgXDTknIIe2D?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1WEKnSLpFzCkC49fVumpwQgXDTknIIe2D?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@snc_dog/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4014696, "client_id": 4013627, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c0734e7/uploads/origins/cbf71aca-6814-4cc7-a998-16295e4a54a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0026f12b62ec7ad3d223e90e87481335", "srcset": "https://si.imgix.net/7c0734e7/uploads/origins/cbf71aca-6814-4cc7-a998-16295e4a54a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0026f12b62ec7ad3d223e90e87481335, https://si.imgix.net/7c0734e7/uploads/origins/cbf71aca-6814-4cc7-a998-16295e4a54a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77d71d3dfbd78035f988fa429a67edc2 2x, https://si.imgix.net/7c0734e7/uploads/origins/cbf71aca-6814-4cc7-a998-16295e4a54a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55cda462cbb3e569b415333c11444398 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c0734e7/uploads/origins/cbf71aca-6814-4cc7-a998-16295e4a54a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17278e6278acb7561af01c7a34d621f9", "srcset": "https://si.imgix.net/7c0734e7/uploads/origins/cbf71aca-6814-4cc7-a998-16295e4a54a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17278e6278acb7561af01c7a34d621f9, https://si.imgix.net/7c0734e7/uploads/origins/cbf71aca-6814-4cc7-a998-16295e4a54a9?bg=%23fff&au