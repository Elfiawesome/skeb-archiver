orks/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1239398, "client_id": 1692421, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc855d82/uploads/origins/05748941-4229-402b-95d7-a40bbd5a1cac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ad2317d72a0e9464df29996da85cf1c", "srcset": "https://si.imgix.net/cc855d82/uploads/origins/05748941-4229-402b-95d7-a40bbd5a1cac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ad2317d72a0e9464df29996da85cf1c, https://si.imgix.net/cc855d82/uploads/origins/05748941-4229-402b-95d7-a40bbd5a1cac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1ed64e820ee4bb1f37ee5d3639d4c02 2x, https://si.imgix.net/cc855d82/uploads/origins/05748941-4229-402b-95d7-a40bbd5a1cac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99117e4668c46943f46366c8603a22af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc855d82/uploads/origins/05748941-4229-402b-95d7-a40bbd5a1cac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f128d3911e45c7b9af85d31d9233a18e", "srcset": "https://si.imgix.net/cc855d82/uploads/origins/05748941-4229-402b-95d7-a40bbd5a1cac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f128d3911e45c7b9af85d31d9233a18e, https://si.imgix.net/cc855d82/uploads/origins/05748941-4229-402b-95d7-a40bbd5a1cac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cbaee96c2cb14522e39d246dd6f1b07e 2x, https://si.imgix.net/cc855d82/uploads/origins/05748941-4229-402b-95d7-a40bbd5a1cac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ffd0ac325248d8159e9f0b8bf0ae6b42 3x"}, "body": "楽しい魚さん、初めまして\nツイッターで描いたイラストを見て、画風と雰囲気に心惹かれたので、ぜひ依頼させていただきたいです。\n\n···リクエストについて\n仲良くて和やかな雰囲気のオリキャラ2人のイラストを見たいです\n（例えば一緒に過ごした休憩時間、仕事終わったらの居酒屋など...）\n\n···キャラクター\n広橋瞬×南禅寺千春\n広橋　端正で優雅な見た目、硬いほど真面目なエリート。南禅寺と一緒に事件を調査するのはロマンティックだと思う、年下の可愛い面もある。\n南禅寺　見た目はチャラい系、自由闊達な人。でも意外と一途。サボる専門家、残業が嫌いが、広橋なら付き合う、カッコつけたいからたまに真剣に働く。\n\n···2人の関係\n二人とも警察、同じグループで事件を調査する\n南禅寺は早く事件を終わらせたいため、仕事の効率が高い、なので意外と広橋に信頼されている。南禅寺も無意識に後輩の広橋を支える。\n仕事の理念が違っても意外と順調に進める、その間に、どんどんお互いに好意を持っていて、いまは付き合ってる\n\n参考用キャラクター設定など、URLの中にあります\nhttps://drive.google.com/drive/folders/1SWHMoz2iBs6ZY11fUkafAoLJa9UroQ76?usp=sharing\n\nご検討よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tanoccfish/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6cb1105c/uploads/origins/38de30cc-0794-420e-8260-74eb5b66eb3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0bb9d0f50ce6e988b62bf57c2e13281", "srcset": "https://si.imgix.net/6cb1105c/uploads/origins/38de30cc-0794-420e-8260-74eb5b66eb3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0bb9d0f50ce6e988b62bf57c2e13281, https://si.imgix.net/6cb1105c/uploads/origins/38de30cc-0794-420e-8260-74eb5b66eb3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=152e64b4d95754a6333aa143c25d4ece 2x, https://si.imgix.net/6cb1105c/uploads/origins/38de30cc-0794-420e-8260-74eb5b66eb3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3648021a1aced8e7bb1ab597479b906b 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1239398, "client_id": 1418548, "nc": 1}, {"path": "/@tanoccfish/works/4", "private_thumbnail_image