るといいですね。でも、今回は千雪さん桑間さんなんですよね～。もちろん、属性バーは『アイドルマスター シャイニング・カラーズ』のものと同じです。あなたの判断で、様々なスキルの習熟度、ファックポジション、中途半端な実行回数など、より多くの値を提供することができます。\n\n繰り返しになりますが、ライザップとコンテンツが3段階あるといいですね。NGコンテンツはありません。ピアスやBBCのようなタトゥーなどは問題ありません。決めるのはあなたです。桑間千幸さんのコントラストと堕落をもっと見せたいと思っています。嫌な表情を見せる。騙されやすい男性も登場します。\n\nところで。中国語の翻訳も同時に出てくるといいですね。機械翻訳でもOK!", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@daiwa_dai/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 301743, "client_id": 114526, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd00b51a/requests/253177_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6ef97c7c6d051a53a2e305bc2ad2224", "srcset": "https://si.imgix.net/cd00b51a/requests/253177_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6ef97c7c6d051a53a2e305bc2ad2224, https://si.imgix.net/cd00b51a/requests/253177_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29cf9598a1493580d540303f89ca0abb 2x, https://si.imgix.net/cd00b51a/requests/253177_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29b8e15aeeef418d8117aef5039808e4 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd00b51a/requests/253177_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6644fd0697e66a027c8910aacebec99", "srcset": "https://si.imgix.net/cd00b51a/requests/253177_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6644fd0697e66a027c8910aacebec99, https://si.imgix.net/cd00b51a/requests/253177_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dcd24463e120619e4b4c90459585a5a4 2x, https://si.imgix.net/cd00b51a/requests/253177_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h