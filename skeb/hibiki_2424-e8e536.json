y_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@hibiki_2424/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 28292, "client_id": 1093956, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b27f752/uploads/origins/28798cdc-37d5-45a7-8e8c-57a0802eba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29f601835ca3f5dd023b17b05ad0b6a9", "srcset": "https://si.imgix.net/0b27f752/uploads/origins/28798cdc-37d5-45a7-8e8c-57a0802eba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29f601835ca3f5dd023b17b05ad0b6a9, https://si.imgix.net/0b27f752/uploads/origins/28798cdc-37d5-45a7-8e8c-57a0802eba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e2419747a71192758a9eded11d162a4 2x, https://si.imgix.net/0b27f752/uploads/origins/28798cdc-37d5-45a7-8e8c-57a0802eba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ad0bd9f81902f9b6d5ba1aec15ca65a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b27f752/uploads/origins/28798cdc-37d5-45a7-8e8c-57a0802eba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04717088b904a3ffbda4025d086937fb", "srcset": "https://si.imgix.net/0b27f752/uploads/origins/28798cdc-37d5-45a7-8e8c-57a0802eba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04717088b904a3ffbda4025d086937fb, https://si.imgix.net/0b27f752/uploads/origins/28798cdc-37d5-45a7-8e8c-57a0802eba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=25b23b83b2a448560a30bc1e68aace9c 2x, https://si.imgix.net/0b27f752/uploads/origins/28798cdc-37d5-45a7-8e8c-57a0802eba3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bd054d7e4923fdb3dd6935145be51c3a 3x"}, "body": "こんにちは。\n以前は素敵なイラストをありがとうございました！\n笑顔で「おはよう」と挨拶をしている二人と背景の街や空がとても美しくて……！\nお気に入りの1枚になりました……！スマホの壁紙に設定していつも眺めております🙇‍♀️\n\n今回は『花冷えに亡く季節』というCoCシナリオを通過した探索者2人をリクエストさせてください。(同卓者から許可は得ております)\n\n●リクエスト内容\n『あたたかで幸せそうな雰囲気で微笑みあっている二人』もしくは『お茶会をしたり本を読んだり等サナトリウムでの生活を楽しんでいる二人』を描いていただきたいです。\n難しければ上記は無視して自由に描いて頂いて構いません！\nまた、二人共イメージフラワーが『プルメリア』なので可能であればどこかに描いていただけると嬉しいです。\n\n●キャラについて(ネタバレ無)\n①HO記 メリー(リメリア)\n14歳/女/142cm/夢:絵本作家\n・想い出と呼称される記憶を蝕まれている\n・明るく楽観的な性格\n・色々なことに興味津々でいつも瞳を輝かせている\n・感情が顔に出やすい 基本的には笑顔\n・絵を描くのが好き\n\n②HO花 ルメリア\n14歳/女/167cm/夢:メンタルセラピスト\n・心臓に根をはり血管から花を咲かせている\n・大人しく少し内気な性格\n・背が高いことがコンプレックスでいつも猫背気味\n・自分の感情をあまり表に出さない(メリーの前では稀に笑顔を見せてくれる)\n・本を読むのと歌うのが好き\n\n●関係性等\n・花冷えの季節に病の治療のために預けられたサナトリウムで出会った二人\n・互いのことをとても大切に想いあっている\n・メリーの方からグイグイ いつも一緒にいる\n「ルメリア！一緒にいくのだわっ！」\n「あっ、待ってメリー」\n「ちゃんと待ってるのだわ！」\n・ルメリアはメリーのことを基本的には全肯定する\n「今のって褒められたのかしら！✨️」\n「うん、そうだよ」※褒められてない\n・朝が弱いメリーをルメリアがいつも起こしてくれる\n「……メリー、朝ごはん無くなっちゃうよ」\n「……！！ごはんなのだわ！……朝？」\n「うん、朝だよ。おはよう」\n・ルメリアはメリーのことが良く見えるようにいつもメリーの右側にいます\n\n●資料(ネタバレ無)\nhttps://drive.google.com/drive/folders/1-Jfj6VEB1TyLUXjrY06n7_43RiZy-61F\n・二人共目の中に花があります\n・ルメリアの体の花以外は簡略、アレンジ可\n\n●その他\n卓報告(Twitterへ飛びます) エンドは1でした\nHO記 https://x.gd/nwMqd\nHO花 https://x.gd/dV2Ci \n\nシナリオ通過済みの方は下記ふせったーも参考にして頂けますと幸いです。通過中の◯◯です。(※ネタバレがあります)\nhttps://fusetter.com/tw/GSb0T0BU\nhttps://fusetter.com/tw/Dq1OeSyF\n\n●用途\nSNSでのヘッダーやアイコンへの使用。\n(同卓者にも同様の権利を頂けますと幸いです。)\nまた現時点では未定ですが、個人利用の範囲でグッズ作成に使用する可能性があります。\n(その場合同卓者分も作成予定ですが、金銭のやり取りは致しません。)\n不可の場合お手数ですが別レイヤーに記載いただけますと幸いです。\n\n●その他\n可能であれば人物のみのデータ又はレイヤー分けをして頂けると嬉しいです。\n\n条件に合わなければ気軽に再送要請やキャンセル等して頂いて構いません🙇‍♂️\nご縁がありましたらよろしくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hibiki_2424/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 28292, "client_id": 1093956, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/79a86f3e/uploads/origins/11a80095-bd81-48b4-8547-947291d599f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7af6ff0264c7fd8567d13e6129b05dc5", "srcset": "https://si.imgix.net/79a86f3e/uploads/origins/11a80095-bd81-48b4-8547-947291d599f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7af6ff0264c7fd8567d13e6129b05dc5, https://si.imgix.net/79a86f3e/uploads/origins/11a80095-bd81-48b4-8547-947291d599f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5db2a5d241648cad87727c2ab75be841 2x, https://si.imgix.net/79a86f3e/uploads/origins/11a80095-bd81-48b4-8547-947291d599f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6044db4bcd4664be6c5137a56bdb70bf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/79a86f3e/uploads/origins/11a80095-bd81-48b4-8547-947291d599f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc627c6a101967478f51886555ba2285", "srcset": "https://si.imgix.net/79a86f3e/uploads/origins/11a80095-bd81-48b4-8547-947291d599f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc627c6a101967478f51886555ba2285, https://si.imgix.net/79a86f3e/uploads/origins/11a80095-bd81-48b4-8547-947291d599f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b6905662f3710a72e79fbba3b49f4472 2x, https://si.imgix.net/79a86f3e/uploads/origins/11a80095-bd81-48b4-8547-947291d599f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d882cacc212096dea71eaddf4830bdf0 3x"}, "body": "初めまして。貴方さまのイラストが好きです！特にイラストの空気感と青や白、水色の色遣いがとても美しくて好きです！\n私と友人がCoCシナリオ「Good morning ALL」で使用したOC(探索者)2人をリクエストさせて下さい。※友人から許可は得ています\n\n●キャラについて\n茶髪の子 HO-重病人\n空澄 來未(あすみ くるみ) 10歳/女/120cm\n参考程度のキャラシ(ネタバレなし)↓\nhttps://iachara.com/sns/6321603/view\n\n水色髪の子 HO-不老不死\nシキ 見た目年齢12歳/女/125cmぐらい\n※友人の子のためキャラシ添付無\n  下記の資料をご参照ください\n\n●資料※ネタバレはありません\nhttps://drive.google.com/drive/folders/1-0Aza-feKlaAdn_luM3Z96pzkzydEt-K\n\n\n●関係性(ネタバレ無し)\n・文明が滅んだ数万年後の地球で出会い、仲良く一緒に旅をした二人です\n・お互いのことを「しぃちゃん」「くぅちゃん」と渾名で呼びあっています\n・來未にとってシキは初めてできた親友(一番大切なお友達)です\n・シキにとっても來未は大切な存在(友達)です\n・たまたま髪の長さが2人共同じぐらい(腰辺りまで)なので並ぶと姉妹のようにも見えます\n・來未は瞳の色、シキは髪の色が朝焼けをイメージしたカラーになっています\n\n\n●リクエスト内容\n自由に描いてください！\nどんなことでも楽しめるふたりなので、仲良く笑い合っていたり楽しそうな雰囲気だと嬉しいです。\n自由にというのが難しければ、朝焼け/空/おはよう/二人旅/お揃い 辺りのワードからイメージして描いて頂けますと幸いです。\nまた、シナリオの舞台は「文明が滅んだ地球」となっていますが気にせず現代風に描いて頂いても問題ありません！\n\n\n●服装について\n資料の通り(簡略化、アレンジ可)でも、オリジナルのものでも可。特に指定はございませんので自由に描いて頂けますと幸いです。\n\n\n●用途\n友人とのイラストの共有。\nTRPG用垢@Ttri_TRPGや友人の垢でのイラスト紹介、ヘッダーやアイコンへの使用を予定しております。\nまた、現時点では未定ですが個人利用の範囲でグッズ作成に使用する可能性があります。(その場合、友人分も作成しますが金銭のやり取りは発生しません)\n商用利用は絶対に致しませんが、不可の場合は御手数ですが別レイヤーに記載いただけますと幸いです。\n\n●その他\n可能であれば人物のみのデータもしくはレイヤー分けをしていただけると嬉しいです。\n\n金額等の理由で承認が難しい場合は再送要請をいただきたいです。\nご縁がありましたらよろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hibiki_2424/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ca66c625/requests/168462_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59f74bb22f907273caaa5b30e69fcd0b", "srcset": "https://si.imgix.net/ca66c625/requests/168462_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59f74bb22f907273caaa5b30e69fcd0b, https://si.imgix.net/ca66c625/requests/168462_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2cfd0fab73fdf5312f64396441b2b371 2x, https://si.imgix.net/ca66c625/requests/168462_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middl