ath": "/@nyoki_nyoki/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3996094, "client_id": 2591693, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c9fe43e/uploads/origins/02c540df-c748-49f7-8a09-fb19d8866f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72d24e6d37d5c28ca691547c05810754", "srcset": "https://si.imgix.net/6c9fe43e/uploads/origins/02c540df-c748-49f7-8a09-fb19d8866f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72d24e6d37d5c28ca691547c05810754, https://si.imgix.net/6c9fe43e/uploads/origins/02c540df-c748-49f7-8a09-fb19d8866f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=54a37f7e3afa58fbc8a7513893f690ae 2x, https://si.imgix.net/6c9fe43e/uploads/origins/02c540df-c748-49f7-8a09-fb19d8866f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c97ca8b2c18e21febf9cb16da8ad273b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c9fe43e/uploads/origins/02c540df-c748-49f7-8a09-fb19d8866f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16fc3186142619c199e9da5bbc4d98de", "srcset": "https://si.imgix.net/6c9fe43e/uploads/origins/02c540df-c748-49f7-8a09-fb19d8866f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16fc3186142619c199e9da5bbc4d98de, https://si.imgix.net/6c9fe43e/uploads/origins/02c540df-c748-49f7-8a09-fb19d8866f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e60f00a0da92ead09897ce8ffa09babe 2x, https://si.imgix.net/6c9fe43e/uploads/origins/02c540df-c748-49f7-8a09-fb19d8866f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6dbc08543d18a033cf310f1889210be8 3x"}, "body": "こんにちは！！最近、あなたの作品を見かけて、キャラクターを描く際の細部へのこだわりが本当に素敵だと思いました^_^ ぜひ依頼させていただきたいです！！\n\n以下に、私のメインキャラクターがすべて入ったフォルダを添付しました。お好きなキャラクターを選んで、思う存分描いていただけたら嬉しいです <333 - 各キャラクターの詳細も記載していますので、お気に入りのキャラクターを自由に選んでください！\n\n- ウミ > ウミは眠たげで怠け者のヴァンパイアの女の子です。仕事をサボりたい時は小さなコウモリに変身します！現在は、彼女の守護者であるシンと結婚しています！^_^ とてもキュートな子なので、胸は小さめで、背が低く可愛らしい姿で描いてください。 とても疲れたような表情をしており、寝ているのが大好きです- 武器や棺桶などのアイテムをいつも持ち歩いています\n\n- モエコ - 献身的なことに執着する堕天使です！善悪の区別がつかないため、少し不気味なところがあります！\n\n- ルーザー - 引きこもりだった彼女は、ホラーゲームの中に閉じ込められてしまった >_< ゲームに夢中になりすぎたせいで、ゲーム世界に飲み込まれ、キャラクターに変えられてしまった！その結果、磁器の人形になってしまった！彼女は陰気で、あまり表情を見せない ^_^\n\n- レイ・シャオ - ランクアップに執着する悪魔のメイド！ヤンデレ気質の性格だ ^_^ それにもかかわらず、彼女の目は死んだように無表情だ。ピンクと黒のバージョンは彼女のもう一つの顔で、ピンク版は甘くて優しいが、黒版は狂気じみたもう一人の彼女だ！\n\n- グロは、グリーミー・ベアにインスパイアされたキャラクターです ^_^ 胸は完全に平らで、ウェブコアに夢中です！グリーミー・ベアとシーンに関するすべてが大好き！\n\nぜひ、一番気に入ったキャラクターを選んでください ^_^ 皆さんの素晴らしいアートと創造性が形になるのを見るのが楽しみです\n\nhttps://toyhou.se/Duckies/characters/folder:1640674", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nyoki_nyoki/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3996094, "client_id": 4006341, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/336b2a56/uploads/origins/73969e31-3491-4612-ac7a-92134a619259?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b015bd037433d3a234de47c8fa991bf9", "srcset": "https://si.imgix.net/336b2a56/uploads/origins/73969e31-3491-4612-ac7a-92134a619259?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b015bd037433d3a234de47c8fa991bf9, https://si.imgix.net/336b2a56/uploads/origins/73969e31-3491-4612-ac7a-92134a619259?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6015be2404675619be1d39aad3d53ec 2x, https://si.imgix.net/336b2a56/uploads/origins/73969e31-3491-4612-ac7a-92134a619259?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2fd588216a6e86d4df197f6943b9a5d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "co