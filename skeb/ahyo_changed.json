auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df948b5686bd48eee03b83f4dd96b58e", "srcset": "https://si.imgix.net/a9d7e149/uploads/origins/4ac53509-d080-41af-b4d5-a3fe1478431d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df948b5686bd48eee03b83f4dd96b58e, https://si.imgix.net/a9d7e149/uploads/origins/4ac53509-d080-41af-b4d5-a3fe1478431d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=83929754c857a6e42675d9a98f75edd2 2x, https://si.imgix.net/a9d7e149/uploads/origins/4ac53509-d080-41af-b4d5-a3fe1478431d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f10c536714111340b4856c542256ad4d 3x"}, "body": "はじめまして、ちくわ天と申します。\n絵柄がとても好みだったのでリクエスト送らせていただきました！\n\n〇内容〇\n私のオリキャラを書いていただきたいです。\n目の中に花がある事とショートヘアなこと以外は特にこだわりが無いため改変していただいてもかまいません。\n(可能であれば、パンダモチーフがあれば嬉しいです…！)\nキャラクターは資料を参考にしていただければと思います！\n\n〇使用用途〇\n個人鑑賞、動画・配信のサムネ、動画内での使用、SNS投稿、アイコン等です。\n可能な限りはID記載させていただきます。\n\n〇その他〇\n構図等は全てお任せ致します。\n指定はありません！\n\n金額、内容に不備があればキャンセルしていただいて構いません。\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/18kLhBKJ8NpTC7h0_ZjNBCfYmcD_DwMvv?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ahyo_changed/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3814521, "client_id": 3814749, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23740036/uploads/origins/01acf9ea-012c-49ed-821d-54ef5a6b54dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42e57ecdeaee6e1945df02b943ef1c6e", "srcset": "https://si.imgix.net/23740036/uploads/origins/01acf9ea-012c-49ed-821d-54ef5a6b54dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42e57ecdeaee6e1945df02b943ef1c6e, https://si.imgix.net/23740036/uploads/origins/01acf9ea-012c-49ed-821d-54ef5a6b54dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed956255da451e0dbfc4bdff2474cbd5 2x, https://si.imgix.net/23740036/uploads/origins/01acf9ea-012c-49ed-821d-54ef5a6b54dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abb709121887b2762870d3585c8e2390 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23740036/uploads/origins/01acf9ea-012c-49ed-821d-54ef5a6b54dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbe992a9cfbf1bad1dd7512ec5c12faa", "srcset": "https://si.imgix.net/23740036/uploads/origins/01acf9ea-012c-49ed-821d-54ef5a6b54dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbe992a9cfbf1bad1dd7512ec5c12faa, https://si.imgix.net/23740036/uploads/origins/01acf9ea-012c-49ed-821d-54ef5a6b54dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=622861814bb20b73fd907e23808322c1 2x, https://si.imgix.net/23740036/uploads/origins/01acf9ea-012c-49ed-821d-54ef5a6b54dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c1aab23e22553820e465d34ac56023d7 3x"}, "body": "お疲れ様です。お世話になっております。\n\n私のオリジナルキャラクターを描いていただきたく依頼させていただきました。\n\n構図等に指定はありません。このキャラに私がメロつきたいです。かっこいい！メロい！って感じでおまかせいたします！\n壁紙やSNSのアイコンなどに使用したいと考えています。\n\n「快刀乱魔」というシナリオを通過予定のキャラクターですが、未通過な上、キャラクター説明にネタバレはありません。ご了承いただけますと幸いです。\n\n軽くキャラの説明を置かせていただきます。描く際の参考にしていただければ嬉しいです。\n\n月島 縞縞(つきしま しましま)\n身長162cm。中性的であり、性別は公開しておりません。歳は24〜28程度の予定です。\n刑事部の鑑識課に所属している。\n礼儀正しく紳士的。敬語を使って会話をしますが、話の内容が支離滅裂で意味不明です。表情もやや読み取りにくいです。\n変わり者であり、信頼に欠ける言動や見た目をしています。少し前に報告書をヒエログリフで書いて怒られたらしい。\n大変な博識であるものの、それが発揮されるのは支離滅裂な言動のボキャブラリーの多彩さくらい。\n外傾視であり、右目玉が右下を向いた状態から一切動きません。\n真顔、もしくは口角を少し上げた顔をよくしています。\n表情は思ったよりも動きます。どんな表情しててもあまり解釈違いはないかもしれません。\nサンプルボイス\n「月島縞縞です。しまちゃんとお呼びくださいませ」\n「実はしまちゃんは単性生殖でして。我が身をふたつに分けて生まれたんです。プラナリアといとこなんですよ」\n「今日の天気は桑のちソリです。アームバンドを持ち歩くと良いでしょう。」\n\nまた、キャラクターの資料も添付させていただきます。まだデザインが固まりきっていないので、多少デザインが違っても大丈夫です。\nよろしくお願いします🙇\n\nhttps://drive.google.com/drive/folders/1_uDv-jft2Wx9INBzMl2KwXln7oQLAUHZ", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 263850, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "えんがわ🍣skeb open!", "screen_name": "engawa110", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F8f728b08-19a2-4105-829a-adbe7b98fa1f.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fabc4d71-23dc-476a-8210-af0e559474b3.webp", "appeal_receivable": false, "popular_creator_rank": 12, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}], "nc": 49}, {"id": 980537, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "六閃花", "screen_name": "rissenka", "avatar_url": "https://pbs.twimg.com/profile_images/1781025223292391429/Tiw8RHzG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1229962805513637888/1722437363/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 129}, {"id": 2021706, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "叶望かなと", "screen_name": "kanato_345", "avatar_url": "https://pbs.twimg.com/profile_images/2009575495764262912/CdbPEEYC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1325033498143412225/1705137423/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_