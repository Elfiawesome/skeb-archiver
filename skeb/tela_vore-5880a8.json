さないと…。\n(んぐんぐ…ごくっ，んぐんぐ…)\nあとちょっと…、よし！外れた！これでにげ\n(ペロッ，こくん)\n「美味しかった〜♪」\n\nここは…？真っ暗…。確かあの時逃げようとして、逃げられなくて、それで食べられ…っ！！なんか手がヒリヒリするっ…！何が起こってるの？そういえば、さっきから身体に液体が、っ、全身が痛痒い…！手から骨みたいな感触が…？嫌っ！嫌だっ！女の子の栄養になって死ぬなんてそんなの…っ(ぽちゃん…)\n\nよろしくお願いします。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tela_vore/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/078c3f60/uploads/origins/663564ef-05ba-4dca-b786-4e79c9d2abb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90f596b79c2ba233a6e20394e00d3dd9", "srcset": "https://si.imgix.net/078c3f60/uploads/origins/663564ef-05ba-4dca-b786-4e79c9d2abb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90f596b79c2ba233a6e20394e00d3dd9, https://si.imgix.net/078c3f60/uploads/origins/663564ef-05ba-4dca-b786-4e79c9d2abb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13d52b913f60dd5c9aec4c02f50da3bc 2x, https://si.imgix.net/078c3f60/uploads/origins/663564ef-05ba-4dca-b786-4e79c9d2abb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0ed4852b0c44d3a7c1bc72cedee5534 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 660536, "nc": 176}, {"path": "/@tela_vore/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e7412d6a/uploads/origins/0e62920f-ccc1-4e71-ab71-e2c9e576f94b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30280460d92becfee2e3754b839c4ad6", "