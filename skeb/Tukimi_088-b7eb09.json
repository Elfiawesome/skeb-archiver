/works/2\n\n・コンセプトは『東アジア風のヒポグリフ』、モチーフは鬼神・狛犬・麒麟・ニホンカモシカ。\n・色は抹茶小豆羊羹&練切菓子、模様は唐草模様モチーフ\n・ニホンカモシカの角と副蹄のある足、狛犬のような巻毛、\n　金の眼に猫のような縦長の瞳、後足に火の玉のような距毛、獅子のような尾\n\nhttps://twitter.com/Komorebi_box/status/1551570172280188928", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tukimi_088/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3267102, "client_id": 941144, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45c53308/uploads/origins/32a47cd9-cdde-4b01-9b9d-f2c88b17339c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8ebcf3ecf23dc8fbf118dce5049561b", "srcset": "https://si.imgix.net/45c53308/uploads/origins/32a47cd9-cdde-4b01-9b9d-f2c88b17339c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8ebcf3ecf23dc8fbf118dce5049561b, https://si.imgix.net/45c53308/uploads/origins/32a47cd9-cdde-4b01-9b9d-f2c88b17339c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03d6d3953eb9ae736701b1af709430ca 2x, https://si.imgix.net/45c53308/uploads/origins/32a47cd9-cdde-4b01-9b9d-f2c88b17339c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ca619fd32af879489834c798469b4a1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45c53308/uploads/origins/32a47cd9-cdde-4b01-9b9d-f2c88b17339c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d715f1cb46385a2575a5ce90a18a524f", "srcset": "https://si.imgix.net/45c53308/uploads/origins/32a47cd9-cdde-4b01-9b9d-f2c88b17339c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d715f1cb46385a2575a5ce90a18a524f, https://si.imgix.net/45c53308/uploads/origins/32a47cd9-cdde-4b01-9b9d-f2c88b17339c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e22dc909169e7