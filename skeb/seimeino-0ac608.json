気にしています \n\n【使用用途】\n・SNSでのアイコン、ヘッダー、投稿\n・discordでの使用\n・IRIAM（配信サムネイル、ミニキャラ配信）\n・デジタルグッズ 、リアルグッズ\n・返礼品としてリスナーへの配布  （商用利用）\n\n【イラストのイメージ】\n・衣装:資料のどれか、またはオリジナルでも構いません。絶目 我様にお任せいたします。\n・サムネイル等に利用した際に不自然にならないよう、可能であれば耳や髪が切れないように制作していただけますと幸いです！  \n\n ■納品\n・人物、背景、サインでレイヤーを分けたデータを頂けると嬉しいです！\n\nhttps://drive.google.com/drive/folders/1qspWqtkHnUW7ERC_JLNZMaxmCLq50slf", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@seimeino/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3818332, "client_id": 3820007, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f82992b0/uploads/origins/4277a1e9-83ec-4968-a784-a02adc0fbb9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=083042b555a883dd4fe85fe748a8b811", "srcset": "https://si.imgix.net/f82992b0/uploads/origins/4277a1e9-83ec-4968-a784-a02adc0fbb9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=083042b555a883dd4fe85fe748a8b811, https://si.imgix.net/f82992b0/uploads/origins/4277a1e9-83ec-4968-a784-a02adc0fbb9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bdf7e2f76cb50d3cd15308064df0b8f 2x, https://si.imgix.net/f82992b0/uploads/origins/4277a1e9-83ec-4968-a784-a02adc0fbb9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb144b03aa93326d54d4bb787de48be7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f82992b0/uploads/origins/4277a1e9-83ec-4968-a784-a02adc0fbb9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e207adabde03571d2a383b907daa34ea", "srcset": "https://si.imgix.net/f82992b0/uploads/origins/4277a1e9-83ec-4968-a784-a02adc0fbb9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e207adabde03571d2a383b907daa34ea, https://si.imgix.net/f82992b0/uploa