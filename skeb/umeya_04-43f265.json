す。お好きに解釈していただければと思います。詳細は参考資料をご覧ください。\n\n関係性\n男性→相手に対して、いけ好かないけど良いライバルだと思っている\n女性→相手に対して、尊敬してるし友人になりたいと思っている、感情が表情に出にくい\nどちらも高校生です。友人関係というよりかはお互いがライバルといった関係です。\n\n使用用途\n・個人利用、同卓者への画像共有\n・SNSでの投稿（ヘッダーやアイコン等）\n\n\nもし難しければキャンセルしていただいて構いません。ご検討をお願いいたします。\n\nhttps://drive.google.com/drive/folders/13-h10tnswWVObRRp1Px_U3XZ0X9vKEEv", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umeya_04/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4014134, "client_id": 3911508, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d68a9ff/uploads/origins/7323f468-b0ab-45dd-aba9-f6d4a55a8676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a85fdce27985fc6c5467a9f0389cb2b", "srcset": "https://si.imgix.net/4d68a9ff/uploads/origins/7323f468-b0ab-45dd-aba9-f6d4a55a8676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a85fdce27985fc6c5467a9f0389cb2b, https://si.imgix.net/4d68a9ff/uploads/origins/7323f468-b0ab-45dd-aba9-f6d4a55a8676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f77f5c7309f1e37e7e79fa93eb327723 2x, https://si.imgix.net/4d68a9ff/uploads/origins/7323f468-b0ab-45dd-aba9-f6d4a55a8676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59506d5228560f6d963b0fa81b9cb497 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d68a9ff/uploads/origins/7323f468-b0ab-45dd-aba9-f6d4a55a8676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08fda15309b46a57aa4b86d88d29460a", "srcset": "https://si.imgix.net/4d68a9ff/uploads/origins/7323f468-b0ab-45dd-aba9-f6d4a55a8676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08fda15309b46a57aa4b86d88d29460a, https://si.imgix.net/4d68a9ff/uploads/origins/7323f468-b0ab-45dd-aba9-