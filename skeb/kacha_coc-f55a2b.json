ers/1DZXUyB0cuNdss0533gUmsbI_Vc7lHX4V", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sisisi_sio/works/149", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2991136, "client_id": 3035697, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9eed31f5/uploads/origins/ff4b8fc8-5e03-4e21-95d6-4a396e6b7386?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1567ccc3e207ca50b6e07fb743f2ea87", "srcset": "https://si.imgix.net/9eed31f5/uploads/origins/ff4b8fc8-5e03-4e21-95d6-4a396e6b7386?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1567ccc3e207ca50b6e07fb743f2ea87, https://si.imgix.net/9eed31f5/uploads/origins/ff4b8fc8-5e03-4e21-95d6-4a396e6b7386?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b960407f8cc52f00935aa104a51679b 2x, https://si.imgix.net/9eed31f5/uploads/origins/ff4b8fc8-5e03-4e21-95d6-4a396e6b7386?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b84f6f5671c0292eb013c18e98ad2283 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9eed31f5/uploads/origins/ff4b8fc8-5e03-4e21-95d6-4a396e6b7386?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d13f1ee8958a807a5fa97fb6a96b706e", "srcset": "https://si.imgix.net/9eed31f5/uploads/origins/ff4b8fc8-5e03-4e21-95d6-4a396e6b7386?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d13f1ee8958a807a5fa97fb6a96b706e, https://si.imgix.net/9eed31f5/uploads/origins/ff4b8fc8-5e03-4e21-95d6-4a396e6b7386?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6fb52d9043232c2f0be7f761e48a6983 2x, https://si.imgix.net/9eed31f5/uploads/origins/ff4b8fc8-5e03-4e21-95d6-4a396e6b7386?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=897de1500a42c63886dbbbd37b61074a 3x"}, "body": "初めまして！いつも篠崎もちめ様の描かれる個性豊かで魅力的なキャラクターの立ち絵、拝見しております。どれも素敵でいつか自分のキャラクターを描いて頂きたいと思っており、この度初めてご依頼致します。\n\n今回は私と友人がクトゥルフ神話TRPG「四季送り」で遊んだ、オリジナルキャラクターたちの合わせ立ち絵をお願いしたいです。詳細は以下に記載させて頂きます。\n\n◇キャラクターの特徴\n\n《茶髪の男性》\n・年齢：28歳\n・身長：175cm\n・一人称：俺\n・茶髪、黒目(ハイライト薄め)、両目の下に黒子\n表情変化に乏しい男。基本的に無表情で、笑うことは滅多に無い。が、感情が読み取れないかと問われれば否だ。口ではあれやこれやと言っているかもしれないが、仲間へそれなりの情があることは、誰でも見て取れる。最近は少しだけ微笑むことも増えた…かもしれない。\n\n《白髪の男性》\n・年齢：28歳\n・身長：173cm\n・一人称：僕\n・白髪、水色の瞳、片目が髪で隠れている\n暑さにめっぽう弱く、常に日傘を差している。夏は外に出たくない、出不精。落ち着いた雰囲気で穏やかに話すことが多く、優しい男。大人っぽさを感じるかもしれないが、仲間内に対しては少し子どもっぽい顔も見せる。皆のことを笑顔で見守っている。\n\n◇構図など\n\n日傘で相合傘をしている構図でお願いしたいです！傘は茶髪の男性が持っていて欲しいです。表情や目線(お互いを向いているか、正面を向いているか等)はお任せしますが、仲良さげだと嬉しいです…！\n\n◇その他\n\n記載が無い部分はもちめ様のご自由に描いて頂けますと幸いです！友人へのデータ譲渡を予定しておりますので、人物ごとに単体のデータも頂戴できますと助かります。また私と友人の間で個人利用の為に、アクリルスタンドを作成したいと考えております。\n\nskebをご依頼させて頂くのが初めての為、何か不都合や金額の不足がありましたら、ご遠慮なく再送下さい！\nご検討の程、宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1DZXUyB0cuNdss0533gUmsbI_Vc7lHX4V?usp=share_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 498414, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "愛野夢里", "screen_name": "yumeri_aino", "avatar_url": "https://pbs.twimg.com/profile_images/1910390527830482944/ttWhPTGU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1376108211598618627/1656383698/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}, {"genre": "correction"}], "banned": false, "nc": 16}, {"id": 1806360, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "さとる@アカ移動", "screen_name": "str_trpg", "avatar_url": "https://pbs.twimg.com/profile_images/2067940178661187584/40wZki