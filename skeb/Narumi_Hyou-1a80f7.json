fc6-317b-4e4f-9c47-af5793cfd073?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19082567c756eba6e341159e86cec6ce 2x, https://si.imgix.net/735e6972/uploads/origins/c12f5fc6-317b-4e4f-9c47-af5793cfd073?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc399db27db0c7e87df893d9cb9132e5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/735e6972/uploads/origins/c12f5fc6-317b-4e4f-9c47-af5793cfd073?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13319d6abef3e3d36376a1f3d5a39463", "srcset": "https://si.imgix.net/735e6972/uploads/origins/c12f5fc6-317b-4e4f-9c47-af5793cfd073?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13319d6abef3e3d36376a1f3d5a39463, https://si.imgix.net/735e6972/uploads/origins/c12f5fc6-317b-4e4f-9c47-af5793cfd073?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3d203e1eee1c749e2d84c4b82402bbc1 2x, https://si.imgix.net/735e6972/uploads/origins/c12f5fc6-317b-4e4f-9c47-af5793cfd073?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8c42bd095e1c0e68cde5a8ad4c5dadfc 3x"}, "body": "足が40本ある多脚ケモノタウルを見てみたい！(昆虫じゃないけど）\n\n解剖学的には、2本の腕、2本の前脚、38本の後脚があり、それぞれの脚の間にフルサイズの胴体があるようなキャラクターにしたい。詳しくは以下のドキュメントをご覧ください。\n\nhttps://cdn.discordapp.com/attachments/749476684662833255/1104320790406627458/Taurtrain_anatomy_reference.doc?ex=65e2e061&is=65d06b61&hm=0c61bf32f8d4d1412340e8c3bec019c879949cb88517446a8b55f8e8c8c5167e&\n\nさらに、上半身の胴体の比率は、下半身の胴体に比べて極端に小さくしてほしい。説明のメモが以下にあります。\n\n以下の点に重点を置く：\n- 適切な解剖学（例えば、前脚と後脚の違いなど）\n- 全身と脚のほとんど（できればすべて）を見せること。\n- 蹄など他の種類の脚よりも肉球や爪が好ましい。\n\n上記のすべてを満たした上で、以下のどれでもかまわない：\n- クリーチャー\n- デザイン\n- ポーズ\n\nhttps://cdn.discordapp.com/attachments/749476684662833255/1195535898490708108/Taurtrain_anatomy_note_-_Extreme_Proportion.docx?ex=65e27d12&is=65d00812&hm=374abec72444936ebd1a5ac3b6883809786c787f7660edf0e4e5b03c989e1c2e&", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Narumi_Hyou/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1428389, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03939f53/uploads/origins/e845386e-41f9-4794-b26f-daf36158e908?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a6bdff9d4d8fc34e10023a5262c5726", "srcset": "https://si.imgix.net/03939f53/uploads/origins/e845386e-41f9-4794-b26f-daf36158e908?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a6bdff9d4d8fc34e10023a5262c5726, https://si.imgix.net/03939f53/uploads/origins/e845386e-41f9-4794-b26f-daf36158e908?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfab0d3e8c40b5e5dca93e5989b8a5d5 2x, https://si.imgix.net/03939f53/uploads/origins/e845386e-41f9-4794-b26f-daf36158e908?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97d3f46ccce53a31020ba1b4cac2715e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03939f53/uploads/origins/e845386e-41f9-4794-b26f-daf36158e908?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91630bbb5fd377f5f75d41eda4ed6e55", "srcset": "https://si.imgix.net/03939f53/uploads/origins/e845386e-41f9-4794-b26f-daf36158e908?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91630bbb5fd377f5f75d41eda4ed6e55, https://si.imgix.net/03939f53/uploads/origins/e845386e-41f9-4794-b26f-daf36158e908?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b54c432ed66f874cc681f4bb99271d5a 2x, https://si.imgix.net/03939f53/uploads/origins/e845386e-41f9-4794-b26f-daf36158e908?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4b50fe8bc63024751ef69c58a41780e2 3x"}, "body": "またまたこんにちはー。\n以前からOCのメロディーの全身イラストをまたお願いしたいです。\n\n今回は、森を探検しているようなイメージでお願いします。前回のCinderaceのイラストの照明がとても気に入ったので、あのような照明で森を探検しているような感じでお願いします。片足を岩に乗せて、はしゃいでいるようなイメージで。\n参考： https://postimg.cc/gXwkQxsw\n\n以下はその例です。https://4.bp.blogspot.com/-OtoWrIFKPgc/V_wUb02IemI/AAAAAAABF18/VRZ5cgUEmbc2Gwj6TYp50M0kIzkkCkO4QCLcB/s1600/Tales_of_Symphonia_%2528PC%2529_01.jpg\n\n前回と同じシャツを使い、赤いリュックも持たせてあげてください🎒。\nhttps://postimg.cc/HrYDWv2d\n\n他の服装も同じであるべきです。\n以下は私のOCのレフシートです： https://postimg.cc/CnxT7dkF\n\nもうひとつ注意です。メロディの耳のために、他の画像ではなく、左の画像の例に従ってください。(彼女が浮いている方)。ちょっと違うんです。\nありがとうございました！これで大丈夫かな？", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Narumi_Hyou/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1428389, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b65aca4/uploads/origins/20d42962-5152-42fa-91fb-181022fb9c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=151f64cd9167ee0eaa72a070f4c8da1a", "srcset": "https://si.imgix.net/8b65aca4/uploads/origins/20d42962-5152-42fa-91fb-181022fb9c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=151f64cd9167ee0eaa72a070f4c8da1a, https://si.imgix.net/8b65aca4/uploads/origins/20d42962-5152-42fa-91fb-181022fb9c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c15313105f48a0f100325142333a9aa2 2x, https://si.imgix.net/8b65aca4/uploads/origins/20d42962-5152-42fa-91fb-181022fb9c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb625b14fd0545f6f6c782a019318f3e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b65aca4/uploads/origins/20d42962-5152-42fa-91fb-181022fb9c1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f0bb0399eed3192f3ec28e6f5e2e36b", "