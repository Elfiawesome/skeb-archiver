7/uploads/origins/ea14c952-2ca4-4b8f-af6b-57a5d3e141ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=365a18ad065d6ff9c7911e34173f300f 2x, https://si.imgix.net/0d157777/uploads/origins/ea14c952-2ca4-4b8f-af6b-57a5d3e141ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2d759f37752c8603438f107684039982 3x"}, "body": "Hello とら-san!\nThank you so much for your wonderful Nazrin illustrations in the past!\nFor my request, can you please draw Nazrin again?\nIf so, please draw her however you wish!\nI'll leave everything up to you!\n\nとらさん、こんにちは\n以前は素敵なナズーリンイラストを描いていただきありがとうございました\nリクエストなのですが、またナズーリンを描いていただけないでしょうか？\nその際、お好きなように描いてください。\n全ておまかせします", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TrampJing/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 7473, "client_id": 625654, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab8a5f13/uploads/origins/0ac88e5b-673a-4eab-b041-ad6761175536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23607adbe3249b9c76924e5ace9376bb", "srcset": "https://si.imgix.net/ab8a5f13/uploads/origins/0ac88e5b-673a-4eab-b041-ad6761175536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23607adbe3249b9c76924e5ace9376bb, https://si.imgix.net/ab8a5f13/uploads/origins/0ac88e5b-673a-4eab-b041-ad6761175536?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4235c0eba831e072b935a8560f2a475 2x, https://si.imgix.net/ab8a5f13/uploads/origins/0ac88e5b-673a-4eab-b041-ad6761175536?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=391fa4de85017f9ff4b571f1386401b4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab8a5f13/uploads/origins/0ac88e5b-673a-4eab-b041-ad6761175536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a27316a5dcdd083b330c6ad6b4dd5fa", "srcset": "https://si.imgix.net/ab8a5f13/uploads/origins/0ac88e5b-673a-4eab-b041-ad6761175536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a27316a5dcdd083b330c6ad6b4dd5fa, https://si.imgix.net/ab8a5f13/uploads/origins/0ac88e5b-673a-4eab-b041-ad6761175536?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49752c90ceeb6abc7051609c387754b0 2x, https://si.imgix.net/ab8a5f13/uploads/origins/0ac88e5b-673a-4eab-b041-ad6761175536?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aadbf4f9c93ade3bcd7922277cff7530 3x"}, "body": "こんにちは。\n\nファイアーエムブレムのイドゥンとキランの画像をお願いします。\nイドゥン 参考画像:https://imgur.com/a/07K6c5Q\nキラン 参考画像:https://imgur.com/GtHqFGy\n\n-胸の大きさを参考画像より大きくしてください。\n\n-フードを被っていない状態でお願いします。\n\n-イドゥンが座った状態で、キランの頭を胸に抱きしめているようなイメージでお願いします。\n参考:https://imgur.com/PVDeGtg\n\n-イドゥンは幸せそうな表情でキランを見下ろしています。\n\n-キランはフードをかぶって寝ている状態。\n\n-背景は花畑で、イドゥンとキランは木の下で休んでいるような感じで。\n\nありがとうございました。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TrampJing/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 7473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86594863/uploads/origins/0b2f3264-c1d6-4d6c-b72a-035bf08ac824?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dea69f76daccf22f1b9d74d058f0c4d", "srcset": "https://si.imgix.net/86594863/uploads/origins/0b2f3264-c1d6-4d6c-b72a-035bf08ac824?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dea69f76daccf22f1b9d74d058f0c4d, https://si.imgix.net/86594863/uploads/origins/0b2f3264-c1d6-4d6c-b72a-035bf08ac824?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9be2741b0d7a2dc490b976ea50062a1a 2x, https://si.imgi