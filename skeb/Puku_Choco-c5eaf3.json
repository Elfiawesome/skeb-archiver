r=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9362d9d921c523fe1d06ad9b36efb00a 2x, https://si.imgix.net/09bca498/uploads/origins/b6fa4a31-7559-4633-a332-1947decbaca5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3e6967b2c41b7735229c7de5ac82600d 3x"}, "body": "この度は、レンシアを目に留めていただきありがとうございます。\n下記内容でご検討いただければ幸いです。\n\n希望シチュ：\n季節外れですが、サンタ服姿で元気な姿（ポーズや背景はお任せします）のレンシアをお願いします。\n\n衣装：\n手袋無し\nサンタ服（上着）、ローブ、サンタ帽は必須希望です\nズボンとブーツは有り無しどちらでも構いません\n※ズボン無しの場合、へそチラしていたら嬉しいです\n\nレンシアの特徴：\n・１０〜１２歳のキツネっ仔（体型はケモ足骨格ではなくケモショタ骨格）\n・体毛は淡い黄色と白、黄土色\n・鼻元が毛色の境\n・耳先に垂れ毛\n・額に水色のマーク\n・手の指５本、足の指３本（爪ある場合は濃グレー〜黒）\n・肉球はピンク色\n拙作ですが資料参照いただけると幸いです。\n\nその他：\nシールなど個人的に使用するグッズ作製を想定してます\n背景無し画像もあると嬉しいです\n\nhttps://drive.google.com/drive/folders/1zWJeC27_6i-xf5V4ExZgz26QrnRbyw7m?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Puku_Choco/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3517124, "client_id": 879079, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94bf4bb2/uploads/origins/bf3a06b7-b93d-4366-96ad-13af95395c8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=444ec5e300faa674986a7415b7ba4e50", "srcset": "https://si.imgix.net/94bf4bb2/uploads/origins/bf3a06b7-b93d-4366-96ad-13af95395c8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=444ec5e300faa674986a7415b7ba4e50, https://si.imgix.net/94bf4bb2/uploads/origins/bf3a06b7-b93d-4366-96ad-13af95395c8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef556ac263d69b8300464d8593e4b538 2x, https://si.imgix.net/94bf4bb2/uploads/origins/bf3a06b7-b93d-4366-96ad-13af95395c8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=492e5669fb02bce3d8943d4e7cb71f0b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.i