，所以很纠结，也绝对不会承认自己有这种感情，认为如果孟游知道了一定会（更加）利用自己\n孟对林的感情： 觉得林挺有意思，不知不觉的更加在意他。但认为林肯定不会喜欢自己，所以并没有透露自己的感情。 会找机会拥有自然而然的身体接触（林认为这只是孟套近乎）\n\n老师自由发挥，谢谢！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akira_sako_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4060321, "client_id": 9587, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75279335/uploads/origins/3d371dd5-4295-43fd-ae3e-cf40aff498e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=261cdc5f06fdad7626be9110d2e0c170", "srcset": "https://si.imgix.net/75279335/uploads/origins/3d371dd5-4295-43fd-ae3e-cf40aff498e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=261cdc5f06fdad7626be9110d2e0c170, https://si.imgix.net/75279335/uploads/origins/3d371dd5-4295-43fd-ae3e-cf40aff498e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5356eb851c3cfd1d610b3d1d0f254a86 2x, https://si.imgix.net/75279335/uploads/origins/3d371dd5-4295-43fd-ae3e-cf40aff498e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9669b96f6a76850a8d7c515a090352d0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75279335/uploads/origins/3d371dd5-4295-43fd-ae3e-cf40aff498e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95abada713901fa1a2a475f9ffc38e67", "srcset": "https://si.imgix.net/75279335/uploads/origins/3d371dd5-4295-43fd-ae3e-cf40aff498e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95abada713901fa1a2a475f9ffc38e67, https://si.imgix.net/75279335/uploads/origins/3d371dd5-4295-43fd-ae3e-cf40aff498e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7da7a22bcac26674941dd990a12731a0 2x, https://si.imgix.net/75279335/uploads/origins/3d37