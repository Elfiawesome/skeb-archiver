-ae83-f26780f2b33e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fb5c4a0b2a296d42020f5bd0fb98f3b", "srcset": "https://si.imgix.net/a978366c/uploads/origins/882b8e44-22d3-4a6c-ae83-f26780f2b33e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fb5c4a0b2a296d42020f5bd0fb98f3b, https://si.imgix.net/a978366c/uploads/origins/882b8e44-22d3-4a6c-ae83-f26780f2b33e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c5da769f2155670c401bcddc0e60e02 2x, https://si.imgix.net/a978366c/uploads/origins/882b8e44-22d3-4a6c-ae83-f26780f2b33e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=000232646ab0b2998bc9e4e8125a706e 3x"}, "body": "こんにちは！\n\nこれらのオリジナルキャラクター（OC）を描いてください。\nこれらはヴィクトリア朝時代（1890年代）を舞台にしたホラー作品に登場するキャラクターです。\n\nペンローズ（白髪の男性）\n邪悪な闇の魔術師。昼間は古代エジプトの遺物を展示する小さな博物館を運営する高名な貴族だが、夜になると、人を生贄にして怪物を召喚する闇の魔術カルトの危険な指導者となる。彼はまるで蛇のようだ。狡猾で、警戒心が強く、優雅で、知性があり、威圧的だ。親切そうに見えるが、冷酷無比である。\n\nシェイ（茶髪の少年）は物静かで、親友のアロイスをとても大切にしている。\nアロイス（金髪の少年）は神経質で繊細だ。\n彼らは貧しい孤児で、ペンローズのもとで働いており、彼を非常に恐れている。\n\nアイデア：\n- ペンローズが少年たちの背後に立ち、そっと両手を彼らの肩に置く。少年たちは怯えた表情をしている。\n- ペンローズが少年たちにエジプトの遺物を見せる。少年たちは好奇心を抱きつつも、怖がっている。\n- ペンローズが少年たちにハードキャンディを差し出す。少年たちは彼を警戒しつつも、それを受け取る。\n\n使用目的：SNS、オリジナルキャラクター（OC）の活動、個人閲覧のみを目的とした印刷\n\nありがとうございます！\n\nhttps://drive.google.com/drive/folders/1eAPMynhSd8WdwTSCZLVC9VxOvu1Lc_LF?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akira_sako_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4060321, "client_id": 204344, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b86778b/uploads/origins/38a5e2bd-5837-4c5d-9a0d-68cf483d4ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2463084f489b1464cdc5b77218f6dac", "srcset": "https://si.imgix.net/6b86778b/uploads/origins/38a5e2bd-5837-4c