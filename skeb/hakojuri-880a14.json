&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1964364f3cb826e879629c37ecd51022, https://si.imgix.net/ad1c06bd/uploads/origins/a3163eb5-e9e5-4046-927a-6c1046fb7526?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d467fa06fa98999082223d335aba369 2x, https://si.imgix.net/ad1c06bd/uploads/origins/a3163eb5-e9e5-4046-927a-6c1046fb7526?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5bb314655d04592430907ba61a56d6f9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad1c06bd/uploads/origins/a3163eb5-e9e5-4046-927a-6c1046fb7526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6f4ca0e690a5991c5b83461f1cf2c21", "srcset": "https://si.imgix.net/ad1c06bd/uploads/origins/a3163eb5-e9e5-4046-927a-6c1046fb7526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6f4ca0e690a5991c5b83461f1cf2c21, https://si.imgix.net/ad1c06bd/uploads/origins/a3163eb5-e9e5-4046-927a-6c1046fb7526?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c8b1a87890010cff95cd49fd3bacdc80 2x, https://si.imgix.net/ad1c06bd/uploads/origins/a3163eb5-e9e5-4046-927a-6c1046fb7526?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a06f9c38cbc1ac53a17a113f0831487 3x"}, "body": "いつもお世話になっております。前回はありがとうございました。\n今回依頼したいのは私のオリジナルウマ娘である「フロールレイエス」とMomi氏のオリジナルウマ娘である「ナハトシュプール」です。\n私のオリウマの参考絵はこちらです(https://photos.app.goo.gl/dBtDW4nKP1WtA3Pb7)\n身長170cm,スリーサイズはB90,W60,H86です。髪飾りは牡丹の花です。髪色は白銀色で後ろ髪の長さは背中辺りです(なお今回も髪飾り省略です)\n\nナハトシュプールさんの資料はこちらです(https://x.com/385az/status/1865380748225589309)\n\n以下内容になります。\n・乗務員(車掌)交代のシーン\n・描いていただきたい車両は811系 スペースワールド号\n(https://images.app.goo.gl/7RRdqJjPsAvZcQCf8)\n側面部分\n(https://images.app.goo.gl/DUrnnthMRsBrwYfm7)\n・服装\nフロールレイエスはこちらを(https://images.app.goo.gl/H7si5nQeASRTfpkA8)\nナハトシュプールさんにはこちらを(https://images.app.goo.gl/y4SDd3VNAJWn46zCA)\nお願いいたします。\n・ナハトさんの制帽はこちら(https://images.app.goo.gl/hyTRZR71L3qpj2Ww7)で\n・立ち位置は乗務員扉向かって左側にフロールレイエス,右側にナハトシュプールで敬礼+軽く会釈\n・ナハトさんの左手には車掌用携帯時刻表を持たせてください\n\n以上となります。よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hakojuri/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2531243, "client_id": 2592670, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8bf1346/uploads/origins/b89a2c8f-aa33-401c-83c7-2bf5270471e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d24a540ddcbf3e6b5f12c34668b54060", "srcset": "https://si.imgix.net/b8bf1346/uploads/origins/b89a2c8f-aa33-401c-83c7-2bf5270471e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d24a540ddcbf3e6b5f12c34668b54060, https://si.imgix.net/b8bf1346/uploads/origins/b89a2c8f-aa33-401c-83c7-2bf5270471e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ef4b5000237b647388f3887fa89be12 2x, https://si.imgix.net/b8bf1346/uploads/origins/b89a2c8f-aa33-401c-83c7-2bf5270471e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b6f54fefaaac91a640fe8c57b38fa3c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8bf1346/uploads/origins/b89a2c8f-aa33-401c-83c7-2bf5270471e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e49d7ac97d8e43f596059e43baf0da38", "srcset": "https://si.imgix.net/b8bf1346/uploads/origins/b89a2c8f-aa33-401c-83c7-2bf5270471e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e49d7ac97d8e43f596059e43baf0da38, https://si.imgix.net/b8bf1346/uploads/origins/b89a2c8f-aa33-401c-83c7-2bf5270471e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5cc4a2142184b642ff3cb28b8495c158 2x, https://si.imgix.net/b8bf1346/uploads/origins/b89a2c8f-aa33-401c-83c7-2bf5270471e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=577b0869c5a6b11730dd66bcc7e8d396 3x"}, "body": "こんにちは！\nもし宜しければ、うちのオリウマのホープフルシャインちゃんを描いて頂けないでしょうか？\nシチュエーションとしてはレース中、最終直線で他の子達を一気に抜き去ろうとして、芝に強く脚を踏み込んでる感じでお願いします！\nまた、レースは福島のGⅢ想定ですが、服装は勝負服でお願いします！\n表情は真剣な感じで、真っ直ぐ前を見据えてる感じでお願いしたいです！\nぜひご検討頂けたら嬉しいです！\n\nhttps://x.com/pyonpyon0723uma/status/1860640106270667151?t=RuTQ4r2eGvN8k3zw5hkGgQ&s=19", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hakojuri/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2531243, "client_id": 547336, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34d7c1a2/uploads/origins/bc05eb2a-33e2-4634-bc0d-8ba683c35965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e980e7fbf30caf05ac7e398ceac548a", "srcset": "https://si.imgix.net/34d7c1a2/uploads/origins/bc05eb2a-33e2-4634-bc0d-8ba683c35965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e980e7fbf30caf05ac7e398ceac548a, https://si.imgix.net/34d7c1a2/uploads/origins/bc05eb2a-33e2-4634-bc0d-8ba683c35965?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9de09177c92185adec9e4f17e452ee10 2x, https://si.imgix.net/34d7c1a2/uploads/origins/bc05eb2a-33e2-4634-bc0d-8ba683c35965?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d876b4c1c2ab7aa0603935ccb80be527 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34d7c1a2/uploads/origins/bc05eb2a-33e2-4634-bc0d-8ba683c35965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=824cf2e8bbc620685b0a7623138b6cb8", "srcset": "https://si.imgix.net/34d7c1a2/uploads/origins/bc05eb2a-33e2-4634-bc0d-8ba683c35965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=824cf2e8bbc620685b0a7623138b6cb8, https://si.imgix.net/34d7c1a2/uploads/origins/bc05eb2a-33e2-4634-bc0d-8ba683c35965?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6998c91bb70581042a1597e3d702e468 2x, https://si.imgix.net/34d7c1a2/uploads/origins/bc05eb2a-33e2-4634-bc0d-8ba683c35965?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d01b06d29cc5fe601c75880aa85a706 3x"}, "body": "いつもお世話になっております。前回はありがとうございました。\n今回依頼したいのも私のオリジナルウマ娘です。参考絵のURLを下記に添付致しますので、ご確認のほどよろしくお願いします。\n(https://photos.app.goo.gl/bFUMTbSuLYSy9Let9)\n身長160cm,スリーサイズはB81 W58 H81です。髪飾りは菜の花ですが帽子に隠れるので省略です。\n\n今回はED76に乗り込もうとしているオリウマちゃんをお願い致します。\n\n以下詳しい内容になります\n・正面構図(キャラは機関車に対して左向き)で梯子に足をかけて登っている\n・機関車の番号はED76-81\n・機関車装着ヘッドマークは「なは」\n・場所は門司機関区(一番左の画像)で時刻は4時台ですので日の出前になります。(8月の日の出は5:30~5:40辺り)\n機関車や場所、ヘッドマークの資料はこちらです:(https://photos.app.goo.gl/dFarAURAyVgitVy19)\n\n・服装はJR九州の制服(旧制服のみ)で制帽は男性のものと同じにしてください。\n・ワッペンは主任運転士を付けてください。\n服装の資料はこちらです:(https://photos.app.goo.gl/zwGAoqzgqXcd7y6H9)\n\n・客車はこの時点では連結していません\n・もし屋根上まで描くのでしたらパンタは両方とも下ろしている状態,ライトは一切点灯していない状態でお願いします\n\n以上となります。よろしくお願いいたします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hakojuri/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2531243, "client_id": 547336, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22ca575d/uploads/origins/deb9928c-572b-4e3b-ae87-ba4c7d26e5a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0784389af88f7db95b646bf9c64c851", "srcset": "https://si.imgix.net/22ca575d/uploads/origins/deb9928c-572b-4e3b-ae87-ba4c7d26e5a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0784389af88f7db95b646bf9c64c851, https://si.imgix.net/22ca575d/uploads/origins/deb9928c-572b-4e3b-ae87-ba4c7d26e5a1?b