uration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0145581e/uploads/origins/b4f4bd57-8276-4bd2-9522-930cb329bebd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3f45b583aa5f0864da67b80b1b5e4b3", "srcset": "https://si.imgix.net/0145581e/uploads/origins/b4f4bd57-8276-4bd2-9522-930cb329bebd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3f45b583aa5f0864da67b80b1b5e4b3, https://si.imgix.net/0145581e/uploads/origins/b4f4bd57-8276-4bd2-9522-930cb329bebd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c94b27a12e375e61565c2982ba0321fc 2x, https://si.imgix.net/0145581e/uploads/origins/b4f4bd57-8276-4bd2-9522-930cb329bebd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e7e767347c57b07e53765182a83397b9 3x"}, "body": "フタナリのシンシアがメカを操縦しているイラストを描いてください\n\n彼女はメカを使って世界征服を企んでいるため、悪役として描いてください。また、絶大な力を手に入れたことで興奮しており、ペニスが勃起している状態にしてください\n\nシンシアの服装とメカのコックピットについては、参考画像を参考にしてください。参考画像との違いとして、コックピットの、シンシアのペニスがあるべき位置の正面部分に、シンシアのペニスが突き出ているような（小さなオナホールのような）きつい穴があるように描いてください。また、メカを操作するためにハイヒールでペダルを踏んでいる様子が見えるよう、画像を少し引いて描いていただけますか\n\n最後に、シンシアが「これほどの力を手中に収めるのは最高だ」「世界は自分のものになり、人類はすべて自分の奴隷になる」といったことを語っている様子にしてください。そのような内容です。ハイヒールは必ず非常に高いものにしてください\n\nhttps://drive.google.com/drive/folders/1zzz4nlhdA55MkQAAGE77PRkdNHie82QI?usp=sharing", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hakobune4545/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3551046, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd48c9a3/uploads/origins/7c0dd6d7-2213-4338-8722-bc0c84ef3a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da31f587d162da3c695eaf40390fb0a8", "srcset": "https://si.imgix.net/cd48c9a3/uploads/origins/7c0dd6d7-2213-4338-8722-bc0