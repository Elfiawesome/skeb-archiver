んだけど、破壊を重ねるにつれて勃起していくんだ。\n\n最後に1ページ、勃起した彼女が世界は彼女のものだと宣言するシーン（全身）を追加できる？\n\nまた、スカートの下に彼女のペニスとタマタマを見せて、コマのいくつかで肌が見えるようにしてもらえないでしょうか。\n\n台詞は、彼女が世界を征服するのがどんなに楽しいか、そしてみんなが彼女の奴隷になるのがどんなに楽しいかという邪悪なことを言わせてください。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hakobune4545/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/84ff34ec/uploads/origins/092173b9-6722-44db-ad7c-d1227fd5b94c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3836aac9f8035a362af844682cbe297b", "srcset": "https://si.imgix.net/84ff34ec/uploads/origins/092173b9-6722-44db-ad7c-d1227fd5b94c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3836aac9f8035a362af844682cbe297b, https://si.imgix.net/84ff34ec/uploads/origins/092173b9-6722-44db-ad7c-d1227fd5b94c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9564b7deb1c4169193ff6beca4c2a65e 2x, https://si.imgix.net/84ff34ec/uploads/origins/092173b9-6722-44db-ad7c-d1227fd5b94c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e83264bcb3d2171400f7ccdbed85f60 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3551046, "nc": 50}], "sent_works": [], "similar_creators": [{"id": 42218, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "dnts", "screen_name": "YT_18over", "avatar_url": "https://pbs.twimg.com/profile_images/1537077542024523777/ga5vQGkX.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1363339981796765699/1655302818/1500x500", "appeal_receivable": false, "popular_