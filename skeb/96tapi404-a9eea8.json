uberキャラクターのアートをお願いしたいです！彼女は悪女です！ドライブリンクに2つのバージョンがあるので、好きな方を選んでください！1つは悪役の姿、もう1つは潜入捜査の姿です。\n\nポーズや表情も選べます。現代的なシチュエーションも描けます！このイラストはSNS、youtube、twitchで使わせていただきます。\n\n悪役令嬢として、彼女は残酷で、少しクレイジーですが、それでも破滅した王国と王座を守っています。しかし、恥ずかしがると慌てふためくこともある！ちょっとおバカなところもある。影の魔法が使える。\n\n潜入中の姿は現代に潜伏しており、趣味は悪役令嬢のイセカイ・コミックを読むこと、コーヒーを飲むこと、料理をすること。おっとりしているが、根は悪女！\n\nデザイン上の注意点人間の耳はありません。尻尾はありません。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1Gho4ZgPZntzqhR0AgjrJN0g_DXsyUITr?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1102656, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "犬のおしり", "screen_name": "inu_shiori", "avatar_url": "https://pbs.twimg.com/profile_images/1258929374834745344/YGzkNMcO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/916534054010228736/1639745386/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 0}, {"id": 1221918, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ザット", "screen_name": "zztzza", "avatar_url": "https://pbs.twimg.com/profile_images/1894263387745406976/NcjUZWyL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1713723963115978752/1769693251/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 1366068, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "お、", "screen_name": "ooo_0926", "avatar_url": "https://pbs.twimg.com/profile_images/1976456505617678337/k4n