をしていただけると大変助かります。 • 尺・テンポ： 具体的な長さやBPMは、EpicOrder様の作りやすい形で完全にお任せいたします。\n\nご検討のほど、何卒よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@order_epic/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": true, "creator_id": 3249190, "client_id": 3772464, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2068449874044182528%2FWWINx1Hd.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeed1390fb04861555cb06673e654a1f", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2068449874044182528%2FWWINx1Hd.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeed1390fb04861555cb06673e654a1f, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2068449874044182528%2FWWINx1Hd.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12774b9dc6ffca8f7601985f92a2d242 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2068449874044182528%2FWWINx1Hd.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b9680b8c50dd9116fb265e0787f2d60 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/f70ea454-8387-4cff-aa30-a65259a97ca0?response-content-disposition=inline&Expires=1786290284&Signature=ZYF-j7q9kto6ZCicJfENrC0d4UD82wDySeI16P9t1SdpGdfAAT8ApW-DD9nwI9jO-80jeXQquPGOJUTXvBOXwrSgLlLwr2-vcyOE7ZnidfyjgbJRrLLMGPTd0-18vurp0gWjY8jPA4nidpmfXPMg50oTMFtOt6TyhuSdQr4NUfsSYJm4OtceubsRNDQYekzxIiYOrOSOeS0anvUJ-uZrsuKsakHV9-l222s87mDyd4P8f1kaXssNfHot07Ho7sr-0uG8WPhSLL9LecyAdUiAFlrDVupsZNbAnnxvCuOjU6Om6pWCbtkIE1hl3VJEleSndxFhBb1sTPGruRL9tdhHbA__&Key-Pair-Id=K1GS3H53SEO647", "duration": 116, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprof