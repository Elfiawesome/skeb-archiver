es&sort=time 】\n\nまた、以前はこちらのフリーBGMも愛用されていました。\n【 https://www.youtube.com/watch?v=JtKEtP1AD5Y&t=2s 】\n\nもしお時間がありましたら、ご検討よろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@order_epic/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": true, "creator_id": 3249190, "client_id": 3772464, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2068449874044182528%2FWWINx1Hd.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeed1390fb04861555cb06673e654a1f", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2068449874044182528%2FWWINx1Hd.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeed1390fb04861555cb06673e654a1f, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2068449874044182528%2FWWINx1Hd.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12774b9dc6ffca8f7601985f92a2d242 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2068449874044182528%2FWWINx1Hd.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b9680b8c50dd9116fb265e0787f2d60 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/c4236ba5-d954-430a-85eb-9792b4cb0a0b?response-content-disposition=inline&Expires=1786290284&Signature=eJGzOIl0co86DI-Jhz1GnnCT8nQIz6yDOfUWxdFgzgwoqPz7FyClueeKLPI~bXP2mUSN5thlJqwJr02yIA8CbzT3cEherz11nQk1rbmMi6R-BgXWPvKeU3QwkgL8W78AEmqT45oNeIwHXdRNoE-~mHpWESPHlnHTQ2S7fefTOr6BtDXK7Xt5cAoes5f3FgPZthnk8oKZCl2sFzMQHsz~doCFtsxk~28y3ePxAaJ7fWTjnuZs1YzlvFlGbb8luvWSGXjemKeWrKN7ILbCe-IDEZ8JLvyphQ3laaJZ60yDuBF8sUPCCZhAiP0RNiJeH2FsC75vcDDPF-d4B00IeVK-nQ__&Key-Pair-Id=K1GS3H53SEO647", "duration": 110, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.n