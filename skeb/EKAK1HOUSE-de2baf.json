=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f8350720f0124664549c3ecdbeb794b 2x, https://si.imgix.net/21c04cc7/uploads/origins/9f2b70eb-45c8-43cf-90c1-2b2647f89ba4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e44115e2c6e397303e50eb4b0d8e3958 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21c04cc7/uploads/origins/9f2b70eb-45c8-43cf-90c1-2b2647f89ba4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d81b411b4a31bdf11b2ec8ea2b8273a9", "srcset": "https://si.imgix.net/21c04cc7/uploads/origins/9f2b70eb-45c8-43cf-90c1-2b2647f89ba4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d81b411b4a31bdf11b2ec8ea2b8273a9, https://si.imgix.net/21c04cc7/uploads/origins/9f2b70eb-45c8-43cf-90c1-2b2647f89ba4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6bc5535fc70359b110c948a42c48408d 2x, https://si.imgix.net/21c04cc7/uploads/origins/9f2b70eb-45c8-43cf-90c1-2b2647f89ba4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=911c84eb2b15cf3de0733c6d399eb03b 3x"}, "body": "遊戯王からマスターに見抜きさせてくれるRAI-MEIをリクエストします。\n\nキャラの造形は\n・頭身高めの全身むちむち\n・へそに届き下腹部がギリギリ隠れない程度の爆乳(前回よりもう一回り大きいと嬉しいです)\n・服装は原作と同じ物で、乳首と乳輪は共に大きめかつ勃起状態&パフィーニップルが衣装越しにくっきり浮き出ている。\n・性格のイメージは優しくて少しSっ気もあるお姉さん\nといった感じでお願いします。\n\n構図は頭のてっぺんから股間までを写したバストアップを、以下のようなシチュエーションでセリフ付きの差分を用意して欲しいです。\n\n1枚目：ニヤけた表情でこちらを煽り、今からオナペットになることを宣言してオナニーを催促してくる。\n\n2枚目：わざとらしく大袈裟なアへ顔と媚びるような喘ぎ声を見せて射精を催促してくる。\n\n3枚目：射精後。優しい態度で褒めてくれる。\n\n前回に引き続き同じキャラクターの依頼になりますがよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@EKAK1HOUSE/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2739649, "client_id": 1366155,