く定まっていませんので、もし描かれる場合は自由にお願いします）\n描きやすい服装で可愛く、楽しく描いていただければ幸いです。\n\n構図やポーズ、描写する範囲、イラストサイズ、納品形式すべてお任せします。\n細部もわからない部分などありましたら自由に描いていただいて大丈夫です！\n\n頂いたイラストは自身の保有するSNSなどのアカウントにてアイコンやヘッダーとして使用する可能性があります。\nよろしくお願いします！\n\nhttps://skeb.jp/@sunajiro8", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1531127, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "采子", "screen_name": "nut_saiko", "avatar_url": "https://pbs.twimg.com/profile_images/1851327580034801664/OAvpZD88.png", "header_url": "https://pbs.twimg.com/profile_banners/2297649247/1675339650/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 2086691, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぜろ", "screen_name": "zero2_CheerS", "avatar_url": "https://pbs.twimg.com/profile_images/1907824191895949312/n_6q91oT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1477235667268956163/1655219596/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 2806768, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "柊 ましろ", "screen_name": "mashiro_v_046", "avatar_url": "https://pbs.twimg.com/profile_images/1904485648087891968/7c4d20q_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1674379703128559618/1754731873/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptab