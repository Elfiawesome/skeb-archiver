ハイライト無し、無表情気味\n・巨乳、狐娘\n・服装　下はクリがはみ出るほどの極小紐パン、ニーソックス、ブーツ\n　上は黒インナー、マイクロビキニ、マフラー\n・小指の先ほど大きく開発されたクリトリス\n・乳首とクリトリスとヘソにピアス\n\nキャラの設定(性格や体質や弱点など)\n・ファンタジー系異世界で冒険者(アサシン職)をしてる\n・クリトリスの感度が非常に高くすごく弱い\n・ちんぽに弱い\n・馬ちんぽにもっと弱い\n・馬ちんぽにすごく弱い\n・馬ちんぽにとても弱い", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BanuFure/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/38efce85/uploads/origins/8aa58d1d-d0c7-4c6b-968f-298af05ca5f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f126f9295b634d40fec4efef60f1d46d", "srcset": "https://si.imgix.net/38efce85/uploads/origins/8aa58d1d-d0c7-4c6b-968f-298af05ca5f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f126f9295b634d40fec4efef60f1d46d, https://si.imgix.net/38efce85/uploads/origins/8aa58d1d-d0c7-4c6b-968f-298af05ca5f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=264d307cc91b84b2199ccf693f41d0c8 2x, https://si.imgix.net/38efce85/uploads/origins/8aa58d1d-d0c7-4c6b-968f-298af05ca5f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de456973bb1eeceb37f5b34048a40ef8 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 403490, "nc": 32}, {"path": "/@BanuFure/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 403490, "client_id": 94332, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/018033e2/uploads/origins/3ce2f2b9-14ad-4710-a51c-42b2f4fbe71f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cr