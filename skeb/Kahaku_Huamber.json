a37", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3562731, "client_id": 2516108, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Kahaku_Huamber/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3562731, "client_id": 79576, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f041fd02/uploads/origins/53280be8-389c-4167-9931-144afaa91596?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32357edd52a9a382883e3f9628ff66cd", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f041fd02/uploads/origins/53280be8-389c-4167-9931-144afaa91596?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96bf1e20f685c1bcb8c162f7dc9d1561", "src_set": ""}, "body": "华柏餅さん、こんばんは！\nskeb始められたのに気がつきました。\nリクエストを送るので宜しければご検討ください。\n\nうちのこのフカバミかカミチを描いてみてくださいませんか？\n構図やシチュ、衣装など全てお任せしますので、お好きなほうを描いてください！\n2人とも胸はどれだけ大きくても良いです。\nぜひ宜しくお願いします！\n\nフカバミ\nhttps://drive.google.com/drive/folders/1-3mD8PkicZ09BTpPouT0PcS12eo08rSF\n\nカミチ\nhttps://drive.google.com/drive/folders/1-cFf1cFjiEQO70VVD_CCI48Z96KztLGb", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "from_archive": true}