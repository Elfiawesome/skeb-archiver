b76ff5aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=632bf54bffd17910023d803f84b5cfad", "srcset": "https://si.imgix.net/f500a4f4/uploads/origins/065bf864-ca1c-4461-a38d-0b8b76ff5aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=632bf54bffd17910023d803f84b5cfad, https://si.imgix.net/f500a4f4/uploads/origins/065bf864-ca1c-4461-a38d-0b8b76ff5aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b6f4a6d14851e241ca6b3b81bc424d5c 2x, https://si.imgix.net/f500a4f4/uploads/origins/065bf864-ca1c-4461-a38d-0b8b76ff5aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f854fbb41572c3d26bc10cae5588c476 3x"}, "body": "こんにちは、yukkiy様！いつもBluesky経由で見せて頂いております、幻想的で可愛らしく、そして素晴らしく緻密なイラストの数々！かねてよりとても憧れがありまして、現在新たな依頼はなかなか難しいとのことですが、Bluesky連携開始を機に一度お願いさせて頂きたくて参りました。\n\nyukkiy様のお筆に是非あやかりたいと思ううちのOCに「季節妖精・ニッセ」がおります。\n先に資料をご覧頂きたいですが、資料のビジュアルと設定と元にして、yukkiy様流にアップグレード、もうほとんど気のままに新たなビジュアルを授けて頂けないかと思います。\n\n特に、彼女は冬にだけ現れるため実質「冬の妖精」にもあたりますが、本質は「厳しい冬の間、他の三つの季節をその身に匿う者。それらの眠りを守る番人であり、目覚めを見届ける揺りかご」という役割が形を得た存在です（「クリスマスの妖精」も兼任しますが、クリスマスもまた由緒を辿ると「次の季節の実りを祈るための儀式」という側面を持つと聞いています）。\n原案は私のデザイン力の限界もあってシンプルに冬の要素だけを前に出していますが、「冬＋クリスマス」を軸にはしつつ、その小さな体に収まり切らない豊潤な〝季節〟を身にまとう姿として、yukkiy様には新たに表現して頂けないだろうかと思っています。\n\nなお、私の「ニッセ」（2024初出）は自作小説作品『クラウス・カプセル・シングアソング』の登場人物です（確認リンク：https://xfolio.jp/portfolio/yodom_bee/series/1648571）。ご納品頂けたものについてですが、SNS等でのOC紹介に加え、原作関連アートと呼べる範囲で飾らせて頂くこともお許し願いたく思います（サムネイル、宣材内掲載含む）。常に他作として明記、非商用・リワードオフ・オンクレジットの条件下で。なお掲載時には転載・第三者利用防止を兼ねた低解像度化や自前のウォーターマーク、ノイズの追加をさせて頂くことがあります。X、META社系列SNSへの投稿はこちらでは致しません（現在同名義アカウントなし）。さしあたってはご自分のサインを入れて頂けると助かります。\n\nご都合に適わぬようでしたらまったくおかまいなく。ご検討だけでも幸いです。よろしくお願い致します。\n\nhttps://ln5.sync.com/dl/afe9d0260#6rkmiqdf-cuijhndn-vx9q8m8t-w2bszpjt", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukkiy89406564/works/6", "private_thumbnail_image_urls": null, "private": false