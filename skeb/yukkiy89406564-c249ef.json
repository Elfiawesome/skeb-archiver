く、司書のように少し物静か。しかし信念は強く、物事をよく考えてから行動する。\n\nもちろん、その他の詳細はお任せします。自由に加えたり削ったりしてください。どんな作品ができるのか楽しみにしています！\n\n参考文献：https://drive.google.com/drive/folders/1Am6V1EkJ7vr6XVfbsdCsV0O2sW65vrGL", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukkiy89406564/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2342492, "client_id": 2260929, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3b460c2a/uploads/origins/3c829cc6-0667-402d-9e64-92cccf944a12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0302829974d840c6485dd7694751d4de", "srcset": "https://si.imgix.net/3b460c2a/uploads/origins/3c829cc6-0667-402d-9e64-92cccf944a12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0302829974d840c6485dd7694751d4de, https://si.imgix.net/3b460c2a/uploads/origins/3c829cc6-0667-402d-9e64-92cccf944a12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d8c7a6a11be387bd60011e39804d784 2x, https://si.imgix.net/3b460c2a/uploads/origins/3c829cc6-0667-402d-9e64-92cccf944a12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80bc6d4f87f08398afdc40670d14830a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b460c2a/uploads/origins/3c829cc6-0667-402d-9e64-92cccf944a12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c95665972126d7489c140fcc43cbba0a", "srcset": "https://si.imgix.net/3b460c2a/uploads/origins/3c829cc6-0667-402d-9e64-92cccf944a12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c95665972126d7489c140fcc43cbba0a, https://si.imgix.net/3b460c2a/uploads/origins/3c829cc6-0667-402d-9e64-92cccf944a12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5facc51adf4b206034758e01cf2d81ee 2x, h