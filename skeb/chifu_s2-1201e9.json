3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed409f43f9c55c4fbb43bcd051c723e6, https://si.imgix.net/6b9a8929/uploads/origins/39fa3a2b-bfc4-45bd-83b8-27225b9423e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60574da7e1411bdac55c2094e5a63233 2x, https://si.imgix.net/6b9a8929/uploads/origins/39fa3a2b-bfc4-45bd-83b8-27225b9423e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9db03b32a88d5c43660f0d16d573cb61 3x"}, "body": "こんにちは！お久しぶりです！\n前回は素敵なイラストを描いてくださり、ありがとうございました！またぽに様に依頼したいと思いリクエストさせていただきました！\n\n依頼内容は、以前描いてくださったキャラクターの表情や衣装の別バージョンのイラストを描いていただきたいです！配信画面での使用を考えています。\n(グッズなどでの商用利用は致しません)\n\n下記参考資料になります。\nhttps://drive.google.com/drive/folders/1O7_SOIQHSeZrauDZOizBZcUIlUTWfvzu\n\n要望としては、\n\n・以前描いていただいた(参考資料の画像)の髪色、髪型、鬼のツノ、オッドアイ、両耳にピアス\n\n・表情は少し優しく微笑んでいる\n\n・服装は黒のカーディガンに赤ネクタイの制服\n\n・黒ぶちのメガネをつけている\n\n・顔は正面よりかは少し右を向いてるような角度(こちらから見て左)\n\n・画像比率は縦長で上半身\n\n・背景は透過にしていただけると助かります\n\n上記以外の部分についてはぽに様にお任せいたします！\n\nもし不備等あれば修正して送り直しますので何卒ご検討のほどお願いいたします。\n\nお忙しいところ恐れ入りますがよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1O7_SOIQHSeZrauDZOizBZcUIlUTWfvzu", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chifu_s2/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3312975, "client_id": 3021279, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1529f1cc/uploads/origins/b4431020-a3be-4a49-a490-3ec430c6a1ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44a83fed130265f16c0569f43b20aff3", "srcset": "https://si.imgix.net/1529f1cc/uploads/origins/b4431020-a3be-4a49-a490-3ec430c6a1ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44a83fed130265f16c0569f43b20aff3, https://si.imgix.net/1529f1cc/uploads/origins/b4431020-a3be-4a49-a490-3ec430c6a1ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b07cd890e3f4b9f247ee8af9ea49d9e7 2x, https://si.imgix.net/1529f1cc/uploads/origins/b4431020-a3be-4a49-a490-3ec430c6a1ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35765d48a5b100ad0f2e8fc409e91011 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1529f1cc/uploads/origins/b4431020-a3be-4a49-a490-3ec430c6a1ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2055f82e1b33829545869a2d88f5a5c6", "srcset": "https://si.imgix.net/1529f1cc/uploads/origins/b4431020-a3be-4a49-a490-3ec430c6a1ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2055f82e1b33829545869a2d88f5a5c6, https://si.imgix.net/1529f1cc/uploads/origins/b4431020-a3be-4a49-a490-3ec430c6a1ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f79c91042d8564c23b0910a8168077d 2x, https://si.imgix.net/1529f1cc/uploads/origins/b4431020-a3be-4a49-a490-3ec430c6a1ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8566f962a25d6276fd63b835fb595f91 3x"}, "body": "ぽに様\n初めまして、個人VTuberで配信活動をしております陽向こまと申します。今回歌ってみたのイラストのご依頼先を探していたところ、ぽに様の作品を拝見しまして、かっこいいイラストに惹かれてリクエストさせて頂きました。\n\n【使用用途】\n・youtubeでの歌ってみたＭＶ使用\n・youtube配信用サムネイル\n・SNSでのアイコンやＸでの広報\n\n楽曲はピノキオピー様の神っぽいななので、シスター服を着た私の姿を描いていただければ幸いです。ぽに様のかっこいいイラストが大好きなので、イラストは原作には寄せずに、ぽに様のタッチで描いて頂きたいです。(原作は色味がありませんが、今回はカラーで描いて頂きたいです)\nポーズや表情、アクセサリーの追加や露出の加減等は、ぽに様にお任せ致しますのでお好きに変更頂いて構いません。(モノクルは付けてほしいです)動画編集の都合上、人物の両端と頭部が見切れない構図でお願い致します。\n描いて頂く範囲は可能であれば全身が希望ですが、金額的に難しいければ膝上もしくは腰上でも構いませんし、再送頂いても結構ですのでご検討ください。立ち絵資料はGoogleドライブを添付しますのでご確認ください。\n\n納品の際は人物のみの透過ファイルも頂戴したいので、御手数ですがレイヤー分けされたPSDファイルで頂戴出来れば幸いです。\n\nご多忙かとは存じますが、ご検討の程どうぞよろしくお願い致します。\n\nhttps://drive.google.com/file/d/1UUUB-YHF4OHdCXI7mOHcYqvQsTUWeqwf/view?usp=drivesdk", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genr