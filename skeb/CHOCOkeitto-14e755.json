なと思いリクエストさせていただきました！\n構図はお任せ致します！！\n\n【使用用途】\nYouTubeのサムネイルやXでの投稿など、活動全般で使用させて頂きたいです。\nXのポストにて商用利用可能と書かれていましたのでグッズなどの作成をさせて頂けると嬉しいです。\n不可な場合別用紙にて記載下さると助かります\n\n【お願いしたい形式】\nPSDデータでの納品をお願いしたいです。\n(不可な場合それぞれがレイヤー分けされたPNGデータ)\n\n人物と背景が分かれているデータと文字が入る場合はこちらもレイヤー分けして頂きたいです。\n人物の頭や左右(髪の毛など)が切れないようにお願いしたいです。\n（使用させていただく際に自由度が高まり大変助かります）\n\n【デザインについての追記】\n・髪は白髪よりのアッシュで毛先が黒のグラデーションになっています。\n・瞳は赤で黄色(ゴールド)っぽい色が入っています。\n・腰の部分にあるバラの装飾はペタッとつぶれてる感じです。\n・胸の白いラインと胸上の髪の毛忘れられがちなので忘れないでくれると嬉しいです。\n・小さいオオカミキャラがいるのですが、分身なので私のケモ耳とオオカミキャラが一緒になることはありません。\n・私の雰囲気としては可愛いよりもカッコいい感じで活動しています。\n\n以下資料URLを置かせていただきます。\nご縁がありましたらどうぞよろしくお願い致します！\n\n◆衣装資料\nhttps://x.com/DomotoMahiRo/status/1805150941403898210\n◆解釈図\nhttps://x.com/DomotoMahiRo/status/1824052518659506623", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@CHOCOkeitto/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2459314, "client_id": 1299539, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5e1d44e/uploads/origins/7b6ad2bf-3f25-439a-988d-b87d2aba78a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=345863b6df96db3532dfcf9fa601ae39", "srcset": "https://si.imgix.net/c5e1d44e/uploads/origins/7b6ad2bf-3f25-439a-988d-b87d2aba78a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=345863b6df96db3532dfcf9fa601ae39, https://si.imgix.net/c5e1d44e/uploads/origins/7b6ad2bf-3f25-439a-988d-b87d2aba78a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=761aa6409976ce0e134a0b889dda2b1f 2x, https://si.imgix.net/c5e1d44e/uploads/origins/7b6ad2bf-3f25-439a-988d-b87d2aba78a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f3937b15f8dd8d76638874db91434f8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5e1d44e/uploads/origins/7b6ad2bf-3f25-4