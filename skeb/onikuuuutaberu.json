不幸にすると思って、本編では離れて行動しているけど、互いに想いあっているような関係です。\n前世からずっと両片思いを続けてきた互いへの気持ちが強いCPになります。\n\nシチュエーションはお任せいたします。描きたいシチュで描いていただければと思います。\nキャラを見て何か感じるものがあって漫画の形で描きたいと思えば、漫画で描いていただいても構いません。\n一応NSFWの設定していますが、NSFWなシチュでもそうじゃなくてもOKです。\nキャラを大切にしていただければ、お好きなように描いていただいて問題ありません。\n\nご検討、よろしくお願いいたします。\n作品紹介ページも載せておきます。\n\nhttp://primitive-species.com/geraniumseries/#toc8", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@onikuuuutaberu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3242682, "client_id": 2730915, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28ed63e2/uploads/origins/50f2c6ea-9daf-4a4c-acb0-d5ca31a3b946?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18c6dcdba72099b30e22c8951f2a5ae9", "srcset": "https://si.imgix.net/28ed63e2/uploads/origins/50f2c6ea-9daf-4a4c-acb0-d5ca31a3b946?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18c6dcdba72099b30e22c8951f2a5ae9, https://si.imgix.net/28ed63e2/uploads/origins/50f2c6ea-9daf-4a4c-acb0-d5ca31a3b946?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f957cfabba375322cf7c2973f92b2303 2x, https://si.imgix.net/28ed63e2/uploads/origins/50f2c6ea-9daf-4a4c-acb0-d5ca31a3b946?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=034a2aed151d088e21dfb882884a27cd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28ed63e2/uploads/origins/50f2c6ea-9daf-4a4c-acb0-d5ca31a3b946?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efd3dfd67cb526962196bf6a8f3b75ee", "srcset": "https://si.imgix.net/28ed63e2/uploads/origins/50f2c6ea-9daf-4a4c-acb0-d5ca31a3b946?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efd3dfd67cb526962196bf6a8f3b75ee, https://si.imgix.net/28ed63e2/uploads/o