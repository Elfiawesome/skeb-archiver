08c5-f7a0-424f-bd82-e4f605a82f66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51da53d0fa497a8e53a55515d6550073 2x, https://si.imgix.net/bf3d10e9/uploads/origins/d19908c5-f7a0-424f-bd82-e4f605a82f66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a292b7364addb879dfba246ecac32114 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf3d10e9/uploads/origins/d19908c5-f7a0-424f-bd82-e4f605a82f66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf2e7be19e849e9bfb4f2e09f7e86451", "srcset": "https://si.imgix.net/bf3d10e9/uploads/origins/d19908c5-f7a0-424f-bd82-e4f605a82f66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf2e7be19e849e9bfb4f2e09f7e86451, https://si.imgix.net/bf3d10e9/uploads/origins/d19908c5-f7a0-424f-bd82-e4f605a82f66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=111ebe62fe020b520bc04695ecf70c6f 2x, https://si.imgix.net/bf3d10e9/uploads/origins/d19908c5-f7a0-424f-bd82-e4f605a82f66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e2bc7234ccc6474bfdf72db30b43b08d 3x"}, "body": "朝顔みのる 様\n\n初めまして。\n個人でバーチャルシンガーソングライターの活動をしております、星灯つぐみと申します。\n\n朝顔みのる様の描かれる透明感と優しさの溢れるかわいいイラストがとても好きで、\n是非 私の活動イラストをお願いしたくリクエストさせて頂きました。\nもし条件に合いましたらお引き受け頂けますと嬉しく存じます。\n\n【 キャラクター 】\n星灯つぐみ / 優しいお姉さんイメージ\nモチーフ：星あかり(星空)\n見た目・衣装(立ち絵)：\nhttps://drive.google.com/file/d/1f3IiDduDWyrNs28YrEU2Ny4VyhEAVImt/view?usp=sharing\nイメージカラー：白・くすみパステル系の水色と紺色\n\n【 リクエスト内容 】\n顔：両目の開いたものでお願いいたします。\n構図：正面 または 正面気味の構図で頭・髪の切れていないものを頂けますと大変助かります。\nポーズはおまかせいたします。\n衣装：朝顔みのる様のデザインセンスが大好きなので、可能でしたらオリジナル衣装でお願いできますととても嬉しいです。\n(もしオリジナル衣装で描いて頂ける場合、胸元が空いたものでお願いしたく存じます)\n\n【使用用途】\nサムネイル・SNSのプロモーション・CDの特典グッズなどに使用させて頂きたく存じます。\n(お手間をおかけして恐縮ですが、もしNGなものがございましたらレイヤーなどに記載頂けますと幸いです)\n\n【納品につきまして】\nPNG または PSDで納品をお願いできますと嬉しく存じます。\nまた背景を描いて頂ける場合、人物と背景のレイヤーを分けて頂けますと大変助かります。\n\nご多忙のところご一読頂きありがとうございました。\n是非 ご検討頂けますと幸いです。\nよろしくお願いいたします……！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@GaoGao_mnr/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2103554, "client_id": 2946553, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8ec0f14/uploads/origins/aab40d6a-036f-4dd5-9983-e98bec7d5f0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85c119af60ec608f82306e49c0e3b77f", "srcset": "https://si.imgix.net/a8ec0f14/uploads/origins/aab40d6a-036f-4dd5-9983-e98bec7d5f0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85c119af60ec608f82306e49c0e3b77f, https://si.imgix.net/a8ec0f14/uploads/origins/aab40d6a-036f-4dd5-9983-e98bec7d5f0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2ef5b0ad254b733767fe8b28d45f4ad 2x, https://si.imgix.net/a8ec0f14/uploads/origins/aab40d6a-036f-4dd5-9983-e98bec7d5f0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8dde15e31bc201ebe7d71458195fbb6a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8ec0f14/uploads/origins/aab40d6a-036f-4dd5-9983-e98bec7d5f0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98905959649b4919541a534ba79e0246", "srcset": "https://si.imgix.net/a8ec0f14/uploads/origins/aab40d6a-036f-4dd5-9983-e98bec7d5f0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98905959649b4919541a534ba79e0246, https://si.imgix.net/a8ec0f14/uploads/origins/aab40d6a-036f-4dd5-9983-e98bec7d5f0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2dabc68663af88af1f0e13a6cfc527b9 2x, https://si.imgix.net/a8ec0f14/uploads/origins/aab40d6a-036f-4dd5-9983-e98bec7d5f0b?bg=%23fff&auto=format%