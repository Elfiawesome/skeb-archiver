す。\n\nキャラ：海伊\nhttps://drive.google.com/drive/folders/1Z3gfdm9o_PMQNv6cKAR-1Tk4Wr45rewI?usp=sharing\n\n新衣装デザイン三面図\n①服装：水着\n②服の色：白　青　ピンク\n③できれば水着のかわいい要素と色気の要素をバランスよくデザインして、海伊ちゃんのかわいい姿を表現しながら海伊ちゃんのスタイルの良さを際立たせてください。\n④個人的な性癖のため、先生が海伊ちゃんの太ももと足の指を際立たせるようなデザインをしてほしいと思っています。\n⑤浮き輪やサングラスなどの小物を追加してほしいですが、その部分は先生にお任せします。\n⑥以上です。不明な点は全てお任せします。\n\n水着イラスト\nシチュ：構図と背景は先生の自由に任せてください。\n①できれば青、水に関係しています。\n②できればクラゲに関する要素を加えてください\n③海伊ちゃんの太ももと足の美しさを強調してください。\n④サイズは16:9を希望します。パソコンの壁紙に使用される可能性があるからです。\n\n\nリクエスト内容や金額に不備がある場合はキャンセル頂いて問題ございません。内容と金額を調整して再送します。\nご検討の程、宜しくお願い致します。\n\nhttps://dic.pixiv.net/a/%E6%B5%B7%E4%BC%8A", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@GaoGao_mnr/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2103554, "client_id": 2782819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc60f466/uploads/origins/1a174347-12d8-47af-af35-c53d8eeb6742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9b33b8d6d4f4d9945a2c9edaee167e5", "srcset": "https://si.imgix.net/dc60f466/uploads/origins/1a174347-12d8-47af-af35-c53d8eeb6742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9b33b8d6d4f4d9945a2c9edaee167e5, https://si.imgix.net/dc60f466/uploads/origins/1a174347-12d8-47af-af35-c53d8eeb6742?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d99ae79e125d409da7db1dd9cb2a31ba 2x, https://si.imgix.net/dc60f466/uploads/origins/1a174347-12d8-47af-af35-c53d8eeb6742?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ffb88e99dd52bce8845f9704ea2fda30 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc60f466/uploads/origins/1a174347-12d8-47af-af35-c53d8eeb6742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9819a279fff37be1315982321656d8b