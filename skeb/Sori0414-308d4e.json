はお任せします。\n外見はコワモテですが、性格は大らかで温厚、献身的、そして夢見がちです。\n\nシチュエーションは、絵本の新作を描いている場面でお願いします！（彼女の職業は絵本作家です）\n彼女が使用している画材は水彩色鉛筆です。構図などに悩んでいる感じでお願いします！\n\nhttps://www.dropbox.com/scl/fi/fnv0efbwsd7hv5h2mx659/.png?rlkey=l7yogtbiaypy3v2pdjeg5sfng&st=q4kk25x1&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sori0414/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3352930, "client_id": 759223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b492cd0/uploads/origins/5c47e59c-023b-4651-a134-235a5c218de4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1227d66ab8ea21add06bd4231a411b3d", "srcset": "https://si.imgix.net/2b492cd0/uploads/origins/5c47e59c-023b-4651-a134-235a5c218de4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1227d66ab8ea21add06bd4231a411b3d, https://si.imgix.net/2b492cd0/uploads/origins/5c47e59c-023b-4651-a134-235a5c218de4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fd259335c3acacff7d539018728d0c4 2x, https://si.imgix.net/2b492cd0/uploads/origins/5c47e59c-023b-4651-a134-235a5c218de4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f33110dc112a2ba4c31809bd400ec50b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b492cd0/uploads/origins/5c47e59c-023b-4651-a134-235a5c218de4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5eb302735f54b767371a23a354b1ea0c", "srcset": "https://si.imgix.net/2b492cd0/uploads/origins/5c47e59c-023b-4651-a134-235a5c218de4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5eb302735f54b767371a23a354b1ea0c, https://si.imgix.net/2b492cd0/uploads/origins/5c47e59c-023b-4651-a134-235a5c218de4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=20