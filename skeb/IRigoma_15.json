re": "art", "tipped": false, "creator_id": 3091363, "client_id": 3434968, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7590bf4b/uploads/origins/80f2fe38-eeca-4ac9-8da8-8a1b6005a012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8448688b459b702a6faac3f4b4b6645c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7590bf4b/uploads/origins/80f2fe38-eeca-4ac9-8da8-8a1b6005a012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cd80113258ee9c64c7afe1a545ad3e7", "src_set": ""}, "body": "はじめまして。梅花（メイフォア）と申します。\nVTuberとして活動をしております。\n\nアピールありがとうございます！\nぜひうちの子を描いていただきたく、リクエストさせていただきます。\n\n明るい雰囲気で、梅花と小李の仲のよいところを描いていただきたいです。\n細かい構図などはお任せいたします。\n\nYoutubeのサムネイル、各種SNSで使用させていただきます。\n頭の先が見切れないように描いていただけますとありがたいです。\n\nキャラクターイメージ\n・のんびり、やわらかい、チャイナの黒い円ぶち眼鏡っ娘\n・瞳はオッドアイで、右目が紫、左目がピンクです。抱えているのは小李（シャオリー）という白猫です。\n\nキャラのみ透過で使用できるよう、PSDのデータか、透過のPNGファイルをいただけると助かります。\n長くなってしまいましたが、ご検討の上、どうぞよろしくお願いいたします。\n\nhttps://x.com/meihua0707/status/1805946412582179098/photo/1\n\nhttps://x.com/meihua0707/status/1901841907493564609\n\nhttps://x.com/meihua0707/status/1901841907493564609", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@IRigoma_15/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3091363, "client_id": 834133, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f7baf2cf/uploads/origins/6eafe77f-f3fd-4c63-af79-09c0111a244b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e85375457fa58bc42b9076a8b37b43b0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f7baf2cf/uploads/origins/6eafe77f-f3fd-4c63-af79-09c0111a244b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=