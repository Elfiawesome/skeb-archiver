せていただければと思っております。\n\n立ち絵などの資料は下記URLから確認していただければと思います。\n\n\n\nスケブでの依頼は慣れていないので至らない点があると思いますが、よろしくお願いします。\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nhttps://lit.link/mewaurora\n\nhttps://lit.link/mewaurora", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 101591, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "YahaKo やはこ", "screen_name": "yahako", "avatar_url": "https://pbs.twimg.com/profile_images/1942779600310046720/uOGWTYc8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/20900940/1759586169/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 21, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 17}, {"id": 263850, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "えんがわ🍣skeb open!", "screen_name": "engawa110", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F8f728b08-19a2-4105-829a-adbe7b98fa1f.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fabc4d71-23dc-476a-8210-af0e559474b3.webp", "appeal_receivable": false, "popular_creator_rank": 12, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}], "nc": 176}, {"id": 2185812, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "108", "screen_name": "primula108", "avatar_url": "https://pbs.twimg.com/profile_images/1518117401438552066/z18EUFUz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1491619311063945218/1741157030/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_req