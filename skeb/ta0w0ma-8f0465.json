vate_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 76527, "client_id": 2585784, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d17239fa/uploads/origins/b194191b-cbee-43ba-9d46-a60f09752f57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b89e2e2898341d3c3f3aa1efd2b4a412", "srcset": "https://si.imgix.net/d17239fa/uploads/origins/b194191b-cbee-43ba-9d46-a60f09752f57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b89e2e2898341d3c3f3aa1efd2b4a412, https://si.imgix.net/d17239fa/uploads/origins/b194191b-cbee-43ba-9d46-a60f09752f57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f4ac3274a790ff1beae4b7dc272395d 2x, https://si.imgix.net/d17239fa/uploads/origins/b194191b-cbee-43ba-9d46-a60f09752f57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4c6fb560489a89c0bfad16cb3765d28 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d17239fa/uploads/origins/b194191b-cbee-43ba-9d46-a60f09752f57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd273efcb91e7596441b86e83e4a6ed1", "srcset": "https://si.imgix.net/d17239fa/uploads/origins/b194191b-cbee-43ba-9d46-a60f09752f57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd273efcb91e7596441b86e83e4a6ed1, https://si.imgix.net/d17239fa/uploads/origins/b194191b-cbee-43ba-9d46-a60f09752f57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d2199a75218135d6351188f96e8e23b6 2x, https://si.imgix.net/d17239fa/uploads/origins/b194191b-cbee-43ba-9d46-a60f09752f57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cfa1dac3fa445b8855bc80e014ad0c83 3x"}, "body": "いつもお世話になっております〜！前回はお忙しそうな所ありがとうございました！チャイ〜ナな2人にヒデアキちゃんまでたくさん見られて大満足でした！！\n前回のイベントでお迎えしたステッカーと色紙、可愛がらせて頂いております〜！日頃からXにていいね等の反応頂けてとても嬉しいです！\nた•ω•まさんの子達めちゃくちゃ可愛いんですよ！もっと流行れ〜！！現在絶賛激アツキャンペーン中なのと依頼募集のポストを見かけて、また描いていただこうかな…！？と思っていたところのカフェアキちゃん！？！？！かわいいいいいい〜！！！\nそんな気持ちのままに再びご依頼させて頂きました！お付き合い頂ければ幸いです！\n\n「戦国乙女シリーズ」より、天使コスの「ヒデアキちゃん」&堕天使コスの「カシアキちゃん」をお願いします！\n\n・全年齢\n・普通orデフォルメどちらでも、た•ω•まさんの絵柄がいいです！\n・ヒデアキちゃんをベースにカシアキちゃんにして頂いても何でも大丈夫です！\n\n・大好きな二人が可愛すぎて私の天使なのでいっそ天使のコスプレをしてみてほしいという妄想です！\n\n・衣装　ヒデアキちゃんには白い天使の衣装、カシアキちゃんには黒い堕天使の衣装を着せてあげてほしいです！\n下のURL群を参考にしてください！あくまで私のイメージなので、オリジナルの衣装を着せたり、天使衣装を黒にしたものを堕天使とするなどでもOKです！！\n\n☆天使\nhttps://drive.google.com/file/d/1ADpjRtgqMSoYPdkvWePvjBKrLzfrFNNT/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1QE1BA6zuifVvbLnPN98yBHEvbizxd3Ar/view?usp=drivesdk\n\n(デフォルメ)https://drive.google.com/file/d/1tvf6FIscZqBFLPGgtk9p_FyJeep7b8AX/view?usp=drivesdk\n\n★堕天使\nhttps://drive.google.com/file/d/1Pk9B0bbcdsH49nA3juOnZR_8oXUKJQN1/view?usp=drivesdk\n\n(デフォルメ)https://drive.google.com/file/d/15oBgziT0s3on87HcKVX958m3Ty9C_cDE/view?usp=drivesdk\n\n☆天使(白&黒テル様)\nhttps://pbs.twimg.com/media/GUgPZy-XsAA5fPL?format=jpg&name=large\n\n・表情　ヒデアキちゃんは笑顔、カシアキちゃんは「我は天使なんかじゃないぞ…」と照れている感じをイメージしています。天使のはなざーさん…？どこかで見覚えがありますね……？\n\n・持ち物　武器等無し、手ぶらで構いません！\n\n・その他細かな表現はお任せいたします。\n\nあーっ！昨年に続きまたしても忙しい時期に…！しかも2キャラですみません〜(；△；)イベントの準備や他の依頼等忙しい所大変恐縮ではございますが、御縁がございましたらその際はよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ta0w0ma/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 76527, "client_id": 2585784, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b303168d/uploads/origins/e2b7799e-45b5-470d-aed1-66b42203e6ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2517f85c7036a88a998ee70ee6a4aa9", "srcset": "https://si.imgix.net/b303168d/uploads/origins/e2b7799e-45b5-470d-aed1-66b42203e6ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2517f85c7036a88a998ee70ee6a4aa9, https://si.imgi