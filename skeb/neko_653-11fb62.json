す、大変ありがとうございます。\n\n以下の画像を参考にして描いていただけますでしょうか。\n\n画像には別の衣装バージョンもありますので、先生の方で自由に組み合わせていただいても大丈夫です。\n\nもちろん、服を着ないバージョンでも全く問題ありません。\n\n自由に描いていただけますと幸いです。\n\nよろしくお願いいたします。\n\nhttps://www.flickr.com/photos/shiting_jitei/55580700181/in/dateposted-public", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@neko_653/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4005463, "client_id": 1638570, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/406f839c/uploads/origins/4e06f631-1764-4287-9309-e2e792e44347?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=322692acd2215d975d61f27b2eb8ae69", "srcset": "https://si.imgix.net/406f839c/uploads/origins/4e06f631-1764-4287-9309-e2e792e44347?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=322692acd2215d975d61f27b2eb8ae69, https://si.imgix.net/406f839c/uploads/origins/4e06f631-1764-4287-9309-e2e792e44347?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7575649ae0491016cff70e3c85b7619d 2x, https://si.imgix.net/406f839c/uploads/origins/4e06f631-1764-4287-9309-e2e792e44347?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9174b906c4af39744469e234d1176d5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/406f839c/uploads/origins/4e06f631-1764-4287-9309-e2e792e44347?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d37ba49e69a8358ccd34e56f4d78372", "srcset": "https://si.imgix.net/406f839c/uploads/origins/4e06f631-1764-4287-9309-e2e792e44347?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d37ba49e69a8358ccd34e56f4d78372, https://si.imgix.net/406f839c/uploads/origins/4e06f631-1764-4287-9309-e2e792e44347?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=