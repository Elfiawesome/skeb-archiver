2F2017265856791912448%2Fb40yfWYd.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52edf06fc32be80045d11d173203110b 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2017265856791912448%2Fb40yfWYd.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=610588550f9e831df7803c994ff318f5", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2017265856791912448%2Fb40yfWYd.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=610588550f9e831df7803c994ff318f5, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2017265856791912448%2Fb40yfWYd.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8615b728fe549378a48979494b86b634 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2017265856791912448%2Fb40yfWYd.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eeead6b73ec737ff056f453291e64b3a 3x"}, "body": "平素よりお世話になっております。今回初めて有償リクエストを出させていただきますが、普段八郎さんが多く書かれている「一人のキャラを軸に書く」とは大きく異なってしまいますが、「チン覧会」の作品に近いイメージで、たくさんのキャラがいっぱい出てくる類のエロを八郎さんの筆致でぜひお願いしたいです！キャラの選定は基本的にお任せします。少し前に作成したシコリストのURLを添付しますが、ぜひ八郎さんの筆が乗るキャラを中心にしていただければと思います。「八郎さんのエロい文である」が満たされればぶっちゃけ何でもいいので、下記は一例なので、適宜趣味に合わないところはダイナミックに無視していただいて大丈夫です。\n全体を通底して「徹底的な壊滅・陥落・崩壊」あたりをお願いし、完膚なきまでにメギド72を叩き潰して読者の支配欲を満たせる作品にしていただきたいです！\n-----\n【版権作品名】\nメギド72\n【キャラクター名】\n先述の通りです。最推しはアモン（ラッシュ）で、彼が支配者に優遇されていると胸がほっこりします。\n【チンポについて・性経験】\nお任せします。書きやすいもので構いません。キャラに沿わせても、逆に沿わずにギャップ狙っても。\n【あらすじ】※一例です。この通りでなくともシコければ何でもいいです\nなんやかんやあって完全敗北しているメギド72。\n男メギドたちは一人残らずアジトに押し込められている。\nそんなアジトに、メギド72を壊滅させた張本人たるメギドの男がやってくる。\n男を出迎えたソロモン王は、案内に（任意のキャラ）をつけ、そのキャラの案内の下、男はアジトを巡っていき、メギド72の無様な敗北姿を見物していく……\n\nしかし、実はこれはソロモン王の起死回生の一手だった。メギドが来るまでに正気を取り戻していたソロモン王は、秘密裏に一部のメギドたちの目を覚まさせ、逆転の計画を練っていたのだ。見学を終え、アジトで男が休んでいる裏で、（案内役のメギド）とひそかに合流するソロモン王。男の情報を探り、案内役に誘導させ、正気を取り戻したメギド達と男を討つ。それがソロモン王の作戦だった。\nしかし、（案内役のメギド）は正気を取り戻してなどおらず、男のために動いていただけだった。気を許していたソロモンを罠に嵌め、拷問（イキ地獄とか寸止め地獄とか？）にかけて反逆の心を折る。許しを乞うソロモンに対し……\n\n翌日、見せたいものがあると男を連れ出す（案内役のメギド）。連れられた先に待っていたのは、ステージに立つソロモンと反逆を企てていたメギド達。そしてそれを見世物のように取り囲みながら歓談するアジトのメギド達だった。\n昨日のうちに指輪の強制力で共に反旗を翻すはずだったメギド達を操ったソロモンは、このメギド達で「処刑ショー」を行うという。未だ男の支配下にある多くの仲間達の前で、ある者は常識改変されたまま、ある者は肉体操作権だけを奪われ、惨たらしく死んでいくメギド達。そして、全員の不届き者を屠ったのちに、ソロモンは命乞いをして許しを乞う。しかし、（案内役のメギド）に命令され、ソロモンもまた、その人生を終わらせる。\n\n観客であったメギド達は口々にソロモンを嘲笑したり、小ばかにしたりしながら散会していく。実に惨めで愉しいメギド72の最期であった。\n\n※留意点等\n・女メギドたちについては言及してもしなくてもよいが、直接登場はさせない。完全に存在ごとカットしてもよいし、全員処刑済みとかでもよい。\n・主人公のメギドについては没個性でよい。セリフなしでもＯＫ。もちろん人格があった方が良ければそれでもＯＫだが、その場合はオラオラ系ではなく、平凡で穏やかな感じがよい。\n・一人称形式でも二人称形式でも三人称形式でもよい。書きやすくエロいもので。\n・メギド達は基本的に平常時と同じ喋り方をベースとする。ただし、シチュの方向性で「ご主人様」などと遜らせるのは全然あり。全員が全員だと食傷気味なので、ベースは通常通り。\n・メギド達はある種常識改変に近い状態をベースとする。ただ、シチュの一環として正気なやつがいたり、洗脳深度がキャラによってバラバラでも勿論ＯＫ。（「メギド72は正常だろ？」「メギド72は敗北したんだから当たり前だろ？」「ふざけやがって」が同居していてよい）洗脳手段については「洗脳フォトン」などの無茶苦茶なご都合設定でＯＫ。メギドの力で洗脳された、とかでも。\n・案内メギドの選定はお任せしますが、アモンだと一番嬉しい。アモンの場合、（主人公に親愛100％にさせられていることを除けば）ほぼほぼ正気だと良い。難しければ誰でもいいが、シコリストの「激シコ」からだと嬉しい。残りのキャラはそこまで優遇の気持ちもないので、こいつら含めて徹底的に貶めてよい。（案内人だが無様シチュに加わるなど）\n・徹底的な尊厳破壊や人生終了などを行って、メギド72を完璧に叩き潰している快感を重視してほしい。\n\n【絶対に描写して欲しいもの】\n八郎さん十八番の「喘ぎ」以外は、絶対というものはありません。\n折角ならチンロンを貶めてもらった方がいい出汁が出るかしら……\nお館様らしい極太巨根だが童貞でマゾ堕ち済のツルギによるカクリヨ献上……？チンロン・シェンウー・チユエン（・アンダカ）並べて、散々偉そうな口を叩いて真っ先に堕ちるチンロンとか……？\n\nその他、参考までに好きなものを並べておきます。\n・「着衣」を基調としてくださると嬉しい。ただし、「着衣」は半裸や下半身露出も含む。また、全裸の場合も、服を脱ぐ描写や脱いだ服の様子があれば広義の着衣に含む。（ex.ただの全裸土下座ではなく、畳まれた服の描写あり、など）\n・当人たちの持ったマゾ性などに屈服するのも勿論OK。常識改変によってそれを平然と吐露させる、とかの合わせ技も歓迎。\n・「鼻フック」「臭い系（腋、足、チンカス、などなど）」「敗北宣言」「小便（放尿）」「NTR」「悪堕ち」も凄く好き。\n・フェラやイラマも大好き。\n・ナレ死レベルでもキャラが多ければ多いほど嬉しくなるが、もちろん料金と労力に見合う範囲内でＯＫ。\n・処刑系は絞首が特に好き。ギロチンとか斬首も好き。（但しグロに寄る場合は、あまり血や臓物の描写を極端にしないようにしてほしい。死ぬところが見たい、で、死体が見たい、ではない）\n\n【NG行為(大スカ、小スカ、チンカス、斬首等)】\n・もし雄堕ちを描く場合は、挿入者の「堕ち」を強調してほしい。ただヤリチン/強雄として書くのではなく、彼らが性欲に脳を支配された無様な姿であることを強調してほしい。（ex.オナホ相手の雄堕ち、突っ込んでいる側のオホ顔、案内者の冷ややかな目線など）\n・大スカはなし。ゼリー排泄は可。\n・エロ衣装はなし。衣服を破るのは可。そのキャラが当然につけているものをベースに着衣を描いてほしい。水着衣装にするなどは可。また、褌なども日常着用の範囲内なので可。ゲーム内で着用していない衣服を着用させることも構わないが、一般的に想定される範囲内で。\n・陥落者や案内者が逆転される展開は絶対になし。勇ましく歯向かってくる/洗脳解除されたような様子を見せる→全部掌の上でしたオチ、や、次ページで普通に返り討ちにされている展開はむしろ大好きなのでOK。\n\nhttps://x.com/tanuki_wicked/status/1912501351353053574", "nc": 59, "word_count": 21078, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@_86o0o/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 3013371, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2017265856791912448%2Fb40yfWYd.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50e8db7c3658408cabc480e6865cc8aa", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2017265856791912448%2Fb40yfWYd.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50e8db7c3658408cabc480e6865cc8aa, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F201726