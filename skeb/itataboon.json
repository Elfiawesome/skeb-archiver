い可能であれば背景や文字と人物を分けたレイヤーの状態でのpsdデータもしくは透過済みpngでデータを頂けましたら幸いです。\nまた、頭部や身体、髪の毛の横側が見切れていない構図だと嬉しいです。\n\n資料や金額の不足等ございましたら再送頂けましたら幸いです。\nご縁がございましたら何卒よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1j8K9A1SpqQ1l7uw50zCLiTGJbVZtwRgl", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@itataboon/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3761897, "client_id": 3520844, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/618872d9/uploads/origins/fb37f7df-9ae5-4aff-ba7c-c634dcbefe80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f6f9cc9f766835ab8cf8bd5e085fc44", "srcset": "https://si.imgix.net/618872d9/uploads/origins/fb37f7df-9ae5-4aff-ba7c-c634dcbefe80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f6f9cc9f766835ab8cf8bd5e085fc44, https://si.imgix.net/618872d9/uploads/origins/fb37f7df-9ae5-4aff-ba7c-c634dcbefe80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42d1787baaf6c594472d59cdcf28b418 2x, https://si.imgix.net/618872d9/uploads/origins/fb37f7df-9ae5-4aff-ba7c-c634dcbefe80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea3d09c88163855258fb02e489a89a3d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/618872d9/uploads/origins/fb37f7df-9ae5-4aff-ba7c-c634dcbefe80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21adde1dccba10283f4a2b1e26c0ce80", "srcset": "https://si.imgix.net/618872d9/uploads/origins/fb37f7df-9ae5-4aff-ba7c-c634dcbefe80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21adde1dccba10283f4a2b1e26c0ce80, https://si.imgix.net/618872d9/uploads/origins/fb37f7df-9ae5-4aff-ba7c-c634dcbefe80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blu