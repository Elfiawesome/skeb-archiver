あなたが描くドラゴンはどれも本当に大好きです！もしよろしければ、私のドラゴンも描いていただけないでしょうか？参考画像を見ていただければわかりますが、彼女はとってもふわふわなんです！ それに、かなり大きなドラゴンで、肩の高さが約20メートルもあります。いたずら好きな性格ですが、その大きさのおかげで、何でも許されてしまうんです。だって、片方の前足であなたを掴んでしまえるくらいですから、からかいを止めるのは難しいですよね！ そのふわふわした毛並みを存分に強調してくださると嬉しいです。また、可能であれば、アングルも工夫して、彼女の巨大さをしっかりと感じられるように描いていただけると最高です！ リクエストとしては、からかいに対する視聴者の反応を楽しんでいるかのように、得意げでありながら少しいたずらっぽい表情で描いていただけないでしょうか。それ以外は、ポーズや構図はあなたにお任せします！\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1QDB1sE_Ugvl2v2ZbyGu4lzdJHsAvAHtf?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kitsuko3310/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4011726, "client_id": 3927457, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60794c04/uploads/origins/916b941c-c45f-42c7-b6ae-b6c30dde5c0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54fc26c995aa57ace112cfd6d8f2d295", "srcset": "https://si.imgix.net/60794c04/uploads/origins/916b941c-c45f-42c7-b6ae-b6c30dde5c0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54fc26c995aa57ace112cfd6d8f2d295, https://si.imgix.net/60794c04/uploads/origins/916b941c-c45f-42c7-b6ae-b6c30dde5c0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2dba95e8a50e7045d18a76d51e847d0 2x, https://si.imgix.net/60794c04/uploads/origins/916b941c-c45f-42c7-b6ae-b6c30dde5c0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35d3615d396ac92848f0cf8ba694094f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/60794c04/uploads/origins/916b941c-c45f-42c7-b6ae-b6c30dde5c0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64db0b667a909ec20fff6335b60e6b82", "srcset": "https://si.imgix.net/60794c04/uploads/origins/916b941c-c45f-42c7-b6ae-b6c30dde5c0c?bg=%23fff&aut