素敵な瞬間を記録し、それらを創作の題材としています。\n\nあなたの筆で、彼女がカメラを持って取材している姿を見てみたいです。背景や衣装などの他の部分は、あなたの自由に描いていただいて構いません。\n\nこのお願いをお聞き入れいただけましたら、本当に嬉しく思います。\n\n可能であれば、psdファイル内の別のレイヤーにサインをお願いします\n依頼内容に何か難しい点か問題点があれば、お気になさらずこの依頼をキャンセルしてください\nご検討のほど、何卒よろしくお願いします！\n\nhttps://weibo.com/7796893802/5163607102330299", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kazuta_yo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3642979, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/152a1463/uploads/origins/92759ae5-4326-4b62-bdf4-59e41c73787c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fca1918d169f7c7298095efceca487fd", "srcset": "https://si.imgix.net/152a1463/uploads/origins/92759ae5-4326-4b62-bdf4-59e41c73787c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fca1918d169f7c7298095efceca487fd, https://si.imgix.net/152a1463/uploads/origins/92759ae5-4326-4b62-bdf4-59e41c73787c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69bd3e76f2d4cad57cc0e95a01fd429f 2x, https://si.imgix.net/152a1463/uploads/origins/92759ae5-4326-4b62-bdf4-59e41c73787c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=409319adfee469639086a0857c739906 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/152a1463/uploads/origins/92759ae5-4326-4b62-bdf4-59e41c73787c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8513375cf37b9fdf29812419c745b0c5", "srcset": "https://si.imgix.net/152a1463/uploads/origins/92759ae5-4326-4b62-bdf4-59e41c73787c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8513375cf37b9fdf29812419c745b0c5, https://si.imgix.net/152a1463/uploads/origins/92759ae5-4326-4b62-bdf4-59e41c73787c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2