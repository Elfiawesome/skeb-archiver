っています。以前もお話ししたかもしれませんが、私のオリジナルキャラクターは、ややよそよそしい女性で、優雅な雰囲気を漂わせていますが、この態度は傲慢さというよりは、疲れによるものです。 一見よそよそしい態度ですが、誰かに夢中になると、とても愛情深く、優しい一面を見せるんです！彼女は熱心な芸術支援者でもあり、クラシック音楽の大ファンでもあります。二人の個性を損なうことなく、二人の愛情が伝わる漫画を描いていただけたら、とても嬉しいです！具体的なシーンの設定は、すべてお任せします。 ご検討いただき、誠にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1stySTSUqwSc51WACjYuCQ8e6aCHnTmVi", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riwodatio/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3975473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2e55c1b/uploads/origins/9467d475-a6b4-4fd5-8f1e-90a5e09fce53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5475b8750fe3e381b3afa143aa683ede", "srcset": "https://si.imgix.net/a2e55c1b/uploads/origins/9467d475-a6b4-4fd5-8f1e-90a5e09fce53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5475b8750fe3e381b3afa143aa683ede, https://si.imgix.net/a2e55c1b/uploads/origins/9467d475-a6b4-4fd5-8f1e-90a5e09fce53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3454ee68bcb4dd9e6e467213dc10f4ed 2x, https://si.imgix.net/a2e55c1b/uploads/origins/9467d475-a6b4-4fd5-8f1e-90a5e09fce53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4708dc11a71cecf88fa2331a6975f35b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2e55c1b/uploads/origins/9467d475-a6b4-4fd5-8f1e-90a5e09fce53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9fa58267f96abb97ae14b36aa42af37", "srcset": "https://si.imgix.net/a2e55c1b/uploads/origins/9467d475-a6b4-4fd5-8f1e-90a5e09fce53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9fa58267f96abb97ae14b36aa42af37, https://si.imgix.net/a2e55c1b/uploads/origins/9467d475-a6b4-4fd5-8f1e-90a5e09fce5