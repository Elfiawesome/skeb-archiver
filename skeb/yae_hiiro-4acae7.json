勢い大事！」ということであればそれでもOKです！これまで、アップした後になって粗に気がついて手直しすることが何度もあって、そのたびに早い段階から読んでくれた方に申し訳ない気持ちになってましたので、事前に八枝ひいろ様に目を通していただければそれだけでとても心強いです。\n\nhttps://mimemo.io/m/JYpaMlMWDYGyrdg", "nc": 0, "word_count": 1198, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@yae_hiiro/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1221813, "client_id": 1249478, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52754aaf/uploads/origins/729fc5d0-1059-4411-8872-53bec77a188e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7b769373a373bb1912e23a108f6b2b8", "srcset": "https://si.imgix.net/52754aaf/uploads/origins/729fc5d0-1059-4411-8872-53bec77a188e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7b769373a373bb1912e23a108f6b2b8, https://si.imgix.net/52754aaf/uploads/origins/729fc5d0-1059-4411-8872-53bec77a188e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51efc17b991b8efbb5ecb73f3dea821f 2x, https://si.imgix.net/52754aaf/uploads/origins/729fc5d0-1059-4411-8872-53bec77a188e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=890bb56bb06c650239d95543862f0e29 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52754aaf/uploads/origins/729fc5d0-1059-4411-8872-53bec77a188e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10966456b739d3e5ba526bda4a065c52", "srcset": "https://si.imgix.net/52754aaf/uploads/origins/729fc5d0-1059-4411-8872-53bec77a188e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10966456b739d3e5ba526bda4a065c52, https://si.imgix.net/52754aaf/uploads/origins/729fc5d0-1059-4411-8872-53bec77a188e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d56385d7e89272d752d4957e930e49b1 2x, https://si.