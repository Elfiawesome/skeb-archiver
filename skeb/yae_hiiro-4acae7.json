igins/d431240c-1919-434c-85f6-d295d1f34a24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=311df58a2d6630e47dad540efe59c763 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b2e7722/uploads/origins/d431240c-1919-434c-85f6-d295d1f34a24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cde8f1fff8a80e0e4d87fd366314e79", "srcset": "https://si.imgix.net/8b2e7722/uploads/origins/d431240c-1919-434c-85f6-d295d1f34a24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cde8f1fff8a80e0e4d87fd366314e79, https://si.imgix.net/8b2e7722/uploads/origins/d431240c-1919-434c-85f6-d295d1f34a24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e775eb067b3d75c35ac54c086d83f349 2x, https://si.imgix.net/8b2e7722/uploads/origins/d431240c-1919-434c-85f6-d295d1f34a24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3ae86f44706ecb7a1b4b268614baca8b 3x"}, "body": "三たび、自分の書いた潤みつの短編にアドバイスをいただきたく、お願い申し上げます！\n\n12000字という分量は自分にとっては初めてで、「これ、最後まで読んでくれるだろうか」という不安がまずあります。基本、潤みつが好きな人に向けて描いたつもりですが、その人達が最後まで興味を持ち続けてくれるだろうかという。\n\n書いた動機としては、\n・潤とみつねが宝崎のヒーローとして活躍する姿をもっと見てみたかった\n・かなえと潤・みつねの絡みをもっと見てみたかった\n・せめて魔獣世界で、潤とみつねに平和で幸せな結末を迎えてほしかった\n\nと、ファンとしての願いをドストレートに書いてみたのですが、そこにエモさみたいなのをちゃんと乗せられたかどうか…\n\n半年ぐらい書いては消しを繰り返して、ストーリー展開も何度か見直しているので、自分ではもうよくわからなくなっています。あと、かなえMSSからエピソードを持ってきているので、かなえを引いてない人だと置いてけぼり感がないかというのも少し気になっています。\n\nその他、なんでもご助言いただけると嬉しいです！\n\nhttps://mimemo.io/m/qERa6lByWpoPb0v", "nc": 129, "word_count": 2728, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@yae_hiiro/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "correction", "tipped": true, "creator_id": 1221813, "client_id": 1170258, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/017f51df/uploads/origins/36407828-6127-4f87-9a0f-24f