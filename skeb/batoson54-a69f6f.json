しくお願いいたします。\n\nhttps://photos.app.goo.gl/R4cG7Br9pMQ5DzHX7", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@batoson54/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1c90bac2/uploads/origins/0aadf67e-2703-448b-950d-e86cbc94551e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14f7ac369c3da2d4496f77655e848e69", "srcset": "https://si.imgix.net/1c90bac2/uploads/origins/0aadf67e-2703-448b-950d-e86cbc94551e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14f7ac369c3da2d4496f77655e848e69, https://si.imgix.net/1c90bac2/uploads/origins/0aadf67e-2703-448b-950d-e86cbc94551e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=554e7e79615795ae0f5db3bdf5166424 2x, https://si.imgix.net/1c90bac2/uploads/origins/0aadf67e-2703-448b-950d-e86cbc94551e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a3ebe3be2da47e8ba0e0ffb4adf36de0 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2060652, "nc": 145}, {"path": "/@batoson54/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2060652, "client_id": 1473258, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ba0156f/uploads/origins/cd4fc9f1-1d61-48b9-8edd-c4495ac73f01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d877413f6c65d6b74df962d60d5ade3", "srcset": "https://si.imgix.net/9ba0156f/uploads/origins/cd4fc9f1-1d61-48b9-8edd-c4495ac73f01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d877413f6c65d6b74df962d60d5ade3, https://si.imgix.net/9ba0156f/uploads/origins/cd4fc9f1-1d61-48b9-8edd-c4495ac73f01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71fe11dfb40a872ec2ad0e3c085eb198 2x, https://si.imgix.net/9ba0156f/uploads/origins/cd4fc9f1-1d61-48b9-8edd-c4495ac73f01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f9d226953ec51b1a8886b2653a0bdef 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ba0156f/uploads/origins/cd4fc9f1-1d61-48b9-8edd-c4495ac73f01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89492a378f837002539f5ac692c8e11d", "srcset": "https://si.imgix.net/9ba0156f/uploads/origins/cd4fc9f1-1d61-48b9-8edd-c4495ac73f01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89492a378f837002539f5ac692c8e11d, https://si.imgix.net/9ba0156f/uploads/origins/cd4fc9f1-1d61-48b9-8edd-c4495ac73f01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9fd30c1eb08ba0883615da6afcd5671a 2x, https://si.imgix.net/9ba0156f/uploads/origins/cd4fc9f1-1d61-48b9-8edd-c4495ac73f01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=733a61efbc31089ef2fe1c18e5fa71b4 3x"}, "body": "バトさん！こんにちはー！\n素敵なイラスト拝見しました✨\nぜひ！イラストの依頼をさせていただきたいですー！\n\n◆人物の特徴としては、\n髪色に『茜色』の風味を混ぜていただければ、\nもしでしたら頭に『ハンチング帽』を被せてほしいです。\n性別や服装は中性的な雰囲気であればありがたいです。\n表情やポーズはおまかせします。\n\n◆イラストの使用用途としては、\nSNSのアイコンや配信等をもし行う際のサムネや\nTRPGでのキャラメイクなどで\n使用させていただきたいと思います。\n\n◆人物と背景を分けたPSDファイル、\nもしくは人物のみの透過データ(頭部や髪型が見切れていない状態)も\nよければ分けて納品していただけたら大変ありがたいです。\n\nご検討いただけたらと思います。\nよろしくお願いいたします🍁\n\nhttps://drive.google.com/drive/folders/1sZCDHvSK1kH92Su2weD_zuKCla9h7Wum?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@batoson54/works/7", "private_thum