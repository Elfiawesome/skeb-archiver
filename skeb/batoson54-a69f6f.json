今日は、私の自創作キャラを描いていただきたいなと思っております。\n\n【エリア】\n・夕陽色の髪。一本の太い三つ編み。\n・淡紫色（藤色）の目。\n・中性的な顔立ち。\n・剣を主に扱う騎士。特に、レイピアの扱いに長けている。\n・10代後半\n\n格好は、彼の私服姿の、白色のシャツに茶色のズボン、焦げ茶色のブーツ姿でお願いします。シャツの襟元に、赤色のリボンタイを結んでいただけると嬉しいです。\n\n描いていただいた絵は、個人的に楽しむのと、ブルースカイ垢（kazakamiss）にて、「描いていただきました！」と掲載しようと思っています。\n\nご縁がありましたら、よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@batoson54/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5637fdce/uploads/origins/dd43cc89-77f9-4640-a39e-88b6f22ddcd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=435116f6d77cd6a13a39b65a1f5fe84c", "srcset": "https://si.imgix.net/5637fdce/uploads/origins/dd43cc89-77f9-4640-a39e-88b6f22ddcd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=435116f6d77cd6a13a39b65a1f5fe84c, https://si.imgix.net/5637fdce/uploads/origins/dd43cc89-77f9-4640-a39e-88b6f22ddcd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3391c58ac61b6e1e32843a14e3947047 2x, https://si.imgix.net/5637fdce/uploads/origins/dd43cc89-77f9-4640-a39e-88b6f22ddcd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b84b2af820b23c23222490f9be0f1d78 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2060652, "nc": 128}, {"path": "/@batoson54/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2060652, "client_id": 2770529, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60a030a3/uploads/origins/7a6b6795-058a-4cf7-800a-3a