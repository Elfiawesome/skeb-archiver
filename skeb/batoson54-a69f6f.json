も、1人ずつ分けて描かれても構いません。\n衣装や構図はお任せします。\n（設定画はないので、デザインが分からない箇所は想像で描いていただいて構いません）\n\n\n\n【資料】\n（稲葉）https://umagoya.wixsite.com/tokorito/inaba\n\n（伏見）https://umagoya.wixsite.com/tokorito/fushimi\n\n（屋島）https://umagoya.wixsite.com/tokorito/yashima\n\n（大久野）https://umagoya.wixsite.com/tokorito/okuno\n\n（天海）https://umagoya.wixsite.com/tokorito/amami\n\n（つん）https://umagoya.wixsite.com/tokorito/tsun", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 2469073, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "間", "screen_name": "a1da_a", "avatar_url": "https://pbs.twimg.com/profile_images/1729546668906024960/s2pGndR4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1389150319888670721/1722416844/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 2778953, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ねじゅみ企画", "screen_name": "nejumipro", "avatar_url": "https://pbs.twimg.com/profile_images/1324826032109580294/Q7lFWc7D.jpg", "header_url": "https://pbs.twimg.com/profile_banners/977511810784874497/1648189073/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 2789312, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "丘", "screen_name": "logi_bunbukucha", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:imqwegbeoecla3auslmfmgwc/bafkreiceg4bg444dkw4cs56eyzdii2cbyosxjrzvkzcg63ip3cmj4hmzdi", "header_url": null, 