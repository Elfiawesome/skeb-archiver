m=webp&fit=crop&crop=top&w=200&h=200&s=9148c1f0296c4926ca373898cebb5379, https://si.imgix.net/d55ecc37/uploads/origins/87be340e-865a-4e17-908b-d0312e2070da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b576c5351a76d7f7117b3fdec951401e 2x, https://si.imgix.net/d55ecc37/uploads/origins/87be340e-865a-4e17-908b-d0312e2070da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3d31cca01d09f28b74e573800159aab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d55ecc37/uploads/origins/87be340e-865a-4e17-908b-d0312e2070da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad22de7640334f33c85df04d571afbb7", "srcset": "https://si.imgix.net/d55ecc37/uploads/origins/87be340e-865a-4e17-908b-d0312e2070da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad22de7640334f33c85df04d571afbb7, https://si.imgix.net/d55ecc37/uploads/origins/87be340e-865a-4e17-908b-d0312e2070da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e66e85844c50b4f9292ed2255b6e7ce9 2x, https://si.imgix.net/d55ecc37/uploads/origins/87be340e-865a-4e17-908b-d0312e2070da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95e2acfaad8cad89b02c1d709792eeb3 3x"}, "body": "駅メモのファンアートが依頼したいです。\nもうすぐ終了する山陰線・播但線の旅イベントがとても楽しかったので、イベントと但馬ひょうこさんを画題に何か記念の絵を一枚描いて頂けないでしょうか。\n\n駅メモ号とひょうこさん、スポットとひょうこさん、打ち上げでステーキ食べるひょうこさん、記念ラッピングのひょうこさん…どんな画題でも結構です。ラッピングも構図も全てお任せします。資料に一応イベントの写真は載せていますが、いつも描かれている日常のひょうこさんがとても素敵なので、資料関係なく自由にお願いしたいです。\n\n一つだけ、絵の中にどこでもいいのでイベントのあった日付2024/2/23〜2024/9/23を入れておいてもらえると嬉しいです。\n\nもし引き受けて頂ける場合も、急がないしいつでもいいので、無理なく楽しく描ける範囲でお願いしたいです。\n\n以上、よろしくご検討ください。\n\nhttps://x.com/vgloTDcrhxRn5B2/status/1824180483485471067?t=EYPuVQAkamLe39mBXGjUGw&s=19", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Carol_Oyodo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2291784, "client_id": 1106711, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7976ecd7/uploads/origins/24b6bf83-3c6e-4b92-a5b5-1e0ab23d6fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=785bc9ec39c7f87a33c84c086ad035d8", "srcset": "https://si.imgix.net/7976ecd7/uploads/origins/24b6bf83-3c6e-4b92-a5b5-1e0ab23d6fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=785bc9ec39c7f87a33c84c086ad035d8, https://si.imgix.net/7976ecd7/uploads/origins/24b6bf83-3c6e-4b92-a5b5-1e0ab23d6fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38250994d69ab6722691f80a3bbd4cdd 2x, https://si.imgix.net/7976ecd7/uploads/origins/24b6bf83-3c6e-4b92-a5b5-1e0ab23d6fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bb9f643239f2bb87dffcd9d9f9b53c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7976ecd7/uploads/origins/24b6bf83-3c6e-4b92-a5b5-1e0ab23d6fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d789bd35cb5fa47d6c5cdd93ed498ee1", "srcset": "https://si.imgix.net/7976ecd7/uploads/origins/24b6bf83-3c6e-4b92-a5b5-1e0ab23d6fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d789bd35cb5fa47d6c5cdd93ed498ee1, https://si.imgix.net/7976ecd7/uploads/origins/24b6bf83-3c6e-4b92-a5b5-1e0ab23d6fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a05103d542bf7b3b6b2eaae66233f5c9 2x, https://si.imgix.net/7976ecd7/uploads/origins/24b6bf83-3c6e-4b92-a5b5-1e0ab23d6fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d5c2ba43f9cf04d132c4ab801dcd72db 3x"}, "body": "こんにちは！はじめまして。\n\n大淀久明先生のイラスト、特に鉄道関連のイラストは感心させられます。\n\n私のオリキャラ2人のイラストを描いていただきたいです：\n\n●森血夏（もり・ちなつ）\n✦内気で不器用な暗殺者です。\n✦英語は難しいので、仕事で苦労することが多いんです。\n✦血夏ちゃんの長いアホ毛はときどきその状況に反応する。\n✦よく顔を赤らめます。\n\n●アリス・シンクレア\n✦血夏ちゃんの元気な英語の先生です。\n✦謎めいた過去があり、誰かから隠れているようです。\n✦服についている猫の頭は「SASちゃん」と言います。時々、それに話します。\n\n✦よく揉め事を起こしますが、一緒に普段はとても楽しんでいます。\n\n\n●リクエスト：\n✦血夏とアリスを列車の上か隣に描いていただけますか？\n✦私が好きな日本の鉄道は「リゾートしらかみ」と「大井川鐵道」ですけど、先生が別のアイデアをお持ちなら、それでも構わないです！\n✦自由に描いてお願いします。❤\n✦付き合っているような感覚で描いていただければ、嬉しいです〜\n\n\n●キャラ資料：\nhttp://santashi.com/awtletrefs.html\nhttp://santashi.com/awtlet/\nhttp://santashi.com/tempcaroloyodo.html\n\n\n●用途：\n✦主にイラストを見て楽しむためです。\n✦できれば、低解像度なイラストは個人サイトの「他のクリエイターの作品」に掲載したいのですが。\n✦大淀久明先生の「X」のアカウントにリンクを貼ります。\n✦それが許されないのであれば、それは別のレイヤーに書いてください、そして掲載しませんです。\n\n\n詳細が必要な場合や金額に問題がある場合は、アピールしていただいても大丈夫です〜\n\nご検討いただけますと幸いです。\nよろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Carol_Oyodo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2291784, "client_id": 459602, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/804d8a1d/uploads/origins/781db647-355d-4a5a-be78-775f0be664e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=473f52bc5b7d9a1820ce2775ff55bc69", "srcset": "https://si.imgix.net/804d8a1d/uploads/origins/781db647-355d-4a5a-be78-775f0be664e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=473f52bc5b7d9a1820ce2775ff55bc69, https://si.imgix.net/804d8a1d/uploads/origins/781db647-355d-4a5a-be78-775f0be664e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f80c88f4ae321ba32a2800c365b308e1 2x, https://si.imgix.net/804d8a1d/uploads/origins/781db647-355d-4a5a-be78-775f0be664e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77344750f5bb1613accf4680ebe84f08 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/804d8a1d/uploads/origins/781db647-355d-4a5a-be78-775f0be664e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80a693c9d573880db29658015b522939", "srcset": "https://si.imgix.net/804d8a1d/uploads/origins/781db647-355d-4a5a-be78-775f0be664e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80a693c9d573880db29658015b522939, https://si.imgix.net/804d8a1d/uploads/origins/781db647-355d-4a5a-be78-775f0be664e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=51299449ffe46d8a90c78f312e429a4c 2x, https://si.imgix.net/804d8a1d/uploads/origins/781db647-355d-4a5a-be78-775f0be664e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6c03e54971d9fd354957f1b3b9ce8423 3x"}, "body": "以前描いて頂いたゆかりさんの絵がとても良かったので、また駅メモのファンアートの依頼をお願いしたいです。今度は信楽くろがねの絵を描いて頂けないでしょうか。画題は、なにか古いものとくろがねを希望しています。\n\nでんこコレクションの設定で、くろがねは骨董品にまつわる思い出を集めるでんこで、古い電車、美術品、使い込まれた日用品などなど、古いものたちの気持ちがわかるよう付喪神の意味合いも込めて狸型でんことして制作されたという隠し設定が明かされたため、そんな絵が見て見たいのです。「古いもの」は上記例示列挙以外でも何でも構いません。\n\nまたは、上記の内容がややこしかった場合、普通になにかくろがねの絵を自由に描いて頂ければと思います。その場合は可能ならゆかりさんの絵のときのような、なにか普段着っぽい服を着せてもらえるとより嬉しいです。\n\nもし引き受けて頂ける場合も、急ぎませんので、他の依頼ややりたいことを優先して頂いて、無理なく楽しく描ける範囲でお願いしたいです。\n\n以上、宜しくご検討下さい。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Carol_Oyodo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2291784, "client_id": 459602, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e41db39/uploads/origins/086c1853-dce6-4820-be7d-e5340dd508ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5c58457ef35ff5964e41ebae2fe9ee2", "srcset": "https://si.imgix.net/3e41db39/uploads/origins/086c1853-dce6-4820-be7d-e5340dd508ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5c58457ef35ff5964e41ebae2fe9ee2, https://si.imgix.net/3e41db39/uploads/origins/086c1853-dce6-4820-be7d