スト内容を気に入っていただけましたら幸いです\nご検討よろしくお願いいたします\n\n【資料】\nhttps://x.com/tsukiyo_co/status/1844431953258479837?t=QrnUQ08y8-0Ya5KUiWYFYQ&s=19", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1311969, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "夏里🐧", "screen_name": "rk_prpr", "avatar_url": "https://pbs.twimg.com/profile_images/1905912587583418368/oWh8pYvB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1371112681726300160/1747495917/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 144}, {"id": 3017030, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "たぬここ", "screen_name": "tetoneko3", "avatar_url": "https://pbs.twimg.com/profile_images/2042396543429591040/-bKxbmN3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1841822610428198915/1772328370/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 145}, {"id": 3092706, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "たろ", "screen_name": "ABC_D3FG", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fc1a1e195-c51c-4ccf-9e3f-e5143d46dd65.gif?avatar=1", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 48}, {"id":