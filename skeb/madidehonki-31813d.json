rop&crop=top&w=200&h=200&s=a20cea655c0ee0474be0f48023bf93aa 2x, https://si.imgix.net/c19de990/uploads/origins/decf9176-e093-4f6c-ba21-2c1faf4420dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78ca30f4c9c346022e07aba3657a153e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c19de990/uploads/origins/decf9176-e093-4f6c-ba21-2c1faf4420dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eec8ef09166e215ebbd3560f67fe127a", "srcset": "https://si.imgix.net/c19de990/uploads/origins/decf9176-e093-4f6c-ba21-2c1faf4420dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eec8ef09166e215ebbd3560f67fe127a, https://si.imgix.net/c19de990/uploads/origins/decf9176-e093-4f6c-ba21-2c1faf4420dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed1a2e6cb86207a279621a4cf10222a0 2x, https://si.imgix.net/c19de990/uploads/origins/decf9176-e093-4f6c-ba21-2c1faf4420dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=103bdb16024ffb3994ca9b6e60084df8 3x"}, "body": "お世話になります！間時先生の描く太ももがムッチリとしたケイちゃんを見て惹かれました！\nもしもまだリクエストを募集されてましたら聴いて頂けますか？\n詳細を下記に記します↓\n\nキャラ：ブルーアーカイブより「天童ケイ」\n\n服装：完全着衣のミレニアムの制服衣装\n\nシチュ：ケイちゃんの履いてる状態の黒ニーソの中にチンチンを挿入して射精するニーソコキというプレイをお願いします！\n\n構図、構成\n主観視点で竿役は可能でしたら下半身まであると幸いです。（構図的に難しかった場合は竿のみでも可）\nケイちゃんに片脚を上げてもらい、裏もものニーソックスの履き口を指で広げてもらいます。\n太ももにチンチンを擦り付けてカウパーまみれにしたらそのままニーソックスの中に挿入。\n腰を打ち付けた後はニーソの中に大量に射精する。\nニーソコキの事後、ケイちゃんに先述のようにニーソの履き口を広げてもらい中の様子を見せてもらうという構成をお願いします。\n\nマニアックな内容に加え、細かい文章になってしまいましたが採用されたら幸いです。\n何卒ご検討をお願いします…。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@madidehonki/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2876546, "client_id": 2014354, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.