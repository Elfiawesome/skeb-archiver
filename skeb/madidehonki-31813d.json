910924/uploads/origins/42d015d3-21a2-4728-a7bc-33d22bef0899?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a9e726a3282fc0781fb1de596990102 3x"}, "body": "初めまして。\n\n間時さんのイラストが素敵でしたのでリクエストしたくご連絡しました。\n\n早速リクエスト内容ですが、\n「一人で水浴びするガスタの巫女ウィンダ」\nをお願いします。\n\n詳細内容としまして、\n・胸を含め、スタイルは一つ前に描かれたウィンと同じくらいでお願いします。\n・背景のイメージとしては森の中にある小さな湖のような場所にて全裸で水浴びをしている。\n・描写範囲は太ももより上から。\n・ポーズは両手を頭の後ろで組んで伸びをしているイメージ。\n・また、胸は少し揺れている感じで、乳首は両方はっきりと見えている状態。\n・下腹部の女性器は日光などで見えないようにし、おへそは見えている状態。\n・表情は一人で気持ちよさそうに水浴びしている感じ。\n\n……以上になります。\n\n記載のない部分で不明点がありましたら間時さんのイメージにお任せします。\n\n以上、ご検討くださると幸いです。\n\nhttps://skeb.jp/@madidehonki/works/1", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@madidehonki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2876546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/156fd6d7/uploads/origins/ea489f72-69b6-48c6-adc8-cd1c9c2d6d1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee52078d5d6521654b10f88675b4ee58", "srcset": "https://si.imgix.net/156fd6d7/uploads/origins/ea489f72-69b6-48c6-adc8-cd1c9c2d6d1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee52078d5d6521654b10f88675b4ee58, https://si.imgix.net/156fd6d7/uploads/origins/ea489f72-69b6-48c6-adc8-cd1c9c2d6d1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=587e5162336ad370f84e976ca599f847 2x, https://si.imgix.net/156fd6d7/uploads/origins/ea489f72-69b6-48c6-adc8-cd1c9c2d6d1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c3db412df221c0471e08f4d5b4f1ac9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/156fd6d7/uploads/origins/ea489f72-69b6-48c6-adc8-cd1c9c2d6d1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8b61cf08df0460a