993c2f2/uploads/origins/7bec8458-53f9-44e6-9bc8-2934b92b0a61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=146451119d3c1631fac5798d97cc0148 2x, https://si.imgix.net/9993c2f2/uploads/origins/7bec8458-53f9-44e6-9bc8-2934b92b0a61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d7bc82d0ea54e62826ed90328da718dd 3x"}, "body": "はじめまして！あなたのFGOアートが大好きで、私のウェブ小説の主人公アリアとその友人ロキシーを夏をテーマに描いてほしいと思いました！アリアは没落した国の高貴な剣士。彼女は家族と国の秘密を暴くため、謎めいた少年と旅をする。アリアは物静かで控えめな性格。\n\nロキシーはブラックマーケットの情報ブローカー。ロキシーはからかい好きで遊び好き、アリアは内気で控えめな性格。ロキシーに似合いそうな水着のタイプは何でもいいので決めてください。\n\nアリアはビキニのキャップレスでお願いします。水着のリボンでお尻や太ももを見せるポーズ。赤ら顔のアリアもかわいいと思う。ロキシーはアリアとどんなポーズをとってもいい！\n\nありがとうございました！\n\nアリアの3サイズ82/57/86\nカップ:C\n\nロキシーのサイズ80-56-80cm\nカップ:B\n\nアリア参考\nhttps://drive.google.com/drive/folders/1i7zuLfo5svdEmKtW6hh8lVjhigBoFhiC?usp=drive_link\n\nアリア水着：\nhttps://imgur.com/a/rBbNJcx\n\nロキシー参考文献：\nhttps://imgur.com/a/FMnhsxx", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fufufu_hehehe/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2979144, "client_id": 1145151, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4ec7d51/uploads/origins/6482c09b-2ea9-4760-a566-a7f364a58977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f12f578bf05909855d807b1ca1eb0c0", "srcset": "https://si.imgix.net/f4ec7d51/uploads/origins/6482c09b-2ea9-4760-a566-a7f364a58977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f12f578bf05909855d807b1ca1eb0c0, https://si.imgix.net/f4ec7d51/uploads/origins/6482c09b-2ea9-4760-a566-a7f364a58977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67abb2f30e7864ea31f704c6e0be2a66 2x, https://si.imgix.net/f4ec7d51/uploads/origins/6482c09b-2ea9-4760-a566-a7f364a58977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea3a0741b60050f5e1f6a00116e29949 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4ec7d51/uploads/origins/6482c09b-2ea9-4760-a566-a7f364a58977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c6020e1506b307119169cdd0227d192", "srcset": "https://si.imgix.net/f4ec7d51/uploads/origins/6482c09b-2ea9-4760-a566-a7f364a58977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c6020e1506b307119169cdd0227d192, https://si.imgix.net/f4ec7d51/uploads/origins/6482c09b-2ea9-4760-a566-a7f364a58977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd9026f4faa3caca8a21fe6252e7d3f5 2x, https://si.imgix.net/f4ec7d51/uploads/origins/6482c09b-2ea9-4760-a566-a7f364a58977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9881ba233587d16ec60c070eab06f96c 3x"}, "body": "はじめまして、ヒロと申します。\nすいあま様のイラストをskebにて見かけ、とても綺麗で好みだったためお声がけしました。\n可能であれば私がCoCで使用しているキャラクターとその相方の一枚絵を描いて頂ければと思います。\n下部キャラクター詳細になります。\n\n白髪の女性\n名前…メティス\n身長…150前半\n\n知的でクールな女性。本を読み知識を蓄えることが趣味。好奇心旺盛。\n知識を披露する場面では早口になる。\n相手の頬や髪を優しく撫でたりするのが好き。\n普段は気の強そうな雰囲気を纏っているが仲の良い人に対しては慈愛や親愛に満ちた表情を向けている。\n表情筋豊か。照れるときは目をそらして苦笑いする。\n\n\n黒髪の女性\n名前…凪(なぎ)\n身長…160前半\n\n物静かで落ち着きのある女性。\nなにかあるとすぐに動揺しておどおどしてしまう。\n争いが苦手で周りで起こった喧嘩をおさめようとするタイプ(上手に出来るかは別)\n表情筋豊かではないが喜怒哀楽は確かに表に出てくる。雰囲気でもわかりやすい。\n照れるときは顔真っ赤にする。\n\n\n白髪の子が黒髪の子の顎をクイと上げてキスしようとしている、もしくはキスをしているところが見たいと思っています。\n白髪の子は特に変わりない様子で、黒髪の子は照れて目を瞑っててほしいです。\n難しければシチュエーションはこれでなくとも問題ありません。\n金額等不足があれば再送して頂ければ幸いです。\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1ESxlRJPul3FVYxCrFNjn4mfAQovVZpK0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fufufu_hehehe/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2979144, "client_id": 3599817, "vtt_url": null, "th