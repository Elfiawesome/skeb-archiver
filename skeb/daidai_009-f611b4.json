05529690419343\n\n可能であれば、別レイヤーにサインを入れたpsdファイルをご提供ください。また、先生が下書きや未使用のrkgkなどを作品に残しておいてくださると、アイデアの変遷を見ることができるのでありがたいです！\n\nご依頼をお読みいただき、ご検討くださり誠にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1G2yldDUusWRmjXtyBZvMCJr11FJAh5xc?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@daidai_009/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4019375, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bea45fda/uploads/origins/b79f8f1d-481e-4d59-848e-93f59e829e64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7c4925359f1ffa0d49e0ade58b41923", "srcset": "https://si.imgix.net/bea45fda/uploads/origins/b79f8f1d-481e-4d59-848e-93f59e829e64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7c4925359f1ffa0d49e0ade58b41923, https://si.imgix.net/bea45fda/uploads/origins/b79f8f1d-481e-4d59-848e-93f59e829e64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18df6544d3cbd690d0c89a945c7c2dbe 2x, https://si.imgix.net/bea45fda/uploads/origins/b79f8f1d-481e-4d59-848e-93f59e829e64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6eb8ed361b2203714ec855107d74d04 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bea45fda/uploads/origins/b79f8f1d-481e-4d59-848e-93f59e829e64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc33b17ae594319e2d2c2105b331c447", "srcset": "https://si.imgix.net/bea45fda/uploads/origins/b79f8f1d-481e-4d59-848e-93f59e829e64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc33b17ae594319e2d2c2105b331c447, https://si.imgix.net/bea45fda/uploads/origins/b79f8f1d-481e-4d59-848e-93f59e829e64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=605e0