プレーさせてもらっています。わた先生のイラストを一目見てファンになりましたのでリクエストさせていただきます！\n\nVRChatというゲームで私が使用しているアバター「リリエちゃん」を描いて頂けないでしょうか？\n\nシチュエーションとしましては…\nお外でマイクロビキニなどの恥ずかしい格好で露出して歩いている感じのイラストをお願いします！\n(表情や裸差分などがあれば嬉しいです…！)\n\n細かいところなどはお任せいたします。\nわた先生のお好きに描いて頂けたら幸いです。\n\nなお、３Ｄモデル改変元の規約で、R18利用が問題ない旨を確認しております。\n今回アバターのイラストという特殊な依頼ですが、気を使わずえっちに描いて頂けると嬉しいです…！\n\nhttps://drive.google.com/drive/folders/1MB1B4AB_kVbSlQxu3lDU7uUd0SBf4u_S?usp=sharing", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cottcan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1883151, "client_id": 177120, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/163115fc/uploads/origins/2ff7ee14-6f95-41a3-9035-ed2a14382e67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c412d6656fdcaf834d082e117d1681f", "srcset": "https://si.imgix.net/163115fc/uploads/origins/2ff7ee14-6f95-41a3-9035-ed2a14382e67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c412d6656fdcaf834d082e117d1681f, https://si.imgix.net/163115fc/uploads/origins/2ff7ee14-6f95-41a3-9035-ed2a14382e67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be674660b83544c02633325f4c7ad3df 2x, https://si.imgix.net/163115fc/uploads/origins/2ff7ee14-6f95-41a3-9035-ed2a14382e67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c35a9de6c81e72d95ecf943c8d2c093 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/163115fc/uploads/origins/2ff7ee14-6f95-41a3-9035-ed2a14382e67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=885ea176abce888cab09113409d4211d", "srcset": "https://si.imgix.net/163115fc/uploads/origins/2ff7ee14-6f95-41a3-9035-ed2a14382e67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=885ea176abce888c