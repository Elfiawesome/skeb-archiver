=crop&crop=top&w=200&h=200&s=8e477648b432410421bbd2cd6c46ce4e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f02cb594/uploads/origins/879ab411-5259-4ae4-8a15-384aaec9735f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ece736c43b909eda63d4d29edbea949c", "srcset": "https://si.imgix.net/f02cb594/uploads/origins/879ab411-5259-4ae4-8a15-384aaec9735f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ece736c43b909eda63d4d29edbea949c, https://si.imgix.net/f02cb594/uploads/origins/879ab411-5259-4ae4-8a15-384aaec9735f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2153f5329e56acbe4ca5f9cbac5f00e7 2x, https://si.imgix.net/f02cb594/uploads/origins/879ab411-5259-4ae4-8a15-384aaec9735f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6c36b66bd5861cb7136ca8c8c87da2a 3x"}, "body": "はじめまして\nいつも応援させていただいているアングラ星人様にリクエストさせていただきます\n\nキャラ...ソニア（ポケモン剣盾）\n\nソニアが「でんきショック」を受けて体が痺れているところのイラストをよろしくお願いします\nズボンがずり下がってパンツが丸出しになりながら「し、しび、しびれりゅううう」と言っている感じで、ソニアのポーズや攻撃しているポケモンはなんでも構いません\n\nよろしくお願いします\n\nhttps://x.com/kuresome/status/1327194497222995970?s=46&t=_IZ43sddBsq0YMa4ZiJXuQ", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@UGseijin/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1008010, "client_id": 1309040, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f3207cc/uploads/origins/aebeb7b2-af27-4d17-b3f3-3758288ce7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ed635127560f8245d34a5ccfe6ec12c", "srcset": "https://si.imgix.net/3f3207cc/uploads/origins/aebeb7b2-af27-4d17-b3f3-3758288ce7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ed635127560f8245d34a5ccfe6ec12c, https://si.imgix.net/3f3207cc/uploads/origins/aebeb7b2-af27-4d17-b3f3-3758288ce7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78c260cec4d072f00c04ed7c23329f4b 2x, https://si.imgix.net/3f3207cc/uploads/origins/aebeb7b2-af27-4d17-b3f3-3758288ce7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e75710a8bba6aa9d7e31097fe7a7cbe9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f3207cc/uploads/origins/aebeb7b2-af27-4d17-b3f3-3758288ce7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e43724154097d39b10ef452e91e0121a", "srcset": "https://si.imgix.net/3f3207cc/uploads/origins/aebeb7b2-af27-4d17-b3f3-3758288ce7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e43724154097d39b10ef452e91e0121a, https://si.imgix.net/3f3207cc/uploads/origins/aebeb7b2-af27-4d17-b3f3-3758288ce7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a70b1fb530d91944983c61bc56e5c099 2x, https://si.imgix.net/3f3207cc/uploads/origins/aebeb7b2-af27-4d17-b3f3-3758288ce7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=479f0050de45719aa58dd5ae465a967b 3x"}, "body": "はじめまして！突然ですがリクエストさせていただいてもよろしいでしょうか？\n\nキャラはポケモンのヒカリちゃんでお願い致します。\n\nヒカリちゃんがワンリキーに襲われ、気絶しているシーンを希望します！\n\nシチュエーションは、野生のワンリキーが突然現れ、ポケモンを出す間もなく空手チョップで気絶させられてしまう、といった感じです。\n\n気絶しているヒカリちゃんの寝顔はギャグ調ではなく目を閉じて、冷や汗や涙は無しで。\n\n「ワンリキーのからてチョップ！」「ヒカリは気絶してしまった！」的なメッセージがあれば嬉しいです。\n\nヒカリちゃんの台詞は完全に気絶しているので「う〜ん…」のみでお願い致します。\n\n構図などはお任せ致します。パンチラがあれば嬉しいです。\n\n以上変なリクエストですが、ご検討いただければ幸いです！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@UGseijin/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1008010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f7a16611/u