4e10-8641-e35c300a1df3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2879e2b50876c5e61a6890b655f2ec35 3x"}, "body": "八千代ちゃんの無防備なお尻がイタズラ好きの子供が繰り出すカンチョー(4本指で凶悪な威力)の標的になり、肛門を乱暴かつ唐突にこじ開けショーツが直腸まで入り込んでしまい、その強烈な刺激に悶絶するというシチュエーションを描いていただけ無いでしょうか。\nその後お尻を上に突き出した大胆な体勢で地に伏してしまい、手で肛門を抑えて痛みが治まるまで動けなくなっているような様子を描いていただきたいです。\nまた自身の特殊な性癖による要望なのですが、可能ならここでおならが漏れてしまう描写を入れていただけないでしょうか…\n\n最終的な内容は風花ゆらり先生におまかせさせて頂きます、何卒ご検討よろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KazahanaYurari/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dce3deaa/uploads/origins/b785af5a-f73d-4778-ab87-6986b819cf60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=682ee12cf973726163303d67c9a12220", "srcset": "https://si.imgix.net/dce3deaa/uploads/origins/b785af5a-f73d-4778-ab87-6986b819cf60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=682ee12cf973726163303d67c9a12220, https://si.imgix.net/dce3deaa/uploads/origins/b785af5a-f73d-4778-ab87-6986b819cf60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c827491bb0c00ae9afdde02b80cf99f 2x, https://si.imgix.net/dce3deaa/uploads/origins/b785af5a-f73d-4778-ab87-6986b819cf60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=54d8a18ca08f8566bc221e6239ad5c07 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3877742, "nc": 177}, {"path": "/@KazahanaYurari/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": fa