lur=200&s=e7aba12f41a77e91a74842b1aa45ad3d 3x"}, "body": "ふたなりの錠前サオリさんが女先生を乱暴に犯しているところをお願いします。\nサオリさんは我慢しきれず女先生を身体目当てで襲ってひたすら性欲をぶつけていて、\n女先生もサオリさんの顔がいいのであまり抵抗しておらず嫌がっていない様子だととても嬉しいです。\nふたなりはあくまでサオリさんと女先生をどうしてもどろどろに爛れた肉体関係にしたいがために分かりやすい記号として設定しているに過ぎず、\nふたなりであることを強調するような構図にしていただく必要はなく、ふたなりであることが分からなくても結構です。\n女先生のキャラデザは任意で細かな指定はありませんが、件のアロナちゃんの似顔絵やアニメ先生に引っ張られないよう、ボーイッシュではなく女性っぽくお願いしたいです。\n\nこれまで他の方にも同様のシチュを描いていただいており、\n玄米先生に今回描いていただく作品の内容を問わず、これから他の方にも同様のシチュを描いていただく可能性がありますが、\n他の方のこれまで描いていただいた作品に満足していないということや、\n玄米先生に今回描いていただく作品に満足しないということでは決してないということを予め明記します。\nこのような背景を隠すのは公平ではないと考えているため明記しましたが、お気に障るようでしたら蹴っていただければと思います。\n\nよろしくお願いします", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oremamo18/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0d9060ef/uploads/origins/7cf790ec-3446-46d0-b5c0-94cf379c7cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb95a2a7a31d6b7e53e11edeba2a33e6", "srcset": "https://si.imgix.net/0d9060ef/uploads/origins/7cf790ec-3446-46d0-b5c0-94cf379c7cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb95a2a7a31d6b7e53e11edeba2a33e6, https://si.imgix.net/0d9060ef/uploads/origins/7cf790ec-3446-46d0-b5c0-94cf379c7cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3492b490ce8c94eacb6553cefed1f77 2x, https://si.imgix.net/0d9060ef/uploads/origins/7cf790ec-3446-46d0-b5c0-94cf379c7cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b09737956068298235d126b1daded1d4 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2952225, "client_id": 2496194, "nc": 160}, {"path": "/@oremamo18/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2952225, "client_id": 40622, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3bb7a41/uploads/origins/71356ab7-5ae9-44e4-afd9-cc6dc152ac66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68be6c273671b8b2ee7169a938e3a7dd", "srcset": "https://si.imgix.net/e3bb7a41/uploads/origins/71356ab7-5ae9-44e4-afd9-cc6dc152ac66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68be6c273671b8b2ee7169a938e3a7dd, https://si.imgix.net/e3bb7a41/uploads/origins/71356ab7-5ae9-44e4-afd9-cc6dc152ac66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57d31420a9c1c615eeafdd71734d290f 2x, https://si.imgix.net/e3bb7a41/uploads/origins/71356ab7-5ae9-44e4-afd9-cc6dc152ac66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0485d2b5ba1e9a978df9726f20e6aeda 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3bb7a41/uploads/origins/71356ab7-5ae9-44e4-afd9-cc6dc152ac66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db9bc0ff8bea65b1ccfd554d0553564e", "srcset": "https://si.imgix.net/e3bb7a41/uploads/origins/71356ab7-5ae9-44e4-afd9-cc6dc152ac66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db9bc0ff8bea65b1ccfd554d0553564e, https://si.imgix.net/e3bb7a41/uploads/origins/71356ab7-5ae9-44e4-afd9-cc6dc152ac66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b99127ec0181583038dfb41a28b5f5b 2x, https://si.imgix.net/e3bb7a41/uploads/origins/71356ab7-5ae9-44e4-afd9-cc6dc152ac66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=052a6f4be65f193a3ddf794858eb6d13 3x"}, "body": "pixivでとてもエッチな作品を拝見しまして是非依頼させて頂きたいと思います。\n申し訳ないぐらい特殊性癖(tsf・どうぶつなかよし)になってしまうのですが是非お願いしたいと思います。\n\n形式はとりあえずイラストで出しますが表現しやすい方で構いません。\n\n作品:ブルーアーカイブ\n概要:女体化メイド先生が豚タイプの市民にハメ潰されて完堕ち・生徒化してしまう所をお願いします。\n\n流れ上アスナとカリンが出て来ますがセリフだけの登場で大丈夫です。\n女体化先生は黒髪ロングのデカパイ美女でメイド服はカリンと同じ物(白タイツも同じ)でお願いします。\n\nとある屋敷の潜入調査から帰ってこないアスナ・カリンを心配して自身もサヤの薬で女体化しメイドとして潜入する先生だったが既に完堕ちしてしまっていた両人の手引きにより即捕まってしまう。\n\nたった一晩で堕とされて妊娠させられてしまった事を伝え、「先生もご主人様(既に呼び方が変わってしまう程堕とされている)のツガイにしてもらおうよー」と提案するアスナと「それは名案だ、先生もご主人様のお嫁さんにしてもらうといい」と同調するカリン\nアスナ達を絶対に取り戻す、と気丈に振る舞っていたが豚市民の極悪長豚チンポを見せられ青くなる先生\n挿入されピストンされるとあまりの気持ちよさに喘ぐことしか出来ず、先端を子宮口の中に入れられたり、弱い所を虐められたりしてどんどん堕とされて行く先生\n身体も堕ちていくのと同時に頭の上に薄っすらとヘイローが現れ始める。\n射精に近づいて行く豚市民を見て「そういえば精液に特殊な作用があるみたいで中出しされちゃったら最後、もう頭の中までご主人様のツガイに生まれ変わっちゃうからね♪」と伝えるアスナ\nそれだけは許して！と焦る先生にトドメを刺すかのように豚チンポを子宮に挿入し射精し始める豚市民。\n子宮に精液が流れ込む度「男としての自分」が「ご主人様のメス」に塗り潰されていくのが分かってしまう先生。\nイキ狂いながら頭の中まで女の子にされていき、ご主人様への愛が溢れてくる。\nお腹が膨らむくらい射精され遂に受精してしまうと同時にヘイローが完全に現れ生徒化してしまう。\nこれで先生もご主人様のモノだー、と無邪気に喜ぶアスナと一緒にいっぱい子供を産もうな、と声を掛けるカリンと幸せそうに微笑む先生だった。\n\nセリフは参考程度にして頂ければと思います。変更等どんどんしてもらって構いません。\n内容は改変等して頂いても構いません。\nエッチ中は服装は半脱ぎぐらい、タイツは局部破きのみでヒールは脱がさないで下さい。\nでは何卒よろしくお願い致します。\n\n資料\nカリンメイド服: https://imgur.com/a/4sfJcW5", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oremamo18/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cf998d18/uploads/origins/a6828816-abc6-48af-99a4-fd08a90b85c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9061d82ab96ef5e04cc78d8fb953fb3b", "srcset": "https://si.imgix.net/cf998d18/uploads/origins/a6828816-abc6-48af-99a4-fd08a90b85c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9061d82ab96ef5e04cc78d8fb953fb3b, https://si.imgix.net/cf998d18/uploads/origins/a6828816-abc6-48af-99a4-fd08a90b85c9