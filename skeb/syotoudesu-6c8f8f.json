p=top&w=200&h=200&blur=200&s=2fa7c02055db4f4503f5f39a4e162ee4 3x"}, "body": "初冬さんこんにちは！\n初冬さんの創作キャラであるポウラくんを一枚のキャンバスに詰め合わせるような形でイラストをお願いしたいです。\nポーズなどの指定はありません。\n金額の範囲内で自由に描いていただけたらと思います。\nご検討いただけますと幸いです。よろしくお願いいたします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@syotoudesu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3431695, "client_id": 2688705, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0e904ef/uploads/origins/497b68b9-2a5f-4320-808a-737f2e123b24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa7060851ec9908bc75a7fd0fc5a3ee2", "srcset": "https://si.imgix.net/a0e904ef/uploads/origins/497b68b9-2a5f-4320-808a-737f2e123b24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa7060851ec9908bc75a7fd0fc5a3ee2, https://si.imgix.net/a0e904ef/uploads/origins/497b68b9-2a5f-4320-808a-737f2e123b24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cad6b67805c6d556d6f0e2e26c8fc861 2x, https://si.imgix.net/a0e904ef/uploads/origins/497b68b9-2a5f-4320-808a-737f2e123b24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f43865b15e121f9d999958ba2b146e75 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0e904ef/uploads/origins/497b68b9-2a5f-4320-808a-737f2e123b24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e34730845efc0e71421d463e24a60b0c", "srcset": "https://si.imgix.net/a0e904ef/uploads/origins/497b68b9-2a5f-4320-808a-737f2e123b24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e34730845efc0e71421d463e24a60b0c, https://si.imgix.net/a0e904ef/uploads/origins/497b68b9-2a5f-4320-808a-737f2e123b24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b09236b6f55ac6f5b5da5101048239e9 2x, https://si.imgix.net/a0e904ef/uploads/origins/497b68b9-2a5f-4320-808a-737f2e123b24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2bb0601bf560e483ab334ad678b20093 3x"}, "body": "初冬さんこんにちは！sennyouです！\nskeb開設おめでとうございます、並びにありがとうございます！\nこの度は是非僕の創作カップルを描いていただきたくリクエストさせていただきます。\n\n描いていただきたいのは緋色と泉伊吹です。（ひいぶき）\n僕の創作はすべてのキャラにおいて「二面性」があることをメインとしておりまして、もれずこの二人も二面性があります。雰囲気について、表をとるか裏をとるか、両方をとるか…初冬さんにお任せさせていただきたいと思いますので、とりあえずざっくりと両方について説明させていただきます。\n\n【お願いしたいこと】\n・初冬さんのお正月イラストがとっても好きなので、空間的な背景があること\n・緋色のアパートで泉吹が料理をしている。部屋の様子はどうであれ、二人は幸せそうであること。\n\n【どこをとってもらっても嬉しいざっくり設定達】\n深静緋色　みしずひいろ　　27歳 172センチ　男\n表\n丘の上にある病院で薬剤師をしており、仕事以外に趣味のない冷静で硬派な男性。初恋以降女性経験が皆無。女性不振気味だが、女性に不慣れ故迫られると判断力が鈍る。\n母親のみの過程で幼少期を過ごした。弟は緋色が中学生の時に別の所に引き取られたまま行方知れず。\n裏\n小6の時に幼馴染の泉吹を亡くしている。\n二人で遊んでいた際川に落ちて、何とか助かった後、次からは自分が守る。だから将来一緒に居ようと約束をした翌日に風邪で学校を休んだ際、丁度その朝に泉吹はトラックとの衝突事故で亡くなっている。\n現在は薬剤師として働いているが、ずっと彼女のことを忘れられず、他の女性に興味がない。\n安いアパートの一室に住んでいる。浴槽とシャワー、トイレ以外に部屋は無く、ボロボロのアパートだ。\n中はコンビニ弁当のゴミや即席めんのゴミと酒の缶、職場から拝借した睡眠薬のゴミだけ。眠ると泉吹が呪ってやる、と夢に出る。\nでも最近はずっと思い続けていたらなぜか「家に帰ったら泉吹が居て、あたたかいご飯を作ってくれるし、毎日一緒に眠ってくれるからよく眠れる」んだ。すごく温かい。\n\n三栗谷泉吹　みくりやいぶき　没12歳　140センチ前後　女\n表\n12歳のころに死んだ姿。幽霊。\n緋色のことが最後まで大好きだったし、ずっと一緒に居たかった。成長したかった。\n緋色が似合うって褒めてくれた黄色のレインコートと黄色い半透明の傘、黄色の長靴がお気に入り。\n家は裕福な方で、両親も暖かく、幸せだった。緋色には内緒だったけど、夜職の母親がいるあの兄弟には関わるなって言われていた。\n裏\n緋色とずっと一緒に居たかった。お嫁さんになりたかった。大好きだった思いが強すぎて成仏できなかった。\n真直ぐな気持ちだったから悪霊になって呪うなんてことはしたくなかったけど、霊体として死んだ場所に地縛されているのは「自分の死」に直面し続ける苦痛を伴うから悪霊になってしまった。\n眠るなら夢に出て一緒に遊びたいし、出来る事ならお嫁さんみたいに疲れた緋色を癒してご飯作って一緒に眠りたい。\n最近はちょうど緋色がご飯を食べれなくなって、死に近づいたからか干渉できるようになった。料理を作ってあげて、一緒に眠る毎日。\n…だけど、幽霊が作る料理なんてほんとは存在しないから、現実で食事をしてない緋色はもっと衰弱していく。衰弱すればするほど泉吹が近くなっていく。泉吹が近くなればなるほど、幸せになっていく。幸せになるほど、死に近くなっていく。…幸せだからまあいいか、このまま死んで、そのまま私と成仏しよう。\n\n【その他】\nもしも余力がありましたら、SDイラストも描いていただけると嬉しいです🍀\n\nありがとうございました。もし御縁あればよろしくお願いいたします！！！！\n\nhttps://drive.google.com/drive/folders/18p14oAYTsWwbF1zoFllqL6b5NZddpbpJ?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": []}, "price_history": {"art": [{"amount": 2000, "recorded_at": 1774043165.760335}, {"amount": 4000, "recorded_at": 1781259155.088359}], "comic": [{"amount": 4000, "recorded_at": 1774043165.760335}, {"amount": 5000, "recorded_at": 1781259155.088359}], "correction": [{"amount": 500, "recorded_at": 1774043165.760335}]}, "custom": {}}