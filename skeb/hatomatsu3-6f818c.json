://si.imgix.net/72493d7f/uploads/origins/f6a9b05e-cae8-4d01-a03e-289b158d5f59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9688cdd2a4b404a9bbe54a880b9401a", "srcset": "https://si.imgix.net/72493d7f/uploads/origins/f6a9b05e-cae8-4d01-a03e-289b158d5f59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9688cdd2a4b404a9bbe54a880b9401a, https://si.imgix.net/72493d7f/uploads/origins/f6a9b05e-cae8-4d01-a03e-289b158d5f59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2e0023528e08c84061e1827c2600491f 2x, https://si.imgix.net/72493d7f/uploads/origins/f6a9b05e-cae8-4d01-a03e-289b158d5f59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8db9d95b52565bbebf12637f40557262 3x"}, "body": "【リクエスト詳細】\n鳩先生、お久しぶりです！前回は本当に素晴らしいイラストをありがとうございました。先生の受付が再開されていたため、ぜひまたリクエストしたくご連絡いたしました！\n\n今回も私のキャラクターと松野おそ松の二人をお願いしたいのですが、私が創作した「二次創作（オルタナティブ・ユニバース / パロディ）」の世界観でのイラストになります。\n\n二人の衣装の参考資料を添付（リンク）いたしますが、全体の構図やポーズなどはすべて先生にお任せします！\n参考資料：https://drive.google.com/drive/folders/1bVOLUOHiElegBjrHCkbvv5-p5FYm2pmf\n\nお忙しいところ恐縮ですが、ご検討のほどよろしくお願いいたします！どうぞご自愛ください。\n\nhttps://drive.google.com/drive/folders/1bVOLUOHiElegBjrHCkbvv5-p5FYm2pmf", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatomatsu3/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1629, "client_id": 2858528, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d654880c/uploads/origins/b32c661f-0670-488b-9cb1-8ed015a0c3db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b0b7218840297317e63850d5005aef8", "srcset": "https://si.imgix.net/d654880c/uploads/origins/b32c661f-0670-488b-9cb1-8ed015a0c3db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b0b7218840297317e63850d5005aef8, https://si.imgix.net/d654880c/uploads/origins/b32c661f-0670-488b-9cb1-8ed015a0c3db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7592c3b8c302fb694ec7a13254a08031 2x, https://si.imgix.net/d654880c/uploads/origins/b32c661f-0670-488b-9cb1-8ed015a0c3db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e26333cc9bdd8e339d7b3bbddf88302 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d654880c/uploads/origins/b32c661f-0670-488b-9cb1-8ed015a0c3db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=573ef4ea2c3dfdbe2638a6c18226bbfa", "srcset": "https://si.imgix.net/d654880c/uploads/origins/b32c661f-0670-488b-9cb1-8ed015a0c3db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=573ef4ea2c3dfdbe2638a6c18226bbfa, https://si.imgix.net/d654880c/uploads/origins/b32c661f-0670-488b-9cb1-8ed015a0c3db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bb1e2d9dda5c151dbfb4a6ae2fb6830b 2x, https://si.imgix.net/d654880c/uploads/origins/b32c661f-0670-488b-9cb1-8ed015a0c3db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab6c98e8a8fd4dcd4d492a187ce17528 3x"}, "body": "こんにちは！ :)\n\n『おそ松さん』のスタイルをこんなに素敵に再現してくださって、本当に嬉しかったです。今回は、私が創作したキャラクターとおそ松さんを組み合わせたイラストをお願いしたいです。\n\nおそ松さんには、寝起きのボサボサ頭にしていただけると嬉しいです。というのも、彼の「お兄ちゃん」的な雰囲気から、彼女を深く思いやりつつも、遊び心のある一面も持っているように見えるからです。\n\n私が作ったキャラクターは、内気で控えめな女性です。彼女は彼に深く恋をしています。普段は真面目で礼儀正しいのですが、彼と一緒にいるとリラックスして幸せな気分になります。彼にからかわれるのも楽しんでいます。\n\n背景はシンプルで結構です。細かく描く必要はありません。キャラクターに合ったロマンチックなポーズで描いていただけると嬉しいです。\n\n参考画像をGoogleドライブにアップロードしました。リンクはこちらです：\nhttps://drive.google.com/drive/folders/1VFtstxn0iRgxinYESgK2HpNmVU5bWwkG\n\nお時間をいただき、誠にありがとうございます！\n\n使用目的：個人利用。ソーシャルメディアに投稿・共有する予定で、適切なクレジット表記を行います。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatomatsu3/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f7158657/uploads/origins/6954a33d-8443-4e2d-a14d-83bf900b518f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2bf91e972cecbea73e21b647a83a1fe", "srcset": "https://si.imgix.net/f7158657/uploads/origins/6954a33d-8443-4e2d-a14d-83bf900b518f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2bf91e972cecbea73e21b647a83a1fe, https://si.imgix.net/f7158657/uploads/origins/6954a33d-8443-4e2d-a14d-83bf900b518f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9e8e8271fa525931f228fca5b5f3f84 2x, https://si.imgix.net/f7158657/uploads/origins/6954a33d-8443-4e2d-a14d-83bf900b518f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2c6276fe599d47be7bb2c8a2945d249 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f7158657/uploads/origins/6954a33d-8443-4e2d-a14d-83bf900b518f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8af8522d3f7e21dbb9931a456d09cd0e", "srcset": "https://si.imgix.net/f7158657/uploads/origins/6954a33d-8443-4e2d-a14d-83bf900b518f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8af8522d3f7e21dbb9931a456d09cd0e, https://si.imgix.net/f7158657/uploads/origins/6954a33d-8443-4e2d-a14d-83bf900b518f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e900e936809bd41d8705a66a3529bc5 2x, https://si.imgix.net/f7158657/uploads/origins/6954a33d-8443-4e2d-a14d-83bf900b518f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a4fb49b3ff9adc24547f99f8d4a1b9cf 3x"}, "body": "こんにちは。\nおそ松さんのイラスト、とくにドブスとトト子の入れ替わりの作品がとても気に入っています。\nそこで、今回はドブスとイヤヨ（イヤミの女性版）の入れ替わりを描いた新しいイラストをお願いしたいです。\n（参考画像はこちらです：https://pbs.twimg.com/media/CckWEYuW0AEcyK3?format=jpg）\n\nこのイラストでは、イヤヨがドブスになってしまったことにショックを受けていますが、\n新しい大柄な体でも、もとの体の長い金髪と服装をそのまま保っています。\n彼女は戸惑いながらも、優雅にポーズを取ろうとしています。\nその後ろには、同じポーズをした元の体の魂が描かれています。\n\nその隣には、すでにイヤヨの姿になったドブスがいて、挑発的なポーズをしています。\n彼女もまた、新しい体になっても元の髪型と服装を保っています。\n彼女の後ろにも、同じポーズをした元の体の魂がいます。\n\nキャラクターたちは、前回のイラストのように頭からつま先まで見える構図でお願いしたいです。\nお忙しいところ、私の依頼を読んでくださりありがとうございます。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatomatsu3/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/14cd68d3/uploads/origins/373b398d-d725-469a-82e5-b09fdd0e3907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f0f055dcc5cbb92d2073b583f5a660e9", "srcset": "https://si.imgix.net/14cd68d3/uploads/origins/373b398d-d725-469a-82e5-b09fdd0e3907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f0f055dcc5cbb92d2073b583f5a660e9, https://si.imgix.net/14cd68d3/uploads/origins/373b398d-d725-469a-82e5-b09fdd0e3907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=29d243be3427d6268dd14948e3c39dc6 2x, https://si.imgix.net/14cd68d3/uploads/origins/373b398d-d725-469a-82e5-b09fdd0e3907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d031102f515e445ca676547cf32034c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1629, "nc": 1}], "sent_works": [], "similar_creators": [{"id": 28092, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "すずか", "screen_name": "k_szk", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyuserc