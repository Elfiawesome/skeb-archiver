fw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/435da30d/uploads/origins/392b5126-fe99-4116-bd92-edab109dcfac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dc43be4804b234b952c99d33fd0d993", "src_set": ""}, "body": "初めまして\n和風狼系Vtuberとして活動しております、江空ミレアと申します。\n\nおなかや足の魅せ方が印象的でリクエストさせて頂きます。\n\n今回リクエストしたい姿は普段の姿ではなく、添付したエイプリルフールで生まれた女の子の姿でお願いしたいと思っております。\n\n服装はラフな感じで自由にお願いします。\n構図はお任せいたします。\n\n描いていただいたイラストはSNS、YouTubeのサムネイルなどに使用させていただきたいと思ってます。\n\nお忙しいところ恐縮ですが、ご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1YOKYX2b0TMO4t_pqNTryk25_5ErX_J8m?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsuzi_38/works/32", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2576101, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/769075b7/uploads/origins/8532f457-46c3-4a9a-a441-92743c2edeae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c19ab86e0a4ac94510dc95b00b69cb5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/769075b7/uploads/origins/8532f457-46c3-4a9a-a441-92743c2edeae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=960a36e982de121587f936297849dc07", "src_set": ""}, "body": "制限時間10秒で初音ミクを書いてください", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsuzi_38/works/31", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/eb536e8b/uploads/origins/1e5a17a0-5a6a-40dd-b1db-bc39d2bcce21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a67f5cc9addfab70d62e12f8e2bbcf79", "src_set": ""}, "private": true, "genre": "art", "tippe