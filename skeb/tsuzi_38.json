・首にはチョーカーをつけたい。デザインはレースとリボン。服は袖の長いネグリジェ。すごく透けると言うよりは、おへそや腕を透けさせたい。胸元は空いた形で、谷間はあまりない方がいいです！胸元の下で閉めるタイプで、ヒラヒラが好きなので、袖やスカート部分をヒラヒラさせたい。足はガーターベルト。服の色は白が基準ですが、装飾などはおまかせしたいです！\n\n使用用途は\nIRIAMでの返礼品になります。\nサイズの指定もございません。縦でも横でもどちらでも大丈夫です！\n\n可能であればサイン、背景透過でのデータを頂けると嬉しいです。\nskebでのリクエストはあまり慣れていない為、至らぬ点もございますがご縁がありましたらよろしくお願いします🙇‍♀️", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsuzi_38/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9b136433/uploads/origins/a6e1e037-60cc-4737-a64d-e306a13e7abc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1b4cf911eafd526a98315dce94d4df1", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2576101, "client_id": 600058, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tsuzi_38/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/71b2f2b4/uploads/origins/62a34103-b65e-4dce-9923-0a26d7fb9ee5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec775a8c96c3b2b1b669befcd2ce6e89", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2576101, "client_id": 2282724, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tsuzi_38/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2576101, "client_id": 771724, "vtt_url": null, "t