com/drive/folders/1QlHWZzLW_FDBYrQPbixJ6VGUG_QtSced", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BigKwl/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 224641, "client_id": 3204811, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dfd9feea/uploads/origins/a76e57e3-aff6-4eb3-a695-7984ed6a25d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f5000cc5a5e29f825dbb1b44c590018", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dfd9feea/uploads/origins/a76e57e3-aff6-4eb3-a695-7984ed6a25d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=afb715d31a15c4c23cc17ea4672c0e65", "src_set": ""}, "body": "初めまして。\n\n深夜のお絵かきワンドロの春雨(https://x.com/BigKwl/status/1776611925985546534)の絵を見てひとめぼれしました。\n艦これの 時雨と夕立 の半身像を別々にワンドロにあげていた春雨の様な絵柄でお願いいただけませんか？\nイメージは下記URLの感じで、夕立と時雨の立ち姿が対になっているような構図だと嬉しいです。\nURLの様な表情と微笑している差分をいただけますと幸いです。\n金額が不足している場合は、再リクエストの要望をお願いいたします。\n\nhttps://www.4gamer.net/games/205/G020591/20230125028/", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BigKwl/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 224641, "client_id": 765602, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2329356e/uploads/origins/66d58306-6b3d-4f3e-a699-246f3328a706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12cb23cc5a88540af1032ed6ce45b773", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2329356e/uploads/origins/66d58306-6b3d-4f3e-a699-246f3328a706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbf4852bc3ce887fc2e66aec4e5dae7a", "src_