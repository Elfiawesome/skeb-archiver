s/origins/88dd676c-f3a8-45f6-a7fc-bca4abdd0b6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4e53195097efe2adbef73044467335e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d719e23/uploads/origins/88dd676c-f3a8-45f6-a7fc-bca4abdd0b6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c625b201bbf585645e6c33123c6364e", "srcset": "https://si.imgix.net/1d719e23/uploads/origins/88dd676c-f3a8-45f6-a7fc-bca4abdd0b6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c625b201bbf585645e6c33123c6364e, https://si.imgix.net/1d719e23/uploads/origins/88dd676c-f3a8-45f6-a7fc-bca4abdd0b6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=011cfd2eb0e712abbc1af6a0c08759f7 2x, https://si.imgix.net/1d719e23/uploads/origins/88dd676c-f3a8-45f6-a7fc-bca4abdd0b6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d4443246ad433bebfe68043848047fe6 3x"}, "body": "Vtuberの帷子椿と申します。\nサムネイルに使用するイラストを描いていただきたいです。\n清楚系下ネタNGVTuberなので、ニュイ・ソシエールさんの様な清楚エロなイラストを描いていただきたいでです。\n服装ポーズすべて問いません。\nできましたら全年齢ぎりぎりを攻めていただきたいです。\nよろしくお願いいたします。\n\nプロフィール\n名前：帷子椿（かたびらつばき）\n年齢：1000歳\n種族：猫又（猫又最強の家柄の帷子家本家の当主）\nイメージ：お胸が特にセクシーな清楚で上品なお姉さん\nその他情報：京都出身京都弁を使っている、元ブラック会社勤め、プログラマ\n普段は現実の人間界で人間として生活しながら精気を集めている\n配信を通して多くの人から精気を集めるためにVTuberをしている\n\n三面図：https://x.com/katabira_tubaki/status/1780027759185858679\nチャンネル：https://www.youtube.com/@katabira_tubaki\nX：https://x.com/katabira_tubaki", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MiumiUmi_99/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3562464, "client_id": 3765205, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3cb51c9e/uploads/origins/6221e3bc-7432-4663-a020-e5c82be12734?bg=%23fff&auto