2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75860da5f226d2da0eb73747ac093d5d", "src_set": ""}, "body": "もしも、このタイトルとキャラに反応しましたらぜひ、お願いします。\n依頼はPSの「ルナ・ウィング　時を越えた聖戦」のパティをお願いします。詳しくはhttp://www.success-corp.co.jp/software/sl/lunar/にあります。（ほかにいろいろ参考があるかも）\n\n内容はパティのパイズリをお願いします。おっぱいの大きさは当時の魔乳サイズを現代の魔乳(超乳)サイズでお願いします。だいたい、余裕でへその下を超えるくらいですが、書ける範囲で構いません。モノは亀頭が飛び出るくらい。難しい場合はほぼ隠れてしまうくらい。絵は射精後で同時にパティも大量に射乳しちゃっているイメージで。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mokuzu_U/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 75064, "client_id": 1011572, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a20f95ee/uploads/origins/3e34a7a4-cdc6-4104-a5fc-9a641badfd5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a158a085a8816d74803676365fd49b14", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a20f95ee/uploads/origins/3e34a7a4-cdc6-4104-a5fc-9a641badfd5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e37b90e5b5a1f6ef686dadd1299b06a0", "src_set": ""}, "body": "妊娠してボテ腹の鬼結うかくちゃん（全裸）のらぶらぶ中出しファックをお願いします。\n体位やシチュエーション等はすべておまかせで。\n特殊効果や擬音、喘ぎなどあると嬉しいですが必須ではありません。\n\nよろしくお願いいたします", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mokuzu_U/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 75064, "client_id": 52863, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce2130f2/uploads/origins/190c13aa-6fa1-4d01-a279-4d7b0f067a97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af00187529f830fd4869747fc1f083c5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce2130f2/uploads/origins/190c13aa-6fa1-4d01-a279-4d7b0f067a97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83bd1c6fd60cdf3ddbf6989df2a9c26a", "src_set": ""}, "body": "エロ蹲踞で乳首責めされる艦これの高雄をお願いします\n詳細\n・胸の大きさは頭より大きめの爆乳\n・帽子だけの全裸姿\n・乳首はしごかれるように責められ、母乳が溢れ出てる\n・快楽に素直になってて、気持ちよくなってる表情", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mokuzu_U/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 75064, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09d151d6/uploads/origins/18b053e8-3a93-4989-9c19-d777ecc0bb22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88ada8fa2093199cfa2c5666f39a0c36", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09d151d6/uploads/origins/18b053e8-3a93-4989-9c19-d777ecc0bb22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a414058e96106ff8de9863ebacc835c", "src_set": ""}, "body": "初めて依頼いたします。\n\nキャラクター：井河さくら(対魔忍アサギシリーズ)\n\n構図：立ち絵(全身)\n\n背景：無し\n\n衣装：全裸Yシャツ\n\n小物：首輪\n\n詳細\n構図は、ゲーム等で良く見かけます全身立ち絵でポーズはお任せします。\n衣装は、全裸Yシャツでお願いします。\n胸は大きくお願いします。\nYシャツに乳輪や股間がギリ隠れている感じで、胸の谷間は特に良く分る様にして下さい。\n小物で首輪もお願いします。\n後、表情は普通の表情と照れ顔の2種類頂けたら有難いです。\n\n拙い文面で恐縮ですが、ご承認いただけます様、宜しくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mokuzu_U/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 75064, "client_id": 733446, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ada76146/uploads/origins/44a8978f-79d2-4031-aca1-e353440d7198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e5d2f2a98bf09be9eb1584542f310bf", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ada76146/uploads/origins/44a8978f-79d2-4031-aca1-e353440d7198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=265f92a1c773b32bee3f656d8240dbb7", "src_set": ""}, "body": "お世話になります。\n\n艦これの扶桑のイラストを、【深海忌雷に鹵獲され、触手責めされる扶桑姉様】、というのをお願いしたいです。\n\n戦闘中に捕まった想定なので衣装は半脱ぎ、\n艤装はなくていいですが艦橋髪飾りは必須でお願いします。\n\n触手はおっぱいに絡みつかせて母乳搾り出させるのと、前と後ろの穴に突っ込むのは必須でお願いします。\n快楽に抗えずに嬌声を上げ続ける扶桑姉様といったイメージです。\n\n余裕があればですが、中出しされ続けて忌雷の種でボテ腹になったシーンもお願いします\n\n以上、問題なければよろしくお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mokuzu_U/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/08c79358/uploads/origins/329e491a-3bf7-41fb-a020-73c874c4a569?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc465c08b5c3db8fa726925d889340f7", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 75064, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@mokuzu_U/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 75064, "client_id": 1011572, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e866c49/uploads/origins/e3b7066b-23fe-4dd8-8963-3c9c272ac842?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a16e40ba7537a505a2397ceae0cf1859", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e866c49/uploads/origins/e3b7066b-23fe-4dd8-8963-3c9c272ac842?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0e19a6958ca332ca5b6ef4d8e49812b", "src_set": ""}, "body": "先日はお世話になりました。再送失礼します。\n\n個人VTuber「流魂熾刃（ながれだま・おりは）」と申します。\nこの度も、うちの子の個人VTuber「鬼結うかく（おむすび・-）」ちゃんのイラストをリクエストしたく参りました。\n\nシチュエーションとしては、お座敷（畳なら椅子なし、他なら椅子あり：おまかせ）にて、うかくちゃんが竿役男（モブ）と背面座位でセックスしながら受付をしている、というような感じです。\n背面座位でセックスしてる所の前に、いくらかの書類とノートPCが置かれた（ロー）テーブル（前面パネル無し）を置く、というような感じでも問題ありません。\n姿勢や体勢などはおまかせします。いい感じにエッチな感じでお願いします（ﾑﾁｬﾌﾞﾘ\nなお、基本絵としては、うかくちゃんは快感に頬を赤らめながらも懸命に受付嬢の仕事をしています（しようとしています）が、内太ももには１３回の正の字があり、精液がこぼれまくっています。結合部が見えにくい場合はカットインでお願いします。\n\n抽挿のねばっこい音や押し殺した喘ぎ♡等の擬音、その他特殊効果、なんか湿気などなど多めであると大変興奮しますが、可能な範囲で問題ありません。\n後述の差分ごとにいい感じに変えてもらえるとえっち。\n\n以下の差分があるとうれしいですが、必須ではなく、可能な範囲でえっちにしてくれれば大丈夫です（練習台で構いません）\n・喘ぎ声♡がついに抑えきれなくなり、表情も崩れる（抽挿が激しくなる）\n・中出しされて絶頂してしまう（汁多め）\n・身体をびくんびくんさせながら余韻に浸ってアヘ顔ぽくなる（ち○ぽが抜け、多量の精液がこぼれている）。受精ルーペ（卵子に精子が群がって受精していく様子を拡大したようなよくある漫画的表現）があると嬉しいですね。\n\nこれは本当に可能であればでいいので、なくても全く問題ないですが、\n「後日、おなかがおっきくなっちゃった♡（妊娠しちゃった♡）」が分かる差分（？）または他があると、\nすごく興奮します。\n\n用途は個人観賞及びSNS（自垢での使用、ヘッダーやアイコンでの使用含む）。\n一応、うかくちゃんにも渡す予定です（！？\n\nご検討よろしくお願いいたします。\n\n※クリスタもってるので整理さえされていれば、多少レイヤー分割状態でも大丈夫です。\n※なんかよくわからなかったらクソドエロハラマセFUCKうかくちゃんぷりーず", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mokuzu_U/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 75064, "client_id": 605317, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16a2f837/uploads/origins/576058ee-55b3-4381-b9f3-9fbb1892fed8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=beafc4d7e5ea258815b57ba6c6ea700c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/16a2f837/uploads/origins/576058ee-55b3-4381-b9f3-9fbb1892fed8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5796f7807e423873397fc5e5d2cb93c7", "src_set": ""}, "body": "skeb開設おめでとうございます。早速リクエストしたいと思います。\n\nマブラヴのトータル・イクリプスのフィカーツィア・ラトロワをお願いします。\nhttps://drive.google.com/drive