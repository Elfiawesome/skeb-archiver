\n詳細ガブモンが仰向けに寝ていて、両足を少し広げ、肛門が見えるように持ち上げている。尻尾は地面につけ、ケツの一部が見えるようにする。ガブモンは完全に興奮しており、ペニスはスリットから完全に突き出ている。見る視点はペニスと肛門に焦点を合わせる。\nガブモンは欲望に満ちた表情で見る者を見上げている。彼の目は欲望に満ち、顔を赤らめている。台詞を追加してください、「トレバーくん、早くして...」。もう、入ってきて...本当に欲しいよ。台詞に問題があれば、あなたの判断で修正していただければ幸いです。\n料金の範囲内で可能であれば、挿入、クレンピーの2つのディフをお願いします。\nあとはお任せします。\nたばすこさんの最初のコミッショナーになれたらうれしいです。お時間とご配慮をありがとうございました！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tougarasigbmn/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1611244, "client_id": 3737170, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32d7ff5d/uploads/origins/07bc9dc8-46db-40a4-89fe-ada04e7740c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=085ced8b603e0d804ccf1f7169786bfd", "srcset": "https://si.imgix.net/32d7ff5d/uploads/origins/07bc9dc8-46db-40a4-89fe-ada04e7740c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=085ced8b603e0d804ccf1f7169786bfd, https://si.imgix.net/32d7ff5d/uploads/origins/07bc9dc8-46db-40a4-89fe-ada04e7740c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db536aa5afbadca84444fd5db7c5536e 2x, https://si.imgix.net/32d7ff5d/uploads/origins/07bc9dc8-46db-40a4-89fe-ada04e7740c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=459fd31ea3a42ad0d8c6b955a1abbdb0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32d7ff5d/uploads/origins/07bc9dc8-46db-40a4-89fe-ada04e7740c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfac1933cf215680a007ce9eb34eb22c", "srcset": "https://si.imgix.net/32d7ff5d/uploads/origins/07bc9dc8-46db-40a4-89fe-ada04e7740c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfac1933cf215680a007ce9eb34eb22c, https://si.imgix.net/32d7ff5d/uploads/ori