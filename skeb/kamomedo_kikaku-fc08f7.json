3/uploads/origins/40dc58ed-f263-4ef8-a370-6b299e63fce8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce76148f81e893128769e9d9be7fa7ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7169efd3/uploads/origins/40dc58ed-f263-4ef8-a370-6b299e63fce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=633aad3edb3e55f61a082f58b9a2c307", "srcset": "https://si.imgix.net/7169efd3/uploads/origins/40dc58ed-f263-4ef8-a370-6b299e63fce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=633aad3edb3e55f61a082f58b9a2c307, https://si.imgix.net/7169efd3/uploads/origins/40dc58ed-f263-4ef8-a370-6b299e63fce8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32ea0eaf684853d186454429c7166fea 2x, https://si.imgix.net/7169efd3/uploads/origins/40dc58ed-f263-4ef8-a370-6b299e63fce8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=85f209ab5bb4f1266b5a5eb44bc30613 3x"}, "body": "かもめど様はじめまして、こんにちは！\n\nskebでかもめど様が描かれた作品を拝見しまして、商業ゲームのCGみたいなプロさに一目惚れです！早速ですが、よければぜひ自カプの二人をご依頼させていただきたいと思っております。\n\n「アニマル-DECO*27」という曲をテーマにし、二人がくっついているくらい距離近めでお願いしたいんです。\n若い女の子は表情が豊かな恥ずかしがり屋の感じで、年上の男の人は余裕そうで色気のある笑みを浮かべている様子に描いていただきたいです。\n構図やポーズなどはぜひかもめど様のお筆の進むまま、お好みな感じに描いていただきたいです。\n\n使用用途は個人鑑賞用のpvでの使用を想定しております（もし可能であればキャラクターのみレイヤー分けされているデータをいただけたら嬉しいですが、無くても全然構いません。）\n\nご要望が多くて恐れ入りますが、ご検討いただけますと幸いです。\nご一考のほどなにとぞよろしくお願いいたします🙏\n\nhttps://drive.google.com/drive/folders/1XdKtICfG-wmcPTic39Q_9tnKOoijctqA?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kamomedo_kikaku/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2871154, "client_id": 2166992, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c818da65/uploads/origins/2a6e849d-856b-4f3a-9b0f-2a5681876912?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4195516766cc0112f76dfec13c4c10a5", "srcset": "https://si.imgix.net/c818da65/uploads/origins/2a6e849d-856b-4f3a-9b0f-2a5681876912?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4195516766cc0112f76dfec13c4c10a5, https://si.imgix.net/c818da65/uploads/origins/2a6e849d-856b-4f3a-9b0f-2a5681876912?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d49419a052710e2244d6d9f017d8516 2x, https://si.imgix.net/c818da65/uploads/origins/2a6e849d-856b-4f3a-9b0f-2a5681876912?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1365f013f3957d90a4c0fda677aa4195 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c818da65/uploads/origins/2a6e849d-856b-4f3a-9b0f-2a5681876912?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66368596be1caf5aa8398d883def444d", "srcset": "https://si.imgix.net/c818da65/uploads/origins/2a6e849d-856b-4f3a-9b0f-2a5681876912?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66368596be1caf5aa8398d883def444d, https://si.imgix.net/c818da65/uploads/origins/2a6e849d-856b-4f3a-9b0f-2a5681876912?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d728912b206cebf6482d1c1ba5584d97 2x, https://si.imgix.net/c818da65/uploads/origins/2a6e849d-856b-4f3a-9b0f-2a5681876912?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6818d5c1ecb6a1ba1e3c910b1278f67 3x"}, "body": "こんにちは！kamomedoさん！あなたの絵は綺麗で雰囲気がありますね。\n私のオリジナルキャラクターを描いていただけますか？\nライアン（男の子）】知らない人にはとても無関心なツンデレ少年ですが、仲良くなると弱いところや甘えん坊なところが露わになり、大切な人を守りたい、独占したいという気持ちが強くなります。ゲーム好きで、よく遊ぶ。【髪型は写真1ではなく、写真2を参考にしてください！!】\nエロータ（女の子）】優しいが、怒ると衝動的になる。強くなることに貪欲で、そのために努力を惜しまない。月明かりの花の海で歌うことと、ベリーパフェを食べることが好き。\n\n二人はもともと月の市民だった。その後、どこかの神々が引き起こした騒動により、地球への航路に巻き込まれた。エロータはギャングのボスに助けられ、彼のやり方に納得した。記憶喪失のため、ライアンは騒動を引き起こした神々に騙され、「無礼な人間」（エロータのボスのような）を自由にリンチする騎士団に入った。\nある時、ライアンの騎士団はエロータのボスを標的にした。エロータは彼らを成功させなかった。エロータは誘導によってライアンの正体を知った。エロータは誘導によってライアンの正体を知った。可哀想な少年に同情した彼女は、気絶した彼を助け、今の状況に疑問を抱かせるような証拠を残した。\nつまり、初期の対立とその後の協力を経験した後、2人は徐々に感情を育んでいく。そして、月に戻る方法とこの事件の真実を見つけるために力を合わせる。\n二人の仲を自由に描いてください（対立する場面、和気藹々と共存する場面、その他何でも結構です〜）。\n\nhttps://drive.google.com/drive/folders/1Lh4tKRhHSXi_tVeXmwYm-gPxQYiMQZ_4?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kamomedo_kikaku/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2871154, "client_id": 2855903, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac2ecdae/uploads/origins/78fe9ef3-7899-496e-9045-f3ee9d5e1d94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9293d904dbc4ce100a2ebdf9ac5702e8", "srcset": "https://si.imgix.net/ac2ecdae/uploads/origins/78fe9ef3-7899-496e-9045-f3ee9d5e1d94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9293d904dbc4ce100a2ebdf9ac5702e8, https://si.imgix.net/ac2ecdae/uploads/origins/78fe9ef3-7899-496e-9045-f3ee9d5e1d94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15d6e6063710578d23cdc7a95a5dde1f 2x, https://si.imgix.net/ac2ecdae/uploads/origins/78fe9ef3-7899-496e-9045-f3ee9d5e1d94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72aa7e67928dbb2b3a51a4c9aec44bf9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac2ecdae/uploads/origins/78fe9ef3-7899-496e-9045-f3ee9d5e1d94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=285eecfd7788e6a3f03ba312ed114135", "srcset": "https://si.imgix.net/ac2ecdae/uploads/origins/78fe9ef3-7899-496e-9045-f3ee9d5e1d94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h