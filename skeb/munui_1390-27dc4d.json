.net/82335fae/uploads/origins/6fe12f80-3323-4534-a145-a3c6cae02e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5706f926e26c7e20d30adf27eb148b9c", "srcset": "https://si.imgix.net/82335fae/uploads/origins/6fe12f80-3323-4534-a145-a3c6cae02e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5706f926e26c7e20d30adf27eb148b9c, https://si.imgix.net/82335fae/uploads/origins/6fe12f80-3323-4534-a145-a3c6cae02e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=01b86eb30091dc9c8e63bc746cfe552e 2x, https://si.imgix.net/82335fae/uploads/origins/6fe12f80-3323-4534-a145-a3c6cae02e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7ec91fc80858b54525599f0e8f964d18 3x"}, "body": "こんにちは、無縫先生。あなたのレトロで美しいアートスタイルがとても好きです。もし可能でしたら、私のオリジナルキャラクターたちのイラストを描いていただけませんか？先生が得意とする日本の学園風景の背景で描いていただけると嬉しいです。彼らを少年の姿で描いても大丈夫です！以下にキャラクターの設定紹介を記載します：\n短髪のキャラクター：ラファエル。彼は感受性の強い人物で、両親はおらず、キリスト教を信仰する親戚の家に居候しています。いつも笑顔を浮かべていますが、内心はとても冷淡です。霊的なものが見える能力を持っていますが、エスモンド以外には信じてもらえません。\n長髪のキャラクター：エスモンド。彼は神秘的な転校生で、蛇のような雰囲気を持ち、皆からとても人気があります。しかし、なぜか大勢の中でラファエルを友人として選びました。家庭環境はあまり良くないようで、時々傷を負ったまま登校することもあります。そして、ある夏の日に、彼は永遠に自らの命を終えてしまいました。\nもし可能であれば、映画のポスターのようなレイアウトにしていただけたら嬉しいです。映画のタイトルは「ライアダー（Rhayader）」です。ご依頼を引き受けていただけたら、とても感謝します。どうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-nf8-UPMBCyE1XFbKrJhaEYCCD7ijUvA?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@munui_1390/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2887228, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d673d3b/uploads/origins/0de13a81-0014-48c1-86a8-f21b4b1a6a82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77424480827cd7ed75b781158a977d2a", "srcset": "https://si.imgix.net/1d673d3b/uploads/origins/0de13a81-0014-48c1-86a8-f21b4b1a6a82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77424480827cd7ed75b781158a977d2a, https://si.imgix.net/1d673d3b/uploads/origins/0de13a81-0014-48c1-86a8-f21b4b1a6a82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36dd6207249f86df9a99df141f6ff632 2x, https://si.imgix.net/1d673d3b/uploads/origins/0de13a81-0014-48c1-86a8-f21b4b1a6a82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9ad1e3b62dcf2ff0e389e8af1073379 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d673d3b/uploads/origins/0de13a81-0014-48c1-86a8-f21b4b1a6a82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40d9a2233fccad108989ebf00944effb", "srcset": "https://si.imgix.net/1d673d3b/uploads/origins/0de13a81-0014-48c1-86a8-f21b4b1a6a82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40d9a2233fccad108989ebf00944effb, https://si.imgix.net/1d673d3b/uploads/origins/0de13a81-0014-48c1-86a8-f21b4b1a6a82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c3618942eff21a278da8aecb92705879 2x, https://si.imgix.net/1d673d3b/uploads/origins/0de13a81-0014-48c1-86a8-f21b4b1a6a82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8db9eae0cc426d019f8b74dac53b747e 3x"}, "body": "はじめまして！Xで素敵なイラスト拝見し、是非TRPGの自キャラをお願いできたらと思いリクエストさせて頂きました！あまりリクエスト慣れしておらず、失礼があれば申し訳ございません……！\n\n▼構図等詳細\n下記二人を一緒に描いて頂くことは可能でしょうか？ご負担でしたらどちらか一人だけでも構いません。構図やシチュエーションに関しては下の単語から描きやすそうなものを拾って頂けるとありがたいです。\n「同棲/ココア/カレー/映画/終末/宇宙/月/向日葵/薔薇」\n幾つか服の資料も添付させて頂きましたが、アレンジ等自由にして頂ければと思います。\n\n▼キャラクターの詳細\n🐰黒髪の方\n職業：製薬師\n年齢/性別：19歳/男性\n身長/体重：179cm/54kg\nモチーフ：兎\n〇外見特徴\n・基本下の方で二つ結びをしているが、アレンジをする事もある。\n・🐯が両耳の耳たぶにピアスを開けたので黄色の小さい丸いピアスをつけている。また、チョーカーも貰ったので知り合いの前以外ではお揃いの黒いチョーカーを付けている。右手薬指にお揃いの銀の指輪。\n・ギザ歯\n〇性格\n天才製薬師。子どものようにはしゃいだり怒ったりもするが、非常に静かな面もある。🐯の愛情表現にウワーッ！となったり受け入れたりとしている\n\n🐯金髪の方\n職業：舞台俳優\n年齢/性別：18歳/男性\n身長/体重：189cm/69kg\nモチーフ：虎\n〇外見的特徴\n・両手に黒い手袋/右手薬指にお揃いの銀の指輪(手袋の下)\n・右目は白(薄い灰色)\n・🐰とお揃いの黒いチョーカーをつけている\n〇性格\n超恋愛体質、超依存体質。誰にでも敬語で丁寧そうだが、独占欲が強く他人が🐰に近づくとしこたま威嚇する。黙っていればイケメンだがそれなりにアホなので結構抜けている。\n\n▼関係性\n恋人。🐯の過剰気味なスキンシップを🐰が拒否したり受け入れたりしている。🐯(攻め)×🐰(受け)\n\n▼使用用途\n個人観賞、個人的なグッズの作成、SNSのヘッダー・アイコン(使用させて頂く際はお名前を記載させて頂きます)\n\n金額や条件など合いませんでしたら再送請求・キャンセルしていただき問題ございません。お手すきの際ご検討いただければ幸いです！\n\nhttps://drive.google.com/drive/u/0/folders/1i7jZDPsR0JPQWprYYpubgGdL6MDAH4aZ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@munui_1390/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2887228, "client_id": 2739918, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62c4c8c7/uploads/origins/c7e3328c-e2fb-422c-a874-4d78a0e9da11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92ff24cd316f563648195a012cc145e2", "srcset": "https://si.imgix.net/62c4c8c7/uploads/origins/c7e3328c-e2fb-422c-a874-4d78a0e9da11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92ff24cd316f563648195a012cc145e2, https://si.imgix.net/62c4c8c7/uploads/origins/c7e3328c-e2fb-422c-a874-4d78a0e9da11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79940a4d07e4d11ddde2efd77716f5bb 2x, https://si.imgix.net/62c4c8c7/uploads/origins/c7e3328c-e2fb-422c-a874-4d78a0e9da11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b661c1bdac6ee2b1b9064593881f846 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62c4c8c7/uploads/origins/c7e3328c-e2fb-422c-a874-4d78a0e9da11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c395f7cdcd4990af91e8cc217f261dc", "srcset": "https://si.imgix.net/62c4c8c7/uploads/origins/c7e3328c-e2fb-422c-a874-4d78a0e9da11?bg=%23fff&a