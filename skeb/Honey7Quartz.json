139246586?s=19)のアートをお願いしたいです。\n彼女は料理とレトロゲームが大好きなとても親切で優しい女の子です。レナの好きなポーズを自由に選んでください。\nSNSに投稿する予定です。ありがとうございました。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Honey7Quartz/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3778926, "client_id": 3522376, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dfcc5132/uploads/origins/82b7d0df-b975-437c-8d1a-309c27e95414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd49ffa298f829d73bfb3c10b0fc3c97", "srcset": "https://si.imgix.net/dfcc5132/uploads/origins/82b7d0df-b975-437c-8d1a-309c27e95414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd49ffa298f829d73bfb3c10b0fc3c97, https://si.imgix.net/dfcc5132/uploads/origins/82b7d0df-b975-437c-8d1a-309c27e95414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e23f4e590b5adb09f02858c6c8769a7e 2x, https://si.imgix.net/dfcc5132/uploads/origins/82b7d0df-b975-437c-8d1a-309c27e95414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63ff8017815fe9430051cce7ec31f0f6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dfcc5132/uploads/origins/82b7d0df-b975-437c-8d1a-309c27e95414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2d9dc5b575ebc2338adaca621b9d8e6", "srcset": "https://si.imgix.net/dfcc5132/uploads/origins/82b7d0df-b975-437c-8d1a-309c27e95414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2d9dc5b575ebc2338adaca621b9d8e6, https://si.imgix.net/dfcc5132/uploads/origins/82b7d0df-b975-437c-8d1a-309c27e95414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c1b46b04e291afc256ce9351e6f9a2b 2x, https://si.imgix.net/dfcc5132/uploads/origins/82b7d0df-b975-437c-8d1a-309c27e95414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f88a0189bd7de9490294e70b189b84c9 3x"}, "body": "初めまして、個人でVtuber活動をしている碧みどりと申します。\n今回はSNSでらび〜な様の結城さくなさんイラストを拝見いたしまして、自分のVtuberモデルのイラストを描いていただきたいと思い、恐れながらリクエストさせていただきました。\n\n【キャラクターと依頼内容】\n・ゲーマー（ゲーム大好き）な錬金術師です。\n・格闘ゲーム(スト６)とアクションゲーム好きです。\n・リスナーさんには中性的な要素に定評があります。\n・またっりゆるくゲームを楽しんでいます。\n\n見た目に関しては資料URLに立ち絵を掲載しておりますので、お手数ですがそちらを参考にご制作ください。\n\n構図やポージングについては先生にお任せで自由にお描きいただきたいと存じます。\n\nまた、通常の配信等活動内（下記使用用途）で使用するイメージのイラストでお願いできますと幸甚でございます。\n\n【使用用途】\n・Youtubeの動画サムネイルや配信内の使用\n・Twitter（現エックス）等のSNSでの活動に使用\n※全て使用の際には必ず名前とSNSのURLを記載いたします。\n\n【データの内容】\n1920×1080以上であればサイズ指定はございません。\nサムネイル等に使用する可能性もあるため、髪の毛の先や指の先が切れていない構図ですと大変助かります。（上半身のみや膝上からのイラストは可）（帽子の有無もお任せいたします。）\nまた、納品データはPSDファイルでお願いしてもよろしいでしょうか。\nPSDの中身に関しまして、文字・人物・背景で分けていただけますと幸甚です。\n\n上記問題ございませんでしたら是非ご検討ください。\nお忙しい中かと存じますが、何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1TdlfjqW5sZCJi3wB87yKbEXxaPj8V0DB?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Honey7Quartz/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3778926, "client_id": 1194247, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb75a11f/uploads/origins/199e73b5-53c9-472f-8de6-1f87e7f1fb6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d930b43cc033b267cc978452490e6c6b", "srcset": "https://si.imgix.net/bb75a11f/uploads/origins/199e73b5-53c9-472f-8de6-1f87e7f1fb6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d930b43cc033b267cc978452490e6c6b, https://si.imgix.net/bb75a11f/uploads/origins/199e73b5-53c9-472f-8de6-1f87e7f1fb6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f6defc74950b03464443a37ddec6b96 2x, https://si.imgix.net/bb75a11f/uploads/origins/199e73b5-53c9-472f-8de6-1f87e7f1fb6c?bg=%23fff&auto=format%2Ccompress&