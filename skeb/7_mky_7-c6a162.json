を回避するため。\n髪にインナーカラーが入っている（三面図参照）目の色はインナーカラーと同じで緑ではないです（AIで資料を制作しているためややこしいですが、三面図参考でお願いします）\n\nhttps://drive.google.com/drive/folders/1ldnQ85FiD2bewf2m3tZyI8EBekVtrdmj\nhttps://drive.google.com/drive/folders/1vEsUUbtBMMe0u8itbaKtlOKZw4UYNphw\n\nもしご縁がありましたら、よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7_mky_7/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1689067, "client_id": 324730, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/895b33d0/uploads/origins/9b16cd6e-8177-4997-abd5-16385183e1e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2955dceec44a9b6f690a1c660372d333", "srcset": "https://si.imgix.net/895b33d0/uploads/origins/9b16cd6e-8177-4997-abd5-16385183e1e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2955dceec44a9b6f690a1c660372d333, https://si.imgix.net/895b33d0/uploads/origins/9b16cd6e-8177-4997-abd5-16385183e1e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36919d801da279bf0d1fbcf38a6ca747 2x, https://si.imgix.net/895b33d0/uploads/origins/9b16cd6e-8177-4997-abd5-16385183e1e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45ae620c5fadb77fc7fbe520dae7f841 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/895b33d0/uploads/origins/9b16cd6e-8177-4997-abd5-16385183e1e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d2a69fb957cdb0e39064e6b11acf6b3", "srcset": "https://si.imgix.net/895b33d0/uploads/origins/9b16cd6e-8177-4997-abd5-16385183e1e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d2a69fb957cdb0e39064e6b11acf6b3, https://si.imgix.net/895b33d0/uploads/origins/9b16cd6e-8177-4997-abd5-16385183e1e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&f