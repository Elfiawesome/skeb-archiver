jpg?w=640&ssl=1\n\n\n服装は全裸又は絵師様にお任せ\n\n両足裏や足のつま先が描かれてると助かります\n\nよろしくお願いします", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Geocentrism_T/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1990432, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28f9f84c/uploads/origins/043f3d6e-af03-4f34-bbe2-08150409215d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ec068b96db1eafbb426c0509156e921", "srcset": "https://si.imgix.net/28f9f84c/uploads/origins/043f3d6e-af03-4f34-bbe2-08150409215d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ec068b96db1eafbb426c0509156e921, https://si.imgix.net/28f9f84c/uploads/origins/043f3d6e-af03-4f34-bbe2-08150409215d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a28b9e65d04065e7d775af96a7d9ae85 2x, https://si.imgix.net/28f9f84c/uploads/origins/043f3d6e-af03-4f34-bbe2-08150409215d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77e270de74d112872888fad1dbbc08eb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28f9f84c/uploads/origins/043f3d6e-af03-4f34-bbe2-08150409215d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fde5bd346175fa2270867348c5c67631", "srcset": "https://si.imgix.net/28f9f84c/uploads/origins/043f3d6e-af03-4f34-bbe2-08150409215d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fde5bd346175fa2270867348c5c67631, https://si.imgix.net/28f9f84c/uploads/origins/043f3d6e-af03-4f34-bbe2-08150409215d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bfa217e5a206e92cf1090c7d083f1ca8 2x, https://si.imgix.net/28f9f84c/uploads/origins/043f3d6e-af03-4f34-bbe2-08150409215d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c03aae6a333b08bae3787d0fc984c732 3x"}, "body": "リクエストさせていただきます。\n「光と影のドッペルゲンガー」で福寿会が聖騎士ノラちゃんとホリ導士(または、ノラちゃんのみ)にボコボコにされた後.その強さに惚れた親分が二人の前で親分と呼ばせてほしいと土下座しながら懇願し、その様子に戸惑う二人みたいな状況を描いてみてほしいです。\n私の想像する福寿会の親分は30代くらいの細マッチョで金髪オールバックな強面です。差分はなくても構いません。\n難しいと思いますがよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Geocentrism_T/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1990432, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90fc57dc/uploads/origins/12418603-b08e-4360-8b7a-39935c9656c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=814ae8f21b845f4b748bfaf6c7f76ad2", "srcset": "https://si.imgix.net/90fc57dc/uploads/origins/12418603-b08e-4360-8b7a-39935c9656c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=814ae8f21b845f4b748bfaf6c7f76ad2, https://si.imgix.net/90fc57dc/uploads/origins/12418603-b08e-4360-8b7a-39935c9656c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0cc40aa58a4535147f80a1a36f9b5d4d 2x, https://si.imgix.net/90fc57dc/uploads/origins/12418603-b08e-4360-8b7a-39935c9656c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cde3d54a06f9e962fce64c3848e58f4e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90fc57dc/uploads/origins/12418603-b08e-4360-8b7a-39935c9656c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b85b9b4e6eb97cec0d09c092fe3ae57", "srcset": "https://si.imgix.net/90fc57dc/uploads/origins/12418603-b08e-4360-8b7a-39935c9656c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b85b9b4e6eb97cec0d09c092fe3ae57, https://si.imgix.net/90fc57dc/uploads/origins/12418603-b08e-4360-8b7a-39935c9656c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=58f13c217e9bfb01774a463e6b029e32 2x, https://si.imgix.net/90fc57dc/uploads/origins/12418603-b08e-4360-8b7a-39935c9656c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=35bd50e6b9789e3d5c47b786c0410a70 3x"}, "body": "こんにちは......お元気ですか？\n\nこちらの参考に似たような状況を描いてください。\nhttps://skeb.jp/@broiler_u/works/18\n\nある少女が足フェチに催眠術をかけられています。少女は裸足で、足を舐められている。少女は嬉しそうに微笑むトランス状態です。もしよろしければ、少女のポーズ、設定、容姿、服装を自由に変えてみてください（胸は平らなままでお願いします）。足フェチのディテールは重要ではなく、男性でも女性でも、ディテールなしでも、シルエットでも構いません．\n\nこの依頼が妥当なものであると判断していただき、完成させていただければと思います。ありがとうございました。", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Geocentrism_T/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1990432, "client_id": 811345, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d59efe79/uploads/origins/74e76614-7eb5-4eb7-8ab2-c7265bc6e46d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd7b5effe463d352fc53d76dc4fb9068", "srcset": "https://si.imgix.net/d59efe79/uploads/origins/74e76614-7eb5-4eb7-8ab2-c7265bc6e46d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd7b5effe463d352fc53d76dc4fb9068, https://si.imgix.net/d59efe79/uploads/origins/74e76614-7eb5-4eb7-8ab2-c7265bc6e46d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ee0b617f869f5a69626d13d82428229 2x, https://si.imgix.net/d59efe79/uploads/origins/74e76614-7eb5-4eb7-8ab2-c7265bc6e46d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=038881babf1f65d46e89af4e6f499a86 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d59efe79/uploads/origins/74e76614-7eb5-4eb7-8ab2-c7265bc6e46d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=353c98142ebcbccd6bf5ddde4deb9f96", "srcset": "https://si.imgix.net/d59efe79/uploads/origins/74e76614-7eb5-4eb7-8ab2-c7265bc6e46d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=353c98142ebcbccd6bf5ddde4deb9f96, https://si.imgix.net/d59efe79/uploads/origins/74e76614-7eb5-4eb7-8ab2-c7265bc6e46d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ef02b95979ca9dc40163dacbd91b903 2x, https://si.imgix.net/d59efe79/uploads/origins/74e76614-7eb5-4eb7-8ab2-c7265bc6e46d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6c51ba92d941097a75de7bfda47c470b 3x"}, "body": "こんにちは。足フェチのアートワークをお願いしたい「きょう」です。彼らは熟女OL/OLです。https://drive.google.com/file/d/1Mpt4LfnLiwITPABBPrTiPFdN_z9d5dYX/view?usp=sharing\n\n彼女が重要なクライアントや投資家を満足させるために、机の上でビジネスミーティングをしているところです。多くの男性が彼女の体中、特に足の上に射精しています。彼女は仰向けに寝ています。\n彼女の手は男性のペニスを包み込み、多くのペニスは彼女の顔や足の方に向けられています。\n\n彼女の足の裏をよく見てください、汗をかいて臭くなるように。服はまだ着ていますが、かなりダメージがあります（パンストが破れている、ブラジャーが肩から下がっているなど）。\nフタナリなので、黒いレースのパンティから見える膨らみや、下着からのぞく肛門も描いていただけると嬉しいです。\n\n誇らしげな表情、凛とした表情で描いてください。彼女はとても喜んでいるのです。\n\nご検討のほど、よろしくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Geocentrism_T/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9a574efd/uploads/origins/31a8ebcf-8c0a-4b07-85a0-c8e2574a1fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3087ba9edbd9e8c4bfacc4a503542494", "srcset": "https://si.imgix.net/9a574efd/uploads/origins/31a8ebcf-8c0a-4b07-85a0-c8e2574a1fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3087ba9edbd9e8c4bfacc4a503542494, https://si.imgix.net/9a574efd/uploads/origins/31a8ebcf-8c0a-4b07-85a0-c8e2574a1fb7?bg=%23fff&auto=format%2Ccompress&fm=