ーであること、シャツは半分タックインしていることに注意してください。\n\n口を開けて描いている場合は、牙があることに注意してください。\n\nポッキーの棒を口にくわえ、浮かない顔をしている彼女を描いてください。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1hEYUA0GjNODnWUZye_H0ntGUK8MVUrZ0?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 15408, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ゆっこし", "screen_name": "yuccoshi", "avatar_url": "https://pbs.twimg.com/profile_images/1559621944257187840/QVuKs1cM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/14082109/1671366732/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 49}, {"id": 159121, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "蜜子", "screen_name": "Himbeere_mituko", "avatar_url": "https://pbs.twimg.com/profile_images/1791439004736671744/cwieb3p0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4092628752/1715538244/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 0}, {"id": 406069, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "錆魚", "screen_name": "sabiuo_saba", "avatar_url": "https://pbs.twimg.com/profile_images/1628111247412715520/aiijJdsa.jpg", "header_url": "https://pbs.twimg.com/profile_banners/927225018823479296/1664408585/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 1}, {"id": 408111, "creator": true, "nsfw_acceptable": false,