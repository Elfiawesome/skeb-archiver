。\n\n【デザイン】\n・髪型:立ち絵イラストの通りのショートヘア\n・衣装:立ち絵の橙色パーカー姿、又はかるぁ様のおまかせ(涼しげな)衣装。\n・表情:喜色\nアクセサリ、装飾品等の細かいディティールについては必要に応じて省略やアレンジして頂いても構いません。\n\n【構図】\n・シチュ:ハンバーガーを食べている場面。\n・ポーズ:片手でハンバーガーを持ち、もう片方の手の指で口端の汚れを拭う。(もしくは指の汚れを舐め取る)\n・詳細:ハンバーガーの包み紙の有無はおまかせ。ハンバーガーは半分まで食べている状態。机の上にドリンクやポテトがある設定だが、描写するかしないかはおまかせ。\n\n【備考】\n・髪型(髪色やアホ毛、編み込みのメッシュ等)は厳守、マニキュア(青色)とイヤリングは忘れないようにお願いします。\n・可能であればキャラクター透過を追加で頂けると嬉しいです。\n\nよろしくお願いします\n\nhttps://x.com/mizuno__uta?t=fgEh5sMTrdFvt8jisKm8WA&s=09", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rkgk__3/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3541225, "client_id": 423758, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/708b86fb/uploads/origins/d0da3060-392a-4f07-8a9c-6ad4458fc6e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2178e760b2f0fe6153c59e79514b020e", "srcset": "https://si.imgix.net/708b86fb/uploads/origins/d0da3060-392a-4f07-8a9c-6ad4458fc6e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2178e760b2f0fe6153c59e79514b020e, https://si.imgix.net/708b86fb/uploads/origins/d0da3060-392a-4f07-8a9c-6ad4458fc6e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a48ffae8145a6b8b31217aac8cd3787 2x, https://si.imgix.net/708b86fb/uploads/origins/d0da3060-392a-4f07-8a9c-6ad4458fc6e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f2c9b7dabc9e315e15447288c7dfa63 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/708b86fb/uploads/origins/d0da3060-392a-4f07-8a9c-6ad4458fc6e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7c585ac911ac95cc3d2b1a22ff35962", "srcset": "https://si.imgix.net/708b86fb/uploads/origins/d0da3060-392a-4f07-8a9c-6ad4458fc6e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&