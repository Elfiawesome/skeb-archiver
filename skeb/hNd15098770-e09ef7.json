200&blur=200&s=fccae40efa5765bfc500e42e691c8fbb, https://si.imgix.net/043bfe7d/uploads/origins/db1f774a-a6e1-43b6-83df-3ec21a0a6506?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4d9f2432101bc96bb39df25d5c35d778 2x, https://si.imgix.net/043bfe7d/uploads/origins/db1f774a-a6e1-43b6-83df-3ec21a0a6506?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f5ae8a1d94ac31c6f508c7694c6e998 3x"}, "body": "こんにちは！先生のイラストがとても好きなので、ocでお願いしたいです！\nhttps://drive.google.com/drive/folders/1-7Fv2cW_1LeS8ZopL4iguR5I1somDo4K\n同じ学校に通う3人の友達で、女の子が一番精神的に大人で、他の2人の心の支えになっている。おっとりしているが、気持ちはよくわかる。\n金髪の男子は彼女の幼なじみで、人前では外向的でチャラチャラしているが、実はとても自信がなく、まるでゴールデンレトリバーのようだ。\n黒髪のオスは物静かで控えめ、その暗い存在感で周囲を怖がらせるが、実は手先が器用で、工作が得意。\nどちらの男性も、少女の助けを借りて成長し、感情の壁を乗り越えることができる。二人の関係はほぼプラトニックだが、恋愛を描くのは自由。\n二人のデザインは自由に変えて、好きなように描いてください。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hNd15098770/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2210554, "client_id": 702918, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a4914fb/uploads/origins/027c3bed-e0f7-4a40-92ee-579c275082a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b0cfc31ead16957c4ae68c5a629c778", "srcset": "https://si.imgix.net/2a4914fb/uploads/origins/027c3bed-e0f7-4a40-92ee-579c275082a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b0cfc31ead16957c4ae68c5a629c778, https://si.imgix.net/2a4914fb/uploads/origins/027c3bed-e0f7-4a40-92ee-579c275082a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ab290d8d563eeb5723664f22828e95c 2x, https://si.imgix.net/2a4914fb/uploads/origins/027c3bed-e0f7-4a40-92ee-579c275082a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12980739e9ae8c804a393356df832c8c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a4914fb/uploads/origins/027c3bed-e0f7-4a40-92ee-579c275082a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=419785058f0594a44c933444feb4d0b1", "srcset": "https://si.imgix.net/2a4914fb/uploads/origins/027c3bed-e0f7-4a40-92ee-579c275082a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=419785058f0594a44c933444feb4d0b1, https://si.imgix.net/2a4914fb/uploads/origins/027c3bed-e0f7-4a40-92ee-579c275082a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=15b5ad3f30badc70d025c147c23c9a21 2x, https://si.imgix.net/2a4914fb/uploads/origins/027c3bed-e0f7-4a40-92ee-579c275082a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ec32468590b7fd053427101789022656 3x"}, "body": "はじめまして。ご多忙中申し訳ありませんが、ぜひイラストを依頼したくリクエストしてみました。\n\n■内容\n①サーカスパロ　宛名は「沙拉鸭马戏餐」\n小林ちゃんはピエロ、家鴨くんは団長の息子で調教師。時代感的には前世紀のサーカス。\n資料：https://sta.sh/22dij05a22o4\n\n②ゾンビパロ　宛名は「沙拉鸭僵尸餐」\n前文：https://skeb.jp/@Ruu_neptune/works/100\n資料：https://sta.sh/22dksv1984ns\n\nの中から都合のいいテーマを選んでください。\n\n\n■参考\n現代日常の資料↓\nhttps://sta.sh/225f1gpc4ozs\n二人は※田舎※で一緒に育った幼なじみ。\n幼い頃から両思いしてた二人はいろいろあって、心を通わせるのはつい最近のこと。\n\n[家鴨くん]\nキーワード：オシャレ、富裕層、落ちこぼれ、怠け者\n\n21歳、175cm\nドラゴンフルーツ色の髪、グレーの少し垂れ目。\nやや近視で、目を細めることが多い。（普段はコンタクト、自宅では黒縁メガネ）\n下まつげはやや長く、目の下には薄いクマがあり。(下まぶただけにスモーキーメイク？みたいな感じ！）。\n顔には、左耳に1つ、右目のまぶたの上に1つ、右目の下に1つ、計3つのほくろがあります。\n\n地元では有名な農家の息子だが、家事手伝いをあまりしない。\n学校でもよくサボる落ちこぼれ生徒。\n農業に帰りたくないという思いから、上京するためにダメな私大でダメな心理学を専攻。\n\n見かけによらずチャラい。女好き。特に童顔巨乳が好き。\n文句を言われても、「へぇーそれなー」と言いごまかすタイプ。\n\n自分勝手で自己中心的。\n恥ずかしくて自分の好みの感情を認めるという点では少しぎこちないだが、意外と自分の（ヤリたい）欲望に正直。\n\n[小林ちゃん]\n\nキーワード：芋女、貧乏、真面目、元気、いい子。\n\n19歳、155cm。\n金髪を三つ編みにし、緑色の丸い瞳。\n童顔で、胸はA～Bサイズくらい。\n胸の大きさがちょっと残念ですが…顔はめっちゃ家鴨くんのタイプ。\n\nいつも爽やかな表情を浮かべ、周囲に元気を与えてくれる。\n\n素直で努力家。\n彼女の家はあまり裕福ではないので、放課後はアルバイトをして学費を稼ぐ。\n地球大好き！小学生の頃のある事件以来ベジタリアン。\n水などの資源を無駄にすることが大嫌いで、夏でもエアコンをつけないほどのエコロジスト。\n\n成績も良く、今は大好きな地球のために大学で環境科学を学んでいる。\nその後は大学院に進む予定。\n\n愛は奇妙な表現をし、ストーカーのような行動をとるようになり（家鴨くんの歯ブラシを使って歯を磨くなど）。家鴨くんはこれに頭を悩ませてる。\n\n構図などは全部お任せします。どうぞご自由に描いてください。\n\n可能であれば納品はPSD・宛名などは別レイヤーでお願いします。\n金額の範囲内で適当と思われるものを描いて頂き、不適切と判断された場合はキャンセルしていただいて大丈夫です。あるいは金額を調整して再送させていただきます！\nよろしければご一考お願いいたします( ´͈ ᵕ `͈ )♡", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hNd15098770/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2210554, "client_id": 2001324, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7eacb738/uploads/origins/4513f2c9-5c78-4525-adf1-f69b89cad4f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=829b511208cbcaeacf70787870b8a708", "srcset": "https://si.imgix.net/7eacb738/uploads/origins/4513f2c9-5c78-4525-adf1-f69b89cad4f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=829b511208cbcaeacf70787870b8a708, https://si.imgix.net/7eacb738/uploads/origins/4513f2c9-5c78-4525-adf1-f69b89cad4f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f8a1ddfd6d9f11fac9eaa0cd97782a9 2x, https://si.imgix.net/7eacb738/uploads/origins/4513f2c9-5c78-4525-adf1-f69b89cad4f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81c2891ac7467e877e2430b56db238bd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7eacb738/uploads/origins/4513f2c9-5c78-4525-adf1-f69b89cad4f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e170dd9f730508e45db1c0bcd63835e3", "srcset": "https://si.imgix.net/7eacb738/uploads/origins/4513f2c9-5c78-4525-adf1-f69b89cad4f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e170dd9f730508e45db1c0bcd63835e3, https://si.imgix.net/7eacb738/uploads/origins/4513f2c9-5c78-4525-adf1-f69b89cad4f6?bg=%23fff&auto=format%2Ccompres