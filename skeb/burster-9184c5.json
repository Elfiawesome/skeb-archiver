いで絶命した陽炎衆の亡骸が無数に転がっている状態。\n・もし可能であれば放屁無し差分と全裸差分もあると嬉しいです。\n\nご検討の程、どうぞよろしくお願い致します。\n\nhttps://www.pixiv.net/novel/show.php?id=21205998#2", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 80886, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "新参者", "screen_name": "shinzanmono108", "avatar_url": "https://pbs.twimg.com/profile_images/1917946542142697472/ZbMlPLOg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/830058310325792768/1642787359/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 104517, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "棒の人@skeb募集中", "screen_name": "stickhuman", "avatar_url": "https://pbs.twimg.com/profile_images/1678401899257536513/W9SjkZWw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/191059422/1688996191/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 131247, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "がいえん", "screen_name": "jin_morisono", "avatar_url": "https://pbs.twimg.com/profile_images/1699034047299850240/PqMwPw6w.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 6, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id