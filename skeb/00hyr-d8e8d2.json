由に描いていただければと思います。\n\n私の出す金額が低すぎる場合は、リクエストを再送してください。もしよろしければ、リクエストを受け入れていただけると幸いです。\n最後までお読みいただき、本当にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1DDSgUG2jVEvFO7kr5g3Cw1fEtIXjyHxO", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@00hyr/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3751844, "client_id": 2576457, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/85cf3b98/uploads/origins/d0830cc8-0bc8-4ff5-9793-92aec3ba31db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c87e8daa27eddd9ec8934728594159b", "srcset": "https://si.imgix.net/85cf3b98/uploads/origins/d0830cc8-0bc8-4ff5-9793-92aec3ba31db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c87e8daa27eddd9ec8934728594159b, https://si.imgix.net/85cf3b98/uploads/origins/d0830cc8-0bc8-4ff5-9793-92aec3ba31db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3914ce511ec7472e1b7e3e82cd13cff8 2x, https://si.imgix.net/85cf3b98/uploads/origins/d0830cc8-0bc8-4ff5-9793-92aec3ba31db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=910244a3ceacc1e858a32b12d4916dca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/85cf3b98/uploads/origins/d0830cc8-0bc8-4ff5-9793-92aec3ba31db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e7088d2b9f25030666603a61e4d01f4", "srcset": "https://si.imgix.net/85cf3b98/uploads/origins/d0830cc8-0bc8-4ff5-9793-92aec3ba31db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e7088d2b9f25030666603a61e4d01f4, https://si.imgix.net/85cf3b98/uploads/origins/d0830cc8-0bc8-4ff5-9793-92aec3ba31db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4097ced545e9b3bf8981a17666be8690 2x, http