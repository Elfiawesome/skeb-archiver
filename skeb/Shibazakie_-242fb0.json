e a beach background as well if possible.\n\nQuetzal's references: https://drive.google.com/drive/folders/1zm-2BFEYDr4jmT7b_9WrJQKVi8BX3Z5I?usp=drive_link\n\nIn some of the images, her hair looks black. Her hair color is meant to be a dark brown.\n\nThank you very much for your consideration.", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Shibazakie_/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9d19d9a2/uploads/origins/46ae0a11-a25a-4716-a4cc-040eff6425b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52b6fb16ba34bfcf7c93971cf98e7835", "srcset": "https://si.imgix.net/9d19d9a2/uploads/origins/46ae0a11-a25a-4716-a4cc-040eff6425b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52b6fb16ba34bfcf7c93971cf98e7835, https://si.imgix.net/9d19d9a2/uploads/origins/46ae0a11-a25a-4716-a4cc-040eff6425b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d8fc91910528485d64e6d395480fc10 2x, https://si.imgix.net/9d19d9a2/uploads/origins/46ae0a11-a25a-4716-a4cc-040eff6425b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b0df27c3211cff332b4a898bb96feee4 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 276572, "nc": 144}, {"path": "/@Shibazakie_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 276572, "client_id": 858606, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db8869ba/uploads/origins/fba3f0e8-82fa-4f1c-b302-756b74