2/uploads/origins/06731f85-8778-4b6c-a796-4714ec8fdf65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=772be8ba2b51262a13f00c3f4bc8d367", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d64a2172/uploads/origins/06731f85-8778-4b6c-a796-4714ec8fdf65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bba4f185fbfd979d5d63267d7e500d7d", "src_set": ""}, "body": "ツイッターで素晴らしいイラストを拝見しています。\nつきましては、ぜひささ舟先生に下記の通りの依頼をしたく思いますので差支えなければよろしくお願いします。\n\n-主-\n・ウマ娘プリティーダービー　より\n　　シンボリルドルフ　バストアップ絵（可能であれば全身）。\n　　　　　　　　　　　背景はお任せいたします（無くても可）。\n　　　　　　　　　　　服装もお任せいたします。\n\nよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SasaFune2357/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6694a295/uploads/origins/206ab5ee-7a8b-42c4-858c-640609c6fb9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a41859c93161854de4b562e37dad9d57", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2969400, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@SasaFune2357/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2969400, "client_id": 255486, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a7579e0/uploads/origins/0e49988a-cc35-46a3-9e70-44037073068f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6192e9da40662bef0a76565da36f435", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_ur