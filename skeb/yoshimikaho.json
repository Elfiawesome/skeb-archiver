RIVATE&s=704993c76ab9cd2acd3ff9ce5806c2d5", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3487721, "client_id": 3614892, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yoshimikaho/works/30", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3487721, "client_id": 3399272, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/519dc46d/uploads/origins/64c9a26e-6fc6-4c7d-b005-b1b45fc33b04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce19aa11b0a27f246e50e57fdbd3ace9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/519dc46d/uploads/origins/64c9a26e-6fc6-4c7d-b005-b1b45fc33b04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1c774c40f4652cd8b10c99e5dcb807b", "src_set": ""}, "body": "こんにちは！僕のOCを2つ描いてほしいんだ :)昔は文章で書いていたので、あまり絵の参考がないんです。私が持っている唯一のアートピースを元に描いてください。\n\nhttps://drive.google.com/drive/folders/1w7OPBWFborpIf0IBBEJPYksM_LeDXtyK?usp=sharing\n\nアルマは160cm、サーカは180cmです。\n\nアルマは魔法の質屋を営む不死身の男。サーカは人間界から来た新弟子で、錬金術を学ぼうとしている。森でハーブを集めているところを描いてください。サーカが手にしているのは、ハーブを識別するための本です。\n\nご配慮に感謝します！価格は必要に応じて調整してください。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoshimikaho/works/29", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e25ebd95/uploads/origins/04f331f8-e6ae-49ac-b160-08d367f13ba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3daee70ad9fc19348388e18c38b2a192", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3487721, "client_id": 3173932, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yoshimikaho/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3487721, "client_id": 3436471, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba671cd5/uploads/origins/26037ac3-0c1b-490c-96ba-df3374520219?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e55a716dde213f99c9a7cce0dc5ebba", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba671cd5/uploads/origins/26037ac3-0c1b-490c-96ba-df3374520219?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a376f759ffad52a3ee30996ffa47e80", "src_set": ""}, "body": "初めまして。個人Vtuberとして活動準備中の星海　久澪と申します。\n偶然お見かけした時から、yoshimi様に私を描いていただきたく思っておりましたので、この度リクエスト送らせていただきます。\n\n\n◉キャラクターのビジュアル、性格等\nhttps://drive.google.com/file/d/1um-w7Uh99t0twD9s27mTgKz8MWiuMXp4/view?usp=drivesdk\nこちらの三面図を参考にしていただきたく思います。性格はおっとり優しく、推し活をしていたりオタクな一面もあります。\n\n\n◉依頼内容 \nもしよければ、ウェディングドレスを着た私を描いていただきたいと思います。マーメイドラインのドレスのようなスタイルがよく見えるドレスが好みなのですが、yoshimi様が似合うと思ったドレスで描いていただいても嬉しいです。\n髪型等ももちろんアレンジしていただいて問題ございません。\n\n納品時、サインや背景等と透過した人物をレイヤー分けしたデータをいただけると助かります。  \n(触覚を描いてくださる場合も、ありなしでわけられるようにしていただきたいです。)\n\n\n◉使用用途 \nYouTubeのサムネ、ファンクラブ・SNSのポストでの使用 、可能であればグッズ化(商用利用)もさせて頂きたく思います。\n条件厳しければキャンセルや、資料不足や金額不足の場合も再送いただけますと対応させていただきたく思います。\n\nお忙しいとは思いますが、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1um-w7Uh99t0twD9s27mTgKz8MWiuMXp4/view?usp=drivesdk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoshimikaho/works/27", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1653516a/uploads/origins/8e420b5e-2fb0-420a-9227-