。\n\n可能な限り人物と背景レイヤー等を分けてPSDデータ、難しいようであればPNGデータで分けていただきたいです。サイズは配信で使えるように16：9のワイドサイズで描いていただけると助かります。\n\n何か不都合等があればキャンセルしていただいて結構です。\n以上です。長々とお読みいただきありがとうございました。\nご検討よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 478244, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "秋入梅せら", "screen_name": "seratanmen", "avatar_url": "https://pbs.twimg.com/profile_images/1504056213637459968/qyZqQBgZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3099791912/1662267429/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 129}, {"id": 2161484, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "202", "screen_name": "fwf_0518", "avatar_url": "https://pbs.twimg.com/profile_images/1857039696544604160/HbBk3Xdt.jpg", "header_url": "https://pbs.twimg.com/profile_banners/970807200921743360/1597486849/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 145}, {"id": 2246012, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "角目Puffin", "screen_name": "tnm44", "avatar_url": "https://pbs.twimg.com/profile_images/1554815304139960320/HqveTgLU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1546341076390539265/1743142135/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2403352, "creator": true, "nsfw_accep