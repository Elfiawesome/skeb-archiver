ogle.com/file/d/19UKPFSWSr3x9sSLihj4Gr8AXg4ZDAkHq/view?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@ohayo_ohayoo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": false, "creator_id": 3629892, "client_id": 2910911, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1447335045933371392%2FK6VYSAuC.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e4d470fca3fce031be1d76cdad72954", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1447335045933371392%2FK6VYSAuC.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e4d470fca3fce031be1d76cdad72954, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1447335045933371392%2FK6VYSAuC.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e7e6bbb56d5fccc99bf4467278a5ee9 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1447335045933371392%2FK6VYSAuC.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bdd8ae6403c0929cccafbafbcf653ed9 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/205469ea-2e3b-4de6-9524-2b1f704d6920?response-content-disposition=inline&Expires=1774655487&Signature=FgX3k5BX9f4iC-gQwWztB~6WL~taBRPoMjRnCfuvLugaUGur86XVwwFvgMLeJB8jgFgDeDhDIzZIqP5yAh5YSSU8TPf4RrIYplIDk9aB95H0jSDHR7GeRHprPbqH-BrYZxr8iHJ-p2GK~uhjmjpXYPQJB0CqQsX~ztwVVWoMmaX6QQZZNKhDhzLIJlKUGig8GHU81V~vc1J~G3Ze13VpwKwjAXkaGATyxCHhRSEhMDPkK9QDGgUyGvYKlXXAcFqINVHNCkXjfBhpoSTrLdKPBoP2p32SmkD44wNUpFOcWz0BLAMboJH1FZfovM6J8MgidhAP8epZkwQi8S-SaJtZBQ__&Key-Pair-Id=K1GS3H53SEO647", "duration": 192, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F144733504593