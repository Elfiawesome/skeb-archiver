52f95788ee9c746a4c", "srcset": "https://si.imgix.net/2d58104d/uploads/origins/dd4adb8c-1498-49ee-97da-00194bc29dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0b6ec75e51bd952f95788ee9c746a4c, https://si.imgix.net/2d58104d/uploads/origins/dd4adb8c-1498-49ee-97da-00194bc29dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1355c3e82edad27fbf621ac0700b5091 2x, https://si.imgix.net/2d58104d/uploads/origins/dd4adb8c-1498-49ee-97da-00194bc29dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4fab8651854bb519e3440b161bfde6ad 3x"}, "body": "I'm the laughing kettle, and I'm always very grateful.\n\nThank you very much for the very cool illustration of Zayt!\nI'm very sorry to say that I've just made a request, but since it's a commission-free campaign, may I ask for one more item? ......\n\nI'm sorry to say that the taste of this illustration is close to the previous one, but I was wondering if you could draw Eunice and Zayt's father, Wolfe, to complete the family. ......\n\nPlease refer to the following URL for the design.\nAs usual, I will leave all the composition to you.\n\nThank you very much for your consideration.\n\nhttp://lkettle.noor.jp/fa/2019/11/05/%e3%82%a6%e3%82%a9%e3%83%ab%e3%83%95%e3%83%87%e3%82%a3%e3%83%bc%e3%83%ab/", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@banilizo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1028467, "client_id": 1462, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f34c5e6b/uploads/origins/dcffd6d9-76ea-4557-ae73-ff8315720738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3397ced56d76fad10c38382dd62d6233", "srcset": "https://si.imgix.net/f34c5e6b/uploads/origins/dcffd6d9-76ea-4557-ae73-ff8315720738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3397ced56d76fad10c38382dd62d6233, https://si.imgix.net/f34c5e6b/uploads/origins/dcffd6d9-76ea-4557-ae73-ff8315720738?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c476b575eeca0ded77321cd342111c8 2x, https://si.imgix.net/f34c5e6b/uploads/origins/dcffd6d9-76ea-4557-ae73-ff8315720738?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=671abbfab2b225d6c1c05c37f0a134dc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f34c5e6b/uploads/origins/dcffd6d9-76ea-4557-ae73-ff8315720738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9ea756223e0a760e59d11e1ba44cb17", "srcset": "https://si.imgix.net/f34c5e6b/uploads/origins/dcffd6d9-76ea-4557-ae73-ff8315720738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9ea756223e0a760e59d11e1ba44cb17, https://si.imgix.net/f34c5e6b/uploads/origins/dcffd6d9-76ea-4557-ae73-ff8315720738?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=21e830a6787df3bdb8528447325352a5 2x, https://si.imgix.net/f34c5e6b/uploads/origins/dcffd6d9-76ea-4557-ae73-ff8315720738?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5c052b05194f9e8cc8ba7e2a6d14e941 3x"}, "body": "Thank you for having me!\nI saw your fleet on Twitter and would love the opportunity!　I'd like to send you a request.\n\nI was wondering if you could draw Zytorid, the brother of Eunice who you drew before.\n\nPlease see the following URL for the design.\n\nThank you in advance for your consideration!\n\nhttp://lkettle.noor.jp/fa/2019/11/05/%e3%82%b6%e3%82%a4%e3%83%88%e3%83%aa%e3%83%bc%e3%83%89/", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@banilizo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1028467, "client_id": 1138555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ced7734/uploads/origins/d38191b0-886e-442e-8729-04066d3c58c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c2ecdd134759196281d25cd02dfb4f3", "srcset": "https://si.imgix.net/0ced7734/uploads/origins/d38191b0-886e-442e-8729-04066d3c58c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c2ecdd134759196281d25cd02dfb4f3, https://si.imgix.net/0ced7734/uploads/origins/d38191b0-886e-442e-8729-04066d3c58c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4eb8509246a650cab788cb41acb81498 2x, https://si.imgix.net/0ced7734/uploads/origins/d38191b0-886e-442e-8729-04066d3c58c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=675e2935d7b886445b63036604057bbd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ced7734/uploads/origins/d38191b0-886e-442e-8729-04066d3c58c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6723b7b59a1821ead54fe4c22ad499cc", "srcset": "https://si.imgix.net/0ced7734/uploads/origins/d38191b0-886e-442e-8729-04066d3c58c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6723b7b59a1821ead54fe4c22ad499cc, https://si.imgix.net/0ced7734/uploads/origins/d38191b0-886e-442e-8729-04066d3c58c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=72d7ee39eb656cadfaa29af0ac469f2a 2x, https://si.imgix.net/0ced7734/uploads/origins/d38191b0-886e-442e-8729-04066d3c58c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a18a78473f54e2d0cdb125b728a4d5f9 3x"}, "body": "Nice to meet you, Mr. Vanrizo.\nMy name is Renen and I'm a freelance filmmaker.\n\nWhen I was looking for someone who was looking for illustration requests on Twitter, I found Mr. Vanrizo.\nWhen I saw his works, I thought he was a wonderful illustrator who I like very much.\nI'd love to work with you! So I've made a request!\n\nI'd like you to draw an icon for me to use on Twitter.\n\nI have an original character of my own.\nI'd like you to draw an icon for me to use on Twitter.\n\nI'll put a sample on DropBox.\nhttps://www.dropbox.com/sh/dom79l7q48628nt/AABHTFp4qs2jR9kfhUVzFtbZa?dl=0\n\nI really like the \"How to Start a Demon King\" drawing of Eunice, so I'd like to request a drawing in that style!\n\nThe original character's hair color was originally pink, but I'd like to change the hair color to blue or light blue.\nYou can change the color of the eyes as you like!\n\nThe theme will be beautiful, fragile, and cool!\nThe theme is beautiful, fragile, and cool, but it's a rough one, so you don't have to put too much thought into it!\nThe theme itself is a rough one, so you don't have to put too much emphasis on it! I'm sure you'll love it.\n\nI'd like to leave other things like composition and clothing to you!\n\nI know this is a difficult request, but please consider it...!", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@banilizo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1028467, "client_id": 314197, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8bbaca6b/requests/253885_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e4cb5829e232ea2eaa3bd049ecdea80", "srcset": "https://si.imgix.net/8bbaca6b/requests/253885_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e4cb5829e232ea2eaa3bd049ecdea80, https://si.imgix.net/8bbaca6b/requests/253885_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ca79dbf1896c4c7f5351b158f5d15bc 2x, https://si.imgix.net/8bbaca6b/requests/253885_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54bf3e3ab74413b3e83d285154e100f1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8bbaca6b/requests/253885_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2c9c23d3c322ec1782d4ab66179c6a3", "srcset": "https://si.imgix.net/8bbaca6b/requests/253885_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2c9c23d3c322ec1782d4ab66179c6a3, https://si.imgix.net/8bbaca6b/requests/253885_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a750edd75809956db5baf34c53596f61 2x, https://si.imgix.net/8bbaca6b/requests/253885_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b96e0ec91ae0366496a8bfb69fd2095b 3x"}, "body": "Nice to meet you.\n\nI saw your picture on Twitter, and I wanted you to draw it for me.\n\nI want you to draw the following.\nSatomi Anzai from Venus Eleven (see the material)\nFantasy costumes like Granblue Fantasy or Tactics Ooga. (avant-garde or mid-range)\n\nI will leave the composition and other details to you.\n\nIf you like, please let me know.\n\nhttps://wikiwiki.jp/venus11/%E5%AE%89%E8%A5%BF%E3%81%95%E3%81%A8%E3%81%BF", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@banilizo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1028467, "client_id": 1462, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f13a5cc8/requests/253613_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b0d57f9d904c8f89c25a66b9e7575e1", "srcset": "https://si.imgix.net/f13a5cc8/requests/253613_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b0d57f9d904c8f89c25a66b9e7575e1, https://si.imgix.net/f13a5cc8/requests/253613_1?bg=%23fff&auto=format%2Ccompre