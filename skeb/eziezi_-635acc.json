23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d69f2ebe4a14a60bc188c0a3e790225a, https://si.imgix.net/4dd9bcd9/uploads/origins/61d4a476-9014-4654-8679-8a97a0279340?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e56025d72f0c545352e61be4f909b892 2x, https://si.imgix.net/4dd9bcd9/uploads/origins/61d4a476-9014-4654-8679-8a97a0279340?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a71c686f1aaf1c97bf35b7f9b42060f7 3x"}, "body": "こんにちは、あなたの作風がとても気に入っています。私のオリジナルキャラクター（OC）の参考シートを作成していただけませんか？紫色のクマで、表情を表示する画面付きの顔を持っています。白いフーディーに黒いダウンジャケットを着せ、ヘッドホンもつけてほしいです。\n\n正面と背面のポーズ、そして様々な感情や表情を表現していただけると嬉しいです。デフォルトの表情は笑顔でお願いします。ご検討いただきありがとうございます。もし価格が合わない場合は、お気軽にご連絡ください。https://imgur.com/a/gkyFdFt", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eziezi_/works/153", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1813966, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23bd5df2/uploads/origins/0f671f1e-4c30-4d6f-bf01-89061158f5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1012d34f1ce7dd8b234c26c94eb9074", "srcset": "https://si.imgix.net/23bd5df2/uploads/origins/0f671f1e-4c30-4d6f-bf01-89061158f5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1012d34f1ce7dd8b234c26c94eb9074, https://si.imgix.net/23bd5df2/uploads/origins/0f671f1e-4c30-4d6f-bf01-89061158f5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62d5e361f46f481978237f03c4234f32 2x, https://si.imgix.net/23bd5df2/uploads/origins/0f671f1e-4c30-4d6f-bf01-89061158f5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f0df2471b1a4037d218ce1500768fd9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23bd5df2