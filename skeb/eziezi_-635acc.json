&s=3406086a807fdd7d347ab24d0dfa86e0, https://si.imgix.net/6360498c/uploads/origins/de985669-08d5-4d6b-9dcc-e5e3ec2bc514?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9628982b84699e8d187ad562021c30f 2x, https://si.imgix.net/6360498c/uploads/origins/de985669-08d5-4d6b-9dcc-e5e3ec2bc514?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07ed9f16274cd312259767a810a02a53 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6360498c/uploads/origins/de985669-08d5-4d6b-9dcc-e5e3ec2bc514?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c0841292b823c226bcf1bb997c300af", "srcset": "https://si.imgix.net/6360498c/uploads/origins/de985669-08d5-4d6b-9dcc-e5e3ec2bc514?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c0841292b823c226bcf1bb997c300af, https://si.imgix.net/6360498c/uploads/origins/de985669-08d5-4d6b-9dcc-e5e3ec2bc514?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3ed1c3b9daab5d79817ae54092fc2996 2x, https://si.imgix.net/6360498c/uploads/origins/de985669-08d5-4d6b-9dcc-e5e3ec2bc514?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e646ed2dddf140e00ff4b658fd8ce711 3x"}, "body": "はじめまして！\n\n可能であれば私のOCを動物化した絵を描いていただきたいです。\n\n見た目は資料内にございます。どの動物かは自由に決めていただいて大丈夫です！\n\nよろしくお願いします！\n\n一応、キャラクターの設定を以下に書きます。必要なければ流し読みで構いません。\n\n「紫藤柚稀（しどうゆずき）」\n明るくて歯に衣着せぬ物言いのロックな女性。音楽への情熱を持っている。ただし、心の内にはクールな面もあり、相手と自分の線引きが上手い。感情を顔に出しがちで、笑顔がよく似合う。楽しいことは全力で楽しむ。仲いい人のことは笑わせたい人。いい意味でカッコつけなところが魅力。\nイメージカラー：紫×黒　目の色：紫　髪型：紫のメッシュ入りの黒髪を一つに束ねている、ガーベラの飾りがついたヘアゴムは恋人の女性からもらった　いつもバンドのTシャツを着ている\n25歳、162㎝、低めの声、カッコいい系、楽器屋の店員（下北沢の小さな個人店）。(特にギターとベースに詳しく、中高では軽音部に所属していた。本当はバンドマンになりたかったが、夢は諦め今の職に就きながら大学時代のサークル仲間と趣味としてバンド活動を続けている。「もっと夢見てよかったのかもな」と時々思っている。ファンがいて特に女性からモテる。)\n\nhttps://drive.google.com/drive/folders/1a0bcCKXacmvMTclQ_Ikh897Ih2Fr9x5x?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eziezi_/works/148", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1813966, "client_id": 2351186, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dbc85b18/uploads/origins/c6973da1-0982-4d25-be8c-9f9f720d3909?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ff4d1babeef496659f818cfa97467d7", "srcset": "https://si.imgix.net/dbc85b18/uploads/origins/c6973da1-0982-4d25-be8c-9f9f720d3909?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ff4d1babeef496659f818cfa97467d7, https://si.imgix.net/dbc85b18/uploads/origins/c6973da1-0982-4d25-be8c-9f9f720d3909?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed02be2fc283bf3cf89033840401dfad 2x, https://si.imgix.net/dbc85b18/uploads/origins/c6973da1-0982-4d25-be8c-9f9f720d3909?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80500d69918319c8cc04c3ba27988cd6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dbc85b18/uploads/origins/c6973da1-0982-4d25-be8c-9f9f720d3909?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cfa7ba407775fd52c4f497178001292", "srcset": "https://si.imgix.net/dbc85b18/uploads/origins/c6973da1-0982-4d25-be8c-9f9f720d3909?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cfa7ba407775fd52c4f497178001292, https://si.imgix.net/dbc85b18/uploads/origins/c6973da1-0982-4d25-be8c-9f9f720d3909?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bced73893f9f898245483895e970eb50 2x, https://si.imgix.net/dbc85b18/uploads/origins/c6973da1-0982-4d25-be8c-9f9f720d3909?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d2e8288