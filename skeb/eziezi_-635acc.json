のほどよろしくお願いいたします💐\n\nhttps://drive.google.com/drive/folders/15fjtaopphFO36yX8cJs8sK0qAYvGSYxe?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eziezi_/works/173", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1813966, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d812082d/uploads/origins/113825fd-b7c4-4e1a-8b3f-7360e49fea59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9658c69560fcde98ccedc4bdd6cf41a4", "srcset": "https://si.imgix.net/d812082d/uploads/origins/113825fd-b7c4-4e1a-8b3f-7360e49fea59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9658c69560fcde98ccedc4bdd6cf41a4, https://si.imgix.net/d812082d/uploads/origins/113825fd-b7c4-4e1a-8b3f-7360e49fea59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b28d02dd84e4e24db871a788346ecf6 2x, https://si.imgix.net/d812082d/uploads/origins/113825fd-b7c4-4e1a-8b3f-7360e49fea59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6de005c99966f012470f1076d0882856 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d812082d/uploads/origins/113825fd-b7c4-4e1a-8b3f-7360e49fea59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=551a71358784702a12f057e7b024f5bc", "srcset": "https://si.imgix.net/d812082d/uploads/origins/113825fd-b7c4-4e1a-8b3f-7360e49fea59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=551a71358784702a12f057e7b024f5bc, https://si.imgix.net/d812082d/uploads/origins/113825fd-b7c4-4e1a-8b3f-7360e49fea59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=24236652fa4e0b65fc9830432468ff34 2x, https://si.imgix.net/d812082d/uploads/origins/113825fd-b7c4-4e1a-8b3f-7360e49fea59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=429941656126a3c62cbf6d854fd85a80 3x"}, "body": "ｴﾁﾞ様\nSkebの再開ありがとうございます！\nころんとした愛らしいフォルムや表情が大好きです！\nもし良ければ是非私と友人のOCをお願いしたく、リクエスト失礼いたします。\n\n──────\n❏リクエスト\nシチュエーションなどすべてお任せいたします。\n服装・髪型・小物など、お好きに仕立て・アレンジして頂いて大丈夫です◎\nhttps://drive.google.com/drive/folders/1LqbJEyGoMQ7_J_m7UYQtsXwyO1ctkt5r?usp=drive_link\n\n\n❏キャラクター\n①黒+ピンク髪：結夢（ゆめ）\n　27歳／152cm／女性／一人称：あたし\n・クソガキ / 生意気\n・実年齢より若く見られるせいで度々職質に捕まる\n・満をこき使うことに躊躇いも遠慮もない\n「あたしがここの店長！あたしが絶対よ！」「満～疲れたあ。抱っこして！」\n\n②白+ピンク髪：満（みちる）\n　31歳／183cm／男性／一人称：俺\n・第一印象は粗暴な輩 / タフ\n・胃も丈夫なせいか悪食 / 昆虫食も平気\n・結夢のことをガキだと思って雑に扱う、ノンデリ気味\n「はあ？ガキじゃねぇか」「アンタのこと、ちったぁ羨ましいよ」\n\n❏関係性：店主と用心棒 兼 恋人\n特殊な店を開く結夢の元に満が訪れたことが出会い。\n最初こそペット（用心棒）として呼びつけていたが、幸せになりたいという満に愛情で答えた結夢と交際を始めた。\n\n❏ケモ化\n①ハムスター（ジャンガリアン）\n②オオカミ\n──────\n\n沢山のリクエストがある中で恐れ入りますが、ご検討いただけますと幸いです！\n金額に不足がありましたらご遠慮なく再送要請して頂ければと思います。\n\nhttps://drive.google.com/drive/folders/1LqbJEyGoMQ7_J_m7UYQtsXwyO1ctkt5r?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eziezi_/works/172", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1813966, "client_id": 2932034, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ddfefb4b/uploads/origins/657d3abd-b526-4f5e-8a2b-1f147909f124?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5945a464aee811749612c89853991f77", "srcset": "https://si.imgix.net/ddfefb4b/uploads/origins/657d3abd-b526-4f5e-8a2b-1f147909f124?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5945a464aee811749612c89853991f77, https://si.imgix.net/ddfefb4b/uploads/origins/657d3abd-b526-4f5e-8a2b-1f147909f124?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45fda06858e5b96180b90e271b8b24f5 2x, https://si.imgix.net/ddfefb4b/uploads/origins/657d3abd-b526-4f5e-8a2b-1f147909f124?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=cr