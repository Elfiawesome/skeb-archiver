ins/7020e703-e33b-40fb-8b0d-8f7f62f7b6c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5fd5b439d0abe36325e0a569ccaef967 3x"}, "body": "mutaさんはじめまして。るげつぺぽと申します。\nXにしてとっても素敵で可愛い男の子のイラストを拝見しまして、お願いしたいと思いました。\nお時間あるようでしたら、是非お願いしたいです！\n\n趣味の配信で使用している代理キャラクター(顔色ちゃん)をお願いしたいです。\n15歳の男の子、身長155～160、顔は若干中性よりです。\n髪の毛は白と青色のツートンで、普段は眠そうにしてて抜けてますが、やるときはやる子です。\n全体図参考\nhttps://twitter.com/rugetsupepo/status/1690939483074826240\n表情変化分参考\nhttps://twitter.com/rugetsupepo/status/1664293689412435968\n新衣装\nhttps://x.com/rugetsupepo/status/1906691283889901583\n\n服装や構図などはおまかせします。キャラクターの衣装を乗せておりますが、見えない部分の補完などは好きにしてくださっても大丈夫ですし、全く違う衣装を着せていただいても大丈夫です。\nほっぺたや顔の輪郭に柔らかさがあると嬉しいです。\nかっこよさと可愛さが共存しているように描いていただけるととっても喜びます。\n顎を90度以上の鈍角で描いて欲しいです。柔らかさを感じられて好きなので…難しそうだったり、描きたい方向と違えばそうじゃなくても大丈夫です。\n\n太極図のアクセサリはキャラクターのモチーフでもあるので、必ず入れて欲しいです。\nSNSのアイコンやヘッダ、YouTubeなどで使用する可能性があります。(収益用途では使いません)\nキャラクターは下部以外は見切れないようにしてほしいです。\nお手数おかけしますが文字などある場合はキャラ単体のものもほしいです。\n形式はpsdまたはpngでお願いします。\n\n金額面やお時間の都合で無理そうであればキャンセルしてください。\n以上の内容でお受けできそうであれば、是非お願いします！！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@82y_46p/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4020360, "client_id": 2905944, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e2383734/uploads/origins/fde300cd-ff43-440d-b07a-ba56791cde91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dd52d9eb14c178017b55a32b67952b3", "srcset": "https://si.imgix.net/e2383734/uploads/origins/fde300cd-ff43-440d-b07a-ba56791cde91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dd52d9eb14c178017b55a32b67952b3, https://si.imgix.net/e2383734/uploads/origins/fde300cd-ff43-440d-b07a-ba56791cde91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bb361188145dddd621fc0e7321b8f4a 2x, https://si.imgix.net/e2383734/uploads/origins/fde300cd-ff43-440d-b07a-ba56791cde91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0bb99ec33e084e191d8ba88820651d6c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2383734/uploads/origins/fde300cd-ff43-440d-b07a-ba56791cde91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9f517bbfb743ea2b3dd23f14f0cc4d2", "srcset": "https://si.imgix.net/e2383734/uploads/origins/fde300cd-ff43-440d-b07a-ba56791cde91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9f517bbfb743ea2b3dd23f14f0cc4d2, https://si.imgix.net/e2383734/uploads/origins/fde300cd-ff43-440d-b07a-ba56791cde91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa79ef283561c433bbc553dc2874b675 2x, https://si.imgix.net/e2383734/uploads/origins/fde300cd-ff43-440d-b07a-ba56791cde91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=33039a536ae5e27b761a4a19029f2d64 3x"}, "body": "はじめまして！\n以前からmuta様のイラストを追わせていただいてました！\n空気感やその時の感情が直に伝わってくるような表情作りにとても惹かれていて、それに加えてとても可愛らしいお顔を描かれるので、一目見たときから、ぜひうちの子たちを描いていただきたいと思っておりました！\n描いていただきたい子たちの詳細は以下のとおりです！\n\n━━━━━━━━━━━━━━━━━\n\n愛斗（まなと）\n22歳／179cm／モデル\nマイペースで穏やかな性格の持ち主。\n表情豊かで愛嬌があり、自然と弟キャラとして周囲に受け入れられる存在。\nその一方で観察力が高く、人の小さな変化にもよく気づく。どこか年上のような包容力も併せ持つ。\n\nモデルとして活動しており、仕事にも真摯に向き合っている。\n好きなものは飴と洋楽で、気分転換によく音楽を聴いている。\n仕事場ではどんなに仲が良くても必ず敬語を使うが、プライベートでは基本的にタメ口。\n\n琥珀（こはく）\n23歳／166cm／大学生　\n人当たりが良く、真面目で努力家な性格。\n人付き合いも上手いが、一定の距離感を保つ癖があり、他人をあまり深く踏み込ませないところがある。\n周囲を優先してしまう性格で、自分のことにはどこか不器用。つい頑張りすぎてしまうことも多く、一人で抱え込みがちで自己肯定感はやや低め。\n\nスタイリストになることを目指し、現在はファッションを勉強中。\n好きなものは手芸とネット配信で、空いた時間によく楽しんでいる。\n普段は人との距離を保ちがちだが、お酒が入ると甘え上戸になる。\n\n＊関係性\n高校までずっと一緒に過ごしてきた幼馴染。\nどちらも活発に外で遊ぶタイプではなく、特別な約束がなくても気づけば自然と一緒にいることが多かった。\n\n愛斗は昔から変わらず距離感が近く、軽く肩に触れたり頭を撫でたりと、何気ないスキンシップが多い。\n本人に自覚はなく、昔と同じ調子で琥珀に接している。\n\n一方で琥珀は、思春期以降その距離感を強く意識するようになり、以前のようには受け止めきれずにいる。\n何気ない仕草や言葉にさえ、どこか落ち着かない感情を覚えてしまう。\n\n付き合った後\n愛斗からのスキンシップが圧倒的に多いが、ヤキモチを妬くのは琥珀。決して愛斗に怒ったりするのではなく、不安を感じてよそよそしい態度を取ってしまうこともしばしば。\n愛斗のスケジュールを気遣ってデートに誘うことは遠慮がちだが、琥珀のコーディネートした服を愛斗に来てもらうことは遠慮せず頼み、愛斗は着せ替え人形と化している。\n\n━━━━━━━━━━━━━━━━━\n\n今回、描いていただく構図などは可能であれば、お任せさせていただきたいです！\nもしお任せが難しかった場合の構図案をいくつか挙げさせていただきます！どれかお好みに合えば幸いです！\n\n・一緒に朝ごはんを食べる\n・愛斗くんに琥珀くんがお弁当を届ける\n・拗ねてる琥珀くんに愛斗くんがバックハグで謝る\n\n長々と描いてしまい申し訳ございません！\nご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1rpWqJ3rHSCnRg0_lY8B-5zuK8m1DD1RQ", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 993483, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "木犀", "screen_name": "mokusei0516", "avatar_url": "https://pbs.twimg.com/profile_images/1717418282679242752/kNfpaaa7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1334448316436762624/1696083071/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 1303684, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "おぜう", "screen_name": "ozeu354", "avatar_url": "https://pbs.twimg.com/profile_images/1798924818257219584/ZEyh2Sgn.jpg", "header_url": "https://pbs.twimg.com/profile_banners/916625341459787776/1673366443/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 1585182, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "甘戸", "screen_name": "Amato_0321", "avatar_url": "https://www.gravatar.com/avata