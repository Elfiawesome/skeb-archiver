uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=083caae9a93aa649d15b8a82162cc239 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2039066622049329152%2FoGujEe8L.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5feb0f5fff47d7562b4e4bb0d5a3b921", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2039066622049329152%2FoGujEe8L.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5feb0f5fff47d7562b4e4bb0d5a3b921, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2039066622049329152%2FoGujEe8L.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9dffd1b2197211ac90abf96f50c1c5c0 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2039066622049329152%2FoGujEe8L.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d82cbedd760bcb5cbd47b6bbccea8bf2 3x"}, "body": "初のリクエストです。\nアークナイツに登場するプレイアブルキャラクター、オペレーターのルシーラの成人向け作品をお願いしたいです。\n\n●依頼作品\nルシーラ×ドクターの成人向け作品\n\n●傾向\n・女性上位\n・逆転無し\n\n●内容\n以前にルシーラとの晩酌に付き合った際、酔って抵抗力を失ったところをルシーラに優しく捕らえられ身に余る快楽によって\"ダメ\"にされ、その後も秘書に当たられる度その身体に彼女からの快楽を覚えさせられるドクター。以後秘書当番にルシーラが任命された際に何度も席を開けたりして露骨に彼女を避けていたが、それが逆に彼女に火を付けてしまう。\n\n職務終了後にルシーラに私室に尋ねられ、ドクターという立場上強く断ることができず私室に入ることを許可してしまう。あくまでもいつもの調子だがドクターに避けられほんの少しだけ不満に思っていた彼女に優しくベッドに押し倒される。\n\nそしてルシーラから以前と同じ、寸止めによる切ない快楽を何度も何度も注ぎ込まれ、凡そドクターらしくない情けない射精、絶頂の懇願をさせられてしまうのだが、今回はルシーラがドクターから避けられたことによる不満からドクターへ対するお仕置きを考えており、何度も寸止めしたドクターに対し更に亀頭責めを行い、射精を伴わない絶頂によって更に追い詰められてしまう。\n\n涙を流してしまう程に精神的に追い詰められたドクターの情けなさ極まる姿に満足したルシーラはそこでようやくドクターに射精を伴う絶頂をプレゼント。何度も寸止め、更には射精を伴わない絶頂により快楽を発散できなかったドクターは極上の射精に幸福感を感じてしまうが、今度は寸止めした分だけ搾り尽くすと言わんばかりの容赦ない射精直後の責めに晒され、打ち止めになるまで徹底的に搾精されてしまう。\n\n●必ず入れて欲しい内容\n・寸止め\n・亀頭責め\n・連続射精\n\n●できれば避けて欲しい内容\n・痛みを伴う責め（苦痛と見紛う程の強烈な快楽は問題なし）\n・アナルを用いるプレイ（ドクターのものもルシーラのものも避けて欲しいです）\n\n●登場人物の関係性\nドクター：ルシーラを少なからず好意的に思っているが、最近は避けている\nルシーラ：ドクターを非常に好意的に思っている\n\n寸止め、亀頭責め、射精に用いるプレイの内容はお任せします。手でも胸でも口でも足でも秘部でも\n\n以上です、どうかよろしくお願いいたします。", "nc": 41, "word_count": 17229, "transcoder": "text", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 426769, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "でくすたー@Skeb依頼募集中", "screen_name": "ryooonaaaa", "avatar_url": "https://pbs.twimg.com/profile_images/998934487563091972/pnkPAnz8.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 168}, {"id": 561972, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ミズウミ＠お仕事募集中", "screen_name": "mizuumi_sui", "avatar_url": "https://pbs.twimg.com/profile_images/1263812867318415360/y4yUBG1z.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 90, "skills": [{"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 49}, 