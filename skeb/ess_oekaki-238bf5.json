n■キャラクター\nうちの子の「花村 美月」\n身長146cmくらいの小柄で巨乳な子\n\n資料URL内の三面図を参考にウェディングドレス姿の美月を描いていただきたいです。\n胸元とお腹周りのスカート布は肌の色が分かるくらいの透け素材で、下着や谷間の下までバッチリ見えます。\n下着は資料の「下着参考」のようにクロッチ部分以外が透けているタイプの紐パンでお願いします。\n着用している首輪・手枷足枷についているのは南京錠になります。\n表情は恥じらい強めでお願いします。\nポーズ等はお任せしますが、透け生地を楽しみたいので胸とお腹周りは極力隠れないようにして頂きたいです。\n\n是非ご検討いただけましたら幸いです。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1NozPTUYJnr3hjAnryr19dKi4zSaUCEnu?usp=sharing", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ess_oekaki/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4136976, "client_id": 1527265, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7fe1b284/uploads/origins/1e916097-f040-436b-a088-e3f9744c0934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4d41957c29a675e1a45b3a326dd49dc", "srcset": "https://si.imgix.net/7fe1b284/uploads/origins/1e916097-f040-436b-a088-e3f9744c0934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4d41957c29a675e1a45b3a326dd49dc, https://si.imgix.net/7fe1b284/uploads/origins/1e916097-f040-436b-a088-e3f9744c0934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe3d2b83fadb6df889b3e3eb660aaf4c 2x, https://si.imgix.net/7fe1b284/uploads/origins/1e916097-f040-436b-a088-e3f9744c0934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0aae897942e89de9e9431482ad3cb46 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7fe1b284/uploads/origins/1e916097-f040-436b-a088-e3f9744c0934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce6ff6636cb0623ddc8889ea4c8f7127", "srcset": "https://si.imgix.net/7fe1b284/uploads/origins/1e916097-f040-436b-a088-e3f9744c0934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce6ff6636cb0623ddc888