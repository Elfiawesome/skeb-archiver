bs.twimg.com%2Fprofile_images%2F1857053535973539841%2FvReG5w5h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0805fde9f009a03bd6fc5f8ce984a86", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1857053535973539841%2FvReG5w5h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0805fde9f009a03bd6fc5f8ce984a86, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1857053535973539841%2FvReG5w5h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=decccb078380695c92f8e40533dc79b6 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1857053535973539841%2FvReG5w5h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=553213599c05e35c2e90f144207bc7ac 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/c1958b7d-02df-4ee3-b239-25f4d93c59eb?response-content-disposition=inline&Expires=1785565964&Signature=P4RnBRQuJ4tgMb9bjZmji6~T9bsHCvWro4cQQiQE4Q6CjAw0YNTIFsmVzdW-Zilpy57tYR2nTggDWuDdAv1ubO0~GAUwBaN5-kyklzaEAdVLhgmMIenqwt4mv8b2TI~Iw8INjG~7A7jSlxlIzTZUYGAmsVb4R7~HVsevejTyhehvhZfuRGl7V37ZQtP~duOpHwrlwvHBDd5RsPcgcN6P27nyZRMs~U5-eE-pYNG8NNk4754zmMG7Kg4yw5AK89vVUKKAwZXU4ijoDvMXciLDL09I~urRjffyC0F0HwnO4I~vHi0sBHt1hvhhUFHlyWW7OKU4qeqHtZAeoHEoTwrsbQ__&Key-Pair-Id=K1GS3H53SEO647", "duration": 37, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1857053535973539841%2FvReG5w5h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54af1d530939078a71a676b71a2539e1", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1857053535973539841%2FvReG5w5h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54af1d530939078a71a676b71a2539e1, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1857053535973539841%2FvReG5w5h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e4e4668e8204b86616b8985efe437cd7 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1857053535973539841%2FvReG5w5h.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4a6767023651638edd92c7a9dd30473e 3x"}, "body": "こがらしさんこんにちは！突然メッセージ失礼します。\nもしよろしけれもう一度ばボイスの依頼をさせていただきたくてメッセージを送ります！\n前にお願いしたことがとても好きで、もう一度依頼させていただきたいです！\n\nもし可能でしたら、以下の内容で依頼させていただきたいです！\n（私が外国人なので変なところがあればセリフを変えていただいてもいいですよ！ また、あまりにも多い内容なのでセリフから適当に選んで演じていただいて結構です！）\nお願いしたいセリフは、OC女性のキャラですが建造物をベースにして作ったキャラなので中性的なボーイッシュ声に近ければいいなと思っています！\n以下、キャラのセリフです！\n\n\n\n（誰も自分のことを理解できないと思い、独りで何日も何日もひどく落ち込んでいる夢主のところに誰かが近寄ってきて邪魔で鬱陶しいと思っている状況）\n(ため息をつく)あっち行け。\nはぁ?あんたに何がわかるの?私のこと笑ってるの?私のことバカにしてるの?\nそれとも私を欺くつもり？！（怒りながら）\nどうせあなたも私のこと理解できないでしょう！（大声で怒鳴る）\nだから・・・どっか消えて（虚しく弱々しい声）\n\nこれはあの人に言われた言葉のせいだから…\n私のことを永遠に付き纏う呪いなんだ…\n誰も…私のこと理解できない（つぶやく）\n\n（別の日。お寿司屋で偶然出会った二人）\nあ!私のスマホ! (取られたスマホを見ながら)\nいやいや、私のスマホなのに、何してるのあの人。（自分のスマホを取られ、訳が分からなくて呆然としている）\n一人で食べればいいじゃん。（イラッとしてぶつぶつ言う）\nもういいでしょ?私のスマホ返して\n\n（スマホを返してもらうためにお寿司屋－緑茶販売店－グッズショップ－アイスクリーム屋さん…以下略…に遊びに行き、目まぐるしい一日を過ごした後椿の宿で休みながら）\nお酒って初めて飲んでみたけど、悪くないね。（緊張が解ける 羽目を外す）\nなんかおいしいかも。不思議だね。(どんどんテンションが上がる)\n（ずっと気になっていたことを聞いてみる）ねぇ、前に私の悲しみを知っているって言ってたのは本当は冗談なんでしょ?!\n本当は誰も私のこと理解できないから(虚しく。アハハと笑いながら)\n\n\nそれって一体...どういう...(困惑)\n（椿なら本当に自分のことを理解してくれると確信）\n(尊い、崇拝に近い感情で)...椿さん...。\n椿さんさえ良ければ...私も...。\n私、椿さんの味方になります。この世界が椿さんの味方になりますよ。私が壊れるまで、それは続くよ。永遠に。（決心、決意）\n本当に...ありがとう。", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@kgrs_va/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": true, "creator_id": 2380559, "client_id": 2104612, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/26069bf5-e312-4850-8c71-c2da5b95873d?response-content-disposition=inline&Expires=1785565964&Signature=h5SuTz-Uw8vU3T