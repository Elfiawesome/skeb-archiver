。\nこの度はミニキャラのskebを募集されているとのことで、依頼させて頂きたく思います。\n\n 添付した衣装(アベル左カイン右)を着た下記の2人のキャラクターをお願いいたします。\n \n カイン\n181cm/男性\n飄々とした雰囲気で描いていただけたら嬉しいです。\n真面目なアベルに対してカインは少し服を着崩しています。\nアベル\n186cm/男性\n真面目で優しい雰囲気で描いていただけたら嬉しいです。\n飄々としたカインに対して、アベルは真面目に服を着ている生徒会長のような性格です。\n\n 双子で対になるような構図で描いていただけたら嬉しいです、ポーズ等の指定はありません。\n\nもし可能でしたら個人利用としてアクリルキーホルダーにさせて頂きたいと考えていますが、不可であればリクエストは断って頂いて構いません。\n\nまたもう1件依頼している中でのリクエストのため、気兼ねなく断って頂いて構いません。\n御検討頂けますと幸いです、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/mobile/folders/100_y7EOrLZOdxCBqL0ciReBaj3s7CgTZ?usp=sharing&sort=13&direction=a", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@okapomu2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3071923, "client_id": 3047410, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/439eda39/uploads/origins/fc7934be-d30d-46eb-add5-dc1fa051d52d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea9684a88503d62ca6802b5b2ac4366e", "srcset": "https://si.imgix.net/439eda39/uploads/origins/fc7934be-d30d-46eb-add5-dc1fa051d52d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea9684a88503d62ca6802b5b2ac4366e, https://si.imgix.net/439eda39/uploads/origins/fc7934be-d30d-46eb-add5-dc1fa051d52d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a31db8f6a6e9a7c0dad5af9f7fa72770 2x, https://si.imgix.net/439eda39/uploads/origins/fc7934be-d30d-46eb-add5-dc1fa051d52d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b5ec0124e4b5e7a1fc342b705c598d4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/439eda39/uploads/origins/fc7934be-d30d-46eb-add5-dc1fa051d52d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4507c007805de6dd5fa9e60dfb0a2f9a", "srcset": "https://si.imgix.net/439eda39/uploads/or