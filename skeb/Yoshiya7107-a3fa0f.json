d&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4534c51496d73904f935b938f19a3df7 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3393752, "nc": 32}, {"path": "/@Yoshiya7107/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3393752, "client_id": 320766, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/39891c3e/uploads/origins/452c6d3b-338a-4817-8c7a-a3ac71d721b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b05ddb299f5a6d96b043845b5d17f977", "srcset": "https://si.imgix.net/39891c3e/uploads/origins/452c6d3b-338a-4817-8c7a-a3ac71d721b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b05ddb299f5a6d96b043845b5d17f977, https://si.imgix.net/39891c3e/uploads/origins/452c6d3b-338a-4817-8c7a-a3ac71d721b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=618a4f64587731dfa5cd3807c20f7371 2x, https://si.imgix.net/39891c3e/uploads/origins/452c6d3b-338a-4817-8c7a-a3ac71d721b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c0f74d55876f5aa154884887717b4de 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/39891c3e/uploads/origins/452c6d3b-338a-4817-8c7a-a3ac71d721b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f1d7837a5b5203ba85ea07f59da2d90", "srcset": "https://si.imgix.net/39891c3e/uploads/origins/452c6d3b-338a-4817-8c7a-a3ac71d721b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f1d7837a5b5203ba85ea07f59da2d90, https://si.imgix.net/39891c3e/uploads/origins/452c6d3b-338a-4817-8c7a-a3ac71d721b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9459d945434e8592f5a7bc910a45b5d0 2x, https://si.imgix.net/39891c3e/uploads/origins/452c6d3b-338a-4817-8c7a-a3ac71d721b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c4c981970b045e17afcabc4c15ae2178 3x"}, "body": "お疲れ様です、リクエスト失礼します。\n\n●お願いしたいキャラクター\nうちの子の呑んだくれ未亡人エルフ「ノーミ・スギ」\nhttps://drive.google.com/drive/folders/1pioGDxz79UdAHEHRHitqqnSSpZ5hW_Vx\n\n身長は130cm~14ocm台、B-大 W-並 H-大\n緩い喋り方や雰囲気の軽口が好きなお茶目さんで、お酒と旦那と娘が大好きな未亡人エルフさんです。旦那が生きている頃から現在まで冒険や人からの依頼をこなして過ごしており、中々の実力者です。\n口調は～だねぇ、～かなぁ、へぇ～、等ゆるい様な喋り方（ブルーアーカイブのホシノや、ちびまる子ちゃんのまる子の様な喋り方が近いです）。\n\n●お願いしたい内容\nうちの子（以下ノーミ）が悪い男達（もしくは男）によって酒に混ぜ物をされ、朦朧としている所を犯される。\nといった内容\n\n●具体的に入れて欲しい内容\n・酒場にて、悪い男達（１人でも可）に混ぜ物をされた酒を呑まされ、朦朧としているノーミ。男達によって胸等を触られている。\n可能であればノーミのパンツが見えている描写があるとありがたいです。\n\n・男達に酒場裏の路地裏に連れていかれ、レイプされるノーミ。\n体位はノーミの背が低いので、脚がピンとなっているか、宙に浮いてる状態の立ちバックだと嬉しいです。\n可能であれば長時間ヤられている、もしくは複数人にヤられている感を出す為に２つ以上の体位で犯されていると大変ありがたいです。\n\n・路地裏に置かれている樽に頭から上半身を突っ込んでいる様な状態でヤり捨てされているノーミ。\n長時間散々犯された感を出す為に精液や使用済みゴムを辺りに散らしたり、ノーミの身体に落書きをされていたり、秘所から精液を溢れていたりするとありがたいです。\n\n\n以上です。\nどうか御一考お願い致します。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yoshiya7107/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3393752, "client_id": 3323736, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65b8c50b/uploads/origins/71546e85-53fa-4819-bcad-afbd5c3dbcb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=934751af93e9f4733626669773176531", "srcset": "https://si.imgix.net/65b8c50b/uploads/origins/71546e85-53fa-4819-bcad-afbd5c3dbcb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=934751af93e9f4733626669773176531, https://si.imgix.net/65b8c50b/uploads/origins/71546e85-53fa-4819-bcad-afbd5c3dbcb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15746f269ca47dd38aea6c7b959b4dc3 2x, https://si.imgix.net/65b8c50b/uploads/origins/71546e85-53fa-4819-bcad-afbd5c3dbcb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&cro