発情期でエッチな気分の二人とお兄さんが危険日エッチするシチュで\n寝室の布団(ベッド)に仰向けで並ぶ二人と正常位で順番に致します。\n\n服は胸と結合部が見えれば全裸でも半脱ぎでもＯＫで\n見える場合は尻尾の描写もお願いします。\n\n擬音や喘ぎ声、孕ませを意識した台詞ありで\n以下のような差分形式(※)をお願いします。\n※金額に見合わない場合は②⑤は省略可\n\n①挿入前\n→どちらからする？と聞く二人。順番はまろんさんに託します。\n②１人目に挿入\n③１人目とエッチ中(射精間近)\n④１人目に中出し\n⑤２人目に挿入\n⑥２人目とエッチ中(射精間近)\n⑦２人目に中出し\n⑧事後\n→二人を孕ませたお兄さんは責任取る模様\n\n以上、ご検討ください。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sibamaron2023/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2751511, "client_id": 37914, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2b7bd7a/uploads/origins/60c8d127-71e2-42c4-88c7-6129bf74e521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=992f48171a0f2eb44f961635e62e7314", "srcset": "https://si.imgix.net/b2b7bd7a/uploads/origins/60c8d127-71e2-42c4-88c7-6129bf74e521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=992f48171a0f2eb44f961635e62e7314, https://si.imgix.net/b2b7bd7a/uploads/origins/60c8d127-71e2-42c4-88c7-6129bf74e521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a82726c05382024441b5b0ef7544f3b 2x, https://si.imgix.net/b2b7bd7a/uploads/origins/60c8d127-71e2-42c4-88c7-6129bf74e521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d137428c74c11f209ad2d684878e819a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2b7bd7a/uploads/origins/60c8d127-71e2-42c4-88c7-6129bf74e521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68246c2ab62df31c6820d0ba856bb40a", "srcset": "https://si.imgix.net/b2b7bd7a/uploads/origins/60c8d127-71e2-42c4-88c7-6129bf74e521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68246c2ab62df31c6820d0ba856bb40a, https://si.imgix.net/b2b7bd7a/uploads/origins/60c8d127-71e2-42