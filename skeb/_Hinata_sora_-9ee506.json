ff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=198c56fd4f21582f307faceea9cd5eab 3x"}, "body": "初めまして!! いつも可愛いイラストありがたく見ています!!\nひなた そら様の弾むようなかわいい絵のスタイルにかなりの好感を持つようになり、今回リクエストすることになりました。\n個人的な欲望もあり、プロセカのこはねと杏の二人が一緒にポーズする絵をひなた そら様のスタイルでお願いしてもよろしいでしょうか? 細かい内容については以下に記してありますので、くれぐれもスケジュールに余裕がある時にご検討をお願いします!!\n\n- 「小豆沢こはね」と「白石杏」の2人が一緒にカップルポーズする状況がほしいです\n- そして衣装についてですが、両方ともモアジャン(MoreMoreJump)のオリジナルステージ衣装を着てほしいです\n- わきが見えるほどのポーズをお願いしたいです\n- 残りの表情や細かい部分はご自由にお願いします\n\n衣装に関する参考資料も一緒にリンクしておきます\nhttps://twitter.com/prsk_celery/status/1509908446786699270\nhttps://www.pixiv.net/artworks/95667183", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_Hinata_sora_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2736641, "client_id": 2830871, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28e2e7b4/uploads/origins/097d9533-5acc-41bc-8c21-40ef090c16f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=879018c98fed51af35262219122c50b0", "srcset": "https://si.imgix.net/28e2e7b4/uploads/origins/097d9533-5acc-41bc-8c21-40ef090c16f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=879018c98fed51af35262219122c50b0, https://si.imgix.net/28e2e7b4/uploads/origins/097d9533-5acc-41bc-8c21-40ef090c16f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=235ccf8bd2dec2246bb0e21034fc65c7 2x, https://si.imgix.net/28e2e7b4/uploads/origins/097d9533-5acc-41bc-8c21-40ef090c16f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f99c55efc2ba56b31a4b01bfc6e54ba0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28e2e7b4/uploads/origins/097d9533-5acc-41bc-8c21-40ef090c16f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4f7c33dee1458a