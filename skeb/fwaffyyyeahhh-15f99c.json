ec5-8b1d-74308dd6ef7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d6c954dcefd8c272f06ef35ab5ee613 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b635a2ef/uploads/origins/253c2155-1828-4ec5-8b1d-74308dd6ef7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=271c89b51792ef85a39d9504db8d05bb", "srcset": "https://si.imgix.net/b635a2ef/uploads/origins/253c2155-1828-4ec5-8b1d-74308dd6ef7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=271c89b51792ef85a39d9504db8d05bb, https://si.imgix.net/b635a2ef/uploads/origins/253c2155-1828-4ec5-8b1d-74308dd6ef7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=51709e6d927d9f9321c307c142e84358 2x, https://si.imgix.net/b635a2ef/uploads/origins/253c2155-1828-4ec5-8b1d-74308dd6ef7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9c3c22d15f134c1f03ba971441f7b28e 3x"}, "body": "ふわっふぃ様こんにちは。\n描いていただきたいキャラクターがいるので\nご縁があればよろしくお願いします！\n\n⬇️以下リクエスト内容\n\n【キャラクター】\n名前:羽場無住\n設定:不思議な雰囲気をまとう少年。\n人間観察が趣味で人間が築いた文化に対しての知見が広い。\n独特な言い回しをしばしば発し、場を翻弄させている。\n基本はふわふわしていてどこか年老いたイメージを彷彿とさせるが、初対面の人の秘密や生い立ちをスラスラ話すなど奇妙な言動も多い。\n正体は怪異と呼ばれる人外で名前を【荒吐(あらはばき)】という。\n\nモチーフ:土偶(よく見る人型のもの)・荒吐という実際に存在する空想上の存在をモデルにしている創作キャラクターとなります。\n少年なので元々の背はあまり高くなく、ブーツに高いヒールが着いており、身長を伸ばしているという感じです。\n性別は無し。男に近しいですが、基本的には喉仏がなく、手もあまり骨ばってはいません。(一応)\n\n【要望】\n・普段は目閉じですが、今回は開眼のビジュアルだと嬉しいです。\n・シチュエーション:リミナルスペースに居るようは不気味で不思議なイラストだと嬉しいです\n背景込みが難しい場合はお好きなイメージで描いていただいて大丈夫です。\n\n【使用用途】\n個人観賞用をメインにする予定ですが、SNSアイコン等不特定多数の目に触れるところに使用させていただく可能性があります。\n(その場合はお名前を明記させていただきます。)\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/123WtMwG7uccmrbhIN_RDImkBCmnRvx_h", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@SbrrGalaxy_ha/works/56", "private_thumbnail_image_urls": null, "priva