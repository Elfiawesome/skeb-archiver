t/5fbcd1f4/uploads/origins/ad0542d5-e930-4708-8f51-ea72b96eb1a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80eabb7fbd0864ee0f61bd1fdabd3722, https://si.imgix.net/5fbcd1f4/uploads/origins/ad0542d5-e930-4708-8f51-ea72b96eb1a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a7f1b27cfe5e84c4226f3c0fbf2561f 2x, https://si.imgix.net/5fbcd1f4/uploads/origins/ad0542d5-e930-4708-8f51-ea72b96eb1a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8be10d230ddd89384e79dce68a956076 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5fbcd1f4/uploads/origins/ad0542d5-e930-4708-8f51-ea72b96eb1a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc5849797dce344b43e4b144617831cd", "srcset": "https://si.imgix.net/5fbcd1f4/uploads/origins/ad0542d5-e930-4708-8f51-ea72b96eb1a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc5849797dce344b43e4b144617831cd, https://si.imgix.net/5fbcd1f4/uploads/origins/ad0542d5-e930-4708-8f51-ea72b96eb1a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c74216b906744395ad93ebbdfe0c3c8c 2x, https://si.imgix.net/5fbcd1f4/uploads/origins/ad0542d5-e930-4708-8f51-ea72b96eb1a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d16e776f788479d9d316865a060db48a 3x"}, "body": "こんにちは。\nいつも🚬✖️のイラストを拝見させていただいています。\n\n是非友人のOCを描いていただきたいと思い依頼をさせて頂きました。(友人には許可を得ています。)\nご多用の中ではありますが、承認してくだされば幸いです。\n\n【使用用途】\n○イラストの閲覧\n○他の方への共有\n\n【イメージ・希望】\n○若干人外のような悪人のような表情にしていただけと幸いです。\n○構図等の希望は無し\n\n■OCの簡易説明(イラストに反映させなくて構いません)\n名前：David Norbelt(デヴィッド・ノルベルト)\n性別：男　年齢：30　身長：181cm\n出身：イギリス　誕生日：5月8日　職業：教授\n\n宇宙科学を専門としている。\nウェールズ出身であり、若干の訛りがあるため関西弁イメージで喋る。胡散臭く杖をついているが別に足が悪いわけではない。人は見た目で判断するやろ？あとは休日に息抜きも兼ねてアウトドア（BBQとかフィールドワークとか？）もする。\n\n自分の人生含むすべてを舞台ごとのように捉えている。そのためどこかしら薄っぺらく胡散臭く見えるのだ。\n稀代の天才で全てを探求しないと気が済まない。\n\nhttps://drive.google.com/drive/folders/1kBY5oIfwk698SFXcXmjx07E9FtnbCA5A", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TENNBINN/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3456692, "client_id": 2223302, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf386711/uploads/origins/491e7656-706b-4327-a2fb-015e6bd501c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30571f0fb3ac27b42a7409e41fa22bb1", "srcset": "https://si.imgix.net/cf386711/uploads/origins/491e7656-706b-4327-a2fb-015e6bd501c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30571f0fb3ac27b42a7409e41fa22bb1, https://si.imgix.net/cf386711/uploads/origins/491e7656-706b-4327-a2fb-015e6bd501c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9085d01a4bb1858ad6e1bc053010602e 2x, https://si.imgix.net/cf386711/uploads/origins/491e7656-706b-4327-a2fb-015e6bd501c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04981c644c07a1c95d05f5554fbe0bc8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf386711/uploads/origins/491e7656-706b-4327-a2fb-015e6bd501c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2492e2a53a68a46079bbd02ba545a11", "srcset": "https://si.imgix.net/cf386711/uploads/origins/491e7656-706b-4327-a2fb-015e6bd501c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2492e2a53a68a46079bbd02ba545a11, https://si.imgix.net/cf386711/uploads/origins/491e7656-706b-4327-a2fb-015e6bd501c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=490986628d68398bd22e5a183df2a884 2x, https://si.imgix.net/cf386711/uploads/origins/491e7656-706b-4327-a2fb-015e6bd501c0?bg=%23fff&aut