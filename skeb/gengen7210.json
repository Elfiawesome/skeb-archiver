vate_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 635434, "client_id": 3173203, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2be2eede/uploads/origins/1b2b7d8e-d53e-4b2a-9f42-332f11d73518?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=119133ccd96961a0bc92b4c11adbc7ba", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2be2eede/uploads/origins/1b2b7d8e-d53e-4b2a-9f42-332f11d73518?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c92c30f29376a27e01e6e5e31869a82", "src_set": ""}, "body": "こんにちは！私は巨大なモンスターを主人公にした物語を執筆中です。この依頼にあなたの才能を貸してください。\n\nこの怪獣の名前は「ホノムール」。クジャクとワシとコウモリをミックスしたような巨大怪獣です。翼、尻尾、耳を閉じると巨大な羽のように見え、鳥に似ている。しかし、翼、尾、耳を開くと、膜でつながれ、コウモリの薄い皮膚に似ている。開いた翼は背中に羽毛が生えているが、内側には皮のような膜があり、開くと威圧的に見える。ホノムールは雪山に住んでいるので、羽毛は雪色になっている。 (羽毛が芸者の着物のような模様を作ることをイメージしているが、決まった模様はない)。ウルトラマンの怪獣のような大きなスーツにするような体の構造なので、足は太いかもしれない。\n\nありがとうございました！\n\n参考文献：https://drive.google.com/drive/folders/1kKv4v_RtNRCdKv369sk6qIBjPyLWkU8j?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gengen7210/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1df74572/uploads/origins/a5a7fd1c-c59f-4e71-9028-072aab5bbb81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c122951930bc19d2032101d1bcc4de02", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 635434, "client_id": 941220, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gengen7210/works/7", "private_thumbnail_image_urls": {"