mgix.net/81660329/uploads/origins/0fca21d8-d3d6-4060-a93c-313029933174?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47d4208d8fc9d2e68a742c8fc7e4080d, https://si.imgix.net/81660329/uploads/origins/0fca21d8-d3d6-4060-a93c-313029933174?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d346a1b7e60710f6184bae5f3d9bdd1c 2x, https://si.imgix.net/81660329/uploads/origins/0fca21d8-d3d6-4060-a93c-313029933174?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b55fe4285851f35441141fc697bf8e6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81660329/uploads/origins/0fca21d8-d3d6-4060-a93c-313029933174?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3eab2cf6c986896815463ceba0488f22", "srcset": "https://si.imgix.net/81660329/uploads/origins/0fca21d8-d3d6-4060-a93c-313029933174?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3eab2cf6c986896815463ceba0488f22, https://si.imgix.net/81660329/uploads/origins/0fca21d8-d3d6-4060-a93c-313029933174?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4fbe231e9afb52096c7fca34e1c86711 2x, https://si.imgix.net/81660329/uploads/origins/0fca21d8-d3d6-4060-a93c-313029933174?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8b71c2375e946d735618b7f506b48a67 3x"}, "body": "いつもお世話になっております、東方とモアイです\n今回はこちらのキャラである東方さんをあらきさんにリクエストしたいです。ポーズは全力でフルスイングしているミスターな感じでお願いしたいです\n見た目的には…\n\n青い学生服みたいな上着\n赤いタートルネック\n赤いマフラー\n青いショートの髪\n\nみたいな感じです\nイラストの用途は …\nSNSやBlogでの紹介 \n動画のサムネなどになります\n\nよろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@qbthgry/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 748016, "client_id": 481902, "vtt_url": null, "thumb