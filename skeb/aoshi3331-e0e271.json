79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d03797ca69628baa3222cd92dc9d83f8, https://si.imgix.net/668f1634/uploads/origins/5ba51882-87ae-4baa-8eb1-6104d26c8979?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bdaedd509ad142f8f87e104465318a1e 2x, https://si.imgix.net/668f1634/uploads/origins/5ba51882-87ae-4baa-8eb1-6104d26c8979?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd1b0a679c0ffd56261510ca00b6ab13 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/668f1634/uploads/origins/5ba51882-87ae-4baa-8eb1-6104d26c8979?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c9c5b9e588f2ed478134831e7b4fe4d", "srcset": "https://si.imgix.net/668f1634/uploads/origins/5ba51882-87ae-4baa-8eb1-6104d26c8979?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c9c5b9e588f2ed478134831e7b4fe4d, https://si.imgix.net/668f1634/uploads/origins/5ba51882-87ae-4baa-8eb1-6104d26c8979?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dfabd05843e8c36b787d014cc4bf0b56 2x, https://si.imgix.net/668f1634/uploads/origins/5ba51882-87ae-4baa-8eb1-6104d26c8979?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=07340d1f9adc740e2954b9d5efd4ba0b 3x"}, "body": "先日はありがとうございました。\n前回のイラストが良かったのでまたリクエストします。\n内容や希望差分での条件に問題がありましたらキャンセル・再送をお願いします。\n\nホロライブDEV_ISの音乃瀬奏のイラストをお願いします。\n\nキャラ参考\nhttps://twitter.com/otonosekanade/status/1705921767695696277\n衣装参考\nhttps://www.youtube.com/watch?v=HP8k2PxE8M0\nhttps://twitter.com/rakugaki_choo/status/1783443299975803103\n\nシチュエーションや構図、差分など\n・前回と同じ二人の男に音乃瀬奏が身体を開発されている\n・媚薬ローションを両胸全体に浸透され着衣の擦れだけで感じている\n・男の一人は口に挿入しディープスロートで喉奥を楽しんでいる\n・もう一人の男は尻穴にビーズを抜き差しし、Gスポットをぐりぐりと手マンして開発している\n・不定期に二人に片胸ずつ同時に、服の上から乳房を乳搾りのように握られ乳首を捻られている\n\n・前回の二人の男に何日も調教されている設定が良かったので今回もそちらでお願いします。\n・前回より過去の時間軸で、奏がまだ反抗的で行為に不慣れな感じにして下さい。\n・衣装のシャツの下は黒のインナーで、大量のローションで透けて見えている様子をお願いします。\n・不意討ちで媚薬漬けの両胸全体を押し潰され胸だけで絶頂する描写が見たいです。\n・衣装はシャツから下は脱がさず胸の露出は無しで、他もできるだけ脱がさず、ずらす・部分的に切る形でお願いします。\n・黄色のネクタイで長い髪を雑に纏めて腰の鎖で両手を固定してほしいです。\n\n・アングルは喉奥責めがメインで表情が見える形で、胸責め、尻穴責め、Gスポット責めが隠れる場合はカットインで見たいです。\n・潮噴き・喉奥射精(できれば各2回以上)の差分と喉奥・膣内・尻穴内の断面図差分が欲しいです。\n・涙目で睨んでいる、喉奥を塞がれてくぐもった声で泣き叫ぶ、喉奥射精の苦しさで虚ろ目で失神し脱力しているといった表情差分をお願いします。\n・快楽墜ちはせず、涙を流して耐えながら疲弊して失神する感じでお願いします。\n\n以上です。ご検討いただけますと幸いです、よろしくお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aoshi3331/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2145832, "client_id": 721171, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7211e99a/uploads/origins/03966830-2d9f-40ff-acb9-79af9400a52f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=458179e8169b2d43696fa6fe985f2040", "srcset": "https://si.imgix.net/7211e99a/uploads/origins/03966830-2d9f-40ff-acb9-79af9400a52f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=458179e8169b2d43696fa6fe985f2040, https://si.imgix.net/7211e99a/uploads/origins/03966830-2d9f-40ff-acb9-79af9400a52f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75712f6687fd48411ab3c88632a59deb 2x, https://si.imgix.net/7211e99a/uploads/origins/03966830-2d9f-40ff-acb9-79af9400a52f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4009290be27b640a57c9cdaa7e6d6c7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7211e99a/uploads/origins/03966830-2d9f-40ff-acb9-79af9400a52f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74a3a8db5ac4fca7bd765057f5b88eac", "srcset": "https://si.imgix.net/7211e99a/uploads/origins/03966830-2d9f-40ff-acb9-79af9400a52f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74a3a8db5ac4fca7bd765057f5b88eac, https://si.imgix.net/7211e99a/uploads/origins/03966830-2d9f-40ff-acb9-79af9400a52f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4660c1327b00f19afd0eca63b14d6f34 2x, https://si.imgix.net/7211e99a/uploads/origins/03966830-2d9f-40ff-acb9-79af9400a52f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=55874c34ba16f80eceba632f211bab99 3x"}, "body": "同じ依頼をさせていただきます\nよければお願いします\n\n[キャラ]\n艦隊これくしょん　龍田改二\n\n[内容]\nお尻を向けたポーズ(ジャックオーチャレンジや、資料URLのようなイメージ)で、ノーパンでアソコを見せて挑発している\n\n[細かい希望]\n同時には不可能なもの、金額的に無理なものなどあるかと思いますので、できる範囲、やっていただける範囲でお願いします\n<服装>\n・原作の服でお願いします\n・スカートなど腰回りの衣装はぜひ残してください。アソコが見える際、全裸より、腰周りがスカートに覆われている絵を好みます\n・胸は見えていると嬉しいです\n・頭の輪っか以外の、メカ部分は描かれなくて結構です\n\n<差分展開>\n・最初アソコは閉じ気味で、表情も挑発的で妖艶な余裕あるもの\n　→責められてアソコが広がったりクリが膨らんだり濡れてきたりし、快感で表情に余裕がなくなる\n　→潮吹き絶頂、快楽に耐えきれず「ん゛お゛っ♡」とイキ顔をさらす/のけぞって表情が見えなくなる\n\n<体形>\n・とくにスラっと長い脚に魅力を感じておりますので表現いただければ嬉しく思います\n・いつもの青しさんの柔らかいお腹周りの肉付き表現が好きなのですが、元絵のイメージから、お腹ウエスト周りは、絞り気味で表現いただけると嬉しいです\n・パフィーニップルを希望します\n・張りのあるロケットおっぱいを希望します\n・陰毛の有無はお任せします\n\n<その他>\n・アソコがよく見える構図にしていただきたいです\n・責められる際、アソコが広がり、奥の子宮口まで見えていて欲しいです\n・膣～子宮の断面図(ポルチオを責められて快楽を感じている、子宮に精液を注ぎ込まれる、絶頂で膣が痙攣する、子宮が下りてくるなど)があると嬉しく思います\n・責めの手段はおまかせします\n\nhttps://imgur.com/a/jJVGhxO", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aoshi3331/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2145832, "client_id": 3218006, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f67b8b4/uploads/origins/f4c3db60-c5a3-47d8-9d6f-2c587e305254?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ee76780f7ecfa4606168799bc581b1f", "srcset": "https://si.imgix.net/0f67b8b4/uploads/origins/f4c3db60-c5a3-47d8-9d6f-2c587e305254?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ee76780f7ecfa4606168799bc5