易なデカパイではなく、服を着ているときは目立たないけど、脱いだところを見ると意外とある…そんな感じのサイズ感で描いていただけたらと思います。\n原作ゲーム公式のキャラ紹介は簡素だったので、アニメ版公式のキャラ紹介のリンクを参考につけておきます。http://www.litbus-anime.com/lb/character/index.html", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@simako1227/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c4b5e41c/uploads/origins/cc917b91-70e4-4057-b7e1-100974dc81cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4fe74933cc039c07448db96593e0dd27", "srcset": "https://si.imgix.net/c4b5e41c/uploads/origins/cc917b91-70e4-4057-b7e1-100974dc81cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4fe74933cc039c07448db96593e0dd27, https://si.imgix.net/c4b5e41c/uploads/origins/cc917b91-70e4-4057-b7e1-100974dc81cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f4fa4ac3bf7c2461480e0d596149363 2x, https://si.imgix.net/c4b5e41c/uploads/origins/cc917b91-70e4-4057-b7e1-100974dc81cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a4695c03250b2cb1e8ef814dfee2c15 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 137723, "nc": 51}, {"path": "/@simako1227/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 137723, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/346bbab7/uploads/origins/fa9181fc-80aa-400e-8b4c-ee700f3bea40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bb66a642133ae472f80105065676181", "srcset": "https://si.imgix.