意しましたのでご確認ください。\n\n邪鬼姫が作中で使用した「Ｔバック幻術」というお尻に見とれさせることで幻術にかけるシーンを貴方のタッチで作成して頂けないでしょうか。\n\n詳細な構図などはお任せしますが、こちらに向けてお尻を見せつけている邪鬼姫と、その周囲に幻術のお尻や桃がぐるぐる回っているようなイメージで作成して頂ければ幸いです。\n\n分かりにくい依頼で申し訳ございませんが、ご検討のほどをよろしくお願いします。\n\nhttps://drive.google.com/file/d/1WAf_3-qZq5qT1Wmy81QzhzjtpxO39Yhd/view?usp=drivesdk", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@simako1227/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8d97ba03/uploads/origins/392fe71d-5594-4e5e-b72d-ca1a4dc750fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=533c208c46ef51641b398329993a880e", "srcset": "https://si.imgix.net/8d97ba03/uploads/origins/392fe71d-5594-4e5e-b72d-ca1a4dc750fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=533c208c46ef51641b398329993a880e, https://si.imgix.net/8d97ba03/uploads/origins/392fe71d-5594-4e5e-b72d-ca1a4dc750fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=859e6dcf88b0bc52e2962927e72a6498 2x, https://si.imgix.net/8d97ba03/uploads/origins/392fe71d-5594-4e5e-b72d-ca1a4dc750fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34462eea187de6f06c14121ae3094cb5 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 137723, "nc": 162}, {"path": "/@simako1227/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 137723, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6dc4abd0/uploads/origins/069a5040-6357-42d6-9566-0eb687ac7fd4?bg=%23fff&