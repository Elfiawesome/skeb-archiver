al_appeals_count": 0, "received_works": [{"path": "/@ikeno_kurume/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1734999, "client_id": 3752512, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/808ec130/uploads/origins/aa757967-676d-4ff2-8edb-8d2edf62689c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dd36d3ea26ab7b88558d2c1ab59a3f2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/808ec130/uploads/origins/aa757967-676d-4ff2-8edb-8d2edf62689c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6d690ba18ec8332fa67755008d8219d", "src_set": ""}, "body": "くるめ先生ーーーーーッ！！！！お疲れ様です。\n\n突然で恐縮ですが、うちの子のイラストを1枚お願いできますでしょうか？\n↓資料ッス\nhttps://x.com/wwwhamburgerwww/status/1966660802020360390?s=19\n\nシチュエーションは……そうですね。\n個人的に先生の影がバシッと落ちてる絵が好みなので\n\n「スカートを捲っておむつを見せてくる少女in路地裏」\n\nこんなニュアンスでお願い致す。フワッとしてて申し訳ない。\n\n\nあ、ちなみにご多忙だったり色々と難しい理由があったら全然スルーで大丈夫ッスー。\n自分への誕生月プレゼントで「相互様にうちの子依頼しちゃうべ！！！！」ってノリなので。\n\n気楽に考えて頂けると幸いですー。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikeno_kurume/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1734999, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5423c6ea/uploads/origins/2c673c32-f82e-4d81-b2a1-02f15c91d3a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cc3925001d5239aea3e9dedf6386abc", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5423c6ea/uploads/origins/2c673c32-f82e-4d81-b2a1-02f15c91d3a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab7b0dd009b91d0c79a9b11ae6cd3a0c", "src_set": ""}, "body": "いつもお世話になっております。\n水遊びパンツを穿いた私立グリモワール魔法学園の水無月風子ちゃんをリクエストします！\n水着の資料は以下となります。\nよろしくお願いします！\n\nhttps://image02.seesaawiki.jp/g/e/grimoire/GLwBGgVv3L.jpg", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikeno_kurume/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/199c9b62/uploads/origins/a2d66b59-119c-4120-b41e-66049dc28267?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a4b7275f97cd298018398288d660108", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1734999, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ikeno_kurume/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/78c11a8e/uploads/origins/bb86cf47-9a31-4e98-9bf9-3b0ac5443212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28c5e45debeb0689c79405f441b3e404", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1734999, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ikeno_kurume/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ca0c906f/uploads/origins/948ee452-47af-4b86-8833-e5a672a19e43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=acac22f7a6a67908b5db9e879f0bb153", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1734999, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ikeno_kurume/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1734999, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5385e3f/uploads/origins/4b506b70-c777-4a5d-bd7d-6fb64f15ef0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e27259453b168ad3ef583efa009a7cf8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5385e3f/uploads/origins/4b506b70-c777-4a5d-bd7d-6fb64f15ef0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bcff8977919f76f1b163422746dc475a", "src_set": ""}, "body": "Pixivで拝見しました。\nおむつコキ(おむつでオナホコキのようにする)シチュエーションをお願いします。\n\n小学校低～中学年くらいの女の子がおむつをチンポに被せて、おむつごと上下にシコシコしている感じです。\nおむつの中にそのまま射精させられていることがわかる描写があるとうれしいですが、\nチンポ自体は断面図のようにして描写しなくてかまいません。\n\n男側がやらせているのではなく、女の子の側がイタズラ好きでソフトSの、セリフも\n「女の子のおむつに男の子のおもらし出ちゃってるね～ｗ」とからかう感じでお願いします。\n女の子もおむつをはいていて、射精と同時におもらししている差分もできればお願いします。\n\nおむつはザ・女の子といった感じのグーンやオヤスミマンのプリンセスデザインのものにしてください。\nhttps://www.elleair.jp/goo-n/princess2024/\nhttps://paypayfleamarket.yahoo.co.jp/item/z359953694", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikeno_kurume/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/277ace0d/uploads/origins/893e6e55-d02a-4e0c-97dd-98d0392897a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1542c18482e3d8297bd0bcadba500968", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1734999, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ikeno_kurume/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1734999, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea9d8e30/uploads/origins/2e025789-b32a-4015-a034-e15a7e39f8db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa1c7c46c798233e682064ed4bfa3ff8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea9d8e30/uploads/origins/2e025789-b32a-4015-a034-e15a7e39f8db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c416207c9e1d63d0429e8e29fc8e88e", "src_set": ""}, "body": "初めまして！くるめ先生に是非描いていただきたいイラストがありリクエストさせてもらいました！\n着衣の限界おもらし希望なのですが、難しそうならおむつ着用でも大丈夫です！\n高校生ぐらいの女の子が遊園地に遊びに行き、観覧車に乗っていた所トラブルにより運転停止、そのまま我慢出来ずに…という場面を描いていただきたいです。\n\n服装はズボン希望で、濡れた場所がよくわかる（デニムや薄い色、素材）物をお願いします！\nできれば足元に水溜りができている絵面を取り入れて欲しいです。\n長々と長文失礼しました。よろしくお願いします！", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikeno_kurume/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1734999, "client_id": 537757, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/767d91b0/uploads/origins/59c4855a-5a3f-432f-923b-625ddc72dda3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b4b23c5325aa57cbe4fad51124359ba", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/767d91b0/uploads/origins/59c4855a-5a3f-432f-923b-625ddc72dda3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88bf187a7cfa22dc67e1614865fba1bb", "src_set": ""}, "body": "初めまして。以前より池野くるめさんのおむつ絵を見させていただいておりましたが、この機会に是非リクエストさせていただきます。\nリクエストさせていただくキャラクターとしては当方のOC(いわゆるうちのこ)の『木水 八千代』ちゃんでお願いしたく思います。(キャラクターの造形についてはURLを添付します)\nシチュエーションとしては、ある時トイレの失敗をきっかけにおもらしやおむつに興味を持って、家族が出かけている間にこっそり妹のおむつを拝借して試しに限界まで我慢からのおもらしをしてみた上で、ズボンを脱いでその後始末をしようとしている…というような感じを希望します。\n以下、細かい要望点です。\n・おむつはビッグより大きいサイズかスーパービッグサイズの女の子用(メーカーや柄はお任せですがパンツタイプでお願いしたいです)\n・背景というか場所はお風呂場かトイレ(後始末のことを心配しているようなイメージです)\n・勢いよくおしっこを出した+量が多めだったため、多少の横漏れが起きていた痕跡があると嬉しいです。\n・表情としては、かなり恥ずかしさが出ている感じでお願いしたいです。\nその他の詳細や描写についてはお任せします。\n以上、宜しければご検討ください。\n\nhttps://twitter.com/omo_kisui/status/1420001521165488132", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikeno_kurume/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1734999, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8c6a745/uploads/origins/14c3f56b-50f9-4c64-aea6-897c9463a4d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90ef0676b07a473355989e5c82809394", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8c6a745/uploads/origins/14c3f56b-50f9-4c64-aea6-897c9463a4d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fcb3154c9ed10a65fcca47c0b654287", "src_set": ""}, "body": "池野先生こんにちは。\n\n以前に守谷月詠でリクエストをお受けいただきありがとうございました。手数料無料キャンペーン中ですのでぜひともまた同作品のキャラを依頼したいと思います。ご検討のほどよろしくお願いします。\n\nキャラクター：岸田夏海（私立グリモワール学園）\n\nシチュ：川など浅い水辺で水遊びの最中、何故かボトムスがずり落ちておむつが丸見えになってしまい、動揺して恥ずかしくなっています。\n\nポーズ：こちらがキャラの背後にいる前提で、お尻側を見せながら後ろを振り向いているように描いて欲しいのですがいかがでしょうか？\n\n服装、おむつ：以下に参考のURLを記載します。おむつ以外の服装について、一旦こちらのイメージしているイラストを添付していますが、厳しそうでしたらシチュに沿う範囲で自由に描いてください。おむつは何種類か参考画像を用意しましたので、今後の創作も含めお好きに使用してもらって大丈夫です。今回もし差し支えなければおむつの柄を2種類ほど描いて頂きたいのですが、いかがでしょうか...？\n\nhttps://drive.google.com/drive/folders/1vn8GHlm-sJyA1lBcBXwjdJvIGiafSXiq?usp=sharing", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikeno_kurume/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1734999, "client_id": 584809, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff5f6183/uploads/origins/5232fea0-ee2a-4f48-b7f5-4ac39235c9c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a18bc46c754ad5b7b5e56cf0298b70ea", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff5f6183/uploads/origins/5232fea0-ee2a-4f48-b7f5-4ac39235c9c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=685eda4e88334c2682ba893fe9e146eb", "src_set": ""}, "body": "中1くらいの吹奏楽部の女の子が、音楽準備室でやっときた休憩時間に「あぶないあぶない…エアコン効きすぎだし…練習長いよぉ…」と愚痴を言いながら溢れそうなパットが付いたパンツを脱いで、ピンチの時用のナイジュニに穿き変えようとして、お股をウエットティッシュで拭いている最中の中学1年生の絵をお願いします！\n【細かいところ】\n(服装)上は制服(シャツまで)、スカートの中はハーフパンツ→ハーフパンツを脱いでいる。スカートは脱いで置いていても、捲って手で押さえてても可。\n•尿取りパットが入ってぐっしょりなパンツ、ちょっと漏れ出して濡れてしまったハーフパンツが床に落ちてる\n•穿き変えるグーンナイトジュニアが置いてある。\n•後ろ1つ結び、おでこ出し？(が好みですが都合にお任せします)\n無理なものは端折ってください！\n陰部の見える見えないはポリシーとか趣向にお任せします。ウエットティッシュが大判で見えない！とかで大丈夫です。\n\nよろしくお願いします！", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikeno_kurume/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2d0bff37/uploads/origins/2606e0f5-210d-41bb-b080-208f42d6f48b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da78e704dc88228ff1364128ca2bd2d2", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1734999, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore