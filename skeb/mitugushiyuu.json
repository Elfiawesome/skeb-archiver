ト絵の様子から\n　　ふわっとした鳥感のある造形かなと思っておりますが\n　　ピンと来ない、描きにくいようならスルーして下さい\n\n２人をアイドル風衣装でリクエストいたします。\nもし可能であればステージで歌っている風でお願いしたく存じます。\nそれ以外については先生にお任せでお願いしたく存じます。\n２人１枚の構図でも、１人ずつ２枚のものでもお任せいたします。\n\nもしよろしければご検討下さいますよう、何卒お願い申し上げます", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mitugushiyuu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1158792, "client_id": 2127774, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/020cec59/uploads/origins/ce650986-a145-46e4-a413-778d98c678dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8885b29ccbbc006207d8c91eee3fa883", "srcset": "https://si.imgix.net/020cec59/uploads/origins/ce650986-a145-46e4-a413-778d98c678dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8885b29ccbbc006207d8c91eee3fa883, https://si.imgix.net/020cec59/uploads/origins/ce650986-a145-46e4-a413-778d98c678dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c950a2a8f1ff91df3c92a00ce1aedc85 2x, https://si.imgix.net/020cec59/uploads/origins/ce650986-a145-46e4-a413-778d98c678dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=181e97e1a2cb2666f5ba48193db8f620 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/020cec59/uploads/origins/ce650986-a145-46e4-a413-778d98c678dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=468ac17ca17894a5e71a19915697116a", "srcset": "https://si.imgix.net/020cec59/uploads/origins/ce650986-a145-46e4-a413-778d98c678dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=468ac17ca17894a5e71a19915697116a, https://si.imgix.net/020cec59/uploads/origins/ce650986-a145-46e4-a413-778d98c678dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=46576c