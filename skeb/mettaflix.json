832-4b86-8eb1-efc586c6c028?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c0954094c4eee5eeb4b9e599cb5f458", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2013683, "client_id": 339053, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@mettaflix/works/115", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2013683, "client_id": 2043110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0394a219/uploads/origins/b1e522bb-c45a-44af-bfac-121cc8b77fea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d28779c7cc16aca87f5ef243ba56fc87", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0394a219/uploads/origins/b1e522bb-c45a-44af-bfac-121cc8b77fea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9f3d117c6d1523be2713e977401785d", "src_set": ""}, "body": "親愛なる@mettaflixにご挨拶、\nゆるやかなテクスチャーと彩度を落とした色使いが素晴らしい！あなたのアートスタイルは信じられないほどユニークだと思います！このキャラクターを描いていただけませんか？あなたの絵ならとても楽しそうに見えると思います。\n彼は這い寄る混沌、ニャルラトホテプの使徒である。彼は幼なじみと一緒に閉鎖的なカトリックのコミュニティで育ったが、彼がより偉大で、より恐ろしいものに触れたとき、彼らの人生は変わった。彼は両親と、礼拝堂で知り合ったすべての人々を、彼が従う外なる神のために犠牲にした。\n彼は思いつきで破壊的なことをし、満面の笑みを浮かべるハッピー・ゴー・ラッキーなタイプに見える。\n黒い肌をしている。彼のデザインで特筆すべき点は、黒い瞳孔を持つ三白眼と、髪の後ろに4つの小さな三つ編みが混ざっていることだ。髪の明るい部分は白髪ではなくプラチナである。\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1-KPaWmi0Mj-pDNVypmUKJfzkyxwfExkN", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mettaflix/works/114", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2013683, "client_id": 2928251, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8b3db06/uploads/origins/a0f7f64d-8c20-4669-95d3-514e73b09647?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3a6da428f956a4122d79beefeb4936f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8b3db06/uploads/origins/a0f7f64d-8c20-4669-95d3-514e73b09647?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5065abc62128eeeeaaeb7c7bed05e4f9", "src_set": ""}, "body": "こんにちは、@mettaflixさん！\n以前のルシアスの描き方がとても好きでした！！！\nまたルシウスを描いていただいてもよろしいでしょうか？\n\nルシウス（177cm）は善でも悪でもない悪魔のようなヴァンパイア。無邪気な微笑みと無邪気な冗談が彼を後光に包んでいる。実在の人物とは思えず、おとぎ話に出てくる不条理な人物に近い。彼の本性は誘惑的だが、禁断の果実のように食べられない。誘惑的だが、目の錯覚にすぎない...。彼の周りには、まるで夢から覚めへの抽象的な移行の間に存在しているかのような、螺旋的で超現実的な空気が漂っている。逆説的だ！\n\nもう一度言いますが、表現とポーズはあなたの創造的裁量に任されています！どうぞ楽しんでください\nご検討ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1cIbmPZ8-T2c0KVP5ZI9qFUDwwr-9RzKG?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mettaflix/works/113", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2013683, "client_id": 2741772, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a7dc6e5/uploads/origins/04879fd0-d650-47d1-9ddc-62aff21c5113?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a24b891e882c01dbf9138d26bac2d697", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a7dc6e5/uploads/origins/04879fd0-d650-47d1-9ddc-62aff21c5113?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30ba68a409bde6e6436d2094dc06acce", "src_set": ""}, "body": "滅多さ〜ん！！いつも素敵な絵をありがとううう🧡🧡🧡\nロン毛の男と、、ふぁふぁ髪の男を、、どっちもポリスで、、\n\n滅多さんきっと忙しいのにいつもファンにこんな素敵な機会を与えてくれてありが