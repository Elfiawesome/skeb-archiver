n自己愛が強く、自分を愛してくれる人が好きな快楽主義者。その実態は殺人鬼で、色々な人の家を転々として身体を重ねては、相手が自分に愛情のこもった表情を向けたタイミングで相手を殺して回っていた。そんな中ある日監禁されることとなり、最終的に自分を監禁した相手と想いが通じ合い幸せな生活を送っている。\n\nぞくぞくとした恍惚な美しい表情を浮かべながら、その右手は返り血で染まっているようなイラストでお願いしたいです。NSFWはありにしておくので、セクシーな雰囲気も歓迎です。\n\n【使用用途】\n個人観賞用\n\nご縁がありましたら、何卒宜しくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1cCL3-5vzVTSW3FnvMxbqWPExUagSOg29", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Midori_annte23/works/1380", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2620286, "client_id": 884770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/909d1326/uploads/origins/a804cad3-c882-4429-9b2f-5282347d239e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=251880784268f43a78a57b87eee7f815", "srcset": "https://si.imgix.net/909d1326/uploads/origins/a804cad3-c882-4429-9b2f-5282347d239e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=251880784268f43a78a57b87eee7f815, https://si.imgix.net/909d1326/uploads/origins/a804cad3-c882-4429-9b2f-5282347d239e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b855f06dd8174abb892bb91a6fb7de1a 2x, https://si.imgix.net/909d1326/uploads/origins/a804cad3-c882-4429-9b2f-5282347d239e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=776ae1f95744dec5b54572eeb6cab908 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/909d1326/uploads/origins/a804cad3-c882-4429-9b2f-5282347d239e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5890203277dc155843705a924f002abb", "srcset": "https://si.imgix.net/909d1326/uploads/origins/a804cad3-c882-4429-9b2f-5282347d239e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5890203277dc155843705a924f002abb, https://si.imgix.net/909d1326/up