4 のような「見下ろして笑っている」ような雰囲気で描いていただけると嬉しいですが、あなたがベストだと思うように描いてください！ 「衣装3」を使ってください！\n\nこれをアイコンやグッズ、サムネイルなどにクレジットを記載して使わせてもらいたいです :3\n\n主なポイント：\n- 耳は全部で4つ（猫耳とエルフの耳！）\n- 手には長く鋭い爪があり、ほんのり赤みが差しています\n- 彼はフェムボーイ（おとこのこ）です\n- タトゥーと目が暗闇で光る設定（もし合うと思えば）\n\n🩵 テキストや背景なしのバージョンもぜひお願いします！ :3\n\nhttps://drive.google.com/drive/folders/1FlE7aT7Tno_vaAEdNuhEnXNjqgsS3X36?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Midori_annte23/works/1357", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2620286, "client_id": 3891868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5601c83f/uploads/origins/1d41b202-6f14-4fc4-86b9-99a5e59d2005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5ab1b8c51a0cc8abf9d8a35c8848db3", "srcset": "https://si.imgix.net/5601c83f/uploads/origins/1d41b202-6f14-4fc4-86b9-99a5e59d2005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5ab1b8c51a0cc8abf9d8a35c8848db3, https://si.imgix.net/5601c83f/uploads/origins/1d41b202-6f14-4fc4-86b9-99a5e59d2005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b98c6b3ca28dd348fcd7100b06cdb034 2x, https://si.imgix.net/5601c83f/uploads/origins/1d41b202-6f14-4fc4-86b9-99a5e59d2005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59e7379ebb7886e58b38165d06a2636d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5601c83f/uploads/origins/1d41b202-6f14-4fc4-86b9-99a5e59d2005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a6e4d1553febd028098af29e6912dd6", "srcset": "https://si.imgix.net/5601c83f/uploads/origins/1d41b202-6f14-4fc4-86b9-99a5e59d2005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a6e4d1553febd028098af29e6912dd6, https://si.imgix.net/5601c