ストさせてください。\n\nキャラクター：\nボンバーガールより、パプルちゃんにてお願い致します。\n\n描いて頂きたい内容：\n目の下にクマが出来ている社畜OLパプルちゃん（眼鏡あり）が、\n休憩室の椅子に座り、マグカップを両手で持ったまま窓の外から見える夜景を遠い目で見ている。\nそんなイメージの内容にてお願い致します。\n\nコスチューム：\nリクルートスーツにてお願い致します。\n今回も可能であれば名札を下げてる形でお願いします。\n\n備考：\n可能でしたら、Twitterのアイコンとして利用したいと思っています。\nまた、眼鏡のあり・無しで差分可能でしたらお願いします（ＰＳＤ形式であると嬉しいです）\n\n御検討の程をお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@driftwood_nan/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 374146, "client_id": 445895, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b065d3b/requests/89381_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16b5b9b4a6337e94abda29e426caf283", "srcset": "https://si.imgix.net/9b065d3b/requests/89381_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16b5b9b4a6337e94abda29e426caf283, https://si.imgix.net/9b065d3b/requests/89381_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19862a267a9b88500b253825f5b1f1ca 2x, https://si.imgix.net/9b065d3b/requests/89381_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe7c0488c7ecb1b86c0b0fc22e057bc7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b065d3b/requests/89381_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b158bac335c22583e8b14638ccd7d1ab", "srcset": "https://si.imgix.net/9b065d3b/requests/89381_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b158bac335c22583e8b14638ccd7d1ab, https://si.imgix.net/9b065d3b/requests/89381_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e482ddb19a0533bf3078a66fe7d3fb96 2x, https://si.imgix.net/9b065d3b/requests/89381_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top