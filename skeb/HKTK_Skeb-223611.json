gins/7dbdec10-3305-4e7b-a409-e5e7b0c30e22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6a46c1fc1f963916982ef175549cc557 3x"}, "body": "お世話になってます！\n前回納品された絵、大切にさせていただいております。\n\n今回リクエストしたいのははくたかさんの欲望街の子です。\n炮餮さん本当にまじで大好きで、描き下ろしが見られたら感無量です\n\n完全に外の人間からのリクエストですので問題がありましたら遠慮なくキャンセルお願いします。\nよろしくお願いします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HKTK_Skeb/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2843891, "client_id": 3165997, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95d99b02/uploads/origins/149cc768-7326-49d2-816d-657ada8b2ecb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12b569c136ed160d03a05d756378648b", "srcset": "https://si.imgix.net/95d99b02/uploads/origins/149cc768-7326-49d2-816d-657ada8b2ecb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12b569c136ed160d03a05d756378648b, https://si.imgix.net/95d99b02/uploads/origins/149cc768-7326-49d2-816d-657ada8b2ecb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee1f8e7f3f18c6d299366a206390a839 2x, https://si.imgix.net/95d99b02/uploads/origins/149cc768-7326-49d2-816d-657ada8b2ecb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a97eb73856087cc8528bf620738f2a88 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95d99b02/uploads/origins/149cc768-7326-49d2-816d-657ada8b2ecb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e19a36446eac72293ebc0cc9445559a4", "srcset": "https://si.imgix.net/95d99b02/uploads/origins/149cc768-7326-49d2-816d-657ada8b2ecb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e19a36446eac72293ebc0cc9445559a4, https://si.imgix.net/95d99b02/uploads/origins/149cc768-7326-49d2-816d-657ada8b2ecb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f7c334d66cb2b77e5eeea1b53d48aa30 2x, https://si.imgix.net/95d99b02/uploads/origins/149cc768-7326-49d2-816d-657ada8b2ecb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=444aa9092d0397efbfa70b35cdbb86f5 3x"}, "body": "こんばんわ、はじめまして！\n私はX上でボッチーノ13世というアカウントでTRPGを遊んでいる者です。\n今回、シナリオ『Paranormal Crime』で使用している立ち絵の\nリメイクをお願いしたくメッセージをお送りさせて頂きました。\n\n以下に箇条書きで依頼内容を記述致します。\n\n・依頼詳細\nAI生成により作成した立ち絵を参考に、大罪愚人号様の絵柄でリメイクをお願いしたいです。\n希望は『フルカラーの全身立ち絵』服装、髪型、姿勢は書きやすい様にしていただいて大丈夫です。\nただ、衣類として『FBIジャケット』を着せていただけると助かります。\n\n＞参考資料\nキャラクターシート(ネタバレはありません)\nhttps://iachara.com/view/8817968\nキャラ画像（X上に張っております。１枚目PC画像。２枚目ジャケット参考画像）\nhttps://x.com/pedoroze10/status/1938616213208510794\nhttps://x.com/pedoroze10/status/1896222578286711101\n\n・立ち絵の雰囲気の認識\n男性でありながらも女性の感性と僅かに男性としての空気感を持ったキャラクターです。\n性別に関しての手術は一切していないのであいていにいえば女装したおじさんとなりますが\n非常に美形とすらりとしたスタイルでよく見なければスマートな女性に見えます。\n色々と書きましたが簡単に言えば『宝塚の男役』が一番近い雰囲気になっているかと思います\n\n・きっかけ\nフォロワーさんの話題から大罪愚人号様の事を知りました。\nまた個人的にとても好きな絵柄だと思い、今回メッセージをお送りさせて頂きました。\n\n・最後に\n唐突な依頼になってしまい大変申し訳ございません。\nAI立ち絵ということもありますので断って頂いても大丈夫ではあります。\nですがもし可能でありましたらご検討宜しくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HKTK_Skeb/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0eb995d1/uploads/origins/a8524fb0-e91e-46bd-8ac8-51bfd58e8681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=305e26f524876a6d4c8b638d03177ccb", "srcset": "https://si.imgix.net/0eb995d1/uploads/origins/a8524fb0-e91e-46bd-8ac8-51bfd58e8681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=305e26f524876a6d4c8b638d03177ccb, https://si.imgix.net/0eb995d1/