礼動画に使用できたら…と企んでおります。\nなので人物のみの透過アニメーションでいただけたらとても嬉しいです。\n\n\n無理を言っているのは承知なので、不可であればお断りください！\n\n頂けた際には\nプロフィール欄にてとまさんのクレジット表記・再生後の紹介などをさせていただこうと思っています。\n\n：イメージ画像：\nhttps://drive.google.com/file/d/1ZEQjRHAyIgZ_77uSg_Rp3BELzoYjUuqN/view?usp=sharing\n\n：御奈良井ハシル参考画像：\nhttps://x.com/illust_clono/status/1667163758114775042?s=20", "nc": 1, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@tm_20/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 825996, "client_id": 2568184, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c890d017/uploads/origins/71f8736b-4fa7-44b5-8078-08432b418ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=184bf647eae4925c171513a4dc209898", "srcset": "https://si.imgix.net/c890d017/uploads/origins/71f8736b-4fa7-44b5-8078-08432b418ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=184bf647eae4925c171513a4dc209898, https://si.imgix.net/c890d017/uploads/origins/71f8736b-4fa7-44b5-8078-08432b418ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e1f17185f57cea591129f64ca6b2d2d 2x, https://si.imgix.net/c890d017/uploads/origins/71f8736b-4fa7-44b5-8078-08432b418ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1afd1ff4f48893d47badd9ba355d602 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c890d017/uploads/origins/71f8736b-4fa7-44b5-8078-08432b418ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e28c6cc6d2448c99cb808689949f6579", "srcset": "https://si.imgix.net/c890d017/uploads/origins/71f8736b-4fa7-44b5-8078-08432b418ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e28c6cc6d2448c99cb808689949f6579, https://si.imgix.net/c890d017/uploads/origins/71f8736b-4fa7-44b5-8078-08432b41