s=b1566f42127398871565048a2449f02b, https://si.imgix.net/e736ac48/uploads/origins/4fec7ea7-b381-4bff-a08a-3de947420ed6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a56a37e8c1af62249b0412202b39297 2x, https://si.imgix.net/e736ac48/uploads/origins/4fec7ea7-b381-4bff-a08a-3de947420ed6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4295ad62370aae3b49bbf41e0a194bd8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e736ac48/uploads/origins/4fec7ea7-b381-4bff-a08a-3de947420ed6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9864e4a4121a5a9f311b72e7274eaff1", "srcset": "https://si.imgix.net/e736ac48/uploads/origins/4fec7ea7-b381-4bff-a08a-3de947420ed6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9864e4a4121a5a9f311b72e7274eaff1, https://si.imgix.net/e736ac48/uploads/origins/4fec7ea7-b381-4bff-a08a-3de947420ed6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a0e066e72c6661e6f7a5cc4643d15ab 2x, https://si.imgix.net/e736ac48/uploads/origins/4fec7ea7-b381-4bff-a08a-3de947420ed6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6938a1302948d61104f2e951cc6b55b 3x"}, "body": "こんにちは！！あなたの描く女の子たちが本当に大好きで、私のオリジナルキャラクター（OC）を描いていただけないでしょうか！\n\nザラ（163cm）\n彼女は気性が激しく、口が悪めです。怒りを抑えようとはしますが、表情はまるで開かれた本のようなものです。本心はいつも顔に表れてしまいます。 イライラしている時に笑顔を作ろうとしても、無理に笑っているのが一目瞭然です。二面性のある両親のもとで育ったため、ザラ自身は正直すぎて困るほどです。彼女は物言いが率直で、嘘つきが大嫌いです。欠点はあるものの、自信に満ちており、自分の価値をしっかりと理解しています。 自分を一番よく知っているからこそ、誰にも自分を貶めさせたりはしません！クールな女の子です。\n\n※耳と尻尾にご注目ください！\n\nぜひ彼女のための衣装をデザインしていただけると嬉しいです！彼女のスタイルを掴むために、提示された衣装を参考にしても構いませんが、それ以外は自由に描いてください！ 構図やポーズはすべてお任せします。\n\nご検討いただきありがとうございます！お断りいただいても構いません。\n\nhttps://drive.google.com/drive/u/1/folders/1ARDnErwW4fE4drdqb0-NF31i18E5rOm8", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@P0pokon/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3720544, "client_id": 2405523, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d39e048/uploads/origins/77fe4218-3075-49eb-95d7-5f0805e230f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=931460b990ae462469b7e9e6d7d3cb37", "srcset": "https://si.imgix.net/4d39e048/uploads/origins/77fe4218-3075-49eb-95d7-5f0805e230f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=931460b990ae462469b7e9e6d7d3cb37, https://si.imgix.net/4d39e048/uploads/origins/77fe4218-3075-49eb-95d7-5f0805e230f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4dd606cce33587b53b132cb87dca143a 2x, https://si.imgix.net/4d39e048/uploads/origins/77fe4218-3075-49eb-95d7-5f0805e230f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=322afebab299c06205b5245c40251474 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d39e048/uploads/origins/77fe4218-3075-49eb-95d7-5f0805e230f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a039166bdc9603185458871935283a36", "srcset": "https://si.imgix.net/4d39e048/uploads/origins/77fe4218-3075-49eb-95d7-5f0805e230f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a039166bdc9603185458871935283a36, https://si.imgix.net/4d39e048/uploads/origins/77fe4218-3075-49eb-95d7-5f0805e230f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5f854fdd43cbd58290a18204e88e0f89 2x, https://si.imgix.net/4d39e048/uploads/origins/77fe4218-3075-49eb-95d7-5f0805e230f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=057630f3e666cb77fc9503b2c841ed25 3x"}, "body": "ぽぽこ様初めまして。\nVtuberの伊藤ユーと申します！\n\nぽぽこ様のイラストをSNSで拝見し魅力的な目力のあるかわいい絵柄と表情作りや塗りのセンスの良さ、\n躍動感のあるポーズの立ち絵などが本当にお上手で憧れます！！\n\nご縁があれば僕のイラストも描いていただけたら嬉しく思い、\nこの度リクエストをお送りいたしました。\n\n●イラスト内容\n・伊藤ユーを描いて頂きたいです。\n・ポーズや構図はお任せ致します。\n・参考の衣装通りでも構いませんしお好きにデザインして下さっても問題ないので\n　楽しんで描いて頂ければそれが一番嬉しいです！\n\n・サムネイルなどに使用できるよう背景透過差分を頂けますと幸いです。\n※可能であれば描画されている範囲のパーツ(腕の端や毛先など)が見切れない程度のキャンバスサイズで頂けますと幸いです。\n\n●使用用途\n・SNSのアイコンや投稿画像\n・Youtubeのサムネイル\n\n●デザインはこちらをご参照下さい。\n（https://drive.google.com/drive/folders/1UldEZZWR0GNVdopu4dgmIvOF3bf7mLyz?usp=drive_link）\n\nお忙しいところ恐れ入りますが、何卒ご検討の程宜しくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@P0pokon/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3720544, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bfcc8c89/uploads/origins/22f95f1b-ef67-4476-8730-f109bed7f701?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca4efbeb42c1826a37f845bc03dadc1d", "srcset": "https://si.imgix.net/bfcc8c89/uploads/origins/22f95f1b-ef67-4476-8730-f109bed7f701?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca4efbeb42c1826a37f845bc03dadc1d, https://si.imgix.net/bfcc8c89/uploads/origins/22f95f1b-ef67-4476-8730-f109bed7f701?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa88615e2df6354597a8a37f0ff68f92 2x, https://si.imgix.net/bfcc8c89/uploads/origins/22f95f1b-ef67-4476-8730-f109bed7f701?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47108d16f85c45896c401dc25a278167 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bfcc8c89/uploads/origins/22f95f1b-ef67-4476-8730-f109bed7f701?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=617024325d175a458f9fa9176bb2bb23", "srcset": "https://si.imgix.net/bfcc8c89/uploads/origins/22f95f1b-ef67-4476-8730-f109bed7f701?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=617024325d175a458f9fa9176bb2bb23, https://si.imgix.net/bfcc8c89/uploads/origins/22f95f1b-ef67-4476-8730-f109bed7f701?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32790cf834598e58350801a4d7a60555 2x, https://si.imgix.net/bfcc8c89/uploads/origins/22f95f1b-ef67-4476-8730-f109bed7f701?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0b80332b0c666e15efa5fc1d393ebfec 3x"}, "body": "はじめまして！\n\nぽぽこ様のイラストがとても素敵で、今回は私のキャラクターを描いて頂きたいと思いリクエストさせて頂きました。\n個人でアイコンや壁紙、鑑賞等に使用予定です。\n\n服装についでなのですが、資料ですと少し曖昧に描いてある部分がありますのでぽぽこ様が思うように描いていただきたいです。（秋~冬っぽいサブカル系のファッションだと嬉しいです！）\n髪型につきましては特徴的なぴょこっと跳ねた部分や前髪の形が変わらなければ長さなどは自由に変えていただいても構いません。（ボブなどは避けていただけますと幸いです…！）\n\nそして資料には無いのですがアクセサリー描いて頂ければ嬉しいです。\n\nおまかせ要素が多くなり読みづらい文章で申し訳御座いません。\nもしご縁が御座いましたら宜しくお願い致します🙇‍♀️✨️\n\nhttps://x.com/yo_harupi/status/2093642905395351594?s=46&t=Q0x8aKKI6UF0Di2_zN6Avw", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@P0pokon/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3720544, "client_id": 3427970, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/602071ce/uploads/origins/c262347b-f477-4ed5-8e15-4ccdf26095c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=032200f782c26fbadb4ba84f8451e8e4", "srcset": "https://si.imgix.net/602071ce/uploads/origins/c262347b-f477-4ed5-8e15-4ccdf26095c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=032200f782c26fbadb4ba84f8451e8e4, https://si.imgix.net/602071ce/uploads/origins/c262347b-f477-4ed5-8e15-4ccdf26095c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6dd464910f7dfba9eb479208b01c8f50 2x, https://si.imgix.net/602071ce/uploads/origins/c262347b-f477-4ed5-8e15-4ccdf26095c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=755599ad9268c3bd5a5e19231a7803f7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/602071ce/uploads/origins/c262347b-f477-4ed5-8e15-4ccdf26095c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e17b1dcf413f9d413953a3f54dd367da", "srcset": "https://si.imgix.net/602071ce/uploads/origins/c262347b-f477-4ed5-8e15-4ccdf26095c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e17b1dcf413f9d413953a3f54dd367da, https://si.imgix.net/602071ce/uploads/origins/c262347b-f477-4ed5-8e15-4ccdf26095c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5977c8ca6c68f2bc35eb36444f6e4d42 2x, https://si.imgix.net/602071ce/uploads/origins/c262347b-f477-4ed5-8e15-4ccdf26095c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0440115232fe940fe0d037782ce7ec2c 3x"}, "body": "はじめまして！\nぽぽこ様の描かれる魅力的なイラストを拝見し、ぜひ私の探索者（クトゥルフ神話TRPG「四季送り」HO弐 夏）を描いて頂きたくリクエストいたしました。\n\n【使用用途】\n個人鑑賞、SNSのアイコン・ヘッダー利用、TRPGセッション内での個人利用（非商用）、グッズ化（個人観賞用/非商用）\n上記内容や金額に問題がありましたらキャンセルや再送要請をお願いいたします。\n\n【衣装に関して】\nぽぽこ様の衣装デザインがとても好きなので、既存の制服ではなくキャラクターに似合う私服をデザインして描いて頂けますと幸いです。\n※彼は心身ともに男性ですが、着飾るのが好きでファッションとしてレディース・メンズ問わず中性的でお洒落な服を着こなすキャラクターです。キャラクターの雰囲気に合わせて、色味やアイテムのチョイスはお任せいたします。\n\n以下探索者のプロフィールを記載します！\n\n【キャラクター詳細】\n棗 モユル（なつめ もゆる）男／23歳／164cm\nイメージカラー：青碧（#369B9E）\n職業：殺し屋 兼 甘味処店員\n\n中性的で凛とした美形。\n手足が細く華奢な体躯をしているが、実はしっかりと筋力がある。\n瞳は鮮やかなイエロー、髪は青碧をベースにインナーや毛先がライトグリーンのウルフカット。（夏の青空や海をイメージしています）長い部分の髪はエクステ。\n負けず嫌いで自己肯定感が高く、自分の生き方やスタイルに強いプライドを持っている。\n趣味は女装、トランスジェンダーではなく心身ともに男性。\nあくまで自分のために、自分に一番似合うファッションとして女装を楽しんでいる。\n\n・口調のイメージ\n一人称：「俺」\n二人称：「あんた」「名前呼び捨て」\n女装に合わせて裏声を使うことはしない。基本のトーンは低すぎず高すぎない、芯の通った中性的な男声。\n\n「別に、話しかけられたから答えただけ」\n「俺は俺が楽しいからこれ着てんの。あんたも着てみる？ 案外似合うかもしれないよ」\n\n・名前の由来\n棗…植物のナツメから。\n他の植物が春に一斉に芽吹く中、初夏に入ってからようやく新芽を出す。「夏に入って芽が出る」＝「夏芽（ナツメ）」が語源。\n花言葉は「健康」「健康の果実」「若々しさ」「英俊」「あなたの存在は私の悩みを軽くします」\nモユル…「燃ゆる（夏の季語）」から。自分の軸を絶対に曲げない、静かに燃える熱。\n\nお忙しいところ最後まで目を通していただきありがとうございます。 ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1_GPJEeS58AQnkLM_GXAWr652-8niYczX?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@P0pokon/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3720544, "client_id": 3486948, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ab9c9dd/uploads/origins/5b9c5306-8b8f-4cbb-8716-3643ec876e41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a51ddc870fbd44aece4a3a4811be06b", "srcset": "https://si.imgix.net/7ab9c9dd/uploads/origins/5b9c5306-8b8f-4cbb-8716-3643ec876e41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a51ddc870fbd44aece4a3a4811be06b, https://si.imgix.net/7ab9c9dd/uploads/origins/5b9c5306-8b8f-4cbb-8716-3643ec876e41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=834131b043f26c9364ed05e18d2a1bd1 2x, https://si.imgix.net/7ab9c9dd/uploads/origins/5b9c5306-8b8f-4cbb-8716-3643ec876e41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1eb0a4da694edd45cecc768b8dba2e3c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ab9c9dd/uploads/origins/5b9c5306-8b8f-4cbb-8716-3643ec876e41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bace2ab3fed899ee2d10fc3f46e04f09", "srcset": "https://si.imgix.net/7ab9c9dd/uploads/origins/5b9c5306-8b8f-4cbb-8716-3643ec876e41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bace2ab3fed899ee2d10fc3f46e04f09, https://si.imgix.net/7ab9c9dd/uploads/origins/5b9c5306-8b8f-4cbb-8716-3643ec876e41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c3d9fdc786f248c12138462b293f1dcf 2x, https://si.imgix.net/7ab9c9dd/uploads/origins/5b9c5306-8b8f-4cbb-8716-3643ec876e41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8f72e7118821687ece5216e6fd9b1b0f 3x"}, "body": "はじめまして！Xにて素敵なイラストに惹かれました！塗り込み方やまつ毛の描き方などが本当に素敵で見惚れてしまいます> <♡\n今回はOC2人分の衣装デザインをしていただきたくリクエストさせていただきます🩷\n※資料内にGL含むので、難しい場合はキャンセルしていただいて大丈夫です。\n\n柚瀬もか…元気・明るい/モチーフ:🎀🐑(羊)\n寧々宮らて…おだやか・優しい/🎀🧸(クマ)\n\nぽぽこ様のセンスが本当に大好きなので、ぜひぽぽこ様のお得意なY2K風な衣装に仕立てていただきたいです😻\nリボンなど、雰囲気にそぐわない小物は取り外してしまって大丈夫です！髪型なども変更していただいてかまいません🌷\n\nただ、OC2人それぞれの足にギザギザとした模様があるのですが、そのギザギザを衣装のどこかに取り入れていただけると嬉しいです！\n(分かりづらくて申し訳ないです。資料見ていただけたら分かると思います；；)\n\n\n金額に不備がある場合はお手数ですが再送申請をお願いします。その他難しい場合はキャンセルしていただいて大丈夫です🙇🏻‍♀️\n\n○使用用途\n・個人鑑賞\n・参考資料への掲載\n\nご検討よろしくお願いします🍀\n\nhttps://drive.google.com/drive/folders/173KN4jLy1DIXAH408nf1ecMJYQQ92jn4", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@P0pokon/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/435eabdd/uploads/origins/7cda94da-bfe5-4193-baab-fa3ed172af47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fac2925d87dc1af2a4d874dc0caff75", "srcset": "https://si.imgix.net/435eabdd/uploads/origins/7cda94da-bfe5-4193-baab-fa3ed172af47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fac2925d87dc1af2a4d874dc0caff75, https://si.imgix.net/435eabdd/uploads/origins/7cda94da-bfe5-4193-baab-fa3ed172af47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f27418f43652a78d65b3d0348e9de640 2x, https://si.imgix.net/435eabdd/uploads/origins/7cda94da-bfe5-4193-baab-fa3ed172af47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px