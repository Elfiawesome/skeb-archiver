3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94540303f103408c0173e3841ed6ec54, https://si.imgix.net/53829576/uploads/origins/68b3f06c-edbd-4df5-b999-de1a418d7afe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d867713cd5002c9453442cd71768fce 2x, https://si.imgix.net/53829576/uploads/origins/68b3f06c-edbd-4df5-b999-de1a418d7afe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79cdfff996e2234b6274c1892050b470 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53829576/uploads/origins/68b3f06c-edbd-4df5-b999-de1a418d7afe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d8a704a7666ca3f4e3b1efcca76056c", "srcset": "https://si.imgix.net/53829576/uploads/origins/68b3f06c-edbd-4df5-b999-de1a418d7afe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d8a704a7666ca3f4e3b1efcca76056c, https://si.imgix.net/53829576/uploads/origins/68b3f06c-edbd-4df5-b999-de1a418d7afe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8eafff662bc2da4179f07cad4b6a4ecf 2x, https://si.imgix.net/53829576/uploads/origins/68b3f06c-edbd-4df5-b999-de1a418d7afe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=91b03121377e5a901a60d0680a8e0c17 3x"}, "body": "はじめまして。マツバさんの作品の美しさに惹かれ、今回リクエストをさせていただきました。\n\n私のオリジナルキャラクターを描いていただきたいです。\n彼女の名前はメイドといいます。彼女が退廃的もしくは近未来的な建物の中or外で銃を持っている姿を描いていただきたいです。血の表現も必要であればしていただいて構いません。\n\n髪の色は赤、白、黒、グレーなら何でも良いです。衣装にも特にこだわりはありませんのでお好きなように描いていただけると嬉しいです。\n\nマツバさんが描いていて楽しい作品を作っていただけると一番嬉しいです！これからも応援しております\n\nhttps://drive.google.com/drive/folders/19mJlT2Xu06WgbEMc1HYftVbGD_mbAJav", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Matsuba10/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "