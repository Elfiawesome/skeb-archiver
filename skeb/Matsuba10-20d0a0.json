のか、その様子を伝えたい。\n\n・エインズリーはテレビを見ながら、リモコンでチャンネルを切り替えています\n・フィアは鏡の前に立っている\n・フィアはカジュアルな服装をしている（服装はおまかせ）\n・フィアは鏡越しにエドマンドと会話している\n\nこのイラストは、「普段は普通なのに、ひとつだけ異常なこと、すごいことがある（この場合は、鏡越しに人と話している）」という感じを出したいのです。\n\nよろしくお願いいたします！\n\nhttps://ln5.sync.com/dl/c1e8c9bc0/uyk3cb7d-8rztc5wb-epfcernu-cr8yu5nx", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Matsuba10/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1670729, "client_id": 65684, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35af4344/uploads/origins/82939179-99dd-4278-a194-1c5256aec88b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=793b2e83d209cd706acba16f65ef2e6b", "srcset": "https://si.imgix.net/35af4344/uploads/origins/82939179-99dd-4278-a194-1c5256aec88b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=793b2e83d209cd706acba16f65ef2e6b, https://si.imgix.net/35af4344/uploads/origins/82939179-99dd-4278-a194-1c5256aec88b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69f58119052c64db9a38b25e7ce39786 2x, https://si.imgix.net/35af4344/uploads/origins/82939179-99dd-4278-a194-1c5256aec88b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62a1c44167e6819222b1f59b905f0274 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35af4344/uploads/origins/82939179-99dd-4278-a194-1c5256aec88b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75f66b2a2b0af660836001bd0cc62921", "srcset": "https://si.imgix.net/35af4344/uploads/origins/82939179-99dd-4278-a194-1c5256aec88b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75f66b2a2b0af660836001bd0cc62921, https://si.imgix.net/35af4344/uploads/origins/82939179-99dd-4278-a194-1c5256aec88b?bg=%23fff&auto=format%2Ccompre