みたいな所で、彼女に呪いをかけたブードゥーの悪霊たちに苦しめられている姿を先生が描いてあげてください。\n\nキャラクターリファレンスをご覧いただきますと、髪が短いバージョンと長いバージョンありますが、短い姿で描いていただければ幸いです。\n\n可能ならば彼女の剣が見えるように描いてくださればすごくありがたいです。\n\nもし役に立つかと思って彼女の二番目の服装である学院の制服についてリファレンスも添付します。\n\n海賊服のディテールは少し変更してもいいです。\n\n彼女の表情やポーズ、ブードゥー悪霊の姿などあとは全部先生にお任せします。\n\n以上、読んでいただき誠にありがとうございます。\n\nhttps://drive.google.com/drive/folders/1Emn8_BLjAzUf3Nd-LEqC0ekTdpzpt5o5?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 213957, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "鈍挫", "screen_name": "gyosonnotamiyo", "avatar_url": "https://pbs.twimg.com/profile_images/1581370223281963014/5nSMrHOJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1187287187928178688/1650779742/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1228878, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ミリ", "screen_name": "emicha2001", "avatar_url": "https://pbs.twimg.com/profile_images/2007832507191099392/xssRl0aZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1628696887783194626/1738679396/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1679687, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "乙芸🐳", "screen_name": "otugei", "avatar_url": "https://pbs.twimg.com/profile_images/1509879431183052800/EwAs2zxn.jpg", "header_url": "https://pbs.twimg.com/profile_banners/27017901/1642144066/1500x500", "appeal_r