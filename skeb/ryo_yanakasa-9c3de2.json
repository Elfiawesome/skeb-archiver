イラストを多数描かれているようなので特に注釈は必要ないと思いますので自由に描いて頂ければありがたいです。ディテールに関しても8弦で左利きでさえあれば写真と差異があっても構いません。\n\nダークなヘヴィーメタル系統の楽曲に合う邪悪な雰囲気に仕上げて頂けると嬉しいです。ポーズ等も梁笠様のご判断で自由にして下さい。衣装も自由にして頂いて構いません。\n\n立ち絵と所持ギターの写真、並びに曲調がわかるオリジナル楽曲を数点添付させて頂きました。\n\nhttps://www.dropbox.com/scl/fo/acqilmpqo86bexf308baw/AL7x9FxEAC6AvJFEa23Wys8?rlkey=zu2bpygtm9ispmpveed4f1z72&dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ryo_yanakasa/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3274999, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c9be8f57/uploads/origins/f1bbeb31-09f4-4224-a19a-21af78934640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21d79423a9001a73ee1557528aa94bfa", "srcset": "https://si.imgix.net/c9be8f57/uploads/origins/f1bbeb31-09f4-4224-a19a-21af78934640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21d79423a9001a73ee1557528aa94bfa, https://si.imgix.net/c9be8f57/uploads/origins/f1bbeb31-09f4-4224-a19a-21af78934640?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4e89349297a8efa3f840f1c7365af06 2x, https://si.imgix.net/c9be8f57/uploads/origins/f1bbeb31-09f4-4224-a19a-21af78934640?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb83bfcb349ced6d05f799065402a0c8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c9be8f57/uploads/origins/f1bbeb31-09f4-4224-a19a-21af78934640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1a1e9fe2f9f20dc03de407de399ea71", "srcset": "https://si.imgix.net/c9be8f57/uploads/origins/f1bbeb31-09f4-4224-a19a-21af78934640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1a1e9fe2f9f20dc03de407de399ea71, https://si.imgix.net/c9be8f57/uploads/origins/f1bbeb31-09f4-4224-a19a-21af789346