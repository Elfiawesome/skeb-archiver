dc92/uploads/outputs/b096fd0c-5c55-4f03-a2d9-9990c584dd18?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=334ffe9b35385c7c564df1848fc94909", "srcset": "https://si.imgix.net/249adc92/uploads/outputs/b096fd0c-5c55-4f03-a2d9-9990c584dd18?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=334ffe9b35385c7c564df1848fc94909, https://si.imgix.net/249adc92/uploads/outputs/b096fd0c-5c55-4f03-a2d9-9990c584dd18?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d69c70b28ba6cb544328b9a98068273 2x, https://si.imgix.net/249adc92/uploads/outputs/b096fd0c-5c55-4f03-a2d9-9990c584dd18?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6b020573da9b5d1c9c06a3cc69b80b6 3x"}, "duration": 56, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/249adc92/uploads/outputs/b096fd0c-5c55-4f03-a2d9-9990c584dd18?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=176bd40241ed9f7c75819c4fef792ea1", "srcset": "https://si.imgix.net/249adc92/uploads/outputs/b096fd0c-5c55-4f03-a2d9-9990c584dd18?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=176bd40241ed9f7c75819c4fef792ea1, https://si.imgix.net/249adc92/uploads/outputs/b096fd0c-5c55-4f03-a2d9-9990c584dd18?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5661b4d149a7787732346f6a057299fe 2x, https://si.imgix.net/249adc92/uploads/outputs/b096fd0c-5c55-4f03-a2d9-9990c584dd18?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cb37fbacc6e3338877d04224cfc5846a 3x"}, "body": "初めまして。\n参加企画のバディのお相手の動画がどうしてもどうしても欲しいです。依頼内容と金額が離れている場合はご再送ください。よろしくお願いします。ハッピーフライデー！\n\nCharacter：レイズ\n（デザイン・制作：ID◆hamphi_様）\n楽曲：ユリイ・カノン『惡手』\n（↘YouTubeリンクより）\n詳細に：\n具体的な采配は全てお任せしますが、動画は全てモノクロでミステリーっぽい雰囲気、サビの部分で【バストアップ絵差分】と【表情差分】が欲しいです。画像のどこかでインクの飛沫の演出等が入ると嬉しいです。またテキストの画質を一部少し粗いザラッとした感じで加工していただけるとさらに嬉しいです（目立つ文字等やワンフレーズ等の一部でいいです。お任せします）。\n強くてかっこよくて頭がよくて顔が良いキャラクターなので、強くてかっこよくて頭と顔が良いかんじでお願いします。\n本当によろしくお願いします。本当にお願いします。\n\nなお当方バディですが、レイズさん単体のイメージ動画が欲しいので、依頼主の担当キャラクターの匂わせは一切入れないでいただきたいです。\n本当によろしくお願いします……、ハッピーフライデー！\n\nhttps://youtu.be/_thKu8PS8cc?si=2T3aNN6tV7HWY5Lp", "nc": 145, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@tetora999/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 427009, "client_id": 2001308, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37979260/uploads/origins/56130ae1-08a0-4554-a0fa-975cb659d60d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66a97b3296882e44f2f65b54814324f8", "srcset": "https://si.imgix.net/37979260/uploads/origins/56130ae1-08a0-4554-a0fa-975cb659d60d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66a97b3296882e44f2f65b54814324f8, https://si.imgix.net/37979260/uploads/origins/56130ae1-08a0-4554-a0fa-975cb659d60d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b86299641f3f51e09c82c0a4fc058b9c 2x, https://si.imgix.net/37979260/uploads/origins/56130ae1-08a0-4554-a0fa-975cb659d60d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a232cbeba181612153b91f4b4330bbe7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37979260/uploads/origins/56130ae1-08a0-4554-a0fa-975cb659d60d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28573292c2e47a5486295cd872722353", "srcset": "https://si.imgix.net/37979260/uploads/origins/56130ae1-08a0-4554-a0fa-975cb659d60d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28573292c2e47a5486295cd872722353, https://si.imgix.net/37979260/uploads/origins/56130ae1-08a0-4554-a0fa-975cb659d60d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c7ed6df330230c429664ce8eea074a2 2x, https://si.imgix.net/37979260/uploads/origins/56130ae1-08a0-4554-a0fa-975cb659d60d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7203b28c50cef5bd5f2f9ba7ea2ddde6 3x"}, "body": "スケブ開設ありがとうございます！！\nどうしてもぺぽらさんの絵柄で見たかったので飛んできました。\n自作キャラクターのカラー絵をお願い致します。構図、背景の有無等はお任せ致します。\n\n以下、キャラクターの説明です。\n(資料リンクのリプライにCS有)\n箱庭系ロスト企画用に作成したキャラクターで、施設の最年長者の一人。やや意味不明な言動と透明感のある不思議な雰囲気を纏った中性的な少年／少女です(生物学的には一応女性)。左右対称の髪型と、インククロマトグラフィーのようなグラデーションヘアカラー、紙色の瞳にマッチの焔のように煌めく瞳孔が特徴的。\n天然で抜けているような行動も多いものの、異常事態でも動じず、冷静かつ迅速にいち早く動く事ができる強い精神力の持ち主。父が牧師、母がオルガニストで実家が教会。将来の夢は看護師。とても美しい歌声と、誰にでも献身的かつ平等な態度で地域の人々に愛されており、教会の聖歌隊隊長を務めていた経験があります。\nディスモーフォフィリア(奇形や欠損に対し性愛を覚える異常性癖)であり、五体満足の人間に興味や愛着を感じることができません。そんな自分を「おかしい」と自覚しており、性癖をひた隠しにすると共に、誰に対しても平等かつ「善いことだと教えられたように」親切に振る舞っていました。過去、難病で両足の骨に異常がある少女に一目惚れし親密になったものの、少女が自分以外の男に恋をしてしまったため、嫉妬と怒りから、不慮の事故に見せかけて大怪我をさせ、自殺に追い込んだ事があります。\n本性は空想癖が強く独善的で嫉妬深く、一度執着したものへは強い独占欲や支配欲を露わにしますが、普段から周囲の信頼を得ているため、その異常性が露見することは殆どありません。\n趣味は夜の散歩、キメラ動物の骨格標本を作ること。フラストレーションが溜まると、標本用に小動物を狩って殺したり、自傷行為等を行っており、「酷く傷ついた人と合法的に触れ合いたいから」という理由で看護師を目指しています。\nモチーフはアンデルセン童話(『人魚姫』の海の魔女、『マッチ売りの少女』、『小夜啼鳥』)、セイレーン、ロールシャッハテストです。また、作者としては、彼女を描く際に血・返り血を「青色(青インク)」で表現するが非常に多いです。\n\n本当にぺぽらさんの絵が好きなので、受理いただけると嬉しいです。どうぞよろしくお願い致します。\n\nhttps://twitter.com/C20H22N2O2/status/1496949673835171878?t=lF3E_VrorY_MNsX4sFIlXg&s=19", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MHGS_VS_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2694603, "client_id": 2001308, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26d4b5a6/uploads/origins/ab095dc4-bccb-4ade-a4fe-09e3dc5889a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0eab1c4c067fbee7d576127b4d110cc0", "srcset": "https://si.imgix.net/26d4b5a6/uploads/origins/ab095dc4-bccb-4ade-a4fe-09e3dc5889a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0eab1c4c067fbee7d576127b4d110cc0, https://si.imgix.net/26d4b5a6/uploads/origins/ab095dc4-bccb-4ade-a4fe-09e3dc5889a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e3a58f5a27b83416ae8bb05fd276cc1 2x, https://si.imgix.net/26d4b5a6/uploads/origins/ab095dc4-bccb-4ade-a4fe-09e3dc5889a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4898bf2882479729690a93126073724d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26d4b5a6/uploads/origins/ab095dc4-bccb-4ade-a4fe-09e3dc5889a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1df509eab014f8d678c5e7dbc5b55d62", "srcset": "https://si.imgix.net/26d4b5a6/uploads/origins/ab095dc4-bccb-4ade-a4fe-09e3dc5889a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1df509eab014f8d678c5e7dbc5b55d62, https://si.imgix.net/26d4b5a6/uploads/origins/ab095dc4-bccb-4ade-a4fe-09e3dc5889a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9927cfbefe1e258da459960cc11a69e1 2x, https://si.imgix.net/26d4b5a6/uploads/origins/ab095dc4-bccb-4ade-a4fe-09e3dc5889a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=448151b20caa74ed0c1c4af8999ac1e7 3x"}, "body": "お疲れ様です。有償依頼のご開設ありがとうございます。\n『始まった』な……と思い、真東さんの絵柄で是非見てみたい自作キャラクターが多いため、思い入れを加味して最終的にはダイスで決めました。\n自作キャラクターのカラー絵をお願い致します。トリミングや表情等は全てお任せ致します。小物として少女人形を描いて頂きたいので、白黒ですが人形の資料もお付けしています。\n(ドールのカラー：アイカラー・ヘアカラーはキャラクターと同一、ドレスカラーはくすみピンク、靴やリボンは黒)\n\n身長は164cm(+6cm程度のハイヒール)だった記憶があります。体重に関しては拒食傾向があり、同年代平均と比べるとかなり痩せていますが、服がオーバーサイズ・萌え袖なのでボディラインは誤魔化されています。祖母がロシア人でクォーターであり、色素が薄く日本人離れした容姿が特徴です。生物学的には男性ですが、容姿・声ともに中性域であり、服を着ている状態では判断できません。(性別判断は見る人・会う人の解釈に委ねています)\n特に美形設定ではなく、顔のパーツの配置は整っているものの、やや三白眼ぎみのきついツリ目で、目付きのせいでややキツい印象を与える中性的な顔立ちという設定です。ほぼ常に下がり眉ですが、前髪が厚いためあまり眉は透けず、どの様な場面でも口元が笑っていることが殆どです。後ろ髪はボブのような短い毛＋結び目が帽子に隠れるポニーテールで、毛先の癖が強く、左右対称にふたつに分かれた毛束が天使の翼のようにバラけて内巻きカールしています。\n精神疾患があるため幻覚・幻聴・妄想に日常的に支配されており、癖が強く違和感を感じさせるような言動をします。そのため雰囲気に奇妙さ・本能的に人を何となく気持ち悪くさせる感じがあり、周囲からの印象は悪いです。\n職業はオーダーメイドの人形作家で、遺族からの依頼を受け、遺品や遺物を用いて死者に似せた人形(モーニングドール)を作る事を生業としています。\n「水子供養社」をモチーフにしたキャラクターで、生殖医療・胎児・墓場・弔いなどの話題を小テーマとして用いており、作者もそういう暗喩の描写をする事が多く、わざとホラーっぽさを出すこともあります。\n\n以下、資料のリンクになります。よろしくお願い致します。\n\n※作品内に宛名の記入は不要ですが、もし記入する際は「neo_VXXXIX_」でお願い致します。\n\nhttps://twitter.com/neo_VXXXIX_/status/1646551957925154821?t=TuAz", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": []}, "price_history": {"art": [{"amount": 12000, "recorded_at": 1779885475.333844}, {"amount": 21000, "recorded_at": 1781271851.012681}], "novel": [{"amount": 6000, "recorded_at": 1779885475.333844}, {"amount": 3000, "recorded_at": 1781271851.012681}], "correction": [{"amount": 2000, "recorded_at": 1779885475.333844}]}, "custom": {}}