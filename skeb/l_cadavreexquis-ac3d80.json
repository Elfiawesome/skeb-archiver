w": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@l_cadavreexquis/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2001308, "client_id": 1162253, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1852c1a/uploads/origins/6b9507cd-6b6e-472c-8fd9-5ad587e4540b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0ad8e64136fbf1b5c80d7ed1072fb27", "srcset": "https://si.imgix.net/d1852c1a/uploads/origins/6b9507cd-6b6e-472c-8fd9-5ad587e4540b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0ad8e64136fbf1b5c80d7ed1072fb27, https://si.imgix.net/d1852c1a/uploads/origins/6b9507cd-6b6e-472c-8fd9-5ad587e4540b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5cafe45cbb86537d2829183580fb557b 2x, https://si.imgix.net/d1852c1a/uploads/origins/6b9507cd-6b6e-472c-8fd9-5ad587e4540b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56f398905462776fa9581fbabe075e74 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1852c1a/uploads/origins/6b9507cd-6b6e-472c-8fd9-5ad587e4540b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=920734d2a4337ffcfcba7820612bd08f", "srcset": "https://si.imgix.net/d1852c1a/uploads/origins/6b9507cd-6b6e-472c-8fd9-5ad587e4540b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=920734d2a4337ffcfcba7820612bd08f, https://si.imgix.net/d1852c1a/uploads/origins/6b9507cd-6b6e-472c-8fd9-5ad587e4540b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eacd66b66e299276400cc855ea2ffa2a 2x, https://si.imgix.net/d1852c1a/uploads/origins/6b9507cd-6b6e-472c-8fd9-5ad587e4540b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1c3a064fd6e06f2b3d7f2d42c1f1babf 3x"}, "body": "偶然様\nお世話になっております。\nすのものと申します。\n\nこの度は自分の作成したTRPGキャラクターの立ち絵の作成をしていただきたく、依頼に参りました。\n\n【依頼内容】\n希望の内容は、全身立ち絵一枚です。\nキャラクターのモチーフとしては、「夜警」「バレリーナ」「星（エトワール）」「見張る者」などを意識しています。\nこれらの要素は、偶然様の使いやすいものを適宜取捨選択していただければと思います。\n資料として、キャラクターシートと、シナリオ概要のURLを添付させていただきます。自作のデザインのラフ等は用意することができなかったため（単純に思いつかず…）申し訳ありませんが、デザインの全体を偶然様にお任せしたいと考えております。\n\n【資料】\nhttps://charaeno.com/6th/n_Jeg-_ycb-T6bpIBU6t0\nhttps://booth.pm/ja/items/1758940\n\n以前にも偶然様に依頼をさせていただきましたが、依頼した後にこのPCも偶然様の絵で見たいんだった…！ということを思い出したため、追って依頼をさせていただきました。しかし、このような形で重ねて依頼をするのは、偶然様への負担も大きいのではないかという思いもあります。ですので、もしも偶然様が依頼を受けることが難しいようであれば、このリクエストは遠慮なくキャンセルしていただきたいと思います。\n非常に暑い日が続きますが、お体にお気をつけてお過ごしください。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@l_cadavreexquis/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2001308, "client_id": 2821606, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ffd0b6a/uploads/origins/7f72eca6-e93e-4de0-93af-2bac5a2dad5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97a9192227481ee9894851fc483048b7", "srcset": "https://si.imgix.net/3ffd0b6a/uploads/origins/7f72eca6-e93e-4de0-93af-2bac5a2dad5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97a9192227481ee9894851fc483048b7, https://si.imgix.net/3ffd0b6a/uploads/origins/7f72eca6-e93e-4de0-93af-2bac5a2dad5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4b75d9be08685c70f67b35cca9ee7f2 2x, https://si.imgix.net/3ffd0b6a/uploads/origins/7f72eca6-e93e-4de0-93af-2bac5a2dad5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb812ade01b08d32c4a55acc90431366 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ffd0b6a/uploads/origins/7f72eca6-e93e-4de0-93af-2bac5a2dad5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74d11607716fa6ed885f6c65ce283298", "srcset": "https://si.imgix.net/3ffd0b6a/uploads/origins/7f72eca6-e93e-4de0-93af-2bac5a2dad5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74d11607716fa6ed885f6c65ce283298, https://si.imgix.net/3ffd0b6a/uploads/origins/7f72eca6-e93e-4de0-93af-2bac5a2dad5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=14cd6533e38a81d792fabd8be536792a 2x, https://si.imgix.net/3ffd0b6a/uploads/origins/7f72eca6-e93e-4de0-93af-2bac5a2dad5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b038db36720d16308ffbd2bf8e01a296 3x"}, "body": "偶然さんこんにちは。Twitterで少しお話しさせていただいことがあります、ほずみれいと申します。\n実は偶然さんのことはフォローさせていただくかなり前から一方的に存じ上げていて、ずっと作品が大好きでした。私事ですが、この度オリジナルキャラクターを用いた活動を行うことになったので、偶然さんのお力添えをいただけないかと思い、ご連絡させていだきました。\n\n【描いていただきたいもの】\n・既存ちびキャラを元にした高等身イラストの作成\n・既存のキャラを元にした衣装や装飾のデザインの追加\n\n【お願いしたい内容】\nSDキャラを高等身（偶然さんが過去の案件で作成されたくらいのもの）に書き起こし、もともと着ている服を踏まえつつ、細かな装飾や服飾デザインをご作成いただき、立ち絵を描いていただきたいです。普通は高解像度の高等身立ち絵を元にデフォルメ絵を作成することが多いと思うのですが、今回お願いしたいのはその全く逆の作業となります。\n元となるキャラクターの画像は下記のURLに添付させていただきました。性別は無です（一応中の人間は女性ですが、胸やいわゆる体の膨らみ的なものは一才想定しておりません）。長い三つ編みが特徴で、衣装デザインは「中性的」「いわゆるVtuberが着ていそうな近未来的な服」「リボンや編みブーツなどのクラシカルな服」を同居させたものとなっております。SDキャラは書き込みも少なくシンプルな状態ですので、偶然さんのイメージや感性で衣装のディテールや装飾品を足していただけたら幸いです。\n\n【避けていただきたい要素】\n元のキャラクターも作成いただいたものなので、それを大きく損なうもの（身体欠損や全く違う髪型にするなど）\n\n【参考までの設定（無視していただいても大丈夫です）】\n・ヘッドフォンを装着していますが、耳にはピアスをたくさんつけている設定です。具体的にはキャラにとって左耳に５つ、右耳に３つです\n・白いポメラニアンを同伴しております(APPは18億です)\n・儚さはあまりないですが、ドヤ顔とミステリアスチャーミング微笑みができるキャラです\n\n【体裁・形式など】\nキャラクターデザイン画と立ち絵を作成していただけたら嬉しいです（一枚の作品で両方を兼ねていても大丈夫です）\n線や塗りのスタイル、デザイン等は全て偶然さんのセンスにお任せいたします。\n\n【使徒】\n・SNS（主にツイッターを想定しております）への投稿\n・今後わたくしや（もしいれば）FAを描いてくださる方が当該キャラクターを描く際に参照する、元絵的役割を担っていただけたらなと思っております\n・未定ですが、顔部分などをトリミングしてSNSのアイコンにしようさせていただけたら嬉しいです\n\n【当方が行わないこと】\n・アイコン使用などのトリミングを除く加筆・加工行為\n・自作発言、二次配布、他者への再投稿許可\n\n【ご迷惑でなければさせていただきたいこと】\n・活動時にクレジットとしてお名前を記載させていただきたいです\n\n長々と書いてしまいすみません。\nお忙しいことも、CSを抱えていらっしゃることも存じ上げておりますし、お願いしたい内容が少々特殊であることも承知しております。ご無理でしたらお断りいただいて全然大丈夫です。\nただ、服飾的なデザインにおいて偶然さんの右に出る者はいないと思っており、どうしても我慢できず無理を承知でお願いにあがりました。\nこの場をお借りしてカミングアウトすると、実はかなり前から（具体的にはアドニスより前、刀剣を描かれていた頃よりもアリス展に出ていらっしゃった頃よりも前です）、こっそりご作品を拝見していたもので、アカウントを削除されてしまうたびに悲しみつつも、しばらくしてはついうっかりちゃっかり移転先を見つけてしまい、長い間拝見しておりました…すみません\n（書いてみたら本当にストーカーみたいで気持ち悪いなと自覚したのですが、検索してはこっそり拝見するだけの、フォローする勇気すらない無害なROMだったのでお許しください…）（気持ち悪かったらブロックしてください…書いてみたら我ながら本当にキモかったです）\nこんなホラーなことを打ち明けたのも、本当に偶然さんにイラストが好きだということをお伝えしたかったからなのですが、もしお受けいただけたら本当に嬉しいです。\nご検討いただければ幸いです、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1KoQvI-xdtSwhtE3nvVgiSguTWobIq3Gv?usp=sharing", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@l_cadavreexquis/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2001308, "client_id": 1162253, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28bf62d0/uploads/origins/5e66376b-ff7b-4439-85f9-cc321c76e8e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1204acb7bbf03dddbd592c7a1dadef9", "srcset": "https://si.imgix.net/28bf62d0/uploads/origins/5e66376b-ff7b-4439-85f9-cc321c76e8e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1204acb7bbf03dddbd592c7a1dadef9, https://si.imgix.net/28bf62d0/uploads/origins/5e66376b-ff7b-4439-85f9-cc321c76e8e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b0d39ffd834532b8ee169a4263a252b 2x, https://si.imgix.net/28bf62d0/uploads/origins/5e66376b-ff7b-4439-85f9-cc321c76e8e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cac2b092c5587a749b346c627dcc4eef 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28bf62d0/uploads/origins/5e66376b-ff7b-4439-85f9-cc321c76e8e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ed06f9ec2a7032fc844f578cf0555c3", "srcset": "https://si.imgix.net/28bf62d0/uploads/origins/5e66376b-ff7b-4439-85f9-cc321c76e8e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ed06f9ec2a7032fc844f578cf0555c3, https://si.imgix.net/28bf62d0/uploads/origins/5e66376b-ff7b-4439-85f9-cc321c76e8e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=66b5708117b8fc9565cef588a3e9ac11 2x, https://si.imgix.net/28bf62d0/uploads/origins/5e66376b-ff7b-4439-85f9-cc321c76e8e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2062d076b80b80d33d47b92140755a5d 3x"}, "body": "偶然様\nお世話になっております。\nすのものと申します。\n\nこの度は自分の作成したTRPGキャラクターの立ち絵の作成をしていただきたく、依頼に参りました。\nもしこちらの思い違いで、そもそも立ち絵の依頼は受け付けていない場合は、依頼をキャンセルしていただくか、依頼を衣装デザインのみに変更していただければと思います。\n\n【依頼内容】\n希望の内容は、全身立ち絵一枚と、可能でしたら髪を下ろした差分をお願いしたいと思っております。\n衣装デザインの希望としては、「モノトーンカラーベース」「華美で装飾的なシャツ」「露出の多いパンツスタイル」「攻撃的な高さのヒール」を基本にしていただけると嬉しいです。\nまた、キャラクターのモチーフとしては、「ピエロ」「人形」「鏡」などを意識しています。\nこれらの要素は、偶然様の使いやすいものを適宜取捨選択していただければと思います。\n資料として、キャラクターシートと、自分の作成したイラストを添付させていただきます。\n差分については必須ではなく、余裕があればお願い出来ればと思います。\n\n【資料】\nhttps://charasheet.vampire-blood.net/ma9d4e65af1b46fc45e4802183e5ba9ae\nhttps://www.dropbox.com/sh/kgw06yq42k4ionc/AABUZJwyePBUPOuLWgMoKSz1a?dl=0\n\nかねてより偶然様の繊細な衣装デザインと涼やかな美形の描き方が好きで、この人の絵で頭のおかしい美形の女が…見たい！という気持ちがあり、こうして依頼をさせていただきました。\n直近で使用する予定の立ち絵ではないため、お手隙の際にゆっくり制作をしていただければと思います。\nご都合がよさそうであれば、何卒よろしくお願いいたします。\nこれからは暑い季節になりますので、お体に気を付けてお過ごしください。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@l_cadavreexquis/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2001308, "client_id": 14504, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2633a911/uploads/origins/90b98d2f-1ca2-44d6-9d96-fdff2a5df404?bg=%23fff&auto=for