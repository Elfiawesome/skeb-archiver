217-927a-edfcca975d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=210a469d8c51a82f21bd4dc02def9ad7 2x, https://si.imgix.net/29b43c10/uploads/origins/ab89ca14-8763-4217-927a-edfcca975d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b44e920d1b27eed361604229dc90c3a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29b43c10/uploads/origins/ab89ca14-8763-4217-927a-edfcca975d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c5d0d6f83696b0477fdcea87e0329c5", "srcset": "https://si.imgix.net/29b43c10/uploads/origins/ab89ca14-8763-4217-927a-edfcca975d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c5d0d6f83696b0477fdcea87e0329c5, https://si.imgix.net/29b43c10/uploads/origins/ab89ca14-8763-4217-927a-edfcca975d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e857d2bded141543cb787a6031d58701 2x, https://si.imgix.net/29b43c10/uploads/origins/ab89ca14-8763-4217-927a-edfcca975d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a761ce4f3c094f46590a077c99c76e7c 3x"}, "body": "キャラクター\n艦これ\n伊26\n\n開脚状態で粘液に両手を拘束された無知な伊26に以前描いていた寄生生物が襲うイラスト\n\n①\n寄生生物が水着の上から26の膣に張り付く\n伊26\n不思議そうな表情\nおマ○コに興味があるの？といった台詞\n②\n水着の中に侵入した寄生生物が膣周りに張り付き性器を出し入れ\n伊26は快感を感じつつ困惑\n表情\n片目を閉じ、快感で赤面で困った表情\n何してるの？といった台詞\n③\n寄生生物に中出しされ卵と精液を膣周りが精液だらけになる程排出(断面図有\n伊26\n目がハート、目線が若干上で口を開き\nお腹に何か出てるといった台詞\n\n服装は通常水着\nアングル　正面、若しくは描きやすいもの\n\n以下は可能であればお願いします\n④\n産まれた寄生生物達に胸を吸われつつ膣に張り付いている寄生生物と高速ピストン交尾し続けている\n伊26\n笑顔\n拘束が解除され左手で胸を揉み右手で寄生生物を股間に押し付ける\n中出しを懇願する台詞\n⑤\n寄生生物に再度卵と精液を中出しされつつ絶頂し寄生生物を出産し、水着内が寄生生物で溢れる\n伊26\n目がハート、口を開いた表情\n絶頂の台詞\n\n\nよろしくお願いします\n\nhttps://blog-imgs-112-origin.fc2.com/k/c/w/kcwiki/No283_0_CD.jpg", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@synindx_73train/works/3