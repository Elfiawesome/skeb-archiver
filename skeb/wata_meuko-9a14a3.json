b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71bd590aaf06a958a599494a1bc9fae0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/981ad9cb/uploads/origins/1cdc6aff-a179-4edf-9f6c-280bf74baa1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=486c26de6369e8999913f2b7dcaf20a5", "srcset": "https://si.imgix.net/981ad9cb/uploads/origins/1cdc6aff-a179-4edf-9f6c-280bf74baa1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=486c26de6369e8999913f2b7dcaf20a5, https://si.imgix.net/981ad9cb/uploads/origins/1cdc6aff-a179-4edf-9f6c-280bf74baa1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc355146494d5349f45c7860e3d2658e 2x, https://si.imgix.net/981ad9cb/uploads/origins/1cdc6aff-a179-4edf-9f6c-280bf74baa1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0ab609b37b8893785e5d8504961aea9f 3x"}, "body": "わた めうこ様\n初めまして。IRIAMで活動中の黒原凛音と申します。\nめうこ様のイラストがとても好きで、一枚絵をお願いしたくご連絡を差し上げました。\n立ち絵については下記に投稿しておりますのでご査収ください。\nhttps://twitter.com/666_rinne/status/1637106982250504193?s=20\n\nイラストの雰囲気：パステル＋病んでいる系\n服装：現状のままでも構いませんが、地雷系の服装に変えていただいても結構です。\n使用用途：IRIAMのサムネイルでの使用、SNSでの使用、商用利用\n希望：背景を描いていただける場合、背景なしの透過データをいただけますと幸いです。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wata_meuko/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2212440, "client_id": 1983336, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c365949/uploads/origins/30d24223-a3aa-426e-8fb8-8cc91b4b4538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d155f7132bbedc25712fbdc623f82251", "srcset": "https://si.imgix.net/2c365949/uploads/origins/30d24223-a3aa-426e-8fb8-8cc91b4b4538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d155f7132bbedc25712fbdc623f82251, https://si.imgix.net/2c365949/uploads/origins/30d24223-a3aa-426e-8fb8-8cc91b4b4538?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22ca66e5e370bb5e2f6b35a36a2325fc 2x, https://si.imgix.net/2c365949/uploads/origins/30d24223-a3aa-426e-8fb8-8cc91b4b4538?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92388859b0fea668459405f8a4059174 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c365949/uploads/origins/30d24223-a3aa-426e-8fb8-8cc91b4b4538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb8a8e214f80e685c836adb32216d873", "srcset": "https://si.imgix.net/2c365949/uploads/origins/30d24223-a3aa-426e-8fb8-8cc91b4b4538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb8a8e214f80e685c836adb32216d873, https://si.imgix.net/2c365949/uploads/origins/30d24223-a3aa-426e-8fb8-8cc91b4b4538?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8a835d62f41bf5cb5d377801e60d2f17 2x, https://si.imgix.net/2c365949/uploads/origins/30d24223-a3aa-426e-8fb8-8cc91b4b4538?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=25d1eec645cbbf47ba862a5789ffac27 3x"}, "body": "わた めうこ様、はじめまして。\n個人Vtuberの桜音エリカと申します。\n突然のご連絡失礼いたします。\n\nわた めうこ様のピンクの悪魔ちゃんをTwitterで拝見して一目惚れしてしまいました…！\nお顔と表情の可愛らしさ、お衣装のデザインが本当に心にダイレクトに刺さってメロメロになってしまいました。大好きです！\n\nこの度はわた めうこ様の表現される桜音エリカが見てみたいという思いでskebをリクエストさせていただきました。\n以下、希望内容でございます。ご査収くださいませ。\n\n・リクエスト概要、形式\n 桜音エリカをメインとしたイラストの作成をお願いしたく存じます。\n 人物と(追加いただけるようでしたら)背景を別レイヤーでPSD形式で頂けますと助かります。\n\n・使用目的(別レイヤーで可能な範囲をご記載いただけますと幸いです)\nTwitterやYoutubeのサムネイル、配信画面への使用\n個人鑑賞用のグッズの制作\n壁紙などFANBOXでの特典への使用\n作品を使用したグッズの販売(アクリルキーホルダーや缶バッジ、ステッカーなど)\n\n・キャラクター概要\n桜音エリカは注射器と包帯をトレードマークにした、メンヘラぶりっこ構ってちゃん系Vtuberです。\n髪の毛は腰ほどの長さで、ハーフツインに結い、ピンクのリボンを編み込んでいます。\n立ち絵ですとぺったんこですが、お胸のサイズは参考URLのナース服くらいにしていただけましたら幸いです。\n\n・希望詳細\n衣装やポーズ、構図はわた めうこ様にお任せさせていただいてもよろしいでしょうか。\nYoutubeにてASMRをメインに活動しておりますので、添い寝などのシチュエーションにしていただけましたらうれしいです。\n可能であれば表情差分をご検討いただけますでしょうか。\nわがままで申し訳ございません…！\n\n\n・参考資料\n立ち絵とバストアップイラスト\nhttps://twitter.com/elika_oo/status/1560922059609239553?s=21\n\n動き、声のサンプル\nhttps://twitter.com/elika_oo/status/1497920108768817153?s=21&t=lGK_z-PNn_fAjlC_BqliyQ\n\n何卒、よろしくお願い申し上げます。\n\nhttps://twitter.com/elika_\n\nhttps://twitter.com/elika_oo/status/1574390226851491841?s=21&t=3E363DbKGR0-wcRFF70nYQ", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wata_meuko/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2212440, "client_id": 1283175, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22d4605b/uploads/origins/9b07ad34-b4cb-43b1-bc64-4e424da0cfae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51e7cce72b2177a3b4ef687e88ba1a9d", "srcset": "https://si.imgix.net/22d4605b/uploads/origins/9b07ad34-b4cb-43b1-bc64-4e424da0cfae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51e7cce72b2177a3b4ef687e88ba1a9d, https://si.imgix.net/22d4605b/uploads/origins/9b07ad34-b4cb-43b1-bc64-4e424da0cfae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f832fb3c3ff4c65859ee5be2558c98fe 2x, https://si.imgix.net/22d4605b/uploads/origins/9b07ad34-b4cb-43b1-bc64-4e424da0cfae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=671f85767bfcd20ccfe2a59ea389aa99 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22d4605b/uploads/origins/9b07ad34-b4cb-43b1-bc64-4e424da0cfae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04cfd1fca2567c7d51a224b0194f3cb1", "srcset": "https://si.imgix.net/22d4605b/uploads/origins/9b07ad34-b4cb-43b1-bc6