97dbf25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b29af918563599de409640c362e4c4af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3016d11e/uploads/origins/29420027-f3bc-425b-9eb8-b4ec097dbf25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7faccd5e9ce82ed53b8a275735b19e1d", "srcset": "https://si.imgix.net/3016d11e/uploads/origins/29420027-f3bc-425b-9eb8-b4ec097dbf25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7faccd5e9ce82ed53b8a275735b19e1d, https://si.imgix.net/3016d11e/uploads/origins/29420027-f3bc-425b-9eb8-b4ec097dbf25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f4fa032cb389dea3e4f760c1a538ee95 2x, https://si.imgix.net/3016d11e/uploads/origins/29420027-f3bc-425b-9eb8-b4ec097dbf25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd1994a855675fefc21631b0823cf622 3x"}, "body": "先生 こんにちは！私はあなたの作品がとても好きです。ぜひ私のオリジナルキャラクター、清悠（KIYU）を描いていただけませんか。\n\n清悠は、無口で少しツンデレな可愛い女の子です。彼女のキャラクター背景に基づいて、一枚のイラストを描いてほしいです。必ず手にしている「赤い糸」の要素を加えてください。\n注意点：彼女の髪の色は白ですが、影の部分は緑色で処理してもらえると嬉しいです。\n\n背景ストーリー：清悠が最初に訪れた時空で、彼女は亡くした大切な人々と再会する。この時空では、彼女も彼らも魔法学院の学生であり、元の世界とはまったく異なる。しかし、失っていたものを再び手に入れた喜びが清悠の理性を曇らせ、彼女はこの虚ろな夢に酔いしれる。毎日、幸せな学園生活を繰り返すうちに、自分がなぜこの時空に来たのかさえ忘れていく。\n\n彼女の手にある赤い糸は、親しい人々の感情を感知することができる。そして、その感情が大きく揺れ動くと、赤い糸は震え出す。\n\nだが、ある日、神罰が降り注ぐ。植物は枯れ果て、蝶のような正体不明の生物が人間の肉を引き裂き食らう。しかし、なぜか清悠だけは影響を受けない。魔法で必死に抵抗するが、無力だった。見慣れた顔が次々と歪み、爆ぜる。赤い糸は親友たちの苦しみを感じて激しく震え、その震えのために武器すら持てない。彼女にできることは何もなかった。\n\nすべての者の息が絶えたことを確認した後、清悠は魔法陣を発動し、この時空を去る。\n\n以下、リンクです\nhttps://drive.google.com/drive/folders/1m5-BSncHucxzFDtsPyNxXEnv1OtMjRAO", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oniku_0831_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id":