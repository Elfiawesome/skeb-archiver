x.net/5921ab93/uploads/origins/5f7ec139-56d5-4ad9-a8a1-e93aaee9dd67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5e503b668c4e2ccabceafdd0384825e 2x, https://si.imgix.net/5921ab93/uploads/origins/5f7ec139-56d5-4ad9-a8a1-e93aaee9dd67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29533f68d9cae7867051d7d1db8cbc26 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5921ab93/uploads/origins/5f7ec139-56d5-4ad9-a8a1-e93aaee9dd67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9db385701d2b2021bbc4c877e87a635", "srcset": "https://si.imgix.net/5921ab93/uploads/origins/5f7ec139-56d5-4ad9-a8a1-e93aaee9dd67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9db385701d2b2021bbc4c877e87a635, https://si.imgix.net/5921ab93/uploads/origins/5f7ec139-56d5-4ad9-a8a1-e93aaee9dd67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2f25da165aec09bfd8188671db0c494d 2x, https://si.imgix.net/5921ab93/uploads/origins/5f7ec139-56d5-4ad9-a8a1-e93aaee9dd67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f762d1c06a05cf95715bcd255b943e13 3x"}, "body": "9さま\n初めまして。9さまの素敵なイラストや漫画をXで拝見しております！Skebを開設したとのことで、この度はTRPGのうちよそ漫画を描いていただきたく依頼しました。\nお相手からは許可をいただいております。\n\n▼以下詳細になります。シナリオ等のネタバレはありません。\nhttps://drive.google.com/drive/folders/1_P5FWMR4sUoOyg8AM9LyV_8_z_F7TsiS\n\n▼関係について\n勤勉で内向的な探偵と献身的で謎の多い探偵助手。\n田舎町の山奥に事務所を構えています。\nお互いに相手のことを唯一の相手だと思っており、恋愛感情や友情では言い表せない不思議な関係です。\n\n◆探偵\n髪／黒髪\n瞳／緑\n31歳。193cm。探偵。\n勤勉で穏やかな性格だが、少し内向的で人と関わる際は常に腰が低い男性。\nアナログ生活を好み、古書や骨董品が好き。\nヘタレでたじたじになりがちだが、ふとしたときに試すような物言いをすることがある。\n白雪に対して頭が上がらないものの、唯一の助手であり大事な存在だと思っている。\n\n一人称「僕」\n相手の呼称「白雪くん/君」\n\n\n◆探偵助手\n髪／白髪\n瞳／青\n自称23歳。163cm。探偵助手。\n何を考えているのか分からない、常に笑みをたたえた女性。\n誰にでも献身的で協力も惜しまないが、独特な佇まいからか、初見では話しかけづらい印象がある。あたたかい日差しの差す、静かな場所で昼寝をしたり、読書をするのが好き。\n降水に対して可愛らしく、放っておけない存在だと思っている。常にそばで支えになりたい。\n押しにはちょっと弱い。\n\n一人称「私」\n相手の呼称「先生/あなた」\n\nシチュエーションや衣装等はぜひお好きなように描いてくださると嬉しいです。\n\n描いて頂いた作品は個人的に鑑賞用として印刷する場合があります。商用利用は一切いたしません。\n\n■\n\n長々と失礼いたしました。\nスケジュールやリクエスト内容が金額に沿わないなど難しい点がありましたら再送申請またはキャンセルして頂いて構いません。\n\nご検討の程宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1_P5FWMR4sUoOyg8AM9LyV_8_z_F7TsiS", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1151334, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "🍂", "screen_name": "X10Dareda", "avatar_url": "https://pbs.twimg.com/profile_images/1030907337727344640/-NcsjNUD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1030516734908715008/1702572930/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "nc": 1}, {"id": 2561461, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "檜宮しょう", "screen_name": "Ly05YY", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Ffc3ff1e2-1304-4225-b463-df87c2a5f26c.png?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/webpublic-8c000a79-c9e6-4826-aec8-7a08652fca3c.png", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 32}, {"id": 2900502, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ちむちむ", "screen_name": "tim99292", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-c9444272-9f46-4f8a-bf16-5a387f5f3479.web