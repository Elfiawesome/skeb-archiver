すがもし良ければどうかよろしくお願いします。\n\nhttps://drive.google.com/file/d/18zVVM8xnsFSf0t012-RRl7iHagMlOZF6/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nimanokiichigo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1371345, "client_id": 345289, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3afbe09c/uploads/origins/31b0bfa6-f325-4f38-9136-55dcdf4dc817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e160391b9b1859f5f96812943a58c74e", "srcset": "https://si.imgix.net/3afbe09c/uploads/origins/31b0bfa6-f325-4f38-9136-55dcdf4dc817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e160391b9b1859f5f96812943a58c74e, https://si.imgix.net/3afbe09c/uploads/origins/31b0bfa6-f325-4f38-9136-55dcdf4dc817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e4c162d693cbf68dbf593cc7e884437 2x, https://si.imgix.net/3afbe09c/uploads/origins/31b0bfa6-f325-4f38-9136-55dcdf4dc817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e55fa859209f6464d9dd9fc5d463146 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3afbe09c/uploads/origins/31b0bfa6-f325-4f38-9136-55dcdf4dc817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e979ea4dad0cf75749810bc0bf7cc6d", "srcset": "https://si.imgix.net/3afbe09c/uploads/origins/31b0bfa6-f325-4f38-9136-55dcdf4dc817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e979ea4dad0cf75749810bc0bf7cc6d, https://si.imgix.net/3afbe09c/uploads/origins/31b0bfa6-f325-4f38-9136-55dcdf4dc817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5ff74b8096a3032fe0eee5eb992d442 2x, https://si.imgix.net/3afbe09c/uploads/origins/31b0bfa6-f325-4f38-9136-55dcdf4dc817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5ec8ea21c9d0099025597981eca9c909 3x"}, "body": "初めまして\n青咲花星様が描かれるイラストがとても素敵だと思いリクエストさせていただきました。\n依頼内容なのですが私のOCがシャボン玉で遊んでいるという内容でお願いします。\n詳細なのですが\n・吹き棒で大きなシャボン玉を膨らませている\n・周りにもシャボン玉がふわふわと浮かんでいる\n・白いワンピースを着ている\n・可能であればもう片方の手に大きな輪っかを持ってシャボン玉を作っている\nそれ以外の細かな点などは青咲花星様のご判断に一任致しますのでどうかご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1Ylx4pTOFKD7WkxJA_9M9xBpd68wP4iTA", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@primula108/works/129", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2185812, "client_id": 1371345, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e81dc547/uploads/origins/efdb75e2-4149-4c5d-92da-62ed1e7512b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6693b4903f22e866e8aea0839c4122e", "srcset": "https://si.imgix.net/e81dc547/uploads/origins/efdb75e2-4149-4c5d-92da-62ed1e7512b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6693b4903f22e866e8aea0839c4122e, https://si.imgix.net/e81dc547/uploads/origins/efdb75e2-4149-4c5d-92da-62ed1e7512b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27b21eff7734f8d754d3e7e810df310a 2x, https://si.imgix.net/e81dc547/uploads/origins/efdb75e2-4149-4c5d-92da-62ed1e7512b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e39277e277484cf6d8f50ab3b254a727 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e81dc547/uploads/origins/efdb75e2-4149-4c5d-92da-62ed1e7512b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fdb4613709f5ab1c2837fc1283f5a25", "srcset": "https://si.imgix.net/e81dc547/uploads/origins/efdb75e2-4149-4c5d-92da-62ed1e7512b6?bg=%23fff&auto=format%2Ccompre