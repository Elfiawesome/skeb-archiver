rd_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mochiba_hachi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3396618, "client_id": 1202629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fc1104a/uploads/origins/a885a2f9-038e-4b6c-9ad8-8bdc538dd8b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=749731113f7c36ac3985bc400950e1e8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6fc1104a/uploads/origins/a885a2f9-038e-4b6c-9ad8-8bdc538dd8b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=241a6ef1027ca5992ddf55390d4c0d1e", "src_set": ""}, "body": "初めまして。よろしければリクエストお願いします。\nTS魔法少女なおよりスレイブイグニスでシチュエーションは四つん這いの状態でフレアに自身の唾液を飲ませるシチュをお願いします。\n\n詳細\n・構図は資料のようなイグニスのみが描かれている感じで。\n・指先まで描かれている感じでお願いします。表情は悪そうな妖絶な感じで。\n・セリフもよろしければお願いします。フレアに言葉攻めしつつ唾液を飲むよう命令する感じで。\n\n可能であれば口を閉じているバージョンとマスカレイド差分もお願いします。\n\nhttps://drive.google.com/drive/folders/1unkicva9rMQmFDIOJrpZqiTeeCWnQY2_?usp=drive_link", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mochiba_hachi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3396618, "client_id": 75331, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ef5c072/uploads/origins/6167006c-f6f1-4a61-b2af-0ba9b38ae643?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f32d23d0b68525a7a1c68fc16240b44", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ef5c072/uploads/origins/6167006c-f6f1-4a61-b2af-0ba9b38ae643?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4482172e25253c0d2af64a890a1e4dda", "src_set": ""}, "body": "餅場はち