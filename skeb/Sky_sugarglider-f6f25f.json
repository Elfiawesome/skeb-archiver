ider/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3770997, "client_id": 3286154, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88e2408f/uploads/origins/33e18ae6-6b8f-44c0-8bde-011b3b847e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1295bda8e1628e7fa26d87cfcc5d3275", "srcset": "https://si.imgix.net/88e2408f/uploads/origins/33e18ae6-6b8f-44c0-8bde-011b3b847e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1295bda8e1628e7fa26d87cfcc5d3275, https://si.imgix.net/88e2408f/uploads/origins/33e18ae6-6b8f-44c0-8bde-011b3b847e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a28dcc626a5c97e28ee48ffeead1638c 2x, https://si.imgix.net/88e2408f/uploads/origins/33e18ae6-6b8f-44c0-8bde-011b3b847e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4aee56f1bca27e83b697a93fd259f4df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88e2408f/uploads/origins/33e18ae6-6b8f-44c0-8bde-011b3b847e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66a55dbb0029b4135000050f34812800", "srcset": "https://si.imgix.net/88e2408f/uploads/origins/33e18ae6-6b8f-44c0-8bde-011b3b847e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66a55dbb0029b4135000050f34812800, https://si.imgix.net/88e2408f/uploads/origins/33e18ae6-6b8f-44c0-8bde-011b3b847e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=02da3001ddc3e0db71de1c895c71e370 2x, https://si.imgix.net/88e2408f/uploads/origins/33e18ae6-6b8f-44c0-8bde-011b3b847e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=67d7c83a472430d1cb39943f10f72487 3x"}, "body": "こんにちは！私のオリジナルキャラクター（OC）のイラストをお願いしたいです。彼はマフィアの一員で、プレイボーイのような、いたずら好きでクールな性格です。\n\nベッドで朝目覚めたところを描いてほしいです。メガネを外した、温かみがあり、居心地が良く、官能的な雰囲気のイラストをお願いします ^.^\n\n忘れずに描いてほしいディテール：右目の下にほくろがあります（参考画像では左側）。背が高くスリムですが、格闘家なので筋肉はついています。\n\n武器は描いても描かなくてもどちらでも構いません :)\n\nhttps://drive.google.com/drive/folders/1JRSHcPOkwGP2zIvznOYH_aWUEM8zJPLM", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sky_sugarglider/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3770997, "client_id": 3862660, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c10fd81/uploads/origins/edfcaa60-65d5-436f-a8d0-f2b5d167025f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=970aec01ac53ebbfd915f2133ec51d04", "srcset": "https://si.imgix.net/1c10fd81/uploads/origins/edfcaa60-65d5-436f-a8d0-f2b5d167025f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=970aec01ac53ebbfd915f2133ec51d04, https://si.imgix.net/1c10fd81/uploads/origins/edfcaa60-65d5-436f-a8d0-f2b5d167025f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f0b3aec84b3dbb61ef1b87a3432ee3b 2x, https://si.imgix.net/1c10fd81/uploads/origins/edfcaa60-65d5-436f-a8d0-f2b5d167025f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=405a2b2b331bf024f7fe7b1194f9dea8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c10fd81/uploads/origins/edfcaa60-65d5-436f-a8d0-f2b5d167025f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf152cadcc3cdafd0d814ff7a047919a", "srcset": "https://si.imgix.net/1c10fd81/uploads/origins/edfcaa60-65d5-436f-a8d0-f2b5d167025f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf152cadcc3cdafd0d814ff7a047919a, https://si.imgix.net/1c10fd81/uploads/origins/edfcaa60-65d5-436f-a8d0-f2b5d167025f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=24ef359ac6b91cbe3d521a3512015f44 2x, https://si.imgix.net/1c10fd81/uploads/origins/edfcaa60-65d5-436f-a8d0-f2b5d167025f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d207cdba817c4d51e69a2f953ab81035 3x"}, "body": "星屑様、初めまして!\nXで拝見したあなたのイラストに、一目で心を奪われました。リクエスト失礼いたします…！\nこれは私のオリジナルキャラクター「离帆」です\n資料 URL に画像を添付したので参考にして下さい。\n年齢・身長： 21歳、身長171cm\n· 基本設定： 非常に聡明で、華奢かつ病弱な青年。長生きできるとは思っておらず、病院で常時療養生活中。\n· 身分・特技： ゲーム実況者。学業成績もゲームの腕前も超一流ですが、ゲームスタイルは「千を討ち、八百を失う」ような、自らにもリスクを厭わない攻撃型です。\n· 外見：\n  · 黒褐色の肩まで届く長さの髪で、かろうじて結べる程度。\n  · 血のように赤い瞳\n  ·  特徴： 左目に涙ぼくろがあり！！鋭い美貌で、少し女性的な印象を受ける\n· 性格：表面上は優しい隣のお兄さん風だが、実際は腹黒く毒舌な「笑面虎」。非常に神秘的な雰囲気を持ち、まるで風が吹けば消えてしまいそうな儚さがあります。\n· 服装： グレーの半袖シャツに、青藍色のブロックが拼接された白いジャケットを、いつもだらりと羽織っている\n· 嗜好・習慣：\n· 暑さに弱い。\n·  甘い物と激辛料理が大好き（医師の指示には全く従わない）\n  · 公園でジグソーパズルをするのが好き。\n  · 瀬戸物のように扱われることを嫌う。\n象徴アイテム：\n· 紙の舟\n· ルビー（赤い宝石）\n· ザクロ\n· ルコウソウ\n· チェスの駒（特に「クイーン」か「ナイト」）\nその他：\n  · 少年時代に交通事故で亡くした男性の恋人（幼馴染）がいる。\n  · その恋人との関係では、その恋人との関係では、受け側であり、相手の前では意外にも柔らかく、わがままになり、甘えん坊になる一面があった。\n可能であればすべてお任せでお願いしたく思います。構図やポーズ等 任せたいです!衣装も自由にアレンジしていただいても構いません\n長文をここまで読んで頂き、ありがとうございました。\n何卒ご検討いただければと思います!\n\nhttps://drive.google.com/drive/folders/1ZTolazmdWUv63FndOr1XcBPxMvImTsif?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2991136, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "篠崎もちめ", "screen_name": "sisisi_sio", "avatar_url": "https://pbs.twimg.com/profile_images/1940336648891326464/Ah4EIvWu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1568936754396405760/1751447011/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 7, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 3069703, "creator": tr