ders/1IDqR1LWZw9SfFhr6mr1NhIMhV9tC4Fur?usp=sharing\n\nこのキャラクターの詳細：\n- 右目にモノコールをつけている。\n- 片面マント\n- プラチナの目\n\nこのキャラクターの参考文献: https://drive.google.com/drive/folders/1E1jBgDui-TkYtCdjaZs78p-qPCochxap?usp=sharing\n\n髪型はもっと雰囲気に合うように自由に調整してください！\nまた、必要であれば価格も自由に調整してください！\n\nよろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shina_417_417/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/01238cd2/uploads/origins/5de13584-7a87-4862-b9c6-62c6b0208acd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28576ad914a7f0f93cb6bd637e76e5de", "srcset": "https://si.imgix.net/01238cd2/uploads/origins/5de13584-7a87-4862-b9c6-62c6b0208acd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28576ad914a7f0f93cb6bd637e76e5de, https://si.imgix.net/01238cd2/uploads/origins/5de13584-7a87-4862-b9c6-62c6b0208acd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=053c8a6502ad881fddd58d32b81aaeb8 2x, https://si.imgix.net/01238cd2/uploads/origins/5de13584-7a87-4862-b9c6-62c6b0208acd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=04156a659628a1256d4a2daf27e2ff65 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1759693, "client_id": 34828, "nc": 128}, {"path": "/@shina_417_417/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1759693, "client_id": 2492469, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bccd4aa2/uploads/origins/ab47ab54-33b5-