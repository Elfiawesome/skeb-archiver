rdcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a458a8f9/uploads/origins/aa30e7d6-9b02-41b0-9822-5f252b56bb5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16c3793eefeacdaaecefbcfecf3d57b1", "srcset": "https://si.imgix.net/a458a8f9/uploads/origins/aa30e7d6-9b02-41b0-9822-5f252b56bb5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16c3793eefeacdaaecefbcfecf3d57b1, https://si.imgix.net/a458a8f9/uploads/origins/aa30e7d6-9b02-41b0-9822-5f252b56bb5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1998a02ab11d7c0542ed2eedf856358c 2x, https://si.imgix.net/a458a8f9/uploads/origins/aa30e7d6-9b02-41b0-9822-5f252b56bb5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d9d930341478bb7546a2ed5cef3e683e 3x"}, "body": "こんにちは^^あなたに依頼したいです^^。\n\n私のアイデアは、私の小さなライチュウのキャラクターと巨大なエクスブイモンについてでした^^。\nそのシーンは、エクスブイモンがジムでトレーニングした後なので、あなたが望むなら、彼は少し汗ばんでいるかもしれません。\n私の小さなライチュウがエクスブイモンの指の上に立ち、エクスブイモンがその指を胸に近づけてライチュウを助ける。\nライチュウがエクスブイモンの胸にキュートなハグをする。\nエクスブイモンの胸に頬をすり寄せるライチュウの姿が目に浮かぶ。\nエクスブイモンがライチュウを嬉しそうに見つめる。\n可能かどうかわかりませんが、私のライチュウのキャラクターがエクスブイモンとエクスブイモンのつま先の間に座っているところも描いていただけますか？\n恥ずかしそうにエクスブイモンの足を手で撫でて、顔を赤らめるライチュウが想像できます。\n(この絵はエクスブイモンの足にフォーカスしているので、遠慮なくそこにフォーカスしてください^^) また、エクスブイモンは絵の奥でニヤニヤしながらライチュウを見ています^^。\nここにいくつかの参考資料があります^^、ライチュウは遠慮なく好きなだけ小さく描いてください^^: https://imgur.com/a/PZwJROJ\nありがとうございました＾＾。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sonymonster793/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3279884, "client_id": 49373, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a504abf/uploads/origins/205c6db1-0a24-469a-ac1f-8de5bc1e39e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47533716b30b6e3360855f537255cdef", "srcset": "https://si.imgix.ne