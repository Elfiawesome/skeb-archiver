-f505-4bb5-94bc-92b55054339c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3ad8fbc1c3555abaad886470fd1de6a", "srcset": "https://si.imgix.net/fb4d5d27/uploads/origins/46645a4c-f505-4bb5-94bc-92b55054339c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3ad8fbc1c3555abaad886470fd1de6a, https://si.imgix.net/fb4d5d27/uploads/origins/46645a4c-f505-4bb5-94bc-92b55054339c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b122772449c17b7397f79e8a46f99e8 2x, https://si.imgix.net/fb4d5d27/uploads/origins/46645a4c-f505-4bb5-94bc-92b55054339c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=831707fe9f2643a8bdc0d7aa5bc3add7 3x"}, "body": "初めまして。HEY水と申します。\n先日『NEBUL0N』をHO3で通過しまして、世界観やNPC達の設定を交えた本編での展開やロールプレイなどシナリオを楽しく遊ばせていただきました。素敵なシナリオをありがとうございます！！\nリクエストは自機HO3と対応NPCのプロキオンとのイラストをお願いしたいです。\n\n〇用途:NEBUL0N自陣･KPへの共有、アイコンやヘッダーの使用\n〇依頼内容:\n･喫煙室などで煙草を吸うHO3とプロキオン\n↳可能であればシガーキスをしている二人\n･共闘する二人\n･HO3に肩を組みつつ第三者を牽制するプロキオン\n\n上記はあくまで例ですが、Kai様が手がけられるものでお願いいたします。\n\n〇キャラクター資料:\nCS→ https://iachara.com/view/13034480\nビジュアル→ https://drive.google.com/drive/folders/1JkoHRODCQidzWx2fQ_PI4LYsAGyutyY3\n\n何卒よろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ig2s_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2748283, "client_id": 2151776, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8950b2c2/uploads/origins/1df14959-6856-4578-a16f-3ff77aa76d64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2f6538bf5887e385f1b9b80b9469e3b", "srcset": "https://si.imgix.net/8950b2c2/uploads/origins/1df14959-6856-4578-a16f-3ff77aa76d64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2f6538bf5887e385f1b9b80b9469e3b, https://si.imgix.net/8950b2c2/uploads/origins/1df14959-6856-4578-a16f-3ff77aa76d64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7dc4d79664116a3952f778e5c3d96fbf 2x, https://si.imgix.net/8950b2c2/uploads/origins/1df14959-6856-4578-a16f-3ff77aa76d64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb6a96ab9d498187ddefb58e943322e3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8950b2c2/uploads/origins/1df14959-6856-4578-a16f-3ff77aa76d64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8567d412cb5d32e134660494645becde", "srcset": "https://si.imgix.net/8950b2c2/uploads/origins/1df14959-6856-4578-a16f-3ff77aa76d64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8567d412cb5d32e134660494645becde, https://si.imgix.net/8950b2c2/uploads/origins/1df14959-6856-4578-a16f-3ff77aa76d64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2b7442a5f60e803249a3fe30c4d9bf2f 2x, https://si.imgix.net/8950b2c2/uploads/origins/1df14959-6856-4578-a16f-3ff77aa76d64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b3fef3cbdf5c48092192d5be9f661baa 3x"}, "body": "はじめまして！ハノサトと申します。\n先日【NEBUL0N】にて初めて総理さまのシナリオを遊ばせていただき、展開やNPC達が全員素晴らしく、最高の思いをしましたのでご依頼をさせて頂きにきました。\nご縁がありましたら何卒宜しくお願い致します。\n\n下記依頼文にはネタバレを含みます。\n\n\n\n\n\n\n\n\n▼お願いしたいキャラクター\n\n　◆HO3:Proxis/プロクシス\n性別：男/年齢：21/172cm/58kg/呼び方：俺、お前、呼び捨て/プロキオンからの愛称：ロキシー/END：A\n表情筋が死んでいて目付きが悪い。超絶甘党で氷砂糖を持ち歩いている。友人はおらず、その日あった嬉しいことはプロキオンに報告したがる。\nずっと戦場に居られれば抑制剤も必要ないのにと思っている。現実的でないことも理解しているので抑制剤は素直に使っている。\n軍学校ではずっと「前線に出たい」と言っていたが理由は前線に配置されて自分の手で「神蝕者」を殺すため。\n「世界を守る 」＝「神蝕者」を殺すことだと思っている。\n「前線を目指した」理由を聞かれたら「自分の能力は戦闘向きだから」と答える。\nもちろん嘘ではないが本心は当然「自分の手で」神蝕者を殺したいから。\n無表情なだけで思ったことは全部素直に口に出し、生意気ではあるが指摘は素直に受け取り、大体何でもプロキオンに言いくるめられて納得していたため自陣からの評価は「おこちゃま」「ちいちゃいこ」\nロキシーという愛称はプロキオンのガードが固くて結局自陣からほとんど呼んでもらえなかった。\n酒にはハチャメチャに弱い。3％で泥酔する。\n「軍人」が天職すぎて現代に生きてたら殺人鬼になるタイプ。\n暴力衝動が強めに出ている時は飴と氷砂糖の消費量が上がる。常にかじってるような状態。\n自傷痕は手首と太ももに刺し傷。\n目の前の快楽に弱く刹那的に生きているがそれには無自覚。\nEND：Aに行けたのはプロキオンが神蝕者に敵対的だったから。\n\n\n　▋シチュエーション等\nプロキオンと一緒が良いです！！！！！！\n\n-\n以上になります。\nネタバレ回避のため自主的になるべく検索をしないようしていましたのでこれからツイート等追わせていただければと思っています！\nご確認本当にありがとうございます！\n何か不手際がありましたら申し訳ございません。\nご検討いただけますと幸いです！よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1GNSuDX4Q9tgbvlPuSqJZFwPDiekXazkq?usp=drive_link", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ig2s_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2748283, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f2c18a3/uploads/origins/0f2325f1-87cd-4623-a277-d93a237778bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6939a494408011f74b3c3f8b86554af", "srcset": "https://si.imgix.net/5f2c18a3/uploads/origins/0f2325f1-87cd-4623-a277-d93a237778bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6939a494408011f74b3c3f8b86554af, https://si.imgix.net/5f2c18a3/uploads/origins/0f2325f1-87cd-4623-a277-d93a237778bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b5108c47aec4cbf8911af9d4a9229dc 2x, https://si.imgix.net/5f2c18a3/uploads/origins/0f2325f1-87cd-4623-a277-d93a237778bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c569a93415ec95626f3b84b7653abb9d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5f2c18a3/uploads/origins/0f2325f1-87cd-4623-a277-d93a237778bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46e01f3457e971af6068c5c6b16e197e", "srcset": "https://si.imgix.net/5f2c18a3/uploads/origins/0f2325f1-87cd-4623-a277-d93a237778bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46e01f3457e971af6068c5c6b16e197e, https://si.imgix