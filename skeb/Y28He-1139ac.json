302c137fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f29db14b43aeb7467831f4d1ed442f4, https://si.imgix.net/dac68b99/uploads/origins/2aa8082e-95a9-4f5a-be15-ec302c137fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dc80e67492213d4ef8aef1521b561eac 2x, https://si.imgix.net/dac68b99/uploads/origins/2aa8082e-95a9-4f5a-be15-ec302c137fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6f6ffa4804abf43d8916391b75aeae2d 3x"}, "body": "Peko 様\n\nはじめまして、背景まで描きこまれた空気感の伝わるイラストに惹かれリクエストさせていただきました。よければキャラクター二人のイラストをお願いしたいです！\nhttps://skeb.jp/@Y28He/works/7\n（こちらのイラストなどとても素敵でした…！）\n\n以下が二人のキャラクター資料などをまとめたURLとなりますので、参考になさってください。\n参考URL：https://drive.google.com/drive/folders/1FcF9pKOtzP6jh3q8u8yQenzEI7DoaTXK\n （男の子の方の服装は、透過されている画像の方の服装でお願いします。）\n\n\n▼シチュエーション・構図など\n\n可能であれば、街中を歩きながらデートしている構図をお願いしたいです。\n\n手を繋いでいるなど関係性の伝わるポーズや表情をしているととても嬉しいです…！他細かい指定などはございませんので、お任せいたします。\n\nお忙しいところ大変恐縮ですが、ご検討よろしくお願いいたします…！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Y28He/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 14127, "client_id": 2188818, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/25b01841/uploads/origins/1c6a8e94-688e-43b9-8765-199cfc7575f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=234c8501905c62038ac794f12a38a617", "srcset": "https://si.imgix.net/25b01841/uploads/origins/1c6a8e94-688e-43b9-8765-199cfc7575f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=234c8501905c62038ac794f12a38a617, https://si.imgix.net/25b01841/uploads/origins/1c6a8e94-688e-43b9-8765-199cfc7575f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a7d1ba827dbbed6caaa4fdbc0c1a026 2x, https://si.imgix.net/25b01841/uploads/origins/1c6a8e94-688e-43b9-8765-199cfc7575f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=029274cdc5f2f5620be7afea110be6a5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25b01841/uploads/origins/1c6a8e94-688e-43b9-8765-199cfc7575f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9db05ef5c3b2c1d32a9a6beb87981374", "srcset": "https://si.imgix.net/25b01841/uploads/origins/1c6a8e94-688e-43b9-8765-199cfc7575f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9db05ef5c3b2c1d32a9a6beb87981374, https://si.imgix.net/25b01841/uploads/origins/1c6a8e94-688e-43b9-8765-199cfc7575f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dca851ae9c3f0bb292789e5ecffbbe13 2x, https://si.imgix.net/25b01841/uploads/origins/1c6a8e94-688e-43b9-8765-199cfc7575f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=48270feeecfe0d7ab2aec03177c48156 3x"}, "body": "またまたこんにちは。\n少し前に、私の2人のキャラクターの絵を描いていただきました（こちらは https://skeb.jp/@Y28He/works/7 ）。\n私はあなたの背景を作成する能力と、あなたのキャラクターがその中に溶け込む方法に驚きました。\nそこで、また別の絵をお願いしたいと思います。今度は私の3人のキャラクターを一緒に描いてもらえませんか？https://twitter.com/ShellyT_98/status/1570885611141353473\n\nCharacter 1: https://twitter.com/ShellyT_98/status/1570884331027169282\n昔は白かったというかなり古いシャツを着ている。シャツもジーンズもダメージ加工されている。また、黒いヘッドバンドをしており、顔には傷跡がある。\nとても真面目な男です。たまに怖い顔をすることもあるが、それは他の2人の友達を守るためだけ。\n\nCharacter 2: https://twitter.com/ShellyT_98/status/1570885328516546563\nとても優しいが、とても几帳面で賢い。\n2人の友達より1歳年下。サイコロを2つ持ち歩くのが好き。\n\nCharacter 3: https://twitter.com/ShellyT_98/status/1570885436930916356\n1人目のキャラクターと同い年。2人の友達のお姉さん的な役割をするのが好き。\nいつも髪を束ねているが、ときどき髪を遊ばせることもある。\n\n背景は、できれば前回の絵と同じ、大都市の小さな公園か路地裏を希望します。\n\nありがとうございました。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Y28He/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tip