rmat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f404e2dfda799b21c9ae0463b96c816", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0c00990/uploads/origins/96ed26ce-0afc-42f8-9abe-a0fcc2dfcdfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43ae623d0ce20edf3f54e704d8aab2b0", "src_set": ""}, "body": "NiL様はじめまして、SNSでお見掛けしとてもかっこいい絵柄で素敵でしたのでskebお願いしたいと思いお送りさせていただきました。\n\n今回お願いしたいキャラは私のデザイン担当させていただいた銅(Akqgane)さんを等身の絵でお願いしたいです。構図などはおまかせいたします。\n\n人物像としては\n・20歳\n・FPSが上手い\n・柴犬モチーフ\n・性格はありさかさんやバニラさんの系統だと思います\n\n▼参考資料(等身の絵苦手で描けずSDの資料で申し訳ございません…)\nhttps://drive.google.com/drive/folders/1mu2QFPy1C35kAnuFXCUHvtevgv6Hcd6u?usp=drive_link\n\nイラストの使用に関しましては、もしかしたらそのうち配信始めるかもとのことなのでサムネやアイコンなどに使用させていただけますと幸いです。\n\n金額が不適切な場合は再送申請頂ければ幸いです。\nご検討のほどよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nil_xxxl0/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3369800, "client_id": 1868074, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc1cc8f2/uploads/origins/65a545cd-4df7-432b-8afc-f8ca5089f438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab3fcd07170b819e69e3e1a0847c06c1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc1cc8f2/uploads/origins/65a545cd-4df7-432b-8afc-f8ca5089f438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e5be387b9bda33cfb3811b8e95a9036", "src_set": ""}, "body": "リクエスト失礼します。\nいつか配信活動を視野に入れてるわべっちです。\n今回配信用で立ち絵を希望をしたいのですがよろしいでしょうか？\nイメージとしてGoogleドライブに保存したアイコンをベースに描いて欲しいです。\nまた、服装をスーツ姿と和服姿の2種類を可能であれば作成して欲しいです。\n容姿について\n男性\n水色髪ポニーテール\n緑色の瞳\n体型は普通くらい\n参考資料↓\nhttps://drive.google.com/file/d/1lp1JuCvTEX9_dqsfmTIHpmxUpBgY9l3Y/view?usp=drivesdk\nご検討の程よろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nil_xxxl0/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3369800, "client_id": 1354011, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2e69c4a/uploads/origins/cb4df18e-d1fb-4d8d-be2c-846d97aa5e49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=222463c2abe33da63ea5a5ee43e3927b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2e69c4a/uploads/origins/cb4df18e-d1fb-4d8d-be2c-846d97aa5e49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5961c295d086a29a7fc7035a545f3ebf", "src_set": ""}, "body": "とても素敵な絵師様だと思いイラストをお願いしたいです！\n私の代理キャラ（青年男性）の等身イラストをお願いしたいです！\n\n使用用途はTwitterやYOUTUBEのヘッダーやアイコンやサムネイルや、YOUTUBEで画面隠したりするときに使用する可能性があります。\n\n可能であれば眼鏡アリと無しの差分欲しいです！(もし無理そうならメガネ有りで）\n\n背景透過したファイルも欲しいです！\n\nPSDファイルの開き方が分からないのでPNGファイルで欲しいです！（PNGファイルが無理そうならキャンセルしてほしいです）\n\n書いて欲しいのはクールな感じもしくは微笑んでる感じで三つ編みをあざとい感じにしてるかんじでお願いしたいです！\n\nキャラの設定は３０代の成人男性、少し褐色、濃い目の緑髪、三つ編み、スポーツ好き、ヘアバンド、腰のスリットは左右両方にあります。身長は180センチくらい、ズボンはスパッツに近いです。ゲームが好きです。どっちかって言うと受けです。相棒のぱら村と日々を過ごしてます。（ぱら村に関しては描くかどうかまかせます！）\n\nポーズなどは任せます！がもし可能であればゲーム実況してる感じでお願いしたいです！（ニンテンドースイッチのプロコントローラーを持ってプレイしては感じで！）\n\n私の代理キャラの立ち絵など\nhttps://x.com/utaugarakuta16/status/1703814020854317518?s=20\n\n少年の姿\nhttps://twitter.com/utaugarakuta16/status/1808493013188190352?s=46&t=zQ_F2PIlnkR_nGC6nz5x4Q\n\n相棒のぱら村\nhttps://twitter.com/utaugarakuta16/status/1709286577011388787?s=46&t=zQ_F2PIlnkR_nGC6nz5x4Q\n\n長文失礼しました！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nil_xxxl0/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3369800, "client_id": 2805985, "vtt_url": null, "thumbnail_image_urls": {"src": "http