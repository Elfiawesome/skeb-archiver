er&txtsize=30&txt=PRIVATE&s=98d67bac89c2c17467ac3d387521b0c4 2x, https://si.imgix.net/891230e4/uploads/origins/a5f32073-c32e-4848-9770-3298f1d7aafa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=089527534d5d6b29d2c9472d882521b5 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2510724, "client_id": 1872748, "nc": 128}], "sent_works": [{"path": "/@tanannevr/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3871466, "client_id": 2510724, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/39c926e5/uploads/origins/9e041f0e-03a7-4fd2-a7e9-485158bdd52f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=999b0f87d37851de2957cfe21b8af93b", "srcset": "https://si.imgix.net/39c926e5/uploads/origins/9e041f0e-03a7-4fd2-a7e9-485158bdd52f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=999b0f87d37851de2957cfe21b8af93b, https://si.imgix.net/39c926e5/uploads/origins/9e041f0e-03a7-4fd2-a7e9-485158bdd52f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d79c7faa42c8cd08bc959a1fa104ad0 2x, https://si.imgix.net/39c926e5/uploads/origins/9e041f0e-03a7-4fd2-a7e9-485158bdd52f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e764ffb10d456a27662aa95e45b2662 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/39c926e5/uploads/origins/9e041f0e-03a7-4fd2-a7e9-485158bdd52f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b2560ca6e3d1861c97d4572c7926cce", "srcset": "https://si.imgix.net/39c926e5/uploads/origins/9e041f0e-03a7-4fd2-a7e9-485158bdd52f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b2560ca6e3d1861c97d4572c7926cce, https://si.imgix.net/39c926e5/uploads/origins/9e041f0e-03a7-4fd2-a7e9-485158bdd52f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9a263fa7c7db50c016096bfb521743f8 2x, https://si.imgix.net/39c926e5/uploads/origins/9e041f0e-03a7-4fd2-a7e9-485158bdd52f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b4308c964d1bea5fea545e50c298acd 3x"}, "body": "たなんね様こんにちは！みずおりと申します。\n素敵なイラストを拝見し、是非描いて頂きたいなと思いましたのでリクエスト失礼いたします！\n\nVRChatのイベント『胡蝶の夢』で活動している時のアバターのイラストを描いて頂きたいです。\n資料で分かりにくい点、描きにくい点などは調整や簡略化していただいて大丈夫です。\nメインモチーフは蒼桜で、蒼い八重桜の模様の入った着物を着ており、着物の左の腰には青い満月が書かれています。\n邪竜の種族をしていますので翼や尻尾、角があります。足は裸足です。\n\n特に必ず守ってほしい要素は\n・褐色というよりは黒色寄りの肌\n・白目の部分が黒い反転目\n・何重の輪の模様の青い瞳\n・遠いと黒く、近づくと消えていく半透明のフェイスベール(前髪のかかった目の部分は見えるような仕様になっています。半透明の状態で描いてほしいです、可能であれば不透明の差分もあるととても嬉しいです。)\n・黒い口内に青い舌\nです、身長は約190cm以上あります。\n\n構図は見返り気味の姿勢で周りに青い蝶が漂っているのが見てみたいです、もしイメージが湧かなかったり難しいと感じた場合は構図はお任せ致します。表情はこちらに向かって蠱惑的に微笑んでいるような顔だと嬉しいです。\n世界観などの補足としましては\n『江戸時代の花街をモデルとした幻想的な場所で、遊女のような女性たちが蠱惑に微笑みながら、お客と一夜の濃密なひと時を過ごす』\nというイメージです。\n\n宛名につきましてはPSDレイヤーでON/OFF出来ようになっていると嬉しいです。\n\n納品してもらったイラストについては\n・SNS、Discordへの投稿、アイコン利用\n・VRCでのアイコン使用\n・VRCのワールドへの展示\n・所属イベントの告知への利用\nの許可を頂きたいです。\nご検討の程よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1UGU0cogYE-aQGMmRgRv-8qEr2GQMW7JB?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kkym__zombie/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3484028, "client_id": 2510724, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f33b779/uploads/origins/336e009a-1626-4323-852b-0daf314b2b41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38d0c8686333f61c63bfcd29e58d5a42", "srcset": "https://si.imgix.net/9f33b779/uploads/origins/336e009a-1626-4323-852b-0daf314b2b41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38d0c8686333f61c63bfcd29e58d5a42, https://si.imgix.net/9f33b779/uploads/origins/336e009a-1626-4323-852b-0daf314b2b41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd0810284d9013a8bc5283da015a6592 2x, https://si.imgix.net/9f33b779/uploads/origins/336e009a-1626-4323-852b-0daf314b2b41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aebee0c5094dd0b6028b0aebddcb3380 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f33b779/uploads/origins/336e009a-1626-4323-852b-0daf314b2b41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7e6fc22efbe5ba84ff3db38019e7ecb", "srcset": "https://si.imgix.net/9f33b779/uploads/origins/336e009a-1626-4323-852b-0daf314b2b41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7e6fc22efbe5ba84ff3db38019e7ecb, https://si.imgix.net/9f33b779/uploads/origins/336e009a-1626-4323-852b-0daf314b2b41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=777c45f78ab55a51c83498abc8c3a642 2x, https://si.imgix.net/9f33b779/uploads/origins/336e009a-1626-4323-852b-0daf314b2b41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=58a0b20d9114926489714a86ff0fa0d6 3x"}, "body": "はじめまして、みずおりと申します。\n貴方様の素敵なイラストをお見かけしたので、リクエスト依頼をさせていただきます🙇‍♀️\n\n依頼内容⬇\n私がVRCというコンテンツでしているイベント活動の一つ、crossvoiceでの姿を描いていただきたいです。\ncrossvoiceは｢男性が女性声で、女性が男性声で立ち振る舞い接客するイベント｣で、私は女性が男性声で接客する側をしています。\n\nニヤッとした表情で、目元につけているフェイスベールが半透明になっていて瞳が見えるように描いて欲しいです。\nギザ歯で舌と口内は黒色なので、口を開ける表情の際はその辺りを気をつけていただけたら嬉しいです💦\n\nイメージは｢ミステリアスナンパ系｣で、チャラチャラした陽キャなナンパ感とは少し違う、誑かしてきそうな印象のあるミステリアス感があったらいいなと思っております。\n\n特徴としては、\n・顔に近づくと徐々に透けながら消えていくフェイスベール\n・更に近づくと青から赤に変わる瞳\n・黒めの褐色肌\n・黒いケモ耳と尻尾\n・白目の部分が黒\nが主な部分です。\n\nポーズはざっくりととったものになるので、このポーズのままでもいいですし、このまま描かなくても構いません。\nこのポーズ以外の場合、角度は顔が見えていればいいなと思いますが、俯瞰でも煽りでもどちらでも大丈夫です。\n背景のある資料画像は雰囲気を伝えるためや全体像のものになります。\n描きやすい構図、思いついた描いてみたい構図がありましたらそちら優先で問題ありません！\nイラストは縦長画像で、背景がある場合は背景あり・なしの差分を頂けますと幸いです🙏\n\n資料\nhttps://drive.google.com/drive/folders/1y3wYbwobsS_OOvibkVmvmqZRkFUPDVJP?usp=drive_link\n\n納品していただいたイラストについては\n・SNSへの投稿\n・SNSでのアイコン利用\n・VRCでのアイコン利用\n・VRCのワールド展示\n・所属イベント告知利用\nの許可を頂きたいです。\n\n金額や内容の不備があったりした場合は再送要請やキャンセル等していただいて構いませんので、もし筆が乗りそうだなと思いましたら是非！ご検討頂ければと思います😊\nよろしくお願いいたします🤝\n\nhttps://drive.google.com/drive/folders/1y3wYbwobsS_OOvibkVmvmqZRkFUPDVJP?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_kurohanpen/works/130", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2174737, "client_id": 2510724, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2bdecdba/uploads/origins/b787494b-e00a-4c9a-8fab-d4f8124bab5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2842c7cfaa2dd6e08403c86ae6e2571", "srcset": "https://si.imgix.net/2bdecdba/uploads/origins/b787494b-e00a-4c9a-8fab-d4f8124bab5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2842c7cfaa2dd6e08403c86ae6e2571, https://si.imgix.net/2bdecdba/uploads/origins/b787494b-e00a-4c9a-8fab-d4f8124bab5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11417dba45b878867e0eab907c7c0d24 2x, https://si.imgix.net/2bdecdba/uploads/origins/b787494b-e00a-4c9a-8fab-d4f8124bab5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9803273935ce25d9f7433d3d4cf93f49 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2bdecdba/uploads/origins/b787494b-e00a-4c9a-8fab-d4f8124bab5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0afa090ebc7178b9f91c143cb853abca", "srcset": "https://si.imgix.net/2bdecdba/uploads/origins/b787494b-e00a-4c9a-8fab-d4f8124bab5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200