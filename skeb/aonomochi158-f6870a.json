eba5-4d34-b5cc-fab77d50e7ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be73845b108a87406ced9cc64517a7e5 2x, https://si.imgix.net/76051eb0/uploads/origins/8946cba2-eba5-4d34-b5cc-fab77d50e7ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=147e6ba37a6ff87a0034255c3f329d13 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76051eb0/uploads/origins/8946cba2-eba5-4d34-b5cc-fab77d50e7ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b78a65504316ad2835d64e5af50b15af", "srcset": "https://si.imgix.net/76051eb0/uploads/origins/8946cba2-eba5-4d34-b5cc-fab77d50e7ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b78a65504316ad2835d64e5af50b15af, https://si.imgix.net/76051eb0/uploads/origins/8946cba2-eba5-4d34-b5cc-fab77d50e7ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e8b49e31f701a193335b051af78f5ab 2x, https://si.imgix.net/76051eb0/uploads/origins/8946cba2-eba5-4d34-b5cc-fab77d50e7ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5340802bfa500194b616d288b7709b7 3x"}, "body": "初めまして！VTuberの海月ひなつと申します。\n蒼乃もち🐰🌝🍡様の、ふんわりで優しい表情のイラストや塗り方がとても可愛らしくて、どうしても描いていただきたい！と思いまして…ぜひリクエストさせていただければと思います…！ \n\n\n  ■依頼内容  \n海月ひなつのイラストを描いていただきたく思います。 \n出来れば髪の毛が途切れていないイラストでお願いしたいです。\n (腰まで髪があるため、バストアップで毛先は途切れている、などでも大丈夫です…！ 　横髪などが切れていなければ大丈夫、という感じです）\n\nまた、目線はカメラ目線でお願いできると助かります。\n表情、ポージング、お洋服についてはお任せいたします！\n資料のもの(デフォルトのお洋服)でも、その他お洋服や水着などでも、好きに着せていただけると嬉しいです。(もち様の着ていらっしゃるお洋服大好きです…！)\n\n■使用可能性のある用途\n・YouTubeのサムネイル \n・おはよう/おやすみVTuber \n・FANBOX配布用壁紙\n(FANBOXメンバーに、そのままお配りではなく、イラストを配置して壁紙作成いたします)\nネットプリント\n・缶バッジ、 ポストカードなどのグッズ\n\n⇒NGの用途については、かいていただけますと幸いです…！\n\n\n■資料  https://drive.google.com/drive/folders/1HP_YouQiKkfbwuDDfu3U0mQ7bnHVzXAV?usp=sharing \n\n※頭と目の中にあるミズクラゲの傘の模様のハイライトは、構図的に無理な場合を除き、描いていただきたく思っております…！\n\n\n ■ファイル形式  \n背景の有無はお任せいたします！\n ※サムネイルなどに使用したいため、背景ありの場合、PSD、もしくは透過pngをいただけると助かります。\n\n\n  ■海月ひなつについて \n ・インターネットの海と世界を揺蕩う、クラゲVTuberです。 \n・性別は女の子ですが、一人称が「僕」（クラゲなので人間の性別にはそこまでこだわりなし）です。 \n・種族はミズクラゲ。出身は南の海となります。 \n・見た目年齢的には16歳程度ですが、実際は1年に1度、水に溶けてはまた成長して…と、生死を繰り返しているので、正確な年齢が不明です。\n・ゲラでよく笑います。が、それ以外の時は冷静(淡々)な感じです。\n  ・イメージカラーは青色、サブカラーがパステルピンクと、少しだけイエロー(日差しの色)です。  \n\n\n■その他  \n依頼内容に記載した点以外は、蒼乃もち🐰🌝🍡様の描きやすいように描いていただければと思います。\n\nご検討、よろしくお願い致します…！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@peritune_info/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": true, "creator_id": 3657039, "client_id": 3282418, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1918376413922770946%2FyBskTNPJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99c5e72e71385f24de1f296da7dcf50c", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1918376413922770946%2FyBskTNPJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99c5e72e71385f24de1f296da7dcf50c, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1918376413922770946%2FyBskTNPJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31fa4daf3e028c49ffdb9717c710977c 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1918376413922770946%2FyBskTNPJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09aef219f12cffd66b391f15ea3d7242 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/3d23db24-2f8e-4074-bf2c-a2e978720f09?response-content-disposition=inline&Expires=1780423568&Signature=d460~0nmuMUBXNv-YOWhvaH8RlQ7d8F0-ZyqAS0wSuOe0~89ZYbsFt9uxqwpVvDOEo1aq~1jaxHXywwV-ZzBWtted2id0UFlFKImBGbWdjbcWNE7rTnBbUpJ2e17vyL6fPNyyH261uyaICgV8pKcCn60Z8BlCm7W7r35LvmmJ0N~iFdQGy~XNqycl3q2mVPuQBaHkrYY7Oymogz7qovvEJLtWuCK1sws47k~TC6vSzC8NmaOcq-SfKJ2aj97DQF2HplK3vBcuvQYaA75n4ah2yESq94ExZeglBJzTTpHCyYp9gUcPaXuvy27bCL4-9k7U9wD3CSJfjURbHt4uaWhTw__&Key-Pair-Id=K1GS3H53SEO647", "duration": 178, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1918376413922770946%2FyBskTNPJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75bd116936c3bc5b83cbc4c33651bcb7", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1918376413922770946%2FyBskTNPJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75bd116936c3bc5b83cbc4c33651bcb7, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1918376413922770946%2FyBskTNPJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=34108a53aefd8b1c714106aa82bb0dbe 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1918376413922770946%2FyBskTNPJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4efc7590049181ec67e669b813b9b7ff 3x"}, "body": "むつき醒様\n\nはじめまして！TwitchやYouTubeにて配信活動を行っております、月うさぎの蒼乃もちと申します☺️\nむつき醒様の作られる楽曲が本当に大好きで、今までにも配信にてたくさん使用させていただいておりました！\n特にWorld OP1・2、Limpid_Waterがめちゃくちゃ大好きなので、いつか自分の中にあるファンタジー世界をゲーム化したときにお借りしたいと常々思っております🙌\n\n本音を言えば、むつき醒様の内側から自然と発されるものを遠くからそっと見ていたい感じなので、その世界にご依頼するという形で自分が入り込むのもちょっと葛藤があるのですが、どうしても自分の感覚にしっくりくるものが他に見当たらないので、今回勇気を出してリクエストさせていただいております🙏\n何卒よろしくお願いいたします！\n\n◆作っていただきたい楽曲について\n蒼乃もちは動物さんや可愛い妖精さんが住んでいる平和で牧歌的な森の大きなツリーハウスに住んでおりますので（下記添付資料内の画像をご参照いただけますと幸いです）、その森に訪れたら流れてきそうな音楽をイメージして作っていただきたいです！\n皆さんにしっかり聴いていただきたいので、配信のOPやEDなど楽曲単体で流すところに使いやすいようなイントロやアウトロがしっかりある楽曲だとありがたいです🙏（World OP的な感じ）\n楽曲の方向性としては、「Celtic and Medieval」内収録のHarvestシリーズ（特に1、2、3）やSnowy Village2のような、ケルト風の明るくてほのぼのとした可愛い感じの楽曲だと嬉しいですが、前述の通り私はむつき醒様の感性やセンスがとても好きなので、ご自身のイメージ優先でよきように作っていただければと思います☺️\n\n◆主な使用用途\n配信用BGM、動画作成など（収益化済みチャンネルのため、サブスク限定コンテンツなどで使用する可能性があります）\nその他、活動の際にプロモーションとして使用させていただく可能性がございますが、BGM単体での公開・配布は一切行いません。\n\n以上となります。\nもし不備などございましたら、気兼ねなく再リクエスト申請をよろしくお願い致します🙇‍♀️\n\nhttps://www.dropbox.com/scl/fo/1g2u9l3a3zf9xwelqa4af/AIj24TYu3tJuAKBbutijraE?rlkey=2218jqbm4hg68x0jo0e3lxj6s&st=nw3eys5m&dl=0", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@AKR_0502/works/113", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 8257, "client_id": 3282418, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/158e2503/uploads/origins/314b009b-4435-4485-96ea-0c494491a9a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed4fa27e9781317b4d6b93e7989884b0", "srcset": "https://si.imgix.net/158e2503/uploads/origins/314b009b-4435-4485-96ea-0c494491a9a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed4fa27e9781317b4d6b93e7989884b0, https://si.imgix.net/158e2503/uploads/origins/314b009b-4435-4485-96ea-0c494491a9a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=179fb47ad94e46dfd03fd885ea285a3e 2x, https://si.imgix.net/158e2503/uploads/origins/314b009b-4435-4485-96ea-0c494491a9a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d58e46fcdaf26b04c13110ac1947784 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/158e2503/uploads/origins/314b009b-4435-4485-96ea-0c494491a9a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6b99dcc0203d4723e2691879c5816a1", "srcset": "https://si.imgix.net/158e2503/uploads/origins/314b009b-4435-4485-96ea-0c494491a9a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6b99dcc0203d4723e2691879c5816a1, https://si.imgix.net/158e2503/uploads/origins/314b009b-4435-