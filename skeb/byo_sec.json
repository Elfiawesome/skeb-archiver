uploads/origins/46fdd0b6-22b5-4d30-87a2-cdeecc60692a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66e400b7cc3996fb95add85c27fff1a5, https://si.imgix.net/f9ec6b0f/uploads/origins/46fdd0b6-22b5-4d30-87a2-cdeecc60692a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=93c82497c7577934bc0acecec724cfdd 2x, https://si.imgix.net/f9ec6b0f/uploads/origins/46fdd0b6-22b5-4d30-87a2-cdeecc60692a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df2da3e8081aecf282df7b79dbe46186 3x"}, "body": "こんにちは、私は先生の作品が本当に好きです。二人OCの絵を依頼したいです。\nもし、私の入札が十分でない場合は、価格を設定して、リクエストを再送信するように要求してもかまいません。\n\nhttps://drive.google.com/drive/u/2/folders/1_0M6GBRmqwGVANZukSaEHfVjcSsUqDNE\n↑ 差分を自由に選んでいただいても構いませんし。↑\n\nキャラクターに対する自分の考えに基づいて、自由に展開してもかまいません。これらの記述をもとに、自由に作成してください。\nありがとうございました！ (*´I`*)", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@byo_sec/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3651102, "client_id": 386195, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c77d4a8/uploads/origins/66c3bafd-40b0-422c-be8e-be7f717286e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aa9fc9aa737ce26de0f5e6e2cd24bea", "srcset": "https://si.imgix.net/6c77d4a8/uploads/origins/66c3bafd-40b0-422c-be8e-be7f717286e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aa9fc9aa737ce26de0f5e6e2cd24bea, https://si.imgix.net/6c77d4a8/uploads/origins/66c3bafd-40b0-422c-be8e-be7f717286e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=138358d8b8d632b494402ec2125486c8 2x, https://si.imgix.net/6c77d4a8/uploads/origins/66c3bafd-40b0-422c-be8e-be7f717286e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba316cbce27b8dc23f8516c2805e9789 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c77d4a8/uploads/origins/66c3bafd-40b0-422c-be8e-be7f717286e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86de8fba4eac44d67a5d4c50d97b34ca", "srcset": "https://si.imgix.net/6c77d4a8/uploads/origins/66c3bafd-40b0-422c-be8e-be7f717286e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86de8fba4eac44d67a5d4c50d97b34ca, https://si.imgix.net/6c77d4a8/uploads/origins/66c3bafd-40b0-422c-be8e-be7f717286e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=39fb2ccf6e558cc078f70df53820aa5d 2x, https://si.imgix.net/6c77d4a8/uploads/origins/66c3bafd-40b0-422c-be8e-be7f717286e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3ed87853daf059095d51f49219f1082f 3x"}, "body": "9秒様お世話になっております。\n先日は素敵なイラストありがとうございました。理想通りの二人で大変感動しています。\nこの度は前回と同じ自分と友人のOCを描いていただきたくリクエストをお送りいたしました。 \n下記の２名のイラストをお願いしたいと考えております。\n__\n❚キャラクターについて\n\n真っ暗な容姿や影の名前を持ちながら全ての脚光を浴びる天才役者と、天使のような容姿と光の名前を持ちながら脚光を奪われた秀才役者です。\n\n❚１人目A\n性別：男性\n年齢：25歳\n身長：185cm細身\n性格：いつも笑顔を浮かべている青年。自分がBの実力を最大限に引き出せるし自分をBを舞台上で最高に輝かせるための舞台装置だと思っている。\n〔容姿〕\n髪色：黒髪、少しぼさっとしています。\n目の色：〔右〕黄色に白いキラキラ瞳孔/〔左〕黒に赤瞳孔\n特徴：左目側に泣き黒子/首筋に2連黒子/首に鬱血痕・歯形\n〔その他〕\n舞台役者。左手薬指に歯形\n歌と演技において絶対的な才能を持っているがその他のことに関しては少しポンコツ。\n\n❚2人目 B\n性別：男性\n年齢：25歳\n身長：185cm弱（１人目と同じくらいかほんの少し低い程度。）細身\n性格：ムスッとした表情をよくしているツンツン気味の青年。雰囲気は『キラキラした』や、『天使のような』と言った言葉が似合う人物だが実際は口が少々悪い。\n〔容姿〕\n髪色：白髪、クセのあるアホ毛があります。\n目の色：〔右目〕黒に青瞳孔/〔左目〕黄色に白いキラキラ瞳孔\n特徴：手の甲に切り傷、首筋に歯形\n〔その他〕\n舞台役者。左手薬指に歯形\nトマトが好き。苦いコーヒー派。\n\n___\n\n❚その他追記\n目に関して：文章ではニュアンスが伝わりにくいかと思いますので画像の資料をご確認ください。\n___\n\n❚使用用途\n個人鑑賞/相方への共有/\n\n詳細な構図やポーズは9秒様にお任せしたいと考えております。  \n今回舞台イメージで下記リンク先イメージの雰囲気で少しフォーマルでオシャレをした衣装でお願いしたい所存です。\nhttps://drive.google.com/drive/folders/1qZ-y6jzmoQTqKiPhmpWQEGYw9Sw9oqze\n金額が不足している場合お手数ですが再送していただけますと幸いです。 \nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/11Lrax8Y0DaeInFcUtOwIpRQ3g7GBShwd?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@byo_sec/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3651102, "client_id": 3406385, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/082d7410/uploads/origins/54570d4d-c7b1-4a7d-82c9-13c82e67f497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50b3e0e02e252ce85fb957c2e326b1dd", "srcset": "https://si.imgix.net/082d7410/uploads/origins/54570d4d-c7b1-4a7d-82c9-13c82e67f497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50b3e0e02e252ce85fb957c2e326b1dd, https://si.imgix.net/082d7410/uploads/origins/54570d4d-c7b1-4a7d-82c9-13c82e67f497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c35ac014e1e9b1e5bf4a6c604d7bd303 2x, https://si.imgix.net/082d7410/uploads/origins/54570d4d-c7b1-4a7d-82c9-13c82e67f497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1949cfc2851222a604f391f138df7ff4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/082d7410/uploads/origins/54570d4d-c7b1-4a7d-82c9-13c82e67f497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08753c0f6790bf6b2750b673e5e8bfcf", "srcset": "https://si.imgix.net/082d7410/uploads/origins/54570d4d-c7b1-4a7d-82c9-13c82e67f497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08753c0f6790bf6b2750b673e5e8bfcf, https://si.imgix.net/082d7410/uploads/origins/54570d4d-c7b1-4a7d-82c9-13c82e67f497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1d146e3d68c3c93bf55ea63ae0f5eb74 2x, https://si.imgix.net/082d7410/uploads/origins/54570d4d-c7b1-4a7d-82c9-13c82e67f497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ac45ab02414b2c120c26c41ef3f4aeb 3x"}, "body": "こんにちは、先生！\n\n先生のアートスタイルが大好きです！今回は私のオリジナルキャラクター2人（ロマンティックな関係）のリクエストをお願いしたいです。彼らは主従関係であり、パートナーであり、恋人同士でもあります。  \n\n  🦋 Chara 1：エイプリル (April)【攻め/184cm/19歳】\n明るく紳士的で、人当たりが良い性格。シルバーの右腕として、家族を脅かす者を排除します。黒髪で左目を覆う髪型、一本だけ白い髪束があります。両目は緑色、頭には黒い蝶の羽が生えています。シルバーに接する際は感情的で敏感な一面も。\n\n🐺Chara 2：シルバー (Silver)【受け/174cm/16歳】\n黒い狼に変身する能力を持つマフィアのボス。幼少期の辛い経験から冷静で抑制的ですが、エイプリルの行動には非常に寛容です。短い黒髪、低彩度の紫瞳、黒い動物の耳と尻尾を持っています。\n\n関係性 \n\nエイプリル（🦋）は、シルバー（🐺）の顧問（コンシリエーレ）兼守護者として、彼を導き世話をしています。エイプリルはシルバーに深い献身を示していますが、その世話には執着や偏愛が含まれています。一方、ボスであるシルバーは冷静な外見を保ちながらも、エイプリルに対しては完全な信頼を寄せ、彼のあらゆる行動を黙認し、甘んじて受け入れています。\n\n服装やデザインは自由に変更していただいて構いません！もし可能であれば、2人の体格差がわかるように描いていただけると嬉しいです（シルバーはエイプリルより半頭分ほど小柄で、若く見える印象でお願いしたいです）。\n\nこのイラストは、個人利用（SNSアイコンや携帯の壁紙）として使用させていただきます。  リクエストを読んでいただき、そして検討いただき本当にありがとうございます。このリクエストが不適切でしたら、どうぞお気軽にキャンセルしてください。\n\n金額が足りない場合、再送お願いいたします…!  よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1ELhgR-asbNtVhyPQFjL1VpA7wg46wTGJ", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@byo_sec/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3651102, "client_id": 3406385, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7aaf953/uploads/origins/f09afa92-c160-4eaf-bd12-ac0054fc8340?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baffe6e31b521c38ed5218e3c8faacec", "srcset": "https://si.imgix.net/a7aaf953/uploads/origins/f09afa92-c160-4eaf-bd12-ac0054fc8340?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baffe6e31b521c38ed5218e3c8faacec, https://si.imgix.net/a7aaf953/uploads/origins/f09afa92-c160-4eaf-bd12-ac0054fc8340?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92aa982595ad627df74178fbbfa0fe50 2x, https://si.imgix.net/a7aaf953/uploads/origins/f09afa92-c160-4eaf-bd12-ac0054fc8340?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3