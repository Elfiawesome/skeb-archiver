&w=200&h=200&s=4501a5ef0140b9dd58d977e5a9777d79 2x, https://si.imgix.net/cd993e33/uploads/origins/3d1dd573-cae2-4ee3-87ee-3ca9309fd929?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0eb450eeb728210af4024b4181de7868 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd993e33/uploads/origins/3d1dd573-cae2-4ee3-87ee-3ca9309fd929?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eaf5c76273245a8304fdc454a530c083", "srcset": "https://si.imgix.net/cd993e33/uploads/origins/3d1dd573-cae2-4ee3-87ee-3ca9309fd929?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eaf5c76273245a8304fdc454a530c083, https://si.imgix.net/cd993e33/uploads/origins/3d1dd573-cae2-4ee3-87ee-3ca9309fd929?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b17981af18f8a71f8eb140594f4c75fd 2x, https://si.imgix.net/cd993e33/uploads/origins/3d1dd573-cae2-4ee3-87ee-3ca9309fd929?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=15e5c44303595016c8f274969869b3c3 3x"}, "body": "先生初めまして！先生の作品が大好きです。よろしければオリキャラたちのイラストを頼みたいです。具体的にはURL参照してください。\n\n早乙女 新冴（さおとめ あらさ）27歳男性、引退した俳優です。\n貴族の気質があります。身長184cm、ゴージャスな赤い目をしています、彼の髪は氷と青の色をしている。髪の毛のいくつかは、3つのダイヤモンドの形に赤く染められました。\n\nカナダと日本の混血である。 カナダの有名なモデルである母親に連れられて、幼い頃からショービジネスの世界に入り、ずいぶん前に子役としてデビューし、順調にキャリアを積んできた。\n彼はすべての仕事をすることができ、いつも感謝されていました。すべてが簡単で、挑戦することもなく、人生の興奮を見つけることができませんでした。長年他人の役を演じてきた彼は、自分の魂を失ったと感じ、多くのクレイジーなアイデアが現実に抑制され、思い通りに生きられないことに鬱屈とした退屈さを感じている。\n26歳のとき、仕事に飽きた彼は、3つのダイヤモンドのパターンで顔に反抗的に入れ墨をしていました。 彼の演技生活は大きな打撃を受け、彼はスムーズに引退した。現在、彼は失業中のニートであり、体重やスケジュールを管理する必要がなくなったため、好きなものを食べたり、好きなゲームをプレイしたりできます。 彼が望む次の仕事を見つけるまで、彼は彼自身に良い人生を与えるために彼が集めたお金を使うでしょう。\n\n彼はハンサムで自信があり、いつもファッショナブルな服を着ています、スリルを味わうためにクレイジーなことをすることがよくあります。彼は魅力が得意で、過去に武道映画を撮影するための戦闘スキルも習得しました、好きな武器は鉄の短い棒です。子供の頃にバイオリンを学びました。彼は何でも素早く行うことができます。天才です。\n\n彼は俳優なので、どんな衣装やシーンでも可能です。描画範囲を半身以上にしたい、を描いていただければ幸いです。服装や表情はカジュアル、服のデザイン、アレンジ等は全てお任せしたいです。自由にアレンジしてください。できればPSDファイル形式でお願いします。\n私の依頼を読んでいただき、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/12o3zfAxnGrcdDFnZZEniErGwS4mI7fTY?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@343_sashimiiiii/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2192498, "client_id": 1725938, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ed41576/uploads/origins/55e8649f-3826-4de1-9999-bfe6b8585add?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=739c9b0a3e9f82e53331d4711bf69d18", "srcset": "https://si.imgix.net/8ed41576/uploads/origins/55e8649f-3826-4de1-9999-bfe6b8585add?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=739c9b0a3e9f82e53331d4711bf69d18, https://si.imgix.net/8ed41576/uploads/origins/55e8649f-3826-4de1-9999-bfe6b8585add?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f22598702234e2397f9817d82116d609 2x, https://si.imgix.net/8ed41576/uploads/origins/55e8649f-3826-4de1-9999-bfe6b8585add?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dce4f0498dc803ad0343a655406cfb1b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ed41576/uploads/origins/55e8649f-3826-4de1-9999-bfe6b8585add?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d16a085d20af665cfb05f9d7a8a2fd9", "srcset": "https://si.imgix.net/8ed41576/uploads/origins/55e8649f-3826-4de1-9999-bfe6b8585add?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d16a085d20af665cfb05f9d7a8a2fd9, https://si.imgix.net/8ed41576/uploads/origins/55e8649f-3826-4de1-9999-bfe6b8585add?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5cd98b52a60