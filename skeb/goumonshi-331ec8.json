提出させてもらいました。\n\n私の妖精OCが手足を切り落とされる過程のイラストを描いていただけませんか？生きたオナホールに改造するつもりです。彼女の血は青いだけでなく、きらきらした妖精の粉で彩られています。NSFW/Goreのサブフォルダに参考資料があります。\n\n夢を糧とする魔法の存在として、たとえ彼女が怖くても、排泄物や尿がないほうがいい。\n\n理由の如何を問わず、このリクエストの拒否や再送はご自由にどうぞ。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/12CjN3DJ3cCHTJGux7OSO48zLERvGqzOn", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 393764, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "めてお🦀", "screen_name": "meteotickling", "avatar_url": "https://pbs.twimg.com/profile_images/1913472091447607296/f-A_ozVe.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 40, "skills": [{"genre": "art"}, {"genre": "novel"}], "nc": 160}, {"id": 605197, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "穴見呂 夢恵・Skeb受付中", "screen_name": "mue", "avatar_url": "https://pbs.twimg.com/profile_images/1859077926597386240/cQUM46E9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3160493905/1613386030/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "novel"}, {"genre": "correction"}], "nc": 176}, {"id": 848775, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Prck(猟奇絵注意)（skeb作業中）", "screen_name": "Perack3", "avatar_url": "https://pbs.twimg.com/profile_images/1332980417549373440/O0UB_a2h.jpg", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_e