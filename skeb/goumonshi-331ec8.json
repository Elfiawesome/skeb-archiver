クター（人と話せるタイプの）\n\n上記の相手から一匹をゲーデさんがやりたい放題しているところを見てみたいです。\n描写可能そうでありましたら上位候補を優先的に一匹相手に選んで是非描いてもらえると嬉しいです。\nよろしくお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@goumonshi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3707251, "client_id": 27576, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/819a465d/uploads/origins/c3f1da07-5ad3-4aa1-9fb7-c9d1329e7f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19e0b0c76d1844766d7bd1abb5f5c913", "srcset": "https://si.imgix.net/819a465d/uploads/origins/c3f1da07-5ad3-4aa1-9fb7-c9d1329e7f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19e0b0c76d1844766d7bd1abb5f5c913, https://si.imgix.net/819a465d/uploads/origins/c3f1da07-5ad3-4aa1-9fb7-c9d1329e7f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=504c2fa3e25110dd04c272bd22805d2a 2x, https://si.imgix.net/819a465d/uploads/origins/c3f1da07-5ad3-4aa1-9fb7-c9d1329e7f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42c1d3707ff5510a0609e404cfacc606 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/819a465d/uploads/origins/c3f1da07-5ad3-4aa1-9fb7-c9d1329e7f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67e74d41474180cb16bf4402776063d8", "srcset": "https://si.imgix.net/819a465d/uploads/origins/c3f1da07-5ad3-4aa1-9fb7-c9d1329e7f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67e74d41474180cb16bf4402776063d8, https://si.imgix.net/819a465d/uploads/origins/c3f1da07-5ad3-4aa1-9fb7-c9d1329e7f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=feafb89f2bd11678de698a24f32228fd 2x, https://si.imgix.net/819a465d/uploads/origins/c3f1da07-5ad3-4aa1-9fb7-c9