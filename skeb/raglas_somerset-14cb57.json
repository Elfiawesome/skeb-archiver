01-8b4b-954d1373eea6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=deceedc8d34941bc7610bfb534f11085", "srcset": "https://si.imgix.net/bea2dbee/uploads/origins/e696a548-bc64-4401-8b4b-954d1373eea6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=deceedc8d34941bc7610bfb534f11085, https://si.imgix.net/bea2dbee/uploads/origins/e696a548-bc64-4401-8b4b-954d1373eea6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=afd5c2bfbfd0671cda016cee06d463b1 2x, https://si.imgix.net/bea2dbee/uploads/origins/e696a548-bc64-4401-8b4b-954d1373eea6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9daf60b56de5d113d9cec93b05b65f2d 3x"}, "body": "こんにちは\n前回も納品ありがとうございました\n今回は前回の納品以上にR18な、時のオカリナの大人リンクのイラストを依頼してもよろしいでしょうか？\n\nシチュエーションは以下のような感じです\n\nゲルドの砦でゲルド族に捕まってしまい\n\n・裸\n\n・前回のリオン同様、後ろ手胸縄縛りで縛り上げられて2本以上の縄で吊るされている\n体をしっかり吊るすため胸縄多め\n\n・足で抵抗できないよう太ももを縛られている\n(膝を描く場合は、膝も縛るようにお願いします)\n\n・太ももより下、もしくは膝より下は、描かなくても構いません(顔と腰上中心にお願いします)\nどちらを選ぶかはお任せします\n\n・背後にいるゲルドのお姉さんが両手を使って、リンクの後ろから胸と陰茎をそれぞれまさぐっている\n(リンクの陰茎をしごいているのも可)\n参考: https://www.pixiv.net/artworks/15980368\n\n・布の猿轡を噛まされ、噛み締めている\n参考:https://drive.google.com/file/d/1x6od84QgCJjZeKkwv4bc8NY-kMDvmtGl/view?usp=drivesdk\n\n\n・表情はお任せします(赤面して恥を感じていたり、嫌がっていたり、困惑していたりなど、様々考えられると思います)\n\n・ナビィについてはお任せします(あきビンに閉じ込められているとか、リンクを助ける隙を狙っているとかでもいいです)\n\nかなりR18な内容ですし、嫌なところがあれば断っても構いませんので、\nどうかよろしくお願いします", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@raglas_somerset/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 191554, "client_id": 719051, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7925e4c0/uploads/origins/30a0bb6d-f030-4ef0-903b-3f648222a279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5abe35887e3f58d6cc3b941c943cd9cd", "srcset": "https://si.imgix.net/7925e4c0/uploads/origins/30a0bb6d-f030-4ef0-903b-3f648222a279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5abe35887e3f58d6cc3b941c943cd9cd, https://si.imgix.net/7925e4c0/uploads/origins/30a0bb6d-f030-4ef0-903b-3f648222a279?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f348b1cf1bee62318efaa3eb1c8169b 2x, https://si.imgix.net/7925e4c0/uploads/origins/30a0bb6d-f030-4ef0-903b-3f648222a279?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e7fd67d80a8827d2de38c08a6cc9ae4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7925e4c0/uploads/origins/30a0bb6d-f030-4ef0-903b-3f648222a279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17048fba57a3216bb7020f039fdb5867", "srcset": "https://si.imgix.net/7925e4c0/uploads/origins/30a0bb6d-f030-4ef0-903b-3f648222a279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17048fba57a3216bb7020f039fdb5867, https://si.imgix.net/7925e4c0/uploads/origins/30a0bb6d-f030-4ef0-903b-3f648222a279?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f2465bd04542ed50eb488d7ced064e01 2x, https://si.imgix.net/7925e4c0/uploads/origins/30a0bb6d-f030-4ef0-903b-3f648222a279?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa0a6565c9e61f9edf10330a392cde1d 3x"}, "body": "お久しぶりです\n前回はトワリンの納品をありがとうございました！\n手数料無料期間なので依頼しますが、よろしいでしょうか？\n\n今回は「テイルズ　オブ　デスティニー」の「リオン・マグナス」というキャラをお願いしてもよろしいでしょうか？\n冷静ですが短気な、細身の美少年です(背は159cmと少し低いです)\n\nシチュエーションは以下のようにお願いします\n\n・裸(陰部は修正をお願いします)\n\n・キツく後ろ手胸縄縛り\n参考↓\nhttps://drive.google.com/file/d/1687mEZ39jRLmufBFjS-b8nQ9nKIas9mf/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1qQoWqK36hZe35C27wKk9yWWN1CrC9unZ/view?usp=drivesdk\n\n\n・顔より少し高い位置にある、フックか取手か何かに身体から伸びた縄が縛り付けられている\n\n\n・出来れば上半身にフォーカスして欲しいので、太ももより下は描かなくても構いません(描いても構いません)\n\n\n・表情は、↓の⚪︎のうちどちらかでお願いします\n\n⚪︎焦りながら、悔しがっている\nhttps://drive.google.com/file/d/15YTlnFVBs24YZFEC2zjWWI6IBVLDH6MZ/view?usp=drivesdk\n\n⚪︎焦りながら「どうする」といったふうに悩んでいる\nhttps://drive.google.com/file/d/17x1up6jl1bzpj7nWuczRMUQZBs1jDkzI/view?usp=drivesdk\n\n\nリオンの資料です↓\nhttps://drive.google.com/file/d/19AewPqPbKVyRWc-cuQSJaXxl_z7vPoFg/view?usp=drivesdk\n\nその他リオンの資料↓\nhttps://drive.google.com/drive/folders/10lpI4A5MOHxCFhh50G-pRPHMcLngNx0E\n\n断っても構いませんので、もし上記内容でよければ、どうかよろしくお願いします", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@raglas_somerset/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 191554, "client_id": 719051, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b1ad33c6/uploads/origins/20013f99-448c-427a-a179-aebad254b6be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d31100b0f3e33f8d1c23952008265cae", "srcset": "https://si.imgix.net/b1ad33c6/uploads/origins/20013f99-448c-427a-a179-aebad254b6be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d31100b0f3e33f8d1c23952008265cae, https://si.imgix.net/b1ad33c6/uploads/origins/20013f99-448c-427a-a179-aebad254b6be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23e0cecdd7c3858a7e01ea7b5d269a6f 2x, https://si.imgix.net/b1ad33c6/uploads/origins/20013f99-448c-427a-a179-aebad254b6be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a6bf6df5109956e81df920e002e98c2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1ad33c6/uploads/origins/20013f99-448c-427a-a179-aebad254b6be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5f3f897db334aae5bfff62ca2924e78", "srcset": "https://si.imgix.net/b1ad33c6/uploads/origins/20013f99-448c-427a-a179-aebad254b6be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5f3f897db334aae5bfff62ca2924e78, https://si.imgix.net/b1ad33c6/uploads/origins/20013f99-448c-427a-a179-aebad254b6be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a72b2171e5d384ed696896ca69f1c131 2x, https://si.imgix.net/b1ad33c6/uploads/origins/20013f99-448c-427a-a179-aebad254b6be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=357ad8bc20037b8f3a54aee7c37fd824 3x"}, "body": "こんばんは\nはじめまして\nいつもXでらぐです。さんの漫画を楽しみに読ませて貰っています！\n\nらぐです。さんはギャグ漫画をよく描いていますが、R-18イラストをお願いしてもよいでしょうか？\n\nキャラはトワリンでお願いします\n(トワイライトプリンセスのリンク)\n\nシチュエーションは以下のようにお願いします\n・裸orパンツ一枚(息吹の着ているものでも、他の物でも構いません)\n\n・緊縛、後ろ手胸縄縛り\n(ブレワイの世界でイーガ団に捕まっているような感じでお願いします)\n↓縛り方参考\nhttps://drive.google.com/file/d/1hw1tt6V95w73N7ydNqHWZwhuJveUVMeB/view?usp=drivesdk\n\nいつもの漫画のように白黒でも構いませんし、\nシチュエーションが好みでなかったり、解釈違いなど、何かありましたら断ってくださって構いません\nどうかよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@raglas_somerset/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 191554, "client_id": 2843264, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/659cee51/uploads/origins/9eca7e08-ecbf-4dbc-bf76-93250757edeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da6af33923cf75035608b93673ee1a00", "srcset": "https://si.imgix.net/659cee51/uploads/origins/9eca7e08-ecbf-4dbc-bf76-93250757edeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da6af33923cf75035608b93673ee1a00, https://si.imgix.net/659cee51/uploads/origins/9eca7e08-ecbf-4dbc-bf76-93250757edeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4eb1dced7f3714fb1684200f74103ca6 2x, https://si.imgix.net/659cee51/uploads/origins/9eca7e08-ecbf-4dbc-bf76-93250757edeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c24a169d7956af21f9ad40c2b38e16d9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/659cee51/uploads/origins/9eca7e08-ecbf-4dbc-bf76-93250757edeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad276f9d529f7bc3c6a5cf6c94a9f333", "srcset": "https://si.imgix.net/659cee51/uploads/origins/9eca7e08-ecbf-4dbc-bf76-93250757edeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad276f9d529f7bc3c6a5cf6c94a9f333, https://si.imgix.net/659cee51/uploads/origins/9eca7e08-ecbf-4dbc-bf76-93250757edeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5bb67c8690a0b657d87793825b87f9d2 2x, https://si.imgix.net/659cee51/uploads/origins/9eca7e08-ecbf-4dbc-bf76-93250757edeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=305a17d1e8490b506f7a69f4cbb84d54 3x"}, "body": "お世話になっております。ベニスズメです。\n「グウェント」というカードゲームで利用しているアイコンをずっとイラストにしたかったので、お願いしたいという内容のリクエストです。\n\nこちらがそのグウェントのアカウントです。\nhttps://twitter.com/NipponGwent\n\n元になっている絵は「マグネ師団」というタイトルがついています。こちらで最大解像度の画像が手に入ります。\nhttps://gwent.one/image/gwent/assets/card/art/max/1348.png\n\n【マグネ師団について】\nマグネ師団は、大国ニルフガードの辺境の地であるコラス砂漠を守っている（左遷組の）軍団です。\n一番手前にいるヒゲが生えている兵士をモデルにしてイラスト化してもらいたいです。\nグウェントはシリアスな絵が多いゲームですが、ツイッターのアイコンに関してはイラスト調にしたいと思っていました。今のらぐさんのskebアイコンのぐらいデフォルメしたポップさを希望待します。\n\n【描いて欲しい要素】\n- 鉄兜\n- ヒゲ\n- 太陽の紋章（ニルフガード帝国の意匠）\n- （可能であれば）ハルバートを担いでいる感じ\n\n資料URLは他のグウェントのニルフガードアートのリンク先です。インスピレーションのご参考にどうぞ。\n\nよろしくご検討ください。\n\nhttps://gwent.one/jp/cards/?faction=4&type=2&v=11.7.0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 25243, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "直夜", "screen_name": "naoyaKG", "avatar_url": "https://pbs.twimg.com/profile_images/2049720427422044160/UYQP33JL.jpg", "header_url": "https://pbs.twim