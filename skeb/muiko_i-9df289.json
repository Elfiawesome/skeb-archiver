ac6/uploads/origins/1ce64cfd-af14-4540-a6b5-192c938119a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4cd142fc487762f17893932d75c5d26", "srcset": "https://si.imgix.net/3fbb6ac6/uploads/origins/1ce64cfd-af14-4540-a6b5-192c938119a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4cd142fc487762f17893932d75c5d26, https://si.imgix.net/3fbb6ac6/uploads/origins/1ce64cfd-af14-4540-a6b5-192c938119a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=91b80c7fc48e167a505e001bcd8bf112 2x, https://si.imgix.net/3fbb6ac6/uploads/origins/1ce64cfd-af14-4540-a6b5-192c938119a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9bd9bc5fcae963740832dbe0d0b66171 3x"}, "body": "始めまして。\nもしよろしければ、以下のような流れの作品をお願いできますでしょうか。\n・登場キャラはマズルのある狼獣人とメデューサの女性の二人\n・二人は友達でスポーツタイプで、ボクシングでスパーリング中\n・少し汗を流す定度のつもりが熱が入ってしまい、狼獣人の右ストレートをかわしたタイミングで力んでしまいメデューサが魔眼を発動してガッツリ目線を合わせてしまう\n・狼獣人は右ストレートのポーズで瞬間で石化してしまい、メデューサはやらかしをその石像に謝っている\n\nという内容を、可能で有りましたらお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@muiko_i/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3383836, "client_id": 1027269, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8f6541f/uploads/origins/692f0aa4-1cc2-47cf-8dea-01494d3d3807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f76124dde1e6d212033637d399f98a8", "srcset": "https://si.imgix.net/f8f6541f/uploads/origins/692f0aa4-1cc2-47cf-8dea-01494d3d3807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f76124dde1e6d212033637d399f98a8, https://si.imgix.net/f8f6541f/uploads/origins/692f0aa4-1cc2-47cf-8dea-01494d3d3807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e845fb7388127d4f490c21bc727d916a 2x, https://si.imgix.net/f8f6541f/uploads/origins/692f0aa4-1cc2-47cf-8dea-01494d3d3807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09ffec04af038ec8f3bfb367020d1306 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8f6541f/uploads/origins/692f0aa4-1cc2-47cf-8dea-01494d3d3807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef76afe7f0d1df8504f824baa2110ed4", "srcset": "https://si.imgix.net/f8f6541f/uploads/origins/692f0aa4-1cc2-47cf-8dea-01494d3d3807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef76afe7f0d1df8504f824baa2110ed4, https://si.imgix.net/f8f6541f/uploads/origins/692f0aa4-1cc2-47cf-8dea-01494d3d3807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb345ca091e8f14d7f3a4f1ba76dd91a 2x, https://si.imgix.net/f8f6541f/uploads/origins/692f0aa4-1cc2-47cf-8dea-01494d3d3807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c01ad480bc12df833b4801499485a442 3x"}, "body": "クリエイター様のXでの、黒髪で眉が太い少年についての投稿を見て、是非拝見したいと思いリクエストしました。\n\n依頼内容：モノクロイラスト2枚（セリフなし）\n\n\n【1枚目】中学校の卒業式を終えた息子と、頭を撫でる父の腕\n\n息子（中学３年生）：黒髪でえり足を少し刈り上げた髪型、少し太めの眉、中学３年生らしい初々しさ、ブレザーの制服\n\n父：スーツの腕のみ\n\n\n【2枚目】高校の入学式を終えた息子と、頭を撫でる父の腕\n\n息子（高校1年生）：坊主頭（野球部に入る為）、学ランの制服\n\n父：スーツの腕のみ\n\n\n具体的な場面やその他必要な設定はお任せします。\nそれぞれの場面の息子の表情はお任せします（クリエイター様のご解釈を拝見したいです）\n\nご検討をよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@muiko_i/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/afd16252/uploads/origins/5b78fdd7-ea2c-4f03-888a-246ac4070424?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f738105e10417110cac98f3a0cc17755", "srcset": "https://si.imgix.net/afd16252/uploads/origins/5b78fdd7-ea2c-4f03-888a-246ac4070424?bg=%