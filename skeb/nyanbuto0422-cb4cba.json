せいたします。\n・宛名/人物/背景を分けた、psdまたはpngデータの納品を希望いたします。\n\n【参考資料】\nhttps://drive.google.com/drive/u/2/folders/1zTHKVZCp21w7Al2L-O0df5EpJ9W9jyD4\n\nご検討の程よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nyanbuto0422/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3072565, "client_id": 300145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/598c2f7a/uploads/origins/eda4194d-db17-444f-9b2c-66b992a2bf12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36bcfe2260bac0fb42ab8648a84bd7a9", "srcset": "https://si.imgix.net/598c2f7a/uploads/origins/eda4194d-db17-444f-9b2c-66b992a2bf12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36bcfe2260bac0fb42ab8648a84bd7a9, https://si.imgix.net/598c2f7a/uploads/origins/eda4194d-db17-444f-9b2c-66b992a2bf12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0a4a1f0dacfdfda1592936e065bcebf 2x, https://si.imgix.net/598c2f7a/uploads/origins/eda4194d-db17-444f-9b2c-66b992a2bf12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed191f6066c82979b9592984cc85a4be 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/598c2f7a/uploads/origins/eda4194d-db17-444f-9b2c-66b992a2bf12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7675694099d5e03e7090ddc6a4a45c5", "srcset": "https://si.imgix.net/598c2f7a/uploads/origins/eda4194d-db17-444f-9b2c-66b992a2bf12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7675694099d5e03e7090ddc6a4a45c5, https://si.imgix.net/598c2f7a/uploads/origins/eda4194d-db17-444f-9b2c-66b992a2bf12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8a6465873a5358acfe28e746a36b6e4d 2x, https://si.imgix.net/598c2