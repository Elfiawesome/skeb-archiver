した。透明感のあるシックな色遣いが素敵です。\n\n今回は、TRPGで使用しているOCキャラクター二人のミニキャラをお願いしたいです。\n資料先にはほかのキャラクターの画像も入っていますが、銀髪の「ヴァレリー」と「フェオドラ」というキャラクターを描いていただきたいです。二人は兄妹です。\n\n用途は主に観賞用、個人・非商用の範囲です。製作者様を明記の上でご依頼した作品や資料としてSNSやサイトなどに掲載させていただく可能性があります。\n\n表情は二人とも微笑、ポーズなどはお任せします。デザインは描きやすく省略したり変更したりして大丈夫です。\n\nお手隙おかけし恐縮ですが、不都合がありましたらキャンセルや再送をお願いいたします。\n以上です、リクエストを読んでいただきありがとうございました！ご縁がありましたらよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1YDXrNDlzb3q_lB6kXRI7FEyyX8BMJhfL", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@04IN1/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/daef8728/uploads/origins/69e64047-2001-4dc0-a136-eb5a0f0b6089?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa133575b857bd7a7ab5eeef869ab6d5", "srcset": "https://si.imgix.net/daef8728/uploads/origins/69e64047-2001-4dc0-a136-eb5a0f0b6089?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa133575b857bd7a7ab5eeef869ab6d5, https://si.imgix.net/daef8728/uploads/origins/69e64047-2001-4dc0-a136-eb5a0f0b6089?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1fc52a15f07655ec893e8f0fcf98c0cf 2x, https://si.imgix.net/daef8728/uploads/origins/69e64047-2001-4dc0-a136-eb5a0f0b6089?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7f34a1683156c5df2e21afe5b00649f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3456963, "client_id": 2997122, "nc": 1}, {"path": "/@04IN1/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "cr