ありがとうございます！\n\n孫悟空をモチーフにした私の猿娘OCを、オルタナ系の女の子っぽいスタイルで描いていただけますか？？ いつもの衣装とはまったく違う服装にしてほしくて、たとえばゴシック風のスカートに体のラインが出るトップス、ボーダー柄のニーハイ、厚底ブーツ、重ねたベルトやチェーン、それに可愛いオルタナ系のアクセサリーなどを合わせていただけたら嬉しいです。\n\n孫悟空らしい特徴は分かるように残しつつ、おしゃれでエッジの効いた、少し遊び心のある雰囲気にしてください。衣装のデザインや絵柄は、ご自身のスタイルで自由にアレンジしていただいて大丈夫です。よろしくお願いします！\n\nhttps://drive.google.com/drive/u/1/folders/1RuP4RVJR7SzWWeRzG19dNu9a24w2IxCy", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nobuozi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3766424, "client_id": 4039436, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a227b098/uploads/origins/93b03bab-ed85-4d08-95eb-ba9c82bcab55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d15ea1640b9ac447df47db7f6c402f79", "srcset": "https://si.imgix.net/a227b098/uploads/origins/93b03bab-ed85-4d08-95eb-ba9c82bcab55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d15ea1640b9ac447df47db7f6c402f79, https://si.imgix.net/a227b098/uploads/origins/93b03bab-ed85-4d08-95eb-ba9c82bcab55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ec1bf4b027d06424ccf0102ac4e6b41 2x, https://si.imgix.net/a227b098/uploads/origins/93b03bab-ed85-4d08-95eb-ba9c82bcab55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed2e2e8dbe8abbaf6be62157508f622c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a227b098/uploads/origins/93b03bab-ed85-4d08-95eb-ba9c82bcab55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e024f4b0126c31a7fc66d1861def6186", "srcset": "https://si.imgix.net/a227b098/uploads/origins/93b03bab-ed85-4d08-95eb-ba9c82bcab55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e024f4b0126c31a7fc66d1861def6186, https://si.imgix.net/a227b0