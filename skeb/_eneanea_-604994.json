a58-bb32-27aa2757d0f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfd157644da663111d14c2bb012ebeca, https://si.imgix.net/8d1f5756/uploads/origins/146bc36b-0906-4a58-bb32-27aa2757d0f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e844fb622f05d2d796aee0afc2a2fa9a 2x, https://si.imgix.net/8d1f5756/uploads/origins/146bc36b-0906-4a58-bb32-27aa2757d0f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e62f194cc08d77b62bc968e2d897d06d 3x"}, "body": "紅百合えねあ様  \nはじめまして、ふーみんと申します。 \nskebで見かけた先生のイラストがとても素敵で、ぜひ推しのVTuberである 音ノ瀬しきさんを描いていただきたいと思い、リクエストを送らせていただきました。  \n\n<希望の構図> \nhttps://skeb.jp/@_eneanea_/works/4\n構図や表情は上記のような感じにしていただけると嬉しいです。\n衣装に関しては、色っぽい感じのルームウェアなどにしていただけると嬉しいです。\n髪の毛や肩等は見切れないようにしていただけると嬉しいです。\n\n <使用用途> \n・PC壁紙、印刷して飾る等の個人用途 \n・ファンアートとして音ノ瀬しきさんへのプレゼント \n・音ノ瀬しきさんの各種活動への利用 (各種SNSへの投稿、YouTubeチャンネルを始めとした配信サムネイルでの使用等)  \n\n<音ノ瀬しきさんについて> \n宇宙と歌とASMRが好きな女の子です。 とくにASMR（おもに綿棒や耳かきを利用）の配信を行い、 リスナーを癒すことに重点を置いた内容が多いです。  \n\n<詳細>\n 目の下にほくろが２つあります。\n 肩にタトゥーがあり E＝mc2 とアインシュタインの筆跡で書いてあります。 \nアクセサリーやキャラデザなどは x、リットリンクを参考にして頂けると幸いです。 \nリットリンク：lit.link/otonoseshiki \nX：x.com/otonose_shiki?s=21  \n\n<ファイル形式等> \n人物透過の差分を作っていただけると嬉しいです。 もし差分を作っていただけるのであれば、psdでもいただけるとなお嬉しいです。 \npsdが不可でしたら、人物透過のpngをいただけると嬉しいです。 \n skebやイラスト依頼に不慣れで、不備などあれば申し訳ございません。 \nご多忙な中、大変恐縮ではございますがご検討いただけましたら幸いです。 よろしくお願いいたします。\n\nlit.link/otonoseshiki", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_eneanea_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2804150, "client_id": 3231507, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d2d9dd66/uploads/origins/6bccddbc-8fc5-4f8f-ad5b-bbeef9eb8cde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f84c8ba8f20330004fabd757db507e3f", "srcset": "https://si.imgix.net/d2d9dd66/uploads/origins/6b