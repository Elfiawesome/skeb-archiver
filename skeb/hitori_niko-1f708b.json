ルにリードをつけたり、ポケモンのような見た目に変えたり、服や小物を加えたり、どんなポーズや行動でも自由に選んでください！怒っている、野性的な、慌てているといった表情や雰囲気も、何でも描いていただいて構いません。\n\n参考資料と過去の作品へのリンクをDriveに貼っておきました！\n\nhttps://drive.google.com/drive/folders/1Z-Xf86T9QYnWvg4X1zJ4RgQAOd6CPp4j?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hitori_niko/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3761824, "client_id": 1681553, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe666fc0/uploads/origins/afeccf4a-6867-45ec-b76b-f6fe1b3c078b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73dc9385adbfd178e1733653c95fa8ab", "srcset": "https://si.imgix.net/fe666fc0/uploads/origins/afeccf4a-6867-45ec-b76b-f6fe1b3c078b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73dc9385adbfd178e1733653c95fa8ab, https://si.imgix.net/fe666fc0/uploads/origins/afeccf4a-6867-45ec-b76b-f6fe1b3c078b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa3c2079e7537210181b935e40af4072 2x, https://si.imgix.net/fe666fc0/uploads/origins/afeccf4a-6867-45ec-b76b-f6fe1b3c078b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6dfbb5934997dd6e03a984f6d0f5fd3a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe666fc0/uploads/origins/afeccf4a-6867-45ec-b76b-f6fe1b3c078b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a4c16a6d4ca042a5934140c6d14ed61", "srcset": "https://si.imgix.net/fe666fc0/uploads/origins/afeccf4a-6867-45ec-b76b-f6fe1b3c078b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a4c16a6d4ca042a5934140c6d14ed61, https://si.imgix.net/fe666fc0/uploads/origins/afeccf4a-6867-45ec-b76b-f6fe1b3c078b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur