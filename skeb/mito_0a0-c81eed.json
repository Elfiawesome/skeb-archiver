や構図などはmito様にお任せしたいと思っておりますので、お気軽に描いてください！\n\nもし依頼内容に難しい点か問題点があれば、是非断ってください。\nご検討のほど、宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1zme8Lu3By7Ay44m-CSSQKymAQRRT0M-a?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mito_0a0/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1340772, "client_id": 1365142, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/530de1c7/uploads/origins/8f630da0-f2d7-4305-8443-78bccd7073fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a92d7638abdbb5b73c412085b2a1872f", "srcset": "https://si.imgix.net/530de1c7/uploads/origins/8f630da0-f2d7-4305-8443-78bccd7073fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a92d7638abdbb5b73c412085b2a1872f, https://si.imgix.net/530de1c7/uploads/origins/8f630da0-f2d7-4305-8443-78bccd7073fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=720063e8040e99a111830ddd2647be4b 2x, https://si.imgix.net/530de1c7/uploads/origins/8f630da0-f2d7-4305-8443-78bccd7073fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d915987a07f92dd32a3b1cab18b0d614 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/530de1c7/uploads/origins/8f630da0-f2d7-4305-8443-78bccd7073fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f3f9019bdd1e171b485a81f0e528f9e", "srcset": "https://si.imgix.net/530de1c7/uploads/origins/8f630da0-f2d7-4305-8443-78bccd7073fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f3f9019bdd1e171b485a81f0e528f9e, https://si.imgix.net/530de1c7/uploads/origins/8f630da0-f2d7-4305-8443-78bccd7073fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a4ec288cb0957de0d43feb5a2238901f 2x, https: