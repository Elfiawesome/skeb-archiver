いただければと思います。\n（前髪は片目隠れでお願いします。表情豊かだとうれしいです。）\n\n\n\n人物の透過PNGかPSDを合わせて頂ければ嬉しいです。\n\n\n用途はXでの投稿や収益化したライブ配信や動画、アイコンやヘッダー使用、ネットプリント、グッズ、ファンボックスなどのVTuberとしての活動で使用させていただければと思っております。\n\n資料は下記URLから確認していただければと思います。\n\n\n\nスケブでの依頼は慣れていないので至らない点があると思いますが、よろしくお願いします。\n\n\n\n\n\nhttps://lit.link/mewaurora\n\nhttps://lit.link/mewaurora", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 3041467, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "石田ゆう", "screen_name": "owk_bsh_yy", "avatar_url": "https://pbs.twimg.com/profile_images/1776611102857838592/fIZWm1_8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1294685677796257795/1717852289/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 176}, {"id": 3378887, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "お引越ししました。", "screen_name": "h75XqNz1OyVHRvt", "avatar_url": "https://pbs.twimg.com/profile_images/1932926665933664256/3rLizxaQ.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 3570312, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "せつな🐱🐟️", "screen_name": "setuna_neru", "avatar_url": "https://pbs.twimg.com/profile_images/2073406515520905216/tHc0zG2D.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1904409538931138560/1778680553/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_reque