ads/origins/a68a28f4-9de2-4013-80e2-7e56f1952324?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55ab40e074a519de9d3edd899ea93305", "srcset": "https://si.imgix.net/4d2ad01a/uploads/origins/a68a28f4-9de2-4013-80e2-7e56f1952324?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55ab40e074a519de9d3edd899ea93305, https://si.imgix.net/4d2ad01a/uploads/origins/a68a28f4-9de2-4013-80e2-7e56f1952324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aba0a2541ad30118025218836fccd0b4 2x, https://si.imgix.net/4d2ad01a/uploads/origins/a68a28f4-9de2-4013-80e2-7e56f1952324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f0c6a9c2b43a29efd98efe2e9f8e85f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d2ad01a/uploads/origins/a68a28f4-9de2-4013-80e2-7e56f1952324?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd4eac26f075819a4850518eba2eb43a", "srcset": "https://si.imgix.net/4d2ad01a/uploads/origins/a68a28f4-9de2-4013-80e2-7e56f1952324?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd4eac26f075819a4850518eba2eb43a, https://si.imgix.net/4d2ad01a/uploads/origins/a68a28f4-9de2-4013-80e2-7e56f1952324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2869da0d25ce845bd4bce4792278e97b 2x, https://si.imgix.net/4d2ad01a/uploads/origins/a68a28f4-9de2-4013-80e2-7e56f1952324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f77973d98bf324420f9301a1afce3cd6 3x"}, "body": "唐揚げ先生、初めまして！\n個人VSingerのAurenthelと申します。\nもし宜しければ、私のキャラクターを描いて頂けますか？\n\n歌ったり絵を描いたりするのが好きな穏やかで神秘的なキャラです。\n中華伝説の人魚に基づく、涙は真珠になります。\nモチーフは黒金魚、水墨画、真珠とお水です。\n\nデザインの注意点：\n・髪のインナーカラーは透明な水みたいな印象を与える\n・毛先は水の波になる\n・首の周りの三日月のパターン（うろこ）\n・メイン衣装のキラキラなアクセサリーは宝石じゃなくて魚のうろこ\n\n資料の衣装どれを選んでも良いし、お好きなようにアレンジしても大丈夫です！\n儚くて美しい雰囲気があればキャラに似合うと思いますが、暗くてミステリアスの感じ等もとても気に入ります！\n先生のセンスが大好きで、詳細を全部お任せしたいと思います。\n\n可能でしたら宛名、背景、人物でレイヤー分けのpsdを頂けますと幸いです。\n\nイラストを配信、SNS、投稿等で使用させていただく予定です。\n新しい衣装をデザインして頂けたら、他の依頼でもお願いする可能性があります。\n\nお手数ですが、ご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/10rVTX7cY9urPa4hCLAtDR4tJ55PZnors?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@XXJ/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d82d87b7/uploads/origins/5dd1e653-5626-40db-8c25-d6f8bf16bfe9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55f9ab21d72a363c9d11bf037d25289b", "srcset": "https://si.imgix.net/d82d87b7/uploads/origins/5dd1e653-5626-40db-8c25-d6f8bf16bfe9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55f9ab21d72a363c9d11bf037d25289b, https://si.imgix.net/d82d87b7/uploads/origins/5dd1e653-5626-40db-8c25-d6f8bf16bfe9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41423a7d4acb1f528e1d23c2a7067b9c 2x, https://si.imgix.net/d82d87b7/uploads/origins/5dd1e653-5626-40db-8c25-d6f8bf16bfe9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d185426269c1b196d3c49dc28638020 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 234092, "client_id": 2942646, "nc": 16}, {"path": "/@XXJ/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 234092, "client_id": 2813992, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f366924/uploads/origins/82ad9d72-8a9d-4e17-939