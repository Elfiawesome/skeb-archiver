制我的跑团pc！！₍ᐢ‥ᐢ₎ ♡\n\n角色是有点自我的三无人机，性格淡淡的没什么情绪起伏。平时喜欢说一些冷笑话。是爱好看动漫打游戏的宅女。外貌年龄在24岁左右，165cm。\n参考图里偏幼态脸的一般是个人手癖or画师手癖，如果可以的话还是尽量将她画得冷漠一些即可！\n\n想看到的场景是美国城市的夜景（bgm帝国少女）；又或者是结合“风平浪静的蓝调时刻/大海/船只/吹风/海鸥”类似元素的场景。\n构图，衣着方面都可以由老师您自由发挥！\n\n如果可以的话，希望老师最后能发送一份带有to签的psd图层～非常感谢！\n\nhttps://drive.google.com/drive/folders/1AueHCYYbPOy8MZwxaJffMWKtO-ZU0OLs", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@XXJ/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 234092, "client_id": 1878743, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a947c20/uploads/origins/770d53ac-c088-45e7-98dd-b58af6497189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb6b97b1a119369592ccfd939f8e4480", "srcset": "https://si.imgix.net/7a947c20/uploads/origins/770d53ac-c088-45e7-98dd-b58af6497189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb6b97b1a119369592ccfd939f8e4480, https://si.imgix.net/7a947c20/uploads/origins/770d53ac-c088-45e7-98dd-b58af6497189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4dc5890d1a3b2331e46bba5011fe0d61 2x, https://si.imgix.net/7a947c20/uploads/origins/770d53ac-c088-45e7-98dd-b58af6497189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc7509d81cb54eb4900737a97d9c808b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a947c20/uploads/origins/770d53ac-c088-45e7-98dd-b58af6497189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=678eba10d13b3bb8489574125780a7b7", "srcset": "https://si.imgix.net/7a947c20/uploads/origins/770d53ac-c088-45e7-98dd-b58af6497189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=678eba10d13b3bb8489574125780a7b7, https://si.imgix.net/7a947c20/uploads/origins/770d53ac-c088-45e7-98dd-b58af6497189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1cba9ddf36566d04a1bf2c3326dda691 2x, https://si.imgix.net/7a947c20/uploads/origins/770d53ac-c088-45e7-98dd-b58af6497189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3806c7e71fed5eb36cf1b68f6590e7d7 3x"}, "body": "はじめまして、以前からずっと唐揚げ様のイラストが大好きで、今回ご依頼をさせていただけることをとても嬉しく思います！\n\n---\n\n▼キャラクター詳細\n\nこのキャラクターは創造と破壊を司る、二つの顔を持つ神です。目は細めており、耳はなく、血液は金色の液体です。普段は非常にのんびりとした性格ですが、激怒や絶望の時だけ別の姿に変わります。両方の姿とも、自分の金色の血液を様々な武器に変えて攻撃します。破壊神は敵の頭上に自分と同じ光環を出して、敵の行動や思考をコントロールし精神を汚染します。\n\nキャラクターがスチームパンクと中世の城が融合した高所にしゃがみ、マントが風になびいている場面を描いてほしいです。\n\n---\n\n可能であればPSDファイル形式でお願いいたします。\n用途：SNSのプロフィール画像使用、個人利用での印刷・コレクション用。\n商用利用はいたしません。\n\n価格が低すぎる、または懸念がある場合は再度ご連絡いただけると幸いです。\nリクエストをお読みいただき、ご検討いただき本当にありがとうございます。\nもしこのリクエストが不適切でしたら、どうぞお気軽にキャンセルしてください。\n\n---\n\nhttps://drive.google.com/drive/folders/1BuhXrp3nOhJVgUiIFIQqZZorLfPo4gYO?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@XXJ/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 234092, "client_id": 1629238, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f5144cf/uploads/origins/72be9af9-2736-4dfa-8707-0be91cef79d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80b1f6f38525c0480bc33e6d63e73271", "srcset": "https://si.imgix.net/3f5144cf/uploads/origins/72be9af9-2736-4dfa-8707-0be91cef79d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80b1f6f38525c0480bc33e6d63e73271, https://si.imgix.net/3f5144cf/uploads/origins/72be9af9-2736-4dfa-8707-0be91cef79d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d28305b37f215b2530cc5afcfdfdf7b4 2x, https://si.imgix.net/3f5144cf/uploads/origins/72be9af9-2736-4dfa-8707-0be91cef79d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&