at%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2ec9bc3f4c6239a16b6f46655037113a 3x"}, "body": "Hello 鮫福叶夢-san! I saw your post online and your art is wonderful!\n\nWould it be possible to draw a fullbody image of my character, Seiryu Amuro? She's a dragon who lives alone up in the mountains of China who takes care of a temple and space observatory. She is fairly low energy and has a doting big sister vibe to her.\n\nPlease keep the character as a separated layer from the background. I leave the pose and everything else up to you. Thank you!!!\n\nhttps://drive.google.com/drive/folders/1VueFWlfi69UCVG4lzttZg9AqlOt_4SBD", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@samefuku_kn/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": true, "creator_id": 3648681, "client_id": 3483168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55066e8e/uploads/outputs/c67dbcfd-850f-47dc-8f44-853f09d2471f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=219c02b30ddc56013567cc35b10271bf", "srcset": "https://si.imgix.net/55066e8e/uploads/outputs/c67dbcfd-850f-47dc-8f44-853f09d2471f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=219c02b30ddc56013567cc35b10271bf, https://si.imgix.net/55066e8e/uploads/outputs/c67dbcfd-850f-47dc-8f44-853f09d2471f?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=669d1684e25f41faa6ea206c382d57bf 2x, https://si.imgix.net/55066e8e/uploads/outputs/c67dbcfd-850f-47dc-8f44-853f09d2471f?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc89462cb5882c33e59eacfa91919733 3x"}, "duration": 11, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55066e8e/uploads/outputs/c67dbcfd-850f-47dc-8f44-853f09d2471f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=702a9ed8d11018db5dfcc28d46cd09af", "srcset": "https://si.imgix.net/55066e8e/uploads/outputs/c67dbcfd-850f-47dc-8f44-853f09d2471f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=702a9ed8d11018db5dfcc28d46cd09af, https://si.imgix.net/55066e8e/uploads/outputs/c67dbcfd-850f-47dc-8f44-853f09d2471f?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fb5d95a72d478ddb7fad926107569e2f 2x, https://si.imgix.net/55066e8e/uploads/outputs/c67dbcfd-850f-47dc-8f44-853f09d2471f?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=319d6a47db47b8d3e12adbff107a52b6 3x"}, "body": "こんばんは、ネットで声優活動をしております、梓亜（しあ）と申します。\n鮫福叶夢さまの描かれるポップでかわいらしい子イラストに一目惚れしまして、ぜひ御依頼をしたく参りました。ご検討いただけますと幸いです。\n\n◯イラストについて\n声優活動にあたり、私自身のイメージキャラクターにあたるアバターのムービーをお願いしたいです。\n使用用途としてはYouTube配信を今後はじめるため、配信内でのオープニングまたはエンディングにて使用予定となります。\n雰囲気、構図、描写範囲などすべてお任せいたします。何でも嬉しいです！可能であればYouTubeにて使用しやすいサイズですとうれしいです。\n\n◯キャラクターについて\n髪は淡いオレンジ、長さはふわふわしていて背中より長ければぐらいで特に決まっておりません。前髪上の二又に別れている部分が特徴なのでそちらの描写のみ必ずいただけますと幸いです。\n目は紫〜藍色と黄色寄りのオレンジで朝焼けのようなイメージです。\nまた、参考までに好きなものは絵本の読み聞かせ、ハッピーエンドや童話のようなおはなし、星やアクセサリーやライトなどキラキラしたものやクリスマス、ぬいぐるみなどキャラクターもの、リボンにレースにアンティークなものなどかわいいものとなります。\n\n以上となります…！もしよろしければご検討いただけますと幸いです。\n\nアカウント→https://x.com/maigoing_shia?t=VlAYietzeQ7dVeM0C9VvLg&s=09\n資料\n→https://drive.google.com/drive/folders/1lOS9F3XoJbEeFebaqtjzxAyMbzoYLn8b?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@samefuku_kn/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 3648681, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/79ec3eb4/uploads/outputs/bbda6d8a-406c-448e-bb94-38d259484555?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=b4fee132c4dd65815439a223058d81c9", "srcset": "https://si.imgix.net/79ec3eb4/uploads/outputs/bbda6d8a-406c-448e-bb94-38d259484555?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=b4fee132c4dd65815439a223058d81c9, https://si.imgix.net/79ec3eb4/uploads/outputs/bbda6d8a-406c-448e-bb94-38d259484555?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=20eca5a63672b461b9f48bc7a22e43cb 2x, https://si.imgix.net/79ec3eb4/uploads/outputs/bbda6d8a-406c-448e-bb94-38d259484555?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=efd247925b208155265138d9b6c62954 3x"}, "duration": 10, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/79ec3eb4/uploads/outputs/bbda6d8a-406c-448e-bb94-38d259484555?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=25f930551aff8cd177ef50e5a6114010", "srcset": "https://si.imgix.net/79ec3eb4/uploads/outputs/bbda6d8a-406c-448e-bb94-38d259484555?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=25f930551aff8cd177ef50e5a6114010, https://si.imgix.net/79ec3eb4/uploads/outputs/bbda6d8a-406c-448e-bb94-38d259484555?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2db11d90615a724a9d139fb1d8289914 2x, https://si.imgix.net/79ec3eb4/uploads/outputs/bbda6d8a-406c-448e-bb94-38d259484555?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d910295ac518aeb88457d43bc2dcff91 3x"}, "body": "初めまして。Twitchで活動している者です。\nXで募集を拝見してこちらに参りました。\n\nOCを描いて頂きたいです。\n衣装はシスターだと嬉しいです。その他のお洋服でも大丈夫です。お好きに描いて下さると嬉しいです！\n\n\n\nhttps://drive.google.com/drive/folders/11Ltea7loJu4IYV_PNLWUPfMj3RN99RvF\n\n使用用途（未定含む）\nTwitch（収益化済み）\nYouTube（収益化済み）\nX\n\nご検討よろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@samefuku_kn/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3648681, "client_id": 1060433, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f57a39e/uploads/origins/b0d358f3-5511-4705-ab60-490123f7f0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ad8d44f0d83f62cd6941a64c1cfea5d", "srcset": "https://si.imgix.net/0f57a39e/uploads/origins/b0d358f3-5511-4705-ab60-490123f7f0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ad8d44f0d83f62cd6941a64c1cfea5d, https://si.imgix.net/0f57a39e/uploads/origins/b0d358f3-5511-4705-ab60-490123f7f0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3aee8107383f02c4401e5cc1824a3570 2x, https://si.imgix.net/0f57a39e/uploads/origins/b0d358f3-5511-4705-ab60-490123f7f0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef379497edc8b2b8ceee2164f77c4acc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f57a39e/uploads/origins/b0d358f3-5511-4705-ab60-490123f7f0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd96c3fe76eb501230ce71527a32f04c", "srcset": "https://si.imgix.net/0f57a39e/uploads/origins/b0d358f3-5511-4705-ab60-490123f7f0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd96c3fe76eb501230ce71527a32f04c, https://si.imgix.net/0f57a39e/uploads/origins/b0d358f3-5511-4705-ab60-490123f7f0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b8814b2455acd11545729c78474f6c17 2x, https://si.imgix.net/0f57a39e/uploads/origins/b0d358f3-5511-4705-ab60-490123f7f0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7f635cb083042c84a2957e3fb48949ac 3x"}, "body": "ご無沙汰しております、なゃんです。\n以前頼んだ際の雪海のイラストが本当にかわいかったので、別の子でも描いていただきたい！と思い、依頼させていただきます。\n依頼の内容については以下の通りとなります。\n\n【描いていただきたいもの】\nTRPGで作成したうちの子、四季清　由弦（しきせ　ゆづる）をお願いします。\n中学時代からの付き合いである後輩と一緒に、探偵事務所を営んでいる女性です。\n才覚に溢れ、正義感も強く、冷静な振る舞いで鮮やかに依頼を解決に導くお嬢様です。\n長文で恐縮ですが、詳細な設定や立ち絵は資料URLをご確認ください。\n\n【シチュエーション・構図・衣装など】\nシチュエーションや構図はお任せいたします。\n衣装についてはお手数なのですが、かわいい系の私服でお願いします（ディテールはおまかせします）。\n\nおまかせしてしまう部分が多く、お手数をお掛けして申し訳ございません。\n難しいようでしたら、リクエストを蹴って頂いても構いません。\nお忙しいところたいへん申し訳ございませんが、ご検討いただけますと幸いです。\n\nhttps://iachara.com/view/15090024", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@samefuku_kn/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3648681, "client_id": 1060433, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c266393e/uploads/origins/eecd659e-f1d5-45d0-99ce-1f321ae8e2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0beb4fc04d995e94820c7ec59f9a0a6", "srcset": "https://si.imgix.net/c266393e/uploads/origins/eecd659e-f1d5-45d0-99ce-1f321ae8e2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0beb4fc04d995e94820c7ec59f9a0a6, https://si.imgix.net/c266393e/uploads/origins/eecd659e-f1d5-45d0-99ce-1f321ae8e2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d67594f60c2cc92b3f96233b40c8f32 2x, https://si.imgix.net/c266393e/uploads/origins/eecd659e-f1d5-45d0-99ce-1f321ae8e2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c60386d8c99e0d84992bb6b1512a86ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c266393e/uploads/origins/eecd659e-f1d5-45d0-99ce-1f321ae8e2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=165136bb0d76122e9ad878d44942bc30", "srcset": "https://si.imgix.net/c266393e/uploads/origins/eecd659e-f1d5-45d0-99ce-1f321ae8e2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=165136bb0d76122e9ad878d44942bc30, https://si.imgix.net/c266393e/uploads/origins/eecd659e-f1d5-45d0-99ce-1f321ae8e2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8080d411df5d0c8c5670c3dd3bf9b160 2x, https://si.imgix.net/c266393e/uploads/origins/eecd659e-f1d5-45d0-99ce-1f321ae8e2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7776fe8245e9c0083e4e8ad35eea4013 3x"}, "body": "はじめまして。なゃんと申します。\n　鮫福様のイラストをTwitterで拝見してとても惹かれまして、自分のうちの子もぜひ描いていただきたい！と思い、依頼させていただきます。\n依頼の内容については以下の通りとなります。\n\n【描いていただきたいもの】\n　以下の２人のうち、鮫福様がいいなと思ったキャラクターをどちらか選んで描いていただきたいです。\n　notionのURLを添付いたしますので、長文で恐縮ですがご確認いただけますと幸いです。\n\n＜シチュエーション＞\n　希望のシチュエーションはどちらの子を選んでも以下の通りでお願いします。\n・普段は絶対に着ないような衣装を身にまとっている一幕。\n・具体的な服装・髪型については鮫福叶夢様がいちばん彼女たちに似合いそうなものにしていただけると嬉しいです。カジュアル・フォーマルは問わず、コスプレみたいのでもとても嬉しいです。\n\n＜希望のキャラクター（どちらか）＞\n　お願いしたいキャラクターは以下のふたりのどちらかでお願いします。\n　どちらの子も同じくらい思い入れが強い子なので、お好きな方を描いていただければと思います。\n\n①越智　雪海（https://scarce-scorpio-86c.notion.site/Skeb-TRPG-2bad16e4ed5380a0b767ff646a2c7687）\n　「仲の良い人間が死んでしまう」という呪いにも似た運命を背負い、人との関わりを絶っていた女性です。\n　感情表現に乏しくはありますが、思いやりに溢れ、少し世話焼きな一面も持ち合わせています。\n\n②浜綿　夕梨花（はまわた　ゆりか）（https://scarce-scorpio-86c.notion.site/Skeb-TRPG-15ed16e4ed5380ea815fee639f340fe7）\n　弱気な自分を卓越した演技力で隠しながら、演劇の舞台で活躍する女性です。\n　弱いところはありますが、意志はとても強く、誰かの幸せのために奔走できる子です。\n\n　おまかせしてしまう部分が多く、お手数をお掛けして申し訳ございません。\n　難しいようでしたら、リクエストを蹴って頂いても構いません。\n　お忙しいところたいへん申し訳ございませんが、ご検討いただけますと幸いです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@samefuku_kn/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3648681, "client_id": 1376497, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c29cc7d/uploads/origins/ad5af45f-9a2d-4b46-b675-9868ff895b81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=833d494956a789bcb4cdeb72498bfda8", "srcset": "https://si.imgix.net/2c29cc7d/uploads/origins/ad5af45f-9a2d-4b46-b675-9868ff895b81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=833d494956a789bcb4cdeb72498bfda8, https://si.imgix.net/2c29cc7d/uploads/origins/ad5af45f-9a2d-4b46-b675-9868ff895b81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99621f5600a0e69c37873962f97