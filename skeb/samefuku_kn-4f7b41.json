=3&fit=crop&crop=top&w=200&h=200&s=6cec4b8718b9c83d9abfc8817dad5507 3x"}, "duration": 3, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9b29057/uploads/outputs/b3ee3770-2e6c-4d43-975d-40da5e4293ae?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=e01748dc56333b1dbcbcecba7a643902", "srcset": "https://si.imgix.net/d9b29057/uploads/outputs/b3ee3770-2e6c-4d43-975d-40da5e4293ae?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=e01748dc56333b1dbcbcecba7a643902, https://si.imgix.net/d9b29057/uploads/outputs/b3ee3770-2e6c-4d43-975d-40da5e4293ae?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c38eff24b6695d70978e338e76cdbcea 2x, https://si.imgix.net/d9b29057/uploads/outputs/b3ee3770-2e6c-4d43-975d-40da5e4293ae?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba8a25ef6814563d4236b7f31a24a8ad 3x"}, "body": "鮫福叶夢🦈🦉様\n初めまして。\nVTuberとして活動している八木かぷらと申します。\n鮫福叶夢🦈🦉様のポップで可愛いイラストにとても惹かれ、Xでポストをお見かけし、ぜひ私も描いていただきたくリクエストさせていただきました...！ \n\n今回ご依頼させていただくムービーに関しまして、構図やポーズは全てお任せさせていただきたいです。\n可能であれば縦型でも横型でも利用できるような構図だと嬉しいです。\n今回は等身イラストでの制作を希望しております。\n\n利用範囲は下記の通りとなります。\n・収益化済YouTubeチャンネルでの利用 (配信・動画サムネイル、投稿機能、shorts動画等)\n・Twitchでの利用\n・SNSでの利用 (アイコンやヘッダー、おはようVTuberや週間スケジュール、宣伝等) \n・FANBOXでの利用 (サムネイル画像) \n主に配信開始前や終了後の待機ムービー、おはようポストなどで利用させていただきたいと思っております。\n\n衣装に関しまして\n衣装は三面図の衣装、髪型は三つ編みで、丸メガネを掛けている私を描いていただけると嬉しいです。\n\nキャラクター詳細\n三面図では少し分かりづらい部分を記載させていただきます。\n瞳のハイライト:ひし形\n瞳孔:横棒\n歯:ギザギザの歯\n爪:黒のネイル\n\nご縁がありましたらぜひよろしくお願いいたします！\n\n八木かぷら\n\nhttps://drive.google.com/drive/folders/1usmUMn6NXgbeiV0gEj1JurGv8sVrQXZd", "nc": 144, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@samefuku_kn/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 3648681, "client_id": 4078157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed349be9/upl