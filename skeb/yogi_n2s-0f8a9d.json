たらぜひご自由に描いてください。もし条件があいましたらよろしくお願いします 🙇💙\n\nhttps://drive.google.com/drive/folders/1_0rdXcbvw4ScS3hmu1iwfJHck9_X7BGk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yogi_n2s/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3083676, "client_id": 3055851, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f50abf4f/uploads/origins/33392a8e-0630-4eac-9a75-5b5765bc1d95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d302cbac58d7a37a2735c073907a87d", "srcset": "https://si.imgix.net/f50abf4f/uploads/origins/33392a8e-0630-4eac-9a75-5b5765bc1d95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d302cbac58d7a37a2735c073907a87d, https://si.imgix.net/f50abf4f/uploads/origins/33392a8e-0630-4eac-9a75-5b5765bc1d95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=180ae44accec953e0db5fa998247f91b 2x, https://si.imgix.net/f50abf4f/uploads/origins/33392a8e-0630-4eac-9a75-5b5765bc1d95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4758108a95c9e9a83d96eb4860968a5e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f50abf4f/uploads/origins/33392a8e-0630-4eac-9a75-5b5765bc1d95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f680eb447d1d1dfd075f139bf5934ee7", "srcset": "https://si.imgix.net/f50abf4f/uploads/origins/33392a8e-0630-4eac-9a75-5b5765bc1d95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f680eb447d1d1dfd075f139bf5934ee7, https://si.imgix.net/f50abf4f/uploads/origins/33392a8e-0630-4eac-9a75-5b5765bc1d95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fb29953abfca3728835b760239ab31c6 2x, https://si.imgix.net/f50abf4f/uploads/origins/33392a8e-0630-4eac-9a75-5