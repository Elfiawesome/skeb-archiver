-acfc-f52f2df93514?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6a69e85c0465f9bf8bf929d20abdedc 3x"}, "body": "こんばんは。\n大鳥椎名と申します。\n今回は『魔法少女アルト』さんの めんうさちゃんを描いて頂きたいです。\n魔法少女アルトさんは自身の配信で「幸兎ユキさんのイラストが大好きだ」と語っておりましたので、きっと喜んでもらえると思います。\nご検討よろしくお願いします。\n\n魔法少女アルトさんの固定ポスト\nhttps://x.com/alto_magical/status/1718766634469666836?t=KMcrJNTZ-s3uHsEtsIuxBQ&s=19", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@miniko_0325/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3026744, "client_id": 2505012, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0025d7e/uploads/origins/ad98bc16-53ce-4a1e-bbbe-28bd1af7a266?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ce589044b95887e8be95d9b96b78ef2", "srcset": "https://si.imgix.net/d0025d7e/uploads/origins/ad98bc16-53ce-4a1e-bbbe-28bd1af7a266?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ce589044b95887e8be95d9b96b78ef2, https://si.imgix.net/d0025d7e/uploads/origins/ad98bc16-53ce-4a1e-bbbe-28bd1af7a266?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c207c75c59fba13b6851bbad57c7abe7 2x, https://si.imgix.net/d0025d7e/uploads/origins/ad98bc16-53ce-4a1e-bbbe-28bd1af7a266?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00bdb5d06c55be8f118d45865a7078f0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0025d7e/uploads/origins/ad98bc16-53ce-4a1e-bbbe-28bd1af7a266?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cda5438c9461f05f79bcc9ef39152e60", "srcset": "https://si.imgix.net/d0025d7e/uploads/origins/ad98bc16-53ce-4a1e-bbbe-28bd1af7a266?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cda5438c9461f05f79bcc9ef39152e60, https://si.imgix.net/d0025d7e/uploads/origins/ad98bc16-53ce-4a1e-bbbe-28bd1af7a266?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=68ff41de650b73195a134209da6f1ca1 2x, https://si.imgix.net/d0025d7e/uploads/origins/ad98bc16-53ce-4a1e-bbbe-28bd1af7a266?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=435edbb6f787b5483f6abfffedf6676c 3x"}, "body": "みにこ様\n\nイラストアカウントの方でもお世話になっております。\nVTuber活動をしております、幸兎ユキです。\n\nかねてよりみにこ様の\nポップで可愛らしいモチーフを散りばめたイラストが大好きで\nいつかご依頼したいと思っておりまして、今回リクエストを送らせていただきます…！\n\n以下リクエストの内容になります。\n\n〇キャライメージ\n\n・性格\nおっとり、ほんわか、天真爛漫、PON\n\n・容姿の特徴\nハーバリウム兎のため耳にお水と金木犀のお花、はっぱが入っています。\n\nインナーカラーと前髪横髪にメッシュが入っています。\n頭の上にオリジナルキャラクターのめんだこうさぎが乗っています（位置は変更可）。\n\n〇構図やポーズ、表情等\n通常衣装で、足を折りたたんでふんわりういているような、躍動感のある動きだと嬉しいです。\nサムネで使用できるよう、手や髪は見切れないようにして頂けると大変助かります。\n\n資料で不明な点や分かりづらい点は\n描きやすいように調整・アレンジして頂いて大丈夫です。\n\n表情は両目の開いた笑顔、もし可能であれば表情差分があると嬉しいです。\n\n背景を\n・炭酸の飲み物（メロンソーダなど）\n・ケーキやクッキー\n・ハーバリウム\n・花などの植物\n・コーヒー\nなどで構成頂けると嬉しいです。\n（上記を参考に使えそうなものをみにこ様のセンスで選んだり追加して頂いて構いません。）\n\n〇使用用途\nYouTubeのサムネイルや、チャンネルアート、FANBOXでの先行公開や壁紙配布、サムネイル画像やヘッダー、ネットプリントやグッズの商用利用などを含めVtuber活動範囲内で使用させていただきたいと考えております。\n\n〇希望ファイル形式\n背景と人物、宛名などを分けたpsdファイルで納品して頂けますと大変ありがたいです…！\n\n〇参考資料\nhttps://drive.google.com/drive/folders/1WbJzq-JS7dRDWB2HLcdzzIDEqoKPeiy2?usp=sharing\n\nここまでお読みくださりありがとうございました！\n何卒ご検討いただけましたら幸いです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nichijou_deyo/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1548162, "client_id": 2505012, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ef41f63/uploads/origins/03efb13f-0818-43ba-ad40-dfc177febeea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03200a5983893831d7fdca8f8fb7edba", "srcset": "https://si.imgix.net/8ef41f63/uploads/origins/03efb13f-0818-43ba-ad40-dfc177febeea?bg=%23fff&