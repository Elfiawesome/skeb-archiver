gix.net/fdfc1eb7/uploads/origins/ce51bc9d-59f4-422d-9fe0-e275b286bcad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cfddae9c3b6a606c552be76fa89b804, https://si.imgix.net/fdfc1eb7/uploads/origins/ce51bc9d-59f4-422d-9fe0-e275b286bcad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed721aabeb98e494b289714b9cb912c5 2x, https://si.imgix.net/fdfc1eb7/uploads/origins/ce51bc9d-59f4-422d-9fe0-e275b286bcad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06c1e18e86e06e8542a47c65d9a8d88b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fdfc1eb7/uploads/origins/ce51bc9d-59f4-422d-9fe0-e275b286bcad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d8a5b7d97cc4958ac1cd05af146b633", "srcset": "https://si.imgix.net/fdfc1eb7/uploads/origins/ce51bc9d-59f4-422d-9fe0-e275b286bcad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d8a5b7d97cc4958ac1cd05af146b633, https://si.imgix.net/fdfc1eb7/uploads/origins/ce51bc9d-59f4-422d-9fe0-e275b286bcad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=394e789c06dd252ebf49a9f5c42e3a01 2x, https://si.imgix.net/fdfc1eb7/uploads/origins/ce51bc9d-59f4-422d-9fe0-e275b286bcad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f212389387011a986e515f47c0ef3f5d 3x"}, "body": "お世話になっております。\nキト百でご一緒している夜ノ間です。\n\nたきびさんの漫画にはいつも本当に目を奪われていて、描写や構図、体や目の描き方、髪のなびきなどどれも美しくていつも拝見しております。\n今回、是非ライエスの最終イベントのシーンを漫画で描いていただきたくリクエストしました。\n描いていただきたいのは以下のシーンです。\n\n【描いてほしいセリフなど】\n\n最期だからと今までの仮面を剥がし、嫋やかに柔らかく微笑んで言うエストレラ。\n「…最期だから、貴方にだけはきちんと伝えたかった。あの日からずっと生きていてくれていてありがとう。幸せに生きてね」\n怖いくらい美しい笑みでエストレラが微笑む。\n（死を前にした完全な美）\n\n何も言わずほっそい肩をガッって掴んで止めるライナス。\nおそらく人生最大の余裕のない状態\nなんなら終始真顔だし手ェ震えてるんじゃないでしょうか\n\n「どう、されました？」\n困った顔で微笑んで聞くエストレラ\n\nしばらく黙ったあと\n「……馬鹿馬鹿しい話です。貴女が行くことはありません」って絞り出すように言う\n\n「でも、この国の人々ためにも行かなければーーー」\n\n遮るように「貴女を愛しています」というライナス\n\n｢……そんな事を今仰るなんて、ずるい……！｣\n今まで嘘みたいに綺麗だった顔が一変してぼろって涙をこぼしながら言うエストレラ\n\n「えぇ、ずるい男です。失望しましたか？　私は一度あなたを遠ざけましたが、それはあなたが生きて幸せになれると思っていたからこそだ」\n「――15年以上です。どこか遠くで、同じ空の下で幸せに生きてくれれば。それだけを願って生きてきた」\n「多くは望みませんでした。数日しか関わらなかったあなたが同じ大地のどこかで穏やかに暮らしていると思えば、つらくても悲しくても、どうにか心折れずにいられた。……こうしてまた逢えたのは、本当に望外の喜びでした」\n「私が隣でなくてもいい。けど、あなたがいなくなるのだけは耐えられない」\n\n「国でも家でも、その他大勢の名前のない誰かでもない。この私の道行きを照らしてくれませんか、輝ける星。……あなたが誰を選ぼうと、同じ空の下にいてくれれば私はそれだけで前を向いて歩き続けられますから」\n「――それほどに、あなたを愛しています」\n\n※エストレラは途中から静かに泣いていますがライナスさんの顔をじっと見つめています。\n\n\n【参考ツイート】\nhttps://x.com/knn_susk/status/1851604487515042283\n\n【衣装デザイン】\nライナス\nhttps://x.com/knn_susk/status/1863071014189773167\n\nエストレラ\nhttps://x.com/yorunoma/status/1887095357274026256\n\n\n【その他】\n金額が足りない・他厳しい等理由ありましたら蹴っていただけますと幸いです。\n金額を足して再度申請させていただきます。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekomelonRURU/works/46", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1099731, "client_id": 185688, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28ed9eaa/uploads/origins/c60393e8-d230-4eab-8600-eda4d82a229a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9f94b98aaf7e7c0a9cdd0a733b0292a", "srcset": "https://si.imgix.net/28ed9eaa/uploads/origins/c60393e8-d230-4eab-8600-eda4d82a229a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9f94b98aaf7e7c0a9cdd0a733b0292a, https://si.imgix.net/28ed9eaa/uploads/origins/c60393e8-d230-4eab-8600-eda4d82a229a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=704cf77502aa0b646bc49448c5a4aa53 2x, https://si.imgix.net/28ed9eaa/uploads/origins/c60393e8-d230-4eab-8600-eda4d82a229a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88d815a8ecd61c8797f85d9d66122f7f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28ed9eaa/uploads/origins/c60393e8-d230-4eab-8600-eda4d82a229a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c11379181b32a5fe3c4f02c47acef2f7", "srcset": "https://si.imgix.net/28ed9eaa/uploads/origins/c60393e8-d230-4eab-8600-eda4d82a229a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c11379181b32a5fe3c4f02c47acef2f7, https://si.imgix.net/28ed9eaa/uploads/origins/c60393e8-d230-4eab-8600-eda4d82a229a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=25e462479226dc2c4ab4864beb1598d0 2x, https://si.imgix.net/28ed9eaa/uploads/origins/c60393e8-d230-4eab-8600-eda4d82a229a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a1c080fdf8b755dbd5f56cd65abc0095 3x"}, "body": "るるちゃん！\nいつも楽しく配信見させていただいてます！\n今回ワーの姿を描いてほしくてリクエスト送らせていただきます。\n\n私は自認が尻尾が太くて長い（ユキヒョウみたいな尻尾）うさちゃんなので、そんな感じの姿で描いて欲しいです。\n毛皮の色は明るめのブルーグレーだと嬉しいです。\n目の色はおまかせします。\n参考までに好きな色は青と白と黒と金と銀です。\nまた、1体は三ツ矢サイダーと共にあると嬉しいです。（三ツ矢サイダーは命の水なので）\n\nあと、2体は私のシャムちゃん（母）を描いて欲しいです。\n母は自認が可愛い猫ちゃんなので白いツヤツヤ毛皮で青い目だと嬉しいと本猫が言っていました。\n1つは母ワー単体で、もう1つは母ワーと一緒にむぎゅっとしてる私ワーを描いてもらえると嬉しいです。\n\n色々注文してしまって申し訳ありません。\nるるちゃんの描くイラスト大好きなので、るるちゃんが思うように描いてくれれば大丈夫です！\nよろしくお願い致します！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kurageya_Mio/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1030309, "client_id": 185688, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/258e0a23/uploads/origins/2aa3baae-9497-44e4-981b-db929e7d689e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1b3f7a00b07435daa30c4009d4ede55", "srcset": "https://si.imgix.net/258e0a23/uploads/origins/2aa3baae-9497-44e4-981b-db929e7d689e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1b3f7a00b07435daa30c4009d4ede55, https://si.imgix.net/258e0a23/uploads/origins/2aa3baae-9497-44e4-981b-db929e7d689e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f0734d910403d59c4413b493b72b040 2x, https://si.imgix.net/258e0a23/uploads/origins/2aa3baae-9497-44e4-981b-db929e7d689e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f5d2759efe4b5cf9ddd30fe1b05c3f7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/258e0a23/uploads/origins/2aa3baae-9497-44e4-981b-db929e7d689e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9923d8eb52710da0477940c36be66f1", "srcset": "https://si.imgix.net/258e0a23/uploads/origins/2aa3baae-9497-44e4-981b-db929e7d689e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9923d8eb52710da0477940c36be66f1, https://si.imgix.net/258e0a23/uploads/origins/2aa3baae-9497-44e4-981b-db929e7d689e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3519a6d408e44917b938f1ec4fb6217c 2x, https://si.imgix.net/258e0a23/uploads/origins/2aa3baae-9497-44e4-981b-db929e7d689e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3c65909c96bddbf230380a16d56ba7d4 3x"}, "body": "スンばんは\n進化してさらに魅力的になった主神に是非描いていただきたいものがあり、この度申請いたします。\n\n描いていただきたいのは私の創作キャラクター2名です。\n自分の性癖をてんこ盛りにした設定もりもりのキャラです。\n女の子と男性（？）のバディになります。\n\n\n女の子の資料は以下をご確認ください\nhttps://x.com/yorunoma/status/1728623542709928311?s=20\n（可能であれば衣装は資料2枚目の真ん中がいいです）\n\n男性（？）の資料は以下をご確認ください\nhttps://x.com/yorunoma/status/1728630372530065492?s=20\n（可能であれば衣装は資料2枚目がいいです）\n\n\n両方とも人の形に近いですが、人外になります。\n女の子は元神様で男性（？）はインクが人の形を保っているような存在です。\n\n関係性としては女の子は相棒として相手を信頼しています。\n男性（？）はドロドロの信仰や執着を隠すことなく彼女を労わって愛でています。\n可能であれば、そんな２人の関係性が見えるような構図がいいです。\n（女の子を膝にのせてるとか、仰々しくうやうやしくしているとか）\n\nまた、身長差か体格差がわかると燃えます。\n必ず描いてほしいわけではないので、描きにくいなどあれば無視してください。\n\nパソコンのデスクトップ画像にしたいので1920×1080でお願いしたいです。\n\n\n主神によってどのように傷あり美少女（APP18)と首なし人外黒コートが描かれるのか興奮で滾っております。\nいろいろ注文を付けてしまいましたが、主神がこれいいんじゃないかと思ったもので描いていただけるのが一番の幸福です。\n長文になり申し訳ありません。\nどうぞよろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@9zmy_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1534146, "client_id": 185688, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/764f03a3/uploads/origins/05403931-1006-4a5c-9318-a42baf17b2f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0036e0b48c430e2f87d55cea9f75ff1", "srcset": "https://si.imgix.net/764f03a3/uploads/origins/05403931-1006-4a5c-9318-a42baf17b2f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0036e0b48c430e2f87d55cea9f75ff1, https://si.imgix.net/764f03a3/uploads/origins/05403931-1006-4a5c-9318-a42baf17b2f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4611273b50684714264520e90c164186 2x, https://si.imgix.net/764f03a3/uploads/origins/05403931-1006-4a5c-9318-a42baf17b2f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c09a3bea78c520290129aa172180f820 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/764f03a3/uploads/origins/05403931-1006-4a5c-9318-a42baf17b2f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=baf134c63b379dcf60b94ef9d2908219", "srcset": "https://si.imgix.net/764f03a3/uploads/origins/05403931-1006-4a5c-9318-a42baf17b2f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=baf134c63b379dcf60b94ef9d2908219, https://si.imgix.net/764f03a3/uploads/origins/05403931-1006-4a5c-9318-a42baf17b2f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5ab6ac422aae33a7de4aa40936885621 2x, https://si.imgix.net/764f03a3/uploads/origins/05403931-1006-4a5c-9318-a42baf17b2f5?bg=%23f