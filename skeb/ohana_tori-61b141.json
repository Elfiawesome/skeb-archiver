200&s=b5d0a774d0cbe878ef2ee5a1bcffffa1 2x, https://si.imgix.net/87b1a88d/uploads/origins/0489505c-c1ba-4c57-b3cb-1c5c79a1ce40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29b2a6c3752640e470fb1da866505117 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87b1a88d/uploads/origins/0489505c-c1ba-4c57-b3cb-1c5c79a1ce40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d21d7a8f45bc02ed874c096f32731d6", "srcset": "https://si.imgix.net/87b1a88d/uploads/origins/0489505c-c1ba-4c57-b3cb-1c5c79a1ce40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d21d7a8f45bc02ed874c096f32731d6, https://si.imgix.net/87b1a88d/uploads/origins/0489505c-c1ba-4c57-b3cb-1c5c79a1ce40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ca13a1dfa47a38c8045c20f6e169807 2x, https://si.imgix.net/87b1a88d/uploads/origins/0489505c-c1ba-4c57-b3cb-1c5c79a1ce40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=40c901479764828bce041c88073c9919 3x"}, "body": "なぱさんの絵柄でSDを書いてほしいと思いリクエストさせていただきます！\n最初はイブにナースシナリオをやるのでナースの攻めと病衣の受けを書いてもらおうかと思ったのですが、せっかく頼むならデフォルト衣装がよくない！？と冷静になりました。\n\nParanormal CrimeというシナリオのHO4とHO5です。\nそんな気はなかったのに継続していくうちに付き合いました。\n\n①ポルクス・ハーシェル\n　受け、FBIの新人。特徴表：斜め上からの発想\n　人あたりが良く飄々としているが、実は依存度が高くちょっぴり泣き虫。ドーナツが好き。\n②セオドア・ジノ\n　攻め、FBIの渉外役(交渉役)。特徴表：信頼のおける人\n　穏やかで物静かだが芯がしっかりしており物事をズバズバと言う。年の離れた妹が二人おりシスコン。\n\n外見は下記のドライブ内をご確認ください。\n※セオドアはFBIジャケットを羽織わせてもらえると嬉しいです\nhttps://drive.google.com/drive/folders/1BBihh2jQb0w1wB15AiUUMKoiOavGRnfT?usp=drive_link\n\n構図はお任せします。\nよろしくお願いします！！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ohana_tori/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2988769, "client_id": 864442, "vtt_url": null, "thumbnail_image_u