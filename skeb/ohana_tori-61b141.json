さがりで眠そうな顔をしてます。\nPC……神父(受け)、38歳、175cm  神父服、ピンク髪、白手袋、ピアス(イヤリング)です。\n世話焼きで優しそうな外見をしてます。\n\n外見は以下のGoogleドライブに保存しているのでご参照ください。\n\nhttps://drive.google.com/drive/folders/1gGhF4-B15mQ-ytgc6-qJ2VOmcNviiocW\n\nぜひなぱさんのイラストで自陣を見たいので、何卒よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ohana_tori/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2988769, "client_id": 839631, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e2f94511/uploads/origins/bf971681-c570-4f75-ad57-234a4d468fb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cf93cc89ab18aa60a009b097b3ad8df", "srcset": "https://si.imgix.net/e2f94511/uploads/origins/bf971681-c570-4f75-ad57-234a4d468fb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cf93cc89ab18aa60a009b097b3ad8df, https://si.imgix.net/e2f94511/uploads/origins/bf971681-c570-4f75-ad57-234a4d468fb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6cb7a61b98a1f0fa6c0b77acf8f6320 2x, https://si.imgix.net/e2f94511/uploads/origins/bf971681-c570-4f75-ad57-234a4d468fb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b5c9bad7e11bed152f03b97af53cd6b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2f94511/uploads/origins/bf971681-c570-4f75-ad57-234a4d468fb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c385280d3e21a17073b2f73c456ef323", "srcset": "https://si.imgix.net/e2f94511/uploads/origins/bf971681-c570-4f75-ad57-234a4d468fb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c385280d3e21a17073b2f73c456ef323, https://si.imgix.net/e2f94511/uploads/origins/bf971681-c570-4f75-ad57-234a4d468fb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200