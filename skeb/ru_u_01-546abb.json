3e90da027fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09c8591fff8f9636108d1a69f6622d8d", "srcset": "https://si.imgix.net/b4a4e67a/uploads/origins/4c3b29a3-dee4-42fd-8c80-53e90da027fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09c8591fff8f9636108d1a69f6622d8d, https://si.imgix.net/b4a4e67a/uploads/origins/4c3b29a3-dee4-42fd-8c80-53e90da027fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=22fa05eeb60a6ac9b277c8bc94a0218d 2x, https://si.imgix.net/b4a4e67a/uploads/origins/4c3b29a3-dee4-42fd-8c80-53e90da027fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e96088c01d5cd5541d6d0be904e44fb2 3x"}, "body": "はじめまして個人vtuberの國神李月と申します！\nるう様のイラストがとても素敵でしたのでぜひ自分も書いていただきたくリクエストさせて頂きました\n\n使用用途\n収益化済み配信、サムネへの使用\nSNS等での投稿、アイコンでの使用\nグッズ制作時での使用\n収益化済みの為商用利用をお願いしたいです\n\n國神李月\n神界から人間界へ料理修業に来た現役シャム猫調理師\nチルくたまにPonをするお肉とお酒が好きな女の子 \n中性的なボイスでギャプを演出することも\n\n\n衣装、ポーズ等おまかせでお願いしたいです\n\n\nお忙しいと思いますがご検討よろしくお願いします\n\nhttps://drive.google.com/file/d/1OWw0W_BBiM58xIBmuTqZMTvaSbweDSQh/view?usp=drivesdk", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ru_u_01/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3569588, "client_id": 3107863, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9274972/uploads/origins/1a3f5e5d-ddfc-401c-9853-bee6f1bbeee4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e365110dd1a74aca46c0585449d169e", "srcset": "https://si.imgix.net/b9274972/uploads/origins/1a3f5e5d-ddfc-401c-9853-bee6f1bbeee4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e365110dd1a74aca46c0585449d169e, https://si.imgix.net/b9274972/uploads/origins/1a3f5e5d-ddfc-401c-9853-bee6f1bbeee4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7df9f71cf8713b98c802e2c32aba0158 2x, https://si.imgix.net/b9274972/uploads/origins/1a3f5e5d-ddfc-401c-9853-bee6f1bbeee4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f71649292db9d9d169ca136c2001f00 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9274972/uploads/origins/1a3f5e5d-ddfc-401c-9853-bee6f1bbeee4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1707f487d7dcbda5404eb796352af639", "srcset": "https://si.imgix.net/b9274972/uploads/origins/1a3f5e5d-ddfc-401c-9853-bee6f1bbeee4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1707f487d7dcbda5404eb796352af639, https://si.imgix.net/b9274972/uploads/origins/1a3f5e5d-ddfc-401c-9853-bee6f1bbeee4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=88dbb0a0e3b35e5633714c8f94c7a8c6 2x, https://si.imgix.net/b9274972/uploads/origins/1a3f5e5d-ddfc-401c-9853-bee6f1bbeee4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bce087e9fdc0371160d982f706b11161 3x"}, "body": "るう 様\n\n初めまして、個人VTuberのシャルバートと申します。\nX内にてるう様の描く素敵なイラストを拝見し、是非自分も描いていただけたらと思いリクエストを送らせていただきました。\n\n・リクエスト内容\n男性体の方でも女性体の方でも構わないので、るう様の描きやすい方の姿で構図や表情はお任せ出来ればと思います。(るう様さえ問題なければYouTubeのサムネイル等にも使用させていただきたいので、頭や肩は切れていない構図だと嬉しく思います。サムネイルとして使用しても良い場合は透過のデータもいただけますと幸いです……！)\n衣装に関しましては、通常衣装(ディーラーモチーフ)か過去の記念衣装(中華、ゴシック和服)からお好きな物を選んでいただければと思います。\n\n・使用用途\n動画や配信のサムネイルでの使用\nX等のSNSでの宣伝や投稿での使用\n自分やコラボ相手の配信画面内での使用\n\n不備等有りましたら申し訳ございません。\nご検討の程、宜しくお願い致します。\n\nhttps://x.com/_Charbert_/status/1694193166470283443?t=oxNkgWeaI2XibQCf6x43rQ&s=19", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ru_u_01/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3569588, "client_id": 3919148, "vtt_url": null, "thumbnail_image_urls": {"sr