p-content/uploads/2025/08/250823-scaled.jpg\n▼設定資料①\nhttps://infinite6rt3.noor.jp/wp-content/uploads/2024/12/10.jpg\n▼設定資料②\nhttps://infinite6rt3.noor.jp/wp-content/uploads/2024/12/11.jpg\n\nビジュアルが2種類ありますが、簡易CSの姿を参照下さい。\n細部などは省略、アレンジ等して頂いて構いません。\n\n■用途\n御名前を明記した上で、頂き物として自サイトへの掲載をさせて頂きたく存じます。\nそれに伴い縮小程度の加工をさせて頂きます。\n\n■希望\n戦闘シーンをイメージした動きのある構図で、且つ縦構図でありますと助かります。\nまた、背景もしくはエフェクトとして青い雷光を入れて頂きたく。\n\n─────\n何卒ご検討の程、宜しくお願い申し上げます。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@onennnesuru/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1131888, "client_id": 1012505, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/317ef62d/uploads/origins/e87ab2f2-232e-4961-be24-1be814b1c9e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad2df787f7f72097edd33f44229d2835", "srcset": "https://si.imgix.net/317ef62d/uploads/origins/e87ab2f2-232e-4961-be24-1be814b1c9e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad2df787f7f72097edd33f44229d2835, https://si.imgix.net/317ef62d/uploads/origins/e87ab2f2-232e-4961-be24-1be814b1c9e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7333c289f2237918c0b0cc3d5a0a26c 2x, https://si.imgix.net/317ef62d/uploads/origins/e87ab2f2-232e-4961-be24-1be814b1c9e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bee0f7d765f7b2a207895d1c22414175 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/317ef62d/uploads/origins/e87ab2f2-232e-4961-be24-1be814b1c9e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d943043a95df8432758fc1387d4297aa", "srcset": "https://si.imgix.net/317ef62d/uploads/origins/e87ab2f2-232e-4961-be24-1be814b1c9e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d