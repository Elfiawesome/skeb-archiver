igins/6f93e921-1da7-4dad-901c-d1942ab3f042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9df35e809b9f0e1231213f0a17c6efff, https://si.imgix.net/a7cb991d/uploads/origins/6f93e921-1da7-4dad-901c-d1942ab3f042?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16834cd23d3fb6b6e0e67b1c81f4c8e1 2x, https://si.imgix.net/a7cb991d/uploads/origins/6f93e921-1da7-4dad-901c-d1942ab3f042?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f2f7d4574a75176e46f7ade2dc817a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7cb991d/uploads/origins/6f93e921-1da7-4dad-901c-d1942ab3f042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=684497d00fa3690d1474c4746e77e59c", "srcset": "https://si.imgix.net/a7cb991d/uploads/origins/6f93e921-1da7-4dad-901c-d1942ab3f042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=684497d00fa3690d1474c4746e77e59c, https://si.imgix.net/a7cb991d/uploads/origins/6f93e921-1da7-4dad-901c-d1942ab3f042?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bb58106d2580dfd2e4ee07d5ce4b8940 2x, https://si.imgix.net/a7cb991d/uploads/origins/6f93e921-1da7-4dad-901c-d1942ab3f042?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1e4a15e1ce7bcf74a71aa892b2d0d629 3x"}, "body": "こんにちは、先生！\n\n先生のアートスタイルが大好きです！今回は私のオリジナルキャラクター2人（ロマンティックな関係）のリクエストをお願いしたいです。彼らは主従関係であり、パートナーであり、恋人同士でもあります。  \n\n  🦋 Chara 1：エイプリル (April)【攻め/184cm/19歳】\n明るく紳士的で、人当たりが良い性格。シルバーの右腕として、家族を脅かす者を排除します。黒髪で左目を覆う髪型、一本だけ白い髪束があります。両目は緑色、頭には黒い蝶の羽が生えています。シルバーに接する際は感情的で敏感な一面も。\n\n🐺Chara 2：シルバー (Silver)【受け/174cm/16歳】\n黒い狼に変身する能力を持つマフィアのボス。幼少期の辛い経験から冷静で抑制的ですが、エイプリルの行動には非常に寛容です。短い黒髪、低彩度の紫瞳、黒い動物の耳と尻尾を持っています。\n\n関係性 \n\nエイプリル（🦋）は、シルバー（🐺）の顧問（コンシリエーレ）兼守護者として、彼を導き世話をしています。エイプリルはシルバーに深い献身を示していますが、その世話には執着や偏愛が含まれています。一方、ボスであるシルバーは冷静な外見を保ちながらも、エイプリルに対しては完全な信頼を寄せ、彼のあらゆる行動を黙認し、甘んじて受け入れています。\n\n服装やデザインは自由に変更していただいて構いません！もし可能であれば、2人の体格差がわかるように描いていただけると嬉しいです（シルバーはエイプリルより半頭分ほど小柄で、若く見える印象でお願いしたいです）。\n\nこのイラストは、個人利用（SNSアイコンや携帯の壁紙）として使用させていただきます。  リクエストを読んでいただき、そして検討いただき本当にありがとうございます。このリクエストが不適切でしたら、どうぞお気軽にキャンセルしてください。\n\n金額が足りない場合、再送お願いいたします…!  よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1ELhgR-asbNtVhyPQFjL1VpA7wg46wTGJ", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Sunday_3day/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3893546, "client_id": 3089519, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95d986f6/uploads/origins/884b077d-7c27-401b-976a-9f52a2db5ada?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3443f0f6add424ae4dedbc6c29bf3408", "srcset": "https://si.imgix.net/95d986f6/uploads/origins/884b077d-7c27-401b-976a-9f52a2db5ada?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3443f0f6add424ae4dedbc6c29bf3408, https://si.imgix.net/95d986f6/uploads/origins/884b077d-7c27-401b-976a-9f52a2db5ada?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8a959aadf2950eb8beff62b529b2829 2x, https://si.imgix.net/95d986f6/uploads/origins/884b077d-7c27-401b-976a-9f52a2db5ada?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=251113565d2e1e02d30c792df37b4163 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95d986f6/uploads/origins/884b077d-7c27-401b-976a-9f52a2db5ada?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26c708b058c99e2182354016ebeb2b1b", "srcset": "https://si.imgix.net/95d986f6/uploads/origins/884b077d-7c27-401b-976a-9f52a2db5ada?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26c708b058c99e2182354016ebeb2b1