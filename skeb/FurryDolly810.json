ても素晴らしかったので\n今回もまた依頼をしたくskebを\n利用させて頂きました\n\nチョコの沼にうっかり落っこちてしまって\n図らずも顔以外自分フォンデュしてしまい\n自分フォンデュ回の7、8コマの\nちいかわみたいな姿の\nハチワレにカラースプレーチョコを\nトッピングした挙句片手でつまんで\n踊り食いの要領で迎え舌で\n食べようとする空腹のデカワレ　\n（デカワレにチョコはかかっていません）\n何されてるかいまいち分かっておらず\nこちらを向いてきょとんとしてるハチワレ\n\n以上の内容でフルカラーの一枚絵を\n描いてくださると\nありがたいです。\nよろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FurryDolly810/works/97", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 864194, "client_id": 1114323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/79b2b367/uploads/origins/8303fc2c-b3f3-439a-8406-f4fe19467fef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cdffda1fe4f71d2fef74b86f491faea", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/79b2b367/uploads/origins/8303fc2c-b3f3-439a-8406-f4fe19467fef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=919218791e2ac0b243b250759cc57b43", "src_set": ""}, "body": "よければパステルカラー(ゆめかわ)なルビルくんの健全イラストをお願いします。\n背景、構図等に指定はありません。\nポーズは萌え袖が強調された物を希望しています。\nまた、SNSアイコンとしての使用も検討しているため、アイコン用にトリミングした画像もお願いします。\n可能であればYouTubeのコミュニティ等にアップロードしてもらえると嬉しいです。\n\nポーズ参考・https://drive.google.com/drive/folders/10tmPIHUqmSg2cVlMoJzLOj0aCC0rBtV-\n\nパステルカラーの参考・https://drive.google.com/drive/folders/10t7eUUpNBBeg_K-cdZ-MgCw-xSGK0auT\n\nゆめかわの参考・https://www.pixiv.net/artworks/111251893", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FurryDolly810/works/96", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 864194, "client_id": 3045854, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/722f0c92/uploads/origins/06dd613b-a0c1-45dc-952b-c8a1011c880f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a80358fd05b90bdfe5a0e5bc709219c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/722f0c92/uploads/origins/06dd613b-a0c1-45dc-952b-c8a1011c880f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c853fe6f70e9f328c53c2e1892739a39", "src_set": ""}, "body": "ブイズたち全員を書いてほしいです\nいつもの絵柄でいいのですが、できたらヨツケモの方もお願いしたいです。\n構図等キャラクター以外はお任せします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FurryDolly810/works/95", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 864194, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d60a94bc/uploads/origins/9dcde2be-2094-4522-9e61-fad90e5f6047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d28cb3c45562703b6a0cd45d342dcf22", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d60a94bc/uploads/origins/9dcde2be-2094-4522-9e61-fad90e5f6047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a6a4760650f60a8757f4bf0d08d952f", "src_set": ""}, "body": "インキュバスくんと、キャットバスターズのクロナが脱衣羽子板で全裸の状態で負けた罰ゲームで、仲良く墨の代わりに精液をぶっかけられているイラストを体の正面が見えるようなアングルでどちらもヒトチンで描いて頂きたいです。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FurryDolly810/works/94", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 864194, "client_id": 1114323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9644a900/uploads/origins/b90bd655-ce66-4f19-b089-12e5ebb952fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4664945795777030996db91b7318ad45", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://s