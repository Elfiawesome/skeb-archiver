アイコンへの使用\n背景とキャラクターのファイルを分けて頂けるとありがたいです…！！\n\n\n初めてのskeb依頼故拙い所あるかと思いますが、ご検討頂ければと思います！\n不備等がありましたらご対応頂けますと幸いです…！よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1I3TYBt4ntFIZ0wrxdRrrHLr8DeKweVJ_", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 849490, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🐟", "screen_name": "admmdk", "avatar_url": "https://pbs.twimg.com/profile_images/1615323101377736707/Gukb5aSM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1297642734983864320/1693795979/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 2590635, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "消しKS", "screen_name": "kesiks0616", "avatar_url": "https://pbs.twimg.com/profile_images/1579944638970228738/vqdIut88.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2794035212/1682171985/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 2843993, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "回（null）", "screen_name": "nullmms", "avatar_url": "https://pbs.twimg.com/profile_images/2028754800960266241/bhbgQygn.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2028754327142350848/1784675944/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiratio