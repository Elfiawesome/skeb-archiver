chCD.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3599992cb0c8d1feb6a5d03afc51609 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/dab3fd31-e999-4958-93bf-1c232d999c3b?response-content-disposition=inline&Expires=1795844431&Signature=NO4TDOBTlCNqrDfdbsiPet0hwzfX3RXp5Msn3khm~c--muatonYARfX-wOyoprMd53BzevEWYK1Qu9jW443LQu5IClobyyHVK60UH7nG6G7Hvgbsg5wNdM~kChF37bjNljdlgx-XGJc-dA4TLF0FLYQj8ox~N6YJGhjWweCPoApyN6WyeVXxEmpGYa9iTft9P4Is1qf2UKwyVjsyNgFgHDi6xthnkjXwXWIReWDvI4yxeHMDzwOdJrTUHi1YJjFuVvkx4LwhGSGiXo9mUFfTXoWw30rfD~XknsTmbUY5TgynLyW0xDZdFz4LPa105Vf0S3BldJCe3p01u5JbX3VBag__&Key-Pair-Id=K1GS3H53SEO647", "duration": 244, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2028683686477271040%2FA4qxchCD.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d19637770fb913e45603db9fc0bf34b", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2028683686477271040%2FA4qxchCD.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d19637770fb913e45603db9fc0bf34b, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2028683686477271040%2FA4qxchCD.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9fe1ca28c1594000bff5eb745873a4f7 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2028683686477271040%2FA4qxchCD.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4b32f0d35f6f18d0c09b37cf0cc90e00 3x"}, "body": "黒咲様、こんにちは。\n心を癒してくれるような音声を一つ録っていただきたく、ご連絡いたしました。\n用途・キャラクター設定・シチュエーション・セリフの参考は下記の通りです。\n黒咲様のお声がとても好きなので、もしご依頼をお受けいただけましたら大変嬉しく思います。\nどうぞよろしくお願いいたします。\n\n【用途】\n個人鑑賞用\n\n【キャラクター設定】\n優しくて包容力があり、少しママ味のある年上の女性。\n後輩くんの大学時代の先輩で、現在は友達以上恋人未満の関係。\n後輩くんの家の鍵を持っていて、ほぼ毎日のように遊びに来ている。\n\n【シチュエーション】\n後輩くんが仕事を終えて、全身くたくたになって帰宅。\n家にあなたがいることに気づいた瞬間、そのままあなたの胸に飛び込んでくる。\nあなたは甘やかすような表情で、優しい声で後輩くんを励まし、ゆっくり休むように促す。\n\n【セリフの方向性】\n癒し、全肯定、寝る前の慰め。\n演技はあまり大げさではなく、自然な囁きに近い雰囲気を希望しています。\n\n【セリフ本文参考】\nおかえりなさい……あ、今日もすごく疲れているみたいですね。\n\n……あら、かなり疲れちゃいましたか？\nよしよし。お風呂、もう沸かしておきましたから、先に入ってきてくださいね。\n\n【しばらくして】\n\nお風呂、上がりましたか？\nこっちに来てください。髪、乾かしてあげますね。\n\n【髪を乾かしている途中、後輩くんが安心して眠くなり、ゆっくりあなたの胸に倒れ込む】\n\nん？ もう眠くなってきましたか？\nそれなら今夜は、このまま私の腕の中でゆっくり休んでください。\n\n……いつも本当にお疲れさまです。\n今夜はもう何も考えなくていいですから、このままゆっくり眠ってくださいね。\n\nおやすみなさい。", "nc": 145, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@kurosaki_aoin/works/7", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2028683686477271040%2FA4qxchCD.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63f44cdce123d706b17628255c3205ba", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2028683686477271040%2FA4qxchCD.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63f44cdce123d706b17628255c3205ba, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2028683686477271040%2FA4qxchCD.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c89815e862d7a5cfadab913ad2199d5 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2028683686477271040%2FA4qxchCD.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f6ef68e8cce16ca7a2f38527066a312 3x"}, "private": true, "genre": "voice", "tipped": true, "creator_id": 38