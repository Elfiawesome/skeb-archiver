nまた、私はお情が好きで、特に彼女の曲「泡沫」が好きなのですが、この曲を聴いた時のイメージで私のキャラクターを描いて欲しいです。歌詞と関係なくてもいいので、曲の雰囲気重視でお願いします。\n\n少し抽象的なお願いだとは思いますが、もし描くのが難しいようであれば、いつもの自分を描いていただくか、この依頼をキャンセルしていただいても結構です。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1AhX0IzZirigfkDwCasbgpdi8KDeYCuih", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@8ri40_00/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2492944, "client_id": 1397703, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83e424df/uploads/origins/40c011bd-8d6d-4d73-8775-deef8edcd39b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c65fa4b80d59aca59f14cb2207c2425d", "srcset": "https://si.imgix.net/83e424df/uploads/origins/40c011bd-8d6d-4d73-8775-deef8edcd39b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c65fa4b80d59aca59f14cb2207c2425d, https://si.imgix.net/83e424df/uploads/origins/40c011bd-8d6d-4d73-8775-deef8edcd39b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e39d01aaffeefcb282252c8d148cab34 2x, https://si.imgix.net/83e424df/uploads/origins/40c011bd-8d6d-4d73-8775-deef8edcd39b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10add25dd51aaf676ad81c3895a3a0ac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83e424df/uploads/origins/40c011bd-8d6d-4d73-8775-deef8edcd39b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc7dd30251fc090785d76f67036c4918", "srcset": "https://si.imgix.net/83e424df/uploads/origins/40c011bd-8d6d-4d73-8775-deef8edcd39b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc7dd30251fc090785d76f67036c4918, https://si.imgix.net/83e424df/uploads/origins/40c011bd-8d6d-4d73-8775-deef8edcd39b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit