m=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79d9abe7506e839fe1ab0a87f7de7650, https://si.imgix.net/96380e94/uploads/origins/84bc60c1-ed86-4814-8835-5a0e34546e98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a51de69ee994d005b66661b0e72ed9b4 2x, https://si.imgix.net/96380e94/uploads/origins/84bc60c1-ed86-4814-8835-5a0e34546e98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a0db5076f2584d7f2c39298c4855199 3x"}, "body": "また依頼を送らせて頂きます。\nキャラ：さとり\n内容\n現代女子高生と言う設定で、ジャージ姿（色は任せます）のさとりが体育倉庫でジャージを半脱ぎして誘っている様子を希望します。\nジャージの中は下着を着ておらず、半脱ぎの状態として上はチャックを完全に開けて乳首を晒し、更に両肩を出す程度に半脱ぎで、\n下は膝よりやや上辺りまで下げてアソコを見せてる感じにお願いします。\nまた、さとりの表情については饅頭象さんがこのシチュエーションに合うと思うのをご自由にお任せします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jim900904/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2211071, "client_id": 1388897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/00bab68d/uploads/origins/540bbeb1-011d-40c7-9fd7-d4d4a11481ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b8b2b195a34a8318f3cab21b2e409c1", "srcset": "https://si.imgix.net/00bab68d/uploads/origins/540bbeb1-011d-40c7-9fd7-d4d4a11481ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b8b2b195a34a8318f3cab21b2e409c1, https://si.imgix.net/00bab68d/uploads/origins/540bbeb1-011d-40c7-9fd7-d4d4a11481ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd89ff32b5b70df1a190edf2b7feb4a7 2x, https://si.imgix.net/00bab68d/uploads/origins/540bbeb1-011d-40c7-9fd7-d4d4a11481ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a17dda4838f6056535364f1ef893db8c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00bab68d/uploads/origins/540bbeb1-011d-4