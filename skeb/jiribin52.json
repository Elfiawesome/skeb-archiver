": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jiribin52/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 672794, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97b8fd8d/uploads/origins/c93b2c03-71e5-4030-b964-991f7e1ff9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bda8e07ead64a82fa0ae9c9494f0a71", "srcset": "https://si.imgix.net/97b8fd8d/uploads/origins/c93b2c03-71e5-4030-b964-991f7e1ff9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bda8e07ead64a82fa0ae9c9494f0a71, https://si.imgix.net/97b8fd8d/uploads/origins/c93b2c03-71e5-4030-b964-991f7e1ff9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=694106dc004cae991dcafbddf8ffa166 2x, https://si.imgix.net/97b8fd8d/uploads/origins/c93b2c03-71e5-4030-b964-991f7e1ff9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93ce99117050091e23dfc08794ae213c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97b8fd8d/uploads/origins/c93b2c03-71e5-4030-b964-991f7e1ff9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bde9e0ffc00a62fa40932e2abd66b61", "srcset": "https://si.imgix.net/97b8fd8d/uploads/origins/c93b2c03-71e5-4030-b964-991f7e1ff9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bde9e0ffc00a62fa40932e2abd66b61, https://si.imgix.net/97b8fd8d/uploads/origins/c93b2c03-71e5-4030-b964-991f7e1ff9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2117555779532633c22611c63492f244 2x, https://si.imgix.net/97b8fd8d/uploads/origins/c93b2c03-71e5-4030-b964-991f7e1ff9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8c9ae77723f5dfeeaedede69c7cad141 3x"}, "body": "Hz2様の描かれたアルラウネモドキのイラストが大変癖に刺さりましたので、思い切ってリクエストさせていただきます。\n\n\n遊戯王のウォーター・ガールがアルラウネモドキの中に閉じ込められて、本体の多腕で両腋の下や、お腹周り、内腿等をくすぐられる姿を差分付きでお願いします。\n\n\n体の向き、くすぐられ方は以前描かれていた作品と同じような感じで、\n\n\n①　両腕をピンと伸ばされて全く抵抗が出来ない状態でのくすぐり\n↓\n②　①の差分で、以前のイラストのように口に管を取り付けられ言葉の抵抗すらも奪われた状態\n\nでお願いします。\n\n擬音、セリフあり無しは基本的にお任せしたいのですが、もしつけていただけるならの①、②のどちらかでアルラウネモドキが『水属性が私に勝てるわけないでしょう？』と言うような台詞を付けていただきたいです。\n\n\n体の向き、拘束の状態、くすぐられ方\nhttps://x.com/jiribin52/status/1855747270190461416?t=v4eHO8pJaO52R6tbgcz9-A&s=19\n\n\nキャラクター参考資料\nhttps://ms.yugipedia.com//1/19/WaterGirl-MADU-JP-VG-artwork.png\n\n全身\nhttps://x.com/WaterGirlLOVE01/status/1525556969196486656?t=PDcDKS5gkqM0E4ZTrABXaA&s=19\n\n\nもし良ければどうかよろしくお願い致します。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jiribin52/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 672794, "client_id": 129890, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c687dede/uploads/origins/9977d03c-78fc-4026-844b-5f91af16afd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff6dc69fefbf2d5a201cf381c21bae00", "srcset": "https://si.imgix.net/c687dede/uploads/origins/9977d03c-78fc-4026-844b-5f91af16afd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff6dc69fefbf2d5a201cf381c21bae00, https://si.imgix.net/c687dede/uploads/origins/9977d03c-78fc-4026-844b-5f91af16afd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81f8a6a101a2eef3e21faff296f16ad8 2x, https://si.imgix.net/c687dede/uploads/origins/9977d03c-78fc-4026-844b-5f91af16afd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=def22ebcf0f2d609c7a1a9390a946539 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c687dede/uploads/origins/9977d03c-78fc-4026-844b-5f91af16afd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=