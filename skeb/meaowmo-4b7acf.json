31a3f713c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63980db4a4fd93034e6d776f9ba90b0a", "srcset": "https://si.imgix.net/90ebe69d/uploads/origins/0d86eb19-c889-4f37-ab2e-58231a3f713c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63980db4a4fd93034e6d776f9ba90b0a, https://si.imgix.net/90ebe69d/uploads/origins/0d86eb19-c889-4f37-ab2e-58231a3f713c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10c430381581b3650ec070f710d7ffe2 2x, https://si.imgix.net/90ebe69d/uploads/origins/0d86eb19-c889-4f37-ab2e-58231a3f713c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a9a55576130be0b4b93fbc676286f4c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90ebe69d/uploads/origins/0d86eb19-c889-4f37-ab2e-58231a3f713c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=714f57ce53998b820f41051087eee019", "srcset": "https://si.imgix.net/90ebe69d/uploads/origins/0d86eb19-c889-4f37-ab2e-58231a3f713c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=714f57ce53998b820f41051087eee019, https://si.imgix.net/90ebe69d/uploads/origins/0d86eb19-c889-4f37-ab2e-58231a3f713c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=625e2c15b3f0ead9bafe213f69937ae3 2x, https://si.imgix.net/90ebe69d/uploads/origins/0d86eb19-c889-4f37-ab2e-58231a3f713c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=24cba461f24aad27540924a4bc043ded 3x"}, "body": "はじめまして、あなたの画風が大好きです！源氏物語のファンアートも魅力的ですね。私のオリジナルキャラクターのために、このような背景付きのイラスト（https://twitter.com/meaowmo/status/1394247252915351558）をお願いしてもよろしいでしょうか？もし価格が合わない場合はこの依頼をキャンセルしていただければ、依頼内容の変更を検討します。2枚に分けても、1枚の絵にしてもどちらでも構いません。また、PSDファイルの中で背景とキャラクターを別のレイヤーに分けていただけますか？2人は恋人同士で、詳しい関係性の説明は参考リンクにあります。服装や髪型、ポーズなどは自由に変更していただいて構いません。ご検討いただきありがとうございました > <!\n\nhttps: