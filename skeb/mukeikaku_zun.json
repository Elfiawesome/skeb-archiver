: false, "genre": "art", "tipped": false, "creator_id": 155286, "client_id": 3430646, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af7998ca/uploads/origins/7965fef9-4435-473c-9402-e4d76ba49b04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=439e6cbfe3d1158ee99cfa6a8b5d02ce", "srcset": "https://si.imgix.net/af7998ca/uploads/origins/7965fef9-4435-473c-9402-e4d76ba49b04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=439e6cbfe3d1158ee99cfa6a8b5d02ce, https://si.imgix.net/af7998ca/uploads/origins/7965fef9-4435-473c-9402-e4d76ba49b04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30e7406f4c71e9fc593e3ed70b687dcc 2x, https://si.imgix.net/af7998ca/uploads/origins/7965fef9-4435-473c-9402-e4d76ba49b04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63c14068ca5c7f1a3912d5fbf5b389e2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af7998ca/uploads/origins/7965fef9-4435-473c-9402-e4d76ba49b04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de15c7b3b3a848c2c869210d68b47a5f", "srcset": "https://si.imgix.net/af7998ca/uploads/origins/7965fef9-4435-473c-9402-e4d76ba49b04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de15c7b3b3a848c2c869210d68b47a5f, https://si.imgix.net/af7998ca/uploads/origins/7965fef9-4435-473c-9402-e4d76ba49b04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=484a2f8cbc1de5e8cd37a7be1a1784b3 2x, https://si.imgix.net/af7998ca/uploads/origins/7965fef9-4435-473c-9402-e4d76ba49b04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=494d1bada30c4d9809c3aa30c3246759 3x"}, "body": "こんにちは！あなたのアートがとても好きです！\n\n私はインディーゲームの開発者です！\n私のゲームの主人公、イサドラを描いていただけませんか？\n\nその絵をゲームの宣伝素材や壁紙に使いたいと思っています！\nまた、youtubeの動画のサムネイルとしても使いたいです！\n\n解像度は16:9でお願いします！\n\nイサドラはとても決断力があり、決してあきらめない、クールで強い剣士です！\n\nローファイ少女と同じようなポーズと構図で描いていただけませんか？\n( https://x.com/lofigirl/status/1902072884480106611/photo/1 )\nローファイガールの絵と全く同じである必要はありません！\n\n椅子に座って、ラップトップかフルPCで作業している？彼女はプログラミングをしているでしょう。彼女がビデオゲームに取り組んでいるように見せたい！\n一生懸命、集中しているように見せたい！\n\nアートスタイルは、居心地のいい、快適な雰囲気がいいですね！そして、最初の配信やツイッターに投稿している作品を見て、あなたがそれを得意としていることを知りました！ローファイガールの作風も、居心地の良い雰囲気の参考になります！\n\nSF要素もあるゲームなので、SFチックな部屋でもいいかもしれません。あるいは、パソコンが置いてある普通の机でもいいし、あなたが描きやすいように！\n\nレイヤーを分けてPSDを提供していただけると助かります！そうすればyoutubeに使いやすくなります！\ntwitterの投稿、youtubeのサムネイル、キックスターターの資料、Steamなどに使えます。\nそして、ゲームに付属するコンセプトピースやそのようなものを含むアートブックに含まれます！\n\n難しい要望だったり、細かいことを言い過ぎたらごめんなさい！お読みいただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/1XnSpDkw74WECqJC4rzhV4zwb7_XpoRhq?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mukeikaku_zun/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 155286, "client_id": 3604432, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b5de12e/uploads/origins/861b07a5-4f1c-4b0b-9542-ef3d96624d39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97a006b94b515372fdf258404848b31e", "srcset": "https://si.imgix.net/4b5de12e/uploads/origins/861b07a5-4f1c-4b0b-9542-ef3d96624d39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97a006b94b515372fdf258404848b31e, https://si.imgix.net/4b5de12e/uploads/origins/861b07a5-4f1c-4b0b-9542-ef3d96624d39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bf4e949dc3efd405bd38f66b710ef17 2x, https://si.imgix.net/4b5de12e/uploads/origins/861b07a5-4f1c-4b0b-9542-ef3d96624d39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1fb18cdaea65426696b302c48856746 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b5de12e/uploads/ori