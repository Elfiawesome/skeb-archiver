2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd2815e453dd283754b2947a4b8419cd 3x"}, "body": "艦これのウォースパイトが私服で外出中にナンパAVのスカウトに捕まって出演しちゃう作品をお願いします。\n\n外出中にスカウトにお願いされて、スタジオまで連れられて撮影されちゃうようにお願いします。提督とはケッコン済みで経験人数は提督だけでお願いします。\n\nジャパニーズ土下座を決められて下着姿まで許したところに初めての電マやローターを経験してイキまくっちゃうようにお願いします。朦朧としたところに、男優にハメられちゃうようにお願いします。初めての他人棒によがってしまうようにお願いします。やめてというも日本人はみんな寝取られ大好きだからと言われて、犯されてイキまくるようにお願いします。男優はゴムハメでお願いします。\n\n男優がイッた後は今度は監督やスタッフが交代で犯すようにお願いします。ウォースパイトも途中から快感を貪ってしまうようにお願いします。コンドームが無くなり、生ハメだけどいいと言われて受け入れちゃうようにお願いします。最後は股を拡げて使用したコンドームを並べて、中出しされた回数を正の字で身体に書かれて記念撮影しちゃうようにお願いします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pbsheep18ovbt/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1369053, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62cdbe2d/uploads/origins/6da37830-7757-4c17-bfee-66ca7c4ab41a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f854d3ec66ec676f295476bc78e69d2b", "srcset": "https://si.imgix.net/62cdbe2d/uploads/origins/6da37830-7757-4c17-bfee-66ca7c4ab41a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f854d3ec66ec676f295476bc78e69d2b, https://si.imgix.net/62cdbe2d/uploads/origins/6da37830-7757-4c17-bfee-66ca7c4ab41a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb57b520f2c57236cb09b99b5d6c0952 2x, https://si.imgix.net/62cdbe2d/uploads/origins/6da37830-7757-4c17-bfee-66ca7c4ab41a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9fc4e019bfebe63577869cce1c2b3b92 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62cdbe2d/uploads/origins/6da37830-7757-4c17-bfee-66ca7c4ab41a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=836bf3f03161f5b0ecad5031cba356ea", "srcset": "https://si.imgix