に至っておらず、まだ小さく呻くような台詞をいれて頂ければ。\n\n以上の内容でお願いしますが、もし他の作業やリクエストを優先したいことがあれば断っていただいても構いません。\n\nそれではご一考ください。\n\nhttps://mantan-web.jp/article/20190324dog00m200007000c.html", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pbsheep18ovbt/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ca3d929a/uploads/origins/6bc3652c-f98e-4a1b-8fb8-e52a41d66a85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45e7ee972a06d79e383eb0aad5de2a06", "srcset": "https://si.imgix.net/ca3d929a/uploads/origins/6bc3652c-f98e-4a1b-8fb8-e52a41d66a85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45e7ee972a06d79e383eb0aad5de2a06, https://si.imgix.net/ca3d929a/uploads/origins/6bc3652c-f98e-4a1b-8fb8-e52a41d66a85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1186d2b3eaf51ee3b14af649adf63daa 2x, https://si.imgix.net/ca3d929a/uploads/origins/6bc3652c-f98e-4a1b-8fb8-e52a41d66a85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1aa96ad471d114559dfb00afb6248bfb 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 1369053, "nc": 34}, {"path": "/@pbsheep18ovbt/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/44b5150b/uploads/origins/c8b454be-dd84-49a6-bc7f-087fd1a70b62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dbc9143a463d623b4c26214d370f0229", "srcset": "https://si.imgix.net/44b5150b/uploads/orig