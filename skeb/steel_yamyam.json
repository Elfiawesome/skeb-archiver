fault_amount": 14000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@steel_yamyam/works/172", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/56a55cf2/uploads/origins/1cf513d8-ac86-4bc8-8223-9e91d79aa550?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4ebf1b6ed1ffa40c4549f65bfb9391b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 65568, "client_id": 97391, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 50, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@steel_yamyam/works/171", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 65568, "client_id": 118714, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6cef687c/uploads/origins/32ba7bb2-9a4e-4fb9-a88f-7d1a8ba7079b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be50f165850a620f5ef7348f16ef965a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6cef687c/uploads/origins/32ba7bb2-9a4e-4fb9-a88f-7d1a8ba7079b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bec099c52c718e70f958b08d5582c243", "src_set": ""}, "body": "こちら（https://skeb.jp/@steel_yamyam/works/167）のその後として、母として女として意識した主人は強いアプローチの末、メイド長と密かに男女の関係になったというシチュでお願いします。\n主人とのセックスでは、メイド長はいつもの鉄面皮でこんな年増にと呆れ、拙い主人に対して子供を導くように手ほどきしています。\nまた主人の妄想として、メイド長が部下との交尾を忘れられず、無理やり体を求められても断れずに穴を使われてしまっている差分をお願いします。あくまで上司という態度を保とうとしているが一方的に無様にイカされているという妄想に、主人は暗い興奮を覚えます。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@steel_yamyam/works/170", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 65568, "client_id": 866523, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a97708d/uploads/origins/cc46a7c5-0eb8-44f4-bec3-c6b3f29859a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aec0b295c99379dc58a0e23d3eabab37", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a97708d/uploads/origins/cc46a7c5-0eb8-44f4-bec3-c6b3f29859a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db3e9b4ca3a3c0624241d9885575c168", "src_set": ""}, "body": "いつも素敵な作品をありがとうございます！\n\n①息子木村リョウタ(30代)が仕事で実家の近くに来たので久しぶりに一人暮らしの母ヒロミ(50代)の様子を見にいく\n②物音が聞こえたので裏庭から家の中を伺うと小学生くらいのヤンチャそうな少年と激しくセックスする母の姿が\n\n・母のデザインは先生のサークル、パラディドルのサークルカットの女性のデザインでお願いします\n・少年の名前はユウトでお願いします(母からはユウトくんと呼ばれている)\n\n何卒ご検討よろしくお願いします！", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@steel_yamyam/works/169", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 65568, "client_id": 118714, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a6c46c43/uploads/origins/e63cdb56-c66d-4a57-99f3-7471ab2a27a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=121cd7ed48b901cb09a207854a2bcb0e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6c46c43/uploads/origins/e63cdb56-c66d-4a57-99f3-7471ab2a27a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0c7679a38ab262fb3319ef6141cbbfa", "src_set": ""}, "body": "豊満巨尻の勝気な肝っ玉系熟母のイラストをお願いします。\nとある田舎に住む母子。成人した息子くんが、毎年行われるお祭りの後のお座敷での宴会に初めて参加を許されたというシチュです。\n女性は伝統ということで露出度の高い白の法被とふんどし姿。熟母も同様の格好をしており、黒ずんだ巨乳輪がはみ出ている。祭りの後は女衆が男衆の肉接待をするのが慣わしとなっており、赤面してはいるがあっけらかんとしている。極太巨根で何人も孕ませている肥満体の油ぎった中年の村長は熟母を狙っており、呆気に取られる息子くんの前で、熟母にどぎついセクハラや抱き心地、穴の使い心地を寸評しますが、満更でもなさそうな反応です。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@steel_yamyam/works/168", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 65568, "client_id": 118714, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74d7a108/uploads/origins/fabe3301-d3b3-4a0b-aad9-4eba4e8a97cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8b2acdf94715f0af9c19fafde314b53", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74d7a108/uploads/origins/fabe3301-d3b3-4a0b-aad9-4eba4e8a97cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=700560e33880b8a843d32f4c49c6da7b", "src_set": ""}, "body": "こちら（https://skeb.jp/@steel_yamyam/works/167）の続きで、交尾後の感想報告のイラストをお願いします。\nメイド長と部下の立場はすっかり逆転し、蹲踞の体勢を命じられて、巨根を顔に押し付けられて巨玉にキス。使い込まれたグロマンのびらびらを片手の指で引っ張りアピールさせられつつ、だらしなくお漏らしをしています。普段の鉄面皮を装いながらも顔は上気しており、息も絶え絶えだが努めて冷静な口調で交尾の感想を詳細に報告します。最後には少し恥じらいながら、また見たいのであれば再び行うことを提案します。\nセリフは主人とメイド長のもののみでお願いします。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@steel_yamyam/works/167", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 65568, "client_id": 118714, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8d470b9/uploads/origins/229334c6-e691-4e0b-a7fc-5a0cb60cee8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e53d20400dc281279204e3c39f4a8cee", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8d470b9/uploads/origins/229334c6-e691-4e0b-a7fc-5a0cb60cee8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e58bcb248c3a17db79e81cab7445b28", "src_set": ""}, "body": "メイド長のIFをお願いします。\n黒人男性NTR趣味が偶然バレた主人。呆れるメイド長だが、意を汲んで部下の屈強な若い黒人男性と、一回だけ目の前で実際に生交尾をしてくれるというシチュでお願いします。\n初めて見るメイド長の全裸は、普段の鉄面皮とは対照的なだらしない肉体で乳首や性器は黒ずんでいて陰毛あり、性経験はほぼなし。赤面はしておらず事務的な表情で主人の粗チンの包皮を指で摘みながら、チンポを比べて言葉攻め。部下相手には遠慮せず和製中古年増肉穴を極太黒チンポで激しく使うように命令。男は同僚に何人も手を出して孕ませてますが、メイド長とは初めて。\nセリフは主人とメイド長のもののみでお願いします。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@steel_yamyam/works/166", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 65568, "client_id": 118714, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/567d80b2/uploads/origins/96e8aa31-0ef0-4ec9-a95a-3b1bef75a589?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d1ac7d798b039cbf77fb120a487b8f8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/567d80b2/uploads/origins/96e8aa31-0ef0-4ec9-a95a-3b1bef75a589?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1a093910504f51cdf0ec46c047aad90", "src_set": ""}, "body": "（https://skeb.jp/@steel_yamyam/works/161）の続きで、孫が不在の間に、祖母がI字バランスの体位になるように片足を持ち上げられて交尾するイラストをお願いします。\n1：挿入前、膣に極太巨根をあてがわれている。ドキドキしながら優しく使ってくださいと下品におねだり\n2：挿入し激しくピストンされて腹ボコになっている祖母。多少緩いがまだ使えると穴を褒められる\n3：精液ボテになるまで射精されてくたくたになるまで使い込まれた肉穴から多量の特濃精液を溢れさせている。まだ屈服はしきってはいないものの、獣人は全然萎えておらず堕ちるのも時間の問題といったシチュです", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@steel_yamyam/works/165", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 65568, "client_id": 118714, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd9a1e40/uploads/origins/63458eb9-e13f-437d-bc60-72989051557d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9552a2a4c23ae337e9056621ea4242ef", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd9a1e40/uploads/origins/63458eb9-e13f-437d-bc60-72989051557d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5999decc7a9e60fd44b0800cddf03d32", "src_set": ""}, "body": "こちら（https://skeb.jp/@steel_yamyam/works/157）の続きをお願いします\n隣の部屋から獣じみた声が流れてきて数時間。ヤリチンに部屋に招かれると、全裸のメイド長がいたというシチュです。普段の平静さを保とうとしていますが、明らかに事後の姿で、口元には陰毛がへばりついている\nヤリチンから、主人に対してセックスのレッスンをするのもメイドの仕事と命令されて、みっともない体や、今まで行っていた交尾の詳しい内容を無理やり説明させられるメイド長。レッスンの一環として、メイド長の中古穴で交尾の練習を提案されます。メイド長はど下品なチンポおねだりを、恥じらいながら行わされます", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@steel_yamyam/works/164", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 65568, "client_id": 118714, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/657f39a2/uploads/origins/acb4e295-c1e3-4094-96a1-d1dcfa84f19d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9e6c724366d08efae042116137b1720", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/657f39a2/uploads/origins/acb4e295-c1e3-4094-96a1-d1dcfa84f19d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bae394e827a95e4c7497c4c632a286d", "src_set": ""}, "body": "こちら（https://skeb.jp/@steel_yamyam/works/157）のメイド長の、片乳をはだけているイラストをお願いします。母乳を搾ろうとしたところに、偶然主人が出くわしたというシチュです\n1枚目：慌てる主人に、赤面もせず普段通りのメイド長。乳輪は真っ黒、多数のモントゴメリー線でブツブツしており、どれほど弄ばれたのかと想像してしまう。気になるなら絞ってみますかと誘われ、恐る恐る行うもあまり上手くはいかない\n2枚目：ヤリチンが登場し、赤面するメイド長。ヤリチンはメイド長の乳を下品な言葉で揶揄う。彼の乱暴な乳搾りで、主人の時よりも多量の母乳を噴き出し、軽く達してしまいます。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@steel_yamyam/works/163", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 65568, "client_id": 118714, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/578e3410/uploads/origins/83012935-5967-4753-b060-a6e5d2a724f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6b87c0d05bf763eb567f3936433dbe3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/578e3410/uploads/origins/83012935-5967-4753-b060-a6e5d2a724f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33cccf78fc65f991df08574b1f77b493", "src_set": ""}, "body": "男勝りな肝っ玉系熟母（家族のことは大好き）が、イケメンチンポに都合よく使われちゃう股の緩い熟オナホだということを偶然知ってしまった童貞の息子君。だらしない肉体の母を女として意識するようになってしまい、二人で宅飲みしてる時に酒の勢いもあって頼み込み、仕方ないねぇ…♡と呆れられながら優しく筆下ろししてもらうシチュをお願いします。\nヤリチンにハメられてる時とは違って余裕たっぷりで優しい感じで、雄としての格の差を感じてしまいます。\n陰毛あり、体型はだらしなければだらしないほど良いです\n内容は適宜変更してくださって構いません\nよろしければお願いします。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@steel_yamyam/works/162", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/aeec42c0/uploads/origins/671b1b44-4bcd-449b-8c58-1fb2f88d9ec3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c9e98ee7391243005307f448e607da8f", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 65568, "client_id": 271345, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 179, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@steel_yamyam/works/161", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 65568, "client_id": 118714, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c4ad755/uploads/origins/bb848fb6-8b15-4a5c-ba29-ac7a3928cdd4?bg=%23fff&auto=fo