75905-2df1-4edb-a6a3-85361f9dd120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6f1a1707457d15119e805bceb74eff6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2c2ddfd/uploads/origins/c9375905-2df1-4edb-a6a3-85361f9dd120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=485650ce09bb024d6d60d8e2c61a4c07", "srcset": "https://si.imgix.net/e2c2ddfd/uploads/origins/c9375905-2df1-4edb-a6a3-85361f9dd120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=485650ce09bb024d6d60d8e2c61a4c07, https://si.imgix.net/e2c2ddfd/uploads/origins/c9375905-2df1-4edb-a6a3-85361f9dd120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=128fcbbc6fcafa0631b54e7aab2bb484 2x, https://si.imgix.net/e2c2ddfd/uploads/origins/c9375905-2df1-4edb-a6a3-85361f9dd120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f7aa6bd5649b3ad77bb1dda7deb85719 3x"}, "body": "こんにちは、ジュンと申します！友人からあなたを勧められました。もし可能であれば、私の可愛くてグロテスクな鳥のメイドのイラストを依頼したいです。お好きなように描いてください。\n\n彼女の雰囲気の参考として、普段は受動的で無表情で、表情や声で感情をほとんど表しません。 感情を表に出すときはたいていごく微細ですが、普段より強く表に出ると、そのギャップが萌えポイントです。あまり動き回らないですが、その場でぼんやりしたり、そわそわしたりする傾向があります。無表情な性格ですが、怒ったりイライラしたりすると威圧感があります。\n\n翼の描写が難しすぎたり、邪魔になったりする場合は、自由に簡略化したり、羽の数を減らしたりして構いません。\n\nhttps://drive.google.com/drive/folders/1yWxQyRgpdROGoBiw83aFgg0LhNcoqaNM?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kyomugiko5/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3943916, "client_id": 2595921, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/352afde6/uploads/origins/61984cbf-6834-4954-90cd-6fb944e98f11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b6445bf9e9c2772e0db55136f025776", "srcset": "h