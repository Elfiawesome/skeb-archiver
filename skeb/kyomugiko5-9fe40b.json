r、YouTube、IRIAMでの配信、その他のソーシャルメディアで使用させていただきたいです。背景が透明なバージョンもいただけると助かります！\n\nhttps://drive.google.com/drive/folders/1AKn3nDlzK9hrnYLlwF_zY2xqMWdHHkZ6?usp=sharing\n\n本当にありがとうございます！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kyomugiko5/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9d6d7102/uploads/origins/202c50c5-b49b-4938-aca3-a841a2d99712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fcee2e731d5718007c9fce6f7faea4f5", "srcset": "https://si.imgix.net/9d6d7102/uploads/origins/202c50c5-b49b-4938-aca3-a841a2d99712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fcee2e731d5718007c9fce6f7faea4f5, https://si.imgix.net/9d6d7102/uploads/origins/202c50c5-b49b-4938-aca3-a841a2d99712?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ea2a76f2a043a6bc34c07661c56d91f 2x, https://si.imgix.net/9d6d7102/uploads/origins/202c50c5-b49b-4938-aca3-a841a2d99712?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=902bf9991e8c12accce12a49d05444da 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3943916, "nc": 16}, {"path": "/@kyomugiko5/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3943916, "client_id": 270367, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca9e4c6c/uploads/origins/42183b11-af2c-4fd2-a96d-ca83733ccf5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e53d8814a675675281e55c15bfa083d"