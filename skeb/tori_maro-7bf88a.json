やSNSのアイコンなどに使用する予定です。商業利用は一切いたしません。\n\nどうぞよろしくお願いいたします！\n参考のキャラクター詳細は以下のリンクからご確認いただけます：\nhttps://imgur.com/a/mMC4jjf", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tori_maro/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3085937, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dba617a3/uploads/origins/65ee435e-b013-4d0c-b05e-db556b23cdc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96ab4e22698b177fb1a7b2b7c5dd5969", "srcset": "https://si.imgix.net/dba617a3/uploads/origins/65ee435e-b013-4d0c-b05e-db556b23cdc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96ab4e22698b177fb1a7b2b7c5dd5969, https://si.imgix.net/dba617a3/uploads/origins/65ee435e-b013-4d0c-b05e-db556b23cdc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a555bd319d9b6225f6a58b0700202bd4 2x, https://si.imgix.net/dba617a3/uploads/origins/65ee435e-b013-4d0c-b05e-db556b23cdc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c21961a2f1328f894d32d615de7c8f1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dba617a3/uploads/origins/65ee435e-b013-4d0c-b05e-db556b23cdc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02370149fa10fc4cf3682e4fced7fc0e", "srcset": "https://si.imgix.net/dba617a3/uploads/origins/65ee435e-b013-4d0c-b05e-db556b23cdc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02370149fa10fc4cf3682e4fced7fc0e, https://si.imgix.net/dba617a3/uploads/origins/65ee435e-b013-4d0c-b05e-db556b23cdc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c8da5bd409aac779ba59959328732cd 2x, https://si.imgix.net/dba617a3/uploads/origins/65ee435e-b013-4d0c-b05e-db556b23cdc6?bg=%23fff&au