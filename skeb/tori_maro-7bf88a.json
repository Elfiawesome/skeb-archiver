どですが、他にも背景のアイデアがあれば、自由に楽しんでください！\n\nドリーミー：\nhttps://www.deviantart.com/stash/01un9hovlxmn\nhttps://www.deviantart.com/stash/0d3trop99sz\nhttps://www.deviantart.com/stash/0tb75nvzay7\n彼女のデザインを単純化しても全然OK!\n\nポーズや構図はお任せします！\n\nリクエストに応えていただきありがとうございました！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tori_maro/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3085937, "client_id": 1930788, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf2a0717/uploads/origins/d0009775-6582-4434-912e-1ca05736a8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11348537b039c76ccec8cdfe244c4590", "srcset": "https://si.imgix.net/cf2a0717/uploads/origins/d0009775-6582-4434-912e-1ca05736a8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11348537b039c76ccec8cdfe244c4590, https://si.imgix.net/cf2a0717/uploads/origins/d0009775-6582-4434-912e-1ca05736a8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a57e01dd299a80888ae270d3191546a 2x, https://si.imgix.net/cf2a0717/uploads/origins/d0009775-6582-4434-912e-1ca05736a8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14cc871ea58b41185f802b132dca950c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf2a0717/uploads/origins/d0009775-6582-4434-912e-1ca05736a8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ba298a2ed40c150111bc2455b150368", "srcset": "https://si.imgix.net/cf2a0717/uploads/origins/d0009775-6582-4434-912e-1ca05736a8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ba298a2ed40c150111bc2455b150368, https://si.imgix.net/cf2a0717/uploads/origins/d0009775-6582-4434-912e-1ca05736a8d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top