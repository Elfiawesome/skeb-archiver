やクマ\nひょろひょろの痩身で、歩行杖をついて歩く\n\n性格は生真面目で口うるさく、優しい時と怒る時で感情の波が激しい\nふつうは吸血鬼が信仰する邪神に仕える神官（狂信者）\n一人称は「私」で、かなり丁寧な敬語で話す\n\n闇の世界を支配する偉大な貴婦人に飼われているペットで、大人になると棄てられてしまう\nなので成長しないために、ほとんど食事をせず体がものすごく弱い\n\n----\n\n↑イメージして貰えればと設定を書きましたが、なんとなくで大丈夫です。\nポーズや構図はお任せします。どうぞよろしくお願いします。\n\nお手数ですが宛名は「暴力（ちから）くん」でお願いします。\n\nhttps://drive.google.com/drive/folders/1AwrkEV4ocHWdtM4SNpT4nDoSfJIIAfAm?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cognacbear/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 905901, "client_id": 887083, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/062c7cb4/requests/207009_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd5c8963ac8b6345c7463165421700b0", "srcset": "https://si.imgix.net/062c7cb4/requests/207009_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd5c8963ac8b6345c7463165421700b0, https://si.imgix.net/062c7cb4/requests/207009_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af8bf40362d7c28c744ad76c7a243aa9 2x, https://si.imgix.net/062c7cb4/requests/207009_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=562d62884bdae30993997712b1d01fc4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/062c7cb4/requests/207009_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee68e10ac70fc654eb8d4c997eb9367d", "srcset": "https://si.imgix.net/062c7cb4/requests/207009_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee68e10ac70fc654eb8d4c997eb9367d, https://si.imgix.net/062c7cb4/requests/207009_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=214cd9a060527e4c1c75af8d9c393e6c 2x, https://si.imgix.net/062c7cb4/requests/207009_0?bg