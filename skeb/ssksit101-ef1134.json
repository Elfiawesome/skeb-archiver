i/works/25\n\nトピックス\n緑髪と黄髪の静かな冷戦と密かなライバル関係。緑髪は黄髪のドヤ顔をもう見たくないと言い、黄髪は緑髪が常に自分の支配下にあるとし、かつての緑髪がいかに従順で、自分を実の母親のように扱っていたかをわざと口にする。\nそして傍観者の孤独な赤毛は、その寂しさに耐えきれず、率先して2人の気を引こうとし始めた。\n\n創造性は先生にお任せ！自由に描いてください！登場人物の解釈を楽しみにしています。どのような視点で物語を進めるかは自由です！\n\nもし先生がデッサンのスケッチや初稿を残していたら、大歓迎ですし、見せていただけると嬉しいです。\n\n 量が足りない場合は、再送を申し出ていただければ、喜んで再送いたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ssksit101/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3409991, "client_id": 2023509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1a02aa6/uploads/origins/885a5987-37c2-40b3-9f86-c7fae86d3efa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5152b63fbf243fbc3d670bb0293396d0", "srcset": "https://si.imgix.net/f1a02aa6/uploads/origins/885a5987-37c2-40b3-9f86-c7fae86d3efa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5152b63fbf243fbc3d670bb0293396d0, https://si.imgix.net/f1a02aa6/uploads/origins/885a5987-37c2-40b3-9f86-c7fae86d3efa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0817818a4193f658ff9c4f15fc109df9 2x, https://si.imgix.net/f1a02aa6/uploads/origins/885a5987-37c2-40b3-9f86-c7fae86d3efa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca2265e8e19d3a69437fe93b7e72d9c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1a02aa6/uploads/origins/885a5987-37c2-40b3-9f86-c7fae86d3efa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a4fc23b83d882113900d5a068f5a869", "srcset": "https://si.imgix.net/f1a02aa6/uploads/origins/885a5987-37c2-40b3-9f86-c7fae86d3efa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a4fc23b83d882113900d5a068f5a869, https://si.imgix.net/f1a02aa6/uploads/origins/885a5987-37c2-40b3-9