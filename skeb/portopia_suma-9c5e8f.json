23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=209aafd19e4fa85e1b372c0aa2633d88 2x, https://si.imgix.net/a1269055/uploads/origins/fadcbc90-b37d-4c05-8560-800dfc5bc9e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=236017ac60529eb0e360aa351e1e1638 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1269055/uploads/origins/fadcbc90-b37d-4c05-8560-800dfc5bc9e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccc431ffa1e2bb446a22c1a2e26c1713", "srcset": "https://si.imgix.net/a1269055/uploads/origins/fadcbc90-b37d-4c05-8560-800dfc5bc9e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccc431ffa1e2bb446a22c1a2e26c1713, https://si.imgix.net/a1269055/uploads/origins/fadcbc90-b37d-4c05-8560-800dfc5bc9e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0bd2592e9fe7217520edb6c993781f9f 2x, https://si.imgix.net/a1269055/uploads/origins/fadcbc90-b37d-4c05-8560-800dfc5bc9e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8cfd8701cd1b2089a080d5981d8059d 3x"}, "body": "美月ちゃんのえちえちをお願いします！\n\n以下概要\n\n美月の一人称……わたし\n(ある程度成熟すると拙者からわたしになるという個人的見解から)\n美月の呼び方……「湯者氏」\n場所……家(室内)\n\n展開……\n付き合っている湯者と美月。美月は相変わらず奥手で、なかなか一線を越えられない。\nお互いの体についてドキドキを感じながらも、たわいもないゲームやアニメの話なんかをする時間を過ごし、夜も更けきった頃に寝落ちする。\n電気もつけっぱなしの中、中途半端な時間に目が覚めた美月\n湯者の明らかにテントを張った股間をみて、先のドキドキを思い出す\n「今ならいけるんじゃないか」\n美月は、湯者の寝顔を見つめながら、ファスナーに手をかけて初えっち開始\n\n以降のざっくりとした流れ\n日にちの間は、ちょっとした日常のシーンを挟んで、昨晩のプレイにこっそり振り返っている感じ\n1日目夜……普通のおくちえっち フェラして湯者おきてべろちゅーして抱き合う感じ　まだ中には出さない\n\n2日目夜……初日のイチャイチャでタガを外した美月と湯者。同人誌でみた少しマニアックなおくちを試してみる 皮を剥いて、匂いに鼻を歪ませながらもチンカス掃除してくれるプレイがあるとうれしい\n\n3日目夜……軽くお口えっちしてたら早々とお互い欲しくなって、速い段階でべろちゅーしながらの対面座位フィニッシュ その後様々な対位で中に出し続ける　そのまま体力がなくなって抱き合ったまま寝落ち\n最後、寝ている美月の唇にキスしておわり\n\n以下要望事項\n\n・全体的に、\"エロ本で見たプレイを真似しようと頑張ってやっている感じ\"が欲しいなと思ってます\n・美月はおっぱいがでかいので、それを強調するような地の文やセリフがあると刺さります\n・美月も自身の胸のでかさには覚えがあるので、おっぱいを活かしたプレイを色々と試してくれる感じだと素晴らしいです\n・あとはひたすらラブラブさせてください。何年も一緒にいたのにずっと平行線の関係で、溜まっていた劇場が一気に崩れて流れ出る、みたいな感じ\n・あとは須磨さんの性癖に従ってください。ある程度ニッチなプレイでも同人誌で学んだ的なノリで誤魔化せると思います\n・お口多いと助かります　色々と\n\n以上、よろしくお願いします。", "nc": 32, "word_count": 13436, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 278320, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "千代田マサキ", "screen_name": "konjyo_yasuhiro", "avatar_url": "https://pbs.twimg.com/profile_images/1856939617897123842/eoCnwtQp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1194425257353871360/1731563880/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 90, "skills": [{"genre": "novel"}], "banned": false, "nc": 49}, {"id": 607840, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "塩酸の駅メモ垢", "screen_name": "e_ekimemo", "avatar_url": "https://pbs.twimg.com/profile_images/1733055154306658304/Lk00fYG6.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "novel"}], "banned": false, "nc": 176}, {"id": 1098930, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "げんゆー🔞C108-土曜日-西1の-49a", "screen_name": "genyuu_self", "avatar_url": "https://pbs.twimg.com/profile_images/2017537340726824960/aQewYl1g.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1302302402830237696/1632748611/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "comple