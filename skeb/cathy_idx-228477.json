, https://si.imgix.net/bcc2e93b/uploads/origins/42f1a2b2-e2e1-4a76-a0c7-932ec764fe77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5785de7affaa80724f32dcb0dcaf9940 3x"}, "body": "きゃしー様、いつも素敵なイラスト拝見しております。\n今回はきゃしー様に書いて欲しいイラストがありまして、リクエストさせて頂きました。\n書いて頂きたいのはセイウンスカイです。\nシチュエーションとしてはたまたま当たったブライダルフェアにトレーナーさんと参加して、ウェディングドレスを着て指輪をはめられ、目を細めて嬉しそうにこちらを見る彼女がみたいです。\n少し照れくさそうだと尚良しです。\n初めてのリクエストで大雑把になりますが、ご検討頂けましたら幸いです。\nよろしくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cathy_idx/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1613987, "client_id": 1350963, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f2e52ab/uploads/origins/bb091fd5-8ad0-4f54-bddd-05dbe82e4f26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c7f1d608d809cdc298a815f9e44d96a", "srcset": "https://si.imgix.net/3f2e52ab/uploads/origins/bb091fd5-8ad0-4f54-bddd-05dbe82e4f26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c7f1d608d809cdc298a815f9e44d96a, https://si.imgix.net/3f2e52ab/uploads/origins/bb091fd5-8ad0-4f54-bddd-05dbe82e4f26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7c14a7b44b9e3844557b46d1161761a 2x, https://si.imgix.net/3f2e52ab/uploads/origins/bb091fd5-8ad0-4f54-bddd-05dbe82e4f26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=173dc9c22db82f70ea03229ef86a9afe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f2e52ab/uploads/origins/bb091fd5-8ad0-4f54-bddd-05dbe82e4f26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5276dece09b96715a2c801d8dca39780", "srcset": "https://si.imgix.net/3f2e52ab/uploads/origins/bb091fd5-8ad0-4f54-bddd-05dbe82e4f26?bg=%23fff&auto=format%2Ccompress&fm=webp&fi