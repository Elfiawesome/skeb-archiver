い方するので、問題なければお願いしたく存じます。\n\n<ネットプリント>\nhttps://www.printing.ne.jp/index_p.html\nhttps://networkprint.ne.jp/Lite/start?lang=jajp\n\n・いただいたイラストをそのまま印刷するパターン\n・イラストの上にメッセージなどを記入したパターン\nの2種類を用意したいです。\n・ファイル形式はpsdでお願いします。\n・イラストは、youtubeのサムネイルに使用。双方SNS活動(twitter)にも使用させて頂きたいと考えております。\n・キャラクターイラストのみを使用させていただく場合がございますので、イラストが見切れないようにとお手間でなければサインや背景等はレイヤー別だと大変助かります。\n・イラストの顔周辺などをトリミングして使用させていただくかもしれないのですが、ご了承いただければ幸いです。 \n\nご検討のほど何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1xHAXdMB42qPmrfpQjPFzdjt0TGr3sWA6", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@deenamaito/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1305974, "client_id": 1498571, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d7ee59d/uploads/origins/dfe6abac-be75-4d03-9334-c66a1ee110d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=054d367caffcbe9452f640b4d66c72f4", "srcset": "https://si.imgix.net/0d7ee59d/uploads/origins/dfe6abac-be75-4d03-9334-c66a1ee110d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=054d367caffcbe9452f640b4d66c72f4, https://si.imgix.net/0d7ee59d/uploads/origins/dfe6abac-be75-4d03-9334-c66a1ee110d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f90c902a35962dc17a7a78a547337d8 2x, https://si.imgix.net/0d7ee59d/uploads/origins/dfe6abac-be75-4d03-9334-c66a1ee110d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb946fdf3bef34efaf32dff6a4fa65a5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d7ee59d/uploads/origins/dfe6abac-be75-4d03-9334-c66a1ee110d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d77ea44c3a81b90901adfeb58e348a88", "srcset": "https://si.imgix.net/0d7ee59d/uploads/origins/dfe6abac-be75-4d03-9334-c66a1ee