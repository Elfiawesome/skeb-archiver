します。 また、内容少し特殊だと思うので、難しい場合は本当に遠慮なくキャンセルしてください……！  よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Riw7mwf9AwWBxIftY055HNCzC9B0azY6", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@489wiki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4158535, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc50ef4b/uploads/origins/80cf3013-5853-4e11-ac3f-c61cfb109289?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bec50f4eb4ecbb385fa7e1815a2d7e14", "srcset": "https://si.imgix.net/bc50ef4b/uploads/origins/80cf3013-5853-4e11-ac3f-c61cfb109289?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bec50f4eb4ecbb385fa7e1815a2d7e14, https://si.imgix.net/bc50ef4b/uploads/origins/80cf3013-5853-4e11-ac3f-c61cfb109289?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cbda949fc97471dcd65e347c16244f2 2x, https://si.imgix.net/bc50ef4b/uploads/origins/80cf3013-5853-4e11-ac3f-c61cfb109289?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06b9cf7ac1db2794cea16f46ff74afdb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc50ef4b/uploads/origins/80cf3013-5853-4e11-ac3f-c61cfb109289?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e23c57a53b401c14f099d6ee47e47742", "srcset": "https://si.imgix.net/bc50ef4b/uploads/origins/80cf3013-5853-4e11-ac3f-c61cfb109289?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e23c57a53b401c14f099d6ee47e47742, https://si.imgix.net/bc50ef4b/uploads/origins/80cf3013-5853-4e11-ac3f-c61cfb109289?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d1a516cdc1e0180d0cefc19b0af97424 2x, https://si.imgix.net/bc50ef4b/uploads/origins/80cf3013-5853-4e11-ac3f-c