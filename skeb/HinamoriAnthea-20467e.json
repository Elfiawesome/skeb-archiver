: "Vtuber『甘乃あもこ』をモデルにお願いします。\n\n打ち上げ花火みたいに空に花火が上がった状態で『甘乃あもこ』を書いていただきたいです。書いていただく部分ですが、顔の所だけでお願いします。花火がパッと開いたときに『甘乃あもこ』が出てきたような感じです。ど真ん中に『甘乃あもこ』で、周り(余白スペース)は夏を思うようなイラストもしくは『甘乃あもこ』関連のものを書いていただけると有難いです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@Mei/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2282876, "client_id": 1179263, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef389678/uploads/origins/6a50d78f-93fd-4e98-a97d-11ddc608b264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3b943b74c782c161f2fbb3221a215c4", "srcset": "https://si.imgix.net/ef389678/uploads/origins/6a50d78f-93fd-4e98-a97d-11ddc608b264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3b943b74c782c161f2fbb3221a215c4, https://si.imgix.net/ef389678/uploads/origins/6a50d78f-93fd-4e98-a97d-11ddc608b264?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5349d167f515d72f3979b8c54c293616 2x, https://si.imgix.net/ef389678/uploads/origins/6a50d78f-93fd-4e98-a97d-11ddc608b264?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd359aea1f8daca2c11741c8f67620be 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef389678/uploads/origins/6a50d78f-93fd-4e98-a97d-11ddc608b264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=639920fefeab17f2f124cbcb76917931", "srcset": "https://si.imgix.net/ef389678/uploads/origins/6a50d78f-93fd-4e98-a97d-11ddc608b264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=639920fefeab17f2f124cbcb76917931, https://si.imgix.net/ef389678/uploads/origins/6a50d78f-93fd-4e98-a97d-11ddc608b264?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d53e565fc3fa