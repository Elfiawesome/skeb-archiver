2&fit=crop&crop=top&w=200&h=200&s=86abce243c07ec02f2a94d837151f92f 2x, https://si.imgix.net/95d6106e/uploads/origins/23db79e8-42ed-4595-9db5-4f26429f6360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aba660eb6713d5091344282ae7dc07f2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95d6106e/uploads/origins/23db79e8-42ed-4595-9db5-4f26429f6360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d917b1e2bd3a2d1f555985ffe8274426", "srcset": "https://si.imgix.net/95d6106e/uploads/origins/23db79e8-42ed-4595-9db5-4f26429f6360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d917b1e2bd3a2d1f555985ffe8274426, https://si.imgix.net/95d6106e/uploads/origins/23db79e8-42ed-4595-9db5-4f26429f6360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b19f59f4cd449c706091b1981d8b87cd 2x, https://si.imgix.net/95d6106e/uploads/origins/23db79e8-42ed-4595-9db5-4f26429f6360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8da8f068c77e1e2be11725849170c2df 3x"}, "body": "https://skeb.jp/@eSIsho18/works/4 このリクエストの続きをお願いします。\nメルジーヌがバーゲストに見つかった。バーゲストは彼女を助けようとするが、彼女は罠を発動させ、服をポニーガールの拘束具に変え、振動する乳首リングとアナルビーズを追加してしまう。バーゲストとメリュジーヌは、イクことを強要されながらダンジョンの奥深くへ逃げ込もうとする。二人はモーガンとバオバン・シスを見つける。モーガンとバオバンはバーゲストとメルジーヌを助けようと近づく。\nBarghestとMelusineは彼らに警告しようとしているが、彼らはボンデージギアのためにそれらを停止することはできません。\nバオバンとモーガンは別の罠を作動させ、服装を資料のような完全な緊縛具に変える。しかし、その服には乳首バイブと振動ディルドもついている。\nグダコとマッシュがレイシフトの準備をしている間、彼らはイクところを見ている。\n\nhttps://imgur.com/a/c4ecC6j", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eSIsho18/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1271772, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19588d2a/uploads/origins/b3d2d95e-1626-480b-aa4f-bfadc005d666?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eabc0e4d54411cb25a9a30317ada528a", "srcset": "https://si.imgix.net/19588d2a/uploads/origins/b3d2d95e-1626-480b-aa4f-bfadc005d666?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eabc0e4d54411cb25a9a30317ada528a, https://si.imgix.net/19588d2a/uploads/origins/b3d2d95e-1626-480b-aa4f-bfadc005d666?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74120587011d941fcdf6284a8d7edf40 2x, https://si.imgix.net/19588d2a/uploads/origins/b3d2d95e-1626-480b-aa4f-bfadc005d666?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a45ddd2796fcaf397e83dcadc236e767 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19588d2a/uploads/origins/b3d2d95e-1626-480b-aa4f-bfadc005d666?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1c9a174eae77e21c797dfd9f7f42c65", "srcset": "https://si.imgix.net/19588d2a/uploads/origins/b3d2d95e-1626-480b-aa4f-bfadc005d666?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1c9a174eae77e21c797dfd9f7f42c65, https://si.imgix.net/19588d2a/uploads/origins/b3d2d95e-1626-480b-aa4f-bfadc005d666?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=92c323157ff69bdab8152c835aa1a4fa 2x, https://si.imgix.net/19588d2a/uploads/origins/b3d2d95e-1626-480b-aa4f-bfadc005d666?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=806380c616676473fef689a23d5bbaff 3x"}, "body": "リクエスト失礼いたします！ スケブ再開嬉しいです！！\n\nリクエストの内容としてはストーリーテイストのある白黒の漫画形式の続き絵のリクエストになります🙇\n詳細としては敵に捕まったfgoの沖田総司が調教を受けてしまう。みたいなシチュエーションです！ \n流れとしては、\n戦闘に破れて医療用担架のような担架に乗せられベルトで全身を拘束される\n→\n口答えを封じる為に目隠しとボールギャグを付けられる(無理やり口を開かされてボールギャグ を噛ませる描写を入れて欲しいです！)\n\n→靴を脱がされ裸足にされて足の親指同士まで指錠で拘束されて運ばれる(拘束された両方の足の裏をアップで描いていただきたいです🙇)\n\n→目が覚めると尋問室に運びこまれており、別の拘束台へ全身を縛り付けられている(https://www.pixiv.net/artworks/94420385)上記の参考URLのアングルで、足裏を正面から写した感じで拘束台にベルトで縛られており足裏は裸足で、口にはボールギャグ を噛まされており口枷に歯を立てて涎を垂らしている感じです！ \n\n→ufoのようなニップルドームを取り付けられ\n乳首責めを受ける。\nといった形です！\n細々と注文が多くなっており申し訳ございません🙇\nよければ是非よろしくお願いいたします！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eSIsho18/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1271772, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/199d1bc2/uploads/origins/be8d87dc-177e-4d5c-bc99-43de3d1a88d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa5fe3d24cf49c4c71c2995ecedff82c", "srcset": "https://si.imgix.net/199d1bc2/uploads/origins/be8d87dc-177e-4d5c-bc99-43de3d1a88d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa5fe3d24cf49c4c71c2995ecedff82c, https://si.imgix.net/199d1bc2/uploads/origins/be8d87dc-177e-4d5c-bc99-43de3d1a88d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37c7042530df06e7b107d1e5414600b8 2x, https://si.imgix.net/199d1bc2/uploads/origins/be8d87dc-177e-4d5c-bc99-43de3d1a88d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f47b81a506e56009d5143d5c854d6dec 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/199d1bc2/uploads/origins/be8d87dc-177e-4d5c-bc99-43de3d1a88d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a35c3716dc8c613e157ebe32be6b1bec", "srcset": "https://si.imgix.net/199d1bc2/uploads/origins/be8d87dc-177e-4d5c-bc99-43de3d1a88d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a35c3716dc8c613e157ebe32be6b1bec, https://si.imgix.net/199d1bc2/uploads/origins/be8d87dc-177e-4d5c-bc99-43de3d1a88d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=17357d5f4cc5315a483674cb892332b6 2x, https://si.imgix.net/199d1bc2/uploads/origins/be8d87dc-177e-4d5c-bc99-43de3d1a88d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ef378488683f736c48fec55839b66a59 3x"}, "body": "はじめまして。https://x.com/eSIsho18/status/1700917926394806660?s=20 や一連の https://x.com/eSIsho18/status/1686028838583554048?s=20 の、赤い縄が映えるイラストに惹かれました。\nぜひ私の推しキャラが縛られた姿を拝見したい…となり、リクエストをお送りします。ご無理のない範囲でご検討賜れますと幸いです。\n\n■キャラ\nアイドルマスターシンデレラガールズから「白雪千夜」ちゃんをお願いします。\n\n■シチュ等\n「緊縛モデル」の仕事が舞い込み、戸惑いつつも必死にこなす──というイメージでいろいろな緊縛姿を拝見してみたいです。\n金額内で可能な範囲で以下のようなカットを頂けますと幸甚です。（ご自由に取捨選択ください）\nモデルなので最初は局部は露出しない下着/水着姿と思いますが、途中からエスカレートして剥ぎ取られて全裸となっているイメージです。\nなお、このキャラは過去に公式でこんな発言をしています。 https://pbs.twimg.com/media/FXmYHLDUcAEBMCt?format=jpg\n（イメージ）「確かに、業務内容に希望はないとは伝えましたが…これはなんですか。…まったく、お前らしい趣味の悪い仕事ですね。諦めます。」\n※あると嬉しいですが、イメージが湧かなければ特にイラスト内にセリフはなくとも大丈夫です。プレイの進行に応じて表情の変化をお願いします。\n※背景は不要です。\n①　後手に組んで縛られるのを待っている（内心期待でドキドキしている）\n②　後手高手小手＋股縄で縛られた姿（背面が見えると嬉しいです）\n③　②に加え片脚吊りにされている姿\n④　②に加えM字開脚で吊られている姿\n⑤　逆海老縛りで吊られている姿\n⑥　すべてが終わり縄が解かれた後に蕩けたように余韻に浸っている姿（緊縛の痕が残っている）\n\n以下、進行度合いの味付けでご自由に追加ください。\na.股間や乳首が何かしらの器具で責められている\nb.ボールギャグ等で言葉も奪われている\nc.目隠しされて視界も奪われている\n\n基本的にはすべておまかせいたします。上記にない内容でも構いません。キャラ指定のみ遵守で、縄による緊縛姿をすべておまかせでお願いしてみたいです。\nご検討のほどどうぞよろしくお願いいたします。\n\nhttps://imas.gamedbs.jp/cg/idol/detail/208", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eSIsho18/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1271772, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8942eee3/uploads/origins/fef06588-9380-42a2-b22e-9ea6a63bb659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83e0b804d92ab699119c14bd70d1b354", "srcset": "https://si.imgix.net/8942eee3/uploads/origins/fef06588-9380-42a2-b22e-9ea6a63bb659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83e0b804d92ab699119c14bd70d1b354, https://si.imgix