8f/uploads/origins/c56bb8cd-5271-4d67-baf9-e621c8a7c1e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb695a73211711b79fcc5924b4fcff06 3x"}, "body": "こんにちは、\n\nトランスファー/TFを描いていただけませんか？私のキャラクターが鳥に変身するところを見てみたいのですが、たぶん丹頂鶴でしょうか？変身率は60～90％くらいです。全裸で下着だけというのも見てみたいです。できれば、表情は恥ずかしがっていたり、驚いていたりすると嬉しいです。\n\nあとはお任せします。\n\nキャラクター\nhttps://www.dropbox.com/scl/fi/422yq5nh8hoso10br8cm7/charasheet-base.png?rlkey=nt9i3ruwzqj9z48212ypsjzg3&st=zes292xs&dl=0\n\nメインツインテール\nhttps://www.dropbox.com/scl/fi/tnovb72xashjflbdc0pb0/0-main_original-twintail-hairstyle-reference-default.png?rlkey=mj2i3rfcai7phmmns8tjqyjny&st=jzqv4q06&dl=0\n*ツインテールの髪型を維持してください。\n\nキャラクター情報\n赤いツインテールに赤い瞳。\n優しくて天真爛漫だが、照れ屋。\n胸はぺったんこ、もしくはAカップ。よろしくお願いします。\n\nありがとうございました！", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akubuu_193/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2924039, "client_id": 3177571, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2621730f/uploads/origins/8b4f1455-ef14-4762-bdaa-aff0cd81ac6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52d950da860cdff4d2d5934a522f1758", "srcset": "https://si.imgix.net/2621730f/uploads/origins/8b4f1455-ef14-4762-bdaa-aff0cd81ac6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52d950da860cdff4d2d5934a522f1758, https://si.imgix.net/2621730f/uploads/origins/8b4f1455-ef14-4762-bdaa-aff0cd81ac6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f1520d416218df8e903feda880e1b5e 2x, https://si.imgix.net/2621730f/uploads/origins/8b4f1455-ef14-4762-bdaa-aff0cd81ac6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3ceb6b1e6a0c7c92ce25c8dffdb060a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2621730f/uploads/origins/8b4f1455-ef14-4762-bdaa-aff0cd81ac6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a850b590d5e4c1f307cfd5e58c7c84d", "srcset": "https://si.imgix.net/2621730f/uploads/origins/8b4f1455-ef14-4762-bdaa-aff0cd81ac6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a850b590d5e4c1f307cfd5e58c7c84d, https://si.imgix.net/2621730f/uploads/origins/8b4f1455-ef14-4762-bdaa-aff0cd81ac6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c5ba51bebb40c62b8b05d6105d104622 2x, https://si.imgix.net/2621730f/uploads/origins/8b4f1455-ef14-4762-bdaa-aff0cd81ac6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3ff6c5e9d027d427bb81de015e77c0b8 3x"}, "body": "はじめまして、あくブさん！」。\n\nせんせいの描くすきです！ぜんぶ感情と色は、ておいい！です。\n\n私のキャラクタはシル、メスケモです！ 彼女は熱血で情熱的で衝動的な お姉さ！この作品では、シルと蛇の尻尾を、あなたの好きなように解釈してください。とてもふわふわしていて、背が高くて、筋肉質で、シャープで魅力的なシルを描いてほしいです！舞台は、あなたが好きな日本のもの、カラフルなネオンや楽しい反射があるサイバーパンクスタイルの舞台でも構いません。あるいは、あなたがシルの姿を見たいと思うような設定やシーンでもかまいません。彼女はお高くとまっているわけではなく、薄着であっても、魅惑的だと思われても気にしません。\n\n下着や洋服など、シチュエーションに合わせて好きな服、着てほしい服装で描いてください。今後は、あくブさんのキャラクタ！との絡みも見てみたいです。\n\nよろしくお願いします\n\nhttps://imgur.com/a/5YbjyIs", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akubuu_193/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2924039, "client_id": 2627358, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c56cd6f6/uploads/origins/995e76ab-3f79-44e2-8173-c1521f757e05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ad094d28e79ec0220ca40373dd0ae91", "srcset": "https://si.imgix.net/c56cd6f6/uploads/origins/995e76ab-3f79-44e2-8173-c1521f757e05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ad094d28e79ec0220ca40373dd0ae91, https://si.imgix.net/c56cd6f6/uploads/origins/995e76ab-3f79-44e2-817