8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aabedd7a344543584c6583eed690167d 3x"}, "body": "いつもお世話になっております、鳳累です！\nこの度は私がイムコセムに頂いたガワを捏造した鳳累(雛ロリの姿)を依頼させて頂きたく思います。\n《設定》\n目や肌の色はガワに準じております。\n・私が描いた雛ロリは父様の真似をして前髪を鶏冠の様に上げていますが、基本はガワと同じ髪型をしてます。\n・髪色は元の黒にオレンジや赤が薄らと混じっている様な色合いです。\n・服装は一昔前の子供が着ていたような着物(無地)で、色は古橋さんにお任せ致します。\n・羽根は猛禽類の物と類似していて、基本色は黒・白・赤・青・黄で、日や気分によって配色、中間色が変わるのでこちらもお任せさせて頂きます。\n・表情は子供らしく溌剌とした笑顔でお願い致します。\n\nまた可能であれば、髪色が黒くなり目からハイライトは消え、羽根も笑顔も失くなった(神鳥になる為に一旦人間としての寿命を使い切らねばならず、唯の人間になった)孤独に苛まれる八歳の累の差分", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@daicon444/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2451537, "client_id": 2773090, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7321712c/uploads/origins/d894023d-41ba-4036-be22-da0226f99c39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02db75e7b21a66f1734893a120686551", "srcset": "https://si.imgix.net/7321712c/uploads/origins/d894023d-41ba-4036-be22-da0226f99c39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02db75e7b21a66f1734893a120686551, https://si.imgix.net/7321712c/uploads/origins/d894023d-41ba-4036-be22-da0226f99c39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c567cdc69e844fe625ca50387bfe7741 2x, https://si.imgix.net/7321712c/uploads/origins/d894023d-41ba-4036-be22-da0226f99c39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6396cfaf9c364c087059790e2cbbdde0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7321712c/uploads/origins/d894023d-41ba-4036-be22-da0226f99c39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b96a51512332dd7e978b0f4dd7fd993", "srcset": "https://si.imgix.net/7321712c/uploads/ori