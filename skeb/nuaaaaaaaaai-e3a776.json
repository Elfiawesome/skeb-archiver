uploads/origins/777543f0-5ef6-4f51-95c1-02d8b39b9f02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=811d4838aed1af1b639143260a1e03d9", "srcset": "https://si.imgix.net/33bcf068/uploads/origins/777543f0-5ef6-4f51-95c1-02d8b39b9f02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=811d4838aed1af1b639143260a1e03d9, https://si.imgix.net/33bcf068/uploads/origins/777543f0-5ef6-4f51-95c1-02d8b39b9f02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a2afc96873048dc815a2d949c9278e12 2x, https://si.imgix.net/33bcf068/uploads/origins/777543f0-5ef6-4f51-95c1-02d8b39b9f02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9274f333702e66664716256636c2000f 3x"}, "body": "こんにちは！「また」きました！Sekigutiです🎶\n今回もたやさんに依頼をさせて頂きたく、リクエストを送らせていただきました。\n\n今回は私の自創作のかざねと彩斗を描いて頂きたいです。\n前回のように、資料は下記に記させて頂きます…！\n\n「本当に」たやさんの絵が大好きなので\nたやさんの味を活かしたイラストを楽しみにしています。\n\n最近は連日熱い日々が続いていますので、お体の不調にお気をつけください。\n\nhttps://drive.google.com/drive/folders/1-lUCPCJ870Sa2mxhzBp50k2EIjLybe_L", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nuaaaaaaaaai/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3193615, "client_id": 2986492, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb3f1eb8/uploads/origins/0391547f-8889-4613-9cf9-c1402b2aa7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=361fd1204e52619c56e26624d0e7f0be", "srcset": "https://si.imgix.net/bb3f1eb8/uploads/origins/0391547f-8889-4613-9cf9-c1402b2aa7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=361fd1204e52619c56e26624d0e7f0be, https://si.imgix.net/bb3f1eb8/uploads/origins/0391547f-8889-4613-9cf9-c1402b2aa7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8241a4ef83a16af6bf2f417d7f2058e 2x, https://si.imgix.net/bb3f1eb8/uploads/origins/0391547f-8889-4613-9cf9-c1402b2aa7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eca0f236fb76e1ccaf494dda4d3646e6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb3f1eb8/uploads/origins/0391547f-8889-4613-9cf9-c1402b2aa7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a85134d36930ce121313b66bb067619", "srcset": "https://si.imgix.net/bb3f1eb8/uploads/origins/0391547f-8889-4613-9cf9-c1402b2aa7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a85134d36930ce121313b66bb067619, https://si.imgix.net/bb3f1eb8/uploads/origins/0391547f-8889-4613-9cf9-c1402b2aa7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=160ac9680afcfc6b0952e408b64244e1 2x, https://si.imgix.net/bb3f1eb8/uploads/origins/0391547f-8889-4613-9cf9-c1402b2aa7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d94d9dec3486bbdde7fee0ae1b5ccc88 3x"}, "body": "いつも各所で本当にお世話になってます！Sekigutiです！\nたやさんにskeb頼めるんですか〜！？やったーー！！\n\nたやさんの絵柄がずっと大好きです！可愛さと綺麗さの混じったお顔の描き方や硬軟を感じる質感や雰囲気や色選びに、どことなく儚さや不穏さを感じる作風！反面緩いイラストはとっても可愛くて面白くて癖になる！ずっと見ていたいです！\n是非私の自創作を描いて頂きたく、リクエストをしました…！！\n\n【キャラクターについて】\n○へイズ・アクター\n明るくてひょうきん者な関西弁を使う糸目の青年。基本いつもニコニコしています。\n社交的で色んな人とよく喋り仲良くしていますが、初対面はだいたい怪しい印象を持たれがちです。\n意外と面倒見がよく、自分が所属している会社のチームの保護者の様になっています。\n↓補足(読まなくていいです)\nプリンが好きで、猫派です。\n幼少期に犬に噛まれたことがあり犬は少し苦手です。\n表情が豊かでよく変わります。(上記で基本的に笑顔と記載しましたが…)\n容姿はGoogleドライブの中に参考画像が入っているので、そちらを参考にしてください…！\n\n【要望など】\nたやさんの描く絵そのものが好きなので、たやさんの世界観や画風を活かして好きなように描いて頂けたら嬉しいです！\n\n【使用用途】\n観賞用やSNSのアイコンヘッダー等での使用、個人利用の範囲でのグッズ制作etc…\n\nなにか不備があったりお受けできない場合は再送申請やキャンセルをしてください。\n寒くて風邪が流行っているので、体に気をつけてお過ごしください！\n\nhttps://drive.google.com/drive/folders/1s1JtG_6XXAd6FdBul9Wt673S_I_r-LfG", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works":