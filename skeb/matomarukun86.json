qi?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matomarukun86/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2671143, "client_id": 3137005, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20567ac0/uploads/origins/a21e9286-a309-4aa2-8b66-41f0db8ac3f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05c5444dad74418e840983e673423b11", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20567ac0/uploads/origins/a21e9286-a309-4aa2-8b66-41f0db8ac3f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f04ec88ccaea566c3235a58d012d69ad", "src_set": ""}, "body": "こんにちは！あなたの絵がとても好きで、私と夫のキャラクターの絵をお願いしたいのです。私のキャラクターはとても不器用で、混沌としていて、よく笑います。自然が好きで、農業を営んでいます。二人が一緒にくつろいでいるような、ベッドで寝ているような、抱き合っているような作品がとても欲しいです。\n\n夫の性格は、もう少し真面目ですが、親しい人にはまだ少しおどけるところがあります。彼は私の性格よりも落ち着いていて、知的で、洗練されています。\n\nストリーミングのエンディング画面としても使いたいと思います。解像度はできれば1920x1080でお願いします。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/15SWE-Sl0QTMr8r3cnQOK19TXRBa4NUZR?usp=drive_link\n\nhttps://drive.google.com/drive/folders/15SWE-Sl0QTMr8r3cnQOK19TXRBa4NUZR?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matomarukun86/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2671143, "client_id": 925526, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f7e6fee/uploads/origins/a2ee1d8c-ce9a-4dda-8f6b-19390cd77ddf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01438e73657148d4d92ed1bdb0d6c2f3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f7e6fee/uploads/origins/a2ee1d8c-ce