都合が合いましたらお願いさせて頂きたく\n\n【推し始めの個人Vtuberさん】\n朱音りんさん（@_AkaneRin_ ）\n\n三面図こちらに\nhttps://x.com/_AkaneRin_/status/1883471951555072219?t=UMeRf73-H6wJQs4zvekc7Q&s=19\n\n今回もバストアップ構図で表情、ポーズはお任せでお願いさせて頂きたいです。\nYouTuberのサムネイルに使用なされる可能性がありますので人物と背景を分けたデータをお願いします。\n\n【使用用途】\nファンアートリクエストになりますので朱音りんさんご本人様のみイラストの使用許可をお願いしたく、YouTuberのサムネイルやSNSでのVtuber活動の宣伝に使用なさると思われますおはよいVtuber等\n\nご検討して頂けましたら幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pigma_01/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1690208, "client_id": 3105572, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed831f9f/uploads/origins/4ca675b9-343b-420b-aaf8-9c73b67ced6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac55077bc6634edad45d72785440a571", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed831f9f/uploads/origins/4ca675b9-343b-420b-aaf8-9c73b67ced6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77a1d622d5c9097b8be8c66ee9ee5ad3", "src_set": ""}, "body": "こんにちは、私はあなたのアートがとても好きで、私のVtuberキャラクターのアートをお願いしたいです！彼はストームチェイサーで、とても冒険好きで、スリルを求めていて、クールです！ポーズにこだわりはないので、ポーズや表情、詳細はお任せします。また、ソーシャルメディア（Twitter、Youtube、Twitchなど）でもシェアしたいと思います。\n ありがとうございました\n\nhttps://drive.google.com/drive/folders/1nagKmVStDapWlQv1z7dcV92q_O8v69-C?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pigma_01/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1690208, "client_id": 2549593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/066f8dbb/uploads/origins/791888ed-057d-4b20-88b4-916ad86c5a52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61ac101882b60bc44b7ed602f2393688", "src_set"