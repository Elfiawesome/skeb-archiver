ータに入ってしまっていますがそちらはお気になさらず！)\nhttps://drive.google.com/drive/folders/1aO1T7VhlnHBHq2pjBZQpkW4hugYkSr4M\n\n元のデザインはありますが、ゴシック・パンクロックな要素があればどんどんアレンジしていただいて構いません！ピアスバチバチでも何でもどうぞ！\nカッコよく楽しく描いて頂ければと思います。\n\nサイズ、ポーズなども指定はありませんので、自由に描いて頂けたらと思います。\n何卒、よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1aO1T7VhlnHBHq2pjBZQpkW4hugYkSr4M", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@iiiiruka/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3861628, "client_id": 3603003, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f5005bde/uploads/origins/d4ec2a7f-0cc8-4d9f-899c-d68df96c56b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad73e2850b558cc8487169ec08d91f18", "srcset": "https://si.imgix.net/f5005bde/uploads/origins/d4ec2a7f-0cc8-4d9f-899c-d68df96c56b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad73e2850b558cc8487169ec08d91f18, https://si.imgix.net/f5005bde/uploads/origins/d4ec2a7f-0cc8-4d9f-899c-d68df96c56b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=185399a35e7de6186ce8376606184300 2x, https://si.imgix.net/f5005bde/uploads/origins/d4ec2a7f-0cc8-4d9f-899c-d68df96c56b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=135bafba68219f51cc5c7f0c14d989af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5005bde/uploads/origins/d4ec2a7f-0cc8-4d9f-899c-d68df96c56b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed18fa7e973c7bafbf2d510371dd9537", "srcset": "https://si.imgix.net/f5005bde/uploads/origins/d4ec2a7f-0cc8-4d9f-899c-d68df96c56b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed18fa7e973c7bafbf2d510371dd9537, https://si.imgix.net/f5005bde/uploads/origins/d4ec2a7f-0cc8-4d9f-