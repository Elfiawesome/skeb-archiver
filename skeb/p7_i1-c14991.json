60a4eaf001f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=471fc805c2229794ed888659d0590b7a, https://si.imgix.net/96c32d44/uploads/origins/8b3f9b9c-68bd-403c-8d73-060a4eaf001f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1a95d1557f3e1149b07090d9a425db7d 2x, https://si.imgix.net/96c32d44/uploads/origins/8b3f9b9c-68bd-403c-8d73-060a4eaf001f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=679d209b63803ff76368cdc055157872 3x"}, "body": "やあ、Daさん！前回のイラスト、本当にありがとうございました。すごく素敵で、セルも気に入ってくれました！\n今度はセル・フォックスハウンドをモチーフにした新しいイラストをお願いしたいのですが、今回は『チェンソーマン』シリーズのマキマのような格好をさせてほしいです。ただし、衣装だけにして、目や髪型は変えないでください。\nこのイラストでは、まるで視聴者が鎖でつながれているかのように、彼女が鎖を握りしめて引っ張っている様子を描いてほしいです。その際、目を輝かせて、独占欲を露わにし、視聴者を支配するような雰囲気を出してほしいです。ポーズやその他の詳細は、お任せします！\nもし何か失礼な点があればお詫び申し上げます。ご配慮いただきありがとうございます。\n\nhttps://drive.google.com/drive/folders/1GEdYi3KQ02wvFuuYbpZ0m1iAhCXHYscM", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@p7_i1/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2808191, "client_id": 79576, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c24d65a1/uploads/origins/a62127ea-60fc-4a62-b48f-b702776014a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25a844e4953d0130d588b2796f1e09ba", "srcset": "https://si.imgix.net/c24d65a1/uploads/origins/a62127ea-60fc-4a62-b48f-b702776014a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25a844e4953d0130d588b2796f1e09ba, https://si.imgix.net/c24d65a1/uploads/origins/a62127ea-60fc-4a62-b48f-b702776014a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dca14d8f2444caa00db1608317af6560 2x, https://si.imgix.net/c24d65a1/uploads/origins/a62127ea-60fc-4a62-b48f-b702776014a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2fd354e302a85d38ae32552afc10b99 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c24d65a1/uploads/origins/a62127ea-60fc-4a62-b48f-b702776014a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd17cdb759232e2146929761d3a17231", "srcset": "https://si.imgix.net/c24d65a1/uploads/origins/a62127ea-60fc-4a62-b48f-b702776014a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd17cdb759232e2146929761d3a17231, https://si.imgix.net/c24d65a1/uploads/origins/a62127ea-60fc-4a62-b48f-b702776014a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e0e883f8d53b2269d33917f716fb4782 2x, https://si.imgix.net/c24d65a1/uploads/origins/a62127ea-60fc-4a62-b48f-b702776014a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=020a666f06b1f211902e6afc339eae22 3x"}, "body": "DAさん、こんばんは！\n先日はうちの子たちのイラストありがとうございました！\nまたリクエストを送りますのでご検討ください。\n\n今回はうちの子の「カミチ」単体のイラストをお願いします。カミチは背も乳も尻もデカいドスケベな『長身黒髪ショート吊り目三白眼ギザ歯爆乳長舌お姉さん』です。\n\nお願いしたい内容としては\nカミチが「エロくて、かつカッコよかったりクールな印象の衣装、服装」をしているイラストを描いていただきたいです。\nそれと可能なら全裸の差分もあると嬉しいです。\n\nDAさんの固定ツイートの\nスーツの女体のイラストや\nX上であげられていた\nhttps://x.com/p7_i1/status/2082299326798377162?s=46&t=uw-bFdyBpb-LAgZmthu90w\nこれの1枚目、他にも\nhttps://x.com/p7_i1/status/1931597371017924882?s=46&t=uw-bFdyBpb-LAgZmthu90w\nhttps://x.com/p7_i1/status/1992953812123075054?s=46&t=uw-bFdyBpb-LAgZmthu90w\nhttps://x.com/p7_i1/status/2065510299705459017?s=46&t=uw-bFdyBpb-LAgZmthu90w\nこれらのイラストめっちゃ好きです。\n\nコレらのようなかっこよさとエロさのある衣装をカミチに着せてみてください。\n露出度やエロさマシだと良いです。\n\n【備考】\n乳はどれだけデカくなっても良いです。\n乳輪と乳首も大きめのパフィーニップル気味だとなお良いです。\nデカい乳が映えるものをお願いします。\n\n納品ファイルはPSDとPNGどちらもあると嬉しいです。\n納品されたイラストの使用用途として 個人鑑賞およびSNSなどでのシェアや掲載、依頼時の参考資料としての使用 をご承知ください。\n\n以上になります。\n金額の不足等、ほか不都合などありましたら遠慮なくキャンセルや再送をお願い致します。\nぜひ、よろしくお願いします。\n\nカミチ資料URL\nhttps://drive.google.com/drive/folders/1-cFf1cFjiEQO70VVD_CCI48Z96KztLGb", "