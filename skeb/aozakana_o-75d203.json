従事者では有りません\n\n※髪の毛（？）の色は正直日によって変わるキャラです。\n単色だったり色々な色がごちゃごちゃ混ざっていたり、中で何か作っていたりとバラバラです。好きなように描いて下さい。\n※下半身は本人も切ったりするくらい勝手に余分な肉が増えるため描く場合は気にせず適当に描いても構いません。\n逆に下半身は大変気持ち悪いため無理に描く必要は本当にありません。むしろ上半身のみで大丈夫です。\n\n❥状況\nお任せします\n\n❥背景\nお任せします\n\n❥雰囲気\nお任せします\n\n❥OK\n自由な解釈、捏造、服のアレンジ等\n\n❥NG\n−\n\n❥使用用途について\n鑑賞、アイコン\n\n分からないところなどはaozakana🐟さんの好きに想像して描いてください。基本は全てお任せします。\n\n是非ご検討頂けますと幸いです。\n\nhttps://lit.link/haydenmcmaster", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 5500, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "by4co🐾土曜東2ソ07a", "screen_name": "_by4co", "avatar_url": "https://pbs.twimg.com/profile_images/2084054394702876672/4hjB6_y6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1014439178317193216/1772116258/1500x500", "appeal_receivable": false, "popular_creator_rank": 67, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1038624, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "統【Comms OPEN】", "screen_name": "motoiwork", "avatar_url": "https://pbs.twimg.com/profile_images/1774680348112412672/PLl5DkC3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1366012185407721472/1752021774/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 32}, {"id": 2620286, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "いかわさ🦑(チゲ味)", "screen_name": "Midori_annte23", "avatar_url": "https://pbs.twimg.com/profile_images/1772462509385269248/3WO5dS3i.jpg", "header_url": "https: