。\n夜のビル街を仕事終わりな4人がわいわい歩いているようなワンシーンを描いて頂けると嬉しく思います。細かい構図についてはお任せとさせて頂きたいです。\n４人という大人数ではありますが、何卒ご検討お願いいたします。\n\n・男性1\n178cm 31歳\n物静かで苦労人。周りのわがままに振り回される側ですが本人もなかなかいい性格をしている。\n・男性2\n202cm+10cmヒール 27歳\nノリが良くおちゃらけているが意外と人の機微を気づく気遣い屋さん。距離感が近い。\n・女性\n157cm 28歳\nあらあらうふふな世話焼きお姉さん。たまにドジっ子。注意はするけど暴走は止めない。\n・少女\n149cm 年齢不詳\n幼稚園児並に元気で好奇心旺盛に走り回る。自分はかわいいからみんな自分を大好きだと思ってる。\n\nhttps://drive.google.com/drive/folders/1cHLk_9jP0IgI8raKivasfmlTiUgh74Fz?usp=sharing", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ito_44_3/works/71", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 501882, "client_id": 2222485, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2abdbec2/uploads/origins/ed174749-109f-4cf6-9086-cf82eb33eb2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=292d0edd1407bf6fd0be88ca438a4c7b", "srcset": "https://si.imgix.net/2abdbec2/uploads/origins/ed174749-109f-4cf6-9086-cf82eb33eb2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=292d0edd1407bf6fd0be88ca438a4c7b, https://si.imgix.net/2abdbec2/uploads/origins/ed174749-109f-4cf6-9086-cf82eb33eb2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=075f6b8d2c76b06a1e6818534977ad12 2x, https://si.imgix.net/2abdbec2/uploads/origins/ed174749-109f-4cf6-9086-cf82eb33eb2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93b807a9058e79572ad075e6c50c258b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2abdbec2/uploads/origins/ed174749-109f-4cf6-9086-cf82eb33eb2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=484429abf788689f5e7dd53d5af36624", "srcset": "https://si.imgix.net/2abdbec2/uploads/origins/ed174749-109f-4cf6-9086-cf82eb33eb2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&