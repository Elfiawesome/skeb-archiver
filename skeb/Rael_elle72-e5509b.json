と大変助かります。\n★また、壁紙として配布したいので横画像だと大変助かります。\n\n\n【使用用途】\n◾︎xやtiktokなどSNS\n◾︎収益化済のYouTube\n◾︎サブスクやライドリ等での配布\n◾︎ネットプリント配布 等\n\n\n【納品形式】\n◾︎お手数おかけいたしますが、人物や背景、宛名等がレイヤー分けされたpng又はpsdデータでお願い致します。\n\n\n【参考資料】\n参考画像：https://photos.app.goo.gl/cGbxEyvjD4dGHmC6A\nプロフィール：https://lit.link/arisutina\nX(旧Twitter)：@tina_arisu\nコンセプトやイメージカラーは\nゲーマーアイドル、ピンクになります！\n(サブイメージカラーは黒です)\n\nお忙しいところ大変恐縮ではございますが、御検討よろしくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Rael_elle72/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3915346, "client_id": 3620580, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d23a3b93/uploads/origins/b29fe341-9fdf-42e1-99d9-58d7babd3faf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb943ce05a63be5d98e4cb82ccabb8c4", "srcset": "https://si.imgix.net/d23a3b93/uploads/origins/b29fe341-9fdf-42e1-99d9-58d7babd3faf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb943ce05a63be5d98e4cb82ccabb8c4, https://si.imgix.net/d23a3b93/uploads/origins/b29fe341-9fdf-42e1-99d9-58d7babd3faf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a95ca4a661fa02c8da326a6d178f2ffd 2x, https://si.imgix.net/d23a3b93/uploads/origins/b29fe341-9fdf-42e1-99d9-58d7babd3faf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae0b1e53022703a81ebe2795f66d967a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d23a3b93/uploads/origins/b29fe341-9fdf-42e1-99d9-58d7babd3faf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08e97f59024a23a29ee219d4a74eb203", "srcset": "https://si.imgix.net/d23a3b93/uploads/origins/b29fe341-9fdf-42e1-99d9-58d7babd3faf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08e97f59024a23a29ee219d4a74e