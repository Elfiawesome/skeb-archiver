%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4afa8448d044d91292828979a5c9c976 3x"}, "body": "初めてご連絡させていただきます、Vtuberの猫々宮ねうと申します。とても可愛らしいイラストに惹かれてお声掛けしました。\nもし良ければ私の姿を描いていただけたら嬉しいです。\n\n①キャラ設定\n猫×死神がモチーフです。\nさまよえる魂を導く死神は、捉え方次第では天使と感じる人もいるのではないか？との観点から天使にも見える姿をしています。イメージカラーは白･ピンク･黒。\n\n②使用用途\n配信(動画内、サムネetc)、SNS活動、アイコン、グッズ制作\n※上記内容含め使用できない内容がありましたら、イラストとは別のレイヤーにご記載頂けますと幸いです\n\n③構図/ポーズ希望\nFPS･TPSゲームをする機会が最近多いので銃を持っている姿をお願いしたいです。他の方と同じような全身のイラストが希望です。かっこよさとかわいさの混在した雰囲気や儚げなものが好きです。\nその他はぬば様の思うまま描いていただけたら嬉しいです。\n\n④キャラデザ資料\nhttps://drive.google.com/drive/folders/1Z2vdG-T8auLFiunZfCGcdT7AcSd4HknE\n\n⑤その他希望\n背景付と透過データを分けていただけるととても助かります。\n\n以上になります。\nお手数おかけしますが、ご検討いただけますと幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NanashitaShiki/works/37", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1481524, "client_id": 3308322, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d37fc061/uploads/origins/e389bd5e-e2f4-43ac-83a9-5aa345bf4bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19f61c3e60ce49f6f36f3fb35eb07de0", "srcset": "https://si.imgix.net/d37fc061/uploads/origins/e389bd5e-e2f4-43ac-83a9-5aa345bf4bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19f61c3e60ce49f6f36f3fb35eb07de0, https://si.imgix.net/d37fc061/uploads/origins/e389bd5e-e2f4-43ac-83a9-5aa345bf4bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5722d7e5ed21073f46e5e7331fd0d582 2x, https://si.imgix.net/d37fc061/uploads/origins/e389bd5e-e2f4-43ac-83a9-5aa345bf4bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d2d487d3e1f7a5aa465b784f5932c9f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d37fc061/uploads/origins/e389bd5e-e2f4-43ac-83a9-5aa345bf4bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c58cf2aa6858a09116d311856956e19d", "srcset": "https://si.imgix.net/d37fc061/uploads/origins/e389bd5e-e2f4-43ac-83a9-5aa345bf4bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c58cf2aa6858a09116d311856956e19d, https://si.imgix.net/d37fc061/uploads/origins/e389bd5e-e2f4-43ac-83a9-5aa345bf4bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=201b03d3dff8dac436de3137c11cedae 2x, https://si.imgix.net/d37fc061/uploads/origins/e389bd5e-e2f4-43ac-83a9-5aa345bf4bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4b3a1c8115a4b7b0eaaee5932ed4b89 3x"}, "body": "ななしたしき様\n\n以前はとってもかわいい立ち絵を描いていただきありがとうございました！\n今回は自分のOCとして考え中の子のイメージを膨らませたく、全身の立ち絵のイラストを依頼したいです。背景の有無は問いません。\n\n頭部→髪色ピンク、ロング、二つに結んだ長め三つ編み、後れ毛や垂れている箇所のある無造作な髪、ヘアピンが付いている(デザインお任せ)\n顔→色白、薄めのチーク、左目に眼帯(ピンクリボンの装飾あり)\n瞳→ピンク\n服→配色は白とピンク中心(少し黒があっても良いです)、雰囲気はゴスロリ、サブカル、天使界隈系。\n猫耳のビッグシルエットのパーカー、首元から首輪が覗いている、ボトムは履いておらず太腿が見える。袖は萌え袖。袖の部分にリボンやベルトなど装飾があると嬉しいです。\n脚は細いですが、厚底のがっつりしたブーツ、ベルトなどの装飾がついた太めのレッグウォーマーを履いていて、背中に小さめの天使の羽が生えています。\nピンクの尻尾の先に鈴付きのリボンが結ばれています。\n\nパーカーの帽子は、できれば差分で被っているものと外しているものを希望したいですが、金額的に難しい場合は被っているもののみで問題ありません！\n\n全体的な色や雰囲気は白ピンクで甘めですが、服はかっこいい系で、甘さの中にも辛さや強さの混在するキャラだと嬉しいです。\n\nポーズや詳細なデザインなど希望のない部分は全てななしたしき様にお任せします。\n\n今回は自分の中でまだ曖昧なもののイメージを形にしてみたいという依頼で、実際の活動にどう利用するかは未定ですが、SNSや動画内、配信活動での利用許可をいただけますと幸いです。\n\nまた、今後Vtuberのアバターを本格的に作っていく際、このキャラを元にする事になるかもしれせんのでその許可をいただくことができるかもご検討お願いします。(このキャラのデザインの要素があるものを他のクリエイター様に依頼してもよいか等)\n\n可能であれば、 レイヤーを人物・背景がある場合は背景透過版のPSDファイルでいただけると嬉しいです。\n\n髪色、髪型、服装のイメージは資料を添付いたします。資料はあくまで雰囲気のイメージなので、アレンジ等加えていただいても構いません。参考画の服は色が異なりますが希望は白ピンク+少し黒です。\n\nskebでの依頼が初めてのため、何か不都合があった際はご指摘ください。よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1O8vjqk5g_p8_djxna0XeLhVTeswX0xOi?usp=sharing\n\nhttps://drive.google.com/drive/folders/1O8vjqk5g_p8_djxna0XeLhVTeswX0xOi?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "c