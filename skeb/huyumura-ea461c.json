・眼鏡あり\n・びっくりしている\n・真剣な顔\n・ωみたいな口をしているところ\nなど。\n\nつらつらと書きましたが、金額に見合う範囲で差分をいろいろ頂けたら嬉しいです。\n（レイヤーで切り替える形だと操作しやすくて有難いです）\n\nイラストの用途ですが、アイコンやヘッダーなどのプロフ画像にしたり、HPに掲載したり紹介したりするのに使うかもしれません。\nまた、フリーペーパー・ZINEに使うかもしれないので、印刷に使える設定（600dpi、10㎝×10cmくらい？）だと有難いです。\nキャラクター・背景・サインはレイヤー分けしたものをいただけると嬉しいです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@huyumura/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 313033, "client_id": 1287611, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f88c84b/uploads/origins/bcefac97-7d56-4568-986c-e92ac5f30266?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a87d44261c36ebc99741127a683d33a5", "srcset": "https://si.imgix.net/2f88c84b/uploads/origins/bcefac97-7d56-4568-986c-e92ac5f30266?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a87d44261c36ebc99741127a683d33a5, https://si.imgix.net/2f88c84b/uploads/origins/bcefac97-7d56-4568-986c-e92ac5f30266?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1da2b11290e208e18c1af174708677d 2x, https://si.imgix.net/2f88c84b/uploads/origins/bcefac97-7d56-4568-986c-e92ac5f30266?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c69a636bd4c74bfe8b73047b0794e6d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f88c84b/uploads/origins/bcefac97-7d56-4568-986c-e92ac5f30266?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcd8305fca42b2d663be4f361823a440", "srcset": "https://si.imgix.net/2f88c84b/uploads/origins/bcefac97-7d56-4568-986c-e92ac5f30266?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcd8305fca42b2d663be4f361823a440, https://si.imgix.net/2f88c84b/uploads/origins/bcefac97-7d56-4568-986c-e92ac5f30266?bg=%23fff&auto=format%2Ccomp