fa3cff0891c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c05f8d85aa19af45de9970fa3be0833e", "srcset": "https://si.imgix.net/2a9bdd27/uploads/origins/8c26611e-b374-469c-9e2c-6fa3cff0891c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c05f8d85aa19af45de9970fa3be0833e, https://si.imgix.net/2a9bdd27/uploads/origins/8c26611e-b374-469c-9e2c-6fa3cff0891c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=838815b74abbb5ffb79c320b9cc8c6ef 2x, https://si.imgix.net/2a9bdd27/uploads/origins/8c26611e-b374-469c-9e2c-6fa3cff0891c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=01edcdb478deb79582075f2956c9b9ea 3x"}, "body": "前回は素敵なSSをありがとうございます...！\nハラハラする展開だったり、互いの関係性だったりとすごく面白かったです...！\nもしよろしければ、うちのOCの「鮫氷しゃち」でSSをまたお願いすることは可能ですか...？ \n参考までに設定は以下のとおりですが、舞台背景、その他登場人物等、自由に書いていただいて構いません。\n███\n鮫氷 しゃち（さめすが しゃち）\n細身かつ色白の黒髪ロングストレート。\n白と黒を基調にしたセーラー服にセーラーキャップを着こなす。\nアイドル的な元気さと明るさに加え、清楚で可憐な容姿をしている。 \n好奇心旺盛で趣味はテーマパーク巡りと人間観察。\nかなりの偏食家で、気に入ったものはヘビロテする。その一方で飽きるのも早い。  \n親しい間柄の相手でさえ巧みに感情を操って都合よく利用する。\nその言動はどこか演技的で大げさ。\n先天的に共感性が欠落しており、一見感情のように見えるものは人間観察の結果身に着けたものでしかない。\n███\n著作者様のクレジット表記ありでSNSや個人サイト等でのキャラクター紹介等での掲載、コミッション等での朗読依頼等も考えています。\nもしもご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/15QcfblJ6ABjLUrKZ3ijKi-ncxD6c6GKd", "nc": 128, "word_count": 2051, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@rosin_y/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 2536570, "client_id": 2168110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fbe09d33/uploads/origins/bf2625f9-5d2f-458b-933c-d35fdd4810cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8542e5962beb6d87051d63ed58fe1f87", "srcset": "https://si.imgix.net/fbe09d33/uploads/origins/bf2625f9-5d2f-458b-933c-d35fdd4810cc?bg=%23fff&auto=format%2Ccompress