46ba66e6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0d92a7e48a902cf35068e1b78b069549 3x"}, "body": "しらのさんこんにちは！いつも素敵なイラストを拝見しました！\n\nしらのさんの絵柄が好きで、うちの子（代理キャラ/ファーソナ/アバター）をしらのさんのスタイルで描いてほしいです！名前はフォンデュです！\n普段は明るいけど、シャイな一面もある子です！\n\n要望\n‧キャラはカメラ目線でお願いします。他のシチュや構図や背景などはおまかせします！\n‧前足と後足の白い部分の形は同じです。形は一枚目の画像を参考にしてください。\n\nよろしくお願いします！\n\n利用範囲\n◆自分のSNSへクリエイター名を明記したうえでの掲載\n◆個人使用（非商用）の範囲での印刷\n\nhttps://i.imgur.com/LDseAlh.png\n\nhttps://drive.google.com/drive/folders/1zR0O6BPp-fFABzQmoSi0TkxiB9CC0mTA", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@foxonthedog/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 436320, "client_id": 3018864, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b510355/uploads/origins/a0b579c4-61fd-4011-be8a-c6767be26793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb3947c28a12554acc08dd76e176263f", "srcset": "https://si.imgix.net/2b510355/uploads/origins/a0b579c4-61fd-4011-be8a-c6767be26793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb3947c28a12554acc08dd76e176263f, https://si.imgix.net/2b510355/uploads/origins/a0b579c4-61fd-4011-be8a-c6767be26793?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34338e6be4bf3a771f1af415ba9266f1 2x, https://si.imgix.net/2b510355/uploads/origins/a0b579c4-61fd-4011-be8a-c6767be26793?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5a21fc90dcb2abc4a5a9e3c81fb26b6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b510355/uploads/origins/a0b579c4-61fd-4011-be8a-c6767be26793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=487a2268d7feb9e639da31eab6d3e382", "srcset": "https://si.imgix.net/2b510355/uploads/origins/a0b579c4-61fd-4011-be8a-c6767be26793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=487a2268d7feb9e639da31eab6d3e382, https://si.imgix.net/2b510355/uploads/origins/a0b579c4-61fd-4011-be8a-c6767be26793?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dd54552ef670fd2fe9cebf627241c736 2x, https://si.imgix.net/2b510355/uploads/origins/a0b579c4-61fd-4011-be8a-c6767be26793?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2bade2da64922d8ef1bb01adae6b88f9 3x"}, "body": "しらのさま、初めまして！\nなみりあと申します。\n\n\n温かくてかわいいしらのさんのイラストが好きで、リクエストをさせていただきました。\n\nよろしければ「いくつかおまもりを身に着けた灰色の狼」を描いていただきたいです。\n元は人型のオリジナルキャラクターなのですが、それをベースにオオカミの姿を描いていただきたいです。\n\n◆描いていただきたいおまもり\n・赤いマフラー\n・しっぽのひも付き三つ編み\n・後ろ脚に結ばれた水色の石\n（ポーズなどのために見えないおまもりがあっても問題ありません）\n\n◆雰囲気など\n・秋の季節と温かい雰囲気が感じられて、さらに和の雰囲気が感じられると嬉しいです…！\n・ポーズや構図はしらのさんにお任せできればと考えております。\n\n◆その他お願い事\n・可能であれば、メインのイラストの他にキャラクターの透過データを併せていただけると嬉しいです。\n・イラストは完全個人利用かつ非営利の範囲でグッズを作成することを許可していただきたいです。（プリントして額縁に飾るなど）\n・イラストはDiscord内の配信等に登場させるために良識の範囲内での加工を許可していただきたいです（顔まわりのみをサムネに登場させるために拡大するなど）\n\n以下は人型キャラクターの参考資料でございます。\nよろしくお願いいたします…！\nhttps://drive.google.com/drive/folders/18jJwR98549nTGGpD5aa3kuaOcBXajMih?usp=sharing\n\nhttps://drive.google.com/drive/folders/18jJwR98549nTGGpD5aa3kuaOcBXajMih?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@foxonthedog/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 436320, "client_id": 421066, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f702601b/uploads/origins/89a6dc16-7b8b-42f6-a4a7-16767156bb87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=549fa7166edb3191e169f5bd0bdec1f6", "srcset": "https://si.imgix.net/f702601b/uploads/origins/89a6dc16-7b8b-42f6-a4a7-16767156bb87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=