le": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@tatsuhoju/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 409574, "client_id": 412589, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea95220a/uploads/origins/8c0108c6-21e3-494c-8388-fff22205b4ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd4c661a904b76c04e7e5562d98bbec3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea95220a/uploads/origins/8c0108c6-21e3-494c-8388-fff22205b4ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ae4dc7d8b1d1200e55d83bd08e44a9e", "src_set": ""}, "body": "鳳樹さんのオリキャラのルカちゃんと、私のオリキャラのカレンが裸の状態でシリンダーの中に入るシチュエーション(所謂、雌シリンダー)を描いてほしいです。\n\n【カレン・エラスティア】\nルカちゃんと同じくらい体が柔らかい猫耳っ子です。\n詳細は資料URLにまとめてあります。\n\n【シチュエーション全体の流れ】\n・ルカちゃんとカレンが、それぞれ透明でペンくらいのサイズのシリンダーを手に持つ\n・それぞれが手に持ったシリンダーの中に体をギュムギュム押し込む。\n・全身が入った後、今度は頭とお尻の部分だけ、シリンダーの中から出す\nと言った内容でお願いします。\n資料URLの方に参考資料にとなる漫画を載せておきました、全体的な流れは資料の漫画と同じです。\n\n【描いてもらえると嬉しい所】\n・顔の変形、顔グニャが好きなのでそこらへんを多めに描いてもらえると嬉しいです。\n・カレンは基本的にこういう事を進んでやる子なので、楽しそう(できれば蠱惑的な感じ)に描いてくれると嬉しいです。\n・ルカちゃんのリアクションはお任せします。\n・どちらも裸の状態でお願いします。\n\nhttps://drive.google.com/drive/folders/1PtXVIxsu8lLuYfYo6ALhduOni3-KC1m-?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tatsuhoju/works/22", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/18158746/uploads/origins/7c00886f-eec5-4947-bcee-cfe32d72751a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=20b84327644a1e34fbdd979911a40a56", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 409574, "client_id": 120808, "vtt_url": "", "thumbnail_image