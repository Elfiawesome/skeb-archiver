%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e247d91b83d2f8718bd30484406a0e9", "srcset": "https://si.imgix.net/bb911f96/uploads/origins/c8947466-0231-4d40-87fe-50315fd1abf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e247d91b83d2f8718bd30484406a0e9, https://si.imgix.net/bb911f96/uploads/origins/c8947466-0231-4d40-87fe-50315fd1abf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5de46afe83b690bd322ddf9a32f183cb 2x, https://si.imgix.net/bb911f96/uploads/origins/c8947466-0231-4d40-87fe-50315fd1abf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8eb94533b35e4557db572dca09f0e15a 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb911f96/uploads/origins/c8947466-0231-4d40-87fe-50315fd1abf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d27d7752c987f4b73ad1dad4fe4dfa21", "srcset": "https://si.imgix.net/bb911f96/uploads/origins/c8947466-0231-4d40-87fe-50315fd1abf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d27d7752c987f4b73ad1dad4fe4dfa21, https://si.imgix.net/bb911f96/uploads/origins/c8947466-0231-4d40-87fe-50315fd1abf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ac5de0731d34bdf852439224c949bc8 2x, https://si.imgix.net/bb911f96/uploads/origins/c8947466-0231-4d40-87fe-50315fd1abf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fb1b89b67a9fb4219a75220c56c61cb6 3x"}, "body": "女の子と特におっぱいがエロかったので特殊シチュになりますが可能そうな範囲でお願い致します！\n\n作品名：最弱無敗のバハムート\nキャラ名：アイリ、ノクト(https://imgur.com/a/jT6w9At)\nシチュ：\nメカクレ男子(目の描写はない方がいいです)が着衣超乳&特大着衣ボテ腹姿のアイリの着ぐるみに擬態した触手着ぐるみを強制装着させられ、\n内部で触手にペニスやアナル、前立腺を嫐られ着ぐるみ内部で大量射精させられているドMホイホイシチュ。\n着ぐるみはゴミを見るような冷めた目(顔の上部や目元まで影がかかる感じでハイライトなし希望)状態で、\n変態ドM男への嫌悪感を一切隠さない侮蔑の表情をしている様子を希望します。\n着ぐるみが難しい場合は触手皮でもOKです。\n\nアイリ着ぐるみは両手が簡単に沈む、上半身以上のサイズかつ服の上から透けたピンク色の勃起乳首がわかる着衣超乳と特大着衣ボテ腹姿で\nまた服の中にギチギチに押し込まれた胸やボテ腹が強調されるような大きさとポーズで、\n衣装は着衣超乳や着衣ボテ腹用に調整して頂いて問題ありませんので、肌は服で隠れてしまっている様子(完全着衣状態)でお願いします。\nまた着衣ボテ腹下腹部に妊娠を示すような怪しく光る淫紋の描写を希望します。\nまたこちらは予算的に可能でしたら内部で触手が暴れることで着衣超乳やボテ腹着ぐるみ越しに内部で触手が波打ってる表現を希望します。\n\n触手着ぐるみの内部は特濃粘液にまみれた触手地獄と化しており、ペニスや乳首を丸呑みにする吸引触手や吸盤ブラシ触手の群れが溢れていたり、\n前立腺責め用の産卵触手等なるべくえげつない構造にして頂ければ幸いです。\n\nまた予算的に可能であれば、同じような犠牲者として同様の勃起乳首がわかる着衣超乳&淫紋付き特大着衣ボテ腹姿+顔の上部や目元まで影がかかる感じでハイライトなしでM男を無表情寄りの表情で侮蔑する\nノクトの触手着ぐるみを着せられたもう一人のメカクレ男子の描写ができましたら希望します。\n\n可能でしたら触手肉壁やダーク系の背景で、\npsd形式で射精差分、粘液まみれの触手が蠢く水音や喘ぎ声等の効果音の有無、着ぐるみの顔の上部の影と瞳のハイライトの有無をON/OFF切り替え表示希望です。\n\n各種触手参考：https://imgur.com/a/I02AVSy\n触手服参考：\n\nhttps://imgur.com/a/H5hiMNv", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nika_kamu/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/58193584/uploads/origins/1ea47743-2710-490a-9a1c-5962cc8bc2af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa0e4b50977d468563ff0df34278c524", "srcset": "https://si.imgix.net/58193584/uploads/origins/1ea47743-2710-490a-9a1c-5962cc8bc2af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa0e4b50977d468563ff0df34278c524, https://si.imgix.net/58193584/uploads/origins/1ea47743-2710-490a-9a1c-5962cc8bc2af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=65dc77799ca6db913f2b1b0056cddf7e 2x, https://si.imgix.net/58193584/uploads/origins/1ea47743-2710-490a-9a1c-5962cc8bc2af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c38b64493cbb5fcbb2e4d150acd03a6 3x"}, "pr