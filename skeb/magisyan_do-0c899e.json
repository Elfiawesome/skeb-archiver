.net/artworks/72630169\nこの11枚目の絵にある腋の隙間から手を入れて胸などを触られていたり\n恋人みたいに舌を絡めるキスをしている（直接絵は無くても舌と舌が唾液で繋がって居るなど）\nがあると良いのですが…\nあまり多くを要求すると手間だと思うので描きやすいように描いて頂きたいです。\n\n連続依頼はこの依頼までで我慢しますので\nよろしければお願いします、長文失礼しました。\n\nhttps://pocket.shonenmagazine.com/episode/10834108156630546365", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@magisyan_do/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 384090, "client_id": 545947, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1193c22/uploads/origins/a6d1c02a-265e-4436-ba97-3c14cee8a6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b1f814ffd71b3812172b8f5d967278f", "srcset": "https://si.imgix.net/d1193c22/uploads/origins/a6d1c02a-265e-4436-ba97-3c14cee8a6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b1f814ffd71b3812172b8f5d967278f, https://si.imgix.net/d1193c22/uploads/origins/a6d1c02a-265e-4436-ba97-3c14cee8a6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f9c9c26d6ee4476560d204c80f94e23 2x, https://si.imgix.net/d1193c22/uploads/origins/a6d1c02a-265e-4436-ba97-3c14cee8a6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3733f8e48ed3aca5d2e4b94432514d4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1193c22/uploads/origins/a6d1c02a-265e-4436-ba97-3c14cee8a6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7368a49cdc7d11b868401578c5f6febd", "srcset": "https://si.imgix.net/d1193c22/uploads/origins/a6d1c02a-265e-4436-ba97-3c14cee8a6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7368a49cdc7d11b868401578c5f6febd, https://si.imgix.net/d1193c22/uploads/origins/a6d1c02a-265e-4436-ba97-3c14cee8a6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2