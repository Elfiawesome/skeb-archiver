04d4cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8665ac4242f3020b3890f7424f840b78", "srcset": "https://si.imgix.net/1ea95622/uploads/origins/f24b8131-7f46-4748-a4b3-753dc04d4cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8665ac4242f3020b3890f7424f840b78, https://si.imgix.net/1ea95622/uploads/origins/f24b8131-7f46-4748-a4b3-753dc04d4cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b1a15cc2f1817d3874cbfebdf25314e5 2x, https://si.imgix.net/1ea95622/uploads/origins/f24b8131-7f46-4748-a4b3-753dc04d4cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e0c231f28727f6ed5ab2b57d166cfaff 3x"}, "body": "お邪魔します！あなたの描くモノクロの男性がとても好きです。特にこちらの作品のようなタイプが好みです：https://skeb.jp/@ro_gaku/works/16私のオリジナルキャラクター（OC）にも、このようなモノクロのイラストを描いていただけませんか？\n\n【キャラクター設定】彼は「破壊」を象徴し、本体は黒い竜。人間形態では黒髪・赤目、変装時は銀髪・銀目となる。紫の炎を操ることができ、炎を使用する際には目が変装時の銀色から赤色に戻る。性格は非常に冷酷で、表面は抑制されているが実は極めて残虐である。\n参考図では伝わりづらいかもしれませんが、実は筋肉質で非常に強靭な体格です。筋肉の張りや胸部を大きく描いていただけると嬉しいです！衣装は自由に選んでいただいて結構です、ご自由にアレンジしてください！\n\nここまでご覧いただき誠にありがとうございます。金額が合わない場合は、再度リクエストをお送りください！ https://drive.google.com/drive/folders/1BllWJN9nC6CLFWkVs5UGaqfwggXzkfyc", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ro_gaku/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3282478, "client_id": 450030, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46db7f1c/uploads/origins/75ba94ce-822b-4bf4-b8c9-0a7c1e053192?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a62f7fe1954b4da5c3b8cb361fecf269", "srcset": "https://si.imgix.net/46db7f1c/uploads/origins/75ba94ce-822b-4bf4-b8c9-0a7c1e053192?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a62f7fe1954b4da5c3b8cb361fecf269, https://si.imgix.net/46db7f1c/uploads/origins/75ba94ce-822b-4bf4-b8c9-0a7c1e053192?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0faa1c35ea7335b69c547f9d5397475 2x, https://si.imgix.net/46db7f1c/uploads/origins/75ba94ce-822b-4bf4-b8c9-0a7c1e053192?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e65dfea8644eef104dba68637b731d9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46db7f1c/uploads/origins/75ba94ce-822b-4bf4-b8c9-0a7c1e053192?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5bbbc36025be2cd2c9fde054a865424", "srcset": "https://si.imgix.net/46db7f1c/uploads/origins/75ba94ce-822b-4bf4-b8c9-0a7c1e053192?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5bbbc36025be2cd2c9fde054a865424, https://si.imgix.net/46db7f1c/uploads/origins/75ba94ce-822b-4bf4-b8c9-0a7c1e053192?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=42eb3f58671bd1d5553f1d710d0812be 2x, https://si.imgix.net/46db7f1c/uploads/origins/75ba94ce-822b-4bf4-b8c9-0a7c1e053192?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=074f0e02aca2baa5108bc84b0054f00d 3x"}, "body": "初めまして炉學様。佐久瀬 三歩と申します。\nSkebサムネ、Xのヘッダー等を拝見し黒の表現がとても素敵でこの度リクエストをお送りいたしました。\n\nこちらの中央のオリジナルキャラクターを描いていただけますでしょうか。\n自身で描いたキャラクターではございませんが、著作権を保有していらっしゃる作者様から承諾をいただいております。\nhttps://x.com/sakuse_sanpo/status/1439272072904003590?s=20\n\n↓資料複数点\nhttps://www.dropbox.com/scl/fo/qrwk91gjrxo8l3opourq8/AMOL54ghD9gRBG5FDShRXMU?rlkey=m8sw51ic1uj4cnttja0ygtwpr&dl=0\n\n[キャラクタープロフィール]\n元司法監察医の刑事。\n勤務態度は気だるげで不真面目なようだが、相棒(Xリンクの左側のキャラクター)がいない時はしっかり働く模様。\n持ち前の要領の良さと監察医時代に培ったスキルを活かし仕事もそつなくこなす。\n\n大柄で目つきが悪い上に口調も乱暴。まさに一匹狼といったタイプ。\n威圧的な印象を与え、何かと目を付けられては不遇な扱いを受けることが多かった。\nまた、学生時代から現在に至るまで総合格闘技を続けており、さらに喧嘩で培った型にはまらない戦い方をする。\n気絶しても何度も立ち上がってくるような、不死身かと思わせるような生命力の強さもある。\n怒りっぽいということはないが我が強いために道理に反することがあれば手が付けられなくなる。\n人を寄せ付けず誤解されやすいタイプだが、深く関わった人ほど傍に居つくことから不器用ながらに人柄の良さが垣間見える。\n\n＿＿＿＿＿＿＿＿＿＿＿＿\n\n\nキャラクターも黒の多いキャラクターとなっていますので、黒をふんだんに使って様々なアングル(横顔、斜めアングル、俯瞰あおりが好きです)、シチュエーションでイラスト詰めとして描いていただけると嬉しいです。\n↓のような感じです\nhttps://x.com/ro_gaku/status/2022595100975751498?s=20\n\nシチュエーションとしては下記のものを提案させていただきます。\n・うたた寝\n・多量の流血／負傷\n・着替え\n・その他お任せ\n※規約に従い全てのシチュエーションを押さえる必要はございません。\n\n\nお忙しいところ恐縮ですがよろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ro_gaku/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3282478, "client_id": 3701960, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59b2944d/uploads/origins/b56dc6d0-d9a0-4254-9e91-4858c5d32e64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e89a37b8e9d2e8bfa17ee58511826fa", "srcset": "https://si.imgix.net/59b2944d/uploads/origins/b56dc6d0-d9a0-4254-9e91-4858c5d32e64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e89a37b8e9d2e8bfa17ee58511826fa, https://si.imgix.net/59b2944d/uploads/origins/b56dc6d0-d9a0-4254-9e91-4858c5d32e64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b165cb6c0aa313cf06f6fbdefb7581a 2x, https://si.imgix.net/59b2944d/uploads/origins/b56dc6d0-d9a0-4254-9e91-4858c5d32e64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69cabde763777f6c9601b059c79475fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59b2944d/uploads/origins/b56dc6d0-d9a0-4254-9e91-4858c5d32e64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7d3fea5b5e47a3e652a5e22786368cb", "srcset": "https://si.imgix.net/59b2944d/uploads/origins/b56dc6d0-d9a0-4254-9e91-4858c5d32e64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7d3fea5b5e47a3e652a5e22786368cb, https://si.imgix.net/59b2944d/uploads/origins/b56d