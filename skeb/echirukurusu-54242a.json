8d6-4514-b1a4-aabf54eb4ec0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a90ea51bd44487b1b5caa4f274223fd", "srcset": "https://si.imgix.net/3e562587/uploads/origins/ae5bdfd2-88d6-4514-b1a4-aabf54eb4ec0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a90ea51bd44487b1b5caa4f274223fd, https://si.imgix.net/3e562587/uploads/origins/ae5bdfd2-88d6-4514-b1a4-aabf54eb4ec0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=82182d5c08128cb61acd67ccbeccf0cd 2x, https://si.imgix.net/3e562587/uploads/origins/ae5bdfd2-88d6-4514-b1a4-aabf54eb4ec0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eabaa1071e00d416d1acdaeb32f9c596 3x"}, "body": "かなり特殊なリクエストになります。無理な場合はキャンセルを、非表示をご希望の場合は再送要請ををお願いします\n艦これの時津風がポケモンのアーボックに巻き付かれている絵をお願いします\nアーボックは時津風の首から下を４巻程で隙間なく巻き付け、時津風の頭の上に頭を乗せ鼻の付近まで舌を出して下さい。アーボックの口は閉じてください\n全身巻き付かれている事を強調する為、時津風の全身を描いて頂けるとうれしいです\nできればアーボックは通常色と色違いをお願いします\nさらに大丈夫ならアーボックの尻尾で首を巻き付けているパターンと巻き付けていないパターン(どちらかでしたら巻き付けていないパターン)をお願いします\n時津風の表情ですが、（無理なようでしたら①と④を優先でお願いします）又、できればどの表情もアーボックは通常色と色違いをお願いします。\n①締め付けられて涙目で苦しんでいる（目は閉じています）\n②苦しんでいるけど若干感じていて赤面になっている（目は閉じています）\n③苦しいけど若干気持ちよくて恥ずかしがっている（目は開けています）\n④嬉しくて締め付けられているのに笑っている（目は開けています）", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@echirukurusu/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2736112, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/542200fd/uploads/origins/6423db9c-4832-42c4-aa2f-7faff3645177?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98673a7a070e72d28a6e6c19e6fa1414", "srcset": "https://si.imgix.net/542200fd/uploads/origins/6423db9c-4832-42c4-aa2f-7faff3645177?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98673a7a070e72d28a6e6c19e6fa1414, https://si.imgix.net/542200fd/uploads/origins/6423db9c-4832-42c4-aa2f-7faff3645177?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a5ecefafd0408cf04c16da387c15de1 2x, https://si.imgix.net/542200fd/uploads/origins/6423db9c-4832-42c4-aa2f-7faff3645177?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40191320465df2549ff7b26379a96799 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/542200fd/uploads/origins/6423db9c-4832-42c4-aa2f-7faff3645177?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2e9a4d203a90f9f8a3db9ebc482bc57", "srcset": "https://si.imgix.net/542200fd/uploads/origins/6423db9c-4832-42c4-aa2f-7faff3645177?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2e9a4d203a90f9f8a3db9ebc482bc57, https://si.imgix.net/542200fd/uploads/origins/6423db9c-4832-42c4-aa2f-7faff3645177?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28db4bd53c9ee8527c30e49b2c92b7c7 2x, https://si.imgix.net/542200fd/uploads/origins/6423db9c-4832-42c4-aa2f-7faff3645177?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=21b3a18242bf27fa46fe02feeca78861 3x"}, "body": "何度かミコチのリクエストをさせていただいた者です。いつもお世話になっております。\n今回は絵散るさんのサキュバスまとめ本に出ていたムイちゃんがとても好みのキャラだったのでリクエストさせていただきます。\n\n大まかな流れとしては、搾精しようとした男のあまりの短小包茎（しかも早漏）ちんぽに若干呆れつつ、世話を焼いて毎日抜いてくれるようなるものの、毎日皮をいじられたせいで余計に包茎が悪化してしまう…といった感じでお願いします。\n\n以下、詳細です。\n\n•ちんぽ出すよう男に言う。\n•ぽろんとちんぽをムイちゃんの顔の前に出す。（太さはそれなりだが長さは短い、先端まで皮が余っている包茎）\n•若干呆れたような様子。「勃起してこれなのか？」みたいな台詞。\n•定規を当てて長さを測る。（5cmくらい）\n•先端まで余ってる皮を伸ばされ、すぐに射精してしまう。\n•呆れつつも、こんなちんぽじゃ心配だから、と毎日搾精してやると皮をいじりながら約束してくれる。\n•何日後かになり、もう一度定規で長さを測ることに。（毎日皮を伸ばされて余った皮が下に垂れている。太さ、長さは本体と同じくらい）\n・皮を定規と平行に引っ張られて長さ測定。\n・皮も合わせて10cmくらいになっており、平均は13cmだからもう少し頑張れと励まされ、同時に射精。\n・さらに何日後かになり、同じ流れで測定。さらに皮が伸びて20cmを超えており、平均以上のちんぽになったと褒められる。\n・最後に「こんなちんぽじゃ女の子に見向きもされないって？バカヤロー、これからもボクが毎日抜いてやるよ」と励まされ、皮の先から情けなく射精。\n\n長々と書いてしまいましたが、台詞や流れは絵散るさんの描きやすいように自由に変えて下さって構いません。\n\n毎回マニアックな上に、今回は絵散るさんのオリキャラということで、解釈違い等ありましたら申し訳ありません…！\nご検討の程よろしくお願いします！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@echirukurusu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2736112, "client_id": 108989, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1be41ae4/uploads/origins/3a2caa01-7b80-45c9-b4a6-6ae4f8ceef5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04faa3c3a075e2a319ed5f5383095cb6", "srcset": "https://si.imgix.net/1be41ae4/uploads/origins/3a2caa01-7b80-45c9-b4a6-6ae4f8ceef5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04faa3c3a075e2a319ed5f5383095cb6, https://si.imgix.net/1be41ae4/uploads/origins/3a2caa01-7b80-45c9-b4a6-6ae4f8ceef5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b79db3473f1a19067e35f539bf26239 2x, https://si.imgix.net/1be41ae4/uploads/origins/3a2caa01-7b80-45c9-b4a6-6ae4f8ceef5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83360af03ff1abf2832e4c9f0303ed9a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1be41ae4/uploads/origins/3a2caa01-7b80-45c9-b4a6-6ae4f8ceef5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b38e7aa7454220686806a228ddcbc06", "srcset": "https://si.imgix.net/1be41ae4/uploads/origins/3a2caa01-7b80-45c9-b4a6-6ae4f8ceef5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b38e7aa7454220686806a228ddcbc06, https://si.imgix.net/1be41ae4/uploads/origins/3a2caa01-7b80-45c9-b4a6-6ae4f8ceef5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=78ea7a1ad2f7c4acf960277f845d7997 2x, https://si.imgix.net/1be41ae4/uploads/origins/3a2caa01-7b80-45