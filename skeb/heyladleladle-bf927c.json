8-4347-9e0a-06091064949e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9398cd6c4aae4f094f68d30acab734ca", "srcset": "https://si.imgix.net/ca0d4632/uploads/origins/845c5ef2-4c58-4347-9e0a-06091064949e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9398cd6c4aae4f094f68d30acab734ca, https://si.imgix.net/ca0d4632/uploads/origins/845c5ef2-4c58-4347-9e0a-06091064949e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e24ebbd0aec8bda6f4c47ac6fcb700d4 2x, https://si.imgix.net/ca0d4632/uploads/origins/845c5ef2-4c58-4347-9e0a-06091064949e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b10b6103aac67a2140f2f5eb8b481b9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca0d4632/uploads/origins/845c5ef2-4c58-4347-9e0a-06091064949e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f47a890fb350103a6852f750eadbd4a3", "srcset": "https://si.imgix.net/ca0d4632/uploads/origins/845c5ef2-4c58-4347-9e0a-06091064949e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f47a890fb350103a6852f750eadbd4a3, https://si.imgix.net/ca0d4632/uploads/origins/845c5ef2-4c58-4347-9e0a-06091064949e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8e971d989fcb16d778abe61a5abf1e7a 2x, https://si.imgix.net/ca0d4632/uploads/origins/845c5ef2-4c58-4347-9e0a-06091064949e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d631154ec4bcede1f8626d4d0495d948 3x"}, "body": "オルドイニョレンガイ様\n\n平素より大変お世話になっております。\nDX3rd『呆然遺失のホワイト・リリー』卓について、自陣の集合絵の依頼をお願いしたく思いこちらお送りいたします。\n\nお願いしたいのが、4人のキャラクターの集合絵……『亜小屋あきら』『風間習』『房橋猪之助』『トオル』が急に女体化……いやTSさせられてウワーーーッ！！！と驚いてる様子になります。\n以下にいくつか希望を述べるのですが、ご趣味に沿わない場合は全て無視してお好きに描いて頂ければと思います。\n\n希望内容\n・あきら君は髪が急に伸びて「うわうわうわ」してる様子がいいかなと思います。性別不明なので、どちらになった反応なのか分からない形で……\n・風間は身長がぐっと縮んで服がダボつきそうで、「参ったな……」って言ってそうな感じかなと思います\n・房橋さんは狼狽えないで欲しいです。美女……OL……眼鏡を片手でクイッとしてほしいです\n・トオルさんは身長変わらずガタイも変わらずな人外みを貫き通して欲しいです。おっぱいのついたイケメン……？\n\n\n人数が多く、大変お手数かと思いますが何卒ご一考頂けますと大変助かります。\nよろしくお願い致します。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@heyladleladle/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 90961, "client_id": 895602, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34ce412a/uploads/origins/6e6f08be-bcdf-498f-a8af-34bce86d3dc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9ff32b68b97059bba7cdf82281b8552", "srcset": "https://si.imgix.net/34ce412a/uploads/origins/6e6f08be-bcdf-498f-a8af-34bce86d3dc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9ff32b68b97059bba7cdf82281b8552, https://si.imgix.net/34ce412a/uploads/origins/6e6f08be-bcdf-498f-a8af-34bce86d3dc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=623275c811bfa4be213fd893f5de7a60 2x, https://si.imgix.net/34ce412a/uploads/origins/6e6f08be-bcdf-498f-a8af-34bce86d3dc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1c4e25ceffe112015b95f3ef34e2adb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34ce412a/uploads/origins/6e6f08be-bcdf-498f-a8af-34bce86d3dc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e235237180972a6a8199e5db2583f965", "srcset": "https://si.imgix.net/34ce412a/uploads/origins/6e6f08be-bcdf-498f-a8af-34bce86d3dc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e235237180972a6a8199e5db2583f965, https://si.imgix.net/34ce412a/uploads/origins/6e6f08be-bcdf-498f-a8af-34bce86d3dc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a9b956895e8e1463429b90adffaab143 2x, http