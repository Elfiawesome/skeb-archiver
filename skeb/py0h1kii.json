ix.net/065a9243/uploads/origins/fabc5dec-24ec-4981-b719-5d41143d3f59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f89dc906bd7299baa80239b36e2dc350", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/065a9243/uploads/origins/fabc5dec-24ec-4981-b719-5d41143d3f59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a4afe3a50602bcf3fd616a4a04af657", "src_set": ""}, "body": "初めまして。辰星マキリと申します。\nぴょこ様の作品を拝見し、とっても可愛かったので依頼させて頂きました！\n\n【使用用途】\n・SNS等での使用\n・FANBOXでの使用\n・収益化済みYouTube・Twitchでのサムネイル使用 \n\n【要望】\n・衣装は、クラシカルなメイド服でお願いいたします。\n・ポーズ、構図等はお任せいたします。\n・可能でしたらサムネイルでも使えるよう、キャラクターのみの透過素材もご用意いただけると大変助かります。\n\n以上となります。どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1o7YFrOMbSlEKtpWDlhsxMjpuzxrtI4w3?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@py0h1kii/works/395", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3350758, "client_id": 3534052, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df8b8632/uploads/origins/6d54b073-c7af-4b8f-b2be-1143cf6b8fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c0ecf799c6134a50b5a79129786e1f9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df8b8632/uploads/origins/6d54b073-c7af-4b8f-b2be-1143cf6b8fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56dc421d7590bc0555745a7006093c8c", "src_set": ""}, "body": "はじめまして！\n新着作品でかわいいイラストをお見かけして、ぜひご依頼したくお送りさせていただいた次第です。\n\n私の擬人化として「PNDRちゃん」というキャラクター(OC)がいるのですが、そちらをお願いしたいです。\n参考資料\nhttps://x.com/pengdrm/status/1429098249260986370\n\n\nポーズや服装等は全ておまかせいたします。\n\n何卒ご検討の方していただけますと幸甚です。\nどうぞよろしくお願い申し上げます。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@py0h1kii/works/394", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3350758, "client_id": 2951452, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc202535/uploads/origins/978ae136-d370-4132-9189-e61822fe6fdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6b93d5343a608db894065520cbf05ce", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc202535/uploads/origins/978ae136-d370-4132-9189-e61822fe6fdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53591de2eea003c08fbf5381a9cf74d0", "src_set": ""}, "body": "こんにちは！以前描いていただいた絵がとてもかわいくて気に入ったので、またお願いしたいと思います。今回はピローを描いてほしいんだけど、彼女は夢の世界から来た存在で、他の人を慰めて眠れるように手助けしたいんだ。とても優しくて面倒見がいいんだけど、ヤンデレな一面もあって、あなたの注目と愛情をすべて欲しがるの。\n\n参考画像：https://drive.google.com/drive/folders/1M0QRCU5bmXWG2F6F-sDM3aAQZ7HlS53l?usp=sharing\n\n上記リンク先の参考画像を見ればわかるように、彼女にはいくつかの衣装があります。好きな服装、好きなポーズで描いてください！\n\nよろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@py0h1kii/works/393", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3350758, "client_id": 2368152, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26e85640/uploads/origins/9afc460b-06e1-4d5a-b3e0-5df8fa0632dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcaacd32f6026dd0e42fe4df195a02b4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26e85640/uploads/origins/9afc460b-06e1-4d5a-b3e0-5df8fa0632dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa1717917448d070eb4e4e39802f0874", "src_set": ""}, "body": "こんにちは！私のオリジナルキャラクター、紗綾（冴彩）のアートワークをお願いしたいです。\n\n背は低めで155cmくらい、サイズはBカップで、水色のリボンを愛