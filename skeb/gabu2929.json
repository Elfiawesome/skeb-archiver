format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a15025f0316aa4ab7b25b404bfe911fe", "src_set": ""}, "body": "こんにちは！うちの子のイラストお願いしたいです\nガブ🍖関けも10【c-19】さんのこのみのデカさでお願いします！\nブクブクに太っていくシーケンスでお願いします！\n\nhttps://x.com/minya_0413/status/1303902468145729537?t=qz-q5VqL5yykueiy47zLJw&s=19\n\nご検討よろしくお願いします🙏", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gabu2929/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1657848, "client_id": 3428834, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/937962e1/uploads/origins/f2900d63-368a-4b83-a7b3-f4868e778c57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77b779f4316a5dc516eb183cadad34a6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/937962e1/uploads/origins/f2900d63-368a-4b83-a7b3-f4868e778c57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1719a0811d13fc8bfd37edde9bf50833", "src_set": ""}, "body": "ベッドに横たわり、食べ物に囲まれている私のオオカミ少年を描いていただけませんか？彼は顔を赤らめながら片手でハンバーガーを食べ、もう片方の手でお腹を持ち上げて太い脚の脂肪と下腹の脂肪を見せようとしています。\n\n構図は縦横比2:1（縦：横）で、見る人が彼をまっすぐ見下ろすようにしたい。彼のデザインとサイズ／プロポーションについてはリファレンスを参照してください。アスペクト比2：1に収まるように彼を太らせることができれば、それもいいでしょう。\n\nhttps://drive.google.com/drive/folders/1neMBtr6u0396nrq5iaZeqatl1u1KckbN?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gabu2929/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1657848, "client_id": 266626, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6e7802c/uploads/origins/eafc7631-075d-488c-8682-6cb33faed331?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7001f3419592e65720815481d91d76cc", "src_set": ""}, "duration": null, "nsfw": fa