e71f99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f3378faf72ca5199c8bb7cf92ecdfd1, https://si.imgix.net/a068a68b/uploads/origins/db608c1f-96be-4cfc-8e01-95dabae71f99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c580be4fc02da582c065e1f447014a3 2x, https://si.imgix.net/a068a68b/uploads/origins/db608c1f-96be-4cfc-8e01-95dabae71f99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3fb70ec618ec0cb27e9a80fb11176a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a068a68b/uploads/origins/db608c1f-96be-4cfc-8e01-95dabae71f99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=473f433a55feaab888bef1dcc4b08c0c", "srcset": "https://si.imgix.net/a068a68b/uploads/origins/db608c1f-96be-4cfc-8e01-95dabae71f99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=473f433a55feaab888bef1dcc4b08c0c, https://si.imgix.net/a068a68b/uploads/origins/db608c1f-96be-4cfc-8e01-95dabae71f99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3f71eb50b82a99de1c4a0d65bea95143 2x, https://si.imgix.net/a068a68b/uploads/origins/db608c1f-96be-4cfc-8e01-95dabae71f99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=85e3574cea4aa92e0259e476d315a629 3x"}, "body": "ちゃぷちゃん様こんにちは。\n私は個人Vtuberをやっている米穂しいと申します。\n\nちゃぷちゃん様のかわいいくて素敵なイラストに強く惹かれて、\nぜひ私のことも描いてほしいなと思ってリクエストを送っています。\n詳しくは下記の記載してみたのでご確認よろしくお願いします。\n\n私の資料：https://x.com/x_xosakana/status/1930932809423818811\n口を開けたときに見える八重歯がチャームポイントです！\nイラストだと見えていないのですがしっぽもはえています！\n\n使用用途：個人の観賞用でと思っていますが、Xでの描いてもらいました報告や\nYoutubeでのサムネとして、その他Vtuber活動の一環でイラストの一部を使用する可能性があります。\nそのため人物だけの背景透過バージョンもあると嬉しいです。\n\n描いてほしいもの：白スク水を着た私（ポーズ等は指定ありません）\nちゃぷちゃん様はスク水が得意（好き）なのかなと勝手に認識しております。\n白はもしかしたら邪道なのかもしれませんが、ぜひ白スク水を描いてほしいです。\nちゃぷちゃん様のヘキを詰め込んでもらえたらと思います。\n\nお忙しい中恐れ入りますが、ご検討よろしくお願いします。", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ura_chapuchang/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3654196, "client_id": 1865908, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8fd6d74/uploads/origins/7ea56f13-4180-4634-8127-13541684f9fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bbc4df761be471e396ea72909724902", "srcset": "https://si.imgix.net/a8fd6d74/uploads/origins/7ea56f13-4180-4634-8127-13541684f9fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bbc4df761be471e396ea72909724902, https://si.imgix.net/a8fd6d74/uploads/origins/7ea56f13-4180-4634-8127-13541684f9fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d490d1decd63a35d28f2b6c8c3e897d 2x, https://si.imgix.net/a8fd6d74/uploads/origins/7ea56f13-4180-4634-8127-13541684f9fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e6cf06b757ccfbe768218ddf786422d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8fd6d74/uploads/origins/7ea56f13-4180-4634-8127-13541684f9fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb2f0adad48ecd607a230e14d3f325cf", "srcset": "https://si.imgix.net/a8fd6d74/uploads/origins/7ea56f13-4180-4634-8127-13541684f9fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb2f0adad48ecd607a230e14d3f325cf, https://si.imgix.net/a8fd6d74/uploads/origins/7ea56f13-4180-4634-8127-13541684f9fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b6ed486a53629fce10cfb3c92edceb2b 2x, https://si.imgix.net/a8fd6d74/uploads/origins/7ea56f13-4180-4634-8127-13541684f9fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6c00b3e07293e56013d805c879aac776 3x"}, "body": "ちゃぷちゃんさま\n\n初めてご依頼させていただきます。\nちゃぷちゃんさまの描かれる作品は、スク水の質感が素晴らしく、とてもかわいくて大好きです。\n今回ご依頼させていただくイラストのテーマは、初めてスク水を着てわくわくしながらベッド(またはお布団)の上で無邪気に楽しそうに泳ぎの練習をしているましゅねっこちゃんです。\n小学校低学年ぐらいの可愛らしい丸みのある女児体型を再現していただけますと幸いです。\nまた、頭から足の先まで見切れないように描いていただけますと幸いです。\n\n帽子は無しで大丈夫です。\n可能でしたら、ましゅねっこのトレードマークの、きりんさんか四つ葉のクローバーを、スク水または髪飾り等のどこかにワンポイントで入れていただけるとうれしいです。イラスト全体のバランスを見て、無いほうがいい感じでしたら無しで大丈夫です。\n背景のデザインや色合いはおまかせします。優しい雰囲気にしていただけるとうれしいです。\n\nキャラクターは、わたしのキービジュアルを参考にしていただけると助かります。(資料：https://x.com/masyu_necco/status/1715843307946078527?t=Jen-3ywB0CDPcB1xT8o51Q&s=19)\n\n【その他】\n・データは背景ありと背景なし(透過)のPNG形式のデータをいただけるとうれしいです。\n・個人用にアクリルスタンド等を作らせていただく場合があります。\n\nいろいろ書かせていただきましたが、ちゃぷちゃんさまのお好みでアレンジを加えていただいても大丈夫です。\nよろしくお願いいたします。\n\nましゅねっこ", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 8734, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "シロ9じらスケブ募集中", "screen_name": "siro90414", "avatar_url": "https://pbs.twimg.com/profile_images/2109528676132167680/mfy2O5b8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1498108778/1607947973/1500x500", "appeal_receivable": false, "popular_creator_rank": 22, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 501057, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "青井ひなた🌻COMITIA158【え03b】", "screen_name": "Aoi_Hinata_v", "avatar_url": "https://pbs.twimg.com/profile_images/2005323696756736000/578XEnu0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1099316275061248000/1685686153/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days"