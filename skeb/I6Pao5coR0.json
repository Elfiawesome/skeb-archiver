, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@I6Pao5coR0/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3447675, "client_id": 2418023, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d7c35f7/uploads/origins/0fc08431-cf7f-4994-8803-465ab88caf76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8c82163eaba31e8c40dd6d973a8034c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d7c35f7/uploads/origins/0fc08431-cf7f-4994-8803-465ab88caf76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad9235b06e88ada9a07c5e9989dc0cfc", "src_set": ""}, "body": "Hello, I love your style and I would like to request art of my OC character Gwelatin.\n\nThey're a slime made from a science experiment that gained sentience. They're easily flusted but likes to read and study, rather short (152cm) and the core of the slime (the heart) is gold in color.\n\nFor the scene I'll leave it to you. \nFor the expression one where he is excited from research and another where he's blushing would be nice.\n\nGwelatin reference image \nhttps://i.imgur.com/93hvLgA.jpeg\n\nSince I dont have a detailed reference sheet I've included a mood board and inspiration for the color palette below to get a better idea\n\nhttps://i.imgur.com/RNtULyP.png\n\nhttps://colorpalettes.net/color-palette-1367/\n\nthank you for considering my request", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@I6Pao5coR0/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3929a7ad/uploads/origins/2051a8cd-d0a5-45c6-b293-a40383d0a74b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a16b0a41c9d87e2a