お願いします。)\n\n冒険の仲間は③⑧のキャラ(画像見えない部分ﾃﾞｻﾞｲﾝは追加してください)でも良いですし、もちろんオオムラさんデザインのオリジナルキャラを新たに登場していただいても大丈夫です。\n(ファンタジー世界観に合う亜人種(ケモ耳)・エルフ・ドワーフ・ヒューマンなんでも大丈夫です)\n人数、人選、シチュエーションはお任せします。\n\n\nサイン有り無しバージョンお願いします。\n(オオムラさんデザインのキャラクター登場の場合、そのキャラの名前記載有りと無しバージョン)\n\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1LRD5LNtx-IhmQ1CIpx8_jvnPKgVH-IDu\n\nhttps://drive.google.com/drive/folders/1LRD5LNtx-IhmQ1CIpx8_jvnPKgVH-IDu", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oomura_sou/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 307993, "client_id": 50865, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a49c4a87/requests/163568_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8084f43d947bc8a69188889e8e65aa5", "srcset": "https://si.imgix.net/a49c4a87/requests/163568_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8084f43d947bc8a69188889e8e65aa5, https://si.imgix.net/a49c4a87/requests/163568_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bccf4e873ad7cbca5e3b0c74c4e7ea0c 2x, https://si.imgix.net/a49c4a87/requests/163568_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3cf155817f5a23ccb17b52fc2551d4f2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a49c4a87/requests/163568_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64b2f5099fda87019b7eb4f284d9ec2f", "srcset": "https://si.imgix.net/a49c4a87/requests/163568_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64b2f5099fda87019b7eb4f284d9ec2f, https://si.imgix.net/a49c4a87/requests/163568_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c2d713bdb41c3a7675af784b718beb67 2x, https://si.imgi