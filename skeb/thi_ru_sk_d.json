e1-b08d-d1e9e5cd4ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5674f7566dbe9eac657acc2197e48290, https://si.imgix.net/ad871131/uploads/origins/36357e1d-fd59-43e1-b08d-d1e9e5cd4ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=585d743104c8d3c963f2d3a585a8b8b6 2x, https://si.imgix.net/ad871131/uploads/origins/36357e1d-fd59-43e1-b08d-d1e9e5cd4ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e037544e8289f81223d2a998dad8771f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad871131/uploads/origins/36357e1d-fd59-43e1-b08d-d1e9e5cd4ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df885b1e69abd3807fc5bbdac8d79fc4", "srcset": "https://si.imgix.net/ad871131/uploads/origins/36357e1d-fd59-43e1-b08d-d1e9e5cd4ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df885b1e69abd3807fc5bbdac8d79fc4, https://si.imgix.net/ad871131/uploads/origins/36357e1d-fd59-43e1-b08d-d1e9e5cd4ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4bd3d2e49ae3411d89c15a95085ff210 2x, https://si.imgix.net/ad871131/uploads/origins/36357e1d-fd59-43e1-b08d-d1e9e5cd4ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=19bec1918eb5ecdab6aaf57045513f55 3x"}, "body": "てぃるさま\n\nSkebにててぃるさまを見つけ、ぜひご依頼をしたいと思いご連絡させていただきました。\n\n描いていただきたいのは個人勢Vtuberの「眞白うどん」さんのFAイラストです。\n\n眞白うどんさんの情報や依頼事項は下記にまとめましたので、ご検討いただければ幸いです。\n\n【パーソナル情報など（lit.linkの「skeb等に引用可能文章」からの引用）】\n・キャラクター\n眞白うどん サバトラ猫 セルフ受肉VTuber 22歳 152cm 下半身が太めです。 \n ・性格\n明るくて元気で リアクションが大きいです。歌う事と絵を描く事、FPS等のゲームが大好きです。\n\n【希望する構図・ポーズ・背景】\n最終的な構図やポーズ、服装、背景はお任せします。\n（参考になりそうな立ち絵の衣装などの情報はlit.linkにあります）\n\n【使用用途】\nSNSへの投稿や収益化済のYouTube配信のサムネなど配信活動に使用させていただければと思います。\n\n【その他の希望事項】\nできましたら左方、右方、上方が切れていないと嬉しいです。\nまた、背景、人物、宛名などをレイヤー分けをしたPSDデータもしくは透過データをいただきたいです。\n\n【SNSなどの情報】\n・X \nhttps://x.com/mashiroudonn\n・lit.link\nhttps://lit.link/mashiroudonn\n・Youtube\nhttps://www.youtube.com/@mashiroudonn\n\nご検討の程よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@thi_ru_sk_d/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3859784, "client_id": 3728909, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8c91548/uploads/origins/7b229e44-3451-4875-938c-80f515d6be84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f95bfd3108f5178647f00ed78488b94", "srcset": "https://si.imgix.net/a8c91548/uploads/origins/7b229e44-3451-4875-938c-80f515d6be84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f95bfd3108f5178647f00ed78488b94, https://si.imgix.net/a8c91548/uploads/origins/7b229e44-3451-4875-938c-80f515d6be84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2e21b95b3058f7eb376335a39fc6724 2x, https://si.imgix.net/a8c91548/uploads/origins/7b229e44-3451-4875-938c-80f515d6be84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4af7955aae0311ca78738bad6c54866 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8c91548/uploads/origins/7b229e44-3451-4875-938c-80f515d6be84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89ea7cc2a68afd14cd44833a642d76b6", "srcset": "https://si.imgix.net/a8c91548/uploads/origins/7b229e44-3451-4875-938c-80f515d6be84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89ea7cc2a68afd14cd44833a642d76b6, https://si.imgix.net/a8c91548/uploads/origins/7b229e44-3451-4875-938c-80f515d6be84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=78849a516882e1159cba3e6743c72e21 2x, https://si.imgix.net/a8c91548/uploa