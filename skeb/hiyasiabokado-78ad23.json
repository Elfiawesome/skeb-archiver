=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b4ca945f886a37232b3fcbac49721d6, https://si.imgix.net/9959f031/uploads/origins/1bcc3e94-7688-4364-be08-e1492d732029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9afd8cdf2de0140f5d70aec20b50eda8 2x, https://si.imgix.net/9959f031/uploads/origins/1bcc3e94-7688-4364-be08-e1492d732029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0656f66c7e924c5ac3b30df728e281ce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9959f031/uploads/origins/1bcc3e94-7688-4364-be08-e1492d732029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=358ae6302791639a3169cbdc3b7f0932", "srcset": "https://si.imgix.net/9959f031/uploads/origins/1bcc3e94-7688-4364-be08-e1492d732029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=358ae6302791639a3169cbdc3b7f0932, https://si.imgix.net/9959f031/uploads/origins/1bcc3e94-7688-4364-be08-e1492d732029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2820836b4a76756334127fa9515701ce 2x, https://si.imgix.net/9959f031/uploads/origins/1bcc3e94-7688-4364-be08-e1492d732029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cd931de69ee62418218b1c7ce3bc1dfc 3x"}, "body": "こんにちは～🌸、みけうら先生！お元気ですか？以前から先生の絵のファンでした。先生の描く太くて筋肉質な男性が大好きです。\n\n私の韓国人カウボーイOC、テジュンのアートをお願いしたいです！彼は陸上競技に情熱を持っていて、行動的でエネルギッシュです。社交的で外向的。好戦的な一面もありますが、友達を大切にします。すべて君に任せたいんだけど、いいかな？好きなことをしてくれて構わない！ただ、筋肉は強調してほしいですね。彼の筋肉をいつもより大きくするのも自由です！:3 もしご迷惑でなければ、シャツなしのバージョンも欲しいです！\n\n私の要望を考慮していただき、ありがとうございます。\n\nhttps://drive.google.com/drive/folders/10wYGi52vYXpE2_6tz3gZlhxqu3pNOpdo?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hiyasiabokado/works/1", "private_thumbnail_image_urls": null, "private": false, "