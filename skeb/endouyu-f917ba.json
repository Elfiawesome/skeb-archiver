8dd-934b-f6fc2259f963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=af0c30b536cbfcb0d554bba5acf4ca6a 3x"}, "body": "こんにちは！お久しぶりです。遠藤悠さんの絵をまた見たくて来ました。今度もよろしくお願いします。\n\n今回描いて欲しい内容は、賭ケグルイ双でヒロインの花手毬つづらが、壬生臣葵にレイプされるイラストをお願いします。\n\n壬生臣葵が文芸部とのギャンブル勝負に勝利したという、IFストーリーになり、壬生臣葵が花手毬つづらを自分の女にしようとレイプする展開になります。\n\n参考資料にある様に、おっぱいを揉まれながらペニスを挿入されて、さらにお互いに激しいキスをかわしているシーンがいいです。（お互いに全裸になっているのがいいです）\n\n『キャラ資料』\n\n壬生臣葵↓\nhttps://i.imgur.com/S2K2qGW.jpg\n\n花手毬つづら↓\nhttps://i.imgur.com/tRJ3tuH.jpg\n\n参考資料↓\nhttp://ero-gazou-uploader.x0.com/image.php?id=16763\n\nご検討のほど、よろしくお願いいたします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@endouyu/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0d8ea9c5/uploads/origins/b2e4bba4-cf17-43b6-863c-8a3ccbff4866?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=201e65269e8a471a4c2e24eededa611f", "srcset": "https://si.imgix.net/0d8ea9c5/uploads/origins/b2e4bba4-cf17-43b6-863c-8a3ccbff4866?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=201e65269e8a471a4c2e24eededa611f, https://si.imgix.net/0d8ea9c5/uploads/origins/b2e4bba4-cf17-43b6-863c-8a3ccbff4866?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea64926046e91b3ef86a00fb3c679a08 2x, https://si.imgix.net/0d8ea9c5/uploads/origins/b2e4bba4-cf17-43b6-863c-8a3ccbff4866?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a518717646f2abc903b2ad985287620c 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 326179, "client_id": 1422582, "nc": 176}, {"path": "/@endouyu/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 326179, "client_id": 52160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dcecddd4/uploads/origins/66edbc74-707b-4d7f-9a78-d6c5c9183a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a1181c9bf5f48af910bb8791417ebec", "srcset": "https://si.imgix.net/dcecddd4/uploads/origins/66edbc74-707b-4d7f-9a78-d6c5c9183a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a1181c9bf5f48af910bb8791417ebec, https://si.imgix.net/dcecddd4/uploads/origins/66edbc74-707b-4d7f-9a78-d6c5c9183a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a0660fec3cc9bd12fbe55049b87aec0 2x, https://si.imgix.net/dcecddd4/uploads/origins/66edbc74-707b-4d7f-9a78-d6c5c9183a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09700310805b49fc713ae251be7d60ef 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dcecddd4/uploads/origins/66edbc74-707b-4d7f-9a78-d6c5c9183a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bcd2237cca003314177ff73e36264de3", "srcset": "https://si.imgix.net/dcecddd4/uploads/origins/66edbc74-707b-4d7f-9a78-d6c5c9183a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bcd2237cca003314177ff73e36264de3, https://si.imgix.net/dcecddd4/uploads/origins/66edbc74-707b-4d7f-9a78-d6c5c9183a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62f5dfa6ab86227085c2d59b76f85fe8 2x, https://si.imgix.net/dcecddd4/uploads/origins/66edbc74-707b-4d7f-9a78-d6c5c9183a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e48671da2b06a865449c9e5dad419a19 3x"}, "body": "こんにちは、いつもイラストを引き受けていただき、どうもありがとうございました。また依頼させていただければと思います。\n\n今回はソードアート·オンラインのアスナと、アバドーンのメガネの男（しま）をお願いします。\n別作品同士のクロスオーバーですが、もし可能でしたらよろしいでしょうか？\n\nキャラ資料↓\n\nアスナ\nhttp://ero-gazou-uploader.x0.com/image.php?id=16321\n\nメガネの男（島）\nhttps://uploda1.ysklog.net/uploda/c410d4cb06.jpg\n\nシチュエーション　\n\n以前に依頼した、しまに拉致られた未亜と里奏がレイプされたのと同じ様に、しまに捕らえられたアスナが、全裸にされてレイプされるイラストをお願いします。\nこれまでに依頼した内容ではレイプ未遂でしたが、今回はきちんとペニスが挿入されて、射精もされているイラストがいいです。希望する構図ですが、参考資料の赤枠の通り、おっぱいを舐められながら挿入されて責められているのを希望します。\nもちろん、おっぱいのサイズは巨乳だと嬉しいです。\n\n参考資料↓\nhttp://ero-gazou-uploader.x0.com/image.php?id=16322\n\nご検討のほど、よろしくお願いいたします。\n\n（裏設定では、アスナが『腐界に眠る王女のアバドーン』の世界に吸い込まれてしまい、脱出しようと探索している最中に、しまと遭遇して、本来ならアバドーンの世界で、ヒロインが連れ去られてレイプされるイベントが、アスナに適用されてしまい、アスナがしまにレイプされてしまうという内容です。）", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@endouyu/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 326179, "client_id": 175182, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4a83996/uploads/origins/3a18aaf6-560d-468c-b72f-993a54555f85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f27955cb8dd56037c70befed714e5d92", "srcset": "https://si.imgix.net/c4a83996/uploads/origins/3a18aaf6-560d-468c-b72f-993a54555f85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f27955cb8dd56037c70befed714e5d92, https://si.imgix.net/c4a83996/uploads/origins/3a18aaf6-560d-468c-b72f-993a54555f85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8afa5b1d52fb03349989888ccedc613f 2x, https://si.imgix.net/c4a83996/uploads/origins/3a18aaf6-560d-468c-b72f-993a54555f85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f628acce2f6346e202e43382e00bb182 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4a83996/uploads/origins/3a18aaf6-560d-468c-b72f-993a54555f85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e229541ecc6f6d2a8b4ed4530c884f0b", "srcset": "https://si.imgix.net/c4a83996/uploads/origins/3a18aaf6-560d-468c-b72f-993a54555f85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e229541ecc6f6d2a8b4ed4530c884f0b, https://si.imgix.net/c4a83996/uploads/origins/3a18aaf6-560d-468c-b72f-993a54555f85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=51ae6429644839371da8ccf73753a3df 2x, https://si.imgix.net/c4a83996/uploads/origins/3a18aaf6-560d-468c-b72f-993a54555f85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d43455dee8037b4c1a65bf70dcdefd5 3x"}, "body": "資料の花柄ワンピの女の子が、カメラ目線の笑顔で脚をぴったり閉じてスカートを両手で持ち上げて、一見白パンティに見えるビキニの水着を見せてくれている絵をリクエストします。背景はお任せします。\n\nhttps://drive.google.com/file/d/11OaTc6Lit9We4Cs9zlvyb9eUWsWxafHk/view?usp=drivesdk", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@endouyu/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 326179, "client_id": 52160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/597ab908/uploads/origins/f8423fc1-9cc9-4685-8f84-f5aef421079c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79971a14eb8f5079dd5c34fe018ee533", "srcset": "https://si.imgix.net/597ab908/uploads/origins/f8423fc1-9cc9-4685-8f84-f5aef421079c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79971a14eb8f5079dd5c34fe018ee533, https://si.imgix.net/597ab908/uploads/origins/f8423fc1-9cc9-4685-8f84-f5aef421079c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92f9e0d26b032e70ad747b2ec4bc22f4 2x, https://si.imgix.net/597ab908/uploads/origins/f8423fc1-9cc9-4685-8f84-f5aef421079c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cce070a9884a65eecd5501ed9bf15bfc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/597ab908/uploads/origins/f8423fc1-9cc9-4685-8f84-f5aef421079c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e066247027a3717e44e6c14d08c72555", "srcset": "https://si.imgix.net/597ab908/uploads/origins/f8423fc1-9cc9-4685-8f84-f5aef421079c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e066247027a3717e44e6c14d08c72555, https://si.imgix.net/597ab908/uploads/origins/f8423fc1-9cc9-4685-8f84-f5aef421079c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bbf5ba36a4f29876594d43c84c47d3cc 2x, https://si.imgix.net/597ab908/uploads/origins/f8423fc1-9cc9-4685-8f84-f5aef421079c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d2db51e606fbe149e82fa1072713b335 3x"}, "body": "ご無沙汰しております。以前はお世話になりました。今回もリクエスト失礼してもよろしいでしょうか。\n\n【リクエスト内容】\n\n作品名　暗殺教室\nキャラ　矢田桃花\n\nキャラ資料↓\n\n矢田桃花\nhttps://ansatsu.gamerch.com/%E7%9F%A2%E7%94%B0%E3%80%80%E6%A1%83%E8%8A%B1%EF%BC%88%E5%85%A8%E8%BA%AB%E7%94%BB%E5%83%8F%EF%BC%89\n\n○内容・シチュエーション\n\nイリーナ（ビッチ先生）から、ハニートラップや接待術を仕込まれた矢田桃花が\n恵まれたプロポーションを活かして、Eカップの巨乳を露にし、色仕掛けで誘惑するシーンをお願いします。\n（設定だと、矢田桃花は卑猥な仕事はやりたくない模様ですが、最後の奥の手として女の武器を使うことにした）\n\nサンプルその１\nhttp://ero-gazou-uploader.x0.com/image.php?id=14572\n\nサンプルその２\n\nhttps://cdn.img-conv.gamerch.com/img.gamerch.com/ansatsu/1440938678001.jpg\n\n描いて欲しい内容は、サンプル１に在るとおり、おっぱいを曝け出して誘惑しているイラストにしてください。サンプルにあるセリフ通り、吹き出しにて「乳首がかゆいから、口に含んでレロレロしてぇ～♪」と入れていただけたら嬉しいです。一応脱いでいる服は、サンプル２のとおり学校の制服ということでお願いします。おっぱいのサイズは、Eカップの巨乳に相応しい爆乳にしてください。\n\n以上でよろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@endouyu/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/52502119/requests/179101_5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=