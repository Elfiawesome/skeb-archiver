ります！\nTRPGのOCを描いていただきたいです。\n\n時代背景：1990年代 HONGKONG、警察とマフィアが激しく対立していた。\n\n3人の人物、全員30↑\n（A）メガネ男：地元最大のマフィアの息子、次期リーダー。知的な悪党風に見える。\n（B）警察男：典型的な正義感が強いタイプの警官。仕事中は厳しいが、実際は優しく良い上司。\n（C）警察女：Bの部下/弟子。聡明で気さく、優しい目をしているが口元はいつも少し引き締まっている。冗談を好きな人。\n\n衣装、ポーズ、構図は自由に調整してください！個人使用のみとさせていただきます。\n価格や依頼内容に問題がある場合は、遠慮なくキャンセルまたは再送してください！\n文法が不自然な部分はご容赦ください。ご清聴ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1sVdnYwNHRaUXMWM6D-52KGGIyjc5D0VZ?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sonne_emb/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3533023, "client_id": 2963416, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bbacebf2/uploads/origins/5a204251-225e-4a44-bd5f-ebfaeb33be37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4a27d81c904fb27cbc64ec1c7f6b2ec", "srcset": "https://si.imgix.net/bbacebf2/uploads/origins/5a204251-225e-4a44-bd5f-ebfaeb33be37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4a27d81c904fb27cbc64ec1c7f6b2ec, https://si.imgix.net/bbacebf2/uploads/origins/5a204251-225e-4a44-bd5f-ebfaeb33be37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c18ddaa84ea8e28daf666dea8afbc165 2x, https://si.imgix.net/bbacebf2/uploads/origins/5a204251-225e-4a44-bd5f-ebfaeb33be37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5fad720cc11a89c41e6b94e61b2e5416 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bbacebf2/uploads/origins/5a204251-225e-4a44-bd5f-ebfaeb33be37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8948a2f5bfc618893ab271c4a5a3775", "srcset": "https://si.imgix.net/bbacebf2/uploads/origins/5a204251-225e-4a44-bd5f-ebfaeb33be37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur