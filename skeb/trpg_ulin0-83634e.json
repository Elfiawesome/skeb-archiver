ヒール)\n・16歳\n・日本人\n・年齢にそぐわずとても大人っぽくお淑やかで上品。誰もが振り向くような美少女。\nある日突然探偵事務所に転がり込み、半ば強引に居候することに。\n・探偵のことを振り回す・翻弄するような言動が多くからかうような素振りが多い。\n・何を考えているのかわからない不思議な雰囲気。\n・普段はセーラー服、もしくは着物。\n\n\n▶︎黒髪オールバックの男性(探偵)\n\n・194cm\n・49歳\n・日本人\n・気弱な優男。めったに怒ったりせずとても優しいがナイーブで落ち込みやすい。\nネガティブ。赤面症。\n・助手である少女を家に住まわせているが、毎日のように翻弄されている。\n・和服が普段着。\n\nhttps://drive.google.com/drive/folders/1RSrcWqHcQRWni31nxGE_g7U1170mvc5r", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gugsssccc/works/39", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2410085, "client_id": 1019402, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1bfa211c/uploads/origins/8a16dec9-55db-477f-af0c-32bfcf5a5599?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4977fa493c246e41b894fbcbd7b1e009", "srcset": "https://si.imgix.net/1bfa211c/uploads/origins/8a16dec9-55db-477f-af0c-32bfcf5a5599?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4977fa493c246e41b894fbcbd7b1e009, https://si.imgix.net/1bfa211c/uploads/origins/8a16dec9-55db-477f-af0c-32bfcf5a5599?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=907f6e22c15af8654cd90e4d2501bb48 2x, https://si.imgix.net/1bfa211c/uploads/origins/8a16dec9-55db-477f-af0c-32bfcf5a5599?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb3006570e3b5f4c18befe5bffd4828d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1bfa211c/uploads/origins/8a16dec9-55db-477f-af0c-32bfcf5a5599?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59e54af20794919446be03a55f8c735a", "srcset": "https://si.imgix.net/1bfa211c/uploads/origins/8a16dec9-55db-477f-af0c-32bfcf5a5599?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59e54af20794919446be03a55f8c735a, ht