44-8e54-42a8-bfec-765dd791b5e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca28c274f13a02405539ad2638c268f5, https://si.imgix.net/d5fd0991/uploads/origins/51527744-8e54-42a8-bfec-765dd791b5e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42039d2da3fe71b57aab6ad968e37954 2x, https://si.imgix.net/d5fd0991/uploads/origins/51527744-8e54-42a8-bfec-765dd791b5e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da0fce3a45524be514220085caa795b7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5fd0991/uploads/origins/51527744-8e54-42a8-bfec-765dd791b5e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2864b81f7c69f52452a377b5740faf82", "srcset": "https://si.imgix.net/d5fd0991/uploads/origins/51527744-8e54-42a8-bfec-765dd791b5e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2864b81f7c69f52452a377b5740faf82, https://si.imgix.net/d5fd0991/uploads/origins/51527744-8e54-42a8-bfec-765dd791b5e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=370ec4a8b534d133a784e3763a44a800 2x, https://si.imgix.net/d5fd0991/uploads/origins/51527744-8e54-42a8-bfec-765dd791b5e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d11b67e1bec5fc65d20c45184d64208d 3x"}, "body": "はじめまして！\nＸでいつもSakura先生の描かれるキラキラと輝くようなイラストを楽しませて頂いております。\n今回、久しぶりにSkebを募集されるとのことで、ぜひお願いしてみたいなと思いリクエストさせて頂きました！\nVtuberの猫月みお（@Nekozuki_Mio)さんのイラストを描いていただきたいです！\n\n・猫月みおの二次創作ガイドライン\n非営利目的と記載がありますがskebに関しては許可をいただいております https://www.fanbox.cc/@nekozukimio/posts/2642572\n\n・猫月みおさんは現在様々な衣装での活動をされております。\n　本人のツイッターの固定ツイや過去ツイにて当該資料が確認できるかと思いますので添付させていただきます。\nhttps://x.com/Nekozuki_Mio/status/1581492092869562369\nhttps://x.com/Nekozuki_Mio/status/1713607308658487422\n\n上記資料を添付しましたがいずれの衣装でも、或いは過度に過激なものでなければオリジナルの衣装でも構いませんが、マスコットの猫ちゃんだけは必須でお願いします。\n（位置は資料に依存せずに自由に配置して頂いて構いません。）\n\n　描いていただきたい構図やポーズですが\nせっかくSakura先生に描いて頂くので季節感のある夏らしい明るい元気な作品でお願いしたいなと思っております！\n（それ以上の具体的な要望等はございませんので、Sakura先生にお任せさせていただきます。）\n\n〇要望\n・宛名・背景のオンオフができると嬉しいです（キャラ単体の透過差分）\n・もし可能であれば本人のVtuber活動（配信サムネイルやSNSでの告知など）での使用許可をいただきたいです。承諾いただける場合は宛名の○○さんへの横に星のマークを添えていだけると幸いです", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@39ra_______/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3605847, "client_id": 3056971, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e41cc7a4/uploads/origins/8b141d94-58af-4359-9f63-18dd35ff6cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f158feaec1190c2ca78730c5503ffec1", "srcset": "https://si.imgix.net/e41cc7a4/uploads/origins/8b141d94-58af-4359-9f63-18dd35ff6cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f158feaec1190c2ca78730c5503ffec1, https://si.imgix.net/e41cc7a4/uploads/origins/8b141d94-58af-4359-9f63-18dd35ff6cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b68c5ec4c18325e79073313755638e99 2x, https://si.imgix.net/e41cc7a4/uploads/origins/8b141d94-58af-4359-9f63-18dd35ff6cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1cd25bbc505bf126168fc521a72f9a60 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e41cc7a4/uploads/origins/8b141d94-58af-4359-9f63-18dd35ff6cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecb2711d47053a488b2c86fa42d7cbb0", "srcset": "https://si.imgix.net/e41cc7a4/uploads/origins/8b141d94-58af-4359-9f63-18dd35ff6cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecb2711d47053a488b2c86fa42d7cbb0, https://si.imgix.net/e41cc7a4/uploads/origins/8b141d94-58af-4359-9f63-18dd35ff6cf3?bg=%2