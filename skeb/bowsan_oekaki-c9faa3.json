g=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc7228e2233c39ed17c6893709990e76 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1dd479ca/uploads/origins/523a3720-4ec3-47c0-bc97-61f134a1b01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68c5ed3ba17f99ffff4948e09db8580f", "srcset": "https://si.imgix.net/1dd479ca/uploads/origins/523a3720-4ec3-47c0-bc97-61f134a1b01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68c5ed3ba17f99ffff4948e09db8580f, https://si.imgix.net/1dd479ca/uploads/origins/523a3720-4ec3-47c0-bc97-61f134a1b01f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e89c914cad3780503f44e1f0071fc8ee 2x, https://si.imgix.net/1dd479ca/uploads/origins/523a3720-4ec3-47c0-bc97-61f134a1b01f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9508954637a0e8d17c22cc433a80c651 3x"}, "body": "はじめまして！先生のTwitterでのメイプル絵にガチ惚れしてしまいまして、依頼させて頂こうと思いました！\n（スケブでデフォルメは承っていない等あればすみません。）\n依頼させて頂く内容は、Twitterでアップされていたようなデフォルメ絵、アイコン使用想定です。\n※すみません、資料に不備があったためリクエスト再送させていただきました。\n\n【キャラ】\n参考資料の子でお願いします。\n・構図はお任せしてしまって良いでしょうか..！\n・髪色はグレー寄りの紫（もふもふリボン結び　紫90：青10）\n・顔はぼんやりした感じです（くっきり二重顔（空））\n・イメージはハッカドールというアニメの３号くんっていうキャラです。男の娘です。\n・服は参考資料①でお願いします！ロング丈で下が見えていないですが制服です。\n・武器は無しでお願いします。\n・服のパーツは減らしてしまって良いです。垂らしている帯は手に付いていますがこれも省略して良いです。\n・単色で結構ですので、Twitterのアイコンに収まるような丸背景付きも頂けると嬉しいです！\n\nもしお受け頂けるようでしたら、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1aC5tpsRyyuhIHSOqMK5_yj_BOUOz4D3y?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bowsan_oekaki/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2427621, "client_id": 2739799, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/205466b8/uploads/origins/4c7ff21b-77a8-49fd-97ca-2df23319f950?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3d5a3f4d7024231c5fe765a0c663f38", "srcset": "https://si.imgix.net/205466b8/uploads/origins/4c7ff21b-77a8-49fd-97ca-2df23319f950?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3d5a3f4d7024231c5fe765a0c663f38, https://si.imgix.net/205466b8/uploads/origins/4c7ff21b-77a8-49fd-97ca-2df23319f950?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55e4e847adb3caa29b18d1eca2f69f5b 2x, https://si.imgix.net/205466b8/uploads/origins/4c7ff21b-77a8-49fd-97ca-2df23319f950?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a537d5b401ef38d41206d03fe247c6e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/205466b8/uploads/origins/4c7ff21b-77a8-49fd-97ca-2df23319f950?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e27d049abdbbef50c5e84c2821abef18", "srcset": "https://si.imgix.net/205466b8/uploads/origins/4c7ff21b-77a8-49fd-97ca-2df23319f950?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e27d049abdbbef50c5e84c2821abef18, https://si.imgix.net/205466b8/uploads/origins/4c7ff21b-77a8-49fd-97ca-2df23319f950?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ba151270077ab96655ab027fc68474c1 2x, https://si.imgix.net/205466b8/uploads/origins/4c7ff21b-77a8-49fd-97ca-2df23319f950?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=58514b80abc9f898e0fdc3fd13ccb60f 3x"}, "body": "ぼうさん 様\nお世話になっております。\nVtuberのラティオ・ユィリスです。\n\n以前ファンの方からの依頼でイラストを描いていただきありがとうございました！\nそちらのイラストがとても気に入っているのでまた描いていただきたくリクエストさせていただきます！\n特に顔と髪型のバランス、体つきがすごく好みです！\n\n【希望イラスト構図】\n・前回と同じような感じで、かっこよくも可愛い表情で描いていただきたいです！\n・今回はこちら▼で描かれていた正面の構図だと嬉しいです！\n　https://skeb.jp/@bowsan_oekaki/works/11\n・出来ればバストアップに写る手(肘)などが切れないように描いていただけると嬉しいです。\n・バストアップにしたときに手が入る構図だと嬉しいです！\n┗マイクを持っていたり、自然な手の動きがある等\n・かっこいいにより過ぎない表情だと嬉しいです！(前回のお顔最高でした！)\n・可能であれば水色系のシンプルな背景があれば嬉しいです！\n\n帽子やマントの装飾はあってもなくても大丈夫です。\n▼キャラクター参考\nhttps://twitter.com/Ratio_Yuires/status/1505442051030413316\nhttps://twitter.com/Ratio_Yuires/status/1689518221861560320\n▼簡易三面図\nhttps://twitter.com/Ratio_Yuires/status/1407521494935109636\n\n【使用用途】\nYouTubeのサムネや歌ってみた、その他SNS掲載等のプロモーション時に使用させていただきます。\n\n【希望納品形式】\nPSDもしくは人物と背景のレイヤーを分けたPNGデータでいただけると嬉しいです。\n\n何卒よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bowsan_oekaki/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/49515b53/uploads/origins/4e608b6a-0abf-4d1a-96de-ebd7a495d727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a7de3f5d6777ac6e662311289ca424d", "srcset": "https://si.imgix.net/49515b53/uploads/origins/4e608b6a-0abf-4d1a-96de-ebd7a495d727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a7de3f5d6777ac6e662311289ca424d, https://si.imgix.net/49515b53/uploads/origins/4e608b6a-0abf-4d1a-96de-ebd7a495d727?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1958c8e8c337986050f90b409e326f6 2x, https://si.imgix.net/49515b53/uploads/origins/4e608b6a-0abf-4d1a-96de-ebd7a495d727?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=386d9cad4b42524c10bb6e7f18315a09 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2427621, "client_id": 1370079, "nc": 17}, {"path": "/@bowsan_oekaki/works/12", "private_thumbnail_image_ur