fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c0d894940d385c56c877b4e8e205e71 2x, https://si.imgix.net/f0af31ed/uploads/origins/62187bda-8c99-4f28-851c-5dc56632b07f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d0b7d3d635b094530f41ae4c97579a23 3x"}, "body": "アルロさんリクエスト失礼いたします。\n\nホロライブのねぽらぼチャイナドレスやこよりさんのキョンシーに強く惹かれまして可能でしたら推しのVtuberさんのファンアートとしましてチャイナドレスまたはキョンシー姿を描いていただきたくご連絡させていただきました。※服装チェンジはご本人さまより許可をいただいております。\n\nVtuber　兎月ネチェトアさん（@nechetoa ）チャイナドレスかキョンシー\n\n表情を笑顔でお願いします。\n衣装のデザインや構図、ポーズなど細かなリクエストはないのでアルロさんの描きやすいお姿でお願いさせていただきます。\nもし可能でしたら背景と人物を分けたデータをいただけますと\n\nファンアートリクエストになりますので兎月ネチェトアさんご本人さまのみイラストの使用許可をお願いしたく、YouTuberのサムネイルやX（Twitter）での使用になります。\n\nご検討していただきました幸いです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arlonnn/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 695117, "client_id": 2706859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d03e635/uploads/origins/4996f73f-28f0-401a-bef5-6f4f0c1c8453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9653b3c5cab87e8bc7f3175e63f0bea1", "srcset": "https://si.imgix.net/7d03e635/uploads/origins/4996f73f-28f0-401a-bef5-6f4f0c1c8453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9653b3c5cab87e8bc7f3175e63f0bea1, https://si.imgix.net/7d03e635/uploads/origins/4996f73f-28f0-401a-bef5-6f4f0c1c8453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eac1aa142eac7c1d3beed470cd63ecbc 2x, https://si.imgix.net/7d03e635/uploads/origins/4996f73f-28f0-401a-bef5-6f4f0c1c8453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05f6581758c0f37b10d2de7b2e3713ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d03e635/uploads/origins/4996f73f-28f0-401a-bef5-6f4f0c1c8