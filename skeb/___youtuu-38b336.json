e7c156140e2ab405ebd6a 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1542577, "client_id": 3152326, "nc": 160}], "sent_works": [{"path": "/@vamviper_0716/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3152326, "client_id": 1542577, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d790542/uploads/origins/4680c881-964c-40c5-a018-d7bd687dd78a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6ffe2c820576a37025c5b173dddd7b4", "srcset": "https://si.imgix.net/0d790542/uploads/origins/4680c881-964c-40c5-a018-d7bd687dd78a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6ffe2c820576a37025c5b173dddd7b4, https://si.imgix.net/0d790542/uploads/origins/4680c881-964c-40c5-a018-d7bd687dd78a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82ce4fbac4f46d310201c3874796432c 2x, https://si.imgix.net/0d790542/uploads/origins/4680c881-964c-40c5-a018-d7bd687dd78a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20360ada38a7e531f06672d7960ddae7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d790542/uploads/origins/4680c881-964c-40c5-a018-d7bd687dd78a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ba97fdf71cfcc660c7be18fef2d8aec", "srcset": "https://si.imgix.net/0d790542/uploads/origins/4680c881-964c-40c5-a018-d7bd687dd78a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ba97fdf71cfcc660c7be18fef2d8aec, https://si.imgix.net/0d790542/uploads/origins/4680c881-964c-40c5-a018-d7bd687dd78a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d3f53adceef2049081ffceca2e1679f7 2x, https://si.imgix.net/0d790542/uploads/origins/4680c881-964c-40c5-a018-d7bd687dd78a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b5985d850c4b42a5b40100e879aa42bb 3x"}, "body": "CDのジャケットに使用することを想定したイラストをお願いします。\nキャンバスサイズ(120mm×120mm、塗り足し想定)と解像度(300~350dpiくらい)をなんとなくでも良いので合わせてくれると嬉しいです💃\n\nイラストの内容は資料URLの中の二人組で、ポーズや構図などはお任せします。文字(タイトル)を入れる想定かつ奥行きが感じられると嬉しいな〜…。色は雰囲気に合っていれば適当でいいです。もちろん資料の色そのままでも。好きなように塗っちゃってくださいな🕺\nばいぱ〜氏のコントラストの強いバチっとした絵柄が超好きなので、リクエストした次第です🎶(注文の多い料理店)\n\n以下キャラクターの設定\n\n[共通]\n某T区に住む16歳\n\n[瀬尾(ひっつめ髪吊り目)]\n高いポニーテール、ピアスだかイヤリングだかの耳飾り(右3左2)、赤いジャージ、ダボついたカーゴパンツ、赤いサンダル(クロッグ)\n細身で顔立ちがやや整っている。目が大きく鼻筋が通っており眉は細い。\nT区では名の通った不良。幼少期に父親は蒸発し、母親のネグレクトのせいか愛想が悪すぎる上に人間関係の構築が下手くそ。常に一匹狼状態。中卒。近所の人の情けで倉庫作業のバイトをしている。\n相手の不興を買うことが得意(？)で、ケンカの場数はその辺のヤンキーの倍は踏んでいる。\nそんな彼にも最近弟子(松浦)のような存在ができて嬉しい。\n\n[松浦(腰抜け片目隠れ)]\nボサボサ片目隠れ、四白眼、前開きのワイシャツ(半袖)、派手な色の肌着、赤いスニーカー、学校帰りの雰囲気\n左の男とは正反対の顔立ちでザ・健康優良児体型。目の大きさは同じくらいだが瞳が極端に小さい。\nもはやヤンキーのコスプレをした挙動不審陰キャ。家の事情でT区に引っ越し、高校に編入したものの中々友人ができず頭を抱えていたところ、瀬尾と出会う。密かにヤンキーに憧れていたが、流石に日本のスラム街と呼ばれているT区は怖い。瀬尾とは違い、一般家庭で普通に生まれ育った。\nやたら瀬尾から教え(ケンカの必勝法など)を受けるが、無論弟子入りをしたつもりはない。\n\nイラスト内の鉄パイプやバールのようなものは、普段から使っている(？)のではなく、ヤンキーの喧嘩に巻き込まれてしまったのでその辺に落ちていたものを拾って使ったというイメージです。当たり前のようにこの2人は治安が悪い地域に住んでいます。\n\nhttps://drive.google.com/file/d/1ffNSHQckY3fCdJPlPrbT-UD0En6pNKcT/view?usp=drive_link", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shiromisoo/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2340959, "client_id": 1542577, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd5dc42e/uploads/origins/691c1168-3f2c-4c7f-8883-a9933cb27bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c0e71cc6d588c3633329a20447c9e3e", "srcset": "https://si.imgix.net/dd5dc42e/uploads/origins/691c1168-3f2c-4c7f-8883-a9933cb27bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c0e71cc6d588c3633329a20447c9e3e, https://si.imgix.net/dd5dc42e/uploads/origins/691c1168-3f2c-4c7f-8883-a9933cb27bc8?bg=%23ff