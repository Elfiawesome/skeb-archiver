": "めぐたさんskeb開設おめでとうございます‼️\nいつも素敵なイラスト拝見させてていただいております。\n今回は私のTRPGに使用したオリジナルキャラクターとよその子さんを描いていただきたく、リクエストしに参りました！（許可は得ています。）\n\n【キャラクター】\n『花冷えに亡く季節』（https://booth.pm/ja/items/2086541）というシナリオを遊んだ2人になります。　小説のような暖かな世界観です。\n\nシナリオの舞台は奇病を患った少年少女が療養の為に集まる、サナトリウムになります。そのため今回描いていただきたいキャラクターたちも、それぞれ奇病を持っています。\n\n・先崎　久真\n16歳 ♂\n想い出と呼称される記憶を蝕まれている\nいわゆる記憶喪失ですが本人はそれを前向きに捉えているため、明るい性格です。\n\n・國木田　怜桜\n16歳 ♀\n心臓に根をはり血管から花を咲かせている\n全身に花が咲いており、美しい女の子です。\n少し人見知りもありますが、穏やかな暖かい性格をしています。\n\n2人の詳細資料をお送りさせていただきます。\n\n【構図など】\nめぐたさんの描かれる絵柄の暖かな雰囲気がこの2人にぴったりだと(勝手に)感じているので、光に満ちて明るい、暖かい、柔らかい感じのイメージでお願いしたいです‼️詳細は特に決まっておりません。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1XQby6b10fNSWndyR42xZuFtYBWlJqhOC?usp=share_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 161933, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "もりっしー", "screen_name": "morishiey", "avatar_url": "https://pbs.twimg.com/profile_images/1459873212729540609/JyPZKIcF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3001259654/1605370956/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 17}, {"id": 417286, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "粕家梅庵", "screen_name": "Kasuya_Baian", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fmisskey%2Fb04f37d5-075f-4fbd-875d-5bcfcd9c1723.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/798a1222-bcb4-4e17-9ecd-17673fd55440.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "