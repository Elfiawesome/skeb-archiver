TE&s=c6c8d55a0888dc4fb86ae81c6d8d4627 2x, https://si.imgix.net/289d8c73/uploads/origins/ca85966d-3fce-426a-b866-a9ecfcd02112?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=595db985fa7b4196644300801029cc05 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3765193, "nc": 32}, {"path": "/@7815E/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3765193, "client_id": 2254415, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/50e24c37/uploads/origins/e23dc064-d928-4aaa-afc5-e2c9f6866a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4ba04714df433c409d3217e45c24763", "srcset": "https://si.imgix.net/50e24c37/uploads/origins/e23dc064-d928-4aaa-afc5-e2c9f6866a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4ba04714df433c409d3217e45c24763, https://si.imgix.net/50e24c37/uploads/origins/e23dc064-d928-4aaa-afc5-e2c9f6866a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e4c1efbe9e5766570e70a7801beec23 2x, https://si.imgix.net/50e24c37/uploads/origins/e23dc064-d928-4aaa-afc5-e2c9f6866a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2ea02d1d9f15f104a576e8f2fe3eddb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/50e24c37/uploads/origins/e23dc064-d928-4aaa-afc5-e2c9f6866a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1332ed0b0b90c50e03b4224c98ff11d5", "srcset": "https://si.imgix.net/50e24c37/uploads/origins/e23dc064-d928-4aaa-afc5-e2c9f6866a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1332ed0b0b90c50e03b4224c98ff11d5, https://si.imgix.net/50e24c37/uploads/origins/e23dc064-d928-4aaa-afc5-e2c9f6866a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c6da7dfad75cc59ba673d5e8cd5aa8fb 2x, https://si.imgix.net/50e24c37/uploads/origins/e23dc064-d928-4aaa-afc5-e2c9f6866a7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4d0f75abbbaa77f86f6d5d6adf1a3868 3x"}, "body": "甲殻類エビさんこんにちは！いつも素晴らしい作品を楽しみにしております！前回は最高の作品をありがとうございました！ぜひ今回も私のOCイラストをお願いしたいです！よろしくお願いいたします！\n\n・内容…私のOCの自由なスタイルのイラストをお願いします！\n\n・名前…マックスパワー\n\n・キャラ…協調性皆無の傭兵。常に若干不機嫌で口も性格も悪い。寡黙な軍人口調だが基本誰にでもタメ口。「私の後ろに立つな」とか「クソが！黙って従え！」とか言いそうな難点の多いキャライメージです！\n\n・容姿…20代後半。身長は義肢含み170cmくらい。髪型は薄緑色のロングヘアで、前髪は「銀魂の土方十四郎」みたいなM字に横髪を伸ばした感じ。顔はクール系。瞳は薄い赤色で「銃の照準」のような瞳孔が特徴。四肢はすべてシンプルな義肢。「両目の下」と「左胸元」と「右鼠径部」に特徴的なホクロがあります！\n\n・装備...基本は改造軍服。オフはタンクトップにホットパンツ。ブーツは常に軍用。小物入れを兼ねたネックレスを常備（中身は強化薬）。武器は「フリントロックライフル」or「牛刀」です！\n\n・構図…構図や細部はすべてお任せします！ぜひ自由に描いて頂けたら嬉しいです！\n\n・備考…元軍人の傭兵。弾丸を生成する能力を持つ。口癖は「私の言ってる意味分かるか？」。前回描いて頂いたOCミオカのライバル的キャラクターです！\n\n※参考資料をご参照ください！\n※文章に書いていない部分はすべてお任せします！\n※使用目的は鑑賞や妄想等個人使用のみですが、依頼時に参考資料として使用させていただく場合があります！\n\nhttps://drive.google.com/drive/folders/1DI6nR3cLMh62WWCMI5U2OocsDceizuH3", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7815E/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3765193, "client_id": 69484, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3b34be7/uploads/origins/4bdd3797-51f8-4501-bf19-5bfe5f3d2a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5f3f90b20c3300e4fa9916699718ee2", "srcset": "https://si.imgix.net/a3b34be7/uploads/origins/4bdd3797-51f8-4501-bf19-5bfe5f3d2a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5f3f90b20c3300e4fa9916699718ee2, https://si.imgix.net/a3b34be7/uploads/origins/4bdd3797-51f8-4501-bf19-5bfe5f3d2a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4423b7d399e53ff7652860c99ff9058a 2x, https://si.imgix.net/a3b34be7/uploads/origins/4bdd3797-51f8-4501-bf19-5bfe5f3d2a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3fe617d70bb36c2e86cbe8b2534379c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a3b34be7/uploads/origins/4bdd3797-51f8-4501-bf19-5bfe5f3d2a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ebc0a752e8f7f2d49e03cfca5412a8b", "srcset": "https://si.imgix.net/a3b34be7/uploads/origins/4bdd3797-51f8-4501-bf19-5bfe5f3d2a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ebc0a752e8f7f2d49e03cfca5412a8b, https://si.imgix.net/a3b34be7/uploads/origins/4bdd3797-51f8-4501-bf19-5bfe5f3d2a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8fd84308b003b25ccc21def450e48e83 2x, https://si.imgix.net/a3b34be7/uploads/origins/4bdd3797-51f8-4501-bf19-5bfe5f3d2a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b9a6d42cba1ed3a319456ce4a12ef99f 3x"}, "body": "はじめまして、カッコイイイラストからセクシーなイラストまで、幅広いイラストがとても好きです。\n迷いましたが、今回はセクシー路線でリクエストさせて頂きたいと思います。\n\n◆容姿・体型\nファンタジー世界の女性冒険者で、猫耳と尻尾のある褐色女性です。\nはち切れんばかりの爆乳で、全体的にむっちりとした肉質的な体つきをしています。ラスオリ体型です。\nその他、以下のような特徴があります。\n・母乳体質\n・乳首。通常は陥没状態。\n・広くぷっくりと盛り上がった乳輪（いわゆるパフィーニップル）\n\n◆服装\n\nスケスケで極めて露出度の高い踊り子風衣装。黒い布地に、金の装飾で着飾っている。\nイメージはラスオリの死滅のセクメト　ミスオルカスキンを黒くしたような感じです。（セクメトが背負っているリング状の装備は不要です）\nデザインについては、自由にアレンジ頂ければと思います。乳暖簾などでも。\n\nまた可能でしたら、実現方法はお任せしますので、ラスオリの中破状態のように衣服が損傷している状態も含めて頂けないでしょうか。\n差分形式でも、別構図として頂いても（それによって金額面で条件が合わなくなるようでしたら、必要に応じて再送要求頂けると嬉しいです）\n中破状態では、乳首・局部は露出させて問題ありません。\n\n◆シチュエーション・構図\n\n以下のようなシーンイメージです。\n--------------\n活動資金を稼ぐため夜の副業として酒場のステージでショーのダンサーとして踊っている。\n特殊な液体を浴びると溶解する衣装を着ており、演出として噴霧された液体を浴びて徐々に裸体が露になっていく。\n元から裸同然の衣装だが、それすらもじわじわと溶けて観衆に体を見られることで興奮が高まり、股間は濡れ、陥没乳首は硬く大きく勃起し露出してしまう。（燭台エンライの中破状態の感じ）\n--------------\n\n紅蓮ドレスのような全身でお願いします。構図などはお任せでお願いします。\n\n◆その他\n中破状態は、ラスオリの中破状態よろしくセックスアピール強めとして頂きたいです。\n\nご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1ymBtrHAqiDs7VzetJPL-vtY9HoF05thv?usp=sharing", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7815E/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3765193, "client_id": 1321707, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3b9ef521/uploads/origins/2d50da44-4b7f-4006-a9a0-b5edc03a762f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=078e2c603f37533e701f7f82f97ed6f5", "srcset": "https://si.imgix.net/3b9ef521/uploads/origins/2d50da44-4b7f-4006-a9a0-b5edc03a762f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=078e2c603f37533e701f7f82f97ed6f5, https://si.imgix.net/3b9ef521/uploads/origins/2d50da44-4b7f-4006-a9a0-b5edc03a762f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9354949705b90b05cb9416ee16c91cde 2x, https://si.imgix.net/3b9ef521/uploads/origins/2d50da44-4b7f-4006-a9a0-b5edc03a762f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d488f73baf6cb169e54915be8f052bf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b9ef521/uploads/origins/2d50da44-4b7f-4006-a9a0-b5edc03a762f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b4ad03544457da6f0b73d36f5c9f3ef", "srcset": "https://si.imgix.net/3b9ef521/uploads/origins/2d50da44-4b7f-4006-a9a0-b5edc03a762f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b4ad03544457da6f0b73d36f5c9f3ef, https://si.imgix.net/3b9ef521/uploads/origins/2d50da44-4b7f-4006-a9a0-b5edc03a762f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=89f187a4b6fd88a3e9dc9871f78d5262 2x, https://si.imgix.net/3b9ef521/uploads/origins/2d50da44-4b7f-4006-a9a0-b5edc03a762f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=57ee80752adbb60b199f9cb6e169d060 3x"}, "body": "リンクを修正するため再送信！\n\nこんにちは！オリジナルキャラクターイラストの依頼をさせていただきます！\n\n私のキャラクター、アストリア・ローゼンガルドを描いていただけませんか？元気いっぱいの歌姫アイドルキャラです。以下のリンクに参考資料を載せておきます：\n\nアストリアのデザイン参考資料：https://imgur.com/a/astoria-rosengard-songstress-idol-Vw4bmVR\n\nアストリアがカメラの前でポーズをとっている、写真撮影のようなシチュエーションで描いてほしいです。以下のリンクにさまざまなポーズのリファレンスを用意したので、その中から好きなポーズを描いてください：\n\nポーズ参照フォルダ1: https://imgur.com/a/ya4c6MM\nポーズ参考資料フォルダ2: https://imgur.com/a/laying-down-pose-TCLWAKk\n\nすべての参考資料は、こちらのフォルダにもリンクされています： https://drive.google.com/drive/folders/1lPyjl7qYDkhqLjrZ26lyur2wb1GNQ7sa?usp=sharing\n\nその他、構図の詳細については、あなたの判断にお任せします。ありがとうございました！", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7815E/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3765193, "client_id": 2254415, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1eedcf43/uploads/origins/5f39f086-4df2-404e-b91b-6e21393c9e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2910ee9e7f9e32e878f1b98023b2f10e", "srcset": "https://si.imgix.net/1eedcf43/uploads/origins/5f39f086-4df2-404e-b91b-6e21393c9e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2910ee9e7f9e32e878f1b98023b2f10e, https://si.imgix.net/1eedcf43/uploads/origins/5f39f086-4df2-404e-b91b-6e21393c9e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c880839a79c2929633d305cf08c2655e 2x, https://si.imgix.net/1eedcf43/uploads/origins/5f39f086-4df2-404e-b91b-6e21393c9e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4fbe67edc3bccf6362f4adf5cc601475 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1eedcf43/uploads/origin