op&w=200&h=200&s=b9c908bfa7a03a1b15dfd3035c4e6dcc, https://si.imgix.net/7fdd0adf/uploads/origins/e76b374b-1c51-4f49-96c1-051e934e2b53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4eb07fc974af34b170c41d81e9db6886 2x, https://si.imgix.net/7fdd0adf/uploads/origins/e76b374b-1c51-4f49-96c1-051e934e2b53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52e9d9c9870078ea87bb68d1aea3f9f0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7fdd0adf/uploads/origins/e76b374b-1c51-4f49-96c1-051e934e2b53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ac99ab4eb8d1aa76a75c3c2ee5e33d9", "srcset": "https://si.imgix.net/7fdd0adf/uploads/origins/e76b374b-1c51-4f49-96c1-051e934e2b53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ac99ab4eb8d1aa76a75c3c2ee5e33d9, https://si.imgix.net/7fdd0adf/uploads/origins/e76b374b-1c51-4f49-96c1-051e934e2b53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5f9ef9ba79e8d1e5b78f4829b2b01367 2x, https://si.imgix.net/7fdd0adf/uploads/origins/e76b374b-1c51-4f49-96c1-051e934e2b53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=47b5d3ada7e2e9d2169a8e920f9f1e42 3x"}, "body": "はじめまして。\n甲殻類エビさんが過去に描かれていた淫獄団地のバニシング婦人会集合イラストがとても良かったです。\n\nつきましては漫画「淫獄団地」より変態人妻「ショウダ」のR-18イラストをリクエストさせていただきます。\n内容は以下のようにお願いいたします。\n・衣装はリビドークロス「ジャスティス」装着状態の正義マンコスチューム\n・R-18イラストらしくおっぱい＆乳首露出あり、局部描写あり（陰毛もお願いします）\n・その他シチュエーションや構図、ポーズなどは甲殻類えびさんの優れた画力と発想とセンスに一任します\n\n甲殻類エビさんの筆致で描くエッチなショウダさんが見てみたいです。\nご検討のほどよろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7815E/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3765193, "client_id": 2254415, "vtt_url": null, "thumbnail_image_urls": {"src":