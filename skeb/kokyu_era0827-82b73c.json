の「攻めらしさ」がより感じられるような作品も見てみたいです！\n\nお忙しいところ恐れ入りますが、ご検討いただけますと幸いです。\nもし金額がご希望に満たない場合は、追加でのご依頼も可能ですのでお知らせください。\nまた、内容がご対応難しい場合はキャンセルしていただいて問題ございません。\n\n最後までお読みいただき、誠にありがとうございます。", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kokyu_era0827/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3942010, "client_id": 3580836, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8b40cdd/uploads/origins/19b59215-9c45-4084-ae38-7adc3aa7ff18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a019f73af337cb7dc4a4b954c781abd4", "srcset": "https://si.imgix.net/c8b40cdd/uploads/origins/19b59215-9c45-4084-ae38-7adc3aa7ff18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a019f73af337cb7dc4a4b954c781abd4, https://si.imgix.net/c8b40cdd/uploads/origins/19b59215-9c45-4084-ae38-7adc3aa7ff18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0025c8f3bc7e5ab2e9749dafb948699 2x, https://si.imgix.net/c8b40cdd/uploads/origins/19b59215-9c45-4084-ae38-7adc3aa7ff18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de5089e5f426770f5d7fecedc9b1d08f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8b40cdd/uploads/origins/19b59215-9c45-4084-ae38-7adc3aa7ff18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe8264fa308dad165d8d994b5d7a3fc1", "srcset": "https://si.imgix.net/c8b40cdd/uploads/origins/19b59215-9c45-4084-ae38-7adc3aa7ff18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe8264fa308dad165d8d994b5d7a3fc1, https://si.imgix.net/c8b40cdd/uploads/origins/19b59215-9c45-4084-ae38-7adc3aa7ff18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b53f78781bbeac82cf28e14fbd0d20b 2x, https://si