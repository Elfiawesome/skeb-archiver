9e4bd5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02d89ad1df7afc9a2d08f255eb97ce22", "srcset": "https://si.imgix.net/2a4cdb89/uploads/origins/89dfa53d-4030-4bf5-b066-8cfc9e4bd5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02d89ad1df7afc9a2d08f255eb97ce22, https://si.imgix.net/2a4cdb89/uploads/origins/89dfa53d-4030-4bf5-b066-8cfc9e4bd5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bdac03dd5b70dfe24533d55d20e0cbf 2x, https://si.imgix.net/2a4cdb89/uploads/origins/89dfa53d-4030-4bf5-b066-8cfc9e4bd5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eee69b225bd2669a24eba9166dc38814 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a4cdb89/uploads/origins/89dfa53d-4030-4bf5-b066-8cfc9e4bd5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e42e479ec36bba5915ea85b00c6ba60", "srcset": "https://si.imgix.net/2a4cdb89/uploads/origins/89dfa53d-4030-4bf5-b066-8cfc9e4bd5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e42e479ec36bba5915ea85b00c6ba60, https://si.imgix.net/2a4cdb89/uploads/origins/89dfa53d-4030-4bf5-b066-8cfc9e4bd5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fdb25ce985be51e4e8a7a9d5a6891af2 2x, https://si.imgix.net/2a4cdb89/uploads/origins/89dfa53d-4030-4bf5-b066-8cfc9e4bd5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2012348d13a270314165f43277712675 3x"}, "body": "初めまして色琥珀さん\n色琥珀さんがSkeb再開したと通知きたので\nぜひ‪(っ ॑꒳ ॑c)描いて欲しくと思い申請させていただきます\n色琥珀さんが描いてた間近正面アングルの騎乗位食蜂操祈が良かったので\nとある系ではありませんが私の考えたオリキャラで似たような構図イラスト描いてほしいと思います\n\nお題\n「全裸騎乗位Hイラスト」\n\nキャラ\n「渡壁 鈴音」参考URLに載せます\n※私の考えたOC(オリジナルキャラです)\n「全裸ではありますが鈴音の特徴の鈴付きリボンは着用で」\n\n\n\n渡壁 鈴音 キャラ詳細\nギャルで生徒会長キャラで\n髪の色は青で\n腰までくらいのロングヘアーと\n頭部分に顔くらいの長さのポニーテールになってます\n胸はHカップの巨乳 この食蜂の絵とおなじですね\n※ポニーテール部分に鈴付きの赤いリボンと\n首部分鈴付きの青いリボンを着用してます。\n鈴音の特徴アクセサリーなので全裸ですが着用でお願いします。\n目の色は\n右眼があ、左眼が青のオッドアイです\n一人称「鈴音」(自分の事名前で呼びます)\n\n\n構図・アングル\n「色琥珀さんの正面アングル騎乗位」 https://www.pixiv.net/artworks/105059434 \n⬆この作品と同じ様に\n食蜂操祈の汗だくH良いですよね\n\n鈴音の体がメインで\n男性の手は参考の食蜂操祈と同じくももを掴んでおり\n構図アングルは同じですが\n鈴音のポニテ部分とポニテの鈴も見えるようにもしたいですね\nあと台詞と効果音は有り無しに分けてくださるとありがたいです\n男の台詞はなく、鈴音の喘ぎ声や効果音のみで\n\n台詞\n「鈴音のおまんこ…」\n「あっもういじめないで…んっ」\n「休ませっ」\n「またっきちゃう」\n \n(食蜂操祈の台詞を少し真似て決めて見ました)\nという感じにしてください😊\n\nシチュ\n①台詞効果音有版\n②台詞効果音無版\n※③台詞効果音無(舌出し)版\n※③は可能でしたらでいいので鈴音の口をキャラ参考4枚目みたいに舌出し状態のもあると嬉しいです。口が開いてる①②とは別に舌出し版に変えることで逆に鈴音が責めてる風にも見えるので面白いと思います\n\n\nはじめてで色々注文多くてすみませんが\n色琥珀さんにうちの子描いて欲しくいので\nご縁がありましたらよろしくお願いいたします\n\nhttps://x.com/YATOGMITOHKA/status/1812493582101836062?t=7OdLksRz0L_NfCfWwNWpyQ&s=19", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Irokohaku/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 760169, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/063b196f/uploads/origins/b6e13f06-555f-44fb-81f5-4d74ab6f6f47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c17c2c1989ff0755cf24bb7d90573f2", "srcset": "https://si.imgix.net/063b196f/uploads/origins/b6e13f06-555f-44fb-81f5-4d74ab6f6f47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c17c2c1989ff0755cf24bb7d90573f2, https://si.imgix.net/063b196f/uploads/origins/b6e13f06-555f-44fb-81f5-4d74ab6f6f47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb875911f3dbf9356a9f6d32deec336f 2x, https://si.imgix.net/063b196f/uploads/origins/b6e13f06-555f-44fb-81f5-4d74ab6f6f47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af5539c50b4348131f7beba35873129a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/063b196f/uploads/origins/b6e13f06-555f-44fb-81f5-4d74ab6f6f47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=290bdba1209d0b1f40b650dc6f5f11aa", "srcset": "https://si.imgix.net/063b196f/uploads/origins/b6e13f06-555f-44fb-81f5-4d74ab6f6f47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=290bdba1209d0b1f40b650dc6f5f11aa, https://si.imgix.net/063b196f/uploads/origins/b6e13f06-555f-44fb-81f5-4d74ab6f6f47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ea729d8497c936bf196ac5a5a99fa64 2x, https://si.imgix.net/063b196f/uploads/origins/b6e13f06-555f-44fb-81f5-4d74ab6f6f47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fee9cd966df4f7f9fa504ed659cd725e 3x"}, "body": "初めまして、良ければリクエストしたいです。\n可能であれば、ドールズフロントラインのG11をお願い致します。  \n参考 : https://wikiwiki.jp/dolls-fl/Gr%20G11 \n胸控えめで少し小柄な子です。下は無毛でお願いします。\n頭の帽子も何も無しの銀髪のみで、片足パンツで全裸でお願いします。\n簡単な喘ぎセリフと擬音の有り・無し(出来ればレイヤー分け)が欲しいです。\n\n以下の作品と全く同じ体勢と横構図の激しい騎乗位が見たいです。\nhttps://www.pixiv.net/artworks/104166993\nめちゃくちゃ発汗し、涙流して非常に激しく感じて余裕がない様子でお願いします。\n差分式でピストンと中出しで２つ以上の表情が欲しいです。(目開けや目閉じ、歯食いしばりやわなわな大口など)\n\n良ければご検討下さい。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Irokohaku/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 760169, "client_id": 2214466, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8eda07d1/uploads/origins/eba2de27-6362-4307-8b61-b5cf1df058b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac5ec9303eaf1e5ed88b5f65ad2793c6", "srcset": "https://si.imgix.net/8eda07d1/uploads/origins/eba2de27-6362-4307-8b61-b5cf1df058b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac5ec9303eaf1e5ed88b5f65ad2793c6, https://si.imgix.net/8eda07d1/uploads/origins/eba2de27-6362-4307-8b61-b5cf1df058b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&