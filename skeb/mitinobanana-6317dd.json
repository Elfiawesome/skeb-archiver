n\n［受け］\n資料の左側にいるシャツの男です。\n自我希薄で意志薄弱。攻めの言うことをなんでも聞いてしまう。\n年齢と性別のことは気にせず、女の子みたいに思いっきりかわいく描いてくださったら嬉しいです。\n\n特殊な関係の二人ですが、ちゃんと愛し合っており、お互いのことが大好きです。\nシチュエーションや構図などはお任せ致します、幸せそうな雰囲気でも、暗そうな雰囲気のものでもなんでも嬉しいです！\n髪型や洋服なども、描きやすいように適宜アレンジしてくださって大丈夫です。\n\n是非ともご検討をお願いします。\n\nhttps://drive.google.com/drive/folders/1a_3Up0ZxpTYid7MxrD5Z5cJ5th86shFs?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mitinobanana/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 803156, "client_id": 2392053, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec9a3e06/uploads/origins/6f09e5aa-c885-4593-931e-76ca396552f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0c6e0d271294a9971ec39c21d25c498", "srcset": "https://si.imgix.net/ec9a3e06/uploads/origins/6f09e5aa-c885-4593-931e-76ca396552f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0c6e0d271294a9971ec39c21d25c498, https://si.imgix.net/ec9a3e06/uploads/origins/6f09e5aa-c885-4593-931e-76ca396552f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43e3722abb5ef01935dfa24cb4e7dd8a 2x, https://si.imgix.net/ec9a3e06/uploads/origins/6f09e5aa-c885-4593-931e-76ca396552f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6ab13275e08594384c232b2813ba20e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec9a3e06/uploads/origins/6f09e5aa-c885-4593-931e-76ca396552f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=107ce69c0392a18570783b4bc38fed3a", "srcset": "https://si.imgix.net/ec9a3e06/uploads/origins/6f09e5aa-c885-4593-931e-76ca396552f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=107ce69c0392a18570783b4bc38fed3a, https://si.imgix.net/ec9a3e06/uploads/origin