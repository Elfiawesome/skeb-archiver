false}, {"path": "/@senaoThankyou/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3190963, "client_id": 3243756, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/266e0b87/uploads/origins/cf7ecf15-c824-4797-a924-ec1dfea896d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b41afe70f029d7e0b36dfd54810395b", "srcset": "https://si.imgix.net/266e0b87/uploads/origins/cf7ecf15-c824-4797-a924-ec1dfea896d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b41afe70f029d7e0b36dfd54810395b, https://si.imgix.net/266e0b87/uploads/origins/cf7ecf15-c824-4797-a924-ec1dfea896d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22c471428276f8b0196d445519319efe 2x, https://si.imgix.net/266e0b87/uploads/origins/cf7ecf15-c824-4797-a924-ec1dfea896d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34e8b8750cfe2dd94b749d78557e206e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/266e0b87/uploads/origins/cf7ecf15-c824-4797-a924-ec1dfea896d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dca7f44bd116d8eb5f81bdcd13fe7081", "srcset": "https://si.imgix.net/266e0b87/uploads/origins/cf7ecf15-c824-4797-a924-ec1dfea896d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dca7f44bd116d8eb5f81bdcd13fe7081, https://si.imgix.net/266e0b87/uploads/origins/cf7ecf15-c824-4797-a924-ec1dfea896d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5886adcecaefa3ccd1df3903cc65a5af 2x, https://si.imgix.net/266e0b87/uploads/origins/cf7ecf15-c824-4797-a924-ec1dfea896d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3f3315c30aef730ad395ab10e66487b9 3x"}, "body": "瀬直先生、はじめまして！先生の絵は昔から大好きで、ロゴスのイラストも大好きです。単純に素敵すぎます！\n\n私のOCであるシエンヌの絵をお願いしたいです。でも、もし忙しかったり、興味がなかったりしたら、遠慮なくこの依頼をキャンセルしてください。\n\nシエンヌは高貴な騎士タイプのキャラクターです。ドラゴンと人間の女性の混血で、幼い頃に実の母親に捨てられた。両親を知らず、教会で育ち、そこで優雅で謙虚な振る舞いを学んだ。自らを優雅な騎士と称している。\n\nしかし、さまざまな理由から、シエンヌは痛みを感じることができない。そのため、人が強い肉体的苦痛を受けたときに、なぜみじめな行動をとるのか理解できない。彼は本当に肉体的な危害を加えるつもりがなくても人を傷つけることができるが、ただ痛み、出血、死についてあまり知らないだけなのだ。\n\nシエンヌは明るい金色の目と2対の竜の角を持っている。彼は一対のエメラルドのイヤリングをつけ、額に十字架をぶら下げている（可能であれば、自由にこれらを強調してほしい！ 私は彼のイヤリングが本当に好きなのだ :)\n\n剣よりもランスをよく使う。\n\n彼の服装を変えるのはご自由にどうぞ！\n\nリクエストに応えてくれてありがとう！\n\n参考\nhttps://drive.google.com/drive/folders/1-0LVuHvVsrRpksKy-CIsHYKZ2Q6VECyO", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@senaoThankyou/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3190963, "client_id": 431857, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e990a4da/uploads/origins/756fd9d8-c4ee-463b-ab0b-303da071fe79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=116ed019ce983b70ff9b32c6832f724b", "srcset": "https://si.imgix.net/e990a4da/uploads/origins/756fd9d8-c4ee-463b-ab0b-303da071fe79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=116ed019ce983b70ff9b32c6832f724b, https://si.imgix.net/e990a4da/uploads/origins/756fd9d8-c4ee-463b-ab0b-303da071fe79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9aa6a98ad75ede0624a2ab682893ca6f 2x, https://si.imgix.net/e990a4da/uploads/origins/756fd9d8-c4ee-463b-ab0b-303da071fe79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6660248c66eeac70e213a523c201e7c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e990a4da/uploads/origins/756fd9d8-c4ee-463b-ab0b-303da071fe79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e82ab211226be19743e5789e5cdfe39", "srcset": "https://si.imgix.net/e99