62e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0644621c5cb5dedd27c1ec3fead40a00", "srcset": "https://si.imgix.net/fcf99f80/uploads/origins/8a2ae801-2b6d-4b18-b582-12176bb3062e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0644621c5cb5dedd27c1ec3fead40a00, https://si.imgix.net/fcf99f80/uploads/origins/8a2ae801-2b6d-4b18-b582-12176bb3062e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b7e2794e9a2eac8873cd77513aad7ab 2x, https://si.imgix.net/fcf99f80/uploads/origins/8a2ae801-2b6d-4b18-b582-12176bb3062e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dbbd27105ca75b44abafae56927712c0 3x"}, "body": "以前からイラストも漫画等のモノクロ表現も共に素敵だなと拝見しておりました。\n此度窓開けお見掛けしましてリクエスト送信失礼致します。\n内容としましては、自身の描いたキャラクターとなります。\n\n▶イメージ補足\n・30代半ばの男性　実年齢より若見えしていそうな容貌\n（少し近未来風味の日本舞台の伝奇モノ世界観/現代よりも武装している警察イメージ/得物はサブマシンガン）\n・身長178cm（+ヒールのある靴）で細身の体型、顔立ちは非常に整っている（睫毛が長い）\n・画面向かって←側に、目下と口元2箇所に黒子あり\n・普段は伏し目がち、偶に開眼。　サングラスをしている場合が多い\n・ミステリアスな雰囲気を漂わせた美人。難解な言い回しの喋り方をするタイプ\n（※肩に羽織っているファー付上着は、他の方の基準デザインを参考にしたものになります）\nイメージモチーフ：冬・雪・白蛇\n\n色系統としては\n肌：浅めの褐色　髪：銀髪＋インナーカラー淡紫　\n目：赤（メイン色）と金（ハイライト等）/少し瞳孔が縦長め（※フェイス画像参照）\n\n▶希望等\n・目の表現は開眼希望（可能であればサングラスあり/なし差分あると嬉しいです）\n・衣装は資料のものでなくても、適宜アレンジして頂いても構いません。\n（露出は基本的に少なめで比較的かっちりめ/手袋は着用希望）\n・構図等は描きやすいようにして頂ければと思います\n\n宜しければ御一考頂けますと幸いです。\n\nhttps://drive.google.com/drive/folders/1_65JVRJCIu9SLFHn_YdY1P3-PJtbWxr2", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@senaoThankyou/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3190963, "client_id": 3213294, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e305da2/uploads/origins/6b77afde-9f16-4635-b994-27aaff8ae9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9f79b892f9d0514194ad19e8025e1e0", "srcset": "https://si.imgix.net/1