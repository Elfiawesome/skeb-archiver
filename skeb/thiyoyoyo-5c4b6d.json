かなど)を明記してくださると幸いです。イラストの内容は全年齢対象のものでお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@thiyoyoyo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1377233, "client_id": 1389271, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66f54940/uploads/origins/c80237a1-d085-490f-8f81-0bf3bde29531?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f76abaa68640cae3ec4034d62aa9745", "srcset": "https://si.imgix.net/66f54940/uploads/origins/c80237a1-d085-490f-8f81-0bf3bde29531?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f76abaa68640cae3ec4034d62aa9745, https://si.imgix.net/66f54940/uploads/origins/c80237a1-d085-490f-8f81-0bf3bde29531?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6e92421457c7950b13cc8b293f6a1c0 2x, https://si.imgix.net/66f54940/uploads/origins/c80237a1-d085-490f-8f81-0bf3bde29531?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=009666506f5aa149908ef901748b2eee 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66f54940/uploads/origins/c80237a1-d085-490f-8f81-0bf3bde29531?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8da24da347f840b8c16e2c333cc0c868", "srcset": "https://si.imgix.net/66f54940/uploads/origins/c80237a1-d085-490f-8f81-0bf3bde29531?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8da24da347f840b8c16e2c333cc0c868, https://si.imgix.net/66f54940/uploads/origins/c80237a1-d085-490f-8f81-0bf3bde29531?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ce17657297f0ae8ec61f53165eb8b5c 2x, https://si.imgix.net/66f54940/uploads/origins/c80237a1-d085-490f-8f81-0bf3bde29531?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=t