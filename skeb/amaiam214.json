もうちょっと我慢しなさい❤️」、「全部ナカに出してもらうんだから❤️」と言いたつつ射精管理をする。\n2枚目は、マギアがストライカー君に興奮した表情で、「あんたが一体誰の物なのか、その身で教えさせてあげるわ❤️」「いっぱいナカに出しなさい❤️」と言い、ストライカー君を攻める。\n以上です。よろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amaiam214/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bafba8af/uploads/origins/2d2bf7d1-23d1-430f-8150-e93883a07144?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c196267d529a05ca6a24f1c1344b001b", "srcset": "https://si.imgix.net/bafba8af/uploads/origins/2d2bf7d1-23d1-430f-8150-e93883a07144?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c196267d529a05ca6a24f1c1344b001b, https://si.imgix.net/bafba8af/uploads/origins/2d2bf7d1-23d1-430f-8150-e93883a07144?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c2d766dd0575c7b7711737e77bb803e4 2x, https://si.imgix.net/bafba8af/uploads/origins/2d2bf7d1-23d1-430f-8150-e93883a07144?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd21b6ec381f1c45d38e9c6fbcf52519 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3514540, "nc": 49}, {"path": "/@amaiam214/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3514540, "client_id": 3335722, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21dc5fce/uploads/origins/3f089b56-2cb3-4493-a18c-3d159f2b91e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88f81bca9f31b89b32d6b935fb86f341", "srcset": "https://si.