4\u305f\u3057\u307e\u3059\u3002\n\u30fb\u8863\u88c5\u306f\u3001HOT LIMIT\u306e\u8863\u88c5\u3092\u7740\u305b\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\uff01\u9d8f\u306e\u30a4\u30e1\u30fc\u30b8\u306f\u6b8b\u3057\u3064\u3064(\u9aea\u30b4\u30e0\u3084\u3001\u80cc\u666f\u306b\u9d8f\u306e\u30c7\u30b6\u30a4\u30f3\u306a\u3069)\u3001\u672c\u5bb6\u69d8\u306e\u3088\u3046\u306a\u30a4\u30e1\u30fc\u30b8\u306b\u5bc4\u305b\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\uff01(\u96e3\u3057\u305d\u3046\u3067\u3042\u308c\u3070\u3001\u30eb\u30fc\u30ba\u30fb\u30ed\u30c3\u30b5\u69d8\u306b\u304a\u4efb\u305b\u3055\u305b\u3066\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\uff01)\n\n\u25a0\u4f7f\u7528\u7528\u9014\n\u30fb\u6b4c\u3063\u3066\u307f\u305f\u52d5\u753b\u306e\u30aa\u30ea\u30b8\u30ca\u30eb\u52d5\u753b\u30a4\u30e9\u30b9\u30c8\u3068\u30b5\u30e0\u30cd\u30a4\u30eb\n\u30fb\u30aa\u30ea\u30b8\u30ca\u30eb\u52d5\u753b\u3001\u30b5\u30e0\u30cd\u30a4\u30eb\u3001\u914d\u4fe1\u753b\u9762(\u53ce\u76ca\u5316\u3057\u3066\u3044\u308b\u30c1\u30e3\u30f3\u30cd\u30eb\u306b\u306a\u308a\u307e\u3059\u3002)\n\u30fbX\u306a\u3069SNS\u6d3b\u52d5(\u304a\u306f\u3088\u3046\u30dd\u30b9\u30c8\u3084\u30a2\u30a4\u30b3\u30f3\u3001\u30d8\u30c3\u30c0\u30fc\u3001\u544a\u77e5\u30dd\u30b9\u30c8\u7b49)\n\u30fb\u5546\u7528\u4f7f\u7528\uff08\u30b0\u30c3\u30ba\u5c55\u958b\u3084\u30cd\u30c3\u30c8\u30d7\u30ea\u30f3\u30c8\uff09\n\u203bNG\u306a\u4f7f\u7528\u65b9\u6cd5\u304c\u3042\u308a\u307e\u3057\u305f\u3089\u3001\u5225\u30ec\u30a4\u30e4\u30fc\u306b\u3066\u8a18\u8f09\u3092\u304a\u9858\u3044\u81f4\u3057\u307e\u3059\uff01\n\u307e\u305f\u3001\u91d1\u984d\u306b\u3088\u308a\u4e0d\u53ef\u80fd\u306a\u5834\u5408\u306f\u3001\u5927\u5909\u304a\u624b\u6570\u3067\u3059\u304c\u91d1\u984d\u306e\u3054\u63d0\u793a\u3092\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002\n\n\u25a0\u5f62\u5f0f\n\u30fb\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3001\u80cc\u666f\u3001\u5c0f\u7269\u3001\u30b5\u30a4\u