i.imgix.net/dc1c21e7/uploads/origins/2f20113e-73fd-4866-8e8f-5da226eb3d68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d135f945cbb2111cdef8c468778000c8, https://si.imgix.net/dc1c21e7/uploads/origins/2f20113e-73fd-4866-8e8f-5da226eb3d68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bd60653874c8d3b662af36ec6a9c057 2x, https://si.imgix.net/dc1c21e7/uploads/origins/2f20113e-73fd-4866-8e8f-5da226eb3d68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f0f2712b8245152d380f7fdea9eb86e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc1c21e7/uploads/origins/2f20113e-73fd-4866-8e8f-5da226eb3d68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cad4caa2d649c9621c9a9cb6420a018", "srcset": "https://si.imgix.net/dc1c21e7/uploads/origins/2f20113e-73fd-4866-8e8f-5da226eb3d68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cad4caa2d649c9621c9a9cb6420a018, https://si.imgix.net/dc1c21e7/uploads/origins/2f20113e-73fd-4866-8e8f-5da226eb3d68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=608fe37cc896a798c22a34811d043cc7 2x, https://si.imgix.net/dc1c21e7/uploads/origins/2f20113e-73fd-4866-8e8f-5da226eb3d68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8a5825cdaf9ce718f60b29e3bff12f90 3x"}, "body": "初めまして、蒼凪シノンと申します。\n\nたんポポ様の描かれるイラストや絵柄がとても素敵だと感じ、ぜひ自分のキャラクターを描いていただきたいと思い、今回リクエストを送らせていただきました！\n\n【依頼内容】\n\n現在、IRIAMを中心に活動している「蒼凪シノン」というキャラクターのバストアップの一枚絵をお願いしたいです。\n\n構図や表情、ポーズ、背景などに特に指定はございませんので、様の感性や世界観を活かして、自由に描いていただけますと幸いです！\n\n【使用用途】\n\n・XなどのSNSでの投稿、告知活動\n\n・IRIAMでの配信サムネイルへの使用（収益化を含む）\n\n・SNSのアイコンやヘッダーへの使用\n\n※グッズ化などの商用利用は現時点では予定しておりません。\n\nなのでギガファイルなどで一枚絵のファイルを送っていただけたらうれしいです。\n\n【キャラクターについて】\n\n名前：蒼凪シノン\n\n活動コンセプト：「海の静けさと心地良さを届けるスーパーゲーマー」\n\nファンマーク：🌊🎮🦭\n\nキャラクターの外見や衣装などの詳細につきま