ン気味 \n・目はやや大きめでうるみ目のようなイメージ \n・表情や性格は全体的に『薫る花は凛と咲く』の薫子のようなイメージです。\n  性格 \n・内向的だが仲のいい友人には明るく接する。 \n・喜怒哀楽が表情に出やすく、真面目で誠実で曲がったことが嫌い。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mizu_bakethu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3773645, "client_id": 3908849, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8801016e/uploads/origins/55bba7cc-40ef-46af-ad05-dee5e9f45390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79f516bdc08f45218e16c21acbca2ec7", "srcset": "https://si.imgix.net/8801016e/uploads/origins/55bba7cc-40ef-46af-ad05-dee5e9f45390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79f516bdc08f45218e16c21acbca2ec7, https://si.imgix.net/8801016e/uploads/origins/55bba7cc-40ef-46af-ad05-dee5e9f45390?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4800e7a6bdedeb4e0391abc9c7796b1d 2x, https://si.imgix.net/8801016e/uploads/origins/55bba7cc-40ef-46af-ad05-dee5e9f45390?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63a50226a6807329e570a53776d87a24 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8801016e/uploads/origins/55bba7cc-40ef-46af-ad05-dee5e9f45390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4c36dcad306fd0818be7ca54641278a", "srcset": "https://si.imgix.net/8801016e/uploads/origins/55bba7cc-40ef-46af-ad05-dee5e9f45390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4c36dcad306fd0818be7ca54641278a, https://si.imgix.net/8801016e/uploads/origins/55bba7cc-40ef-46af-ad05-dee5e9f45390?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aebc10992b9a427eef443d28c75b39f0 2x, https://si.imgix.net/8801016e/uploads/origins/55bba7cc-