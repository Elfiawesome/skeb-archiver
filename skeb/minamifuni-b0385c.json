3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05d27eb1564f96fa9016788edd2235f7", "srcset": "https://si.imgix.net/e55babf9/uploads/origins/164ae093-59c2-4900-ab4e-5f155acd0d66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05d27eb1564f96fa9016788edd2235f7, https://si.imgix.net/e55babf9/uploads/origins/164ae093-59c2-4900-ab4e-5f155acd0d66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=77630d937b32dd350dca95a99deccf4a 2x, https://si.imgix.net/e55babf9/uploads/origins/164ae093-59c2-4900-ab4e-5f155acd0d66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ff98d574e58df9564dff2e82076970b6 3x"}, "body": "はじめまして、先生\n\n先生にイリヤの漫画をリクエストできる瞬間が来るのを待っていました。\n\nもし切嗣がイリヤを救出することに成功したなら、そしてもしイリヤと士郎が正常な兄妹になって一緒に暮らしたなら、という if の設定で、2004年の時点で二人で一緒に穂群原学園に通う漫画のリクエストをお願いします。\n\n学校のマスコットとしてみんなにかわいがられる(そしてブラコンです)イリヤと、イリヤを「姉さん」と呼ぶ士郎が見たいです。\n\n\n詳しい内容とセリフは先生にお任せします。\n\n\nどうぞよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@minamifuni/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3514192, "client_id": 1532269, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d0ab75d/uploads/origins/ac91aee6-5929-4fac-8210-a4570fc2f065?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02cbd9532bda211888203fe4d641be76", "srcset": "https://si.imgix.net/9d0ab75d/uploads/origins/ac91aee6-5929-4fac-8210-a4570fc2f065?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02cbd9532bda211888203fe4d641be76, https://si.imgix.net/9d0ab75d/uploads/origins/ac91aee6-5929-4fac-8210-a4570fc2f065?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dff6ecc114a082544fb700f1571fbf1c 2x, https://si.imgix.net/9d0ab75d/uploads/origins/ac91aee6-5929-4fac-8210-a4570fc2f065?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83adc05c1fabad65b995fcea8777c0b8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d0ab75d/uploads/origins/ac91aee6-5929-4fac-8210-a4570fc2f065?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00cf55bc653b0750351c3c937ae62fcf", "srcset": "https://si.imgix.net/9d0ab75d/uploads/origins/ac91aee6-5929-4fac-8210-a4570fc2f065?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00cf55bc653b0750351c3c937ae62fcf, https://si.imgix.net/9d0ab75d/uploads/origins/ac91aee6-5929-4fac-8210-a4570fc2f065?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=285aff7da2d32d236f5fe1cee0de242a 2x, https://si.imgix.net/9d0ab75d/uploads/origins/ac91aee6-5929-4fac-8210-a4570fc2f065?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d280d91c22fa1bf8d51f7dbd4ab4681 3x"}, "body": "はじめまして。\n可愛いタッチのイラストで描かれた御本を拝見しております。\n（アインツベルンに引き取られた士郎がイリヤと聖杯戦争に臨むお話が特に好きです）\n\nピンチヒッターとして柔道の試合に出た士郎のイラストをお願いできないでしょうか……？\n\n本編前の時期で、柔道部の部長が怪我をして試合に出られなくなってしまった部員の代わりになりそうな人はいないか、武道系の部活つながりで慎二に相談したところ「（身体能力が高いし、頼み事を断らない性分だからちょうどいい）士郎に頼んでみたらどうだ？」と言われてピンチヒッターを頼んで、快く引き受けてもらったようなイメージで。\n表情や構図等はおまかせいたします。\n\n金額に見合わないようでしたら増額等申請いただけますと幸いです。\n\nご検討のほど、よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@minamifuni/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3514192, "client_id": 430123, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0011c142/uploads/origins/b5a2e632-da3c-4079-b883-ae88eb5a40f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec1773c55e132c2e09da7931201677d5", "srcset": "https://si.imgix.net/0011c142/uploads/origins/b5a2e632-da3c-4079-b883-ae88eb5a40f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec1773c55e132c2e09da7931201677d5, https://si.imgix.net/0011c142/uploads/origins/b5a2e632-da3c-4079-b883-ae88eb5a40f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36cf28335f327322dc0c4eaccc0cf284 2x, https://si.imgix.net/0011c142/uploads/origins/b5a2e632-da3c-4079-b883-ae88eb5a40f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34181bfefc3c5d42065fa296ea96f732 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0011c142/uploads/origins/b5a2e632-da3c-4079-b883-ae88eb5a40f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d4401018cc58100abebba97342ca66b", "srcset": "https://si.imgix.net/0011c142/uploads/origins/b5a2e632-da3c-4079-b883-ae88eb5a40f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d4401018cc58100abebba97342ca66b, https://si.imgix.net/0011c142/uploads/origins/b5a2e632-da3c-4079-b883-ae88eb5a40f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e0d9fb56916b74f93c5966d7e30d259c 2x, https://si.imgix.net/0011c142/uploads/origins/b5a2e632-da3c-4079-b883-ae88eb5a40f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d864afab0bb026e814ce639773602438 3x"}, "body": "こんにちは！FGOのおさかべ姫と私のVTuberのOCのねこたんの漫画が欲しいです。\n\nある日彼がカルデアにやってきて、おさかべ姫の部屋で一緒にいたずらをする話が欲しいです。\n\nいくつか注意点があります：\n- ネコアークより少し背が高い。\n- 格闘ゲームをする。\n- ギャグマンガの登場人物のように、どんな状況でも必ずトップに立つ（たとえ死んだとしても、世界のどこかにもう一人の彼が現れる）。\n- 猫でありながらガチャゲーマーでもある。\n- 気分次第でやんちゃにもなるし、かわいくもなる！\n- 諸星あたるに似て、ちょっと嗜虐的。\n\nおさかべ姫が彼を好きになるのも嫌いになるのも自由です！\n\nもし機械翻訳された英語版を作ってもらえるとうれしいですが、それが無理なら、わかりました。\n\nありがとうございました！\n\nhttps://twitter.com/TannerOfDaNorth/status/1628714515796729857?t=iWGnhUsBdpvvbVvFkG9thw&s=19", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {