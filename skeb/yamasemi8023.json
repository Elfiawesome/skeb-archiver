d-572f74300a42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f322c10ead347013251dea5fe8491f51", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/749e67c6/uploads/origins/e3ce6e3b-cecc-44d9-86dd-572f74300a42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5bf897dbac04b82648dcab9d48aea28a", "src_set": ""}, "body": "こんにちは、はじめまして。アキと申します。お願いがあります。私のヴァンパイアの女の子スカディを描いていただけませんか？銀髪のヴァンパイアの女の子です。頭に羽をつけて遊んでいるところが見たいです。2つ目のリンクは私が探しているものの例です。よろしくお願いします！\n\nスカディ\nhttps://drive.google.com/drive/folders/1JgbZYKZITlw1uQYV4qOSyJewLXiU7B1G\n\nポーズ\nhttps://x.com/citruslady/status/1832760168976654634?t=_Xeu1sXjvIKBlGPnRS13SQ&s=19", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamasemi8023/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1046939, "client_id": 25832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b15adbe/uploads/origins/b360f515-22be-4c09-ade8-4ceb3b5fafde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77871e81225c77326e9462f520ef4f53", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b15adbe/uploads/origins/b360f515-22be-4c09-ade8-4ceb3b5fafde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8a8478cddfb0e8ef242df019e3d84ce", "src_set": ""}, "body": "初めまして。Skebでの素敵なイラストをお見かけして依頼させていただきました。\n\n私のオリジナルキャラクターであるエイネラのイラストを描いていただきたいです。\n\n設定としては、メイドとシスターの二足の草鞋を履いて生活している女の子です。主のことが大好きな子で、家事のことなら何でもお手の物。基本的にスペックは高めだけれど、少々自己評価が低めな性格です。\n\n表情はふわりとした笑顔にしていただけると嬉しいです。\nイラストの雰囲気が好きなので、構図はお任せします。\n\nご検討のほど、よろしくお願い致します。\n\nhttps://drive.google.com/file/d/1FgCCZKuA6yWZu3nz6BqRF-d2I7aX_HVh/view", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptab