って間もない時期で、旅の話をせがんだり自分のことを話したりとぐいぐい来るリコリーヌに対して、少し困惑しつつも懐いてくる彼女を悪くは思っていないロジェ……といったイメージ\n\nもし良ければよろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mo2kirby/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 622632, "client_id": 2014242, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d707d9f5/uploads/origins/cd9b0f15-ab28-4abc-ba1a-4cd1ea80cfcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0280db7fd582942cea58d860b737409a", "srcset": "https://si.imgix.net/d707d9f5/uploads/origins/cd9b0f15-ab28-4abc-ba1a-4cd1ea80cfcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0280db7fd582942cea58d860b737409a, https://si.imgix.net/d707d9f5/uploads/origins/cd9b0f15-ab28-4abc-ba1a-4cd1ea80cfcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b28ad385dea3f27bd9f527143fe8f646 2x, https://si.imgix.net/d707d9f5/uploads/origins/cd9b0f15-ab28-4abc-ba1a-4cd1ea80cfcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3676a814877650fe70d5ec9e2eeddef2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d707d9f5/uploads/origins/cd9b0f15-ab28-4abc-ba1a-4cd1ea80cfcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80e9b960a3938a882d377f7e2220aa0e", "srcset": "https://si.imgix.net/d707d9f5/uploads/origins/cd9b0f15-ab28-4abc-ba1a-4cd1ea80cfcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80e9b960a3938a882d377f7e2220aa0e, https://si.imgix.net/d707d9f5/uploads/origins/cd9b0f15-ab28-4abc-ba1a-4cd1ea80cfcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e60e88c3d244b09439f3205192594d27 2x, https://si.imgix.net/d707d9f5/uploads/origins/cd9b0f15-ab28-4abc-ba1a-4cd1ea80cfcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d46c1ecc8b34df68b80519329ff2acae 3x"}, "body": "以前に描いていただいたイラストがとても良かったのでまた依頼させてください。\n\n鑑賞目的で、前回のキャラ（https://skeb.jp/@mo2kirby/works/1）の相方になるキャラを描いていただきたいです。\n相方という言い方ですが、必ずしも仲間や恋人でなくても構いません。\n彼女と何らかの関係性を持つキャラ、といったニュアンスです。\n\n関係性の詳細については水鳥さんにお任せします。\n恋愛関係のような肯定的な関係、敵対関係のような否定的な関係、etc…2人の間に双方向もしくは一方向の強い感情を伴う関係であれば何でもOKです。\n\nまた、容姿、性別、年齢に指定はありません。自由に描いていただければと思います。\n\n可能であれば、2人の関係性が分かる資料（説明文や、日常の1コマのごく簡単なラフイラストなど）があると想像が膨らむのでとても嬉しいです。\n\nよろしくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mo2kirby/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 622632, "client_id": 2014242, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ce6f2d2/uploads/origins/12fb21f7-d5ec-4b48-8046-3f74a9a50559?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6ea5640f49b662e30b8c1349b6fec84", "srcset": "https://si.imgix.net/5ce6f2d2/uploads/origins/12fb21f7-d5ec-4b48-8046-3f74a9a50559?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6ea5640f49b662e30b8c1349b6fec84, https://si.imgix.net/5ce6f2d2/uploads/origins/12fb21f7-d5ec-4b48-8046-3f74a9a50559?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2531d87386a84745858fb18faaa203af 2x, https://si.imgix.net/5ce6f2d2/uploads/origins/12fb21f7-d5ec-4b48-8046-3f74a9a50559?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=278f6788ef59b0ff1c7260dbd3727c99 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ce6f2d2/uploads/origins/12fb21f7-d5ec-4b48-8046-3f74a9a50559?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=005bb5af847d3fd230a9d433870532db", "srcset": "https://si.imgix.net/5ce6f2d2/uploads/origins/12fb21f7-d5