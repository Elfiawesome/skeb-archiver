ration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/386a84a6/uploads/origins/b6b0de43-d913-44e2-b57b-5aef7d3f43f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70e549343ae429fd0d78fc11042a677b", "src_set": ""}, "body": "敵に囚われ、檻の中に入れられているスズシロ、レイをお願いします。\n\n彼女たちは後ろ手に縄で上半身と足首（いければ太ももも）をギチギチに縛られ、猿轡を噛み締め檻の外の敵を睨みつけている構図。服は少しボロボロでお願いします。\n檻は牢屋というよりかは、動物を入れるような、狭めのイメージとなります。\n\nまた、余白があれば敵のセリフをお願いします。\n「もうすぐ処刑だ」「処刑準備はできた」など、彼女たちの処刑を仄めかす発言があれば嬉しいです。細かい点は先生にお任せ致します。\n\nよろしくお願いいたします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hachitomato/works/205", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1178698, "client_id": 761455, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41b9b815/uploads/origins/3c418940-0e3c-4715-8d3d-96a202ba5700?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2d10417f14e20951385e95644244f7c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41b9b815/uploads/origins/3c418940-0e3c-4715-8d3d-96a202ba5700?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4fcd93c84a27caf78d0a3416105be39", "src_set": ""}, "body": "八雲銀次郎さん、こんにちは。\n以前、「がっこうぐらし!」キャラのイラストを依頼したものです。\n今回も同じ作品キャラのイラストをリクエストしたいと思います。\n\n キャラクター \n直樹美紀（がっこうぐらし!）\n\n服装 \n・学生制服  \n\nシチュエーション\n・「I字バランス」のポーズで電柱に縛られる\n・口にボールギャグ \n・他の所はおまかせします\n\n よろしくお願いします。\n\nhttps://gakkougurashi.com/chara/miki.html", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hachitomato/works/204", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/03d9f2d1/uploads/origins/8203adde-1a0a-4d27-bc43-c0139110c9a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86eef95004db7163633405915302bdfc", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1178698, "client_id": 1193354, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hachitomato/works/203", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e96a7eb1/uploads/origins/ba2e0746-b0c2-4804-84f3-90c32eef02d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6432914bf0ae2e96f3bb0b3884108564", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1178698, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hachitomato/works/202", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1178698, "client_id": 1674369, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d50b9cd8/uploads/origins/224a0c73-9f38-4ec2-8dd8-f2336b1cd525?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=386a1998e3ce94f6f2c4a70b580db01d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d50b9cd8/uploads/origins/224a0c73-9f38-4ec2-8dd8-f2336b1cd525?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01eb45c1c3c895055874831ba1938c0e", "src_set": ""}, "body": "八雲銀次郎様\n\nいつも素晴らしい作品を描いていただき、ありがとうございます。\n\nマイナーなリクエストで恐縮ですが、戦え‼︎イクサー1からイクサー2の猿轡緊縛絵をお願いします。\n\n以下をお願いします。\n・厳しく緊縛された全身絵をお願いします。\n・後ろ手緊縛で、胸縄と股縄、脚も揃えて全身厳重に緊縛。\n・噛ませ猿轡と鼻上被せ猿轡の2種類の猿轡\n・戦闘服の着衣と何も身につけていない全裸の状態\n・着衣は悔しそうにこちらを涙目で睨む表情を、全裸は弱々しく泣きながらこちらを見つめる表情\n\nご検討いただけましたら幸いです。\nどうか、よろしくお願いします。\n\nhttps://drive.google.com/file/d/1yZBjN2OiHgmWpO3bwGreokuEP63GYino/view?usp=sharing", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hachitomato/works/201", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1178698, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d72b4764/uploads/origins/5fb15215-9c9b-4336-9908-32f6ceda64d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbd40d649a541dd90f249af12d895703", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d72b4764/uploads/origins/5fb15215-9c9b-4336-9908-32f6ceda64d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48900900b4f264c15601c5a89800b69f", "src_set": ""}, "body": "敵に敗れたスズシロ、レイ、アンジュが縛られ、民衆に見られながら街中を連行されている様子をお願いします。\n\n彼女たちは手錠を前に掛けられ、手錠同士が鎖で繋がれている状態で縦並び（順番は上記の名前順）に歩かされている、服は少し破けアリ、悔しそうな表情を浮かべながら縄を引かれている様子でお願いいたします。可能でしたら、連行を見る民衆も入れて頂けたら嬉しいです。\n\n猿轡は先生のお任せでお願いいたします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hachitomato/works/200", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1178698, "client_id": 1674369, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec8e4112/uploads/origins/8510a93a-4758-40b4-96a6-cda503785dec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ada37913c180df748e6d7f97f0c72fa", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec8e4112/uploads/origins/8510a93a-4758-40b4-96a6-cda503785dec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a25b233753551891188a42e251b664ba", "src_set": ""}, "body": "八雲銀次郎様\n\nまた、前回と同じようなリクエストで恐縮ですが、\n御城プロジェクトREから立花山城をお願いします。\n\n以下をお願いします。\n・豆絞り手拭いの噛ませ猿轡と竹轡の2種類の猿轡\n・大きな胸を強調するように縄で厳しく後ろ手緊縛\n・脚も揃えて緊縛\n・涙を流しながらも気丈にこちらを睨むような表情\n・服の胸部分が破け素肌と胸が露出してしまっている差分と頬を赤らめている表情\n\nご検討いただけたら幸いです。\nどうかよろしくお願いします。\n\nhttps://drive.google.com/file/d/13ATCUtvsuhVeUIcdT7OXsEg3Ya1schfL/view?usp=sharing", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hachitomato/works/199", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0fc2d94c/uploads/origins/31b39862-8485-4579-8f63-8abdfba20452?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b338fa5e65d4be5003a904c1e6057cc7", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1178698, "client_id": 1430645, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hachitomato/works/198", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/26f338fb/uploads/origins/543a6c8e-5362-49d3-80cf-1b54f309e6d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d50fa8751794cd935dc60efba6ed54a0", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1178698, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hachitomato/works/197", "pr