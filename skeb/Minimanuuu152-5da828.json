。\n\nPSDデータ、もしくは人物と背景のレイヤー分けがされたPNGにて納品いただけると幸いです。\n\n以上、ご検討のほどよろしくお願いいたします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Minimanuuu152/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4066335, "client_id": 3653448, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d73b0900/uploads/origins/2e8afebb-2ef4-4fb0-9457-1e69fe1cad79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ded3758442a519d9f4d2e040b8300279", "srcset": "https://si.imgix.net/d73b0900/uploads/origins/2e8afebb-2ef4-4fb0-9457-1e69fe1cad79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ded3758442a519d9f4d2e040b8300279, https://si.imgix.net/d73b0900/uploads/origins/2e8afebb-2ef4-4fb0-9457-1e69fe1cad79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2efa9838ca4358455e19735608836a33 2x, https://si.imgix.net/d73b0900/uploads/origins/2e8afebb-2ef4-4fb0-9457-1e69fe1cad79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abb3d38f47837ad4d53b77cc88346890 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d73b0900/uploads/origins/2e8afebb-2ef4-4fb0-9457-1e69fe1cad79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5f06cf06f54a02b79890d8cf6ef101a", "srcset": "https://si.imgix.net/d73b0900/uploads/origins/2e8afebb-2ef4-4fb0-9457-1e69fe1cad79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5f06cf06f54a02b79890d8cf6ef101a, https://si.imgix.net/d73b0900/uploads/origins/2e8afebb-2ef4-4fb0-9457-1e69fe1cad79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4990143ce5c1128497c84257b5d65c16 2x, https://si.imgix.net/d73b0900/uploads/origins/2e8afebb-2ef4-4fb0-9457-1e69fe1cad79?bg=%23fff&auto=format%2