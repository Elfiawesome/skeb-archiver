fit=crop&crop=top&w=200&h=200&blur=200&s=f0a2c91c097de42b63d768f9eb4235da, https://si.imgix.net/4a928bc9/uploads/origins/acd29352-1b72-4f2c-a2f5-e0eae2efa350?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=98e6de19f74557098cd7ca498f71dee6 2x, https://si.imgix.net/4a928bc9/uploads/origins/acd29352-1b72-4f2c-a2f5-e0eae2efa350?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3c1240cbd4ae7c6096c9ecb4683659ac 3x"}, "body": "こんにちは。前回描いてくださったイラスト、本当にありがとうございました！とても気に入りました。もしよろしければ、私のオリジナルキャラクターをもう一人描いていただけないでしょうか？その子も、お好きなように描いていただければ嬉しいです。よろしくお願いします！\n\n参考画像 - https://drive.google.com/file/d/1TbrnqfQBeJOAHYtFpFIw1w3RvWGtIpTA/view?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kanisnd/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3422531, "client_id": 3627340, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15ceb3db/uploads/origins/2c8086e4-a570-4da0-88d8-f96d300c3554?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47a8a93612aebb6f5a9b1e3c5e8257b3", "srcset": "https://si.imgix.net/15ceb3db/uploads/origins/2c8086e4-a570-4da0-88d8-f96d300c3554?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47a8a93612aebb6f5a9b1e3c5e8257b3, https://si.imgix.net/15ceb3db/uploads/origins/2c8086e4-a570-4da0-88d8-f96d300c3554?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a903b32b4797af495f385ea7bc9bdfd7 2x, https://si.imgix.net/15ceb3db/uploads/origins/2c8086e4-a570-4da0-88d8-f96d300c3554?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb752201aece29a35f388da7e8458b38 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15ceb3db/uploads/origins/2c8086e4-a570-4da0-88d8-f96d300c3554?bg=%