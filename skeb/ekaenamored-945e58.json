のocを描いてもらえたら超感謝です。❤️\n\n私のocは角と長い巻き毛を持った人間ではない女の子です。彼女の存在は人間の痛みに基づいている。テーマは「血と肉の花」「痛み」「心の虜」。自由に描いてください！また、服装はシンプルな方がいいなら、調整しても構いません。\n\n彼女の詳しい外見は添付のリンクにあります。\n\nこのリクエストを読んでいただき、本当にありがとうございます。\n\nhttps://drive.google.com/drive/folders/1WvCC84lpiVWahpDmlE5elardOUwiE2Zt", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ekaenamored/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1863331, "client_id": 326249, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fdd97fc6/uploads/origins/6a31335b-355f-40f2-b41a-01e433497ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5173c8d4e043943c1687090984063d5e", "srcset": "https://si.imgix.net/fdd97fc6/uploads/origins/6a31335b-355f-40f2-b41a-01e433497ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5173c8d4e043943c1687090984063d5e, https://si.imgix.net/fdd97fc6/uploads/origins/6a31335b-355f-40f2-b41a-01e433497ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8612146452fbdd2811aa9b459711386e 2x, https://si.imgix.net/fdd97fc6/uploads/origins/6a31335b-355f-40f2-b41a-01e433497ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=222279f307fca5078f5f032feed40de8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fdd97fc6/uploads/origins/6a31335b-355f-40f2-b41a-01e433497ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1176c52f5ef36be9c12342eca4d543c7", "srcset": "https://si.imgix.net/fdd97fc6/uploads/origins/6a31335b-355f-40f2-b41a-01e433497ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1176c52f5ef36be9c12342eca4d543c7, https://si.imgix.net/fdd97fc6/uploads/origins/6a31335b-355f-40f2-b41a-01e433497ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=