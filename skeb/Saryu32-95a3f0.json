ー:沙流さんの、のじゃ神様  \n描いて欲しいシチュ:チンカスお掃除耳姦、浴尿   \n\nIF的な感じで、長年連れ添い丸くなって絆されて屈服したのじゃ神様が、ちょっとツンツンしながらも嬉しそうにマーキングされる感じでお願いします。 \n のじゃ神様は出来ればボテ腹で今まで産んだり堕したりした数がわかるマークがお腹に刻まれていると嬉しいです。 \nまた女の子が気持ち良さそうにしているのが好きなので、耳姦でのじゃ神様が深イキアクメをキメていると嬉しいです。  \n\n構図やその他記載していないことは沙流さんにおまかせします。 もっとこうした方がエッチでいい感じになると思った所があれば変更していただいても大丈夫です。  \n\n電子本楽しみにしております！\nまた近々リクエストさせていただきたいと考えておりますので、その際にもよろしくお願い致します。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Saryu32/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/edd40ad7/uploads/origins/964e4e29-e50e-44d9-aed9-3beb2a25de3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a9193eef20fb7704b6fd772d027f770", "srcset": "https://si.imgix.net/edd40ad7/uploads/origins/964e4e29-e50e-44d9-aed9-3beb2a25de3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a9193eef20fb7704b6fd772d027f770, https://si.imgix.net/edd40ad7/uploads/origins/964e4e29-e50e-44d9-aed9-3beb2a25de3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1dc411cf363fc5de744964ee12788d1 2x, https://si.imgix.net/edd40ad7/uploads/origins/964e4e29-e50e-44d9-aed9-3beb2a25de3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f07550cb9afccc7f7fa225f62104d7d 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 580312, "nc": 162}, {"path": "/@Saryu32/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2e148ad2/uploads/origins/ff57740e-ffbb-4a93-9515-547c0a0d5776?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=to