=30&txt=PRIVATE&s=78d052695f4caadda090419c38f4c259 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 580312, "nc": 48}, {"path": "/@Saryu32/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 580312, "client_id": 25356, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63ab5bcc/uploads/origins/da7ab752-4fe4-4662-9a36-583169e38a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eef0ebe8b9e23dcbb28764adab787f30", "srcset": "https://si.imgix.net/63ab5bcc/uploads/origins/da7ab752-4fe4-4662-9a36-583169e38a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eef0ebe8b9e23dcbb28764adab787f30, https://si.imgix.net/63ab5bcc/uploads/origins/da7ab752-4fe4-4662-9a36-583169e38a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ebd02425d0ec2b8fd33bdd655bc42ac 2x, https://si.imgix.net/63ab5bcc/uploads/origins/da7ab752-4fe4-4662-9a36-583169e38a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c44680bb23e5d76fcb2cf57328ca363 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63ab5bcc/uploads/origins/da7ab752-4fe4-4662-9a36-583169e38a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1be37e9899a30063c9988fe6baab8ed7", "srcset": "https://si.imgix.net/63ab5bcc/uploads/origins/da7ab752-4fe4-4662-9a36-583169e38a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1be37e9899a30063c9988fe6baab8ed7, https://si.imgix.net/63ab5bcc/uploads/origins/da7ab752-4fe4-4662-9a36-583169e38a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=696dd9479db01770d81c136bf87670da 2x, https://si.imgix.net/63ab5bcc/uploads/origins/da7ab752-4fe4-4662-9a36-583169e38a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c28a4eab57b4f61d70e6c7ea98f950fd 3x"}, "body": "はじめまして。今泉影狼（幼少期）の子宮脱＆イキ地獄を漫画２Ｐでお願いします。\n\nシチュ：人里でイタズラして捕まり調教される影狼。すでに２週間以上毎日強制絶頂調教され、現在は子宮だけでアクメ出来るよう子宮責め中心。\n・調教師　影狼の倍近い体格、快楽拷問が得意。絶頂する影狼をえらいぞ～と幼児をあやすように褒める。幼女の絶頂姿が好物。\n・影狼（描ける範囲で思いっきり女児化）\n脱走を諦め調教を受け入れているが絶頂に慣れていない。食事に催淫剤を混ぜられ強制発情。\nイキやすい体質ですぐ絶頂＆潮吹き。連続絶頂が苦手ですごく嫌がる。絶頂時はイク宣言するよう調教済。\n\n希望流れ（台詞改変可）喘ぎ声は♡大量\n１頁（２小さめ、１，３大きく）\n１．いつもの衣装。立ったまま股間と乳首が見えるよう服はだけ。子宮脱を男が鷲掴み乳搾りのようにマッサージ。ハート目トロ顔で子宮汁垂らし。\n２．子宮責め電動バイブ見せつけ。（手持ちの電動ドリルみたいな形状）ひっそれやだっと怯え顔の影狼。\n３．床に仰向けあるいは座らせてバイブを深く挿入＆起動、子宮内でイボイボ高速回転。\n（参考)https://www.pixiv.net/artworks/30783059\n意識飛びかけ（目に横線）ハート目で涙や涎大量。必死にイキ叫び（イクッ♡あ゛～～ッ♡イクううう♡♡）、激しく潮吹き。（構図的に可能なら片手で首締め、次コマでも可）\n\n２頁（２，３小さめ、４，１大きく）\n１．数時間後、仰向けorうつ伏せでバイブ引き抜き。伸びた子宮。\n意識朦朧ハート目、涎を垂らすか泡を吹きぼんやり口を開け舌を出したトロ顔。＊今回は気絶せずにちゃんとイケたね\n２．久々にアレやろうか、と強制アクメ電気椅子を指差し。影狼の絶望顔。（表情優先で椅子省略可）\n３．椅子に座らされ手足拘束。子宮脱、クリと乳首、太ももや下腹部など身体中に電気パッド。＊子宮の設定一番強くしてあげる、可愛いアクメ顔見せてね\nやだやだゆるしてと泣きじゃくり命乞い。（初めて捕まった時に数日間アクメ漬けにされた）\n４．最強設定の強制絶頂電流を全身通電。目を大きく見開きハート目、舌出し。涙、涎、鼻水（か鼻血）\n痙攣と大量潮吹き。椅子などびしょ濡れ。もうイっでる♡、イギだぐない♡、イグイグイグ♡♡、～～ッッ♡♡\n\n椅子参考\nhttps://skeb.jp/@nikusyo/works/2\n\nhttps://skeb.jp/@nikusyo/works/17", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Saryu32/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 580312, "client_id": 427649, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5fb2cc5f/uploads/origins/7881bc76-deb7-4bd2-a8a4-cd99976797d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d6840e4280abb3c779afbddba00aae2", "srcset": "https://si.imgix.net/5fb2cc5f/uploads/origins/7881bc76-deb7-4bd2-a8a4-cd99976797d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d6840e4280abb3c779afbddba00aae2, https://si.imgix.net/5fb2cc5f/uploads/origins/7881bc76-deb7-4bd2-a8a4-cd99976797d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&