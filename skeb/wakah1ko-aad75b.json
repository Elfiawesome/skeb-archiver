b9/uploads/origins/deea028d-b71b-4393-bfd9-cc63f319649a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d3f5257b221aad26dae2da4b7bc719f, https://si.imgix.net/ed302bb9/uploads/origins/deea028d-b71b-4393-bfd9-cc63f319649a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=581f6d53f30517a5eea4b6ac2a65f1c0 2x, https://si.imgix.net/ed302bb9/uploads/origins/deea028d-b71b-4393-bfd9-cc63f319649a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=839ade179988c77c4dae8d4d80c07e91 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed302bb9/uploads/origins/deea028d-b71b-4393-bfd9-cc63f319649a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ed74cafa0e2e68fbaea692b8876079a", "srcset": "https://si.imgix.net/ed302bb9/uploads/origins/deea028d-b71b-4393-bfd9-cc63f319649a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ed74cafa0e2e68fbaea692b8876079a, https://si.imgix.net/ed302bb9/uploads/origins/deea028d-b71b-4393-bfd9-cc63f319649a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=71dd43a2741ea91229db648591f2ea88 2x, https://si.imgix.net/ed302bb9/uploads/origins/deea028d-b71b-4393-bfd9-cc63f319649a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1173814338aa03d1941574f1d9b90f6c 3x"}, "body": "「俺んとこのシマ荒らしてたのってお前？」\n大きくて高そうな椅子に腰掛ける、素人目から見てもわかる高級なスーツに身を包んだそいつはココアシガレットを咥えながらそう言った。\n声だけ聴くと女性のようだが見た目は中性的でよくわからない。わかるのはただ目も眩むような美形だという事だけだ。\n「お母様、この場で首を落としましょうか？」\n右側に立っている黒い軍服のような衣装に身を包んだ冷たい眼をした少女が、腰の刀に手を掛けながら言った。こちらもまた恐ろしいぐらいの美形で、左右で色の違う髪と眼が更に美しさを際立たせていた。\n「え〜？あむちゃんどうせならコイツが爆発するのが見たいな〜」\n左側にいた先程の少女と同じ顔をした、白い中華風の衣装に身を包んだ少女は眼を輝かせながら笑った。見た者を虜にしてしまうような眩しい笑顔とおへそをしていた。…言葉は物騒だが。\n今私の胸が高鳴っているのは美しいものを目の前にした興奮なのか、これから起こる事への恐怖なのか私には判断がつかなかった。\n\n\nって感じのイラストをお願いします。\n真ん中に椅子に座ってるスーツ姿のワカ様ココアシガレット持ち（タバコではない）、右側に黒衣装あむちゃん（背中の大剣なしver）で左手で刀に手を掛けてﾁｬｷってしている状態。表情はキリッとしていながらむすっとしているような無表情（アイドルマスターの白雪千夜みたいな感じ）、左側にチャイナ衣装あむちゃん（槍は無し）でメスガキっぽい感じの笑顔のギザ歯で、左右のあむちゃんはそれぞれ体を斜め前にしてる感じでお願いします。全体的にダークで妖しい雰囲気でお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wakah1ko/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ccb486f1/uploads/origins/895a8207-fbb7-4d11-be94-aef89ea88e92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d50438b3c4a308994dcdf16e0ef5d001", "srcset": "https://si.imgix.net/ccb486f1/uploads/origins/895a8207-fbb7-4d11-be94-aef89ea88e92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d50438b3c4a308994dcdf16e0ef5d001, https://si.imgix.net/ccb486f1/uploads/origins/895a8207-fbb7-4d11-be94-aef89ea88e92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0bd3f068ed7b433207280175154fae1 2x, https://si.imgix.net/ccb486f1/uploads/origins/895a8207-fbb7-4d11-be94-aef89ea88e92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d9efd443e17058a2a57299d0a8d578f4 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1638713, "client_id": 2574953, "nc": 145}, {"path": "/@wakah1ko/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1638713, "client_id": 2556458, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4690b41/uploads/origins/dd6fbbe9-9ebc-487b-8bbb-647051f04261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c79888