045-d506-43d3-a1e2-a785c57a8e22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=799a170d24fcb1d1b5defe4b6fcfa1ca", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a05c10ee/uploads/origins/3b815045-d506-43d3-a1e2-a785c57a8e22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc39ac93638e6becc76a1a9ff52fe333", "src_set": ""}, "body": "リクエスト失礼します。\n\n食蜂操祈(とあるシリーズ)のイラストをお願いします。\n\nシチュ:リモコンのボタンを押すと気持ちよくなるという暗示を入れられた上に、乳首を押せば絶頂するなど体をリモコン(色々な部位をボタン)と認識するように改変される。\n\n細かい部分は改変してもらって構いません。\nよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@saimin_sushi/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1294190, "client_id": 1559531, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f04a920/uploads/origins/f45effb3-6a3c-4bb5-949c-435b34a541fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf40a0fe3f924ceb365585781da3188f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f04a920/uploads/origins/f45effb3-6a3c-4bb5-949c-435b34a541fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e71b38412848ed477539876b5a9a1bab", "src_set": ""}, "body": "リクエストさせていただきます！\n\nキャラクター　ONE PIECEのビビ\n\n流れ\n\n近海の街に買い物に出たビビ\n王女だとバレないように変装して街を歩いている\n突然ガラの悪い男達に囲まれる\nバロックワークスの残党だった\n逃げようとするが１人が能力者で催眠術をかけられる。\n復讐ということで男達に好き放題されるビビ\n最終的にバックで犯されつつ周りの男達にぶっかけられる\n\nセリフはお任せします！\n流れもイメージなので変えてもらっても問題ないです。\n\nプレイとしては放尿やバックを希望します。\n\n服装は下記のリンクのものでお願いします！\n\nhttps://images.app.goo.gl/KCpCy7NjJrkqcJdJ7\n\nhttps://images.app.goo.gl/7faB547pK7WzgECw7\n\nよろしくお願い致します！", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@saimin_sushi/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1294190, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ee8f367/uploads/origins/c119ff52-c5c4-4697-98db-c3ae19c935ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7370fa35ee08da904d0a903f58e7ba96", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ee8f367/uploads/origins/c119ff52-c5c4-4697-98db-c3ae19c935ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7afea92f718fce193d53f2b20cc4d6ad", "src_set": ""}, "body": "リクエスト失礼します。\n\n呪術廻戦より釘崎野薔薇のイラストをお願いします。\n\nシチュとしては、術式の特訓をする事になり、釘を打つ音を意識していくにつれて深い催眠にかかっていく...みたいなイメージでお願いしたいです。\n\nご検討頂けたら幸いです。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@saimin_sushi/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1294190, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/633eef22/uploads/origins/04e2675e-e3c3-4f2e-a605-375742cf60dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=421b10053cc987684ad91950ef122ac3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/633eef22/uploads/origins/04e2675e-e3c3-4f2e-a605-375742cf60dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e70831b53f13c71c8e90e3e179920187", "src_set": ""}, "body": "リクエスト失礼します。\n催眠遊戯より、鵡川流衣のイラストをお願いしたいです。\nシチュについては、ひぷの寿司さんの好きなように描いて頂けたらと思います。\nご検討よろしくお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@saimin_sushi/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1294190, "client_id": 1559531, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63bdc2dc/uploads/origins/d678ed32-3493-437f-9d63-353178c52a56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=457872465799dc8733c7a50e64a58d42", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63bdc2dc/uploads/origins/d678ed32-3493-437f-9d63-353178c52a56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3083a619e06066c116af7085b91fe6b7", "src_set": ""}, "body": "何回もリクエストして申し訳ないです。\n描いてほしいキャラが多いことをお許しください。\n今回のリクエストは承認されてもキャンセルされてもこれで最後にします。\n\nキャラクター遊戯王アークファイブのセレナ\n\n仲間たちとはぐれ探していると突然頭に声が聞こえる。※１\n意識が薄れ目から光が消える。\nその声に従い声のする方に向かう。\n進んだ先には大きなパラサイトフュージョナーがいる。\nしかし、特にリアクションすることもなくその場に立っている。\nするとパラサイトフュージョナーの目が赤く発光し、その瞬間、一瞬にして絶頂するほどの快楽が襲ってくる。\n一旦落ち浮いたのも束の間、次はパラサイトフュージョナーが触手を伸ばし身体をまさぐる。\n頭に声が聞こえ、その声に答えるように自分でパンツをずらし陰部に挿入するよう懇願する。※２\n陰部を激しくつかれて絶頂。\n絶頂後、陰部から出た触手は耳から脳に侵入し直接脳を弄る。\n激しい喘ぎ声と共にお漏らし。\n虚ろな表情のまま頭に響く言葉を復唱して終わり。※３\n\nこのような流れお願い出来ませんでしょうか。\n\n流れは改編してもらって構いません。\n\n下記にパラサイトフュージョナーのセリフのイメージを描きますので参考にお願い致します。\n※１　こっちに来い。\n※２　再び快楽を与える。どこに欲しいのか答えよ。\n※３　仲間を増やすのだ。\n\n服装\nhttps://www.pinterest.jp/pin/758434393483149566/\n\nもしセレナでピンと来なければ同じシチュエーションでキャラクターを柊柚子にしていただきたいです。\n\nご検討よろしくお願い致します。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@saimin_sushi/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1294190, "client_id": 1559531, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55454ea4/uploads/origins/d18cd36f-6fa1-4bfb-b19c-34e7e1704048?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7305c266234e0908fc0d907c831ccbc8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55454ea4/uploads/origins/d18cd36f-6fa1-4bfb-b19c-34e7e1704048?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aec3c3adde814cbe7cb70ef666b6f1a4", "src_set": ""}, "body": "無際限のファントムペインの川神舞でお願いしたいです。\n\n１人で下校途中に目の前にファントムが現れる。\n１人で退治しようとした瞬間、ファントムが放つ特殊な超音波によって思考が停止する。\n虚ろな表情で棒立ちしている舞の頭に直接命令が飛び、それを受信した舞は応答する。\nその後、舞は一時的に解放される。(ファントムとあった記憶は消されている。)\n次の日下校のチャイムを聞いた舞の頭に昨日の命令が暗示として発動する。\n声に呼び出されて向かった先にいたファントムの命令に従って舞は羞恥プレイ(がに股オナニーやお漏らし等)をさせられる。\nプレイ後、明日もまた同じ時間に来るように暗示をかけられる。\n\n終わり\n\n服装については制服でお願いします。(黄色のベストのものでも夏服？でも構いません。)\nシチュエーションはイメージなので全然変えてもらっても問題ありません。\nファントムを触手が使えるモンスターのようなものにして直接犯すパターンでも問題ありません。\n欲しいシチュエーションとしては洗脳されるが１度解除されて特定のトリガーによって再度洗脳されるという流れと舞に普段は絶対にやらないであろう発言とプレイをさせてほしいです！\n\nご検討よろしくお願い致します。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@saimin_sushi/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1294190, "client_id": 1038658, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df1ac6f7/uploads/origins/65d6ff0a-3a8c-41dc-adfe-ea82dbab6f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=458b3bad8e5a9819150248d375724b31", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df1ac6f7/uploads/origins/65d6ff0a-3a8c-41dc-adfe-ea82dbab6f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b281e5ae95b3e231ecd566fc7df06a71", "src_set": ""}, "body": "初めまして、シャイニング・ブレイドのサクヤ(女教師)の催眠絵をお願いします。\n\nキャラ：シャイニング・ブレイドのサクヤ(女教師)\n参考:https://imgur.com/a/CcZezPp\n\n細かい構図はお任せ致します。\nよろしくお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@saimin_sushi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1294190, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a1d83c8/uploads/origins/bdb6f14c-7df2-479c-acd1-6029e6fc289f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f34b48139174052f7a1fb1fe51af598a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a1d83c8/uploads/origins/bdb6f14c-7df2-479c-acd1-6029e6fc289f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b84cd3c24ea9aa0a85b171428141342d", "src_set": ""}, "body": "再送失礼します。\nリクエスト内容が面白いとの事で、とても嬉しく思い、つい欲が出てしまいました。\nキャラ:ひぷの寿司さんの描いてみたい、リクエスト内容に適応できそうな人物\nシチュ:家庭科の補習など(描きやすい導入でお願いします)により食材と共にキャラクターの意識も料理され、包丁の音、煮込む音などによりどんどん催眠の世界へ入り込んでいく(催眠を味わっていく)よう調教されて行く。\n上記ような内容でお願いできないでしょうか。\nもう一度ご検討いただければ幸いです。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@saimin_sushi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1294190, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23391d47/uploads/origins/ae552cff-878c-4cb3-8f41-1a9eca9c6f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd84e8b62048a90c10f65de6074bc6fb", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23391d47/uploads/origins/ae552cff-878c-4cb3-8f41-1a9eca9c6f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20fdd8254254059655a41be50afc6d68", "src_set": ""}, "body": "まだ募集しているということなのでシンフォギアの暁切歌をお願いします。\n訓練ということで呼ばれキーワード１つで頭が空っぽな人形になりよだれ、お漏らしをするような展開をお願い致します。\nセリフの希望は特にありませんが何者かに操られて普通じゃない感じであれば嬉しいです。\n\n服装はリンクを貼っておきますのでよろしくお願い致します。\n参考のものでなくても全然構いませんが制服以外でお願いしたいです。\nよろしくお願い致します。\n\n参考１\nhttps://www.suruga-ya.jp/database/pics_light/game/985016500.jpg\n参考２\nhttps://www.google.com/imgres?imgurl=https%3A%2F%2Fwww.symphogear-axz.com%2Fcharacters%2Fimg%2Fkirika.png&imgrefurl=https%3A%2F%2Fwww.symphogear-axz.com%2Fc