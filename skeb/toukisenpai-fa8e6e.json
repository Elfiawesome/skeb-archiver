6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0415db7ce08d14b96dae50b35c68bf06, https://si.imgix.net/70df2e8b/uploads/origins/f4372318-73bc-4d4b-9dc0-27fcdb42046c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63d4d5e0ac74783828bb9fb50ac547a9 2x, https://si.imgix.net/70df2e8b/uploads/origins/f4372318-73bc-4d4b-9dc0-27fcdb42046c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7613a98dd6226c64845827a134cd3ae9 3x"}, "body": "かづちI様\nたまたまイラストお見かけし、デフォルメイラストの可愛らしさに一目惚れしました！ぜひ私の代理キャラクターと、お友達の小さな生き物を描いていただけないでしょうか。\n\n◆使用用途\n個人鑑賞/個人利用のみのアクリルグッズ作成\nTRPGセッションでのKPコマとしての使用\n\n：キャラクターについて：\n◆代理/オオカミの半獣人の女の子\n・オオカミ×星×月モチーフの少女\n・おっとり穏やか、感情豊か。好奇心旺盛で不思議な本を片手に様々な物語を巡っている。\n・尻尾も髪も耳もふわふわ。お供の子供オオカミと白いいきものを可愛がっている。\n\n◆白い二匹のいきもの\n・気づいたら女の子と白オオカミの頭の上に乗っていた。手のひらサイズ。\n・跳ねたり肩の上で寝ていたり転がっていたりと気まぐれ。\n・オオカミのなかま…？しろくてふわふわ。\n2匹でそれぞれ気まぐれ。仲良しなはずです。解釈もお任せいたします！自由に描いていただけたら嬉しいです。\n\n：補足用\n◆お供の白い子供のオオカミ\n・食いしん坊の子供オオカミ。お腹が空いているところを拾われた。\n・好奇心旺盛。とっても頑張ったら人間の姿（子供）になれる。\n・女の子のことが大好き、守ってあげられるようになりたい\n\n◆ほか\n衣装を複数入れております。指定してよろしければ最新のサイバー衣装でお願いいたします！他の衣装で気がむくものがあれば、そちらでも大丈夫です！（性転換の少年姿でも嬉しいです、お好きなものを選んでください）\nまたこちらはもし可能であればで大丈夫ですが、TRPGセッションでKPコマとして代理といきものちゃんを分けてコマを作りたいため、個別の背景透過画像もあると本当に嬉しいです！難しければご放念ください。\n\nぜひご縁をいただけたら嬉しいです！ご検討何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ISEil5J2CmR3NKFxoLZ-5nQbz5xF8mOy?usp=share_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toukisenpai/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3889551, "client_id": 3084624, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2385cf87/uploads/origins/6f1e2ccc-b02c-4623-b9be-1fe32fa0a6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b22aa1cb36337e7cf107b8082751d4c7", "srcset": "https://si.imgix.net/2385cf87/uploads/origins/6f1e2ccc-b02c-4623-b9be-1fe32fa0a6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b22aa1cb36337e7cf107b8082751d4c7, https://si.imgix.net/2385cf87/uploads/origins/6f1e2ccc-b02c-4623-b9be-1fe32fa0a6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6a8f811c6c0041cbc851661d40940ce 2x, https://si.imgix.net/2385cf87/uploads/origins/6f1e2ccc-b02c-4623-b9be-1fe32fa0a6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=094a78f586591a4777cfd8f8d2de2195 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2385cf87/uploads/origins/6f1e2ccc-b02c-4623-b9be-1fe32fa0a6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f95ab0dacb5f5652026bd609aa7bab16", "srcset": "https://si.imgix.net/2385cf87/uploads/origins/6f1e2ccc-b02c-4623-b9be-1fe32fa0a6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f95ab0dacb5f5652026bd609aa7bab16, https://si.imgix.net/2385cf87/uploads/origins/6f1e2ccc-b02c-4623-b9be-1fe32fa0a6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ef6f98d041757fde39553169ffba7a50 2x, https://si.imgix.net/2385cf87/uploads/origins/6f1e2ccc-b02c-4623-b9be-1fe32fa0a6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0499a8b468b218ad059a39bcbd9119cc 3x"}, "body": "かづちII先生、こんにちは。\nSkebで先生の作品を拝見し、画風がとても素敵で惹かれました。ぜひ私のOCの二人イラストをお願いしたく、リクエストをお送りいたしました。どうぞよろしくお願いいたします。\n\nキャラクター設定はリンク先をご参照ください。\n物語の概要としては、アンチヒーロー気質の主人公と、飄々とした悪役ボスの関係性を描いた作品です。\n世界観は近未来の終末世界。ある組織が宇宙の真実を探るため、土星の衛星タイタンへ向かう飛行船を建造しようとしています。主人公は大切な人を救うため、その反派組織の幹部となります。\n\n■ 黒髪・青い瞳の女性\nエヴレン・シュヴァルツ（Evren Schwarz）\n主人公。優雅で余裕のある印象を与える完璧主義者。元ハッカーであり、優れた頭脳と情報技術能力を持っています。\n\n■ 猫耳の女性\n音無 久未（おとなし くみ）\n反派組織のリーダー。飄々とした雰囲気ですが、実際は非常に聡明で話術に長け、強い情報収集能力を持っています。\n\nこの二人のイラストをお願いできれば嬉しいです。\n物語の要素やご興味のあるシーンなど、先生のご自由な解釈で描いていただけましたら幸いです。\n\nどうぞよろしくお願いいたします。\n\n【使用目的】\n完全に非商用、個人使用のみです。\nSNSのアイコンやヘッダーなどに使用させていただく可能性があります。\nまた、ポストカード等のグッズを個人的に印刷し、無償で友人（10人以内）に配布することがあるかもしれません。\n\nここまで読んでくださりありがとうございます。複雑な依頼かと思いますが、ご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1YQvFNmQZ2-UPJ60UOuOR2E2smLLsc99u?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toukisenpai/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3889551, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6661c6b7/uploads/origins/6dc27c6d-b335-434b-b32d-29660887e345?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e861af62d8c3839163ac6725934b737", "srcset": "https://si.imgix.net/6661c6b7/uploads/origins/6dc27c6d-b335-434b-b32d-29660887e345?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e861af62d8c3839163ac6725934b737, https://si.imgix.net/6661c6b7/uploads/origins/6dc27c6d-b335-434b-b32d-29660887e345?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2c093f0e01918fce5a82b3f1f6a6b00 2x, https://si.imgix.net/6661c6b7/uploads/origins/6dc27c6d-b335-434b-b32d-29660887e345?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=419cf7d14bb1efb112eb37367007612b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6661c6b7/uploads/origins/6dc27c6d-b335-434b-b32d-29660887e345?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=229491e46ba12f11e36171aa7bf9467d", "srcset": "https://si.imgix.net/6661c6b7/uploads/origins/6dc27c6d-b335-434b-b32d-29660887e345?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=229491e46ba12f11e36171aa7bf9467d, https://si.imgix.net/6661c6b7/uploads/origins/6dc27c6d-b335-434b-b32d-29660887e345?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&