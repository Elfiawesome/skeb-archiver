に声を上げようとした瞬間、口にも魔物の舌が挿入される\n押さえこまれ上と下の口を蹂躙されるカエデ、ゆっくりと魔力を吸われていく\n何十回もの絶頂ののち、舌が抜き取られる。魔力を根こそぎ奪われ疲労感と快楽でとろとろになってしまったカエデ\n\n・構図\n服はそのまま、胸にはかみ跡と唾液を残したままにしてください\n下半身は完全に脱がさず、ずらし挿入のような感じで\n口は魔物の頭がカエデの顔に覆いかぶさるようなディープキスのような感じで犯してください\n舌は魔物の唾液でどろどろ、行為後の抜き取られた舌は愛液やカエデの唾液でさらにどろどろにしてください\n抜き取られたとき、どろっと唾液が糸を引くのがすきなのでそんな感じの唾液の糸をお願いします。\n\nよろしくお願いいたします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 40450, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "姉崎🔞", "screen_name": "yuanei", "avatar_url": "https://pbs.twimg.com/profile_images/1986743400503422976/lCKsW4i3.jpg", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 7, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 43569, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "りよ☕️", "screen_name": "Liyocafe", "avatar_url": "https://pbs.twimg.com/profile_images/1910203683641647105/rB76lrWj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/969535290636361728/1761772775/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 161}, {"id": 1133106, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ドリアーヌ🔞skeb募集中！！", "screen_name": "DORIANE_DOJIN", "avatar_url": "https://pbs.twimg.com/profile_images/1208362086683697153/lA49q4Qu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1208361550190264320/1611111151/1500x500", "appeal_receivable": false, "popular_creator_rank": 14, "request_master_rank": null, "firs