ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e41fa5be7e9adddf5ecfd29f771201c, https://si.imgix.net/2209a123/uploads/origins/3e5c2c2c-f9a7-4e12-a73c-9bca092e3d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdfc0dab78bba08a8fc94a52c15fd431 2x, https://si.imgix.net/2209a123/uploads/origins/3e5c2c2c-f9a7-4e12-a73c-9bca092e3d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e136a6d04bde39ce9562ad5e5eb7ec4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2209a123/uploads/origins/3e5c2c2c-f9a7-4e12-a73c-9bca092e3d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5688b39009855fa3dd0c52c33d24e627", "srcset": "https://si.imgix.net/2209a123/uploads/origins/3e5c2c2c-f9a7-4e12-a73c-9bca092e3d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5688b39009855fa3dd0c52c33d24e627, https://si.imgix.net/2209a123/uploads/origins/3e5c2c2c-f9a7-4e12-a73c-9bca092e3d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa2606e998a9e6a1048b7db57191af91 2x, https://si.imgix.net/2209a123/uploads/origins/3e5c2c2c-f9a7-4e12-a73c-9bca092e3d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1056b9dc1941b89ce11fdcfb43a91a11 3x"}, "body": "いつも#ゆかロイド シリーズを含む創作物を楽しんで拝見させていただいています🙇‍♂️\n特に2/6に投稿されたゆかりさんスケッチや2/23に投稿された雫の雰囲気が大好きです……\n今回skebを開設されたということで、いつも妄想している概念をしぅクリーム様の絵柄で摂取したくリクエストさせていただきました。地雷であればスルーしてくださって構いません🙇‍♂️\n\n以下本文\n人:ボイスロイドの結月ゆかりと琴葉葵\n格好:ゆかりさん(緩く髪をまとめ、黒のキャミソールに紫のカーディガンを羽織り、太ももが見える丈のルームウェアのショートパンツを着ている)\n葵ちゃん(同じく髪をゆるくまとめ、ショートパンツが隠れる程の丈の薄水色のオーバーサイズのパーカーにショートパンツを着ている)\nシチュエーション:(設定:ゆかりさんのワンルームの部屋でお酒を飲んでいる)ほろ酔いで座っているゆかりさんの胸あたりにガチ酔いしている葵ちゃんがゆかりさーんって感じに軽く抱きつく。ゆかりさんがそれを見て微笑み頭を撫でる。\n\n以下可能であればお願いしたいこと\nゆかりさんのカーディガンは肘まで袖を通し、肩を出す\n葵ちゃんのオーバーサイズパーカーが少し捲れ、ショートパンツがみえる\n机か床に青のハイライトと紫のアメスピが置いてある\nお酒は缶チューハイ\n\n全体的な雰囲気ですが、大学生〜20代前半のラフで少し艶がある様などこか爛れた雰囲気でお願いします🙇‍♂️\n\n表記していない部分や表現についてはしぅクリーム様の絵柄で見たいという気持ちが強いので、お任せさせていただけたらと思います🙇‍♂️\n\n初めてskebを依頼させていただく為、情報が不十分だったり失礼があったらすみません。\nご検討よろしくお願いいたします🙇‍♂️", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@siuc9999/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1657404, "client_id": 818046, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4647616/uploads/origins/7b3a34a5-bdb2-4126-a2f5-83b4c70df473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc0728362c84725552d58eb7214cb4dd", "srcset": "https://si.imgix.net/a4647616/uploads/origins/7b3a34a5-bdb2-4126-a2f5-83b4c70df473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc0728362c84725552d58eb7214cb4dd, https://si.imgix.net/a4647616/uploads/origins/7b3a34a5-bdb2-4126-a2f5-83b4c70df473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=420ef460d4b7e8e0603d7e82b8bc5a38 2x, https://si.imgix.net/a4647616/uploads/origins/7b3a34a5-bdb2-4126-a2f5-83b4c70df473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c12a070357593f71bcba9f25c119955b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4647616/uploads/origins/7b3a34a5-bdb2-4126-a2f5-83b4c70df473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10b52b3d4e8fafe362f8e1d820c06e0c", "srcset": "https://si.imgix.net/a4647616/uploads/origins/7b3a34a5-bdb2-4126-a2f5-83b4c70df473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10b52b3d4e8fafe362f8e1d820c06e0c, https://si.imgix.net/a4647616/uploads/origins/7b3a34a5-bdb2-4126-a2f5-83b4c70df473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dc3b3ccaa0332abe151f15a827d6b474 