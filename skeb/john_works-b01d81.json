したい内容は、\nキャラクターごとに1枚ずつ、合計2枚のイラスト制作です。\n（※それぞれ別々のキャラクターで、1枚ずつお願いしたいです）\n\nどちらも 1920×1080以上・16:9比率で制作していただけますと幸いです。\n配信などでも使用させていただく予定です。\n① 1キャラクター（空色の髪のキャラクター）\n・下から見上げる構図、または横になっている構図\n・甲板の上のシーン\n・マリン服スタイルを維持\n・明るくて少しドジな性格が伝わるような表現にしていただけると嬉しいです\n\n② 2キャラクター（緑色の髪のキャラクター）\n・ベッドの上でうつ伏せに寝ているポーズ\n・顔がしっかり見える構図\n・けだるく、少し眠たげな雰囲気のキャラクターです\n\nお忙しいところ恐れ入りますが、ご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Nmbq5rU69eZahl5QxiTgvlugtIH_p7xq?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@john_works/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3926703, "client_id": 3316253, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3335e2b/uploads/origins/38dfe583-5fb5-4439-ae74-edfa0f68be41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5148f83e86317c443f65cfb40570b80", "srcset": "https://si.imgix.net/f3335e2b/uploads/origins/38dfe583-5fb5-4439-ae74-edfa0f68be41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5148f83e86317c443f65cfb40570b80, https://si.imgix.net/f3335e2b/uploads/origins/38dfe583-5fb5-4439-ae74-edfa0f68be41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a9861a85a06cea280ddcd147930b270 2x, https://si.imgix.net/f3335e2b/uploads/origins/38dfe583-5fb5-4439-ae74-edfa0f68be41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2629131ee23bb4ca9f8b2de3e01ec82a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3335e2b/uploads/origins/38dfe583-5fb5-4439-ae74-edfa0f68be41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2057ee991cccfc5c72429d7e56125ce3", "srcset": "https://si.imgix.net/f3335e2b/uploads/origins/38dfe583-5fb5-4439-ae74-edfa0f68be41?bg=%23fff&auto=format%2Ccompress&fm=w