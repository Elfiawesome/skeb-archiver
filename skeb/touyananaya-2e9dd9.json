レットは黒タイツのみ履かせたまま、ほかは全裸、タイツは若干のテカりを入れて、足先はゆびの形を若干残す様に描いてください、例の様に汗、精液と唾液も若干付けて欲しいです、陰毛は無し。全体的に描きやすいようにアレンジを加えて頂いて大丈夫です。表情は目を開けて感じてる表情と予算範囲であれば目を強くつぶってイッた状態で中出しされた差分を付けて頂けると嬉しいです。ご検討を宜しくお願いします。\n\n構図の例◆\nhttps://photos.app.goo.gl/S69tnAX1RmtSazM78\n\nクラレット★\nhttps://photos.app.goo.gl/BNDTQwZhdLvKxACn7", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@touyananaya/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 73518, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/27380b5b/uploads/origins/31957eba-7890-446d-ac15-36ffa30424a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77432aa9504bae8e3a4ee0909b9ed66d", "srcset": "https://si.imgix.net/27380b5b/uploads/origins/31957eba-7890-446d-ac15-36ffa30424a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77432aa9504bae8e3a4ee0909b9ed66d, https://si.imgix.net/27380b5b/uploads/origins/31957eba-7890-446d-ac15-36ffa30424a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f14eb0938067cd141f77ddab2b50e313 2x, https://si.imgix.net/27380b5b/uploads/origins/31957eba-7890-446d-ac15-36ffa30424a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=078f00e94a641934b7364f4e17568f98 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27380b5b/uploads/origins/31957eba-7890-446d-ac15-36ffa30424a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9166cac0532dba18d74225219c1d3ad2", "srcset": "https://si.imgix.net/27380b5b/uploads/origins/31957eba-7890-446d-ac15-36ffa30424a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9166cac0532dba18d74225219c1d3ad2, https://si.imgix.net/27380b5b/uploads/origins/31957eba-7890-446d-ac15-36ffa30424a3?bg=%23fff&auto=format%2Ccompress&