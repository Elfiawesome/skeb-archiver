66f451a0a75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e31fe31bfd6fa4bc1d685c3ed1b0ae1a", "srcset": "https://si.imgix.net/439ee2c0/uploads/origins/f5fb86f4-6942-47e1-b546-166f451a0a75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e31fe31bfd6fa4bc1d685c3ed1b0ae1a, https://si.imgix.net/439ee2c0/uploads/origins/f5fb86f4-6942-47e1-b546-166f451a0a75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c0005463422d3ae6b069290d3b47ab5 2x, https://si.imgix.net/439ee2c0/uploads/origins/f5fb86f4-6942-47e1-b546-166f451a0a75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ae2e1dc1c5f765de9cafe5cad72665c 3x"}, "body": "絵師先生へ こんにちは！先日ツイートされた新作デュオイラストを拝見しましたが、2022年10月28日に投稿された全身アートワークが素晴らしく、雰囲気も色彩も大好きなので、勝手ながら作品のリクエストを送らせていただきます。\n純白のフラワーウェディングドールで、レトロな雰囲気がかっこいいドール姉さんを描いてほしいのですが、設定例はこちらです。\nhttps://drive.google.com/file/d/1-4GrXja51uJCP_FXjKaBV2BazfG4zbO5/view?usp=drivesdk\nhttps://drive.google.com/file/d/1-5rqp0XFOOjgL7mlbmYEAP762aTuFEC3/view?usp=drivesdk\nヘアスタイルはリボンのついたハイポニーテール、瞳は薄い金色で、参考画像にそってお願いします。\nマッドハッターのティーパーティー、ウサギ、チェシャ猫、時計、夢のようなバラのつぼみなど、人形のお姉さんが不思議の国のアリスに落ちていくテーマのイラストを希望します。もし先生が他の要素も加えたいのであれば、それも大歓迎です。\n先生がいくら払ってくださるかわからないので、とりあえずこの値段で、キャラクターはふくらはぎ上までしか描けません。\nぜひお引き受けください！ありがとうございました！\n\nhttps://drive.google.com/file/d/1-4GrXja51uJCP_FXjKaBV2BazfG4zbO5/view?usp=drivesdk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mg___ng/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1499441, "client_id": 2201104, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a006f22/uploads/origins/b6533cb7-97b5-453a-b78e-0c840e220980?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e215e81ad863f88380ed15829b650d29", "srcset": "https://si.imgix.net/2a006f22/uploads/origins/b6533cb7-97b5-453a-b78e-0c840e220980?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e215e81ad863f88380ed15829b650d29, https://si.imgix.net/2a006f22/uploads/origins/b6533cb7-97b5-453a-b78e-0c840e220980?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9866cb40ff90ba28fe4b862a0d30537f 2x, https://si.imgix.net/2a006f22/uploads/origins/b6533cb7-97b5-453a-b78e-0c840e220980?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47a7b2851ea59cfa575515bf7a51be95 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a006f22/uploads/origins/b6533cb7-97b5-453a-b78e-0c840e220980?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfb99156a67a87f3b6203945bb4575a1", "srcset": "https://si.imgix.net/2a006f22/uploads/origins/b6533cb7-97b5-453a-b78e-0c840e220980?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfb99156a67a87f3b6203945bb4575a1, https://si.imgix.net/2a006f22/uploads/origins/b6533cb7-97b5-453a-b78e-0c840e220980?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c04a820b40bb17c8275e797d21bb091e 2x, https://si.imgix.net/2a006f22/uploads/origins/b6533cb7-97b5-453a-b78e-0c840e220980?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0274bb448dc7180f38584f9690aa5d4d 3x"}, "body": "はじめまして。\nTLでイラストを拝見し、素敵な絵柄だったのでskebリクエスト送らせて頂きました。\n描いて欲しいキャラは以下になります。\n参考画像はGoogleドライブから。\n\nキャラ1(金髪の女の方)\n名前: Arlie Carroll (アーリィ・キャロル)\n年齢:17歳\n職業:アンティークショップの店員\n性別:女\n身長:150cm\n性格:大人しめの良くも悪くも普通の女の子。年上の人には敬語。ラビのことは先生と呼んでいる。\n他:正面から見て右が青、左が緑のオッドアイ。リボンには三日月のマークがあります。\n\nキャラ2(白髪の男の方)\n名前: Rabbi White (ラビ・ホワイト)\n年齢:27歳\n職業:アンティークショップの店主\n性別:男\n身長:175cm\n性格:謎の多い感じ(？)。アーリィに対しては優しい。アーリィの事はアーリィくんと呼んでいる。\n他:片目はちょっと隠れてるけど一応見えてる感じで服はコートを肩にかけている。涙ボクロがあります。\n髪は1つに縛ってます。\n\n関係性:自作ゲーム『アンティーク・ワンダーランド』(ゲームの雰囲気は #アンティーク・ワンダーランド  で検索したら出てくるかと……！)の主人公2人です。記憶喪失の少女と謎の骨董屋の店主の2人です。\n\n構図等:お任せします。描きやすいように描いていただければ。ゲームが不思議の国のアリス＆鏡の国のアリスモチーフのゲームなので小物などでアリス要素を入れてくれたら嬉しいです。\n\n使用用途:Twitterに名前等を記載の上で上げさせて欲しいのと、ヘッダーまたはアイコンに使用させて欲しいです。また、今後ゲームが完成した際にサイトを作ることがあったらそこにお名前やアカウントを記載した上で載せさせて頂けたら嬉しいです。\n\nご縁がありましたらよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1dSDwsQIZ52IQQ7BRjgR5wAOFADkuPw55?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mg___ng/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1499441, "client_id": 2618136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/efb71a97/uploads/origins/646d9528-d46c-460b-b6b8-499cc50fabb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3c3ab72656b445ff71094d16f8f1d6b", "srcset": "https://si.imgix.net/efb71a97/uploads/origins/646d9528-d46c-460b-b6b8-499cc50fabb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3c3ab72656b445ff71094d16f8f1d6b, https://si.imgix.net/efb71a97/uploads/origins/646d9528-d46c-460b-b6b8-499cc50fabb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c82b56c723eec52881fec3c840681242 2x, https://si.imgix.net/efb71a97/uploads/origins/646d9528-d46c-460b-b6b8-499cc50fabb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=acaafd0536bf2c18f3d3737b7938c21a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/efb71a97/uploads/origins/646d9528-d46c-460b-b6b8-499cc50fabb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ebcd9d4c853889916174866e258f0c7", "srcset": "https://si.imgix.net/efb71a97/uploads/origins/646d9528-d46c-460b-b6b8-499cc50fabb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ebcd9d4c853889916174866e258f0c7, https://si.imgix.net/efb71a97/uploads/origins/646d9528-d46c-460b-b6b8-499cc50fabb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f251f046add7d0eaef8622de72430c03 2x, https://si.imgix.net/efb71a97/uploads/origins/646d9528-d46c-460b-b6b8-499cc50fabb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=34d505c43d775d288360bb2a13e8c2b4 3x"}, "body": "すし握りおじさん 様\n\n初めまして！白墨石と申します。\n素敵なイラストに一目惚れしました｡\nぜひ、ご依頼をさせていただきたいです！\n\nこのたびは、私の二人のオリジナルキャラクターのイラストを依頼したいと思います。\n※服飾は【設定画】のほうに添付しましたが、特に指定は無いので、服飾の簡略化や参考資料の他の服描いても構いません。\n\n▼【キャラクター設定】\n　描写していただきたいキャラクターは、中世の魔法世界での双子姉妹です。\n\n①赤黒：「紅蓮の魔女」（妹）\n・外見は17歳、ポーカーフェイスな銀髪赤眼の魔女。シスコン。動物好き。\n・幼い頃の記憶が封印され、森の中で育ち、生まれつきの強大な魔力で魔物に恐れられ、「森の魔女」が残した魔導書で魔法を覚えてきました。\n・元々は天真爛漫な性格で、16歳に森を出たところで信頼していた人間に裏切られ、王国軍に襲撃されていくうちに、性格が冷たい魔女になってしまいました。\n・火と攻撃型魔法が得意、魔法をかけると炎の蝶が飛び出します。\n\n②青紫：「月の聖女」（姉）\n・人々に慕われている【月の神殿】の聖女。\n・肌は非常に白く、珍しいアメジスト色の瞳と長い銀色の髪が特徴です。\n・ちょっと人見知りで、優しく少し天然で和む人です。\n・氷と治癒魔法が得意です。\n・魔法を使う時、瞳の色は金色に変わります。\n\n※ 2人の身長はほぼ同じです。（ちょっと高めの170センチ）\n\n▼【依頼補足】\n・構図はお任せ致します。\n・イラストの縦横、不明点や表情、背景、ポーズなどの解釈もお任せ致します。\n・リクエストの金額が足りない場合、遠慮なくご調整ください。\n・もし受けるのが難しいようであればキャンセルして頂いて全然構いません｡\n\nリクエスト内容に興味がありましたら、請けていただけると幸いです。\nご検討のほど宜しくお願いいたします。\n\nhttps://drive.google.com/drive/folders/18C-rRoYe0aolauQ_XqfyBemb4gMcFlvD", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mg___ng/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1499441, "client_id": 2776955, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37e2001a/uploads/origins/34fbf09b-76c3-4189-9df7-4ef30b927e07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e3588e923b37312a854986aca016d0a", "srcset": "https://si.imgix.net/37e2001a/uploads/origins/34fbf09b-76c3-4189-9df7-4ef30b927e07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e3588e923b37312a854986aca016d0a, https://si.imgix.net/37e2001a/uploads/origins/34fbf09b-76c3-4189-9df7-4ef30b927e07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91796bc4b2cf5f8d472d053a99b0273a 2x, https://si.imgix.net/37e2001a/uploads/origins/34fbf09b-76c3-4189-9df7-4ef30b927e07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0bd557de975d1668a8637799d0c93fd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37e2001a/uploads/origins/34fbf09b-76c3-4189-9df7-4ef30b927e07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b5245a28a605d32661e6c59a918298f", "srcset": "https://si.imgix.net/37e2001a/uploads/origins/34fbf09b-76c3-4189-9df7-4ef30b927e07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b5245a28a605d32661e6c59a918298f, https://si.imgix.net/37e2001a/uploads/origins/34fbf09b-76c3-4189-9df7-4ef30b927e07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6712dc9a6773e1f5a023bef794219292 2x, https://si.imgix.net/37e2001a/uploads/origins/34fbf09b-76c3-4189-9df7-4ef30b927e07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b0a64136a913b7261e92f93300736c4b 3x"}, "body": "初めまして、リクエスト失礼致します。 SNSでイラストを拝見させていただき、重厚で耽美な雰囲気にとても惹かれて是非イラストをお願いしたいと思いメッセージを送らせていただきました。  描いていただきたいのは自探索者のレティエルです。 彼女はイギリス出身で、今は1人で日本に来ているシスターです。 少し抜けている所があり言動はふわふわしていますが、芯がしっかりとありシスターたるもの人々に奉仕すべき、という精神で動いている善人です。  詳細なキャラデザを添付致しますので、ご確認いただけると幸いです。 服装等は描きやすいように変更していただいても結構です。  イラストの構図やポーズについてはお任せ致します。耽美な雰囲気の中に愛らしさがあるイメージのものを希望していますが、難しければどのような雰囲気のものでも問題ありません。 お忙しい中すみませんが、是非ご検討していただけるとありがたいです。\n\nhttps://www.dropbox.com/scl/fo/4q8bhvmzdfnro7eax7kic/h?rlkey=v0tqfkui2bxjvytp0a0e3o7an&dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mg___ng/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1499441, "client_id": 2388634, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2397d6f3/uploads/origins/9623cf55-00c2-48cf-864f-7d4828459b16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a713bc56a16c2834628147dd232875e9", "srcset": "https://si.imgix.net/2397d6f3/uploads/origins/9623cf55-00c2-48cf-864f-7d4828459b16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a713bc56a16c2834628147dd232875e9, https://si.imgix.net/2397d6f3/uploads/origins/9623cf55-00c2-48cf-864f-7d4828459b16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ce79f349ffc997c9c88e1780a240860 2x, https://si.imgix.net/2397d6f3/uploads/origins/9623cf55-00c2-48cf-864f-7d4828459b16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea69453daa283b5e72d9383ea8ad294c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2397d6f3/uploads/origins/9623cf55-00c2-48cf-864f-7d4828459b16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e20c9d946319cc0f97eda1b09ff4784", "srcset": "https://si.imgix.net/2397d6f3/uploads/origins/9623cf55-00c2-48cf-864f-7d4828459b16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e20c9d946319cc0f97eda1b09ff4784, https://si.imgix.net/2397d6f3/uploads/origins/9623cf55-00c2-48cf-864f-7d4828459b16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=33fe8b81730d7104b840437465076786 2x, https://si.imgix.net/2397d6f3/uploads/origins/9623cf55-00c2-48cf-864f-7d4828459b16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6010caedd097976f53707c77e3575aed 3x"}, "body": "はじめまして！\nあなたの独特のタッチで、重厚な雰囲気のある絵柄が大好きです。いつも探索者さんの立ち絵を楽しみにしています。\nもし可能でしたら、一枚絵をお願いしたいです。\n描かれているのは私たちの「花冷えに亡く季節」の探索者達です。\nできれば、花でいっぱいのところに、お互いだけを見つめあっている（片方は目を瞑っている）構図ですと嬉しいです。\n以下、シナリオの内容に触れないキャラクター概要を送ります。\n\n［パスカ］\n白いバラ（薔薇の種類はパスカリ）が身体から生えている少女。薄桃色の真っ直ぐな長い髪をしている。人形のような美貌。目の色は金色。花柄の透かしの入ったネグリジェの上から、丈の長いシャツワンピースを羽織っている。目を閉じている。イメージはいばら姫。\n［涼香］\n目の色は藍色、髪はグレー。王子様のような、優しくて、前向きで、格好よい女の子です。シャツワンピースの上からベストと、肩掛けを着ています。髪の長さは短く、首にかかる程度。毎日のひとつひとつを大切にしながら、他人に対して思いやり深く、それでいて芯の強い子です。\n\n念のため資料をお送りしますが、衣装の装飾などは参考程度にしていただいて構いません。\n構図に関してですが、キャラクターを大きく描く必要もとくにありません。構図にあわせてふたりのどちらかを小さく描いていただいても大丈夫です。描きやすいようにかいていただければと思います。\nもし難しい依頼でしたら遠慮なく捨て置いてください！\nもし描いていただいた暁には自陣とSNSなどで見せびらかして喜びます。\n\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1OOOxDCURonmc8yhcvr_ITBOUjTNl11gO?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@hu_nhey/works/564", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2616033, "client_id": 1499441, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9391eb96/uploads/origins/9838b681-007c-460a-b871-e05722b065be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e743e95fe17a5931cb104ee0285b0a53", "srcset": "https://si.imgix.net/9391eb96/uploads/origins/9838b681-007c-460a-b871-e05722b065be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e743e95fe17a5931cb104ee0285b0a53, https://si.imgix.net/9391eb96/uploads/origins/9838b681-007c-460a-b871-e05722b065be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3aad60b14b50a5a5bb242337f2303ec3 2x, https://si.imgix.net/9391eb96/uploads/origins/9838b681-007c-460a-b871-e05722b065be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d19e5cc8502c610cd5e7d6646dbcdc21 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9391eb96/uploads/origins/9838b681-007c-460a-b871-e05722b065be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b114