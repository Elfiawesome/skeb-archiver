b9-c011fd9a7802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cfa3c8ebb5bff280beb7d2d1e2e1c414 3x"}, "body": "はむきよさんこんばんは\n昨日納品して頂いた明石さん大変気に入りました、ありがとうございました\n今回、明石さんの依頼にワンクッション置いて以前Twitterに掲載された香取さんを思いだし、是非依頼したいと思って参りました\n下記のような内容でご検討頂ければ幸いです\n\n【衣装】【構図】\nhttps://thup.work/miniup/?mode=dl&id=21130\n↑\nを元にネイビーカラーの戦闘服（スカウトver）を纏う香取さんを描いて頂けないでしょうか\nヘルメットやマガジン等除いて頂いて、帯刀及びハンドガン程度の装備でお願いします\nその他はむきよさんのアレンジにお任せしたいです\n\n\n【セリフ】\n香取先生\n｢教導艦任務が主ですが、当然ながら香取型にも戦闘衣はあるのですよ？｣\n\n\n全般的に必要なアレンジして頂いて結構です\nまた描いて頂けるのを楽しみにお待ちしています", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@name_bonres09/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1454434, "client_id": 643959, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/64ed80c8/uploads/origins/f6a423de-0608-4606-a498-1748de1531d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43826b7b0af63f9da9e0ed0876a2c825", "srcset": "https://si.imgix.net/64ed80c8/uploads/origins/f6a423de-0608-4606-a498-1748de1531d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43826b7b0af63f9da9e0ed0876a2c825, https://si.imgix.net/64ed80c8/uploads/origins/f6a423de-0608-4606-a498-1748de1531d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ea0f8f9c271e76256c7d033ee9b98d3 2x, https://si.imgix.net/64ed80c8/uploads/origins/f6a423de-0608-4606-a498-1748de1531d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43fd4484bb1d5038ce7323c52879e9df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/64ed80c8/uploads/origins/f6a423de-0608-4606-a498-1748de1531d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8de34a3ff7f9a1c1e058732c416f32c6", "srcset": "https://si.imgix.net/64ed80c8/uploads/origins/f6a423de-0608-4606-a498-1748de1531d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8de34a3ff7f9a1c1e058732c416f32c6, https://si.imgix.net/64ed80c8/uploads/origins/f6a423de-0608-4606-a498-1748de1531d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8309a224082222068dcbc4b5a910e316 2x, https://si.imgix.net/64ed80c8/uploads/origins/f6a423de-0608-4606-a498-1748de1531d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=78ca00b8b435c9683117c87da3b3db1a 3x"}, "body": "はむきよさんこんにちは\n前回は候補生の〝初回特典〟を根刮ぎ自分で塗りつぶそうと動き出す明石さんを描いて下さり大変ありがとうございました\n今回また明石さんを下記のような内容で依頼させて頂けないでしょうか\n\n【衣装】\n香取型練習巡洋艦の制服着用した教導艦modeの明石さん希望です\n各部、明石さんに合わせたアレンジ大歓迎です\n\n【構図】\n教導艦modeの明石さんが相手から名刺を受け取り、それを読んでいる構図に描いて欲しいです\n\n【セリフ】\n｢TRIDENT…ああ、合衆国の軍需企業。最近は機械の兵隊さんを納入したと聞きましたが、それを日本でも？｣\n\n※明石さんは提督候補生の使う試作特殊装備開発も担当してる設定で考えています\n\n前回まで素敵なアレンジで描いて下さっているので、今回も描写に必要なアレンジは是非お願いします\nまたはむきよさんに描いて頂けるのをとても楽しみにしています", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@name_bonres09/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1454434, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09198821/uploads/origins/9699f054-a6fb-46d4-943a-e1a3a57fc264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8de7d78c3b1439995b76e1f1bb50ba8e", "srcset": "https://si.imgix.net/09198821/uploads/origins/9699f054-a6fb-46d4-943a-e1a3a57fc264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8de7d78c3b1439995b76e1f1bb50ba8e, https://si.imgix.net/09198821/uploads/origins/9699f054-a6fb-46d4-943a-e1a3a57fc264?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93314d0ddf95b04462091038bdef1a37 2x, https://si.imgix.net/09198821/uploads/origins/9699f054-a6fb-46d4-943a-e1a3a57fc264?bg=%23fff&auto=format%2Ccompress&f