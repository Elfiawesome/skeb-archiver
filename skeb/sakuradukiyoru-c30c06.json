pbs.twimg.com/media/Fp7Kg1HaMAAtHu5?format=jpg&name=900x900\n\n要望等\n・髪色は少し薄紫がかった白髪です\n・瞳の色は左目が紫、右目が赤紫です\n・魔界から来たサキュバスという設定だった清楚な女性です\n・上半身黒いナース服で、下は何も履いていない、着ていないけれども、セクシーでエロカッコイイ感じ、ないしはかわいらしい感じのをお願いします（下履いてないのに、いやらしさよりも、かっこいいとか、かわいいが勝つ感じの）\n・ポーズ、不明な箇所等のデザインは全てお任せ致します。\n・イラストは彼女のSNS活動、配信活動、ファンクラブ特典等で使って頂こうと考えています。\n\nここまで読んでいただきありがとうございました\nどうぞよろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakuradukiyoru/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/212ae2f2/uploads/origins/c0c3f9bc-e33f-4773-bfce-6e51c722b1bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4eeb735776d29d8af88da438fea7373", "srcset": "https://si.imgix.net/212ae2f2/uploads/origins/c0c3f9bc-e33f-4773-bfce-6e51c722b1bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4eeb735776d29d8af88da438fea7373, https://si.imgix.net/212ae2f2/uploads/origins/c0c3f9bc-e33f-4773-bfce-6e51c722b1bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f415fbfc63e604b7fbf2930d5ee9f8f 2x, https://si.imgix.net/212ae2f2/uploads/origins/c0c3f9bc-e33f-4773-bfce-6e51c722b1bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e7f2fd69d0c9158fccda17203af17fd8 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 290683, "client_id": 34745, "nc": 176}, {"path": "/@sakuradukiyoru/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 290683, "client_id": 1808098, "vtt_url": null, "thumbnail_image_