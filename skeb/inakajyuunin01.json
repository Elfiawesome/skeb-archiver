d2ab6c2e8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21703e4d/uploads/origins/99e25edf-309d-4397-8303-1440ee3d5c67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4940791a5b4facc19c4424922f3fcc0b", "src_set": ""}, "body": "こんにちは\n\nアナログで凪乃ましろさんを\n今回は新曲「エルドローブ」の動画を見ていただき、そのイメージでお任せします\n\nエルドローブ(歌動画・4分18秒)\nhttps://www.youtube.com/watch?v=0_DO0Ch4wP8\nイラスト内容は特に指定はありません、通常衣装でも動画みたいに羽はやしても\n\n納品は凪乃さんにも渡すのと、活動に使っていただけるかもしれませんのでそれも含めてお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inakajyuunin01/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3680260, "client_id": 1833592, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/edabcb60/uploads/origins/640b6397-1268-4bed-8d48-2cfd1349c83f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=977741993952714217bbd83a02b7e81a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/edabcb60/uploads/origins/640b6397-1268-4bed-8d48-2cfd1349c83f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1240f30cacce19dac9d852c3058b2a0", "src_set": ""}, "body": "こんにちは！アピールをありがとう！\n\n可愛らしいマーカーイラストを拝見しましたので、ぜひそのようなスタイルでスモーネを描いていただけたら嬉しいです！私はほとんど白人なので、たぶん簡単だと思います^^。\n\n今日も良い一日をお過ごしください！参考までにサンプルアートのリンクを貼っておきますが、もしよかったら新しい衣装で私を描いてください！私もアーティストなので、他の人が私のキャラクターをどう描くか見るのは楽しいです^^。\n\nありがとう！それでは、良い一日を！\n\nhttps://imgur.com/a/Hr5HNHF", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inakajyuunin01/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3680260, "client_id": 62060, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07fb38df/uploads/origins/55cd4a7c-baae-4f88-b7de-59fb8a5c4640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dc89f9272ae3159e4244ad09834a9d9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/07fb38df/uploads/origins/55cd4a7c-baae-4f88-b7de-59fb8a5c4640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5ba11941e1e4c65c51aca01c1d3467d", "src_set": ""}, "body": "こんにちは、こちらはデジタルでうちの子(由梨)をお願いします\n\n今回はハロウィンでお願いします\nハロウィンといっても「お菓子をくれてもいたずらするぞ！」的な強制いたずらしてきます\nぎゅーっと腕にハグするとかそういう程度ですが\n\n仮装衣装については着せたいのを着せてくださってかまいません。\n上記でおねがいします。", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inakajyuunin01/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3680260, "client_id": 62060, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6acb252c/uploads/origins/5fbfc5e8-b156-4d2f-8ca2-c5f6246fb02c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e4ded69d08395bcf18f400989995cd7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6acb252c/uploads/origins/5fbfc5e8-b156-4d2f-8ca2-c5f6246fb02c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d0703e959e7543653c4ff0f567df228", "src_set": ""}, "body": "こんにちは、凪乃ましろさんのアナログでお願いします\n\n今回は冬向けで1枚お願いします\n\n避けてほしいのは正月晴れ着とクリスマスあたり、これはおそらく公式で用意すると思いますので被らないように\nただ正月付近でも大晦日や巫女などは大丈夫です\n\n上記でお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inakajyuunin01/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3680260, "client_id": 62060, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d06b37b9/uploads/origins/d980468e-c382-4d7f-9b1c-eb2236c425d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78a3c680f1974a81d7e1f82b91cf3ca6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d06b37b9/uploads/origins/d980468e-c382-4d7f-9b1c-eb2236c425d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7c0f3d0521f3e6f3ae2fbc6c63c16d4", "src_set": ""}, "body": "こんにちは、こちらはうちの子(由梨)を\nhttps://skeb.jp/@inakajyuunin01/works/5\nこちらデジタルで、2枚お願いすることになります\n\n秋用でデート\nこちらの地域で秋は紅葉(庭園や大きな公園・植物園)・温泉街で温泉巡り・あとは普通に街でですね\n温泉なら浴衣、それ以外は制服とかでしょうか。制服にはコートがオプションであります･･･正直今の気温だと秋でも早ければいらないと思うけど\nhttps://x.com/kokoro_owner/status/1954162853952242151\n\n1枚目は昼のデートを楽しんでるイラスト\n\n2枚目は夜でデートも終わってるイラスト\nこの2枚目が相談ですが\n「もう少し一緒にいたいな」的にこちらの服をつかんでるようなイラスト\nもしくは\nそのあとでおうちかお部屋(温泉の場合)デートの色々(略)全部終わって、てれてれでおやすみなさいなイラスト\n\n上記で描けそうなのでおねがいします\n\n\nこちら先日の依頼のお話ですが\n新着イラストで「なんか癖なイラストがあるな」と開いたら前回お願いした依頼だったというオチがありまして\n(納品通知は新着からちょっと遅れて届くんです)\nありがうございました", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inakajyuunin01/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3680260, "client_id": 62060, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30a26d7e/uploads/origins/a384087b-2773-400e-bfe8-14853c36c954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b151f3958174229f8eee27f018d56743", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30a26d7e/uploads/origins/a384087b-2773-400e-bfe8-14853c36c954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a10d539f11c8de04c96706e10a8d460", "src_set": ""}, "body": "こんにちは、今回は凪乃ましろさんで\nこちらは秋用・アナログでお任せします\n\n\nましろさんの配信活動(YouTubeやｘ)で利用許可と、ましろさんに納品物を渡す許可込みで依頼させていただきます\nアナログですので配信用の利用よりはｘでのおはVやツイートに使われるかもしれません。\n\n上記でよろしくお願いします", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inakajyuunin01/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3680260, "client_id": 62060, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f655e916/uploads/origins/d03e4a32-fff4-4bc6-a824-fd210a8b7bc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee6b1a59e8504e4c27c4e541f5609721", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f655e916/uploads/origins/d03e4a32-fff4-4bc6-a824-fd210a8b7bc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5a9245056e865f6c7b1e70b7f49d3be", "src_set": ""}, "body": "こんにちは、今回は前回お願いしたうちの子でおねがいします\nhttps://skeb.jp/@inakajyuunin01/works/3\n\n暑いので今回は水着で、種類はおまかせします。\n具体的には制服の下にすでに水着を着ている状態ですが、状況とかもお任せしますので\n(制服から水着になりつつとか、着替え後の完全な水着姿とか)\n\n水着の種類やポーズなどおまかせしますが、以下のように\n水着というだけで最近は厳しいですので、必要でしたら条件変更再送などでお願いします。\nhttps://x.com/kokoro_owner/status/1952927697094742236\n\n上記でお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inakajyuunin01/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3680260, "client_id": 62060, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5599b32/uploads/origins/fc7e541b-70ab-434e-b56e-f09d1a91be89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f50e3ef7ec10f805b647f60963e6589", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5599b32/uploads/origins/fc7e541b-70ab-434e-b56e-f09d1a91be89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b481cb282169bf2918eb23b7e2cbf240", "src_set": ""}, "body": "先日はありがとうございました\n今回もアナログでお願いします\n\nお願いしたいもの\n個人V凪乃ましろさんのイラスト\n\n二次創作などの規約と許可がここでされております\nhttps://lit.link/naginomashiro\n見やすいように画像で切り出しております\nhttps://x.com/takemaneko/status/1931607005942399482\n\n衣装などの資料\nhttps://x.com/Nagino_Mashiro/status/1947841423057080786\nモデルが多いので、この中から好きなのを参考にしていただければ\n\nイメージはこちら見てもらえれば(ショート動画)\nhttps://www.youtube.com/watch?v=05Sh1NdHJNo\nhttps://www.youtube.com/shorts/06ltnw7L3io\nhttps://x.com/clatyu/status/1841861605304500711\n\n内容ですが夏か秋向けどちらかで他はお任せします\n衣装も変えてくださって構いません(夏だと花火や海水浴、秋は祭り浴衣など)\n\n\nましろさんの配信活動(YouTubeやｘ)で利用許可と、ましろさんに納品物を渡す許可込みで依頼させていただきます\nアナログですので配信用の利用よりはｘでのおはVやツイートに使われるかもしれません。\n\n上記でご検討お願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inakajyuunin01/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3680260, "client_id": 62060, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23877b73/uploads/origins/99efab11-d4ab-4f38-9cb9-319866558a70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f630bb36910ae1473fb6ee4b600c4d18", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23877b73/uploads/origins/99efab11-d4ab-4f38-9cb9-319866558a70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=640897b0182b4e5d1c5d466b20b4ac8a", "src_set": ""}, "body": "こんにちは、うちの子をお願いします\n\nhttps://x.com/kokoro_owner/status/1928867536961155470/\nhttps://x.com/kokoro_owner/status/1928867542614892666\n暑いのでアイスでも持たせるか食べさせるかしてくだされば\n\nアナログも描かれてるそうですので、\n希望としてはアナログですがデジタルでも問題ありません\n\n上記でご検討お願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inakajyuunin01/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3680260, "client_id": 2215005, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a765c3a/uploads/origins/664d8823-fa10-45c2-94c0-628e5e136fc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fed2f63033b28c0471a546716f62ca62", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a765c3a/uploads/origins/664d8823-fa10-45c2-94c0-628e5e136fc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea8c7170992ff983bef47da9fcb63b64", "src_set": ""}, "body": "こんにちは！たくさんのご応募ありがとうございました！ポーズ、衣装、構図は自由で「エイミー」を描いてください。バラもお願いします。\n\n彼女は笑わないことに留意してください。\n\nhttps://www.deviantart.com/stash/21hvyfesbc8u", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inakajyuunin01/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3680260, "client_id": 320760, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e06ef116/uploads/origins/bb240381-c62d-49a4-ad5c-348c63382653?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a484a4e073bdc37ab9af1251aba650e5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e06ef116/uploads/origins/bb240381-c62d-49a4-ad5c-348c63382653?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2ae9eb8c8976612f99d7f8273153d3c", "src_set": ""}, "body": "こんにちは。\nアヤナを描いてほしい。\nアヤンナはゴシックなおとぎ話の王国を支配しているので、彼女のポーズを完全にクリエイティブにします。キュートでロマンチックな感じで。\nひまわりに囲まれた彼女を描いてください。\n\n\n参考資料\nhttps://sta.sh/0jue9itus3a\nhttps://sta.sh/0pb7jnrysok", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 256, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "筆禍＠アリエスくん発売中", "screen_name": "hikka06", "avatar_url": "https://pbs.twimg