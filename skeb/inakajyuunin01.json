1c-eb2236c425d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78a3c680f1974a81d7e1f82b91cf3ca6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d06b37b9/uploads/origins/d980468e-c382-4d7f-9b1c-eb2236c425d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7c0f3d0521f3e6f3ae2fbc6c63c16d4", "src_set": ""}, "body": "こんにちは、こちらはうちの子(由梨)を\nhttps://skeb.jp/@inakajyuunin01/works/5\nこちらデジタルで、2枚お願いすることになります\n\n秋用でデート\nこちらの地域で秋は紅葉(庭園や大きな公園・植物園)・温泉街で温泉巡り・あとは普通に街でですね\n温泉なら浴衣、それ以外は制服とかでしょうか。制服にはコートがオプションであります･･･正直今の気温だと秋でも早ければいらないと思うけど\nhttps://x.com/kokoro_owner/status/1954162853952242151\n\n1枚目は昼のデートを楽しんでるイラスト\n\n2枚目は夜でデートも終わってるイラスト\nこの2枚目が相談ですが\n「もう少し一緒にいたいな」的にこちらの服をつかんでるようなイラスト\nもしくは\nそのあとでおうちかお部屋(温泉の場合)デートの色々(略)全部終わって、てれてれでおやすみなさいなイラスト\n\n上記で描けそうなのでおねがいします\n\n\nこちら先日の依頼のお話ですが\n新着イラストで「なんか癖なイラストがあるな」と開いたら前回お願いした依頼だったというオチがありまして\n(納品通知は新着からちょっと遅れて届くんです)\nありがうございました", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inakajyuunin01/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3680260, "client_id": 62060, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30a26d7e/uploads/origins/a384087b-2773-400e-bfe8-14853c36c954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b151f3958174229f8eee27f018d56743", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30a26d7e/uploads/origins/a384087b-2773-400e-bfe8-14853c36c954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a10d539f11c8de04c96706e10a8d460", "src_set": ""}, "body": "こんにちは、今回は凪乃ましろさんで\nこちらは秋用・アナログでお任せします\n\n\nましろさんの配信活動(YouTubeやｘ)で利用許可と、ましろさんに納品物を渡す許可込みで依頼させていただきます\nアナログですので配信用の利用よりはｘでのおはVやツイートに使われるかもしれません。\n\n上記でよろしくお願いします", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inakajyuunin01/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3680260, "client_id": 62060, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f655e916/uploads/origins/d03e4a32-fff4-4bc6-a824-fd210a8b7bc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee6b1a59e8504e4c27c4e541f5609721", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f655e916/uploads/origins/d03e4a32-fff4-4bc6-a824-fd210a8b7bc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5a9245056e865f6c7b1e70b7f49d3be", "src_set": ""}, "body": "こんにちは、今回は前回お願いしたうちの子でおねがいします\nhttps://skeb.jp/@inakajyuunin01/works/3\n\n暑いので今回は水着で、種類はおまかせします。\n具体的には制服の下にすでに水着を着ている状態ですが、状況とかもお任せしますので\n(制服から水着になりつつとか、着替え後の完全な水着姿とか)\n\n水着の種類やポーズなどおまかせしますが、以下のように\n水着というだけで最近は厳しいですので、必要でしたら条件変更再送などでお願いします。\nhttps://x.com/kokoro_owner/status/1952927697094742236\n\n上記でお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inakajyuunin01/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3680260, "client_id": 62060, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5599b32/uploads/origins/fc7e541b-70ab-434e-b56e-f09d1a91be89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f50e3ef7ec10f805b647f60963e6589", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5599b32/uploads/origins/fc7e541b-70ab-434e-b56e-f09d1a91be89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b481cb282169bf2918eb23b7e2cbf240", "src_set": ""}, "body": "先日は