id": 86180, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c1fcde0/uploads/origins/a194ec65-3d2e-4ee7-8dbe-266f7cf1602b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d618d6ae27687c4e3b49c55c09ff232", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c1fcde0/uploads/origins/a194ec65-3d2e-4ee7-8dbe-266f7cf1602b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3df88aa6badc78fb06498acfc5784070", "src_set": ""}, "body": "はじめまして。\nヒシミラクルのイラストを見て依頼したく思いました。\n長距離レースのゴール前で必死に走っているヒシミラクルをお願いします。\nよろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shibumenigai/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1624277, "client_id": 2071880, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ebe52993/uploads/origins/a63cbee7-57c2-486f-891b-03fcd6e7c9ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8704b7daf49448fd14447e3076b0320a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ebe52993/uploads/origins/a63cbee7-57c2-486f-891b-03fcd6e7c9ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=832dbe484cbfae8dbdabebc2ccf3dd3f", "src_set": ""}, "body": "こんにちは。前回はありがとうございました！今回依頼したいのも自分のオリジナルウマ娘です。オリジナルウマ娘の参考絵のURL載せておきますのでご確認ください(https://photos.app.goo.gl/pozZyPuVjf3hw8h38)身長150cm。スリーサイズB80 W50 H75です。頭についている髪飾りはイキシアの花です。花の参考写真も上のリンク含まれてます。  髪の長さは背中くらいです。\n\n描いていただきたいのは自分で前髪切って調節しようと挑戦したけど失敗してしまいぱっつんになってしまった姿をお願いしたいです。表情は泣き顔で、服装は夏服でお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shibumenigai/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/11cdc9be/upl