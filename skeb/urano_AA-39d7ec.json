s://drive.google.com/drive/folders/1bj7fAuRMq2NkuHA6EHtXPGUWHwoe93oC\n\nカーディガンが蜜蝋を後ろから抱きしめて、蜜蝋の乳首を弄っている絵が見たい。\n\n蜜蝋は服を着て描いてください。カーディガンは蜜蝋のシャツの上から乳首をねじって遊んでいます。乳首がシャツからはっきりと突き出ている蜜蝋を描いてください。また、カーディガンが蜜蝋の頬にキスをしたり、首筋を噛んだり、愛撫をしたりする様子も描いてほしい。\n\nできれば、カーディガンが尻尾を振っているところも見てみたい、\n\n二人の少女が非常に興奮している様子を描いてほしい。\n\n百合を引き立てるものなら何でも自由に描いてください。\n\nhttps://drive.google.com/drive/folders/1UIICDE4UxnDNLNbC-pBSLvb-fWsVOT18?usp=sharing", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 7465, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あると　りあらいず", "screen_name": "alto_realize", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F0b65f89b-95d6-4992-aa4e-a5dbcc975851.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/155a06c0-779d-4435-a46c-3c2d72e23465.png?sensitive=true", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 14, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 32}, {"id": 1827110, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ういの@Skeb募集中", "screen_name": "uino", "avatar_url": "https://pbs.twimg.com/profile_images/1580922383908540418/xiWtfmKo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1488232492452569091/1716755384/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 2228970, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Lev@skeb募集中", "screen_name": "Levls333", "avatar_url":