core": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c241dda8/uploads/origins/fe000987-70ac-49cd-87c9-f2371a88761a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7bfebcf74f15371fa6e2178a78386402", "srcset": "https://si.imgix.net/c241dda8/uploads/origins/fe000987-70ac-49cd-87c9-f2371a88761a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7bfebcf74f15371fa6e2178a78386402, https://si.imgix.net/c241dda8/uploads/origins/fe000987-70ac-49cd-87c9-f2371a88761a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8476d9f7e89a201980b49414577ca20c 2x, https://si.imgix.net/c241dda8/uploads/origins/fe000987-70ac-49cd-87c9-f2371a88761a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3653f6af7f1d520dc7f2fabe193b9981 3x"}, "body": "こんにちは、あなたの作品が本当に本当に大好きなんです……なので、またお邪魔しました……ぜひ私のリクエストを検討してください！\n今回は、シンプルな線画とベースカラーのみのスタイル（陰影なし）でお願いしたいです。\n\n- アクセル（性別不詳）： \n+ 外見：白い髪＋両サイドにピンクのハイライト、ピンク＋緑＋青＋赤の瞳、アオロトルトの尾、指は4本。\n+ 性格：無表情、いたずら好き、チュニビョウ。\n+ テーマ：生命、水生植物、カビ。\n+ 分析能力に長けている。\n\n- イー・グアン（男性）：\n+ 外見：紺色の髪、一重まぶた、ピンクの渦巻き模様が入った小さな緑色の目、左目の下にほくろ、青いイグアナの尾。\n+ 性格：サディスティック、傲慢。\n+ テーマ：死、食虫植物、図書館。\n+ 写真のような記憶力を持つ。\n\n- 二人とも神童だが、得意分野が異なるため、テストでは交互に高得点を記録している。\n- 二人の間には、競争心にあふれ、複雑（？あるいはロマンチック？）な関係がある。\n\n- 彩度の高い色使いと、小道具や装飾をふんだんに使った表現を好みます！\n\nhttps://drive.google.com/drive/folders/1HMLKQrW_FDO5nl4VRiWFy-kTD7rllEU3", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 3047407, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "isoi", "screen_name": "isoi00", "avatar_url": "https://pbs.twimg.com/profile_images/1791122954388221952/ubEn_Dd3.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiratio