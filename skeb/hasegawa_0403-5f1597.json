プリントなどで使用させてもらえればと思います。\nまた、活動の宣伝用ポスターやチラシなど、無料配布用の印刷物に使用させていただけると大変嬉しいです。\n\n人物、背景、サインのレイヤー分けも、お手数かけて申し訳ありませんが、よろしければお願いしたいです。\n\n引き受けていただければ幸いです。\nよろしくお願いいたします。\n\nhttps://twitter.com/se_ra_REALITY/status/1591671911838552065?s=20&t=mcivgUuI2mlPkTCLZQiJYA", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hasegawa_0403/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1295419, "client_id": 1715220, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/536f89eb/uploads/origins/bfbfde86-a159-429c-a624-d9d87dced671?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7135d8283cff7481651cc565b294ce9f", "srcset": "https://si.imgix.net/536f89eb/uploads/origins/bfbfde86-a159-429c-a624-d9d87dced671?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7135d8283cff7481651cc565b294ce9f, https://si.imgix.net/536f89eb/uploads/origins/bfbfde86-a159-429c-a624-d9d87dced671?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bdde824dce6fe3bb1d9c9ac4ae8136f 2x, https://si.imgix.net/536f89eb/uploads/origins/bfbfde86-a159-429c-a624-d9d87dced671?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46267bfc5b885578e1cb9a9e43df5c48 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/536f89eb/uploads/origins/bfbfde86-a159-429c-a624-d9d87dced671?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df5c8ff7ca0e5ffabfe5f443557dd476", "srcset": "https://si.imgix.net/536f89eb/uploads/origins/bfbfde86-a159-429c-a624-d9d87dced671?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df5c8ff7ca0e5ffabfe5f443557dd476, https://si.imgix.net/536f89eb/uploads/origins/bfbfde86-a159-429c-a624-d9d87dced671?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit