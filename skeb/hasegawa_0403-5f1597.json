hなどのSNSで使用する予定です。\n\nぜひご検討ください！よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/12YC-svQUaTq3ty42FA5UnGAHCITlEr_f?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hasegawa_0403/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1295419, "client_id": 405226, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bce6b2eb/uploads/origins/2d22d87e-ecee-46ab-8f20-84d4e2496a56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cfe4825babf1325015a34814f170c4b", "srcset": "https://si.imgix.net/bce6b2eb/uploads/origins/2d22d87e-ecee-46ab-8f20-84d4e2496a56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cfe4825babf1325015a34814f170c4b, https://si.imgix.net/bce6b2eb/uploads/origins/2d22d87e-ecee-46ab-8f20-84d4e2496a56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=228cbd279bf10f56224be32a4494ff06 2x, https://si.imgix.net/bce6b2eb/uploads/origins/2d22d87e-ecee-46ab-8f20-84d4e2496a56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31224d162eaf4bffef11b865111da5b1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bce6b2eb/uploads/origins/2d22d87e-ecee-46ab-8f20-84d4e2496a56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d361594559c86a6015868664e6a6b8f3", "srcset": "https://si.imgix.net/bce6b2eb/uploads/origins/2d22d87e-ecee-46ab-8f20-84d4e2496a56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d361594559c86a6015868664e6a6b8f3, https://si.imgix.net/bce6b2eb/uploads/origins/2d22d87e-ecee-46ab-8f20-84d4e2496a56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=71211c8c81a16232dab9e78ca279a8ba 2x, https://si.imgix.net/bce6b2eb/uploads/origins/2d22d87e-