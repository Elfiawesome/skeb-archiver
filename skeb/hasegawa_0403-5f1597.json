5471/uploads/origins/aef7ec42-4ce1-4f5e-9174-8551743ae849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d4b1e7cb2231f0ea6f905ecbcd6bb6d, https://si.imgix.net/8bf95471/uploads/origins/aef7ec42-4ce1-4f5e-9174-8551743ae849?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1435b3d94464c3414a3ca23f6fa98366 2x, https://si.imgix.net/8bf95471/uploads/origins/aef7ec42-4ce1-4f5e-9174-8551743ae849?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=700e0d7ab626f755fc2e6e4218c6527d 3x"}, "body": "目の描き方、特に光の屈折があるところがとても好きです。\n私のVtuberを描いていただけませんか？\n\n顔はこんな感じです。https://imgur.com/a/RxLpMyF\n\nただし、新しい服装で描いてほしい。髪は緑のショートでお願いします。https://imgur.com/a/rlMTJsl\n目の中に花が入っています。\nできれば、髪の花を小さくして、年齢はそのままでお願いします。\n\nもう1つの衣装も選択できますが、より複雑になります：https://imgur.com/a/XW1AJeB\n\n背景や構図はお好みで。\n上品な大人っぽい薄笑いのタイプで、落ち着き・真面目なオーラがあります。\nシャイでキュートな一面もあります。\n\nSNSでぜひ使いたい。スケジュール画像としても使わせていただくかもしれません。\n必ずクレジットを入れさせていただきます。\nTwitterではアートタグ「#heartdepths」を使っています。\n必須ではありませんが、キャラクターと背景のレイヤー分けがあれば最高です。\n\nありがとうございました。\n\nhttps://imgur.com/a/rlMTJsl", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hasegawa_0403/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1295419, "client_id": 167837, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dbe7f3b4/uploads/origins/82004467-e306-488c-8ebf-94b35f94caf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a1062e4a78963c3decc9442e35dc7d8", "srcset": "https://si.imgix.net/dbe7f3b4/uploads/origins/82004467-e306-488c-8ebf-94b35f94caf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a1062e4a78963c3decc9442e35dc7d8, https://si.imgix.net/dbe7f3b4/uploads/origins/82004467-e306-488c-8ebf-94b35f94caf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=179ce402fbc202