e6f3869319584ae5 2x, https://si.imgix.net/682616fc/uploads/origins/936e3e0d-f740-4d52-8dab-ee698e398448?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=addcb14327d00120ea6717f344d58a2d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/682616fc/uploads/origins/936e3e0d-f740-4d52-8dab-ee698e398448?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5cecf5bbe3dd86448dcffa9df866d0b", "srcset": "https://si.imgix.net/682616fc/uploads/origins/936e3e0d-f740-4d52-8dab-ee698e398448?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5cecf5bbe3dd86448dcffa9df866d0b, https://si.imgix.net/682616fc/uploads/origins/936e3e0d-f740-4d52-8dab-ee698e398448?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b7fe09c3ab5bb98162e4f2e99a63d74b 2x, https://si.imgix.net/682616fc/uploads/origins/936e3e0d-f740-4d52-8dab-ee698e398448?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a9d420dc129f9fe92e8d5700a9d0c3b1 3x"}, "body": "初めまして。\nSkeb上で絵師様を探していた際にイラストをお見掛けして引き込まれるようなとても素敵な絵柄だと思い是非にとリクエストさせていただきました。\n\n要望としてはVTuberの涼本りゃうかさんのイラストの制作をリクエストさせていただければと思います。\n\n構図は基本お任せ致しますが、羽瀬川様の描く作品の中でも特に衣装を描く際の繊細さが個人的にとても魅力的に感じましたので可能であれば涼本りゃうかさんを見て羽瀬川様が似合いそうと感じるドレス姿の涼本りゃうかさんを表現していただけたらと思います。\n\n使用するかはご本人様次第ではございますが、VTuberご本人様がサムネイルや配信素材など配信活動で利用の許可をいただきたいです。\n\n以上ご検討のほどよろしくお願いします。\n\n○参考資料\n下記スレッドに三面図があります\nhttps://twitter.com/Ryoka_Suzumoto/status/1509108171465502720\nhttps://ryoka-suzumoto.booth.pm/items/2878079", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hasegawa_0403/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1295419, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d41c1d1/uploads/origins/1c691829-508b-4e3d-81e0-668e