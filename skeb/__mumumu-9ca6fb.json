s/be907c9a-7174-4609-b6d3-9adfda21e41f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c1070ebf1f227c35dc5cb5edcd467fa, https://si.imgix.net/2b9f5190/uploads/origins/be907c9a-7174-4609-b6d3-9adfda21e41f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4ebe298819b8b521b067c30bec2f3bb 2x, https://si.imgix.net/2b9f5190/uploads/origins/be907c9a-7174-4609-b6d3-9adfda21e41f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9f9073e2e0aa17b03b2fc015897f5f5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b9f5190/uploads/origins/be907c9a-7174-4609-b6d3-9adfda21e41f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ec96aa08b7366683c414ba25a3b1573", "srcset": "https://si.imgix.net/2b9f5190/uploads/origins/be907c9a-7174-4609-b6d3-9adfda21e41f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ec96aa08b7366683c414ba25a3b1573, https://si.imgix.net/2b9f5190/uploads/origins/be907c9a-7174-4609-b6d3-9adfda21e41f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5dc2a3c5999774d0027f2f65e035ad3a 2x, https://si.imgix.net/2b9f5190/uploads/origins/be907c9a-7174-4609-b6d3-9adfda21e41f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eee4629ee9aeba32e1e2b30f587c23b4 3x"}, "body": "アーボックに巻き付かれている東方Projectの橙をお願いします。\n\n構図はデビラさんのアーボック時津風ように3〜4巻で全身を巻き付けて、橙の頭の上から口を閉じて、舌を出して下さい。又、アーボックの尻尾で橙の尻尾を束ねるように2〜3巻して下さい。その為、尻尾でなく、胴体で首を締め付けている差分といない差分(どちらかでしたらしていない差分)をお願いします。\n\n橙の表情は\n①恐怖で涙目になっている。\n②締め付けが強くなりやめて・・・！と暴れるが全身締め付けられているので全く意味がない\n③ついに限界で「嫌あ！」と叫ぶ。\n④それにビックリしたのか締め付けが弱くなり、橙の呼吸は荒いが、赤面状態で感じているよいになっている。\n⑤癖になってしまい、ぽわーんと感じている表情で「もう一回やって」アーボックにおねだりする。\n\n①②⑤は目を開け、③④は目を閉じて下さい。\n\nもし大丈夫でしたら、アーボックの色違いもお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@__mumumu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 33881, "client_id": 3201919, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5610854a/uploads/origins/3408c753-1743-441f-a34f-70a22268dff1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14a5cecd9ed20c18348f4117610e39da", "srcset": "https://si.imgix.net/5610854a/uploads/origins/3408c753-1743-441f-a34f-70a22268dff1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14a5cecd9ed20c18348f4117610e39da, https://si.imgix.net/5610854a/uploads/origins/3408c753-1743-441f-a34f-70a22268dff1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b4c6efbfffc0eecfa0e26ae8538c366 2x, https://si.imgix.net/5610854a/uploads/origins/3408c753-1743-441f-a34f-70a22268dff1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5419b6629ea0809a1fefdddafd34537 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5610854a/uploads/origins/3408c753-1743-441f-a34f-70a22268dff1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8495b4e895835f684d5c1ed8d78baaad", "srcset": "https://si.imgix.net/5610854a/uploads/origins/3408c753-1743-441f-a34f-70a22268dff1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8495b4e895835f684d5c1ed8d78baaad, https://si.imgix.net/5610854a/uploads/origins/3408c753-1743-441f-a34f-70a22268dff1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=779d4313ea4786d4628aaf368c3230f6 2x, https://si.imgix.net/5610854a/uploads/origins/3408c753-1743-441f-a34f-70a22268dff1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e50077cdb368bfa362335466732d6e9d 3x"}, "body": "こんにちは、むむむさん～！\n\n今回のキャラクターは2人です：[B】まさみ、【A】フラフィカ\n\nまさみは、大きな白い毛皮のコートを着ていればいいです。\nフラフィカは全裸でお願いします。\n\nマサミは自分のふわふわの尻尾の上に座り、フラフィカはマサミの膝の上に抱かれる。\nマサミはしっぽをフルフィカの胴体に巻きつける。\n尻尾はそのままフラフィカの首に巻き付き、口に入るようにする。\nマサミの尻尾はフルフィカに強烈な尻尾コキをし、彼女をイカせる！\nフルフィカの脚はもう2本の尻尾で広げられ、腕はさらに尻尾で拘束される。\n二本の尻尾はフルフィカの胸を弄ぶ。\n\nまさみは、フラフィカを見ながら、頬に手を当て、その手にもたれて、魅惑的な邪悪な笑みを浮かべているはずだ。\nフラフィカは、「ふわふわ感に圧倒されている」というような表現をするべきだ。\n\nこの度は本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1dZRdfd3qd4TjBPrMKAmcY2gjjHb_TznX?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@__mumumu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 33881, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4b34526/uploads/origins/1f800ca6-55dc-4486-ae53-0b86fe0f7aec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34e825778e503c821b912758b4ed1544", "srcset": "https://si.imgix.net/d4b34526/uploads/origins/1f800ca6-55dc-4486-ae53-0b86fe0f7aec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34e825778e503c821b912758b4ed1544, https://si.imgix.net/d4b34526/uploads/origins/1f800ca6-55dc-4486-ae53-0b86fe0f7aec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2829de2a0fb33ce30bbc59dfb61837e1 2x, https://si.imgix.net/d4b34526/uploads/origins/1f800ca6-55dc-4486-ae53-0b86fe0f7aec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f27802d209c7bb6642e7081fa4ed6300 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4b34526/uploads/origins/1f800ca6-55dc-4486-ae53-0b86fe0f7aec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06d40dfd4482d5e8b2c04b6bf84d7c0d", "srcset": "https://si.imgix.net/d4b34526/uploads/origins/1f800ca6-55dc-4486-ae53-0b86fe0f7aec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06d40dfd4482d5e8b2c04b6bf84d7c0d, https://si.imgix.net/d4b34526/uploads/origins/1f800ca6-55dc-4486-ae53-0b86fe0f7aec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a6159496c1718dccdf0b94040f63d7c 2x, https://si.imgix.net/d4b34526/uploads/origins/1f800ca6-55dc-4486-ae53-0b86fe0f7aec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=37fa1a35e9a04aa11fa58d324409942c 3x"}, "body": "はじめまして、今回Skebをはじめられたとのことで、匿名にてリクエストを失礼いたします。\n\n【キャラクター】\n・博麗霊夢（ふたなり）\n・多々良小傘\n\nふたなりの博麗霊夢が、多々良小傘の唐傘の舌に拘束され、舌コキで搾精される。というシチュエーションにてお願いいたします。\n可能であれば、連続で射精させられる様子と、限界まで搾り取られた後についても描写していただけると嬉しいです。\n「狩りの尾時間　七」の舌コキシチュがとても癖に刺さるもので、今回このリクエストをさせていただきます。\n\n詳細なセリフや構図などについてはお任せいたします。\n上記の内容にて、ご一考いただければ幸いです。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@__mumumu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 33881, "client_id": 1250877, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89474f7a/uploads/origins/41f5ef26-16e1-4ed7-8341-e70388b3b7df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57990b90a3025a7c21bb74a75c67d1aa", "srcset": "https://si.imgix.net/89474f7a/uploads/origins/41f5ef26-16e1-4ed7-8341-e70388b3b7df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57990b90a3025a7c21bb74a75c67d1aa, https://si.imgix.net/89474f7a/uploads/origins/41f5ef26-16e1-4ed7-8341-e70388b3b7df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=363d1b0f608f5d18d494c61ed712ece3 2x, https://si.imgix.net/89474f7a/uploads/origins/41f5ef26-16e1-4ed7-8341-e70388b3b7df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b08d4d806ec4f6aa9d30a851279a82db 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89474f7a/uploads/origins/41f5ef26-16e1-4ed7-8341-e70388b3b7df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d7e06cbc10c29dccbc71235e88a1dd8", "srcset": "https://si.imgix.net/89474f7a/uploads/origins/41f5ef26-16e1-4ed7-8341-e70388b3b7df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d7e06cbc10c29dccbc71235e88a1dd8, https://si.imgix.net/89474f7a/uploads/origins/41f5ef26-16e1-4ed7-8341-e70388b3b7df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bacda99ac513778ab63126e9fd217ec4 2x, https://si.imgix.net/89474f7a/uploads/origins/41f5ef26-16e1-4ed7-8341-e70388b3b7df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=25238527c599f06914beb88f51fb4210 3x"}, "body": "愛理とスカイの2人のキャラクターの絵をお願いしたいです。\nアイリは身長175cmのキツネ、スカイは身長138cmのオオカミ少年です。\n\n愛莉はスカイの後ろに立っていてください。参考ポーズと同じような感じで、しっぽが見えるように全身を描いてください。\n\nシーン1：愛理は片方の尻尾をスカイの腰に巻きつけ、彼を抱きしめる。愛理は無邪気に笑っているが、スカイは顔を赤らめ、戸惑っているように見える。\nシーン2：愛理は手と尻尾でスカイを拘束する。愛理はドヤ顔で微笑む。スカイは恥ずかしくなり、さらに顔を赤らめる。\nシーン3愛莉は手と尻尾でスカイをきつく密着させる。愛理のスカートにはペニスの膨らみが見える。愛莉は唇を舐めながら、にっこり微笑む。スカイは恥ずかしそうに、そして緊張している。\nシーン4：上と同じだが、フルヌード。\n\nできればレイヤー付きのPSDファイルを添付してください。\n記載されていないものは、適当に描いてください！\n新しいGoogle Driveのリンクを提供しました。\n\nhttps://drive.google.com/drive/folders/15QFmDT_BQ4ZxOEVAbjn28wXx74KjxxL7?usp=sharing", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@__mumumu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 33881, "client_id": 183664, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/346a1b90/uploads/origins/a3c066d6-edb5-4e51-9d46-5774a652650b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2798487cb82272e591523d159f4d6f6b", "srcset": "https://si.imgix.net/346a1b90/uploads/origins/a3c066d6-edb5-4e51-9d46-5774a652650b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2798487cb82272e591523d159f4d6f6b, https://si.imgix.net/346a1b90/uploads/origins/a3c066d6-edb5-4e51-9d46-5774a652650b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5bbff2613fb74e636144a3e13ee3bda 2x, https://si.imgix.net/346a1b90/uploads/origins/a3c066d6-edb5-4e51-9d46-5774a652650b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=409be166568aff2fd53952dd8711557f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/346a1b90/uploads/origins/a3c066d6-edb5-4e51-9d46-5774a652650b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8b2c6c4109d7db6cc1123556772af7f", "srcset": "https://si.imgix.net/346a1b90/uploads/origins/a3c066d6-edb5-4e51-9d46-5774a652650b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8b2c6c4109d7db6cc1123556772af7f, https://si.imgix.net/346a1b90/uploads/origins/a3c066d6-edb5-4e51-9d46-5774a652650b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=85d6712c4f360d8f4cb3793b63841cb6 2x, https://si.imgix.net/346a1b90/uploads/origins/a3c066d6-edb5-4e51-9d46-5774a652650b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e3e73f7b3b337601a26e16bc961c36b9 3x"}, "body": "Skeb開設おめでとうございます。\nむむむ様の描かれる尻尾を用いた逆レ的シチュエーションがとても好みで、この度リクエストをさせていただきました。\n\nナズーリンと菅牧典に囲まれた少年が尻尾によって責め立てられ、精を搾りとるように辱められているイラストをお願いできますでしょうか。\nどちらも行為には極めて積極的で、ナズは尻尾を用いた逆アナル、典は尻尾コキを行っているイメージです。\n可能であれば少年の痴態や誘惑を煽るようなセリフがあると嬉しいです。セリフがなくても、典については囁きかけているような雰囲気があると理想です。\n\nむむむ様のこれまでの作品で拝見したナズの逆アナル描写や、狐尻尾を使った表現がとても好みでした。\n今回のイメージとも相性が良いのではないかと考えております。\n\nご検討のほど、何卒よろしくお願い申し上げます。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@__mumumu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 33881, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ec52f24/uploads/origins/7f692383-1343-4c88-a3b7-32096b2c1067?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1014fa39381251129f63a77a0fbd9d81", "srcset": "https://si.imgix.net/9ec52f24/uploads/origins/7f692383-1343-4c88-a3b7-32096b2c1067?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1014fa39381251129f63a77a0fbd9d81, https://si.imgix.net/9ec52f24/uploads/origins/7f692383-1343-4c88-a3b7-32096b2c1067?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9ba9ea7f497a88d399e5f9986fba01e 2x, https://si.imgix.net/9ec52f24/uploads/origins/7f692383-1343-4c88-a3b7-32096b2c1067?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fcb24f9872c3e8402146116b7d9602a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ec52f24/uploads/origins/7f692383-1343-4c88-a3b7-32096b2c1067?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3a91b6e1be72af60759431533fb596b", "srcset": "https://si.imgix.net/9ec52f24/uploads/origins/7f692383-1343-4c88-a3b7-32096b2c1067?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3a91b6e1be72af60759431533fb596b, https://si.imgix.net/9ec52f24/uploads/origins/7f692383-1343-4c88-a3b7-32096b2c1067?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b7d4c51a00fa22eef17248da5bb33f7 2x, https://si.imgix.net/9ec52f24/uploads/origins/7f692383-1343-4c88-a3b7-32096b2c1067?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8825f67e4f537f3a2c972e9d9bd3fb3c 3x"}, "body": "ふたなり時津風のような感じでハッカドール3号とアーボックをお願いできますか？\nリクエスト文はデビラさんの文をお借りしております。\n\n① アーボックに首から下を隙間なく巻き付かれる（３～４巻ぐらいがベストです）締め付けられていますが殺す程の力は入れておらず、３号は苦しみながらも赤面で感じでしまっています。\n② その際、アーボックの隙間と隙間の間から勃起してしまい、それを見たアーボックは尻尾で巻き付けはじめます（この時は根元に１巻だけしてください）３号は恥ずかしがりながら「嫌・・・！」みたいな表情をしますが完全には嫌がっていません。\n③ 尻尾で２～３巻ぐらいしてシコシコし始めます。３号はさらに感じてしまい声を出てしまいますが、出さないようにこらえようとしています。\n④ 射精する瞬間アーボックの尻尾の締め付けが強くなり、絶頂状態で必死に声を殺そうとしますが「ん・・・・！！」みたいな感じで声が出てしまいます。\n⑤３号は気持ちよくて若干息が荒くなっている。アーボックの締め付けは続いています。\n３号は④のみ目を閉じ、他はあけている状態でお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@__mumumu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 33881, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4bde667f/uploads/origins/8a67d9dd-cde4-4c2c-9854-473d272dd642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6b515c7842e81fea68292223043cb30", "srcset": "https://si.imgix.net/4bde667f/uploads/origins/8a67d9dd-cde4-4c2c-9854-473d272dd642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6b515c7842e81fea68292223043cb30, https://si.imgix.net/4bde667f/uploads/origins/8a67d9dd-cde4-4c2c-9854-473d272dd642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b61e8a95d25c88d261c3db188268f81 2x, https://si.imgix.net/4bde667f/uploads/origins/8a67d9dd-cde4-4c2c-9854-473d272dd642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6c29afb41ee0cd20e9fcb228e309119 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4bde667f/uploads/origins/8a67d9dd-cde4-4c2c-9854-473d272dd642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1553e6aba9fd078dc770b24effc89fd2", "srcset": "https://si.imgix.net/4bde667f/uploads/origins/8a67d9dd-cde4-4c2c-9854-473d272dd642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1553e6aba9fd078dc770b24effc89fd2, https://si.imgix.net/4bde667f/uploads/origins/8a67d9dd-cde4-4c2c-9854-473d272dd642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a9584b680c9230cf5471be9d802f1518 2x, https://si.imgix.net/4bde667f/uploads/origins/8a67d9dd-cde4-4c2c-9854-473d272dd642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=da1bbb34b5a3e5e8fa36e127256c245e 3x"}, "body": "続けてのリクエスト申し訳ございません。\nこちらもアーボックと時津風をお願いします。\n\n蛇年という事で蛇の捕食動画を見た時津風がアーボックに対し、獲物を捕らえているように巻き付いて欲しい事、巻き付かれたら全力で抵抗するから本気で締め付けてほしいとお願いし、襲われている設定でお願いします。\n\n今回の構図ですが、襲われているという設定ですのでいつものような3～4巻などの指定はなく、先生が好きなように（倒されている・乱雑に巻き付かれて時津風の腕などは出ている・時津風が暴れていた為一部部分しか巻き付けていないなどお任せします）描いて下さい（ただし、できればアーボックは口を閉じて、舌を出している感じでお願いします）。構図に迷うようでしたらいつものような構図（隙間なく3～4巻で、アーボックの頭は時津風の頭の上に、口を閉じて舌を出す）でお願いします。\n\n時津風の表情などですが\n①いつもと違いアーボックも獲物を捕らえるように全力で襲っているため、暴れて抵抗している。\n②しかし、息を吐いたと同時に締め付けが強くなり、苦しむ。\n③息を吸おうとしても締め付けが強くうまく吸えずに苦しむ。\n④時津風の呼吸にあわせ、アーボックの力も強くなっていき、抵抗する力がほぼなくなる。\n⑤「ああ、いつもは手加減してくれていたんだ・・・。でも、本気で相手してくれてありがとう・・・」と青ざめ、息を引き取るように力尽きる。\n⑥アーボックも流石にやりすぎた！と思い力を弱める。時津風は無事であり、苦しかったが安堵したような表情でゆっくり呼吸をしている。\n①④は目を開け、②③⑤⑥は目を閉じて下さい。\n\n差分ですが、乱雑で隙間があるようでしたら巻き付きを追加する形で、隙間なく巻き付けている場合は首への締め付けも追加でお願いします。又、今回もアーボックの色違いもお願いします。\n差分などは先生のご負担のないように、構図や表情等はあくまでベースですので、先生が描きやすいように変更や追加などして下さい。\n\n今回もご検討をお願い致します。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 46646, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "熊猫", "screen_name": "kumaneko1138", "avatar_url": "https://pbs.twimg.com/profile_images/1496427144633008130/3ITUXL_9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1059891414/1645605497/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 49}, {"id": 59363, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "紅太郎【Skeb募集中】", "screen_name": "kotaro_png", "avatar_url": "https://pbs.