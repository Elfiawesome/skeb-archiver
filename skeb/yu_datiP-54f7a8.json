ます。\nskebを始められたとの事でぜひお願いしたいと思うのですが、アイドルマスターシンデレラガールズの鷺沢文香と佐久間まゆを描いて頂く事は可能でしょうか？\n\n場面はデュオでのLIVEのお仕事（LIVEのステージの上であれば歌唱中でもMC中でもおまかせします）、衣装はシンデレラ・コレクション（カラー）でお願いしたいのですが、文香とまゆの衣装を交換して頂きたいのです。\nソーシャルゲーム版終了にあたりぷちデレラの着せ替えを楽しむ中で気付いてやってみたのですがデュオユニットで衣装交換というのは百合ごころがくすぐられるシチュエーションだと思います。会場の女性ファンが黄色い悲鳴を上げるような感じでお願いできたらと思います。\n\nご多忙中とは存じますが、よろしくご検討頂ければ幸いです。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 60151, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぴこまる", "screen_name": "pikomaruru", "avatar_url": "https://pbs.twimg.com/profile_images/2075570030771871744/3O7g6AqN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/398769744/1734580907/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 565861, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "サ↑ト", "screen_name": "satolive20", "avatar_url": "https://pbs.twimg.com/profile_images/1939344515740930048/fEii-cox.jpg", "header_url": "https://pbs.twimg.com/profile_banners/856096625197891585/1750663162/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 859077, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "根矢崎 稔", "screen_name": "MinoruNeyazaki", "avatar_url": "https://pbs.twimg.com/profile_images/1557010621954400262/bGnmkPZl.png", "header_url": "https://pbs.twimg.com/profile_banners/981769423018123264/1643450240/1500x500", "appeal_receivable": false, "popular_creator_ra