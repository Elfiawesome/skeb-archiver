穏、暗い雰囲気なども合うかと思います。\n金額不足あればお気軽に再送要請出してください。\nよろしければ、何卒よろしくお願いいたします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@JAM_____jjj/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3412184, "client_id": 2844448, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/02442164/uploads/origins/7cae6d6a-0351-4e26-8980-9915ff290acd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35b91836137bd284d5019498686b1363", "srcset": "https://si.imgix.net/02442164/uploads/origins/7cae6d6a-0351-4e26-8980-9915ff290acd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35b91836137bd284d5019498686b1363, https://si.imgix.net/02442164/uploads/origins/7cae6d6a-0351-4e26-8980-9915ff290acd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=069c2cd7f544e5eaad0d28790d7a49c6 2x, https://si.imgix.net/02442164/uploads/origins/7cae6d6a-0351-4e26-8980-9915ff290acd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8456d67ecf0e38b8c19793c001b680f9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/02442164/uploads/origins/7cae6d6a-0351-4e26-8980-9915ff290acd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e25ef568fd0f746648832b659f5496bd", "srcset": "https://si.imgix.net/02442164/uploads/origins/7cae6d6a-0351-4e26-8980-9915ff290acd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e25ef568fd0f746648832b659f5496bd, https://si.imgix.net/02442164/uploads/origins/7cae6d6a-0351-4e26-8980-9915ff290acd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28d880d78236ec4401f9feaab0b54aec 2x, https://si.imgix.net/02442164/uploads/origins/7cae6d6a-0351-4e26-8980-9915ff290acd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d09d30e3926dd76c6fd07c6c2c955b5b 3x"}, "body": "はじめまして。果肉さんの絵柄や仄暗い雰囲気がとても大好きでいつも見させていただいております。\n是非果肉さんの絵柄で見たい二人組がいるためリクエスト失礼します。もし金額に見合わないようでしたら再送していただけると幸いです。\n\nお願いしたいのはクトゥルフ神話TRPGで作成したキャラクターです。\n捜査一課の班長と班員で新人の刑事バディになります。\nキャラクターの詳細や容姿などはURL先にて簡単にまとめています。(TRPGの通過したシナリオのネタバレになるような内容は全て別のフォルダに区分けしてあります。閲覧はお任せいたします。)\n\n構図、シチュエーション等特に指定はありませんのでお好きに描いていただけたらと思います。\n\nいただいたイラストはSNSのアイコン、完全個人利用でのグッズ制作に使用させていただきたいです。\nご縁がありましたら何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1--aXKsjiLelfq5k05AjxstPueTfolrUX", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@JAM_____jjj/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3412184, "client_id": 1407171, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3b7e693/uploads/origins/e9ffcf6e-ad94-4c80-a707-abb1c27531ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3208c42f80d1137e147cbe0fa21c724", "srcset": "https://si.imgix.net/f3b7e693/uploads/origins/e9ffcf6e-ad94-4c80-a707-abb1c27531ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3208c42f80d1137e147cbe0fa21c724, https://si.imgix.net/f3b7e693/uploads/origins/e9ffcf6e-ad94-4c80-a707-abb1c27531ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc1bd5519e55af5bd8a044b20760f468 2x, https://si.imgix.net/f3b7e693/uploads/origins/e9ffcf6e-ad94-4c80-a707-abb1c27531ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=604dc0306ac3d0c7c5cb8b6dd7da352c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3b7e693/uploads/origins/e9ffcf6e-ad94-4c80-a707-abb1c27531ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c69d9d528af216d86c4310cfe52f1d52", "srcset": "https://si.imgix.net/