ukokoa/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3409910, "client_id": 769953, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3801cd6d/uploads/origins/72e09085-0251-4885-a44e-12a8995c031c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9021775791d57bfb3d97d0d02b83f5d", "srcset": "https://si.imgix.net/3801cd6d/uploads/origins/72e09085-0251-4885-a44e-12a8995c031c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9021775791d57bfb3d97d0d02b83f5d, https://si.imgix.net/3801cd6d/uploads/origins/72e09085-0251-4885-a44e-12a8995c031c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2dfee774c28e445ddb00f11e1d111154 2x, https://si.imgix.net/3801cd6d/uploads/origins/72e09085-0251-4885-a44e-12a8995c031c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6eadac36283fe5db4f721f62e00f219 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3801cd6d/uploads/origins/72e09085-0251-4885-a44e-12a8995c031c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c3546017f1cd0198d86ae6202be56bd", "srcset": "https://si.imgix.net/3801cd6d/uploads/origins/72e09085-0251-4885-a44e-12a8995c031c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c3546017f1cd0198d86ae6202be56bd, https://si.imgix.net/3801cd6d/uploads/origins/72e09085-0251-4885-a44e-12a8995c031c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b78db9f117475f1737a8bc34e7cc3b45 2x, https://si.imgix.net/3801cd6d/uploads/origins/72e09085-0251-4885-a44e-12a8995c031c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=287093169694084b9d58aacce5da5226 3x"}, "body": "ここあ様、リクエスト失礼します。\nアピールを送って頂きありがとうございます！もしよろしければお願いしたくリクエストさせて頂きました！\n\nお題はアピールで頂いた通り「ロングヘアのデュラハンの女の子」です。\n以下詳細を記しておりますので、内容ご確認の上でご検討・ご対応頂ければ幸いです。\n色んなクリエイターの方の発想力・想像力・創作力にお任せしたいので、詳細文のほとんどは他の方と同じ内容になっております。その点ご容赦くださいませ。\nご都合が合わない等ということがありましたら遠慮なくキャンセルしてください。\n\n【詳細】\n・髪の長さは頭３つ分かそれ以上の長さが好ましいです。長い髪を描くとなるとご負担がかかると思いますが宜しくお願いします。\n\n・ヘアアレンジに関しては、お団子やシニヨンなどのまとめ髪系は避けてください。\n　髪の長さが分かる状態であれば、一部分や全体を結ぶ・巻く（ウェーブやカール等）・編み込むなどのアレンジはOKです。キャラのイメージに合わせてお好みで決めてください。\n\n・服装に関してはキャラに合わせてお好みでお願いします。\n\n・首の表現に関しては\n　①肌色で塗る\n　②タートルネックのような首元が隠れる・襟のある服装や画角・構図の関係で見えなくする\n　③アクセサリーやチョーカー等による着飾り・装飾品で隠す\n　などの方法を用いたマイルドな表現をお願いします。別アイデアでも構いません。\n　ただし、性的表現や猟奇的表現・「首から炎や煙が出ている」という表現は避けてください。\n　可能なら首部分を描かれる場合は頭側と体側に半々に分かれるように描かれていると嬉しいです。\n\n・頭の持ち方・位置・扱いについては、過去に私がリクエストして描いて頂いた子たち（https://skeb.jp/@hima_ttsu）やSkebの該当キーワードの検索のURL（下記参照）を記載するので、そちらをアイデアの参考にして頂くか、「こういうのもアリでは…？」と思えばそちらでも構いません。\n\n・可能であれば描いて頂いた際の没ラフや、創作時のコンセプト・こだわりポイント等を書いて頂けると嬉しいです！\n要望を書いて良いのであれば構図を考える際にこちら\n（https://x.com/biminarukokoa/status/1765964507204194541）\nのようにいろんなポーズを考察されたのであれば是非拝見できると嬉しいです…といったイメージです。\nさすがにご負担が大幅に増すと思われますのでご判断お任せします。\n\n・納品はPSD形式でお願いします。\n\n・ご不明点等があった際はお好みで判断して描いて下さい。\n\n長文になりましたが、内容以上になります。\nお忙しい中恐縮ですが、お時間のある時に是非ご検討くださいませ。\n\nhttps://skeb.jp/search?q=%22%E3%83%87%E3%83%A5%E3%83%A9%E3%83%8F%E3%83%B3%22&t=works&menu=1&artwork=1", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 8614, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "中時", "screen_name": "nktk358", "avatar_url": "https://pbs.twimg.com/profile_images/1790103088264785922/z8DAAjY1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1511415149592076291/1715529157/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 66222, "creator": true, "nsfw_acceptable": true,