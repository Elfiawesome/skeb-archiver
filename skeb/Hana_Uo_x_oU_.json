/uploads/origins/84604bb7-672b-4131-8c38-f438a9b0f90f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b7850c765bee285a77857211590ebdb 2x, https://si.imgix.net/993f9398/uploads/origins/84604bb7-672b-4131-8c38-f438a9b0f90f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e086efc2138f629ec68d35301b1b8b87 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/993f9398/uploads/origins/84604bb7-672b-4131-8c38-f438a9b0f90f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1eddfa574570a6bb163e271e9cf832b7", "srcset": "https://si.imgix.net/993f9398/uploads/origins/84604bb7-672b-4131-8c38-f438a9b0f90f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1eddfa574570a6bb163e271e9cf832b7, https://si.imgix.net/993f9398/uploads/origins/84604bb7-672b-4131-8c38-f438a9b0f90f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=471e4bf680a5a9efcc168de397f0a57d 2x, https://si.imgix.net/993f9398/uploads/origins/84604bb7-672b-4131-8c38-f438a9b0f90f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3590823fdf9834f54e08a056e38ab931 3x"}, "body": "＊はな＊様、はじめまして。アピールありがとうございます！また、当方のアバターについてたくさん褒めてくださりありがとうございます。とても励みになります。\nクヴァちゃんとシュネーくんのことも見ていただきありがとうございます！とても大切な子たちですので、みていただけて嬉しいです！\nお応えするのが遅くなってしまいましたが、もしまだ当方のアバターに興味がございましたら、イラストを描いていただけないでしょうか。\n\n▼リクエスト内容\n当方のアバターの等身イラストをお願いいたします。\nアピールでご提案いただいた「夜空を背景に当方とクヴァちゃん・シュネーが風で涼んでいるイラスト」でぜひお願いします！\n服装や具体的なポーズや構図、表情等はおまかせしますので、後述するアバターについてや立ち絵資料から自由にキャラクターについて解釈して描いていただければと思います。\nサムネイル等に使用したいため頭部が見切れていないものですと嬉しいです。\nまた、衣装・髪型のアレンジや簡略化等も自由に行っていただいて構いません。\n\n▼アバターについて\n少年型オートマトンのσ0型。細身の少年体型で、外見年齢は15歳ほど。\n身長はおよそ160cmです。\nイメージカラーは杜若色(#4d4398)。\n全体的なイメージは「生意気で勝ち気、活発な少年」です。\nデザインの詳細につきましては資料URLをご参考ください。\n\n▼利用用途\nTwitter・Discord等への掲載やアイコンとしての利用\n配信活動(サムネイルや配信画面、配信告知画像等)への利用\nを想定しております。\n\n▼その他\n上述の利用用途のため、可能であれば人物のみの透過データとキャラクター個別の背景透過データもいただけると嬉しいです。\n\nお忙しい中恐れ入りますが、ご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/13mIGQgZ-RItlOWbKOofabwf77qZBLWGG?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hana_Uo_x_oU_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3551098, "client_id": 1885713, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/10c15002/uploads/origins/d53ab641-9394-4073-a9bd-50066f146f48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6675c03b3711ec020531ca2d6b38e3f4", "srcset": "https://si.imgix.net/10c15002/uploads/origins/d53ab641-9394-4073-a9bd-50066f146f48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6675c03b3711ec020531ca2d6b38e3f4, https://si.imgix.net/10c15002/uploads/origins/d53ab641-9394-4073-a9bd-50066f146f48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=352dc5943b23c208f592bd94f03e19e3 2x, https://si.imgix.net/10c15002/uploads/origins/d53ab641-9394-4073-a9bd-50066f146f48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b723e7e79d068ade89fdaed3e3c6abbe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10c15002/uploads/origins/d53ab641-9394-4073-a9bd-50066f146f48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4aec66dd7fa9f5816eeb6d72e4ad421a", "srcset": "https://si.imgix.net/10c15002/uploads/origins/d53ab641-9394-4073-a9bd-50066f146f48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4aec66dd7fa9f5816eeb6d72e4ad421a, https://si.imgix.net/10c15002/uploads/origins/d53ab641-9394-4073-a9bd-50066f146f48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a76f8ef7d497e89d69b2a6997e1b37a 2x, htt