りできると思うので。\n例（指定ではないです）：口周りに擦り付け跡とか鼻からもぷちゅぷちゅ糞漏らしてるとか、食べ過ぎでぬちぬち喉奥から脱糞してるとか。\n\n宜しければお願いいたします。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 220695, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "湯豆ふ", "screen_name": "yudouhu300000", "avatar_url": "https://pbs.twimg.com/profile_images/1451044957825863687/BENLeUJD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1131469714054451200/1634791717/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 377031, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぴんたま(Pintama)🔞@依頼イラストがんばってます", "screen_name": "pinkytamagoyaki", "avatar_url": "https://pbs.twimg.com/profile_images/1331844907217031170/3Fa1N6lT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1154959858744979456/1600267533/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 48}, {"id": 466092, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "アマツガ🔞Tar7mg", "screen_name": "reica927", "avatar_url": "https://pbs.twimg.com/profile_images/2048701949701468162/lZmKxvpj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/790562694/1671337026/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre