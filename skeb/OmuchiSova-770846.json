3c-9e44-13917759d628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0ada0690e1cd4cdd460cb673fd6b396", "srcset": "https://si.imgix.net/d5e63fd3/uploads/origins/5c47c83a-3cf7-403c-9e44-13917759d628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0ada0690e1cd4cdd460cb673fd6b396, https://si.imgix.net/d5e63fd3/uploads/origins/5c47c83a-3cf7-403c-9e44-13917759d628?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82b483f93968f755e61ed84c7b5c3f77 2x, https://si.imgix.net/d5e63fd3/uploads/origins/5c47c83a-3cf7-403c-9e44-13917759d628?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98d5d34020f2f787a9778d8dbeeabfc9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5e63fd3/uploads/origins/5c47c83a-3cf7-403c-9e44-13917759d628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90905e0c5e1e095f70fde89eb46facbd", "srcset": "https://si.imgix.net/d5e63fd3/uploads/origins/5c47c83a-3cf7-403c-9e44-13917759d628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90905e0c5e1e095f70fde89eb46facbd, https://si.imgix.net/d5e63fd3/uploads/origins/5c47c83a-3cf7-403c-9e44-13917759d628?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32f9f4c9b5fb014547b18747e3a161c7 2x, https://si.imgix.net/d5e63fd3/uploads/origins/5c47c83a-3cf7-403c-9e44-13917759d628?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=68f9d46ec29baeb295a499b53f078faf 3x"}, "body": "初めまして！オムチソバさんのイラストを、いつも拝見しております！\nSkebが開かれているのを確認したため、依頼させていただきたく思っております！\n是非エルフィンちゃんのパン代にしてください……！\n\n\n今回描いていただきたいのは、『アークナイツ』の二次創作キャラクターである、オルフェンという子の立ち絵です。\n立ち絵と資料の詳細はURLに添付しておきます。\n\n概要は\n・オルフェンのトリッカル風立ち絵イラスト。オムチソバさんのオムチちゃんの立ち絵のように、エーリアスのもちほっぺ風でお願いします…\n\n・表情は、ちょっと人を小馬鹿にしているような笑い(表情だけ資料に入れております。)\nほっぺを引っ張られたらめちゃくちゃ涙目になっているかも。\n\n\nオルフェンのキャラクターとしては\n・虚言癖のドラゴン娘。ついでに人間不信でもある。\n・息を吐くように嘘をつくが、内心では心優しく、勝手に嘘を喋ってしまう自分があまり好きではない。\n・それでも人のために生きたいので、医者を志している。\n\nとなっています。\n\nもし宜しければですが、描いてくださると嬉しいです！\nお願いいたします！\n\nhttps://drive.google.com/drive/folders/1CG3eNREtRdl4B8JFaNOVffQitNB2R3Ph", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OmuchiSova/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3839629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef075315/uploads/origins/19b4df7f-a4e3-4789-a9f0-6c792c9500d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f553ca8bd033abee155d516884b9a44f", "srcset": "https://si.imgix.net/ef075315/uploads/origins/19b4df7f-a4e3-4789-a9f0-6c792c9500d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f553ca8bd033abee155d516884b9a44f, https://si.imgix.net/ef075315/uploads/origins/19b4df7f-a4e3-4789-a9f0-6c792c9500d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d471af955118cd7c34a65669a5a5c6d 2x, https://si.imgix.net/ef075315/uploads/origins/19b4df7f-a4e3-4789-a9f0-6c792c9500d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db5dbde4df2ec808a0b8440016178324 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef075315/uploads/origins/19b4df7f-a4e3-4789-a9f0-6c792c9500d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecf6359c9b735ceb974d3bbc27c99e7e", "srcset": "https://si.imgix.net/ef075315/uploads/origins/19b4df7f-a4e3-4789-a9f0-6c792c9500d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecf6359c9b735ceb974d3bbc27c99e7e, https://si.imgix.net/ef075315/uploads/origins/19b4df7f-a4e3-4789-a9f0-6c792c9500d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4