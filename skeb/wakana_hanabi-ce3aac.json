ebp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7190efc468254c03e97df90354e5c217 3x"}, "body": "こんにちはあなたの作品、大好きです\n\nあなたの水着のようにピカピカのスーパーガールをお願いしたいです。\n\nスーパーガールには様々なバージョンがあります。私はこれを考えていました。\nhttps://imgur.com/a/Or10ExE\n\nポーズ、背景、構図は自分で決めてください。\nありがとうございます。早く見たいですねー。\n\nhttps://imgur.com/a/Or10ExE", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wakana_hanabi/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 160296, "client_id": 1231617, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c516959f/uploads/origins/b2685d2b-2471-4216-ba73-0ace82e11fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0c075f011c41c4487345689d297f186", "srcset": "https://si.imgix.net/c516959f/uploads/origins/b2685d2b-2471-4216-ba73-0ace82e11fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0c075f011c41c4487345689d297f186, https://si.imgix.net/c516959f/uploads/origins/b2685d2b-2471-4216-ba73-0ace82e11fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=416f7141bdd2c88298df711850e5479d 2x, https://si.imgix.net/c516959f/uploads/origins/b2685d2b-2471-4216-ba73-0ace82e11fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e5a67472fd4b24fbc06d2aea5c89bf9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c516959f/uploads/origins/b2685d2b-2471-4216-ba73-0ace82e11fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b4c6fa372814a0a5c0fac804027b26c", "srcset": "https://si.imgix.net/c516959f/uploads/origins/b2685d2b-2471-4216-ba73-0ace82e11fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b4c6fa372814a0a5c0fac804027b26c, https://si.imgix.net/c516959f/uploads/origins/b2685d2b-2471-4216-ba73-0ace82e11fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e90872d576cbed0fa314dd998f09ccb9 2x, https://si.imgix.net/c516959f/uploads/origins/b2685d2b-2471-4216-ba73-0ace82e11fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=71bd6453a21e4a327b0071f274b5dc50 3x"}, "body": "ゲーム「恋×罪×彼女」に登場する森野精華の絵を描いてほしいです。同じ構えで2種類のバリエーションがあるので、自分が一番いいと思う構えを決めてください。1枚目は水泳の水着を着て笑っているもの。もうひとつは、地面に横たわり、水着を一部脱いで、乳房（乳首を含む）と膣口が見えるようにしたものです。人目は誘惑するような笑みを浮かべた表情であることが望ましい。外陰部の検閲が必要な場合は、黒い線で覆って、部分的に見えるようにしてください。このような要望を受け入れていただけると幸いです。\n\n参考文献\nhttps://nhentai.net/g/160158/22/", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wakana_hanabi/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 160296, "client_id": 412126, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9099e13e/uploads/origins/8124a94a-5f59-4220-9c9a-25e95470cecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf26c92abcf7a66bb58073e80f1fd730", "srcset": "https://si.imgix.net/9099e13e/uploads/origins/8124a94a-5f59-4220-9c9a-25e95470cecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf26c92abcf7a66bb58073e80f1fd730, https://si.imgix.net/9099e13e/uploads/origins/8124a94a-5f59-4220-9c9a-25e95470cecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=023851289320f62a254922692d94b406 2x, https://si.imgix.net/9099e13e/uploads/origins/8124a94a-5f59-4220-9c9a-25e95470cecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9e7fbb46bb4d11e3e542da4a9d1ecd8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9099e13e/uploads/origins/8124a94a-5f59-4220-9c9a-25e95470cecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ae866b9136cc9e38ff6dd78780c1341", "srcset": "https://si.imgix.net/9099e13e/uploads/origins/8124a94a-5f59-4220-9c9a-25e95470cecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ae866b9136cc9e38ff6dd78780c1341, https://si.imgix.net/9099e13e/uploads/origins/8124a94a-5f59-4220-9c9a-25e95470cecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=01faf1598c0b5789b7d90d3c4da1ca2d 2x, https://si.imgix.net/9099e13e/uploads/origins/8124a94a-5f59-4220-9c9a-25e95470cecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5fb563f4715a615cd81588794f654aa9 3x"}, "body": "素敵なスク水美少女イラストを描かれていたので以下の内容でリクエストしたいです。\n\n●キャラクターはVOICEROIDの琴葉茜\nhttps://aivoice.jp/wp-content/uploads/2022/02/anake_m1.png\nキャラクターガイドラインで\n「第三者に依頼された内容の二次創作イラストを代わりに作成し、有償販売する行為。」が\n許諾不要で利用可とされています\nhttps://aivoice.jp/character/kotonoha/\n\nスクール水着姿で、体型はぺたんこすぎない感じでお願いします。\n\n●シチュエーション\n学校のプールに備え付けられているようなシャワー設備で水を浴びているところで、\n髪を洗っているような、脇が見えるポーズをとらせてほしいです。\n表情差分で恥ずかしそうにしているところもお願いしたいです。\n（一緒にシャワーを浴びていた男子が自分の水着姿をまじまじと見ていることに気づいた、というような感じで）\n\nご検討、よろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wakana_hanabi/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 160296, "client_id": 54649, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/207440ec/uploads/origins/7f22ed65-3809-497f-a788-414329fd9d39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45f7a5cf7f2f45c9789e1a939ef9c2d4", "srcset": "https://si.imgix.net/207440ec/uploads/origins/7f22ed65-3809-497f-a788-414329fd9d39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45f7a5cf7f2f45c9789e1a939ef9c2d4, https://si.imgix.net/207440ec/uploads/origins/7f22ed65-3809-497f-a788-414329fd9d39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b0a988da8c3bc98ac481eb88d1a69bd 2x, https://si.imgix.net/207440ec/uploads/origins/7f22ed65-3809-497f-a788-414329fd9d39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f04932af5de82d67301c753defa52a2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/207440ec/uploads/origins/7f22ed65-3809-497f-a788-414329fd9d39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5ff6208e38dce9651313d649a54cdd5", "srcset": "https://si.imgix.net/207440ec/uploads/origins/7f22ed65-3809-497f-a788-414329fd9d39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5ff6208e38dce9651313d649a54cdd5, https://si.imgix.net/207440ec/uploads/origins/7f22ed65-3809-497f-a788-414329fd9d39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=421e44ed07f78cdbae1f9cbc1afc9167 2x, https://si.imgix.net/207440ec/uploads/origins/7f22ed65-3809-497f-a788-414329fd9d39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e40ed274f95237b7b7c7da96eea6443a 3x"}, "body": "初めまして。女性のイラストをお願いします。\nキャラクター:30歳くらいの女性。3サイズはB90、W60、H95くらい。ムッチムチの安産型。モデル体型ではなく、街中に普通に居そうな感じです。耳が隠れるくらいの癖のある黒髪のショートヘアで、切れ長の釣り目、垂れ眉で困ったような顔をした女性です。前髪はおでこが見えるように真ん中で分けて下さい。\n服装: https://aucfree.com/items/c589816016の競泳水着です。色はDグリーンと表記されていますが資料の色を再現して頂きたいと思います。水に濡れた感じを出してください。新品の競泳水着が身体に馴染んでいない感じを出して頂きたいと思います。\nポーズ: 全身正面絵と全身背面絵をお願いします。 真正面、真後ろを描いて下さい。正面絵は自然体で立っているポーズです。また、背面絵はお尻の食い込みを直している差分もお願いします。可能であればそれぞれのイラストを1枚ずつ分けて描いて頂きたいと思います。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wakana_hanabi/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 160296, "client_id": 780247, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f05acc9/uploads/origins/0aaabac8-78d0-4455-b784-8751f8a67802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bf9b048a3dc43ed8c364e628d96a627", "srcset": "https://si.imgix.net/9f05acc9/uploads/origins/0aaabac8-78d0-4455-b784-8751f8a67802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bf9b048a3dc43ed8c364e628d96a627, https://si.imgix.net/9f05acc9/uploads/origins/0aaabac8-78d0-4455-b784-8751f8a67802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1661003658a4429c3d782027f272265a 2x, https://si.imgix.net/9f05acc9/uploads/origins/0aaabac8-78d0-4455-b784-8751f8a67802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7045920af6fbda58b90115695c8f36be 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f05acc9/uploads/origins/0aaabac8-78d0-4455-b784-8751f8a67802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8ead5237c3527786d600d1dd17f292a", "srcset": "https://si.imgix.net/9f05acc9/uploads/origins/0aaabac8-78d0-4455-b784-8751f8a67802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8ead5237c3527786d600d1dd17f292a, https://si.imgix.net/9f05acc9/uploads/origins/0aaabac8-78d0-4455-b784-8751f8a67802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b93acdbf306e9becde70616c884e4310 2x, https://si.imgix.net/9f05acc9/uploads/origins/0aaabac8-78d0-4455-b784-8751f8a67802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d61669e11c3f6a43fe7ad8ad2cb3664a 3x"}, "body": "はじめまして。Skebの新着作品欄を眺めていたところ、とても素敵なイラストが納品されているのをお見かけし一目惚れしました。\nもし二次創作のキャラクターでも受け付けていただけるのであれば、大好きなキャラクターのイラストを先生の絵柄で拝見してみたくなり、依頼させていただきます。\nご都合が合わない、キャラのイメージが湧かない等、各種ご事情でキャンセルとしていただいてももちろん大丈夫です。\n\n■キャラクター\nアイドルマスターシンデレラガールズから「白雪千夜」ちゃんのスクール水着姿をお願いしたいです。\n原作ゲーム内ではプロデューサー（＝プレイヤー）に対して棘のある物言いが多かったり、クールな表情を見せる子ですが、せっかくのスク水であれば可愛さにステータスを全振りした姿で見てみたいです。\n\n■シチュエーションほか\n以下はシチュエーションのイメージです。（妄想です）\n\n・グラビア撮影？の仕事ということで現場に向かってみると、プロデューサーに用意された衣装がスクール水着だった。\n・水着グラビアでスクール水着…？？　と疑念を浮かべつつも、元来の生真面目さから素直に身に着け、（プール、あるいは海のような場所で）撮影が始まる。\n・他に撮影スタッフがいない状況で、（もしかしてこれはプロデューサーのただの趣味なのでは…？）と騙されて？いることに半ば気付きつつも、少しまんざらでもない表情を浮かべて撮影に応じている…。\n\n・（可能であれば）困り顔/照れ顔/怒った表情…のような表情の差分があると嬉しいです。難しければ照れ顔でお願いしたいです。\n・ポーズ/背景等はすべてお任せいたします。\n・スマホ/PC等の壁紙に使用するため、宛名は別レイヤー保存だと助かります。\n\n水着や肌が水に濡れた際の光沢感、艶が大好きなので、先生の思うがままの質感で表現いただけると嬉しいです。\nまた、水着ということで念のためNSFW設定は有効としていますが、18禁要素は特になくても大丈夫です。（お任せいたします）\n\n以上、強めの妄想でたいへん恐縮です。\nご多忙かと思いますので、内容が合わない、スケジュール等のご都合が合わない等ありましたら遠慮なくキャンセルとしていただいて問題ありません。\n金額面で工数が見合わないということであれば、条件付き再送要請をお送りいただけますと幸いです。\nご検討のほどどうぞよろしくお願いいたします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wakana_hanabi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 160296, "client_id": 637582, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a74e32fc/uploads/origins/0d05a3ee-3994-4375-a268-1ef8eb8772e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61df6e3c514b18b9e41ef81caea470b9", "srcset": "https://si.imgix.net/a74e32fc/uploads/origins/0d05a3ee-3994-4375-a268-1ef8eb8772e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61df6e3c514b18b9e41ef81caea470b9, https://si.imgix.net/a74e32fc/uploads/origins/0d05a3ee-3994-4375-a268-1ef8eb8772e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e1eb57c84b4ad29539294b6a41ff1ed 2x, https://si.imgix.net/a74e32fc/uploads/origins/0d05a3ee-3994-4375-a268-1ef8eb8772e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef124ac2c906e6b41d7fc82579bc1406 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a74e32fc/uploads/origins/0d05a3ee-3994-4375-a268-1ef8eb8772e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s