どもになっても変わりありません）\nよもとびさんの描くこどもたちが好きなんです……！（そして、青年たちも好きです！）\n\nイメージは、鯨たちが子育てをする、温かい明るい海です。\n\nよろしくお願いします。\n\nhttps://absorbing-owl-470.notion.site/18d13b4300e54ffb81df9ba61901451b", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BurningPotus/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1485903, "client_id": 861100, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03e554e3/uploads/origins/b4c92ad7-da3e-4330-96c5-3e4e5442a7ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=996520f84eb486aaef63dc5a98bdaf48", "srcset": "https://si.imgix.net/03e554e3/uploads/origins/b4c92ad7-da3e-4330-96c5-3e4e5442a7ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=996520f84eb486aaef63dc5a98bdaf48, https://si.imgix.net/03e554e3/uploads/origins/b4c92ad7-da3e-4330-96c5-3e4e5442a7ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8628131656bacc8199a6625451d0b3b 2x, https://si.imgix.net/03e554e3/uploads/origins/b4c92ad7-da3e-4330-96c5-3e4e5442a7ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77edf37bdccdb5ba1ab8f4a6648600f6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03e554e3/uploads/origins/b4c92ad7-da3e-4330-96c5-3e4e5442a7ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be9ea4c5e980073076606eab642f4514", "srcset": "https://si.imgix.net/03e554e3/uploads/origins/b4c92ad7-da3e-4330-96c5-3e4e5442a7ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be9ea4c5e980073076606eab642f4514, https://si.imgix.net/03e554e3/uploads/origins/b4c92ad7-da3e-4330-96c5-3e4e5442a7ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d1218be7b45b8f9e5835d712ce632e6a 2x, https: