dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=036d8a1ebbb666fb574756c3b36fb537 3x"}, "body": "環田考様\n\nお世話になっております\n個人V singerの眠井さつきです\n\n　依頼内容\n宇田もずく「□°」 歌ってみた用イラスト\nOCである眠井さつきのイラスト\n(新三面図のデザインで描いていただきたいですが衣装はお任せします)\n髪型・ポーズ・構図は原曲やリファレンスからデザインしていただきたいです\n環田考先生の世界観がとても好きなので前回のように仕上げていただきたいです\n\nリファレンス\nhttps://youtu.be/yP3foFmgcmg?si=Ocl0pra_s-KXyUeL\nhttps://youtu.be/ozw1EG3QORc?si=ihLna8-tyPeu47NM\n\n　使用用途\n 歌ってみた以外に宣伝活動や、動画配信サムネイル、歌ってみたMV用、グッズ等に使用させていただきます\n\n\n　キャラクター詳細\nばーちゃる墓地で墓守を務める少女であり\nノベルゲームの中のキャラクターである人造人間です\n\nhttps://drive.google.com/drive/u/0/folders/1MANUga_NVdnyWpNRBeqzo_fx1PgEmZ8_\n\nご検討よろしくお願いいたします", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kanda_kou/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2856774, "client_id": 1810442, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e20e777d/uploads/origins/cc23d9c8-997a-4b51-af0e-8b8ddf38b3da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f312e025b707362f21f9295bd2741163", "srcset": "https://si.imgix.net/e20e777d/uploads/origins/cc23d9c8-997a-4b51-af0e-8b8ddf38b3da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f312e025b707362f21f9295bd2741163, https://si.imgix.net/e20e777d/uploads/origins/cc23d9c8-997a-4b51-af0e-8b8ddf38b3da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e848bd9f96bfcb4531cb12a64fa2d60 2x, https://si.imgix.net/e20e777d/uploads/origins/cc23d9c8-997a-4b51-af0e-8b8ddf38b3da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2455ccb603f477ba038c61ad346e7ff2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e20e777d/uploads/origins/cc23d9c8-997a-4b51-af0e-8b8ddf38b3da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e442c73ddd72ad61e2e04683d64e7cd", "srcset": "https://si.imgix.net/e20e777d/uploads/origins/cc23d9c8-997a-4b51-af0e-8b8ddf38b3da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e442c73ddd72ad61e2e04683d64e7cd, https://si.imgix.net/e20e777d/uploads/origins/cc23d9c8-997a-4b51-af0e-8b8ddf38b3da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa07ebd5e094a5b0a1459fb9930b1736 2x, https://si.imgix.net/e20e777d/uploads/origins/cc23d9c8-997a-4b51-af0e-8b8ddf38b3da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=594c683d8efe87b6b893c995c78ca3be 3x"}, "body": "環田考様\n\nはじめまして 個人V singerの眠井さつきと申します\n先生の描かれる素敵なイラストに一目惚れしました\n\n　依頼内容\n片方だけが燃えている 歌ってみた用イラスト\nOCである眠井さつきのイラスト\n(新三面図の衣装で描いていただきたいです)\nポーズや構図は原曲からデザインしていただきたいです\n\nリファレンス\nhttps://youtu.be/YyXbQGUfsnE?si=4PrRrkoxV-ZvCsxX\nhttps://skeb.jp/@kanda_kou/works/6　空気感がとても素敵です\n\n\n　使用用途\n 歌ってみた以外に宣伝活動や、動画配信サムネイル、歌ってみたMV用、グッズ等に使用させていただきます\n\n\n　キャラクター詳細\nばーちゃる墓地で墓守を務める少女であり\nノベルゲームの中のキャラクターである人造人間です\n\nhttps://drive.google.com/drive/u/0/folders/1MANUga_NVdnyWpNRBeqzo_fx1PgEmZ8_\n\nご検討よろしくお願いいたします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kanda_kou/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2856774, "client_id": 3670029, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ecd80811/uploads/origins/46a1c8d2-e015-491d-bca2-3abfb90b5deb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47efcf02e52122be9512585a6a32356f", "srcset": "https://si.imgix.net/ecd80811/uploads/origins/46a1c8d2-e015-491d-bca2-3abfb90b5deb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47efcf02e52122be9512585a6a32356f, https://si.imgix.net/ecd80811/uploads/origins/46a1c8d2-e015-491d-bca2-3abfb90b5deb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0eec072a37b326e0f710664505da5b7 2x, https://si.imgix.net/ecd80811/uploads/origins/46a1c8d2-e015-491d-bca2-3abfb90b5deb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcf2039762421f77b0a4e684f836ee8b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ecd80811/uploads/origins/46a1c8d2-e015-491d-bca2-3abfb90b5deb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44ffe0c8a8b1c4f2bb3df84c5f06a539", "srcset": "https://si.imgix.net/ecd80811/uploads/origins/46a1c8d2-e015-491d-bca2-3abfb90b5deb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44ffe0c8a8b1c4f2bb3df84c5f06a539, https://si.imgix.net/ecd80811/uploads/origins/46a1c8d2-e015-491d-bca2-3abfb90b5deb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3e626fead5efb662f7261049ae95782a 2x, https://si.imgix.net/ecd80811/uploads/origins/46a1c8d2-e015-491d-bca2-3abfb90b5deb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=87445f43c0fbceea93481a5bdd3c32dc 3x"}, "body": "お世話になっております。2回目の依頼です。直近ですみません🙇🏻‍♀️\n\n今回も歌ってみたの1枚絵のイラストを依頼したいです。\n曲名は「ただ君に晴れ/ヨルシカ」です。\nイラストイメージは本家様のMVのような制服を着て海辺を歩くシーンがイメージです。\n\nキャラクターデザインは\n→腰くらいの長さ、ストレー\nト、髪色グレー、前髪ぱっつん\n（眉くらいの長さ）\n目→つり目、目の色青\n表情→お任せします\n服→ 制服\n装飾品→頭に髪飾りとして百合の花が欲しいです\n\nよろしくお願い致します🙏", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kanda_kou/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2856774, "client_id": 3670029, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4ac5772/uploads/origins/446f18ec-64c7-4bc8-9595-8f0486f65e25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a6c27dbead625380b07a572becbb4b6", "srcset": "https://si.imgix.net/a4ac5772/uploads/origins/446f18e