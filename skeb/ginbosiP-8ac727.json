t/notes/9or6arqe68\nhttps://voskey.icalo.net/notes/9qs6s518j7", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ginbosiP/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3520885, "client_id": 2801967, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96219c04/uploads/origins/84309e51-8146-4f76-b0f4-c65de7a6145b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=978aa329c528ef5bf5413c4cded04cb7", "srcset": "https://si.imgix.net/96219c04/uploads/origins/84309e51-8146-4f76-b0f4-c65de7a6145b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=978aa329c528ef5bf5413c4cded04cb7, https://si.imgix.net/96219c04/uploads/origins/84309e51-8146-4f76-b0f4-c65de7a6145b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c17d8b5b2e37b468a69ee0af59fb9c9 2x, https://si.imgix.net/96219c04/uploads/origins/84309e51-8146-4f76-b0f4-c65de7a6145b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=829756273d36160337af0e522a5a1384 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96219c04/uploads/origins/84309e51-8146-4f76-b0f4-c65de7a6145b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6f93a3e655cde215927ebb269248467", "srcset": "https://si.imgix.net/96219c04/uploads/origins/84309e51-8146-4f76-b0f4-c65de7a6145b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6f93a3e655cde215927ebb269248467, https://si.imgix.net/96219c04/uploads/origins/84309e51-8146-4f76-b0f4-c65de7a6145b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8da2a037d56c0d422f310c1b38d0bb75 2x, https://si.imgix.net/96219c04/uploads/origins/84309e51-8146-4f76-b0f4-c65de7a6145b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr