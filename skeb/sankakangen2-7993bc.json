資料\n\n以上になります。\nもし可能であれば是非よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1JIfi88SpC7qu52Z3b2prQdFW-yoYJcNl?usp=sharing", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sankakangen2/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2978963, "client_id": 2331570, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fbff9b3a/uploads/origins/2a6953ad-b52b-4ef0-9864-5bf963f833e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25645d3b39a03517b3027b8eb4eb1dbd", "srcset": "https://si.imgix.net/fbff9b3a/uploads/origins/2a6953ad-b52b-4ef0-9864-5bf963f833e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25645d3b39a03517b3027b8eb4eb1dbd, https://si.imgix.net/fbff9b3a/uploads/origins/2a6953ad-b52b-4ef0-9864-5bf963f833e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae2ec7d6bdc342defbb6d3662b7cd5c9 2x, https://si.imgix.net/fbff9b3a/uploads/origins/2a6953ad-b52b-4ef0-9864-5bf963f833e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c79451cb398d8980281cef4b6fb33ffd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fbff9b3a/uploads/origins/2a6953ad-b52b-4ef0-9864-5bf963f833e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a21d25cf5bbb52f94f354f21a59d2e4", "srcset": "https://si.imgix.net/fbff9b3a/uploads/origins/2a6953ad-b52b-4ef0-9864-5bf963f833e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a21d25cf5bbb52f94f354f21a59d2e4, https://si.imgix.net/fbff9b3a/uploads/origins/2a6953ad-b52b-4ef0-9864-5bf963f833e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d4ad7e851a196682cd6abb1356d1d1d1 2x, https://si.imgix.net/fbff9b3a/uploads/origins/2a6953ad-b5