だけが取り柄ならば\n\nさぁ今すぐそんな人類は\n丸い地球と同じように\n滅亡させてしまおうか!!\n\n\n長々と失礼致しますが、こちらの内容でよろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@fuku_O_fuku/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2852325, "client_id": 2753041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e23dc934/uploads/origins/46e6e931-cd05-4274-864f-2da33c45159c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f4d9a1e83e99f7f0b0fe0daf3922a99", "srcset": "https://si.imgix.net/e23dc934/uploads/origins/46e6e931-cd05-4274-864f-2da33c45159c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f4d9a1e83e99f7f0b0fe0daf3922a99, https://si.imgix.net/e23dc934/uploads/origins/46e6e931-cd05-4274-864f-2da33c45159c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18b79e26e9c69c45e34ddefe947d712f 2x, https://si.imgix.net/e23dc934/uploads/origins/46e6e931-cd05-4274-864f-2da33c45159c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06f691200d3d9dce91077986ade00620 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e23dc934/uploads/origins/46e6e931-cd05-4274-864f-2da33c45159c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59b2165290c9f0e99209693b07906aad", "srcset": "https://si.imgix.net/e23dc934/uploads/origins/46e6e931-cd05-4274-864f-2da33c45159c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59b2165290c9f0e99209693b07906aad, https://si.imgix.net/e23dc934/uploads/origins/46e6e931-cd05-4274-864f-2da33c45159c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2bdd403e271e4866b4b537b462f06d26 2x, https://si.imgix.net/e23dc934/uploads/origins/46e6e931-cd05-4274-864f-2da33c45159c?bg=%23fff&auto=f