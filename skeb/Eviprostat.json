%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ecd0effca9f33635e051e72c8d71840", "src_set": ""}, "body": "こんにちは！あなたのアートスタイル、特にヴェレックのアートワークが大好きです！\n\n私のVTuberヒーローキャラクターカイザーを描いてほしいです！古典的なJRPG/ファンタジーアニメの主人公です！好きなものを自由に描いてください！\n\nもし全身を描いてくれるなら、背景なしのバージョンも欲しいです！\n\nhttps://drive.google.com/drive/u/0/folders/1UpO0pg9tMI3vcEW6uxJsa1N9lS7Idzm1", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Eviprostat/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 253208, "client_id": 680176, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff57950c/uploads/origins/8652a618-5c22-4d85-84e4-9c8c1df66d55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=995d0ffff226e64701d8fc11079b47fa", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff57950c/uploads/origins/8652a618-5c22-4d85-84e4-9c8c1df66d55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a4126e12beb2efaee54dcad5b152a1d", "src_set": ""}, "body": "こんにちは！貴方のイラストがとても素敵だったので出来れば伺いました。\n\n人物ー英雄伝説 黎の軌跡 フィー・クラウゼル ( https://imgur.com/a/hMjK6vG )\n衣装などはお任せで御願いします\n\nこちらの動画( https://youtu.be/8fyf0j7H7_I , https://youtu.be/EItUxLTs8LM )\nから宙に浮いて銃撃をしているところを描いて頂きたいです！\n詳しい構図などはお任せで御願いします\n\n読んで頂きありがとうございます！よろしくお願いします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Eviprostat/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 253208, "client_id": 959068, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/14a9cfec/uploads/origins/c17c4936-782d-4ecd-904f-31deb3f27d3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3705a1387c5d6d6dde04033dd61a03b5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/14a9cfec/uploads/origins/c17c4936-782d-4ecd-904f-31deb3f27d3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=126f5e11e4ebb4584a409981c0d4dca4", "src_set": ""}, "body": "こんにちは！あなたのアートが大好きです。このキャラクターが別の服を着て、参考資料にあるポーズをして喜んでいるアートを手に入れたいと思っていたんだ。彼は興奮しているはずです。1枚目がキャラクター、2枚目が服、3枚目がポーズです。ありがとう！\n\nhttps://imgur.com/a/JCSBR9A", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Eviprostat/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 253208, "client_id": 3275772, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f207be2/uploads/origins/d42fae69-e1ee-4b63-b711-4ee0336ae51e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e934ceef9cac4435cad296e150267779", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f207be2/uploads/origins/d42fae69-e1ee-4b63-b711-4ee0336ae51e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f040c43b68a8d39e1edacaab4337c71c", "src_set": ""}, "body": "VtuberのRebbi Rompinのアートが欲しい。彼女は生意気なイモウトのカエルだ。彼女のファンマスコットのフロブルを水鉄砲で撃ってほしい。Frobbleはカエルに似た浮遊泡。レビの胸はぺったんこ。尻尾も忘れずに。その他はお好みで。\n\nRebbiと水鉄砲参考：https://imgur.com/a/DuTUV0h\nフロブル参考：https://imgur.com/a/HcvzIHB", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Eviprostat/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 253208, "client_id": 1976843, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7be7414/uploads/origins/f0d30b1a-695b-45be-aa62-f8db6af4d069?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a451c26805a80db470dc15deb94bac30", "src_set": "