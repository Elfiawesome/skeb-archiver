もちゃん】\n普段の容姿で、上はストライプ柄のユニフォームを着ている。服装はねもちゃんの好きな私服でお願いします。\n\nいわゆる夢絵みたいな感じですが、ねもちゃんの描きやすいように描いていただけたら嬉しいです！よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 888212, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "蒼透@2Dデザイナー／リクエスト絵４件作業中！🌟", "screen_name": "soutou_aotou", "avatar_url": "https://pbs.twimg.com/profile_images/2015281372626321409/T05RftQ6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/245363032/1650039811/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 1237950, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "月わに", "screen_name": "tukiwani", "avatar_url": "https://pbs.twimg.com/profile_images/1514987498308792320/P0GpBHjG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/391669812/1673595889/1500x500", "appeal_receivable": false, "popular_creator_rank": 65, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 1285374, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ぼる吉@Skeb募集中‼️", "screen_name": "Bol7_", "avatar_url": "https://pbs.twimg.com/profile_images/1626520456848359425/7Spa4bRk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1406096631540322307/1672764254/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 50, "skills": [{"genre": "art"}