］\nシンボリルドルフみたいな感じ)をしているのをお願いいたします。\n皐月賞の年度は決めてないので、ウマ娘verの優勝レイでお願いいたします。\n\nよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kacchan_DK_srtk/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3379086, "client_id": 2592670, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c3a324a/uploads/origins/ad4c8565-2f0c-4dd6-94bc-163768ecdc73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=134a2f7a156efd7993781e28869ceec1", "srcset": "https://si.imgix.net/9c3a324a/uploads/origins/ad4c8565-2f0c-4dd6-94bc-163768ecdc73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=134a2f7a156efd7993781e28869ceec1, https://si.imgix.net/9c3a324a/uploads/origins/ad4c8565-2f0c-4dd6-94bc-163768ecdc73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a52fbc927a283d3ac2b1f85f2271735 2x, https://si.imgix.net/9c3a324a/uploads/origins/ad4c8565-2f0c-4dd6-94bc-163768ecdc73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21836294034f1cf6ebf0c3e4e206cf61 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c3a324a/uploads/origins/ad4c8565-2f0c-4dd6-94bc-163768ecdc73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c60f5faaed12cff605de5d355dc7975c", "srcset": "https://si.imgix.net/9c3a324a/uploads/origins/ad4c8565-2f0c-4dd6-94bc-163768ecdc73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c60f5faaed12cff605de5d355dc7975c, https://si.imgix.net/9c3a324a/uploads/origins/ad4c8565-2f0c-4dd6-94bc-163768ecdc73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2e38afc156a46907ff4bbeee01ad7ee2 2x, https://si.imgix.net/9c3a324a/uploads/origins/ad4c8565-2f0c-4dd6-94bc-163768ecdc73?bg=%23fff&a