lur=200&s=c297dedac08bf892578b6192802e2d44 2x, https://si.imgix.net/54423e23/uploads/origins/aab946be-878b-45aa-a299-2200f588b91f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=92dcb4a912341a0fd4dc89a2dc7d3a37 3x"}, "body": "初めまして。\nXにてオリジナルウマ娘を語るスペースを拝見して、とてもオリジナルウマ娘愛にあふれる方だと感じぜひうちの子も描いて頂きたくリクエストを送らせていただきました。\n\n描いて頂きたいのは私のオリジナルウマ娘であるプロフェッサーです。\nシチュエーションといたしましてはこれからの時期に合わせて、雪だるまを作り満足げな表情で隣に立つうちの子をお願いいたします。\n以下詳細\n・雪だるまは大体身長と同じくらいの大きさ。\n・服装は冬制服＋マフラーと手袋\n・手に雪かきスコップ\n・表情は「むふー」といった感じの満足げな表情\n\n不明点・記載のない箇所に関しましては絵師様にお任せいたします。\n難しい・気乗りしない、内容と金額が釣り合わないなど問題ありそうであれば遠慮なくキャンセルなどの対応をしていただいて構いません。\n\n資料（https://drive.google.com/drive/folders/1ylAodGy9tkSuhmROnSg8MeX0tSkV6wHi?usp=sharing）\n\nhttps://drive.google.com/drive/folders/1ylAodGy9tkSuhmROnSg8MeX0tSkV6wHi?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kacchan_DK_srtk/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3379086, "client_id": 174951, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/acf1141b/uploads/origins/140ca109-2fab-4f48-8468-d0cd77cca064?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a1515c14db1515dd3ebcaafadde080a", "srcset": "https://si.imgix.net/acf1141b/uploads/origins/140ca109-2fab-4f48-8468-d0cd77cca064?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a1515c14db1515dd3ebcaafadde080a, https://si.imgix.net/acf1141b/uploads/origins/140ca109-2fab-4f48-8468-d0cd77cca064?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e12390aa93e4f51de722249700c03a51 2x, https://si.imgix.net/acf1141b/uploads/origins/140ca109-2fab-4f48-8468-d0cd77cca064?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b82f02b4e5a89d3d87d113405bd3c4c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/acf1141b/uploads/origins/140ca109-2fab-4f48-8468-d0cd77cca064?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4c0a623c454995fb92da8eaf8cb57b1", "srcset": "https://si.imgix.net/acf1141b/uploads/origins/140ca109-2fab-4f48-8468-d0cd77cca064?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4c0a623c454995fb92da8eaf8cb57b1, https://si.imgix.net/acf1141b/uploads/origins/140ca109-2fab-4f48-8468-d0cd77cca064?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=371256738340939bae3e145ffb46a92a 2x, https://si.imgix.net/acf1141b/uploads/origins/140ca109-2fab-4f48-8468-d0cd77cca064?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=721bd953ae8b2ecf9818a4962a78aa17 3x"}, "body": "新規リクエスト失礼します\n\nとても好みの絵柄だったのでリクエストさせて頂きました\n\n今回描いて頂きたいのは自分のオリジナルウマ娘｢スターダストレオ｣、かっちゃんさんのオリジナルウマ娘｢シャドウヴォルフ｣と｢ウマ娘プリティーダービー｣の｢メジロドーベル｣、｢僕のヒーローアカデミア｣の｢相澤消太｣と｢心操人使｣のイラストです\n\nシチュエーションを以下に併記します\n\n服装 レオと心操くんは｢雄英高校｣のジャージ 相沢先生は普段と同じ服装 ドーベルとヴォルフは｢雄英高校｣の冬制服\n\n・レオが｢操縛布(相沢先生と心操くんの武器)｣の練習をしてる\n↓\n・上手くいかずにぐるぐる巻きになってしまい｢どうしてですかぁ～……｣と半泣きになる\n↓\n・それを見て心操くんと相沢先生が｢ここはこうして……｣という感じでレオに使い方を教える\n↓\n・それを少し遠くからドーベルが｢頑張って、レオ……！｣とハラハラしながら見てる\n↓\n・更にその遠くから練習風景を見てたヴォルフが｢何だアレ、めちゃくちゃカッコイイ……！｣となるコマで終了\n\n\nスターダストレオの外見や設定は過去に依頼したもののURLを載せておきますのでご確認ください\nhttps://skeb.jp/@yoino_iyo2/works/12\nhttps://skeb.jp/@yoinoiyo/works/1\nhttps://skeb.jp/@yoinoiyo/works/8\nhttps://skeb.jp/@ayanin13/works/19\n\nその他指定してない箇所はお任せします\n\n変わったご依頼になりまして恐縮ですが、ご検討いただけますと幸いに存じます", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kacchan_DK_srtk/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3379086, "client_id": 2071880, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7405e3c/uploads/origins/7f15844b-45a0-4c81-86fe-59fb467f53e5?bg=%23fff&auto=