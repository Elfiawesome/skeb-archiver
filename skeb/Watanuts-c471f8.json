ss&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e7ca58ac611143592cdf4a150cb5ba5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7560e0c7/uploads/origins/13ca4352-7100-4fb4-bcac-a4bf1bb2730c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee274a6156196775015f8a288998c7c9", "srcset": "https://si.imgix.net/7560e0c7/uploads/origins/13ca4352-7100-4fb4-bcac-a4bf1bb2730c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee274a6156196775015f8a288998c7c9, https://si.imgix.net/7560e0c7/uploads/origins/13ca4352-7100-4fb4-bcac-a4bf1bb2730c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e5eb782f9263dda27d15fe394c726162 2x, https://si.imgix.net/7560e0c7/uploads/origins/13ca4352-7100-4fb4-bcac-a4bf1bb2730c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6f978a0e40060aa6ae4f9072677efc00 3x"}, "body": "ミヤコの黒タイツの描き方がとても好みだったので私もリクエストしてみました。\n\nプリコネのミヤコに憑依されたユイをお願いします。\n\n取り憑かれた影響で衣装がミヤコのものに変化。\n衣装のサイズは体に合わせますが、衣装全体の丈だけは合わず、スカートを腰に着ているような状態で黒タイツ越しからパンツがモロ出しをお願いします。\n\n表情は恥ずかしくもなく、キシシと目を開いてガキっぽく笑う表情。\n髪飾りはユイが元からあるもの装着。\nパンツはピンクの縞々。\n片手にプリン持ち。\n全身絵の正面向きでお願い致します。\n可能なら白タイツの差分が欲しいです。\n\nご検討よろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Watanuts/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 15601, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11fc2a90/uploads/origins/b210cfb6-d11a-4ff4-9c7d-a351873d6dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7024800837015bb4346819bfb9a565a6", "srcset": "https://si.imgix.net/11fc2a90/uploads/origins/b210cfb6-d11a-4ff4-9c7d-a351873d6dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7024800837015bb4346819bfb9a565a6, https://si.imgix.net/11fc2a90/uploads/origins/b210cfb6-d11a-4ff4-9c7d-a351873d6dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a67c0a028e9ff2c5d1d7c93df4fdd9aa 2x, https://si.imgix.net/11fc2a90/uploads/origins/b210cfb6-d11a-4ff4-9c7d-a351873d6dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3096367119f24bbe780571548d68af60 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11fc2a90/uploads/origins/b210cfb6-d11a-4ff4-9c7d-a351873d6dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5030d017718054e133043d510b464764", "srcset": "https://si.imgix.net/11fc2a90/uploads/origins/b210cfb6-d11a-4ff4-9c7d-a351873d6dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5030d017718054e133043d510b464764, https://si.imgix.net/11fc2a90/uploads/origins/b210cfb6-d11a-4ff4-9c7d-a351873d6dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0afb0e1092e95124451be4a0cf7a29fc 2x, https://si.imgix.net/11fc2a90/uploads/origins/b210cfb6-d11a-4ff4-9c7d-a351873d6dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7aab1528f5af074c34995297c60b27ef 3x"}, "body": "今回も艦これの時津風がポケモンのアーボックに巻き付かれている絵をお願いします。\n\nアーボックに巻き付かれる前からで\n①アーボックが目の前に現れ「大きな蛇さんだー」みたいな表情で危機感がない。\n②巻き付かれ初めて？みたいになっている。\n③半分ぐらい巻き付かれて「やめてよ～」みたいになっている。\n④全身巻き付かれて「は、離せ～」みたいになっている。その時アーボックの頭は時津風の頭の上にあり舌を出している(前回の絵のような感じです)\n⑤締め付けが始まり「嫌！」みたいになっている。\n⑥だが全力ではなく気持ちよくて感じてしまっている。\nをベースにして頂けると嬉しいです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Watanuts/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 15601, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9861ff5e/uploads/origins/c15a99fc-5d09-4759-8838-4b5e6549cd04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a48056c547c3644d31982e6caa85b612", "srcset": "https://si.imgix.net/9861ff5e/uploads/origins/c15a99fc-5d09-4759-8838-4b5e6549cd04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a48056c547c3644d31982e6caa85b612, https://si.imgix.net/9861ff5e/uploads/origins/c15a99fc-5d09-4759-8838-4b5e6549cd04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd210c6b3825a134f663b83d66895615 2x, https://si.imgix.net/9861ff5e/uploads/origins/c15a99fc-5d09-4759-8838-4b5e6549cd04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00371bb525f008ab324bfbf1ee27503a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9861ff5e/uploads/origins/c15a99fc-5d09-4759-8838-4b5e6549cd04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5574ee9bd55d21004e8aa7500ae9b2f3", "srcset": "https://si.imgix.net/9861ff5e/uploads/origins/c15a99fc-5d09-4759-8838-4b5e6549cd04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5574ee9bd55d21004e8aa7500ae9b2f3, https://si.imgix.net/9861ff5e/uploads/origins/c15a99fc-5d09-4759-8838-4b5e6549cd04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=96fc7138899c3adab6e0ec775451e014 2x, https://si.imgix.net/9861ff5e/uploads/origins/c15a99fc-5d09-4759-8838-4b5e6549cd04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6dbc659334ec9454bba8a1c673febc75 3x"}, "body": "ハッカドール３号がポケモンのアーボックに巻き付かれている絵をお願いします\nアーボックは３号の全身を４巻程で(首から下は足元まで隙間なく)巻き付け、３号の頭の上に頭を乗せ鼻の付近まで舌を出して下さい。口は閉じて下さい\n全身巻き付かれている事を強調する為、３号の全身をお願い致します\n差分が大丈夫ならアーボックは通常色と色違いを、尻尾で首を巻き付けているのといないのをお願いします\n３号の表情ですが、（①と④を優先で）\n①涙目で苦しんでいる\n②苦しんでいるけど若干感じていて赤面になっている\n③苦しいけど若干気持ちよくて恥ずかしがっている\n④嬉しくて笑っている\n①②は目を閉じ③④は目を開けて下さい", "nc": 176, "word_count": 0, "transcoder": "imag