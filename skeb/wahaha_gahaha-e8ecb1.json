00&s=2ffe152f3a3f1883da6de5654ff500fa, https://si.imgix.net/71724dbb/uploads/origins/aad35fe4-31f2-4aa9-bdc2-5ebe783e2503?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=54aba007d674063a2ad11eae875c1aac 2x, https://si.imgix.net/71724dbb/uploads/origins/aad35fe4-31f2-4aa9-bdc2-5ebe783e2503?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=18cf6f22cebde96fb6bbf34b4587bbf1 3x"}, "body": "初めまして\n歌い手・IRIAMライバーえんと申します。\n△様の立ち絵を拝見し、色合いや表情がどれも好きで、skebが無いかなととても気になっておりました！\n開かれたとのことで、リクエスト失礼致します。\n【キャラ】\n内気で1人が好き、歌うことがすきで相棒の狐の力を借りて人前に出ることができる。金木犀も好き。\n\n【イラスト】\n全てお任せしたいです。オリジナルの衣装など可でしたら△様の好みのものを見たいです。\n※背景(がある場合)透過差分の希望・頭や手を切れずに入れ込んで頂けますとありがたいです。\n\n【特徴】\nオッドアイ、金木犀のタトゥー、くるくるアホ毛、ばさばさまつ毛、八重歯\n\n【用途】サムネイル・SNS掲載・一部リスナー様への返礼品としてのお渡し\n\n\nご検討のほどよろしくお願い致します🙇\n↓キャラの衣装や特徴資料\nhttps://drive.google.com/drive/folders/1-8YD3v7B9KoxA9pDuS_dM5a_Mh0I2NC7", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@1sou_otkum/works/146", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1290917, "client_id": 2657918, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d9ce902/uploads/origins/dd46e79b-2c0a-42c9-af25-ffe87588d5be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b39d8d04c14099406e6c24bc2664dd83", "srcset": "https://si.imgix.net/9d9ce902/uploads/origins/dd46e79b-2c0a-42c9-af25-ffe87588d5be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b39d8d04c14099406e6c24bc2664dd83, https://si.imgix.net/9d9ce902/uploads/origins/dd46e79b-2c0a-42c9-af25-ffe87588d5be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57f7815a752190f5a5a9bc05443a6bfe 2x, https://si.imgix.net/9d9ce902/uploads/origins/dd46e79b-2c0a-42c9-af25-ffe87588d5be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=834cf2e02523c40baaa8934036090294 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d9ce902/uploads/origins/dd46e79b-2c0a-42c9-af25-ffe87588d5be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2c561cafacae670a1ed5bbc595e4056", "srcset": "https://si.imgix.net/9d9ce902/uploads/origins/dd46e79b-2c0a-42c9-af25-ffe87588d5be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2c561cafacae670a1ed5bbc595e4056, https://si.imgix.net/9d9ce902/uploads/origins/dd46e79b-2c0a-42c9-af25-ffe87588d5be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b92dd9692caa3ebf6b4682a70e7081f6 2x, https://si.imgix.net/9d9ce902/uploads/origins/dd46e79b-2c0a-42c9-af25-ffe87588d5be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=488ede4026a1fe6dfed1b5db80f21a2c 3x"}, "body": "うめまつ様\nはじめまして…！リクエスト失礼致します。\n先月の末にATHENAを通過し、END2を迎えました。本当にNPC達やシナリオが大好きで終わってからもずっと思いを馳せています…。大好きです。\n\nskebを募集されているのを拝見して、\n以前からリクエストしたいと思っておりまして、ATHENAを通過した今、これを機に…！とリクエストさせて頂きました…。\n\n【依頼内容】\n五木さんと弊HO2の漫画を描いて頂きたいです。\n内容は、2人になった時のHO2に対しての名前呼びや、素の抜けた五木さんが大好きなので、五木さんとHO2のなんでもない日の会話がみてみたいです。\n\nーーーーーーーー\n\n【弊HO2について】\n今浅　惟昊(いまあさ　いそら)　32歳　175㎝\n・男性\n・基本的伏せ目\n・喫煙者\n（銘柄は気にせず買っている。ポケット内のタバコの箱いつもくちゃくちゃ）\n・天気は晴れが好き\n\n一人称：僕\n二人称：お前\n三人称：苗字\n利き手：左\n\n性格：気が強くて、心配故に怒りっぽく、世話焼きで仲間思いな子です。不器用であまり素直に思ってる事を言わない性格です。\n\n好きな物：塩ラーメン、餃子\n\n【五木さんとの関係性】\n上司として振舞われているときも1対1の時も呼び方や態度はあまり変わらず「五木」と呼んでいます。\n\n弊HO2は神話的事象で家族を失っているのですが、15歳の頃に第一部隊に入隊した後、同期且つ少し上の兄のような、家族の様に五木さんの事を心内で思っています。\n\n身近だった五木さんの無意識に影響をかなり受けていて、煙草を吸い始めたのも、拳銃をメイン武器にしているのも五木さんの影響で持っていました。五木さんにHO2が贔屓目に見られていることも分かっており、自分のやることは大体許してくれると勝手に思っています。\n\n昔に五木さんに面倒を見てもらったツケが回ってきたのか、第一部隊に入ってきた少し生意気なHO3をHO2が世話を焼いてる様な関係性です。\n\nーーーーーーーー\n\n参考の為にと細かく書いておりますがあまり気にせず、お好きな様に描いていただけますと幸いです。\n服装も私服でもエージェントの服装でも全てお任せ致します。（私服の場合好きな様に着せて頂いて大丈夫です！）\n\n長文になってしまい大変申し訳ございません。\nもしもご縁がございましたら何卒よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1zBsH_FeQPPLqGrnrN-nNSyeWV7O85bIW", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@denpawarukunai/works/170", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1981232, "client_id": 2657918, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/076b760e/uploads/origins/9c84cef5-53ec-4f8f-b8d9-415541247ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef7c9c7c561f9f5cb938cbc96fa79ca9", "srcset": "https://si.imgix.net/076b760e/uploads/origins/9c84cef5-53ec-4f8f-b8d9-415541247ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef7c9c7c561f9f5cb938cbc96fa79ca9, https://si.imgix.net/076b760e/uploads/origins/9c84cef5-53ec-4f8f-b8d9-415541247ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d54e97dd05fbb7623ec0b623e99b0c1b 2x, https://si.imgix.net/076b760e/uploads/origins/9c84cef5-53ec-4f8f-b8d9-415541247ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12c52f5f3efcae3a79f75cbaa22da3a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/076b760e/uploads/origins/9c84cef5-53ec-4f8f-b8d9-415541247ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7427a2e255327acecbd5957e830122c", "srcset": "https://si.imgix.net/076b760e/uploads/origins/9c84cef5-53ec-4f8f-b8d9-415541247ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7427a2e255327acecbd5957e830122c, https://si.imgix.net/076b760e/uploads/origins/9c84cef5-53ec-4f8f-b8d9-415541247ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3c304b276959564f29b719aee9f12913 2x, https://si.imgix.net/076b760e/uploads/origins/9c84cef5-53ec-4f8f-b8d9-415541247ff3?bg=%23fff&auto=fo