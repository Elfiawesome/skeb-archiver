に→https://skeb.jp/@mgr_skb/works/142）\n金額内で出来る分、複数で制作可能でしょうか？\n\n【参考資料】\n→　https://drive.google.com/drive/folders/1gOOMu37reFXhweofGk2DDbpxaHlczj7u?usp=drive_link\n\nキャラクターは『朝』がイメージになっています。\nペットの豚さんもいます。\nファンタジーな世界観に存在しています。\n笑顔だったり、きょとんとしていたり、怒っていたり、色んな表情があると嬉しいです。\n\n【使用用途】\n①TwitchやX、YouTubeなどのSNSアカウントのヘッダー\n②動画のサムネイルなどに使用\n③その他配信活動上で使用予定です", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@O3o2Sao/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3584516, "client_id": 3425525, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1474866/uploads/origins/9d8b1c75-1811-4881-aa79-a4731d0d21d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15133a7f7c67456bc9917a70b18a27f8", "srcset": "https://si.imgix.net/e1474866/uploads/origins/9d8b1c75-1811-4881-aa79-a4731d0d21d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15133a7f7c67456bc9917a70b18a27f8, https://si.imgix.net/e1474866/uploads/origins/9d8b1c75-1811-4881-aa79-a4731d0d21d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d67dea7b75c3a896e30f443d1a39b5c 2x, https://si.imgix.net/e1474866/uploads/origins/9d8b1c75-1811-4881-aa79-a4731d0d21d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=139eb380b7f2f6a1224b4609e7c45810 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1474866/uploads/origins/9d8b1c75-1811-4881-aa79-a4731d0d21d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e59ff09b056cc16c2a9c5b02f1b64111", "srcset": "https://si.imgix.net/e1474866/uploads/origins/9d8b1c75-1811-4881-aa79-a4731d0d21d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e59ff09b056cc16c2a9c5b02f1b64111, https://si.imgix.net/e1474866/uploads/origins/9d8b1c