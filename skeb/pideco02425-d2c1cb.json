ped": true, "creator_id": 346917, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5565f71a/uploads/origins/c95d3417-efcd-42e4-a5dc-4fa974fe6e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83a2253bca7f5a6f7e733a4c05292706", "srcset": "https://si.imgix.net/5565f71a/uploads/origins/c95d3417-efcd-42e4-a5dc-4fa974fe6e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83a2253bca7f5a6f7e733a4c05292706, https://si.imgix.net/5565f71a/uploads/origins/c95d3417-efcd-42e4-a5dc-4fa974fe6e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43238567871e50123dfd4ae9f9370520 2x, https://si.imgix.net/5565f71a/uploads/origins/c95d3417-efcd-42e4-a5dc-4fa974fe6e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ccd390a3cb2ca862c4930e56d918eef 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5565f71a/uploads/origins/c95d3417-efcd-42e4-a5dc-4fa974fe6e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2499ff7371d5f5b57e5706032a094fc8", "srcset": "https://si.imgix.net/5565f71a/uploads/origins/c95d3417-efcd-42e4-a5dc-4fa974fe6e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2499ff7371d5f5b57e5706032a094fc8, https://si.imgix.net/5565f71a/uploads/origins/c95d3417-efcd-42e4-a5dc-4fa974fe6e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d3863ddcc2b8e85984f7e2771888325a 2x, https://si.imgix.net/5565f71a/uploads/origins/c95d3417-efcd-42e4-a5dc-4fa974fe6e7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eff7e55a265506407b9e8ef4b3e2d874 3x"}, "body": "毎度お世話になっております\n今回のご依頼なのですが\n\nスウちゃんが潜入任務のため\nカジノ的な場所で客を接待するバニーガールに扮する\n\nというシチュエーションで一枚書いて頂きたいです\n\n衣装なのですがファンボックスで書いていらっしゃったバニー衣装をベースに色をピンクに変更してただきたいのと\n足のストッキングをオミットして生足にして頂けると助かります\n\nもう一点、もし可能でしたらバニースーツの胴体を外して前回の依頼の差分で入れていただいたハートの前張りをつけて\nほぼ全裸バニーといった感じのの差分を頂けたら幸いです（胴体以外の部位はそのままで）\n\nこれに限らず私からの依頼は全て可能な範囲で大丈夫です\n\nよろしくお願い致します", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pideco02425/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 346917, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2920cbed/uploads/origins/f8c2ab87-0e1b-4353-9b41-f591c38fad7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c8439876b6065ee6e6b7a7bba482fb9", "srcset": "https://si.imgix.net/2920cbed/uploads/origins/f8c2ab87-0e1b-4353-9b41-f591c38fad7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c8439876b6065ee6e6b7a7bba482fb9, https://si.imgix.net/2920cbed/uploads/origins/f8c2ab87-0e1b-4353-9b41-f591c38fad7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68d5828910d626aa977d59cb56a8c457 2x, https://si.imgix.net/2920cbed/uploads/origins/f8c2ab87-0e1b-4353-9b41-f591c38fad7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab76b77ddcff1663c5df84c898004b64 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2920cbed/uploads/origins/f8c2ab87-0e1b-4353-9b41-f591c38fad7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d90441810ef75a49114ca77a2ed16d4f", "srcset": "https://si.imgix.net/2920cbed/uploads/origins/f8c2ab87-0e1b-4353-9b41-f591c38fad7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d90441810ef75a49114ca77a2ed16d4f, https://si.imgix.net/2920cbed/uploads/origins/f8c2ab87-0e1b-4353-9b41-f591c38fad7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c6929d4635720b6918c84b2abdee056 2x, https://si.imgix.net/2920cbed/uploads/origins/f8c2ab87-0e1b-4353-9b41-f591c38fad7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e790a68d10e8e13e2d5f5b062ffeeb0 3x"}, "body": "こんにちは！\n\n前回は素晴らしい差分をありがとうございます\n\n今回も先日のスウちゃんの立ち絵に\n表情差分に加えて状態差分を何点か頂けないでしょうか\n\n\n内容\n\n表情差分\n\n1 見下すような冷ややかな視線\n\n2 デレたの時の表情\n\n3 快楽攻撃に耐えてるような羞恥的な表情\n\n4 戦闘でダメージを受けたときの表情\n　（お手数なのですがこちらダメージ小とダメージ大の二パターン頂けないでしょうか）\n　\n5 負けそうな時の弱っている表情\n\n\n状態差分\n\n1 胸ポチの描写に勃起して固くなった乳首というイメージの差分を加えて頂きたいです\n\n2 強敵との激戦の跡を感じさせるような感じでスーツにダメージ表現を加えて頂きたいです\n\n重ね重ね大変お手数なのですが可能でしたらこちらもダメージ小　ダメージ大の2パターンでお願いできないでしょうか\n\n大幅な変化はなくて大丈夫ですのでスーツに傷などを書き入れていただければと思います\n\n  \n3　下腹部に淫紋を書き入れた差分\n\n4  戦闘後やトレーニング後を伺わせるような体を伝う汗の差分\n\nまた状態差分を前回の差分にも適用できるようにファイルに加えて頂けると助かります\n\n以上でお願い出来ないでしょうか\n\n毎度お手数をお掛けいたします\nよろしくお願い致します", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pideco02425/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 346917, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8cd5566d/uploads/origins/22a0f0f1-6469-4ad5-85e6-32fbe5eda5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496ad9d99d79dabfc05fcabce2a0399e", "srcset": "https://si.imgix.net/8cd5566d/uploads/origins/22a0f0f1-6469-4ad5-85e6-32fbe5eda5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496ad9d99d79dabfc05fcabce2a0399e, https://si.imgix.net/8cd5566d/uploads/origins/22a0f0f1-6469-4ad5-85e6-32fbe5eda5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd10955927a1e61eb5a813bd49bcd57c 2x, https://si.imgix.net/8cd5566d/uploads/origins/22a0f0f1-6469-4ad5-85e6-32fbe5eda5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09f73b908d2f6129f0709ce13e4d1cae 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8cd5566d/uploads/origins/22a0f0f1-6469-4ad5-85e6-32fbe5eda5e4?bg=%23fff&a