帯を巻き直しているところを描いていただきたいです。\n火傷の範囲は手首から肘までです。\n服装は和装であればCSの服でなくとも大丈夫です。\nその他の指定はありませんので、ご自由に描いていただきたいと思っています。\n\n資料\n企画CS→https://x.com/outi_skzk/status/1814985126805131292?s=46\n服の詳細(柄は省略して大丈夫です)→https://x.com/outi_skzk/status/1815001674936676393?s=46\n白髪の目立つ部分→https://x.com/outi_skzk/status/1818081160054165752?s=46\n\n以上の内容でご依頼いたしますので、ご検討いただけますと幸いです。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@j_uen2/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3448927, "client_id": 2113339, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c303f66e/uploads/origins/2609b895-5f50-4387-896e-d590e7588a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4141b6acee512124f078a35749b89bee", "srcset": "https://si.imgix.net/c303f66e/uploads/origins/2609b895-5f50-4387-896e-d590e7588a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4141b6acee512124f078a35749b89bee, https://si.imgix.net/c303f66e/uploads/origins/2609b895-5f50-4387-896e-d590e7588a93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=181c2e81bec752e828c59c7060a18a17 2x, https://si.imgix.net/c303f66e/uploads/origins/2609b895-5f50-4387-896e-d590e7588a93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63ffd3d11f4a68728599cf6268f07544 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c303f66e/uploads/origins/2609b895-5f50-4387-896e-d590e7588a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5612e351a70be1d2500574320450d2fa", "srcset": "https://si.imgix.net/c303f66e/uploads/origins/2609b895-5f50-4387-896e-d590e7588a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5612e351a70be1d2500574320450d2fa, https://si.imgix.net/c303f66e/uploads/origins