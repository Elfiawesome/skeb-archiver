le_same_genre": false}, {"path": "/@daruta/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3960784, "client_id": 238011, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c74d94d/uploads/origins/c22aa572-9c3d-461c-9b06-a67234ec01e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f426cf69f9bede6ff3778acfb31c2a0", "srcset": "https://si.imgix.net/5c74d94d/uploads/origins/c22aa572-9c3d-461c-9b06-a67234ec01e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f426cf69f9bede6ff3778acfb31c2a0, https://si.imgix.net/5c74d94d/uploads/origins/c22aa572-9c3d-461c-9b06-a67234ec01e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7dbb8f990ae1be1c8b37450f3b737a3 2x, https://si.imgix.net/5c74d94d/uploads/origins/c22aa572-9c3d-461c-9b06-a67234ec01e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6135d939af48dc958b149a92438648d1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c74d94d/uploads/origins/c22aa572-9c3d-461c-9b06-a67234ec01e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60f0963e08955f17c5f277289561ec56", "srcset": "https://si.imgix.net/5c74d94d/uploads/origins/c22aa572-9c3d-461c-9b06-a67234ec01e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60f0963e08955f17c5f277289561ec56, https://si.imgix.net/5c74d94d/uploads/origins/c22aa572-9c3d-461c-9b06-a67234ec01e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b5edf181785d76886c505d597eb64326 2x, https://si.imgix.net/5c74d94d/uploads/origins/c22aa572-9c3d-461c-9b06-a67234ec01e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=19fad1c53ddadd057f377cd74397b118 3x"}, "body": "はじめまして。しおりと申します。\nだるた様の描かれるミヨが可愛くて...もしよろしければ私の推しのVTuberさんも描いて\nいただけないかなと思いクエストさせていただきました...！\n\n■使用用途\n　・私の推しのVTuberである 碓氷ゆら さんへのプレゼント（FAタグを用いたXへの投稿）\n　　※だるた様に描いていただいた旨を記載させていただきます。\n　　※ご本人の活動で使用する可能性がございます。\n\n■リクエスト内容\n　○シチュエーションなど\n　・碓氷ゆらさんの白黒衣装姿でご自由に描いていただけないでしょうか。\n　　構図やポーズ、表情等は描きやすいように描いていただければと思います。\n　　※少しセクシー可愛い感じに描いていただけると嬉しいです...！\n　・服装については資料の「三面図_白黒衣装」をご参照ください。\n　　また、「白黒衣装_バリエーション」からお好きな組み合わせのものを描いていただければと思います。\n　・髪型については資料の「髪型サンプル」から、これだ！というもので描いていただければと思います。\n　　（髪型のアレンジについても大歓迎です...！）\n\n　○碓氷ゆらさんについて\n　・イメージカラーは水色\n　・水色や薄ピンク等のパステルカラーが好き\n　・リボン、レース、フリル等の女の子らしいものが好き\n　・優しい雰囲気、よく笑う、いたずらっぽい一面もある\n　・瞳の中に三日月型のハイライト\n　・身長156cm\n\n　○その他\n　・頭は見切れていない構図でお願いしたいです。\n　・人物、背景、宛名が別レイヤーのPSDにて納品いただきたいです。\n　　※必要であれば別レイヤーにてウォーターマークを設定していただければと思います。\n　・簡単にでも構いませんので背景まで描いてくださると嬉しいです。\n\n■資料等\n　・三面図、髪型サンプル\n　　https://drive.google.com/drive/folders/1yTUYB7nF-wOMXoKI0SkIObgmn9RsI8ZQ?usp=sharing\n　・二次創作ガイドライン\n　　https://project-nebula.com/guideline\n　・YouTube\n　　https://youtube.com/@yurayurausui", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@daruta/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9e536284/uploads/origins/b8b73849-5d7c-472d-8180-6a4c234154cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d019048a7b9964499ca88c37c977c88", "srcset": "https://si.imgix.net/9e536284/uploads/origins/b8b73849-5d7c-472d-8180-6a4c234154cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d019048a7b9964499ca88c37c977c88, https://si.imgix.net/9e536284/uploads/origins/b8b73849-5d7c-472d-8180-6a4c234154cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67c1a9d78a14273aae883c7c1bf1eb18 2x, https:/