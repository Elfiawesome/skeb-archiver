なポーズや表情、全て先生にお任せください！\n\n【用途】\nX（旧Twitter）の投稿、配信用のサムネ、配信中に使用するイラストとして利用させていただきたいと考えております、\nキャラクターと背景のレイヤー別々でお願いします。\n\nYouTubeのサムネイルに使用する為、頭の先や髪の毛などは、先端まで切れないように作画頂けますと嬉しいです。\n\nお忙しいところ恐れ入りますが、ご確認のほど何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/file/d/1-tntsABIx-WprdLtxONG-Z8lFnID4MKo/view?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@daruta/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/12c2d59d/uploads/origins/1bfaf2fe-a618-4517-a95a-833aff2d186d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bca18a94fa431fd002eb3459fb9c0d34", "srcset": "https://si.imgix.net/12c2d59d/uploads/origins/1bfaf2fe-a618-4517-a95a-833aff2d186d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bca18a94fa431fd002eb3459fb9c0d34, https://si.imgix.net/12c2d59d/uploads/origins/1bfaf2fe-a618-4517-a95a-833aff2d186d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=923f74b7cfbc8526a7daeb2d2214cdeb 2x, https://si.imgix.net/12c2d59d/uploads/origins/1bfaf2fe-a618-4517-a95a-833aff2d186d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e91a26fe97729e60de1af5059ebcecde 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3960784, "client_id": 1011642, "nc": 161}, {"path": "/@daruta/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3960784, "client_id": 3535015, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1701b104/uploads/origins/4b8