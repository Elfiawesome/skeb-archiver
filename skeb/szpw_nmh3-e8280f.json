ference: https://drive.google.com/drive/folders/1rppRPYN4SJ6pKvkxjZvRLjjb4mM6e--4?usp=sharing\n\nThank you for your hard work!", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@szpw_nmh3/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3696036, "client_id": 519255, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee142123/uploads/origins/1630292d-2227-4c49-bfac-628e06bd50ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=480685686bd8c45823448d5a638534de", "srcset": "https://si.imgix.net/ee142123/uploads/origins/1630292d-2227-4c49-bfac-628e06bd50ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=480685686bd8c45823448d5a638534de, https://si.imgix.net/ee142123/uploads/origins/1630292d-2227-4c49-bfac-628e06bd50ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=166263b5a01b5150231c198d8d8cc5a5 2x, https://si.imgix.net/ee142123/uploads/origins/1630292d-2227-4c49-bfac-628e06bd50ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f43875fa7dcebb6edec04e005a732a57 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee142123/uploads/origins/1630292d-2227-4c49-bfac-628e06bd50ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b82fa6615003970b7a553d322de5175b", "srcset": "https://si.imgix.net/ee142123/uploads/origins/1630292d-2227-4c49-bfac-628e06bd50ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b82fa6615003970b7a553d322de5175b, https://si.imgix.net/ee142123/uploads/origins/1630292d-2227-4c49-bfac-628e06bd50ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5516002c6a0af77ff15f04332860c5e2 2x, https://si.imgix.net/ee142123/uploads/origins/1630292d-2227-4c