=webp&fit=crop&crop=top&w=200&h=200&s=e01d9171c57b4e4facbb0038df0ad0e9", "srcset": "https://si.imgix.net/56cd0fe4/uploads/origins/2a1cc533-7348-4d68-b8d9-337c75cd508a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e01d9171c57b4e4facbb0038df0ad0e9, https://si.imgix.net/56cd0fe4/uploads/origins/2a1cc533-7348-4d68-b8d9-337c75cd508a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14498b973f3a2896e0305c55d362325e 2x, https://si.imgix.net/56cd0fe4/uploads/origins/2a1cc533-7348-4d68-b8d9-337c75cd508a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8d8bf9bc392a33bec890d3cd745ecb4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56cd0fe4/uploads/origins/2a1cc533-7348-4d68-b8d9-337c75cd508a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f47fd12d3fb6e22289808c901dd38fb4", "srcset": "https://si.imgix.net/56cd0fe4/uploads/origins/2a1cc533-7348-4d68-b8d9-337c75cd508a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f47fd12d3fb6e22289808c901dd38fb4, https://si.imgix.net/56cd0fe4/uploads/origins/2a1cc533-7348-4d68-b8d9-337c75cd508a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9af402bb2435b90ede76b345318eec81 2x, https://si.imgix.net/56cd0fe4/uploads/origins/2a1cc533-7348-4d68-b8d9-337c75cd508a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e655079037622a67fdf1774f9dfd609b 3x"}, "body": "櫻かおる様、こんばんは。\nいつも素晴らしい作品を描いていただきありがとうございます。\nよろしければリクエストをお願いできればと思います。\n\nFGOの藤丸立香君（ぐだ男）(♂)とアルトリア・キャスター（術）（第２再臨）のイラストをリクエストさせて頂きたいです。\n立香の衣装は【魔術礼装･カルデア】を希望です。\n上半身のみで大丈夫です。\n\n夕暮れの港町にある市場にて、手を繋いでいる二人。\n立香は動揺して息をのみ、アルトリアは少し俯いて上目遣いで彼を見つめている。\n立香もアルトリアも頬を赤くして緊張している感じです。\nシチュエーションとしては下記の雰囲気です。\n\n「ご、ごめん！　手を握ったままだったね」\n　立香は苦笑してアルトリアの手を離した。\n　すると、反対に少女は少年の手をキュッと握りしめる。\n「え？　ア、アルトリア？」\n「…………このままじゃ、だめ、ですか？」\n　戸惑う立香にアルトリアは目を伏せたまま、問いかける。\n　髪に隠れているが、妖精の頬は淡く朱色に染まっていた。\n　一方、立香はアルトリアのお願いにどうしようと焦り、応えられずにいた。\n「……また、はぐれそうになるかも、しれませんから……わたし、あなたをお護りしないと、ですから……あなたと、手を、つないでいたい……です」\n　楽園の妖精にそう告げられ、上目遣いで見つめられた少年はぐっと息を詰まらせた。\n\nまた、よろしければ私がPixivにて投稿している二次創作小説の挿絵にさせて頂けると幸いです。\n対象作品のページについて、URLをご送付させていただきます。\n恐れ入りますが、ご作製ご検討の程、何卒宜しくお願い致します。\n\nhttps://www.pixiv.net/novel/show.php?id=18514077", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakura_kaoru_04/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3429652, "client_id": 2483628, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dee0f258/uploads/origins/ac3871f6-7303-4272-985b-2a9cf465502b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a5a45f980a8b757737c875abf89236c", "srcset": "https://si.imgix.net/dee0f258/uploads/origins/ac3871f6-7303-4272-985b-2a9cf465502b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a5a45f980a8b757737c875abf89236c, https://si.imgix.net/dee0f258/uploads/origins/ac3871f6-7303-4272-985b-2a9cf465502b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2cd05657db2e144277b1d33cb74eb16 2x, https://si.imgix.net/dee0f258/uploads/origins/ac3871f6-7303-4272-985b-2a9cf465502b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62754debebd017fd816b042d3fd71d1c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dee0f258/uploads/origins/ac3871f6-7303-4272-985b-2a9cf465502b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e7f95762e508c80aa6149aa938ffa51", "srcset": "https://si.imgix.net/dee0f258/uploads/origins/ac3871f6-7303-4272-985b-2a9cf465502b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e7f95762e508c80aa6149aa938ffa51, https://si.im