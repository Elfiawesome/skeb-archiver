ae30/uploads/origins/8cc016a7-fcca-408f-b6f8-ea4040be4f45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8747560aa011bb5b02a437288857c1bb, https://si.imgix.net/796eae30/uploads/origins/8cc016a7-fcca-408f-b6f8-ea4040be4f45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11f4f631c373e03065fd75f74d8c77fc 2x, https://si.imgix.net/796eae30/uploads/origins/8cc016a7-fcca-408f-b6f8-ea4040be4f45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d9ae2c7648c8624f0d36029f5697623 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/796eae30/uploads/origins/8cc016a7-fcca-408f-b6f8-ea4040be4f45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b07e122455ee743117dee758c64998b1", "srcset": "https://si.imgix.net/796eae30/uploads/origins/8cc016a7-fcca-408f-b6f8-ea4040be4f45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b07e122455ee743117dee758c64998b1, https://si.imgix.net/796eae30/uploads/origins/8cc016a7-fcca-408f-b6f8-ea4040be4f45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=61b9da8c081c708a5dd11783c1676dc2 2x, https://si.imgix.net/796eae30/uploads/origins/8cc016a7-fcca-408f-b6f8-ea4040be4f45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bcbabc7bb0c15f67437abed59726f560 3x"}, "body": "いつもお世話になっております。Lockonです。\n\n以前naotoさんが同人誌『雫』で描かれていた表紙の子(銀髪で黒いキャミソールワンピを着ていた子です)がとても気に入っているので、その子をお願いします。\n\n表情は花が咲いたかのようなふんわりした笑顔でお願いします。\n瞳は見えるように開いて欲しいです。\n\n髪は風に乗ってふんわりしている感じでお願いします。\n髪型はそのままでもイラストの雰囲気に合うようアレンジしても大丈夫ですので、お好きなようにお願いします。\n\n『雫』の子なので、雫要素をどこかに入れて下さい。入れる場所や表現方法はお任せします。\n\n青いバラを持たせ、周囲には祝福するかのように色とりどりの花びらを舞わせて下さい。\n手に持ったバラに雫を伝わせると良い感じになるかも知れませんが、お任せにします。\n\nポーズの指定や構図は思い浮かばなかったのでお任せにしますが、太ももが見えるようにして頂けると大変嬉しいです。\n\n背景は有りでも無しでも構いません。金額と手間次第でお好きにして頂ければと思います。\n\n服装の指定は特にありません。そのまま黒いキャミソールワンピでも構いませんし、他に着せたい服があるならそちらを着せて頂いても全然問題ありません。\n\n資料URLを何個か貼っておきますので、参考にして頂ければと思います。\n【https://www.pixiv.net/artworks/64715664】\n【https://www.pixiv.net/artworks/69978286】\n【https://www.pixiv.net/artworks/44975852】\n【https://www.pixiv.net/artworks/75883652】\n\nその他何か不明点等があれば、連絡頂いても大丈夫です。\n\n以上です。\n\n色々と指定等を書き連ねてしまい面倒な上に、お手数おかけするかと思いますが、どうぞよろしくお願いします…！\n\nLockon", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@naoto_moni/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/80916526/uploads/origins/c379f730-5307-47e8-8980-a03913c31384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e9209a6bf54a926edc312c70641793c", "srcset": "https://si.imgix.net/80916526/uploads/origins/c379f730-5307-47e8-8980-a03913c31384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e9209a6bf54a926edc312c70641793c, https://si.imgix.net/80916526/uploads/origins/c379f730-5307-47e8-8980-a03913c31384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9e64ad8982bb1baabe463b7ff79fabb 2x, https://si.imgix.net/80916526/uploads/origins/c379f730-5307-47e8-8980-a03913c31384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa89bb5861511abc46f6579002de2198 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 397501, "client_id": 1203809, "nc": 17}, {"path": "/@naoto_moni/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 397501, "client_id": 892971, "vtt_url": null, "thumbnail_image_urls": 