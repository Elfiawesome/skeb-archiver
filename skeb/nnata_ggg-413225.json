": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a3c069a/uploads/origins/e91d698d-1cf8-48b6-bb15-2dc27c643f71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=deb3c4d70b78f206b4878be8ed5ada4d", "srcset": "https://si.imgix.net/1a3c069a/uploads/origins/e91d698d-1cf8-48b6-bb15-2dc27c643f71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=deb3c4d70b78f206b4878be8ed5ada4d, https://si.imgix.net/1a3c069a/uploads/origins/e91d698d-1cf8-48b6-bb15-2dc27c643f71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cd2b27c9d67b5be56c925ff01a5c6f37 2x, https://si.imgix.net/1a3c069a/uploads/origins/e91d698d-1cf8-48b6-bb15-2dc27c643f71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2bda8f058ccd63afe22264ace334a42c 3x"}, "body": "初めまして！なたじ様が描かれる絵画のように美しく、色鮮やかなイラストをいつも心より楽しみに拝見しております！\n初めてなたじ様のイラストをお見かけした際、本当に心を打たれました…！また、すごく絵がお上手なのに、筆があまりにも早くて、絵描き様としてとても尊敬しています！\n\n今回は私のOCをご依頼したく、リクエストを送らせていただきました\n\n使用用途：個人鑑賞\n\n描画範囲や構図に指定はございません\n服装や髪型も、資料にないものでも、なたじ様のご自由に描いてくださると嬉しいです…！\n\nただ、キャラクターデザインとして\n・目の中の渦巻きは2本\n・白目は薄黄色\n・左目(向かって右)の白目に十字架\n・向かって右側の頭だけに小さめのクリオネの角(角は描画漏れの資料がよくあります、すみません…！)\nこちらを再現していただけると幸いです\n\nまた、可能であれば明るいものより暗めの雰囲気のイラストが見てみたいです。資料の記載にあるようなキャラクターの過去を、なたじ様の解釈で構図やモチーフに入れていただきたく存じます(こちらも可能であればで大丈夫です…！基本お任せしたいので、なたじ様が思う構図で描写してください…！)\n\n資料や金額に不足があれば、お手数をおかけしますが再送要求していただけると幸いです\n\nお忙しいところ大変恐縮ですが、ご検討の程よろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/1QmWiFvtKLfg2fxrAMTMXPrwa18zzSHhk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nnata_ggg/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3466572, "client_id": 3195482, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8bd3d2e/uploads/origins/8d57cda7-9ae8-4116-8b33-67d46ffa35bc?bg=%23fff&