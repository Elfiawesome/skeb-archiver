si.imgix.net/8445850b/uploads/origins/42a7bb52-6a29-46bf-967b-2919aa7253e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac6d4b4c6f721178f7268c716be616ed, https://si.imgix.net/8445850b/uploads/origins/42a7bb52-6a29-46bf-967b-2919aa7253e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a5e40c861c2ce19b221fa7e2137a8afc 2x, https://si.imgix.net/8445850b/uploads/origins/42a7bb52-6a29-46bf-967b-2919aa7253e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e02982181fc3462c47852209ed56da39 3x"}, "body": "はじめまして。\n\nOCのEstelliaの絵を依頼したいと思います。以下はリクエストです。\n\n・衣装：Estelliaはコスプレが好きなので参考資料の衣装か好きな衣装かどちらでもいいですが、ネックレスを捨てないで欲しいです。コスプレする時にたいてい金持ちの彼女とかお嬢様とか風の衣装を着てるが他のコスプレもいいです。参考資料のヘアスタイルはどれでもOKです。Hは禁止です。\n\n・ポーズや背景など：お任せします。\n\n・参考資料：https://i.imgur.com/WVsWrVD.png\n\nよろしくお願いします。\n\nhttps://i.imgur.com/WVsWrVD.png", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shino_suisai_/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2140383, "client_id": 2493595, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26a82c9e/uploads/origins/e39974f5-46f4-44ce-aa2a-34af9dae0ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed790081a85c1389638457d8d82c556a", "srcset": "https://si.imgix.net/26a82c9e/uploads/origins/e39974f5-46f4-44ce-aa2a-34af9dae0ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed790081a85c1389638457d8d82c556a, https://si.imgix.net/26a82c9e/uploads/origins/e39974f5-46f4-44ce-aa2a-34af9dae0ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66f526b6aaca19afeada7c8c46e7dd1d 2x, https://si.imgix.net/26a82c9e/uploads/origins/e39974f5-46f4-44ce-aa2a-34af9dae0ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91b332ab7e681f81049c6628d959f6d0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26a82c9e/uploads/origins/e39974f5-46f4-44ce-aa2a-34af9dae0ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3c1e80017ab4612b34e8931e3e765a3", "srcset": "https://si.imgix.net/26a82c9e/uploads/origins/e39974f5-46f4-44ce-aa2a-34af9dae0ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3c1e80017ab4612b34e8931e3e765a3, https://si.imgix.net/26a82c9e/uploads/origins/e39974f5-46f4-44ce-aa2a-34af9dae0ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=87997fede438aadb8cc1e961208fc1f1 2x, https://si.imgix.net/26a82c9e/uploads/origins/e39974f5-46f4-44ce-aa2a-34af9dae0ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3a87a34e46dcababd51138c24ff1115d 3x"}, "body": "初めまして。\n個人Vtuberとして活動しております、うら飯紺汰と申します。\n水際様の可愛いイラストに惹かれ、ぜひ描いて頂けないかと思いリクエストさせて頂きました。\n\n＜使用用途＞\n・収益化予定のYouTubeチャンネルでの使用（配信、動画、サムネイルなど)\n・litlinkや週間予定表、SNS、FANBOXなどでの使用\n・可能であればFANBOXの特典として配るネットプリントの許可を頂きたいです。(難しい場合はデータ内に記載して頂けましたら助かります。)\n（サムネ作成などの為、トリミングや、頂いた透過データに背景や素材を合わせたりなどの加工をさせて頂きたいです。NGの場合はPSDデータにてお伝え頂ければ助かります。)\n\n＜希望＞\n・通常衣装(和装)で相方のセキセイインコも一緒に描いて欲しいです。\n・歌っている姿を描いて欲しいです。シチュエーションやポーズ等はお任せ致します。\n・顔は可愛い感じで描いて欲しいのと、可能な範囲で表情差分を頂けますと嬉しいです。(難しい場合は大丈夫です)\n・背景と人物を分けた透過データ、またはPSDデータを頂きたいのと、頭や髪の毛が切れないように描いて頂きたいです。\n\n＜特徴＞\n・頭にキョンシーの透明なお札があります\n・目の下に赤い雫模様(3点づつ)があります\n・九尾ですが一つ一つは小さめです\n・瞳の中に羽があります\n・髪の毛は所々に水色のグラデーションがあります\n・セキセイインコのフォルムは丸く、尻尾の代わりにリボンが付いています\n\n参考画像\n▷衣装参考資料はこちらをご覧下さい。\nhttps://conta.fanbox.cc/posts/5819328\n\n▷youtube\nhttps://www.youtube.com/channel/UC8VlcljjGFb4-Ny2Heb0-ew\n\n二次創作公認プログラム承認済みです。\nぜひご検討いただけましたら幸いです。\nよろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shino_suisai_/works/12", "private_thumbnail_image_urls": null, "private": false, "