=crop&crop=top&w=200&h=200&s=30eb1614502e3b8b5f0c02998ff1daa8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6452fc58/uploads/origins/173f8093-3433-40e5-8e8e-4b9444b22119?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d94c079fe6efac118ccf5a1616d48c81", "srcset": "https://si.imgix.net/6452fc58/uploads/origins/173f8093-3433-40e5-8e8e-4b9444b22119?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d94c079fe6efac118ccf5a1616d48c81, https://si.imgix.net/6452fc58/uploads/origins/173f8093-3433-40e5-8e8e-4b9444b22119?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a52c43492fff576e581a5305d591ae2 2x, https://si.imgix.net/6452fc58/uploads/origins/173f8093-3433-40e5-8e8e-4b9444b22119?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0076689997fe2b2fa10407aab25db843 3x"}, "body": "こんにちは！！ あなたの作品、すごく素敵ですね！！\n私のVTuberキャラクターのイラストを依頼したいと思っています。\n彼女は、少し疲れ気味で、穏やかだけど親しみやすい魔女です。アーティストでもあります。\n黒猫と絵を描くことが大好きです。\nポーズや構図は、すべてお任せします！！\nお時間をいただき、本当にありがとうございます。\n\nhttps://imgur.com/a/aa1uzUj \nhttps://imgur.com/a/hkkxTlh", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nkrnnie/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3805984, "client_id": 23772, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/768a0ec2/uploads/origins/47792ef1-2737-4472-9364-e295bab457b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3a95d8decf23f5d2dfacf508374a0d2", "srcset": "https://si.imgix.net/768a0ec2/uploads/origins/47792ef1-2737-4472-9364-e295bab457b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3a95d8decf23f5d2dfacf508374a0d2, https://si.imgix.net/768a0ec2/uploads/origins/47792ef1-2737-4472-9364-e295bab457b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16fab2b8b13ec9539611f91973d436b9 2x, https://si.imgix.net/768a0ec2/uploads/origins/47792ef1-2737-4472-9364-e295bab457b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=607087b3eb0e02aab42e8030ef1ded08 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/768a0ec2/uploads/origins/47792ef1-2737-4472-9364-e295bab457b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb75f9b47b77ff1ab801ec57d864eda8", "srcset": "https://si.imgix.net/768a0ec2/uploads/origins/47792ef1-2737-4472-9364-e295bab457b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb75f9b47b77ff1ab801ec57d864eda8, https://si.imgix.net/768a0ec2/uploads/origins/47792ef1-2737-4472-9364-e295bab457b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=badd2db54c734c95077e932b4222b147 2x, https://si.imgix.net/768a0ec2/uploads/origins/47792ef1-2737-4472-9364-e295bab457b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5dfe7fcea2f24351276bbf1c6f1bf7d0 3x"}, "body": "先ほどは、とてもとても素敵なイラストの納品をありがとうございました！\n\nすのださんの解釈でOCが見られること、\nとてもとてもうれしく、良い刺激をいただきました！\n（友人からも大好評で、素敵なイラストにしていただきました…）\n\nまたぜひ別キャラクターもすのださんの解釈で拝見したく、\n以下の2キャラクターにてスケッチイラストをお願いできますでしょうか。\n\nイラストの内容はおまかせいたします。\n自由に楽しく描いていただけたら嬉しいです！\nイラストレーターさんの描かれるラフなども見るのが好きなので、\nもし可能であればアイデアスケッチなども\n可能な範囲で残しておいていただけると嬉しいです。  \n\nネット上での（商業お仕事を含む）イラストの使用許可、\n 個人範囲のグッズ制作の許諾をいただきたいです。\nキャラクター詳細は以下の通りです。\n\n●メアリー・S\n怪異・黒い目の子供。\n生まれたばかりのクリーピーパスタでメアリー・スー。\nあらゆる不可知を踏みつける、ポテンシャルが無限大の怪異です。\n人間が大好きで一緒にいるのも食べるのも、比較的どっちも好きです。\nいまのところは友好的な存在ですが、今後のことは誰にもわかりません。\nタロットカードでいうと悪魔がモチーフです。\n\n●ロンリ・ヴォルクス\n怪異・狼男。斜に構えたやれやれ系の少年です。\n生まれついての人外で、人間嫌いでしたが少しずつ改善傾向。\n人間の文化の中でもロックに深い感銘を抱くいまどきボーイです。\n厨二病で、こんなに共感してロックを聴いているのは自分だけだと思っています。\nいつもそんな様子を周りの大人は生暖かく見守っています。\nタロットカードでいうと、星がモチーフです。\n\nご縁をいただけるようでしたら、ぜひおねがいいたします！\n\nhttps://mazeglyph.notion.site/2-3ae4aa13d6ef80b69e03ed2492e566bf?source=copy_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nkrnnie/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3805984, "client_id": 1242515, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/280d6983/uploads/origins/e31819ce-feb4-42dd-8181-52514108efe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e303b31805e0d724431b0547059e58b", "srcset": "https://si.imgix.net/280d6983/uploads/origins/e31819ce-feb4-42dd-8181-52514108efe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e303b31805e0d724431b0547059e58b, https://si.imgix.net/280d6983/uploads/origins/e31819ce-feb4-42dd-8181-52514108efe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d7d79df248cd12c2c90b44233dc1c53 2x, https://si.imgix.net/280d6983/uploads/origins/e31819ce-feb4-42dd-8181-52514108efe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da34d12d893d99d4889f8ce3951cc78f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/280d6983/uploads/origins/e31819ce-feb4-42dd-8181-52514108efe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d867fcb2b755c204072dc8303ff5bbff", "srcset": "https://si.imgix.net/280d6983/uploads/origins/e31819ce-feb4-42dd-8181-52514108efe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d867fcb2b755c204072dc8303ff5bbff, https://si.imgix.net/280d6983/uploads/origins/e31819ce-feb4-42dd-8181-52514108efe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=814162296a8f79074d7202594c1d4928 2x, https://si.imgix.net/280d6983/uploads/origins/e31819ce-feb4-42dd-8181-