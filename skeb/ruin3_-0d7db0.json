でもパクチーはちょっと苦手\n\n「今井シズクです！歳は今年で26歳、ジャーナリストやってます」\n「うおっ…！？び、びっくりした…驚かさないでくださいよ…」\n「俺はこの職に誇りを持ってます。」\n\nとなっております  ご都合などもあり、難しいようでしたら断っていただいて構いません。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1WcLLIkiDkFGAJqZyywNKNdN6FwHpwcvs", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruin3_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2628389, "client_id": 2888394, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/14955ff3/uploads/origins/9b48f4c4-d595-4b6e-8444-f50f0c729c33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d7a766ff9625ae7a770ade407a6d970", "srcset": "https://si.imgix.net/14955ff3/uploads/origins/9b48f4c4-d595-4b6e-8444-f50f0c729c33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d7a766ff9625ae7a770ade407a6d970, https://si.imgix.net/14955ff3/uploads/origins/9b48f4c4-d595-4b6e-8444-f50f0c729c33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19333410c1041e6335736e8ac91f2edb 2x, https://si.imgix.net/14955ff3/uploads/origins/9b48f4c4-d595-4b6e-8444-f50f0c729c33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a105fd9a8ab8eff2f856c7811ae95c64 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/14955ff3/uploads/origins/9b48f4c4-d595-4b6e-8444-f50f0c729c33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67eef0ae99d2a00fefb104eeeac41017", "srcset": "https://si.imgix.net/14955ff3/uploads/origins/9b48f4c4-d595-4b6e-8444-f50f0c729c33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67eef0ae99d2a00fefb104eeeac41017, https://si.imgix.net/14955ff3/uploads/origins/9b48f4c4-d595-4b6e-8444-f50f0c729c33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&bl