面を見せ、心を開いて優しい姿を見せます（本人はそれを認めたがりませんが）。一方、デリックは騒がしくて自己主張の強いタイプで、機会があればいつでもジョーをからかうのが大好きです。 \n\n\nアイデアをいくつか挙げます：\nお互いに「自分が上だ」と証明し合おうとする\nサッカー\nデリックがジョーをからかう\nお互いに怒り合う\nデリックがジョーの髪をいじる\n\nありがとうございます！\n\nhttps://drive.google.com/drive/folders/1UQSiHD2gtmSQeo9RQvE0mKx1VOCk5v8D", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_299na/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3951002, "client_id": 2595508, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/636130b7/uploads/origins/25b80489-ba40-40fa-8b17-31d36a4fcd48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b61208108516625906d431c9a1d11445", "srcset": "https://si.imgix.net/636130b7/uploads/origins/25b80489-ba40-40fa-8b17-31d36a4fcd48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b61208108516625906d431c9a1d11445, https://si.imgix.net/636130b7/uploads/origins/25b80489-ba40-40fa-8b17-31d36a4fcd48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=138aaf0831dbcb73c7f39744df80c22c 2x, https://si.imgix.net/636130b7/uploads/origins/25b80489-ba40-40fa-8b17-31d36a4fcd48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1b7b606d9b98b78bfaab6dc0981e6ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/636130b7/uploads/origins/25b80489-ba40-40fa-8b17-31d36a4fcd48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36a6274a92bbe9f784bb99197a60bf9d", "srcset": "https://si.imgix.net/636130b7/uploads/origins/25b80489-ba40-40fa-8b17-31d36a4fcd48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36a6274a92bbe9f784bb99197a60bf9d, https://si.imgix.net/636130b7/uploads/origins/25b80489-ba40-40fa-8b17-31d36a4fcd48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2