/OFFができたらうれしいです。透過でいただけますと助かります。\n\n\n🤍資料🤍\n※Googleドライブ内にあります。\n※髪や頭などが見切れないようにしていただけると幸いです。\n\n・構図はおまかせします。\n・ロリっぽくかわいく描いていただけるとうれしいです。\n身長133cm くらいです。\n・表情は負担のない範囲で構いませんので差分を描いていただけますとうれしいです。\n\nよろしくお願いします！🍼🤍\n\nhttps://drive.google.com/drive/folders/1ZHMwBNIRbMbjL6paBgmXQIFss3IpTguq", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@minazuki_lein_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2938030, "client_id": 610501, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44bb4529/uploads/origins/17367d1f-790a-4c68-aa3c-e19a4920be2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da5b8d525b40af67ca971e4dd4da78ab", "srcset": "https://si.imgix.net/44bb4529/uploads/origins/17367d1f-790a-4c68-aa3c-e19a4920be2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da5b8d525b40af67ca971e4dd4da78ab, https://si.imgix.net/44bb4529/uploads/origins/17367d1f-790a-4c68-aa3c-e19a4920be2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5683324f085b38700436edabbfe1f21 2x, https://si.imgix.net/44bb4529/uploads/origins/17367d1f-790a-4c68-aa3c-e19a4920be2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac23c73d82ffe32c4a4a42155a645739 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44bb4529/uploads/origins/17367d1f-790a-4c68-aa3c-e19a4920be2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d825c8ec23da5580650742ab992137ef", "srcset": "https://si.imgix.net/44bb4529/uploads/origins/17367d1f-790a-4c68-aa3c-e19a4920be2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d825c8ec23da5580650742ab992137ef, https://si.imgix.net/44bb4529/uploads/origins/17367d1f-790a-4c68-aa3c-e19a4920be2e?bg=%23fff&auto=format%2C