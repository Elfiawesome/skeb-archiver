=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35d719a8db40c5487a999d3b089a9493 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/407c8d5b/uploads/origins/ea9ea992-f19a-4d9a-b217-63d777a95cd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=570443f23e1fb33fefc7dc9ab31026d4", "srcset": "https://si.imgix.net/407c8d5b/uploads/origins/ea9ea992-f19a-4d9a-b217-63d777a95cd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=570443f23e1fb33fefc7dc9ab31026d4, https://si.imgix.net/407c8d5b/uploads/origins/ea9ea992-f19a-4d9a-b217-63d777a95cd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07d88e1d3eaf7c18bb3bb56c6a1b9966 2x, https://si.imgix.net/407c8d5b/uploads/origins/ea9ea992-f19a-4d9a-b217-63d777a95cd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e34c90d8348294e6456d21b8fbaf7e6f 3x"}, "body": "はじめまして！\nいつも薄い本を拝見させていただいております。Skebを始められたと聞いていてもたってもいられず依頼文を書いています。\nもしよければ、以下の内容をご検討いただけますと幸いです。\n\n【キャラ】\nうちの子 夢野赤毛ちゃんを描いてほしいです。\n普段は清楚なヒロイン系ですが、想い人に求められたらえっちなこともしてあげたいと思っている子です。\n\nこちらのページに情報を纏めております。\nhttps://www.fanbox.cc/@plumeria-sunny/posts/6642392\nhttps://misskey.io/notes/9wxvs8q991fz04tw\n\n【衣装】\n先生の過去作「姉ズリレッスンXX」が一番好きで愛読させていただいており、それにも登場していたFGOジャンヌ・ダルクの水着の格好をさせてみてほしいです。\n\n【シチュエーション】\n上記作中でもしていたような「竿役に自由に動いてもらう馬乗りパイズリ」をさせてほしいです。\n\n・おっぱいは「姉ズリレッスンXX」と同じくらい大きく\n・ビキニはずらすかたくし上げるかして、乳首が見えてほしい\n・亀頭は完全に隠れずに、はさんでいるおっぱいの間から見えてほしい\n・行為中、射精中(顔射)、射精後の3通りで、表情込みで差分を頂けたら嬉しいです\n・宛名はレイヤー分けして表示・非表示できるとうれしいです\n\nよろしければご検討のほど、よろしくお願いいたします！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 927976, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "お坐 3日目(木)東2ト08a", "screen_name": "oza_osuwari_tw", "avatar_url": "https://proxy.misskeyuserconte