bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d77a42113175338abed1b6c6557d1294", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73cae03d/uploads/origins/068750dd-5982-4585-a0a0-f25f2aea5c22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b3f3a4f18d8270df21be400f2de3c6f", "src_set": ""}, "body": "初めまして。\npixivの方で物凄く好みなイラストをお見かけしまして、是非とも依頼させて頂きたく送信させて頂きました。\n\n\n\n▽キャラクター・ブルーアーカイブより『風倉モエ』のおねショタイラストをお願いします。\n\n以下、大まかなシチュエーション\n\n～～～\n【要望】\n\n・ショタがモエにぎゅっと抱きしめられ、おっぱいに顔が深く埋もれているような状態。\n\n・顔や頭はおっぱいに深く埋もれているような状態。耳まで全部埋もれて後頭部以外ほとんど見えない感じ。\n\n・モエはショタの腰に跨っている状態、対面座位みたいな感じ（改変可、モエの完全優位であればある程度はお任せします）\n\n・モエの表情はやや興奮気味みたいな感じの笑み\n\n・モエは着衣状態、ショタは全裸\n\n・【ショタの上半身が服の内側に入れられている差分(後頭部が僅かに服に浮き出る感じ)】\n・【モエの衣服無し全裸差分】\n・【下半身も一緒にベルト・スカートの内側に入れられてしまう差分、全身服の中】\n\n可能であれば上記差分をお願いします。\n1番上は特にあると嬉しいです。\n\n～～～\n【補足】\n\n・ショタとモエはかなり体格差がある感じ\n\n・おっぱいはショタの頭より大きくお願いします！！でかめに！！\n\n・乳首と乳輪もかなり大きめでお願いします\n\n・太ももや尻もついでにかなり大きめで、全体的に肉付き2-3割増しみたいな\n\n～～～\n\nその他の内容については大体お任せします。\nちぐはぐな感じになってしまい申し訳ございません。\n\n金額や依頼内容など不備があったらごめんなさい。\n記載されていない事に関しては全てお任せします。\n何卒御検討の程お願い致します。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@siomesi_oisii/works/98", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1aaac851/uploads/origins/20bf13d4-d16c-4789-857c-f7bdea113a9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0fb7f8994da98d9c7f16f6a41921f1b", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 232547, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@siomesi_o