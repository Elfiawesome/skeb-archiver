図は描いて頂いているのですが、もっと胸を大きく描いて欲しく、前回とても綺麗な三面図を描いてくれたあしちよ様に依頼したいと思いました。\n\n資料の中の、制服1～制服4の中のどれかで三面図を描いて欲しいなと思っています。\nあしちよ様がもしオリジナルで描きたいと思っているのなら、そちらでももちろん大丈夫です！\n\n柏壬（はくみ）\n22歳、薄緑のロングヘアーに薄緑の瞳、170cmで高身長のコスプレ趣味のお姉さん。胸はHカップでボンキュッボンなタイプです（少し着痩せします）　妹と一緒にコスプレをするのが趣味。\n\nhttps://drive.google.com/drive/folders/1jqMr3hmcZtI4Pbkjvhu2E8_xiN3yJni5\nhttps://drive.google.com/drive/folders/1rMpeaTqE_NIfZI4au9Uve-y6UVHkmi2g", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ashichiyo_skeb/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3417125, "client_id": 154813, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa7e817c/uploads/origins/79f63cd3-a109-433f-8b96-db07c1e7b4b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=995e072b090874ffafb1a48c1e151a65", "srcset": "https://si.imgix.net/aa7e817c/uploads/origins/79f63cd3-a109-433f-8b96-db07c1e7b4b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=995e072b090874ffafb1a48c1e151a65, https://si.imgix.net/aa7e817c/uploads/origins/79f63cd3-a109-433f-8b96-db07c1e7b4b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d05ff033a5d3b0227f702471064d032 2x, https://si.imgix.net/aa7e817c/uploads/origins/79f63cd3-a109-433f-8b96-db07c1e7b4b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b71a19ab8471658ffac6ec0bf411374 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa7e817c/uploads/origins/79f63cd3-a109-433f-8b96-db07c1e7b4b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ab16f98409b6083f72b1ee0a3ff0d00", "srcset": "https://si.imgix.net/aa7e817c/uploads/origins/79f63cd3-a109-433f-8b96-db07c1e7b4b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ab16f98409b6083f7