w": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a71f79b/uploads/origins/296a1c89-8345-4573-85fc-c2cfea50c8b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6c5620e2cec92420103f58e180df9fc", "src_set": ""}, "body": "いつもTwitterでイラストを拝見してます。\n是非リクエストお願いします。\n\n【キャラクター】\nメジロラモーヌ (ウマ娘)\n\n【服装】\n以前シリウスやジェンティルで描かれていたような黒のビキニの水着姿でお願いします。\n水着のデザインやポーズ、構図などはおまかせいたします。\n\n\nリクエスト内容は以上です。\nご検討よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@usausanopopo5/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 872631, "client_id": 158432, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f1f7ee5/uploads/origins/72dc348a-d0fc-41e1-aa33-36757a33c49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44a588fc18bfeb2b1c221e7e38e47ea0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f1f7ee5/uploads/origins/72dc348a-d0fc-41e1-aa33-36757a33c49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bcae08d76d2b06f96f69226871c7bc47", "src_set": ""}, "body": "いつもお世話になっております\nskebを開設されたとの事で依頼を送らせていただきます\n\nウチの子「チヨ」のイラストを描いていただきたいです\n\n設定等\n狐の擬人化\n・漢字表記は「千代」\n・身長160センチくらい\n・体重50キロちょっと\n・年齢　200歳くらいだと思う（本人曰く黒船を見たような記憶が…）\n（見た目は20代前半ほど）\n・常に微笑\n・頭部にキツネのような耳\n・大きくてモフモフとした狐の尾\n・明るいライムグリーンの瞳　ちょいつり目気味\n・陶器のように白い肌\n・美乳（結構大きい)\n・透けるような銀髪　腰くらいまでの長髪\n・前髪で右目が隠れている\n・後ろ髪は太い三つ編みにして背中側に垂らしている\n・人前に出る時は尻尾と耳を見えなくする事が可能　その場合は黒髪になる\n・足元はレディース用のサンダル\n・白系のブラウス\n・ゆったりとしたリボンパンツ\n・好物は大学イモ　お酒好き\n・職業：神社へ続く階段の傍にある駄菓子屋の経営者（あんまり流行ってない）\n・美人だけどいまいち捉えどころがない　茶目っ気たっぷり\n資料はこちらのURLを参照ください\n（https://i.imgur.com/xzscvII.jpg）\n（https://i.imgur.com/qOmYwZi.jpg)\n（https://i.imgur.com/I2mE2xR.jpg)\n（https://i.imgur.com/FIaEPJd.jpg）\n（https://i.imgur.com/LPO3e19.jpeg)\n（https://i.imgur.com/RQKkCCU.jpeg）\n\nシチュエーション\n【駄菓子屋でこちらにお釣りを渡してくれている】\n・こちらに向かって微笑んでいる\n・ギュッとこちらの手を握っている状態\n・姿は通常時\n\n以上となります\n面倒な指定が多くて申し訳ありませんが是非ご一考ください", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 54918, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "yam", "screen_name": "yamaP_mako", "avatar_url": "https://pbs.twimg.com/profile_images/1844153513003319296/WQIl0DOO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/764698612093681664/1708339406/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 32}, {"id": 120234, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "笹森トモエ🎮げーはー総集編I発売中", "screen_name": "sasamomi", "avatar_url": "https://pbs.twimg.com/profile_images/1563859538993971202/bV_05jr-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/148770647/1540194868/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 16}, {"id": 1015885, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Munlu(お仕事募集中)", "screen_name": "wolupus", "avatar_url": "https://pbs.twimg.com/profile_images/1362002795532939265/D31aJjGJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/888786462539300865/1663185886/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 33}, {"id": 1693465, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ねこかむり", "scree