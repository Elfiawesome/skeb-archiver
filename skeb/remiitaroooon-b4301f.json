n今回はOCである少年のミニキャラを描いて欲しいです。\n\n【リクエスト内容詳細】\n\n✦キャラクター詳細\n・資料URL内の黄緑髪/紫色の目の少年(16歳)\n・羊モチーフ/眠ることが趣味\n・身長162cm\n・全身資料が少ない為、服装は制服かお好きな服を着せて下さると嬉しいです\n・眠そうな顔かおろおろしている表情がデフォルトですが、お好きな解釈で構いません。\n・サイズ、構図、ポーズなど含めて描きやすい用にお好きな解釈で描いて頂けると幸いです\n・可能であれば背景透過保存ができるPSDデータあるいはPNGデータを頂けるととても有難いです\n\n【使用用途】\n・個人鑑賞\n・非営利目的での個人グッズ制作(アクリルスタンドなど)\n\n以上となります。お忙しい中恐れ入りますが、ご検討頂けますと幸いです。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1MNGY-0t7KDnmsAZGUuCCQdYKgt1tPzr4", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@remiitaroooon/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4036202, "client_id": 3701380, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3b8f3dc/uploads/origins/eecc8df6-d58d-405c-8c87-5483b01165a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5a7782a39af0e9e260b7ff60c0feef7", "srcset": "https://si.imgix.net/f3b8f3dc/uploads/origins/eecc8df6-d58d-405c-8c87-5483b01165a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5a7782a39af0e9e260b7ff60c0feef7, https://si.imgix.net/f3b8f3dc/uploads/origins/eecc8df6-d58d-405c-8c87-5483b01165a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3994040feb100a9f5f62ffe27d3963e 2x, https://si.imgix.net/f3b8f3dc/uploads/origins/eecc8df6-d58d-405c-8c87-5483b01165a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e5deb33fc77b171a52e5a146d258829 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3b8f3dc/uploads/origins/eecc8df6-d58d-405c-8c87-5483b01165a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7fc745fefcbf72c796c0e2b94e01b27d", "srcset": "https://si.imgix.net/f3b8f3dc/uploads/origins/eecc8df6-d58d-405c-8c87-5483b01165a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w