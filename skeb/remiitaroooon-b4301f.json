uto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b1df04047feba280b95872cd19ac630, https://si.imgix.net/ab22f30b/uploads/origins/e41cddc3-09dc-43bf-8b4c-09fc747241df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=82ab42869d5a5527195182d0d24699dd 2x, https://si.imgix.net/ab22f30b/uploads/origins/e41cddc3-09dc-43bf-8b4c-09fc747241df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8ce86a071b1d956ffb9f960a785c516a 3x"}, "body": "れみぃ様\n\nいつもお世話になっております。\nこの度はSkeb開設おめでとうございます。\n\n早速ですが、先日通過したヤゼルの自陣イラストを描いていただきたいと思い、リクエストを送らせていただきました。\n\n容姿等の詳細については別添にて送付させていただきます。\n\nポーズ等のリクエストについて\nポーズや構図はおまかせします\nれみぃさんの思ったイメージで描いていただけると嬉しいです。\n\n可能であれば、イラストとは別にキャラクターのみ、背景を透過したものもいただきたいです。\n\n使用用途について\n・SNSのアイコン、ヘッダー等 \n・依頼時の資料として第三者への提示 \n・非営利目的でのグッズ制作\n\nお忙しいところ恐縮ですが、ご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1a4k3EhMl4TzqvtG9XxQFp8nzLeEEqsLB", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@remiitaroooon/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4036202, "client_id": 3830457, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/033ad3d1/uploads/origins/31983c6d-14c2-4ccd-a998-1b9b8d2d00eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3d4585c9b6b2f816acacfcab34b3774", "srcset": "https://si.imgix.net/033ad3d1/uploads/origins/31983c6d-14c2-4ccd-a998-1b9b8d2d00eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3d4585c9b6b2f816acacfcab34b3774, https://si.imgix.net/033ad3d1/uploads/origins/31983c6d-14c2-4ccd-a998-1b9b8d2d00eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d34bd2f5c9a4e3cc3a55c5d728246282 2x, https://si.imgix.net/033ad3d1/uploads/origins/31983c6d-14c2-4ccd-a998-1b9b8d2d00eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=571cf5b8a10cecafd8ded1be3497f677 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/033ad3d1/uploads/origins/31983c6d-14c2-4ccd-a998-1b9b8d2d00eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca5c1ea03b47d98f007cf8dd89a7d0ed", "srcset": "https://si.imgix.net/033ad3d1/uploads/origins/31983c6d-14c2-4ccd-a998-1b9b8d2d00eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca5c1ea03b47d98f007cf8dd89a7d0ed, https://si.imgix.net/033ad3d1/uploads/origins/31983c6d-14c2-4ccd-a998-1b9b8d2d00eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=adc3860104fd018cbbb881b7c41824dc 2x, https://si.imgix.net/033ad3d1/uploads/origins/31983c6d-14c2-4ccd-a998-1b9b8d2d00eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a48c3396ed52be3b46d17a0157076840 3x"}, "body": "いつもお世話になっております。\nまた、skeb開設おめでとうございます！！🎉\n\n自探索者のご依頼になりますが私のプロスマHO楽のSDを描いていただきたくリクエストを送らせていただきました！\n\n使用用途\n・個人鑑賞、壁紙\n・SNS/ヘッダー等での使用\n\nポーズや衣装、構図など、全てお任せいたしますので、お好きに描いていただいていただきたいです！\nまた、内容が合わなければキャンセルしていただいて大丈夫です。\n金額に不足がありましたら再送要請して頂ければと思います。\nお忙しい中恐れ入りますが、ご検討お願いいたします。\n\n↓参考画像1\nhttps://drive.google.com/file/d/1AEW7cKk5Ztxkhp6KHcTso--90bOG-JSi/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@remiitaroooon/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4036202, "client_id": 3442315, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/764f14fd/uploads/origins/74076761-79c9-4c4b-a995-1c8518cdf7f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=509f475736376ab7457719877b85343f", "srcset": "https://si.imgix.net/764f14fd/uploads/origins/74076761-79c9-4c4b-a995-1c8518cdf7f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=509f475736376ab7457719877b85343f, https://si.imgix.net/764f14fd/uploads/origins/74076761-79c9-4c4b-a995-1c8518cdf7f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71314b15668908f69c7878c2c0d0e7e1 2x, https://si.imgix.net/764f14fd/uploads/origins/74076761-79c9-4c4b-a995-1c8518cdf7f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=006135e1dde82708b7d7d1bfc42f7598 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/764f14fd/uploads/origins/74076761-79c9-4c4b-a995-1c8518cdf7f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6cc7564342217cb65c3deb7104aba13", "srcset": "https://si.imgix.net/764f14fd/uploads/origins/74076761-79c9-4c4b-a995-1c8518cdf7f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6cc7564342217cb65c3deb7104aba13, https://si.imgix.net/764f14fd/uploads/origins/74076761-79c9-4c4b-a995-1c8518cdf7f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dbb58acee6e376d88419f1c133f70cca 2x, https://si.imgix.net/764f14fd/uploads/origins/74076761-79c9-4c4b-a995-1c8518cdf7f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0205b9ae41be71f09ed4a28fb06be8d9 3x"}, "body": "いつもお世話になっております！長月です\n\n今回お願いするのは、誰デザで作った子をOCとして動かすことにした子です。\n以下、詳細です。\n\nモチーフ：ガレット・デ・ロワ、チェスのキング\n 特徴：ガレット・デ・ロワがモチーフなので、生地の模様の種類として存在する「月桂樹」、「太陽」、「向日葵（※実際のひまわりではなく、生地の種類としての向日葵です。検索するとすぐ出てきます）」、「麦」の要素をデザインに取り込んでいます。キングイメージとしてはマント（？）、王冠、ステッキがあります。 \n髪型：こちらから見て右側にお団子\n表情：浮世離れした感じ。表情変化薄め。まろまゆ。特殊瞳孔\n身長：130〜140ほど。小さめ\n\n・イメージカラー：オレンジ、黄色\n\nポーズなどはお任せします。\n資料はリンクのとおりです！よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1dDVu9Yc0xtcMeC8czXbxbHBt_1tvsz4U", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@remiitaroooon/works/2", "private_thumbnai