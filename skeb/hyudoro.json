す。\n今、Vtuberモデルの新しい衣装を作ってるところなんだ。google driveにある衣装や、あなたが似合うと思う衣装を自由に使ってください。私はあなたのスタイルが好きなので、あなたのファッションを信頼しています！\n\n構成はお任せします。\n\n詳細\n- 右目の下に2つのほくろ\n- 口を開けると左側に鋭い歯\n\n私は本物の科学者であり、ストリーマーである。子供と一緒に仕事をしているが、子供と一緒に仕事をしていない時の私の態度は冷たい。意地悪で疲れた顔をしているだけだ！\n\n私の絵を描いてくださりありがとうございます！可能であれば、住所、署名、背景のオンオフができるPSDレイヤーを使ってください。\n\nhttps://drive.google.com/drive/folders/13Sjy6KRzEND-kCDkAGzvK14-nTQemK1p?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 289469, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "きつね の子", "screen_name": "4ox", "avatar_url": "https://pbs.twimg.com/profile_images/1684044281781297153/fQvs_Zci.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4701553700/1693430132/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "skills": [{"genre": "art"}], "nc": 16}, {"id": 2278400, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "KBM｜skeb募集中", "screen_name": "tai_ki_bansay", "avatar_url": "https://pbs.twimg.com/profile_images/1910930023608901632/5OVrpTaC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/715677762283941888/1758963405/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 161}, {"id": 2740956, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ささゆき", "screen_name": "kemonoyou", "avatar_url": "https://pbs.twimg.com/profile_images/1637276810403774464/hPYn9GvQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1637276580539170816/1682929855/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requ