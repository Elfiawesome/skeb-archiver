賞金稼ぎ。しかし、不安な一面もある。\n\n鎖骨と肩に白いタトゥーがある。A05 \"の画像を参照。\n\nモチーフは「夜」「星」「墨」。\n\nよろしくお願いします！ご希望に添えない場合は、遠慮なくお断りください。\n\nhttps://drive.google.com/drive/folders/11sDMsM_XbY_dqNffg-AlVx3dbdNjuNwr", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Napoo_28/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2818267, "client_id": 2460451, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75724f5e/uploads/origins/ab74e1e8-de03-4450-b8a3-c52fe5664c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c0a893a7a8f4bf60cec39ec2bfc9006", "srcset": "https://si.imgix.net/75724f5e/uploads/origins/ab74e1e8-de03-4450-b8a3-c52fe5664c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c0a893a7a8f4bf60cec39ec2bfc9006, https://si.imgix.net/75724f5e/uploads/origins/ab74e1e8-de03-4450-b8a3-c52fe5664c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ded4fa65b25a1a882342c758f7892733 2x, https://si.imgix.net/75724f5e/uploads/origins/ab74e1e8-de03-4450-b8a3-c52fe5664c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a26cef475dc2524c4c07b3e6bcdd7f8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75724f5e/uploads/origins/ab74e1e8-de03-4450-b8a3-c52fe5664c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f18a4fb683355b221d94b69b1dfbe242", "srcset": "https://si.imgix.net/75724f5e/uploads/origins/ab74e1e8-de03-4450-b8a3-c52fe5664c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f18a4fb683355b221d94b69b1dfbe242, https://si.imgix.net/75724f5e/uploads/origins/ab74e1e8-de03-4450-b8a3-c52fe5664c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3a546fc004e4a881f33131f755af552f 2x, https