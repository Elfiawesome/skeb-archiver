があります。\n\n以上となります\n長文となってしまい申し訳ありません。\n難しい点や確認事項などがございましたら、再送リクエスト等でお知らせいただけますと幸いです。\n\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1JbyKNAeMzUfJyPZU8OsAbap9TS1WSneX?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kohamaru_design/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3646963, "client_id": 1684012, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98af6a48/uploads/origins/6c59070e-0609-4c4c-84a1-52c2bd6237f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=688f165923f2cde811fa5ab624319dd0", "srcset": "https://si.imgix.net/98af6a48/uploads/origins/6c59070e-0609-4c4c-84a1-52c2bd6237f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=688f165923f2cde811fa5ab624319dd0, https://si.imgix.net/98af6a48/uploads/origins/6c59070e-0609-4c4c-84a1-52c2bd6237f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7bd50f8a1c336b11f8867db353c3e9a 2x, https://si.imgix.net/98af6a48/uploads/origins/6c59070e-0609-4c4c-84a1-52c2bd6237f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d86d06a96559d4bf7f8b33bc3344f010 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98af6a48/uploads/origins/6c59070e-0609-4c4c-84a1-52c2bd6237f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c29324681db64f968e66c9640cbace14", "srcset": "https://si.imgix.net/98af6a48/uploads/origins/6c59070e-0609-4c4c-84a1-52c2bd6237f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c29324681db64f968e66c9640cbace14, https://si.imgix.net/98af6a48/uploads/origins/6c59070e-0609-4c4c-84a1-52c2bd6237f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=492f2ed932df1800e0a49