00&blur=200&s=6fb18f801b7bd27d1a40ab77c95f93c0", "srcset": "https://si.imgix.net/ce58e307/uploads/origins/2bb4b8b4-ac72-4528-aa67-f0cce62d2b29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6fb18f801b7bd27d1a40ab77c95f93c0, https://si.imgix.net/ce58e307/uploads/origins/2bb4b8b4-ac72-4528-aa67-f0cce62d2b29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fc349d6e90e47c4c8c338538068e979c 2x, https://si.imgix.net/ce58e307/uploads/origins/2bb4b8b4-ac72-4528-aa67-f0cce62d2b29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb4292a52d0bd0dd09969b0d667ab3b3 3x"}, "body": "-86さん\nおつかれさまです\n\nノクターンに投稿されていた魔法少女家族会議が気に入ったので依頼させていただきたいです。\n\n依頼の内容としましては、\n\nファンタジー的な世界の貴族の家で、\n婚姻政策のために跡取り息子とその双子の片割れの女の子、あるいは妹や姉たちの誰かが性交することになるものの、\n\n女の子たちは割とノリノリで「よそに嫁ぐよりは（レズ的な事も混みで）こっちがいい」、と言い合っていて、最終的に家長の母がしょうがない子供たちですこと、と言いながらノリノリで服を脱ぎだす感じのエロ小説が見たいです。\n\n文量に関しては、短編２、３作分をイメージしていましたが、\n具体的な量に関しては、お任せします。\n\n文章のスタイル、視点に関しても、書いているときは母親の一人称くらいをイメージしていましたが、\n息子目線、姉妹たちの誰かなど、文章のスタイルと相談して好きなように選んでいただければ。\n\nどこをどう膨らませてもいいですし、\n全体のイメージさえ崩れなければ、キャラクターや設定は適宜削ったり足したりしていただいて構いません。しっかりと行為を描写してくれてもいいですし、その前にみんなでイチャイチャの部分を濃厚に書いていただいてもオーケーです。\n\nただせっかくですので、\n普段から男の子のことをおもって女の子たちがアブノーマルなプレイを楽しんでいたか～、\nどれだけ好きか～、実は母がそうなるのを見越して育ててきた～などの情報をノリノリで語り合う明るいインモラルさを、見れれば嬉しいです。", "nc": 168, "word_count": 13657, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 56387, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ガタス@6/28ぴたけっと5_F-4", "screen_name": "Gatasu313", "avatar_url": "https://pbs.twimg.com/profile_images/1657621071477215233/2NmAKi7W.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2417330226/1487330087/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_