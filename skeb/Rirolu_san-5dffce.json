ドでゲームしてるイラストです。\n・七宮先生らしいルームウェア等をオリジナルで着せて頂きたいです。\n\n【使用用途等について】\n商用利用（収益化済みチャンネルがあるため）や配信画面やSNSアイコンが主になります。\n個人でのグッズ作成（他者への販売予定はありません。）\n以上となります。\n配信の待機画面に使いたいため1920×1080px\nだとありがたいです。\n背景に関してはお任せ致します。\nただし、PSD形式にて人物と背景をレイヤー分けして頂いたデータを添付して頂けますと幸いです。\n\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1SMN2JcPFr1HyfOh1zhPQmIqQ2TSHXg5y?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@laniatto/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3446663, "client_id": 3188636, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9486cfe4/uploads/origins/a592f68e-68d4-4350-95f4-ff873e7ea848?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6444b84f465de5e21e39dd455dd0858e", "srcset": "https://si.imgix.net/9486cfe4/uploads/origins/a592f68e-68d4-4350-95f4-ff873e7ea848?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6444b84f465de5e21e39dd455dd0858e, https://si.imgix.net/9486cfe4/uploads/origins/a592f68e-68d4-4350-95f4-ff873e7ea848?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0d6f23ce43af8059fee33e5c6af5d80 2x, https://si.imgix.net/9486cfe4/uploads/origins/a592f68e-68d4-4350-95f4-ff873e7ea848?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e3cb3b9ee395f84ff06a3533d0b0737 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9486cfe4/uploads/origins/a592f68e-68d4-4350-95f4-ff873e7ea848?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb1ea6518e41ce32d746b8a584c04377", "srcset": "https://si.imgix.net/9486cfe4/uploads/origins/a592f68e-68d4-4350-95f4-ff873e7ea848?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb1ea6518e41ce32d746b8a584c04377, https://si.imgix.net/9486cfe4/uploads