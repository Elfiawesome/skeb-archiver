ee85/uploads/origins/2a8e3a88-c6d0-4cf9-b9ab-3acef09846aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3e3b6ba42dae3e779141c8003efe788", "srcset": "https://si.imgix.net/1852ee85/uploads/origins/2a8e3a88-c6d0-4cf9-b9ab-3acef09846aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3e3b6ba42dae3e779141c8003efe788, https://si.imgix.net/1852ee85/uploads/origins/2a8e3a88-c6d0-4cf9-b9ab-3acef09846aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cac4e586a153b07c3bafe7deff62d3ea 2x, https://si.imgix.net/1852ee85/uploads/origins/2a8e3a88-c6d0-4cf9-b9ab-3acef09846aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=20b68f90ecb56b63bd9bf64695e9b47f 3x"}, "body": "はじめまして、padoと申します。MEG先生のイラストが大好きです。先生に以前描いて頂いたイラストはとてもお気に入りで、色々なところに使わせていただいております！\n\n今回は私のOCを描いて頂きたく、ご連絡差し上げました。以下詳細となっております。\n\n・男性/26歳/182cm\n・いつもニコニコなカニバリストの男性です。常に頬を染めています。\n・紫がかった灰色の背中あたりまで伸びたロングウルフヘアです。インテークとアホ毛が特徴です。\n・服装は黒のゆったりとしたハイネックに、グレージュのエプロン、ブラウンのパンツを着用しています。\n（より詳しい説明は資料リンクの画像内に記載しております）\n\n・地雷などは一切ございませんので、先生の好きなようにインモラルやゴア要素のあるイラストを描いていただけますでしょうか？(><)服装等も自由にして頂いても大丈夫です！\n\n以上となります。ご検討頂けましたら幸いです！\n\nhttps://drive.google.com/drive/folders/1Pp_Jzm9bTNosyYOJsZvRGlo13AeWHhl-", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neteokirenai/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3775234, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aeee75c4/uploads/origins/a64de2b7-a118-4a34-b3c2-af082f42b3bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6b7e4158d5537b7f460b147d9c78844", "srcset": "https://si.imgix.net/aeee75c4/uploads/origins/a64de2b7-a118-4a34-b3c2-af082f42b3bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6b7e4158d5537b7f460b147d9c78844, https://si.imgix.net/aeee75c4/uploads/origins/a64de2b7-a118-4a34-b3c2-af082f42b3bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=414d5c38b845be81e568ea74988438d3 2x, https://si.imgix.net/aeee75c4/uploads/origins/a64de2b7-a118-4a34-b3c2-af082f42b3bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1b28fadef64352101548462da7caca4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aeee75c4/uploads/origins/a64de2b7-a118-4a34-b3c2-af082f42b3bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f63f3b933b7ce25df3f094285454aa9", "srcset": "https://si.imgix.net/aeee75c4/uploads/origins/a64de2b7-a118-4a34-b3c2-af082f42b3bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f63f3b933b7ce25df3f094285454aa9, https://si.imgix.net/aeee75c4/uploads/origins/a64de2b7-a118-4a34-b3c2-af082f42b3bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a96bd3459ea629c4ec7ad7c1d16d64b8 2x, https://si.imgix.net/aeee75c4/uploads/origins/a64de2b7-a118-4a34-b3c2-af082f42b3bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc85b1fd634abd866c269e00b64d5095 3x"}, "body": "初めまして。いつも貴方様のキュートなイラストを拝見させていただいており、可愛い！と常々思っていたので依頼させていただきました。\n\n【依頼内容】\nTRPGに使う探索者の全身立ち絵(差分4種)を依頼したいです。\n背景を透過してくださると助かります。\n\n【キャラクターのポーズ、表情差分について】\nキャラクターのポーズについて\n少しだけ腰を屈めて左手をこっちに振っていると嬉しいです。ファンサをしているような雰囲気だと喜びます。\n\n差分については\n①目を開けて笑っている+瞳孔ガン開き\n②目を開けて笑っている+猫目\n③無表情+瞳孔ガン開き\n④無表情+猫目\n\nがあると嬉しいです。\n猫目のイメージは瞳孔縦長、瞳孔ガン開きの際の大きさイメージは天使のスアちゃんくらいです。\n\n【キャラクター容姿補足】\n睫毛…ピンク色で描いて下さると嬉しいです\n髪型…ショートカットかつ三つ編みのハーフアップ。色はピンク➝水色グラデ\n衣服…コートはショート丈で、デザインを量産系(リボンとかフリルとかついている感じの…)に寄せて下さると助かります。細かいデザインや下半身はお任せします。\n\n【キャラクターについて】\n身長176cm。体型は華奢。お姫様と王子様を兼ね備えるようなイメージで作りました。\n自分の容姿を気に入っており、意図的にめろく振舞っています。\nテンションの高い時と低い時の落差が激しい子で、警察官をしています。\n\nhttps://drive.google.com/drive/folders/1zOzpPCWl46MOA3