mat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd771725515b0071a80fcdefd1b406f4", "srcset": "https://si.imgix.net/17d63eef/uploads/origins/31c6060f-face-4c45-b0f8-af1feb91bc9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd771725515b0071a80fcdefd1b406f4, https://si.imgix.net/17d63eef/uploads/origins/31c6060f-face-4c45-b0f8-af1feb91bc9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=84dcf64394c5f18b64c75a9eddd04052 2x, https://si.imgix.net/17d63eef/uploads/origins/31c6060f-face-4c45-b0f8-af1feb91bc9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=40c283426d2a5273dc693f360177fe25 3x"}, "body": "リクエスト失礼いたします。\n【キャラクター】\n芳澤かすみ（ペルソナ）\n※終始制服着衣でお願いします。\n【シチュエーション】\n顔射の為に呼ばれるシリーズが好きなのでシチュエーションはこれでお願いします。\n顔コキからの顔が見えなくなるほどの顔射をお願いします。\n可能ならで大丈夫なのでザーメンをジャンプーみたいにして髪に塗りつけるシチュもお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kamisyakujii/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 21174, "client_id": 123163, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17829e75/uploads/origins/4773574e-4239-4886-bd76-e6d777381479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cc3ce4f9136bc9dc1d90c8081c6fa57", "srcset": "https://si.imgix.net/17829e75/uploads/origins/4773574e-4239-4886-bd76-e6d777381479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cc3ce4f9136bc9dc1d90c8081c6fa57, https://si.imgix.net/17829e75/uploads/origins/4773574e-4239-4886-bd76-e6d777381479?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25cbb60c62cfba301e2f9d283266c94a 2x, https://si.imgix.net/17829e75/uploads/origins/4773574e-4239-4886-bd76-e6d777381479?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50694e711c03c6734e7e0c91ea99723f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17829e75/uploads/origins/4773574e-4239-4886-bd76-e6d777381479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a5ea61e034bf6ab7fe15194d5b08037", "srcset": "https://si.imgix.net/17829e75/uploads/origins/4773574e-4239-4886-bd76-e6d777381479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a5ea61e034bf6ab7fe15194d5b08037, https://si.imgix.net/17829e75/uploads/origins/4773574e-4239-4886-bd76-e6d777381479?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a6b9ad8898662ef4081011a76a1b138 2x, https://si.imgix.net/17829e75/uploads/origins/4773574e-4239-4886-bd76-e6d777381479?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2d12f87b34a003ff630f98540e416129 3x"}, "body": "お世話になります。\nチェンソーマン　マキマのリクエストです。以前描いてらした雪子の顔押さえつけ射精がとても良かったので、乱暴に顔をモノとして扱われつつ、舌を出して射精を誘うフェラをお願いしたく…。モノクロ、ラフでも結構です。\n\n内容：ひょっとこフェラしながらピースサイン→射精時は顔押さえつけで顔射\n\nファンボックスの直斗君的な、捜査協力の代償にフェラみたいな想定で、男は強気だけどあまりのエロさに余裕なし、マキマさんは余裕顔な関係性で、\n\n・命令されてのピースだけどノリノリでやってくれる（裏ピースとかの変形型でも全然大丈夫です）\n・男が顔か髪を掴み、顔に出すから舌出せと要求、マキマは指で口の片端を引っ張って舌、歯、喉奥を見せて舌を伸ばして揺らす、男は想像以上に下品な開口と美人顔のギャップに耐えられず射精\n\nマキマは目を開いたままで、こちらに目線を合わせているか、見下すような表情になっていると助かります…。擬音や、「女の顔に無理矢理ザーメンコキ捨てるつもり？最低♡」「ダメ♡やだ♡オナホ代わりの顔面レイプでマーキングやだ♡人生終わる♡」みたいな、嫌がっている素振りで射精を誘うセリフがあると嬉しいです。\n\n以上が希望で、上半身か顔メインの主観構図の想定ですが、お任せしますので、キャラ解釈やご嗜好に合う形に自由に変えてしまって大丈夫です。\nご興味がおありでしたら、ご一考の程、お願いいたします", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 3738, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ダンナ　Skebやっています", "screen_name": "karatekikku", "avatar_url": "https://pbs.twimg.com/profile_images/1927355721521262592/BOsppe7v.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1615921440766955520/1748319769/1