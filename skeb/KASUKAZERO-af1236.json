ぜひお任せしたいです。イメージの湧きやすい感じで……\nわからないところは勝手に補完していただいて大丈夫ですし、必ずしも資料に沿う必要も無いです。\n3人とも刺青まみれなのですが、これも適当で平気です！\nキャラデザや服・髪なども、このキャラクターであると分かれば自由に弄っていただいて構いません。洗礼さんのセンスがとても好きなので…\n\nお任せする事が多いのですが、何かありましたら再送要請を送っていただいても、お断りいただいても結構です！\nご検討いただけますと幸いです！何卒よろしくお願い致します。", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kanijima_net/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2116838, "client_id": 2466221, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/864e9c82/uploads/origins/832335b5-1bff-4851-90f4-fd784cdcdbaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bcc4df00800889d6068d68417f50323", "srcset": "https://si.imgix.net/864e9c82/uploads/origins/832335b5-1bff-4851-90f4-fd784cdcdbaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bcc4df00800889d6068d68417f50323, https://si.imgix.net/864e9c82/uploads/origins/832335b5-1bff-4851-90f4-fd784cdcdbaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bcb6f884332506a705f9424e311bb573 2x, https://si.imgix.net/864e9c82/uploads/origins/832335b5-1bff-4851-90f4-fd784cdcdbaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b93956c900b1cd0edeffbed647a9748a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/864e9c82/uploads/origins/832335b5-1bff-4851-90f4-fd784cdcdbaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ce68d4f805bd2cc860d872630f7bf89", "srcset": "https://si.imgix.net/864e9c82/uploads/origins/832335b5-1bff-4851-90f4-fd784cdcdbaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ce68d4f805bd2cc860d872630f7bf89, https://si.imgix.net/864e9c82/uploads/origins/832335b5-1bff-4851-90f4-fd784cdcdbaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&