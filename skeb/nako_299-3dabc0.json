のおおよその形状と、後ろ髪のおおよその長さ（長い髪でできる短く見えるアレンジなどは大丈夫です）はそのままでお願いします。\n\n衣装やシチュエーションなどは、納品時期に合わせてちょうどいい感じのものにしていただけると嬉しいです。\n\nSNSのアイコンやヘッダー、配信のサムネイルなどに使わせてもらいたいと思っていますので、できるだけキャラの上と左右が欠けないように、また背景がある場合はキャラのみの画像（可能であれば透過されたもの）かレイヤー分けされたファイルもいただけると嬉しいです。\n\nよろしくお願いいたします！\n\nhttps://hub.vroid.com/characters/5830921941071302873/models/1723019607277561017", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nako_299/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2689226, "client_id": 2661264, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f363873b/uploads/origins/a2935168-3d54-4522-885c-cb6fac472aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b6ba0eec3803c9584956b13054062d5", "srcset": "https://si.imgix.net/f363873b/uploads/origins/a2935168-3d54-4522-885c-cb6fac472aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b6ba0eec3803c9584956b13054062d5, https://si.imgix.net/f363873b/uploads/origins/a2935168-3d54-4522-885c-cb6fac472aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46ee1670c61154cb9f2902c8bec5e1be 2x, https://si.imgix.net/f363873b/uploads/origins/a2935168-3d54-4522-885c-cb6fac472aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eeaa65677e9b489d7d3b9fcabca66426 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f363873b/uploads/origins/a2935168-3d54-4522-885c-cb6fac472aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c8c0d4323194093129984728995ce43", "srcset": "https://si.imgix.net/f363873b/uploads/origins/a2935168-3d54-4522-885c-cb6fac472aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c8c0d4323194093129984728995ce43, https://si.imgix.net/f363873b/uploads/origins/a293516