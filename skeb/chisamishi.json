", "tipped": true, "creator_id": 2108439, "client_id": 1964479, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa5d9270/uploads/origins/3474def4-d748-4169-b9f0-2731d579da0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2f277592fd01b0c9c141b5e981fad7f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa5d9270/uploads/origins/3474def4-d748-4169-b9f0-2731d579da0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce70fb5b2525c9c9a998555bcc1043f7", "src_set": ""}, "body": "以前は納品ありがとうございました。\nまたお願いしたくリクエストさせていただきます。\n\n【容姿等】\n資料URLをご参照ください。\n\n【シチュエーション】\n玩具着けながらチアしてきた後のイメージ。\n・周囲に誰もいない場所(屋内屋外問わず)。\n・パンツは脱ぎかけ、愛液でシミが出来ている。\n・内股も愛液が伝ってびしゃびしゃ。\n・着崩し等はお任せします。\n・性器にローターを挿れ(穴にコードが消えてく)、コントローラー部は太腿に留めている。他に玩具追加しても構いません。\n\nその他留意事項等は当方の固定ツリーもご参照ください。\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1bHDCv90q7AcLJS7gQEMXyf6orVpBgmE7", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chisamishi/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d0f03eec/uploads/origins/1b7e643a-87ab-4a60-a557-98507ab3454f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86312110bdc78d9556a069ec04901547", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2108439, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@chisamishi/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2108439, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"