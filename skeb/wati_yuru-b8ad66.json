: 0, "received_works": [{"path": "/@wati_yuru/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 183473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F427400610564939776%2FqJ4j0iHs.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28d613d1ebd9f8a631e5853d1031f11d", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F427400610564939776%2FqJ4j0iHs.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28d613d1ebd9f8a631e5853d1031f11d, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F427400610564939776%2FqJ4j0iHs.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2964e85e9285aae990ad295512de3d9 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F427400610564939776%2FqJ4j0iHs.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad7456d19bd34cdd44107dc78997aa40 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F427400610564939776%2FqJ4j0iHs.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ade080bcb0c5fa026de29fa5884a5bc", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F427400610564939776%2FqJ4j0iHs.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ade080bcb0c5fa026de29fa5884a5bc, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F427400610564939776%2FqJ4j0iHs.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28c88d61a4577f1df153aef605e94894 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F427400610564939776%2FqJ4j0iHs.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8b5c9a13686cf4aa8a1a3964d3dc5150 3x"}, "body": "伍段さんの書かれる背徳的なシチュがとても魅力的だと思うので今回リクエストしました。\n\n温泉リゾートイベ後のチューナーと亜里砂・E・Bと春向井香と綾瀬凜で遊びに行く展開で温泉旅館もしくはプライベートビーチ付きの陽菜か亜里砂の別荘に泊まりで遊びに行って快楽に溺れて退廃的に過ごすららマジのシチュエーションをお願いします。\n\n以下、希望シチュエーションです。\n\n・蒼先輩へのお詫びの被験者として蒼先輩の発明品(媚薬)を持たされた凜経由で発情した3人に襲われて逆レ\n\n・竿舐めやフェラで口内射精させて「いっぱい出たね♡」と言ってくる凜\n\n・「凜ちゃんだけズルいのです」と凜とキスをして精液を舐めとる春香\n\n・「春香は知っているのですよ。チューナーくんは春香のおっぱいが好きなんですよね♡」と言ってパイズリしてくる春香\n\n・「まだまだ夜はこれからデスヨ」と亜里砂にキスで蒼の発明品を飲まされるチューナーとキスハメ\n\n・途中からチューナーも理性が弾けて貪りあうシチュエーション\n\n・チューナーとのキスを羨ましがる凜\n\n・手繋ぎイチャラブ騎乗位で乱れる凜\n\n・春香と亜里砂のWフェラ&Wパイズリ\n\n\n・亜里砂の水着姿を見てビンビンに勃起させてしまったチューナーに「まったく昨日あれだけしたのに元気いっぱいデスネ。このままにするのも可哀想ナノデ、キミの好きにしていいデスヨ」と言ったせいで水着をずらして胸を揉みしだかれて「まるで夢見たいです」とチューナーが幸せそうにしたり「このくびれや鼠蹊部を見て我慢できる男なんていませんよ」とじっくり身体中まさぐられたり舐められたりと好き放題感触を堪能されてしまうシチュ\n\n・チューナーに腰を打ちつけられて水着や身体を精液でドロドロに汚されてしまう亜里砂\n\n・春香の日向ぼっこの為に日焼け止めを塗るシチュで「えへへ、チューナーくんってばそんなに春香のおっぱいが気に入ったのですね」と嬉しそうにした展開からの寝バックで蕩ける春香のシチュ\n\n・もじもじした凜が「チューナー……あの……私も……」という感じでチューナーとHしたいのに煮えきらないシチュからの「すっかり濡らしちゃって。ほんとは期待していたんですよね」とチューナーから言葉責めされたりおねだりさせられて即ハメされるシチュか後日、部室で旅行中のHが忘れられなくなった凜との隠姦\n\n以上です。最初はチューナーが逆レされて、器楽部員に体を許してしまったことで怖いものがなくなってHなことに乗り気になったチューナーの雰囲気でお願いします。\n\nまた、チューナーとはいえ男女のお泊まりで春香が心配だからと体裁を取り繕う凜だけでなく4人とも肉欲に溺れてしまう雰囲気で有れば大丈夫です。\n\nセリフやシチュエーションについてアレンジや追加等ありましたら伍段さんに全てお任せします。\n注文が多くて申し訳ありませんが可能な範囲でどうぞよろしくお願いします。", "nc": 177, "word_count": 10876, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@wati_yuru/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 183473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F427400610564939776%2FqJ4j0iHs.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32018e487da24e9c6868cdef1c5487e4", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F427400610564939776%2FqJ4j0iHs.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32018e487da24e9c6868cdef1c5487e4, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F427400610564939776%2FqJ4j0iHs.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=487aa2a0b5804495b3855247ab8d3147 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F427400610564939776%2FqJ4j0iHs.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0205d6a8f1e67effc4b3bbacd0c944c9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F427400610564939776%2FqJ4j0iHs.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c7304fb5c9ea0ed5683d2ad5fbc3d1c", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F427400610564939776%2FqJ4j0iHs.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c7304fb5c9ea0ed5683d2ad5fbc3d1c, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F427400610564939776%2FqJ4j0iHs.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f94670742f70aef0a6c344ed7a33e7c6 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F427400610564939776%2FqJ4j0iHs.png?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4abe3daddc39700ff76f009ed03ae3b6 3x"}, "body": "伍段さん\nいつもお世話になっております。\n\n 私の創作キャラを使用していただき、作品を書いていただきたく存じます。\n伍段さんの作品はどのジャンルであろうとも本当にエッチなので、自分のキャラでぜひにとも書いて欲しいという欲求が抑えきれず今回依頼させて頂きました。\n\n 使用していただきたいキャラクターとその設定を今回依頼したい内容の下に纏めさせていただきます。\nシチュ設定共に長く書いておりますが、勿論全て守っていただかなくてもかまいません。\n・楽しく乱交するモミジ\n・口では否定しながらも身体は正直ですぐ快楽に流されるナツキ\nの激しいエロ痴女らの乱交現場さえ書いていただければ、他は全てお任せいたします。\n\n 以下、書いて頂きたいストーリーとなります。\n\n────\n 海に遊びに来た美術部。\n皆で遊びに来れたことが嬉しくて大はしゃぎなモミジ。ハイテンションのまま探検へ向かう。直感で何かありそうな、海岸から少し外れた暗い建物に向かうと怪しげながらも楽しげな声がする。好奇心のままに声の方へ向かうとそこには乱れに乱れる男グループらの姿があった。\nその場所はビーチでも大人気のヤリスポットだった。\n「エッチしてル！楽しソー」と、普段見れない光景なので興味深げに乱交を覗いていたモミジ。背後からモミジの身体を舐め回すように見ていた男が近付き、尻を撫で回しながら「ヤりに来たんでしょ、君も見てないでシようよ」とモミジを誘う。\n「ンー、チガウけど……でもイイヨー！エッチ、シヨー！」と快諾するモミジ。\nヤリチン男のテクニックはかなりものでモミジも即気持ち良くなり、されるがまま。極上の身体に更に盛りつく男。「キミばっかにサせてちゃ、ゴメンネだかラー♡」と言って主導権を握り、攻守交代。男をトロトロにすると楽しくなってしまいそのままゴム交尾。激しい交尾の様子に興奮した他の男達も寄ってきてモミジを犯し始める。モミジはそのまま全員の相手を始める。\n\n モミジを探しに来たナツキが乱交現場を目撃。\nモミジを心配するがいつもの調子で「ナツキもシヨー！エッチ、楽しいヨ♡」と誘われる。レ○プじゃなかったので安心するも、いけない事だと連れて帰ろうとするがナツキの隠しきれないエロボディに盛った男が巨根を擦り付けながらナツキを誘う。\nモミジにも推されてしまい、ちょっとだけならと言うナツキ。\n巨根の形と匂いだけで濡らしており、男根に口付けしてフェラチオ。そのまま流されるままにゴムありセックスに興じてしまう。\n\n 中々戻ってこない2人を探しにきたハルカが現場に辿り着き、快楽のままにセックスに興じる2人を見つける。激しい乱交騒ぎに頬を赤らめつつも、2人とも楽しそうだったので安心し、放っておくことにするハルカ。「ほ、ほどほどにしてくださいね〜」と手を振って、その場を後にした。\n────\n\n 以下、使用していただきたい創作キャラクターの設定となります。\n設定など細かく守っていただかなくてかまいません。\nモミジとナツキの2人を使っていただければ他は出してもらわなくても問題ありません。\n\n──美術部──\n\n・モミジ・クルーシャン\n身長 170cm バスト 100cm手前\n一人称 ワタシ\n二人称 アナタ キミ\n部員の呼び方 \nナツキ ハルカ ユキメ\n\n美術部の部長。高等部三年生。\n帰国子女でグラマラスボディ、輝く金髪に赤メッシュの入った髪型の美少女。左耳には青く輝くピアスをしている。\nとにかく美形でそこにいるだけで目立つ。カタコトにちょこっとルー語混じりの変な口調で話す。\nいつも笑顔の天真爛漫で遊び好き。体力お化け。\n人と遊んだり楽しいこと、そして人に喜んでもらうのが大好き。自身の美貌には無自覚で貞操概念が緩く、セックスであろうとお願いされればノってしまい楽しんでしまう。\n初めてのことでもすぐコツを掴める天才肌で、セックスにおいてもその才能は遺憾無く発揮される。相手の反応で気持ち良い攻め方や性感帯もすぐ見つけてしまう。\n部員皆が大好きでナツキとは親友。\n布面積の小さい星条旗ビキニ。\n\n・石清水ナツキ （イワシミズ）\n身長166cm バスト100cm超\n一人称 アタシ\n二人称 あなた 君\n部員の呼び方\nモミジ→部長 ハルカ→ハルカちゃん ユキメ→ユキメ\n\n高等部二年生。\n肩より長いライトブラウンの髪をサイドテールにまとめた、少しギャル風な見た目に反して大人しめで控えめな性格の美少女。隠れオタク趣味を持つ。\n友達想いな心優しい少女で、部長を誰よりも尊敬し慕っている。\n驚愕の爆乳に乳首も乳輪も大きく脚も太く尻も大きい、男好きするむちむちエロボディの持ち主。\nムッツリスケベでエッチなことには割と興味津々。\n口では否定してわたわたしつつもしっかりチンポを見てしまっていたりする。\nあまりの爆乳に水着がはち切れそうになっている。\n\n・枚芽坂ハルカ （ヒラメザカ）\n身長164cm バスト95cm\n一人称 わたし\n二人称 あなた\n部員の呼び方 \nモミジ→部長 ナツキ→ナツキ先輩 ユキメ→めー\n\n高等部一年生。\n片目隠れの髪型に一つ結びの美少女。おっぱいはデカい。\n人のために働くことを苦に思わない働き者。優しい性格で基本的にはツッコミ役。\nエッチなことに別段興味はない。先輩達が楽しんでるなら良かった良かったな気持ち。\nちゃんとゴム付けてたし安心した。\nユキメとは親友であり、保護者ポジション。\n\n・紫陽平ユキメ （アジヒラ）\n身長145cm バスト とにかく真っ平\n一人称 私\n二人称 あなた あんた 君\n\n高等部一年生。\n小柄体型に加えて高一と思えない態度言動のGAKI系女子。\nちんちくりんで残念な性格だが容姿だけなら良い方。美術部のマスコット。\n守銭奴で気分屋でマイペース、勝ち気でわがままながらもビビりで命乞いしがち。しかし根は心優しく困ってる人は見過ごせないお人好し。\nエッチなことは全く知らない。したいと思ったことも特にない。", "nc": 169, "word_count": 6474, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@wati_yuru/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 183473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3fea88f9/uploads/origins/d632af28-1200-4b44-93ee-635bc53ef8cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7389d05148157729d8c200b46fc77dd", "srcset": "https://si.imgix.net/3fea88f9/uploads/origins/d632af28-1200-4b44-93ee-635bc53ef8cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7389d05148157729d8c200b46fc77dd, https://si.imgix.net/3fea88f9/uploads/origins/d632af28-1200-4b44-93ee-635bc53ef8cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e8a8cb2e8509a8aa2442c5b79bd9668 2x, https://si.imgix.net/3fea88f9/uploads/origins/d632af28-1200-4b44-93ee-635bc53ef8cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7717bf842b731b6dc566ca048740edb7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3fea88f9/uploads/origins/d632af28-1200-4b44-93ee-635bc53ef8cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ee5538433e505afd03223bd346c26da", "srcset": "https://si.imgix.net/3fea88f9/uploads/origins/d632af28-1200-4b44-93ee-635bc53ef8cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ee5538433e505afd03223bd346c26da, https://si.imgix.net/3fea88f9/uploads/origins/d632af28-1200-4b44-93ee-635bc53ef8cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=203edbf12fefff240abd50d658849d62 2x, https://si.imgix.net/3fea88f9/uploads/origins/d632af28-1200-4b44-93ee-635bc53ef8cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc8e7d953ad054add6ff73ef099d5631 3x"}, "body": "伍段さんの書かれる背徳的なシチュが大好きなので今回リクエストしました。\n\nお願いしたいのはららマジのお題で遊び相手(セフレ)の結城菜々美と有栖川翼とチューナーによって楓智美が遊び相手に堕ちるまでのシチュエーションをお願いします。\nまた、チューナーは九条紗彩と良い関係になりたいという悩みを持っている設定でお願いします。\n(関係についての度合いはお任せします)\n\n以下、欲しいシチュエーションまたはセリフ\n\n「前に今度絶対一緒にしよっ！って言ったよね」と智美を複数プレイでの肉体関係に堕とそうとしている翼\n\nチューナーが悩んでたから二人で悩みを問い詰めたんだ。\n「じれったいから私と菜々美で練習台に立候補しちゃった」と言って逆レイプを匂わせる表現\n\n「紗彩の気持ちが大切だからって同意を得るまではしないんだって。チューナーは優しいよね」という翼の言葉に対して\n「いや、優しいなら浮気はダメだろ」という内心でもいいので智美のツッコミ\n\n\n舌を交わらせる熱いキスや過激なプレイに対して菜々美か翼がこれは練習だから大丈夫だと言い張るシチュ\n\nチューナーとの激しいプレイでグッタリしている菜々美\n\nチューナーに抱きつきながらHをする翼\n\nチューナーは紗彩と愛のあるHがしたいという願望があることを言う翼か菜々美\n\nチューナーとエッチなことをすることに対しての抵抗が緩んでいく智美\n\n蕩けながらHしている智美\n\n「もう一回しよっ♡」と言う翼\n\n\n\n以上です。\n長文になってすみません。\nセリフやシチュエーションは書きやすいようにガンガンアレンジしてもらって大丈夫です。\n菜々美と翼とチューナーの爛れた関係性や智美のエッチなことに対しての心の抵抗が緩んで堕ちてしまうシチュエーションが有れば大丈夫です。\nよろしくお願い致します。", "nc": 168, "word_count": 5755, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@wati_yuru/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 183473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7841148b/uploads/origins/2640d226-c63c-486b-808d-7a573e969cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c32d4f6e36464fb9c7ba30ca2be08935", "srcset": "https://si.imgix.net/7841148b/uploads/origins/2640d226-c63c-486b-808d-7a573e969cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c32d4f6e36464fb9c7ba30ca2be08935, https://si.imgix.net/7841148b/uploads/origins/2640d226-c63c-486b-808d-7a573e969cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b9ce2c6b2805685261513137a995bf7 2x, https://si.imgix.net/7841148b/uploads/origins/2640d226-c63c-486b-808d-7a573e969cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bca12b8e14dc9a33fe5ff1675cbe6589 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7841148b/uploads/origins/2640d226-c63c-486b-808d-7a573e969cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87d5153a73323dcab6f25ced39540f1a", "srcset": "https://si.imgix.net/7841148b/uploads/origins/2640d226-c63c-486b-808d-7a573e969cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87d5153a73323dcab6f25ced39540f1a, https://si.imgix.net/7841148b/uploads/origins/2640d226-c63c-486b-808d-7a573e969cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=642273e7bf43faa704652c32ab66cf13 2x, https://si.imgix.net/7841148b/uploads/origins/2640d226-c63c-486b-808d-7a573e969cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fc96eb4be8e839a5121d951ed41f1740 3x"}, "body": "先日は紗彩ちゃんの作品ありがとうございました。あの後の続きが気になったのでリクエストしました。\n今回もららマジの九条紗彩と瀬沢かなえが出てくるお話をお願いします。\n\n以下、できれば入れて欲しいシチュエーション\n\n・チューナーと紗彩の情事の一部始終をこっそり見ていたのがバレるかなえ\n\n・「先輩たちがキスしてるのを見たいです」と言ってチューナーと紗彩の濃厚なキスを見た後にキスをされて蕩けるかなえ\n\n・「チューナー先輩を狙ってる女の子はいっぱいいるんですからこんなこと他の子にしちゃダメですよ」と言うかなえ\n\n・手錠を付けられたかなえが「こういう変態チックなのは女の子に嫌われますよ」と小言を言った後に二人に乳を吸われたりクリを責められたりして可愛がられて、ハメ倒されて堕とされてしまうシチュエーション\n\n・後日コスプレをした紗彩とかなえでダブルフェラからの3P\n\n・紗彩とチューナーでイチャついているところでかなえがおねだりするシチュエーション\n\n以上です。最初は必死に喘ぎ声を我慢しようとするかなえが快楽堕ちさせられてしまう雰囲気だと嬉しいです。アレンジ等有ればお任せします。", "nc": 177, "word_count": 7042, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@wati_yuru/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 183473, "client_id": 638155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf3167ba/uploads/origins/b8c469e1-8d2b-4075-b6bc-bedd181ffad7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9f