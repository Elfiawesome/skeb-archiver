creator_acceptable_same_genre": false}, {"path": "/@4_jbuw/works/76", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c8446b66/uploads/origins/b5b790ed-592c-4dd5-9578-3718bd184315?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48554481557496b07052a89894778b8b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3497268, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@4_jbuw/works/75", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3497268, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea458134/uploads/origins/26ff4f77-a700-48cc-ad5f-ccd468bd2fec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58b4725fe61cb5dd3eb050ffafdf523e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea458134/uploads/origins/26ff4f77-a700-48cc-ad5f-ccd468bd2fec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=394559d091ada085933dd72f640a5a28", "src_set": ""}, "body": "にゅさん、こんにちは！\n\nにゅさんのイラストがとてもすてきだと思います、ぜひリクエストをお願いできないかと思い、ご連絡しました。\n\n私はVTuberをしており、キャラクターは「レミー」という狼少年の漁師です。彼は元気いっぱいで、少しおっちょこちょいなところもありますが、いつも一生懸命頑張っています。もし可能であれば、リラックス系のASMRに使えそうなポーズや構図をお願いしたいです。たとえば、座っている姿や、リラックスした雰囲気でカメラを見ているようなイメージです。（Tシャツとズボンのようなラフな服装でも大丈夫です）。\n\n表情は、見る人を見上げるようなやさしい笑顔、もしくはそれに合う雰囲気の表情が嬉しいです。こちらの作品の男の子の表情のようなものでも問題ありません。こういった雰囲気がとても好みです: https://skeb.jp/@4_jbuw/works/54\n\n全体の雰囲気がやわらかくてあたたかいものであれば、構図などはおまかせします！\n\n描いていただいたイラストは、YouTubeのサムネイル（ASMRやゲーム配信、告知など）に使用させていただきたいと考えています。にゅさんのお名前は必ずクレジット表記いたします。\n\nもし