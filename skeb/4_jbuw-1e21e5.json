じです！\nお洋服が見えるように、胸より下の描写だと大変嬉しいです。\nご縁がありましたらぜひよろしくお願いします🌙\n\nhttps://drive.google.com/drive/folders/11HnfjZKuLjMoi0Yw7ukGYlHyfoxU8qzf", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@4_jbuw/works/80", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3497268, "client_id": 2586339, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e57cd6d/uploads/origins/df915999-1b6e-4d11-bdb7-3b8121203e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6c20fd84a6762ed31a8a54a5224a0bd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e57cd6d/uploads/origins/df915999-1b6e-4d11-bdb7-3b8121203e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17e29e37fe643f60515510c4493ee4aa", "src_set": ""}, "body": "にゅ様、はじめまして！失礼します🥺❤️\n先生の作品が大好きです！こちらの二人を描いて頂けると幸いです。\n\n男性：182cm｜チャラな謎の陽キャイケメン。腹黒く狡猾ですが優しく無邪気な姿を演じるちょっと危険な男\n女性：168cm｜一見クール系美少女だが、実はドジで残念系人見知りの弱気陰キャ女\n二人わ幼馴染で、距離感近すぎても誰もおかしいっど気づかなかった、両思いなのに友達以上で停滞状態の関係です。それだけでなく、お互いに複雑で少し暗い感情を抱いています。\n\n金額が足りない場合は、適切な金額をご提案ください。ご検討よろしくお願いいたします。\n\n▼キャラクター資料：\nhttps://drive.google.com/drive/folders/1g1ERX8GJl4E5wE8UumJVkR6GoI7nuMT-?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@4_jbuw/works/79", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7bfdbfd3/uploads/origins/db80bb1a-056d-4324-baef-66463ff5b8e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53b411787d0ed8d320571d3ad61d945a", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3497268, "client_id": 2704747, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": fal