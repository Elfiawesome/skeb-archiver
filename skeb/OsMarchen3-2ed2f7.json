3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac89f747262cc6c9c28c30023521b9c3", "srcset": "https://si.imgix.net/3c424ce6/uploads/origins/a8c9df39-9cab-4271-b45c-7deae1decfca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac89f747262cc6c9c28c30023521b9c3, https://si.imgix.net/3c424ce6/uploads/origins/a8c9df39-9cab-4271-b45c-7deae1decfca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a80c90b741686b98fcf21dda3278bcd6 2x, https://si.imgix.net/3c424ce6/uploads/origins/a8c9df39-9cab-4271-b45c-7deae1decfca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93203330a266922dd7e7d207f7e01702 3x"}, "body": "こんばんは。以前、天上優夜の肥満状態の横平面化を依頼した者です。\n再送依頼をさせていただきます。\n\n今回は「グレイプニル」の主人公、加賀谷修一を肥満化させた状態からペラペラにしてください。\n\n1枚目\n肥満化した状態で立っている。（足まで全身描いていただけると幸いです）\n\n2枚目\nしぼんだ風船のように空気が抜けてペラペラになっている。\n両手を下ろした姿勢で寝転んで、表情は困惑している。\n\n\nキャラ一覧（一番上が修一くんです。残念ながら個人ページがありませんでした）\nhttp://gleipnir-anime.com/character/\n\nアニメPV\nhttps://youtu.be/tdrYtiEPr7w?si=3F2-qCxGC8UBdbFj\n\nしぼんだ風船のイメージ画像\nhttps://images.app.goo.gl/qyzZo2YBYvhBbhAe6\n\n是非ご検討よろしくお願いします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OsMarchen3/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1446691, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7bae0858/uploads/origins/a2e2610c-5169-4db9-ae10-af8298e6a7e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71246df011617fc982a16a37ce73b495", "srcset": "https://si.imgix.net/7bae0858/uploads/origins/a2e2610c-5169-4db9-ae10-af8298e6a7e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71246df011617fc982a16a37ce73b495, https://si.imgix.net/7bae0858/uploads/origins/a2e2610c-5169-4db9-ae10-af8298e6a7e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab7971262c56ea28d9719d908bd9b6ac 2x, https://si.imgix.net/7bae0858/uploads/origins/a2e2610c-5169-4db9-ae10-af8298e6a7e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a485d3f09a4e04e32c42fc7b1ece8760 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7bae0858/uploads/origins/a2e2610c-5169-4db9-ae10-af8298e6a7e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72def5a1984178d4047119f58eca011e", "srcset": "https://si.imgix.net/7bae0858/uploads/origins/a2e2610c-5169-4db9-ae10-af8298e6a7e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72def5a1984178d4047119f58eca011e, https://si.imgix.net/7bae0858/uploads/origins/a2e2610c-5169-4db9-ae10-af8298e6a7e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=66a2aac61d52de9de1013c56ac07a8e1 2x, https://si.imgix.net/7bae0858/uploads/origins/a2e2610c-5169-4db9-ae10-af8298e6a7e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7139162fd2781569f20d6b3524c021cd 3x"}, "body": "はじめまして。イラストをskebで見かけて惹かれたので頼ませていただきました。もしよろしければ、「異世界でチート能力を手にした俺は、現実世界をも無双する～レベルアップは人生を変えた～」の主人公、天上優夜が痩せる前の状態が可愛いので、ペラペラにしていただけませんか？\n\nhttps://twitter.com/iseleve_anime/status/1643810763918700544?s=20\nこの動画のおよそ4秒目のところで写ってる子です。\n\n1枚目\n特に変化はなしで立っている状態。\n\n2枚目\nゴンダラに潰されて両手を上げてバンザイをしている姿勢でペラペラになっている。表情は困惑している。\nいわゆる「横平面化」というタイプです。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OsMarchen3/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1446691, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f8a4e09/uploads/origins/3bd97b68-f4fa-485c-aa4e-c2ca58481b30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39e27668e7cbea74e7312a033d438c13", "srcset": "https://si.imgix.net/8f8a4e09/uploads/origins/3bd97b68-f4fa-485c-aa4e-c2ca58481b30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39e27668e7cbea74e7312a033d438c13, https://si.imgix.net/8f8a4e09/uploads/origins/3bd97b68-f4fa-485c-aa4e-c2ca58481b30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a353496fcefc610cab3f88b0661e0376 2x, https://si.imgix.net/8f8a4e09/uploads/origins/3bd97b68-f4fa-485c-aa4e-c2ca58481b30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95d17414f95cb20387f3d538ef72d149 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f8a4e09/uploads/origins/3bd97b68-f4fa-485c-aa4e-c2ca58481b30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7cbc2ffd8236a7758e15d8648d029e8", "srcset": "https://si.imgix.net/8f8a4e09/uploads/origins/3bd97b68-f4fa-485c-aa4e-c2ca58481b30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7cbc2ffd8236a7758e15d8648d029e8, https://si.imgix.net/8f8a4e09/uploads/origins/3bd97b68-f4fa-485c-aa4e-c2ca58481b30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b8d224293a3978c5ce4566846b0f4f5 2x, https://si.imgix.net/8f8a4e09/uploads/origins/3bd97b68-f4fa-485c-aa4e-c2ca58481b30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=237d945ea4640df1f2516f4606baa034 3x"}, "body": "「オラオラ系巨デブが上からプレス機でプレスされてパンケーキみたいにぺっちゃんこ(平面化)に潰されたり、暑さに負けてスライムみたいにトロトロ(液体化)にとろけちゃう様子」を、3つのシチュごとに1枚ずつで計3枚お願いできますか？(全体的にギャグ寄りのコミカルなシチュ)\n\n【キャラ概要】\n・髪型は、ワイルドなツーブロック\n・太眉。服装はおまかせ。\n・髭が鼻と口の間と、顎周りに生えている。\n・我が強そうな顔。\n・へそ下の毛と、地肌が見える程度に生えた腕毛がセクシー。\n・すごい太っていて、お腹はまん丸で大きい(そちらのオリキャラの石北海さんくらいの体型でお願いします)\n・腹が大きすぎて、服の下から外にでっぷり出ている。\n・どのシチュでも汗をダラダラかいてる。\n\n〈シチュ1〉\n・特殊シチュでもなく、ただ立っている状態の絵。身体の角度は自由。\n\n〈シチュ2〉\n上からプレス機で潰されて、顔と掌を上に向けたポーズのままパンケーキのようにペラペラになって床に広がっている(Googleで「glamrock flattened」「furry pride 2019 flattened」「furry wolf odonnell flattened」などで調べると参考になる画像が出てくると思います)\n・身体の厚みはヨガマットくらい薄い。\n・元々太っているのが潰れた事で、顔も身体もビヨーンと横に間抜けに伸びている。\n・「何で俺がこんな目に…？」みたいな表情している。\n・畳み10畳の床と同等くらいの面積に広がる。\n\n〈シチュ3〉\n・シチュ2の後に身体が元に戻った後、今度は部屋の中が暑すぎて身体が溶けて液体になって、ド○ゴンク工ストに出てくる「はぐれメ○ルキング」みたいな姿で床に伸び広がっている(ただし頭に王冠は被ってないし、顔もスライム顔じゃなくて元の本人のまま)\n・身体は頭以外の全身が溶けてその形を失っており、頭もほぼ溶けて顎周りなど顔の輪郭が消失している(Googleで「furry melted」で検索すれば参考になる画像が出てくると思われます)\n・頭には王冠の代わりに、元の姿同様に髪の毛が生えている。\n・身体の色は肌の色そのままで、この状態では服は着ていない。\n・身体の所々が溶けて滴っている。\n・「暑いなチクショー…」みたいな表情している。\n・畳み10畳の面積と同じくらい床に広がってる。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 23311, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "智也🍁🐾ブーストB-22", "screen_name": "tomoyamaru", "avatar_url": "https://pbs.twimg.com/profile_images/2064124368205332480/y2OSZ0Kw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3278828089/1703705080/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id": 50556, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "灰汁", "screen_name": "haijiru334", "avatar_url": "https://pbs.twimg.com/profile_images/1978873434869207040/Zas6sPcg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/731821562760814592/1742981390/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 317338, "creator": true, "nsfw_acceptable": tru