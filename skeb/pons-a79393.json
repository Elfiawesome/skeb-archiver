3962708\n\nhttps://x.com/osoranomob/status/1984522021037097068\n(自分でまとめているものですがこちらのショートの髪型でお願いします)\n\n◯用途\n3月20日が透乃さんのお誕生日なので当日にFAとしてXへの投稿とお渡しをする予定です\nまたご本人様の活動（XやYouTube等）での使用の許可を併せてお願いします\n\n◯その他\n人物・サイン・背景等レイヤー分けされたPSD ファイルで頂けたら幸いです\n\n◯二次創作ガイドライン\nhttps://varium.jp/guide_line/\n\n以上となりますが何卒ご検討の程宜しくお願いします", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pons/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/456f59d3/uploads/origins/952ac06d-24ed-4896-9e7e-f7a251b98a7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4a94b9df3df370acf60e11ca4ecb6fc", "srcset": "https://si.imgix.net/456f59d3/uploads/origins/952ac06d-24ed-4896-9e7e-f7a251b98a7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4a94b9df3df370acf60e11ca4ecb6fc, https://si.imgix.net/456f59d3/uploads/origins/952ac06d-24ed-4896-9e7e-f7a251b98a7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=979dcde87498807e759eb657efac719e 2x, https://si.imgix.net/456f59d3/uploads/origins/952ac06d-24ed-4896-9e7e-f7a251b98a7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f95810179fa361ce771dabf162ed4b9 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2703563, "client_id": 3807611, "nc": 177}, {"path": "/@pons/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2703563, "client_id": 3774002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d86f1881/uploads/origins/6