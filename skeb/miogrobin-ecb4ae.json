f&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=727f0778fb4092187ef64be003c04690 3x"}, "body": "お世話になっております。\n\n先日はカプリスちゃんの可愛いイラスト、ありがとうございました！\n今回もカプリスちゃんのイラストをご依頼できればと思い、リクエストさせていただきます。\n\n【依頼概要】\n自分の誕生日が近いので、誕生日をテーマにしたカプリスちゃんのイラストをご依頼できればと思います。\n①カプリスちゃんが誕生日をお祝いしてくれているイラスト\n②カプリスちゃんが誕生日会を楽しんでいるイラスト\n③カプリスちゃんが誕生日をお祝いされているイラスト\nいずれかをお願いできればと思っています。\n\n【キャラクター】\n前回依頼時をご参照願います。\nhttps://skeb.jp/@miogrobin/works/1\nテーマに沿ったイラストにするにあたり、服装等変更いただいて構いません。\n\n【備考】（前回同様の文になります）\n構図・ポーズ・背景・情景・所持品（武器、飲み物、ぬいぐるみ等の所持有無）、周囲のキャラクター（きのこの精がいたり）等に希望はありません\nキャラクターの希望に関し、変更した方が依頼概要に沿える等ありましたら、遠慮なく修正ください\n\n【使用用途】（前回同様の文になります）\n各種SNS等のアイコン、ヘッダー等への使用\n動画・配信サイトにおけるサムネイルや動画内への使用\n作品及びキャラクターに対し、miogrobin様に同モチーフでの場面や衣装違い等での依頼\n作品及びキャラクターに対し、私的利用目的でのイラスト等の二次創作及びその依頼\n私的利用を目的として、作成後のイラストをポスターやタペストリー等のグッズ作成への使用\n\nご検討いただけますと幸いです", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@miogrobin/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 205639, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de269e3d/uploads/origins/6c4866cc-e159-430c-86c8-69fe307f920c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5590e1bcce528e7445e87d3c687d7e8", "srcset": "https://si.imgix.net/de269e3d/uploads/origins/6c4866cc-e159-430c-86c8-69fe307f920c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5590e1bcce528e7445e87d3c687d7e8, https://si.imgix.net/de269e3d/uploads/origins/6c4866cc-e159-430c-86c8-69fe307f920c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adac590559fea1aa5b2f8b5c378c62c4 2x, https://si.imgix.net/de269e3d/uploads/origins/6c4866cc-e159-430c-86c8-69fe307f920c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=504088aafffd95fd811bf0ab02b07aaa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de269e3d/uploads/origins/6c4866cc-e159-430c-86c8-69fe307f920c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5be0a54078bc34324881277272e7db40", "srcset": "https://si.imgix.net/de269e3d/uploads/origins/6c4866cc-e159-430c-86c8-69fe307f920c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5be0a54078bc34324881277272e7db40, https://si.imgix.net/de269e3d/uploads/origins/6c4866cc-e159-430c-86c8-69fe307f920c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd930bfd449fe0377a81934c33227ecc 2x, https://si.imgix.net/de269e3d/uploads/origins/6c4866cc-e159-430c-86c8-69fe307f920c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=30e792304d27c8042353916566569df8 3x"}, "body": "はじめまして。miogrobin様が過去に携わっていたカードゲームのファンで、偶然Skebをされていると知りリクエストお送りさせていただきました…！\n\n【描いていただきたいキャラ】\n自分のオリジナルキャラクター\n\n【キャラクターの特徴】\n・オッドアイの四白眼です。(赤紫×瑠璃色)が、よく伏せ目になったりするので三白眼の認識でも大丈夫です\n・性別はございませんので中性的です。\n(上半身が華奢な男子で、下半身は女の子……なイメージです。)\n・身長は160cmほど\n・性格は明るい、勝気、自信家、元気、きまぐれ\n・チャームポイントは大きなリボンです。\n・カジノディーラーをしています！\n\n【構図】\nmiogrobin様の描かれる脚がとても好きなので、脚を描いていただけますと嬉しいです。\n特にhttps://www.foriio.com/works/27927の一枚目のカードイラストが好きです…！！\n他はお任せします。\n\n【使用用途】\n個人観賞用ですが、SNSのアイコンやヘッダーなどに使用させていただくこともあるかと思います…！！\n\nご検討のほどどうぞよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1CR4o7XQitRxgKly-g-eNAuhjbA5o8zVK?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@miogrobin/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 205639, "client_id": 1452638, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a9c4bcd/uploads/origins/af6ad7b8-a100-4512-8c4d-ead33decc1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a79d3c158342121563b4cac91d433e51", "srcset": "https://si.imgix.net/3a9c4bcd/uploads/origins/af6ad7b8-a100-4512-8c4d-ead33decc1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a79d3c158342121563b4cac91d433e51, https://si.imgix.net/3a9c4bcd/uploads/origins/af6ad7b8-a100-4512-8c4d-ead33decc1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f068ea5c316108431fd3036e50feabab 2x, https://si.imgix.net/3a9c4bcd/uploads/origins/af6ad7b8-a100-4512-8c4d-ead33decc1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca0213b0e051e2cdf1faf8b5b3f50dce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a9c4bcd/uploads/origins/af6ad7b8-a100-4512-8c4d-ead33decc1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75a888183632101012bd72c02a5718f1", "srcset": "https://si.imgix.net/3a9c4bcd/uploads/origins/af6ad7b8-a100-4512-8c4d-ead33decc1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75a888183632101012bd72c02a5718f1, https://si.imgix.net/3a9c4bcd/uploads/origins/af6ad7b8-a100-4512-8c4d-ead33decc1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d35affbbe45b5f29ba66dd72918a1eb8 2x, https://si.imgix.net/3a9c4bcd/uploads/origins/af6ad7b8-a100-4512-8c4d-ead33decc1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2f34b92f910c0876f817073a187f4453 3x"}, "body": "お世話になります\n自分がプレイしていたゲームでのmiogrobin様のイラストがとても好きで、ゲーム自体は終了してしまった今でも大好きです\n是非とも、イラストを描いていただければと思い、依頼させていただきます\nキャラクターに関し、参考にした作品はmiogrobin様のポートフォリオ内の作品につきましては作品内名称〔出展作品〕という形で記載しています\n\n【依頼概要】\nきの娘（きのこ＋女の子）のイラストの依頼となります\nイメージとしては、miogrobin様が過去に描かれているアニエス〔アルテイル〕と対になる、あるいは姉妹のような希望で依頼させていただきます\n\n【キャラクター】\n名前：カプリス\n特徴：きのこをイメージする赤いカサが頭にある少女\n髪の長さ、髪型：お任せします\n髪の色：毛先カラー　根本と毛先、共に色はお任せします（噴進職人ロケッタ〔Z/X〕やアニエス〔アルテイル〕のような毛先カラー）\n眼の色：お任せします\n表情：お任せします\n口元：ギザ歯\n服装：黒を基調としたダボ袖のシャツのような服。その服をいわゆる裸シャツように羽織っているだけの状態で、正面は開いてしまっているような服装\nバスト：ちいさめ（有る）\n足元：素足\n性格：強気、勝気（時計職人クロックワーク〔Z/X〕やアーティフィシャルフィスト〔Z/X〕のようなイラストから受ける印象）、わがまま、気まぐれ\n\n【備考】\n構図・ポーズ・背景・情景・所持品（武器、飲み物、ぬいぐるみ等の所持有無）、周囲のキャラクター（きのこの精がいたり）等に希望はありません\nキャラクターの希望に関し、変更した方が依頼概要に沿える等ありましたら、遠慮なく修正ください\n\n【使用用途】\n各種SNS等のアイコン、ヘッダー等への使用\n動画・配信サイトにおけるサムネイルや動画内への使用\n作品及びキャラクターに対し、miogrobin様に同モチーフでの場面や衣装違い等での依頼\n作品及びキャラクターに対し、私的利用目的でのイラスト等の二次創作及びその依頼\n私的利用を目的として、作成後のイラストをポスターやタペストリー等のグッズ作成への使用\n\nご検討いただけますと幸いです", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 811279, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "桂", "screen_name": "katsura", "avatar_url": "https://pbs.twimg.com/profile_images/684950737130893317/cXi3qWTb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/6809622/1452140090/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 1401535, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "花鶏", "screen_name": "a__ttori", "avatar_url": "https://pbs.twimg.com/profile_images/1849413422984888320/0SyoDxeL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1408052000089014283/1775206716/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1601681, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "鳩時計🌸", "screen_name": "nahato0308", "avatar_url": "https://pbs.twimg.com/profile_images/2025508642079076352/jNKec4s-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1273400452785168385/1