f145012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=242a047cdf2f79c0604740a51ff9467c, https://si.imgix.net/e39586f0/uploads/origins/ee5eb887-2287-4f5f-b13b-7ed99f145012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b4f309ef829d9572595bc051f3035bb 2x, https://si.imgix.net/e39586f0/uploads/origins/ee5eb887-2287-4f5f-b13b-7ed99f145012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4c918435c876e53fcb5887e322f345f2 3x"}, "body": "くるぽ様 \n\n先日は素敵なイラストをありがとうございました！！\n瞳の描き方と感情の表現の出し方が特に素晴らしく、背景も付けていただき大変嬉しく感じております！\n\nそんな素敵なイラストを拝見いたしましたので、もう1つリクエストをお願いしたく思い、送らせていただきました！\n\n今回のリクエストはOCの「アドラ」というキャラクターになります。\nこの子は陽気でおちゃらけており、やや傲慢な所もある性格の持ち主ですが、学園に潜入している革命軍のスパイという設定のキャラクターになります。\n\n服装は「アドラ④」を参考に、学園モードではなく、レジスタンスモードでお願いしたいです。\n\n全体的な構図は前回と似たような下からのアングルで、前回と違い、ハイライトはオンでお願いいたします。\n\n可能であれば、廃工場の中にいることがわかる背景を付けていただけると幸いです。\n\n以上となります。\nこちらでご検討いただけますと幸いです。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10BUWUEw4B-xqlBg7AJT3dVtSfr1FSjsZ", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@krpy_n/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 9093, "client_id": 510885, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3339ead9/uploads/origins/8423f3c1-8b79-4ec2-ba2d-8de3e20e6523?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=959f3faceceb1616aa28f052c45fdf14", "srcset": "https://si.imgix.net/3339ead9/uploads/origins/8423f3c1-8b79-4ec2-ba2d-8de3e20e6523?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=959f3faceceb1616aa28f052c45fdf14, https://si.imgix.net/3339ead9/uploads/origins/8423f3c1-8b79-4ec2-ba2d-8de3e20e6523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7002713b66cc02aacfcddf58b14dc60d 2x, https://si.imgix.net/3339ead9/uploads/origins/8423f3c1-8b79-4ec2-ba2d-8de3e20e6523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=647a3344c79fea1a5ee241485ef6040f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3339ead9/uploads/origins/8423f3c1-8b79-4ec2-ba2d-8de3e20e6523?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebc23ab0df399b48bfa6e7f0982d35dc", "srcset": "https://si.imgix.net/3339ead9/uploads/origins/8423f3c1-8b79-4ec2-ba2d-8de3e20e6523?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebc23ab0df399b48bfa6e7f0982d35dc, https://si.imgix.net/3339ead9/uploads/origins/8423f3c1-8b79-4ec2-ba2d-8de3e20e6523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=08f5f04a7f6137fed7c0ffe5626ce435 2x, https://si.imgix.net/3339ead9/uploads/origins/8423f3c1-8b79-4ec2-ba2d-8de3e20e6523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8d4e91b770f4a20f03756f47e501f13b 3x"}, "body": "くるぽ様\n\n再送依頼していただきありがとうございます！\n依頼内容を修正させていただきます！\n\nリクエストキャラクターはOCのフリテールというキャラクターです。\nフリテールは宝石と童話の要素をいくつか取り入れたキャラクターです。\n性格はおっとりで毒舌、ノンデリのハッキリ物事を言ったりするタイプで、闇深い面もあります。\n\nイラストは膝〜全身の範囲を希望しており、\n構図はこちらを見下ろす(見下す)形で、\n表情は無な感じでお願いしたいです。\n(目のハイライトがない感じでお願いしたいです。)\n\nまた、両耳に宝石(シトリン)のイヤリングを追加していただきたいです。\n(形はファイル内を参考にお願い致します。)\n\n以上となります。\n金額面での不足などございましたら、お手数をお掛けいたしますが、再送依頼をしていただけると大変助かります。\nこちらでご検討のほどよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1YQ1Encxldw44HzIC6ghRnRH8xh-9ahmp", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@krpy_n/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 9093, "client_id": 3455361, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23fb6f0a/uploads/origins/cc086398-bc40-41fe-9ca7-5517064b76a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fi