知らない人には冷たいが、仲良くなると非常に熱心になる人。\n・身長156センチ/Gカップ\n・帽子の耳部分についてですが、フードに耳が付いているわけではなく、淡い黄色の半透明シェルで耳を覆っているデザインとなっております。シェル越しに中の獣耳が見えるイメージですので、その点のみご留意いただけますと幸いです。難しい場合はフード部分を省略していただいても問題ございません。何卒よろしくお願いいたします。\n\n●お願い●\n・納品形式は、PSDでお願いします！\n・頭部、髪の毛、尻尾が切れていないキャラクターのみ透過データ(背景透過)と、背景があればいただけますと幸いです。\n\n非常に感謝しています🙇‍♀️\n\nhttps://drive.google.com/drive/folders/1qJMeOrVqIZyumHRtLQB5Sg01QzLmpNyX?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@deko_mo10/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3131963, "client_id": 2250716, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d17b2a3f/uploads/origins/7e0e1e04-901e-4e50-b06d-1bce7430abb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f3b779b6bad04b59d5849a7dcbb19f4", "srcset": "https://si.imgix.net/d17b2a3f/uploads/origins/7e0e1e04-901e-4e50-b06d-1bce7430abb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f3b779b6bad04b59d5849a7dcbb19f4, https://si.imgix.net/d17b2a3f/uploads/origins/7e0e1e04-901e-4e50-b06d-1bce7430abb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a888fd9ad9fe8933962655d44a7d7d9e 2x, https://si.imgix.net/d17b2a3f/uploads/origins/7e0e1e04-901e-4e50-b06d-1bce7430abb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc3a6f7aee1fb3be351a823b3279a45e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d17b2a3f/uploads/origins/7e0e1e04-901e-4e50-b06d-1bce7430abb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=551aec32341a6a9a43a6ade9b553730c", "srcset": "https://si.imgix.net/d17b2a3f/uploads/origins/7e0e1e04-901e-4e50-b06d-1bce7430abb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=551aec32341a6a9a43a6ade9b553730c, htt