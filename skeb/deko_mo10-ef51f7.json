す。\n\n【希望納品形式】\n可能であれば納品ファイル形式は通常のものに加え、「人物のみの透過PNG」もしくは「キャラクターと背景のレイヤーが分かれたPSD」だと嬉しいです。\n\n【用途】\n収益化済み配信サイト・SNS・グッズ等に使用させて頂く可能性がございます\n\nお忙しいところ恐れ入りますが、ご検討のほど何卒よろしくお願いいたします！！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@deko_mo10/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3131963, "client_id": 3263008, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aed1a2b8/uploads/origins/d15f7a35-0100-44ad-bc0c-e947db8663f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4b3660453dd1675e57fe6bd0a5b0d7a", "srcset": "https://si.imgix.net/aed1a2b8/uploads/origins/d15f7a35-0100-44ad-bc0c-e947db8663f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4b3660453dd1675e57fe6bd0a5b0d7a, https://si.imgix.net/aed1a2b8/uploads/origins/d15f7a35-0100-44ad-bc0c-e947db8663f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12b09eb293f8393676a0e91e58f80e3c 2x, https://si.imgix.net/aed1a2b8/uploads/origins/d15f7a35-0100-44ad-bc0c-e947db8663f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7116c6fb8c231309ef8853d9fa71d948 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aed1a2b8/uploads/origins/d15f7a35-0100-44ad-bc0c-e947db8663f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8c60585fe8f0acb77ceab77570f5734", "srcset": "https://si.imgix.net/aed1a2b8/uploads/origins/d15f7a35-0100-44ad-bc0c-e947db8663f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8c60585fe8f0acb77ceab77570f5734, https://si.imgix.net/aed1a2b8/uploads/origins/d15f7a35-0100-44ad-bc0c-e947db8663f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b6453aa6b47135b7220fae063f2f9324 2x, https://si.i