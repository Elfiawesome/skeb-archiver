決めようとしているか、シチュエーションは何でも構いません。\n・沢山の世界を超えて再会を繰り返し、色んな経験をしたお2人ですので、そういう関係性が表す様に、賑やかで温かい雰囲気の一枚をお願い致します。\n・「夏、トロピカル、冒険、太陽と月、夜明け・夕焼け、地平線、民族風」のモチーフをどちらでもご自由に使って大丈夫です。\n・ポーズや構図は他は何でも構いませんので、お気軽に描いてください！\n\n依頼内容に何か難しい点か問題点があれば、お気になさらずこの依頼をキャンセルしてください。ご検討のほど、何卒よろしくお願いします。\n\nhttps://www.deviantart.com/stash/221di69krep1", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@e_axqd/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3921827, "client_id": 3276002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/10170dcb/uploads/origins/7202c8ab-5dea-451e-8c44-05a6750e4071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11318f8d9293b13d84505d0cfbbc12fe", "srcset": "https://si.imgix.net/10170dcb/uploads/origins/7202c8ab-5dea-451e-8c44-05a6750e4071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11318f8d9293b13d84505d0cfbbc12fe, https://si.imgix.net/10170dcb/uploads/origins/7202c8ab-5dea-451e-8c44-05a6750e4071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e47b1ae4be4d3ad439f3c668e41540a 2x, https://si.imgix.net/10170dcb/uploads/origins/7202c8ab-5dea-451e-8c44-05a6750e4071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34202abae26cc7ac71274e2ca0478c0e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10170dcb/uploads/origins/7202c8ab-5dea-451e-8c44-05a6750e4071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2a5ea90d8213abe343962482e9efc7e", "srcset": "https://si.imgix.net/10170dcb/uploads/origins/7202c8ab-5dea-451e-8c44-05a6750e4071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2a5ea90d8213abe343962482e9efc7e, https://si.imgix.net/10170dcb/uploads/origins/7202c8ab-5dea-451e-8c44-05a6750e4071?bg=