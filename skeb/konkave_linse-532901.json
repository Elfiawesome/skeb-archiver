status/1769739723499512300\n\n耳の差分の参考資料になります。\nたれ耳うさぎの耳に飾り毛があるようなイメージです。\nhttps://x.com/sakuracofene/status/1835347826395758723/photo/1\n\nご検討のほどよろしくお願いします。\n\nhttps://twitter.com/sakuracofene/status/1767724504665768215", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@konkave_linse/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2603536, "client_id": 3598135, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/04030027/uploads/origins/635d907c-d13a-454b-9ea5-535daececb87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43bb43c23d57534be25c2b7cbfc45018", "srcset": "https://si.imgix.net/04030027/uploads/origins/635d907c-d13a-454b-9ea5-535daececb87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43bb43c23d57534be25c2b7cbfc45018, https://si.imgix.net/04030027/uploads/origins/635d907c-d13a-454b-9ea5-535daececb87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3cebd9cad05529b0ebe5474206e56fd 2x, https://si.imgix.net/04030027/uploads/origins/635d907c-d13a-454b-9ea5-535daececb87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=628811f41f172e9719deb43dbc68cf7d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04030027/uploads/origins/635d907c-d13a-454b-9ea5-535daececb87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a2deef70728695a351bf8cd8f4c23cd", "srcset": "https://si.imgix.net/04030027/uploads/origins/635d907c-d13a-454b-9ea5-535daececb87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a2deef70728695a351bf8cd8f4c23cd, https://si.imgix.net/04030027/uploads/origins/635d907c-d13a-454b-9ea5-535daececb87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=83