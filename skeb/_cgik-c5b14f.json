特徴：痩せ型でややなで肩\n・身長：173cm\n\n○その他\n【関係性】\n・中学までの幼なじみ。25歳で再会し、現在はプライベートで小旅行や外泊をするほど親密。\n・物理的距離感は近め\n・不安になったり困ったりしたときに、お互いを頼ることができる。\n\n\n【備考】\n・使用用途はSNSでのアイコンやヘッダー、壁紙等の個人利用。相方への共有、SNSでの掲載(クレジット表記有)\n\n\n\n上記詳細や金額に不足等ございましたらお気軽に再送申請ください。\nお忙しい中とは存じますが、何卒ご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1jYoJVqgk2dPi9FMgeuw1lbpISVHfS4FT?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2D_0r_N/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3966512, "client_id": 3385796, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7671b2ed/uploads/origins/671ec176-f032-401c-ab4c-0308ecef4b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9394be15ee74607f7be0a22f4734b4e9", "srcset": "https://si.imgix.net/7671b2ed/uploads/origins/671ec176-f032-401c-ab4c-0308ecef4b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9394be15ee74607f7be0a22f4734b4e9, https://si.imgix.net/7671b2ed/uploads/origins/671ec176-f032-401c-ab4c-0308ecef4b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53a11b53366d69f50af60eb2865fb167 2x, https://si.imgix.net/7671b2ed/uploads/origins/671ec176-f032-401c-ab4c-0308ecef4b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09b08e995f3a3c27b8fb729e5105ff85 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7671b2ed/uploads/origins/671ec176-f032-401c-ab4c-0308ecef4b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0df878902b64877cbb7c9c3f7c725177", "srcset": "https://si.imgix.net/7671b2ed/uploads/origins/671ec176-f032-401c-ab4c-0308ecef4b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0df878902b64877cbb7c9c3f7c725177, https://si.imgix.net/7671b2ed/uploads/or