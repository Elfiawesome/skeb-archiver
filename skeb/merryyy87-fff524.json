たピアノ教室で知り合い、友達になります。\n　家での扱いが悪く自信のないBが、お兄さんに辛く当たられ、発表会に出られないことにAが怒って、\n　ピアノの発表会でAが、Bの兄よりも良い成績を収めて、\n　自分はBのほうが上手だと思うと、Bを認めてくれて、BはAのことを心のよりどころとしています。\n\n　自分よりも姉重視で動くAに、怒るBですが、惚れた弱みでなんだかんだ一緒についていく感じです。", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@merryyy87/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2601472, "client_id": 908047, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9290762/uploads/origins/bb977f0f-8e19-44ac-a372-c9effe75a1ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c68f7da9c4391d5da195dff3fee2c40b", "srcset": "https://si.imgix.net/f9290762/uploads/origins/bb977f0f-8e19-44ac-a372-c9effe75a1ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c68f7da9c4391d5da195dff3fee2c40b, https://si.imgix.net/f9290762/uploads/origins/bb977f0f-8e19-44ac-a372-c9effe75a1ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afef6020547dd330641b729c791ebc48 2x, https://si.imgix.net/f9290762/uploads/origins/bb977f0f-8e19-44ac-a372-c9effe75a1ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92b44ba186d7cb742fd40ac51c697596 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9290762/uploads/origins/bb977f0f-8e19-44ac-a372-c9effe75a1ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=092026b0074819e7286be5592740a3cc", "srcset": "https://si.imgix.net/f9290762/uploads/origins/bb977f0f-8e19-44ac-a372-c9effe75a1ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=092026b0074819e7286be5592740a3cc, https://si.imgix.net/f9290762/uploads/origins/bb977f0f-8e19-44ac-a372-c9effe75a1ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a45d08c3b7a61d91f9dd43c9c65