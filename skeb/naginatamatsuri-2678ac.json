ad90154e038000, https://si.imgix.net/6c3a42f8/uploads/origins/bdfe91df-0410-48d7-9c0d-b6926e5d7c2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f52a35de35aee28c253687f140799ca2 2x, https://si.imgix.net/6c3a42f8/uploads/origins/bdfe91df-0410-48d7-9c0d-b6926e5d7c2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=192701e18dd82c9dbe8ae01aecbb77b7 3x"}, "body": "こんにちは、新しい依頼をしたいのですが。2枚の絵が欲しいのですが、それぞれ2人のキャラクターがいます。\n人間の商人と、露骨にセックスしていない2人の犬の女の子のダンサーが描かれています。\n\nこの絵の左の女の子と右の女の子を指しています。\nhttps://www.pixiv.net/en/artworks/102584312 (2枚目)\n\n彼らのポーズはこれと似たようなものです。\n(また、視点が少し違うものでもOKです。\n提案します。）\n\n- 左の女の子のポーズ。\nhttps://www.pixiv.net/en/artworks/64624592\n- 右の女の子のポーズ。\nhttps://www.pixiv.net/en/artworks/66945382\n\nこちらの画像はその前日譚になります。\nhttps://www.pixiv.net/en/artworks/102584312 (3枚目)\n\n相変わらず女の子はアヘ顔でしょうね。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@naginatamatsuri/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1331565, "client_id": 100343, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24a6eaf3/uploads/origins/9a9933b7-fe7d-49c8-aed1-295f7cb2d437?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc6be7f211df825ea41db38aaa33cbda", "srcset": "https://si.imgix.net/24a6eaf3/uploads/origins/9a9933b7-fe7d-49c8-aed1-295f7cb2d437?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc6be7f211df825ea41db38aaa33cbda, https://si.imgix.net/24a6eaf3/uploads/origins/9a9933b7-fe7d-49c8-aed1-295f7cb2d437?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9afea73768a104080f0f6b64fa335b2d 2x, https://si.imgix.net/24a6eaf3/uploads/origins/9a9933b7-fe7d-49c8-aed1-295f7cb2d437?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=869b488beffad6e784d52ab1dbe5ca58 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24a6eaf3/uploads/origins/9a9933b7-fe7d-49c8-aed1-295f7cb2d437?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=464db9232d4f2b86563ecc88cb660aee", "srcset": "https://si.imgix.net/24a6eaf3/uploads/origins/9a9933b7-fe7d-49c8-aed1-295f7cb2d437?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=464db9232d4f2b86563ecc88cb660aee, https://si.imgix.net/24a6eaf3/uploads/origins/9a9933b7-fe7d-49c8-aed1-295f7cb2d437?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9bdb4f1175f4601735461fee94c18b1a 2x, https://si.imgix.net/24a6eaf3/uploads/origins/9a9933b7-fe7d-49c8-aed1-295f7cb2d437?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0460029c0d704def1d7e593a0dca48c0 3x"}, "body": "祭野さん、こんにちは❗\n前回に引き続きまたリクエストをお願いします。\n今回も異世界マママヨ転移の続きをお願いしたいです。内容としましては、マママヨの中で徹くんと3ママの魔妖力で出来たマヨネーズプールの中で絡み合うようにいちゃラブSEXをしています。(魅沙ママはキス、由子ママは乳首舐め、奈緒ママはフェラチオをしてます。)\n\nすると、そこにマママヨの女神が現れ魔法でママ達をドロドロのマヨネーズに変えてしまいます。3人はマママヨの一部にされてしまい徹くんは女神に押し倒され騎乗位でイカされます。そのまま徹くんもマママヨの一部に変えられそうになりますがそこにマヨネーズの津波が発生し女神を徹くんから離れさせます。すると女神を捕らえたマヨネーズが乳首、おマンコ、アナルを犯しはじめます。女神はイキまくり魔妖力を吸収され、自身もマヨネーズに吸収されます。すると3人の人型が形成されます。それは3ママで徹くんを守りたいという強い気持ちでマヨネーズの津波になり女神を倒したとの事でした。3人の体は女神を吸収していて妊婦の様にお腹が脹れています。すると、3人のおマンコからマヨネーズが大量に流れ出ます。するとそのマヨネーズもゆっくりと人型になります。里美さんがマヨネーズになって再開をする。\n\nと、こんな感じのシチュエーションをお願いします🙇⤵️\n\n3人は完全にマヨネーズ化したので髪もマヨネーズ色でお願いします。女神様の姿は豊満ぽっちゃりで全身マヨネーズ色でお願いします。セリフもお願いします。\n\n冒頭のイチャラブセックスhttps://www.pixiv.net/artworks/28754742\n\n女神\n https://www.pixiv.net/artworks/15156765\n\nマヨ津波\n https://www.pixiv.net/artworks/18269511\n\nマヨネーズに犯される女神\n https://www.pixiv.net/artworks/103119466\n\n以上になります。今回も長くなりましたがお願いします🙇⤵️", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@naginatamatsuri/works/16", "private_thumbnail_image_urls": null, "private": fals