を描いてほしいです。\n\n服装\n野良着の色、模様は適当に、もんぺは袴式、色、模様は濃い紫系の縞、\n足袋は赤、足袋底は白にしてほしいです。\nもんぺの形は足首のところがすぼまった形にしてほしいです。\nもんぺ形イメージ\nhttps://www.dropbox.com/s/w3e89kuwhc65j6z/yukim.jpg?dl=0\nもんぺ模様イメージ\nhttps://www.dropbox.com/s/4099722scfwegff/sima.jpg?dl=0\n\n差分で、\n股間部分を、破られ、陰部に極太ディルドが挿入されて\n表情も苦しそうに目を閉じて泣き叫んでる状態もお願いします。\n\nつたない説明で恐縮ですが、説明不足な点、ポーズ、構図など\nアレンジしていただいて構いませんが、\n必ず、もんぺが破れていない状態と、破れた状態の2種を描いていただきたいです。\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/s/1uef5ttk8rbx1ho/k.png?dl=0", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@naginatamatsuri/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d826432f/uploads/origins/038d69a5-39b4-4fc1-a906-cdbb2c0ca7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e29a9744f38d1c6e0299c5ca5b0957d", "srcset": "https://si.imgix.net/d826432f/uploads/origins/038d69a5-39b4-4fc1-a906-cdbb2c0ca7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e29a9744f38d1c6e0299c5ca5b0957d, https://si.imgix.net/d826432f/uploads/origins/038d69a5-39b4-4fc1-a906-cdbb2c0ca7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=addec1213ca5817cea3483eed03cdcd2 2x, https://si.imgix.net/d826432f/uploads/origins/038d69a5-39b4-4fc1-a906-cdbb2c0ca7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c1a073d4c4d9a91eddf330aacf34a11 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1331565, "client_id": 1931379, "nc": 179}, {"path": "/@naginatamatsuri/works/14", "private_thumbnail_image_urls": null, "priv