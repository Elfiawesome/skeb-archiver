r_acceptable_same_genre": false}, {"path": "/@tiger_rmn/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3847, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e0c01af/uploads/origins/fa0b1eef-2889-40e1-a4aa-1322f5f500b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b7cf9194e0a0375ae0dac723a32a3f2", "srcset": "https://si.imgix.net/4e0c01af/uploads/origins/fa0b1eef-2889-40e1-a4aa-1322f5f500b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b7cf9194e0a0375ae0dac723a32a3f2, https://si.imgix.net/4e0c01af/uploads/origins/fa0b1eef-2889-40e1-a4aa-1322f5f500b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b08e4502a873983b9153c5498e0abb0 2x, https://si.imgix.net/4e0c01af/uploads/origins/fa0b1eef-2889-40e1-a4aa-1322f5f500b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=969e460ec42befd98f2391a31c6232b0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e0c01af/uploads/origins/fa0b1eef-2889-40e1-a4aa-1322f5f500b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3c8f0d36a7ab64222d909bb5c0ebd5c", "srcset": "https://si.imgix.net/4e0c01af/uploads/origins/fa0b1eef-2889-40e1-a4aa-1322f5f500b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3c8f0d36a7ab64222d909bb5c0ebd5c, https://si.imgix.net/4e0c01af/uploads/origins/fa0b1eef-2889-40e1-a4aa-1322f5f500b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a829cb6953c779de8b8c64bfa1e306d8 2x, https://si.imgix.net/4e0c01af/uploads/origins/fa0b1eef-2889-40e1-a4aa-1322f5f500b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1cef7b23cd5d84e65cda0c46becf38de 3x"}, "body": "こんにちは！内容を変えてご依頼させて頂きます！\n単行本の『いい子はまたない』より「編妹×ユースフル」