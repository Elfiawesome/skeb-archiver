/uploads/origins/435516fa-ba29-4ad6-81fe-858428c238a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f60467e001eea2f9d2ff5f31d86b1050", "srcset": "https://si.imgix.net/c108f30f/uploads/origins/435516fa-ba29-4ad6-81fe-858428c238a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f60467e001eea2f9d2ff5f31d86b1050, https://si.imgix.net/c108f30f/uploads/origins/435516fa-ba29-4ad6-81fe-858428c238a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2234ab71a73070370e6c8c01b70f5ee 2x, https://si.imgix.net/c108f30f/uploads/origins/435516fa-ba29-4ad6-81fe-858428c238a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=073900e2772438c83006746b4eba1192 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c108f30f/uploads/origins/435516fa-ba29-4ad6-81fe-858428c238a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca4c53662f3f5c5c781e63fe88aca04f", "srcset": "https://si.imgix.net/c108f30f/uploads/origins/435516fa-ba29-4ad6-81fe-858428c238a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca4c53662f3f5c5c781e63fe88aca04f, https://si.imgix.net/c108f30f/uploads/origins/435516fa-ba29-4ad6-81fe-858428c238a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9fd1e1964575d034c1edb19df0d2efe6 2x, https://si.imgix.net/c108f30f/uploads/origins/435516fa-ba29-4ad6-81fe-858428c238a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c8721647723fc709c9bdade835e3b703 3x"}, "body": "Hello! I think that your work is simply amazing, and I love the detailed backgrounds and settings you create. I would like to request a drawing of my friend's character if possible. \n\nThe character is a young woman who is the protagonist of a made up horror game. In the game she fights monsters on the beach with her axe. Despite having to fight monsters and seeming moody, she is playful and likes to joke around when you get to know her better.\n\n> https://drive.google.com/drive/folders/1-uA5qdMslhFEhy9XS9y6-PCKRA5ZWDLN\n\nYou may draw her as you like, but I would like to ask that you draw her on the surface of the \"Strength\" tarot card. The card usually has the character with a lion, but would you be able to draw her with an oarfish instead?\n\nThank you very much for your consideration.", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naspibon_ox/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2693085, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f319361/uploads/origins/dd73fb54-f685-42bc-b293-b5bfc48f817c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5a72e41f25738eae46d7628fa698290", "srcset": "https://si.imgix.net/4f319361/uploads/origins/dd73fb54-f685-42bc-b293-b5bfc48f817c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5a72e41f25738eae46d7628fa698290, https://si.imgix.net/4f319361/uploads/origins/dd73fb54-f685-42bc-b293-b5bfc48f817c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed7cd44e62ebae8a02dce20be664dc54 2x, https://si.imgix.net/4f319361/uploads/origins/dd73fb54-f685-42bc-b293-b5bfc48f817c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d57699842f097c3017447ca7a8601abb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f319361/uploads/origins/dd73fb54-f685-42bc-b293-b5bfc48f817c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=441a857ad72c215e1248a55be67ba676", "srcset": "https://si.imgix.net/4f319361/uploads/origins/dd73fb54-f685-42bc-b293-b5bfc48f817c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=441a857ad72c215e1248a55be67ba676, https://si.imgix.net/4f319361/uploads/origins/dd73fb54-f685-42bc-b293-b5bfc48f817c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f97ad4b10af273c77df4932cbcbf3b14 2x, https://si.imgix.net/4f319361/uploads/origins/dd73fb54-f685-42bc-b293-b5bfc48f817c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=969af1b5f7acd11b10960d413940d8f3 3x"}, "body": "Dr. Nasubon, excuse me.\n\nI would like to ask you to draw an illustration of two of my favorite characters without text.\n*I would like to see a scene where they are wearing T-shirts and looking at each other with intimate eyes as if they are a couple.\nCharacter 1] is wearing a white T-shirt and [Character 2] is wearing a black T-shirt. The background depicts a sunrise and a city spread out below them (the scene is of the two sitting on a raised platform where they can enjoy the view).\nIf possible, please draw their faces clearly.\nPlease draw them as \"good-looking-oji\" type characters.\n\nIf not enough, please raise the price.\n\nSetting drawing of character 1:\nhttps://drive.google.com/drive/folders/1R9kuaX5LO0_XfCyg7O_AprgIYfnf0chM\n\nSetting diagram for character 2:\nhttps://drive.google.com/drive/folders/1SAKQ1ZBzru35FHLfy2aETQpyLLTRALqr\n\n▷⒈The two characters do not wear hats, glasses, goggles, or scarves. Please pay special attention to this point.\nThey do not look tired or exaggerated.\n\n\n▷⒉Character 1 has a tattoo on his left arm, please use the right part of this image as a reference for your drawing.\nmordeo.org/wallpapers/maverick-tom-clancys-rainbow-six-siege/\nPlease note that the tattoo resembles a map of Afghanistan.\n\n\n▷3. Character 2's hand is bandaged.\nCharacter 2's arm has a burn, so please draw that carefully.\n\n▷4. They are both mature in age, approximately 35 years old.\nNote that they are both the same height.\n\n▷5. Character 1's personality: intelligent, wise, a good listener, and pursues freedom while keeping his emotions to himself.\nCharacter 2's personality: kind, loyal, and patient.\n\nI am truly sorry for the complexity of my request.\nPlease forgive me.\nThank you for your consideration.\n\n▶Usage:\nPersonal viewing\nPersonal use: SNS icons and headers, PC wallpaper, etc.\n\nhttps://www.mordeo.org/wallpapers/maverick-tom-clancys-rainbow-six-siege/", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naspibon_ox/works/28", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/45a08e7b/uploads/origins/a8e2e940-5793-44b8-963b-44a9d2b8faae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a80ef39f920904162362eb94eef24060", "srcset": "https://si.imgix.net/45a08e7b/uploads/origins/a8e2e940-5793-44b8-963b-44a9d2b8faae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a80ef39f920904162362eb94eef24060, https://si.imgix.net/45a08e7b/uploads/origins/a8e2e940-5793-44b8-963b-44a9d2b8faae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c54d59202b8b8cbafda0279b4ccfdba4 2x, https://si.imgix.net/45a08e7b/uploads/origins/a8e2e940-5793-44b8-963b-44a9d2b8faae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8aad8e36c52a7372f4bd8577d2fde830 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2693085, "nc": 145}, {"path": "/@naspibon_ox/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2693085,