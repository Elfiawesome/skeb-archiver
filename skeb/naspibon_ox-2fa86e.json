?dl=0\n\nhttps://www.dropbox.com/scl/fo/aizoifp3p64e5fih5nt3l/AKkuHJiCXfegi_fb82d41x8?rlkey=2nx4i0xmm1sm1cokq05r5gg55&st=gb25o0it&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naspibon_ox/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2693085, "client_id": 2037992, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16d633de/uploads/origins/11a52f11-af03-4df3-acff-807df01855b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9de6224dfcbddc0369a992cc6b83e4ff", "srcset": "https://si.imgix.net/16d633de/uploads/origins/11a52f11-af03-4df3-acff-807df01855b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9de6224dfcbddc0369a992cc6b83e4ff, https://si.imgix.net/16d633de/uploads/origins/11a52f11-af03-4df3-acff-807df01855b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b47832a2757c6dc7a441861415d9bc1 2x, https://si.imgix.net/16d633de/uploads/origins/11a52f11-af03-4df3-acff-807df01855b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77aae32c9ae61bb582ef9a98ec0580fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/16d633de/uploads/origins/11a52f11-af03-4df3-acff-807df01855b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cbf80d9343508cc9183cb5c0db28fcb", "srcset": "https://si.imgix.net/16d633de/uploads/origins/11a52f11-af03-4df3-acff-807df01855b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cbf80d9343508cc9183cb5c0db28fcb, https://si.imgix.net/16d633de/uploads/origins/11a52f11-af03-4df3-acff-807df01855b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fc68fc0b454b876fc4a62702b57c2845 2x, https://si.imgix.net/16d633de/uploads/origins/11a52f11-af03-4df3-acff-807df01855b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f32f14d1b6840e6186d055a60fa12203 3x"}, "body": "Hello! I would like to request 2 of my OCs, please! \nhttps://pin.it/78pRHTDhH\nEric (white haired, demon) and Ryuu ( black haired, vampire).  \nI would like to see them having a nice, relaxing time in a bath! It can be their bathroom or a hot spring, Eric already in the water, relaxing and Ryuu is getting ready to climb in as well. \nEric has lots of scars scattered all over his body, he looks in his 40s, slightly bigger built than Ryuu. He would have a tired but relaxed look. \nRyuu has 1 crossed shaped scar on his chest that goes down to his stomach, looks in his 30s, more athletic, agile built. Has a feather shaped earring in his left ear and a necklace. Pointy ears, slit pupils, long black claws on his hands. \nI just want them to have a chill evening, calm atmoshpere. Its set in the modern era, an urban fantasy.\nPlease accept my request!\n\nhttps://pin.it/ktGULXMX9", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naspibon_ox/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3c4bfc7e/uploads/origins/bc00d4c4-8657-4a88-a3a9-68073f585c4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7eeb319ed4004010c3f56628458797a8", "srcset": "https://si.imgix.net/3c4bfc7e/uploads/origins/bc00d4c4-8657-4a88-a3a9-68073f585c4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7eeb319ed4004010c3f56628458797a8, https://si.imgix.net/3c4bfc7e/uploads/origins/bc00d4c4-8657-4a88-a3a9-68073f585c4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=605dd2acf9c8d1ee5eada3f6d1515ea3 2x, https://si.imgix.net/3c4bfc7e/uploads/origins/bc00d4c4-8657-4a88-a3a9-68073f585c4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7e0920b1b3d1fdb376ee537b6ba930e 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2693085, "nc": 145}, {"path": "/@naspibon_ox/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2693085, "client_id": 448306, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e498200c/uploads/origins/ef179fc4-b534-4ba8-8559-0c445b95f2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ef8373fb66600dfa74678323a3d83b6", "srcset": "https://si.imgix.net/e498200c/uploads/origins/ef179fc4-b534-4ba8-8559-0c445b95f2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ef8373fb66600dfa74678323a3d83b6, https://si.imgix.net/e498200c/uploads/origins/ef179fc4-b534-4ba8-8559-0c445b95f2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fdc312e22bc95fc57b9c49302176d32 2x, https://si.imgix.net/e498200c/uploads/origins/ef179fc4-b534-4ba8-8559-0c445b95f2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5aa57c698600fc4573d81395ec78212 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e498200c/uploads/origins/ef179fc4-b534-4ba8-8559-0c445b95f2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5dd8cf65988ef155f03142d4c7a9260", "srcset": "https://si.imgix.net/e498200c/uploads/origins/ef179fc4-b534-4ba8-8559-0c445b95f2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5dd8cf65988ef155f03142d4c7a9260, https://si.imgix.net/e498200c/uploads/origins/ef179fc4-b534-4ba8-8559-0c445b95f2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8154c892fde182c7962c4880b480d458 2x, https://si.imgix.net/e498200c/uploads/origins/ef179fc4-b534-4ba8-8559-0c445b95f2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6db3b80b4fc2ebdebda34044e7e4a443 3x"}, "body": "Hello!\n\nI really like your art and how you draw handsome men, so I would like to make a request, if possible. \n\nCould you draw Reinhardt from Fire Emblem wearing a casual suit and tie? The outfit is the same one drawn by Momo Jirushi for the FEH anniversary. It's the one on the left side of the outfit reference image.\n\nFor the pose, he should be relaxed and comfortable, as if he's posing for a photoshoot. \n\nIf possible, there should be a red lipstick mark on his face, similar to this - https://cdn.imgchest.com/files/ye3c2xvj9v4.jpg\n\nCharacter references - https://imgchest.com/p/bp45xpmng75\n(Note: Reinhardt's hair may look brown, but it's actually black or very dark navy blue)\n\nOutfit references - https://imgchest.com/p/a846prvo27x\n(Left side of image)\n\nI'll leave the other details up to Teacher.\n\nFor helpful references and inspirations, here are some commissions I've requested in the past:\nhttps://imgchest.com/p/6eyr2p5kx7p", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naspibon_ox/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2693085, "client_id": 18708, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67c3c74f/uploads/origins/f0f598f5-19ed-4c41-902f-f3f964891e92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cd4a95ef76e8110e140e69fe440eee8", "srcset": "https://si.imgix.net/67c3c74f/uploads/origins/f0f598f5-19ed-4c41-902f-f3f964891e92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cd4a95ef76e8110e140e69fe440eee8, https://si.imgix.net/67c3c74f/uploads/origins/f0f598f5-19ed-4c41-902f-f3f964891e92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25dcbc7529c7af5be51eeed70bdeae0e 2x, https://si.imgix.net/67c3c74f/uploads/origins/f0f598f5-19ed-4c41-902f-f3f964891e92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=089e436d7b0d24ed2a8925b466e21b8a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67c3c74f/uploads/origins/f0f598f5-19ed-4c41-902f-f3f964891e92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6404ae205d86065242dcad837bb7623a", "srcset": "https://si.imgix.net/67c3c74f/uploads/origins/f0f598f5-19ed-4c41-902f-f3f964891e92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6404ae205d86065242dcad837bb7623a, https://si.imgix.net/67c3c74f/uploads/origins/f0f598f5-19ed-4c41-902f-f3f964891e92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=14fe22511117bc1f4bfa29cb51935a18 2x, https://si.imgix.net/67c3c74f/uploads/origins/f0f598f5-19ed-4c41-902f-f3f964891e92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d17fda8fed9489bd9b9c2c2dd9455a28 3x"}, "body": "こんにちは。\n\n私の2人のOCのアートをお願いしたいのですが。\n\nhttps://drive.google.com/drive/folders/1o5wVZm2_d96skaWohudJzxVatK2kXtGI\nhttps://drive.google.com/drive/folders/1LUJ26pW96iTvWvY3kWxSPn5rqCq_vNWi\n\nDIAはメロディより少し背が高い。怠け者だけど、いざというときは頼りになるかっこいいお姉さんという雰囲気。彼女は思慮深く、行動を起こす前に綿密な計画を立てることを好む。DIAはハンドガンと、爪や大砲などの武器に変形できる腕を使って戦います。趣味は探偵小説。彼女は甘いペストリーとブラックコーヒーが好きだ。ふっくらとした大きな胸と柔らかそうな体。\n\nMelodyはちょっとおてんば娘。とても自信家で、どんな状況にもすぐに適応できる。とても頼りになるが、気が短い。Melodyが使うのは、大きなレンチと剣、そして体力だ。彼女は他の道具や即席の武器も適当に使う。趣味は特撮番組と漫画。辛い食べ物と甘いコーヒーが好きだ。控えめなバスト、むっちりとした太もも、ぷりっとしたキュートなお尻を持つMelody。引き締まったボディの持ち主だ。\n\n先生の呪術廻戦のファンアートは本当にいい！カジュアルな雰囲気が素晴らしい。レストランでの食事やバスの待ち時間など、日常的なシチュエーションで娘たちを見てみたい。\n\nご自由に描いてください。先生にとってかっこいいシーンであればうれしいです。\n\nご検討よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naspibon_ox/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2693085, "client_id": 1475518, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d841392/uploads/origins/f4f37328-7120-4a44-861f-7c6c4a9745da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a926443ca865967435a32bce6379be09", "srcset": "https://si.imgix.net/4d841392/uploads/origins/f4f37328-7120-4a44-861f-7c6c4a9745da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a926443ca865967435a32bce6379be09, https://si.imgix.net/4d841392/uploads/origins/f4f37328-7120-4a44-861f-7c6c4a9745da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f082d847e2f9f14530459d1c01d1990 2x, https://si.imgix.net/4d841392/uploads/origins/f4f37328-7120-4a44-861f-7c6c4a9745da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e159bfa856ec1608e68ee2fc2d589f0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d841392/uploads/origins/f4f37328-7120-4a44-861f-7c6c4a9745da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f423c7f45cc517c2313bf04491afaaa3", "srcset": "https://si.imgix.net/4d841392/uploads/origins/f4f37328-7120-4a44-861f-7c6c4a9745da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f423c7f45cc517c2313bf04491afaaa3, https://si.imgix.net/4d841392/uploads/origins/f4f37328-7120-4a44-861f-7c6c4a9745da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f118a219039b9d32c3629a7700568474 2x, https://si.imgix.net/4d841392/uploads/origins/f4f37328-7120-4a44-861f-7c6c4a9745da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1a556de18b27f92b7957a7e722f61653 3x"}, "body": "Hello again! Hope you've been well!\nI still adore the pieces you did for me previously, and so I would like to make yet another request. If at all possible, I’d love to see both of my characters drawn together.\nBenjamin (B): Brown hair and dark green eyes. 186 cm. Lean and athletic build. He is an outgoing, clever and reckless vampire who hasn’t been a vampire for long. \nAlexander (A): Black hair and dark brown eyes. 190 cm. Lean and athletic build. He is a charismatic, mischievous and confident vampire who can also be ruthless. His eyes turn red when he is hunting or fighting.\n\nB and A are part of the same group of vampires. While they've become fairly good friends and A is the only one in the group B trusts, sometimes stress and resentment leads to them fighting. \nIf possible, I’d like to see an illustration of them engaged in a fight. Blood is okay. Feel free to draw them however you like, I will leave poses and composition to you!\n\nThank you so much for your consideration!\n\nhttps://drive.google.com/drive/folders/1Tdq-7DSjjZomByVT3bOJSb6Ts0Q87g4x?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naspibon_ox/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2693085, "client_id": 582670, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/79521b1d/uploads/origins/c9e68a12-1f97-45eb-b711-24407afe9378?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5150b9920a972b66030724952e27fe2c", "srcset": "https://si.imgix.net/79521b1d/uploads/origins/c9e68a12-1f97-45eb-b711-24407afe9378?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5150b9920a972b66030724952e27fe2c, https://si.imgix.net/79521b1d/uploads/origins/c9e68a12-1f97-45eb-b711-24407afe9378?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d5e7a16293607fc031ee039dc33fde0 2x, https://si.imgix.net/79521b1d/uploads/origins/c9e68a12-1f97-45eb-b711-24407afe9378?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c0949c494bf3d78886e538a0ef38f47 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/79521b1d/uploads/origins/c9e68a12-1f97-45eb-b711-24407afe9378?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81556c12133d0c7024b59c3d1a0abf29", "srcset": "https://si.imgix.net/79521b1d/uploads/origins/c9e68a12-1f97-45eb-b711-24407afe9378?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81556c12133d0c7024b59c3d1a0abf29, https://si.imgix.net/79521b1d/uploads/origins/c9e68a12-1f97-45eb-b711-24407afe9378?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9002e947fac89db8d07605efa51c8d3b 2x, https://si.imgix.net/79521b1d/uploads/origins/c9e68a12-1f97-45eb-b711-24407afe9378?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bcd973ffdabfdd3e460cf5b839b64a55 3x"}, "body": "hello!! i absolutely love your artwork, i hope you would be willing to draw my oc!\nhttps://drive.google.com/drive/u/0/folders/1opFY7crt6dXTkeBhREj0LDEj_8gk4MLa\n\nLukkas is a muscular man with darker skin, scars all over his body (but most importantly on his face), a tattoo on his arm and neck, has black hair and golden eyes. He is about 180cm tall. he is a very easy-going kind of man, but strong and confident, often with a smirk on his face. He is an adept warrior, that more often fights with just his fists and is skilled in martial arts. Despite this, he holds a lot of wonder and love for the world, and likes to immerse himself and protect more beautiful things. \n\nNote that he can be drawn in any of the outfits I have shown, but I would like to leave any pose, expression and composition up to you!\n\nThank you very much for the opportunity :)\n\nhttps://drive.google.com/drive/u/0/folders/1opFY7crt6dXTkeBhREj0LDEj_8gk4MLa", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naspibon_ox/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2693085, "client_id": 3030955, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c3be5926/uploads/origins/466fc7e6-82f1-4b6c-9ae0-26616963837d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e53029ba0f2877924dcfeae86a35c652", "srcset": "https://si.imgix.net/c3be5926/uploads/origins/466fc7e6-82f1-4b6c-9ae0-26616963837d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e53029ba0f2877924dcfeae86a35c652, https://si.imgix.net/c3be5926/uploads/origins/466fc7e6-82f1-4b6c-9ae0-26616963837d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99e28ba3197d76eed88d6e0c220d10cc 2x, https://si.imgix.net/c3be5926/uploads/origins/466fc7e6-82f1-4b6c-9ae0-26616963837d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c378faf29458ccc23827f7f01cd39a3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c3be5926/uploads/origins/466fc7e6-82f1-4b6c-9ae0-26616963837d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fdf621b2370046de127773f22f52e70a", "srcset": "https://si.imgix.net/c3be5926/uploads/origins/466fc7e6-82f1-4b6c-9ae0-26616963837d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fdf621b2370046de127773f22f52e70a, https://si.imgix.net/c3be5926/uploads/origins/466fc7e6-82f1-4b6c-9ae0-26616963837d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5af906fcd21fd4caf5f3fc1a4d4f5ffc 2x, https://si.imgix.net/c3be5926/uploads/origins/466fc7e6-82f1-4b6c-9ae0-26616963837d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5dfa8507aca6e113d397306e10708a72 3x"}, "body": "Hello, I think your art is awesome and I would like to request some art as a gift for my friend. Can you please draw Momoshiki from the series Boruto? He is an arrogant, cruel, sadistic, handsome, and powerful alien who wants to crush humanity and become a god. His signature weapon is a Naginata made of red energy. I would like for him to look cool and menacing, as if about to attack. The battlefield should be barren but the time of day can be up to you.\n\nmomoshiki reference: https://imgur.com/a/oZrS7vj\nweapon: https://imgur.com/a/jIm7lDP\n\nSince this is a gift, could you put any text on a separate layer? I hope this request is acceptable and I am excited to see what you make.", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naspibon_ox/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2693085, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/422de39c/uploads/origins/cb74e4b5-877c-404d-a709-684c2f6c76c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8633d06eb3816d3802cf6c1d6400d9b9", "srcset": "https://si.imgix.net/422de39c/uploads/origins/cb74e4b5-877c-404d-a709-684c2f6c76c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8633d06eb3816d3802cf6c1d6400d9b9, https://si.imgix.net/422de39c/uploads/origins/cb74e4b5-877c-404d-a709-684c2f6c76c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22b0169db01438e13eb628958c54d333 2x, https://si.imgix.net/422de39c/uploads/origins/cb74e4b5-877c-404d-a709-684c2f6c76c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0d178f16b886a8e10235e02cce96922 3x"}, "dur