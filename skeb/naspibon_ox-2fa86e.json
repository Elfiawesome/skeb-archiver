=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a48238d731952326af27a0f71f22230d, https://si.imgix.net/789f2959/uploads/origins/f9aa1d47-23c0-49a6-b348-684ca4b7c25a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f5c891e2e4a4b75a1d0d2649efa4bcb 2x, https://si.imgix.net/789f2959/uploads/origins/f9aa1d47-23c0-49a6-b348-684ca4b7c25a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93c3b53ee0076b4f9d6bf3ca04d58173 3x"}, "body": "Hello! \nI hope it is okay to ask for another illustration of my assassin couple [Risotto Nero] and [Cappuccino].\nI am deeply in love with the two commissions you made for me and I am excited to ask for another one.\n\nI did change the hair style of [Cappuccino] a bit! It is a longer braid now. All the references are in the folder.\n\nFor this commission, I would be happy if you draw another passionate and intimate close moment of my couple. The location and setting is up to you, be it somewhere in Italy or privately somewhere closed of.\n\nI would be happy if you could keep their very large height difference in mind again. \n\nThank you so much for considering. I am truly in love with the works you did for me in the past.\n\nhttps://drive.google.com/drive/folders/1-A7BYIsRbqNhiC5wwOY5Vr7aJ__JFEfQ", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naspibon_ox/works/36", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2693085, "client_id": 1475518, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4c12da6/uploads/origins/022326fc-be5f-41d0-9f4b-2738f0e7f092?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc479a3457aa7a198dba26d48fe4cfd0", "srcset": "https://si.imgix.net/b4c12da6/uploads/origins/022326fc-be5f-41d0-9f4b-2738f0e7f092?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc479a3457aa7a198dba26d48fe4cfd0, https://si.imgix.net/b4c12da6/uploads/origins/022326fc-be5f-41d0-9f4b-2738f0e7f092?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa8cb7be066bb2720a0e8325a4e4c781 2x, https://si.imgix.net/b4c12da6/uploads/origins/022326fc-be5f-41d0-9f4b-2738f0e7f092?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d654f050f5618aae6a9e3113a63d65f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4c12da6/uploads/origins/022326fc-be5f-41d0-9f4b-2738f0e7f092?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3084486958bbb9eae9cbeed34bf3ce7", "srcset": "https://si.imgix.net/b4c12da6/uploads/origins/022326fc-be5f-41d0-9f4b-2738f0e7f092?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3084486958bbb9eae9cbeed34bf3ce7, https://si.imgix.net/b4c12da6/uploads/origins/022326fc-be5f-41d0-9f4b-2738f0e7f092?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c34e43d4aa47fd4736f66bf28318f8d 2x, https://si.imgix.net/b4c12da6/uploads/origins/022326fc-be5f-41d0-9f4b-2738f0e7f092?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1a7a84c2392cee1ad90d9a565f4b8984 3x"}, "body": "Hello! Hope you've been well!\nI still adore all the amazing illustrations you've done for me previously, so I would love to make yet another request. I would love to see you draw my character Benjamin again as I really enoy how you draw him.\nAs I've mentioned before, he’s an outgoing, clever, kind, defiant and kind of reckless guy. He's good at fighting his way out of trouble though and takes on every challenge with a determined grin. He's 186 cm tall. Lean and athletic build. He has dark green eyes and thick, dark brown hair. \nHe hasn't been a vampire for long and is trying to get used to this new lifestyle even if it isn't always easy. There are times when he struggles quite a lot with his bloodthirst and he also feels sorrow, anguish and resentment over losing the normal life he once had.\nIf possible, I would love to see something with a darker mood and atmosphere that captures his struggles with his bloodthirst or his weariness and anguish. \n\nThank you so much for considering!\n\nhttps://drive.google.com/drive/folders/1dKLArmsmF0Izq_uu2CjP8q5KkUpt2mz8?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naspibon_ox/works/35", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2693085, "client_id": 3644943, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0700ce87/uploads/origins/83232251-8927-48b3-bbba-65525c8e07f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9824002f63105d32839fe4ec6e398acc", "srcset": "https://si.imgix.net/0700ce87/uploads/origins/83232251-8927-48b3-bbba-65525c8e07f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9824002f63105d32839fe4ec6e398acc, https://si.imgix.net/0700ce87/uploads/origins/83232251-8927-48b3-bbba-65525c8e07f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1640a69aa8061e8bb120cc5a5f6ce599 2x, https://si.imgix.net/0700ce87/uploads/origins/83232251-8927-48b3-bbba-65525c8e07f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=caae8063e140bb2f55673d90860906af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0700ce87/uploads/origins/83232251-8927-48b3-bbba-65525c8e07f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95d17b15692dbc765874d2077cff58ef", "srcset": "https://si.imgix.net/0700ce87/uploads/origins/83232251-8927-48b3-bbba-65525c8e07f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95d17b15692dbc765874d2077cff58ef, https://si.imgix.net/0700ce87/uploads/origins/83232251-8927-48b3-bbba-65525c8e07f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a6305b0cb0be71c1facc18dc7ca95e5a 2x, https://si.imgix.net/0700ce87/uploads/origins/83232251-8927-48b3-bbba-65525c8e07f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95d3e19bf6852837d62ec20ed83af204 3x"}, "body": "Hello なすぼん-san \nThank you very much for reading my request.\nI admire your artwork very much.\nI especially love how you draw backgrounds and scenery.\n\nI would like to request an illustration of a romantic couple from\nジョジョの奇妙な冒険:\nmy original character, Vitella (子牛の肉), with Prosciutto (プロシュート)\n\n子牛の肉 is a 27-year-old Filipino woman, 150 cm tall.\nShe has a soft but strong body, with thick thighs and large glutes.\nShe has tan skin. Her skin tone is very important to her character.\nPlease do not lighten her skin tone.\nShe has two small moles near the lower right side of her lip.\nShe has a quiet and observant personality, with a subtle allure.\n\nプロシュート is a 30-year-old Italian man, 178 cm tall.\nHe has a slim body with defined muscles and wide shoulders.\nHe has a serious and intense presence, but he cares deeply.\n\nTheir personalities are different, but their relationship is mature, affectionate, and mysterious. \n\nI would love to see them enjoying a day in their country of residence, Italy. ^^\n\nhttps://drive.google.com/drive/folders/1XeUoLflAKYnAsJFnqglykv2RMJHxgZji", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naspibon_ox/works/34", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2693085, "client_id": 3308823, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1206d46b/uploads/origins/82f40384-eac6-487d-8d50-6f6c5b1ebd47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbb00b69488146ec9e1a0dd74534b2a8", "srcset": "https://si.imgix.net/1206d46b/uploads/origins/82f40384-eac6-487d-8d50-6f6c5b1ebd47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbb00b69488146ec9e1a0dd74534b2a8, https://si.imgix.net/1206d46b/uploads/origins/82f40384-eac6-487d-8d50-6f6c5b1ebd47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=398d4f2f14b0119cdff408ef6a47b2ed 2x, https://si.imgix.net/1206d46b/uploads/origins/82f40384-eac6-487d-8d50-6f6c5b1ebd47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5ec44341320213f03a254aefcfc135f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1206d46b/uploads/origins/82f40384-eac6-487d-8d50-6f6c5b1ebd47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7032761732c1d17af2e0832a63df787", "srcset": "https://si.imgix.net/1206d46b/uploads/origins/82f40384-eac6-487d-8d50-6f6c5b1ebd47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7032761732c1d17af2e0832a63df787, https://si.imgix.net/1206d46b/uploads/origins/82f40384-eac6-487d-8d50-6f6c5b1ebd47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=00d8fb827b72959dbac73ee5bb586b64 2x, https://si.imgix.net/1206d46b/uploads/origins/82f40384-eac6-487d-8d50-6f6c5b1ebd47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b4e2457617794224b1671e3ead14af02 3x"}, "body": "Hello! I’ve been admiring your work for a while now, and I really love your delicate and refined art style.\n\nI would like to kindly request an illustration of Hawks (from My Hero Academia), together with my male OC.\n\nIf it fits with your vision, I would be very happy if the piece could convey a sunrise or early morning atmosphere . I leave the specific scene, character outfits, and overall composition entirely to your artistic judgment. I fully trust your style and interpretation!\n\nPlease feel free to take creative liberty with the pose, expressions, and any other details based on the provided settings.\n\nThank you so much for your time and consideration!\n\nhttps://drive.google.com/drive/folders/1rWCRPM4S5cE0-yR-CKFaDb_UduN7Z4Qi", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naspibon_ox/works/33", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2693085, "client_id": 768278, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb70fe8d/uploads/origins/88f023b1-28aa-4640-9b46-31458580b6b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7785d142178ecd01c11840ce8df62333", "srcset": "https://si.imgix.net/fb70fe8d/uploads/origins/88f023b1-28aa-4640-9b46-31458580b6b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7785d142178ecd01c11840ce8df62333, https://si.imgix.net/fb70fe8d/uploads/origins/88f023b1-28aa-4640-9b46-31458580b6b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09e98ee44bc550c7db6f18f92fc7937e 2x, https://si.imgix.net/fb70fe8d/uploads/origins/88f023b1-28aa-4640-9b46-31458580b6b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a957d58a37c42d6c10425ab60bc378c2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb70fe8d/uploads/origins/88f023b1-28aa-4640-9b46-31458580b6b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d32293744f63ad2938efa2774f69da91", "srcset": "https://si.imgix.net/fb70fe8d/uploads/origins/88f023b1-28aa-4640-9b46-31458580b6b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d32293744f63ad2938efa2774f69da91, https://si.imgix.net/fb70fe8d/uploads/origins/88f023b1-28aa-4640-9b46-31458580b6b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a09f71605c00319c3e329a83140e6377 2x, https://si.imgix.net/fb70fe8d/uploads/origins/88f023b1-28aa-4640-9b46-31458580b6b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=66c443753d1af9e453b904af33e2538f 3x"}, "body": "I love your composition illustrations! I would love to request a work from you! \n\nLori, 🍰: 23 years old, 166 cm. Blonde hair on top, dark underneath. Beauty mark under left eye. Impish and a bit bratty, often misbehaving around 🍎. Can be a bit gloomy but masks it with a mischievous persona. Views herself as the moon. Cat coded.  Loves fashion, cute things, and bittersweet flavors. \nCaleb, 🍎: 26 years old, 188 cm. Always wears his necklace. Purple iris’s with orange hues on the bottom. Only cares about 🍰’s approval and often spoils her. Very dependable, often spoiling 🍰. Commonly viewed as the sun. Dog coded.  He likes to give Lori “control” of him when they’re together. Loves sour flavors, learning new skills, flying, and Lori. \n\nI would love for the work to be romantic and cozy. Maybe 🍎 teasing 🍰 while they are relaxing at home or 🍎 looking at 🍰 with adoration. Please have the background a warm home, maybe with blurred photos in the back. Thank you for considering🙇🏼‍♀️ 💝\n\nhttps://drive.google.com/drive/folders/1bla34aQ3LWWAj6rjtrOVMTDDWEwlLXYj", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naspibon_ox/works/32", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dd561e41/uploads/origins/f938ede4-d75e-4690-b574-871e7b8a3695?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2989691fba0c9cc3eda22b0b6d035ec", "srcset": "https://si.imgix.net/dd561e41/uploads/origins/f938e