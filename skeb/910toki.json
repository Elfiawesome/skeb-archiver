fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=97d9928a14eecfbabc7bd337888f3a9e 2x, https://si.imgix.net/e4b3fb24/uploads/origins/11736563-113d-4bc2-bcfa-a3c7f6b95997?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ef0a970ffde5c77f09194b1aa233214 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2898876, "client_id": 3784685, "nc": 128}, {"path": "/@910toki/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2898876, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/77df63ac/uploads/origins/cfcc9d3b-7bc6-4510-842c-a20fe371dbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=034541b1fcaea2f026e9ac1fd774129b", "srcset": "https://si.imgix.net/77df63ac/uploads/origins/cfcc9d3b-7bc6-4510-842c-a20fe371dbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=034541b1fcaea2f026e9ac1fd774129b, https://si.imgix.net/77df63ac/uploads/origins/cfcc9d3b-7bc6-4510-842c-a20fe371dbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7e00e7f021ba17c7402fb49b6cd672f 2x, https://si.imgix.net/77df63ac/uploads/origins/cfcc9d3b-7bc6-4510-842c-a20fe371dbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4713c2ed964a9f4179082b1f17dbd89 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/77df63ac/uploads/origins/cfcc9d3b-7bc6-4510-842c-a20fe371dbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5245ed3fd2f7f80ac22e24d7d1c6ba5", "srcset": "https://si.imgix.net/77df63ac/uploads/origins/cfcc9d3b-7bc6-4510-842c-a20fe371dbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5245ed3fd2f7f80ac22e24d7d1c6ba5, https://si.imgix.net/77df63ac/uploads/origins/cfcc9d3b-7bc6-4510-842c-a20fe371dbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b6c297134537a04fe1d6028afd17f2f8 2x, https://si.imgix.net/77df63ac/uploads/origins/cfcc9d3b-7bc6-4510-842c-a20fe371dbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a0114c4e06181131b8a9c2cb4fc89769 3x"}, "body": "私の物語に登場するオリジナルキャラを「邪悪な」お嬢様として描いていただけますか？\n\n私のオリジナルキャラは普段こんな感じです。\n\nhttps://www.deviantart.com/stash/01y597ac294p\n\nしかし物語の後半で、彼女は敵国に捕らえられ、洗脳されて政府に仕えるようになります。洗脳された後、彼女は少しお嬢様風の美的感覚を持つようになります。長くストレートな髪はお嬢様風の巻き毛にカールします。洗脳状態を維持するために、彼女は首からアメジストのペンダントを下げています。しかし、彼女を操るには大量の魔力が必要で、その魔力が溢れ出して彼女の体に影響を及ぼし始めます。そのため、彼女の目の色は紫色に変わり、顔と体全体に紫色の模様が浮かび上がります。彼女は現代を舞台にした物語の登場人物です。\n\nお嬢様だとこんな感じです：\n\nhttps://www.deviantart.com/stash/02ckhdnby0b1\n\nhttps://www.deviantart.com/stash/2bfro0ufghs\n\n衣装デザインをアップデートしたいので、代わりにこちらの衣装で描いていただけますか：\n\nhttps://www.deviantart.com/stash/0280uh6zjzdn\n\n敵国の政府に所属し、統治手続きを執行するためだけに存在した高官です。彼女は生涯を、手続きが可能な限り効率的かつ迅速に実行されるよう、無批判に監視することに費やしています。\n\n身長は172cm（メリージェーンズを履いている身長を加えると176cm）。細身で胸は小さく、年齢は18歳です。髪は膝まであります。彼女はセンターパートだが、一本の髪が額に垂れている。\n\nセミリムレス眼鏡をかけ、左手にはアメジストの指輪、首には洗脳を維持するために使われる大きなアメジストのペンダントを着けている。フォーマルなドレスを着て、白いタイツと厚底のメリージェーンを履いている。フリルのヘッドバンドをしている。\n\nまた、異常に鋭い犬歯を持っている。\n\n彼女は非常に有能で、知的で、魔法の力も非常に強い。洗脳された後、彼女は自分の役割は敵国に全力で仕えることだと信じている。これは、敵国の望みを可能な限り効率的に実現することを意味する。しかし、マインドコントロールはヒューリスティックを植え付けるものであり、人々を完全に空虚な操り人形に変えることはできない。そこで彼女は、自分を洗脳した者たちと入れ替わり、敵国の権力の中枢になろうと企んでいる。なぜなら、彼女は自分が敵国を統治するのに最も効率的な人物だと考えているからだ。\n\n元々彼女は物理魔法と影魔法を使って戦っていたが、マインドコントロールされた後は影の棘と蔓を使って敵を拘束し、効率的に武装解除や無力化を行っている。", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@910toki/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2898876, "client_id": 3675815, "vtt_url": null, "thumbnail_image_urls": {"src": "ht