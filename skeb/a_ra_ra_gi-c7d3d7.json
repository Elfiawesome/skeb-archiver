fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c5fe7180c2ec1d1bd7b6a14391ec77b, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1866107826688724992%2FgcVPXKuT.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1904f92696d31d95f3cf33145d9861f 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1866107826688724992%2FgcVPXKuT.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f8012bb8b758f6fc166cb516d1bb46c 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/73e3b831-9aa7-4c3e-982c-964911a81720?response-content-disposition=inline&Expires=1774613222&Signature=Ug4EfiP3jjmhT2BvKWbZsEpLH8TDkfO9h4sGYDsGbD0Y7ppFyYLc16he9Bfsg-31kiCZMt01XkTY8l3pZZQLSoDgFrawXg2KWhPtMx6Vwl5hWTIT3CEdHrsIt0PJd1rerI3dYYT8nrqiXpwZuAaF73U3Ig00SQ3vOH0CsHO0qKSkb7xmbPq1Ppq8LXq1p2N-A3qmoBVWwcS4wDKPtIZR1NXTEXrhOLvU8pMurJCwKSKj2rkISsm-3S3pZDgbzZzQRaXwgBAbh6ZWOK9JmlB9-C0uDrhdOgjpF8A50CF-o7nWIw3H9wi-hS~M5Ru9eOp~swpAgQIqSlTW-wx7gqK85Q__&Key-Pair-Id=K1GS3H53SEO647", "duration": 184, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1866107826688724992%2FgcVPXKuT.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35297cc0e73169a4c46a9174b79c0177", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1866107826688724992%2FgcVPXKuT.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35297cc0e73169a4c46a9174b79c0177, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1866107826688724992%2FgcVPXKuT.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8720c325272c749b971595ddeea28a58 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1866107826688724992%2FgcVPXKuT.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=31e28e001f5f645e633dbc6daec7b8d8 3x"}, "body": "初めまして、リクエスト失礼します。\n\nサウンドクラウドやニコニコ動画の過去作品を拝見・拝聴させていただき、是非かち割り氷 (K-Ice)様に曲をお願いしたいと思いリクエストさせていただきました。\n内容が特殊なだけに難しいかもしれませんが、ご検討いただけましたら幸いです。\n\n\n◇リクエスト内容\n\n自作のフリーゲームの世界観のイメージで曲を作っていただきたいです。\n宇宙関連の研究員が宇宙人に寄生されて身体を乗っ取られて全てを失ってしまう描写のあるホラーゲームです。\n\n参考用（ゲームのスクリーンショット）\nhttps://twitter.com/a_ra_ra_gi/status/1582324341403881472\n\n\n◇キーワード\n宇宙研究所、寄生生物、隕石、蛸（触手、クトゥルフ）、カオス、喪失、UFO\n\n音楽は聴く専門のため上手く説明が出来なくて申し訳ないのですが、\nピコピコ電子音や、高熱の時に頭の奥で響くような、水中のスピーカーで聴くような音の入った、いくつもの音が重なって不思議な雰囲気なのに割とノリノリイケイケカオスな曲をイメージしています。\n\n具体的に言うとXX界隈曲のような雰囲気です。\n\n参考用・特に雰囲気がイメージに近いもの\nhttps://www.youtube.com/watch?v=rL88w2uHlqs\nhttps://www.youtube.com/watch?v=jJhm9iDR9HA\nhttps://www.youtube.com/watch?v=FzYyDPS4cEU\n\n雰囲気の説明のため例を挙げましたが、制作していただく曲に合成音声含むボーカルは不要です。また、ループ仕様等も必要ありません。\n\n\n◇使用用途\n\n主に個人的観賞用の予定です。\nまたはフリーゲームの追加シナリオや、その宣伝動画を作る際に使用するかもしれません（その際はお名前を明記させていただきます）\n※ゲームの有料化やBGM単体の販売などの商用的な利用はしません。\n\nよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "similar_creators": []}, "price_history": {"art": [{"amount": 3000, "recorded_at": "2026-03-20T12:06:05.670594+00:00"}]}}