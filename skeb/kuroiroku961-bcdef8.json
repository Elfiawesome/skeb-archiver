xlV1ma21_4qWoi_NuejiMpvDaX4Yv/view?usp=drivesdk\n\nダックスとトイプーのミックス犬(♂)です。\n全体的に茶なのですが顔周辺と首元、また背中から尻尾の先にかけて黒いです。\nうさぎさんとインコさんのイラストが可愛かったので、可能でしたらうちの子も四つ足を投げて落ちている(寝ている)イラストを入れていただけましたら嬉しいです。\n\n大変お手数をお掛けしますが、描いていただける際はリンク先をご確認下さいますと幸いです。\n\nどうぞよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuroiroku961/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4007633, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0eadcf67/uploads/origins/dd6858de-bb12-4550-8f35-d61ea2ed299f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e75eaca1a9e193d985cbf192a5d97fcc", "srcset": "https://si.imgix.net/0eadcf67/uploads/origins/dd6858de-bb12-4550-8f35-d61ea2ed299f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e75eaca1a9e193d985cbf192a5d97fcc, https://si.imgix.net/0eadcf67/uploads/origins/dd6858de-bb12-4550-8f35-d61ea2ed299f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5c955d549101a6c57deedc4dec94784 2x, https://si.imgix.net/0eadcf67/uploads/origins/dd6858de-bb12-4550-8f35-d61ea2ed299f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48d9881b08830ce867fe2aba0ab23cc8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0eadcf67/uploads/origins/dd6858de-bb12-4550-8f35-d61ea2ed299f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cec69a5f3e79243a099714f9cdc3047", "srcset": "https://si.imgix.net/0eadcf67/uploads/origins/dd6858de-bb12-4550-8f35-d61ea2ed299f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cec69a5f3e79243a099714f9cdc3047, https://si.imgix.net/0eadcf67/uploads/origins/dd6858de-bb12-4550-8f35-d61ea2ed299f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&