imgix.net/bf98d0a0/uploads/origins/4b0e3dba-3c54-47e7-9ad4-738029bb3412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b3f07fd5eb5ce4febb76a3b15e3342e 2x, https://si.imgix.net/bf98d0a0/uploads/origins/4b0e3dba-3c54-47e7-9ad4-738029bb3412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b84ed44ba40fec67e234d525b28c46a0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf98d0a0/uploads/origins/4b0e3dba-3c54-47e7-9ad4-738029bb3412?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22049aecb9d493606f03687d319d0487", "srcset": "https://si.imgix.net/bf98d0a0/uploads/origins/4b0e3dba-3c54-47e7-9ad4-738029bb3412?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22049aecb9d493606f03687d319d0487, https://si.imgix.net/bf98d0a0/uploads/origins/4b0e3dba-3c54-47e7-9ad4-738029bb3412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa34db8721151544a7208f2c8c2f0d0b 2x, https://si.imgix.net/bf98d0a0/uploads/origins/4b0e3dba-3c54-47e7-9ad4-738029bb3412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=91311dbbbe257dedfec78556fb355556 3x"}, "body": "イチビキ先生こんにちは。うちの子触手凌辱絵を描いて頂きたくリクエストを送らせていただきました\n\n触手に拘束され、触手の苗床として幼体を何度も出産する孕み袋にされてしまうシチュエーションで描いて頂きたいです\n催淫性の強い触手の体液を注がれ発情状態にさせられ続け、子宮がパンパンになる程に触手の精を注がれてしまう…といった感じにしていただけると嬉しいです。\n・触手の表面はイボや凹凸が沢山あり抽挿により強烈な快楽を発生させる形状\n・アソコは他の触手によってくぱぁされている\n・快楽に耐え切れず流されて蕩けてしまった表情でお願いします\n・拘束状態は両手両足が動かせない状態であれば大丈夫です。M字開脚のようなポーズが良いです\n・服装はブーツだけ残してもらえば他は残骸が残っている程度で大丈夫です。胸の模様は面倒であれば触手等で隠してしまっても大丈夫です\n・可能であれば断面図をお願いします\n以下資料となります\nhttps://drive.google.com/drive/folders/1xtQDTdwxO2abZrX_UduvOfyxpZuY4D4x?usp=sharing\nご検討の程、宜しくお願い致します", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ichibikiill/works/5", "private_thumbnail_image_urls": null, "