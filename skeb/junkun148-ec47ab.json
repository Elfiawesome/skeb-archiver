e9e6e42f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d399f042ffee541ce3d5af16bcd77f9b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d52a9e23/uploads/origins/60005d06-5bca-4374-b145-61ace9e6e42f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18ae802aab7d944b010d77bab776a8d9", "srcset": "https://si.imgix.net/d52a9e23/uploads/origins/60005d06-5bca-4374-b145-61ace9e6e42f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18ae802aab7d944b010d77bab776a8d9, https://si.imgix.net/d52a9e23/uploads/origins/60005d06-5bca-4374-b145-61ace9e6e42f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d24818f6398dbbc342b977bc76923b53 2x, https://si.imgix.net/d52a9e23/uploads/origins/60005d06-5bca-4374-b145-61ace9e6e42f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1733ba15f63d952da712cfeac7686a4f 3x"}, "body": "初めまして！\nskeb慣れておらず、一度キャンセルしました。申し訳ございません。\nTwitterで素晴らしいイラストを拝見しましたので、ぜひリクエストさせていただきたく。\n\n・キャラクター\nシンデレラガールズの水木聖來\nミリオンライブの桜守歌織\n\n・衣装\n水木聖來は【ブレイクワン・モーメント】の特訓後\n桜守歌織は【音楽で紡ぎ出す世界】の覚醒後でお願いします。\nどちらも1枚目のSSRです。\n\n・ポーズ\n聖來はアクティブに、歌織は優雅に2人並び立ってユニット感があると嬉しいです。(抽象的)ですいません。\n\n2人は23歳組でそれぞれ得意なものがダンスと歌ということで、ずっとユニットを夢見ています。\nまた、完成後はアイコンにも使用させていただければ嬉しいです。\nぜひ、よろしくお願いします。\n\n資料\nhttps://imasml-theater-wiki.gamerch.com/桜守歌織#content_2_12\n\nhttps://imascg-slstage.boom-app.wiki/entry/card-700", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@junkun148/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 474634, "client_id": 12062, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a61507c/uploads/origins/ffb78473-7a58-46d4-a2ed-a9cf1e453283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=718a5efd522498f8f867420c9004a5d5", "srcset": "https://si.imgix.net/8a61507c/uploads/origins/ffb78473-7a58-46d4-a2ed-a9cf1e453283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=718a5efd522498f8f867420c9004a5d5, https://si.imgix.net/8a61507c/uploads/origins/ffb78473-7a58-46d4-a2ed-a9cf1e453283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40d4fac9a995ad30638a07609eae7696 2x, https://si.imgix.net/8a61507c/uploads/origins/ffb78473-7a58-46d4-a2ed-a9cf1e453283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d90f721a62be8e1a540a8cc92e838fef 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a61507c/uploads/origins/ffb78473-7a58-46d4-a2ed-a9cf1e453283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ee225a16bdfbd5a25ea5fb561ff35a7", "srcset": "https://si.imgix.net/8a61507c/uploads/origins/ffb78473-7a58-46d4-a2ed-a9cf1e453283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ee225a16bdfbd5a25ea5fb561ff35a7, https://si.imgix.net/8a61507c/uploads/origins/ffb78473-7a58-46d4-a2ed-a9cf1e453283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ec7b3002868f99cbc1efde8d6c313af 2x, https://si.imgix.net/8a61507c/uploads/origins/ffb78473-7a58-46d4-a2ed-a9cf1e453283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=57db134ce8f1ce01f153c9b8a77f9420 3x"}, "body": "こにんちは！また英雄伝説閃の軌跡のゲームのキャラをリクエストさせてください！\nミュゼ・イーグレットというキャラをお願い致します。\n\nミュゼは参考資料1に示すキャラで、17歳の女の子です。男性を手玉に取るような打算的な人柄であり、一言で言うと「小悪魔的な」という言葉が非常に似合う女の子です。\n実際はある国の公女であり、普段は表に出しませんが、非常に聡明であり天才的な策略家という一面もあります。\nこのキャラを参考資料2.1に示すキャラの衣装とポーズで描いていただきたいです。\n\n姿勢、衣装、参考資料2.1を参考にしていただき、閉脚しつつ、お尻がミニスカートから少し見えている感じでお願いします。\nその他の部分、腕や銃の持ち方等はアレンジして頂いて問題ありません（もちろん参考資料２のままでも大丈夫です！）が、ミュゼもライフルを使うキャラですので、是非銃は描いていただきたいと思います。カメラアングルもよりいいものがあれば自由に変えてください！\n表情はミュゼの小悪魔的な笑顔で描いて頂けると嬉しいです。\n細かいアスペクト比の指定はありませんが、縦長の絵でお願いします。\n\nどうかご検討のほどよろしくお願い致します。\n\n\n参考資料\n1. ミュゼ\n絵\n1.1\nhttps://www.falcom.co.jp/sen4/assets/character/detail/visual/musse.png\n1.2\nhttps://pbs.twimg.com/media/DlBv2aAUUAE9LiH?format=jpg&name=large\n1.3\nhttps://pbs.twimg.com/media/DIDIx_xVoAEdzfE?format=jpg&name=large\n\n\n概要\nhttps://dic.pixiv.net/a/%E3%83%9F%E3%83%A5%E3%82%BC%E3%83%BB%E3%82%A4%E3%83%BC%E3%82%B0%E3%83%AC%E3%83%83%E3%83%88\n\n\n2. ミストトレインガールズ ヴォルゴ\n2.1\nhttps://pbs.twimg.com/media/EegIElhUcAA-UOa?format=jpg&name=medium\n2.2\nhttps://misttraingirls.wikiru.jp/attach2/EFBCBBE383ADE383BCE383ACE383B3E59F8EE5A381E381AEE6ADBBE7A59EEFBCBDE383B4E382A9E383ABE382B4_EFBCBBE383ADE383BCE383ACE383B3E59F8EE5A381E381AEE6ADBBE7A59EEFBCBDE383B4E382A9E383ABE382B45F70726F66696C652E706E67.png", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@junkun148/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 474634, "client_id": 874664, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/968ef7d8/uploads/origins/2dd416e1-cea9-45dd-af14-46b19a7bdc07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9789085f4fce31e225731f3abf79487d", "srcset": "https://si.imgix.net/968ef7d8/uploads/origins/2dd416e1-cea9-45dd-af14-46b19a7bdc07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9789085f4fce31e225731f3abf79487d, https://si.imgix.net/968ef7d8/uploads/origins/2dd416e1-cea9-45dd-af14-46b19a7bdc07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c25c04b11a475aeabbf02126c1e2299f 2x, https://si.imgix.net/968ef7d8/uploads/origins/2dd416e1-cea9-45dd-af14-46b19a7bdc07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0cdaddf2bacd5f84319387e56f492afa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"sr