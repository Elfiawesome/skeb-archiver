す。\nmerry jennyのような、レイヤード感のあるナチュラルで可愛いコーディネートだととても嬉しいです。\n\n背景までしっかり描かれた、旅先で撮った写真のような一枚が本当に大好きなので、もし叶えていただけたら夢のようです～\n\nそして、もし私が先生のSkebで最初の納品作品になれたら、とても光栄です……！\nどうぞよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 155292, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "富岡二郎", "screen_name": "tomioka2", "avatar_url": "https://pbs.twimg.com/profile_images/1090912812224864257/2yJeBKGf.jpg", "header_url": "https://pbs.twimg.com/profile_banners/16947141/1576342152/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 2682344, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ゼカ", "screen_name": "skzk_CM", "avatar_url": "https://pbs.twimg.com/profile_images/1997645364703453184/ASU6y51b.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1479755690797576192/1773563103/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 2936119, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ちがみてら🌹", "screen_name": "Tigamitera_3", "avatar_url": "https://pbs.twimg.com/profile_images/1773694749666643968/IO3h2NzN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1531235758983741440/1771127082/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expira