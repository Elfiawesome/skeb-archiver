=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=857c46dfcc2ce073efa9fc1765266e3d", "srcset": "https://si.imgix.net/47e7918a/uploads/origins/ff895239-91d3-4360-b351-dd64e14a0e03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=857c46dfcc2ce073efa9fc1765266e3d, https://si.imgix.net/47e7918a/uploads/origins/ff895239-91d3-4360-b351-dd64e14a0e03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4d3b08191a9e23fd2b4f2cc96b7f9aa5 2x, https://si.imgix.net/47e7918a/uploads/origins/ff895239-91d3-4360-b351-dd64e14a0e03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=18ef971e42313426575416b52e9def5e 3x"}, "body": "隣野寧音様\n\n初めてのリクエスト失礼いたします！\n残業系巫女Vsingerとして活動しております神楽桃と申します。\n少し前にXからイラストを拝見いたしまして、素敵な雰囲気にいつかご依頼したいな…と考えておりました！このたび御社ポストを目にして「これを機に依頼だ！」と思いご連絡させていただきます！\n\n◆対象人物\n神楽桃\n\n◆構図・シチュエーションなど\n歌枠用だと嬉しいので、歌唱しているところのイラストでお願いいたします！\n雰囲気はどちらかというと自分のキャラクター的にカッコイイ寄りの方が嬉しいです…！\n服装や髪型はお任せしますので、キービジュアルのものでも構いませんし\n異なっていても問題ありません！\n\n◆使用用途\n配信・動画のサムネイルやSNSの告知画像に活用したいと考えております。\nご負担でなければ、人物・背景・エフェクト（あれば）を分けて納品頂けますと幸いです。\n\n以上、長くなってしまい恐縮ですが、何卒よろしくお願いいたします。\n\n▼参考資料は資料URLにドライブがございます！\n※三面図がなくて申し訳ございません…！\n\nhttps://drive.google.com/drive/folders/1W2Zfei79bMjQq-fkQXaH9KgPjJVZ92ZR?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neoji3an/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1299417, "client_id": 589130, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de51e0da/uploads/origins/c7778dfc-dc12-4abd-9696-85769c1b32ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46516321b2d1b26254216df3caeca7d7", "srcset": "https://si.imgix.net/de51e0da/uploads/origins/c7778dfc-dc12-4abd-9696-85769c1b32ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46516321b2d1b26254216df3caeca7d7, https://si.imgix.net/de51e0da/uploads/origins/c7778dfc-dc12-4abd-9696-85769c1b32ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ca8a45b6dc2dc5dfdd1dbaf36e442c5 2x, https://si.imgix.net/de51e0da/uploads/origins/c7778dfc-dc12-4abd-9696-85769c1b32ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bd0c71d014370cd79f68ba59e12c831 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de51e0da/uploads/origins/c7778dfc-dc12-4abd-9696-85769c1b32ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d25469e571580dc3ed86ce13f4c6ccf", "srcset": "https://si.imgix.net/de51e0da/uploads/origins/c7778dfc-dc12-4abd-9696-85769c1b32ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d25469e571580dc3ed86ce13f4c6ccf, https://si.imgix.net/de51e0da/uploads/origins/c7778dfc-dc12-4abd-9696-85769c1b32ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cdfff008c767c898bfe12ecd6f34df03 2x, https://si.imgix.net/de51e0da/uploads/origins/c7778dfc-dc12-4abd-9696-85769c1b32ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1a4f390d989721a516d4acea3fa7f3cd 3x"}, "body": "お疲れ様です。Vtuberとして活動しています、緋月けいと申します。\n緋月けいのイラストを依頼したくリクエストを送らせていただきました。\n\n使用用途としては、\n・YouTubeサムネ\n・Twitter等SNSでの投稿\nを想定しています。\n\n構図としましては、ポップでかわいい感じだと嬉しいです。\n背景はなしで大丈夫です。\n\n衣装、髪型などは既存のものでも良いですし、描きやすいものに変えても大丈夫です。\n変えてほしくない要素としては、\n・髪の色\n・目の色\n・アホ毛あり\nです。\n\n\n三面図などの画像がのっているTwitterリンクを添付しますので、よろしければ参考にしてください。\n\nお忙しいとは思いますが、よろしくお願いいたします。\n\nhttps://x.com/Hiduki_kei/status/1589094374117609472", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neoji3an/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1299417, "client_id": 1384181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1cb69c8/uploads/origins/087a8bb0-04d3-4206-a235-29cfcf325503?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee0e7db591f27da32ae1f27bdf7de65f", "srcset": "https://si.imgix.net/d1cb69c8/uploads/origins/087a8bb0-04d3-4206-a235-29cfcf325503?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee0e7db591f27da32ae1f27bdf7de65f, https://si.imgix.net/d1cb69c8/uploads/origins/087a8bb0-04d3-4206-a235-29cfcf325503?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a9d727acc209def5a5ac4beb928c04c 2x, https://si.imgix.net/d1cb69c8/uploads/origins/087a8bb0-04d3-4206-a235-29cfcf325503?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=388dc759774f620d766aa6a64356016d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1cb69c8/uploads/origins/087a8bb0-04d3-4206-a235-29cfcf325503?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8a7b333a5aa65b2bc2388310a7a362a", "srcset": "https://si.imgix.net/d1cb69c8/uploads/origins/087a8bb0-04d3-4206-a235-29cfcf325503?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8a7b333a5aa65b2bc2388310a7a362a, https://si.imgix.net/d1cb69c8/uploads/origins/087a8bb0-04d3-4206-a235-29cfcf325503?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=74d8f88acb3482d4197d97d1bb7fb7a2 2x, https://si.imgix.net/d1cb69c8/uploads/origins/087a8bb0-04d3-4206-a235-29cfcf325503?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6240fa2a67e0389cefce52c76e1c18ab 3x"}, "body": "寧音さんいつもお世話になっております！烏丸帷です。\n是非寧音さんにイラストを描いていただきたく、リクエストさせていただきました。\n\n描いて頂きたいのは私自身のイラストです。\n明るめの髪にメッシュが入っており、正面から見て左が赤・右がグレーのオッドアイ、右側に涙ぼくろがあります。\n\n衣装についてですが、既存の衣装でも構いませんし、お好きにオリジナルの衣装を着せていただいてももちろん大丈夫です。\n髪型についても同様で、お好きにアレンジしていただいても構いません。\n明るめ・ポップな雰囲気でポーズや構図を決めていただきたいです。\n\n可能であれば頭部や髪の毛の先が切れないようにしていただけると非常に助かります。\n\n使用用途は、YouTubeのサムネイルやTwitterその他SNSでの投稿、SNSアイコン・ヘッダーへの使用です。\n\n納品形式はpngかpsdを希望しております。\n可能でしたら人物のみの透過のデータを頂けますと幸いです。\n\n大変お忙しいこととは思いますが、ご検討宜しくお願いいたします。\n\nYouTube : https://youtube.com/@KarasumaTobari\nTwitter : https://twitter.com/karasumasann\n\nhttps://drive.google.com/drive/folders/1GaA16C6O9o87t8HVQivHLl6lO7OxNi2U?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neoji3an/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1299417, "client_id": 1136248, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4431ac6/uploads/origins/493283e3-5b70-4cfb-8735-655ab706713a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83bd531a3371fe64da64a2cda6a315cf", "srcset": "https://si.imgix.net/b4431ac6/uploads/origins/493283e3-5b70-4cfb-8735-655ab706713a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83bd531a3371fe64da64a2cda6a315cf, https://si.imgix.net/b4431ac6/uploads/origins/493283e3-5b70-4cfb-8735-655ab706713a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1dd7c5ec04bb0bf9cc53d9640a1a33ee 2x, https://si.imgix.net/b4431ac6/uploads/origins/493283e3-5b70-4cfb-8735-655ab706713a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a478c327b08e603ba41acfa23803381a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4431ac6/uploads/origins/493283e3-5b70-4cfb-8735-655ab706713a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae3186ddbd75c2971c6287a4bc3bff0f", "srcset": "https://si.imgix.net/b4431ac6/uploads/origins/493283e3-5b70-4cfb-8735-655ab706713a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&