ーの研究の為にね」と、明らかに入りたそうに持ちかける。\n　「うんうん、新メニューの研究だね」と入りたいことを察して笑顔で応える牡丹。\n・甘く美味しいお菓子に顔を綻ばせる或香、その様子を見て自分もお菓子を楽しみながらもほっこりする牡丹。", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@P31NT/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3517218, "client_id": 278973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11c2443b/uploads/origins/8b2552ba-882d-4f03-8399-2d6c10098a3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cc6f5f90d41067c523900c065beeb29", "srcset": "https://si.imgix.net/11c2443b/uploads/origins/8b2552ba-882d-4f03-8399-2d6c10098a3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cc6f5f90d41067c523900c065beeb29, https://si.imgix.net/11c2443b/uploads/origins/8b2552ba-882d-4f03-8399-2d6c10098a3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ccf2421d3b3431f767583ab15b93944 2x, https://si.imgix.net/11c2443b/uploads/origins/8b2552ba-882d-4f03-8399-2d6c10098a3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9fc0987d4e7bbe74edf0117b4287f18 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11c2443b/uploads/origins/8b2552ba-882d-4f03-8399-2d6c10098a3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aeb54d562f1f9a8e6516d7875bf1e986", "srcset": "https://si.imgix.net/11c2443b/uploads/origins/8b2552ba-882d-4f03-8399-2d6c10098a3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aeb54d562f1f9a8e6516d7875bf1e986, https://si.imgix.net/11c2443b/uploads/origins/8b2552ba-882d-4f03-8399-2d6c10098a3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eab2d289e357e10aa6c30fc43c3e632c 2x, https://si.imgix.net/11c2443b/uploads/origins/8b2552ba-882d-4f03-8399-2d