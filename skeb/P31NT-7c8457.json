ラにも加担せず、人里に降りたときは人助けも厭わない善良な性質。\n眠れる森の美女の魔女や、魔女の多様な服飾がメインモチーフ。\n\n元は町の仕立て屋の娘。人間時代は喧嘩っ早い跳ねっ返りで周囲から恐れられていた。\n魔法使うよりフィジカルで戦った方が強い。\n\nミルフィへの認識は世話の焼けるかわいい親友。やや溺愛気味。\n内心ミルフィに恋愛感情を抱いてるが、強気にグイグイ来られたい受け気質なので進展しない。\n親友・家族のような存在としても大事なので、普段は慈しむ気持ち強め。\n実年齢だけならホントはこっちが歳下。\n\nhttps://drive.google.com/drive/folders/1l5NuprFCdKait3mv02mIJsX-szl79Euu?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@P31NT/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3517218, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9381cc2/uploads/origins/dc27fdcf-527c-41a4-8829-c874a07cabce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c268eaed981fba588694064a453130db", "srcset": "https://si.imgix.net/a9381cc2/uploads/origins/dc27fdcf-527c-41a4-8829-c874a07cabce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c268eaed981fba588694064a453130db, https://si.imgix.net/a9381cc2/uploads/origins/dc27fdcf-527c-41a4-8829-c874a07cabce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4da0a4475c2aa18212d63f12ff4843f4 2x, https://si.imgix.net/a9381cc2/uploads/origins/dc27fdcf-527c-41a4-8829-c874a07cabce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8cb15f123fe28900160e9b2236129e2a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9381cc2/uploads/origins/dc27fdcf-527c-41a4-8829-c874a07cabce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=595b71f0a80ea7d0bd63cca8bedf5718", "srcset": "https://si.imgix.net/a9381cc2/uploads/origins/dc27fdcf-527c-41a4-8829-c874a07cabce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=595b71f0a80ea7d0bd63cca8bedf5718, https://si.imgix.net/a9381cc2/uploads/origins/dc27fdcf-527c-41a4-8829