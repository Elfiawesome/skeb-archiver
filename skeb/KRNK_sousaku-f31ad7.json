b089ac/uploads/origins/79ca114c-200f-4e4f-ad3f-3800f847231f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15ef7117ad531dbfcc72cfc4052a27b8", "srcset": "https://si.imgix.net/85b089ac/uploads/origins/79ca114c-200f-4e4f-ad3f-3800f847231f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15ef7117ad531dbfcc72cfc4052a27b8, https://si.imgix.net/85b089ac/uploads/origins/79ca114c-200f-4e4f-ad3f-3800f847231f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c1a5b8a833338507b69a3110f042acf 2x, https://si.imgix.net/85b089ac/uploads/origins/79ca114c-200f-4e4f-ad3f-3800f847231f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=23e740f2da0305780899ba34f6c2a8fc 3x"}, "body": "初めまして、個人Vtuberのせーなと申します。\nカランカ様の直近のお部屋イラストがとても可愛かったので是非依頼したいなと思いました！\n\n構図は直近のイラストと同じように、部屋で配信用のPC画面の前に座ってこちらを向いている感じでお願いします。\n部屋の内装ですが、参考画像は外観しか映っていないので、想像で大丈夫です。\nテーマとしては星空案内人の私室という設定で、黒に近い壁に青などの帯状の間接照明があって、未来感を感じる部屋でお願いします。\n小物は配信用のマイクやPC周辺機器、テーブルや椅子やベッドなどの家具、\nホログラム風だったり光るラインなどでSF感のある天文グッズ（望遠鏡や天球儀）の他、想像にお任せします。\n窓から星空やハート型の星雲が見えててもいいですし無くてもいいです。\n\nそのままだとクールで無機質な印象になってしまいそうなので、女子部屋っぽく見えるよう小物や家具などは可愛らしいorキラキラ綺麗な感じに描いて貰えると嬉しいです。\n\n使用用途としては主にYoutubeのサムネイルになります。\n人物だけ透過するなどレイヤーを分けて頂けると助かります。\nもし依頼料が不足しているようでしたら金額を訂正して再送をお願いします。\n\n人物の参考画像\nhttps://twitter.com/SenaStarrySky/status/1688811153831686144\n\n建物（空中天文台）の参考画像\nhttps://twitter.com/SenaStarrySky/status/1688808943127273473", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KRNK_sousaku/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2744995, "client_id": 2800811, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97294e65/uploads/origins/03c8f3f1-17ea-4398-907f-42fbce0a4bd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e899261827d7ef001e67413da4446e