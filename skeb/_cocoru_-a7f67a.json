9-e8922352c04c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d91b25a357df7db0e5f48e83b70e669", "srcset": "https://si.imgix.net/0b5517d9/uploads/origins/b0627386-4953-47fa-b7c9-e8922352c04c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d91b25a357df7db0e5f48e83b70e669, https://si.imgix.net/0b5517d9/uploads/origins/b0627386-4953-47fa-b7c9-e8922352c04c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8116fc76897b4bfeaec8e8cca659cf8 2x, https://si.imgix.net/0b5517d9/uploads/origins/b0627386-4953-47fa-b7c9-e8922352c04c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74ae3c8698bbff75be95840de42548f7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b5517d9/uploads/origins/b0627386-4953-47fa-b7c9-e8922352c04c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d597212be106ed84dec6f5109990cff", "srcset": "https://si.imgix.net/0b5517d9/uploads/origins/b0627386-4953-47fa-b7c9-e8922352c04c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d597212be106ed84dec6f5109990cff, https://si.imgix.net/0b5517d9/uploads/origins/b0627386-4953-47fa-b7c9-e8922352c04c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07a9a207d6c5bbd7f91940ceddc560a9 2x, https://si.imgix.net/0b5517d9/uploads/origins/b0627386-4953-47fa-b7c9-e8922352c04c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=71ca0ff1a289b7d6c84b266235052ac0 3x"}, "body": "花色ここる様\nはじめまして、VTuber準備中の遥紅いもと申します。\n新規リクエストでイラストを拝見し、ぜひ私もご依頼させていただきたいと思い、ご連絡いたしました。\n\n▶︎お願い\n・遥紅いもを描いていただきたいです。\n・テーマは「ハロウィン」でお願いしたいです。\n・白髪+黄色の渦巻き目+中性的な体(少女の骨格)というキャラデザの要素は必須でお願いします。\n・構図 + 衣装 については完全に花色ここる様にお任せします。（あまりにも露出が多過ぎなければ、どのような衣装でも大丈夫です！）\n・顔周りの見切れはないようにお願いしたいです。\n・可能であれば表情差分をつけていただけると嬉しいです。\n\n▶︎納品形式についての希望\n・背景を書いていただける場合は、背景と人物を別にして、人物だけの透過イラストもいただきたいです。\n\n▶︎使用用途\n・日々のXでのポストやYouTubeのサムネイルなどの使用\n・グッズ化するなどの商用利用はしませんが、いずれYouTubeの収益化を達成した際にはその動画でのサムネイルにも使用したいと考えています。\n\nよろしくお願いいたします。\n\nhttps://x.com/yakiimodaze_/status/1700901550846263540?s=20", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_cocoru_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2914076, "client_id": 2190327, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0d5dd98/uploads/origins/6aa104e7-8f38-4f64-9f17-1cb45f965296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef9bba1496cdf13658a756df55310dd5", "srcset": "https://si.imgix.net/e0d5dd98/uploads/origins/6aa104e7-8f38-4f64-9f17-1cb45f965296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef9bba1496cdf13658a756df55310dd5, https://si.imgix.net/e0d5dd98/uploads/origins/6aa104e7-8f38-4f64-9f17-1cb45f965296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ecaa007c38b44e7009cd070529c3ba52 2x, https://si.imgix.net/e0d5dd98/uploads/origins/6aa104e7-8f38-4f64-9f17-1cb45f965296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a59e0790c2fff61b1d3b7963bbbe538e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0d5dd98/uploads/origins/6aa104e7-8f38-4f64-9f17-1cb45f965296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03f09204ead1139f64c94a56be14d0a1", "srcset": "https://si.imgix.net/e0d5dd98/uploads/origins/6aa104e7-8f38-4f64-9f17-1cb45f965296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03f09204ead1139f64c94a56be14d0a1, https://si.imgix.net/e0d5dd98/uploads/origins/6aa104e7-8f38-4f64-9f17-1cb45f965296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=90356