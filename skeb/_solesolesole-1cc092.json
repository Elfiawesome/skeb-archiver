fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42b839419a77585a6def3ee1cf165a63, https://si.imgix.net/2496e951/uploads/origins/7497a074-8a81-429e-80b2-db891c1cc63d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=174bde500e5700c317dcb571545a07d0 2x, https://si.imgix.net/2496e951/uploads/origins/7497a074-8a81-429e-80b2-db891c1cc63d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=893862014d096797a53acae34fc4bcdb 3x"}, "body": "こんにちは！あなたが『ARIA』がお好きだと知り、イラストをお願いしたいと思いました！\n\n私のミコテのオリジナルキャラクターが、『ARIA』の制服を着ているイラストを希望します。背景は穏やかな水辺の景色にしていただきたいです。それ以外はすべてお任せします。\n\nご依頼をご検討いただき、ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1JEZyUS73QZUTL7JTNQaJ4QKHpb5pLoyK?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_solesolesole/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1160960, "client_id": 2869424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ebc3ff6a/uploads/origins/64efb9c1-ad56-4d77-9ca1-851dee9a82e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=027c0376046da47614f2599f0f5c0aad", "srcset": "https://si.imgix.net/ebc3ff6a/uploads/origins/64efb9c1-ad56-4d77-9ca1-851dee9a82e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=027c0376046da47614f2599f0f5c0aad, https://si.imgix.net/ebc3ff6a/uploads/origins/64efb9c1-ad56-4d77-9ca1-851dee9a82e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d292cc6f78ebb3e5f986090715219b41 2x, https://si.imgix.net/ebc3ff6a/uploads/origins/64efb9c1-ad56-4d77-9ca1-851dee9a82e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91cc4b08ce606f28530f4b364363ef4e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ebc3ff6a/uploads/origins/64efb9c1-ad56-4d77-9ca1-851dee9a82e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1c75074e656a81c4c3da90dfe1a8282", "srcset": "https://si.imgix.net/ebc3ff6a/uploads/origins/64efb9c1-ad56-4d77-9ca1-851dee9a82e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1c75074e656a81c4c3da90dfe1a8282, https://si.imgix.net/ebc3ff6a/uploads/origins/64efb9c1-ad56-4d77-9ca1-851dee9a82e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b07d2409d2b86d0a6c545eabd51b1074 2x, https://si.imgix.net/ebc3ff6a/uploads/origins/64efb9c1-ad56-4d77-9ca1-851dee9a82e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b1358c57364fb88b082c1a9efd7e1cae 3x"}, "body": "ソレ様はじめまして。\nTwitchを中心にVTuberとして活動しております、霧生優貴（きりゅうゆうき）と申します。\n私が一番好きなアニメであるARIAのイラストを素敵んぐに描いている方がいらっしゃる！と思い、リクエストさせていただきます。\n（歌ってみたの一枚絵なので、もしソレ様が依頼受け付けてなければキャンセルください。）\n作画コストがまちまちだと思いますので、ソレ様の方で内容判断いただき、価格提示いただけるとでっかい嬉しいです。\n\n■使用予定楽曲\nスピラーレ/牧野由依\nhttps://youtu.be/Tj7VtXzkCvQ?si=y1qRdla-zCyb4P5F\n※別のARIAの楽曲にする可能性あります。横顔、シンフォニー、潮騒などが候補です。\n\n■キャラクター設定/構図など\n以下に資料まとめております。ご確認ください！\nhttps://drive.google.com/drive/folders/1R51a9wIHnASu4Tq0wY9pSvJBBiCP4OXp?usp=sharing\n◇服装について\n特にARIAカンパニーのアリシアさんとアカリちゃんが大好きなので、ARIAカンパニーの制服でお願いしたいです。\n制服の夏/冬や手袋、髪飾りや帽子などはお任せします。\n※キャラクターシートの着脱可能な3点(翼、ヘイロー、うさ耳）はなしで大丈夫です。\n◇構図候補について\nいくつか候補を置いてみました。\n表紙やアニメのシーンからピックアップしてきています。組み合わせていただいても大丈夫です。\n背景はそこまで書き込みしなくて大丈夫です。\n候補の番号は1番から好きなもの順になっています。（でっかい迷いました…はひ～）\nもし可能でしたら以下も対応いただけると助かります。\n　・背景と人物はレイヤーを分ける\n　・人物は下部分を除く上左右は見切れない形", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_solesolesole/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1160960, "client_id": 109593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0c48a06/uploads/origins/5face82a-35bf