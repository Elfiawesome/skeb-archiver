a56ab4/uploads/origins/48b32cd7-8adc-46dc-8626-0b5656aa4292?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8906be8ec57c77bbdaebb1a5f38e02e4, https://si.imgix.net/5ca56ab4/uploads/origins/48b32cd7-8adc-46dc-8626-0b5656aa4292?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abe8cb00bc6b2262b8ea0738aa6943d6 2x, https://si.imgix.net/5ca56ab4/uploads/origins/48b32cd7-8adc-46dc-8626-0b5656aa4292?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62e61ca8329d8b14574ec63ba99ce684 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ca56ab4/uploads/origins/48b32cd7-8adc-46dc-8626-0b5656aa4292?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51ded8bf80d85d4d9090a129a6d98c55", "srcset": "https://si.imgix.net/5ca56ab4/uploads/origins/48b32cd7-8adc-46dc-8626-0b5656aa4292?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51ded8bf80d85d4d9090a129a6d98c55, https://si.imgix.net/5ca56ab4/uploads/origins/48b32cd7-8adc-46dc-8626-0b5656aa4292?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c9959f608bb32e8e96700e51626e0f5f 2x, https://si.imgix.net/5ca56ab4/uploads/origins/48b32cd7-8adc-46dc-8626-0b5656aa4292?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3183aaadefe9640938b71b82c88fe5d5 3x"}, "body": "りと〼先生、こんにちは。先生の作品が大好きで、私のオリジナルキャラクター2人を、どちらも男の子の姿で描いた2人組のイラストを依頼したいです。「依頼衣装資料」というフォルダにある衣装を使ってください。ポーズ、構図、表情はすべて先生にお任せします。自由に解釈して描いてください。よろしくお願いします！ 予算の調整が必要な場合は、再度ご連絡ください。💕\n\nhttps://drive.google.com/drive/folders/1l6xkCeaR4hRbU7u46oZxtuBbb0Nz2QJV", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_Rtms__/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3996371, "client_id": 3110349, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d4eb3aa/uploads/origins/3435f146-aaa0-49eb-baee-e9aaf0164032?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=678c936ce5bea7b42efe4c712b6f3c39", "srcset": "https://si.imgix.net/5d4eb3aa/uploads/origins/3435f146-aaa0-49eb-baee-e9aaf0164032?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=678c936ce5bea7b42efe4c712b6f3c39, https://si.imgix.net/5d4eb3aa/uploads/origins/3435f146-aaa0-49eb-baee-e9aaf0164032?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9cd2cdcd6d9b94a2f142a292339c6f3a 2x, https://si.imgix.net/5d4eb3aa/uploads/origins/3435f146-aaa0-49eb-baee-e9aaf0164032?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39a73fdef4c6c49d849ba85019db5f71 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d4eb3aa/uploads/origins/3435f146-aaa0-49eb-baee-e9aaf0164032?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=021e0bad058dffd71cb05f42e383149a", "srcset": "https://si.imgix.net/5d4eb3aa/uploads/origins/3435f146-aaa0-49eb-baee-e9aaf0164032?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=021e0bad058dffd71cb05f42e383149a, https://si.imgix.net/5d4eb3aa/uploads/origins/3435f146-aaa0-49eb-baee-e9aaf0164032?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe4809a0605775c98cbcbefcc2a417f1 2x, https://si.imgix.net/5d4eb3aa/uploads/origins/3435f146-aaa0-49eb-baee-e9aaf0164032?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ad3873e20f6b4d9b2c6688bc0057227a 3x"}, "body": "いつも素敵なイラストを拝見しております！海湊（うみなと）と申します！\n\nSkebでリクエストを募集されているのをお見かけし、ぜひりと〼様が描かれる私の創作キャラクターを拝見したく、リクエストを送らせていただきました…！！\nよろしければご検討いただけますと幸いです！\n\n【依頼内容】\n・私の創作キャラ（閻魔様）のイラスト\n・服装は和服（黒い着物＋赤い羽織）\n・構図や背景、雰囲気、衣装の詳細なデザインなどはぜひりと〼様にお任せでお願いしたいです！\n\n【用途】\n・個人鑑賞用（印刷・グッズ化を含む）\n・自分で描いたり、他の方へ依頼したりする際の参考用\n・SNSアイコン、個人HPへの掲載（掲載の際は必ずりと〼様のお名前を記載いたします）\n\n【もし可能でしたら】\n今後自費制作を予定している創作本へ、りと〼様のお名前を記載したうえで掲載させていただけますと幸いです…！\nもちろんご無理を承知でのお願いですので、難しい場合は掲載不可としていただいて問題ございません！その場合でも個人鑑賞用として大切にさせていただきます！\n\n【オーダーする創作キャラ（閻魔様）について】\n・外見は下記の個人HP内、「人物」欄の「閻魔様」部分、および「作品一覧」欄の一枚絵、GoogleDriveをご参照いただけますと幸いです！\n・外見年齢は15〜17歳程度\n・表情変化は控えめですが、決してぶっきらぼうではない性格です\n・詳細な世界観や制作背景などはあまり重く捉えすぎず、りと〼様の描きやすいように描いていただけますと幸いです！\n\n【参考資料】\n・個人HP：\nhttps://uminato03710.wixsite.com/uminato-art-garrely/%E5%9C%B0%E7%8D%84%E3%81%AE%E6%B2%99%E6%B1%B0%E3%82%82%E9%96%BB%E9%AD%94%E3%81%BE%E3%81%A7\n・GoogleDrive：https://drive.google.com/drive/folders/1HELx3JThNEC6IQTZNwoumw0tvAaBxYGh?usp=sharing\n\n金額や参考資料等に不備がございましたら、遠慮なく再送やキャンセルをご検討いただけますと幸いです…！\n\nまた、リクエストとは関係のないお話で恐縮なのですが、以前販売されていた原神／放浪者のアクリルスタンドを購入させていただいておりました！\n本来であればDMなどでお伝えすべきところだったのですが、なかなか勇気が出ず、この場をお借りしてお礼を失礼いたします🙇\nりと〼様の描かれる放浪者が以前から大好きだったため、アクリルスタンドやカードをお迎えできたときは本当に嬉しかったです！\n現在もスマホケースの裏に入れて、お守りのように持ち歩いております。\n\n描いていただいた際には、ぜひ改めて感想も送らせていただければと思っております！\nこれからも、りと〼様のイラストや創作活動を陰ながら応援しております！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 250090, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "しきそ", "screen_name": "sikiso_soso", "avatar_url": "https://pbs.twimg.com/profile_images/1772166711778955264/vB4vdJKI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/133287190/1774598168/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 1}, {"id": 712043, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "umio", "screen_name": "voyager_369", "avatar_url": "https://pbs.twimg.com/profile_images/1875887143882801152