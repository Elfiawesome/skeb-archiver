=2&fit=crop&crop=top&w=200&h=200&s=cacd45dadf4ddc0de5b7003d86bf4768 2x, https://si.imgix.net/c5657e85/uploads/origins/90524ab1-3e4e-4079-8be6-0f8e154061cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0bb9013ec3d9d6029d5d0bb0d676b48 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5657e85/uploads/origins/90524ab1-3e4e-4079-8be6-0f8e154061cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e02736b863888dba47f03f35270219c", "srcset": "https://si.imgix.net/c5657e85/uploads/origins/90524ab1-3e4e-4079-8be6-0f8e154061cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e02736b863888dba47f03f35270219c, https://si.imgix.net/c5657e85/uploads/origins/90524ab1-3e4e-4079-8be6-0f8e154061cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=89fe92988c13bbec522f691c9388354e 2x, https://si.imgix.net/c5657e85/uploads/origins/90524ab1-3e4e-4079-8be6-0f8e154061cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=99b8b0b85710b115084847154711ae0f 3x"}, "body": "こんにちは。あなたのセクシーなメスブタの描き方がとても好きです。\n私のアイデアや物語をたくさん描いていただきたいと思います。\nまずは適当なメス豚を描いてみよう。\n\nブタの女はセックスに飢えた淫乱な熟女だ。\n彼女の淫らな体は全身が青々としていて、セクシーな丸みを帯びた形をしている。\n豚女の身体はどこもかしこもとてもふくよかだ。しかし贅肉はない。腹ひだのたるみもない。おっぱいもお腹も分厚い脂肪で満たされている。\n\nおっぱいは大きく（頭より大きい）、重く硬く、肉付きがよく、密な脂肪で満たされている。乳首は厚く、でこぼこしている。 乳首の周りには大きくふくらんだゴツゴツした黒っぽい乳輪がある。\n脂肪の多い乳房は重いために垂れ下がるが、乳首は前を向き、わずかに上を向いている（乳首は垂れ下がらない）。\n女性に2～4対の大きな脂肪乳を与えてみよう。\n\nおなかは少し膨らんで丸みを帯びているが、妊娠初期のように引き締まっている。お腹にはたるんだひだがなく、会陰を覆っていない。\n\nメス豚の貪欲なマンコは淫らに見える。\n肉厚の折り重なった内陰唇が外側に突き出て垂れ下がっている。\nクリトリスは非常に厚く、陰唇の下から突き出ている。メス豚はクリトリスをフェラチオされるのが大好きだ。\nマンコは常に愛液で溢れている。フェロモンたっぷりのマンコの匂いは遠くまで広がる。\n\n豚はどんな食べ物でも好んで食べる。\nしかし、このメス豚は、かわいい無垢な少年たちの処女をむさぼるのが一番好きだ。\n豚女の貪欲で飽くなきマンコにとって、最高のご馳走は、少年の甘い初射精を底までしゃぶることだ。少年が望むと望まざるとにかかわらず、豚女は少年の最初の女になるのが大好きなのだ。\n\nアイデア。\n豚女は私を捕まえようと路地を追いかけてきた。今、私は行き止まりに追い詰められ、裸の豚女がどんどん近づいてくる。今、女は獲物のように私を見下ろし、ご馳走を期待して甘く唇を舐めている。\n\nhttps://drive.google.com/drive/folders/10jW01PqRE-7v3DaBY2Jly66qg_iDf860#Pig_woman", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@buta_komaniku/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2788171, "client_id": 122307, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91e714d5/uploads/origins/4d4cdf20-ba58-4489-bf25-69c0deb32fb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c3ce1a2860902eb959e0ae6b011e143", "srcset": "https://si.imgix.net/91e714d5/uploads/origins/4d4cdf20-ba58-4489-bf25-69c0deb32fb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c3ce1a2860902eb959e0ae6b011e143, https://si.imgix.net/91e714d5/uploads/origins/4d4cdf20-ba58-4489-bf25-69c0deb32fb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd8b73a10a55bcf2d648a51ff72e0cd5 2x, https://si.imgix.net/91e714d5/uploads/origins/4d4cdf20-ba58-4489-bf25-69c0deb32fb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53a89103777bf697b9da798ed8ef67bb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91e714d5/uploads/origins/4d4cdf20-ba58-4489-bf25-69c0deb32fb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eeb7b87ea280e2eafc2b59e5f99fe425", "srcset": "https://si.imgix.net/91e714d5/uploads/origins/4d4cdf20-ba58-4489-bf25-69c0deb32fb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eeb7b87ea280e2eafc2b59e5f99fe425, https://si.imgix.net/91e714d5/uploads/origins/4d4cdf20-ba58-4489-bf25-69c0deb32fb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4086579808d4e9fbabb7ba5e627613cf 2x, https://si.imgix.net/91e714d5/uploads/origins/4d4cdf2