able_same_genre": true}], "sent_works": [{"path": "/@muroku669/works/55", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 16391, "client_id": 581290, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9eb98552/uploads/origins/41e27821-a15f-49a7-b8f6-b500cc88169f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38ad4a5624ba59b0df83052e1c9e1ba7", "srcset": "https://si.imgix.net/9eb98552/uploads/origins/41e27821-a15f-49a7-b8f6-b500cc88169f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38ad4a5624ba59b0df83052e1c9e1ba7, https://si.imgix.net/9eb98552/uploads/origins/41e27821-a15f-49a7-b8f6-b500cc88169f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8dbb16b7e90ba6300ed8ed4a0f80928d 2x, https://si.imgix.net/9eb98552/uploads/origins/41e27821-a15f-49a7-b8f6-b500cc88169f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f642fdc4a9590d0c6c2e61ebc424f91 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9eb98552/uploads/origins/41e27821-a15f-49a7-b8f6-b500cc88169f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=434ef5aa4babb112aee3ac31bd429ad0", "srcset": "https://si.imgix.net/9eb98552/uploads/origins/41e27821-a15f-49a7-b8f6-b500cc88169f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=434ef5aa4babb112aee3ac31bd429ad0, https://si.imgix.net/9eb98552/uploads/origins/41e27821-a15f-49a7-b8f6-b500cc88169f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4445c8ccdb619cefd67133a17b8c7929 2x, https://si.imgix.net/9eb98552/uploads/origins/41e27821-a15f-49a7-b8f6-b500cc88169f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dfa18825d53077082059853dbf8387df 3x"}, "body": "いつも素敵なイラストをTLでお見かけしてお世話になっております蠍乙女です。\nSkebのリクエスト募集中ということでこの度はTwitchやDiscordで使える蠍乙女ルカのディフォルメされたSDスタンプを一点リクエストしたくご依頼のお話をさせていただきたいです。\n\n恐らくですがムロク様が普段受け付けている依頼とは違って少々特殊な依頼になるのでまずは規格の説明をさせていただきます。\n\n----規格について----\nイラストの解像度の規格は縦横の幅が同じ正方形で112px~4096pxまでの解像度でファイルについては最大サイズが1MB以下で拡張子はPNGでお願いいたします。\nRGBやCMYKについての指定はありません。\n----ここまで----\n\n使用時には自動でリサイズされて更に小さめに表示されるのでイメージが掴みづらい場合は私のTwitchチャンネルで用意されているスタンプなどを打ち込んで確認してくださって結構です。\n\nそれではイラスト内容についての細かいリクエストについてお話させていただきます。\n\n----イラスト内容について----\nまずは前述した通りスタンプでの使用なので背景は透過でお願いします。\n内容としてはキャラクターの蠍乙女ルカがフェイスアップの構図でディフォルメされた状態にBYEの文字が入った内容をご依頼したいです。\n文字の位置は自由ですし髪の毛の部分に重なっていて大丈夫ですが縮小された時に読める程度には大きいと助かります。\n\nばいばいの時に使うので片手もしくは両手が見えると嬉しいです。\n表情には目を開いていても閉じていてもいいので笑顔でお願いします。\n----ここまで----\n\nmooちゃんやムクちゃんのSD絵がとても素敵だったのでリクエストを送らせて頂きました。\n本当は一点ではなく数点お願いしたかったのですが一身上の都合により一点のみのご依頼になることをお許しください。\n内容的に無理な部分がございましたらリクエスト拒否をしていただいて結構です。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 417286, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "粕家梅庵", "screen_name": "Kasuya_Baian", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fmisskey%2Fb04f37d5-075f-4fbd-875d-5bcfcd9c1723.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/798a1222-bcb4-4e17-9ecd-17673fd55440.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 4, "complete_expiration_days": 35, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 1688710, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "KiiKo @アニメ原画風skeb", "screen_name": "Kiiko_clip", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fd4b360a8-1c07-44f9-b59a-94c6982e2227.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/i