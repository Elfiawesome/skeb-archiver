0&s=8c3388c84a43524375b9fddc77c6a260 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/176b187f/uploads/origins/f23e88f8-f9f7-455c-9336-593311c157cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eec4ebca293963700418d1df35cd79a0", "srcset": "https://si.imgix.net/176b187f/uploads/origins/f23e88f8-f9f7-455c-9336-593311c157cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eec4ebca293963700418d1df35cd79a0, https://si.imgix.net/176b187f/uploads/origins/f23e88f8-f9f7-455c-9336-593311c157cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc9f9d33cb92e5cba32f33b93a17ea0d 2x, https://si.imgix.net/176b187f/uploads/origins/f23e88f8-f9f7-455c-9336-593311c157cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b0f8fca5ab5f3e411aa51312b8c3ba32 3x"}, "body": "下記キャラの立ち絵を一枚お願いします。\n\nキャラ造形は参照画像をベースにしてもらい、服装のみスリングショットの水着にしてもらえれば\n\n肌が見えている部分は全体的に傷痕があり、右の鎖骨から右胸上、左の下腹部当たり前で大きい傷跡を入れてください。\n\nそのほか細かい部分やアレンジはお任せします。\n\nhttps://x.com/mantis493/status/2088638474954133673", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Deal_rollin/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3149974, "client_id": 190863, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47fa1234/uploads/origins/77721de4-76ee-4bc2-a1e0-819a0bf22286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7020b3e4d65b5185cf3ed35c4057debf", "srcset": "https://si.imgix.net/47fa1234/uploads/origins/77721de4-76ee-4bc2-a1e0-819a0bf22286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7020b3e4d65b5185cf3ed35c4057debf, https://si.imgix.net/47fa1234/uploads/origins/77721de4-76ee-4bc2-a1e0-819a0bf22286?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ba4428dab8960d85effaeacad5993c1 2x, https://si.imgix.net/47fa1234/uploads/origins/77721de4-76ee-4bc2-a1e0-819a0bf22286?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51416471bff5f3f0ec19dc101ee28692 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47fa1234/uploads/origins/77721de4-76ee-4bc2-a1e0-819a0bf22286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6314f72fb01236775e175b55bd661ea4", "srcset": "https://si.imgix.net/47fa1234/uploads/origins/77721de4-76ee-4bc2-a1e0-819a0bf22286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6314f72fb01236775e175b55bd661ea4, https://si.imgix.net/47fa1234/uploads/origins/77721de4-76ee-4bc2-a1e0-819a0bf22286?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=90a7192e086aef32d40086c2bc159941 2x, https://si.imgix.net/47fa1234/uploads/origins/77721de4-76ee-4bc2-a1e0-819a0bf22286?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=60f0b80423f4e3cf61f223095e8752df 3x"}, "body": "始めまして。うちの子を描いていただきたくリクエストを送らせていただきました。描いていただいたイラストは今後他の方とのコミッション(R18含む)の資料として使用させていただく予定です。\n\nこちらのイラスト(https://x.com/i/status/1933751129332199449) のようにカラーで全身が入った正面のアングルの立ち絵をお願いします。\n\n該当キャラクター\nhttps://x.com/i/status/2081955533767299472\n\n衣装は新規で描いていただきたいです。衣装のテーマはファンタジー世界の酒屋の看板娘、ディアンドルを着させてください。メインカラーはブラウン、胸元は谷間が見えるように少し深めに、下はミニスカートで丈はお尻が見えるか見えないかぐらいの短さ、靴は編み上げのブラウン色のロングブーツ。その他細かいデザインやカラーリングはおまかせします。\n\n髪型は三つ編みのルーズサイドテール、前髪はそのままでお願いします。\n\nポーズは両手に樽のビールジョッキを持って運んでいる様子を切り取ったようなイメージです。\n\n\nとても長くなりましたが何卒よろしくお願いします…！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Deal_rollin/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3149974, "client_id": 2600976, "vtt_url