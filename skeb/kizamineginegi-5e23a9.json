s/189d6ef8-8cab-4dc8-87dc-bf2f77a3940a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a961485cb7d41cedf71aecb3b403534", "srcset": "https://si.imgix.net/0e869c93/uploads/origins/189d6ef8-8cab-4dc8-87dc-bf2f77a3940a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a961485cb7d41cedf71aecb3b403534, https://si.imgix.net/0e869c93/uploads/origins/189d6ef8-8cab-4dc8-87dc-bf2f77a3940a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=667e298acc43c75d9ca4a5f84bd921bf 2x, https://si.imgix.net/0e869c93/uploads/origins/189d6ef8-8cab-4dc8-87dc-bf2f77a3940a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e08f23c8a82625c3c9d79600fded63c7 3x"}, "body": "こんにちは。\n片目隠れでむちむちした色んなコスプレをしてくれるキャラとラブコメが大好きなので、いつも漫画を楽しく拝見しています。\nもしよろしければそんなうちの子「浜風ふたば」の牛柄ビキニコス姿を描いていただけないでしょうか。\n\n衣装の設定としては「牧場併設型リゾート施設での案内係の仕事」みたいな感じです。\nまた、お腹周りやそのほか全身はいぶきさんのようなふっくらむちむち健康ボディに描いていただけると大変うれしいです。\n\n作品はSkebの印刷サービスなどを利用し家に飾りたいと思っています。\nご検討のほどよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/15rfNfdZDVmhJc0pGCazqbRy446T95IHu?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kizamineginegi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1789682, "client_id": 3204802, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dcaf1e4e/uploads/origins/c2ecba34-916e-4750-8eb0-aef3ea9a32a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cf424dc32332f6efb294a2cdd2fd484", "srcset": "https://si.imgix.net/dcaf1e4e/uploads/origins/c2ecba34-916e-4750-8eb0-aef3ea9a32a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cf424dc32332f6efb294a2cdd2fd484, https://si.imgix.net/dcaf1e4e/uploads/origins/c2ecba34-916e-4750-8eb0-aef3ea9a32a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25c4067fb606b3bc49c1e1c98a424ded 2x, https://si.imgix.net/dcaf1e4e/uploads/origins/c2ecba34-916e-4750-8eb0-aef3ea9a32a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00c28ad48b733ca2eb0f470ae43ff612 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dcaf1e4e/uploads/origins/c2ecba34-916e-4750-8eb0-aef3ea9a32a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=caa4f0716d1b2dfdc2b3d2a1327a8078", "srcset": "https://si.imgix.net/dcaf1e4e/uploads/origins/c2ecba34-916e-4750-8eb0-aef3ea9a32a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=caa4f0716d1b2dfdc2b3d2a1327a8078, https://si.imgix.net/dcaf1e4e/uploads/origins/c2ecba34-916e-4750-8eb0-aef3ea9a32a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=46e9a7fed967e9dc5c2623d898e2159a 2x, https://si.imgix.net/dcaf1e4e/uploads/origins/c2ecba34-916e-4750-8eb0-aef3ea9a32a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9786875ab93270e57a14f4296f5f905e 3x"}, "body": "SNSではお世話になっております。ユナリ・アスノークです。\n「うちこもり妻はコスプレ配信者2巻」発売おめでとうございます！\n私も購入させていただいて、楽しませていただいております。\nねぎし先生がskebをやってらっしゃるとお伺いしたので、ねぎし先生に描いていただけたらと思い、リクエストさせていただきました。\n改めて簡単な自己紹介とリクエスト内容・使用用途おまとめしましたので、ご検討いただけますと幸いです。\n\n\n自己紹介\nゲームに恋してゲームを愛する魔女。凍てつく北の大地の生まれで夜と雪を制する。\n見た目は黒髪(毛先が少し青っぽいです)ショート(まどマギのさやかちゃんみたいな髪型といえばわかりやすいでしょうか？)にややつり目の青瞳、体型は胸は大きいけど、お腹も多少ぷにっとしてるし太ももも太いタイプです。\n詳細的な見た目については資料内のデフォルト衣装関係のフォルダををご覧いただければ幸いです。\n\nリクエスト内容・使用用途\n・YouTubeサムネイルや動画、SNS宣伝活動等に使用するイラストを描いていただきたいです。\n※現在収益化しておりませんが、できたらしたいというスタンスでいます。\n・服装に関してはバニースーツの猫版の格好でかいていただけるとうれしいです（簡単なデザインを資料に同梱してますので、ご参考にして下さい。）\n・ポーズはセクシーな感じでムチムチ感がでるようなポーズですとありがたいです。（基本おまかせしたいです。）\n・サムネイル等に使用するので背景の透過もしくは背景等と人物を分けた状態にしてくださると助かります。\nまた、頭部や上半身の見切れがないようにしていただきたいです。\n・メガネをかけた姿がデフォルトですが、メガネありなしどちらでも構いません。\n\n以上になります。\nお取り組み可能でしたら、ぜひよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/13s0pdzf8Enjo3I5LUzlu252eFpzGpsEk?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kizamineginegi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1789682, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f038675b/uploads/origins/83615486-8ec1-4dd9-b843-f9cdcaa260fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c18e32a85815be4bfa5184a17622837f", "srcset": "https://si.imgix.net/f038675b/uploads/origins/83615486-8ec1-4dd9-b843-f9cdcaa260fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c18e32a85815be4bfa5184a17622837f, https://si.imgix.net/f038675b/uploads/origins/83615486-8ec1-4dd9-b843-f9cdcaa260fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbf4949a282d54b2c7c1ab2bf288b4bd 2x, https://si.imgix.net/f038675b/uploads/origins/83615486-8ec1-4dd9-b843-f9cdcaa260fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69ed8ca1200c82a319525f74d0adf693 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f038675b/uploads/origins/83615486-8ec1-4dd9-b843-f9cdcaa260fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c42e7bac65bf0269a114e02a40dc90c", "srcset": "https://si.imgix.net/f038675b/uploads/origins/83615486-8ec1-4dd9-b843-f9cdcaa260fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c42e7bac65bf0269a114e02a40dc90c, https://si.imgix.net/f038675b/uploads/origins/83615486-8ec1-4dd9-b843-f9cdcaa260fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4e67c7cb10ef65638318c858e9267493 2x, https://si.imgix.net/f038675b/uploads/origins/83615486-8ec1-4dd9-b843-f9cdcaa260fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c724407958e683e5bb6916a0264c0d60 3x"}, "body": "『うちこもり妻はコスプレ配信者』のいぶきさんをリクエストさせていただきます。\n海に遊びに行った時に会った男の子3人がそれぞれいぶきさんの水着姿を思い出している場面を、\n「いぶきさんの１枚絵＋男の子の様子」の構成でお願いします。\n男の子たちの状況は、海から上がってシャワーを浴びている時だったり、就寝しようとして思い出して寝付けないだったり等、お任せします。\n\n１人は本編で水槽の魚を見せていた時の、上着を着て両腕で胸を挟んだ前かがみの場面を思い出していて、\n他の二人は（間近で交流していたという仮定で）上着を脱いだ姿を思い出してもらいたいです。\n\nお引き受けいただけるようでしたら、よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kizamineginegi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1789682, "client_id": 1999696, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f06cbba0/uploads/origins/5e1bc146-4253-444c-a353-ba3957d8c62b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f3dc74bf99cb6906de1cf351b3a1bd2", "srcset": "https://si.imgix.net/f06cbba0/uploads/origins/5e1bc146-4253-444c-a353-ba3957d8c62b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f3dc74bf99cb6906de1cf351b3a1bd2, https://si.imgix.net/f06cbba0/uploads/origins/5e1bc146-4253-444c-a353-ba3957d8c62b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7496591db56eb17b041e011110ec2c25 2x, https://si.imgix.net/f06cbba0/uploads/origins/5e1bc146-4253-444c-a353-ba3957d8c62b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1eaeec4fa4a69ad0d6897ea2cbf55d93 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f06cbba0/uploads/origins/5e1bc146-4253-444c-a353-ba3957d8c62b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e188d3731d0ba45e7d844f6367f8c001", "srcset": "https://si.imgix.net/f06cbba0/uploads/origins/5e1bc146-4253-444c-a353-ba3957d8c62b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e188d3731d0ba45e7d844f