大きく、くびれはメリハリをつけてほしいです。(身体の線は大袈裟めに胸もクビレもつけてほしいです)\nパフスリーブの半袖に短いスカートで、パニエで膨らませてます。\n網タイツガーターに、厚底ロングブーツを履いてます。\n\n蜘蛛感と体の線を分かるようにと、やんちゃな感じを出して頂けたら幸いです。\n以上が私の情報ですが、これに忠実にと言うより、これを元に作者さんが楽しく書ける、作者さんの色も生かした絵を、書いて貰えたら嬉しいです！\nよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ayupi0718/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/86ab818c/uploads/origins/d914e546-a4fa-499a-895b-28d7d0dd8f49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d302515a9578f32dd7b9cd8647f309ce", "srcset": "https://si.imgix.net/86ab818c/uploads/origins/d914e546-a4fa-499a-895b-28d7d0dd8f49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d302515a9578f32dd7b9cd8647f309ce, https://si.imgix.net/86ab818c/uploads/origins/d914e546-a4fa-499a-895b-28d7d0dd8f49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02e5573089e842dbbcd72fedcc58e1b7 2x, https://si.imgix.net/86ab818c/uploads/origins/d914e546-a4fa-499a-895b-28d7d0dd8f49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e00967dde2e51c7e1a81110a9c6b5546 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2978993, "client_id": 2214294, "nc": 1}, {"path": "/@ayupi0718/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2978993, "client_id": 2868400, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/769a4804/uploads/origins/f71ccbf5-33a1-48f5-b8bb-a0744655bd2a?bg=%23fff&auto=format%2Ccompress&f