bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=008dc7fa52105a72ebfb0578e2c34ddd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c20566d1/uploads/origins/1b7008c8-8491-445f-b71d-5f9bb43239d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=afabf67aa64be240e3cd8f80f8bf29db", "srcset": "https://si.imgix.net/c20566d1/uploads/origins/1b7008c8-8491-445f-b71d-5f9bb43239d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=afabf67aa64be240e3cd8f80f8bf29db, https://si.imgix.net/c20566d1/uploads/origins/1b7008c8-8491-445f-b71d-5f9bb43239d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f3631a668a962d983a6600d8ca2f2984 2x, https://si.imgix.net/c20566d1/uploads/origins/1b7008c8-8491-445f-b71d-5f9bb43239d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=25984a43490d07e2c87029bc8b727848 3x"}, "body": "リッキーです、よろしくお願いします！あなたの作品、すごく好きです。\n\nぜひ私のキャラクターを描いていただけないでしょうか。彼はマフィアのボスで、実は狼の血も引いているのですが、それを隠しています。ぜひ彼を描いてほしいです。\n\nこちらが私の新しいキャラクターです - https://drive.google.com/drive/folders/1K-a0cGg1ht825nfwgCegySU3PVn5ZcCi?usp=sharing\n\nロマンチックでセクシーなイケメンな表情で描いていただけると嬉しいです。よろしくお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aomeshi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1741096, "client_id": 4107513, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35fc3a16/uploads/origins/dfe13646-6674-418b-9365-4b07d69f1fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77425f64b083318271ea585ef81d8ae3", "srcset": "https://si.imgix.net/35fc3a16/uploads/origins/dfe13646-6674-418b-9365-4b07d69f1fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77425f64b083318