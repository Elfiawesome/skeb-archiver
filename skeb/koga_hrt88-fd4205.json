2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=976f8ecf6f228bc9c23c4c21eed97336 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e4b09ad/uploads/origins/d7d558ea-f359-41d2-b041-9061a9db0f10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c4f75164111e2d560ac6daf181f9fa9", "srcset": "https://si.imgix.net/2e4b09ad/uploads/origins/d7d558ea-f359-41d2-b041-9061a9db0f10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c4f75164111e2d560ac6daf181f9fa9, https://si.imgix.net/2e4b09ad/uploads/origins/d7d558ea-f359-41d2-b041-9061a9db0f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=64ef07a4a4bdd533f3250caac817f62d 2x, https://si.imgix.net/2e4b09ad/uploads/origins/d7d558ea-f359-41d2-b041-9061a9db0f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=50ef47bebe33d8e20c65404809b1d9ac 3x"}, "body": "はじめまして。先生の作品にとても憧れており、この依頼を引き受けて頂ければ幸いです。オリジナルキャラクター2体のイラストをお願いしたいです。\n\n🐰キャラクターA 176cm。貴族の男性。優しい性格の持ち主。詩が好き。かるたをやっている。首と両腕に包帯を巻いている。月と縁がある。\n\nキャラクターB 178cm。高潔な旅の僧を気取っている美青年。実は悪魔を呼び出して戦っている。髪がとてもフサフサしている。\n\n二人の出会いは運命。平安時代の雰囲気のあるシーンが欲しいです。\n\nそれ以外の構図はお任せします。依頼内容に問題があれば、遠慮なくお断りください。ありがとうございました!\n\nhttps://sta.sh/229418hcw4kr", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koga_hrt88/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2302219, "client_id": 187973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e711df1c/uploads/origins/e1340e67-fd60-4df8-bdb3-dcd1e55a7586?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0ff1ad3ce725774344b6599561f899a", "srcset": "https://si.imgix.net/e711df1c/uploads/origins/e1340e67-fd60-4df8-bdb3-dcd1e55a7586?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cro