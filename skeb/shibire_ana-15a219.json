しいです\n\n以上です", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shibire_ana/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6c52065f/uploads/origins/7fbc641c-8c08-4200-b6d4-5007c02853de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f57935b8409dac40f1b62cb9f9b4817b", "srcset": "https://si.imgix.net/6c52065f/uploads/origins/7fbc641c-8c08-4200-b6d4-5007c02853de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f57935b8409dac40f1b62cb9f9b4817b, https://si.imgix.net/6c52065f/uploads/origins/7fbc641c-8c08-4200-b6d4-5007c02853de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39b7b8e2a37ecc465359399f56b78eb0 2x, https://si.imgix.net/6c52065f/uploads/origins/7fbc641c-8c08-4200-b6d4-5007c02853de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e84133dbc64b3abd15cd425f62694d99 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1319031, "client_id": 1219096, "nc": 32}, {"path": "/@shibire_ana/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1319031, "client_id": 1284664, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd33947b/uploads/origins/6fcad5fa-24d1-419d-aee7-564b61a31fb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baf269d2e167332f2d5c19a19dde413b", "srcset": "https://si.imgix.net/dd33947b/uploads/origins/6fcad5fa-24d1-419d-aee7-564b61a31fb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=c