段にいて、手首と足首を手すりに手錠で固定されている。https://www.pixiv.net/en/artworks/97764858#96（細かい背景は必要ない）。人目を避けるためにしゃがんでいる。口にはテープが貼ってある。体には「レイプして」「自由に使って」などと卑猥な言葉が書かれている。手錠の鍵は、手の届かない彼女の前の地面にある。彼女のアソコからは汁が滴り落ち、彼女は捕まったことへの驚きと恐怖で視聴者を見上げている。\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1OmuedlE0fp7r9qSrVBVOPM75y-311fdn", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amahakurumi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2115817, "client_id": 1388897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2195609b/uploads/origins/fe4132c4-3fcd-4a9b-ae70-806bdd1fece4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb4b0c38998a8bc864d7b103ebcccf19", "srcset": "https://si.imgix.net/2195609b/uploads/origins/fe4132c4-3fcd-4a9b-ae70-806bdd1fece4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb4b0c38998a8bc864d7b103ebcccf19, https://si.imgix.net/2195609b/uploads/origins/fe4132c4-3fcd-4a9b-ae70-806bdd1fece4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb4b599601780931bfe0f994294b7846 2x, https://si.imgix.net/2195609b/uploads/origins/fe4132c4-3fcd-4a9b-ae70-806bdd1fece4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7336e15cfc527af66ff9f90c854434e5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2195609b/uploads/origins/fe4132c4-3fcd-4a9b-ae70-806bdd1fece4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c2f2694f5c48d3d79cd8cdd6b301982", "srcset": "https://si.imgix.net/2195609b/uploads/origins/fe4132c4-3fcd-4a9b-ae70-806bdd1fece4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c2f2694f5c48d3d79cd8cdd6b301982, https://si.imgix.net/2195609b/uploads/origins/fe4132c4-3fcd-4a9b-ae70-806bdd1fece4?bg=%23f