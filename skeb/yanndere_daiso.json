としてキャラクターのみの利用もさせていただきたいので、髪の毛や耳等の頭部が途切れていない状態で描写いただけると嬉しいです！\n\nまた、可能でしたら表情差分をお願いいたします。\n・目を閉じていない笑顔\n・ウインク\n・下ペロ\n等のバリエーションがあるととても嬉しいです！作風にあいそうなもので数点お願できましたら幸いです…！\nゲーム配信、雑談、歌枠などのサムネに利用させていただこうかと思っております！\n\n【イラストサイズ、ファイル形式】\nPDS、もしくはPNGで納品をお願いしたいです。\nキャラクターのみで使用する場合がございますので、背景等を分けていただけると嬉しいです。\nキャラクター、署名なし、背景あり、背景のみのデータで頂けますと大変助かります。\n\nご検討いただけますと幸いです。\nよろしくお願いいたします！\n\nhttps://lit.link/renren22ieneko", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 493105, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "きしし＠Skeb募集中", "screen_name": "wf170ZpFwi", "avatar_url": "https://pbs.twimg.com/profile_images/1762357345429114880/nl8_s6Ci.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1160107845708218368/1733206866/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "skills": [{"genre": "art"}], "nc": 33}, {"id": 567390, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ぢん", "screen_name": "jin0518", "avatar_url": "https://pbs.twimg.com/profile_images/1701256188292476928/BqUBe-ZS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/38016541/1734883396/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 57}, {"id": 2587793, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ᴋᴜʀᴀʏᴀ|依頼進行中💭", "screen_name": "___KURAYAA", "avatar_url": "https://pbs.twimg.com/profile_images/1446820399887437827/mYIfwKA6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1414372110181437440/1626047814/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_