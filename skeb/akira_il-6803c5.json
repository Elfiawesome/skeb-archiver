b28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f1e2384a938397a50ee1b12869a9da5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32657130/uploads/origins/5be65a37-8cf9-4879-82b9-f579c64cdb28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a82edd2d0de50fd713ff9cc93281ee64", "srcset": "https://si.imgix.net/32657130/uploads/origins/5be65a37-8cf9-4879-82b9-f579c64cdb28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a82edd2d0de50fd713ff9cc93281ee64, https://si.imgix.net/32657130/uploads/origins/5be65a37-8cf9-4879-82b9-f579c64cdb28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=75a44088da2d009ad24d16f6981f2cbc 2x, https://si.imgix.net/32657130/uploads/origins/5be65a37-8cf9-4879-82b9-f579c64cdb28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e36b6669bb3252c259eb80433807bea0 3x"}, "body": "私はあなたのMP41のアートが本当に大好きです\n\nMP41と司令官のユーモラスなシーンを描いていただけませんか？MP41は司令官の膝の上に乗っていて、司令官の方を向いています。司令官の首筋にはMP41がキスしたかのように複数のキスマークがあります。背景ではMP40が顔を赤らめて嫉妬しながら見ています。MP41が司令官より背が低くて小さいので、少し体格差があるかもしれません。MP40とMP41は両方とも通常の制服を着ています。\n\n司令官のデザインはお任せします！顔のない男にしたい方はご自由にどうぞ。\n\nお好みでドイツ語の台詞を追加してください。mp41が独りよがりに、妹のmp40と司令官を分けてくれるというのも面白いかもしれません。\n\n具体的な構成などはお任せします。\n\n参考文献： https://imgur.com/a/HC37C5I", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2970782, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "よつれみ", "screen_name": "yotsuremi", "avatar_url": "https://pbs.twimg.com/profile_images/2031336223000899586/A2fNG_i4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1696430088408231936/1776499248/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at