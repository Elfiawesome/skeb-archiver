ogle.com/drive/folders/1XuyLPUWsWhRKXATcjOFLViqWLvCDc8wM?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nutori_manga/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4050380, "client_id": 66445, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f275570/uploads/origins/45d21c48-f627-4f93-9368-46f824e21727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=619566e53a2f5f406aae410b1bce4577", "srcset": "https://si.imgix.net/8f275570/uploads/origins/45d21c48-f627-4f93-9368-46f824e21727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=619566e53a2f5f406aae410b1bce4577, https://si.imgix.net/8f275570/uploads/origins/45d21c48-f627-4f93-9368-46f824e21727?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3082316f3c01fe7afd488ef196367910 2x, https://si.imgix.net/8f275570/uploads/origins/45d21c48-f627-4f93-9368-46f824e21727?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d31266d44bc4cfc7ce7e33ba3c4c1f8a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f275570/uploads/origins/45d21c48-f627-4f93-9368-46f824e21727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da5583d9a45a8f36f15ccb044ed57d3c", "srcset": "https://si.imgix.net/8f275570/uploads/origins/45d21c48-f627-4f93-9368-46f824e21727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da5583d9a45a8f36f15ccb044ed57d3c, https://si.imgix.net/8f275570/uploads/origins/45d21c48-f627-4f93-9368-46f824e21727?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a26237f0ee114884a711f52d1ae4476c 2x, https://si.imgix.net/8f275570/uploads/origins/45d21c48-f627-4f93-9368-46f824e21727?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0b247c6ea4923e7eeefd3e950add495f 3x"}, "body": "プロモーション作品を見ましたが、素晴らしかったです！私のグリフィンライダーとそのグリフィンのイラストを依頼したいと思っています。\n\n森の魔女に育てられた兄弟です。イシャーンは赤毛の浅黒い肌の男性ですが、現在は顔の右側に（腐食性の）火傷の跡があります。イグナシオは灰色のグリフォンです。\n\nその他はすべてお任せします。\n\nイシャーン：\nhttps://cdn.imgchest.com/files/y2pck9kn2n7.png\nhttps://cdn.imgchest.com/files/4jdcvwq8q24.PNG\nhttps://cdn.imgchest.com/files/yd5cezdp2k4.png\nhttps://cdn.imgchest.com/files/yq9c3ppgxz4.png\nhttps://cdn.imgchest.com/files/45xcvnx8zj7.png\n\nイグナシオ：\nhttps://cdn.imgchest.com/files/ye3c2p53vd4.png\nhttps://cdn.imgchest.com/files/pyvdc3gegxy.png\nhttps://cdn.imgchest.com/files/y2pckkw2jm7.jpg\nhttps://cdn.imgchest.com/files/766945335fdb.png\n\nザ・デュオ：\nhttps://cdn.imgchest.com/files/7pjcqnongn7.png\nhttps://cdn.imgchest.com/files/y2pckke92q7.png\n\nhttps://cdn.imgchest.com/files/7pjcqnongn7.png", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nutori_manga/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4050380, "client_id": 3465115, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/332ff5be/uploads/origins/0b6accf8-8b13-49e9-a215-e0710859d63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3093ceb70c16470cc73fb89051eaa2b", "srcset": "https://si.imgix.net/332ff5be/uploads/origins/0b6accf8-8b13-49e9-a215-e0710859d63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3093ceb70c16470cc73fb89051eaa2b, https://si.imgix.net/332ff5be/uploads/origins/0b6accf8-8b13-49e9-a215-e0710859d63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=684a62d4332fa4a506e3df3e6333e033 2x, https://si.imgix.net/332ff5be/uploads/origins/0b6accf8-8b13-49e9-a215-e0710859d63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a4f9bced22b727ceeb674dde25d72df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/332ff5be/uploads/origins/0b6accf8-8b13-49e9-a215-e0710859d63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07e378022e90561c85be376edbdad68c", "srcset": "https://si.imgix.net/332ff5be/uploads/origins/0b6accf8-8b13-49e9-a215-e0710859d63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07e378022e90561c85be376edbdad68c, https://si.imgix.net/332ff5be/uploads/origins/0b6accf8-8b13-49e9-a215-e0710859d63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=98d52458c69e642bb4260641943b7b04 2x, https://si.imgix.net/332ff5be/uploads/origins/0b6accf8-8b13-49e9-a215-e0710859d63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7aa5f7cf710871ed16e1960c630639e1 3x"}, "body": "こんにちは！私のキャラクター「セレナ・エリザベス・イル・ドラセア」を描いていただけないでしょうか。彼女はドラセア王国の王女で、政略結婚から逃れて冒険の旅に出た人物です。自信に満ちていていたずら好きな女性ですが、それでも贅沢なものを好む一面もあります。また、たくさんの本を読み、特に女騎士が登場する冒険物語が大好きです。\n詳細： \n\n- 紺色の髪で、様々なヘアスタイルが可能です（https://drive.google.com/drive/u/1/folders/1pUXq4UK8RzbtWCMYsSgTOYvsqTaJLkFD）\n- 普段は舞踏会やその他のフォーマルな場にふさわしい、長くふわりとしたドレスを着ている。時には、新たに手に入れた自立の一環として、肌見せの多い服装を好むこともある。\n- ドラセアの至宝である宝石をあしらったレイピアを振るう（https://drive.google.com/drive/folders/145f2Fx7mDlrAOz9IaVrhDEcq_wCsprJT?usp=drive_link）\n- 時にはティアラを身につけることもある（https://drive.google.com/drive/folders/1n6zcCth7A7rH7_Rze4GVsnKoYKEcV7rQ?usp=drive_link）\n- セレナは攻撃力を高める様々な元素の舞を駆使しており、特に「フェニックスの舞」は彼女に火の力を与える\n\nhttps://drive.google.com/drive/folders/1EuLmP1YCbHVmZIp2EET-X5FsjtXqN5wH", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nutori_manga/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4050380, "client_id": 2713162, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/576869c2/uploads/origins/9ba4b7bf-2a60-4e16-a215