fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cf6968b870899ec35afde143bfe389f", "srcset": "https://si.imgix.net/49f26c95/uploads/origins/fe36ee20-9f29-4f0a-b975-5abaf28ff9cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cf6968b870899ec35afde143bfe389f, https://si.imgix.net/49f26c95/uploads/origins/fe36ee20-9f29-4f0a-b975-5abaf28ff9cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a209b2f13d7b1324297db281aad61cc7 2x, https://si.imgix.net/49f26c95/uploads/origins/fe36ee20-9f29-4f0a-b975-5abaf28ff9cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4e6f1a5eae88c59034095c64e1880575 3x"}, "body": "初めまして。新着で素敵なイラストを見掛け、リクエストさせて頂きました。\nご確認ご検討お願いします。\n\n■キャラ\n資料のキャラをお願いしたいです。自作ゲームのキャラクターです。\n性別は女性ですが、内外面共にほぼほぼ男です。高身長筋肉質、声も低く男顔、一人称もオレで、初見は9割男性と判断されますが、腰の位置が高くよく見ると女性であることが分かる、という感じのキャラクターです。（尚、振る舞いも男性的ですが自認は女なので、一目で女と見抜くと喜びます）\n\n■内容\nお任せ致します。\n\n■利用用途\n個人観賞用です。\n\n以上、ご検討お願いします。\n\nhttps://drive.google.com/drive/folders/1mcberY2aP5vZdzvd5XPJesQnpg9Ca5dq?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nutori_manga/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4050380, "client_id": 4055959, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e670e41b/uploads/origins/599e01d4-05f6-4008-aa03-e6977bece67d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ab9398c7ec069b39712b03d6934275c", "srcset": "https://si.imgix.net/e670e41b/uploads/origins/599e01d4-05f6-4008-aa03-e6977bece67d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ab9398c7ec069b39712b03d6934275c, https://si.imgix.net/e670e41b/uploads/origins/599e01d4-05f6-4008-aa03-e6977bece67d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09e85831b874501eb567c9891c4e058d 2x, https://si.imgix.net/e670e41b/uploads/origins/599e01d4-05f6-4008-aa03-e6977bece67d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2120ac5294f266b6f99a4f30470c904 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e670e41b/uploads/origins/599e01d4-05f6-4008-aa03-e6977bece67d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1a4c5d8332d02cd69fb92869226ce47", "srcset": "https://si.imgix.net/e670e41b/uploads/origins/599e01d4-05f6-4008-aa03-e6977bece67d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1a4c5d8332d02cd69fb92869226ce47, https://si.imgix.net/e670e41b/uploads/origins/599e01d4-05f6-4008-aa03-e6977bece67d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=47bb08da654aea00e81e43b8f09c295f 2x, https://si.imgix.net/e670e41b/uploads/origins/599e01d4-05f6-4008-aa03-e6977bece67d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bbe0d11df975144e2a9bf12967616f6e 3x"}, "body": "こんにちは！\n\nあなたのアートスタイルがとても気に入りました。私の悪役キャラクター「レディ・セヴェラ」のイラストを依頼したいです。彼女は氷の能力を持つ貴族出身の暗殺者です。参考画像のリンクを添付しました。剣に刻まれた祈りの文が書かれた.pngファイルも含まれています。必要であればご自由にお使いください。 \n\n顔の傷跡と、少し日焼けした肌の色にご注意ください。帽子やメガネ、あるいはその両方を描くかどうかは、お任せします！\n\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1XuyLPUWsWhRKXATcjOFLViqWLvCDc8wM?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nutori_manga/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4050380, "client_id": 66445, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f275570/uploads/origins/45d21c48-f627-4f93-9368-46f824e21727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=619566e53a2f5f406aae410b1bce4577", "srcset": "https://si.imgix.net/8f275570/uploads/origins/45d21c48-f627-4f93-9368-46f824e21727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=619566e53a2f5f406aae410b1bce4577, https://si.imgix.net/8f275570/uploads/origins/45d21c48-f627-4f93-9368-46f824e21727?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3082316f3c01fe7afd488ef196367910 2x, https://si.imgix.net/8f275570/uploads/origins/45d21c48-f627-4f93-9368-46f824e21727?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d31266d44bc4cfc7ce7e33ba3c4c1f8a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f275570/uploads/origins/45d21c48-f627-4f93-9368-46f824e21727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da5583d9a45a8f36f15ccb044ed57d3c", "srcset": "https://si.imgix.net/8f275570/uploads/origins/45d21c48-f627-4f93-9368-46f824e21727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da5583d9a45a8f36f15ccb044ed57d3c, https://si.imgix.net/8f275570/uploads/origins/45d21c48-f627-4f93-9368-46f824e21727?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a26237f0ee114884a711f52d1ae4476c 2x, https://si.imgix.net/8f275570/uploads/origins/45d21c48-f627-4f93-9368-46f824e21727?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0b247c6ea4923e7eeefd3e950add495f 3x"}, "body": "プロモーション作品を見ましたが、素晴らしかったです！私のグリフィンライダーとそのグリフィンのイラストを依頼したいと思っています。\n\n森の魔女に育てられた兄弟です。イシャーンは赤毛の浅黒い肌の男性ですが、現在は顔の右側に（腐食性の）火傷の跡があります。イグナシオは灰色のグリフォンです。\n\nその他はすべてお任せします。\n\nイシャーン：\nhttps://cdn.imgchest.com/files/y2pck9kn2n7.png\nhttps://cdn.imgchest.com/files/4jdcvwq8q24.PNG\nhttps://cdn.imgchest.com/files/yd5cezdp2k4.png\nhttps://cdn.imgchest.com/files/yq9c3ppgxz4.png\nhttps://cdn.imgchest.com/files/45xcvnx8zj7.png\n\nイグナシオ：\nhttps://cdn.imgchest.com/files/ye3c2p53vd4.png\nhttps://cdn.imgchest.com/files/pyvdc3gegxy.png\nhttps://cdn.imgchest.com/files/y2pckkw2jm7.jpg\nhttps://cdn.imgchest.com/files/766945335fdb.png\n\nザ・デュオ：\nhttps://cdn.imgchest.com/files/7pjcqnongn7.png\nhttps://cdn.imgchest.com/files/y2pckke92q7.png\n\nhttps://cdn.imgchest.com/files/7pjcqnongn7.png", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nutori_manga/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4050380, "client_id": 3465115, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/332ff5be/uploads/origins/0b6accf8-8b13-49e9-a215-e0710859d63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3093ceb70c16470cc73fb89051eaa2b", "srcset": "https://si.imgix.net/332ff5be/uploads/origins/0b6accf8-8b13-49e9-a215-e0710859d63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3093ceb70c16470cc73fb89051eaa2b, https://si.imgix.net/332ff5be/uploads/origins/0b6accf8-8b13-49e9-a215-e0710859d63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=684a62d4332fa4a506e3df3e6333e033 2x, https://si.imgix.net/332ff5be/uploads/origins/0b6accf8-8b13-49e9-a215-e0710859d63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a4f9bced22b727ceeb674dde25d72df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/332ff5be/uploads/origins/0b6accf8-8b13-49e9-a215-e0710859d63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07e378022e90561c85be376edbdad68c", "srcset": "https://si.imgix.net/332ff5be/uploads/origins/0b6accf8-8b13-49e9-a215-e0710859d63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07e378022e90561c85be376edbdad68c, https://si.imgix.net/332ff5be/uploads/origins/0b6accf8-8b13-49e9-a215-e0710859d63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=98d52458c69e642bb4260641943b7b04 2x, https://si.imgix.net/332ff5be/uploads/origins/0b6accf8-8b13-49e9-a215-e0710859d63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7aa5f7cf710871ed16e1960c630639e1 3x"}, "body": "こんにちは！私のキャラクター「セレナ・エリザベス・イル・ドラセア」を描いていただけないでしょうか。彼女はドラセア王国の王女で、政略結婚から逃れて冒険の旅に出た人物です。自信に満ちていていたずら好きな女性ですが、それでも贅沢なものを好む一面もあります。また、たくさんの本を読み、特に女騎士が登場する冒険物語が大好きです。\n詳細： \n\n- 紺色の髪で、様々なヘアスタイルが可能です（https://drive.google.com/drive/u/1/folders/1pUXq4UK8RzbtWCMYsSgTOYvsqTaJLkFD）\n- 普段は舞踏会やその他のフォーマルな場にふさわしい、長くふわりとしたドレスを着ている。時には、新たに手に入れた自立の一環として、肌見せの多い服装を好むこともある。\n- ドラセアの至宝である宝石をあしらったレイピアを振るう（https://drive.google.com/drive/folders/145f2Fx7mDlrAOz9IaVrhDEcq_wCsprJT?usp=drive_link）\n- 時にはティアラを身につけることもある（https://drive.google.com/drive/folders/1n6zcCth7A7rH7_Rze4GVsnKoYKEcV7rQ?usp=drive_link）\n- セレナは攻撃力を高める様々な元素の舞を駆使しており、特に「フェニックスの舞」は彼女に火の力を与える\n\nhttps://drive.google.com/drive/folders/1EuLmP1YCbHVmZIp2EET-X5FsjtXqN5wH", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nutori_manga/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4050380, "client_id": 2713162, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/576869c2/uploads/origins/9ba4b7bf-2a60-4e16-a215-9fd24624c295?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a57c270c1570923e0ab5e18f1ee08313", "srcset": "https://si.imgix.net/576869c2/uploads/origins/9ba4b7bf-2a60-4e16-a215-9fd24624c295?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a57c270c1570923e0ab5e18f1ee08313, https://si.imgix.net/576869c2/uploads/origins/9ba4b7bf-2a60-4e16-a215-9fd24624c295?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2cd6e523d3514165a016d40c27c45e80 2x, https://si.imgix.net/576869c2/uploads/origins/9ba4b7bf-2a60-4e16-a2