けていただきたいです。\n（通常すまし顔、笑顔、泣き顔、リード咥え)\n学校の椅子、簡易的な背景（パターン模様でも可）がありますと嬉しいです。\n\n<衣装・髪型について>\n「制服衣装3面図」での髪型、衣装での制作をお願いします。\n\n<キャラクター詳細> \n三面図、立ち絵、構図参考をまとめたものはこちらです\n\n<使用用途> \n収益化済みのYouTubeチャンネル内での使用 Xなど各SNSで使用、グッズ利用も検討したいです \n\n <納品データ> \n人物、宛名、表情差分、楽器、背景、椅子、などレイヤー分けされたデータを納品していただきたいです。  ご検討をよろしくお願い致します…！\n\nhttps://drive.google.com/drive/folders/1FgcvDSr6MF5Ux1vs4L8SJjmggokNCZ9K?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1232110, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "はらストーン", "screen_name": "yanndere_daiso", "avatar_url": "https://pbs.twimg.com/profile_images/1505460390171668483/EZKQmNpk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1279274542934835200/1724774641/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 2177248, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "りり", "screen_name": "jijimemecat", "avatar_url": "https://pbs.twimg.com/profile_images/1544582281305952256/kJaDCqrz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1072521464211881984/1657092098/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 2255281, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ふうすけ（サブのすがた）", "screen_name": "fusuke_neko", "avatar_url": "https://www.gravatar.com/avatar/?d=identicon", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "firs