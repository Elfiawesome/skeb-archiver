1cd2c6624 2x, https://si.imgix.net/96746268/uploads/origins/d919b97f-56db-498d-b0de-ae01ab30dfe2?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf1312b45326025ee256b1bed1eb1093 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96746268/uploads/origins/d919b97f-56db-498d-b0de-ae01ab30dfe2?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=8241ae15fcef56fb54c699bbf1d54d8c", "srcset": "https://si.imgix.net/96746268/uploads/origins/d919b97f-56db-498d-b0de-ae01ab30dfe2?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=8241ae15fcef56fb54c699bbf1d54d8c, https://si.imgix.net/96746268/uploads/origins/d919b97f-56db-498d-b0de-ae01ab30dfe2?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ed61f5f69e2ab39cd393757bd9190f0 2x, https://si.imgix.net/96746268/uploads/origins/d919b97f-56db-498d-b0de-ae01ab30dfe2?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=13707d7ce42c64d3286a9293d0a41c24 3x"}, "body": "はじめまして、クラリネットVmusicianさくらゆいと申します🌸\nクラリネットや吹奏楽の魅力を布教するため、アマチュアながらも練習に励み、リスナーさんと共に成長していくコンテンツをお届けしております✨\n\n構図サンプル③のお座りをアニメーションでお願いします。\n\n◾︎使用用途\n収益化済みのYouTubeチャンネル内での使用 Xなど各SNSで使用、クラウドファンディングでの返礼品への使用を検討しています。\n\n◾︎衣装・髪型について\n髪型やキャラクターは三面図をご参考ください\n表情差分を付けていただける場合、ウインクや笑顔、＞＜、△の口、Vの口などをお願いします。\nみたらしねこ様の判断でその他追加の差分がございましたら構いません。\n\n◾︎納品データ\nフルカラーだけでなく、1色印刷のアイテムへの使用もするため、\n線画だけで構成されたデータもいただきたいです。\n人物と表情差分、線画、色、モノクロ線画、背景などレイヤー分けされたPSDデータで納品していただきたいです。\n（当方素の状態のPSDデータの扱いに慣れているため、お手数をおかけしてしまう場合は結合前のデータでも構いません）\nご検討をよろしくお願い致します…！\n\nhttps://drive.google.com/file/d/18VZFjgw2ui2d9D1Jab1nzFzqevL1SWsD/view?usp=drivesdk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@asaiumi/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 379603, "client_id": 3019533, "vtt_url": null, "thumbnail_