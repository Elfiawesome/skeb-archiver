る。他人と深く関わることはできず、人間関係を台無しにしてしまう。常に退屈しており、パーティー、ドラッグ、暴力、操作、親切、趣味、買い物、仕事など、退屈を紛らわせる手段を常に探している。 \n> アナイスはファッションが大好きで、身だしなみに細心の注意を払っている。非常に体系的なスキンケアのルーティンを持っている。好きな色はピンク。\n\nテーマ：鏡、仮面舞踏会、秘密、錯視、仮面、危険を隠す美、変容、獲物が捕食者になる、霞んだ部屋、隠された顔、影、嘘の中の真実／真実の中の嘘", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jun94501400/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/15a315d7/uploads/origins/df65001c-a420-4966-9666-48f24affc77b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=627fae3da9ef8a6791afb4d38a839794", "srcset": "https://si.imgix.net/15a315d7/uploads/origins/df65001c-a420-4966-9666-48f24affc77b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=627fae3da9ef8a6791afb4d38a839794, https://si.imgix.net/15a315d7/uploads/origins/df65001c-a420-4966-9666-48f24affc77b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e9860d5adbf082702c4c4cbd598c946 2x, https://si.imgix.net/15a315d7/uploads/origins/df65001c-a420-4966-9666-48f24affc77b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3bb33722fd5788e5e013f00ebc90828 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1095081, "client_id": 779969, "nc": 32}, {"path": "/@jun94501400/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1095081, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18e835c2/uploads/origins/1271dd62-98ed-4d45-8caf-10af342e0302?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cr