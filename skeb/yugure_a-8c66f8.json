GYFJGA", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yugure_a/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2281095, "client_id": 745005, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/591d8892/uploads/origins/2ea6dc23-31e7-437a-b70e-0de22dba87b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c557baf847c196e6a7a6f37cbe3596e8", "srcset": "https://si.imgix.net/591d8892/uploads/origins/2ea6dc23-31e7-437a-b70e-0de22dba87b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c557baf847c196e6a7a6f37cbe3596e8, https://si.imgix.net/591d8892/uploads/origins/2ea6dc23-31e7-437a-b70e-0de22dba87b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d78c17363ff1afd99a3953b4bed30aa 2x, https://si.imgix.net/591d8892/uploads/origins/2ea6dc23-31e7-437a-b70e-0de22dba87b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ffa362217179d0b2cb855939ed0a31f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/591d8892/uploads/origins/2ea6dc23-31e7-437a-b70e-0de22dba87b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ba9509f4163fe695d0c334b176f0436", "srcset": "https://si.imgix.net/591d8892/uploads/origins/2ea6dc23-31e7-437a-b70e-0de22dba87b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ba9509f4163fe695d0c334b176f0436, https://si.imgix.net/591d8892/uploads/origins/2ea6dc23-31e7-437a-b70e-0de22dba87b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a990829a5b2ceacd863c992fe57ab3e 2x, https://si.imgix.net/591d8892/uploads/origins/2ea6dc23-31e7-437a-b70e-0de22dba87b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c4423d1ccc74e4c224faf4a84f46d575 3x"}, "body": "こんにちは、ゆうぐれ先生！あなたの絵はとても美しいので、私のオリジナルキャラクターのデッサンをお願いしたいです。\n\nLINXIU\nキャンドルや石鹸を作る仕事をしているホタルの精。表情豊かでよく笑うが、口は悪くストレート。あるときは老婆のように、またあるときは天真爛漫な子供のように振る舞う。冷静で賢い反面、庇護欲が強く、世間知らずなところがある。\n\nリンシューのようなホタルの精霊は非常に短命な種族である。彼らは夏の初めに意識を得て姿を現すが、寿命は2ヶ月しかない。そのため、人間の生活の苦しみをほとんど知らず、代わりに毎日をできるだけ楽しく生きることに集中している。\n\nキーワード：燃え尽きそうなロウソク、ロウ、ホタル、スイカズラ、アルケケンギク、はかなさ、生きる喜び\n\n\n揺らめくキャンドルの気持ちをどうにか表現してほしい。今にも消えそうなのに、しぶとく命をつないでいる炎のように。服装や構図はお任せします。頭には触角があり、背中には虫の羽が生えていることにご注目ください。目もオレンジ色に光っている。\n\nhttps://geeckek.notion.site/Linxiu-2d01d0143d0780faab83f3019ff5e97a", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yugure_a/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2281095, "client_id": 2742181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3f0e921/uploads/origins/129020f3-a25f-4e87-b426-4c070f417a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=523a3ce10bf31ce26b9c96a903b69609", "srcset": "https://si.imgix.net/f3f0e921/uploads/origins/129020f3-a25f-4e87-b426-4c070f417a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=523a3ce10bf31ce26b9c96a903b69609, https://si.imgix.net/f3f0e921/uploads/origins/129020f3-a25f-4e87-b426-4c070f417a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1895df45b2a4b09a8632ac406b0692ba 2x, https://si.imgix.net/f3f0e921/uploads/origins/129020f3-a25f-4e87-b426-4c070f417a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a972b5bd3f4dd63e2ccc7e2a5bd3517 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3f0e921/uploads/origins/129020f3-a25f-4e87-b426-4c070f417a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69e1d94a693877f5b74c00d035b75532", "srcset": "https://si.imgix.net/f3f