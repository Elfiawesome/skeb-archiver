ps://si.imgix.net/9e87c6c4/uploads/origins/09a3fb9b-9de6-4a8a-91ae-43702bf2a478?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb522971ddb94729420b70c9095e4cdc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e87c6c4/uploads/origins/09a3fb9b-9de6-4a8a-91ae-43702bf2a478?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c0514c08ee3584f6915f7bcd259f4a0", "srcset": "https://si.imgix.net/9e87c6c4/uploads/origins/09a3fb9b-9de6-4a8a-91ae-43702bf2a478?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c0514c08ee3584f6915f7bcd259f4a0, https://si.imgix.net/9e87c6c4/uploads/origins/09a3fb9b-9de6-4a8a-91ae-43702bf2a478?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07b873a43331cce5a1fa6db51053b493 2x, https://si.imgix.net/9e87c6c4/uploads/origins/09a3fb9b-9de6-4a8a-91ae-43702bf2a478?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5d63f839e56df71eaf217f938d236878 3x"}, "body": "ぱっぴさん初めまして。\nウマ娘にてご依頼を掛けられそうな方を探しているところ、新着クリエイターにてぱっぴさんのことを見かけさせて頂きました。\nもしよろしければウマ娘の「エアメサイア」ちゃんをお願いしたく、更には「トサキントレオタード」をコスプレさせて頂いたイラストをお願いできますか。\n（※トサキントレオタード→初代のポケモンアニメ43話「ナッシーぐんだん　だいこうしん！」で、カスミがマジシャンのアシスタントの際に着用していた、トサキントを模した衣装を指してます）\n\n衣装の造形につきましては資料ページのURLをご参考頂ければと存じます。\nこの衣装がずっと大好きなため、完全に自分の趣味としてコスプレでご依頼させて頂きたいです。もちろん元ネタをご存じないだろうことは覚悟の上ですので、それでもよろしければお願いさせて頂きたく存じます……！\n\nぱっぴさんはシャカ推しのご様子ながら、その縁でメッちゃんもちょいちょい描かれてましたので、是非とも自分の好きなメサイアちゃんをおまかせしつつ。\nまたバニー服とか質感や縫い目までこだわってグッとくる描き味でしたので、レオタードにもご理解が深いと見込みまして、この衣装でお願いできましたらと考えた次第です。\n\n表情や構図・ポーズ、あと多少のアレンジなどについては、ぱっぴさんが良いと思ったまま、ご想像されるままのエアメサイアちゃんで描いて頂ければOKです。\nセンシティブに配慮してストッキング履かせる等の微アレンジを加えて頂く等は問題ないですが、もちろん原作デザインそのままに素足で描かれても大丈夫です！\n（だけどロングな手袋が性癖なので、アレンジしても手袋は忘れないで頂ければとてもすごく嬉しいです……）\n一応コスプレ（衣装）姿がメインとなるため、できればで十分ですが、全身が拝める構図で衣装姿を堪能させて頂ければ特に嬉しく思います。\n\nやや無茶な依頼とは存じますが、それでもよろしければ何卒お願いいたします！\n\nhttps://bulbapedia.bulbagarden.net/w/index.php?title=File:Misty_Goldeen_outfit.png", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 88659, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "R.シュタットフェルド/Ryuno Stadtfeld ☆Skeb募集中", "screen_name": "ryuno_stadtfeld", "avatar_url": "https://pbs.twimg.com/profile_images/1841667279777628164/5muhUAA4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/127416968/1773754224/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 176}, {"id": 738812, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "うめづかうめこ♦️skeb募集中", "screen_name": "umeumeduka", "avatar_url": "https://pbs.twimg.com/profile_images/1366750675430821889/_-YTMcX8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1261950118908948486/1732285966/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 842706, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "笠蛇✪🐈‍⬛", "screen_name": "kasahebi", "avatar_url": "https://pbs.twimg.com/profile_images/1982286813231235072/9hw6nwrv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/710033827/1702535098/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "sk