iv.net/artworks/96385251\nhttps://www.pixiv.net/artworks/101341253\n[シチュエーション]\n①\nシャツ・縞パン・マフラー・手袋・靴下・靴の格好で歌いながら雪の中を歩く女の子\nhttps://skeb.jp/@kozzyTAn/works/5\nこのような感じでシャツから縞パンチラ見せがいいかもしれません。\n②\n雪を蹴散らし走り出す女の子\nこのへんから縞パン丸見えを考えています。\n③\n前宙返りで柵を飛び越える女の子", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 4241, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "めるちゃん", "screen_name": "weaselmailcat", "avatar_url": "https://pbs.twimg.com/profile_images/1626054746015674368/9cs3mhlA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2504160787/1696498550/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "skills": [{"genre": "art"}], "nc": 161}, {"id": 39438, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "縁山", "screen_name": "heriyama", "avatar_url": "https://pbs.twimg.com/profile_images/1182693104370868226/-Raw37RL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/27283987/1715684068/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 32}, {"id": 191653, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "おいまんじ", "screen_name": "oimanji", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Feb3d5ade-cb81-486e-a7c0-ee056047db21.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/e8470dd3-1823-4864-b041-2e1f665d72b3.png", "appeal_receivable": true, "popular_creator_rank": 33, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "skil