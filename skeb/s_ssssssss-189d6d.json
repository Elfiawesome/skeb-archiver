合っていればそれでOKです\n\n【使用用途】\n・個人鑑賞(SNSのアイコン等に使用する可能性あり)\n・「印刷してお届け」機能等を利用した個人鑑賞目的でのグッズ作成\n\nhttps://drive.google.com/drive/folders/1X2hscVNNR2oJgVrkyFu3kutUUwOvur1i", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@s_ssssssss/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3962940, "client_id": 3198246, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98a06fa8/uploads/origins/e4eed947-45cd-4724-b0d4-ffc32b6ba005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e26be25985af5b1509a26952bd46a20", "srcset": "https://si.imgix.net/98a06fa8/uploads/origins/e4eed947-45cd-4724-b0d4-ffc32b6ba005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e26be25985af5b1509a26952bd46a20, https://si.imgix.net/98a06fa8/uploads/origins/e4eed947-45cd-4724-b0d4-ffc32b6ba005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd5d6e34bd7445276b8a193d264a28ff 2x, https://si.imgix.net/98a06fa8/uploads/origins/e4eed947-45cd-4724-b0d4-ffc32b6ba005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c034c73c5d8e1950e09c8de478d70a5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98a06fa8/uploads/origins/e4eed947-45cd-4724-b0d4-ffc32b6ba005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f38331bac1c9f849727e849883f59fe", "srcset": "https://si.imgix.net/98a06fa8/uploads/origins/e4eed947-45cd-4724-b0d4-ffc32b6ba005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f38331bac1c9f849727e849883f59fe, https://si.imgix.net/98a06fa8/uploads/origins/e4eed947-45cd-4724-b0d4-ffc32b6ba005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc0a40df5974bbd8dd4c94062a72434b 2x, https://si.imgix.net/98a0