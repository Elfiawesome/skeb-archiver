ズ作成\n\nhttps://drive.google.com/drive/folders/1H6Tvg5NH1uEy3DdMwdSS19uD98UzoV5i", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@s_ssssssss/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3962940, "client_id": 1286098, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9380683/uploads/origins/5288d026-d6b0-44ff-b9f3-f27b4c7facc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=555947bd896925986c6a649fd4d67287", "srcset": "https://si.imgix.net/f9380683/uploads/origins/5288d026-d6b0-44ff-b9f3-f27b4c7facc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=555947bd896925986c6a649fd4d67287, https://si.imgix.net/f9380683/uploads/origins/5288d026-d6b0-44ff-b9f3-f27b4c7facc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19d97e2d4969f7969759027f0e7d739f 2x, https://si.imgix.net/f9380683/uploads/origins/5288d026-d6b0-44ff-b9f3-f27b4c7facc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4280a288624cad7a7f6e360f69811ba3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9380683/uploads/origins/5288d026-d6b0-44ff-b9f3-f27b4c7facc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20fa35a3622c84e8f70eef9a121889e3", "srcset": "https://si.imgix.net/f9380683/uploads/origins/5288d026-d6b0-44ff-b9f3-f27b4c7facc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20fa35a3622c84e8f70eef9a121889e3, https://si.imgix.net/f9380683/uploads/origins/5288d026-d6b0-44ff-b9f3-f27b4c7facc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63a4ac56c6282f4e2191c4bd0b2c05d3 2x, https://si.imgix.net/f9380683/uploads/origins/5288d026-d6b0-44ff-b9f3-f27b4c7facc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=001e630b026f29ebe1b44275de1b10bd 3x"}, "body": "はじめまして！サンプルとして投稿されていたイラストに惹かれたので依頼させていただきました🙇\n構図等おまかせで私のOCのイラストを描いていただけないでしょうか？NSFW設定にはしていませんが、お好みで流血表現等を加えていただいても構いません(その場合はお手数ですがNSFWに変更していただけますと幸いです)。\n以下にキャラクター設定やキャラデザの補足等を記載しておきますので参考にしていただければ……🙏\n(衣装などは自由にアレンジしていただいて構いませんので、好きなように描いてくださると嬉しいです！)\n\n【キャラのイメージ】\n・裏社会で怪しい仕事をしているお兄さん\n・命を奪うこともあるが不本意であり、内心では心を痛めている(頬にある涙タトゥーはその現れでもある)\n・根は優しい性格であり、できることなら汚い仕事から足を洗って田舎でのんびり暮らしたいと考えている\n・あまり人には見せないが、心労から毎晩悪夢にうなされている。寝不足も相まってお疲れ気味\n・威厳を持たせるためたまに煙管を持っていることもあるが、吸うことはできない(毎回咳をしながら頑張って火をつけている)\n\n【デザインの補足】\n・服やズボンで隠れている部分の毛色はすべて白色で、肩の毛色と同じ\n・鼻、舌(口内)、耳の内側、肉球が水色\n・ ズボンの左右、腰のあたりにはスリットがついていることもある(一部のイラストで腰のあたりに見える毛はこのスリットから出ています。キャラシでは省略されていますので描写するかはおまかせします)\n・ 涙のタトゥーの位置はイラストによって微妙に変わるので、大まかな位置が合っていればそれでOKです\n\n【使用用途】\n・個人鑑賞(SNSのアイコン等に使用する可能性あり)\n・「印刷してお届け」機能等を利用した個人鑑賞目的でのグッズ作成\n\nhttps://drive.google.com/drive/folders/1X2hscVNNR2oJgVrkyFu3kutUUwOvur1i", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@s_ssssssss/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3962940, "client_id": 3198246, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98a06fa8/uploads/origins/e4eed947-45cd-4724-b0d4-ffc32b6ba005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e26be25985af5b1509a26952bd46a20", "srcset": "https://si.imgix.net/98a06fa8/uploads/origins/e4eed947-45cd-4724-b0d4-ffc32b6ba005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e26be25985af5b1509a26952bd46a20, https://si.imgix.net/98a06fa8/uploads/origins/e4eed947-45cd-4724-b0d4-ffc32b6ba005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd5d6e34bd7445276b8a193d264a28ff 2x, https://si.imgix.net/98a06fa8/uploads/origins/e4eed947-45cd-4724-b0d4-ffc32b6ba005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&f