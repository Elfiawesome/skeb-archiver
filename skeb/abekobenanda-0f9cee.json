6f6-495a-9cfb-b00bce439659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ddd39cc1c4326b9b5ec1ed60f8fa7b67, https://si.imgix.net/88bae2e4/uploads/origins/17909861-56f6-495a-9cfb-b00bce439659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49efc3407093b69231aa54638252f8cf 2x, https://si.imgix.net/88bae2e4/uploads/origins/17909861-56f6-495a-9cfb-b00bce439659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b958a4ff1f4ef9b4156b0ea86e87f1e6 3x"}, "body": "お久しぶりです！\n前回は素敵なイラスト、ありがとうございました！\nその時に描いて頂いたうちの子（黒崎優奈）と愛車のNBロードスターに加え、ウマ娘よりカツラギエースも加わったイラストを描いて頂きたく今回新たにリクエストをお送りしました！\nうちの子に関する資料はこちらのURLに入っております(1枚目は顔を中心とした外見の参考資料、2枚目は簡単なプロフィール、3枚目は参考して欲しい服装の画像) https://photos.app.goo.gl/mUy7Hqpu8EUW8kz48  \n\nうちの子の愛車については今回新たに仕様変更した僕のクルマを参考に描いていただければと思います。https://photos.app.goo.gl/g3PKVSpHJmsWDcdj7\n\n構図に関してはエースと優奈は担当トレーナーと担当ウマ娘という関係で、休日に2人でドライブし休憩中にクルマの隣で仲良く接しているというイメージでお願いします！\n\nもし可能であれば優奈のみとエースのみの差分もお願いします！\n\nリクエストは以上になります\nよろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@abekobenanda/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3400882, "client_id": 656233, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f2547ca/uploads/origins/3f2f4299-338b-4a28-97e6-dde31933ef0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cf52015fca5b76a000c497846ec5568", "srcset": "https://si.imgix.net/2f2547ca/uploads/origins/3f2f4299-338b-4a28-97e6-dde31933ef0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cf52015fca5b76a000c497846ec5568, https://si.imgix.net/2f2547ca/uploads/origins/3f2f4299-338b-4a28-97e6-dde31933ef0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3d7c5ce782c9310945b0e8a2ec96ed2 2x, https://si.imgix.net/2f2547ca/uploads/origins/3f2f4299-338b-4a28-97e6-dde31933ef0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f79fc47a10d5c59c71cc5e12df3b996 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f2547ca/uploads/origins/3f2f4299-338b-4a28-97e6-dde31933ef0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bae180c6cda58297944c548790f7010", "srcset": "https://si.imgix.net/2f2547ca/uploads/origins/3f2f4299-338b-4a28-97e6-dde31933ef0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bae180c6cda58297944c548790f7010, https://si.imgix.net/2f2547ca/uploads/origins/3f2f4299-338b-4a28-97e6-dde31933ef0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe734133cc63c152d599c382b8ff9473 2x, https://si.imgix.net/2f2547ca/uploads/origins/3f2f4299-338b-4a28-97e6-dde31933ef0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d31fc723b9cc7bcb1f1f7829f6799013 3x"}, "body": "ごきげんよう、はじめまして。\n\nTwitterでダイアグノーシスのブルアカ生徒ｘクルマ絵を拝見して素敵と思い、ぜひ描いてほしいコンビがありましてリクエストをさせていただきたいです。\n\n描いて頂きたいのはブルアカの桐藤ナギサさんとアストンマーティンDB5の組み合わせです、クルマの運転席側に通常衣装のナギサを添える一枚をお願いしたいです。\n個人的にはアストマーティンは前の方が映えると思い、クルマは車首前向きでお願いします、真正面以外で角度や向きはお任せします。背景はいもつの絵のようにメーカー+モデル/モデル、またはお考えがあればはお任せします。クルマのボディカラーは某エージェントのヤツと同じくシルバーでお願いします。\n出来ればDB5を描いて頂きたいが、今までの絵を拝見してそう古いクルマはなく、もしDB5はお嫌なら同社のDBSでも大丈夫です、要求は上記と同じになります。\n\nやや面倒なリクエストであるかもしれませんが、ぜひご一考して頂ければ幸いです。\nよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@abekobenanda/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7aa069e7/uploads/origins/f36920e5-bfaf-4924-8aae-cc1942128d31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37d9fef5e0bf5e4cc0708354238779f7", "srcset":