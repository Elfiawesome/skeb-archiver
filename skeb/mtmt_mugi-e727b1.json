2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfee5bd9f8f1ffd03174fd51cca9d3d9 2x, https://si.imgix.net/c637daf9/uploads/origins/85e93d63-2732-4382-b7f0-dab7788ca2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e25acc46b8862a95ae89a33a6a9c781 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c637daf9/uploads/origins/85e93d63-2732-4382-b7f0-dab7788ca2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a535f96cd031932abfe102cfc5a6a42f", "srcset": "https://si.imgix.net/c637daf9/uploads/origins/85e93d63-2732-4382-b7f0-dab7788ca2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a535f96cd031932abfe102cfc5a6a42f, https://si.imgix.net/c637daf9/uploads/origins/85e93d63-2732-4382-b7f0-dab7788ca2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c9fa10b2164ef98639291a74e82d71d9 2x, https://si.imgix.net/c637daf9/uploads/origins/85e93d63-2732-4382-b7f0-dab7788ca2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba783cae5726c298e0a282036251e4f7 3x"}, "body": "先生、こんにちは！またお願いがあります。今回は私のオリジナルキャラクター、セレスティンについてです。\n\nキャラクター\n彼女は銀河間列車に乗る天才的な医師兼医療担当で、火と水を操る能力を持っています。非常に利他的で、困っている人がいれば迷わず助けようとします。 優しさと自信に満ち溢れた、気品のあるキャラクターです。手から火と水を生み出すことができ、その二つの元素を組み合わせて新たな元素を作り出し、治療を行います。\n\nぜひ、気品のある雰囲気で描いていただけると嬉しいです。完成したイラストは、今後の依頼の参考資料として使わせていただくかもしれません。\n\nこのリクエストでよろしいでしょうか。お時間を割いてご検討いただき、ありがとうございます！\n\nhttps://imgur.com/a/7KGq8fe", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mtmt_mugi/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3375428, "client_id": 32418, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa6089fb/uploads/origins/1ab84dca-db7d-409d-8be8-f8f884d6918e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80f325cff62cb2dd1b60060a0822b4d0", "srcset": "https://si.imgix.net/fa6089fb/uploads/origins/1ab84dca-db7d-409d-8be8-f8f884d6918e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80f325cff62cb2dd1b60060a0822b4d0, https://si.imgix.net/fa6089fb/uploads/origins/1ab84dca-db7d-409d-8be8-f8f884d6918e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0274fd8c46bc856051520d55be0a0fa 2x, https://si.imgix.net/fa6089fb/uploads/origins/1ab84dca-db7d-409d-8be8-f8f884d6918e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18316572e9b64002d8075d0d137b836b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa6089fb/uploads/origins/1ab84dca-db7d-409d-8be8-f8f884d6918e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed59756fa5607e94068d94d5d2976dc0", "srcset": "https://si.imgix.net/fa6089fb/uploads/origins/1ab84dca-db7d-409d-8be8-f8f884d6918e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed59756fa5607e94068d94d5d2976dc0, https://si.imgix.net/fa6089fb/uploads/origins/1ab84dca-db7d-409d-8be8-f8f884d6918e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e9b64fcdf06bd705193803713af5a4b 2x, https://si.imgix.net/fa6089fb/uploads/origins/1ab84dca-db7d-409d-8be8-f8f884d6918e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=10bb1520627170cae1273065bf52855a 3x"}, "body": "初めまして！この度、もちむぎさんにイラストをお願いさせて頂きたく思います！\n今回描いてほしいのはアークナイツの医療アーミヤです。構図としましては、飛行機に乗って手紙を読んでいるような構図にしてください。雰囲気としては、夜間、飛行機の中で座席に座って優しい表情で招待状と手紙を読んでいるような様子にしてください。夜間なので、機内は暗く、読書灯を付けて読んでいる様子にしてください。\n飛行機の内装の指定ですが。医療アーミヤはビジネスクラスの席に乗っているという設定で資料のような個室タイプのところの席を利用している感じにしてください。実際に使っている様子は資料URLをご覧ください。\n（正面から見た座席はこんな感じです。 https://businesstravelerusa.com/news/polaris-business-class-seat-now-offered-on-more-united-flights/ ）\n（航空会社の資料も貼っておきます。 https://www.his-j.com/kaigai/business/carrier/ua.html?region=kanto ）\n服装については、医療アーミヤがいつも着ている黒いロドスのコートは脱いで、下に着ているワンピースだけにしてください。\n細かいところですが、座席の3点式シートベルトとかの座席のディテールも可能な限り描いていただければ嬉しいです。（ただし、難しければ簡略化したりしてもかまいません。もちむぎさんの判断で結構です。）\n依頼内容や金額に問題がありましたら、差し戻していただいても構いません。\n何卒、ご検討のほどよろしくお願いします。\n\nhttps://liveandletsfly.com/united-polaris-business-class-family-review/", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mtmt_mugi/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3375428, "client_id": 3360805, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da620b06/uploads/origins/e1b4c6fa-aeba-41f8-9740-c1acda1da69f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=853983b218c30c4c01920c4adc4c0431", "srcset": "https://si.imgix.net/da620b06/uploads/origins/e1b4c6fa-aeba-41f8-9740-c1acda1da69f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=853983b218c30c4c01920c4adc4c0431, https://si.imgix.net/da620b06/uploads/origins/e1b4c6fa-aeba-41f8-9740-c1acda1da69f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebf0e0900da710a2329363209daa5166 2x, https://si.imgix.net/da620b06/uploads/origins/e1b4c6fa-aeba-41f8-9740-c1acda1da69f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a557442390d3463db2e744a6e34fc073 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da620b06/uploads/origins/e1b4c6fa-aeba-41f8-9740-c1acda1da69f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a457bc16328d46aa59f9da2c0370990b", "srcset": "https://si.imgix.net/da620b06/uploads/origins/e1b4c6fa-aeba-41f8-9740-c1acda1da69f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a457bc16328d46aa59f9da2c0370990b, https://si.imgix.net/da620b06/uploads/origins/e1b4c6fa-aeba-41f8-9740-c1acda1da69f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=142dc13cc368fbf0f22dc84423f3cc9f 2x, https://si.imgix.net/da620b06/uploads/origins/e1b4c6fa-aeba-41f8-9740-c1acda1da69f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=20d50a04dc833fd7c35d816024dfb1a8 3x"}, "body": "もちむぎさんこんばんは！いつも目の保養になるイラストを楽しく拝見しております。\n当方のOCである『ライア』の設定画をお願いしたくメッセージをさせていただきました。 ライアのざっくりとした外見や衣装は以下のURLをご確認下さい。\n https://drive.google.com/file/d/18dRsEAewmKKRvd4u35IJlOA0mPtZ-nlw/view?usp=drivesdk \n\n設定は以下の通りです。 \n性別・女性\n身長・165cm\n年齢・20歳\n種族・フェリーン(モチーフ動物:ホワイトタイガー)\n外見・銀髪のウルフヘアに金の瞳(やや吊り目)\n感染者の有無・非感染者\n細かな設定・人を探してサルゴンに踏み入れたところ計略により本人の意思関係なく、サンドソルジャーと主従関係を結ぶことになる。情報収集に奔走し主の前で感情を出すことは一切ない。 サンドソルジャーの復讐の手伝いをする事で間接的に他者の命を奪っている自身を嫌悪している。\nサンドソルジャーのことは心底嫌悪しているが、相手の圧に負け肉体関係を結んでしまったことで心身で相反する感情が芽生えそれが変化しつつあることに大きく困惑している。\n補足等・服装は自由に加筆・アレンジしていただいて構いません。サンドソルジャーに付き従っている設定なので色味やデザインなどを寄せたり類似箇所があると嬉しいです。\n使用用途・SNSへの投稿、後に出す予定の個人本に設定画としての使用を考えています。 \n\n細々と書いてしまいましたが、ご検討の程よろしくお願い致します。\n\nhttps://drive.google.com/file/d/18dRsEAewmKKRvd4u35IJlOA0mPtZ-nlw/view?usp=drivesdk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mtmt_mugi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3375428, "client_id": 3662829, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5039ec58/uploads/origins/a61de654-86fc-4b68-b04d-51d7f70341d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e577c2b2a9cdbad6c515599bbdcc9ebb", "srcset": "https://si.imgix.net/5039ec58/uploads/origins/a61de654-86fc-4b68-b04d-51d7f70341d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e577c2b2a9cdbad6c515599bbdcc9ebb, https://si.imgix.net/5039ec58/uploads/origins/a61de654-86fc-4b6