イメージです。\n・もう一人の女の子(ダンスを教えられている子)は双海真美を想定していますが、もし牛乳左衛門さんの描きたいキャラが他にいる場合はそのキャラでも構いません(765プロ以外でも可)。\n・響が相手の子を指導しているセリフを描いてください。\n・腋毛の要素もあると嬉しいです。\n\nご検討いただけると幸いです。\nよろしくお願いします。\n\nhttps://l4cat.fanbox.cc/posts/932380", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@L4Cat/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 27420, "client_id": 757040, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3136bfcc/uploads/origins/9f9a318f-0d87-4d7d-ac6b-03ddcbe5dc8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=060ee5abf6d168908e3e99d4256fe301", "srcset": "https://si.imgix.net/3136bfcc/uploads/origins/9f9a318f-0d87-4d7d-ac6b-03ddcbe5dc8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=060ee5abf6d168908e3e99d4256fe301, https://si.imgix.net/3136bfcc/uploads/origins/9f9a318f-0d87-4d7d-ac6b-03ddcbe5dc8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=769ef4195a7b4877f3c2a56d6a136dcf 2x, https://si.imgix.net/3136bfcc/uploads/origins/9f9a318f-0d87-4d7d-ac6b-03ddcbe5dc8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58900a23d09d32439473ce804ccc61c3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3136bfcc/uploads/origins/9f9a318f-0d87-4d7d-ac6b-03ddcbe5dc8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc2f4dde2715e63d132662542305f28a", "srcset": "https://si.imgix.net/3136bfcc/uploads/origins/9f9a318f-0d87-4d7d-ac6b-03ddcbe5dc8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc2f4dde2715e63d132662542305f28a, https://si.imgix.net/3136bfcc/uploads/origins/9f9a318f-0d87-4d7d-ac6b-03ddcbe5dc8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3c4637f0610fbb97