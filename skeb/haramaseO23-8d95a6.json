ix.net/a6a568f9/uploads/origins/4a7117e4-470f-4723-908b-fea1831b954e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bf1ea586d7b0eee682778cd9233c28f 2x, https://si.imgix.net/a6a568f9/uploads/origins/4a7117e4-470f-4723-908b-fea1831b954e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74c3dbd6baa43b275065265a5034ea89 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6a568f9/uploads/origins/4a7117e4-470f-4723-908b-fea1831b954e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27edcf6cb85a164b73ed78b8a4d3abfb", "srcset": "https://si.imgix.net/a6a568f9/uploads/origins/4a7117e4-470f-4723-908b-fea1831b954e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27edcf6cb85a164b73ed78b8a4d3abfb, https://si.imgix.net/a6a568f9/uploads/origins/4a7117e4-470f-4723-908b-fea1831b954e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6322d8fc6076516691263a094dc90d90 2x, https://si.imgix.net/a6a568f9/uploads/origins/4a7117e4-470f-4723-908b-fea1831b954e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b9871a8da774c202fa85ae0bab0c7bbd 3x"}, "body": "はじめまして。いつも楽しみに拝見させていただいております。\nToLoveるの結城美柑をリクエストさせて下さい。\n\n美柑と校長がバックor立ちバックでHしている場面をお願いします。\n\n●シチュエーション\n・バックであれば「https://www.pixiv.net/artworks/106584953」のようにお尻を突き上げた感じの姿勢、立ちバックであれば「https://www.pixiv.net/artworks/102308790」のように手をついて前屈みな感じの姿勢\n・美柑の衣装はミニスカートな私服or制服\n・美柑はちょっとイヤイヤな感じだがなんだかんだで気持ちよくなってしまっている状態\n\n●以下のような流れで差分\n・事前シーン→校長に命じられてバックor立ちバックの姿勢で待機している（校長の描写無し）\n・前戯シーン→校長が美柑の後ろでしゃがんで股ぐらに顔を埋めてクンニ（美柑はパンツを履いたままで、パンツの上から舐められている）\n・本番シーン→挿入して激しくパンパン突きまくってそのまま中出し（美柑はパンツ脱いで片足に引っかかっている状態）\n・事後シーン→美柑はイカされてトロけた状態、溢れた精液が滴り落ちている（校長の描写無し）\n\nもしよろしければ、お引き受け下さると幸いです。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haramaseO23/w