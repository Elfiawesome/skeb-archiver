ix.net/ef3fc6bc/uploads/origins/f00b8176-df3c-4efe-8b16-576577a46ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef8a0553e518477b5783e5b39eadac71 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef3fc6bc/uploads/origins/f00b8176-df3c-4efe-8b16-576577a46ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50d120abf8d8955ece70f775d3b7b9b5", "srcset": "https://si.imgix.net/ef3fc6bc/uploads/origins/f00b8176-df3c-4efe-8b16-576577a46ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50d120abf8d8955ece70f775d3b7b9b5, https://si.imgix.net/ef3fc6bc/uploads/origins/f00b8176-df3c-4efe-8b16-576577a46ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c25410704cca516344fa9e8d362fe839 2x, https://si.imgix.net/ef3fc6bc/uploads/origins/f00b8176-df3c-4efe-8b16-576577a46ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=40acc8fb1ca4197e0d64638457c261c9 3x"}, "body": "86🥛様\n\nはじめまして。個人でVtuber活動をしておりますねむりむみと申します。\n新着作品にて86🥛様の作品を拝見し、透明感のあるイラストに惹かれました。\nわたし自身を描いていただきたいなと思いリクエスト送信させていただきます。\n\n■使用用途\n・TwitchやX(旧Twitter)等SNSでの使用\n・ネットプリントでの使用\n・グッズへの利用\n等、Vtuber活動内で使用させていただきたいです。\n◇利用不可な用途がございましたら納品いただく際に別レイヤーにて記載いただけますと幸いです。\n◇場合によってトリミング等の加工をさせていただく場合がございます。\n\n■イラストの内容\n・86🥛様がX（旧Twitter）にて投稿されているイラストの衣装デザインがとても好きなので、衣装は86🥛様におまかせしたいです。\n（https://twitter.com/paru_0_palu/status/1714582214426738992/photo/1）\n（https://twitter.com/paru_0_palu/status/1738858400560386050/photo/1）\n・valorantというfpsゲームをすることが多いため、可能であれば参考資料内のような銃を持った構図ですとうれしいです。\n・髪型はおまかせいたします（参考資料内の髪型にしていただいても、描きやすい髪型で描いていただいても問題ございません）\n・髪の毛や頭は見切れないように描いていただけますとうれしいです。\n・腰上が入る形であれば、全身であってもそうでなくてもかまいません。\n・目の色は、ベースの色は同じですが、左右で目の下の部分がピンクとブルーで異なります（三面図参照いただければと存じます）\n・可能であれば、目を閉じている差分をいただけますとうれしいです。\n\n■納品形式について\n・PSDファイルでの納品、もしくはPNGファイルで背景や文字と分けたイラストのみのデータもいただけますと大変助かります…！\n\n■参考資料（モデル）\nhttps://drive.google.com/drive/u/2/folders/1xBk-nwdcolIO-MQazfE7Gw5APQXv7PIF\n\n■参考資料（銃）\nhttps://drive.google.com/drive/folders/1NLI6rf4Zj4iLgMwKVWrzAzyPXYrEbE0-?usp=sharing\n\n要望が多くなってしまい申し訳ございません。\nご検討いただけますと幸いです。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@paru_0_palu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3011124, "client_id": 1523235, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21ac06de/uploads/origins/b0d97583-e8e3-4b89-8d4b-1602c296ea97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dee385fd2da6d8290d209ed4f447a779", "srcset": "https://si.imgix.net/21ac06de/uploads/origins/b0d97583-e8e3-4b89-8d4b-1602c296ea97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dee385fd2da6d8290d209ed4f447a779, https://si.imgix.net/21ac06de/uploads/origins/b0d97583-e8e3-4b89-8d4b-1602c296ea97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=caab92ace40350e4d9ada893613fabfd 2x, https://si.imgix.net/21ac06de/uploads/origins/b0d97583-e8e3-4b89-8d4b-1602c296ea97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35177bc438dd1eff773a3b477977651d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21ac06de/uploads/origins/b0d97583-e8e3-4b89-8d4b-1602c296ea97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2c49b4f772ae9b96fae42dd38ae03fd", "srcset": "https://si.imgix.net/21ac06de/uploads/origins/b0d97583-e8e3-4b89-8d4b-1602c296ea97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2c49b4f772ae9b96fae42dd38ae03fd, https://si.imgix.net/21ac06de/uploads/origins/b0d97583-e8e3-4b89-8d4b-1602c296ea97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200