護している立場にあります\n\n着物の方少し複雑になっていますので省略大いに構いません、ミノカサゴより鱗柄で鰭に見立ててる柄となっています。\n\nhttps://drive.google.com/drive/folders/1CnE0Zv8f9g1KnNCxobhM5L2QF9FFSWIg\n\nhttps://drive.google.com/drive/folders/1tBdTBAAj3A8vVmh-WoLiTf8SOpC9uAMX", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@zaruzaruisland/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3890150, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c75c8c6/uploads/origins/c6047512-7132-4a61-b6c4-ee1860350f5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bba0af07f919843c1bf32ba838bb43e", "srcset": "https://si.imgix.net/6c75c8c6/uploads/origins/c6047512-7132-4a61-b6c4-ee1860350f5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bba0af07f919843c1bf32ba838bb43e, https://si.imgix.net/6c75c8c6/uploads/origins/c6047512-7132-4a61-b6c4-ee1860350f5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d45471c9b872666cf51b51e40bb6e15d 2x, https://si.imgix.net/6c75c8c6/uploads/origins/c6047512-7132-4a61-b6c4-ee1860350f5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3326c74bb37f95ec36cf562ad6f93244 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c75c8c6/uploads/origins/c6047512-7132-4a61-b6c4-ee1860350f5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a1036bf79fb5c11ff685d9ef6b277d4", "srcset": "https://si.imgix.net/6c75c8c6/uploads/origins/c6047512-7132-4a61-b6c4-ee1860350f5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a1036bf79fb5c11ff685d9ef6b277d4, https://si.imgix.net/6c75c8c6/uploads/origins/c6047512-7132-4a61-b6c4-ee1860350f5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cd013005db785426b