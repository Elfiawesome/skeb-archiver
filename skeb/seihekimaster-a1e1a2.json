紅を向け、\n全身にしっかりと念入りに、特に顔面、次に股間には重点的に\n口紅を塗りこんでいく\n\nこうして、男性は全身余すところなく口紅を付けられてしまう\nといった感じでよろしくお願いします。\n\nhttps://www.pixiv.net/artworks/105594357", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@seihekimaster/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 937204, "client_id": 570408, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0b0f8d5/uploads/origins/ac735fe4-db10-4720-b941-385f5c6b5b66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94d0259482134ac365f7764173d3a42b", "srcset": "https://si.imgix.net/c0b0f8d5/uploads/origins/ac735fe4-db10-4720-b941-385f5c6b5b66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94d0259482134ac365f7764173d3a42b, https://si.imgix.net/c0b0f8d5/uploads/origins/ac735fe4-db10-4720-b941-385f5c6b5b66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df25e551f6d24cd22e7347bcfe73af51 2x, https://si.imgix.net/c0b0f8d5/uploads/origins/ac735fe4-db10-4720-b941-385f5c6b5b66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e535866f43637aadbf925d1fb52cba8b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c0b0f8d5/uploads/origins/ac735fe4-db10-4720-b941-385f5c6b5b66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49ab90628d21a363c69ad787b095a985", "srcset": "https://si.imgix.net/c0b0f8d5/uploads/origins/ac735fe4-db10-4720-b941-385f5c6b5b66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49ab90628d21a363c69ad787b095a985, https://si.imgix.net/c0b0f8d5/uploads/origins/ac735fe4-db10-4720-b941-385f5c6b5b66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=90928206caf8300a396a12850a0ffa90 2x, https://si.imgix.net/c0b0f8d5/uploads/origins/ac735fe4-db10-4720-b941-385f5c6b5b66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ff32e412ec2a50664dd591dcb1f267f5 3x"}, "body": "はじめまして、セイヘキマスター様の絵柄やシチュ(特に顔舐めや鼻舐めなどでの臭い責め系)が好みでいつも楽しみにしてます！よろしければリクエストさせて頂きたいです！\n\n依頼内容→拷問官のお姉さんがスパイ容疑の小柄な男(冤罪)に嗅覚が10倍になる薬を飲ませた後、口臭責めや鼻舐め、顔舐めで拷問するシチュの漫画\n\n男は動けないように拘束されて、口は粘着テープで塞がれていて鼻でしか息ができないような状態、口臭責めや鼻舐めなどをされて臭さと気持ち悪さに苦しめられている感じにお願いします。\n\n口臭、舌苔フェチなので口の臭さや舌の汚さを強調してもらえると嬉しいです。\n\n拷問官のお姉さんの特徴→黒髪、高身長(180cm以上)、サディスト、口が臭い、舌には舌苔が大量に付着、髪型や服装はおまかせでお願いします。\n\n男の特徴→黒髪、中性的な顔立ち、低身長、髪型や服装はおまかせでお願いします。\n\n大丈夫そうでしたら検討をお願いします！", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@seihekimaster/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 937204, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d67e868c/uploads/origins/7c31abbf-49bc-4537-8066-5f1c449c52e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3048e01e6bd74239068985cacdce6db", "srcset": "https://si.imgix.net/d67e868c/uploads/origins/7c31abbf-49bc-4537-8066-5f1c449c52e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3048e01e6bd74239068985cacdce6db, https://si.imgix.net/d67e868c/uploads/origins/7c31abbf-49bc-4537-8066-5f1c449c52e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af3197235b5f4c1fda2ebd00d0195437 2x, https://si.imgix.net/d67e868c/uploads/origins/7c31abbf-49bc-4537-8066-5f1c449c52e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ea97cb55a514627c5be0d7bee5f7cdc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d67e868c/uploads/origins/7c31abbf-49bc-4537-8066-5f1c449c52e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=129bd2eba59a979029a8203d4b092839", "srcset": "https://si.imgi