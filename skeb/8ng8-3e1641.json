rop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e0f502f9a2aff07227638591abbcd70", "srcset": "https://si.imgix.net/34e825e6/uploads/origins/8babdc84-e898-43c6-bcdd-d9488a8327dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e0f502f9a2aff07227638591abbcd70, https://si.imgix.net/34e825e6/uploads/origins/8babdc84-e898-43c6-bcdd-d9488a8327dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c238884ffa2a530af8f70447c93794f 2x, https://si.imgix.net/34e825e6/uploads/origins/8babdc84-e898-43c6-bcdd-d9488a8327dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6cb0b1c5a320dc03e92cec5fdbb4cf54 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 2412549, "nc": 177}, {"path": "/@8ng8/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2412549, "client_id": 560987, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d70f869/uploads/origins/4a933b5b-be90-490a-8019-753625294cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45d5dbfe2eb34ee0b1af2ccebcf9dca7", "srcset": "https://si.imgix.net/4d70f869/uploads/origins/4a933b5b-be90-490a-8019-753625294cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45d5dbfe2eb34ee0b1af2ccebcf9dca7, https://si.imgix.net/4d70f869/uploads/origins/4a933b5b-be90-490a-8019-753625294cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24cc001b2e85c9eb81b718de42f75174 2x, https://si.imgix.net/4d70f869/uploads/origins/4a933b5b-be90-490a-8019-753625294cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bbc3709fa60493efae7efc7fbe4852f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d70f869/uploads/origins/4a933b5b-be90-490a-8019-753625294cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1b1b1668a79d2ff6569992c63cccc3b", "srcset": "https://si.imgix.net/4d70f869/uploads/origins/4a933b5b-be90-490a-8019-753625294cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1b1b1668a79d2ff6569992c63cccc3b, https://si.imgix.net/4d70f869/uploads/origins/4a933b5b-be90-490a-8019-753625294cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e65b4efd5a817976ccb533ffb3a31b66 2x, https://si.imgix.net/4d70f869/uploads/origins/4a933b5b-be90-490a-8019-753625294cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=336fdcdd333bdb2a441d719127689627 3x"}, "body": "前回素敵なコミックありがとうございました。\n\n今回は続きを描いて欲しいです。\n\n北乃を罵倒していた子、笈田を恥ずかしがっていた子として書きます(間違っていたらすいません)。\n\n\n話の流れ\n\n星也の勃起を見て北乃が反省してないと指摘する。それに対して星也が言い返す。\n\n笈田が真剣な表情で星也に本当に反省しているか問う。\n\n続けて笈田がいくつも問いかける。女湯に突然男の人が現れたことによって女の子が受けるショック、銭湯にトラウマを持つ可能性、一生に一度の修学旅行の思い出が台無しになる可能性等を考えたことがあるか。\n\n笈田の真剣な問いかけに星也は自分のことしか頭に無く女の子の気持ちを考えてなかったことに気が付く。泣いている女の子のイメージが浮かび、やってしまったの重大さに後悔し自分を卑下する。\n\n星也は涙を流しながら2人に向かって丁寧語で謝罪し、俯いて本当に子どもだった、こんな格好より人の気持ちを考えられなかったことのほうが恥ずかしいと述べる。\n\n北乃は泣いて謝って済む話じゃないと言った後、大きく溜息をつき大甘だけど私はお尻ペンペン(お仕置きの意味)で許すと言い睾丸にデコピンを何度も繰り返す(笈田は自分の分もお願いする)。\n\n北乃は二度としないように注意した後一言罵倒。ぐったりとした星也は勃起が治まっており一言お礼を言う。\n\n\n台詞は自由に。俯いて反省の意を述べる星也は全身見切れずに描いて欲しい(前回5ページの左下のコマのイメージ)。デコピンのシーンは星也の斜め後方からのアングル(ちんちんが見えない)で拘束台の台の部分のみ(手首、両足の拘束は見える)を透かしたのが欲しい。\n\n前回予想を遙かに上回るページ数だったので金額に対して減らしてもらっても全く問題ありません。\n\n拙い文章で申し訳ありませんがご検討よろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@8ng8/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c4b53668/uploads/origins/2cf2d3f0-7402-4ad9-a867-c8795b6bef82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=afddce8c2442e9819ee0bb4009ff6fc1", "srcset": "https://si.imgix.net/c4b53668/uploads/origins/2cf2d3f0-7402-4ad9-a867-c8795b6bef82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=afddce8c2442e9819ee0bb4009ff6fc1, https://si.imgix.net/c4b53668/uploads/origins/2cf2d3f0-7402-4ad9-a867-c8795b6bef82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4bae7bd2016082f08eed17d3b7a7c8e8 2x, https://si.imgix.net/c4b53668/uploads/origins/2cf2d3f0-7402-4ad9-a867-c8795b6bef82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34dc98c1a1cd235546c82c4a4d8741c8 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 2412549, "nc": 177}, {"path": "/@8ng8/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2412549, "client_id": 560987, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/215bdaee/uploads/origins/b60ce9e5-be11-4b32-ada1-3bc7f7350380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1d95a2e2e7cd4608754471e3c87643a", "srcset": "https://si.imgix.net/215bdaee/uploads/origins/b60ce9e5-be11-4b32-ada1-3bc7f7350380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1d95a2e2e7cd4608754471e3c87643a, https://si.imgix.net/215bdaee/uploads/origins/b60ce9e5-be11-4b32-ada1-3bc7f7350380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e0cbaa5174792a38acb3a19ce0a715d 2x, https://si.imgix.net/215bdaee/uploads/origins/b60ce9e5-be11-4b32-ada1-3bc7f7350380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=628b3868dadec3fd7648701b30f389c0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/215bdaee/uploads/origins/b60ce9e5-be11-4b32-ada1-3bc7f7350380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12f825e3dd6312c78f9f8fbe5a43b97a", "srcset": "https://si.imgix.net/215bdaee/uploads/origins/b60ce9e5-be11-4b32-ada1-3bc7f7350380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12f825e3dd6312c78f9f8fbe5a43b97a, https://si.imgix.net/215bdaee/uploads/origins/b60ce9e5-be11-4b32-ada1-3bc7f7350380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=70655ebf885ea5bbf2171183b3f255d7 2x, https://si.imgix.net/215bdaee/uploads/origins/b60ce9e5-be11-4b32-ada1-3bc7f7350380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1c2f8e5ee1d359dd9d74cd93be706b7e 3x"}, "body": "初めまして素敵なイラスト楽しませてもらっています。\n\n温泉ロケの漫画がかなり好みでそれに近い要素のある内容の漫画のリクエストになります。\n\n物語\n舞台は高校の1年生の修学旅行の旅館。一時的に性転換できる能力(心は男のまま)を使える男の子がクラスメイトの女の子の裸目当てにその能力を使って堂々と女湯に入る。しかし女湯で能力が切れて男に戻ってしまい女の先生に捕まる。男の子は罰として旅館のロビーで裸のまま拘束され晒し者にされる。\n\n男の子は身長やや低めで中性的(女の子寄り)で可愛らしい感じ。ちんちんのサイズは小さい。女の子二人と女の先生(長身)の容姿はおまかせ。\n\n欲しいシーン\n・女湯で能力が切れて男に戻った瞬間の男の子。タオルを巻いて胸と股間が隠れている。\n\n・男の子が女の先生にタオルを剥がされ羽交い絞めにされ片足で股を少し持ち上げられる。男の子は赤面しパニックになりながら謝罪と自身の解放の言葉を叫ぶ。女の先生は厳しい表情で間違いなく男であることを確認し罰を与えること言い渡す。\n\n・女の子の一人は巻いているタオルをしっかり掴んで男の子の顔を睨みつける。もう一人はタオルを巻いた上から胸と股間を手で隠して恥ずかしそうな表情。二人とも赤面。台詞はおまかせ(無しでも可)。二人の正面からの図。\n\n・男の子は旅館のロビーで全裸で拘束台にちんぐり返しの状態で拘束される。体は仰向けで少し斜め、両手は手首合わせて縛られ万歳の形、両足は膝が脇の横にくるように両太股を台に縛って固定(膝から下はフリー)。涙目になりながら恥辱に耐える。ストレートに何度も恥ずかしい、皆に見られている等の内容の心情。\n\n・その様をさっきの女の子二人が通りすがりに目にする。服装はそのまま寝れる私服。睨んでいた女の子は呆れた表情で男の子がどこでどんな姿をしているかを言葉にしてその格好悪さを罵倒する。もう一人の女の子は赤面し顔を手で隠しながらも男の子の股間を見てしまっている。女湯と同じく二人の正面から。\n\n全身見切れずに描いて欲しいのは女の先生に捕まっている男の子、拘束されてる男の子、女湯とロビーの女の子二人。\n\n女湯には女の子二人以外もたくさんいる設定で輪郭(ほぼ丸で可)だけで描いてもらっても構いませんし描きにくければいなくてもいいです。背景もざっくりでいいです。\n\n男女の状態の対比が好きなのでそこを意識してもらえれば嬉しいです。\n\n拙い文章で申し訳ありませんがご検討お願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@8ng8/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2412549, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e07ae6db/uploads/origins/10130914-0268-41f6-a747-f7b48f82f5c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d41f2fa03918006d03adfa6813b4ec6a", "srcset": "https://si.imgix.net/e07ae6db/uploads/origins/10130914-0268-41f6-a747-f7b48f82f5c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d41f2fa03918006d03adfa6813b4ec6a, https://si.imgix.net/e07ae6db/uploads/origins/10130914-0268-41f6-a747-f7b48f82f5c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2098423d8e551ebcc673883d1d6ca3ba 2x, https://si.imgix.net/e07ae6db/uploads/origins/10130914-0268-41f6-a747-f7b48f82f5c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2dab19540cf935215ebf4983907ed78c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e07ae6db/uploads/origins/10130914-0268-41f6-a747-f7b48f82f5c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ace7352f59627048487a56b4b4a7eb2d", "srcset": "https://si.imgix.net/e07ae6db/uploads/origins/10130914-0268-41f6-a747-f7b48f82f5c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ace7352f59627048487a56b4b4a7eb2d, https://si.imgix.net/e07ae6db/uploads/origins/10130914-0268-41f6-a747-f7b48f82f5c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&