=200&h=200&blur=200&s=83e26a3cfe8201f3f1633dafc68674de 2x, https://si.imgix.net/417affdb/uploads/origins/7d2eb6de-9f5f-4ee5-8d15-b4998c0c8981?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ae1d052321c6c895395f0143ff8507db 3x"}, "body": "はじめまして、新着クリエイター一覧から過去作品に惹かれてきました\nもしよろしければリクエストを受けていただけないでしょうか\nモデルはサービス終了したネットゲームのマイキャラクターになります\nお淑やかな性格でむっつりスケベ、胸は控えめのスレンダーな子です\n\n・希望する内容を箇条書きで（共通部分）\n恋人とのいちゃらぶセックス\n「依頼衣装」というファイルの衣装を着せてあげてください\n（もしくは「その他衣装」から飛べるフォルダの中にお好みの衣装があれば、そちらを着せてあげてください）\n犬耳を着け、尻尾付プラグをお尻に挿入した状態（付け根のプラグが見えないような、尻尾だけお尻から伸びているような形状）\nもし可能であれば尻尾は無しでアナルセックス（案2）\nとろとろで気持ちよさそうな表情\n相手の描写は無くても構いません\nゲーム内モデルでは胸が大きいですが、控えめにアレンジをお願いします（Bカップ程度～つるぺたまでお好みで）\n服は着衣～半脱ぎあたりが好みですが、お任せします（細かい装飾などは省略やアレンジしていただいて構いません）\n顔が見える内容で、その他構図などは描きたいものでお任せします\n\n・案1\n犬になりきりながら気持ちよくなっているイメージ\n\n・案2\nアナルセックスで、おしりでとても気持ちよくなっているイメージ\n\n上記のような内容で喘ぎ声、セリフがあると嬉しいです\n\nご検討をお願いします\n\nhttps://drive.google.com/drive/folders/1gXZVDfcsl66QZ8VxPLKFXERqQXKioNsJ", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 19311, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "tk8d32（リクエスト再開中）", "screen_name": "tk8d32", "avatar_url": "https://pbs.twimg.com/profile_images/1419302965215567873/8BOp_mru.jpg", "header_url": "https://pbs.twimg.com/profile_banners/92885318/1759765390/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "nc": 160}, {"id": 34100, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "あるばー", "screen_name": "alber0625", "avatar_url": "https://pbs.twimg.com/profile_images/852824143548383232/1_Z1nZgm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1692493052/16318