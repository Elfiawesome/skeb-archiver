f&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff127bc244afd0ea56ee64c78c98483c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82de3b52/uploads/origins/738ec593-87da-4b83-88af-8ad1d5136cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50aabe01893718a30512a6383b645fae", "srcset": "https://si.imgix.net/82de3b52/uploads/origins/738ec593-87da-4b83-88af-8ad1d5136cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50aabe01893718a30512a6383b645fae, https://si.imgix.net/82de3b52/uploads/origins/738ec593-87da-4b83-88af-8ad1d5136cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b6ce392f8a1c4667806aab656ab5c9cb 2x, https://si.imgix.net/82de3b52/uploads/origins/738ec593-87da-4b83-88af-8ad1d5136cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=efa566c724ce2716aca084f2f58ef09d 3x"}, "body": "こんにちは。あなたの別のスケッチ（https://skeb.jp/@4kishiki/works/2）を見て、ロボガールの細部をとても上手に描けるのだなと思いました。また、あなたのページには、VTuberの素敵なポーズを描いたかわいいイラストがたくさんありますね。 私のロボガール「QueFrutimon」のイラストを描いていただけないでしょうか。彼女は2000年代のレトロなデスクトップ壁紙やスクリーンセーバーをモチーフにしています。ピンナップ風のポーズで、周りに小さな泡が散りばめられていたらかわいいと思います。 https://x.com/4kishiki/status/2043290533800579414/photo/1 あなたが描いたこのアングルは本当に素敵なので、この路線で遊び心のあるイラストをお願いできればと思います。 彼女は緑色のパンティーを履いていて、靴はパソコンのマウスパッドになっています。ご検討いただき、誠にありがとうございます。\n\nhttps://www.deviantart.com/stash/2h5yh63dq87", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@4kishiki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 273288, "client_id": 43626, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd911518/uploads/origins/29ffffa8-69da-4caf-b3e3-fd71e3c88cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=741229346eb4273e8bb92