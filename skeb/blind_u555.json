0&h=200&s=ef7f59495c449789591785d60182c224 2x, https://si.imgix.net/7520e234/uploads/origins/77a7bcff-15e8-44ff-bb96-f05b82c0bdb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7cae1c848c269b66d9f8651dbe12a748 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7520e234/uploads/origins/77a7bcff-15e8-44ff-bb96-f05b82c0bdb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b171f48fc3b332781a17af80898de5a", "srcset": "https://si.imgix.net/7520e234/uploads/origins/77a7bcff-15e8-44ff-bb96-f05b82c0bdb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b171f48fc3b332781a17af80898de5a, https://si.imgix.net/7520e234/uploads/origins/77a7bcff-15e8-44ff-bb96-f05b82c0bdb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8855eb3978ac3118a7956f9701a85c28 2x, https://si.imgix.net/7520e234/uploads/origins/77a7bcff-15e8-44ff-bb96-f05b82c0bdb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b124d6aeb9c673a2a2eff0e6671e7171 3x"}, "body": "Bu先生、こんにちは！ \n先生が描く絵は大好きです...できれば私の創作男女を描くことを依頼したいと思います！。\n金額になにか問題があれば再送要請してください。 \n難しければキャンセルして大丈夫です！\n\n ▼参考リンクでは、キャラクターの設定など、絵の参考情報をご覧いただけます。  \n\n▼キャラクターなど： \n男=D，女=R\n 『ハンガー・ゲーム』や『バトル・ロワイアル』のようなサバイバルゲームを舞台にした物語です。 二人はチームメイト。 (ちょっと曖昧かもしれませんが...)\nロケ地は主に森の中です。 \nどちらも30歳前後成熟した大人! Dは筋肉質（ロシア人）、Rはぽっちゃり系。 \nDは活発な善人を装った殺人鬼、Rは人見知りしやすく、生き残るために苦労している外科医。 \nより日常的な場合：Dが親密な交流を始め、Rはその主導権に圧倒され、恥ずかしがるでしょう。（笑vs赤面...） \nより怖い場合：Dが悪役の顔を晒す←これを知ってショックを受けるR。（圧倒されるかもしれないし、彼と対峙することになるかもしれない）  \n\n要するに、犬のふりをした悪い猫D & 働き者の子犬R。真面目に地獄から抜け出そうとする善良な女が、一見無害だが実はかなり悪質な男に取り憑かれる（この用語は正確ではないかもしれない。 しかし、私が言いたいのは、彼女はこの男を簡単には追い出せないということだ。）というストーリーは、おそらくこんな感じなのだろう！  \n\n▼内容など： \n落書き詰め込み絵が欲しいです！おまかせを希望します...！なんでもいいんです。 服のデザインは自由に変えることができます。ポーズや表情も自由です。  \n\n没ラフや下描きなどがあれば残したままにしていただけると嬉しいです。 \n私の依頼を考慮していただき、ありがとうございました~！🫶\n\nhttps://drive.google.com/drive/folders/1Bf64h9wMoueFd43YA-UAL-PjWzrUGVRE", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@blind_u555/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3343961, "client_id": 2023509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad1e29ee/uploads/origins/03e545f8-a8e9-48b0-9e8c-0cff19eb6807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76cf70d72f423e6435d4e6642ad8a50e", "srcset": "https://si.imgix.net/ad1e29ee/uploads/origins/03e545f8-a8e9-48b0-9e8c-0cff19eb6807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76cf70d72f423e6435d4e6642ad8a50e, https://si.imgix.net/ad1e29ee/uploads/origins/03e545f8-a8e9-48b0-9e8c-0cff19eb6807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38a36e67b5c87278b0b5f0bd8f89cb09 2x, https://si.imgix.net/ad1e29ee/uploads/origins/03e545f8-a8e9-48b0-9e8c-0cff19eb6807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6457aa7b0bda2b155be89923aec0f97 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad1e29ee/uploads/origins/03e545f8-a8e9-48b0-9e8c-0cff19eb6807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5f0c6493352f52f370e3bca7723fe46", "srcset": "https://si.imgix.net/ad1e29ee/uploads/origins/03e545f8-a8e9-48b0-9e8c-0cff19eb6807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5f0c6493352f52f370e3bca7723fe46, https://si.imgix.net/ad1e29ee/uploads/origins/03e545f8-a8e9-48b0-9e8c-0cff19eb6807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd6f540b21b82ebadc97a7b5c962cc36 2x, https://si.imgix.net/ad1e29ee/uploads/origins/03e545f8-a8e9-48b0-9e8c-0cff19eb6807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=cro