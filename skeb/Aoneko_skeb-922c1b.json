いです。\n\n▼使用用途\nサムネ、おはV等の活動で使用させていただきます。\n\n▼キャラデザ\n立ち絵・三面図を用意させていただきましたので資料の方確認していただければ幸いです\nhttps://drive.google.com/drive/folders/1NwvzRe7u933OYhT4ZZU6XNuh8GFmGaAQ?usp=sharing\n\n納品は可能であればPSDファイルでお願いしたいです。\nまた、背景透過の物もいただけると幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1NwvzRe7u933OYhT4ZZU6XNuh8GFmGaAQ?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 830385, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "餡子概念💔👓", "screen_name": "xmartieisgood", "avatar_url": "https://pbs.twimg.com/profile_images/2033228669808943104/Qqd4WWn0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1113478607387525120/1774560244/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "voice"}, {"genre": "video"}, {"genre": "music"}, {"genre": "correction"}], "nc": 0}, {"id": 1166238, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "瀬戸", "screen_name": "ebi_oishiiii", "avatar_url": "https://pbs.twimg.com/profile_images/1680886966345412608/8RWeXDJG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1382099772966805507/1771244744/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "nc": 1}, {"id": 1672993, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "しろくま", "screen_name": "yb_shiroo", "avatar_url": "https://pbs.twimg.com/profile_images/1850933503044788225/wQsF918U.jpg", "header_url": "https://pbs.twimg.com/profile_banners/13438089543174