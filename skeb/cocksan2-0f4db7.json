60-8947-1695a26ceae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd68cf15dac8037a05e1f13f29ad42a6 2x, https://si.imgix.net/bedf6085/uploads/origins/a99d343e-cac5-4b60-8947-1695a26ceae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05bba30e12cb3088eb7eda70f185ad79 3x"}, "body": "こんにちは。リクエストしてみます。\n機械責めを長期間受けながらも、継続を懇願する女の子をお願いします。\n\nお願いしたい点として、\n・ショートの女の子が拘束されて、機械責めを受けている。体位はお任せします\n・機械責めは二穴への挿入、乳首責め、クリ責めなどを含み、女の子は連続で絶頂している\n・その後、女の子は引き続き機械責めを受け絶頂していて、前髪を含め髪が延びている\n・「だいぶ長くやってもらってるけど大丈夫？」などの声（改変可）があり、女の子はそれに対して絶頂しながらも「大丈夫です！まだいけます！」などと継続を懇願する\n・可能であれば、近くに同様の責めを受けているモブ（途中で人物が変わる）を置いてください\n・なぜ女の子が継続を懇願するのかはあえて明らかにしないでください\n\n条件が合わなければ多少改変していただいてもかまいません。\nよろしければご検討お願いします！", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cocksan2/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1b7113eb/uploads/origins/93d3d15d-d32e-47d4-963c-bbac2785df7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff44a4c5fc2c928e1b9e299fe8f8f846", "srcset": "https://si.imgix.net/1b7113eb/uploads/origins/93d3d15d-d32e-47d4-963c-bbac2785df7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff44a4c5fc2c928e1b9e299fe8f8f846, https://si.imgix.net/1b7113eb/uploads/origins/93d3d15d-d32e-47d4-963c-bbac2785df7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d9c1ab9979a066f7ec997e87fd61362d 2x, https://si.imgix.net/1b7113eb/uploads/origins/93d3d15d-d32e-47d4-963c-bbac2785df7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFF