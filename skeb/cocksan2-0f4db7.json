&fit=crop&crop=top&w=200&h=200&blur=200&s=73fd64491561649bad684363cc442f1e 3x"}, "body": "こんにちは！ツイッターであなたのイラストを拝見し、大ファンになりました！\n\n私のキャラクター、ケイティのイラストを描いていただけたら光栄です。彼女は業界から放り出された元アイドルのポップシンガーです。\n\nあなたが想像できるどんな変態的な装置にも自由に彼女を入れてください！\n\n彼女のイメージは下のリンクにあります。\n\nhttps://imgur.com/a/references-hbmr4Rh\n\n絵を楽しんでもらえると嬉しいです :)", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cocksan2/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/aa145700/uploads/origins/6cf4fbf9-0d0a-4285-88a9-e1f04eb6e302?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a45ec87a42abfa391b88006727deefe", "srcset": "https://si.imgix.net/aa145700/uploads/origins/6cf4fbf9-0d0a-4285-88a9-e1f04eb6e302?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a45ec87a42abfa391b88006727deefe, https://si.imgix.net/aa145700/uploads/origins/6cf4fbf9-0d0a-4285-88a9-e1f04eb6e302?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c291f372ff1ded3b06afb7f86d81da22 2x, https://si.imgix.net/aa145700/uploads/origins/6cf4fbf9-0d0a-4285-88a9-e1f04eb6e302?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9640f43583e9c89b025b60de3a786f07 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3352707, "client_id": 2142661, "nc": 48}, {"path": "/@cocksan2/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3352707, "client_id": 893098, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cfb84e20/uploads/origins/bec65652-9d06-4ec3-83e1-4fa48ccf298d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f94f3a47c86d3e1c8d0f7f0530af980", "srcset": "https://si.imgix.net/cfb84e20/uploads/origins/bec65652-9d06-4ec3-83e1-4fa48ccf298d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f94f3a47c86d3e1c8d0f7f0530af980, https://si.imgix.net/cfb84e20/uploads/origins/bec65652-9d06-4ec3-83e1-4fa48ccf298d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84193edbf62ad01615f1b3a2082bcaf9 2x, https://si.imgix.net/cfb84e20/uploads/origins/bec65652-9d06-4ec3-83e1-4fa48ccf298d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab2818819c0d0d699a7811f415afecab 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cfb84e20/uploads/origins/bec65652-9d06-4ec3-83e1-4fa48ccf298d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b23cf05699422e01b1cd0cfd0e84685", "srcset": "https://si.imgix.net/cfb84e20/uploads/origins/bec65652-9d06-4ec3-83e1-4fa48ccf298d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b23cf05699422e01b1cd0cfd0e84685, https://si.imgix.net/cfb84e20/uploads/origins/bec65652-9d06-4ec3-83e1-4fa48ccf298d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f58cabea1e614e4c00ae4e77532f8df7 2x, https://si.imgix.net/cfb84e20/uploads/origins/bec65652-9d06-4ec3-83e1-4fa48ccf298d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d84256d414c69ccc213f4a443669b175 3x"}, "body": "お世話になっております。いつも作品拝見しております。\npsy no様の作品はシチュエーション･絵柄とても素晴らしく、大変好みでいつもお世話になっております。\n\nこの度は以下をリクエストさせていただきたいです。\n\n【容姿】\n黒髪おかっぱメガネで大人しそうな容姿。巨乳。おしりも大きめ。太もも若干太め。ウエストは程よく締まっている。デュラララの園原杏里のような見た目。\n秘書として潜入捜査。\n\n【シチュエーション】\n潜入捜査がバレてしまい、全裸にされ「取り調べ室」で機械による責めを受ける。メガネは絶対に外さないでください。\n\n後ろ手に拘束され、四つん這いのような格好で、お尻を突き出すように固定され、前と後ろの穴をイボのついたバイブで無慈悲に責め立てられます。クリ〇リスはザラザラのブラシの前後運動で擦られ続けています。何度もイカされているのか、股の下辺りには水たまりができています。\n取り調べ官に戯れに尻肉を揉みしだかれ、スパンキングされたのか、お尻には赤い腫れが見れます。\n\n張りのある巨乳の先には搾乳器のような器具を取り付けられ、首枷がつけられているのも相まって乳牛のようです。器具は半透明で、乳房を吸引されながらも、中でブラシが回転し、ピンク色の乳首はコリコリになり、責められ続けています。\n\n表情は、いわゆるオホ顔ではなく、羞恥や恥辱に耐えながらも、快楽に泣き叫んで、許しを乞うような表情です。\n\nセリフとして、\n取り調べ官「イク時はイクって言えって言っただろ」\n\n「ごめんなさいっ……！」「イきます……！」\n「お願いします……！」「何でもします…！」\n「もう許してくださいっ…！！」\nと入れてください。\n\nまた可能であれば「取り調べ室」まで連行されているカットも入れてただきたいです。\n全裸に剥かれ、後ろ手に拘束され、首枷から伸びた鎖を引かれ、衆人環視の中「取り調べ室」まで連行されています。乳房や秘部など隠すことも出来ず、周囲から向けられる下卑た視線や言葉から、否が応でもこれからされる責め苦を想起され、足取りは重くなるも「早く歩け」と大きな尻肉を鷲掴みにされ、無理やり歩かされ、顔を伏せ羞恥を滲ませた沈鬱な表情をしています。\n\n指定のセリフ以外のセリフや喘ぎ声はお任せ致します。\npsy no様のセンスを信頼しております。\n\n何卒ご検討いただけますと幸いです。\nよろしくお願い致します。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cocksan2/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3352707, "client_id": 1354547, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30941de2/uploads/origins/3b9f664a-d1e9-4fd5-8e03-2da8551fea76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=950ef697c2e88ec3980fac269b83ac55", "srcset": "https://si.imgix.net/30941de2/uploads/origins/3b9f664a-d1e9-4fd5-8e03-2da8551fea76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=950ef697c2e88ec3980fac269b83ac55, https://si.imgix.net/30941de2/uploads/origins/3b9f664a-d1e9-4fd5-8e03-2da8551fea76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9df20be30686af44061a7a671b6fd7b7 2x, https://si.imgix.net/30941de2/uploads/origins/3b9f664a-d1e9-4fd5-8e03-2da8551fea76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c4922bea129597eb0337f7ce99be144 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30941de2/uploads/origins/3b9f664a-d1e9-4fd5-8e03-2da8551fea76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3a2daf55045b711f5a2c3bc84b89e75", "srcset": "https://si.imgix.net/30941de2/uploads/origins/3b9f664a-d1e9-4fd5-8e03-2da8551fea76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3a2daf55045b711f5a2c3bc84b89e75, https://si.imgix.net/30941de2/uploads/origins/3b9f664a-d1e9-4fd5-8e03-2da8551fea76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=490042535488b20d9c3e2187f2b013d5 2x, https://si.imgix.net/30941de2/uploads/origins/3b9f664a-d1e9-4fd5-8e03-2da8551fea76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f5f5c16ff9e5d5cf326d8bcc2538076 3x"}, "body": "psy no🔞様、初めまして。\n\n投稿されている作品が素敵だと感じたので依頼させて頂きます。\n\nキャラクター\n探偵はもう死んでいる。のシエスタ\n\n希望するシチュエーション\n心臓フェチ向けの壁尻オナホにされるシエスタ。\n\nhttps://x.com/sakupansab/status/1812065690620502255?t=4wQ_mQBn9Z6-2glPgn4mYg&s=19\n\n上記のURLのような感じで全裸の壁尻状態で拘束され、モニターには正面から撮影されている姿が映っている。胸には電極パッドやテープで固定された聴診器が胸の中心やや左寄りの心臓の辺りに取り付けられている。別のモニターにはシエスタのリアルタイムの心電図、心拍数、鼓動する心臓のアニメーションが表示されている。モニターにはお札を入れるスロットが存在し、一回2000円と書かれている。心拍数170以上達成で半額キャッシュバックという張り紙がしてある。近くの収納スペースには大量の大人のおもちゃが置かれており、備え付けのヘッドホンで心音を聞くことが出来る。行為前の心拍数は80、行為中は120、絶頂時は170。勃起ちんぽを取り出し、ヘッドホンを装着してシエスタを犯す。最初は気丈に振る舞っていたシエスタだがちんぽの快楽には抗えずに途中かる感じ始め、心臓の鼓動はどんどん速くなっていく。シエスタの絶頂時に中出し。どくっどくっと膣内に射精し子宮がごくごくと精液を飲み干す擬音や描写、ちんぽをシエスタのおまんこから引き抜くと精液が逆流する描写や卑猥な擬音。お札のスロットにお金がキャッシュバックされている。\n\n私は心臓フェチなので心臓（心音）の擬音や描写には以下の私が過去に依頼した作品を参考に特に力を入れて欲しいです。指定した箇所以外は信頼してお任せします。アドリブも歓迎します。描写しにくいところは改変して頂いても構いません。\n\n以上の内容で受けて頂ける場合はよろしくお願いします。\n\nhttps://skeb.jp/@puyochocolate/works/121\n\nhttps://skeb.jp/@mokuu__/works/9\n\nhttps://skeb.jp/@sksk_sou/works/235\n\nhttps://skeb.jp/@kandenti_0205/works/13", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cocksan2/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1962fc1a/uploads/origins/d45629fd-0990-4d45-8f6b-252e487