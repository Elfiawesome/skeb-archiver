op&crop=top&w=200&h=200&blur=200&s=4e90639929f27a7de21dc505a4f59dae 3x"}, "body": "kiramekiさん初めまして\n描いてほしいのはネトゲの自キャラです。\n資料：https://drive.google.com/drive/folders/13AxGKW1t-afm8Daj0K5mD26Ee0k2iYQi?usp=drive_link\n構図：腕を組んでいて少し見上げている感じにこちらを見てきている\n表情：kiramekiさんのアイコンで使用しているアイコンみたいなﾆｯと笑顔になっているイメージです\nわかりにくい装飾等ありましたら服装のアレンジ等してもらって大丈夫です。\nよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riku_satera723/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 350203, "client_id": 880624, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2be2efab/uploads/origins/978ac676-e747-4b59-ab93-09cf3315c7f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e35ab37689717e47fed8ac62db51ddbf", "srcset": "https://si.imgix.net/2be2efab/uploads/origins/978ac676-e747-4b59-ab93-09cf3315c7f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e35ab37689717e47fed8ac62db51ddbf, https://si.imgix.net/2be2efab/uploads/origins/978ac676-e747-4b59-ab93-09cf3315c7f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9626b610c80aa8c9d3a3917c1c3379ff 2x, https://si.imgix.net/2be2efab/uploads/origins/978ac676-e747-4b59-ab93-09cf3315c7f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33491675f34f1403953e753388f32cbd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2be2efab/uploads/origins/978ac676-e747-4b59-ab93-09cf3315c7f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a7ae0c6c7953f287c0297b1547c85d0", "srcset": "https://si.imgix.net/2be2efab/uploads/origins/978ac676-e747-4b59-ab93-09cf3315c7f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a7ae0c6c7953f287c0297b1547c85d0, https://si.imgix.net/2be2efab/uploads/origins/978ac676-e747-4b59-ab93-09cf3315c7f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c5d277978ff68e55378c4456f631b8fa 2x, https://si.imgix.net/2be2efab/uploads/origins/978ac676-e747-4b59-ab93-09cf3315c7f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b2a48452613030875615773aa38cca54 3x"}, "body": "初めまして。いつも素敵なイラスト拝見しております。\n\nウマ娘のヴィルシーナ姉さんを是非リクエストさせてください。\nトレーニング終わりに休んでるシチュエーションで、トレーナーの前で気を許してゆったりしてるイメージでお願いします。\n服装は学園の体操服で、上着を腰に巻いてシャツはズボンから出して少し暑そうな感じでお願いします。下はズボンかブルマかはお任せします。\n全身もしくは膝より上の構図で、腰に巻いた上着が見える感じでお願いします。\nその他はお任せします。\n\nもし可能でありますならよろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riku_satera723/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 350203, "client_id": 1120756, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fe3751f/uploads/origins/e31cc4f0-7972-43d0-b707-db26ca3ac11c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85329a2ac9bfaf6e1b58abc9e41f61f0", "srcset": "https://si.imgix.net/6fe3751f/uploads/origins/e31cc4f0-7972-43d0-b707-db26ca3ac11c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85329a2ac9bfaf6e1b58abc9e41f61f0, https://si.imgix.net/6fe3751f/uploads/origins/e31cc4f0-7972-43d0-b707-db26ca3ac11c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=872a18b86822d134036cd51a8fa1e895 2x, https://si.imgix.net/6fe3751f/uploads/origins/e31cc4f0-7972-43d0-b707-db26ca3ac11c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d84b4703b6a43c715fc960d00d3b2762 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6fe3751f/uploads/origins/e31cc4f0-7972-43d0-b707-db26ca3ac11c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur