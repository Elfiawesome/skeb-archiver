0&s=df32bf328b34cdd1a5925eb953d09b23 2x, https://si.imgix.net/f21fcf7b/uploads/origins/8b1ce3f2-ca54-41cc-bc50-3dfb0ebac1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c475be87f990d9fd605d89220d37d02e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f21fcf7b/uploads/origins/8b1ce3f2-ca54-41cc-bc50-3dfb0ebac1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25b12e962a28b37bfcf67b6b87a1b69a", "srcset": "https://si.imgix.net/f21fcf7b/uploads/origins/8b1ce3f2-ca54-41cc-bc50-3dfb0ebac1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25b12e962a28b37bfcf67b6b87a1b69a, https://si.imgix.net/f21fcf7b/uploads/origins/8b1ce3f2-ca54-41cc-bc50-3dfb0ebac1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=15be6fc8231ceabac4cdec42795fbe21 2x, https://si.imgix.net/f21fcf7b/uploads/origins/8b1ce3f2-ca54-41cc-bc50-3dfb0ebac1e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a66d08b4533de671cc3b247bec6d0c31 3x"}, "body": "リクエスト失礼します。\n\nキャラ\nソードアート・オンラインの桐ヶ谷直葉\n\n衣装\n（https://www.pixiv.net/artworks/119080442）のような制服\n\nシチュエーション\nひょんなことからモブ同級生の家に泊まらせてもらうことになった直葉。部屋にあったコンドームを見つけてモブ同級生をからかう直葉。泊まらせてもらうお礼にコンドームを全部使わせてくれる。\n\n①\nコンドームを見つけてからかう直葉。セリフはおまかせします。\n\n②\n騎乗位でコンドームを全部使い切る直葉。セックスを楽しんでいるような表情・雰囲気・セリフでお願いします。\n\nリクエストは以上です\nご検討のほどよろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unitless18/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 75932, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1012b5f1/uploads/origins/9596af4c-0829-4321-b20e-254eacb66262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fcfce559a79827739d8380250dae9a4", "srcset": "https://si.imgix.net/1012b5f1/uploads/origins/9596af4c-0829-4321-b20e-254eacb66262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fcfce559a79827739d8380250dae9a4, https://si.imgix.net/1012b5f1/uploads/origins/9596af4c-0829-4321-b20e-254eacb66262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e868b586a7c2f984d201d8435feaf72 2x, https://si.imgix.net/1012b5f1/uploads/origins/9596af4c-0829-4321-b20e-254eacb66262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=000740fe419861b3fd4e456ef114e196 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1012b5f1/uploads/origins/9596af4c-0829-4321-b20e-254eacb66262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d65061749a2b9dee2260999630a880d3", "srcset": "https://si.imgix.net/1012b5f1/uploads/origins/9596af4c-0829-4321-b20e-254eacb66262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d65061749a2b9dee2260999630a880d3, https://si.imgix.net/1012b5f1/uploads/origins/9596af4c-0829-4321-b20e-254eacb66262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a13c4a7217c608039f6af6e86803a3ce 2x, https://si.imgix.net/1012b5f1/uploads/origins/9596af4c-0829-4321-b20e-254eacb66262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2e21e407333cfc90669d86c43b1b28a5 3x"}, "body": "こんにちは。いつも素敵なイラストをありがとうございます。\n進撃の巨人のミカサをリクエストしたいです。\n\nミカサはバキバキ筋肉質な身体に不釣り合いな特盛爆乳でお願いします。大きければ大きいほど嬉しいです。\n恰好は以前に描かれていたこちらの衣装に似た感じでお願いします。\n　↓\n\nhttps://minorimune.fanbox.cc/posts/5635927\n\nもしくは全裸でも構いません。\n\n有力貴族の変態クソガキにそのドスケベボディを狙われてしまったミカサ。貴族の根回しのせいで訓練兵卒業後に調査兵団に入団できず、同期達の身の安全を人質にとられクソガキ貴族のお付き役に強制配属されてしまったというシチュエーション。\n\n立っているミカサの腰に抱きつきデカ盛り爆乳を揉みながら「おっぱいデッカw」「筋肉すげっw」「セックス漬けにしてその鍛え上げた筋肉をだらしないエロ肉に変えてやるw」などといったようなセリフをほざいてミカサの屈辱感を煽るエロガキ。\n抵抗できないミカサは怪訝な表情で反抗的な様子（当然エロガキに犯し尽くされブチ堕とされる）。\n\nよろしければ