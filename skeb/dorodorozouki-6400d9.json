=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=976e17151ec03763085f717d49d6901e 2x, https://si.imgix.net/a5d404af/uploads/origins/f85768d0-7fb0-4786-beff-7af100b1d5ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58fa40ffd1751a170c6bdca83c20202f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5d404af/uploads/origins/f85768d0-7fb0-4786-beff-7af100b1d5ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85bbfc4def177c5c3d86545ab2752331", "srcset": "https://si.imgix.net/a5d404af/uploads/origins/f85768d0-7fb0-4786-beff-7af100b1d5ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85bbfc4def177c5c3d86545ab2752331, https://si.imgix.net/a5d404af/uploads/origins/f85768d0-7fb0-4786-beff-7af100b1d5ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e50d000cd59e128bb8401fa7b29f3ba 2x, https://si.imgix.net/a5d404af/uploads/origins/f85768d0-7fb0-4786-beff-7af100b1d5ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=edff6ceb567785e2967d1cf292fcd544 3x"}, "body": "はじめまして。あなたの作品はとても魅力的で、私のキャラクターを描いていただけないかと思っています。\nグーイーは魔術師、アネモネは人魚です。二人はロマンチックなカップルで、外見はどちらも25歳くらいなので、二人一緒に描いてもいいし、どちらかを選んで描いてもいいです。\nグーイーはジャングルに住んでいて、アネモネは海に住んでいて、グーイーと一緒に過ごすためによく海に来ます。グーイーは魔法の杖を使って、魔女がほうきに乗っているように、海の上を飛ぶこともできます。\n\nポーズや構図はお客様にお任せしますので、ポーズや表現のアイデアの参考になるように、彼らについて詳しくご紹介します。\n\nアネモネは優しくてシャイな人魚で、人間を食べないと生きていけないのですが、食べたくないのでとても寂しがり屋です。\n紫からオレンジ色の髪の毛を持ち、ビキニトップや首には様々な青い真珠がぶら下がっていて、涙型の宝石が付いた紫がかったベールを身につけています。\n彼女はまた、あなたが自由に選択できる人間の形を持っています。彼女はGooeyの魔法のおかげで人間に変身することができますが、その魔法が完璧ではないので、彼女は青い足を持っています。\n人間の時はカラフルなビンテージファッションが好きなのですが、それ以外は占い師のような格好をさせたいと思っています。\n\nGooeyは金に執着し、宝物を見つけるのが好きな魔術師で、とても傲慢ですがAnemoneには優しいです。\n彼女はかつて赤い翼を持っていましたが、命と引き換えに女神に捧げなければなりませんでした。\n左側の髪はとても長くてまっすぐ、右側の髪は剃っています。彼女のローブは羽毛でできていて、ヒールとジュエリーは金色です。\n彼女は金色の杖を持っていて、それを様々なものに変身させることができます。例えば、金色の柄のついた赤い傘や、赤い弾のついた金色の銃などです。\n杖についている赤いオーブは空中に浮くことができ、彼女の魔法の源となっています。\nまた、彼女はファッションが大好きなので、いろいろな服を着せることができます。\n\nこの作品は、非営利目的のAMVビデオや、YouTubeで楽しむためのグラフィックデザイン・バナーなどに使用することができます。\nこの度はありがとうございました。\n\nhttps://drive.google.com/drive/folders/1GOasO4COTtlbZHLTuFyE6CRwd5MJlQY0?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@dorodorozouki/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1105631, "client_id": 881882, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4dbb59fc/uploads/origins/af4a6379-2d21-4415-aa0e-c0c02f4ae6bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75b450603cc37b05c6793b116228e4a7", "srcset": "https://si.imgix.net/4dbb59fc/uploads/origins/af4a6379-2d21-4415-aa0e-c0c02f4ae6bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75b450603cc37b05c6793b116228e4a7, https://si.imgix.net/4dbb59fc/uploads/origins/af4a6379-2d21-4415-aa0e-c0c02f4ae6bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3213c58447283c6fbb0c72532a8c500a 2x, https://si.imgix.net/4dbb59fc/uploads/origins/af4a6379-2d21-4415-aa0e-c0c02f4ae6bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae2c9cb308a72815f503b39befd3462d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4dbb59fc/uploads/origins/af4a6379-2d21-4415-aa0e-c0c02f4ae6bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d8c65d54cafc62371f564d94b4d47bf", "srcset": "https://si.imgix.net/4dbb59fc/uploads/origins/af4a6379-2d21-4415-aa0e-c0c02f4ae6bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d8c65d54cafc62371f564d94b4d47bf, https://si.imgix.net/4dbb59fc/uploads/origins/af4a6379-2d21-4415-aa0e-c0c02f4ae6b