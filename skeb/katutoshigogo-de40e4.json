1e60347f/uploads/origins/b58add6e-4f2a-4e1c-bd20-3a4617112a6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f38f82123a97f1a232b378865d201394 3x"}, "body": "私の二人の忍者少年キャラクター、ミストとレイヴンを描いていただけませんか？以下に参考資料を添付します。\nオレンジのミスト（17歳）は比較的穏やかで口数が少なく、青のレイヴン（16歳）は外向的で少々やんちゃな性格です。彼らは幼い頃からバトルパートナーなのだ。\n二人の淫らでエロティックなやりとりや、からかったり、セックスしたりする様子を短いマンガで描いてほしい。ピチピチの忍者スーツ姿でも、ふんどし一枚でも、全裸でもOK。シチュエーション、プロット、セリフはすべてあなた次第。\nシチュエーションはミスト×レイヴンでもレイヴン×ミストでも構いませんので、お好きな方をお選びください！\n関係ないキャラは入れないでください。\nたくさんイッて体をぐちゃぐちゃにして、気持ちよく快感を味わう二人が見たいです。二人の仲の良さが伝わると嬉しいです。\nその他、細かい要望がないものは自由です。\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1QBrm3u6P2jLlAwK3lKpkJ57MRLH-T4zf", "nc": 34, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@katutoshigogo/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 859941, "client_id": 366455, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f95c29e1/uploads/origins/8183c6cf-b0b6-40e8-b6fd-e66a02c7e508?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed0dbd36fe81426e995c7dab22286e79", "srcset": "https://si.imgix.net/f95c29e1/uploads/origins/8183c6cf-b0b6-40e8-b6fd-e66a02c7e508?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed0dbd36fe81426e995c7dab22286e79, https://si.imgix.net/f95c29e1/uploads/origins/8183c6cf-b0b6-40e8-b6fd-e66a02c7e508?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e78ae2a5416aebdae814590ebfbf2098 2x, https://si.imgix.net/f95c29e1/uploads/origins/8183c6cf-b0b6-40e8-b6fd-e66a02c7e508?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=220ad0bdb01d07c932cad644f76d724b 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f95c29e1/uploads/origins/8183c6cf-b0b6-40e8-b6fd-e66a02c7e508?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06a071c275e26eea112e2d7fd5e4e658", "srcset": "https://si.imgix.net/f95c29e1/uploads/origins/8183c6cf-b0b6-40e8-b6fd-e66a02c7e508?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06a071c275e26eea112e2d7fd5e4e658, https://si.imgix.net/f95c29e1/uploads/origins/8183c6cf-b0b6-40e8-b6fd-e66a02c7e508?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9685ef8fdf501726f102f9aa758577cb 2x, https://si.imgix.net/f95c29e1/uploads/origins/8183c6cf-b0b6-40e8-b6fd-e66a02c7e508?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d14007cbec5c14bb2a82c152ec01b1c2 3x"}, "body": "はじめまして、Xにてイラストを拝見せていただきまして、大変心揺さぶられました。\nぜひコミックを描いていただきたいと思い、リクエストを出させていただきました。\n\n【キャラクター】\n・少年\n　11歳前後ぐらいのやんちゃな日焼け跡のある少年。小柄だが筋肉質。無毛包茎。\n\n【シチュエーション】\n家の借金のために金持ちに身売りした少年は、ペット兼性奴隷として扱われる\n\n【詳細】\n・犬のちんちんのポーズで、全裸に首輪という格好で金持ちとその知り合いたちに挨拶をする少年。\n　体は薄汚れ所々に鞭の跡等がある。\n　金持ちたちに嘲笑される少年は、羞恥を感じながらも心折れずに相手を睨みつけている。\n※できれば非勃起の状態でお願いします。また、こちらもできればですが、足の指まで見える構図でお願いできますでしょうか。\n・余興として公開オナニーを強制される少年。金持ち達に笑われ、目に涙を浮かべながらも少年は家族のために必死にオナニーを続ける。\n\n金額の目安がわからないため、もし内容に比べて少ないようであれば、お手数ですがキャンセルからの再送依頼をお願いいたします。\n\n以上、ご一考いただければ幸いですので宜しくお願い致します。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@katutoshigogo/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6ac397d1/uploads/origins/da4b865d-48e8-498b-8d20-6c730841d921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88326db1186bb1e1b7b5a9f8c33a2ebe", "srcset": "https://si.imgix.net/6ac397d1/uploads/origins/da4b865d-48e8-498b-8d20-6c730841d921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88326db1186bb1e1b7b5a9f8c33a2ebe, https://si.imgix.net/6ac397d1/uploads/origins/da4b865d-48e8-498b-8d20-6c730841d921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a914104722f1784b17a7f8041d90e66 2x, https://si.imgix.net/6ac397d1/uploads/origins/da4b865d-48e8-498b-8d20-6c730841d921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ea9bfb586c8063aa44b7835700ed31d 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 859941, "client_id": 156033, "nc": 179}, {"path": "/@katutoshigogo/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 859941, "client_id": 75041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/85ac04cb/uploads/origins/038a47e1-9398-4599-a4bb-871554c2bfe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77f48c7e543ec44c6826b5ff01eba7ff", "srcset": "https://si.imgix.net/85ac04cb/uploads/origins/038a47e1-9398-4599-a4bb-871554c2bfe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77f48c7e543ec44c6826b5ff01eba7ff, https://si.imgix.net/85ac04cb/uploads/origins/038a47e1-9398-4599-a4bb-871554c2bfe0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ad63a94bbefc9f4e7d559627e01e33d 2x, https://si.imgix.net/85ac04cb/uploads/origins/038a47e1-9398-4599-a4bb-871554c2bfe0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90a275d6c759dc4657cb2751dd7922ab 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/85ac04cb/uploads/origins/038a47e1-9398-4599-a4bb-871554c2bfe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9c608ac1f75e5798a5e30d1141b9157", "srcset": "https://si.imgix.net/85ac04cb/uploads/origins/038a47e1-9398-4599-a4bb-871554c2bfe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9c608ac1f75e5798a5e30d1141b9157, https://si.imgix.net/85ac04cb/uploads/origins/038a47e1-9398-4599-a4bb-871554c2bfe0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=90d00c31c9f512ce6add85a63f6c7be3 2x, https://si.imgix.net/85ac04cb/uploads/origins/038a47e1-9398-4599-a4bb-871554c2bfe0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7102ee8fd4f2260b390df31682ba42b4 3x"}, "body": "お久しぶりです！ジャンル変更ありがとうございます。\n前回は素敵な弥彦くんの漫画ありがとうございました\n1年ぶりに募集されていて\n今回もぜひへそ関連モノクロ漫画をリクエストしたいです\n\nキャラは「black chaff]のレオトくんでお願いします\n\n大まかな流れ\n作中では新しいパパを母親が連れ込むようですが\n今回はへそフェチの新しいパパが来て\n母親のへそじゃ満足できていないところ\nレオトくんが作中最後のように自らへそ（少しでべそ気味）を晒して誘惑して\nその後、へそ調教される姿が見たいです\n\n作中に可能であれば入れてもらいたいポイント\n・学校の帰り道ランドセル背負ったレオトくんがへそを晒して、でべそ気味だけど\nパパを誘惑できるか考えるシーン　結果でべそが自分のチャームポイントと思う\n・パパを誘惑するシーンとパパからでべそなのは恥ずかしくないか聞かれて\n答えるシーン\n・へそピアス、その先に犬用リードを装着されて深夜外を散歩するシーン\n・学校でもへそピアスをつけるよう強要されるが、へそピアスを\nつけていることやでべそなのが同級生にバレるシーン\n・へそが性感帯になり自分で弄って気持ちよくなるシーン\n\n上記入れてもらえると嬉しいです\nレオトくんのセリフにへそやでべそ発言多めだと嬉しいです\nパパはセリフ描写のみで構いません\n\n不都合がある場合は、上記シーンカットしてもらって構いませんし\nへそを題材とした漫画を好きに描いていただいてオッケーです\n\n金額は昨年の弥彦くん漫画に少し上乗せで送ってます\nページ数は描ける範囲で大丈夫です\nよろしくお願いします。", "nc": 50, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@katutoshigogo/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 859941, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c550cce5/uploads/origins/7b91f20d-fe27-4e4c-a88a-feca1a32b65c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af33ed3f1e7680783d0e24490dae90ff", "srcset": "https://si.imgix.net/c550cce5/uploads/origins/7b91f20d-fe27-4e4c-a88a-feca1a32b65c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af33ed3f1e7680783d0e24490dae90ff, https://si.imgix.net/c550cce5/uploads/origins/7b91f20d-fe27-4e4c-a88a-feca1a32b65c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58858cb04977b038d9c6530accb147f4 2x, https://si.imgix.net/c550cce5/uploads/origins/7b91f20d-fe27-4e4c-a88a-feca1a32b65c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9dd22fb6a0c842ce440765403316652 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c550cce5/uploads/origins/7b91f20d-fe27-4e4c-a88a-feca1a32b65c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffb5777038748bd90786922e22881dc9", "srcset": "https://si.imgix.net/c550cce5/uploads/origins/7b91f20d-fe27-4e4c-a88a-feca1a32b65c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffb5777038748bd90786922e22881dc9, https://si.imgix.net/c550cce5/uploads/origins/7b91f20d-fe27-4e4c-a88a-feca1a32b65c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97802346eb322fc63f5fdf4a98b83446 2x, https://si.imgix.net/c550cce5/uploads/origins/7b91f20d-fe27-4e4c-a88a-feca1a32b65c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d8e8dad2e061c1136a0a01cf4e08f1f 3x"}, "body": "お久しぶりです！\nるろ剣の弥彦くん漫画とても良かったです！\nよかったら彼でリクエストしたいです\n\n前回のリクエスト同様、へそフェチなのでへそに関連したもので\n今回はモノクロ漫画をお願いしたいです\n\nキャラ\n弥彦\n\n大まかな流れ\n最後は南蛮人に売られてしまうみたいですが、その前に日本人の\n変態へそフェチおやじにへそ調教される姿が見たいです\n弥彦くんのへそはでべそ気味で、でべそが特に好きなおやじは\n彼のへそを性感帯にしようとでべそ化して調教します\n\n作中に可能であれば入れてもらいたいポイント\n・弥彦は自分がでべそ気味なのを知っていて\nまさかでべそが好きとは思っていなかったので、自分がでべそで残念だったなと相手を挑発するシーン\n・おやじによってでべそを木製のピンセットのようなもので引っ張られるシーン\n・家族にでべそと指摘されなかったかと聞かれて、母親にでべそって言われたことがあると恥ずかしそうに言うシーン\n・浣腸された挙句、ボテ腹で大きくなったでべそにピアスをされるシーン\n\n上記入れてもらえると嬉しいです\n弥彦のセリフにへそやでべそ発言多めだと嬉しいです\nおやじはセリフ描写のみで構いません\n\n不都合がある場合は、上記シーンカットしてもらって構いませんし\nへそを題材とした調教シーンを好きに描いていただいてオッケーです\n作者様の健気に頑張る強気少年が大好きです\n\n何卒ご検討宜しくお願い致します", "nc": 43, "word