意識を同調させて限定的に未来を視ることができる能力があり、大抵のことは超高空から見下ろすように他人事で言動が全体的にふわふわしています。\n当人のキーワードとしては「魔性の美貌」「蜜色の瞳」「芥子の花」「幻覚」\n背景に「紅い月」あるいは「星空」といったモチーフがあると嬉しいです。\n\n可能ならばスマホのホーム画面等に使用したいな！と考えていますが自由な構図で描いていただけると幸いです。\n衣装なども自由に解釈していただいたり、全く改変していただいても構いません（もちろんしなくても構いません）\n何卒よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1YIEwR1b548QQ8SPBq11Ym6XquBkfIhTQ?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@urv_b3/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1107357, "client_id": 569909, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7459feae/uploads/origins/9b966dab-e963-4d8f-abcb-c1a3d86eff02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f0b7e7f37f1c146ac072329790f026f", "srcset": "https://si.imgix.net/7459feae/uploads/origins/9b966dab-e963-4d8f-abcb-c1a3d86eff02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f0b7e7f37f1c146ac072329790f026f, https://si.imgix.net/7459feae/uploads/origins/9b966dab-e963-4d8f-abcb-c1a3d86eff02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d54115b0e117d62e8d784407668d38e 2x, https://si.imgix.net/7459feae/uploads/origins/9b966dab-e963-4d8f-abcb-c1a3d86eff02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aecb524482fe01aa99c8e661f5ed7109 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7459feae/uploads/origins/9b966dab-e963-4d8f-abcb-c1a3d86eff02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b384caf15ccd187ae1baeabde4b0e525", "srcset": "https://si.imgix.net/7459feae/uploads/origins/9b966dab-e963-4d8f-abcb-c1a3d86eff02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b384caf15ccd187ae1baeabde4b0e525, https://si.imgix.net/7459feae/uploads/orig