ix.net/b234de28/uploads/origins/b25f4bf5-f551-42b2-8d9f-3fc80c886790?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11db5cddb0f9322274048cbf2d8cf746 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b234de28/uploads/origins/b25f4bf5-f551-42b2-8d9f-3fc80c886790?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d3ac2aa061085cfbbf6f3f5338b2c3d", "srcset": "https://si.imgix.net/b234de28/uploads/origins/b25f4bf5-f551-42b2-8d9f-3fc80c886790?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d3ac2aa061085cfbbf6f3f5338b2c3d, https://si.imgix.net/b234de28/uploads/origins/b25f4bf5-f551-42b2-8d9f-3fc80c886790?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=be48b58e27b654f4a8a9df9404d0010c 2x, https://si.imgix.net/b234de28/uploads/origins/b25f4bf5-f551-42b2-8d9f-3fc80c886790?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=42db5ac9c34e96ecc3bc46910a471229 3x"}, "body": "初めまして、おぢと申します。\nタグでお見かけして以来、イラストの優しい雰囲気とタッチ、色使いに惹き込まれました。これまでの作品を貪るように拝見していましたところ、スケブを始められたということで…！膝を叩きながら歓喜に震えております。柔らかさもありつつ、少しだけ混じる独特なほの暗さが私にはとても魅力的で、ぜひスケブをお願いしたいと思いました。\n\n今回は、当方の自陣である緑色と黄色の子を描いて頂けたら嬉しいです……！資料はTwitterのURLを記載しておりまして、あるシナリオのFAではあるのですが、ネタバレは含んでおりませんのでご参照頂けると幸いです。\n\nシチュエーションについて。\n茹だるような夏ですので、二人でアイスを食べているようなシーンでお願いできたらと思います……！黄色の子はホストなのでスーツですが、脱いでも大丈夫です。緑の子はTシャツなどの半袖でも大丈夫です。\n\n長くなり申し訳ありませんが、ご検討いただけますと幸いです。ただ資料も少ないため、難しい場合はスルーして頂ければと思います……！\nそれでは、ふすえさんのTRPGライフが楽しさで溢れていきますよう☀️\n\nhttps://twitter.com/yattanghh/status/1473290803477106694?s=21&t=sN4RGJ6W_a60xjNaEHw9ow", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 373223, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ギャルビ", "screen_name": "iouytuuyio", "avatar_url": "https://pbs.twimg.com/pr