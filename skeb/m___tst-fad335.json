_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@m___tst/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3430074, "client_id": 3353451, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca156468/uploads/origins/0a9834db-8803-4342-b326-0dbcc2b0f844?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd1abfbed06ae909457b2a38ecf0914c", "srcset": "https://si.imgix.net/ca156468/uploads/origins/0a9834db-8803-4342-b326-0dbcc2b0f844?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd1abfbed06ae909457b2a38ecf0914c, https://si.imgix.net/ca156468/uploads/origins/0a9834db-8803-4342-b326-0dbcc2b0f844?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc5c5ee17078942e4ed72f6a959138bd 2x, https://si.imgix.net/ca156468/uploads/origins/0a9834db-8803-4342-b326-0dbcc2b0f844?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=694ffbc9db2214bc82264a51030fbc7e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca156468/uploads/origins/0a9834db-8803-4342-b326-0dbcc2b0f844?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e11ebf2e34ede42cf9341e962fc14e3", "srcset": "https://si.imgix.net/ca156468/uploads/origins/0a9834db-8803-4342-b326-0dbcc2b0f844?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e11ebf2e34ede42cf9341e962fc14e3, https://si.imgix.net/ca156468/uploads/origins/0a9834db-8803-4342-b326-0dbcc2b0f844?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b9bbd8f02cf1b33b336ef5caf91e3c78 2x, https://si.imgix.net/ca156468/uploads/origins/0a9834db-8803-4342-b326-0dbcc2b0f844?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16ff262f49fcd67701c31818076618a8 3x"}, "body": "はじめまして。VTuberとして活動中の利巧（りこう）いりやと申します。以前より、おさとう様の素敵なデザインの数々が好きでいつかご依頼したいと考えておりました。今回は『配信用企画ロゴ』を制作して頂きたく、リクエストさせて頂きました。\n\n以下、リクエスト内容になります。\n\n資料\nhttps://x.com/rikoiriya/status/1918587847742767352\n\nリクエスト内容\n・ロゴにしたい文字『利巧いりやの朝からおりこうSUN！』\n朝から不定期で『賢くなりたいお姉さん系VTuber』が自分の知らない事や未知のコンテンツ等を学びながら、リスナーの皆様とお喋りしたり、たまにゲストを呼んだりするような企画配信を予定しております。\n・ポップなデザインでモチーフに太陽やメガネ、電球の要素を入れて頂きたいです。後の部分はおさとう様にお任せする形を希望しております。\n\n使用用途\n収益化済チャンネルの配信や動画、配信や動画のサムネイル、コミュニティの投稿等（YouTube）、SNSの投稿等のVTuber活動に使用致します。また、他のチャンネル（収益化前・収益化済問わず）で企画の紹介や宣伝を行う際も使用させて頂きたいです。\n\n大変難しい内容かと思いますが、もしご縁がございましたら、おさとう様の素敵なデザインで配信用企画ロゴを制作して頂きたいです。よろしくお願いいたします。\n\nhttps://x.com/rikoiriya/status/1918587847742767352", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@m___tst/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3430074, "client_id": 3145421, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6317d811/uploads/origins/016ac81a-4851-4b3b-8661-4637c66d2384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49df2ce3a15d3935aac60ba283788a6a", "srcset": "https://si.imgix.net/6317d811/uploads/origins/016ac81a-4851-4b3b-8661-4637c66d2384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49df2ce3a15d3935aac60ba283788a6a, https://si.imgix.net/6317d811/uploads/origins/016ac81a-4851-4b3b-8661-4637c66d2384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0395e66a0a074b9ae84e6e6dae147e30 2x, https://si.imgix.net/6317d811/uploads/origins/016ac81a-4851-4b3b-8661-4637c66d2384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02ba263c658123d3bee4eadc676795b5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6317d811/uploads/origins/016ac81a-4851-4b3b-8661-4637c66d2384?bg=%23fff&auto=format%2Cc