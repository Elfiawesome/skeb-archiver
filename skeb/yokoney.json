は引っ張られつつもそれを楽しんでいるような関係です。\n\nポーズやチュエーションは二人のデートをよこ様がこの二人から思いつくイメージでご自由に書いていただければと思います。(現代にアレンジしていただいてもＯＫです）仲良く楽しそうだと嬉しいです。下記に幾つか衣装をUPしておりますが、よこ様が描いてみたいもので構いません。衣装や髪形など自由にアレンジしていただいて大丈夫です！オリジナルの衣装も大歓迎です！\n\n\n是非私うちの子を描いていただけるととても嬉しいので、何卒ご検討のほど、宜しくお願い致します！！\n\nhttps://www.dropbox.com/sh/amhktg4ah65h6a0/AAB_4pmzxlhj38xHjL_Ar6Tma?dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yokoney/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3201190, "client_id": 2835127, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80efa293/uploads/origins/e944b263-d546-4248-90a4-e03c3c56514a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd0a3c7c7679995fc45069c0406d1b9f", "srcset": "https://si.imgix.net/80efa293/uploads/origins/e944b263-d546-4248-90a4-e03c3c56514a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd0a3c7c7679995fc45069c0406d1b9f, https://si.imgix.net/80efa293/uploads/origins/e944b263-d546-4248-90a4-e03c3c56514a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41b4fe867460e7e781bca08deb6d5355 2x, https://si.imgix.net/80efa293/uploads/origins/e944b263-d546-4248-90a4-e03c3c56514a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcfa7a399bd56395581a257c63d30ff8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80efa293/uploads/origins/e944b263-d546-4248-90a4-e03c3c56514a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf36645584769c121c0b80352a5a3ba8", "srcset": "https://si.imgix.net/80efa293/uploads/origins/e944b263-d546-4248-90a4-e03c3c56514a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf36645584769c121c0b80352a5a3ba8, https://si.imgix.net/80efa293/uploads/origins/e944b263-d546-4248-