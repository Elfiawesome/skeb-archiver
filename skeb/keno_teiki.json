fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e3a2d3383794444dc04a6041c8fa572b 3x"}, "body": "こんにちは。あなたのアートは素晴らしいです!!!!💖💖 私のオークのローザを描いてくれませんか？\n彼女はバラを愛する繊細で素敵な女性で、ワインと歌が好きなんです。\nhttps://imgur.com/a/0xBkq3N\nhttps://skeb.jp/@yrhruaa/works/7\n\nこの白いドレスを着た彼女を見てみたいですね。\nhttps://drive.google.com/drive/folders/160szUmd1w8BFEcOcwgZ6MiLewV1KLTa1\n\n構成はお任せしますが、何か紫や青の色のものを作ってください彼女の好きな色だから。\n\n全身を描かなくてもいいですし、描きにくい細部を簡略化しても構いません。受け取っていただけると嬉しいです。\nありがとうございました!!!💞💞💞\n\nhttps://imgur.com/a/0xBkq3N", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@keno_teiki/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 805940, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7bbdcb60/uploads/origins/2b776d77-6e23-4a1d-9400-80e5953e6897?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f58485db133e189d5a5e93da78f018c", "srcset": "https://si.imgix.net/7bbdcb60/uploads/origins/2b776d77-6e23-4a1d-9400-80e5953e6897?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f58485db133e189d5a5e93da78f018c, https://si.imgix.net/7bbdcb60/uploads/origins/2b776d77-6e23-4a1d-9400-80e5953e6897?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf592cf87cf0d67774d7c3b0b809c3b6 2x, https://si.imgix.net/7bbdcb60/uploads/origins/2b776d77-6e23-4a1d-9400-80e5953e6897?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f4146e6eac48d473ba64ea444398481 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7bbdcb60/uploads/origins/2b776d77-6e23-4a1d-9400-80e5953e6897?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96802710f464365ee87e33ee76416af6", "srcset": "https://si.imgix.net/7bbdcb60/uploads/origins/2b776d77-6e23-4a1d-9400-80e5953e6897?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96802710f464365ee87e33ee76416af6, https://si.imgix.net/7bbdcb60/uploads/origins/2b776d77-6e23-4a1d-9400-80e5953e6897?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e6e77419abd1e3decce74a5371970db3 2x, https://si.imgix.net/7bbdcb60/uploads/origins/2b776d77-6e23-4a1d-9400-80e5953e6897?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16149a78d0ebddfa9ab469f9b84d7369 3x"}, "body": "𝙠𝙚𝙣𝙤様こんにちは\nUTAU音源配布動画のイラスト一枚お願いしたいです\n\n配布の曲は蜂屋ななし（栗山夕璃）様の「ディジーディジー」\nhttps://youtu.be/5iymwRXrkZA\n自音源の「黒穴楽」「黒穴舞」を使用します、\n場所は海です\n夏っぽい服で大丈夫です\nサイズは1980x1080です\n良ければ音源部分と背景レイヤーを分けて\nPDS形式で納品できれば助かります\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1pOvtt2MOjrSmOtxfvTUWVrkg1tx0bTjn?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@keno_teiki/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 805940, "client_id": 350566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1aaf14f7/uploads/origins/a8307f02-7648-44b2-b26c-0a842a7248ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3f775f4f7f551659a75c32c0056da88", "srcset": "https://si.imgix.net/1aaf14f7/uploads/origins/a8307f02-7648-44b2-b26c-0a842a7248ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3f775f4f7f551659a75c32c0056da88, https://si.imgix.net/1aaf14f7/uploads/origins/a8307f02-7648-44b2-b26c-0a842a7248ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc0240239b27def2bf68201d57d582c4 2x, https://si.imgix.net/1aaf14f7/uploads/origins/a8307f02-7648-44b2-b26c-0a842a7248ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35030f0a3f7323ac8d2a458b49d8418f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_