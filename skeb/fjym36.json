_urls": {"src": "https://si.imgix.net/1f146fa2/uploads/origins/4105f75b-2f9f-4bce-8c94-68664f31a1c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28cfb3d49344386dad96511964e60dbc", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2550258, "client_id": 3040392, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@fjym36/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2550258, "client_id": 1074147, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95445c51/uploads/origins/14cfdc13-6d93-4587-836e-43e1c09ba560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00f6aa0fa316f9fca193093d2677cd8b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95445c51/uploads/origins/14cfdc13-6d93-4587-836e-43e1c09ba560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52e9428b5710249913b92f0a79f603c9", "src_set": ""}, "body": "こんにちは、素晴らしいアート作品のご応募をお待ちしております。\n特集を組んでください：ヤスミン・スンディール（私のOC）。\n手作りのサンドイッチを嬉しそうに手渡すヤスミンを見てみたい。\nポニーテールのヤスミンをお願いします。\nヤスミンの服装は\n- 短い白いトップス／シャツ、\n- 短い（フリルのついた）黒いスカート、\n- 無地のペールブルーのエプロン。\nヤスミンにサンドイッチを（P.O.V.に向かって）差し出す／与えるようにさせてください。\n見せ場：膝から上。\n背景：薄いピンクの無地。\nその他のポーズや詳細は、あなたの裁量にお任せします。(テキストなし）。\n別バージョンもぜひお願いします：\n- ヤスミンは全裸、\n- ヤスミンの手は空だが、まだ開いている、\n- ヤスミンの手や腕は下半身を隠している（検閲の必要はない）、\n- ヤスミンはかなり興奮しているようだ。\nありがとうございました！💕", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fjym36/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2550258, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f3162ae/uploads/origins/a16b1dbf-21fb-4fec-8e6f-4d4adc8e0103?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a4e17dda6d1020430755a9504d03058", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f3162ae/uploads/origins/a16b1dbf-21fb-4fec-8e6f-4d4adc8e0103?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=717bbbaf46076adfd43d9682e2bc8572", "src_set": ""}, "body": "初めまして\nアピールありがとうございます。\nオリジナルキャラの全身立ち絵で、昭和初期の農家の20歳代中ごろ、\n両腕を高手小手に縛られ胸を出した\n純朴な感じの黒髪女性のイラストをリクエストしたいです。\n表情は泣いている感じにしてほしいです。\n体型、髪型、構図等はお任せします。\n恰好\n野良着に、もんぺ、地下足袋履を履いています。\n野良着の色は紺、模様は絣模様にしてほしいです。\nもんぺはへその辺りで紐を結ぶ袴式、長さはくるぶしまで、\n色、模様は濃い紫系の縞模様で脇は袴の様にスリットを開けてほしいです。\n地下足袋はくるぶしの上までの長さ、色は黒にしてほしいです。\n服装の大まかなイメージは資料urlをご参照ください。\nもんぺイメージ\nhttps://www.dropbox.com/s/27dregu6fv4xgh3/ms.jpg?dl=0\n地下足袋イメージ\nhttps://www.dropbox.com/scl/fi/0dlq0el8hrwkh15ocjvm7/tb.png?rlkey=id9szwe2vs7xqr6f46enheggn&st=gqb9dkf7&dl=0\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fi/s6470qhlwdftz8kzbg16s/nk.jpg?rlkey=ve4te44hezclvf9gbnn6zsiw2&st=mglg9oaa&dl=0", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fjym36/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2550258, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c091df9b/uploads/origins/855a54fb-11bc-4793-a153-737ec6049d34?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=3f3b4021300bcd4c17aa21ed0bb11d69", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c091df9b/uploads/origins/855a54fb-11bc-4793-a153-737ec6049d34?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200