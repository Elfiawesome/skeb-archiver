クエストを送信いたします。\n2人の出会いは大学でウィルくんが留学生、千景が日本の普通の生徒です。\n千景がウィルくんにイヤホンでなにを聴いているのか訊ねたのが仲良くなったきっかけです。\n千景はよく喋りますが、ウィルくんは割と寡黙寄りです。\n一応ウィルくんが攻めで、千景が受けと行った設定になっています。\nその他詳細は資料を参考にしていただけると幸いです。\n先生の描く背景がとても大好きなので出来れば背景有りでお願いしたいです。(人物の描写範囲狭めでも大丈夫です)\n構図等は全てお任せします。\n金額に不備等あれば再送してください。何卒よろしくお願いいたします！\nhttps://drive.google.com/drive/folders/1d-v0Nps9I8v933fOjdjNZSXEznN_IWSd\n\nhttps://drive.google.com/drive/folders/1d-v0Nps9I8v933fOjdjNZSXEznN_IWSd", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mokusubzu/works/297", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3268693, "client_id": 3612713, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/77f629bf/uploads/origins/90e34d84-9052-4d09-9628-33136073637a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=242787b87b77846ea5983d0038188e90", "srcset": "https://si.imgix.net/77f629bf/uploads/origins/90e34d84-9052-4d09-9628-33136073637a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=242787b87b77846ea5983d0038188e90, https://si.imgix.net/77f629bf/uploads/origins/90e34d84-9052-4d09-9628-33136073637a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5ae84a53811144c095ad7cbfe48468a 2x, https://si.imgix.net/77f629bf/uploads/origins/90e34d84-9052-4d09-9628-33136073637a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=339f2f87107bdf6797f6e2141d166f38 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/77f629bf/uploads/origins/90e34d84-9052-4d09-9628-33136073637a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13d710c94acd2baa431ff64bf766f805", "srcset": "https://si.imgix.net/77f629bf/uploads/origins/90e34d84-9052-4d09-9628-33136073637a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&b