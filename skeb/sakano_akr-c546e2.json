3-408c-47b7-b537-2c30ecd34798?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a34ef7c4f2078dc46cf8a5bf38c0dc8", "srcset": "https://si.imgix.net/97195aa4/uploads/origins/5f324e43-408c-47b7-b537-2c30ecd34798?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a34ef7c4f2078dc46cf8a5bf38c0dc8, https://si.imgix.net/97195aa4/uploads/origins/5f324e43-408c-47b7-b537-2c30ecd34798?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ba19dc429a63026d2a7d1eef89db75b 2x, https://si.imgix.net/97195aa4/uploads/origins/5f324e43-408c-47b7-b537-2c30ecd34798?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2c9a5224fc3af408d3ead665bcb134f8 3x"}, "body": "こんにちは、さかの先生。\n\nいつもちびカンナのイラストを楽しみにしています。\n先生のちび生徒たちの作品が本当に大好きなので、これからもずっと描き続けていただけたら嬉しいです。\n\n今回、ちびカンナとオリジナルサイズのカンナ（でかカンナ？）の交流シーンをお願いしたいです。\n\n具体的なイメージとしては、\n\nでかカンナがちびカンナに初めて会った時、少し戸惑っている様子。\n（この子は一体誰だ…？みたいな感じで）。\n\nちびカンナが友好的に近づいて、食べ物を渡すなどの親切な行動を見せて。\n\n最終的に、二人が並んで座っている、またはちびカンナがでかカンナの膝の上に座っている、\nあるいはでかカンナがちびカンナの頭をなでている、といったような仲睦まじい場面。\n（「まあ、いいか…」という雰囲気で）。\n\nまた、もしご都合が合えば、そばにアコ犬など他のキャラクターがいても大丈夫です。\n\n具体的なシチュエーションやセリフなどの細かい部分は、先生にお任せいたします。\n\n二人が仲良く、幸せそうにしている姿を見るのがとても楽しみです。\n\nどうぞよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakano_akr/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3138586, "client_id": 3653934, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f97ff1cf/uploads/origins/82308c63-ac44-40ff-b36b-4f861f1dc5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d29899d08597ce549aba54d6dc0553d1", "srcset": "https://si.imgix.net/f97ff1cf/uploads/origins/82308c63-ac44-40ff-b36b-4f861f1dc5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d29899d08597ce549aba54d6dc0553d1, https://si.imgix.net/f97ff1cf/uploads/origins/82308c63-ac44-40ff-b36b-4f861f1dc5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47065c5fe992a4fc77e63d6fefcf4124 2x, https://si.imgix.net/f97ff1cf/uploads/origins/82308c63-ac44-40ff-b36b-4f861f1dc5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18200e7623b4924a9c6029f0bf09c5f9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f97ff1cf/uploads/origins/82308c63-ac44-40ff-b36b-4f861f1dc5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4af31ae9c4822d9139ebae56521492ee", "srcset": "https://si.imgix.net/f97ff1cf/uploads/origins/82308c63-ac44-40ff-b36b-4f861f1dc5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4af31ae9c4822d9139ebae56521492ee, https://si.imgix.net/f97ff1cf/uploads/origins/82308c63-ac44-40ff-b36b-4f861f1dc5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3d915f4b926010a2fa77425fa09bc912 2x, https://si.imgix.net/f97ff1cf/uploads/origins/82308c63-ac44-40ff-b36b-4f861f1dc5e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d11ebf9f07455af6d973db51cc5b61f3 3x"}, "body": "こんにちは、さかの先生。\nいつも素敵なちびカンナのイラストをありがとうございます。\n\n今回はちびカンナのイラストをお願いしたいと思います。\n内容は、ちびカンナが料理用のエプロンを身につけ、料理を手に持ち、「召し上がれ」と差し出しているシーンです。\n具体的なお料理としてはカツ丼を考えておりますが、もし先生がより良いアイデアをお持ちでしたら、お任せいたします。\nもし可能でしたら、料理しているシーンも一緒に描いていただけると嬉しいです。\n\nまた、アコ犬も登場できるシーンがあれば、ぜひ一緒に描いていただきたいです。\n\nイラスト全体の雰囲気は、見ていてほっとするような温かい感じを希望しております。\n\nお忙しい中すみませんが、どうぞよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakano_akr/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3138586, "client_id": 3231620, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8bf7983f/uploa