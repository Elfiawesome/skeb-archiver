る2人\n冬場にお互い遠慮なく雪玉を投げ会うシチュ\n\n・高校の入学式の2人\n高校の入学式で桜の下で2人で話しているor写真を撮っているシチュ\n\n\n【自探索者HO2について】\n女性 168cm 一人称「私」\n基本敬語、マコトに対してのみタメ口\n明るく元気、距離感が近いように思えて程よい距離を保つ。気になることに集中すると周りが見えなくなるタイプ。\n元々引っ込み思案な性格だったが中学デビューし、隣の席になったマコトに自分から声をかけた。\n好きな物：ご飯なら焼肉。果物はいちご、メロン 甘いものも好き\n\n【資料】\n一部複雑なビジュをしているので簡略化して頂いて大丈夫です！\nhttps://drive.google.com/drive/folders/1y03PqLqVJVAXtIpFFZW7wQ37NJBfzSnD\n\n【使用方法】\n個人利用の範囲で印刷（グッズ）やスマホもしくはパソコンの待ち受けなどに利用したいと考えています。\n\n\nskebでの依頼は初めてなので至らない点があるかと思いますが、もしご縁がありましたらよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1y03PqLqVJVAXtIpFFZW7wQ37NJBfzSnD", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 346236, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🍧佐倉🍨", "screen_name": "skr330__", "avatar_url": "https://pbs.twimg.com/profile_images/2058206961292935168/ZCz7qAOW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1139208092468432896/1772302316/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "novel"}], "banned": false, "nc": 161}, {"id": 813632, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "前山ちぇ～🍒", "screen_name": "cherichuxx", "avatar_url": "https://pbs.twimg.com/profile_images/1981601974513455104/veQYBi3s.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3017604953/1761272244/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 2353910, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "定規❤️‍🔥", "screen_name": "vat0uq", "