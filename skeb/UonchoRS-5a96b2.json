://gyazo.com/9d1120690a45ecc8ce58c6937010270d\n・構図、シチュエーション等：こちらのイラスト(https://www.pixiv.net/artworks/142819291)の青々と輝くブルーや雰囲気がとても素敵でしたので、夏の海をバックにしたシチュエーションをお願いしたいです。その他は先生の思い浮かんだイメージにお任せしますが、大きな胸や太ももを見せたスタイルが魅力のキャラでもありますので全身または膝から上が映るような、もしくはお尻が映るような構図やポーズをお願いします。\n・その他：フォックスフェイスがお供に連れている狐の描写についてはお任せします。\n\n雨音澄先生の魅力的な絵柄で推しキャラクターを見ることができればとても嬉しいです。以上、キャンペーン終了間際で恐縮ですがよろしければご検討の程よろしくお願いいたします。\n\nhttps://flowerknightgirl.game-info.wiki/d/%a5%d5%a5%a9%a5%c3%a5%af%a5%b9%a5%d5%a5%a7%a5%a4%a5%b9#", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@UonchoRS/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3879714, "client_id": 2410184, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d61f162/uploads/origins/26cf957c-761e-4963-81da-b050e7ba1c94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fd21e381e142bf1773643a879638e06", "srcset": "https://si.imgix.net/3d61f162/uploads/origins/26cf957c-761e-4963-81da-b050e7ba1c94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fd21e381e142bf1773643a879638e06, https://si.imgix.net/3d61f162/uploads/origins/26cf957c-761e-4963-81da-b050e7ba1c94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4abcf44de733d9886f111f42949a7b5e 2x, https://si.imgix.net/3d61f162/uploads/origins/26cf957c-761e-4963-81da-b050e7ba1c94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51e9d9ecde48c4023fcf0920f5197fe1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d61f162/uploads/origins/26cf957c-761e-4963-81da-b050e7ba1c94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88aa6be120af0b28ce6ee06ade20c9fa", "srcset": "https://si.imgix.net/3d61f162/uploads/origins/26cf957c-761e-4963-81da-b050e7ba1c94?bg=%23fff&auto=form