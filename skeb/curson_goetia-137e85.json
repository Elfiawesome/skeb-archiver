re": true}, {"path": "/@curson_goetia/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2464376, "client_id": 2168110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dcb370c5/uploads/origins/691aed80-1dff-45d7-bc58-3a6ce0b34da4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85e3c0121e4abe8f01a1f72c17886f39", "srcset": "https://si.imgix.net/dcb370c5/uploads/origins/691aed80-1dff-45d7-bc58-3a6ce0b34da4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85e3c0121e4abe8f01a1f72c17886f39, https://si.imgix.net/dcb370c5/uploads/origins/691aed80-1dff-45d7-bc58-3a6ce0b34da4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b1d3e390ff74b7c68220841f8b89db5 2x, https://si.imgix.net/dcb370c5/uploads/origins/691aed80-1dff-45d7-bc58-3a6ce0b34da4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81751bce8a7311b77ccf2ebdc2a4a0d0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dcb370c5/uploads/origins/691aed80-1dff-45d7-bc58-3a6ce0b34da4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=728a04274e4552cdfde81533280510d3", "srcset": "https://si.imgix.net/dcb370c5/uploads/origins/691aed80-1dff-45d7-bc58-3a6ce0b34da4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=728a04274e4552cdfde81533280510d3, https://si.imgix.net/dcb370c5/uploads/origins/691aed80-1dff-45d7-bc58-3a6ce0b34da4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e5e699ad2a5118ef8775dd791abca7d 2x, https://si.imgix.net/dcb370c5/uploads/origins/691aed80-1dff-45d7-bc58-3a6ce0b34da4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=26ce7c5b86f207401a2e8361a12d269b 3x"}, "body": "はじめまして！\n絵柄が気になったのでご依頼しました。\nもしよろしければ、うちのOCの「土御門ノア」をお願いすることは可能でしょうか？ \n参考までに設定は以下のとおりですが、自由に描いていただいて構いません。\n███\n土御門 乃亜（つちみかど のあ）\nウルフショートの少女。ベレー帽を被り左手薬指に指輪をしている。\n帰国子女で夏休みは海外で過ごす期間の方が長い。（母親の母国に幼なじみの恋人がいる）\n\n瑠璃の魔法使いの二つ名と星（力場）に干渉する能力を持つ。\nあらゆる力場を自在に歪める事が出来る事から、敵の攻撃をねじ曲げる事で、自分や味方を守ることに長けていた。守りの要であると同時に活発な性格だった事もあり、仲間内の精神的な支柱だった。\n\n誰よりも能力の開花が進んでいた事もあり、海外渡航中に悪魔達からの集中攻撃を受けながらも単身で逆に全滅させている。\nだが帰国途中、搭乗した飛行機ごと敵の攻撃を受けて他の乗客と共に洋上へ落下。\n落下する飛行機内での敵の撃退と乗客の救助に持てる力の限りを尽くすが、旅行先で受け続けた敵の集中攻撃への対処による度重なる過度な能力負荷の蓄積からか、戦闘中に突如オーバーロードを起こしてしまう。何とか敵の撃退には成功するが、乗客の無事を確認するとそのまま力尽きて洋上に沈んだ。\n\n土御門乃亜の死は、空港で彼女を待っていた仲間たちにも、その旅客機の墜落の報せと彼女が仲間たちに残していた防御フィールドの消失の二つから、すぐに察せられる所となる。\n\n土御門乃亜の死後、彼女の父親が彼女に代わって仲間たちのサポートを行っている。\n███\n使用用途は個人活動全般(小説の挿絵等、SNSや個人サイト等でのキャラクター紹介・個人活動の告知等)を考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-DcMbFogyxGgeHc_yHapPPyQpWBnHoyO", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 61633, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ゆち@Skeb募集中🍀✨", "screen_name": "yuchi_coconala", "avatar_url": "https://pbs.twimg.com/profile_images/1173905584183074819/2xaE4COn.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1055720756556980224/1568724055/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 0}, {"id": 1301062, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "子鹿", "screen_name": "dosei_no_kozika", "avatar_url": "https://pbs.twimg.com/profile_images/1441425774729314323/jsr8Ua6I.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1288708926368702464/1679311303/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", 