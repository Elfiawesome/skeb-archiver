力性」を表します。\n・バクは「優しさ」「思いやり」「悲しみ」を表します。\n※これらの情報は、絵を描く際の参考になればと思い付与したものですので、\n　描かれるイラストに特に反映する必要はありません。\n\nお手隙の際に、何卒よろしくお願い申し上げます。", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Twindeerbolos/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2236548, "client_id": 2239089, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a924190e/uploads/origins/93dfc370-8df4-43d6-b3ed-28fa47bf55dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d00cb2ce6c224eaf7f6d5968fdd9f1f", "srcset": "https://si.imgix.net/a924190e/uploads/origins/93dfc370-8df4-43d6-b3ed-28fa47bf55dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d00cb2ce6c224eaf7f6d5968fdd9f1f, https://si.imgix.net/a924190e/uploads/origins/93dfc370-8df4-43d6-b3ed-28fa47bf55dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0181913b3cc0282240f02d8942b86c1 2x, https://si.imgix.net/a924190e/uploads/origins/93dfc370-8df4-43d6-b3ed-28fa47bf55dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5033aa75bf9be11541e2fde6f0f6ee3c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a924190e/uploads/origins/93dfc370-8df4-43d6-b3ed-28fa47bf55dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e1e35c81b7c5b023ebc44d29a2741fd", "srcset": "https://si.imgix.net/a924190e/uploads/origins/93dfc370-8df4-43d6-b3ed-28fa47bf55dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e1e35c81b7c5b023ebc44d29a2741fd, https://si.imgix.net/a924190e/uploads/origins/93dfc370-8df4-43d6-b3ed-28fa47bf55dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2703634226970bbfbdbd42c9ad496604 2x, https://si.imgix.net/a924190e/uploads/origins/93dfc370-