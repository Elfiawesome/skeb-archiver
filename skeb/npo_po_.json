どはお任せします。\n\n桜弥（おうみ）\n17歳、166cm、Dカップ。ボブヘアー。姉がいるが、姉が巨乳で自分が普通なのがコンプレックス。その割にオシャレのためなら胸をアピールすることも忘れない。姉がコスプレ好きで、それに付き合っていろんな服を着させられたりしている。髪が短いのは姉にアレンジさせられまくるのを回避するため。\n髪にインナーカラーが入っている（三面図参照）目の色はインナーカラーと同じで緑ではないです（AIで資料を制作しているためややこしいですが、三面図参考でお願いします）\n\nもしご縁がありましたら、よろしくお願いします。\nhttps://drive.google.com/drive/folders/1ldnQ85FiD2bewf2m3tZyI8EBekVtrdmj\nhttps://drive.google.com/drive/folders/1vEsUUbtBMMe0u8itbaKtlOKZw4UYNphw", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@npo_po_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3506839, "client_id": 547879, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f051db9/uploads/origins/d660b1a7-82e0-42c0-ac2f-c8766b1a53d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c05959da4cd82eab6636c7ada0eb8ab", "srcset": "https://si.imgix.net/6f051db9/uploads/origins/d660b1a7-82e0-42c0-ac2f-c8766b1a53d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c05959da4cd82eab6636c7ada0eb8ab, https://si.imgix.net/6f051db9/uploads/origins/d660b1a7-82e0-42c0-ac2f-c8766b1a53d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b10306fcf5d012ce477955ee82eafac 2x, https://si.imgix.net/6f051db9/uploads/origins/d660b1a7-82e0-42c0-ac2f-c8766b1a53d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa8b578e6d9eb1a892c20866cc76edc0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f051db9/uploads/origins/d660b1a7-82e0-42c0-ac2f-c8766b1a53d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da03c878e49170d23bdf5de93ae11dcf", "srcset": "https://si.imgix.net/6f051db9/uploads/origins/d660b1a7-82e0-42c0-ac2f-c8766b1a53d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da03c878e491