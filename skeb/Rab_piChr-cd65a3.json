w=200&h=200&blur=200&s=3c33ea7aa2edabda678a6204886f702a, https://si.imgix.net/72b0ecd8/uploads/origins/3b0db3d1-7b84-467e-8a7b-4bcc1ad1e927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=264a76ee3e9a7dcdaa1a1cc4f9fa79d6 2x, https://si.imgix.net/72b0ecd8/uploads/origins/3b0db3d1-7b84-467e-8a7b-4bcc1ad1e927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=44bdaee89bbab0c9fe3b604a04e877f4 3x"}, "body": "こんにちは。あなたの作品の美しさと雰囲気が大好きです！ぜひ私のキャラクターのイラストを描いていただけないでしょうか！\n\n「ウィニー」・ウィンストン・オブライエン：\nhttps://drive.google.com/drive/folders/1459FIkJWbU78XknLqs8cuTrp7rhAc26a\n\nウィニーは、ライバル企業をスパイし、破壊工作を行うために送り込まれた潜入工作員です。彼はスパイ対象である男性に恋をしてしまい、現在のボスたちに反旗を翻す方法を模索しました。しかし、そのすべてはうまくいかず、彼は捕まってしまい、刑務所で痛ましく悲しい最期を遂げます。 \n\n彼は変装の達人だ。髪を金髪に染め、青いコンタクトレンズを装着し、そばかすや色白の肌をメイクで隠している。本来はごく平凡で退屈な男だが、美しく刺激的な人物になるべく全力を尽くしている。\n\n彼はジョージ・オーウェルの小説『1984』に登場するウィンストンとオブライエンの2人のキャラクターをモデルにしている。 \n\nテーマ：ハチミツ、煙、お金、独房、偽装、白い壁、防犯カメラ、全体主義、禁じられた情事\n\nhttps://drive.google.com/drive/folders/1459FIkJWbU78XknLqs8cuTrp7rhAc26a", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Rab_piChr/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3633882, "client_id": 1416666, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01e2141b/uploads/origins/69599b40-a10f-4c8c-a34f-a54d1b342ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29820d0270154f527360032ba5441f2b", "srcset": "https://si.imgix.net/01e2141b/uploads/origins/69599b40-a10f-4c8c-a34f-a54d1b342ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29820d0270154f527360032ba5441f2b, https://si.imgix.net/01e2141b/uploads/origins/69599b40-a10f-4c8c-a34f-a54d1b342ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8a632c37b83fa5d833b9a7820334e8b 2x, https://si.imgix.net/01e2141b/uploads/origins/69599b40-a10f-4c8c-a34f-a54d1b342ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fba8eb5ba57d54de4058c6ffe385a70a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01e2141b/uploads/origins/69599b40-a10f-4c8c-a34f-a54d1b342ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfe1d694efcac3a3556189fc4c3804b3", "srcset": "https://si.imgix.net/01e2141b/uploads/origins/69599b40-a10f-4c8c-a34f-a54d1b342ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfe1d694efcac3a3556189fc4c3804b3, https://si.imgix.net/01e2141b/uploads/origins/69599b40-a10f-4c8c-a34f-a54d1b342ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0cde56214033430ca233ab284deb2eef 2x, https://si.imgix.net/01e2141b/uploads/origins/69599b40-a10f-4c8c-a34f-a54d1b342ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=97ce2b07e983aa684bbaf177d6a18298 3x"}, "body": "こんにちは！あなたのイラスト、本当に大好きです！もし可能であれば、私のオリジナルキャラクター（OC）のイラストを依頼したいです。エリアス（人間／26歳／175cm）彼は内向的で感情が繊細な性格で、不安げで物憂げな雰囲気を漂わせています。繊細で傷つきやすい印象があり、柔らかく優しい表情が似合います。\n\nサイラス（悪魔／30代半ばに見える／200cm） 彼は穏やかで落ち着いた存在感があり、静かな自信に満ちています。それにもかかわらず、威圧的なオーラを放っています。キャラクター設定：サイラスは表面的には落ち着いていて守り手のように見えますが、エリアスに対して強烈な執着と独占欲を抱いています。彼の愛情は優しくも抑制が効いており、まるでエリアスを守りつつも自分のものだと主張しているかのようです。 エリアスは、二人の関係が危険であることを自覚しつつも、自分の心の奥底まで真に見抜き、理解してくれるのはサイラスだけだと感じている。お時間をいただき、ご検討いただきありがとうございます！ https://drive.google.com/drive/folders/1zKYGU9Q9olaRodtapza2hQVkPU7aAGND?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Rab_piChr/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3633882, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/430d1505/uploads/origins/ee6730e5-e3eb-40aa-bfdb-57a59684d715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b6cbba661c7416b752ea43f66b05af0", "srcset": "https://si.imgix.net/430d1505/uploads/origins/ee6730e5-e3eb-40aa-bfdb-57a59684d715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b6cbba661c7416b752ea43f66b05af0, https://si.imgix.net/430d1505/uploads/origins/ee6730e5-e3eb-40aa-bfdb-57a59684d715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=713ff33e5f104d41320398eb661d2378 2x, https://si.imgix.net/430d1505/uploads/origins/ee6730e5-e3eb-40aa-bfdb-57a59684d715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46c7423f6e1d3ac4e111688312f0f4dc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/430d1505/uploads/origins/ee6730e5-e3eb-40aa-bfdb-57a59684d715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a76f01d35283e78ef18687e5ebc2813f", "srcset": "https://si.imgix.net/430d1505/uploads/origins/ee6730e5-e3eb-40aa-bfdb-57a59684d715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a76f01d35283e78ef18687e5ebc2813f, https://si.imgix.net/430d1505/uploads/origins/ee6730e5-e3eb-40aa-bfdb-57a59684d715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=560257a4afb64224ccae1547d566e5f0 2x, https://si.imgix.net/430d1505/uploads/origins/ee6730e5-e3eb-40aa-bfdb-57a59684d715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2e3a76afc23e557f35f915f9bc0c47c8 3x"}, "body": "ナカタ様こんにちは。\nskebでイラストをお見かけし、とても魅力的だったので、是非うちの子を描いていただきたくリクエストを送らせていただきました！\n\n資料の中から人物を好きに選んで自由に描いてください。\n設定を記載していませんが、受け取った印象のまま気楽に描いていただけたらと思います！\n純粋にナカタ様の描いたうちの子が見たい！という気持ちです！\n\n\n⚠中にBL表現が含まれる作品があるので苦手な場合はそのままキャンセルをお願いいたします。\n\n最後までお読みいただきありがとうございました。金額や内容に問題がありましたら、遠慮なく再送要請またはキャンセルをお願いします。\nお手数おかけしますがご検討のほど、よろしくお願します。\n\nhttps://drive.google.com/drive/folders/1a9hpLeNj9MAvkag4tv7bFpK6e5MKkskv", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Rab_piChr/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3633882, "client_id": 1491551, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f4e0ea9/uploads/origins/ce7067ad-57bb-484c-bf5c-e579a4f1e63f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bbd11252b545b1f6b1549e92d210c56", "srcset": "https://si.imgix.net/6f4e0ea9/uploads/origins/ce7067ad-57bb-484c-bf5c-e579a4f1e63f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bbd11252b545b1f6b1549e92d210c56, https://si.imgix.net/6f4e0ea9/uploads/origins/ce7067ad-57bb-484c-bf5c-e579a4f1e63f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b10eee80de302e8d4cae7d7106ca33e 2x, https://si.imgix.net/6f4e0ea9/uploads/origins/ce7067ad-57bb-484c-bf5c-e579a4f1e63f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82266a5a41a18ecf4610ef14acb9e6e3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f4e0ea9/uploads/origins/ce7067ad-57bb-484c-bf5c-e579a4f1e63f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ec8b7ab79772aef8fb72e188d6df4d7", "srcset": "https://si.imgix.net/6f4e0ea9/uploads/origins/ce7067ad-57bb-484c-bf5c-e579a4f1e63f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ec8b7ab79772aef8fb72e188d6df4d7, https://si.imgix.net/6f4e0ea9/uploads/origins/ce7067ad-57bb-484c-bf5c-e579a4f1e63f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6984dfab6a54996291e9f870848393ed 2x, https://si.imgix.net/6f4e0ea9/uploads/origins/ce7067ad-57bb-484c-bf5c-e579a4f1e63f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=94e4f9b5b88807df74f65d19e5e0f439 3x"}, "body": "こんにちは！あなたの作品がとても気に入りました。私のキャラクター、イリヤのイラストをぜひお任せしたいです。彼は元マフィアですが、独立してクリーニング店を営むために足を洗いました。しかし、贅沢な生活を維持するため、裏では犯罪活動を完全に断ち切ってはいません。昼間は普通の市民ですが、夜になると他のギャングの抗争で発生した死体を片付けるのです。 彼は病的なほどだが成熟したユーモアのセンスを持ち、非常にのんびりしていて狡猾で、感情的に動揺させにくい性格です。41歳という年齢で、この業界には長く身を置いています。イリヤの服装スタイルは非常に奇抜で派手で、常にチョーカー/カラーを着用しています。服装のスタイルはご自由に設定いただくか、過去に描かれたものの中からお選びください。\n\nクラブの照明のような環境でくつろぐ姿を描いてほしい。舞台は未来で、ネオンとレトロ調のテクノロジーが融合した世界観だ。モヒートのようなカクテルを楽しんだり、煙草を吸う姿も見てみたい。ただしポーズや動作、背景については自由に解釈して構わない。あなたが最良と思う表現をぜひ見せてほしい！\n\nhttps://drive.google.com/drive/folders/1u5bChbQlXDocUOE3OzruNPoupqlWHfg_?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Rab_piChr/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3633882, "client_id": 3224268, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fad999be/uploads/origins/799e98e1-80d0-45b5-ac54-fe3e4f8fab9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a68a036fcbbb0d0aded225883829a56d", "srcset": "https://si.imgix.net/fad999be/uploads/origins/799e98e1-80d0-45b5-ac54-fe3e4f8fab9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a68a036fcbbb0d0aded225883829a56d, https://si.imgix.net/fad999be/uploads/origins/799e98e1-80d0-45b5-ac54-fe3e4f8fab9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69482389aeaef4ba1b9bc4cad69ced5a 2x, https://si.imgix.net/fad999be/uploads/origins/799e98e1-80d0-45b5-ac54-fe3e4f8fab9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d25b0a3f3ee42a82a80da6cbd0d11361 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fad999be/uploads/origins/799e98e1-80d0-45b5-ac54-fe3e4f8fab9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c38f45943cc