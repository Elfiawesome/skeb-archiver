84c2-002473f80c35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=130198e42cba77cbece4c723983e3e55 2x, https://si.imgix.net/7dda61dc/uploads/origins/5e7fed83-f79c-4bc7-84c2-002473f80c35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1e745bc04862fc8e9981d955d6fcf5ab 3x"}, "body": "潮くりーく先生、はじめまして。\n\n葬送のフリーレンに登場するフェルンが半脱ぎの格好で自分で自分のおっぱいを気持ち良さそうに吸いながらシュタルクと激しく正常位セックスしてしまう絵をリクエストしてもよろしいでしょうか？\n\n希望する主な要素と内容は・・・\n・フェルンは両胸を曝け出し、ノーパンの格好でセックス\n・シュタルクは片方の手でフェルンの片方の胸をフェルンの口元まで寄せ、フェルンは夢中になって自分の乳首を丸ごと咥えながら自分の大きなおっぱいを自分で吸う\n・フェルンのもう片方のおっぱいも自分の乳首を吸った形跡があり、両胸に唾液が垂れている\n・フェルンのアソコからは大量の愛液が溢れ出ている\n・フェルンの体は汗まみれ、そして目は涙目+ハート目\n・シュタルクの描写は片腕と股間辺りでも構いませんが、彼の描写の程度は先生にお任せします\n\nシチュエーションに合ったエッチな台詞や擬音も入れていただけると嬉しいです。\n\n自分の乳首をネットリ舐めたり、自分の乳首を強く吸いながらイッてしまう差分もあると嬉しいですけど、負担になるようでしたら無くても結構です。\n\nファイル形式はpsdを希望します。\n\nご検討のほどよろしくお願い致します。\n\n\n参考URL:\nフェルン\nhttps://www.foriio.com/works/867196\n\n自分の乳を吸いながらセックス\nbit.ly/3FNwA2m\nbit.ly/31D1ZEf\nbit.ly/3HQdg3o", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sio_creek/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2327147, "client_id": 71755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2faf62ed/uploads/origins/592cf590-5a78-44ae-9c65-0ea1b2b38278?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0549f9b89ea63db97a020d9e852940c", "srcset": "https://si.imgix.net/2faf62ed/uploads/origins/592cf590-5a78-44ae-9c65-0ea1b2b38278?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0549f9b89ea63db97a020d9e852940c, https://si.imgix.net/2faf62ed/uploads/origins/592cf590-5a78-44ae-9c65-0ea1b2b38278?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2432a42d83f09f711ac2c4acfaf9e60 2x, https://si.imgix.net/2faf62ed/uploads/origins/592cf590-5a78-44ae-9c65-0ea1b2b38278?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a135872eccc1abc6f604d1baaae1ab78 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2faf62ed/uploads/origins/592cf590-5a78-44ae-9c65-0ea1b2b38278?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83a8fd51835b98fc72a733151554c269", "srcset": "https://si.imgix.net/2faf62ed/uploads/origins/592cf590-5a78-44ae-9c65-0ea1b2b38278?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83a8fd51835b98fc72a733151554c269, https://si.imgix.net/2faf62ed/uploads/origins/592cf590-5a78-44ae-9c65-0ea1b2b38278?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=31462a52ac1cbc4a31e8f6541cb09ebf 2x, https://si.imgix.net/2faf62ed/uploads/origins/592cf590-5a78-44ae-9c65-0ea1b2b38278?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=97a562027109937263580ab3463bcaed 3x"}, "body": "フェルンが最高だったので特殊シチュになりますが可能な範囲でお願いします！\n難しければ着衣超乳&特大着衣ボテ腹フェルンに侮蔑されるだけのシチュでも構いません\n書くかも程度ですがドM小説の挿絵に利用したいです\nキャラ名：フェルン\nシチュ：\nメカクレM男(目の描写はない方がいいです、もしくは顔描写不要です)が、着衣超乳&特大着衣ボテ腹姿のフェルンの皮/着ぐるみ(できれば皮優先)に擬態した触手皮/触手着ぐるみを強制装着させられ、\n内部で触手にペニスや前立腺を嫐られ内部で大量射精させられるドMホイホイシチュ\n皮/着ぐるみはゴミを見る冷めた目(顔の上部や目元まで影がかかり、ハイライトなし希望)状態で、変態マゾへの嫌悪を一切隠すことない侮蔑の表情を希望します\n\n皮は片乳だけで両手が簡単に沈む、頭&胴体以上のサイズかつ服越しにピンク色の勃起乳首がわかる着衣超乳と、超乳と同サイズの特大着衣ボテ腹(妊娠淫紋付き)姿で、\n服の中にギチギチに押し込まれた胸やボテ腹がよくわかる体勢で、\n皮内部で触手が暴れることで着衣超乳やボテ腹の皮越しに内部で触手が波打ってることがわかる表現(断面図ではなく衣装自体が波打っている感じ)を希望します\n\n立っているフェルン触手皮の立ち絵のスカート下から大量の精子交じりの粘液が溢れ、\nできれば内部で触手に嫐られているM男の姿がわかる透過差分or断面図差分、難しければ別枠でペニスや乳首、前立腺が嫐られている描写を希望します\n\n触手皮の内部は特濃粘液にまみれた触手地獄と化しており、ペニスや乳首を丸呑みにする吸引触手や吸盤ブラシ触手の群れが溢れていたり、\n前立腺責め用の産卵触手等純粋な快楽のみを与える、なるべくえげつない構造にして頂ければ幸いです\n可能でしたらM男の前立腺責めする産卵触手によるM男のボテ腹も希望します\n\n可能でしたら触手肉壁やダーク系の背景で、psd形式で射精前差分、粘液まみれの触手が蠢く水音や喘ぎ声等の効果音の有無、皮or着ぐるみの顔の上部の影と瞳のハイライトの有無をON/OFF切替表示希望です\n\n優先度低で口調や性格等お任せしますので触手皮自体が自我を持っている設定で、\n直接M男の脳内に語り掛けるエフェクトで、人間です