立ち向かうことを決意した。一連の事件を起こした後、警察に出頭し、ワグナーを自分の後見人にするよう仕組んだ。\n現在のワグナーに対する態度：気遣い、好奇心、親しみ、保護、そして「自分の支配から抜け出せる希望」として見ている\n彼の象徴動物はカワウソ🦦\n\nお好きな内容を自由に描いていただいて構いません。もし金額に見合わない場合は、再度リクエストを送っていただければ大変助かります！今回の依頼をお引き受けいただけましたら、本当に感謝いたします！\n\nhttps://drive.google.com/drive/folders/1H_KP1SbKS3V5HggDbwvkZRe1QVk2Z6aj?usp=share_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 326359, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "鳶山しほ", "screen_name": "10biyama", "avatar_url": "https://pbs.twimg.com/profile_images/2032882702391943168/nLeFAy68.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 796412, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "英倉はな", "screen_name": "hanakura333", "avatar_url": "https://pbs.twimg.com/profile_images/2121182806382702592/rHq-hbhd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1255561234188914690/1794312407/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 1057632, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "07", "screen_name": "sobakonattou07", "avatar_url": "https://pbs.twimg.com/profile_images/1844812683226619904/4AKjeuiK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2552540090/1728678149/1500x500", "appeal_receivable": true, "popular_creator_rank": 13, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptabl