むちむちのナイスボディを披露する\n（①マントを着ながら汗をかいている様子、②マントを大きく開く様子、③マントを完全に脱いで蟹股のポーズでナイスボディを披露する様子https://www.pixiv.net/artworks/91401333が各自一枚ずつあればと思います）\n（上記のイメージがまとまったサンプル：https://skeb.jp/@ALPHA_TYPE_01/works/6）\n\n〇差分：腋汗シミ、陰毛・腋毛なし、陰毛・腋毛あり、マイクロビキニ、裸を差分としてお願い致します。\n\nポーズや衣装などは各参考URLからご参考ください。\nご検討のほど、よろしくお願い致します。\n\nhttps://www.pixiv.net/tags/%E3%83%95%E3%82%A3%E3%82%AA%E3%83%AC%E3%83%BC%E3%83%8D/artworks?s_mode=s_tag", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hikitogu/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5c6461cc/uploads/origins/2ffaa956-6f47-424e-84e6-f686ce86b3b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81f86d460df5eb1e82d518411669a310", "srcset": "https://si.imgix.net/5c6461cc/uploads/origins/2ffaa956-6f47-424e-84e6-f686ce86b3b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81f86d460df5eb1e82d518411669a310, https://si.imgix.net/5c6461cc/uploads/origins/2ffaa956-6f47-424e-84e6-f686ce86b3b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=abd5940ffdea0d3bd526f0e8524a5629 2x, https://si.imgix.net/5c6461cc/uploads/origins/2ffaa956-6f47-424e-84e6-f686ce86b3b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a89f27818d92b7fa1d17562231305cf7 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 5928, "nc": 48}, {"path": "/@hikitogu/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 5928, "client_id": 79155, "vtt_url": null, "thu