ur=200&s=c04f032255bb71207d9094552d85f73d", "src_set": ""}, "body": "はじめまして、しゃけフレク先生！\nシンフォギアのファンアート、とても素敵ですね。\n\nぜひ、未来ちゃんとセレナちゃんがギガインナーの衣装を着て、仲良くハグしているところを描いていただけませんか？\n\nよろしくお願いします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@salmon_flake00/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1615afda/uploads/origins/86a2f003-0671-4598-a54c-c74056b5427e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2377b1b10d5fddacf429a0789a5873d3", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 549678, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 50, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@salmon_flake00/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 549678, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1721ffca/uploads/origins/b6c627f5-c25a-4f79-9a48-a6f9858f1b28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ce7b403c7be8cdf7ba5f9a47cf22487", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1721ffca/uploads/origins/b6c627f5-c25a-4f79-9a48-a6f9858f1b28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a20ec871df4348701e4c10fb865ea3c", "src_set": ""}, "body": "初めまして。\nイラストをご依頼したくご連絡しました。\n下記の内容で良ければ可能でしょうか？\n\n【作品】IS〈インフィニット・ストラトス〉\n【キャラクター】篠ノ之箒\n【服装】ISスーツ(専用機の白いスーツ)\n【構図】仰向けで機械に拘束されている(手足を大の字に広げられてではなく、寝そべった状態で二の腕から先、膝から先が機械に取り込まれている形)\n【シチュエーション】篠ノ之箒がISスーツ姿で機械のケーブル(触手)に機械姦されている。\n光がない死んだような目で無表情、涙も枯れて出ない。\nスーツに破れはなく、秘所の部分のスーツをズラして太いケーブルが前後に挿入されていて、腹部が膨らんでいる。\n胸もスーツの上から形が変わる程ケーブルに縛られて弄ばれている。\n口にも太いケーブル、耳には細いケーブルが数本挿入されている。\nもう抵抗なく、ただただ陵辱されている。\nそんなシチュエーションでお願いします。\n【その他】もし差分が可能でしたら、髪留めのリボンがない、ストレートヘアーの姿もお願いしたいです。\n\n可能でしたらで大丈夫ですので、ご検討お願いします。\n\nhttps://wikiwiki7.com/ISAB/index.php?%E3%80%90%E6%97%A5%E5%B8%B8%E3%80%91%E7%AF%A0%E3%83%8E%E4%B9%8B%E7%AE%92", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@salmon_flake00/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/34c9753f/uploads/origins/3a959876-ab21-4cb3-8f4a-f5026765bb53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36201e4ce39ffc486f5afaf712757814", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 549678, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@salmon_flake00/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/92c59e44/uploads/origins/27d63256-cf62-4b16-b87b-0d8743845c04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c904a33b4b982cbea6040e259107a8ef", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 549678, "client_id": 926866, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@salmon_flake00/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 549678, "client_id": 638851, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/273b4fc4/uploads/origins/b3e48cfe-35ef-4be8-9a3a-5aa38e5f43d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5d32da70fefbcc114c324260c712d81", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/273b4fc4/uploads/origins/b3e48cfe-35ef-4be8-9a3a-5aa38e5f43d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8cf15b7d72953e552c493543410dba80", "src_set": ""}, "body": "初めまして、依頼します。\n\n【キャラ】\n戦記絶唱シンフォギア　マリア・カデンツァヴナ・イヴ\n\n【シチュ】\n適合率の上昇実験として，戦姫絶唱シンフォギアG 10話で未来さんを改造していたようなポットに入れられ，中の触手に二穴責めされて散々イカされるシチュでお願いします。\n可能ならば下記の差分があるとうれしいです。\n難しいなら前者のみでお願いします\n①二穴責めを悔しそうな表情でこらえている\n②二穴責めが終わり触手が抜去され、ぐったりとしている\nhttps://www.pixiv.net/artworks/95696443\nの2,3枚目のような感じでお願いします。\n\n【構図】\nM字開脚で拘束されている状態\n\n【衣装】\nガングニールのギアインナー\n局部は破かれている。\n\n【その他】\n触手にはべっとりと愛液がまみれており，水中でもそのぬめりが確認できる…\nみたいな感じでお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@salmon_flake00/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 549678, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26efe3f7/uploads/origins/cd32c5f8-e7d4-42b0-98ed-b748e672b57f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3029f03b5acb4dffb8ba5e6b904e721", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26efe3f7/uploads/origins/cd32c5f8-e7d4-42b0-98ed-b748e672b57f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1d7faa20881459ae4adb1da38cb308d", "src_set": ""}, "body": "オートスコアラーのMicha JawkānとGarie Tûmânの2人をお願いします。\n協力してペニスをサービスする。\n\nMichaはとても多動でEager。\nGarieはイライラしていて、せっかち。\n\nhttps://mega.nz/folder/pJ9RVYJR#d6d295SKV-2OdCRWesfL1g", "nc": 177, "word_count": 0,