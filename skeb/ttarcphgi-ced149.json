d-bf3e-20a30a798e3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e55b407c35a4341685870acc86ef07e6, https://si.imgix.net/e6f9e943/uploads/origins/29591374-6d49-42dd-bf3e-20a30a798e3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9316b8140a4d9ed7f6548c172190e12 2x, https://si.imgix.net/e6f9e943/uploads/origins/29591374-6d49-42dd-bf3e-20a30a798e3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=061060d6453a664e14ac6194067f11ce 3x"}, "body": "ひづるです！お世話になっております！\nはったちの絵好きなのでリクエスト再送させていただいておりますが、体調やスケジュール的に無理のないようご検討いただければ幸いです！\nいよいよ冬という冷え込みだしあったかくしてね…🫂\n\n●内容\n「私立花ヶ丘高校秘密倶楽部」というTRPGシナリオに参加した、私のPCとNPC（デザインや設定はSKP様が作成）のイラストを描いていただきたく思います。\nリクエスト内容にシナリオのネタバレは含みません。\n\n●キャラの説明\n・柳樂 三燕（なぎら みつば）\n女の子、16歳、148cm。\n臆病かつ人見知りな性格で、基本的に小野道くんの横について回っている。小野道くんに対して全幅の信頼を置いています。\n\n・小野道 佑雨（おのみち ゆう）\n男の子、16歳、180cm。\n真面目で誠実。歳の割に落ち着いて見える。困っている人がいたら放っておかないタイプ。\n\n●関係性\n高校1年生で幼稚園の頃からの幼馴染であり恋人。2人ともオカルト研究部と弓道部の兼部です。\n登下校もいつも一緒で、雨の日は三燕が小野道くんの傘に入れてもらったりしています。\n\n●詳細\nはったち解釈が見たいのでおまかせとさせていただきたく…！\n服装などは描きやすいように省略・変更していただいて大丈夫です！\n\n●使用用途\n・個人鑑賞\n・相手方やセッション参加者への共有\n\nここまで読んでいただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/1LsWl7bpKaNFHW4bwG-ulOy6JMbe8rn3s", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ttarcphgi/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1901387, "client_id": 1686131, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/744a5a20/uploads/origins/2e6a06f7-61c0-45a1-8115-cdee7efa9d76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f7c3b619781700720a52b718406ec73", "srcset": "https://si.imgix.net/744a5a20/uploads/origins/2e6a06f7-61c0-45a1-8115-cdee7efa9d76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f7c3b619781700720a52b718406ec73, https://si.imgix.net/744a5a2