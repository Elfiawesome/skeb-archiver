fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d89b1e44ff89a3dab8c2a32d38ba2b4d", "src_set": ""}, "body": "金額を上げて再度依頼させてください。\n\n受け：ヨモギちゃん \n攻め：ミシロちゃん の組み合わせでの技絵をリクエストします。 \n 技と構図の資料はこちらになります。 \nhttp://sinon.cside.biz/TKM/plutof/image/1140k.jpg \n技はゴッチ式のパイルドライバーです。 \n構図はこのままで良いのですが、希望の技絵は資料から1秒後の 「脳天をマットに打ちつけられた瞬間」になります。 \nこの体勢のまま脳天からマットに打ちつけられて失神KOされているヨモギちゃんが見たいということです。  \n受けのヨモギちゃんは挿入式パイルドライバーを食らっているイラストの愛海ちゃんのような表情と、思い切りゴンッ！とマットに打ちつけられている衝撃と威力が伝わる感じをお願いします。\nマットに頭がちょっとめりこんでいる形です。\nhttps://www.pixiv.net/artworks/97805946 \nミシロちゃんの表情はシチュエーションに合いそうな表情をお任せ致します。 どうかお願い致します。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Un_knoooo_WN/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 983992, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2922c684/uploads/origins/3fdc2e5e-a5e3-42de-9b10-e9c7beef2fad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28b7e3abbd2a3b35df9984f85d5bb764", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2922c684/uploads/origins/3fdc2e5e-a5e3-42de-9b10-e9c7beef2fad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=594ca56d779078f63b5235463bb4b01b", "src_set": ""}, "body": "以前pixivでルリカさんに股裂きのリクエストをさせていただいた者です。この度は素敵なイラストを描いていただきありがとうございました。\n今回もルリカさんのリョナ絵が欲しくリクエストさせていただきました。\n\n相手のファイター君（？）に急所蹴りを喰らって悶絶ダウンしてしまうというイラストをお願いします。前回同様に実況もつけていただきたいです。\n\n蹴りの構図は他の方のリクエストでファイター君が金的を喰らってたやつがありましたがそれと同じような感じでお願いします。両脚の踵が浮き上がるくらい勢いよく蹴り上げられてほしいです。\nついでにイラストの端か専用の一コマに脚がめり込んでる股間をズームで描いていただけると嬉しいです。\n\n要望が多くなってしまい申し訳ございませんがよろしくお願いします。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Un_knoooo_WN/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 983992, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07a0f25b/uploads/origins/1df7fbe7-e829-4824-b22d-887e040ed5ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bb256601861a7843ecfc6777c1ec627", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/07a0f25b/uploads/origins/1df7fbe7-e829-4824-b22d-887e040ed5ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a18872ba958f7f966ba5dd1def5912f5", "src_set": ""}, "body": "お会いできて嬉しいです！\n先生のオリキャラ すももちゃんと みしろちゃんのレスリングの絵を作ってください。\n\nすももちゃんが みしろちゃんをつかまえて 強力なニーキックで 腹部を価格\nhttps://i.imgur.com/AxQehIo.jpg\n\n先生の前作のように腹部が衝撃を受けた効果を分かるようにしてください!\nhttps://i.imgur.com/nlBbsP5.gifv\n\n先生の前作のように腹部が膝攻撃の衝撃を分かるようにしてください！\nhttps://www.pixiv.net/artworks/99255133", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Un_knoooo_WN/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 983992, "client_id": 276525, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6dbf7e8c/uploads/origins/cb74769f-5684-4cab-bc73-e192b23df44e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5c3cb6a6d59e7cca403683e74783ba8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6dbf7e8c/uploads/origins/cb74769f-5684-4cab-bc73-e192b23df44e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e3676c5f1f9be6c5393c6693bc02cac", "src_set": ""}, "body": "以前足四の字固めのイラストを描いて頂いたCMHです。\nその節は素敵なイラストをありがとうございました。\n\n今回は前回と攻守を逆にして\n私が3Dツールで投稿しているアニー・コーラル(資料右)が相沢あゆみ(資料左)にボディシザースを掛けられているところを描いて頂けないでしょうか。\nアニー・コーラルは痛そうな表情、相沢あゆみは意地悪そうにニヤニヤしている表情でお願い致します。\n\n■キャラクター資料URL\n　　https://i.imgur.com/67PD7Qh.jpeg\n\n以上、ご検討の程よろしくお願い致します。