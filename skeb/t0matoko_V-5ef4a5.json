薔薇庭園へ逃げがちです。\nよくティムールはリリヤに皮肉を言ったりしますが、長年彼女の世話をし続けている為親代わりみたいです。\n\n任せて申し訳ないのですが漫画の内容はお任せします。 どんな解釈でも構いません。どうかご検討ください。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@t0matoko_V/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1857491, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d91494ec/uploads/origins/2e2bb429-e842-4226-a58d-ba2241a053c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df9641bc7b3c273c2a95f7bfd5ebec4d", "srcset": "https://si.imgix.net/d91494ec/uploads/origins/2e2bb429-e842-4226-a58d-ba2241a053c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df9641bc7b3c273c2a95f7bfd5ebec4d, https://si.imgix.net/d91494ec/uploads/origins/2e2bb429-e842-4226-a58d-ba2241a053c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=605a929e9cc865cba1955406df69a5ee 2x, https://si.imgix.net/d91494ec/uploads/origins/2e2bb429-e842-4226-a58d-ba2241a053c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=715356e74d7a9d811df55b9c0cf5cf6c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d91494ec/uploads/origins/2e2bb429-e842-4226-a58d-ba2241a053c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d15c720141010dc1e7d9af54a73d99dd", "srcset": "https://si.imgix.net/d91494ec/uploads/origins/2e2bb429-e842-4226-a58d-ba2241a053c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d15c720141010dc1e7d9af54a73d99dd, https://si.imgix.net/d91494ec/uploads/origins/2e2bb429-e842-4226-a58d-ba2241a053c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cca293dcb89db1f33e2fe5e02681b147 2x, https://si.imgix.net/d91494ec/uploads/origins/2e2bb429-e842-4226-a58d-ba2241a053c6?bg=%23fff