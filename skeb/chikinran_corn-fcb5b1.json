11-badd-431d-8b12-fba388908d39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e03f5d84ad2073dccc318efe27c53f2b 2x, https://si.imgix.net/3f286178/uploads/origins/a2e2c511-badd-431d-8b12-fba388908d39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1755a204023d9c4c3c4a6c76a360ac2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f286178/uploads/origins/a2e2c511-badd-431d-8b12-fba388908d39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa915a21548ad32d53856314f76c04de", "srcset": "https://si.imgix.net/3f286178/uploads/origins/a2e2c511-badd-431d-8b12-fba388908d39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa915a21548ad32d53856314f76c04de, https://si.imgix.net/3f286178/uploads/origins/a2e2c511-badd-431d-8b12-fba388908d39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=79f726e6b359097663c8ede1d77419bf 2x, https://si.imgix.net/3f286178/uploads/origins/a2e2c511-badd-431d-8b12-fba388908d39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=12afc7f60e52dc8770b61d0cda408b95 3x"}, "body": "初めまして！！\n資料のご用意は出来なかったのですが、骸骨頭のキャラクターを描いていただきたくリクエストします！\nイラストの数としては3枚ほどで、\n① 全体的な立ち姿\n② 下着(レース状の白色Tバック)サングラスのみの差分\n③ 全裸勃起差分\nの計3つをお願いいたします！\n細かなスタイルとしては、\n[顔]\nよく見るような骸骨頭に、ほんの少しだけ透けて見えるサングラス、そして目は白い点で、リアル寄りな骸骨ではなく、表情があるような感じだと嬉しいです\n[服装]\n白シャツに袖をまくった状態の紺色に近いフード付きパーカー（①のイラストではフードを被せて欲しいです。）ズボンはベージュのジーンズ（裾を少し捲ってある状態でウエストは少し緩くダボッとした感じ）靴はゴツめな白黒のスニーカーで、足首からはチラッと黒い靴下が見えてる状態\n[体格等]\n身長は大体185cm程で、体付きは細マッチョよりも筋肉が付いてるくらいで、肌の色は茶色、股間部分のサイズは大きめで、イメージとしては手で握っても少し余る感じ、陰毛は整えられてやんわりと生えている感じ\n[ポーズ]\n身体はキャラクターから見て左側に向けて、左腕は腰に当て、右腕は自由にお願いします。首と視線はこちらに少しだけ向ける\n[その他]\n②と③では顔部分をほんのり赤らめて欲しいのと、③では脱いだ下着を左手の指に引っ掛ける感じでお願いいたします！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chikinran_corn/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c7cd9ab5/uploads/origins/c751dd10-aa80-44ce-b641-bacdcc73d0b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e922cf60ea783645769aaa0e91d59318", "srcset": "https://si.imgix.net/c7cd9ab5/uploads/origins/c751dd10-aa80-44ce-b641-bacdcc73d0b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e922cf60ea783645769aaa0e91d59318, https://si.imgix.net/c7cd9ab5/uploads/origins/c751dd10-aa80-44ce-b641-bacdcc73d0b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79eb013afe02d5651275cf45e58e6ebd 2x, https://si.imgix.net/c7cd9ab5/uploads/origins/c751dd10-aa80-44ce-b641-bacdcc73d0b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc98c9609d2a1b4638fa2b87c9a6002f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2523606, "client_id": 27727, "nc": 163}, {"path": "/@chikinran_corn/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ff9479a3/uploads/origins/55fa9ee0-1bca-44fe-82ba-913f98f59da5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=450e8661bef6c18ea2a814ec78dfcbf9", "srcset": "https://si.imgix.net/ff9479a3/uploads/origins/55fa9ee0-1bca-44fe-82ba-913f98f59da5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=450e8661bef6c18ea2a814ec78dfcbf9, https://si.imgix