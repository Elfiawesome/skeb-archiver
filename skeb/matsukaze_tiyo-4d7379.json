ix.net/8f74a389/uploads/origins/48f5bf41-e625-4fbc-97e6-8389c50b4fe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=580025bcf73f121af6ca50e0f6dec59e, https://si.imgix.net/8f74a389/uploads/origins/48f5bf41-e625-4fbc-97e6-8389c50b4fe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=937e79d13628d80dad44ea104847374f 2x, https://si.imgix.net/8f74a389/uploads/origins/48f5bf41-e625-4fbc-97e6-8389c50b4fe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c30b119e3c4ed3783a11057dac91e3f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f74a389/uploads/origins/48f5bf41-e625-4fbc-97e6-8389c50b4fe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58fe58f090813738ea415c83881e4b1f", "srcset": "https://si.imgix.net/8f74a389/uploads/origins/48f5bf41-e625-4fbc-97e6-8389c50b4fe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58fe58f090813738ea415c83881e4b1f, https://si.imgix.net/8f74a389/uploads/origins/48f5bf41-e625-4fbc-97e6-8389c50b4fe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=66764745fc5cc0887edf8ddd4329b000 2x, https://si.imgix.net/8f74a389/uploads/origins/48f5bf41-e625-4fbc-97e6-8389c50b4fe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba14c32ea2b13f8a820b63975a54e01e 3x"}, "body": "Nice to meet you.\nDr. Matukaze\n\nI would like to ask you to draw Vtuber Eri Kurenagieri (@Kurenagieri).\n\nShe often delivers a chat about drinking, so I would like you to draw her drinking sake with a squishy, smiling expression on her face.\nI would like her to be dressed in loungewear.\n\nThe aspect ratio of the image is 16:9 (wallpaper_for PC)\nIf possible, I would appreciate it if the composition does not show her hair or clothes.\n\nEri Beniki is a registered member of skeb's official program for secondary works.\n\nWe will send the completed illustration to Eri Beniki.\nWe would appreciate it if you could send us a PSD file with the name of the recipient, the person, and the background layered.\nWe would also appreciate it if you could give us permission to use the illustration only for Eri Beniki herself.\nThere is a possibility that the illustration will be used in Twitter postings, thumbnails for distribution, etc. (maybe?).\n\nThank you in advance!\n\nReferences:\nEri Beniki:\nhttps://drive.google.com/file/d/1tbw-RvQYE-4QVHYj0hS0s39PWzuJfazz/view?usp=drivesdk\n\nhttps://www.fanbox.cc/@kurenagieri/posts/5783559\n\nhttps://lit.link/en/kurenagieri", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@matsukaze_tiyo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2625371, "client_id": 2647331, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e2564bbc/uploads/origins/a9fe7bd1-1e5d-4514-b54a-841f44d8de1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cd3f15faf03af3a4da190ad9964b991", "srcset": "https://si.imgix.net/e2564bbc/uploads/origins/a9fe7bd1-1e5d-4514-b54a-841f44d8de1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cd3f15faf03af3a4da190ad9964b991, https://si.imgix.net/e2564bbc/uploads/origins/a9fe7bd1-1e5d-4514-b54a-841f44d8de1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee85fd1a019521913ceedf33b2e59223 2x, https://si.imgix.net/e2564bbc/uploads/origins/a9fe7bd1-1e5d-4514-b54a-841f44d8de1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5fd92e7b6e3c4ff29268ecf68fd6299d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2564bbc/uploads/origins/a9fe7bd1-1e5d-4514-b54a-841f44d8de1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c408b77fd5451aa089a814f593589e9", "srcset": "https://si.imgix.net/e2564bbc/uploads/origins/a9fe7bd1-1e5d-4514-b54a-841f44d8de1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c408b77fd5451aa089a814f593589e9, https://si.imgix.net/e2564bbc/uploads/origins/a9fe7bd1-1e5d-4514-b54a-841f44d8de1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f1779a9a73fcc99d36db326db743033 2x, https://si.imgix.net/e2564bbc/uploads/origins/a9fe7bd1-1e5d-4514-b54a-841f44d8de1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=24556e413d87931fe4923e6cec7879f9 3x"}, "body": "Hello, my name is AYAMUYA and I am currently preparing my activities.\nI have been looking forward to receiving your request since I saw your illustration on skeb's new arrival!\nI love your lovely illustrations with a great atmosphere.\nI would love it if you could draw my character in your style.\n\n[About the character...\nI am a \"virtual ghost girl\" with a fantasy image, not horror or dark.\nPlease refer to the following Google Drive character materials.\nhttps://drive.google.com/drive/folders/1iz4uZx-Tc6m5gMzqMU4bjzaQvSHLrrbQ?usp=sharing\n\nUsage\nUse for promotional activities on SNS, video distribution sites, and other activity sites.\nWe would appreciate it if you could tell us whether or not the following one item can be used on a different layer of psd if it is NG.\nDistribution through online printing, fanbox merchandise, etc.\n\nComposition\nWe would like you to draw a virtual character reflected through a mirror!\nComposition reference images: https://www.pixiv.net/artworks/93736656 and https://www.pixiv.net/artworks/93736656\n\nWe will leave it up to you how to depict the back view of the real character, such as \"just a hand\" or \"just a little hair (black, semi-long hair)\"!\nYou are also free to remove her jacket, change her outfit, or arrange her hair as necessary.\n\nSupplemental information\nIf you don't mind, we would appreciate it if you could make the image at a size of 2000px or larger.\nWe would appreciate it if you could make the character layers with transparent backgrounds.\nIf it is not too much trouble for you, it would be very helpful if the area above the shoulders of the main character is not cut off, so that we can use it more widely!\nIf the request or cost is not acceptable, we will resend the request.\n\nThank you for your consideration..!\n\nhttps://drive.google.com/drive/folders/1iz4uZx-Tc6m5gMzqMU4bjzaQvSHLrrbQ?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@matsukaze_tiyo/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5a29ba2e/uploads/origins/378ab3e0-d5df-428f-8c93-3a87ad7cef7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68ed02bd8ef73c79beda655f8f5543ab", "srcset": "https://si.imgix.net/5a29ba2e/uploads/origins/378ab3e0-d5df-428f-8c93-3a87ad7cef7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68ed02bd8ef73c79beda655f8f5543ab, https://si.imgix.net/5a29ba2e/uploads/origins/378ab3e0-d5df-428f-8c93-3a87ad7cef7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5dad20fb95469b9e8ab03c1071b3e42b 2x, https://si.imgix.net/5a29ba2e/uploads/origins/378ab3e0-d5df-428f-8c93-3a87ad7cef7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c27cccb50b370913728f6580724b9e91 3x"}, "private": true, "genre": "art", "tipped": true, 