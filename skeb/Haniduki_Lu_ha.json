ail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3416329, "client_id": 3663023, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa49b430/uploads/origins/d8a9540c-9487-4730-a814-684754260e64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=181990a08e1caeb8f0c17219fa20d713", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa49b430/uploads/origins/d8a9540c-9487-4730-a814-684754260e64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ac48d26fda03616d7f25b77fcea85cd", "src_set": ""}, "body": "蜂蜜月るーは様、こんばんは。VTuberの御橋アデルと申します。\nXの検索よりリクエスト失礼致します✨️蜂蜜月るーは様の過去イラストを拝見致しました。\n無駄のないシャープな線画と、明るく可愛らしい色遣いが素敵です。特に透き通るような目の塗り、髪のカラフルなハイライトにとても惹かれました。\n\nこの度は私のイラストを描いていただきたく、リクエスト致しました。以下に資料、容姿についての記述を致しましたのでご参照ください。\nまた、下記リクエストに関わる文章についてはテンプレートを使用しておりますがご了承ください。\n\n容姿\n・両耳朶に金色のピアス、左耳に金色のインダストリアルをつけています\n・右側の口元（向かって左）と、左耳（向かって右）の耳にホクロがあります\n・髪型はウルフヘアで、右側だけ長い毛束があります　外ハネ気味です\n・黒ネイルをしています\n・衣装はある程度簡略化して頂いても構いません\n・顔立ちは気持ち男性寄りですが、どちらとも取れるイメージです\n三面図はなく、正面のみになりまして申し訳ありません。\nポーズ、構図、表情はお任せ致します。\n\n使用用途\nYouTube動画のサムネイルやXでの投稿等に使用させて頂きたいと思っております。活動に使用するにあたり、透過PNGファイルも併せて納品いただけると幸いです。\n\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1N7Iggp0aPtjRloMh5w_7uq9xAhXYv8Ln/view?usp=drivesdk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Haniduki_Lu_ha/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3416329, "client_id": 906486, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d68e1c4e/uploads/origins/c3c68025-b170-4550-a344-8299bdbded41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef126b781378a88e396d27060e93c92c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d68e1c4e/uploads/origins/c3c68025-b170-4550-a344-8299bdbded41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25d85b4486cfa2c6593a475d0101687a", "src_set": ""}, "body": "こんにちは！僕は君の描き方が好きで、僕のOC、ヘクターをリクエストしたいんだ！\n\nヘクター (180cm)\n内気で、不器用で、控えめ。人付き合いが苦手なので、一人でいることを好む。人の顔を直視すると緊張するので、それを避けるために帽子をかぶることが多い。顔を隠すために帽子を下に傾ける傾向がある。帽子は彼にとって安全な泡のようなもので、かぶっていないと少し慌てることがある。\n\n自由に描いてください！すべてお任せします。彼が着る服の写真を用意しましたので、その中から選んでください！別の服でもOKです。どんな服装でも、彼はたいてい白か黒の無地の帽子をかぶっています。\n\nご検討ありがとうございます。ご遠慮なくお断りください。\n\nhttps://drive.google.com/drive/u/1/folders/1MxRCyHMoJiTdkpKmtFhVwn8fvQilzTo5", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 2120474, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Ⴋ〜", "screen_name": "mippiii33", "avatar_url": "https://pbs.twimg.com/profile_images/1629864704998010880/Lz9KMr_M.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1432961811163144197/1652156573/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 144}, {"id": 2611259, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ひゃく", "screen_name": "syakkuri_", "avatar_url": "https://pbs.twimg.com/profile_images/1604781336874856448/Av2eq08z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/927413290182909953/1556027790/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 17}, {"id": 2930595, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "拳", "screen_name": "888__nigirikobusi", "avatar_url": "https://pbs.twimg.com/profile_images/19327