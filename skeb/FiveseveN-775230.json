0141f1ab182408dece7ab6c07a.jpg\n（あまりメジャーではない作品なので幼少期の資料画像は恐らく検索してもあまり数が見つからないかと思われます。申し訳ない限りですが、描かれる上で不明瞭な部分があればFive-seveN様の方で素敵にアレンジしていただければ幸いです）\n\n\n後に非道王と国民から恐れられるルスランというキャラクターの、誕生日イベントでたった１度だけ登場した幼少期の姿です。\n幼すぎず、かといって成人でもない絶妙な年代の少年を、ぜひFive-seveN様の魅力的なタッチで描いていただければと思います！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FiveseveN/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 10116, "client_id": 80865, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1950aaa3/uploads/origins/711a4508-e287-4852-b761-81a460daa590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=034b9c8eda86d584713226d0e94eb961", "srcset": "https://si.imgix.net/1950aaa3/uploads/origins/711a4508-e287-4852-b761-81a460daa590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=034b9c8eda86d584713226d0e94eb961, https://si.imgix.net/1950aaa3/uploads/origins/711a4508-e287-4852-b761-81a460daa590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a55db6206fc6b000d0b793b86a32e10 2x, https://si.imgix.net/1950aaa3/uploads/origins/711a4508-e287-4852-b761-81a460daa590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05f28567a5945f0eb96e574b094c53ff 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1950aaa3/uploads/origins/711a4508-e287-4852-b761-81a460daa590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=860cf64d53ac6a2b8548de3a44b23ac6", "srcset": "https://si.imgix.net/1950aaa3/uploads/origins/711a4508-e287-4852-b761-81a460daa590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=860cf64d53ac6a2b8548de3a44b23ac6, https://si.imgix.net/1950aaa3/uploads/origins/711a4508-e287-4852-b761-81a460daa590?bg=%23fff&auto=format%2Ccompress&fm=webp&dp