nt": 0, "received_works": [{"path": "/@emp_federico/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 414964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae57632d/uploads/origins/e8524605-8718-487d-990f-6d1ab80665b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed5b736304022986c643da261fbf93f6", "srcset": "https://si.imgix.net/ae57632d/uploads/origins/e8524605-8718-487d-990f-6d1ab80665b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed5b736304022986c643da261fbf93f6, https://si.imgix.net/ae57632d/uploads/origins/e8524605-8718-487d-990f-6d1ab80665b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c22206bd73c441dc5b6b7c8d5a81995c 2x, https://si.imgix.net/ae57632d/uploads/origins/e8524605-8718-487d-990f-6d1ab80665b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f80e55a19e9b9497f3305c56cb81c72e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae57632d/uploads/origins/e8524605-8718-487d-990f-6d1ab80665b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f89f8e8fae64438a488885e86f1458ae", "srcset": "https://si.imgix.net/ae57632d/uploads/origins/e8524605-8718-487d-990f-6d1ab80665b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f89f8e8fae64438a488885e86f1458ae, https://si.imgix.net/ae57632d/uploads/origins/e8524605-8718-487d-990f-6d1ab80665b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb125b3c5a88535588e81b33a42ea066 2x, https://si.imgix.net/ae57632d/uploads/origins/e8524605-8718-487d-990f-6d1ab80665b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9acf03a0767852c409f85d6686bdc665 3x"}, "body": "神代結菜のローションプロレスで敗北する浅野葉月が最高だったので、その前日譚をお願いしたいです。\n\n何度も参加して毎回お尻が弱点とバレて敗北して無限レイプされている様子なので、\n初参加&初敗北のシチュをお願いします。\n\n対戦相手は橋本ひかり(10連敗中)\n\nシーン1(夢)\n葉月は男たちの欲望の言いなりになるのを拒否するものの、連敗からの無限レイプ地獄から抜け出そうと必死なひかりに水着を剥ぎ取られ、乳首を弄られる。\n最初は余裕だったものの、歴戦のひかりのテクと媚薬ローションのせいでだんだん感じてきてしまい、慌てて反撃するも最終的に敗北。\n\nシーン2(夢)\n絶頂してピクピク痙攣しているところに男たちが乱入してきて地獄のレイプ調教が始まる\n必死に抗うも前も後ろも好き放題犯されて中に出されていくうちに理性が吹き飛んで、どうせ夢だからと\n下品に喘いで絶頂する。\n\nシーン3(現実)\n目が覚めて現実に戻ってからも記憶はなくなっているが、体が疼いて仕方ない。男子生徒を見るたびに子宮とお尻がキュンとしてチンポのことを考えてしまう自分に戸惑い苛立つ浅野。\nそしてトイレでひかりが男子生徒たちに囲まれて自ら腰を振っている姿を目撃してしまい、\n負け続けると現実にも影響が出てチンポ狂いになってしまうことを無意識に理解し恐怖する。\n\n裏設定として、10回負けてしまうと調教が完了してしまい。現実でもチンポのことが頭から離れなくなってしまうため、\n調教が完了しているひかりは用済みなので運営サイドが葉月の弱点(特にお尻)だけどんどん公開して葉月が不利になっていくことと、\n初勝利後、喜びと罪悪感を感じながらリングを去ろうとしたひかりに司会の悪魔がその事実を耳打ちして、ひかりが絶望の表情を浮かべる\nといった内容も入れてもらえると嬉しいです。\n\n特にシーン2の調教のシーンは濃密にお願いします。\n\nよろしくお願いします。", "nc": 57, "word_count": 18043, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@emp_federico/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 414964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0aeb1a17/uploads/origins/b4260e95-4357-42b2-82d3-ffde7d5bd3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d6ec81ae2c8ab26b89d413d9faa60a9", "srcset": "https://si.imgix.net/0aeb1a17/uploads/origins/b4260e95-4357-42b2-82d3-ffde7d5bd3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d6ec81ae2c8ab26b89d413d9faa60a9, https://si.imgix.net/0aeb1a17/uploads/origins/b4260e95-4357-42b2-82d3-ffde7d5bd3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9f3073879294e53beaff64b008b5175 2x, https://si.imgix.net/0aeb1a17/uploads/origins/b4260e95-4357-42b2-82d3-ffde7d5bd3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc08d01e6815dea0bfb2f5d601b15f75 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0aeb1a17/uploads/origins/b4260e95-4357-42b2-82d3-ffde7d5bd3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5dee2e91d2bd37522d1124f3a195427c", "srcset": "https://si.imgix.net/0aeb1a17/uploads/origins/b4260e95-4357-42b2-82d3-ffde7d5bd3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5dee2e91d2bd37522d1124f3a195427c, https://si.imgix.net/0aeb1a17/uploads/origins/b4260e95-4357-42b2-82d3-ffde7d5bd3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=70120193783121c7303124eca9e9a7ae 2x, https://si.imgix.net/0aeb1a17/uploads/origins/b4260e95-4357-42b2-82d3-ffde7d5bd3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d8a5626c40a8f804b745ff17b34d3eb 3x"}, "body": "お世話になっております。\n神代結菜のローションプロレス、最高です。何度も使わせていただいております。\n神代結菜で一つまたお願いさせて頂きたいです。\n\n夢の世界でエロ脱出ゲームに参加させられ、器楽部員と戦う神代結菜のお話をお願いします。\n\nゲームの勝利条件は盛ったオスが蔓延るエリアでオスを躱しつつ、他のプレイヤー（器楽部員）の持つ鍵を手に入れてたった一つの出口へ向かいエリアから脱出すること。\n以下、ゲームの設定です。\n・エリアから脱出するには鍵を手に入れ出口に向かう事。\n・出口の鍵はプレイヤーが快楽への完全敗北を認めた時、下腹部の淫紋から生成される。\n\n・肉体\nプレイヤーの肉体はゲーム用に改造されており、全身の感度が高められており興奮と共に母乳も噴出される。常に身体がチンポを求めている発情状態。\nプレイヤーは蔓延るオスの感情や声が直接脳に響くようになっており、男の下卑た欲望が本人達に届くようになっている。またチンポのニオイにも敏感になっているため盛ったオスが近づくとある程度は察せる。\n下腹部に淫紋が刻まれており、快楽への完全敗北を認めた時に淫紋から出口へ戻る鍵が生成され、チンポのことしか考えることはできない性奴隷と成り果てる。\n\n・装備\n武器は一丁の媚毒水鉄砲。皮膚に触れただけでメスの本能を強烈に刺激させる発情効果がある。エリア内のオスには一切効果は無く、プレイヤーにしか効果が無い。\n媚毒水補充はプレイヤーの母乳か愛液で行う。弾切れの場合搾乳したりオナニーして補充しなければならない。\n衣装はテカテカと輝いて目立つ、ピッチリと肌に吸い付く卑猥なボディスーツ。乳首や秘部をクッキリ表し、締め付けだけで身体を熱らせる。スーツは精液もしくは媚薬水鉄砲で溶けるようになっている。\n\n・エリア\n床はソープマットのようになっておりどこもローションまみれ。全体的にピンクな特殊な空間。道は入り組んで迷路のようになっており、遮蔽物や隠れる場所は多い。\n床、壁、至る所にモニターがいくつも貼り付けられており、エリア内を彷徨うプレイヤー達全員の姿をリアルタイムで映している。誰かがオスに犯されれば全てのモニターが犯されている人間を映すようになり、オスをモニターに夢中にさせ、オス達は自慰に勤しむ。プレイヤーがオスに犯されれば、他プレイヤーが自由に動ける時間が稼げるといういやらしい仕様。\n\n・エリア内のオス達\nエリアには盛った男達（器楽部を性的な目で見ている学校の男子達）がプレイヤーの肉体を貪ろうとチンポをギンギンに滾らせながら彷徨っている。見つかれば即レイプされる。男は性欲が限界まで高められており常に絶頂寸前。一度射精するとしばらく動けなくなる。プレイヤーを求めて彷徨っているが、モニターに映るプレイヤーの姿に我慢できず自慰してしまい、チンポが回復するまで動けなくなるものも多い。\n隠れていれば自慰に耽って行動不能になるオスもいるため、オス達の様子を見て隠れながら進む必要がある。\n\n\n戦う相手は亜里砂・E・Bか綾瀬凜でお願いします。\nどちらも真面目な子ですが夢の世界での相手ということで、勝利に貪欲、勝つ為に結菜を蹴落とす気しか無く、一切の情はない。一刻も早く絶頂させる為に淫語や下衆な言葉責めも扱いこなして罵ってくる悪堕ちメス敵役として書いてくださると嬉しいです。\n媚薬水鉄砲の掛け合いでもくんず解れずのイかせあいでも、戦い方はなんでも構いません。\n\n勝敗はどちらでも構いません。\n勝敗がどちらの場合でも二人が小競り合いに夢中になっている中オスが乱入し、敗者側が襲われ、そこに勝者側が敗者に媚薬を何度もかけて無様にイキ狂う姿を見届けるエンドをお願いします。\n\n余裕があればモニターで他の部員が犯される姿や蔓延るオス達の性欲に恐怖しながらも愛液が止まらない様子、試しに1発ハメられちゃってるシーンなど、どれか書いてくださると嬉しいです。\n\nエロゲームで四面楚歌の中、器楽部と戦うということさえあれば全て忠実に守って頂かなくて全く構いません。戦う相手も指定したキャラでなくても構いません。\nよろしくお願い致します。", "nc": 40, "word_count": 30014, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@emp_federico/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "correction", "tipped": true, "creator_id": 414964, "client_id": 859123, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/320b4eff/uploads/origins/2ce233ee-965d-4939-bcdc-59056a582ece?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f25cacb976b2f7f05e76819de668d56", "srcset": "https://si.imgix.net/320b4eff/uploads/origins/2ce233ee-965d-4939-bcdc-59056a582ece?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f25cacb976b2f7f05e76819de668d56, https://si.imgix.net/320b4eff/uploads/origins/2ce233ee-965d-4939-bcdc-59056a582ece?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d944b1ab61fe0e41ac6c8a7af06b2389 2x, https://si.imgix.net/320b4eff/uploads/origins/2ce233ee-965d-4939-bcdc-59056a582ece?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72d4ff92f05327d434c16ca0946025c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/320b4eff/uploads/origins/2ce233ee-965d-4939-bcdc-59056a582ece?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fd9c605453db7b29fa0e06d39340cc6", "srcset": "https://si.imgix.net/320b4eff/uploads/ori