考えるのが好きなんだ。なので、目が光るようなクールなイラストも面白いですが、水着や露出度の高いイラストもとても素敵です。青灰色の肌、角（耳はない）、異色症、大きな長い尻尾が特徴。背も低い。あとはあなたにお任せします。\n\n新しい服を着せたいなら、大歓迎だ！彼女は科学が好きで、宇宙から来た。その他はお好きなように、あるいは私のフォルダの中の参考資料やアイデアから自由に引っ張ってきてください！\n\nありがとうございました\n\nhttps://drive.google.com/drive/folders/1C_TFMl5K_L5PFheYZTChEWHIpRh6gnQI", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@PARADOX0042/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1314282, "client_id": 80179, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bbfcc87/uploads/origins/64a130e0-378b-45a2-bad5-939e5ce2a7da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be294548c82d8b05661e80a9f50509bf", "srcset": "https://si.imgix.net/5bbfcc87/uploads/origins/64a130e0-378b-45a2-bad5-939e5ce2a7da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be294548c82d8b05661e80a9f50509bf, https://si.imgix.net/5bbfcc87/uploads/origins/64a130e0-378b-45a2-bad5-939e5ce2a7da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3821f8287efbb46b656d45842a31c0f 2x, https://si.imgix.net/5bbfcc87/uploads/origins/64a130e0-378b-45a2-bad5-939e5ce2a7da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61c5c21fd0eebf392029ae8a30bb1844 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5bbfcc87/uploads/origins/64a130e0-378b-45a2-bad5-939e5ce2a7da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ec9b6d381578e40494a6220e70fb48a", "srcset": "https://si.imgix.net/5bbfcc87/uploads/origins/64a130e0-378b-45a2-bad5-939e5ce2a7da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ec9b6d381578e40494a6220e70fb48a, https://si.imgix.net/5bbfcc87/uploads/origins/64a130e0-378b-45a2-bad5-939e5ce2a7da?bg=%23fff&auto=format%2