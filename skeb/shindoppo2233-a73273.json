す。（同じく『GODARCA』というシナリオの現代コンバート探索者です）\n天真爛漫なところや初心なところがあり、どちらかと言えば男性側に振り回されていることが多くなっています。また、泣き虫な側面もあります。\n一人称はわたしで身長は165㎝。21歳となります。\nイメージカラー：#68a4d9\n\nシチュエーションとしては、二人で並んで夜空を見上げているものでお願いしたいです。\n顔の向きは正面か横向き（向かい合ってる）だと嬉しいです。\n\nお忙しいところ恐れ入りますが、ご検討のほどどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1E0rN5ZMGJrpf_BTTlPR2uAzGEUZzPxrj?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@91__PPP/works/222", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2545158, "client_id": 366852, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83ea662f/uploads/origins/7212fd77-dbe5-4383-bc7c-7a2d2fda27f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fbadf5773c46331488edc3764ff8c1e", "srcset": "https://si.imgix.net/83ea662f/uploads/origins/7212fd77-dbe5-4383-bc7c-7a2d2fda27f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fbadf5773c46331488edc3764ff8c1e, https://si.imgix.net/83ea662f/uploads/origins/7212fd77-dbe5-4383-bc7c-7a2d2fda27f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99d7350845cde3f12b2b54f00300143b 2x, https://si.imgix.net/83ea662f/uploads/origins/7212fd77-dbe5-4383-bc7c-7a2d2fda27f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea3a1bbd165dec2228522af8196bb05c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83ea662f/uploads/origins/7212fd77-dbe5-4383-bc7c-7a2d2fda27f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07208b1aa2ae8d0a38188d1043b6ed31", "srcset": "https://si.imgix.net/83ea662f/uploads/origins/7212fd77-dbe5-4383-bc7c-7a2d2fda27f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07208b1aa2ae8d0a38188d1043b6ed31, https://si.imgix.net/83ea662f/uploads/origin