あります。 リリスにとってはそういう感じではないですが、いたずらされた者は、「リリス様に思うままに遊ばれる」と感じで、その優しく見守っている瞳でさえ見下ろしていると感じる。\n\nhttps://x.com/41__tr/status/1875860016122744842/photo/1 みたいな雰囲気が好きですが、以上の設定を参考し、お任せの一枚をお願いいたします。\n\n細部はおまかせします。\n上記の点は全部厳守する必要はないですので、先生のアイデアを優先して描いていただければと思います。\n\nレイヤ分けのｐｓｄと宛名有り無し差分もお願いします。\n内容や金額に問題がありましたら、再送をいただけると嬉しいです。\nでは、ぜひご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1kXkcGn7wPFgeyLpuor3Kcs3JCmN0z5ec", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@41__tr/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2603075, "client_id": 1051983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3821bd0e/uploads/origins/6d1e7efc-fc6b-4eaa-870d-8008d54da8b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d6e7bdd7b81f47bb7dfa554632eebfd", "srcset": "https://si.imgix.net/3821bd0e/uploads/origins/6d1e7efc-fc6b-4eaa-870d-8008d54da8b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d6e7bdd7b81f47bb7dfa554632eebfd, https://si.imgix.net/3821bd0e/uploads/origins/6d1e7efc-fc6b-4eaa-870d-8008d54da8b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c874d0a55c77565326379b3c02cddd66 2x, https://si.imgix.net/3821bd0e/uploads/origins/6d1e7efc-fc6b-4eaa-870d-8008d54da8b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4bededb7110173ca262ccff59a6a6abb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3821bd0e/uploads/origins/6d1e7efc-fc6b-4eaa-870d-8008d54da8b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=540dc6aac63d98972b22303baebbffa0", "srcset": "https://si.imgix.net/3821bd0e/uploads/origins/6d1e7efc-fc6b-4eaa-870d-8008d54da8b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=540dc6aac63d98972b2230