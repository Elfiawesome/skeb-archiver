立場の子なので私から伝えられる設定は御座いませんが、とりあえず巨乳ではないとだけ伝えておきます。あと「取り憑かれた時に出現する黒いモヤみたいなやつは、本来黒い炎っぽい雰囲気で描きたかった名残」なのと「手が変色しているのはそこから闇属性の魔法を出す為」という憑依状態の要素を幽鴉さんなりの解釈で描いてくださると幸いです。\n最後になりますが、資料1枚目に取り憑かれいない状態の素顔を載せており、また構図やアングルなどにつきましてはそちらにお任せしますので何卒よろしくお願いします🙇‍♀️🙇‍♀️\n\n《今回の資料》\nhttps://imgur.com/a/3rhmKfA", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yuuge_karasuu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2834278, "client_id": 41402, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4cffe56b/uploads/origins/a4c53cc3-67f0-44ae-8e86-f717bdb0ad56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e24d72846a9f2f57a2daf7f3ca0214e", "srcset": "https://si.imgix.net/4cffe56b/uploads/origins/a4c53cc3-67f0-44ae-8e86-f717bdb0ad56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e24d72846a9f2f57a2daf7f3ca0214e, https://si.imgix.net/4cffe56b/uploads/origins/a4c53cc3-67f0-44ae-8e86-f717bdb0ad56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a36c0ee183511104490b9825eb00a43 2x, https://si.imgix.net/4cffe56b/uploads/origins/a4c53cc3-67f0-44ae-8e86-f717bdb0ad56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc313212dfc6aae2e7d0716126a342a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4cffe56b/uploads/origins/a4c53cc3-67f0-44ae-8e86-f717bdb0ad56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5303caca0695826e20232153d906486a", "srcset": "https://si.imgix.net/4cffe56b/uploads/origins/a4c53cc3-67f0-44ae-8e86-f717bdb0ad56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5303caca0695826e20232153d906486a, https://si.imgix.net/4cffe56b/uploads/origins/a4c53cc3-67f0-44ae-8e86-f717bdb0ad56?bg=%23fff&auto=format%2Cc