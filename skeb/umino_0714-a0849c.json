ate": false, "genre": "art", "tipped": false, "creator_id": 3588214, "client_id": 600508, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91739974/uploads/origins/4e69ea4c-0fdd-4eda-a355-3385a7dad652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b058db3cdca4be9130a6c110251b764", "srcset": "https://si.imgix.net/91739974/uploads/origins/4e69ea4c-0fdd-4eda-a355-3385a7dad652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b058db3cdca4be9130a6c110251b764, https://si.imgix.net/91739974/uploads/origins/4e69ea4c-0fdd-4eda-a355-3385a7dad652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e16e0afcf6421d05770820c96a63b766 2x, https://si.imgix.net/91739974/uploads/origins/4e69ea4c-0fdd-4eda-a355-3385a7dad652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99abdab9afaf4b3c028d14dd21583e74 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91739974/uploads/origins/4e69ea4c-0fdd-4eda-a355-3385a7dad652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f82cbdb00d32d048431c1e33e38cc1f", "srcset": "https://si.imgix.net/91739974/uploads/origins/4e69ea4c-0fdd-4eda-a355-3385a7dad652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f82cbdb00d32d048431c1e33e38cc1f, https://si.imgix.net/91739974/uploads/origins/4e69ea4c-0fdd-4eda-a355-3385a7dad652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a3c3b831045a92c7a3b3f81d1107261 2x, https://si.imgix.net/91739974/uploads/origins/4e69ea4c-0fdd-4eda-a355-3385a7dad652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=18a3ac5f0d895779e17fcac7b8de3281 3x"}, "body": "はじめまして。以前より依頼したく思っていましたが、フォロワー1000人突破記念に便乗して慎んで依頼させて頂きます。\nアズールレーンより「ネプチューン」さんを描いて頂けませんか。 先日の都内でのイベントにて特に進展も無かった事が悔しく、同日の演じる中の人こと声優さんの記念の一助になればと思った次第です。 衣装ですが、中の人がＸ上で大胆な姿を披露してまして… その姿何れかを着せた画でお願いします。(赤の下着？又は白の水着姿です。詳しくは資料URLをご参照ください) 適度にアレンジ等入れて貰っても、あくまで 風 といった具合でも全く大丈夫です。 資料がURL先の僅かな写真のみということもありますし、二次元と実写を合わせること自体が難しい様であれば他の衣装を、正直語弊なく何でもいいです。デフォルトの衣装、既存の他の着せ替え衣装でも、現実にあるもの、他キャラの衣装でも、季節柄なモノなどでも構いません！ \n色っぽいまたは悪戯っぽい表情で、可能なら全身、最低限膝上以上を描いて頂ければ。SNFWは有効にしておきますので、誘ってるだけ風の画でも、ド直球な行為中、前後の画でも（挿入、挟んで擦る、しゃぶったり等）R18-Gな画でさえ無ければ何でも喜びます！\nその他細かいポージングやシチュエーション、小物の有無などもお任せで（髪飾りさえあれば）、背景はシチュに合わせた形か母港等でも、または資料先と同じ様なものでも、白や黒塗り的な簡素なものでも大丈夫です。\nスマホで観ることが主なので縦長の画である事さえ守ってもらえれば概ね自由に描いてもらって構いません！ 強いて言うなら中の人共々ご立派な、直近の着せ替えでは公式からして特に盛られたお胸は尚一層立派に描いて貰えれば悦びます。 ご検討頂けますと幸いです。\n\nhttps://x.com/izawamikako/status/2096253268376829957?s=46&t=nXUz4zB6Bne_HSFL6XPWFA", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umino_0714/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1d5f3c6c/uploads/origins/034d5414-110f-4061-b58a-01e8b1226d94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f0d05ea1844de896233d116850c5191", "srcset": "https://si.imgix.net/1d5f3c6c/uploads/origins/034d5414-110f-4061-b58a-01e8b1226d94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f0d05ea1844de896233d116850c5191, https://si.imgix.net/1d5f3c6c/uploads/origins/034d5414-110f-4061-b58a-01e8b1226d94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2cdb6aa4e884f6a38763daf2c2ed3760 2x, https://si.imgix.net/1d5f3c6c/uploads/origins/034d5414-110f-4061-b58a-01e8b1226d94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4abd64