笑顔を基本にお願いいたします。\n手足は鳥の爪のような形状で、拳にはボクサーのように布を巻いています。\n武器は一本の禅杖を持たせてください。\n\nいつも美しい立ち絵をデザインしてくださり、本当にありがとうございます。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AMn1ko/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2557554, "client_id": 1854668, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee6545d1/uploads/origins/36506c43-ea89-4f64-995d-61e67363b87c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c152ad475b50548fdc301122f2b3e479", "srcset": "https://si.imgix.net/ee6545d1/uploads/origins/36506c43-ea89-4f64-995d-61e67363b87c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c152ad475b50548fdc301122f2b3e479, https://si.imgix.net/ee6545d1/uploads/origins/36506c43-ea89-4f64-995d-61e67363b87c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8c9084fe04716cd8d378368670b8c99 2x, https://si.imgix.net/ee6545d1/uploads/origins/36506c43-ea89-4f64-995d-61e67363b87c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47ee547305e5e1c77f6e727537a62d64 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee6545d1/uploads/origins/36506c43-ea89-4f64-995d-61e67363b87c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05484fdc016e5fcc812f55c14f6169c4", "srcset": "https://si.imgix.net/ee6545d1/uploads/origins/36506c43-ea89-4f64-995d-61e67363b87c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05484fdc016e5fcc812f55c14f6169c4, https://si.imgix.net/ee6545d1/uploads/origins/36506c43-ea89-4f64-995d-61e67363b87c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5d345ab4b329e7ae14e43d9d8a58de90 2x, https://si.imgix.net/ee6545d1/uploads/origins/36506c43-ea89-4f64-995d-61e67363b