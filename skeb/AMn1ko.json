1d9b-197b-4003-a5e9-957294158845?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df9bfc703dc315b7ded9ad954e6de203", "srcset": "https://si.imgix.net/9fff02de/uploads/origins/35bf1d9b-197b-4003-a5e9-957294158845?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df9bfc703dc315b7ded9ad954e6de203, https://si.imgix.net/9fff02de/uploads/origins/35bf1d9b-197b-4003-a5e9-957294158845?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ee24ed7ebbee8cc34efb090f5247dc5 2x, https://si.imgix.net/9fff02de/uploads/origins/35bf1d9b-197b-4003-a5e9-957294158845?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d980cd4b41f4f9250e9e7b7e9d597461 3x"}, "body": "先生、こんにちは。\nこの度のご依頼では、TRPG用の立ち絵を一枚お願いできればと思っております。\n今回のキャラクター名は「フィデル」となります。\n描いていただきたいのは、**猫人（ねこびと）のローグ（盗賊）**の男性キャラクターです。\n猫人とは、頭部が猫の姿で、身体は人間に近く、全身が猫の毛で覆われている種族です。尻尾があり、手は人間に似ていますが肉球も備えています。\n年齢は30歳前後の男性で、体型は細身です。\n身長176cm、体重50kgほどの非常に華奢な体格をイメージしていただければと思います。\n毛色はグレーで、細長く、表情豊かに動く猫耳をしています。\n服装は、隠密行動に適した西洋ファンタジー風の冒険者装備を想定しています。\nこちらは先生がこれまで描かれてきたご経験を信頼し、デザインはお任せいたします。\n武器はクロスボウで、手に持たせる、または背負わせるなどの配置も先生にお任せします。\n表情はどこか疲れたようで、少し世を厭う雰囲気がありますが、実際の性格は意外と明るく、おしゃべりです。\nただし、興味を失うのも早く、少し猫らしいところがあります（笑）。\n可能であれば、表情差分もお願いできると嬉しいです。\nどうぞよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AMn1ko/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2557554, "client_id": 1854668, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f8a249f/uploads/origins/e60d4010-70b3-4907-ba72-2cf044125a82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c62ae69674c59024abf1f232d8ae50f", "srcset": "https://si.imgix.net/3f8a249f/uploads/origins/e60d4010-70b3-4907-ba72-2cf044125a82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c62ae69674c59024abf1f232d8ae50f, https://si.imgix.net/3f8a249f/uploads/origins/e60d4010-70b3-4907-ba72-2cf044125a82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a73785fbf0f1aab2a4185b167ace8db 2x, https://si.imgix.net/3f8a249f/uploads/origins/e60d4010-70b3-4907-ba72-2cf044125a82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a771a9c73afc0fa0ada1b256b8852688 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f8a249f/uploads/origins/e60d4010-70b3-4907-ba72-2cf044125a82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7b95603b9b562314673606469efabc7", "srcset": "https://si.imgix.net/3f8a249f/uploads/origins/e60d4010-70b3-4907-ba72-2cf044125a82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7b95603b9b562314673606469efabc7, https://si.imgix.net/3f8a249f/uploads/origins/e60d4010-70b3-4907-ba72-2cf044125a82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2f179ef9dd93d1cc0a19f70bee320ab0 2x, https://si.imgix.net/3f8a249f/uploads/origins/e60d4010-70b3-4907-ba72-2cf044125a82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=91a67335c7c458fd1d0e1b7b11cabcc5 3x"}, "body": "では、さっそく次のTRPGキャラクターデザインをお願いします、先生！すべてお任せします！\n\n今回のキャラクター名は「ベラドンナ」、愛称は「ベラ」です。\n種族は植物の精霊で、頭には黒いベラドンナの花が咲き、身体には深い紫色のベラドンナがいくつも生えています。\n性別は一応「なし」ですが、見た目は可愛らしい子どものようで、身長はわずか80センチ。パーティの中でヴェルナよりも背が低い唯一の存在です。\n\n武器は棘の生えた蔓のような長い鞭。\nキャラクターのイメージの原型は、Fateシリーズの「カズラドロップ」から取っています。参考画像はこちらです：\nhttps://i.imgur.com/zso1I7q.png\n\nどうぞよろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AMn1ko/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2557554, "client_id": 1854668, "vtt_url": null, "thumbnail_image_urls": {"src": "https:/