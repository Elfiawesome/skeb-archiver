f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=533ae48850316d95aeb6a9fe24bcfe08", "src_set": ""}, "body": "またまたこんにちは！またリクエストを送っても大丈夫でしょうか？私のVtuberのアートをまたお願いしたいのですが、今回は私のパートナーのVtuberのアートをお願いします！\n\nルシアン：https://drive.google.com/drive/folders/1ecjYUVwKspe1nmKIn-78p_Fhw5aoqdv5?usp=sharing\n\nヴァイケ：https://drive.google.com/drive/folders/1KX6aK9-Y_Tgzd9qIWa0HCEewZ-ZAO8bR?usp=sharing\n\nこの作品では、ヴァイケにルシアンをダンスのポーズでディップしてもらいたい。ヴァイケはルシアンをからかうのが好きで、ルシアンはとても慌てたり恥ずかしがったりするのですが、この時はとても嬉しそうです！！ヴァイケは162cm。ルシアンは180cm。\n\nリクエストに応えてくれてありがとう！どんな作品ができるのか楽しみにしています！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Waa_08193/works/45", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3628046, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a35c4957/uploads/origins/d60d2459-1917-4fea-ab4f-8bd39c3d7edd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a1189f8f0f9e8960fa414b37f0f86ca", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a35c4957/uploads/origins/d60d2459-1917-4fea-ab4f-8bd39c3d7edd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54bd8726692b96cda21cd02ad6acf4f3", "src_set": ""}, "body": "あわた様の素敵なイラストを拝見しうちの子たちも描いていただきたいとメッセージしております。\n\nこちらの二人をお願いします。\n女https://drive.google.com/drive/folders/1bK6eB9LXTFwmAuQ4c78pDqE81jcTr-O9?usp=drive_link\n男＞https://drive.google.com/drive/folders/1XFlcq68OZJ03LbQaIlA0eNz5pPDLVqSH?usp=drive_link\n\n全体まとめ資料＞https://drive.google.com/drive/folders/1bK6eB9LXTFwmAuQ4c78pDqE81jcTr-O9?usp=drive_link\n\n服装はお好きなもので構図もご自由に！（恋人手前ぐらいのいちゃつき度合いだと嬉しいです）\n可能であればキャラ背景透過済みを別途希望です。\n\n以下、キャラ詳細です。\n◆ペネロペ・カークマン　27歳　女　156㎝\n職業：ＦＢＩ\n一人称：アタシ　\n攻めへの呼び方：魅音\nアメリカ人\n\n独占欲が強くて子供っぽい。が、表面だってはそれを隠している。\n貧乳なのを気にしている。\n基本的に空気をかなり読むが、気を許したい相手にはわがまま放題。子供っぽく振舞うことが多い。\n\n参考セリフ\n「ちょっと！アンタたちアタシの前に立たないでよ！アタシが見えないでしょう！」\n「ハ！？聞いてないんだけど！？」\n「…………いい、よ。魅音だけ特別に許してあげる」\n「だから、アンタも許しなさいよね！アタシだけ！！！特別って！！！！！」\n\n\n◆ワン ミオン（王 魅音）　31歳　男　183㎝\n職業：ＦＢＩ\n一人称：僕\nウケへの呼び方：ペネロペ\n中国系アメリカ人\n\n元々ピアニストを目指していたので指が長い。\n元ＳＷＡＴだったため、体がかなり筋肉ダルマ（細マッチョみたいなイメージです）\n\n気難しく、人付き合いがあまり得意でない。素っ気ない態度が多く見られるが本人的には気をつかっているらしい。\n友人が多くないためぼっち飯をすることが多い。\nまた、本人的には友人が少ないことをさほど気にしていないが、祖母からはよく叱られている\n\n参考セリフ\n「あ〜、そういう話なら僕も役に立てるかもしれませんね」\n「いやぁそれはさすがに言い過ぎなんじゃない？」\n「じゃあ、これは君と僕の秘密ってことにしましょう。その方がいいですよ。」\n\nホクロの位置【左目の下】【唇右下】\n\n特徴としては身長差があることです。\nご検討、よろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Waa_08193/works/44", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4b60edcc/uploads/origins/e2aba751-84d0-4225-a6f4-54452511b01c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ffc4c715fa06d980b092b9cde8674872", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3628046, "client_id": 825128, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Waa_08193/works/43", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6a3a8b70/uploads/origins/48d6b7f6-005b-49d8-9a1e-996fabed072d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32943460575fef3ebbd2c79e2b40c687", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3628046, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", 