になっちゃうおうかな〜」「ヤベー！めちゃくちゃ可愛い！本気になっちゃうなコレ」\n\nさやかモノローグなどで（可愛い…？あたしが？）（どうしよう…男の人にそんな事言われた事無い）（ちょっと嬉しい…）\n\nという感じで、全部盛り込むのが難しい場合、台詞の長さなどアレンジが必要であればお任せします。\n\n\n\n注文が多くて申し訳ないです。\n絵の構図のバランスなどでリクエスト内容を全て盛り込むのが難しければ、一部オミットして下さい、お任せします。\n\nどうかよろしくお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@niea_ground01/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3eb96a3d/requests/154134_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6277a6b2180cd9624274030d10531dae", "srcset": "https://si.imgix.net/3eb96a3d/requests/154134_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6277a6b2180cd9624274030d10531dae, https://si.imgix.net/3eb96a3d/requests/154134_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c846add26b119179c85d9efa877e51c7 2x, https://si.imgix.net/3eb96a3d/requests/154134_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9cd3b4a5e543e3027a32fe94eca2244c 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 668104, "client_id": 257146, "nc": 177}, {"path": "/@niea_ground01/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 668104, "client_id": 28758, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e77491f4/requests/163988_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b9692da370b14698ee64cbd4c86da79", "srcset": "https://si.imgix.net/e77491f4/requests/163988_0?bg=%23fff&auto=format%2Cc