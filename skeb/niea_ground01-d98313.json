構いません\n（手首の布と筋肉質な腕で砕牙であることが伝わればOK）\n\n・紅葉は可能なら最初の方は着物をはだけさせた状態で\n　途中から全裸で\n（白足袋は最後まで履いたまま。人形は不要）\n\n・紅葉は眉の短さと額の二つの点がポイントになっていると思うので\n　作画時はご注意下さい\n\n・紅葉の表情は基本的に目を閉じ口を大きく開く感じで\n　必要に応じて歯を食いしばる等変化をつけて下さい\n\n＞NG表現\n血・鼻水・お漏らし・目がハート・アヘ顔・陰毛\n\n＞資料\nhttps://www.dropbox.com/sh/z0jox9zojsbgh00/AAAVLJS4PYU5xj7ySn-kX3dza?dl=0\nキャラ画像（砕牙以外の男キャラは今回関係ありません）\nhttp://urx.space/Hapw\n設定関連\n\n以上よろしくお願いします", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@niea_ground01/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 668104, "client_id": 42194, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f846a0ab/requests/129583_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=970da985b7cae016e1c23cdf2795bf43", "srcset": "https://si.imgix.net/f846a0ab/requests/129583_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=970da985b7cae016e1c23cdf2795bf43, https://si.imgix.net/f846a0ab/requests/129583_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe1c314ea459bd0c850b1ea0327a1a62 2x, https://si.imgix.net/f846a0ab/requests/129583_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd3f07e6933b3570fce6b9b309ae49e3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f846a0ab/requests/129583_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11a7a046250350a3f4faa44cac8ddad0", "srcset": "https://si.imgix.net/f846a0ab/requests/129583_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11a7a046250350a3f4faa44cac8ddad0, https://si.imgix.net/f846a0ab/requests/129583_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b41202f401b6d161fe23d5db787c8919 2x, https://si.imgix.net/f846a0ab/requests/129583