れてしまい、触手にキャットスーツの股間のジッパー開けられ挿入され足ピンで絶頂\n\n3F\n探索中後ろからダンジョンマスターの悪い女科学者(作画省略もしくはシルエットもしくは手だけでいいです)に特製の遅延ビームを浴びせられて極端に動きが遅くなる\nうまく抵抗できない間に女科学者に「ユリカちゃんは普段はインキャなのにカッコつけてる♬」とか色々揶揄われ股間のジッパー開けられて振動ディルド挿入されて、立ったまま足開いたポーズで絶頂\n\n※キャットスーツは脱がせないでください。破損も無しでお願いします　股間のジッパーを開けてエロいことしてください\n台詞あると嬉しいです。\n\nhttps://drive.google.com/drive/folders/1yDj8cl38C0zbiLpEvTDUDMP4jFD--EmB", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ketyadonn/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 735343, "client_id": 727284, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21574aad/uploads/origins/a59cb493-689b-4dc0-9cdb-316a3ba300d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c25c6f4db79dcaebefc5f022804f609f", "srcset": "https://si.imgix.net/21574aad/uploads/origins/a59cb493-689b-4dc0-9cdb-316a3ba300d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c25c6f4db79dcaebefc5f022804f609f, https://si.imgix.net/21574aad/uploads/origins/a59cb493-689b-4dc0-9cdb-316a3ba300d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=442da099658e794a67109170b687ecfc 2x, https://si.imgix.net/21574aad/uploads/origins/a59cb493-689b-4dc0-9cdb-316a3ba300d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6daa3e038f9aaeccfb3468f2d8edd65 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21574aad/uploads/origins/a59cb493-689b-4dc0-9cdb-316a3ba300d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbf3a4c4aa3eba1e6a158a1cfa718d44", "srcset": "https://si.imgix.net/21574aad/uploads/origins/a59cb493-689b-4dc0-9cdb-316a3ba300d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbf3a4c4aa3eba1e6a158a1cfa718d44, https://si.imgix.net/21574aad/uploa