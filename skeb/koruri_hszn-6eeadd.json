c9-4772-a684-3038888d27e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=972fddffea0f0b2e8eb5df31a81b130e 2x, https://si.imgix.net/9344afc7/uploads/origins/45414ae2-03c9-4772-a684-3038888d27e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=41e5bb450c3c6be5e18feef4184a159a 3x"}, "body": "星園こるり先生初めまして🌟\n以前から先生の描かれる鍵の子達のイラストが可愛いなと思ってまして今回思い切ってSkebを依頼したいと思います✨\n\n[依頼内容]\n9月をイメージさせるplanetarianほしのゆめみちゃんをお願い致します。\n\n現在「毎月ゆめみちゃん」って自主企画を行ってましてSkebで毎月その月をイメージさせるゆめみちゃんを色々な先生に描いて頂き毎月1日にTwitterにアップする事をしております。\n「毎月ゆめみちゃん」 https://twitter.com/i/events/1527133823812571137?t=8yebdo2V-KFEsYZJFm7LNg&s=09\n\nパッと見て9月だなーっ思う感じのゆめみちゃんをお願い致します。\n\n構図やポーズ等は全ておまかせでお願い致します。\n（参考までに4月は桜と和装、5月はカーネーションと幼いイメージ（こどもの日）6月はアジサイと傘をさしてる姿（梅雨）7月は天の川と織姫衣装（七夕）で各先生が描いて下さってます。（現在4月〜7月分をアップしてます））\n\nもし可能でしたら8月末くらいに納品して頂けると大変助かります😂\n\nどうかよろしくお願い致します(⁎ᴗ͈ˬᴗ͈⁎)", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koruri_hszn/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 382075, "client_id": 876910, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af814ec2/uploads/origins/ece72795-5fc8-4bcc-913f-0015d8f9e7a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ec21ef98e2bee34959b8a4422b6597a", "srcset": "https://si.imgix.net/af814ec2/uploads/origins/ece72795-5fc8-4bcc-913f-0015d8f9e7a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ec21ef98e2bee34959b8a4422b6597a, https://si.imgix.net/af814ec2/uploads/origins/ece72795-5fc8-4bcc-913f-0015d8f9e7a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee7939c0890281eb23c63a61042444e1 2x, https://si.imgix.net/af814ec2/uploads/origins/ece72795-5fc8-4bcc-913f-0015d8f9e7a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8955280953d389707500b19667d33bee 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af814ec2/uploads/origins/ece72795-5fc8-4bcc-913f-0015d8f9e7a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89947b6916e346f484618bc9e7ca2def", "srcset": "https://si.imgix.net/af814ec2/uploads/origins/ece72795-5fc8-4bcc-913f-0015d8f9e7a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89947b6916e346f484618bc9e7ca2def, https://si.imgix.net/af814ec2/uploads/origins/ece72795-5fc8-4bcc-913f-0015d8f9e7a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b4d17b06d6583b2bb4ef2d575c2b1c65 2x, https://si.imgix.net/af814ec2/uploads/origins/ece72795-5fc8-4bcc-913f-0015d8f9e7a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fb8b8043d0a9474184f24743a4ba6dbd 3x"}, "body": "リクエスト失礼します。\n宜しければ下記のイラストをお願いします。\n\n【依頼内容】\nKanonの町で夕暮れの中の沢渡真琴をお願いします。\n日が沈む直前の物悲しくも美しい雰囲気の中で笑顔の真琴が見たいです。\n\n・夕暮れの切なさと真琴のかわいい笑顔のギャップが見たいです。\n\n・真琴の服装は青ジャケットのいつもの服装\n\n・真琴の表情は笑顔。\n　ウインクしている差分や\n　水織静久のようにニーッと笑っている差分があると嬉しいです\n（あまり似合わないと思ったら無くても構わないです）\n\n・夕陽に真琴の髪色が合っているのと\n　青色のジャケットが補色となって映える感じをお願いします\n\n・帰り道で先を歩く真琴がこちらに振り返って\n　両手を後ろに回しているポーズ\n（似合うのが思いつかないので\n　良いのがあったら自由に変えてください）\n\n\n以下はシチュエーションを補足するイメージです。\n\n・Kanonの町で、主人公と真琴が楽しく一緒に夕暮れの道を歩いているというシチュエーション\n\n・積もっている雪に夕陽が反射していて輝いているイメージ\n\n\n以上です。よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koruri_hszn/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 382075, "client_id": 121976, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8780b99/uploads/origins/cf13aa95-7510-4131-8e57-03ccf76e7d33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=031573173fce6d49fdb1675e22f062fa", "srcset": "https://si.imgix.net/b8780b99/uploads/o