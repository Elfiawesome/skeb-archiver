tipped": false, "creator_id": 3369573, "client_id": 2302140, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3c9e75a/uploads/origins/b376770b-5799-40ad-a6c1-fb9c1502938d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25d804d29529fb804e035f3b182382b7", "srcset": "https://si.imgix.net/d3c9e75a/uploads/origins/b376770b-5799-40ad-a6c1-fb9c1502938d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25d804d29529fb804e035f3b182382b7, https://si.imgix.net/d3c9e75a/uploads/origins/b376770b-5799-40ad-a6c1-fb9c1502938d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2bea8a44421f0e4060460050842b461 2x, https://si.imgix.net/d3c9e75a/uploads/origins/b376770b-5799-40ad-a6c1-fb9c1502938d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4895ee97e0616fb82f652fba8841f2f4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3c9e75a/uploads/origins/b376770b-5799-40ad-a6c1-fb9c1502938d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=876718d2c7c47921478e5cdb601eae2a", "srcset": "https://si.imgix.net/d3c9e75a/uploads/origins/b376770b-5799-40ad-a6c1-fb9c1502938d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=876718d2c7c47921478e5cdb601eae2a, https://si.imgix.net/d3c9e75a/uploads/origins/b376770b-5799-40ad-a6c1-fb9c1502938d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=014c29939e0409c87533f52a9f474b67 2x, https://si.imgix.net/d3c9e75a/uploads/origins/b376770b-5799-40ad-a6c1-fb9c1502938d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a91d6cb621af385ecd31901428204781 3x"}, "body": "夜分遅くに失礼いたします。\nつい最近、怨さまのイラストを拝見したのですが、不穏な雰囲気と白黒のコントラストが大変好みで一目惚れをしてしまいました。\nぜひ、当方のｃｐを描いていただきたく、この度依頼を送らせていただきました。\n\n下記が詳細です。\n\n・世界観について\nFateシリーズの「聖杯戦争」という儀式に参加している主従です。マスター（主）がoc、サーヴァント（従）がお相手様のモルガン（Fate/Ｇrand Orderより）になります。\n\n・関係性について\n出会い＞夜の教会で殺人現場を目撃してしまった一般人のocちゃんが、犯人であるモルガンに殺されかける。しかし彼女はocちゃんを利用できると判断し、歪な主従関係を結んだ。\n\n別れ＞聖杯戦争というのは他の主従も参加していて、最終的に他の陣営によってocちゃんとモルガンは敗れる。ｏcちゃんは命を取り留めるが、モルガンは重傷を負いこの世界に存在を保てなくなる。※サーヴァントは人間ではないため「死ぬ」のではなく、霊体が崩れて消滅し、元いた場所へ還ります（これを“退去”と呼ぶ）。\n\n初めはかなりギスギスしており、終盤にかけて徐々に歩み寄っていきます。\n一応主従という形ではありますが、実際の立場や主導権はモルガン側が握っている関係です。\n\n・ｃｐイメソン\n序盤＞失楽ペトリ/ナナホシ管弦楽団さま\n終盤＞秘密/はるまきごはんさま\n\n・登場人物の詳細\nｏcちゃん＞一般人の女性。基本的に常識人だが、覚悟を決めると芯が強い。一人称は私、呼称（ｏｃ→モルガン）はルーラー・あなた、柔らかい口調の常体（例：～かな、～だよ）。\n\nモルガン＞日本に召喚されたサーヴァント。傲慢で冷酷、女王のような態度。一人称は私、呼称（モルガン→ｏｃ）はマスター・貴女、口調は淡々とした敬語。「～するように」、「～しなさい」など時々上から目線な話し方になる。\n\n・漫画の内容\n“死”を巡って二人の倫理観がぶつかるような会話シーンを描いていただきたいです。ｏｃちゃんは一般人なので人の死を重く受け止め、対してモルガンは“死”に対して淡々としています。距離感が近い描写は大丈夫なのですが、甘々な雰囲気は避けていただけるとありがたいです。\n\nなにとぞ、よろしくお願いいたします。\n\nhttps://x.com/coo1261332/status/2031393188188131654?s=46", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@n84050/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b4d52022/uploads/origins/6ab18bf0-8e1f-42e6-a531-0f12f3888fba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5874a7ae851d0c3b4705ca1c9237e846", "srcset": "https://si.imgix.net/b4d52022/uploads/origins/6ab18bf0-8e1f-42e6-a531-0f12f3888fba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5874a7ae851d0c3b4705ca1c9237e846, https://si.imgix.net/b4d52022/uploads/origins/6ab18bf0-8e1f-42e6-a531-0f12f3888fba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99183de42250facc3e439cb4d936a95d 2x, https://si.imgix.net/b4d52022/uploads/origins/6ab18bf0-8e1f-42e6-a531-0f12f3888fba?bg=%23fff&auto