36a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bcbbccd06d8f887b9762e64eb4188cd", "srcset": "https://si.imgix.net/0416e5c1/uploads/origins/bf9d1ce2-35ce-4f19-a802-90c0ebdbf36a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bcbbccd06d8f887b9762e64eb4188cd, https://si.imgix.net/0416e5c1/uploads/origins/bf9d1ce2-35ce-4f19-a802-90c0ebdbf36a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7116530f00d74379998622351258487f 2x, https://si.imgix.net/0416e5c1/uploads/origins/bf9d1ce2-35ce-4f19-a802-90c0ebdbf36a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=edde0bed1a658d01f777c1ede0bb93e3 3x"}, "body": "お世話になっております。\n前回とは内容を変えて、改めてアティ先生のリクエストさせていただきます。\nよろしければ、以下の内容でリクエストをお受けいただけませんでしょうか?\n\nキャラクター　\nサモンナイト3　アティ(オリジナルコス版)\n\nご依頼内容　\nオリジナルコスのアティ先生をお願いします。\nコスの構成としては、ぴっちりスーツの上にビキニアーマーのような柔らか金属という感じの水着を着用している構成になります。\nコスのデザインや形状などはあいんつ様のお好みなイメージでデザインを変えていただいて結構です。\nポーズについてもお任せいたします。\n\nなお、追加で以下の要素もあるとうれしいです。\n・アーマーをパージしたスーツのみ状態\n・ぴっちりスーツなしで素肌の上に水着を着ている状態\n\n参考資料の説明\n参考資料1/3が設定図、参考資料2が自分でコスプレ衣装として作成したものになります。\nイラストを描かれる際は気に入った要素をお好みで取捨選択いただければと思います。\n\n参考資料1 : コスチュームのイラスト1\nhttps://www.pixiv.net/artworks/97779890\n\n参考資料2 : 自分でコスプレした時の写真\nhttps://drive.google.com/drive/folders/1-FTOlq6rA7lda-wLJHBeB_2Tvl0qpF7o\n\n参考資料3 : コスチュームのイラスト2\nhttps://drive.google.com/open?id=17MY1s3BKsVoQF_Vhe7AOXohHz2GdegEW&usp=drive_fs\n\n以上、ご検討の程よろしくお願いいたします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@einz_zwei/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 18881, "client_id": 7118, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1bdd81be/uploads/origins/d352aa56-9516-43fb-b200-6ee4d84876b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64b7835bd599fe730619189515968d74", "sr