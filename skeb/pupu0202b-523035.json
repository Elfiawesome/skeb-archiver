200&s=d092f7fdf4fb19cbaa23331fc7e70e8a, https://si.imgix.net/7223a2a4/uploads/origins/84fb9b3f-aad9-496d-ad2e-1a8052d67711?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebf66f3c5fc52a7866c2c316ffafcb60 2x, https://si.imgix.net/7223a2a4/uploads/origins/84fb9b3f-aad9-496d-ad2e-1a8052d67711?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adcca984694099585999c4ed15d83701 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7223a2a4/uploads/origins/84fb9b3f-aad9-496d-ad2e-1a8052d67711?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=247c396da5b7a6004328d8ee88c2262e", "srcset": "https://si.imgix.net/7223a2a4/uploads/origins/84fb9b3f-aad9-496d-ad2e-1a8052d67711?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=247c396da5b7a6004328d8ee88c2262e, https://si.imgix.net/7223a2a4/uploads/origins/84fb9b3f-aad9-496d-ad2e-1a8052d67711?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e4668f1ed3a451d94bcf7e8186ad0d5e 2x, https://si.imgix.net/7223a2a4/uploads/origins/84fb9b3f-aad9-496d-ad2e-1a8052d67711?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ebd1661cd73cdc59f70b46e03745ed9a 3x"}, "body": "はじめまして。\nXやSkebでの素敵なイラストを見て今回是非お願いしようと思いました。\nVTuberの「咲乃もこ」ちゃんをお願いします。\n八重歯が特徴的な元気な女の子です。\n\n【構図】\n･髪型は資料URLの髪型でお願いします\n･衣装は神域リーグ2024のチームアキレスのユニフォームでお願いします\nユニフォーム資料(1番左の赤色)←少し画像が荒くてスミマセン\nhttps://twitter.com/shiniki_league_/status/1660975465929281536?t=qNhTPc9H60VzjOfTo-KWJg&s=19\n※左胸と左肩にチームのロゴ、右肩に雀魂のロゴが入っております\n※もし背中を描かれる際は名前の表記はMOCOでお願いします\nチームロゴ資料\nhttps://mj-news.net/news/shiniki-league/20220507183345\n雀魂ロゴ資料\nhttps://gakusei-majan.com/event/carnival.html\n※実物のユニフォームは以下のYouTubeの配信で監督が着ております\nhttps://www.youtube.com/live/myBEr-4ilDg?si=67t0_GaXoiPW5uJB\n･ユニフォームの下は膝までの黒いスカートorスパッツなどカッコイイ感じでお願いします\n･ポーズは右手に麻雀牌をカッコ良く持ち、表情は口を開けて笑顔でお願いします\n･もし可能でしたら表情差分(口を閉じて真剣顔)もいただけたら嬉しいです\n\n【その他】\n･サムネなどで使用しやすいよう髪や手や衣装が上と左右の枠内に全て収まるようお願いします\n･ファイル形式はPSDでお願いします\n･それぞれ差分のレイヤーを分けたデータ&背景透過のデータもいただけたら嬉しいです\n\n【使用目的】\n彼女のVTuber活動(主にYouTubeやX)での使用、私はSNS上(主にYouTubeやX)でのアイコン&ヘッダー&切り抜き動画での使用です。\nよろしくお願い致します。\n\nhttps://twitter.com/SakinoMoco/status/1768590090316743009?t=4NgIdAVDt3pWpW3Mptk40g&s=19", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pupu0202b/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3185343, "client_id": 2828784, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c104cb0b/uploads/origins/39a454b3-6248-4edf-8362-315d732ecc2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab6c76bbbdd1fd7a9c6dbc94ce46e9bc", "srcset": "https://si.imgix.net/c104cb0b/uploads/origins/39a454b3-6248-4edf-8362-315d732ecc2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab6c76bbbdd1fd7a9c6dbc94ce46e9bc, https://si.imgix.net/c104cb0b/uploads/origins/39a454b3-6248-4edf-8362-315d732ecc2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=334454b563efdbcf2d0f6d04221b41d6 2x, https://si.imgix.net/c104cb0b/uploads/origins/39a454b3-6248-4edf-8362-315d732ecc2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af44f5e44838bcfdf879f6d3319f255b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c104cb0b/uploads/origins/39a454b3-6248-4edf-8362-315d732ecc2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cdc082f3bbc4abe44e023af0555d39f0", "srcset": "https://si.imgix.net/c104cb0b/uploads/origins/39a454b3-6248-4edf-8362-315d732ecc2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cdc082f3bbc4abe44e023af0555d39f0, https://si.imgix.net/c104cb0b/uploa