}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@shacha12349876/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3033976, "client_id": 3803085, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c295d54/uploads/origins/e494f185-e6c0-41dd-9e2a-4975bb649cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc3b4f758a847d7cc213932f341cf7ef", "srcset": "https://si.imgix.net/8c295d54/uploads/origins/e494f185-e6c0-41dd-9e2a-4975bb649cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc3b4f758a847d7cc213932f341cf7ef, https://si.imgix.net/8c295d54/uploads/origins/e494f185-e6c0-41dd-9e2a-4975bb649cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26be5912990cde7cb0124ae544c4060c 2x, https://si.imgix.net/8c295d54/uploads/origins/e494f185-e6c0-41dd-9e2a-4975bb649cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b35ade964772f7510240b1ad6d39114 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c295d54/uploads/origins/e494f185-e6c0-41dd-9e2a-4975bb649cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24c76e35a68e9e7dbac28ff07b3a577c", "srcset": "https://si.imgix.net/8c295d54/uploads/origins/e494f185-e6c0-41dd-9e2a-4975bb649cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24c76e35a68e9e7dbac28ff07b3a577c, https://si.imgix.net/8c295d54/uploads/origins/e494f185-e6c0-41dd-9e2a-4975bb649cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f7455e484f49db3b952a61a14a7fc6c 2x, https://si.imgix.net/8c295d54/uploads/origins/e494f185-e6c0-41dd-9e2a-4975bb649cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1d80f7eeb66f75232217707e03fe84f0 3x"}, "body": "こんにちは^^、翻訳に誤りがあればあらかじめお詫び申し上げます。英語しか話せない🇺🇸在住のクライアントとして、依頼にはSKEBの自動翻訳機能を利用せざるを得ません。決して失礼な意図はありません！Twitterで作品例を拝見し、素晴らしいアートスタイルに感銘を受けました。よろしければご依頼させていただきたいです。\n\nもし可能であれば、私のオリジナルキャラクターを描いていただけると嬉しいです。彼女の名前はCutiie Gurliie！（発音：クーティー・ガーリー）。参考画像を私のBlueskyアカウントにアップロードしました。リンクは下記に貼ります！過去のSKEB依頼も参考になるかもしれません！\n\nポーズ・衣装・表情・背景などは全てお任せします。一点だけお願いがあります——メインデザインに沿った描画をお願いします（衣装の変更は自由です）。具体的には、目の色・髪の色は変更せず、髪はカールしたままにしてください。また、メガネ・耳・しっぽも外さないでください。🙏\n\n創作の参考までに、彼女の背景をご紹介します：キューティー・ガーリーは、会社員として働いていたアーティストが描いたオリジナルの猫耳キャラクターでした。長い仕事の後、気軽に描かれたスケッチです。アーティストの他の作品同様、彼女の肖像画は自宅の壁に飾られていました。\n\nしかし、彼女を生み出した作者は世界を滅ぼした戦争で命を落とした。武器とガスが空から降り注ぎ、人類に永遠の終焉をもたらした。その戦争で使われた化学物質が大気中に残留し、彼女をキャンバスから蘇らせた。今、彼女は作者の廃墟となった家の廊下を彷徨い、この朽ちゆく世界で喜びを見出している。\n\nキューティー・ガーリーは鮮やかでありながら無垢な存在だ。彼女の世界に生き物は存在せず、深い孤独に苛まれている。語り合う相手はおらず、ほとんど何も知らない。情熱的な芸術家に愛された不滅の絵画でありながら無機質で、その愛を知る由もなかった。そして命を与えられた時、それはまさに創造主を滅ぼした力によってだった。 周囲でゆっくりと流れる時間を見つめながら、孤独と死ねない運命にもかかわらず、彼女は微笑みを保とうとする。探索を続け、いつか破壊される前の世界を目にしたいと願っている。この希望を胸に、彼女は鮮やかで遊び心にあふれ、生命力に満ちた存在であり続けようと前進する。もちろん、これらの要素は絵にとって必須ではありません！できるだけ詳細を共有したかっただけです。長文で申し訳ありません！\n\nご検討いただき誠にありがとうございます！お引き受けいただければ、どんな作品が生まれるか今からワクワクしています！敬具 Mawkiie 💐 https://bsky.app/profile/cutiiegurliie.bsky.social/post/3mcpg4aq7bk2a", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@kenpi_amedama/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3907565, "client_id": 3033976, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9243b9cb/uploads/origins/fabca0b3-805f-43fe-919c-f2af85719a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dfc68afb7d661af1d767c8e2b1ebfb7", "srcset": "https://si.imgix.net/9243b9cb/uploads/origins/fabca0b3-805f-43fe-919c-f2af85719a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dfc68afb7d661af1d767c8e2b1ebfb7, https://si.imgix.net/9243b9cb/uploads/origins/fabca0b3-805f-43fe-919c-f2af85719a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fe513a02b083d453a67c7a1abea3cf7 2x, https://si.imgix.net/9243b9cb/uploads/origins/fabca0b3-805f-43fe-919c-f2af85719a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e361ebc39b1eddfe8417055c71b31cbe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9243b9cb/uploads/origins/fabca0b3-805f-43fe-919c-f2af85719a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d981bad915458e3c61c2bdf7e8f598b8", "srcset": "https://si.imgix.net/9243b9cb/uploads/origins/fabca0b3-805f-43fe-919c-f2af85719a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d981bad915458e3c61c2bdf7e8f598b8, https://si.imgix.net/9243b9cb/uploads/origins/fabca0b3-805f-43fe-919c-f2af85719a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=de669805d979927fa42656ed3194fed6 2x, https://si.imgix.net/9243b9cb/uploads/origins/fabca0b3-805f-43fe-919c-f2af85719a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e480bf5f2263250207f4639f0ab33b19 3x"}, "body": "雨玉さんへ\nイラストのご依頼をしたくやってまいりました…ｯ！\n女性ではなく申し訳ございません…っ！！！\n\n描き方 塗り方 表情 ポーズ等全てお任せしたいです。\n本当に！どんな絵柄でも大歓迎です！\n髪型や色等大体のものを変えていただいても問題ありません\n唯一変えて欲しくない点は彼が斜視である点です\n\n【以下設定】\n《名前》ヘクター・ハーロウ(Hector Harlow)\n《年齢》26歳\n《性別》男性\n《外見》右目が上斜視。左目が正常。瞳孔不同も患っており、右目の瞳孔が小さいまま開きません。\n髪型は後ろに流しているだけで縛ってはいません。殺人を犯す時は怖く見える右目を強調し、仕事時は優しく見える左目を強調出来るよう反転した前髪にします。\n普段は、ハンチング帽やハットを被ったりスーツ姿だったりコートを着ていたり色んな格好です。シャツだけの時もあります！\n(1920年のロンドンの服装は参考画像等ご覧下さい！)\n\n《特徴》悪役。\n1920年のロンドンの新聞記者。カメラが趣味。\n殺人を犯し自身でそれを記事にする手法で『ジャックザリッパー再来』と称し劇場型犯罪を行いました。使用した凶器はバタフライナイフです。\n民衆を扇動して下らない大狂騒を起こしたいがためだけにやってます。\n自身の頭脳を誇っており、殺人現場に残した暗号と自身の記事を組み合わせることで次の殺人現場を示すようにしています。\n最終的に軍側の新人主人公らと軍用犬に追い詰められて捕まりました。犬が決め手だったので、それ以来黒い犬が嫌いです。\n\n《性格》外面のいい煽り厨愉快犯なやつです。職場の人々からは仕事のできる可愛い後輩、頼れる優しい先輩となってます。\nしかし、素は「うぇーいwww効いてて草～www」って感じです。\n\n「大衆を動かすのに必要なのは1本のナイフと1本のペンだけだよ。他はなぁんもいらない。あぁ、でも…そこに『悪役』なんかがいたら最高の舞台になるだろうね〜w」\n\nどうぞよろしくお願いいたします！\n再送を要求して下さっても全く問題ございません！\n\n参考画像\nhttps://drive.google.com/drive/folders/1eVMh-hrSmtEOLa3bGKEPTajha72vsXtF\n\nhttps://drive.google.com/drive/folders/1eVMh-hrSmtEOLa3bGKEPTajha72vsXtF", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ojisanno_tikubi/works/53", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2961394, "client_id": 3033976, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91177d00/uploads/origins/68bf3e9e-fe6d-4aa7-bc7d-d2fc8f913547?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c16fa8052bc3ae945d0ae162f3aa7c8", "srcset": "https://si.imgix.net/91177d00/uploads/origins/68bf3e9e-fe6d-4aa7-bc7d-d2fc8f913547?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c16fa8052bc3ae945d0ae162f3aa7c8, https://si.imgix.net/91177d00/uploads/origins/68bf3e9e-fe6d-4aa7-bc7d-d2fc8f913547?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd354d79c1f05605dc68770ad1965b51 2x, https://si.imgix.net/91177d00/uploads/origins/68bf3e9e-fe6d-4aa7-bc7d-d2fc8f913547?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5968374dacb998585c96f415bac3aa1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91177d00/uploads/origins/68bf3e9e-fe6d-4aa7-bc7d-d2fc8f913547?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13034f704e7d44fde13a0a54e2c1d646", "srcset": "https://si.imgix.net/91177d00/uploads/origins/68bf3e9e-fe6d-4aa7-bc7d-d2fc8f913547?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13034f704e7d44fde13a0a54e2c1