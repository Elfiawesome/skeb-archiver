set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b8d3f21/uploads/origins/3934dea9-14d6-4cd7-bb08-0e1c2f1317d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56421119df44f7ad74fe088dc7d6c29c", "src_set": ""}, "body": "だいいち様、はじめまして。\n作品を拝見しリクエストをさせていただきます。\n依頼内容は私のオリジナルキャラクター\n『フォルテ』のイラストを描いて欲しいです。\nシュチュエーションや構図は全てお任せします。\n\n［詳細］\n服装：参考資料URLのビキニタイプの水着(色は濃紺)・右太腿に黒いベルト\n表情：だいいち様にお任せします\n髪：白に近い銀髪\n装飾品：後ろ髪に赤い布製のリボン\n目：目尻に紅化粧(隈取に近いものでグラデーションは無し)・左目元にほくろがあります\n胸：サイズはIカップ(目安ですので描きやすいサイズに変更されて構いません)\nその他：参考画像では黒いブーツを履いていますが素足でお願いします\n\n参考資料URL：https://twitter.com/SHAMROCK077/status/1773325667863597091\n\nお忙しい中とは思いますが、\nご検討を何卒よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@K_Daiiti/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 656939, "client_id": 2511111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fc33642/uploads/origins/8749a814-deda-437d-9691-e0d0c5b93c18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b4c99d944e7af810b01d56633f93ab3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6fc33642/uploads/origins/8749a814-deda-437d-9691-e0d0c5b93c18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50724d38a3d6da0699a59c24b145a376", "src_set": ""}, "body": "はじめまして\nXに投稿されているイラストを見て、とても可愛らしくて、描いていただければと思いリクエストを送信します\n\n【作品】遊戯王OCG\n【キャラクター】ジーナの蟲惑魔\n【シチュエーション】\n「あれ？来たんだ？？まあゆっくりしていってよ」という感じでお願いします\n元イラストが少し怖い感じですが、可愛く描いていただければ嬉しいです\n\n背景等はお任せします\nよろしくお願いします\n\nhttps://gyazo.com/457860f5ca573a0cad64ca594edd4d0a", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@K_Daiiti/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 656939, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0db12b7/uploads/origins/4ac91b22-d484-47ee-84c8-28f8164a5e7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9752cdf7fdde13809a466eb875651f0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0db12b7/uploads/origins/4ac91b22-d484-47ee-84c8-28f8164a5e7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bb35370e61ecbc11a276bface2ca7d8", "src_set": ""}, "body": "前回、白金の城のラビュリンスのリクエストを作成頂きありがとうございました。\nまた新たにリクエストをさせて頂きます。\n\n・キャラクター\n　遊戯王OCG 鉄獣戦線 徒花のフェリジット\n\n参考資料\nhttps://twitter.com/YuGiOh_OCG_INFO/status/1283733120521396224/photo/1\n\n・衣装は三角ビキニでお願いします。\n　水着のブラは胸の前と首の後ろで紐で結ぶタイプ\n　ショーツはサイドで紐で結ぶタイプ\n・正面からみた構図で水着のブラは下乳が見えるようにお願いします。\n・スタイルが良いキャラなのでセクシーな感じでお願いします。\n\n以上、ご検討をお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@K_Daiiti/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 656939, "client_id": 3283997, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4433544/uploads/origins/00805aa2-7e57-49ce-9761-79406ea89f2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a98802a13246b46dc857a81333067da", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4433544/uploads/origins/00805aa2-7e57-49ce-9761-79406ea89f2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3537952d990d5e0470a7e3ae4e809445", "src_set": ""}, "body": "初めまして。\n\nだいいち様の描かれたイラストを見てリクエストしたく連絡させていただきました。\n\n早速ですが遊戯王より”ビキニ姿の風霊使いウィン”をお願いしたいです。\n\n詳細としまして\n・描写範囲は太ももより上、又は全身でお願いします。\n・風霊使いウィンの見た目は憑依装着ウィンくらいとしてください。\n（憑依装着ウィンは風霊使いウィンが成長した姿、と思ってください）\n・ビキニのデザインはお任せしますが、全体的に緑系統の色をベースとしてください。\n・ポーズは相手に対して手を振っている感じでお願いします。\n（イメージとしては「おーい、こっちだよー」と呼んでるような感じ）\n\n……以上になります。\n背景など、記載していない点や不明点に関しましては全てだいいち様の想像にお任せします。\n\n以上、ご検討いただけると幸いです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@K_Daiiti/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c6be53ff/uploads/origins/463e8692-7757-446d-9c92-a8a0e89d1700?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fca51d698c735861b92096560a737da", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 656939, "client_id": 2549593, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 2508625, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "櫻井", "screen_name": "_sakuryo", "avatar_url": "https://pbs.twimg.com/profile_images/1351940575113560064/zzpIjJhu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/935871054953644032/1666979692/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 0}, {"id": 2607386, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あずましろ", "screen_name": "azm046", "avatar_url": "https://pbs.twimg.com/profile_images/1887361639403642880/_BGXvJDD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/485798429/1738818254/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": 