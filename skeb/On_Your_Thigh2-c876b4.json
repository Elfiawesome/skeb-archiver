ed109cbc1e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d69284acc79231b48e847fcf11c19e5f", "srcset": "https://si.imgix.net/f74caf34/uploads/origins/493f2988-9975-448b-bd5f-aed109cbc1e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d69284acc79231b48e847fcf11c19e5f, https://si.imgix.net/f74caf34/uploads/origins/493f2988-9975-448b-bd5f-aed109cbc1e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=544a345bb6e7734ee583905516891417 2x, https://si.imgix.net/f74caf34/uploads/origins/493f2988-9975-448b-bd5f-aed109cbc1e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a9c9d8d83d4e13d479d677ee95ac5228 3x"}, "body": "水着宇津見エリセ〔第1再臨〕\n\nエリセの勉強を手伝っている時に、マスターが後ろから彼女の胸を揉み、ショーツの中に手を入れてアソコを弄るというシナリオをお願いします。\nエリセは照れながらも苛立ってしまいますが、勉強を続けようとするものの、結局は快感を感じてしまう…といった流れをイメージしています。\n\nこのシナリオは、以下のマイルームのセリフから着想を得ました。\n\n宇津見エリセ〔アヴェンジャー〕\n\n「複素数平面の……で、あるから……偏角が、こう……で、こうなって──あれ？ なぜだぁ？ ……あ、いたんだ。うん、勉強してた。ほらこれ、教科書と問題集のコピー。ちょっと上の学年の、歯応えあるやつをね。好きな本を読んでるばかりじゃ、糖分多すぎて、脳がだらけちゃうもの。きみだって、いつかまた学校に行くかもなんだし。たまには勘を取り戻しておいたほうがいいんじゃない？ っふふ、そうだよ。よかったらさ、この問題、教えてよ」", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@On_Your_Thigh2/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1447195, "client_id": 1806115, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66ea6701/uploads/origins/1e9bd39b-19c6-4421-9542-c49408403ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f409c17756b6013c5be9cbb5f259186d", "srcset": "https://si.imgix.net/66ea6701/uploads/origins/1e9bd39b-19c6-4421-9542-c49408403ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f409c17756b6013c5be9cbb5f259186d, https://si.imgix.net/66ea6701/uploads/origins/1e9bd39b-19c6-4421-9542-c49408403ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6497589501b6025e43062abf4e28ce13 2x, https://si.imgix.net/66ea6701/uploads/origins/1e9bd39b-19c6-4421-9542-c49408403ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e87ee42491eb1c3c1dd4d17a9a3eec5b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66ea6701/uploads/origins/1e9bd39b-19c6-4421-9542-c49408403ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=292d6dae4798ccd5c682f18e0fd1c4e6", "srcset": "https://si.imgix.net/66ea6701/uploads/origins/1e9bd39b-19c6-4421-9542-c49408403ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=292d6dae4798ccd5c682f18e0fd1c4e6, https://si.imgix.net/66ea6701/uploads/origins/1e9bd39b-19c6-4421-9542-c49408403ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=53a01711f6eccec653ee8137d426f1ff 2x, https://si.imgix.net/66ea6701/uploads/origins/1e9bd39b-19c6-4421-9542-c49408403ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93b9a2a60e9a14fd2affe9eba333a64d 3x"}, "body": "「水着メイヴ(セイバー)」と「水着巴御前(セイバー)」が一緒にカクテルバーに行き、巴が酔っ払って男たちにナンパされ、二人とも乱交セックスに発展するシナリオをお願いします。\nメイヴは第3段階、巴は第1段階です。\n体位、構図、詳細はお任せします。\n最後はメイヴと巴が精液まみれでピースサインをするシーンで締めくくりたいです。巴は正気を失っているはずですが、メイヴはまだ大丈夫なはずです。\n\nこのシナリオは、以下のマイルームのセリフから着想を得ました。\n\nメイヴ(セイバー)\n「あなたまた部屋に引きこもって……。ゲームばっかりやっていないで、いい加減外に出なさいな。男を漁れとは言わないけど、日の光くらい浴びましょう？ あと、一緒にカクテルバー行かない？」\n\n巴御前\n「あ、メイヴ様。はい……はい。そ、それはわかっております。いるつもりです。ですが……そ、その……未亡人気質をいつまでも引っぱるのはよくない、と仰られましても……巴は困ってしまいます。え、お酒ですか？ あ、いえ、巴は、酒気にはめっぽう弱く……！」", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@On_Your_Thigh2/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1447195, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6cc4