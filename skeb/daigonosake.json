bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=404740a98e7abc20751a308cd157848d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3476351, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@daigonosake/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3476351, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b9b252b/uploads/origins/5487e9e4-0c19-4bd3-b424-4ea942fec37c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2261e7c5d35b3159845dc12cc69d7adc", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b9b252b/uploads/origins/5487e9e4-0c19-4bd3-b424-4ea942fec37c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c2eb9b3e1a31a8424ccc9b9232a6750", "src_set": ""}, "body": "ライネスの放尿蹂躙お願いします。\n構図は過去に投稿されていた虹家ちゃんのイラストのようにローアングル、第二再臨のスカートに照れながらも悪戯っぽい表情をお願いします。\n\nhttps://www.pixiv.net/artworks/113784597", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@daigonosake/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3476351, "client_id": 69317, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c242b7a/uploads/origins/2b2516f9-d4ce-4699-9c25-df19382e3f4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=164f7976854f300ced1d6e54ac403433", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c242b7a/uploads/origins/2b2516f9-d4ce-4699-9c25-df19382e3f4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9bdb182ecd5d1446197e8c1b55e893e", "src_set": ""}, "body": "はじめまして。宜しければお願い致します。\n\n【人物】\nFGO\n・マシュ キリエライト（タイツ越し下着は白で若干シミあり） \n・縮小された男マスター（手のひらサイズ）\n\n【シチュエーション】\nマスターが目覚めると薄暗い空間にいた。\n両サイドには茶色い壁、そして黒く伸びた柱。\nその先にあったのは、巨大なマシュの股間だった。\n\n① マスター（先輩）を跨ぐようにしゃがみ込んでいるマシュ。マシュの股間の下には小さくされたマスター。マスターは大声で助けを呼ぶが、マシュの反応はない。\n実はマシュはマスターに気づいているが、気づかないふりをしていた。\n（マスターの気を引こうと、誰かに悪知恵を吹き込まれていた）\n\n（可能でしたら）\n差分\n演習後だったため、汗と熱気で臭いがきつく、マスターが倒れてしまう。\n自分の臭いで倒れたと知って、赤面し慌てるマシュの姿。\n\nマシュとマスターのセリフ付でお願いします。\nローアングルで、マシュの表情が見れると嬉しいです。\nタイツの有り無しで差分ができればお願いします。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1CTF4VFQoc-RVFeEsle0yx8WM9kGe78Aq?usp=drive_link", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@daigonosake/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3476351, "client_id": 2268049, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dff0a56a/uploads/origins/68e824a4-0701-49b7-93dd-49dc44549ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=418e928d4dd9e7a29d7bf6317b62e7ad", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dff0a56a/uploads/origins/68e824a4-0701-49b7-93dd-49dc44549ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09d548313024182ef8dfaa9c80fcf64c", "src_set": ""}, "body": "ファイアーエムブレムのワユが、ニヤニヤと見下す感じでおしっこで縮小都市を蹂躙するイラストが見たいです（最近描かれた山田リョウのイラストみたいな感じで）。\n具体的なセリフ・シチュ等はお任せします。\n\n上記を含めた差分として、以下の４枚を希望します。\n①文字あり・宛名あり\n②文字あり・宛名なし\n③文字なし・宛名あり\n④文字なし・宛名なし", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@daigonosake/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3476351, "client_id": 2268049, 