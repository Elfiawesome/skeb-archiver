fddb3e5dcd2808 2x, https://si.imgix.net/96a12bb5/uploads/origins/cba704cd-0dd6-4364-8177-2d8a962c36ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1295ec2c26c8dfe5c047db679fd6f8f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96a12bb5/uploads/origins/cba704cd-0dd6-4364-8177-2d8a962c36ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=779ed07adda783adf96a63e66b103419", "srcset": "https://si.imgix.net/96a12bb5/uploads/origins/cba704cd-0dd6-4364-8177-2d8a962c36ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=779ed07adda783adf96a63e66b103419, https://si.imgix.net/96a12bb5/uploads/origins/cba704cd-0dd6-4364-8177-2d8a962c36ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cfb7aec2368d3c259788126b89e70480 2x, https://si.imgix.net/96a12bb5/uploads/origins/cba704cd-0dd6-4364-8177-2d8a962c36ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ce41c89c3b7d8304da4e700fea093935 3x"}, "body": "はじめまして。私のオリジナルキャラクターのイラストをお願いします。\n\n【キャラクター】\n黒髪ロングの女の子です。デザインは https://imgur.com/a/BCHMJgO を参考にしてください。\n\n【シチュエーション】\nスクール水着で水泳の授業を受けている様子をお願いします。大きくなってきた胸を周りに見られるのが恥ずかしそうな感じが出ていると良いですが、細かいシチュエーションはお任せします。女子校設定なので他の生徒を描く場合は女子だけにしてください。\n\n【服装】\n紺色のスクール水着（競スクと呼ばれるタイプ https://dic.pixiv.net/a/%E7%AB%B6%E3%82%B9%E3%82%AF）\n\n【用途】\n小説の挿絵として利用します。\n\n以上、よろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@khD2n9WJleSLYH5/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2132954, "client_id": 875566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89487e9d/uploads/origins/627fb751-e0eb-4e33-b071-aeaa5605ec39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d29a9ccae15ac2ab31fbb30c4003d22", "srcset": "https://si.imgix.net/89487e9d/uploads/origins/627fb751-e0eb-4e33-b071-aeaa5605ec39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d29a9ccae15ac2ab31fbb30c4003d22, https://si.imgix.net/89487e9d/uploads/origins/627fb751-e0eb-4e33-b071-aeaa5605ec39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=617a4247ed2418c918eefb807ff18610 2x, https://si.imgix.net/89487e9d/uploads/origins/627fb751-e0eb-4e33-b071-aeaa5605ec39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a55167ae9dd100ea4071bacbc96a7f93 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89487e9d/uploads/origins/627fb751-e0eb-4e33-b071-aeaa5605ec39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b565cbb0fa5d1c0a1a50535e918d7e38", "srcset": "https://si.imgix.net/89487e9d/uploads/origins/627fb751-e0eb-4e33-b071-aeaa5605ec39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b565cbb0fa5d1c0a1a50535e918d7e38, https://si.imgix.net/89487e9d/uploads/origins/627fb751-e0eb-4e33-b071-aeaa5605ec39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f63073dacc5ed6dc265f9f27617fa6d 2x, https://si.imgix.net/89487e9d/uploads/origins/627fb751-e0eb-4e33-b071-aeaa5605ec39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd6d80c2a747d4dbf0b6a275d04ec184 3x"}, "body": "Would you be willing to draw my VTuber character with her hair down? She is a Cat Sprout (part plant, part cat) girl. She also has a mascot named \"Beepu\" you may include if you want to.\n\nSome things she likes:\n- gachapon & crane games\n- gardening & flowers & nature & swimming/water\n- cute things & animals\n- drawing\n\nHer personality is cute, energetic, cheeky and playful.\n\nPlease draw her in the way you find the most inspiring and fun for you! You can draw her in her official outfits, but a new outfit is okay too if you want! \n\nIf you prefer for me to pick a specific theme for you to draw, I think \"gachapon & crane games\", or something with flowers would be fun. \n\nPlease make sure to include the flower in her hair (part of her body) and the pendant on her necklace as they are crucial to her character!\n\nREFERENCE:\nhttps://imgur.com/a/PnFdfRq\n\nThank you for your time and consideration! 🙏 Your art is so beautiful!", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@khD2n9WJleSLYH5/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2132954, "client_id": 1910673, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa8a5a06/uploads/origins/2eb96e69-eeb7-4ebe-93a5-c3e151bf8f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d3850adbdd8bd0cb22d4c3a2e5aab1c", "srcset": "https://si.imgix.net/fa8a5a06/uploads/origins/2eb96e69-eeb7-4ebe-93a5-c3e151bf8f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d3850adbdd8bd0cb22d4c3a2e5aab1c, https://si.imgix.net/fa8a5a06/uploads/origins/2eb96e69-eeb7-4ebe-93a5-c3e151bf8f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a14955c78f14a93e6d0bcb8700b3b9f 2x, https://si.imgix.net/fa8a5a06/uploads/origins/2eb96e69-eeb7-4ebe-93a5-c3e151bf8f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=569cfd56b6650706150f4d7f5ab71da3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa8a5a06/uploads/origins/2eb96e69-eeb7-4ebe-93a5-c3e151bf8f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b06932d02da04f7e6485da824213a21e", "srcset": "https://si.imgix.net/fa8a5a06/uploads/origins/2eb96e69-eeb7-4ebe-93a5-c3e151bf8f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b06932d02da04f7e6485da824213a21e, https://si.imgix.net/fa8a5a06/uploads/origins/2eb96e69-eeb7-4ebe-93a5-c3e151bf8f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=16726145d69220b1609aaf34bdf63100 2x, https://si.imgix.net/fa8a5a06/uploads/origins/2eb96e69-eeb7-4ebe-93a5-c3e151bf8f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3a91b528ef1ca42fa8fbb5b78e129dbd 3x"}, "body": "こんにちは、はじめまして。新着クリエイターコーナーを見ていて、あなたを見つけ、Pixivもチェックしました。最初のクライアントになれたらうれしいです\n\n私のVTuberキャラを描いてくれませんか？\n\nhttps://drive.google.com/drive/folders/1dFUeXMWFYr2pZlRMCLY9W4zx2OvuNCww?usp=sharing\n\nCIAに勤めるアンドロイドの女の子です。黒色の鞏膜とAサイズの胸、そして175cmの身長!肌も平均より少し白っぽい。\n\n胡桃がリラックスして足を出している絵が好きです。私のキャラクターも同じように描いていただけませんか？素足でも、つま先のない足袋でもOKです。\n\nあくまで提案です。SFWであれば、どんなポーズや表情で描いてもOKです。\n\nご考慮ありがとうございました。お受けした場合は、私のキャラクターを楽しんで描いて頂ければと思います。\n\nhttps://drive.google.com/drive/folders/1dFUeXMWFYr2pZlRMCLY9W4zx2OvuNCww?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 188215, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "楠なのは", "screen_name": "Melty_zo", "avatar_url": "https://pbs.twimg.com/profile_images/1949877255536332801/PWXDylzA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1259496451/1759109773/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 235495, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "花鶏", "screen_name": "onatsu", "avatar_url": "https://pbs.twimg.com/profile_images/1964009614883872768/ZZ8kn83a.jpg", "header_url": "https://pbs.twimg.com/profil