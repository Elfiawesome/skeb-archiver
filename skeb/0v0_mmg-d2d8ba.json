3010\u30ec\u30d7\u30ea\u30ab\u30f3\u30c8\u306e\u846c\u5217\u3011\u81ea\u9663\u3092\u304a\u9858\u3044\u3057\u305f\u304f\u601d\u3044\u307e\u3059\u3002\n\n\u258d\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u8a73\u7d30\n\n\u25b7HO\u602a\u76d7 : \u8d64\u8336\u8272\u3063\u307d\u3044\u9aea\u3092\u3057\u305f\u7537\u6027\u3001181cm\u3002\n\u559c\u6012\u54c0\u697d\u304c\u6fc0\u3057\u304f\u5143\u6c17\u3067\u660e\u308b\u3044\u4eba\u7269\n\u30dd\u30b8\u30c6\u30a3\u30d6\u3067\u3042\u308a\u524d\u5411\u304d\u3060\u304c\u5c11\u3057\u306c\u3051\u305f\u6240\u304c\u591a\u304f\u5b50\u4f9b\u306e\u3088\u3046\u306a\u4eba\u3067\u3082\u3042\u308b\n\u8d0b\u4f5c\u5e2b\u3092\u5fc3\u306e\u5e95\u304b\u3089\u597d\u3044\u3066\u304a\u308a\u8ddd\u96e2\u304c\u8fd1\u3044\n\u53f3\u8033\u306b\u9752\u767d\u3044\u7fbd\u306e\u30d4\u30a2\u30b9\u3092\u3064\u3051\u3066\u3044\u308b\n\n\u25b7HO\u8d0b\u4f5c\u5e2b : \u767d\u9aea\u306e\u7537\u6027\u3001175cm\u3002\n\u30af\u30fc\u30eb\u304b\u3064\u7121\u8868\u60c5\u3067\u3042\u307e\u308a\u559c\u6012\u54c0\u697d\u3092\u8868\u60c5\u3067\u898b\u305b\u308b\u3053\u3068\u306f\u7121\u3044\u304c\u30ba\u30d0\u30c3\u3068\u7269\u4e8b\u306f\u8a00\u3046\n\u3044\u3064\u3082\u7d20\u3063\u6c17\u306a\u3044\u614b\u5ea6\u3092\u3068\u308b\u304c\u602a\u76d7\u306e\u3053\u3068\u306f\u76f8\u68d2\u3068\u3057\u3066\u304b\u306a\u308a\u4fe1\u983c\u3057\u3066\u3044\u308b\n\u5c11\u3057\u306c\u3051\u305f\u602a\u76d7\u306b\u5909\u308f\u3063\u3066\u5bb6\u4e8b\u3092\u3057\u3066\u3044\u308b\n\u5de6\u8033\u306b\u8d64\u9ed2\u3044\u7fbd\u306e\u30d4\u30a2\u30b9\u3092\u3064\u3051\u3066\u3044\u308b\n\n\n\u258d\u30ea\u30af\u30a8\u30b9\u30c8 \n\u5168\u3066\u304a\u307e\u304b\u305b\u3055\u305b\u3066\u304f\u3060\u3055\u3044\u3002\n\u69cb\u56f3\u3001\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\u3001\u30dd\u30fc\u30ba\u7b49\u3059\u3079\u3066\u81ea\u7531\u306b\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u308c\u3070\u3068\u601d\u3044\u307e\u3059\u3002\n\u53ef\u80fd\u3067\u3042\u308c\u3070\u9ce5\u30e2\u30c1\u30fc\u30d5\u306e\u602a\u76d7\u30b0\u30eb\u30fc\u30d7\u306a\u306e\u3067\u5468\u308a\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u306a\u3069\u306b\u7fbd\u306a\u3069\u3042\u3063\u305f\u3089\u5b09\u3057\u3044\u3067\u3059\n\n\n\u258d\u4f7f\u7528\u7528\u9014\n\u30fbSNS\u3078\u306e\u516c\u958b\uff08\u30a2\u30a4\u30b3\u30f3\u30fb\u30d8\u30c3\u30c0\u30fc\u306e\u4f7f\u7528\u542b\u3080(\u540d\u7fa9\u5fc5\u305a\u8a18\u8f09)\uff09\n\u30fb\u76f8\u65b9\u3078\u306e\u5171\u6709\n\u30fb\u89b3\u8cde\u7528\u00b7\u58c1\u7d19\u00b7\u30b0\u30c3\u30ba\u542b\u3080\u500b\u4eba\u7684\u4f7f\u7528\n\u53ef\u80fd\u3067\u3042\u308c\u3070\u30a2\u30a4\u30b3\u30f3\u3084\u30b0\u30c3\u30ba(\u500b\u4eba\u9451\u8cde\u306e\u7bc4\u56f2\u5185)\u306a\u3069\u306b\u3057\u305f\u3044\u3068\u8003\u3048\u3066\u3044\u308b\u305f\u3081\u900f\u904e\u306e\u30a4\u30e9\u30b9\u30c8\u3082\u826f\u3051\u308c\u3070\u9802\u304d\u305f\u3044\u3067\u3059\u3002\n\n\u203b\u30a2\u30a4\u30b3\u30f3\u30fb\u30d8\u30c3\u30c0\u30fc\u4f7f\u7528\u306b\u95a2\u3057\u307e\u3057\u3066\u306f\u30ec\u30d7\u30ea\u30ab\u30f3\u30c8\u306e\u846c\u5217\u306e\u76f8\u65b9\u306e(@potato_11_11)\u306b\u3082\u540c\u3058\u6a29\u5229\u3092\u304f\u3060\u3055\u308c\u3070\u3068\u601d\u3044\u307e\u3059\n\n\u4f9d\u983c\u5185\u5bb9\u304c\u91d1\u984d\u3068\u898b\u5408\u308f\u306a\u3044\u30fb\u305d\u306e\u4ed6\u4e0d\u5099\u306a\u3069\u304c\u3042\u308c\u3070\u304a\u6c17\u8efd\u306b\u518d\u9001\u8981\u8acb\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3067\u304d\u308b\u9650\u308a\u5bfe\u5fdc\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3059\u3002\u305d\u308c\u3067\u3082\u96e3\u3057\u3051\u308c\u3070\u30ad\u30e3\u30f3\u30bb\u30eb\u3057\u3066\u5927\u4e08\u592b\u3067\u3059\u3002 \n\n\u57fa\u672c\u3080\u304e\u3080\u3055\u3093\u306e\u63cf\u304d\u3084\u3059\u3044\u3088\u3046\u306b\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u308c\u3070\u3068\u601d\u3044\u307e\u3059\u3002 \n\u3054\u691c\u8a0e\u306e\u7a0b\u3001\u4f55\u5352\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\uff01\