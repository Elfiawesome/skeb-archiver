7-8aa9-f763efc577e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0fb4391fba2efaed11fa4dbcbe1fb34", "srcset": "https://si.imgix.net/84fc7f12/uploads/origins/6a8ba63d-b21a-4607-8aa9-f763efc577e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0fb4391fba2efaed11fa4dbcbe1fb34, https://si.imgix.net/84fc7f12/uploads/origins/6a8ba63d-b21a-4607-8aa9-f763efc577e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=360d7b858b79fe4e13a4f156819a7b44 2x, https://si.imgix.net/84fc7f12/uploads/origins/6a8ba63d-b21a-4607-8aa9-f763efc577e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=593f510a68aa8a40372745662b7d6ba9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84fc7f12/uploads/origins/6a8ba63d-b21a-4607-8aa9-f763efc577e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b63053299696457c9d6b95e2ccf8d856", "srcset": "https://si.imgix.net/84fc7f12/uploads/origins/6a8ba63d-b21a-4607-8aa9-f763efc577e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b63053299696457c9d6b95e2ccf8d856, https://si.imgix.net/84fc7f12/uploads/origins/6a8ba63d-b21a-4607-8aa9-f763efc577e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=04ef0c4b4bf6a5e7669598dfc7ab1864 2x, https://si.imgix.net/84fc7f12/uploads/origins/6a8ba63d-b21a-4607-8aa9-f763efc577e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f7ec0be408e37938ced1480d97081428 3x"}, "body": "むぎむさん、初めまして。\n以前よりイラストを拝見しており、むぎむさんの描かれる可愛らしいSDキャラとデザインが大好きです！\nもし可能でしたら、淡い色彩で描かれるゆるSDでOCを描いていただけたらと思いリクエストさせていただきました…！！\n\n\n【キャラについて】\n◆荏原(灰髪)：班長\nゆるちゃらな性格で「んはは」と気の抜けた笑い方をする。誰に対しても「～っすよねぇ」といった砕けた敬語口調。ま水辺にトラウマがあり、風呂(浴槽)/温泉/プール/海...etcが苦手。無理に踏み込んでこない有栖院に居心地の良さを感じている。武器は拳銃で体術は苦手。策を仕掛ける方が得意。\n\n◆有栖院(白髪)：班員\n礼儀正しい青年。あまり表情筋が動くこともないため、何かと誤解されがち。いいとこの坊ちゃんのため、周りからはやっかみで親の七光りと陰口を叩かれることも多い。昔、荏原に助けられたことがあり恩を感じている。また、荏原のトラウマを唯一知っている。拳銃も苦手ではないが、どちらかというと武闘派。\n\n二人は同じ捜査一課で同じ班の班長と班員になります。\n互いに救い救われているような穏やかな関係を築いています。\n\n\n【使用用途】\n個人観賞用、グッズ作成(個人用)\n\n\nお忙しい中、ここまでお読みくださってありがとうございます。\n金額不足などありましたら再送要請をしていただけますと幸いです。\n何卒、ご検討のほどよろしくお願いします…！\n\nhttps://drive.google.com/drive/folders/1tmekUcQyQs_dRj8n6lPWhWyzTTaTWgsj?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0v0_mmg/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3717274, "client_id": 2564749, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf8e3e11/uploads/origins/7c4f2ae5-fc64-4fb3-b237-0e44c6aeb418?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce8960ee324087f882641f944629c9e6", "srcset": "https://si.imgix.net/bf8e3e11/uploads/origins/7c4f2ae5-fc64-4fb3-b237-0e44c6aeb418?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce8960ee324087f882641f944629c9e6, https://si.imgix.net/bf8e3e11/uploads/origins/7c4f2ae5-fc64-4fb3-b237-0e44c6aeb418?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dafa3a1d5f87e6c9b902a6ddc7705a89 2x, https://si.imgix.net/bf8e3e11/uploads/origins/7c4f2ae5-fc64-4fb3-b237-0e44c6aeb418?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58f44c2ab4def7d62b30ead6c7c1608b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf8e3e11/uploads/origins/7c4f2ae5-fc64-4fb3-b237-0e44c6aeb418?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d4ab234951c00deaa5f6fb355b34b9a", "srcset": "https://si.imgix.net/bf8e3e11/uploads/origins/7c4f2ae5-fc64-4fb3-b237-0e44c6aeb418?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d4ab234951c00deaa5f6fb355b34b9a, https://si.imgix.net/bf8e3e11/uploads/origins/7c4f2ae5-fc64-4fb3-b237-0e44c6aeb418?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b8e6dfe3ed1a994b00af4a24db3c4059 2x, https://si.imgix.net/bf8e3e11/uploads/origins/7c4f2ae5-fc64-4fb3-b237-0e44c6aeb418?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ada62ef994179619954df22c48c3b5b5 3x"}, "body": "こんにちは！私のキャラクター、アイリーンを描いてほしいです。彼女は狂ったヤンデレです。胸から魔法の刀を引き抜くことができます。左手の人差し指がありません。暗殺者兼ボディーガードとしての本職以外の時間は、絵を描くことや絵画を楽しんでいます。\n\nhttps://f2.toyhou.se/file/f2-toyhou-se/images/102596752_j53KeVWuQEUgyAW.png こちらが彼女の参考画像です。\n\nhttps://toyhou.se/3347704.irene-matsushita/gallery#100769178 こちらは指の欠損が明確にわかる別の参考画像です。 \n\nhttps://i.pinimg.com/736x/58/10/ce/5810ce0dac59942e07596434e69b6f3d.jpg 彼女の刀はこんな感じ。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0v0_mmg/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3717274, "client_id": 3731397, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60c45d7e/uploads/origins/c6e1ed39-090c-4f29-91e8-dd58170e8d03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2914ede8b420a4a48fa3d0199582bffd", "srcset": "https://si.imgix.net/60c45d7e/uploads/origins/c6e1ed39-090c-4f29-91e8-dd58170e8d03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2914ede8b420a4a48fa3d0199582bffd, https://si.imgix.net/60c45d7e/uploads/origins/c6e1ed39-090c-4f29-91e8-dd58170e8d03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0ec8adabbf8e744010007899b7f6905 2x, https://si.imgix.net/60c45d7e/uploads/origins/c6e1ed39-090c-4f29-91e8-dd58170e8d03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f68c1b07afa510fb311e3ede88f02e60 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/60c45d7e/uploads/origins/c6e1ed39-090c-4f29-91e8-dd58170e8d03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75113d497739edb87043a5f8751b087c", "srcset": "https://si.imgix.net/60c45d7e/uploads/origins/c6e1ed39-090c-4f29-91e8-dd58170e8d03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75113d497739edb87043a5f8751b087c, https://si.imgix.net/60c45d7e/uploads/origins/c6e1ed39-090c-4f29-91e8-dd58170e8d03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=42d1db501044b8c619e1834bfab9b43f 2x, https://si.imgix.net/60c45d7e/uploads/origins/c6e1ed39-090c-4f29-91e8-dd58170e8d03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f1bc7687d449af2dee022c03bbbbfc8e 3x"}, "body": "むぎむ様\n\n初めまして、いつきと申します！\nこの度TRPGセッションに使用するSDイラストを依頼したくリクエストさせていただきました。\nお願いするキャラクターは『VOID』自陣のHO3とHO4、継続のセッションで使用するSDイラストを2人分お願い出来ればと存じます。\n\n\n・服装やポーズについて\n背後が爆発して逃げているシーンに使用したいと思っております。\n服装は2人とも一般的な黒いスーツに黒いサングラス\nHO3はサングラスを頭につけている状態、焦って逃げているような表情やポーズ\nHO4はサングラスを目元にかけてキリッとしているような表情やポーズ\n\n\n・使用用途\n友人とのTRPGセッションでの使用、SNS等のアイコンやヘッダー、友人への共有\nもし可能であれば1人ずつ背景透過でデータをいただけますと幸いです…！\n\n金額や依頼内容など、難しい点がございましたらお断りいただいて大丈夫です。\nご検討いただけますと幸いです。どうぞよろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1xEmNT4NRV5Wur50l1_1xDq8g39MKViwn", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0v0_mmg/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3717274, "client_id": 3835957, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/433d70bf/uploads/origins/411b0c3e-1c7d-47d8-8021-86e2cd509262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=213186a4adf737be13b0b1520d68e3ec", "srcset": "https://si.imgix.net/433d70bf/uploads/origins/411b0c3e-1c7d-47d8-8021-86e2cd509262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=213186a4adf737be13b0b1520d68e3ec, https://si.imgix.net/433d70bf/uploads/origins/411b0c3e-1c7d-47d8-8021-86e2cd509262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9c24f99dadf4bfa2dd172061ab4b907 2x, https://si.imgix.net/433d70bf/uploads/origins/411b0c3e-1c7d-47d8-8021-86e2cd509262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc5ed4da36c22a6c16f482e4f17402ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/433d70bf/uploads/origins/411b0c3e-1c7d-47d8-8021-86e2cd509262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0591b333dcc7677b5e4d32ab61a2725", "srcset": "https://si.imgix.net/433d70bf/uploads/origins/411b0c3e-1c7d-47d8-8021-86e2cd509262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0591b333dcc7677b5e4d32ab61a2725, https://si.imgix.net/433d70bf/uploads/origins/411b0c3e-1c7d-47d8-8021-86e2cd509262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=464ea0f4da16ab69bb1f3f84db0e6207 2x, https://si.imgix.net/433d70bf/uploads/origins/411b0c3e-1c7d-47d8-8021-86e2cd509262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a504989ffa0309fff6d40fb9973b1f59 3x"}, "body": "はじめまして。ゆるむぎむ様にSDをお願いしたくリクエストを送らせて頂きます。\n\n【内容】\nSNS等のアイコンに使用する為、OCをお願いいたします。\n\n【キャラクターについて】\n白い悪魔の女の子。無気力な様子だが、見た目よりは強い。\n見た目に関しましては添付資料内をご確認下さい。\n（資料内のイラストはイラストメーカーを使用して作成したものですが、制作者から「他者に依頼する際、提示しても良い」と許可を頂いています）\n\n【雰囲気について】\n人外（悪魔）である為、色白さやファンタジーっぽさを強調して頂けると嬉しいです。（リボンの大きさや袖の長さ、神の長さなど）\n表情は無表情寄りで、感情が読み取れない様子だと非常に幸いです。\n\n【使用用途】\n・SNS等でのアイコン、ヘッダー\n・個人鑑賞\n\n記入していない部分はお任せでお願いします。承認して頂けると幸いです。\n\nhttps://drive.google.com/file/d/1tKr4a3iL6WxX3Ouia6rHK01-uFSmOqFf/view?usp=drivesdk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0v0_mmg/works/7", "private_th