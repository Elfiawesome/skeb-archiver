と思います。\n可能であれば鳥モチーフの怪盗グループなので周りのレイアウトなどに羽などあったら嬉しいです\n\n\n▍使用用途\n・SNSへの公開（アイコン・ヘッダーの使用含む(名義必ず記載)）\n・相方への共有\n・観賞用·壁紙·グッズ含む個人的使用\n可能であればアイコンやグッズ(個人鑑賞の範囲内)などにしたいと考えているため透過のイラストも良ければ頂きたいです。\n\n※アイコン・ヘッダー使用に関しましてはレプリカントの葬列の相方の(@potato_11_11)にも同じ権利をくださればと思います\n\n依頼内容が金額と見合わない・その他不備などがあればお気軽に再送要請してください。できる限り対応させていただきます。それでも難しければキャンセルして大丈夫です。 \n\n基本むぎむさんの描きやすいように描いていただければと思います。 \nご検討の程、何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1m24s2FpoxK62Jd7b2l3kzao5xTcprWxu", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0v0_mmg/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3717274, "client_id": 3264588, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31c1c519/uploads/origins/d50d4f4a-bdc7-4f85-96ec-e95b7c24317f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=697146ad4e9e6cd15039cb0605c6e8bb", "srcset": "https://si.imgix.net/31c1c519/uploads/origins/d50d4f4a-bdc7-4f85-96ec-e95b7c24317f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=697146ad4e9e6cd15039cb0605c6e8bb, https://si.imgix.net/31c1c519/uploads/origins/d50d4f4a-bdc7-4f85-96ec-e95b7c24317f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c93476b2e4640202849a1d538ca7d589 2x, https://si.imgix.net/31c1c519/uploads/origins/d50d4f4a-bdc7-4f85-96ec-e95b7c24317f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c7f573589ccea70546a1969008565b1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31c1c519/uploads/origins/d50d4f4a-bdc7-4f85-96ec-e95b7c24317f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27f039e71482095886f6914b92d99a58", "srcset": "https://si.imgix.net/31c1c519/uploads/origins/d50d4f4a-bdc7-4f85-96ec-e95b7c24317f?bg=%23fff&auto=format%2Ccompress&fm=webp&f