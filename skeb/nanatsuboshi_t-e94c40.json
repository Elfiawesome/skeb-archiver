umika\n\nhttps://photos.app.goo.gl/oWGi3AGgRjb3bfhX9", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 380655, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "りめめり", "screen_name": "rmmr_neko21", "avatar_url": "https://pbs.twimg.com/profile_images/2033163459781935104/1WUTZKeb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1203536171663446016/1773911705/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 40, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 734799, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Antaro", "screen_name": "Antaro_0", "avatar_url": "https://pbs.twimg.com/profile_images/2002311056568508416/tduJJNeM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2571089472/1755025693/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 853932, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "しちがつ", "screen_name": "sitigatu0984", "avatar_url": "https://pbs.twimg.com/profile_images/1482669903630929924/aKquSAzM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/833203785509920768/1490535895/1500x500", "appeal_receivable": false, "popular_creator_rank": 91, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 2177354, "creator": true, "nsfw_acceptable": f