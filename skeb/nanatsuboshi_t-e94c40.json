top&w=200&h=200&blur=200&s=d2e0fe6462971abd01bfaa29c58c72f0 3x"}, "body": "はじめまして。\nななつぼし先生の絵を拝見させて頂き、\nとても好きなので、イラストのリクエストをさせて頂きたいです。\n\nVtuber「花咲くれは」(@_KRHana) さんを描いてお願いしたいです\n(ご本人からもファンアート依頼の許可はいただいております。)\n\n◆リクエスト内容\nバレンタインをテーマにしたイラストをお願いしたいです。\n構図やシチュエーションなど、他の要素については全てお任せします。\n\nもし可能であれば、顔まわりの髪、髪の毛は画角内に収めていただけると幸いです。\n\n◆使用用途\n花咲くれはさんへのプレゼントとして、\nご本人に限りの配信活動での使用許可を頂きたいです。\n（配信内や、配信のサムネ、X(旧Twitter)等で使用する可能性があります。）\n\n◆その他お願い\n宛名・人物・背景でレイヤー分けされたPSDで頂けますと幸いです。\n\nお忙しいところ申し訳ございませんが、\nご検討を頂けると幸いです、よろしくお願いいたします！\n\n\n参考資料：\nhttps://twitter.com/_KRHana\nhttps://pbs.twimg.com/media/GPo9iPmaMAAi7gq?format=jpg&name=large\nhttps://pbs.twimg.com/media/GeSZc6CbYAAXJ99?format=jpg&name=4096x4096", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nanatsuboshi_t/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2657127, "client_id": 3436008, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8afbc534/uploads/origins/ab2eba49-e182-4b9a-b1d8-1a8ab5acb03e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc16e5d6d98dca13f2fd817d0a336d9c", "srcset": "https://si.imgix.net/8afbc534/uploads/origins/ab2eba49-e182-4b9a-b1d8-1a8ab5acb03e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc16e5d6d98dca13f2fd817d0a336d9c, https://si.imgix.net/8afbc534/uploads/origins/ab2eba49-e182-4b9a-b1d8-1a8ab5acb03e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c79b1920a5f2d19c5e94a9d9ba6a97e 2x, https://si.imgix.net/8afbc534/uploads/origins/ab2eba49-e182-4b9a-b1d8-1a8ab5acb03e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96bb1419fb49dd5d6e80d55fec509b8a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8afbc534/uploads/origins/ab2eba49-e182-4b9a-b1d8-1a8ab5acb03e?bg=%23fff&auto=form