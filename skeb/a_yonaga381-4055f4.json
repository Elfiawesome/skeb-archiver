は最高の体を手に入れたと悦び邪悪な笑みを浮かべ、悪魔は人間だった時の男の子の姿に変え姿を消した。\nというのをお願いします。\n補足でこれが悪魔化した男の子の絵です。\n参考になれば幸いです。\nよろしくお願いします。\nhttps://www.pixiv.net/artworks/122400001", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 274225, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "古河おどろ", "screen_name": "RE_yomawari", "avatar_url": "https://pbs.twimg.com/profile_images/1925546316228435973/tmR-hNDu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/370459500/1771853406/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 1157027, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🐊㌠3𝐗", "screen_name": "RRARIKANTO", "avatar_url": "https://pbs.twimg.com/profile_images/1687158662933213184/xymlrqrR.png", "header_url": "https://pbs.twimg.com/profile_banners/3186555176/1687019086/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 160}, {"id": 1616186, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "忍田先生", "screen_name": "GSriz", "avatar_url": "https://pbs.twimg.com/profile_images/1479845579681591304/8uEGYMyz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1439739869798879234/1632128399/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 53, "sk