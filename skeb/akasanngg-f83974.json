=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8eb466d754b4e359af268a70469938f3 3x"}, "body": "こんにちは！あなたのキュートで大胆なイラストが本当に大好きです！\n\nもしよろしければ、「アレイダ・フィー」のイラストをお願いしたいです！\n\nフィーちゃんは、たまにドヤ顔をするキュートな風貌の不死鳥です。\nかなりの鳥バカですが、頑張っています。\n趣味は歌とお菓子作り。\n\nできれば設定はお任せしたい。フィーの衣装は2種類あるので、設定に合うほうを自由に選んでください。\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1MZWpmMTgeFUQX-YcfjqyertffnIu27l0?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akasanngg/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 577901, "client_id": 68057, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ff80d9e/uploads/origins/8698e086-9b57-4e36-a254-e767f15bcd6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a24692dbef6dd5f8e02b08ff0d6d3f54", "srcset": "https://si.imgix.net/5ff80d9e/uploads/origins/8698e086-9b57-4e36-a254-e767f15bcd6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a24692dbef6dd5f8e02b08ff0d6d3f54, https://si.imgix.net/5ff80d9e/uploads/origins/8698e086-9b57-4e36-a254-e767f15bcd6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a3ef9dd318b2be17059f7a4b245051c 2x, https://si.imgix.net/5ff80d9e/uploads/origins/8698e086-9b57-4e36-a254-e767f15bcd6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a6e5dc3dbd57c25171ba2b3245f53de 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ff80d9e/uploads/origins/8698e086-9b57-4e36-a254-e767f15bcd6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e9782226bde10d8ff9c862d8a923a05", "srcset": "https://si.imgix.net/5ff80d9e/uploads/origins/8698e086-9b57-4e36-a254-e767f15bcd6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e97