しじみさんの色使いに憧れて、今回は少ない色数で描こうと思いベースが青で黄色い光源で光を当てましたが色味が綺麗なのかもわかりません！より良く見栄えするポイントがあったら教えて頂きたいです！ その他にも、テーマは「ペンギン湯めぐり紀行」で、ペンギン達がお風呂に遊びに来るという設定なのですが、可愛いからアヒルを描いたはいいもののアヒルとペンギンの関連性が弱いなと思い、見ている人は「何コレ……？」状態になってしまうのではないかと思いました。ここから何かイラストに納得感があったり面白くなる案などがあれば教えて頂きたく思います。 ドライブの資料にあがっている①～③の順番に変更を加えていったのですが良くなっているかどうかも教えて頂きたいです！その他気になる点がございましたらご指摘お願いします！ よろしくお願いします🙇‍♀️\n\nhttps://drive.google.com/drive/folders/19RGQ71TTmjzWBR3DcOnPG4CQFsjX3Kj7", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 380145, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "こめじるし", "screen_name": "komejirushi_com", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fb501496e-d2d6-4fca-a9e8-cfe1cd0151c5.png?avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "none", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 1209578, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "うる。", "screen_name": "MirukuLamune", "avatar_url": "https://pbs.twimg.com/profile_images/1967270921343004672/A1Rh-mda.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1692285890/1740177564/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 128}, {"id": 1688710, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "KiiKo @アニメ原画風skeb", "screen_name": "Kiiko_clip", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fd4b360a8-1