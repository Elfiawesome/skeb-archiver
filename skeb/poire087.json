bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f495990687974f08b177b76576359cf", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3397479, "client_id": 1539728, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@poire087/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3397479, "client_id": 840738, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/682793e1/uploads/origins/1193d618-8cf6-4746-9167-b3686df2f453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=188c2a15d8c190c56b163832422fa903", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/682793e1/uploads/origins/1193d618-8cf6-4746-9167-b3686df2f453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de8f5b2f883d36b2f6c926db54a7e1a0", "src_set": ""}, "body": "優梨花様\n\n初めまして、個人Vtuberの白河ノさくらと申します。\nSkebでたまたまイラストをお見かけし、構図やお顔や透明感ある塗りのイラストがとても素敵でしたので、わたしもご依頼させていただきたく思います…！\nぜひわたしの姿を描いていただきたいです！\n\n◎構図：優梨花様のイメージでおまかせしたいです。（サムネイル等に使用したいので、あまり見切れていないと助かります。）\n◎衣装：実装している衣装（神巫女衣装、制服衣装、袴衣装）のいずれかでお願いします。\n◎形式：背景等が透過可能なレイヤー分けPSDファイル等\n◎用途：今後の活動（主に収益化済Youtubeチャンネルのサムネイルやツイート、グッズ、動画…等）に使用したいです！※禁止の用途等あれば、別レイヤーに記載していただけると助かります。\n\n☆私の姿詳細\n・ゆるーりはんなりまったりな九尾でかみさまで、名を白河ノさくらと申します。\n・髪色：白に近い、薄い桜色です。（毛先には少し赤みがあります。）\n・髪①：髪型はいくつかあるのでお任せします。（資料参照）\n・髪②：髪に桜の花がいくつか付いています。\n・顔①：右目（黄金色の瞳）の斜め下に泣きぼくろがあります。\n・顔②：左目（紅色の瞳）に被さるように赤い紋様が入っています。\n・顔③：両目尻に紅（舞妓さんとかがよくやってるやつ）があります。\n・顔④：上まつ毛は白めです。\n・口元：にゃんこ口ω\n・体格：「グラブル」のナルメアのようなイメージです。\n・装飾：尻尾も描いていただきたいです！（可能であれば尻尾はレイヤー分けして非表示可だと大変助かります…！）\n・雰囲気：今回表情指定は特にありませんが、ぽやっとした表情をしていることが多いです。もし可能でしたら表情差分などがあるととても嬉しいです！\n・性格：落ち着いていてまったり、飄々としています。\n\n※参考Twitter：https://twitter.com/sacura0\n※参考Youtubeチャンネル：https://www.youtube.com/c/sacura0610\n\n不明瞭でしたらすみません。\n可能でしたら、どうぞよろしくお願いいたします…！\n\n白河ノさくら🌸\n\nhttps://drive.google.com/drive/u/2/folders/15PD00ThrE4qlBywngk7HW7og8Je7LSgM", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@poire087/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3397479, "client_id": 1385946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42d33251/uploads/origins/d39c65fd-2743-407e-b5bb-b5dbb0c5339d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b4228569ff76d6b1d0601075a226278", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42d33251/uploads/origins/d39c65fd-2743-407e-b5bb-b5dbb0c5339d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e4a670b793f984a687e06d190ea83d1", "src_set": ""}, "body": "優梨花様の描かれたあまねももちゃんのイラストがとっても可愛かったのでリクエスト送らせて頂きます！！💞✨️\n \n当方のVtuberキャラクター猫熊るるを描いていただきたいです。\n\n文章化が下手くそな為、\n 箇条書きで失礼致します。\n・資料先にVtuberの衣装がありますが、\n白ワンピースに向日葵で、夏っぽい清楚な感じにして頂きたいです！\n・構図とポーズのダイナミックさがすごく素敵だったので、その雰囲気でかいていただきたいです！\n・背景も頂ける場合は人物のみの透過版もお願いします\n\n使用用途: YouTubeのサムネ Twitter投稿  \nYouTubeの配信内で企画配信 FANBOXにて壁紙として配布、グッズ化等活動全般における使用\n\nhttps://x.com/nekokumaruru/status/1872903224581374431", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@poire087/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3397479, "client_id": 999841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1205c7c/uploads/origins/565f111b-2e88-4bcc-a05f-20bf78d41e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=20