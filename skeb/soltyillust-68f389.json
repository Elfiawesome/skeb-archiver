_urls": {"src": "https://si.imgix.net/8f8b253d/uploads/origins/261870b1-ad5f-4183-b11f-49bc5f1de07c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3903d398ac1118d1863f6f4cd38f288c", "srcset": "https://si.imgix.net/8f8b253d/uploads/origins/261870b1-ad5f-4183-b11f-49bc5f1de07c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3903d398ac1118d1863f6f4cd38f288c, https://si.imgix.net/8f8b253d/uploads/origins/261870b1-ad5f-4183-b11f-49bc5f1de07c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5764ae645d9c7f092894f348e0ad0908 2x, https://si.imgix.net/8f8b253d/uploads/origins/261870b1-ad5f-4183-b11f-49bc5f1de07c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=564a432ee385a15bd3c3521e155583d6 3x"}, "body": "こんにちは。\n私がフォローしているVTuberのファンアートを依頼したいのですが：\n名前：ピッピー\n\nピッピーが巨乳になっているというジョークなリクエストを希望します。\n「おっぱいロリ」というステレオタイプなキャラにしてください。\n服装はそのままにして、胸の谷間を大胆に露出させてください。  \n例：『BLEACH』の蘭菊\n\n\n種族：人間\n年齢：20歳以上\n服装：和風\nモデル身長：4フィート11インチ\nVTuberの設定上の拠点：日本の神社、特にキツネをテーマにした場所\n\n\n\nイラストの主な用途：配信、ファンアートの展示、SNS\n\nhttps://drive.google.com/drive/folders/1eW7iQB1YKnjvNQsVssE2eA2TkrAyIZdR?usp=sharing", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@soltyillust/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3334903, "client_id": 1318798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31fd9ca0/uploads/origins/8164c247-1a8a-4b33-bf13-e3837dc564f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89d36d4247681d22b67bd3ac4abe9042", "srcset": "https://si.imgix.net/31fd9ca0/uploads/origins/8164c247-1a8a-4b33-bf13-e3837dc564f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89d36d4247681d22b67bd3ac4abe9042, https://si.imgix.net/31fd9ca0/uploads/origins/8164c247-1a8a-4b33-bf13-e