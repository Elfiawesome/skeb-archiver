。\nReference:https://images.puella-magi.net/9/9a/Isabeau_%2819_yo%29.png?20220318163511\nルイーズについては、舞踏会用のドレスをお好きなようにデザインしてください。ルイーズは謙虚で飄々としたメイドですが、主人であるイザボーをとても愛しています。ルイーズの衣装は、スライバーかグリーンのどちらかがいいと思います。\nご検討よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PAYUFUGO/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2029748, "client_id": 1533975, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aff9d67c/uploads/origins/d803b8b0-590a-41f7-bf72-30d0f43b7b8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9fd6c21a80921239a6a02a9e1b31b71", "srcset": "https://si.imgix.net/aff9d67c/uploads/origins/d803b8b0-590a-41f7-bf72-30d0f43b7b8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9fd6c21a80921239a6a02a9e1b31b71, https://si.imgix.net/aff9d67c/uploads/origins/d803b8b0-590a-41f7-bf72-30d0f43b7b8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6bfbc968b2de5c44564c9fd4b21f603d 2x, https://si.imgix.net/aff9d67c/uploads/origins/d803b8b0-590a-41f7-bf72-30d0f43b7b8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70c693dab4592326c6bd8c8be8bc6d74 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aff9d67c/uploads/origins/d803b8b0-590a-41f7-bf72-30d0f43b7b8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b55e72bf6ca277f2841689151c8403e", "srcset": "https://si.imgix.net/aff9d67c/uploads/origins/d803b8b0-590a-41f7-bf72-30d0f43b7b8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b55e72bf6ca277f2841689151c8403e, https://si.imgix.net/aff9d67c/uploads/origins/d803b8b0-590a-41f7-bf72-30d0f43b7b8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ffb2f2ad