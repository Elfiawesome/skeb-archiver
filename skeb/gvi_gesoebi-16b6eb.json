世界の自分たちの記憶から構築された偽りの現実のポケットの中に閉じ込められています。 奇妙なデジタルの相棒の助けを借りて、彼女は正気を保ちながら、この永遠の時間を何とか乗り切ろうと奮闘しています。\n具体的な指示がなくても大丈夫です。お好きなように描いてください。ご検討いただきありがとうございます～！\n\nhttps://out-of-memory-jp.carrd.co/#the-scholar", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gvi_gesoebi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3935372, "client_id": 3544704, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d28fc05/uploads/origins/c9b39f90-0b63-4f33-b3ce-14b132826cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63d52c6929456261b35bc8ffc1aa5a3a", "srcset": "https://si.imgix.net/8d28fc05/uploads/origins/c9b39f90-0b63-4f33-b3ce-14b132826cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63d52c6929456261b35bc8ffc1aa5a3a, https://si.imgix.net/8d28fc05/uploads/origins/c9b39f90-0b63-4f33-b3ce-14b132826cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88f699ab7bb43270fbb743e303919b03 2x, https://si.imgix.net/8d28fc05/uploads/origins/c9b39f90-0b63-4f33-b3ce-14b132826cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71bec216af3f1194c3d3bd63aecc2ea9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d28fc05/uploads/origins/c9b39f90-0b63-4f33-b3ce-14b132826cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e845f185861988e7bad2228c8b8cdaee", "srcset": "https://si.imgix.net/8d28fc05/uploads/origins/c9b39f90-0b63-4f33-b3ce-14b132826cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e845f185861988e7bad2228c8b8cdaee, https://si.imgix.net/8d28fc05/uploads/origins/c9b39f90-0b63-4f33-b3ce-14b132826cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c78eee8dccb0f0e38ab2c