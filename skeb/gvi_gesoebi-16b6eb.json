3288/photo/1\nhttps://x.com/gvi_gesoebi/status/1996600222202638572/photo/1\n\n可能であれば、別レイヤーにサインを入れたpsdファイルをご提供ください。また、先生が下書きや未使用のrkgkなどを作品に残しておいてくださると、アイデアの変遷を見ることができるのでありがたいです！\n\nご依頼をお読みいただき、ご検討くださり誠にありがとうございます！お気に召さない場合は、遠慮なく直接キャンセルしてください。\n\nhttps://drive.google.com/drive/folders/1G2yldDUusWRmjXtyBZvMCJr11FJAh5xc?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gvi_gesoebi/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/610786ab/uploads/origins/3b5c43dd-c923-4bfa-a9c2-19558ab249c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=523aa7049a4808ff3b3e752f2714d2d7", "srcset": "https://si.imgix.net/610786ab/uploads/origins/3b5c43dd-c923-4bfa-a9c2-19558ab249c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=523aa7049a4808ff3b3e752f2714d2d7, https://si.imgix.net/610786ab/uploads/origins/3b5c43dd-c923-4bfa-a9c2-19558ab249c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3db55a0d4982fd0f263f51fc9cfad06f 2x, https://si.imgix.net/610786ab/uploads/origins/3b5c43dd-c923-4bfa-a9c2-19558ab249c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1c776eafc1dbb31a8c720ad987fbd8c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3935372, "nc": 145}, {"path": "/@gvi_gesoebi/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3935372, "client_id": 1326334, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fde7e654/uploa