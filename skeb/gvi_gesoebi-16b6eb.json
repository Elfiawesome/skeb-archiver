8c061638-8092-42ca-bfca-e917e007efd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad5ee0b8c7ffab4b883a5ddf825d8065", "srcset": "https://si.imgix.net/5c880774/uploads/origins/8c061638-8092-42ca-bfca-e917e007efd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad5ee0b8c7ffab4b883a5ddf825d8065, https://si.imgix.net/5c880774/uploads/origins/8c061638-8092-42ca-bfca-e917e007efd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cef83df349b3e102a954553b937abd3b 2x, https://si.imgix.net/5c880774/uploads/origins/8c061638-8092-42ca-bfca-e917e007efd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08a7c1f6a546b65cec4c6816e83fda5a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c880774/uploads/origins/8c061638-8092-42ca-bfca-e917e007efd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d995247c0d8fa2dab915350776872a74", "srcset": "https://si.imgix.net/5c880774/uploads/origins/8c061638-8092-42ca-bfca-e917e007efd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d995247c0d8fa2dab915350776872a74, https://si.imgix.net/5c880774/uploads/origins/8c061638-8092-42ca-bfca-e917e007efd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b66fb3840614eb03701d560f71031387 2x, https://si.imgix.net/5c880774/uploads/origins/8c061638-8092-42ca-bfca-e917e007efd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=069e1ee04a1ef8935786a8cd9c3b68e3 3x"}, "body": "GVI様\n初めまして。\nGVI様の格好いいカートゥーン調の絵柄に惹かれてリクエストさせていただきました。\nこの度は自身のOCのイラストをお願いしたいです。\nGVI様のご自由な発想で描いていただけると嬉しいです。\n\n【OC】\n・20歳前後の青年の姿をした人外。\n・赤髪。緑目。黒いコート。\n・ゆるいSF、もしくは近未来的な世界観の研究所所属。助手兼被検体。\n・機材の扱いが雑。人間以外への態度が悪い等がさつな面がある。\n\nhttps://drive.google.com/drive/folders/1-JGQRe8tLg25S_kAvx5_oCFppX7SIbrd?usp=drive_link\n\nデザインの詳細や分かり辛い箇所は、ご自由に省略・アレンジして頂けますと幸いです。\n構図等もお任せ致します。\n\n何卒、ご検討の程よろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gvi_gesoebi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3935372, "client_id": 3978579, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41026873/uploads/origins/ba41b12d-3e15-4e77-a7d5-d5847894d689?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=756b59670e00df6f2681b9fe1c0d84ff", "srcset": "https://si.imgix.net/41026873/uploads/origins/ba41b12d-3e15-4e77-a7d5-d5847894d689?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=756b59670e00df6f2681b9fe1c0d84ff, https://si.imgix.net/41026873/uploads/origins/ba41b12d-3e15-4e77-a7d5-d5847894d689?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a630e8912ed1cf8d5b37cc7d819f4f84 2x, https://si.imgix.net/41026873/uploads/origins/ba41b12d-3e15-4e77-a7d5-d5847894d689?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e94bb01e14ca5b69c3dabd8993c5a1a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41026873/uploads/origins/ba41b12d-3e15-4e77-a7d5-d5847894d689?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b70ec46a97c1998877d34c9e6577781", "srcset": "https://si.imgix.net/41026873/uploads/origins/ba41b12d-3e15-4e77-a7d5-d5847894d689?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b70ec46a97c1998877d34c9e6577781, https://si.imgix.net/41026873/uploads/origins/ba41b12d-3e15-4e77-a7d5-d5847894d689?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2eb221f2f73e553a7c1907ba2c98c0b9 2x, https://si.imgix.net/41026873/uploads/origins/ba41b12d-3e15-4e77-a7d5-d5847894d689?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=60e02b47a4ed475c21cb8d24c67f1fd8 3x"}, "body": "GVIさん、こんにちは！\n私と友人のキャラクターを描いていただけないでしょうか？^_^\n\n[納棺師] https://drive.google.com/drive/folders/1ESaK8Wj_qHdajdrI2eFr_lOALzVqfGpS?usp=sharing\n\nジェイド（黒髪）\n- 死体を扱うのは気が進まないが、お金のためならやる気が出る\n- 無鉄砲な性格で、トラブルメーカー\n- 物言いがストレートで、人に正面から立ち向かうタイプ\n- ミラクルの奇妙な行動にしばしば戸惑う\n\nミラクル（ピンク髪）\n- 人間になりすましたモンスターなので、社会性が皆無\n- 感情の深みがなく、笑顔はたいてい空虚に感じられる\n- 非常に几帳面で、物事をじっくりと進めるのが好き\n- ジェイドと友達になりたいと思っている。まるで初めて友達を作る恥ずかしがり屋の子供のようだ\n\n二人はまだお互いをよく知らないが、徐々に信頼し合うようになっていく\n\nどのデザインでも構いませんので、描いていただけたら嬉しいです。二人が協力し合うようなシナリオも素敵ですね。読んでいただき、ご検討いただきありがとうございます ❤️", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gvi_gesoebi/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7804d909/uploads/origins/38204ccf-9b3e-415d-b7c0-e8604e4fc096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46e37ea9bd82f6ca39c18bd67f442966", "srcset": "https://si.imgix.net/7804d909/uploads/origins/38204ccf-9b3e-415d-b7c0-e8604e4fc096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46e37ea9bd82f6ca39c18bd67f442966, https://si.imgix.net/7804d909/uploads/origins/38204ccf-9b3e-415d-b7c0-e8604e4fc096?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69dad0d9941ae312c2208e5005e462f0 2x, https://si.imgix.net/7804d909/uploads/origins/38204ccf-9b3e-415d-b7c0-e8604e4fc096?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=390f3d43b3f9179242141f7e093851d5 3x"}, "private": true, "genre": "art", "tipped": fa