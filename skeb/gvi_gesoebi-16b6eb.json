reasure hunter, hot air balloonist, and cool phantom thief, as well! You can give her other cool outfits besides her basic outfit if you wish! She is around 30 years old! Have fun!\n\nHer sunglasses are more the style of red Lara Croft Sunglasses, which I included for reference!\n\nhttps://drive.google.com/drive/folders/1QQdFRWzSyLWQbwuOKCL3a1TUXDtp9Czc?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gvi_gesoebi/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3935372, "client_id": 97983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b02fc85/uploads/origins/2cb87f84-3298-4fe3-8ee9-9fdc8f0a7029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e562ed5786258b4e3c0c62cd49075ae9", "srcset": "https://si.imgix.net/0b02fc85/uploads/origins/2cb87f84-3298-4fe3-8ee9-9fdc8f0a7029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e562ed5786258b4e3c0c62cd49075ae9, https://si.imgix.net/0b02fc85/uploads/origins/2cb87f84-3298-4fe3-8ee9-9fdc8f0a7029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3493771838b2f2c69a392b5311e9885f 2x, https://si.imgix.net/0b02fc85/uploads/origins/2cb87f84-3298-4fe3-8ee9-9fdc8f0a7029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d76f964a91a487b13e4fa33ca1b3e5b9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b02fc85/uploads/origins/2cb87f84-3298-4fe3-8ee9-9fdc8f0a7029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=011b464894bfdf94ceab9f24ab87a6e4", "srcset": "https://si.imgix.net/0b02fc85/uploads/origins/2cb87f84-3298-4fe3-8ee9-9fdc8f0a7029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=011b464894bfdf94ceab9f24ab87a6e4, https://si.imgix.net/0b02fc