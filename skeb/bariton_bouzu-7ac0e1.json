ctory-international.fandom.com/wiki/Privaty", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bariton_bouzu/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3691394, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06935f06/uploads/origins/f71f3739-ecc9-4fcc-afcf-99d7202cc9b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=812ad7cac2b64bf0a67568f78e6ab330", "srcset": "https://si.imgix.net/06935f06/uploads/origins/f71f3739-ecc9-4fcc-afcf-99d7202cc9b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=812ad7cac2b64bf0a67568f78e6ab330, https://si.imgix.net/06935f06/uploads/origins/f71f3739-ecc9-4fcc-afcf-99d7202cc9b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58191acbf3f23602ef410fa11eb00a89 2x, https://si.imgix.net/06935f06/uploads/origins/f71f3739-ecc9-4fcc-afcf-99d7202cc9b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7dbe3ab7232257ea5a3f076ab72e8ad 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06935f06/uploads/origins/f71f3739-ecc9-4fcc-afcf-99d7202cc9b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ede36bf462c3f961abac6411a14669f1", "srcset": "https://si.imgix.net/06935f06/uploads/origins/f71f3739-ecc9-4fcc-afcf-99d7202cc9b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ede36bf462c3f961abac6411a14669f1, https://si.imgix.net/06935f06/uploads/origins/f71f3739-ecc9-4fcc-afcf-99d7202cc9b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=17191e06698baab911c7f8150e0bbf45 2x, https://si.imgix.net/06935f06/uploads/origins/f71f3739-ecc9-4fcc-afcf-99d7202cc9b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ca9e5fa5ed0167e1c3111492e2d05c3b 3x"}, "body": "いつも素敵なイラスト、ありがとうございます！イラストをお願いできないでしょうか。\n\n穴役：まりな（タコピーの原罪）（きゅう歳）\n竿役：巨根ロリコンレイプ魔\nサポート役：しずか\n\nシチュ：\n\n男は初潮を迎えたばかりのまりなを孕ませレイプしてる。亀頭を危険日子宮にぶち込めて、絶っ対に赤ちゃん作るように連続中出ししてる。体勢はおまかせしたいと思います！出来れば、まりなの生足が見えるようにお願いします（足フェチ）！\n\n妊娠への恐怖に満ちた顔で泣き叫んでる娘の悲鳴は男にとって、最高のASMRになっている。\n　\nしずかは逃げられないようにまりなの腕を掴でいる。まりなが絶っ対シングルマザーにして人生終わらせる、完全無責任中出しを何度も促すように男を興奮させるセリフを囁いてる。\n\nhttps://bariton.fanbox.cc/posts/10368690のような孕ませフェチを煽る生々しいセリフをお願いします（こだわり）！二桁にもなってないまりなの年齢も連呼して興奮させる。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bariton_bouzu/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3691394, "client_id": 3333222, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b4172a1/uploads/origins/e304502a-a4a2-4239-9e1c-a93abc37ec15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07329fb7d406d9718ced769c3843bc15", "srcset": "https://si.imgix.net/7b4172a1/uploads/origins/e304502a-a4a2-4239-9e1c-a93abc37ec15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07329fb7d406d9718ced769c3843bc15, https://si.imgix.net/7b4172a1/uploads/origins/e304502a-a4a2-4239-9e1c-a93abc37ec15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=949fc9695071a4be1811b9136f9bd585 2x, https://si.imgix.net/7b4172a1/uploads/origins/e304502a-a4a2-4239-9e1c-a93abc37ec15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fbc15b89f0e343e6b512ee32c83b48f2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b4172a1/uploads/origins/e304502a-a4a2-4239-9e1c-a93abc37ec15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b2503031d5482033aa0c2dfe90f1a99", "srcset": "https://si.imgix.net/7b4172a1/uploads/origins/e304502a-a4a2-4239-9e1c-a93abc37ec15