s://drive.google.com/file/d/1z98cURctAJxMP3nauXbjZjUQkpN37GOo/view?usp=sharing】\n・【https://drive.google.com/file/d/1XfT0NroPhC-Zujh0BULr5IvNDjCzV7D5/view?usp=sharing】\n\nこれらのようにツインテールをおっっっきくふわふわにしてもらえたらすごく嬉しいです\n\n●【表情】：キャラクターの性格に合う明るい表情\n明るく元気で天真爛漫な性格です\n\n●【シチュエーション】\n衣装以外指定無し全おまかせになります\nですが胸の大きさがはっきりとわかるポーズだと嬉しいです\n衣装は冬服（長袖カーディガン）でお願いします※2-2,5-2参照\n\n背景とキャラ、サインを別レイヤーにしてpsdで納品してほしいです\nよろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/1rix2NTNjH4LrAkJc15-o6opnCwPP9SS2?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@halo_maru/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3544228, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e5302c93/uploads/origins/ff963382-aa06-4973-8d70-cab678c0e00d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa7de043c34b46c32c1f579d6bad8bd5", "srcset": "https://si.imgix.net/e5302c93/uploads/origins/ff963382-aa06-4973-8d70-cab678c0e00d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa7de043c34b46c32c1f579d6bad8bd5, https://si.imgix.net/e5302c93/uploads/origins/ff963382-aa06-4973-8d70-cab678c0e00d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3470cdace28a10aa52f7efa55eb10130 2x, https://si.imgix.net/e5302c93/uploads/origins/ff963382-aa06-4973-8d70-cab678c0e00d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5569b3ac12618f6ab4ca87671934aa6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e5302c93/uploads/origins/ff963382-aa06-4973-8d70-cab678c0e00d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=754ef49f4f503620901a2c14555b7f99", "srcset": "https://si.imgix.net/e5302c93/uploads/origins/ff963382-aa06-4973-8d70-cab678c0e00d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit