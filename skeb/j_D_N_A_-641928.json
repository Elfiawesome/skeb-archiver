&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f2bd05e8d5973400c2661b2d2ee31d8", "srcset": "https://si.imgix.net/263e5954/uploads/origins/6ef0866e-39a1-4121-9ab8-5883c2aff342?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f2bd05e8d5973400c2661b2d2ee31d8, https://si.imgix.net/263e5954/uploads/origins/6ef0866e-39a1-4121-9ab8-5883c2aff342?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=febbe712afe6dc10aa857280eabc0171 2x, https://si.imgix.net/263e5954/uploads/origins/6ef0866e-39a1-4121-9ab8-5883c2aff342?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cf5fa5756717f0e9fea550d91bda90c8 3x"}, "body": "初めまして、獣人遺伝子研究所さんのイラストや漫画を拝見し、\n拙宅のオリキャラの精液採取コミックをリクエストしたいと思い\nメッセージを送らせて頂きました。\n\n被験者としたいのは資料URL先の獣竜男の子、深大勇でして、\n他の精液採取コミックのように声をかけられてからの\n精液採取シーンと言う風に描いて頂ければ幸いです。\n\n追加資料（人ちんです）\nhttps://www.pixiv.net/artworks/98610826\nhttps://www.pixiv.net/artworks/98610927\nhttps://www.pixiv.net/artworks/132972820\n※足に関しては描きづらい等ありましたら普通の人型足で描写して大丈夫です。\n※細部は研究所さんの手癖でアレンジして頂いて構いません。\n※細かい構図等もお任せ致します。\n\nご検討の程よろしくお願いします。\n\nhttps://www.pixiv.net/artworks/129084918", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@j_D_N_A_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3610227, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1da6c0a6/uploads/origins/8dbf3ba1-a458-4fe2-be27-57ea57acbffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92d3f8083eaca47bee54810d8acb7bab", "srcset": "https://si.imgix.net/1da6c0a6/uploads/origins/8dbf3ba1-a458-4fe2-be27-57ea57acbffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92d3f8083eaca47bee54810d8acb7bab, https://si.imgix.net/1da6c0a6/uploads/origins/8dbf3ba1-a458-4fe2-be27-57ea57acbffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10b17e1b2124be9a9340bbd868d4ab45 2x, https://si.imgix.net/1da6c0a6/uploads/origins/8dbf3ba1-a458-4fe2-be27-57ea57acbffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf91a6604455e05e2472f0e167ed28d7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1da6c0a6/uploads/origins/8dbf3ba1-a458-4fe2-be27-57ea57acbffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b4afab24bc34fcbb5abb8c87ff270ed", "srcset": "https://si.imgix.net/1da6c0a6/uploads/origins/8dbf3ba1-a458-4fe2-be27-57ea57acbffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b4afab24bc34fcbb5abb8c87ff270ed, https://si.imgix.net/1da6c0a6/uploads/origins/8dbf3ba1-a458-4fe2-be27-57ea57acbffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c17b1ea26c9b6652bac471275acf894f 2x, https://si.imgix.net/1da6c0a6/uploads/origins/8dbf3ba1-a458-4fe2-be27-57ea57acbffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1256de85c7dd411f8490f22308ee456a 3x"}, "body": "【筋肉マッチョ狼くん×可愛い狐ちゃん　が子孫を残すために必死にエッチ→受精までのイラスト集】\n\nこんにちは！いつもエッチなイラスト拝見しています。オリキャラのオスケモとメスケモが必死になって遺伝子を残すための交尾→受精までの過程イラスト集をお願いしたいです。\n\n作品テーマ：狼くんと狐ちゃんの大受精実験ッ！！（興奮した狼と狐の遺伝子を合体させちゃおッ♡）\n\nキャラデザ、参考イラスト、イラスト集の雰囲気や形式はURLを張りますのでそちらを参考にお願いします。\n\n【入れてほしいシチュエーションや雰囲気】\n\n設定：発情しているマッチョ狼獣人と妊娠可能なキツネ獣人を交尾部屋に閉じ込めて２匹の激しい交配を観察し、オオカミ×キツネの立派なハイブリット子孫を生み出す実験\n\n・合体前に「これからこいつを犯すのか・・・」と興奮＆フル勃起したオスケモ（先走り汁も凄い）とマン汁タラタラのメスケモが向かい合って興奮しながら互いの裸を見つめ合う\n\n・交配開始：正常位、後背位、立位での激しい交尾（それ以外の体位を加えて頂いても大丈夫です）\n\n・中出しの瞬間イラストは後背位でオスケモがメスケモに力強く抱きしめながら、体をこれでもかと密着させ、ペニスを奥まで挿入し、受精を意識してドクドク精子を発射している。\n\n・ドロッドロの雄臭い濃厚精液を膣内＆子宮に流し込む断面図\n\n・狼君の精子と狐ちゃんの卵子の大受精描写\n\n・どのコマも二人の顔が見える構図でお願いします。\n\n・特に狼くんの表情は必死に涎を垂らしながら歯を食いしばり、目を細めたり、思いっきり瞑ったりしながら「子孫繁栄ッ！孕めッ！孕めッ！」と完全に本能に任せて必死に交尾している雰囲気でお願いします。\n\n・狐ちゃんは途中から妊娠してしまうことを不安に感じながら「え！私ホントにニンシンしちゃうの！？」と焦りが見える雰囲気でお願いします。\n\n・最後はカメラに向かって狐ちゃんがドロッドロの精子で溢れるマンコを見せつけながらピースサイン、狼くんも「種付け完了だぜッ！」と自慢げにピースしている様子。\n\n・SEや台詞、ナレーションの細かい内容はお任せいたします。\n\n・エッチな雰囲気で二匹の受精をお願い致します。\n\nhttps://drive.google.com/drive/folders/1tvoVETgzYkzp3sMaaiQAxoiwcuNoyogw?usp=sharing", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@j_D_N_A_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3610227, "client_id": 1855132, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26059d04/uploads/origins/284ca53e-b2bb-483e-8017-ea529ea22859?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12d1d63b75c671f07e4213262d2f7cac", "srcset": "https://si.imgix.net/26059d04/uploads/origins/284ca53e-b2bb-483e-8017-ea529ea22859?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12d1d63b75c671f07e4213262d2f7cac, https://si.imgix.net/26059d04/uploads/origins/284ca53e-b2bb-483e-8017-ea529ea22859?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61baad770a9293c37acdab9bd3b99707 2x, https://si.imgix.net/26059d04/uploads/origins/284ca53e-b2bb-483e-8017-ea529ea22859?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=187e9af2067bfa50ea6df0c4af0a5a34 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26059d04/uploads/origins/284ca53e-b2bb-483e-8017-ea529ea22859?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d41866f076e9ddd8fe47b1d0dad09be", "srcset": "https://si.imgix.net/26059d04/uploads/origins/284ca53e-b2bb-483e-8017-ea529ea22859?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d41866f076e9ddd8fe47b1d0dad09be, https://si.imgix.net/26059d04/uploads/origins/284ca53e-b2bb-483e-8017-ea529ea22859?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&