-4106-ac56-e286de20f1d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8043b814bb7521bbf434e540cddbf34e", "srcset": "https://si.imgix.net/ad2503e2/uploads/origins/92152c47-911e-4106-ac56-e286de20f1d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8043b814bb7521bbf434e540cddbf34e, https://si.imgix.net/ad2503e2/uploads/origins/92152c47-911e-4106-ac56-e286de20f1d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d901b255f841a0bc5495653e60d8d046 2x, https://si.imgix.net/ad2503e2/uploads/origins/92152c47-911e-4106-ac56-e286de20f1d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bd1aa44c5872a4e16efcd3c91e7520b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad2503e2/uploads/origins/92152c47-911e-4106-ac56-e286de20f1d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aaa18a1f66efcdd821d10e63b44f8953", "srcset": "https://si.imgix.net/ad2503e2/uploads/origins/92152c47-911e-4106-ac56-e286de20f1d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aaa18a1f66efcdd821d10e63b44f8953, https://si.imgix.net/ad2503e2/uploads/origins/92152c47-911e-4106-ac56-e286de20f1d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac110b28804d6410ae8d66c9c02f3908 2x, https://si.imgix.net/ad2503e2/uploads/origins/92152c47-911e-4106-ac56-e286de20f1d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c8a3695f58123df4b641d4c6e53b3b23 3x"}, "body": "初めまして。懐谷と申します。\nTLでお見かけしたイラストの雰囲気がとても好きで、ぜひ一度ご依頼させていただきたいと思いリクエストをお送りいたしました。一枚絵をお願いしたいです！\n\n構図などはお任せできればと思っているのですが、可能でしたら、拝見したイラスト(THE EMPRESS という言葉がかいてあったもの)のような空気感に近い形で描いていただけるととても嬉しいです……！\n\n以下、キャラクターの詳細(CoCネタバレなし)になります。\n\n名前：朧 ザフラ(おぼろ ざふら)\n出身シナリオ：拝啓、贖イ郵便局の皆様へ HO1\n年齢：30歳\nモチーフ：四神の蒼龍、朧花、朧月 等\n特徴：176cmの長身で非常に細身。肩幅も狭めではある。普段はスーツ姿で露出は少なく、怪我が多いため身体には包帯を巻いている。中性的で整った顔立ちだが、常にへらへらしており胡散臭い印象を与えがち。長髪。\n\n性格：飄々としていて掴みどころがなく、常にどこか余裕のある笑みを浮かべている男。気分屋でイタズラ好き、やや意地の悪い冗談やからかいを好み、人の反応を見ることを楽しんでいる節がある。好奇心旺盛で人との距離の詰め方も遠慮がなく、初対面でも軽口を叩きながら自然と懐に入り込む。その振る舞いから胡散臭い人物として見られることも多いが、本人はあまり気にしていない。\n\nモチーフに関してはいちきろ様のセンスに全体的にお任せしますので、使っても使わなくても構いません💦参考程度に……！\n\n添付ファイルに立ち絵・太刀差分・鎌差分・私服(スーツ)差分・NPC(鳴上蒼葉)と並んでいるイラストが入っています。ご参照いただけますと幸いです🙇‍♂️🙇‍♂️🙇‍♂️\n\nhttps://www.dropbox.com/scl/fo/rmo4wpyg1wlktm6ienmm3/AN0JqfIPgMA1-6kleLv0o3k?rlkey=uzy6bd3fcw6n2yart84esysaa&st=ph3qrvjw&dl=0", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1149102, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "すあしば", "screen_name": "sasiba_00", "avatar_url": "https://pbs.twimg.com/profile_images/1255114952924250112/K6waruKz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/995328239869427712/1552315672/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 144}, {"id": 1744075, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "obscure", "screen_name": "SENA_reco", "avatar_url": "https://pbs.twimg.com/profile_images/1865322084957859840/vLUTV4LT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1476576823459090433/1666111982/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 2844536, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "極悪肉", "screen_name": "gokuaku029", "avatar_url": "