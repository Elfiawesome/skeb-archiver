-\n＜その他＞\n\n★使用用途\n・個人で活動する上でSNSやyoutubeでのサムネ・アイコン・ヘッダーなどで使用致します。\n\n★データについては、背景とキャラレイヤー・サインを分けてご準備頂けますと幸いです。\n\nそれではご検討のほどよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wacami_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3384743, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bbba0d4/uploads/origins/3f0214c4-3abb-4033-98b5-fd8dbbb933e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8deb7dd9567790bb7e1c67004dce28e", "srcset": "https://si.imgix.net/3bbba0d4/uploads/origins/3f0214c4-3abb-4033-98b5-fd8dbbb933e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8deb7dd9567790bb7e1c67004dce28e, https://si.imgix.net/3bbba0d4/uploads/origins/3f0214c4-3abb-4033-98b5-fd8dbbb933e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d7375d98c1735dc48119ea63139f005 2x, https://si.imgix.net/3bbba0d4/uploads/origins/3f0214c4-3abb-4033-98b5-fd8dbbb933e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88b553cb161b1f192d4cabd38c8e81ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bbba0d4/uploads/origins/3f0214c4-3abb-4033-98b5-fd8dbbb933e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8f8ef848f24c997c5d70c7c8402e979", "srcset": "https://si.imgix.net/3bbba0d4/uploads/origins/3f0214c4-3abb-4033-98b5-fd8dbbb933e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8f8ef848f24c997c5d70c7c8402e979, https://si.imgix.net/3bbba0d4/uploads/origins/3f0214c4-3abb-4033-98b5-fd8dbbb933e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=befea6074fc14df0233e3c17b88db7c1 2x, https://si.imgix.net/3bbba0d4/uploads/origins/3f0214c4-3abb-4033-98b5-fd8