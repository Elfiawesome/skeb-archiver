スorネックレスとして付けている。また、左薬指には揃いの銀の指輪が付いている。\n┈┈┈┈┈┈┈┈┈┈\n\n見た目に関しては、リンク先に資料を貼っておりますのでご参照ください。\nシチュエーションや服装等はご自由に改変・解釈してくださって構いません！\n\nまた、SNSのヘッダーやアイコン等に使用させて頂きたいので、宛名は別レイヤーにご記入頂けると幸いです。\n\n不備や失礼がありましたら申し訳ありません。どうぞご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-XaXusp5Fyf8pY2IWqAsvIXS0Z79-j3A", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@vat0uq/works/250", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2353910, "client_id": 2631323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/031d2852/uploads/origins/53ff16da-26c0-4533-b7bc-413de9e97de0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2bb0e241f74713efe82c407ffd7d24a", "srcset": "https://si.imgix.net/031d2852/uploads/origins/53ff16da-26c0-4533-b7bc-413de9e97de0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2bb0e241f74713efe82c407ffd7d24a, https://si.imgix.net/031d2852/uploads/origins/53ff16da-26c0-4533-b7bc-413de9e97de0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20ba5d047fe9d5cfc92d97a1377501cd 2x, https://si.imgix.net/031d2852/uploads/origins/53ff16da-26c0-4533-b7bc-413de9e97de0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22c89641a383374c22e2168c4567660e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/031d2852/uploads/origins/53ff16da-26c0-4533-b7bc-413de9e97de0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=271f6d46789199b79841f8cdd62157b2", "srcset": "https://si.imgix.net/031d2852/uploads/origins/53ff16da-26c0-4533-b7bc-413de9e97de0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=271f6d46789199b79841f8cdd62157b2, https://si.imgix.net/031d2852/uploads/origins/53ff16da-26c0-4533-b7bc-413de9e97de0?bg=%23fff&aut