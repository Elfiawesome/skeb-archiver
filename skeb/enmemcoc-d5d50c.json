水草と魚のような、そんな雰囲気。\n\n通過シナリオ：『ねずみとさえずり』『ウララ』\n\n\n見た目に関しては、リンク先に資料を貼っておりますのでご参照ください。\nシチュエーションや服装等はご自由にしてくださって構いません！先生のご解釈を楽しみにしています。\n\nまた、SNSのヘッダーやアイコン等に使用させて頂きたいので、宛名は別レイヤーにご記入頂けると幸いです。\n\n不備や失礼がありましたら申し訳ありません。料金が割に合わないなどありましたら再送申請をして頂けますと幸いです。\nどうぞご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1i-SDqGWQm0R1fCiSFts_lH2XW6ewu5Ga", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miifa24/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 371733, "client_id": 2631323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97007da4/uploads/origins/3c6132c3-528d-4246-a5b5-827c1b3e4d90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8094da5e58b02bc1fe07730c0d98e29f", "srcset": "https://si.imgix.net/97007da4/uploads/origins/3c6132c3-528d-4246-a5b5-827c1b3e4d90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8094da5e58b02bc1fe07730c0d98e29f, https://si.imgix.net/97007da4/uploads/origins/3c6132c3-528d-4246-a5b5-827c1b3e4d90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=986f1f2fb3afc58a990eb0f6f0476e07 2x, https://si.imgix.net/97007da4/uploads/origins/3c6132c3-528d-4246-a5b5-827c1b3e4d90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0aa53b0b4e524537d5294c042df53b8b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97007da4/uploads/origins/3c6132c3-528d-4246-a5b5-827c1b3e4d90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc11cdcd81f5a1c35f9aa6e3b86b929b", "srcset": "https://si.imgix.net/97007da4/uploads/origins/3c6132c3-528d-4246-a5b5-827c1b3e4d90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc11cdcd81f5a1c35f9aa6e3b86b929b, https://si.imgix.net/97007da4/uploads/origins/3c6132c3-528