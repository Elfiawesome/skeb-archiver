場所なら候補外であっても特に問題ありません。\nセリフ等差分\n内容等に合うものを委任します。\n\nさなてぃ☡様の発想に頼るところが大きいですが、何卒よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 298156, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "※新垢へ移行しました🐱", "screen_name": "mitunekoxxx", "avatar_url": "https://pbs.twimg.com/profile_images/1923545829341601792/uwWJZLSh.jpg", "header_url": "https://pbs.twimg.com/profile_banners/948498954940948485/1757770091/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 868243, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "空乃ちゃる🌿活動休止中", "screen_name": "sorano_charu", "avatar_url": "https://pbs.twimg.com/profile_images/1563859639174840321/1P6bR7UC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1296075124366442496/1615566687/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 144}, {"id": 1825019, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "とのじ", "screen_name": "TOTOTOTO_TK", "avatar_url": "https://pbs.twimg.com/profile_images/2035836851207163904/ujGU9y_F.png", "header_url": "https://pbs.twimg.com/profile_banners/362002239/1739467323/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "ban