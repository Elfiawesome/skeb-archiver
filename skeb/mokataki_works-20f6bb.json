s/a6f00a29-16e9-42f8-b9ef-d2322139769f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=574758af6da0cbb257b7900a306de45c 3x"}, "body": "お世話になります。\nまたも立て続けで恐縮ですが、C-7ちゃんの破裂臨界テストの様子をお願いすることはできますでしょうか。\n全裸で後ろ手＋膝立ちの状態で拘束されおびえているところから、外からわかりそうなほど子宮をパンパンにされていき快感とそれに伴う恐怖に泣き叫ぶ様子、解放されて心身とも垂れ流し状態になってしまう(それでも「こんなもんか」と罵倒されてしまう…)様子をいただけたら嬉しいです。\n加虐要素が強い内容ですので、本当に可能ならでかまいません。ご検討お願いいたします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mokataki_works/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1400767, "client_id": 2279283, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6fb29ca/uploads/origins/b30db942-94f1-46de-ad33-b358317c77b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=021f2752ad0e09826e80cb35ea39a39e", "srcset": "https://si.imgix.net/f6fb29ca/uploads/origins/b30db942-94f1-46de-ad33-b358317c77b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=021f2752ad0e09826e80cb35ea39a39e, https://si.imgix.net/f6fb29ca/uploads/origins/b30db942-94f1-46de-ad33-b358317c77b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7bd51a471902bfc18883b6311cf42ab 2x, https://si.imgix.net/f6fb29ca/uploads/origins/b30db942-94f1-46de-ad33-b358317c77b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4419e3542a9fa1a5f334d2abe5b0cc6f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f6fb29ca/uploads/origins/b30db942-94f1-46de-ad33-b358317c77b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35c316408162da22a848c450c7bca8ee", "srcset": "https://si.imgix.net/f6fb29ca/uploads/origins/b30db942-94f1-46de-ad33-b358317c77b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35c316408162da22a848c450c7bca8ee, https://si.imgix.net/f6fb29ca/uploads/origins/b30db942-94f1-46de-ad33-b358317c77b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fc77a6e2b40d8f7f3547ee1127d618ce 2x, https://si.imgix.net/f6fb29ca/uploads/origins/b30db942-94f1-46de-ad33-b358317c77b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe9c010382084a162148ba49cf6d0d3e 3x"}, "body": "お世話になります。FANBOXを拝見し、リクエストさせていただきます。\n出向先の自己紹介でヘマをした森崎さんが、本社に戻ったところで全裸土下座させられている様子をお願いしたいです。\n\nお尻を手前に向けての全裸土下座で机に乗らされている森崎さん。\n職員証が股間の下に、下着が横に(ぱんつはクロッチを上に向けて)。周囲には子宮や肛門尿道をいじめる道具が置いてあり、大きなお尻にはラクガキやビンタ(可能ならぶっかけや使用済みゴムも無様にのせられている)を、周囲には体液や陰毛を散らしていただきたいです。\nまた、先生の許容いただける範囲で教育の差分をいただけると嬉しいです。\nご検討お願いいたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mokataki_works/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1400767, "client_id": 989786, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d0be515/uploads/origins/ba6717a3-5163-4e7f-86fb-94a122d24a20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75bcb1dd0061f105ddc471137944ef5e", "srcset": "https://si.imgix.net/5d0be515/uploads/origins/ba6717a3-5163-4e7f-86fb-94a122d24a20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75bcb1dd0061f105ddc471137944ef5e, https://si.imgix.net/5d0be515/uploads/origins/ba6717a3-5163-4e7f-86fb-94a122d24a20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d53700813b850756287cd8108a25d7e 2x, https://si.imgix.net/5d0be515/uploads/origins/ba6717a3-5163-4e7f-86fb-94a122d24a20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=837bbb908992bfb908ee513580ddc993 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d0be515/uploads/origins/