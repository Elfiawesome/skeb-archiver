.net/df13cb0a/uploads/origins/b1638c1b-6d0f-43ae-8ab2-de607be27807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d34f77a9e117ce904217d93ad854e044 2x, https://si.imgix.net/df13cb0a/uploads/origins/b1638c1b-6d0f-43ae-8ab2-de607be27807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4692ef72cb323635c578c6580b237cea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df13cb0a/uploads/origins/b1638c1b-6d0f-43ae-8ab2-de607be27807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96c444a56f63bc1f858b20855c72f590", "srcset": "https://si.imgix.net/df13cb0a/uploads/origins/b1638c1b-6d0f-43ae-8ab2-de607be27807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96c444a56f63bc1f858b20855c72f590, https://si.imgix.net/df13cb0a/uploads/origins/b1638c1b-6d0f-43ae-8ab2-de607be27807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=201f0f140611cad7e00dceffc05d8eb8 2x, https://si.imgix.net/df13cb0a/uploads/origins/b1638c1b-6d0f-43ae-8ab2-de607be27807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05095263d4b617278c163cebcb88125e 3x"}, "body": "こんにちは！私はあなたのアートスタイルが大好きです！あなたが私の兄妹ジョジョの絵を描いたのを見て、あなたがポポのために何かをしたことに本当に興奮しました。私のVtuberは元錬金術師で、この世界にイセカイされた後、今はビジネスをしているサラリーマンです。\n\n服装は添付した参考リンクにある青い襟付きシャツにグレーのパンツです。ポーズとしては、ジャケットを肩にかけ、サングラスを襟にかけ//オフィスで何かをしながら持っているようなポーズがあれば嬉しいです。大人っぽいプロフェッショナルなポーズで描いてほしいですが、ご想像にお任せします！（笑もっと違うポーズがいい！という方は、ぜひ皆さんのノウハウと創造力をお貸しください。\n\nモデル参考資料＋カラー参考資料＋1例。\nhttps://drive.google.com/drive/u/0/folders/1WlPHKUsT8gIIJFogKBzi611sPbwtWQGR", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@HirumachiHiro/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1359652, "client_id": 2548024, "vtt_ur