e-4382-8ca8-a2e4c6b85531?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2739749c228da0ff19509cd1329dac2a 3x"}, "body": "こんにちは、私はあなたのエレガントなスタイルが大好きです！VTuberのアートワークをお願いしたいのですが、彼女の名前はエリア・ステラリアです。彼女は星から来た可愛い女の子で、人々を心地よく幸せにするために手紙を送り、学者にもなりたいと考えています。\n白衣を着て、リファレンス以外の服装で、自分の部屋で、ホワイトボードの前に立って授業をしている姿を描いてほしいです。作品のアスペクト比は16：9でお願いします。\n一般的には、知的な女性の雰囲気があれば最高です。必要であればアートワークの例を用意しましたが、その通りにする必要はありません。\n\n作品は、エリアステラリアのYouTubeチャンネルで使用したり、TwitterなどのSNSに投稿する可能性があります。その点をご了承の上、お引き受けください。\nご検討のほど、よろしくお願いいたします。\n\nエリア・ステラリア参考： https://drive.google.com/file/d/1Dg0OK7w5IYNSYIvozHALO-yK2OXrdon2\n\n彼女の部屋： https://drive.google.com/file/d/1MdFzY4kJAiwbdON9nvePe_Yky49kH434\n\nアートワーク例（必要な場合）：https://drive.google.com/file/d/1xtlaADDzeAbTfQf-NNJ-Ibkf2lseWYyK", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@HirumachiHiro/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1359652, "client_id": 2321094, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c0d34b7/uploads/origins/2c864c3c-ca27-4af9-80ba-fc988ceccbd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb12038ff432a71de38321c0a40e0c4d", "srcset": "https://si.imgix.net/1c0d34b7/uploads/origins/2c864c3c-ca27-4af9-80ba-fc988ceccbd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb12038ff432a71de38321c0a40e0c4d, https://si.imgix.net/1c0d34b7/uploads/origins/2c864c3c-ca27-4af9-80ba-fc988ceccbd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d30be553043b51caefa91b4d7f29b4c8 2x, https://si.imgix.net/1c0d34b7/uploads/origins/2c864c3c-ca27-4af9-80ba-fc988ceccbd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8eeaddc0f5356a0c1c7af1fcff8b9820 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.ne