age_urls": {"src": "https://si.imgix.net/2d6e88d0/uploads/origins/e44c06df-79af-49e8-a5de-cc1760e951db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff86f3946630aed6ac0fad361ac22875", "srcset": "https://si.imgix.net/2d6e88d0/uploads/origins/e44c06df-79af-49e8-a5de-cc1760e951db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff86f3946630aed6ac0fad361ac22875, https://si.imgix.net/2d6e88d0/uploads/origins/e44c06df-79af-49e8-a5de-cc1760e951db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac4a03943eca1649730d927c43f2ecef 2x, https://si.imgix.net/2d6e88d0/uploads/origins/e44c06df-79af-49e8-a5de-cc1760e951db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ce56ee61e43fa673de66eea757b92818 3x"}, "body": "はじめまして！\n\nあなたの絵柄が大好きで、『サキュバスアカデミア』のまゆのイラストをリクエストしたいです。『もんむす・くえすと！』のルカに、生意気な笑顔で足コキをしているところだと最高です。\n\nまた、まゆの衣装は陸上ユニフォームと赤ブルマの方が好みなのですが、その衣装で描いていただければ嬉しいです！\n\nリクエストをご検討いただき、ありがとうございました！\n\nまゆ: https://www.dlsite.com/maniax/work/=/product_id/RJ265946.html", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@puni2cheese/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3352271, "client_id": 1774222, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc406ef7/uploads/origins/abef2ab3-a5b1-4c27-8638-860d261256b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6244dd5d8e2e6ffdc86169d71497603f", "srcset": "https://si.imgix.net/dc406ef7/uploads/origins/abef2ab3-a5b1-4c27-8638-860d261256b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6244dd5d8e2e6ffdc86169d71497603f, https://si.imgix.net/dc406ef7/uploads/origins/abef2ab3-a5b1-4c27-8638-860d261256b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e20993f4ecb8d7b358b553eb