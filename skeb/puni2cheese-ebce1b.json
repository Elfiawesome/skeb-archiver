t%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5583ca6c89011eba214ab2e91736a293", "srcset": "https://si.imgix.net/769ddc94/uploads/origins/b81a8726-6f78-4770-992a-b486dcaf8d70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5583ca6c89011eba214ab2e91736a293, https://si.imgix.net/769ddc94/uploads/origins/b81a8726-6f78-4770-992a-b486dcaf8d70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3b890c59c25f540f0f188d1e215e8ed 2x, https://si.imgix.net/769ddc94/uploads/origins/b81a8726-6f78-4770-992a-b486dcaf8d70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78370bbef4421d76a4c7ca209f37f13c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/769ddc94/uploads/origins/b81a8726-6f78-4770-992a-b486dcaf8d70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b001b85e93068a5a950962153d9c482", "srcset": "https://si.imgix.net/769ddc94/uploads/origins/b81a8726-6f78-4770-992a-b486dcaf8d70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b001b85e93068a5a950962153d9c482, https://si.imgix.net/769ddc94/uploads/origins/b81a8726-6f78-4770-992a-b486dcaf8d70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=158abfb5f9d93c1484061967303e0a36 2x, https://si.imgix.net/769ddc94/uploads/origins/b81a8726-6f78-4770-992a-b486dcaf8d70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4b86187b5dec12661f4eb31c7f553e5e 3x"}, "body": "お世話になっています。前回ラミのリクエストをさせていただきましたが、手数料無料期間に再度お願いしたいとおもいリクエストさせていただきます。\n\n今回、「もんむす・くえすと」シリーズで一番好きなミノタウロス娘のミナでお願いしたいです。\nミナがポケット魔王城内でひょんな事から小さくされたルカさんをたまたま見つけ、捕まえて全身パイズリで弄んでいる・・・というシチュで、両手で胸を強く圧迫して、谷間に挟んだルカさんを押し潰すおっぱい責めをお願いします。\n\n①特大おっぱいとミナの怪力による乳圧責めで何度もイカされるルカさんと、滅多にない状況を楽しみながら容赦なく責め立てるミナ\n②力加減間違えてイかせるだけじゃなくルカさんにトドメさしそうになるミナ（ポキッ、ペキッみたいな骨が折れるようなSEと「あ、やべ！潰しちまったかな！？」と慌てるイメージ）\n③ザーメン塗れ＋潰されてボロボロになりながらも快楽で失神してるルカさんと、そんなルカさんを摘み出して満足そうなミナ\n\nもし金額的に可能なら前段シーンで、サイズ差と状況に危機感を感じつつも下から見上げたミナの爆乳に目が奪われて興奮してるみたいなイメージで、小さくなったルカさんがミナに見つかり見下されている様子も描いていただけると嬉しいです。\n\nルカさんはミナの手のひらの収まる位の大きさでセリフなどアレンジはお任せします。\n少しニッチなリクエストですが、ご検討の程よろしくお願いいたします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@puni2cheese/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3352271, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd5ff93c/uploads/origins/a254af3c-943e-4a48-badb-2ac77347782f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=134536f6ebc630cefdd6e0477006572f", "srcset": "https://si.imgix.net/cd5ff93c/uploads/origins/a254af3c-943e-4a48-badb-2ac77347782f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=134536f6ebc630cefdd6e0477006572f, https://si.imgix.net/cd5ff93c/uploads/origins/a254af3c-943e-4a48-badb-2ac77347782f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf6d79a109866fa17e83b3e755f51c6d 2x, https://si.imgix.net/cd5ff93c/uploads/origins/a254af3c-943e-4a48-badb-2ac77347782f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a434c0fa804734374e2cd4c836542f1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd5ff93c/uploads/origins/a254af3c-943e-4a48-badb-2ac77347782f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe6c4ebf055fad7c0ee4e7ed4458af3c", "srcset": "https://si.imgix.net/cd5ff93c/uploads/origins/a254af3c-943e-4a48-badb-2ac77347782f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe6c4ebf055fad7c0ee4e7ed4458af3c, https://si.imgix.net/cd5ff93c/uploads/origins/a254af3c-943e-4a48-badb-2ac77347782f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=54ef8968297e3c00ec03beec08fd4f2d 2x, https://si.imgix.net/cd5ff93c/uploads/origins/a254af3c-943e-4a48-badb-2ac77347782f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5210dcf3d660855b38de1740615a23e8 3x"}, "body": "以前ベルの授乳手コキのイラストをリクエストさせていただいたものです。\n以前はありがとうございました！\nあのイラストがとても良かったので似たようなものになってしまうのですがリクエストさせていただきます。\n\nもんむすくえすとのセントールがルカに授乳手コキしてあげて、射精させるイラストをお願いいたします。\n\nシチュとしては闘技場で闘うルカとセントール。勝ったのはセントール。勝ったご褒美として負けた人に好きなことができるということで、可愛くて好きなルカにみんなの前で授乳手コキしてあげるというシチュでお願いします。\n\n原作の授乳手コキシーン（資料URL）みたいにキャミソールはおっぱいを吸わせるため片方だけおっぱいを露出するように下ろし、もう片方は着ておく。そしてルカの上体を起こすように頭を抱きかかえる。\nルカは資料URLのように吸ってない方のおっぱいをキャミソールの上から鷲掴みにし、揉んでいる感じでお願いします。\n\n2人の顔は興奮や恥ずかしさから頰を赤くしている感じでお願いします。（セントールは授乳手コキ中に途中からおっぱいを吸ったり揉んだりしているルカが可愛く、愛おしく思い理性が暴走してもっと顔を赤くする感じで）\n\nセントールは原作通り、好きな人に素直になれないツンデレキャラっぽい性格でお願いします。\nそして、授乳手コキ中は「みんなに見られて、恥ずかしくないの？」と煽ったり、赤ちゃん言葉を使ったりして言葉責めをし、見てる人にルカのことが好きとバレないように振る舞う感じでお願いします。\n\nまた、バレないように振る舞うが、続けていくうちにルカの可愛さに興奮し、暴走気味になり、表情や興奮度合いから実況の人や観客の人からはバレバレで、実況の人から好きなんでしょ？と聞かれ、「は？好きじゃないし…」と顔を真っ赤にしながらも正気に戻ってツンツンする要素を入れてほしいです。（内容量的に多くなって難しい場合は大丈夫です）\n\nセリフはてきれば、ルカとセントール、実況の人と観客につけて欲しいです。（難しい場合はセントールと観客を優先的に、次いで実況の人という感じで）\n\nセントールは原作やシチュに合わせた感じでお任せしますが、セントールから「授乳手コキ」という単語を1回以上、授乳手コキ中、おっぱいを揉んでいることを指摘するようなセリフを入れてほしいです。\n\n観客は授乳手コキを見て羨む男の声や何も知らない純粋な子供が「ママ〜、あれなに？」と興味本位で聞き、それに対して「見ちゃいけません！」という母のセリフ、原作であったような恥ずかしがり屋な女の子が男のち○こを見て「きゃっ♥男の人のって…あんななんだ♥」とといったセリフを入れてほしいです。\n\n実況はそのまま授乳手コキされてる実況をしたり、先程あげたようなセントールに好きなんでしょ？と突っ込んだりするセリフがほしいです。（実況の人は女という設定で）\n\nその他構図やルカの表情についてはお任せします。\n\n注文が多く、申し訳ありませんが\nご検討のほど、よろしくお願いいたします\n\nhttps://media.ci-en.jp/private/attachment/creator/00009135/635e470381ab06f55c70eb406c96853fbee1ebfe3f3b523fd3ed67e42c0356cd/image-800.jpg?px-time=1738765494&px-hash=27b32cfe334273bb4b0f2eaa3e2002b31a2fcd52", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@puni2cheese/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3352271, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/761b7dd8/uploads/origins/ef97fb82-8e89-469e-8ccc-42990f8d4b98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=586c6a5b9c1ad37c301eab94e4d8ec25", "srcset": "https://si.imgix.net/761b7dd8/uploads/origins/ef97fb82-8e89-469e-8ccc-42990f8d4b98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=586c6a5b9c1ad37c301eab94e4d8ec25, https://si.imgix.net/761b7dd8/uploads/origins/ef97fb82-8e89-469e-8ccc-42990f8d4b98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1330b79259fbc7d907ae12ac1686f08e 2x, https://si.imgix.net/761b7dd8/uploads/origins/ef97fb82-8e89-469e-8ccc-42990f8d4b98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90d1fe721cdc432d2f044d1aca525644 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/761b7dd8/uploads/origins/ef97fb82-8e89-469e-8ccc-42990f8d4b98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d932f17749638d5d9007d491417b6499", "srcset": "https://si.imgix.net/761b7dd8/uploads/origins/ef97fb82-8e89-469e-8ccc-42990f8d4b98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d932f17749638d5d9007d491417b6499, https://si.imgix.net/761b7dd8/uploads/origins/ef97fb82-8e89-469e-8ccc-42990f8d4b98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=feae97f68d97d39be0f29eb09d8e623a 2x, https://si.imgix.net/761b7dd8/uploads/origins/ef97fb82-8e89-469e-8ccc-42990f8d4b98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3efbc817380acda21afae7da1b5dd2e6 3x"}, "body": "匿名で失礼します。\npixivのリクエストから同人ゲームのイラストを描いているというのを見て、今回リクエストさせていただきます。\n\nパレードバスターという同人ゲームのベルというキャラが主人公のレストくんに授乳手コキをしてあげてるイラストをお願い致します。\n衣装は原作のままでいいんですが武器や手袋を取って描いてくれたら嬉しいです。\n\nまた、イラストとしてはベル（資料URLの右側の髪が青っぽいほう）が膝枕でレストくんの頭を抱きかかえながら扱いており、レストくんは快楽が強すぎて目を閉じつつも片方のおっぱいをしっかり吸いつつ、もう片方のおっぱいを揉んでいるようにお願いします。\nまた射精時の差分もお願い致します。\n\nまた、セリフとしてはお任せいたしますが、「ほ〜ら♥アンタの大好きな授乳手コキでちゅよ〜♥」というセリフを入れてほしいのとセリフに続くように、ベルがレストくんを小バカにするようなセリフを入れていただけると嬉しいです。\n\n描けない場合は、キャンセルしていただいても構いませんので、\nご検討のほど、よろしくお願い致します。\n\nhttps://media.ci-en.jp/private/attachment/creator/00001866/a0ad69696d594e2f7d0c8a2d76322cd93326991cbe8a4a2409bff8cf69345b38/image-web.jpg?px-time=1729392256&px-hash=4b18f10c17ebb3b3595e7224126f347bbf10225c", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@puni2cheese/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c3729387/uploads/origins/b5d20b3f-eff9-480a-8494-63d21a6c9798?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41ce0c551c126c6ddfbc10338302b7ea", "srcset": "https://si.imgix.net/c3729387/uploads/origins/b5d20b3f-eff9-480a-8494-63d21a6c9798?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41ce0c551c126c6ddfbc10338302b7ea, https://si.imgix.net/c3729387/uploads/origins/b5d20b3f-eff9-480a-8494-63d21a6c9798?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b14ac126a16a99803f39a0bdf81c739a 2x, https://si.imgix.net/c3729387/uploads/origins/b5d20b3f-eff9-480a-8494-63d21a6c9798?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=100f4d11b8ef214e795b53a5765c08ad 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3352271, "client_id": 2342055, "nc": 48}, {"path": "/@puni2cheese/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art"