rop=top&w=200&h=200&blur=200&s=018af0d2ec03d1bc29fd179bfb846c06", "src_set": ""}, "body": "りんご先生、こんにちは。先生の作品の空気感がとても好きなので、私のocの絵を依頼します。\n\n*\nキャラクターは漫画から現実にやってきた冒険家で、体はモルモットです。\nチョコレート色の髪にイチゴ色の目。\n身長151cm、活発で明るく、周囲から愛される熱血少女だが、実はとても騒がしく、考え事をしているときは笑顔が悪い。\n趣味は友達作りとデザート。\n\n衣装、構図、動き、表情に制限はないので、林檎先生には自由にやってもらいたい。\nhttps://drive.google.com/drive/folders/1a67fZS2-DOqatA8sek4NpqLV88J-XbMn?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rinrinappleple/works/34", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2742059, "client_id": 3295505, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3afca3a0/uploads/origins/4d8d579c-d902-4633-937f-43fba9103ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e66b24dd11478a9a4331014a2caa703e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3afca3a0/uploads/origins/4d8d579c-d902-4633-937f-43fba9103ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9561c46c2ec6b4b1dee1257761e2e547", "src_set": ""}, "body": "こんにちは！あなたのアートスタイルと鮮やかな色彩がとても好きです。私のキャラクターの騎士服の絵をぜひお願いしたいです。https://drive.google.com/file/d/108Z8vdJ7mOy1dNKX16de4aBF9X9Jiy2h/view?usp=drive_link\n\n彼女はFFXIVのオリジナルキャラクターで、元は王家の騎士でした。モチーフは青い鳥と青い花。\n\n特にライティングに惹かれました：(https://skeb.jp/@rininappleple/works/26）。彼女が新しい冒険に向かっているような雰囲気の作品になればと思います。構図は自由に決めていただいて構いませんので、ご検討のほどよろしくお願いいたします！\n\n彼女の他の参考文献はこちら：https://drive.google.com/drive/folders/1eQwQfTKry9YnH33Y9YHf6Cpvoxrhvs_8?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1eQwQfTKry9YnH33Y9YHf6Cpvoxrhvs_8?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rinrinappleple/works/33", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2742059, "client_id": 2747250, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c7756f2/uploads/origins/a7ed4192-0236-4305-a8da-f19b703fe67f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2d4df4461db9fbdf7e9bf5bed0c87c8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c7756f2/uploads/origins/a7ed4192-0236-4305-a8da-f19b703fe67f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34ffc075c33256cef0cc7819e721d623", "src_set": ""}, "body": "こんにちは、前回の依頼を描いていただきありがとうございました！今回もキャラクターのイラストをお願いしたいと思います。\n\n今回は、ゲーム「Until Then」に登場する2人のキャラクターを描いてください。\n\n二人の名前は \"Mark Borja \"と \"Nicole Lacsamana \"です。\n\n二人はソウルメイトです。\n\n以下は彼らの参考文献です：\n- https://pbs.twimg.com/media/GVebdooaAAAzBpj?format=jpg&name=medium\n- https://pbs.twimg.com/media/GVebdooaQAASph_?format=jpg&name=medium\n- https://pbs.twimg.com/media/GVebdoraoAA_lIf?format=jpg&name=medium\n- https://pbs.twimg.com/media/GVPyPF6WUAAfjE0?format=jpg&name=medium\n- https://pbs.twimg.com/media/GU1jKZSX0AAX7FV?format=jpg&name=4096x4096\n-https://pbs.twimg.com/media/GVe4dVGWMAAlYcY?format=jpg&name=large", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rinrinappleple/works/32", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2742059, "client_id": 2359564, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2729ba7/uploads/origins/c7572dc6-8216-4e35-a8e0-42f7b900afcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4898a0b34140544b1c82ab58a4619082", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2729ba7/uploads/origins/c7572dc6-8216-4e35-a8e0-42f7b900afcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b8d0a5ef2fddbe48a2ae24485c9e0c", "src_set": ""}, "body": "こんにちは！私のOCカップルのアートワークをお願いしたいのですが。\n\nあなたの作品の暖かさと色使いが本当に大好きです！本当に心がとろけます。同じような暖かさと親密さを持った2人のキャラクターが見られたら嬉しいです。暖かい熱帯雨林の中で、二人が憩いの時を過ごしているような。オス（ソレイユ）がメス（エストレヤ）においしい惣菜を食べさせているとか？\n提供された素材や参考文献を、あなたがベストだと思う方法で自由に使ってください！\n\nご検討ありがとうございました！\n\nhttps://hopesninos.notion.site/31a15d304e7340dab88fa6ce534d65af?v=d9c8aa78e3bc4fdea3995f1b3e484690&pvs=4", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rinrinappleple/works/31", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2742059, "client_id": 3249131, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4cd5cb91/uploads/origins/951c09ea-9469-483c-8398-a9885621a897?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a8b60418d77de9f2ad57d8afb88bef", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4cd5cb91/uploads/origins/951c09ea-9469-483c-8398-a9885621a897?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9aad0c1311ff73c32d45c96dd7ebcb8", "src_set": ""}, "body": "こんにちは！私のエイリアンのキャラクターを描いていただけませんか？私のキャラクターは満面の笑みで振り返り、背景は色とりどりの星が輝く美しい夜空にしてほしいです！\n\nhttps://skeb.jp/@rinrinappleple/works/17。\n\n SNS(Twitch/Twitter)で使用したいので、背景・文字・キャラクターを分けていただけるとありがたいです。\n\nご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/u/2/folders/10dGUwEBUR6f1mMCOzOs1YnK_Il4--KIL", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rinrinappleple/works/30", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2742059, "client_id": 2990807, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d5f4ab3/uploads/origins/ce44f99b-fa99-4ba2-88bf-a35feebc71f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b464831afeb41f57292bd1e69276241a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d5f4ab3/uploads/origins/ce44f99b-fa99-4ba2-88bf-a35feebc71f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=532eb2aeb681b12ffa759f51ef96d47d", "src_set": ""}, "body": "こんにちは！グランブルーファンタジー(https://gbf.wiki/images/4/4e/Npc_zoom_3040258000_01.png)のイルザのアートをお願いしたいです。ポーズや構図は自由ですが、表情は幸せそうな感じにしてほしいです。背景は、なるべく広々とした野原で、空にはきれいな雲が浮かんでいてほしいです。できれば指には結婚指輪をしていてほしいです。ありがとうございました！\n\nhttps://gbf.wiki/images/4/4e/Npc_zoom_3040258000_01.png", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rinrinappleple/works/29", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/609fd086/uploads/origins/7eb9d487-6e35-4d36-91c2-63ab31a8ad16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44a75707b7f844b96b9b1e375cadb29d", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2742059, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@rinrinappleple/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2742059, "client_id": 1309008, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c39e3281/uploads/origins/e275dc8d-eaeb-43ba-8024-3c4fffe637cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e29e5c753b7a345c6ec37f3970ee650", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c39e3281/uploads/origins/e275dc8d-eaeb-43ba-8024-3c4fffe637cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ce53b8c93915d436691d836122f4640", "src_set": ""}, "body": "こんにちは！流れ星ロックマンの美空ひびきと星川昴の絵をリクエストしたいです！\n\n美空： https://static.wikia.nocookie.net/megaman/images/f/f0/Sonia_full_art.png\n\n星川：https://imgur.com/a/2zGg2AU\n\n二人ともシンプルな草原か丘に座っていてほしいです。背後には星空を。できれば、流れ星が1つくらいあるといい。\n\n美空には穏やかにギターの練習をしていてほしい。星川は美空のそばでその様子を見ていてほしい。片膝か両膝を曲げて座り、星川は片膝か両膝に腕を置いている。このポーズである必要はないが、このようなポーズが欲しい：\nhttps://img3.gelbooru.com//images/cc/88/cc8854f1f1ff7afcc0a3c351fbf079cb.png\nやはり、美空にはなんとなくこんな感じで座りながらギターを弾いてもらいたい。\n\n美空も星川も、二人きりで穏やかな時間を楽しんでいるような、穏やかな表情、幸せそうな表情をしてほしい。美空はフードをかぶってほしい。\n\nもう一枚小さい画像でよければ、美空が幸せそうな笑顔で見る人を見つめているかわいい画像が欲しいです。ウサギを抱いていてもいい。これは作者が描きたい場合のみで、作者が望むように詳細でもスケッチ風でも構いません。\n\nご検討ありがとうございました！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rinrinappleple/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2742059, "client_id": 291600, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23e0d512/uploads/origins/b2676092-dbab-444d-8ed4-a7f9bb072655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=450c184a9745844fe5c12419735a9e3d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23e0d512/uploads/origins/b2676092-dbab-444d-8ed4-a7f9bb072655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66c53db4ba979ae1712c7206f35f07bd", "src_set": ""}, "body": "リンゴ様\nはじめまして。あたたかな色使いと優しい表情に惹かれました……！\nぜひ自創作物語の子を描いていただけたらと感じ、リクエスト失礼します。\n\n●人物\n男性フィーゼ／女神の騎士、穏やかで優しい\n女性ウィリス／水の女神、ぼんやりで控えめ、被り物なし\nhttps://drive.google.com/file/d/1Z4ML7Yw5JRuFUlCAQ-6Rj5ijv8aWbFK-/view?usp=drive_link\n\n●内容\n500年の付き合い、互いに大切。\n男性が女性をエスコートする系、温かく微笑ましい雰囲気希望。\n不明点お任せ。自由にかわいがっていただけたら嬉しいです。\n\n●用途\n基本個人観賞用（作者としてカワイイうちの子が見たい）。\nその他、本作関係者への公開のためSNS投稿、作品置場（※無料エリア）で公開。\nまた投稿公開にあたりサムネイル等への加工権希望。\n\nご検討よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1018324, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Be:)🐝", "screen_name": "BPunapuna", "avatar_url": "https://pbs.twimg.com/profile_images/1959520580123918336/7gW9Kcm-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1635533319365599232/1749116555/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 49}, {"id": 1032985, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "なきぢ", "screen_name": "nakididioso", "avatar_url": "https://pbs.twimg.com/profile_images/1875135529039413249/SPNo6UB9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4221506414/1690968390/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 32}, {"id": 1224166, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "tokožka", "screen_name": "tkzkrnp", "avatar_url": "https://pbs.twimg.com/profile_images/1847230631891410944/IR-_O1zH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/926632020532269057/1729249088/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 1}, {"id": 2146670, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "狛乃", "screen_name": "manoko_mano", "avatar_url": "https://pbs.twimg.com/profile