": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@yuzu_mog/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2587603, "client_id": 335905, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65b5a7d2/uploads/origins/7eb32641-117f-4b2f-b4c9-41b56c0e1b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f13ab5bf9c7248216b289659c2f3b9a", "srcset": "https://si.imgix.net/65b5a7d2/uploads/origins/7eb32641-117f-4b2f-b4c9-41b56c0e1b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f13ab5bf9c7248216b289659c2f3b9a, https://si.imgix.net/65b5a7d2/uploads/origins/7eb32641-117f-4b2f-b4c9-41b56c0e1b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98e31574947e6daa7a0f68d5a54bc890 2x, https://si.imgix.net/65b5a7d2/uploads/origins/7eb32641-117f-4b2f-b4c9-41b56c0e1b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b39c4a024526f4c5d3e257df340378a8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65b5a7d2/uploads/origins/7eb32641-117f-4b2f-b4c9-41b56c0e1b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f39dd38e8e6d64b540b2637732c4e8bb", "srcset": "https://si.imgix.net/65b5a7d2/uploads/origins/7eb32641-117f-4b2f-b4c9-41b56c0e1b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f39dd38e8e6d64b540b2637732c4e8bb, https://si.imgix.net/65b5a7d2/uploads/origins/7eb32641-117f-4b2f-b4c9-41b56c0e1b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2f4cbec782dad731cbc395766ee86586 2x, https://si.imgix.net/65b5a7d2/uploads/origins/7eb32641-117f-4b2f-b4c9-41b56c0e1b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d7520f6f9f18b6ea92611ddac81624bf 3x"}, "body": "いつもイラスト拝見させていただいております。\n以下のイメージでリクエストさせていただけると幸いです。\n\n・見習い～新米薬士\n・髪は長めストレート～ちょっとウェーブかかった感じ\n・全体的に色素薄めな感じで穏やかというか少し儚い印象\n・服装は柔らかい感じ(ふわっとしたイメージ、フリル多めだと助かります)\n・構図等はお任せいたします。\n\nさっくりとしたイメージとなってしまいますが、よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yuzu_mog/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2587603, "client_id": 1675705, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16dcf909/uploads/origins/fdbe2be5-4319-4f14-917e-0337740444ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33d7b2bf7f3200a3e8d0daa4f588ccc7", "srcset": "https://si.imgix.net/16dcf909/uploads/origins/fdbe2be5-4319-4f14-917e-0337740444ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33d7b2bf7f3200a3e8d0daa4f588ccc7, https://si.imgix.net/16dcf909/uploads/origins/fdbe2be5-4319-4f14-917e-0337740444ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09743d92c734d08d7f15c04f72f6b2e9 2x, https://si.imgix.net/16dcf909/uploads/origins/fdbe2be5-4319-4f14-917e-0337740444ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc43ba9a6d7f9848c648d1bed815189d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/16dcf909/uploads/origins/fdbe2be5-4319-4f14-917e-0337740444ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=583cf9b3cc871fe7974b921ae3a7599f", "srcset": "https://si.imgix.net/16dcf909/uploads/origins/fdbe2be5-4319-4f14-917e-0337740444ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=583cf9b3cc871fe7974b921ae3a7599f, https://si.imgix.net/16dcf909/uploads/origins/fdbe2be5-4319-4f14-917e-0337740444ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e2f05dbdd838b79aa6688d9c1a3cb9b2 2x, https://si.imgix.net/16dcf909/uploads/origins/fdbe2be5-4319-4f14-917e-0337740444ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=034a2ac88982e9f4c503222542015347 3x"}, "body": "ゆずよもぎ先生\n\nはじめまして！\nVtuber準備中の稲荷ひなのと申します。\n\nゆずよもぎ先生の背景も可愛く描き込まれたケモ耳×エプロンのイラストが昔から大好きで、再開を心待ちにしておりました。\nぜひ私のイラストを描いていただきたく思い、リクエストを送信させていただきます。\n\n■リクエスト内容\n･「稲荷ひなの」のイラスト\n･構図、ポーズ等はすべてお任せします。\n･背景に和柄の花(梅･桜･蓮)やティーセット、お菓子などを散りばめていただけると嬉しいです。\n\n■使用用途\nVTuber活動に伴うSNS（Twitter、Youtube、TikTok、FANBOX内）での使用\nhttps://twitter.com/inarihinano\nhttps://youtube.com/@inarihinano\n\n■納品形式\n可能であればキャラクター、背景、宛名などがレイヤー分けされたPSDデータ、もしくはPNGファイルで頂けますと幸いです。 ⁡\nキャラクターが見切れていない引きのイラストも頂けますと嬉しいです。\n\n■参考資料\nhttps://drive.google.com/drive/folders/1-7aW8kQ_BCCgm1tYo4HCLz08oicwG5xI\n\nぜひご検討よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yuzu_mog/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2587603, "client_id": 68057, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/116f0f5e/uploads/origins/ab5c491a-3af6-417a-93d1-ecc22e78ad2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2b0d34cb23cff766d208d5309ca67ff", "srcset": "https://si.imgix.net/116f0f5e/uploads/origins/ab5c491a-3af6-417a-93d1-ecc22e78ad2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2b0d34cb23cff766d208d5309ca67ff, https://si.imgix.net/116f0f5e/uploads/origins/ab5c491a-3af6-417a-93d1-ecc22e78ad2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=715e5f6df7834e83ebe0bf330226ea67 2x, https://si.imgix.net/116f0f5e/uploads/origins/ab5c491a-3af6-417a-93d1-ecc22e78ad2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8c6de83357348715a00a551e7905f05 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/116f0f5e/uploads/origins/ab5c491a-3af6-417a-93d1-ecc22e78ad2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0ec98d000ec3487c6496b523abad22f", "srcset": "https://si.imgix.net/116f0f5e/uploads/origins/ab5c491a-3af6-417a-93d1-ecc22e78ad2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0ec98d000ec3487c6496b523abad22f, https://si.imgix.net/116f0f5e/uploads/origins/ab5c491a-3af6-417a-93d1-ecc22e78ad2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a37448b1b4b7d34a0428ca7a5a8debc 2x, https://si.imgix.net/116f0f5e/uploads/origins/ab5c491a-3af6-417a-93d1-ecc22e78ad2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c3671c405bca75f111eb8c2fdc473094 3x"}, "body": "こんにちは。\nゆずよもぎさんがリクエスト受付開始されたとのことで、早速リクエストさせて頂きます！\nよろしければ、自分の創作キャラクターのイラストをお願いします。\n設定や資料は以下に記載いたします。\n\n◆或香（Alca）\n・愛用の天球儀を媒体にして星魔法を使う、占星術師の女の子です。身長は160cm前後です。\n・落ち着いた性格ですが、アクティブな面もあります。\n・濃紺色の髪、金色の眼、黒と青を基調とした服装です。\n・家では天文台の付いているちょっと変わった洋菓子店をやっており、星や星空をモチーフとした様々なお菓子を売っています。自身も甘いお菓子が大好きです。\n・服装や構図などの細部はお任せしますが、可能な範囲でお好みでアレンジ等して頂けますと嬉しいです。\n\n何卒、よろしくお願いします！\n\n・https://drive.google.com/drive/folders/1_SBwLN-lB7VnCTXbF9FQiAHo4ZBzg8yH?usp=sharing\n・https://drive.google.com/drive/folders/14zrTes4sb7kgPPu_Cj7KMQxv9py7U7nd?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yuzu_mog/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2587603, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4012b97/uploads/origins/c25aee78-766e-455f-b7f6-a39460f52411?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2348919d92b4b502e94089a521e56868", "srcset": "https://si.imgix.net/f4012b97/uploads/origins/c25aee78-766e-455f-b7f6-a39460f52411?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2348919d92b4b502e94089a521e56868, https://si.imgix.net/f4012b97/uploads/origins/c25aee78-766e-455f-b7f6-a39460f52411?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c7b8fc25de9404a7a2a1df48247ab1c 2x, https://si.imgix.net/f4012b97/uploads/origins/c25aee78-766e-455f-b7f6-a39460f52411?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f2bef9c2718c618542e5bbe6d44e5f4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4012b97/uploads/origins/c25aee78-766e-455f-b7f6-a39460f52411?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aefd72d0f044bec2f040d35c14da130d", "srcset": "https://si.imgix.net/f4012b97/uploads/origins/c25aee78-766e-455f-b7f6-a39460f52411?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aefd72d0f044bec2f040d35c14da130d, https://si.imgix.net/f4012b97/uploads/origins/c25aee78-766e-455f-b7f6-a39460f52411?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ee91dd8f7680da8b60568bc86821ce57 2x, https://si.imgix.net/f4012b97/uploads/origins/c25aee78-766e-455f-b7f6-a39460f52411?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95300f9abd4300067b8f39ca3a94c7b8 3x"}, "body": "ゆずよもぎさま\nネット声優として活動しております、水戸とうると申します。\nかわいい女の子のイラストばかりで大変胸が高鳴り、いつかご依頼してみたいと思っておりました！\n\nꕤイラストの用途：水戸とうるの声活動（SNS・YouTube、Skebなどでイラストをお願いするときの参考資料、非営利の範囲でグッズ作成など）\n私個人のPC、iPhoneの壁紙にもさせていただきます！\n\nそのため頭等切れない構図で描いていただけると幸いです。\n\nꕤ特徴┊前髪ぱっつんガーリーファッション、三つ編みとお花がチャームポイント\n髪型┊前髪はぱっつんを少し分けて、ラベンダー色のメッシュ、髪色はプラチナブロンドからラベンダー色になっていくグラデーション、\nラフな三つ編みイメージです（三つ編み要素が入っておりましたら服装に合うようアレンジや装飾追加も大歓迎です✿）\n瞳黄緑色のグラデーション\nネイルイエローオレンジ系\n\nꕤ希望\n今回、黄色やオレンジのお花をテーマに服装デザインを先生のセンスにおまかせでお願いいたします。\n可能であればイメージカラー┊のイエローオレンジ(カラーコード#ffcc33あたりのお色)を取り入れていただけると嬉しいです。\n\n和装洋装どちらも素敵にデザインされてらっしゃいますので、お好きな方でお願い致します！\n\nフリルやレトロ、お花やリボン、アンティークっぽい雰囲気が好きです。\n\n小物┊髪や耳にお花を付けていただきたいです✿\n\n参考お花┊ミモザ・マリーゴールド・チューリップ・バラ・マーガレット・キンモクセイ・カスミソウ\n\nサイン別、背景、キャラなどレイヤー分けPSDやPNGもちょうだいできますと幸いです。\n---------------\nぜひ可愛らしくお好きに描いていただけたら幸せです。\nご縁がございましたらどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1dm00aZuAP9iHVANJ1O6ZFtHGe-oceTjr?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yuzu_mog/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2587603, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed09af88/uploads/origins/d997c975-26f5-419b-9e57-a7701230919e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb95ee9de6d5fb50e526583e6e427a8e", "srcset": "https://si.imgix.net/ed09af88/uploads/origins/d997c975-26f5-419b-9e57-a7701230919e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb95ee9de6d5fb50e526583e6e427a8e, https://si.imgix.net/ed09af88/uploads/origins/d997c975-26f5-419b-9e57-a7701230919e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56ad85a6994179a8625b079cdcb8ca63 2x, https://si.imgix.net/ed09af88/uploads/origins/d997c975-26f5-419b-9e57-a7701230919e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a18ba13d49539e71ce34d99c7c6def51 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed09af88/uploads/origins/d997c975-26f5-419b-9e57-a7701230919e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a165c4e62a03d9bf597a969a8ba5c3f0", "srcset": "https://si.imgix.net/ed09af88/uploads/origins/d997c975-26f5-419b-9e57-a7701230919e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s