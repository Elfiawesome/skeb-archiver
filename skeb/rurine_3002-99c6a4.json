op=top&w=200&h=200&s=35ba452c2b475ee97c5fe9b1eda622ba 2x, https://si.imgix.net/38e00d04/uploads/origins/98dfba7d-e2af-4762-b1f1-dc8a3a6baa2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff2b56ecb3a1871a2b0151d76c0307b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38e00d04/uploads/origins/98dfba7d-e2af-4762-b1f1-dc8a3a6baa2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7dac1aa5d04f2a56f3f6dcaaf21e0881", "srcset": "https://si.imgix.net/38e00d04/uploads/origins/98dfba7d-e2af-4762-b1f1-dc8a3a6baa2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7dac1aa5d04f2a56f3f6dcaaf21e0881, https://si.imgix.net/38e00d04/uploads/origins/98dfba7d-e2af-4762-b1f1-dc8a3a6baa2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ee0cb730fd6299b114ebdd658986f72 2x, https://si.imgix.net/38e00d04/uploads/origins/98dfba7d-e2af-4762-b1f1-dc8a3a6baa2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=37726f8495a8b851bf5803a3b37b4df9 3x"}, "body": "まぐねこさんこんにちは。るげつぺぽと申します。\n前回もとっても素敵なイラストをいただきありがとうございました！本当にかっこよくて素敵でした……!!\nよろしければ、再度私が配信で使用している代理キャラクター(アバター)である顔色ちゃんを描いてほしいです！何度もすみません！\n\n今回も目と口の表情差分をお願いしたいです。ちょっと増えてます。\n口元は多少なり笑みが含まれる方向性で、口閉じ、口少し開け（ほぼ閉じ）、口開け、舌ペロの4点差分いただきたいです。\n目はイメージはありませんが、通常、ちょい閉じ（ジト目）、閉じの3点を片目ずつ、両目分それぞれ組み合わせ可能なようにしてほしいです。\n目線はこっちを向いているようにしてほしいです。\n今回は服装や構図、シチュエーションなどはおまかせします。後でキャラクターの衣装を乗せておりますが、見えない部分の補完などは好きにしてくださっても大丈夫ですし、全く違う衣装を着せていただいても大丈夫です。\n\n15歳の中性よりな男の子、身長155～160です。\n髪の毛は白と青色のツートンで、普段は眠そうにしてて抜けてますが、やるときはやります。\n参考1全体図\nhttps://x.com/rugetsupepo/status/1690939483074826240\n参考2 \nhttps://x.com/rugetsupepo/status/1664293689412435968\n新衣装\nhttps://x.com/rugetsupepo/status/1906691283889901583\n\n太極図のアクセサリはキャラクターのモチーフなので、必ず入れて欲しいです。\nSNSのアイコンやヘッダ、YouTubeなどで使用する可能性があります。(収益用途では使いません)\nキャラクターや衣装に見切れがないようにしてほしいですが、下部は見切れても大丈夫です。\nお手数おかけしますが文字や背景などある場合はキャラ単体で透過しているものもほしいです。\n形式はpsdでお願いしたいです。差分出力が特に面倒でなければpngでも大丈夫です。\n\n以上の内容でお受けできそうであれば、是非お願いしたいです！\n金額や内容的に難しそうであれば再送やキャンセルしていただけると幸いです。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rurine_3002/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1788076, "client_id": 227300, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29c4c987/uploads/origins/8cc8e67c-8a53-4d5e-994f-a6e7ba3a8130?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9015df4b0bb62d718d2694d2843bffb8", "srcset": "https://si.imgix.net/29c4c987/uploads/origins/8cc8e67c-8a53-4d5e-994f-a6e7ba3a8130?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9015df4b0bb62d718d2694d2843bffb8, https://si.imgix.net/29c4c987/uploads/origins/8cc8e67c-8a53-4d5e-994f-a6e7ba3a8130?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=410f854c4f3ab507147aceee5e635781 2x, https://si.imgix.net/29c4c987/uploads/origins/8cc8e67c-8a53-4d5e-994f-a6e7ba3a8130?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b0886ccde89005992032e0d1b8994a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29c4c987/uploads/origins/8cc8e67c-8a53-4d5e-994f-a6e7ba3a8130?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c56b9b2342bb32ecb34352499446b26", "srcset": "https://si.imgix.net/29c4c987/uploads/origins/8cc8e67c-8a53-4d5e-994f-a6e7ba3a8130?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c56b9b2342bb32ecb34352499446b26, https://si.imgix.net/29c4c987/uploads/origins/8cc8e67c-8a53-4d5e-994f-a6e7ba3a8130?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f6529bff5fb3d222d338b7d0e775d93e 2x, https://si.imgix.net/29c