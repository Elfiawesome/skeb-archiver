igins/7f0d9800-0207-42ca-9250-3fa1ebaf4a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ea7848437a1b37bda689a57eecea4cb, https://si.imgix.net/2888a29d/uploads/origins/7f0d9800-0207-42ca-9250-3fa1ebaf4a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d9d61090f80e45afeee1d868e2ce1c44 2x, https://si.imgix.net/2888a29d/uploads/origins/7f0d9800-0207-42ca-9250-3fa1ebaf4a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=192743f5fc245164fbcc20462351d2ce 3x"}, "body": "Hi again, sensei! I continue to cherish the beautiful illustrations from you! May I ask you to draw these two characters?\n\nBlack-haired man: An evil and manipulative mage. He is obsessed with magic and forbidden knowledge. A sadist. 180cm.\n\nBlonde-haired man: A man who smiles often, but it looks like a fake smile.  A masochist. He likes to tease his partner (the black-haired man) and pester him. He is 185cm.\n\nThey are villains who understand each other. It's a feeling of, \"Nobody else in the world understands me. You are the only one who can understand my twisted soul.\" They are in a romantic relationship. Please feel free to draw whatever you'd like with them!\n\nAesthetic ideas, if this helps:\nBlack-haired man: https://br.pinterest.com/languhiris/aliah/\nBlonde-haired man: https://www.pinterest.com/orion0736/faust-aesthetic/\n\nPlease allow me to turn the text on and off in a separate layer of the PSD. Thank you!!\n\nhttps://imgur.com/a/ZTIMDBU", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hyohakubako/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 979458, "client_id": 1871267, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e5f8be2a/uploads/origins/734919a4-a10b-4620-961a-4164f55b7bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d2a811ffe1d7bc732973370581b8996", "srcset": "https://si.imgix.net/e5f8be2a/uploads/origins/734919a4-a10b-4620-961a-4164f55b7bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d2a811ffe1d7bc732973370581b8996, https://si.imgix.net/e5f8be2a/uploads/origins/734919a4-a10b-4620-961a-4164f55b7bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80eba998d94dc012e747e5beffc6a6bd 2x, https://si.imgix.net/e5f8be2a/uploads/origins/734919a4-a10b-4620-961a-4164f55b7bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8100cfd066078f3eefc6f5aa2bd5c89 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e5f8be2a/uploads/origins/734919a4-a10b-4620-961a-4164f55b7bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47c2e099d8564ff57ccf3f309bf9923a", "srcset": "https://si.imgix.net/e5f8be2a/uploads/origins/734919a4-a10b-4620-961a-4164f55b7bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47c2e099d8564ff57ccf3f309bf9923a, https://si.imgix.net/e5f8be2a/uploads/origins/734919a4-a10b-4620-961a-4164f55b7bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2add7965ef14fff15cab20ea4426f640 2x, https://si.imgix.net/e5f8be2a/uploads/origins/734919a4-a10b-4620-961a-4164f55b7bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=522eee7015a4f43a52fd86a34155cf38 3x"}, "body": "こんにちは。作品の雰囲気がとても好きなので、ぜひ私のffxivのキャラクターを描いてほしいです。月子(月子/178cm)は、難解なものを研究している学者です。エレガントで冷たい外見で、かわいらしさはありません。服装はお任せしますが、黒魔法を使うのでダークな雰囲気でお願いします。ご検討よろしくお願いします\n\nhttps://drive.google.com/drive/folders/10BQxyk8K4G8Vs44WQXZ4kVtWgttpTdWe?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hyohakubako/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 979458, "client_id": 1452548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b50e6176/uploads/origins/8e6718ea-1e16-4ef1-95ea-639eb6c275a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5d0fe68294e63616a1c64e72c37e746", "srcset": "https://si.imgix.net/b50e6176/uploads/origins/8e6718ea-1e16-4ef1-95ea-639eb6c275a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5d0fe68294e63616a1c64e72c37e746, https://si.imgix.net/b50e6176/uploads/origins/8e6718ea-1e16-4ef1-95ea-639eb6c275a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a06fd698e657a75b4563182618c0dfa 2x, https://si.imgix.net/b50e6176/uploads/origins/8e6718ea-1e16-4ef1-95ea-639eb6c275a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a21e1494e7ea2ff82d499d53b651bc49 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b50e6176/uploads/origins/8e6718ea-1e16-4ef1-95ea-639eb6c275a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9dfc9bf1a48db1cf7b1ebdc9fc98907", "srcset": "https://si.imgix.net/b50e6176/uploads/origins/8e6718ea-1e16-4ef1-95ea-639eb6c275a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9dfc9bf1a48db1cf7b1ebdc9fc98907, https://si.imgix.net/b50e6176/uploads/origins/8e6718ea-1e16-4ef1-95ea-639eb6c275a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b3205207f9cbda59ef7424bf15524fa 2x, https://si.imgix.net/b50e6176/uploads/origins/8e6718ea-1e16-4ef1-95ea-639eb6c275a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=505f72ccd036700c00a083fa5a5c04ac 3x"}, "body": "またまた、こんにちは。またリクエストを送ってもいいですか？\n\n1人目のキャラクターはレンです。虚弱体質で、肌も白いです。\nhttps://f2.toyhou.se/file/f2-toyhou-se/images/43195150_Mop4s3KWgH3OWQG.png\n\n2人目のキャラクターはMiguel。彼は25歳で身長188cmの軍人です。狡猾で人を操るのが得意です。彼の参考文献はこちら： https://f2.toyhou.se/file/f2-toyhou-se/images/21531808_aCdtFGgfWG64Ax1.jpg?1612180576\n\n2人はカップルで、Miguelが支配的なパートナーとなっています。ミゲルはレンを溺愛し、とても大切にしていますが、嫉妬深いタイプでもあり、レンを独り占めしようとしています。MiguelがRenに対して超独占欲を発揮しているようなポーズがいいですね。レンは夢見るような表情をしていて、ミゲルの行動に気付いていないようです。作品の雰囲気としては、ロマンティックでミステリアス、シュールなものを希望します。また、作品をできるだけカラフルにしてください。私はあなたの色使いがとても好きです。\nまた、私のリクエストを受け入れてくれてありがとうございます。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hyohakubako/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 979458, "client_id": 1716159, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/924bcfca/uploads/origins/67222b73-a3ae-4012-992b-65084f0a34b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b06d0bb5973aa476247abd75525b486f", "srcset": "https://si.imgix.net/924bcfca/uploads/origins/67222b73-a3ae-4012-992b-65084f0a34b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b06d0bb5973aa476247abd75525b486f, https://si.imgix.net/924bcfca/uploads/origins/67222b73-a3ae-4012-992b-65084f0a34b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=189f3102c4f462b1ab8121808a39e9b3 2x, https://si.imgix.net/924bcfca/uploads/origins/67222b73-a3ae-4012-992b-65084f0a34b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bc485c1073f9b056d5839f2769d9178 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/924bcfca/uploads/origins/67222b73-a3ae-4012-992b-65084f0a34b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82666d34b1c1151fce4392d499da844a", "srcset": "https://si.imgix.net/924bcfca/uploads/origins/67222b73-a3ae-4012-992b-65084f0a34b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82666d34b1c1151fce4392d499da844a, https://si.imgix.net/924bcfca/uploads/origins/67222b73-a3ae-4012-992b-65084f0a34b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b578b45510244d6e9ab57c7c7062cf87 2x, https://si.imgix.net/924bcfca/uploads/origins/67222b73-a3ae-4012-992b-65084f0a34b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4065c6c8260b274644a3c322f0323670 3x"}, "body": "初めまして、せんせいの絵はとても素敵と思います！\n\n私のオリジナルキャラクタ２人を依頼させてもらいたいです。\n女王受けなValkhna (174cm): https://toyhou.se/12322342.valkhna/gallery#38520517\n忠犬攻めなMikhael (183cm + 5cmヒール): https://toyhou.se/12901141.mikhael#40167465\n\nこの子達は天使な男の子です。恋愛関係ていうか、もっと曖昧なほうです。\n面倒すぎなら、翼は描いてなくても大丈夫です。\n構図ご自由にしてください～　せんせいに任せます！\n\nご検討いただきありがとうございます！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hyohakubako/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 979458, "client_id": 1452548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29227256/uploads/origins/9cc4d49b-adbc-474f-a8c3-4ef3ad2e0296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee8542c15311c218d6a68794e583f588", "srcset": "https://si.imgix.net/29227256/uploads/origins/9cc4d49b-adbc-474f-a8c3-4ef3ad2e0296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee8542c15311c218d6a68794e583f588, https://si.imgix.net/29227256/uploads/origins/9cc4d49b-adbc-474f-a8c3-4ef3ad2e0296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f53c96f22c57fb5cb578d3dd01a4b64f 2x, https://si.imgix.net/29227256/uploads/origins/9cc4d49b-adbc-474f-a8c3-4ef3ad2e0296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6af92d4f9746c4ba202408ecf1a18e2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/