h=200&blur=200&s=364240ac0859c8957f46e23a6652ae44 2x, https://si.imgix.net/50cd15f9/uploads/origins/91617f18-69cb-4625-ba51-1ef63c122add?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9abd534e2d25ee49b89b9ab79469b1bb 3x"}, "body": "こんにちは。いつもイラスト拝見しています！\n\n前回描いてもらった（https://skeb.jp/@byakuama/works/5）の子でお願いします。\n\n権力者の愛人やってるショタ（彼女持ち）がホモセックスしてると興奮するな…と思ったんで、指揮官の愛人やってるこの子が彼女とデートした帰りに呼び出されてラブラブ交尾しちゃう…みたいな感じでお願いします。\n\n彼女の前ではクールな男を気取ってるけど、指揮官の前では媚び媚びの雌になっちゃって、「あくまで仕事でやってるんですから…❤」みたいなこと言いながらフェラしたり、ディープキスしたりホモセしてくれてると嬉しいです。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@byakuama/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3720632, "client_id": 1082723, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/280f7cc3/uploads/origins/b10fedeb-ae64-42a0-8c9f-af13c576405c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e49e2847368349de8f57a946e7459902", "srcset": "https://si.imgix.net/280f7cc3/uploads/origins/b10fedeb-ae64-42a0-8c9f-af13c576405c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e49e2847368349de8f57a946e7459902, https://si.imgix.net/280f7cc3/uploads/origins/b10fedeb-ae64-42a0-8c9f-af13c576405c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26fa9264c4ec184286630f2061b9b488 2x, https://si.imgix.net/280f7cc3/uploads/origins/b10fedeb-ae64-42a0-8c9f-af13c576405c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=768779597d812b8bbc5b71453501863f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/280f7cc3/uploads/origins/b10fedeb-ae64-42a0-8c9f-af13c576405c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9087b3684d41eb919b82eb98c79daa1", "srcset": "https://si.imgix.net/280f7cc3/uploads/origins/b10fedeb-ae64-42a0-8c9f-af13c576405c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9087b3684d41eb919b82eb98c79daa1, https://si.imgix.net/280f7cc3/uploads/origins/b10fedeb-ae64-42a0-8c9f-af13c576405c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=92a705790b4a5c7e26a178b11af94a74 2x, https://si.imgix.net/280f7cc3/uploads/origins/b10fedeb-ae64-42a0-8c9f-af13c576405c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb097b44e7a7f8c5c7e776bac011e267 3x"}, "body": "はじめまして。\nhttps://skeb.jp/@byakuama/works/4が良かったのでリクエストさせてください。\n\n\n以下の設定のセリフ付イラストをお願い致します。\nナツヤスミ. ～祐と夏樹～の男の娘アイドル夏樹\n（https://www.dmm.co.jp/mono/anime/-/detail/=/cid=62wbr077/?dmmref=aMonoAnime_List\nの青髪のロングヘアの男の娘）\nが枕営業でスポンサーとの種付けSEXにハマってしまったその後で、\n\n男の娘アイドル夏樹が、スポンサーの子を３人妊娠出産済みで、４人目を妊娠してボテ腹になり黒くなった乳首（貧乳のまま）から母乳を出しながら、騎乗位や正常位で中出しされるシーンや\n５人目を妊娠してボテ腹になり黒くなった乳首（貧乳のまま）から母乳を出しながら、子の養育費を稼ぐため風俗店で風俗嬢として客に挨拶しているシーンのイラストをお願い致します。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@byakuama/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3720632, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e86e8985/uploads/origins/5bd2ab25-0fa9-41dd-87cd-aacd1926d6a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96b73e335b830fef5d09b079cdaf4318", "srcset": "https://si.imgix.net/e86e8985/uploads/origins/5bd2ab25-0fa9-41dd-87cd-aacd1926d6a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96b73e335b830fef5d09b079cdaf4318, https://si.imgix.net/e86e8985/uploads/origins/5bd2ab25-0fa9-41dd-87cd-aacd1926d6a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73ef2693e10b14f0ac72e3270c29ea92 2x, https://si.imgix.net/e86e8985/uploads/origins/5bd2ab25-0fa9-41dd-87cd-aacd1926d6a6?bg=%23fff&auto=format%