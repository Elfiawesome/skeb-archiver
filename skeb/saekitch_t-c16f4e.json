rks/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1269242, "client_id": 2183170, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cdc8e9c3/uploads/origins/5cc0640e-90b1-4019-9f4b-b67cbd27a870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2348f88fa74473e03aa57458aa04b48", "srcset": "https://si.imgix.net/cdc8e9c3/uploads/origins/5cc0640e-90b1-4019-9f4b-b67cbd27a870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2348f88fa74473e03aa57458aa04b48, https://si.imgix.net/cdc8e9c3/uploads/origins/5cc0640e-90b1-4019-9f4b-b67cbd27a870?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9923109f0b6e5c6f5a145d51c4e7528 2x, https://si.imgix.net/cdc8e9c3/uploads/origins/5cc0640e-90b1-4019-9f4b-b67cbd27a870?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a42b15fd72d0a3c5855ad66a081644f3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cdc8e9c3/uploads/origins/5cc0640e-90b1-4019-9f4b-b67cbd27a870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c375148b9ad61fc55b7d67adcd585e9e", "srcset": "https://si.imgix.net/cdc8e9c3/uploads/origins/5cc0640e-90b1-4019-9f4b-b67cbd27a870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c375148b9ad61fc55b7d67adcd585e9e, https://si.imgix.net/cdc8e9c3/uploads/origins/5cc0640e-90b1-4019-9f4b-b67cbd27a870?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ded1ae0630ccd1578bea54a82056c050 2x, https://si.imgix.net/cdc8e9c3/uploads/origins/5cc0640e-90b1-4019-9f4b-b67cbd27a870?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7329d6a0c1cba7835b289639a3624728 3x"}, "body": "はじめまして。新着で先生のイラスト拝見しました！とても好きです！ 2人オリジナルキャラクターのイラストをお願いします。\n二人は男性、大学生で、とても仲が良いの友人です。\n青髪の方は生物系の学生で、天才だけど自分ではそう思っていなくて、気さくで優しくて、意外と常識的な人なんです。 彼は小動物が大好きなんです。 外見とは違う決意があり、決めたことは必ず実行する。\n茶髪の方は青髪の後輩で、数学系の学生です。人間関係の管理がうまく、誰に対しても礼儀正しいが、しかしそれはすべて見かけだけ。 成績もよく、努力家なのだが、気づいてくれる人は少なく、もちろん彼自身も努力していることをわざと隠している。 彼は青髪に対する憧れと嫉妬が入り混じった複雑な心境である。 でも、青髪と一緒にいると楽しいんです、自分を偽らなくても、気楽に過ごせるんです。\n\n可能であれば、以下のテーマから選んで描いてください。\n【喫茶店】、【ペットショップ】、【図書館】、【研究室】\nありがとうございました！\n\n衣装：https://drive.google.com/drive/folders/1ST4j1r_6BlSjlNdlyZ1vlQvU75xJcNMm?usp=sharing\nその他：https://drive.google.com/drive/folders/1GtUe0XjDMzRmhx86rwIWx-67Np8H_zf0?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@saekitch_t/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1269242, "client_id": 1989278, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea9efee4/uploads/origins/a31a4524-f4df-4126-8c43-a2f6d8b59cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d403443f92e75ce6b44ac9f19e92d06c", "srcset": "https://si.imgix.net/ea9efee4/uploads/origins/a31a4524-f4df-4126-8c43-a2f6d8b59cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d403443f92e75ce6b44ac9f19e92d06c, https://si.imgix.net/ea9efee4/uploads/origins/a31a4524-f4df-4126-8c43-a2f6d8b59cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5badf4cc7847cd8ef187dd51370368b9 2x, https://si.imgix.net/ea9efee4/uploads/origins/a31a4524-f4df-4126-8c43-a2f6d8b59cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52b43fb8c091aa939a35bc993981016a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea9efee4/uploads/origins/a31a4524-f4df-4126-8c43-a2f6d8b59cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d6a749e5e488e927bfb813501e1a5f8", "srcset": "https://si.imgix.net/ea9efee4/uploads/origins/a31a4524-f4df-4126-8c43-a2f6d8b59cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d6a749e5e488e927bfb813501e1a5f8, https://si.imgix.net/ea9efee4/uploads/origins/a31a4524-f4df-4126-8c43-a2f6d8b59cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e06dc07c834ea39e493c5111586f538c 2x, https://si.imgix.net/ea9efee4/uploads/origins/a31a4524-f4df-4126-8c43-a2f6d8b59cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ec572a5e0453d433dca44a2e43aaa48 3x"}, "body": "Hello, I love your illustrations! Can you draw an illustration of my original characters?\nmy characters:\nShiratori: 183cm, very gentle but insecure man. There are always birds flying around him. Always in anxiety that Nana will leave him.\nNana: 174cm, human boy with rabbit ears and tail. Pokerface, but loves Shiratori very much.\n\nmy request:\nPlease draw Shiratori crying because he brokes down and Nana consoling him. (Nana has bandaged wounds on his body) Please feel free to imagine the composition, movement and costume\n\nYou can cancel the request if you feel it is inappropriate or difficult.\n\nhttps://drive.google.com/drive/folders/1-8sUClf7BVZXNKF5l1AitC3tV76byUh6", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@saekitch_t/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1269242, "client_id": 1776258, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2ce44a2/uploads/origins/817431d7-9419-406b-8772-ab45e11a8b0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7cb68aa966914064de4613e7d4fe97c", "srcset": "https://si.imgix.net/c2ce44a2/uploads/origins/817431d7-9419-406b-8772-ab45e11a8b0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7cb68aa966914064de4613e7d4fe97c, https://si.imgix.net/c2ce44a2/uploads/origins/