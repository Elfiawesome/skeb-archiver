弟関係でもあります。（呼び方や会話の距離感は親密ですが、恋愛関係ではありません。）\n\n▼用途\n-アイコンやスマホの壁紙など個人観賞用\n-skeb等依頼する際の参考資料として用いる可能性があります\n\n金額や内容に不備などございましたら、お手数ですが再申請やキャンセルをしていただけますと幸いです。\nご一考のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Eydl86-uvBs1RKB8jqi5JGBYiU1wD-5q?usp=sharing", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kenkou29/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3594337, "client_id": 2655892, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c70ec314/uploads/origins/ce244a60-c6a1-417c-8ee4-26c9b20e3427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8fbd54a62514bbfbbb9966b16615e93", "srcset": "https://si.imgix.net/c70ec314/uploads/origins/ce244a60-c6a1-417c-8ee4-26c9b20e3427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8fbd54a62514bbfbbb9966b16615e93, https://si.imgix.net/c70ec314/uploads/origins/ce244a60-c6a1-417c-8ee4-26c9b20e3427?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=360be166132bdbdfc997f2e7bf5aa1d0 2x, https://si.imgix.net/c70ec314/uploads/origins/ce244a60-c6a1-417c-8ee4-26c9b20e3427?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99e2fc95733e3ed6dd15b7d11cf379b5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c70ec314/uploads/origins/ce244a60-c6a1-417c-8ee4-26c9b20e3427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc1466ebf6d2985c623c4e773e993f99", "srcset": "https://si.imgix.net/c70ec314/uploads/origins/ce244a60-c6a1-417c-8ee4-26c9b20e3427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc1466ebf6d2985c623c4e773e993f99, https://si.imgix.net/c70ec314/uploads/origins/ce244a60-c6a1-417c-8ee4-26c9b20e3427?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit